01:0000004C 1A
                            	   406:     even
                            	   407: 
                            	   408: ; Flute/organ patch — additive ALG 7 (4 carriers in parallel).
                            	   409: ;   Op MUL ratios 1:2:3:4 add octave and 5th overtones for an airy, woody
                            	   410: ;   timbre.  Sustained envelope (no decay during note hold), fast release
                            	   411: ;   on key-off.  FB 1 for slight warmth without distortion.
                            	   412: ;   Slot byte order in YM2612 patches is op1, op3, op2, op4.
                            	   413: PATCH_FLUTE:
01:0000004E 0F              	   414:     dc.b    $0F                     ; FB/ALG: (1<<3)|7
01:0000004F 01              	   415:     dc.b    $01,$03,$02,$04         ; DT/MUL (op1=1, op3=3, op2=2, op4=4)
01:00000050 03
01:00000051 02
01:00000052 04
01:00000053 1F              	   416:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
01:00000054 1F
