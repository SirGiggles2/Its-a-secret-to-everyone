                            	   432:     even
                            	   433: 
                            	   434: ; Twinkle / celesta lead — soft mystical bell, light and bright.
                            	   435: ;   Algorithm 5 (3 carriers driven by op1 modulator), FB 0 keeps timbre
                            	   436: ;   clean and pure (no FB-induced grit).  Op1 MUL 2 with low modulator
                            	   437: ;   level adds just a hint of chime without harsh overtones.  Carriers
                            	   438: ;   are slightly detuned (DT 1, 0, -1) for a gentle chorus shimmer that
                            	   439: ;   reads as "mystical" rather than dry.  Long DL+RR gives notes a
                            	   440: ;   relaxing tail that overlaps into chord-like ringouts.
                            	   441: PATCH_TWINKLE:
01:00000082 05              	   442:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
01:00000083 02              	   443:     dc.b    $02,$11,$01,$51         ; DT/MUL — slot order op1,op3,op2,op4
01:00000084 11
01:00000085 01
01:00000086 51
01:00000087 1F              	   444:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
01:00000088 1F
01:00000089 1F
01:0000008A 1F
01:0000008B 00              	   445:     dc.b    $00,$03,$03,$03         ; AM/D1R — mod sustained, carriers gentle decay
01:0000008C 03
