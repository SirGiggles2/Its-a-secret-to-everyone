Source: "C:\Users\Jake Diggity\Documents\GitHub\FINAL TRY\tools\midi_demo\midi_player.asm"
                            	     1: ;==============================================================================
                            	     2: ; midi_player.asm — Compact event-driven YM2612 MIDI player.
                            	     3: ;
                            	     4: ; Public symbols (called from main.c):
                            	     5: ;       ym_init        — load Voice 00 bell pad on YM channels 0..5, mute PSG
                            	     6: ;       midi_init      — point play state at compiled blob, prime time_to_next
                            	     7: ;       midi_tick      — call once per VBlank; dispatches due events
                            	     8: ;
                            	     9: ; Compiled blob is incbin'd at label `midi_blob`.  Layout (big-endian):
                            	    10: ;       u32 magic = 'MIDI'
                            	    11: ;       u32 num_events
                            	    12: ;       u32 loop_offset    (byte offset into events[] for loop point)
                            	    13: ;       events[N]:
                            	    14: ;           u16 delta_frames
                            	    15: ;           u8  op        ($00 note-off, $01 note-on, $FF end-of-song)
                            	    16: ;           u8  ch        (0..5 -> YM channel)
                            	    17: ;           u8  bf_hi     ((block<<3)|fnum_hi)  — destined for $A4+offset
                            	    18: ;           u8  fnum_lo   — destined for $A0+offset
                            	    19: ;==============================================================================
                            	    20: 
                            	    21: ;----------------------------------------------------------------------
                            	    22: ; Hardware ports
                            	    23: ;----------------------------------------------------------------------
                            	    24: YM_ADDR1        equ $A04000
                            	    25: YM_DATA1        equ $A04001
                            	    26: YM_ADDR2        equ $A04002
                            	    27: YM_DATA2        equ $A04003
                            	    28: PSG_PORT        equ $C00011
                            	    29: 
                            	    30: ;----------------------------------------------------------------------
                            	    31: ; Player state (lives in RAM)
                            	    32: ;----------------------------------------------------------------------
                            	    33: MIDI_STATE      equ $FFE000
                            	    34: MS_PLAY_PTR     equ MIDI_STATE+0     ; long: pointer to next event's delta byte
                            	    35: MS_EVENTS_BASE  equ MIDI_STATE+4     ; long: pointer to events[] start
                            	    36: MS_LOOP_PTR     equ MIDI_STATE+8     ; long: events[] + loop_offset
                            	    37: MS_TIME_NEXT    equ MIDI_STATE+12    ; word: frames until next event
                            	    38: MS_END_PTR      equ MIDI_STATE+14    ; long: events[] end (events_base + 6*num_events)
                            	    39: 
                            	    40:     section "text",code
                            	    41: 
                            	    42: ;==============================================================================
                            	    43: ; ym_write1 — write address+data atomically to YM2612 Part I.
                            	    44: ; Input:  D0.b = register, D1.b = data.  Preserves D0,D1.
                            	    45: ;==============================================================================
                            	    46: ym_write1:
                            	    47: .wait1:
00:00000000 4A3900A04000    	    48:     tst.b   (YM_ADDR1).l
00:00000006 6BF8            	    49:     bmi.s   .wait1
00:00000008 13C000A04000    	    50:     move.b  D0,(YM_ADDR1).l
00:0000000E 4E71            	    51:     nop
00:00000010 4E71            	    52:     nop
00:00000012 4E71            	    53:     nop
00:00000014 13C100A04001    	    54:     move.b  D1,(YM_DATA1).l
00:0000001A 4E75            	    55:     rts
                            	    56: 
                            	    57: ;==============================================================================
                            	    58: ; ym_write2 — write address+data atomically to YM2612 Part II.
                            	    59: ; Busy flag is shared, so still poll Part I.
                            	    60: ;==============================================================================
                            	    61: ym_write2:
                            	    62: .wait2:
00:0000001C 4A3900A04000    	    63:     tst.b   (YM_ADDR1).l
00:00000022 6BF8            	    64:     bmi.s   .wait2
00:00000024 13C000A04002    	    65:     move.b  D0,(YM_ADDR2).l
00:0000002A 4E71            	    66:     nop
00:0000002C 4E71            	    67:     nop
00:0000002E 4E71            	    68:     nop
00:00000030 13C100A04003    	    69:     move.b  D1,(YM_DATA2).l
00:00000036 4E75            	    70:     rts
                            	    71: 
                            	    72: ;==============================================================================
                            	    73: ; load_fm_patch_named — load 25-byte patch into one channel.
                            	    74: ; Input: A0 = pointer to 25-byte patch, D6.b = YM channel 0..5
                            	    75: ;==============================================================================
                            	    76: load_fm_patch_named:
00:00000038 48E7E2C0        	    77:     movem.l D0-D2/D6/A0-A1,-(SP)
00:0000003C 43FA0000        	    78:     lea     FM_PATCH_REGS(PC),A1
00:00000040 7418            	    79:     moveq   #24,D2                  ; 25 register/value pairs
00:00000042 0C060003        	    80:     cmpi.b  #3,D6
00:00000046 6D10            	    81:     blt.s   .partI
                            	    82:     ; ch 3..5 — Part II, channel offset = ch-3
00:00000048 5706            	    83:     subi.b  #3,D6
                            	    84: .lpII:
00:0000004A 1019            	    85:     move.b  (A1)+,D0
00:0000004C D006            	    86:     add.b   D6,D0
00:0000004E 1218            	    87:     move.b  (A0)+,D1
00:00000050 61CA            	    88:     bsr     ym_write2
00:00000052 51CAFFF6        	    89:     dbra    D2,.lpII
00:00000056 600C            	    90:     bra.s   .done
                            	    91: .partI:
                            	    92: .lpI:
00:00000058 1019            	    93:     move.b  (A1)+,D0
00:0000005A D006            	    94:     add.b   D6,D0
00:0000005C 1218            	    95:     move.b  (A0)+,D1
00:0000005E 61A0            	    96:     bsr     ym_write1
00:00000060 51CAFFF6        	    97:     dbra    D2,.lpI
                            	    98: .done:
00:00000064 4CDF0347        	    99:     movem.l (SP)+,D0-D2/D6/A0-A1
00:00000068 4E75            	   100:     rts
                            	   101: 
                            	   102: ;==============================================================================
                            	   103: ; ym_init — set up YM2612 for 6-voice bell pad playback.
                            	   104: ;==============================================================================
                            	   105:     xdef    ym_init
                            	   106: ym_init:
00:0000006A 48E7FE80        	   107:     movem.l D0-D6/A0,-(SP)
                            	   108: 
                            	   109:     ; Key-off all 6 channels (reg $28; key bits = $00, ch bits 0,1,2,4,5,6)
00:0000006E 103C0028        	   110:     move.b  #$28,D0
00:00000072 7200            	   111:     moveq   #$00,D1
00:00000074 618A            	   112:     bsr     ym_write1
00:00000076 7201            	   113:     moveq   #$01,D1
00:00000078 6186            	   114:     bsr     ym_write1
00:0000007A 7202            	   115:     moveq   #$02,D1
00:0000007C 6182            	   116:     bsr     ym_write1
00:0000007E 7204            	   117:     moveq   #$04,D1
00:00000080 6100FF7E        	   118:     bsr     ym_write1
00:00000084 7205            	   119:     moveq   #$05,D1
00:00000086 6100FF78        	   120:     bsr     ym_write1
00:0000008A 7206            	   121:     moveq   #$06,D1
00:0000008C 6100FF72        	   122:     bsr     ym_write1
                            	   123: 
                            	   124:     ; LFO off
00:00000090 103C0022        	   125:     move.b  #$22,D0
00:00000094 7200            	   126:     moveq   #0,D1
00:00000096 6100FF68        	   127:     bsr     ym_write1
                            	   128: 
                            	   129:     ; DAC disabled (ch 6 stays as FM, but we don't use it)
00:0000009A 103C002B        	   130:     move.b  #$2B,D0
00:0000009E 7200            	   131:     moveq   #0,D1
00:000000A0 6100FF5E        	   132:     bsr     ym_write1
                            	   133: 
                            	   134:     ; Clear SSG-EG for every operator on all 6 channels.
                            	   135:     ; Part I = ch 0,1,2.  Part II = ch 3,4,5 (channel offsets 0,1,2 on Part II).
00:000000A4 7200            	   136:     moveq   #0,D1
00:000000A6 7C00            	   137:     moveq   #0,D6
                            	   138: .ssg_loop:
00:000000A8 1006            	   139:     move.b  D6,D0
00:000000AA 06000090        	   140:     addi.b  #$90,D0
00:000000AE 6100FF50        	   141:     bsr     ym_write1
00:000000B2 1006            	   142:     move.b  D6,D0
00:000000B4 06000090        	   143:     addi.b  #$90,D0
00:000000B8 6100FF62        	   144:     bsr     ym_write2
00:000000BC 5206            	   145:     addq.b  #1,D6
00:000000BE 0C06000F        	   146:     cmpi.b  #15,D6                  ; 16 iterations covers $90..$9F (4 ops x 3 ch + skip)
00:000000C2 6FE4            	   147:     ble.s   .ssg_loop
                            	   148: 
                            	   149:     ; Load harp patch on ch 0..2 (lead), bell pad on ch 3..5 (backup).
00:000000C4 7C00            	   150:     moveq   #0,D6
                            	   151: .patch_lead:
00:000000C6 41FA001A        	   152:     lea     PATCH_VOICE00(PC),A0    ; bell pad on lead — best fit per user A/B
00:000000CA 6100FF6C        	   153:     bsr     load_fm_patch_named
00:000000CE 5206            	   154:     addq.b  #1,D6
00:000000D0 0C060002        	   155:     cmpi.b  #2,D6
00:000000D4 6FF0            	   156:     ble.s   .patch_lead
                            	   157: .patch_backup:
00:000000D6 41FA0034        	   158:     lea     PATCH_PAD(PC),A0        ; slow-swell mystical pad for backup line
00:000000DA 6100FF5C        	   159:     bsr     load_fm_patch_named
00:000000DE 5206            	   160:     addq.b  #1,D6
00:000000E0 0C060005        	   161:     cmpi.b  #5,D6
00:000000E4 6FF0            	   162:     ble.s   .patch_backup
                            	   163: 
                            	   164:     ; Panning L+R for ch 0..2 ($B4..$B6 Part I)
00:000000E6 123C00C0        	   165:     move.b  #$C0,D1
00:000000EA 103C00B4        	   166:     move.b  #$B4,D0
00:000000EE 6100FF10        	   167:     bsr     ym_write1
00:000000F2 103C00B5        	   168:     move.b  #$B5,D0
00:000000F6 6100FF08        	   169:     bsr     ym_write1
00:000000FA 103C00B6        	   170:     move.b  #$B6,D0
00:000000FE 6100FF00        	   171:     bsr     ym_write1
                            	   172:     ; ch 3..5 ($B4..$B6 Part II)
00:00000102 103C00B4        	   173:     move.b  #$B4,D0
00:00000106 6100FF14        	   174:     bsr     ym_write2
00:0000010A 103C00B5        	   175:     move.b  #$B5,D0
00:0000010E 6100FF0C        	   176:     bsr     ym_write2
00:00000112 103C00B6        	   177:     move.b  #$B6,D0
00:00000116 6100FF04        	   178:     bsr     ym_write2
                            	   179: 
                            	   180:     ; Mute PSG (we don't use it)
00:0000011A 13FC009F00C00011	   181:     move.b  #$9F,(PSG_PORT).l
00:00000122 13FC00BF00C00011	   182:     move.b  #$BF,(PSG_PORT).l
00:0000012A 13FC00DF00C00011	   183:     move.b  #$DF,(PSG_PORT).l
00:00000132 13FC00FF00C00011	   184:     move.b  #$FF,(PSG_PORT).l
                            	   185: 
00:0000013A 4CDF017F        	   186:     movem.l (SP)+,D0-D6/A0
00:0000013E 4E75            	   187:     rts
                            	   188: 
                            	   189: ;==============================================================================
                            	   190: ; midi_init — initialize player state from the compiled blob.
                            	   191: ;==============================================================================
                            	   192:     xdef    midi_init
                            	   193: midi_init:
00:00000140 48E7E080        	   194:     movem.l D0-D2/A0,-(SP)
00:00000144 41FA009C        	   195:     lea     midi_blob(PC),A0
                            	   196: 
                            	   197:     ; Verify magic == 'MIDI'.  If wrong, leave state zeroed (player no-ops).
00:00000148 0C904D494449    	   198:     cmpi.l  #$4D494449,(A0)
00:0000014E 6644            	   199:     bne     .bad
                            	   200: 
00:00000150 20280004        	   201:     move.l  4(A0),D0                 ; num_events
00:00000154 22280008        	   202:     move.l  8(A0),D1                 ; loop_offset (bytes)
                            	   203: 
00:00000158 41E8000C        	   204:     lea     12(A0),A0                ; A0 -> events_base (skip 12-byte header)
00:0000015C 23C800FFE004    	   205:     move.l  A0,(MS_EVENTS_BASE).l
00:00000162 23C800FFE000    	   206:     move.l  A0,(MS_PLAY_PTR).l
                            	   207: 
                            	   208:     ; Loop pointer = events_base + loop_offset
00:00000168 2408            	   209:     move.l  A0,D2
00:0000016A D481            	   210:     add.l   D1,D2
00:0000016C 23C200FFE008    	   211:     move.l  D2,(MS_LOOP_PTR).l
                            	   212: 
                            	   213:     ; End pointer = events_base + 6 * num_events
00:00000172 2400            	   214:     move.l  D0,D2
00:00000174 E38A            	   215:     lsl.l   #1,D2                    ; *2
00:00000176 D480            	   216:     add.l   D0,D2
00:00000178 D480            	   217:     add.l   D0,D2
00:0000017A D480            	   218:     add.l   D0,D2
00:0000017C D480            	   219:     add.l   D0,D2                    ; D2 = num_events*6 (1+1+1+1+1+1 = 6)
00:0000017E D488            	   220:     add.l   A0,D2
00:00000180 23C200FFE00E    	   221:     move.l  D2,(MS_END_PTR).l
                            	   222: 
                            	   223:     ; Prime time_to_next from the first event's delta (peek u16 at A0).
00:00000186 3010            	   224:     move.w  (A0),D0
00:00000188 33C000FFE00C    	   225:     move.w  D0,(MS_TIME_NEXT).l
                            	   226: 
00:0000018E 4CDF0107        	   227:     movem.l (SP)+,D0-D2/A0
00:00000192 4E75            	   228:     rts
                            	   229: 
                            	   230: .bad:
00:00000194 33FC7FFF00FFE00C	   231:     move.w  #$7FFF,(MS_TIME_NEXT).l  ; effectively idle forever
00:0000019C 4CDF0107        	   232:     movem.l (SP)+,D0-D2/A0
00:000001A0 4E75            	   233:     rts
                            	   234: 
                            	   235: ;==============================================================================
                            	   236: ; midi_tick — called once per VBlank.
                            	   237: ;==============================================================================
                            	   238:     xdef    midi_tick
                            	   239: midi_tick:
00:000001A2 48E7FE80        	   240:     movem.l D0-D6/A0,-(SP)
                            	   241: 
00:000001A6 3E3900FFE00C    	   242:     move.w  (MS_TIME_NEXT).l,D7
00:000001AC 670A            	   243:     beq.s   .due
00:000001AE 5347            	   244:     subq.w  #1,D7
00:000001B0 33C700FFE00C    	   245:     move.w  D7,(MS_TIME_NEXT).l
00:000001B6 6664            	   246:     bne     .out
                            	   247: .due:
00:000001B8 207900FFE000    	   248:     movea.l (MS_PLAY_PTR).l,A0
                            	   249: 
                            	   250: .dispatch:
                            	   251:     ; Bounds check (defensive — well-formed blob hits 0xFF before this)
00:000001BE 2008            	   252:     move.l  A0,D0
00:000001C0 B0B900FFE00E    	   253:     cmp.l   (MS_END_PTR).l,D0
00:000001C6 6C3C            	   254:     bge.s   .loop_back
                            	   255: 
                            	   256:     ; Read header: u16 delta, u8 op, u8 ch, u8 bf_hi, u8 fnum_lo
00:000001C8 3A18            	   257:     move.w  (A0)+,D5                 ; delta (already consumed when we entered)
00:000001CA 1018            	   258:     move.b  (A0)+,D0                 ; op
00:000001CC 1C18            	   259:     move.b  (A0)+,D6                 ; ch (0..5)
00:000001CE 1618            	   260:     move.b  (A0)+,D3                 ; bf_hi (block<<3 | fnum_hi)
00:000001D0 1818            	   261:     move.b  (A0)+,D4                 ; fnum_lo
                            	   262: 
00:000001D2 0C0000FF        	   263:     cmpi.b  #$FF,D0
00:000001D6 672C            	   264:     beq.s   .loop_back
                            	   265: 
00:000001D8 0C000001        	   266:     cmpi.b  #$01,D0
00:000001DC 6706            	   267:     beq.s   .note_on
                            	   268:     ; else note-off
00:000001DE 6100009E        	   269:     bsr     do_note_off
00:000001E2 6002            	   270:     bra.s   .next_event
                            	   271: 
                            	   272: .note_on:
00:000001E4 613C            	   273:     bsr     do_note_on
                            	   274: 
                            	   275: .next_event:
                            	   276:     ; Peek next event's delta to see whether to keep dispatching this frame.
00:000001E6 2008            	   277:     move.l  A0,D0
00:000001E8 B0B900FFE00E    	   278:     cmp.l   (MS_END_PTR).l,D0
00:000001EE 6C14            	   279:     bge.s   .loop_back
00:000001F0 3010            	   280:     move.w  (A0),D0                  ; next event's delta
00:000001F2 6602            	   281:     bne.s   .stop_dispatch
00:000001F4 60C8            	   282:     bra.s   .dispatch                ; delta=0, dispatch immediately
                            	   283: 
                            	   284: .stop_dispatch:
00:000001F6 33C000FFE00C    	   285:     move.w  D0,(MS_TIME_NEXT).l
00:000001FC 23C800FFE000    	   286:     move.l  A0,(MS_PLAY_PTR).l
00:00000202 6018            	   287:     bra.s   .out
                            	   288: 
                            	   289: .loop_back:
00:00000204 207900FFE008    	   290:     movea.l (MS_LOOP_PTR).l,A0
00:0000020A 3010            	   291:     move.w  (A0),D0
00:0000020C 33C000FFE00C    	   292:     move.w  D0,(MS_TIME_NEXT).l
00:00000212 23C800FFE000    	   293:     move.l  A0,(MS_PLAY_PTR).l
                            	   294:     ; If we just landed on a delta-0 event, dispatch it now.
00:00000218 4A40            	   295:     tst.w   D0
00:0000021A 67A2            	   296:     beq.s   .dispatch
                            	   297: 
                            	   298: .out:
00:0000021C 4CDF017F        	   299:     movem.l (SP)+,D0-D6/A0
00:00000220 4E75            	   300:     rts
                            	   301: 
                            	   302: ;==============================================================================
                            	   303: ; do_note_on — emit block/fnum to YM ch in D6, then key-on all operators.
                            	   304: ; Input:  D6.b = ch 0..5, D3.b = bf_hi, D4.b = fnum_lo
                            	   305: ;==============================================================================
                            	   306: do_note_on:
00:00000222 48E7E000        	   307:     movem.l D0-D2,-(SP)
                            	   308: 
00:00000226 0C060003        	   309:     cmpi.b  #3,D6
00:0000022A 6D1E            	   310:     blt.s   .freq_partI
                            	   311:     ; Part II
00:0000022C 1406            	   312:     move.b  D6,D2
00:0000022E 5702            	   313:     subi.b  #3,D2                    ; ch-3 = Part II offset
00:00000230 1002            	   314:     move.b  D2,D0
00:00000232 060000A4        	   315:     addi.b  #$A4,D0                  ; reg $A4+offset
00:00000236 1203            	   316:     move.b  D3,D1                    ; data = bf_hi
00:00000238 6100FDE2        	   317:     bsr     ym_write2
00:0000023C 1002            	   318:     move.b  D2,D0
00:0000023E 060000A0        	   319:     addi.b  #$A0,D0
00:00000242 1204            	   320:     move.b  D4,D1
00:00000244 6100FDD6        	   321:     bsr     ym_write2
00:00000248 6018            	   322:     bra.s   .key_on
                            	   323: 
                            	   324: .freq_partI:
00:0000024A 1006            	   325:     move.b  D6,D0
00:0000024C 060000A4        	   326:     addi.b  #$A4,D0
00:00000250 1203            	   327:     move.b  D3,D1
00:00000252 6100FDAC        	   328:     bsr     ym_write1
00:00000256 1006            	   329:     move.b  D6,D0
00:00000258 060000A0        	   330:     addi.b  #$A0,D0
00:0000025C 1204            	   331:     move.b  D4,D1
00:0000025E 6100FDA0        	   332:     bsr     ym_write1
                            	   333: 
                            	   334: .key_on:
                            	   335:     ; Key-on: reg $28 always Part I.  Data = $F0 | yamaha_id where
                            	   336:     ; yamaha_id = ch for ch<3, else ch+1.
00:00000262 103C0028        	   337:     move.b  #$28,D0
00:00000266 1206            	   338:     move.b  D6,D1
00:00000268 0C060003        	   339:     cmpi.b  #3,D6
00:0000026C 6D02            	   340:     blt.s   .ko_lt
00:0000026E 5201            	   341:     addq.b  #1,D1
                            	   342: .ko_lt:
00:00000270 000100F0        	   343:     ori.b   #$F0,D1
00:00000274 6100FD8A        	   344:     bsr     ym_write1
                            	   345: 
00:00000278 4CDF0007        	   346:     movem.l (SP)+,D0-D2
00:0000027C 4E75            	   347:     rts
                            	   348: 
                            	   349: ;==============================================================================
                            	   350: ; do_note_off — key-off all operators on YM ch in D6.
                            	   351: ;==============================================================================
                            	   352: do_note_off:
00:0000027E 48E7C000        	   353:     movem.l D0-D1,-(SP)
00:00000282 103C0028        	   354:     move.b  #$28,D0
00:00000286 1206            	   355:     move.b  D6,D1
00:00000288 0C060003        	   356:     cmpi.b  #3,D6
00:0000028C 6D02            	   357:     blt.s   .kf_lt
00:0000028E 5201            	   358:     addq.b  #1,D1
                            	   359: .kf_lt:
00:00000290 0201000F        	   360:     andi.b  #$0F,D1                  ; key bits = 0 -> all operators off
00:00000294 6100FD6A        	   361:     bsr     ym_write1
00:00000298 4CDF0003        	   362:     movem.l (SP)+,D0-D1
00:0000029C 4E75            	   363:     rts
                            	   364: 
                            	   365: ;==============================================================================
