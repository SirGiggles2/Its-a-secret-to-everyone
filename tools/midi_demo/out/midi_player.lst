                            	   390:     even
                            	   391: 
                            	   392: ; Mystical pad — distinctly different from the celesta lead.  Carriers
                            	   393: ; have a SLOW attack so each note swells in like a breath of mist behind
                            	   394: ; the bright lead twinkle.  Op1 modulator stays at MUL 4 with high TL so
                            	   395: ; only a faint metallic shimmer rides on top of pure-tone carriers.  No
                            	   396: ; FB.  Carriers mildly detuned for chorus.  Net effect: airy washes
                            	   397: ; that bloom under the lead's plucks instead of competing with them.
                            	   398: PATCH_PAD:
01:00000034 05              	   399:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
01:00000035 04              	   400:     dc.b    $04,$11,$01,$51         ; DT/MUL — op1 MUL 4 modulator
01:00000036 11
01:00000037 01
01:00000038 51
01:00000039 1F              	   401:     dc.b    $1F,$10,$10,$10         ; RS/AR — mod instant, carriers SLOW attack
01:0000003A 10
01:0000003B 10
01:0000003C 10
01:0000003D 00              	   402:     dc.b    $00,$02,$02,$02         ; AM/D1R — long decay
01:0000003E 02
01:0000003F 02
01:00000040 02
01:00000041 00              	   403:     dc.b    $00,$00,$00,$00         ; D2R
01:00000042 00
01:00000043 00
