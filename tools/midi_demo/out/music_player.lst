                            	   139: ;==============================================================================
                            	   140: ; music_player_ym_init — set up YM2612 for 6-voice bell pad playback.
                            	   141: ;==============================================================================
                            	   142:     xdef    music_player_ym_init
                            	   143: music_player_ym_init:
00:000000B6 48E7FE80        	   144:     movem.l D0-D6/A0,-(SP)
                            	   145: 
                            	   146:     ; Key-off all 6 channels + mute PSG
00:000000BA 61AE            	   147:     bsr     music_player_silence_all
                            	   148: 
                            	   149:     ; LFO off
00:000000BC 103C0022        	   150:     move.b  #$22,D0
00:000000C0 7200            	   151:     moveq   #0,D1
00:000000C2 6100FF3C        	   152:     bsr     mp_ym_w1
                            	   153: 
                            	   154:     ; DAC disabled (ch 6 stays as FM, but we don't use it)
00:000000C6 103C002B        	   155:     move.b  #$2B,D0
00:000000CA 7200            	   156:     moveq   #0,D1
00:000000CC 6100FF32        	   157:     bsr     mp_ym_w1
                            	   158: 
                            	   159:     ; Clear SSG-EG for every operator on all 6 channels.
                            	   160:     ; Part I = ch 0,1,2.  Part II = ch 3,4,5 (channel offsets 0,1,2 on Part II).
00:000000D0 7200            	   161:     moveq   #0,D1
00:000000D2 7C00            	   162:     moveq   #0,D6
                            	   163: .ssg_loop:
00:000000D4 1006            	   164:     move.b  D6,D0
00:000000D6 06000090        	   165:     addi.b  #$90,D0
00:000000DA 6100FF24        	   166:     bsr     mp_ym_w1
00:000000DE 1006            	   167:     move.b  D6,D0
00:000000E0 06000090        	   168:     addi.b  #$90,D0
00:000000E4 6100FF36        	   169:     bsr     mp_ym_w2
00:000000E8 5206            	   170:     addq.b  #1,D6
00:000000EA 0C06000F        	   171:     cmpi.b  #15,D6                  ; 16 iterations covers $90..$9F (4 ops x 3 ch + skip)
00:000000EE 6FE4            	   172:     ble.s   .ssg_loop
                            	   173: 
                            	   174:     ; Load harp patch on ch 0..2 (lead), bell pad on ch 3..5 (backup).
00:000000F0 7C00            	   175:     moveq   #0,D6
                            	   176: .patch_lead:
00:000000F2 41FA01CC        	   177:     lea     mp_PATCH_VOICE00(PC),A0 ; bell pad on lead — best fit per user A/B
00:000000F6 6100FF40        	   178:     bsr     mp_load_patch
00:000000FA 5206            	   179:     addq.b  #1,D6
00:000000FC 0C060002        	   180:     cmpi.b  #2,D6
00:00000100 6FF0            	   181:     ble.s   .patch_lead
                            	   182: .patch_backup:
00:00000102 41FA01D6        	   183:     lea     mp_PATCH_PAD(PC),A0     ; slow-swell mystical pad for backup line
00:00000106 6100FF30        	   184:     bsr     mp_load_patch
00:0000010A 5206            	   185:     addq.b  #1,D6
00:0000010C 0C060005        	   186:     cmpi.b  #5,D6
00:00000110 6FF0            	   187:     ble.s   .patch_backup
                            	   188: 
                            	   189:     ; Panning L+R for ch 0..2 ($B4..$B6 Part I)
00:00000112 123C00C0        	   190:     move.b  #$C0,D1
00:00000116 103C00B4        	   191:     move.b  #$B4,D0
00:0000011A 6100FEE4        	   192:     bsr     mp_ym_w1
00:0000011E 103C00B5        	   193:     move.b  #$B5,D0
00:00000122 6100FEDC        	   194:     bsr     mp_ym_w1
00:00000126 103C00B6        	   195:     move.b  #$B6,D0
00:0000012A 6100FED4        	   196:     bsr     mp_ym_w1
                            	   197:     ; ch 3..5 ($B4..$B6 Part II)
00:0000012E 103C00B4        	   198:     move.b  #$B4,D0
00:00000132 6100FEE8        	   199:     bsr     mp_ym_w2
00:00000136 103C00B5        	   200:     move.b  #$B5,D0
00:0000013A 6100FEE0        	   201:     bsr     mp_ym_w2
00:0000013E 103C00B6        	   202:     move.b  #$B6,D0
00:00000142 6100FED8        	   203:     bsr     mp_ym_w2
                            	   204: 
00:00000146 4CDF017F        	   205:     movem.l (SP)+,D0-D6/A0
00:0000014A 4E75            	   206:     rts
                            	   207: 
                            	   208: ;==============================================================================
                            	   209: ; music_player_init_song — initialize player state from a compiled blob.
                            	   210: ; Input: A0 = pointer to blob (12-byte header + events[] + 0xFF terminator)
                            	   211: ;==============================================================================
                            	   212:     xdef    music_player_init_song
                            	   213: music_player_init_song:
00:0000014C 48E7E000        	   214:     movem.l D0-D2,-(SP)              ; A0 is input, do not save/restore
00:00000150 0C904D494449    	   215:     cmpi.l  #$4D494449,(A0)
00:00000156 6644            	   216:     bne     .bad
                            	   217: 
00:00000158 20280004        	   218:     move.l  4(A0),D0                 ; num_events
00:0000015C 22280008        	   219:     move.l  8(A0),D1                 ; loop_offset (bytes)
                            	   220: 
00:00000160 41E8000C        	   221:     lea     12(A0),A0                ; A0 -> events_base (skip 12-byte header)
00:00000164 23C800FFE144    	   222:     move.l  A0,(MS_EVENTS_BASE).l
00:0000016A 23C800FFE140    	   223:     move.l  A0,(MS_PLAY_PTR).l
                            	   224: 
00:00000170 2408            	   225:     move.l  A0,D2
00:00000172 D481            	   226:     add.l   D1,D2
00:00000174 23C200FFE148    	   227:     move.l  D2,(MS_LOOP_PTR).l
                            	   228: 
00:0000017A 2400            	   229:     move.l  D0,D2
00:0000017C E38A            	   230:     lsl.l   #1,D2
00:0000017E D480            	   231:     add.l   D0,D2
00:00000180 D480            	   232:     add.l   D0,D2
00:00000182 D480            	   233:     add.l   D0,D2
00:00000184 D480            	   234:     add.l   D0,D2
00:00000186 D488            	   235:     add.l   A0,D2
00:00000188 23C200FFE14E    	   236:     move.l  D2,(MS_END_PTR).l
                            	   237: 
00:0000018E 3010            	   238:     move.w  (A0),D0
00:00000190 33C000FFE14C    	   239:     move.w  D0,(MS_TIME_NEXT).l
                            	   240: 
00:00000196 4CDF0007        	   241:     movem.l (SP)+,D0-D2
00:0000019A 4E75            	   242:     rts
                            	   243: 
                            	   244: .bad:
00:0000019C 33FC7FFF00FFE14C	   245:     move.w  #$7FFF,(MS_TIME_NEXT).l
00:000001A4 4CDF0007        	   246:     movem.l (SP)+,D0-D2
00:000001A8 4E75            	   247:     rts
                            	   248: 
                            	   249: ;==============================================================================
                            	   250: ; music_player_tick — called once per VBlank.
                            	   251: ;==============================================================================
                            	   252:     xdef    music_player_tick
                            	   253: music_player_tick:
00:000001AA 48E7FE80        	   254:     movem.l D0-D6/A0,-(SP)
                            	   255: 
00:000001AE 3E3900FFE14C    	   256:     move.w  (MS_TIME_NEXT).l,D7
00:000001B4 670A            	   257:     beq.s   .due
00:000001B6 5347            	   258:     subq.w  #1,D7
00:000001B8 33C700FFE14C    	   259:     move.w  D7,(MS_TIME_NEXT).l
00:000001BE 6664            	   260:     bne     .out
                            	   261: .due:
00:000001C0 207900FFE140    	   262:     movea.l (MS_PLAY_PTR).l,A0
                            	   263: 
                            	   264: .dispatch:
                            	   265:     ; Bounds check (defensive — well-formed blob hits 0xFF before this)
00:000001C6 2008            	   266:     move.l  A0,D0
00:000001C8 B0B900FFE14E    	   267:     cmp.l   (MS_END_PTR).l,D0
00:000001CE 6C3C            	   268:     bge.s   .loop_back
                            	   269: 
                            	   270:     ; Read header: u16 delta, u8 op, u8 ch, u8 bf_hi, u8 fnum_lo
00:000001D0 3A18            	   271:     move.w  (A0)+,D5                 ; delta (already consumed when we entered)
00:000001D2 1018            	   272:     move.b  (A0)+,D0                 ; op
00:000001D4 1C18            	   273:     move.b  (A0)+,D6                 ; ch (0..5)
00:000001D6 1618            	   274:     move.b  (A0)+,D3                 ; bf_hi (block<<3 | fnum_hi)
00:000001D8 1818            	   275:     move.b  (A0)+,D4                 ; fnum_lo
                            	   276: 
00:000001DA 0C0000FF        	   277:     cmpi.b  #$FF,D0
00:000001DE 672C            	   278:     beq.s   .loop_back
                            	   279: 
00:000001E0 0C000001        	   280:     cmpi.b  #$01,D0
00:000001E4 6706            	   281:     beq.s   .note_on
                            	   282:     ; else note-off
00:000001E6 6100009E        	   283:     bsr     mp_do_note_off
00:000001EA 6002            	   284:     bra.s   .next_event
                            	   285: 
                            	   286: .note_on:
00:000001EC 613C            	   287:     bsr     mp_do_note_on
                            	   288: 
                            	   289: .next_event:
                            	   290:     ; Peek next event's delta to see whether to keep dispatching this frame.
00:000001EE 2008            	   291:     move.l  A0,D0
00:000001F0 B0B900FFE14E    	   292:     cmp.l   (MS_END_PTR).l,D0
00:000001F6 6C14            	   293:     bge.s   .loop_back
00:000001F8 3010            	   294:     move.w  (A0),D0                  ; next event's delta
00:000001FA 6602            	   295:     bne.s   .stop_dispatch
00:000001FC 60C8            	   296:     bra.s   .dispatch                ; delta=0, dispatch immediately
                            	   297: 
                            	   298: .stop_dispatch:
00:000001FE 33C000FFE14C    	   299:     move.w  D0,(MS_TIME_NEXT).l
00:00000204 23C800FFE140    	   300:     move.l  A0,(MS_PLAY_PTR).l
00:0000020A 6018            	   301:     bra.s   .out
                            	   302: 
                            	   303: .loop_back:
00:0000020C 207900FFE148    	   304:     movea.l (MS_LOOP_PTR).l,A0
00:00000212 3010            	   305:     move.w  (A0),D0
00:00000214 33C000FFE14C    	   306:     move.w  D0,(MS_TIME_NEXT).l
00:0000021A 23C800FFE140    	   307:     move.l  A0,(MS_PLAY_PTR).l
                            	   308:     ; If we just landed on a delta-0 event, dispatch it now.
00:00000220 4A40            	   309:     tst.w   D0
00:00000222 67A2            	   310:     beq.s   .dispatch
                            	   311: 
                            	   312: .out:
00:00000224 4CDF017F        	   313:     movem.l (SP)+,D0-D6/A0
00:00000228 4E75            	   314:     rts
                            	   315: 
                            	   316: ;==============================================================================
                            	   317: ; mp_do_note_on — emit block/fnum to YM ch in D6, then key-on all operators.
                            	   318: ; Input:  D6.b = ch 0..5, D3.b = bf_hi, D4.b = fnum_lo
                            	   319: ;==============================================================================
                            	   320: mp_do_note_on:
00:0000022A 48E7E000        	   321:     movem.l D0-D2,-(SP)
                            	   322: 
00:0000022E 0C060003        	   323:     cmpi.b  #3,D6
00:00000232 6D1E            	   324:     blt.s   .freq_partI
                            	   325:     ; Part II
00:00000234 1406            	   326:     move.b  D6,D2
00:00000236 5702            	   327:     subi.b  #3,D2                    ; ch-3 = Part II offset
00:00000238 1002            	   328:     move.b  D2,D0
00:0000023A 060000A4        	   329:     addi.b  #$A4,D0                  ; reg $A4+offset
00:0000023E 1203            	   330:     move.b  D3,D1                    ; data = bf_hi
00:00000240 6100FDDA        	   331:     bsr     mp_ym_w2
00:00000244 1002            	   332:     move.b  D2,D0
00:00000246 060000A0        	   333:     addi.b  #$A0,D0
00:0000024A 1204            	   334:     move.b  D4,D1
00:0000024C 6100FDCE        	   335:     bsr     mp_ym_w2
00:00000250 6018            	   336:     bra.s   .key_on
                            	   337: 
                            	   338: .freq_partI:
00:00000252 1006            	   339:     move.b  D6,D0
00:00000254 060000A4        	   340:     addi.b  #$A4,D0
00:00000258 1203            	   341:     move.b  D3,D1
00:0000025A 6100FDA4        	   342:     bsr     mp_ym_w1
00:0000025E 1006            	   343:     move.b  D6,D0
00:00000260 060000A0        	   344:     addi.b  #$A0,D0
00:00000264 1204            	   345:     move.b  D4,D1
00:00000266 6100FD98        	   346:     bsr     mp_ym_w1
                            	   347: 
                            	   348: .key_on:
                            	   349:     ; Key-on: reg $28 always Part I.  Data = $F0 | yamaha_id where
                            	   350:     ; yamaha_id = ch for ch<3, else ch+1.
00:0000026A 103C0028        	   351:     move.b  #$28,D0
00:0000026E 1206            	   352:     move.b  D6,D1
00:00000270 0C060003        	   353:     cmpi.b  #3,D6
00:00000274 6D02            	   354:     blt.s   .ko_lt
00:00000276 5201            	   355:     addq.b  #1,D1
                            	   356: .ko_lt:
00:00000278 000100F0        	   357:     ori.b   #$F0,D1
00:0000027C 6100FD82        	   358:     bsr     mp_ym_w1
                            	   359: 
00:00000280 4CDF0007        	   360:     movem.l (SP)+,D0-D2
00:00000284 4E75            	   361:     rts
                            	   362: 
                            	   363: ;==============================================================================
                            	   364: ; mp_do_note_off — key-off all operators on YM ch in D6.
                            	   365: ;==============================================================================
                            	   366: mp_do_note_off:
00:00000286 48E7C000        	   367:     movem.l D0-D1,-(SP)
00:0000028A 103C0028        	   368:     move.b  #$28,D0
00:0000028E 1206            	   369:     move.b  D6,D1
00:00000290 0C060003        	   370:     cmpi.b  #3,D6
00:00000294 6D02            	   371:     blt.s   .kf_lt
00:00000296 5201            	   372:     addq.b  #1,D1
                            	   373: .kf_lt:
00:00000298 0201000F        	   374:     andi.b  #$0F,D1                  ; key bits = 0 -> all operators off
00:0000029C 6100FD62        	   375:     bsr     mp_ym_w1
00:000002A0 4CDF0003        	   376:     movem.l (SP)+,D0-D1
00:000002A4 4E75            	   377:     rts
