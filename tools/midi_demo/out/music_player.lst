Source: "C:\Users\Jake Diggity\Documents\GitHub\FINAL TRY\src\music_player.asm"
                            	     1: ;==============================================================================
                            	     2: ; music_player.asm — Compact event-driven YM2612 MIDI player.
                            	     3: ;
                            	     4: ; Public symbols:
                            	     5: ;       music_player_ym_init     — load Voice 00 bell pad on YM channels 0..5, mute PSG
                            	     6: ;       music_player_init_song   — point play state at caller-provided blob ptr (A0)
                            	     7: ;       music_player_tick        — call once per VBlank; dispatches due events
                            	     8: ;       music_player_silence_all — key-off all 6 FM channels, mute PSG
                            	     9: ;
                            	    10: ; Compiled blob is at label `song_great_fairy_blob`.  Layout (big-endian):
                            	    11: ;       u32 magic = 'MIDI'
                            	    12: ;       u32 num_events
                            	    13: ;       u32 loop_offset    (byte offset into events[] for loop point)
                            	    14: ;       events[N]:
                            	    15: ;           u16 delta_frames
                            	    16: ;           u8  op        ($00 note-off, $01 note-on, $FF end-of-song)
                            	    17: ;           u8  ch        (0..5 -> YM channel)
                            	    18: ;           u8  bf_hi     ((block<<3)|fnum_hi)  — destined for $A4+offset
                            	    19: ;           u8  fnum_lo   — destined for $A0+offset
                            	    20: ;
                            	    21: ; Private helpers use mp_ prefix to avoid name collisions with audio_driver.asm
                            	    22: ; when both are included into the same vasm translation unit (main ROM build).
                            	    23: ; The standalone midi_demo build links music_player.o alone — no conflicts either.
                            	    24: ;==============================================================================
                            	    25: 
                            	    26: ;----------------------------------------------------------------------
                            	    27: ; Hardware ports (private names: audio_driver.asm defines YM_ADDR1 etc.
                            	    28: ; globally, but we use our own copies for locality so bsr stays in range)
                            	    29: ;----------------------------------------------------------------------
                            	    30: MP_YM_ADDR1     equ $A04000
                            	    31: MP_YM_DATA1     equ $A04001
                            	    32: MP_YM_ADDR2     equ $A04002
                            	    33: MP_YM_DATA2     equ $A04003
                            	    34: MP_PSG_PORT     equ $C00011
                            	    35: 
                            	    36: ;----------------------------------------------------------------------
                            	    37: ; Player state (lives in RAM)
                            	    38: ;----------------------------------------------------------------------
                            	    39: MIDI_STATE      equ $FFE140
                            	    40: MS_PLAY_PTR     equ MIDI_STATE+0     ; long: pointer to next event's delta byte
                            	    41: MS_EVENTS_BASE  equ MIDI_STATE+4     ; long: pointer to events[] start
                            	    42: MS_LOOP_PTR     equ MIDI_STATE+8     ; long: events[] + loop_offset
                            	    43: MS_TIME_NEXT    equ MIDI_STATE+12    ; word: frames until next event
                            	    44: MS_END_PTR      equ MIDI_STATE+14    ; long: events[] end (events_base + 6*num_events)
                            	    45: 
                            	    46:     section "text",code
                            	    47: 
                            	    48: ;==============================================================================
                            	    49: ; mp_ym_w1 — write address+data atomically to YM2612 Part I.
                            	    50: ; Input:  D0.b = register, D1.b = data.  Preserves D0,D1.
                            	    51: ; Private to music_player.asm — keeps bsr calls local (always in range).
                            	    52: ;==============================================================================
                            	    53: mp_ym_w1:
                            	    54: .wait1:
00:00000000 4A3900A04000    	    55:     tst.b   (MP_YM_ADDR1).l
00:00000006 6BF8            	    56:     bmi.s   .wait1
00:00000008 13C000A04000    	    57:     move.b  D0,(MP_YM_ADDR1).l
00:0000000E 4E71            	    58:     nop
00:00000010 4E71            	    59:     nop
00:00000012 4E71            	    60:     nop
00:00000014 13C100A04001    	    61:     move.b  D1,(MP_YM_DATA1).l
00:0000001A 4E75            	    62:     rts
                            	    63: 
                            	    64: ;==============================================================================
                            	    65: ; mp_ym_w2 — write address+data atomically to YM2612 Part II.
                            	    66: ; Busy flag is shared, so still poll Part I.
                            	    67: ;==============================================================================
                            	    68: mp_ym_w2:
                            	    69: .wait2:
00:0000001C 4A3900A04000    	    70:     tst.b   (MP_YM_ADDR1).l
00:00000022 6BF8            	    71:     bmi.s   .wait2
00:00000024 13C000A04002    	    72:     move.b  D0,(MP_YM_ADDR2).l
00:0000002A 4E71            	    73:     nop
00:0000002C 4E71            	    74:     nop
00:0000002E 4E71            	    75:     nop
00:00000030 13C100A04003    	    76:     move.b  D1,(MP_YM_DATA2).l
00:00000036 4E75            	    77:     rts
                            	    78: 
                            	    79: ;==============================================================================
                            	    80: ; mp_load_patch — load 25-byte patch into one channel.
                            	    81: ; Input: A0 = pointer to 25-byte patch, D6.b = YM channel 0..5
                            	    82: ;==============================================================================
                            	    83: mp_load_patch:
00:00000038 48E7E2C0        	    84:     movem.l D0-D2/D6/A0-A1,-(SP)
00:0000003C 43FA0268        	    85:     lea     mp_FM_PATCH_REGS(PC),A1
00:00000040 7418            	    86:     moveq   #24,D2                  ; 25 register/value pairs
00:00000042 0C060003        	    87:     cmpi.b  #3,D6
00:00000046 6D10            	    88:     blt.s   .partI
                            	    89:     ; ch 3..5 — Part II, channel offset = ch-3
00:00000048 5706            	    90:     subi.b  #3,D6
                            	    91: .lpII:
00:0000004A 1019            	    92:     move.b  (A1)+,D0
00:0000004C D006            	    93:     add.b   D6,D0
00:0000004E 1218            	    94:     move.b  (A0)+,D1
00:00000050 61CA            	    95:     bsr     mp_ym_w2
00:00000052 51CAFFF6        	    96:     dbra    D2,.lpII
00:00000056 600C            	    97:     bra.s   .done
                            	    98: .partI:
                            	    99: .lpI:
00:00000058 1019            	   100:     move.b  (A1)+,D0
00:0000005A D006            	   101:     add.b   D6,D0
00:0000005C 1218            	   102:     move.b  (A0)+,D1
00:0000005E 61A0            	   103:     bsr     mp_ym_w1
00:00000060 51CAFFF6        	   104:     dbra    D2,.lpI
                            	   105: .done:
00:00000064 4CDF0347        	   106:     movem.l (SP)+,D0-D2/D6/A0-A1
00:00000068 4E75            	   107:     rts
                            	   108: 
                            	   109: ;==============================================================================
                            	   110: ; music_player_silence_all — key-off all 6 FM channels, mute PSG.
                            	   111: ; Called by music_player_ym_init at start of patch load AND by
                            	   112: ; music_dispatch.music_stop before handing YM back to audio_driver.
                            	   113: ;==============================================================================
                            	   114:     xdef    music_player_silence_all
                            	   115: music_player_silence_all:
00:0000006A 48E7C000        	   116:     movem.l D0-D1,-(SP)
00:0000006E 103C0028        	   117:     move.b  #$28,D0
00:00000072 7200            	   118:     moveq   #$00,D1
00:00000074 618A            	   119:     bsr     mp_ym_w1
00:00000076 7201            	   120:     moveq   #$01,D1
00:00000078 6186            	   121:     bsr     mp_ym_w1
00:0000007A 7202            	   122:     moveq   #$02,D1
00:0000007C 6182            	   123:     bsr     mp_ym_w1
00:0000007E 7204            	   124:     moveq   #$04,D1
00:00000080 6100FF7E        	   125:     bsr     mp_ym_w1
00:00000084 7205            	   126:     moveq   #$05,D1
00:00000086 6100FF78        	   127:     bsr     mp_ym_w1
00:0000008A 7206            	   128:     moveq   #$06,D1
00:0000008C 6100FF72        	   129:     bsr     mp_ym_w1
                            	   130: 
00:00000090 13FC009F00C00011	   131:     move.b  #$9F,(MP_PSG_PORT).l
00:00000098 13FC00BF00C00011	   132:     move.b  #$BF,(MP_PSG_PORT).l
00:000000A0 13FC00DF00C00011	   133:     move.b  #$DF,(MP_PSG_PORT).l
00:000000A8 13FC00FF00C00011	   134:     move.b  #$FF,(MP_PSG_PORT).l
                            	   135: 
00:000000B0 4CDF0003        	   136:     movem.l (SP)+,D0-D1
00:000000B4 4E75            	   137:     rts
