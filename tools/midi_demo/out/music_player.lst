                            	   396: ; Voice $00 — bell pad (Sonic 2 EHZ; verbatim from src/audio_driver.asm)
                            	   397: mp_PATCH_VOICE00:
00:000002C0 2D              	   398:     dc.b    $2D                     ; FB/ALG: (5<<3)|5
00:000002C1 04              	   399:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
00:000002C2 01
00:000002C3 01
00:000002C4 01
00:000002C5 1F              	   400:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
00:000002C6 1F
00:000002C7 1F
00:000002C8 1F
00:000002C9 08              	   401:     dc.b    $08,$04,$04,$04         ; AM/D1R
00:000002CA 04
00:000002CB 04
00:000002CC 04
00:000002CD 00              	   402:     dc.b    $00,$00,$00,$00         ; D2R
00:000002CE 00
00:000002CF 00
00:000002D0 00
00:000002D1 47              	   403:     dc.b    $47,$37,$37,$17         ; DL/RR — bell tail
00:000002D2 37
00:000002D3 37
00:000002D4 17
00:000002D5 14              	   404:     dc.b    $14,$1E,$1E,$1E         ; TL — modulator $14, carriers $1E
00:000002D6 1E
00:000002D7 1E
00:000002D8 1E
                            	   405:     even
                            	   406: 
                            	   407: ; Mystical pad — distinctly different from the celesta lead.  Carriers
                            	   408: ; have a SLOW attack so each note swells in like a breath of mist behind
                            	   409: ; the bright lead twinkle.  Op1 modulator stays at MUL 4 with high TL so
                            	   410: ; only a faint metallic shimmer rides on top of pure-tone carriers.  No
                            	   411: ; FB.  Carriers mildly detuned for chorus.  Net effect: airy washes
                            	   412: ; that bloom under the lead's plucks instead of competing with them.
                            	   413: mp_PATCH_PAD:
00:000002DA 05              	   414:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
00:000002DB 04              	   415:     dc.b    $04,$11,$01,$51         ; DT/MUL — op1 MUL 4 modulator
00:000002DC 11
00:000002DD 01
00:000002DE 51
00:000002DF 1F              	   416:     dc.b    $1F,$10,$10,$10         ; RS/AR — mod instant, carriers SLOW attack
00:000002E0 10
00:000002E1 10
00:000002E2 10
00:000002E3 00              	   417:     dc.b    $00,$02,$02,$02         ; AM/D1R — long decay
00:000002E4 02
00:000002E5 02
00:000002E6 02
00:000002E7 00              	   418:     dc.b    $00,$00,$00,$00         ; D2R
00:000002E8 00
00:000002E9 00
00:000002EA 00
00:000002EB 4A              	   419:     dc.b    $4A,$28,$28,$28         ; DL/RR — long sustained tail
00:000002EC 28
00:000002ED 28
00:000002EE 28
00:000002EF 30              	   420:     dc.b    $30,$1A,$1A,$1A         ; TL — mod whisper, carriers gentle
00:000002F0 1A
00:000002F1 1A
00:000002F2 1A
                            	   421:     even
                            	   422: 
                            	   423: ; Flute/organ patch — additive ALG 7 (4 carriers in parallel).
                            	   424: ;   Op MUL ratios 1:2:3:4 add octave and 5th overtones for an airy, woody
                            	   425: ;   timbre.  Sustained envelope (no decay during note hold), fast release
                            	   426: ;   on key-off.  FB 1 for slight warmth without distortion.
                            	   427: ;   Slot byte order in YM2612 patches is op1, op3, op2, op4.
                            	   428: mp_PATCH_FLUTE:
00:000002F4 0F              	   429:     dc.b    $0F                     ; FB/ALG: (1<<3)|7
00:000002F5 01              	   430:     dc.b    $01,$03,$02,$04         ; DT/MUL (op1=1, op3=3, op2=2, op4=4)
00:000002F6 03
00:000002F7 02
00:000002F8 04
00:000002F9 1F              	   431:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
00:000002FA 1F
00:000002FB 1F
00:000002FC 1F
00:000002FD 00              	   432:     dc.b    $00,$00,$00,$00         ; AM/D1R — no decay, sustain at TL
00:000002FE 00
00:000002FF 00
00:00000300 00
00:00000301 00              	   433:     dc.b    $00,$00,$00,$00         ; D2R
00:00000302 00
00:00000303 00
00:00000304 00
00:00000305 0F              	   434:     dc.b    $0F,$0F,$0F,$0F         ; DL/RR — DL 0, RR 15 (fast release)
00:00000306 0F
00:00000307 0F
00:00000308 0F
00:00000309 18              	   435:     dc.b    $18,$24,$20,$2C         ; TL — fundamental loudest, harmonics quieter
00:0000030A 24
00:0000030B 20
00:0000030C 2C
                            	   436:     even
                            	   437: 
                            	   438: ; Voice $03 — EHZ FM3 lead (Sonic 2; bright FB7 / Algorithm 5).
                            	   439: mp_PATCH_VOICE03:
00:0000030E 3D              	   440:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
00:0000030F 01              	   441:     dc.b    $01,$51,$21,$01         ; DT/MUL
00:00000310 51
00:00000311 21
00:00000312 01
00:00000313 1F              	   442:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
00:00000314 1F
00:00000315 1F
00:00000316 1F
00:00000317 0A              	   443:     dc.b    $0A,$05,$05,$05         ; AM/D1R
00:00000318 05
00:00000319 05
00:0000031A 05
00:0000031B 00              	   444:     dc.b    $00,$00,$00,$00         ; D2R
00:0000031C 00
00:0000031D 00
00:0000031E 00
00:0000031F 2B              	   445:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
00:00000320 2B
00:00000321 2B
00:00000322 1B
00:00000323 19              	   446:     dc.b    $19,$18,$18,$18         ; TL
00:00000324 18
00:00000325 18
00:00000326 18
                            	   447:     even
                            	   448: 
                            	   449: ; Twinkle / celesta lead — soft mystical bell, light and bright.
                            	   450: ;   Algorithm 5 (3 carriers driven by op1 modulator), FB 0 keeps timbre
                            	   451: ;   clean and pure (no FB-induced grit).  Op1 MUL 2 with low modulator
                            	   452: ;   level adds just a hint of chime without harsh overtones.  Carriers
                            	   453: ;   are slightly detuned (DT 1, 0, -1) for a gentle chorus shimmer that
                            	   454: ;   reads as "mystical" rather than dry.  Long DL+RR gives notes a
                            	   455: ;   relaxing tail that overlaps into chord-like ringouts.
                            	   456: mp_PATCH_TWINKLE:
00:00000328 05              	   457:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
00:00000329 02              	   458:     dc.b    $02,$11,$01,$51         ; DT/MUL — slot order op1,op3,op2,op4
00:0000032A 11
00:0000032B 01
00:0000032C 51
00:0000032D 1F              	   459:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
00:0000032E 1F
00:0000032F 1F
00:00000330 1F
00:00000331 00              	   460:     dc.b    $00,$03,$03,$03         ; AM/D1R — mod sustained, carriers gentle decay
00:00000332 03
00:00000333 03
00:00000334 03
00:00000335 00              	   461:     dc.b    $00,$00,$00,$00         ; D2R
00:00000336 00
00:00000337 00
00:00000338 00
00:00000339 48              	   462:     dc.b    $48,$36,$36,$26         ; DL/RR — long shimmery tail
00:0000033A 36
00:0000033B 36
00:0000033C 26
00:0000033D 24              	   463:     dc.b    $24,$14,$14,$14         ; TL — mod gentle ($24), carriers bright ($14)
00:0000033E 14
00:0000033F 14
00:00000340 14
