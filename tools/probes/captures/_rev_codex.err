30:extern "C" {
31:#endif
32:
33:typedef enum {
34:    CAVE_FADE_IDLE         = 0,
35:    CAVE_FADE_LINK_DESCEND = 1,
36:    CAVE_FADE_SWAP_ENTRY   = 2,
37:    CAVE_FADE_LINK_ASCEND  = 3,  /* cave exit: Link walks UP, Y-=1 per 4 frames */
38:    CAVE_FADE_SWAP_EXIT    = 4
39:} cave_fade_phase_t;
40:
41:typedef struct {
42:    /* Called once per LINK_DESCEND tick when Link should move down 1 px
43:     * (every 4th frame). step_idx counts 0..15 (16 steps total). Owner
44:     * adjusts players[0].y += 1 and sets sprite priority. */
45:    void (*on_descend_step)(unsigned char step_idx);
46:    /* Called at SWAP_ENTRY. Owner sets scene = SCENE_CAVE +
47:     * Link reposition (120, 192 face up) + any other RoomRom-local
48:     * state bookkeeping. */
49:    void (*on_swap_entry)(cave_id_t cid);
50:    /* Called once per LINK_ASCEND tick (cave exit). Owner adjusts
51:     * players[0].y -= 1 + ticks walk-anim. 16 steps total. */
52:    void (*on_ascend_step)(unsigned char step_idx);
53:    /* Called at SWAP_EXIT. Owner sets scene = SCENE_OW + Link
54:     * reposition (16 px south of entrance facing down) + HUD reset. */
55:    void (*on_swap_exit)(void);
56:} cave_fade_callbacks_t;
57:
58:void              cave_fade_set_callbacks(const cave_fade_callbacks_t *cb);
59:
60:void              cave_fade_begin_enter(cave_id_t cid);
