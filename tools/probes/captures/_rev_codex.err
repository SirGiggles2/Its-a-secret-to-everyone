37:/* Phase D3 (2026-05-24): correct PersonTextAddrs to its Genesis layout.
38: * The data file (src/data/person_text_data.c) emits a 38-pointer array
39: * (one pointer per text blob), not the NES-style 76-byte (lo,hi)-pair
40: * table. NES selectors $00, $02, $04, ... index pairs; Genesis indexes
41: * blobs by selector/2. */
42:#include "../../data/person_text_data.h"
43:
44:/* LevelBlockAttrsE (cave ware ids + prices) lives in the extracted
45: * rooms_overworld[] blob â€” the SAME source ow_meta uses for attr_b. The
46: * NES SRAM mirror at $6A7E is NEVER populated on Genesis (no save-init
47: * SRAM copy), so the old nes_ram[$6A7E] read returned garbage -> wrong
48: * ware ids + CaveFlags missing the show-items bit ($04) -> cave items
49: * (e.g. the cave-6A wood sword) never drew. Read from the blob instead. */
50:#include "../../../data/rooms/overworld_offsets.h"
51:extern const unsigned char rooms_overworld[];
52:
53:/* NES Z_01.asm:559 TextboxCharTransferRecTemplate â€” 5-byte VRAM
54: * transfer record template used by the textbox char-streamer to
55: * stamp a single character tile into nametable. Per NES asm:
56: *   $21       VRAM addr hi byte (nametable $2100 + offset)
57: *   $A4       VRAM addr lo byte (textbox line 0 start)
58: *   $01       record length (one byte)
59: *   $24       default char (space = $24)
60: *   $FF       terminator
61: * Char byte at offset 3 is overwritten per-frame with the streamed
62: * character. Offset 1 (lo addr) is overwritten per-line from
63: * TextboxLineAddrsLo. */
64:const unsigned char TextboxCharTransferRecTemplate[5] = {
65:    0x21u, 0xA4u, 0x01u, 0x24u, 0xFFu
66:};
67:
68:/* Cave-id of the currently active cave (0 = none active).
69: *
70: * The persistent cave state lives in NES RAM (read/written via the
71: * bridge accessors in src/state/cave_state.h). Per state_contract.md
72: * "two views coexist," accessor calls go through `RAM($XXX)` so that
73: * drained C reading via macros + native code reading via accessors
74: * see the same byte. We do NOT keep a duplicate typed struct here â€”
75: * that would diverge silently from the RAM-backed view. */
76:static cave_id_t g_active_cave = 0;
77:
78:/* Cave-id range gate per NES InitCave (Z_01.asm:79-86): valid cave
79: * room types are 0x6A..0x7D inclusive (20 caves, NES Y index 0..19
80: * into OverworldPersonTextSelectors). Outside range = invalid call.
81: * 2026-05-27: was $7C â€” rejected cave $7D (Hint-cave / Take-any-road).
82: * Sweep cave_7D ObjType1=$38 stale, fixed by including $7D. */
83:#define CAVE_ID_MIN 0x6Au
84:#define CAVE_ID_MAX 0x7Du
85:
86:/* Native port of NES InitCaveContinue (Z_01.asm:105-170). Loads text
87: * selector from OverworldPersonTextSelectors[cave_idx], 3 ware items
88: * + prices from LevelBlockAttrsE (NES SRAM $6A7E + cave_idx*3), and
89: * derives CAVE_FLAGS top-bits from text-selector + ware bytes.
90: *
91: * Inlined to keep cave_init self-contained â€” cavert_init_cave in
92: * src/oracle/cave/cave_runtime.c is not in Debug.md link set, and its
93: * z01_set_up_common_cave_objects dependency cascades into the
94: * unlinked src/gen/z_01.c TU.
95: *
96: * NES Z_01.asm:53 OverworldPersonTextSelectors (20 bytes). */
97:static const unsigned char k_overworld_person_text_selectors[20] = {
98:    0x40u, 0x60u, 0x42u, 0x42u, 0x04u, 0x06u, 0x48u, 0x0Au,
99:    0x4Cu, 0x0Eu, 0xD0u, 0xD2u, 0xD2u, 0xDCu, 0xDCu, 0xDEu,
100:    0xDEu, 0x62u, 0x62u, 0x62u
101:};
