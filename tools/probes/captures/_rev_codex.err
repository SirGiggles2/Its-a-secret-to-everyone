100:void render_mode_set_v64(void)
101:{
102:    /* VDP Reg 16 = $9011 (H64 x V64). Matches gameplay default. */
103:    s_plane_row_stride_bytes = 128u;
104:    VDP_CTRL_WORD = 0x9011;
105:}
106:
107:void render_mode_set_h64v32(void)
108:{
109:    /* VDP Reg 16 = $9001 (H64 x V32). RoomRom PR-2 64x32 plane mode:
110:     * 64-wide stride (128 B/row) but 4 KB plane size, freeing 192 tiles
111:     * vs V64. */
112:    s_plane_row_stride_bytes = 128u;
113:    VDP_CTRL_WORD = 0x9001;
114:}
115:
116:void render_z80_bus_grab(void)
117:{
118:    /* Hold Z80 bus so 68K has uncontended VRAM access. */
119:    Z80_BUSREQ_WORD = 0x0100;
120:    while ((Z80_BUSREQ_WORD & 0x0100) != 0) { /* wait BUSACK */ }
121:}
122:
123:void render_z80_bus_release(void)
124:{
125:    Z80_BUSREQ_WORD = 0x0000;
126:}
127:
128:void render_irq_mask(void)
129:{
130:    __asm__ volatile ("ori.w #0x0700,%sr");
131:}
132:
133:void render_irq_unmask(void)
134:{
135:    __asm__ volatile ("andi.w #0xF8FF,%sr");
136:}
137:
138:void render_wait_vblank(void)
139:{
140:    /* Wait for VBlank rising edge: drain through any in-progress vblank,
141:     * then spin until status bit 3 is set again. Used by frontends that
142:     * do not run from VBlankISR. */
143:    while ( (VDP_CTRL_WORD & 0x0008));
144:    while (!(VDP_CTRL_WORD & 0x0008));
145:}
146:
147:void render_window_v_set(unsigned char value)
148:{
149:    /* VDP Reg 18: window vertical position byte. value=0 disables the
150:     * Window plane vertically; non-zero sets row count (high bit chooses
151:     * up vs down direction). genesis_shell.asm uses 0x9208 for 8-row top
152:     * window during transpiled gameplay HUD; intro_main resets to 0x9200. */
153:    VDP_CTRL_WORD = (unsigned short)(0x9200u | value);
154:}
155:
156:void render_sat_clear(void)
157:{
158:    /* SAT lives at VRAM $FC00 in our genesis_shell.asm boot (VDP reg 5 =
159:     * $7E for H32 mode, 80 sprite slots * 8 bytes each = 640 bytes).
160:     * Zero every slot. Slot 0 with y=0 link=0 attr=0 x=0 is the standard
161:     * "end of sprite list" terminator and produces an off-screen sprite. */
162:    render_vram_open_write(0xFC00u);
163:    /* 640 bytes = 320 words. */
164:    unsigned short i;
165:    for (i = 0; i < 320u; i++) {
166:        VDP_DATA_WORD = 0;
167:    }
168:}
