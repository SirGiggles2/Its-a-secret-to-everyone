741:void cave_try_take_item(unsigned int slot)
742:{
743:    /* drain at cave_runtime.c:356-378. */
744:    if ((unsigned char)RAM(0x03A8u + slot) >= 0xF0u) {
745:        return;
746:    }
747:    {
748:        const unsigned char dy = (unsigned char)(
749:            (unsigned char)RAM(0x0084u) + 3u - (unsigned char)OBJ_Y(slot));
750:        if (core_abs((unsigned int)dy) >= 9u) {
751:            return;
752:        }
753:    }
754:    {
755:        const unsigned char dx = (unsigned char)(
756:            (unsigned char)RAM(0x0070u) - (unsigned char)OBJ_X(slot));
757:        if (core_abs((unsigned int)dx) >= 9u) {
758:            return;
759:        }
760:    }
761:    OBJ_STATE(slot) = 0xFFu;
762:    OBJ_Y(slot) = 0xFFu;
763:    if (slot == CAVE_WARE_DRAW_SLOT) {
764:        progress_set_room_flag_uw_item_state();
765:    }
766:    item_take_item((unsigned char)CAVE_TMP4);
767:}
768:
769:void cave_try_take_room_item(void)
770:{
771:    /* drain at cave_runtime.c:380-393. */
772:    const unsigned int slot = CAVE_WARE_DRAW_SLOT;
773:    if (((unsigned char)CAVE_LINK_ACTION_TIMER & 0xC0u) == 0x40u) {
774:        return;
775:    }
776:    if (progress_get_room_flag_uw_item_state() != 0u) {
777:        return;
778:    }
779:    if ((unsigned char)OBJ_STATE(slot) & 0x80u) {
780:        return;
781:    }
782:    CAVE_TMP4 = (uint8_t)OBJ_DIR(slot);
783:    cave_try_take_item(slot);
784:}
