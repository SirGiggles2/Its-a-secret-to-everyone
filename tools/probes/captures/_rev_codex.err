106:int cave_init(cave_id_t cave_id)
107:{
108:    if (cave_id < CAVE_ID_MIN || cave_id > CAVE_ID_MAX) {
109:        return -1;
110:    }
111:
112:    /* NES parity: entering a cave is a Mode-B transition that runs on a
113:     * FRESH object page â€” the overworld enemies were already cleared before
114:     * InitCave (Z_01.asm:69) / SetUpCommonCaveObjects (Z_01.asm:271). The
115:     * Genesis cave-entry path (cave_fade swap_entry -> cave_init) never
116:     * cleared the enemy slots, so a live OW enemy survived into the cave.
117:     * Byte-proven (probe write-watch on $FF8416): a stale slot-4 WANDERER
118:     * (e.g. octorok) ran enrt_wanderer_target_player, whose
119:     * ENEMY_PUSH_TIMER(slot) cell = $0412+slot ALIASES CAVE_TEXT_CHAR_INDEX
120:     * at slot 4 ($0412+4 = $0416). Every ~32 frames it zeroed the cave text
121:     * char index mid-stream -> shop-cave dialogue re-streamed its prefix
122:     * ("M MAS MA MAS" churn). Give-caves (quiet OW rooms, no slot-4 wanderer)
123:     * were unaffected â€” which masqueraded as a "cave_flags bit 6" issue.
124:     * Clear all enemy slots here so the cave starts NES-fresh; cave_init
125:     * then re-establishes the person (slot 1) + two bonfires (slots 2/3). */
126:    enemy_loop_clear_all_slots();
127:    cave_room_type_set(cave_id);          /* RAM($0350) */
128:    CAVE_PERSON_STATE      = 0u;          /* RAM($00AD) */
129:    CAVE_TEXT_CHAR_INDEX   = 0u;          /* RAM($0416) */
130:    /* Init the text line address LOW byte (latent bug, byte-proven 2026-05-29:
131:     * the streamer's first dialogue line used whatever stale value $045F held,
132:     * so line 1 landed on the wrong nametable row -- e.g. cave 6C streamed its
133:     * whole message onto one Gen row instead of NES's two rows 13/14). NES
134:     * cave text line 1 = $21A4 (row 13) = k_textbox_line_addrs_lo[2]; the
135:     * $80 line-break then advances to $C4 (row 14). The hint-cave path already
136:     * sets this (cave_dispatch.c:654); give/shop caves omitted it. */
137:    CAVE_TEXT_LINE_ADDR_LO = 0xA4u;       /* RAM($045F): k_textbox_line_addrs_lo[2], row 13 */
138:    CAVE_DELAY_TIMER       = 0u;          /* RAM($0029) */
139:    CAVE_LINK_ACTION_TIMER = 0u;          /* RAM($00AC) */
140:    CAVE_LINK_INPUT_FLAGS  = 0u;          /* RAM($00F8) */
141:
142:    /* NES Z_01.asm:69-74 InitCave + :271-293 SetUpCommonCaveObjects port.
143:     * Person at ($78, $80) slot 1; bonfires (type $40) slot 2/3 at
144:     * ($48, $80) and ($A8, $80). Slot 1 ObjType already = cave_id via
145:     * cave_room_type_set(); slot 1 ObjAttr = $81 + ObjHP = 0. Halt Link
146:     * (slot 0 ObjState = $40). Without this port slot 1 OBJ_X/OBJ_Y stayed
147:     * 0 â†’ NPC drew at top-left = invisible (Plan v6-C2 follow-up
148:     * 2026-05-24, probed via gen_cave_npc.png). */
149:    RAM(0x0070u + 1u) = 0x78u;            /* ObjX+1  = slot 1 X */
150:    RAM(0x0084u + 1u) = 0x80u;            /* ObjY+1  = slot 1 Y */
151:    RAM(0x0485u + 1u) = 0x00u;            /* ObjHP+1 = 0 */
152:    RAM(0x03A4u + 1u) = 0x81u;            /* ObjAttr+1 = $81 */
153:    RAM(0x00ACu)     = 0x40u;             /* ObjState (Link) = $40 (halt) */
154:    /* Bonfires slot 2/3 â€” fixed positions flanking the NPC. */
155:    RAM(0x034Fu + 2u) = 0x40u;            /* ObjType+2 = $40 (StandingFire) */
156:    RAM(0x034Fu + 3u) = 0x40u;            /* ObjType+3 = $40 (StandingFire) */
157:    RAM(0x0070u + 2u) = 0x48u;            /* ObjX+2    = $48 */
158:    RAM(0x0070u + 3u) = 0xA8u;            /* ObjX+3    = $A8 */
159:    RAM(0x0084u + 2u) = 0x80u;            /* ObjY+2    = $80 */
160:    RAM(0x0084u + 3u) = 0x80u;            /* ObjY+3    = $80 */
161:    /* Mark bonfires alive so enemy_loop dispatches enrt_update_standing_fire
162:     * per frame. NES uses ObjType != 0 as the alive marker; Gen enemy_loop
163:     * gates on ENEMY_ALIVE_FLAG ($0492+slot). Without setting alive, slot
164:     * 2/3 skipped and bonfire sprites never publish. */
165:    RAM(0x0492u + 2u) = 0x01u;            /* ENEMY_ALIVE_FLAG+2 */
166:    RAM(0x0492u + 3u) = 0x01u;            /* ENEMY_ALIVE_FLAG+3 */
167:
168:    /* NES InitCaveContinue (Z_01.asm:105-170) port:
169:     * 1) cave_idx = cave_id - $6A.
170:     * 2) sel = OverworldPersonTextSelectors[cave_idx].
171:     *    CAVE_TEXT_SELECTOR = sel & $3F; tmp_flags = sel & $C0.
172:     * 3) For 3 wares (i=0..2):
173:     *      ware = LBA_E[cave_idx*3 + i];
174:     *      CaveItemIds[i] = ware;        (RAM $0422+i)
175:     *      ware_flags[i]  = ware & $C0;  (RAM $00..$02 scratch)
176:     *      CavePrices[i]  = LBA_E[cave_idx*3 + i + 60];  (RAM $0430+i)
177:     * 4) CAVE_FLAGS = (tmp_flags>>6) | ware_flags[0] | (ware_flags[2]>>4) | (ware_flags[1]>>2). */
178:    {
179:        unsigned char cave_idx = (unsigned char)(cave_id - 0x6Au);
180:        unsigned char sel = k_overworld_person_text_selectors[cave_idx];
181:        CAVE_TEXT_SELECTOR = (unsigned char)(sel & 0x3Fu);
182:        unsigned char tmp_flags_top = (unsigned char)(sel & 0xC0u);
183:
184:        unsigned char ware_off = (unsigned char)(cave_idx * 3u);
185:        unsigned char ware_flag_0 = 0u, ware_flag_1 = 0u, ware_flag_2 = 0u;
186:        for (unsigned char i = 0u; i < 3u; ++i) {
187:            unsigned char ware  = rooms_overworld[
188:                ROOMROM_OW_LEVELBLOCK_ATTRS_E_OFFSET + ware_off + i];
189:            unsigned char price = rooms_overworld[
190:                ROOMROM_OW_LEVELBLOCK_ATTRS_E_OFFSET + 60u + ware_off + i];
