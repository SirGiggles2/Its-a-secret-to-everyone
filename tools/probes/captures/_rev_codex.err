115:void sprite_animate_object_walking(unsigned int slot)
116:{
117:    /* drain at sprite_runtime.c:104-117. NES AnimateObjectWalking.
118:     * Walk-cycle progression for a moving object slot. */
119:    OBJ_ANIM_CNTR(slot) = (uint8_t)(OBJ_ANIM_CNTR(slot) - 1u);
