1:-- probe_cave_fade_gen.lua â€” Genesis Debug.md cave-fade verification.
2:--
3:-- Captures cave-fade state on the running Debug.md ROM and diffs vs
4:-- the NES baseline written by probe_cave_fade_nes.lua. Per Rule Zero
5:-- + plan Tier 1 Task 1.4 (Gate 2 RAM trace).
6:--
7:-- USAGE:
8:--   1. Boot builds/Debug.md in BizHawk (genplus-gx core).
9:--   2. Hit A+B+C at title to enter Debug gameplay (RoomRom debug-enter).
10:--   3. Walk Link onto entrance tile $24 in OW room $77 (or any cave-
11:--      entrance tile the cave_entrance_check at main.c:1885 recognises).
12:--   4. Script triggers capture from the first frame the entrance hits
13:--      (cave-entry sentinel $07FC increments) and runs for 24 frames.
14:--
15:-- OUTPUT:
16:--   tools/probes/captures/cave_fade_gen.txt  (human log)
17:--   tools/probes/captures/cave_fade_gen.bin  (binary; same format as
18:--                                              NES baseline â€” see
19:--                                              probe_cave_fade_nes.lua)
20:--
21:-- DIFF: tools/probes/baselines/cave_fade_nes_ground_truth.bin is the
22:-- byte-for-byte reference. Compare with a small diff script (TBD per
23:-- plan Task 1.4 Gate 2) â€” for now, eyeball matching cells in the .txt
24:-- logs.
25:
26:local OUT_TXT = "tools/probes/captures/cave_fade_gen.txt"
27:local OUT_BIN = "tools/probes/captures/cave_fade_gen.bin"
28:
29:os.execute('if not exist "tools\\probes\\captures" mkdir "tools\\probes\\captures"')
30:
31:local CAPTURE_FRAMES = 24
32:
33:local log_f = assert(io.open(OUT_TXT, "w"))
34:local bin_f = assert(io.open(OUT_BIN, "wb"))
35:
36:local function log(s)
37:    log_f:write(s .. "\n")
38:    print(s)
39:end
40:
41:local function u32le(v)
42:    return string.char(v & 0xFF) ..
43:           string.char((v >> 8) & 0xFF) ..
44:           string.char((v >> 16) & 0xFF) ..
45:           string.char((v >> 24) & 0xFF)
46:end
47:
48:-- Genesis 68K BUS memory access ----------------------------------------
49:-- Per src/abi/platform_abi.h: Debug.md A4 = $00FF8000 (NES RAM base).
50:-- NES cell $XXXX -> 68K address $FF8000 + $XXXX.
51:
52:local function domain_exists(name)
53:    for _, d in ipairs(memory.getmemorydomainlist()) do
54:        if d == name then return true end
55:    end
56:    return false
57:end
58:
59:local RAM_DOMAIN = "M68K BUS"
60:local NES_BASE   = 0x00FF8000
61:if domain_exists("68K RAM") then
62:    RAM_DOMAIN = "68K RAM"
63:    NES_BASE   = 0x8000  -- 68K RAM domain is 0-indexed at $FF0000
64:end
65:
66:local function nes_r8(addr)
67:    memory.usememorydomain(RAM_DOMAIN)
68:    return memory.read_u8(NES_BASE + addr)
69:end
70:
71:local function transfer_buf_window()
72:    local buf = {}
73:    for i = 0x0302, 0x030F do
74:        buf[#buf + 1] = string.char(nes_r8(i))
75:    end
76:    return table.concat(buf)
77:end
78:
79:-- Genesis CRAM read (64 colors * 2 bytes = 128 bytes) ------------------
80:local function cram_block()
81:    memory.usememorydomain("CRAM")
82:    local buf = {}
83:    for i = 0, 127 do
84:        buf[#buf + 1] = string.char(memory.read_u8(i))
85:    end
86:    return table.concat(buf)
87:end
88:
89:-- Wait for cave-entry sentinel ($07FC) to increment --------------------
90:log("probe_cave_fade_gen â€” waiting for cave-entry trigger")
91:log("  ($07FC sentinel = cave-entry fire counter, set at main.c:1893)")
92:
93:local fc0 = nes_r8(0x07FC)
94:log(string.format("  initial $07FC = 0x%02X â€” walk Link onto entrance tile to trigger", fc0))
95:
96:local timeout = 7200  -- ~2 minutes at 60fps
97:local triggered = false
98:for _ = 1, timeout do
99:    emu.frameadvance()
100:    if nes_r8(0x07FC) ~= fc0 then
101:        triggered = true
102:        break
103:    end
104:end
105:
106:if not triggered then
107:    log("TIMEOUT â€” $07FC never changed. Did you walk into a cave-entrance tile?")
108:    log_f:close()
109:    bin_f:close()
110:    return
111:end
112:
113:local start_frame = emu.framecount()
114:log(string.format("triggered at framecount=%d", start_frame))
115:
116:-- Header
117:bin_f:write("CFNB")
118:bin_f:write(u32le(1))
119:bin_f:write(u32le(start_frame))
120:
121:log(string.format(
122:    "frame_off | $0012 GM | $0013 SM | $051C Fade | $0301 TxPos | $0302..$030F | CRAM 8..15"))
123:
124:for off = 0, CAPTURE_FRAMES - 1 do
125:    local gm   = nes_r8(0x0012)
126:    local sm   = nes_r8(0x0013)
127:    local fade = nes_r8(0x051C)
128:    local pos  = nes_r8(0x0301)
129:    local tbw  = transfer_buf_window()
130:    local pal  = cram_block()
131:
132:    -- Print CRAM slots 8..15 (PAL0[8..15] = cave subpal 2+3 region)
133:    -- inline as 2-byte words to compare against NES palette logic.
134:    local cram_hex = {}
135:    for slot = 8, 15 do
136:        local lo = string.byte(pal, slot * 2 + 1)
137:        local hi = string.byte(pal, slot * 2 + 2)
138:        cram_hex[#cram_hex + 1] = string.format("%02X%02X", hi, lo)
139:    end
140:
141:    local tbw_hex = {}
142:    for i = 1, #tbw do
143:        tbw_hex[#tbw_hex + 1] = string.format("%02X", string.byte(tbw, i))
144:    end
145:
146:    log(string.format(
147:        "  +%02d     | %02X       | %02X       | %02X         | %02X          | %s | %s",
148:        off, gm, sm, fade, pos,
149:        table.concat(tbw_hex, " "),
150:        table.concat(cram_hex, " ")))
151:
152:    -- Binary record (matches NES baseline layout: 4 status bytes + 1 pos
153:    -- + 14 tbw + 32 pal bytes; we pack 32 of the 128 CRAM bytes that
154:    -- correspond to PAL0[0..15] for diff parity with NES PALRAM).
155:    bin_f:write(string.char(off))
156:    bin_f:write(string.char(gm))
157:    bin_f:write(string.char(sm))
158:    bin_f:write(string.char(fade))
159:    bin_f:write(string.char(pos))
160:    bin_f:write(tbw)
161:    bin_f:write(string.sub(pal, 1, 32))  -- PAL0 (16 colors * 2 bytes)
162:
163:    emu.frameadvance()
164:end
165:
166:log("")
167:log("Verification checklist (per plan Task 1.4):")
168:log("  1. $051C cycles $40..$45 during OUT_ENTRY (matches NES baseline).")
169:log("  2. CRAM PAL0[8..15] progressively darken to $0000 during fade-out.")
170:log("  3. $0012 GameMode = $05 throughout (RoomRom keeps Mode 5 Play;")
171:log("     NES uses $10 fade->$0B cave-mode â€” divergence expected).")
172:log("  4. SWAP frame: CRAM[8..15] snaps to cave colors then to black.")
173:log("  5. IN_CAVE phase: CRAM[8..15] ramps up from black to cave palette.")
174:
175:bin_f:close()
176:log_f:close()
177:print("Done. Capture written to:")
178:print("  " .. OUT_TXT)
179:print("  " .. OUT_BIN)
