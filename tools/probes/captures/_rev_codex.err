214:    if (foot_y < ROOMROM_WARP_PLAYFIELD_TOP_PX) return 0u;
215:    *y_out = (short)(foot_y - ROOMROM_WARP_PLAYFIELD_TOP_PX);
216:    return 1u;
217:}
