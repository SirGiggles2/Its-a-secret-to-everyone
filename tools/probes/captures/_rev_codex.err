723:void cave_draw_person(unsigned int slot)
724:{
725:    /* drain at oracle/cave/cave_runtime.c:191-197. NES DrawCavePerson
726:     * (Z_01.asm DrawCavePerson via c_draw_cave_person).
727:     *
728:     * Fetch sprite descriptor pos, then mirrored vs non-mirrored
729:     * draw based on cave_id $7B threshold. Frame defaults to 0 â€”
730:     * the c_draw_object_* shim doesn't set D0 either, and cave
731:     * persons are static. */
732:    sprite_anim_fetch_obj_pos(slot);
733:    const unsigned char cave_id = cave_room_type_get();
734:    if (cave_id < 0x7Bu) {
735:        draw_object_mirrored(0u, slot);
736:    } else {
737:        draw_object_not_mirrored(0u, slot);
738:    }
739:}
