786:/* STAGE-2 partial port: Link side-render during textbox. NES asm
787: * Link_EndMoveAndDraw freezes anim timer + chains to
788: * Link_EndMoveAndAnimate (huge ladder/water/warp/draw chain).
789: * For textbox context Link is halted, so the move + warp logic is
790: * effectively no-op â€” only the draw matters. Native partial
791: * implementation: freeze anim, fetch sprite-descriptor pos,
792: * draw Link statically via native draw_dispatch. Full fidelity
793: * (ladder/water/warp/animation) deferred to phase 5
794: * Link_EndMoveAndAnimate native port. */
795:static void cave_link_end_move_and_draw_stub(void)
796:{
797:    /* Freeze Link's anim timer (NES Link_EndMoveAndDraw freezes it during
798:     * the textbox). Link's SPRITE is drawn every frame by the main-loop
799:     * sprite_render path (fixed SAT slot, Link CHR tile $357) â€” see
800:     * RoomRom/src/main.c gameplay tick. The NES-ported static draw below
801:     * was REDUNDANT and BUGGY on Genesis: this stub fetched Link's
802:     * position but never set his animation tile (the full
803:     * Link_EndMoveAndAnimate chain is unported), so draw_object_mirrored
804:     * inherited the LAST-drawn object's stale sprite descriptor â€” the
805:     * bonfire's tile $5C + attr $02 â€” and published a phantom flame at
806:     * Link's position (120,192). Verified via the live enemy_render
807:     * publish cache (slot 1 entry 4 = t$5C a$02 @120,192). Drop the
808:     * redundant draw; Link still renders via sprite_render. */
809:    OBJ_ANIM_TIMER(0) = 6u;
810:}
