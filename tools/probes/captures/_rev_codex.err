103:#define NES_SRAM_LBA_E_BASE  0x6A7Eu     /* LevelBlockAttrsE (Variables.inc:331) */
104:#define NES_SRAM_LBA_E_PRICE 0x6ABAu     /* LBA_E + 60 (prices region) */
