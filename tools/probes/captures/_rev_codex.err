431:static void clear_hud_underlay_for_row_base(u8 row_base)
432:{
433:    u16 rows_left = (u16)ROOMROM_HUD_ROWS;
434:    u16 row = row_base;
435:    const u16 col = s_active_slot_x ? ROOMROM_SLOT_TILES : 0u;
436:
437:    /* Window tile color 0 is transparent, so the shared scroll surface under
438:     * the HUD must be black at the active row base. Fixed rows 0..6 are not
439:     * always safe: after an upward scroll they are live bottom-room rows. */
440:    while (rows_left != 0u) {
441:        u16 chunk = (u16)(ROOMROM_PLANE_ROWS - row);
442:        if (chunk > rows_left) chunk = rows_left;
443:        VDP_clearTileMapRect(BG_A, col, row, ROOMROM_SLOT_TILES, chunk);
444:        rows_left = (u16)(rows_left - chunk);
445:        row = 0u;
446:    }
447:}
