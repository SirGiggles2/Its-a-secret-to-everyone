455:/* Forward-decl of s_link_frame which is defined below at line ~529 with
456: * other Link movement statics. Cave fade descend handler ticks it to
457: * give Link a visible walk-cycle while sinking into the entrance. */
458:extern u8 s_link_frame;
459:
460:/* Tier 1 cave-fade callbacks. cave_fade.c owns sequencing + cave_init/
461: * cave_exit + plane fill; this side owns Link reposition + scene flip
462: * + HUD underlay reset (which need RoomRom-local statics). */
463:
464:/* Per NES Z_05.asm:2308 UpdateMode10Stairs: Link Y += 1 every 4 frames.
465: * cave_fade.c calls this 16 times across the descend (step_idx 0..15). */
466:static void cave_fade_descend_step_handler(unsigned char step_idx)
467:{
468:    (void)step_idx;
469:    players[0].y = (short)(players[0].y + 1);
470:    /* Mirror new Y to nes_ram $0084 so the gated sync at line 1865 (which
471:     * is suppressed during cave_fade) doesn't leave Link's collision/
472:     * sprite cells stale at the trigger frame's Y. */
473:    nes_ram[0x0084u] = (unsigned char)players[0].y;
474:
475:    /* NES walk-anim cycle: NES Link_EndMoveAndAnimate ticks pose every
476:     * frame; we toggle on every descend step (every 4 frames) so the
477:     * legs cycle visibly during the 64-frame descend. */
478:    s_link_frame ^= 1u;
479:
480:    /* NES also sets sprite priority bit $20 on Link upper-half sprites
481:     * so the entrance arch tile covers them ("Link sinks into hole"
482:     * effect). Genesis SAT priority bit is high â€” defer this polish:
483:     * direct VDP SAT munge needs sprite_render.c hook. For now, Link
484:     * walks down without arch overlay. */
485:}
486:
487:static void cave_fade_swap_entry_handler(cave_id_t cid)
488:{
489:    (void)cid;
490:    s_scene = SCENE_CAVE;
491:    /* NES Z1 cave-entry Link spawn: bottom-center facing up. */
492:    players[0].x    = 120u;
493:    players[0].y    = 192u;
494:    players[0].face = LINK_FACE_UP;
495:}
496:
497:/* NES cave-exit Mode 10 mirror: Link walks UP, Y -= 1 every 4 frames
498: * for 16 frames. Same walk-anim toggle as descend. */
499:static void cave_fade_ascend_step_handler(unsigned char step_idx)
500:{
501:    (void)step_idx;
502:    players[0].y = (short)(players[0].y - 1);
503:    nes_ram[0x0084u] = (unsigned char)players[0].y;
504:    s_link_frame ^= 1u;
505:}
506:
507:static void cave_fade_swap_exit_handler(void)
508:{
509:    s_scene = SCENE_OW;
510:    /* Restore Link 16 px south of the cave entrance so the entrance
511:     * tile is not re-triggered on the next frame. Matches the
512:     * existing-instant-exit logic that lived inline at main.c:2050. */
513:    players[0].x    = s_cave_return_x;
514:    players[0].y    = (u8)(s_cave_return_y + 16u);
515:    players[0].face = LINK_FACE_DOWN;
516:    /* HUD underlay must be re-asserted after cave_fade restores the OW
517:     * plane (cave_exit does not re-enter load_room). */
518:    clear_hud_underlay_for_row_base(s_active_row_base);
519:}
520:
521:static const cave_fade_callbacks_t k_cave_fade_callbacks = {
522:    cave_fade_descend_step_handler,
523:    cave_fade_swap_entry_handler,
524:    cave_fade_ascend_step_handler,
525:    cave_fade_swap_exit_handler
526:};
527:
528:static void anchor_active_slot(void)
529:{
530:    set_bg_scroll(s_active_scroll_x, s_active_scroll_y);
531:}
532:
533:static void set_room_render_target_plane(u8 plane)
534:{
535:    if (s_scene == SCENE_UW) {
536:        roomrom_uw_room_render_set_target_plane(plane);
537:    } else {
538:        roomrom_ow_room_render_set_target_plane(plane);
539:    }
540:}
