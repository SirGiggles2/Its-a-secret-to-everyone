 succeeded in 1350ms:
1:-- probe_cave_fade_nes.lua â€” NES Zelda 1 cave-entry baseline capture.
2:--
3:-- Rule Zero baseline for Tier 1 cave-animation work. Captures the
4:-- NES PPU palette, RAM state, and TRANSFER_BUF record bytes across
5:-- the cave-entry window (entrance tile detection -> GameMode $10 fade
6:-- -> cave room load -> GameMode $0B normal-cave).
7:--
8:-- USAGE:
9:--   1. Load real NES Zelda 1 ROM in BizHawk (NES core).
10:--   2. Either start a fresh save and walk Link to a cave room
11:--      (e.g. room $77 spawn cave), OR use save-state on first cave
12:--      entrance tile.
13:--   3. Set CAPTURE_AT_FRAME global before loading this script (default
14:--      = current framecount + 60, so you have ~1s to align Link).
15:--   4. Load the script; it advances frame by frame, dumping per-frame
16:--      state for 24 frames into the .txt log and one binary snapshot
17:--      of the full PPU palette + 8-byte cave subpal record into the
18:--      .bin file.
19:--
20:-- OUTPUT:
21:--   tools/probes/baselines/cave_fade_nes_ground_truth.txt  (human log)
22:--   tools/probes/baselines/cave_fade_nes_ground_truth.bin  (binary)
23:--
24:-- BINARY FORMAT (.bin):
25:--   [4 bytes magic "CFNB"][4 bytes version u32 LE = 1]
26:--   [4 bytes capture-start framecount u32 LE]
27:--   24 frame records, each:
28:--     [1 byte frame_offset (0..23)]
29:--     [1 byte $0012 GameMode]
30:--     [1 byte $0013 Submode]
31:--     [1 byte $051C FadeCycle]
32:--     [1 byte $0301 TransferBufPos]
33:--     [14 bytes $0302..$030F transfer-buf record window]
34:--     [32 bytes PPU $3F00..$3F1F palette]
35:--   total per record: 51 bytes; 24 records = 1224 bytes payload.
36:--
37:-- Per Rule Zero: the 8 bytes at PPU $3F08-$3F0F captured here are the
38:-- ground truth that k_cave_subpal_2_3_nes[8] in
39:-- src/game/world/render/cave_palette.c must match byte-for-byte.
40:
41:local OUT_TXT = "tools/probes/baselines/cave_fade_nes_ground_truth.txt"
42:local OUT_BIN = "tools/probes/baselines/cave_fade_nes_ground_truth.bin"
43:
44:os.execute('if not exist "tools\\probes\\baselines" mkdir "tools\\probes\\baselines"')
45:
46:local CAPTURE_FRAMES = 24
47:local CAPTURE_AT_FRAME = CAPTURE_AT_FRAME or (emu.framecount() + 60)
48:
49:local log_f = assert(io.open(OUT_TXT, "w"))
50:local bin_f = assert(io.open(OUT_BIN, "wb"))
51:
52:local function log(s)
53:    log_f:write(s .. "\n")
54:    print(s)
55:end
56:
57:local function u32le(v)
58:    return string.char(v & 0xFF) ..
59:           string.char((v >> 8) & 0xFF) ..
60:           string.char((v >> 16) & 0xFF) ..
61:           string.char((v >> 24) & 0xFF)
62:end
63:
64:-- Helpers --------------------------------------------------------------
65:
66:local function bus_u8(addr)
67:    memory.usememorydomain("System Bus")
68:    return memory.read_u8(addr)
69:end
70:
71:local function palram_block()
72:    memory.usememorydomain("PALRAM")
73:    local buf = {}
74:    for i = 0, 31 do
75:        buf[#buf + 1] = string.char(memory.read_u8(i))
76:    end
77:    return table.concat(buf)
78:end
79:
80:local function transfer_buf_window()
81:    memory.usememorydomain("System Bus")
82:    local buf = {}
83:    for i = 0x0302, 0x030F do
84:        buf[#buf + 1] = string.char(memory.read_u8(i))
85:    end
86:    return table.concat(buf)
87:end
88:
89:-- Wait for capture start frame -----------------------------------------
90:
91:log(string.format("probe_cave_fade_nes â€” start at framecount=%d (target=%d)",
92:                  emu.framecount(), CAPTURE_AT_FRAME))
93:
94:while emu.framecount() < CAPTURE_AT_FRAME do
95:    emu.frameadvance()
96:end
97:
98:local start_frame = emu.framecount()
99:
100:-- Header
101:bin_f:write("CFNB")
102:bin_f:write(u32le(1))
103:bin_f:write(u32le(start_frame))
104:
105:log(string.format(
106:    "frame_off | $0012 GameMode | $0013 Submode | $051C FadeCycle | $0301 TxBufPos | $0302..$030F | $3F08..$3F0F"))
107:
108:for off = 0, CAPTURE_FRAMES - 1 do
109:    local gm   = bus_u8(0x0012)
110:    local sm   = bus_u8(0x0013)
111:    local fade = bus_u8(0x051C)
112:    local pos  = bus_u8(0x0301)
113:    local tbw  = transfer_buf_window()
114:    local pal  = palram_block()
115:
116:    -- Print cave subpal 2+3 (PPU $3F08..$3F0F) inline.
117:    local pal_hex = {}
118:    for i = 9, 16 do  -- 1-indexed Lua: $3F08 = byte index 9
119:        pal_hex[#pal_hex + 1] = string.format("%02X", string.byte(pal, i))
120:    end
121:
122:    local tbw_hex = {}
123:    for i = 1, #tbw do
124:        tbw_hex[#tbw_hex + 1] = string.format("%02X", string.byte(tbw, i))
125:    end
126:
127:    log(string.format(
128:        "  +%02d     | %02X            | %02X            | %02X             | %02X            | %s | %s",
129:        off, gm, sm, fade, pos,
130:        table.concat(tbw_hex, " "),
131:        table.concat(pal_hex, " ")))
132:
133:    -- Binary record
134:    bin_f:write(string.char(off))
135:    bin_f:write(string.char(gm))
136:    bin_f:write(string.char(sm))
137:    bin_f:write(string.char(fade))
138:    bin_f:write(string.char(pos))
139:    bin_f:write(tbw)
140:    bin_f:write(pal)
141:
142:    emu.frameadvance()
143:end
144:
145:log("")
146:log("RULE ZERO CHECK: paste these 8 bytes into")
147:log("  src/game/world/render/cave_palette.c k_cave_subpal_2_3_nes[8]")
148:log("if they differ from the cited Z_06.asm:714 values.")
149:log("Frame +N PPU $3F08..$3F0F is the cave subpal 2+3 snapshot when")
150:log("GameMode == $0B (cave normal). Look for the first row where")
151:log("GameMode shows $0B and copy $3F08..$3F0F from that row.")
152:
153:bin_f:close()
154:log_f:close()
155:print("Done. Baseline written to:")
156:print("  " .. OUT_TXT)
157:print("  " .. OUT_BIN)
