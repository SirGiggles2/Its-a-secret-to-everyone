                            	    55:     section "text",code
                            	    56: 
                            	    57: EntryPoint:
                            	    58:     ; TMSS handshake
02:00000000 103900A10001    	    59:     move.b  (VERSION_PORT).l,D0
02:00000006 0200000F        	    60:     andi.b  #$0F,D0
02:0000000A 6710            	    61:     beq.s   .skip_tmss
02:0000000C 23FC5345474100A1	    62:     move.l  #$53454741,(TMSS_PORT).l
02:00000014 4000
02:00000016 700F            	    63:     moveq   #15,D0
                            	    64: .tmss_delay:
02:00000018 51C8FFFE        	    65:     dbra    D0,.tmss_delay
                            	    66: .skip_tmss:
                            	    67: 
                            	    68:     ; Stop Z80
02:0000001C 33FC010000A11100	    69:     move.w  #$0100,(Z80_BUSREQ).l
02:00000024 33FC010000A11200	    70:     move.w  #$0100,(Z80_RESET).l
                            	    71: .z80wait:
02:0000002C 0839000000A11100	    72:     btst    #0,(Z80_BUSREQ).l
02:00000034 66F6            	    73:     bne.s   .z80wait
                            	    74: 
                            	    75:     ; VDP register init — H32 mode, plane size H32 V32, display OFF during init.
02:00000036 33FC800400C00004	    76:     move.w  #$8004,(VDP_CTRL).l   ; Reg  0: colorfix bit2=1
02:0000003E 33FC813400C00004	    77:     move.w  #$8134,(VDP_CTRL).l   ; Reg  1: display OFF, VBlank IRQ on, M5
02:00000046 33FC823000C00004	    78:     move.w  #$8230,(VDP_CTRL).l   ; Reg  2: Plane A @ $C000
02:0000004E 33FC832C00C00004	    79:     move.w  #$832C,(VDP_CTRL).l   ; Reg  3: Window  @ $B000
02:00000056 33FC840700C00004	    80:     move.w  #$8407,(VDP_CTRL).l   ; Reg  4: Plane B @ $E000
02:0000005E 33FC857C00C00004	    81:     move.w  #$857C,(VDP_CTRL).l   ; Reg  5: Sprite table @ $F800
02:00000066 33FC860000C00004	    82:     move.w  #$8600,(VDP_CTRL).l   ; Reg  6
02:0000006E 33FC870000C00004	    83:     move.w  #$8700,(VDP_CTRL).l   ; Reg  7: BG color = palette 0, color 0
02:00000076 33FC880000C00004	    84:     move.w  #$8800,(VDP_CTRL).l   ; Reg  8
02:0000007E 33FC890000C00004	    85:     move.w  #$8900,(VDP_CTRL).l   ; Reg  9
02:00000086 33FC8AFF00C00004	    86:     move.w  #$8AFF,(VDP_CTRL).l   ; Reg 10: H-int counter = $FF (off)
02:0000008E 33FC8B0000C00004	    87:     move.w  #$8B00,(VDP_CTRL).l   ; Reg 11: full-screen scroll
02:00000096 33FC8C0000C00004	    88:     move.w  #$8C00,(VDP_CTRL).l   ; Reg 12: H32 mode
02:0000009E 33FC8D3F00C00004	    89:     move.w  #$8D3F,(VDP_CTRL).l   ; Reg 13: H-scroll table @ $FC00
02:000000A6 33FC8E0000C00004	    90:     move.w  #$8E00,(VDP_CTRL).l   ; Reg 14
02:000000AE 33FC8F0200C00004	    91:     move.w  #$8F02,(VDP_CTRL).l   ; Reg 15: auto-inc = 2
02:000000B6 33FC900000C00004	    92:     move.w  #$9000,(VDP_CTRL).l   ; Reg 16: plane size H32 x V32
02:000000BE 33FC910000C00004	    93:     move.w  #$9100,(VDP_CTRL).l   ; Reg 17: window H = 0
02:000000C6 33FC920000C00004	    94:     move.w  #$9200,(VDP_CTRL).l   ; Reg 18: window V = 0 (window off)
                            	    95: 
                            	    96:     ; Establish stack
02:000000CE 2E7C00FFFFFE    	    97:     move.l  #STACK_TOP,A7
                            	    98: 
                            	    99:     ; Jump to C main
02:000000D4 4EB900000000    	   100:     jsr     main
                            	   101: 
                            	   102:     ; If main returns, halt
                            	   103: .halt:
02:000000DA 60FE            	   104:     bra.s   .halt
                            	   105: 
