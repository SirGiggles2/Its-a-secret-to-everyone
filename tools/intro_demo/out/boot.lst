                            	     1: ;==============================================================================
                            	     2: ; intro_demo/boot.asm — standalone Genesis ROM boot
                            	     3: ;
                            	     4: ; Boots, inits VDP for H32x V32 plane, sets up stack, jumps to C main().
                            	     5: ; No NES emulation, no shell. Pure Genesis.
                            	     6: ;==============================================================================
