   void inventory_subscreen_exit(void)
  @@ -240,8 +248,85 @@ void inventory_subscreen_exit(void)
  +/* P6.5 cursor state — index into 8-slot B-item row. */
  +#define B_ITEM_SLOT_COUNT  8u
  +static unsigned char s_cursor_slot = 0u;
  +static unsigned char s_prev_joy = 0u;
  +
  +/* B-item slot ownership check — used to skip empty slots when cursor moves. */
  +static unsigned char b_item_owned(unsigned char slot)
  +{
  +    switch (slot) {
  +        case 0: return g_inventory.boomerang_wood;
  +        case 1: return (g_inventory.bombs > 0u) ? 1u : 0u;
  +        case 2: return g_inventory.bow;
  +        case 3: return (g_inventory.candle > 0u) ? 1u : 0u;
  +        case 4: return (g_inventory.items & ITEMS_BIT_WAND) ? 1u : 0u;
  +        case 5: return (g_inventory.items & ITEMS_BIT_FLUTE) ? 1u : 0u;
  +        case 6: return g_inventory.food;
  +        case 7: return (g_inventory.potion > 0u) ? 1u : 0u;
  +        default: return 0u;
  +    }
  +}
  +
  +/* Draw cursor sprite at the current slot's screen position. Uses last
  + * SAT slot of the subscreen sprite block to avoid stepping on item icons. */
  +/* Cursor sprite occupies SAT slot s_cursor_sat (set during enter to be
  + * the next slot after item icons). Link chain runs: items -> cursor -> 0. */
  +static unsigned char s_cursor_sat = 0u;
  +
  +static void draw_cursor(void)
  +{
  +    /* B-item slot X positions match draw_item_icon calls in
  +     * inventory_subscreen_enter. y same as b_row_y. */
  +    unsigned short b_row_y = 0x80u + 0x40u;
  +    unsigned short x = (unsigned short)(0x40u + s_cursor_slot * 0x10u);
  +    /* Cursor uses a Z1 inventory pointer-style tile. For V1 we reuse
  +     * the BIG_KEY tile (rectangular block) as a placeholder. Real Z1
  +     * uses a small flashing arrow tile (subscreen-specific CHR). */
  +    unsigned short vram_tile = (unsigned short)(ITEM_VRAM_TILE_BASE +
  +                                                ROOMROM_ITEM_TILE_BIG_KEY);
  +    unsigned short attr = RENDER_TILE_ATTR_FULL(RENDER_PAL2, 0, 0, 0, vram_tile);
  +    /* link=0 = end-of-chain terminator (cursor is last sprite in chain). */
  +    sat_write(s_cursor_sat, b_row_y, RENDER_SPRITE_SIZE(1, 2), 0u, attr, x);
  +}
  +
