02:0003BCFC 41EC0084        	  8408:     lea     ($0084,A4),A0
02:0003BD00 10302000        	  8409:     move.b  (A0,D2.W),D0
02:0003BD04 19400001        	  8410:     move.b  D0,($0001,A4)
02:0003BD08 6100FF62        	  8411:     jsr     Ganon_DrawCloud
02:0003BD0C 6172            	  8412:     jsr     Ganon_GetCurCloudRight
02:0003BD0E 6100FF5C        	  8413:     jsr     Ganon_DrawCloud
                            	  8414:     ; Save the object index.
                            	  8415:     ;
02:0003BD12 102C0340        	  8416:     move.b  ($0340,A4),D0
02:0003BD16 1B00            	  8417:     move.b  D0,-(A5)  ; PHA
                            	  8418:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8419:     ;
02:0003BD18 7402            	  8420:     moveq   #2,D2
                            	  8421:     even
                            	  8422: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003BD1A 19420340        	  8423:     move.b  D2,($0340,A4)
                            	  8424:     ; If object slot < 5 or = 7, then move every frame.
                            	  8425:     ; Else move 3 out of every 4 frames.
                            	  8426:     ;
                            	  8427:     ; This makes pieces spread out in somewhat of a circle,
                            	  8428:     ; by making the pieces at cardinal directions move at
                            	  8429:     ; full speed while the diagonal ones move a little slower.
                            	  8430:     ;
02:0003BD1E 0C020005        	  8431:     cmpi.b  #$05,D2
02:0003BD22 6510            	  8432:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003BD24 0C020007        	  8433:     cmpi.b  #$07,D2
