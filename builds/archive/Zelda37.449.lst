                            	  3778: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3779:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3780:     ;
                            	  3781:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3782:     ;         or object direction when <> 0.
                            	  3783:     ;
                            	  3784:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3785:     ;
                            	  3786:     ; if slot = 0 and grid offset <> 0 then
                            	  3787:     ;   if input dir = 0 then
                            	  3788:     ;     use 0
                            	  3789:     ;   else
                            	  3790:     ;     use object direction
                            	  3791:     ; else
                            	  3792:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3793:     ;     return
                            	  3794:     ;   else
                            	  3795:     ;     if input dir = 0
                            	  3796:     ;       use 0
                            	  3797:     ;     else
                            	  3798:     ;       use input direction
                            	  3799:     ;
