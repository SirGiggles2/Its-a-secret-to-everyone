02:00047F48 7001            	  4215:     moveq   #1,D0
02:00047F4A 61001A74        	  4216:     jsr     SwitchBank
02:00047F4E 4EB9000308EE    	  4217:     jsr     CheckPassiveTileObjects
                            	  4218:     even
