                            	  5462:     even
                            	  5463: _L_z07_CheckState30_SetState40:
                            	  5464:     ; Set state $40, and a time to move of $20 frames.
                            	  5465:     ;
                            	  5466:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5467:     ;
                            	  5468:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5469:     ;
02:000487A2 7020            	  5470:     moveq   #32,D0
02:000487A4 41EC0380        	  5471:     lea     ($0380,A4),A0
02:000487A8 11802000        	  5472:     move.b  D0,(A0,D2.W)
