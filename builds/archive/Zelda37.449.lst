                            	  4038: PlayerScreenEdgeBounds:
02:00047E9C 3D              	  4039:     dc.b    $3D, $DD, $00, $F0
02:00047E9D DD
02:00047E9E 00
02:00047E9F F0
                            	  4040: 
                            	  4041: ; Params:
                            	  4042: ; [0E]: $FF, if blocked by a door
                            	  4043: ; [0F]: movement direction
                            	  4044: ;
                            	  4045: ; Returns:
                            	  4046: ; [0F]: untouched, or changed if blocked or need to change
                            	  4047: ;
                            	  4048: ; Summary:
                            	  4049: ;
                            	  4050: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4051: ; Then allow movement or go to the next room. Otherwise,
                            	  4052: ; check passive tile objects and stop moving.
                            	  4053: ;
                            	  4054: ; For other objects: First, if moving, test the colliding tile for
                            	  4055: ; walkability. Otherwise search for a walkable direction starting
                            	  4056: ; from input direction.
                            	  4057: ;
                            	  4058: ; When you find a walkable direction, see if it makes the object
                            	  4059: ; cross a boundary. If it doesn't, then make this direction
                            	  4060: ; the objection direction. Otherwise, keep looping.
                            	  4061: ;
                            	  4062: ; If no walkable direction is found, then stop moving.
                            	  4063: ;
                            	  4064: ;
                            	  4065: ; if is player
                            	  4066: ;   if at doorway
                            	  4067: ;     go handle a walkable direction
                            	  4068: ;   if blocked by door
                            	  4069: ;     return
                            	  4070: ;
                            	  4071:     even
                            	  4072: Walker_CheckTileCollision:
                            	  4073:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4074:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4075:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4076:     ; reset) for Link and every other object. Only the tile
                            	  4077:     ; walkability decision in CheckTiles is overridden.
02:00047EA0 4A02            	  4078:     cmpi.b  #$00,D2
02:00047EA2 6614            	  4079:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:00047EA4 102C0053        	  4080:     move.b  ($0053,A4),D0
02:00047EA8 6704            	  4081:     beq  _anon_z07_16
02:00047EAA 600000BE        	  4082:     jmp     GoWalkableDir
                            	  4083: 
                            	  4084: _anon_z07_16:
02:00047EAE 102C000E        	  4085:     move.b  ($000E,A4),D0
02:00047EB2 6A04            	  4086:     bpl.s  __far_z_07_0046
02:00047EB4 600000AC        	  4087:     jmp  L1F148_Exit
                            	  4088: __far_z_07_0046:
                            	  4089:     even
                            	  4090: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4091:     ; If grid offset <> 0, return.
                            	  4092:     ;
02:00047EB8 41EC0394        	  4093:     lea     ($0394,A4),A0
02:00047EBC 10302000        	  4094:     move.b  (A0,D2.W),D0
02:00047EC0 6704            	  4095:     beq.s  __far_z_07_0047
02:00047EC2 6000009E        	  4096:     jmp  L1F148_Exit
                            	  4097: __far_z_07_0047:
                            	  4098:     ; Grid offset = 0.
                            	  4099:     ; The object is at a point between cells in the grid.
                            	  4100:     ; So, we can check tiles for collision.
                            	  4101:     ;
                            	  4102:     ; Reset [0E] alternate direction search step.
                            	  4103:     ;
02:00047EC6 1940000E        	  4104:     move.b  D0,($000E,A4)
                            	  4105:     ; If there's a movement direction, go check tile collision.
                            	  4106:     ;
02:00047ECA 102C000F        	  4107:     move.b  ($000F,A4),D0
02:00047ECE 6702            	  4108:     beq.s  __far_z_07_0048
02:00047ED0 602E            	  4109:     jmp  CheckTiles
                            	  4110: __far_z_07_0048:
                            	  4111:     ; Moving direction = 0.
                            	  4112:     ; If object is the player, return.
                            	  4113:     ;
02:00047ED2 4A02            	  4114:     cmpi.b  #$00,D2
02:00047ED4 6604            	  4115:     bne.s  __far_z_07_0049
02:00047ED6 6000008A        	  4116:     jmp  L1F148_Exit
                            	  4117: __far_z_07_0049:
                            	  4118:     ; Moving direction = 0.
                            	  4119:     ; The object is not the player.
                            	  4120:     ;
                            	  4121:     ; If object does not have attribute $10, then
                            	  4122:     ; set movement direction to input direction,
                            	  4123:     ; and go try to turn to an unblocked direction in order to move.
                            	  4124:     ;
02:00047EDA 41EC04BF        	  4125:     lea     ($04BF,A4),A0
02:00047EDE 10302000        	  4126:     move.b  (A0,D2.W),D0
02:00047EE2 02000010        	  4127:     andi.b #$10,D0
02:00047EE6 6702            	  4128:     beq.s  __far_z_07_0050
02:00047EE8 600E            	  4129:     jmp  Reverse
                            	  4130: __far_z_07_0050:
02:00047EEA 41EC03F8        	  4131:     lea     ($03F8,A4),A0
02:00047EEE 10302000        	  4132:     move.b  (A0,D2.W),D0
02:00047EF2 1940000F        	  4133:     move.b  D0,($000F,A4)
02:00047EF6 6038            	  4134:     jmp     TryNextDir
                            	  4135: 
                            	  4136:     even
                            	  4137: Reverse:
                            	  4138:     ; UNKNOWN:
                            	  4139:     ; This seems to be unused code triggered by object attribute $10.
                            	  4140:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4141:     ;
02:00047EF8 610000E2        	  4142:     jsr     ReverseObjDir
02:00047EFC 6000009E        	  4143:     jmp     CheckBoundary
                            	  4144: 
                            	  4145:     even
                            	  4146: CheckTiles:
                            	  4147:     ifne TURBO_LINK
                            	  4148:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4149:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00047F00 4A02            	  4150:     tst.b   D2
02:00047F02 6608            	  4151:     bne.s   _L_z07_CheckTiles_notLink
02:00047F04 197C0024049E    	  4152:     move.b  #$24,($049E,A4)
02:00047F0A 605E            	  4153:     jmp     GoWalkableDir
                            	  4154: _L_z07_CheckTiles_notLink:
                            	  4155:     endc
                            	  4156:     ; The code below applies to Link and other objects.
                            	  4157:     ;
                            	  4158:     ; Test the moving direction's walkability.
                            	  4159:     ;
                            	  4160:     ; For the player, this is enough. For other objects, this 
                            	  4161:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4162:     ;
                            	  4163:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4164:     ;
02:00047F0C 6100FB88        	  4165:     jsr     GetCollidingTileMoving
02:00047F10 122C034A        	  4166:     move.b  ($034A,A4),D1
02:00047F14 B001            	  4167:     cmp.b   D1,D0
02:00047F16 6402            	  4168:     bcc.s  __far_z_07_0051
02:00047F18 6050            	  4169:     jmp  GoWalkableDir
                            	  4170: __far_z_07_0051:
                            	  4171:     ; The colliding tile is unwalkable.
                            	  4172:     ;
                            	  4173:     ; If object is the player, then go check passive tile objects and
                            	  4174:     ; the screen edge, or stop moving.
                            	  4175:     ;
02:00047F1A 4A02            	  4176:     cmpi.b  #$00,D2
02:00047F1C 6602            	  4177:     bne.s  __far_z_07_0052
02:00047F1E 6022            	  4178:     jmp  PlayerUnwalkable
                            	  4179: __far_z_07_0052:
                            	  4180:     even
                            	  4181: CheckObjAttr10AndAltDir:
                            	  4182:     ; Not the player.
                            	  4183:     ; If object attribute has $10, go to the unused code above
                            	  4184:     ; to reverse direction.
                            	  4185:     ;
02:00047F20 41EC04BF        	  4186:     lea     ($04BF,A4),A0
02:00047F24 10302000        	  4187:     move.b  (A0,D2.W),D0
02:00047F28 02000010        	  4188:     andi.b #$10,D0
02:00047F2C 6702            	  4189:     beq.s  __far_z_07_0053
02:00047F2E 60C8            	  4190:     jmp  Reverse
                            	  4191: __far_z_07_0053:
                            	  4192:     even
                            	  4193: TryNextDir:
                            	  4194:     ; Get the next direction to check, and set moving direction to it.
                            	  4195:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4196:     ;
02:00047F30 61000080        	  4197:     jsr     Walker_GetNextAltDir
02:00047F34 1940000F        	  4198:     move.b  D0,($000F,A4)
02:00047F38 102C000E        	  4199:     move.b  ($000E,A4),D0
02:00047F3C 6702            	  4200:     beq.s  __far_z_07_0054
02:00047F3E 60C0            	  4201:     jmp  CheckTiles
                            	  4202: __far_z_07_0054:
02:00047F40 4E75            	  4203:     rts
                            	  4204: 
                            	  4205:     even
                            	  4206: PlayerUnwalkable:
                            	  4207:     ; Tile is not walkable. Object is player.
                            	  4208:     ;
