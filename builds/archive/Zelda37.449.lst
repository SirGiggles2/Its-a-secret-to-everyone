02:00038B70 670000A8        	  1640:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1641:     ; If is zora, and state >= 2 and < 5, then use frame image 2 or 3
                            	  1642:     ; (front or back), which was stored in ObjDir above.
                            	  1643:     ;
02:00038B74 7600            	  1644:     moveq   #0,D3
02:00038B76 41EC034F        	  1645:     lea     ($034F,A4),A0
02:00038B7A 16302000        	  1646:     move.b  (A0,D2.W),D3
02:00038B7E 0C030011        	  1647:     cmpi.b  #$11,D3
02:00038B82 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B84 7600            	  1649:     moveq   #0,D3
02:00038B86 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:00038B8A 16302000        	  1651:     move.b  (A0,D2.W),D3
02:00038B8E 0C030002        	  1652:     cmpi.b  #$02,D3
02:00038B92 6510            	  1653:     bcs  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B94 0C030005        	  1654:     cmpi.b  #$05,D3
02:00038B98 640A            	  1655:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B9A 41EC0098        	  1656:     lea     ($0098,A4),A0
02:00038B9E 10302000        	  1657:     move.b  (A0,D2.W),D0
