                            	  4781: Aquamentus_Draw:
                            	  4782:     ; Every $10 screen frames, switch animation frames.
                            	  4783:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  4784:     ; The last tile of frame 0 is at index 5.
                            	  4785:     ; The last tile of frame 1 is at index $B.
                            	  4786:     ;
02:0003A20C 7605            	  4787:     moveq   #5,D3
02:0003A20E 102C0015        	  4788:     move.b  ($0015,A4),D0
02:0003A212 02000010        	  4789:     andi.b #$10,D0
02:0003A216 6602            	  4790:     bne  _anon_z04_88
02:0003A218 760B            	  4791:     moveq   #11,D3
                            	  4792: _anon_z04_88:
02:0003A21A 1943000A        	  4793:     move.b  D3,($000A,A4)
                            	  4794:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  4795:     ;
02:0003A21E 7005            	  4796:     moveq   #5,D0
02:0003A220 1940000B        	  4797:     move.b  D0,($000B,A4)
                            	  4798:     even
                            	  4799: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A224 7600            	  4800:     moveq   #0,D3
02:0003A226 162C000B        	  4801:     move.b  ($000B,A4),D3
                            	  4802:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  4803:     ; Store it in [00].
                            	  4804:     ;
02:0003A22A 10342070        	  4805:     move.b  ($70,A4,D2.W),D0
02:0003A22E 023C00EE        	  4806:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A232 41F90003A206    	  4807:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A238 12303000        	  4808:     move.b  (A0,D3.W),D1
02:0003A23C D101            	  4809:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A23E 1880            	  4810:     move.b  D0,($0000,A4)
                            	  4811:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  4812:     ; Store it in [01].
                            	  4813:     ;
02:0003A240 41EC0084        	  4814:     lea     ($0084,A4),A0
02:0003A244 10302000        	  4815:     move.b  (A0,D2.W),D0
02:0003A248 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A24C 41F90003A200    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A252 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A256 D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A258 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A25C 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A260 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A264 02000003        	  4832:     andi.b #$03,D0
02:0003A268 0A000003        	  4833:     eori.b #$03,D0
02:0003A26C 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A270 7600            	  4835:     moveq   #0,D3
02:0003A272 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A276 41F90003A1F4    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A27C 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A280 12390003A1F4    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A286 B001            	  4843:     cmp.b   D1,D0
02:0003A288 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
                            	  4846:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4847:     ;
                            	  4848:     ; $CC/CD shows the closed mouth face.
                            	  4849:     ; $C0/C1 shows the open mouth face.
                            	  4850:     ;
02:0003A28A 7600            	  4851:     moveq   #0,D3
02:0003A28C 16342028        	  4852:     move.b  ($28,A4,D2.W),D3
02:0003A290 0C030020        	  4853:     cmpi.b  #$20,D3
02:0003A294 6404            	  4854:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A296 103C00C0        	  4855:     move.b  #$C0,D0
                            	  4856:     even
                            	  4857: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003A29A 610E            	  4858:     jsr     WriteBossSprite
                            	  4859:     ; Bottom of the loop.
                            	  4860:     ; Decrement tile index and loop index.
                            	  4861:     ;
02:0003A29C 532C000A        	  4862:     subq.b  #1,($000A,A4)
02:0003A2A0 532C000B        	  4863:     subq.b  #1,($000B,A4)
02:0003A2A4 6A00FF7E        	  4864:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A2A8 4E75            	  4865:     rts
                            	  4866: 
                            	  4867: ; Params:
                            	  4868: ; A: tile
                            	  4869: ; [00]: X
                            	  4870: ; [01]: Y
                            	  4871: ; [03]: sprite attributes
                            	  4872: ;
                            	  4873: ; Save the tile
                            	  4874:     even
                            	  4875: WriteBossSprite:
02:0003A2AA 1B00            	  4876:     move.b  D0,-(A5)  ; PHA
02:0003A2AC 7600            	  4877:     moveq   #0,D3
02:0003A2AE 162C0341        	  4878:     move.b  ($0341,A4),D3
02:0003A2B2 41F900030DB8    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A2B8 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A2BC 7600            	  4881:     moveq   #0,D3
02:0003A2BE 1600            	  4882:     move.b  D0,D3
02:0003A2C0 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A2C2 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A2C6 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A2CA 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A2CC 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A2D0 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A2D4 102C0001        	  4889:     move.b  ($0001,A4),D0
02:0003A2D8 4EF900031136    	  4890:     jmp     Anim_EndWriteSprite
