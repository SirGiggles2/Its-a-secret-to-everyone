                            	  5422: CheckState30:
                            	  5423:     ; If major state <> $30, go check other states.
                            	  5424:     ;
02:0004875E 0C000030        	  5425:     cmpi.b  #$30,D0
02:00048762 6656            	  5426:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5427:     ; State $3x. Slow down.
                            	  5428:     ;
                            	  5429:     ; Reset grid offset for movement.
                            	  5430:     ;
02:00048764 7000            	  5431:     moveq   #0,D0
02:00048766 41EC0394        	  5432:     lea     ($0394,A4),A0
02:0004876A 11802000        	  5433:     move.b  D0,(A0,D2.W)
                            	  5434:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5435:     ;
02:0004876E 7040            	  5436:     moveq   #64,D0
02:00048770 41EC03BC        	  5437:     lea     ($03BC,A4),A0
02:00048774 11802000        	  5438:     move.b  D0,(A0,D2.W)
                            	  5439:     ; If facing left and X < 2, then go change state to $40. The
                            	  5440:     ; boomerang is too close to the left edge of the screen.
                            	  5441:     ; Another move might make it wrap around.
                            	  5442:     ;
02:00048778 41EC0098        	  5443:     lea     ($0098,A4),A0
02:0004877C 10302000        	  5444:     move.b  (A0,D2.W),D0
02:00048780 1940000F        	  5445:     move.b  D0,($000F,A4)
02:00048784 02000002        	  5446:     andi.b #$02,D0
