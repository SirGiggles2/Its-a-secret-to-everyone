                            	  8384: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8385:     ; Draw the four clouds at diagonal corners.
                            	  8386:     ;
02:0003BCC2 610000B6        	  8387:     jsr     Ganon_GetCurCloudLeft
02:0003BCC6 610000BE        	  8388:     jsr     Ganon_GetCurCloudTop
02:0003BCCA 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0003BCCC 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BCD0 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BCD2 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0003BCD6 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
02:0003BCDA 6190            	  8394:     jsr     Ganon_DrawCloud
