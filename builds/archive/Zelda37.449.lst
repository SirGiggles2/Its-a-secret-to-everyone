                            	  7328: __far_z_04_0079:
                            	  7329:     ; The animation timer has expired. There are two choices for arming it.
                            	  7330:     ;
                            	  7331:     ; When writhing after a hit, Gleeok animates faster.
                            	  7332:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  7333:     ; Otherwise, set a longer time ($10).
                            	  7334:     ;
02:0003B52C 7010            	  7335:     moveq   #16,D0
02:0003B52E 7600            	  7336:     moveq   #0,D3
02:0003B530 162C0510        	  7337:     move.b  ($0510,A4),D3
02:0003B534 6706            	  7338:     beq  _anon_z04_144
02:0003B536 532C0510        	  7339:     subq.b  #1,($0510,A4)
02:0003B53A 7006            	  7340:     moveq   #6,D0
