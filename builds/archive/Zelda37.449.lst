02:0003BBCE 610003DA        	  8256:     jsr     PlayBossDeathCry
02:0003BBD2 7002            	  8257:     moveq   #2,D0
02:0003BBD4 19400600        	  8258:     move.b  D0,($0600,A4)
                            	  8259:     even
                            	  8260: _L_z04_Ganon_Dying_HandleAshes:
02:0003BBD8 610003B6        	  8261:     jsr     Ganon_DrawAshes
