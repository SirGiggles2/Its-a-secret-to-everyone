02:0003E6A4 41F90003E62A    	  3915:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E6AA 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003E6AE B001            	  3917:     cmp.b   D1,D0
02:0003E6B0 640E            	  3918:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0003E6B2 102C0053        	  3919:     move.b  ($0053,A4),D0
02:0003E6B6 122C0098        	  3920:     move.b  ($0098,A4),D1
