                            	  4805:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4806:     ;   high bit set (magic)   => $23
                            	  4807:     ;   high bit clear (sword) => $22
                            	  4808:     ;
02:00048348 41EC00AC        	  4809:     lea     ($00AC,A4),A0
02:0004834C 10302000        	  4810:     move.b  (A0,D2.W),D0
02:00048350 E308            	  4811:     lsl.b  #1,D0   ; ASL A
02:00048352 6402            	  4812:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
