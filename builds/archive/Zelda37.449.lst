                            	  4686: Aquamentus_Shoot:
                            	  4687:     ; If the object timer <> 0, then
                            	  4688:     ; go modify fireballs that might still be flying.
                            	  4689:     ;
02:0003A172 10342028        	  4690:     move.b  ($28,A4,D2.W),D0
02:0003A176 6634            	  4691:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  4692:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  4693:     ;
                            	  4694:     ; Set the timer to a random time, at least $70 frames.
                            	  4695:     ;
02:0003A178 10342018        	  4696:     move.b  ($18,A4,D2.W),D0
02:0003A17C 00000070        	  4697:     ori.b #$70,D0
02:0003A180 19802028        	  4698:     move.b  D0,($28,A4,D2.W)
                            	  4699:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  4700:     ;
02:0003A184 6168            	  4701:     jsr     ShootFireball55
02:0003A186 7000            	  4702:     moveq   #0,D0
02:0003A188 41EC0478        	  4703:     lea     ($0478,A4),A0
02:0003A18C 11803000        	  4704:     move.b  D0,(A0,D3.W)
                            	  4705:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  4706:     ;
02:0003A190 615C            	  4707:     jsr     ShootFireball55
02:0003A192 7001            	  4708:     moveq   #1,D0
02:0003A194 41EC0478        	  4709:     lea     ($0478,A4),A0
02:0003A198 11803000        	  4710:     move.b  D0,(A0,D3.W)
                            	  4711:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  4712:     ;
02:0003A19C 6150            	  4713:     jsr     ShootFireball55
02:0003A19E 103C00FF        	  4714:     move.b  #$FF,D0
02:0003A1A2 41EC0478        	  4715:     lea     ($0478,A4),A0
02:0003A1A6 11803000        	  4716:     move.b  D0,(A0,D3.W)
02:0003A1AA 4E75            	  4717:     rts
