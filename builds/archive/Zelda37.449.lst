                            	  6676: 
                            	  6677: ; Params:
                            	  6678: ; A: eye frame image
                            	  6679: ;
                            	  6680: ; Draw the eye with the frame image passed in.
                            	  6681: ;
                            	  6682:     even
                            	  6683: Gohma_AnimateAndDraw:
02:0003B056 1B00            	  6684:     move.b  D0,-(A5)  ; PHA
02:0003B058 4EB90004906C    	  6685:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B05E 6164            	  6686:     jsr     Gohma_SetSpriteAttributes
02:0003B060 101D            	  6687:     move.b  (A5)+,D0  ; PLA
02:0003B062 4EB900030DEC    	  6688:     jsr     DrawObjectMirrored
02:0003B068 7010            	  6689:     moveq   #16,D0
02:0003B06A 4EB900049066    	  6690:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  6691:     ; Draw the right legs.
                            	  6692:     ;
02:0003B070 7601            	  6693:     moveq   #1,D3
02:0003B072 6102            	  6694:     jsr     Gohma_DrawLegsOneSide
                            	  6695:     ; Draw the left legs.
                            	  6696:     ;
02:0003B074 7600            	  6697:     moveq   #0,D3
                            	  6698: ; Params:
                            	  6699: ; Y: side: 0 for left, 1 for right
                            	  6700: ;
                            	  6701: ; Add the horizontal offset for the current side to Gohma's X to
                            	  6702: ; store the sprite's X in [00].
                            	  6703: ;
                            	  6704:     even
                            	  6705: Gohma_DrawLegsOneSide:
02:0003B076 10342070        	  6706:     move.b  ($70,A4,D2.W),D0
02:0003B07A 023C00EE        	  6707:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B07E 41F90003B054    	  6708:     lea     (GohmaLegOffsetsX).l,A0
02:0003B084 12303000        	  6709:     move.b  (A0,D3.W),D1
02:0003B088 D101            	  6710:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B08A 1880            	  6711:     move.b  D0,($0000,A4)
                            	  6712:     ; The object's Y is the sprite's.
                            	  6713:     ;
02:0003B08C 41EC0084        	  6714:     lea     ($0084,A4),A0
02:0003B090 10302000        	  6715:     move.b  (A0,D2.W),D0
02:0003B094 19400001        	  6716:     move.b  D0,($0001,A4)
02:0003B098 612A            	  6717:     jsr     Gohma_SetSpriteAttributes
                            	  6718:     ; There are only two frame images for legs: left and right.
                            	  6719:     ; There are two animation frames. They are animated as follows:
                            	  6720:     ;
                            	  6721:     ; Frame 0:
                            	  6722:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6723:     ; horizontal flipping = frame number = 0
                            	  6724:     ; 
                            	  6725:     ; Frame 1:
                            	  6726:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6727:     ; horizontal flipping = frame number = 1
                            	  6728:     ;
02:0003B09A 4EB90004903E    	  6729:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B0A0 1003            	  6730:     move.b  D3,D0
02:0003B0A2 023C00EE        	  6731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0A6 41EC03E4        	  6732:     lea     ($03E4,A4),A0
02:0003B0AA 12302000        	  6733:     move.b  (A0,D2.W),D1
02:0003B0AE D101            	  6734:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0B0 02000001        	  6735:     andi.b #$01,D0
02:0003B0B4 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0B8 123C0004        	  6737:     move.b  #$04,D1
02:0003B0BC D101            	  6738:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B0BE 4EF900030DF0    	  6739:     jmp     DrawObjectNotMirrored
                            	  6740: 
                            	  6741: ; Returns:
                            	  6742: ; [04]: left side sprite attributes
                            	  6743: ; [05]: right side sprite attributes
                            	  6744: ;
                            	  6745:     even
