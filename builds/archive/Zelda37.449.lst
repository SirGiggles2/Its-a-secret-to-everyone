                            	  7980: UpdateGanon:
02:0003BA26 102C0445        	  7981:     move.b  ($0445,A4),D0
02:0003BA2A 4EB90002AECA    	  7982:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7983:     even
                            	  7984: UpdateGanon_JumpTable:
02:0003BA30 0003BA3C        	  7985:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA34 0003BA9E        	  7986:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA38 0003BACC        	  7987:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BA3C 701B            	  7996:     moveq   #27,D0
02:0003BA3E 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BA42 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0003BA46 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0003BA48 1002            	  8005:     move.b  D2,D0
02:0003BA4A 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0003BA4C 610007F0        	  8007:     jsr     UpdateCandle
02:0003BA50 101D            	  8008:     move.b  (A5)+,D0  ; PLA
02:0003BA52 7400            	  8009:     moveq   #0,D2
02:0003BA54 1400            	  8010:     move.b  D0,D2
                            	  8011:     ; Turn off the room brightening flag, because we're controlling it
                            	  8012:     ; here instead of in the Mode 5 object update loop.
                            	  8013:     ;
02:0003BA56 7000            	  8014:     moveq   #0,D0
02:0003BA58 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
                            	  8017:     ; Triforce/Ganon song.
                            	  8018:     ;
02:0003BA5C 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0003BA60 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0003BA64 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BA66 7002            	  8022:     moveq   #2,D0
02:0003BA68 19400600        	  8023:     move.b  D0,($0600,A4)
                            	  8024:     even
                            	  8025: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8026:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8027:     ;
02:0003BA6C 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0003BA70 0200000F        	  8029:     andi.b #$0F,D0
02:0003BA74 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003BA78 6702            	  8031:     beq.s  __far_z_04_0087
02:0003BA7A 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
                            	  8034:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8035:     ;
02:0003BA7C 103C00C0        	  8036:     move.b  #$C0,D0
02:0003BA80 19400028        	  8037:     move.b  D0,($0028,A4)
                            	  8038:     ; Set scene phase 1, and go draw Ganon.
                            	  8039:     ;
02:0003BA84 522C0445        	  8040:     addq.b  #1,($0445,A4)
02:0003BA88 6702            	  8041:     beq.s  __far_z_04_0088
02:0003BA8A 6032            	  8042:     jmp  Ganon_DrawBodyFrame0
                            	  8043: __far_z_04_0088:
                            	  8044:     even
                            	  8045: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8046:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8047:     ; In this case, I think it means Ganon is shouting.
                            	  8048:     ;
02:0003BA8C 0C000001        	  8049:     cmpi.b  #$01,D0
