                            	   367: _L_z04_Exit_TurnIfTime:
                            	   368:     ; Reset "wants to shoot" flag.
                            	   369:     ;
02:000382BE 7000            	   370:     moveq   #0,D0
02:000382C0 41EC0412        	   371:     lea     ($0412,A4),A0
02:000382C4 11802000        	   372:     move.b  D0,(A0,D2.W)
                            	   373:     ; If turn timer <> 0, then go set input direction to facing direction.
                            	   374:     ;
02:000382C8 41EC0478        	   375:     lea     ($0478,A4),A0
02:000382CC 10302000        	   376:     move.b  (A0,D2.W),D0
02:000382D0 6612            	   377:     bne  _L_z04_Exit_SetInputDir
                            	   378:     ; Turn toward the chase target in a direction perpendicular to
                            	   379:     ; facing direction.
                            	   380:     ;
                            	   381:     ; If facing vertically, then go choose a horizontal direction
                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:000382D2 41EC0098        	   386:     lea     ($0098,A4),A0
02:000382D6 10302000        	   387:     move.b  (A0,D2.W),D0
02:000382DA 0200000C        	   388:     andi.b #$0C,D0
02:000382DE 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
02:000382E0 6700FF68        	   390:     beq  _L_z04_Exit_TurnVertically
