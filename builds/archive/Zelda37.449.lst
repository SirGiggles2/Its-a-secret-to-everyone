02:0003C9DE 0A3C0010        	   526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C9E2 194000E2        	   527:     move.b  D0,($00E2,A4)
02:0003C9E6 6404            	   528:     bcc  _anon_z05_10
02:0003C9E8 532C0058        	   529:     subq.b  #1,($0058,A4)
                            	   530: _anon_z05_10:
