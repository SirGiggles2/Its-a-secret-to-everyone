02:0003BF52 41EC0302        	  8727:     lea     ($0302,A4),A0
02:0003BF56 11802000        	  8728:     move.b  D0,(A0,D2.W)
02:0003BF5A 5202            	  8729:     addq.b  #1,D2
02:0003BF5C 5203            	  8730:     addq.b  #1,D3
02:0003BF5E 0C030008        	  8731:     cmpi.b  #$08,D3
