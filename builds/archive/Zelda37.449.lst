                            	  4986:     ; Decrease the base negative offset to get farther away from
                            	  4987:     ; the center point.
                            	  4988:     ;
02:00048476 41EC0098        	  4989:     lea     ($0098,A4),A0
02:0004847A 53302000        	  4990:     subq.b  #1,(A0,D2.W)
                            	  4991:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4992:     ;
                            	  4993:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  4994:     ;
02:0004847E 41EC0098        	  4995:     lea     ($0098,A4),A0
02:00048482 10302000        	  4996:     move.b  (A0,D2.W),D0
02:00048486 0C0000E8        	  4997:     cmpi.b  #$E8,D0
02:0004848A 6702            	  4998:     beq.s  __far_z_07_0071
02:0004848C 6004            	  4999:     jmp  L1F49F_Exit
