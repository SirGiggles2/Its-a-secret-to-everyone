                            	  4264:     ; If grid offset <> 0, return.
                            	  4265:     ;
02:00047F84 102C0394        	  4266:     move.b  ($0394,A4),D0
02:00047F88 6702            	  4267:     beq.s  __far_z_07_0059
02:00047F8A 600C            	  4268:     jmp  ExitX0
