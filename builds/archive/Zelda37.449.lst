02:0003B548 123C0001        	  7347:     move.b  #$01,D1
02:0003B54C D101            	  7348:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003B54E 02000003        	  7349:     andi.b #$03,D0
02:0003B552 194004E7        	  7350:     move.b  D0,($04E7,A4)
                            	  7351:     even
