02:00048326 0C030002        	  4787:     cmpi.b  #$02,D3
02:0004832A 6604            	  4788:     bne  _anon_z07_24
02:0004832C 522C000F        	  4789:     addq.b  #1,($000F,A4)
                            	  4790: _anon_z07_24:
                            	  4791:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4792:     ;   $57 (sword shot) => $22
                            	  4793:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4794:     ;
02:00048330 7622            	  4795:     moveq   #34,D3
02:00048332 0C02000D        	  4796:     cmpi.b  #$0D,D2
02:00048336 6410            	  4797:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:00048338 41EC034F        	  4798:     lea     ($034F,A4),A0
02:0004833C 10302000        	  4799:     move.b  (A0,D2.W),D0
02:00048340 0C000057        	  4800:     cmpi.b  #$57,D0
02:00048344 6710            	  4801:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:00048346 660C            	  4802:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4803:     even
