02:00040976 7400            	  6962:     moveq   #0,D2
02:00040978 1400            	  6963:     move.b  D0,D2
                            	  6964:     ; Align the object's Y coordinate with 16 pixels.
                            	  6965:     ;
02:0004097A 41EC0084        	  6966:     lea     ($0084,A4),A0
02:0004097E 10302000        	  6967:     move.b  (A0,D2.W),D0
02:00040982 020000F0        	  6968:     andi.b #$F0,D0
                            	  6969:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  6970:     ; the height of each row.
                            	  6971:     ;
02:00040986 003C0011        	  6972:     ori     #$11,CCR  ; SEC: set C+X
02:0004098A 123C0040        	  6973:     move.b  #$40,D1
02:0004098E 0A3C0010        	  6974:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040992 9101            	  6975:     subx.b  D1,D0   ; SBC #$40
02:00040994 0A3C0010        	  6976:     eori    #$10,CCR  ; restore X = 6502 C
02:00040998 E208            	  6977:     lsr.b  #1,D0   ; LSR A
02:0004099A E208            	  6978:     lsr.b  #1,D0   ; LSR A
02:0004099C E208            	  6979:     lsr.b  #1,D0   ; LSR A
                            	  6980:     ; Add this row offset to the column address.
                            	  6981:     ;
02:0004099E 4EB900030AA4    	  6982:     jsr     AddToInt16At0
                            	  6983:     ; Assume that we'll write a type 1 square with primary square
                            	  6984:     ; taken from [05]. If so, the square index doesn't matter
                            	  6985:     ; as long as >= $10. See WriteSquareOW.
                            	  6986:     ;
02:000409A4 7600            	  6987:     moveq   #0,D3
02:000409A6 7410            	  6988:     moveq   #16,D2
02:000409A8 102C0005        	  6989:     move.b  ($0005,A4),D0
                            	  6990:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  6991:     ; So, we have to look up the square index corresponding
                            	  6992:     ; to primary square/tile in [05].
                            	  6993:     ;
                            	  6994:     ; Look in primary square table from $E to 1. If a match is found,
                            	  6995:     ; then the X register will have the square index value.
                            	  6996:     ;
02:000409AC 0C000027        	  6997:     cmpi.b  #$27,D0
02:000409B0 6506            	  6998:     bcs  _anon_z05_148
02:000409B2 0C0000F3        	  6999:     cmpi.b  #$F3,D0
02:000409B6 6514            	  7000:     bcs  _L_z05_ChangePlayMapSquareOW_Write
                            	  7001: _anon_z05_148:
02:000409B8 740E            	  7002:     moveq   #14,D2
                            	  7003: _anon_z05_149:
02:000409BA 41F900040376    	  7004:     lea     (PrimarySquaresOW).l,A0
02:000409C0 12302000        	  7005:     move.b  (A0,D2.W),D1
02:000409C4 B001            	  7006:     cmp.b   D1,D0
02:000409C6 6704            	  7007:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:000409C8 5302            	  7008:     subq.b  #1,D2
02:000409CA 66EE            	  7009:     bne  _anon_z05_149
                            	  7010:     even
                            	  7011: _L_z05_ChangePlayMapSquareOW_Write:
                            	  7012:     ; Write the square.
                            	  7013:     ;
02:000409CC 1942000D        	  7014:     move.b  D2,($000D,A4)
02:000409D0 6100FCDA        	  7015:     jsr     WriteSquareOW
02:000409D4 101D            	  7016:     move.b  (A5)+,D0  ; PLA
02:000409D6 7400            	  7017:     moveq   #0,D2
02:000409D8 1400            	  7018:     move.b  D0,D2
02:000409DA 4E75            	  7019:     rts
                            	  7020: 
