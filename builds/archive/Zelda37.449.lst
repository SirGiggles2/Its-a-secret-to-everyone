                            	  7155:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7156:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7157:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7158:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7159:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7160:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7161:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7162:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7163:     ; corrupting them and causing a deterministic address-error
                            	  7164:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7165:     ; identified by Codex static review.)
                            	  7166: _L_z07_P47_pre_check:
02:000494AE 102C0525        	  7167:     move.b  ($0525,A4),D0
02:000494B2 020000F0        	  7168:     andi.b  #$F0,D0
02:000494B6 0C000040        	  7169:     cmpi.b  #$40,D0
02:000494BA 6506            	  7170:     blo     _L_z07_P47_pre_snap
02:000494BC 0C0000E0        	  7171:     cmpi.b  #$E0,D0
02:000494C0 6506            	  7172:     blo     _L_z07_P47_pre_ok
                            	  7173: _L_z07_P47_pre_snap:
02:000494C2 197C00480525    	  7174:     move.b  #$48,($0525,A4)
                            	  7175: _L_z07_P47_pre_ok:
02:000494C8 7005            	  7176:     moveq   #5,D0
02:000494CA 610004F4        	  7177:     jsr     SwitchBank
02:000494CE 4EB90003E3FE    	  7178:     jsr     FindNextEdgeSpawnCell
                            	  7179:     ; Post-walk 1: bottom-edge snap.
02:000494D4 102C0525        	  7180:     move.b  ($0525,A4),D0
02:000494D8 020000F0        	  7181:     andi.b  #$F0,D0
02:000494DC 0C0000E0        	  7182:     cmpi.b  #$E0,D0
02:000494E0 660C            	  7183:     bne     _L_z07_P47_post1_ok
02:000494E2 197C00480525    	  7184:     move.b  #$48,($0525,A4)
02:000494E8 4EB90003E3FE    	  7185:     jsr     FindNextEdgeSpawnCell
                            	  7186: _L_z07_P47_post1_ok:
                            	  7187:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7188:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:000494EE 7600            	  7189:     moveq   #0,D3
02:000494F0 162C0525        	  7190:     move.b  ($0525,A4),D3
02:000494F4 0243000F        	  7191:     andi.w  #$000F,D3
02:000494F8 C6FC002C        	  7192:     mulu.w  #44,D3
02:000494FC 203C00FF6530    	  7193:     move.l  #$FF6530,D0
02:00049502 D083            	  7194:     add.l   D3,D0
02:00049504 7600            	  7195:     moveq   #0,D3
02:00049506 162C0525        	  7196:     move.b  ($0525,A4),D3
02:0004950A E84B            	  7197:     lsr.w   #4,D3
02:0004950C 5943            	  7198:     subi.w  #4,D3
02:0004950E E34B            	  7199:     lsl.w   #1,D3
02:00049510 D083            	  7200:     add.l   D3,D0
02:00049512 2040            	  7201:     movea.l D0,A0
02:00049514 1010            	  7202:     move.b  (A0),D0
02:00049516 0C000084        	  7203:     cmpi.b  #$84,D0
02:0004951A 6544            	  7204:     blo     _L_z07_P47_post2_ok
                            	  7205:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7206:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7207:     ; writes to the $05xx region.
02:0004951C 7800            	  7208:     moveq   #0,D4
                            	  7209: _L_z07_P47_fb_loop:
02:0004951E 41FAE582        	  7210:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049522 12304000        	  7211:     move.b  (A0,D4.W),D1
02:00049526 19410525        	  7212:     move.b  D1,($0525,A4)
                            	  7213:     ; Validate fallback cell walkable.
02:0004952A 7600            	  7214:     moveq   #0,D3
02:0004952C 1601            	  7215:     move.b  D1,D3
02:0004952E 0243000F        	  7216:     andi.w  #$000F,D3
02:00049532 C6FC002C        	  7217:     mulu.w  #44,D3
02:00049536 203C00FF6530    	  7218:     move.l  #$FF6530,D0
02:0004953C D083            	  7219:     add.l   D3,D0
02:0004953E 7600            	  7220:     moveq   #0,D3
02:00049540 1601            	  7221:     move.b  D1,D3
02:00049542 E84B            	  7222:     lsr.w   #4,D3
02:00049544 5943            	  7223:     subi.w  #4,D3
02:00049546 E34B            	  7224:     lsl.w   #1,D3
02:00049548 D083            	  7225:     add.l   D3,D0
02:0004954A 2040            	  7226:     movea.l D0,A0
02:0004954C 0C100084        	  7227:     cmpi.b  #$84,(A0)
02:00049550 650E            	  7228:     blo     _L_z07_P47_post2_ok
02:00049552 5204            	  7229:     addq.b  #1,D4
02:00049554 0C040008        	  7230:     cmpi.b  #8,D4
02:00049558 65C4            	  7231:     blo     _L_z07_P47_fb_loop
                            	  7232:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7233:     ; rather than looping).
02:0004955A 197C00480525    	  7234:     move.b  #$48,($0525,A4)
                            	  7235: _L_z07_P47_post2_ok:
                            	  7236:     ; Extract and set the monster's location.
                            	  7237:     ;
02:00049560 102C0525        	  7238:     move.b  ($0525,A4),D0
                            	  7239:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7240:     ;
02:00049564 1B00            	  7241:     move.b  D0,-(A5)  ; PHA
02:00049566 E308            	  7242:     lsl.b  #1,D0   ; ASL A
02:00049568 E308            	  7243:     lsl.b  #1,D0   ; ASL A
02:0004956A E308            	  7244:     lsl.b  #1,D0   ; ASL A
02:0004956C E308            	  7245:     lsl.b  #1,D0   ; ASL A
02:0004956E 19802070        	  7246:     move.b  D0,($70,A4,D2.W)
                            	  7247:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7248:     ;
02:00049572 101D            	  7249:     move.b  (A5)+,D0  ; PLA
02:00049574 020000F0        	  7250:     andi.b #$F0,D0
02:00049578 003C0011        	  7251:     ori     #$11,CCR  ; SEC: set C+X
02:0004957C 123C0003        	  7252:     move.b  #$03,D1
02:00049580 0A3C0010        	  7253:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049584 9101            	  7254:     subx.b  D1,D0   ; SBC #$03
02:00049586 0A3C0010        	  7255:     eori    #$10,CCR  ; restore X = 6502 C
02:0004958A 41EC0084        	  7256:     lea     ($0084,A4),A0
02:0004958E 11802000        	  7257:     move.b  D0,(A0,D2.W)
                            	  7258:     ; Set the monsters-from-edges long timer to a random value
                            	  7259:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7260:     ;
02:00049592 10342019        	  7261:     move.b  ($19,A4,D2.W),D0
02:00049596 02000003        	  7262:     andi.b #$03,D0
02:0004959A 023C00EE        	  7263:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004959E 123C0002        	  7264:     move.b  #$02,D1
02:000495A2 D101            	  7265:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000495A4 1940004B        	  7266:     move.b  D0,($004B,A4)
                            	  7267:     ; If the distance to Link is too close to Link, then
                            	  7268:     ; go flag the monster uninitialized again, so we can
                            	  7269:     ; try to spawn it again next time.
                            	  7270:     ;
02:000495A8 7005            	  7271:     moveq   #5,D0
02:000495AA 61000414        	  7272:     jsr     SwitchBank
02:000495AE 4EB90003DA12    	  7273:     jsr     IsDistanceSafeToSpawn
02:000495B4 6500FEB4        	  7274:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7275:     ; OK to spawn.
                            	  7276:     ; In this situation, monsters don't spawn from a cloud.
                            	  7277:     ;
02:000495B8 7000            	  7278:     moveq   #0,D0
02:000495BA 41EC0405        	  7279:     lea     ($0405,A4),A0
02:000495BE 11802000        	  7280:     move.b  D0,(A0,D2.W)
                            	  7281:     even
                            	  7282: _L_z07_InitObject_NormalSpawn:
02:000495C2 7004            	  7283:     moveq   #4,D0
02:000495C4 610003FA        	  7284:     jsr     SwitchBank
                            	  7285:     ; For monsters that spawn in a cloud, set their start time to
                            	  7286:     ; the same value as the object slot; so that they all start
                            	  7287:     ; moving at different times.
                            	  7288:     ;
02:000495C8 7400            	  7289:     moveq   #0,D2
02:000495CA 142C0340        	  7290:     move.b  ($0340,A4),D2
02:000495CE 7600            	  7291:     moveq   #0,D3
02:000495D0 41EC034F        	  7292:     lea     ($034F,A4),A0
02:000495D4 16302000        	  7293:     move.b  (A0,D2.W),D3
