02:00038B0C 10302000        	  1595:     move.b  (A0,D2.W),D0
02:00038B10 023C00EE        	  1596:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B14 123C0001        	  1597:     move.b  #$01,D1
02:00038B18 D101            	  1598:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038B1A 0C000006        	  1599:     cmpi.b  #$06,D0
