02:00039E20 11802000        	  4276:     move.b  D0,(A0,D2.W)
02:00039E24 101D            	  4277:     move.b  (A5)+,D0  ; PLA
02:00039E26 41EC046B        	  4278:     lea     ($046B,A4),A0
