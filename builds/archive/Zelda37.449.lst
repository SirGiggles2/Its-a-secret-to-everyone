                            	  7118: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7119:     ; If the "monsters from edges" long timer expired, then
                            	  7120:     ; go bring the monster in.
                            	  7121:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7122:     ;
                            	  7123:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7124:     ; residual position so enemies keep their previous-room
                            	  7125:     ; positions instead of being re-edge-spawned (matches NES).
