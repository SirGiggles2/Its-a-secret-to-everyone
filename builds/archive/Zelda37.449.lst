02:000488A0 6100F548        	  5604:     jsr     MoveObject
                            	  5605:     even
                            	  5606: AnimateBoomerangAndCheckCollision:
                            	  5607:     ; Decrement animation counter; and when it reaches 0:
                            	  5608:     ; 1. arm it again for 2 frames
                            	  5609:     ; 2. advance the minor state within a cycle of 8
                            	  5610:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5611:     ;
02:000488A4 41EC03D0        	  5612:     lea     ($03D0,A4),A0
