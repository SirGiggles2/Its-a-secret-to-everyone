                            	  6777: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6778:     ; To animate the state, the animation counter had to have
                            	  6779:     ; reached 0. Right after this routine, the counter will be
                            	  6780:     ; rolled over, and the movement frame will be switched.
                            	  6781:     ;
                            	  6782:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6783:     ; the animation here, in order to immediately change it to
                            	  6784:     ; 0 (legs apart) after this.
                            	  6785:     ;
02:000490B4 7001            	  6786:     moveq   #1,D0
02:000490B6 194003E4        	  6787:     move.b  D0,($03E4,A4)
02:000490BA 4E75            	  6788:     rts
                            	  6789: 
