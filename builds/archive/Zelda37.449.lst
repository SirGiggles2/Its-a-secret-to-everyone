                            	  1735: UpdateRedLeever:
02:00038C2E 41EC00AC        	  1736:     lea     ($00AC,A4),A0
02:00038C32 10302000        	  1737:     move.b  (A0,D2.W),D0
02:00038C36 6704            	  1738:     beq  _anon_z04_42
