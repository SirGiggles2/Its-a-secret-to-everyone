02:0002F30C 7600            	   444:     moveq   #0,D3
02:0002F30E 41EC046C        	   445:     lea     ($046C,A4),A0
02:0002F312 16302000        	   446:     move.b  (A0,D2.W),D3
02:0002F316 41EC046F        	   447:     lea     ($046F,A4),A0
02:0002F31A 10303000        	   448:     move.b  (A0,D3.W),D0
02:0002F31E 41EC0448        	   449:     lea     ($0448,A4),A0
02:0002F322 11802000        	   450:     move.b  D0,(A0,D2.W)
02:0002F326 5302            	   451:     subq.b  #1,D2
02:0002F328 6AE2            	   452:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   453:     even
