                            	  2104: ;
                            	  2105: ; Note:
                            	  2106: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2107: ; But Link uses [0F] for flipping without checking [0C].
                            	  2108: ;
                            	  2109: ;
                            	  2110: ; [0D] holds frame.
