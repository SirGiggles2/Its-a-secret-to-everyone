02:00047270 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:00047274 41EC030B        	  2372:     lea     ($030B,A4),A0
02:00047278 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004727C 41EC0306        	  2374:     lea     ($0306,A4),A0
02:00047280 52302000        	  2375:     addq.b  #1,(A0,D2.W)
