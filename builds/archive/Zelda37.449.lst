                            	  7036:     ; Metastate = $14
                            	  7037:     ;
                            	  7038:     ; Copy the object type, so that it can be used in setting up
                            	  7039:     ; a dropped item.
                            	  7040:     ;
02:000493AA 41EC034F        	  7041:     lea     ($034F,A4),A0
02:000493AE 10302000        	  7042:     move.b  (A0,D2.W),D0
02:000493B2 41EC0412        	  7043:     lea     ($0412,A4),A0
02:000493B6 11802000        	  7044:     move.b  D0,(A0,D2.W)
