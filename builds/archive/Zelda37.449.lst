                            	  2793:     ; The direction is negative (left or up).
                            	  2794:     ;
                            	  2795:     ; If the coordinate does not cross (<) the boundary, then
                            	  2796:     ; go set mask $FF, so that no button is excluded.
                            	  2797:     ;
02:0003DF3C 102C0002        	  2798:     move.b  ($0002,A4),D0
02:0003DF40 41F90003DEB4    	  2799:     lea     (BorderBounds).l,A0
02:0003DF46 12303000        	  2800:     move.b  (A0,D3.W),D1
02:0003DF4A B001            	  2801:     cmp.b   D1,D0
