                            	  8077:     ;
02:0003BAAC 194000AC        	  8078:     move.b  D0,($00AC,A4)
02:0003BAB0 19400505        	  8079:     move.b  D0,($0505,A4)
02:0003BAB4 7020            	  8080:     moveq   #32,D0
02:0003BAB6 19400600        	  8081:     move.b  D0,($0600,A4)
02:0003BABA 522C0445        	  8082:     addq.b  #1,($0445,A4)
                            	  8083:     even
                            	  8084: Ganon_DrawBodyFrame0:
                            	  8085:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8086:     ; with animation frame 0.
                            	  8087:     ;
02:0003BABE 7000            	  8088:     moveq   #0,D0
02:0003BAC0 41EC046B        	  8089:     lea     ($046B,A4),A0
02:0003BAC4 11802000        	  8090:     move.b  D0,(A0,D2.W)
02:0003BAC8 600002EC        	  8091:     jmp     Ganon_DrawBody
                            	  8092: 
                            	  8093: ; Description:
                            	  8094: ; Fighting Ganon.
                            	  8095: ;
                            	  8096: ; If Ganon is dying, go handle it.
                            	  8097: ;
                            	  8098:     even
                            	  8099: Ganon_ScenePhase2:
02:0003BACC 41EC042C        	  8100:     lea     ($042C,A4),A0
02:0003BAD0 10302000        	  8101:     move.b  (A0,D2.W),D0
02:0003BAD4 6704            	  8102:     beq.s  __far_z_04_0090
02:0003BAD6 600000A4        	  8103:     jmp  Ganon_Dying
                            	  8104: __far_z_04_0090:
02:0003BADA 61000356        	  8105:     jsr     Ganon_CheckCollisions
02:0003BADE 6100C6CA        	  8106:     jsr     PlayBossHitCryIfNeeded
                            	  8107:     ; Go handle the brown state specially.
                            	  8108:     ;
02:0003BAE2 41EC00AC        	  8109:     lea     ($00AC,A4),A0
02:0003BAE6 10302000        	  8110:     move.b  (A0,D2.W),D0
02:0003BAEA 6702            	  8111:     beq.s  __far_z_04_0091
02:0003BAEC 6058            	  8112:     jmp  Ganon_UpdateBrownState
                            	  8113: __far_z_04_0091:
                            	  8114:     ; State = 0: Blue
                            	  8115:     ;
                            	  8116:     ; If timer = 0, then go move around and shoot.
                            	  8117:     ;
02:0003BAEE 10342028        	  8118:     move.b  ($28,A4,D2.W),D0
02:0003BAF2 6602            	  8119:     bne.s  __far_z_04_0092
02:0003BAF4 600E            	  8120:     jmp  Ganon_MoveAndShoot
                            	  8121: __far_z_04_0092:
                            	  8122:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8123:     ; Collisions were checked already.
                            	  8124:     ;
                            	  8125:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8126:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8127:     ;
02:0003BAF6 0C000001        	  8128:     cmpi.b  #$01,D0
02:0003BAFA 6702            	  8129:     beq.s  __far_z_04_0093
02:0003BAFC 6078            	  8130:     jmp  L_Ganon_DrawBody
                            	  8131: __far_z_04_0093:
                            	  8132: ; Description:
                            	  8133: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  8134: ;
                            	  8135:     even
                            	  8136: Ganon_RandomizeLocation:
02:0003BAFE 4EF90002BA30    	  8137:     jmp     c_ganon_randomize_location
                            	  8138: 
                            	  8139: Ganon_MoveAndShoot:
                            	  8140:     ; Change the animation frame every screen frame; so that
                            	  8141:     ; when Ganon is hit, he appears in a random pose.
                            	  8142:     ;
