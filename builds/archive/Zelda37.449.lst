02:0003E64E 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003E652 B001            	  3873:     cmp.b   D1,D0
02:0003E654 6622            	  3874:     bne  _anon_z05_95
02:0003E656 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003E65A 41F90003E626    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E660 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003E664 B001            	  3878:     cmp.b   D1,D0
02:0003E666 6510            	  3879:     bcs  _anon_z05_95
02:0003E668 41F90003E62A    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E66E 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E672 B001            	  3882:     cmp.b   D1,D0
02:0003E674 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
02:0003E678 5303            	  3885:     subq.b  #1,D3
