02:00035070 41F900034FF4    	  4658:     lea     (CreditsLastScreenList).l,A0
02:00035076 12303000        	  4659:     move.b  (A0,D3.W),D1
02:0003507A B001            	  4660:     cmp.b   D1,D0
02:0003507C 651C            	  4661:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
