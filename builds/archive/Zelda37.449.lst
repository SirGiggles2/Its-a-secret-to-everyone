                            	  4295: ; Description:
                            	  4296: ; Calculates the next alternate direction to move in while
                            	  4297: ; searching for an unblocked direction.
                            	  4298: ;
                            	  4299: ; Params:
                            	  4300: ; [0E]: the current step
                            	  4301: ;
                            	  4302: ; Returns:
                            	  4303: ; A: a direction for the current step, or 0 at the end of the loop
                            	  4304: ; [0E]: the next step, or 0 to end the loop
