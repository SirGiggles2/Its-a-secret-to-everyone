                            	  1740: 
                            	  1741: _anon_z04_42:
                            	  1742:     ; State 0.
                            	  1743:     ;
                            	  1744:     ; In state we determine whether to burst out of the ground.
                            	  1745:     ; If the long timer has not expired, then return.
                            	  1746:     ;
02:00038C3C 102C004D        	  1747:     move.b  ($004D,A4),D0
02:00038C40 6674            	  1748:     bne  _L_z04_UpdateRedLeever_Exit
                            	  1749:     ; Only allow two red leevers at a time.
                            	  1750:     ;
02:00038C42 102C0510        	  1751:     move.b  ($0510,A4),D0
02:00038C46 0C000002        	  1752:     cmpi.b  #$02,D0
02:00038C4A 646A            	  1753:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1754:     ; Face in the same direction as Link.
                            	  1755:     ;
02:00038C4C 102C0098        	  1756:     move.b  ($0098,A4),D0
02:00038C50 41EC0098        	  1757:     lea     ($0098,A4),A0
02:00038C54 11802000        	  1758:     move.b  D0,(A0,D2.W)
                            	  1759:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  1760:     ;
02:00038C58 10342019        	  1761:     move.b  ($19,A4,D2.W),D0
02:00038C5C 0C0000C0        	  1762:     cmpi.b  #$C0,D0
02:00038C60 6506            	  1763:     bcs  _anon_z04_43
02:00038C62 4EB900047FDC    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
02:00038C68 41EC0098        	  1768:     lea     ($0098,A4),A0
02:00038C6C 10302000        	  1769:     move.b  (A0,D2.W),D0
02:00038C70 0200000C        	  1770:     andi.b #$0C,D0
02:00038C74 6742            	  1771:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  1772:     ; Begin with the leever's X set to Link's X.
                            	  1773:     ;
02:00038C76 102C0070        	  1774:     move.b  ($0070,A4),D0
02:00038C7A 19802070        	  1775:     move.b  D0,($70,A4,D2.W)
                            	  1776:     ; If facing down, then use Y offset $28.
                            	  1777:     ; Else store Y offset -$28 in [00].
                            	  1778:     ;
02:00038C7E 7628            	  1779:     moveq   #40,D3
02:00038C80 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038C84 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038C88 02000008        	  1782:     andi.b #$08,D0
02:00038C8C 6704            	  1783:     beq  _anon_z04_44
02:00038C8E 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038C92 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:00038C94 102C0084        	  1789:     move.b  ($0084,A4),D0
02:00038C98 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038C9C 1214            	  1791:     move.b  ($0000,A4),D1
02:00038C9E D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
                            	  1795:     ;
02:00038CA0 020000F0        	  1796:     andi.b #$F0,D0
02:00038CA4 0000000D        	  1797:     ori.b #$0D,D0
02:00038CA8 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038CAC 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038CB0 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038CB4 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038CB6 4E75            	  1809:     rts
                            	  1810: 
                            	  1811:     even
                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038CB8 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038CBC 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038CC0 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038CC4 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038CC8 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038CCA 7628            	  1826:     moveq   #40,D3
02:00038CCC 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038CD0 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038CD4 02000002        	  1829:     andi.b #$02,D0
02:00038CD8 6704            	  1830:     beq  _anon_z04_45
02:00038CDA 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038CDE 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038CE0 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038CE4 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038CE8 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CEC 1214            	  1841:     move.b  ($0000,A4),D1
02:00038CEE D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038CF0 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038CF4 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038CF8 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038CFC 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038D00 B001            	  1853:     cmp.b   D1,D0
02:00038D02 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038D04 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038D06 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038D0A 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038D0E 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038D10 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038D14 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038D18 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038D1C 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038D20 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D24 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038D26 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038D2A 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038D2E 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  1879:     ;
02:00038D30 4EB900047A90    	  1880:     jsr     GetCollidableTileStill
02:00038D36 122C034A        	  1881:     move.b  ($034A,A4),D1
02:00038D3A B001            	  1882:     cmp.b   D1,D0
02:00038D3C 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038D40 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:00038D44 7001            	  1888:     moveq   #1,D0
02:00038D46 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038D4A 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
02:00038D4E E308            	  1893:     lsl.b  #1,D0   ; ASL A
02:00038D50 1940004D        	  1894:     move.b  D0,($004D,A4)
02:00038D54 6100008C        	  1895:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1896:     ; The leever has to face Link in order to move toward him.
                            	  1897:     ;
02:00038D58 4EB900047FDC    	  1898:     jsr     ReverseObjDir
                            	  1899:     even
                            	  1900: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  1901:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  1902:     ;
02:00038D5E 41EC00AC        	  1903:     lea     ($00AC,A4),A0
02:00038D62 10302000        	  1904:     move.b  (A0,D2.W),D0
02:00038D66 0C000003        	  1905:     cmpi.b  #$03,D0
02:00038D6A 666E            	  1906:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  1907:     ; State 3.
