02:0003BD2A 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0003BD2E 02000003        	  8436:     andi.b #$03,D0
02:0003BD32 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
                            	  8439: _L_z04_Ganon_DrawBurst_Move:
