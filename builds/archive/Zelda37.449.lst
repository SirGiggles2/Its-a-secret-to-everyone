                            	  5454:     ;
02:00048794 6100F654        	  5455:     jsr     MoveObject
                            	  5456:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5457:     ; state to $40.
                            	  5458:     ;
02:00048798 41EC0380        	  5459:     lea     ($0380,A4),A0
