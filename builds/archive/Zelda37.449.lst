02:00047F54 610E            	  4224:     jsr     ResetMovingDir
02:00047F56 194000F8        	  4225:     move.b  D0,($00F8,A4)
02:00047F5A 102C0010        	  4226:     move.b  ($0010,A4),D0
02:00047F5E 6602            	  4227:     bne.s  __far_z_07_0055
02:00047F60 6008            	  4228:     jmp  GoWalkableDir
                            	  4229: __far_z_07_0055:
                            	  4230:     even
                            	  4231: L1F148_Exit:
02:00047F62 4E75            	  4232:     rts
                            	  4233: 
