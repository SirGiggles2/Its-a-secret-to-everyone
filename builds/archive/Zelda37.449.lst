02:0003BBAC 123C0007        	  8246:     move.b  #$07,D1
02:0003BBB0 D101            	  8247:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003BBB2 19802070        	  8248:     move.b  D0,($70,A4,D2.W)
02:0003BBB6 41EC0084        	  8249:     lea     ($0084,A4),A0
02:0003BBBA 10302000        	  8250:     move.b  (A0,D2.W),D0
02:0003BBBE 123C0008        	  8251:     move.b  #$08,D1
02:0003BBC2 D101            	  8252:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBC4 41EC0084        	  8253:     lea     ($0084,A4),A0
02:0003BBC8 11802000        	  8254:     move.b  D0,(A0,D2.W)
