02:0003E6D0 6620            	  3940:     bne  _anon_z05_96
02:0003E6D2 102C0001        	  3941:     move.b  ($0001,A4),D0
02:0003E6D6 41F90003E62E    	  3942:     lea     (DoorwayBoundsMinUnder).l,A0
02:0003E6DC 12303000        	  3943:     move.b  (A0,D3.W),D1
02:0003E6E0 B001            	  3944:     cmp.b   D1,D0
02:0003E6E2 650E            	  3945:     bcs  _anon_z05_96
02:0003E6E4 41F90003E632    	  3946:     lea     (DoorwayBoundsMaxUnder).l,A0
02:0003E6EA 12303000        	  3947:     move.b  (A0,D3.W),D1
02:0003E6EE B001            	  3948:     cmp.b   D1,D0
02:0003E6F0 6506            	  3949:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3950: _anon_z05_96:
