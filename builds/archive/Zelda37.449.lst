                            	  6530: InitGleeok:
02:0003AF14 7010            	  6531:     moveq   #16,D0
02:0003AF16 19400601        	  6532:     move.b  D0,($0601,A4)
                            	  6533:     ; Loop 6 times to initialize each segment of 4 necks.
                            	  6534:     ;
02:0003AF1A 7405            	  6535:     moveq   #5,D2
                            	  6536: _anon_z04_108:
                            	  6537:     ; Set the X of the current segment of each neck to $7C.
                            	  6538:     ;
02:0003AF1C 707C            	  6539:     moveq   #124,D0
02:0003AF1E 41EC0438        	  6540:     lea     ($0438,A4),A0
02:0003AF22 11802000        	  6541:     move.b  D0,(A0,D2.W)
02:0003AF26 41EC0452        	  6542:     lea     ($0452,A4),A0
02:0003AF2A 11802000        	  6543:     move.b  D0,(A0,D2.W)
02:0003AF2E 41EC046C        	  6544:     lea     ($046C,A4),A0
02:0003AF32 11802000        	  6545:     move.b  D0,(A0,D2.W)
02:0003AF36 41EC0395        	  6546:     lea     ($0395,A4),A0
02:0003AF3A 11802000        	  6547:     move.b  D0,(A0,D2.W)
02:0003AF3E 19802071        	  6548:     move.b  D0,($71,A4,D2.W)
                            	  6549:     ; Look up and set the Y of the current segment of each neck.
                            	  6550:     ;
02:0003AF42 41F90003AF0E    	  6551:     lea     (GleeokSegmentYs).l,A0
02:0003AF48 10302000        	  6552:     move.b  (A0,D2.W),D0
02:0003AF4C 41EC0445        	  6553:     lea     ($0445,A4),A0
02:0003AF50 11802000        	  6554:     move.b  D0,(A0,D2.W)
02:0003AF54 41EC045F        	  6555:     lea     ($045F,A4),A0
02:0003AF58 11802000        	  6556:     move.b  D0,(A0,D2.W)
02:0003AF5C 41EC0479        	  6557:     lea     ($0479,A4),A0
02:0003AF60 11802000        	  6558:     move.b  D0,(A0,D2.W)
02:0003AF64 41EC03BD        	  6559:     lea     ($03BD,A4),A0
02:0003AF68 11802000        	  6560:     move.b  D0,(A0,D2.W)
02:0003AF6C 41EC0085        	  6561:     lea     ($0085,A4),A0
02:0003AF70 11802000        	  6562:     move.b  D0,(A0,D2.W)
                            	  6563:     ; Set HP of each neck to $A0.
                            	  6564:     ;
                            	  6565:     ; Because there's only one HP value for each neck,
                            	  6566:     ; it's stored right in the object slot -- unlike coordinates.
                            	  6567:     ;
                            	  6568:     ; Also, note that even though these aren't independent objects
                            	  6569:     ; in the object slots -- because object type = 0 -- the values in
                            	  6570:     ; these object slots will be useful during collision detection.
                            	  6571:     ;
02:0003AF74 103C00A0        	  6572:     move.b  #$A0,D0
02:0003AF78 41EC0486        	  6573:     lea     ($0486,A4),A0
02:0003AF7C 11802000        	  6574:     move.b  D0,(A0,D2.W)
                            	  6575:     ; Reset metastate and unintialized flag, so that this neck is ready to go.
                            	  6576:     ;
02:0003AF80 7000            	  6577:     moveq   #0,D0
02:0003AF82 41EC0406        	  6578:     lea     ($0406,A4),A0
02:0003AF86 11802000        	  6579:     move.b  D0,(A0,D2.W)
02:0003AF8A 41EC0494        	  6580:     lea     ($0494,A4),A0
02:0003AF8E 11802000        	  6581:     move.b  D0,(A0,D2.W)
                            	  6582:     ; Invincible to everything but the sword.
                            	  6583:     ;
02:0003AF92 103C00FE        	  6584:     move.b  #$FE,D0
02:0003AF96 41EC04B3        	  6585:     lea     ($04B3,A4),A0
02:0003AF9A 11802000        	  6586:     move.b  D0,(A0,D2.W)
                            	  6587:     ; Bottom of the loop.
                            	  6588:     ;
02:0003AF9E 5302            	  6589:     subq.b  #1,D2
02:0003AFA0 6A00FF7A        	  6590:     bpl  _anon_z04_108
                            	  6591:     ; Set speed flags to $FF (non-0/decelerate):
                            	  6592:     ; * neck 0 X
                            	  6593:     ; * neck 1 Y
                            	  6594:     ; * neck 2 X
                            	  6595:     ; * neck 3 Y
                            	  6596:     ;
                            	  6597:     ; Leave the other other speed flags 0 (accelerate).
                            	  6598:     ;
02:0003AFA4 13C200000422    	  6599:     move.b  D2,(Gleook_HeadInfo0+GLEEOK_SPEEDX).l
02:0003AFAA 13C200000430    	  6600:     move.b  D2,(Gleook_HeadInfo1+GLEEOK_SPEEDY).l
02:0003AFB0 13C200000383    	  6601:     move.b  D2,(Gleook_HeadInfo2+GLEEOK_SPEEDX).l
02:0003AFB6 13C2000003AC    	  6602:     move.b  D2,(Gleook_HeadInfo3+GLEEOK_SPEEDY).l
                            	  6603:     ; Set the V-direction counter of all necks to 3.
                            	  6604:     ;
02:0003AFBC 7003            	  6605:     moveq   #3,D0
02:0003AFBE 13C000000421    	  6606:     move.b  D0,(Gleook_HeadInfo0+GLEEOK_DIRCOUNTERV).l
02:0003AFC4 13C00000042E    	  6607:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERV).l
02:0003AFCA 13C000000382    	  6608:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERV).l
02:0003AFD0 13C0000003AA    	  6609:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERV).l
                            	  6610:     ; Set the H-direction counter of all necks to 6.
                            	  6611:     ;
02:0003AFD6 E308            	  6612:     lsl.b  #1,D0   ; ASL A
02:0003AFD8 13C000000420    	  6613:     move.b  D0,(Gleook_HeadInfo0+GLEEOK_DIRCOUNTERH).l
02:0003AFDE 13C00000042D    	  6614:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERH).l
02:0003AFE4 13C000000381    	  6615:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERH).l
02:0003AFEA 13C0000003A9    	  6616:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERH).l
                            	  6617:     ; Set neck 1 head delay timer to 12.
                            	  6618:     ;
02:0003AFF0 E308            	  6619:     lsl.b  #1,D0   ; ASL A
02:0003AFF2 13C000000432    	  6620:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DELAY).l
                            	  6621:     ; Set neck 2 head delay timer to 24.
                            	  6622:     ;
02:0003AFF8 E308            	  6623:     lsl.b  #1,D0   ; ASL A
02:0003AFFA 13C000000386    	  6624:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DELAY).l
                            	  6625:     ; Set neck 3 head delay timer to 36.
                            	  6626:     ;
02:0003B000 123900000432    	  6627:     move.b  (Gleook_HeadInfo1+GLEEOK_DELAY).l,D1
02:0003B006 D101            	  6628:     addx.b  D1,D0   ; ADC Gleook_HeadInfo1+GLEEOK_DELAY
02:0003B008 13C0000003AE    	  6629:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DELAY).l
                            	  6630:     ; Leave neck 0 head delay timer as 0.
                            	  6631:     ;
02:0003B00E 4E75            	  6632:     rts
