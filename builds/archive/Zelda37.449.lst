02:0002F4DC 4E75            	   728:     rts
02:0002F4DE 7000            	   729:     moveq   #0,D0
02:0002F4E0 1880            	   730:     move.b  D0,($0000,A4)
02:0002F4E2 103C00A5        	   731:     move.b  #$A5,D0
02:0002F4E6 19400001        	   732:     move.b  D0,($0001,A4)
02:0002F4EA 103C0090        	   733:     move.b  #$90,D0
02:0002F4EE 19400002        	   734:     move.b  D0,($0002,A4)
02:0002F4F2 706C            	   735:     moveq   #108,D0
02:0002F4F4 19400003        	   736:     move.b  D0,($0003,A4)
02:0002F4F8 7600            	   737:     moveq   #0,D3
