                            	  4766: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:000482F6 101D            	  4767:     move.b  (A5)+,D0  ; PLA
                            	  4768:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4769:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  4770:     ;
                            	  4771:     ;
                            	  4772:     ; Call this only to get reverse direction index.
02:000482F8 4EB900030A20    	  4773:     jsr     GetOppositeDir
02:000482FE 102C0015        	  4774:     move.b  ($0015,A4),D0
02:00048302 02000003        	  4775:     andi.b #$03,D0
02:00048306 41F900048544    	  4776:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004830C 12303000        	  4777:     move.b  (A0,D3.W),D1
02:00048310 8001            	  4778:     or.b  D1,D0
02:00048312 4EB9000310E2    	  4779:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4780:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4781:     ;
02:00048318 41F900048540    	  4782:     lea     (RDirectionToWeaponFrame).l,A0
02:0004831E 10303000        	  4783:     move.b  (A0,D3.W),D0
02:00048322 1940000C        	  4784:     move.b  D0,($000C,A4)
                            	  4785:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
