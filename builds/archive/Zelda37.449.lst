02:0003E2E4 D101            	  3346:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E2E6 41EC0084        	  3347:     lea     ($0084,A4),A0
02:0003E2EA 12302000        	  3348:     move.b  (A0,D2.W),D1
02:0003E2EE B001            	  3349:     cmp.b   D1,D0
02:0003E2F0 6648            	  3350:     bne  _L_z05_CheckLadder_StashLadder
02:0003E2F2 102C0070        	  3351:     move.b  ($0070,A4),D0
02:0003E2F6 003C0011        	  3352:     ori     #$11,CCR  ; SEC: set C+X
02:0003E2FA 12342070        	  3353:     move.b  ($70,A4,D2.W),D1
02:0003E2FE 0A3C0010        	  3354:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E302 9101            	  3355:     subx.b  D1,D0   ; SBC ObjX,X
02:0003E304 0A3C0010        	  3356:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3357:     even
                            	  3358: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3359:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3360:     ; If > $10, go put the ladder away.
                            	  3361:     ;
02:0003E308 4EB900030A24    	  3362:     jsr     Abs
02:0003E30E 1880            	  3363:     move.b  D0,($0000,A4)
02:0003E310 0C000010        	  3364:     cmpi.b  #$10,D0
02:0003E314 6532            	  3365:     bcs  _L_z05_CheckLadder_SetState2
02:0003E316 0C000010        	  3366:     cmpi.b  #$10,D0
02:0003E31A 661E            	  3367:     bne  _L_z05_CheckLadder_StashLadder
                            	  3368:     ; Distance = $10. If player's not facing in the same direction as
                            	  3369:     ; the ladder, go put away the ladder.
                            	  3370:     ;
02:0003E31C 102C0098        	  3371:     move.b  ($0098,A4),D0
02:0003E320 41EC0098        	  3372:     lea     ($0098,A4),A0
02:0003E324 12302000        	  3373:     move.b  (A0,D2.W),D1
02:0003E328 B001            	  3374:     cmp.b   D1,D0
02:0003E32A 660E            	  3375:     bne  _L_z05_CheckLadder_StashLadder
                            	  3376:     ; Distance = $10, and player's facing in the same direction.
                            	  3377:     ;
                            	  3378:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3379:     ; ladder and had not stepped onto it yet.
                            	  3380:     ; Go handle movement on it, but don't change state yet.
                            	  3381:     ;
                            	  3382:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3383:     ; off of the ladder. So the ladder should be put away. In this
                            	  3384:     ; case, fall thru.
                            	  3385:     ;
02:0003E32C 41EC00AC        	  3386:     lea     ($00AC,A4),A0
02:0003E330 10302000        	  3387:     move.b  (A0,D2.W),D0
02:0003E334 0C000001        	  3388:     cmpi.b  #$01,D0
02:0003E338 6718            	  3389:     beq  _L_z05_CheckLadder_HandleInput
                            	  3390:     even
                            	  3391: _L_z05_CheckLadder_StashLadder:
                            	  3392:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3393:     ;
02:0003E33A 7000            	  3394:     moveq   #0,D0
02:0003E33C 19400064        	  3395:     move.b  D0,($0064,A4)
02:0003E340 4EB900049848    	  3396:     jsr     DestroyMonster
                            	  3397:     even
                            	  3398: _L_z05_CheckLadder_Exit:
02:0003E346 4E75            	  3399:     rts
                            	  3400: 
                            	  3401:     even
                            	  3402: _L_z05_CheckLadder_SetState2:
                            	  3403:     ;  Set state 2, because we're on the ladder.
                            	  3404:     ;
02:0003E348 7002            	  3405:     moveq   #2,D0
02:0003E34A 41EC00AC        	  3406:     lea     ($00AC,A4),A0
02:0003E34E 11802000        	  3407:     move.b  D0,(A0,D2.W)
                            	  3408:     even
                            	  3409: _L_z05_CheckLadder_HandleInput:
                            	  3410:     ; If input direction = 0, go draw and reset moving direction.
                            	  3411:     ;
02:0003E352 102C03F8        	  3412:     move.b  ($03F8,A4),D0
02:0003E356 67000086        	  3413:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3414:     ; Input direction <> 0. The player intends to move.
                            	  3415:     ; So, see if we need to override the moving direction.
                            	  3416:     ;
                            	  3417:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3418:     ; go draw and set moving direction to Link's direction.
                            	  3419:     ;
                            	  3420:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3421:     ; been blocked by the water.
                            	  3422:     ;
                            	  3423:     ; Or, Link already passed over the point right over the ladder
                            	  3424:     ; and was allowed to move onto the tiles after the ladder.
                            	  3425:     ;
02:0003E35A 102C0098        	  3426:     move.b  ($0098,A4),D0
02:0003E35E 7600            	  3427:     moveq   #0,D3
02:0003E360 1614            	  3428:     move.b  ($0000,A4),D3
02:0003E362 670C            	  3429:     beq  _anon_z05_86
02:0003E364 41EC0098        	  3430:     lea     ($0098,A4),A0
02:0003E368 12302000        	  3431:     move.b  (A0,D2.W),D1
02:0003E36C B001            	  3432:     cmp.b   D1,D0
02:0003E36E 676E            	  3433:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3434: _anon_z05_86:
                            	  3435:     ; Distance = 0, or facing different directions.
                            	  3436:     ;
                            	  3437:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3438:     ; then go draw and keep moving.
                            	  3439:     ;
                            	  3440:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3441:     ;
                            	  3442:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3443:     ; to move onto the tiles after the ladder.
                            	  3444:     ;
                            	  3445:     ; Note that if Link is not moving, then this test will fail,
                            	  3446:     ; and case (D) will catch it.
                            	  3447:     ;
02:0003E370 41EC0098        	  3448:     lea     ($0098,A4),A0
02:0003E374 10302000        	  3449:     move.b  (A0,D2.W),D0
02:0003E378 122C000F        	  3450:     move.b  ($000F,A4),D1
02:0003E37C B001            	  3451:     cmp.b   D1,D0
02:0003E37E 675E            	  3452:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3453:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3454:     ; then go draw and move in ladder's direction.
                            	  3455:     ;
                            	  3456:     ; You can always step off the ladder where you came from.
                            	  3457:     ;
02:0003E380 4EB900030A20    	  3458:     jsr     GetOppositeDir
02:0003E386 122C0098        	  3459:     move.b  ($0098,A4),D1
02:0003E38A B001            	  3460:     cmp.b   D1,D0
02:0003E38C 6750            	  3461:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3462:     ; D. If opposite of ladder's direction <> down,
                            	  3463:     ; or input direction <> up,
                            	  3464:     ; then go reset moving direction, and draw.
                            	  3465:     ;
                            	  3466:     ; This will catch all cases of Link facing perpendicular to
                            	  3467:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3468:     ; ladder direction is up and input direction is up (E).
                            	  3469:     ;
02:0003E38E 0C000004        	  3470:     cmpi.b  #$04,D0
02:0003E392 6648            	  3471:     bne  _anon_z05_87
02:0003E394 102C03F8        	  3472:     move.b  ($03F8,A4),D0
02:0003E398 0C000008        	  3473:     cmpi.b  #$08,D0
02:0003E39C 663E            	  3474:     bne  _anon_z05_87
                            	  3475:     ; E. The ladder's direction is up and input direction is up.
                            	  3476:     ;
                            	  3477:     ; An earlier call to check tile collision would have blocked
                            	  3478:     ; movement, because the tile under Link's top half is a water tile.
                            	  3479:     ; But because Link is squarely on the ladder, we really have
                            	  3480:     ; to check the tile above that one.
                            	  3481:     ;
                            	  3482:     ; Set moving direction to input direction (up) and switch X to
                            	  3483:     ; the player's slot for the purpose of checking tile collision below.
                            	  3484:     ; Based on that, we'll set moving direction according to walkability.
                            	  3485:     ;
02:0003E39E 6158            	  3486:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3487:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3488:     ;
02:0003E3A0 102C0084        	  3489:     move.b  ($0084,A4),D0
02:0003E3A4 1B00            	  3490:     move.b  D0,-(A5)  ; PHA
02:0003E3A6 003C0011        	  3491:     ori     #$11,CCR  ; SEC: set C+X
02:0003E3AA 123C0008        	  3492:     move.b  #$08,D1
02:0003E3AE 0A3C0010        	  3493:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E3B2 9101            	  3494:     subx.b  D1,D0   ; SBC #$08
02:0003E3B4 0A3C0010        	  3495:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E3B8 19400084        	  3496:     move.b  D0,($0084,A4)
02:0003E3BC 4EB900047A96    	  3497:     jsr     GetCollidingTileMoving
02:0003E3C2 101D            	  3498:     move.b  (A5)+,D0  ; PLA
02:0003E3C4 19400084        	  3499:     move.b  D0,($0084,A4)
                            	  3500:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3501:     ; direction as the input direction (in a roundabout way).
                            	  3502:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3503:     ;
02:0003E3C8 102C000F        	  3504:     move.b  ($000F,A4),D0
02:0003E3CC 7600            	  3505:     moveq   #0,D3
02:0003E3CE 162C049E        	  3506:     move.b  ($049E,A4),D3
02:0003E3D2 122C034A        	  3507:     move.b  ($034A,A4),D1
02:0003E3D6 B601            	  3508:     cmp.b   D1,D3
02:0003E3D8 6500FF78        	  3509:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3510: _anon_z05_87:
                            	  3511:     ; Set A to reset moving direction in [0F].
                            	  3512:     ;
02:0003E3DC 7000            	  3513:     moveq   #0,D0
                            	  3514:     even
                            	  3515: _L_z05_CheckLadder_DrawLadder:
                            	  3516:     ; Draw the ladder.
                            	  3517:     ;
02:0003E3DE 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
02:0003E3E0 7400            	  3519:     moveq   #0,D2
02:0003E3E2 142C0064        	  3520:     move.b  ($0064,A4),D2
02:0003E3E6 4EB90004906C    	  3521:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003E3EC 760C            	  3522:     moveq   #12,D3
02:0003E3EE 7000            	  3523:     moveq   #0,D0
02:0003E3F0 4EB900030FF4    	  3524:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0003E3F6 101D            	  3525:     move.b  (A5)+,D0  ; PLA
                            	  3526: ; Params:
                            	  3527: ; A: direction
                            	  3528: ;
                            	  3529: ; Returns:
                            	  3530: ; [0F]: direction
                            	  3531: ;
                            	  3532:     even
