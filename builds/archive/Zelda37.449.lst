02:00039E70 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039E74 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039E78 B001            	  4315:     cmp.b   D1,D0
02:00039E7A 6704            	  4316:     beq.s  __far_z_04_0038
02:00039E7C 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
