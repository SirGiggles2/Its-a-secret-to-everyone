02:0003AEE0 661A            	  6507:     bne  _anon_z04_107
                            	  6508:     ; If facing left, then flip horizontally.
                            	  6509:     ;
02:0003AEE2 41EC0098        	  6510:     lea     ($0098,A4),A0
02:0003AEE6 10302000        	  6511:     move.b  (A0,D2.W),D0
02:0003AEEA E208            	  6512:     lsr.b  #1,D0   ; LSR A
02:0003AEEC 02000001        	  6513:     andi.b #$01,D0
02:0003AEF0 1940000F        	  6514:     move.b  D0,($000F,A4)
02:0003AEF4 101D            	  6515:     move.b  (A5)+,D0  ; PLA
02:0003AEF6 4EF900030DF0    	  6516:     jmp     DrawObjectNotMirrored
