02:0003BA12 4EB900049066    	  7974:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003BA18 41EC03E4        	  7975:     lea     ($03E4,A4),A0
02:0003BA1C 10302000        	  7976:     move.b  (A0,D2.W),D0
02:0003BA20 4EF900030DF0    	  7977:     jmp     DrawObjectNotMirrored
