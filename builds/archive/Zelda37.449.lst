02:000399FE 7600            	  3669:     moveq   #0,D3
02:00039A00 1600            	  3670:     move.b  D0,D3
02:00039A02 41F90003C2E8    	  3671:     lea     (Directions8).l,A0
02:00039A08 10303000        	  3672:     move.b  (A0,D3.W),D0
02:00039A0C 1940009D        	  3673:     move.b  D0,($009D,A4)
02:00039A10 19400385        	  3674:     move.b  D0,($0385,A4)
02:00039A14 102C0022        	  3675:     move.b  ($0022,A4),D0
02:00039A18 02000007        	  3676:     andi.b #$07,D0
02:00039A1C 7600            	  3677:     moveq   #0,D3
02:00039A1E 1600            	  3678:     move.b  D0,D3
02:00039A20 41F90003C2E8    	  3679:     lea     (Directions8).l,A0
02:00039A26 10303000        	  3680:     move.b  (A0,D3.W),D0
02:00039A2A 194000A2        	  3681:     move.b  D0,($00A2,A4)
02:00039A2E 1940038A        	  3682:     move.b  D0,($038A,A4)
