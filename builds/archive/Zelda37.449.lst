02:000482E4 102C0001        	  4760:     move.b  ($0001,A4),D0
02:000482E8 023C00EE        	  4761:     andi    #$EE,CCR  ; CLC: clear C+X
02:000482EC 123C0003        	  4762:     move.b  #$03,D1
02:000482F0 D101            	  4763:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000482F2 19400001        	  4764:     move.b  D0,($0001,A4)
