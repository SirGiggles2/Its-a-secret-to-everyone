02:00048744 7000            	  5410:     moveq   #0,D0
02:00048746 1940000F        	  5411:     move.b  D0,($000F,A4)
                            	  5412:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5413:     ; and go draw.
                            	  5414:     ;
02:0004874A 41EC0098        	  5415:     lea     ($0098,A4),A0
02:0004874E 10302000        	  5416:     move.b  (A0,D2.W),D0
02:00048752 4EB900030A20    	  5417:     jsr     GetOppositeDir
