                            	  8178: Ganon_UpdateBrownState:
                            	  8179:     ; Every other frame decrement the state.
                            	  8180:     ; But every frame draw Ganon either translucent or opaque.
                            	  8181:     ;
02:0003BB46 102C0015        	  8182:     move.b  ($0015,A4),D0
02:0003BB4A E208            	  8183:     lsr.b  #1,D0   ; LSR A
02:0003BB4C 6410            	  8184:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003BB4E 41EC00AC        	  8185:     lea     ($00AC,A4),A0
