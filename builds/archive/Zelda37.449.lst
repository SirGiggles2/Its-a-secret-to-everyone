02:0003FEAC 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:0003FEAE 0C000004        	  5818:     cmpi.b  #$04,D0
02:0003FEB2 6602            	  5819:     bne  _anon_z05_126
02:0003FEB4 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:0003FEB6 0C000001        	  5822:     cmpi.b  #$01,D0
02:0003FEBA 6602            	  5823:     bne  _anon_z05_127
02:0003FEBC 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:0003FEBE 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEC2 123C0003        	  5829:     move.b  #$03,D1
02:0003FEC6 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FECA 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:0003FECC 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FED0 7600            	  5833:     moveq   #0,D3
02:0003FED2 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:0003FED4 102C0008        	  5841:     move.b  ($0008,A4),D0
02:0003FED8 6708            	  5842:     beq  _anon_z05_128
02:0003FEDA 0C030005        	  5843:     cmpi.b  #$05,D3
02:0003FEDE 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FEE0 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:0003FEE2 0C030003        	  5847:     cmpi.b  #$03,D3
02:0003FEE6 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FEE8 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:0003FEEA 7003            	  5857:     moveq   #3,D0
02:0003FEEC 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEF0 122C0003        	  5859:     move.b  ($0003,A4),D1
02:0003FEF4 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FEF8 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:0003FEFA 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:0003FEFE 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:0003FF02 41F90003FCD8    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:0003FF08 10302000        	  5870:     move.b  (A0,D2.W),D0
02:0003FF0C 1880            	  5871:     move.b  D0,($0000,A4)
02:0003FF0E 41F90003FCDC    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:0003FF14 10302000        	  5873:     move.b  (A0,D2.W),D0
02:0003FF18 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:0003FF1C 19420009        	  5878:     move.b  D2,($0009,A4)
02:0003FF20 7400            	  5879:     moveq   #0,D2
02:0003FF22 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:0003FF26 7000            	  5883:     moveq   #0,D0
02:0003FF28 19400007        	  5884:     move.b  D0,($0007,A4)
02:0003FF2C 7002            	  5885:     moveq   #2,D0
02:0003FF2E 19400006        	  5886:     move.b  D0,($0006,A4)
02:0003FF32 19400005        	  5887:     move.b  D0,($0005,A4)
02:0003FF36 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003FF3A 4E75            	  5889:     rts
