                            	  5656: CalcBoomerangFrame:
                            	  5657:     ; The minor state (low 3 bits of state) is used to
                            	  5658:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5659:     ;
                            	  5660:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5661:     ; In other words, don't offset the coordinate below.
                            	  5662:     ;
02:00048910 7000            	  5663:     moveq   #0,D0
02:00048912 1880            	  5664:     move.b  D0,($0000,A4)
02:00048914 41EC00AC        	  5665:     lea     ($00AC,A4),A0
02:00048918 10302000        	  5666:     move.b  (A0,D2.W),D0
02:0004891C 0200000F        	  5667:     andi.b #$0F,D0
02:00048920 7600            	  5668:     moveq   #0,D3
02:00048922 1600            	  5669:     move.b  D0,D3
02:00048924 7000            	  5670:     moveq   #0,D0
02:00048926 19400001        	  5671:     move.b  D0,($0001,A4)
02:0004892A 41F900048518    	  5672:     lea     (BoomerangFrameCycle).l,A0
02:00048930 10303000        	  5673:     move.b  (A0,D3.W),D0
02:00048934 1940000C        	  5674:     move.b  D0,($000C,A4)
                            	  5675:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5676:     ;
02:00048938 1003            	  5677:     move.b  D3,D0
02:0004893A 41F900048522    	  5678:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:00048940 10303000        	  5679:     move.b  (A0,D3.W),D0
02:00048944 19400004        	  5680:     move.b  D0,($0004,A4)
                            	  5681:     ; TODO: ?
                            	  5682:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5683:     ; Else add the item value of the magic boomerang.
                            	  5684:     ;
                            	  5685:     ; But none of the values in the base sprite attributes array is 8.
                            	  5686:     ;
                            	  5687:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5688:     ; the inventory will always be added to the base sprite attribute.
                            	  5689:     ;
                            	  5690:     ; So, palette row 4 or 5 will be chosen.
                            	  5691:     ;
02:00048948 7600            	  5692:     moveq   #0,D3
02:0004894A 0C000008        	  5693:     cmpi.b  #$08,D0
02:0004894E 6706            	  5694:     beq  _anon_z07_31
02:00048950 7600            	  5695:     moveq   #0,D3
02:00048952 162C0675        	  5696:     move.b  ($0675,A4),D3
