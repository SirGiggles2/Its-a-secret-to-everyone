                            	  1659:     even
                            	  1660: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1661:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1662:     ; the mound frame images:
                            	  1663:     ;
                            	  1664:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1665:     ;
                            	  1666:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1667:     ;
                            	  1668:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1669:     ;
02:00038BA4 003C0011        	  1670:     ori     #$11,CCR  ; SEC: set C+X
02:00038BA8 123C0001        	  1671:     move.b  #$01,D1
02:00038BAC 0A3C0010        	  1672:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038BB0 9101            	  1673:     subx.b  D1,D0   ; SBC #$01
02:00038BB2 0A3C0010        	  1674:     eori    #$10,CCR  ; restore X = 6502 C
02:00038BB6 E308            	  1675:     lsl.b  #1,D0   ; ASL A
02:00038BB8 023C00EE        	  1676:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038BBC 41EC03E4        	  1677:     lea     ($03E4,A4),A0
02:00038BC0 12302000        	  1678:     move.b  (A0,D2.W),D1
02:00038BC4 D101            	  1679:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1680:     even
                            	  1681: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw:
02:00038BC6 61008224        	  1682:     jsr     DrawObjectMirrored
                            	  1683:     ; If not zora and state <> 3, 
                            	  1684:     ; or zora and state <> 2, 3, 4;
                            	  1685:     ; then return.
                            	  1686:     ;
02:00038BCA 41EC034F        	  1687:     lea     ($034F,A4),A0
02:00038BCE 10302000        	  1688:     move.b  (A0,D2.W),D0
02:00038BD2 0C000011        	  1689:     cmpi.b  #$11,D0
02:00038BD6 6614            	  1690:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038BD8 41EC00AC        	  1691:     lea     ($00AC,A4),A0
02:00038BDC 10302000        	  1692:     move.b  (A0,D2.W),D0
02:00038BE0 0C000002        	  1693:     cmpi.b  #$02,D0
02:00038BE4 6714            	  1694:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00038BE6 0C000004        	  1695:     cmpi.b  #$04,D0
02:00038BEA 670E            	  1696:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
                            	  1697:     even
                            	  1698: _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions:
02:00038BEC 41EC00AC        	  1699:     lea     ($00AC,A4),A0
02:00038BF0 10302000        	  1700:     move.b  (A0,D2.W),D0
02:00038BF4 0C000003        	  1701:     cmpi.b  #$03,D0
