                            	  7026: UpdateMetaObjectEnd:
                            	  7027:     ; Metastate = 4 or $14.
                            	  7028:     ;
                            	  7029:     ; If it's 4, go reset the metastate. The object is ready to update
                            	  7030:     ; on its own.
                            	  7031:     ;
02:0004939C 41EC0405        	  7032:     lea     ($0405,A4),A0
