02:0004887E 1600            	  5596:     move.b  D0,D3
02:00048880 41F900048536    	  5597:     lea     (BoomerangQSpeedFracsX).l,A0
02:00048886 10303000        	  5598:     move.b  (A0,D3.W),D0
02:0004888A 4EB900030A38    	  5599:     jsr     SetBoomerangSpeed
02:00048890 102C000B        	  5600:     move.b  ($000B,A4),D0
02:00048894 1940000F        	  5601:     move.b  D0,($000F,A4)
02:00048898 41EC0098        	  5602:     lea     ($0098,A4),A0
