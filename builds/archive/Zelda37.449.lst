02:00047DF0 4A02            	  3959:     cmpi.b  #$00,D2
02:00047DF2 6706            	  3960:     beq  _anon_z07_15
02:00047DF4 7010            	  3961:     moveq   #16,D0
02:00047DF6 163C00F0        	  3962:     move.b  #$F0,D3
                            	  3963: _anon_z07_15:
02:00047DFA 1940010E        	  3964:     move.b  D0,($010E,A4)
02:00047DFE 1943010F        	  3965:     move.b  D3,($010F,A4)
02:00047E02 102C000F        	  3966:     move.b  ($000F,A4),D0
02:00047E06 673C            	  3967:     beq  _L_z07_MoveObject_Exit
                            	  3968:     ; To allow a wide speed range, we keep the quarter speed.
                            	  3969:     ; Here, apply it 4 times to get the full speed.
02:00047E08 6106            	  3970:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E0A 6104            	  3971:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E0C 61000002        	  3972:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
                            	  3973:     even
                            	  3974: _L_z07_MoveObject_ApplyQSpeedToPosition:
02:00047E10 102C000F        	  3975:     move.b  ($000F,A4),D0
02:00047E14 E208            	  3976:     lsr.b  #1,D0   ; LSR A
02:00047E16 654C            	  3977:     bcs  _L_z07_MoveObject_Right
02:00047E18 E208            	  3978:     lsr.b  #1,D0   ; LSR A
02:00047E1A 655E            	  3979:     bcs  _L_z07_MoveObject_Left
02:00047E1C E208            	  3980:     lsr.b  #1,D0   ; LSR A
02:00047E1E 6526            	  3981:     bcs  _L_z07_MoveObject_Down
                            	  3982:     ; Up
                            	  3983:     ;
02:00047E20 4EB900030A18    	  3984:     jsr     SubQSpeedFromPositionFraction
