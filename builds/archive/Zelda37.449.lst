02:00033756 10302000        	  2169:     move.b  (A0,D2.W),D0
02:0003375A 41EC0422        	  2170:     lea     ($0422,A4),A0
02:0003375E 11803000        	  2171:     move.b  D0,(A0,D3.W)
02:00033762 5302            	  2172:     subq.b  #1,D2
02:00033764 5303            	  2173:     subq.b  #1,D3
02:00033766 6AE8            	  2174:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033768 522C0420        	  2175:     addq.b  #1,($0420,A4)
                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:0003376C 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:00033770 020000C0        	  2186:     andi.b #$C0,D0
02:00033774 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:00033778 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:0003377C 660000A6        	  2191:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2192:     ; A was pressed.
                            	  2193:     ;
                            	  2194:     ; Request to play the character click tune (same as bomb set).
02:00033780 7620            	  2195:     moveq   #32,D3
02:00033782 19430604        	  2196:     move.b  D3,($0604,A4)
02:00033786 7602            	  2197:     moveq   #2,D3
                            	  2198:     even
                            	  2199: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033788 41EC0422        	  2200:     lea     ($0422,A4),A0
02:0003378C 10303000        	  2201:     move.b  (A0,D3.W),D0
02:00033790 41EC0302        	  2202:     lea     ($0302,A4),A0
02:00033794 11803000        	  2203:     move.b  D0,(A0,D3.W)
02:00033798 5303            	  2204:     subq.b  #1,D3
02:0003379A 6AEC            	  2205:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:0003379C 19430306        	  2206:     move.b  D3,($0306,A4)
02:000337A0 7400            	  2207:     moveq   #0,D2
02:000337A2 142C0421        	  2208:     move.b  ($0421,A4),D2
02:000337A6 7600            	  2209:     moveq   #0,D3
02:000337A8 162C041F        	  2210:     move.b  ($041F,A4),D3
02:000337AC 41F9000330EC    	  2211:     lea     (ModeE_CharMap).l,A0
02:000337B2 10303000        	  2212:     move.b  (A0,D3.W),D0
02:000337B6 19400305        	  2213:     move.b  D0,($0305,A4)
02:000337BA 41EC0638        	  2214:     lea     ($0638,A4),A0
02:000337BE 11802000        	  2215:     move.b  D0,(A0,D2.W)
