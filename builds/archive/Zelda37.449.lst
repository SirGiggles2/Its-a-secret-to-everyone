02:0003A0EA 7600            	  4615:     moveq   #0,D3
02:0003A0EC 1600            	  4616:     move.b  D0,D3
02:0003A0EE 5203            	  4617:     addq.b  #1,D3
02:0003A0F0 41EC0098        	  4618:     lea     ($0098,A4),A0
02:0003A0F4 11832000        	  4619:     move.b  D3,(A0,D2.W)
02:0003A0F8 4E75            	  4620:     rts
