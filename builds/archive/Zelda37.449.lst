02:00038BFE 41EC0405        	  1708:     lea     ($0405,A4),A0
02:00038C02 10302000        	  1709:     move.b  (A0,D2.W),D0
02:00038C06 6712            	  1710:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1711:     ; If monster is a red leever, then decrement the red leever count.
