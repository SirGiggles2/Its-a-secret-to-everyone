                            	  2148: SecretArmosRoomIds:
02:00038F30 24              	  2149:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:00038F31 0B
02:00038F32 1C
02:00038F33 22
02:00038F34 34
02:00038F35 3D
02:00038F36 4E
                            	  2150: 
