02:0003A108 0C000088        	  4633:     cmpi.b  #$88,D0
02:0003A10C 6414            	  4634:     bcc  _L_z04_Aquamentus_Move_CheckRightLimit
02:0003A10E 103C0088        	  4635:     move.b  #$88,D0
02:0003A112 19802070        	  4636:     move.b  D0,($70,A4,D2.W)
02:0003A116 7001            	  4637:     moveq   #1,D0
02:0003A118 41EC0098        	  4638:     lea     ($0098,A4),A0
02:0003A11C 11802000        	  4639:     move.b  D0,(A0,D2.W)
