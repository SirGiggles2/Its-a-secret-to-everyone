02:0003E62F BF
02:0003E630 00
02:0003E631 D2
                            	  3820: 
                            	  3821: ; Player coordinate must be < these bounds.
                            	  3822: ; Using these bounds; the player will be considered within the
                            	  3823: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3824: ; at the edge.
                            	  3825: ;
                            	  3826:     even
                            	  3827: DoorwayBoundsMaxUnder:
02:0003E632 5C              	  3828:     dc.b    $5C, $DE, $1F, $F1
02:0003E633 DE
02:0003E634 1F
02:0003E635 F1
                            	  3829: 
                            	  3830: ; Params:
                            	  3831: ; [0F]: moving direction
                            	  3832: ;
                            	  3833: ; Returns:
                            	  3834: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3835: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3836: ;
                            	  3837: ; When not at or in a doorway, this function leaves
                            	  3838: ; [0F] moving direction as is.
                            	  3839: ;
                            	  3840: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3841: ; will be left as is, assuming that it had been reset before this
                            	  3842: ; routine by BoundByRoom.
                            	  3843: ;
                            	  3844: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3845: ;
                            	  3846: ;
                            	  3847: ; If already in a doorway, go handle it separately.
                            	  3848: ;
                            	  3849:     even
                            	  3850: CheckDoorway:
02:0003E636 102C0053        	  3851:     move.b  ($0053,A4),D0
02:0003E63A 6648            	  3852:     bne  _L_z05_CheckDoorway_InDoorway
                            	  3853:     even
                            	  3854: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  3855:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  3856:     ;
                            	  3857:     ; To match a doorway:
                            	  3858:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  3859:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  3860:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  3861:     ;
                            	  3862:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  3863:     ; a doorway to be part of it.
                            	  3864:     ;
02:0003E63C 102C0098        	  3865:     move.b  ($0098,A4),D0
02:0003E640 61000122        	  3866:     jsr     GetPlayerCoordsForDirection
02:0003E644 7603            	  3867:     moveq   #3,D3
                            	  3868:     even
                            	  3869: _L_z05_CheckDoorway_LoopOverflowBounds:
02:0003E646 1014            	  3870:     move.b  ($0000,A4),D0
