02:0003B8F4 0C020009        	  7831:     cmpi.b  #$09,D2
02:0003B8F8 6604            	  7832:     bne  _anon_z04_157
02:0003B8FA 522C00AD        	  7833:     addq.b  #1,($00AD,A4)
                            	  7834: _anon_z04_157:
                            	  7835:     ; Go to state 1 to orbit.
                            	  7836:     ;
02:0003B8FE 41EC00AC        	  7837:     lea     ($00AC,A4),A0
02:0003B902 52302000        	  7838:     addq.b  #1,(A0,D2.W)
                            	  7839:     ; TODO: ?
                            	  7840:     ;
02:0003B906 103C0080        	  7841:     move.b  #$80,D0
02:0003B90A 41EC0098        	  7842:     lea     ($0098,A4),A0
02:0003B90E 11802000        	  7843:     move.b  D0,(A0,D2.W)
                            	  7844:     ; Set angle $18 (N).
                            	  7845:     ;
02:0003B912 7018            	  7846:     moveq   #24,D0
02:0003B914 41EC0394        	  7847:     lea     ($0394,A4),A0
02:0003B918 11802000        	  7848:     move.b  D0,(A0,D2.W)
                            	  7849:     ; This location is right above Patra.
                            	  7850:     ; Set X coordinate to Patra's.
                            	  7851:     ;
02:0003B91C 102C0071        	  7852:     move.b  ($0071,A4),D0
02:0003B920 19802070        	  7853:     move.b  D0,($70,A4,D2.W)
                            	  7854:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  7855:     ; Else use radius $18. Store the chosen value in [00].
                            	  7856:     ;
02:0003B924 702C            	  7857:     moveq   #44,D0
02:0003B926 7600            	  7858:     moveq   #0,D3
02:0003B928 41EC034F        	  7859:     lea     ($034F,A4),A0
02:0003B92C 16302000        	  7860:     move.b  (A0,D2.W),D3
02:0003B930 0C030025        	  7861:     cmpi.b  #$25,D3
02:0003B934 6702            	  7862:     beq  _anon_z04_158
02:0003B936 7018            	  7863:     moveq   #24,D0
                            	  7864: _anon_z04_158:
02:0003B938 1880            	  7865:     move.b  D0,($0000,A4)
                            	  7866:     ; This location is right above Patra.
                            	  7867:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  7868:     ;
02:0003B93A 102C0085        	  7869:     move.b  ($0085,A4),D0
02:0003B93E 003C0011        	  7870:     ori     #$11,CCR  ; SEC: set C+X
02:0003B942 1214            	  7871:     move.b  ($0000,A4),D1
02:0003B944 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B948 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B94A 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B94E 41EC0084        	  7875:     lea     ($0084,A4),A0
02:0003B952 11802000        	  7876:     move.b  D0,(A0,D2.W)
                            	  7877:     even
                            	  7878: _L_z04_UpdatePatraChild_Exit:
02:0003B956 4E75            	  7879:     rts
                            	  7880: 
                            	  7881:     even
                            	  7882: PatraChild_State1:
                            	  7883:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	  7884:     ;
02:0003B958 10342070        	  7885:     move.b  ($70,A4,D2.W),D0
02:0003B95C 023C00EE        	  7886:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B960 122C046C        	  7887:     move.b  ($046C,A4),D1
02:0003B964 D101            	  7888:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003B966 19802070        	  7889:     move.b  D0,($70,A4,D2.W)
02:0003B96A 41EC0084        	  7890:     lea     ($0084,A4),A0
02:0003B96E 10302000        	  7891:     move.b  (A0,D2.W),D0
02:0003B972 023C00EE        	  7892:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B976 122C0479        	  7893:     move.b  ($0479,A4),D1
02:0003B97A D101            	  7894:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003B97C 41EC0084        	  7895:     lea     ($0084,A4),A0
02:0003B980 11802000        	  7896:     move.b  D0,(A0,D2.W)
                            	  7897:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  7898:     ;
02:0003B984 7000            	  7899:     moveq   #0,D0
02:0003B986 1940000B        	  7900:     move.b  D0,($000B,A4)
                            	  7901:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  7902:     ; monster's angle by $70, else by $60 to go slower.
                            	  7903:     ;
02:0003B98A 7070            	  7904:     moveq   #112,D0
02:0003B98C 7600            	  7905:     moveq   #0,D3
02:0003B98E 41EC034F        	  7906:     lea     ($034F,A4),A0
02:0003B992 16302000        	  7907:     move.b  (A0,D2.W),D3
02:0003B996 0C030025        	  7908:     cmpi.b  #$25,D3
02:0003B99A 6702            	  7909:     beq  _anon_z04_159
02:0003B99C 7060            	  7910:     moveq   #96,D0
                            	  7911: _anon_z04_159:
02:0003B99E 61000CC0        	  7912:     jsr     DecreaseObjectAngle
                            	  7913:     ; Load Patra's maneuver index.
                            	  7914:     ; It determines which counts of bits are looked up below.
                            	  7915:     ;
02:0003B9A2 7600            	  7916:     moveq   #0,D3
02:0003B9A4 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003B9A8 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003B9AC 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003B9B0 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003B9B4 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003B9B6 41F90003B8A8    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003B9BC 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0003B9C0 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0003B9C2 41F90003B8AC    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0003B9C8 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003B9CC 7600            	  7931:     moveq   #0,D3
02:0003B9CE 1600            	  7932:     move.b  D0,D3
02:0003B9D0 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003B9D2 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0003B9D4 41F90003B8AA    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003B9DA 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003B9DE 7600            	  7944:     moveq   #0,D3
02:0003B9E0 1600            	  7945:     move.b  D0,D3
                            	  7946:     even
                            	  7947: _L_z04_PatraChild_State1_Rotate:
02:0003B9E2 61000ACC        	  7948:     jsr     RotateObjectLocation
02:0003B9E6 41EC0084        	  7949:     lea     ($0084,A4),A0
02:0003B9EA 11802000        	  7950:     move.b  D0,(A0,D2.W)
02:0003B9EE 611C            	  7951:     jsr     PatraChild_Draw
                            	  7952:     ; If Patra's state still = 0, then the last patra child has not
                            	  7953:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  7954:     ;
02:0003B9F0 102C00AD        	  7955:     move.b  ($00AD,A4),D0
02:0003B9F4 6714            	  7956:     beq  _L_z04_PatraChild_State1_Exit
02:0003B9F6 4EB90003115C    	  7957:     jsr     CheckMonsterCollisions
                            	  7958:     ; If the monster died, then change to the dead dummy object.
                            	  7959:     ;
02:0003B9FC 41EC0405        	  7960:     lea     ($0405,A4),A0
02:0003BA00 10302000        	  7961:     move.b  (A0,D2.W),D0
02:0003BA04 6704            	  7962:     beq  _L_z04_PatraChild_State1_Exit
02:0003BA06 6100FDD4        	  7963:     jsr     SetDeadDummyObjType
                            	  7964:     even
                            	  7965: _L_z04_PatraChild_State1_Exit:
02:0003BA0A 4E75            	  7966:     rts
                            	  7967: 
                            	  7968:     even
                            	  7969: PatraChild_Draw:
02:0003BA0C 4EB9000310E0    	  7970:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
                            	  7971:     ; 2 was returned from the routine above in A.
                            	  7972:     ; Pass it as the animation counter value to the routine below.
