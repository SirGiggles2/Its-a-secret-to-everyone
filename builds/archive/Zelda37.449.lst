02:00047F64 4EF90002B780    	  4240:     jmp     c_reset_moving_dir
                            	  4241: 
                            	  4242: GoWalkableDir:
                            	  4243:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4244:     ; makes the object cross a boundary. Then go check another direction if it does,
                            	  4245:     ; or else make this the object direction.
                            	  4246:     ;
02:00047F6A 4A02            	  4247:     cmpi.b  #$00,D2
02:00047F6C 6702            	  4248:     beq.s  __far_z_07_0056
02:00047F6E 602C            	  4249:     jmp  CheckBoundary
                            	  4250: __far_z_07_0056:
                            	  4251:     ; The object is Link. We end up here regardless of walkability.
                            	  4252:     ;
                            	  4253:     ; If not in mode 5 or ladder is in use, return.
                            	  4254:     ;
02:00047F70 102C0012        	  4255:     move.b  ($0012,A4),D0
02:00047F74 0C000005        	  4256:     cmpi.b  #$05,D0
02:00047F78 6702            	  4257:     beq.s  __far_z_07_0057
02:00047F7A 601C            	  4258:     jmp  ExitX0
                            	  4259: __far_z_07_0057:
