02:0003BC62 11803000        	  8331:     move.b  D0,(A0,D3.W)
02:0003BC66 5303            	  8332:     subq.b  #1,D3
02:0003BC68 6AC2            	  8333:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003BC6A 4E75            	  8334:     rts
