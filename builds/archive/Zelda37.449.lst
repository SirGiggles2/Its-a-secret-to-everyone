                            	  3430: Obj_Shove:
                            	  3431:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3432:     ; then go handle it separately.
                            	  3433:     ;
02:00047AAA 41EC00C0        	  3434:     lea     ($00C0,A4),A0
02:00047AAE 10302000        	  3435:     move.b  (A0,D2.W),D0
02:00047AB2 E308            	  3436:     lsl.b  #1,D0   ; ASL A
02:00047AB4 6448            	  3437:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3438:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3439:     ;
02:00047AB6 E208            	  3440:     lsr.b  #1,D0   ; LSR A
02:00047AB8 41EC00C0        	  3441:     lea     ($00C0,A4),A0
02:00047ABC 11802000        	  3442:     move.b  D0,(A0,D2.W)
                            	  3443:     ; If the object faces horizontally, go check which axis shove
                            	  3444:     ; direction is on.
                            	  3445:     ;
02:00047AC0 7600            	  3446:     moveq   #0,D3
02:00047AC2 41EC0098        	  3447:     lea     ($0098,A4),A0
02:00047AC6 16302000        	  3448:     move.b  (A0,D2.W),D3
02:00047ACA 0C030003        	  3449:     cmpi.b  #$03,D3
02:00047ACE 6526            	  3450:     bcs  _L_z07_Obj_Shove_FacingHorizontally
                            	  3451:     ; The object faces vertically.
                            	  3452:     ;
                            	  3453:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3454:     ;
02:00047AD0 02000003        	  3455:     andi.b #$03,D0
02:00047AD4 671E            	  3456:     beq  _L_z07_Obj_Shove_Exit
                            	  3457:     even
