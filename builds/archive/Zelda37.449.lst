                            	  4661: _L_z04_Aquamentus_Move_ApplySpeed:
                            	  4662:     ; Use (direction - 1) to index the speeds.
                            	  4663:     ; This yields 0 for right, 1 for left.
                            	  4664:     ;
02:0003A144 7600            	  4665:     moveq   #0,D3
02:0003A146 41EC0098        	  4666:     lea     ($0098,A4),A0
02:0003A14A 16302000        	  4667:     move.b  (A0,D2.W),D3
02:0003A14E 5303            	  4668:     subq.b  #1,D3
                            	  4669:     ; Add the speed to the X coordinate.
                            	  4670:     ;
02:0003A150 10342070        	  4671:     move.b  ($70,A4,D2.W),D0
02:0003A154 023C00EE        	  4672:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A158 41F90003A0C2    	  4673:     lea     (AquamentusSpeeds).l,A0
02:0003A15E 12303000        	  4674:     move.b  (A0,D3.W),D1
02:0003A162 D101            	  4675:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003A164 19802070        	  4676:     move.b  D0,($70,A4,D2.W)
