02:00048832 16302000        	  5562:     move.b  (A0,D2.W),D3
02:00048836 19803028        	  5563:     move.b  D0,($28,A4,D3.W)
                            	  5564:     ; Reset the thrower's state to make it idle or restart its state machine.
