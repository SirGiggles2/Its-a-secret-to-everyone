                            	  4838: SpreadShot:
                            	  4839:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4840:     ;
                            	  4841:     ; The shot is spreading out.
                            	  4842:     ;
                            	  4843:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4844:     ; These will be negated appropriately for each corner.
                            	  4845:     ;
02:00048374 41EC0098        	  4846:     lea     ($0098,A4),A0
02:00048378 10302000        	  4847:     move.b  (A0,D2.W),D0
02:0004837C 19400002        	  4848:     move.b  D0,($0002,A4)
02:00048380 19400003        	  4849:     move.b  D0,($0003,A4)
                            	  4850:     ; Reset [0F] to not flip horizontally.
                            	  4851:     ;
02:00048384 7000            	  4852:     moveq   #0,D0
02:00048386 1940000F        	  4853:     move.b  D0,($000F,A4)
                            	  4854:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4855:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4856:     ;
02:0004838A 7603            	  4857:     moveq   #3,D3
                            	  4858:     even
                            	  4859: _L_z07_SpreadShot_DrawShotCorner:
02:0004838C 1003            	  4860:     move.b  D3,D0
02:0004838E 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Save offset X [02] and Y offset [03].
                            	  4863:     ;
02:00048390 102C0002        	  4864:     move.b  ($0002,A4),D0
02:00048394 1B00            	  4865:     move.b  D0,-(A5)  ; PHA
02:00048396 102C0003        	  4866:     move.b  ($0003,A4),D0
02:0004839A 1B00            	  4867:     move.b  D0,-(A5)  ; PHA
                            	  4868:     ; Calculate and set sprite attributes for this corner:
                            	  4869:     ;   base attribute OR (frame counter AND 3)
                            	  4870:     ;
                            	  4871:     ; The base attribute defines how to flip the sprite.
                            	  4872:     ; The frame counter makes the shot flash by cycling each
                            	  4873:     ; palette row.
                            	  4874:     ;
02:0004839C 102C0015        	  4875:     move.b  ($0015,A4),D0
02:000483A0 02000003        	  4876:     andi.b #$03,D0
02:000483A4 41F900048280    	  4877:     lea     (SwordShotSpreadBaseAttr).l,A0
02:000483AA 12303000        	  4878:     move.b  (A0,D3.W),D1
02:000483AE 8001            	  4879:     or.b  D1,D0
02:000483B0 4EB9000310E2    	  4880:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4881:     ; Add the object's X (the center of the spread) and the
                            	  4882:     ; current offset in [02] to set sprite X in [00].
                            	  4883:     ;
02:000483B6 10342070        	  4884:     move.b  ($70,A4,D2.W),D0
02:000483BA 023C00EE        	  4885:     andi    #$EE,CCR  ; CLC: clear C+X
02:000483BE 122C0002        	  4886:     move.b  ($0002,A4),D1
02:000483C2 D101            	  4887:     addx.b  D1,D0   ; ADC $02
02:000483C4 1880            	  4888:     move.b  D0,($0000,A4)
                            	  4889:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4890:     ; Else calculate the distance from object X to sprite X.
                            	  4891:     ;
02:000483C6 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:000483CA B001            	  4893:     cmp.b   D1,D0
02:000483CC 651A            	  4894:     bcs  _L_z07_SpreadShot_ReverseSub
02:000483CE 0C0000FC        	  4895:     cmpi.b  #$FC,D0
02:000483D2 6466            	  4896:     bcc  _L_z07_SpreadShot_NextCorner
02:000483D4 003C0011        	  4897:     ori     #$11,CCR  ; SEC: set C+X
02:000483D8 12342070        	  4898:     move.b  ($70,A4,D2.W),D1
02:000483DC 0A3C0010        	  4899:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000483E0 9101            	  4900:     subx.b  D1,D0   ; SBC ObjX,X
02:000483E2 0A3C0010        	  4901:     eori    #$10,CCR  ; restore X = 6502 C
02:000483E6 6014            	  4902:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4903: 
                            	  4904:     even
                            	  4905: _L_z07_SpreadShot_ReverseSub:
02:000483E8 10342070        	  4906:     move.b  ($70,A4,D2.W),D0
02:000483EC 003C0011        	  4907:     ori     #$11,CCR  ; SEC: set C+X
02:000483F0 1214            	  4908:     move.b  ($0000,A4),D1
02:000483F2 0A3C0010        	  4909:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000483F6 9101            	  4910:     subx.b  D1,D0   ; SBC $00
02:000483F8 0A3C0010        	  4911:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4912:     even
                            	  4913: _L_z07_SpreadShot_CheckDistance:
                            	  4914:     ; If distance >= $20, skip this corner.
                            	  4915:     ;
02:000483FC 0C000020        	  4916:     cmpi.b  #$20,D0
02:00048400 6438            	  4917:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4918:     ; Add the object's Y (the center of the spread) and the
                            	  4919:     ; current offset in [03] to set sprite Y in [01].
                            	  4920:     ;
02:00048402 41EC0084        	  4921:     lea     ($0084,A4),A0
02:00048406 10302000        	  4922:     move.b  (A0,D2.W),D0
02:0004840A 023C00EE        	  4923:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004840E 122C0003        	  4924:     move.b  ($0003,A4),D1
02:00048412 D101            	  4925:     addx.b  D1,D0   ; ADC $03
02:00048414 19400001        	  4926:     move.b  D0,($0001,A4)
                            	  4927:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4928:     ;
02:00048418 7600            	  4929:     moveq   #0,D3
02:0004841A 162C0010        	  4930:     move.b  ($0010,A4),D3
02:0004841E 670C            	  4931:     beq  _L_z07_SpreadShot_Draw
02:00048420 0C00003E        	  4932:     cmpi.b  #$3E,D0
02:00048424 6514            	  4933:     bcs  _L_z07_SpreadShot_NextCorner
02:00048426 0C0000E8        	  4934:     cmpi.b  #$E8,D0
02:0004842A 640E            	  4935:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4936:     even
                            	  4937: _L_z07_SpreadShot_Draw:
                            	  4938:     ; Draw the corner.
                            	  4939:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4940:     ;
02:0004842C 7002            	  4941:     moveq   #2,D0
02:0004842E 1940000C        	  4942:     move.b  D0,($000C,A4)
02:00048432 7623            	  4943:     moveq   #35,D3
02:00048434 4EB900031002    	  4944:     jsr     Anim_WriteItemSprites
                            	  4945:     even
                            	  4946: _L_z07_SpreadShot_NextCorner:
                            	  4947:     ; Prepare to process the next corner.
                            	  4948:     ;
                            	  4949:     ; First, restore X offset [02] and Y offset [03].
                            	  4950:     ;
02:0004843A 101D            	  4951:     move.b  (A5)+,D0  ; PLA
02:0004843C 19400003        	  4952:     move.b  D0,($0003,A4)
02:00048440 101D            	  4953:     move.b  (A5)+,D0  ; PLA
02:00048442 19400002        	  4954:     move.b  D0,($0002,A4)
                            	  4955:     ; Take turns negating X offset or Y offset for the next round.
                            	  4956:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4957:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4958:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4959:     ; - Fourth turn: doesn't matter
                            	  4960:     ;
                            	  4961:     ;
                            	  4962:     ; Get the loop index.
02:00048446 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:00048448 1B00            	  4964:     move.b  D0,-(A5)  ; PHA
02:0004844A 7600            	  4965:     moveq   #0,D3
02:0004844C 1600            	  4966:     move.b  D0,D3
02:0004844E 0C030001        	  4967:     cmpi.b  #$01,D3
02:00048452 6602            	  4968:     bne  _anon_z07_25
02:00048454 7603            	  4969:     moveq   #3,D3
                            	  4970: _anon_z07_25:
02:00048456 10343000        	  4971:     move.b  ($00,A4,D3.W),D0
02:0004845A 4600            	  4972:     eori.b #$FF,D0
02:0004845C 023C00EE        	  4973:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048460 123C0001        	  4974:     move.b  #$01,D1
02:00048464 D101            	  4975:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048466 19803000        	  4976:     move.b  D0,($00,A4,D3.W)
                            	  4977:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4978:     ;
02:0004846A 101D            	  4979:     move.b  (A5)+,D0  ; PLA
02:0004846C 7600            	  4980:     moveq   #0,D3
02:0004846E 1600            	  4981:     move.b  D0,D3
02:00048470 5303            	  4982:     subq.b  #1,D3
02:00048472 6A00FF18        	  4983:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  4984:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
