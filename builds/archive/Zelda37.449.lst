                            	  7546:     ; If secret color cycle >= $C, return.
                            	  7547:     ;
02:00049886 7600            	  7548:     moveq   #0,D3
02:00049888 162C051A        	  7549:     move.b  ($051A,A4),D3
02:0004988C 0C03000C        	  7550:     cmpi.b  #$0C,D3
02:00049890 6502            	  7551:     bcs.s  __far_z_07_0117
02:00049892 605C            	  7552:     jmp  L1FF28_Exit
                            	  7553: __far_z_07_0117:
                            	  7554:     ; 7 of every 8 frames, return.
                            	  7555:     ;
02:00049894 102C0015        	  7556:     move.b  ($0015,A4),D0
02:00049898 02000007        	  7557:     andi.b #$07,D0
02:0004989C 0C000004        	  7558:     cmpi.b  #$04,D0
02:000498A0 6702            	  7559:     beq.s  __far_z_07_0118
02:000498A2 604C            	  7560:     jmp  L1FF28_Exit
                            	  7561: __far_z_07_0118:
                            	  7562:     ; So, every 8 frames:
                            	  7563:     ; 1. Increment the secret color cycle count.
                            	  7564:     ; 2. Change the water palette.
                            	  7565:     ;
                            	  7566:     ; But when the count = $B, go reveal the stairs.
                            	  7567:     ;
02:000498A4 522C051A        	  7568:     addq.b  #1,($051A,A4)
02:000498A8 0C03000B        	  7569:     cmpi.b  #$0B,D3
02:000498AC 6602            	  7570:     bne.s  __far_z_07_0119
02:000498AE 6042            	  7571:     jmp  RevealPondStairs
