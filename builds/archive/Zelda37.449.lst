                            	  5481: _L_z07_CheckState30_CheckOtherStates:
                            	  5482:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5483:     ;
                            	  5484:     ; The boomerang will now return. Reset the grid offset.
                            	  5485:     ;
02:000487BA 7000            	  5486:     moveq   #0,D0
02:000487BC 41EC0394        	  5487:     lea     ($0394,A4),A0
02:000487C0 11802000        	  5488:     move.b  D0,(A0,D2.W)
                            	  5489:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5490:     ;
02:000487C4 0C02000D        	  5491:     cmpi.b  #$0D,D2
02:000487C8 6408            	  5492:     bcc  _anon_z07_30
02:000487CA 41EC042C        	  5493:     lea     ($042C,A4),A0
02:000487CE 10302000        	  5494:     move.b  (A0,D2.W),D0
                            	  5495: _anon_z07_30:
02:000487D2 4EB900030A30    	  5496:     jsr     GetDirectionsAndDistancesToTarget
                            	  5497:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5498:     ; then go move towards the thrower, draw, and check collisions.
                            	  5499:     ;
02:000487D8 1014            	  5500:     move.b  ($0000,A4),D0
02:000487DA 0C000002        	  5501:     cmpi.b  #$02,D0
02:000487DE 666A            	  5502:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5503:     ; The boomerang has reached the thrower.
                            	  5504:     ;
                            	  5505:     ; Reset the distance to move.
                            	  5506:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5507:     ;
02:000487E0 7000            	  5508:     moveq   #0,D0
02:000487E2 41EC0380        	  5509:     lea     ($0380,A4),A0
02:000487E6 11802000        	  5510:     move.b  D0,(A0,D2.W)
02:000487EA 0C02000D        	  5511:     cmpi.b  #$0D,D2
02:000487EE 6524            	  5512:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5513:     ; Link has caught the boomerang.
                            	  5514:     ;
                            	  5515:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5516:     ;
                            	  5517:     ; If Link catches it some time after throwing it,
                            	  5518:     ; his state will become $20, and he will show the catch animation.
                            	  5519:     ;
                            	  5520:     ; But if he catches it right after throwing it, the state becomes
                            	  5521:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5522:     ;
02:000487F0 102C00AC        	  5523:     move.b  ($00AC,A4),D0
02:000487F4 00000020        	  5524:     ori.b #$20,D0
02:000487F8 194000AC        	  5525:     move.b  D0,($00AC,A4)
                            	  5526:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5527:     ; up the new state.
                            	  5528:     ;
02:000487FC 7001            	  5529:     moveq   #1,D0
02:000487FE 194003D0        	  5530:     move.b  D0,($03D0,A4)
                            	  5531:     ; Deactivate the boomerang.
                            	  5532:     ;
02:00048802 760F            	  5533:     moveq   #15,D3
02:00048804 7000            	  5534:     moveq   #0,D0
02:00048806 41EC00AC        	  5535:     lea     ($00AC,A4),A0
02:0004880A 11803000        	  5536:     move.b  D0,(A0,D3.W)
02:0004880E 0A3C0001        	  5537:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00048812 4E75            	  5538:     rts
                            	  5539: 
                            	  5540:     even
                            	  5541: _L_z07_CheckState30_CatchBoomerang:
                            	  5542:     ; A monster caught the boomerang that it threw.
                            	  5543:     ;
                            	  5544:     ; Set a timer for the thrower based on a random value:
                            	  5545:     ; < $30: $30
                            	  5546:     ; < $70: $50
                            	  5547:     ; Else:  $70
                            	  5548:     ;
02:00048814 7630            	  5549:     moveq   #48,D3
02:00048816 10342018        	  5550:     move.b  ($18,A4,D2.W),D0
02:0004881A 0C000030        	  5551:     cmpi.b  #$30,D0
