                            	   952: 
                            	   953: ;------------------------------------------------------------------------------
                            	   954: ; _c_move_object_shim — MoveObject trampoline.
                            	   955: ;
                            	   956: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   957: ;   Input:     D2 = slot (0..11)
                            	   958: ;   Preserves: D2, A4, A5
                            	   959: ;   Clobbers:  D0, D1, D3, A0
                            	   960: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   961: ;
                            	   962: ; GCC side:
                            	   963: ;   void c_move_object(unsigned short slot);
                            	   964: ;     slot arrives as a 16-bit value on the stack.
                            	   965: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   966: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   967: ;   never clobbered by gcc.
                            	   968: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   969: ;   semantics can exist in a pure C port).
                            	   970: ;------------------------------------------------------------------------------
                            	   971: _c_move_object_shim:
                            	   972:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   973:     move.b  #$AA,($0900,A4)
                            	   974:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   975:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   976:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   977:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   978:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   979:     moveq   #0,D0
02:0002B658 3002            	   980:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   981:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   982:     jsr     c_move_object
02:0002B662 588F            	   983:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   984:     rts
                            	   985: 
                            	   986: ;==============================================================================
                            	   987: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   988: ; and tail-call the native asm function.
                            	   989: ;
                            	   990: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   991: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   992: ; sign-extended).
                            	   993: ;==============================================================================
                            	   994: 
                            	   995: ;------------------------------------------------------------------------------
                            	   996: ; void c_copy_bank_to_window(unsigned int bank);
                            	   997: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   998: ;------------------------------------------------------------------------------
                            	   999: c_copy_bank_to_window:
02:0002B666 202F0004        	  1000:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	  1001:     jmp     _copy_bank_to_window
                            	  1002: 
                            	  1003: ;------------------------------------------------------------------------------
                            	  1004: ; unsigned char c_ppu_read_2(void);
                            	  1005: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	  1006: ; C return: gcc expects result in D0.
                            	  1007: ;------------------------------------------------------------------------------
                            	  1008: c_ppu_read_2:
02:0002B66E 4EF90000E034    	  1009:     jmp     _ppu_read_2
                            	  1010: 
                            	  1011: ;------------------------------------------------------------------------------
                            	  1012: ; void c_ppu_write_6(unsigned int val);
                            	  1013: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	  1014: ;------------------------------------------------------------------------------
                            	  1015: c_ppu_write_6:
02:0002B674 202F0004        	  1016:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	  1017:     jmp     _ppu_write_6
                            	  1018: 
                            	  1019: ;------------------------------------------------------------------------------
                            	  1020: ; void c_ppu_write_7(unsigned int val);
                            	  1021: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1022: ;------------------------------------------------------------------------------
                            	  1023: c_ppu_write_7:
02:0002B67E 202F0004        	  1024:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1025:     jmp     _ppu_write_7
                            	  1026: 
                            	  1027: ;------------------------------------------------------------------------------
                            	  1028: ; void c_turn_off_all_video(void);
                            	  1029: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1030: ;------------------------------------------------------------------------------
                            	  1031: c_turn_off_all_video:
02:0002B688 4EF900046DD6    	  1032:     jmp     TurnOffAllVideo
                            	  1033: 
                            	  1034: ;==============================================================================
                            	  1035: ; EXPORT side — z_03 entry point.
                            	  1036: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1037: ; the transpiler emits that label pointing to this shim instead of the
                            	  1038: ; z_03 asm body. The C function takes no args and returns void.
                            	  1039: ;==============================================================================
                            	  1040: 
                            	  1041: ;------------------------------------------------------------------------------
                            	  1042: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1043: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1044: ;------------------------------------------------------------------------------
                            	  1045: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1046:     jmp     z03_transfer_level_pattern_blocks
                            	  1047: 
