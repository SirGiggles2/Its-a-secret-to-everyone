                            	  5304: CheckState20:
                            	  5305:     ; If major state <> $20, go check other states.
                            	  5306:     ;
02:000486A0 0C000020        	  5307:     cmpi.b  #$20,D0
02:000486A4 6704            	  5308:     beq.s  __far_z_07_0077
02:000486A6 600000B6        	  5309:     jmp  CheckState30
                            	  5310: __far_z_07_0077:
                            	  5311:     ; State $2x. Spark.
                            	  5312:     ;
                            	  5313:     ; Change the state to $28, and decrement animation counter.
                            	  5314:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5315:     ; (with Link, if this is a monster's boomerang).
                            	  5316:     ;
                            	  5317:     ; TODO: Why state $28?
                            	  5318:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5319:     ; start over again when spinning.
                            	  5320:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5321:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5322:     ; any drawing code depends on the minor state.
                            	  5323:     ;
02:000486AA 7028            	  5324:     moveq   #40,D0
02:000486AC 41EC00AC        	  5325:     lea     ($00AC,A4),A0
02:000486B0 11802000        	  5326:     move.b  D0,(A0,D2.W)
02:000486B4 41EC03D0        	  5327:     lea     ($03D0,A4),A0
02:000486B8 53302000        	  5328:     subq.b  #1,(A0,D2.W)
02:000486BC 6702            	  5329:     beq.s  __far_z_07_0078
02:000486BE 6060            	  5330:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5331: __far_z_07_0078:
                            	  5332:     ; Animation counter = 0.
                            	  5333:     ;
                            	  5334:     ; Set state to $40. It will become $50 below in
                            	  5335:     ; HandleArrowOrBoomerangBlocked.
                            	  5336:     ;
02:000486C0 7040            	  5337:     moveq   #64,D0
02:000486C2 41EC00AC        	  5338:     lea     ($00AC,A4),A0
02:000486C6 11802000        	  5339:     move.b  D0,(A0,D2.W)
                            	  5340:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5341:     ; Else go handle the boomerang being blocked.
                            	  5342:     ;
02:000486CA 0C02000D        	  5343:     cmpi.b  #$0D,D2
02:000486CE 640E            	  5344:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:000486D0 41EC034F        	  5345:     lea     ($034F,A4),A0
02:000486D4 10302000        	  5346:     move.b  (A0,D2.W),D0
02:000486D8 0C00005B        	  5347:     cmpi.b  #$5B,D0
02:000486DC 6708            	  5348:     beq  _L_z07_CheckState20_Deactivate
                            	  5349:     even
