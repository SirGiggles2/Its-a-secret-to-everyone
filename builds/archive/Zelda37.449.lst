02:00039A7E 7002            	  3728:     moveq   #2,D0
02:00039A80 19400003        	  3729:     move.b  D0,($0003,A4)
02:00039A84 7044            	  3730:     moveq   #68,D0
02:00039A86 4EB9000310EC    	  3731:     jsr     Anim_WriteSprite
                            	  3732:     ; Check collisions, but never let them interfere with movement.
