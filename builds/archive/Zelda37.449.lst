02:00033728 162C0016        	  2150:     move.b  ($0016,A4),D3
02:0003372C 0C030003        	  2151:     cmpi.b  #$03,D3
02:00033730 6602            	  2152:     bne.s  __far_z_02_0002
02:00033732 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:00033734 41F900033148    	  2157:     lea     (SlotToNameOffset).l,A0
02:0003373A 10303000        	  2158:     move.b  (A0,D3.W),D0
02:0003373E 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:00033742 7400            	  2162:     moveq   #0,D2
02:00033744 41F90003314C    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:0003374A 14303000        	  2164:     move.b  (A0,D3.W),D2
02:0003374E 7602            	  2165:     moveq   #2,D3
                            	  2166:     even
                            	  2167: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
