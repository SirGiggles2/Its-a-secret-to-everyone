02:0003B0F2 10342070        	  6773:     move.b  ($70,A4,D2.W),D0
02:0003B0F6 023C00EE        	  6774:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0FA 123C0008        	  6775:     move.b  #$08,D1
02:0003B0FE D101            	  6776:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B100 19802070        	  6777:     move.b  D0,($70,A4,D2.W)
02:0003B104 532C000F        	  6778:     subq.b  #1,($000F,A4)
02:0003B108 66E2            	  6779:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	  6780:     ; Restore the boss's X coordinate.
                            	  6781:     ;
