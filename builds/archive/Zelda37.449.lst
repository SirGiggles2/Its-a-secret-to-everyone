                            	  2732: _anon_z05_74:
02:0003DEE0 19400002        	  2733:     move.b  D0,($0002,A4)
                            	  2734:     ; Mask A button and directions if inner border is crossed.
                            	  2735:     ;
02:0003DEE4 1003            	  2736:     move.b  D3,D0
02:0003DEE6 1B00            	  2737:     move.b  D0,-(A5)  ; PHA
02:0003DEE8 023C00EE        	  2738:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEEC 123C0008        	  2739:     move.b  #$08,D1
02:0003DEF0 D101            	  2740:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003DEF2 7600            	  2741:     moveq   #0,D3
02:0003DEF4 1600            	  2742:     move.b  D0,D3
02:0003DEF6 103C0080        	  2743:     move.b  #$80,D0
02:0003DEFA 6134            	  2744:     jsr     MaskInputInBorder
02:0003DEFC 101D            	  2745:     move.b  (A5)+,D0  ; PLA
02:0003DEFE 7600            	  2746:     moveq   #0,D3
02:0003DF00 1600            	  2747:     move.b  D0,D3
                            	  2748:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2749:     ; boundary using player's direction and reverse direction index.
                            	  2750:     ;
02:0003DF02 102C0001        	  2751:     move.b  ($0001,A4),D0
02:0003DF06 0C0000FF        	  2752:     cmpi.b  #$FF,D0
