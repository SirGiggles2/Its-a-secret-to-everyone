                            	  5613: _anon_z05_120:
                            	  5614:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5615:     ;
                            	  5616:     ; Shutters and the commands to open a door always change
                            	  5617:     ; tiles.
                            	  5618:     ;
02:0003FD5E 61000130        	  5619:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5620:     even
                            	  5621: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5622:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5623:     ; We need to remember how many tiles need to be copied
                            	  5624:     ; in each transfer record.
                            	  5625:     ;
02:0003FD62 102C0006        	  5626:     move.b  ($0006,A4),D0
02:0003FD66 19400004        	  5627:     move.b  D0,($0004,A4)
                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:0003FD6A 1014            	  5632:     move.b  ($0000,A4),D0
02:0003FD6C 41EC0302        	  5633:     lea     ($0302,A4),A0
02:0003FD70 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:0003FD74 5202            	  5635:     addq.b  #1,D2
02:0003FD76 102C0001        	  5636:     move.b  ($0001,A4),D0
02:0003FD7A 41EC0302        	  5637:     lea     ($0302,A4),A0
02:0003FD7E 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:0003FD82 5202            	  5639:     addq.b  #1,D2
02:0003FD84 102C0006        	  5640:     move.b  ($0006,A4),D0
02:0003FD88 41EC0302        	  5641:     lea     ($0302,A4),A0
02:0003FD8C 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:0003FD90 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:0003FD92 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:0003FD96 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:0003FD98 7020            	  5652:     moveq   #32,D0
02:0003FD9A 122C0001        	  5653:     move.b  ($0001,A4),D1
02:0003FD9E 8001            	  5654:     or.b  D1,D0
02:0003FDA0 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:0003FDA4 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:0003FDA8 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:0003FDAA 103C00FF        	  5664:     move.b  #$FF,D0
02:0003FDAE 41EC0302        	  5665:     lea     ($0302,A4),A0
02:0003FDB2 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:0003FDB6 1002            	  5667:     move.b  D2,D0
02:0003FDB8 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:0003FDBC 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:0003FDC0 102C0054        	  5678:     move.b  ($0054,A4),D0
02:0003FDC4 02000003        	  5679:     andi.b #$03,D0
02:0003FDC8 6708            	  5680:     beq  _anon_z05_122
02:0003FDCA 7008            	  5681:     moveq   #8,D0
02:0003FDCC 19400027        	  5682:     move.b  D0,($0027,A4)
02:0003FDD0 4E75            	  5683:     rts
                            	  5684: 
                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:0003FDD2 102C0054        	  5693:     move.b  ($0054,A4),D0
02:0003FDD6 0C000004        	  5694:     cmpi.b  #$04,D0
02:0003FDDA 6626            	  5695:     bne  _anon_z05_123
02:0003FDDC 7400            	  5696:     moveq   #0,D2
02:0003FDDE 142C0009        	  5697:     move.b  ($0009,A4),D2
02:0003FDE2 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:0003FDE6 102C0055        	  5699:     move.b  ($0055,A4),D0
02:0003FDEA 0A00000F        	  5700:     eori.b #$0F,D0
02:0003FDEE 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:0003FDF2 C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0003FDF4 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:0003FDF8 7000            	  5708:     moveq   #0,D0
02:0003FDFA 19400054        	  5709:     move.b  D0,($0054,A4)
02:0003FDFE 6000FCD4        	  5710:     jmp     LayOutDoors
                            	  5711: 
                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:0003FE02 102C0055        	  5719:     move.b  ($0055,A4),D0
02:0003FE06 19400002        	  5720:     move.b  D0,($0002,A4)
02:0003FE0A 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:0003FE0E 0C000007        	  5722:     cmpi.b  #$07,D0
02:0003FE12 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:0003FE14 7400            	  5728:     moveq   #0,D2
02:0003FE16 142C0009        	  5729:     move.b  ($0009,A4),D2
02:0003FE1A 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:0003FE1E 1003            	  5733:     move.b  D3,D0
02:0003FE20 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FE24 41F90003FCE0    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:0003FE2A 12302000        	  5736:     move.b  (A0,D2.W),D1
02:0003FE2E D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0003FE30 7600            	  5738:     moveq   #0,D3
02:0003FE32 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:0003FE34 1002            	  5742:     move.b  D2,D0
02:0003FE36 0A000001        	  5743:     eori.b #$01,D0
02:0003FE3A 7400            	  5744:     moveq   #0,D2
02:0003FE3C 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:0003FE3E 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:0003FE40 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
02:0003FE44 024100FF        	  5750:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003FE48 E14C            	  5751:     lsl.w   #8,D4
02:0003FE4A 8841            	  5752:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003FE4C 48C4            	  5753:     ext.l   D4
02:0003FE4E D8BC00FF0000    	  5754:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003FE54 2044            	  5755:     movea.l D4,A0
02:0003FE56 10303000        	  5756:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003FE5A 41F900046F2A    	  5757:     lea     (LevelMasks).l,A0
02:0003FE60 12302000        	  5758:     move.b  (A0,D2.W),D1
02:0003FE64 8001            	  5759:     or.b  D1,D0
02:0003FE66 1214            	  5760:     move.b  ($00,A4),D1   ; ptr lo
02:0003FE68 182C0001        	  5761:     move.b  ($01,A4),D4  ; ptr hi
02:0003FE6C 024100FF        	  5762:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003FE70 E14C            	  5763:     lsl.w   #8,D4
02:0003FE72 8841            	  5764:     or.w    D1,D4
02:0003FE74 48C4            	  5765:     ext.l   D4
02:0003FE76 D8BC00FF0000    	  5766:     add.l   #NES_RAM,D4
02:0003FE7C 2044            	  5767:     movea.l D4,A0
02:0003FE7E 11803000        	  5768:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:0003FE82 102C0055        	  5773:     move.b  ($0055,A4),D0
02:0003FE86 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:0003FE8A 8001            	  5775:     or.b  D1,D0
02:0003FE8C 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:0003FE90 102C0055        	  5803:     move.b  ($0055,A4),D0
02:0003FE94 19400002        	  5804:     move.b  D0,($0002,A4)
02:0003FE98 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:0003FE9C 0C000005        	  5806:     cmpi.b  #$05,D0
02:0003FEA0 650C            	  5807:     bcs  _anon_z05_125
02:0003FEA2 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:0003FEA4 7004            	  5809:     moveq   #4,D0
