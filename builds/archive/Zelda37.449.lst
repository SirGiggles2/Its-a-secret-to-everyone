                            	  4575: ; ShootLimited — D2=slot in; ASM returns D3=child slot, C=success.
                            	  4576: ; C side: unsigned int c_shoot_limited(unsigned int slot);
                            	  4577: ;   returns (carry ? 0x100 : 0) | (child_slot & 0xFF) in D0.
                            	  4578:     xref    ShootLimited
                            	  4579: c_shoot_limited:
02:0002CDF6 2F02            	  4580:     move.l  D2,-(SP)        ; preserve D2
02:0002CDF8 2F03            	  4581:     move.l  D3,-(SP)        ; preserve D3 (ASM clobbers it)
02:0002CDFA 242F000C        	  4582:     move.l  12(SP),D2       ; slot arg → D2
02:0002CDFE 4EB90003C20E    	  4583:     jsr     ShootLimited
02:0002CE04 7000            	  4584:     moveq   #0,D0
02:0002CE06 6406            	  4585:     bcc.s   .csl_no_carry
02:0002CE08 008000000100    	  4586:     ori.l   #$100,D0
                            	  4587: .csl_no_carry:
02:0002CE0E 1003            	  4588:     move.b  D3,D0           ; low byte = new child slot
02:0002CE10 261F            	  4589:     move.l  (SP)+,D3
02:0002CE12 241F            	  4590:     move.l  (SP)+,D2
02:0002CE14 4E75            	  4591:     rts
