02:00047E2A 10302000        	  3986:     move.b  (A0,D2.W),D0
02:00047E2E 123C0000        	  3987:     move.b  #$00,D1
02:00047E32 0A3C0010        	  3988:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E36 9101            	  3989:     subx.b  D1,D0   ; SBC #$00
02:00047E38 0A3C0010        	  3990:     eori    #$10,CCR  ; restore X = 6502 C
02:00047E3C 41EC0084        	  3991:     lea     ($0084,A4),A0
02:00047E40 11802000        	  3992:     move.b  D0,(A0,D2.W)
                            	  3993:     even
