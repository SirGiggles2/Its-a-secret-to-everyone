02:00040946 1B00            	  6936:     move.b  D0,-(A5)  ; PHA
                            	  6937:     ; We're dealing with squares.
                            	  6938:     ; So, align the object's X coordinate with 16 pixels.
                            	  6939:     ;
02:00040948 10342070        	  6940:     move.b  ($70,A4,D2.W),D0
02:0004094C 020000F0        	  6941:     andi.b #$F0,D0
                            	  6942:     ; Divide it by 4 to get the offset of the address of the column
                            	  6943:     ; in play area map.
                            	  6944:     ;
                            	  6945:     ; The calculation is: address offset = (X / 8) * 2
                            	  6946:     ; 8 for the width of the column; 2 for the width of the address
                            	  6947:     ;
02:00040950 E208            	  6948:     lsr.b  #1,D0   ; LSR A
02:00040952 E208            	  6949:     lsr.b  #1,D0   ; LSR A
02:00040954 7400            	  6950:     moveq   #0,D2
02:00040956 1400            	  6951:     move.b  D0,D2
                            	  6952:     ; Store the address of the column in [00:01].
                            	  6953:     ;
02:00040958 41F900046AD6    	  6954:     lea     (PlayAreaColumnAddrs).l,A0
02:0004095E 10302000        	  6955:     move.b  (A0,D2.W),D0
