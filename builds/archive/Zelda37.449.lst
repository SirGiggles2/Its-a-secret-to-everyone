02:00048712 123C0010        	  5380:     move.b  #$10,D1
02:00048716 D101            	  5381:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00048718 41EC00AC        	  5382:     lea     ($00AC,A4),A0
02:0004871C 11802000        	  5383:     move.b  D0,(A0,D2.W)
                            	  5384:     even
