                            	  1466: InitMode4:
02:0003D542 7400            	  1467:     moveq   #0,D2
02:0003D544 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003D548 6604            	  1469:     bne.s  __far_z_05_0023
02:0003D54A 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003D54E 5302            	  1472:     subq.b  #1,D2
02:0003D550 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003D552 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003D556 6B06            	  1492:     bmi  _anon_z05_40
02:0003D558 6100348E        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003D55C 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003D55E 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003D562 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
                            	  1502: _L_z05_InitMode4_CheckSub2:
02:0003D564 5302            	  1503:     subq.b  #1,D2
02:0003D566 6702            	  1504:     beq.s  __far_z_05_0024
02:0003D568 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003D56A 7600            	  1509:     moveq   #0,D3
02:0003D56C 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003D570 6100424E        	  1511:     jsr     IsDarkRoom_Bank5
02:0003D574 6702            	  1512:     beq.s  __far_z_05_0025
02:0003D576 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003D578 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003D57C 6100408A        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
                            	  1521:     ; to get room ID offset in that direction.
02:0003D580 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003D584 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003D588 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D58C 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003D58E 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D592 4EB900030A28    	  1527:     jsr     Negate
02:0003D598 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D59C 122C00EB        	  1529:     move.b  ($00EB,A4),D1
02:0003D5A0 D101            	  1530:     addx.b  D1,D0   ; ADC RoomId
02:0003D5A2 7600            	  1531:     moveq   #0,D3
02:0003D5A4 1600            	  1532:     move.b  D0,D3
02:0003D5A6 61004218        	  1533:     jsr     IsDarkRoom_Bank5
02:0003D5AA 6602            	  1534:     bne.s  __far_z_05_0026
02:0003D5AC 601C            	  1535:     jmp  InitMode4_GoToSub0
                            	  1536: __far_z_05_0026:
                            	  1537:     ; The previous room was dark.
                            	  1538:     ;
02:0003D5AE 102C051F        	  1539:     move.b  ($051F,A4),D0
02:0003D5B2 6702            	  1540:     beq.s  __far_z_05_0027
02:0003D5B4 6014            	  1541:     jmp  InitMode4_GoToSub0
                            	  1542: __far_z_05_0027:
02:0003D5B6 103C00C0        	  1543:     move.b  #$C0,D0
                            	  1544: ; Params:
                            	  1545: ; A: start index of cycle
                            	  1546: ;
                            	  1547:     even
                            	  1548: SetFadeCycleAndAdvanceSubmode:
02:0003D5BA 4EF90002C03C    	  1549:     jmp     c_set_fade_cycle_advance_submode
                            	  1550: 
                            	  1551: _anon_z05_41:
02:0003D5C0 4E75            	  1552:     rts
                            	  1553: 
                            	  1554:     even
                            	  1555: InitMode4_Sub3:
                            	  1556:     ; Submode 3.
                            	  1557:     ;
02:0003D5C2 4EB900030B76    	  1558:     jsr     AnimateWorldFading
02:0003D5C8 66F6            	  1559:     bne  _anon_z05_41
                            	  1560:     even
                            	  1561: InitMode4_GoToSub0:
02:0003D5CA 4EF90002B9E8    	  1562:     jmp     c_init_mode4_go_to_sub0
                            	  1563: 
                            	  1564: InitMode_EnterRoom:
02:0003D5D0 4EB9000474F0    	  1565:     jsr     DrawSpritesBetweenRooms
02:0003D5D6 4EB90004750E    	  1566:     jsr     ResetPlayerState
                            	  1567:     ; Reset [0300] to [051F].
                            	  1568:     ;
02:0003D5DC 7005            	  1569:     moveq   #5,D0
02:0003D5DE 761F            	  1570:     moveq   #31,D3
02:0003D5E0 4EB900046DD0    	  1571:     jsr     ClearRam0300UpTo
                            	  1572:     ; Reset door trigger info.
                            	  1573:     ;
02:0003D5E6 7000            	  1574:     moveq   #0,D0
02:0003D5E8 19400054        	  1575:     move.b  D0,($0054,A4)
02:0003D5EC 19400055        	  1576:     move.b  D0,($0055,A4)
                            	  1577:     ; Store level block attribute byte F for convenience.
                            	  1578:     ;
02:0003D5F0 7600            	  1579:     moveq   #0,D3
02:0003D5F2 162C00EB        	  1580:     move.b  ($00EB,A4),D3
02:0003D5F6 41F900FF6AFE    	  1581:     lea     (NES_SRAM+$0AFE).l,A0
02:0003D5FC 10303000        	  1582:     move.b  (A0,D3.W),D0
02:0003D600 194004CD        	  1583:     move.b  D0,($04CD,A4)
02:0003D604 610038A2        	  1584:     jsr     ResetInvObjState
                            	  1585:     ; There's more than one way to enter a room.
                            	  1586:     ;
                            	  1587:     ; 1: Out of a cave, dungeon, or cellar
                            	  1588:     ;     a. Walking exit
                            	  1589:     ;     b. Next to stairs
                            	  1590:     ; 2: Room to room
                            	  1591:     ;
                            	  1592:     ; Determine which one we need.
                            	  1593:     ;
02:0003D608 102C005A        	  1594:     move.b  ($005A,A4),D0
02:0003D60C 6770            	  1595:     beq  _L_z05_InitMode_EnterRoom_Method2
02:0003D60E 102C0010        	  1596:     move.b  ($0010,A4),D0
02:0003D612 665C            	  1597:     bne  _anon_z05_42
                            	  1598:     ; Enter method 1.
                            	  1599:     ;
                            	  1600:     ; Set up Link's exit from underground.
                            	  1601:     ;
02:0003D614 7600            	  1602:     moveq   #0,D3
02:0003D616 162C00EB        	  1603:     move.b  ($00EB,A4),D3
02:0003D61A 41F900FF687E    	  1604:     lea     (NES_SRAM+$087E).l,A0
02:0003D620 10303000        	  1605:     move.b  (A0,D3.W),D0
02:0003D624 020000F0        	  1606:     andi.b #$F0,D0
02:0003D628 19400070        	  1607:     move.b  D0,($0070,A4)
02:0003D62C 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:0003D632 10303000        	  1609:     move.b  (A0,D3.W),D0
02:0003D636 02000007        	  1610:     andi.b #$07,D0
02:0003D63A E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:0003D63C E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:0003D63E E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:0003D640 E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
                            	  1616:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:0003D642 123C004D        	  1617:     move.b  #$4D,D1
02:0003D646 D101            	  1618:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:0003D648 19400084        	  1619:     move.b  D0,($0084,A4)
                            	  1620:     ; If the player didn't step on a cave entrance to go underground,
                            	  1621:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1622:     ;
02:0003D64C 7600            	  1623:     moveq   #0,D3
02:0003D64E 162C0065        	  1624:     move.b  ($0065,A4),D3
02:0003D652 0C030024        	  1625:     cmpi.b  #$24,D3
02:0003D656 6618            	  1626:     bne  _anon_z05_42
                            	  1627:     ; Enter method 1-a.
                            	  1628:     ;
                            	  1629:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1630:     ;
02:0003D658 19400412        	  1631:     move.b  D0,($0412,A4)
02:0003D65C 023C00EE        	  1632:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D660 123C0010        	  1633:     move.b  #$10,D1
02:0003D664 D101            	  1634:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D666 19400084        	  1635:     move.b  D0,($0084,A4)
02:0003D66A 7008            	  1636:     moveq   #8,D0
02:0003D66C 19400603        	  1637:     move.b  D0,($0603,A4)
                            	  1638: _anon_z05_42:
                            	  1639:     ; This part is the same no matter if the player went
                            	  1640:     ; underground by stairs or a cave entrance.
                            	  1641:     ;
02:0003D670 7004            	  1642:     moveq   #4,D0
02:0003D672 19400098        	  1643:     move.b  D0,($0098,A4)
02:0003D676 7000            	  1644:     moveq   #0,D0
02:0003D678 19400053        	  1645:     move.b  D0,($0053,A4)
02:0003D67C 6064            	  1646:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1647: 
                            	  1648:     even
                            	  1649: _L_z05_InitMode_EnterRoom_Method2:
                            	  1650:     ; Enter method 2.
                            	  1651:     ; Room to room.
                            	  1652:     ;
                            	  1653:     ; Get the direction that the player is entering from.
                            	  1654:     ;
02:0003D67E 102C0098        	  1655:     move.b  ($0098,A4),D0
02:0003D682 19400053        	  1656:     move.b  D0,($0053,A4)
