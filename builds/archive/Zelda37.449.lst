02:0003BA92 7002            	  8051:     moveq   #2,D0
02:0003BA94 19400601        	  8052:     move.b  D0,($0601,A4)
                            	  8053: _anon_z04_160:
02:0003BA98 0A3C0001        	  8054:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BA9C 4E75            	  8055:     rts
                            	  8056: 
                            	  8057: ; Description:
                            	  8058: ; Lift up the Triforce of Courage while the room is light.
                            	  8059: ;
                            	  8060: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8061: ;
                            	  8062:     even
                            	  8063: Ganon_ScenePhase1:
02:0003BA9E 701B            	  8064:     moveq   #27,D0
02:0003BAA0 19400505        	  8065:     move.b  D0,($0505,A4)
                            	  8066:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8067:     ;
02:0003BAA4 102C0028        	  8068:     move.b  ($0028,A4),D0
02:0003BAA8 6702            	  8069:     beq.s  __far_z_04_0089
02:0003BAAA 6012            	  8070:     jmp  Ganon_DrawBodyFrame0
                            	  8071: __far_z_04_0089:
                            	  8072:     ; Once the timer expires:
                            	  8073:     ; 1. unhalt Link
                            	  8074:     ; 2. clear the item to lift
                            	  8075:     ; 3. play level 9 song
