02:0003BCEC 6100FF7E        	  8402:     jsr     Ganon_DrawCloud
02:0003BCF0 6100009A        	  8403:     jsr     Ganon_GetCurCloudBottom
02:0003BCF4 6100FF76        	  8404:     jsr     Ganon_DrawCloud
                            	  8405:     ; Draw the left and right clouds.
