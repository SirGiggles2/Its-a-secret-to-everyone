02:0003507E 102C00FC        	  4665:     move.b  ($00FC,A4),D0
02:00035082 41F900034FF6    	  4666:     lea     (CreditsLastVscrollList).l,A0
02:00035088 12303000        	  4667:     move.b  (A0,D3.W),D1
02:0003508C B001            	  4668:     cmp.b   D1,D0
02:0003508E 650A            	  4669:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4670:     ; But if we have, then go to the next submode, and set a timer
