                            	  8441: _anon_z04_164:
02:0003BD38 4EB90004906C    	  8442:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8443:     ; The frame counter will make the sprite flash.
                            	  8444:     ; The array has the horizontal and vertical flipping attributes.
                            	  8445:     ; Combine them into [03].
                            	  8446:     ;
02:0003BD3E 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0003BD42 02000003        	  8448:     andi.b #$03,D0
02:0003BD46 41F90003BC16    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BD4C 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BD50 8001            	  8451:     or.b  D1,D0
02:0003BD52 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BD56 41F90003BC20    	  8453:     lea     (GanonBurstTiles).l,A0
