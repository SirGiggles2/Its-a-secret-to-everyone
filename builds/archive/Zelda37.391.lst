                            	  4300: __far_z_04_0032:
                            	  4301:     even
                            	  4302: Moldorm_ChangeFlyingState:
                            	  4303:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  4304:     ;
02:00039F7A 61000096        	  4305:     jsr     Flyer_MoldormDecideState
02:00039F7E 7010            	  4306:     moveq   #16,D0
02:00039F80 19802028        	  4307:     move.b  D0,($28,A4,D2.W)
                            	  4308:     ; If the next lower slot's direction <> 0, then
                            	  4309:     ; go propagate direction changes down the chain.
                            	  4310:     ;
                            	  4311:     ; But you had to have propagated directions once for the
                            	  4312:     ; next lower direction to be set. How does it happen?
                            	  4313:     ;
                            	  4314:     ; Within a flyer state, the flying routines turn the flyer
                            	  4315:     ; and set the object timer to $10 several times. After any of
                            	  4316:     ; those times will the test succeed.
                            	  4317:     ;
                            	  4318:     ; When a flying state ends, timer will be 0, triggering the code
                            	  4319:     ; in this block to set the timer to $10, and try to propagate
                            	  4320:     ; directions.
                            	  4321:     ;
                            	  4322:     ; But this is also the case the first time here.
                            	  4323:     ;
                            	  4324:     ; So, I believe that the point of this test is to delay moving
                            	  4325:     ; the lower (not head) segments when starting out.
                            	  4326:     ;
02:00039F84 41EC0097        	  4327:     lea     ($0097,A4),A0
02:00039F88 10302000        	  4328:     move.b  (A0,D2.W),D0
02:00039F8C 6702            	  4329:     beq.s  __far_z_04_0033
02:00039F8E 601C            	  4330:     jmp  Moldorm_PropagateDirs
                            	  4331: __far_z_04_0033:
02:00039F90 4E75            	  4332:     rts
                            	  4333: 
                            	  4334:     even
                            	  4335: Moldorm_Wander:
                            	  4336:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  4337:     ; Only the head controls the movement direction.
                            	  4338:     ;
02:00039F92 0C020005        	  4339:     cmpi.b  #$05,D2
02:00039F96 6708            	  4340:     beq  _anon_z04_82
02:00039F98 0C02000A        	  4341:     cmpi.b  #$0A,D2
02:00039F9C 6702            	  4342:     beq.s  __far_z_04_0034
02:00039F9E 6070            	  4343:     jmp  L1156B_Exit
                            	  4344: __far_z_04_0034:
                            	  4345: _anon_z04_82:
                            	  4346:     ; Turn randomly while flying, as usual.
                            	  4347:     ;
02:00039FA0 61002D24        	  4348:     jsr     Flyer_Wander
                            	  4349:     ; After every turn, the common flyer routines set timer to $10.
                            	  4350:     ; This can be used as a signal for moldorm to propagate
                            	  4351:     ; direction changes down the chain.
                            	  4352:     ;
                            	  4353:     ; Between each turn, timer <> $10.
                            	  4354:     ;
                            	  4355:     ; At the end of the delay after the last turn, timer = 0.
                            	  4356:     ; This is a signal that that flying state ended, and a new one
                            	  4357:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  4358:     ; we can propagate direction changes again; and start
                            	  4359:     ; a new flying interval by setting timer to $10. This will make
                            	  4360:     ; the next flying state delay that amount of time before turning
                            	  4361:     ; the first time.
                            	  4362:     ;
                            	  4363:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  4364:     ; arm the timer again, and shift directions down the chain.
                            	  4365:     ;
02:00039FA4 10342028        	  4366:     move.b  ($28,A4,D2.W),D0
02:00039FA8 6602            	  4367:     bne.s  __far_z_04_0035
02:00039FAA 60CE            	  4368:     jmp  Moldorm_ChangeFlyingState
                            	  4369: __far_z_04_0035:
                            	  4370:     even
                            	  4371: Moldorm_PropagateDirs:
                            	  4372:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  4373:     ;
02:00039FAC 10342028        	  4374:     move.b  ($28,A4,D2.W),D0
02:00039FB0 0C000010        	  4375:     cmpi.b  #$10,D0
02:00039FB4 6702            	  4376:     beq.s  __far_z_04_0036
02:00039FB6 6058            	  4377:     jmp  L1156B_Exit
                            	  4378: __far_z_04_0036:
                            	  4379:     ; Timer = $10.
                            	  4380:     ;
                            	  4381:     ; If deferred bounce direction <> 0, then
                            	  4382:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  4383:     ;
02:00039FB8 41EC03BC        	  4384:     lea     ($03BC,A4),A0
02:00039FBC 10302000        	  4385:     move.b  (A0,D2.W),D0
02:00039FC0 6712            	  4386:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:00039FC2 41EC0098        	  4387:     lea     ($0098,A4),A0
02:00039FC6 11802000        	  4388:     move.b  D0,(A0,D2.W)
02:00039FCA 7000            	  4389:     moveq   #0,D0
02:00039FCC 41EC03BC        	  4390:     lea     ($03BC,A4),A0
