                            	  1740: Jumper_MoveY:
02:00038D00 1880            	  1741:     move.b  D0,($0000,A4)
02:00038D02 19430002        	  1742:     move.b  D3,($0002,A4)
                            	  1743:     ; Add the high speed byte to the Y coordinate.
                            	  1744:     ;
02:00038D06 41EC0412        	  1745:     lea     ($0412,A4),A0
02:00038D0A 10302000        	  1746:     move.b  (A0,D2.W),D0
02:00038D0E 41EC0084        	  1747:     lea     ($0084,A4),A0
02:00038D12 12302000        	  1748:     move.b  (A0,D2.W),D1
02:00038D16 D101            	  1749:     addx.b  D1,D0   ; ADC ObjY,X
02:00038D18 41EC0084        	  1750:     lea     ($0084,A4),A0
02:00038D1C 11802000        	  1751:     move.b  D0,(A0,D2.W)
                            	  1752:     ; Add the acceleration to the speed fraction (low byte).
                            	  1753:     ;
02:00038D20 41EC041F        	  1754:     lea     ($041F,A4),A0
02:00038D24 10302000        	  1755:     move.b  (A0,D2.W),D0
02:00038D28 023C00EE        	  1756:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D2C 1214            	  1757:     move.b  ($0000,A4),D1
02:00038D2E D101            	  1758:     addx.b  D1,D0   ; ADC $00
02:00038D30 41EC041F        	  1759:     lea     ($041F,A4),A0
02:00038D34 11802000        	  1760:     move.b  D0,(A0,D2.W)
                            	  1761:     ; Carry over to the high speed byte.
                            	  1762:     ;
02:00038D38 41EC0412        	  1763:     lea     ($0412,A4),A0
02:00038D3C 10302000        	  1764:     move.b  (A0,D2.W),D0
02:00038D40 123C0000        	  1765:     move.b  #$00,D1
02:00038D44 D101            	  1766:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00038D46 41EC0412        	  1767:     lea     ($0412,A4),A0
02:00038D4A 11802000        	  1768:     move.b  D0,(A0,D2.W)
                            	  1769:     ; *Signed comparison*:
                            	  1770:     ; If the high speed byte < high max speed byte, then return.
                            	  1771:     ;
                            	  1772:     ; Note that this is not a general purpose signed comparison,
                            	  1773:     ; which would be more complicated. But it works because
                            	  1774:     ; the deviation from 0 of both values is small.
                            	  1775:     ;
02:00038D4E 122C0002        	  1776:     move.b  ($0002,A4),D1
02:00038D52 B001            	  1777:     cmp.b   D1,D0
02:00038D54 6A02            	  1778:     bpl.s  __far_z_04_0017
02:00038D56 6022            	  1779:     jmp  L10A52_Exit
