02:0002F3D0 2044            	   757:     movea.l D4,A0
02:0002F3D2 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F3D6 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002F3DA 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
02:0002F3DE 024100FF        	   761:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F3E2 E14C            	   762:     lsl.w   #8,D4
02:0002F3E4 8841            	   763:     or.w    D1,D4
02:0002F3E6 48C4            	   764:     ext.l   D4
