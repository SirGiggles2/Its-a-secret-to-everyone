                            	  3361:     ; If > $10, go put the ladder away.
                            	  3362:     ;
02:0003EB94 4EB9000308F0    	  3363:     jsr     Abs
02:0003EB9A 1880            	  3364:     move.b  D0,($0000,A4)
02:0003EB9C 0C000010        	  3365:     cmpi.b  #$10,D0
02:0003EBA0 6532            	  3366:     bcs  _L_z05_CheckLadder_SetState2
02:0003EBA2 0C000010        	  3367:     cmpi.b  #$10,D0
02:0003EBA6 661E            	  3368:     bne  _L_z05_CheckLadder_StashLadder
                            	  3369:     ; Distance = $10. If player's not facing in the same direction as
                            	  3370:     ; the ladder, go put away the ladder.
                            	  3371:     ;
02:0003EBA8 102C0098        	  3372:     move.b  ($0098,A4),D0
02:0003EBAC 41EC0098        	  3373:     lea     ($0098,A4),A0
02:0003EBB0 12302000        	  3374:     move.b  (A0,D2.W),D1
02:0003EBB4 B001            	  3375:     cmp.b   D1,D0
02:0003EBB6 660E            	  3376:     bne  _L_z05_CheckLadder_StashLadder
                            	  3377:     ; Distance = $10, and player's facing in the same direction.
                            	  3378:     ;
                            	  3379:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3380:     ; ladder and had not stepped onto it yet.
                            	  3381:     ; Go handle movement on it, but don't change state yet.
                            	  3382:     ;
                            	  3383:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3384:     ; off of the ladder. So the ladder should be put away. In this
                            	  3385:     ; case, fall thru.
                            	  3386:     ;
02:0003EBB8 41EC00AC        	  3387:     lea     ($00AC,A4),A0
02:0003EBBC 10302000        	  3388:     move.b  (A0,D2.W),D0
02:0003EBC0 0C000001        	  3389:     cmpi.b  #$01,D0
02:0003EBC4 6718            	  3390:     beq  _L_z05_CheckLadder_HandleInput
                            	  3391:     even
                            	  3392: _L_z05_CheckLadder_StashLadder:
                            	  3393:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3394:     ;
02:0003EBC6 7000            	  3395:     moveq   #0,D0
02:0003EBC8 19400064        	  3396:     move.b  D0,($0064,A4)
02:0003EBCC 4EB90004A430    	  3397:     jsr     DestroyMonster
                            	  3398:     even
                            	  3399: _L_z05_CheckLadder_Exit:
02:0003EBD2 4E75            	  3400:     rts
                            	  3401: 
                            	  3402:     even
                            	  3403: _L_z05_CheckLadder_SetState2:
                            	  3404:     ;  Set state 2, because we're on the ladder.
                            	  3405:     ;
02:0003EBD4 7002            	  3406:     moveq   #2,D0
02:0003EBD6 41EC00AC        	  3407:     lea     ($00AC,A4),A0
02:0003EBDA 11802000        	  3408:     move.b  D0,(A0,D2.W)
                            	  3409:     even
                            	  3410: _L_z05_CheckLadder_HandleInput:
                            	  3411:     ; If input direction = 0, go draw and reset moving direction.
                            	  3412:     ;
02:0003EBDE 102C03F8        	  3413:     move.b  ($03F8,A4),D0
02:0003EBE2 67000086        	  3414:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3415:     ; Input direction <> 0. The player intends to move.
                            	  3416:     ; So, see if we need to override the moving direction.
                            	  3417:     ;
                            	  3418:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3419:     ; go draw and set moving direction to Link's direction.
                            	  3420:     ;
                            	  3421:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3422:     ; been blocked by the water.
                            	  3423:     ;
                            	  3424:     ; Or, Link already passed over the point right over the ladder
                            	  3425:     ; and was allowed to move onto the tiles after the ladder.
                            	  3426:     ;
02:0003EBE6 102C0098        	  3427:     move.b  ($0098,A4),D0
02:0003EBEA 7600            	  3428:     moveq   #0,D3
02:0003EBEC 1614            	  3429:     move.b  ($0000,A4),D3
02:0003EBEE 670C            	  3430:     beq  _anon_z05_86
02:0003EBF0 41EC0098        	  3431:     lea     ($0098,A4),A0
02:0003EBF4 12302000        	  3432:     move.b  (A0,D2.W),D1
02:0003EBF8 B001            	  3433:     cmp.b   D1,D0
02:0003EBFA 676E            	  3434:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3435: _anon_z05_86:
                            	  3436:     ; Distance = 0, or facing different directions.
                            	  3437:     ;
                            	  3438:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3439:     ; then go draw and keep moving.
                            	  3440:     ;
                            	  3441:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3442:     ;
                            	  3443:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3444:     ; to move onto the tiles after the ladder.
                            	  3445:     ;
                            	  3446:     ; Note that if Link is not moving, then this test will fail,
                            	  3447:     ; and case (D) will catch it.
                            	  3448:     ;
02:0003EBFC 41EC0098        	  3449:     lea     ($0098,A4),A0
02:0003EC00 10302000        	  3450:     move.b  (A0,D2.W),D0
02:0003EC04 122C000F        	  3451:     move.b  ($000F,A4),D1
02:0003EC08 B001            	  3452:     cmp.b   D1,D0
02:0003EC0A 675E            	  3453:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3454:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3455:     ; then go draw and move in ladder's direction.
                            	  3456:     ;
                            	  3457:     ; You can always step off the ladder where you came from.
                            	  3458:     ;
02:0003EC0C 4EB9000308EC    	  3459:     jsr     GetOppositeDir
02:0003EC12 122C0098        	  3460:     move.b  ($0098,A4),D1
02:0003EC16 B001            	  3461:     cmp.b   D1,D0
02:0003EC18 6750            	  3462:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3463:     ; D. If opposite of ladder's direction <> down,
                            	  3464:     ; or input direction <> up,
                            	  3465:     ; then go reset moving direction, and draw.
                            	  3466:     ;
                            	  3467:     ; This will catch all cases of Link facing perpendicular to
                            	  3468:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3469:     ; ladder direction is up and input direction is up (E).
                            	  3470:     ;
02:0003EC1A 0C000004        	  3471:     cmpi.b  #$04,D0
02:0003EC1E 6648            	  3472:     bne  _anon_z05_87
02:0003EC20 102C03F8        	  3473:     move.b  ($03F8,A4),D0
02:0003EC24 0C000008        	  3474:     cmpi.b  #$08,D0
02:0003EC28 663E            	  3475:     bne  _anon_z05_87
                            	  3476:     ; E. The ladder's direction is up and input direction is up.
                            	  3477:     ;
                            	  3478:     ; An earlier call to check tile collision would have blocked
                            	  3479:     ; movement, because the tile under Link's top half is a water tile.
                            	  3480:     ; But because Link is squarely on the ladder, we really have
                            	  3481:     ; to check the tile above that one.
                            	  3482:     ;
                            	  3483:     ; Set moving direction to input direction (up) and switch X to
                            	  3484:     ; the player's slot for the purpose of checking tile collision below.
                            	  3485:     ; Based on that, we'll set moving direction according to walkability.
                            	  3486:     ;
02:0003EC2A 6158            	  3487:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3488:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3489:     ;
02:0003EC2C 102C0084        	  3490:     move.b  ($0084,A4),D0
02:0003EC30 1B00            	  3491:     move.b  D0,-(A5)  ; PHA
02:0003EC32 003C0011        	  3492:     ori     #$11,CCR  ; SEC: set C+X
02:0003EC36 123C0008        	  3493:     move.b  #$08,D1
02:0003EC3A 0A3C0010        	  3494:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EC3E 9101            	  3495:     subx.b  D1,D0   ; SBC #$08
02:0003EC40 0A3C0010        	  3496:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EC44 19400084        	  3497:     move.b  D0,($0084,A4)
02:0003EC48 4EB90004859C    	  3498:     jsr     GetCollidingTileMoving
02:0003EC4E 101D            	  3499:     move.b  (A5)+,D0  ; PLA
02:0003EC50 19400084        	  3500:     move.b  D0,($0084,A4)
                            	  3501:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3502:     ; direction as the input direction (in a roundabout way).
                            	  3503:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3504:     ;
02:0003EC54 102C000F        	  3505:     move.b  ($000F,A4),D0
02:0003EC58 7600            	  3506:     moveq   #0,D3
02:0003EC5A 162C049E        	  3507:     move.b  ($049E,A4),D3
02:0003EC5E 122C034A        	  3508:     move.b  ($034A,A4),D1
02:0003EC62 B601            	  3509:     cmp.b   D1,D3
02:0003EC64 6500FF78        	  3510:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3511: _anon_z05_87:
                            	  3512:     ; Set A to reset moving direction in [0F].
                            	  3513:     ;
02:0003EC68 7000            	  3514:     moveq   #0,D0
                            	  3515:     even
                            	  3516: _L_z05_CheckLadder_DrawLadder:
                            	  3517:     ; Draw the ladder.
                            	  3518:     ;
02:0003EC6A 1B00            	  3519:     move.b  D0,-(A5)  ; PHA
02:0003EC6C 7400            	  3520:     moveq   #0,D2
02:0003EC6E 142C0064        	  3521:     move.b  ($0064,A4),D2
02:0003EC72 4EB900049C54    	  3522:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003EC78 760C            	  3523:     moveq   #12,D3
02:0003EC7A 7000            	  3524:     moveq   #0,D0
02:0003EC7C 4EB900030EC0    	  3525:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0003EC82 101D            	  3526:     move.b  (A5)+,D0  ; PLA
                            	  3527: ; Params:
                            	  3528: ; A: direction
                            	  3529: ;
                            	  3530: ; Returns:
                            	  3531: ; [0F]: direction
                            	  3532: ;
                            	  3533:     even
                            	  3534: SetMovingDirAndSwitchToPlayerSlot:
02:0003EC84 4EF90002C046    	  3535:     jmp     c_set_moving_dir_switch_player
                            	  3536: 
                            	  3537: FindNextEdgeSpawnCell:
                            	  3538:     ; Load [0A] with the value before the call.
                            	  3539:     ;
02:0003EC8A 102C0525        	  3540:     move.b  ($0525,A4),D0
02:0003EC8E 1940000A        	  3541:     move.b  D0,($000A,A4)
                            	  3542:     even
                            	  3543: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3544:     ; Loop to look for a place to spawn a monster from the edge
                            	  3545:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3546:     ;
                            	  3547:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3548:     ; We'll move down $10 pixels.
                            	  3549:     ;
02:0003EC92 7610            	  3550:     moveq   #16,D3
02:0003EC94 102C000A        	  3551:     move.b  ($000A,A4),D0
02:0003EC98 0200000F        	  3552:     andi.b #$0F,D0
02:0003EC9C 670A            	  3553:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3554:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3555:     ; Don't move vertically.
                            	  3556:     ;
02:0003EC9E 163C00F0        	  3557:     move.b  #$F0,D3
02:0003ECA2 0C00000F        	  3558:     cmpi.b  #$0F,D0
02:0003ECA6 6610            	  3559:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3560:     even
                            	  3561: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3562:     ; Else low nibble = $F. We're at the right edge,
                            	  3563:     ; and we'll move up $10 pixels.
                            	  3564:     ;
02:0003ECA8 1003            	  3565:     move.b  D3,D0
02:0003ECAA 023C00EE        	  3566:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ECAE 122C000A        	  3567:     move.b  ($000A,A4),D1
02:0003ECB2 D101            	  3568:     addx.b  D1,D0   ; ADC $0A
02:0003ECB4 1940000A        	  3569:     move.b  D0,($000A,A4)
                            	  3570:     even
                            	  3571: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3572:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3573:     ; Move right one pixel.
                            	  3574:     ;
02:0003ECB8 102C000A        	  3575:     move.b  ($000A,A4),D0
02:0003ECBC 020000F0        	  3576:     andi.b #$F0,D0
02:0003ECC0 0C0000E0        	  3577:     cmpi.b  #$E0,D0
02:0003ECC4 6606            	  3578:     bne  _anon_z05_88
02:0003ECC6 522C000A        	  3579:     addq.b  #1,($000A,A4)
02:0003ECCA 600A            	  3580:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3581: 
                            	  3582: _anon_z05_88:
                            	  3583:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3584:     ; Dont' move horizontally.
                            	  3585:     ;
02:0003ECCC 0C000040        	  3586:     cmpi.b  #$40,D0
02:0003ECD0 6604            	  3587:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3588:     ; Else high nibble = 4. We're at the top edge.
                            	  3589:     ; Move left 1 pixel.
                            	  3590:     ;
02:0003ECD2 532C000A        	  3591:     subq.b  #1,($000A,A4)
                            	  3592:     even
                            	  3593: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3594:     ; Time to get the address of the column.
                            	  3595:     ; Starting at the top of the leftmost column.
                            	  3596:     ;
02:0003ECD6 61002698        	  3597:     jsr     FetchTileMapAddr
02:0003ECDA 7005            	  3598:     moveq   #5,D0
02:0003ECDC 4EB90002A9FA    	  3599:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3600:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3601:     ; in order to point to the column we want.
                            	  3602:     ;
02:0003ECE2 102C000A        	  3603:     move.b  ($000A,A4),D0
02:0003ECE6 0200000F        	  3604:     andi.b #$0F,D0
02:0003ECEA 7600            	  3605:     moveq   #0,D3
02:0003ECEC 1600            	  3606:     move.b  D0,D3
02:0003ECEE 670C            	  3607:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3608: _anon_z05_89:
02:0003ECF0 702C            	  3609:     moveq   #44,D0
02:0003ECF2 4EB900030970    	  3610:     jsr     AddToInt16At0
02:0003ECF8 5303            	  3611:     subq.b  #1,D3
02:0003ECFA 66F4            	  3612:     bne  _anon_z05_89
                            	  3613:     even
                            	  3614: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3615:     ; Turn the row part of [0A] into a tile index.
                            	  3616:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3617:     ;
02:0003ECFC 102C000A        	  3618:     move.b  ($000A,A4),D0
02:0003ED00 020000F0        	  3619:     andi.b #$F0,D0
02:0003ED04 003C0011        	  3620:     ori     #$11,CCR  ; SEC: set C+X
02:0003ED08 123C0040        	  3621:     move.b  #$40,D1
02:0003ED0C 0A3C0010        	  3622:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ED10 9101            	  3623:     subx.b  D1,D0   ; SBC #$40
02:0003ED12 0A3C0010        	  3624:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ED16 E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003ED18 E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003ED1A E208            	  3627:     lsr.b  #1,D0   ; LSR A
02:0003ED1C 7600            	  3628:     moveq   #0,D3
02:0003ED1E 1600            	  3629:     move.b  D0,D3
                            	  3630:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3631:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3632:     ; when coming in from the edges.
                            	  3633:     ;
02:0003ED20 1214            	  3634:     move.b  ($00,A4),D1   ; ptr lo
02:0003ED22 182C0001        	  3635:     move.b  ($01,A4),D4  ; ptr hi
02:0003ED26 024100FF        	  3636:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003ED2A E14C            	  3637:     lsl.w   #8,D4
02:0003ED2C 8841            	  3638:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003ED2E 48C4            	  3639:     ext.l   D4
02:0003ED30 D8BC00FF0000    	  3640:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003ED36 2044            	  3641:     movea.l D4,A0
02:0003ED38 10303000        	  3642:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003ED3C 0C000084        	  3643:     cmpi.b  #$84,D0
02:0003ED40 650E            	  3644:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3645:     ; Bottom of the loop.
                            	  3646:     ; If you reach the original cell, then stop.
                            	  3647:     ;
02:0003ED42 102C000A        	  3648:     move.b  ($000A,A4),D0
02:0003ED46 122C0525        	  3649:     move.b  ($0525,A4),D1
02:0003ED4A B001            	  3650:     cmp.b   D1,D0
02:0003ED4C 6600FF44        	  3651:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3652:     even
                            	  3653: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3654:     ; Set the spawn cell to the one we found.
                            	  3655:     ;
02:0003ED50 102C000A        	  3656:     move.b  ($000A,A4),D0
02:0003ED54 19400525        	  3657:     move.b  D0,($0525,A4)
02:0003ED58 4E75            	  3658:     rts
                            	  3659: 
                            	  3660:     even
