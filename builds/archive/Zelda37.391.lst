                            	  1710: 
                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002A9DA 0000E9DA        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002A9DE 000129DA
02:0002A9E2 000169DA        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002A9E6 0001A9DA
02:0002A9EA 0001E9DA        	  1715:     dc.l    _nes_bank_04_data, _nes_bank_05_data
02:0002A9EE 000229DA
