02:0003C1E0 0003C1EC        	  8878:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C1E4 0003C24E        	  8879:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C1E8 0003C27C        	  8880:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  8881: 
                            	  8882: ; Description:
                            	  8883: ; Lift up the Triforce of Courage while the room is dark.
                            	  8884: ;
                            	  8885: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8886: ;
                            	  8887:     even
                            	  8888: Ganon_ScenePhase0:
02:0003C1EC 701B            	  8889:     moveq   #27,D0
02:0003C1EE 19400505        	  8890:     move.b  D0,($0505,A4)
                            	  8891:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8892:     ;
02:0003C1F2 102C0028        	  8893:     move.b  ($0028,A4),D0
02:0003C1F6 6644            	  8894:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8895:     ; Once the timer expires, it's time to brighten the room.
                            	  8896:     ;
                            	  8897:     ; Save the current object slot.
02:0003C1F8 1002            	  8898:     move.b  D2,D0
02:0003C1FA 1B00            	  8899:     move.b  D0,-(A5)  ; PHA
02:0003C1FC 610007F0        	  8900:     jsr     UpdateCandle
02:0003C200 101D            	  8901:     move.b  (A5)+,D0  ; PLA
02:0003C202 7400            	  8902:     moveq   #0,D2
02:0003C204 1400            	  8903:     move.b  D0,D2
                            	  8904:     ; Turn off the room brightening flag, because we're controlling it
                            	  8905:     ; here instead of in the Mode 5 object update loop.
                            	  8906:     ;
02:0003C206 7000            	  8907:     moveq   #0,D0
02:0003C208 1940051E        	  8908:     move.b  D0,($051E,A4)
                            	  8909:     ; On the first frame of the fade-to-light cycle, play the
                            	  8910:     ; Triforce/Ganon song.
                            	  8911:     ;
02:0003C20C 102C051C        	  8912:     move.b  ($051C,A4),D0
02:0003C210 0C0000C0        	  8913:     cmpi.b  #$C0,D0
02:0003C214 6606            	  8914:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003C216 7002            	  8915:     moveq   #2,D0
02:0003C218 19400600        	  8916:     move.b  D0,($0600,A4)
