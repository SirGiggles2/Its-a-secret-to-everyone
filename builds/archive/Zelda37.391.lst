02:0003B71A D101            	  7482:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B71C 19802070        	  7483:     move.b  D0,($70,A4,D2.W)
02:0003B720 532C000F        	  7484:     subq.b  #1,($000F,A4)
