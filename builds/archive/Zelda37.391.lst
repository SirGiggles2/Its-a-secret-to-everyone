02:0004034D 65              	  5178:     dc.b    ($654F>>8)&$FF
02:0004034E 66              	  5179:     dc.b    ($6676>>8)&$FF
02:0004034F 66              	  5180:     dc.b    ($6665>>8)&$FF
                            	  5181: 
