                            	  1818: UpdateBurrower:
                            	  1819:     ; If object timer <> 0, then go animate, draw, and check for collisions.
                            	  1820:     ;
02:00038D9E 10342028        	  1821:     move.b  ($28,A4,D2.W),D0
02:00038DA2 667E            	  1822:     bne  _L_z04_UpdateBurrower_Animate
                            	  1823:     ; If not zora or state <> 1, go cycle the state.
                            	  1824:     ;
02:00038DA4 41EC034F        	  1825:     lea     ($034F,A4),A0
02:00038DA8 10302000        	  1826:     move.b  (A0,D2.W),D0
02:00038DAC 0C000011        	  1827:     cmpi.b  #$11,D0
02:00038DB0 662A            	  1828:     bne  _L_z04_UpdateBurrower_CycleState
02:00038DB2 7600            	  1829:     moveq   #0,D3
02:00038DB4 41EC00AC        	  1830:     lea     ($00AC,A4),A0
02:00038DB8 16302000        	  1831:     move.b  (A0,D2.W),D3
02:00038DBC 5303            	  1832:     subq.b  #1,D3
