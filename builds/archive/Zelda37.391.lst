                            	  6106: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6107:     ; The weapon is the sword.
                            	  6108:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6109:     ;
02:00049718 023C00EE        	  6110:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004971C 122C0657        	  6111:     move.b  ($0657,A4),D1
02:00049720 D101            	  6112:     addx.b  D1,D0   ; ADC Items
02:00049722 003C0011        	  6113:     ori     #$11,CCR  ; SEC: set C+X
02:00049726 123C0001        	  6114:     move.b  #$01,D1
02:0004972A 0A3C0010        	  6115:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004972E 9101            	  6116:     subx.b  D1,D0   ; SBC #$01
02:00049730 0A3C0010        	  6117:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6118:     even
                            	  6119: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6120:     ; Set sprite attributes to the calculated value above.
                            	  6121:     ;
02:00049734 4EB900030FAE    	  6122:     jsr     Anim_SetSpriteDescriptorAttributes
