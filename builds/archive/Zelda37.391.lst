                            	  4541: _L_z07_Link_EndMoveAndAnimate_TruncGridOffset:
                            	  4542:     ; Grid offset is a multiple of 8. So set it to 0.
                            	  4543:     ; If not in mode 5, go check warps and animate.
                            	  4544:     ;
02:00048BD4 7000            	  4545:     moveq   #0,D0
02:00048BD6 19400394        	  4546:     move.b  D0,($0394,A4)
02:00048BDA 7600            	  4547:     moveq   #0,D3
02:00048BDC 162C0012        	  4548:     move.b  ($0012,A4),D3
02:00048BE0 0C030005        	  4549:     cmpi.b  #$05,D3
02:00048BE4 66EA            	  4550:     bne  _L_z07_Link_EndMoveAndAnimate_CheckWarpsAndAnimate
                            	  4551:     ; Grid offset was a multiple of 8. So, we've stepped a whole tile,
                            	  4552:     ; and need to reset the subroom indicator.
                            	  4553:     ;
                            	  4554:     ; That way, we know not to go into a subroom that we just came out of.
                            	  4555:     ;
02:00048BE6 1940005A        	  4556:     move.b  D0,($005A,A4)
                            	  4557:     even
