                            	  5713: UpdatePolsVoice:
02:0003A9A8 0C020001        	  5714:     cmpi.b  #$01,D2
                            	  5715:     bne  _anon_z04_96
                            	  5716: _anon_z04_96:
                            	  5717:     ; If we have the magic clock, or is stunned, then
                            	  5718:     ; go draw and check collisions.
                            	  5719:     ;
02:0003A9AC 102C066C        	  5720:     move.b  ($066C,A4),D0
02:0003A9B0 1234203D        	  5721:     move.b  ($3D,A4,D2.W),D1
02:0003A9B4 8001            	  5722:     or.b  D1,D0
02:0003A9B6 660000AE        	  5723:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5724:     ; Every odd screen frame, go straight to drawing
                            	  5725:     ; and checking collisions.
                            	  5726:     ;
02:0003A9BA 102C0015        	  5727:     move.b  ($0015,A4),D0
02:0003A9BE E208            	  5728:     lsr.b  #1,D0   ; LSR A
02:0003A9C0 6404            	  5729:     bcc.s  __far_z_04_0053
02:0003A9C2 60000118        	  5730:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5731: __far_z_04_0053:
                            	  5732:     ; Otherwise move horizontally.
                            	  5733:     ;
02:0003A9C6 61000248        	  5734:     jsr     PolsVoice_MoveX
                            	  5735:     ; If state <> 0, then the monster is jumping.
                            	  5736:     ; Go handle vertical movement.
                            	  5737:     ;
02:0003A9CA 41EC00AC        	  5738:     lea     ($00AC,A4),A0
02:0003A9CE 10302000        	  5739:     move.b  (A0,D2.W),D0
02:0003A9D2 6706            	  5740:     beq  _L_z04_UpdatePolsVoice_State0
02:0003A9D4 61000130        	  5741:     jsr     UpdatePolsVoiceState1_Jumping
02:0003A9D8 6034            	  5742:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  5743: 
                            	  5744:     even
                            	  5745: _L_z04_UpdatePolsVoice_State0:
                            	  5746:     ; State 0. Walking.
                            	  5747:     ;
                            	  5748:     ; If grid offset = 0, then no more distance to cover.
                            	  5749:     ; So, go change to state 1 -- jumping.
                            	  5750:     ;
02:0003A9DA 41EC0394        	  5751:     lea     ($0394,A4),A0
02:0003A9DE 10302000        	  5752:     move.b  (A0,D2.W),D0
02:0003A9E2 67000084        	  5753:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5754:     ; Decrement grid offset / distance remaining.
                            	  5755:     ;
02:0003A9E6 41EC0394        	  5756:     lea     ($0394,A4),A0
02:0003A9EA 53302000        	  5757:     subq.b  #1,(A0,D2.W)
                            	  5758:     ; Move vertically.
                            	  5759:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5760:     ;
02:0003A9EE 41EC0084        	  5761:     lea     ($0084,A4),A0
02:0003A9F2 10302000        	  5762:     move.b  (A0,D2.W),D0
02:0003A9F6 023C00EE        	  5763:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9FA 41F90003A98A    	  5764:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003AA00 12303000        	  5765:     move.b  (A0,D3.W),D1
02:0003AA04 D101            	  5766:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003AA06 41EC0084        	  5767:     lea     ($0084,A4),A0
02:0003AA0A 11802000        	  5768:     move.b  D0,(A0,D2.W)
                            	  5769:     even
                            	  5770: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5771:     ; If the square the monster is over is walkable, then
                            	  5772:     ; go draw and check object collisions.
                            	  5773:     ;
02:0003AA0E 610001F4        	  5774:     jsr     PolsVoice_IsSquareWalkable
02:0003AA12 6452            	  5775:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5776:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5777:     ; then go change to state 1.
                            	  5778:     ;
02:0003AA14 41EC041F        	  5779:     lea     ($041F,A4),A0
02:0003AA18 10302000        	  5780:     move.b  (A0,D2.W),D0
02:0003AA1C 020000FC        	  5781:     andi.b #$FC,D0
02:0003AA20 0C0000B0        	  5782:     cmpi.b  #$B0,D0
02:0003AA24 6742            	  5783:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003AA26 0C0000F4        	  5784:     cmpi.b  #$F4,D0
02:0003AA2A 643C            	  5785:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5786:     ; Else blocked by something else.
                            	  5787:     ;
                            	  5788:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5789:     ;
02:0003AA2C 41EC0098        	  5790:     lea     ($0098,A4),A0
02:0003AA30 10302000        	  5791:     move.b  (A0,D2.W),D0
02:0003AA34 02000003        	  5792:     andi.b #$03,D0
02:0003AA38 6618            	  5793:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5794:     ; Else facing vertically. Flip the direction.
                            	  5795:     ; Go draw.
                            	  5796:     ;
02:0003AA3A 41EC0098        	  5797:     lea     ($0098,A4),A0
02:0003AA3E 10302000        	  5798:     move.b  (A0,D2.W),D0
02:0003AA42 0A00000C        	  5799:     eori.b #$0C,D0
02:0003AA46 41EC0098        	  5800:     lea     ($0098,A4),A0
02:0003AA4A 11802000        	  5801:     move.b  D0,(A0,D2.W)
02:0003AA4E 6000008C        	  5802:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5803: 
                            	  5804:     even
                            	  5805: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  5806:     ; Facing horizontally. Flip the direction.
                            	  5807:     ; Move two pixels, and go draw.
                            	  5808:     ;
02:0003AA52 0A000003        	  5809:     eori.b #$03,D0
02:0003AA56 41EC0098        	  5810:     lea     ($0098,A4),A0
02:0003AA5A 11802000        	  5811:     move.b  D0,(A0,D2.W)
02:0003AA5E 610001B0        	  5812:     jsr     PolsVoice_MoveX
02:0003AA62 610001AC        	  5813:     jsr     PolsVoice_MoveX
                            	  5814:     even
                            	  5815: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003AA66 6074            	  5816:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5817: 
                            	  5818:     even
                            	  5819: _L_z04_UpdatePolsVoice_SetState1:
                            	  5820:     ; If already in state 1, then go draw and check collisions.
                            	  5821:     ;
02:0003AA68 41EC00AC        	  5822:     lea     ($00AC,A4),A0
02:0003AA6C 10302000        	  5823:     move.b  (A0,D2.W),D0
02:0003AA70 6702            	  5824:     beq.s  __far_z_04_0054
02:0003AA72 6068            	  5825:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5826: __far_z_04_0054:
                            	  5827:     ; Go to state 1.
                            	  5828:     ;
02:0003AA74 41EC00AC        	  5829:     lea     ($00AC,A4),A0
02:0003AA78 52302000        	  5830:     addq.b  #1,(A0,D2.W)
                            	  5831:     ; Subtract 1 from facing direction to make an index.
                            	  5832:     ;
02:0003AA7C 7600            	  5833:     moveq   #0,D3
02:0003AA7E 41EC0098        	  5834:     lea     ($0098,A4),A0
02:0003AA82 16302000        	  5835:     move.b  (A0,D2.W),D3
02:0003AA86 5303            	  5836:     subq.b  #1,D3
                            	  5837:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5838:     ;
02:0003AA88 41EC0084        	  5839:     lea     ($0084,A4),A0
02:0003AA8C 10302000        	  5840:     move.b  (A0,D2.W),D0
02:0003AA90 0C000078        	  5841:     cmpi.b  #$78,D0
02:0003AA94 6402            	  5842:     bcc  _anon_z04_97
02:0003AA96 7603            	  5843:     moveq   #3,D3
                            	  5844: _anon_z04_97:
                            	  5845:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5846:     ;
02:0003AA98 0C0000A8        	  5847:     cmpi.b  #$A8,D0
02:0003AA9C 6502            	  5848:     bcs  _anon_z04_98
02:0003AA9E 7607            	  5849:     moveq   #7,D3
                            	  5850: _anon_z04_98:
                            	  5851:     ; Set the vertical speed for the beginning of the jump.
                            	  5852:     ;
02:0003AAA0 41F90003A994    	  5853:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003AAA6 10303000        	  5854:     move.b  (A0,D3.W),D0
02:0003AAAA 41EC0412        	  5855:     lea     ($0412,A4),A0
02:0003AAAE 11802000        	  5856:     move.b  D0,(A0,D2.W)
                            	  5857:     ; Look up the Y offset for the current direction.
                            	  5858:     ; Add it to object Y to set the destination Y of the jump.
                            	  5859:     ;
02:0003AAB2 41EC0084        	  5860:     lea     ($0084,A4),A0
02:0003AAB6 10302000        	  5861:     move.b  (A0,D2.W),D0
02:0003AABA 023C00EE        	  5862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AABE 41F90003A99C    	  5863:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003AAC4 12303000        	  5864:     move.b  (A0,D3.W),D1
02:0003AAC8 D101            	  5865:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003AACA 41EC042C        	  5866:     lea     ($042C,A4),A0
02:0003AACE 11802000        	  5867:     move.b  D0,(A0,D2.W)
