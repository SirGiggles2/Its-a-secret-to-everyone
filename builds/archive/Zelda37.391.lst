                            	  5490: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5491:     ; Advance the substate.
                            	  5492:     ;
02:0003A816 41EC042C        	  5493:     lea     ($042C,A4),A0
02:0003A81A 52302000        	  5494:     addq.b  #1,(A0,D2.W)
                            	  5495:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5496:     ;
02:0003A81E 41EC042C        	  5497:     lea     ($042C,A4),A0
02:0003A822 10302000        	  5498:     move.b  (A0,D2.W),D0
02:0003A826 0C000002        	  5499:     cmpi.b  #$02,D0
