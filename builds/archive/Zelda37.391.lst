02:00038516 12342070        	   573:     move.b  ($70,A4,D2.W),D1
02:0003851A 0A3C0010        	   574:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003851E 9101            	   575:     subx.b  D1,D0   ; SBC ObjX,X
02:00038520 0A3C0010        	   576:     eori    #$10,CCR  ; restore X = 6502 C
