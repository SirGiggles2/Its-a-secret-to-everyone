                            	  5502: __far_z_04_0051:
                            	  5503:     ; New bloated substate >= 2.
                            	  5504:     ;
                            	  5505:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5506:     ; which will transition to state 0 (moving).
                            	  5507:     ;
                            	  5508:     ; Note that if the bomb hits >= 2, then:
                            	  5509:     ; - If new substate = 2, then substate 2 will wait,
                            	  5510:     ;   and then transition to substate 3.
                            	  5511:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5512:     ;
02:0003A82E 7600            	  5513:     moveq   #0,D3
02:0003A830 41EC0437        	  5514:     lea     ($0437,A4),A0
02:0003A834 16302000        	  5515:     move.b  (A0,D2.W),D3
02:0003A838 0C030002        	  5516:     cmpi.b  #$02,D3
02:0003A83C 6502            	  5517:     bcs.s  __far_z_04_0052
02:0003A83E 600A            	  5518:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5519: __far_z_04_0052:
