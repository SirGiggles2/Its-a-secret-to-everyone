                            	  7883: HaveInput:
                            	  7884:     ; There were input directions.
                            	  7885:     ;
                            	  7886:     ; If there was only one input direction, go set object direction
                            	  7887:     ; to input direction, and set Link's speed.
                            	  7888:     ;
                            	  7889:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7890:     ; (X is still 0, because it's Link's object index).
                            	  7891:     ;
02:00041B7A 102C000F        	  7892:     move.b  ($000F,A4),D0
02:00041B7E 0C030001        	  7893:     cmpi.b  #$01,D3
02:00041B82 670000B6        	  7894:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7895:     ; There were more than one input directions.
                            	  7896:     ;
                            	  7897:     ; If none were walkable, go set input direction to 0, and return.
                            	  7898:     ;
02:00041B86 102C000C        	  7899:     move.b  ($000C,A4),D0
02:00041B8A 6604            	  7900:     bne  _anon_z05_174
02:00041B8C 60000128        	  7901:     jmp     SetLinkInputDir
                            	  7902: 
                            	  7903: _anon_z05_174:
                            	  7904:     ; Two input directions, and at least one of them is walkable.
                            	  7905:     ;
                            	  7906:     ; Make Link go straight in one direction on the next grid line.
                            	  7907:     ;
02:00041B90 7600            	  7908:     moveq   #0,D3
02:00041B92 1600            	  7909:     move.b  D0,D3
02:00041B94 522C0057        	  7910:     addq.b  #1,($0057,A4)
                            	  7911:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7912:     ; object direction and input direction to last walkable direction
                            	  7913:     ; found, and set Link's speed.
                            	  7914:     ;
                            	  7915:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7916:     ;
02:00041B98 7400            	  7917:     moveq   #0,D2
02:00041B9A 102C000D        	  7918:     move.b  ($000D,A4),D0
02:00041B9E 0C030001        	  7919:     cmpi.b  #$01,D3
02:00041BA2 67000096        	  7920:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00041BA6 7600            	  7921:     moveq   #0,D3
02:00041BA8 162C0010        	  7922:     move.b  ($0010,A4),D3
02:00041BAC 6700008C        	  7923:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7924:     ; In UW. There are two input directions, and they're both walkable.
                            	  7925:     ;
                            	  7926:     ; Normally, turn to the direction that's perpendicular to object
                            	  7927:     ; direction. But keep going straight after that, while diagonal
                            	  7928:     ; input is held.
                            	  7929:     ;
                            	  7930:     ; Handle special cases for doors.
                            	  7931:     ;
                            	  7932:     ;
                            	  7933:     ; 1. Link at horizontal doors.
                            	  7934:     ;
                            	  7935:     ; If Link's X = $20 or $D0 then
                            	  7936:     ;   If Link's Y = $85 and facing down then
                            	  7937:     ;     Go set object direction and input direction to object
                            	  7938:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7939:     ;     Link_GoStraightWhenDiagInput.
                            	  7940:     ;   Else
                            	  7941:     ;     Go turn to the perpendicular direction
                            	  7942:     ;
02:00041BB0 7600            	  7943:     moveq   #0,D3
02:00041BB2 162C0070        	  7944:     move.b  ($0070,A4),D3
02:00041BB6 0C030020        	  7945:     cmpi.b  #$20,D3
02:00041BBA 6706            	  7946:     beq  _anon_z05_175
02:00041BBC 0C0300D0        	  7947:     cmpi.b  #$D0,D3
02:00041BC0 661C            	  7948:     bne  _anon_z05_176
                            	  7949: _anon_z05_175:
02:00041BC2 7600            	  7950:     moveq   #0,D3
02:00041BC4 162C0084        	  7951:     move.b  ($0084,A4),D3
02:00041BC8 0C030085        	  7952:     cmpi.b  #$85,D3
02:00041BCC 6642            	  7953:     bne  _anon_z05_177
02:00041BCE 102C0098        	  7954:     move.b  ($0098,A4),D0
02:00041BD2 02000004        	  7955:     andi.b #$04,D0
02:00041BD6 6738            	  7956:     beq  _anon_z05_177
                            	  7957:     even
                            	  7958: _L_z05_HaveInput_SetLinkDirToObjDir:
02:00041BD8 102C0098        	  7959:     move.b  ($0098,A4),D0
02:00041BDC 665C            	  7960:     bne  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7961: _anon_z05_176:
                            	  7962:     ; If allowed to turn when input is diagonal (2 directions), then
                            	  7963:     ; go take the direction perpendicular to object direction.
                            	  7964:     ;
02:00041BDE 102C0098        	  7965:     move.b  ($0098,A4),D0
