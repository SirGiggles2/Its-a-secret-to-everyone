                            	   600:     ;
02:00038534 102C03F8        	   601:     move.b  ($03F8,A4),D0
02:00038538 41F90003848E    	   602:     lea     (BlockPushDirections).l,A0
02:0003853E 12303000        	   603:     move.b  (A0,D3.W),D1
02:00038542 B001            	   604:     cmp.b   D1,D0
02:00038544 6702            	   605:     beq.s  __far_z_04_0003
02:00038546 6046            	   606:     jmp  ResetPushTimer
