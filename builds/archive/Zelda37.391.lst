                            	  5652: _L_z07_CheckState30_CheckOtherStates:
                            	  5653:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5654:     ;
                            	  5655:     ; The boomerang will now return. Reset the grid offset.
                            	  5656:     ;
02:000493A2 7000            	  5657:     moveq   #0,D0
02:000493A4 41EC0394        	  5658:     lea     ($0394,A4),A0
02:000493A8 11802000        	  5659:     move.b  D0,(A0,D2.W)
                            	  5660:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5661:     ;
02:000493AC 0C02000D        	  5662:     cmpi.b  #$0D,D2
02:000493B0 6408            	  5663:     bcc  _anon_z07_30
02:000493B2 41EC042C        	  5664:     lea     ($042C,A4),A0
02:000493B6 10302000        	  5665:     move.b  (A0,D2.W),D0
                            	  5666: _anon_z07_30:
02:000493BA 4EB9000308FC    	  5667:     jsr     GetDirectionsAndDistancesToTarget
                            	  5668:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5669:     ; then go move towards the thrower, draw, and check collisions.
                            	  5670:     ;
02:000493C0 1014            	  5671:     move.b  ($0000,A4),D0
02:000493C2 0C000002        	  5672:     cmpi.b  #$02,D0
02:000493C6 666A            	  5673:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5674:     ; The boomerang has reached the thrower.
                            	  5675:     ;
                            	  5676:     ; Reset the distance to move.
                            	  5677:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5678:     ;
02:000493C8 7000            	  5679:     moveq   #0,D0
02:000493CA 41EC0380        	  5680:     lea     ($0380,A4),A0
02:000493CE 11802000        	  5681:     move.b  D0,(A0,D2.W)
02:000493D2 0C02000D        	  5682:     cmpi.b  #$0D,D2
02:000493D6 6524            	  5683:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5684:     ; Link has caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5687:     ;
                            	  5688:     ; If Link catches it some time after throwing it,
                            	  5689:     ; his state will become $20, and he will show the catch animation.
                            	  5690:     ;
                            	  5691:     ; But if he catches it right after throwing it, the state becomes
                            	  5692:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5693:     ;
02:000493D8 102C00AC        	  5694:     move.b  ($00AC,A4),D0
02:000493DC 00000020        	  5695:     ori.b #$20,D0
02:000493E0 194000AC        	  5696:     move.b  D0,($00AC,A4)
                            	  5697:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5698:     ; up the new state.
                            	  5699:     ;
02:000493E4 7001            	  5700:     moveq   #1,D0
02:000493E6 194003D0        	  5701:     move.b  D0,($03D0,A4)
                            	  5702:     ; Deactivate the boomerang.
                            	  5703:     ;
02:000493EA 760F            	  5704:     moveq   #15,D3
02:000493EC 7000            	  5705:     moveq   #0,D0
02:000493EE 41EC00AC        	  5706:     lea     ($00AC,A4),A0
02:000493F2 11803000        	  5707:     move.b  D0,(A0,D3.W)
02:000493F6 0A3C0001        	  5708:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000493FA 4E75            	  5709:     rts
