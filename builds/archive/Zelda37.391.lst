                            	 10372:     even
                            	 10373: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 10374:     ; Second, calculate a vertical component.
                            	 10375:     ; Combine it with the horizontal component:
                            	 10376:     ;
                            	 10377:     ; Y := 4 (down)
                            	 10378:     ; if observed player Y <> object Y then
                            	 10379:     ;   if observed player Y < object Y then
                            	 10380:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 10381:     ;   [00] := [00] | Y
                            	 10382:     ;
02:0003CC20 7601            	 10383:     moveq   #1,D3
02:0003CC22 102C0062        	 10384:     move.b  ($0062,A4),D0
02:0003CC26 41EC0084        	 10385:     lea     ($0084,A4),A0
02:0003CC2A 12302000        	 10386:     move.b  (A0,D2.W),D1
