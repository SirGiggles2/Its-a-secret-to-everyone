02:00039FEA 41EC0381        	  4411:     lea     ($0381,A4),A0
02:00039FEE 11803000        	  4412:     move.b  D0,(A0,D3.W)
02:00039FF2 41EC0099        	  4413:     lea     ($0099,A4),A0
02:00039FF6 11803000        	  4414:     move.b  D0,(A0,D3.W)
                            	  4415:     ; Bottom of the loop.
