                            	  3898: _L_z05_CheckDoorway_InDoorway:
                            	  3899:     ; In a doorway. DoorwayDir is in A.
                            	  3900:     ;
02:0003EF10 1B00            	  3901:     move.b  D0,-(A5)  ; PHA
