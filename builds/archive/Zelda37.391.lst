                            	  4676: UpdatePeaceTextbox:
                            	  4677:     ; Only emit a character once every 8 frames --
                            	  4678:     ; when (counter [0412] MOD 8) = 4.
                            	  4679:     ;
02:00034FE6 522C0412        	  4680:     addq.b  #1,($0412,A4)
02:00034FEA 102C0412        	  4681:     move.b  ($0412,A4),D0
02:00034FEE 02000007        	  4682:     andi.b #$07,D0
02:00034FF2 0C000004        	  4683:     cmpi.b  #$04,D0
02:00034FF6 665C            	  4684:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4685:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4686:     ; to the dynamic transfer buf.
                            	  4687:     ;
02:00034FF8 7604            	  4688:     moveq   #4,D3
                            	  4689: _anon_z02_35:
02:00034FFA 41F900034F76    	  4690:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00035000 10303000        	  4691:     move.b  (A0,D3.W),D0
02:00035004 41EC0302        	  4692:     lea     ($0302,A4),A0
02:00035008 11803000        	  4693:     move.b  D0,(A0,D3.W)
02:0003500C 5303            	  4694:     subq.b  #1,D3
02:0003500E 6AEA            	  4695:     bpl  _anon_z02_35
                            	  4696:     ; Load a character from the string and copy it to
                            	  4697:     ; the transfer record until we read character $FF.
                            	  4698:     ;
02:00035010 7600            	  4699:     moveq   #0,D3
02:00035012 162C0413        	  4700:     move.b  ($0413,A4),D3
02:00035016 41F900034FB0    	  4701:     lea     (PeaceText).l,A0
02:0003501C 10303000        	  4702:     move.b  (A0,D3.W),D0
02:00035020 0C0000FF        	  4703:     cmpi.b  #$FF,D0
02:00035024 6730            	  4704:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00035026 19400305        	  4705:     move.b  D0,($0305,A4)
                            	  4706:     ; A regular space takes as much time to emit as any character.
                            	  4707:     ; But it makes no sound.
                            	  4708:     ;
02:0003502A 0C000024        	  4709:     cmpi.b  #$24,D0
02:0003502E 6706            	  4710:     beq  _anon_z02_36
02:00035030 7010            	  4711:     moveq   #16,D0
02:00035032 19400604        	  4712:     move.b  D0,($0604,A4)
                            	  4713: _anon_z02_36:
                            	  4714:     ; Point to the next character in the string.
                            	  4715:     ;
02:00035036 522C0413        	  4716:     addq.b  #1,($0413,A4)
                            	  4717:     ; Replace the low byte of the VRAM address with the one
                            	  4718:     ; where the next character should be written.
                            	  4719:     ;
02:0003503A 41F900034F7C    	  4720:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00035040 10303000        	  4721:     move.b  (A0,D3.W),D0
02:00035044 19400303        	  4722:     move.b  D0,($0303,A4)
                            	  4723:     ; Once the low VRAM address rolls over,
                            	  4724:     ; increment the high address.
                            	  4725:     ;
02:00035048 0C0000A0        	  4726:     cmpi.b  #$A0,D0
02:0003504C 6406            	  4727:     bcc  _L_z02_UpdatePeaceTextbox_Exit
