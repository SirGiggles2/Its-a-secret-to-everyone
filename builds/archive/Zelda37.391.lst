                            	  1922:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1923:     ; the mound frame images:
                            	  1924:     ;
                            	  1925:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1926:     ;
                            	  1927:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1928:     ;
                            	  1929:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1930:     ;
02:00038E78 003C0011        	  1931:     ori     #$11,CCR  ; SEC: set C+X
02:00038E7C 123C0001        	  1932:     move.b  #$01,D1
02:00038E80 0A3C0010        	  1933:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038E84 9101            	  1934:     subx.b  D1,D0   ; SBC #$01
02:00038E86 0A3C0010        	  1935:     eori    #$10,CCR  ; restore X = 6502 C
02:00038E8A E308            	  1936:     lsl.b  #1,D0   ; ASL A
02:00038E8C 023C00EE        	  1937:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038E90 41EC03E4        	  1938:     lea     ($03E4,A4),A0
02:00038E94 12302000        	  1939:     move.b  (A0,D2.W),D1
02:00038E98 D101            	  1940:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1941:     even
