02:0003839C 11802000        	   372:     move.b  D0,(A0,D2.W)
                            	   373:     ; If turn timer <> 0, then go set input direction to facing direction.
                            	   374:     ;
02:000383A0 41EC0478        	   375:     lea     ($0478,A4),A0
02:000383A4 10302000        	   376:     move.b  (A0,D2.W),D0
02:000383A8 6612            	   377:     bne  _L_z04_Exit_SetInputDir
                            	   378:     ; Turn toward the chase target in a direction perpendicular to
                            	   379:     ; facing direction.
                            	   380:     ;
                            	   381:     ; If facing vertically, then go choose a horizontal direction
                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:000383AA 41EC0098        	   386:     lea     ($0098,A4),A0
02:000383AE 10302000        	   387:     move.b  (A0,D2.W),D0
02:000383B2 0200000C        	   388:     andi.b #$0C,D0
02:000383B6 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
02:000383B8 6700FF68        	   390:     beq  _L_z04_Exit_TurnVertically
