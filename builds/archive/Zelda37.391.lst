                            	  1478: AnimateDemoPhase0Subphase1:
02:00032F48 102C0438        	  1479:     move.b  ($0438,A4),D0
02:00032F4C 666C            	  1480:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1481:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1482:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1483:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032F4E 7000            	  1484:     moveq   #0,D0
02:00032F50 102C0437        	  1485:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032F54 EB48            	  1486:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032F56 41F900032D38    	  1487:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032F5C D0C0            	  1488:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1489:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032F5E 197C003F0302    	  1490:     move.b  #$3F,($0302,A4)
02:00032F64 197C00000303    	  1491:     move.b  #$00,($0303,A4)
02:00032F6A 7020            	  1492:     moveq   #32,D0
02:00032F6C 19400304        	  1493:     move.b  D0,($0304,A4)
                            	  1494:     ; End marker at DynTileBuf+4+31
02:00032F70 761F            	  1495:     moveq   #31,D3
02:00032F72 103C00FF        	  1496:     move.b  #$FF,D0
02:00032F76 43EC0306        	  1497:     lea     ($0306,A4),A1
02:00032F7A 13803000        	  1498:     move.b  D0,(A1,D3.W)
                            	  1499:     even
                            	  1500: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00032F7E 10303000        	  1501:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00032F82 43EC0305        	  1502:     lea     ($0305,A4),A1
02:00032F86 13803000        	  1503:     move.b  D0,(A1,D3.W)
02:00032F8A 5303            	  1504:     subq.b  #1,D3
02:00032F8C 6AF0            	  1505:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1506:     ; Advance the subphase cycle.
                            	  1507:     ;
02:00032F8E 522C0437        	  1508:     addq.b  #1,($0437,A4)
                            	  1509:     ; Set the timer to the delay for the current point in the cycle.
                            	  1510:     ;
02:00032F92 7600            	  1511:     moveq   #0,D3
02:00032F94 162C0437        	  1512:     move.b  ($0437,A4),D3
