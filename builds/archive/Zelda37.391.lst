                            	  1764: ; Fails if no empty slot was found, or the blue candle was already used.
                            	  1765: ;
                            	  1766: ;
                            	  1767: ; Look in slots $10 and $11. If none are empty, return.
                            	  1768: ; Otherwise, X will have the empty slot found.
                            	  1769: ;
                            	  1770: ; Note that it's possible that we fail to find an empty slot,
                            	  1771: ; but the caller might find slot X occupied by a fire made earlier.
                            	  1772: ;
                            	  1773:     even
