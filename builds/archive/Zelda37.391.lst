02:00049676 102C0098        	  6036:     move.b  ($0098,A4),D0
02:0004967A 41EC0098        	  6037:     lea     ($0098,A4),A0
02:0004967E 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:00049682 4EB9000308EC    	  6042:     jsr     GetOppositeDir
02:00049688 1003            	  6043:     move.b  D3,D0
02:0004968A 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004968E 1214            	  6045:     move.b  ($0000,A4),D1
02:00049690 D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:00049692 7600            	  6047:     moveq   #0,D3
02:00049694 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:00049696 102C0070        	  6052:     move.b  ($0070,A4),D0
02:0004969A 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004969E 41F9000495CA    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:000496A4 12303000        	  6055:     move.b  (A0,D3.W),D1
02:000496A8 D101            	  6056:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:000496AA 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:000496AE 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:000496B0 102C0084        	  6062:     move.b  ($0084,A4),D0
02:000496B4 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:000496B8 41F9000495DA    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:000496BE 12303000        	  6065:     move.b  (A0,D3.W),D1
02:000496C2 D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:000496C4 41EC0084        	  6067:     lea     ($0084,A4),A0
02:000496C8 11802000        	  6068:     move.b  D0,(A0,D2.W)
