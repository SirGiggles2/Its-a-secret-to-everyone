                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:00048F1A 760E            	  4983:     moveq   #14,D3
02:00048F1C 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:00048F20 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:00048F24 41EC0084        	  4986:     lea     ($0084,A4),A0
02:00048F28 10303000        	  4987:     move.b  (A0,D3.W),D0
02:00048F2C 41EC0084        	  4988:     lea     ($0084,A4),A0
02:00048F30 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:00048F34 41EC0098        	  4990:     lea     ($0098,A4),A0
02:00048F38 10303000        	  4991:     move.b  (A0,D3.W),D0
02:00048F3C 41EC0098        	  4992:     lea     ($0098,A4),A0
02:00048F40 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
