                            	  8674: UpdatePatraChild:
                            	  8675:     ; If state = 1, then go orbit.
                            	  8676:     ;
02:0003C05E 41EC00AC        	  8677:     lea     ($00AC,A4),A0
02:0003C062 10302000        	  8678:     move.b  (A0,D2.W),D0
