                            	  9402: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  9403:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  9404:     ;
02:0003C568 10342070        	  9405:     move.b  ($70,A4,D2.W),D0
02:0003C56C 023C00EE        	  9406:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C570 41F90003C55A    	  9407:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C576 12303000        	  9408:     move.b  (A0,D3.W),D1
02:0003C57A D101            	  9409:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C57C 1880            	  9410:     move.b  D0,($0000,A4)
                            	  9411:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  9412:     ;
02:0003C57E 41EC0084        	  9413:     lea     ($0084,A4),A0
02:0003C582 10302000        	  9414:     move.b  (A0,D2.W),D0
02:0003C586 023C00EE        	  9415:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C58A 41F90003C55E    	  9416:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C590 12303000        	  9417:     move.b  (A0,D3.W),D1
02:0003C594 D101            	  9418:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C596 19400001        	  9419:     move.b  D0,($0001,A4)
                            	  9420:     ; Each part has a horizontal flipping flag.
                            	  9421:     ;
02:0003C59A 41F90003C562    	  9422:     lea     (GanonSpriteHFlips).l,A0
02:0003C5A0 10303000        	  9423:     move.b  (A0,D3.W),D0
02:0003C5A4 1940000F        	  9424:     move.b  D0,($000F,A4)
                            	  9425:     ; Save and copy the loop index (the current part) to [07].
                            	  9426:     ;
02:0003C5A8 1003            	  9427:     move.b  D3,D0
02:0003C5AA 1B00            	  9428:     move.b  D0,-(A5)  ; PHA
02:0003C5AC 19400007        	  9429:     move.b  D0,($0007,A4)
                            	  9430:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  9431:     ; that make it up.
                            	  9432:     ;
02:0003C5B0 41EC046B        	  9433:     lea     ($046B,A4),A0
02:0003C5B4 10302000        	  9434:     move.b  (A0,D2.W),D0
02:0003C5B8 E308            	  9435:     lsl.b  #1,D0   ; ASL A
02:0003C5BA E308            	  9436:     lsl.b  #1,D0   ; ASL A
                            	  9437:     ; Add [07] -- the index of the current part.
                            	  9438:     ;
                            	  9439:     ; Now you have an index into the frame image table, for the
                            	  9440:     ; current image part of the current animation frame.
                            	  9441:     ;
02:0003C5BC 122C0007        	  9442:     move.b  ($0007,A4),D1
02:0003C5C0 D101            	  9443:     addx.b  D1,D0   ; ADC $07
