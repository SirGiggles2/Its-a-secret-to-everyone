02:0003EF5C 6620            	  3941:     bne  _anon_z05_96
02:0003EF5E 102C0001        	  3942:     move.b  ($0001,A4),D0
02:0003EF62 41F90003EEBA    	  3943:     lea     (DoorwayBoundsMinUnder).l,A0
02:0003EF68 12303000        	  3944:     move.b  (A0,D3.W),D1
02:0003EF6C B001            	  3945:     cmp.b   D1,D0
02:0003EF6E 650E            	  3946:     bcs  _anon_z05_96
02:0003EF70 41F90003EEBE    	  3947:     lea     (DoorwayBoundsMaxUnder).l,A0
02:0003EF76 12303000        	  3948:     move.b  (A0,D3.W),D1
02:0003EF7A B001            	  3949:     cmp.b   D1,D0
02:0003EF7C 6506            	  3950:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3951: _anon_z05_96:
