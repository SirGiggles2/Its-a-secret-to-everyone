02:0003A1B6 41EC0084        	  4678:     lea     ($0084,A4),A0
02:0003A1BA 11802000        	  4679:     move.b  D0,(A0,D2.W)
02:0003A1BE 101D            	  4680:     move.b  (A5)+,D0  ; PLA
02:0003A1C0 19802070        	  4681:     move.b  D0,($70,A4,D2.W)
