                            	  4169:     ; If object is the player, return.
                            	  4170:     ;
02:000489D8 4A02            	  4171:     cmpi.b  #$00,D2
02:000489DA 6604            	  4172:     bne.s  __far_z_07_0050
02:000489DC 6000008A        	  4173:     jmp  L1F148_Exit
                            	  4174: __far_z_07_0050:
                            	  4175:     ; Moving direction = 0.
