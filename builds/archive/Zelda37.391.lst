                            	  8681: __far_z_04_0096:
                            	  8682:     ; State = 0.
                            	  8683:     ;
                            	  8684:     ; If the current object slot is 2, then go initialize the patra child.
                            	  8685:     ; This is the only patra child shown in the first fame.
                            	  8686:     ;
02:0003C06C 0C020002        	  8687:     cmpi.b  #$02,D2
02:0003C070 6732            	  8688:     beq  _L_z04_UpdatePatraChild_Ready
                            	  8689:     ; The patra child in slot 2 is the last one to be updated.
                            	  8690:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  8691:     ;
                            	  8692:     ; This means that in the first frame, slot 2 is the only one to be
                            	  8693:     ; shown.
                            	  8694:     ;
02:0003C072 102C00AE        	  8695:     move.b  ($00AE,A4),D0
02:0003C076 6700008E        	  8696:     beq  _L_z04_UpdatePatraChild_Exit
                            	  8697:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  8698:     ; here to wait to be shown at the top position (N) one at a time.
                            	  8699:     ;
02:0003C07A 1002            	  8700:     move.b  D2,D0
                            	  8701:     ; Subtract 3 from the object slot to get the angle where the
                            	  8702:     ; patra child in object slot 2 should be for the current one to appear.
                            	  8703:     ;
02:0003C07C 003C0011        	  8704:     ori     #$11,CCR  ; SEC: set C+X
02:0003C080 123C0003        	  8705:     move.b  #$03,D1
02:0003C084 0A3C0010        	  8706:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C088 9101            	  8707:     subx.b  D1,D0   ; SBC #$03
02:0003C08A 0A3C0010        	  8708:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C08E 7600            	  8709:     moveq   #0,D3
02:0003C090 1600            	  8710:     move.b  D0,D3
                            	  8711:     ; If the patra child in slot 2 has not reached the required angle,
                            	  8712:     ; then return.
                            	  8713:     ;
02:0003C092 102C0396        	  8714:     move.b  ($0396,A4),D0
02:0003C096 41F90003C050    	  8715:     lea     (PatraChildStartAngles).l,A0
02:0003C09C 12303000        	  8716:     move.b  (A0,D3.W),D1
02:0003C0A0 B001            	  8717:     cmp.b   D1,D0
02:0003C0A2 6662            	  8718:     bne  _L_z04_UpdatePatraChild_Exit
                            	  8719:     even
