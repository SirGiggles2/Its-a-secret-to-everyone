                            	    43: ; Description:
                            	    44: ; Each song phrase is described by a header in this format:
                            	    45: ;
                            	    46: ; 0: Note length table base
                            	    47: ; 1: Song script address low
                            	    48: ; 2: Song script address high
                            	    49: ; 3: Triangle note offset in script
                            	    50: ; 4: Square 0 note offset in script
                            	    51: ; 5: Noise note offset in script
                            	    52: ; 6: Envelope selector
                            	    53: ; 7: TODO:
                            	    54: ;
                            	    55: ; Note that the last byte of the "Item taken" header overlaps
                            	    56: ; "End level", and "End level" overlaps "Overworld".
                            	    57: ;
