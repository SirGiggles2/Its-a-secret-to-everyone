02:000337C8 19400085        	  2315:     move.b  D0,($0085,A4)
02:000337CC 5202            	  2316:     addq.b  #1,D2
02:000337CE 41F900033216    	  2317:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
02:000337D4 12302000        	  2318:     move.b  (A0,D2.W),D1
