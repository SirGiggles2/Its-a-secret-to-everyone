                            	  5614: _anon_z05_120:
                            	  5615:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5616:     ;
                            	  5617:     ; Shutters and the commands to open a door always change
                            	  5618:     ; tiles.
                            	  5619:     ;
02:000405EA 61000130        	  5620:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5621:     even
                            	  5622: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5623:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5624:     ; We need to remember how many tiles need to be copied
                            	  5625:     ; in each transfer record.
                            	  5626:     ;
02:000405EE 102C0006        	  5627:     move.b  ($0006,A4),D0
02:000405F2 19400004        	  5628:     move.b  D0,($0004,A4)
                            	  5629:     ; Write the transfer record header for the door.
                            	  5630:     ;
                            	  5631:     ;
                            	  5632:     ; VRAM address high byte of door
02:000405F6 1014            	  5633:     move.b  ($0000,A4),D0
02:000405F8 41EC0302        	  5634:     lea     ($0302,A4),A0
02:000405FC 11802000        	  5635:     move.b  D0,(A0,D2.W)
02:00040600 5202            	  5636:     addq.b  #1,D2
02:00040602 102C0001        	  5637:     move.b  ($0001,A4),D0
02:00040606 41EC0302        	  5638:     lea     ($0302,A4),A0
02:0004060A 11802000        	  5639:     move.b  D0,(A0,D2.W)
02:0004060E 5202            	  5640:     addq.b  #1,D2
02:00040610 102C0006        	  5641:     move.b  ($0006,A4),D0
02:00040614 41EC0302        	  5642:     lea     ($0302,A4),A0
02:00040618 11802000        	  5643:     move.b  D0,(A0,D2.W)
02:0004061C 5202            	  5644:     addq.b  #1,D2
                            	  5645: _anon_z05_121:
                            	  5646:     ; Write two tiles in a short loop indexed by [04].
                            	  5647:     ;
02:0004061E 6100ED1C        	  5648:     jsr     WriteDoorFaceTileHorizontally
02:00040622 66FA            	  5649:     bne  _anon_z05_121
                            	  5650:     ; OR the low VRAM address with $20 to go down one row
                            	  5651:     ; in order to work on the second row of door tiles.
                            	  5652:     ;
02:00040624 7020            	  5653:     moveq   #32,D0
02:00040626 122C0001        	  5654:     move.b  ($0001,A4),D1
02:0004062A 8001            	  5655:     or.b  D1,D0
02:0004062C 19400001        	  5656:     move.b  D0,($0001,A4)
                            	  5657:     ; Bottom of the loop.
                            	  5658:     ; Loop again to write the second transfer record for the
                            	  5659:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5660:     ;
02:00040630 532C0005        	  5661:     subq.b  #1,($0005,A4)
02:00040634 66B8            	  5662:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5663:     ; Write the end marker, and update buffer length.
                            	  5664:     ;
02:00040636 103C00FF        	  5665:     move.b  #$FF,D0
02:0004063A 41EC0302        	  5666:     lea     ($0302,A4),A0
02:0004063E 11802000        	  5667:     move.b  D0,(A0,D2.W)
02:00040642 1002            	  5668:     move.b  D2,D0
02:00040644 19400301        	  5669:     move.b  D0,($0301,A4)
                            	  5670:     ; Increment the command.
                            	  5671:     ;
02:00040648 522C0054        	  5672:     addq.b  #1,($0054,A4)
                            	  5673:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5674:     ; and resetting the door command.
                            	  5675:     ; This ends up catching original states 3 and 7.
                            	  5676:     ;
                            	  5677:     ; Else set door timer to 8 and return.
                            	  5678:     ;
02:0004064C 102C0054        	  5679:     move.b  ($0054,A4),D0
02:00040650 02000003        	  5680:     andi.b #$03,D0
02:00040654 6708            	  5681:     beq  _anon_z05_122
02:00040656 7008            	  5682:     moveq   #8,D0
02:00040658 19400027        	  5683:     move.b  D0,($0027,A4)
02:0004065C 4E75            	  5684:     rts
                            	  5685: 
                            	  5686: _anon_z05_122:
                            	  5687:     ; If the door command = 4 after incrementing it, then
                            	  5688:     ; it was 3 (close door). So:
                            	  5689:     ; 1. reset this door's flag
                            	  5690:     ; 2. remove it from the opened door mask
                            	  5691:     ; 3. reset the door command
                            	  5692:     ; 4. go lay out doors in the play area map
                            	  5693:     ;
02:0004065E 102C0054        	  5694:     move.b  ($0054,A4),D0
02:00040662 0C000004        	  5695:     cmpi.b  #$04,D0
02:00040666 6626            	  5696:     bne  _anon_z05_123
02:00040668 7400            	  5697:     moveq   #0,D2
02:0004066A 142C0009        	  5698:     move.b  ($0009,A4),D2
02:0004066E 6100DCE2        	  5699:     jsr     ResetDoorFlag
02:00040672 102C0055        	  5700:     move.b  ($0055,A4),D0
02:00040676 0A00000F        	  5701:     eori.b #$0F,D0
02:0004067A 122C00EE        	  5702:     move.b  ($00EE,A4),D1
02:0004067E C001            	  5703:     and.b  D1,D0
                            	  5704:     even
                            	  5705: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00040680 194000EE        	  5706:     move.b  D0,($00EE,A4)
                            	  5707:     even
                            	  5708: L_ResetDoorCmdAndLayOutDoors:
02:00040684 7000            	  5709:     moveq   #0,D0
02:00040686 19400054        	  5710:     move.b  D0,($0054,A4)
02:0004068A 6000FCD4        	  5711:     jmp     LayOutDoors
                            	  5712: 
                            	  5713: _anon_z05_123:
                            	  5714:     ; Door command <> 4.
                            	  5715:     ; It must be 8, which means it was 7: open door.
                            	  5716:     ;
                            	  5717:     ; If the door is a shutter (7), then go add the door to the
                            	  5718:     ; opened door mask, reset door command, and lay out doors.
                            	  5719:     ;
02:0004068E 102C0055        	  5720:     move.b  ($0055,A4),D0
02:00040692 19400002        	  5721:     move.b  D0,($0002,A4)
02:00040696 6100FA32        	  5722:     jsr     FindDoorAttrByDoorBit
02:0004069A 0C000007        	  5723:     cmpi.b  #$07,D0
02:0004069E 676E            	  5724:     beq  _anon_z05_124
                            	  5725:     ; Else the door is not a shutter.
                            	  5726:     ;
                            	  5727:     ;
                            	  5728:     ; [09] door direction index
02:000406A0 7400            	  5729:     moveq   #0,D2
02:000406A2 142C0009        	  5730:     move.b  ($0009,A4),D2
02:000406A6 6100DCA4        	  5731:     jsr     SetDoorFlag
                            	  5732:     ; Get the next room's ID.
                            	  5733:     ;
02:000406AA 1003            	  5734:     move.b  D3,D0
02:000406AC 023C00EE        	  5735:     andi    #$EE,CCR  ; CLC: clear C+X
02:000406B0 41F90004056C    	  5736:     lea     (DoorNextRoomIdOffsets).l,A0
02:000406B6 12302000        	  5737:     move.b  (A0,D2.W),D1
02:000406BA D101            	  5738:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000406BC 7600            	  5739:     moveq   #0,D3
02:000406BE 1600            	  5740:     move.b  D0,D3
                            	  5741:     ; Flip the door direction index.
                            	  5742:     ;
02:000406C0 1002            	  5743:     move.b  D2,D0
02:000406C2 0A000001        	  5744:     eori.b #$01,D0
02:000406C6 7400            	  5745:     moveq   #0,D2
02:000406C8 1400            	  5746:     move.b  D0,D2
                            	  5747:     ; Set the door flag for the opposite door in the next room.
                            	  5748:     ;
02:000406CA 1214            	  5749:     move.b  ($00,A4),D1   ; ptr lo
02:000406CC 182C0001        	  5750:     move.b  ($01,A4),D4  ; ptr hi
02:000406D0 024100FF        	  5751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000406D4 E14C            	  5752:     lsl.w   #8,D4
02:000406D6 8841            	  5753:     or.w    D1,D4             ; D4 = NES ptr addr
02:000406D8 48C4            	  5754:     ext.l   D4
02:000406DA D8BC00FF0000    	  5755:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000406E0 2044            	  5756:     movea.l D4,A0
02:000406E2 10303000        	  5757:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000406E6 41F9000479FA    	  5758:     lea     (LevelMasks).l,A0
02:000406EC 12302000        	  5759:     move.b  (A0,D2.W),D1
02:000406F0 8001            	  5760:     or.b  D1,D0
02:000406F2 1214            	  5761:     move.b  ($00,A4),D1   ; ptr lo
02:000406F4 182C0001        	  5762:     move.b  ($01,A4),D4  ; ptr hi
02:000406F8 024100FF        	  5763:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000406FC E14C            	  5764:     lsl.w   #8,D4
02:000406FE 8841            	  5765:     or.w    D1,D4
02:00040700 48C4            	  5766:     ext.l   D4
02:00040702 D8BC00FF0000    	  5767:     add.l   #NES_RAM,D4
02:00040708 2044            	  5768:     movea.l D4,A0
02:0004070A 11803000        	  5769:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5770: _anon_z05_124:
                            	  5771:     ; Add the door to the opened door mask, reset door command,
                            	  5772:     ; and lay out doors.
                            	  5773:     ;
02:0004070E 102C0055        	  5774:     move.b  ($0055,A4),D0
02:00040712 122C00EE        	  5775:     move.b  ($00EE,A4),D1
02:00040716 8001            	  5776:     or.b  D1,D0
02:00040718 6000FF66        	  5777:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5778: 
                            	  5779: ; Params:
                            	  5780: ; [08]: 0 if closed
                            	  5781: ;
                            	  5782: ; Returns:
                            	  5783: ; X: current length of dynamic transfer buf
                            	  5784: ; [00]: door VRAM address high byte
                            	  5785: ; [01]: door VRAM address low byte
                            	  5786: ; [02:03]: address of door tiles for direction and face
                            	  5787: ; [05]: 2, the number of transfer records to write
                            	  5788: ; [06]: 2, the number of tiles in each record
                            	  5789: ; [07]: 0, the first index of a tile to transfer
                            	  5790: ; [09]: door direction index
                            	  5791: ;
                            	  5792: ; Note that this routine is called with triggered doors:
                            	  5793: ; doors that can change state. Their door type numbers are >= 4.
                            	  5794: ;
                            	  5795: ; If this routine were ever called with a fixed door
                            	  5796: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5797: ; values for the door face.
                            	  5798: ;
                            	  5799: ;
                            	  5800: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PrepareWriteHorizontalDoorTransferRecords:
02:0004071C 102C0055        	  5804:     move.b  ($0055,A4),D0
02:00040720 19400002        	  5805:     move.b  D0,($0002,A4)
02:00040724 6100F9A4        	  5806:     jsr     FindDoorAttrByDoorBit
02:00040728 0C000005        	  5807:     cmpi.b  #$05,D0
02:0004072C 650C            	  5808:     bcs  _anon_z05_125
02:0004072E 1B00            	  5809:     move.b  D0,-(A5)  ; PHA
02:00040730 7004            	  5810:     moveq   #4,D0
02:00040732 4EB90003083A    	  5811:     jsr     PlaySample
02:00040738 101D            	  5812:     move.b  (A5)+,D0  ; PLA
                            	  5813: _anon_z05_125:
                            	  5814:     ; Calculate the door face index in three parts.
                            	  5815:     ;
                            	  5816:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5817:     ; (provisional face index in Y register).
                            	  5818:     ;
02:0004073A 0C000004        	  5819:     cmpi.b  #$04,D0
02:0004073E 6602            	  5820:     bne  _anon_z05_126
02:00040740 7008            	  5821:     moveq   #8,D0
                            	  5822: _anon_z05_126:
02:00040742 0C000001        	  5823:     cmpi.b  #$01,D0
02:00040746 6602            	  5824:     bne  _anon_z05_127
02:00040748 7004            	  5825:     moveq   #4,D0
                            	  5826: _anon_z05_127:
                            	  5827:     ; Second, subtract 3 from provisional face index.
                            	  5828:     ;
02:0004074A 003C0011        	  5829:     ori     #$11,CCR  ; SEC: set C+X
02:0004074E 123C0003        	  5830:     move.b  #$03,D1
02:00040752 0A3C0010        	  5831:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040756 9101            	  5832:     subx.b  D1,D0   ; SBC #$03
02:00040758 0A3C0010        	  5833:     eori    #$10,CCR  ; restore X = 6502 C
02:0004075C 7600            	  5834:     moveq   #0,D3
02:0004075E 1600            	  5835:     move.b  D0,D3
                            	  5836:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5837:     ; face index >= 3, then subtract 1 from it.
                            	  5838:     ;
