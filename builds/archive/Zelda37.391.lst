                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:00048F5C 41EC0098        	  5017:     lea     ($0098,A4),A0
02:00048F60 10302000        	  5018:     move.b  (A0,D2.W),D0
02:00048F64 19400002        	  5019:     move.b  D0,($0002,A4)
02:00048F68 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:00048F6C 7000            	  5023:     moveq   #0,D0
02:00048F6E 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:00048F72 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:00048F74 1003            	  5031:     move.b  D3,D0
02:00048F76 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:00048F78 102C0002        	  5035:     move.b  ($0002,A4),D0
02:00048F7C 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:00048F7E 102C0003        	  5037:     move.b  ($0003,A4),D0
02:00048F82 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:00048F84 102C0015        	  5046:     move.b  ($0015,A4),D0
02:00048F88 02000003        	  5047:     andi.b #$03,D0
02:00048F8C 41F900048DEA    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048F92 12303000        	  5049:     move.b  (A0,D3.W),D1
02:00048F96 8001            	  5050:     or.b  D1,D0
02:00048F98 4EB900030FAE    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:00048F9E 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:00048FA2 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048FA6 122C0002        	  5057:     move.b  ($0002,A4),D1
02:00048FAA D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:00048FAC 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:00048FAE 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
