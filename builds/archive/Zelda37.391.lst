02:00034EBC 123C0010        	  4567:     move.b  #$10,D1
02:00034EC0 0A3C0010        	  4568:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034EC4 9101            	  4569:     subx.b  D1,D0   ; SBC #$10
