                            	  5192: _L_z02_DrawCredits_WriteAttributes:
                            	  5193:     ; Every 4 rows, we have to transfer NT attributes.
                            	  5194:     ; So, when (counter MOD 4) <> 0, skip filling an attribute record.
                            	  5195:     ;
