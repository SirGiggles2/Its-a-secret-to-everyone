02:00030D1C 41F900030A6C    	  2158:     lea     (ObjAnimations).l,A0
02:00030D22 10303000        	  2159:     move.b  (A0,D3.W),D0
02:00030D26 023C00EE        	  2160:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D2A 122C000D        	  2161:     move.b  ($000D,A4),D1
02:00030D2E D101            	  2162:     addx.b  D1,D0   ; ADC $0D
02:00030D30 7600            	  2163:     moveq   #0,D3
02:00030D32 1600            	  2164:     move.b  D0,D3
02:00030D34 41F900030AEC    	  2165:     lea     (ObjAnimFrameHeap).l,A0
02:00030D3A 10303000        	  2166:     move.b  (A0,D3.W),D0
02:00030D3E 19400002        	  2167:     move.b  D0,($0002,A4)
02:00030D42 023C00EE        	  2168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D46 123C0002        	  2169:     move.b  #$02,D1
02:00030D4A D101            	  2170:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030D4C 19400003        	  2171:     move.b  D0,($0003,A4)
