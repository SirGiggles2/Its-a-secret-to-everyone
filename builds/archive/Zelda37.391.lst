02:0003EEDA 12303000        	  3873:     move.b  (A0,D3.W),D1
02:0003EEDE B001            	  3874:     cmp.b   D1,D0
02:0003EEE0 6622            	  3875:     bne  _anon_z05_95
02:0003EEE2 102C0001        	  3876:     move.b  ($0001,A4),D0
02:0003EEE6 41F90003EEB2    	  3877:     lea     (DoorwayBoundsMinOver).l,A0
02:0003EEEC 12303000        	  3878:     move.b  (A0,D3.W),D1
02:0003EEF0 B001            	  3879:     cmp.b   D1,D0
02:0003EEF2 6510            	  3880:     bcs  _anon_z05_95
02:0003EEF4 41F90003EEB6    	  3881:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EEFA 12303000        	  3882:     move.b  (A0,D3.W),D1
02:0003EEFE B001            	  3883:     cmp.b   D1,D0
02:0003EF00 65000082        	  3884:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3885: _anon_z05_95:
02:0003EF04 5303            	  3886:     subq.b  #1,D3
