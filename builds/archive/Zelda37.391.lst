02:000350D4 0C000008        	  4803:     cmpi.b  #$08,D0
02:000350D8 6B1A            	  4804:     bmi  _anon_z02_37
02:000350DA 102C050B        	  4805:     move.b  ($050B,A4),D0
02:000350DE 123C0008        	  4806:     move.b  #$08,D1
02:000350E2 0A3C0010        	  4807:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000350E6 9101            	  4808:     subx.b  D1,D0   ; SBC #$08
02:000350E8 0A3C0010        	  4809:     eori    #$10,CCR  ; restore X = 6502 C
02:000350EC 1940050B        	  4810:     move.b  D0,($050B,A4)
02:000350F0 61000282        	  4811:     jsr     DrawCredits
                            	  4812: _anon_z02_37:
                            	  4813:     ; Add $80 to the scroll speed fraction.
                            	  4814:     ;
02:000350F4 102C0058        	  4815:     move.b  ($0058,A4),D0
02:000350F8 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:000350FC 123C0080        	  4817:     move.b  #$80,D1
02:00035100 D101            	  4818:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00035102 19400058        	  4819:     move.b  D0,($0058,A4)
                            	  4820:     ; Carry over to the tile offset and current V-scroll.
                            	  4821:     ;
02:00035106 6404            	  4822:     bcc  _anon_z02_38
02:00035108 522C050B        	  4823:     addq.b  #1,($050B,A4)
                            	  4824: _anon_z02_38:
02:0003510C 102C00FC        	  4825:     move.b  ($00FC,A4),D0
02:00035110 123C0000        	  4826:     move.b  #$00,D1
02:00035114 D101            	  4827:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035116 194000FC        	  4828:     move.b  D0,($00FC,A4)
                            	  4829:     ; If we've reached the bottom of a nametable, then
