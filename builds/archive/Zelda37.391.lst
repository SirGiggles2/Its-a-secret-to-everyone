                            	  4393: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  4394:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  4395:     ;
02:00039FD4 7004            	  4396:     moveq   #4,D0
02:00039FD6 1880            	  4397:     move.b  D0,($0000,A4)
                            	  4398:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  4399:     ;
02:00039FD8 7600            	  4400:     moveq   #0,D3
02:00039FDA 0C020005        	  4401:     cmpi.b  #$05,D2
02:00039FDE 6702            	  4402:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:00039FE0 7605            	  4403:     moveq   #5,D3
