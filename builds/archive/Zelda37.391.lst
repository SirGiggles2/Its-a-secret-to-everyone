                            	  5199: LayOutDoors:
                            	  5200:     ; Copies the right door face for the direction, type, and state
                            	  5201:     ; of the door to the play area tile map.
                            	  5202:     ;
                            	  5203:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5204:     ; that are not true doors.
                            	  5205:     ;
02:00040360 7403            	  5206:     moveq   #3,D2
                            	  5207:     even
                            	  5208: L_LayOutDoors_LoopDoors:
                            	  5209:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5210:     ;
02:00040362 7001            	  5211:     moveq   #1,D0
                            	  5212:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5213:     ;
                            	  5214:     ; [06] indicates whether we're handling the first half of
                            	  5215:     ; the door: Left half for N/S, Top half for E/W.
                            	  5216:     ;
02:00040364 19400006        	  5217:     move.b  D0,($0006,A4)
                            	  5218:     even
                            	  5219: L_LayOutDoors_LoopHalves:
02:00040368 1002            	  5220:     move.b  D2,D0
02:0004036A 1B00            	  5221:     move.b  D0,-(A5)  ; PHA
02:0004036C 1940000B        	  5222:     move.b  D0,($000B,A4)
02:00040370 41F90004033C    	  5223:     lea     (DoorBits).l,A0
02:00040376 10302000        	  5224:     move.b  (A0,D2.W),D0
02:0004037A 19400002        	  5225:     move.b  D0,($0002,A4)
02:0004037E 6100FD4A        	  5226:     jsr     FindDoorAttrByDoorBit
                            	  5227:     ; Begin looking for the door face for the door attribute.
                            	  5228:     ; In general, use the door type as the provisional face;
                            	  5229:     ; except turn 4 into 8.
                            	  5230:     ;
02:00040382 0C000005        	  5231:     cmpi.b  #$05,D0
02:00040386 642A            	  5232:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00040388 0C000004        	  5233:     cmpi.b  #$04,D0
02:0004038C 6608            	  5234:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0004038E 7008            	  5235:     moveq   #8,D0
02:00040390 6620            	  5236:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5237:     even
                            	  5238: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5239:     ; We jump here if the door type is bombable and was opened.
                            	  5240:     ; Change the provisional door face to value 9, which
                            	  5241:     ; will become the "hole in the wall".
                            	  5242:     ;
02:00040392 7009            	  5243:     moveq   #9,D0
02:00040394 665A            	  5244:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5245:     even
                            	  5246: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5247:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5248:     ; the mask of opened doors, because this is not a true door.
                            	  5249:     ;
02:00040396 1B00            	  5250:     move.b  D0,-(A5)  ; PHA
02:00040398 102C0002        	  5251:     move.b  ($0002,A4),D0
02:0004039C 4600            	  5252:     eori.b #$FF,D0
02:0004039E 122C00EE        	  5253:     move.b  ($00EE,A4),D1
02:000403A2 C001            	  5254:     and.b  D1,D0
02:000403A4 194000EE        	  5255:     move.b  D0,($00EE,A4)
02:000403A8 101D            	  5256:     move.b  (A5)+,D0  ; PLA
                            	  5257:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5258:     ;
02:000403AA 0C000001        	  5259:     cmpi.b  #$01,D0
02:000403AE 6402            	  5260:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000403B0 7004            	  5261:     moveq   #4,D0
                            	  5262:     even
                            	  5263: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5264:     ; The door attribute (DA) has been mapped to a
                            	  5265:     ; provisional door face value (PF) in %A as follows:
                            	  5266:     ;
                            	  5267:     ; DA PF Meaning
                            	  5268:     ; -------------
                            	  5269:     ; 0  4  open
                            	  5270:     ; 1  1  wall
                            	  5271:     ; 2  2  false wall
                            	  5272:     ; 3  3  false wall 2
                            	  5273:     ; 4  8  bombable
                            	  5274:     ; 5  5  key
                            	  5275:     ; 6  6  key 2
                            	  5276:     ; 7  7  shutter
                            	  5277:     ;
                            	  5278:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5279:     ; has been cleared, if the type was "open" or any wall.
                            	  5280:     ;
                            	  5281:     ;
                            	  5282:     ; Save the provisional face.
02:000403B2 1B00            	  5283:     move.b  D0,-(A5)  ; PHA
                            	  5284:     ; If the current direction points to a door that has been opened,
                            	  5285:     ; then see if we need to set door flags.
                            	  5286:     ;
02:000403B4 102C00EE        	  5287:     move.b  ($00EE,A4),D0
02:000403B8 122C0002        	  5288:     move.b  ($0002,A4),D1
02:000403BC C001            	  5289:     and.b  D1,D0
02:000403BE 7400            	  5290:     moveq   #0,D2
02:000403C0 1400            	  5291:     move.b  D0,D2
02:000403C2 101D            	  5292:     move.b  (A5)+,D0  ; PLA
02:000403C4 122C0002        	  5293:     move.b  ($0002,A4),D1
02:000403C8 B401            	  5294:     cmp.b   D1,D2
02:000403CA 6624            	  5295:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5296:     ; The current direction points to a door that has been opened.
                            	  5297:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5298:     ;
                            	  5299:     ;
                            	  5300:     ; Save provisional door face in Y register.
02:000403CC 7600            	  5301:     moveq   #0,D3
02:000403CE 1600            	  5302:     move.b  D0,D3
02:000403D0 101D            	  5303:     move.b  (A5)+,D0  ; PLA
02:000403D2 1B00            	  5304:     move.b  D0,-(A5)  ; PHA
02:000403D4 7400            	  5305:     moveq   #0,D2
02:000403D6 1400            	  5306:     move.b  D0,D2
02:000403D8 1003            	  5307:     move.b  D3,D0
                            	  5308:     ; If provisional door face is not for a shutter, then
                            	  5309:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5310:     ;
                            	  5311:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5312:     ;
02:000403DA 0C000007        	  5313:     cmpi.b  #$07,D0
02:000403DE 670E            	  5314:     beq  _anon_z05_111
02:000403E0 1B00            	  5315:     move.b  D0,-(A5)  ; PHA
02:000403E2 6100DF68        	  5316:     jsr     SetDoorFlag
02:000403E6 101D            	  5317:     move.b  (A5)+,D0  ; PLA
                            	  5318:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5319:     ; then go make it 9 (open "bombable").
                            	  5320:     ; Else make it 4 (open "door").
                            	  5321:     ;
02:000403E8 0C000008        	  5322:     cmpi.b  #$08,D0
02:000403EC 67A4            	  5323:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5324: _anon_z05_111:
02:000403EE 7004            	  5325:     moveq   #4,D0
                            	  5326:     even
                            	  5327: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5328:     ; For opened doors, the provisional door face has become:
                            	  5329:     ;
                            	  5330:     ; DA PF Meaning
                            	  5331:     ; -------------
                            	  5332:     ; 0  4  open
                            	  5333:     ; 1  1  wall
                            	  5334:     ; 2  2  false wall
                            	  5335:     ; 3  3  false wall 2
                            	  5336:     ; 4  9  bombable
                            	  5337:     ; 5  4  key
                            	  5338:     ; 6  4  key 2
                            	  5339:     ; 7  4  shutter
                            	  5340:     ;
                            	  5341:     ;
                            	  5342:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5343:     ;
02:000403F0 7400            	  5344:     moveq   #0,D2
02:000403F2 142C0006        	  5345:     move.b  ($0006,A4),D2
02:000403F6 6712            	  5346:     beq  _anon_z05_112
02:000403F8 7400            	  5347:     moveq   #0,D2
02:000403FA 142C000B        	  5348:     move.b  ($000B,A4),D2
02:000403FE 1B00            	  5349:     move.b  D0,-(A5)  ; PHA
02:00040400 6100FCC8        	  5350:     jsr     FindDoorAttrByDoorBit
02:00040404 61001DA4        	  5351:     jsr     CalcOpenDoorwayMask
02:00040408 101D            	  5352:     move.b  (A5)+,D0  ; PLA
                            	  5353: _anon_z05_112:
                            	  5354:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5355:     ; because the visible door face is already a wall.
                            	  5356:     ;
02:0004040A 0C000004        	  5357:     cmpi.b  #$04,D0
02:0004040E 650000DC        	  5358:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5359:     ; For all other provisional face values, calculate:
                            	  5360:     ; door face := provisional face - 3
02:00040412 003C0011        	  5361:     ori     #$11,CCR  ; SEC: set C+X
02:00040416 123C0003        	  5362:     move.b  #$03,D1
02:0004041A 0A3C0010        	  5363:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004041E 9101            	  5364:     subx.b  D1,D0   ; SBC #$03
02:00040420 0A3C0010        	  5365:     eori    #$10,CCR  ; restore X = 6502 C
02:00040424 7600            	  5366:     moveq   #0,D3
02:00040426 1600            	  5367:     move.b  D0,D3
                            	  5368:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5369:     ; subtract one.
                            	  5370:     ;
02:00040428 0C030003        	  5371:     cmpi.b  #$03,D3
02:0004042C 6502            	  5372:     bcs  _anon_z05_113
02:0004042E 5303            	  5373:     subq.b  #1,D3
                            	  5374: _anon_z05_113:
                            	  5375:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5376:     ;
                            	  5377:     ; DT DFC DFO Meaning
                            	  5378:     ; ------------------
                            	  5379:     ; 0  1   1   open
                            	  5380:     ; 4  4   5   bombable
                            	  5381:     ; 5  2   1   key
                            	  5382:     ; 6  2   1   key 2
                            	  5383:     ; 7  3   1   shutter
                            	  5384:     ;
                            	  5385:     ;
                            	  5386:     ; Get the direction index.
02:00040430 101D            	  5387:     move.b  (A5)+,D0  ; PLA
02:00040432 1B00            	  5388:     move.b  D0,-(A5)  ; PHA
02:00040434 610000D0        	  5389:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5390:     ; If handling the second half, then offset to the second half
                            	  5391:     ; of the tiles.
                            	  5392:     ;
02:00040438 102C0006        	  5393:     move.b  ($0006,A4),D0
02:0004043C 6618            	  5394:     bne  _anon_z05_114
02:0004043E 41F900040354    	  5395:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00040444 10302000        	  5396:     move.b  (A0,D2.W),D0
02:00040448 4EB900030970    	  5397:     jsr     AddToInt16At0
02:0004044E 7006            	  5398:     moveq   #6,D0
02:00040450 4EB900030978    	  5399:     jsr     AddToInt16At2
                            	  5400: _anon_z05_114:
                            	  5401:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5402:     ; Pointers will be incremented instead of Y.
02:00040456 7600            	  5403:     moveq   #0,D3
02:00040458 41F900040358    	  5404:     lea     (DirIndexToDoorColumnCount).l,A0
02:0004045E 10302000        	  5405:     move.b  (A0,D2.W),D0
02:00040462 19400005        	  5406:     move.b  D0,($0005,A4)
                            	  5407:     even
                            	  5408: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5409:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5410:     ;
02:00040466 101D            	  5411:     move.b  (A5)+,D0  ; PLA
02:00040468 1B00            	  5412:     move.b  D0,-(A5)  ; PHA
02:0004046A 7400            	  5413:     moveq   #0,D2
02:0004046C 1400            	  5414:     move.b  D0,D2
                            	  5415:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5416:     ; starting from highest index down to 0:
                            	  5417:     ;
02:0004046E 41F90004035C    	  5418:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00040474 10302000        	  5419:     move.b  (A0,D2.W),D0
02:00040478 7400            	  5420:     moveq   #0,D2
02:0004047A 1400            	  5421:     move.b  D0,D2
                            	  5422:     even
                            	  5423: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:0004047C 122C0002        	  5424:     move.b  ($02,A4),D1   ; ptr lo
02:00040480 182C0003        	  5425:     move.b  ($03,A4),D4  ; ptr hi
02:00040484 024100FF        	  5426:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040488 E14C            	  5427:     lsl.w   #8,D4
02:0004048A 8841            	  5428:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004048C 48C4            	  5429:     ext.l   D4
02:0004048E D8BC00FF0000    	  5430:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040494 2044            	  5431:     movea.l D4,A0
02:00040496 10303000        	  5432:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004049A 1214            	  5433:     move.b  ($00,A4),D1   ; ptr lo
02:0004049C 182C0001        	  5434:     move.b  ($01,A4),D4  ; ptr hi
02:000404A0 024100FF        	  5435:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000404A4 E14C            	  5436:     lsl.w   #8,D4
02:000404A6 8841            	  5437:     or.w    D1,D4
02:000404A8 48C4            	  5438:     ext.l   D4
02:000404AA D8BC00FF0000    	  5439:     add.l   #NES_RAM,D4
02:000404B0 2044            	  5440:     movea.l D4,A0
02:000404B2 11803000        	  5441:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000404B6 4EB900030974    	  5442:     jsr     Add1ToInt16At2
02:000404BC 41F900040350    	  5443:     lea     (NextDoorTileOffsets).l,A0
02:000404C2 10302000        	  5444:     move.b  (A0,D2.W),D0
02:000404C6 4EB900030970    	  5445:     jsr     AddToInt16At0
                            	  5446:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5447:     ; go 1 more tile down, to start the next column at the right place.
                            	  5448:     ; We have to compensate for the fact that E/W doors are 
                            	  5449:     ; shorter vertically than N/S doors.
02:000404CC 4A02            	  5450:     cmpi.b  #$00,D2
02:000404CE 6610            	  5451:     bne  _anon_z05_115
02:000404D0 101D            	  5452:     move.b  (A5)+,D0  ; PLA
02:000404D2 1B00            	  5453:     move.b  D0,-(A5)  ; PHA
02:000404D4 0C000002        	  5454:     cmpi.b  #$02,D0
02:000404D8 6406            	  5455:     bcc  _anon_z05_115
02:000404DA 4EB90003096C    	  5456:     jsr     Add1ToInt16At0
                            	  5457: _anon_z05_115:
                            	  5458:     ; Bottom of the tile row copying loop.
                            	  5459:     ; Decrement the row index.
                            	  5460:     ;
02:000404E0 5302            	  5461:     subq.b  #1,D2
02:000404E2 6A98            	  5462:     bpl  _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile
                            	  5463:     ; Bottom of the column copying loop.
                            	  5464:     ; Decrease the column counter.
                            	  5465:     ;
02:000404E4 532C0005        	  5466:     subq.b  #1,($0005,A4)
02:000404E8 6600FF7C        	  5467:     bne  _L_z05_L_LayOutDoors_LoopHalves_LoopColumn
                            	  5468:     even
                            	  5469: _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf:
                            	  5470:     ; Bottom of the door halves loop.
                            	  5471:     ;
02:000404EC 101D            	  5472:     move.b  (A5)+,D0  ; PLA
02:000404EE 7400            	  5473:     moveq   #0,D2
02:000404F0 1400            	  5474:     move.b  D0,D2
02:000404F2 532C0006        	  5475:     subq.b  #1,($0006,A4)
02:000404F6 6B04            	  5476:     bmi  _anon_z05_116
02:000404F8 6000FE6E        	  5477:     jmp     L_LayOutDoors_LoopHalves
                            	  5478: 
                            	  5479: _anon_z05_116:
                            	  5480:     ; Bottom of the door loop.
                            	  5481:     ; Decrement door index.
                            	  5482:     ;
02:000404FC 5302            	  5483:     subq.b  #1,D2
02:000404FE 6A02            	  5484:     bpl.s  __far_z_05_0072
02:00040500 604E            	  5485:     jmp  L165D4_Exit
                            	  5486: __far_z_05_0072:
02:00040502 6000FE5E        	  5487:     jmp     L_LayOutDoors_LoopDoors
                            	  5488: 
                            	  5489: ; Params:
                            	  5490: ; A: direction index
                            	  5491: ; Y: face index
                            	  5492: ;
                            	  5493: ; Returns:
                            	  5494: ; X: direction index
                            	  5495: ; [$00:01]: address of door inside play area tile map
                            	  5496: ; [$02:03]: address of door tiles for direction and face
                            	  5497: ;
