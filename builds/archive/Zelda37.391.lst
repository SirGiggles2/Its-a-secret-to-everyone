02:00039E0C 7600            	  4119:     moveq   #0,D3
02:00039E0E 1600            	  4120:     move.b  D0,D3
02:00039E10 41F90003CA98    	  4121:     lea     (Directions8).l,A0
02:00039E16 10303000        	  4122:     move.b  (A0,D3.W),D0
02:00039E1A 1940009D        	  4123:     move.b  D0,($009D,A4)
02:00039E1E 19400385        	  4124:     move.b  D0,($0385,A4)
02:00039E22 102C0022        	  4125:     move.b  ($0022,A4),D0
02:00039E26 02000007        	  4126:     andi.b #$07,D0
02:00039E2A 7600            	  4127:     moveq   #0,D3
02:00039E2C 1600            	  4128:     move.b  D0,D3
02:00039E2E 41F90003CA98    	  4129:     lea     (Directions8).l,A0
02:00039E34 10303000        	  4130:     move.b  (A0,D3.W),D0
02:00039E38 194000A2        	  4131:     move.b  D0,($00A2,A4)
02:00039E3C 1940038A        	  4132:     move.b  D0,($038A,A4)
                            	  4133:     ; Set minimum number of turns 1 for flying states.
