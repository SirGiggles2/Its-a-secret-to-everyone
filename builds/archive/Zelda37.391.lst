                            	  1001: _L_z04_UpdateFireball_Move:
                            	  1002:     ; A movement routine is used that works along one axis.
                            	  1003:     ; So, load its parameters, and call it for each axis individually.
                            	  1004:     ;
                            	  1005:     ; First, load the horizontal direction into [0F].
                            	  1006:     ;
02:0003882E 41EC0412        	  1007:     lea     ($0412,A4),A0
02:00038832 10302000        	  1008:     move.b  (A0,D2.W),D0
02:00038836 1940000F        	  1009:     move.b  D0,($000F,A4)
                            	  1010:     ; Load the horizontal q-speed and position fraction,
                            	  1011:     ; move, then save the position fraction.
                            	  1012:     ;
02:0003883A 41EC041F        	  1013:     lea     ($041F,A4),A0
02:0003883E 10302000        	  1014:     move.b  (A0,D2.W),D0
02:00038842 7600            	  1015:     moveq   #0,D3
02:00038844 41EC0451        	  1016:     lea     ($0451,A4),A0
02:00038848 16302000        	  1017:     move.b  (A0,D2.W),D3
