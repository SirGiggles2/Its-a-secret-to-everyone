02:0003C29E 10342028        	  9011:     move.b  ($28,A4,D2.W),D0
02:0003C2A2 6602            	  9012:     bne.s  __far_z_04_0102
02:0003C2A4 600E            	  9013:     jmp  Ganon_MoveAndShoot
                            	  9014: __far_z_04_0102:
                            	  9015:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  9016:     ; Collisions were checked already.
                            	  9017:     ;
                            	  9018:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  9019:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  9020:     ;
02:0003C2A6 0C000001        	  9021:     cmpi.b  #$01,D0
