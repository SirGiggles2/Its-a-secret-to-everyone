02:0003C0D8 41EC034F        	  8752:     lea     ($034F,A4),A0
02:0003C0DC 16302000        	  8753:     move.b  (A0,D2.W),D3
02:0003C0E0 0C030025        	  8754:     cmpi.b  #$25,D3
