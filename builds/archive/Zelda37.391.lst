                            	  5317:     ; Decrement tile index and loop index.
                            	  5318:     ;
02:0003A6BE 532C000A        	  5319:     subq.b  #1,($000A,A4)
02:0003A6C2 532C000B        	  5320:     subq.b  #1,($000B,A4)
02:0003A6C6 6A00FF7E        	  5321:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A6CA 4E75            	  5322:     rts
