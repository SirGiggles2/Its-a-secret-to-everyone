                            	  5375: UpdateDodongoState0_Move:
                            	  5376:     ; If facing left, then push X offset 0 on the stack.
                            	  5377:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  5378:     ;
                            	  5379:     ; We would like to use one set of coordinates only.
                            	  5380:     ; But movement would break down, if we did; because
                            	  5381:     ; Dodongo is so long.
                            	  5382:     ;
                            	  5383:     ; So, when not facing left, we temporarily shift the
                            	  5384:     ; X coordinate to be closer to the other side of the monster.
                            	  5385:     ;
02:0003A732 7600            	  5386:     moveq   #0,D3
02:0003A734 41EC0098        	  5387:     lea     ($0098,A4),A0
02:0003A738 10302000        	  5388:     move.b  (A0,D2.W),D0
02:0003A73C 0200000D        	  5389:     andi.b #$0D,D0
02:0003A740 6716            	  5390:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A742 10342070        	  5391:     move.b  ($70,A4,D2.W),D0
02:0003A746 023C00EE        	  5392:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A74A 123C0010        	  5393:     move.b  #$10,D1
02:0003A74E D101            	  5394:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A750 19802070        	  5395:     move.b  D0,($70,A4,D2.W)
02:0003A754 163C00F0        	  5396:     move.b  #$F0,D3
                            	  5397:     even
                            	  5398: _L_z04_UpdateDodongoState0_Move_Move:
02:0003A758 1003            	  5399:     move.b  D3,D0
02:0003A75A 1B00            	  5400:     move.b  D0,-(A5)  ; PHA
02:0003A75C 7020            	  5401:     moveq   #32,D0
02:0003A75E 41EC041F        	  5402:     lea     ($041F,A4),A0
02:0003A762 11802000        	  5403:     move.b  D0,(A0,D2.W)
02:0003A766 6100DB48        	  5404:     jsr     Wanderer_TargetPlayer
                            	  5405:     ; Pop the offset and add it to the X coordinate.
                            	  5406:     ;
                            	  5407:     ; This brings the X coordinate back to the unique value
                            	  5408:     ; that represents the position.
                            	  5409:     ;
02:0003A76A 101D            	  5410:     move.b  (A5)+,D0  ; PLA
