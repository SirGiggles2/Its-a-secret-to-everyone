                            	  4636: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  4637:     ; Digdogger is big, but room boundary checks and
                            	  4638:     ; object collision checks assume a 16x16 monster or smaller.
                            	  4639:     ; Therefore, we have to check these things four times,
                            	  4640:     ; in different corners of the boss.
                            	  4641:     ;
                            	  4642:     ; Loop 4 times, from 0 to 3.
                            	  4643:     ;
02:0003A152 7600            	  4644:     moveq   #0,D3
02:0003A154 41EC0478        	  4645:     lea     ($0478,A4),A0
02:0003A158 16302000        	  4646:     move.b  (A0,D2.W),D3
                            	  4647:     ; Change the coordinates to one corner.
                            	  4648:     ;
02:0003A15C 10342070        	  4649:     move.b  ($70,A4,D2.W),D0
02:0003A160 023C00EE        	  4650:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A164 41F90003A018    	  4651:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A16A 12303000        	  4652:     move.b  (A0,D3.W),D1
02:0003A16E D101            	  4653:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A170 19802070        	  4654:     move.b  D0,($70,A4,D2.W)
02:0003A174 41EC0084        	  4655:     lea     ($0084,A4),A0
02:0003A178 10302000        	  4656:     move.b  (A0,D2.W),D0
02:0003A17C 023C00EE        	  4657:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A180 41F90003A01C    	  4658:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A186 12303000        	  4659:     move.b  (A0,D3.W),D1
02:0003A18A D101            	  4660:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A18C 41EC0084        	  4661:     lea     ($0084,A4),A0
02:0003A190 11802000        	  4662:     move.b  D0,(A0,D2.W)
                            	  4663:     ; Check the room boundary and object collisions in this temporary location.
                            	  4664:     ;
02:0003A194 610029E0        	  4665:     jsr     BoundFlyer
02:0003A198 4EB900031028    	  4666:     jsr     CheckMonsterCollisions
                            	  4667:     ; Increase the loop index, and loop again until it = 4.
                            	  4668:     ;
02:0003A19E 41EC0478        	  4669:     lea     ($0478,A4),A0
02:0003A1A2 52302000        	  4670:     addq.b  #1,(A0,D2.W)
02:0003A1A6 41EC0478        	  4671:     lea     ($0478,A4),A0
02:0003A1AA 10302000        	  4672:     move.b  (A0,D2.W),D0
02:0003A1AE 0C000004        	  4673:     cmpi.b  #$04,D0
02:0003A1B2 659E            	  4674:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  4675:     ; Restore the original coordinates.
                            	  4676:     ;
