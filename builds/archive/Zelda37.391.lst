02:00030D0C 162C000E        	  2153:     move.b  ($000E,A4),D3
02:00030D10 7001            	  2154:     moveq   #1,D0
02:00030D12 19400007        	  2155:     move.b  D0,($0007,A4)
02:00030D16 7008            	  2156:     moveq   #8,D0
