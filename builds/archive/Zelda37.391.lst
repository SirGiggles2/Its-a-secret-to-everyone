                            	  5319:     ; State $1x. Fly away from the thrower.
                            	  5320:     ;
                            	  5321:     ; Reset [0E], which will indicate:
                            	  5322:     ; - into MoveShot:   0 update grid offset, else don't
                            	  5323:     ; - out of MoveShot: $80 if blocked
