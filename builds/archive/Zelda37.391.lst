02:00049508 7600            	  5839:     moveq   #0,D3
02:0004950A 1600            	  5840:     move.b  D0,D3
02:0004950C 7000            	  5841:     moveq   #0,D0
02:0004950E 19400001        	  5842:     move.b  D0,($0001,A4)
02:00049512 41F900049100    	  5843:     lea     (BoomerangFrameCycle).l,A0
02:00049518 10303000        	  5844:     move.b  (A0,D3.W),D0
02:0004951C 1940000C        	  5845:     move.b  D0,($000C,A4)
                            	  5846:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5847:     ;
02:00049520 1003            	  5848:     move.b  D3,D0
02:00049522 41F90004910A    	  5849:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:00049528 10303000        	  5850:     move.b  (A0,D3.W),D0
02:0004952C 19400004        	  5851:     move.b  D0,($0004,A4)
                            	  5852:     ; TODO: ?
                            	  5853:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5854:     ; Else add the item value of the magic boomerang.
                            	  5855:     ;
                            	  5856:     ; But none of the values in the base sprite attributes array is 8.
                            	  5857:     ;
                            	  5858:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5859:     ; the inventory will always be added to the base sprite attribute.
                            	  5860:     ;
                            	  5861:     ; So, palette row 4 or 5 will be chosen.
                            	  5862:     ;
02:00049530 7600            	  5863:     moveq   #0,D3
02:00049532 0C000008        	  5864:     cmpi.b  #$08,D0
02:00049536 6706            	  5865:     beq  _anon_z07_31
02:00049538 7600            	  5866:     moveq   #0,D3
