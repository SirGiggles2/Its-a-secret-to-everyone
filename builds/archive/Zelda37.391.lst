02:00038EA0 41EC034F        	  1948:     lea     ($034F,A4),A0
02:00038EA4 10302000        	  1949:     move.b  (A0,D2.W),D0
02:00038EA8 0C000011        	  1950:     cmpi.b  #$11,D0
02:00038EAC 6614            	  1951:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038EAE 41EC00AC        	  1952:     lea     ($00AC,A4),A0
02:00038EB2 10302000        	  1953:     move.b  (A0,D2.W),D0
02:00038EB6 0C000002        	  1954:     cmpi.b  #$02,D0
02:00038EBA 6714            	  1955:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00038EBC 0C000004        	  1956:     cmpi.b  #$04,D0
