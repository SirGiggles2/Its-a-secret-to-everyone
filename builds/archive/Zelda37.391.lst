                            	  2073: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  2074:     ; Begin with the leever's Y set to Link's Y.
                            	  2075:     ;
02:00038F8E 102C0084        	  2076:     move.b  ($0084,A4),D0
02:00038F92 41EC0084        	  2077:     lea     ($0084,A4),A0
02:00038F96 11802000        	  2078:     move.b  D0,(A0,D2.W)
                            	  2079:     ; If Y coordinate < $5D (top of the third square row), then
                            	  2080:     ; it's too close to the top edge of the screen. So, return.
                            	  2081:     ;
02:00038F9A 0C00005D        	  2082:     cmpi.b  #$5D,D0
02:00038F9E 65EC            	  2083:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  2084:     ; If facing right, then use X offset $28.
                            	  2085:     ; Else store X offset -$28 in [00].
                            	  2086:     ;
02:00038FA0 7628            	  2087:     moveq   #40,D3
02:00038FA2 41EC0098        	  2088:     lea     ($0098,A4),A0
02:00038FA6 10302000        	  2089:     move.b  (A0,D2.W),D0
02:00038FAA 02000002        	  2090:     andi.b #$02,D0
02:00038FAE 6704            	  2091:     beq  _anon_z04_45
02:00038FB0 163C00D8        	  2092:     move.b  #$D8,D3
                            	  2093: _anon_z04_45:
02:00038FB4 1883            	  2094:     move.b  D3,($0000,A4)
                            	  2095:     ; [01] holds Link's X coordinate.
                            	  2096:     ;
02:00038FB6 102C0070        	  2097:     move.b  ($0070,A4),D0
02:00038FBA 19400001        	  2098:     move.b  D0,($0001,A4)
                            	  2099:     ; Add Link's X and the horizontal offset.
                            	  2100:     ;
02:00038FBE 023C00EE        	  2101:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038FC2 1214            	  2102:     move.b  ($0000,A4),D1
02:00038FC4 D101            	  2103:     addx.b  D1,D0   ; ADC $00
                            	  2104:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  2105:     ;
02:00038FC6 020000F8        	  2106:     andi.b #$F8,D0
                            	  2107:     ; Assign that result to the leever's X coordinate and [02].
                            	  2108:     ;
02:00038FCA 19802070        	  2109:     move.b  D0,($70,A4,D2.W)
02:00038FCE 19400002        	  2110:     move.b  D0,($0002,A4)
                            	  2111:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  2112:     ;
02:00038FD2 122C0001        	  2113:     move.b  ($0001,A4),D1
02:00038FD6 B001            	  2114:     cmp.b   D1,D0
02:00038FD8 6510            	  2115:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038FDA 1B00            	  2116:     move.b  D0,-(A5)  ; PHA
02:00038FDC 102C0001        	  2117:     move.b  ($0001,A4),D0
02:00038FE0 19400002        	  2118:     move.b  D0,($0002,A4)
02:00038FE4 101D            	  2119:     move.b  (A5)+,D0  ; PLA
02:00038FE6 19400001        	  2120:     move.b  D0,($0001,A4)
                            	  2121:     even
                            	  2122: _L_z04_UpdateRedLeever_Subtract:
                            	  2123:     ; The point is to get the absolute distance between the two.
                            	  2124:     ;
02:00038FEA 102C0001        	  2125:     move.b  ($0001,A4),D0
02:00038FEE 003C0011        	  2126:     ori     #$11,CCR  ; SEC: set C+X
02:00038FF2 122C0002        	  2127:     move.b  ($0002,A4),D1
02:00038FF6 0A3C0010        	  2128:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038FFA 9101            	  2129:     subx.b  D1,D0   ; SBC $02
02:00038FFC 0A3C0010        	  2130:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2131:     ; If the absolute distance >= $30, then return.
                            	  2132:     ; It means that the leever's X coordinate wrapped around
                            	  2133:     ; the left or right edge of the screen.
                            	  2134:     ;
02:00039000 0C000030        	  2135:     cmpi.b  #$30,D0
02:00039004 6486            	  2136:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2137:     even
                            	  2138: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  2139:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  2140:     ;
02:00039006 4EB900048596    	  2141:     jsr     GetCollidableTileStill
02:0003900C 122C034A        	  2142:     move.b  ($034A,A4),D1
02:00039010 B001            	  2143:     cmp.b   D1,D0
02:00039012 6400FF78        	  2144:     bcc  _L_z04_UpdateRedLeever_Exit
02:00039016 522C0510        	  2145:     addq.b  #1,($0510,A4)
                            	  2146:     ; Set animation counter to 1, so that it will roll over this frame
                            	  2147:     ; and pick up whatever the new value is for state 1.
                            	  2148:     ;
02:0003901A 7001            	  2149:     moveq   #1,D0
02:0003901C 41EC03D0        	  2150:     lea     ($03D0,A4),A0
02:00039020 11802000        	  2151:     move.b  D0,(A0,D2.W)
                            	  2152:     ; Set the long timer to 2, meaning 20 frames.
                            	  2153:     ;
02:00039024 E308            	  2154:     lsl.b  #1,D0   ; ASL A
02:00039026 1940004D        	  2155:     move.b  D0,($004D,A4)
02:0003902A 6100008C        	  2156:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  2157:     ; The leever has to face Link in order to move toward him.
                            	  2158:     ;
02:0003902E 4EB900048B46    	  2159:     jsr     ReverseObjDir
                            	  2160:     even
                            	  2161: _L_z04_UpdateRedLeever_CheckOtherStates:
