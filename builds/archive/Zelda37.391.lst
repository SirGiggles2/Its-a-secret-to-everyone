                            	   524: UpdateBlock0Idle:
                            	   525:     ; If there are monsters in the room, go reset the push timer and return.
                            	   526:     ;
02:000384B0 102C034D        	   527:     move.b  ($034D,A4),D0
02:000384B4 6604            	   528:     bne.s  __far_z_04_0000
02:000384B6 600000D6        	   529:     jmp  ResetPushTimer
                            	   530: __far_z_04_0000:
                            	   531:     ; If Link's X is aligned with the block's, then get the difference
                            	   532:     ; between Link's (Y + 3) and the block's Y.
                            	   533:     ; Then go test the difference.
                            	   534:     ;
02:000384BA 102C0070        	   535:     move.b  ($0070,A4),D0
02:000384BE 12342070        	   536:     move.b  ($70,A4,D2.W),D1
02:000384C2 B001            	   537:     cmp.b   D1,D0
