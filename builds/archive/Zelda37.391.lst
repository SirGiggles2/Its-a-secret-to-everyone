                            	  3794: DoorwayRequiredCoord:
02:0003EEAE 78              	  3795:     dc.b    $78, $78, $8D, $8D
02:0003EEAF 78
02:0003EEB0 8D
02:0003EEB1 8D
                            	  3796: 
                            	  3797: ; Player coordinate must be >= these bounds.
                            	  3798: ; Using these bounds; the player will be considered within the
                            	  3799: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3800: ;
                            	  3801:     even
                            	  3802: DoorwayBoundsMinOver:
02:0003EEB2 3D              	  3803:     dc.b    $3D, $BD, $00, $CF
02:0003EEB3 BD
02:0003EEB4 00
02:0003EEB5 CF
                            	  3804: 
                            	  3805: ; Player coordinate must be < these bounds.
                            	  3806: ; Using these bounds; the player will be considered within the
                            	  3807: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3808: ;
                            	  3809:     even
                            	  3810: DoorwayBoundsMaxOver:
02:0003EEB6 5E              	  3811:     dc.b    $5E, $DE, $21, $F1
02:0003EEB7 DE
02:0003EEB8 21
02:0003EEB9 F1
                            	  3812: 
                            	  3813: ; Player coordinate must be >= these bounds.
                            	  3814: ; Using these bounds; the player will be considered within the
                            	  3815: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3816: ; at the edge.
                            	  3817: ;
                            	  3818:     even
                            	  3819: DoorwayBoundsMinUnder:
02:0003EEBA 3D              	  3820:     dc.b    $3D, $BF, $00, $D2
02:0003EEBB BF
02:0003EEBC 00
02:0003EEBD D2
                            	  3821: 
                            	  3822: ; Player coordinate must be < these bounds.
                            	  3823: ; Using these bounds; the player will be considered within the
                            	  3824: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3825: ; at the edge.
                            	  3826: ;
                            	  3827:     even
                            	  3828: DoorwayBoundsMaxUnder:
02:0003EEBE 5C              	  3829:     dc.b    $5C, $DE, $1F, $F1
02:0003EEBF DE
02:0003EEC0 1F
02:0003EEC1 F1
                            	  3830: 
                            	  3831: ; Params:
                            	  3832: ; [0F]: moving direction
                            	  3833: ;
                            	  3834: ; Returns:
                            	  3835: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3836: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3837: ;
                            	  3838: ; When not at or in a doorway, this function leaves
                            	  3839: ; [0F] moving direction as is.
                            	  3840: ;
                            	  3841: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3842: ; will be left as is, assuming that it had been reset before this
                            	  3843: ; routine by BoundByRoom.
                            	  3844: ;
                            	  3845: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3846: ;
                            	  3847: ;
                            	  3848: ; If already in a doorway, go handle it separately.
                            	  3849: ;
                            	  3850:     even
                            	  3851: CheckDoorway:
02:0003EEC2 102C0053        	  3852:     move.b  ($0053,A4),D0
02:0003EEC6 6648            	  3853:     bne  _L_z05_CheckDoorway_InDoorway
                            	  3854:     even
                            	  3855: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  3856:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  3857:     ;
                            	  3858:     ; To match a doorway:
                            	  3859:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  3860:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  3861:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  3862:     ;
                            	  3863:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  3864:     ; a doorway to be part of it.
                            	  3865:     ;
02:0003EEC8 102C0098        	  3866:     move.b  ($0098,A4),D0
02:0003EECC 61000122        	  3867:     jsr     GetPlayerCoordsForDirection
02:0003EED0 7603            	  3868:     moveq   #3,D3
                            	  3869:     even
                            	  3870: _L_z05_CheckDoorway_LoopOverflowBounds:
02:0003EED2 1014            	  3871:     move.b  ($0000,A4),D0
