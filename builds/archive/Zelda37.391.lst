02:0003C0C4 41EC0394        	  8740:     lea     ($0394,A4),A0
02:0003C0C8 11802000        	  8741:     move.b  D0,(A0,D2.W)
                            	  8742:     ; This location is right above Patra.
                            	  8743:     ; Set X coordinate to Patra's.
                            	  8744:     ;
02:0003C0CC 102C0071        	  8745:     move.b  ($0071,A4),D0
02:0003C0D0 19802070        	  8746:     move.b  D0,($70,A4,D2.W)
                            	  8747:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  8748:     ; Else use radius $18. Store the chosen value in [00].
