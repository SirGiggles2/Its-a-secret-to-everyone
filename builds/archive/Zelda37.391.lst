02:00035120 6508            	  4835:     bcs  _anon_z02_39
02:00035122 194000FC        	  4836:     move.b  D0,($00FC,A4)
02:00035126 522C00E2        	  4837:     addq.b  #1,($00E2,A4)
                            	  4838: _anon_z02_39:
