                            	  8919:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8920:     ;
02:0003C21C 102C051C        	  8921:     move.b  ($051C,A4),D0
02:0003C220 0200000F        	  8922:     andi.b #$0F,D0
02:0003C224 0C000004        	  8923:     cmpi.b  #$04,D0
02:0003C228 6702            	  8924:     beq.s  __far_z_04_0097
