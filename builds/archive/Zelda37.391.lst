02:0003884E 41EC0451        	  1019:     lea     ($0451,A4),A0
02:00038852 11802000        	  1020:     move.b  D0,(A0,D2.W)
                            	  1021:     ; Second, load the vertical direction into [0F].
                            	  1022:     ;
02:00038856 41EC0437        	  1023:     lea     ($0437,A4),A0
02:0003885A 10302000        	  1024:     move.b  (A0,D2.W),D0
02:0003885E 1940000F        	  1025:     move.b  D0,($000F,A4)
                            	  1026:     ; Load the vertical q-speed and position fraction,
                            	  1027:     ; move, then save the position fraction.
                            	  1028:     ;
02:00038862 41EC0444        	  1029:     lea     ($0444,A4),A0
02:00038866 10302000        	  1030:     move.b  (A0,D2.W),D0
02:0003886A 7600            	  1031:     moveq   #0,D3
02:0003886C 41EC045E        	  1032:     lea     ($045E,A4),A0
02:00038870 16302000        	  1033:     move.b  (A0,D2.W),D3
