02:0003D204 19410006        	   481:     move.b  D1,($0006,A4)
02:0003D208 669E            	   482:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003D20A 522C00E1        	   483:     addq.b  #1,($00E1,A4)
02:0003D20E 4E75            	   484:     rts
