                            	  3622: _L_z07_ShoveMoveMin_ChooseSpeed:
                            	  3623:     ; If the direction is right or down, store 1 in [02], else -1.
                            	  3624:     ; This is the amount to change the relevant coordinate by.
                            	  3625:     ;
02:00048688 7601            	  3626:     moveq   #1,D3
02:0004868A 41EC00C0        	  3627:     lea     ($00C0,A4),A0
02:0004868E 10302000        	  3628:     move.b  (A0,D2.W),D0
02:00048692 02000005        	  3629:     andi.b #$05,D0
02:00048696 6604            	  3630:     bne  _anon_z07_13
02:00048698 163C00FF        	  3631:     move.b  #$FF,D3
                            	  3632: _anon_z07_13:
02:0004869C 19430002        	  3633:     move.b  D3,($0002,A4)
                            	  3634:     ; We're OK to change the position. So, decrease the distance
                            	  3635:     ; that's left to move.
                            	  3636:     ;
02:000486A0 41EC00D3        	  3637:     lea     ($00D3,A4),A0
02:000486A4 53302000        	  3638:     subq.b  #1,(A0,D2.W)
                            	  3639:     ; Change the grid offset by the amount in [02] (1, -1).
                            	  3640:     ;
02:000486A8 41EC0394        	  3641:     lea     ($0394,A4),A0
02:000486AC 10302000        	  3642:     move.b  (A0,D2.W),D0
02:000486B0 023C00EE        	  3643:     andi    #$EE,CCR  ; CLC: clear C+X
02:000486B4 122C0002        	  3644:     move.b  ($0002,A4),D1
02:000486B8 D101            	  3645:     addx.b  D1,D0   ; ADC $02
02:000486BA 41EC0394        	  3646:     lea     ($0394,A4),A0
02:000486BE 11802000        	  3647:     move.b  D0,(A0,D2.W)
                            	  3648:     ; If grid offset is a multiple of $10, or the object is Link and grid offset
                            	  3649:     ; is a multiple of 8, then reset grid offset.
                            	  3650:     ;
