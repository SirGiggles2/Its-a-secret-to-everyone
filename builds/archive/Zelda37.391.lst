02:00042144 162C00EB        	  8715:     move.b  ($00EB,A4),D3
02:00042148 1214            	  8716:     move.b  ($00,A4),D1   ; ptr lo
02:0004214A 182C0001        	  8717:     move.b  ($01,A4),D4  ; ptr hi
02:0004214E 024100FF        	  8718:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042152 E14C            	  8719:     lsl.w   #8,D4
02:00042154 8841            	  8720:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042156 48C4            	  8721:     ext.l   D4
