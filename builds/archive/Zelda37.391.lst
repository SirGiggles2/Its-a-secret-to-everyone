02:00038CB2 610005BC        	  1696:     jsr     DrawObjectNotMirroredAndCheckLinkCollision
                            	  1697:     ; If the boulder's Y < $F0, return.
                            	  1698:     ;
02:00038CB6 41EC0084        	  1699:     lea     ($0084,A4),A0
02:00038CBA 10302000        	  1700:     move.b  (A0,D2.W),D0
02:00038CBE 0C0000F0        	  1701:     cmpi.b  #$F0,D0
02:00038CC2 6402            	  1702:     bcc.s  __far_z_04_0015
02:00038CC4 6032            	  1703:     jmp  L10A10_Exit
                            	  1704: __far_z_04_0015:
                            	  1705:     ; Else the boulder is close enough to the bottom of the screen
