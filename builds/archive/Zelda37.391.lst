                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:00049022 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:00049024 19400003        	  5123:     move.b  D0,($0003,A4)
02:00049028 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004902A 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004902E 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:00049030 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:00049032 7600            	  5136:     moveq   #0,D3
02:00049034 1600            	  5137:     move.b  D0,D3
02:00049036 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004903A 6602            	  5139:     bne  _anon_z07_25
02:0004903C 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:0004903E 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:00049042 4600            	  5143:     eori.b #$FF,D0
02:00049044 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049048 123C0001        	  5145:     move.b  #$01,D1
02:0004904C D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004904E 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:00049052 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:00049054 7600            	  5151:     moveq   #0,D3
02:00049056 1600            	  5152:     move.b  D0,D3
02:00049058 5303            	  5153:     subq.b  #1,D3
02:0004905A 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
