02:00048EDC 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:00048EDE 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:00048EE2 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:00048EE4 102C0513        	  4956:     move.b  ($0513,A4),D0
02:00048EE8 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:00048EEA 7000            	  4958:     moveq   #0,D0
02:00048EEC 19400513        	  4959:     move.b  D0,($0513,A4)
02:00048EF0 4EB900030946    	  4960:     jsr     WieldCandle
02:00048EF6 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:00048EF8 19400513        	  4962:     move.b  D0,($0513,A4)
02:00048EFC 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:00048EFE 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:00048F02 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:00048F06 10302000        	  4972:     move.b  (A0,D2.W),D0
02:00048F0A 0C000021        	  4973:     cmpi.b  #$21,D0
02:00048F0E 6702            	  4974:     beq.s  __far_z_07_0076
02:00048F10 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
