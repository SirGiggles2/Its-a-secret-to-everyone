                            	  2616:     ;
02:0003932E 7003            	  2617:     moveq   #3,D0
02:00039330 41EC0394        	  2618:     lea     ($0394,A4),A0
02:00039334 11802000        	  2619:     move.b  D0,(A0,D2.W)
                            	  2620:     ; Set a speed (q-speed fraction) randomly:
                            	  2621:     ; $20 if random value < $80
                            	  2622:     ; $60 otherwise
                            	  2623:     ;
02:00039338 7020            	  2624:     moveq   #32,D0
02:0003933A 7600            	  2625:     moveq   #0,D3
02:0003933C 16342019        	  2626:     move.b  ($19,A4,D2.W),D3
