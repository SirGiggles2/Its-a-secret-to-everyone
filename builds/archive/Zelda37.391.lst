                            	   346: _L_z04_Exit_SetDirTowardTarget:
                            	   347:     ; Set the monster's facing direction to the chosen direction
                            	   348:     ; toward the chase target.
                            	   349:     ;
02:00038376 41EC0098        	   350:     lea     ($0098,A4),A0
02:0003837A 11832000        	   351:     move.b  D3,(A0,D2.W)
                            	   352:     ; Set turn timer to a random value.
                            	   353:     ;
02:0003837E 10342018        	   354:     move.b  ($18,A4,D2.W),D0
02:00038382 41EC0478        	   355:     lea     ($0478,A4),A0
02:00038386 11802000        	   356:     move.b  D0,(A0,D2.W)
                            	   357:     ; Set "wants to shoot" flag to 1.
                            	   358:     ;
02:0003838A 7001            	   359:     moveq   #1,D0
02:0003838C 41EC0412        	   360:     lea     ($0412,A4),A0
02:00038390 11802000        	   361:     move.b  D0,(A0,D2.W)
                            	   362:     ; Go set input direction to facing direction.
                            	   363:     ;
