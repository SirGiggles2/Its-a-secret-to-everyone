02:00038E00 1600            	  1869:     move.b  D0,D3
02:00038E02 41F900038D7C    	  1870:     lea     (BlueLeeverStateQSpeeds).l,A0
02:00038E08 10303000        	  1871:     move.b  (A0,D3.W),D0
02:00038E0C 41EC03BC        	  1872:     lea     ($03BC,A4),A0
02:00038E10 11802000        	  1873:     move.b  D0,(A0,D2.W)
02:00038E14 41F900038D82    	  1874:     lea     (BlueLeeverStateTimes).l,A0
02:00038E1A 10303000        	  1875:     move.b  (A0,D3.W),D0
02:00038E1E 19802028        	  1876:     move.b  D0,($28,A4,D2.W)
                            	  1877:     even
