02:0002C8FC 08000008        	  3829:     btst    #8,D0
02:0002C900 6706            	  3830:     beq.s   .cc_aqspf
02:0002C902 003C0011        	  3831:     ori     #$11,CCR
02:0002C906 4E75            	  3832:     rts
                            	  3833: .cc_aqspf:
02:0002C908 023C00EE        	  3834:     andi    #$EE,CCR
02:0002C90C 4E75            	  3835:     rts
