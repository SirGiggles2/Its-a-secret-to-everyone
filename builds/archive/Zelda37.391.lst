02:00039EA2 1B00            	  4186:     move.b  D0,-(A5)  ; PHA
02:00039EA4 10342028        	  4187:     move.b  ($28,A4,D2.W),D0
02:00039EA8 1B00            	  4188:     move.b  D0,-(A5)  ; PHA
02:00039EAA 4EB900031028    	  4189:     jsr     CheckMonsterCollisions
02:00039EB0 101D            	  4190:     move.b  (A5)+,D0  ; PLA
02:00039EB2 19802028        	  4191:     move.b  D0,($28,A4,D2.W)
02:00039EB6 101D            	  4192:     move.b  (A5)+,D0  ; PLA
02:00039EB8 41EC0098        	  4193:     lea     ($0098,A4),A0
02:00039EBC 11802000        	  4194:     move.b  D0,(A0,D2.W)
                            	  4195:     ; If this segment is still alive, then return.
                            	  4196:     ;
02:00039EC0 41EC0405        	  4197:     lea     ($0405,A4),A0
02:00039EC4 10302000        	  4198:     move.b  (A0,D2.W),D0
02:00039EC8 6774            	  4199:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4200:     ; This segment is dead. We'll swap the tail segment with this
                            	  4201:     ; dead segment. This way, moldorm heads are always rooted
                            	  4202:     ; in slots 5 and $A; and the segments are continguous.
                            	  4203:     ;
                            	  4204:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  4205:     ;
                            	  4206:     ; Note that this is not a true swap, because the tail's HP
                            	  4207:     ; might be less than $20.
                            	  4208:     ;
02:00039ECA 7020            	  4209:     moveq   #32,D0
02:00039ECC 41EC0485        	  4210:     lea     ($0485,A4),A0
02:00039ED0 11802000        	  4211:     move.b  D0,(A0,D2.W)
02:00039ED4 61000608        	  4212:     jsr     CheckBossHitReaction
                            	  4213:     ; Look for the tail segment, starting from the low end
                            	  4214:     ; of the chain that this dead segment belongs to.
                            	  4215:     ;
02:00039ED8 163C00FF        	  4216:     move.b  #$FF,D3
02:00039EDC 0C020006        	  4217:     cmpi.b  #$06,D2
02:00039EE0 6502            	  4218:     bcs  _anon_z04_80
02:00039EE2 7604            	  4219:     moveq   #4,D3
                            	  4220: _anon_z04_80:
02:00039EE4 5203            	  4221:     addq.b  #1,D3
02:00039EE6 41EC0350        	  4222:     lea     ($0350,A4),A0
02:00039EEA 10303000        	  4223:     move.b  (A0,D3.W),D0
02:00039EEE 0C000041        	  4224:     cmpi.b  #$41,D0
02:00039EF2 66F0            	  4225:     bne  _anon_z04_80
                            	  4226:     ; I don't know why the object timer of the tail segment that will
                            	  4227:     ; be made dead is set to $11. By setting its object type to $5D
                            	  4228:     ; below, its metastate will become $10 -- dying/dead. From
                            	  4229:     ; there, the object timer is set to 6.
                            	  4230:     ;
02:00039EF4 7011            	  4231:     moveq   #17,D0
02:00039EF6 19803029        	  4232:     move.b  D0,($29,A4,D3.W)
                            	  4233:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  4234:     ; segment to the tail segment.
                            	  4235:     ;
02:00039EFA 41EC04F0        	  4236:     lea     ($04F0,A4),A0
02:00039EFE 10302000        	  4237:     move.b  (A0,D2.W),D0
02:00039F02 41EC04F1        	  4238:     lea     ($04F1,A4),A0
02:00039F06 11803000        	  4239:     move.b  D0,(A0,D3.W)
02:00039F0A 10342070        	  4240:     move.b  ($70,A4,D2.W),D0
02:00039F0E 19803071        	  4241:     move.b  D0,($71,A4,D3.W)
02:00039F12 41EC0084        	  4242:     lea     ($0084,A4),A0
02:00039F16 10302000        	  4243:     move.b  (A0,D2.W),D0
02:00039F1A 41EC0085        	  4244:     lea     ($0085,A4),A0
02:00039F1E 11803000        	  4245:     move.b  D0,(A0,D3.W)
                            	  4246:     ; If the tail segment found is also a head, then
