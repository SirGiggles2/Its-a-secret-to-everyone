02:00048BBE 0C000005        	  4527:     cmpi.b  #$05,D0
02:00048BC2 650C            	  4528:     bcs  _L_z07_Link_EndMoveAndAnimate_CheckWarpsAndAnimate
                            	  4529:     ; If Link's grid offset = 0, go see whether we need to wield the ladder.
                            	  4530:     ; If Link's grid offset is not a multiple of 8, go check warps and animate.
