02:00038DE4 023C00EE        	  1857:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038DE8 123C0001        	  1858:     move.b  #$01,D1
02:00038DEC D101            	  1859:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038DEE 0C000006        	  1860:     cmpi.b  #$06,D0
02:00038DF2 6502            	  1861:     bcs  _anon_z04_41
02:00038DF4 7000            	  1862:     moveq   #0,D0
                            	  1863: _anon_z04_41:
02:00038DF6 41EC00AC        	  1864:     lea     ($00AC,A4),A0
02:00038DFA 11802000        	  1865:     move.b  D0,(A0,D2.W)
