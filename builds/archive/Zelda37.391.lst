                            	  6084: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6085:     ; Store the weapon's frame (horizontal or vertical)
                            	  6086:     ; for the direction chosen above in [0C].
                            	  6087:     ;
02:000496EE 4EB9000308EC    	  6088:     jsr     GetOppositeDir
02:000496F4 41F900049128    	  6089:     lea     (RDirectionToWeaponFrame).l,A0
02:000496FA 10303000        	  6090:     move.b  (A0,D3.W),D0
02:000496FE 1940000C        	  6091:     move.b  D0,($000C,A4)
                            	  6092:     ; Calculate sprite attributes.
                            	  6093:     ;
                            	  6094:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6095:     ;   base attribute OR 1
                            	  6096:     ; So, it uses palette row 5.
                            	  6097:     ;
02:00049702 41F90004912C    	  6098:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049708 10303000        	  6099:     move.b  (A0,D3.W),D0
02:0004970C 0C02000D        	  6100:     cmpi.b  #$0D,D2
02:00049710 6706            	  6101:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00049712 00000001        	  6102:     ori.b #$01,D0
02:00049716 601C            	  6103:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6104: 
