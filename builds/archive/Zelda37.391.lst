                            	  5443: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5444:     ; Bloated timer =>
                            	  5445:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5446:     ; 1:     go advance the substate
                            	  5447:     ; other: go decrement Bloated timer
                            	  5448:     ;
02:0003A7B8 7600            	  5449:     moveq   #0,D3
02:0003A7BA 41EC045E        	  5450:     lea     ($045E,A4),A0
02:0003A7BE 16302000        	  5451:     move.b  (A0,D2.W),D3
02:0003A7C2 5303            	  5452:     subq.b  #1,D3
02:0003A7C4 6750            	  5453:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A7C6 6B04            	  5454:     bmi.s  __far_z_04_0049
02:0003A7C8 60000080        	  5455:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5456: __far_z_04_0049:
                            	  5457:     ; Set the bloated timer according to the substate.
                            	  5458:     ;
02:0003A7CC 7600            	  5459:     moveq   #0,D3
02:0003A7CE 41EC042C        	  5460:     lea     ($042C,A4),A0
02:0003A7D2 16302000        	  5461:     move.b  (A0,D2.W),D3
02:0003A7D6 41F90003A714    	  5462:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A7DC 10303000        	  5463:     move.b  (A0,D3.W),D0
02:0003A7E0 41EC045E        	  5464:     lea     ($045E,A4),A0
02:0003A7E4 11802000        	  5465:     move.b  D0,(A0,D2.W)
                            	  5466:     ; If substate <> 0, go decrement bloated timer.
                            	  5467:     ;
02:0003A7E8 4A03            	  5468:     cmpi.b  #$00,D3
02:0003A7EA 6702            	  5469:     beq.s  __far_z_04_0050
02:0003A7EC 605C            	  5470:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5471: __far_z_04_0050:
                            	  5472:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5473:     ;
02:0003A7EE 7610            	  5474:     moveq   #16,D3
02:0003A7F0 7000            	  5475:     moveq   #0,D0
02:0003A7F2 41EC00AC        	  5476:     lea     ($00AC,A4),A0
02:0003A7F6 11803000        	  5477:     move.b  D0,(A0,D3.W)
                            	  5478:     ; Increment the number of bomb hits.
                            	  5479:     ;
02:0003A7FA 41EC0437        	  5480:     lea     ($0437,A4),A0
02:0003A7FE 10302000        	  5481:     move.b  (A0,D2.W),D0
02:0003A802 023C00EE        	  5482:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A806 123C0001        	  5483:     move.b  #$01,D1
02:0003A80A D101            	  5484:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A80C 41EC0437        	  5485:     lea     ($0437,A4),A0
02:0003A810 11802000        	  5486:     move.b  D0,(A0,D2.W)
02:0003A814 6034            	  5487:     jmp     L_Dodongo_DecrementBloatedTimer
