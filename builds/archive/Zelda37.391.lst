                            	  2472: ;==============================================================================
                            	  2473: ; EXPORT side — carry-returning shims.
                            	  2474: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2475: ; reproduces the original function's carry normalization.
                            	  2476: ;==============================================================================
                            	  2477: 
                            	  2478: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2479: c_copy_next_row_to_transfer_buf:
