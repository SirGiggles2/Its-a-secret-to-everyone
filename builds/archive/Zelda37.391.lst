02:00047CEE 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:00047CF2 1014            	  2375:     move.b  ($0000,A4),D0
02:00047CF4 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00047CF8 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00047CFC 41EC0307        	  2378:     lea     ($0307,A4),A0
02:00047D00 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:00047D04 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00047D08 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00047D0C 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:00047D10 41EC0308        	  2386:     lea     ($0308,A4),A0
02:00047D14 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00047D18 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00047D1C 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:00047D20 102C0005        	  2392:     move.b  ($0005,A4),D0
02:00047D24 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00047D28 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00047D2C 41EC0306        	  2395:     lea     ($0306,A4),A0
02:00047D30 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:00047D34 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00047D38 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00047D3C 41EC030B        	  2399:     lea     ($030B,A4),A0
02:00047D40 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
                            	  2404:     ;   record 1: $70, $71
                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:00047D44 0C000046        	  2407:     cmpi.b  #$46,D0
02:00047D48 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047D4A 0C0000F3        	  2409:     cmpi.b  #$F3,D0
