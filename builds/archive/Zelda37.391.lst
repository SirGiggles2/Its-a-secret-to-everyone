                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:00049066 41EC0098        	  5166:     lea     ($0098,A4),A0
02:0004906A 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004906E 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:00049072 6702            	  5169:     beq.s  __far_z_07_0077
02:00049074 6004            	  5170:     jmp  L1F49F_Exit
