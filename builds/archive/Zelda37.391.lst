02:000407A4 19400001        	  5875:     move.b  D0,($0001,A4)
                            	  5876:     ; Return the direction of the door in [09], and the dynamic
                            	  5877:     ; transfer buf length in X register.
                            	  5878:     ;
02:000407A8 19420009        	  5879:     move.b  D2,($0009,A4)
02:000407AC 7400            	  5880:     moveq   #0,D2
02:000407AE 142C0301        	  5881:     move.b  ($0301,A4),D2
                            	  5882:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
