                            	  1832: 
                            	  1833: ; Each byte describes an item. The high nibble is the type.
                            	  1834: ; The low nibble is the value. Its meaning depends on the type.
                            	  1835: ;
                            	  1836: ; 0x - individuals
                            	  1837: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  1838: ; * bit mask: value doesn't matter.
                            	  1839: ;
                            	  1840: ; 1x - amounts
                            	  1841: ; Value is an amount to add.
                            	  1842: ;
                            	  1843: ; 2x - grades
                            	  1844: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  1845: ;
                            	  1846: ; 3x - error?
                            	  1847: ; Produces an item value of $FF.
                            	  1848: ;
                            	  1849:     even
