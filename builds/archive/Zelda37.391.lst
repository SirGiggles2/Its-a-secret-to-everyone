                            	    25: ;   D2 = 6502 X  (X index register)
                            	    26: ;   D3 = 6502 Y  (Y index register)
                            	    27: ;   D4,D5 = scratch (used by indirect addressing sequences)
                            	    28: ;   D6 = scratch
                            	    29: ;   D7 = 6502 SP shadow (NES stack pointer, $0100 area)
                            	    30: ;   A4 = NES RAM base ($FF0000) — init by genesis_shell.asm
                            	    31: ;   A5 = NES stack pointer ($FF0200 initially, grows downward)
                            	    32: ;==============================================================================
                            	    33: 
                            	    34: NES_RAM         equ $FF0000
                            	    35: NES_SRAM        equ $FF6000
                            	    36: NES_STACK_BASE  equ $FF0100
                            	    37: 
