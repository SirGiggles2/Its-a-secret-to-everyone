02:0004935C 11802000        	  5609:     move.b  D0,(A0,D2.W)
                            	  5610:     ; If facing left and X < 2, then go change state to $40. The
                            	  5611:     ; boomerang is too close to the left edge of the screen.
                            	  5612:     ; Another move might make it wrap around.
                            	  5613:     ;
02:00049360 41EC0098        	  5614:     lea     ($0098,A4),A0
02:00049364 10302000        	  5615:     move.b  (A0,D2.W),D0
02:00049368 1940000F        	  5616:     move.b  D0,($000F,A4)
02:0004936C 02000002        	  5617:     andi.b #$02,D0
