                            	  5383: _L_z07_UpdateArrowOrBoomerang_CompareLimit:
                            	  5384:     ; For boomerangs, compare it to the movement limit.
                            	  5385:     ; If it reached the limit, set state $20 and a new movement
                            	  5386:     ; limit of $10, and go handle the rest as if blocked.
                            	  5387:     ; State $20 will become $30 below in HandleArrowOrBoomerangBlocked.
                            	  5388:     ;
                            	  5389:     ; Otherwise, only animate and check collision as usual.
                            	  5390:     ;
                            	  5391:     ; In major state $30, ObjMovingLimit is a timer to change the state to $40.
                            	  5392:     ;
02:000491D6 41EC0380        	  5393:     lea     ($0380,A4),A0
02:000491DA 12302000        	  5394:     move.b  (A0,D2.W),D1
02:000491DE B001            	  5395:     cmp.b   D1,D0
02:000491E0 6518            	  5396:     bcs  _L_z07_UpdateArrowOrBoomerang_AnimateBoomerang
