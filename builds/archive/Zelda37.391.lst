                            	  2430: DrawGhiniAndCheckCollisions:
02:0003922E 4EB900049C54    	  2431:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00039234 1940000D        	  2432:     move.b  D0,($000D,A4)
                            	  2433:     ; If the direction has an "up" component, then keep the
                            	  2434:     ; frame image 0, and go figure out horizontal flipping.
                            	  2435:     ;
02:00039238 41EC0098        	  2436:     lea     ($0098,A4),A0
02:0003923C 10302000        	  2437:     move.b  (A0,D2.W),D0
02:00039240 02000008        	  2438:     andi.b #$08,D0
02:00039244 6614            	  2439:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  2440:     ; Else make the frame image 1 for the "down" frame.
                            	  2441:     ; Note that this is the frame image to use, even if there's no
                            	  2442:     ; down component in the direction.
                            	  2443:     ;
02:00039246 522C000D        	  2444:     addq.b  #1,($000D,A4)
                            	  2445:     ; If right is a component of the direction, then go set horizontal
                            	  2446:     ; flipping. Else leave horizontal flipping = 0.
                            	  2447:     ;
02:0003924A 41EC0098        	  2448:     lea     ($0098,A4),A0
02:0003924E 10302000        	  2449:     move.b  (A0,D2.W),D0
02:00039252 02000001        	  2450:     andi.b #$01,D0
02:00039256 6714            	  2451:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:00039258 660E            	  2452:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  2453:     even
                            	  2454: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  2455:     ; Set horizontal flipping if right is a direction component.
                            	  2456:     ; This essentially the same test as above, but for when we jump
                            	  2457:     ; from the "up" test.
                            	  2458:     ;
02:0003925A 41EC0098        	  2459:     lea     ($0098,A4),A0
02:0003925E 10302000        	  2460:     move.b  (A0,D2.W),D0
02:00039262 02000002        	  2461:     andi.b #$02,D0
02:00039266 6704            	  2462:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  2463:     even
                            	  2464: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:00039268 522C000F        	  2465:     addq.b  #1,($000F,A4)
                            	  2466:     even
                            	  2467: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003926C 102C000D        	  2468:     move.b  ($000D,A4),D0
                            	  2469: ; Params:
                            	  2470: ; A: frame image
                            	  2471: ; X: object index
                            	  2472: ; [00]: object X
                            	  2473: ; [01]: object Y
                            	  2474: ; [0F]: flip horizontally
                            	  2475: ;
                            	  2476: ; Returns:
                            	  2477: ; [00]: 0 for Link slot
                            	  2478: ; [06]: 1 if objects collide
                            	  2479: ; [09]: 0 for Link damage type (none)
                            	  2480: ; [0C]: 1 if objects collide
                            	  2481: ; [034B]: ShotCollidesWithLink
                            	  2482: ;
                            	  2483:     even
