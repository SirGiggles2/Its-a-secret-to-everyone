02:00048FE8 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:00048FEA 41EC0084        	  5092:     lea     ($0084,A4),A0
02:00048FEE 10302000        	  5093:     move.b  (A0,D2.W),D0
02:00048FF2 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048FF6 122C0003        	  5095:     move.b  ($0003,A4),D1
02:00048FFA D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:00048FFC 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:00049000 7600            	  5100:     moveq   #0,D3
02:00049002 162C0010        	  5101:     move.b  ($0010,A4),D3
02:00049006 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:00049008 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004900C 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004900E 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:00049012 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:00049014 7002            	  5112:     moveq   #2,D0
02:00049016 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004901A 7623            	  5114:     moveq   #35,D3
02:0004901C 4EB900030ECE    	  5115:     jsr     Anim_WriteItemSprites
