02:00048FB4 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048FB6 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:00048FBA 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:00048FBC 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:00048FC0 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:00048FC4 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048FC8 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:00048FCA 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:00048FCE 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:00048FD0 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:00048FD4 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:00048FD8 1214            	  5079:     move.b  ($0000,A4),D1
02:00048FDA 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048FDE 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:00048FE0 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
