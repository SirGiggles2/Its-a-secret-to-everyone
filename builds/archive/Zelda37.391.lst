                            	  2855: PondHeartStartAngles:
02:000394B0 14              	  2856:     dc.b    $14, $10, $0C, $08, $04, $00, $1C
02:000394B1 10
02:000394B2 0C
02:000394B3 08
02:000394B4 04
02:000394B5 00
02:000394B6 1C
                            	  2857: 
