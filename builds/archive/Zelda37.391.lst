02:00048E70 41F90004912C    	  4881:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048E76 12303000        	  4882:     move.b  (A0,D3.W),D1
02:00048E7A 8001            	  4883:     or.b  D1,D0
02:00048E7C 4EB900030FAE    	  4884:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4885:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
