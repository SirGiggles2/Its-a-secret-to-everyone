                            	  4342: 
                            	  4343: ; Params:
                            	  4344: ; [02:03]: address of door tiles for direction and face
                            	  4345: ; [04]: count of tiles remaining
                            	  4346: ; [07]: current index (0 to 3) of the tile to copy
                            	  4347: ;       to the dynamic transfer buf
                            	  4348: ; [09]: door direction index
                            	  4349: ;
                            	  4350: ; Returns:
                            	  4351: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4352: ; [04]: original value - 1
                            	  4353: ; [07]: original value + 1
                            	  4354: ;
                            	  4355: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4356: ; vertically. The point of this routine is to access them
                            	  4357: ; horizontally in order to transfer them to a nametable.
                            	  4358: ;
                            	  4359: ;
                            	  4360: ; For the direction index in [09], look up the base offset of the
                            	  4361: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4362: ; the door face tiles at [02:03].
                            	  4363: ;
                            	  4364:     even
                            	  4365: WriteDoorFaceTileHorizontally:
02:0003F33C 7600            	  4366:     moveq   #0,D3
02:0003F33E 162C0009        	  4367:     move.b  ($0009,A4),D3
02:0003F342 41F900040560    	  4368:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0003F348 10303000        	  4369:     move.b  (A0,D3.W),D0
                            	  4370:     ; Add [07] to the base offset we got above. This yields one
                            	  4371:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4372:     ;
02:0003F34C 023C00EE        	  4373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F350 122C0007        	  4374:     move.b  ($0007,A4),D1
02:0003F354 D101            	  4375:     addx.b  D1,D0   ; ADC $07
02:0003F356 7600            	  4376:     moveq   #0,D3
02:0003F358 1600            	  4377:     move.b  D0,D3
                            	  4378:     ; With that index, look up the index to use with the door face
                            	  4379:     ; list of tiles at [02:03].
                            	  4380:     ;
02:0003F35A 41F900040552    	  4381:     lea     (HorizontalDoorFaceIndexes).l,A0
02:0003F360 10303000        	  4382:     move.b  (A0,D3.W),D0
02:0003F364 7600            	  4383:     moveq   #0,D3
02:0003F366 1600            	  4384:     move.b  D0,D3
                            	  4385:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4386:     ; and copy it to the dynamic transfer buf.
                            	  4387:     ;
02:0003F368 122C0002        	  4388:     move.b  ($02,A4),D1   ; ptr lo
02:0003F36C 182C0003        	  4389:     move.b  ($03,A4),D4  ; ptr hi
02:0003F370 024100FF        	  4390:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003F374 E14C            	  4391:     lsl.w   #8,D4
02:0003F376 8841            	  4392:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003F378 48C4            	  4393:     ext.l   D4
02:0003F37A D8BC00FF0000    	  4394:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003F380 2044            	  4395:     movea.l D4,A0
02:0003F382 10303000        	  4396:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003F386 41EC0302        	  4397:     lea     ($0302,A4),A0
02:0003F38A 11802000        	  4398:     move.b  D0,(A0,D2.W)
                            	  4399:     ; Prepare for the next call:
                            	  4400:     ; - increment dynamic transfer buf pointer
                            	  4401:     ; - increment index of tile to copy [07]
                            	  4402:     ; - decrement count of tiles remaining
                            	  4403:     ;
02:0003F38E 5202            	  4404:     addq.b  #1,D2
02:0003F390 522C0007        	  4405:     addq.b  #1,($0007,A4)
02:0003F394 532C0004        	  4406:     subq.b  #1,($0004,A4)
02:0003F398 4E75            	  4407:     rts
                            	  4408: 
                            	  4409:     even
