02:00047D5A 41EC030A        	  2414:     lea     ($030A,A4),A0
02:00047D5E 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:00047D62 41EC030B        	  2416:     lea     ($030B,A4),A0
02:00047D66 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:00047D6A 41EC0306        	  2418:     lea     ($0306,A4),A0
02:00047D6E 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:00047D72 41EC030B        	  2420:     lea     ($030B,A4),A0
