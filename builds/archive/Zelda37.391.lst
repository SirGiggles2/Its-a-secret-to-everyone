                            	   255: _anon_z04_7:
                            	   256:     ; If speed = 0, or the object is between squares;
                            	   257:     ; then go set input direction to facing direction.
                            	   258:     ;
02:000382B6 41EC03BC        	   259:     lea     ($03BC,A4),A0
02:000382BA 10302000        	   260:     move.b  (A0,D2.W),D0
02:000382BE 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:000382C2 41EC0394        	   262:     lea     ($0394,A4),A0
02:000382C6 10302000        	   263:     move.b  (A0,D2.W),D0
02:000382CA 0200000F        	   264:     andi.b #$0F,D0
02:000382CE 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:000382D2 41EC0394        	   268:     lea     ($0394,A4),A0
02:000382D6 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:000382DA 41EC041F        	   273:     lea     ($041F,A4),A0
02:000382DE 10302000        	   274:     move.b  (A0,D2.W),D0
02:000382E2 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:000382E6 B001            	   276:     cmp.b   D1,D0
02:000382E8 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:000382EC 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:000382F0 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:000382F4 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:000382F8 102C0061        	   284:     move.b  ($0061,A4),D0
02:000382FC 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:00038300 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:00038304 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038308 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:0003830A 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:0003830E 6A0C            	   290:     bpl  _anon_z04_8
02:00038310 4600            	   291:     eori.b #$FF,D0
02:00038312 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038316 123C0001        	   293:     move.b  #$01,D1
02:0003831A D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
                            	   297:     ;
02:0003831C 0C000009        	   298:     cmpi.b  #$09,D0
02:00038320 6416            	   299:     bcc  _L_z04_Exit_CheckVerticalDistance
                            	   300:     even
                            	   301: _L_z04_Exit_TurnVertically:
                            	   302:     ; Choose a vertical direction toward the chase target.
                            	   303:     ; Then go face in this direction, and flag to shoot.
                            	   304:     ;
02:00038322 7608            	   305:     moveq   #8,D3
02:00038324 102C0062        	   306:     move.b  ($0062,A4),D0
02:00038328 41EC0084        	   307:     lea     ($0084,A4),A0
02:0003832C 12302000        	   308:     move.b  (A0,D2.W),D1
02:00038330 B001            	   309:     cmp.b   D1,D0
02:00038332 6542            	   310:     bcs  _L_z04_Exit_SetDirTowardTarget
02:00038334 7604            	   311:     moveq   #4,D3
02:00038336 663E            	   312:     bne  _L_z04_Exit_SetDirTowardTarget
                            	   313:     even
                            	   314: _L_z04_Exit_CheckVerticalDistance:
                            	   315:     ; Get the absolute vertical distance between
                            	   316:     ; the monster and the chase target.
                            	   317:     ;
02:00038338 102C0062        	   318:     move.b  ($0062,A4),D0
02:0003833C 003C0011        	   319:     ori     #$11,CCR  ; SEC: set C+X
02:00038340 41EC0084        	   320:     lea     ($0084,A4),A0
02:00038344 12302000        	   321:     move.b  (A0,D2.W),D1
02:00038348 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003834C 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:0003834E 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
02:00038352 6A0C            	   325:     bpl  _anon_z04_9
02:00038354 4600            	   326:     eori.b #$FF,D0
02:00038356 023C00EE        	   327:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003835A 123C0001        	   328:     move.b  #$01,D1
02:0003835E D101            	   329:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   330: _anon_z04_9:
                            	   331:     ; If distance >= 9, then go turn if turn timer has expired.
