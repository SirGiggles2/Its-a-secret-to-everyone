                            	  7294: _anon_z04_111:
                            	  7295:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  7296:     ; frame := ((accumulator AND $10) >> 4
                            	  7297:     ;
02:0003B5DE 41EC0451        	  7298:     lea     ($0451,A4),A0
02:0003B5E2 10302000        	  7299:     move.b  (A0,D2.W),D0
02:0003B5E6 02000010        	  7300:     andi.b #$10,D0
02:0003B5EA E208            	  7301:     lsr.b  #1,D0   ; LSR A
02:0003B5EC E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0003B5EE E208            	  7303:     lsr.b  #1,D0   ; LSR A
02:0003B5F0 E208            	  7304:     lsr.b  #1,D0   ; LSR A
02:0003B5F2 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Copy the animation frame bit into the "frame image and
                            	  7307:     ; sprite attributes" byte.
                            	  7308:     ;
02:0003B5F4 41EC0478        	  7309:     lea     ($0478,A4),A0
02:0003B5F8 10302000        	  7310:     move.b  (A0,D2.W),D0
02:0003B5FC 020000FE        	  7311:     andi.b #$FE,D0
02:0003B600 1214            	  7312:     move.b  ($0000,A4),D1
02:0003B602 8001            	  7313:     or.b  D1,D0
02:0003B604 41EC0478        	  7314:     lea     ($0478,A4),A0
02:0003B608 11802000        	  7315:     move.b  D0,(A0,D2.W)
                            	  7316:     ; If this segment is the base, then go draw.
                            	  7317:     ;
02:0003B60C 0C020005        	  7318:     cmpi.b  #$05,D2
02:0003B610 6736            	  7319:     beq  _L_z04_UpdateManhandla_Draw
                            	  7320:     ; If the old and new "frame image and sprite attributes" variables
                            	  7321:     ; are the same, then go draw.
                            	  7322:     ;
                            	  7323:     ; The previous frame value begins with value 0, because all
                            	  7324:     ; room data was reset on entry.
                            	  7325:     ;
02:0003B612 41EC0478        	  7326:     lea     ($0478,A4),A0
02:0003B616 10302000        	  7327:     move.b  (A0,D2.W),D0
02:0003B61A 41EC0437        	  7328:     lea     ($0437,A4),A0
02:0003B61E 12302000        	  7329:     move.b  (A0,D2.W),D1
02:0003B622 B001            	  7330:     cmp.b   D1,D0
02:0003B624 6722            	  7331:     beq  _L_z04_UpdateManhandla_Draw
                            	  7332:     ; Copy the new value to the old variable, so that they're the same.
                            	  7333:     ;
02:0003B626 41EC0437        	  7334:     lea     ($0437,A4),A0
02:0003B62A 11802000        	  7335:     move.b  D0,(A0,D2.W)
                            	  7336:     ; If animation frame = 1, then go draw.
                            	  7337:     ;
                            	  7338:     ; The low bit of "frame image and sprite attributes" byte
                            	  7339:     ; represents the animation frame.
                            	  7340:     ;
02:0003B62E E208            	  7341:     lsr.b  #1,D0   ; LSR A
02:0003B630 6516            	  7342:     bcs  _L_z04_UpdateManhandla_Draw
                            	  7343:     ; If the random value for the next slot up < $E0,
                            	  7344:     ; or there's an object in slot 7; then go draw.
                            	  7345:     ;
                            	  7346:     ; The second condition keeps the number of fireballs <= 4.
                            	  7347:     ;
02:0003B632 10342019        	  7348:     move.b  ($19,A4,D2.W),D0
02:0003B636 0C0000E0        	  7349:     cmpi.b  #$E0,D0
02:0003B63A 650C            	  7350:     bcs  _L_z04_UpdateManhandla_Draw
02:0003B63C 102C0356        	  7351:     move.b  ($0356,A4),D0
