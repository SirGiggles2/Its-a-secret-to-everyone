                            	   887: __far_z_04_0011:
                            	   888: ; Params:
                            	   889: ; X: monster object index
                            	   890: ;
                            	   891: ; Returns:
                            	   892: ; [00]: 0 for Link slot
                            	   893: ; [06]: 1 if objects collide
                            	   894: ; [09]: 0 for Link damage type (none)
