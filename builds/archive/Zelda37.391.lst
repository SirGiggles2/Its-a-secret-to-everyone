                            	 10352: TurnTowardsPlayer8:
                            	 10353:     ; Build a direction in [00] towards the player.
                            	 10354:     ;
                            	 10355:     ; First, calculate a horizontal component:
                            	 10356:     ;
                            	 10357:     ; If   observed player X = object X, [00] := 0 (none)
                            	 10358:     ; elif observed player X > object X, [00] := 1 (right)
                            	 10359:     ; else                               [00] := 2 (left)
                            	 10360:     ;
02:0003CC08 7600            	 10361:     moveq   #0,D3
02:0003CC0A 1883            	 10362:     move.b  D3,($0000,A4)
02:0003CC0C 5203            	 10363:     addq.b  #1,D3
02:0003CC0E 102C0061        	 10364:     move.b  ($0061,A4),D0
02:0003CC12 12342070        	 10365:     move.b  ($70,A4,D2.W),D1
02:0003CC16 B001            	 10366:     cmp.b   D1,D0
02:0003CC18 6706            	 10367:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003CC1A 6402            	 10368:     bcc  _anon_z04_175
02:0003CC1C 5203            	 10369:     addq.b  #1,D3
                            	 10370: _anon_z04_175:
