02:000391BA 023C00EE        	  2366:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391BE 41EC03E4        	  2367:     lea     ($03E4,A4),A0
02:000391C2 12302000        	  2368:     move.b  (A0,D2.W),D1
02:000391C6 D101            	  2369:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000391C8 1B00            	  2370:     move.b  D0,-(A5)  ; PHA
                            	  2371:     ; If facing vertically, go draw mirrored.
                            	  2372:     ;
02:000391CA 41EC0098        	  2373:     lea     ($0098,A4),A0
02:000391CE 10302000        	  2374:     move.b  (A0,D2.W),D0
02:000391D2 0200000C        	  2375:     andi.b #$0C,D0
02:000391D6 660E            	  2376:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2377:     ; Else draw not mirrored.
                            	  2378:     ;
02:000391D8 101D            	  2379:     move.b  (A5)+,D0  ; PLA
02:000391DA 4EB900030CBC    	  2380:     jsr     DrawObjectNotMirrored
02:000391E0 4EF900031028    	  2381:     jmp     CheckMonsterCollisions
                            	  2382: 
                            	  2383:     even
