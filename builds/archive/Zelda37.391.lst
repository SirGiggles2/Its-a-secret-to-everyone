02:000496D8 0200000F        	  6075:     andi.b #$0F,D0
02:000496DC 7600            	  6076:     moveq   #0,D3
02:000496DE 1600            	  6077:     move.b  D0,D3
02:000496E0 7008            	  6078:     moveq   #8,D0
