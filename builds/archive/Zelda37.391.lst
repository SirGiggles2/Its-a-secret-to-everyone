                            	  3487: Obj_Shove:
                            	  3488:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3489:     ; then go handle it separately.
                            	  3490:     ;
02:000485B0 41EC00C0        	  3491:     lea     ($00C0,A4),A0
02:000485B4 10302000        	  3492:     move.b  (A0,D2.W),D0
02:000485B8 E308            	  3493:     lsl.b  #1,D0   ; ASL A
02:000485BA 6448            	  3494:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3495:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3496:     ;
02:000485BC E208            	  3497:     lsr.b  #1,D0   ; LSR A
02:000485BE 41EC00C0        	  3498:     lea     ($00C0,A4),A0
02:000485C2 11802000        	  3499:     move.b  D0,(A0,D2.W)
                            	  3500:     ; If the object faces horizontally, go check which axis shove
                            	  3501:     ; direction is on.
                            	  3502:     ;
02:000485C6 7600            	  3503:     moveq   #0,D3
02:000485C8 41EC0098        	  3504:     lea     ($0098,A4),A0
02:000485CC 16302000        	  3505:     move.b  (A0,D2.W),D3
02:000485D0 0C030003        	  3506:     cmpi.b  #$03,D3
02:000485D4 6526            	  3507:     bcs  _L_z07_Obj_Shove_FacingHorizontally
                            	  3508:     ; The object faces vertically.
                            	  3509:     ;
                            	  3510:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3511:     ;
02:000485D6 02000003        	  3512:     andi.b #$03,D0
02:000485DA 671E            	  3513:     beq  _L_z07_Obj_Shove_Exit
                            	  3514:     even
                            	  3515: _L_z07_Obj_Shove_CheckPerpendicularShove:
