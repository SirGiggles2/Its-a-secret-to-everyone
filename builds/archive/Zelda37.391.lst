02:0003C0F2 1214            	  8764:     move.b  ($0000,A4),D1
02:0003C0F4 0A3C0010        	  8765:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C0F8 9101            	  8766:     subx.b  D1,D0   ; SBC $00
02:0003C0FA 0A3C0010        	  8767:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C0FE 41EC0084        	  8768:     lea     ($0084,A4),A0
02:0003C102 11802000        	  8769:     move.b  D0,(A0,D2.W)
                            	  8770:     even
