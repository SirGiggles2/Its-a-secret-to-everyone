02:00040784 9101            	  5862:     subx.b  D1,D0   ; SBC $03
02:00040786 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5864:     ; Call this to put the address of door face tiles in [02:03].
                            	  5865:     ;
02:0004078A 6100FD7A        	  5866:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5867:     ; Return the address of the door in the nametable in [01:00].
