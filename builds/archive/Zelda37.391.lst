                            	  4177:     ;
02:00039E8C 7002            	  4178:     moveq   #2,D0
02:00039E8E 19400003        	  4179:     move.b  D0,($0003,A4)
02:00039E92 7044            	  4180:     moveq   #68,D0
02:00039E94 4EB900030FB8    	  4181:     jsr     Anim_WriteSprite
                            	  4182:     ; Check collisions, but never let them interfere with movement.
