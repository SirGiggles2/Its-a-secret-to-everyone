02:0003B68C 7601            	  7399:     moveq   #1,D3
02:0003B68E 6102            	  7400:     jsr     Gohma_DrawLegsOneSide
                            	  7401:     ; Draw the left legs.
                            	  7402:     ;
02:0003B690 7600            	  7403:     moveq   #0,D3
                            	  7404: ; Params:
                            	  7405: ; Y: side: 0 for left, 1 for right
                            	  7406: ;
                            	  7407: ; Add the horizontal offset for the current side to Gohma's X to
                            	  7408: ; store the sprite's X in [00].
                            	  7409: ;
                            	  7410:     even
                            	  7411: Gohma_DrawLegsOneSide:
02:0003B692 10342070        	  7412:     move.b  ($70,A4,D2.W),D0
02:0003B696 023C00EE        	  7413:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B69A 41F90003B670    	  7414:     lea     (GohmaLegOffsetsX).l,A0
02:0003B6A0 12303000        	  7415:     move.b  (A0,D3.W),D1
02:0003B6A4 D101            	  7416:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B6A6 1880            	  7417:     move.b  D0,($0000,A4)
                            	  7418:     ; The object's Y is the sprite's.
                            	  7419:     ;
02:0003B6A8 41EC0084        	  7420:     lea     ($0084,A4),A0
02:0003B6AC 10302000        	  7421:     move.b  (A0,D2.W),D0
02:0003B6B0 19400001        	  7422:     move.b  D0,($0001,A4)
02:0003B6B4 612A            	  7423:     jsr     Gohma_SetSpriteAttributes
                            	  7424:     ; There are only two frame images for legs: left and right.
                            	  7425:     ; There are two animation frames. They are animated as follows:
                            	  7426:     ;
                            	  7427:     ; Frame 0:
                            	  7428:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  7429:     ; horizontal flipping = frame number = 0
                            	  7430:     ; 
                            	  7431:     ; Frame 1:
                            	  7432:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  7433:     ; horizontal flipping = frame number = 1
                            	  7434:     ;
02:0003B6B6 4EB900049C26    	  7435:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B6BC 1003            	  7436:     move.b  D3,D0
02:0003B6BE 023C00EE        	  7437:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6C2 41EC03E4        	  7438:     lea     ($03E4,A4),A0
02:0003B6C6 12302000        	  7439:     move.b  (A0,D2.W),D1
02:0003B6CA D101            	  7440:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B6CC 02000001        	  7441:     andi.b #$01,D0
02:0003B6D0 023C00EE        	  7442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6D4 123C0004        	  7443:     move.b  #$04,D1
02:0003B6D8 D101            	  7444:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B6DA 4EF900030CBC    	  7445:     jmp     DrawObjectNotMirrored
                            	  7446: 
                            	  7447: ; Returns:
