02:00030CB6 6004            	  2062:     jmp     DrawObjectNotMirrored
                            	  2063: 
                            	  2064: ; Params:
                            	  2065: ; A: frame image
                            	  2066: ; X: object index
                            	  2067: ; [00]: object X
                            	  2068: ; [01]: object Y
                            	  2069: ;
                            	  2070: ;
                            	  2071: ; Set [0C] mirrored.
                            	  2072:     even
                            	  2073: DrawObjectMirrored:
02:00030CB8 7601            	  2074:     moveq   #1,D3
02:00030CBA 6602            	  2075:     bne  _anon_z01_75
                            	  2076: ; Params:
                            	  2077: ; A: frame image
                            	  2078: ; X: object index
                            	  2079: ; [00]: object X
                            	  2080: ; [01]: object Y
                            	  2081: ; [0F]: flip horizontally
                            	  2082: ;
                            	  2083:     even
                            	  2084: DrawObjectNotMirrored:
02:00030CBC 7600            	  2085:     moveq   #0,D3
                            	  2086: _anon_z01_75:
02:00030CBE 1943000C        	  2087:     move.b  D3,($000C,A4)
                            	  2088:     ; Set animation index = object type + 1.
                            	  2089:     ;
02:00030CC2 7600            	  2090:     moveq   #0,D3
02:00030CC4 41EC034F        	  2091:     lea     ($034F,A4),A0
02:00030CC8 16302000        	  2092:     move.b  (A0,D2.W),D3
                            	  2093: ; Params:
                            	  2094: ; A: frame
                            	  2095: ; X: object index/cycle sprite index
                            	  2096: ; Y: object type
                            	  2097: ; [00]: object X
                            	  2098: ; [01]: object Y
                            	  2099: ; [0C]: mirrored
                            	  2100: ; [0F]: flip horizontally
                            	  2101: ;
                            	  2102: ; Note:
                            	  2103: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2104: ;
                            	  2105: ; The animation index of most objects is (object type + 1),
                            	  2106: ; to make up for the fact that Link uses two animation indexes.
                            	  2107: ;
                            	  2108:     even
                            	  2109: DrawObjectWithType:
02:00030CCC 5203            	  2110:     addq.b  #1,D3
                            	  2111: ; Params:
                            	  2112: ; A: frame
                            	  2113: ; X: object index/cycle sprite index
                            	  2114: ; Y: animation index
                            	  2115: ; [00]: object X
                            	  2116: ; [01]: object Y
                            	  2117: ; [0C]: mirrored
                            	  2118: ; [0F]: flip horizontally
                            	  2119: ;
                            	  2120: ; Note:
                            	  2121: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2122: ; But Link uses [0F] for flipping without checking [0C].
                            	  2123: ;
                            	  2124: ;
                            	  2125: ; [0D] holds frame.
                            	  2126:     even
                            	  2127: DrawObjectWithAnim:
02:00030CCE 1940000D        	  2128:     move.b  D0,($000D,A4)
02:00030CD2 1943000E        	  2129:     move.b  D3,($000E,A4)
02:00030CD6 19420008        	  2130:     move.b  D2,($0008,A4)
                            	  2131:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2132:     ;
02:00030CDA 7600            	  2133:     moveq   #0,D3
02:00030CDC 162C0341        	  2134:     move.b  ($0341,A4),D3
02:00030CE0 41F900030C84    	  2135:     lea     (SpriteOffsets).l,A0
02:00030CE6 10303000        	  2136:     move.b  (A0,D3.W),D0
02:00030CEA 19400343        	  2137:     move.b  D0,($0343,A4)
02:00030CEE 41F900030C85    	  2138:     lea     (SpriteOffsets+1).l,A0
02:00030CF4 10303000        	  2139:     move.b  (A0,D3.W),D0
                            	  2140:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  2141:     ;
02:00030CF8 4A02            	  2142:     cmpi.b  #$00,D2
02:00030CFA 6702            	  2143:     beq.s  __far_z_01_0001
02:00030CFC 6008            	  2144:     jmp  DrawObjectWithAnimAndSpecificSprites
