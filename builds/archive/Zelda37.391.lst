02:000421BC 61005868        	  8789:     jsr     GetRoomFlags
02:000421C0 023C00EE        	  8790:     andi    #$EE,CCR  ; CLC: clear C+X
02:000421C4 41F9000479FA    	  8791:     lea     (LevelMasks).l,A0
02:000421CA 12302000        	  8792:     move.b  (A0,D2.W),D1
02:000421CE C001            	  8793:     and.b  D1,D0
02:000421D0 6704            	  8794:     beq  _anon_z05_205
02:000421D2 003C0011        	  8795:     ori     #$11,CCR  ; SEC: set C+X
