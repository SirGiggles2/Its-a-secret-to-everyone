02:0003EF30 41F90003EEB6    	  3916:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EF36 12303000        	  3917:     move.b  (A0,D3.W),D1
02:0003EF3A B001            	  3918:     cmp.b   D1,D0
02:0003EF3C 640E            	  3919:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0003EF3E 102C0053        	  3920:     move.b  ($0053,A4),D0
02:0003EF42 122C0098        	  3921:     move.b  ($0098,A4),D1
02:0003EF46 B001            	  3922:     cmp.b   D1,D0
02:0003EF48 6700FF7E        	  3923:     beq  _L_z05_CheckDoorway_SearchOverflowBounds
