02:0003B07C 02000001        	  6735:     andi.b #$01,D0
02:0003B080 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B084 123C0004        	  6737:     move.b  #$04,D1
