                            	  5015:     ;
02:00048586 41EC0098        	  5016:     lea     ($0098,A4),A0
02:0004858A 10302000        	  5017:     move.b  (A0,D2.W),D0
02:0004858E 0C0000E8        	  5018:     cmpi.b  #$E8,D0
