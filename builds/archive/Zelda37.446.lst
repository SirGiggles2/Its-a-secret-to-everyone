02:00033830 41F9000330FE    	  2306:     lea     (ModeEandFCursorSprites).l,A0
02:00033836 10303000        	  2307:     move.b  (A0,D3.W),D0
02:0003383A 41EC0201        	  2308:     lea     ($0201,A4),A0
02:0003383E 11803000        	  2309:     move.b  D0,(A0,D3.W)
02:00033842 5303            	  2310:     subq.b  #1,D3
02:00033844 6AEA            	  2311:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033846 7600            	  2312:     moveq   #0,D3
02:00033848 162C0016        	  2313:     move.b  ($0016,A4),D3
02:0003384C 41F9000330B4    	  2314:     lea     (ModeEandFSlotCursorYs).l,A0
02:00033852 10303000        	  2315:     move.b  (A0,D3.W),D0
02:00033856 19400084        	  2316:     move.b  D0,($0084,A4)
02:0003385A 19400200        	  2317:     move.b  D0,($0200,A4)
02:0003385E 102C0012        	  2318:     move.b  ($0012,A4),D0
02:00033862 0C00000F        	  2319:     cmpi.b  #$0F,D0
                            	  2320:     ; There's more work in mode $E.
                            	  2321:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2322:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00033866 6736            	  2323:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00033868 103C00F3        	  2324:     move.b  #$F3,D0
02:0003386C 19400201        	  2325:     move.b  D0,($0201,A4)
                            	  2326:     ; Because the visible part of the cursor block sprite is
                            	  2327:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2328:     ; above its ObjY.
02:00033870 102C0084        	  2329:     move.b  ($0084,A4),D0
02:00033874 003C0011        	  2330:     ori     #$11,CCR  ; SEC: set C+X
02:00033878 123C0008        	  2331:     move.b  #$08,D1
02:0003387C 0A3C0010        	  2332:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00033880 9101            	  2333:     subx.b  D1,D0   ; SBC #$08
02:00033882 0A3C0010        	  2334:     eori    #$10,CCR  ; restore X = 6502 C
02:00033886 19400204        	  2335:     move.b  D0,($0204,A4)
02:0003388A 7070            	  2336:     moveq   #112,D0
02:0003388C 19400070        	  2337:     move.b  D0,($0070,A4)
02:00033890 103C0087        	  2338:     move.b  #$87,D0
02:00033894 19400085        	  2339:     move.b  D0,($0085,A4)
02:00033898 7030            	  2340:     moveq   #48,D0
02:0003389A 19400071        	  2341:     move.b  D0,($0071,A4)
                            	  2342:     even
