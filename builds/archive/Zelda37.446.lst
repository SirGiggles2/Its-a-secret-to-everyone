02:0004972C 1014            	  7347:     move.b  ($0000,A4),D0
02:0004972E 0C00006A        	  7348:     cmpi.b  #$6A,D0
02:00049732 650C            	  7349:     bcs  _L_z07_InitObject_CheckTileObj
02:00049734 7001            	  7350:     moveq   #1,D0
