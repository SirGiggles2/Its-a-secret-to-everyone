02:00038416 6502            	   590:     bcs.s  __far_z_04_0002
02:00038418 6050            	   591:     jmp  ResetPushTimer
                            	   592: __far_z_04_0002:
                            	   593:     ; At this point, Link is aligned with the block.
                            	   594:     ;
