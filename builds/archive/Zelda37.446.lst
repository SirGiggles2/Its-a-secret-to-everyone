02:0004181C 162C00EB        	  8549:     move.b  ($00EB,A4),D3
02:00041820 1214            	  8550:     move.b  ($00,A4),D1   ; ptr lo
02:00041822 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:00041826 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004182A E14C            	  8553:     lsl.w   #8,D4
02:0004182C 8841            	  8554:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004182E 48C4            	  8555:     ext.l   D4
02:00041830 D8BC00FF0000    	  8556:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041836 2044            	  8557:     movea.l D4,A0
02:00041838 10303000        	  8558:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004183C 02000020        	  8559:     andi.b #$20,D0
                            	  8560:     ; If it's been visited, then check each of the 4 doors,
