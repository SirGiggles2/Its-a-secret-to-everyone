02:000381F4 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:000381F8 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000381FC 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:000381FE 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:00038202 6A0C            	   290:     bpl  _anon_z04_8
02:00038204 4600            	   291:     eori.b #$FF,D0
02:00038206 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003820A 123C0001        	   293:     move.b  #$01,D1
02:0003820E D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
