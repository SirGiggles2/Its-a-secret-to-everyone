02:000336F2 7600            	  2149:     moveq   #0,D3
02:000336F4 162C0016        	  2150:     move.b  ($0016,A4),D3
02:000336F8 0C030003        	  2151:     cmpi.b  #$03,D3
02:000336FC 6602            	  2152:     bne.s  __far_z_02_0002
02:000336FE 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:00033700 41F900033114    	  2157:     lea     (SlotToNameOffset).l,A0
02:00033706 10303000        	  2158:     move.b  (A0,D3.W),D0
02:0003370A 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:0003370E 7400            	  2162:     moveq   #0,D2
02:00033710 41F900033118    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033716 14303000        	  2164:     move.b  (A0,D3.W),D2
02:0003371A 7602            	  2165:     moveq   #2,D3
                            	  2166:     even
                            	  2167: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:0003371C 41F9000330E4    	  2168:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00033722 10302000        	  2169:     move.b  (A0,D2.W),D0
02:00033726 41EC0422        	  2170:     lea     ($0422,A4),A0
02:0003372A 11803000        	  2171:     move.b  D0,(A0,D3.W)
02:0003372E 5302            	  2172:     subq.b  #1,D2
02:00033730 5303            	  2173:     subq.b  #1,D3
02:00033732 6AE8            	  2174:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033734 522C0420        	  2175:     addq.b  #1,($0420,A4)
                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:00033738 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:0003373C 020000C0        	  2186:     andi.b #$C0,D0
02:00033740 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:00033744 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033748 660000A6        	  2191:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2192:     ; A was pressed.
                            	  2193:     ;
                            	  2194:     ; Request to play the character click tune (same as bomb set).
02:0003374C 7620            	  2195:     moveq   #32,D3
02:0003374E 19430604        	  2196:     move.b  D3,($0604,A4)
02:00033752 7602            	  2197:     moveq   #2,D3
                            	  2198:     even
                            	  2199: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033754 41EC0422        	  2200:     lea     ($0422,A4),A0
02:00033758 10303000        	  2201:     move.b  (A0,D3.W),D0
02:0003375C 41EC0302        	  2202:     lea     ($0302,A4),A0
02:00033760 11803000        	  2203:     move.b  D0,(A0,D3.W)
02:00033764 5303            	  2204:     subq.b  #1,D3
02:00033766 6AEC            	  2205:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033768 19430306        	  2206:     move.b  D3,($0306,A4)
02:0003376C 7400            	  2207:     moveq   #0,D2
02:0003376E 142C0421        	  2208:     move.b  ($0421,A4),D2
02:00033772 7600            	  2209:     moveq   #0,D3
02:00033774 162C041F        	  2210:     move.b  ($041F,A4),D3
02:00033778 41F9000330B8    	  2211:     lea     (ModeE_CharMap).l,A0
02:0003377E 10303000        	  2212:     move.b  (A0,D3.W),D0
02:00033782 19400305        	  2213:     move.b  D0,($0305,A4)
02:00033786 41EC0638        	  2214:     lea     ($0638,A4),A0
