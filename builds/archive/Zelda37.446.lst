02:000381D6 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:000381DA B001            	   276:     cmp.b   D1,D0
02:000381DC 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:000381E0 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:000381E4 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:000381E8 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
