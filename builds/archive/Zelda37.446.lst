                            	  1626: ; Params:
                            	  1627: ; A: new value for animation counter, in case it rolls over
                            	  1628: ; X: object index
                            	  1629: ;
                            	  1630: ; Note:
                            	  1631: ; Advances the animation counter first.
                            	  1632: ;
                            	  1633:     even
                            	  1634: Burrower_AnimateDrawAndCheckCollisions:
02:00038B2E 4EB90004916E    	  1635:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  1636:     ; If state = 0, return.
                            	  1637:     ;
02:00038B34 41EC00AC        	  1638:     lea     ($00AC,A4),A0
02:00038B38 10302000        	  1639:     move.b  (A0,D2.W),D0
02:00038B3C 670000A8        	  1640:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1641:     ; If is zora, and state >= 2 and < 5, then use frame image 2 or 3
                            	  1642:     ; (front or back), which was stored in ObjDir above.
                            	  1643:     ;
02:00038B40 7600            	  1644:     moveq   #0,D3
02:00038B42 41EC034F        	  1645:     lea     ($034F,A4),A0
02:00038B46 16302000        	  1646:     move.b  (A0,D2.W),D3
02:00038B4A 0C030011        	  1647:     cmpi.b  #$11,D3
02:00038B4E 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B50 7600            	  1649:     moveq   #0,D3
02:00038B52 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:00038B56 16302000        	  1651:     move.b  (A0,D2.W),D3
02:00038B5A 0C030002        	  1652:     cmpi.b  #$02,D3
02:00038B5E 6510            	  1653:     bcs  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B60 0C030005        	  1654:     cmpi.b  #$05,D3
02:00038B64 640A            	  1655:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B66 41EC0098        	  1656:     lea     ($0098,A4),A0
02:00038B6A 10302000        	  1657:     move.b  (A0,D2.W),D0
02:00038B6E 6622            	  1658:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw
                            	  1659:     even
                            	  1660: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1661:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1662:     ; the mound frame images:
                            	  1663:     ;
                            	  1664:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1665:     ;
                            	  1666:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1667:     ;
                            	  1668:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1669:     ;
02:00038B70 003C0011        	  1670:     ori     #$11,CCR  ; SEC: set C+X
02:00038B74 123C0001        	  1671:     move.b  #$01,D1
02:00038B78 0A3C0010        	  1672:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038B7C 9101            	  1673:     subx.b  D1,D0   ; SBC #$01
02:00038B7E 0A3C0010        	  1674:     eori    #$10,CCR  ; restore X = 6502 C
02:00038B82 E308            	  1675:     lsl.b  #1,D0   ; ASL A
02:00038B84 023C00EE        	  1676:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B88 41EC03E4        	  1677:     lea     ($03E4,A4),A0
02:00038B8C 12302000        	  1678:     move.b  (A0,D2.W),D1
02:00038B90 D101            	  1679:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1680:     even
                            	  1681: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw:
02:00038B92 61008224        	  1682:     jsr     DrawObjectMirrored
                            	  1683:     ; If not zora and state <> 3, 
                            	  1684:     ; or zora and state <> 2, 3, 4;
                            	  1685:     ; then return.
                            	  1686:     ;
02:00038B96 41EC034F        	  1687:     lea     ($034F,A4),A0
02:00038B9A 10302000        	  1688:     move.b  (A0,D2.W),D0
02:00038B9E 0C000011        	  1689:     cmpi.b  #$11,D0
02:00038BA2 6614            	  1690:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038BA4 41EC00AC        	  1691:     lea     ($00AC,A4),A0
02:00038BA8 10302000        	  1692:     move.b  (A0,D2.W),D0
02:00038BAC 0C000002        	  1693:     cmpi.b  #$02,D0
02:00038BB0 6714            	  1694:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00038BB2 0C000004        	  1695:     cmpi.b  #$04,D0
02:00038BB6 670E            	  1696:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
                            	  1697:     even
                            	  1698: _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions:
02:00038BB8 41EC00AC        	  1699:     lea     ($00AC,A4),A0
02:00038BBC 10302000        	  1700:     move.b  (A0,D2.W),D0
02:00038BC0 0C000003        	  1701:     cmpi.b  #$03,D0
02:00038BC4 6620            	  1702:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1703:     even
                            	  1704: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions:
02:00038BC6 61008560        	  1705:     jsr     CheckMonsterCollisions
                            	  1706:     ; If not dying, then return.
                            	  1707:     ;
02:00038BCA 41EC0405        	  1708:     lea     ($0405,A4),A0
02:00038BCE 10302000        	  1709:     move.b  (A0,D2.W),D0
02:00038BD2 6712            	  1710:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1711:     ; If monster is a red leever, then decrement the red leever count.
                            	  1712:     ;
02:00038BD4 41EC034F        	  1713:     lea     ($034F,A4),A0
02:00038BD8 10302000        	  1714:     move.b  (A0,D2.W),D0
02:00038BDC 0C000010        	  1715:     cmpi.b  #$10,D0
02:00038BE0 6604            	  1716:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
02:00038BE2 532C0510        	  1717:     subq.b  #1,($0510,A4)
                            	  1718:     even
                            	  1719: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit:
02:00038BE6 4E75            	  1720:     rts
                            	  1721: 
                            	  1722:     even
                            	  1723: RedLeeverStateQSpeeds:
02:00038BE8 00              	  1724:     dc.b    $00, $00, $00, $20, $00, $00
02:00038BE9 00
02:00038BEA 00
02:00038BEB 20
02:00038BEC 00
02:00038BED 00
                            	  1725: 
                            	  1726:     even
                            	  1727: RedLeeverStateTimes:
02:00038BEE 00              	  1728:     dc.b    $00, $10, $08, $FF, $08, $10
02:00038BEF 10
02:00038BF0 08
02:00038BF1 FF
02:00038BF2 08
02:00038BF3 10
                            	  1729: 
                            	  1730:     even
                            	  1731: RedLeeverStateAnimTimes:
02:00038BF4 10              	  1732:     dc.b    $10, $08, $08, $05, $08, $08
02:00038BF5 08
02:00038BF6 08
02:00038BF7 05
02:00038BF8 08
02:00038BF9 08
