                            	  4169:     ; The code below applies to Link and other objects.
                            	  4170:     ;
                            	  4171:     ; Test the moving direction's walkability.
                            	  4172:     ;
                            	  4173:     ; For the player, this is enough. For other objects, this 
                            	  4174:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4175:     ;
