                            	  2104: DrawStatusBarItemsAndEnsureItemSelected:
                            	  2105:     ; Draws the selected item and the sword in the status bar.
                            	  2106:     ; Before drawing the item, it ensures that SelectedItemSlot
                            	  2107:     ; refers to an occupied, equippable item slot.
                            	  2108:     ;
                            	  2109:     ; This accounts for the fallback behavior between potions
                            	  2110:     ; and letters and the two boomerangs.
                            	  2111:     ;
                            	  2112:     ; Start at slot zero. Normally, it would be used to
                            	  2113:     ; check swords. When it's used as the selected item index;
                            	  2114:     ; it's a pseudo-slot used for checking boomerangs.
                            	  2115:     ;
02:00047144 7400            	  2116:     moveq   #0,D2
02:00047146 142C0656        	  2117:     move.b  ($0656,A4),D2
02:0004714A 6602            	  2118:     bne.s  __far_z_07_0011
02:0004714C 6040            	  2119:     jmp  DrawStatusBarBoomerang
