02:000409DC 10303000        	  6904:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000409E0 0C0000C4        	  6905:     cmpi.b  #$C4,D0
02:000409E4 6728            	  6906:     beq  _L_z05_CheckShortcut_WriteStairs
02:000409E6 0C0000BC        	  6907:     cmpi.b  #$BC,D0
02:000409EA 6720            	  6908:     beq  _L_z05_CheckShortcut_Exit
02:000409EC 0C0000D8        	  6909:     cmpi.b  #$D8,D0
02:000409F0 661C            	  6910:     bne  _L_z05_CheckShortcut_WriteStairs
02:000409F2 102C052B        	  6911:     move.b  ($052B,A4),D0
02:000409F6 0C000062        	  6912:     cmpi.b  #$62,D0
