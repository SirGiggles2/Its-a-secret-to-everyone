02:00039AEC 705D            	  3806:     moveq   #93,D0
02:00039AEE 41EC0350        	  3807:     lea     ($0350,A4),A0
02:00039AF2 11803000        	  3808:     move.b  D0,(A0,D3.W)
                            	  3809:     ; Reset the metastate of the current segment, so that it comes
