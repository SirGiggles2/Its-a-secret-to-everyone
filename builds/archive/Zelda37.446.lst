02:00038E36 7600            	  2033:     moveq   #0,D3
02:00038E38 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038E3C 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038E40 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038E44 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038E46 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038E4A 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038E4C E308            	  2040:     lsl.b  #1,D0   ; ASL A
