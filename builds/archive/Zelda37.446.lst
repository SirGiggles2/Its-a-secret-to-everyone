                            	  7173: _L_z07_InitObject_InitMonsterFromEdge:
02:000495B0 7400            	  7174:     moveq   #0,D2
02:000495B2 142C0340        	  7175:     move.b  ($0340,A4),D2
                            	  7176:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7177:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7178:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7179:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7180:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7181:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7182:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7183:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7184:     ; corrupting them and causing a deterministic address-error
                            	  7185:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7186:     ; identified by Codex static review.)
                            	  7187: _L_z07_P47_pre_check:
02:000495B6 102C0525        	  7188:     move.b  ($0525,A4),D0
02:000495BA 020000F0        	  7189:     andi.b  #$F0,D0
02:000495BE 0C000040        	  7190:     cmpi.b  #$40,D0
02:000495C2 6506            	  7191:     blo     _L_z07_P47_pre_snap
02:000495C4 0C0000E0        	  7192:     cmpi.b  #$E0,D0
02:000495C8 6506            	  7193:     blo     _L_z07_P47_pre_ok
                            	  7194: _L_z07_P47_pre_snap:
02:000495CA 197C00480525    	  7195:     move.b  #$48,($0525,A4)
                            	  7196: _L_z07_P47_pre_ok:
02:000495D0 7005            	  7197:     moveq   #5,D0
02:000495D2 610004F4        	  7198:     jsr     SwitchBank
02:000495D6 4EB90003E4D2    	  7199:     jsr     FindNextEdgeSpawnCell
                            	  7200:     ; Post-walk 1: bottom-edge snap.
02:000495DC 102C0525        	  7201:     move.b  ($0525,A4),D0
02:000495E0 020000F0        	  7202:     andi.b  #$F0,D0
02:000495E4 0C0000E0        	  7203:     cmpi.b  #$E0,D0
02:000495E8 660C            	  7204:     bne     _L_z07_P47_post1_ok
02:000495EA 197C00480525    	  7205:     move.b  #$48,($0525,A4)
02:000495F0 4EB90003E4D2    	  7206:     jsr     FindNextEdgeSpawnCell
                            	  7207: _L_z07_P47_post1_ok:
                            	  7208:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7209:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:000495F6 7600            	  7210:     moveq   #0,D3
02:000495F8 162C0525        	  7211:     move.b  ($0525,A4),D3
02:000495FC 0243000F        	  7212:     andi.w  #$000F,D3
02:00049600 C6FC002C        	  7213:     mulu.w  #44,D3
02:00049604 203C00FF6530    	  7214:     move.l  #$FF6530,D0
02:0004960A D083            	  7215:     add.l   D3,D0
02:0004960C 7600            	  7216:     moveq   #0,D3
02:0004960E 162C0525        	  7217:     move.b  ($0525,A4),D3
02:00049612 E84B            	  7218:     lsr.w   #4,D3
02:00049614 5943            	  7219:     subi.w  #4,D3
02:00049616 E34B            	  7220:     lsl.w   #1,D3
02:00049618 D083            	  7221:     add.l   D3,D0
02:0004961A 2040            	  7222:     movea.l D0,A0
02:0004961C 1010            	  7223:     move.b  (A0),D0
02:0004961E 0C000084        	  7224:     cmpi.b  #$84,D0
02:00049622 6544            	  7225:     blo     _L_z07_P47_post2_ok
                            	  7226:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7227:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7228:     ; writes to the $05xx region.
02:00049624 7800            	  7229:     moveq   #0,D4
                            	  7230: _L_z07_P47_fb_loop:
02:00049626 41FAE566        	  7231:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004962A 12304000        	  7232:     move.b  (A0,D4.W),D1
02:0004962E 19410525        	  7233:     move.b  D1,($0525,A4)
                            	  7234:     ; Validate fallback cell walkable.
02:00049632 7600            	  7235:     moveq   #0,D3
02:00049634 1601            	  7236:     move.b  D1,D3
02:00049636 0243000F        	  7237:     andi.w  #$000F,D3
02:0004963A C6FC002C        	  7238:     mulu.w  #44,D3
02:0004963E 203C00FF6530    	  7239:     move.l  #$FF6530,D0
02:00049644 D083            	  7240:     add.l   D3,D0
02:00049646 7600            	  7241:     moveq   #0,D3
02:00049648 1601            	  7242:     move.b  D1,D3
02:0004964A E84B            	  7243:     lsr.w   #4,D3
02:0004964C 5943            	  7244:     subi.w  #4,D3
02:0004964E E34B            	  7245:     lsl.w   #1,D3
02:00049650 D083            	  7246:     add.l   D3,D0
02:00049652 2040            	  7247:     movea.l D0,A0
02:00049654 0C100084        	  7248:     cmpi.b  #$84,(A0)
02:00049658 650E            	  7249:     blo     _L_z07_P47_post2_ok
02:0004965A 5204            	  7250:     addq.b  #1,D4
02:0004965C 0C040008        	  7251:     cmpi.b  #8,D4
02:00049660 65C4            	  7252:     blo     _L_z07_P47_fb_loop
                            	  7253:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7254:     ; rather than looping).
02:00049662 197C00480525    	  7255:     move.b  #$48,($0525,A4)
                            	  7256: _L_z07_P47_post2_ok:
                            	  7257:     ; Extract and set the monster's location.
                            	  7258:     ;
02:00049668 102C0525        	  7259:     move.b  ($0525,A4),D0
                            	  7260:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7261:     ;
02:0004966C 1B00            	  7262:     move.b  D0,-(A5)  ; PHA
02:0004966E E308            	  7263:     lsl.b  #1,D0   ; ASL A
02:00049670 E308            	  7264:     lsl.b  #1,D0   ; ASL A
02:00049672 E308            	  7265:     lsl.b  #1,D0   ; ASL A
02:00049674 E308            	  7266:     lsl.b  #1,D0   ; ASL A
02:00049676 19802070        	  7267:     move.b  D0,($70,A4,D2.W)
                            	  7268:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7269:     ;
02:0004967A 101D            	  7270:     move.b  (A5)+,D0  ; PLA
02:0004967C 020000F0        	  7271:     andi.b #$F0,D0
02:00049680 003C0011        	  7272:     ori     #$11,CCR  ; SEC: set C+X
02:00049684 123C0003        	  7273:     move.b  #$03,D1
02:00049688 0A3C0010        	  7274:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004968C 9101            	  7275:     subx.b  D1,D0   ; SBC #$03
02:0004968E 0A3C0010        	  7276:     eori    #$10,CCR  ; restore X = 6502 C
02:00049692 41EC0084        	  7277:     lea     ($0084,A4),A0
02:00049696 11802000        	  7278:     move.b  D0,(A0,D2.W)
                            	  7279:     ; Set the monsters-from-edges long timer to a random value
                            	  7280:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7281:     ;
02:0004969A 10342019        	  7282:     move.b  ($19,A4,D2.W),D0
02:0004969E 02000003        	  7283:     andi.b #$03,D0
02:000496A2 023C00EE        	  7284:     andi    #$EE,CCR  ; CLC: clear C+X
02:000496A6 123C0002        	  7285:     move.b  #$02,D1
02:000496AA D101            	  7286:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000496AC 1940004B        	  7287:     move.b  D0,($004B,A4)
                            	  7288:     ; If the distance to Link is too close to Link, then
                            	  7289:     ; go flag the monster uninitialized again, so we can
                            	  7290:     ; try to spawn it again next time.
                            	  7291:     ;
02:000496B0 7005            	  7292:     moveq   #5,D0
02:000496B2 61000414        	  7293:     jsr     SwitchBank
02:000496B6 4EB90003DAE6    	  7294:     jsr     IsDistanceSafeToSpawn
02:000496BC 6500FEB4        	  7295:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7296:     ; OK to spawn.
                            	  7297:     ; In this situation, monsters don't spawn from a cloud.
                            	  7298:     ;
02:000496C0 7000            	  7299:     moveq   #0,D0
02:000496C2 41EC0405        	  7300:     lea     ($0405,A4),A0
02:000496C6 11802000        	  7301:     move.b  D0,(A0,D2.W)
                            	  7302:     even
                            	  7303: _L_z07_InitObject_NormalSpawn:
02:000496CA 7004            	  7304:     moveq   #4,D0
02:000496CC 610003FA        	  7305:     jsr     SwitchBank
                            	  7306:     ; For monsters that spawn in a cloud, set their start time to
                            	  7307:     ; the same value as the object slot; so that they all start
                            	  7308:     ; moving at different times.
                            	  7309:     ;
02:000496D0 7400            	  7310:     moveq   #0,D2
02:000496D2 142C0340        	  7311:     move.b  ($0340,A4),D2
02:000496D6 7600            	  7312:     moveq   #0,D3
02:000496D8 41EC034F        	  7313:     lea     ($034F,A4),A0
02:000496DC 16302000        	  7314:     move.b  (A0,D2.W),D3
02:000496E0 0C03001E        	  7315:     cmpi.b  #$1E,D3
02:000496E4 6712            	  7316:     beq  _L_z07_InitObject_FetchAttrs
02:000496E6 0C030022        	  7317:     cmpi.b  #$22,D3
02:000496EA 670C            	  7318:     beq  _L_z07_InitObject_FetchAttrs
02:000496EC 0C030053        	  7319:     cmpi.b  #$53,D3
02:000496F0 6406            	  7320:     bcc  _L_z07_InitObject_FetchAttrs
02:000496F2 1002            	  7321:     move.b  D2,D0
02:000496F4 19802028        	  7322:     move.b  D0,($28,A4,D2.W)
                            	  7323:     even
                            	  7324: _L_z07_InitObject_FetchAttrs:
                            	  7325:     ; Store the object attributes for fast access.
                            	  7326:     ;
02:000496F8 41F9000491E8    	  7327:     lea     (ObjectTypeToAttributes).l,A0
02:000496FE 10303000        	  7328:     move.b  (A0,D3.W),D0
02:00049702 41EC04BF        	  7329:     lea     ($04BF,A4),A0
02:00049706 11802000        	  7330:     move.b  D0,(A0,D2.W)
02:0004970A 1003            	  7331:     move.b  D3,D0
02:0004970C 1880            	  7332:     move.b  D0,($0000,A4)
                            	  7333:     ; Hit points are packed two values to a byte.
                            	  7334:     ; Divide the object type in half in order to index
                            	  7335:     ; into the hit points table.
                            	  7336:     ;
02:0004970E E208            	  7337:     lsr.b  #1,D0   ; LSR A
02:00049710 7600            	  7338:     moveq   #0,D3
02:00049712 1600            	  7339:     move.b  D0,D3
02:00049714 41F900049248    	  7340:     lea     (ObjectTypeToHpPairs).l,A0
02:0004971A 10303000        	  7341:     move.b  (A0,D3.W),D0
02:0004971E 4EB90003C078    	  7342:     jsr     ExtractHitPointValue
02:00049724 41EC0485        	  7343:     lea     ($0485,A4),A0
02:00049728 11802000        	  7344:     move.b  D0,(A0,D2.W)
                            	  7345:     ; If the object is a cave, go initialize it.
