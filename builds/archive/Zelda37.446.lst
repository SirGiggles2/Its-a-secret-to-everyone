                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:00034F04 7600            	  4500:     moveq   #0,D3
02:00034F06 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034F0A 41F900034EA4    	  4502:     lea     (PeaceText).l,A0
02:00034F10 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034F14 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:00034F18 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034F1A 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
