                            	  5815:     ; Decrement the state timer.
                            	  5816:     ; If it hasn't expired, go move the sword or rod.
                            	  5817:     ;
02:00048B18 41EC03D0        	  5818:     lea     ($03D0,A4),A0
02:00048B1C 53302000        	  5819:     subq.b  #1,(A0,D2.W)
02:00048B20 6644            	  5820:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5821:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5822:     ;
02:00048B22 41EC00AC        	  5823:     lea     ($00AC,A4),A0
02:00048B26 10302000        	  5824:     move.b  (A0,D2.W),D0
02:00048B2A 0200000F        	  5825:     andi.b #$0F,D0
02:00048B2E 7600            	  5826:     moveq   #0,D3
02:00048B30 1600            	  5827:     move.b  D0,D3
02:00048B32 7008            	  5828:     moveq   #8,D0
02:00048B34 5303            	  5829:     subq.b  #1,D3
02:00048B36 6702            	  5830:     beq  _anon_z07_32
02:00048B38 7001            	  5831:     moveq   #1,D0
                            	  5832: _anon_z07_32:
                            	  5833:     ; Set both the player's animation counter and the sword's
                            	  5834:     ; animation counter/timer to this value.
                            	  5835:     ;
02:00048B3A 194003D0        	  5836:     move.b  D0,($03D0,A4)
02:00048B3E 41EC03D0        	  5837:     lea     ($03D0,A4),A0
02:00048B42 11802000        	  5838:     move.b  D0,(A0,D2.W)
                            	  5839:     ; Go to the next state.
                            	  5840:     ;
02:00048B46 41EC00AC        	  5841:     lea     ($00AC,A4),A0
02:00048B4A 52302000        	  5842:     addq.b  #1,(A0,D2.W)
                            	  5843:     ; Once we reach state 6, deactivate the object.
                            	  5844:     ; Otherwise, go draw it.
                            	  5845:     ;
02:00048B4E 41EC00AC        	  5846:     lea     ($00AC,A4),A0
02:00048B52 10302000        	  5847:     move.b  (A0,D2.W),D0
02:00048B56 0200000F        	  5848:     andi.b #$0F,D0
02:00048B5A 0C000006        	  5849:     cmpi.b  #$06,D0
02:00048B5E 6506            	  5850:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:00048B60 610001C2        	  5851:     jsr     ResetObjState
                            	  5852:     even
                            	  5853: _L_z07_UpdateSwordOrRod_Exit:
02:00048B64 4E75            	  5854:     rts
                            	  5855: 
                            	  5856:     even
                            	  5857: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  5858:     ; Reset horizontal flipping in [0F].
                            	  5859:     ;
02:00048B66 7000            	  5860:     moveq   #0,D0
02:00048B68 1940000F        	  5861:     move.b  D0,($000F,A4)
                            	  5862:     ; If state = 5, return without drawing.
                            	  5863:     ;
02:00048B6C 41EC00AC        	  5864:     lea     ($00AC,A4),A0
02:00048B70 10302000        	  5865:     move.b  (A0,D2.W),D0
02:00048B74 0200000F        	  5866:     andi.b #$0F,D0
02:00048B78 7600            	  5867:     moveq   #0,D3
02:00048B7A 1600            	  5868:     move.b  D0,D3
02:00048B7C 103C00FC        	  5869:     move.b  #$FC,D0
02:00048B80 0C030005        	  5870:     cmpi.b  #$05,D3
02:00048B84 67DE            	  5871:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5872:     even
                            	  5873: _L_z07_UpdateSwordOrRod_Add4:
                            	  5874:     ; Set [00] to (state - 1) * 4:
                            	  5875:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5876:     ;
02:00048B86 023C00EE        	  5877:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B8A 123C0004        	  5878:     move.b  #$04,D1
02:00048B8E D101            	  5879:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048B90 5303            	  5880:     subq.b  #1,D3
02:00048B92 66F2            	  5881:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048B94 1880            	  5882:     move.b  D0,($0000,A4)
                            	  5883:     ; Set object's direction to player's. It might have changed
                            	  5884:     ; since the last frame.
                            	  5885:     ;
02:00048B96 102C0098        	  5886:     move.b  ($0098,A4),D0
02:00048B9A 41EC0098        	  5887:     lea     ($0098,A4),A0
02:00048B9E 11802000        	  5888:     move.b  D0,(A0,D2.W)
                            	  5889:     ; Add [00] and the reverse index of the direction to get
                            	  5890:     ; the byte offset of the pixel offset.
                            	  5891:     ;
02:00048BA2 4EB9000309EC    	  5892:     jsr     GetOppositeDir
02:00048BA8 1003            	  5893:     move.b  D3,D0
02:00048BAA 023C00EE        	  5894:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048BAE 1214            	  5895:     move.b  ($0000,A4),D1
02:00048BB0 D101            	  5896:     addx.b  D1,D0   ; ADC $00
02:00048BB2 7600            	  5897:     moveq   #0,D3
02:00048BB4 1600            	  5898:     move.b  D0,D3
                            	  5899:     ; Set object's X to player's X + offset for state and direction.
                            	  5900:     ; Copy the result to [00].
                            	  5901:     ;
02:00048BB6 102C0070        	  5902:     move.b  ($0070,A4),D0
02:00048BBA 023C00EE        	  5903:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048BBE 41F900048AEA    	  5904:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048BC4 12303000        	  5905:     move.b  (A0,D3.W),D1
02:00048BC8 D101            	  5906:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048BCA 19802070        	  5907:     move.b  D0,($70,A4,D2.W)
02:00048BCE 1880            	  5908:     move.b  D0,($0000,A4)
                            	  5909:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5910:     ; Copy the result to [01].
                            	  5911:     ;
02:00048BD0 102C0084        	  5912:     move.b  ($0084,A4),D0
02:00048BD4 023C00EE        	  5913:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048BD8 41F900048AFA    	  5914:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048BDE 12303000        	  5915:     move.b  (A0,D3.W),D1
02:00048BE2 D101            	  5916:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048BE4 41EC0084        	  5917:     lea     ($0084,A4),A0
02:00048BE8 11802000        	  5918:     move.b  D0,(A0,D2.W)
02:00048BEC 19400001        	  5919:     move.b  D0,($0001,A4)
                            	  5920:     ; If state = 1, use up direction.
                            	  5921:     ; Else use object direction.
                            	  5922:     ;
02:00048BF0 41EC00AC        	  5923:     lea     ($00AC,A4),A0
02:00048BF4 10302000        	  5924:     move.b  (A0,D2.W),D0
02:00048BF8 0200000F        	  5925:     andi.b #$0F,D0
02:00048BFC 7600            	  5926:     moveq   #0,D3
02:00048BFE 1600            	  5927:     move.b  D0,D3
02:00048C00 7008            	  5928:     moveq   #8,D0
02:00048C02 5303            	  5929:     subq.b  #1,D3
02:00048C04 6708            	  5930:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048C06 41EC0098        	  5931:     lea     ($0098,A4),A0
02:00048C0A 10302000        	  5932:     move.b  (A0,D2.W),D0
                            	  5933:     even
                            	  5934: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5935:     ; Store the weapon's frame (horizontal or vertical)
                            	  5936:     ; for the direction chosen above in [0C].
                            	  5937:     ;
02:00048C0E 4EB9000309EC    	  5938:     jsr     GetOppositeDir
02:00048C14 41F900048648    	  5939:     lea     (RDirectionToWeaponFrame).l,A0
02:00048C1A 10303000        	  5940:     move.b  (A0,D3.W),D0
02:00048C1E 1940000C        	  5941:     move.b  D0,($000C,A4)
                            	  5942:     ; Calculate sprite attributes.
                            	  5943:     ;
                            	  5944:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5945:     ;   base attribute OR 1
                            	  5946:     ; So, it uses palette row 5.
                            	  5947:     ;
02:00048C22 41F90004864C    	  5948:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048C28 10303000        	  5949:     move.b  (A0,D3.W),D0
02:00048C2C 0C02000D        	  5950:     cmpi.b  #$0D,D2
02:00048C30 6706            	  5951:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048C32 00000001        	  5952:     ori.b #$01,D0
02:00048C36 601C            	  5953:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5954: 
                            	  5955:     even
                            	  5956: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5957:     ; The weapon is the sword.
                            	  5958:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5959:     ;
02:00048C38 023C00EE        	  5960:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048C3C 122C0657        	  5961:     move.b  ($0657,A4),D1
02:00048C40 D101            	  5962:     addx.b  D1,D0   ; ADC Items
02:00048C42 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:00048C46 123C0001        	  5964:     move.b  #$01,D1
02:00048C4A 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048C4E 9101            	  5966:     subx.b  D1,D0   ; SBC #$01
02:00048C50 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5968:     even
                            	  5969: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5970:     ; Set sprite attributes to the calculated value above.
                            	  5971:     ;
02:00048C54 4EB9000310AE    	  5972:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5973:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5974:     ;
02:00048C5A 0C030002        	  5975:     cmpi.b  #$02,D3
02:00048C5E 6604            	  5976:     bne  _anon_z07_33
02:00048C60 522C000F        	  5977:     addq.b  #1,($000F,A4)
                            	  5978: _anon_z07_33:
                            	  5979:     ; If state = 1, return. Don't show the weapon.
                            	  5980:     ;
02:00048C64 41EC00AC        	  5981:     lea     ($00AC,A4),A0
02:00048C68 10302000        	  5982:     move.b  (A0,D2.W),D0
02:00048C6C 0200000F        	  5983:     andi.b #$0F,D0
02:00048C70 0C000001        	  5984:     cmpi.b  #$01,D0
02:00048C74 6604            	  5985:     bne.s  __far_z_07_0086
02:00048C76 600000AA        	  5986:     jmp  L1F854_Exit
                            	  5987: __far_z_07_0086:
                            	  5988:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5989:     ; sword or rod
                            	  5990:     ;
                            	  5991:     ;
                            	  5992:     ; Sword slot
02:00048C7A 7600            	  5993:     moveq   #0,D3
02:00048C7C 0C02000D        	  5994:     cmpi.b  #$0D,D2
02:00048C80 6702            	  5995:     beq  _anon_z07_34
02:00048C82 7608            	  5996:     moveq   #8,D3
                            	  5997: _anon_z07_34:
02:00048C84 4EB900030FCE    	  5998:     jsr     Anim_WriteItemSprites
                            	  5999:     ; If state <> 3, return.
                            	  6000:     ;
02:00048C8A 41EC00AC        	  6001:     lea     ($00AC,A4),A0
02:00048C8E 10302000        	  6002:     move.b  (A0,D2.W),D0
02:00048C92 0200000F        	  6003:     andi.b #$0F,D0
02:00048C96 0C000003        	  6004:     cmpi.b  #$03,D0
02:00048C9A 6704            	  6005:     beq.s  __far_z_07_0087
02:00048C9C 60000084        	  6006:     jmp  L1F854_Exit
                            	  6007: __far_z_07_0087:
                            	  6008:     ; State = 3. Time to instantiate a shot.
                            	  6009:     ;
                            	  6010:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6011:     ;
02:00048CA0 0C020012        	  6012:     cmpi.b  #$12,D2
02:00048CA4 6704            	  6013:     beq.s  __far_z_07_0088
02:00048CA6 60000082        	  6014:     jmp  MakeSwordShot
                            	  6015: __far_z_07_0088:
                            	  6016:     ; Instantiate a magic shot (rod shot).
                            	  6017:     ; Switch to the shot slot $E.
                            	  6018:     ;
02:00048CAA 740E            	  6019:     moveq   #14,D2
                            	  6020:     ; If high bit of state is set, return. It's already active.
                            	  6021:     ;
02:00048CAC 41EC00AC        	  6022:     lea     ($00AC,A4),A0
02:00048CB0 10302000        	  6023:     move.b  (A0,D2.W),D0
02:00048CB4 6706            	  6024:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00048CB6 E308            	  6025:     lsl.b  #1,D0   ; ASL A
02:00048CB8 6402            	  6026:     bcc.s  __far_z_07_0089
02:00048CBA 6066            	  6027:     jmp  L1F854_Exit
                            	  6028: __far_z_07_0089:
                            	  6029:     even
                            	  6030: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6031:     ; Play "magic shot" tune.
                            	  6032:     ;
02:00048CBC 7004            	  6033:     moveq   #4,D0
02:00048CBE 19400604        	  6034:     move.b  D0,($0604,A4)
                            	  6035:     ; Activate the shot object (state $80).
                            	  6036:     ;
02:00048CC2 103C0080        	  6037:     move.b  #$80,D0
                            	  6038:     even
                            	  6039: SetUpWeaponWithState:
02:00048CC6 41EC00AC        	  6040:     lea     ($00AC,A4),A0
02:00048CCA 11802000        	  6041:     move.b  D0,(A0,D2.W)
02:00048CCE 7010            	  6042:     moveq   #16,D0
02:00048CD0 4EB900030A22    	  6043:     jsr     PlaceWeapon
                            	  6044:     ; If the direction is horizontal, and X < $14 or >= $EC, then
                            	  6045:     ; deactivate the shot object.
                            	  6046:     ;
02:00048CD6 41EC0098        	  6047:     lea     ($0098,A4),A0
02:00048CDA 10302000        	  6048:     move.b  (A0,D2.W),D0
02:00048CDE 02000003        	  6049:     andi.b #$03,D0
02:00048CE2 6714            	  6050:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00048CE4 10342070        	  6051:     move.b  ($70,A4,D2.W),D0
02:00048CE8 0C000014        	  6052:     cmpi.b  #$14,D0
02:00048CEC 6402            	  6053:     bcc.s  __far_z_07_0090
02:00048CEE 6034            	  6054:     jmp  ResetObjState
                            	  6055: __far_z_07_0090:
02:00048CF0 0C0000EC        	  6056:     cmpi.b  #$EC,D0
02:00048CF4 6502            	  6057:     bcs.s  __far_z_07_0091
02:00048CF6 602C            	  6058:     jmp  ResetObjState
                            	  6059: __far_z_07_0091:
                            	  6060:     even
                            	  6061: _L_z07_SetUpWeaponWithState_ChooseSpeed:
                            	  6062:     ; If high bit of state is set, use $A0 else $C0 for the q-speed fraction.
                            	  6063:     ;
                            	  6064:     ; The high bit is set for magic shot, and reset for sword shot.
                            	  6065:     ;
02:00048CF8 163C00C0        	  6066:     move.b  #$C0,D3
02:00048CFC 41EC00AC        	  6067:     lea     ($00AC,A4),A0
02:00048D00 10302000        	  6068:     move.b  (A0,D2.W),D0
02:00048D04 E308            	  6069:     lsl.b  #1,D0   ; ASL A
02:00048D06 6404            	  6070:     bcc  _anon_z07_35
02:00048D08 163C00A0        	  6071:     move.b  #$A0,D3
                            	  6072: _anon_z07_35:
02:00048D0C 1003            	  6073:     move.b  D3,D0
02:00048D0E 41EC03BC        	  6074:     lea     ($03BC,A4),A0
02:00048D12 11802000        	  6075:     move.b  D0,(A0,D2.W)
                            	  6076:     ; Set the shot object's grid offset the same as the player's.
                            	  6077:     ;
02:00048D16 102C0394        	  6078:     move.b  ($0394,A4),D0
02:00048D1A 41EC0394        	  6079:     lea     ($0394,A4),A0
02:00048D1E 11802000        	  6080:     move.b  D0,(A0,D2.W)
                            	  6081:     even
                            	  6082: L1F854_Exit:
02:00048D22 4E75            	  6083:     rts
                            	  6084: 
                            	  6085: ; Returns:
                            	  6086: ; A: 0
                            	  6087: ;
                            	  6088: ; If it's the room item, then deactivates it.
                            	  6089: ;
                            	  6090:     even
                            	  6091: ResetObjState:
02:00048D24 4EF90002B8A6    	  6092:     jmp     c_reset_obj_state
