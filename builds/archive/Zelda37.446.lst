02:0003BAFE 4EB90002AECA    	  8110:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  8111:     even
                            	  8112: UpdateGanon_JumpTable:
02:0003BB04 0003BB10        	  8113:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BB08 0003BB72        	  8114:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BB0C 0003BBA0        	  8115:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  8116: 
                            	  8117: ; Description:
                            	  8118: ; Lift up the Triforce of Courage while the room is dark.
                            	  8119: ;
                            	  8120: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8121: ;
                            	  8122:     even
                            	  8123: Ganon_ScenePhase0:
02:0003BB10 701B            	  8124:     moveq   #27,D0
02:0003BB12 19400505        	  8125:     move.b  D0,($0505,A4)
                            	  8126:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8127:     ;
02:0003BB16 102C0028        	  8128:     move.b  ($0028,A4),D0
02:0003BB1A 6644            	  8129:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8130:     ; Once the timer expires, it's time to brighten the room.
                            	  8131:     ;
                            	  8132:     ; Save the current object slot.
02:0003BB1C 1002            	  8133:     move.b  D2,D0
02:0003BB1E 1B00            	  8134:     move.b  D0,-(A5)  ; PHA
02:0003BB20 610007F0        	  8135:     jsr     UpdateCandle
02:0003BB24 101D            	  8136:     move.b  (A5)+,D0  ; PLA
02:0003BB26 7400            	  8137:     moveq   #0,D2
02:0003BB28 1400            	  8138:     move.b  D0,D2
                            	  8139:     ; Turn off the room brightening flag, because we're controlling it
                            	  8140:     ; here instead of in the Mode 5 object update loop.
                            	  8141:     ;
02:0003BB2A 7000            	  8142:     moveq   #0,D0
02:0003BB2C 1940051E        	  8143:     move.b  D0,($051E,A4)
                            	  8144:     ; On the first frame of the fade-to-light cycle, play the
                            	  8145:     ; Triforce/Ganon song.
                            	  8146:     ;
02:0003BB30 102C051C        	  8147:     move.b  ($051C,A4),D0
02:0003BB34 0C0000C0        	  8148:     cmpi.b  #$C0,D0
02:0003BB38 6606            	  8149:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BB3A 7002            	  8150:     moveq   #2,D0
02:0003BB3C 19400600        	  8151:     move.b  D0,($0600,A4)
                            	  8152:     even
                            	  8153: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8154:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8155:     ;
02:0003BB40 102C051C        	  8156:     move.b  ($051C,A4),D0
02:0003BB44 0200000F        	  8157:     andi.b #$0F,D0
