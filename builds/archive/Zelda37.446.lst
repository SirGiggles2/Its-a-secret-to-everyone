                            	  1276: UpdateMonsterArrow:
                            	  1277:     ; Set q-speed $80 (2 pixels a frame).
                            	  1278:     ;
02:0003888E 103C0080        	  1279:     move.b  #$80,D0
02:00038892 41EC03BC        	  1280:     lea     ($03BC,A4),A0
02:00038896 11802000        	  1281:     move.b  D0,(A0,D2.W)
                            	  1282:     ; If the timer has not expired, then go draw,
                            	  1283:     ; and see if the shooter's still alive.
                            	  1284:     ;
02:0003889A 10342028        	  1285:     move.b  ($28,A4,D2.W),D0
02:0003889E 6626            	  1286:     bne  _L_z04_UpdateMonsterArrow_CheckShooter
                            	  1287:     ; If the arrow is sparking, then go update the base arrow.
                            	  1288:     ;
02:000388A0 41EC00AC        	  1289:     lea     ($00AC,A4),A0
02:000388A4 10302000        	  1290:     move.b  (A0,D2.W),D0
02:000388A8 020000F0        	  1291:     andi.b #$F0,D0
02:000388AC 0C000020        	  1292:     cmpi.b  #$20,D0
02:000388B0 6732            	  1293:     beq  _L_z04_UpdateMonsterArrow_UpdateBase
                            	  1294:     ; If the arrow is not flying, then
                            	  1295:     ; go handle it bouncing off of Link's shield.
                            	  1296:     ;
02:000388B2 0C000010        	  1297:     cmpi.b  #$10,D0
02:000388B6 6654            	  1298:     bne  _L_z04_UpdateMonsterArrow_CheckBounce
                            	  1299:     ; TODO: But is this necessary?
                            	  1300:     ; Set the moving direction in [0F].
                            	  1301:     ; Then go update the base arrow.
                            	  1302:     ;
02:000388B8 41EC0098        	  1303:     lea     ($0098,A4),A0
