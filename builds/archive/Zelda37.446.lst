02:000485BA 52302000        	  5054:     addq.b  #1,(A0,D2.W)
02:000485BE 41EC00AC        	  5055:     lea     ($00AC,A4),A0
02:000485C2 10302000        	  5056:     move.b  (A0,D2.W),D0
02:000485C6 0200000F        	  5057:     andi.b #$0F,D0
02:000485CA 0C000003        	  5058:     cmpi.b  #$03,D0
02:000485CE 674C            	  5059:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
