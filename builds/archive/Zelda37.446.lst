02:0003A19C 41EC0478        	  4744:     lea     ($0478,A4),A0
02:0003A1A0 12302000        	  4745:     move.b  (A0,D2.W),D1
02:0003A1A4 D101            	  4746:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A1A6 41EC0084        	  4747:     lea     ($0084,A4),A0
