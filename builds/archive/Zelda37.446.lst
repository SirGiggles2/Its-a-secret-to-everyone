02:000338E8 102C0071        	  2379:     move.b  ($0071,A4),D0
02:000338EC 1940020B        	  2380:     move.b  D0,($020B,A4)
02:000338F0 4E75            	  2381:     rts
                            	  2382: 
                            	  2383: ; Params:
                            	  2384: ; A: cursor Y
                            	  2385: ;
                            	  2386: ; Returns:
                            	  2387: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2388: ;
                            	  2389: ; Description:
                            	  2390: ; Adjust the Y coordinate to account for the visible part of
                            	  2391: ; block cursor being in the bottom half of sprite.
                            	  2392: ; Also, make the cursor flash.
                            	  2393: ;
                            	  2394:     even
