02:00039FF4 4EB90004916E    	  4521:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  4522:     ; If this is a child digdogger, then go draw it.
                            	  4523:     ;
02:00039FFA 41EC046B        	  4524:     lea     ($046B,A4),A0
02:00039FFE 10302000        	  4525:     move.b  (A0,D2.W),D0
02:0003A002 666C            	  4526:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  4527:     ; For each part of the big digdogger, from 0 to 3,
                            	  4528:     ; indexed by Y register:
                            	  4529:     ;
02:0003A004 7600            	  4530:     moveq   #0,D3
                            	  4531:     even
                            	  4532: _L_z04_Digdogger_Draw_LoopPart:
                            	  4533:     ; Store in [00] the X coordinate offset for the current corner.
                            	  4534:     ;
02:0003A006 10342070        	  4535:     move.b  ($70,A4,D2.W),D0
02:0003A00A 023C00EE        	  4536:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A00E 41F900039FE6    	  4537:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003A014 12303000        	  4538:     move.b  (A0,D3.W),D1
02:0003A018 D101            	  4539:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003A01A 1880            	  4540:     move.b  D0,($0000,A4)
                            	  4541:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  4542:     ;
02:0003A01C 41EC0084        	  4543:     lea     ($0084,A4),A0
02:0003A020 10302000        	  4544:     move.b  (A0,D2.W),D0
02:0003A024 023C00EE        	  4545:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A028 41F900039FEA    	  4546:     lea     (DigdoggerSpriteOffsetsY).l,A0
02:0003A02E 12303000        	  4547:     move.b  (A0,D3.W),D1
02:0003A032 D101            	  4548:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsY,Y
02:0003A034 19400001        	  4549:     move.b  D0,($0001,A4)
                            	  4550:     ; Load and set the sprite attributes for this part.
                            	  4551:     ; Vertical flipping is set appropriately here.
                            	  4552:     ;
02:0003A038 41F900039FEE    	  4553:     lea     (DigdoggerSpriteAttrs).l,A0
02:0003A03E 10303000        	  4554:     move.b  (A0,D3.W),D0
02:0003A042 4EB9000310AE    	  4555:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003A048 1003            	  4556:     move.b  D3,D0
02:0003A04A 1B00            	  4557:     move.b  D0,-(A5)  ; PHA
                            	  4558:     ; Parts at odd indexes are flipped horizontally.
                            	  4559:     ;
02:0003A04C 02000001        	  4560:     andi.b #$01,D0
02:0003A050 1940000F        	  4561:     move.b  D0,($000F,A4)
02:0003A054 7000            	  4562:     moveq   #0,D0
02:0003A056 4EB900030DBC    	  4563:     jsr     DrawObjectNotMirrored
02:0003A05C 101D            	  4564:     move.b  (A5)+,D0  ; PLA
02:0003A05E 7600            	  4565:     moveq   #0,D3
02:0003A060 1600            	  4566:     move.b  D0,D3
                            	  4567:     ; Bottom of the loop.
                            	  4568:     ; Increment Y register until = 4.
                            	  4569:     ;
02:0003A062 5203            	  4570:     addq.b  #1,D3
02:0003A064 0C030004        	  4571:     cmpi.b  #$04,D3
02:0003A068 669C            	  4572:     bne  _L_z04_Digdogger_Draw_LoopPart
02:0003A06A 0A3C0001        	  4573:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A06E 4E75            	  4574:     rts
