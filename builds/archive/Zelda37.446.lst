                            	  2066:     ;
02:00038E78 0C030001        	  2067:     cmpi.b  #$01,D3
02:00038E7C 6604            	  2068:     bne  _anon_z04_49
02:00038E7E 522C000F        	  2069:     addq.b  #1,($000F,A4)
                            	  2070: _anon_z04_49:
                            	  2071:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
