02:0002F5AA 41F90002F55A    	   832:     lea     (DemoPatternBlockSizes).l,A0
02:0002F5B0 10302000        	   833:     move.b  (A0,D2.W),D0
02:0002F5B4 19400003        	   834:     move.b  D0,($0003,A4)
02:0002F5B8 41F90002F55E    	   835:     lea     (DemoPatternVramAddrs).l,A0
