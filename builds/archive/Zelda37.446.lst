                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038E4E 7653            	  2045:     moveq   #83,D3
02:00038E50 6100F97C        	  2046:     jsr     _TryShooting
02:00038E54 4EB900049174    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038E5A 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038E5E 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038E62 7600            	  2052:     moveq   #0,D3
02:00038E64 1600            	  2053:     move.b  D0,D3
02:00038E66 0200000C        	  2054:     andi.b #$0C,D0
02:00038E6A 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038E6C 7002            	  2056:     moveq   #2,D0
02:00038E6E 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038E72 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
                            	  2060:     ;
02:00038E74 7001            	  2061:     moveq   #1,D0
