02:000409B4 9101            	  6889:     subx.b  D1,D0   ; SBC #$40
02:000409B6 0A3C0010        	  6890:     eori    #$10,CCR  ; restore X = 6502 C
02:000409BA E208            	  6891:     lsr.b  #1,D0   ; LSR A
02:000409BC E208            	  6892:     lsr.b  #1,D0   ; LSR A
02:000409BE E208            	  6893:     lsr.b  #1,D0   ; LSR A
02:000409C0 7600            	  6894:     moveq   #0,D3
02:000409C2 1600            	  6895:     move.b  D0,D3
02:000409C4 1214            	  6896:     move.b  ($00,A4),D1   ; ptr lo
02:000409C6 182C0001        	  6897:     move.b  ($01,A4),D4  ; ptr hi
02:000409CA 024100FF        	  6898:     andi.w  #$00FF,D1         ; zero-extend lo byte
