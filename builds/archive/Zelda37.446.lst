                            	  9486: TurnTowardsPlayer8:
                            	  9487:     ; Build a direction in [00] towards the player.
                            	  9488:     ;
                            	  9489:     ; First, calculate a horizontal component:
                            	  9490:     ;
                            	  9491:     ; If   observed player X = object X, [00] := 0 (none)
                            	  9492:     ; elif observed player X > object X, [00] := 1 (right)
                            	  9493:     ; else                               [00] := 2 (left)
                            	  9494:     ;
02:0003C454 7600            	  9495:     moveq   #0,D3
02:0003C456 1883            	  9496:     move.b  D3,($0000,A4)
02:0003C458 5203            	  9497:     addq.b  #1,D3
02:0003C45A 102C0061        	  9498:     move.b  ($0061,A4),D0
