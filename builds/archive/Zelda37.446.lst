                            	  6094: MakeSwordShot:
                            	  6095:     ; Try to activate a sword shot.
                            	  6096:     ;
                            	  6097:     ; Switch to shot slot $E.
                            	  6098:     ;
02:00048D2A 740E            	  6099:     moveq   #14,D2
                            	  6100:     ; If state <> 0, return. It's already activated.
                            	  6101:     ;
02:00048D2C 41EC00AC        	  6102:     lea     ($00AC,A4),A0
02:00048D30 10302000        	  6103:     move.b  (A0,D2.W),D0
02:00048D34 6702            	  6104:     beq.s  __far_z_07_0092
02:00048D36 60EA            	  6105:     jmp  L1F854_Exit
                            	  6106: __far_z_07_0092:
                            	  6107:     ; If [0529] is set, go activate a sword shot regardless of hearts.
                            	  6108:     ;
                            	  6109:     ; TODO: But is this used?
                            	  6110:     ;
02:00048D38 102C0529        	  6111:     move.b  ($0529,A4),D0
02:00048D3C 662A            	  6112:     bne  _L_z07_MakeSwordShot_SetUp
                            	  6113:     ; If full hearts <> (heart containers - 1), return.
                            	  6114:     ;
02:00048D3E 102C066F        	  6115:     move.b  ($066F,A4),D0
02:00048D42 1B00            	  6116:     move.b  D0,-(A5)  ; PHA
02:00048D44 0200000F        	  6117:     andi.b #$0F,D0
02:00048D48 1880            	  6118:     move.b  D0,($0000,A4)
02:00048D4A 101D            	  6119:     move.b  (A5)+,D0  ; PLA
02:00048D4C E208            	  6120:     lsr.b  #1,D0   ; LSR A
02:00048D4E E208            	  6121:     lsr.b  #1,D0   ; LSR A
02:00048D50 E208            	  6122:     lsr.b  #1,D0   ; LSR A
02:00048D52 E208            	  6123:     lsr.b  #1,D0   ; LSR A
02:00048D54 1214            	  6124:     move.b  ($0000,A4),D1
02:00048D56 B001            	  6125:     cmp.b   D1,D0
02:00048D58 6702            	  6126:     beq.s  __far_z_07_0093
02:00048D5A 60C6            	  6127:     jmp  L1F854_Exit
                            	  6128: __far_z_07_0093:
                            	  6129:     ; If partial heart is less than half full, return.
                            	  6130:     ;
02:00048D5C 102C0670        	  6131:     move.b  ($0670,A4),D0
02:00048D60 0C000080        	  6132:     cmpi.b  #$80,D0
02:00048D64 6402            	  6133:     bcc.s  __far_z_07_0094
02:00048D66 60BA            	  6134:     jmp  L1F854_Exit
