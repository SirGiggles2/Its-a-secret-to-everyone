                            	  8631: Ganon_DrawBody:
                            	  8632:     ; Loop over four 16x16 images that make up Ganon.
                            	  8633:     ; There are 6 animation frames.
                            	  8634:     ;
02:0003BE8A 7603            	  8635:     moveq   #3,D3
                            	  8636:     even
                            	  8637: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8638:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8639:     ;
02:0003BE8C 10342070        	  8640:     move.b  ($70,A4,D2.W),D0
02:0003BE90 023C00EE        	  8641:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE94 41F90003BE7E    	  8642:     lea     (GanonSpriteOffsetsX).l,A0
02:0003BE9A 12303000        	  8643:     move.b  (A0,D3.W),D1
02:0003BE9E D101            	  8644:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003BEA0 1880            	  8645:     move.b  D0,($0000,A4)
                            	  8646:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8647:     ;
02:0003BEA2 41EC0084        	  8648:     lea     ($0084,A4),A0
02:0003BEA6 10302000        	  8649:     move.b  (A0,D2.W),D0
02:0003BEAA 023C00EE        	  8650:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BEAE 41F90003BE82    	  8651:     lea     (GanonSpriteOffsetsY).l,A0
02:0003BEB4 12303000        	  8652:     move.b  (A0,D3.W),D1
02:0003BEB8 D101            	  8653:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003BEBA 19400001        	  8654:     move.b  D0,($0001,A4)
                            	  8655:     ; Each part has a horizontal flipping flag.
                            	  8656:     ;
02:0003BEBE 41F90003BE86    	  8657:     lea     (GanonSpriteHFlips).l,A0
02:0003BEC4 10303000        	  8658:     move.b  (A0,D3.W),D0
02:0003BEC8 1940000F        	  8659:     move.b  D0,($000F,A4)
                            	  8660:     ; Save and copy the loop index (the current part) to [07].
                            	  8661:     ;
02:0003BECC 1003            	  8662:     move.b  D3,D0
02:0003BECE 1B00            	  8663:     move.b  D0,-(A5)  ; PHA
02:0003BED0 19400007        	  8664:     move.b  D0,($0007,A4)
                            	  8665:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8666:     ; that make it up.
                            	  8667:     ;
02:0003BED4 41EC046B        	  8668:     lea     ($046B,A4),A0
02:0003BED8 10302000        	  8669:     move.b  (A0,D2.W),D0
02:0003BEDC E308            	  8670:     lsl.b  #1,D0   ; ASL A
02:0003BEDE E308            	  8671:     lsl.b  #1,D0   ; ASL A
                            	  8672:     ; Add [07] -- the index of the current part.
                            	  8673:     ;
                            	  8674:     ; Now you have an index into the frame image table, for the
                            	  8675:     ; current image part of the current animation frame.
                            	  8676:     ;
02:0003BEE0 122C0007        	  8677:     move.b  ($0007,A4),D1
02:0003BEE4 D101            	  8678:     addx.b  D1,D0   ; ADC $07
02:0003BEE6 7600            	  8679:     moveq   #0,D3
02:0003BEE8 1600            	  8680:     move.b  D0,D3
02:0003BEEA 41F90003BE66    	  8681:     lea     (GanonFrameImages).l,A0
02:0003BEF0 10303000        	  8682:     move.b  (A0,D3.W),D0
02:0003BEF4 4EB900030DBC    	  8683:     jsr     DrawObjectNotMirrored
02:0003BEFA 101D            	  8684:     move.b  (A5)+,D0  ; PLA
                            	  8685:     ; Bottom of the part loop.
                            	  8686:     ;
02:0003BEFC 7600            	  8687:     moveq   #0,D3
02:0003BEFE 1600            	  8688:     move.b  D0,D3
02:0003BF00 5303            	  8689:     subq.b  #1,D3
02:0003BF02 6A88            	  8690:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003BF04 4E75            	  8691:     rts
