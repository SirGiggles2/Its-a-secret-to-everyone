02:0002F582 2A305000        	   822:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002F586 29450004        	   823:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002F58A 41F90002F55A    	   824:     lea     (DemoPatternBlockSizes).l,A0
02:0002F590 10302000        	   825:     move.b  (A0,D2.W),D0
