                            	  7916: __far_z_04_0090:
                            	  7917:     ; State = 0.
                            	  7918:     ;
                            	  7919:     ; If the current object slot is 2, then go initialize the patra child.
                            	  7920:     ; This is the only patra child shown in the first fame.
                            	  7921:     ;
02:0003B990 0C020002        	  7922:     cmpi.b  #$02,D2
02:0003B994 6732            	  7923:     beq  _L_z04_UpdatePatraChild_Ready
                            	  7924:     ; The patra child in slot 2 is the last one to be updated.
                            	  7925:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  7926:     ;
                            	  7927:     ; This means that in the first frame, slot 2 is the only one to be
                            	  7928:     ; shown.
                            	  7929:     ;
02:0003B996 102C00AE        	  7930:     move.b  ($00AE,A4),D0
02:0003B99A 6700008E        	  7931:     beq  _L_z04_UpdatePatraChild_Exit
                            	  7932:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  7933:     ; here to wait to be shown at the top position (N) one at a time.
                            	  7934:     ;
02:0003B99E 1002            	  7935:     move.b  D2,D0
                            	  7936:     ; Subtract 3 from the object slot to get the angle where the
                            	  7937:     ; patra child in object slot 2 should be for the current one to appear.
                            	  7938:     ;
02:0003B9A0 003C0011        	  7939:     ori     #$11,CCR  ; SEC: set C+X
02:0003B9A4 123C0003        	  7940:     move.b  #$03,D1
02:0003B9A8 0A3C0010        	  7941:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B9AC 9101            	  7942:     subx.b  D1,D0   ; SBC #$03
02:0003B9AE 0A3C0010        	  7943:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B9B2 7600            	  7944:     moveq   #0,D3
02:0003B9B4 1600            	  7945:     move.b  D0,D3
                            	  7946:     ; If the patra child in slot 2 has not reached the required angle,
                            	  7947:     ; then return.
                            	  7948:     ;
02:0003B9B6 102C0396        	  7949:     move.b  ($0396,A4),D0
02:0003B9BA 41F90003B974    	  7950:     lea     (PatraChildStartAngles).l,A0
02:0003B9C0 12303000        	  7951:     move.b  (A0,D3.W),D1
02:0003B9C4 B001            	  7952:     cmp.b   D1,D0
02:0003B9C6 6662            	  7953:     bne  _L_z04_UpdatePatraChild_Exit
                            	  7954:     even
                            	  7955: _L_z04_UpdatePatraChild_Ready:
                            	  7956:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  7957:     ; the patra parent's state.
                            	  7958:     ;
02:0003B9C8 0C020009        	  7959:     cmpi.b  #$09,D2
02:0003B9CC 6604            	  7960:     bne  _anon_z04_157
02:0003B9CE 522C00AD        	  7961:     addq.b  #1,($00AD,A4)
                            	  7962: _anon_z04_157:
                            	  7963:     ; Go to state 1 to orbit.
                            	  7964:     ;
02:0003B9D2 41EC00AC        	  7965:     lea     ($00AC,A4),A0
02:0003B9D6 52302000        	  7966:     addq.b  #1,(A0,D2.W)
                            	  7967:     ; TODO: ?
                            	  7968:     ;
02:0003B9DA 103C0080        	  7969:     move.b  #$80,D0
02:0003B9DE 41EC0098        	  7970:     lea     ($0098,A4),A0
02:0003B9E2 11802000        	  7971:     move.b  D0,(A0,D2.W)
                            	  7972:     ; Set angle $18 (N).
                            	  7973:     ;
02:0003B9E6 7018            	  7974:     moveq   #24,D0
02:0003B9E8 41EC0394        	  7975:     lea     ($0394,A4),A0
02:0003B9EC 11802000        	  7976:     move.b  D0,(A0,D2.W)
                            	  7977:     ; This location is right above Patra.
                            	  7978:     ; Set X coordinate to Patra's.
                            	  7979:     ;
02:0003B9F0 102C0071        	  7980:     move.b  ($0071,A4),D0
02:0003B9F4 19802070        	  7981:     move.b  D0,($70,A4,D2.W)
                            	  7982:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  7983:     ; Else use radius $18. Store the chosen value in [00].
                            	  7984:     ;
02:0003B9F8 702C            	  7985:     moveq   #44,D0
02:0003B9FA 7600            	  7986:     moveq   #0,D3
02:0003B9FC 41EC034F        	  7987:     lea     ($034F,A4),A0
02:0003BA00 16302000        	  7988:     move.b  (A0,D2.W),D3
02:0003BA04 0C030025        	  7989:     cmpi.b  #$25,D3
02:0003BA08 6702            	  7990:     beq  _anon_z04_158
02:0003BA0A 7018            	  7991:     moveq   #24,D0
                            	  7992: _anon_z04_158:
02:0003BA0C 1880            	  7993:     move.b  D0,($0000,A4)
