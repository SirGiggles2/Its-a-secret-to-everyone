                            	  8502:     ;
02:0003BD7A 41EC0478        	  8503:     lea     ($0478,A4),A0
02:0003BD7E 10302000        	  8504:     move.b  (A0,D2.W),D0
02:0003BD82 6712            	  8505:     beq  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003BD84 102C0015        	  8506:     move.b  ($0015,A4),D0
02:0003BD88 02000007        	  8507:     andi.b #$07,D0
02:0003BD8C 6608            	  8508:     bne  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003BD8E 41EC0478        	  8509:     lea     ($0478,A4),A0
02:0003BD92 53302000        	  8510:     subq.b  #1,(A0,D2.W)
                            	  8511:     even
                            	  8512: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8513:     ; Draw the four clouds at diagonal corners.
                            	  8514:     ;
02:0003BD96 610000B6        	  8515:     jsr     Ganon_GetCurCloudLeft
02:0003BD9A 610000BE        	  8516:     jsr     Ganon_GetCurCloudTop
02:0003BD9E 61A0            	  8517:     jsr     Ganon_DrawCloud
02:0003BDA0 610000B2        	  8518:     jsr     Ganon_GetCurCloudRight
02:0003BDA4 619A            	  8519:     jsr     Ganon_DrawCloud
02:0003BDA6 610000A6        	  8520:     jsr     Ganon_GetCurCloudLeft
02:0003BDAA 610000B4        	  8521:     jsr     Ganon_GetCurCloudBottom
02:0003BDAE 6190            	  8522:     jsr     Ganon_DrawCloud
02:0003BDB0 610000A2        	  8523:     jsr     Ganon_GetCurCloudRight
02:0003BDB4 618A            	  8524:     jsr     Ganon_DrawCloud
                            	  8525:     ; Draw the top and bottom clouds.
                            	  8526:     ;
02:0003BDB6 10342070        	  8527:     move.b  ($70,A4,D2.W),D0
02:0003BDBA 1880            	  8528:     move.b  D0,($0000,A4)
02:0003BDBC 6100009C        	  8529:     jsr     Ganon_GetCurCloudTop
02:0003BDC0 6100FF7E        	  8530:     jsr     Ganon_DrawCloud
02:0003BDC4 6100009A        	  8531:     jsr     Ganon_GetCurCloudBottom
02:0003BDC8 6100FF76        	  8532:     jsr     Ganon_DrawCloud
                            	  8533:     ; Draw the left and right clouds.
                            	  8534:     ;
02:0003BDCC 61000080        	  8535:     jsr     Ganon_GetCurCloudLeft
02:0003BDD0 41EC0084        	  8536:     lea     ($0084,A4),A0
02:0003BDD4 10302000        	  8537:     move.b  (A0,D2.W),D0
02:0003BDD8 19400001        	  8538:     move.b  D0,($0001,A4)
02:0003BDDC 6100FF62        	  8539:     jsr     Ganon_DrawCloud
02:0003BDE0 6172            	  8540:     jsr     Ganon_GetCurCloudRight
02:0003BDE2 6100FF5C        	  8541:     jsr     Ganon_DrawCloud
                            	  8542:     ; Save the object index.
                            	  8543:     ;
02:0003BDE6 102C0340        	  8544:     move.b  ($0340,A4),D0
02:0003BDEA 1B00            	  8545:     move.b  D0,-(A5)  ; PHA
                            	  8546:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8547:     ;
02:0003BDEC 7402            	  8548:     moveq   #2,D2
                            	  8549:     even
                            	  8550: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003BDEE 19420340        	  8551:     move.b  D2,($0340,A4)
                            	  8552:     ; If object slot < 5 or = 7, then move every frame.
                            	  8553:     ; Else move 3 out of every 4 frames.
                            	  8554:     ;
                            	  8555:     ; This makes pieces spread out in somewhat of a circle,
                            	  8556:     ; by making the pieces at cardinal directions move at
                            	  8557:     ; full speed while the diagonal ones move a little slower.
                            	  8558:     ;
02:0003BDF2 0C020005        	  8559:     cmpi.b  #$05,D2
02:0003BDF6 6510            	  8560:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003BDF8 0C020007        	  8561:     cmpi.b  #$07,D2
02:0003BDFC 670A            	  8562:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003BDFE 102C0015        	  8563:     move.b  ($0015,A4),D0
02:0003BE02 02000003        	  8564:     andi.b #$03,D0
02:0003BE06 6704            	  8565:     beq  _anon_z04_164
                            	  8566:     even
                            	  8567: _L_z04_Ganon_DrawBurst_Move:
02:0003BE08 6100EC9A        	  8568:     jsr     BlueWizzrobe_Move
                            	  8569: _anon_z04_164:
02:0003BE0C 4EB900049174    	  8570:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8571:     ; The frame counter will make the sprite flash.
                            	  8572:     ; The array has the horizontal and vertical flipping attributes.
                            	  8573:     ; Combine them into [03].
                            	  8574:     ;
02:0003BE12 102C0015        	  8575:     move.b  ($0015,A4),D0
02:0003BE16 02000003        	  8576:     andi.b #$03,D0
02:0003BE1A 41F90003BCEA    	  8577:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BE20 12302000        	  8578:     move.b  (A0,D2.W),D1
02:0003BE24 8001            	  8579:     or.b  D1,D0
02:0003BE26 19400003        	  8580:     move.b  D0,($0003,A4)
02:0003BE2A 41F90003BCF4    	  8581:     lea     (GanonBurstTiles).l,A0
02:0003BE30 10302000        	  8582:     move.b  (A0,D2.W),D0
02:0003BE34 4EB9000310B8    	  8583:     jsr     Anim_WriteSprite
                            	  8584:     ; Bottom of the loop.
                            	  8585:     ; Increment object slot while <= 9.
                            	  8586:     ;
02:0003BE3A 5202            	  8587:     addq.b  #1,D2
02:0003BE3C 0C02000A        	  8588:     cmpi.b  #$0A,D2
02:0003BE40 65AC            	  8589:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8590:     ; Restore the object index.
                            	  8591:     ;
02:0003BE42 101D            	  8592:     move.b  (A5)+,D0  ; PLA
02:0003BE44 19400340        	  8593:     move.b  D0,($0340,A4)
02:0003BE48 0A3C0001        	  8594:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BE4C 4E75            	  8595:     rts
                            	  8596: 
                            	  8597: ; Returns:
                            	  8598: ; [00]: X coordinate
                            	  8599: ;
                            	  8600:     even
                            	  8601: Ganon_GetCurCloudLeft:
02:0003BE4E 4EF90002BED8    	  8602:     jmp     c_ganon_get_cur_cloud_left
                            	  8603: 
                            	  8604: Ganon_GetCurCloudRight:
02:0003BE54 4EF90002BE76    	  8605:     jmp     c_ganon_get_cur_cloud_right
                            	  8606: 
