02:0003E2F6 1883            	  3239:     move.b  D3,($0000,A4)
02:0003E2F8 163C00FF        	  3240:     move.b  #$FF,D3
02:0003E2FC 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:0003E300 5203            	  3243:     addq.b  #1,D3
02:0003E302 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E308 12303000        	  3245:     move.b  (A0,D3.W),D1
02:0003E30C B001            	  3246:     cmp.b   D1,D0
02:0003E30E 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:0003E310 1003            	  3254:     move.b  D3,D0
