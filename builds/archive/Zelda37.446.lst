                            	  4137:     ;
02:00047FC6 41EC04BF        	  4138:     lea     ($04BF,A4),A0
02:00047FCA 10302000        	  4139:     move.b  (A0,D2.W),D0
02:00047FCE 02000010        	  4140:     andi.b #$10,D0
