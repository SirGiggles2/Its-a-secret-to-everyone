02:0002F5D8 1940051D        	   846:     move.b  D0,($051D,A4)
02:0002F5DC 0A3C0001        	   847:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002F5E0 4E75            	   848:     rts
