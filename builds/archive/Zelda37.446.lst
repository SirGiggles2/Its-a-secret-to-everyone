                            	  2216:     even
                            	  2217: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:0003378E 102C0070        	  2218:     move.b  ($0070,A4),D0
02:00033792 023C00EE        	  2219:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033796 123C0008        	  2220:     move.b  #$08,D1
02:0003379A D101            	  2221:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003379C 19400070        	  2222:     move.b  D0,($0070,A4)
02:000337A0 522C0421        	  2223:     addq.b  #1,($0421,A4)
02:000337A4 522C0423        	  2224:     addq.b  #1,($0423,A4)
                            	  2225:     ; If VRAM address still points inside the name field,
                            	  2226:     ; then go finish.
                            	  2227:     ;
                            	  2228:     ; The idea is that each name field in nametable begins at
                            	  2229:     ; an address ending in $E. For example, slot 0 has a name
                            	  2230:     ; at VRAM addresses $20CE to $20D5.
                            	  2231:     ;
                            	  2232:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2233:     ; the name field.
                            	  2234:     ;
                            	  2235:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2236:     ; record header.
                            	  2237:     ;
02:000337A8 102C0070        	  2238:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:000337AC 0C0000B0        	  2239:     cmpi.b  #$B0,D0
02:000337B0 6678            	  2240:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2241:     ; The VRAM address now points outside the name field.
                            	  2242:     ; So, wrap around to the beginning of the name field.
                            	  2243:     ;
                            	  2244:     ; For example, $20D6 -> $20CE.
                            	  2245:     ;
02:000337B2 102C0423        	  2246:     move.b  ($0423,A4),D0
02:000337B6 003C0011        	  2247:     ori     #$11,CCR  ; SEC: set C+X
02:000337BA 123C0008        	  2248:     move.b  #$08,D1
02:000337BE 0A3C0010        	  2249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000337C2 9101            	  2250:     subx.b  D1,D0   ; SBC #$08
02:000337C4 0A3C0010        	  2251:     eori    #$10,CCR  ; restore X = 6502 C
02:000337C8 19400423        	  2252:     move.b  D0,($0423,A4)
                            	  2253:     ; It also means that we went past the end of the save slot
                            	  2254:     ; info name. Set the offset to the beginning of the name.
02:000337CC 7600            	  2255:     moveq   #0,D3
02:000337CE 162C0016        	  2256:     move.b  ($0016,A4),D3
02:000337D2 41F900033114    	  2257:     lea     (SlotToNameOffset).l,A0
02:000337D8 10303000        	  2258:     move.b  (A0,D3.W),D0
02:000337DC 19400421        	  2259:     move.b  D0,($0421,A4)
                            	  2260:     ; If the name cursor has gone past the end of the field,
                            	  2261:     ; then wrap around.
02:000337E0 102C0070        	  2262:     move.b  ($0070,A4),D0
02:000337E4 0C0000B0        	  2263:     cmpi.b  #$B0,D0
02:000337E8 6640            	  2264:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:000337EA 7070            	  2265:     moveq   #112,D0
02:000337EC 19400070        	  2266:     move.b  D0,($0070,A4)
                            	  2267:     even
                            	  2268: ; PATCH P25b: FS2-E backspace handler.
                            	  2269: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2270: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2271: ; one column (8 px), and writes a space ($24) to the erased
                            	  2272: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2273: ; cannot cross into a previous slot's name field.
                            	  2274: _L_z02_ModeE_HandleAOrB_Backspace:
02:000337F0 7600            	  2275:     moveq   #0,D3
02:000337F2 162C0016        	  2276:     move.b  ($0016,A4),D3        ; D3 = current slot
02:000337F6 41F900033114    	  2277:     lea     (SlotToNameOffset).l,A0
02:000337FC 12303000        	  2278:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00033800 102C0421        	  2279:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00033804 B001            	  2280:     cmp.b   D1,D0
02:00033806 6322            	  2281:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033808 5300            	  2282:     subq.b  #1,D0
02:0003380A 19400421        	  2283:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:0003380E 532C0423        	  2284:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00033812 122C0070        	  2285:     move.b  ($0070,A4),D1
02:00033816 5101            	  2286:     subi.b  #8,D1
02:00033818 19410070        	  2287:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:0003381C 7224            	  2288:     moveq   #$24,D1              ; space tile
02:0003381E 7600            	  2289:     moveq   #0,D3
02:00033820 1600            	  2290:     move.b  D0,D3                ; D3 = erased offset
02:00033822 41EC0638        	  2291:     lea     ($0638,A4),A0
02:00033826 11813000        	  2292:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2293:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2294:     even
