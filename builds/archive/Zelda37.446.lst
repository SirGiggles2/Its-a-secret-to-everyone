                            	  8613: GanonFrameImages:
02:0003BE66 06              	  8614:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003BE67 08
02:0003BE68 07
02:0003BE69 09
02:0003BE6A 00
02:0003BE6B 00
02:0003BE6C 01
02:0003BE6D 01
02:0003BE6E 02              	  8615:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003BE6F 02
02:0003BE70 03
02:0003BE71 03
02:0003BE72 04
02:0003BE73 00
02:0003BE74 05
02:0003BE75 01
