02:000338F2 003C0011        	  2396:     ori     #$11,CCR  ; SEC: set C+X
02:000338F6 123C0008        	  2397:     move.b  #$08,D1
02:000338FA 0A3C0010        	  2398:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338FE 9101            	  2399:     subx.b  D1,D0   ; SBC #$08
02:00033900 0A3C0010        	  2400:     eori    #$10,CCR  ; restore X = 6502 C
02:00033904 7600            	  2401:     moveq   #0,D3
02:00033906 1600            	  2402:     move.b  D0,D3
02:00033908 102C0015        	  2403:     move.b  ($0015,A4),D0
