                            	  8619: GanonSpriteOffsetsX:
02:0003BE7E 00              	  8620:     dc.b    $00, $10, $00, $10
02:0003BE7F 10
02:0003BE80 00
02:0003BE81 10
                            	  8621: 
                            	  8622:     even
                            	  8623: GanonSpriteOffsetsY:
02:0003BE82 00              	  8624:     dc.b    $00, $00, $10, $10
02:0003BE83 00
02:0003BE84 10
02:0003BE85 10
                            	  8625: 
                            	  8626:     even
                            	  8627: GanonSpriteHFlips:
02:0003BE86 00              	  8628:     dc.b    $00, $01, $00, $01
02:0003BE87 01
02:0003BE88 00
02:0003BE89 01
