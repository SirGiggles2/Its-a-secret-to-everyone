                            	  8694: Ganon_CheckCollisions:
                            	  8695:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  8696:     ; Store in [02] and [03].
                            	  8697:     ;
02:0003BF06 10342070        	  8698:     move.b  ($70,A4,D2.W),D0
02:0003BF0A 023C00EE        	  8699:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF0E 123C0010        	  8700:     move.b  #$10,D1
02:0003BF12 D101            	  8701:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BF14 19400002        	  8702:     move.b  D0,($0002,A4)
02:0003BF18 41EC0084        	  8703:     lea     ($0084,A4),A0
02:0003BF1C 10302000        	  8704:     move.b  (A0,D2.W),D0
02:0003BF20 023C00EE        	  8705:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF24 123C0010        	  8706:     move.b  #$10,D1
02:0003BF28 D101            	  8707:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BF2A 19400003        	  8708:     move.b  D0,($0003,A4)
                            	  8709:     ; Check for a collision with Link.
                            	  8710:     ;
                            	  8711:     ; We can't call CheckLinkCollision, because we need to
                            	  8712:     ; customize Ganon's midpoint.
                            	  8713:     ;
                            	  8714:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  8715:     ; detection, if Link is invincible. Initialize variables that will
                            	  8716:     ; be returned from the partial collision check routine. Then
                            	  8717:     ; call it.
                            	  8718:     ;
02:0003BF2E 102C04F0        	  8719:     move.b  ($04F0,A4),D0
02:0003BF32 6616            	  8720:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003BF34 19400006        	  8721:     move.b  D0,($0006,A4)
02:0003BF38 19400009        	  8722:     move.b  D0,($0009,A4)
02:0003BF3C 1940000C        	  8723:     move.b  D0,($000C,A4)
02:0003BF40 7600            	  8724:     moveq   #0,D3
02:0003BF42 1883            	  8725:     move.b  D3,($0000,A4)
02:0003BF44 4EB900031192    	  8726:     jsr     CheckLinkCollisionPreinit
                            	  8727:     even
                            	  8728: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  8729:     ; If Ganon is not in state 0, then he's brown.
                            	  8730:     ; Go check collision with an arrow.
                            	  8731:     ;
02:0003BF4A 41EC00AC        	  8732:     lea     ($00AC,A4),A0
02:0003BF4E 10302000        	  8733:     move.b  (A0,D2.W),D0
02:0003BF52 6652            	  8734:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  8735:     ; If timer <> 0, then Ganon is visible.
                            	  8736:     ; He can't be harmed like this. So, return.
                            	  8737:     ;
02:0003BF54 10342028        	  8738:     move.b  ($28,A4,D2.W),D0
02:0003BF58 664A            	  8739:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003BF5A 760D            	  8740:     moveq   #13,D3
02:0003BF5C 4EB9000311CC    	  8741:     jsr     CheckMonsterSwordCollision
                            	  8742:     ; If Ganon has died according to the usual collision check rules
                            	  8743:     ; (HP = 0), then:
                            	  8744:     ; 1. Restore HP to the initial value $F0
                            	  8745:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  8746:     ; 3. Change palette row 7 to make Ganon brown
                            	  8747:     ;
02:0003BF62 41EC0405        	  8748:     lea     ($0405,A4),A0
02:0003BF66 10302000        	  8749:     move.b  (A0,D2.W),D0
02:0003BF6A 6718            	  8750:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003BF6C 103C00F0        	  8751:     move.b  #$F0,D0
02:0003BF70 41EC0485        	  8752:     lea     ($0485,A4),A0
02:0003BF74 11802000        	  8753:     move.b  D0,(A0,D2.W)
02:0003BF78 41EC00AC        	  8754:     lea     ($00AC,A4),A0
02:0003BF7C 53302000        	  8755:     subq.b  #1,(A0,D2.W)
02:0003BF80 61000084        	  8756:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  8757:     even
                            	  8758: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  8759:     ; If Ganon was harmed, then play the sound effect
                            	  8760:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  8761:     ;
02:0003BF84 41EC04F0        	  8762:     lea     ($04F0,A4),A0
02:0003BF88 10302000        	  8763:     move.b  (A0,D2.W),D0
02:0003BF8C 670A            	  8764:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003BF8E 6100C1E6        	  8765:     jsr     PlayBossHitCryIfNeeded
02:0003BF92 7040            	  8766:     moveq   #64,D0
02:0003BF94 19802028        	  8767:     move.b  D0,($28,A4,D2.W)
                            	  8768:     even
                            	  8769: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  8770:     ; Reset metastate, because Ganon cannot die this way.
                            	  8771:     ;
02:0003BF98 4EB900049974    	  8772:     jsr     ResetObjMetastate
                            	  8773:     ; Reset shove info and invincibility timer, because Ganon
                            	  8774:     ; doesn't react at all as a usual monster.
                            	  8775:     ;
02:0003BF9E 4EB9000311BA    	  8776:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	  8777:     even
                            	  8778: _L_z04_Ganon_CheckCollisions_Exit:
02:0003BFA4 4E75            	  8779:     rts
                            	  8780: 
                            	  8781:     even
                            	  8782: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  8783:     ; If the silver arrow is not in the inventory, then return.
                            	  8784:     ;
02:0003BFA6 102C0659        	  8785:     move.b  ($0659,A4),D0
02:0003BFAA 0C000002        	  8786:     cmpi.b  #$02,D0
02:0003BFAE 66F4            	  8787:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8788:     ; Reset the collision return value [06].
                            	  8789:     ;
02:0003BFB0 7000            	  8790:     moveq   #0,D0
02:0003BFB2 19400006        	  8791:     move.b  D0,($0006,A4)
                            	  8792:     ; If there's no arrow in flight, then return.
                            	  8793:     ;
02:0003BFB6 7612            	  8794:     moveq   #18,D3
02:0003BFB8 41EC00AC        	  8795:     lea     ($00AC,A4),A0
02:0003BFBC 10303000        	  8796:     move.b  (A0,D3.W),D0
02:0003BFC0 0C000010        	  8797:     cmpi.b  #$10,D0
02:0003BFC4 66DE            	  8798:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8799:     ; Check for collision with an arrow; and return if no collision.
                            	  8800:     ;
02:0003BFC6 4EB9000311D4    	  8801:     jsr     CheckMonsterArrowOrRodCollision
02:0003BFCC 102C0006        	  8802:     move.b  ($0006,A4),D0
02:0003BFD0 67D2            	  8803:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	  8804:     ; Set the Ganon phase to "dying".
                            	  8805:     ;
02:0003BFD2 41EC042C        	  8806:     lea     ($042C,A4),A0
02:0003BFD6 52302000        	  8807:     addq.b  #1,(A0,D2.W)
                            	  8808:     ; Now his body does flash.
                            	  8809:     ;
02:0003BFDA 7028            	  8810:     moveq   #40,D0
02:0003BFDC 41EC04F0        	  8811:     lea     ($04F0,A4),A0
02:0003BFE0 11802000        	  8812:     move.b  D0,(A0,D2.W)
                            	  8813:     ; Set initial cloud distance 8.
                            	  8814:     ;
02:0003BFE4 7008            	  8815:     moveq   #8,D0
02:0003BFE6 41EC0478        	  8816:     lea     ($0478,A4),A0
02:0003BFEA 11802000        	  8817:     move.b  D0,(A0,D2.W)
02:0003BFEE 0A3C0001        	  8818:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BFF2 4E75            	  8819:     rts
                            	  8820: 
                            	  8821:     even
