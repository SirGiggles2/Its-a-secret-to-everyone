                            	  4967: _L_z07_SpreadShot_NextCorner:
                            	  4968:     ; Prepare to process the next corner.
                            	  4969:     ;
                            	  4970:     ; First, restore X offset [02] and Y offset [03].
                            	  4971:     ;
02:00048542 101D            	  4972:     move.b  (A5)+,D0  ; PLA
02:00048544 19400003        	  4973:     move.b  D0,($0003,A4)
02:00048548 101D            	  4974:     move.b  (A5)+,D0  ; PLA
02:0004854A 19400002        	  4975:     move.b  D0,($0002,A4)
                            	  4976:     ; Take turns negating X offset or Y offset for the next round.
                            	  4977:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4978:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4979:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4980:     ; - Fourth turn: doesn't matter
                            	  4981:     ;
                            	  4982:     ;
                            	  4983:     ; Get the loop index.
02:0004854E 101D            	  4984:     move.b  (A5)+,D0  ; PLA
02:00048550 1B00            	  4985:     move.b  D0,-(A5)  ; PHA
02:00048552 7600            	  4986:     moveq   #0,D3
02:00048554 1600            	  4987:     move.b  D0,D3
02:00048556 0C030001        	  4988:     cmpi.b  #$01,D3
02:0004855A 6602            	  4989:     bne  _anon_z07_25
02:0004855C 7603            	  4990:     moveq   #3,D3
                            	  4991: _anon_z07_25:
02:0004855E 10343000        	  4992:     move.b  ($00,A4,D3.W),D0
02:00048562 4600            	  4993:     eori.b #$FF,D0
02:00048564 023C00EE        	  4994:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048568 123C0001        	  4995:     move.b  #$01,D1
02:0004856C D101            	  4996:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004856E 19803000        	  4997:     move.b  D0,($00,A4,D3.W)
                            	  4998:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4999:     ;
02:00048572 101D            	  5000:     move.b  (A5)+,D0  ; PLA
02:00048574 7600            	  5001:     moveq   #0,D3
02:00048576 1600            	  5002:     move.b  D0,D3
02:00048578 5303            	  5003:     subq.b  #1,D3
