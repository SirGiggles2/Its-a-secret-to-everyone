                            	  6136:     even
                            	  6137: _L_z07_MakeSwordShot_SetUp:
02:00048D68 7001            	  6138:     moveq   #1,D0
02:00048D6A 4EB900030946    	  6139:     jsr     PlaySample
                            	  6140:     ; Go finish setting up a sword shot in initial state $10.
                            	  6141:     ;
02:00048D70 7010            	  6142:     moveq   #16,D0
02:00048D72 6704            	  6143:     beq.s  __far_z_07_0095
