                            	  4419: ; AnimateAndDrawCommonObject(val, slot) — ASM: D0=val, D2=slot
                            	  4420: c_animate_and_draw_common_object:
02:0002CCFA 2F02            	  4421:     move.l  D2,-(SP)        ; save D2
02:0002CCFC 2F02            	  4422:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCFE 2F00            	  4423:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4424:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4425:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4426:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4427:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CD00 4EB900000000    	  4428:     jsr     z04_animate_and_draw_common_object
02:0002CD06 508F            	  4429:     addq.l  #8,SP           ; pop val+slot
02:0002CD08 241F            	  4430:     move.l  (SP)+,D2        ; restore D2
02:0002CD0A 4E75            	  4431:     rts
