02:0003BAD4 10302000        	  8089:     move.b  (A0,D2.W),D0
02:0003BAD8 6704            	  8090:     beq  _L_z04_PatraChild_State1_Exit
02:0003BADA 6100FCCC        	  8091:     jsr     SetDeadDummyObjType
                            	  8092:     even
