02:0003BAC2 611C            	  8079:     jsr     PatraChild_Draw
                            	  8080:     ; If Patra's state still = 0, then the last patra child has not
                            	  8081:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  8082:     ;
02:0003BAC4 102C00AD        	  8083:     move.b  ($00AD,A4),D0
02:0003BAC8 6714            	  8084:     beq  _L_z04_PatraChild_State1_Exit
02:0003BACA 4EB900031128    	  8085:     jsr     CheckMonsterCollisions
