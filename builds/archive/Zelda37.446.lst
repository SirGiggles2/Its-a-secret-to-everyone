                            	  4752: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4753: ;==============================================================================
                            	  4754: 
                            	  4755:     xref    _ShootIfWanted
                            	  4756: 
                            	  4757: ; ShootIfWanted(type, slot)
                            	  4758: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4759: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4760: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4761: c_shoot_if_wanted:
02:0002CF24 2F02            	  4762:     move.l  D2,-(SP)
02:0002CF26 202F0008        	  4763:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CF2A 242F000C        	  4764:     move.l  12(SP),D2       ; arg2 = slot
02:0002CF2E 4EB90003C2D4    	  4765:     jsr     _ShootIfWanted
02:0002CF34 640C            	  4766:     bcc.s   .csiw_fail
02:0002CF36 7000            	  4767:     moveq   #0,D0
02:0002CF38 1003            	  4768:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CF3A 008000000100    	  4769:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF40 6002            	  4770:     bra.s   .csiw_done
                            	  4771: .csiw_fail:
02:0002CF42 7000            	  4772:     moveq   #0,D0
                            	  4773: .csiw_done:
02:0002CF44 241F            	  4774:     move.l  (SP)+,D2
02:0002CF46 4E75            	  4775:     rts
