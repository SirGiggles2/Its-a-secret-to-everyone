                            	  2103:     ;
02:00038EAE 101D            	  2104:     move.b  (A5)+,D0  ; PLA
02:00038EB0 023C00EE        	  2105:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038EB4 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038EB8 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038EBC D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00038EBE 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
                            	  2110:     ; If facing vertically, go draw mirrored.
                            	  2111:     ;
02:00038EC0 41EC0098        	  2112:     lea     ($0098,A4),A0
02:00038EC4 10302000        	  2113:     move.b  (A0,D2.W),D0
02:00038EC8 0200000C        	  2114:     andi.b #$0C,D0
02:00038ECC 660C            	  2115:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2116:     ; Else draw not mirrored.
