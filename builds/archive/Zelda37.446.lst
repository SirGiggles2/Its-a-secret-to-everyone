02:00048A52 0C000008        	  5714:     cmpi.b  #$08,D0
02:00048A56 6706            	  5715:     beq  _anon_z07_31
02:00048A58 7600            	  5716:     moveq   #0,D3
02:00048A5A 162C0675        	  5717:     move.b  ($0675,A4),D3
