                            	  4958: _L_z07_SpreadShot_Draw:
                            	  4959:     ; Draw the corner.
                            	  4960:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4961:     ;
02:00048534 7002            	  4962:     moveq   #2,D0
02:00048536 1940000C        	  4963:     move.b  D0,($000C,A4)
