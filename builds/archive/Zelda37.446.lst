02:0003873A E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:0003873C E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:0003873E E308            	  1041:     lsl.b  #1,D0   ; ASL A
