02:00048528 0C00003E        	  4953:     cmpi.b  #$3E,D0
02:0004852C 6514            	  4954:     bcs  _L_z07_SpreadShot_NextCorner
02:0004852E 0C0000E8        	  4955:     cmpi.b  #$E8,D0
