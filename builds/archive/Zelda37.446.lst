02:0003C90A 123C0003        	   301:     move.b  #$03,D1
02:0003C90E D101            	   302:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003C910 194000FC        	   303:     move.b  D0,($00FC,A4)
                            	   304:     ; If hardware vertical scroll still < $F0, then return.
                            	   305:     ;
