02:00048A2A 1600            	  5690:     move.b  D0,D3
02:00048A2C 7000            	  5691:     moveq   #0,D0
02:00048A2E 19400001        	  5692:     move.b  D0,($0001,A4)
02:00048A32 41F900048620    	  5693:     lea     (BoomerangFrameCycle).l,A0
02:00048A38 10303000        	  5694:     move.b  (A0,D3.W),D0
02:00048A3C 1940000C        	  5695:     move.b  D0,($000C,A4)
                            	  5696:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5697:     ;
02:00048A40 1003            	  5698:     move.b  D3,D0
02:00048A42 41F90004862A    	  5699:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:00048A48 10303000        	  5700:     move.b  (A0,D3.W),D0
02:00048A4C 19400004        	  5701:     move.b  D0,($0004,A4)
                            	  5702:     ; TODO: ?
                            	  5703:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5704:     ; Else add the item value of the magic boomerang.
                            	  5705:     ;
                            	  5706:     ; But none of the values in the base sprite attributes array is 8.
                            	  5707:     ;
                            	  5708:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5709:     ; the inventory will always be added to the base sprite attribute.
                            	  5710:     ;
                            	  5711:     ; So, palette row 4 or 5 will be chosen.
                            	  5712:     ;
