02:000487CA 41EC00AC        	  5359:     lea     ($00AC,A4),A0
02:000487CE 11802000        	  5360:     move.b  D0,(A0,D2.W)
                            	  5361:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5362:     ; Else go handle the boomerang being blocked.
                            	  5363:     ;
