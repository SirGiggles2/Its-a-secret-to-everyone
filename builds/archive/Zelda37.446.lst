                            	  4861:     ;
                            	  4862:     ; The shot is spreading out.
                            	  4863:     ;
                            	  4864:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4865:     ; These will be negated appropriately for each corner.
                            	  4866:     ;
02:0004847C 41EC0098        	  4867:     lea     ($0098,A4),A0
02:00048480 10302000        	  4868:     move.b  (A0,D2.W),D0
02:00048484 19400002        	  4869:     move.b  D0,($0002,A4)
02:00048488 19400003        	  4870:     move.b  D0,($0003,A4)
                            	  4871:     ; Reset [0F] to not flip horizontally.
                            	  4872:     ;
02:0004848C 7000            	  4873:     moveq   #0,D0
02:0004848E 1940000F        	  4874:     move.b  D0,($000F,A4)
                            	  4875:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4876:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4877:     ;
02:00048492 7603            	  4878:     moveq   #3,D3
                            	  4879:     even
                            	  4880: _L_z07_SpreadShot_DrawShotCorner:
02:00048494 1003            	  4881:     move.b  D3,D0
02:00048496 1B00            	  4882:     move.b  D0,-(A5)  ; PHA
                            	  4883:     ; Save offset X [02] and Y offset [03].
                            	  4884:     ;
02:00048498 102C0002        	  4885:     move.b  ($0002,A4),D0
02:0004849C 1B00            	  4886:     move.b  D0,-(A5)  ; PHA
02:0004849E 102C0003        	  4887:     move.b  ($0003,A4),D0
02:000484A2 1B00            	  4888:     move.b  D0,-(A5)  ; PHA
                            	  4889:     ; Calculate and set sprite attributes for this corner:
                            	  4890:     ;   base attribute OR (frame counter AND 3)
                            	  4891:     ;
                            	  4892:     ; The base attribute defines how to flip the sprite.
                            	  4893:     ; The frame counter makes the shot flash by cycling each
                            	  4894:     ; palette row.
                            	  4895:     ;
02:000484A4 102C0015        	  4896:     move.b  ($0015,A4),D0
02:000484A8 02000003        	  4897:     andi.b #$03,D0
02:000484AC 41F900048388    	  4898:     lea     (SwordShotSpreadBaseAttr).l,A0
02:000484B2 12303000        	  4899:     move.b  (A0,D3.W),D1
02:000484B6 8001            	  4900:     or.b  D1,D0
02:000484B8 4EB9000310AE    	  4901:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4902:     ; Add the object's X (the center of the spread) and the
                            	  4903:     ; current offset in [02] to set sprite X in [00].
                            	  4904:     ;
02:000484BE 10342070        	  4905:     move.b  ($70,A4,D2.W),D0
02:000484C2 023C00EE        	  4906:     andi    #$EE,CCR  ; CLC: clear C+X
02:000484C6 122C0002        	  4907:     move.b  ($0002,A4),D1
02:000484CA D101            	  4908:     addx.b  D1,D0   ; ADC $02
02:000484CC 1880            	  4909:     move.b  D0,($0000,A4)
                            	  4910:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4911:     ; Else calculate the distance from object X to sprite X.
                            	  4912:     ;
02:000484CE 12342070        	  4913:     move.b  ($70,A4,D2.W),D1
02:000484D2 B001            	  4914:     cmp.b   D1,D0
02:000484D4 651A            	  4915:     bcs  _L_z07_SpreadShot_ReverseSub
02:000484D6 0C0000FC        	  4916:     cmpi.b  #$FC,D0
02:000484DA 6466            	  4917:     bcc  _L_z07_SpreadShot_NextCorner
02:000484DC 003C0011        	  4918:     ori     #$11,CCR  ; SEC: set C+X
02:000484E0 12342070        	  4919:     move.b  ($70,A4,D2.W),D1
02:000484E4 0A3C0010        	  4920:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000484E8 9101            	  4921:     subx.b  D1,D0   ; SBC ObjX,X
02:000484EA 0A3C0010        	  4922:     eori    #$10,CCR  ; restore X = 6502 C
02:000484EE 6014            	  4923:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4924: 
                            	  4925:     even
                            	  4926: _L_z07_SpreadShot_ReverseSub:
02:000484F0 10342070        	  4927:     move.b  ($70,A4,D2.W),D0
02:000484F4 003C0011        	  4928:     ori     #$11,CCR  ; SEC: set C+X
02:000484F8 1214            	  4929:     move.b  ($0000,A4),D1
02:000484FA 0A3C0010        	  4930:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000484FE 9101            	  4931:     subx.b  D1,D0   ; SBC $00
02:00048500 0A3C0010        	  4932:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4933:     even
                            	  4934: _L_z07_SpreadShot_CheckDistance:
                            	  4935:     ; If distance >= $20, skip this corner.
                            	  4936:     ;
02:00048504 0C000020        	  4937:     cmpi.b  #$20,D0
02:00048508 6438            	  4938:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4939:     ; Add the object's Y (the center of the spread) and the
                            	  4940:     ; current offset in [03] to set sprite Y in [01].
                            	  4941:     ;
02:0004850A 41EC0084        	  4942:     lea     ($0084,A4),A0
02:0004850E 10302000        	  4943:     move.b  (A0,D2.W),D0
02:00048512 023C00EE        	  4944:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048516 122C0003        	  4945:     move.b  ($0003,A4),D1
02:0004851A D101            	  4946:     addx.b  D1,D0   ; ADC $03
02:0004851C 19400001        	  4947:     move.b  D0,($0001,A4)
                            	  4948:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
