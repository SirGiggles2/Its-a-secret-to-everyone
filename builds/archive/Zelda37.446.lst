02:0003BA2C 10342070        	  8013:     move.b  ($70,A4,D2.W),D0
02:0003BA30 023C00EE        	  8014:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA34 122C046C        	  8015:     move.b  ($046C,A4),D1
02:0003BA38 D101            	  8016:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003BA3A 19802070        	  8017:     move.b  D0,($70,A4,D2.W)
02:0003BA3E 41EC0084        	  8018:     lea     ($0084,A4),A0
02:0003BA42 10302000        	  8019:     move.b  (A0,D2.W),D0
02:0003BA46 023C00EE        	  8020:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA4A 122C0479        	  8021:     move.b  ($0479,A4),D1
02:0003BA4E D101            	  8022:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003BA50 41EC0084        	  8023:     lea     ($0084,A4),A0
02:0003BA54 11802000        	  8024:     move.b  D0,(A0,D2.W)
                            	  8025:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  8026:     ;
02:0003BA58 7000            	  8027:     moveq   #0,D0
02:0003BA5A 1940000B        	  8028:     move.b  D0,($000B,A4)
                            	  8029:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  8030:     ; monster's angle by $70, else by $60 to go slower.
                            	  8031:     ;
02:0003BA5E 7070            	  8032:     moveq   #112,D0
02:0003BA60 7600            	  8033:     moveq   #0,D3
02:0003BA62 41EC034F        	  8034:     lea     ($034F,A4),A0
02:0003BA66 16302000        	  8035:     move.b  (A0,D2.W),D3
02:0003BA6A 0C030025        	  8036:     cmpi.b  #$25,D3
02:0003BA6E 6702            	  8037:     beq  _anon_z04_159
02:0003BA70 7060            	  8038:     moveq   #96,D0
                            	  8039: _anon_z04_159:
02:0003BA72 61000CC0        	  8040:     jsr     DecreaseObjectAngle
                            	  8041:     ; Load Patra's maneuver index.
                            	  8042:     ; It determines which counts of bits are looked up below.
                            	  8043:     ;
02:0003BA76 7600            	  8044:     moveq   #0,D3
02:0003BA78 162C045F        	  8045:     move.b  ($045F,A4),D3
                            	  8046:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8047:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8048:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8049:     ;
02:0003BA7C 41EC034F        	  8050:     lea     ($034F,A4),A0
02:0003BA80 10302000        	  8051:     move.b  (A0,D2.W),D0
02:0003BA84 0C000025        	  8052:     cmpi.b  #$25,D0
02:0003BA88 661E            	  8053:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BA8A 41F90003B97C    	  8054:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003BA90 10303000        	  8055:     move.b  (A0,D3.W),D0
02:0003BA94 1B00            	  8056:     move.b  D0,-(A5)  ; PHA
02:0003BA96 41F90003B980    	  8057:     lea     (PatraChild1RotationSineBits).l,A0
02:0003BA9C 10303000        	  8058:     move.b  (A0,D3.W),D0
02:0003BAA0 7600            	  8059:     moveq   #0,D3
02:0003BAA2 1600            	  8060:     move.b  D0,D3
02:0003BAA4 101D            	  8061:     move.b  (A5)+,D0  ; PLA
02:0003BAA6 600E            	  8062:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8063: 
                            	  8064:     even
                            	  8065: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8066:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8067:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8068:     ; a small circle (5) and a large circle (6).
                            	  8069:     ;
02:0003BAA8 41F90003B97E    	  8070:     lea     (PatraChild2RotationBits).l,A0
02:0003BAAE 10303000        	  8071:     move.b  (A0,D3.W),D0
02:0003BAB2 7600            	  8072:     moveq   #0,D3
02:0003BAB4 1600            	  8073:     move.b  D0,D3
                            	  8074:     even
