02:000479BE 671C            	  3191:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3192:     ; If Link's X has not changed since the last frame
                            	  3193:     ; (when Link was the target), then XOR the chase target
                            	  3194:     ; coordinates (which were Link's coordinates last frame).
                            	  3195:     ;
                            	  3196:     ; This ends up reflecting Link's coordinates across the room;
                            	  3197:     ; so that monsters chase away from him.
                            	  3198:     ;
                            	  3199:     ; But if Link's X has changed since the last frame, then
                            	  3200:     ; leave the chase target coordinates with his old coordinates.
                            	  3201:     ;
02:000479C0 102C0061        	  3202:     move.b  ($0061,A4),D0
02:000479C4 122C0070        	  3203:     move.b  ($0070,A4),D1
02:000479C8 B001            	  3204:     cmp.b   D1,D0
02:000479CA 6610            	  3205:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:000479CC 4600            	  3206:     eori.b #$FF,D0
02:000479CE 19400061        	  3207:     move.b  D0,($0061,A4)
02:000479D2 102C0062        	  3208:     move.b  ($0062,A4),D0
02:000479D6 4600            	  3209:     eori.b #$FF,D0
