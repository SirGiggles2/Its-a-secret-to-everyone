                            	  4197:     ; Change the coordinates to one corner.
                            	  4198:     ;
02:00039D1A 10342070        	  4199:     move.b  ($70,A4,D2.W),D0
02:00039D1E 023C00EE        	  4200:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039D22 41F900039BD6    	  4201:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039D28 12303000        	  4202:     move.b  (A0,D3.W),D1
02:00039D2C D101            	  4203:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:00039D2E 19802070        	  4204:     move.b  D0,($70,A4,D2.W)
02:00039D32 41EC0084        	  4205:     lea     ($0084,A4),A0
02:00039D36 10302000        	  4206:     move.b  (A0,D2.W),D0
02:00039D3A 023C00EE        	  4207:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039D3E 41F900039BDA    	  4208:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039D44 12303000        	  4209:     move.b  (A0,D3.W),D1
02:00039D48 D101            	  4210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039D4A 41EC0084        	  4211:     lea     ($0084,A4),A0
02:00039D4E 11802000        	  4212:     move.b  D0,(A0,D2.W)
                            	  4213:     ; Check the room boundary and object collisions in this temporary location.
