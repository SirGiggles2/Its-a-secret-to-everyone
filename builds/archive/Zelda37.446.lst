02:0003C928 6706            	   318:     beq  _anon_z05_4
02:0003C92A 4EB900030B4E    	   319:     jsr     WriteBlankPrioritySprites
                            	   320: _anon_z05_4:
                            	   321:     ; We reached the end. So, reset hardware vertical scroll
                            	   322:     ; and submenu state.
                            	   323:     ;
