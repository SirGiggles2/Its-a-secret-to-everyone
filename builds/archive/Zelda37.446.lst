                            	  7110: InitObject:
02:00049528 7400            	  7111:     moveq   #0,D2
02:0004952A 142C0340        	  7112:     move.b  ($0340,A4),D2
                            	  7113:     ; We want to handle "enemies from the edges of the screen".
                            	  7114:     ;
                            	  7115:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7116:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7117:     ; that does not spawn with a cloud (type >= $53);
                            	  7118:     ; 
                            	  7119:     ; then go initialize the object.
                            	  7120:     ;
02:0004952E 102C0010        	  7121:     move.b  ($0010,A4),D0
02:00049532 66000196        	  7122:     bne  _L_z07_InitObject_NormalSpawn
02:00049536 102C04CD        	  7123:     move.b  ($04CD,A4),D0
02:0004953A 02000008        	  7124:     andi.b #$08,D0
02:0004953E 6700018A        	  7125:     beq  _L_z07_InitObject_NormalSpawn
02:00049542 41EC034F        	  7126:     lea     ($034F,A4),A0
02:00049546 10302000        	  7127:     move.b  (A0,D2.W),D0
02:0004954A 0C000011        	  7128:     cmpi.b  #$11,D0
02:0004954E 6700017A        	  7129:     beq  _L_z07_InitObject_NormalSpawn
02:00049552 0C000040        	  7130:     cmpi.b  #$40,D0
02:00049556 67000172        	  7131:     beq  _L_z07_InitObject_NormalSpawn
02:0004955A 0C00001E        	  7132:     cmpi.b  #$1E,D0
02:0004955E 6700016A        	  7133:     beq  _L_z07_InitObject_NormalSpawn
02:00049562 0C00002E        	  7134:     cmpi.b  #$2E,D0
02:00049566 67000162        	  7135:     beq  _L_z07_InitObject_NormalSpawn
02:0004956A 0C000053        	  7136:     cmpi.b  #$53,D0
02:0004956E 6400015A        	  7137:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7138:     even
                            	  7139: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7140:     ; If the "monsters from edges" long timer expired, then
                            	  7141:     ; go bring the monster in.
                            	  7142:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7143:     ;
                            	  7144:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7145:     ; residual position so enemies keep their previous-room
                            	  7146:     ; positions instead of being re-edge-spawned (matches NES).
02:00049572 102C004B        	  7147:     move.b  ($004B,A4),D0
02:00049576 662E            	  7148:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7149:     ; timer == 0. Check for fresh room-entry + residual position.
02:00049578 102C000F        	  7150:     move.b  ($000F,A4),D0
02:0004957C 0C0000FF        	  7151:     cmpi.b  #$FF,D0
02:00049580 662E            	  7152:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049582 41EC0070        	  7153:     lea     ($0070,A4),A0
02:00049586 10302000        	  7154:     move.b  (A0,D2.W),D0
02:0004958A 660A            	  7155:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004958C 41EC0084        	  7156:     lea     ($0084,A4),A0
02:00049590 10302000        	  7157:     move.b  (A0,D2.W),D0
02:00049594 671A            	  7158:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7159:     even
                            	  7160: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
