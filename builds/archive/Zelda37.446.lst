02:0003A2CA 4EB90002AECA    	  4910:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  4911:     even
                            	  4912: UpdateDodongoState_JumpTable:
02:0003A2D0 0003A2DC        	  4913:     dc.l    UpdateDodongoState0_Move   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A2D4 0003A340        	  4914:     dc.l    UpdateDodongoState1_Bloated   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A2D8 0003A33A        	  4915:     dc.l    UpdateDodongoState2_Stunned   ; jump table entry (32-bit for _m68k_tablejump)
