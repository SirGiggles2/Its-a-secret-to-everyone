02:0003BA0E 102C0085        	  7997:     move.b  ($0085,A4),D0
02:0003BA12 003C0011        	  7998:     ori     #$11,CCR  ; SEC: set C+X
02:0003BA16 1214            	  7999:     move.b  ($0000,A4),D1
02:0003BA18 0A3C0010        	  8000:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BA1C 9101            	  8001:     subx.b  D1,D0   ; SBC $00
02:0003BA1E 0A3C0010        	  8002:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BA22 41EC0084        	  8003:     lea     ($0084,A4),A0
02:0003BA26 11802000        	  8004:     move.b  D0,(A0,D2.W)
