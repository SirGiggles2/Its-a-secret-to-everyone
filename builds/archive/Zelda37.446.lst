02:0003E316 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E318 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E31A 02000003        	  3260:     andi.b #$03,D0
02:0003E31E 7600            	  3261:     moveq   #0,D3
02:0003E320 1600            	  3262:     move.b  D0,D3
02:0003E322 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E328 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
