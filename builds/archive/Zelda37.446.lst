02:00038238 12302000        	   321:     move.b  (A0,D2.W),D1
02:0003823C 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038240 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:00038242 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
