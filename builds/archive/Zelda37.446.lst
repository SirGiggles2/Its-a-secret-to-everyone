                            	  4613: _anon_z02_37:
                            	  4614:     ; Add $80 to the scroll speed fraction.
                            	  4615:     ;
02:00034FE8 102C0058        	  4616:     move.b  ($0058,A4),D0
02:00034FEC 023C00EE        	  4617:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034FF0 123C0080        	  4618:     move.b  #$80,D1
02:00034FF4 D101            	  4619:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00034FF6 19400058        	  4620:     move.b  D0,($0058,A4)
                            	  4621:     ; Carry over to the tile offset and current V-scroll.
                            	  4622:     ;
02:00034FFA 6404            	  4623:     bcc  _anon_z02_38
02:00034FFC 522C050B        	  4624:     addq.b  #1,($050B,A4)
                            	  4625: _anon_z02_38:
02:00035000 102C00FC        	  4626:     move.b  ($00FC,A4),D0
02:00035004 123C0000        	  4627:     move.b  #$00,D1
02:00035008 D101            	  4628:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003500A 194000FC        	  4629:     move.b  D0,($00FC,A4)
                            	  4630:     ; If we've reached the bottom of a nametable, then
                            	  4631:     ; roll over current V-scroll to 0, and increase number of
                            	  4632:     ; screens scrolled.
                            	  4633:     ;
02:0003500E 0C0000F0        	  4634:     cmpi.b  #$F0,D0
02:00035012 7000            	  4635:     moveq   #0,D0
02:00035014 6508            	  4636:     bcs  _anon_z02_39
02:00035016 194000FC        	  4637:     move.b  D0,($00FC,A4)
02:0003501A 522C00E2        	  4638:     addq.b  #1,($00E2,A4)
                            	  4639: _anon_z02_39:
                            	  4640:     ; Roll the carry from the comparison above into bit 0.
                            	  4641:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  4642:     ;
02:0003501E E310            	  4643:     roxl.b  #1,D0   ; ROL A
02:00035020 1940005C        	  4644:     move.b  D0,($005C,A4)
                            	  4645:     ; Put the quest number in Y register.
                            	  4646:     ;
02:00035024 7600            	  4647:     moveq   #0,D3
02:00035026 7400            	  4648:     moveq   #0,D2
02:00035028 142C0016        	  4649:     move.b  ($0016,A4),D2
02:0003502C 41EC062D        	  4650:     lea     ($062D,A4),A0
02:00035030 10302000        	  4651:     move.b  (A0,D2.W),D0
02:00035034 6702            	  4652:     beq  _anon_z02_40
02:00035036 5203            	  4653:     addq.b  #1,D3
                            	  4654: _anon_z02_40:
                            	  4655:     ; If we're not showing the last screen, then return.
                            	  4656:     ;
02:00035038 102C00E2        	  4657:     move.b  ($00E2,A4),D0
02:0003503C 41F900034FC0    	  4658:     lea     (CreditsLastScreenList).l,A0
02:00035042 12303000        	  4659:     move.b  (A0,D3.W),D1
02:00035046 B001            	  4660:     cmp.b   D1,D0
02:00035048 651C            	  4661:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4662:     ; If we haven't scrolled the last amount in the last screen,
                            	  4663:     ; then return.
                            	  4664:     ;
02:0003504A 102C00FC        	  4665:     move.b  ($00FC,A4),D0
02:0003504E 41F900034FC2    	  4666:     lea     (CreditsLastVscrollList).l,A0
02:00035054 12303000        	  4667:     move.b  (A0,D3.W),D1
02:00035058 B001            	  4668:     cmp.b   D1,D0
02:0003505A 650A            	  4669:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4670:     ; But if we have, then go to the next submode, and set a timer
                            	  4671:     ; to wait $40 frames in the next submode.
                            	  4672:     ;
02:0003505C 522C0013        	  4673:     addq.b  #1,($0013,A4)
02:00035060 7040            	  4674:     moveq   #64,D0
02:00035062 19400028        	  4675:     move.b  D0,($0028,A4)
