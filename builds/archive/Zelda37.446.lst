02:0003A766 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A76A 123C0008        	  5515:     move.b  #$08,D1
02:0003A76E D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
