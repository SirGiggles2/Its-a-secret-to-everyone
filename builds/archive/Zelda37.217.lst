02:0003CD0C 7020            	  7850:     moveq   #32,D0
02:0003CD0E 7600            	  7851:     moveq   #0,D3
02:0003CD10 41EC034F        	  7852:     lea     ($034F,A4),A0
02:0003CD14 16302000        	  7853:     move.b  (A0,D2.W),D3
