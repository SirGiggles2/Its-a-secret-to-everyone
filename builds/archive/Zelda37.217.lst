02:0003AE10 B001            	  3487:     cmp.b   D1,D0
02:0003AE12 6400FF78        	  3488:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE16 522C0510        	  3489:     addq.b  #1,($0510,A4)
                            	  3490:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3491:     ; and pick up whatever the new value is for state 1.
                            	  3492:     ;
02:0003AE1A 7001            	  3493:     moveq   #1,D0
02:0003AE1C 41EC03D0        	  3494:     lea     ($03D0,A4),A0
02:0003AE20 11802000        	  3495:     move.b  D0,(A0,D2.W)
                            	  3496:     ; Set the long timer to 2, meaning 20 frames.
                            	  3497:     ;
