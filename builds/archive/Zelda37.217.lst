                            	  7699: ; Params:
                            	  7700: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7701: ; [00]: weapon object slot (unused)
                            	  7702: ; [02]: object 1 mid X
                            	  7703: ; [03]: object 1 mid Y
                            	  7704: ; [04]: object 2 mid X
                            	  7705: ; [05]: object 2 mid Y
                            	  7706: ;
                            	  7707: ; Returns:
                            	  7708: ; A: 1 if objects collide
                            	  7709: ; Y: weapon object slot
                            	  7710: ; Z: 0 if objects collide
                            	  7711: ; [06]: 1 if objects collide
                            	  7712: ; [0A]: horizontal distance
                            	  7713: ; [0B]: vertical distance
                            	  7714: ;
                            	  7715: ;
                            	  7716: ; Use the same threshold value horizontally and vertically.
                            	  7717: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7718: ;
                            	  7719:     even
                            	  7720: DoObjectsCollide:
02:0003211C 1940000D        	  7721:     move.b  D0,($000D,A4)
02:00032120 1940000E        	  7722:     move.b  D0,($000E,A4)
                            	  7723: ; Params:
                            	  7724: ; [00]: weapon or Link object slot (unused)
                            	  7725: ; [02]: object 1 mid X
                            	  7726: ; [03]: object 1 mid Y
                            	  7727: ; [04]: object 2 mid X
                            	  7728: ; [05]: object 2 mid Y
                            	  7729: ; [0D]: horizontal threshold
                            	  7730: ; [0E]: vertical threshold
                            	  7731: ;
                            	  7732: ; Returns:
                            	  7733: ; A: 1 if objects collide
                            	  7734: ; Y: weapon or Link object slot (copied from [00])
                            	  7735: ; Z: 0 if objects collide
                            	  7736: ; [06]: 1 if objects collide
                            	  7737: ; [0A]: horizontal distance
                            	  7738: ; [0B]: vertical distance
                            	  7739: ;
                            	  7740: ;
                            	  7741: ; Reset [06] to indicate no collision by default.
                            	  7742: ;
                            	  7743:     even
                            	  7744: DoObjectsCollideWithThresholds:
02:00032124 7000            	  7745:     moveq   #0,D0
02:00032126 19400006        	  7746:     move.b  D0,($0006,A4)
02:0003212A 7600            	  7747:     moveq   #0,D3
02:0003212C 1614            	  7748:     move.b  ($0000,A4),D3
                            	  7749:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7750:     ;
02:0003212E 102C0002        	  7751:     move.b  ($0002,A4),D0
02:00032132 003C0011        	  7752:     ori     #$11,CCR  ; SEC: set C+X
02:00032136 122C0004        	  7753:     move.b  ($0004,A4),D1
02:0003213A 0A3C0010        	  7754:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003213E 9101            	  7755:     subx.b  D1,D0   ; SBC $04
02:00032140 0A3C0010        	  7756:     eori    #$10,CCR  ; restore X = 6502 C
02:00032144 6100E8BE        	  7757:     jsr     Abs
02:00032148 1940000A        	  7758:     move.b  D0,($000A,A4)
                            	  7759:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7760:     ;
02:0003214C 122C000D        	  7761:     move.b  ($000D,A4),D1
02:00032150 B001            	  7762:     cmp.b   D1,D0
02:00032152 642A            	  7763:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7764:     ; Store in [0B] the vertical distance between the two objects.
                            	  7765:     ;
02:00032154 102C0003        	  7766:     move.b  ($0003,A4),D0
02:00032158 003C0011        	  7767:     ori     #$11,CCR  ; SEC: set C+X
02:0003215C 122C0005        	  7768:     move.b  ($0005,A4),D1
02:00032160 0A3C0010        	  7769:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032164 9101            	  7770:     subx.b  D1,D0   ; SBC $05
02:00032166 0A3C0010        	  7771:     eori    #$10,CCR  ; restore X = 6502 C
02:0003216A 6100E898        	  7772:     jsr     Abs
02:0003216E 1940000B        	  7773:     move.b  D0,($000B,A4)
                            	  7774:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7775:     ;
02:00032172 122C000E        	  7776:     move.b  ($000E,A4),D1
02:00032176 B001            	  7777:     cmp.b   D1,D0
02:00032178 6404            	  7778:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7779:     ; If we get here, then the objects are close enough in both axes.
                            	  7780:     ; Return 1.
                            	  7781:     ;
02:0003217A 522C0006        	  7782:     addq.b  #1,($0006,A4)
                            	  7783:     even
