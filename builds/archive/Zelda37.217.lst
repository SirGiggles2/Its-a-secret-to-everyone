02:0004B15C 19400002        	  2348:     move.b  D0,($0002,A4)
02:0004B160 4EB90003136C    	  2349:     jsr     MapScreenPosToPpuAddr
02:0004B166 7400            	  2350:     moveq   #0,D2
02:0004B168 142C0301        	  2351:     move.b  ($0301,A4),D2
                            	  2352:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2353:     ;
                            	  2354:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2355:     ; In total, 11 bytes will be written.
                            	  2356:     ;
                            	  2357:     ; First, write the high byte of PPU address in each record.
                            	  2358:     ;
02:0004B16C 1014            	  2359:     move.b  ($0000,A4),D0
02:0004B16E 41EC0302        	  2360:     lea     ($0302,A4),A0
02:0004B172 11802000        	  2361:     move.b  D0,(A0,D2.W)
02:0004B176 41EC0307        	  2362:     lea     ($0307,A4),A0
02:0004B17A 11802000        	  2363:     move.b  D0,(A0,D2.W)
                            	  2364:     ; Write the low address in the first record. In the second record,
                            	  2365:     ; write (low address + 1).
                            	  2366:     ;
02:0004B17E 102C0001        	  2367:     move.b  ($0001,A4),D0
02:0004B182 41EC0303        	  2368:     lea     ($0303,A4),A0
02:0004B186 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:0004B18A 41EC0308        	  2370:     lea     ($0308,A4),A0
02:0004B18E 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0004B192 41EC0308        	  2372:     lea     ($0308,A4),A0
02:0004B196 52302000        	  2373:     addq.b  #1,(A0,D2.W)
                            	  2374:     ; Write the first tile twice in each record. Patch them later.
                            	  2375:     ;
02:0004B19A 102C0005        	  2376:     move.b  ($0005,A4),D0
02:0004B19E 41EC0305        	  2377:     lea     ($0305,A4),A0
02:0004B1A2 11802000        	  2378:     move.b  D0,(A0,D2.W)
02:0004B1A6 41EC0306        	  2379:     lea     ($0306,A4),A0
02:0004B1AA 11802000        	  2380:     move.b  D0,(A0,D2.W)
02:0004B1AE 41EC030A        	  2381:     lea     ($030A,A4),A0
02:0004B1B2 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B1B6 41EC030B        	  2383:     lea     ($030B,A4),A0
02:0004B1BA 11802000        	  2384:     move.b  D0,(A0,D2.W)
                            	  2385:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2386:     ; Add 1 more to the second byte in each record.
                            	  2387:     ; Here is an example result of this manipulation:
                            	  2388:     ;   record 1: $70, $71
                            	  2389:     ;   record 2: $72, $73
                            	  2390:     ;
02:0004B1BE 0C000046        	  2391:     cmpi.b  #$46,D0
02:0004B1C2 6530            	  2392:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B1C4 0C0000F3        	  2393:     cmpi.b  #$F3,D0
02:0004B1C8 642A            	  2394:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B1CA 023C00EE        	  2395:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B1CE 123C0002        	  2396:     move.b  #$02,D1
02:0004B1D2 D101            	  2397:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B1D4 41EC030A        	  2398:     lea     ($030A,A4),A0
02:0004B1D8 11802000        	  2399:     move.b  D0,(A0,D2.W)
02:0004B1DC 41EC030B        	  2400:     lea     ($030B,A4),A0
02:0004B1E0 11802000        	  2401:     move.b  D0,(A0,D2.W)
02:0004B1E4 41EC0306        	  2402:     lea     ($0306,A4),A0
02:0004B1E8 52302000        	  2403:     addq.b  #1,(A0,D2.W)
02:0004B1EC 41EC030B        	  2404:     lea     ($030B,A4),A0
02:0004B1F0 52302000        	  2405:     addq.b  #1,(A0,D2.W)
