                            	  9907: Manhandla_Move:
                            	  9908:     ; Implement a way of manifesting the fractional part of the speed
                            	  9909:     ; in the movement.
                            	  9910:     ;
                            	  9911:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9912:     ; byte to add to the coordinates, then the effective speed would
                            	  9913:     ; be 1 pixel a frame instead of 1.25.
                            	  9914:     ;
                            	  9915:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9916:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9917:     ;
                            	  9918:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9919:     ;
                            	  9920:     ;   SA := SA + (SL AND $E0)
                            	  9921:     ;   [03] := SH + carry
                            	  9922:     ;
                            	  9923:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9924:     ;
02:0003DCA2 41EC041F        	  9925:     lea     ($041F,A4),A0
02:0003DCA6 10302000        	  9926:     move.b  (A0,D2.W),D0
02:0003DCAA 020000E0        	  9927:     andi.b #$E0,D0
02:0003DCAE 023C00EE        	  9928:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCB2 41EC0412        	  9929:     lea     ($0412,A4),A0
02:0003DCB6 12302000        	  9930:     move.b  (A0,D2.W),D1
02:0003DCBA D101            	  9931:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DCBC 41EC0412        	  9932:     lea     ($0412,A4),A0
02:0003DCC0 11802000        	  9933:     move.b  D0,(A0,D2.W)
                            	  9934:     ; Assign (high speed byte + carry) to [03].
                            	  9935:     ;
02:0003DCC4 41EC042C        	  9936:     lea     ($042C,A4),A0
02:0003DCC8 10302000        	  9937:     move.b  (A0,D2.W),D0
02:0003DCCC 123C0000        	  9938:     move.b  #$00,D1
02:0003DCD0 D101            	  9939:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCD2 19400003        	  9940:     move.b  D0,($0003,A4)
                            	  9941:     ; Change coordinates by the speed amount/offset in [03]
                            	  9942:     ; according to the direction.
                            	  9943:     ;
                            	  9944:     ; Start with a mask of $A1 in [02]:
                            	  9945:     ; - low nibble represents the right direction
                            	  9946:     ; - high nibble is used to set or clear carry as we go along
                            	  9947:     ;
02:0003DCD6 103C00A1        	  9948:     move.b  #$A1,D0
02:0003DCDA 19400002        	  9949:     move.b  D0,($0002,A4)
                            	  9950:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9951:     ;
02:0003DCDE 41EC0098        	  9952:     lea     ($0098,A4),A0
02:0003DCE2 10302000        	  9953:     move.b  (A0,D2.W),D0
02:0003DCE6 122C0002        	  9954:     move.b  ($0002,A4),D1
02:0003DCEA C200            	  9955:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCEC 6712            	  9956:     beq  _L_z04_Manhandla_Move_Left
02:0003DCEE 10342070        	  9957:     move.b  ($70,A4,D2.W),D0
02:0003DCF2 023C00EE        	  9958:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCF6 122C0003        	  9959:     move.b  ($0003,A4),D1
02:0003DCFA D101            	  9960:     addx.b  D1,D0   ; ADC $03
02:0003DCFC 19802070        	  9961:     move.b  D0,($70,A4,D2.W)
                            	  9962:     even
                            	  9963: _L_z04_Manhandla_Move_Left:
                            	  9964:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9965:     ;
02:0003DD00 41EC0098        	  9966:     lea     ($0098,A4),A0
02:0003DD04 10302000        	  9967:     move.b  (A0,D2.W),D0
02:0003DD08 122C0002        	  9968:     move.b  ($0002,A4),D1
02:0003DD0C E309            	  9969:     lsl.b  #1,D1   ; ASL $02
02:0003DD0E 19410002        	  9970:     move.b  D1,($0002,A4)
02:0003DD12 122C0002        	  9971:     move.b  ($0002,A4),D1
02:0003DD16 C200            	  9972:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD18 6716            	  9973:     beq  _L_z04_Manhandla_Move_Down
02:0003DD1A 10342070        	  9974:     move.b  ($70,A4,D2.W),D0
02:0003DD1E 122C0003        	  9975:     move.b  ($0003,A4),D1
02:0003DD22 0A3C0010        	  9976:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD26 9101            	  9977:     subx.b  D1,D0   ; SBC $03
02:0003DD28 0A3C0010        	  9978:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD2C 19802070        	  9979:     move.b  D0,($70,A4,D2.W)
                            	  9980:     even
