                            	  6187: __far_z_05_0094:
                            	  6188:     ; Turn the door command into the desired open or closed state
                            	  6189:     ; to store in [08].
                            	  6190:     ;
                            	  6191:     ; cmd:  7 6 3 2 
                            	  6192:     ; [08]: 2 0 0 0
                            	  6193:     ;
                            	  6194:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6195:     ; commands intended to be used.
                            	  6196:     ;
                            	  6197:     ; 3 is the end state of 2: close
                            	  6198:     ; 7 is the end state of 6: open
                            	  6199:     ;
02:00043B2E 02000007        	  6200:     andi.b #$07,D0
02:00043B32 7601            	  6201:     moveq   #1,D3
02:00043B34 19430002        	  6202:     move.b  D3,($0002,A4)
02:00043B38 122C0002        	  6203:     move.b  ($0002,A4),D1
02:00043B3C C200            	  6204:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043B3E 6702            	  6205:     beq  _anon_z05_118
02:00043B40 E208            	  6206:     lsr.b  #1,D0   ; LSR A
                            	  6207: _anon_z05_118:
02:00043B42 0C000002        	  6208:     cmpi.b  #$02,D0
02:00043B46 6606            	  6209:     bne  _anon_z05_119
                            	  6210:     ; Command 2 sets Link's timer to $30.
                            	  6211:     ;
02:00043B48 7630            	  6212:     moveq   #48,D3
02:00043B4A 19430028        	  6213:     move.b  D3,($0028,A4)
                            	  6214: _anon_z05_119:
02:00043B4E 02000003        	  6215:     andi.b #$03,D0
02:00043B52 003C0011        	  6216:     ori     #$11,CCR  ; SEC: set C+X
02:00043B56 123C0001        	  6217:     move.b  #$01,D1
02:00043B5A 0A3C0010        	  6218:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043B5E 9101            	  6219:     subx.b  D1,D0   ; SBC #$01
02:00043B60 0A3C0010        	  6220:     eori    #$10,CCR  ; restore X = 6502 C
02:00043B64 02000002        	  6221:     andi.b #$02,D0
02:00043B68 19400008        	  6222:     move.b  D0,($0008,A4)
                            	  6223:     ; The command to close a key door or bombable wall does not
                            	  6224:     ; do anything.
                            	  6225:     ;
02:00043B6C 102C0054        	  6226:     move.b  ($0054,A4),D0
02:00043B70 0C000005        	  6227:     cmpi.b  #$05,D0
02:00043B74 6416            	  6228:     bcc  _anon_z05_120
02:00043B76 102C0055        	  6229:     move.b  ($0055,A4),D0
02:00043B7A 19400002        	  6230:     move.b  D0,($0002,A4)
02:00043B7E 6100FAEC        	  6231:     jsr     FindDoorAttrByDoorBit
02:00043B82 0C000007        	  6232:     cmpi.b  #$07,D0
02:00043B86 6704            	  6233:     beq  _anon_z05_120
02:00043B88 6000009C        	  6234:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  6235: 
                            	  6236: _anon_z05_120:
                            	  6237:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6238:     ;
                            	  6239:     ; Shutters and the commands to open a door always change
                            	  6240:     ; tiles.
                            	  6241:     ;
02:00043B8C 61000130        	  6242:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6243:     even
                            	  6244: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6245:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6246:     ; We need to remember how many tiles need to be copied
                            	  6247:     ; in each transfer record.
                            	  6248:     ;
02:00043B90 102C0006        	  6249:     move.b  ($0006,A4),D0
02:00043B94 19400004        	  6250:     move.b  D0,($0004,A4)
                            	  6251:     ; Write the transfer record header for the door.
                            	  6252:     ;
                            	  6253:     ;
                            	  6254:     ; VRAM address high byte of door
02:00043B98 1014            	  6255:     move.b  ($0000,A4),D0
02:00043B9A 41EC0302        	  6256:     lea     ($0302,A4),A0
02:00043B9E 11802000        	  6257:     move.b  D0,(A0,D2.W)
02:00043BA2 5202            	  6258:     addq.b  #1,D2
02:00043BA4 102C0001        	  6259:     move.b  ($0001,A4),D0
02:00043BA8 41EC0302        	  6260:     lea     ($0302,A4),A0
02:00043BAC 11802000        	  6261:     move.b  D0,(A0,D2.W)
02:00043BB0 5202            	  6262:     addq.b  #1,D2
02:00043BB2 102C0006        	  6263:     move.b  ($0006,A4),D0
02:00043BB6 41EC0302        	  6264:     lea     ($0302,A4),A0
02:00043BBA 11802000        	  6265:     move.b  D0,(A0,D2.W)
02:00043BBE 5202            	  6266:     addq.b  #1,D2
                            	  6267: _anon_z05_121:
                            	  6268:     ; Write two tiles in a short loop indexed by [04].
                            	  6269:     ;
02:00043BC0 6100ED1C        	  6270:     jsr     WriteDoorFaceTileHorizontally
02:00043BC4 66FA            	  6271:     bne  _anon_z05_121
                            	  6272:     ; OR the low VRAM address with $20 to go down one row
                            	  6273:     ; in order to work on the second row of door tiles.
                            	  6274:     ;
02:00043BC6 7020            	  6275:     moveq   #32,D0
02:00043BC8 122C0001        	  6276:     move.b  ($0001,A4),D1
02:00043BCC 8001            	  6277:     or.b  D1,D0
02:00043BCE 19400001        	  6278:     move.b  D0,($0001,A4)
                            	  6279:     ; Bottom of the loop.
                            	  6280:     ; Loop again to write the second transfer record for the
                            	  6281:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6282:     ;
02:00043BD2 532C0005        	  6283:     subq.b  #1,($0005,A4)
02:00043BD6 66B8            	  6284:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6285:     ; Write the end marker, and update buffer length.
                            	  6286:     ;
02:00043BD8 103C00FF        	  6287:     move.b  #$FF,D0
02:00043BDC 41EC0302        	  6288:     lea     ($0302,A4),A0
02:00043BE0 11802000        	  6289:     move.b  D0,(A0,D2.W)
02:00043BE4 1002            	  6290:     move.b  D2,D0
02:00043BE6 19400301        	  6291:     move.b  D0,($0301,A4)
                            	  6292:     ; Increment the command.
                            	  6293:     ;
02:00043BEA 522C0054        	  6294:     addq.b  #1,($0054,A4)
                            	  6295:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6296:     ; and resetting the door command.
                            	  6297:     ; This ends up catching original states 3 and 7.
                            	  6298:     ;
                            	  6299:     ; Else set door timer to 8 and return.
                            	  6300:     ;
02:00043BEE 102C0054        	  6301:     move.b  ($0054,A4),D0
02:00043BF2 02000003        	  6302:     andi.b #$03,D0
02:00043BF6 6708            	  6303:     beq  _anon_z05_122
02:00043BF8 7008            	  6304:     moveq   #8,D0
02:00043BFA 19400027        	  6305:     move.b  D0,($0027,A4)
02:00043BFE 4E75            	  6306:     rts
                            	  6307: 
                            	  6308: _anon_z05_122:
                            	  6309:     ; If the door command = 4 after incrementing it, then
                            	  6310:     ; it was 3 (close door). So:
                            	  6311:     ; 1. reset this door's flag
                            	  6312:     ; 2. remove it from the opened door mask
                            	  6313:     ; 3. reset the door command
                            	  6314:     ; 4. go lay out doors in the play area map
                            	  6315:     ;
02:00043C00 102C0054        	  6316:     move.b  ($0054,A4),D0
02:00043C04 0C000004        	  6317:     cmpi.b  #$04,D0
02:00043C08 6626            	  6318:     bne  _anon_z05_123
02:00043C0A 7400            	  6319:     moveq   #0,D2
02:00043C0C 142C0009        	  6320:     move.b  ($0009,A4),D2
02:00043C10 6100DACE        	  6321:     jsr     ResetDoorFlag
02:00043C14 102C0055        	  6322:     move.b  ($0055,A4),D0
02:00043C18 0A00000F        	  6323:     eori.b #$0F,D0
02:00043C1C 122C00EE        	  6324:     move.b  ($00EE,A4),D1
02:00043C20 C001            	  6325:     and.b  D1,D0
                            	  6326:     even
                            	  6327: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043C22 194000EE        	  6328:     move.b  D0,($00EE,A4)
                            	  6329:     even
                            	  6330: L_ResetDoorCmdAndLayOutDoors:
02:00043C26 7000            	  6331:     moveq   #0,D0
02:00043C28 19400054        	  6332:     move.b  D0,($0054,A4)
02:00043C2C 6000FCD4        	  6333:     jmp     LayOutDoors
                            	  6334: 
                            	  6335: _anon_z05_123:
                            	  6336:     ; Door command <> 4.
                            	  6337:     ; It must be 8, which means it was 7: open door.
                            	  6338:     ;
                            	  6339:     ; If the door is a shutter (7), then go add the door to the
                            	  6340:     ; opened door mask, reset door command, and lay out doors.
                            	  6341:     ;
02:00043C30 102C0055        	  6342:     move.b  ($0055,A4),D0
02:00043C34 19400002        	  6343:     move.b  D0,($0002,A4)
02:00043C38 6100FA32        	  6344:     jsr     FindDoorAttrByDoorBit
02:00043C3C 0C000007        	  6345:     cmpi.b  #$07,D0
02:00043C40 676E            	  6346:     beq  _anon_z05_124
                            	  6347:     ; Else the door is not a shutter.
                            	  6348:     ;
                            	  6349:     ;
                            	  6350:     ; [09] door direction index
02:00043C42 7400            	  6351:     moveq   #0,D2
02:00043C44 142C0009        	  6352:     move.b  ($0009,A4),D2
02:00043C48 6100DA90        	  6353:     jsr     SetDoorFlag
                            	  6354:     ; Get the next room's ID.
                            	  6355:     ;
02:00043C4C 1003            	  6356:     move.b  D3,D0
02:00043C4E 023C00EE        	  6357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043C52 41F900043B0E    	  6358:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043C58 12302000        	  6359:     move.b  (A0,D2.W),D1
02:00043C5C D101            	  6360:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043C5E 7600            	  6361:     moveq   #0,D3
02:00043C60 1600            	  6362:     move.b  D0,D3
                            	  6363:     ; Flip the door direction index.
                            	  6364:     ;
02:00043C62 1002            	  6365:     move.b  D2,D0
02:00043C64 0A000001        	  6366:     eori.b #$01,D0
02:00043C68 7400            	  6367:     moveq   #0,D2
02:00043C6A 1400            	  6368:     move.b  D0,D2
                            	  6369:     ; Set the door flag for the opposite door in the next room.
                            	  6370:     ;
02:00043C6C 1214            	  6371:     move.b  ($00,A4),D1   ; ptr lo
02:00043C6E 182C0001        	  6372:     move.b  ($01,A4),D4  ; ptr hi
02:00043C72 024100FF        	  6373:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C76 E14C            	  6374:     lsl.w   #8,D4
02:00043C78 8841            	  6375:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043C7A 48C4            	  6376:     ext.l   D4
02:00043C7C D8BC00FF0000    	  6377:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043C82 2044            	  6378:     movea.l D4,A0
02:00043C84 10303000        	  6379:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043C88 41F90004AE74    	  6380:     lea     (LevelMasks).l,A0
02:00043C8E 12302000        	  6381:     move.b  (A0,D2.W),D1
02:00043C92 8001            	  6382:     or.b  D1,D0
02:00043C94 1214            	  6383:     move.b  ($00,A4),D1   ; ptr lo
02:00043C96 182C0001        	  6384:     move.b  ($01,A4),D4  ; ptr hi
02:00043C9A 024100FF        	  6385:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C9E E14C            	  6386:     lsl.w   #8,D4
02:00043CA0 8841            	  6387:     or.w    D1,D4
02:00043CA2 48C4            	  6388:     ext.l   D4
02:00043CA4 D8BC00FF0000    	  6389:     add.l   #NES_RAM,D4
02:00043CAA 2044            	  6390:     movea.l D4,A0
02:00043CAC 11803000        	  6391:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6392: _anon_z05_124:
                            	  6393:     ; Add the door to the opened door mask, reset door command,
                            	  6394:     ; and lay out doors.
                            	  6395:     ;
02:00043CB0 102C0055        	  6396:     move.b  ($0055,A4),D0
02:00043CB4 122C00EE        	  6397:     move.b  ($00EE,A4),D1
02:00043CB8 8001            	  6398:     or.b  D1,D0
02:00043CBA 6000FF66        	  6399:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6400: 
                            	  6401: ; Params:
                            	  6402: ; [08]: 0 if closed
                            	  6403: ;
                            	  6404: ; Returns:
                            	  6405: ; X: current length of dynamic transfer buf
                            	  6406: ; [00]: door VRAM address high byte
                            	  6407: ; [01]: door VRAM address low byte
                            	  6408: ; [02:03]: address of door tiles for direction and face
                            	  6409: ; [05]: 2, the number of transfer records to write
                            	  6410: ; [06]: 2, the number of tiles in each record
                            	  6411: ; [07]: 0, the first index of a tile to transfer
                            	  6412: ; [09]: door direction index
                            	  6413: ;
                            	  6414: ; Note that this routine is called with triggered doors:
                            	  6415: ; doors that can change state. Their door type numbers are >= 4.
                            	  6416: ;
                            	  6417: ; If this routine were ever called with a fixed door
                            	  6418: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6419: ; values for the door face.
                            	  6420: ;
                            	  6421: ;
                            	  6422: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6423: ;
                            	  6424:     even
                            	  6425: PrepareWriteHorizontalDoorTransferRecords:
02:00043CBE 102C0055        	  6426:     move.b  ($0055,A4),D0
02:00043CC2 19400002        	  6427:     move.b  D0,($0002,A4)
02:00043CC6 6100F9A4        	  6428:     jsr     FindDoorAttrByDoorBit
02:00043CCA 0C000005        	  6429:     cmpi.b  #$05,D0
02:00043CCE 650C            	  6430:     bcs  _anon_z05_125
02:00043CD0 1B00            	  6431:     move.b  D0,-(A5)  ; PHA
02:00043CD2 7004            	  6432:     moveq   #4,D0
02:00043CD4 4EB900030548    	  6433:     jsr     PlaySample
02:00043CDA 101D            	  6434:     move.b  (A5)+,D0  ; PLA
                            	  6435: _anon_z05_125:
                            	  6436:     ; Calculate the door face index in three parts.
                            	  6437:     ;
                            	  6438:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6439:     ; (provisional face index in Y register).
                            	  6440:     ;
02:00043CDC 0C000004        	  6441:     cmpi.b  #$04,D0
02:00043CE0 6602            	  6442:     bne  _anon_z05_126
02:00043CE2 7008            	  6443:     moveq   #8,D0
                            	  6444: _anon_z05_126:
02:00043CE4 0C000001        	  6445:     cmpi.b  #$01,D0
02:00043CE8 6602            	  6446:     bne  _anon_z05_127
02:00043CEA 7004            	  6447:     moveq   #4,D0
                            	  6448: _anon_z05_127:
                            	  6449:     ; Second, subtract 3 from provisional face index.
                            	  6450:     ;
02:00043CEC 003C0011        	  6451:     ori     #$11,CCR  ; SEC: set C+X
02:00043CF0 123C0003        	  6452:     move.b  #$03,D1
02:00043CF4 0A3C0010        	  6453:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043CF8 9101            	  6454:     subx.b  D1,D0   ; SBC #$03
02:00043CFA 0A3C0010        	  6455:     eori    #$10,CCR  ; restore X = 6502 C
02:00043CFE 7600            	  6456:     moveq   #0,D3
02:00043D00 1600            	  6457:     move.b  D0,D3
                            	  6458:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6459:     ; face index >= 3, then subtract 1 from it.
                            	  6460:     ;
                            	  6461:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6462:     ; then make it 1.
                            	  6463:     ;
02:00043D02 102C0008        	  6464:     move.b  ($0008,A4),D0
02:00043D06 6708            	  6465:     beq  _anon_z05_128
02:00043D08 0C030005        	  6466:     cmpi.b  #$05,D3
02:00043D0C 670A            	  6467:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D0E 7601            	  6468:     moveq   #1,D3
                            	  6469: _anon_z05_128:
02:00043D10 0C030003        	  6470:     cmpi.b  #$03,D3
02:00043D14 6502            	  6471:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D16 5303            	  6472:     subq.b  #1,D3
                            	  6473:     even
                            	  6474: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6475:     ; The routine that returned the door type also returned its
                            	  6476:     ; reverse direction index in [03].
                            	  6477:     ;
                            	  6478:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6479:     ;
02:00043D18 7003            	  6480:     moveq   #3,D0
02:00043D1A 003C0011        	  6481:     ori     #$11,CCR  ; SEC: set C+X
02:00043D1E 122C0003        	  6482:     move.b  ($0003,A4),D1
02:00043D22 0A3C0010        	  6483:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043D26 9101            	  6484:     subx.b  D1,D0   ; SBC $03
02:00043D28 0A3C0010        	  6485:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6486:     ; Call this to put the address of door face tiles in [02:03].
                            	  6487:     ;
02:00043D2C 6100FD7A        	  6488:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6489:     ; Return the address of the door in the nametable in [01:00].
                            	  6490:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6491:     ;
02:00043D30 41F900043B06    	  6492:     lea     (DoorVramAddrsHi).l,A0
02:00043D36 10302000        	  6493:     move.b  (A0,D2.W),D0
02:00043D3A 1880            	  6494:     move.b  D0,($0000,A4)
02:00043D3C 41F900043B0A    	  6495:     lea     (DoorVramAddrsLo).l,A0
02:00043D42 10302000        	  6496:     move.b  (A0,D2.W),D0
02:00043D46 19400001        	  6497:     move.b  D0,($0001,A4)
                            	  6498:     ; Return the direction of the door in [09], and the dynamic
                            	  6499:     ; transfer buf length in X register.
                            	  6500:     ;
02:00043D4A 19420009        	  6501:     move.b  D2,($0009,A4)
02:00043D4E 7400            	  6502:     moveq   #0,D2
02:00043D50 142C0301        	  6503:     move.b  ($0301,A4),D2
                            	  6504:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6505:     ;
02:00043D54 7000            	  6506:     moveq   #0,D0
02:00043D56 19400007        	  6507:     move.b  D0,($0007,A4)
02:00043D5A 7002            	  6508:     moveq   #2,D0
02:00043D5C 19400006        	  6509:     move.b  D0,($0006,A4)
02:00043D60 19400005        	  6510:     move.b  D0,($0005,A4)
02:00043D64 0A3C0001        	  6511:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043D68 4E75            	  6512:     rts
                            	  6513: 
                            	  6514:     even
                            	  6515: ColumnDirectoryUW:
02:00043D6A 00043546        	  6516:     dc.l    ColumnHeapUW0
02:00043D6E 00043556        	  6517:     dc.l    ColumnHeapUW1
02:00043D72 00043574        	  6518:     dc.l    ColumnHeapUW2
02:00043D76 00043586        	  6519:     dc.l    ColumnHeapUW3
02:00043D7A 00043598        	  6520:     dc.l    ColumnHeapUW4
02:00043D7E 000435B0        	  6521:     dc.l    ColumnHeapUW5
02:00043D82 000435C8        	  6522:     dc.l    ColumnHeapUW6
02:00043D86 000435DA        	  6523:     dc.l    ColumnHeapUW7
02:00043D8A 000435EC        	  6524:     dc.l    ColumnHeapUW8
02:00043D8E 00043606        	  6525:     dc.l    ColumnHeapUW9
