                            	  6603: Digdogger_Move:
                            	  6604:     ; This calculation is the same one used in Manhandla to
                            	  6605:     ; manifest the fractional speed over several frames.
                            	  6606:     ;
                            	  6607:     ; To summarize, the formula is:
                            	  6608:     ;
                            	  6609:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6610:     ;
                            	  6611:     ;   SA := SA + (SL AND $E0)
                            	  6612:     ;   [03] := SH + carry
                            	  6613:     ;
                            	  6614:     ; See 04:A28E Manhandla_Move.
                            	  6615:     ;
02:0003C462 41EC041F        	  6616:     lea     ($041F,A4),A0
02:0003C466 10302000        	  6617:     move.b  (A0,D2.W),D0
02:0003C46A 020000E0        	  6618:     andi.b #$E0,D0
02:0003C46E 023C00EE        	  6619:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C472 41EC0412        	  6620:     lea     ($0412,A4),A0
02:0003C476 12302000        	  6621:     move.b  (A0,D2.W),D1
02:0003C47A D101            	  6622:     addx.b  D1,D0   ; ADC $0412,X
