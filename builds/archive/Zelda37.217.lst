02:0002DDE4 660A            	   451:     bne  _anon_z01_2
02:0002DDE6 102C0015        	   452:     move.b  ($0015,A4),D0
02:0002DDEA 02000001        	   453:     andi.b #$01,D0
02:0002DDEE 6652            	   454:     bne  _L_z01_UpdateCavePerson_UpdateCavePersonDirect
                            	   455: _anon_z01_2:
