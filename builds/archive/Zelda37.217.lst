                            	   339:     ;
02:00040274 522C00E1        	   340:     addq.b  #1,($00E1,A4)
02:00040278 102C0010        	   341:     move.b  ($0010,A4),D0
02:0004027C 67000084        	   342:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:00040280 102C0012        	   343:     move.b  ($0012,A4),D0
02:00040284 0C000009        	   344:     cmpi.b  #$09,D0
02:00040288 6778            	   345:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   346:     ; Calculate the X coordinate of the submenu position marker.
                            	   347:     ;
                            	   348:     ; First, mask off the high nibble of the room ID and multiply by
                            	   349:     ; the width of a tile, 8. Store the result in [00].
                            	   350:     ;
02:0004028A 102C00EB        	   351:     move.b  ($00EB,A4),D0
02:0004028E 0200000F        	   352:     andi.b #$0F,D0
02:00040292 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:00040294 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:00040296 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:00040298 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   358:     ; negative or left rotation by ($10 - rotation value).
                            	   359:     ;
                            	   360:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   361:     ; the width of a tile. Then negate it. The final result is the
                            	   362:     ; negative offset.
                            	   363:     ;
02:0004029A 103900FF6BAB    	   364:     move.b  (NES_SRAM+$0BAB).l,D0
02:000402A0 0C000008        	   365:     cmpi.b  #$08,D0
02:000402A4 6520            	   366:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:000402A6 7010            	   367:     moveq   #16,D0
02:000402A8 123900FF6BAB    	   368:     move.b  (NES_SRAM+$0BAB).l,D1
02:000402AE 0A3C0010        	   369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000402B2 9101            	   370:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:000402B4 0A3C0010        	   371:     eori    #$10,CCR  ; restore X = 6502 C
02:000402B8 E308            	   372:     lsl.b  #1,D0   ; ASL A
02:000402BA E308            	   373:     lsl.b  #1,D0   ; ASL A
02:000402BC E308            	   374:     lsl.b  #1,D0   ; ASL A
