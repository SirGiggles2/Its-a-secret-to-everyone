                            	  2107:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2108:     ; which here represents an offset from the palette row.
                            	  2109:     ;
02:0004AFB6 023C00EE        	  2110:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AFBA 122C0004        	  2111:     move.b  ($0004,A4),D1
02:0004AFBE D101            	  2112:     addx.b  D1,D0   ; ADC $04
02:0004AFC0 4A02            	  2113:     cmpi.b  #$00,D2
02:0004AFC2 66E4            	  2114:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AFC4 0C000002        	  2115:     cmpi.b  #$02,D0
02:0004AFC8 66DE            	  2116:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AFCA 7620            	  2117:     moveq   #32,D3
