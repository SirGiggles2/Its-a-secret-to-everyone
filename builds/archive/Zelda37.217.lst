                            	   771: UpdateBlock0Idle:
                            	   772:     ; If there are monsters in the room, go reset the push timer and return.
                            	   773:     ;
02:00039AE0 102C034D        	   774:     move.b  ($034D,A4),D0
02:00039AE4 6604            	   775:     bne.s  __far_z_04_0005
02:00039AE6 600000DA        	   776:     jmp  ResetPushTimer
                            	   777: __far_z_04_0005:
                            	   778:     ; If Link's X is aligned with the block's, then get the difference
                            	   779:     ; between Link's (Y + 3) and the block's Y.
                            	   780:     ; Then go test the difference.
                            	   781:     ;
02:00039AEA 102C0070        	   782:     move.b  ($0070,A4),D0
02:00039AEE 12342070        	   783:     move.b  ($70,A4,D2.W),D1
02:00039AF2 B001            	   784:     cmp.b   D1,D0
02:00039AF4 6628            	   785:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039AF6 7600            	   786:     moveq   #0,D3
02:00039AF8 102C0084        	   787:     move.b  ($0084,A4),D0
02:00039AFC 023C00EE        	   788:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039B00 123C0003        	   789:     move.b  #$03,D1
02:00039B04 D101            	   790:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039B06 003C0011        	   791:     ori     #$11,CCR  ; SEC: set C+X
02:00039B0A 41EC0084        	   792:     lea     ($0084,A4),A0
02:00039B0E 12302000        	   793:     move.b  (A0,D2.W),D1
02:00039B12 0A3C0010        	   794:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039B16 9101            	   795:     subx.b  D1,D0   ; SBC ObjY,X
02:00039B18 0A3C0010        	   796:     eori    #$10,CCR  ; restore X = 6502 C
02:00039B1C 6036            	   797:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   798: 
                            	   799:     even
                            	   800: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   801:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   802:     ; go reset the push timer.
                            	   803:     ;
02:00039B1E 102C0084        	   804:     move.b  ($0084,A4),D0
02:00039B22 023C00EE        	   805:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039B26 123C0003        	   806:     move.b  #$03,D1
02:00039B2A D101            	   807:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039B2C 41EC0084        	   808:     lea     ($0084,A4),A0
02:00039B30 12302000        	   809:     move.b  (A0,D2.W),D1
02:00039B34 B001            	   810:     cmp.b   D1,D0
02:00039B36 6704            	   811:     beq.s  __far_z_04_0006
02:00039B38 60000088        	   812:     jmp  ResetPushTimer
                            	   813: __far_z_04_0006:
                            	   814:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   815:     ; Get the difference in X.
                            	   816:     ;
02:00039B3C 7602            	   817:     moveq   #2,D3
02:00039B3E 102C0070        	   818:     move.b  ($0070,A4),D0
02:00039B42 003C0011        	   819:     ori     #$11,CCR  ; SEC: set C+X
02:00039B46 12342070        	   820:     move.b  ($70,A4,D2.W),D1
02:00039B4A 0A3C0010        	   821:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039B4E 9101            	   822:     subx.b  D1,D0   ; SBC ObjX,X
02:00039B50 0A3C0010        	   823:     eori    #$10,CCR  ; restore X = 6502 C
                            	   824:     even
                            	   825: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   826:     ; If the difference in coordinates is negative, then Link is
                            	   827:     ; up or left of the block.
                            	   828:     ;
                            	   829:     ; In that case, increase Y register to index the correct opposite
                            	   830:     ; direction below. Also, negate the difference, so we test
                            	   831:     ; positive values.
                            	   832:     ;
02:00039B54 6A08            	   833:     bpl  _anon_z04_14
02:00039B56 5203            	   834:     addq.b  #1,D3
02:00039B58 4EB900030A08    	   835:     jsr     Negate
                            	   836: _anon_z04_14:
                            	   837:     ; If the distance >= $11, then go reset the push timer and return.
                            	   838:     ;
02:00039B5E 0C000011        	   839:     cmpi.b  #$11,D0
02:00039B62 6502            	   840:     bcs.s  __far_z_04_0007
02:00039B64 605C            	   841:     jmp  ResetPushTimer
                            	   842: __far_z_04_0007:
                            	   843:     ; At this point, Link is aligned with the block.
                            	   844:     ;
                            	   845:     ; If the input direction is not the required direction based on
                            	   846:     ; Link's placement; then go reset the push timer and return.
                            	   847:     ;
02:00039B66 102C03F8        	   848:     move.b  ($03F8,A4),D0
02:00039B6A 41F900039ABE    	   849:     lea     (BlockPushDirections).l,A0
02:00039B70 12303000        	   850:     move.b  (A0,D3.W),D1
02:00039B74 B001            	   851:     cmp.b   D1,D0
02:00039B76 6702            	   852:     beq.s  __far_z_04_0008
02:00039B78 6048            	   853:     jmp  ResetPushTimer
                            	   854: __far_z_04_0008:
                            	   855:     ; Link is truly pushing the block.
                            	   856:     ;
                            	   857:     ; Increase the push timer.
                            	   858:     ;
02:00039B7A 41EC0412        	   859:     lea     ($0412,A4),A0
02:00039B7E 52302000        	   860:     addq.b  #1,(A0,D2.W)
                            	   861:     ; If the push timer still < $10, return.
