02:00031BF0 41EC034F        	  6884:     lea     ($034F,A4),A0
02:00031BF4 16302000        	  6885:     move.b  (A0,D2.W),D3
02:00031BF8 0C03002E        	  6886:     cmpi.b  #$2E,D3
02:00031BFC 6706            	  6887:     beq  _anon_z01_85
