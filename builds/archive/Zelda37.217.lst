02:0003BEDC 41EC0420        	  5824:     lea     ($0420,A4),A0
02:0003BEE0 11803000        	  5825:     move.b  D0,(A0,D3.W)
02:0003BEE4 7002            	  5826:     moveq   #2,D0
02:0003BEE6 41EC0445        	  5827:     lea     ($0445,A4),A0
02:0003BEEA 11803000        	  5828:     move.b  D0,(A0,D3.W)
02:0003BEEE 7041            	  5829:     moveq   #65,D0
02:0003BEF0 41EC0350        	  5830:     lea     ($0350,A4),A0
