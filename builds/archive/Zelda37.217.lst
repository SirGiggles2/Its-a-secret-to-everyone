02:00030C16 E208            	  4830:     lsr.b  #1,D0   ; LSR A
02:00030C18 E208            	  4831:     lsr.b  #1,D0   ; LSR A
02:00030C1A 6110            	  4832:     jsr     ChooseOffsetForDirectionH
02:00030C1C 122C0084        	  4833:     move.b  ($0084,A4),D1
02:00030C20 D101            	  4834:     addx.b  D1,D0   ; ADC ObjY
02:00030C22 41EC0084        	  4835:     lea     ($0084,A4),A0
