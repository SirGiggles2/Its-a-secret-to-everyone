02:0004291A 48C4            	  5015:     ext.l   D4
02:0004291C D8BC00FF0000    	  5016:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042922 2044            	  5017:     movea.l D4,A0
02:00042924 10303000        	  5018:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042928 41EC0302        	  5019:     lea     ($0302,A4),A0
02:0004292C 11802000        	  5020:     move.b  D0,(A0,D2.W)
                            	  5021:     ; Prepare for the next call:
                            	  5022:     ; - increment dynamic transfer buf pointer
                            	  5023:     ; - increment index of tile to copy [07]
                            	  5024:     ; - decrement count of tiles remaining
                            	  5025:     ;
02:00042930 5202            	  5026:     addq.b  #1,D2
02:00042932 522C0007        	  5027:     addq.b  #1,($0007,A4)
02:00042936 532C0004        	  5028:     subq.b  #1,($0004,A4)
