                            	 12929:     ;
02:0003F2DA 41EC046B        	 12930:     lea     ($046B,A4),A0
02:0003F2DE 10302000        	 12931:     move.b  (A0,D2.W),D0
02:0003F2E2 0C000006        	 12932:     cmpi.b  #$06,D0
02:0003F2E6 660A            	 12933:     bne  _L_z04_Ganon_MoveAndShoot_Move
