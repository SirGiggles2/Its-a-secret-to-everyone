                            	  6097: CalcBoomerangFrame:
                            	  6098:     ; The minor state (low 3 bits of state) is used to
                            	  6099:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  6100:     ;
                            	  6101:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  6102:     ; In other words, don't offset the coordinate below.
                            	  6103:     ;
02:0004CBC2 7000            	  6104:     moveq   #0,D0
02:0004CBC4 1880            	  6105:     move.b  D0,($0000,A4)
02:0004CBC6 41EC00AC        	  6106:     lea     ($00AC,A4),A0
02:0004CBCA 10302000        	  6107:     move.b  (A0,D2.W),D0
02:0004CBCE 0200000F        	  6108:     andi.b #$0F,D0
02:0004CBD2 7600            	  6109:     moveq   #0,D3
02:0004CBD4 1600            	  6110:     move.b  D0,D3
02:0004CBD6 7000            	  6111:     moveq   #0,D0
02:0004CBD8 19400001        	  6112:     move.b  D0,($0001,A4)
02:0004CBDC 41F90004C7CA    	  6113:     lea     (BoomerangFrameCycle).l,A0
02:0004CBE2 10303000        	  6114:     move.b  (A0,D3.W),D0
02:0004CBE6 1940000C        	  6115:     move.b  D0,($000C,A4)
                            	  6116:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  6117:     ;
02:0004CBEA 1003            	  6118:     move.b  D3,D0
02:0004CBEC 41F90004C7D4    	  6119:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004CBF2 10303000        	  6120:     move.b  (A0,D3.W),D0
02:0004CBF6 19400004        	  6121:     move.b  D0,($0004,A4)
                            	  6122:     ; TODO: ?
                            	  6123:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  6124:     ; Else add the item value of the magic boomerang.
                            	  6125:     ;
                            	  6126:     ; But none of the values in the base sprite attributes array is 8.
                            	  6127:     ;
                            	  6128:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  6129:     ; the inventory will always be added to the base sprite attribute.
                            	  6130:     ;
                            	  6131:     ; So, palette row 4 or 5 will be chosen.
                            	  6132:     ;
02:0004CBFA 7600            	  6133:     moveq   #0,D3
02:0004CBFC 0C000008        	  6134:     cmpi.b  #$08,D0
02:0004CC00 6706            	  6135:     beq  _anon_z07_31
