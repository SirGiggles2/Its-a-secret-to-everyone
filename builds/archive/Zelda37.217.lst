                            	  5218: 
                            	  5219: ; Each byte describes an item. The high nibble is the type.
                            	  5220: ; The low nibble is the value. Its meaning depends on the type.
                            	  5221: ;
                            	  5222: ; 0x - individuals
                            	  5223: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5224: ; * bit mask: value doesn't matter.
                            	  5225: ;
                            	  5226: ; 1x - amounts
                            	  5227: ; Value is an amount to add.
                            	  5228: ;
                            	  5229: ; 2x - grades
                            	  5230: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5231: ;
                            	  5232: ; 3x - error?
                            	  5233: ; Produces an item value of $FF.
                            	  5234: ;
                            	  5235:     even
