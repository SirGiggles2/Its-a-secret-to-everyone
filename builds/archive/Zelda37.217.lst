                            	  6817: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6818:     ; Link and the shot are facing opposite directions.
                            	  6819:     ; Link can parry certain weapons/shots.
                            	  6820:     ;
                            	  6821:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6822:     ; no harmful collision; but it still counts as a shot collision.
                            	  6823:     ; So, go treat this as a parry.
                            	  6824:     ;
02:00031B94 41EC034F        	  6825:     lea     ($034F,A4),A0
02:00031B98 10302000        	  6826:     move.b  (A0,D2.W),D0
02:00031B9C 0C000055        	  6827:     cmpi.b  #$55,D0
02:00031BA0 650E            	  6828:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031BA2 0C00005B        	  6829:     cmpi.b  #$5B,D0
02:00031BA6 6408            	  6830:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6831:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6832:     ; So, go harm Link.
                            	  6833:     ;
02:00031BA8 102C0676        	  6834:     move.b  ($0676,A4),D0
02:00031BAC 6602            	  6835:     bne.s  __far_z_01_0070
02:00031BAE 600E            	  6836:     jmp  HarmLink
                            	  6837: __far_z_01_0070:
                            	  6838:     even
