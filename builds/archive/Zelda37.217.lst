                            	   767: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   768:     ; Replace the low byte of the VRAM address with the one
                            	   769:     ; where the next character should be written.
                            	   770:     ;
02:0002E01C 102C045F        	   771:     move.b  ($045F,A4),D0
02:0002E020 19400303        	   772:     move.b  D0,($0303,A4)
                            	   773:     ; Increment the low VRAM address for the next character.
                            	   774:     ;
02:0002E024 522C045F        	   775:     addq.b  #1,($045F,A4)
                            	   776:     ; Use the person text selector to look up the address of the
                            	   777:     ; text for the textbox. Store the address in [00:01].
                            	   778:     ;
02:0002E028 7600            	   779:     moveq   #0,D3
02:0002E02A 162C0415        	   780:     move.b  ($0415,A4),D3
02:0002E02E 41F90002D64E    	   781:     lea     (PersonTextAddrs).l,A0
02:0002E034 10303000        	   782:     move.b  (A0,D3.W),D0
02:0002E038 1880            	   783:     move.b  D0,($0000,A4)
02:0002E03A 5203            	   784:     addq.b  #1,D3
02:0002E03C 41F90002D64E    	   785:     lea     (PersonTextAddrs).l,A0
02:0002E042 10303000        	   786:     move.b  (A0,D3.W),D0
02:0002E046 19400001        	   787:     move.b  D0,($0001,A4)
                            	   788:     ; Load the person text current character index.
                            	   789:     ;
02:0002E04A 7600            	   790:     moveq   #0,D3
02:0002E04C 162C0416        	   791:     move.b  ($0416,A4),D3
                            	   792:     ; Increment the index variable to point to the next character
                            	   793:     ; for next time.
                            	   794:     ;
02:0002E050 522C0416        	   795:     addq.b  #1,($0416,A4)
                            	   796:     ; Get the current character.
                            	   797:     ;
02:0002E054 1214            	   798:     move.b  ($00,A4),D1   ; ptr lo
02:0002E056 182C0001        	   799:     move.b  ($01,A4),D4  ; ptr hi
02:0002E05A 024100FF        	   800:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E05E E14C            	   801:     lsl.w   #8,D4
02:0002E060 8841            	   802:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E062 48C4            	   803:     ext.l   D4
02:0002E064 D8BC00FF0000    	   804:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E06A 2044            	   805:     movea.l D4,A0
02:0002E06C 10303000        	   806:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   807:     ; If the character is $25, then it's a special space. It will still
                            	   808:     ; take up space, but will not take time to show -- meaning that
                            	   809:     ; we'll go look up the next character to transfer.
                            	   810:     ;
02:0002E070 0200003F        	   811:     andi.b #$3F,D0
02:0002E074 0C000025        	   812:     cmpi.b  #$25,D0
02:0002E078 67A2            	   813:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   814:     ; We have a non-space character. Put it in the transfer record.
                            	   815:     ;
02:0002E07A 19400305        	   816:     move.b  D0,($0305,A4)
                            	   817:     ; Play the "heart taken/character" sound effect.
                            	   818:     ;
02:0002E07E 7010            	   819:     moveq   #16,D0
02:0002E080 19400604        	   820:     move.b  D0,($0604,A4)
                            	   821:     ; If the high 2 bits of character element = 0, then return.
                            	   822:     ;
02:0002E084 1214            	   823:     move.b  ($00,A4),D1   ; ptr lo
02:0002E086 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
02:0002E08A 024100FF        	   825:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E08E E14C            	   826:     lsl.w   #8,D4
02:0002E090 8841            	   827:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E092 48C4            	   828:     ext.l   D4
02:0002E094 D8BC00FF0000    	   829:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E09A 2044            	   830:     movea.l D4,A0
02:0002E09C 10303000        	   831:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E0A0 020000C0        	   832:     andi.b #$C0,D0
02:0002E0A4 672E            	   833:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   834:     ; Determine an index based on the high 2 bits of the character element:
                            	   835:     ;   $80: 0
                            	   836:     ;   $40: 1
                            	   837:     ;   $C0: 2
                            	   838:     ;
02:0002E0A6 7602            	   839:     moveq   #2,D3
02:0002E0A8 0C0000C0        	   840:     cmpi.b  #$C0,D0
02:0002E0AC 670A            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E0AE 5303            	   842:     subq.b  #1,D3
02:0002E0B0 0C000040        	   843:     cmpi.b  #$40,D0
02:0002E0B4 6702            	   844:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E0B6 5303            	   845:     subq.b  #1,D3
                            	   846:     even
                            	   847: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   848:     ; The index chooses the low VRAM address of the start
                            	   849:     ; of another line:
                            	   850:     ;   0: $C4: front of the second line
                            	   851:     ;   1: $E4: front of the third line
                            	   852:     ;   2: $A4: front of the first line
                            	   853:     ;
