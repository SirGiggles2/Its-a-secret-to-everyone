02:0003E3D2 0A3C0010        	 10819:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E3D6 9101            	 10820:     subx.b  D1,D0   ; SBC ObjX+2,X
02:0003E3D8 0A3C0010        	 10821:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E3DC 4EB900030A04    	 10822:     jsr     Abs
