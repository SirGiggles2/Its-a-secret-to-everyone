02:0003A3B0 B001            	  1982:     cmp.b   D1,D0
02:0003A3B2 670A            	  1983:     beq  _L_z04_UpdateStatues_Shoot
02:0003A3B4 5303            	  1984:     subq.b  #1,D3
02:0003A3B6 6AEE            	  1985:     bpl  _anon_z04_30
02:0003A3B8 0A3C0001        	  1986:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
