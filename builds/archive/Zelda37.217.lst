                            	  6081: _anon_z04_82:
                            	  6082:     ; Turn randomly while flying, as usual.
                            	  6083:     ;
02:0003C0B4 61003DE0        	  6084:     jsr     Flyer_Wander
                            	  6085:     ; After every turn, the common flyer routines set timer to $10.
                            	  6086:     ; This can be used as a signal for moldorm to propagate
                            	  6087:     ; direction changes down the chain.
                            	  6088:     ;
                            	  6089:     ; Between each turn, timer <> $10.
                            	  6090:     ;
                            	  6091:     ; At the end of the delay after the last turn, timer = 0.
                            	  6092:     ; This is a signal that that flying state ended, and a new one
                            	  6093:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6094:     ; we can propagate direction changes again; and start
                            	  6095:     ; a new flying interval by setting timer to $10. This will make
                            	  6096:     ; the next flying state delay that amount of time before turning
                            	  6097:     ; the first time.
                            	  6098:     ;
                            	  6099:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6100:     ; arm the timer again, and shift directions down the chain.
                            	  6101:     ;
02:0003C0B8 10342028        	  6102:     move.b  ($28,A4,D2.W),D0
02:0003C0BC 6602            	  6103:     bne.s  __far_z_04_0048
02:0003C0BE 60CE            	  6104:     jmp  Moldorm_ChangeFlyingState
                            	  6105: __far_z_04_0048:
                            	  6106:     even
