02:0004CD68 41F90004CC94    	  6324:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004CD6E 12303000        	  6325:     move.b  (A0,D3.W),D1
02:0004CD72 D101            	  6326:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:0004CD74 19802070        	  6327:     move.b  D0,($70,A4,D2.W)
02:0004CD78 1880            	  6328:     move.b  D0,($0000,A4)
                            	  6329:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6330:     ; Copy the result to [01].
