                            	  7279: __far_z_04_0065:
                            	  7280:     ; New bloated substate >= 2.
                            	  7281:     ;
                            	  7282:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7283:     ; which will transition to state 0 (moving).
                            	  7284:     ;
                            	  7285:     ; Note that if the bomb hits >= 2, then:
