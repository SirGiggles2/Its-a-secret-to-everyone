02:00031C12 1941000D        	  6899:     move.b  D1,($000D,A4)
02:00031C16 122C000E        	  6900:     move.b  ($000E,A4),D1
02:00031C1A E211            	  6901:     roxr.b  #1,D1   ; ROR $0E
02:00031C1C 1941000E        	  6902:     move.b  D1,($000E,A4)
