                            	  4887: UpdatePeaceTextbox:
                            	  4888:     ; Only emit a character once every 8 frames --
                            	  4889:     ; when (counter [0412] MOD 8) = 4.
                            	  4890:     ;
02:000363FC 522C0412        	  4891:     addq.b  #1,($0412,A4)
02:00036400 102C0412        	  4892:     move.b  ($0412,A4),D0
02:00036404 02000007        	  4893:     andi.b #$07,D0
02:00036408 0C000004        	  4894:     cmpi.b  #$04,D0
02:0003640C 665C            	  4895:     bne  _L_z02_UpdatePeaceTextbox_Exit
