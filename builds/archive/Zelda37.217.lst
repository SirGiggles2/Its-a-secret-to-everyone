                            	  7610: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D768 7400            	  7611:     moveq   #0,D2
02:0004D76A 142C0340        	  7612:     move.b  ($0340,A4),D2
                            	  7613:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7614:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7615:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7616:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7617:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7618:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7619:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7620:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7621:     ; corrupting them and causing a deterministic address-error
                            	  7622:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7623:     ; identified by Codex static review.)
                            	  7624: _L_z07_P47_pre_check:
02:0004D76E 102C0525        	  7625:     move.b  ($0525,A4),D0
02:0004D772 020000F0        	  7626:     andi.b  #$F0,D0
02:0004D776 0C000040        	  7627:     cmpi.b  #$40,D0
02:0004D77A 6506            	  7628:     blo     _L_z07_P47_pre_snap
02:0004D77C 0C0000E0        	  7629:     cmpi.b  #$E0,D0
02:0004D780 6506            	  7630:     blo     _L_z07_P47_pre_ok
                            	  7631: _L_z07_P47_pre_snap:
02:0004D782 197C00480525    	  7632:     move.b  #$48,($0525,A4)
                            	  7633: _L_z07_P47_pre_ok:
02:0004D788 7005            	  7634:     moveq   #5,D0
02:0004D78A 61000500        	  7635:     jsr     SwitchBank
02:0004D78E 4EB9000420EA    	  7636:     jsr     FindNextEdgeSpawnCell
                            	  7637:     ; Post-walk 1: bottom-edge snap.
02:0004D794 102C0525        	  7638:     move.b  ($0525,A4),D0
02:0004D798 020000F0        	  7639:     andi.b  #$F0,D0
02:0004D79C 0C0000E0        	  7640:     cmpi.b  #$E0,D0
02:0004D7A0 660C            	  7641:     bne     _L_z07_P47_post1_ok
02:0004D7A2 197C00480525    	  7642:     move.b  #$48,($0525,A4)
02:0004D7A8 4EB9000420EA    	  7643:     jsr     FindNextEdgeSpawnCell
                            	  7644: _L_z07_P47_post1_ok:
                            	  7645:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7646:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D7AE 7600            	  7647:     moveq   #0,D3
02:0004D7B0 162C0525        	  7648:     move.b  ($0525,A4),D3
02:0004D7B4 0243000F        	  7649:     andi.w  #$000F,D3
02:0004D7B8 C6FC002C        	  7650:     mulu.w  #44,D3
02:0004D7BC 203C00FF6530    	  7651:     move.l  #$FF6530,D0
02:0004D7C2 D083            	  7652:     add.l   D3,D0
02:0004D7C4 7600            	  7653:     moveq   #0,D3
02:0004D7C6 162C0525        	  7654:     move.b  ($0525,A4),D3
02:0004D7CA E84B            	  7655:     lsr.w   #4,D3
02:0004D7CC 5943            	  7656:     subi.w  #4,D3
02:0004D7CE E34B            	  7657:     lsl.w   #1,D3
02:0004D7D0 D083            	  7658:     add.l   D3,D0
02:0004D7D2 2040            	  7659:     movea.l D0,A0
02:0004D7D4 1010            	  7660:     move.b  (A0),D0
02:0004D7D6 0C000084        	  7661:     cmpi.b  #$84,D0
02:0004D7DA 6544            	  7662:     blo     _L_z07_P47_post2_ok
                            	  7663:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7664:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7665:     ; writes to the $05xx region.
02:0004D7DC 7800            	  7666:     moveq   #0,D4
                            	  7667: _L_z07_P47_fb_loop:
02:0004D7DE 41FAE456        	  7668:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D7E2 12304000        	  7669:     move.b  (A0,D4.W),D1
02:0004D7E6 19410525        	  7670:     move.b  D1,($0525,A4)
                            	  7671:     ; Validate fallback cell walkable.
02:0004D7EA 7600            	  7672:     moveq   #0,D3
02:0004D7EC 1601            	  7673:     move.b  D1,D3
02:0004D7EE 0243000F        	  7674:     andi.w  #$000F,D3
02:0004D7F2 C6FC002C        	  7675:     mulu.w  #44,D3
02:0004D7F6 203C00FF6530    	  7676:     move.l  #$FF6530,D0
02:0004D7FC D083            	  7677:     add.l   D3,D0
02:0004D7FE 7600            	  7678:     moveq   #0,D3
02:0004D800 1601            	  7679:     move.b  D1,D3
02:0004D802 E84B            	  7680:     lsr.w   #4,D3
02:0004D804 5943            	  7681:     subi.w  #4,D3
02:0004D806 E34B            	  7682:     lsl.w   #1,D3
02:0004D808 D083            	  7683:     add.l   D3,D0
02:0004D80A 2040            	  7684:     movea.l D0,A0
02:0004D80C 0C100084        	  7685:     cmpi.b  #$84,(A0)
02:0004D810 650E            	  7686:     blo     _L_z07_P47_post2_ok
02:0004D812 5204            	  7687:     addq.b  #1,D4
02:0004D814 0C040008        	  7688:     cmpi.b  #8,D4
02:0004D818 65C4            	  7689:     blo     _L_z07_P47_fb_loop
                            	  7690:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7691:     ; rather than looping).
02:0004D81A 197C00480525    	  7692:     move.b  #$48,($0525,A4)
                            	  7693: _L_z07_P47_post2_ok:
                            	  7694:     ; Extract and set the monster's location.
                            	  7695:     ;
02:0004D820 102C0525        	  7696:     move.b  ($0525,A4),D0
                            	  7697:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7698:     ;
02:0004D824 1B00            	  7699:     move.b  D0,-(A5)  ; PHA
02:0004D826 E308            	  7700:     lsl.b  #1,D0   ; ASL A
