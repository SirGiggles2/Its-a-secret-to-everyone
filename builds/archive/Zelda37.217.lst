                            	  6376: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6377:     ; The weapon is the sword.
                            	  6378:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6379:     ;
02:0004CDE2 023C00EE        	  6380:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CDE6 122C0657        	  6381:     move.b  ($0657,A4),D1
02:0004CDEA D101            	  6382:     addx.b  D1,D0   ; ADC Items
02:0004CDEC 003C0011        	  6383:     ori     #$11,CCR  ; SEC: set C+X
02:0004CDF0 123C0001        	  6384:     move.b  #$01,D1
02:0004CDF4 0A3C0010        	  6385:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CDF8 9101            	  6386:     subx.b  D1,D0   ; SBC #$01
02:0004CDFA 0A3C0010        	  6387:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6388:     even
                            	  6389: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6390:     ; Set sprite attributes to the calculated value above.
