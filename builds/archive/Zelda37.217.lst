02:0003CE2A 10302000        	  7997:     move.b  (A0,D2.W),D0
02:0003CE2E 023C00EE        	  7998:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE32 41F90003CDC2    	  7999:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE38 12303000        	  8000:     move.b  (A0,D3.W),D1
