                            	  4716: WieldBomb:
                            	  4717:     ; If there are no bombs in inventory, return.
                            	  4718:     ;
02:00030B76 102C0658        	  4719:     move.b  ($0658,A4),D0
02:00030B7A 67F4            	  4720:     beq  _anon_z01_52
                            	  4721:     ; Look in slot $10. If it's empty or there's a fire
                            	  4722:     ; (state = 0, or major state <> $10), then
                            	  4723:     ; go activate a bomb.
                            	  4724:     ;
02:00030B7C 7410            	  4725:     moveq   #16,D2
02:00030B7E 41EC00AC        	  4726:     lea     ($00AC,A4),A0
02:00030B82 10302000        	  4727:     move.b  (A0,D2.W),D0
