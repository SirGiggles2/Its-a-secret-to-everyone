                            	  8295: 
                            	  8296: _anon_z05_167:
                            	  8297:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  8298:     ; of the big map sheet.
                            	  8299:     ;
02:00044F7E 0C000015        	  8300:     cmpi.b  #$15,D0
02:00044F82 6604            	  8301:     bne  _anon_z05_168
02:00044F84 7042            	  8302:     moveq   #66,D0
02:00044F86 60F4            	  8303:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8304: 
