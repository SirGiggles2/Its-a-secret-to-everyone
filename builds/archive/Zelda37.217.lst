02:0003AE26 1940004D        	  3499:     move.b  D0,($004D,A4)
02:0003AE2A 6100008C        	  3500:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3501:     ; The leever has to face Link in order to move toward him.
