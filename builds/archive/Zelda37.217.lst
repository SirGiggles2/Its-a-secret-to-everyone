                            	  8599: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8600:     ; If the teleporting distance remaining is even, then draw
                            	  8601:     ; and check collisions, else return.
                            	  8602:     ;
                            	  8603:     ; This means that when 0, the monster is walking.
                            	  8604:     ; So, draw and check collisions every frame.
                            	  8605:     ;
                            	  8606:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8607:     ; translucently -- every other frame.
                            	  8608:     ;
02:0003D318 41EC0394        	  8609:     lea     ($0394,A4),A0
02:0003D31C 10302000        	  8610:     move.b  (A0,D2.W),D0
02:0003D320 E208            	  8611:     lsr.b  #1,D0   ; LSR A
02:0003D322 6402            	  8612:     bcc.s  __far_z_04_0076
02:0003D324 603A            	  8613:     jmp  L11E17_Exit
                            	  8614: __far_z_04_0076:
                            	  8615:     even
