                            	  3201: _anon_z05_76:
                            	  3202:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3203:     ;
02:00041C00 7000            	  3204:     moveq   #0,D0
                            	  3205: ; Params:
                            	  3206: ; A: mask of buttons to block
                            	  3207: ; Y: offset into BorderBounds
                            	  3208: ; [00]: direction
                            	  3209: ; [02]: coordinate
                            	  3210: ;
                            	  3211: ; Returns:
                            	  3212: ; [01]: button mask that was used
                            	  3213: ;       (set to $FF if boundary not crossed)
                            	  3214: ;
                            	  3215:     even
                            	  3216: MaskInputInBorder:
