02:0003A9FA 6062            	  2942:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2943: __far_z_04_0025:
                            	  2944:     ; Distance < 3. Go to state 0.
                            	  2945:     ;
                            	  2946:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2947:     ;
02:0003A9FC 4EB90004CECE    	  2948:     jsr     ResetObjState
02:0003AA02 7600            	  2949:     moveq   #0,D3
02:0003AA04 41EC034F        	  2950:     lea     ($034F,A4),A0
02:0003AA08 16302000        	  2951:     move.b  (A0,D2.W),D3
02:0003AA0C 0C030020        	  2952:     cmpi.b  #$20,D3
02:0003AA10 6748            	  2953:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2954:     ; Else calculate a timer value.
                            	  2955:     ;
                            	  2956:     ; t := (Random + $10)
                            	  2957:     ; if t < $20 then
                            	  2958:     ;   t := t - $40
                            	  2959:     ;
02:0003AA12 7010            	  2960:     moveq   #16,D0
02:0003AA14 023C00EE        	  2961:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA18 12342019        	  2962:     move.b  ($19,A4,D2.W),D1
02:0003AA1C D101            	  2963:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AA1E 0C000020        	  2964:     cmpi.b  #$20,D0
02:0003AA22 6412            	  2965:     bcc  _anon_z04_39
02:0003AA24 003C0011        	  2966:     ori     #$11,CCR  ; SEC: set C+X
02:0003AA28 123C0040        	  2967:     move.b  #$40,D1
02:0003AA2C 0A3C0010        	  2968:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA30 9101            	  2969:     subx.b  D1,D0   ; SBC #$40
