02:0004CCCA 6644            	  6240:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  6241:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  6242:     ;
02:0004CCCC 41EC00AC        	  6243:     lea     ($00AC,A4),A0
02:0004CCD0 10302000        	  6244:     move.b  (A0,D2.W),D0
02:0004CCD4 0200000F        	  6245:     andi.b #$0F,D0
02:0004CCD8 7600            	  6246:     moveq   #0,D3
02:0004CCDA 1600            	  6247:     move.b  D0,D3
02:0004CCDC 7008            	  6248:     moveq   #8,D0
02:0004CCDE 5303            	  6249:     subq.b  #1,D3
