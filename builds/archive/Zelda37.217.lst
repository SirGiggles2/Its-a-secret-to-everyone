                            	 12771: 
                            	 12772: ; Description:
                            	 12773: ; Lift up the Triforce of Courage while the room is dark.
                            	 12774: ;
                            	 12775: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12776: ;
                            	 12777:     even
