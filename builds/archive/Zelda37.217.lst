                            	  7814: BeginShove:
02:00032184 7600            	  7815:     moveq   #0,D3
02:00032186 1614            	  7816:     move.b  ($0000,A4),D3
02:00032188 0C02000D        	  7817:     cmpi.b  #$0D,D2
02:0003218C 6412            	  7818:     bcc  _anon_z01_99
02:0003218E 41EC04B2        	  7819:     lea     ($04B2,A4),A0
02:00032192 10302000        	  7820:     move.b  (A0,D2.W),D0
02:00032196 122C0009        	  7821:     move.b  ($0009,A4),D1
02:0003219A C001            	  7822:     and.b  D1,D0
02:0003219C 660000C4        	  7823:     bne  _L_z01_BeginShove_Exit
                            	  7824: _anon_z01_99:
                            	  7825:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7826:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7827:     ;
                            	  7828:     ; If instead a monster is defending, then all this calculation
                            	  7829:     ; won't matter, because the shove direction will be set to the
                            	  7830:     ; weapon's direction.
                            	  7831:     ;
                            	  7832:     ; As such, calculate a direction from the monster to the defender,
                            	  7833:     ; assuming it's Link.
                            	  7834:     ;
                            	  7835:     ; Start with an assumption that the direction is vertical:
                            	  7836:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7837:     ;
02:000321A0 7008            	  7838:     moveq   #8,D0
02:000321A2 19400008        	  7839:     move.b  D0,($0008,A4)
02:000321A6 41EC0084        	  7840:     lea     ($0084,A4),A0
02:000321AA 10302000        	  7841:     move.b  (A0,D2.W),D0
02:000321AE 19400004        	  7842:     move.b  D0,($0004,A4)
02:000321B2 41EC0084        	  7843:     lea     ($0084,A4),A0
02:000321B6 10303000        	  7844:     move.b  (A0,D3.W),D0
02:000321BA 19400005        	  7845:     move.b  D0,($0005,A4)
                            	  7846:     ; If the defender is Link and his grid offset <> 0 then
                            	  7847:     ; use his usual object direction variable to determine
                            	  7848:     ; which axis to check.
                            	  7849:     ;
02:000321BE 4A03            	  7850:     cmpi.b  #$00,D3
02:000321C0 6612            	  7851:     bne  _anon_z01_100
02:000321C2 102C0394        	  7852:     move.b  ($0394,A4),D0
02:000321C6 670C            	  7853:     beq  _anon_z01_100
02:000321C8 102C0098        	  7854:     move.b  ($0098,A4),D0
02:000321CC 02000003        	  7855:     andi.b #$03,D0
02:000321D0 660C            	  7856:     bne  _L_z01_BeginShove_CheckHorizontal
02:000321D2 6720            	  7857:     beq  _L_z01_BeginShove_CheckVertical
                            	  7858: _anon_z01_100:
                            	  7859:     ; For monsters defending, or Link with grid offset = 0,
                            	  7860:     ; check direction in [0B].
                            	  7861:     ;
                            	  7862:     ; For monsters defending, this won't matter. For Link with grid
                            	  7863:     ; offset = 0, I believe the result will be arbitrary.
                            	  7864:     ;
                            	  7865:     ; TODO:
                            	  7866:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7867:     ; It doesn't seem to be if candle fire attacks him.
                            	  7868:     ;
02:000321D4 102C000B        	  7869:     move.b  ($000B,A4),D0
02:000321D8 0C000004        	  7870:     cmpi.b  #$04,D0
02:000321DC 6416            	  7871:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7872:     even
                            	  7873: _L_z01_BeginShove_CheckHorizontal:
                            	  7874:     ; If the direction checked is left or right,
                            	  7875:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7876:     ;
02:000321DE 7002            	  7877:     moveq   #2,D0
02:000321E0 19400008        	  7878:     move.b  D0,($0008,A4)
02:000321E4 10342070        	  7879:     move.b  ($70,A4,D2.W),D0
02:000321E8 19400004        	  7880:     move.b  D0,($0004,A4)
02:000321EC 10343070        	  7881:     move.b  ($70,A4,D3.W),D0
02:000321F0 19400005        	  7882:     move.b  D0,($0005,A4)
                            	  7883:     even
                            	  7884: _L_z01_BeginShove_CheckVertical:
                            	  7885:     ; If the monster is down or right of the other object,
                            	  7886:     ; then use the opposite direction already in [08].
                            	  7887:     ; Else shift [08] right to turn it into the opposite
                            	  7888:     ; direction up or down.
                            	  7889:     ;
                            	  7890:     ; Again assuming Link is the defender; after this, [08] points
                            	  7891:     ; Link away from the monster.
                            	  7892:     ;
02:000321F4 102C0004        	  7893:     move.b  ($0004,A4),D0
02:000321F8 122C0005        	  7894:     move.b  ($0005,A4),D1
02:000321FC B001            	  7895:     cmp.b   D1,D0
02:000321FE 640A            	  7896:     bcc  _anon_z01_101
02:00032200 122C0008        	  7897:     move.b  ($0008,A4),D1
02:00032204 E209            	  7898:     lsr.b  #1,D1   ; LSR $08
02:00032206 19410008        	  7899:     move.b  D1,($0008,A4)
                            	  7900: _anon_z01_101:
                            	  7901:     ; If a monster is the defender, go handle it separately.
                            	  7902:     ;
02:0003220A 4A03            	  7903:     cmpi.b  #$00,D3
02:0003220C 6656            	  7904:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7905:     ; Link is the defender.
