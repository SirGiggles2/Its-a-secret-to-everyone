02:0003F55E 9101            	 13262:     subx.b  D1,D0   ; SBC Ganon_ObjCloudDist,X
02:0003F560 0A3C0010        	 13263:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F564 1880            	 13264:     move.b  D0,($0000,A4)
02:0003F566 0A3C0001        	 13265:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
