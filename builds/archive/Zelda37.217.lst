                            	 12110: Lamnola_UpdateHead:
                            	 12111:     ; If X coordinate is not a multiple of 8, then return.
                            	 12112:     ;
02:0003ED60 10342070        	 12113:     move.b  ($70,A4,D2.W),D0
02:0003ED64 02000007        	 12114:     andi.b #$07,D0
02:0003ED68 6702            	 12115:     beq.s  __far_z_04_0123
02:0003ED6A 60F2            	 12116:     jmp  L12A6F_Exit
                            	 12117: __far_z_04_0123:
                            	 12118:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12119:     ; We had to account for the usual offset of 3.
                            	 12120:     ;
02:0003ED6C 41EC0084        	 12121:     lea     ($0084,A4),A0
02:0003ED70 10302000        	 12122:     move.b  (A0,D2.W),D0
02:0003ED74 023C00EE        	 12123:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED78 123C0003        	 12124:     move.b  #$03,D1
02:0003ED7C D101            	 12125:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED7E 02000007        	 12126:     andi.b #$07,D0
02:0003ED82 6702            	 12127:     beq.s  __far_z_04_0124
02:0003ED84 60D8            	 12128:     jmp  L12A6F_Exit
                            	 12129: __far_z_04_0124:
                            	 12130:     ; Will loop 4 times, propagating directions down the chain,
                            	 12131:     ; by pulling from the bottom.
                            	 12132:     ;
02:0003ED86 7004            	 12133:     moveq   #4,D0
02:0003ED88 1880            	 12134:     move.b  D0,($0000,A4)
                            	 12135:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12136:     ;
02:0003ED8A 7600            	 12137:     moveq   #0,D3
02:0003ED8C 0C020005        	 12138:     cmpi.b  #$05,D2
02:0003ED90 6702            	 12139:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED92 7605            	 12140:     moveq   #5,D3
                            	 12141:     even
                            	 12142: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12143:     ; Loop over every segment under the head, starting from the tail.
                            	 12144:     ; Copy the next segment's direction to the current one in this loop.
                            	 12145:     ;
02:0003ED94 41EC009A        	 12146:     lea     ($009A,A4),A0
02:0003ED98 10303000        	 12147:     move.b  (A0,D3.W),D0
02:0003ED9C 41EC0099        	 12148:     lea     ($0099,A4),A0
02:0003EDA0 11803000        	 12149:     move.b  D0,(A0,D3.W)
02:0003EDA4 5203            	 12150:     addq.b  #1,D3
02:0003EDA6 5314            	 12151:     subq.b  #1,($0000,A4)
02:0003EDA8 66EA            	 12152:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12153:     ; If this head segment is not aligned with a square, then return.
                            	 12154:     ;
02:0003EDAA 10342070        	 12155:     move.b  ($70,A4,D2.W),D0
02:0003EDAE 0200000F        	 12156:     andi.b #$0F,D0
02:0003EDB2 660000BA        	 12157:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12158:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12159:     ; We had to account for the usual offset of 3.
                            	 12160:     ;
02:0003EDB6 41EC0084        	 12161:     lea     ($0084,A4),A0
02:0003EDBA 10302000        	 12162:     move.b  (A0,D2.W),D0
02:0003EDBE 023C00EE        	 12163:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDC2 123C0003        	 12164:     move.b  #$03,D1
02:0003EDC6 D101            	 12165:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDC8 0200000F        	 12166:     andi.b #$0F,D0
02:0003EDCC 660000A0        	 12167:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12168:     ; Store the opposite of the facing direction in [00].
                            	 12169:     ;
02:0003EDD0 41EC0098        	 12170:     lea     ($0098,A4),A0
02:0003EDD4 10302000        	 12171:     move.b  (A0,D2.W),D0
02:0003EDD8 E208            	 12172:     lsr.b  #1,D0   ; LSR A
02:0003EDDA 02000005        	 12173:     andi.b #$05,D0
02:0003EDDE 1880            	 12174:     move.b  D0,($0000,A4)
02:0003EDE0 41EC0098        	 12175:     lea     ($0098,A4),A0
02:0003EDE4 10302000        	 12176:     move.b  (A0,D2.W),D0
02:0003EDE8 E308            	 12177:     lsl.b  #1,D0   ; ASL A
02:0003EDEA 0200000A        	 12178:     andi.b #$0A,D0
02:0003EDEE 1214            	 12179:     move.b  ($0000,A4),D1
02:0003EDF0 8001            	 12180:     or.b  D1,D0
                            	 12181:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12182:     ;
02:0003EDF2 0A00000F        	 12183:     eori.b #$0F,D0
02:0003EDF6 1940050F        	 12184:     move.b  D0,($050F,A4)
                            	 12185:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12186:     ;
02:0003EDFA 10342018        	 12187:     move.b  ($18,A4,D2.W),D0
02:0003EDFE 0C000080        	 12188:     cmpi.b  #$80,D0
02:0003EE02 656C            	 12189:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12190:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12191:     ; Load the monster's facing direction.
                            	 12192:     ;
02:0003EE04 41EC0098        	 12193:     lea     ($0098,A4),A0
02:0003EE08 10302000        	 12194:     move.b  (A0,D2.W),D0
                            	 12195:     ; Load the next random number into Y register.
                            	 12196:     ;
02:0003EE0C 7600            	 12197:     moveq   #0,D3
02:0003EE0E 16342019        	 12198:     move.b  ($19,A4,D2.W),D3
                            	 12199:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12200:     ; to keep moving straight.
                            	 12201:     ;
02:0003EE12 0C030080        	 12202:     cmpi.b  #$80,D3
02:0003EE16 6418            	 12203:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12204:     even
                            	 12205: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12206:     ; Loop to rotate the direction bit over the mask.
                            	 12207:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12208:     ; facing direction.
                            	 12209:     ;
                            	 12210:     ; Shift right the copy of the direction.
                            	 12211:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12212:     ;
02:0003EE18 E208            	 12213:     lsr.b  #1,D0   ; LSR A
02:0003EE1A 6402            	 12214:     bcc  _anon_z04_151
02:0003EE1C 7008            	 12215:     moveq   #8,D0
                            	 12216: _anon_z04_151:
                            	 12217:     ; If the current direction bit is masked off, then we've reached
                            	 12218:     ; the opposite direction. Loop again.
                            	 12219:     ;
02:0003EE1E 122C050F        	 12220:     move.b  ($050F,A4),D1
02:0003EE22 C200            	 12221:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE24 67F2            	 12222:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12223:     ; If Y register >= $40, then break out of the loop.
                            	 12224:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12225:     ;
02:0003EE26 0C030040        	 12226:     cmpi.b  #$40,D3
02:0003EE2A 6404            	 12227:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12228:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12229:     ; and loop again now.
                            	 12230:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12231:     ;
02:0003EE2C 7640            	 12232:     moveq   #64,D3
02:0003EE2E 65E8            	 12233:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12234:     even
                            	 12235: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12236:     ; Change the facing direction to the direction found.
                            	 12237:     ;
02:0003EE30 41EC0098        	 12238:     lea     ($0098,A4),A0
02:0003EE34 11802000        	 12239:     move.b  D0,(A0,D2.W)
                            	 12240:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12241:     ;
02:0003EE38 1940000F        	 12242:     move.b  D0,($000F,A4)
02:0003EE3C 4EB900030906    	 12243:     jsr     BoundByRoom
                            	 12244:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12245:     ;
02:0003EE42 102C000F        	 12246:     move.b  ($000F,A4),D0
02:0003EE46 6618            	 12247:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12248:     even
                            	 12249: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12250:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12251:     ; for looking for any non-opposite direction that is not blocked.
                            	 12252:     ;
02:0003EE48 41EC0098        	 12253:     lea     ($0098,A4),A0
02:0003EE4C 10302000        	 12254:     move.b  (A0,D2.W),D0
                            	 12255:     even
                            	 12256: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12257:     ; Shift right the copy of the direction.
                            	 12258:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12259:     ;
02:0003EE50 E208            	 12260:     lsr.b  #1,D0   ; LSR A
02:0003EE52 6402            	 12261:     bcc  _anon_z04_152
02:0003EE54 7008            	 12262:     moveq   #8,D0
                            	 12263: _anon_z04_152:
                            	 12264:     ; If the current direction bit is not masked off, then go check the
                            	 12265:     ; room boundary in this direction.
                            	 12266:     ; Else we've reached the opposite direction. Loop again.
                            	 12267:     ;
02:0003EE56 122C050F        	 12268:     move.b  ($050F,A4),D1
02:0003EE5A C200            	 12269:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE5C 66D2            	 12270:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE5E 67F0            	 12271:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12272:     even
                            	 12273: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12274:     ; We found a direction that was not blocked by the room boundary.
                            	 12275:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12276:     ;
02:0003EE60 4EB90004BA76    	 12277:     jsr     GetCollidingTileMoving
02:0003EE66 122C034A        	 12278:     move.b  ($034A,A4),D1
02:0003EE6A B001            	 12279:     cmp.b   D1,D0
02:0003EE6C 64DA            	 12280:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12281:     even
                            	 12282: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12283:     ; TODO: confirm this
                            	 12284:     ;
                            	 12285:     ; If there were a room that had lamnolas, and they could get
                            	 12286:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12287:     ; an infinite loop.
                            	 12288:     ;
                            	 12289:     ; But, the only room with that configuration has those blocks
                            	 12290:     ; blocked off with a push block, which can only be pushed after
                            	 12291:     ; all monsters are killed.
                            	 12292:     ;
02:0003EE6E 4E75            	 12293:     rts
                            	 12294: 
                            	 12295:     even
