02:0003CEC0 41EC0084        	  8074:     lea     ($0084,A4),A0
02:0003CEC4 10302000        	  8075:     move.b  (A0,D2.W),D0
02:0003CEC8 0C000078        	  8076:     cmpi.b  #$78,D0
02:0003CECC 6402            	  8077:     bcc  _anon_z04_97
02:0003CECE 7603            	  8078:     moveq   #3,D3
                            	  8079: _anon_z04_97:
