02:0003DD38 122C0002        	  9986:     move.b  ($0002,A4),D1
02:0003DD3C E309            	  9987:     lsl.b  #1,D1   ; ASL $02
02:0003DD3E 19410002        	  9988:     move.b  D1,($0002,A4)
02:0003DD42 122C0002        	  9989:     move.b  ($0002,A4),D1
02:0003DD46 C200            	  9990:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD48 6716            	  9991:     beq  _L_z04_Manhandla_Move_Up
02:0003DD4A 41EC0084        	  9992:     lea     ($0084,A4),A0
02:0003DD4E 10302000        	  9993:     move.b  (A0,D2.W),D0
02:0003DD52 122C0003        	  9994:     move.b  ($0003,A4),D1
02:0003DD56 D101            	  9995:     addx.b  D1,D0   ; ADC $03
02:0003DD58 41EC0084        	  9996:     lea     ($0084,A4),A0
