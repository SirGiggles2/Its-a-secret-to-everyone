                            	  4447: CheckTiles:
                            	  4448:     ifne TURBO_LINK
                            	  4449:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4450:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004C094 4A02            	  4451:     tst.b   D2
02:0004C096 6608            	  4452:     bne.s   _L_z07_CheckTiles_notLink
02:0004C098 197C0024049E    	  4453:     move.b  #$24,($049E,A4)
02:0004C09E 605E            	  4454:     jmp     GoWalkableDir
                            	  4455: _L_z07_CheckTiles_notLink:
                            	  4456:     endc
                            	  4457:     ; The code below applies to Link and other objects.
                            	  4458:     ;
                            	  4459:     ; Test the moving direction's walkability.
                            	  4460:     ;
                            	  4461:     ; For the player, this is enough. For other objects, this 
                            	  4462:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4463:     ;
                            	  4464:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4465:     ;
02:0004C0A0 6100F9D4        	  4466:     jsr     GetCollidingTileMoving
02:0004C0A4 122C034A        	  4467:     move.b  ($034A,A4),D1
02:0004C0A8 B001            	  4468:     cmp.b   D1,D0
02:0004C0AA 6402            	  4469:     bcc.s  __far_z_07_0056
02:0004C0AC 6050            	  4470:     jmp  GoWalkableDir
                            	  4471: __far_z_07_0056:
                            	  4472:     ; The colliding tile is unwalkable.
                            	  4473:     ;
                            	  4474:     ; If object is the player, then go check passive tile objects and
                            	  4475:     ; the screen edge, or stop moving.
                            	  4476:     ;
02:0004C0AE 4A02            	  4477:     cmpi.b  #$00,D2
02:0004C0B0 6602            	  4478:     bne.s  __far_z_07_0057
02:0004C0B2 6022            	  4479:     jmp  PlayerUnwalkable
                            	  4480: __far_z_07_0057:
                            	  4481:     even
                            	  4482: CheckObjAttr10AndAltDir:
                            	  4483:     ; Not the player.
                            	  4484:     ; If object attribute has $10, go to the unused code above
                            	  4485:     ; to reverse direction.
                            	  4486:     ;
02:0004C0B4 41EC04BF        	  4487:     lea     ($04BF,A4),A0
02:0004C0B8 10302000        	  4488:     move.b  (A0,D2.W),D0
02:0004C0BC 02000010        	  4489:     andi.b #$10,D0
02:0004C0C0 6702            	  4490:     beq.s  __far_z_07_0058
02:0004C0C2 60C8            	  4491:     jmp  Reverse
                            	  4492: __far_z_07_0058:
                            	  4493:     even
                            	  4494: TryNextDir:
                            	  4495:     ; Get the next direction to check, and set moving direction to it.
                            	  4496:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4497:     ;
02:0004C0C4 610000E6        	  4498:     jsr     Walker_GetNextAltDir
02:0004C0C8 1940000F        	  4499:     move.b  D0,($000F,A4)
02:0004C0CC 102C000E        	  4500:     move.b  ($000E,A4),D0
02:0004C0D0 6702            	  4501:     beq.s  __far_z_07_0059
02:0004C0D2 60C0            	  4502:     jmp  CheckTiles
                            	  4503: __far_z_07_0059:
02:0004C0D4 4E75            	  4504:     rts
                            	  4505: 
                            	  4506:     even
                            	  4507: PlayerUnwalkable:
                            	  4508:     ; Tile is not walkable. Object is player.
                            	  4509:     ;
                            	  4510:     ; Check passive tile objects and the screen edge, and stop moving.
                            	  4511:     ;
                            	  4512:     ; First, if in OW, check passive tile objects (armos and regular gravestone).
