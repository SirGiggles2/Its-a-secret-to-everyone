02:0003D0F6 7600            	  8335:     moveq   #0,D3
02:0003D0F8 41EC03E4        	  8336:     lea     ($03E4,A4),A0
02:0003D0FC 16302000        	  8337:     move.b  (A0,D2.W),D3
02:0003D100 5203            	  8338:     addq.b  #1,D3
02:0003D102 1003            	  8339:     move.b  D3,D0
