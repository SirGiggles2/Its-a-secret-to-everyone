02:000447C8 003C0011        	  7612:     ori     #$11,CCR  ; SEC: set C+X
02:000447CC 123C0040        	  7613:     move.b  #$40,D1
02:000447D0 0A3C0010        	  7614:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000447D4 9101            	  7615:     subx.b  D1,D0   ; SBC #$40
02:000447D6 0A3C0010        	  7616:     eori    #$10,CCR  ; restore X = 6502 C
02:000447DA E208            	  7617:     lsr.b  #1,D0   ; LSR A
02:000447DC E208            	  7618:     lsr.b  #1,D0   ; LSR A
02:000447DE E208            	  7619:     lsr.b  #1,D0   ; LSR A
                            	  7620:     ; Add this row offset to the column address.
