02:00034D3C 41EC0201        	  2705:     lea     ($0201,A4),A0
02:00034D40 11803000        	  2706:     move.b  D0,(A0,D3.W)
02:00034D44 5303            	  2707:     subq.b  #1,D3
02:00034D46 6AEA            	  2708:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00034D48 7600            	  2709:     moveq   #0,D3
02:00034D4A 162C0016        	  2710:     move.b  ($0016,A4),D3
02:00034D4E 41F9000345B0    	  2711:     lea     (ModeEandFSlotCursorYs).l,A0
02:00034D54 10303000        	  2712:     move.b  (A0,D3.W),D0
02:00034D58 19400084        	  2713:     move.b  D0,($0084,A4)
02:00034D5C 19400200        	  2714:     move.b  D0,($0200,A4)
02:00034D60 102C0012        	  2715:     move.b  ($0012,A4),D0
02:00034D64 0C00000F        	  2716:     cmpi.b  #$0F,D0
                            	  2717:     ; There's more work in mode $E.
                            	  2718:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2719:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00034D68 6736            	  2720:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00034D6A 103C00F3        	  2721:     move.b  #$F3,D0
02:00034D6E 19400201        	  2722:     move.b  D0,($0201,A4)
                            	  2723:     ; Because the visible part of the cursor block sprite is
                            	  2724:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2725:     ; above its ObjY.
02:00034D72 102C0084        	  2726:     move.b  ($0084,A4),D0
02:00034D76 003C0011        	  2727:     ori     #$11,CCR  ; SEC: set C+X
02:00034D7A 123C0008        	  2728:     move.b  #$08,D1
02:00034D7E 0A3C0010        	  2729:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034D82 9101            	  2730:     subx.b  D1,D0   ; SBC #$08
02:00034D84 0A3C0010        	  2731:     eori    #$10,CCR  ; restore X = 6502 C
02:00034D88 19400204        	  2732:     move.b  D0,($0204,A4)
02:00034D8C 7070            	  2733:     moveq   #112,D0
02:00034D8E 19400070        	  2734:     move.b  D0,($0070,A4)
02:00034D92 103C0087        	  2735:     move.b  #$87,D0
02:00034D96 19400085        	  2736:     move.b  D0,($0085,A4)
02:00034D9A 7030            	  2737:     moveq   #48,D0
02:00034D9C 19400071        	  2738:     move.b  D0,($0071,A4)
