                            	   771: ;==============================================================================
                            	   772: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   773: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   774: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   775: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   776: ;==============================================================================
                            	   777:     ifne TURBO_LINK
                            	   778: _turbo_link_boost:
                            	   779:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   780:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   781:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   782:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:0004DCCA 4E75            	   783:     rts
                            	   784: _turbo_link_boost_disabled:
                            	   785:     ; OW gate
02:0004DCCC 4A2C0010        	   786:     tst.b   ($0010,A4)
02:0004DCD0 6670            	   787:     bne     .tlb_exit
                            	   788:     ; Mode 5 / Submode 0 only
02:0004DCD2 0C2C00050012    	   789:     cmpi.b  #$05,($0012,A4)
02:0004DCD8 6668            	   790:     bne     .tlb_exit
02:0004DCDA 4A2C0013        	   791:     tst.b   ($0013,A4)
02:0004DCDE 6662            	   792:     bne     .tlb_exit
                            	   793:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:0004DCE0 122C00FA        	   794:     move.b  ($00FA,A4),D1
02:0004DCE4 0201000F        	   795:     andi.b  #$0F,D1
02:0004DCE8 6758            	   796:     beq     .tlb_exit
                            	   797:     ; Edge-safe clamps.
02:0004DCEA 08010003        	   798:     btst    #3,D1                   ; Up (bit 3)
02:0004DCEE 6710            	   799:     beq.s   .tlb_no_up
02:0004DCF0 102C0084        	   800:     move.b  ($0084,A4),D0
02:0004DCF4 0C000040        	   801:     cmpi.b  #$40,D0
02:0004DCF8 6306            	   802:     bls.s   .tlb_no_up
02:0004DCFA 5900            	   803:     subi.b  #4,D0
02:0004DCFC 19400084        	   804:     move.b  D0,($0084,A4)
                            	   805: .tlb_no_up:
02:0004DD00 08010002        	   806:     btst    #2,D1                   ; Down (bit 2)
02:0004DD04 6710            	   807:     beq.s   .tlb_no_down
02:0004DD06 102C0084        	   808:     move.b  ($0084,A4),D0
02:0004DD0A 0C0000D0        	   809:     cmpi.b  #$D0,D0
02:0004DD0E 6406            	   810:     bcc.s   .tlb_no_down
02:0004DD10 5800            	   811:     addi.b  #4,D0
02:0004DD12 19400084        	   812:     move.b  D0,($0084,A4)
                            	   813: .tlb_no_down:
02:0004DD16 08010001        	   814:     btst    #1,D1                   ; Left (bit 1)
02:0004DD1A 6710            	   815:     beq.s   .tlb_no_left
02:0004DD1C 102C0070        	   816:     move.b  ($0070,A4),D0
02:0004DD20 0C00000A        	   817:     cmpi.b  #$0A,D0
02:0004DD24 6306            	   818:     bls.s   .tlb_no_left
02:0004DD26 5900            	   819:     subi.b  #4,D0
02:0004DD28 19400070        	   820:     move.b  D0,($0070,A4)
                            	   821: .tlb_no_left:
02:0004DD2C 08010000        	   822:     btst    #0,D1                   ; Right (bit 0)
02:0004DD30 6710            	   823:     beq.s   .tlb_no_right
02:0004DD32 102C0070        	   824:     move.b  ($0070,A4),D0
02:0004DD36 0C0000E6        	   825:     cmpi.b  #$E6,D0
02:0004DD3A 6406            	   826:     bcc.s   .tlb_no_right
02:0004DD3C 5800            	   827:     addi.b  #4,D0
02:0004DD3E 19400070        	   828:     move.b  D0,($0070,A4)
                            	   829: .tlb_no_right:
                            	   830: .tlb_exit:
02:0004DD42 4E75            	   831:     rts
                            	   832:     endc
