                            	  3437: _anon_z04_45:
02:0003ADB4 1883            	  3438:     move.b  D3,($0000,A4)
                            	  3439:     ; [01] holds Link's X coordinate.
                            	  3440:     ;
02:0003ADB6 102C0070        	  3441:     move.b  ($0070,A4),D0
02:0003ADBA 19400001        	  3442:     move.b  D0,($0001,A4)
                            	  3443:     ; Add Link's X and the horizontal offset.
                            	  3444:     ;
02:0003ADBE 023C00EE        	  3445:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADC2 1214            	  3446:     move.b  ($0000,A4),D1
02:0003ADC4 D101            	  3447:     addx.b  D1,D0   ; ADC $00
                            	  3448:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3449:     ;
02:0003ADC6 020000F8        	  3450:     andi.b #$F8,D0
                            	  3451:     ; Assign that result to the leever's X coordinate and [02].
                            	  3452:     ;
02:0003ADCA 19802070        	  3453:     move.b  D0,($70,A4,D2.W)
02:0003ADCE 19400002        	  3454:     move.b  D0,($0002,A4)
                            	  3455:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3456:     ;
02:0003ADD2 122C0001        	  3457:     move.b  ($0001,A4),D1
02:0003ADD6 B001            	  3458:     cmp.b   D1,D0
02:0003ADD8 6510            	  3459:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003ADDA 1B00            	  3460:     move.b  D0,-(A5)  ; PHA
02:0003ADDC 102C0001        	  3461:     move.b  ($0001,A4),D0
02:0003ADE0 19400002        	  3462:     move.b  D0,($0002,A4)
02:0003ADE4 101D            	  3463:     move.b  (A5)+,D0  ; PLA
02:0003ADE6 19400001        	  3464:     move.b  D0,($0001,A4)
                            	  3465:     even
                            	  3466: _L_z04_UpdateRedLeever_Subtract:
                            	  3467:     ; The point is to get the absolute distance between the two.
                            	  3468:     ;
02:0003ADEA 102C0001        	  3469:     move.b  ($0001,A4),D0
02:0003ADEE 003C0011        	  3470:     ori     #$11,CCR  ; SEC: set C+X
02:0003ADF2 122C0002        	  3471:     move.b  ($0002,A4),D1
02:0003ADF6 0A3C0010        	  3472:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ADFA 9101            	  3473:     subx.b  D1,D0   ; SBC $02
02:0003ADFC 0A3C0010        	  3474:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3475:     ; If the absolute distance >= $30, then return.
                            	  3476:     ; It means that the leever's X coordinate wrapped around
                            	  3477:     ; the left or right edge of the screen.
                            	  3478:     ;
02:0003AE00 0C000030        	  3479:     cmpi.b  #$30,D0
02:0003AE04 6486            	  3480:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3481:     even
                            	  3482: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3483:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3484:     ;
