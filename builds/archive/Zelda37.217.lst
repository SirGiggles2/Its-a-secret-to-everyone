02:0003B2C2 667C            	  4217:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4218:     ; The current heart's state = 0.
                            	  4219:     ;
                            	  4220:     ; If object slot = 2, then go make it appear. This is the first
                            	  4221:     ; heart to show up.
                            	  4222:     ;
02:0003B2C4 0C020002        	  4223:     cmpi.b  #$02,D2
02:0003B2C8 6732            	  4224:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4225:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4226:     ; go start over.
