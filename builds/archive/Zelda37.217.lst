02:0003CEF2 023C00EE        	  8097:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEF6 41F90003CDD4    	  8098:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CEFC 12303000        	  8099:     move.b  (A0,D3.W),D1
02:0003CF00 D101            	  8100:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF02 41EC042C        	  8101:     lea     ($042C,A4),A0
02:0003CF06 11802000        	  8102:     move.b  D0,(A0,D2.W)
