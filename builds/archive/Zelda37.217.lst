02:00039FC2 9101            	  1411:     subx.b  D1,D0   ; SBC #$2B
02:00039FC4 0A3C0010        	  1412:     eori    #$10,CCR  ; restore X = 6502 C
02:00039FC8 6008            	  1413:     jmp     _L_z04_UpdateBubble_Animate
