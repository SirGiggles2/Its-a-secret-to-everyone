                            	 11432: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11433:     ; The whole gleeok died, because the last neck died.
                            	 11434:     ;
                            	 11435:     ; First, hide the first $10 sprites: the attached heads.
                            	 11436:     ;
02:0003E814 4EB9000312C0    	 11437:     jsr     WriteBlankPrioritySprites
02:0003E81A 6100101E        	 11438:     jsr     PlayBossDeathCry
                            	 11439:     ; We want a death spark. So, set the metastate of the first
                            	 11440:     ; monster slot to $11.
                            	 11441:     ;
02:0003E81E 7011            	 11442:     moveq   #17,D0
02:0003E820 19400406        	 11443:     move.b  D0,($0406,A4)
                            	 11444:     ; Reset the object type of slots 2 to $A.
                            	 11445:     ;
                            	 11446:     ; Beware a left over fireball in slot $B!
                            	 11447:     ;
02:0003E824 7601            	 11448:     moveq   #1,D3
                            	 11449:     even
