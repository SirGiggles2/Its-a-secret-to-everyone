                            	  3417: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3418:     ; Begin with the leever's Y set to Link's Y.
                            	  3419:     ;
02:0003AD8E 102C0084        	  3420:     move.b  ($0084,A4),D0
02:0003AD92 41EC0084        	  3421:     lea     ($0084,A4),A0
02:0003AD96 11802000        	  3422:     move.b  D0,(A0,D2.W)
                            	  3423:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3424:     ; it's too close to the top edge of the screen. So, return.
                            	  3425:     ;
02:0003AD9A 0C00005D        	  3426:     cmpi.b  #$5D,D0
