02:0003EEB4 0A3C0010        	 12322:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEB8 640A            	 12323:     bcc  _anon_z04_154
02:0003EEBA 122C0003        	 12324:     move.b  ($0003,A4),D1
02:0003EEBE E309            	 12325:     lsl.b  #1,D1   ; ASL $03
02:0003EEC0 19410003        	 12326:     move.b  D1,($0003,A4)
                            	 12327: _anon_z04_154:
