                            	  4211: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4212:     ; If the current heart's state <> 0, then go move it.
                            	  4213:     ; Else we have to wait for it to come out at the right time.
                            	  4214:     ;
02:0003B2BA 41EC00AC        	  4215:     lea     ($00AC,A4),A0
