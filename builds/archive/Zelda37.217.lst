                            	 11210: __far_z_04_0105:
                            	 11211: ; Description:
                            	 11212: ; This block applies to heads and the bottom segment of a neck.
                            	 11213: ; These are drawn with sprites that come first in order, so that
                            	 11214: ; they are drawn above all other sprites, including Link.
                            	 11215: ;
                            	 11216: ; Params:
                            	 11217: ; A: tile number
                            	 11218: ;
                            	 11219: ; Normal sprite with level palette row
                            	 11220:     even
                            	 11221: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E694 7603            	 11222:     moveq   #3,D3
02:0003E696 19430003        	 11223:     move.b  D3,($0003,A4)
02:0003E69A 1B00            	 11224:     move.b  D0,-(A5)  ; PHA
                            	 11225:     ; To calculate the base offset of the sprite record:
                            	 11226:     ; offset := neck index * 8
                            	 11227:     ;
                            	 11228:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11229:     ; at an even index.
                            	 11230:     ;
02:0003E69C 102C04D7        	 11231:     move.b  ($04D7,A4),D0
02:0003E6A0 E308            	 11232:     lsl.b  #1,D0   ; ASL A
02:0003E6A2 E308            	 11233:     lsl.b  #1,D0   ; ASL A
02:0003E6A4 E308            	 11234:     lsl.b  #1,D0   ; ASL A
                            	 11235:     ; But if the segment is not a head (not at object slot 5), then
                            	 11236:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11237:     ;
02:0003E6A6 0C020005        	 11238:     cmpi.b  #$05,D2
02:0003E6AA 670A            	 11239:     beq  _anon_z04_139
02:0003E6AC 023C00EE        	 11240:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6B0 123C0020        	 11241:     move.b  #$20,D1
02:0003E6B4 D101            	 11242:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11243: _anon_z04_139:
02:0003E6B6 7600            	 11244:     moveq   #0,D3
02:0003E6B8 1600            	 11245:     move.b  D0,D3
02:0003E6BA 101D            	 11246:     move.b  (A5)+,D0  ; PLA
02:0003E6BC 4EB9000318F4    	 11247:     jsr     Anim_WriteSpecificSprite
02:0003E6C2 6026            	 11248:     jmp     Gleeok_CheckCollisions
                            	 11249: 
                            	 11250:     even
                            	 11251: Gleeok_DrawHeadAndCheckCollisions:
02:0003E6C4 7405            	 11252:     moveq   #5,D2
                            	 11253:     even
                            	 11254: Gleeok_DrawSegmentAndCheckCollisions:
02:0003E6C6 103C00DA        	 11255:     move.b  #$DA,D0
02:0003E6CA 0C020005        	 11256:     cmpi.b  #$05,D2
02:0003E6CE 6604            	 11257:     bne  _anon_z04_140
02:0003E6D0 103C00DC        	 11258:     move.b  #$DC,D0
                            	 11259: _anon_z04_140:
02:0003E6D4 0C020005        	 11260:     cmpi.b  #$05,D2
02:0003E6D8 6602            	 11261:     bne.s  __far_z_04_0106
02:0003E6DA 60B8            	 11262:     jmp  Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions
                            	 11263: __far_z_04_0106:
