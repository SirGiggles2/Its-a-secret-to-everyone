                            	  6999: ;
                            	  7000:     even
                            	  7001: CheckMonsterBoomerangOrFoodCollision:
02:00031CE0 41EC00AC        	  7002:     lea     ($00AC,A4),A0
02:00031CE4 10303000        	  7003:     move.b  (A0,D3.W),D0
02:00031CE8 E308            	  7004:     lsl.b  #1,D0   ; ASL A
02:00031CEA 65F2            	  7005:     bcs  _anon_z01_87
