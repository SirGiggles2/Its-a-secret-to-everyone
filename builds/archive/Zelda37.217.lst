                            	  3774: DrawGhiniAndCheckCollisions:
02:0003B02E 4EB90004D330    	  3775:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B034 1940000D        	  3776:     move.b  D0,($000D,A4)
                            	  3777:     ; If the direction has an "up" component, then keep the
                            	  3778:     ; frame image 0, and go figure out horizontal flipping.
                            	  3779:     ;
02:0003B038 41EC0098        	  3780:     lea     ($0098,A4),A0
02:0003B03C 10302000        	  3781:     move.b  (A0,D2.W),D0
02:0003B040 02000008        	  3782:     andi.b #$08,D0
02:0003B044 6614            	  3783:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3784:     ; Else make the frame image 1 for the "down" frame.
                            	  3785:     ; Note that this is the frame image to use, even if there's no
                            	  3786:     ; down component in the direction.
                            	  3787:     ;
02:0003B046 522C000D        	  3788:     addq.b  #1,($000D,A4)
                            	  3789:     ; If right is a component of the direction, then go set horizontal
                            	  3790:     ; flipping. Else leave horizontal flipping = 0.
                            	  3791:     ;
02:0003B04A 41EC0098        	  3792:     lea     ($0098,A4),A0
02:0003B04E 10302000        	  3793:     move.b  (A0,D2.W),D0
02:0003B052 02000001        	  3794:     andi.b #$01,D0
02:0003B056 6714            	  3795:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B058 660E            	  3796:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3797:     even
                            	  3798: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3799:     ; Set horizontal flipping if right is a direction component.
                            	  3800:     ; This essentially the same test as above, but for when we jump
                            	  3801:     ; from the "up" test.
                            	  3802:     ;
02:0003B05A 41EC0098        	  3803:     lea     ($0098,A4),A0
02:0003B05E 10302000        	  3804:     move.b  (A0,D2.W),D0
02:0003B062 02000002        	  3805:     andi.b #$02,D0
02:0003B066 6704            	  3806:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3807:     even
                            	  3808: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B068 522C000F        	  3809:     addq.b  #1,($000F,A4)
                            	  3810:     even
                            	  3811: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B06C 102C000D        	  3812:     move.b  ($000D,A4),D0
                            	  3813: ; Params:
                            	  3814: ; A: frame image
                            	  3815: ; X: object index
                            	  3816: ; [00]: object X
                            	  3817: ; [01]: object Y
                            	  3818: ; [0F]: flip horizontally
                            	  3819: ;
                            	  3820: ; Returns:
                            	  3821: ; [00]: 0 for Link slot
                            	  3822: ; [06]: 1 if objects collide
                            	  3823: ; [09]: 0 for Link damage type (none)
                            	  3824: ; [0C]: 1 if objects collide
                            	  3825: ; [034B]: ShotCollidesWithLink
                            	  3826: ;
                            	  3827:     even
