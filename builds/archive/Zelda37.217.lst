                            	  1990: _L_z04_UpdateStatues_Shoot:
                            	  1991:     ; Look for an empty monster slot.
                            	  1992:     ; If none is found, return.
                            	  1993:     ;
                            	  1994:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1995:     ; object. This routine takes a shooter object, and instantiates
                            	  1996:     ; a fireball object at the shooter's location.
                            	  1997:     ;
                            	  1998:     ; The object slot we set up here will behave as the shooter.
                            	  1999:     ; For each fireball index, this object slot will have its coordinates
                            	  2000:     ; changed.
                            	  2001:     ;
                            	  2002:     ; Note that this means that:
                            	  2003:     ; 1. The first fireball made will be its own shooter.
                            	  2004:     ;    Practically, there's nothing special about this.
                            	  2005:     ; 2. If there is more than one fireball made in a frame,
                            	  2006:     ;    then two of them will come from the same statue.
                            	  2007:     ;
                            	  2008:     ;
                            	  2009:     ; Save the fireball pattern.
02:0003A3BE 1003            	  2010:     move.b  D3,D0
02:0003A3C0 1B00            	  2011:     move.b  D0,-(A5)  ; PHA
02:0003A3C2 4EB90004DB20    	  2012:     jsr     FindEmptyMonsterSlot
02:0003A3C8 0C000001        	  2013:     cmpi.b  #$01,D0
02:0003A3CC 101D            	  2014:     move.b  (A5)+,D0  ; PLA
02:0003A3CE 6400010A        	  2015:     bcc  _L_z04_UpdateStatues_Exit
                            	  2016:     ; If we found a slot, but it < 6, return.
                            	  2017:     ;
02:0003A3D2 0C030006        	  2018:     cmpi.b  #$06,D3
02:0003A3D6 65000102        	  2019:     bcs  _L_z04_UpdateStatues_Exit
                            	  2020:     ; Store the object slot in [0A].
                            	  2021:     ; Store fireball pattern in [0B].
                            	  2022:     ;
02:0003A3DA 1943000A        	  2023:     move.b  D3,($000A,A4)
02:0003A3DE 1940000B        	  2024:     move.b  D0,($000B,A4)
                            	  2025:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  2026:     ;
02:0003A3E2 7600            	  2027:     moveq   #0,D3
02:0003A3E4 1600            	  2028:     move.b  D0,D3
02:0003A3E6 7400            	  2029:     moveq   #0,D2
02:0003A3E8 41F90003A37A    	  2030:     lea     (StatueFireballCounts).l,A0
02:0003A3EE 14303000        	  2031:     move.b  (A0,D3.W),D2
                            	  2032:     even
                            	  2033: _L_z04_UpdateStatues_LoopFireball:
                            	  2034:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2035:     ;
                            	  2036:     ; Decrement the fireball timer at this index.
                            	  2037:     ;
02:0003A3F2 7600            	  2038:     moveq   #0,D3
02:0003A3F4 41EC04E8        	  2039:     lea     ($04E8,A4),A0
02:0003A3F8 16302000        	  2040:     move.b  (A0,D2.W),D3
02:0003A3FC 5303            	  2041:     subq.b  #1,D3
02:0003A3FE 1003            	  2042:     move.b  D3,D0
02:0003A400 41EC04E8        	  2043:     lea     ($04E8,A4),A0
02:0003A404 11802000        	  2044:     move.b  D0,(A0,D2.W)
                            	  2045:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2046:     ; to make a fireball. Go loop again.
                            	  2047:     ;
02:0003A408 5203            	  2048:     addq.b  #1,D3
02:0003A40A 660000C8        	  2049:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2050:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2051:     ; This fireball index will wait another $100 frames.
                            	  2052:     ;
02:0003A40E 10342018        	  2053:     move.b  ($18,A4,D2.W),D0
02:0003A412 0C0000F0        	  2054:     cmpi.b  #$F0,D0
02:0003A416 640000BC        	  2055:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2056:     ; Else choose one of four start times for the fireball based on
                            	  2057:     ; the random value.
                            	  2058:     ;
02:0003A41A 02000003        	  2059:     andi.b #$03,D0
02:0003A41E 7600            	  2060:     moveq   #0,D3
02:0003A420 1600            	  2061:     move.b  D0,D3
02:0003A422 41F90003A37E    	  2062:     lea     (StatueFireballStartTimes).l,A0
02:0003A428 10303000        	  2063:     move.b  (A0,D3.W),D0
02:0003A42C 41EC04E8        	  2064:     lea     ($04E8,A4),A0
02:0003A430 11802000        	  2065:     move.b  D0,(A0,D2.W)
                            	  2066:     ; The coordinate lists are divided into sets for each pattern.
                            	  2067:     ;
                            	  2068:     ; Look up the index of the base of the set for the pattern in use.
                            	  2069:     ; Add it to the fireball index in X register to get the index of
                            	  2070:     ; the coordinate we want within each coordinate list.
                            	  2071:     ;
                            	  2072:     ;
                            	  2073:     ; Pattern
02:0003A434 7600            	  2074:     moveq   #0,D3
02:0003A436 162C000B        	  2075:     move.b  ($000B,A4),D3
02:0003A43A 1002            	  2076:     move.b  D2,D0
02:0003A43C 023C00EE        	  2077:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A440 41F90003A382    	  2078:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A446 12303000        	  2079:     move.b  (A0,D3.W),D1
02:0003A44A D101            	  2080:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A44C 7600            	  2081:     moveq   #0,D3
02:0003A44E 1600            	  2082:     move.b  D0,D3
02:0003A450 1002            	  2083:     move.b  D2,D0
02:0003A452 1B00            	  2084:     move.b  D0,-(A5)  ; PHA
                            	  2085:     ; Get Link's coordinates into [00] and [01].
                            	  2086:     ;
02:0003A454 7400            	  2087:     moveq   #0,D2
02:0003A456 4EB90004D330    	  2088:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2089:     ; Switch to the new fireball's object slot.
                            	  2090:     ;
02:0003A45C 7400            	  2091:     moveq   #0,D2
02:0003A45E 142C000A        	  2092:     move.b  ($000A,A4),D2
                            	  2093:     ; Look up and set the X coordinate for the fireball object.
                            	  2094:     ; Also store it in [02].
                            	  2095:     ;
02:0003A462 41F90003A386    	  2096:     lea     (StatueXs).l,A0
02:0003A468 10303000        	  2097:     move.b  (A0,D3.W),D0
02:0003A46C 19400002        	  2098:     move.b  D0,($0002,A4)
02:0003A470 19802070        	  2099:     move.b  D0,($70,A4,D2.W)
                            	  2100:     ; Look up and set the Y coordinate for the fireball object.
                            	  2101:     ; Also store it in [03].
                            	  2102:     ;
02:0003A474 41F90003A38E    	  2103:     lea     (StatueYs).l,A0
02:0003A47A 10303000        	  2104:     move.b  (A0,D3.W),D0
02:0003A47E 19400003        	  2105:     move.b  D0,($0003,A4)
02:0003A482 41EC0084        	  2106:     lea     ($0084,A4),A0
02:0003A486 11802000        	  2107:     move.b  D0,(A0,D2.W)
                            	  2108:     ; Set mask value 3 in [04].
                            	  2109:     ;
02:0003A48A 7003            	  2110:     moveq   #3,D0
02:0003A48C 19400004        	  2111:     move.b  D0,($0004,A4)
                            	  2112:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2113:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2114:     ;
02:0003A490 7601            	  2115:     moveq   #1,D3
                            	  2116:     even
                            	  2117: _L_z04_UpdateStatues_LoopAxis:
02:0003A492 10343000        	  2118:     move.b  ($00,A4,D3.W),D0
02:0003A496 003C0011        	  2119:     ori     #$11,CCR  ; SEC: set C+X
02:0003A49A 12343002        	  2120:     move.b  ($02,A4,D3.W),D1
02:0003A49E 0A3C0010        	  2121:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A4A2 9101            	  2122:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A4A4 0A3C0010        	  2123:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A4A8 0C000018        	  2124:     cmpi.b  #$18,D0
02:0003A4AC 6A10            	  2125:     bpl  _anon_z04_31
02:0003A4AE 0C0000E8        	  2126:     cmpi.b  #$E8,D0
02:0003A4B2 6B0A            	  2127:     bmi  _anon_z04_31
02:0003A4B4 122C0004        	  2128:     move.b  ($0004,A4),D1
02:0003A4B8 E209            	  2129:     lsr.b  #1,D1   ; LSR $04
02:0003A4BA 19410004        	  2130:     move.b  D1,($0004,A4)
                            	  2131: _anon_z04_31:
02:0003A4BE 5303            	  2132:     subq.b  #1,D3
02:0003A4C0 6AD0            	  2133:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2134:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2135:     ; 0 or 1 time, instead of 2.
                            	  2136:     ;
                            	  2137:     ; This, in turn, means that the distance between Link and the
                            	  2138:     ; fireball was >= $18 in at least one axis.
                            	  2139:     ;
                            	  2140:     ; So, we're OK to finish making the fireball.
                            	  2141:     ;
02:0003A4C2 102C0004        	  2142:     move.b  ($0004,A4),D0
02:0003A4C6 6706            	  2143:     beq  _anon_z04_32
02:0003A4C8 7055            	  2144:     moveq   #85,D0
02:0003A4CA 6100F780        	  2145:     jsr     ShootFireball
                            	  2146: _anon_z04_32:
