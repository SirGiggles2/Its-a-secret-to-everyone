                            	  7220: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7221:     ; Bloated timer =>
                            	  7222:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7223:     ; 1:     go advance the substate
                            	  7224:     ; other: go decrement Bloated timer
                            	  7225:     ;
02:0003C904 7600            	  7226:     moveq   #0,D3
02:0003C906 41EC045E        	  7227:     lea     ($045E,A4),A0
02:0003C90A 16302000        	  7228:     move.b  (A0,D2.W),D3
02:0003C90E 5303            	  7229:     subq.b  #1,D3
