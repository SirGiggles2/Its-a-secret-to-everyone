                            	  6108:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6109:     ;
02:0003C0C0 10342028        	  6110:     move.b  ($28,A4,D2.W),D0
02:0003C0C4 0C000010        	  6111:     cmpi.b  #$10,D0
02:0003C0C8 6702            	  6112:     beq.s  __far_z_04_0049
02:0003C0CA 6058            	  6113:     jmp  L1156B_Exit
