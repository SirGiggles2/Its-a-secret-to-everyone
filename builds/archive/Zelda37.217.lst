02:0003E3B0 0A3C0010        	 10795:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E3B4 4EB900030A04    	 10796:     jsr     Abs
02:0003E3BA E208            	 10797:     lsr.b  #1,D0   ; LSR A
02:0003E3BC E208            	 10798:     lsr.b  #1,D0   ; LSR A
