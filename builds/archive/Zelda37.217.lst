02:0003CD5E 7000            	  7882:     moveq   #0,D0
02:0003CD60 1980203D        	  7883:     move.b  D0,($3D,A4,D2.W)
02:0003CD64 7008            	  7884:     moveq   #8,D0
02:0003CD66 4EB90004D32A    	  7885:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7886:     ; If facing left, then enable horizontal flipping.
                            	  7887:     ;
02:0003CD6C 41EC0098        	  7888:     lea     ($0098,A4),A0
02:0003CD70 10302000        	  7889:     move.b  (A0,D2.W),D0
02:0003CD74 0C000002        	  7890:     cmpi.b  #$02,D0
02:0003CD78 6604            	  7891:     bne  _anon_z04_94
02:0003CD7A 522C000F        	  7892:     addq.b  #1,($000F,A4)
                            	  7893: _anon_z04_94:
                            	  7894:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7895:     ; This is the base frame image.
                            	  7896:     ;
02:0003CD7E E208            	  7897:     lsr.b  #1,D0   ; LSR A
02:0003CD80 E208            	  7898:     lsr.b  #1,D0   ; LSR A
                            	  7899:     ; If movement frame = 1, add 3 to frame image to access
                            	  7900:     ; the second animation frame's images.
                            	  7901:     ;
02:0003CD82 7600            	  7902:     moveq   #0,D3
02:0003CD84 41EC03E4        	  7903:     lea     ($03E4,A4),A0
02:0003CD88 16302000        	  7904:     move.b  (A0,D2.W),D3
02:0003CD8C 671E            	  7905:     beq  _anon_z04_95
02:0003CD8E 023C00EE        	  7906:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD92 123C0003        	  7907:     move.b  #$03,D1
02:0003CD96 D101            	  7908:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7909:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7910:     ;
                            	  7911:     ; Down has two frame images, but up only has one. By flipping
                            	  7912:     ; horizontally, you get two frame images.
                            	  7913:     ;
02:0003CD98 7600            	  7914:     moveq   #0,D3
02:0003CD9A 41EC0098        	  7915:     lea     ($0098,A4),A0
02:0003CD9E 16302000        	  7916:     move.b  (A0,D2.W),D3
02:0003CDA2 0C030008        	  7917:     cmpi.b  #$08,D3
02:0003CDA6 6604            	  7918:     bne  _anon_z04_95
