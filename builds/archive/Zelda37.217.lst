                            	  1965: UpdateStatues:
                            	  1966:     ; If person fireballs are enabled (from the two fires), then
                            	  1967:     ; go make fireballs with pattern 2.
                            	  1968:     ;
02:0003A396 7602            	  1969:     moveq   #2,D3
02:0003A398 102C04CC        	  1970:     move.b  ($04CC,A4),D0
02:0003A39C 6620            	  1971:     bne  _L_z04_UpdateStatues_Shoot
                            	  1972:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1973:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1974:     ; - layout $23: pattern 1: 2 statues
                            	  1975:     ; - layout $24: pattern 0: 4 statues
                            	  1976:     ;
02:0003A39E 4EB90004B13E    	  1977:     jsr     GetUniqueRoomId
02:0003A3A4 7601            	  1978:     moveq   #1,D3
