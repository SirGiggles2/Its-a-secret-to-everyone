02:0003AFFE 4EB900031946    	  3746:     jsr     CheckMonsterCollisions
                            	  3747:     ; If the monster is still alive, then return.
                            	  3748:     ;
02:0003B004 41EC0405        	  3749:     lea     ($0405,A4),A0
