02:0003F0F2 702C            	 12640:     moveq   #44,D0
02:0003F0F4 7600            	 12641:     moveq   #0,D3
02:0003F0F6 41EC034F        	 12642:     lea     ($034F,A4),A0
02:0003F0FA 16302000        	 12643:     move.b  (A0,D2.W),D3
