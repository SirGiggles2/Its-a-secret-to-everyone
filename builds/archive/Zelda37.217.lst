02:0003BB2A 00000001        	  5358:     ori.b #$01,D0
02:0003BB2E 4EB9000318BC    	  5359:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5360:     ; If the sprite attributes for this step have horizontal flipping ($40),
