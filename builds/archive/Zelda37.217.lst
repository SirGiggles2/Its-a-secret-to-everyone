02:0003CA66 123C0008        	  7413:     move.b  #$08,D1
02:0003CA6A D101            	  7414:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA6C 7600            	  7415:     moveq   #0,D3
02:0003CA6E 41EC0098        	  7416:     lea     ($0098,A4),A0
02:0003CA72 16302000        	  7417:     move.b  (A0,D2.W),D3
