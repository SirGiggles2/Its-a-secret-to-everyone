02:0003A6B0 41EC0451        	  2451:     lea     ($0451,A4),A0
02:0003A6B4 16302000        	  2452:     move.b  (A0,D2.W),D3
02:0003A6B8 5303            	  2453:     subq.b  #1,D3
                            	  2454:     ; If Y register < 0, then shoot timer is 0.
                            	  2455:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2456:     ; Else go set a non-zero speed and return.
