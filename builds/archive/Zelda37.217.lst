                            	   150: TransferCurTileBuf:
                            	   151:     ; PATCHED: DynTileBuf pending-record pre-check (generalized Bug C fix).
                            	   152:     ; If DynTileBuf is non-empty while TileBufSelector already points at a
                            	   153:     ; later static buffer, consume DynTileBuf first and leave selector intact
                            	   154:     ; for the next NMI. This preserves NES ordering for dynamic room/menu
                            	   155:     ; records that would otherwise be dropped by selector timing drift.
02:00045AE2 41F900FF0302    	   156:     lea     (NES_RAM+DynTileBuf).l,A0
02:00045AE8 0C1000FF        	   157:     cmpi.b  #$FF,(A0)                  ; DynTileBuf empty sentinel?
02:00045AEC 672E            	   158:     beq.s   .no_pending_dyn
02:00045AEE 4A2C0014        	   159:     tst.b   ($0014,A4)                  ; TileBufSelector = 0 => normal DynTileBuf path
02:00045AF2 6728            	   160:     beq.s   .no_pending_dyn
02:00045AF4 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:00045AF8 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:00045AFE 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00045B02 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:00045B0A 703F            	   165:     moveq   #63,D0
02:00045B0C 19400300        	   166:     move.b  D0,($0300,A4)
02:00045B10 7400            	   167:     moveq   #0,D2
02:00045B12 1942005C        	   168:     move.b  D2,($005C,A4)
02:00045B16 19420301        	   169:     move.b  D2,($0301,A4)
02:00045B1A 4E75            	   170:     rts
                            	   171: .no_pending_dyn:
                            	   172:     ; 32-bit pointer table lookup for main dispatch.
02:00045B1C 7400            	   173:     moveq   #0,D2
02:00045B1E 142C0014        	   174:     move.b  ($0014,A4),D2
02:00045B22 D442            	   175:     add.w   D2,D2                       ; 2-byte index -> 4-byte index
02:00045B24 43F90004788A    	   176:     lea     (TransferBufPtrs).l,A1
02:00045B2A 20312000        	   177:     move.l  (A1,D2.W),D0               ; D0 = 32-bit buffer pointer
02:00045B2E 2040            	   178:     movea.l D0,A0                      ; A0 = 32-bit buffer pointer
02:00045B30 611C            	   179:     jsr     TransferTileBuf
02:00045B32 703F            	   180:     moveq   #63,D0
02:00045B34 19400300        	   181:     move.b  D0,($0300,A4)
02:00045B38 7400            	   182:     moveq   #0,D2
02:00045B3A 19420014        	   183:     move.b  D2,($0014,A4)
02:00045B3E 1942005C        	   184:     move.b  D2,($005C,A4)
02:00045B42 19420301        	   185:     move.b  D2,($0301,A4)
02:00045B46 5302            	   186:     subq.b  #1,D2
02:00045B48 19420302        	   187:     move.b  D2,($0302,A4)
02:00045B4C 4E75            	   188:     rts
