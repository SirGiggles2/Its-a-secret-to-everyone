                            	  5491: _anon_z04_73:
02:0003BC1C 5302            	  5492:     subq.b  #1,D2
02:0003BC1E 6AC4            	  5493:     bpl  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_LoopExtent
