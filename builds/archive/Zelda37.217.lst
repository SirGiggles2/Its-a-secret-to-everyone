02:00031B6A 12302000        	  6802:     move.b  (A0,D2.W),D1
02:00031B6E 8001            	  6803:     or.b  D1,D0
02:00031B70 0200000C        	  6804:     andi.b #$0C,D0
02:00031B74 0C00000C        	  6805:     cmpi.b  #$0C,D0
02:00031B78 671A            	  6806:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031B7A 102C0098        	  6807:     move.b  ($0098,A4),D0
