                            	 13331: Ganon_DrawBody:
                            	 13332:     ; Loop over four 16x16 images that make up Ganon.
                            	 13333:     ; There are 6 animation frames.
                            	 13334:     ;
02:0003F5EA 7603            	 13335:     moveq   #3,D3
                            	 13336:     even
                            	 13337: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13338:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13339:     ;
02:0003F5EC 10342070        	 13340:     move.b  ($70,A4,D2.W),D0
02:0003F5F0 023C00EE        	 13341:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5F4 41F90003F5DE    	 13342:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F5FA 12303000        	 13343:     move.b  (A0,D3.W),D1
02:0003F5FE D101            	 13344:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F600 1880            	 13345:     move.b  D0,($0000,A4)
                            	 13346:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13347:     ;
02:0003F602 41EC0084        	 13348:     lea     ($0084,A4),A0
02:0003F606 10302000        	 13349:     move.b  (A0,D2.W),D0
02:0003F60A 023C00EE        	 13350:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F60E 41F90003F5E2    	 13351:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F614 12303000        	 13352:     move.b  (A0,D3.W),D1
02:0003F618 D101            	 13353:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F61A 19400001        	 13354:     move.b  D0,($0001,A4)
                            	 13355:     ; Each part has a horizontal flipping flag.
                            	 13356:     ;
02:0003F61E 41F90003F5E6    	 13357:     lea     (GanonSpriteHFlips).l,A0
02:0003F624 10303000        	 13358:     move.b  (A0,D3.W),D0
02:0003F628 1940000F        	 13359:     move.b  D0,($000F,A4)
                            	 13360:     ; Save and copy the loop index (the current part) to [07].
                            	 13361:     ;
02:0003F62C 1003            	 13362:     move.b  D3,D0
02:0003F62E 1B00            	 13363:     move.b  D0,-(A5)  ; PHA
02:0003F630 19400007        	 13364:     move.b  D0,($0007,A4)
                            	 13365:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13366:     ; that make it up.
                            	 13367:     ;
02:0003F634 41EC046B        	 13368:     lea     ($046B,A4),A0
02:0003F638 10302000        	 13369:     move.b  (A0,D2.W),D0
02:0003F63C E308            	 13370:     lsl.b  #1,D0   ; ASL A
02:0003F63E E308            	 13371:     lsl.b  #1,D0   ; ASL A
                            	 13372:     ; Add [07] -- the index of the current part.
                            	 13373:     ;
                            	 13374:     ; Now you have an index into the frame image table, for the
                            	 13375:     ; current image part of the current animation frame.
                            	 13376:     ;
02:0003F640 122C0007        	 13377:     move.b  ($0007,A4),D1
02:0003F644 D101            	 13378:     addx.b  D1,D0   ; ADC $07
02:0003F646 7600            	 13379:     moveq   #0,D3
02:0003F648 1600            	 13380:     move.b  D0,D3
02:0003F64A 41F90003F5C6    	 13381:     lea     (GanonFrameImages).l,A0
02:0003F650 10303000        	 13382:     move.b  (A0,D3.W),D0
02:0003F654 4EB9000315CA    	 13383:     jsr     DrawObjectNotMirrored
02:0003F65A 101D            	 13384:     move.b  (A5)+,D0  ; PLA
                            	 13385:     ; Bottom of the part loop.
                            	 13386:     ;
02:0003F65C 7600            	 13387:     moveq   #0,D3
02:0003F65E 1600            	 13388:     move.b  D0,D3
02:0003F660 5303            	 13389:     subq.b  #1,D3
02:0003F662 6A88            	 13390:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F664 4E75            	 13391:     rts
                            	 13392: 
                            	 13393:     even
                            	 13394: Ganon_CheckCollisions:
                            	 13395:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13396:     ; Store in [02] and [03].
                            	 13397:     ;
02:0003F666 10342070        	 13398:     move.b  ($70,A4,D2.W),D0
02:0003F66A 023C00EE        	 13399:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F66E 123C0010        	 13400:     move.b  #$10,D1
02:0003F672 D101            	 13401:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F674 19400002        	 13402:     move.b  D0,($0002,A4)
02:0003F678 41EC0084        	 13403:     lea     ($0084,A4),A0
02:0003F67C 10302000        	 13404:     move.b  (A0,D2.W),D0
02:0003F680 023C00EE        	 13405:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F684 123C0010        	 13406:     move.b  #$10,D1
02:0003F688 D101            	 13407:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F68A 19400003        	 13408:     move.b  D0,($0003,A4)
                            	 13409:     ; Check for a collision with Link.
                            	 13410:     ;
                            	 13411:     ; We can't call CheckLinkCollision, because we need to
                            	 13412:     ; customize Ganon's midpoint.
                            	 13413:     ;
                            	 13414:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13415:     ; detection, if Link is invincible. Initialize variables that will
                            	 13416:     ; be returned from the partial collision check routine. Then
                            	 13417:     ; call it.
                            	 13418:     ;
02:0003F68E 102C04F0        	 13419:     move.b  ($04F0,A4),D0
02:0003F692 6616            	 13420:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F694 19400006        	 13421:     move.b  D0,($0006,A4)
02:0003F698 19400009        	 13422:     move.b  D0,($0009,A4)
02:0003F69C 1940000C        	 13423:     move.b  D0,($000C,A4)
02:0003F6A0 7600            	 13424:     moveq   #0,D3
02:0003F6A2 1883            	 13425:     move.b  D3,($0000,A4)
02:0003F6A4 4EB900031AC6    	 13426:     jsr     CheckLinkCollisionPreinit
                            	 13427:     even
                            	 13428: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13429:     ; If Ganon is not in state 0, then he's brown.
                            	 13430:     ; Go check collision with an arrow.
                            	 13431:     ;
02:0003F6AA 41EC00AC        	 13432:     lea     ($00AC,A4),A0
02:0003F6AE 10302000        	 13433:     move.b  (A0,D2.W),D0
02:0003F6B2 6652            	 13434:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13435:     ; If timer <> 0, then Ganon is visible.
                            	 13436:     ; He can't be harmed like this. So, return.
                            	 13437:     ;
02:0003F6B4 10342028        	 13438:     move.b  ($28,A4,D2.W),D0
02:0003F6B8 664A            	 13439:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F6BA 760D            	 13440:     moveq   #13,D3
02:0003F6BC 4EB900031F90    	 13441:     jsr     CheckMonsterSwordCollision
                            	 13442:     ; If Ganon has died according to the usual collision check rules
                            	 13443:     ; (HP = 0), then:
                            	 13444:     ; 1. Restore HP to the initial value $F0
                            	 13445:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13446:     ; 3. Change palette row 7 to make Ganon brown
                            	 13447:     ;
02:0003F6C2 41EC0405        	 13448:     lea     ($0405,A4),A0
02:0003F6C6 10302000        	 13449:     move.b  (A0,D2.W),D0
02:0003F6CA 6718            	 13450:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F6CC 103C00F0        	 13451:     move.b  #$F0,D0
02:0003F6D0 41EC0485        	 13452:     lea     ($0485,A4),A0
02:0003F6D4 11802000        	 13453:     move.b  D0,(A0,D2.W)
02:0003F6D8 41EC00AC        	 13454:     lea     ($00AC,A4),A0
02:0003F6DC 53302000        	 13455:     subq.b  #1,(A0,D2.W)
02:0003F6E0 61000084        	 13456:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13457:     even
                            	 13458: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13459:     ; If Ganon was harmed, then play the sound effect
                            	 13460:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13461:     ;
02:0003F6E4 41EC04F0        	 13462:     lea     ($04F0,A4),A0
02:0003F6E8 10302000        	 13463:     move.b  (A0,D2.W),D0
02:0003F6EC 670A            	 13464:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F6EE 61009FA8        	 13465:     jsr     PlayBossHitCryIfNeeded
02:0003F6F2 7040            	 13466:     moveq   #64,D0
02:0003F6F4 19802028        	 13467:     move.b  D0,($28,A4,D2.W)
                            	 13468:     even
                            	 13469: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13470:     ; Reset metastate, because Ganon cannot die this way.
                            	 13471:     ;
02:0003F6F8 4EB90004DB38    	 13472:     jsr     ResetObjMetastate
                            	 13473:     ; Reset shove info and invincibility timer, because Ganon
                            	 13474:     ; doesn't react at all as a usual monster.
                            	 13475:     ;
02:0003F6FE 4EB900031E98    	 13476:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13477:     even
                            	 13478: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F704 4E75            	 13479:     rts
                            	 13480: 
                            	 13481:     even
                            	 13482: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13483:     ; If the silver arrow is not in the inventory, then return.
                            	 13484:     ;
02:0003F706 102C0659        	 13485:     move.b  ($0659,A4),D0
02:0003F70A 0C000002        	 13486:     cmpi.b  #$02,D0
02:0003F70E 66F4            	 13487:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13488:     ; Reset the collision return value [06].
                            	 13489:     ;
02:0003F710 7000            	 13490:     moveq   #0,D0
02:0003F712 19400006        	 13491:     move.b  D0,($0006,A4)
                            	 13492:     ; If there's no arrow in flight, then return.
                            	 13493:     ;
02:0003F716 7612            	 13494:     moveq   #18,D3
02:0003F718 41EC00AC        	 13495:     lea     ($00AC,A4),A0
02:0003F71C 10303000        	 13496:     move.b  (A0,D3.W),D0
02:0003F720 0C000010        	 13497:     cmpi.b  #$10,D0
02:0003F724 66DE            	 13498:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13499:     ; Check for collision with an arrow; and return if no collision.
                            	 13500:     ;
02:0003F726 4EB900031FEC    	 13501:     jsr     CheckMonsterArrowOrRodCollision
02:0003F72C 102C0006        	 13502:     move.b  ($0006,A4),D0
02:0003F730 67D2            	 13503:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13504:     ; Set the Ganon phase to "dying".
                            	 13505:     ;
02:0003F732 41EC042C        	 13506:     lea     ($042C,A4),A0
02:0003F736 52302000        	 13507:     addq.b  #1,(A0,D2.W)
                            	 13508:     ; Now his body does flash.
                            	 13509:     ;
02:0003F73A 7028            	 13510:     moveq   #40,D0
02:0003F73C 41EC04F0        	 13511:     lea     ($04F0,A4),A0
02:0003F740 11802000        	 13512:     move.b  D0,(A0,D2.W)
                            	 13513:     ; Set initial cloud distance 8.
                            	 13514:     ;
02:0003F744 7008            	 13515:     moveq   #8,D0
02:0003F746 41EC0478        	 13516:     lea     ($0478,A4),A0
02:0003F74A 11802000        	 13517:     move.b  D0,(A0,D2.W)
02:0003F74E 0A3C0001        	 13518:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F752 4E75            	 13519:     rts
                            	 13520: 
                            	 13521:     even
