                            	   107: _L_z02_TransferCommonPatterns_LoopBlock:
02:000323B0 102C051D        	   108:     move.b  ($051D,A4),D0
02:000323B4 E308            	   109:     lsl.b  #1,D0   ; ASL A
02:000323B6 7400            	   110:     moveq   #0,D2
02:000323B8 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:000323BA 41F90003238C    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:000323C0 3A02            	   117:     move.w  D2,D5
02:000323C2 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:000323C4 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:000323C8 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:000323CC 41F900032398    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:000323D2 10302000        	   122:     move.b  (A0,D2.W),D0
02:000323D6 19400002        	   123:     move.b  D0,($0002,A4)
