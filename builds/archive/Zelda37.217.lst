02:00030ABE 102C0004        	  4621:     move.b  ($0004,A4),D0
02:00030AC2 19400003        	  4622:     move.b  D0,($0003,A4)
02:00030AC6 101D            	  4623:     move.b  (A5)+,D0  ; PLA
02:00030AC8 19400004        	  4624:     move.b  D0,($0004,A4)
02:00030ACC 7001            	  4625:     moveq   #1,D0
02:00030ACE 19400001        	  4626:     move.b  D0,($0001,A4)
                            	  4627:     even
