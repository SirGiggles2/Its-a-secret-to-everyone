02:0003B00E 760B            	  3756:     moveq   #11,D3
                            	  3757:     even
                            	  3758: _L_z04_UpdateGhini_LoopObject:
02:0003B010 41EC034F        	  3759:     lea     ($034F,A4),A0
02:0003B014 10303000        	  3760:     move.b  (A0,D3.W),D0
02:0003B018 0C000022        	  3761:     cmpi.b  #$22,D0
02:0003B01C 660A            	  3762:     bne  _anon_z04_50
02:0003B01E 7011            	  3763:     moveq   #17,D0
02:0003B020 41EC0405        	  3764:     lea     ($0405,A4),A0
02:0003B024 11803000        	  3765:     move.b  D0,(A0,D3.W)
                            	  3766: _anon_z04_50:
