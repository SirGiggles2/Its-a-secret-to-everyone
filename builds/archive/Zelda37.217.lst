02:00043A68 4EB900030E56    	  6067:     jsr     AddToInt16At0
                            	  6068:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  6069:     ; go 1 more tile down, to start the next column at the right place.
                            	  6070:     ; We have to compensate for the fact that E/W doors are 
                            	  6071:     ; shorter vertically than N/S doors.
02:00043A6E 4A02            	  6072:     cmpi.b  #$00,D2
02:00043A70 6610            	  6073:     bne  _anon_z05_115
02:00043A72 101D            	  6074:     move.b  (A5)+,D0  ; PLA
02:00043A74 1B00            	  6075:     move.b  D0,-(A5)  ; PHA
02:00043A76 0C000002        	  6076:     cmpi.b  #$02,D0
02:00043A7A 6406            	  6077:     bcc  _anon_z05_115
02:00043A7C 4EB900030E54    	  6078:     jsr     Add1ToInt16At0
