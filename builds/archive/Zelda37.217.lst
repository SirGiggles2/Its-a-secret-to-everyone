                            	  7788: ; Params:
                            	  7789: ; X: caller's object index, a monster
                            	  7790: ;    the attacker, if monster attacks Link
                            	  7791: ;    else defender, if weapon attacks monster
                            	  7792: ; [00]: 0 if monster attacks Link (defender),
                            	  7793: ;       else weapon slot (attacker)
                            	  7794: ; [09]: damage type,
                            	  7795: ;       only if a monster is defending
                            	  7796: ; TODO:
                            	  7797: ; [0B]: direction
                            	  7798: ;
                            	  7799: ; Only monsters (and fire) call this routine.
                            	  7800: ;
                            	  7801: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7802: ;
                            	  7803: ; On the other hand, if a weapon attacks a monster,
                            	  7804: ; the monster sets [00] to the weapon's slot.
                            	  7805: ;
                            	  7806: ;
                            	  7807: ; If a weapon attacks a monster, and the weapon's damage
                            	  7808: ; type matches the monster's invincibility mask;
                            	  7809: ; then return without shoving.
                            	  7810: ;
                            	  7811: ; If a monster attacks Link, then damage type will be 0.
                            	  7812: ;
