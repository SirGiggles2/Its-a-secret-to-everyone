02:0003BE4A 1234203D        	  5742:     move.b  ($3D,A4,D2.W),D1
02:0003BE4E 8001            	  5743:     or.b  D1,D0
02:0003BE50 6626            	  5744:     bne  _L_z04_UpdateStalfos_ZeroSpeed
