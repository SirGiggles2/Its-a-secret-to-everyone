                            	  6527:     even
                            	  6528: PrimarySquaresUW:
02:00043D92 B0              	  6529:     dc.b    $B0, $74, $94, $B4, $70, $68, $F4, $24
02:00043D93 74
02:00043D94 94
02:00043D95 B4
02:00043D96 70
02:00043D97 68
02:00043D98 F4
02:00043D99 24
