                            	  4035: __far_z_04_0036:
                            	  4036:     ; Armos animation frames last 6 screen frames.
                            	  4037:     ;
02:0003B1B6 7006            	  4038:     moveq   #6,D0
02:0003B1B8 41EC03D0        	  4039:     lea     ($03D0,A4),A0
02:0003B1BC 11802000        	  4040:     move.b  D0,(A0,D2.W)
                            	  4041:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4042:     ; change the position of the shield. To keep fixed it in place,
                            	  4043:     ; there are separate frame images for each animation frame.
                            	  4044:     ;
                            	  4045:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4046:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4047:     ;
                            	  4048:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4049:     ; Then choose the direction at the point of drawing below.
                            	  4050:     ;
02:0003B1C0 41EC03E4        	  4051:     lea     ($03E4,A4),A0
02:0003B1C4 10302000        	  4052:     move.b  (A0,D2.W),D0
02:0003B1C8 0A000002        	  4053:     eori.b #$02,D0
02:0003B1CC 41EC03E4        	  4054:     lea     ($03E4,A4),A0
02:0003B1D0 11802000        	  4055:     move.b  D0,(A0,D2.W)
                            	  4056:     even
