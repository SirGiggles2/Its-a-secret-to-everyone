02:0004CCE2 7001            	  6251:     moveq   #1,D0
                            	  6252: _anon_z07_32:
                            	  6253:     ; Set both the player's animation counter and the sword's
                            	  6254:     ; animation counter/timer to this value.
                            	  6255:     ;
02:0004CCE4 194003D0        	  6256:     move.b  D0,($03D0,A4)
