                            	  3999: FormatHeartsInTextBuf:
                            	  4000:     ; [$0E]: hearts value
                            	  4001:     ; [$0F]: heart partial
                            	  4002:     ; Y: The offset of first character in buffer
                            	  4003:     ;
                            	  4004:     ; The end of the bottom row is $12 bytes after the
                            	  4005:     ; start of the top row. We're writing to two transfer
                            	  4006:     ; records. We write the top row in the first transfer
                            	  4007:     ; record wherever the caller chooses. The second
                            	  4008:     ; transfer record has to begin with the heart tiles.
                            	  4009:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  4010:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  4011:     ;
                            	  4012:     ; Store the starting offset in [$0D].
02:000306C0 1943000D        	  4013:     move.b  D3,($000D,A4)
02:000306C4 102C000E        	  4014:     move.b  ($000E,A4),D0
02:000306C8 1B00            	  4015:     move.b  D0,-(A5)  ; PHA
02:000306CA 0200000F        	  4016:     andi.b #$0F,D0
02:000306CE 1880            	  4017:     move.b  D0,($0000,A4)
02:000306D0 700F            	  4018:     moveq   #15,D0
02:000306D2 003C0011        	  4019:     ori     #$11,CCR  ; SEC: set C+X
02:000306D6 1214            	  4020:     move.b  ($0000,A4),D1
02:000306D8 0A3C0010        	  4021:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000306DC 9101            	  4022:     subx.b  D1,D0   ; SBC $00
02:000306DE 0A3C0010        	  4023:     eori    #$10,CCR  ; restore X = 6502 C
02:000306E2 1880            	  4024:     move.b  D0,($0000,A4)
02:000306E4 101D            	  4025:     move.b  (A5)+,D0  ; PLA
02:000306E6 E208            	  4026:     lsr.b  #1,D0   ; LSR A
02:000306E8 E208            	  4027:     lsr.b  #1,D0   ; LSR A
02:000306EA E208            	  4028:     lsr.b  #1,D0   ; LSR A
02:000306EC E208            	  4029:     lsr.b  #1,D0   ; LSR A
02:000306EE 19400001        	  4030:     move.b  D0,($0001,A4)
02:000306F2 700F            	  4031:     moveq   #15,D0
02:000306F4 003C0011        	  4032:     ori     #$11,CCR  ; SEC: set C+X
02:000306F8 122C0001        	  4033:     move.b  ($0001,A4),D1
02:000306FC 0A3C0010        	  4034:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030700 9101            	  4035:     subx.b  D1,D0   ; SBC $01
02:00030702 0A3C0010        	  4036:     eori    #$10,CCR  ; restore X = 6502 C
02:00030706 19400001        	  4037:     move.b  D0,($0001,A4)
                            	  4038:     ; At this point,
                            	  4039:     ; [$00] = $F - hearts
                            	  4040:     ; [$01] = $F - heart containers
                            	  4041:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  4042:     ;
                            	  4043:     ; Also, Y is still set to the value passed in.
                            	  4044:     ;
02:0003070A 7400            	  4045:     moveq   #0,D2
02:0003070C 1003            	  4046:     move.b  D3,D0
02:0003070E 023C00EE        	  4047:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030712 123C0007        	  4048:     move.b  #$07,D1
02:00030716 D101            	  4049:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030718 1940000B        	  4050:     move.b  D0,($000B,A4)
