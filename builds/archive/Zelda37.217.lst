                            	  7980: _L_z04_UpdatePolsVoice_State0:
                            	  7981:     ; State 0. Walking.
                            	  7982:     ;
                            	  7983:     ; If grid offset = 0, then no more distance to cover.
                            	  7984:     ; So, go change to state 1 -- jumping.
                            	  7985:     ;
02:0003CE12 41EC0394        	  7986:     lea     ($0394,A4),A0
