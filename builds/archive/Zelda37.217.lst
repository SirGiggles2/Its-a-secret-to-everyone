                            	  5489: ; Params:
                            	  5490: ; [02]: bitmask for target door.
                            	  5491: ;
                            	  5492: ; Returns:
                            	  5493: ; A: door attribute for desired direction in current room.
                            	  5494: ; [01]: same as [02] if found; $10 otherwise
                            	  5495: ; [03]: reverse direction index
                            	  5496: ;
                            	  5497: ; Door bits:
                            	  5498: ; 1: E
                            	  5499: ; 2: W
                            	  5500: ; 4: S
                            	  5501: ; 8: N
                            	  5502: ;
                            	  5503: ;
                            	  5504: ; Start with single-bit mask 1.
                            	  5505:     even
