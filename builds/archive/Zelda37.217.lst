02:00043A36 2044            	  6053:     movea.l D4,A0
02:00043A38 10303000        	  6054:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043A3C 1214            	  6055:     move.b  ($00,A4),D1   ; ptr lo
02:00043A3E 182C0001        	  6056:     move.b  ($01,A4),D4  ; ptr hi
02:00043A42 024100FF        	  6057:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A46 E14C            	  6058:     lsl.w   #8,D4
02:00043A48 8841            	  6059:     or.w    D1,D4
02:00043A4A 48C4            	  6060:     ext.l   D4
02:00043A4C D8BC00FF0000    	  6061:     add.l   #NES_RAM,D4
