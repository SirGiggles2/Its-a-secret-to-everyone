                            	  6007: AnimateAndDrawObjectWalking:
02:000315BC 4EB90004D2CC    	  6008:     jsr     AnimateObjectWalking
02:000315C2 1003            	  6009:     move.b  D3,D0
02:000315C4 6004            	  6010:     jmp     DrawObjectNotMirrored
                            	  6011: 
                            	  6012: ; Params:
                            	  6013: ; A: frame image
                            	  6014: ; X: object index
                            	  6015: ; [00]: object X
                            	  6016: ; [01]: object Y
                            	  6017: ;
                            	  6018: ;
                            	  6019: ; Set [0C] mirrored.
                            	  6020:     even
                            	  6021: DrawObjectMirrored:
02:000315C6 7601            	  6022:     moveq   #1,D3
02:000315C8 6602            	  6023:     bne  _anon_z01_75
                            	  6024: ; Params:
                            	  6025: ; A: frame image
                            	  6026: ; X: object index
                            	  6027: ; [00]: object X
                            	  6028: ; [01]: object Y
                            	  6029: ; [0F]: flip horizontally
                            	  6030: ;
                            	  6031:     even
                            	  6032: DrawObjectNotMirrored:
02:000315CA 7600            	  6033:     moveq   #0,D3
                            	  6034: _anon_z01_75:
02:000315CC 1943000C        	  6035:     move.b  D3,($000C,A4)
                            	  6036:     ; Set animation index = object type + 1.
                            	  6037:     ;
02:000315D0 7600            	  6038:     moveq   #0,D3
02:000315D2 41EC034F        	  6039:     lea     ($034F,A4),A0
02:000315D6 16302000        	  6040:     move.b  (A0,D2.W),D3
                            	  6041: ; Params:
                            	  6042: ; A: frame
                            	  6043: ; X: object index/cycle sprite index
                            	  6044: ; Y: object type
                            	  6045: ; [00]: object X
                            	  6046: ; [01]: object Y
                            	  6047: ; [0C]: mirrored
                            	  6048: ; [0F]: flip horizontally
                            	  6049: ;
                            	  6050: ; Note:
                            	  6051: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6052: ;
                            	  6053: ; The animation index of most objects is (object type + 1),
                            	  6054: ; to make up for the fact that Link uses two animation indexes.
                            	  6055: ;
                            	  6056:     even
                            	  6057: DrawObjectWithType:
02:000315DA 5203            	  6058:     addq.b  #1,D3
                            	  6059: ; Params:
                            	  6060: ; A: frame
                            	  6061: ; X: object index/cycle sprite index
                            	  6062: ; Y: animation index
                            	  6063: ; [00]: object X
                            	  6064: ; [01]: object Y
                            	  6065: ; [0C]: mirrored
                            	  6066: ; [0F]: flip horizontally
                            	  6067: ;
                            	  6068: ; Note:
                            	  6069: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6070: ; But Link uses [0F] for flipping without checking [0C].
                            	  6071: ;
                            	  6072: ;
                            	  6073: ; [0D] holds frame.
                            	  6074:     even
                            	  6075: DrawObjectWithAnim:
02:000315DC 1940000D        	  6076:     move.b  D0,($000D,A4)
02:000315E0 1943000E        	  6077:     move.b  D3,($000E,A4)
02:000315E4 19420008        	  6078:     move.b  D2,($0008,A4)
                            	  6079:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  6080:     ;
02:000315E8 7600            	  6081:     moveq   #0,D3
02:000315EA 162C0341        	  6082:     move.b  ($0341,A4),D3
02:000315EE 41F900031592    	  6083:     lea     (SpriteOffsets).l,A0
02:000315F4 10303000        	  6084:     move.b  (A0,D3.W),D0
02:000315F8 19400343        	  6085:     move.b  D0,($0343,A4)
02:000315FC 41F900031593    	  6086:     lea     (SpriteOffsets+1).l,A0
02:00031602 10303000        	  6087:     move.b  (A0,D3.W),D0
                            	  6088:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  6089:     ;
02:00031606 4A02            	  6090:     cmpi.b  #$00,D2
02:00031608 6702            	  6091:     beq.s  __far_z_01_0053
