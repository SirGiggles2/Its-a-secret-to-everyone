                            	  7136: UpdateDodongoState0_Move:
                            	  7137:     ; If facing left, then push X offset 0 on the stack.
                            	  7138:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7139:     ;
                            	  7140:     ; We would like to use one set of coordinates only.
                            	  7141:     ; But movement would break down, if we did; because
                            	  7142:     ; Dodongo is so long.
                            	  7143:     ;
                            	  7144:     ; So, when not facing left, we temporarily shift the
                            	  7145:     ; X coordinate to be closer to the other side of the monster.
                            	  7146:     ;
02:0003C86C 7600            	  7147:     moveq   #0,D3
02:0003C86E 41EC0098        	  7148:     lea     ($0098,A4),A0
02:0003C872 10302000        	  7149:     move.b  (A0,D2.W),D0
02:0003C876 0200000D        	  7150:     andi.b #$0D,D0
02:0003C87A 6716            	  7151:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C87C 10342070        	  7152:     move.b  ($70,A4,D2.W),D0
02:0003C880 023C00EE        	  7153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C884 123C0010        	  7154:     move.b  #$10,D1
02:0003C888 D101            	  7155:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C88A 19802070        	  7156:     move.b  D0,($70,A4,D2.W)
02:0003C88E 163C00F0        	  7157:     move.b  #$F0,D3
                            	  7158:     even
                            	  7159: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C892 1003            	  7160:     move.b  D3,D0
02:0003C894 1B00            	  7161:     move.b  D0,-(A5)  ; PHA
02:0003C896 7020            	  7162:     moveq   #32,D0
02:0003C898 41EC041F        	  7163:     lea     ($041F,A4),A0
02:0003C89C 11802000        	  7164:     move.b  D0,(A0,D2.W)
02:0003C8A0 6100CEF4        	  7165:     jsr     Wanderer_TargetPlayer
                            	  7166:     ; Pop the offset and add it to the X coordinate.
                            	  7167:     ;
                            	  7168:     ; This brings the X coordinate back to the unique value
                            	  7169:     ; that represents the position.
                            	  7170:     ;
02:0003C8A4 101D            	  7171:     move.b  (A5)+,D0  ; PLA
02:0003C8A6 023C00EE        	  7172:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8AA 12342070        	  7173:     move.b  ($70,A4,D2.W),D1
02:0003C8AE D101            	  7174:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C8B0 19802070        	  7175:     move.b  D0,($70,A4,D2.W)
                            	  7176:     ; If X coordinate < $20, then face right.
                            	  7177:     ;
02:0003C8B4 0C000020        	  7178:     cmpi.b  #$20,D0
02:0003C8B8 640A            	  7179:     bcc  _anon_z04_89
02:0003C8BA 7001            	  7180:     moveq   #1,D0
02:0003C8BC 41EC0098        	  7181:     lea     ($0098,A4),A0
02:0003C8C0 11802000        	  7182:     move.b  D0,(A0,D2.W)
                            	  7183: _anon_z04_89:
02:0003C8C4 0A3C0001        	  7184:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C8C8 4E75            	  7185:     rts
