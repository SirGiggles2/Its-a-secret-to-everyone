02:00031D2E 1614            	  7056:     move.b  ($0000,A4),D3
02:00031D30 41EC00AC        	  7057:     lea     ($00AC,A4),A0
02:00031D34 10303000        	  7058:     move.b  (A0,D3.W),D0
