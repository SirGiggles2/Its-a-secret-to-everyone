                            	  6999: Aquamentus_Draw:
                            	  7000:     ; Every $10 screen frames, switch animation frames.
                            	  7001:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  7002:     ; The last tile of frame 0 is at index 5.
                            	  7003:     ; The last tile of frame 1 is at index $B.
                            	  7004:     ;
02:0003C768 7605            	  7005:     moveq   #5,D3
02:0003C76A 102C0015        	  7006:     move.b  ($0015,A4),D0
02:0003C76E 02000010        	  7007:     andi.b #$10,D0
02:0003C772 6602            	  7008:     bne  _anon_z04_88
02:0003C774 760B            	  7009:     moveq   #11,D3
                            	  7010: _anon_z04_88:
02:0003C776 1943000A        	  7011:     move.b  D3,($000A,A4)
                            	  7012:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  7013:     ;
02:0003C77A 7005            	  7014:     moveq   #5,D0
02:0003C77C 1940000B        	  7015:     move.b  D0,($000B,A4)
                            	  7016:     even
                            	  7017: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C780 7600            	  7018:     moveq   #0,D3
02:0003C782 162C000B        	  7019:     move.b  ($000B,A4),D3
                            	  7020:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  7021:     ; Store it in [00].
                            	  7022:     ;
02:0003C786 10342070        	  7023:     move.b  ($70,A4,D2.W),D0
02:0003C78A 023C00EE        	  7024:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C78E 41F90003C762    	  7025:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C794 12303000        	  7026:     move.b  (A0,D3.W),D1
02:0003C798 D101            	  7027:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C79A 1880            	  7028:     move.b  D0,($0000,A4)
                            	  7029:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  7030:     ; Store it in [01].
                            	  7031:     ;
02:0003C79C 41EC0084        	  7032:     lea     ($0084,A4),A0
02:0003C7A0 10302000        	  7033:     move.b  (A0,D2.W),D0
02:0003C7A4 023C00EE        	  7034:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7A8 41F90003C75C    	  7035:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C7AE 12303000        	  7036:     move.b  (A0,D3.W),D1
02:0003C7B2 D101            	  7037:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C7B4 19400001        	  7038:     move.b  D0,($0001,A4)
                            	  7039:     ; Calculate sprite attributes:
                            	  7040:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7041:     ;
                            	  7042:     ; If the boss is temporarily invincible, then
                            	  7043:     ; this makes it flash by cycling all the palette rows.
                            	  7044:     ;
                            	  7045:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7046:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7047:     ;
02:0003C7B8 41EC04F0        	  7048:     lea     ($04F0,A4),A0
02:0003C7BC 10302000        	  7049:     move.b  (A0,D2.W),D0
02:0003C7C0 02000003        	  7050:     andi.b #$03,D0
02:0003C7C4 0A000003        	  7051:     eori.b #$03,D0
02:0003C7C8 19400003        	  7052:     move.b  D0,($0003,A4)
02:0003C7CC 7600            	  7053:     moveq   #0,D3
02:0003C7CE 162C000A        	  7054:     move.b  ($000A,A4),D3
                            	  7055:     ; Look up the tile for this sprite.
                            	  7056:     ; If it's not the first one (face), then go write the sprite record.
                            	  7057:     ;
02:0003C7D2 41F90003C750    	  7058:     lea     (AquamentusTiles).l,A0
02:0003C7D8 10303000        	  7059:     move.b  (A0,D3.W),D0
02:0003C7DC 12390003C750    	  7060:     move.b  (AquamentusTiles).l,D1
02:0003C7E2 B001            	  7061:     cmp.b   D1,D0
02:0003C7E4 6610            	  7062:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7063:     ; Else it's the first one (the face tile).
                            	  7064:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7065:     ;
                            	  7066:     ; $CC/CD shows the closed mouth face.
                            	  7067:     ; $C0/C1 shows the open mouth face.
                            	  7068:     ;
02:0003C7E6 7600            	  7069:     moveq   #0,D3
02:0003C7E8 16342028        	  7070:     move.b  ($28,A4,D2.W),D3
02:0003C7EC 0C030020        	  7071:     cmpi.b  #$20,D3
02:0003C7F0 6404            	  7072:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C7F2 103C00C0        	  7073:     move.b  #$C0,D0
                            	  7074:     even
                            	  7075: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C7F6 610E            	  7076:     jsr     WriteBossSprite
                            	  7077:     ; Bottom of the loop.
                            	  7078:     ; Decrement tile index and loop index.
                            	  7079:     ;
02:0003C7F8 532C000A        	  7080:     subq.b  #1,($000A,A4)
02:0003C7FC 532C000B        	  7081:     subq.b  #1,($000B,A4)
02:0003C800 6A00FF7E        	  7082:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C804 4E75            	  7083:     rts
                            	  7084: 
