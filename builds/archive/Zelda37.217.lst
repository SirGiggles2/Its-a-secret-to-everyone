                            	  2748:     ; State 0. On the ground.
                            	  2749:     ;
                            	  2750:     ; If timer <> 0, then go animate, draw, and check collisions.
                            	  2751:     ;
02:0003A88C 10342028        	  2752:     move.b  ($28,A4,D2.W),D0
