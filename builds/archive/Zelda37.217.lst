02:00030ADE 0A3C0010        	  4636:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030AE2 9101            	  4637:     subx.b  D1,D0   ; SBC $04
02:00030AE4 0A3C0010        	  4638:     eori    #$10,CCR  ; restore X = 6502 C
02:00030AE8 0C000008        	  4639:     cmpi.b  #$08,D0
