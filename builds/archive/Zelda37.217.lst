02:0004CCC0 674C            	  6234:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  6235:     ; Decrement the state timer.
                            	  6236:     ; If it hasn't expired, go move the sword or rod.
                            	  6237:     ;
02:0004CCC2 41EC03D0        	  6238:     lea     ($03D0,A4),A0
