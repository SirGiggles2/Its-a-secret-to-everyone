02:0004478E 020000F0        	  7581:     andi.b #$F0,D0
                            	  7582:     ; Divide it by 4 to get the offset of the address of the column
                            	  7583:     ; in play area map.
                            	  7584:     ;
                            	  7585:     ; The calculation is: address offset = (X / 8) * 2
                            	  7586:     ; 8 for the width of the column; 2 for the width of the address
                            	  7587:     ;
02:00044792 E208            	  7588:     lsr.b  #1,D0   ; LSR A
02:00044794 E208            	  7589:     lsr.b  #1,D0   ; LSR A
