                            	  5911: _anon_z04_79:
                            	  5912:     ; Draw with sprite attributes: normal, red palette row
                            	  5913:     ;
02:0003BFA0 7002            	  5914:     moveq   #2,D0
02:0003BFA2 19400003        	  5915:     move.b  D0,($0003,A4)
02:0003BFA6 7044            	  5916:     moveq   #68,D0
02:0003BFA8 4EB9000318C6    	  5917:     jsr     Anim_WriteSprite
                            	  5918:     ; Check collisions, but never let them interfere with movement.
                            	  5919:     ;
02:0003BFAE 41EC0098        	  5920:     lea     ($0098,A4),A0
02:0003BFB2 10302000        	  5921:     move.b  (A0,D2.W),D0
02:0003BFB6 1B00            	  5922:     move.b  D0,-(A5)  ; PHA
02:0003BFB8 10342028        	  5923:     move.b  ($28,A4,D2.W),D0
02:0003BFBC 1B00            	  5924:     move.b  D0,-(A5)  ; PHA
02:0003BFBE 4EB900031946    	  5925:     jsr     CheckMonsterCollisions
02:0003BFC4 101D            	  5926:     move.b  (A5)+,D0  ; PLA
02:0003BFC6 19802028        	  5927:     move.b  D0,($28,A4,D2.W)
02:0003BFCA 101D            	  5928:     move.b  (A5)+,D0  ; PLA
02:0003BFCC 41EC0098        	  5929:     lea     ($0098,A4),A0
02:0003BFD0 11802000        	  5930:     move.b  D0,(A0,D2.W)
                            	  5931:     ; If this segment is still alive, then return.
                            	  5932:     ;
02:0003BFD4 41EC0405        	  5933:     lea     ($0405,A4),A0
02:0003BFD8 10302000        	  5934:     move.b  (A0,D2.W),D0
02:0003BFDC 6774            	  5935:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5936:     ; This segment is dead. We'll swap the tail segment with this
                            	  5937:     ; dead segment. This way, moldorm heads are always rooted
                            	  5938:     ; in slots 5 and $A; and the segments are continguous.
                            	  5939:     ;
                            	  5940:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5941:     ;
                            	  5942:     ; Note that this is not a true swap, because the tail's HP
                            	  5943:     ; might be less than $20.
                            	  5944:     ;
02:0003BFDE 7020            	  5945:     moveq   #32,D0
02:0003BFE0 41EC0485        	  5946:     lea     ($0485,A4),A0
02:0003BFE4 11802000        	  5947:     move.b  D0,(A0,D2.W)
02:0003BFE8 6100062A        	  5948:     jsr     CheckBossHitReaction
                            	  5949:     ; Look for the tail segment, starting from the low end
                            	  5950:     ; of the chain that this dead segment belongs to.
                            	  5951:     ;
