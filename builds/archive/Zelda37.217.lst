02:0003ED4E 705D            	 12100:     moveq   #93,D0
02:0003ED50 41EC0350        	 12101:     lea     ($0350,A4),A0
02:0003ED54 11803000        	 12102:     move.b  D0,(A0,D3.W)
02:0003ED58 4EF90004DB38    	 12103:     jmp     ResetObjMetastate
