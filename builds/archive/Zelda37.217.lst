                            	  6030: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  6031:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  6032:     ;
02:00043A08 101D            	  6033:     move.b  (A5)+,D0  ; PLA
02:00043A0A 1B00            	  6034:     move.b  D0,-(A5)  ; PHA
02:00043A0C 7400            	  6035:     moveq   #0,D2
02:00043A0E 1400            	  6036:     move.b  D0,D2
                            	  6037:     ; For each row (2 or 3) in the door, indexed by X,
                            	  6038:     ; starting from highest index down to 0:
                            	  6039:     ;
02:00043A10 41F9000438FE    	  6040:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043A16 10302000        	  6041:     move.b  (A0,D2.W),D0
02:00043A1A 7400            	  6042:     moveq   #0,D2
