02:0004C59C 60000082        	  5206:     jmp  SetShotSpreadingState
                            	  5207: __far_z_07_0078:
                            	  5208:     ; This is a magic shot.
                            	  5209:     ;
                            	  5210:     ; If missing the magic book, go deactivate the shot object.
                            	  5211:     ;
02:0004C5A0 102C0661        	  5212:     move.b  ($0661,A4),D0
02:0004C5A4 6602            	  5213:     bne.s  __far_z_07_0079
02:0004C5A6 6072            	  5214:     jmp  DeactivateShot
                            	  5215: __far_z_07_0079:
                            	  5216:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5217:     ; unused, so it only has to depend on having an empty slot.
                            	  5218:     ;
                            	  5219:     ; If successful, Link's state will have been changed to "using item".
                            	  5220:     ; But we don't want that in this case.
                            	  5221:     ;
                            	  5222:     ; For both these reasons, save state and restore it afterward.
                            	  5223:     ;
02:0004C5A8 102C00AC        	  5224:     move.b  ($00AC,A4),D0
02:0004C5AC 1B00            	  5225:     move.b  D0,-(A5)  ; PHA
02:0004C5AE 102C0513        	  5226:     move.b  ($0513,A4),D0
02:0004C5B2 1B00            	  5227:     move.b  D0,-(A5)  ; PHA
02:0004C5B4 7000            	  5228:     moveq   #0,D0
02:0004C5B6 19400513        	  5229:     move.b  D0,($0513,A4)
02:0004C5BA 4EB900030C4A    	  5230:     jsr     WieldCandle
02:0004C5C0 101D            	  5231:     move.b  (A5)+,D0  ; PLA
02:0004C5C2 19400513        	  5232:     move.b  D0,($0513,A4)
02:0004C5C6 101D            	  5233:     move.b  (A5)+,D0  ; PLA
02:0004C5C8 194000AC        	  5234:     move.b  D0,($00AC,A4)
                            	  5235:     ; State $21 means that a moving fire was just made.
                            	  5236:     ;
                            	  5237:     ; If it's any another value, then we didn't find an empty slot
                            	  5238:     ; to make a fire. In this case, all that's left to do is to go
                            	  5239:     ; deactivate the shot object.
                            	  5240:     ;
02:0004C5CC 41EC00AC        	  5241:     lea     ($00AC,A4),A0
02:0004C5D0 10302000        	  5242:     move.b  (A0,D2.W),D0
02:0004C5D4 0C000021        	  5243:     cmpi.b  #$21,D0
02:0004C5D8 6702            	  5244:     beq.s  __far_z_07_0080
02:0004C5DA 6038            	  5245:     jmp  DeactivateLinkShot
                            	  5246: __far_z_07_0080:
                            	  5247:     ; Make state $22 for a standing fire.
                            	  5248:     ;
02:0004C5DC 41EC00AC        	  5249:     lea     ($00AC,A4),A0
02:0004C5E0 52302000        	  5250:     addq.b  #1,(A0,D2.W)
                            	  5251:     ; Copy the shot's position and direction to the fire.
                            	  5252:     ;
02:0004C5E4 760E            	  5253:     moveq   #14,D3
02:0004C5E6 10343070        	  5254:     move.b  ($70,A4,D3.W),D0
02:0004C5EA 19802070        	  5255:     move.b  D0,($70,A4,D2.W)
02:0004C5EE 41EC0084        	  5256:     lea     ($0084,A4),A0
02:0004C5F2 10303000        	  5257:     move.b  (A0,D3.W),D0
02:0004C5F6 41EC0084        	  5258:     lea     ($0084,A4),A0
02:0004C5FA 11802000        	  5259:     move.b  D0,(A0,D2.W)
02:0004C5FE 41EC0098        	  5260:     lea     ($0098,A4),A0
02:0004C602 10303000        	  5261:     move.b  (A0,D3.W),D0
02:0004C606 41EC0098        	  5262:     lea     ($0098,A4),A0
02:0004C60A 11802000        	  5263:     move.b  D0,(A0,D2.W)
                            	  5264:     ; The fire lasts $4F frames.
                            	  5265:     ; Deactivate the shot.
                            	  5266:     ;
02:0004C60E 704F            	  5267:     moveq   #79,D0
02:0004C610 19802028        	  5268:     move.b  D0,($28,A4,D2.W)
                            	  5269:     even
