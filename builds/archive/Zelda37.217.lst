02:0003B2D6 123C0003        	  4239:     move.b  #$03,D1
02:0003B2DA 0A3C0010        	  4240:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B2DE 9101            	  4241:     subx.b  D1,D0   ; SBC #$03
02:0003B2E0 0A3C0010        	  4242:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B2E4 7600            	  4243:     moveq   #0,D3
02:0003B2E6 1600            	  4244:     move.b  D0,D3
02:0003B2E8 102C0396        	  4245:     move.b  ($0396,A4),D0
02:0003B2EC 41F90003B2B0    	  4246:     lea     (PondHeartStartAngles).l,A0
02:0003B2F2 12303000        	  4247:     move.b  (A0,D3.W),D1
02:0003B2F6 B001            	  4248:     cmp.b   D1,D0
02:0003B2F8 66000086        	  4249:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
