02:0002DC1E 7078            	   198:     moveq   #120,D0
02:0002DC20 163C0080        	   199:     move.b  #$80,D3
02:0002DC24 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
                            	   203:     ;
02:0002DC28 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DC2C 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DC30 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DC32 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DC36 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DC38 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DC3C 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DC3E 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DC42 6502            	   212:     bcs.s  __far_z_01_0000
02:0002DC44 6012            	   213:     jmp  InitCaveContinue
