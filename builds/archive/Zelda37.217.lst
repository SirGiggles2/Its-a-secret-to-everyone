                            	  6030:     ; If timer has not expired, then
                            	  6031:     ; go see if it's time to propagate direction changes down the chain.
                            	  6032:     ;
02:0003C086 10342028        	  6033:     move.b  ($28,A4,D2.W),D0
02:0003C08A 6702            	  6034:     beq.s  __far_z_04_0045
