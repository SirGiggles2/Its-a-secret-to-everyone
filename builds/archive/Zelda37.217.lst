                            	  6038: Moldorm_ChangeFlyingState:
                            	  6039:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  6040:     ;
02:0003C08E 61000096        	  6041:     jsr     Flyer_MoldormDecideState
02:0003C092 7010            	  6042:     moveq   #16,D0
02:0003C094 19802028        	  6043:     move.b  D0,($28,A4,D2.W)
                            	  6044:     ; If the next lower slot's direction <> 0, then
                            	  6045:     ; go propagate direction changes down the chain.
                            	  6046:     ;
                            	  6047:     ; But you had to have propagated directions once for the
                            	  6048:     ; next lower direction to be set. How does it happen?
                            	  6049:     ;
                            	  6050:     ; Within a flyer state, the flying routines turn the flyer
                            	  6051:     ; and set the object timer to $10 several times. After any of
                            	  6052:     ; those times will the test succeed.
                            	  6053:     ;
                            	  6054:     ; When a flying state ends, timer will be 0, triggering the code
                            	  6055:     ; in this block to set the timer to $10, and try to propagate
                            	  6056:     ; directions.
                            	  6057:     ;
                            	  6058:     ; But this is also the case the first time here.
                            	  6059:     ;
                            	  6060:     ; So, I believe that the point of this test is to delay moving
                            	  6061:     ; the lower (not head) segments when starting out.
                            	  6062:     ;
02:0003C098 41EC0097        	  6063:     lea     ($0097,A4),A0
02:0003C09C 10302000        	  6064:     move.b  (A0,D2.W),D0
02:0003C0A0 6702            	  6065:     beq.s  __far_z_04_0046
02:0003C0A2 601C            	  6066:     jmp  Moldorm_PropagateDirs
                            	  6067: __far_z_04_0046:
02:0003C0A4 4E75            	  6068:     rts
                            	  6069: 
                            	  6070:     even
                            	  6071: Moldorm_Wander:
