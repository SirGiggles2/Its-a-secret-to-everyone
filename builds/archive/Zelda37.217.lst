                            	  2782: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2783:     ; Set state 1 to jump.
                            	  2784:     ;
02:0003A8CA 41EC00AC        	  2785:     lea     ($00AC,A4),A0
