                            	   379: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   380:     ; The submenu map's rotation < 8.
                            	   381:     ; It represents the number of tiles to move right.
                            	   382:     ; So, multiply it by 8.
                            	   383:     ;
02:000402C6 E308            	   384:     lsl.b  #1,D0   ; ASL A
02:000402C8 E308            	   385:     lsl.b  #1,D0   ; ASL A
02:000402CA E308            	   386:     lsl.b  #1,D0   ; ASL A
                            	   387:     even
                            	   388: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   389:     ; Add the offset we calculated, and $62 to [00] to get
                            	   390:     ; the position marker's X coordinate.
                            	   391:     ;
02:000402CC 023C00EE        	   392:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402D0 1214            	   393:     move.b  ($0000,A4),D1
02:000402D2 D101            	   394:     addx.b  D1,D0   ; ADC $00
02:000402D4 023C00EE        	   395:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402D8 123C0062        	   396:     move.b  #$62,D1
02:000402DC D101            	   397:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:000402DE 19400253        	   398:     move.b  D0,($0253,A4)
                            	   399:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   400:     ; Divide by 2 to get a multiple of the tile height.
                            	   401:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   402:     ;
02:000402E2 102C00EB        	   403:     move.b  ($00EB,A4),D0
02:000402E6 020000F0        	   404:     andi.b #$F0,D0
02:000402EA E208            	   405:     lsr.b  #1,D0   ; LSR A
02:000402EC 123C0069        	   406:     move.b  #$69,D1
02:000402F0 D101            	   407:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:000402F2 19400250        	   408:     move.b  D0,($0250,A4)
                            	   409:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   410:     ;
02:000402F6 703E            	   411:     moveq   #62,D0
02:000402F8 19400251        	   412:     move.b  D0,($0251,A4)
02:000402FC 7000            	   413:     moveq   #0,D0
02:000402FE 19400252        	   414:     move.b  D0,($0252,A4)
                            	   415:     even
