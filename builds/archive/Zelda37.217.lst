02:0003D11A 10302000        	  8349:     move.b  (A0,D2.W),D0
02:0003D11E 4EB9000315C6    	  8350:     jsr     DrawObjectMirrored
                            	  8351:     ; Check collisions. If Link was not captured, then return.
                            	  8352:     ;
