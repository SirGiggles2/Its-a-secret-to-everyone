                            	  6853: HarmLink:
02:00031BBE 610005C4        	  6854:     jsr     BeginShove
                            	  6855:     ; Flag collision with [0C], even though [06] was already set.
                            	  6856:     ;
02:00031BC2 522C000C        	  6857:     addq.b  #1,($000C,A4)
                            	  6858:     ; Unpack the damage points for the monster's type.
                            	  6859:     ; The low nibble is the high byte.
                            	  6860:     ; (Damage points byte AND $F0) is the low byte.
                            	  6861:     ;
02:00031BC6 7600            	  6862:     moveq   #0,D3
02:00031BC8 41EC034F        	  6863:     lea     ($034F,A4),A0
02:00031BCC 16302000        	  6864:     move.b  (A0,D2.W),D3
02:00031BD0 41F900031A32    	  6865:     lea     (ObjTypeToDamagePoints).l,A0
02:00031BD6 10303000        	  6866:     move.b  (A0,D3.W),D0
02:00031BDA 1B00            	  6867:     move.b  D0,-(A5)  ; PHA
02:00031BDC 0200000F        	  6868:     andi.b #$0F,D0
02:00031BE0 1940000D        	  6869:     move.b  D0,($000D,A4)
02:00031BE4 101D            	  6870:     move.b  (A5)+,D0  ; PLA
02:00031BE6 020000F0        	  6871:     andi.b #$F0,D0
02:00031BEA 1940000E        	  6872:     move.b  D0,($000E,A4)
                            	  6873: ; Params:
                            	  6874: ; X: object index of the attacker
                            	  6875: ; [0D]: damage points high byte
                            	  6876: ; [0E]: damage points low byte
                            	  6877: ;
                            	  6878: ;
                            	  6879: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6880: ;
                            	  6881:     even
