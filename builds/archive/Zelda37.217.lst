                            	   463: UpdateMenuScrollUp:
                            	   464:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   465:     ;
02:0004036C 103C00FD        	   466:     move.b  #$FD,D0
02:00040370 613A            	   467:     jsr     MovePositionMarkers
02:00040372 102C00FC        	   468:     move.b  ($00FC,A4),D0
02:00040376 023C00EE        	   469:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004037A 123C0003        	   470:     move.b  #$03,D1
02:0004037E D101            	   471:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00040380 194000FC        	   472:     move.b  D0,($00FC,A4)
                            	   473:     ; If hardware vertical scroll still < $F0, then return.
                            	   474:     ;
02:00040384 0C0000F0        	   475:     cmpi.b  #$F0,D0
02:00040388 6406            	   476:     bcc.s  __far_z_05_0004
02:0004038A 4EF90002CF0A    	   477:     jmp  Exit
                            	   478: __far_z_05_0004:
                            	   479:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   480:     ;
02:00040390 1940005C        	   481:     move.b  D0,($005C,A4)
                            	   482:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   483:     ;
                            	   484:     ; UNKNOWN: But why not do this in OW, too?
                            	   485:     ;
02:00040394 102C0010        	   486:     move.b  ($0010,A4),D0
02:00040398 6706            	   487:     beq  _anon_z05_4
02:0004039A 4EB9000312C0    	   488:     jsr     WriteBlankPrioritySprites
                            	   489: _anon_z05_4:
                            	   490:     ; We reached the end. So, reset hardware vertical scroll
                            	   491:     ; and submenu state.
                            	   492:     ;
02:000403A0 7000            	   493:     moveq   #0,D0
02:000403A2 194000FC        	   494:     move.b  D0,($00FC,A4)
02:000403A6 194000E1        	   495:     move.b  D0,($00E1,A4)
                            	   496:     ; Move the position markers 2 pixels down, because we
                            	   497:     ; overshot and reached vertical scroll $F2.
                            	   498:     ;
02:000403AA 7002            	   499:     moveq   #2,D0
                            	   500: ; Params:
                            	   501: ; A: vertical velocity of menu scrolling
                            	   502: ;
                            	   503: ;
                            	   504: ; [00] holds the vertical velocity of menu scrolling.
                            	   505:     even
                            	   506: MovePositionMarkers:
02:000403AC 1880            	   507:     move.b  D0,($0000,A4)
                            	   508:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   509:     ;
02:000403AE 102C0254        	   510:     move.b  ($0254,A4),D0
02:000403B2 0C0000F8        	   511:     cmpi.b  #$F8,D0
02:000403B6 670C            	   512:     beq  _anon_z05_5
02:000403B8 023C00EE        	   513:     andi    #$EE,CCR  ; CLC: clear C+X
02:000403BC 1214            	   514:     move.b  ($0000,A4),D1
02:000403BE D101            	   515:     addx.b  D1,D0   ; ADC $00
02:000403C0 19400254        	   516:     move.b  D0,($0254,A4)
