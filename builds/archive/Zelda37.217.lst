                            	  2856:     ; State 1. Jumping.
                            	  2857:     ;
                            	  2858:     ; Keep the object inside the bounds of the room.
                            	  2859:     ;
02:0003A94A 610053E0        	  2860:     jsr     BoundFlyer
                            	  2861:     ; If the object was blocked at the room boundary, then
                            	  2862:     ; increase boundary reversal count, and go set up another jump.
                            	  2863:     ;
02:0003A94E 102C000F        	  2864:     move.b  ($000F,A4),D0
02:0003A952 660C            	  2865:     bne  _anon_z04_37
02:0003A954 41EC0451        	  2866:     lea     ($0451,A4),A0
02:0003A958 52302000        	  2867:     addq.b  #1,(A0,D2.W)
02:0003A95C 6000FF74        	  2868:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2869: 
                            	  2870: _anon_z04_37:
02:0003A960 61000196        	  2871:     jsr     Jumper_PointBoulderDownward
                            	  2872:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2873:     ;
02:0003A964 7000            	  2874:     moveq   #0,D0
02:0003A966 41EC0451        	  2875:     lea     ($0451,A4),A0
02:0003A96A 11802000        	  2876:     move.b  D0,(A0,D2.W)
                            	  2877:     ; Get the base offset for the kind of jumper the object is.
                            	  2878:     ;
02:0003A96E 6100015E        	  2879:     jsr     Jumper_GetKind
02:0003A972 41F90003A85E    	  2880:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A978 10303000        	  2881:     move.b  (A0,D3.W),D0
                            	  2882:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2883:     ;
                            	  2884:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2885:     ; does not have $B elements like the tektites' sets.
                            	  2886:     ;
                            	  2887:     ; Boulder does not need the upward accelerations.
                            	  2888:     ; So, the elements for those are used for the starting speeds
                            	  2889:     ; at 04:88F2.
                            	  2890:     ;
02:0003A97C 023C00EE        	  2891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A980 41EC0098        	  2892:     lea     ($0098,A4),A0
02:0003A984 12302000        	  2893:     move.b  (A0,D2.W),D1
02:0003A988 D101            	  2894:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A98A 7600            	  2895:     moveq   #0,D3
02:0003A98C 1600            	  2896:     move.b  D0,D3
02:0003A98E 41F90003A83C    	  2897:     lea     (JumperYAccelerations).l,A0
02:0003A994 10303000        	  2898:     move.b  (A0,D3.W),D0
02:0003A998 7602            	  2899:     moveq   #2,D3
02:0003A99A 61000162        	  2900:     jsr     Jumper_MoveY
                            	  2901:     ; If the facing direction has a left component, then
                            	  2902:     ; subtract 1 from the object's X.
                            	  2903:     ;
                            	  2904:     ; Else add 1.
                            	  2905:     ;
02:0003A99E 163C00FF        	  2906:     move.b  #$FF,D3
02:0003A9A2 41EC0098        	  2907:     lea     ($0098,A4),A0
02:0003A9A6 10302000        	  2908:     move.b  (A0,D2.W),D0
02:0003A9AA 02000002        	  2909:     andi.b #$02,D0
02:0003A9AE 6602            	  2910:     bne  _anon_z04_38
02:0003A9B0 7601            	  2911:     moveq   #1,D3
                            	  2912: _anon_z04_38:
02:0003A9B2 1003            	  2913:     move.b  D3,D0
02:0003A9B4 023C00EE        	  2914:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9B8 12342070        	  2915:     move.b  ($70,A4,D2.W),D1
02:0003A9BC D101            	  2916:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A9BE 19802070        	  2917:     move.b  D0,($70,A4,D2.W)
                            	  2918:     ; If going up (negative v-speed high byte), then
                            	  2919:     ; go animate, draw, and check collisions.
                            	  2920:     ;
02:0003A9C2 41EC0412        	  2921:     lea     ($0412,A4),A0
02:0003A9C6 10302000        	  2922:     move.b  (A0,D2.W),D0
02:0003A9CA 6A04            	  2923:     bpl.s  __far_z_04_0024
