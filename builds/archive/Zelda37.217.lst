                            	 11998: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EC76 10342070        	 11999:     move.b  ($70,A4,D2.W),D0
02:0003EC7A 1B00            	 12000:     move.b  D0,-(A5)  ; PHA
                            	 12001:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 12002:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 12003:     ;
02:0003EC7C 023C00EE        	 12004:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EC80 123C0004        	 12005:     move.b  #$04,D1
02:0003EC84 D101            	 12006:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EC86 19802070        	 12007:     move.b  D0,($70,A4,D2.W)
                            	 12008:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 12009:     ; to store in [03].
                            	 12010:     ;
02:0003EC8A 102C04E6        	 12011:     move.b  ($04E6,A4),D0
02:0003EC8E 0A000003        	 12012:     eori.b #$03,D0
02:0003EC92 19400003        	 12013:     move.b  D0,($0003,A4)
                            	 12014:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 12015:     ;
02:0003EC96 103C009E        	 12016:     move.b  #$9E,D0
02:0003EC9A 0C020005        	 12017:     cmpi.b  #$05,D2
02:0003EC9E 670A            	 12018:     beq  _L_z04_UpdateLamnola_Draw
02:0003ECA0 0C02000A        	 12019:     cmpi.b  #$0A,D2
02:0003ECA4 6704            	 12020:     beq  _L_z04_UpdateLamnola_Draw
02:0003ECA6 103C00A0        	 12021:     move.b  #$A0,D0
                            	 12022:     even
                            	 12023: _L_z04_UpdateLamnola_Draw:
02:0003ECAA 4EB9000318C6    	 12024:     jsr     Anim_WriteSprite
02:0003ECB0 101D            	 12025:     move.b  (A5)+,D0  ; PLA
02:0003ECB2 19802070        	 12026:     move.b  D0,($70,A4,D2.W)
02:0003ECB6 41EC0098        	 12027:     lea     ($0098,A4),A0
02:0003ECBA 10302000        	 12028:     move.b  (A0,D2.W),D0
02:0003ECBE 1B00            	 12029:     move.b  D0,-(A5)  ; PHA
02:0003ECC0 4EB900031946    	 12030:     jsr     CheckMonsterCollisions
02:0003ECC6 101D            	 12031:     move.b  (A5)+,D0  ; PLA
02:0003ECC8 41EC0098        	 12032:     lea     ($0098,A4),A0
02:0003ECCC 11802000        	 12033:     move.b  D0,(A0,D2.W)
                            	 12034:     ; If still alive, then return.
                            	 12035:     ;
02:0003ECD0 41EC0405        	 12036:     lea     ($0405,A4),A0
02:0003ECD4 10302000        	 12037:     move.b  (A0,D2.W),D0
02:0003ECD8 6604            	 12038:     bne.s  __far_z_04_0120
02:0003ECDA 6000FF72        	 12039:     jmp  L129EA_Exit
                            	 12040: __far_z_04_0120:
                            	 12041:     ; Otherwise, the segment is dead.
                            	 12042:     ;
02:0003ECDE 4EB90004BC9E    	 12043:     jsr     ResetShoveInfo
                            	 12044:     ; Set the current segment's HP to the initial value in anticipation
                            	 12045:     ; of bringing this segment back to life.
                            	 12046:     ;
02:0003ECE4 7020            	 12047:     moveq   #32,D0
02:0003ECE6 41EC0485        	 12048:     lea     ($0485,A4),A0
02:0003ECEA 11802000        	 12049:     move.b  D0,(A0,D2.W)
                            	 12050:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 12051:     ;
                            	 12052:     ; From the lowest slot, look for one that has the original lamnola
                            	 12053:     ; object type.
                            	 12054:     ;
                            	 12055:     ; The goal is to swap the current dead segment with the tail segment.
                            	 12056:     ;
02:0003ECEE 163C00FF        	 12057:     move.b  #$FF,D3
02:0003ECF2 0C020006        	 12058:     cmpi.b  #$06,D2
02:0003ECF6 6502            	 12059:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003ECF8 7604            	 12060:     moveq   #4,D3
                            	 12061:     even
                            	 12062: _L_z04_UpdateLamnola_FindTail:
02:0003ECFA 5203            	 12063:     addq.b  #1,D3
02:0003ECFC 41EC0350        	 12064:     lea     ($0350,A4),A0
02:0003ED00 10303000        	 12065:     move.b  (A0,D3.W),D0
02:0003ED04 122C04E7        	 12066:     move.b  ($04E7,A4),D1
02:0003ED08 B001            	 12067:     cmp.b   D1,D0
02:0003ED0A 66EE            	 12068:     bne  _L_z04_UpdateLamnola_FindTail
                            	 12069:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 12070:     ;
02:0003ED0C 7011            	 12071:     moveq   #17,D0
02:0003ED0E 19803029        	 12072:     move.b  D0,($29,A4,D3.W)
                            	 12073:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 12074:     ; to the tail segment.
                            	 12075:     ;
02:0003ED12 41EC04F0        	 12076:     lea     ($04F0,A4),A0
02:0003ED16 10302000        	 12077:     move.b  (A0,D2.W),D0
02:0003ED1A 41EC04F1        	 12078:     lea     ($04F1,A4),A0
02:0003ED1E 11803000        	 12079:     move.b  D0,(A0,D3.W)
02:0003ED22 10342070        	 12080:     move.b  ($70,A4,D2.W),D0
02:0003ED26 19803071        	 12081:     move.b  D0,($71,A4,D3.W)
02:0003ED2A 41EC0084        	 12082:     lea     ($0084,A4),A0
02:0003ED2E 10302000        	 12083:     move.b  (A0,D2.W),D0
02:0003ED32 41EC0085        	 12084:     lea     ($0085,A4),A0
02:0003ED36 11803000        	 12085:     move.b  D0,(A0,D3.W)
                            	 12086:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 12087:     ; So, return and leave it dead.
                            	 12088:     ;
02:0003ED3A 0C030004        	 12089:     cmpi.b  #$04,D3
02:0003ED3E 6604            	 12090:     bne.s  __far_z_04_0121
02:0003ED40 6000FF0C        	 12091:     jmp  L129EA_Exit
                            	 12092: __far_z_04_0121:
