02:000323EA 5202            	   127:     addq.b  #1,D2
                            	   128:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:000323EC 41F900032398    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:000323F2 10302000        	   130:     move.b  (A0,D2.W),D0
02:000323F6 19400003        	   131:     move.b  D0,($0003,A4)
02:000323FA 41F90003239E    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:00032400 10302000        	   133:     move.b  (A0,D2.W),D0
02:00032404 611C            	   134:     jsr     TransferPatternBlock_Bank2
