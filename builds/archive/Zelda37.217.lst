02:0003F110 1214            	 12654:     move.b  ($0000,A4),D1
02:0003F112 0A3C0010        	 12655:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F116 9101            	 12656:     subx.b  D1,D0   ; SBC $00
02:0003F118 0A3C0010        	 12657:     eori    #$10,CCR  ; restore X = 6502 C
