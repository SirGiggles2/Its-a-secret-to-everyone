                            	  4644:     ; Otherwise, go to the next speed index (angle).
                            	  4645:     ;
02:00030AEE 1014            	  4646:     move.b  ($0000,A4),D0
02:00030AF0 023C00EE        	  4647:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030AF4 122C0001        	  4648:     move.b  ($0001,A4),D1
02:00030AF8 D101            	  4649:     addx.b  D1,D0   ; ADC $01
02:00030AFA 1880            	  4650:     move.b  D0,($0000,A4)
                            	  4651:     ; TODO: call it speed index or angle?
                            	  4652:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4653:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4654:     ;
02:00030AFC 6728            	  4655:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030AFE 0C000008        	  4656:     cmpi.b  #$08,D0
02:00030B02 6722            	  4657:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4658:     ; Subtract the lesser distance from the greater distance.
                            	  4659:     ; If they still haven't crossed, then we can turn more.
                            	  4660:     ;
02:00030B04 102C0003        	  4661:     move.b  ($0003,A4),D0
02:00030B08 003C0011        	  4662:     ori     #$11,CCR  ; SEC: set C+X
02:00030B0C 122C0004        	  4663:     move.b  ($0004,A4),D1
02:00030B10 0A3C0010        	  4664:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B14 9101            	  4665:     subx.b  D1,D0   ; SBC $04
02:00030B16 0A3C0010        	  4666:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B1A 19400003        	  4667:     move.b  D0,($0003,A4)
02:00030B1E 122C0004        	  4668:     move.b  ($0004,A4),D1
02:00030B22 B001            	  4669:     cmp.b   D1,D0
02:00030B24 64C8            	  4670:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4671:     even
