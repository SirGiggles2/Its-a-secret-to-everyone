                            	  6293: _L_z07_UpdateSwordOrRod_Add4:
                            	  6294:     ; Set [00] to (state - 1) * 4:
                            	  6295:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6296:     ;
02:0004CD30 023C00EE        	  6297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CD34 123C0004        	  6298:     move.b  #$04,D1
02:0004CD38 D101            	  6299:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004CD3A 5303            	  6300:     subq.b  #1,D3
02:0004CD3C 66F2            	  6301:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004CD3E 1880            	  6302:     move.b  D0,($0000,A4)
                            	  6303:     ; Set object's direction to player's. It might have changed
                            	  6304:     ; since the last frame.
                            	  6305:     ;
02:0004CD40 102C0098        	  6306:     move.b  ($0098,A4),D0
02:0004CD44 41EC0098        	  6307:     lea     ($0098,A4),A0
02:0004CD48 11802000        	  6308:     move.b  D0,(A0,D2.W)
                            	  6309:     ; Add [00] and the reverse index of the direction to get
                            	  6310:     ; the byte offset of the pixel offset.
                            	  6311:     ;
02:0004CD4C 4EB900030A00    	  6312:     jsr     GetOppositeDir
02:0004CD52 1003            	  6313:     move.b  D3,D0
02:0004CD54 023C00EE        	  6314:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CD58 1214            	  6315:     move.b  ($0000,A4),D1
02:0004CD5A D101            	  6316:     addx.b  D1,D0   ; ADC $00
02:0004CD5C 7600            	  6317:     moveq   #0,D3
02:0004CD5E 1600            	  6318:     move.b  D0,D3
                            	  6319:     ; Set object's X to player's X + offset for state and direction.
                            	  6320:     ; Copy the result to [00].
                            	  6321:     ;
02:0004CD60 102C0070        	  6322:     move.b  ($0070,A4),D0
