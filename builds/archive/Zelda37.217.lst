02:0003BC90 6718            	  5546:     beq  _L_z04_UpdateRope_CheckSpeed
02:0003BC92 10342028        	  5547:     move.b  ($28,A4,D2.W),D0
02:0003BC96 6612            	  5548:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003BC98 10342018        	  5549:     move.b  ($18,A4,D2.W),D0
