02:0003B9D6 16302000        	  5197:     move.b  (A0,D2.W),D3
02:0003B9DA 41F90003B80C    	  5198:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003B9E0 10303000        	  5199:     move.b  (A0,D3.W),D0
02:0003B9E4 0200000F        	  5200:     andi.b #$0F,D0
02:0003B9E8 41EC0098        	  5201:     lea     ($0098,A4),A0
