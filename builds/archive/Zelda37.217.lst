                            	  2520: SummonWhirlwind:
                            	  2521:     ; If not in mode 5, return.
                            	  2522:     ;
02:0002FCCE 102C0012        	  2523:     move.b  ($0012,A4),D0
02:0002FCD2 0C000005        	  2524:     cmpi.b  #$05,D0
02:0002FCD6 6704            	  2525:     beq.s  __far_z_01_0016
02:0002FCD8 60000094        	  2526:     jmp  L6104_Exit
                            	  2527: __far_z_01_0016:
                            	  2528:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2529:     ;
02:0002FCDC 6178            	  2530:     jsr     AdvanceTeleportingLevelIndex
02:0002FCDE 102C0523        	  2531:     move.b  ($0523,A4),D0
02:0002FCE2 02000007        	  2532:     andi.b #$07,D0
02:0002FCE6 7600            	  2533:     moveq   #0,D3
02:0002FCE8 1600            	  2534:     move.b  D0,D3
02:0002FCEA 41F90004AE74    	  2535:     lea     (LevelMasks).l,A0
02:0002FCF0 10303000        	  2536:     move.b  (A0,D3.W),D0
02:0002FCF4 1880            	  2537:     move.b  D0,($0000,A4)
                            	  2538:     even
                            	  2539: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2540:     ; If there are no triforce pieces, then return.
                            	  2541:     ;
02:0002FCF6 102C0671        	  2542:     move.b  ($0671,A4),D0
02:0002FCFA 6602            	  2543:     bne.s  __far_z_01_0017
02:0002FCFC 6070            	  2544:     jmp  L6104_Exit
                            	  2545: __far_z_01_0017:
                            	  2546:     ; If we have gotten this triforce piece, then go try to make a
                            	  2547:     ; whirlwind.
                            	  2548:     ;
02:0002FCFE 1214            	  2549:     move.b  ($0000,A4),D1
02:0002FD00 C200            	  2550:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FD02 662C            	  2551:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2552:     ; We have not gotten this piece.
                            	  2553:     ; First, advance the teleporting index again.
                            	  2554:     ;
02:0002FD04 6150            	  2555:     jsr     AdvanceTeleportingLevelIndex
                            	  2556:     ; If the direction Link is facing is an increasing one, then
                            	  2557:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2558:     ; level number. Then go test this new mask.
                            	  2559:     ;
02:0002FD06 102C0098        	  2560:     move.b  ($0098,A4),D0
02:0002FD0A 02000009        	  2561:     andi.b #$09,D0
02:0002FD0E 6710            	  2562:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FD10 1214            	  2563:     move.b  ($0000,A4),D1
02:0002FD12 E309            	  2564:     lsl.b  #1,D1   ; ASL $00
02:0002FD14 1881            	  2565:     move.b  D1,($0000,A4)
02:0002FD16 64DE            	  2566:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FD18 1214            	  2567:     move.b  ($0000,A4),D1
02:0002FD1A E311            	  2568:     roxl.b  #1,D1   ; ROL $00
02:0002FD1C 1881            	  2569:     move.b  D1,($0000,A4)
02:0002FD1E 60D6            	  2570:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2571: 
                            	  2572:     even
                            	  2573: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2574:     ; If instead the direction is a decreasing one, then
                            	  2575:     ; rotate right to correspond to the lower level number.
                            	  2576:     ; Then go test this new mask.
                            	  2577:     ;
02:0002FD20 1214            	  2578:     move.b  ($0000,A4),D1
02:0002FD22 E209            	  2579:     lsr.b  #1,D1   ; LSR $00
02:0002FD24 1881            	  2580:     move.b  D1,($0000,A4)
02:0002FD26 64CE            	  2581:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FD28 1214            	  2582:     move.b  ($0000,A4),D1
02:0002FD2A E211            	  2583:     roxr.b  #1,D1   ; ROR $00
02:0002FD2C 1881            	  2584:     move.b  D1,($0000,A4)
02:0002FD2E 60C6            	  2585:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2586: 
                            	  2587:     even
                            	  2588: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  2589:     ; If already summoned or in the middle of teleporting, then
                            	  2590:     ; return and don't summon another one.
                            	  2591:     ;
02:0002FD30 102C0508        	  2592:     move.b  ($0508,A4),D0
02:0002FD34 122C0522        	  2593:     move.b  ($0522,A4),D1
02:0002FD38 8001            	  2594:     or.b  D1,D0
02:0002FD3A 6702            	  2595:     beq.s  __far_z_01_0018
02:0002FD3C 6030            	  2596:     jmp  L6104_Exit
                            	  2597: __far_z_01_0018:
                            	  2598:     ; Return if we can't find an empty monster slot.
                            	  2599:     ;
02:0002FD3E 4EB90004DB20    	  2600:     jsr     FindEmptyMonsterSlot
02:0002FD44 6602            	  2601:     bne.s  __far_z_01_0019
02:0002FD46 6026            	  2602:     jmp  L6104_Exit
                            	  2603: __far_z_01_0019:
                            	  2604:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  2605:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  2606:     ;
02:0002FD48 522C0508        	  2607:     addq.b  #1,($0508,A4)
02:0002FD4C 1003            	  2608:     move.b  D3,D0
02:0002FD4E 7400            	  2609:     moveq   #0,D2
02:0002FD50 1400            	  2610:     move.b  D0,D2
02:0002FD52 6000FE9C        	  2611:     jmp     SetUpWhirlwind
                            	  2612: 
                            	  2613:     even
                            	  2614: AdvanceTeleportingLevelIndex:
                            	  2615:     ; If Link is facing an increasing direction (right or down), then
                            	  2616:     ; increase the index. Otherwise, decrease it.
                            	  2617:     ;
02:0002FD56 522C0523        	  2618:     addq.b  #1,($0523,A4)
02:0002FD5A 102C0098        	  2619:     move.b  ($0098,A4),D0
02:0002FD5E 02000009        	  2620:     andi.b #$09,D0
02:0002FD62 6702            	  2621:     beq.s  __far_z_01_0020
02:0002FD64 6008            	  2622:     jmp  L6104_Exit
