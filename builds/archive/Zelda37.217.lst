                            	  3680: _L_z04_UpdateOctorock_SaveOffset:
02:0003AF8E 1B00            	  3681:     move.b  D0,-(A5)  ; PHA
                            	  3682:     ; Decrement the animation counter, and roll over if needed.
                            	  3683:     ;
02:0003AF90 41EC03D0        	  3684:     lea     ($03D0,A4),A0
02:0003AF94 53302000        	  3685:     subq.b  #1,(A0,D2.W)
02:0003AF98 661E            	  3686:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003AF9A 7006            	  3687:     moveq   #6,D0
02:0003AF9C 41EC03D0        	  3688:     lea     ($03D0,A4),A0
02:0003AFA0 11802000        	  3689:     move.b  D0,(A0,D2.W)
                            	  3690:     ; There are actually 6 frame images divided into 2 sets.
                            	  3691:     ; Each set depicts one animation frame. In each set there are
                            	  3692:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3693:     ;
                            	  3694:     ; The movement frame will keep track of the base offset of
                            	  3695:     ; the current set for the current animation frame: 0 or 3.
                            	  3696:     ;
                            	  3697:     ; So, XOR the movement frame with 3.
                            	  3698:     ;
02:0003AFA4 E208            	  3699:     lsr.b  #1,D0   ; LSR A
02:0003AFA6 41EC03E4        	  3700:     lea     ($03E4,A4),A0
02:0003AFAA 12302000        	  3701:     move.b  (A0,D2.W),D1
02:0003AFAE B300            	  3702:     eor.b  D1,D0
02:0003AFB0 41EC03E4        	  3703:     lea     ($03E4,A4),A0
02:0003AFB4 11802000        	  3704:     move.b  D0,(A0,D2.W)
                            	  3705:     even
                            	  3706: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3707:     ; Add the base offset and the directional offset, and save the result.
                            	  3708:     ;
02:0003AFB8 101D            	  3709:     move.b  (A5)+,D0  ; PLA
02:0003AFBA 023C00EE        	  3710:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFBE 41EC03E4        	  3711:     lea     ($03E4,A4),A0
02:0003AFC2 12302000        	  3712:     move.b  (A0,D2.W),D1
02:0003AFC6 D101            	  3713:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AFC8 1B00            	  3714:     move.b  D0,-(A5)  ; PHA
                            	  3715:     ; If facing vertically, go draw mirrored.
                            	  3716:     ;
02:0003AFCA 41EC0098        	  3717:     lea     ($0098,A4),A0
02:0003AFCE 10302000        	  3718:     move.b  (A0,D2.W),D0
02:0003AFD2 0200000C        	  3719:     andi.b #$0C,D0
02:0003AFD6 660E            	  3720:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3721:     ; Else draw not mirrored.
                            	  3722:     ;
02:0003AFD8 101D            	  3723:     move.b  (A5)+,D0  ; PLA
02:0003AFDA 4EB9000315CA    	  3724:     jsr     DrawObjectNotMirrored
02:0003AFE0 4EF900031946    	  3725:     jmp     CheckMonsterCollisions
                            	  3726: 
                            	  3727:     even
