                            	  1635:     ; Check collisions.
                            	  1636:     ;
                            	  1637:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1638:     ; then return.
                            	  1639:     ;
02:0003A164 610001F8        	  1640:     jsr     Gel_CheckCollisions
02:0003A168 41EC0405        	  1641:     lea     ($0405,A4),A0
02:0003A16C 10302000        	  1642:     move.b  (A0,D2.W),D0
02:0003A170 664E            	  1643:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A172 41EC04F0        	  1644:     lea     ($04F0,A4),A0
02:0003A176 10302000        	  1645:     move.b  (A0,D2.W),D0
02:0003A17A 6744            	  1646:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1647:     ; If vertically aligned with the square grid, then
                            	  1648:     ; use a horizontal direction mask (3).
                            	  1649:     ;
                            	  1650:     ; Keep in mind that most objects are aligned vertically when
                            	  1651:     ; the low nibble of their Y is $D.
                            	  1652:     ;
02:0003A17C 7600            	  1653:     moveq   #0,D3
02:0003A17E 41EC0084        	  1654:     lea     ($0084,A4),A0
02:0003A182 10302000        	  1655:     move.b  (A0,D2.W),D0
02:0003A186 0200000F        	  1656:     andi.b #$0F,D0
02:0003A18A 0C00000D        	  1657:     cmpi.b  #$0D,D0
02:0003A18E 6602            	  1658:     bne  _anon_z04_26
02:0003A190 7603            	  1659:     moveq   #3,D3
                            	  1660: _anon_z04_26:
02:0003A192 1883            	  1661:     move.b  D3,($0000,A4)
                            	  1662:     ; If horizontally aligned with the square grid, then
                            	  1663:     ; use a vertical direction mask ($C).
                            	  1664:     ;
02:0003A194 7600            	  1665:     moveq   #0,D3
02:0003A196 10342070        	  1666:     move.b  ($70,A4,D2.W),D0
02:0003A19A 0200000F        	  1667:     andi.b #$0F,D0
02:0003A19E 6602            	  1668:     bne  _anon_z04_27
02:0003A1A0 760C            	  1669:     moveq   #12,D3
                            	  1670: _anon_z04_27:
02:0003A1A2 1003            	  1671:     move.b  D3,D0
                            	  1672:     ; Combine the two masks. At most one will be 0.
                            	  1673:     ;
02:0003A1A4 1214            	  1674:     move.b  ($0000,A4),D1
02:0003A1A6 8001            	  1675:     or.b  D1,D0
                            	  1676:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1677:     ; with the grid.
                            	  1678:     ;
                            	  1679:     ; If so, then go to state 1 to do a "big shove".
                            	  1680:     ; Else go to state 2, to immediately split in two.
                            	  1681:     ;
                            	  1682:     ; Examples:
                            	  1683:     ; It would be aligned, if moving left along a tile as usual.
                            	  1684:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1685:     ; - The collision check routines would have made the zol
                            	  1686:     ;   face in the direction of the weapon.
                            	  1687:     ; - See CheckMonsterWeaponCollision.
                            	  1688:     ;
02:0003A1A8 122C0098        	  1689:     move.b  ($0098,A4),D1
02:0003A1AC C001            	  1690:     and.b  D1,D0
02:0003A1AE 6608            	  1691:     bne  _anon_z04_28
02:0003A1B0 41EC00AC        	  1692:     lea     ($00AC,A4),A0
02:0003A1B4 52302000        	  1693:     addq.b  #1,(A0,D2.W)
                            	  1694: _anon_z04_28:
02:0003A1B8 41EC00AC        	  1695:     lea     ($00AC,A4),A0
02:0003A1BC 52302000        	  1696:     addq.b  #1,(A0,D2.W)
