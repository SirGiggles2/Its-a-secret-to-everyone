                            	 11581:     ; The animation timer has expired. There are two choices for arming it.
                            	 11582:     ;
                            	 11583:     ; When writhing after a hit, Gleeok animates faster.
                            	 11584:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11585:     ; Otherwise, set a longer time ($10).
                            	 11586:     ;
