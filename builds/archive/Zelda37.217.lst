                            	  3265: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3266:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3267:     ; the mound frame images:
                            	  3268:     ;
                            	  3269:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3270:     ;
                            	  3271:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3272:     ;
                            	  3273:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3274:     ;
02:0003AC76 003C0011        	  3275:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC7A 123C0001        	  3276:     move.b  #$01,D1
02:0003AC7E 0A3C0010        	  3277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC82 9101            	  3278:     subx.b  D1,D0   ; SBC #$01
02:0003AC84 0A3C0010        	  3279:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC88 E308            	  3280:     lsl.b  #1,D0   ; ASL A
02:0003AC8A 023C00EE        	  3281:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC8E 41EC03E4        	  3282:     lea     ($03E4,A4),A0
02:0003AC92 12302000        	  3283:     move.b  (A0,D2.W),D1
02:0003AC96 D101            	  3284:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
