02:00043694 7600            	  5521:     moveq   #0,D3
02:00043696 162C00EB        	  5522:     move.b  ($00EB,A4),D3
02:0004369A 41F900FF68FE    	  5523:     lea     (NES_SRAM+$08FE).l,A0
