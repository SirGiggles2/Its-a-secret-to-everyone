                            	  5484:     ; If the template object type in the room is one of:
                            	  5485:     ; moblin, goriya, octorock, vire, keese
                            	  5486:     ; then attract these monsters to the food.
                            	  5487:     ;
                            	  5488:     ; They will chase the food instead of Link when given a chance.
                            	  5489:     ;
02:0004C782 102C035F        	  5490:     move.b  ($035F,A4),D0
