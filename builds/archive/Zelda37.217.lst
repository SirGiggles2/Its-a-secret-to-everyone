02:0004CD7A 102C0084        	  6332:     move.b  ($0084,A4),D0
02:0004CD7E 023C00EE        	  6333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CD82 41F90004CCA4    	  6334:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004CD88 12303000        	  6335:     move.b  (A0,D3.W),D1
02:0004CD8C D101            	  6336:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004CD8E 41EC0084        	  6337:     lea     ($0084,A4),A0
02:0004CD92 11802000        	  6338:     move.b  D0,(A0,D2.W)
02:0004CD96 19400001        	  6339:     move.b  D0,($0001,A4)
