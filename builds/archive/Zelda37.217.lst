02:0003B070 4EB9000315CA    	  3829:     jsr     DrawObjectNotMirrored
02:0003B076 4EF900031A90    	  3830:     jmp     CheckLinkCollision
                            	  3831: 
                            	  3832:     even
                            	  3833: SecretArmosRoomIds:
02:0003B07C 24              	  3834:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B07D 0B
02:0003B07E 1C
02:0003B07F 22
02:0003B080 34
02:0003B081 3D
02:0003B082 4E
                            	  3835: 
                            	  3836:     even
                            	  3837: SecretArmosXs:
02:0003B084 E0              	  3838:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B085 B0
02:0003B086 B0
02:0003B087 30
02:0003B088 40
02:0003B089 90
02:0003B08A A0
                            	  3839: 
                            	  3840:     even
                            	  3841: InitArmosOrFlyingGhini:
                            	  3842:     ; In UpdateObject, this object was flagged "initialized".
                            	  3843:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3844:     ;
02:0003B08C 10342028        	  3845:     move.b  ($28,A4,D2.W),D0
02:0003B090 41EC0492        	  3846:     lea     ($0492,A4),A0
02:0003B094 11802000        	  3847:     move.b  D0,(A0,D2.W)
                            	  3848:     ; If it's still fading in, then go finish some initialization needed
                            	  3849:     ; for fading in.
                            	  3850:     ;
02:0003B098 660000B6        	  3851:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3852:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3853:     ; go finish initializing it.
                            	  3854:     ;
02:0003B09C 41EC034F        	  3855:     lea     ($034F,A4),A0
02:0003B0A0 10302000        	  3856:     move.b  (A0,D2.W),D0
02:0003B0A4 0C000022        	  3857:     cmpi.b  #$22,D0
02:0003B0A8 670000A6        	  3858:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3859:     ; Else we have an armos.
                            	  3860:     ;
                            	  3861:     ; Store stairs tile $70 in [00] for use later.
                            	  3862:     ;
02:0003B0AC 7070            	  3863:     moveq   #112,D0
02:0003B0AE 1880            	  3864:     move.b  D0,($0000,A4)
                            	  3865:     ; Look for the current room ID in an array of room ID's that
                            	  3866:     ; have armos secrets.
                            	  3867:     ;
02:0003B0B0 7606            	  3868:     moveq   #6,D3
                            	  3869:     even
                            	  3870: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B0B2 102C00EB        	  3871:     move.b  ($00EB,A4),D0
                            	  3872:     ; If this element does not match the current room ID, go loop again.
                            	  3873:     ;
02:0003B0B6 41F90003B07C    	  3874:     lea     (SecretArmosRoomIds).l,A0
02:0003B0BC 12303000        	  3875:     move.b  (A0,D3.W),D1
02:0003B0C0 B001            	  3876:     cmp.b   D1,D0
02:0003B0C2 6648            	  3877:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3878:     ; The secret (usually stairs) is under one of the armoses.
                            	  3879:     ;
                            	  3880:     ; If the armos's X coordinate does not match the one needed
                            	  3881:     ; for the current room in the list, then go loop again.
                            	  3882:     ;
02:0003B0C4 10342070        	  3883:     move.b  ($70,A4,D2.W),D0
02:0003B0C8 41F90003B084    	  3884:     lea     (SecretArmosXs).l,A0
02:0003B0CE 12303000        	  3885:     move.b  (A0,D3.W),D1
02:0003B0D2 B001            	  3886:     cmp.b   D1,D0
02:0003B0D4 6636            	  3887:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3888:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3889:     ;
02:0003B0D6 41EC0084        	  3890:     lea     ($0084,A4),A0
02:0003B0DA 10302000        	  3891:     move.b  (A0,D2.W),D0
02:0003B0DE 0C000080        	  3892:     cmpi.b  #$80,D0
02:0003B0E2 6628            	  3893:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3894:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3895:     ;
02:0003B0E4 4A03            	  3896:     cmpi.b  #$00,D3
02:0003B0E6 662C            	  3897:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3898:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3899:     ; has the power bracelet.
                            	  3900:     ;
                            	  3901:     ; Set up the room item with the armos's coordinates.
                            	  3902:     ;
02:0003B0E8 19400097        	  3903:     move.b  D0,($0097,A4)
02:0003B0EC 10342070        	  3904:     move.b  ($70,A4,D2.W),D0
02:0003B0F0 19400083        	  3905:     move.b  D0,($0083,A4)
                            	  3906:     ; This resets the room item's state, which activates it.
                            	  3907:     ;
02:0003B0F4 194300BF        	  3908:     move.b  D3,($00BF,A4)
                            	  3909:     ; Set the room item ID.
                            	  3910:     ;
02:0003B0F8 7014            	  3911:     moveq   #20,D0
02:0003B0FA 194000AB        	  3912:     move.b  D0,($00AB,A4)
                            	  3913:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3914:     ;
                            	  3915:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3916:     ;
                            	  3917:     ; Note that, if the item was already taken, then the room item
                            	  3918:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3919:     ; it will be ignored, because that routine checks whether
                            	  3920:     ; the item was taken.
                            	  3921:     ;
02:0003B0FE 4EB900030EFC    	  3922:     jsr     GetRoomFlagUWItemState
02:0003B104 660A            	  3923:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B106 610006FE        	  3924:     jsr     PlaySecretFoundTune
02:0003B10A 6604            	  3925:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3926:     even
                            	  3927: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3928:     ; Bottom of the loop.
                            	  3929:     ;
02:0003B10C 5303            	  3930:     subq.b  #1,D3
02:0003B10E 6AA2            	  3931:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3932:     even
                            	  3933: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3934:     ; Not found, or found the power bracelet.
                            	  3935:     ; Use a floor tile $26 to replace the armos.
                            	  3936:     ;
02:0003B110 7026            	  3937:     moveq   #38,D0
02:0003B112 1880            	  3938:     move.b  D0,($0000,A4)
                            	  3939:     even
                            	  3940: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B114 1014            	  3941:     move.b  ($0000,A4),D0
                            	  3942:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3943:     ;
02:0003B116 1B00            	  3944:     move.b  D0,-(A5)  ; PHA
02:0003B118 0C000070        	  3945:     cmpi.b  #$70,D0
02:0003B11C 6604            	  3946:     bne  _anon_z04_51
02:0003B11E 610006E6        	  3947:     jsr     PlaySecretFoundTune
                            	  3948: _anon_z04_51:
                            	  3949:     ; Replace the tile where the armos was.
                            	  3950:     ;
02:0003B122 522C00F7        	  3951:     addq.b  #1,($00F7,A4)
02:0003B126 101D            	  3952:     move.b  (A5)+,D0  ; PLA
02:0003B128 4EB90004B144    	  3953:     jsr     ChangeTileObjTiles
                            	  3954:     ; Because the armos object is aligned to the square grid
                            	  3955:     ; (because it was made from a square),
                            	  3956:     ; set its grid offset to 3 to compensate.
                            	  3957:     ;
                            	  3958:     ; Most objects are aligned to the grid vertically when the
                            	  3959:     ; low nibble is $D.
                            	  3960:     ;
02:0003B12E 7003            	  3961:     moveq   #3,D0
02:0003B130 41EC0394        	  3962:     lea     ($0394,A4),A0
02:0003B134 11802000        	  3963:     move.b  D0,(A0,D2.W)
                            	  3964:     ; Set a speed (q-speed fraction) randomly:
                            	  3965:     ; $20 if random value < $80
