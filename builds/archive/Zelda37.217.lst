02:00040264 0A3C0010        	   330:     eori    #$10,CCR  ; restore X = 6502 C
02:00040268 194000FC        	   331:     move.b  D0,($00FC,A4)
                            	   332:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   333:     ;
02:0004026C 0C000041        	   334:     cmpi.b  #$41,D0
02:00040270 66000090        	   335:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   336:     ; VScroll reached $41.
