                            	  5449: UpdateBoomerangOrFood:
                            	  5450:     ; If state = 0, then not active. So, return.
                            	  5451:     ;
02:0004C746 41EC00AC        	  5452:     lea     ($00AC,A4),A0
02:0004C74A 10302000        	  5453:     move.b  (A0,D2.W),D0
02:0004C74E 6602            	  5454:     bne.s  __far_z_07_0082
02:0004C750 60F2            	  5455:     jmp  L1F49F_Exit
                            	  5456: __far_z_07_0082:
                            	  5457:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5458:     ;
02:0004C752 E308            	  5459:     lsl.b  #1,D0   ; ASL A
02:0004C754 6504            	  5460:     bcs.s  __far_z_07_0083
02:0004C756 600000AA        	  5461:     jmp  UpdateArrowOrBoomerang
                            	  5462: __far_z_07_0083:
                            	  5463:     ; The object is food.
                            	  5464:     ;
                            	  5465:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5466:     ; If we reach state $83, then go deactivate the object.
                            	  5467:     ;
                            	  5468:     ; Nothing changes between the states. So, they are used as
                            	  5469:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5470:     ;
02:0004C75A 10342028        	  5471:     move.b  ($28,A4,D2.W),D0
02:0004C75E 6622            	  5472:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004C760 41EC00AC        	  5473:     lea     ($00AC,A4),A0
02:0004C764 52302000        	  5474:     addq.b  #1,(A0,D2.W)
02:0004C768 41EC00AC        	  5475:     lea     ($00AC,A4),A0
02:0004C76C 10302000        	  5476:     move.b  (A0,D2.W),D0
02:0004C770 0200000F        	  5477:     andi.b #$0F,D0
02:0004C774 0C000003        	  5478:     cmpi.b  #$03,D0
02:0004C778 674C            	  5479:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004C77A 103C00FF        	  5480:     move.b  #$FF,D0
02:0004C77E 19802028        	  5481:     move.b  D0,($28,A4,D2.W)
                            	  5482:     even
