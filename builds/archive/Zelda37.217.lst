                            	   342: ;------------------------------------------------------------------------------
                            	   343: ; _c_move_object_shim — MoveObject trampoline.
                            	   344: ;
                            	   345: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   346: ;   Input:     D2 = slot (0..11)
                            	   347: ;   Preserves: D2, A4, A5
                            	   348: ;   Clobbers:  D0, D1, D3, A0
                            	   349: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   350: ;
                            	   351: ; GCC side:
                            	   352: ;   void c_move_object(unsigned short slot);
                            	   353: ;     slot arrives as a 16-bit value on the stack.
                            	   354: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   355: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   356: ;   never clobbered by gcc.
                            	   357: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   358: ;   semantics can exist in a pure C port).
                            	   359: ;------------------------------------------------------------------------------
                            	   360: _c_move_object_shim:
                            	   361:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   362:     move.b  #$AA,($0900,A4)
                            	   363:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   364:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   365:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   366:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   367:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   368:     moveq   #0,D0
02:0002B658 3002            	   369:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   370:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   371:     jsr     c_move_object
02:0002B662 588F            	   372:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   373:     rts
                            	   374: 
                            	   375: ;==============================================================================
                            	   376: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   377: ; and tail-call the native asm function.
                            	   378: ;
                            	   379: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   380: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   381: ; sign-extended).
                            	   382: ;==============================================================================
                            	   383: 
                            	   384: ;------------------------------------------------------------------------------
                            	   385: ; void c_copy_bank_to_window(unsigned int bank);
                            	   386: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   387: ;------------------------------------------------------------------------------
                            	   388: c_copy_bank_to_window:
02:0002B666 202F0004        	   389:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   390:     jmp     _copy_bank_to_window
                            	   391: 
                            	   392: ;------------------------------------------------------------------------------
                            	   393: ; unsigned char c_ppu_read_2(void);
                            	   394: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   395: ; C return: gcc expects result in D0.
                            	   396: ;------------------------------------------------------------------------------
                            	   397: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   398:     jmp     _ppu_read_2
                            	   399: 
                            	   400: ;------------------------------------------------------------------------------
                            	   401: ; void c_ppu_write_6(unsigned int val);
                            	   402: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   403: ;------------------------------------------------------------------------------
                            	   404: c_ppu_write_6:
02:0002B674 202F0004        	   405:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   406:     jmp     _ppu_write_6
                            	   407: 
                            	   408: ;------------------------------------------------------------------------------
                            	   409: ; void c_ppu_write_7(unsigned int val);
                            	   410: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   411: ;------------------------------------------------------------------------------
                            	   412: c_ppu_write_7:
02:0002B67E 202F0004        	   413:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   414:     jmp     _ppu_write_7
                            	   415: 
