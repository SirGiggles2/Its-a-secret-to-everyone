02:0003C2B2 023C00EE        	  6414:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2B6 41F90003C152    	  6415:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C2BC 12303000        	  6416:     move.b  (A0,D3.W),D1
02:0003C2C0 D101            	  6417:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C2C2 41EC0084        	  6418:     lea     ($0084,A4),A0
02:0003C2C6 11802000        	  6419:     move.b  D0,(A0,D2.W)
