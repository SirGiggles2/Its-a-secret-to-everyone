02:00031B02 102C0070        	  6747:     move.b  ($0070,A4),D0
02:00031B06 023C00EE        	  6748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031B0A 123C0008        	  6749:     move.b  #$08,D1
02:00031B0E D101            	  6750:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031B10 19400004        	  6751:     move.b  D0,($0004,A4)
02:00031B14 102C0084        	  6752:     move.b  ($0084,A4),D0
02:00031B18 023C00EE        	  6753:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031B1C 123C0008        	  6754:     move.b  #$08,D1
02:00031B20 D101            	  6755:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
