02:0003AFE6 101D            	  3729:     move.b  (A5)+,D0  ; PLA
                            	  3730: ; Params:
                            	  3731: ; A: frame image
                            	  3732: ; X: object index
                            	  3733: ; [00]: object X
                            	  3734: ; [01]: object Y
                            	  3735: ;
                            	  3736:     even
