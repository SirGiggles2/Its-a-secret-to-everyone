02:0003AF6C 7600            	  3657:     moveq   #0,D3
02:0003AF6E 1600            	  3658:     move.b  D0,D3
02:0003AF70 0200000C        	  3659:     andi.b #$0C,D0
02:0003AF74 670C            	  3660:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AF76 7002            	  3661:     moveq   #2,D0
