                            	  5789: WriteBlankPrioritySprites:
                            	  5790:     ; UNKNOWN: Why are their Y coordinates $3D and $DD?
                            	  5791:     ; Those values are the highest and lowest that Link can normally take.
                            	  5792:     ;
                            	  5793:     ; Repeat two sprites in the first $10 records. They have
                            	  5794:     ; transparent tile $1C, priority 1 (behind BG), and X=0.
                            	  5795:     ; The first of the pair has Y=$3D, and the second one has Y=$DD.
                            	  5796:     ;
                            	  5797:     ; These sprites are first in the list. So they are used for things
                            	  5798:     ; that must be shown above everything else, including Link.
                            	  5799:     ;
02:000312C0 7600            	  5800:     moveq   #0,D3
02:000312C2 7400            	  5801:     moveq   #0,D2
