                            	  8583: ; Description:
                            	  8584: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8585: ; When walking, the object timer is set. When teleporting,
                            	  8586: ; the teleporting distance remaining is set.
                            	  8587: ;
                            	  8588: ; If we have the magic clock, then only go draw and check collisions.
                            	  8589: ;
                            	  8590:     even
                            	  8591: UpdateBlueWizzrobe:
02:0003D30A 102C066C        	  8592:     move.b  ($066C,A4),D0
