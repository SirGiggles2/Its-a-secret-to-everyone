02:0004CC90 6000FB70        	  6203:     jmp     UpdateArrowOrBoomerang
                            	  6204: 
                            	  6205: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  6206: ; Each set contains 4 offsets in reverse direction index order:
                            	  6207: ; up, down, left, right
                            	  6208: ;
                            	  6209: ; These offsets are added to player X to get weapon X.
                            	  6210: ;
                            	  6211:     even
                            	  6212: PlayerToWeaponOffsetsX:
02:0004CC94 FF              	  6213:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004CC95 01
02:0004CC96 00
02:0004CC97 F8
02:0004CC98 FF
02:0004CC99 01
02:0004CC9A F5
02:0004CC9B 0B
02:0004CC9C FF              	  6214:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004CC9D 01
02:0004CC9E F9
02:0004CC9F 07
02:0004CCA0 FF
02:0004CCA1 01
02:0004CCA2 FD
02:0004CCA3 03
                            	  6215: 
                            	  6216: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  6217: ; Each set contains 4 offsets in reverse direction index order:
                            	  6218: ; up, down, left, right
                            	  6219: ;
                            	  6220: ; These offsets are added to player Y to get weapon Y.
                            	  6221: ;
                            	  6222:     even
                            	  6223: PlayerToWeaponOffsetsY:
02:0004CCA4 F7              	  6224:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:0004CCA5 F2
02:0004CCA6 F5
02:0004CCA7 F5
02:0004CCA8 F6
02:0004CCA9 0D
02:0004CCAA 03
02:0004CCAB 03
02:0004CCAC F7              	  6225:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:0004CCAD 09
02:0004CCAE 03
02:0004CCAF 03
02:0004CCB0 FF
02:0004CCB1 05
02:0004CCB2 03
02:0004CCB3 03
