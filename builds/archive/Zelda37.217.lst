                            	  2788: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2789:     ; If reversal count >= 2, then
                            	  2790:     ; 1. invert the horizontal component of facing direction,
                            	  2791:     ;    to face away from the chase target
                            	  2792:     ; 2. reset the reversal count to 0.
                            	  2793:     ;
                            	  2794:     ; This prevents a jumper from getting stuck in a corner.
                            	  2795:     ;
                            	  2796:     ; For example, if a tektite's direction is down and right,
                            	  2797:     ; and jumps into the top right corner of the room:
                            	  2798:     ; 1. The right room boundary is hit. So the direction is
                            	  2799:     ;    automatically reversed to up and left.
                            	  2800:     ; 2. The next frame, the top room boundary is hit.
                            	  2801:     ;    The direction is reversed to down and right.
                            	  2802:     ;
                            	  2803:     ; As you can see, an endless loop has been made.
                            	  2804:     ;
02:0003A8D2 41EC0451        	  2805:     lea     ($0451,A4),A0
02:0003A8D6 10302000        	  2806:     move.b  (A0,D2.W),D0
02:0003A8DA 0C000002        	  2807:     cmpi.b  #$02,D0
02:0003A8DE 651E            	  2808:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A8E0 41EC0098        	  2809:     lea     ($0098,A4),A0
02:0003A8E4 10302000        	  2810:     move.b  (A0,D2.W),D0
02:0003A8E8 0A000003        	  2811:     eori.b #$03,D0
02:0003A8EC 41EC0098        	  2812:     lea     ($0098,A4),A0
02:0003A8F0 11802000        	  2813:     move.b  D0,(A0,D2.W)
02:0003A8F4 7000            	  2814:     moveq   #0,D0
02:0003A8F6 41EC0451        	  2815:     lea     ($0451,A4),A0
02:0003A8FA 11802000        	  2816:     move.b  D0,(A0,D2.W)
                            	  2817:     even
                            	  2818: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2819:     ; If the object is a boulder, then make sure its facing direction
                            	  2820:     ; has a down vertical component.
                            	  2821:     ;
02:0003A8FE 610001F8        	  2822:     jsr     Jumper_PointBoulderDownward
                            	  2823:     ; For the given direction, get the Y offset of the destination
                            	  2824:     ; of the jump.
                            	  2825:     ;
                            	  2826:     ; Add it to the object's Y, and store this destination Y.
                            	  2827:     ;
02:0003A902 7600            	  2828:     moveq   #0,D3
02:0003A904 41EC0098        	  2829:     lea     ($0098,A4),A0
02:0003A908 16302000        	  2830:     move.b  (A0,D2.W),D3
02:0003A90C 41EC0084        	  2831:     lea     ($0084,A4),A0
02:0003A910 10302000        	  2832:     move.b  (A0,D2.W),D0
02:0003A914 023C00EE        	  2833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A918 41F90003A830    	  2834:     lea     (JumperYOffsets).l,A0
02:0003A91E 12303000        	  2835:     move.b  (A0,D3.W),D1
02:0003A922 D101            	  2836:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A924 41EC0444        	  2837:     lea     ($0444,A4),A0
02:0003A928 11802000        	  2838:     move.b  D0,(A0,D2.W)
                            	  2839:     ; Set the starting speed, depending on the object type.
                            	  2840:     ;
02:0003A92C 610001A0        	  2841:     jsr     Jumper_GetKind
02:0003A930 41F90003A85A    	  2842:     lea     (JumperStartSpeedsHi).l,A0
02:0003A936 10303000        	  2843:     move.b  (A0,D3.W),D0
02:0003A93A 41EC0412        	  2844:     lea     ($0412,A4),A0
02:0003A93E 11802000        	  2845:     move.b  D0,(A0,D2.W)
                            	  2846:     ; Reset the vertical speed low byte.
                            	  2847:     ; Then go animate, draw, and check collisions.
                            	  2848:     ;
02:0003A942 6100022E        	  2849:     jsr     Jumper_ResetVSpeedFrac
