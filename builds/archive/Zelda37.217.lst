02:0003C80E 41F900031592    	  7097:     lea     (SpriteOffsets).l,A0
02:0003C814 10303000        	  7098:     move.b  (A0,D3.W),D0
02:0003C818 7600            	  7099:     moveq   #0,D3
02:0003C81A 1600            	  7100:     move.b  D0,D3
02:0003C81C 101D            	  7101:     move.b  (A5)+,D0  ; PLA
02:0003C81E 41EC0201        	  7102:     lea     ($0201,A4),A0
02:0003C822 11803000        	  7103:     move.b  D0,(A0,D3.W)
02:0003C826 1014            	  7104:     move.b  ($0000,A4),D0
02:0003C828 41EC0203        	  7105:     lea     ($0203,A4),A0
02:0003C82C 11803000        	  7106:     move.b  D0,(A0,D3.W)
02:0003C830 102C0001        	  7107:     move.b  ($0001,A4),D0
02:0003C834 4EF900031910    	  7108:     jmp     Anim_EndWriteSprite
