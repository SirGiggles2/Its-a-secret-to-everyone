                            	 14443: TurnTowardsPlayer8:
                            	 14444:     ; Build a direction in [00] towards the player.
                            	 14445:     ;
                            	 14446:     ; First, calculate a horizontal component:
                            	 14447:     ;
                            	 14448:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14449:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14450:     ; else                               [00] := 2 (left)
                            	 14451:     ;
02:0003FDD8 7600            	 14452:     moveq   #0,D3
