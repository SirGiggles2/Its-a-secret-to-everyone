02:00034DFE 0A3C0010        	  2795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E02 9101            	  2796:     subx.b  D1,D0   ; SBC #$08
02:00034E04 0A3C0010        	  2797:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E08 7600            	  2798:     moveq   #0,D3
02:00034E0A 1600            	  2799:     move.b  D0,D3
02:00034E0C 102C0015        	  2800:     move.b  ($0015,A4),D0
