02:00031B82 12302000        	  6809:     move.b  (A0,D2.W),D1
02:00031B86 8001            	  6810:     or.b  D1,D0
02:00031B88 02000003        	  6811:     andi.b #$03,D0
02:00031B8C 0C000003        	  6812:     cmpi.b  #$03,D0
