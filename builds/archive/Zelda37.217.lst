02:0003CE54 020000FC        	  8016:     andi.b #$FC,D0
02:0003CE58 0C0000B0        	  8017:     cmpi.b  #$B0,D0
02:0003CE5C 6742            	  8018:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CE5E 0C0000F4        	  8019:     cmpi.b  #$F4,D0
