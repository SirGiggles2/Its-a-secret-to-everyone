                            	  4339: PlayerScreenEdgeBounds:
02:0004C030 3D              	  4340:     dc.b    $3D, $DD, $00, $F0
02:0004C031 DD
02:0004C032 00
02:0004C033 F0
                            	  4341: 
                            	  4342: ; Params:
                            	  4343: ; [0E]: $FF, if blocked by a door
                            	  4344: ; [0F]: movement direction
                            	  4345: ;
                            	  4346: ; Returns:
                            	  4347: ; [0F]: untouched, or changed if blocked or need to change
                            	  4348: ;
                            	  4349: ; Summary:
                            	  4350: ;
                            	  4351: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4352: ; Then allow movement or go to the next room. Otherwise,
                            	  4353: ; check passive tile objects and stop moving.
                            	  4354: ;
                            	  4355: ; For other objects: First, if moving, test the colliding tile for
                            	  4356: ; walkability. Otherwise search for a walkable direction starting
                            	  4357: ; from input direction.
                            	  4358: ;
                            	  4359: ; When you find a walkable direction, see if it makes the object
                            	  4360: ; cross a boundary. If it doesn't, then make this direction
                            	  4361: ; the objection direction. Otherwise, keep looping.
                            	  4362: ;
                            	  4363: ; If no walkable direction is found, then stop moving.
                            	  4364: ;
                            	  4365: ;
                            	  4366: ; if is player
                            	  4367: ;   if at doorway
                            	  4368: ;     go handle a walkable direction
                            	  4369: ;   if blocked by door
                            	  4370: ;     return
                            	  4371: ;
                            	  4372:     even
                            	  4373: Walker_CheckTileCollision:
                            	  4374:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4375:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4376:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4377:     ; reset) for Link and every other object. Only the tile
                            	  4378:     ; walkability decision in CheckTiles is overridden.
02:0004C034 4A02            	  4379:     cmpi.b  #$00,D2
02:0004C036 6614            	  4380:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004C038 102C0053        	  4381:     move.b  ($0053,A4),D0
02:0004C03C 6704            	  4382:     beq  _anon_z07_16
02:0004C03E 600000BE        	  4383:     jmp     GoWalkableDir
                            	  4384: 
                            	  4385: _anon_z07_16:
02:0004C042 102C000E        	  4386:     move.b  ($000E,A4),D0
02:0004C046 6A04            	  4387:     bpl.s  __far_z_07_0051
02:0004C048 600000AC        	  4388:     jmp  L1F148_Exit
                            	  4389: __far_z_07_0051:
                            	  4390:     even
                            	  4391: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4392:     ; If grid offset <> 0, return.
                            	  4393:     ;
02:0004C04C 41EC0394        	  4394:     lea     ($0394,A4),A0
02:0004C050 10302000        	  4395:     move.b  (A0,D2.W),D0
02:0004C054 6704            	  4396:     beq.s  __far_z_07_0052
02:0004C056 6000009E        	  4397:     jmp  L1F148_Exit
                            	  4398: __far_z_07_0052:
                            	  4399:     ; Grid offset = 0.
                            	  4400:     ; The object is at a point between cells in the grid.
                            	  4401:     ; So, we can check tiles for collision.
                            	  4402:     ;
                            	  4403:     ; Reset [0E] alternate direction search step.
                            	  4404:     ;
02:0004C05A 1940000E        	  4405:     move.b  D0,($000E,A4)
                            	  4406:     ; If there's a movement direction, go check tile collision.
                            	  4407:     ;
02:0004C05E 102C000F        	  4408:     move.b  ($000F,A4),D0
02:0004C062 6702            	  4409:     beq.s  __far_z_07_0053
02:0004C064 602E            	  4410:     jmp  CheckTiles
                            	  4411: __far_z_07_0053:
                            	  4412:     ; Moving direction = 0.
                            	  4413:     ; If object is the player, return.
                            	  4414:     ;
02:0004C066 4A02            	  4415:     cmpi.b  #$00,D2
02:0004C068 6604            	  4416:     bne.s  __far_z_07_0054
02:0004C06A 6000008A        	  4417:     jmp  L1F148_Exit
                            	  4418: __far_z_07_0054:
                            	  4419:     ; Moving direction = 0.
                            	  4420:     ; The object is not the player.
                            	  4421:     ;
                            	  4422:     ; If object does not have attribute $10, then
                            	  4423:     ; set movement direction to input direction,
                            	  4424:     ; and go try to turn to an unblocked direction in order to move.
                            	  4425:     ;
02:0004C06E 41EC04BF        	  4426:     lea     ($04BF,A4),A0
02:0004C072 10302000        	  4427:     move.b  (A0,D2.W),D0
02:0004C076 02000010        	  4428:     andi.b #$10,D0
02:0004C07A 6702            	  4429:     beq.s  __far_z_07_0055
02:0004C07C 600E            	  4430:     jmp  Reverse
                            	  4431: __far_z_07_0055:
02:0004C07E 41EC03F8        	  4432:     lea     ($03F8,A4),A0
02:0004C082 10302000        	  4433:     move.b  (A0,D2.W),D0
02:0004C086 1940000F        	  4434:     move.b  D0,($000F,A4)
02:0004C08A 6038            	  4435:     jmp     TryNextDir
                            	  4436: 
