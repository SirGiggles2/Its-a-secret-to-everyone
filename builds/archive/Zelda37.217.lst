02:00036416 10303000        	  4902:     move.b  (A0,D3.W),D0
02:0003641A 41EC0302        	  4903:     lea     ($0302,A4),A0
02:0003641E 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:00036422 5303            	  4905:     subq.b  #1,D3
02:00036424 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:00036426 7600            	  4910:     moveq   #0,D3
02:00036428 162C0413        	  4911:     move.b  ($0413,A4),D3
02:0003642C 41F9000363C6    	  4912:     lea     (PeaceText).l,A0
02:00036432 10303000        	  4913:     move.b  (A0,D3.W),D0
02:00036436 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:0003643A 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:0003643C 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
