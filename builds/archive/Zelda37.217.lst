02:0003E6E0 6602            	 11265:     bne.s  __far_z_04_0107
02:0003E6E2 60B0            	 11266:     jmp  Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions
                            	 11267: __far_z_04_0107:
                            	 11268:     ; The segment is not a head nor bottom. So, we can use a
                            	 11269:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11270:     ; that is drawn under Link and the heads.
                            	 11271:     ;
02:0003E6E4 4EB9000318C0    	 11272:     jsr     Anim_WriteLevelPaletteSprite
                            	 11273:     even
                            	 11274: Gleeok_CheckCollisions:
                            	 11275:     ; If this segment is not the head nor the bottom of the neck,
                            	 11276:     ; then loop again to process the next segment.
                            	 11277:     ;
                            	 11278:     ; This kind of segment is only drawn, and is not checked
                            	 11279:     ; for object collisions.
                            	 11280:     ;
02:0003E6EA 0C020005        	 11281:     cmpi.b  #$05,D2
02:0003E6EE 670A            	 11282:     beq  _anon_z04_141
02:0003E6F0 0C020001        	 11283:     cmpi.b  #$01,D2
02:0003E6F4 6704            	 11284:     beq  _anon_z04_141
02:0003E6F6 6000010C        	 11285:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11286: 
                            	 11287: _anon_z04_141:
02:0003E6FA 4EB900031946    	 11288:     jsr     CheckMonsterCollisions
                            	 11289:     ; If this segment was harmed, then set the writhing counter,
                            	 11290:     ; and the animation counter to its lower value.
                            	 11291:     ;
02:0003E700 41EC00C0        	 11292:     lea     ($00C0,A4),A0
02:0003E704 10302000        	 11293:     move.b  (A0,D2.W),D0
02:0003E708 670A            	 11294:     beq  _anon_z04_142
02:0003E70A 7006            	 11295:     moveq   #6,D0
02:0003E70C 194004E6        	 11296:     move.b  D0,($04E6,A4)
02:0003E710 19400510        	 11297:     move.b  D0,($0510,A4)
                            	 11298: _anon_z04_142:
02:0003E714 4EB90004BC9E    	 11299:     jsr     ResetShoveInfo
                            	 11300:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11301:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11302:     ;
02:0003E71A 0C020001        	 11303:     cmpi.b  #$01,D2
02:0003E71E 670000DE        	 11304:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E722 6100AF74        	 11305:     jsr     PlayBossHitCryIfNeeded
                            	 11306:     ; If this neck has not died, then go loop again.
                            	 11307:     ;
02:0003E726 41EC0405        	 11308:     lea     ($0405,A4),A0
02:0003E72A 10302000        	 11309:     move.b  (A0,D2.W),D0
02:0003E72E 670000D4        	 11310:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11311:     ; This neck died. So, prepare to make a flying head.
                            	 11312:     ;
02:0003E732 7060            	 11313:     moveq   #96,D0
02:0003E734 41EC0485        	 11314:     lea     ($0485,A4),A0
02:0003E738 11802000        	 11315:     move.b  D0,(A0,D2.W)
02:0003E73C 1002            	 11316:     move.b  D2,D0
02:0003E73E 1B00            	 11317:     move.b  D0,-(A5)  ; PHA
                            	 11318:     ; If the segment is not a head, then skip making a flying head.
                            	 11319:     ;
                            	 11320:     ; TODO:
                            	 11321:     ; But how can we get here in this case, since earlier branches
                            	 11322:     ; would have been taken to skip all this for all other segments?
                            	 11323:     ;
02:0003E740 0C020005        	 11324:     cmpi.b  #$05,D2
02:0003E744 663C            	 11325:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11326:     ; The flying head will go in slot (neck index + 7).
                            	 11327:     ; Switch the X register to it.
                            	 11328:     ;
02:0003E746 102C04D7        	 11329:     move.b  ($04D7,A4),D0
02:0003E74A 023C00EE        	 11330:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E74E 123C0007        	 11331:     move.b  #$07,D1
02:0003E752 D101            	 11332:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E754 7400            	 11333:     moveq   #0,D2
02:0003E756 1400            	 11334:     move.b  D0,D2
                            	 11335:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11336:     ;
02:0003E758 103C00FF        	 11337:     move.b  #$FF,D0
02:0003E75C 41EC0492        	 11338:     lea     ($0492,A4),A0
02:0003E760 11802000        	 11339:     move.b  D0,(A0,D2.W)
                            	 11340:     ; Copy the original head's coordinates to it.
                            	 11341:     ;
02:0003E764 102C0075        	 11342:     move.b  ($0075,A4),D0
02:0003E768 19802070        	 11343:     move.b  D0,($70,A4,D2.W)
02:0003E76C 102C0089        	 11344:     move.b  ($0089,A4),D0
02:0003E770 41EC0084        	 11345:     lea     ($0084,A4),A0
02:0003E774 11802000        	 11346:     move.b  D0,(A0,D2.W)
                            	 11347:     ; Set object type $46 (flying head).
                            	 11348:     ;
02:0003E778 7046            	 11349:     moveq   #70,D0
02:0003E77A 41EC034F        	 11350:     lea     ($034F,A4),A0
02:0003E77E 11802000        	 11351:     move.b  D0,(A0,D2.W)
                            	 11352:     even
                            	 11353: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E782 101D            	 11354:     move.b  (A5)+,D0  ; PLA
02:0003E784 7400            	 11355:     moveq   #0,D2
02:0003E786 1400            	 11356:     move.b  D0,D2
                            	 11357:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11358:     ;
02:0003E788 102C04D7        	 11359:     move.b  ($04D7,A4),D0
02:0003E78C E308            	 11360:     lsl.b  #1,D0   ; ASL A
02:0003E78E E308            	 11361:     lsl.b  #1,D0   ; ASL A
02:0003E790 E308            	 11362:     lsl.b  #1,D0   ; ASL A
02:0003E792 7600            	 11363:     moveq   #0,D3
02:0003E794 1600            	 11364:     move.b  D0,D3
02:0003E796 103C00F8        	 11365:     move.b  #$F8,D0
02:0003E79A 41EC0200        	 11366:     lea     ($0200,A4),A0
02:0003E79E 11803000        	 11367:     move.b  D0,(A0,D3.W)
02:0003E7A2 41EC0220        	 11368:     lea     ($0220,A4),A0
02:0003E7A6 11803000        	 11369:     move.b  D0,(A0,D3.W)
                            	 11370:     ; Add the bit for this neck to the dead neck mask.
                            	 11371:     ; Copy it to [00].
                            	 11372:     ;
02:0003E7AA 7600            	 11373:     moveq   #0,D3
02:0003E7AC 162C04D7        	 11374:     move.b  ($04D7,A4),D3
02:0003E7B0 41F90004AE74    	 11375:     lea     (LevelMasks).l,A0
02:0003E7B6 10303000        	 11376:     move.b  (A0,D3.W),D0
02:0003E7BA 122C0511        	 11377:     move.b  ($0511,A4),D1
02:0003E7BE 8001            	 11378:     or.b  D1,D0
02:0003E7C0 19400511        	 11379:     move.b  D0,($0511,A4)
02:0003E7C4 1880            	 11380:     move.b  D0,($0000,A4)
                            	 11381:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11382:     ; Count them up, and store the amount in [00].
                            	 11383:     ;
02:0003E7C6 7000            	 11384:     moveq   #0,D0
02:0003E7C8 7604            	 11385:     moveq   #4,D3
                            	 11386: _anon_z04_143:
02:0003E7CA 1214            	 11387:     move.b  ($0000,A4),D1
02:0003E7CC E209            	 11388:     lsr.b  #1,D1   ; LSR $00
02:0003E7CE 1881            	 11389:     move.b  D1,($0000,A4)
02:0003E7D0 123C0000        	 11390:     move.b  #$00,D1
02:0003E7D4 D101            	 11391:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E7D6 5303            	 11392:     subq.b  #1,D3
02:0003E7D8 66F0            	 11393:     bne  _anon_z04_143
02:0003E7DA 1880            	 11394:     move.b  D0,($0000,A4)
                            	 11395:     ; Compare the number of dead necks to the original number
                            	 11396:     ; (object type - $41).
                            	 11397:     ;
02:0003E7DC 102C0350        	 11398:     move.b  ($0350,A4),D0
02:0003E7E0 003C0011        	 11399:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7E4 123C0041        	 11400:     move.b  #$41,D1
02:0003E7E8 0A3C0010        	 11401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7EC 9101            	 11402:     subx.b  D1,D0   ; SBC #$41
02:0003E7EE 0A3C0010        	 11403:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7F2 1214            	 11404:     move.b  ($0000,A4),D1
02:0003E7F4 B001            	 11405:     cmp.b   D1,D0
                            	 11406:     ; If they're equal, then go handle the whole boss dying.
                            	 11407:     ;
02:0003E7F6 671C            	 11408:     beq  _L_z04_Gleeok_CheckCollisions_BossDied
                            	 11409:     ; Else reset object metastate of the segment, and return.
