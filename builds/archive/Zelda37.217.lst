                            	  5789:     ;
02:0003BE8A 7609            	  5790:     moveq   #9,D3
                            	  5791: _anon_z04_77:
                            	  5792:     ; Start at position ($80, $70).
                            	  5793:     ;
02:0003BE8C 103C0080        	  5794:     move.b  #$80,D0
02:0003BE90 19803071        	  5795:     move.b  D0,($71,A4,D3.W)
02:0003BE94 7070            	  5796:     moveq   #112,D0
02:0003BE96 41EC0085        	  5797:     lea     ($0085,A4),A0
02:0003BE9A 11803000        	  5798:     move.b  D0,(A0,D3.W)
                            	  5799:     ; Start with no direction, no deferred bounce direction,
                            	  5800:     ; and ready to update.
