02:0004DB52 7600            	  8012:     moveq   #0,D3
02:0004DB54 162C051A        	  8013:     move.b  ($051A,A4),D3
02:0004DB58 0C03000C        	  8014:     cmpi.b  #$0C,D3
02:0004DB5C 6502            	  8015:     bcs.s  __far_z_07_0128
