02:0003CE1A 67000084        	  7988:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7989:     ; Decrement grid offset / distance remaining.
                            	  7990:     ;
02:0003CE1E 41EC0394        	  7991:     lea     ($0394,A4),A0
02:0003CE22 53302000        	  7992:     subq.b  #1,(A0,D2.W)
                            	  7993:     ; Move vertically.
                            	  7994:     ; Add the Y offset for the current direction to the Y coordinate.
