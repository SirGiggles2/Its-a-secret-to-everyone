                            	  6532: LayoutUWFloor:
02:00043D9A 7005            	  6533:     moveq   #5,D0
02:00043D9C 4EB90002A9FA    	  6534:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043DA2 6100739A        	  6535:     jsr     GetUniqueRoomId
02:00043DA6 1B00            	  6536:     move.b  D0,-(A5)  ; PHA
02:00043DA8 7000            	  6537:     moveq   #0,D0
02:00043DAA 19400002        	  6538:     move.b  D0,($0002,A4)
02:00043DAE 7000            	  6539:     moveq   #0,D0
02:00043DB0 19400003        	  6540:     move.b  D0,($0003,A4)
02:00043DB4 101D            	  6541:     move.b  (A5)+,D0  ; PLA
02:00043DB6 E308            	  6542:     lsl.b  #1,D0   ; ASL A
02:00043DB8 E308            	  6543:     lsl.b  #1,D0   ; ASL A
02:00043DBA 1880            	  6544:     move.b  D0,($0000,A4)
02:00043DBC 4EB900030E5E    	  6545:     jsr     AddToInt16At2
02:00043DC2 1014            	  6546:     move.b  ($0000,A4),D0
02:00043DC4 4EB900030E5E    	  6547:     jsr     AddToInt16At2
02:00043DCA 1014            	  6548:     move.b  ($0000,A4),D0
