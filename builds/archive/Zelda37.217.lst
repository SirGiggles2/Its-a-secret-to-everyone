                            	 12353: Lamnola_Move:
                            	 12354:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12355:     ;
                            	 12356:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12357:     ;
                            	 12358:     ; Start with a mask of $A1 in [02]:
                            	 12359:     ; - low nibble represents the right direction
                            	 12360:     ; - high nibble is used to set or clear carry as we go along
                            	 12361:     ;
02:0003EEE0 103C00A1        	 12362:     move.b  #$A1,D0
02:0003EEE4 19400002        	 12363:     move.b  D0,($0002,A4)
                            	 12364:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12365:     ;
02:0003EEE8 41EC0098        	 12366:     lea     ($0098,A4),A0
02:0003EEEC 10302000        	 12367:     move.b  (A0,D2.W),D0
02:0003EEF0 122C0002        	 12368:     move.b  ($0002,A4),D1
