02:0003F0E2 41EC0394        	 12630:     lea     ($0394,A4),A0
02:0003F0E6 11802000        	 12631:     move.b  D0,(A0,D2.W)
                            	 12632:     ; This location is right above Patra.
                            	 12633:     ; Set X coordinate to Patra's.
                            	 12634:     ;
02:0003F0EA 102C0071        	 12635:     move.b  ($0071,A4),D0
02:0003F0EE 19802070        	 12636:     move.b  D0,($70,A4,D2.W)
                            	 12637:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12638:     ; Else use radius $18. Store the chosen value in [00].
