                            	  5199: ;
                            	  5200:     even
                            	  5201: HandleShotBlocked:
02:0004C590 41EC00AC        	  5202:     lea     ($00AC,A4),A0
02:0004C594 10302000        	  5203:     move.b  (A0,D2.W),D0
02:0004C598 E308            	  5204:     lsl.b  #1,D0   ; ASL A
