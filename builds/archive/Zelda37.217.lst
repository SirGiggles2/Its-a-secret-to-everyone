                            	  3142: Link_FilterInput:
                            	  3143:     ; [00] holds the opposite of Link's facing direction.
                            	  3144:     ;
02:00041B92 102C0098        	  3145:     move.b  ($0098,A4),D0
02:00041B96 4EB900030A00    	  3146:     jsr     GetOppositeDir
02:00041B9C 1880            	  3147:     move.b  D0,($0000,A4)
                            	  3148:     ; Call GetOppositeDir again to use this mapping:
                            	  3149:     ; In Dir: 1 2 4 8
                            	  3150:     ;         -------
                            	  3151:     ; Index:  2 3 0 1
                            	  3152:     ;
02:00041B9E 4EB900030A00    	  3153:     jsr     GetOppositeDir
                            	  3154:     ; Get the appropriate coordinate for the direction:
                            	  3155:     ; X for horizontal
                            	  3156:     ; Y for vertical
                            	  3157:     ;
02:00041BA4 102C0070        	  3158:     move.b  ($0070,A4),D0
02:00041BA8 0C030002        	  3159:     cmpi.b  #$02,D3
02:00041BAC 6404            	  3160:     bcc  _anon_z05_74
02:00041BAE 102C0084        	  3161:     move.b  ($0084,A4),D0
                            	  3162: _anon_z05_74:
02:00041BB2 19400002        	  3163:     move.b  D0,($0002,A4)
                            	  3164:     ; Mask A button and directions if inner border is crossed.
                            	  3165:     ;
02:00041BB6 1003            	  3166:     move.b  D3,D0
02:00041BB8 1B00            	  3167:     move.b  D0,-(A5)  ; PHA
02:00041BBA 023C00EE        	  3168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BBE 123C0008        	  3169:     move.b  #$08,D1
02:00041BC2 D101            	  3170:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041BC4 7600            	  3171:     moveq   #0,D3
02:00041BC6 1600            	  3172:     move.b  D0,D3
02:00041BC8 103C0080        	  3173:     move.b  #$80,D0
02:00041BCC 6134            	  3174:     jsr     MaskInputInBorder
02:00041BCE 101D            	  3175:     move.b  (A5)+,D0  ; PLA
02:00041BD0 7600            	  3176:     moveq   #0,D3
02:00041BD2 1600            	  3177:     move.b  D0,D3
                            	  3178:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3179:     ; boundary using player's direction and reverse direction index.
                            	  3180:     ;
02:00041BD4 102C0001        	  3181:     move.b  ($0001,A4),D0
