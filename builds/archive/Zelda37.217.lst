02:0003A874 102C066C        	  2739:     move.b  ($066C,A4),D0
02:0003A878 1234203D        	  2740:     move.b  ($3D,A4,D2.W),D1
02:0003A87C 8001            	  2741:     or.b  D1,D0
02:0003A87E 66F0            	  2742:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2743:     ; If state <> 0, go update the jump.
                            	  2744:     ;
02:0003A880 41EC00AC        	  2745:     lea     ($00AC,A4),A0
