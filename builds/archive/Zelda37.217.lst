                            	 12571: __far_z_04_0125:
                            	 12572:     ; State = 0.
                            	 12573:     ;
                            	 12574:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12575:     ; This is the only patra child shown in the first fame.
                            	 12576:     ;
02:0003F08A 0C020002        	 12577:     cmpi.b  #$02,D2
02:0003F08E 6732            	 12578:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12579:     ; The patra child in slot 2 is the last one to be updated.
                            	 12580:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12581:     ;
                            	 12582:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12583:     ; shown.
                            	 12584:     ;
02:0003F090 102C00AE        	 12585:     move.b  ($00AE,A4),D0
02:0003F094 6700008E        	 12586:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12587:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12588:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12589:     ;
02:0003F098 1002            	 12590:     move.b  D2,D0
                            	 12591:     ; Subtract 3 from the object slot to get the angle where the
                            	 12592:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12593:     ;
02:0003F09A 003C0011        	 12594:     ori     #$11,CCR  ; SEC: set C+X
02:0003F09E 123C0003        	 12595:     move.b  #$03,D1
02:0003F0A2 0A3C0010        	 12596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0A6 9101            	 12597:     subx.b  D1,D0   ; SBC #$03
02:0003F0A8 0A3C0010        	 12598:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0AC 7600            	 12599:     moveq   #0,D3
02:0003F0AE 1600            	 12600:     move.b  D0,D3
                            	 12601:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12602:     ; then return.
                            	 12603:     ;
02:0003F0B0 102C0396        	 12604:     move.b  ($0396,A4),D0
02:0003F0B4 41F90003F06E    	 12605:     lea     (PatraChildStartAngles).l,A0
02:0003F0BA 12303000        	 12606:     move.b  (A0,D3.W),D1
02:0003F0BE B001            	 12607:     cmp.b   D1,D0
02:0003F0C0 6662            	 12608:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12609:     even
