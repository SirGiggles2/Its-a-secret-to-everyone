                            	  5887:     ; provisional door face value (PF) in %A as follows:
                            	  5888:     ;
                            	  5889:     ; DA PF Meaning
                            	  5890:     ; -------------
                            	  5891:     ; 0  4  open
                            	  5892:     ; 1  1  wall
                            	  5893:     ; 2  2  false wall
                            	  5894:     ; 3  3  false wall 2
                            	  5895:     ; 4  8  bombable
                            	  5896:     ; 5  5  key
                            	  5897:     ; 6  6  key 2
                            	  5898:     ; 7  7  shutter
                            	  5899:     ;
                            	  5900:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5901:     ; has been cleared, if the type was "open" or any wall.
                            	  5902:     ;
                            	  5903:     ;
                            	  5904:     ; Save the provisional face.
02:00043954 1B00            	  5905:     move.b  D0,-(A5)  ; PHA
                            	  5906:     ; If the current direction points to a door that has been opened,
                            	  5907:     ; then see if we need to set door flags.
                            	  5908:     ;
02:00043956 102C00EE        	  5909:     move.b  ($00EE,A4),D0
02:0004395A 122C0002        	  5910:     move.b  ($0002,A4),D1
02:0004395E C001            	  5911:     and.b  D1,D0
02:00043960 7400            	  5912:     moveq   #0,D2
02:00043962 1400            	  5913:     move.b  D0,D2
02:00043964 101D            	  5914:     move.b  (A5)+,D0  ; PLA
02:00043966 122C0002        	  5915:     move.b  ($0002,A4),D1
02:0004396A B401            	  5916:     cmp.b   D1,D2
02:0004396C 6624            	  5917:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5918:     ; The current direction points to a door that has been opened.
                            	  5919:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5920:     ;
                            	  5921:     ;
                            	  5922:     ; Save provisional door face in Y register.
02:0004396E 7600            	  5923:     moveq   #0,D3
02:00043970 1600            	  5924:     move.b  D0,D3
02:00043972 101D            	  5925:     move.b  (A5)+,D0  ; PLA
02:00043974 1B00            	  5926:     move.b  D0,-(A5)  ; PHA
02:00043976 7400            	  5927:     moveq   #0,D2
02:00043978 1400            	  5928:     move.b  D0,D2
02:0004397A 1003            	  5929:     move.b  D3,D0
                            	  5930:     ; If provisional door face is not for a shutter, then
                            	  5931:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5932:     ;
                            	  5933:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5934:     ;
02:0004397C 0C000007        	  5935:     cmpi.b  #$07,D0
02:00043980 670E            	  5936:     beq  _anon_z05_111
02:00043982 1B00            	  5937:     move.b  D0,-(A5)  ; PHA
02:00043984 6100DD54        	  5938:     jsr     SetDoorFlag
02:00043988 101D            	  5939:     move.b  (A5)+,D0  ; PLA
                            	  5940:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5941:     ; then go make it 9 (open "bombable").
                            	  5942:     ; Else make it 4 (open "door").
                            	  5943:     ;
02:0004398A 0C000008        	  5944:     cmpi.b  #$08,D0
02:0004398E 67A4            	  5945:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5946: _anon_z05_111:
02:00043990 7004            	  5947:     moveq   #4,D0
                            	  5948:     even
                            	  5949: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5950:     ; For opened doors, the provisional door face has become:
                            	  5951:     ;
                            	  5952:     ; DA PF Meaning
                            	  5953:     ; -------------
                            	  5954:     ; 0  4  open
                            	  5955:     ; 1  1  wall
                            	  5956:     ; 2  2  false wall
                            	  5957:     ; 3  3  false wall 2
                            	  5958:     ; 4  9  bombable
                            	  5959:     ; 5  4  key
                            	  5960:     ; 6  4  key 2
                            	  5961:     ; 7  4  shutter
                            	  5962:     ;
                            	  5963:     ;
                            	  5964:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5965:     ;
02:00043992 7400            	  5966:     moveq   #0,D2
02:00043994 142C0006        	  5967:     move.b  ($0006,A4),D2
02:00043998 6712            	  5968:     beq  _anon_z05_112
02:0004399A 7400            	  5969:     moveq   #0,D2
02:0004399C 142C000B        	  5970:     move.b  ($000B,A4),D2
02:000439A0 1B00            	  5971:     move.b  D0,-(A5)  ; PHA
02:000439A2 6100FCC8        	  5972:     jsr     FindDoorAttrByDoorBit
02:000439A6 61001D0C        	  5973:     jsr     CalcOpenDoorwayMask
02:000439AA 101D            	  5974:     move.b  (A5)+,D0  ; PLA
                            	  5975: _anon_z05_112:
                            	  5976:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5977:     ; because the visible door face is already a wall.
                            	  5978:     ;
02:000439AC 0C000004        	  5979:     cmpi.b  #$04,D0
02:000439B0 650000DC        	  5980:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5981:     ; For all other provisional face values, calculate:
                            	  5982:     ; door face := provisional face - 3
02:000439B4 003C0011        	  5983:     ori     #$11,CCR  ; SEC: set C+X
02:000439B8 123C0003        	  5984:     move.b  #$03,D1
02:000439BC 0A3C0010        	  5985:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439C0 9101            	  5986:     subx.b  D1,D0   ; SBC #$03
02:000439C2 0A3C0010        	  5987:     eori    #$10,CCR  ; restore X = 6502 C
02:000439C6 7600            	  5988:     moveq   #0,D3
02:000439C8 1600            	  5989:     move.b  D0,D3
                            	  5990:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5991:     ; subtract one.
                            	  5992:     ;
02:000439CA 0C030003        	  5993:     cmpi.b  #$03,D3
02:000439CE 6502            	  5994:     bcs  _anon_z05_113
02:000439D0 5303            	  5995:     subq.b  #1,D3
                            	  5996: _anon_z05_113:
                            	  5997:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5998:     ;
                            	  5999:     ; DT DFC DFO Meaning
                            	  6000:     ; ------------------
                            	  6001:     ; 0  1   1   open
                            	  6002:     ; 4  4   5   bombable
                            	  6003:     ; 5  2   1   key
                            	  6004:     ; 6  2   1   key 2
                            	  6005:     ; 7  3   1   shutter
                            	  6006:     ;
                            	  6007:     ;
                            	  6008:     ; Get the direction index.
02:000439D2 101D            	  6009:     move.b  (A5)+,D0  ; PLA
02:000439D4 1B00            	  6010:     move.b  D0,-(A5)  ; PHA
02:000439D6 610000D0        	  6011:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6012:     ; If handling the second half, then offset to the second half
                            	  6013:     ; of the tiles.
                            	  6014:     ;
02:000439DA 102C0006        	  6015:     move.b  ($0006,A4),D0
02:000439DE 6618            	  6016:     bne  _anon_z05_114
02:000439E0 41F9000438F6    	  6017:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000439E6 10302000        	  6018:     move.b  (A0,D2.W),D0
02:000439EA 4EB900030E56    	  6019:     jsr     AddToInt16At0
02:000439F0 7006            	  6020:     moveq   #6,D0
02:000439F2 4EB900030E5E    	  6021:     jsr     AddToInt16At2
                            	  6022: _anon_z05_114:
                            	  6023:     ; Fix Y at 0 for copying source tiles to destination.
                            	  6024:     ; Pointers will be incremented instead of Y.
02:000439F8 7600            	  6025:     moveq   #0,D3
02:000439FA 41F9000438FA    	  6026:     lea     (DirIndexToDoorColumnCount).l,A0
02:00043A00 10302000        	  6027:     move.b  (A0,D2.W),D0
