                            	  5279: SpreadShot:
                            	  5280:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5281:     ;
                            	  5282:     ; The shot is spreading out.
                            	  5283:     ;
                            	  5284:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5285:     ; These will be negated appropriately for each corner.
                            	  5286:     ;
02:0004C626 41EC0098        	  5287:     lea     ($0098,A4),A0
02:0004C62A 10302000        	  5288:     move.b  (A0,D2.W),D0
02:0004C62E 19400002        	  5289:     move.b  D0,($0002,A4)
02:0004C632 19400003        	  5290:     move.b  D0,($0003,A4)
                            	  5291:     ; Reset [0F] to not flip horizontally.
                            	  5292:     ;
02:0004C636 7000            	  5293:     moveq   #0,D0
02:0004C638 1940000F        	  5294:     move.b  D0,($000F,A4)
                            	  5295:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5296:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5297:     ;
02:0004C63C 7603            	  5298:     moveq   #3,D3
                            	  5299:     even
                            	  5300: _L_z07_SpreadShot_DrawShotCorner:
02:0004C63E 1003            	  5301:     move.b  D3,D0
02:0004C640 1B00            	  5302:     move.b  D0,-(A5)  ; PHA
                            	  5303:     ; Save offset X [02] and Y offset [03].
                            	  5304:     ;
02:0004C642 102C0002        	  5305:     move.b  ($0002,A4),D0
02:0004C646 1B00            	  5306:     move.b  D0,-(A5)  ; PHA
02:0004C648 102C0003        	  5307:     move.b  ($0003,A4),D0
02:0004C64C 1B00            	  5308:     move.b  D0,-(A5)  ; PHA
                            	  5309:     ; Calculate and set sprite attributes for this corner:
                            	  5310:     ;   base attribute OR (frame counter AND 3)
                            	  5311:     ;
                            	  5312:     ; The base attribute defines how to flip the sprite.
                            	  5313:     ; The frame counter makes the shot flash by cycling each
                            	  5314:     ; palette row.
                            	  5315:     ;
02:0004C64E 102C0015        	  5316:     move.b  ($0015,A4),D0
02:0004C652 02000003        	  5317:     andi.b #$03,D0
02:0004C656 41F90004C4B4    	  5318:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C65C 12303000        	  5319:     move.b  (A0,D3.W),D1
02:0004C660 8001            	  5320:     or.b  D1,D0
02:0004C662 4EB9000318BC    	  5321:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5322:     ; Add the object's X (the center of the spread) and the
                            	  5323:     ; current offset in [02] to set sprite X in [00].
                            	  5324:     ;
02:0004C668 10342070        	  5325:     move.b  ($70,A4,D2.W),D0
02:0004C66C 023C00EE        	  5326:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C670 122C0002        	  5327:     move.b  ($0002,A4),D1
02:0004C674 D101            	  5328:     addx.b  D1,D0   ; ADC $02
02:0004C676 1880            	  5329:     move.b  D0,($0000,A4)
                            	  5330:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5331:     ; Else calculate the distance from object X to sprite X.
                            	  5332:     ;
02:0004C678 12342070        	  5333:     move.b  ($70,A4,D2.W),D1
02:0004C67C B001            	  5334:     cmp.b   D1,D0
02:0004C67E 651A            	  5335:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C680 0C0000FC        	  5336:     cmpi.b  #$FC,D0
02:0004C684 6466            	  5337:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C686 003C0011        	  5338:     ori     #$11,CCR  ; SEC: set C+X
02:0004C68A 12342070        	  5339:     move.b  ($70,A4,D2.W),D1
02:0004C68E 0A3C0010        	  5340:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C692 9101            	  5341:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C694 0A3C0010        	  5342:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C698 6014            	  5343:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5344: 
                            	  5345:     even
                            	  5346: _L_z07_SpreadShot_ReverseSub:
02:0004C69A 10342070        	  5347:     move.b  ($70,A4,D2.W),D0
02:0004C69E 003C0011        	  5348:     ori     #$11,CCR  ; SEC: set C+X
02:0004C6A2 1214            	  5349:     move.b  ($0000,A4),D1
02:0004C6A4 0A3C0010        	  5350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C6A8 9101            	  5351:     subx.b  D1,D0   ; SBC $00
02:0004C6AA 0A3C0010        	  5352:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5353:     even
                            	  5354: _L_z07_SpreadShot_CheckDistance:
                            	  5355:     ; If distance >= $20, skip this corner.
                            	  5356:     ;
02:0004C6AE 0C000020        	  5357:     cmpi.b  #$20,D0
02:0004C6B2 6438            	  5358:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5359:     ; Add the object's Y (the center of the spread) and the
                            	  5360:     ; current offset in [03] to set sprite Y in [01].
                            	  5361:     ;
02:0004C6B4 41EC0084        	  5362:     lea     ($0084,A4),A0
02:0004C6B8 10302000        	  5363:     move.b  (A0,D2.W),D0
02:0004C6BC 023C00EE        	  5364:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6C0 122C0003        	  5365:     move.b  ($0003,A4),D1
02:0004C6C4 D101            	  5366:     addx.b  D1,D0   ; ADC $03
02:0004C6C6 19400001        	  5367:     move.b  D0,($0001,A4)
                            	  5368:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5369:     ;
02:0004C6CA 7600            	  5370:     moveq   #0,D3
02:0004C6CC 162C0010        	  5371:     move.b  ($0010,A4),D3
02:0004C6D0 670C            	  5372:     beq  _L_z07_SpreadShot_Draw
02:0004C6D2 0C00003E        	  5373:     cmpi.b  #$3E,D0
02:0004C6D6 6514            	  5374:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C6D8 0C0000E8        	  5375:     cmpi.b  #$E8,D0
02:0004C6DC 640E            	  5376:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5377:     even
                            	  5378: _L_z07_SpreadShot_Draw:
                            	  5379:     ; Draw the corner.
                            	  5380:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5381:     ;
02:0004C6DE 7002            	  5382:     moveq   #2,D0
02:0004C6E0 1940000C        	  5383:     move.b  D0,($000C,A4)
02:0004C6E4 7623            	  5384:     moveq   #35,D3
02:0004C6E6 4EB9000317DC    	  5385:     jsr     Anim_WriteItemSprites
                            	  5386:     even
                            	  5387: _L_z07_SpreadShot_NextCorner:
                            	  5388:     ; Prepare to process the next corner.
                            	  5389:     ;
                            	  5390:     ; First, restore X offset [02] and Y offset [03].
                            	  5391:     ;
02:0004C6EC 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C6EE 19400003        	  5393:     move.b  D0,($0003,A4)
02:0004C6F2 101D            	  5394:     move.b  (A5)+,D0  ; PLA
02:0004C6F4 19400002        	  5395:     move.b  D0,($0002,A4)
                            	  5396:     ; Take turns negating X offset or Y offset for the next round.
                            	  5397:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5398:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5399:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5400:     ; - Fourth turn: doesn't matter
                            	  5401:     ;
                            	  5402:     ;
                            	  5403:     ; Get the loop index.
02:0004C6F8 101D            	  5404:     move.b  (A5)+,D0  ; PLA
02:0004C6FA 1B00            	  5405:     move.b  D0,-(A5)  ; PHA
02:0004C6FC 7600            	  5406:     moveq   #0,D3
02:0004C6FE 1600            	  5407:     move.b  D0,D3
02:0004C700 0C030001        	  5408:     cmpi.b  #$01,D3
02:0004C704 6602            	  5409:     bne  _anon_z07_25
02:0004C706 7603            	  5410:     moveq   #3,D3
                            	  5411: _anon_z07_25:
02:0004C708 10343000        	  5412:     move.b  ($00,A4,D3.W),D0
02:0004C70C 4600            	  5413:     eori.b #$FF,D0
02:0004C70E 023C00EE        	  5414:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C712 123C0001        	  5415:     move.b  #$01,D1
02:0004C716 D101            	  5416:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C718 19803000        	  5417:     move.b  D0,($00,A4,D3.W)
                            	  5418:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5419:     ;
02:0004C71C 101D            	  5420:     move.b  (A5)+,D0  ; PLA
02:0004C71E 7600            	  5421:     moveq   #0,D3
02:0004C720 1600            	  5422:     move.b  D0,D3
02:0004C722 5303            	  5423:     subq.b  #1,D3
02:0004C724 6A00FF18        	  5424:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5425:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5426:     ;
                            	  5427:     ; Decrease the base negative offset to get farther away from
                            	  5428:     ; the center point.
                            	  5429:     ;
02:0004C728 41EC0098        	  5430:     lea     ($0098,A4),A0
02:0004C72C 53302000        	  5431:     subq.b  #1,(A0,D2.W)
                            	  5432:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5433:     ;
                            	  5434:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5435:     ;
02:0004C730 41EC0098        	  5436:     lea     ($0098,A4),A0
02:0004C734 10302000        	  5437:     move.b  (A0,D2.W),D0
02:0004C738 0C0000E8        	  5438:     cmpi.b  #$E8,D0
02:0004C73C 6702            	  5439:     beq.s  __far_z_07_0081
02:0004C73E 6004            	  5440:     jmp  L1F49F_Exit
                            	  5441: __far_z_07_0081:
