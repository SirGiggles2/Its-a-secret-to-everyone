02:00041BEE 6710            	  3194:     beq  _anon_z05_76
02:00041BF0 1003            	  3195:     move.b  D3,D0
02:00041BF2 023C00EE        	  3196:     andi    #$EE,CCR  ; CLC: clear C+X
