02:00030B94 41EC00AC        	  4736:     lea     ($00AC,A4),A0
02:00030B98 10302000        	  4737:     move.b  (A0,D2.W),D0
02:00030B9C 670E            	  4738:     beq  _L_z01_WieldBomb_FoundSlot
02:00030B9E 020000F0        	  4739:     andi.b #$F0,D0
02:00030BA2 0C000010        	  4740:     cmpi.b  #$10,D0
02:00030BA6 6604            	  4741:     bne.s  __far_z_01_0031
02:00030BA8 60000080        	  4742:     jmp  L69AB_Exit
                            	  4743: __far_z_01_0031:
