                            	  6260:     ;
02:0004CCF0 41EC00AC        	  6261:     lea     ($00AC,A4),A0
02:0004CCF4 52302000        	  6262:     addq.b  #1,(A0,D2.W)
                            	  6263:     ; Once we reach state 6, deactivate the object.
                            	  6264:     ; Otherwise, go draw it.
