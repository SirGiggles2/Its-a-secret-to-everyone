                            	  7907:     ; If Link is invincible, return without shoving.
                            	  7908:     ;
02:0003220E 102C04F0        	  7909:     move.b  ($04F0,A4),D0
02:00032212 664E            	  7910:     bne  _L_z01_BeginShove_Exit
                            	  7911:     ; Store the shove direction we determined.
                            	  7912:     ;
                            	  7913:     ; Turn on the high bit to indicate that the next time we try to
                            	  7914:     ; move by shoving, it will be the first time for this shove action.
                            	  7915:     ;
02:00032214 102C0008        	  7916:     move.b  ($0008,A4),D0
02:00032218 00000080        	  7917:     ori.b #$80,D0
02:0003221C 194000C0        	  7918:     move.b  D0,($00C0,A4)
                            	  7919:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7920:     ;
02:00032220 7018            	  7921:     moveq   #24,D0
02:00032222 194004F0        	  7922:     move.b  D0,($04F0,A4)
02:00032226 7020            	  7923:     moveq   #32,D0
02:00032228 194000D3        	  7924:     move.b  D0,($00D3,A4)
                            	  7925:     ; If Link was shoved by one of his own weapons, then
                            	  7926:     ; nothing else to do. Return.
                            	  7927:     ;
02:0003222C 0C02000D        	  7928:     cmpi.b  #$0D,D2
02:00032230 6430            	  7929:     bcc  _L_z01_BeginShove_Exit
                            	  7930:     ; Link was shoved by a monster.
                            	  7931:     ;
                            	  7932:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7933:     ; then return.
                            	  7934:     ;
02:00032232 41EC04BF        	  7935:     lea     ($04BF,A4),A0
02:00032236 10302000        	  7936:     move.b  (A0,D2.W),D0
02:0003223A 02000080        	  7937:     andi.b #$80,D0
02:0003223E 6622            	  7938:     bne  _L_z01_BeginShove_Exit
                            	  7939:     ; If the attacker is a vire, then return.
                            	  7940:     ;
02:00032240 41EC034F        	  7941:     lea     ($034F,A4),A0
02:00032244 10302000        	  7942:     move.b  (A0,D2.W),D0
02:00032248 0C000012        	  7943:     cmpi.b  #$12,D0
02:0003224C 6714            	  7944:     beq  _L_z01_BeginShove_Exit
                            	  7945:     ; Turn the attacker in the opposite direction.
                            	  7946:     ;
02:0003224E 41EC0098        	  7947:     lea     ($0098,A4),A0
02:00032252 10302000        	  7948:     move.b  (A0,D2.W),D0
02:00032256 6100E7A8        	  7949:     jsr     GetOppositeDir
02:0003225A 41EC0098        	  7950:     lea     ($0098,A4),A0
02:0003225E 11802000        	  7951:     move.b  D0,(A0,D2.W)
