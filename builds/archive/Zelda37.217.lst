02:000364F8 0A3C0010        	  5018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000364FC 9101            	  5019:     subx.b  D1,D0   ; SBC #$08
02:000364FE 0A3C0010        	  5020:     eori    #$10,CCR  ; restore X = 6502 C
