                            	  2925: __far_z_04_0024:
                            	  2926:     ; Going down. We have to consider the target Y.
                            	  2927:     ;
                            	  2928:     ; If the absolute vertical distance to the target position >= 3,
                            	  2929:     ; then go animate, draw, and check collisions.
                            	  2930:     ;
02:0003A9D0 41EC0084        	  2931:     lea     ($0084,A4),A0
02:0003A9D4 10302000        	  2932:     move.b  (A0,D2.W),D0
02:0003A9D8 003C0011        	  2933:     ori     #$11,CCR  ; SEC: set C+X
02:0003A9DC 41EC0444        	  2934:     lea     ($0444,A4),A0
02:0003A9E0 12302000        	  2935:     move.b  (A0,D2.W),D1
02:0003A9E4 0A3C0010        	  2936:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A9E8 9101            	  2937:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003A9EA 0A3C0010        	  2938:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A9EE 4EB900030A04    	  2939:     jsr     Abs
02:0003A9F4 0C000003        	  2940:     cmpi.b  #$03,D0
