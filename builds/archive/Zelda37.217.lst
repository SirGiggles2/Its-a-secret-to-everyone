02:0002FDA2 7040            	  2663:     moveq   #64,D0
02:0002FDA4 194000AC        	  2664:     move.b  D0,($00AC,A4)
02:0002FDA8 7409            	  2665:     moveq   #9,D2
02:0002FDAA 102C0523        	  2666:     move.b  ($0523,A4),D0
02:0002FDAE 02000007        	  2667:     andi.b #$07,D0
02:0002FDB2 7600            	  2668:     moveq   #0,D3
02:0002FDB4 1600            	  2669:     move.b  D0,D3
02:0002FDB6 41F90002FD90    	  2670:     lea     (TeleportYs).l,A0
02:0002FDBC 10303000        	  2671:     move.b  (A0,D3.W),D0
02:0002FDC0 6100FE2A        	  2672:     jsr     InitWhirlwind
                            	  2673: _anon_z01_21:
