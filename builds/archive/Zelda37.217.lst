02:00030B88 020000F0        	  4729:     andi.b #$F0,D0
02:00030B8C 0C000010        	  4730:     cmpi.b  #$10,D0
02:00030B90 661A            	  4731:     bne  _L_z01_WieldBomb_FoundSlot
                            	  4732:     ; Else look at slot $11.
                            	  4733:     ; If there's a bomb there (major state = $10), then return.
                            	  4734:     ;
