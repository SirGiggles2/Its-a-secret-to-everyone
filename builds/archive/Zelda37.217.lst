02:0003CA88 10302000        	  7427:     move.b  (A0,D2.W),D0
02:0003CA8C 123C0008        	  7428:     move.b  #$08,D1
02:0003CA90 D101            	  7429:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA92 19400001        	  7430:     move.b  D0,($0001,A4)
                            	  7431:     ; Only check the first bomb slot ($10).
                            	  7432:     ;
                            	  7433:     ; Store the bomb's (X + 8) in [02].
