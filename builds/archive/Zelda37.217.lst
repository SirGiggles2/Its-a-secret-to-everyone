                            	  8061: __far_z_04_0074:
                            	  8062:     ; Go to state 1.
                            	  8063:     ;
02:0003CEAC 41EC00AC        	  8064:     lea     ($00AC,A4),A0
02:0003CEB0 52302000        	  8065:     addq.b  #1,(A0,D2.W)
                            	  8066:     ; Subtract 1 from facing direction to make an index.
                            	  8067:     ;
02:0003CEB4 7600            	  8068:     moveq   #0,D3
02:0003CEB6 41EC0098        	  8069:     lea     ($0098,A4),A0
02:0003CEBA 16302000        	  8070:     move.b  (A0,D2.W),D3
02:0003CEBE 5303            	  8071:     subq.b  #1,D3
                            	  8072:     ; If Y coordinate < $78, make the index 3 for down.
