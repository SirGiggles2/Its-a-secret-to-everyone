                            	  2631: DrawWhirlwind:
                            	  2632:     ; Frames last 1 screen frame.
                            	  2633:     ;
02:0002FD70 7001            	  2634:     moveq   #1,D0
02:0002FD72 4EB90004D32A    	  2635:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  2636:     ; The whirlwind flashes by using a palette row based on the
                            	  2637:     ; screen frame counter.
                            	  2638:     ;
02:0002FD78 102C0015        	  2639:     move.b  ($0015,A4),D0
02:0002FD7C 02000003        	  2640:     andi.b #$03,D0
02:0002FD80 61001B3A        	  2641:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2642:     ; Flip horizontally based on movement frame, which is
