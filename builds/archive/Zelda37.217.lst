                            	  5279: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003BA8E 19400001        	  5280:     move.b  D0,($0001,A4)
02:0003BA92 61000142        	  5281:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5282:     ; The default image is the hand open.
                            	  5283:     ; If animation frame = 0, then return.
                            	  5284:     ;
02:0003BA96 7400            	  5285:     moveq   #0,D2
02:0003BA98 142C0340        	  5286:     move.b  ($0340,A4),D2
02:0003BA9C 41EC03E4        	  5287:     lea     ($03E4,A4),A0
02:0003BAA0 10302000        	  5288:     move.b  (A0,D2.W),D0
02:0003BAA4 6724            	  5289:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5290:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5291:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5292:     ; The right side is correctly the right side of a closed hand.
                            	  5293:     ; But the left side is Keese. So, we have to patch the left
                            	  5294:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5295:     ;
