02:0003F772 1B00            	 13543:     move.b  D0,-(A5)  ; PHA
                            	 13544:     ; Get the length, to append to the dynamic transfer buf.
                            	 13545:     ;
02:0003F774 7400            	 13546:     moveq   #0,D2
02:0003F776 142C0301        	 13547:     move.b  ($0301,A4),D2
                            	 13548:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 13549:     ;
