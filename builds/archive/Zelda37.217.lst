02:0003F20A 701B            	 12779:     moveq   #27,D0
02:0003F20C 19400505        	 12780:     move.b  D0,($0505,A4)
                            	 12781:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12782:     ;
