                            	  6354: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6355:     ; Store the weapon's frame (horizontal or vertical)
                            	  6356:     ; for the direction chosen above in [0C].
                            	  6357:     ;
02:0004CDB8 4EB900030A00    	  6358:     jsr     GetOppositeDir
02:0004CDBE 41F90004C7F2    	  6359:     lea     (RDirectionToWeaponFrame).l,A0
02:0004CDC4 10303000        	  6360:     move.b  (A0,D3.W),D0
02:0004CDC8 1940000C        	  6361:     move.b  D0,($000C,A4)
                            	  6362:     ; Calculate sprite attributes.
                            	  6363:     ;
                            	  6364:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6365:     ;   base attribute OR 1
                            	  6366:     ; So, it uses palette row 5.
                            	  6367:     ;
02:0004CDCC 41F90004C7F6    	  6368:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004CDD2 10303000        	  6369:     move.b  (A0,D3.W),D0
02:0004CDD6 0C02000D        	  6370:     cmpi.b  #$0D,D2
02:0004CDDA 6706            	  6371:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004CDDC 00000001        	  6372:     ori.b #$01,D0
