02:0003BF00 02000007        	  5840:     andi.b #$07,D0
02:0003BF04 7600            	  5841:     moveq   #0,D3
02:0003BF06 1600            	  5842:     move.b  D0,D3
02:0003BF08 41F90003FC20    	  5843:     lea     (Directions8).l,A0
02:0003BF0E 10303000        	  5844:     move.b  (A0,D3.W),D0
02:0003BF12 1940009D        	  5845:     move.b  D0,($009D,A4)
02:0003BF16 19400385        	  5846:     move.b  D0,($0385,A4)
02:0003BF1A 102C0022        	  5847:     move.b  ($0022,A4),D0
02:0003BF1E 02000007        	  5848:     andi.b #$07,D0
02:0003BF22 7600            	  5849:     moveq   #0,D3
02:0003BF24 1600            	  5850:     move.b  D0,D3
02:0003BF26 41F90003FC20    	  5851:     lea     (Directions8).l,A0
02:0003BF2C 10303000        	  5852:     move.b  (A0,D3.W),D0
02:0003BF30 194000A2        	  5853:     move.b  D0,($00A2,A4)
02:0003BF34 1940038A        	  5854:     move.b  D0,($038A,A4)
                            	  5855:     ; Set minimum number of turns 1 for flying states.
                            	  5856:     ;
                            	  5857:     ; By setting this, the first time that a flight control routine
                            	  5858:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
