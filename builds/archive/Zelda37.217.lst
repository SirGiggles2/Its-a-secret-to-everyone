                            	  5369: _anon_z04_69:
02:0003BB4C 4E75            	  5370:     rts
                            	  5371: 
                            	  5372: ; Params:
                            	  5373: ; A: offset of first instruction for left wall (0)
                            	  5374: ;    or top wall ($20)
                            	  5375: ; Y: Link's minimum major coordinate
                            	  5376: ; [00]: Link's coordinate along minor axis
                            	  5377: ; [01]: Link's coordinate along major axis
                            	  5378: ; [02]: a decreasing direction along the wall (left or up)
                            	  5379: ;
                            	  5380: ; Returns:
                            	  5381: ; Y: index of initial major coordinate of Wallmaster
                            	  5382: ; [04]: initial minor coordinate of Wallmaster
                            	  5383: ;
                            	  5384: ; Store the initial offset for this axis.
                            	  5385: ;
                            	  5386:     even
                            	  5387: Wallmaster_CalcStartPosition:
02:0003BB4E 41EC0412        	  5388:     lea     ($0412,A4),A0
02:0003BB52 11802000        	  5389:     move.b  D0,(A0,D2.W)
02:0003BB56 19430003        	  5390:     move.b  D3,($0003,A4)
                            	  5391:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5392:     ;
02:0003BB5A 7024            	  5393:     moveq   #36,D0
02:0003BB5C 7600            	  5394:     moveq   #0,D3
02:0003BB5E 162C03F8        	  5395:     move.b  ($03F8,A4),D3
02:0003BB62 6702            	  5396:     beq  _anon_z04_70
02:0003BB64 7032            	  5397:     moveq   #50,D0
                            	  5398: _anon_z04_70:
                            	  5399:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5400:     ; 1. negate the distance
                            	  5401:     ; 2. add 8 to the instruction offset to access
                            	  5402:     ;    the opposite direction for the same wall
                            	  5403:     ;
02:0003BB66 7600            	  5404:     moveq   #0,D3
02:0003BB68 162C0098        	  5405:     move.b  ($0098,A4),D3
02:0003BB6C 122C0002        	  5406:     move.b  ($0002,A4),D1
02:0003BB70 B601            	  5407:     cmp.b   D1,D3
02:0003BB72 662A            	  5408:     bne  _anon_z04_71
02:0003BB74 1B00            	  5409:     move.b  D0,-(A5)  ; PHA
02:0003BB76 41EC0412        	  5410:     lea     ($0412,A4),A0
02:0003BB7A 10302000        	  5411:     move.b  (A0,D2.W),D0
02:0003BB7E 023C00EE        	  5412:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB82 123C0008        	  5413:     move.b  #$08,D1
02:0003BB86 D101            	  5414:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB88 41EC0412        	  5415:     lea     ($0412,A4),A0
02:0003BB8C 11802000        	  5416:     move.b  D0,(A0,D2.W)
02:0003BB90 101D            	  5417:     move.b  (A5)+,D0  ; PLA
02:0003BB92 4600            	  5418:     eori.b #$FF,D0
02:0003BB94 023C00EE        	  5419:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB98 123C0001        	  5420:     move.b  #$01,D1
02:0003BB9C D101            	  5421:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5422: _anon_z04_71:
                            	  5423:     ; Add the distance and Link's minor coordinate to calculate
                            	  5424:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5425:     ; In general, the monster will be put in front of Link.
                            	  5426:     ;
02:0003BB9E 023C00EE        	  5427:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBA2 1214            	  5428:     move.b  ($0000,A4),D1
02:0003BBA4 D101            	  5429:     addx.b  D1,D0   ; ADC $00
02:0003BBA6 19400004        	  5430:     move.b  D0,($0004,A4)
                            	  5431:     ; By default, will return index 0 to choose the minimum value
                            	  5432:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5433:     ; if Link is at the wall with a smaller major coordinate.
                            	  5434:     ;
02:0003BBAA 7600            	  5435:     moveq   #0,D3
                            	  5436:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5437:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5438:     ; to access the block for the other direction along the same axis,
                            	  5439:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5440:     ;
02:0003BBAC 102C0001        	  5441:     move.b  ($0001,A4),D0
02:0003BBB0 122C0003        	  5442:     move.b  ($0003,A4),D1
02:0003BBB4 B001            	  5443:     cmp.b   D1,D0
02:0003BBB6 671C            	  5444:     beq  _anon_z04_72
02:0003BBB8 41EC0412        	  5445:     lea     ($0412,A4),A0
02:0003BBBC 10302000        	  5446:     move.b  (A0,D2.W),D0
02:0003BBC0 023C00EE        	  5447:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBC4 123C0010        	  5448:     move.b  #$10,D1
02:0003BBC8 D101            	  5449:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BBCA 41EC0412        	  5450:     lea     ($0412,A4),A0
02:0003BBCE 11802000        	  5451:     move.b  D0,(A0,D2.W)
02:0003BBD2 5203            	  5452:     addq.b  #1,D3
