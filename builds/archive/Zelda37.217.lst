                            	  7233: __far_z_04_0063:
                            	  7234:     ; Set the bloated timer according to the substate.
                            	  7235:     ;
02:0003C918 7600            	  7236:     moveq   #0,D3
02:0003C91A 41EC042C        	  7237:     lea     ($042C,A4),A0
02:0003C91E 16302000        	  7238:     move.b  (A0,D2.W),D3
02:0003C922 41F90003C84E    	  7239:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C928 10303000        	  7240:     move.b  (A0,D3.W),D0
02:0003C92C 41EC045E        	  7241:     lea     ($045E,A4),A0
02:0003C930 11802000        	  7242:     move.b  D0,(A0,D2.W)
                            	  7243:     ; If substate <> 0, go decrement bloated timer.
                            	  7244:     ;
02:0003C934 4A03            	  7245:     cmpi.b  #$00,D3
02:0003C936 6702            	  7246:     beq.s  __far_z_04_0064
02:0003C938 605C            	  7247:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7248: __far_z_04_0064:
