                            	  3346: _anon_z04_42:
                            	  3347:     ; State 0.
                            	  3348:     ;
                            	  3349:     ; In state we determine whether to burst out of the ground.
                            	  3350:     ; If the long timer has not expired, then return.
                            	  3351:     ;
02:0003AD12 102C004D        	  3352:     move.b  ($004D,A4),D0
02:0003AD16 6674            	  3353:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3354:     ; Only allow two red leevers at a time.
                            	  3355:     ;
02:0003AD18 102C0510        	  3356:     move.b  ($0510,A4),D0
02:0003AD1C 0C000002        	  3357:     cmpi.b  #$02,D0
02:0003AD20 646A            	  3358:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3359:     ; Face in the same direction as Link.
                            	  3360:     ;
02:0003AD22 102C0098        	  3361:     move.b  ($0098,A4),D0
02:0003AD26 41EC0098        	  3362:     lea     ($0098,A4),A0
02:0003AD2A 11802000        	  3363:     move.b  D0,(A0,D2.W)
                            	  3364:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3365:     ;
02:0003AD2E 10342019        	  3366:     move.b  ($19,A4,D2.W),D0
02:0003AD32 0C0000C0        	  3367:     cmpi.b  #$C0,D0
02:0003AD36 6506            	  3368:     bcs  _anon_z04_43
02:0003AD38 4EB90004C1FA    	  3369:     jsr     ReverseObjDir
                            	  3370: _anon_z04_43:
                            	  3371:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3372:     ;
02:0003AD3E 41EC0098        	  3373:     lea     ($0098,A4),A0
02:0003AD42 10302000        	  3374:     move.b  (A0,D2.W),D0
02:0003AD46 0200000C        	  3375:     andi.b #$0C,D0
02:0003AD4A 6742            	  3376:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3377:     ; Begin with the leever's X set to Link's X.
                            	  3378:     ;
02:0003AD4C 102C0070        	  3379:     move.b  ($0070,A4),D0
02:0003AD50 19802070        	  3380:     move.b  D0,($70,A4,D2.W)
                            	  3381:     ; If facing down, then use Y offset $28.
                            	  3382:     ; Else store Y offset -$28 in [00].
                            	  3383:     ;
02:0003AD54 7628            	  3384:     moveq   #40,D3
02:0003AD56 41EC0098        	  3385:     lea     ($0098,A4),A0
02:0003AD5A 10302000        	  3386:     move.b  (A0,D2.W),D0
02:0003AD5E 02000008        	  3387:     andi.b #$08,D0
02:0003AD62 6704            	  3388:     beq  _anon_z04_44
02:0003AD64 163C00D8        	  3389:     move.b  #$D8,D3
                            	  3390: _anon_z04_44:
02:0003AD68 1883            	  3391:     move.b  D3,($0000,A4)
                            	  3392:     ; Add Link's Y and the vertical offset.
                            	  3393:     ;
02:0003AD6A 102C0084        	  3394:     move.b  ($0084,A4),D0
02:0003AD6E 023C00EE        	  3395:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD72 1214            	  3396:     move.b  ($0000,A4),D1
02:0003AD74 D101            	  3397:     addx.b  D1,D0   ; ADC $00
                            	  3398:     ; Sanitize the Y coordinate:
                            	  3399:     ; (Y AND $F0) OR $D
                            	  3400:     ;
02:0003AD76 020000F0        	  3401:     andi.b #$F0,D0
02:0003AD7A 0000000D        	  3402:     ori.b #$0D,D0
02:0003AD7E 41EC0084        	  3403:     lea     ($0084,A4),A0
02:0003AD82 11802000        	  3404:     move.b  D0,(A0,D2.W)
                            	  3405:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3406:     ; go see if the tile is valid to come out of.
                            	  3407:     ;
                            	  3408:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3409:     ;
02:0003AD86 0C00005D        	  3410:     cmpi.b  #$5D,D0
02:0003AD8A 647A            	  3411:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3412:     even
