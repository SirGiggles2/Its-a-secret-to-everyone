02:0003A23A 123C0008        	  1768:     move.b  #$08,D1
02:0003A23E D101            	  1769:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A240 020000F0        	  1770:     andi.b #$F0,D0
