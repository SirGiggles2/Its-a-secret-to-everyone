                            	  7561: DodongoBombNegativeLimits:
02:0003CB54 F4              	  7562:     dc.b    $F4, $F0
02:0003CB55 F0
                            	  7563: 
                            	  7564: ; Params:
                            	  7565: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7566: ; [00]: monster hotspot X
                            	  7567: ; [01]: monster hotspot Y
                            	  7568: ; [02]: bomb hotspot X
                            	  7569: ; [03]: bomb hotspot Y
                            	  7570: ;
                            	  7571: ; Returns:
                            	  7572: ; A: 0 if the bomb is in range of the monster
                            	  7573: ; Z: 1 if the bomb is in range of the monster
                            	  7574: ; [04]: horizontal distance
                            	  7575: ; [05]: vertical distance
                            	  7576: ;
                            	  7577: ; Store the positive limit in [06], and the negative one in [07].
                            	  7578: ;
                            	  7579:     even
                            	  7580: Dodongo_IsBombInRange:
02:0003CB56 41F90003CB52    	  7581:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CB5C 10303000        	  7582:     move.b  (A0,D3.W),D0
02:0003CB60 19400006        	  7583:     move.b  D0,($0006,A4)
02:0003CB64 41F90003CB54    	  7584:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CB6A 10303000        	  7585:     move.b  (A0,D3.W),D0
02:0003CB6E 19400007        	  7586:     move.b  D0,($0007,A4)
                            	  7587:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7588:     ; the bomb is near enough the monster.
                            	  7589:     ;
02:0003CB72 7003            	  7590:     moveq   #3,D0
02:0003CB74 19400008        	  7591:     move.b  D0,($0008,A4)
                            	  7592:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7593:     ;
02:0003CB78 7601            	  7594:     moveq   #1,D3
                            	  7595:     even
                            	  7596: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7597:     ; Subtract the bomb's coordinate from the boss's,
                            	  7598:     ; The loop index determines the coordinate.
                            	  7599:     ;
02:0003CB7A 10343000        	  7600:     move.b  ($00,A4,D3.W),D0
02:0003CB7E 003C0011        	  7601:     ori     #$11,CCR  ; SEC: set C+X
02:0003CB82 12343002        	  7602:     move.b  ($02,A4,D3.W),D1
02:0003CB86 0A3C0010        	  7603:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CB8A 9101            	  7604:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CB8C 0A3C0010        	  7605:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7606:     ; If the distance >= positive offset, or < negative offset;
                            	  7607:     ; then loop again.
                            	  7608:     ;
02:0003CB90 122C0006        	  7609:     move.b  ($0006,A4),D1
02:0003CB94 B001            	  7610:     cmp.b   D1,D0
02:0003CB96 6A16            	  7611:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CB98 122C0007        	  7612:     move.b  ($0007,A4),D1
02:0003CB9C B001            	  7613:     cmp.b   D1,D0
02:0003CB9E 6B0E            	  7614:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7615:     ; The distance is close enough in this axis.
                            	  7616:     ;
                            	  7617:     ; Store the distance in this axis in [05] or [04],
                            	  7618:     ; depending on the loop index.
                            	  7619:     ;
02:0003CBA0 19803004        	  7620:     move.b  D0,($04,A4,D3.W)
                            	  7621:     ; Shift [08] right, because we're in range in this axis.
                            	  7622:     ;
02:0003CBA4 122C0008        	  7623:     move.b  ($0008,A4),D1
02:0003CBA8 E209            	  7624:     lsr.b  #1,D1   ; LSR $08
02:0003CBAA 19410008        	  7625:     move.b  D1,($0008,A4)
                            	  7626:     even
                            	  7627: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CBAE 5303            	  7628:     subq.b  #1,D3
02:0003CBB0 6AC8            	  7629:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7630:     ; If close enough in both axes, then [08] will be 0.
                            	  7631:     ;
02:0003CBB2 102C0008        	  7632:     move.b  ($0008,A4),D0
02:0003CBB6 4E75            	  7633:     rts
                            	  7634: 
                            	  7635: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7636: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7637: ;
                            	  7638: ; But these are not typical direction indexes. Instead a
                            	  7639: ; 5-way index is used.
                            	  7640: ; A direction shifted right once becomes a 5-way index.
                            	  7641: ; The fourth element is unused.
                            	  7642: ;
                            	  7643:     even
                            	  7644: DodongoFrameImages:
02:0003CBB8 00              	  7645:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CBB9 01
02:0003CBBA 06
02:0003CBBB FF
02:0003CBBC 08
02:0003CBBD 02
02:0003CBBE 03
02:0003CBBF 06
02:0003CBC0 FF              	  7646:     dc.b    $FF, $08
02:0003CBC1 08
                            	  7647: 
                            	  7648:     even
                            	  7649: DodongoFrameHFlips:
02:0003CBC2 00              	  7650:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CBC3 40
02:0003CBC4 00
02:0003CBC5 FF
02:0003CBC6 00
02:0003CBC7 00
02:0003CBC8 40
02:0003CBC9 40
02:0003CBCA FF              	  7651:     dc.b    $FF, $40
02:0003CBCB 40
                            	  7652: 
                            	  7653:     even
                            	  7654: DodongoFrameImagesBloated:
02:0003CBCC 04              	  7655:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CBCD 05
02:0003CBCE 07
02:0003CBCF FF
02:0003CBD0 09
02:0003CBD1 04
02:0003CBD2 05
02:0003CBD3 07
02:0003CBD4 FF              	  7656:     dc.b    $FF, $09
02:0003CBD5 09
                            	  7657: 
                            	  7658:     even
                            	  7659: DodongoFrameHFlipsBloated:
02:0003CBD6 00              	  7660:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CBD7 40
02:0003CBD8 00
02:0003CBD9 FF
02:0003CBDA 00
02:0003CBDB 00
