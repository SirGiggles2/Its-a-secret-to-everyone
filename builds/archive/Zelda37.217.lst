02:0004024C 7003            	   323:     moveq   #3,D0
02:0004024E 6100015C        	   324:     jsr     MovePositionMarkers
02:00040252 102C00FC        	   325:     move.b  ($00FC,A4),D0
02:00040256 003C0011        	   326:     ori     #$11,CCR  ; SEC: set C+X
02:0004025A 123C0003        	   327:     move.b  #$03,D1
