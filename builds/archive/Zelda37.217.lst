                            	  5811:     ; Copy object attributes from the first monster slot.
                            	  5812:     ;
02:0003BEC0 102C04C0        	  5813:     move.b  ($04C0,A4),D0
02:0003BEC4 41EC04C0        	  5814:     lea     ($04C0,A4),A0
02:0003BEC8 11803000        	  5815:     move.b  D0,(A0,D3.W)
                            	  5816:     ; Copy HP from the first monster slot.
                            	  5817:     ;
02:0003BECC 102C0486        	  5818:     move.b  ($0486,A4),D0
02:0003BED0 41EC0486        	  5819:     lea     ($0486,A4),A0
02:0003BED4 11803000        	  5820:     move.b  D0,(A0,D3.W)
                            	  5821:     ; Start with flying speed $80, and in flying state 2.
                            	  5822:     ;
