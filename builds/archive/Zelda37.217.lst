                            	  8128: UpdatePolsVoiceState1_Jumping:
                            	  8129:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8130:     ;
02:0003CF3E 41EC0444        	  8131:     lea     ($0444,A4),A0
02:0003CF42 10302000        	  8132:     move.b  (A0,D2.W),D0
02:0003CF46 023C00EE        	  8133:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF4A 123C0038        	  8134:     move.b  #$38,D1
02:0003CF4E D101            	  8135:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CF50 41EC0444        	  8136:     lea     ($0444,A4),A0
02:0003CF54 11802000        	  8137:     move.b  D0,(A0,D2.W)
                            	  8138:     ; Add Carry to high speed byte (vertical).
                            	  8139:     ;
02:0003CF58 41EC0412        	  8140:     lea     ($0412,A4),A0
02:0003CF5C 10302000        	  8141:     move.b  (A0,D2.W),D0
02:0003CF60 123C0000        	  8142:     move.b  #$00,D1
02:0003CF64 D101            	  8143:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CF66 41EC0412        	  8144:     lea     ($0412,A4),A0
02:0003CF6A 11802000        	  8145:     move.b  D0,(A0,D2.W)
                            	  8146:     ; Add high speed byte to Y coordinate.
                            	  8147:     ;
02:0003CF6E 023C00EE        	  8148:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF72 41EC0084        	  8149:     lea     ($0084,A4),A0
02:0003CF76 12302000        	  8150:     move.b  (A0,D2.W),D1
02:0003CF7A D101            	  8151:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CF7C 41EC0084        	  8152:     lea     ($0084,A4),A0
02:0003CF80 11802000        	  8153:     move.b  D0,(A0,D2.W)
                            	  8154:     ; If the speed is still negative, then return.
                            	  8155:     ;
02:0003CF84 41EC0412        	  8156:     lea     ($0412,A4),A0
02:0003CF88 10302000        	  8157:     move.b  (A0,D2.W),D0
02:0003CF8C 6B0000AC        	  8158:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8159:     ; If Y coordinate still < target Y, then return.
                            	  8160:     ;
02:0003CF90 41EC0084        	  8161:     lea     ($0084,A4),A0
02:0003CF94 10302000        	  8162:     move.b  (A0,D2.W),D0
02:0003CF98 41EC042C        	  8163:     lea     ($042C,A4),A0
02:0003CF9C 12302000        	  8164:     move.b  (A0,D2.W),D1
02:0003CFA0 B001            	  8165:     cmp.b   D1,D0
02:0003CFA2 65000096        	  8166:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8167:     ; Else reached the destination. Go to state 0.
                            	  8168:     ;
02:0003CFA6 7000            	  8169:     moveq   #0,D0
02:0003CFA8 41EC00AC        	  8170:     lea     ($00AC,A4),A0
02:0003CFAC 11802000        	  8171:     move.b  D0,(A0,D2.W)
                            	  8172:     ; Reset 16-bit vertical speed.
                            	  8173:     ;
02:0003CFB0 41EC0444        	  8174:     lea     ($0444,A4),A0
02:0003CFB4 11802000        	  8175:     move.b  D0,(A0,D2.W)
02:0003CFB8 41EC0412        	  8176:     lea     ($0412,A4),A0
02:0003CFBC 11802000        	  8177:     move.b  D0,(A0,D2.W)
                            	  8178:     ; Choose a random direction to face in.
                            	  8179:     ;
02:0003CFC0 10342018        	  8180:     move.b  ($18,A4,D2.W),D0
02:0003CFC4 02000003        	  8181:     andi.b #$03,D0
02:0003CFC8 7600            	  8182:     moveq   #0,D3
02:0003CFCA 1600            	  8183:     move.b  D0,D3
02:0003CFCC 41F90003CDDC    	  8184:     lea     (PolsVoiceDirections).l,A0
02:0003CFD2 10303000        	  8185:     move.b  (A0,D3.W),D0
02:0003CFD6 41EC0098        	  8186:     lea     ($0098,A4),A0
02:0003CFDA 11802000        	  8187:     move.b  D0,(A0,D2.W)
                            	  8188:     ; Randomly set distance-to-move to $30 or $70.
                            	  8189:     ;
02:0003CFDE 10342018        	  8190:     move.b  ($18,A4,D2.W),D0
02:0003CFE2 02000040        	  8191:     andi.b #$40,D0
02:0003CFE6 123C0030        	  8192:     move.b  #$30,D1
02:0003CFEA D101            	  8193:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003CFEC 41EC0394        	  8194:     lea     ($0394,A4),A0
02:0003CFF0 11802000        	  8195:     move.b  D0,(A0,D2.W)
                            	  8196:     ; Align the monster with a square horizontally.
                            	  8197:     ;
                            	  8198:     ; If in the left half of a square, align with that square.
                            	  8199:     ; If in the right half, align with the next square.
                            	  8200:     ;
02:0003CFF4 10342070        	  8201:     move.b  ($70,A4,D2.W),D0
02:0003CFF8 023C00EE        	  8202:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFFC 123C0008        	  8203:     move.b  #$08,D1
02:0003D000 D101            	  8204:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D002 020000F0        	  8205:     andi.b #$F0,D0
02:0003D006 19802070        	  8206:     move.b  D0,($70,A4,D2.W)
                            	  8207:     ; Align the monster with a square vertically.
                            	  8208:     ;
                            	  8209:     ; If in the top half of a square, align with that square.
                            	  8210:     ; If in the bottom half, align with the next square.
                            	  8211:     ;
02:0003D00A 41EC0084        	  8212:     lea     ($0084,A4),A0
02:0003D00E 10302000        	  8213:     move.b  (A0,D2.W),D0
02:0003D012 023C00EE        	  8214:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D016 123C0008        	  8215:     move.b  #$08,D1
02:0003D01A D101            	  8216:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D01C 020000F0        	  8217:     andi.b #$F0,D0
                            	  8218:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8219:     ;
02:0003D020 003C0011        	  8220:     ori     #$11,CCR  ; SEC: set C+X
02:0003D024 123C0003        	  8221:     move.b  #$03,D1
02:0003D028 0A3C0010        	  8222:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D02C 9101            	  8223:     subx.b  D1,D0   ; SBC #$03
02:0003D02E 0A3C0010        	  8224:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D032 41EC0084        	  8225:     lea     ($0084,A4),A0
02:0003D036 11802000        	  8226:     move.b  D0,(A0,D2.W)
                            	  8227:     even
                            	  8228: _L_z04_UpdatePolsVoiceState1_Jumping_Exit:
02:0003D03A 4E75            	  8229:     rts
                            	  8230: 
                            	  8231: ; Returns:
                            	  8232: ; C: 0 if walkable
                            	  8233: ; [041F][X]: tile
                            	  8234: ;
                            	  8235:     even
                            	  8236: PolsVoice_IsSquareWalkable:
02:0003D03C 6146            	  8237:     jsr     PolsVoice_GetCollidingTile
                            	  8238:     ; If there's an unwalkable tile at the usual hotspot, then return.
                            	  8239:     ;
