                            	  8261: Submenu_CueTransferRowUW:
                            	  8262:     ; If menu scroll value is negative, then we transferred everything.
                            	  8263:     ; So, return.
                            	  8264:     ;
02:00044F5A 102C005E        	  8265:     move.b  ($005E,A4),D0
02:00044F5E 6A02            	  8266:     bpl.s  __far_z_05_0110
02:00044F60 602E            	  8267:     jmp  L1725A_Exit
                            	  8268: __far_z_05_0110:
                            	  8269:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8270:     ; and represents the current row of the submenu being processed.
                            	  8271:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8272:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8273:     ;
                            	  8274:     ; If the bottom bit is set, go prepare the full black row.
                            	  8275:     ;
02:00044F62 E208            	  8276:     lsr.b  #1,D0   ; LSR A
02:00044F64 7600            	  8277:     moveq   #0,D3
02:00044F66 1600            	  8278:     move.b  D0,D3
02:00044F68 6402            	  8279:     bcc.s  __far_z_05_0111
02:00044F6A 6026            	  8280:     jmp  PrepFullBlackRow
                            	  8281: __far_z_05_0111:
                            	  8282:     ; Submenu rows $D to $15 are parts of the map.
                            	  8283:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8284:     ;
                            	  8285:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8286:     ; buffer for this row.
                            	  8287:     ;
02:00044F6C 0C00000D        	  8288:     cmpi.b  #$0D,D0
02:00044F70 640C            	  8289:     bcc  _anon_z05_167
02:00044F72 41F900044F36    	  8290:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044F78 10303000        	  8291:     move.b  (A0,D3.W),D0
                            	  8292:     even
