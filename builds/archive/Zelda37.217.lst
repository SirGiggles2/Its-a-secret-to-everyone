                            	  7664: Dodongo_Draw:
02:0003CBE0 610000F4        	  7665:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7666:     ; Make a 5-way direction index out of the facing direction
                            	  7667:     ; by shifting right once, and store it in [00].
                            	  7668:     ;
02:0003CBE4 41EC0098        	  7669:     lea     ($0098,A4),A0
02:0003CBE8 10302000        	  7670:     move.b  (A0,D2.W),D0
02:0003CBEC E208            	  7671:     lsr.b  #1,D0   ; LSR A
02:0003CBEE 1880            	  7672:     move.b  D0,($0000,A4)
                            	  7673:     ; If state = 0, go handle animating the two frames of this state.
                            	  7674:     ;
02:0003CBF0 7600            	  7675:     moveq   #0,D3
02:0003CBF2 41EC00AC        	  7676:     lea     ($00AC,A4),A0
02:0003CBF6 16302000        	  7677:     move.b  (A0,D2.W),D3
02:0003CBFA 6744            	  7678:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7679:     ; If state > 1, then the monster is stunned (state 2).
                            	  7680:     ; So, go switch frames every $20 screen frames.
                            	  7681:     ;
02:0003CBFC 7020            	  7682:     moveq   #32,D0
02:0003CBFE 5303            	  7683:     subq.b  #1,D3
02:0003CC00 6640            	  7684:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7685:     ; State = 1. Bloated.
                            	  7686:     ;
                            	  7687:     ; In substate 0, go animate as usual for walking.
                            	  7688:     ;
02:0003CC02 7600            	  7689:     moveq   #0,D3
02:0003CC04 41EC042C        	  7690:     lea     ($042C,A4),A0
02:0003CC08 16302000        	  7691:     move.b  (A0,D2.W),D3
02:0003CC0C 6732            	  7692:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7693:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7694:     ; go fade the boss; so that some frames are not drawn.
                            	  7695:     ;
02:0003CC0E 0C030002        	  7696:     cmpi.b  #$02,D3
02:0003CC12 6718            	  7697:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC14 0C030003        	  7698:     cmpi.b  #$03,D3
02:0003CC18 6712            	  7699:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7700:     ; State 1, substate 1
                            	  7701:     ;
                            	  7702:     ; Add $14 to the frame image index to index into the bloated
                            	  7703:     ; frame images and H-flips.
                            	  7704:     ;
02:0003CC1A 1014            	  7705:     move.b  ($0000,A4),D0
02:0003CC1C 023C00EE        	  7706:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC20 123C0014        	  7707:     move.b  #$14,D1
02:0003CC24 D101            	  7708:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC26 7600            	  7709:     moveq   #0,D3
02:0003CC28 1600            	  7710:     move.b  D0,D3
02:0003CC2A 6032            	  7711:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7712: 
                            	  7713:     even
                            	  7714: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7715:     ; In bloated substates 2 and 3:
                            	  7716:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7717:     ;
02:0003CC2C 102C0015        	  7718:     move.b  ($0015,A4),D0
02:0003CC30 02000002        	  7719:     andi.b #$02,D0
02:0003CC34 6604            	  7720:     bne.s  __far_z_04_0071
02:0003CC36 600000A6        	  7721:     jmp  L11B00_Exit
                            	  7722: __far_z_04_0071:
02:0003CC3A 7600            	  7723:     moveq   #0,D3
02:0003CC3C 1614            	  7724:     move.b  ($0000,A4),D3
02:0003CC3E 601E            	  7725:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7726: 
                            	  7727:     even
                            	  7728: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7729:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7730:     ;
02:0003CC40 7008            	  7731:     moveq   #8,D0
                            	  7732:     even
                            	  7733: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CC42 7600            	  7734:     moveq   #0,D3
02:0003CC44 1614            	  7735:     move.b  ($0000,A4),D3
02:0003CC46 122C0015        	  7736:     move.b  ($0015,A4),D1
02:0003CC4A C001            	  7737:     and.b  D1,D0
02:0003CC4C 6710            	  7738:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7739:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7740:     ; in order to index into the second set of frame image numbers.
                            	  7741:     ;
02:0003CC4E 1003            	  7742:     move.b  D3,D0
02:0003CC50 023C00EE        	  7743:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC54 123C0005        	  7744:     move.b  #$05,D1
02:0003CC58 D101            	  7745:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC5A 7600            	  7746:     moveq   #0,D3
02:0003CC5C 1600            	  7747:     move.b  D0,D3
                            	  7748:     even
                            	  7749: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7750:     ; Start preparing sprites.
                            	  7751:     ;
02:0003CC5E 4EB90004D330    	  7752:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC64 1003            	  7753:     move.b  D3,D0
02:0003CC66 1B00            	  7754:     move.b  D0,-(A5)  ; PHA
                            	  7755:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7756:     ;
02:0003CC68 41F90003CBC2    	  7757:     lea     (DodongoFrameHFlips).l,A0
02:0003CC6E 10303000        	  7758:     move.b  (A0,D3.W),D0
02:0003CC72 1940000F        	  7759:     move.b  D0,($000F,A4)
02:0003CC76 41F90003CBB8    	  7760:     lea     (DodongoFrameImages).l,A0
02:0003CC7C 10303000        	  7761:     move.b  (A0,D3.W),D0
                            	  7762:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7763:     ; They are drawn mirrored.
                            	  7764:     ;
02:0003CC80 0C000007        	  7765:     cmpi.b  #$07,D0
02:0003CC84 6706            	  7766:     beq  _anon_z04_92
02:0003CC86 0C000009        	  7767:     cmpi.b  #$09,D0
02:0003CC8A 6608            	  7768:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7769: _anon_z04_92:
02:0003CC8C 4EB9000315C6    	  7770:     jsr     DrawObjectMirrored
02:0003CC92 6006            	  7771:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7772: 
                            	  7773:     even
                            	  7774: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7775:     ; No other frame images are mirrored.
                            	  7776:     ;
02:0003CC94 4EB9000315CA    	  7777:     jsr     DrawObjectNotMirrored
                            	  7778:     even
                            	  7779: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CC9A 101D            	  7780:     move.b  (A5)+,D0  ; PLA
02:0003CC9C 7600            	  7781:     moveq   #0,D3
02:0003CC9E 1600            	  7782:     move.b  D0,D3
                            	  7783:     ; If facing vertically, then return. There's no other side to draw.
                            	  7784:     ;
02:0003CCA0 41EC0098        	  7785:     lea     ($0098,A4),A0
02:0003CCA4 10302000        	  7786:     move.b  (A0,D2.W),D0
02:0003CCA8 02000003        	  7787:     andi.b #$03,D0
02:0003CCAC 6602            	  7788:     bne.s  __far_z_04_0072
02:0003CCAE 602E            	  7789:     jmp  L11B00_Exit
                            	  7790: __far_z_04_0072:
                            	  7791:     ; Else draw the right side.
                            	  7792:     ;
                            	  7793:     ; Keep the Y coordinate in [01].
                            	  7794:     ; But, store (X + $10) in [00].
                            	  7795:     ;
02:0003CCB0 10342070        	  7796:     move.b  ($70,A4,D2.W),D0
02:0003CCB4 023C00EE        	  7797:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCB8 123C0010        	  7798:     move.b  #$10,D1
02:0003CCBC D101            	  7799:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CCBE 1880            	  7800:     move.b  D0,($0000,A4)
02:0003CCC0 6114            	  7801:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7802:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7803:     ;
                            	  7804:     ; So, if we had animation frame 1, direction left:
                            	  7805:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7806:     ; - frame image index = 6 (1 + 5)
                            	  7807:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7808:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7809:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7810:     ;
                            	  7811:     ; So, 3 would have been the frame number used above for
                            	  7812:     ; the left side.
                            	  7813:     ;
                            	  7814:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7815:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7816:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7817:     ; on the right.
                            	  7818:     ;
02:0003CCC2 41F90003CBB8    	  7819:     lea     (DodongoFrameImages).l,A0
02:0003CCC8 10303000        	  7820:     move.b  (A0,D3.W),D0
02:0003CCCC 0A000001        	  7821:     eori.b #$01,D0
02:0003CCD0 4EF9000315CA    	  7822:     jmp     DrawObjectNotMirrored
                            	  7823: 
                            	  7824: ; Returns:
                            	  7825: ; A: 3
                            	  7826: ; [04]: left sprite attributes
                            	  7827: ; [05]: right sprite attributes
                            	  7828: ;
                            	  7829:     even
                            	  7830: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CCD6 7003            	  7831:     moveq   #3,D0
02:0003CCD8 4EB9000318BC    	  7832:     jsr     Anim_SetSpriteDescriptorAttributes
