                            	   641: ;------------------------------------------------------------------------------
                            	   642: ; _ppu_write_6 — PPUADDR ($2006)  ← T5 key implementation
                            	   643: ;
                            	   644: ; The NES PPU address register uses a two-write protocol (shared "w" latch):
                            	   645: ;   First  write: high byte of 15-bit VRAM address (bit 14 is forced clear by
                            	   646: ;                 hardware — valid VRAM is $0000–$3FFF).
                            	   647: ;   Second write: low byte.  After this write PPU_VADDR is fully updated and
                            	   648: ;                 the latch resets to 0.
                            	   649: ;
                            	   650: ; Side effect: resets the even-byte PPUDATA buffer (PPU_DHALF = 0) so that a
                            	   651: ; fresh address is always treated as the start of a new word-pair.
                            	   652: ;
                            	   653: ; Preserves: D1.
                            	   654: ;------------------------------------------------------------------------------
                            	   655: _ppu_write_6:
02:0000E32C 48E74000        	   656:     movem.l D1,-(SP)
02:0000E330 123900FF0800    	   657:     move.b  (PPU_LATCH).l,D1
02:0000E336 4A01            	   658:     tst.b   D1
02:0000E338 6618            	   659:     bne.s   .second_write_6
                            	   660:     ; ---- First write: high byte ----
                            	   661:     ; High byte goes into PPU_VADDR+0.  Force bit 6 (addr bit 14) clear to
                            	   662:     ; keep address in the valid $0000–$3FFF window (matches NES hardware).
02:0000E33A 0200003F        	   663:     andi.b  #$3F,D0
02:0000E33E 13C000FF0802    	   664:     move.b  D0,(PPU_VADDR).l        ; store high byte
02:0000E344 13FC000100FF0800	   665:     move.b  #1,(PPU_LATCH).l
02:0000E34C 4CDF0002        	   666:     movem.l (SP)+,D1
02:0000E350 4E75            	   667:     rts
                            	   668: .second_write_6:
                            	   669:     ; ---- Second write: low byte ----
02:0000E352 13C000FF0803    	   670:     move.b  D0,(PPU_VADDR+1).l      ; store low byte
02:0000E358 423900FF0800    	   671:     clr.b   (PPU_LATCH).l           ; reset w register
02:0000E35E 423900FF0809    	   672:     clr.b   (PPU_DHALF).l           ; discard any pending even-byte buffer
02:0000E364 4CDF0002        	   673:     movem.l (SP)+,D1
02:0000E368 4E75            	   674:     rts
                            	   675: 
                            	   676: ;------------------------------------------------------------------------------
                            	   677: ; _ppu_write_7 — PPUDATA ($2007)  ← T16 full implementation
                            	   678: ;
                            	   679: ; Routes byte writes to one of two paths based on PPU_VADDR:
                            	   680: ;
                            	   681: ;   CHR-RAM path  (PPU_VADDR $0000–$1FFF):
                            	   682: ;     Accumulates 16 bytes per NES tile in CHR_TILE_BUF, then on the 16th
                            	   683: ;     byte converts the 2BPP NES tile to 4BPP Genesis format and writes the
                            	   684: ;     32-byte result to VDP VRAM at Genesis addr = NES_addr × 2.
                            	   685: ;
                            	   686: ;   Nametable/palette path (PPU_VADDR $2000–$3FFF):
                            	   687: ;     Buffers even-address bytes and flushes pairs as 16-bit VDP words
                            	   688: ;     (unchanged from T5 — correct for nametable clears and palette writes).
                            	   689: ;
                            	   690: ; NES 2BPP → Genesis 4BPP conversion:
                            	   691: ;   16 bytes in: 8 bytes plane-0 then 8 bytes plane-1 (one bit per pixel)
                            	   692: ;   32 bytes out: 4 bytes per row, 2 pixels per byte, high-nibble = left pixel
                            	   693: ;   Pixel color = (plane1_bit << 1) | plane0_bit   (values 0–3)
                            	   694: ;
                            	   695: ; VDP auto-increment = 2 (Reg 15 = $8F02 set by genesis_shell).
                            	   696: ; PPU_VADDR increments by 1 (horizontal mode, bit 2 of PPUCTRL = 0).
                            	   697: ;
                            	   698: ; Preserves: D0–D6, A0–A6 (all saved/restored).
                            	   699: ;------------------------------------------------------------------------------
                            	   700: _ppu_write_7:
02:0000E36A 48E7FEC0        	   701:     movem.l D0-D6/A0-A1,-(SP)       ; save all working registers (A1 used by LUT in .chr_convert_upload)
                            	   702: 
02:0000E36E 323900FF0802    	   703:     move.w  (PPU_VADDR).l,D1        ; D1 = current NES PPU address
                            	   704: 
                            	   705:     ; Route: CHR range ($0000–$1FFF) vs nametable/palette ($2000–$3FFF)
02:0000E374 0C412000        	   706:     cmpi.w  #$2000,D1
02:0000E378 647E            	   707:     bhs     .nt_write               ; ≥$2000 → nametable / palette path
                            	   708: 
                            	   709:     ;==========================================================================
                            	   710:     ; CHR TILE BUFFER PATH
                            	   711:     ;==========================================================================
                            	   712:     ; Buffer each byte.  On the 16th byte, convert the tile and upload it.
02:0000E37A 523900FF0834    	   713:     addq.b  #1,(CHR_HIT_COUNT).l   ; DEBUG: count every CHR path entry (wraps at 255)
02:0000E380 7400            	   714:     moveq   #0,D2
02:0000E382 143900FF0830    	   715:     move.b  (CHR_BUF_CNT).l,D2     ; D2 = bytes accumulated so far (0–15)
                            	   716: 
                            	   717:     ; Save this tile's base address on the first byte (aligned to 16 bytes)
02:0000E388 4A02            	   718:     tst.b   D2
02:0000E38A 660C            	   719:     bne.s   .chr_store_byte
02:0000E38C 3601            	   720:     move.w  D1,D3
02:0000E38E 0243FFF0        	   721:     andi.w  #$FFF0,D3               ; round down to 16-byte tile boundary
02:0000E392 33C300FF0832    	   722:     move.w  D3,(CHR_BUF_VADDR).l
                            	   723: 
                            	   724: .chr_store_byte:
02:0000E398 41F900FF0820    	   725:     lea     (CHR_TILE_BUF).l,A0
02:0000E39E 11802000        	   726:     move.b  D0,(A0,D2.w)            ; CHR_TILE_BUF[count] = byte
02:0000E3A2 523900FF0830    	   727:     addq.b  #1,(CHR_BUF_CNT).l     ; increment count
02:0000E3A8 6100032C        	   728:     bsr     .inc_ppuaddr            ; advance PPU_VADDR
                            	   729: 
02:0000E3AC 0C39001000FF0830	   730:     cmpi.b  #16,(CHR_BUF_CNT).l
02:0000E3B4 663C            	   731:     bne.s   .chr_ret                ; not yet 16 bytes — keep buffering
                            	   732: 
                            	   733:     ; Complete tile — convert 2BPP → 4BPP and upload to VDP VRAM
                            	   734:     ifne CHR_EXPANSION_ENABLED
                            	   735:     ; Dispatch by NES address bit 12:
                            	   736:     ;   bit12=0 ($0000-$0FFF) → sprite half → _chr_upload_sprite_4x (4 copies)
                            	   737:     ;   bit12=1 ($1000-$1FFF) → BG half     → _chr_convert_upload   (1 copy)
                            	   738:     ; Preflight (reports/chr_preflight.txt) confirms PPUCTRL bit 3 = 0 always,
                            	   739:     ; so sprites live at $0000-$0FFF for all current scenes.
02:0000E3B6 343900FF0832    	   740:     move.w  (CHR_BUF_VADDR).l,D2
02:0000E3BC 0802000C        	   741:     btst    #12,D2
02:0000E3C0 6606            	   742:     bne.s   .chr_bg_dispatch
02:0000E3C2 610003D6        	   743:     bsr     _chr_upload_sprite_4x
02:0000E3C6 6024            	   744:     bra.s   .chr_uploaded
                            	   745: .chr_bg_dispatch:
02:0000E3C8 61000330        	   746:     bsr     _chr_convert_upload
02:0000E3CC 0839000500FF0804	   747:     btst    #5,(PPU_CTRL).l
02:0000E3D4 6716            	   748:     beq.s   .chr_uploaded
02:0000E3D6 303900FF0832    	   749:     move.w  (CHR_BUF_VADDR).l,D0
02:0000E3DC 0C401F20        	   750:     cmpi.w  #$1F20,D0
02:0000E3E0 650A            	   751:     blo.s   .chr_uploaded
02:0000E3E2 0C401F40        	   752:     cmpi.w  #$1F40,D0
02:0000E3E6 6404            	   753:     bhs.s   .chr_uploaded
02:0000E3E8 610003B0        	   754:     bsr     _chr_upload_sprite_4x
