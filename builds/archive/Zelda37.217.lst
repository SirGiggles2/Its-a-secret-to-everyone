02:0004C78A 652C            	  5492:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:0004C78C 0C00000B        	  5493:     cmpi.b  #$0B,D0
02:0004C790 6512            	  5494:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
