02:0004CDA2 0200000F        	  6345:     andi.b #$0F,D0
02:0004CDA6 7600            	  6346:     moveq   #0,D3
02:0004CDA8 1600            	  6347:     move.b  D0,D3
02:0004CDAA 7008            	  6348:     moveq   #8,D0
