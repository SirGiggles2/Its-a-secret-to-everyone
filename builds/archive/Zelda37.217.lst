02:00039B84 41EC0412        	   864:     lea     ($0412,A4),A0
02:00039B88 16302000        	   865:     move.b  (A0,D2.W),D3
02:00039B8C 0C030010        	   866:     cmpi.b  #$10,D3
02:00039B90 6402            	   867:     bcc.s  __far_z_04_0009
02:00039B92 6034            	   868:     jmp  L10262_Exit
