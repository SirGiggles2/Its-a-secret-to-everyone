                            	  2417: _L_z04__TryShooting_TryShootingNow:
                            	  2418:     ; Summary
                            	  2419:     ;
                            	  2420:     ; if temporarily invincible then
                            	  2421:     ;   shoot timer := 0
                            	  2422:     ; elif shoot timer > 0 then
                            	  2423:     ;   decrement shoot timer
                            	  2424:     ; elif wants to shoot then
                            	  2425:     ;   shoot timer := $30
                            	  2426:     ;
                            	  2427:     ; qspeed := [01]
                            	  2428:     ;
                            	  2429:     ; if shoot timer <> 0 then
                            	  2430:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2431:     ;     shoot
                            	  2432:     ;     if succeeded then
                            	  2433:     ;       shoot timer := 0
                            	  2434:     ;       qspeed := 0
                            	  2435:     ;   else
                            	  2436:     ;     qspeed := 0
                            	  2437:     ;
                            	  2438:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A69A 102C0001        	  2439:     move.b  ($0001,A4),D0
02:0003A69E 1883            	  2440:     move.b  D3,($0000,A4)
