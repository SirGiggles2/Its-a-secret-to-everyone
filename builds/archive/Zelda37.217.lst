02:0003CA96 7610            	  7435:     moveq   #16,D3
02:0003CA98 10343070        	  7436:     move.b  ($70,A4,D3.W),D0
02:0003CA9C 123C0008        	  7437:     move.b  #$08,D1
02:0003CAA0 D101            	  7438:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAA2 19400002        	  7439:     move.b  D0,($0002,A4)
                            	  7440:     ; Store the bomb's (Y + 8) in [03].
                            	  7441:     ;
02:0003CAA6 41EC0084        	  7442:     lea     ($0084,A4),A0
02:0003CAAA 10303000        	  7443:     move.b  (A0,D3.W),D0
02:0003CAAE 123C0008        	  7444:     move.b  #$08,D1
02:0003CAB2 D101            	  7445:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAB4 19400003        	  7446:     move.b  D0,($0003,A4)
                            	  7447:     ; But, if there's no bomb, then return.
