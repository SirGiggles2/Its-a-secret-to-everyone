02:0003ED48 6604            	 12094:     bne.s  __far_z_04_0122
02:0003ED4A 6000FF02        	 12095:     jmp  L129EA_Exit
                            	 12096: __far_z_04_0122:
                            	 12097:     ; Change the tail segment to the dead dummy object, and
                            	 12098:     ; bring the current segment back to life.
