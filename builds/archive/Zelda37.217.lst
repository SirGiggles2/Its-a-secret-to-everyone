                            	  6045: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00043A1E 122C0002        	  6046:     move.b  ($02,A4),D1   ; ptr lo
02:00043A22 182C0003        	  6047:     move.b  ($03,A4),D4  ; ptr hi
02:00043A26 024100FF        	  6048:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A2A E14C            	  6049:     lsl.w   #8,D4
02:00043A2C 8841            	  6050:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043A2E 48C4            	  6051:     ext.l   D4
