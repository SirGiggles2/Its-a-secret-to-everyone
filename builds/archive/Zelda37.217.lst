                            	  7478: Dodongo_TryEatBomb:
                            	  7479:     ; Try to eat the bomb.
                            	  7480:     ;
                            	  7481:     ; If the bomb is not in range of the monster, then return.
                            	  7482:     ;
                            	  7483:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7484:     ;
02:0003CAE4 7601            	  7485:     moveq   #1,D3
02:0003CAE6 616E            	  7486:     jsr     Dodongo_IsBombInRange
02:0003CAE8 6666            	  7487:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7488:     ; Will loop from 1 to 0, indexed by [00].
                            	  7489:     ;
02:0003CAEA 7001            	  7490:     moveq   #1,D0
02:0003CAEC 1880            	  7491:     move.b  D0,($0000,A4)
                            	  7492:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7493:     ;
02:0003CAEE 41EC0098        	  7494:     lea     ($0098,A4),A0
02:0003CAF2 10302000        	  7495:     move.b  (A0,D2.W),D0
02:0003CAF6 E208            	  7496:     lsr.b  #1,D0   ; LSR A
02:0003CAF8 7600            	  7497:     moveq   #0,D3
02:0003CAFA 1600            	  7498:     move.b  D0,D3
                            	  7499:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7500:     ; position depends on the orientation of the monster.
                            	  7501:     ;
                            	  7502:     ; Start with the horizontal distance.
                            	  7503:     ;
02:0003CAFC 102C0004        	  7504:     move.b  ($0004,A4),D0
                            	  7505:     even
                            	  7506: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7507:     ; Look up the limits for the given direction.
                            	  7508:     ;
                            	  7509:     ; If the distance from the bomb < negative limit,
                            	  7510:     ; or >= positive limit, then return.
                            	  7511:     ;
                            	  7512:     ; Note that these are simple signed comparisons that work,
                            	  7513:     ; because the operands are in a small range.
                            	  7514:     ;
02:0003CB00 41F90003CA3A    	  7515:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB06 12303000        	  7516:     move.b  (A0,D3.W),D1
02:0003CB0A B001            	  7517:     cmp.b   D1,D0
02:0003CB0C 6B42            	  7518:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB0E 41F90003CA40    	  7519:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB14 12303000        	  7520:     move.b  (A0,D3.W),D1
02:0003CB18 B001            	  7521:     cmp.b   D1,D0
02:0003CB1A 6A34            	  7522:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7523:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7524:     ;
02:0003CB1C 1003            	  7525:     move.b  D3,D0
02:0003CB1E 023C00EE        	  7526:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB22 123C000A        	  7527:     move.b  #$0A,D1
02:0003CB26 D101            	  7528:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB28 7600            	  7529:     moveq   #0,D3
02:0003CB2A 1600            	  7530:     move.b  D0,D3
                            	  7531:     ; Bottom of the loop.
                            	  7532:     ;
                            	  7533:     ; Load the vertical distance for the next iteration.
                            	  7534:     ; Decrement loop counter.
                            	  7535:     ;
02:0003CB2C 102C0005        	  7536:     move.b  ($0005,A4),D0
02:0003CB30 5314            	  7537:     subq.b  #1,($0000,A4)
02:0003CB32 6ACC            	  7538:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7539:     ; If we get here, then the bomb was within range of the mouth.
                            	  7540:     ; Go to state 1 (bloated).
                            	  7541:     ;
02:0003CB34 41EC00AC        	  7542:     lea     ($00AC,A4),A0
02:0003CB38 52302000        	  7543:     addq.b  #1,(A0,D2.W)
                            	  7544:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7545:     ;
02:0003CB3C 7610            	  7546:     moveq   #16,D3
02:0003CB3E 7000            	  7547:     moveq   #0,D0
02:0003CB40 41EC00AC        	  7548:     lea     ($00AC,A4),A0
02:0003CB44 11803000        	  7549:     move.b  D0,(A0,D3.W)
02:0003CB48 41EC042C        	  7550:     lea     ($042C,A4),A0
02:0003CB4C 11802000        	  7551:     move.b  D0,(A0,D2.W)
                            	  7552:     even
