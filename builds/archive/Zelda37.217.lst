                            	 12904: __far_z_04_0131:
                            	 12905:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12906:     ; Collisions were checked already.
                            	 12907:     ;
                            	 12908:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12909:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12910:     ;
