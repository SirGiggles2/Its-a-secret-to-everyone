                            	  1290: _L_z04_UpdateFireball_Move:
                            	  1291:     ; A movement routine is used that works along one axis.
                            	  1292:     ; So, load its parameters, and call it for each axis individually.
                            	  1293:     ;
                            	  1294:     ; First, load the horizontal direction into [0F].
                            	  1295:     ;
02:00039ED0 41EC0412        	  1296:     lea     ($0412,A4),A0
02:00039ED4 10302000        	  1297:     move.b  (A0,D2.W),D0
02:00039ED8 1940000F        	  1298:     move.b  D0,($000F,A4)
                            	  1299:     ; Load the horizontal q-speed and position fraction,
                            	  1300:     ; move, then save the position fraction.
                            	  1301:     ;
02:00039EDC 41EC041F        	  1302:     lea     ($041F,A4),A0
02:00039EE0 10302000        	  1303:     move.b  (A0,D2.W),D0
02:00039EE4 7600            	  1304:     moveq   #0,D3
02:00039EE6 41EC0451        	  1305:     lea     ($0451,A4),A0
02:00039EEA 16302000        	  1306:     move.b  (A0,D2.W),D3
02:00039EEE 613E            	  1307:     jsr     Fireball_MoveOneAxis
02:00039EF0 41EC0451        	  1308:     lea     ($0451,A4),A0
02:00039EF4 11802000        	  1309:     move.b  D0,(A0,D2.W)
                            	  1310:     ; Second, load the vertical direction into [0F].
                            	  1311:     ;
02:00039EF8 41EC0437        	  1312:     lea     ($0437,A4),A0
02:00039EFC 10302000        	  1313:     move.b  (A0,D2.W),D0
02:00039F00 1940000F        	  1314:     move.b  D0,($000F,A4)
                            	  1315:     ; Load the vertical q-speed and position fraction,
                            	  1316:     ; move, then save the position fraction.
                            	  1317:     ;
02:00039F04 41EC0444        	  1318:     lea     ($0444,A4),A0
02:00039F08 10302000        	  1319:     move.b  (A0,D2.W),D0
02:00039F0C 7600            	  1320:     moveq   #0,D3
02:00039F0E 41EC045E        	  1321:     lea     ($045E,A4),A0
02:00039F12 16302000        	  1322:     move.b  (A0,D2.W),D3
02:00039F16 6116            	  1323:     jsr     Fireball_MoveOneAxis
02:00039F18 41EC045E        	  1324:     lea     ($045E,A4),A0
02:00039F1C 11802000        	  1325:     move.b  D0,(A0,D2.W)
