                            	  3583:     ; corrupt palette on subsequent VDP_DATA writes.
                            	  3584:     ; Target $FFFC (unused VRAM) to avoid corrupting tile 0 on stray writes.
02:0002B6D6 23FC7FFC000300C0	  3585:     move.l  #$7FFC0003,(VDP_CTRL).l
02:0002B6DE 0004
02:0002B6E0 4CDF0FFF        	  3586:     movem.l (SP)+,D0-D7/A0-A3
02:0002B6E4 4E75            	  3587:     rts
