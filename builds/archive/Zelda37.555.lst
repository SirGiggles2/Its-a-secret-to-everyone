                            	  2044: AnimateAndDrawObjectWalking:
02:00030E8C 4EB9000490BC    	  2045:     jsr     AnimateObjectWalking
02:00030E92 1003            	  2046:     move.b  D3,D0
02:00030E94 6004            	  2047:     jmp     DrawObjectNotMirrored
                            	  2048: 
                            	  2049: ; Params:
                            	  2050: ; A: frame image
                            	  2051: ; X: object index
                            	  2052: ; [00]: object X
                            	  2053: ; [01]: object Y
                            	  2054: ;
                            	  2055: ;
                            	  2056: ; Set [0C] mirrored.
                            	  2057:     even
                            	  2058: DrawObjectMirrored:
02:00030E96 7601            	  2059:     moveq   #1,D3
02:00030E98 6602            	  2060:     bne  _anon_z01_75
                            	  2061: ; Params:
                            	  2062: ; A: frame image
                            	  2063: ; X: object index
                            	  2064: ; [00]: object X
                            	  2065: ; [01]: object Y
                            	  2066: ; [0F]: flip horizontally
                            	  2067: ;
                            	  2068:     even
                            	  2069: DrawObjectNotMirrored:
02:00030E9A 7600            	  2070:     moveq   #0,D3
                            	  2071: _anon_z01_75:
02:00030E9C 1943000C        	  2072:     move.b  D3,($000C,A4)
                            	  2073:     ; Set animation index = object type + 1.
                            	  2074:     ;
02:00030EA0 7600            	  2075:     moveq   #0,D3
02:00030EA2 41EC034F        	  2076:     lea     ($034F,A4),A0
02:00030EA6 16302000        	  2077:     move.b  (A0,D2.W),D3
                            	  2078: ; Params:
                            	  2079: ; A: frame
                            	  2080: ; X: object index/cycle sprite index
                            	  2081: ; Y: object type
                            	  2082: ; [00]: object X
                            	  2083: ; [01]: object Y
                            	  2084: ; [0C]: mirrored
                            	  2085: ; [0F]: flip horizontally
                            	  2086: ;
                            	  2087: ; Note:
                            	  2088: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2089: ;
                            	  2090: ; The animation index of most objects is (object type + 1),
                            	  2091: ; to make up for the fact that Link uses two animation indexes.
                            	  2092: ;
                            	  2093:     even
                            	  2094: DrawObjectWithType:
02:00030EAA 5203            	  2095:     addq.b  #1,D3
                            	  2096: ; Params:
                            	  2097: ; A: frame
                            	  2098: ; X: object index/cycle sprite index
                            	  2099: ; Y: animation index
                            	  2100: ; [00]: object X
                            	  2101: ; [01]: object Y
                            	  2102: ; [0C]: mirrored
                            	  2103: ; [0F]: flip horizontally
                            	  2104: ;
                            	  2105: ; Note:
                            	  2106: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2107: ; But Link uses [0F] for flipping without checking [0C].
                            	  2108: ;
                            	  2109: ;
                            	  2110: ; [0D] holds frame.
                            	  2111:     even
                            	  2112: DrawObjectWithAnim:
02:00030EAC 1940000D        	  2113:     move.b  D0,($000D,A4)
02:00030EB0 1943000E        	  2114:     move.b  D3,($000E,A4)
02:00030EB4 19420008        	  2115:     move.b  D2,($0008,A4)
                            	  2116:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2117:     ;
02:00030EB8 7600            	  2118:     moveq   #0,D3
02:00030EBA 162C0341        	  2119:     move.b  ($0341,A4),D3
02:00030EBE 41F900030E62    	  2120:     lea     (SpriteOffsets).l,A0
02:00030EC4 10303000        	  2121:     move.b  (A0,D3.W),D0
02:00030EC8 19400343        	  2122:     move.b  D0,($0343,A4)
02:00030ECC 41F900030E63    	  2123:     lea     (SpriteOffsets+1).l,A0
02:00030ED2 10303000        	  2124:     move.b  (A0,D3.W),D0
                            	  2125:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  2126:     ;
02:00030ED6 4A02            	  2127:     cmpi.b  #$00,D2
02:00030ED8 6702            	  2128:     beq.s  __far_z_01_0001
02:00030EDA 6008            	  2129:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  2130: __far_z_01_0001:
