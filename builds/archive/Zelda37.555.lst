                            	  8178: Ganon_UpdateBrownState:
                            	  8179:     ; Every other frame decrement the state.
                            	  8180:     ; But every frame draw Ganon either translucent or opaque.
                            	  8181:     ;
02:0003BBF0 102C0015        	  8182:     move.b  ($0015,A4),D0
02:0003BBF4 E208            	  8183:     lsr.b  #1,D0   ; LSR A
02:0003BBF6 6410            	  8184:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003BBF8 41EC00AC        	  8185:     lea     ($00AC,A4),A0
02:0003BBFC 53302000        	  8186:     subq.b  #1,(A0,D2.W)
                            	  8187:     ; If the state becomes 0, then Ganon is blue again.
                            	  8188:     ; Go switch his palette row to reflect it.
                            	  8189:     ;
02:0003BC00 6606            	  8190:     bne  _L_z04_Ganon_UpdateBrownState_Draw
02:0003BC02 61A4            	  8191:     jsr     Ganon_RandomizeLocation
02:0003BC04 600003DA        	  8192:     jmp     Ganon_AppendPaletteRowTransferRecord_Blue
                            	  8193: 
                            	  8194:     even
