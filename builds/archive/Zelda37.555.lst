02:00038AF6 41EC041F        	  1493:     lea     ($041F,A4),A0
02:00038AFA 10302000        	  1494:     move.b  (A0,D2.W),D0
02:00038AFE 023C00EE        	  1495:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B02 1214            	  1496:     move.b  ($0000,A4),D1
