02:00034E82 19400083        	  4365:     move.b  D0,($0083,A4)
02:00034E86 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E8A 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034E8E 123C0010        	  4368:     move.b  #$10,D1
02:00034E92 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E96 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E98 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E9C 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
