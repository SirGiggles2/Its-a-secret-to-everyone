02:00038F92 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038F96 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038F9A D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00038F9C 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
