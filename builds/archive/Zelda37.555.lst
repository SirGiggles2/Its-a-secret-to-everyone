02:00034E2E 0C020040        	  4312:     cmpi.b  #$40,D2
02:00034E32 6530            	  4313:     bcs  _L_z02_UpdateMode13WinGame_Sub0_Flash_Exit
                            	  4314:     ; Copy the level palette transfer buf.
