                            	   977: ;==============================================================================
                            	   978: ; tick_sq0 — Sq0 channel update
                            	   979: ;==============================================================================
                            	   980: tick_sq0:
02:00000A44 4A3900FFE014    	   981:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:00000A4A 6754            	   982:     beq     tick_trg
02:00000A4C 533900FFE015    	   983:     subq.b  #1,(m_sq0_cnt).l
02:00000A52 664C            	   984:     bne     tick_trg
02:00000A54 207900FFE008    	   985:     move.l  (m_script_ptr).l,A0
02:00000A5A 7200            	   986:     moveq   #0,D1
02:00000A5C 123900FFE014    	   987:     move.b  (m_sq0_off).l,D1
02:00000A62 523900FFE014    	   988:     addq.b  #1,(m_sq0_off).l
02:00000A68 10301000        	   989:     move.b  (A0,D1.w),D0
02:00000A6C 4A00            	   990:     tst.b   D0
02:00000A6E 6A22            	   991:     bpl.s   .play
02:00000A70 61000164        	   992:     bsr     get_song_note_length
02:00000A74 13C000FFE016    	   993:     move.b  D0,(m_sq0_len).l
02:00000A7A 207900FFE008    	   994:     move.l  (m_script_ptr).l,A0
02:00000A80 7200            	   995:     moveq   #0,D1
02:00000A82 123900FFE014    	   996:     move.b  (m_sq0_off).l,D1
02:00000A88 523900FFE014    	   997:     addq.b  #1,(m_sq0_off).l
02:00000A8E 10301000        	   998:     move.b  (A0,D1.w),D0
                            	   999: .play:
02:00000A92 610001BA        	  1000:     bsr     emit_note_sq0
02:00000A96 13F900FFE01600FF	  1001:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A9E E015
                            	  1002:     bra     tick_trg
                            	  1003: 
                            	  1004: ;==============================================================================
                            	  1005: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	  1006: ;==============================================================================
                            	  1007: tick_trg:
02:00000AA0 4A3900FFE01C    	  1008:     tst.b   (m_trg_off).l
02:00000AA6 6700009E        	  1009:     beq     tick_noise
02:00000AAA 533900FFE01D    	  1010:     subq.b  #1,(m_trg_cnt).l
02:00000AB0 66000094        	  1011:     bne     tick_noise
                            	  1012: .prep_note_or_passage:
02:00000AB4 207900FFE008    	  1013:     move.l  (m_script_ptr).l,A0
02:00000ABA 7200            	  1014:     moveq   #0,D1
02:00000ABC 123900FFE01C    	  1015:     move.b  (m_trg_off).l,D1
02:00000AC2 523900FFE01C    	  1016:     addq.b  #1,(m_trg_off).l
02:00000AC8 10301000        	  1017:     move.b  (A0,D1.w),D0
02:00000ACC 676A            	  1018:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000ACE 4A00            	  1019:     tst.b   D0
02:00000AD0 6A56            	  1020:     bpl.s   .play_note_trg                ; direct note
02:00000AD2 0C0000F0        	  1021:     cmpi.b  #$F0,D0
02:00000AD6 6718            	  1022:     beq.s   .end_of_passage
02:00000AD8 652A            	  1023:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1024:     ; $F1-$FF → start passage
02:00000ADA 040000F0        	  1025:     subi.b  #$F0,D0
02:00000ADE 13C000FFE021    	  1026:     move.b  D0,(m_trg_rep_n).l
02:00000AE4 13F900FFE01C00FF	  1027:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000AEC E022
02:00000AEE 60C4            	  1028:     bra.s   .prep_note_or_passage
                            	  1029: .end_of_passage:
02:00000AF0 533900FFE021    	  1030:     subq.b  #1,(m_trg_rep_n).l
02:00000AF6 670A            	  1031:     beq.s   .pass_done
02:00000AF8 13F900FFE02200FF	  1032:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000B00 E01C
                            	  1033: .pass_done:
02:00000B02 60B0            	  1034:     bra.s   .prep_note_or_passage
                            	  1035: .prep_note_trg:
02:00000B04 610000D0        	  1036:     bsr     get_song_note_length
02:00000B08 13C000FFE01E    	  1037:     move.b  D0,(m_trg_len).l
02:00000B0E 207900FFE008    	  1038:     move.l  (m_script_ptr).l,A0
02:00000B14 7200            	  1039:     moveq   #0,D1
02:00000B16 123900FFE01C    	  1040:     move.b  (m_trg_off).l,D1
02:00000B1C 523900FFE01C    	  1041:     addq.b  #1,(m_trg_off).l
02:00000B22 10301000        	  1042:     move.b  (A0,D1.w),D0
02:00000B26 6710            	  1043:     beq.s   .silence_trg
                            	  1044: .play_note_trg:
02:00000B28 61000182        	  1045:     bsr     emit_note_trg
02:00000B2C 13F900FFE01E00FF	  1046:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B34 E01D
02:00000B36 600E            	  1047:     bra     tick_noise
                            	  1048: .silence_trg:
02:00000B38 610001E6        	  1049:     bsr     key_off_trg
02:00000B3C 13F900FFE01E00FF	  1050:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B44 E01D
                            	  1051:     bra     tick_noise
                            	  1052: 
                            	  1053: ;==============================================================================
                            	  1054: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1055: ;==============================================================================
                            	  1056: tick_noise:
02:00000B46 103900FFE000    	  1057:     move.b  (m_song).l,D0
02:00000B4C 02000091        	  1058:     andi.b  #$91,D0
02:00000B50 67000082        	  1059:     beq     .tn_done
                            	  1060:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1061:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1062:     ; a hit fires below.
02:00000B54 61000250        	  1063:     bsr     noise_decay_tick
02:00000B58 533900FFE025    	  1064:     subq.b  #1,(m_noise_cnt).l
02:00000B5E 6674            	  1065:     bne     .tn_done
                            	  1066: .read:
02:00000B60 207900FFE008    	  1067:     move.l  (m_script_ptr).l,A0
02:00000B66 7200            	  1068:     moveq   #0,D1
02:00000B68 123900FFE024    	  1069:     move.b  (m_noise_off).l,D1
02:00000B6E 523900FFE024    	  1070:     addq.b  #1,(m_noise_off).l
02:00000B74 10301000        	  1071:     move.b  (A0,D1.w),D0
02:00000B78 660C            	  1072:     bne.s   .got
02:00000B7A 13F900FFE00600FF	  1073:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B82 E024
02:00000B84 60DA            	  1074:     bra.s   .read
                            	  1075: .got:
02:00000B86 1800            	  1076:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1077:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1078:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1079:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1080:     ; (0,7,6). For our port we replicate exactly.
02:00000B88 7400            	  1081:     moveq   #0,D2
02:00000B8A 1404            	  1082:     move.b  D4,D2
                            	  1083:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B8C 7000            	  1084:     moveq   #0,D0
02:00000B8E 08020000        	  1085:     btst    #0,D2
02:00000B92 6704            	  1086:     beq.s   .b0
02:00000B94 08C00002        	  1087:     bset    #2,D0
                            	  1088: .b0:
02:00000B98 08020007        	  1089:     btst    #7,D2
02:00000B9C 6704            	  1090:     beq.s   .b7
02:00000B9E 08C00001        	  1091:     bset    #1,D0
                            	  1092: .b7:
02:00000BA2 08020006        	  1093:     btst    #6,D2
02:00000BA6 6704            	  1094:     beq.s   .b6
02:00000BA8 08C00000        	  1095:     bset    #0,D0
                            	  1096: .b6:
02:00000BAC 7200            	  1097:     moveq   #0,D1
02:00000BAE 123900FFE003    	  1098:     move.b  (m_len_base).l,D1
02:00000BB4 D240            	  1099:     add.w   D0,D1
02:00000BB6 43F900000E58    	  1100:     lea     (NoteLengthTables).l,A1
02:00000BBC 13F1100000FFE025	  1101:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1102:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000BC4 1004            	  1103:     move.b  D4,D0
02:00000BC6 0200003E        	  1104:     andi.b  #$3E,D0
02:00000BCA E808            	  1105:     lsr.b   #4,D0
02:00000BCC 7200            	  1106:     moveq   #0,D1
02:00000BCE 1200            	  1107:     move.b  D0,D1
                            	  1108:     ; Map to PSG noise: set volume + period
02:00000BD0 6100015A        	  1109:     bsr     set_psg_noise
                            	  1110: .tn_done:
02:00000BD4 4E75            	  1111:     rts
                            	  1112: 
                            	  1113: ;==============================================================================
                            	  1114: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1115: ; Input: D0 = control byte → Output: D0 = length
                            	  1116: ;==============================================================================
                            	  1117: get_song_note_length:
02:00000BD6 02400007        	  1118:     andi.w  #$07,D0
02:00000BDA 7200            	  1119:     moveq   #0,D1
02:00000BDC 123900FFE003    	  1120:     move.b  (m_len_base).l,D1
02:00000BE2 D240            	  1121:     add.w   D0,D1
02:00000BE4 43F900000E58    	  1122:     lea     (NoteLengthTables).l,A1
02:00000BEA 10311000        	  1123:     move.b  (A1,D1.w),D0
02:00000BEE 4E75            	  1124:     rts
                            	  1125: 
                            	  1126: ;==============================================================================
                            	  1127: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1128: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1129: ;==============================================================================
                            	  1130: emit_note_sq1:
02:00000BF0 024000FF        	  1131:     andi.w  #$FF,D0
02:00000BF4 43F900000DE6    	  1132:     lea     (MusicNotePeriodTable).l,A1
02:00000BFA 7400            	  1133:     moveq   #0,D2
02:00000BFC 14310001        	  1134:     move.b  1(A1,D0.w),D2                 ; lo
02:00000C00 67000106        	  1135:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000C04 7600            	  1136:     moveq   #0,D3
02:00000C06 16310000        	  1137:     move.b  0(A1,D0.w),D3                 ; hi
02:00000C0A E14B            	  1138:     lsl.w   #8,D3
02:00000C0C 8642            	  1139:     or.w    D2,D3                          ; D3.w = period
02:00000C0E 024307FF        	  1140:     andi.w  #$07FF,D3
02:00000C12 13C200FFE010    	  1141:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000C18 3403            	  1142:     move.w  D3,D2
02:00000C1A 263C00021986    	  1143:     move.l  #NES_YM_K5_PULSE,D3
02:00000C20 6100F7FC        	  1144:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1145:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000C24 103C0028        	  1146:     move.b  #$28,D0
02:00000C28 7200            	  1147:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000C2A 6100F7AA        	  1148:     bsr     ym_write1
02:00000C2E 103C00A4        	  1149:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000C32 1202            	  1150:     move.b  D2,D1
02:00000C34 6100F7A0        	  1151:     bsr     ym_write1
02:00000C38 103C00A0        	  1152:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000C3C 1203            	  1153:     move.b  D3,D1
02:00000C3E 6100F796        	  1154:     bsr     ym_write1
                            	  1155:     ; Key on ch 0, all ops
02:00000C42 103C0028        	  1156:     move.b  #$28,D0
02:00000C46 123C00F0        	  1157:     move.b  #$F0,D1
02:00000C4A 6000F78A        	  1158:     bra     ym_write1
                            	  1159: 
                            	  1160: ;==============================================================================
                            	  1161: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1162: ;==============================================================================
                            	  1163: emit_note_sq0:
02:00000C4E 024000FF        	  1164:     andi.w  #$FF,D0
02:00000C52 43F900000DE6    	  1165:     lea     (MusicNotePeriodTable).l,A1
02:00000C58 7400            	  1166:     moveq   #0,D2
02:00000C5A 14310001        	  1167:     move.b  1(A1,D0.w),D2
02:00000C5E 670000B4        	  1168:     beq     key_off_sq0
02:00000C62 7600            	  1169:     moveq   #0,D3
02:00000C64 16310000        	  1170:     move.b  0(A1,D0.w),D3
02:00000C68 E14B            	  1171:     lsl.w   #8,D3
02:00000C6A 8642            	  1172:     or.w    D2,D3
02:00000C6C 024307FF        	  1173:     andi.w  #$07FF,D3
02:00000C70 13C200FFE018    	  1174:     move.b  D2,(m_sq0_per).l
02:00000C76 3403            	  1175:     move.w  D3,D2
02:00000C78 263C00021986    	  1176:     move.l  #NES_YM_K5_PULSE,D3
02:00000C7E 6100F79E        	  1177:     bsr     nes_to_ym_freq
                            	  1178:     ; Key off first so the envelope attack phase retriggers
02:00000C82 103C0028        	  1179:     move.b  #$28,D0
02:00000C86 7201            	  1180:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C88 6100F74C        	  1181:     bsr     ym_write1
02:00000C8C 103C00A5        	  1182:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000C90 1202            	  1183:     move.b  D2,D1
02:00000C92 6100F742        	  1184:     bsr     ym_write1
02:00000C96 103C00A1        	  1185:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C9A 1203            	  1186:     move.b  D3,D1
02:00000C9C 6100F738        	  1187:     bsr     ym_write1
02:00000CA0 103C0028        	  1188:     move.b  #$28,D0
02:00000CA4 123C00F1        	  1189:     move.b  #$F1,D1
02:00000CA8 6000F72C        	  1190:     bra     ym_write1
                            	  1191: 
                            	  1192: ;==============================================================================
                            	  1193: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1194: ;==============================================================================
                            	  1195: emit_note_trg:
02:00000CAC 024000FF        	  1196:     andi.w  #$FF,D0
02:00000CB0 43F900000DE6    	  1197:     lea     (MusicNotePeriodTable).l,A1
02:00000CB6 7400            	  1198:     moveq   #0,D2
02:00000CB8 14310001        	  1199:     move.b  1(A1,D0.w),D2
02:00000CBC 6762            	  1200:     beq     key_off_trg
02:00000CBE 7600            	  1201:     moveq   #0,D3
02:00000CC0 16310000        	  1202:     move.b  0(A1,D0.w),D3
02:00000CC4 E14B            	  1203:     lsl.w   #8,D3
02:00000CC6 8642            	  1204:     or.w    D2,D3
02:00000CC8 024307FF        	  1205:     andi.w  #$07FF,D3
02:00000CCC 13C200FFE020    	  1206:     move.b  D2,(m_trg_per).l
02:00000CD2 3403            	  1207:     move.w  D3,D2
02:00000CD4 263C00010CC3    	  1208:     move.l  #NES_YM_K5_TRI,D3
02:00000CDA 6100F742        	  1209:     bsr     nes_to_ym_freq
                            	  1210:     ; Key off first so the bass envelope retriggers per note
02:00000CDE 103C0028        	  1211:     move.b  #$28,D0
02:00000CE2 7202            	  1212:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000CE4 6100F6F0        	  1213:     bsr     ym_write1
02:00000CE8 103C00A6        	  1214:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000CEC 1202            	  1215:     move.b  D2,D1
02:00000CEE 6100F6E6        	  1216:     bsr     ym_write1
02:00000CF2 103C00A2        	  1217:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000CF6 1203            	  1218:     move.b  D3,D1
02:00000CF8 6100F6DC        	  1219:     bsr     ym_write1
02:00000CFC 103C0028        	  1220:     move.b  #$28,D0
02:00000D00 123C00F2        	  1221:     move.b  #$F2,D1
02:00000D04 6000F6D0        	  1222:     bra     ym_write1
                            	  1223: 
                            	  1224: ;==============================================================================
                            	  1225: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1226: ;==============================================================================
                            	  1227: key_off_sq1:
02:00000D08 103C0028        	  1228:     move.b  #$28,D0
02:00000D0C 123C0000        	  1229:     move.b  #$00,D1
02:00000D10 6000F6C4        	  1230:     bra     ym_write1
                            	  1231: key_off_sq0:
02:00000D14 103C0028        	  1232:     move.b  #$28,D0
02:00000D18 123C0001        	  1233:     move.b  #$01,D1
02:00000D1C 6000F6B8        	  1234:     bra     ym_write1
                            	  1235: key_off_trg:
02:00000D20 103C0028        	  1236:     move.b  #$28,D0
02:00000D24 123C0002        	  1237:     move.b  #$02,D1
02:00000D28 6000F6AC        	  1238:     bra     ym_write1
                            	  1239: 
                            	  1240: ;==============================================================================
                            	  1241: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1242: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1243: ;
                            	  1244: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1245: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1246: ;     PsgDrumTable.
                            	  1247: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1248: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1249: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1250: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1251: ;     noise_decay_tick.
                            	  1252: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1253: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1254: ;==============================================================================
                            	  1255: set_psg_noise:
                            	  1256:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1257:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1258:     ; music drums resume on the next beat.
02:00000D2C 4A3900FF0606    	  1259:     tst.b   ($00FF0606).l
02:00000D32 661A            	  1260:     bne.s   .sfx_owns_psg
02:00000D34 4A01            	  1261:     tst.b   D1
02:00000D36 6618            	  1262:     bne.s   .not_rest
                            	  1263:     ; Rest: silence the PSG noise channel immediately.
02:00000D38 423900FFE026    	  1264:     clr.b   (m_noise_level).l
02:00000D3E 423900FFE027    	  1265:     clr.b   (m_noise_decay).l
02:00000D44 13FC00FF00C00011	  1266:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000D4C 4E75            	  1267:     rts
                            	  1268: .sfx_owns_psg:
02:00000D4E 4E75            	  1269:     rts
                            	  1270: .not_rest:
02:00000D50 7000            	  1271:     moveq   #0,D0
02:00000D52 1001            	  1272:     move.b  D1,D0
02:00000D54 E548            	  1273:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000D56 43F900000E8C    	  1274:     lea     (PsgDrumTable).l,A1
02:00000D5C D3C0            	  1275:     adda.l  D0,A1
02:00000D5E 1019            	  1276:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1277:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000D60 B03900FFE028    	  1278:     cmp.b   (m_last_psg_nc).l,D0
02:00000D66 670C            	  1279:     beq.s   .nc_same
02:00000D68 13C000FFE028    	  1280:     move.b  D0,(m_last_psg_nc).l
02:00000D6E 13C000C00011    	  1281:     move.b  D0,(PSG_PORT).l
                            	  1282: .nc_same:
02:00000D74 1019            	  1283:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D76 13C000FFE026    	  1284:     move.b  D0,(m_noise_level).l
02:00000D7C 1019            	  1285:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D7E 13C000FFE027    	  1286:     move.b  D0,(m_noise_decay).l
                            	  1287:     bra     write_psg_noise_vol
                            	  1288: 
                            	  1289: ;==============================================================================
                            	  1290: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1291: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1292: ; Preserves D1.
                            	  1293: ;==============================================================================
                            	  1294: write_psg_noise_vol:
02:00000D84 4A3900FF0606    	  1295:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D8A 6618            	  1296:     bne.s   .wpnv_skip
02:00000D8C 7000            	  1297:     moveq   #0,D0
02:00000D8E 103900FFE026    	  1298:     move.b  (m_noise_level).l,D0
02:00000D94 E808            	  1299:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D96 0A00000F        	  1300:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D9A 000000F0        	  1301:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D9E 13C000C00011    	  1302:     move.b  D0,(PSG_PORT).l
                            	  1303: .wpnv_skip:
02:00000DA4 4E75            	  1304:     rts
                            	  1305: 
                            	  1306: ;==============================================================================
                            	  1307: ; noise_decay_tick — linear envelope decay step.
                            	  1308: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1309: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1310: ; Preserves D1.
                            	  1311: ;==============================================================================
                            	  1312: noise_decay_tick:
02:00000DA6 4A3900FF0606    	  1313:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000DAC 661A            	  1314:     bne.s   .nd_done
02:00000DAE 103900FFE026    	  1315:     move.b  (m_noise_level).l,D0
02:00000DB4 6712            	  1316:     beq.s   .nd_done                        ; already silent
02:00000DB6 903900FFE027    	  1317:     sub.b   (m_noise_decay).l,D0
02:00000DBC 6402            	  1318:     bcc.s   .nd_store                       ; no underflow → new level
02:00000DBE 7000            	  1319:     moveq   #0,D0                           ; underflow → silent
                            	  1320: .nd_store:
02:00000DC0 13C000FFE026    	  1321:     move.b  D0,(m_noise_level).l
02:00000DC6 60BC            	  1322:     bra     write_psg_noise_vol
                            	  1323: .nd_done:
02:00000DC8 4E75            	  1324:     rts
                            	  1325: 
                            	  1326: ;==============================================================================
                            	  1327: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1328: ;==============================================================================
                            	  1329: music_silence:
02:00000DCA 423900FFE000    	  1330:     clr.b   (m_song).l
02:00000DD0 6100FF36        	  1331:     bsr     key_off_sq1
02:00000DD4 6100FF3E        	  1332:     bsr     key_off_sq0
02:00000DD8 6100FF46        	  1333:     bsr     key_off_trg
02:00000DDC 13FC00FF00C00011	  1334:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
