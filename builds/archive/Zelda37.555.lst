02:00034EB6 704C            	  4381:     moveq   #76,D0
02:00034EB8 19400344        	  4382:     move.b  D0,($0344,A4)
02:00034EBC 7621            	  4383:     moveq   #33,D3
02:00034EBE 6100C21E        	  4384:     jsr     Anim_WriteSpecificItemSprites
                            	  4385:     ; Draw triforce over Link.
                            	  4386:     ;
02:00034EC2 701B            	  4387:     moveq   #27,D0
02:00034EC4 7413            	  4388:     moveq   #19,D2
02:00034EC6 4EB90004703A    	  4389:     jsr     AnimateItemObject
02:00034ECC 7401            	  4390:     moveq   #1,D2
02:00034ECE 4EB90004910E    	  4391:     jsr     Anim_FetchObjPosForSpriteDescriptor
