02:00047B54 E308            	  3430:     lsl.b  #1,D0   ; ASL A
02:00047B56 6448            	  3431:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3432:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3433:     ;
