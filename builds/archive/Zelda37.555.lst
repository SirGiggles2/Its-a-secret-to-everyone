02:000409A6 8841            	  6900:     or.w    D1,D4             ; D4 = NES ptr addr
02:000409A8 48C4            	  6901:     ext.l   D4
02:000409AA D8BC00FF0000    	  6902:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000409B0 2044            	  6903:     movea.l D4,A0
02:000409B2 10303000        	  6904:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000409B6 0C0000C4        	  6905:     cmpi.b  #$C4,D0
02:000409BA 6728            	  6906:     beq  _L_z05_CheckShortcut_WriteStairs
02:000409BC 0C0000BC        	  6907:     cmpi.b  #$BC,D0
02:000409C0 6720            	  6908:     beq  _L_z05_CheckShortcut_Exit
02:000409C2 0C0000D8        	  6909:     cmpi.b  #$D8,D0
02:000409C6 661C            	  6910:     bne  _L_z05_CheckShortcut_WriteStairs
02:000409C8 102C052B        	  6911:     move.b  ($052B,A4),D0
02:000409CC 0C000062        	  6912:     cmpi.b  #$62,D0
02:000409D0 6712            	  6913:     beq  _L_z05_CheckShortcut_WriteStairs
                            	  6914:     ; Else make the tile object nothing, and write a black tile.
                            	  6915:     ; But this branch seems to be unused.
02:000409D2 7000            	  6916:     moveq   #0,D0
02:000409D4 1940052B        	  6917:     move.b  D0,($052B,A4)
02:000409D8 700C            	  6918:     moveq   #12,D0
