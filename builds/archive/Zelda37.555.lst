02:0003BA98 611C            	  7951:     jsr     PatraChild_Draw
                            	  7952:     ; If Patra's state still = 0, then the last patra child has not
                            	  7953:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  7954:     ;
02:0003BA9A 102C00AD        	  7955:     move.b  ($00AD,A4),D0
02:0003BA9E 6714            	  7956:     beq  _L_z04_PatraChild_State1_Exit
02:0003BAA0 4EB900031206    	  7957:     jsr     CheckMonsterCollisions
