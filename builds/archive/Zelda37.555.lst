                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002AA70 0000EA70        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA74 00012A70
02:0002AA78 00016A70        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
