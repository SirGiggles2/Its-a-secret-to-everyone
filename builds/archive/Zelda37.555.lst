02:00039F08 6608            	  4305:     bne  _anon_z04_85
02:00039F0A 41EC042C        	  4306:     lea     ($042C,A4),A0
02:00039F0E 52302000        	  4307:     addq.b  #1,(A0,D2.W)
                            	  4308: _anon_z04_85:
                            	  4309:     ; If the 16-bit speed has not reached the 16-bit target speed, then return.
                            	  4310:     ;
02:00039F12 41EC041F        	  4311:     lea     ($041F,A4),A0
02:00039F16 10302000        	  4312:     move.b  (A0,D2.W),D0
02:00039F1A 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039F1E 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039F22 B001            	  4315:     cmp.b   D1,D0
02:00039F24 6704            	  4316:     beq.s  __far_z_04_0038
02:00039F26 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
02:00039F2A 41EC042C        	  4319:     lea     ($042C,A4),A0
02:00039F2E 10302000        	  4320:     move.b  (A0,D2.W),D0
02:00039F32 41EC0444        	  4321:     lea     ($0444,A4),A0
02:00039F36 12302000        	  4322:     move.b  (A0,D2.W),D1
02:00039F3A B001            	  4323:     cmp.b   D1,D0
02:00039F3C 6704            	  4324:     beq.s  __far_z_04_0039
02:00039F3E 60000086        	  4325:     jmp  L116EA_Exit
                            	  4326: __far_z_04_0039:
                            	  4327:     ; Set speed flag to 1 meaning decelerate.
                            	  4328:     ;
02:00039F42 41EC045E        	  4329:     lea     ($045E,A4),A0
02:00039F46 52302000        	  4330:     addq.b  #1,(A0,D2.W)
                            	  4331:     ; Go set target speed to $0040 (or $0140 if this is a child).
                            	  4332:     ;
02:00039F4A 7040            	  4333:     moveq   #64,D0
02:00039F4C 6052            	  4334:     jmp     SetTargetSpeed
                            	  4335: 
                            	  4336:     even
                            	  4337: Digdogger_SlowDown:
                            	  4338:     ; Subtract 1 from 16-bit speed.
