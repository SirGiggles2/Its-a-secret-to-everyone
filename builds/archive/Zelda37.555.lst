                            	  4986: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  4987:     ; Bloated timer =>
                            	  4988:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  4989:     ; 1:     go advance the substate
                            	  4990:     ; other: go decrement Bloated timer
                            	  4991:     ;
02:0003A440 7600            	  4992:     moveq   #0,D3
02:0003A442 41EC045E        	  4993:     lea     ($045E,A4),A0
02:0003A446 16302000        	  4994:     move.b  (A0,D2.W),D3
02:0003A44A 5303            	  4995:     subq.b  #1,D3
02:0003A44C 6750            	  4996:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A44E 6B04            	  4997:     bmi.s  __far_z_04_0043
02:0003A450 60000080        	  4998:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  4999: __far_z_04_0043:
                            	  5000:     ; Set the bloated timer according to the substate.
                            	  5001:     ;
02:0003A454 7600            	  5002:     moveq   #0,D3
02:0003A456 41EC042C        	  5003:     lea     ($042C,A4),A0
02:0003A45A 16302000        	  5004:     move.b  (A0,D2.W),D3
02:0003A45E 41F90003A39C    	  5005:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A464 10303000        	  5006:     move.b  (A0,D3.W),D0
