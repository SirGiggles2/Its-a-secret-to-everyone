                            	  3614: InitMoldorm:
                            	  3615:     ; Loop to make 10 moldrom segments, from 9 to 0, indexed by Y register.
                            	  3616:     ; Object slots $A to 1 will be used.
                            	  3617:     ;
02:00039A2E 7609            	  3618:     moveq   #9,D3
                            	  3619: _anon_z04_77:
                            	  3620:     ; Start at position ($80, $70).
                            	  3621:     ;
02:00039A30 103C0080        	  3622:     move.b  #$80,D0
02:00039A34 19803071        	  3623:     move.b  D0,($71,A4,D3.W)
02:00039A38 7070            	  3624:     moveq   #112,D0
02:00039A3A 41EC0085        	  3625:     lea     ($0085,A4),A0
02:00039A3E 11803000        	  3626:     move.b  D0,(A0,D3.W)
                            	  3627:     ; Start with no direction, no deferred bounce direction,
                            	  3628:     ; and ready to update.
                            	  3629:     ;
02:00039A42 7000            	  3630:     moveq   #0,D0
02:00039A44 41EC0099        	  3631:     lea     ($0099,A4),A0
02:00039A48 11803000        	  3632:     move.b  D0,(A0,D3.W)
02:00039A4C 41EC03BD        	  3633:     lea     ($03BD,A4),A0
02:00039A50 11803000        	  3634:     move.b  D0,(A0,D3.W)
02:00039A54 41EC0406        	  3635:     lea     ($0406,A4),A0
02:00039A58 11803000        	  3636:     move.b  D0,(A0,D3.W)
02:00039A5C 41EC0493        	  3637:     lea     ($0493,A4),A0
02:00039A60 11803000        	  3638:     move.b  D0,(A0,D3.W)
                            	  3639:     ; Copy object attributes from the first monster slot.
                            	  3640:     ;
02:00039A64 102C04C0        	  3641:     move.b  ($04C0,A4),D0
02:00039A68 41EC04C0        	  3642:     lea     ($04C0,A4),A0
02:00039A6C 11803000        	  3643:     move.b  D0,(A0,D3.W)
                            	  3644:     ; Copy HP from the first monster slot.
                            	  3645:     ;
02:00039A70 102C0486        	  3646:     move.b  ($0486,A4),D0
02:00039A74 41EC0486        	  3647:     lea     ($0486,A4),A0
02:00039A78 11803000        	  3648:     move.b  D0,(A0,D3.W)
                            	  3649:     ; Start with flying speed $80, and in flying state 2.
                            	  3650:     ;
02:00039A7C 103C0080        	  3651:     move.b  #$80,D0
02:00039A80 41EC0420        	  3652:     lea     ($0420,A4),A0
02:00039A84 11803000        	  3653:     move.b  D0,(A0,D3.W)
02:00039A88 7002            	  3654:     moveq   #2,D0
02:00039A8A 41EC0445        	  3655:     lea     ($0445,A4),A0
02:00039A8E 11803000        	  3656:     move.b  D0,(A0,D3.W)
02:00039A92 7041            	  3657:     moveq   #65,D0
02:00039A94 41EC0350        	  3658:     lea     ($0350,A4),A0
02:00039A98 11803000        	  3659:     move.b  D0,(A0,D3.W)
                            	  3660:     ; Bottom of the loop.
                            	  3661:     ;
02:00039A9C 5303            	  3662:     subq.b  #1,D3
02:00039A9E 6A90            	  3663:     bpl  _anon_z04_77
                            	  3664:     ; Choose a random 8-way direction for the head segments
                            	  3665:     ; in slots 4 and 9.
                            	  3666:     ;
02:00039AA0 102C001D        	  3667:     move.b  ($001D,A4),D0
02:00039AA4 02000007        	  3668:     andi.b #$07,D0
02:00039AA8 7600            	  3669:     moveq   #0,D3
02:00039AAA 1600            	  3670:     move.b  D0,D3
02:00039AAC 41F90003C392    	  3671:     lea     (Directions8).l,A0
02:00039AB2 10303000        	  3672:     move.b  (A0,D3.W),D0
02:00039AB6 1940009D        	  3673:     move.b  D0,($009D,A4)
02:00039ABA 19400385        	  3674:     move.b  D0,($0385,A4)
02:00039ABE 102C0022        	  3675:     move.b  ($0022,A4),D0
02:00039AC2 02000007        	  3676:     andi.b #$07,D0
02:00039AC6 7600            	  3677:     moveq   #0,D3
02:00039AC8 1600            	  3678:     move.b  D0,D3
02:00039ACA 41F90003C392    	  3679:     lea     (Directions8).l,A0
02:00039AD0 10303000        	  3680:     move.b  (A0,D3.W),D0
02:00039AD4 194000A2        	  3681:     move.b  D0,($00A2,A4)
02:00039AD8 1940038A        	  3682:     move.b  D0,($038A,A4)
                            	  3683:     ; Set minimum number of turns 1 for flying states.
                            	  3684:     ;
                            	  3685:     ; By setting this, the first time that a flight control routine
                            	  3686:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  3687:     ; that flying state will immediately end, and object timer
                            	  3688:     ; will be left 0: ready for moldorm to decide a flying state
                            	  3689:     ; randomly and set timer to $10.
                            	  3690:     ;
02:00039ADC 7001            	  3691:     moveq   #1,D0
02:00039ADE 19400431        	  3692:     move.b  D0,($0431,A4)
02:00039AE2 19400436        	  3693:     move.b  D0,($0436,A4)
02:00039AE6 103C0080        	  3694:     move.b  #$80,D0
02:00039AEA 194004D1        	  3695:     move.b  D0,($04D1,A4)
02:00039AEE 7008            	  3696:     moveq   #8,D0
02:00039AF0 1940034E        	  3697:     move.b  D0,($034E,A4)
02:00039AF4 4E75            	  3698:     rts
                            	  3699: 
                            	  3700:     even
