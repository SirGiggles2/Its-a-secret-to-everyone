                            	  1012: .nt_noop:
                            	  1013:     ;======================================================================
                            	  1014:     ; T20: Attribute byte ($23C0–$23FF) → Genesis tile word palette bits.
                            	  1015:     ;
                            	  1016:     ; Each NES attribute byte covers a 4×4 tile block.  Two bits per quadrant:
                            	  1017:     ;   bits [1:0] = palette for quadrant 0 (top-left  2×2 tiles)
                            	  1018:     ;   bits [3:2] = palette for quadrant 1 (top-right 2×2 tiles)
                            	  1019:     ;   bits [5:4] = palette for quadrant 2 (bot-left  2×2 tiles)
                            	  1020:     ;   bits [7:6] = palette for quadrant 3 (bot-right 2×2 tiles)
                            	  1021:     ;
                            	  1022:     ; For each of the 16 affected tiles, look up the cached tile index
                            	  1023:     ; from NT_CACHE_BASE[row*32+col] and write the tile word to Plane A
                            	  1024:     ; with bits [12:11] set to the palette.  No VDP VRAM read required.
                            	  1025:     ;======================================================================
02:0000E654 0C413F00        	  1026:     cmpi.w  #$3F00,D1
02:0000E658 6400008A        	  1027:     bhs     .t19_palette            ; ≥$3F00: check palette range (widened for T39)
02:0000E65C 0C4123C0        	  1028:     cmpi.w  #$23C0,D1
02:0000E660 650000FA        	  1029:     blo     .nt_skip_write          ; $23C0 not reached yet — skip (shouldn't happen)
02:0000E664 0C412400        	  1030:     cmpi.w  #$2400,D1
02:0000E668 640000F2        	  1031:     bhs     .nt_skip_write          ; ≥$2400: overflow past attr table — skip
                            	  1032: 
                            	  1033:     ; ── T20 attribute decode ────────────────────────────�
                            	  1034:     ; offset = PPU_VADDR - $23C0 (0..63)
02:0000E66C 3401            	  1035:     move.w  D1,D2
02:0000E66E 044223C0        	  1036:     subi.w  #$23C0,D2               ; D2.w = attribute offset (0..63)
                            	  1037: 
                            	  1038:     ; tile_base_col = (offset & 7) * 4,  tile_base_row = (offset >> 3) * 4
02:0000E672 3602            	  1039:     move.w  D2,D3
02:0000E674 E64B            	  1040:     lsr.w   #3,D3
02:0000E676 E54B            	  1041:     lsl.w   #2,D3                   ; D3.w = tile_base_row (0..28)
                            	  1042:     ; T39 HUD/playfield split: same gate as the tile path. tile_base_row
                            	  1043:     ; is always a multiple of 4 (0, 4, 8, …, 28); an attr byte at row 0
                            	  1044:     ; covers tile rows 0-3 (HUD), at row 4+ covers playfield. Route
                            	  1045:     ; $2000-source attrs to HUD only, $2400-source attrs to playfield only.
02:0000E678 4A47            	  1046:     tst.w   D7
02:0000E67A 6608            	  1047:     bne.s   .nt_attr_src_2400
                            	  1048:     ; $2000-source: allow only tile_base_row == 0 (HUD rows 0-3).
02:0000E67C 4A43            	  1049:     tst.w   D3
02:0000E67E 660000DC        	  1050:     bne     .nt_skip_write
02:0000E682 6008            	  1051:     bra.s   .nt_attr_row_ok
                            	  1052: .nt_attr_src_2400:
                            	  1053:     ; $2400-source: allow only tile_base_row >= 4 (playfield rows 4+).
02:0000E684 0C430004        	  1054:     cmpi.w  #4,D3
02:0000E688 650000D2        	  1055:     blo     .nt_skip_write
                            	  1056: .nt_attr_row_ok:
02:0000E68C 02420007        	  1057:     andi.w  #$0007,D2
02:0000E690 E54A            	  1058:     lsl.w   #2,D2                   ; D2.w = tile_base_col (0..28)
                            	  1059: 
                            	  1060:     ; Save attribute byte in D4; process 4 quadrants using D5 = palette<<13
                            	  1061:     ; Genesis tile word palette field = bits [14:13].
                            	  1062:     ; palette<<13: lsl.w #5 then lsl.w #8 = total 13 bits  (immediate max is 8; both valid).
02:0000E692 1800            	  1063:     move.b  D0,D4
                            	  1064: 
                            	  1065:     ; Quadrant 0: bits [1:0], row_off=0, col_off=0
02:0000E694 3A04            	  1066:     move.w  D4,D5
