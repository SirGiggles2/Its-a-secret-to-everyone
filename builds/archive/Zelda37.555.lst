                            	  1381: ;----------------------------------------------------------------------
                            	  1382: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1383: ; Layout per slot:
                            	  1384: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1385: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1386: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1387: ;   +3 reserved
                            	  1388: ;
                            	  1389: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1390: ; values are placeholders.
                            	  1391: ;----------------------------------------------------------------------
                            	  1392: PsgDrumTable:
02:00000E8C E7              	  1393:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000E8D 00
02:00000E8E 00
02:00000E8F 00
02:00000E90 E4              	  1394:     dc.b    $E4, $E0, 48,  $00         ; 1: hi-hat  — white NF=00, ~5 frames
02:00000E91 E0
02:00000E92 30
02:00000E93 00
02:00000E94 E5              	  1395:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000E95 FF
02:00000E96 0E
02:00000E97 00
02:00000E98 E4              	  1396:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
02:00000E99 E0
02:00000E9A 30
02:00000E9B 00
