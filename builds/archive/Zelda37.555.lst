02:00038312 41EC0084        	   320:     lea     ($0084,A4),A0
02:00038316 12302000        	   321:     move.b  (A0,D2.W),D1
02:0003831A 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003831E 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:00038320 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
02:00038324 6A0C            	   325:     bpl  _anon_z04_9
02:00038326 4600            	   326:     eori.b #$FF,D0
02:00038328 023C00EE        	   327:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003832C 123C0001        	   328:     move.b  #$01,D1
02:00038330 D101            	   329:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
