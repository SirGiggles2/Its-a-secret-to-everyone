                            	  6928: _L_z05_CheckShortcut_WriteStairs:
02:000409E4 7010            	  6929:     moveq   #16,D0
02:000409E6 1940000D        	  6930:     move.b  D0,($000D,A4)
02:000409EA 7070            	  6931:     moveq   #112,D0
