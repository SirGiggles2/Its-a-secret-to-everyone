02:0003BB1A 0200000F        	  8029:     andi.b #$0F,D0
02:0003BB1E 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003BB22 6702            	  8031:     beq.s  __far_z_04_0087
02:0003BB24 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
