02:0003B9B4 41EC0098        	  7842:     lea     ($0098,A4),A0
02:0003B9B8 11802000        	  7843:     move.b  D0,(A0,D2.W)
                            	  7844:     ; Set angle $18 (N).
                            	  7845:     ;
02:0003B9BC 7018            	  7846:     moveq   #24,D0
02:0003B9BE 41EC0394        	  7847:     lea     ($0394,A4),A0
02:0003B9C2 11802000        	  7848:     move.b  D0,(A0,D2.W)
                            	  7849:     ; This location is right above Patra.
                            	  7850:     ; Set X coordinate to Patra's.
                            	  7851:     ;
02:0003B9C6 102C0071        	  7852:     move.b  ($0071,A4),D0
02:0003B9CA 19802070        	  7853:     move.b  D0,($70,A4,D2.W)
                            	  7854:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  7855:     ; Else use radius $18. Store the chosen value in [00].
                            	  7856:     ;
02:0003B9CE 702C            	  7857:     moveq   #44,D0
02:0003B9D0 7600            	  7858:     moveq   #0,D3
02:0003B9D2 41EC034F        	  7859:     lea     ($034F,A4),A0
02:0003B9D6 16302000        	  7860:     move.b  (A0,D2.W),D3
02:0003B9DA 0C030025        	  7861:     cmpi.b  #$25,D3
02:0003B9DE 6702            	  7862:     beq  _anon_z04_158
02:0003B9E0 7018            	  7863:     moveq   #24,D0
                            	  7864: _anon_z04_158:
02:0003B9E2 1880            	  7865:     move.b  D0,($0000,A4)
