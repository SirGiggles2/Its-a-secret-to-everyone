02:0003BC08 41EC00AC        	  8199:     lea     ($00AC,A4),A0
02:0003BC0C 10302000        	  8200:     move.b  (A0,D2.W),D0
02:0003BC10 0C000030        	  8201:     cmpi.b  #$30,D0
