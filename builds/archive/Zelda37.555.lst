02:00038EB2 7600            	  1992:     moveq   #0,D3
02:00038EB4 1600            	  1993:     move.b  D0,D3
02:00038EB6 41F900038CC6    	  1994:     lea     (RedLeeverStateQSpeeds).l,A0
02:00038EBC 10303000        	  1995:     move.b  (A0,D3.W),D0
02:00038EC0 41EC03BC        	  1996:     lea     ($03BC,A4),A0
02:00038EC4 11802000        	  1997:     move.b  D0,(A0,D2.W)
02:00038EC8 41F900038CCC    	  1998:     lea     (RedLeeverStateTimes).l,A0
02:00038ECE 10303000        	  1999:     move.b  (A0,D3.W),D0
02:00038ED2 19802028        	  2000:     move.b  D0,($28,A4,D2.W)
                            	  2001:     even
                            	  2002: RedLeever_AnimateAndCheckCollisions:
02:00038ED6 7600            	  2003:     moveq   #0,D3
02:00038ED8 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038EDC 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038EE0 41F900038CD2    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038EE6 10303000        	  2007:     move.b  (A0,D3.W),D0
02:00038EEA 6000FD20        	  2008:     jmp     Burrower_AnimateDrawAndCheckCollisions
                            	  2009: 
