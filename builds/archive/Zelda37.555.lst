                            	  5650: CalcBoomerangFrame:
                            	  5651:     ; The minor state (low 3 bits of state) is used to
                            	  5652:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5653:     ;
                            	  5654:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5655:     ; In other words, don't offset the coordinate below.
                            	  5656:     ;
02:000489B2 7000            	  5657:     moveq   #0,D0
02:000489B4 1880            	  5658:     move.b  D0,($0000,A4)
02:000489B6 41EC00AC        	  5659:     lea     ($00AC,A4),A0
02:000489BA 10302000        	  5660:     move.b  (A0,D2.W),D0
02:000489BE 0200000F        	  5661:     andi.b #$0F,D0
02:000489C2 7600            	  5662:     moveq   #0,D3
02:000489C4 1600            	  5663:     move.b  D0,D3
02:000489C6 7000            	  5664:     moveq   #0,D0
02:000489C8 19400001        	  5665:     move.b  D0,($0001,A4)
02:000489CC 41F9000485BA    	  5666:     lea     (BoomerangFrameCycle).l,A0
02:000489D2 10303000        	  5667:     move.b  (A0,D3.W),D0
02:000489D6 1940000C        	  5668:     move.b  D0,($000C,A4)
                            	  5669:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5670:     ;
02:000489DA 1003            	  5671:     move.b  D3,D0
02:000489DC 41F9000485C4    	  5672:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:000489E2 10303000        	  5673:     move.b  (A0,D3.W),D0
02:000489E6 19400004        	  5674:     move.b  D0,($0004,A4)
                            	  5675:     ; TODO: ?
                            	  5676:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5677:     ; Else add the item value of the magic boomerang.
                            	  5678:     ;
                            	  5679:     ; But none of the values in the base sprite attributes array is 8.
                            	  5680:     ;
                            	  5681:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5682:     ; the inventory will always be added to the base sprite attribute.
                            	  5683:     ;
                            	  5684:     ; So, palette row 4 or 5 will be chosen.
                            	  5685:     ;
02:000489EA 7600            	  5686:     moveq   #0,D3
02:000489EC 0C000008        	  5687:     cmpi.b  #$08,D0
02:000489F0 6706            	  5688:     beq  _anon_z07_31
02:000489F2 7600            	  5689:     moveq   #0,D3
02:000489F4 162C0675        	  5690:     move.b  ($0675,A4),D3
