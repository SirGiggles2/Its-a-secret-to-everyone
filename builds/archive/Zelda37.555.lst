                            	  5489: _anon_z07_30:
02:00048874 4EB900030ADA    	  5490:     jsr     GetDirectionsAndDistancesToTarget
                            	  5491:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5492:     ; then go move towards the thrower, draw, and check collisions.
                            	  5493:     ;
02:0004887A 1014            	  5494:     move.b  ($0000,A4),D0
