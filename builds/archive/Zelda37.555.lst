                            	   100: 
                            	   101: ; Per-frame burst size at ~60 Hz VBlank.  Computed as
                            	   102: ; round(dmc_rate_hz / 60) so playback speed matches the NES
                            	   103: ; original.  Used by dmc_feed to drain exactly one frame's
                            	   104: ; worth of PCM bytes per music_tick.
                            	   105:     even
                            	   106: DMC_SAMPLE_BURST60:
02:000019A2 0228            	   107:     dc.w    552                     ; 1 (33144 Hz)
02:000019A4 0228            	   108:     dc.w    552                     ; 2 (33144 Hz)
02:000019A6 0163            	   109:     dc.w    355                     ; 3 (21307 Hz)
02:000019A8 0228            	   110:     dc.w    552                     ; 4 (33144 Hz)
02:000019AA 019E            	   111:     dc.w    414                     ; 5 (24858 Hz)
02:000019AC 0228            	   112:     dc.w    552                     ; 6 (33144 Hz)
02:000019AE 019E            	   113:     dc.w    414                     ; 7 (24858 Hz)
                            	   114: 
                            	   115: ; dbra-count per sample for dmc_trigger's synchronous cycle-paced
                            	   116: ; streamer.  M68K runs at 7.67 MHz NTSC; a sample at rate_hz needs
                            	   117: ; one DAC write every (7670000 / rate_hz) cycles.  Fixed overhead
                            	   118: ; per byte in the streamer inner loop is ~50 cycles; the dbra spin
                            	   119: ; loop contributes 10*N + 4 cycles for dbra count N.  So:
                            	   120: ;     N = round((cycles_per_byte - 54) / 10)
                            	   121: ; Clamp to zero so a too-slow-CPU assumption never goes negative.
                            	   122:     even
                            	   123: DMC_SAMPLE_SPIN:
02:000019B0 0012            	   124:     dc.w    18                     ; 1 (33144 Hz, 231 cyc/byte)
02:000019B2 0012            	   125:     dc.w    18                     ; 2 (33144 Hz, 231 cyc/byte)
02:000019B4 001F            	   126:     dc.w    31                     ; 3 (21307 Hz, 360 cyc/byte)
02:000019B6 0012            	   127:     dc.w    18                     ; 4 (33144 Hz, 231 cyc/byte)
02:000019B8 0019            	   128:     dc.w    25                     ; 5 (24858 Hz, 309 cyc/byte)
02:000019BA 0012            	   129:     dc.w    18                     ; 6 (33144 Hz, 231 cyc/byte)
02:000019BC 0019            	   130:     dc.w    25                     ; 7 (24858 Hz, 309 cyc/byte)
