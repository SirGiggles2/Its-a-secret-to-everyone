02:00038ADC 41EC0412        	  1484:     lea     ($0412,A4),A0
02:00038AE0 10302000        	  1485:     move.b  (A0,D2.W),D0
02:00038AE4 41EC0084        	  1486:     lea     ($0084,A4),A0
02:00038AE8 12302000        	  1487:     move.b  (A0,D2.W),D1
02:00038AEC D101            	  1488:     addx.b  D1,D0   ; ADC ObjY,X
02:00038AEE 41EC0084        	  1489:     lea     ($0084,A4),A0
02:00038AF2 11802000        	  1490:     move.b  D0,(A0,D2.W)
