                            	   739: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F5A4 1214            	   740:     move.b  ($00,A4),D1   ; ptr lo
02:0002F5A6 182C0001        	   741:     move.b  ($01,A4),D4  ; ptr hi
02:0002F5AA 024100FF        	   742:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F5AE E14C            	   743:     lsl.w   #8,D4
02:0002F5B0 8841            	   744:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F5B2 48C4            	   745:     ext.l   D4
02:0002F5B4 D8BC00FF0000    	   746:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F5BA 2044            	   747:     movea.l D4,A0
02:0002F5BC 10303000        	   748:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F5C0 122C0002        	   749:     move.b  ($02,A4),D1   ; ptr lo
02:0002F5C4 182C0003        	   750:     move.b  ($03,A4),D4  ; ptr hi
02:0002F5C8 024100FF        	   751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F5CC E14C            	   752:     lsl.w   #8,D4
02:0002F5CE 8841            	   753:     or.w    D1,D4
02:0002F5D0 48C4            	   754:     ext.l   D4
02:0002F5D2 D8BC00FF0000    	   755:     add.l   #NES_RAM,D4
02:0002F5D8 2044            	   756:     movea.l D4,A0
02:0002F5DA 11803000        	   757:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   758:     ; Increment source address.
                            	   759:     ;
02:0002F5DE 1014            	   760:     move.b  ($0000,A4),D0
02:0002F5E0 023C00EE        	   761:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F5E4 123C0001        	   762:     move.b  #$01,D1
02:0002F5E8 D101            	   763:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F5EA 1880            	   764:     move.b  D0,($0000,A4)
02:0002F5EC 102C0001        	   765:     move.b  ($0001,A4),D0
02:0002F5F0 123C0000        	   766:     move.b  #$00,D1
02:0002F5F4 D101            	   767:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F5F6 19400001        	   768:     move.b  D0,($0001,A4)
                            	   769:     ; Increment destination address.
                            	   770:     ;
02:0002F5FA 102C0002        	   771:     move.b  ($0002,A4),D0
