02:00030F5A 10303000        	  2181:     move.b  (A0,D3.W),D0
02:00030F5E 6100022C        	  2182:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2183: _anon_z01_76:
                            	  2184:     ; If it's Link, write the sprites. He's never mirrored.
                            	  2185:     ;
02:00030F62 4A02            	  2186:     cmpi.b  #$00,D2
02:00030F64 6602            	  2187:     bne.s  __far_z_01_0002
02:00030F66 6014            	  2188:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  2189: __far_z_01_0002:
                            	  2190:     ; For other objects, the caller controls mirroring and flipping.
                            	  2191:     ;
                            	  2192:     ; If mirrored [0C], then draw it mirrored.
                            	  2193:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  2194:     ;
02:00030F68 7600            	  2195:     moveq   #0,D3
