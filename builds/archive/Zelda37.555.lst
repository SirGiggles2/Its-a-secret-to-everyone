                            	   937: ;==============================================================================
                            	   938: ; fs_to_transpiled_trampoline — Native FS → transpiled gameplay/register-name
                            	   939: ; handoff. Mirror of intro_to_file_select_trampoline but enters at
                            	   940: ; UpdateMode1Menu_Sub1 (chose-slot path) with CurSaveSlot pre-seeded.
                            	   941: ;
                            	   942: ; Caller (fs_handoff.c) passes save_slot in D0 (low byte). For empty slots,
                            	   943: ; pass 3 → transpiled chose-slot path detects CurSaveSlot >= 3 and routes
                            	   944: ; to register-name (Mode 1 Sub1 → GameMode = slot+$0B = $0E).
                            	   945: ; For occupied slots, pass 0/1/2 → ChoseSlot copies items + JMP GoToNextMode
                            	   946: ; → Mode 2 → eventually Mode 5 (gameplay).
                            	   947: ;
                            	   948: ; Placed at end-of-file (after all zelda_translated includes) so its byte
                            	   949: ; size doesn't push transpiled .s short-branches out of range.
                            	   950: ;
                            	   951: ; Does NOT return.
                            	   952: ;==============================================================================
                            	   953:     xdef    fs_to_transpiled_trampoline
                            	   954: fs_to_transpiled_trampoline:
                            	   955:     ; No-arg trampoline. Caller (fs_handoff.c) writes CurSaveSlot at
                            	   956:     ; nes_ram[0x0016] directly before calling — m68k SysV byte-arg passing
                            	   957:     ; via D0 is unreliable (caller stack-pushes ints), so doing the seed
                            	   958:     ; in C avoids the ABI guesswork.
                            	   959: 
02:00049B1A 13FC00CC00FF07F2	   960:     move.b  #$CC,($00FF07F2).l       ; probe: fs trampoline entered
                            	   961: 
                            	   962:     ; [1] Restore translated runtime register contract.
02:00049B22 287C00FF0000    	   963:     move.l  #$00FF0000,A4
02:00049B28 2A7C00FF0200    	   964:     move.l  #$00FF0200,A5
02:00049B2E 7EFF            	   965:     moveq   #-1,D7
                            	   966: 
                            	   967:     ; [2] Hand off to transpiled FS at Sub 0 (initial state). Transpiled
                            	   968:     ;     FS init runs InitMode1_Full → UpdateMode1Menu_Sub0; player picks
                            	   969:     ;     slot via real transpiled flow. Native FS is the intro screen
                            	   970:     ;     replacement; transpiled FS still owns the actual save selection.
02:00049B30 197C00000011    	   971:     move.b  #$00,($0011,A4)          ; IsUpdatingMode = 0 (next NMI runs InitMode)
02:00049B36 197C00010012    	   972:     move.b  #$01,($0012,A4)          ; GameMode = $01 (file-select)
02:00049B3C 197C00000013    	   973:     move.b  #$00,($0013,A4)          ; GameSubmode = $00 (initial)
02:00049B42 13FC000100FF042B	   974:     move.b  #$01,(FrontendStartReleaseGate).l ; Start consumed
02:00049B4A 13FC000100FF083D	   975:     move.b  #$01,(VRamForceBlankGate).l       ; VRAM streaming protection
02:00049B52 197C00000600    	   976:     move.b  #$00,($0600,A4)          ; SongRequest = 0
                            	   977: 
                            	   978:     ; [3] Re-enable transpiled NMI heartbeat.
02:00049B58 102C00FF        	   979:     move.b  ($00FF,A4),D0
02:00049B5C 00000080        	   980:     ori.b   #$80,D0
02:00049B60 194000FF        	   981:     move.b  D0,($00FF,A4)
02:00049B64 13C000FF0804    	   982:     move.b  D0,(PPU_CTRL).l
                            	   983: 
                            	   984:     ; [4] VDP gameplay defaults (V64 + Window V=8).
02:00049B6A 33FC901100C00004	   985:     move.w  #$9011,(VDP_CTRL).l
02:00049B72 33FC920800C00004	   986:     move.w  #$9208,(VDP_CTRL).l
                            	   987: 
                            	   988:     ; [5] Flip dispatcher.
02:00049B7A 13FC000100FF0FFC	   989:     move.b  #1,(vblank_mode).l
                            	   990: 
                            	   991:     ; [6] Spin.
02:00049B82 6000D064        	   992:     jmp     LoopForever
                            	   993: 
