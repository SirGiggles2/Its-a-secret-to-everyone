02:00048B8A 41EC00AC        	  5896:     lea     ($00AC,A4),A0
02:00048B8E 10302000        	  5897:     move.b  (A0,D2.W),D0
02:00048B92 0200000F        	  5898:     andi.b #$0F,D0
02:00048B96 7600            	  5899:     moveq   #0,D3
02:00048B98 1600            	  5900:     move.b  D0,D3
02:00048B9A 7008            	  5901:     moveq   #8,D0
02:00048B9C 5303            	  5902:     subq.b  #1,D3
02:00048B9E 6708            	  5903:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048BA0 41EC0098        	  5904:     lea     ($0098,A4),A0
02:00048BA4 10302000        	  5905:     move.b  (A0,D2.W),D0
