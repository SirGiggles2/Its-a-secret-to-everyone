02:00030EDE 19400343        	  2132:     move.b  D0,($0343,A4)
02:00030EE2 704C            	  2133:     moveq   #76,D0
                            	  2134:     even
                            	  2135: DrawObjectWithAnimAndSpecificSprites:
02:00030EE4 19400344        	  2136:     move.b  D0,($0344,A4)
02:00030EE8 7600            	  2137:     moveq   #0,D3
02:00030EEA 162C000E        	  2138:     move.b  ($000E,A4),D3
02:00030EEE 7001            	  2139:     moveq   #1,D0
02:00030EF0 19400007        	  2140:     move.b  D0,($0007,A4)
02:00030EF4 7008            	  2141:     moveq   #8,D0
02:00030EF6 1940000A        	  2142:     move.b  D0,($000A,A4)
02:00030EFA 41F900030C4A    	  2143:     lea     (ObjAnimations).l,A0
02:00030F00 10303000        	  2144:     move.b  (A0,D3.W),D0
02:00030F04 023C00EE        	  2145:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030F08 122C000D        	  2146:     move.b  ($000D,A4),D1
02:00030F0C D101            	  2147:     addx.b  D1,D0   ; ADC $0D
02:00030F0E 7600            	  2148:     moveq   #0,D3
02:00030F10 1600            	  2149:     move.b  D0,D3
02:00030F12 41F900030CCA    	  2150:     lea     (ObjAnimFrameHeap).l,A0
02:00030F18 10303000        	  2151:     move.b  (A0,D3.W),D0
02:00030F1C 19400002        	  2152:     move.b  D0,($0002,A4)
02:00030F20 023C00EE        	  2153:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030F24 123C0002        	  2154:     move.b  #$02,D1
02:00030F28 D101            	  2155:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030F2A 19400003        	  2156:     move.b  D0,($0003,A4)
                            	  2157:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  2158:     ; then go set attributes and write sprites.
                            	  2159:     ;
02:00030F2E 4A02            	  2160:     cmpi.b  #$00,D2
02:00030F30 6722            	  2161:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00030F32 0C02000D        	  2162:     cmpi.b  #$0D,D2
02:00030F36 641C            	  2163:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  2164:     ; If the object has a "half-width draw" attribute, then
                            	  2165:     ; go draw half-width.
                            	  2166:     ;
02:00030F38 41EC04BF        	  2167:     lea     ($04BF,A4),A0
02:00030F3C 10302000        	  2168:     move.b  (A0,D2.W),D0
02:00030F40 02000002        	  2169:     andi.b #$02,D0
02:00030F44 6630            	  2170:     bne  _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth
                            	  2171:     ; If the object has the "Ignore sprite attribute table" attribute,
                            	  2172:     ; then don't look up sprite attributes.
                            	  2173:     ;
02:00030F46 41EC04BF        	  2174:     lea     ($04BF,A4),A0
02:00030F4A 10302000        	  2175:     move.b  (A0,D2.W),D0
02:00030F4E 02000008        	  2176:     andi.b #$08,D0
02:00030F52 660E            	  2177:     bne  _anon_z01_76
                            	  2178:     even
                            	  2179: _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr:
