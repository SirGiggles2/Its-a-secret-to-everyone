02:0003BA10 19802070        	  7889:     move.b  D0,($70,A4,D2.W)
02:0003BA14 41EC0084        	  7890:     lea     ($0084,A4),A0
02:0003BA18 10302000        	  7891:     move.b  (A0,D2.W),D0
02:0003BA1C 023C00EE        	  7892:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA20 122C0479        	  7893:     move.b  ($0479,A4),D1
02:0003BA24 D101            	  7894:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003BA26 41EC0084        	  7895:     lea     ($0084,A4),A0
02:0003BA2A 11802000        	  7896:     move.b  D0,(A0,D2.W)
                            	  7897:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  7898:     ;
02:0003BA2E 7000            	  7899:     moveq   #0,D0
02:0003BA30 1940000B        	  7900:     move.b  D0,($000B,A4)
                            	  7901:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  7902:     ; monster's angle by $70, else by $60 to go slower.
                            	  7903:     ;
02:0003BA34 7070            	  7904:     moveq   #112,D0
02:0003BA36 7600            	  7905:     moveq   #0,D3
02:0003BA38 41EC034F        	  7906:     lea     ($034F,A4),A0
02:0003BA3C 16302000        	  7907:     move.b  (A0,D2.W),D3
02:0003BA40 0C030025        	  7908:     cmpi.b  #$25,D3
02:0003BA44 6702            	  7909:     beq  _anon_z04_159
02:0003BA46 7060            	  7910:     moveq   #96,D0
                            	  7911: _anon_z04_159:
02:0003BA48 61000CC0        	  7912:     jsr     DecreaseObjectAngle
                            	  7913:     ; Load Patra's maneuver index.
                            	  7914:     ; It determines which counts of bits are looked up below.
                            	  7915:     ;
02:0003BA4C 7600            	  7916:     moveq   #0,D3
02:0003BA4E 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003BA52 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003BA56 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003BA5A 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003BA5E 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BA60 41F90003B952    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003BA66 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0003BA6A 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0003BA6C 41F90003B956    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0003BA72 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003BA76 7600            	  7931:     moveq   #0,D3
02:0003BA78 1600            	  7932:     move.b  D0,D3
02:0003BA7A 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003BA7C 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0003BA7E 41F90003B954    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003BA84 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003BA88 7600            	  7944:     moveq   #0,D3
02:0003BA8A 1600            	  7945:     move.b  D0,D3
                            	  7946:     even
