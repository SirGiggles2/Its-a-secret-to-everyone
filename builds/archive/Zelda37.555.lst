                            	  2144: ModeE_HandleAOrB:
02:000337CA 102C0420        	  2145:     move.b  ($0420,A4),D0
                            	  2146:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2147:     ; the name field.
02:000337CE 6646            	  2148:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:000337D0 7600            	  2149:     moveq   #0,D3
02:000337D2 162C0016        	  2150:     move.b  ($0016,A4),D3
02:000337D6 0C030003        	  2151:     cmpi.b  #$03,D3
02:000337DA 6602            	  2152:     bne.s  __far_z_02_0002
02:000337DC 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:000337DE 41F9000331F2    	  2157:     lea     (SlotToNameOffset).l,A0
02:000337E4 10303000        	  2158:     move.b  (A0,D3.W),D0
02:000337E8 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:000337EC 7400            	  2162:     moveq   #0,D2
02:000337EE 41F9000331F6    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:000337F4 14303000        	  2164:     move.b  (A0,D3.W),D2
02:000337F8 7602            	  2165:     moveq   #2,D3
                            	  2166:     even
                            	  2167: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:000337FA 41F9000331C2    	  2168:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00033800 10302000        	  2169:     move.b  (A0,D2.W),D0
02:00033804 41EC0422        	  2170:     lea     ($0422,A4),A0
02:00033808 11803000        	  2171:     move.b  D0,(A0,D3.W)
02:0003380C 5302            	  2172:     subq.b  #1,D2
02:0003380E 5303            	  2173:     subq.b  #1,D3
02:00033810 6AE8            	  2174:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033812 522C0420        	  2175:     addq.b  #1,($0420,A4)
                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:00033816 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:0003381A 020000C0        	  2186:     andi.b #$C0,D0
02:0003381E 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:00033822 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033826 660000A6        	  2191:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2192:     ; A was pressed.
                            	  2193:     ;
                            	  2194:     ; Request to play the character click tune (same as bomb set).
02:0003382A 7620            	  2195:     moveq   #32,D3
02:0003382C 19430604        	  2196:     move.b  D3,($0604,A4)
02:00033830 7602            	  2197:     moveq   #2,D3
                            	  2198:     even
                            	  2199: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033832 41EC0422        	  2200:     lea     ($0422,A4),A0
02:00033836 10303000        	  2201:     move.b  (A0,D3.W),D0
02:0003383A 41EC0302        	  2202:     lea     ($0302,A4),A0
02:0003383E 11803000        	  2203:     move.b  D0,(A0,D3.W)
02:00033842 5303            	  2204:     subq.b  #1,D3
02:00033844 6AEC            	  2205:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033846 19430306        	  2206:     move.b  D3,($0306,A4)
02:0003384A 7400            	  2207:     moveq   #0,D2
02:0003384C 142C0421        	  2208:     move.b  ($0421,A4),D2
02:00033850 7600            	  2209:     moveq   #0,D3
02:00033852 162C041F        	  2210:     move.b  ($041F,A4),D3
02:00033856 41F900033196    	  2211:     lea     (ModeE_CharMap).l,A0
02:0003385C 10303000        	  2212:     move.b  (A0,D3.W),D0
02:00033860 19400305        	  2213:     move.b  D0,($0305,A4)
02:00033864 41EC0638        	  2214:     lea     ($0638,A4),A0
02:00033868 11802000        	  2215:     move.b  D0,(A0,D2.W)
                            	  2216:     even
                            	  2217: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:0003386C 102C0070        	  2218:     move.b  ($0070,A4),D0
02:00033870 023C00EE        	  2219:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033874 123C0008        	  2220:     move.b  #$08,D1
02:00033878 D101            	  2221:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003387A 19400070        	  2222:     move.b  D0,($0070,A4)
02:0003387E 522C0421        	  2223:     addq.b  #1,($0421,A4)
02:00033882 522C0423        	  2224:     addq.b  #1,($0423,A4)
                            	  2225:     ; If VRAM address still points inside the name field,
                            	  2226:     ; then go finish.
                            	  2227:     ;
                            	  2228:     ; The idea is that each name field in nametable begins at
                            	  2229:     ; an address ending in $E. For example, slot 0 has a name
                            	  2230:     ; at VRAM addresses $20CE to $20D5.
                            	  2231:     ;
                            	  2232:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2233:     ; the name field.
                            	  2234:     ;
                            	  2235:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2236:     ; record header.
                            	  2237:     ;
02:00033886 102C0070        	  2238:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:0003388A 0C0000B0        	  2239:     cmpi.b  #$B0,D0
02:0003388E 6678            	  2240:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2241:     ; The VRAM address now points outside the name field.
                            	  2242:     ; So, wrap around to the beginning of the name field.
                            	  2243:     ;
                            	  2244:     ; For example, $20D6 -> $20CE.
                            	  2245:     ;
02:00033890 102C0423        	  2246:     move.b  ($0423,A4),D0
02:00033894 003C0011        	  2247:     ori     #$11,CCR  ; SEC: set C+X
02:00033898 123C0008        	  2248:     move.b  #$08,D1
02:0003389C 0A3C0010        	  2249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338A0 9101            	  2250:     subx.b  D1,D0   ; SBC #$08
02:000338A2 0A3C0010        	  2251:     eori    #$10,CCR  ; restore X = 6502 C
02:000338A6 19400423        	  2252:     move.b  D0,($0423,A4)
                            	  2253:     ; It also means that we went past the end of the save slot
                            	  2254:     ; info name. Set the offset to the beginning of the name.
02:000338AA 7600            	  2255:     moveq   #0,D3
02:000338AC 162C0016        	  2256:     move.b  ($0016,A4),D3
02:000338B0 41F9000331F2    	  2257:     lea     (SlotToNameOffset).l,A0
02:000338B6 10303000        	  2258:     move.b  (A0,D3.W),D0
02:000338BA 19400421        	  2259:     move.b  D0,($0421,A4)
                            	  2260:     ; If the name cursor has gone past the end of the field,
                            	  2261:     ; then wrap around.
02:000338BE 102C0070        	  2262:     move.b  ($0070,A4),D0
02:000338C2 0C0000B0        	  2263:     cmpi.b  #$B0,D0
02:000338C6 6640            	  2264:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:000338C8 7070            	  2265:     moveq   #112,D0
02:000338CA 19400070        	  2266:     move.b  D0,($0070,A4)
                            	  2267:     even
                            	  2268: ; PATCH P25b: FS2-E backspace handler.
                            	  2269: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2270: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2271: ; one column (8 px), and writes a space ($24) to the erased
                            	  2272: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2273: ; cannot cross into a previous slot's name field.
                            	  2274: _L_z02_ModeE_HandleAOrB_Backspace:
02:000338CE 7600            	  2275:     moveq   #0,D3
02:000338D0 162C0016        	  2276:     move.b  ($0016,A4),D3        ; D3 = current slot
02:000338D4 41F9000331F2    	  2277:     lea     (SlotToNameOffset).l,A0
02:000338DA 12303000        	  2278:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:000338DE 102C0421        	  2279:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:000338E2 B001            	  2280:     cmp.b   D1,D0
02:000338E4 6322            	  2281:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:000338E6 5300            	  2282:     subq.b  #1,D0
02:000338E8 19400421        	  2283:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:000338EC 532C0423        	  2284:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:000338F0 122C0070        	  2285:     move.b  ($0070,A4),D1
02:000338F4 5101            	  2286:     subi.b  #8,D1
02:000338F6 19410070        	  2287:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:000338FA 7224            	  2288:     moveq   #$24,D1              ; space tile
02:000338FC 7600            	  2289:     moveq   #0,D3
02:000338FE 1600            	  2290:     move.b  D0,D3                ; D3 = erased offset
02:00033900 41EC0638        	  2291:     lea     ($0638,A4),A0
02:00033904 11813000        	  2292:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2293:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2294:     even
                            	  2295: _L_z02_ModeE_HandleAOrB_Exit:
02:00033908 60000096        	  2296:     jmp     ModeE_SetNameCursorSpriteX
                            	  2297: 
                            	  2298:     even
                            	  2299: ModeEandF_SetUpCursorSprites:
                            	  2300:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2301:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2302:     ; These are the cursor sprites.
