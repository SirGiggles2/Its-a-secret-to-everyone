                            	  1465:     even
                            	  1466: InitMode4:
02:0003D5EC 7400            	  1467:     moveq   #0,D2
02:0003D5EE 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003D5F2 6604            	  1469:     bne.s  __far_z_05_0023
02:0003D5F4 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003D5F8 5302            	  1472:     subq.b  #1,D2
02:0003D5FA 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003D5FC 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003D600 6B06            	  1492:     bmi  _anon_z05_40
02:0003D602 6100348E        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003D606 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003D608 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003D60C 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
                            	  1502: _L_z05_InitMode4_CheckSub2:
02:0003D60E 5302            	  1503:     subq.b  #1,D2
02:0003D610 6702            	  1504:     beq.s  __far_z_05_0024
02:0003D612 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003D614 7600            	  1509:     moveq   #0,D3
02:0003D616 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003D61A 6100424E        	  1511:     jsr     IsDarkRoom_Bank5
02:0003D61E 6702            	  1512:     beq.s  __far_z_05_0025
02:0003D620 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003D622 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003D626 6100408A        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
                            	  1521:     ; to get room ID offset in that direction.
02:0003D62A 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003D62E 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003D632 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D636 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003D638 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D63C 4EB900030AD2    	  1527:     jsr     Negate
02:0003D642 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D646 122C00EB        	  1529:     move.b  ($00EB,A4),D1
02:0003D64A D101            	  1530:     addx.b  D1,D0   ; ADC RoomId
02:0003D64C 7600            	  1531:     moveq   #0,D3
02:0003D64E 1600            	  1532:     move.b  D0,D3
02:0003D650 61004218        	  1533:     jsr     IsDarkRoom_Bank5
02:0003D654 6602            	  1534:     bne.s  __far_z_05_0026
02:0003D656 601C            	  1535:     jmp  InitMode4_GoToSub0
                            	  1536: __far_z_05_0026:
                            	  1537:     ; The previous room was dark.
                            	  1538:     ;
02:0003D658 102C051F        	  1539:     move.b  ($051F,A4),D0
02:0003D65C 6702            	  1540:     beq.s  __far_z_05_0027
02:0003D65E 6014            	  1541:     jmp  InitMode4_GoToSub0
                            	  1542: __far_z_05_0027:
02:0003D660 103C00C0        	  1543:     move.b  #$C0,D0
                            	  1544: ; Params:
                            	  1545: ; A: start index of cycle
                            	  1546: ;
                            	  1547:     even
                            	  1548: SetFadeCycleAndAdvanceSubmode:
02:0003D664 4EF90002C0D2    	  1549:     jmp     c_set_fade_cycle_advance_submode
                            	  1550: 
