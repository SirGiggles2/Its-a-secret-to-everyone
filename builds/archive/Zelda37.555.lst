02:0000E6E8 6472            	  1111:     bhs.s   .nt_skip_write          ; ≥$3F20: mirror / overflow — skip
                            	  1112: 
                            	  1113:     ; Compute CRAM address from PPU_VADDR
02:0000E6EA 3401            	  1114:     move.w  D1,D2
02:0000E6EC 04423F00        	  1115:     subi.w  #$3F00,D2               ; D2.w = offset (0..31)
02:0000E6F0 0242001F        	  1116:     andi.w  #$001F,D2               ; mask to 5 bits
                            	  1117: 
                            	  1118:     ; NES palette handling:
                            	  1119:     ; Offsets 0-15  ($3F00-$3F0F): BG palettes → Genesis CRAM pal 0-3
                            	  1120:     ; Offset entry-0s (0,4,8,12,16,20,24,28): universal BG color mirror
                            	  1121:     ; Offsets 16-31 ($3F10-$3F1F): sprite palettes → Genesis CRAM pal 2-3
                            	  1122:     ;   (NES sprite pal 0,2→Genesis pal 2; NES sprite pal 1,3→Genesis pal 3)
                            	  1123:     ; Sequential last-write-wins: sprite pals 2,3 end up in PAL2/PAL3 which
                            	  1124:     ; gives correct sprite colors (red hearts, green grass) while BG text
                            	  1125:     ; only uses PAL0/PAL1 during the story phase, so BG2/BG3 clobber is OK.
                            	  1126:     ; _oam_dma maps NES sprite pal bits → Gen pal 2/3 to match.
02:0000E6F4 0C420010        	  1127:     cmpi.w  #$10,D2
02:0000E6F8 652C            	  1128:     blo.s   .t19_bg_color           ; offset < 16: BG palette
                            	  1129:     ; Sprite palette (offset 16-31)
02:0000E6FA 3602            	  1130:     move.w  D2,D3
02:0000E6FC 02430003        	  1131:     andi.w  #$0003,D3               ; color slot within palette
02:0000E700 6720            	  1132:     beq.s   .t19_spr_entry0         ; slot 0 → BG mirror
                            	  1133:     ; Non-entry-0 sprite color: remap
                            	  1134:     ifne CHR_EXPANSION_ENABLED
                            	  1135:     ; T-CHR S8 (v2): pack sprite sub-palettes into unused tail slots of BG
                            	  1136:     ; palettes so BG PAL0-3[0..3] stay untouched.
                            	  1137:     ;   sub-pal 0 → PAL0[4..7]   (CRAM base $08, bias +4 pixels)
                            	  1138:     ;   sub-pal 1 → PAL0[8..11]  (CRAM base $10, bias +8 pixels)
                            	  1139:     ;   sub-pal 2 → PAL0[12..15] (CRAM base $18, bias +12 pixels)
                            	  1140:     ;   sub-pal 3 → PAL1[4..7]   (CRAM base $28, bias +4 pixels, different palette)
02:0000E702 3602            	  1141:     move.w  D2,D3
02:0000E704 04430010        	  1142:     subi.w  #$10,D3                 ; D3 = 0..15 within sprite range
02:0000E708 E44B            	  1143:     lsr.w   #2,D3                   ; D3 = sub-pal (0..3)
02:0000E70A D643            	  1144:     add.w   D3,D3                   ; * 2 for word index
02:0000E70C 43F90000E764    	  1145:     lea     (.t19_spr_cram_base).l,A1
02:0000E712 36313000        	  1146:     move.w  (A1,D3.W),D3            ; D3 = CRAM base for this sub-pal
02:0000E716 3802            	  1147:     move.w  D2,D4
02:0000E718 02440003        	  1148:     andi.w  #$0003,D4               ; color slot (1..3)
02:0000E71C D844            	  1149:     add.w   D4,D4                   ; * 2
02:0000E71E D644            	  1150:     add.w   D4,D3                   ; D3 = CRAM address
                            	  1151:     else
                            	  1152:     ; Legacy last-write-wins: NES sprite pal 0-3 → Gen pal 2|3 (2,3,2,3).
                            	  1153:     move.w  D2,D3
                            	  1154:     subi.w  #$10,D3                 ; 0-15 range
                            	  1155:     lsr.w   #2,D3                   ; NES sprite pal (0-3)
                            	  1156:     ori.w   #$0002,D3               ; Genesis pal = NES_pal | 2 (→ 2,3,2,3)
                            	  1157:     lsl.w   #5,D3                   ; * $20 = CRAM palette base
                            	  1158:     move.w  D2,D2
                            	  1159:     andi.w  #$0003,D2               ; color slot (1-3)
                            	  1160:     lsl.w   #1,D2                   ; * 2
                            	  1161:     add.w   D2,D3                   ; D3 = CRAM address
                            	  1162:     endc
02:0000E720 6012            	  1163:     bra.s   .t19_have_cram
                            	  1164: .t19_spr_entry0:
                            	  1165:     ; Sprite entry-0 = BG mirror: remap 16→0, 20→4, 24→8, 28→12
02:0000E722 04420010        	  1166:     subi.w  #$10,D2
                            	  1167: .t19_bg_color:
02:0000E726 3602            	  1168:     move.w  D2,D3
02:0000E728 E44B            	  1169:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:0000E72A EB4B            	  1170:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:0000E72C 02420003        	  1171:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
02:0000E730 E34A            	  1172:     lsl.w   #1,D2                   ; D2.w = color * 2
02:0000E732 D642            	  1173:     add.w   D2,D3                   ; D3.w = CRAM address (0..$66)
                            	  1174: .t19_have_cram:
                            	  1175: 
                            	  1176:     ; Issue VDP CRAM write command
02:0000E734 7400            	  1177:     moveq   #0,D2
02:0000E736 3403            	  1178:     move.w  D3,D2
02:0000E738 4842            	  1179:     swap    D2                      ; D2 = CRAM_addr << 16
02:0000E73A 0082C0000000    	  1180:     ori.l   #$C0000000,D2           ; VDP CRAM-write command ($C0 = CD bits for CRAM write)
02:0000E740 23C200C00004    	  1181:     move.l  D2,(VDP_CTRL).l
                            	  1182: 
                            	  1183:     ; Look up NES color index (D0.b, 0..63) in NES→Genesis 16-bit color table
02:0000E746 0240003F        	  1184:     andi.w  #$003F,D0               ; D0.w = NES color index (mask high bits)
02:0000E74A 41F90000E9F0    	  1185:     lea     (nes_palette_to_genesis).l,A0
02:0000E750 E348            	  1186:     lsl.w   #1,D0                   ; D0.w = byte offset into 16-bit word table
02:0000E752 34300000        	  1187:     move.w  (A0,D0.W),D2            ; D2.w = Genesis color word ($0BGR)
02:0000E756 33C200C00000    	  1188:     move.w  D2,(VDP_DATA).l         ; write Genesis color to CRAM
                            	  1189: 
                            	  1190: .nt_skip_write:
02:0000E75C 610E            	  1191:     bsr     .inc_ppuaddr
02:0000E75E 4CDF037F        	  1192:     movem.l (SP)+,D0-D6/A0-A1
02:0000E762 4E75            	  1193:     rts
                            	  1194: 
                            	  1195:     ifne CHR_EXPANSION_ENABLED
                            	  1196:     ; T-CHR S8 v2: NES sprite sub-palette → CRAM base address (PAL slot 4).
                            	  1197:     ; Slots 1..3 (color indices 1..3) are written relative to this base.
                            	  1198: .t19_spr_cram_base:
02:0000E764 0008            	  1199:     dc.w    $08                 ; sub-pal 0 → PAL0[4]  (CRAM $08..$0E)
02:0000E766 0010            	  1200:     dc.w    $10                 ; sub-pal 1 → PAL0[8]  (CRAM $10..$16)
02:0000E768 0018            	  1201:     dc.w    $18                 ; sub-pal 2 → PAL0[12] (CRAM $18..$1E)
02:0000E76A 0028            	  1202:     dc.w    $28                 ; sub-pal 3 → PAL1[4]  (CRAM $28..$2E)
                            	  1203:     endc
                            	  1204: 
                            	  1205:     ;==========================================================================
                            	  1206:     ; .inc_ppuaddr — advance PPU_VADDR by 1 or 32.
                            	  1207:     ; PPUCTRL bit 2: 0 → +1 horizontal, 1 → +32 vertical.
                            	  1208:     ; Modifies D1.w.
                            	  1209:     ;==========================================================================
                            	  1210: .inc_ppuaddr:
02:0000E76C 323900FF0802    	  1211:     move.w  (PPU_VADDR).l,D1
02:0000E772 0839000200FF0804	  1212:     btst    #2,(PPU_CTRL).l
02:0000E77A 6604            	  1213:     bne.s   .inc32
02:0000E77C 5241            	  1214:     addq.w  #1,D1
02:0000E77E 6004            	  1215:     bra.s   .store_inc
                            	  1216: .inc32:
02:0000E780 06410020        	  1217:     addi.w  #32,D1
                            	  1218: .store_inc:
02:0000E784 02413FFF        	  1219:     andi.w  #$3FFF,D1               ; clamp to valid PPU address range
02:0000E788 33C100FF0802    	  1220:     move.w  D1,(PPU_VADDR).l
02:0000E78E 4E75            	  1221:     rts
