02:0003A2F6 41F90003A2AA    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A2FC 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A300 D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A302 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A306 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A30A 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A30E 02000003        	  4832:     andi.b #$03,D0
02:0003A312 0A000003        	  4833:     eori.b #$03,D0
02:0003A316 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A31A 7600            	  4835:     moveq   #0,D3
02:0003A31C 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A320 41F90003A29E    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A326 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A32A 12390003A29E    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A330 B001            	  4843:     cmp.b   D1,D0
02:0003A332 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
                            	  4846:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4847:     ;
                            	  4848:     ; $CC/CD shows the closed mouth face.
                            	  4849:     ; $C0/C1 shows the open mouth face.
                            	  4850:     ;
