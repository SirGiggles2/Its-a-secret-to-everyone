                            	  8096: ; If Ganon is dying, go handle it.
                            	  8097: ;
                            	  8098:     even
                            	  8099: Ganon_ScenePhase2:
02:0003BB76 41EC042C        	  8100:     lea     ($042C,A4),A0
02:0003BB7A 10302000        	  8101:     move.b  (A0,D2.W),D0
02:0003BB7E 6704            	  8102:     beq.s  __far_z_04_0090
02:0003BB80 600000A4        	  8103:     jmp  Ganon_Dying
                            	  8104: __far_z_04_0090:
02:0003BB84 61000356        	  8105:     jsr     Ganon_CheckCollisions
02:0003BB88 6100C6CA        	  8106:     jsr     PlayBossHitCryIfNeeded
                            	  8107:     ; Go handle the brown state specially.
                            	  8108:     ;
02:0003BB8C 41EC00AC        	  8109:     lea     ($00AC,A4),A0
02:0003BB90 10302000        	  8110:     move.b  (A0,D2.W),D0
02:0003BB94 6702            	  8111:     beq.s  __far_z_04_0091
02:0003BB96 6058            	  8112:     jmp  Ganon_UpdateBrownState
                            	  8113: __far_z_04_0091:
                            	  8114:     ; State = 0: Blue
                            	  8115:     ;
                            	  8116:     ; If timer = 0, then go move around and shoot.
                            	  8117:     ;
02:0003BB98 10342028        	  8118:     move.b  ($28,A4,D2.W),D0
02:0003BB9C 6602            	  8119:     bne.s  __far_z_04_0092
02:0003BB9E 600E            	  8120:     jmp  Ganon_MoveAndShoot
                            	  8121: __far_z_04_0092:
                            	  8122:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8123:     ; Collisions were checked already.
                            	  8124:     ;
                            	  8125:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8126:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8127:     ;
02:0003BBA0 0C000001        	  8128:     cmpi.b  #$01,D0
02:0003BBA4 6702            	  8129:     beq.s  __far_z_04_0093
02:0003BBA6 6078            	  8130:     jmp  L_Ganon_DrawBody
                            	  8131: __far_z_04_0093:
                            	  8132: ; Description:
                            	  8133: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  8134: ;
                            	  8135:     even
                            	  8136: Ganon_RandomizeLocation:
02:0003BBA8 4EF90002BAC6    	  8137:     jmp     c_ganon_randomize_location
