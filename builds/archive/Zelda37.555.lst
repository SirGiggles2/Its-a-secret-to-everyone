02:0002C04A 670A            	  2521:     beq.s   .cc_cnras
02:0002C04C 003C0001        	  2522:     ori     #$01,CCR
02:0002C050 0A3C0001        	  2523:     eori    #$01,CCR
02:0002C054 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002C056 023C00FE        	  2526:     andi    #$FE,CCR
02:0002C05A 0A3C0001        	  2527:     eori    #$01,CCR
02:0002C05E 4E75            	  2528:     rts
