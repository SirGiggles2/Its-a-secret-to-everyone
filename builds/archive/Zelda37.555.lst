                            	  8386:     ;
02:0003BD6C 610000B6        	  8387:     jsr     Ganon_GetCurCloudLeft
02:0003BD70 610000BE        	  8388:     jsr     Ganon_GetCurCloudTop
02:0003BD74 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0003BD76 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BD7A 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BD7C 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0003BD80 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
02:0003BD84 6190            	  8394:     jsr     Ganon_DrawCloud
02:0003BD86 610000A2        	  8395:     jsr     Ganon_GetCurCloudRight
02:0003BD8A 618A            	  8396:     jsr     Ganon_DrawCloud
                            	  8397:     ; Draw the top and bottom clouds.
                            	  8398:     ;
02:0003BD8C 10342070        	  8399:     move.b  ($70,A4,D2.W),D0
02:0003BD90 1880            	  8400:     move.b  D0,($0000,A4)
02:0003BD92 6100009C        	  8401:     jsr     Ganon_GetCurCloudTop
02:0003BD96 6100FF7E        	  8402:     jsr     Ganon_DrawCloud
02:0003BD9A 6100009A        	  8403:     jsr     Ganon_GetCurCloudBottom
02:0003BD9E 6100FF76        	  8404:     jsr     Ganon_DrawCloud
                            	  8405:     ; Draw the left and right clouds.
                            	  8406:     ;
02:0003BDA2 61000080        	  8407:     jsr     Ganon_GetCurCloudLeft
02:0003BDA6 41EC0084        	  8408:     lea     ($0084,A4),A0
02:0003BDAA 10302000        	  8409:     move.b  (A0,D2.W),D0
02:0003BDAE 19400001        	  8410:     move.b  D0,($0001,A4)
02:0003BDB2 6100FF62        	  8411:     jsr     Ganon_DrawCloud
02:0003BDB6 6172            	  8412:     jsr     Ganon_GetCurCloudRight
02:0003BDB8 6100FF5C        	  8413:     jsr     Ganon_DrawCloud
                            	  8414:     ; Save the object index.
                            	  8415:     ;
02:0003BDBC 102C0340        	  8416:     move.b  ($0340,A4),D0
02:0003BDC0 1B00            	  8417:     move.b  D0,-(A5)  ; PHA
                            	  8418:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8419:     ;
02:0003BDC2 7402            	  8420:     moveq   #2,D2
                            	  8421:     even
                            	  8422: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003BDC4 19420340        	  8423:     move.b  D2,($0340,A4)
                            	  8424:     ; If object slot < 5 or = 7, then move every frame.
                            	  8425:     ; Else move 3 out of every 4 frames.
                            	  8426:     ;
                            	  8427:     ; This makes pieces spread out in somewhat of a circle,
                            	  8428:     ; by making the pieces at cardinal directions move at
                            	  8429:     ; full speed while the diagonal ones move a little slower.
                            	  8430:     ;
02:0003BDC8 0C020005        	  8431:     cmpi.b  #$05,D2
02:0003BDCC 6510            	  8432:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003BDCE 0C020007        	  8433:     cmpi.b  #$07,D2
02:0003BDD2 670A            	  8434:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003BDD4 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0003BDD8 02000003        	  8436:     andi.b #$03,D0
02:0003BDDC 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
                            	  8439: _L_z04_Ganon_DrawBurst_Move:
02:0003BDDE 6100EDA2        	  8440:     jsr     BlueWizzrobe_Move
                            	  8441: _anon_z04_164:
02:0003BDE2 4EB90004910E    	  8442:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8443:     ; The frame counter will make the sprite flash.
                            	  8444:     ; The array has the horizontal and vertical flipping attributes.
                            	  8445:     ; Combine them into [03].
                            	  8446:     ;
02:0003BDE8 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0003BDEC 02000003        	  8448:     andi.b #$03,D0
02:0003BDF0 41F90003BCC0    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BDF6 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BDFA 8001            	  8451:     or.b  D1,D0
02:0003BDFC 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BE00 41F90003BCCA    	  8453:     lea     (GanonBurstTiles).l,A0
02:0003BE06 10302000        	  8454:     move.b  (A0,D2.W),D0
02:0003BE0A 4EB900031196    	  8455:     jsr     Anim_WriteSprite
                            	  8456:     ; Bottom of the loop.
                            	  8457:     ; Increment object slot while <= 9.
                            	  8458:     ;
02:0003BE10 5202            	  8459:     addq.b  #1,D2
02:0003BE12 0C02000A        	  8460:     cmpi.b  #$0A,D2
02:0003BE16 65AC            	  8461:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8462:     ; Restore the object index.
                            	  8463:     ;
02:0003BE18 101D            	  8464:     move.b  (A5)+,D0  ; PLA
02:0003BE1A 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BE1E 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BE22 4E75            	  8467:     rts
                            	  8468: 
                            	  8469: ; Returns:
                            	  8470: ; [00]: X coordinate
                            	  8471: ;
                            	  8472:     even
                            	  8473: Ganon_GetCurCloudLeft:
02:0003BE24 4EF90002BF6E    	  8474:     jmp     c_ganon_get_cur_cloud_left
                            	  8475: 
