02:0003E2E8 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E2EC 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E2EE D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E2F0 02000003        	  3260:     andi.b #$03,D0
02:0003E2F4 7600            	  3261:     moveq   #0,D3
02:0003E2F6 1600            	  3262:     move.b  D0,D3
02:0003E2F8 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2FE 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
