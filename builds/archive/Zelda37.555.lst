02:0003B9A4 522C00AD        	  7833:     addq.b  #1,($00AD,A4)
                            	  7834: _anon_z04_157:
                            	  7835:     ; Go to state 1 to orbit.
                            	  7836:     ;
02:0003B9A8 41EC00AC        	  7837:     lea     ($00AC,A4),A0
02:0003B9AC 52302000        	  7838:     addq.b  #1,(A0,D2.W)
                            	  7839:     ; TODO: ?
                            	  7840:     ;
