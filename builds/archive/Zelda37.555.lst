                            	  1973:     ;
                            	  1974:     ; If a cycle was completed (wrapped around to 0),
                            	  1975:     ; then decrease the active red leever count.
                            	  1976:     ;
02:00038E8C 41EC00AC        	  1977:     lea     ($00AC,A4),A0
02:00038E90 10302000        	  1978:     move.b  (A0,D2.W),D0
02:00038E94 023C00EE        	  1979:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038E98 123C0001        	  1980:     move.b  #$01,D1
02:00038E9C D101            	  1981:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038E9E 0C000006        	  1982:     cmpi.b  #$06,D0
02:00038EA2 6506            	  1983:     bcs  _anon_z04_47
02:00038EA4 532C0510        	  1984:     subq.b  #1,($0510,A4)
02:00038EA8 7000            	  1985:     moveq   #0,D0
                            	  1986: _anon_z04_47:
02:00038EAA 41EC00AC        	  1987:     lea     ($00AC,A4),A0
02:00038EAE 11802000        	  1988:     move.b  D0,(A0,D2.W)
                            	  1989:     ; Look up and set the speed, timer, and animation counter
                            	  1990:     ; for the current state.
