02:000496AC 1600            	  7312:     move.b  D0,D3
02:000496AE 41F9000491E2    	  7313:     lea     (ObjectTypeToHpPairs).l,A0
02:000496B4 10303000        	  7314:     move.b  (A0,D3.W),D0
02:000496B8 4EB90003C04E    	  7315:     jsr     ExtractHitPointValue
