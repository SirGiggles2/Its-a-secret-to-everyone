                            	  2848: _L_z05_MaskInputInBorder_ExcludeNone:
                            	  2849:     ; The coordinate is not crossed; then set mask $FF,
                            	  2850:     ; so that no button is excluded.
                            	  2851:     ;
02:0003E040 103C00FF        	  2852:     move.b  #$FF,D0
02:0003E044 19400001        	  2853:     move.b  D0,($0001,A4)
                            	  2854:     even
