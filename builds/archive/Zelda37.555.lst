02:00048B06 41EC00AC        	  5837:     lea     ($00AC,A4),A0
02:00048B0A 10302000        	  5838:     move.b  (A0,D2.W),D0
02:00048B0E 0200000F        	  5839:     andi.b #$0F,D0
