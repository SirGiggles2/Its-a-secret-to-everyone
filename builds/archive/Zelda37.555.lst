                            	  8311:     even
                            	  8312: _L_z04_Ganon_SetUpBurstRays_LoopRay:
                            	  8313:     ; Start each piece at offset (4, 4) from Ganon's location.
                            	  8314:     ;
02:0003BCD6 10342070        	  8315:     move.b  ($70,A4,D2.W),D0
02:0003BCDA 023C00EE        	  8316:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BCDE 123C0004        	  8317:     move.b  #$04,D1
02:0003BCE2 D101            	  8318:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BCE4 19803072        	  8319:     move.b  D0,($72,A4,D3.W)
02:0003BCE8 41EC0084        	  8320:     lea     ($0084,A4),A0
02:0003BCEC 10302000        	  8321:     move.b  (A0,D2.W),D0
02:0003BCF0 123C0004        	  8322:     move.b  #$04,D1
02:0003BCF4 D101            	  8323:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BCF6 41EC0086        	  8324:     lea     ($0086,A4),A0
02:0003BCFA 11803000        	  8325:     move.b  D0,(A0,D3.W)
                            	  8326:     ; Set the direction.
                            	  8327:     ;
02:0003BCFE 41F90003BCB8    	  8328:     lea     (GanonBurstDirs).l,A0
02:0003BD04 10303000        	  8329:     move.b  (A0,D3.W),D0
02:0003BD08 41EC009A        	  8330:     lea     ($009A,A4),A0
02:0003BD0C 11803000        	  8331:     move.b  D0,(A0,D3.W)
02:0003BD10 5303            	  8332:     subq.b  #1,D3
02:0003BD12 6AC2            	  8333:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003BD14 4E75            	  8334:     rts
