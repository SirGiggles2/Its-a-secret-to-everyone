Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:000003D6 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:000003D8 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:000003DC 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:000003E2 6BF8            	    86:     bmi.s   .wait
02:000003E4 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:000003EA 4E71            	    88:     nop                              ; address setup delay
02:000003EC 4E71            	    89:     nop
02:000003EE 4E71            	    90:     nop
02:000003F0 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:000003F6 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:000003F8 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:000003FA 40E7            	   108:     move.w  SR,-(SP)
02:000003FC 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:00000400 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:00000406 6BF8            	   112:     bmi.s   .wait
02:00000408 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:0000040E 4E71            	   114:     nop
02:00000410 4E71            	   115:     nop
02:00000412 4E71            	   116:     nop
02:00000414 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:0000041A 46DF            	   118:     move.w  (SP)+,SR
02:0000041C 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:0000041E 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:00000420 B47C0002        	   132:     cmp.w   #2,D2
02:00000424 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:00000426 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:00000428 692E            	   135:     bvs.s   .silence                ; overflow safety
02:0000042A 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:0000042C 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:0000042E BA7C07FF        	   139:     cmp.w   #2047,D5
02:00000432 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:00000434 E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:00000436 5204            	   142:     addq.b  #1,D4                   ; increment block
02:00000438 B83C0007        	   143:     cmp.b   #7,D4
02:0000043C 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:0000043E 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:00000440 1404            	   148:     move.b  D4,D2
02:00000442 E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:00000444 3605            	   150:     move.w  D5,D3
02:00000446 E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:00000448 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:0000044A 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:0000044C 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:0000044E 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:00000452 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:00000456 4E75            	   159:     rts
                            	   160: .silence:
02:00000458 7400            	   161:     moveq   #0,D2
02:0000045A 7600            	   162:     moveq   #0,D3
02:0000045C 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:0000045E 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:00000462 43FA0172        	   175:     lea     FM_PATCH_REGS(PC),A1
02:00000466 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:00000468 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:0000046A D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:0000046C 1218            	   180:     move.b  (A0)+,D1                ; data value
02:0000046E 6100FF66        	   181:     bsr     ym_write1
02:00000472 51CAFFF4        	   182:     dbra    D2,.loop
02:00000476 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:0000047A 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:0000047C 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:00000480 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:00000484 7200            	   199:     moveq   #0,D1
02:00000486 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:0000048A 123C0001        	   201:     move.b  #$01,D1
02:0000048E 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:00000492 123C0002        	   203:     move.b  #$02,D1
02:00000496 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:0000049A 123C0004        	   205:     move.b  #$04,D1
02:0000049E 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:000004A2 123C0005        	   207:     move.b  #$05,D1
02:000004A6 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:000004AA 123C0006        	   209:     move.b  #$06,D1
02:000004AE 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:000004B2 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:000004B6 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:000004BA 6100FF1A        	   223:     bsr     ym_write1
02:000004BE 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:000004C2 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:000004C6 6100FF0E        	   226:     bsr     ym_write1
02:000004CA 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:000004CE 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:000004D2 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:000004D6 103C0022        	   234:     move.b  #$22,D0
02:000004DA 7200            	   235:     moveq   #0,D1
02:000004DC 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:000004E0 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:000004E2 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:000004E6 6100FEEE        	   253:     bsr     ym_write1
02:000004EA 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:000004EE 6100FEE6        	   255:     bsr     ym_write1
02:000004F2 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:000004F6 6100FEDE        	   257:     bsr     ym_write1
02:000004FA 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:000004FE 6100FED6        	   259:     bsr     ym_write1
02:00000502 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:00000506 6100FECE        	   261:     bsr     ym_write1
02:0000050A 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:0000050E 6100FEC6        	   263:     bsr     ym_write1
02:00000512 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:00000516 6100FEBE        	   265:     bsr     ym_write1
02:0000051A 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:0000051E 6100FEB6        	   267:     bsr     ym_write1
02:00000522 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:00000526 6100FEAE        	   269:     bsr     ym_write1
02:0000052A 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:0000052E 6100FEA6        	   271:     bsr     ym_write1
02:00000532 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:00000536 6100FE9E        	   273:     bsr     ym_write1
02:0000053A 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:0000053E 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
                            	   277:     ;------------------------------------------------------------------
                            	   278:     ; Load EHZ Voice $03 into ch 0 (m_sq1 = NES Sq1 = Pulse 2 = LEAD melody)
                            	   279:     ; NES naming: Sq1/Sq0 are reversed from intuition — Sq1 writes $4006/$4007
                            	   280:     ; (Pulse 2) and owns the primary melody.  Put the snappy EHZ lead here.
                            	   281:     ;------------------------------------------------------------------
02:00000542 41FA00C6        	   282:     lea     PATCH_VOICE03(PC),A0
02:00000546 7C00            	   283:     moveq   #0,D6                   ; channel 0 (emit_note_sq1 target)
02:00000548 6100FF14        	   284:     bsr     load_fm_patch
                            	   285: 
                            	   286:     ;------------------------------------------------------------------
                            	   287:     ; Load EHZ Voice $00 into ch 1 (m_sq0 = NES Sq0 = Pulse 1 = harmony/arp)
                            	   288:     ; The slow-decay pad fits arpeggiated harmony better than a sharp lead.
                            	   289:     ;------------------------------------------------------------------
02:0000054C 41FA00A2        	   290:     lea     PATCH_VOICE00(PC),A0
02:00000550 7C01            	   291:     moveq   #1,D6                   ; channel 1 (emit_note_sq0 target)
02:00000552 6100FF0A        	   292:     bsr     load_fm_patch
                            	   293: 
                            	   294:     ;------------------------------------------------------------------
                            	   295:     ; Load EHZ Voice $07 into ch 2 (Triangle — Algorithm 0, bass)
                            	   296:     ;------------------------------------------------------------------
02:00000556 41FA00CC        	   297:     lea     PATCH_VOICE07(PC),A0
02:0000055A 7C02            	   298:     moveq   #2,D6                   ; channel 2
02:0000055C 6100FF00        	   299:     bsr     load_fm_patch
                            	   300: 
                            	   301:     ;------------------------------------------------------------------
                            	   302:     ; Set panning: both speakers for ch 0–2
                            	   303:     ; Register $B4+ch, data $C0 = L+R output
                            	   304:     ;------------------------------------------------------------------
02:00000560 103C00B4        	   305:     move.b  #$B4,D0
02:00000564 123C00C0        	   306:     move.b  #$C0,D1
02:00000568 6100FE6C        	   307:     bsr     ym_write1               ; ch 0 panning
02:0000056C 103C00B5        	   308:     move.b  #$B5,D0
02:00000570 6100FE64        	   309:     bsr     ym_write1               ; ch 1 panning
02:00000574 103C00B6        	   310:     move.b  #$B6,D0
02:00000578 6100FE5C        	   311:     bsr     ym_write1               ; ch 2 panning
                            	   312: 
                            	   313:     ;------------------------------------------------------------------
                            	   314:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   315:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   316:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   317:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   318:     ; authoritative TL bytes for each voice.)
                            	   319:     ;------------------------------------------------------------------
                            	   320: 
                            	   321:     ;------------------------------------------------------------------
                            	   322:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   323:     ;------------------------------------------------------------------
02:0000057C 13FC009F00C00011	   324:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:00000584 13FC00BF00C00011	   325:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:0000058C 13FC00DF00C00011	   326:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:00000594 13FC00FF00C00011	   327:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   328: 
                            	   329:     ;------------------------------------------------------------------
                            	   330:     ; Clear shadow APU registers
                            	   331:     ;------------------------------------------------------------------
02:0000059C 41F900FF0A00    	   332:     lea     (APU_SH_BASE).l,A0
02:000005A2 7008            	   333:     moveq   #($11/2),D0            ; 18 bytes / 2 = 9 words (round up)
                            	   334: .clr:
02:000005A4 4258            	   335:     clr.w   (A0)+
02:000005A6 51C8FFFC        	   336:     dbra    D0,.clr
                            	   337: 
                            	   338:     ;------------------------------------------------------------------
                            	   339:     ; Clear native music player state
                            	   340:     ;------------------------------------------------------------------
02:000005AA 41F900FFE000    	   341:     lea     (MUSIC_BASE).l,A0
02:000005B0 700F            	   342:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   343: .clr_music:
02:000005B2 4298            	   344:     clr.l   (A0)+
02:000005B4 51C8FFFC        	   345:     dbra    D0,.clr_music
                            	   346: 
                            	   347:     ;------------------------------------------------------------------
                            	   348:     ; Clear DMC state block ($FFE100, 17 bytes — rounded to 20).  Zero
                            	   349:     ; dmc_active, dmc_burst, dmc_ptr, dmc_remain, shadow registers, and
                            	   350:     ; debug scaffold state.
                            	   351:     ;------------------------------------------------------------------
02:000005B8 41F900FFE100    	   352:     lea     (DMC_BASE).l,A0
02:000005BE 4298            	   353:     clr.l   (A0)+                   ; active + burst
02:000005C0 4298            	   354:     clr.l   (A0)+                   ; dmc_ptr
02:000005C2 4298            	   355:     clr.l   (A0)+                   ; dmc_remain
02:000005C4 4298            	   356:     clr.l   (A0)+                   ; rate/addr/len sel + prev_btn
02:000005C6 4298            	   357:     clr.l   (A0)+                   ; dbg_next + pad (over-clear, safe)
                            	   358:     ;------------------------------------------------------------------
                            	   359:     ; Scaffold: preload dmc_dbg_next = 1 so the first Start press fires
                            	   360:     ; sample #1.  dmc_trigger wraps 1..7 from there.
                            	   361:     ;------------------------------------------------------------------
02:000005C8 13FC000100FFE110	   362:     move.b  #1,(dmc_dbg_next).l
                            	   363: 
02:000005D0 4CDF017F        	   364:     movem.l (SP)+,D0-D6/A0
02:000005D4 4E75            	   365:     rts
                            	   366: 
                            	   367: ;==============================================================================
                            	   368: ; FM Patch Register Address Table
                            	   369: ;
                            	   370: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   371: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   372: ;==============================================================================
                            	   373:     even
                            	   374: FM_PATCH_REGS:
02:000005D6 B0              	   375:     dc.b    $B0                     ; FB/ALG
02:000005D7 30              	   376:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:000005D8 34
02:000005D9 38
02:000005DA 3C
02:000005DB 50              	   377:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:000005DC 54
02:000005DD 58
02:000005DE 5C
02:000005DF 60              	   378:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:000005E0 64
02:000005E1 68
02:000005E2 6C
02:000005E3 70              	   379:     dc.b    $70,$74,$78,$7C         ; D2R
02:000005E4 74
02:000005E5 78
02:000005E6 7C
02:000005E7 80              	   380:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:000005E8 84
02:000005E9 88
02:000005EA 8C
02:000005EB 40              	   381:     dc.b    $40,$44,$48,$4C         ; TL
02:000005EC 44
02:000005ED 48
02:000005EE 4C
                            	   382:     even
                            	   383: 
                            	   384: ;==============================================================================
                            	   385: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   386: ;
                            	   387: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   388: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   389: ;
                            	   390: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   391: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   392: ;   bytes 5-8   : RS/AR    "
                            	   393: ;   bytes 9-12  : AM/D1R   "
                            	   394: ;   bytes 13-16 : D2R      "
                            	   395: ;   bytes 17-20 : DL/RR    "
                            	   396: ;   bytes 21-24 : TL       "
                            	   397: ;
                            	   398: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   399: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   400: ; without any reordering in load_fm_patch.
                            	   401: ;
                            	   402: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   403: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   404: ; volume is added for operators without the flag.  We have no per-channel
                            	   405: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   406: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   407: ; modulator TL bytes as-is.
                            	   408: ;
                            	   409: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   410: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   411: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   412: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   413: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   414: ; middle values differ enough that the swap produced cross-wired FM
                            	   415: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   416: ; authoritative byte order here.
                            	   417: ;==============================================================================
                            	   418: 
                            	   419: ; Voice $00 — Bell-like pad.
                            	   420: ;
                            	   421: ; Classic FM bell recipe:
                            	   422: ;   Alg 5 (3 carriers modulated by op1)
                            	   423: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   424: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   425: ;     which is what gives bells their characteristic "chime" quality
                            	   426: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   427: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   428: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   429: PATCH_VOICE00:
02:000005F0 2D              	   430:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:000005F1 04              	   431:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:000005F2 01
02:000005F3 01
02:000005F4 01
02:000005F5 1F              	   432:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:000005F6 1F
02:000005F7 1F
02:000005F8 1F
02:000005F9 08              	   433:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:000005FA 04
02:000005FB 04
02:000005FC 04
02:000005FD 00              	   434:     dc.b    $00,$00,$00,$00         ; D2R
02:000005FE 00
02:000005FF 00
02:00000600 00
02:00000601 47              	   435:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:00000602 37
02:00000603 37
02:00000604 17
02:00000605 14              	   436:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:00000606 1E
02:00000607 1E
02:00000608 1E
                            	   437:     even
                            	   438: 
                            	   439: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   440: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   441: PATCH_VOICE03:
02:0000060A 3D              	   442:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:0000060B 01              	   443:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:0000060C 51
02:0000060D 21
02:0000060E 01
02:0000060F 1F              	   444:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:00000610 1F
02:00000611 1F
02:00000612 1F
02:00000613 0A              	   445:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000614 05
02:00000615 05
02:00000616 05
02:00000617 00              	   446:     dc.b    $00,$00,$00,$00         ; D2R
02:00000618 00
02:00000619 00
02:0000061A 00
02:0000061B 2B              	   447:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:0000061C 2B
02:0000061D 2B
02:0000061E 1B
02:0000061F 19              	   448:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:00000620 18
02:00000621 18
02:00000622 18
                            	   449:     even
                            	   450: 
                            	   451: ; Voice $07 — Clean bass.
                            	   452: ;
                            	   453: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   454: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   455: ; damental already provides.  Moderately quiet so it supports the lead
                            	   456: ; without fighting it.
                            	   457: PATCH_VOICE07:
02:00000624 0D              	   458:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:00000625 01              	   459:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:00000626 01
02:00000627 01
02:00000628 01
02:00000629 1F              	   460:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:0000062A 1F
02:0000062B 1F
02:0000062C 1F
02:0000062D 0A              	   461:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:0000062E 05
02:0000062F 05
02:00000630 05
02:00000631 00              	   462:     dc.b    $00,$00,$00,$00         ; D2R
02:00000632 00
02:00000633 00
02:00000634 00
02:00000635 28              	   463:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:00000636 28
02:00000637 28
02:00000638 18
02:00000639 22              	   464:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:0000063A 20
02:0000063B 20
02:0000063C 20
                            	   465:     even
                            	   466: 
                            	   467: ;==============================================================================
                            	   468: ;==============================================================================
                            	   469: ; NATIVE M68K MUSIC PLAYER
                            	   470: ;
                            	   471: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   472: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   473: ;
                            	   474: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   475: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   476: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   477: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   478: ;==============================================================================
                            	   479: ;==============================================================================
                            	   480: 
                            	   481: ;----------------------------------------------------------------------
                            	   482: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   483: ;----------------------------------------------------------------------
                            	   484: ; ============================================================================
                            	   485: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   486: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   487: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   488: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   489: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   490: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   491: ; ============================================================================
                            	   492: MUSIC_BASE          equ $FFE000
                            	   493: MUSIC_STATE_SIZE    equ $40
                            	   494: 
                            	   495: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   496: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   497: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   498: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   499: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   500: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   501: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   502: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   503: 
                            	   504: ; Sq1 (Pulse 1 → YM ch 0)
                            	   505: m_sq1_off           equ MUSIC_BASE+$0C
                            	   506: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   507: m_sq1_len           equ MUSIC_BASE+$0E
                            	   508: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   509: m_sq1_per           equ MUSIC_BASE+$10
                            	   510: 
                            	   511: ; Sq0 (Pulse 2 → YM ch 1)
                            	   512: m_sq0_off           equ MUSIC_BASE+$14
                            	   513: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   514: m_sq0_len           equ MUSIC_BASE+$16
                            	   515: m_sq0_vib           equ MUSIC_BASE+$17
                            	   516: m_sq0_per           equ MUSIC_BASE+$18
                            	   517: 
                            	   518: ; Triangle (→ YM ch 2)
                            	   519: m_trg_off           equ MUSIC_BASE+$1C
                            	   520: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   521: m_trg_len           equ MUSIC_BASE+$1E
                            	   522: m_trg_vib           equ MUSIC_BASE+$1F
                            	   523: m_trg_per           equ MUSIC_BASE+$20
                            	   524: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   525: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   526: 
                            	   527: ; Noise (→ PSG ch 3)
                            	   528: m_noise_off         equ MUSIC_BASE+$24
                            	   529: m_noise_cnt         equ MUSIC_BASE+$25
                            	   530: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   531: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   532: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   533: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   534: ; skip redundant writes to preserve the decay tail.
                            	   535: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   536: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   537: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   538: 
                            	   539: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   540: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   541: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   542: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   543: ; Set to 1 by tick_sq1.song_ended each time the song script reaches its
                            	   544: ; loop point (opcode $00). C-side intro_story polls this to sync the
                            	   545: ; final-hold-then-loop-back-to-title transition with the music loop.
                            	   546: ; Owner clears it; ASM only ever writes 1.
                            	   547: m_song_loop_pending equ MUSIC_BASE+$2B  ; byte: 1 = song just looped
                            	   548: 
                            	   549: ;----------------------------------------------------------------------
                            	   550: ; DMC → YM2612 DAC state (Phase A of DMC port — see
                            	   551: ; C:\Users\Jake Diggity\.claude\plans\quirky-baking-goose.md).
                            	   552: ;
                            	   553: ; Lives at $FFE100, clear of the music-state block at $FFE000-$FFE03F.
                            	   554: ; Written by the DMC APU stubs in nes_io.asm, consumed by dmc_feed which
                            	   555: ; runs at the tail of music_tick and bursts PCM bytes to YM reg $2A.
                            	   556: ;----------------------------------------------------------------------
                            	   557: DMC_BASE            equ $FFE100
                            	   558: dmc_active          equ DMC_BASE+$00    ; byte: 0 = idle, 1 = playing
                            	   559: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   560: dmc_ptr             equ DMC_BASE+$04    ; long: current M68K pointer into PCM blob
                            	   561: dmc_remain          equ DMC_BASE+$08    ; long: PCM bytes left in current sample
                            	   562: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   563: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   564: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   565: dmc_dbg_prev_btn    equ DMC_BASE+$0F    ; byte: pad state from last frame (edge det)
                            	   566: dmc_dbg_next        equ DMC_BASE+$10    ; byte: next sample index (1..7) to trigger
                            	   567: 
                            	   568: ;==============================================================================
                            	   569: ; dmc_trigger — non-blocking HBlank DAC streamer.
                            	   570: ;
                            	   571: ; Samples are pre-processed by tools/extract_dmc_samples.py: proper bandlimited
                            	   572: ; resampling (scipy.signal.resample_poly with Kaiser-window FIR) from native
                            	   573: ; NES rate (21/25/33 kHz) down to the empirically-measured Genesis HINT rate
                            	   574: ; (~8751 Hz with music active). That's where the "crunchy" sound came from
                            	   575: ; before — linear interpolation without anti-alias filter caused aliasing.
                            	   576: ; With proper prefiltered resampling, playback sounds clean even at the lower
                            	   577: ; effective rate, and the game does NOT hitch.
                            	   578: ;==============================================================================
                            	   579: dmc_trigger:
02:0000063E 4A00            	   580:     tst.b   D0
02:00000640 6762            	   581:     beq.s   .bad
02:00000642 B03C0007        	   582:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:00000646 625C            	   583:     bhi.s   .bad
02:00000648 48E7E0C0        	   584:     movem.l D0-D2/A0-A1,-(SP)
02:0000064C 13C000FFE101    	   585:     move.b  D0,(dmc_last_idx).l
02:00000652 7200            	   586:     moveq   #0,D1
02:00000654 1200            	   587:     move.b  D0,D1                   ; D1.l = 1-based index
02:00000656 5381            	   588:     subq.l  #1,D1                   ; 0-based
02:00000658 D281            	   589:     add.l   D1,D1                   ; idx * 2
02:0000065A D281            	   590:     add.l   D1,D1                   ; idx * 4
                            	   591: 
02:0000065C 41F900001962    	   592:     lea     (DMC_SAMPLE_PCM_OFFS).l,A0
02:00000662 24301800        	   593:     move.l  (A0,D1.l),D2
02:00000666 43F9000052D2    	   594:     lea     (DMC_SAMPLE_PCM_BLOB).l,A1
02:0000066C D3C2            	   595:     add.l   D2,A1
                            	   596: 
02:0000066E 41F90000197E    	   597:     lea     (DMC_SAMPLE_PCM_LENS).l,A0
02:00000674 24301800        	   598:     move.l  (A0,D1.l),D2
02:00000678 4A82            	   599:     tst.l   D2
02:0000067A 6724            	   600:     beq.s   .bad_restore
                            	   601: 
02:0000067C 23C900FFE104    	   602:     move.l  A1,(dmc_ptr).l
02:00000682 23C200FFE108    	   603:     move.l  D2,(dmc_remain).l
02:00000688 13FC000100FFE100	   604:     move.b  #1,(dmc_active).l
                            	   605: 
                            	   606:     ; Arm HBlank every line, enable HINT (preserve colorfix bit).
02:00000690 33FC8A0000C00004	   607:     move.w  #$8A00,(VDP_CTRL).l     ; Reg 10 = 0 -> fire every line
02:00000698 33FC801400C00004	   608:     move.w  #$8014,(VDP_CTRL).l     ; Reg  0 = $14 -> HINT on + colorfix
                            	   609: .bad_restore:
02:000006A0 4CDF0307        	   610:     movem.l (SP)+,D0-D2/A0-A1
                            	   611: .bad:
02:000006A4 4E75            	   612:     rts
                            	   613: 
                            	   614: ;==============================================================================
                            	   615: ; dmc_hint_tick — per-HBlank PCM byte -> YM2612 reg $2A DAC write.
                            	   616: ;==============================================================================
                            	   617: dmc_hint_tick:
02:000006A6 207900FFE104    	   618:     move.l  (dmc_ptr).l,A0
02:000006AC 1018            	   619:     move.b  (A0)+,D0
02:000006AE 23C800FFE104    	   620:     move.l  A0,(dmc_ptr).l
02:000006B4 41F900A04000    	   621:     lea     (YM_ADDR1).l,A0
                            	   622: .wait:
02:000006BA 4A10            	   623:     tst.b   (A0)
02:000006BC 6BFC            	   624:     bmi.s   .wait
02:000006BE 10BC002A        	   625:     move.b  #$2A,(A0)
02:000006C2 13C000A04001    	   626:     move.b  D0,(YM_DATA1).l
02:000006C8 53B900FFE108    	   627:     subq.l  #1,(dmc_remain).l
02:000006CE 6702            	   628:     beq.s   .end
02:000006D0 4E75            	   629:     rts
                            	   630: .end:
02:000006D2 41F900A04000    	   631:     lea     (YM_ADDR1).l,A0
                            	   632: .wait2:
02:000006D8 4A10            	   633:     tst.b   (A0)
02:000006DA 6BFC            	   634:     bmi.s   .wait2
02:000006DC 10BC002A        	   635:     move.b  #$2A,(A0)
02:000006E0 13FC008000A04001	   636:     move.b  #$80,(YM_DATA1).l       ; park DAC at mid-rail
02:000006E8 423900FFE100    	   637:     clr.b   (dmc_active).l
02:000006EE 33FC800400C00004	   638:     move.w  #$8004,(VDP_CTRL).l     ; Reg 0 = $04 -> HINT off, colorfix on
02:000006F6 4E75            	   639:     rts
                            	   640: 
                            	   641: ;==============================================================================
                            	   642: ; dmc_feed — legacy VBlank entry point, retained as labeled rts.
                            	   643: ;
                            	   644: ; music_tick used to call this to drain a frame's worth of PCM in VBlank.
                            	   645: ; All streaming now happens from HBlank via dmc_hint_tick.  Kept as a cheap
                            	   646: ; rts so we don't have to surgically delete the call from music_tick.
                            	   647: ;==============================================================================
                            	   648: dmc_feed:
02:000006F8 4E75            	   649:     rts
                            	   650: 
                            	   651: ;==============================================================================
                            	   652: ; dmc_dbg_poll - Phase-C/D scaffold (REMOVED in Phase E).
                            	   653: ;
                            	   654: ; Previously watched the NES-format controller latch for a Start rising edge
                            	   655: ; and cycled through the 7 DMC samples.  That scaffold served its purpose at
                            	   656: ; T27/T28 PASS — DMC triggering is now fully driven by the game's own APU
                            	   657: ; $4015 writes via the _apu_write_4015 stub in nes_io.asm (Phase D), and
                            	   658: ; Start has a real game function (exit attract mode).  Polling it here would
                            	   659: ; fire a stray DMC burst every time the player presses Start on the title
                            	   660: ; screen, masking real game audio events.
                            	   661: ;
                            	   662: ; The label is kept as a labeled rts for backward-compat with the call in
                            	   663: ; music_tick, which we'll peel out in a later cleanup pass.
                            	   664: ;==============================================================================
                            	   665: dmc_dbg_poll:
02:000006FA 4E75            	   666:     rts
                            	   667: 
                            	   668: ;==============================================================================
                            	   669: ; music_play — request a song change
                            	   670: ; Input: D0.b = song bitmap
                            	   671: ;==============================================================================
                            	   672:     xdef    music_play
                            	   673: music_play:
02:000006FC 13C000FFE001    	   674:     move.b  D0,(m_song_req).l
02:00000702 4E75            	   675:     rts
                            	   676: 
                            	   677: ;==============================================================================
                            	   678: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   679: ;==============================================================================
                            	   680:     xdef    music_tick
                            	   681: music_tick:
02:00000704 48E7FFE0        	   682:     movem.l D0-D7/A0-A2,-(SP)
                            	   683:     ;------------------------------------------------------------------
                            	   684:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   685:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   686:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   687:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   688:     ; address and data bytes.
                            	   689:     ;
                            	   690:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   691:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   692:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   693:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   694:     ; removing it to a later cleanup pass.
                            	   695:     ;------------------------------------------------------------------
                            	   696:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   697:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   698:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   699:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   700:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   701:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   702:     ; the silence-request bit 7 and route it into native music_silence.
                            	   703:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   704:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   705:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   706:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   707:     ; and clear the game-side byte so the game's own driver-absent check
                            	   708:     ; ("did my song change get consumed?") stays coherent.
02:00000708 103900FF0600    	   709:     move.b  ($FF0600).l,D0
02:0000070E 670C            	   710:     beq.s   .no_song_req_bridge
02:00000710 423900FF0600    	   711:     clr.b   ($FF0600).l
02:00000716 13C000FFE001    	   712:     move.b  D0,(m_song_req).l
                            	   713: .no_song_req_bridge:
02:0000071C 103900FF0604    	   714:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:00000722 6B08            	   715:     bmi.s   .do_silence
02:00000724 103900FF0602    	   716:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:0000072A 6A24            	   717:     bpl.s   .no_silence_req
                            	   718: .do_silence:
02:0000072C 423900FF0602    	   719:     clr.b   ($FF0602).l
02:00000732 423900FF0603    	   720:     clr.b   ($FF0603).l
02:00000738 423900FF0604    	   721:     clr.b   ($FF0604).l
02:0000073E 423900FF0605    	   722:     clr.b   ($FF0605).l
02:00000744 423900FF0607    	   723:     clr.b   ($FF0607).l
02:0000074A 6100067E        	   724:     bsr     music_silence
02:0000074E 6024            	   725:     bra.s   .dmc_poll
                            	   726: .no_silence_req:
02:00000750 103900FFE001    	   727:     move.b  (m_song_req).l,D0
02:00000756 6710            	   728:     beq.s   .no_req
02:00000758 423900FFE001    	   729:     clr.b   (m_song_req).l
02:0000075E 13C000FFE000    	   730:     move.b  D0,(m_song).l
02:00000764 6118            	   731:     bsr     change_song
02:00000766 600C            	   732:     bra.s   .dmc_poll
                            	   733: .no_req:
02:00000768 4A3900FFE000    	   734:     tst.b   (m_song).l
02:0000076E 6704            	   735:     beq.s   .dmc_poll
02:00000770 610001B4        	   736:     bsr     tick_sq1
                            	   737: .dmc_poll:
02:00000774 6184            	   738:     bsr     dmc_dbg_poll            ; scaffold: Start cycles DMC samples
02:00000776 6180            	   739:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   740:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   741:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   742:     ; stay wired.
02:00000778 4CDF07FF        	   743:     movem.l (SP)+,D0-D7/A0-A2
02:0000077C 4E75            	   744:     rts
                            	   745: 
                            	   746: ;==============================================================================
                            	   747: ; change_song — ported from @ChangeSong
                            	   748: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   749: ;
                            	   750: ; Selects the starting phrase index for the new song, then falls into
                            	   751: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   752: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   753: ;==============================================================================
                            	   754: change_song:
02:0000077E 4A00            	   755:     tst.b   D0
02:00000780 6B46            	   756:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:00000782 B03C0006        	   757:     cmp.b   #$06,D0
02:00000786 6610            	   758:     bne.s   .not_zelda
02:00000788 13FC002400FFE002	   759:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:00000790 610000E0        	   760:     bsr     prep_phrase
02:00000794 60000190        	   761:     bra     tick_sq1
                            	   762: .not_zelda:
02:00000798 B03C0001        	   763:     cmp.b   #$01,D0
02:0000079C 6716            	   764:     beq.s   .first_ow
02:0000079E B03C0040        	   765:     cmp.b   #$40,D0
02:000007A2 671A            	   766:     beq.s   .first_uw
02:000007A4 B03C0010        	   767:     cmp.b   #$10,D0
02:000007A8 6626            	   768:     bne     play_next_phrase            ; single-phrase song
02:000007AA 13FC001100FFE002	   769:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:000007B2 601C            	   770:     bra     play_next_phrase
                            	   771: .first_ow:
02:000007B4 13FC000800FFE002	   772:     move.b  #$08,(m_phrase).l
02:000007BC 6012            	   773:     bra     play_next_phrase
                            	   774: .first_uw:
02:000007BE 13FC000F00FFE002	   775:     move.b  #$0F,(m_phrase).l
02:000007C6 6008            	   776:     bra     play_next_phrase
                            	   777: .first_demo:
02:000007C8 13FC001900FFE002	   778:     move.b  #$19,(m_phrase).l
                            	   779:     bra     play_next_phrase
                            	   780: 
                            	   781: ;==============================================================================
                            	   782: ; play_next_phrase — ported from PlayNextPhrase
                            	   783: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   784: ; calls prep_phrase and falls into tick_sq1.
                            	   785: ;==============================================================================
                            	   786: play_next_phrase:
02:000007D0 103900FFE000    	   787:     move.b  (m_song).l,D0
02:000007D6 6B78            	   788:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:000007D8 B03C0001        	   789:     cmp.b   #$01,D0
02:000007DC 6758            	   790:     beq.s   .next_ow
02:000007DE B03C0040        	   791:     cmp.b   #$40,D0
02:000007E2 6738            	   792:     beq.s   .next_uw
02:000007E4 B03C0010        	   793:     cmp.b   #$10,D0
02:000007E8 6718            	   794:     beq.s   .next_ending
                            	   795:     ; Single-phrase song: find bit position, phrase = index
02:000007EA 7200            	   796:     moveq   #0,D1
02:000007EC 7400            	   797:     moveq   #0,D2
02:000007EE 1400            	   798:     move.b  D0,D2
                            	   799: .bitloop:
02:000007F0 5201            	   800:     addq.b  #1,D1
02:000007F2 E20A            	   801:     lsr.b   #1,D2
02:000007F4 64FA            	   802:     bcc.s   .bitloop
02:000007F6 13C100FFE002    	   803:     move.b  D1,(m_phrase).l
02:000007FC 6174            	   804:     bsr     prep_phrase
02:000007FE 60000126        	   805:     bra     tick_sq1
                            	   806: .next_ending:
02:00000802 523900FFE002    	   807:     addq.b  #1,(m_phrase).l
02:00000808 0C39001A00FFE002	   808:     cmpi.b  #$1A,(m_phrase).l
02:00000810 665A            	   809:     bne.s   .prep_and_tick
02:00000812 13FC001400FFE002	   810:     move.b  #$14,(m_phrase).l
02:0000081A 60B4            	   811:     bra     play_next_phrase
                            	   812: .next_uw:
02:0000081C 523900FFE002    	   813:     addq.b  #1,(m_phrase).l
02:00000822 0C39001200FFE002	   814:     cmpi.b  #$12,(m_phrase).l
02:0000082A 6640            	   815:     bne.s   .prep_and_tick
02:0000082C 13FC000F00FFE002	   816:     move.b  #$0F,(m_phrase).l
02:00000834 609A            	   817:     bra     play_next_phrase
                            	   818: .next_ow:
02:00000836 523900FFE002    	   819:     addq.b  #1,(m_phrase).l
02:0000083C 0C39001000FFE002	   820:     cmpi.b  #$10,(m_phrase).l
02:00000844 6626            	   821:     bne.s   .prep_and_tick
02:00000846 13FC000900FFE002	   822:     move.b  #$09,(m_phrase).l
02:0000084E 6080            	   823:     bra     play_next_phrase
                            	   824: .next_demo:
02:00000850 523900FFE002    	   825:     addq.b  #1,(m_phrase).l
02:00000856 0C39002400FFE002	   826:     cmpi.b  #$24,(m_phrase).l
02:0000085E 660C            	   827:     bne.s   .prep_and_tick
02:00000860 13FC001900FFE002	   828:     move.b  #$19,(m_phrase).l
02:00000868 6000FF66        	   829:     bra     play_next_phrase
                            	   830: .prep_and_tick:
02:0000086C 6104            	   831:     bsr     prep_phrase
02:0000086E 600000B6        	   832:     bra     tick_sq1
                            	   833: 
                            	   834: ;==============================================================================
                            	   835: ; prep_phrase — ported from PrepPhrase
                            	   836: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   837: ;==============================================================================
                            	   838: prep_phrase:
02:00000872 43F900000E9C    	   839:     lea     (MusicBlob).l,A1
02:00000878 7200            	   840:     moveq   #0,D1
02:0000087A 123900FFE002    	   841:     move.b  (m_phrase).l,D1
02:00000880 5341            	   842:     subq.w  #1,D1
02:00000882 12311000        	   843:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000886 024100FF        	   844:     andi.w  #$FF,D1
                            	   845: 
                            	   846:     ; byte 0: NoteLengthTableBase
02:0000088A 13F1100000FFE003	   847:     move.b  (A1,D1.w),(m_len_base).l
02:00000892 5241            	   848:     addq.w  #1,D1
                            	   849:     ; byte 1: script ptr lo
02:00000894 7400            	   850:     moveq   #0,D2
02:00000896 14311000        	   851:     move.b  (A1,D1.w),D2
02:0000089A 5241            	   852:     addq.w  #1,D1
                            	   853:     ; byte 2: script ptr hi
02:0000089C 7600            	   854:     moveq   #0,D3
02:0000089E 16311000        	   855:     move.b  (A1,D1.w),D3
02:000008A2 5241            	   856:     addq.w  #1,D1
02:000008A4 E14B            	   857:     lsl.w   #8,D3
02:000008A6 8642            	   858:     or.w    D2,D3                        ; D3 = NES CPU address
02:000008A8 967C8D60        	   859:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:000008AC 02830000FFFF    	   860:     andi.l  #$FFFF,D3
02:000008B2 41F900000E9C    	   861:     lea     (MusicBlob).l,A0
02:000008B8 D1C3            	   862:     adda.l  D3,A0                        ; A0 = M68K script base
02:000008BA 23C800FFE008    	   863:     move.l  A0,(m_script_ptr).l
                            	   864: 
                            	   865:     ; byte 3: NoteOffsetSongTrg
02:000008C0 13F1100000FFE01C	   866:     move.b  (A1,D1.w),(m_trg_off).l
02:000008C8 5241            	   867:     addq.w  #1,D1
                            	   868:     ; byte 4: NoteOffsetSongSq0
02:000008CA 13F1100000FFE014	   869:     move.b  (A1,D1.w),(m_sq0_off).l
02:000008D2 5241            	   870:     addq.w  #1,D1
                            	   871:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:000008D4 13F1100000FFE024	   872:     move.b  (A1,D1.w),(m_noise_off).l
02:000008DC 13F1100000FFE006	   873:     move.b  (A1,D1.w),(m_noise_first).l
02:000008E4 5241            	   874:     addq.w  #1,D1
                            	   875:     ; byte 6: SongEnvelopeSelector
02:000008E6 13F1100000FFE004	   876:     move.b  (A1,D1.w),(m_env_sel).l
02:000008EE 5241            	   877:     addq.w  #1,D1
                            	   878:     ; byte 7: mystery
02:000008F0 13F1100000FFE005	   879:     move.b  (A1,D1.w),(m_mystery).l
                            	   880: 
                            	   881:     ; Reset counters and Sq1 offset
02:000008F8 13FC000100FFE00D	   882:     move.b  #1,(m_sq1_cnt).l
02:00000900 13FC000100FFE015	   883:     move.b  #1,(m_sq0_cnt).l
02:00000908 13FC000100FFE01D	   884:     move.b  #1,(m_trg_cnt).l
02:00000910 13FC000100FFE025	   885:     move.b  #1,(m_noise_cnt).l
02:00000918 423900FFE00C    	   886:     clr.b   (m_sq1_off).l
02:0000091E 423900FFE021    	   887:     clr.b   (m_trg_rep_n).l
02:00000924 4E75            	   888:     rts
                            	   889: 
                            	   890: ;==============================================================================
                            	   891: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   892: ;==============================================================================
                            	   893: tick_sq1:
02:00000926 533900FFE00D    	   894:     subq.b  #1,(m_sq1_cnt).l
02:0000092C 66000116        	   895:     bne     tick_sq0                     ; no new note
                            	   896: .read:
02:00000930 207900FFE008    	   897:     move.l  (m_script_ptr).l,A0
02:00000936 7200            	   898:     moveq   #0,D1
02:00000938 123900FFE00C    	   899:     move.b  (m_sq1_off).l,D1
02:0000093E 523900FFE00C    	   900:     addq.b  #1,(m_sq1_off).l
02:00000944 10301000        	   901:     move.b  (A0,D1.w),D0
02:00000948 673A            	   902:     beq.s   .song_ended
02:0000094A 4A00            	   903:     tst.b   D0
02:0000094C 6B02            	   904:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:0000094E 6022            	   905:     bra.s   .play_note
                            	   906: .prep_then_note:
02:00000950 61000284        	   907:     bsr     get_song_note_length         ; D0 in → D0 length
02:00000954 13C000FFE00E    	   908:     move.b  D0,(m_sq1_len).l
02:0000095A 207900FFE008    	   909:     move.l  (m_script_ptr).l,A0
02:00000960 7200            	   910:     moveq   #0,D1
02:00000962 123900FFE00C    	   911:     move.b  (m_sq1_off).l,D1
02:00000968 523900FFE00C    	   912:     addq.b  #1,(m_sq1_off).l
02:0000096E 10301000        	   913:     move.b  (A0,D1.w),D0
                            	   914: .play_note:
02:00000972 6100027C        	   915:     bsr     emit_note_sq1                 ; D0 = note id
02:00000976 13F900FFE00E00FF	   916:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:0000097E E00D
02:00000980 600000C2        	   917:     bra     tick_sq0
                            	   918: .song_ended:
02:00000984 13FC000100FFE02B	   919:     move.b  #1,(m_song_loop_pending).l   ; signal loop point to C poller
02:0000098C 103900FFE000    	   920:     move.b  (m_song).l,D0
02:00000992 020000F1        	   921:     andi.b  #$F1,D0
02:00000996 6604            	   922:     bne.s   .play_again
02:00000998 60000430        	   923:     bra     music_silence
                            	   924: .play_again:
02:0000099C 6102            	   925:     bsr     play_next_phrase_no_tick
02:0000099E 6090            	   926:     bra.s   .read
                            	   927: 
                            	   928: ;----------------------------------------------------------------------
                            	   929: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   930: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   931: ; to restart a looping song when $00 opcode is read.
                            	   932: ;----------------------------------------------------------------------
                            	   933: play_next_phrase_no_tick:
02:000009A0 103900FFE000    	   934:     move.b  (m_song).l,D0
02:000009A6 6B7E            	   935:     bmi     .nsp_demo
02:000009A8 B03C0001        	   936:     cmp.b   #$01,D0
02:000009AC 675A            	   937:     beq     .nsp_ow
02:000009AE B03C0040        	   938:     cmp.b   #$40,D0
02:000009B2 6738            	   939:     beq     .nsp_uw
02:000009B4 B03C0010        	   940:     cmp.b   #$10,D0
02:000009B8 6716            	   941:     beq     .nsp_ending
                            	   942:     ; single-phrase: rebuild phrase from bit
02:000009BA 7200            	   943:     moveq   #0,D1
02:000009BC 7400            	   944:     moveq   #0,D2
02:000009BE 1400            	   945:     move.b  D0,D2
                            	   946: .nsp_loop:
02:000009C0 5201            	   947:     addq.b  #1,D1
02:000009C2 E20A            	   948:     lsr.b   #1,D2
02:000009C4 64FA            	   949:     bcc     .nsp_loop
02:000009C6 13C100FFE002    	   950:     move.b  D1,(m_phrase).l
02:000009CC 6000FEA4        	   951:     bra     prep_phrase
                            	   952: .nsp_ending:
02:000009D0 523900FFE002    	   953:     addq.b  #1,(m_phrase).l
02:000009D6 0C39001A00FFE002	   954:     cmpi.b  #$1A,(m_phrase).l
02:000009DE 6600FE92        	   955:     bne     prep_phrase
02:000009E2 13FC001400FFE002	   956:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:000009EA 60B4            	   957:     bra     play_next_phrase_no_tick
                            	   958: .nsp_uw:
02:000009EC 523900FFE002    	   959:     addq.b  #1,(m_phrase).l
02:000009F2 0C39001200FFE002	   960:     cmpi.b  #$12,(m_phrase).l
02:000009FA 6600FE76        	   961:     bne     prep_phrase
02:000009FE 13FC000F00FFE002	   962:     move.b  #$0F,(m_phrase).l
02:00000A06 6098            	   963:     bra     play_next_phrase_no_tick
                            	   964: .nsp_ow:
02:00000A08 523900FFE002    	   965:     addq.b  #1,(m_phrase).l
02:00000A0E 0C39001000FFE002	   966:     cmpi.b  #$10,(m_phrase).l
02:00000A16 6600FE5A        	   967:     bne     prep_phrase
02:00000A1A 13FC000900FFE002	   968:     move.b  #$09,(m_phrase).l
02:00000A22 6000FF7C        	   969:     bra     play_next_phrase_no_tick
                            	   970: .nsp_demo:
02:00000A26 523900FFE002    	   971:     addq.b  #1,(m_phrase).l
02:00000A2C 0C39002400FFE002	   972:     cmpi.b  #$24,(m_phrase).l
02:00000A34 6600FE3C        	   973:     bne     prep_phrase
02:00000A38 13FC001900FFE002	   974:     move.b  #$19,(m_phrase).l
02:00000A40 6000FF5E        	   975:     bra     play_next_phrase_no_tick
