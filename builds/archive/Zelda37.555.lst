02:00039E98 41EC046B        	  4256:     lea     ($046B,A4),A0
02:00039E9C 10302000        	  4257:     move.b  (A0,D2.W),D0
02:00039EA0 1B00            	  4258:     move.b  D0,-(A5)  ; PHA
02:00039EA2 41EC034F        	  4259:     lea     ($034F,A4),A0
02:00039EA6 10302000        	  4260:     move.b  (A0,D2.W),D0
02:00039EAA 1B00            	  4261:     move.b  D0,-(A5)  ; PHA
