                            	  9358: TurnTowardsPlayer8:
                            	  9359:     ; Build a direction in [00] towards the player.
                            	  9360:     ;
                            	  9361:     ; First, calculate a horizontal component:
                            	  9362:     ;
                            	  9363:     ; If   observed player X = object X, [00] := 0 (none)
                            	  9364:     ; elif observed player X > object X, [00] := 1 (right)
                            	  9365:     ; else                               [00] := 2 (left)
                            	  9366:     ;
02:0003C42A 7600            	  9367:     moveq   #0,D3
02:0003C42C 1883            	  9368:     move.b  D3,($0000,A4)
02:0003C42E 5203            	  9369:     addq.b  #1,D3
02:0003C430 102C0061        	  9370:     move.b  ($0061,A4),D0
02:0003C434 12342070        	  9371:     move.b  ($70,A4,D2.W),D1
02:0003C438 B001            	  9372:     cmp.b   D1,D0
02:0003C43A 6706            	  9373:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003C43C 6402            	  9374:     bcc  _anon_z04_175
02:0003C43E 5203            	  9375:     addq.b  #1,D3
                            	  9376: _anon_z04_175:
02:0003C440 1883            	  9377:     move.b  D3,($0000,A4)
                            	  9378:     even
                            	  9379: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	  9380:     ; Second, calculate a vertical component.
                            	  9381:     ; Combine it with the horizontal component:
                            	  9382:     ;
                            	  9383:     ; Y := 4 (down)
                            	  9384:     ; if observed player Y <> object Y then
                            	  9385:     ;   if observed player Y < object Y then
                            	  9386:     ;     Y := Y << 1   -- makes it 8 (up)
                            	  9387:     ;   [00] := [00] | Y
                            	  9388:     ;
02:0003C442 7601            	  9389:     moveq   #1,D3
02:0003C444 102C0062        	  9390:     move.b  ($0062,A4),D0
02:0003C448 41EC0084        	  9391:     lea     ($0084,A4),A0
02:0003C44C 12302000        	  9392:     move.b  (A0,D2.W),D1
02:0003C450 B001            	  9393:     cmp.b   D1,D0
02:0003C452 6710            	  9394:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
