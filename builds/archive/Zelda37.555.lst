                            	  5846: _L_z07_UpdateSwordOrRod_Add4:
                            	  5847:     ; Set [00] to (state - 1) * 4:
                            	  5848:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5849:     ;
02:00048B20 023C00EE        	  5850:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B24 123C0004        	  5851:     move.b  #$04,D1
02:00048B28 D101            	  5852:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048B2A 5303            	  5853:     subq.b  #1,D3
02:00048B2C 66F2            	  5854:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048B2E 1880            	  5855:     move.b  D0,($0000,A4)
                            	  5856:     ; Set object's direction to player's. It might have changed
                            	  5857:     ; since the last frame.
                            	  5858:     ;
02:00048B30 102C0098        	  5859:     move.b  ($0098,A4),D0
02:00048B34 41EC0098        	  5860:     lea     ($0098,A4),A0
02:00048B38 11802000        	  5861:     move.b  D0,(A0,D2.W)
                            	  5862:     ; Add [00] and the reverse index of the direction to get
                            	  5863:     ; the byte offset of the pixel offset.
                            	  5864:     ;
02:00048B3C 4EB900030ACA    	  5865:     jsr     GetOppositeDir
02:00048B42 1003            	  5866:     move.b  D3,D0
02:00048B44 023C00EE        	  5867:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B48 1214            	  5868:     move.b  ($0000,A4),D1
02:00048B4A D101            	  5869:     addx.b  D1,D0   ; ADC $00
02:00048B4C 7600            	  5870:     moveq   #0,D3
02:00048B4E 1600            	  5871:     move.b  D0,D3
                            	  5872:     ; Set object's X to player's X + offset for state and direction.
                            	  5873:     ; Copy the result to [00].
                            	  5874:     ;
02:00048B50 102C0070        	  5875:     move.b  ($0070,A4),D0
02:00048B54 023C00EE        	  5876:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B58 41F900048A84    	  5877:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048B5E 12303000        	  5878:     move.b  (A0,D3.W),D1
02:00048B62 D101            	  5879:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048B64 19802070        	  5880:     move.b  D0,($70,A4,D2.W)
02:00048B68 1880            	  5881:     move.b  D0,($0000,A4)
                            	  5882:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5883:     ; Copy the result to [01].
                            	  5884:     ;
02:00048B6A 102C0084        	  5885:     move.b  ($0084,A4),D0
02:00048B6E 023C00EE        	  5886:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B72 41F900048A94    	  5887:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048B78 12303000        	  5888:     move.b  (A0,D3.W),D1
02:00048B7C D101            	  5889:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048B7E 41EC0084        	  5890:     lea     ($0084,A4),A0
02:00048B82 11802000        	  5891:     move.b  D0,(A0,D2.W)
02:00048B86 19400001        	  5892:     move.b  D0,($0001,A4)
                            	  5893:     ; If state = 1, use up direction.
                            	  5894:     ; Else use object direction.
