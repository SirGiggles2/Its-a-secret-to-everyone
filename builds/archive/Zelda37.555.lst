                            	   399: L_Walker_SetInputDirAndTryShootingBoomerang:
                            	   400:     ; Set the input direction to the facing direction.
                            	   401:     ;
02:00038396 41EC0098        	   402:     lea     ($0098,A4),A0
02:0003839A 10302000        	   403:     move.b  (A0,D2.W),D0
02:0003839E 41EC03F8        	   404:     lea     ($03F8,A4),A0
02:000383A2 11802000        	   405:     move.b  D0,(A0,D2.W)
                            	   406:     ; Goriya will throw a boomerang (object type $5C).
                            	   407:     ;
02:000383A6 705C            	   408:     moveq   #92,D0
                            	   409:     ; If the monster is a blue goriya, go check the timer.
                            	   410:     ;
02:000383A8 7600            	   411:     moveq   #0,D3
02:000383AA 41EC034F        	   412:     lea     ($034F,A4),A0
02:000383AE 16302000        	   413:     move.b  (A0,D2.W),D3
02:000383B2 0C030005        	   414:     cmpi.b  #$05,D3
02:000383B6 671C            	   415:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   416:     ; If it's not a red goriya either, then return.
                            	   417:     ;
02:000383B8 0C030006        	   418:     cmpi.b  #$06,D3
02:000383BC 660000A0        	   419:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   420:     ; If a random value <> $23 nor $77, then return.
                            	   421:     ;
02:000383C0 10342018        	   422:     move.b  ($18,A4,D2.W),D0
02:000383C4 0C000023        	   423:     cmpi.b  #$23,D0
02:000383C8 6708            	   424:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:000383CA 0C000077        	   425:     cmpi.b  #$77,D0
02:000383CE 6600008E        	   426:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   427:     even
