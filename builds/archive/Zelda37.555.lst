02:00048C2C 0200000F        	  5976:     andi.b #$0F,D0
02:00048C30 0C000003        	  5977:     cmpi.b  #$03,D0
02:00048C34 6704            	  5978:     beq.s  __far_z_07_0086
02:00048C36 60000084        	  5979:     jmp  L1F854_Exit
                            	  5980: __far_z_07_0086:
                            	  5981:     ; State = 3. Time to instantiate a shot.
                            	  5982:     ;
                            	  5983:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  5984:     ;
02:00048C3A 0C020012        	  5985:     cmpi.b  #$12,D2
02:00048C3E 6704            	  5986:     beq.s  __far_z_07_0087
02:00048C40 60000082        	  5987:     jmp  MakeSwordShot
                            	  5988: __far_z_07_0087:
                            	  5989:     ; Instantiate a magic shot (rod shot).
