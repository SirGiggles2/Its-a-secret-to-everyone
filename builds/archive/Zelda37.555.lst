02:0003BE3C 06              	  8486:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003BE3D 08
02:0003BE3E 07
02:0003BE3F 09
02:0003BE40 00
02:0003BE41 00
02:0003BE42 01
02:0003BE43 01
02:0003BE44 02              	  8487:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003BE45 02
02:0003BE46 03
02:0003BE47 03
02:0003BE48 04
02:0003BE49 00
02:0003BE4A 05
02:0003BE4B 01
