                            	  5500:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5501:     ;
02:00048882 7000            	  5502:     moveq   #0,D0
02:00048884 41EC0380        	  5503:     lea     ($0380,A4),A0
02:00048888 11802000        	  5504:     move.b  D0,(A0,D2.W)
02:0004888C 0C02000D        	  5505:     cmpi.b  #$0D,D2
