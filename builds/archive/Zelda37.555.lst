02:0003933E 0A3C0010        	  2684:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039342 9101            	  2685:     subx.b  D1,D0   ; SBC ObjY,X
02:00039344 0A3C0010        	  2686:     eori    #$10,CCR  ; restore X = 6502 C
