                            	  1835:     ;
02:00038D8A 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038D8E 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038D92 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D96 1214            	  1841:     move.b  ($0000,A4),D1
02:00038D98 D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038D9A 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038D9E 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038DA2 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038DA6 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038DAA B001            	  1853:     cmp.b   D1,D0
02:00038DAC 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038DAE 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038DB0 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038DB4 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038DB8 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038DBA 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038DBE 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038DC2 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038DC6 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038DCA 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038DCE 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038DD0 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038DD4 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038DD8 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  1879:     ;
02:00038DDA 4EB900047B32    	  1880:     jsr     GetCollidableTileStill
02:00038DE0 122C034A        	  1881:     move.b  ($034A,A4),D1
02:00038DE4 B001            	  1882:     cmp.b   D1,D0
02:00038DE6 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038DEA 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:00038DEE 7001            	  1888:     moveq   #1,D0
02:00038DF0 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038DF4 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
02:00038DF8 E308            	  1893:     lsl.b  #1,D0   ; ASL A
02:00038DFA 1940004D        	  1894:     move.b  D0,($004D,A4)
02:00038DFE 6100008C        	  1895:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1896:     ; The leever has to face Link in order to move toward him.
                            	  1897:     ;
02:00038E02 4EB90004807E    	  1898:     jsr     ReverseObjDir
                            	  1899:     even
                            	  1900: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  1901:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  1902:     ;
02:00038E08 41EC00AC        	  1903:     lea     ($00AC,A4),A0
02:00038E0C 10302000        	  1904:     move.b  (A0,D2.W),D0
02:00038E10 0C000003        	  1905:     cmpi.b  #$03,D0
02:00038E14 666E            	  1906:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  1907:     ; State 3.
                            	  1908:     ;
                            	  1909:     ; If being shoved, go shove, animate, and draw the leever.
                            	  1910:     ;
02:00038E16 41EC00C0        	  1911:     lea     ($00C0,A4),A0
02:00038E1A 10302000        	  1912:     move.b  (A0,D2.W),D0
02:00038E1E 670A            	  1913:     beq  _L_z04_UpdateRedLeever_CheckStunned
02:00038E20 4EB900047B4C    	  1914:     jsr     Obj_Shove
02:00038E26 600000AE        	  1915:     jmp     RedLeever_AnimateAndCheckCollisions
                            	  1916: 
                            	  1917:     even
