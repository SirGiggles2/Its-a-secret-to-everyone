                            	  4396: Digdogger_Move:
                            	  4397:     ; This calculation is the same one used in Manhandla to
                            	  4398:     ; manifest the fractional speed over several frames.
                            	  4399:     ;
                            	  4400:     ; To summarize, the formula is:
                            	  4401:     ;
                            	  4402:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4403:     ;
                            	  4404:     ;   SA := SA + (SL AND $E0)
                            	  4405:     ;   [03] := SH + carry
                            	  4406:     ;
                            	  4407:     ; See 04:A28E Manhandla_Move.
                            	  4408:     ;
02:00039FC8 41EC041F        	  4409:     lea     ($041F,A4),A0
02:00039FCC 10302000        	  4410:     move.b  (A0,D2.W),D0
02:00039FD0 020000E0        	  4411:     andi.b #$E0,D0
02:00039FD4 023C00EE        	  4412:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039FD8 41EC0412        	  4413:     lea     ($0412,A4),A0
02:00039FDC 12302000        	  4414:     move.b  (A0,D2.W),D1
02:00039FE0 D101            	  4415:     addx.b  D1,D0   ; ADC $0412,X
02:00039FE2 41EC0412        	  4416:     lea     ($0412,A4),A0
02:00039FE6 11802000        	  4417:     move.b  D0,(A0,D2.W)
                            	  4418:     ; Assign (high speed byte + carry) to [03].
                            	  4419:     ;
02:00039FEA 41EC042C        	  4420:     lea     ($042C,A4),A0
02:00039FEE 10302000        	  4421:     move.b  (A0,D2.W),D0
02:00039FF2 123C0000        	  4422:     move.b  #$00,D1
02:00039FF6 D101            	  4423:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00039FF8 19400003        	  4424:     move.b  D0,($0003,A4)
                            	  4425:     ; Change coordinates by the speed amount/offset in [03]
                            	  4426:     ; according to the direction.
                            	  4427:     ;
                            	  4428:     ; Start with a mask of $A1 in [02]:
                            	  4429:     ; - low nibble represents the right direction
                            	  4430:     ; - high nibble is used to set or clear carry as we go along
                            	  4431:     ;
02:00039FFC 103C00A1        	  4432:     move.b  #$A1,D0
02:0003A000 19400002        	  4433:     move.b  D0,($0002,A4)
                            	  4434:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4435:     ;
02:0003A004 41EC0098        	  4436:     lea     ($0098,A4),A0
02:0003A008 10302000        	  4437:     move.b  (A0,D2.W),D0
02:0003A00C 122C0002        	  4438:     move.b  ($0002,A4),D1
02:0003A010 C200            	  4439:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A012 6712            	  4440:     beq  _L_z04_Digdogger_Move_Left
02:0003A014 10342070        	  4441:     move.b  ($70,A4,D2.W),D0
02:0003A018 023C00EE        	  4442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A01C 122C0003        	  4443:     move.b  ($0003,A4),D1
02:0003A020 D101            	  4444:     addx.b  D1,D0   ; ADC $03
02:0003A022 19802070        	  4445:     move.b  D0,($70,A4,D2.W)
                            	  4446:     even
                            	  4447: _L_z04_Digdogger_Move_Left:
                            	  4448:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  4449:     ;
02:0003A026 41EC0098        	  4450:     lea     ($0098,A4),A0
02:0003A02A 10302000        	  4451:     move.b  (A0,D2.W),D0
02:0003A02E 122C0002        	  4452:     move.b  ($0002,A4),D1
02:0003A032 E309            	  4453:     lsl.b  #1,D1   ; ASL $02
02:0003A034 19410002        	  4454:     move.b  D1,($0002,A4)
02:0003A038 122C0002        	  4455:     move.b  ($0002,A4),D1
02:0003A03C C200            	  4456:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A03E 6716            	  4457:     beq  _L_z04_Digdogger_Move_Down
02:0003A040 10342070        	  4458:     move.b  ($70,A4,D2.W),D0
02:0003A044 122C0003        	  4459:     move.b  ($0003,A4),D1
02:0003A048 0A3C0010        	  4460:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A04C 9101            	  4461:     subx.b  D1,D0   ; SBC $03
02:0003A04E 0A3C0010        	  4462:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A052 19802070        	  4463:     move.b  D0,($70,A4,D2.W)
                            	  4464:     even
                            	  4465: _L_z04_Digdogger_Move_Down:
                            	  4466:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  4467:     ;
02:0003A056 41EC0098        	  4468:     lea     ($0098,A4),A0
02:0003A05A 10302000        	  4469:     move.b  (A0,D2.W),D0
02:0003A05E 122C0002        	  4470:     move.b  ($0002,A4),D1
02:0003A062 E309            	  4471:     lsl.b  #1,D1   ; ASL $02
02:0003A064 19410002        	  4472:     move.b  D1,($0002,A4)
02:0003A068 122C0002        	  4473:     move.b  ($0002,A4),D1
02:0003A06C C200            	  4474:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A06E 6716            	  4475:     beq  _L_z04_Digdogger_Move_Up
02:0003A070 41EC0084        	  4476:     lea     ($0084,A4),A0
02:0003A074 10302000        	  4477:     move.b  (A0,D2.W),D0
02:0003A078 122C0003        	  4478:     move.b  ($0003,A4),D1
02:0003A07C D101            	  4479:     addx.b  D1,D0   ; ADC $03
02:0003A07E 41EC0084        	  4480:     lea     ($0084,A4),A0
02:0003A082 11802000        	  4481:     move.b  D0,(A0,D2.W)
                            	  4482:     even
                            	  4483: _L_z04_Digdogger_Move_Up:
                            	  4484:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  4485:     ;
02:0003A086 41EC0098        	  4486:     lea     ($0098,A4),A0
02:0003A08A 10302000        	  4487:     move.b  (A0,D2.W),D0
02:0003A08E 122C0002        	  4488:     move.b  ($0002,A4),D1
02:0003A092 E309            	  4489:     lsl.b  #1,D1   ; ASL $02
02:0003A094 19410002        	  4490:     move.b  D1,($0002,A4)
02:0003A098 122C0002        	  4491:     move.b  ($0002,A4),D1
02:0003A09C C200            	  4492:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
