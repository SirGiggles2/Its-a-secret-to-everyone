02:0003BE55 10
02:0003BE56 00
02:0003BE57 10
                            	  8493: 
                            	  8494:     even
                            	  8495: GanonSpriteOffsetsY:
02:0003BE58 00              	  8496:     dc.b    $00, $00, $10, $10
02:0003BE59 00
02:0003BE5A 10
02:0003BE5B 10
                            	  8497: 
