                            	  4161: __far_z_02_0004:
                            	  4162:     ; Set the timer to wait 6 frames after the next character about
                            	  4163:     ; to be shown.
                            	  4164:     ;
02:00034D1E 7006            	  4165:     moveq   #6,D0
02:00034D20 19400029        	  4166:     move.b  D0,($0029,A4)
                            	  4167:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4168:     ; to the dynamic transfer buf.
                            	  4169:     ;
02:00034D24 7604            	  4170:     moveq   #4,D3
                            	  4171: _anon_z02_31:
02:00034D26 41F900034D04    	  4172:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034D2C 10303000        	  4173:     move.b  (A0,D3.W),D0
02:00034D30 41EC0302        	  4174:     lea     ($0302,A4),A0
