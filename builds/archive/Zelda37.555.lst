02:00038E2A 102C066C        	  1922:     move.b  ($066C,A4),D0
02:00038E2E 1234203D        	  1923:     move.b  ($3D,A4,D2.W),D1
02:00038E32 8001            	  1924:     or.b  D1,D0
02:00038E34 6704            	  1925:     beq.s  __far_z_04_0013
02:00038E36 6000009E        	  1926:     jmp  RedLeever_AnimateAndCheckCollisions
