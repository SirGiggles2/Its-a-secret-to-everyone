                            	  1609: ;==============================================================================
                            	  1610: ; NES → Genesis palette lookup table
                            	  1611: ;
                            	  1612: ; 64 × 16-bit words: index = NES color byte (0–63).
                            	  1613: ; Genesis color format: $0BGR (bits [10:8]=Blue, [6:4]=Green, [2:0]=Red, 0–7 each).
                            	  1614: ; Source: title-calibrated NES palette approximations tuned against BizHawk
                            	  1615: ; frame-200 NES reference captures, quantized to Genesis 3-bit channels.
                            	  1616: ;==============================================================================
                            	  1617:     even
                            	  1618: nes_palette_to_genesis:
                            	  1619:     ;       NES $00–$0F  (grays, blues, purples, reds, greens)
                            	  1620:     ;       Genesis CRAM = (B<<9)|(G<<5)|(R<<1)  — NOT raw $0BGR nibbles
02:0000E9F0 0666            	  1621:     dc.w    $0666   ; $00  rgb(84,84,84)     dark gray (universal BG)
02:0000E9F2 0E00            	  1622:     dc.w    $0E00   ; $01  rgb(0,0,252)     dark blue
02:0000E9F4 0A00            	  1623:     dc.w    $0A00   ; $02  rgb(0,0,188)     dark blue
02:0000E9F6 0A24            	  1624:     dc.w    $0A24   ; $03  rgb(68,40,188)   blue-violet
02:0000E9F8 0808            	  1625:     dc.w    $0808   ; $04  rgb(148,0,132)   purple
02:0000E9FA 020A            	  1626:     dc.w    $020A   ; $05  rgb(168,0,32)    dark red-magenta
02:0000E9FC 000A            	  1627:     dc.w    $000A   ; $06  rgb(168,16,0)    dark red
02:0000E9FE 0028            	  1628:     dc.w    $0028   ; $07  rgb(136,20,0)    dark red-brown
02:0000EA00 0044            	  1629:     dc.w    $0044   ; $08  dark olive-brown
02:0000EA02 0060            	  1630:     dc.w    $0060   ; $09  rgb(0,120,0)     dark green
02:0000EA04 0060            	  1631:     dc.w    $0060   ; $0A  rgb(0,104,0)     dark green
02:0000EA06 0040            	  1632:     dc.w    $0040   ; $0B  rgb(0,88,0)      very dark green
02:0000EA08 0440            	  1633:     dc.w    $0440   ; $0C  rgb(0,64,88)     dark teal
02:0000EA0A 0000            	  1634:     dc.w    $0000   ; $0D  black (unused/invalid)
02:0000EA0C 0000            	  1635:     dc.w    $0000   ; $0E  black (unused/invalid)
02:0000EA0E 0000            	  1636:     dc.w    $0000   ; $0F  black (unused/invalid)
                            	  1637: 
                            	  1638:     ;       NES $10–$1F  (light grays, bright blues/reds, mid greens, teals)
02:0000EA10 0AAA            	  1639:     dc.w    $0AAA   ; $10  rgb(152,152,152)  light gray
02:0000EA12 0E60            	  1640:     dc.w    $0E60   ; $11  rgb(0,120,248)   bright blue
02:0000EA14 0E40            	  1641:     dc.w    $0E40   ; $12  rgb(0,88,248)    bright blue
02:0000EA16 0E46            	  1642:     dc.w    $0E46   ; $13  rgb(104,68,252)  blue-violet
02:0000EA18 0C0C            	  1643:     dc.w    $0C0C   ; $14  rgb(216,0,204)   bright magenta
02:0000EA1A 040C            	  1644:     dc.w    $040C   ; $15  rgb(228,0,88)    bright red
02:0000EA1C 004A            	  1645:     dc.w    $004A   ; $16  orange-red
02:0000EA1E 004A            	  1646:     dc.w    $004A   ; $17  orange
02:0000EA20 006A            	  1647:     dc.w    $006A   ; $18  rgb(172,124,0)   yellow-orange
02:0000EA22 00A0            	  1648:     dc.w    $00A0   ; $19  rgb(0,184,0)     green
02:0000EA24 0080            	  1649:     dc.w    $0080   ; $1A  green
02:0000EA26 04A0            	  1650:     dc.w    $04A0   ; $1B  rgb(0,168,68)    green-teal
02:0000EA28 0880            	  1651:     dc.w    $0880   ; $1C  rgb(0,136,136)   teal
02:0000EA2A 0000            	  1652:     dc.w    $0000   ; $1D  black (unused/invalid)
02:0000EA2C 0000            	  1653:     dc.w    $0000   ; $1E  black (unused/invalid)
02:0000EA2E 0000            	  1654:     dc.w    $0000   ; $1F  black (unused/invalid)
                            	  1655: 
                            	  1656:     ;       NES $20–$2F  (near-white, light colors, pastels)
02:0000EA30 0EEE            	  1657:     dc.w    $0EEE   ; $20  rgb(248,248,248) near-white
02:0000EA32 0EA4            	  1658:     dc.w    $0EA4   ; $21  rgb(60,188,252)  light cyan-blue
02:0000EA34 0E86            	  1659:     dc.w    $0E86   ; $22  light blue
02:0000EA36 0E68            	  1660:     dc.w    $0E68   ; $23  rgb(152,120,248) light purple-blue
02:0000EA38 0E6E            	  1661:     dc.w    $0E6E   ; $24  rgb(248,120,248) light magenta
02:0000EA3A 084E            	  1662:     dc.w    $084E   ; $25  rgb(248,88,152)  light pink-red
02:0000EA3C 046E            	  1663:     dc.w    $046E   ; $26  rgb(248,120,88)  light orange
02:0000EA3E 048E            	  1664:     dc.w    $048E   ; $27  rgb(252,160,68)  light yellow-orange
02:0000EA40 00CC            	  1665:     dc.w    $00CC   ; $28  yellow
02:0000EA42 02EA            	  1666:     dc.w    $02EA   ; $29  rgb(184,248,24)  yellow-green
02:0000EA44 04C4            	  1667:     dc.w    $04C4   ; $2A  rgb(88,216,84)   light green
02:0000EA46 08E4            	  1668:     dc.w    $08E4   ; $2B  rgb(88,248,152)  light green-teal
02:0000EA48 0CC0            	  1669:     dc.w    $0CC0   ; $2C  rgb(0,232,216)   light teal
02:0000EA4A 0666            	  1670:     dc.w    $0666   ; $2D  rgb(120,120,120) medium gray
02:0000EA4C 0000            	  1671:     dc.w    $0000   ; $2E  black (unused/invalid)
02:0000EA4E 0000            	  1672:     dc.w    $0000   ; $2F  black (unused/invalid)
                            	  1673: 
                            	  1674:     ;       NES $30–$3F  (whites, very light pastels)
