02:00034EDE 19400072        	  4400:     move.b  D0,($0072,A4)
02:00034EE2 102C0085        	  4401:     move.b  ($0085,A4),D0
02:00034EE6 003C0011        	  4402:     ori     #$11,CCR  ; SEC: set C+X
02:00034EEA 123C0010        	  4403:     move.b  #$10,D1
02:00034EEE 0A3C0010        	  4404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034EF2 9101            	  4405:     subx.b  D1,D0   ; SBC #$10
02:00034EF4 0A3C0010        	  4406:     eori    #$10,CCR  ; restore X = 6502 C
02:00034EF8 19400086        	  4407:     move.b  D0,($0086,A4)
                            	  4408:     ; Draw triforce over Zelda.
