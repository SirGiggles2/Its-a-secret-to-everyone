02:000353A6 10302000        	  4797:     move.b  (A0,D2.W),D0
02:000353AA 19400302        	  4798:     move.b  D0,($0302,A4)
                            	  4799:     ; The line number will be used to shift the task mask below.
                            	  4800:     ;
