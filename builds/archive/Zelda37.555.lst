02:00047336 103C0082        	  2383:     move.b  #$82,D0
02:0004733A 41EC0304        	  2384:     lea     ($0304,A4),A0
02:0004733E 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:00047342 41EC0309        	  2386:     lea     ($0309,A4),A0
