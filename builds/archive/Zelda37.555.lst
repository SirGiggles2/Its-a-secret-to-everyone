02:0000E69A EB4D            	  1068:     lsl.w   #5,D5
02:0000E69C E14D            	  1069:     lsl.w   #8,D5                   ; D5.w = palette<<13  (bits [14:13])
02:0000E69E 610002EA        	  1070:     bsr     _attr_write_2x2
                            	  1071: 
