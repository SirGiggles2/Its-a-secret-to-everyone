                            	   429:     ; Goriya will throw a boomerang (object type $5C).
                            	   430:     ;
02:000383D2 705C            	   431:     moveq   #92,D0
                            	   432:     even
                            	   433: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot:
                            	   434:     ; If object timer <> 0, return.
                            	   435:     ;
02:000383D4 7600            	   436:     moveq   #0,D3
02:000383D6 16342028        	   437:     move.b  ($28,A4,D2.W),D3
02:000383DA 66000082        	   438:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   439:     ; Store in [00] the type of projectile the monster will throw.
                            	   440:     ;
02:000383DE 1880            	   441:     move.b  D0,($0000,A4)
                            	   442:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   443:     ;
02:000383E0 102C066C        	   444:     move.b  ($066C,A4),D0
02:000383E4 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:000383E8 8001            	   446:     or.b  D1,D0
02:000383EA 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
                            	   449:     ;
02:000383EC 1014            	   450:     move.b  ($0000,A4),D0
02:000383EE 61003EBA        	   451:     jsr     _ShootIfWanted
02:000383F2 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:000383F4 103C0080        	   455:     move.b  #$80,D0
02:000383F8 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:000383FC 11802000        	   457:     move.b  D0,(A0,D2.W)
                            	   458:     ; Reset the "wants to shoot" flag.
                            	   459:     ;
02:00038400 7000            	   460:     moveq   #0,D0
02:00038402 41EC0412        	   461:     lea     ($0412,A4),A0
02:00038406 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
                            	   464:     ;
02:0003840A 1002            	   465:     move.b  D2,D0
02:0003840C 41EC042C        	   466:     lea     ($042C,A4),A0
02:00038410 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:00038414 1003            	   470:     move.b  D3,D0
02:00038416 41EC042C        	   471:     lea     ($042C,A4),A0
02:0003841A 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
02:0003841E 7010            	   475:     moveq   #16,D0
02:00038420 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:00038424 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   479:     ;
02:00038428 103C00A0        	   480:     move.b  #$A0,D0
02:0003842C 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:00038430 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:00038434 7051            	   485:     moveq   #81,D0
02:00038436 41EC0380        	   486:     lea     ($0380,A4),A0
02:0003843A 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
                            	   489:     ;
02:0003843E 7000            	   490:     moveq   #0,D0
02:00038440 41EC0405        	   491:     lea     ($0405,A4),A0
02:00038444 11803000        	   492:     move.b  D0,(A0,D3.W)
                            	   493:     ; The first animation frame lasts 3 screen frames.
                            	   494:     ;
02:00038448 7003            	   495:     moveq   #3,D0
02:0003844A 41EC03D0        	   496:     lea     ($03D0,A4),A0
02:0003844E 11803000        	   497:     move.b  D0,(A0,D3.W)
                            	   498:     ; Have the monster wait a random amount of time, up to $3F frames.
                            	   499:     ;
02:00038452 10342018        	   500:     move.b  ($18,A4,D2.W),D0
02:00038456 0200003F        	   501:     andi.b #$3F,D0
02:0003845A 19802028        	   502:     move.b  D0,($28,A4,D2.W)
