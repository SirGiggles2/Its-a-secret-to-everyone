                            	   255: _anon_z04_7:
                            	   256:     ; If speed = 0, or the object is between squares;
                            	   257:     ; then go set input direction to facing direction.
                            	   258:     ;
02:00038288 41EC03BC        	   259:     lea     ($03BC,A4),A0
02:0003828C 10302000        	   260:     move.b  (A0,D2.W),D0
02:00038290 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:00038294 41EC0394        	   262:     lea     ($0394,A4),A0
02:00038298 10302000        	   263:     move.b  (A0,D2.W),D0
02:0003829C 0200000F        	   264:     andi.b #$0F,D0
02:000382A0 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:000382A4 41EC0394        	   268:     lea     ($0394,A4),A0
02:000382A8 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:000382AC 41EC041F        	   273:     lea     ($041F,A4),A0
02:000382B0 10302000        	   274:     move.b  (A0,D2.W),D0
02:000382B4 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:000382B8 B001            	   276:     cmp.b   D1,D0
02:000382BA 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:000382BE 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:000382C2 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:000382C6 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:000382CA 102C0061        	   284:     move.b  ($0061,A4),D0
02:000382CE 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:000382D2 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:000382D6 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000382DA 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:000382DC 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:000382E0 6A0C            	   290:     bpl  _anon_z04_8
02:000382E2 4600            	   291:     eori.b #$FF,D0
02:000382E4 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:000382E8 123C0001        	   293:     move.b  #$01,D1
02:000382EC D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
                            	   297:     ;
02:000382EE 0C000009        	   298:     cmpi.b  #$09,D0
02:000382F2 6416            	   299:     bcc  _L_z04_Exit_CheckVerticalDistance
                            	   300:     even
                            	   301: _L_z04_Exit_TurnVertically:
