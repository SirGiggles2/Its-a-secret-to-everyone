                            	  7868:     ;
02:0003B9E4 102C0085        	  7869:     move.b  ($0085,A4),D0
02:0003B9E8 003C0011        	  7870:     ori     #$11,CCR  ; SEC: set C+X
02:0003B9EC 1214            	  7871:     move.b  ($0000,A4),D1
02:0003B9EE 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B9F2 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B9F4 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B9F8 41EC0084        	  7875:     lea     ($0084,A4),A0
02:0003B9FC 11802000        	  7876:     move.b  D0,(A0,D2.W)
