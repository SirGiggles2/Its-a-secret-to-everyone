02:0003A46C 11802000        	  5008:     move.b  D0,(A0,D2.W)
                            	  5009:     ; If substate <> 0, go decrement bloated timer.
                            	  5010:     ;
02:0003A470 4A03            	  5011:     cmpi.b  #$00,D3
02:0003A472 6702            	  5012:     beq.s  __far_z_04_0044
02:0003A474 605C            	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0044:
                            	  5015:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5016:     ;
02:0003A476 7610            	  5017:     moveq   #16,D3
02:0003A478 7000            	  5018:     moveq   #0,D0
02:0003A47A 41EC00AC        	  5019:     lea     ($00AC,A4),A0
02:0003A47E 11803000        	  5020:     move.b  D0,(A0,D3.W)
                            	  5021:     ; Increment the number of bomb hits.
                            	  5022:     ;
02:0003A482 41EC0437        	  5023:     lea     ($0437,A4),A0
02:0003A486 10302000        	  5024:     move.b  (A0,D2.W),D0
02:0003A48A 023C00EE        	  5025:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A48E 123C0001        	  5026:     move.b  #$01,D1
02:0003A492 D101            	  5027:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A494 41EC0437        	  5028:     lea     ($0437,A4),A0
02:0003A498 11802000        	  5029:     move.b  D0,(A0,D2.W)
02:0003A49C 6034            	  5030:     jmp     L_Dodongo_DecrementBloatedTimer
