                            	   107: _L_z02_TransferCommonPatterns_LoopBlock:
02:0003139C 102C051D        	   108:     move.b  ($051D,A4),D0
02:000313A0 E308            	   109:     lsl.b  #1,D0   ; ASL A
02:000313A2 7400            	   110:     moveq   #0,D2
02:000313A4 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:000313A6 41F900031378    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:000313AC 3A02            	   117:     move.w  D2,D5
02:000313AE DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:000313B0 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:000313B4 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:000313B8 41F900031384    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:000313BE 10302000        	   122:     move.b  (A0,D2.W),D0
02:000313C2 19400002        	   123:     move.b  D0,($0002,A4)
02:000313C6 41F90003138A    	   124:     lea     (CommonPatternVramAddrs).l,A0
02:000313CC 10302000        	   125:     move.b  (A0,D2.W),D0
02:000313D0 4EB90000E3C2    	   126:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:000313D6 5202            	   127:     addq.b  #1,D2
                            	   128:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:000313D8 41F900031384    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:000313DE 10302000        	   130:     move.b  (A0,D2.W),D0
02:000313E2 19400003        	   131:     move.b  D0,($0003,A4)
02:000313E6 41F90003138A    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:000313EC 10302000        	   133:     move.b  (A0,D2.W),D0
02:000313F0 611C            	   134:     jsr     TransferPatternBlock_Bank2
                            	   135:     ; Loop until pattern block index = 3.
                            	   136:     ;
02:000313F2 102C051D        	   137:     move.b  ($051D,A4),D0
02:000313F6 0C000003        	   138:     cmpi.b  #$03,D0
02:000313FA 66A0            	   139:     bne  _L_z02_TransferCommonPatterns_LoopBlock
02:000313FC 705A            	   140:     moveq   #90,D0
02:000313FE 194000F5        	   141:     move.b  D0,($00F5,A4)
02:00031402 7000            	   142:     moveq   #0,D0
02:00031404 1940051D        	   143:     move.b  D0,($051D,A4)
02:00031408 0A3C0001        	   144:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003140C 4E75            	   145:     rts
