02:00048CE4 101D            	  6092:     move.b  (A5)+,D0  ; PLA
02:00048CE6 E208            	  6093:     lsr.b  #1,D0   ; LSR A
02:00048CE8 E208            	  6094:     lsr.b  #1,D0   ; LSR A
02:00048CEA E208            	  6095:     lsr.b  #1,D0   ; LSR A
02:00048CEC E208            	  6096:     lsr.b  #1,D0   ; LSR A
02:00048CEE 1214            	  6097:     move.b  ($0000,A4),D1
02:00048CF0 B001            	  6098:     cmp.b   D1,D0
02:00048CF2 6702            	  6099:     beq.s  __far_z_07_0092
02:00048CF4 60C6            	  6100:     jmp  L1F854_Exit
