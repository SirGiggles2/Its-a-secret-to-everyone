02:00039284 123C001C        	  2589:     move.b  #$1C,D1
02:00039288 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003928C 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:0003928E 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:00039292 41EC0084        	  2593:     lea     ($0084,A4),A0
