                            	  7788: __far_z_04_0086:
                            	  7789:     ; State = 0.
                            	  7790:     ;
                            	  7791:     ; If the current object slot is 2, then go initialize the patra child.
                            	  7792:     ; This is the only patra child shown in the first fame.
                            	  7793:     ;
02:0003B966 0C020002        	  7794:     cmpi.b  #$02,D2
02:0003B96A 6732            	  7795:     beq  _L_z04_UpdatePatraChild_Ready
                            	  7796:     ; The patra child in slot 2 is the last one to be updated.
                            	  7797:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  7798:     ;
                            	  7799:     ; This means that in the first frame, slot 2 is the only one to be
                            	  7800:     ; shown.
                            	  7801:     ;
02:0003B96C 102C00AE        	  7802:     move.b  ($00AE,A4),D0
02:0003B970 6700008E        	  7803:     beq  _L_z04_UpdatePatraChild_Exit
                            	  7804:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  7805:     ; here to wait to be shown at the top position (N) one at a time.
                            	  7806:     ;
02:0003B974 1002            	  7807:     move.b  D2,D0
                            	  7808:     ; Subtract 3 from the object slot to get the angle where the
                            	  7809:     ; patra child in object slot 2 should be for the current one to appear.
                            	  7810:     ;
02:0003B976 003C0011        	  7811:     ori     #$11,CCR  ; SEC: set C+X
02:0003B97A 123C0003        	  7812:     move.b  #$03,D1
02:0003B97E 0A3C0010        	  7813:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B982 9101            	  7814:     subx.b  D1,D0   ; SBC #$03
02:0003B984 0A3C0010        	  7815:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B988 7600            	  7816:     moveq   #0,D3
02:0003B98A 1600            	  7817:     move.b  D0,D3
                            	  7818:     ; If the patra child in slot 2 has not reached the required angle,
                            	  7819:     ; then return.
                            	  7820:     ;
02:0003B98C 102C0396        	  7821:     move.b  ($0396,A4),D0
02:0003B990 41F90003B94A    	  7822:     lea     (PatraChildStartAngles).l,A0
02:0003B996 12303000        	  7823:     move.b  (A0,D3.W),D1
02:0003B99A B001            	  7824:     cmp.b   D1,D0
02:0003B99C 6662            	  7825:     bne  _L_z04_UpdatePatraChild_Exit
                            	  7826:     even
                            	  7827: _L_z04_UpdatePatraChild_Ready:
                            	  7828:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  7829:     ; the patra parent's state.
