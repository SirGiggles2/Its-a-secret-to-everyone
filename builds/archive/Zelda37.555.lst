                            	  3875: ; AddQSpeedToPositionFraction — D2=slot. Returns carry in CCR (C=1 if advanced).
                            	  3876: ; ASM MoveObject_Right/Down consume this via `addx.b`, which reads CCR.X (bit 4).
                            	  3877: ; 6502 convention: X mirrors C. Set/clear both bits 0 (C) and 4 (X).
                            	  3878: c_add_q_speed_to_position_fraction:
02:0002C9BA 7000            	  3879:     moveq   #0,D0
02:0002C9BC 3002            	  3880:     move.w  D2,D0
02:0002C9BE 2F00            	  3881:     move.l  D0,-(SP)
02:0002C9C0 4EB900000000    	  3882:     jsr     z01_add_q_speed_to_position_fraction
02:0002C9C6 588F            	  3883:     addq.l  #4,SP
02:0002C9C8 08000008        	  3884:     btst    #8,D0
02:0002C9CC 6706            	  3885:     beq.s   .cc_aqspf
02:0002C9CE 003C0011        	  3886:     ori     #$11,CCR
02:0002C9D2 4E75            	  3887:     rts
