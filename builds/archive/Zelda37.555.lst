                            	  3492:     ; palettes (PAL0[4..15] + PAL1[4..7]).  See .t19_spr_cram_base for the
                            	  3493:     ; mapping table.  Using an inline table to avoid cross-scope lea.
02:0002B64C 3C00            	  3494:     move.w  D0,D6
02:0002B64E 04460010        	  3495:     subi.w  #$10,D6
02:0002B652 E44E            	  3496:     lsr.w   #2,D6                   ; D6 = sub-pal (0..3)
02:0002B654 DC46            	  3497:     add.w   D6,D6                   ; * 2 for word index
02:0002B656 45FA0010        	  3498:     lea     (.ttf_spr_cram_base,PC),A2
02:0002B65A 3C326000        	  3499:     move.w  (A2,D6.W),D6            ; D6 = CRAM base for this sub-pal
02:0002B65E 02400003        	  3500:     andi.w  #$0003,D0               ; color slot (1..3)
02:0002B662 D040            	  3501:     add.w   D0,D0                   ; * 2
02:0002B664 DC40            	  3502:     add.w   D0,D6                   ; D6 = CRAM address
                            	  3503:     ; D2 preserved (holds palette data byte for later .ttf_pal_have_cram lookup)
02:0002B666 6008            	  3504:     bra.s   .ttf_pal_have_cram_new
                            	  3505: .ttf_spr_cram_base:
02:0002B668 0008            	  3506:     dc.w    $08                     ; sub-pal 0 → PAL0[4]
02:0002B66A 0010            	  3507:     dc.w    $10                     ; sub-pal 1 → PAL0[8]
02:0002B66C 0018            	  3508:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0002B66E 0028            	  3509:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3510: .ttf_pal_have_cram_new:
                            	  3511:     else
                            	  3512:     ; Legacy: remap NES sprite pal 0-3 → Genesis pal 2-3 (last-write-wins).
                            	  3513:     move.w  D0,D6
                            	  3514:     subi.w  #$10,D6
                            	  3515:     lsr.w   #2,D6                   ; NES sprite pal (0-3)
                            	  3516:     ori.w   #$0002,D6               ; Genesis pal = NES_pal | 2 (0→2, 1→3, 2→2, 3→3)
                            	  3517:     andi.w  #$0003,D6
                            	  3518:     lsl.w   #5,D6                   ; * $20
                            	  3519:     andi.w  #$0003,D0               ; color slot
                            	  3520:     lsl.w   #1,D0                   ; * 2
                            	  3521:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3522:     endc
02:0002B670 600E            	  3523:     bra.s   .ttf_pal_have_cram
                            	  3524: .ttf_pal_bg:
                            	  3525: 
                            	  3526:     ; Compute CRAM address: palette_idx*$20 + color_slot*2
02:0002B672 3C00            	  3527:     move.w  D0,D6
02:0002B674 E44E            	  3528:     lsr.w   #2,D6                   ; palette index (0..3)
02:0002B676 EB4E            	  3529:     lsl.w   #5,D6                   ; * $20
02:0002B678 02400003        	  3530:     andi.w  #$0003,D0               ; color slot
02:0002B67C E348            	  3531:     lsl.w   #1,D0                   ; * 2
02:0002B67E DC40            	  3532:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3533: .ttf_pal_have_cram:
                            	  3534: 
                            	  3535:     ; VDP CRAM write command
02:0002B680 7000            	  3536:     moveq   #0,D0
02:0002B682 3006            	  3537:     move.w  D6,D0
02:0002B684 4840            	  3538:     swap    D0
02:0002B686 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B68C 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
                            	  3541: 
                            	  3542:     ; Look up NES->Genesis color
02:0002B692 7000            	  3543:     moveq   #0,D0
02:0002B694 1002            	  3544:     move.b  D2,D0
02:0002B696 0240003F        	  3545:     andi.w  #$003F,D0               ; mask to valid color index
02:0002B69A E348            	  3546:     lsl.w   #1,D0                   ; word offset
02:0002B69C 30330000        	  3547:     move.w  (A3,D0.W),D0           ; Genesis color word
02:0002B6A0 33C000C00000    	  3548:     move.w  D0,(VDP_DATA).l
                            	  3549: 
                            	  3550: .ttf_pal_skip:
02:0002B6A6 DA41            	  3551:     add.w   D1,D5                   ; advance PPU_VADDR
02:0002B6A8 02453FFF        	  3552:     andi.w  #$3FFF,D5
02:0002B6AC 5343            	  3553:     subq.w  #1,D3
02:0002B6AE 6600FF72        	  3554:     bne     .ttf_pal_loop
                            	  3555: 
                            	  3556:     ; Palette post-reset: set PPU_VADDR to $0000, clear latch
02:0002B6B2 33FC000000FF0802	  3557:     move.w  #$0000,(PPU_VADDR).l
02:0002B6BA 423900FF0800    	  3558:     clr.b   (PPU_LATCH).l
02:0002B6C0 265F            	  3559:     movea.l (SP)+,A3                ; restore safety limit
02:0002B6C2 6000FAE2        	  3560:     bra     .ttf_next_record        ; skip .ttf_post_record
                            	  3561: 
                            	  3562:     ;==========================================================================
                            	  3563:     ; SKIP: unhandled PPU address range — consume payload and continue
                            	  3564:     ;==========================================================================
                            	  3565: .ttf_skip_range:
02:0002B6C6 4A04            	  3566:     tst.b   D4                      ; repeat mode?
02:0002B6C8 6602            	  3567:     bne.s   .ttf_post_record        ; repeat: 1 byte already consumed
02:0002B6CA D0C3            	  3568:     adda.w  D3,A0                   ; sequential: skip D3 bytes
                            	  3569:     bra     .ttf_post_record
                            	  3570: 
                            	  3571:     ;==========================================================================
                            	  3572:     ; POST-RECORD: update PPU_VADDR and loop to next record
                            	  3573:     ;==========================================================================
                            	  3574: .ttf_post_record:
02:0002B6CC 33C500FF0802    	  3575:     move.w  D5,(PPU_VADDR).l
02:0002B6D2 6000FAD2        	  3576:     bra     .ttf_next_record
