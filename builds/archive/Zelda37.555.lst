                            	  2014: UpdateOctorock:
                            	  2015:     ; If the monster is a fast octorock, use turn rate $A0.
                            	  2016:     ; Else use turn rate $70.
                            	  2017:     ;
02:00038EF0 103C00A0        	  2018:     move.b  #$A0,D0
02:00038EF4 7600            	  2019:     moveq   #0,D3
02:00038EF6 41EC034F        	  2020:     lea     ($034F,A4),A0
02:00038EFA 16302000        	  2021:     move.b  (A0,D2.W),D3
02:00038EFE 0C030009        	  2022:     cmpi.b  #$09,D3
02:00038F02 6402            	  2023:     bcc  _anon_z04_48
02:00038F04 7070            	  2024:     moveq   #112,D0
                            	  2025: _anon_z04_48:
02:00038F06 41EC041F        	  2026:     lea     ($041F,A4),A0
02:00038F0A 11802000        	  2027:     move.b  D0,(A0,D2.W)
02:00038F0E 6100F372        	  2028:     jsr     Wanderer_TargetPlayer
                            	  2029:     ; If the octorock is slow, then use q-speed $20.
                            	  2030:     ; Else double it.
                            	  2031:     ;
02:00038F12 7020            	  2032:     moveq   #32,D0
02:00038F14 7600            	  2033:     moveq   #0,D3
02:00038F16 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038F1A 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038F1E 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038F22 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F24 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038F28 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F2A E308            	  2040:     lsl.b  #1,D0   ; ASL A
                            	  2041:     even
                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038F2C 7653            	  2045:     moveq   #83,D3
02:00038F2E 6100F97C        	  2046:     jsr     _TryShooting
02:00038F32 4EB90004910E    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038F38 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038F3C 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038F40 7600            	  2052:     moveq   #0,D3
02:00038F42 1600            	  2053:     move.b  D0,D3
02:00038F44 0200000C        	  2054:     andi.b #$0C,D0
02:00038F48 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038F4A 7002            	  2056:     moveq   #2,D0
02:00038F4C 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038F50 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
                            	  2060:     ;
02:00038F52 7001            	  2061:     moveq   #1,D0
02:00038F54 660C            	  2062:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2063:     even
                            	  2064: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  2065:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  2066:     ;
02:00038F56 0C030001        	  2067:     cmpi.b  #$01,D3
02:00038F5A 6604            	  2068:     bne  _anon_z04_49
02:00038F5C 522C000F        	  2069:     addq.b  #1,($000F,A4)
                            	  2070: _anon_z04_49:
                            	  2071:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  2072:     ;
02:00038F60 7000            	  2073:     moveq   #0,D0
                            	  2074:     even
                            	  2075: _L_z04_UpdateOctorock_SaveOffset:
02:00038F62 1B00            	  2076:     move.b  D0,-(A5)  ; PHA
                            	  2077:     ; Decrement the animation counter, and roll over if needed.
                            	  2078:     ;
02:00038F64 41EC03D0        	  2079:     lea     ($03D0,A4),A0
02:00038F68 53302000        	  2080:     subq.b  #1,(A0,D2.W)
02:00038F6C 661E            	  2081:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:00038F6E 7006            	  2082:     moveq   #6,D0
02:00038F70 41EC03D0        	  2083:     lea     ($03D0,A4),A0
02:00038F74 11802000        	  2084:     move.b  D0,(A0,D2.W)
                            	  2085:     ; There are actually 6 frame images divided into 2 sets.
                            	  2086:     ; Each set depicts one animation frame. In each set there are
                            	  2087:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2088:     ;
                            	  2089:     ; The movement frame will keep track of the base offset of
                            	  2090:     ; the current set for the current animation frame: 0 or 3.
                            	  2091:     ;
                            	  2092:     ; So, XOR the movement frame with 3.
                            	  2093:     ;
02:00038F78 E208            	  2094:     lsr.b  #1,D0   ; LSR A
02:00038F7A 41EC03E4        	  2095:     lea     ($03E4,A4),A0
02:00038F7E 12302000        	  2096:     move.b  (A0,D2.W),D1
02:00038F82 B300            	  2097:     eor.b  D1,D0
02:00038F84 41EC03E4        	  2098:     lea     ($03E4,A4),A0
02:00038F88 11802000        	  2099:     move.b  D0,(A0,D2.W)
                            	  2100:     even
                            	  2101: _L_z04_UpdateOctorock_CalcFinalOffset:
