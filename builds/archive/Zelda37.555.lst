02:000353B8 E308            	  4807:     lsl.b  #1,D0   ; ASL A
02:000353BA E308            	  4808:     lsl.b  #1,D0   ; ASL A
02:000353BC E308            	  4809:     lsl.b  #1,D0   ; ASL A
02:000353BE E308            	  4810:     lsl.b  #1,D0   ; ASL A
