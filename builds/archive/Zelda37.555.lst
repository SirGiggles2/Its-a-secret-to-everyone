                            	  7083: InitObject:
02:000494C2 7400            	  7084:     moveq   #0,D2
02:000494C4 142C0340        	  7085:     move.b  ($0340,A4),D2
                            	  7086:     ; We want to handle "enemies from the edges of the screen".
                            	  7087:     ;
                            	  7088:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7089:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7090:     ; that does not spawn with a cloud (type >= $53);
                            	  7091:     ; 
                            	  7092:     ; then go initialize the object.
                            	  7093:     ;
02:000494C8 102C0010        	  7094:     move.b  ($0010,A4),D0
02:000494CC 66000196        	  7095:     bne  _L_z07_InitObject_NormalSpawn
02:000494D0 102C04CD        	  7096:     move.b  ($04CD,A4),D0
02:000494D4 02000008        	  7097:     andi.b #$08,D0
02:000494D8 6700018A        	  7098:     beq  _L_z07_InitObject_NormalSpawn
02:000494DC 41EC034F        	  7099:     lea     ($034F,A4),A0
02:000494E0 10302000        	  7100:     move.b  (A0,D2.W),D0
02:000494E4 0C000011        	  7101:     cmpi.b  #$11,D0
02:000494E8 6700017A        	  7102:     beq  _L_z07_InitObject_NormalSpawn
02:000494EC 0C000040        	  7103:     cmpi.b  #$40,D0
02:000494F0 67000172        	  7104:     beq  _L_z07_InitObject_NormalSpawn
02:000494F4 0C00001E        	  7105:     cmpi.b  #$1E,D0
02:000494F8 6700016A        	  7106:     beq  _L_z07_InitObject_NormalSpawn
02:000494FC 0C00002E        	  7107:     cmpi.b  #$2E,D0
02:00049500 67000162        	  7108:     beq  _L_z07_InitObject_NormalSpawn
02:00049504 0C000053        	  7109:     cmpi.b  #$53,D0
02:00049508 6400015A        	  7110:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7111:     even
                            	  7112: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7113:     ; If the "monsters from edges" long timer expired, then
                            	  7114:     ; go bring the monster in.
                            	  7115:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7116:     ;
                            	  7117:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7118:     ; residual position so enemies keep their previous-room
                            	  7119:     ; positions instead of being re-edge-spawned (matches NES).
02:0004950C 102C004B        	  7120:     move.b  ($004B,A4),D0
02:00049510 662E            	  7121:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7122:     ; timer == 0. Check for fresh room-entry + residual position.
02:00049512 102C000F        	  7123:     move.b  ($000F,A4),D0
02:00049516 0C0000FF        	  7124:     cmpi.b  #$FF,D0
02:0004951A 662E            	  7125:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004951C 41EC0070        	  7126:     lea     ($0070,A4),A0
02:00049520 10302000        	  7127:     move.b  (A0,D2.W),D0
02:00049524 660A            	  7128:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049526 41EC0084        	  7129:     lea     ($0084,A4),A0
02:0004952A 10302000        	  7130:     move.b  (A0,D2.W),D0
02:0004952E 671A            	  7131:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7132:     even
                            	  7133: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:00049530 7001            	  7134:     moveq   #1,D0
02:00049532 1940004B        	  7135:     move.b  D0,($004B,A4)
02:00049536 41EC0492        	  7136:     lea     ($0492,A4),A0
02:0004953A 11802000        	  7137:     move.b  D0,(A0,D2.W)
02:0004953E 4E75            	  7138:     rts
                            	  7139:     even
                            	  7140: _L_z07_InitObject_UninitMonsterFromEdge_Gate:
02:00049540 41EC0492        	  7141:     lea     ($0492,A4),A0
02:00049544 11802000        	  7142:     move.b  D0,(A0,D2.W)
02:00049548 4E75            	  7143:     rts
                            	  7144: 
