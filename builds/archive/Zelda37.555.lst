                            	  4759: ; ShootIfWanted(type, slot)
                            	  4760: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4761: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4762: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4763: c_shoot_if_wanted:
02:0002CFBC 2F02            	  4764:     move.l  D2,-(SP)
02:0002CFBE 202F0008        	  4765:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CFC2 242F000C        	  4766:     move.l  12(SP),D2       ; arg2 = slot
02:0002CFC6 4EB90003C2AA    	  4767:     jsr     _ShootIfWanted
02:0002CFCC 640C            	  4768:     bcc.s   .csiw_fail
02:0002CFCE 7000            	  4769:     moveq   #0,D0
02:0002CFD0 1003            	  4770:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CFD2 008000000100    	  4771:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CFD8 6002            	  4772:     bra.s   .csiw_done
                            	  4773: .csiw_fail:
02:0002CFDA 7000            	  4774:     moveq   #0,D0
                            	  4775: .csiw_done:
02:0002CFDC 241F            	  4776:     move.l  (SP)+,D2
02:0002CFDE 4E75            	  4777:     rts
