                            	  3818: ControlMoldormFlight:
02:00039BDC 41EC0444        	  3819:     lea     ($0444,A4),A0
02:00039BE0 10302000        	  3820:     move.b  (A0,D2.W),D0
02:00039BE4 4EB90002AF60    	  3821:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  3822:     even
                            	  3823: ControlMoldormFlight_JumpTable:
02:00039BEA 00039BFA        	  3824:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039BEE 00039BFA        	  3825:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039BF2 00039BFA        	  3826:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039BF6 00039C2E        	  3827:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
                            	  3828: 
                            	  3829:     even
                            	  3830: Moldorm_Chase:
                            	  3831:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3832:     ; Only the head controls the movement direction.
                            	  3833:     ;
02:00039BFA 0C020005        	  3834:     cmpi.b  #$05,D2
02:00039BFE 670A            	  3835:     beq  _anon_z04_81
02:00039C00 0C02000A        	  3836:     cmpi.b  #$0A,D2
