02:00038526 41EC0098        	   624:     lea     ($0098,A4),A0
02:0003852A 11802000        	   625:     move.b  D0,(A0,D2.W)
02:0003852E 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:00038532 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:00038536 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:0003853A 7074            	   629:     moveq   #116,D0
02:0003853C 4EB900047286    	   630:     jsr     ChangeTileObjTiles
