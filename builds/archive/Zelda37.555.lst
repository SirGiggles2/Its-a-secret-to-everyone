02:0002C02A 670A            	  2508:     beq.s   .cc_cnr
02:0002C02C 003C0001        	  2509:     ori     #$01,CCR
02:0002C030 0A3C0001        	  2510:     eori    #$01,CCR
02:0002C034 4E75            	  2511:     rts
                            	  2512: .cc_cnr:
02:0002C036 023C00FE        	  2513:     andi    #$FE,CCR
02:0002C03A 0A3C0001        	  2514:     eori    #$01,CCR
02:0002C03E 4E75            	  2515:     rts
                            	  2516: 
