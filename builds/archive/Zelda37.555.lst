                            	  4429:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CD98 4EB900000000    	  4430:     jsr     z04_animate_and_draw_common_object
02:0002CD9E 508F            	  4431:     addq.l  #8,SP           ; pop val+slot
02:0002CDA0 241F            	  4432:     move.l  (SP)+,D2        ; restore D2
