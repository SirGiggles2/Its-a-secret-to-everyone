02:0000E6A2 3A04            	  1073:     move.w  D4,D5
02:0000E6A4 E44D            	  1074:     lsr.w   #2,D5
02:0000E6A6 02450003        	  1075:     andi.w  #$0003,D5
02:0000E6AA EB4D            	  1076:     lsl.w   #5,D5
02:0000E6AC E14D            	  1077:     lsl.w   #8,D5
02:0000E6AE 5442            	  1078:     addq.w  #2,D2
02:0000E6B0 610002D8        	  1079:     bsr     _attr_write_2x2
02:0000E6B4 5542            	  1080:     subq.w  #2,D2
                            	  1081: 
                            	  1082:     ; Quadrant 2: bits [5:4], row_off=+2, col_off=0
02:0000E6B6 3A04            	  1083:     move.w  D4,D5
02:0000E6B8 E84D            	  1084:     lsr.w   #4,D5
02:0000E6BA 02450003        	  1085:     andi.w  #$0003,D5
02:0000E6BE EB4D            	  1086:     lsl.w   #5,D5
02:0000E6C0 E14D            	  1087:     lsl.w   #8,D5
02:0000E6C2 5443            	  1088:     addq.w  #2,D3
02:0000E6C4 610002C4        	  1089:     bsr     _attr_write_2x2
02:0000E6C8 5543            	  1090:     subq.w  #2,D3
                            	  1091: 
                            	  1092:     ; Quadrant 3: bits [7:6], row_off=+2, col_off=+2
02:0000E6CA 3A04            	  1093:     move.w  D4,D5
02:0000E6CC EC4D            	  1094:     lsr.w   #6,D5
02:0000E6CE 02450003        	  1095:     andi.w  #$0003,D5
02:0000E6D2 EB4D            	  1096:     lsl.w   #5,D5
02:0000E6D4 E14D            	  1097:     lsl.w   #8,D5
02:0000E6D6 5442            	  1098:     addq.w  #2,D2
02:0000E6D8 5443            	  1099:     addq.w  #2,D3
02:0000E6DA 610002AE        	  1100:     bsr     _attr_write_2x2
