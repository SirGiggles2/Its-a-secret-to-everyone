02:00048294 4E75            	  4216:     rts
                            	  4217: 
                            	  4218:     even
                            	  4219: PlayerUnwalkable:
                            	  4220:     ; Tile is not walkable. Object is player.
                            	  4221:     ;
                            	  4222:     ; Check passive tile objects and the screen edge, and stop moving.
                            	  4223:     ;
                            	  4224:     ; First, if in OW, check passive tile objects (armos and regular gravestone).
                            	  4225:     ;
