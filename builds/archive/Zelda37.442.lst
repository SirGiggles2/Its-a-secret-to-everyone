                            	  4967: _L_z07_SpreadShot_NextCorner:
                            	  4968:     ; Prepare to process the next corner.
                            	  4969:     ;
                            	  4970:     ; First, restore X offset [02] and Y offset [03].
                            	  4971:     ;
02:000487AA 101D            	  4972:     move.b  (A5)+,D0  ; PLA
02:000487AC 19400003        	  4973:     move.b  D0,($0003,A4)
02:000487B0 101D            	  4974:     move.b  (A5)+,D0  ; PLA
02:000487B2 19400002        	  4975:     move.b  D0,($0002,A4)
                            	  4976:     ; Take turns negating X offset or Y offset for the next round.
                            	  4977:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4978:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4979:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4980:     ; - Fourth turn: doesn't matter
                            	  4981:     ;
                            	  4982:     ;
                            	  4983:     ; Get the loop index.
02:000487B6 101D            	  4984:     move.b  (A5)+,D0  ; PLA
02:000487B8 1B00            	  4985:     move.b  D0,-(A5)  ; PHA
02:000487BA 7600            	  4986:     moveq   #0,D3
02:000487BC 1600            	  4987:     move.b  D0,D3
02:000487BE 0C030001        	  4988:     cmpi.b  #$01,D3
02:000487C2 6602            	  4989:     bne  _anon_z07_25
02:000487C4 7603            	  4990:     moveq   #3,D3
