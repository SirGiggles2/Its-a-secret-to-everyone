02:00048F58 0C0000EC        	  6056:     cmpi.b  #$EC,D0
02:00048F5C 6502            	  6057:     bcs.s  __far_z_07_0091
02:00048F5E 602C            	  6058:     jmp  ResetObjState
                            	  6059: __far_z_07_0091:
                            	  6060:     even
                            	  6061: _L_z07_SetUpWeaponWithState_ChooseSpeed:
                            	  6062:     ; If high bit of state is set, use $A0 else $C0 for the q-speed fraction.
                            	  6063:     ;
                            	  6064:     ; The high bit is set for magic shot, and reset for sword shot.
                            	  6065:     ;
