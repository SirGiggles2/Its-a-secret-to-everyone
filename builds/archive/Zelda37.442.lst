                            	  4345: _anon_z02_34:
02:00034D58 41F900FF6B7E    	  4346:     lea     (NES_SRAM+$0B7E).l,A0
02:00034D5E 10303000        	  4347:     move.b  (A0,D3.W),D0
02:00034D62 41EC0302        	  4348:     lea     ($0302,A4),A0
02:00034D66 11803000        	  4349:     move.b  D0,(A0,D3.W)
02:00034D6A 5303            	  4350:     subq.b  #1,D3
02:00034D6C 6AEA            	  4351:     bpl  _anon_z02_34
                            	  4352:     ; Use (timer MOD 4) as an index to look up a color.
                            	  4353:     ;
02:00034D6E 1002            	  4354:     move.b  D2,D0
