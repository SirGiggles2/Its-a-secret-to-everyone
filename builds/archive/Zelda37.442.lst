                            	  9786: TurnTowardsPlayer8:
                            	  9787:     ; Build a direction in [00] towards the player.
                            	  9788:     ;
                            	  9789:     ; First, calculate a horizontal component:
                            	  9790:     ;
                            	  9791:     ; If   observed player X = object X, [00] := 0 (none)
                            	  9792:     ; elif observed player X > object X, [00] := 1 (right)
                            	  9793:     ; else                               [00] := 2 (left)
                            	  9794:     ;
02:0003C6BC 7600            	  9795:     moveq   #0,D3
02:0003C6BE 1883            	  9796:     move.b  D3,($0000,A4)
02:0003C6C0 5203            	  9797:     addq.b  #1,D3
02:0003C6C2 102C0061        	  9798:     move.b  ($0061,A4),D0
02:0003C6C6 12342070        	  9799:     move.b  ($70,A4,D2.W),D1
02:0003C6CA B001            	  9800:     cmp.b   D1,D0
02:0003C6CC 6706            	  9801:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003C6CE 6402            	  9802:     bcc  _anon_z04_175
