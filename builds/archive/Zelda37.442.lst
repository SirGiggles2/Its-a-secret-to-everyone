02:00034F14 0C0000FF        	  4532:     cmpi.b  #$FF,D0
02:00034F18 6730            	  4533:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034F1A 19400305        	  4534:     move.b  D0,($0305,A4)
