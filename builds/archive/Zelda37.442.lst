02:00048288 1940000F        	  4211:     move.b  D0,($000F,A4)
02:0004828C 102C000E        	  4212:     move.b  ($000E,A4),D0
02:00048290 6702            	  4213:     beq.s  __far_z_07_0055
02:00048292 60C0            	  4214:     jmp  CheckTiles
