                            	   563: __far_z_04_0001:
                            	   564:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   565:     ; Get the difference in X.
                            	   566:     ;
02:000383F2 7602            	   567:     moveq   #2,D3
02:000383F4 102C0070        	   568:     move.b  ($0070,A4),D0
02:000383F8 003C0011        	   569:     ori     #$11,CCR  ; SEC: set C+X
02:000383FC 12342070        	   570:     move.b  ($70,A4,D2.W),D1
