02:0004901C 12302000        	  6172:     move.b  (A0,D2.W),D1
02:00049020 D101            	  6173:     addx.b  D1,D0   ; ADC ObjGridOffset,X
02:00049022 41EC0394        	  6174:     lea     ($0394,A4),A0
02:00049026 11802000        	  6175:     move.b  D0,(A0,D2.W)
                            	  6176:     ; If the absolute value of grid offset < $10, go draw.
                            	  6177:     ; 
