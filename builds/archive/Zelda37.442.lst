02:000486A2 0C02000D        	  4817:     cmpi.b  #$0D,D2
02:000486A6 6410            	  4818:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:000486A8 41EC034F        	  4819:     lea     ($034F,A4),A0
