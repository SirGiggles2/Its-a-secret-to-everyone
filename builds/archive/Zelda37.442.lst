                            	  4182: UpdateZeldaTextbox:
02:00034C30 4EB90004839C    	  4183:     jsr     Link_EndMoveAndDraw
                            	  4184:     ; If Zelda's timer has not expired, then return.
                            	  4185:     ;
02:00034C36 102C0029        	  4186:     move.b  ($0029,A4),D0
02:00034C3A 6704            	  4187:     beq.s  __far_z_02_0004
02:00034C3C 600000C6        	  4188:     jmp  LA9F4_Exit
                            	  4189: __far_z_02_0004:
                            	  4190:     ; Set the timer to wait 6 frames after the next character about
                            	  4191:     ; to be shown.
                            	  4192:     ;
02:00034C40 7006            	  4193:     moveq   #6,D0
02:00034C42 19400029        	  4194:     move.b  D0,($0029,A4)
                            	  4195:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4196:     ; to the dynamic transfer buf.
                            	  4197:     ;
02:00034C46 7604            	  4198:     moveq   #4,D3
                            	  4199: _anon_z02_31:
02:00034C48 41F900034C26    	  4200:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034C4E 10303000        	  4201:     move.b  (A0,D3.W),D0
02:00034C52 41EC0302        	  4202:     lea     ($0302,A4),A0
02:00034C56 11803000        	  4203:     move.b  D0,(A0,D3.W)
02:00034C5A 5303            	  4204:     subq.b  #1,D3
02:00034C5C 6AEA            	  4205:     bpl  _anon_z02_31
                            	  4206: _anon_z02_32:
                            	  4207:     ; Replace the low byte of the VRAM address with the one
                            	  4208:     ; where the next character should be written.
                            	  4209:     ;
02:00034C5E 102C045F        	  4210:     move.b  ($045F,A4),D0
02:00034C62 19400303        	  4211:     move.b  D0,($0303,A4)
                            	  4212:     ; Increment the low VRAM address for the next character.
                            	  4213:     ;
02:00034C66 522C045F        	  4214:     addq.b  #1,($045F,A4)
02:00034C6A 7000            	  4215:     moveq   #0,D0
02:00034C6C 1880            	  4216:     move.b  D0,($0000,A4)
02:00034C6E 7000            	  4217:     moveq   #0,D0
02:00034C70 19400001        	  4218:     move.b  D0,($0001,A4)
                            	  4219:     ; Load the person text current character index.
                            	  4220:     ;
02:00034C74 7600            	  4221:     moveq   #0,D3
02:00034C76 162C0416        	  4222:     move.b  ($0416,A4),D3
                            	  4223:     ; Increment the index variable to point to the next character
                            	  4224:     ; for the next time.
                            	  4225:     ;
02:00034C7A 522C0416        	  4226:     addq.b  #1,($0416,A4)
                            	  4227:     ; Get the current character.
                            	  4228:     ;
02:00034C7E 1214            	  4229:     move.b  ($00,A4),D1   ; ptr lo
02:00034C80 182C0001        	  4230:     move.b  ($01,A4),D4  ; ptr hi
02:00034C84 024100FF        	  4231:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034C88 E14C            	  4232:     lsl.w   #8,D4
02:00034C8A 8841            	  4233:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034C8C 48C4            	  4234:     ext.l   D4
02:00034C8E D8BC00FF0000    	  4235:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034C94 2044            	  4236:     movea.l D4,A0
02:00034C96 10303000        	  4237:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4238:     ; If the character is $25, then it's a special space. It will still
                            	  4239:     ; take up space, but will not take time to show -- meaning that
                            	  4240:     ; we'll go look up the next character to transfer.
                            	  4241:     ;
02:00034C9A 0200003F        	  4242:     andi.b #$3F,D0
02:00034C9E 0C000025        	  4243:     cmpi.b  #$25,D0
02:00034CA2 67BA            	  4244:     beq  _anon_z02_32
                            	  4245:     ; We have a non-space character. Put it in the transfer record.
                            	  4246:     ;
02:00034CA4 19400305        	  4247:     move.b  D0,($0305,A4)
                            	  4248:     ; Play the "heart taken/character" tune.
                            	  4249:     ;
02:00034CA8 7010            	  4250:     moveq   #16,D0
02:00034CAA 19400604        	  4251:     move.b  D0,($0604,A4)
                            	  4252:     ; If the high 2 bits of character element = 0, then return.
                            	  4253:     ;
02:00034CAE 1214            	  4254:     move.b  ($00,A4),D1   ; ptr lo
02:00034CB0 182C0001        	  4255:     move.b  ($01,A4),D4  ; ptr hi
02:00034CB4 024100FF        	  4256:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034CB8 E14C            	  4257:     lsl.w   #8,D4
02:00034CBA 8841            	  4258:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034CBC 48C4            	  4259:     ext.l   D4
02:00034CBE D8BC00FF0000    	  4260:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034CC4 2044            	  4261:     movea.l D4,A0
02:00034CC6 10303000        	  4262:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034CCA 020000C0        	  4263:     andi.b #$C0,D0
02:00034CCE 6602            	  4264:     bne.s  __far_z_02_0005
02:00034CD0 6032            	  4265:     jmp  LA9F4_Exit
                            	  4266: __far_z_02_0005:
                            	  4267:     ; Determine an index based on the high 2 bits of the character element:
                            	  4268:     ;   $80: 0
                            	  4269:     ;   $40: 1
                            	  4270:     ;   $C0: 2
                            	  4271:     ;
02:00034CD2 7602            	  4272:     moveq   #2,D3
02:00034CD4 0C0000C0        	  4273:     cmpi.b  #$C0,D0
02:00034CD8 670A            	  4274:     beq  _anon_z02_33
02:00034CDA 5303            	  4275:     subq.b  #1,D3
02:00034CDC 0C000040        	  4276:     cmpi.b  #$40,D0
02:00034CE0 6702            	  4277:     beq  _anon_z02_33
02:00034CE2 5303            	  4278:     subq.b  #1,D3
                            	  4279: _anon_z02_33:
                            	  4280:     ; The index chooses the low VRAM address of the start
                            	  4281:     ; of another line:
                            	  4282:     ;   0: $C4: front of the second line
                            	  4283:     ;   1: $E4: front of the third line
                            	  4284:     ;   2: $A4: front of the first line
                            	  4285:     ;
02:00034CE4 41F900034C2C    	  4286:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034CEA 10303000        	  4287:     move.b  (A0,D3.W),D0
02:00034CEE 1940045F        	  4288:     move.b  D0,($045F,A4)
                            	  4289:     ; If index = 2, then we've reached the end of the text,
                            	  4290:     ; and low VRAM address is moved to the front of the first line.
                            	  4291:     ; So, advance the state of the person object, and unhalt Link.
                            	  4292:     ;
02:00034CF2 0C030002        	  4293:     cmpi.b  #$02,D3
02:00034CF6 6702            	  4294:     beq.s  __far_z_02_0006
02:00034CF8 600A            	  4295:     jmp  LA9F4_Exit
                            	  4296: __far_z_02_0006:
02:00034CFA 522C00AD        	  4297:     addq.b  #1,($00AD,A4)
02:00034CFE 7000            	  4298:     moveq   #0,D0
02:00034D00 194000AC        	  4299:     move.b  D0,($00AC,A4)
