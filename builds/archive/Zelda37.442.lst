                            	  2066:     ;
02:00038E78 0C030001        	  2067:     cmpi.b  #$01,D3
02:00038E7C 6604            	  2068:     bne  _anon_z04_49
02:00038E7E 522C000F        	  2069:     addq.b  #1,($000F,A4)
                            	  2070: _anon_z04_49:
                            	  2071:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  2072:     ;
02:00038E82 7000            	  2073:     moveq   #0,D0
                            	  2074:     even
                            	  2075: _L_z04_UpdateOctorock_SaveOffset:
02:00038E84 1B00            	  2076:     move.b  D0,-(A5)  ; PHA
                            	  2077:     ; Decrement the animation counter, and roll over if needed.
                            	  2078:     ;
02:00038E86 41EC03D0        	  2079:     lea     ($03D0,A4),A0
02:00038E8A 53302000        	  2080:     subq.b  #1,(A0,D2.W)
02:00038E8E 661E            	  2081:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:00038E90 7006            	  2082:     moveq   #6,D0
02:00038E92 41EC03D0        	  2083:     lea     ($03D0,A4),A0
02:00038E96 11802000        	  2084:     move.b  D0,(A0,D2.W)
                            	  2085:     ; There are actually 6 frame images divided into 2 sets.
                            	  2086:     ; Each set depicts one animation frame. In each set there are
                            	  2087:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2088:     ;
                            	  2089:     ; The movement frame will keep track of the base offset of
                            	  2090:     ; the current set for the current animation frame: 0 or 3.
                            	  2091:     ;
                            	  2092:     ; So, XOR the movement frame with 3.
                            	  2093:     ;
02:00038E9A E208            	  2094:     lsr.b  #1,D0   ; LSR A
02:00038E9C 41EC03E4        	  2095:     lea     ($03E4,A4),A0
02:00038EA0 12302000        	  2096:     move.b  (A0,D2.W),D1
02:00038EA4 B300            	  2097:     eor.b  D1,D0
02:00038EA6 41EC03E4        	  2098:     lea     ($03E4,A4),A0
02:00038EAA 11802000        	  2099:     move.b  D0,(A0,D2.W)
                            	  2100:     even
                            	  2101: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  2102:     ; Add the base offset and the directional offset, and save the result.
                            	  2103:     ;
02:00038EAE 101D            	  2104:     move.b  (A5)+,D0  ; PLA
02:00038EB0 023C00EE        	  2105:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038EB4 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038EB8 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038EBC D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00038EBE 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
                            	  2110:     ; If facing vertically, go draw mirrored.
                            	  2111:     ;
02:00038EC0 41EC0098        	  2112:     lea     ($0098,A4),A0
02:00038EC4 10302000        	  2113:     move.b  (A0,D2.W),D0
02:00038EC8 0200000C        	  2114:     andi.b #$0C,D0
02:00038ECC 660C            	  2115:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2116:     ; Else draw not mirrored.
                            	  2117:     ;
02:00038ECE 101D            	  2118:     move.b  (A5)+,D0  ; PLA
02:00038ED0 4EB900030D7A    	  2119:     jsr     DrawObjectNotMirrored
02:00038ED6 6000820E        	  2120:     jmp     CheckMonsterCollisions
                            	  2121: 
