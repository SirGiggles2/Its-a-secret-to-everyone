02:0003BE9A 41EC00AC        	  8627:     lea     ($00AC,A4),A0
02:0003BE9E 10302000        	  8628:     move.b  (A0,D2.W),D0
02:0003BEA2 0C000030        	  8629:     cmpi.b  #$30,D0
