                            	  4918: UpdateDodongoState0_Move:
                            	  4919:     ; If facing left, then push X offset 0 on the stack.
                            	  4920:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  4921:     ;
                            	  4922:     ; We would like to use one set of coordinates only.
                            	  4923:     ; But movement would break down, if we did; because
                            	  4924:     ; Dodongo is so long.
                            	  4925:     ;
                            	  4926:     ; So, when not facing left, we temporarily shift the
                            	  4927:     ; X coordinate to be closer to the other side of the monster.
                            	  4928:     ;
02:0003A2DC 7600            	  4929:     moveq   #0,D3
02:0003A2DE 41EC0098        	  4930:     lea     ($0098,A4),A0
02:0003A2E2 10302000        	  4931:     move.b  (A0,D2.W),D0
02:0003A2E6 0200000D        	  4932:     andi.b #$0D,D0
02:0003A2EA 6716            	  4933:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A2EC 10342070        	  4934:     move.b  ($70,A4,D2.W),D0
02:0003A2F0 023C00EE        	  4935:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2F4 123C0010        	  4936:     move.b  #$10,D1
02:0003A2F8 D101            	  4937:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A2FA 19802070        	  4938:     move.b  D0,($70,A4,D2.W)
