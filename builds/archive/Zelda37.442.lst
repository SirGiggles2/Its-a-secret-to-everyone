02:00038416 6502            	   590:     bcs.s  __far_z_04_0002
02:00038418 6050            	   591:     jmp  ResetPushTimer
                            	   592: __far_z_04_0002:
                            	   593:     ; At this point, Link is aligned with the block.
                            	   594:     ;
                            	   595:     ; If the input direction is not the required direction based on
                            	   596:     ; Link's placement; then go reset the push timer and return.
                            	   597:     ;
02:0003841A 102C03F8        	   598:     move.b  ($03F8,A4),D0
02:0003841E 41F900038382    	   599:     lea     (BlockPushDirections).l,A0
02:00038424 12303000        	   600:     move.b  (A0,D3.W),D1
02:00038428 B001            	   601:     cmp.b   D1,D0
02:0003842A 6702            	   602:     beq.s  __far_z_04_0003
02:0003842C 603C            	   603:     jmp  ResetPushTimer
                            	   604: __far_z_04_0003:
                            	   605:     ; Link is truly pushing the block.
                            	   606:     ;
                            	   607:     ; Increase the push timer.
                            	   608:     ;
02:0003842E 41EC0412        	   609:     lea     ($0412,A4),A0
02:00038432 52302000        	   610:     addq.b  #1,(A0,D2.W)
                            	   611:     ; If the push timer still < $10, return.
