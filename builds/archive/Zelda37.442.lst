                            	  4051: PlayerScreenEdgeBounds:
02:000481F0 3D              	  4052:     dc.b    $3D, $DD, $00, $F0
02:000481F1 DD
02:000481F2 00
02:000481F3 F0
                            	  4053: 
                            	  4054: ; Params:
                            	  4055: ; [0E]: $FF, if blocked by a door
                            	  4056: ; [0F]: movement direction
                            	  4057: ;
                            	  4058: ; Returns:
                            	  4059: ; [0F]: untouched, or changed if blocked or need to change
                            	  4060: ;
                            	  4061: ; Summary:
                            	  4062: ;
                            	  4063: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4064: ; Then allow movement or go to the next room. Otherwise,
                            	  4065: ; check passive tile objects and stop moving.
                            	  4066: ;
                            	  4067: ; For other objects: First, if moving, test the colliding tile for
                            	  4068: ; walkability. Otherwise search for a walkable direction starting
                            	  4069: ; from input direction.
                            	  4070: ;
                            	  4071: ; When you find a walkable direction, see if it makes the object
                            	  4072: ; cross a boundary. If it doesn't, then make this direction
                            	  4073: ; the objection direction. Otherwise, keep looping.
                            	  4074: ;
                            	  4075: ; If no walkable direction is found, then stop moving.
                            	  4076: ;
                            	  4077: ;
                            	  4078: ; if is player
                            	  4079: ;   if at doorway
                            	  4080: ;     go handle a walkable direction
                            	  4081: ;   if blocked by door
                            	  4082: ;     return
                            	  4083: ;
                            	  4084:     even
                            	  4085: Walker_CheckTileCollision:
                            	  4086:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4087:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4088:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4089:     ; reset) for Link and every other object. Only the tile
                            	  4090:     ; walkability decision in CheckTiles is overridden.
02:000481F4 4A02            	  4091:     cmpi.b  #$00,D2
02:000481F6 6614            	  4092:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:000481F8 102C0053        	  4093:     move.b  ($0053,A4),D0
02:000481FC 6704            	  4094:     beq  _anon_z07_16
02:000481FE 600000BE        	  4095:     jmp     GoWalkableDir
                            	  4096: 
                            	  4097: _anon_z07_16:
02:00048202 102C000E        	  4098:     move.b  ($000E,A4),D0
02:00048206 6A04            	  4099:     bpl.s  __far_z_07_0047
02:00048208 600000AC        	  4100:     jmp  L1F148_Exit
                            	  4101: __far_z_07_0047:
                            	  4102:     even
                            	  4103: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4104:     ; If grid offset <> 0, return.
                            	  4105:     ;
02:0004820C 41EC0394        	  4106:     lea     ($0394,A4),A0
02:00048210 10302000        	  4107:     move.b  (A0,D2.W),D0
02:00048214 6704            	  4108:     beq.s  __far_z_07_0048
02:00048216 6000009E        	  4109:     jmp  L1F148_Exit
                            	  4110: __far_z_07_0048:
                            	  4111:     ; Grid offset = 0.
                            	  4112:     ; The object is at a point between cells in the grid.
                            	  4113:     ; So, we can check tiles for collision.
                            	  4114:     ;
                            	  4115:     ; Reset [0E] alternate direction search step.
                            	  4116:     ;
02:0004821A 1940000E        	  4117:     move.b  D0,($000E,A4)
                            	  4118:     ; If there's a movement direction, go check tile collision.
                            	  4119:     ;
02:0004821E 102C000F        	  4120:     move.b  ($000F,A4),D0
02:00048222 6702            	  4121:     beq.s  __far_z_07_0049
02:00048224 602E            	  4122:     jmp  CheckTiles
                            	  4123: __far_z_07_0049:
                            	  4124:     ; Moving direction = 0.
                            	  4125:     ; If object is the player, return.
                            	  4126:     ;
02:00048226 4A02            	  4127:     cmpi.b  #$00,D2
02:00048228 6604            	  4128:     bne.s  __far_z_07_0050
02:0004822A 6000008A        	  4129:     jmp  L1F148_Exit
                            	  4130: __far_z_07_0050:
                            	  4131:     ; Moving direction = 0.
                            	  4132:     ; The object is not the player.
                            	  4133:     ;
                            	  4134:     ; If object does not have attribute $10, then
                            	  4135:     ; set movement direction to input direction,
                            	  4136:     ; and go try to turn to an unblocked direction in order to move.
                            	  4137:     ;
02:0004822E 41EC04BF        	  4138:     lea     ($04BF,A4),A0
02:00048232 10302000        	  4139:     move.b  (A0,D2.W),D0
02:00048236 02000010        	  4140:     andi.b #$10,D0
02:0004823A 6702            	  4141:     beq.s  __far_z_07_0051
02:0004823C 600E            	  4142:     jmp  Reverse
                            	  4143: __far_z_07_0051:
02:0004823E 41EC03F8        	  4144:     lea     ($03F8,A4),A0
02:00048242 10302000        	  4145:     move.b  (A0,D2.W),D0
02:00048246 1940000F        	  4146:     move.b  D0,($000F,A4)
02:0004824A 6038            	  4147:     jmp     TryNextDir
                            	  4148: 
                            	  4149:     even
                            	  4150: Reverse:
                            	  4151:     ; UNKNOWN:
                            	  4152:     ; This seems to be unused code triggered by object attribute $10.
                            	  4153:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4154:     ;
02:0004824C 610000FE        	  4155:     jsr     ReverseObjDir
02:00048250 600000BA        	  4156:     jmp     CheckBoundary
                            	  4157: 
