                            	  6928: _L_z05_CheckShortcut_WriteStairs:
02:00040C76 7010            	  6929:     moveq   #16,D0
02:00040C78 1940000D        	  6930:     move.b  D0,($000D,A4)
02:00040C7C 7070            	  6931:     moveq   #112,D0
