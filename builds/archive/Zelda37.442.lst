                            	  2148: SecretArmosRoomIds:
02:00038EFC 24              	  2149:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:00038EFD 0B
02:00038EFE 1C
02:00038EFF 22
02:00038F00 34
02:00038F01 3D
02:00038F02 4E
                            	  2150: 
                            	  2151:     even
                            	  2152: SecretArmosXs:
02:00038F04 E0              	  2153:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:00038F05 B0
02:00038F06 B0
02:00038F07 30
02:00038F08 40
02:00038F09 90
02:00038F0A A0
                            	  2154: 
