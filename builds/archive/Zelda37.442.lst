02:00038762 6512            	  1056:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038764 0C000099        	  1057:     cmpi.b  #$99,D0
02:00038768 640C            	  1058:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1059:     ; Flag the zora active, and set up the object.
