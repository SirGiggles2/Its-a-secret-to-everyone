                            	  8408: UpdateGanon:
02:0003BD62 102C0445        	  8409:     move.b  ($0445,A4),D0
02:0003BD66 4EB90002AECA    	  8410:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  8411:     even
                            	  8412: UpdateGanon_JumpTable:
02:0003BD6C 0003BD78        	  8413:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BD70 0003BDDA        	  8414:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BD74 0003BE08        	  8415:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  8416: 
                            	  8417: ; Description:
                            	  8418: ; Lift up the Triforce of Courage while the room is dark.
                            	  8419: ;
                            	  8420: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8421: ;
                            	  8422:     even
                            	  8423: Ganon_ScenePhase0:
02:0003BD78 701B            	  8424:     moveq   #27,D0
02:0003BD7A 19400505        	  8425:     move.b  D0,($0505,A4)
                            	  8426:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8427:     ;
02:0003BD7E 102C0028        	  8428:     move.b  ($0028,A4),D0
02:0003BD82 6644            	  8429:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8430:     ; Once the timer expires, it's time to brighten the room.
                            	  8431:     ;
                            	  8432:     ; Save the current object slot.
02:0003BD84 1002            	  8433:     move.b  D2,D0
02:0003BD86 1B00            	  8434:     move.b  D0,-(A5)  ; PHA
02:0003BD88 610007F0        	  8435:     jsr     UpdateCandle
02:0003BD8C 101D            	  8436:     move.b  (A5)+,D0  ; PLA
02:0003BD8E 7400            	  8437:     moveq   #0,D2
02:0003BD90 1400            	  8438:     move.b  D0,D2
                            	  8439:     ; Turn off the room brightening flag, because we're controlling it
                            	  8440:     ; here instead of in the Mode 5 object update loop.
                            	  8441:     ;
02:0003BD92 7000            	  8442:     moveq   #0,D0
02:0003BD94 1940051E        	  8443:     move.b  D0,($051E,A4)
                            	  8444:     ; On the first frame of the fade-to-light cycle, play the
                            	  8445:     ; Triforce/Ganon song.
                            	  8446:     ;
02:0003BD98 102C051C        	  8447:     move.b  ($051C,A4),D0
02:0003BD9C 0C0000C0        	  8448:     cmpi.b  #$C0,D0
02:0003BDA0 6606            	  8449:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BDA2 7002            	  8450:     moveq   #2,D0
02:0003BDA4 19400600        	  8451:     move.b  D0,($0600,A4)
                            	  8452:     even
                            	  8453: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8454:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8455:     ;
02:0003BDA8 102C051C        	  8456:     move.b  ($051C,A4),D0
02:0003BDAC 0200000F        	  8457:     andi.b #$0F,D0
02:0003BDB0 0C000004        	  8458:     cmpi.b  #$04,D0
02:0003BDB4 6702            	  8459:     beq.s  __far_z_04_0091
02:0003BDB6 6042            	  8460:     jmp  Ganon_DrawBodyFrame0
                            	  8461: __far_z_04_0091:
                            	  8462:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8463:     ;
02:0003BDB8 103C00C0        	  8464:     move.b  #$C0,D0
02:0003BDBC 19400028        	  8465:     move.b  D0,($0028,A4)
                            	  8466:     ; Set scene phase 1, and go draw Ganon.
                            	  8467:     ;
02:0003BDC0 522C0445        	  8468:     addq.b  #1,($0445,A4)
02:0003BDC4 6702            	  8469:     beq.s  __far_z_04_0092
02:0003BDC6 6032            	  8470:     jmp  Ganon_DrawBodyFrame0
                            	  8471: __far_z_04_0092:
                            	  8472:     even
                            	  8473: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8474:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8475:     ; In this case, I think it means Ganon is shouting.
                            	  8476:     ;
02:0003BDC8 0C000001        	  8477:     cmpi.b  #$01,D0
02:0003BDCC 6606            	  8478:     bne  _anon_z04_160
02:0003BDCE 7002            	  8479:     moveq   #2,D0
02:0003BDD0 19400601        	  8480:     move.b  D0,($0601,A4)
                            	  8481: _anon_z04_160:
02:0003BDD4 0A3C0001        	  8482:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BDD8 4E75            	  8483:     rts
                            	  8484: 
                            	  8485: ; Description:
                            	  8486: ; Lift up the Triforce of Courage while the room is light.
                            	  8487: ;
                            	  8488: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8489: ;
                            	  8490:     even
                            	  8491: Ganon_ScenePhase1:
02:0003BDDA 701B            	  8492:     moveq   #27,D0
02:0003BDDC 19400505        	  8493:     move.b  D0,($0505,A4)
                            	  8494:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8495:     ;
02:0003BDE0 102C0028        	  8496:     move.b  ($0028,A4),D0
02:0003BDE4 6702            	  8497:     beq.s  __far_z_04_0093
02:0003BDE6 6012            	  8498:     jmp  Ganon_DrawBodyFrame0
                            	  8499: __far_z_04_0093:
                            	  8500:     ; Once the timer expires:
                            	  8501:     ; 1. unhalt Link
                            	  8502:     ; 2. clear the item to lift
                            	  8503:     ; 3. play level 9 song
                            	  8504:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8505:     ;
02:0003BDE8 194000AC        	  8506:     move.b  D0,($00AC,A4)
02:0003BDEC 19400505        	  8507:     move.b  D0,($0505,A4)
02:0003BDF0 7020            	  8508:     moveq   #32,D0
02:0003BDF2 19400600        	  8509:     move.b  D0,($0600,A4)
02:0003BDF6 522C0445        	  8510:     addq.b  #1,($0445,A4)
                            	  8511:     even
                            	  8512: Ganon_DrawBodyFrame0:
                            	  8513:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8514:     ; with animation frame 0.
                            	  8515:     ;
02:0003BDFA 7000            	  8516:     moveq   #0,D0
02:0003BDFC 41EC046B        	  8517:     lea     ($046B,A4),A0
02:0003BE00 11802000        	  8518:     move.b  D0,(A0,D2.W)
02:0003BE04 600002EC        	  8519:     jmp     Ganon_DrawBody
                            	  8520: 
                            	  8521: ; Description:
                            	  8522: ; Fighting Ganon.
                            	  8523: ;
                            	  8524: ; If Ganon is dying, go handle it.
                            	  8525: ;
                            	  8526:     even
                            	  8527: Ganon_ScenePhase2:
02:0003BE08 41EC042C        	  8528:     lea     ($042C,A4),A0
02:0003BE0C 10302000        	  8529:     move.b  (A0,D2.W),D0
02:0003BE10 6704            	  8530:     beq.s  __far_z_04_0094
02:0003BE12 600000A4        	  8531:     jmp  Ganon_Dying
                            	  8532: __far_z_04_0094:
02:0003BE16 61000356        	  8533:     jsr     Ganon_CheckCollisions
02:0003BE1A 6100C35A        	  8534:     jsr     PlayBossHitCryIfNeeded
                            	  8535:     ; Go handle the brown state specially.
                            	  8536:     ;
02:0003BE1E 41EC00AC        	  8537:     lea     ($00AC,A4),A0
02:0003BE22 10302000        	  8538:     move.b  (A0,D2.W),D0
02:0003BE26 6702            	  8539:     beq.s  __far_z_04_0095
02:0003BE28 6058            	  8540:     jmp  Ganon_UpdateBrownState
                            	  8541: __far_z_04_0095:
                            	  8542:     ; State = 0: Blue
                            	  8543:     ;
                            	  8544:     ; If timer = 0, then go move around and shoot.
                            	  8545:     ;
02:0003BE2A 10342028        	  8546:     move.b  ($28,A4,D2.W),D0
02:0003BE2E 6602            	  8547:     bne.s  __far_z_04_0096
02:0003BE30 600E            	  8548:     jmp  Ganon_MoveAndShoot
                            	  8549: __far_z_04_0096:
                            	  8550:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8551:     ; Collisions were checked already.
                            	  8552:     ;
                            	  8553:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8554:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8555:     ;
02:0003BE32 0C000001        	  8556:     cmpi.b  #$01,D0
02:0003BE36 6702            	  8557:     beq.s  __far_z_04_0097
02:0003BE38 6078            	  8558:     jmp  L_Ganon_DrawBody
                            	  8559: __far_z_04_0097:
                            	  8560: ; Description:
                            	  8561: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  8562: ;
                            	  8563:     even
                            	  8564: Ganon_RandomizeLocation:
02:0003BE3A 4EF90002BA30    	  8565:     jmp     c_ganon_randomize_location
