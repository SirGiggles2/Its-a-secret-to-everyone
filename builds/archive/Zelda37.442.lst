                            	  4596: Aquamentus_Move:
                            	  4597:     ; The monster uses grid offset to mean distance remaining.
                            	  4598:     ; If there's more distance to cover, then go move.
                            	  4599:     ;
02:0003A090 41EC0394        	  4600:     lea     ($0394,A4),A0
02:0003A094 10302000        	  4601:     move.b  (A0,D2.W),D0
02:0003A098 662C            	  4602:     bne  _L_z04_Aquamentus_Move_Move
                            	  4603:     ; Set a random distance to move of 7 or $F pixels.
                            	  4604:     ;
02:0003A09A 10342018        	  4605:     move.b  ($18,A4,D2.W),D0
02:0003A09E 1B00            	  4606:     move.b  D0,-(A5)  ; PHA
02:0003A0A0 0200000F        	  4607:     andi.b #$0F,D0
02:0003A0A4 00000007        	  4608:     ori.b #$07,D0
02:0003A0A8 41EC0394        	  4609:     lea     ($0394,A4),A0
02:0003A0AC 11802000        	  4610:     move.b  D0,(A0,D2.W)
