02:00048ADE 7040            	  5457:     moveq   #64,D0
02:00048AE0 41EC03BC        	  5458:     lea     ($03BC,A4),A0
02:00048AE4 11802000        	  5459:     move.b  D0,(A0,D2.W)
                            	  5460:     ; If facing left and X < 2, then go change state to $40. The
                            	  5461:     ; boomerang is too close to the left edge of the screen.
                            	  5462:     ; Another move might make it wrap around.
                            	  5463:     ;
02:00048AE8 41EC0098        	  5464:     lea     ($0098,A4),A0
