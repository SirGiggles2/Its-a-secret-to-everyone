                            	  5198: LayOutDoors:
                            	  5199:     ; Copies the right door face for the direction, type, and state
                            	  5200:     ; of the door to the play area tile map.
                            	  5201:     ;
                            	  5202:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5203:     ; that are not true doors.
                            	  5204:     ;
02:0003FE10 7403            	  5205:     moveq   #3,D2
                            	  5206:     even
                            	  5207: L_LayOutDoors_LoopDoors:
                            	  5208:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5209:     ;
02:0003FE12 7001            	  5210:     moveq   #1,D0
                            	  5211:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5212:     ;
                            	  5213:     ; [06] indicates whether we're handling the first half of
                            	  5214:     ; the door: Left half for N/S, Top half for E/W.
                            	  5215:     ;
02:0003FE14 19400006        	  5216:     move.b  D0,($0006,A4)
                            	  5217:     even
                            	  5218: L_LayOutDoors_LoopHalves:
02:0003FE18 1002            	  5219:     move.b  D2,D0
02:0003FE1A 1B00            	  5220:     move.b  D0,-(A5)  ; PHA
02:0003FE1C 1940000B        	  5221:     move.b  D0,($000B,A4)
02:0003FE20 41F90003FDEC    	  5222:     lea     (DoorBits).l,A0
02:0003FE26 10302000        	  5223:     move.b  (A0,D2.W),D0
02:0003FE2A 19400002        	  5224:     move.b  D0,($0002,A4)
02:0003FE2E 6100FD4A        	  5225:     jsr     FindDoorAttrByDoorBit
                            	  5226:     ; Begin looking for the door face for the door attribute.
                            	  5227:     ; In general, use the door type as the provisional face;
                            	  5228:     ; except turn 4 into 8.
                            	  5229:     ;
02:0003FE32 0C000005        	  5230:     cmpi.b  #$05,D0
02:0003FE36 642A            	  5231:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0003FE38 0C000004        	  5232:     cmpi.b  #$04,D0
02:0003FE3C 6608            	  5233:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0003FE3E 7008            	  5234:     moveq   #8,D0
02:0003FE40 6620            	  5235:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5236:     even
                            	  5237: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5238:     ; We jump here if the door type is bombable and was opened.
                            	  5239:     ; Change the provisional door face to value 9, which
                            	  5240:     ; will become the "hole in the wall".
                            	  5241:     ;
02:0003FE42 7009            	  5242:     moveq   #9,D0
02:0003FE44 665A            	  5243:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5244:     even
                            	  5245: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5246:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5247:     ; the mask of opened doors, because this is not a true door.
                            	  5248:     ;
02:0003FE46 1B00            	  5249:     move.b  D0,-(A5)  ; PHA
02:0003FE48 102C0002        	  5250:     move.b  ($0002,A4),D0
02:0003FE4C 4600            	  5251:     eori.b #$FF,D0
02:0003FE4E 122C00EE        	  5252:     move.b  ($00EE,A4),D1
02:0003FE52 C001            	  5253:     and.b  D1,D0
02:0003FE54 194000EE        	  5254:     move.b  D0,($00EE,A4)
02:0003FE58 101D            	  5255:     move.b  (A5)+,D0  ; PLA
                            	  5256:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5257:     ;
02:0003FE5A 0C000001        	  5258:     cmpi.b  #$01,D0
02:0003FE5E 6402            	  5259:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0003FE60 7004            	  5260:     moveq   #4,D0
                            	  5261:     even
                            	  5262: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5263:     ; The door attribute (DA) has been mapped to a
                            	  5264:     ; provisional door face value (PF) in %A as follows:
                            	  5265:     ;
                            	  5266:     ; DA PF Meaning
                            	  5267:     ; -------------
                            	  5268:     ; 0  4  open
                            	  5269:     ; 1  1  wall
                            	  5270:     ; 2  2  false wall
                            	  5271:     ; 3  3  false wall 2
                            	  5272:     ; 4  8  bombable
                            	  5273:     ; 5  5  key
                            	  5274:     ; 6  6  key 2
                            	  5275:     ; 7  7  shutter
                            	  5276:     ;
                            	  5277:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5278:     ; has been cleared, if the type was "open" or any wall.
                            	  5279:     ;
                            	  5280:     ;
                            	  5281:     ; Save the provisional face.
02:0003FE62 1B00            	  5282:     move.b  D0,-(A5)  ; PHA
                            	  5283:     ; If the current direction points to a door that has been opened,
                            	  5284:     ; then see if we need to set door flags.
                            	  5285:     ;
02:0003FE64 102C00EE        	  5286:     move.b  ($00EE,A4),D0
02:0003FE68 122C0002        	  5287:     move.b  ($0002,A4),D1
02:0003FE6C C001            	  5288:     and.b  D1,D0
02:0003FE6E 7400            	  5289:     moveq   #0,D2
02:0003FE70 1400            	  5290:     move.b  D0,D2
02:0003FE72 101D            	  5291:     move.b  (A5)+,D0  ; PLA
02:0003FE74 122C0002        	  5292:     move.b  ($0002,A4),D1
02:0003FE78 B401            	  5293:     cmp.b   D1,D2
02:0003FE7A 6624            	  5294:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5295:     ; The current direction points to a door that has been opened.
                            	  5296:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5297:     ;
                            	  5298:     ;
                            	  5299:     ; Save provisional door face in Y register.
02:0003FE7C 7600            	  5300:     moveq   #0,D3
02:0003FE7E 1600            	  5301:     move.b  D0,D3
02:0003FE80 101D            	  5302:     move.b  (A5)+,D0  ; PLA
02:0003FE82 1B00            	  5303:     move.b  D0,-(A5)  ; PHA
02:0003FE84 7400            	  5304:     moveq   #0,D2
02:0003FE86 1400            	  5305:     move.b  D0,D2
02:0003FE88 1003            	  5306:     move.b  D3,D0
                            	  5307:     ; If provisional door face is not for a shutter, then
                            	  5308:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5309:     ;
                            	  5310:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5311:     ;
02:0003FE8A 0C000007        	  5312:     cmpi.b  #$07,D0
02:0003FE8E 670E            	  5313:     beq  _anon_z05_111
02:0003FE90 1B00            	  5314:     move.b  D0,-(A5)  ; PHA
02:0003FE92 6100DF6C        	  5315:     jsr     SetDoorFlag
02:0003FE96 101D            	  5316:     move.b  (A5)+,D0  ; PLA
                            	  5317:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5318:     ; then go make it 9 (open "bombable").
                            	  5319:     ; Else make it 4 (open "door").
                            	  5320:     ;
02:0003FE98 0C000008        	  5321:     cmpi.b  #$08,D0
02:0003FE9C 67A4            	  5322:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5323: _anon_z05_111:
02:0003FE9E 7004            	  5324:     moveq   #4,D0
                            	  5325:     even
                            	  5326: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5327:     ; For opened doors, the provisional door face has become:
                            	  5328:     ;
                            	  5329:     ; DA PF Meaning
                            	  5330:     ; -------------
                            	  5331:     ; 0  4  open
                            	  5332:     ; 1  1  wall
                            	  5333:     ; 2  2  false wall
                            	  5334:     ; 3  3  false wall 2
                            	  5335:     ; 4  9  bombable
                            	  5336:     ; 5  4  key
                            	  5337:     ; 6  4  key 2
                            	  5338:     ; 7  4  shutter
                            	  5339:     ;
                            	  5340:     ;
                            	  5341:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5342:     ;
02:0003FEA0 7400            	  5343:     moveq   #0,D2
02:0003FEA2 142C0006        	  5344:     move.b  ($0006,A4),D2
02:0003FEA6 6712            	  5345:     beq  _anon_z05_112
02:0003FEA8 7400            	  5346:     moveq   #0,D2
02:0003FEAA 142C000B        	  5347:     move.b  ($000B,A4),D2
02:0003FEAE 1B00            	  5348:     move.b  D0,-(A5)  ; PHA
02:0003FEB0 6100FCC8        	  5349:     jsr     FindDoorAttrByDoorBit
02:0003FEB4 61001C34        	  5350:     jsr     CalcOpenDoorwayMask
02:0003FEB8 101D            	  5351:     move.b  (A5)+,D0  ; PLA
                            	  5352: _anon_z05_112:
                            	  5353:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5354:     ; because the visible door face is already a wall.
                            	  5355:     ;
02:0003FEBA 0C000004        	  5356:     cmpi.b  #$04,D0
02:0003FEBE 650000DC        	  5357:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5358:     ; For all other provisional face values, calculate:
                            	  5359:     ; door face := provisional face - 3
02:0003FEC2 003C0011        	  5360:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEC6 123C0003        	  5361:     move.b  #$03,D1
02:0003FECA 0A3C0010        	  5362:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FECE 9101            	  5363:     subx.b  D1,D0   ; SBC #$03
02:0003FED0 0A3C0010        	  5364:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FED4 7600            	  5365:     moveq   #0,D3
02:0003FED6 1600            	  5366:     move.b  D0,D3
                            	  5367:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5368:     ; subtract one.
                            	  5369:     ;
02:0003FED8 0C030003        	  5370:     cmpi.b  #$03,D3
02:0003FEDC 6502            	  5371:     bcs  _anon_z05_113
02:0003FEDE 5303            	  5372:     subq.b  #1,D3
                            	  5373: _anon_z05_113:
                            	  5374:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5375:     ;
                            	  5376:     ; DT DFC DFO Meaning
                            	  5377:     ; ------------------
                            	  5378:     ; 0  1   1   open
                            	  5379:     ; 4  4   5   bombable
                            	  5380:     ; 5  2   1   key
                            	  5381:     ; 6  2   1   key 2
                            	  5382:     ; 7  3   1   shutter
                            	  5383:     ;
                            	  5384:     ;
                            	  5385:     ; Get the direction index.
02:0003FEE0 101D            	  5386:     move.b  (A5)+,D0  ; PLA
02:0003FEE2 1B00            	  5387:     move.b  D0,-(A5)  ; PHA
02:0003FEE4 610000D0        	  5388:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5389:     ; If handling the second half, then offset to the second half
                            	  5390:     ; of the tiles.
                            	  5391:     ;
02:0003FEE8 102C0006        	  5392:     move.b  ($0006,A4),D0
02:0003FEEC 6618            	  5393:     bne  _anon_z05_114
02:0003FEEE 41F90003FE04    	  5394:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:0003FEF4 10302000        	  5395:     move.b  (A0,D2.W),D0
02:0003FEF8 4EB900030A2E    	  5396:     jsr     AddToInt16At0
02:0003FEFE 7006            	  5397:     moveq   #6,D0
02:0003FF00 4EB900030A36    	  5398:     jsr     AddToInt16At2
                            	  5399: _anon_z05_114:
                            	  5400:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5401:     ; Pointers will be incremented instead of Y.
02:0003FF06 7600            	  5402:     moveq   #0,D3
02:0003FF08 41F90003FE08    	  5403:     lea     (DirIndexToDoorColumnCount).l,A0
02:0003FF0E 10302000        	  5404:     move.b  (A0,D2.W),D0
02:0003FF12 19400005        	  5405:     move.b  D0,($0005,A4)
                            	  5406:     even
                            	  5407: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5408:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5409:     ;
