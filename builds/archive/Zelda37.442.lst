                            	  5502: _L_z07_CheckState30_CheckOtherStates:
                            	  5503:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5504:     ;
                            	  5505:     ; The boomerang will now return. Reset the grid offset.
                            	  5506:     ;
02:00048B2A 7000            	  5507:     moveq   #0,D0
02:00048B2C 41EC0394        	  5508:     lea     ($0394,A4),A0
02:00048B30 11802000        	  5509:     move.b  D0,(A0,D2.W)
                            	  5510:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5511:     ;
02:00048B34 0C02000D        	  5512:     cmpi.b  #$0D,D2
02:00048B38 6408            	  5513:     bcc  _anon_z07_30
02:00048B3A 41EC042C        	  5514:     lea     ($042C,A4),A0
02:00048B3E 10302000        	  5515:     move.b  (A0,D2.W),D0
                            	  5516: _anon_z07_30:
02:00048B42 4EB9000309BA    	  5517:     jsr     GetDirectionsAndDistancesToTarget
                            	  5518:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5519:     ; then go move towards the thrower, draw, and check collisions.
                            	  5520:     ;
02:00048B48 1014            	  5521:     move.b  ($0000,A4),D0
02:00048B4A 0C000002        	  5522:     cmpi.b  #$02,D0
02:00048B4E 666A            	  5523:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5524:     ; The boomerang has reached the thrower.
                            	  5525:     ;
                            	  5526:     ; Reset the distance to move.
                            	  5527:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5528:     ;
02:00048B50 7000            	  5529:     moveq   #0,D0
02:00048B52 41EC0380        	  5530:     lea     ($0380,A4),A0
02:00048B56 11802000        	  5531:     move.b  D0,(A0,D2.W)
02:00048B5A 0C02000D        	  5532:     cmpi.b  #$0D,D2
02:00048B5E 6524            	  5533:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5534:     ; Link has caught the boomerang.
                            	  5535:     ;
                            	  5536:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5537:     ;
                            	  5538:     ; If Link catches it some time after throwing it,
                            	  5539:     ; his state will become $20, and he will show the catch animation.
                            	  5540:     ;
                            	  5541:     ; But if he catches it right after throwing it, the state becomes
                            	  5542:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5543:     ;
02:00048B60 102C00AC        	  5544:     move.b  ($00AC,A4),D0
02:00048B64 00000020        	  5545:     ori.b #$20,D0
02:00048B68 194000AC        	  5546:     move.b  D0,($00AC,A4)
                            	  5547:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5548:     ; up the new state.
                            	  5549:     ;
02:00048B6C 7001            	  5550:     moveq   #1,D0
02:00048B6E 194003D0        	  5551:     move.b  D0,($03D0,A4)
                            	  5552:     ; Deactivate the boomerang.
                            	  5553:     ;
02:00048B72 760F            	  5554:     moveq   #15,D3
02:00048B74 7000            	  5555:     moveq   #0,D0
