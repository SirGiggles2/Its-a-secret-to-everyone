                            	  6932:     ; Draw the right legs.
                            	  6933:     ;
02:0003B218 7601            	  6934:     moveq   #1,D3
02:0003B21A 6102            	  6935:     jsr     Gohma_DrawLegsOneSide
                            	  6936:     ; Draw the left legs.
                            	  6937:     ;
02:0003B21C 7600            	  6938:     moveq   #0,D3
                            	  6939: ; Params:
                            	  6940: ; Y: side: 0 for left, 1 for right
                            	  6941: ;
                            	  6942: ; Add the horizontal offset for the current side to Gohma's X to
                            	  6943: ; store the sprite's X in [00].
                            	  6944: ;
                            	  6945:     even
                            	  6946: Gohma_DrawLegsOneSide:
02:0003B21E 10342070        	  6947:     move.b  ($70,A4,D2.W),D0
02:0003B222 023C00EE        	  6948:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B226 41F90003B1FC    	  6949:     lea     (GohmaLegOffsetsX).l,A0
02:0003B22C 12303000        	  6950:     move.b  (A0,D3.W),D1
02:0003B230 D101            	  6951:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B232 1880            	  6952:     move.b  D0,($0000,A4)
                            	  6953:     ; The object's Y is the sprite's.
                            	  6954:     ;
02:0003B234 41EC0084        	  6955:     lea     ($0084,A4),A0
02:0003B238 10302000        	  6956:     move.b  (A0,D2.W),D0
02:0003B23C 19400001        	  6957:     move.b  D0,($0001,A4)
02:0003B240 612A            	  6958:     jsr     Gohma_SetSpriteAttributes
                            	  6959:     ; There are only two frame images for legs: left and right.
                            	  6960:     ; There are two animation frames. They are animated as follows:
                            	  6961:     ;
                            	  6962:     ; Frame 0:
                            	  6963:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6964:     ; horizontal flipping = frame number = 0
                            	  6965:     ; 
                            	  6966:     ; Frame 1:
                            	  6967:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6968:     ; horizontal flipping = frame number = 1
                            	  6969:     ;
02:0003B242 4EB9000493AE    	  6970:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B248 1003            	  6971:     move.b  D3,D0
02:0003B24A 023C00EE        	  6972:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B24E 41EC03E4        	  6973:     lea     ($03E4,A4),A0
02:0003B252 12302000        	  6974:     move.b  (A0,D2.W),D1
02:0003B256 D101            	  6975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B258 02000001        	  6976:     andi.b #$01,D0
02:0003B25C 023C00EE        	  6977:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B260 123C0004        	  6978:     move.b  #$04,D1
02:0003B264 D101            	  6979:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B266 4EF900030D7A    	  6980:     jmp     DrawObjectNotMirrored
                            	  6981: 
                            	  6982: ; Returns:
                            	  6983: ; [04]: left side sprite attributes
                            	  6984: ; [05]: right side sprite attributes
