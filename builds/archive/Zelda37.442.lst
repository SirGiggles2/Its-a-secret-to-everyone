                            	  4318: ; searching for an unblocked direction.
                            	  4319: ;
                            	  4320: ; Params:
                            	  4321: ; [0E]: the current step
                            	  4322: ;
                            	  4323: ; Returns:
                            	  4324: ; A: a direction for the current step, or 0 at the end of the loop
                            	  4325: ; [0E]: the next step, or 0 to end the loop
