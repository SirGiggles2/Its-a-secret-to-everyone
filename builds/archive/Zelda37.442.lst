02:00039E2A 6608            	  4305:     bne  _anon_z04_85
02:00039E2C 41EC042C        	  4306:     lea     ($042C,A4),A0
02:00039E30 52302000        	  4307:     addq.b  #1,(A0,D2.W)
                            	  4308: _anon_z04_85:
