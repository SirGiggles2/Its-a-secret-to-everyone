02:0003A278 7600            	  4877:     moveq   #0,D3
02:0003A27A 162C0341        	  4878:     move.b  ($0341,A4),D3
02:0003A27E 41F900030D42    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A284 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A288 7600            	  4881:     moveq   #0,D3
02:0003A28A 1600            	  4882:     move.b  D0,D3
02:0003A28C 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A28E 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A292 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A296 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A298 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A29C 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A2A0 102C0001        	  4889:     move.b  ($0001,A4),D0
02:0003A2A4 4EF9000310C0    	  4890:     jmp     Anim_EndWriteSprite
