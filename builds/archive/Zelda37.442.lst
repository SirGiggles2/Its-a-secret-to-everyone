                            	  2496: ;==============================================================================
                            	  2497: ; EXPORT side — carry-returning shims.
                            	  2498: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2499: ; reproduces the original function's carry normalization.
                            	  2500: ;==============================================================================
                            	  2501: 
                            	  2502: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2503: c_copy_next_row_to_transfer_buf:
02:0002BF8A 4EB900000000    	  2504:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF90 08000008        	  2505:     btst    #8,D0
02:0002BF94 670A            	  2506:     beq.s   .cc_cnr
02:0002BF96 003C0001        	  2507:     ori     #$01,CCR
02:0002BF9A 0A3C0001        	  2508:     eori    #$01,CCR
02:0002BF9E 4E75            	  2509:     rts
                            	  2510: .cc_cnr:
02:0002BFA0 023C00FE        	  2511:     andi    #$FE,CCR
02:0002BFA4 0A3C0001        	  2512:     eori    #$01,CCR
02:0002BFA8 4E75            	  2513:     rts
                            	  2514: 
                            	  2515: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
