                            	  1307: AnimateDemoPhase0Subphase1:
02:00032E3C 102C0438        	  1308:     move.b  ($0438,A4),D0
02:00032E40 666C            	  1309:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1310:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1311:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1312:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032E42 7000            	  1313:     moveq   #0,D0
02:00032E44 102C0437        	  1314:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032E48 EB48            	  1315:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032E4A 41F900032C2C    	  1316:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032E50 D0C0            	  1317:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1318:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032E52 197C003F0302    	  1319:     move.b  #$3F,($0302,A4)
02:00032E58 197C00000303    	  1320:     move.b  #$00,($0303,A4)
02:00032E5E 7020            	  1321:     moveq   #32,D0
02:00032E60 19400304        	  1322:     move.b  D0,($0304,A4)
                            	  1323:     ; End marker at DynTileBuf+4+31
02:00032E64 761F            	  1324:     moveq   #31,D3
02:00032E66 103C00FF        	  1325:     move.b  #$FF,D0
02:00032E6A 43EC0306        	  1326:     lea     ($0306,A4),A1
02:00032E6E 13803000        	  1327:     move.b  D0,(A1,D3.W)
                            	  1328:     even
                            	  1329: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00032E72 10303000        	  1330:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00032E76 43EC0305        	  1331:     lea     ($0305,A4),A1
02:00032E7A 13803000        	  1332:     move.b  D0,(A1,D3.W)
02:00032E7E 5303            	  1333:     subq.b  #1,D3
02:00032E80 6AF0            	  1334:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1335:     ; Advance the subphase cycle.
                            	  1336:     ;
02:00032E82 522C0437        	  1337:     addq.b  #1,($0437,A4)
                            	  1338:     ; Set the timer to the delay for the current point in the cycle.
                            	  1339:     ;
02:00032E86 7600            	  1340:     moveq   #0,D3
02:00032E88 162C0437        	  1341:     move.b  ($0437,A4),D3
02:00032E8C 41F900032E2B    	  1342:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00032E92 10303000        	  1343:     move.b  (A0,D3.W),D0
02:00032E96 19400438        	  1344:     move.b  D0,($0438,A4)
02:00032E9A 0C03000E        	  1345:     cmpi.b  #$0E,D3
02:00032E9E 650E            	  1346:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1347:     ; Advance to the next demo phase.
                            	  1348:     ;
02:00032EA0 522C042C        	  1349:     addq.b  #1,($042C,A4)
02:00032EA4 7000            	  1350:     moveq   #0,D0
02:00032EA6 1940042D        	  1351:     move.b  D0,($042D,A4)
02:00032EAA 19400011        	  1352:     move.b  D0,($0011,A4)
                            	  1353:     even
