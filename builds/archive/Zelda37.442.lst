                            	  4413: ; AnimateAndDrawCommonObject(val, slot) — ASM: D0=val, D2=slot
                            	  4414: c_animate_and_draw_common_object:
02:0002CCF4 2F02            	  4415:     move.l  D2,-(SP)        ; save D2
02:0002CCF6 2F02            	  4416:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCF8 2F00            	  4417:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4418:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4419:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4420:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4421:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CCFA 4EB900000000    	  4422:     jsr     z04_animate_and_draw_common_object
02:0002CD00 508F            	  4423:     addq.l  #8,SP           ; pop val+slot
02:0002CD02 241F            	  4424:     move.l  (SP)+,D2        ; restore D2
02:0002CD04 4E75            	  4425:     rts
