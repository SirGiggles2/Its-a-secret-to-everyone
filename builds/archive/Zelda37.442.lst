02:0003CB42 102C0258        	   282:     move.b  ($0258,A4),D0
02:0003CB46 1B00            	   283:     move.b  D0,-(A5)  ; PHA
02:0003CB48 4EB900047106    	   284:     jsr     HideAllSprites
