                            	  2245: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:0003378E 102C0070        	  2246:     move.b  ($0070,A4),D0
02:00033792 023C00EE        	  2247:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033796 123C0008        	  2248:     move.b  #$08,D1
02:0003379A D101            	  2249:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003379C 19400070        	  2250:     move.b  D0,($0070,A4)
02:000337A0 522C0421        	  2251:     addq.b  #1,($0421,A4)
02:000337A4 522C0423        	  2252:     addq.b  #1,($0423,A4)
                            	  2253:     ; If VRAM address still points inside the name field,
                            	  2254:     ; then go finish.
                            	  2255:     ;
                            	  2256:     ; The idea is that each name field in nametable begins at
                            	  2257:     ; an address ending in $E. For example, slot 0 has a name
                            	  2258:     ; at VRAM addresses $20CE to $20D5.
                            	  2259:     ;
                            	  2260:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2261:     ; the name field.
                            	  2262:     ;
                            	  2263:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2264:     ; record header.
                            	  2265:     ;
02:000337A8 102C0070        	  2266:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:000337AC 0C0000B0        	  2267:     cmpi.b  #$B0,D0
02:000337B0 6678            	  2268:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2269:     ; The VRAM address now points outside the name field.
                            	  2270:     ; So, wrap around to the beginning of the name field.
                            	  2271:     ;
                            	  2272:     ; For example, $20D6 -> $20CE.
                            	  2273:     ;
02:000337B2 102C0423        	  2274:     move.b  ($0423,A4),D0
02:000337B6 003C0011        	  2275:     ori     #$11,CCR  ; SEC: set C+X
02:000337BA 123C0008        	  2276:     move.b  #$08,D1
02:000337BE 0A3C0010        	  2277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000337C2 9101            	  2278:     subx.b  D1,D0   ; SBC #$08
02:000337C4 0A3C0010        	  2279:     eori    #$10,CCR  ; restore X = 6502 C
02:000337C8 19400423        	  2280:     move.b  D0,($0423,A4)
                            	  2281:     ; It also means that we went past the end of the save slot
                            	  2282:     ; info name. Set the offset to the beginning of the name.
02:000337CC 7600            	  2283:     moveq   #0,D3
02:000337CE 162C0016        	  2284:     move.b  ($0016,A4),D3
02:000337D2 41F900033114    	  2285:     lea     (SlotToNameOffset).l,A0
02:000337D8 10303000        	  2286:     move.b  (A0,D3.W),D0
02:000337DC 19400421        	  2287:     move.b  D0,($0421,A4)
                            	  2288:     ; If the name cursor has gone past the end of the field,
                            	  2289:     ; then wrap around.
02:000337E0 102C0070        	  2290:     move.b  ($0070,A4),D0
02:000337E4 0C0000B0        	  2291:     cmpi.b  #$B0,D0
02:000337E8 6640            	  2292:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:000337EA 7070            	  2293:     moveq   #112,D0
02:000337EC 19400070        	  2294:     move.b  D0,($0070,A4)
                            	  2295:     even
                            	  2296: ; PATCH P25b: FS2-E backspace handler.
                            	  2297: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2298: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2299: ; one column (8 px), and writes a space ($24) to the erased
                            	  2300: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2301: ; cannot cross into a previous slot's name field.
                            	  2302: _L_z02_ModeE_HandleAOrB_Backspace:
02:000337F0 7600            	  2303:     moveq   #0,D3
02:000337F2 162C0016        	  2304:     move.b  ($0016,A4),D3        ; D3 = current slot
02:000337F6 41F900033114    	  2305:     lea     (SlotToNameOffset).l,A0
02:000337FC 12303000        	  2306:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00033800 102C0421        	  2307:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00033804 B001            	  2308:     cmp.b   D1,D0
02:00033806 6322            	  2309:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033808 5300            	  2310:     subq.b  #1,D0
02:0003380A 19400421        	  2311:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:0003380E 532C0423        	  2312:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00033812 122C0070        	  2313:     move.b  ($0070,A4),D1
02:00033816 5101            	  2314:     subi.b  #8,D1
02:00033818 19410070        	  2315:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:0003381C 7224            	  2316:     moveq   #$24,D1              ; space tile
02:0003381E 7600            	  2317:     moveq   #0,D3
02:00033820 1600            	  2318:     move.b  D0,D3                ; D3 = erased offset
02:00033822 41EC0638        	  2319:     lea     ($0638,A4),A0
02:00033826 11813000        	  2320:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2321:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2322:     even
