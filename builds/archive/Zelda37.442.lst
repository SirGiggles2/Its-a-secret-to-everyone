02:0003E9A0 B001            	  3878:     cmp.b   D1,D0
02:0003E9A2 6510            	  3879:     bcs  _anon_z05_95
02:0003E9A4 41F90003E966    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E9AA 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E9AE B001            	  3882:     cmp.b   D1,D0
02:0003E9B0 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
