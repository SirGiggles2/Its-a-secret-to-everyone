                            	  7569: __far_z_04_0079:
                            	  7570:     ; The animation timer has expired. There are two choices for arming it.
                            	  7571:     ;
                            	  7572:     ; When writhing after a hit, Gleeok animates faster.
                            	  7573:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  7574:     ; Otherwise, set a longer time ($10).
                            	  7575:     ;
