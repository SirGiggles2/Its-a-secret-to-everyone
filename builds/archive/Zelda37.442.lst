02:0003C6EE E308            	  9828:     lsl.b  #1,D0   ; ASL A
02:0003C6F0 1214            	  9829:     move.b  ($0000,A4),D1
02:0003C6F2 8001            	  9830:     or.b  D1,D0
02:0003C6F4 1880            	  9831:     move.b  D0,($0000,A4)
                            	  9832:     even
