02:00039A9A 0C020006        	  3767:     cmpi.b  #$06,D2
02:00039A9E 6502            	  3768:     bcs  _anon_z04_80
02:00039AA0 7604            	  3769:     moveq   #4,D3
                            	  3770: _anon_z04_80:
02:00039AA2 5203            	  3771:     addq.b  #1,D3
02:00039AA4 41EC0350        	  3772:     lea     ($0350,A4),A0
02:00039AA8 10303000        	  3773:     move.b  (A0,D3.W),D0
02:00039AAC 0C000041        	  3774:     cmpi.b  #$41,D0
02:00039AB0 66F0            	  3775:     bne  _anon_z04_80
                            	  3776:     ; I don't know why the object timer of the tail segment that will
                            	  3777:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3778:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3779:     ; there, the object timer is set to 6.
                            	  3780:     ;
02:00039AB2 7011            	  3781:     moveq   #17,D0
02:00039AB4 19803029        	  3782:     move.b  D0,($29,A4,D3.W)
                            	  3783:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3784:     ; segment to the tail segment.
                            	  3785:     ;
02:00039AB8 41EC04F0        	  3786:     lea     ($04F0,A4),A0
02:00039ABC 10302000        	  3787:     move.b  (A0,D2.W),D0
02:00039AC0 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:00039AC4 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:00039AC8 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
02:00039ACC 19803071        	  3791:     move.b  D0,($71,A4,D3.W)
02:00039AD0 41EC0084        	  3792:     lea     ($0084,A4),A0
02:00039AD4 10302000        	  3793:     move.b  (A0,D2.W),D0
02:00039AD8 41EC0085        	  3794:     lea     ($0085,A4),A0
02:00039ADC 11803000        	  3795:     move.b  D0,(A0,D3.W)
                            	  3796:     ; If the tail segment found is also a head, then
