02:00038720 10343018        	  1028:     move.b  ($18,A4,D3.W),D0
02:00038724 020000F0        	  1029:     andi.b #$F0,D0
02:00038728 19802070        	  1030:     move.b  D0,($70,A4,D2.W)
02:0003872C 6748            	  1031:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003872E 0C0000F0        	  1032:     cmpi.b  #$F0,D0
02:00038732 6742            	  1033:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1034:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1035:     ; If it < $50 or >= $E0, go loop again.
                            	  1036:     ;
02:00038734 10343018        	  1037:     move.b  ($18,A4,D3.W),D0
02:00038738 E308            	  1038:     lsl.b  #1,D0   ; ASL A
02:0003873A E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:0003873C E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:0003873E E308            	  1041:     lsl.b  #1,D0   ; ASL A
02:00038740 0C000050        	  1042:     cmpi.b  #$50,D0
02:00038744 6530            	  1043:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038746 0C0000E0        	  1044:     cmpi.b  #$E0,D0
02:0003874A 642A            	  1045:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1046:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1047:     ;
02:0003874C 0000000D        	  1048:     ori.b #$0D,D0
02:00038750 41EC0084        	  1049:     lea     ($0084,A4),A0
02:00038754 11802000        	  1050:     move.b  D0,(A0,D2.W)
                            	  1051:     ; Get the tile at that location.
