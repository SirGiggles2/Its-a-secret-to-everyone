02:0003BF9A 41EC009A        	  8758:     lea     ($009A,A4),A0
02:0003BF9E 11803000        	  8759:     move.b  D0,(A0,D3.W)
02:0003BFA2 5303            	  8760:     subq.b  #1,D3
02:0003BFA4 6AC2            	  8761:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003BFA6 4E75            	  8762:     rts
