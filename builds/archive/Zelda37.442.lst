                            	  5873: _L_z07_UpdateSwordOrRod_Add4:
                            	  5874:     ; Set [00] to (state - 1) * 4:
                            	  5875:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5876:     ;
02:00048DEE 023C00EE        	  5877:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048DF2 123C0004        	  5878:     move.b  #$04,D1
02:00048DF6 D101            	  5879:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048DF8 5303            	  5880:     subq.b  #1,D3
02:00048DFA 66F2            	  5881:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048DFC 1880            	  5882:     move.b  D0,($0000,A4)
                            	  5883:     ; Set object's direction to player's. It might have changed
                            	  5884:     ; since the last frame.
                            	  5885:     ;
02:00048DFE 102C0098        	  5886:     move.b  ($0098,A4),D0
02:00048E02 41EC0098        	  5887:     lea     ($0098,A4),A0
02:00048E06 11802000        	  5888:     move.b  D0,(A0,D2.W)
                            	  5889:     ; Add [00] and the reverse index of the direction to get
                            	  5890:     ; the byte offset of the pixel offset.
                            	  5891:     ;
02:00048E0A 4EB9000309AA    	  5892:     jsr     GetOppositeDir
02:00048E10 1003            	  5893:     move.b  D3,D0
02:00048E12 023C00EE        	  5894:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E16 1214            	  5895:     move.b  ($0000,A4),D1
02:00048E18 D101            	  5896:     addx.b  D1,D0   ; ADC $00
02:00048E1A 7600            	  5897:     moveq   #0,D3
02:00048E1C 1600            	  5898:     move.b  D0,D3
                            	  5899:     ; Set object's X to player's X + offset for state and direction.
                            	  5900:     ; Copy the result to [00].
                            	  5901:     ;
02:00048E1E 102C0070        	  5902:     move.b  ($0070,A4),D0
02:00048E22 023C00EE        	  5903:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E26 41F900048D52    	  5904:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048E2C 12303000        	  5905:     move.b  (A0,D3.W),D1
02:00048E30 D101            	  5906:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048E32 19802070        	  5907:     move.b  D0,($70,A4,D2.W)
02:00048E36 1880            	  5908:     move.b  D0,($0000,A4)
                            	  5909:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5910:     ; Copy the result to [01].
                            	  5911:     ;
02:00048E38 102C0084        	  5912:     move.b  ($0084,A4),D0
02:00048E3C 023C00EE        	  5913:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E40 41F900048D62    	  5914:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048E46 12303000        	  5915:     move.b  (A0,D3.W),D1
02:00048E4A D101            	  5916:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048E4C 41EC0084        	  5917:     lea     ($0084,A4),A0
02:00048E50 11802000        	  5918:     move.b  D0,(A0,D2.W)
02:00048E54 19400001        	  5919:     move.b  D0,($0001,A4)
                            	  5920:     ; If state = 1, use up direction.
                            	  5921:     ; Else use object direction.
                            	  5922:     ;
02:00048E58 41EC00AC        	  5923:     lea     ($00AC,A4),A0
02:00048E5C 10302000        	  5924:     move.b  (A0,D2.W),D0
02:00048E60 0200000F        	  5925:     andi.b #$0F,D0
02:00048E64 7600            	  5926:     moveq   #0,D3
02:00048E66 1600            	  5927:     move.b  D0,D3
02:00048E68 7008            	  5928:     moveq   #8,D0
02:00048E6A 5303            	  5929:     subq.b  #1,D3
02:00048E6C 6708            	  5930:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048E6E 41EC0098        	  5931:     lea     ($0098,A4),A0
02:00048E72 10302000        	  5932:     move.b  (A0,D2.W),D0
                            	  5933:     even
                            	  5934: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5935:     ; Store the weapon's frame (horizontal or vertical)
                            	  5936:     ; for the direction chosen above in [0C].
                            	  5937:     ;
02:00048E76 4EB9000309AA    	  5938:     jsr     GetOppositeDir
02:00048E7C 41F9000488B0    	  5939:     lea     (RDirectionToWeaponFrame).l,A0
02:00048E82 10303000        	  5940:     move.b  (A0,D3.W),D0
02:00048E86 1940000C        	  5941:     move.b  D0,($000C,A4)
                            	  5942:     ; Calculate sprite attributes.
                            	  5943:     ;
                            	  5944:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5945:     ;   base attribute OR 1
                            	  5946:     ; So, it uses palette row 5.
                            	  5947:     ;
02:00048E8A 41F9000488B4    	  5948:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048E90 10303000        	  5949:     move.b  (A0,D3.W),D0
02:00048E94 0C02000D        	  5950:     cmpi.b  #$0D,D2
02:00048E98 6706            	  5951:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048E9A 00000001        	  5952:     ori.b #$01,D0
02:00048E9E 601C            	  5953:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5954: 
                            	  5955:     even
                            	  5956: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5957:     ; The weapon is the sword.
                            	  5958:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5959:     ;
02:00048EA0 023C00EE        	  5960:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048EA4 122C0657        	  5961:     move.b  ($0657,A4),D1
02:00048EA8 D101            	  5962:     addx.b  D1,D0   ; ADC Items
02:00048EAA 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:00048EAE 123C0001        	  5964:     move.b  #$01,D1
02:00048EB2 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048EB6 9101            	  5966:     subx.b  D1,D0   ; SBC #$01
02:00048EB8 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5968:     even
                            	  5969: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5970:     ; Set sprite attributes to the calculated value above.
                            	  5971:     ;
02:00048EBC 4EB90003106C    	  5972:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5973:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5974:     ;
02:00048EC2 0C030002        	  5975:     cmpi.b  #$02,D3
02:00048EC6 6604            	  5976:     bne  _anon_z07_33
02:00048EC8 522C000F        	  5977:     addq.b  #1,($000F,A4)
                            	  5978: _anon_z07_33:
                            	  5979:     ; If state = 1, return. Don't show the weapon.
                            	  5980:     ;
02:00048ECC 41EC00AC        	  5981:     lea     ($00AC,A4),A0
02:00048ED0 10302000        	  5982:     move.b  (A0,D2.W),D0
02:00048ED4 0200000F        	  5983:     andi.b #$0F,D0
02:00048ED8 0C000001        	  5984:     cmpi.b  #$01,D0
02:00048EDC 6604            	  5985:     bne.s  __far_z_07_0086
02:00048EDE 600000AA        	  5986:     jmp  L1F854_Exit
                            	  5987: __far_z_07_0086:
                            	  5988:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5989:     ; sword or rod
                            	  5990:     ;
                            	  5991:     ;
                            	  5992:     ; Sword slot
02:00048EE2 7600            	  5993:     moveq   #0,D3
02:00048EE4 0C02000D        	  5994:     cmpi.b  #$0D,D2
02:00048EE8 6702            	  5995:     beq  _anon_z07_34
02:00048EEA 7608            	  5996:     moveq   #8,D3
                            	  5997: _anon_z07_34:
02:00048EEC 4EB900030F8C    	  5998:     jsr     Anim_WriteItemSprites
                            	  5999:     ; If state <> 3, return.
                            	  6000:     ;
02:00048EF2 41EC00AC        	  6001:     lea     ($00AC,A4),A0
02:00048EF6 10302000        	  6002:     move.b  (A0,D2.W),D0
02:00048EFA 0200000F        	  6003:     andi.b #$0F,D0
02:00048EFE 0C000003        	  6004:     cmpi.b  #$03,D0
02:00048F02 6704            	  6005:     beq.s  __far_z_07_0087
02:00048F04 60000084        	  6006:     jmp  L1F854_Exit
                            	  6007: __far_z_07_0087:
                            	  6008:     ; State = 3. Time to instantiate a shot.
                            	  6009:     ;
                            	  6010:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6011:     ;
02:00048F08 0C020012        	  6012:     cmpi.b  #$12,D2
02:00048F0C 6704            	  6013:     beq.s  __far_z_07_0088
02:00048F0E 60000082        	  6014:     jmp  MakeSwordShot
                            	  6015: __far_z_07_0088:
                            	  6016:     ; Instantiate a magic shot (rod shot).
                            	  6017:     ; Switch to the shot slot $E.
                            	  6018:     ;
02:00048F12 740E            	  6019:     moveq   #14,D2
                            	  6020:     ; If high bit of state is set, return. It's already active.
                            	  6021:     ;
02:00048F14 41EC00AC        	  6022:     lea     ($00AC,A4),A0
02:00048F18 10302000        	  6023:     move.b  (A0,D2.W),D0
02:00048F1C 6706            	  6024:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00048F1E E308            	  6025:     lsl.b  #1,D0   ; ASL A
02:00048F20 6402            	  6026:     bcc.s  __far_z_07_0089
02:00048F22 6066            	  6027:     jmp  L1F854_Exit
                            	  6028: __far_z_07_0089:
                            	  6029:     even
                            	  6030: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6031:     ; Play "magic shot" tune.
                            	  6032:     ;
02:00048F24 7004            	  6033:     moveq   #4,D0
02:00048F26 19400604        	  6034:     move.b  D0,($0604,A4)
