02:00048FAC 0200000F        	  6117:     andi.b #$0F,D0
02:00048FB0 1880            	  6118:     move.b  D0,($0000,A4)
02:00048FB2 101D            	  6119:     move.b  (A5)+,D0  ; PLA
02:00048FB4 E208            	  6120:     lsr.b  #1,D0   ; LSR A
02:00048FB6 E208            	  6121:     lsr.b  #1,D0   ; LSR A
02:00048FB8 E208            	  6122:     lsr.b  #1,D0   ; LSR A
02:00048FBA E208            	  6123:     lsr.b  #1,D0   ; LSR A
02:00048FBC 1214            	  6124:     move.b  ($0000,A4),D1
02:00048FBE B001            	  6125:     cmp.b   D1,D0
02:00048FC0 6702            	  6126:     beq.s  __far_z_07_0093
02:00048FC2 60C6            	  6127:     jmp  L1F854_Exit
