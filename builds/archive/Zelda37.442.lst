                            	  3443: Obj_Shove:
                            	  3444:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3445:     ; then go handle it separately.
                            	  3446:     ;
02:00047DFE 41EC00C0        	  3447:     lea     ($00C0,A4),A0
