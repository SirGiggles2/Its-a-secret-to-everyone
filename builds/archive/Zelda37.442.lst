02:000336FE 60E6            	  2181:     jmp  LA10A_Exit
                            	  2182: __far_z_02_0002:
                            	  2183:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2184:     ; in the current slot's name.
02:00033700 41F900033114    	  2185:     lea     (SlotToNameOffset).l,A0
02:00033706 10303000        	  2186:     move.b  (A0,D3.W),D0
02:0003370A 19400421        	  2187:     move.b  D0,($0421,A4)
                            	  2188:     ; Get the offset of the end of the initial name character
                            	  2189:     ; transfer record header for the current slot.
02:0003370E 7400            	  2190:     moveq   #0,D2
02:00033710 41F900033118    	  2191:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033716 14303000        	  2192:     move.b  (A0,D3.W),D2
