                            	  3186:     ; skip this and go update objects.
                            	  3187:     ;
02:00047C1A 102C0060        	  3188:     move.b  ($0060,A4),D0
02:00047C1E 0A000001        	  3189:     eori.b #$01,D0
02:00047C22 19400060        	  3190:     move.b  D0,($0060,A4)
02:00047C26 671C            	  3191:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3192:     ; If Link's X has not changed since the last frame
                            	  3193:     ; (when Link was the target), then XOR the chase target
                            	  3194:     ; coordinates (which were Link's coordinates last frame).
                            	  3195:     ;
                            	  3196:     ; This ends up reflecting Link's coordinates across the room;
                            	  3197:     ; so that monsters chase away from him.
                            	  3198:     ;
                            	  3199:     ; But if Link's X has changed since the last frame, then
                            	  3200:     ; leave the chase target coordinates with his old coordinates.
                            	  3201:     ;
02:00047C28 102C0061        	  3202:     move.b  ($0061,A4),D0
02:00047C2C 122C0070        	  3203:     move.b  ($0070,A4),D1
02:00047C30 B001            	  3204:     cmp.b   D1,D0
02:00047C32 6610            	  3205:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:00047C34 4600            	  3206:     eori.b #$FF,D0
02:00047C36 19400061        	  3207:     move.b  D0,($0061,A4)
02:00047C3A 102C0062        	  3208:     move.b  ($0062,A4),D0
02:00047C3E 4600            	  3209:     eori.b #$FF,D0
02:00047C40 19400062        	  3210:     move.b  D0,($0062,A4)
                            	  3211:     even
                            	  3212: _L_z07_BeginUpdateWorld_LoopObject:
                            	  3213:     ; Update objects from $B to 1.
                            	  3214:     ;
02:00047C44 7400            	  3215:     moveq   #0,D2
02:00047C46 142C0340        	  3216:     move.b  ($0340,A4),D2
02:00047C4A 61001F60        	  3217:     jsr     DecrementInvincibilityTimer
02:00047C4E 41EC034F        	  3218:     lea     ($034F,A4),A0
02:00047C52 10302000        	  3219:     move.b  (A0,D2.W),D0
02:00047C56 674A            	  3220:     beq  _L_z07_BeginUpdateWorld_NextObject
02:00047C58 41EC034F        	  3221:     lea     ($034F,A4),A0
02:00047C5C 10302000        	  3222:     move.b  (A0,D2.W),D0
02:00047C60 61001874        	  3223:     jsr     UpdateObject
                            	  3224:     ; If the object is autonomous and not checking collisions itself,
                            	  3225:     ; then see about checking collisions and drawing on its behalf.
                            	  3226:     ;
                            	  3227:     ; Else go loop again.
                            	  3228:     ;
02:00047C64 7400            	  3229:     moveq   #0,D2
02:00047C66 142C0340        	  3230:     move.b  ($0340,A4),D2
02:00047C6A 41EC0405        	  3231:     lea     ($0405,A4),A0
02:00047C6E 10302000        	  3232:     move.b  (A0,D2.W),D0
02:00047C72 662E            	  3233:     bne  _L_z07_BeginUpdateWorld_NextObject
02:00047C74 41EC04BF        	  3234:     lea     ($04BF,A4),A0
02:00047C78 10302000        	  3235:     move.b  (A0,D2.W),D0
02:00047C7C 02000001        	  3236:     andi.b #$01,D0
02:00047C80 6620            	  3237:     bne  _L_z07_BeginUpdateWorld_NextObject
                            	  3238:     ; If no attribute 1, then it indicates not to skip drawing. So, animate and draw.
                            	  3239:     ;
02:00047C82 41EC04BF        	  3240:     lea     ($04BF,A4),A0
02:00047C86 10302000        	  3241:     move.b  (A0,D2.W),D0
02:00047C8A 02000004        	  3242:     andi.b #$04,D0
02:00047C8E 6606            	  3243:     bne  _anon_z07_10
02:00047C90 4EB900030D6C    	  3244:     jsr     AnimateAndDrawObjectWalking
                            	  3245: _anon_z07_10:
                            	  3246:     ; Either way, we'll check collisions.
                            	  3247:     ;
02:00047C96 7400            	  3248:     moveq   #0,D2
02:00047C98 142C0340        	  3249:     move.b  ($0340,A4),D2
02:00047C9C 4EB9000310E6    	  3250:     jsr     CheckMonsterCollisions
                            	  3251:     even
                            	  3252: _L_z07_BeginUpdateWorld_NextObject:
                            	  3253:     ; Bottom of the object update loop.
                            	  3254:     ;
02:00047CA2 532C0340        	  3255:     subq.b  #1,($0340,A4)
02:00047CA6 669C            	  3256:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3257:     ; Set the current object slot to what it should be when we
                            	  3258:     ; begin updating objects again next frame: $B
                            	  3259:     ; the last object slot for monsters and tile objects
                            	  3260:     ;
                            	  3261:     ; Before the first frame of mode 5, the current object slot variable
                            	  3262:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3263:     ;
                            	  3264:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3265:     ;
02:00047CA8 700B            	  3266:     moveq   #11,D0
02:00047CAA 19400340        	  3267:     move.b  D0,($0340,A4)
                            	  3268:     ; If full hearts = 0, then only a partial heart is left.
                            	  3269:     ; So, turn on the "heart warning".
                            	  3270:     ;
02:00047CAE 102C066F        	  3271:     move.b  ($066F,A4),D0
02:00047CB2 0200000F        	  3272:     andi.b #$0F,D0
02:00047CB6 660C            	  3273:     bne  _L_z07_BeginUpdateWorld_CheckUW
02:00047CB8 102C0604        	  3274:     move.b  ($0604,A4),D0
02:00047CBC 00000040        	  3275:     ori.b #$40,D0
02:00047CC0 19400604        	  3276:     move.b  D0,($0604,A4)
                            	  3277:     even
