02:0003BEEC D101            	  8675:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003BEEE 19802070        	  8676:     move.b  D0,($70,A4,D2.W)
02:0003BEF2 41EC0084        	  8677:     lea     ($0084,A4),A0
