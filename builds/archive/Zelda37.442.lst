                            	  5331: __far_z_07_0078:
                            	  5332:     ; State $2x. Spark.
                            	  5333:     ;
                            	  5334:     ; Change the state to $28, and decrement animation counter.
                            	  5335:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5336:     ; (with Link, if this is a monster's boomerang).
                            	  5337:     ;
                            	  5338:     ; TODO: Why state $28?
                            	  5339:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5340:     ; start over again when spinning.
                            	  5341:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5342:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5343:     ; any drawing code depends on the minor state.
                            	  5344:     ;
02:00048A1A 7028            	  5345:     moveq   #40,D0
02:00048A1C 41EC00AC        	  5346:     lea     ($00AC,A4),A0
02:00048A20 11802000        	  5347:     move.b  D0,(A0,D2.W)
02:00048A24 41EC03D0        	  5348:     lea     ($03D0,A4),A0
02:00048A28 53302000        	  5349:     subq.b  #1,(A0,D2.W)
02:00048A2C 6702            	  5350:     beq.s  __far_z_07_0079
02:00048A2E 6060            	  5351:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5352: __far_z_07_0079:
                            	  5353:     ; Animation counter = 0.
                            	  5354:     ;
                            	  5355:     ; Set state to $40. It will become $50 below in
                            	  5356:     ; HandleArrowOrBoomerangBlocked.
                            	  5357:     ;
02:00048A30 7040            	  5358:     moveq   #64,D0
02:00048A32 41EC00AC        	  5359:     lea     ($00AC,A4),A0
02:00048A36 11802000        	  5360:     move.b  D0,(A0,D2.W)
                            	  5361:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5362:     ; Else go handle the boomerang being blocked.
                            	  5363:     ;
02:00048A3A 0C02000D        	  5364:     cmpi.b  #$0D,D2
02:00048A3E 640E            	  5365:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:00048A40 41EC034F        	  5366:     lea     ($034F,A4),A0
