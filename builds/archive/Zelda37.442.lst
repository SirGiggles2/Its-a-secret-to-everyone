02:00048F3E 41EC0098        	  6047:     lea     ($0098,A4),A0
02:00048F42 10302000        	  6048:     move.b  (A0,D2.W),D0
02:00048F46 02000003        	  6049:     andi.b #$03,D0
02:00048F4A 6714            	  6050:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00048F4C 10342070        	  6051:     move.b  ($70,A4,D2.W),D0
02:00048F50 0C000014        	  6052:     cmpi.b  #$14,D0
02:00048F54 6402            	  6053:     bcc.s  __far_z_07_0090
