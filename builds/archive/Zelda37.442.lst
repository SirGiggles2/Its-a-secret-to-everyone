02:00048FE8 0C000021        	  6152:     cmpi.b  #$21,D0
02:00048FEC 6656            	  6153:     bne  _L_z07_UpdateFire_StandingFie
                            	  6154:     ; Move as if grid offset were 0.
                            	  6155:     ;
02:00048FEE 41EC0394        	  6156:     lea     ($0394,A4),A0
02:00048FF2 10302000        	  6157:     move.b  (A0,D2.W),D0
02:00048FF6 1B00            	  6158:     move.b  D0,-(A5)  ; PHA
02:00048FF8 7000            	  6159:     moveq   #0,D0
02:00048FFA 41EC0394        	  6160:     lea     ($0394,A4),A0
02:00048FFE 11802000        	  6161:     move.b  D0,(A0,D2.W)
02:00049002 41EC0098        	  6162:     lea     ($0098,A4),A0
