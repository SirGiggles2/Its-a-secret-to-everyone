                            	  4746: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4747: ;==============================================================================
                            	  4748: 
                            	  4749:     xref    _ShootIfWanted
                            	  4750: 
                            	  4751: ; ShootIfWanted(type, slot)
                            	  4752: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4753: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4754: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4755: c_shoot_if_wanted:
02:0002CF1E 2F02            	  4756:     move.l  D2,-(SP)
02:0002CF20 202F0008        	  4757:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CF24 242F000C        	  4758:     move.l  12(SP),D2       ; arg2 = slot
02:0002CF28 4EB90003C53C    	  4759:     jsr     _ShootIfWanted
02:0002CF2E 640C            	  4760:     bcc.s   .csiw_fail
02:0002CF30 7000            	  4761:     moveq   #0,D0
02:0002CF32 1003            	  4762:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CF34 008000000100    	  4763:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF3A 6002            	  4764:     bra.s   .csiw_done
                            	  4765: .csiw_fail:
02:0002CF3C 7000            	  4766:     moveq   #0,D0
                            	  4767: .csiw_done:
02:0002CF3E 241F            	  4768:     move.l  (SP)+,D2
02:0002CF40 4E75            	  4769:     rts
