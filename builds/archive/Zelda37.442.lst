02:0003E2A6 102C0098        	  2820:     move.b  ($0098,A4),D0
02:0003E2AA 0200000C        	  2821:     andi.b #$0C,D0
02:0003E2AE 6602            	  2822:     bne  _anon_z05_77
02:0003E2B0 7603            	  2823:     moveq   #3,D3
                            	  2824: _anon_z05_77:
