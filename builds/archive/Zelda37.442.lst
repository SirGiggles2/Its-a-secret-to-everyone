                            	  8994: Ganon_CheckCollisions:
                            	  8995:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  8996:     ; Store in [02] and [03].
                            	  8997:     ;
02:0003C16E 10342070        	  8998:     move.b  ($70,A4,D2.W),D0
02:0003C172 023C00EE        	  8999:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C176 123C0010        	  9000:     move.b  #$10,D1
02:0003C17A D101            	  9001:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C17C 19400002        	  9002:     move.b  D0,($0002,A4)
02:0003C180 41EC0084        	  9003:     lea     ($0084,A4),A0
02:0003C184 10302000        	  9004:     move.b  (A0,D2.W),D0
02:0003C188 023C00EE        	  9005:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C18C 123C0010        	  9006:     move.b  #$10,D1
02:0003C190 D101            	  9007:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C192 19400003        	  9008:     move.b  D0,($0003,A4)
                            	  9009:     ; Check for a collision with Link.
                            	  9010:     ;
                            	  9011:     ; We can't call CheckLinkCollision, because we need to
                            	  9012:     ; customize Ganon's midpoint.
                            	  9013:     ;
                            	  9014:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9015:     ; detection, if Link is invincible. Initialize variables that will
                            	  9016:     ; be returned from the partial collision check routine. Then
                            	  9017:     ; call it.
                            	  9018:     ;
02:0003C196 102C04F0        	  9019:     move.b  ($04F0,A4),D0
02:0003C19A 6616            	  9020:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C19C 19400006        	  9021:     move.b  D0,($0006,A4)
02:0003C1A0 19400009        	  9022:     move.b  D0,($0009,A4)
02:0003C1A4 1940000C        	  9023:     move.b  D0,($000C,A4)
02:0003C1A8 7600            	  9024:     moveq   #0,D3
02:0003C1AA 1883            	  9025:     move.b  D3,($0000,A4)
02:0003C1AC 4EB900031150    	  9026:     jsr     CheckLinkCollisionPreinit
                            	  9027:     even
                            	  9028: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9029:     ; If Ganon is not in state 0, then he's brown.
                            	  9030:     ; Go check collision with an arrow.
                            	  9031:     ;
02:0003C1B2 41EC00AC        	  9032:     lea     ($00AC,A4),A0
02:0003C1B6 10302000        	  9033:     move.b  (A0,D2.W),D0
02:0003C1BA 6652            	  9034:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9035:     ; If timer <> 0, then Ganon is visible.
                            	  9036:     ; He can't be harmed like this. So, return.
                            	  9037:     ;
02:0003C1BC 10342028        	  9038:     move.b  ($28,A4,D2.W),D0
02:0003C1C0 664A            	  9039:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C1C2 760D            	  9040:     moveq   #13,D3
02:0003C1C4 4EB90003118A    	  9041:     jsr     CheckMonsterSwordCollision
                            	  9042:     ; If Ganon has died according to the usual collision check rules
                            	  9043:     ; (HP = 0), then:
                            	  9044:     ; 1. Restore HP to the initial value $F0
                            	  9045:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  9046:     ; 3. Change palette row 7 to make Ganon brown
                            	  9047:     ;
02:0003C1CA 41EC0405        	  9048:     lea     ($0405,A4),A0
02:0003C1CE 10302000        	  9049:     move.b  (A0,D2.W),D0
02:0003C1D2 6718            	  9050:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C1D4 103C00F0        	  9051:     move.b  #$F0,D0
02:0003C1D8 41EC0485        	  9052:     lea     ($0485,A4),A0
02:0003C1DC 11802000        	  9053:     move.b  D0,(A0,D2.W)
02:0003C1E0 41EC00AC        	  9054:     lea     ($00AC,A4),A0
02:0003C1E4 53302000        	  9055:     subq.b  #1,(A0,D2.W)
02:0003C1E8 61000084        	  9056:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  9057:     even
                            	  9058: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  9059:     ; If Ganon was harmed, then play the sound effect
                            	  9060:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  9061:     ;
02:0003C1EC 41EC04F0        	  9062:     lea     ($04F0,A4),A0
02:0003C1F0 10302000        	  9063:     move.b  (A0,D2.W),D0
02:0003C1F4 670A            	  9064:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C1F6 6100BF7E        	  9065:     jsr     PlayBossHitCryIfNeeded
02:0003C1FA 7040            	  9066:     moveq   #64,D0
02:0003C1FC 19802028        	  9067:     move.b  D0,($28,A4,D2.W)
                            	  9068:     even
                            	  9069: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  9070:     ; Reset metastate, because Ganon cannot die this way.
                            	  9071:     ;
02:0003C200 4EB900049BDC    	  9072:     jsr     ResetObjMetastate
                            	  9073:     ; Reset shove info and invincibility timer, because Ganon
                            	  9074:     ; doesn't react at all as a usual monster.
                            	  9075:     ;
02:0003C206 4EB900031178    	  9076:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	  9077:     even
                            	  9078: _L_z04_Ganon_CheckCollisions_Exit:
02:0003C20C 4E75            	  9079:     rts
                            	  9080: 
                            	  9081:     even
                            	  9082: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  9083:     ; If the silver arrow is not in the inventory, then return.
                            	  9084:     ;
02:0003C20E 102C0659        	  9085:     move.b  ($0659,A4),D0
02:0003C212 0C000002        	  9086:     cmpi.b  #$02,D0
02:0003C216 66F4            	  9087:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9088:     ; Reset the collision return value [06].
                            	  9089:     ;
02:0003C218 7000            	  9090:     moveq   #0,D0
02:0003C21A 19400006        	  9091:     move.b  D0,($0006,A4)
                            	  9092:     ; If there's no arrow in flight, then return.
                            	  9093:     ;
02:0003C21E 7612            	  9094:     moveq   #18,D3
02:0003C220 41EC00AC        	  9095:     lea     ($00AC,A4),A0
02:0003C224 10303000        	  9096:     move.b  (A0,D3.W),D0
02:0003C228 0C000010        	  9097:     cmpi.b  #$10,D0
02:0003C22C 66DE            	  9098:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9099:     ; Check for collision with an arrow; and return if no collision.
                            	  9100:     ;
02:0003C22E 4EB900031192    	  9101:     jsr     CheckMonsterArrowOrRodCollision
02:0003C234 102C0006        	  9102:     move.b  ($0006,A4),D0
02:0003C238 67D2            	  9103:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	  9104:     ; Set the Ganon phase to "dying".
                            	  9105:     ;
02:0003C23A 41EC042C        	  9106:     lea     ($042C,A4),A0
02:0003C23E 52302000        	  9107:     addq.b  #1,(A0,D2.W)
                            	  9108:     ; Now his body does flash.
                            	  9109:     ;
02:0003C242 7028            	  9110:     moveq   #40,D0
02:0003C244 41EC04F0        	  9111:     lea     ($04F0,A4),A0
02:0003C248 11802000        	  9112:     move.b  D0,(A0,D2.W)
                            	  9113:     ; Set initial cloud distance 8.
                            	  9114:     ;
02:0003C24C 7008            	  9115:     moveq   #8,D0
02:0003C24E 41EC0478        	  9116:     lea     ($0478,A4),A0
02:0003C252 11802000        	  9117:     move.b  D0,(A0,D2.W)
02:0003C256 0A3C0001        	  9118:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C25A 4E75            	  9119:     rts
                            	  9120: 
                            	  9121:     even
