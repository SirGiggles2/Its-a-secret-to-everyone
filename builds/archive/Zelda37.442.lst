                            	  7173: _L_z07_InitObject_InitMonsterFromEdge:
02:00049818 7400            	  7174:     moveq   #0,D2
02:0004981A 142C0340        	  7175:     move.b  ($0340,A4),D2
                            	  7176:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7177:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7178:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7179:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7180:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7181:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7182:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7183:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7184:     ; corrupting them and causing a deterministic address-error
                            	  7185:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7186:     ; identified by Codex static review.)
                            	  7187: _L_z07_P47_pre_check:
02:0004981E 102C0525        	  7188:     move.b  ($0525,A4),D0
02:00049822 020000F0        	  7189:     andi.b  #$F0,D0
02:00049826 0C000040        	  7190:     cmpi.b  #$40,D0
02:0004982A 6506            	  7191:     blo     _L_z07_P47_pre_snap
02:0004982C 0C0000E0        	  7192:     cmpi.b  #$E0,D0
02:00049830 6506            	  7193:     blo     _L_z07_P47_pre_ok
                            	  7194: _L_z07_P47_pre_snap:
02:00049832 197C00480525    	  7195:     move.b  #$48,($0525,A4)
                            	  7196: _L_z07_P47_pre_ok:
02:00049838 7005            	  7197:     moveq   #5,D0
02:0004983A 610004F4        	  7198:     jsr     SwitchBank
02:0004983E 4EB90003E73A    	  7199:     jsr     FindNextEdgeSpawnCell
                            	  7200:     ; Post-walk 1: bottom-edge snap.
02:00049844 102C0525        	  7201:     move.b  ($0525,A4),D0
02:00049848 020000F0        	  7202:     andi.b  #$F0,D0
02:0004984C 0C0000E0        	  7203:     cmpi.b  #$E0,D0
02:00049850 660C            	  7204:     bne     _L_z07_P47_post1_ok
02:00049852 197C00480525    	  7205:     move.b  #$48,($0525,A4)
02:00049858 4EB90003E73A    	  7206:     jsr     FindNextEdgeSpawnCell
                            	  7207: _L_z07_P47_post1_ok:
                            	  7208:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7209:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004985E 7600            	  7210:     moveq   #0,D3
02:00049860 162C0525        	  7211:     move.b  ($0525,A4),D3
02:00049864 0243000F        	  7212:     andi.w  #$000F,D3
02:00049868 C6FC002C        	  7213:     mulu.w  #44,D3
02:0004986C 203C00FF6530    	  7214:     move.l  #$FF6530,D0
02:00049872 D083            	  7215:     add.l   D3,D0
02:00049874 7600            	  7216:     moveq   #0,D3
02:00049876 162C0525        	  7217:     move.b  ($0525,A4),D3
02:0004987A E84B            	  7218:     lsr.w   #4,D3
02:0004987C 5943            	  7219:     subi.w  #4,D3
02:0004987E E34B            	  7220:     lsl.w   #1,D3
02:00049880 D083            	  7221:     add.l   D3,D0
02:00049882 2040            	  7222:     movea.l D0,A0
02:00049884 1010            	  7223:     move.b  (A0),D0
02:00049886 0C000084        	  7224:     cmpi.b  #$84,D0
02:0004988A 6544            	  7225:     blo     _L_z07_P47_post2_ok
                            	  7226:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7227:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7228:     ; writes to the $05xx region.
02:0004988C 7800            	  7229:     moveq   #0,D4
                            	  7230: _L_z07_P47_fb_loop:
02:0004988E 41FAE566        	  7231:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049892 12304000        	  7232:     move.b  (A0,D4.W),D1
02:00049896 19410525        	  7233:     move.b  D1,($0525,A4)
                            	  7234:     ; Validate fallback cell walkable.
02:0004989A 7600            	  7235:     moveq   #0,D3
02:0004989C 1601            	  7236:     move.b  D1,D3
02:0004989E 0243000F        	  7237:     andi.w  #$000F,D3
02:000498A2 C6FC002C        	  7238:     mulu.w  #44,D3
02:000498A6 203C00FF6530    	  7239:     move.l  #$FF6530,D0
02:000498AC D083            	  7240:     add.l   D3,D0
02:000498AE 7600            	  7241:     moveq   #0,D3
02:000498B0 1601            	  7242:     move.b  D1,D3
02:000498B2 E84B            	  7243:     lsr.w   #4,D3
02:000498B4 5943            	  7244:     subi.w  #4,D3
02:000498B6 E34B            	  7245:     lsl.w   #1,D3
02:000498B8 D083            	  7246:     add.l   D3,D0
02:000498BA 2040            	  7247:     movea.l D0,A0
02:000498BC 0C100084        	  7248:     cmpi.b  #$84,(A0)
02:000498C0 650E            	  7249:     blo     _L_z07_P47_post2_ok
02:000498C2 5204            	  7250:     addq.b  #1,D4
02:000498C4 0C040008        	  7251:     cmpi.b  #8,D4
02:000498C8 65C4            	  7252:     blo     _L_z07_P47_fb_loop
                            	  7253:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7254:     ; rather than looping).
02:000498CA 197C00480525    	  7255:     move.b  #$48,($0525,A4)
                            	  7256: _L_z07_P47_post2_ok:
                            	  7257:     ; Extract and set the monster's location.
                            	  7258:     ;
02:000498D0 102C0525        	  7259:     move.b  ($0525,A4),D0
                            	  7260:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7261:     ;
02:000498D4 1B00            	  7262:     move.b  D0,-(A5)  ; PHA
02:000498D6 E308            	  7263:     lsl.b  #1,D0   ; ASL A
02:000498D8 E308            	  7264:     lsl.b  #1,D0   ; ASL A
02:000498DA E308            	  7265:     lsl.b  #1,D0   ; ASL A
02:000498DC E308            	  7266:     lsl.b  #1,D0   ; ASL A
02:000498DE 19802070        	  7267:     move.b  D0,($70,A4,D2.W)
                            	  7268:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7269:     ;
02:000498E2 101D            	  7270:     move.b  (A5)+,D0  ; PLA
02:000498E4 020000F0        	  7271:     andi.b #$F0,D0
02:000498E8 003C0011        	  7272:     ori     #$11,CCR  ; SEC: set C+X
02:000498EC 123C0003        	  7273:     move.b  #$03,D1
02:000498F0 0A3C0010        	  7274:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000498F4 9101            	  7275:     subx.b  D1,D0   ; SBC #$03
02:000498F6 0A3C0010        	  7276:     eori    #$10,CCR  ; restore X = 6502 C
02:000498FA 41EC0084        	  7277:     lea     ($0084,A4),A0
02:000498FE 11802000        	  7278:     move.b  D0,(A0,D2.W)
                            	  7279:     ; Set the monsters-from-edges long timer to a random value
                            	  7280:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7281:     ;
02:00049902 10342019        	  7282:     move.b  ($19,A4,D2.W),D0
02:00049906 02000003        	  7283:     andi.b #$03,D0
02:0004990A 023C00EE        	  7284:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004990E 123C0002        	  7285:     move.b  #$02,D1
02:00049912 D101            	  7286:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049914 1940004B        	  7287:     move.b  D0,($004B,A4)
                            	  7288:     ; If the distance to Link is too close to Link, then
                            	  7289:     ; go flag the monster uninitialized again, so we can
                            	  7290:     ; try to spawn it again next time.
                            	  7291:     ;
02:00049918 7005            	  7292:     moveq   #5,D0
02:0004991A 61000414        	  7293:     jsr     SwitchBank
02:0004991E 4EB90003DD4E    	  7294:     jsr     IsDistanceSafeToSpawn
02:00049924 6500FEB4        	  7295:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7296:     ; OK to spawn.
                            	  7297:     ; In this situation, monsters don't spawn from a cloud.
                            	  7298:     ;
02:00049928 7000            	  7299:     moveq   #0,D0
02:0004992A 41EC0405        	  7300:     lea     ($0405,A4),A0
02:0004992E 11802000        	  7301:     move.b  D0,(A0,D2.W)
                            	  7302:     even
                            	  7303: _L_z07_InitObject_NormalSpawn:
