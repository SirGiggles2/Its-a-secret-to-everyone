                            	  6798: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6799:     ; To animate the state, the animation counter had to have
                            	  6800:     ; reached 0. Right after this routine, the counter will be
                            	  6801:     ; rolled over, and the movement frame will be switched.
                            	  6802:     ;
                            	  6803:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6804:     ; the animation here, in order to immediately change it to
                            	  6805:     ; 0 (legs apart) after this.
                            	  6806:     ;
02:00049424 7001            	  6807:     moveq   #1,D0
02:00049426 194003E4        	  6808:     move.b  D0,($03E4,A4)
02:0004942A 4E75            	  6809:     rts
                            	  6810: 
