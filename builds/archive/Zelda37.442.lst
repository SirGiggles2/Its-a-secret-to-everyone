                            	  8209: UpdatePatraChild:
                            	  8210:     ; If state = 1, then go orbit.
                            	  8211:     ;
02:0003BBEA 41EC00AC        	  8212:     lea     ($00AC,A4),A0
02:0003BBEE 10302000        	  8213:     move.b  (A0,D2.W),D0
02:0003BBF2 6704            	  8214:     beq.s  __far_z_04_0090
02:0003BBF4 6000009E        	  8215:     jmp  PatraChild_State1
                            	  8216: __far_z_04_0090:
                            	  8217:     ; State = 0.
                            	  8218:     ;
                            	  8219:     ; If the current object slot is 2, then go initialize the patra child.
                            	  8220:     ; This is the only patra child shown in the first fame.
                            	  8221:     ;
02:0003BBF8 0C020002        	  8222:     cmpi.b  #$02,D2
02:0003BBFC 6732            	  8223:     beq  _L_z04_UpdatePatraChild_Ready
                            	  8224:     ; The patra child in slot 2 is the last one to be updated.
                            	  8225:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  8226:     ;
                            	  8227:     ; This means that in the first frame, slot 2 is the only one to be
                            	  8228:     ; shown.
                            	  8229:     ;
02:0003BBFE 102C00AE        	  8230:     move.b  ($00AE,A4),D0
02:0003BC02 6700008E        	  8231:     beq  _L_z04_UpdatePatraChild_Exit
                            	  8232:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  8233:     ; here to wait to be shown at the top position (N) one at a time.
                            	  8234:     ;
02:0003BC06 1002            	  8235:     move.b  D2,D0
                            	  8236:     ; Subtract 3 from the object slot to get the angle where the
                            	  8237:     ; patra child in object slot 2 should be for the current one to appear.
                            	  8238:     ;
02:0003BC08 003C0011        	  8239:     ori     #$11,CCR  ; SEC: set C+X
02:0003BC0C 123C0003        	  8240:     move.b  #$03,D1
02:0003BC10 0A3C0010        	  8241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BC14 9101            	  8242:     subx.b  D1,D0   ; SBC #$03
02:0003BC16 0A3C0010        	  8243:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BC1A 7600            	  8244:     moveq   #0,D3
02:0003BC1C 1600            	  8245:     move.b  D0,D3
                            	  8246:     ; If the patra child in slot 2 has not reached the required angle,
                            	  8247:     ; then return.
                            	  8248:     ;
02:0003BC1E 102C0396        	  8249:     move.b  ($0396,A4),D0
02:0003BC22 41F90003BBDC    	  8250:     lea     (PatraChildStartAngles).l,A0
02:0003BC28 12303000        	  8251:     move.b  (A0,D3.W),D1
02:0003BC2C B001            	  8252:     cmp.b   D1,D0
02:0003BC2E 6662            	  8253:     bne  _L_z04_UpdatePatraChild_Exit
                            	  8254:     even
                            	  8255: _L_z04_UpdatePatraChild_Ready:
                            	  8256:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  8257:     ; the patra parent's state.
                            	  8258:     ;
02:0003BC30 0C020009        	  8259:     cmpi.b  #$09,D2
02:0003BC34 6604            	  8260:     bne  _anon_z04_157
02:0003BC36 522C00AD        	  8261:     addq.b  #1,($00AD,A4)
                            	  8262: _anon_z04_157:
                            	  8263:     ; Go to state 1 to orbit.
                            	  8264:     ;
02:0003BC3A 41EC00AC        	  8265:     lea     ($00AC,A4),A0
02:0003BC3E 52302000        	  8266:     addq.b  #1,(A0,D2.W)
                            	  8267:     ; TODO: ?
                            	  8268:     ;
02:0003BC42 103C0080        	  8269:     move.b  #$80,D0
02:0003BC46 41EC0098        	  8270:     lea     ($0098,A4),A0
02:0003BC4A 11802000        	  8271:     move.b  D0,(A0,D2.W)
                            	  8272:     ; Set angle $18 (N).
                            	  8273:     ;
02:0003BC4E 7018            	  8274:     moveq   #24,D0
02:0003BC50 41EC0394        	  8275:     lea     ($0394,A4),A0
02:0003BC54 11802000        	  8276:     move.b  D0,(A0,D2.W)
                            	  8277:     ; This location is right above Patra.
                            	  8278:     ; Set X coordinate to Patra's.
                            	  8279:     ;
02:0003BC58 102C0071        	  8280:     move.b  ($0071,A4),D0
02:0003BC5C 19802070        	  8281:     move.b  D0,($70,A4,D2.W)
                            	  8282:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  8283:     ; Else use radius $18. Store the chosen value in [00].
                            	  8284:     ;
02:0003BC60 702C            	  8285:     moveq   #44,D0
02:0003BC62 7600            	  8286:     moveq   #0,D3
02:0003BC64 41EC034F        	  8287:     lea     ($034F,A4),A0
02:0003BC68 16302000        	  8288:     move.b  (A0,D2.W),D3
02:0003BC6C 0C030025        	  8289:     cmpi.b  #$25,D3
02:0003BC70 6702            	  8290:     beq  _anon_z04_158
02:0003BC72 7018            	  8291:     moveq   #24,D0
                            	  8292: _anon_z04_158:
02:0003BC74 1880            	  8293:     move.b  D0,($0000,A4)
                            	  8294:     ; This location is right above Patra.
                            	  8295:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  8296:     ;
02:0003BC76 102C0085        	  8297:     move.b  ($0085,A4),D0
02:0003BC7A 003C0011        	  8298:     ori     #$11,CCR  ; SEC: set C+X
02:0003BC7E 1214            	  8299:     move.b  ($0000,A4),D1
02:0003BC80 0A3C0010        	  8300:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BC84 9101            	  8301:     subx.b  D1,D0   ; SBC $00
02:0003BC86 0A3C0010        	  8302:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BC8A 41EC0084        	  8303:     lea     ($0084,A4),A0
02:0003BC8E 11802000        	  8304:     move.b  D0,(A0,D2.W)
                            	  8305:     even
