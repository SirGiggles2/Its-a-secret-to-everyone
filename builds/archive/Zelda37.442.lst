                            	   527: __far_z_04_0000:
                            	   528:     ; If Link's X is aligned with the block's, then get the difference
                            	   529:     ; between Link's (Y + 3) and the block's Y.
                            	   530:     ; Then go test the difference.
                            	   531:     ;
02:000383A2 102C0070        	   532:     move.b  ($0070,A4),D0
02:000383A6 12342070        	   533:     move.b  ($70,A4,D2.W),D1
02:000383AA B001            	   534:     cmp.b   D1,D0
02:000383AC 6628            	   535:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:000383AE 7600            	   536:     moveq   #0,D3
02:000383B0 102C0084        	   537:     move.b  ($0084,A4),D0
02:000383B4 023C00EE        	   538:     andi    #$EE,CCR  ; CLC: clear C+X
02:000383B8 123C0003        	   539:     move.b  #$03,D1
02:000383BC D101            	   540:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000383BE 003C0011        	   541:     ori     #$11,CCR  ; SEC: set C+X
02:000383C2 41EC0084        	   542:     lea     ($0084,A4),A0
02:000383C6 12302000        	   543:     move.b  (A0,D2.W),D1
02:000383CA 0A3C0010        	   544:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000383CE 9101            	   545:     subx.b  D1,D0   ; SBC ObjY,X
02:000383D0 0A3C0010        	   546:     eori    #$10,CCR  ; restore X = 6502 C
02:000383D4 6034            	   547:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   548: 
