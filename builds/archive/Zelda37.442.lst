                            	  8931: Ganon_DrawBody:
                            	  8932:     ; Loop over four 16x16 images that make up Ganon.
                            	  8933:     ; There are 6 animation frames.
                            	  8934:     ;
02:0003C0F2 7603            	  8935:     moveq   #3,D3
                            	  8936:     even
                            	  8937: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8938:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8939:     ;
02:0003C0F4 10342070        	  8940:     move.b  ($70,A4,D2.W),D0
02:0003C0F8 023C00EE        	  8941:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C0FC 41F90003C0E6    	  8942:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C102 12303000        	  8943:     move.b  (A0,D3.W),D1
02:0003C106 D101            	  8944:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C108 1880            	  8945:     move.b  D0,($0000,A4)
                            	  8946:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8947:     ;
02:0003C10A 41EC0084        	  8948:     lea     ($0084,A4),A0
02:0003C10E 10302000        	  8949:     move.b  (A0,D2.W),D0
02:0003C112 023C00EE        	  8950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C116 41F90003C0EA    	  8951:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C11C 12303000        	  8952:     move.b  (A0,D3.W),D1
02:0003C120 D101            	  8953:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C122 19400001        	  8954:     move.b  D0,($0001,A4)
                            	  8955:     ; Each part has a horizontal flipping flag.
                            	  8956:     ;
02:0003C126 41F90003C0EE    	  8957:     lea     (GanonSpriteHFlips).l,A0
02:0003C12C 10303000        	  8958:     move.b  (A0,D3.W),D0
02:0003C130 1940000F        	  8959:     move.b  D0,($000F,A4)
                            	  8960:     ; Save and copy the loop index (the current part) to [07].
                            	  8961:     ;
02:0003C134 1003            	  8962:     move.b  D3,D0
02:0003C136 1B00            	  8963:     move.b  D0,-(A5)  ; PHA
02:0003C138 19400007        	  8964:     move.b  D0,($0007,A4)
                            	  8965:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8966:     ; that make it up.
                            	  8967:     ;
02:0003C13C 41EC046B        	  8968:     lea     ($046B,A4),A0
02:0003C140 10302000        	  8969:     move.b  (A0,D2.W),D0
02:0003C144 E308            	  8970:     lsl.b  #1,D0   ; ASL A
02:0003C146 E308            	  8971:     lsl.b  #1,D0   ; ASL A
                            	  8972:     ; Add [07] -- the index of the current part.
                            	  8973:     ;
                            	  8974:     ; Now you have an index into the frame image table, for the
                            	  8975:     ; current image part of the current animation frame.
                            	  8976:     ;
02:0003C148 122C0007        	  8977:     move.b  ($0007,A4),D1
02:0003C14C D101            	  8978:     addx.b  D1,D0   ; ADC $07
02:0003C14E 7600            	  8979:     moveq   #0,D3
02:0003C150 1600            	  8980:     move.b  D0,D3
02:0003C152 41F90003C0CE    	  8981:     lea     (GanonFrameImages).l,A0
02:0003C158 10303000        	  8982:     move.b  (A0,D3.W),D0
02:0003C15C 4EB900030D7A    	  8983:     jsr     DrawObjectNotMirrored
02:0003C162 101D            	  8984:     move.b  (A5)+,D0  ; PLA
                            	  8985:     ; Bottom of the part loop.
                            	  8986:     ;
02:0003C164 7600            	  8987:     moveq   #0,D3
02:0003C166 1600            	  8988:     move.b  D0,D3
02:0003C168 5303            	  8989:     subq.b  #1,D3
02:0003C16A 6A88            	  8990:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C16C 4E75            	  8991:     rts
