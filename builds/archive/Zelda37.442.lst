02:000383D6 102C0084        	   554:     move.b  ($0084,A4),D0
02:000383DA 023C00EE        	   555:     andi    #$EE,CCR  ; CLC: clear C+X
02:000383DE 123C0003        	   556:     move.b  #$03,D1
02:000383E2 D101            	   557:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000383E4 41EC0084        	   558:     lea     ($0084,A4),A0
02:000383E8 12302000        	   559:     move.b  (A0,D2.W),D1
02:000383EC B001            	   560:     cmp.b   D1,D0
