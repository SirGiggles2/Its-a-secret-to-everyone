02:0003BEFA 123C0008        	  8679:     move.b  #$08,D1
02:0003BEFE D101            	  8680:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BF00 41EC0084        	  8681:     lea     ($0084,A4),A0
