02:00033730 5303            	  2201:     subq.b  #1,D3
02:00033732 6AE8            	  2202:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033734 522C0420        	  2203:     addq.b  #1,($0420,A4)
                            	  2204:     even
                            	  2205: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2206:     ; At this point:
                            	  2207:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2208:     ;   - This will be changed as the player inputs characters.
                            	  2209:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2210:     ;   - This will be changed as the player inputs characters.
                            	  2211:     ; - InitializedNameField [$0420] is set to 1.
                            	  2212:     ;
02:00033738 102C00F8        	  2213:     move.b  ($00F8,A4),D0
02:0003373C 020000C0        	  2214:     andi.b #$C0,D0
02:00033740 670000E8        	  2215:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2216:     ; A or B was pressed.
                            	  2217:     ;
02:00033744 0C000040        	  2218:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033748 660000A6        	  2219:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2220:     ; A was pressed.
                            	  2221:     ;
                            	  2222:     ; Request to play the character click tune (same as bomb set).
02:0003374C 7620            	  2223:     moveq   #32,D3
02:0003374E 19430604        	  2224:     move.b  D3,($0604,A4)
02:00033752 7602            	  2225:     moveq   #2,D3
                            	  2226:     even
                            	  2227: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033754 41EC0422        	  2228:     lea     ($0422,A4),A0
02:00033758 10303000        	  2229:     move.b  (A0,D3.W),D0
02:0003375C 41EC0302        	  2230:     lea     ($0302,A4),A0
02:00033760 11803000        	  2231:     move.b  D0,(A0,D3.W)
02:00033764 5303            	  2232:     subq.b  #1,D3
02:00033766 6AEC            	  2233:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033768 19430306        	  2234:     move.b  D3,($0306,A4)
