                            	  2156: InitArmosOrFlyingGhini:
                            	  2157:     ; In UpdateObject, this object was flagged "initialized".
                            	  2158:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2159:     ;
02:00038F0C 10342028        	  2160:     move.b  ($28,A4,D2.W),D0
02:00038F10 41EC0492        	  2161:     lea     ($0492,A4),A0
02:00038F14 11802000        	  2162:     move.b  D0,(A0,D2.W)
                            	  2163:     ; If it's still fading in, then go finish some initialization needed
                            	  2164:     ; for fading in.
                            	  2165:     ;
02:00038F18 660000B6        	  2166:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2167:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2168:     ; go finish initializing it.
                            	  2169:     ;
02:00038F1C 41EC034F        	  2170:     lea     ($034F,A4),A0
02:00038F20 10302000        	  2171:     move.b  (A0,D2.W),D0
02:00038F24 0C000022        	  2172:     cmpi.b  #$22,D0
02:00038F28 670000A6        	  2173:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2174:     ; Else we have an armos.
                            	  2175:     ;
                            	  2176:     ; Store stairs tile $70 in [00] for use later.
                            	  2177:     ;
02:00038F2C 7070            	  2178:     moveq   #112,D0
02:00038F2E 1880            	  2179:     move.b  D0,($0000,A4)
                            	  2180:     ; Look for the current room ID in an array of room ID's that
                            	  2181:     ; have armos secrets.
                            	  2182:     ;
02:00038F30 7606            	  2183:     moveq   #6,D3
                            	  2184:     even
                            	  2185: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:00038F32 102C00EB        	  2186:     move.b  ($00EB,A4),D0
                            	  2187:     ; If this element does not match the current room ID, go loop again.
                            	  2188:     ;
02:00038F36 41F900038EFC    	  2189:     lea     (SecretArmosRoomIds).l,A0
02:00038F3C 12303000        	  2190:     move.b  (A0,D3.W),D1
02:00038F40 B001            	  2191:     cmp.b   D1,D0
02:00038F42 6648            	  2192:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2193:     ; The secret (usually stairs) is under one of the armoses.
                            	  2194:     ;
                            	  2195:     ; If the armos's X coordinate does not match the one needed
                            	  2196:     ; for the current room in the list, then go loop again.
                            	  2197:     ;
02:00038F44 10342070        	  2198:     move.b  ($70,A4,D2.W),D0
02:00038F48 41F900038F04    	  2199:     lea     (SecretArmosXs).l,A0
02:00038F4E 12303000        	  2200:     move.b  (A0,D3.W),D1
02:00038F52 B001            	  2201:     cmp.b   D1,D0
02:00038F54 6636            	  2202:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2203:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2204:     ;
02:00038F56 41EC0084        	  2205:     lea     ($0084,A4),A0
02:00038F5A 10302000        	  2206:     move.b  (A0,D2.W),D0
02:00038F5E 0C000080        	  2207:     cmpi.b  #$80,D0
02:00038F62 6628            	  2208:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2209:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2210:     ;
02:00038F64 4A03            	  2211:     cmpi.b  #$00,D3
02:00038F66 662C            	  2212:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2213:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2214:     ; has the power bracelet.
                            	  2215:     ;
                            	  2216:     ; Set up the room item with the armos's coordinates.
                            	  2217:     ;
02:00038F68 19400097        	  2218:     move.b  D0,($0097,A4)
02:00038F6C 10342070        	  2219:     move.b  ($70,A4,D2.W),D0
02:00038F70 19400083        	  2220:     move.b  D0,($0083,A4)
                            	  2221:     ; This resets the room item's state, which activates it.
                            	  2222:     ;
02:00038F74 194300BF        	  2223:     move.b  D3,($00BF,A4)
                            	  2224:     ; Set the room item ID.
                            	  2225:     ;
02:00038F78 7014            	  2226:     moveq   #20,D0
02:00038F7A 194000AB        	  2227:     move.b  D0,($00AB,A4)
                            	  2228:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2229:     ;
                            	  2230:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2231:     ;
                            	  2232:     ; Note that, if the item was already taken, then the room item
                            	  2233:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2234:     ; it will be ignored, because that routine checks whether
                            	  2235:     ; the item was taken.
                            	  2236:     ;
02:00038F7E 4EB900030AB2    	  2237:     jsr     GetRoomFlagUWItemState
02:00038F84 660A            	  2238:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00038F86 6100069A        	  2239:     jsr     PlaySecretFoundTune
02:00038F8A 6604            	  2240:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2241:     even
                            	  2242: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  2243:     ; Bottom of the loop.
                            	  2244:     ;
02:00038F8C 5303            	  2245:     subq.b  #1,D3
02:00038F8E 6AA2            	  2246:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  2247:     even
                            	  2248: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  2249:     ; Not found, or found the power bracelet.
                            	  2250:     ; Use a floor tile $26 to replace the armos.
                            	  2251:     ;
02:00038F90 7026            	  2252:     moveq   #38,D0
02:00038F92 1880            	  2253:     move.b  D0,($0000,A4)
                            	  2254:     even
                            	  2255: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:00038F94 1014            	  2256:     move.b  ($0000,A4),D0
                            	  2257:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  2258:     ;
02:00038F96 1B00            	  2259:     move.b  D0,-(A5)  ; PHA
02:00038F98 0C000070        	  2260:     cmpi.b  #$70,D0
02:00038F9C 6604            	  2261:     bne  _anon_z04_51
02:00038F9E 61000682        	  2262:     jsr     PlaySecretFoundTune
                            	  2263: _anon_z04_51:
                            	  2264:     ; Replace the tile where the armos was.
                            	  2265:     ;
02:00038FA2 522C00F7        	  2266:     addq.b  #1,($00F7,A4)
02:00038FA6 101D            	  2267:     move.b  (A5)+,D0  ; PLA
02:00038FA8 4EB900047518    	  2268:     jsr     ChangeTileObjTiles
                            	  2269:     ; Because the armos object is aligned to the square grid
                            	  2270:     ; (because it was made from a square),
                            	  2271:     ; set its grid offset to 3 to compensate.
                            	  2272:     ;
                            	  2273:     ; Most objects are aligned to the grid vertically when the
                            	  2274:     ; low nibble is $D.
                            	  2275:     ;
02:00038FAE 7003            	  2276:     moveq   #3,D0
02:00038FB0 41EC0394        	  2277:     lea     ($0394,A4),A0
02:00038FB4 11802000        	  2278:     move.b  D0,(A0,D2.W)
                            	  2279:     ; Set a speed (q-speed fraction) randomly:
                            	  2280:     ; $20 if random value < $80
                            	  2281:     ; $60 otherwise
                            	  2282:     ;
02:00038FB8 7020            	  2283:     moveq   #32,D0
02:00038FBA 7600            	  2284:     moveq   #0,D3
02:00038FBC 16342019        	  2285:     move.b  ($19,A4,D2.W),D3
02:00038FC0 0C030080        	  2286:     cmpi.b  #$80,D3
02:00038FC4 6502            	  2287:     bcs  _anon_z04_52
02:00038FC6 7060            	  2288:     moveq   #96,D0
