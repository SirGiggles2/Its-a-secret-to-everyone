                            	   950: 
                            	   951: ;------------------------------------------------------------------------------
                            	   952: ; _c_move_object_shim — MoveObject trampoline.
                            	   953: ;
                            	   954: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   955: ;   Input:     D2 = slot (0..11)
                            	   956: ;   Preserves: D2, A4, A5
                            	   957: ;   Clobbers:  D0, D1, D3, A0
                            	   958: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   959: ;
                            	   960: ; GCC side:
                            	   961: ;   void c_move_object(unsigned short slot);
                            	   962: ;     slot arrives as a 16-bit value on the stack.
                            	   963: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   964: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   965: ;   never clobbered by gcc.
                            	   966: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   967: ;   semantics can exist in a pure C port).
                            	   968: ;------------------------------------------------------------------------------
                            	   969: _c_move_object_shim:
                            	   970:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   971:     move.b  #$AA,($0900,A4)
                            	   972:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   973:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   974:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   975:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   976:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   977:     moveq   #0,D0
02:0002B658 3002            	   978:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   979:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   980:     jsr     c_move_object
02:0002B662 588F            	   981:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   982:     rts
                            	   983: 
                            	   984: ;==============================================================================
                            	   985: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   986: ; and tail-call the native asm function.
                            	   987: ;
                            	   988: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   989: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   990: ; sign-extended).
                            	   991: ;==============================================================================
                            	   992: 
                            	   993: ;------------------------------------------------------------------------------
                            	   994: ; void c_copy_bank_to_window(unsigned int bank);
                            	   995: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   996: ;------------------------------------------------------------------------------
                            	   997: c_copy_bank_to_window:
02:0002B666 202F0004        	   998:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   999:     jmp     _copy_bank_to_window
                            	  1000: 
                            	  1001: ;------------------------------------------------------------------------------
                            	  1002: ; unsigned char c_ppu_read_2(void);
                            	  1003: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	  1004: ; C return: gcc expects result in D0.
                            	  1005: ;------------------------------------------------------------------------------
                            	  1006: c_ppu_read_2:
02:0002B66E 4EF90000E034    	  1007:     jmp     _ppu_read_2
                            	  1008: 
                            	  1009: ;------------------------------------------------------------------------------
                            	  1010: ; void c_ppu_write_6(unsigned int val);
                            	  1011: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	  1012: ;------------------------------------------------------------------------------
                            	  1013: c_ppu_write_6:
02:0002B674 202F0004        	  1014:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	  1015:     jmp     _ppu_write_6
                            	  1016: 
                            	  1017: ;------------------------------------------------------------------------------
                            	  1018: ; void c_ppu_write_7(unsigned int val);
                            	  1019: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1020: ;------------------------------------------------------------------------------
                            	  1021: c_ppu_write_7:
02:0002B67E 202F0004        	  1022:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1023:     jmp     _ppu_write_7
                            	  1024: 
                            	  1025: ;------------------------------------------------------------------------------
                            	  1026: ; void c_turn_off_all_video(void);
                            	  1027: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1028: ;------------------------------------------------------------------------------
                            	  1029: c_turn_off_all_video:
02:0002B688 4EF900047112    	  1030:     jmp     TurnOffAllVideo
                            	  1031: 
                            	  1032: ;==============================================================================
                            	  1033: ; EXPORT side — z_03 entry point.
                            	  1034: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1035: ; the transpiler emits that label pointing to this shim instead of the
                            	  1036: ; z_03 asm body. The C function takes no args and returns void.
                            	  1037: ;==============================================================================
                            	  1038: 
                            	  1039: ;------------------------------------------------------------------------------
                            	  1040: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1041: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1042: ;------------------------------------------------------------------------------
                            	  1043: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1044:     jmp     z03_transfer_level_pattern_blocks
                            	  1045: 
                            	  1046: ;==============================================================================
                            	  1047: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1048: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1049: ;==============================================================================
