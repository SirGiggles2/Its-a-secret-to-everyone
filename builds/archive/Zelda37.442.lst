02:00048F68 10302000        	  6068:     move.b  (A0,D2.W),D0
02:00048F6C E308            	  6069:     lsl.b  #1,D0   ; ASL A
02:00048F6E 6404            	  6070:     bcc  _anon_z07_35
02:00048F70 163C00A0        	  6071:     move.b  #$A0,D3
                            	  6072: _anon_z07_35:
02:00048F74 1003            	  6073:     move.b  D3,D0
02:00048F76 41EC03BC        	  6074:     lea     ($03BC,A4),A0
02:00048F7A 11802000        	  6075:     move.b  D0,(A0,D2.W)
