                            	  3536: FindNextEdgeSpawnCell:
                            	  3537:     ; Load [0A] with the value before the call.
                            	  3538:     ;
02:0003E73A 102C0525        	  3539:     move.b  ($0525,A4),D0
02:0003E73E 1940000A        	  3540:     move.b  D0,($000A,A4)
                            	  3541:     even
                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:0003E742 7610            	  3549:     moveq   #16,D3
02:0003E744 102C000A        	  3550:     move.b  ($000A,A4),D0
02:0003E748 0200000F        	  3551:     andi.b #$0F,D0
02:0003E74C 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:0003E74E 163C00F0        	  3556:     move.b  #$F0,D3
02:0003E752 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:0003E756 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:0003E758 1003            	  3564:     move.b  D3,D0
02:0003E75A 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E75E 122C000A        	  3566:     move.b  ($000A,A4),D1
02:0003E762 D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:0003E764 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:0003E768 102C000A        	  3574:     move.b  ($000A,A4),D0
02:0003E76C 020000F0        	  3575:     andi.b #$F0,D0
02:0003E770 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:0003E774 6606            	  3577:     bne  _anon_z05_88
02:0003E776 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:0003E77A 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:0003E77C 0C000040        	  3585:     cmpi.b  #$40,D0
02:0003E780 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:0003E782 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
                            	  3594:     ; Starting at the top of the leftmost column.
                            	  3595:     ;
02:0003E786 61002590        	  3596:     jsr     FetchTileMapAddr
02:0003E78A 7005            	  3597:     moveq   #5,D0
02:0003E78C 4EB90002A9FA    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:0003E792 102C000A        	  3602:     move.b  ($000A,A4),D0
02:0003E796 0200000F        	  3603:     andi.b #$0F,D0
02:0003E79A 7600            	  3604:     moveq   #0,D3
02:0003E79C 1600            	  3605:     move.b  D0,D3
02:0003E79E 670C            	  3606:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3607: _anon_z05_89:
02:0003E7A0 702C            	  3608:     moveq   #44,D0
02:0003E7A2 4EB900030A2E    	  3609:     jsr     AddToInt16At0
02:0003E7A8 5303            	  3610:     subq.b  #1,D3
02:0003E7AA 66F4            	  3611:     bne  _anon_z05_89
                            	  3612:     even
                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:0003E7AC 102C000A        	  3617:     move.b  ($000A,A4),D0
02:0003E7B0 020000F0        	  3618:     andi.b #$F0,D0
02:0003E7B4 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7B8 123C0040        	  3620:     move.b  #$40,D1
02:0003E7BC 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7C0 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
