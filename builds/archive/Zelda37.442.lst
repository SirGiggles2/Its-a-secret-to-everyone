                            	  9139: Ganon_AppendPaletteRowTransferRecord_Triforce:
02:0003C276 7608            	  9140:     moveq   #8,D3
                            	  9141: _anon_z04_165:
02:0003C278 1003            	  9142:     move.b  D3,D0
02:0003C27A 1B00            	  9143:     move.b  D0,-(A5)  ; PHA
                            	  9144:     ; Get the length, to append to the dynamic transfer buf.
                            	  9145:     ;
02:0003C27C 7400            	  9146:     moveq   #0,D2
02:0003C27E 142C0301        	  9147:     move.b  ($0301,A4),D2
