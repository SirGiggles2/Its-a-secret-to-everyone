                            	  8567: Ganon_MoveAndShoot:
                            	  8568:     ; Change the animation frame every screen frame; so that
                            	  8569:     ; when Ganon is hit, he appears in a random pose.
                            	  8570:     ;
02:0003BE40 41EC046B        	  8571:     lea     ($046B,A4),A0
02:0003BE44 52302000        	  8572:     addq.b  #1,(A0,D2.W)
                            	  8573:     ; The animation cycle has 6 frames.
                            	  8574:     ;
02:0003BE48 41EC046B        	  8575:     lea     ($046B,A4),A0
02:0003BE4C 10302000        	  8576:     move.b  (A0,D2.W),D0
02:0003BE50 0C000006        	  8577:     cmpi.b  #$06,D0
02:0003BE54 660A            	  8578:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003BE56 7000            	  8579:     moveq   #0,D0
02:0003BE58 41EC046B        	  8580:     lea     ($046B,A4),A0
02:0003BE5C 11802000        	  8581:     move.b  D0,(A0,D2.W)
                            	  8582:     even
