                            	  9807: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	  9808:     ; Second, calculate a vertical component.
                            	  9809:     ; Combine it with the horizontal component:
                            	  9810:     ;
                            	  9811:     ; Y := 4 (down)
                            	  9812:     ; if observed player Y <> object Y then
                            	  9813:     ;   if observed player Y < object Y then
                            	  9814:     ;     Y := Y << 1   -- makes it 8 (up)
                            	  9815:     ;   [00] := [00] | Y
                            	  9816:     ;
02:0003C6D4 7601            	  9817:     moveq   #1,D3
02:0003C6D6 102C0062        	  9818:     move.b  ($0062,A4),D0
02:0003C6DA 41EC0084        	  9819:     lea     ($0084,A4),A0
02:0003C6DE 12302000        	  9820:     move.b  (A0,D2.W),D1
02:0003C6E2 B001            	  9821:     cmp.b   D1,D0
02:0003C6E4 6710            	  9822:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003C6E6 6402            	  9823:     bcc  _anon_z04_176
02:0003C6E8 5203            	  9824:     addq.b  #1,D3
