02:00038E16 7600            	  2019:     moveq   #0,D3
02:00038E18 41EC034F        	  2020:     lea     ($034F,A4),A0
02:00038E1C 16302000        	  2021:     move.b  (A0,D2.W),D3
02:00038E20 0C030009        	  2022:     cmpi.b  #$09,D3
02:00038E24 6402            	  2023:     bcc  _anon_z04_48
