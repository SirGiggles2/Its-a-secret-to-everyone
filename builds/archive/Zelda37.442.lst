02:00039E38 10302000        	  4312:     move.b  (A0,D2.W),D0
02:00039E3C 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039E40 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039E44 B001            	  4315:     cmp.b   D1,D0
02:00039E46 6704            	  4316:     beq.s  __far_z_04_0038
02:00039E48 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
02:00039E4C 41EC042C        	  4319:     lea     ($042C,A4),A0
02:00039E50 10302000        	  4320:     move.b  (A0,D2.W),D0
02:00039E54 41EC0444        	  4321:     lea     ($0444,A4),A0
02:00039E58 12302000        	  4322:     move.b  (A0,D2.W),D1
02:00039E5C B001            	  4323:     cmp.b   D1,D0
02:00039E5E 6704            	  4324:     beq.s  __far_z_04_0039
02:00039E60 60000086        	  4325:     jmp  L116EA_Exit
                            	  4326: __far_z_04_0039:
                            	  4327:     ; Set speed flag to 1 meaning decelerate.
                            	  4328:     ;
02:00039E64 41EC045E        	  4329:     lea     ($045E,A4),A0
02:00039E68 52302000        	  4330:     addq.b  #1,(A0,D2.W)
                            	  4331:     ; Go set target speed to $0040 (or $0140 if this is a child).
                            	  4332:     ;
02:00039E6C 7040            	  4333:     moveq   #64,D0
02:00039E6E 6052            	  4334:     jmp     SetTargetSpeed
                            	  4335: 
