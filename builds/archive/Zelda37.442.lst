                            	  8742:     ;
02:0003BF68 10342070        	  8743:     move.b  ($70,A4,D2.W),D0
02:0003BF6C 023C00EE        	  8744:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF70 123C0004        	  8745:     move.b  #$04,D1
02:0003BF74 D101            	  8746:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BF76 19803072        	  8747:     move.b  D0,($72,A4,D3.W)
02:0003BF7A 41EC0084        	  8748:     lea     ($0084,A4),A0
02:0003BF7E 10302000        	  8749:     move.b  (A0,D2.W),D0
02:0003BF82 123C0004        	  8750:     move.b  #$04,D1
02:0003BF86 D101            	  8751:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BF88 41EC0086        	  8752:     lea     ($0086,A4),A0
02:0003BF8C 11803000        	  8753:     move.b  D0,(A0,D3.W)
