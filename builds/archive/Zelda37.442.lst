                            	  7861:     ; At this point, Link_GoStraightWhenDiagInput is true.
                            	  7862:     ;
                            	  7863:     ;
                            	  7864:     ; 2. Link at top door.
                            	  7865:     ;
                            	  7866:     ; If Link's X <> $78 or Link's Y <> $5D then
                            	  7867:     ;   Go set object direction and input direction to object
                            	  7868:     ;   direction, and set Link's speed. Also, *SET*
                            	  7869:     ;   Link_GoStraightWhenDiagInput.
