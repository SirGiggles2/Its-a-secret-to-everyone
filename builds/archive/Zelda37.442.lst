02:00048ACE 0C000030        	  5446:     cmpi.b  #$30,D0
02:00048AD2 6656            	  5447:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5448:     ; State $3x. Slow down.
                            	  5449:     ;
                            	  5450:     ; Reset grid offset for movement.
