                            	  7115:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7116:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7117:     ; that does not spawn with a cloud (type >= $53);
                            	  7118:     ; 
                            	  7119:     ; then go initialize the object.
                            	  7120:     ;
02:00049796 102C0010        	  7121:     move.b  ($0010,A4),D0
02:0004979A 66000196        	  7122:     bne  _L_z07_InitObject_NormalSpawn
02:0004979E 102C04CD        	  7123:     move.b  ($04CD,A4),D0
02:000497A2 02000008        	  7124:     andi.b #$08,D0
02:000497A6 6700018A        	  7125:     beq  _L_z07_InitObject_NormalSpawn
02:000497AA 41EC034F        	  7126:     lea     ($034F,A4),A0
02:000497AE 10302000        	  7127:     move.b  (A0,D2.W),D0
02:000497B2 0C000011        	  7128:     cmpi.b  #$11,D0
02:000497B6 6700017A        	  7129:     beq  _L_z07_InitObject_NormalSpawn
02:000497BA 0C000040        	  7130:     cmpi.b  #$40,D0
02:000497BE 67000172        	  7131:     beq  _L_z07_InitObject_NormalSpawn
02:000497C2 0C00001E        	  7132:     cmpi.b  #$1E,D0
02:000497C6 6700016A        	  7133:     beq  _L_z07_InitObject_NormalSpawn
02:000497CA 0C00002E        	  7134:     cmpi.b  #$2E,D0
02:000497CE 67000162        	  7135:     beq  _L_z07_InitObject_NormalSpawn
02:000497D2 0C000053        	  7136:     cmpi.b  #$53,D0
02:000497D6 6400015A        	  7137:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7138:     even
                            	  7139: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7140:     ; If the "monsters from edges" long timer expired, then
                            	  7141:     ; go bring the monster in.
                            	  7142:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7143:     ;
                            	  7144:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7145:     ; residual position so enemies keep their previous-room
                            	  7146:     ; positions instead of being re-edge-spawned (matches NES).
02:000497DA 102C004B        	  7147:     move.b  ($004B,A4),D0
02:000497DE 662E            	  7148:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7149:     ; timer == 0. Check for fresh room-entry + residual position.
02:000497E0 102C000F        	  7150:     move.b  ($000F,A4),D0
02:000497E4 0C0000FF        	  7151:     cmpi.b  #$FF,D0
02:000497E8 662E            	  7152:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:000497EA 41EC0070        	  7153:     lea     ($0070,A4),A0
02:000497EE 10302000        	  7154:     move.b  (A0,D2.W),D0
02:000497F2 660A            	  7155:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:000497F4 41EC0084        	  7156:     lea     ($0084,A4),A0
02:000497F8 10302000        	  7157:     move.b  (A0,D2.W),D0
02:000497FC 671A            	  7158:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7159:     even
                            	  7160: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:000497FE 7001            	  7161:     moveq   #1,D0
02:00049800 1940004B        	  7162:     move.b  D0,($004B,A4)
02:00049804 41EC0492        	  7163:     lea     ($0492,A4),A0
02:00049808 11802000        	  7164:     move.b  D0,(A0,D2.W)
02:0004980C 4E75            	  7165:     rts
                            	  7166:     even
                            	  7167: _L_z07_InitObject_UninitMonsterFromEdge_Gate:
02:0004980E 41EC0492        	  7168:     lea     ($0492,A4),A0
