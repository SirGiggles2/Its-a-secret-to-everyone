02:0003BE6A 6100EB40        	  8589:     jsr     BlueWizzrobe_TurnSometimesAndMoveAndCheckTile
                            	  8590:     ; Shoot every $40 frames.
                            	  8591:     ;
02:0003BE6E 102C0015        	  8592:     move.b  ($0015,A4),D0
