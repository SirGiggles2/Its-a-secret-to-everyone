02:00038438 41EC0412        	   614:     lea     ($0412,A4),A0
02:0003843C 16302000        	   615:     move.b  (A0,D2.W),D3
02:00038440 0C030010        	   616:     cmpi.b  #$10,D3
02:00038444 6402            	   617:     bcc.s  __far_z_04_0004
02:00038446 6028            	   618:     jmp  L10262_Exit
