                            	  7795: _anon_z05_174:
                            	  7796:     ; Two input directions, and at least one of them is walkable.
                            	  7797:     ;
                            	  7798:     ; Make Link go straight in one direction on the next grid line.
                            	  7799:     ;
02:00041538 7600            	  7800:     moveq   #0,D3
02:0004153A 1600            	  7801:     move.b  D0,D3
02:0004153C 522C0057        	  7802:     addq.b  #1,($0057,A4)
                            	  7803:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7804:     ; object direction and input direction to last walkable direction
                            	  7805:     ; found, and set Link's speed.
                            	  7806:     ;
                            	  7807:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7808:     ;
02:00041540 7400            	  7809:     moveq   #0,D2
02:00041542 102C000D        	  7810:     move.b  ($000D,A4),D0
02:00041546 0C030001        	  7811:     cmpi.b  #$01,D3
02:0004154A 67000096        	  7812:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:0004154E 7600            	  7813:     moveq   #0,D3
02:00041550 162C0010        	  7814:     move.b  ($0010,A4),D3
02:00041554 6700008C        	  7815:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7816:     ; In UW. There are two input directions, and they're both walkable.
                            	  7817:     ;
                            	  7818:     ; Normally, turn to the direction that's perpendicular to object
                            	  7819:     ; direction. But keep going straight after that, while diagonal
                            	  7820:     ; input is held.
                            	  7821:     ;
                            	  7822:     ; Handle special cases for doors.
                            	  7823:     ;
                            	  7824:     ;
                            	  7825:     ; 1. Link at horizontal doors.
                            	  7826:     ;
                            	  7827:     ; If Link's X = $20 or $D0 then
                            	  7828:     ;   If Link's Y = $85 and facing down then
                            	  7829:     ;     Go set object direction and input direction to object
                            	  7830:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7831:     ;     Link_GoStraightWhenDiagInput.
                            	  7832:     ;   Else
                            	  7833:     ;     Go turn to the perpendicular direction
                            	  7834:     ;
02:00041558 7600            	  7835:     moveq   #0,D3
02:0004155A 162C0070        	  7836:     move.b  ($0070,A4),D3
02:0004155E 0C030020        	  7837:     cmpi.b  #$20,D3
02:00041562 6706            	  7838:     beq  _anon_z05_175
02:00041564 0C0300D0        	  7839:     cmpi.b  #$D0,D3
02:00041568 661C            	  7840:     bne  _anon_z05_176
                            	  7841: _anon_z05_175:
02:0004156A 7600            	  7842:     moveq   #0,D3
02:0004156C 162C0084        	  7843:     move.b  ($0084,A4),D3
02:00041570 0C030085        	  7844:     cmpi.b  #$85,D3
02:00041574 6642            	  7845:     bne  _anon_z05_177
02:00041576 102C0098        	  7846:     move.b  ($0098,A4),D0
02:0004157A 02000004        	  7847:     andi.b #$04,D0
02:0004157E 6738            	  7848:     beq  _anon_z05_177
                            	  7849:     even
