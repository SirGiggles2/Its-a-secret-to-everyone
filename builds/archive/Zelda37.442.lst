02:000487D0 123C0001        	  4995:     move.b  #$01,D1
02:000487D4 D101            	  4996:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000487D6 19803000        	  4997:     move.b  D0,($00,A4,D3.W)
                            	  4998:     ; Restore the loop index, decrement it, and loop again if >= 0.
