02:0003C028 6100FF7E        	  8830:     jsr     Ganon_DrawCloud
02:0003C02C 6100009A        	  8831:     jsr     Ganon_GetCurCloudBottom
02:0003C030 6100FF76        	  8832:     jsr     Ganon_DrawCloud
                            	  8833:     ; Draw the left and right clouds.
                            	  8834:     ;
02:0003C034 61000080        	  8835:     jsr     Ganon_GetCurCloudLeft
02:0003C038 41EC0084        	  8836:     lea     ($0084,A4),A0
02:0003C03C 10302000        	  8837:     move.b  (A0,D2.W),D0
02:0003C040 19400001        	  8838:     move.b  D0,($0001,A4)
02:0003C044 6100FF62        	  8839:     jsr     Ganon_DrawCloud
02:0003C048 6172            	  8840:     jsr     Ganon_GetCurCloudRight
02:0003C04A 6100FF5C        	  8841:     jsr     Ganon_DrawCloud
                            	  8842:     ; Save the object index.
                            	  8843:     ;
02:0003C04E 102C0340        	  8844:     move.b  ($0340,A4),D0
02:0003C052 1B00            	  8845:     move.b  D0,-(A5)  ; PHA
                            	  8846:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8847:     ;
02:0003C054 7402            	  8848:     moveq   #2,D2
                            	  8849:     even
                            	  8850: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003C056 19420340        	  8851:     move.b  D2,($0340,A4)
                            	  8852:     ; If object slot < 5 or = 7, then move every frame.
                            	  8853:     ; Else move 3 out of every 4 frames.
                            	  8854:     ;
                            	  8855:     ; This makes pieces spread out in somewhat of a circle,
                            	  8856:     ; by making the pieces at cardinal directions move at
                            	  8857:     ; full speed while the diagonal ones move a little slower.
                            	  8858:     ;
02:0003C05A 0C020005        	  8859:     cmpi.b  #$05,D2
02:0003C05E 6510            	  8860:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003C060 0C020007        	  8861:     cmpi.b  #$07,D2
02:0003C064 670A            	  8862:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003C066 102C0015        	  8863:     move.b  ($0015,A4),D0
02:0003C06A 02000003        	  8864:     andi.b #$03,D0
02:0003C06E 6704            	  8865:     beq  _anon_z04_164
                            	  8866:     even
                            	  8867: _L_z04_Ganon_DrawBurst_Move:
02:0003C070 6100EA32        	  8868:     jsr     BlueWizzrobe_Move
                            	  8869: _anon_z04_164:
02:0003C074 4EB9000493DC    	  8870:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8871:     ; The frame counter will make the sprite flash.
                            	  8872:     ; The array has the horizontal and vertical flipping attributes.
                            	  8873:     ; Combine them into [03].
                            	  8874:     ;
02:0003C07A 102C0015        	  8875:     move.b  ($0015,A4),D0
02:0003C07E 02000003        	  8876:     andi.b #$03,D0
02:0003C082 41F90003BF52    	  8877:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C088 12302000        	  8878:     move.b  (A0,D2.W),D1
02:0003C08C 8001            	  8879:     or.b  D1,D0
02:0003C08E 19400003        	  8880:     move.b  D0,($0003,A4)
02:0003C092 41F90003BF5C    	  8881:     lea     (GanonBurstTiles).l,A0
02:0003C098 10302000        	  8882:     move.b  (A0,D2.W),D0
02:0003C09C 4EB900031076    	  8883:     jsr     Anim_WriteSprite
                            	  8884:     ; Bottom of the loop.
                            	  8885:     ; Increment object slot while <= 9.
                            	  8886:     ;
02:0003C0A2 5202            	  8887:     addq.b  #1,D2
02:0003C0A4 0C02000A        	  8888:     cmpi.b  #$0A,D2
02:0003C0A8 65AC            	  8889:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8890:     ; Restore the object index.
                            	  8891:     ;
02:0003C0AA 101D            	  8892:     move.b  (A5)+,D0  ; PLA
02:0003C0AC 19400340        	  8893:     move.b  D0,($0340,A4)
02:0003C0B0 0A3C0001        	  8894:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C0B4 4E75            	  8895:     rts
                            	  8896: 
