                            	  7256: _anon_z05_156:
02:000411BE 101D            	  7257:     move.b  (A5)+,D0  ; PLA
                            	  7258:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7259:     ; then the player walked all the way to the edge of the play
                            	  7260:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7261:     ;
                            	  7262:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7263:     ; edge of the play area. So, set a relative position that
                            	  7264:     ; reflects that distance: $28 or -$28.
                            	  7265:     ;
                            	  7266:     ; If walking in a decreasing direction (left or up), then
                            	  7267:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7268:     ;
                            	  7269:     ; If walking in an increasing direction (right or down), then
                            	  7270:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7271:     ;
02:000411C0 02000007        	  7272:     andi.b #$07,D0
02:000411C4 0C000002        	  7273:     cmpi.b  #$02,D0
