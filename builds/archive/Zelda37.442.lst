02:0003BD2A 611C            	  8379:     jsr     PatraChild_Draw
                            	  8380:     ; If Patra's state still = 0, then the last patra child has not
                            	  8381:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  8382:     ;
02:0003BD2C 102C00AD        	  8383:     move.b  ($00AD,A4),D0
02:0003BD30 6714            	  8384:     beq  _L_z04_PatraChild_State1_Exit
02:0003BD32 4EB9000310E6    	  8385:     jsr     CheckMonsterCollisions
                            	  8386:     ; If the monster died, then change to the dead dummy object.
                            	  8387:     ;
02:0003BD38 41EC0405        	  8388:     lea     ($0405,A4),A0
02:0003BD3C 10302000        	  8389:     move.b  (A0,D2.W),D0
02:0003BD40 6704            	  8390:     beq  _L_z04_PatraChild_State1_Exit
02:0003BD42 6100FCCC        	  8391:     jsr     SetDeadDummyObjType
                            	  8392:     even
