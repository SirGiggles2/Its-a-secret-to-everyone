02:000338F6 123C0008        	  2425:     move.b  #$08,D1
02:000338FA 0A3C0010        	  2426:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338FE 9101            	  2427:     subx.b  D1,D0   ; SBC #$08
02:00033900 0A3C0010        	  2428:     eori    #$10,CCR  ; restore X = 6502 C
02:00033904 7600            	  2429:     moveq   #0,D3
02:00033906 1600            	  2430:     move.b  D0,D3
