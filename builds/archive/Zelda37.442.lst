02:00039A8A 41EC0485        	  3760:     lea     ($0485,A4),A0
02:00039A8E 11802000        	  3761:     move.b  D0,(A0,D2.W)
02:00039A92 610005F4        	  3762:     jsr     CheckBossHitReaction
