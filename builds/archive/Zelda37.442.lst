02:0003BD46 4E75            	  8394:     rts
                            	  8395: 
                            	  8396:     even
                            	  8397: PatraChild_Draw:
02:0003BD48 4EB90003106A    	  8398:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
                            	  8399:     ; 2 was returned from the routine above in A.
                            	  8400:     ; Pass it as the animation counter value to the routine below.
                            	  8401:     ;
02:0003BD4E 4EB9000493D6    	  8402:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003BD54 41EC03E4        	  8403:     lea     ($03E4,A4),A0
02:0003BD58 10302000        	  8404:     move.b  (A0,D2.W),D0
02:0003BD5C 4EF900030D7A    	  8405:     jmp     DrawObjectNotMirrored
