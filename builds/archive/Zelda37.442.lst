02:0003CB5A 522C00E1        	   289:     addq.b  #1,($00E1,A4)
02:0003CB5E 0A3C0001        	   290:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003CB62 4E75            	   291:     rts
