02:00048FA0 102C0529        	  6111:     move.b  ($0529,A4),D0
02:00048FA4 662A            	  6112:     bne  _L_z07_MakeSwordShot_SetUp
                            	  6113:     ; If full hearts <> (heart containers - 1), return.
