                            	  6167:     ; Add grid offset after the move to the original.
                            	  6168:     ; This makes it continuous, and useful as a distance traveled.
                            	  6169:     ;
02:00049014 023C00EE        	  6170:     andi    #$EE,CCR  ; CLC: clear C+X
