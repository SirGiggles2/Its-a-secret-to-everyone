02:0004738E 122C0004        	  2083:     move.b  ($0004,A4),D1
02:00047392 D101            	  2084:     addx.b  D1,D0   ; ADC $04
02:00047394 4A02            	  2085:     cmpi.b  #$00,D2
02:00047396 66E4            	  2086:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00047398 0C000002        	  2087:     cmpi.b  #$02,D0
02:0004739C 66DE            	  2088:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004739E 7620            	  2089:     moveq   #32,D3
