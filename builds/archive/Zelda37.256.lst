                            	  1903: 
                            	  1904:     even
                            	  1905: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1906:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1907:     ; then this trap definitely wasn't triggered.
                            	  1908:     ; Go draw and check collisions.
                            	  1909:     ;
02:00030264 102C0070        	  1910:     move.b  ($0070,A4),D0
02:00030268 003C0011        	  1911:     ori     #$11,CCR  ; SEC: set C+X
02:0003026C 12342070        	  1912:     move.b  ($70,A4,D2.W),D1
02:00030270 0A3C0010        	  1913:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030274 9101            	  1914:     subx.b  D1,D0   ; SBC ObjX,X
02:00030276 0A3C0010        	  1915:     eori    #$10,CCR  ; restore X = 6502 C
02:0003027A 61000614        	  1916:     jsr     Abs
02:0003027E 0C00000E        	  1917:     cmpi.b  #$0E,D0
02:00030282 64DC            	  1918:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1919:     ; Determine the vertical direction toward Link;
                            	  1920:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1921:     ; along this axis. Go draw and check object collisions.
                            	  1922:     ;
02:00030284 7604            	  1923:     moveq   #4,D3
02:00030286 102C0084        	  1924:     move.b  ($0084,A4),D0
02:0003028A 41EC0084        	  1925:     lea     ($0084,A4),A0
02:0003028E 12302000        	  1926:     move.b  (A0,D2.W),D1
02:00030292 B001            	  1927:     cmp.b   D1,D0
02:00030294 67CA            	  1928:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:00030296 6402            	  1929:     bcc  _anon_z01_27
02:00030298 7608            	  1930:     moveq   #8,D3
                            	  1931: _anon_z01_27:
                            	  1932:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1933:     ; set the vertical direction we determined, and other preparations.
                            	  1934:     ;
02:0003029A 41EC0084        	  1935:     lea     ($0084,A4),A0
02:0003029E 10302000        	  1936:     move.b  (A0,D2.W),D0
02:000302A2 668A            	  1937:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1938:     even
                            	  1939: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1940:     ; State 1 and 2.
                            	  1941:     ;
                            	  1942:     ; Move in the direction it's facing.
                            	  1943:     ;
02:000302A4 41EC0098        	  1944:     lea     ($0098,A4),A0
02:000302A8 10302000        	  1945:     move.b  (A0,D2.W),D0
02:000302AC 1940000F        	  1946:     move.b  D0,($000F,A4)
02:000302B0 4EB90004B10E    	  1947:     jsr     MoveObject
                            	  1948:     ; Truncate the grid offset to square length ($10).
                            	  1949:     ;
02:000302B6 41EC0394        	  1950:     lea     ($0394,A4),A0
02:000302BA 10302000        	  1951:     move.b  (A0,D2.W),D0
02:000302BE 0200000F        	  1952:     andi.b #$0F,D0
02:000302C2 6608            	  1953:     bne  _anon_z01_28
02:000302C4 41EC0394        	  1954:     lea     ($0394,A4),A0
02:000302C8 11802000        	  1955:     move.b  D0,(A0,D2.W)
                            	  1956: _anon_z01_28:
                            	  1957:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1958:     ;
02:000302CC 61001530        	  1959:     jsr     CheckLinkCollision
                            	  1960:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1961:     ; and current coordinate to the trap's X.
