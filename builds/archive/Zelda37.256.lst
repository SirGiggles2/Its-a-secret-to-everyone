                            	  6251: Digdogger_Move:
                            	  6252:     ; This calculation is the same one used in Manhandla to
                            	  6253:     ; manifest the fractional speed over several frames.
                            	  6254:     ;
                            	  6255:     ; To summarize, the formula is:
                            	  6256:     ;
                            	  6257:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6258:     ;
                            	  6259:     ;   SA := SA + (SL AND $E0)
                            	  6260:     ;   [03] := SH + carry
                            	  6261:     ;
                            	  6262:     ; See 04:A28E Manhandla_Move.
                            	  6263:     ;
02:0003BED6 41EC041F        	  6264:     lea     ($041F,A4),A0
02:0003BEDA 10302000        	  6265:     move.b  (A0,D2.W),D0
02:0003BEDE 020000E0        	  6266:     andi.b #$E0,D0
02:0003BEE2 023C00EE        	  6267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BEE6 41EC0412        	  6268:     lea     ($0412,A4),A0
02:0003BEEA 12302000        	  6269:     move.b  (A0,D2.W),D1
02:0003BEEE D101            	  6270:     addx.b  D1,D0   ; ADC $0412,X
02:0003BEF0 41EC0412        	  6271:     lea     ($0412,A4),A0
02:0003BEF4 11802000        	  6272:     move.b  D0,(A0,D2.W)
                            	  6273:     ; Assign (high speed byte + carry) to [03].
                            	  6274:     ;
02:0003BEF8 41EC042C        	  6275:     lea     ($042C,A4),A0
02:0003BEFC 10302000        	  6276:     move.b  (A0,D2.W),D0
02:0003BF00 123C0000        	  6277:     move.b  #$00,D1
02:0003BF04 D101            	  6278:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003BF06 19400003        	  6279:     move.b  D0,($0003,A4)
                            	  6280:     ; Change coordinates by the speed amount/offset in [03]
                            	  6281:     ; according to the direction.
                            	  6282:     ;
                            	  6283:     ; Start with a mask of $A1 in [02]:
                            	  6284:     ; - low nibble represents the right direction
                            	  6285:     ; - high nibble is used to set or clear carry as we go along
                            	  6286:     ;
02:0003BF0A 103C00A1        	  6287:     move.b  #$A1,D0
02:0003BF0E 19400002        	  6288:     move.b  D0,($0002,A4)
                            	  6289:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6290:     ;
02:0003BF12 41EC0098        	  6291:     lea     ($0098,A4),A0
02:0003BF16 10302000        	  6292:     move.b  (A0,D2.W),D0
02:0003BF1A 122C0002        	  6293:     move.b  ($0002,A4),D1
02:0003BF1E C200            	  6294:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BF20 6712            	  6295:     beq  _L_z04_Digdogger_Move_Left
02:0003BF22 10342070        	  6296:     move.b  ($70,A4,D2.W),D0
02:0003BF26 023C00EE        	  6297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF2A 122C0003        	  6298:     move.b  ($0003,A4),D1
02:0003BF2E D101            	  6299:     addx.b  D1,D0   ; ADC $03
02:0003BF30 19802070        	  6300:     move.b  D0,($70,A4,D2.W)
                            	  6301:     even
                            	  6302: _L_z04_Digdogger_Move_Left:
                            	  6303:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6304:     ;
02:0003BF34 41EC0098        	  6305:     lea     ($0098,A4),A0
02:0003BF38 10302000        	  6306:     move.b  (A0,D2.W),D0
02:0003BF3C 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003BF40 E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003BF42 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003BF46 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003BF4A C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BF4C 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
02:0003BF4E 10342070        	  6313:     move.b  ($70,A4,D2.W),D0
02:0003BF52 122C0003        	  6314:     move.b  ($0003,A4),D1
02:0003BF56 0A3C0010        	  6315:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BF5A 9101            	  6316:     subx.b  D1,D0   ; SBC $03
02:0003BF5C 0A3C0010        	  6317:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BF60 19802070        	  6318:     move.b  D0,($70,A4,D2.W)
                            	  6319:     even
                            	  6320: _L_z04_Digdogger_Move_Down:
                            	  6321:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6322:     ;
02:0003BF64 41EC0098        	  6323:     lea     ($0098,A4),A0
02:0003BF68 10302000        	  6324:     move.b  (A0,D2.W),D0
02:0003BF6C 122C0002        	  6325:     move.b  ($0002,A4),D1
02:0003BF70 E309            	  6326:     lsl.b  #1,D1   ; ASL $02
02:0003BF72 19410002        	  6327:     move.b  D1,($0002,A4)
02:0003BF76 122C0002        	  6328:     move.b  ($0002,A4),D1
02:0003BF7A C200            	  6329:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BF7C 6716            	  6330:     beq  _L_z04_Digdogger_Move_Up
02:0003BF7E 41EC0084        	  6331:     lea     ($0084,A4),A0
02:0003BF82 10302000        	  6332:     move.b  (A0,D2.W),D0
02:0003BF86 122C0003        	  6333:     move.b  ($0003,A4),D1
02:0003BF8A D101            	  6334:     addx.b  D1,D0   ; ADC $03
02:0003BF8C 41EC0084        	  6335:     lea     ($0084,A4),A0
02:0003BF90 11802000        	  6336:     move.b  D0,(A0,D2.W)
                            	  6337:     even
                            	  6338: _L_z04_Digdogger_Move_Up:
                            	  6339:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6340:     ;
02:0003BF94 41EC0098        	  6341:     lea     ($0098,A4),A0
02:0003BF98 10302000        	  6342:     move.b  (A0,D2.W),D0
02:0003BF9C 122C0002        	  6343:     move.b  ($0002,A4),D1
02:0003BFA0 E309            	  6344:     lsl.b  #1,D1   ; ASL $02
02:0003BFA2 19410002        	  6345:     move.b  D1,($0002,A4)
02:0003BFA6 122C0002        	  6346:     move.b  ($0002,A4),D1
02:0003BFAA C200            	  6347:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BFAC 671E            	  6348:     beq  _L_z04_Digdogger_Move_End
02:0003BFAE 41EC0084        	  6349:     lea     ($0084,A4),A0
02:0003BFB2 10302000        	  6350:     move.b  (A0,D2.W),D0
02:0003BFB6 122C0003        	  6351:     move.b  ($0003,A4),D1
02:0003BFBA 0A3C0010        	  6352:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BFBE 9101            	  6353:     subx.b  D1,D0   ; SBC $03
02:0003BFC0 0A3C0010        	  6354:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BFC4 41EC0084        	  6355:     lea     ($0084,A4),A0
02:0003BFC8 11802000        	  6356:     move.b  D0,(A0,D2.W)
                            	  6357:     even
