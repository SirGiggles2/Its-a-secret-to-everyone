                            	  1191: _L_z04_UpdateFireball_Move:
                            	  1192:     ; A movement routine is used that works along one axis.
                            	  1193:     ; So, load its parameters, and call it for each axis individually.
                            	  1194:     ;
                            	  1195:     ; First, load the horizontal direction into [0F].
                            	  1196:     ;
02:00039AEE 41EC0412        	  1197:     lea     ($0412,A4),A0
02:00039AF2 10302000        	  1198:     move.b  (A0,D2.W),D0
02:00039AF6 1940000F        	  1199:     move.b  D0,($000F,A4)
                            	  1200:     ; Load the horizontal q-speed and position fraction,
                            	  1201:     ; move, then save the position fraction.
                            	  1202:     ;
02:00039AFA 41EC041F        	  1203:     lea     ($041F,A4),A0
02:00039AFE 10302000        	  1204:     move.b  (A0,D2.W),D0
02:00039B02 7600            	  1205:     moveq   #0,D3
02:00039B04 41EC0451        	  1206:     lea     ($0451,A4),A0
02:00039B08 16302000        	  1207:     move.b  (A0,D2.W),D3
02:00039B0C 613E            	  1208:     jsr     Fireball_MoveOneAxis
02:00039B0E 41EC0451        	  1209:     lea     ($0451,A4),A0
02:00039B12 11802000        	  1210:     move.b  D0,(A0,D2.W)
                            	  1211:     ; Second, load the vertical direction into [0F].
                            	  1212:     ;
02:00039B16 41EC0437        	  1213:     lea     ($0437,A4),A0
02:00039B1A 10302000        	  1214:     move.b  (A0,D2.W),D0
02:00039B1E 1940000F        	  1215:     move.b  D0,($000F,A4)
                            	  1216:     ; Load the vertical q-speed and position fraction,
                            	  1217:     ; move, then save the position fraction.
                            	  1218:     ;
02:00039B22 41EC0444        	  1219:     lea     ($0444,A4),A0
02:00039B26 10302000        	  1220:     move.b  (A0,D2.W),D0
02:00039B2A 7600            	  1221:     moveq   #0,D3
02:00039B2C 41EC045E        	  1222:     lea     ($045E,A4),A0
02:00039B30 16302000        	  1223:     move.b  (A0,D2.W),D3
