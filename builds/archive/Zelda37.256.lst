                            	  3452:     ; Shoot a flying rock (object type $53).
                            	  3453:     ;
02:0003AACA 7653            	  3454:     moveq   #83,D3
02:0003AACC 6100F706        	  3455:     jsr     _TryShooting
02:0003AAD0 4EB90004C486    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:0003AAD6 41EC0098        	  3459:     lea     ($0098,A4),A0
02:0003AADA 10302000        	  3460:     move.b  (A0,D2.W),D0
02:0003AADE 7600            	  3461:     moveq   #0,D3
02:0003AAE0 1600            	  3462:     move.b  D0,D3
02:0003AAE2 0200000C        	  3463:     andi.b #$0C,D0
02:0003AAE6 670C            	  3464:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AAE8 7002            	  3465:     moveq   #2,D0
02:0003AAEA 0C030008        	  3466:     cmpi.b  #$08,D3
02:0003AAEE 6610            	  3467:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3468:     ; Else facing up. Use frame image offset 1.
                            	  3469:     ;
02:0003AAF0 7001            	  3470:     moveq   #1,D0
02:0003AAF2 660C            	  3471:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3472:     even
                            	  3473: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  3474:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  3475:     ;
02:0003AAF4 0C030001        	  3476:     cmpi.b  #$01,D3
02:0003AAF8 6604            	  3477:     bne  _anon_z04_49
02:0003AAFA 522C000F        	  3478:     addq.b  #1,($000F,A4)
                            	  3479: _anon_z04_49:
                            	  3480:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  3481:     ;
02:0003AAFE 7000            	  3482:     moveq   #0,D0
                            	  3483:     even
                            	  3484: _L_z04_UpdateOctorock_SaveOffset:
02:0003AB00 1B00            	  3485:     move.b  D0,-(A5)  ; PHA
                            	  3486:     ; Decrement the animation counter, and roll over if needed.
                            	  3487:     ;
02:0003AB02 41EC03D0        	  3488:     lea     ($03D0,A4),A0
02:0003AB06 53302000        	  3489:     subq.b  #1,(A0,D2.W)
02:0003AB0A 661E            	  3490:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003AB0C 7006            	  3491:     moveq   #6,D0
02:0003AB0E 41EC03D0        	  3492:     lea     ($03D0,A4),A0
02:0003AB12 11802000        	  3493:     move.b  D0,(A0,D2.W)
                            	  3494:     ; There are actually 6 frame images divided into 2 sets.
                            	  3495:     ; Each set depicts one animation frame. In each set there are
                            	  3496:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3497:     ;
                            	  3498:     ; The movement frame will keep track of the base offset of
                            	  3499:     ; the current set for the current animation frame: 0 or 3.
                            	  3500:     ;
                            	  3501:     ; So, XOR the movement frame with 3.
                            	  3502:     ;
02:0003AB16 E208            	  3503:     lsr.b  #1,D0   ; LSR A
02:0003AB18 41EC03E4        	  3504:     lea     ($03E4,A4),A0
02:0003AB1C 12302000        	  3505:     move.b  (A0,D2.W),D1
02:0003AB20 B300            	  3506:     eor.b  D1,D0
02:0003AB22 41EC03E4        	  3507:     lea     ($03E4,A4),A0
02:0003AB26 11802000        	  3508:     move.b  D0,(A0,D2.W)
                            	  3509:     even
                            	  3510: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3511:     ; Add the base offset and the directional offset, and save the result.
                            	  3512:     ;
02:0003AB2A 101D            	  3513:     move.b  (A5)+,D0  ; PLA
02:0003AB2C 023C00EE        	  3514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB30 41EC03E4        	  3515:     lea     ($03E4,A4),A0
02:0003AB34 12302000        	  3516:     move.b  (A0,D2.W),D1
02:0003AB38 D101            	  3517:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AB3A 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
                            	  3519:     ; If facing vertically, go draw mirrored.
                            	  3520:     ;
02:0003AB3C 41EC0098        	  3521:     lea     ($0098,A4),A0
02:0003AB40 10302000        	  3522:     move.b  (A0,D2.W),D0
02:0003AB44 0200000C        	  3523:     andi.b #$0C,D0
02:0003AB48 660E            	  3524:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3525:     ; Else draw not mirrored.
                            	  3526:     ;
02:0003AB4A 101D            	  3527:     move.b  (A5)+,D0  ; PLA
02:0003AB4C 4EB900031338    	  3528:     jsr     DrawObjectNotMirrored
02:0003AB52 4EF9000316B4    	  3529:     jmp     CheckMonsterCollisions
                            	  3530: 
                            	  3531:     even
                            	  3532: _L_z04_UpdateOctorock_DrawMirrored:
02:0003AB58 101D            	  3533:     move.b  (A5)+,D0  ; PLA
                            	  3534: ; Params:
                            	  3535: ; A: frame image
                            	  3536: ; X: object index
                            	  3537: ; [00]: object X
                            	  3538: ; [01]: object Y
                            	  3539: ;
                            	  3540:     even
                            	  3541: DrawObjectMirroredAndCheckCollisions:
02:0003AB5A 4EB900031334    	  3542:     jsr     DrawObjectMirrored
02:0003AB60 4EF9000316B4    	  3543:     jmp     CheckMonsterCollisions
                            	  3544: 
                            	  3545:     even
                            	  3546: UpdateGhini:
02:0003AB66 103C00FF        	  3547:     move.b  #$FF,D0
02:0003AB6A 6100E864        	  3548:     jsr     UpdateCommonWanderer
02:0003AB6E 6130            	  3549:     jsr     DrawGhiniAndCheckCollisions
02:0003AB70 4EB9000316B4    	  3550:     jsr     CheckMonsterCollisions
                            	  3551:     ; If the monster is still alive, then return.
                            	  3552:     ;
02:0003AB76 41EC0405        	  3553:     lea     ($0405,A4),A0
02:0003AB7A 10302000        	  3554:     move.b  (A0,D2.W),D0
02:0003AB7E 671E            	  3555:     beq  _L_z04_UpdateGhini_Exit
                            	  3556:     ; For each object slot from $B to 1:
                            	  3557:     ; If the object is a flying ghini ($22),
                            	  3558:     ; then kill it by setting metastate to $11.
                            	  3559:     ;
02:0003AB80 760B            	  3560:     moveq   #11,D3
                            	  3561:     even
                            	  3562: _L_z04_UpdateGhini_LoopObject:
02:0003AB82 41EC034F        	  3563:     lea     ($034F,A4),A0
02:0003AB86 10303000        	  3564:     move.b  (A0,D3.W),D0
02:0003AB8A 0C000022        	  3565:     cmpi.b  #$22,D0
02:0003AB8E 660A            	  3566:     bne  _anon_z04_50
02:0003AB90 7011            	  3567:     moveq   #17,D0
02:0003AB92 41EC0405        	  3568:     lea     ($0405,A4),A0
02:0003AB96 11803000        	  3569:     move.b  D0,(A0,D3.W)
                            	  3570: _anon_z04_50:
02:0003AB9A 5303            	  3571:     subq.b  #1,D3
02:0003AB9C 66E4            	  3572:     bne  _L_z04_UpdateGhini_LoopObject
                            	  3573:     even
                            	  3574: _L_z04_UpdateGhini_Exit:
02:0003AB9E 4E75            	  3575:     rts
                            	  3576: 
                            	  3577:     even
                            	  3578: DrawGhiniAndCheckCollisions:
02:0003ABA0 4EB90004C486    	  3579:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003ABA6 1940000D        	  3580:     move.b  D0,($000D,A4)
                            	  3581:     ; If the direction has an "up" component, then keep the
                            	  3582:     ; frame image 0, and go figure out horizontal flipping.
                            	  3583:     ;
02:0003ABAA 41EC0098        	  3584:     lea     ($0098,A4),A0
02:0003ABAE 10302000        	  3585:     move.b  (A0,D2.W),D0
02:0003ABB2 02000008        	  3586:     andi.b #$08,D0
02:0003ABB6 6614            	  3587:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3588:     ; Else make the frame image 1 for the "down" frame.
                            	  3589:     ; Note that this is the frame image to use, even if there's no
                            	  3590:     ; down component in the direction.
                            	  3591:     ;
02:0003ABB8 522C000D        	  3592:     addq.b  #1,($000D,A4)
                            	  3593:     ; If right is a component of the direction, then go set horizontal
                            	  3594:     ; flipping. Else leave horizontal flipping = 0.
                            	  3595:     ;
02:0003ABBC 41EC0098        	  3596:     lea     ($0098,A4),A0
02:0003ABC0 10302000        	  3597:     move.b  (A0,D2.W),D0
02:0003ABC4 02000001        	  3598:     andi.b #$01,D0
02:0003ABC8 6714            	  3599:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003ABCA 660E            	  3600:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3601:     even
                            	  3602: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3603:     ; Set horizontal flipping if right is a direction component.
                            	  3604:     ; This essentially the same test as above, but for when we jump
                            	  3605:     ; from the "up" test.
                            	  3606:     ;
02:0003ABCC 41EC0098        	  3607:     lea     ($0098,A4),A0
02:0003ABD0 10302000        	  3608:     move.b  (A0,D2.W),D0
02:0003ABD4 02000002        	  3609:     andi.b #$02,D0
02:0003ABD8 6704            	  3610:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3611:     even
                            	  3612: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003ABDA 522C000F        	  3613:     addq.b  #1,($000F,A4)
                            	  3614:     even
                            	  3615: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003ABDE 102C000D        	  3616:     move.b  ($000D,A4),D0
                            	  3617: ; Params:
                            	  3618: ; A: frame image
                            	  3619: ; X: object index
                            	  3620: ; [00]: object X
                            	  3621: ; [01]: object Y
                            	  3622: ; [0F]: flip horizontally
                            	  3623: ;
                            	  3624: ; Returns:
                            	  3625: ; [00]: 0 for Link slot
                            	  3626: ; [06]: 1 if objects collide
                            	  3627: ; [09]: 0 for Link damage type (none)
                            	  3628: ; [0C]: 1 if objects collide
                            	  3629: ; [034B]: ShotCollidesWithLink
                            	  3630: ;
                            	  3631:     even
                            	  3632: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003ABE2 4EB900031338    	  3633:     jsr     DrawObjectNotMirrored
02:0003ABE8 4EF9000317FE    	  3634:     jmp     CheckLinkCollision
                            	  3635: 
                            	  3636:     even
                            	  3637: SecretArmosRoomIds:
02:0003ABEE 24              	  3638:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003ABEF 0B
02:0003ABF0 1C
02:0003ABF1 22
02:0003ABF2 34
02:0003ABF3 3D
02:0003ABF4 4E
                            	  3639: 
                            	  3640:     even
                            	  3641: SecretArmosXs:
02:0003ABF6 E0              	  3642:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003ABF7 B0
02:0003ABF8 B0
02:0003ABF9 30
02:0003ABFA 40
02:0003ABFB 90
02:0003ABFC A0
                            	  3643: 
                            	  3644:     even
                            	  3645: InitArmosOrFlyingGhini:
                            	  3646:     ; In UpdateObject, this object was flagged "initialized".
                            	  3647:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3648:     ;
02:0003ABFE 10342028        	  3649:     move.b  ($28,A4,D2.W),D0
02:0003AC02 41EC0492        	  3650:     lea     ($0492,A4),A0
02:0003AC06 11802000        	  3651:     move.b  D0,(A0,D2.W)
                            	  3652:     ; If it's still fading in, then go finish some initialization needed
                            	  3653:     ; for fading in.
                            	  3654:     ;
02:0003AC0A 660000B6        	  3655:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3656:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3657:     ; go finish initializing it.
                            	  3658:     ;
02:0003AC0E 41EC034F        	  3659:     lea     ($034F,A4),A0
02:0003AC12 10302000        	  3660:     move.b  (A0,D2.W),D0
02:0003AC16 0C000022        	  3661:     cmpi.b  #$22,D0
02:0003AC1A 670000A6        	  3662:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3663:     ; Else we have an armos.
                            	  3664:     ;
                            	  3665:     ; Store stairs tile $70 in [00] for use later.
                            	  3666:     ;
02:0003AC1E 7070            	  3667:     moveq   #112,D0
02:0003AC20 1880            	  3668:     move.b  D0,($0000,A4)
                            	  3669:     ; Look for the current room ID in an array of room ID's that
                            	  3670:     ; have armos secrets.
                            	  3671:     ;
02:0003AC22 7606            	  3672:     moveq   #6,D3
                            	  3673:     even
                            	  3674: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003AC24 102C00EB        	  3675:     move.b  ($00EB,A4),D0
                            	  3676:     ; If this element does not match the current room ID, go loop again.
                            	  3677:     ;
02:0003AC28 41F90003ABEE    	  3678:     lea     (SecretArmosRoomIds).l,A0
02:0003AC2E 12303000        	  3679:     move.b  (A0,D3.W),D1
02:0003AC32 B001            	  3680:     cmp.b   D1,D0
02:0003AC34 6648            	  3681:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3682:     ; The secret (usually stairs) is under one of the armoses.
                            	  3683:     ;
                            	  3684:     ; If the armos's X coordinate does not match the one needed
                            	  3685:     ; for the current room in the list, then go loop again.
                            	  3686:     ;
02:0003AC36 10342070        	  3687:     move.b  ($70,A4,D2.W),D0
02:0003AC3A 41F90003ABF6    	  3688:     lea     (SecretArmosXs).l,A0
02:0003AC40 12303000        	  3689:     move.b  (A0,D3.W),D1
02:0003AC44 B001            	  3690:     cmp.b   D1,D0
02:0003AC46 6636            	  3691:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3692:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3693:     ;
02:0003AC48 41EC0084        	  3694:     lea     ($0084,A4),A0
02:0003AC4C 10302000        	  3695:     move.b  (A0,D2.W),D0
02:0003AC50 0C000080        	  3696:     cmpi.b  #$80,D0
02:0003AC54 6628            	  3697:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3698:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3699:     ;
02:0003AC56 4A03            	  3700:     cmpi.b  #$00,D3
02:0003AC58 662C            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3702:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3703:     ; has the power bracelet.
                            	  3704:     ;
                            	  3705:     ; Set up the room item with the armos's coordinates.
                            	  3706:     ;
02:0003AC5A 19400097        	  3707:     move.b  D0,($0097,A4)
02:0003AC5E 10342070        	  3708:     move.b  ($70,A4,D2.W),D0
02:0003AC62 19400083        	  3709:     move.b  D0,($0083,A4)
                            	  3710:     ; This resets the room item's state, which activates it.
                            	  3711:     ;
02:0003AC66 194300BF        	  3712:     move.b  D3,($00BF,A4)
                            	  3713:     ; Set the room item ID.
                            	  3714:     ;
02:0003AC6A 7014            	  3715:     moveq   #20,D0
02:0003AC6C 194000AB        	  3716:     move.b  D0,($00AB,A4)
                            	  3717:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3718:     ;
                            	  3719:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3720:     ;
                            	  3721:     ; Note that, if the item was already taken, then the room item
                            	  3722:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3723:     ; it will be ignored, because that routine checks whether
                            	  3724:     ; the item was taken.
                            	  3725:     ;
02:0003AC70 4EB900030D8A    	  3726:     jsr     GetRoomFlagUWItemState
02:0003AC76 660A            	  3727:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003AC78 6100069E        	  3728:     jsr     PlaySecretFoundTune
02:0003AC7C 6604            	  3729:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3730:     even
                            	  3731: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3732:     ; Bottom of the loop.
                            	  3733:     ;
02:0003AC7E 5303            	  3734:     subq.b  #1,D3
02:0003AC80 6AA2            	  3735:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3736:     even
                            	  3737: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3738:     ; Not found, or found the power bracelet.
                            	  3739:     ; Use a floor tile $26 to replace the armos.
                            	  3740:     ;
02:0003AC82 7026            	  3741:     moveq   #38,D0
02:0003AC84 1880            	  3742:     move.b  D0,($0000,A4)
                            	  3743:     even
                            	  3744: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003AC86 1014            	  3745:     move.b  ($0000,A4),D0
                            	  3746:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3747:     ;
02:0003AC88 1B00            	  3748:     move.b  D0,-(A5)  ; PHA
02:0003AC8A 0C000070        	  3749:     cmpi.b  #$70,D0
02:0003AC8E 6604            	  3750:     bne  _anon_z04_51
02:0003AC90 61000686        	  3751:     jsr     PlaySecretFoundTune
                            	  3752: _anon_z04_51:
                            	  3753:     ; Replace the tile where the armos was.
                            	  3754:     ;
02:0003AC94 522C00F7        	  3755:     addq.b  #1,($00F7,A4)
02:0003AC98 101D            	  3756:     move.b  (A5)+,D0  ; PLA
02:0003AC9A 4EB90004A4E8    	  3757:     jsr     ChangeTileObjTiles
                            	  3758:     ; Because the armos object is aligned to the square grid
                            	  3759:     ; (because it was made from a square),
                            	  3760:     ; set its grid offset to 3 to compensate.
                            	  3761:     ;
                            	  3762:     ; Most objects are aligned to the grid vertically when the
                            	  3763:     ; low nibble is $D.
                            	  3764:     ;
02:0003ACA0 7003            	  3765:     moveq   #3,D0
02:0003ACA2 41EC0394        	  3766:     lea     ($0394,A4),A0
02:0003ACA6 11802000        	  3767:     move.b  D0,(A0,D2.W)
                            	  3768:     ; Set a speed (q-speed fraction) randomly:
                            	  3769:     ; $20 if random value < $80
                            	  3770:     ; $60 otherwise
                            	  3771:     ;
02:0003ACAA 7020            	  3772:     moveq   #32,D0
02:0003ACAC 7600            	  3773:     moveq   #0,D3
02:0003ACAE 16342019        	  3774:     move.b  ($19,A4,D2.W),D3
02:0003ACB2 0C030080        	  3775:     cmpi.b  #$80,D3
02:0003ACB6 6502            	  3776:     bcs  _anon_z04_52
02:0003ACB8 7060            	  3777:     moveq   #96,D0
                            	  3778: _anon_z04_52:
02:0003ACBA 41EC03BC        	  3779:     lea     ($03BC,A4),A0
02:0003ACBE 11802000        	  3780:     move.b  D0,(A0,D2.W)
                            	  3781:     even
                            	  3782: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3783:     ; Facing and input directions down.
                            	  3784:     ;
02:0003ACC2 7004            	  3785:     moveq   #4,D0
02:0003ACC4 41EC03F8        	  3786:     lea     ($03F8,A4),A0
02:0003ACC8 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:0003ACCC 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003ACD0 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
                            	  3791:     ;
02:0003ACD4 10342028        	  3792:     move.b  ($28,A4,D2.W),D0
02:0003ACD8 E208            	  3793:     lsr.b  #1,D0   ; LSR A
02:0003ACDA 6512            	  3794:     bcs  _anon_z04_53
                            	  3795:     ; Finish initializing based on type.
                            	  3796:     ;
02:0003ACDC 41EC034F        	  3797:     lea     ($034F,A4),A0
02:0003ACE0 10302000        	  3798:     move.b  (A0,D2.W),D0
