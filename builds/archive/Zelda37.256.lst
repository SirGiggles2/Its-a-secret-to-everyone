02:0003EB88 6100A7F0        	 12293:     jsr     PlayBossHitCryIfNeeded
                            	 12294:     ; Go handle the brown state specially.
                            	 12295:     ;
02:0003EB8C 41EC00AC        	 12296:     lea     ($00AC,A4),A0
02:0003EB90 10302000        	 12297:     move.b  (A0,D2.W),D0
02:0003EB94 6702            	 12298:     beq.s  __far_z_04_0119
02:0003EB96 6058            	 12299:     jmp  Ganon_UpdateBrownState
                            	 12300: __far_z_04_0119:
                            	 12301:     ; State = 0: Blue
                            	 12302:     ;
                            	 12303:     ; If timer = 0, then go move around and shoot.
                            	 12304:     ;
