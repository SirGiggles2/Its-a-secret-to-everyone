                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003D860 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003D864 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003D868 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003D86A 103C0080        	  9707:     move.b  #$80,D0
02:0003D86E 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003D872 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003D876 103C00C0        	  9710:     move.b  #$C0,D0
02:0003D87A 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003D87E 8001            	  9712:     or.b  D1,D0
02:0003D880 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003D884 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
