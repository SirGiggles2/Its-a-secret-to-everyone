02:0003C8A8 10302000        	  7641:     move.b  (A0,D2.W),D0
02:0003C8AC 0A00000C        	  7642:     eori.b #$0C,D0
02:0003C8B0 41EC0098        	  7643:     lea     ($0098,A4),A0
