02:0003B5E2 19400070        	  5056:     move.b  D0,($0070,A4)
02:0003B5E6 41EC0084        	  5057:     lea     ($0084,A4),A0
02:0003B5EA 10302000        	  5058:     move.b  (A0,D2.W),D0
02:0003B5EE 19400084        	  5059:     move.b  D0,($0084,A4)
02:0003B5F2 4EB90004B39A    	  5060:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003B5F8 4EB90003062E    	  5061:     jsr     ShowLinkSpritesBehindHorizontalDoors
