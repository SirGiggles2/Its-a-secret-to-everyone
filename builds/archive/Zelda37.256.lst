02:0004145A 4EB900030618    	  3345:     jsr     CheckPersonBlocking
02:00041460 101D            	  3346:     move.b  (A5)+,D0  ; PLA
                            	  3347:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3348:     ;
02:00041462 0C00000C        	  3349:     cmpi.b  #$0C,D0
02:00041466 6704            	  3350:     beq.s  __far_z_05_0059
02:00041468 60000082        	  3351:     jmp  CheckCaveEdge
                            	  3352: __far_z_05_0059:
                            	  3353:     ; In a shortcut cave (mode $C).
                            	  3354:     ;
                            	  3355:     ; If grid offset <> 0, return.
