                            	  2591:     even
                            	  2592: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2593:     ; If reversal count >= 2, then
                            	  2594:     ; 1. invert the horizontal component of facing direction,
                            	  2595:     ;    to face away from the chase target
                            	  2596:     ; 2. reset the reversal count to 0.
                            	  2597:     ;
                            	  2598:     ; This prevents a jumper from getting stuck in a corner.
                            	  2599:     ;
                            	  2600:     ; For example, if a tektite's direction is down and right,
                            	  2601:     ; and jumps into the top right corner of the room:
                            	  2602:     ; 1. The right room boundary is hit. So the direction is
                            	  2603:     ;    automatically reversed to up and left.
                            	  2604:     ; 2. The next frame, the top room boundary is hit.
                            	  2605:     ;    The direction is reversed to down and right.
                            	  2606:     ;
                            	  2607:     ; As you can see, an endless loop has been made.
                            	  2608:     ;
02:0003A444 41EC0451        	  2609:     lea     ($0451,A4),A0
02:0003A448 10302000        	  2610:     move.b  (A0,D2.W),D0
02:0003A44C 0C000002        	  2611:     cmpi.b  #$02,D0
02:0003A450 651E            	  2612:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A452 41EC0098        	  2613:     lea     ($0098,A4),A0
02:0003A456 10302000        	  2614:     move.b  (A0,D2.W),D0
02:0003A45A 0A000003        	  2615:     eori.b #$03,D0
02:0003A45E 41EC0098        	  2616:     lea     ($0098,A4),A0
02:0003A462 11802000        	  2617:     move.b  D0,(A0,D2.W)
02:0003A466 7000            	  2618:     moveq   #0,D0
02:0003A468 41EC0451        	  2619:     lea     ($0451,A4),A0
02:0003A46C 11802000        	  2620:     move.b  D0,(A0,D2.W)
                            	  2621:     even
                            	  2622: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2623:     ; If the object is a boulder, then make sure its facing direction
                            	  2624:     ; has a down vertical component.
                            	  2625:     ;
02:0003A470 610001F8        	  2626:     jsr     Jumper_PointBoulderDownward
                            	  2627:     ; For the given direction, get the Y offset of the destination
                            	  2628:     ; of the jump.
                            	  2629:     ;
                            	  2630:     ; Add it to the object's Y, and store this destination Y.
                            	  2631:     ;
02:0003A474 7600            	  2632:     moveq   #0,D3
02:0003A476 41EC0098        	  2633:     lea     ($0098,A4),A0
02:0003A47A 16302000        	  2634:     move.b  (A0,D2.W),D3
02:0003A47E 41EC0084        	  2635:     lea     ($0084,A4),A0
02:0003A482 10302000        	  2636:     move.b  (A0,D2.W),D0
02:0003A486 023C00EE        	  2637:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A48A 41F90003A3A2    	  2638:     lea     (JumperYOffsets).l,A0
02:0003A490 12303000        	  2639:     move.b  (A0,D3.W),D1
02:0003A494 D101            	  2640:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A496 41EC0444        	  2641:     lea     ($0444,A4),A0
02:0003A49A 11802000        	  2642:     move.b  D0,(A0,D2.W)
                            	  2643:     ; Set the starting speed, depending on the object type.
                            	  2644:     ;
02:0003A49E 610001A0        	  2645:     jsr     Jumper_GetKind
02:0003A4A2 41F90003A3CC    	  2646:     lea     (JumperStartSpeedsHi).l,A0
02:0003A4A8 10303000        	  2647:     move.b  (A0,D3.W),D0
02:0003A4AC 41EC0412        	  2648:     lea     ($0412,A4),A0
02:0003A4B0 11802000        	  2649:     move.b  D0,(A0,D2.W)
                            	  2650:     ; Reset the vertical speed low byte.
                            	  2651:     ; Then go animate, draw, and check collisions.
                            	  2652:     ;
02:0003A4B4 6100022E        	  2653:     jsr     Jumper_ResetVSpeedFrac
                            	  2654:     even
