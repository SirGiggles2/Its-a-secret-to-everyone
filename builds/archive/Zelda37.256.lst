02:0003DCF0 61000140        	 10275:     jsr     Gleeok_CalcSegmentLimits
                            	 10276:     ; Keep segments within the third tier distance of each other.
                            	 10277:     ; Any segment that is too far from the previous one is moved
                            	 10278:     ; 2 pixels toward it.
                            	 10279:     ;
                            	 10280:     ; Loop over the 4 segments above the base, from 0 to 3,
                            	 10281:     ; accessing slots 2 to 5.
                            	 10282:     ;
02:0003DCF4 7400            	 10283:     moveq   #0,D2
                            	 10284:     even
