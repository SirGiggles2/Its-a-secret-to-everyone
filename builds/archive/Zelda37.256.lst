                            	  1180: ; Params:
                            	  1181: ; A: Y coordinate
                            	  1182: ; X: object index
                            	  1183: ;
                            	  1184:     even
                            	  1185: InitWhirlwind:
02:0002FD74 6000BED4        	  1186:     jmp     c_init_whirlwind
                            	  1187: 
                            	  1188: SetUpWhirlwind:
02:0002FD78 6000BC80        	  1189:     jmp     c_set_up_whirlwind
                            	  1190: 
                            	  1191: WhirlwindPrevRoomIdList:
02:0002FD7C 36              	  1192:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FD7D 3B
02:0002FD7E 73
02:0002FD7F 44
02:0002FD80 0A
02:0002FD81 21
02:0002FD82 41
02:0002FD83 6C
                            	  1193: 
                            	  1194:     even
                            	  1195: UpdateWhirlwind_Full:
                            	  1196:     ; Get Link's halted state.
                            	  1197:     ;
02:0002FD84 102C00AC        	  1198:     move.b  ($00AC,A4),D0
02:0002FD88 02000040        	  1199:     andi.b #$40,D0
02:0002FD8C 7600            	  1200:     moveq   #0,D3
02:0002FD8E 1600            	  1201:     move.b  D0,D3
                            	  1202:     ; Add 2 to whirlwind X.
                            	  1203:     ;
02:0002FD90 7002            	  1204:     moveq   #2,D0
02:0002FD92 023C00EE        	  1205:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FD96 12342070        	  1206:     move.b  ($70,A4,D2.W),D1
02:0002FD9A D101            	  1207:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FD9C 19802070        	  1208:     move.b  D0,($70,A4,D2.W)
                            	  1209:     ; If Link is not halted or teleporting state = 0, then
                            	  1210:     ; go check for collision with Link.
                            	  1211:     ;
02:0002FDA0 0C030040        	  1212:     cmpi.b  #$40,D3
02:0002FDA4 6638            	  1213:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FDA6 7600            	  1214:     moveq   #0,D3
02:0002FDA8 162C0522        	  1215:     move.b  ($0522,A4),D3
02:0002FDAC 6730            	  1216:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1217:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1218:     ;
                            	  1219:     ; Set Link's X to whirlwind's.
                            	  1220:     ;
02:0002FDAE 19400070        	  1221:     move.b  D0,($0070,A4)
                            	  1222:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1223:     ; the right screen edge and draw.
                            	  1224:     ;
02:0002FDB2 5303            	  1225:     subq.b  #1,D3
02:0002FDB4 6776            	  1226:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FDB6 0C000080        	  1227:     cmpi.b  #$80,D0
02:0002FDBA 6670            	  1228:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1229:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1230:     ;
                            	  1231:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1232:     ;
02:0002FDBC E308            	  1233:     lsl.b  #1,D0   ; ASL A
02:0002FDBE 194000AC        	  1234:     move.b  D0,($00AC,A4)
02:0002FDC2 19400522        	  1235:     move.b  D0,($0522,A4)
02:0002FDC6 41EC034F        	  1236:     lea     ($034F,A4),A0
02:0002FDCA 11802000        	  1237:     move.b  D0,(A0,D2.W)
                            	  1238:     ; Update the player position marker, and draw one last time.
                            	  1239:     ;
02:0002FDCE 1002            	  1240:     move.b  D2,D0
02:0002FDD0 1B00            	  1241:     move.b  D0,-(A5)  ; PHA
02:0002FDD2 61000DFA        	  1242:     jsr     UpdatePlayerPositionMarker
02:0002FDD6 101D            	  1243:     move.b  (A5)+,D0  ; PLA
02:0002FDD8 7400            	  1244:     moveq   #0,D2
02:0002FDDA 1400            	  1245:     move.b  D0,D2
02:0002FDDC 6070            	  1246:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1247: 
                            	  1248:     even
                            	  1249: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1250:     ; Link is not halted or teleporting state = 0.
                            	  1251:     ; Try to pick up Link.
                            	  1252:     ;
                            	  1253:     ; If the whirlwind does not collide with Link, then go check
                            	  1254:     ; for the screen's right edge.
                            	  1255:     ;
02:0002FDDE 61001A1E        	  1256:     jsr     CheckLinkCollision
02:0002FDE2 102C0006        	  1257:     move.b  ($0006,A4),D0
02:0002FDE6 6744            	  1258:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1259:     ; Collided with Link.
                            	  1260:     ;
                            	  1261:     ; Make Link face right. Reset shove info and subroom type.
                            	  1262:     ;
02:0002FDE8 7001            	  1263:     moveq   #1,D0
02:0002FDEA 19400098        	  1264:     move.b  D0,($0098,A4)
02:0002FDEE E208            	  1265:     lsr.b  #1,D0   ; LSR A
02:0002FDF0 194000C0        	  1266:     move.b  D0,($00C0,A4)
02:0002FDF4 194000D3        	  1267:     move.b  D0,($00D3,A4)
02:0002FDF8 1940005A        	  1268:     move.b  D0,($005A,A4)
                            	  1269:     ; Halt Link (state $40), and hide him.
                            	  1270:     ;
02:0002FDFC 7040            	  1271:     moveq   #64,D0
02:0002FDFE 194000AC        	  1272:     move.b  D0,($00AC,A4)
02:0002FE02 103C00F8        	  1273:     move.b  #$F8,D0
02:0002FE06 19400248        	  1274:     move.b  D0,($0248,A4)
02:0002FE0A 1940024C        	  1275:     move.b  D0,($024C,A4)
                            	  1276:     ; Find and set the room that will behave as the previous room
                            	  1277:     ; when scrolling right to the room with the level's entrance.
                            	  1278:     ;
02:0002FE0E 102C0523        	  1279:     move.b  ($0523,A4),D0
02:0002FE12 02000007        	  1280:     andi.b #$07,D0
02:0002FE16 7600            	  1281:     moveq   #0,D3
02:0002FE18 1600            	  1282:     move.b  D0,D3
02:0002FE1A 41F90002FD7C    	  1283:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FE20 10303000        	  1284:     move.b  (A0,D3.W),D0
02:0002FE24 194000EA        	  1285:     move.b  D0,($00EA,A4)
                            	  1286:     ; Set teleporting state 1.
                            	  1287:     ;
02:0002FE28 522C0522        	  1288:     addq.b  #1,($0522,A4)
                            	  1289:     even
                            	  1290: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1291:     ; If whirlwind's X < $F0, go draw.
                            	  1292:     ;
02:0002FE2C 10342070        	  1293:     move.b  ($70,A4,D2.W),D0
02:0002FE30 0C0000F0        	  1294:     cmpi.b  #$F0,D0
02:0002FE34 6518            	  1295:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1296:     ; The whirlwind has reached the right edge of the screen.
                            	  1297:     ;
                            	  1298:     ; Destroy the object.
                            	  1299:     ;
02:0002FE36 611A            	  1300:     jsr     DestroyWhirlwind
                            	  1301:     ; If teleporting state <> 0, we picked up Link.
                            	  1302:     ; So, go to the next mode.
                            	  1303:     ;
                            	  1304:     ; Either way, draw one last time.
