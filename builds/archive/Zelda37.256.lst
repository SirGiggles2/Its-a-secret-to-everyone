02:000313CC 4A02            	  4316:     cmpi.b  #$00,D2
02:000313CE 6722            	  4317:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:000313D0 0C02000D        	  4318:     cmpi.b  #$0D,D2
