02:000418E4 41F9000418A6    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:000418EA 12303000        	  4032:     move.b  (A0,D3.W),D1
02:000418EE B001            	  4033:     cmp.b   D1,D0
