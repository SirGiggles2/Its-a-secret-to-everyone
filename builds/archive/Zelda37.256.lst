                            	  4943: __far_z_07_0075:
                            	  4944:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4945:     ; unused, so it only has to depend on having an empty slot.
                            	  4946:     ;
                            	  4947:     ; If successful, Link's state will have been changed to "using item".
                            	  4948:     ; But we don't want that in this case.
                            	  4949:     ;
                            	  4950:     ; For both these reasons, save state and restore it afterward.
                            	  4951:     ;
02:0004B6FE 102C00AC        	  4952:     move.b  ($00AC,A4),D0
02:0004B702 1B00            	  4953:     move.b  D0,-(A5)  ; PHA
02:0004B704 102C0513        	  4954:     move.b  ($0513,A4),D0
02:0004B708 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004B70A 7000            	  4956:     moveq   #0,D0
02:0004B70C 19400513        	  4957:     move.b  D0,($0513,A4)
02:0004B710 4EB900030AD6    	  4958:     jsr     WieldCandle
02:0004B716 101D            	  4959:     move.b  (A5)+,D0  ; PLA
02:0004B718 19400513        	  4960:     move.b  D0,($0513,A4)
02:0004B71C 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004B71E 194000AC        	  4962:     move.b  D0,($00AC,A4)
                            	  4963:     ; State $21 means that a moving fire was just made.
                            	  4964:     ;
