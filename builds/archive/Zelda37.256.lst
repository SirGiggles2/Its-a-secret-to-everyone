                            	  4227: _anon_z01_75:
02:0003133A 1943000C        	  4228:     move.b  D3,($000C,A4)
                            	  4229:     ; Set animation index = object type + 1.
                            	  4230:     ;
02:0003133E 7600            	  4231:     moveq   #0,D3
02:00031340 41EC034F        	  4232:     lea     ($034F,A4),A0
02:00031344 16302000        	  4233:     move.b  (A0,D2.W),D3
                            	  4234: ; Params:
                            	  4235: ; A: frame
                            	  4236: ; X: object index/cycle sprite index
                            	  4237: ; Y: object type
                            	  4238: ; [00]: object X
                            	  4239: ; [01]: object Y
                            	  4240: ; [0C]: mirrored
                            	  4241: ; [0F]: flip horizontally
                            	  4242: ;
                            	  4243: ; Note:
                            	  4244: ; If the object is not mirrored, then it's horizontally flippable.
                            	  4245: ;
                            	  4246: ; The animation index of most objects is (object type + 1),
                            	  4247: ; to make up for the fact that Link uses two animation indexes.
                            	  4248: ;
                            	  4249:     even
                            	  4250: DrawObjectWithType:
02:00031348 5203            	  4251:     addq.b  #1,D3
                            	  4252: ; Params:
                            	  4253: ; A: frame
                            	  4254: ; X: object index/cycle sprite index
                            	  4255: ; Y: animation index
                            	  4256: ; [00]: object X
                            	  4257: ; [01]: object Y
                            	  4258: ; [0C]: mirrored
                            	  4259: ; [0F]: flip horizontally
                            	  4260: ;
                            	  4261: ; Note:
                            	  4262: ; If the object is not mirrored, then it's horizontally flippable.
                            	  4263: ; But Link uses [0F] for flipping without checking [0C].
                            	  4264: ;
                            	  4265: ;
                            	  4266: ; [0D] holds frame.
                            	  4267:     even
                            	  4268: DrawObjectWithAnim:
02:0003134A 1940000D        	  4269:     move.b  D0,($000D,A4)
02:0003134E 1943000E        	  4270:     move.b  D3,($000E,A4)
02:00031352 19420008        	  4271:     move.b  D2,($0008,A4)
                            	  4272:     ; Set the left and right sprite record offsets for CurSpriteIndex.
