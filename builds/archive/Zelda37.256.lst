                            	  7085: ChangePlayMapSquareOW:
02:00043BC0 1002            	  7086:     move.b  D2,D0
02:00043BC2 1B00            	  7087:     move.b  D0,-(A5)  ; PHA
                            	  7088:     ; We're dealing with squares.
                            	  7089:     ; So, align the object's X coordinate with 16 pixels.
                            	  7090:     ;
02:00043BC4 10342070        	  7091:     move.b  ($70,A4,D2.W),D0
02:00043BC8 020000F0        	  7092:     andi.b #$F0,D0
                            	  7093:     ; Divide it by 4 to get the offset of the address of the column
                            	  7094:     ; in play area map.
                            	  7095:     ;
                            	  7096:     ; The calculation is: address offset = (X / 8) * 2
                            	  7097:     ; 8 for the width of the column; 2 for the width of the address
                            	  7098:     ;
02:00043BCC E208            	  7099:     lsr.b  #1,D0   ; LSR A
02:00043BCE E208            	  7100:     lsr.b  #1,D0   ; LSR A
02:00043BD0 7400            	  7101:     moveq   #0,D2
02:00043BD2 1400            	  7102:     move.b  D0,D2
                            	  7103:     ; Store the address of the column in [00:01].
                            	  7104:     ;
02:00043BD4 41F900049D80    	  7105:     lea     (PlayAreaColumnAddrs).l,A0
02:00043BDA 10302000        	  7106:     move.b  (A0,D2.W),D0
02:00043BDE 1880            	  7107:     move.b  D0,($0000,A4)
02:00043BE0 41F900049D81    	  7108:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00043BE6 10302000        	  7109:     move.b  (A0,D2.W),D0
02:00043BEA 19400001        	  7110:     move.b  D0,($0001,A4)
02:00043BEE 101D            	  7111:     move.b  (A5)+,D0  ; PLA
02:00043BF0 1B00            	  7112:     move.b  D0,-(A5)  ; PHA
02:00043BF2 7400            	  7113:     moveq   #0,D2
02:00043BF4 1400            	  7114:     move.b  D0,D2
                            	  7115:     ; Align the object's Y coordinate with 16 pixels.
                            	  7116:     ;
02:00043BF6 41EC0084        	  7117:     lea     ($0084,A4),A0
02:00043BFA 10302000        	  7118:     move.b  (A0,D2.W),D0
02:00043BFE 020000F0        	  7119:     andi.b #$F0,D0
                            	  7120:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7121:     ; the height of each row.
                            	  7122:     ;
02:00043C02 003C0011        	  7123:     ori     #$11,CCR  ; SEC: set C+X
02:00043C06 123C0040        	  7124:     move.b  #$40,D1
02:00043C0A 0A3C0010        	  7125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C0E 9101            	  7126:     subx.b  D1,D0   ; SBC #$40
02:00043C10 0A3C0010        	  7127:     eori    #$10,CCR  ; restore X = 6502 C
02:00043C14 E208            	  7128:     lsr.b  #1,D0   ; LSR A
02:00043C16 E208            	  7129:     lsr.b  #1,D0   ; LSR A
02:00043C18 E208            	  7130:     lsr.b  #1,D0   ; LSR A
                            	  7131:     ; Add this row offset to the column address.
                            	  7132:     ;
02:00043C1A 4EB900030CE4    	  7133:     jsr     AddToInt16At0
                            	  7134:     ; Assume that we'll write a type 1 square with primary square
                            	  7135:     ; taken from [05]. If so, the square index doesn't matter
                            	  7136:     ; as long as >= $10. See WriteSquareOW.
                            	  7137:     ;
02:00043C20 7600            	  7138:     moveq   #0,D3
02:00043C22 7410            	  7139:     moveq   #16,D2
02:00043C24 102C0005        	  7140:     move.b  ($0005,A4),D0
                            	  7141:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7142:     ; So, we have to look up the square index corresponding
                            	  7143:     ; to primary square/tile in [05].
                            	  7144:     ;
                            	  7145:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7146:     ; then the X register will have the square index value.
                            	  7147:     ;
02:00043C28 0C000027        	  7148:     cmpi.b  #$27,D0
02:00043C2C 6506            	  7149:     bcs  _anon_z05_148
02:00043C2E 0C0000F3        	  7150:     cmpi.b  #$F3,D0
02:00043C32 6514            	  7151:     bcs  _L_z05_ChangePlayMapSquareOW_Write
                            	  7152: _anon_z05_148:
02:00043C34 740E            	  7153:     moveq   #14,D2
                            	  7154: _anon_z05_149:
