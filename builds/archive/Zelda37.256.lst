                            	  5032: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  5033:     ; Else Link parries.
                            	  5034:     ;
                            	  5035:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  5036:     ;
02:0003191E 7001            	  5037:     moveq   #1,D0
02:00031920 19400604        	  5038:     move.b  D0,($0604,A4)
02:00031924 7000            	  5039:     moveq   #0,D0
02:00031926 19400006        	  5040:     move.b  D0,($0006,A4)
                            	  5041:     even
