02:0003C182 0C000055        	  6594:     cmpi.b  #$55,D0
02:0003C186 6626            	  6595:     bne  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  6596:     ; Every other screen frame, loop again.
