                            	  2989: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  2990:     ; TODO: call it speed index or angle?
                            	  2991:     ; If the difference in distances is within 8 pixels,
                            	  2992:     ; return the speed index (angle) we have.
                            	  2993:     ;
02:0003095E 102C0003        	  2994:     move.b  ($0003,A4),D0
02:00030962 003C0011        	  2995:     ori     #$11,CCR  ; SEC: set C+X
02:00030966 122C0004        	  2996:     move.b  ($0004,A4),D1
02:0003096A 0A3C0010        	  2997:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003096E 9101            	  2998:     subx.b  D1,D0   ; SBC $04
02:00030970 0A3C0010        	  2999:     eori    #$10,CCR  ; restore X = 6502 C
02:00030974 0C000008        	  3000:     cmpi.b  #$08,D0
02:00030978 6538            	  3001:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3002:     even
                            	  3003: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  3004:     ; TODO: call it speed index or angle?
                            	  3005:     ; Otherwise, go to the next speed index (angle).
                            	  3006:     ;
02:0003097A 1014            	  3007:     move.b  ($0000,A4),D0
02:0003097C 023C00EE        	  3008:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030980 122C0001        	  3009:     move.b  ($0001,A4),D1
02:00030984 D101            	  3010:     addx.b  D1,D0   ; ADC $01
02:00030986 1880            	  3011:     move.b  D0,($0000,A4)
                            	  3012:     ; TODO: call it speed index or angle?
                            	  3013:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  3014:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  3015:     ;
02:00030988 6728            	  3016:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:0003098A 0C000008        	  3017:     cmpi.b  #$08,D0
02:0003098E 6722            	  3018:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3019:     ; Subtract the lesser distance from the greater distance.
                            	  3020:     ; If they still haven't crossed, then we can turn more.
                            	  3021:     ;
02:00030990 102C0003        	  3022:     move.b  ($0003,A4),D0
02:00030994 003C0011        	  3023:     ori     #$11,CCR  ; SEC: set C+X
02:00030998 122C0004        	  3024:     move.b  ($0004,A4),D1
02:0003099C 0A3C0010        	  3025:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000309A0 9101            	  3026:     subx.b  D1,D0   ; SBC $04
02:000309A2 0A3C0010        	  3027:     eori    #$10,CCR  ; restore X = 6502 C
02:000309A6 19400003        	  3028:     move.b  D0,($0003,A4)
02:000309AA 122C0004        	  3029:     move.b  ($0004,A4),D1
02:000309AE B001            	  3030:     cmp.b   D1,D0
02:000309B0 64C8            	  3031:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  3032:     even
