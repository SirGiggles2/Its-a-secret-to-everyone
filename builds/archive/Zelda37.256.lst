                            	  7862:     ; which have 2.
                            	  7863:     ;
02:0003CA94 41EC03D0        	  7864:     lea     ($03D0,A4),A0
02:0003CA98 53302000        	  7865:     subq.b  #1,(A0,D2.W)
02:0003CA9C 6624            	  7866:     bne  _L_z04_UpdateLikeLike_Draw
02:0003CA9E 7008            	  7867:     moveq   #8,D0
02:0003CAA0 41EC03D0        	  7868:     lea     ($03D0,A4),A0
02:0003CAA4 11802000        	  7869:     move.b  D0,(A0,D2.W)
02:0003CAA8 7600            	  7870:     moveq   #0,D3
02:0003CAAA 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003CAAE 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003CAB2 5203            	  7873:     addq.b  #1,D3
02:0003CAB4 1003            	  7874:     move.b  D3,D0
02:0003CAB6 02000003        	  7875:     andi.b #$03,D0
02:0003CABA 41EC03E4        	  7876:     lea     ($03E4,A4),A0
02:0003CABE 11802000        	  7877:     move.b  D0,(A0,D2.W)
                            	  7878:     even
                            	  7879: _L_z04_UpdateLikeLike_Draw:
                            	  7880:     ; Draw.
                            	  7881:     ;
02:0003CAC2 4EB90004C486    	  7882:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CAC8 41EC03E4        	  7883:     lea     ($03E4,A4),A0
02:0003CACC 10302000        	  7884:     move.b  (A0,D2.W),D0
02:0003CAD0 4EB900031334    	  7885:     jsr     DrawObjectMirrored
                            	  7886:     ; Check collisions. If Link was not captured, then return.
                            	  7887:     ;
02:0003CAD6 4EB9000316B4    	  7888:     jsr     CheckMonsterCollisions
02:0003CADC 41EC042C        	  7889:     lea     ($042C,A4),A0
02:0003CAE0 10302000        	  7890:     move.b  (A0,D2.W),D0
02:0003CAE4 673C            	  7891:     beq  _L_z04_UpdateLikeLike_Exit
                            	  7892:     ; The monster captured Link.
                            	  7893:     ; Put the monster at the same location as him.
                            	  7894:     ;
02:0003CAE6 102C0070        	  7895:     move.b  ($0070,A4),D0
02:0003CAEA 19802070        	  7896:     move.b  D0,($70,A4,D2.W)
02:0003CAEE 102C0084        	  7897:     move.b  ($0084,A4),D0
02:0003CAF2 41EC0084        	  7898:     lea     ($0084,A4),A0
02:0003CAF6 11802000        	  7899:     move.b  D0,(A0,D2.W)
                            	  7900:     ; Reset Link's timer, metastate, and shove info.
                            	  7901:     ;
02:0003CAFA 7000            	  7902:     moveq   #0,D0
02:0003CAFC 19400028        	  7903:     move.b  D0,($0028,A4)
02:0003CB00 19400405        	  7904:     move.b  D0,($0405,A4)
02:0003CB04 194000C0        	  7905:     move.b  D0,($00C0,A4)
02:0003CB08 194000D3        	  7906:     move.b  D0,($00D3,A4)
                            	  7907:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  7908:     ;
02:0003CB0C 41EC03E4        	  7909:     lea     ($03E4,A4),A0
02:0003CB10 11802000        	  7910:     move.b  D0,(A0,D2.W)
02:0003CB14 7004            	  7911:     moveq   #4,D0
02:0003CB16 41EC03D0        	  7912:     lea     ($03D0,A4),A0
02:0003CB1A 11802000        	  7913:     move.b  D0,(A0,D2.W)
                            	  7914:     ; Now Link can't move.
                            	  7915:     ;
02:0003CB1E 522C0512        	  7916:     addq.b  #1,($0512,A4)
                            	  7917:     even
                            	  7918: _L_z04_UpdateLikeLike_Exit:
