02:0004BC2A 0C000070        	  5723:     cmpi.b  #$70,D0
02:0004BC2E 6502            	  5724:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004BC30 7670            	  5725:     moveq   #112,D3
                            	  5726:     even
                            	  5727: _L_z07_CheckState30_SetThrowerTimer:
02:0004BC32 1003            	  5728:     move.b  D3,D0
