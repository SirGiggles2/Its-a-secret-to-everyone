02:0003BE28 41EC0437        	  6168:     lea     ($0437,A4),A0
02:0003BE2C 12302000        	  6169:     move.b  (A0,D2.W),D1
02:0003BE30 B001            	  6170:     cmp.b   D1,D0
02:0003BE32 6704            	  6171:     beq.s  __far_z_04_0053
