                            	  5844: CheckMonsterSlenderWeaponCollision2:
02:00031E2A 7600            	  5845:     moveq   #0,D3
02:00031E2C 1614            	  5846:     move.b  ($0000,A4),D3
                            	  5847:     ; If Link is facing vertically, then:
                            	  5848:     ; [04] := (weapon X + 6)
                            	  5849:     ; A    := (weapon Y + 8)
                            	  5850:     ;
                            	  5851:     ; Shouldn't it be based on the weapon's direction?
                            	  5852:     ;
02:00031E2E 102C0098        	  5853:     move.b  ($0098,A4),D0
02:00031E32 0200000C        	  5854:     andi.b #$0C,D0
02:00031E36 6726            	  5855:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00031E38 10343070        	  5856:     move.b  ($70,A4,D3.W),D0
02:00031E3C 023C00EE        	  5857:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E40 123C0006        	  5858:     move.b  #$06,D1
02:00031E44 D101            	  5859:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00031E46 19400004        	  5860:     move.b  D0,($0004,A4)
02:00031E4A 41EC0084        	  5861:     lea     ($0084,A4),A0
02:00031E4E 10303000        	  5862:     move.b  (A0,D3.W),D0
02:00031E52 023C00EE        	  5863:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E56 123C0008        	  5864:     move.b  #$08,D1
02:00031E5A D101            	  5865:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031E5C 6024            	  5866:     jmp     _anon_z01_98
                            	  5867: 
                            	  5868:     even
                            	  5869: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  5870:     ; Else Link is facing horizontally.
                            	  5871:     ; [04] := (weapon X + 8)
                            	  5872:     ; A    := (weapon Y + 6)
                            	  5873:     ;
                            	  5874:     ; Shouldn't it be based on the weapon's direction?
                            	  5875:     ;
02:00031E5E 10343070        	  5876:     move.b  ($70,A4,D3.W),D0
02:00031E62 023C00EE        	  5877:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E66 123C0008        	  5878:     move.b  #$08,D1
02:00031E6A D101            	  5879:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031E6C 19400004        	  5880:     move.b  D0,($0004,A4)
02:00031E70 41EC0084        	  5881:     lea     ($0084,A4),A0
02:00031E74 10303000        	  5882:     move.b  (A0,D3.W),D0
02:00031E78 023C00EE        	  5883:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E7C 123C0006        	  5884:     move.b  #$06,D1
02:00031E80 D101            	  5885:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  5886: _anon_z01_98:
                            	  5887:     ; The A register will be copied to [05] and used here.
                            	  5888:     ;
02:00031E82 6000FC0C        	  5889:     jmp     CheckMonsterWeaponCollision
                            	  5890: 
                            	  5891: ; Params:
                            	  5892: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  5893: ; [00]: weapon object slot (unused)
                            	  5894: ; [02]: object 1 mid X
                            	  5895: ; [03]: object 1 mid Y
                            	  5896: ; [04]: object 2 mid X
                            	  5897: ; [05]: object 2 mid Y
                            	  5898: ;
                            	  5899: ; Returns:
                            	  5900: ; A: 1 if objects collide
                            	  5901: ; Y: weapon object slot
                            	  5902: ; Z: 0 if objects collide
                            	  5903: ; [06]: 1 if objects collide
                            	  5904: ; [0A]: horizontal distance
                            	  5905: ; [0B]: vertical distance
                            	  5906: ;
                            	  5907: ;
                            	  5908: ; Use the same threshold value horizontally and vertically.
                            	  5909: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  5910: ;
                            	  5911:     even
                            	  5912: DoObjectsCollide:
02:00031E86 1940000D        	  5913:     move.b  D0,($000D,A4)
02:00031E8A 1940000E        	  5914:     move.b  D0,($000E,A4)
                            	  5915: ; Params:
                            	  5916: ; [00]: weapon or Link object slot (unused)
                            	  5917: ; [02]: object 1 mid X
                            	  5918: ; [03]: object 1 mid Y
                            	  5919: ; [04]: object 2 mid X
                            	  5920: ; [05]: object 2 mid Y
                            	  5921: ; [0D]: horizontal threshold
                            	  5922: ; [0E]: vertical threshold
                            	  5923: ;
                            	  5924: ; Returns:
                            	  5925: ; A: 1 if objects collide
                            	  5926: ; Y: weapon or Link object slot (copied from [00])
                            	  5927: ; Z: 0 if objects collide
                            	  5928: ; [06]: 1 if objects collide
                            	  5929: ; [0A]: horizontal distance
                            	  5930: ; [0B]: vertical distance
                            	  5931: ;
                            	  5932: ;
                            	  5933: ; Reset [06] to indicate no collision by default.
                            	  5934: ;
                            	  5935:     even
                            	  5936: DoObjectsCollideWithThresholds:
02:00031E8E 6000A230        	  5937:     jmp     c_do_objects_collide_with_thresholds
                            	  5938: 
                            	  5939: BeginShove:
02:00031E92 7600            	  5940:     moveq   #0,D3
02:00031E94 1614            	  5941:     move.b  ($0000,A4),D3
02:00031E96 0C02000D        	  5942:     cmpi.b  #$0D,D2
02:00031E9A 6412            	  5943:     bcc  _anon_z01_99
02:00031E9C 41EC04B2        	  5944:     lea     ($04B2,A4),A0
02:00031EA0 10302000        	  5945:     move.b  (A0,D2.W),D0
02:00031EA4 122C0009        	  5946:     move.b  ($0009,A4),D1
02:00031EA8 C001            	  5947:     and.b  D1,D0
02:00031EAA 660000C4        	  5948:     bne  _L_z01_BeginShove_Exit
                            	  5949: _anon_z01_99:
                            	  5950:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  5951:     ; if he is defending. The goal is to push Link away from the monster.
                            	  5952:     ;
                            	  5953:     ; If instead a monster is defending, then all this calculation
                            	  5954:     ; won't matter, because the shove direction will be set to the
                            	  5955:     ; weapon's direction.
                            	  5956:     ;
                            	  5957:     ; As such, calculate a direction from the monster to the defender,
                            	  5958:     ; assuming it's Link.
                            	  5959:     ;
                            	  5960:     ; Start with an assumption that the direction is vertical:
                            	  5961:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  5962:     ;
02:00031EAE 7008            	  5963:     moveq   #8,D0
02:00031EB0 19400008        	  5964:     move.b  D0,($0008,A4)
02:00031EB4 41EC0084        	  5965:     lea     ($0084,A4),A0
02:00031EB8 10302000        	  5966:     move.b  (A0,D2.W),D0
02:00031EBC 19400004        	  5967:     move.b  D0,($0004,A4)
02:00031EC0 41EC0084        	  5968:     lea     ($0084,A4),A0
02:00031EC4 10303000        	  5969:     move.b  (A0,D3.W),D0
02:00031EC8 19400005        	  5970:     move.b  D0,($0005,A4)
                            	  5971:     ; If the defender is Link and his grid offset <> 0 then
                            	  5972:     ; use his usual object direction variable to determine
                            	  5973:     ; which axis to check.
                            	  5974:     ;
02:00031ECC 4A03            	  5975:     cmpi.b  #$00,D3
02:00031ECE 6612            	  5976:     bne  _anon_z01_100
02:00031ED0 102C0394        	  5977:     move.b  ($0394,A4),D0
02:00031ED4 670C            	  5978:     beq  _anon_z01_100
02:00031ED6 102C0098        	  5979:     move.b  ($0098,A4),D0
02:00031EDA 02000003        	  5980:     andi.b #$03,D0
02:00031EDE 660C            	  5981:     bne  _L_z01_BeginShove_CheckHorizontal
02:00031EE0 6720            	  5982:     beq  _L_z01_BeginShove_CheckVertical
                            	  5983: _anon_z01_100:
                            	  5984:     ; For monsters defending, or Link with grid offset = 0,
                            	  5985:     ; check direction in [0B].
                            	  5986:     ;
                            	  5987:     ; For monsters defending, this won't matter. For Link with grid
                            	  5988:     ; offset = 0, I believe the result will be arbitrary.
                            	  5989:     ;
                            	  5990:     ; TODO:
                            	  5991:     ; Is [0B] always set if Link's grid offset = 0?
                            	  5992:     ; It doesn't seem to be if candle fire attacks him.
                            	  5993:     ;
02:00031EE2 102C000B        	  5994:     move.b  ($000B,A4),D0
02:00031EE6 0C000004        	  5995:     cmpi.b  #$04,D0
02:00031EEA 6416            	  5996:     bcc  _L_z01_BeginShove_CheckVertical
                            	  5997:     even
                            	  5998: _L_z01_BeginShove_CheckHorizontal:
                            	  5999:     ; If the direction checked is left or right,
                            	  6000:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  6001:     ;
02:00031EEC 7002            	  6002:     moveq   #2,D0
02:00031EEE 19400008        	  6003:     move.b  D0,($0008,A4)
02:00031EF2 10342070        	  6004:     move.b  ($70,A4,D2.W),D0
02:00031EF6 19400004        	  6005:     move.b  D0,($0004,A4)
02:00031EFA 10343070        	  6006:     move.b  ($70,A4,D3.W),D0
02:00031EFE 19400005        	  6007:     move.b  D0,($0005,A4)
                            	  6008:     even
                            	  6009: _L_z01_BeginShove_CheckVertical:
                            	  6010:     ; If the monster is down or right of the other object,
                            	  6011:     ; then use the opposite direction already in [08].
                            	  6012:     ; Else shift [08] right to turn it into the opposite
                            	  6013:     ; direction up or down.
                            	  6014:     ;
                            	  6015:     ; Again assuming Link is the defender; after this, [08] points
                            	  6016:     ; Link away from the monster.
                            	  6017:     ;
02:00031F02 102C0004        	  6018:     move.b  ($0004,A4),D0
02:00031F06 122C0005        	  6019:     move.b  ($0005,A4),D1
02:00031F0A B001            	  6020:     cmp.b   D1,D0
02:00031F0C 640A            	  6021:     bcc  _anon_z01_101
02:00031F0E 122C0008        	  6022:     move.b  ($0008,A4),D1
02:00031F12 E209            	  6023:     lsr.b  #1,D1   ; LSR $08
02:00031F14 19410008        	  6024:     move.b  D1,($0008,A4)
                            	  6025: _anon_z01_101:
                            	  6026:     ; If a monster is the defender, go handle it separately.
                            	  6027:     ;
02:00031F18 4A03            	  6028:     cmpi.b  #$00,D3
02:00031F1A 6656            	  6029:     bne  _L_z01_BeginShove_MonsterDefender
                            	  6030:     ; Link is the defender.
                            	  6031:     ;
                            	  6032:     ; If Link is invincible, return without shoving.
                            	  6033:     ;
02:00031F1C 102C04F0        	  6034:     move.b  ($04F0,A4),D0
02:00031F20 664E            	  6035:     bne  _L_z01_BeginShove_Exit
                            	  6036:     ; Store the shove direction we determined.
                            	  6037:     ;
                            	  6038:     ; Turn on the high bit to indicate that the next time we try to
                            	  6039:     ; move by shoving, it will be the first time for this shove action.
                            	  6040:     ;
02:00031F22 102C0008        	  6041:     move.b  ($0008,A4),D0
02:00031F26 00000080        	  6042:     ori.b #$80,D0
02:00031F2A 194000C0        	  6043:     move.b  D0,($00C0,A4)
                            	  6044:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  6045:     ;
02:00031F2E 7018            	  6046:     moveq   #24,D0
02:00031F30 194004F0        	  6047:     move.b  D0,($04F0,A4)
02:00031F34 7020            	  6048:     moveq   #32,D0
02:00031F36 194000D3        	  6049:     move.b  D0,($00D3,A4)
                            	  6050:     ; If Link was shoved by one of his own weapons, then
                            	  6051:     ; nothing else to do. Return.
                            	  6052:     ;
02:00031F3A 0C02000D        	  6053:     cmpi.b  #$0D,D2
02:00031F3E 6430            	  6054:     bcc  _L_z01_BeginShove_Exit
                            	  6055:     ; Link was shoved by a monster.
                            	  6056:     ;
                            	  6057:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  6058:     ; then return.
                            	  6059:     ;
02:00031F40 41EC04BF        	  6060:     lea     ($04BF,A4),A0
02:00031F44 10302000        	  6061:     move.b  (A0,D2.W),D0
02:00031F48 02000080        	  6062:     andi.b #$80,D0
02:00031F4C 6622            	  6063:     bne  _L_z01_BeginShove_Exit
                            	  6064:     ; If the attacker is a vire, then return.
                            	  6065:     ;
02:00031F4E 41EC034F        	  6066:     lea     ($034F,A4),A0
02:00031F52 10302000        	  6067:     move.b  (A0,D2.W),D0
02:00031F56 0C000012        	  6068:     cmpi.b  #$12,D0
02:00031F5A 6714            	  6069:     beq  _L_z01_BeginShove_Exit
                            	  6070:     ; Turn the attacker in the opposite direction.
                            	  6071:     ;
02:00031F5C 41EC0098        	  6072:     lea     ($0098,A4),A0
02:00031F60 10302000        	  6073:     move.b  (A0,D2.W),D0
02:00031F64 6100E926        	  6074:     jsr     GetOppositeDir
02:00031F68 41EC0098        	  6075:     lea     ($0098,A4),A0
02:00031F6C 11802000        	  6076:     move.b  D0,(A0,D2.W)
                            	  6077:     even
                            	  6078: _L_z01_BeginShove_Exit:
02:00031F70 4E75            	  6079:     rts
                            	  6080: 
                            	  6081:     even
                            	  6082: _L_z01_BeginShove_MonsterDefender:
                            	  6083:     ; A monster is the defender. A weapon is the attacker.
                            	  6084:     ;
                            	  6085:     ; Set the shove direction to the weapon's direction,
                            	  6086:     ; instead of the direction passed in [0B].
                            	  6087:     ;
02:00031F72 41EC0098        	  6088:     lea     ($0098,A4),A0
02:00031F76 10303000        	  6089:     move.b  (A0,D3.W),D0
02:00031F7A 19400008        	  6090:     move.b  D0,($0008,A4)
                            	  6091:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  6092:     ; combine the shove direction with $40.
