02:0004BC36 41EC042C        	  5730:     lea     ($042C,A4),A0
02:0004BC3A 16302000        	  5731:     move.b  (A0,D2.W),D3
02:0004BC3E 19803028        	  5732:     move.b  D0,($28,A4,D3.W)
