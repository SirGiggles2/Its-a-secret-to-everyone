                            	  5140: _anon_z02_41:
02:00036470 41EC0305        	  5141:     lea     ($0305,A4),A0
02:00036474 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:00036478 5303            	  5143:     subq.b  #1,D3
02:0003647A 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
