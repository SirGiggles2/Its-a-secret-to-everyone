02:00043B5C 9101            	  7040:     subx.b  D1,D0   ; SBC #$40
02:00043B5E 0A3C0010        	  7041:     eori    #$10,CCR  ; restore X = 6502 C
02:00043B62 E208            	  7042:     lsr.b  #1,D0   ; LSR A
02:00043B64 E208            	  7043:     lsr.b  #1,D0   ; LSR A
02:00043B66 E208            	  7044:     lsr.b  #1,D0   ; LSR A
02:00043B68 7600            	  7045:     moveq   #0,D3
02:00043B6A 1600            	  7046:     move.b  D0,D3
02:00043B6C 1214            	  7047:     move.b  ($00,A4),D1   ; ptr lo
02:00043B6E 182C0001        	  7048:     move.b  ($01,A4),D4  ; ptr hi
02:00043B72 024100FF        	  7049:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B76 E14C            	  7050:     lsl.w   #8,D4
02:00043B78 8841            	  7051:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043B7A 48C4            	  7052:     ext.l   D4
