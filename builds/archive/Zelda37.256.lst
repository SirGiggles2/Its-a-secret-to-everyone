02:0003DCD6 122C0085        	 10265:     move.b  ($0085,A4),D1
02:0003DCDA 0A3C0010        	 10266:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DCDE 9101            	 10267:     subx.b  D1,D0   ; SBC ObjY+1
