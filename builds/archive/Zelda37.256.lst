                            	  6041: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6042:     ; Digdogger is big, but room boundary checks and
                            	  6043:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6044:     ; Therefore, we have to check these things four times,
                            	  6045:     ; in different corners of the boss.
                            	  6046:     ;
                            	  6047:     ; Loop 4 times, from 0 to 3.
                            	  6048:     ;
02:0003BCFC 7600            	  6049:     moveq   #0,D3
02:0003BCFE 41EC0478        	  6050:     lea     ($0478,A4),A0
02:0003BD02 16302000        	  6051:     move.b  (A0,D2.W),D3
                            	  6052:     ; Change the coordinates to one corner.
                            	  6053:     ;
02:0003BD06 10342070        	  6054:     move.b  ($70,A4,D2.W),D0
02:0003BD0A 023C00EE        	  6055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD0E 41F90003BBC2    	  6056:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003BD14 12303000        	  6057:     move.b  (A0,D3.W),D1
02:0003BD18 D101            	  6058:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003BD1A 19802070        	  6059:     move.b  D0,($70,A4,D2.W)
02:0003BD1E 41EC0084        	  6060:     lea     ($0084,A4),A0
02:0003BD22 10302000        	  6061:     move.b  (A0,D2.W),D0
02:0003BD26 023C00EE        	  6062:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD2A 41F90003BBC6    	  6063:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003BD30 12303000        	  6064:     move.b  (A0,D3.W),D1
02:0003BD34 D101            	  6065:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003BD36 41EC0084        	  6066:     lea     ($0084,A4),A0
02:0003BD3A 11802000        	  6067:     move.b  D0,(A0,D2.W)
                            	  6068:     ; Check the room boundary and object collisions in this temporary location.
                            	  6069:     ;
02:0003BD3E 61003734        	  6070:     jsr     BoundFlyer
02:0003BD42 4EB9000316B4    	  6071:     jsr     CheckMonsterCollisions
                            	  6072:     ; Increase the loop index, and loop again until it = 4.
                            	  6073:     ;
