                            	  4119:     ;
02:0003AEF2 5202            	  4120:     addq.b  #1,D2
02:0003AEF4 0C02000A        	  4121:     cmpi.b  #$0A,D2
02:0003AEF8 6600FF32        	  4122:     bne  _L_z04_PondFairy_MoveHearts_LoopHeart
02:0003AEFC 0A3C0001        	  4123:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003AF00 4E75            	  4124:     rts
