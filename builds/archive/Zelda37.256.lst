                            	 12170:     even
                            	 12171: UpdateGanon_JumpTable:
02:0003EADA 0003EAE6        	 12172:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003EADE 0003EB48        	 12173:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003EAE2 0003EB76        	 12174:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12175: 
                            	 12176: ; Description:
                            	 12177: ; Lift up the Triforce of Courage while the room is dark.
                            	 12178: ;
                            	 12179: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12180: ;
                            	 12181:     even
                            	 12182: Ganon_ScenePhase0:
02:0003EAE6 701B            	 12183:     moveq   #27,D0
02:0003EAE8 19400505        	 12184:     move.b  D0,($0505,A4)
                            	 12185:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12186:     ;
02:0003EAEC 102C0028        	 12187:     move.b  ($0028,A4),D0
02:0003EAF0 6644            	 12188:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12189:     ; Once the timer expires, it's time to brighten the room.
                            	 12190:     ;
                            	 12191:     ; Save the current object slot.
02:0003EAF2 1002            	 12192:     move.b  D2,D0
02:0003EAF4 1B00            	 12193:     move.b  D0,-(A5)  ; PHA
02:0003EAF6 610007F0        	 12194:     jsr     UpdateCandle
02:0003EAFA 101D            	 12195:     move.b  (A5)+,D0  ; PLA
02:0003EAFC 7400            	 12196:     moveq   #0,D2
02:0003EAFE 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003EB00 7000            	 12201:     moveq   #0,D0
02:0003EB02 1940051E        	 12202:     move.b  D0,($051E,A4)
                            	 12203:     ; On the first frame of the fade-to-light cycle, play the
                            	 12204:     ; Triforce/Ganon song.
                            	 12205:     ;
02:0003EB06 102C051C        	 12206:     move.b  ($051C,A4),D0
02:0003EB0A 0C0000C0        	 12207:     cmpi.b  #$C0,D0
02:0003EB0E 6606            	 12208:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003EB10 7002            	 12209:     moveq   #2,D0
02:0003EB12 19400600        	 12210:     move.b  D0,($0600,A4)
                            	 12211:     even
                            	 12212: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12213:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12214:     ;
02:0003EB16 102C051C        	 12215:     move.b  ($051C,A4),D0
02:0003EB1A 0200000F        	 12216:     andi.b #$0F,D0
02:0003EB1E 0C000004        	 12217:     cmpi.b  #$04,D0
02:0003EB22 6702            	 12218:     beq.s  __far_z_04_0115
02:0003EB24 6042            	 12219:     jmp  Ganon_DrawBodyFrame0
                            	 12220: __far_z_04_0115:
                            	 12221:     ; Set Link's timer to $C0 for the next scene phase.
