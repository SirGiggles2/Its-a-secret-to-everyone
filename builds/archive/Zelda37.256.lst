02:0003C142 6634            	  6553:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  6554:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  6555:     ;
                            	  6556:     ; Set the timer to a random time, at least $70 frames.
                            	  6557:     ;
02:0003C144 10342018        	  6558:     move.b  ($18,A4,D2.W),D0
02:0003C148 00000070        	  6559:     ori.b #$70,D0
02:0003C14C 19802028        	  6560:     move.b  D0,($28,A4,D2.W)
                            	  6561:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  6562:     ;
02:0003C150 6168            	  6563:     jsr     ShootFireball55
02:0003C152 7000            	  6564:     moveq   #0,D0
02:0003C154 41EC0478        	  6565:     lea     ($0478,A4),A0
02:0003C158 11803000        	  6566:     move.b  D0,(A0,D3.W)
                            	  6567:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  6568:     ;
02:0003C15C 615C            	  6569:     jsr     ShootFireball55
02:0003C15E 7001            	  6570:     moveq   #1,D0
02:0003C160 41EC0478        	  6571:     lea     ($0478,A4),A0
02:0003C164 11803000        	  6572:     move.b  D0,(A0,D3.W)
                            	  6573:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  6574:     ;
02:0003C168 6150            	  6575:     jsr     ShootFireball55
02:0003C16A 103C00FF        	  6576:     move.b  #$FF,D0
02:0003C16E 41EC0478        	  6577:     lea     ($0478,A4),A0
02:0003C172 11803000        	  6578:     move.b  D0,(A0,D3.W)
02:0003C176 4E75            	  6579:     rts
