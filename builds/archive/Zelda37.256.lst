                            	  4003: PondHeartStartAngles:
02:0003AE22 14              	  4004:     dc.b    $14, $10, $0C, $08, $04, $00, $1C
02:0003AE23 10
02:0003AE24 0C
02:0003AE25 08
02:0003AE26 04
02:0003AE27 00
02:0003AE28 1C
