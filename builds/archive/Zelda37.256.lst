                            	  8163:     ; decrement the distance remaining, and move.
                            	  8164:     ;
02:0003CCE2 41EC0394        	  8165:     lea     ($0394,A4),A0
02:0003CCE6 10302000        	  8166:     move.b  (A0,D2.W),D0
02:0003CCEA 670A            	  8167:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
