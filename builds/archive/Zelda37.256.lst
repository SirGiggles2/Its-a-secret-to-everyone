                            	  6643: Aquamentus_Draw:
                            	  6644:     ; Every $10 screen frames, switch animation frames.
                            	  6645:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6646:     ; The last tile of frame 0 is at index 5.
                            	  6647:     ; The last tile of frame 1 is at index $B.
                            	  6648:     ;
02:0003C1D8 7605            	  6649:     moveq   #5,D3
02:0003C1DA 102C0015        	  6650:     move.b  ($0015,A4),D0
02:0003C1DE 02000010        	  6651:     andi.b #$10,D0
02:0003C1E2 6602            	  6652:     bne  _anon_z04_88
02:0003C1E4 760B            	  6653:     moveq   #11,D3
                            	  6654: _anon_z04_88:
02:0003C1E6 1943000A        	  6655:     move.b  D3,($000A,A4)
                            	  6656:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6657:     ;
02:0003C1EA 7005            	  6658:     moveq   #5,D0
02:0003C1EC 1940000B        	  6659:     move.b  D0,($000B,A4)
                            	  6660:     even
                            	  6661: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C1F0 7600            	  6662:     moveq   #0,D3
02:0003C1F2 162C000B        	  6663:     move.b  ($000B,A4),D3
                            	  6664:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6665:     ; Store it in [00].
                            	  6666:     ;
02:0003C1F6 10342070        	  6667:     move.b  ($70,A4,D2.W),D0
02:0003C1FA 023C00EE        	  6668:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C1FE 41F90003C1D2    	  6669:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C204 12303000        	  6670:     move.b  (A0,D3.W),D1
02:0003C208 D101            	  6671:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C20A 1880            	  6672:     move.b  D0,($0000,A4)
                            	  6673:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6674:     ; Store it in [01].
                            	  6675:     ;
02:0003C20C 41EC0084        	  6676:     lea     ($0084,A4),A0
02:0003C210 10302000        	  6677:     move.b  (A0,D2.W),D0
02:0003C214 023C00EE        	  6678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C218 41F90003C1CC    	  6679:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C21E 12303000        	  6680:     move.b  (A0,D3.W),D1
02:0003C222 D101            	  6681:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C224 19400001        	  6682:     move.b  D0,($0001,A4)
                            	  6683:     ; Calculate sprite attributes:
                            	  6684:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6685:     ;
                            	  6686:     ; If the boss is temporarily invincible, then
                            	  6687:     ; this makes it flash by cycling all the palette rows.
                            	  6688:     ;
                            	  6689:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6690:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6691:     ;
02:0003C228 41EC04F0        	  6692:     lea     ($04F0,A4),A0
02:0003C22C 10302000        	  6693:     move.b  (A0,D2.W),D0
02:0003C230 02000003        	  6694:     andi.b #$03,D0
02:0003C234 0A000003        	  6695:     eori.b #$03,D0
02:0003C238 19400003        	  6696:     move.b  D0,($0003,A4)
02:0003C23C 7600            	  6697:     moveq   #0,D3
02:0003C23E 162C000A        	  6698:     move.b  ($000A,A4),D3
                            	  6699:     ; Look up the tile for this sprite.
                            	  6700:     ; If it's not the first one (face), then go write the sprite record.
                            	  6701:     ;
02:0003C242 41F90003C1C0    	  6702:     lea     (AquamentusTiles).l,A0
02:0003C248 10303000        	  6703:     move.b  (A0,D3.W),D0
02:0003C24C 12390003C1C0    	  6704:     move.b  (AquamentusTiles).l,D1
02:0003C252 B001            	  6705:     cmp.b   D1,D0
02:0003C254 6610            	  6706:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6707:     ; Else it's the first one (the face tile).
                            	  6708:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6709:     ;
                            	  6710:     ; $CC/CD shows the closed mouth face.
                            	  6711:     ; $C0/C1 shows the open mouth face.
                            	  6712:     ;
02:0003C256 7600            	  6713:     moveq   #0,D3
02:0003C258 16342028        	  6714:     move.b  ($28,A4,D2.W),D3
02:0003C25C 0C030020        	  6715:     cmpi.b  #$20,D3
02:0003C260 6404            	  6716:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C262 103C00C0        	  6717:     move.b  #$C0,D0
                            	  6718:     even
                            	  6719: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C266 610E            	  6720:     jsr     WriteBossSprite
                            	  6721:     ; Bottom of the loop.
                            	  6722:     ; Decrement tile index and loop index.
                            	  6723:     ;
02:0003C268 532C000A        	  6724:     subq.b  #1,($000A,A4)
02:0003C26C 532C000B        	  6725:     subq.b  #1,($000B,A4)
02:0003C270 6A00FF7E        	  6726:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C274 4E75            	  6727:     rts
                            	  6728: 
                            	  6729: ; Params:
                            	  6730: ; A: tile
                            	  6731: ; [00]: X
                            	  6732: ; [01]: Y
                            	  6733: ; [03]: sprite attributes
                            	  6734: ;
                            	  6735: ; Save the tile
                            	  6736:     even
                            	  6737: WriteBossSprite:
02:0003C276 1B00            	  6738:     move.b  D0,-(A5)  ; PHA
02:0003C278 7600            	  6739:     moveq   #0,D3
02:0003C27A 162C0341        	  6740:     move.b  ($0341,A4),D3
02:0003C27E 41F900031300    	  6741:     lea     (SpriteOffsets).l,A0
02:0003C284 10303000        	  6742:     move.b  (A0,D3.W),D0
02:0003C288 7600            	  6743:     moveq   #0,D3
02:0003C28A 1600            	  6744:     move.b  D0,D3
02:0003C28C 101D            	  6745:     move.b  (A5)+,D0  ; PLA
02:0003C28E 41EC0201        	  6746:     lea     ($0201,A4),A0
02:0003C292 11803000        	  6747:     move.b  D0,(A0,D3.W)
02:0003C296 1014            	  6748:     move.b  ($0000,A4),D0
02:0003C298 41EC0203        	  6749:     lea     ($0203,A4),A0
02:0003C29C 11803000        	  6750:     move.b  D0,(A0,D3.W)
02:0003C2A0 102C0001        	  6751:     move.b  ($0001,A4),D0
02:0003C2A4 4EF90003167E    	  6752:     jmp     Anim_EndWriteSprite
                            	  6753: 
