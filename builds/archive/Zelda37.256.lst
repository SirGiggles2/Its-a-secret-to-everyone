                            	  7946: _anon_z05_174:
                            	  7947:     ; Two input directions, and at least one of them is walkable.
                            	  7948:     ;
                            	  7949:     ; Make Link go straight in one direction on the next grid line.
                            	  7950:     ;
02:00044478 7600            	  7951:     moveq   #0,D3
02:0004447A 1600            	  7952:     move.b  D0,D3
02:0004447C 522C0057        	  7953:     addq.b  #1,($0057,A4)
                            	  7954:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7955:     ; object direction and input direction to last walkable direction
                            	  7956:     ; found, and set Link's speed.
                            	  7957:     ;
                            	  7958:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7959:     ;
02:00044480 7400            	  7960:     moveq   #0,D2
02:00044482 102C000D        	  7961:     move.b  ($000D,A4),D0
02:00044486 0C030001        	  7962:     cmpi.b  #$01,D3
02:0004448A 67000096        	  7963:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
