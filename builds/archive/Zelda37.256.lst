                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:0003A4BC 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:0003A4C0 102C000F        	  2668:     move.b  ($000F,A4),D0
02:0003A4C4 660C            	  2669:     bne  _anon_z04_37
02:0003A4C6 41EC0451        	  2670:     lea     ($0451,A4),A0
02:0003A4CA 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:0003A4CE 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:0003A4D2 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:0003A4D6 7000            	  2678:     moveq   #0,D0
02:0003A4D8 41EC0451        	  2679:     lea     ($0451,A4),A0
02:0003A4DC 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003A4E0 6100015E        	  2683:     jsr     Jumper_GetKind
02:0003A4E4 41F90003A3D0    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A4EA 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003A4EE 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4F2 41EC0098        	  2696:     lea     ($0098,A4),A0
02:0003A4F6 12302000        	  2697:     move.b  (A0,D2.W),D1
02:0003A4FA D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A4FC 7600            	  2699:     moveq   #0,D3
02:0003A4FE 1600            	  2700:     move.b  D0,D3
02:0003A500 41F90003A3AE    	  2701:     lea     (JumperYAccelerations).l,A0
02:0003A506 10303000        	  2702:     move.b  (A0,D3.W),D0
02:0003A50A 7602            	  2703:     moveq   #2,D3
02:0003A50C 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:0003A510 163C00FF        	  2710:     move.b  #$FF,D3
02:0003A514 41EC0098        	  2711:     lea     ($0098,A4),A0
02:0003A518 10302000        	  2712:     move.b  (A0,D2.W),D0
02:0003A51C 02000002        	  2713:     andi.b #$02,D0
02:0003A520 6602            	  2714:     bne  _anon_z04_38
02:0003A522 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:0003A524 1003            	  2717:     move.b  D3,D0
02:0003A526 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A52A 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:0003A52E D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A530 19802070        	  2721:     move.b  D0,($70,A4,D2.W)
                            	  2722:     ; If going up (negative v-speed high byte), then
                            	  2723:     ; go animate, draw, and check collisions.
                            	  2724:     ;
02:0003A534 41EC0412        	  2725:     lea     ($0412,A4),A0
02:0003A538 10302000        	  2726:     move.b  (A0,D2.W),D0
02:0003A53C 6A04            	  2727:     bpl.s  __far_z_04_0022
02:0003A53E 60000090        	  2728:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2729: __far_z_04_0022:
                            	  2730:     ; Going down. We have to consider the target Y.
                            	  2731:     ;
                            	  2732:     ; If the absolute vertical distance to the target position >= 3,
                            	  2733:     ; then go animate, draw, and check collisions.
                            	  2734:     ;
02:0003A542 41EC0084        	  2735:     lea     ($0084,A4),A0
02:0003A546 10302000        	  2736:     move.b  (A0,D2.W),D0
02:0003A54A 003C0011        	  2737:     ori     #$11,CCR  ; SEC: set C+X
02:0003A54E 41EC0444        	  2738:     lea     ($0444,A4),A0
02:0003A552 12302000        	  2739:     move.b  (A0,D2.W),D1
02:0003A556 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A55A 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003A55C 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A560 4EB900030890    	  2743:     jsr     Abs
02:0003A566 0C000003        	  2744:     cmpi.b  #$03,D0
02:0003A56A 6502            	  2745:     bcs.s  __far_z_04_0023
02:0003A56C 6062            	  2746:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2747: __far_z_04_0023:
                            	  2748:     ; Distance < 3. Go to state 0.
                            	  2749:     ;
                            	  2750:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2751:     ;
02:0003A56E 4EB90004C024    	  2752:     jsr     ResetObjState
02:0003A574 7600            	  2753:     moveq   #0,D3
02:0003A576 41EC034F        	  2754:     lea     ($034F,A4),A0
02:0003A57A 16302000        	  2755:     move.b  (A0,D2.W),D3
02:0003A57E 0C030020        	  2756:     cmpi.b  #$20,D3
02:0003A582 6748            	  2757:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2758:     ; Else calculate a timer value.
                            	  2759:     ;
                            	  2760:     ; t := (Random + $10)
                            	  2761:     ; if t < $20 then
                            	  2762:     ;   t := t - $40
                            	  2763:     ;
02:0003A584 7010            	  2764:     moveq   #16,D0
02:0003A586 023C00EE        	  2765:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A58A 12342019        	  2766:     move.b  ($19,A4,D2.W),D1
02:0003A58E D101            	  2767:     addx.b  D1,D0   ; ADC Random+1,X
02:0003A590 0C000020        	  2768:     cmpi.b  #$20,D0
02:0003A594 6412            	  2769:     bcc  _anon_z04_39
02:0003A596 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:0003A59A 123C0040        	  2771:     move.b  #$40,D1
02:0003A59E 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A5A2 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:0003A5A4 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
                            	  2776:     ; If the object is a blue tektite, then go use this t.
                            	  2777:     ;
02:0003A5A8 7600            	  2778:     moveq   #0,D3
02:0003A5AA 41EC034F        	  2779:     lea     ($034F,A4),A0
02:0003A5AE 16302000        	  2780:     move.b  (A0,D2.W),D3
02:0003A5B2 0C03000D        	  2781:     cmpi.b  #$0D,D3
02:0003A5B6 6714            	  2782:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2783:     ; t := t AND $7F
                            	  2784:     ;
02:0003A5B8 0200007F        	  2785:     andi.b #$7F,D0
                            	  2786:     ; If Random < $A0, then go use this t.
                            	  2787:     ;
02:0003A5BC 7600            	  2788:     moveq   #0,D3
02:0003A5BE 16342019        	  2789:     move.b  ($19,A4,D2.W),D3
02:0003A5C2 0C0300A0        	  2790:     cmpi.b  #$A0,D3
02:0003A5C6 6504            	  2791:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2792:     ; t := t AND $F
                            	  2793:     ;
02:0003A5C8 0200000F        	  2794:     andi.b #$0F,D0
                            	  2795:     even
                            	  2796: _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate:
02:0003A5CC 19802028        	  2797:     move.b  D0,($28,A4,D2.W)
                            	  2798:     even
                            	  2799: Jumper_AnimateAndCheckCollisions:
02:0003A5D0 4EB90004C486    	  2800:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2801:     ; TODO: [0D] ?
                            	  2802:     ; [0D] doesn't seem to be used.
                            	  2803:     ;
02:0003A5D6 1940000D        	  2804:     move.b  D0,($000D,A4)
                            	  2805:     ; If the monster is a boulder, then go animate, draw, check collision.
                            	  2806:     ;
02:0003A5DA 41EC034F        	  2807:     lea     ($034F,A4),A0
02:0003A5DE 10302000        	  2808:     move.b  (A0,D2.W),D0
