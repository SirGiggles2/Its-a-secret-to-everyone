                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:0004113C 102C0098        	  2866:     move.b  ($0098,A4),D0
02:00041140 4EB90003088C    	  2867:     jsr     GetOppositeDir
02:00041146 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:00041148 4EB90003088C    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:0004114E 102C0070        	  2879:     move.b  ($0070,A4),D0
02:00041152 0C030002        	  2880:     cmpi.b  #$02,D3
02:00041156 6404            	  2881:     bcc  _anon_z05_74
02:00041158 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:0004115C 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:00041160 1003            	  2887:     move.b  D3,D0
02:00041162 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:00041164 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041168 123C0008        	  2890:     move.b  #$08,D1
02:0004116C D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0004116E 7600            	  2892:     moveq   #0,D3
02:00041170 1600            	  2893:     move.b  D0,D3
02:00041172 103C0080        	  2894:     move.b  #$80,D0
02:00041176 6134            	  2895:     jsr     MaskInputInBorder
02:00041178 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:0004117A 7600            	  2897:     moveq   #0,D3
02:0004117C 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:0004117E 102C0001        	  2902:     move.b  ($0001,A4),D0
02:00041182 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:00041186 660C            	  2904:     bne  _anon_z05_75
02:00041188 102C0098        	  2905:     move.b  ($0098,A4),D0
02:0004118C 1880            	  2906:     move.b  D0,($0000,A4)
02:0004118E 4EB90003088C    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
