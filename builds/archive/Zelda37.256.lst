                            	  7938:     even
                            	  7939: _L_z04_UpdateLikeLike_IncCaptureTime:
                            	  7940:     ; Increment capture time.
                            	  7941:     ;
02:0003CB4E 41EC042C        	  7942:     lea     ($042C,A4),A0
02:0003CB52 52302000        	  7943:     addq.b  #1,(A0,D2.W)
                            	  7944:     ; Once capture time >= $60 screen frames, remove the magic shield.
                            	  7945:     ;
02:0003CB56 41EC042C        	  7946:     lea     ($042C,A4),A0
02:0003CB5A 10302000        	  7947:     move.b  (A0,D2.W),D0
02:0003CB5E 0C000060        	  7948:     cmpi.b  #$60,D0
02:0003CB62 6512            	  7949:     bcs  _L_z04_UpdateLikeLike_DrawAfterCapture
02:0003CB64 7000            	  7950:     moveq   #0,D0
02:0003CB66 19400676        	  7951:     move.b  D0,($0676,A4)
                            	  7952:     ; Set a value above $60 over and over.
                            	  7953:     ;
02:0003CB6A 103C00C0        	  7954:     move.b  #$C0,D0
02:0003CB6E 41EC042C        	  7955:     lea     ($042C,A4),A0
02:0003CB72 11802000        	  7956:     move.b  D0,(A0,D2.W)
                            	  7957:     even
                            	  7958: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  7959:     ; In this state, we have to draw Like-like over Link.
                            	  7960:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  7961:     ;
02:0003CB76 4EB90004C486    	  7962:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CB7C 41EC03E4        	  7963:     lea     ($03E4,A4),A0
02:0003CB80 10302000        	  7964:     move.b  (A0,D2.W),D0
02:0003CB84 6100CD12        	  7965:     jsr     DrawObjectMirroredOverLink
                            	  7966:     ; Check object collisions.
                            	  7967:     ; If this monster hasn't died, then return.
                            	  7968:     ;
02:0003CB88 4EB9000316B4    	  7969:     jsr     CheckMonsterCollisions
