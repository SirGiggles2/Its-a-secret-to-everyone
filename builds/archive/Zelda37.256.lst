                            	 11422: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003E574 10342070        	 11423:     move.b  ($70,A4,D2.W),D0
02:0003E578 1B00            	 11424:     move.b  D0,-(A5)  ; PHA
                            	 11425:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11426:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11427:     ;
02:0003E57A 023C00EE        	 11428:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E57E 123C0004        	 11429:     move.b  #$04,D1
02:0003E582 D101            	 11430:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E584 19802070        	 11431:     move.b  D0,($70,A4,D2.W)
                            	 11432:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11433:     ; to store in [03].
                            	 11434:     ;
02:0003E588 102C04E6        	 11435:     move.b  ($04E6,A4),D0
02:0003E58C 0A000003        	 11436:     eori.b #$03,D0
02:0003E590 19400003        	 11437:     move.b  D0,($0003,A4)
                            	 11438:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11439:     ;
02:0003E594 103C009E        	 11440:     move.b  #$9E,D0
02:0003E598 0C020005        	 11441:     cmpi.b  #$05,D2
02:0003E59C 670A            	 11442:     beq  _L_z04_UpdateLamnola_Draw
02:0003E59E 0C02000A        	 11443:     cmpi.b  #$0A,D2
02:0003E5A2 6704            	 11444:     beq  _L_z04_UpdateLamnola_Draw
02:0003E5A4 103C00A0        	 11445:     move.b  #$A0,D0
                            	 11446:     even
                            	 11447: _L_z04_UpdateLamnola_Draw:
02:0003E5A8 4EB900031634    	 11448:     jsr     Anim_WriteSprite
02:0003E5AE 101D            	 11449:     move.b  (A5)+,D0  ; PLA
02:0003E5B0 19802070        	 11450:     move.b  D0,($70,A4,D2.W)
02:0003E5B4 41EC0098        	 11451:     lea     ($0098,A4),A0
02:0003E5B8 10302000        	 11452:     move.b  (A0,D2.W),D0
02:0003E5BC 1B00            	 11453:     move.b  D0,-(A5)  ; PHA
02:0003E5BE 4EB9000316B4    	 11454:     jsr     CheckMonsterCollisions
02:0003E5C4 101D            	 11455:     move.b  (A5)+,D0  ; PLA
02:0003E5C6 41EC0098        	 11456:     lea     ($0098,A4),A0
02:0003E5CA 11802000        	 11457:     move.b  D0,(A0,D2.W)
                            	 11458:     ; If still alive, then return.
                            	 11459:     ;
02:0003E5CE 41EC0405        	 11460:     lea     ($0405,A4),A0
02:0003E5D2 10302000        	 11461:     move.b  (A0,D2.W),D0
02:0003E5D6 6604            	 11462:     bne.s  __far_z_04_0109
02:0003E5D8 6000FF72        	 11463:     jmp  L129EA_Exit
                            	 11464: __far_z_04_0109:
                            	 11465:     ; Otherwise, the segment is dead.
                            	 11466:     ;
02:0003E5DC 4EB90004AE2E    	 11467:     jsr     ResetShoveInfo
                            	 11468:     ; Set the current segment's HP to the initial value in anticipation
                            	 11469:     ; of bringing this segment back to life.
                            	 11470:     ;
02:0003E5E2 7020            	 11471:     moveq   #32,D0
02:0003E5E4 41EC0485        	 11472:     lea     ($0485,A4),A0
02:0003E5E8 11802000        	 11473:     move.b  D0,(A0,D2.W)
                            	 11474:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11475:     ;
                            	 11476:     ; From the lowest slot, look for one that has the original lamnola
                            	 11477:     ; object type.
                            	 11478:     ;
                            	 11479:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11480:     ;
02:0003E5EC 163C00FF        	 11481:     move.b  #$FF,D3
02:0003E5F0 0C020006        	 11482:     cmpi.b  #$06,D2
02:0003E5F4 6502            	 11483:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003E5F6 7604            	 11484:     moveq   #4,D3
                            	 11485:     even
                            	 11486: _L_z04_UpdateLamnola_FindTail:
02:0003E5F8 5203            	 11487:     addq.b  #1,D3
02:0003E5FA 41EC0350        	 11488:     lea     ($0350,A4),A0
02:0003E5FE 10303000        	 11489:     move.b  (A0,D3.W),D0
02:0003E602 122C04E7        	 11490:     move.b  ($04E7,A4),D1
02:0003E606 B001            	 11491:     cmp.b   D1,D0
02:0003E608 66EE            	 11492:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11493:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11494:     ;
02:0003E60A 7011            	 11495:     moveq   #17,D0
02:0003E60C 19803029        	 11496:     move.b  D0,($29,A4,D3.W)
                            	 11497:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11498:     ; to the tail segment.
                            	 11499:     ;
02:0003E610 41EC04F0        	 11500:     lea     ($04F0,A4),A0
02:0003E614 10302000        	 11501:     move.b  (A0,D2.W),D0
02:0003E618 41EC04F1        	 11502:     lea     ($04F1,A4),A0
02:0003E61C 11803000        	 11503:     move.b  D0,(A0,D3.W)
02:0003E620 10342070        	 11504:     move.b  ($70,A4,D2.W),D0
02:0003E624 19803071        	 11505:     move.b  D0,($71,A4,D3.W)
02:0003E628 41EC0084        	 11506:     lea     ($0084,A4),A0
02:0003E62C 10302000        	 11507:     move.b  (A0,D2.W),D0
02:0003E630 41EC0085        	 11508:     lea     ($0085,A4),A0
02:0003E634 11803000        	 11509:     move.b  D0,(A0,D3.W)
                            	 11510:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11511:     ; So, return and leave it dead.
                            	 11512:     ;
02:0003E638 0C030004        	 11513:     cmpi.b  #$04,D3
02:0003E63C 6604            	 11514:     bne.s  __far_z_04_0110
02:0003E63E 6000FF0C        	 11515:     jmp  L129EA_Exit
                            	 11516: __far_z_04_0110:
02:0003E642 0C030009        	 11517:     cmpi.b  #$09,D3
02:0003E646 6604            	 11518:     bne.s  __far_z_04_0111
02:0003E648 6000FF02        	 11519:     jmp  L129EA_Exit
                            	 11520: __far_z_04_0111:
                            	 11521:     ; Change the tail segment to the dead dummy object, and
                            	 11522:     ; bring the current segment back to life.
                            	 11523:     ;
02:0003E64C 705D            	 11524:     moveq   #93,D0
02:0003E64E 41EC0350        	 11525:     lea     ($0350,A4),A0
02:0003E652 11803000        	 11526:     move.b  D0,(A0,D3.W)
02:0003E656 4EF90004CC86    	 11527:     jmp     ResetObjMetastate
