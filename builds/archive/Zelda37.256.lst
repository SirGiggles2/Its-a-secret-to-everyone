02:0003BD60 41EC0084        	  6083:     lea     ($0084,A4),A0
02:0003BD64 11802000        	  6084:     move.b  D0,(A0,D2.W)
02:0003BD68 101D            	  6085:     move.b  (A5)+,D0  ; PLA
