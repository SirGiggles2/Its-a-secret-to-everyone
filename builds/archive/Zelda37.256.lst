                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003C970 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003C974 10302000        	  7740:     move.b  (A0,D2.W),D0
02:0003C978 023C00EE        	  7741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C97C 123C0038        	  7742:     move.b  #$38,D1
02:0003C980 D101            	  7743:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003C982 41EC0444        	  7744:     lea     ($0444,A4),A0
02:0003C986 11802000        	  7745:     move.b  D0,(A0,D2.W)
                            	  7746:     ; Add Carry to high speed byte (vertical).
                            	  7747:     ;
02:0003C98A 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003C98E 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003C992 123C0000        	  7750:     move.b  #$00,D1
02:0003C996 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C998 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003C99C 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003C9A0 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C9A4 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003C9A8 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003C9AC D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
02:0003C9AE 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003C9B2 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003C9B6 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003C9BA 10302000        	  7765:     move.b  (A0,D2.W),D0
02:0003C9BE 6B0000AC        	  7766:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7767:     ; If Y coordinate still < target Y, then return.
                            	  7768:     ;
02:0003C9C2 41EC0084        	  7769:     lea     ($0084,A4),A0
02:0003C9C6 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003C9CA 41EC042C        	  7771:     lea     ($042C,A4),A0
02:0003C9CE 12302000        	  7772:     move.b  (A0,D2.W),D1
02:0003C9D2 B001            	  7773:     cmp.b   D1,D0
02:0003C9D4 65000096        	  7774:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7775:     ; Else reached the destination. Go to state 0.
                            	  7776:     ;
02:0003C9D8 7000            	  7777:     moveq   #0,D0
02:0003C9DA 41EC00AC        	  7778:     lea     ($00AC,A4),A0
02:0003C9DE 11802000        	  7779:     move.b  D0,(A0,D2.W)
                            	  7780:     ; Reset 16-bit vertical speed.
                            	  7781:     ;
02:0003C9E2 41EC0444        	  7782:     lea     ($0444,A4),A0
02:0003C9E6 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003C9EA 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003C9EE 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
02:0003C9F2 10342018        	  7788:     move.b  ($18,A4,D2.W),D0
02:0003C9F6 02000003        	  7789:     andi.b #$03,D0
02:0003C9FA 7600            	  7790:     moveq   #0,D3
02:0003C9FC 1600            	  7791:     move.b  D0,D3
02:0003C9FE 41F90003C80E    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003CA04 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003CA08 41EC0098        	  7794:     lea     ($0098,A4),A0
02:0003CA0C 11802000        	  7795:     move.b  D0,(A0,D2.W)
                            	  7796:     ; Randomly set distance-to-move to $30 or $70.
                            	  7797:     ;
02:0003CA10 10342018        	  7798:     move.b  ($18,A4,D2.W),D0
02:0003CA14 02000040        	  7799:     andi.b #$40,D0
02:0003CA18 123C0030        	  7800:     move.b  #$30,D1
02:0003CA1C D101            	  7801:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003CA1E 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003CA22 11802000        	  7803:     move.b  D0,(A0,D2.W)
                            	  7804:     ; Align the monster with a square horizontally.
                            	  7805:     ;
                            	  7806:     ; If in the left half of a square, align with that square.
                            	  7807:     ; If in the right half, align with the next square.
                            	  7808:     ;
02:0003CA26 10342070        	  7809:     move.b  ($70,A4,D2.W),D0
02:0003CA2A 023C00EE        	  7810:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA2E 123C0008        	  7811:     move.b  #$08,D1
02:0003CA32 D101            	  7812:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA34 020000F0        	  7813:     andi.b #$F0,D0
02:0003CA38 19802070        	  7814:     move.b  D0,($70,A4,D2.W)
                            	  7815:     ; Align the monster with a square vertically.
                            	  7816:     ;
                            	  7817:     ; If in the top half of a square, align with that square.
                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003CA3C 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003CA40 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003CA44 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA48 123C0008        	  7823:     move.b  #$08,D1
02:0003CA4C D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA4E 020000F0        	  7825:     andi.b #$F0,D0
                            	  7826:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7827:     ;
02:0003CA52 003C0011        	  7828:     ori     #$11,CCR  ; SEC: set C+X
02:0003CA56 123C0003        	  7829:     move.b  #$03,D1
02:0003CA5A 0A3C0010        	  7830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CA5E 9101            	  7831:     subx.b  D1,D0   ; SBC #$03
02:0003CA60 0A3C0010        	  7832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CA64 41EC0084        	  7833:     lea     ($0084,A4),A0
02:0003CA68 11802000        	  7834:     move.b  D0,(A0,D2.W)
                            	  7835:     even
