02:0003C84C 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003C850 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003C854 53302000        	  7600:     subq.b  #1,(A0,D2.W)
