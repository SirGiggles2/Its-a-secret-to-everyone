02:00039BA0 9101            	  1284:     subx.b  D1,D0   ; SBC #$2B
02:00039BA2 0A3C0010        	  1285:     eori    #$10,CCR  ; restore X = 6502 C
02:00039BA6 6008            	  1286:     jmp     _L_z04_UpdateBubble_Animate
