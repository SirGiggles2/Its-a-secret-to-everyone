02:0004300C 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:0004300E 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:00043012 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:00043014 7020            	  5803:     moveq   #32,D0
02:00043016 122C0001        	  5804:     move.b  ($0001,A4),D1
02:0004301A 8001            	  5805:     or.b  D1,D0
02:0004301C 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:00043020 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:00043024 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:00043026 103C00FF        	  5815:     move.b  #$FF,D0
02:0004302A 41EC0302        	  5816:     lea     ($0302,A4),A0
02:0004302E 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:00043032 1002            	  5818:     move.b  D2,D0
02:00043034 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:00043038 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:0004303C 102C0054        	  5829:     move.b  ($0054,A4),D0
02:00043040 02000003        	  5830:     andi.b #$03,D0
02:00043044 6708            	  5831:     beq  _anon_z05_122
02:00043046 7008            	  5832:     moveq   #8,D0
02:00043048 19400027        	  5833:     move.b  D0,($0027,A4)
02:0004304C 4E75            	  5834:     rts
