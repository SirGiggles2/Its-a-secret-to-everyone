                            	  7079:     ; If the bomb has not exploded (state $12), then
                            	  7080:     ; go see if Dodongo will eat it.
                            	  7081:     ;
02:0003C51C 0C000012        	  7082:     cmpi.b  #$12,D0
02:0003C520 6602            	  7083:     bne.s  __far_z_04_0065
02:0003C522 601A            	  7084:     jmp  Dodongo_TryEatBomb
                            	  7085: __far_z_04_0065:
                            	  7086:     ; If the object in the slot is actually a fire, then return.
                            	  7087:     ;
02:0003C524 0C000020        	  7088:     cmpi.b  #$20,D0
02:0003C528 6412            	  7089:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7090:     ; The bomb already blew up.
                            	  7091:     ; If the dust cloud is in range of the monster,
                            	  7092:     ; then set stunned state (2).
                            	  7093:     ;
02:0003C52A 7600            	  7094:     moveq   #0,D3
02:0003C52C 61000082        	  7095:     jsr     Dodongo_IsBombInRange
02:0003C530 660A            	  7096:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003C532 7002            	  7097:     moveq   #2,D0
02:0003C534 41EC00AC        	  7098:     lea     ($00AC,A4),A0
02:0003C538 11802000        	  7099:     move.b  D0,(A0,D2.W)
                            	  7100:     even
                            	  7101: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003C53C 4E75            	  7102:     rts
                            	  7103: 
                            	  7104:     even
                            	  7105: Dodongo_TryEatBomb:
                            	  7106:     ; Try to eat the bomb.
                            	  7107:     ;
                            	  7108:     ; If the bomb is not in range of the monster, then return.
                            	  7109:     ;
                            	  7110:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7111:     ;
02:0003C53E 7601            	  7112:     moveq   #1,D3
02:0003C540 616E            	  7113:     jsr     Dodongo_IsBombInRange
02:0003C542 6666            	  7114:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7115:     ; Will loop from 1 to 0, indexed by [00].
                            	  7116:     ;
02:0003C544 7001            	  7117:     moveq   #1,D0
02:0003C546 1880            	  7118:     move.b  D0,($0000,A4)
                            	  7119:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7120:     ;
02:0003C548 41EC0098        	  7121:     lea     ($0098,A4),A0
02:0003C54C 10302000        	  7122:     move.b  (A0,D2.W),D0
02:0003C550 E208            	  7123:     lsr.b  #1,D0   ; LSR A
02:0003C552 7600            	  7124:     moveq   #0,D3
02:0003C554 1600            	  7125:     move.b  D0,D3
                            	  7126:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7127:     ; position depends on the orientation of the monster.
                            	  7128:     ;
                            	  7129:     ; Start with the horizontal distance.
                            	  7130:     ;
02:0003C556 102C0004        	  7131:     move.b  ($0004,A4),D0
                            	  7132:     even
                            	  7133: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7134:     ; Look up the limits for the given direction.
                            	  7135:     ;
                            	  7136:     ; If the distance from the bomb < negative limit,
                            	  7137:     ; or >= positive limit, then return.
                            	  7138:     ;
                            	  7139:     ; Note that these are simple signed comparisons that work,
                            	  7140:     ; because the operands are in a small range.
                            	  7141:     ;
02:0003C55A 41F90003C494    	  7142:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003C560 12303000        	  7143:     move.b  (A0,D3.W),D1
02:0003C564 B001            	  7144:     cmp.b   D1,D0
02:0003C566 6B42            	  7145:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003C568 41F90003C49A    	  7146:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003C56E 12303000        	  7147:     move.b  (A0,D3.W),D1
02:0003C572 B001            	  7148:     cmp.b   D1,D0
02:0003C574 6A34            	  7149:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7150:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7151:     ;
02:0003C576 1003            	  7152:     move.b  D3,D0
02:0003C578 023C00EE        	  7153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C57C 123C000A        	  7154:     move.b  #$0A,D1
02:0003C580 D101            	  7155:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003C582 7600            	  7156:     moveq   #0,D3
02:0003C584 1600            	  7157:     move.b  D0,D3
                            	  7158:     ; Bottom of the loop.
                            	  7159:     ;
                            	  7160:     ; Load the vertical distance for the next iteration.
                            	  7161:     ; Decrement loop counter.
                            	  7162:     ;
02:0003C586 102C0005        	  7163:     move.b  ($0005,A4),D0
02:0003C58A 5314            	  7164:     subq.b  #1,($0000,A4)
02:0003C58C 6ACC            	  7165:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7166:     ; If we get here, then the bomb was within range of the mouth.
                            	  7167:     ; Go to state 1 (bloated).
                            	  7168:     ;
02:0003C58E 41EC00AC        	  7169:     lea     ($00AC,A4),A0
02:0003C592 52302000        	  7170:     addq.b  #1,(A0,D2.W)
                            	  7171:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7172:     ;
02:0003C596 7610            	  7173:     moveq   #16,D3
02:0003C598 7000            	  7174:     moveq   #0,D0
02:0003C59A 41EC00AC        	  7175:     lea     ($00AC,A4),A0
02:0003C59E 11803000        	  7176:     move.b  D0,(A0,D3.W)
02:0003C5A2 41EC042C        	  7177:     lea     ($042C,A4),A0
02:0003C5A6 11802000        	  7178:     move.b  D0,(A0,D2.W)
                            	  7179:     even
                            	  7180: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003C5AA 4E75            	  7181:     rts
                            	  7182: 
                            	  7183:     even
                            	  7184: DodongoBombPositiveLimits:
02:0003C5AC 0C              	  7185:     dc.b    $0C, $11
02:0003C5AD 11
                            	  7186: 
                            	  7187:     even
                            	  7188: DodongoBombNegativeLimits:
02:0003C5AE F4              	  7189:     dc.b    $F4, $F0
02:0003C5AF F0
                            	  7190: 
                            	  7191: ; Params:
                            	  7192: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7193: ; [00]: monster hotspot X
                            	  7194: ; [01]: monster hotspot Y
                            	  7195: ; [02]: bomb hotspot X
                            	  7196: ; [03]: bomb hotspot Y
                            	  7197: ;
                            	  7198: ; Returns:
                            	  7199: ; A: 0 if the bomb is in range of the monster
                            	  7200: ; Z: 1 if the bomb is in range of the monster
                            	  7201: ; [04]: horizontal distance
                            	  7202: ; [05]: vertical distance
                            	  7203: ;
                            	  7204: ; Store the positive limit in [06], and the negative one in [07].
                            	  7205: ;
                            	  7206:     even
                            	  7207: Dodongo_IsBombInRange:
02:0003C5B0 41F90003C5AC    	  7208:     lea     (DodongoBombPositiveLimits).l,A0
02:0003C5B6 10303000        	  7209:     move.b  (A0,D3.W),D0
02:0003C5BA 19400006        	  7210:     move.b  D0,($0006,A4)
02:0003C5BE 41F90003C5AE    	  7211:     lea     (DodongoBombNegativeLimits).l,A0
02:0003C5C4 10303000        	  7212:     move.b  (A0,D3.W),D0
02:0003C5C8 19400007        	  7213:     move.b  D0,($0007,A4)
                            	  7214:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7215:     ; the bomb is near enough the monster.
                            	  7216:     ;
02:0003C5CC 7003            	  7217:     moveq   #3,D0
02:0003C5CE 19400008        	  7218:     move.b  D0,($0008,A4)
                            	  7219:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7220:     ;
02:0003C5D2 7601            	  7221:     moveq   #1,D3
                            	  7222:     even
                            	  7223: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7224:     ; Subtract the bomb's coordinate from the boss's,
                            	  7225:     ; The loop index determines the coordinate.
                            	  7226:     ;
02:0003C5D4 10343000        	  7227:     move.b  ($00,A4,D3.W),D0
02:0003C5D8 003C0011        	  7228:     ori     #$11,CCR  ; SEC: set C+X
02:0003C5DC 12343002        	  7229:     move.b  ($02,A4,D3.W),D1
02:0003C5E0 0A3C0010        	  7230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5E4 9101            	  7231:     subx.b  D1,D0   ; SBC $0002,Y
02:0003C5E6 0A3C0010        	  7232:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7233:     ; If the distance >= positive offset, or < negative offset;
                            	  7234:     ; then loop again.
                            	  7235:     ;
02:0003C5EA 122C0006        	  7236:     move.b  ($0006,A4),D1
02:0003C5EE B001            	  7237:     cmp.b   D1,D0
02:0003C5F0 6A16            	  7238:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003C5F2 122C0007        	  7239:     move.b  ($0007,A4),D1
02:0003C5F6 B001            	  7240:     cmp.b   D1,D0
02:0003C5F8 6B0E            	  7241:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7242:     ; The distance is close enough in this axis.
                            	  7243:     ;
                            	  7244:     ; Store the distance in this axis in [05] or [04],
                            	  7245:     ; depending on the loop index.
                            	  7246:     ;
02:0003C5FA 19803004        	  7247:     move.b  D0,($04,A4,D3.W)
                            	  7248:     ; Shift [08] right, because we're in range in this axis.
                            	  7249:     ;
02:0003C5FE 122C0008        	  7250:     move.b  ($0008,A4),D1
02:0003C602 E209            	  7251:     lsr.b  #1,D1   ; LSR $08
02:0003C604 19410008        	  7252:     move.b  D1,($0008,A4)
                            	  7253:     even
                            	  7254: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003C608 5303            	  7255:     subq.b  #1,D3
02:0003C60A 6AC8            	  7256:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7257:     ; If close enough in both axes, then [08] will be 0.
                            	  7258:     ;
02:0003C60C 102C0008        	  7259:     move.b  ($0008,A4),D0
02:0003C610 4E75            	  7260:     rts
                            	  7261: 
                            	  7262: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7263: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7264: ;
                            	  7265: ; But these are not typical direction indexes. Instead a
                            	  7266: ; 5-way index is used.
                            	  7267: ; A direction shifted right once becomes a 5-way index.
                            	  7268: ; The fourth element is unused.
                            	  7269: ;
                            	  7270:     even
                            	  7271: DodongoFrameImages:
02:0003C612 00              	  7272:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003C613 01
02:0003C614 06
02:0003C615 FF
02:0003C616 08
02:0003C617 02
02:0003C618 03
02:0003C619 06
02:0003C61A FF              	  7273:     dc.b    $FF, $08
02:0003C61B 08
                            	  7274: 
                            	  7275:     even
                            	  7276: DodongoFrameHFlips:
02:0003C61C 00              	  7277:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003C61D 40
02:0003C61E 00
02:0003C61F FF
02:0003C620 00
02:0003C621 00
02:0003C622 40
02:0003C623 40
02:0003C624 FF              	  7278:     dc.b    $FF, $40
02:0003C625 40
                            	  7279: 
                            	  7280:     even
                            	  7281: DodongoFrameImagesBloated:
02:0003C626 04              	  7282:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003C627 05
02:0003C628 07
02:0003C629 FF
02:0003C62A 09
02:0003C62B 04
02:0003C62C 05
02:0003C62D 07
02:0003C62E FF              	  7283:     dc.b    $FF, $09
02:0003C62F 09
                            	  7284: 
                            	  7285:     even
                            	  7286: DodongoFrameHFlipsBloated:
02:0003C630 00              	  7287:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003C631 40
02:0003C632 00
02:0003C633 FF
02:0003C634 00
02:0003C635 00
02:0003C636 40
02:0003C637 00
02:0003C638 FF              	  7288:     dc.b    $FF, $00
02:0003C639 00
                            	  7289: 
                            	  7290:     even
                            	  7291: Dodongo_Draw:
02:0003C63A 610000F4        	  7292:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7293:     ; Make a 5-way direction index out of the facing direction
                            	  7294:     ; by shifting right once, and store it in [00].
                            	  7295:     ;
02:0003C63E 41EC0098        	  7296:     lea     ($0098,A4),A0
02:0003C642 10302000        	  7297:     move.b  (A0,D2.W),D0
02:0003C646 E208            	  7298:     lsr.b  #1,D0   ; LSR A
02:0003C648 1880            	  7299:     move.b  D0,($0000,A4)
                            	  7300:     ; If state = 0, go handle animating the two frames of this state.
                            	  7301:     ;
02:0003C64A 7600            	  7302:     moveq   #0,D3
02:0003C64C 41EC00AC        	  7303:     lea     ($00AC,A4),A0
02:0003C650 16302000        	  7304:     move.b  (A0,D2.W),D3
02:0003C654 6744            	  7305:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7306:     ; If state > 1, then the monster is stunned (state 2).
                            	  7307:     ; So, go switch frames every $20 screen frames.
                            	  7308:     ;
02:0003C656 7020            	  7309:     moveq   #32,D0
02:0003C658 5303            	  7310:     subq.b  #1,D3
02:0003C65A 6640            	  7311:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7312:     ; State = 1. Bloated.
                            	  7313:     ;
                            	  7314:     ; In substate 0, go animate as usual for walking.
                            	  7315:     ;
02:0003C65C 7600            	  7316:     moveq   #0,D3
02:0003C65E 41EC042C        	  7317:     lea     ($042C,A4),A0
02:0003C662 16302000        	  7318:     move.b  (A0,D2.W),D3
02:0003C666 6732            	  7319:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7320:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7321:     ; go fade the boss; so that some frames are not drawn.
                            	  7322:     ;
02:0003C668 0C030002        	  7323:     cmpi.b  #$02,D3
02:0003C66C 6718            	  7324:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003C66E 0C030003        	  7325:     cmpi.b  #$03,D3
02:0003C672 6712            	  7326:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7327:     ; State 1, substate 1
                            	  7328:     ;
                            	  7329:     ; Add $14 to the frame image index to index into the bloated
                            	  7330:     ; frame images and H-flips.
                            	  7331:     ;
02:0003C674 1014            	  7332:     move.b  ($0000,A4),D0
02:0003C676 023C00EE        	  7333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C67A 123C0014        	  7334:     move.b  #$14,D1
02:0003C67E D101            	  7335:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003C680 7600            	  7336:     moveq   #0,D3
02:0003C682 1600            	  7337:     move.b  D0,D3
02:0003C684 6032            	  7338:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7339: 
                            	  7340:     even
                            	  7341: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7342:     ; In bloated substates 2 and 3:
                            	  7343:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7344:     ;
02:0003C686 102C0015        	  7345:     move.b  ($0015,A4),D0
02:0003C68A 02000002        	  7346:     andi.b #$02,D0
02:0003C68E 6604            	  7347:     bne.s  __far_z_04_0066
02:0003C690 600000A4        	  7348:     jmp  L11B00_Exit
                            	  7349: __far_z_04_0066:
02:0003C694 7600            	  7350:     moveq   #0,D3
02:0003C696 1614            	  7351:     move.b  ($0000,A4),D3
02:0003C698 601E            	  7352:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7353: 
                            	  7354:     even
                            	  7355: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7356:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7357:     ;
02:0003C69A 7008            	  7358:     moveq   #8,D0
                            	  7359:     even
                            	  7360: _L_z04_Dodongo_Draw_DrawWalking:
02:0003C69C 7600            	  7361:     moveq   #0,D3
02:0003C69E 1614            	  7362:     move.b  ($0000,A4),D3
02:0003C6A0 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003C6A4 C001            	  7364:     and.b  D1,D0
02:0003C6A6 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003C6A8 1003            	  7369:     move.b  D3,D0
02:0003C6AA 023C00EE        	  7370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C6AE 123C0005        	  7371:     move.b  #$05,D1
02:0003C6B2 D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003C6B4 7600            	  7373:     moveq   #0,D3
02:0003C6B6 1600            	  7374:     move.b  D0,D3
                            	  7375:     even
                            	  7376: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7377:     ; Start preparing sprites.
                            	  7378:     ;
02:0003C6B8 4EB90004C486    	  7379:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003C6BE 1003            	  7380:     move.b  D3,D0
02:0003C6C0 1B00            	  7381:     move.b  D0,-(A5)  ; PHA
                            	  7382:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7383:     ;
02:0003C6C2 41F90003C61C    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003C6C8 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003C6CC 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003C6D0 41F90003C612    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003C6D6 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
                            	  7391:     ;
02:0003C6DA 0C000007        	  7392:     cmpi.b  #$07,D0
02:0003C6DE 6706            	  7393:     beq  _anon_z04_92
02:0003C6E0 0C000009        	  7394:     cmpi.b  #$09,D0
02:0003C6E4 6608            	  7395:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7396: _anon_z04_92:
02:0003C6E6 4EB900031334    	  7397:     jsr     DrawObjectMirrored
02:0003C6EC 6006            	  7398:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7399: 
                            	  7400:     even
                            	  7401: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7402:     ; No other frame images are mirrored.
                            	  7403:     ;
02:0003C6EE 4EB900031338    	  7404:     jsr     DrawObjectNotMirrored
                            	  7405:     even
                            	  7406: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003C6F4 101D            	  7407:     move.b  (A5)+,D0  ; PLA
02:0003C6F6 7600            	  7408:     moveq   #0,D3
02:0003C6F8 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003C6FA 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003C6FE 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003C702 02000003        	  7414:     andi.b #$03,D0
02:0003C706 6602            	  7415:     bne.s  __far_z_04_0067
02:0003C708 602C            	  7416:     jmp  L11B00_Exit
                            	  7417: __far_z_04_0067:
                            	  7418:     ; Else draw the right side.
                            	  7419:     ;
                            	  7420:     ; Keep the Y coordinate in [01].
                            	  7421:     ; But, store (X + $10) in [00].
                            	  7422:     ;
02:0003C70A 10342070        	  7423:     move.b  ($70,A4,D2.W),D0
02:0003C70E 023C00EE        	  7424:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C712 123C0010        	  7425:     move.b  #$10,D1
02:0003C716 D101            	  7426:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C718 1880            	  7427:     move.b  D0,($0000,A4)
02:0003C71A 6114            	  7428:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7429:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7430:     ;
                            	  7431:     ; So, if we had animation frame 1, direction left:
                            	  7432:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7433:     ; - frame image index = 6 (1 + 5)
                            	  7434:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7435:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7436:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7437:     ;
                            	  7438:     ; So, 3 would have been the frame number used above for
                            	  7439:     ; the left side.
                            	  7440:     ;
                            	  7441:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7442:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7443:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7444:     ; on the right.
                            	  7445:     ;
02:0003C71C 41F90003C612    	  7446:     lea     (DodongoFrameImages).l,A0
02:0003C722 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003C726 0A000001        	  7448:     eori.b #$01,D0
02:0003C72A 4EF900031338    	  7449:     jmp     DrawObjectNotMirrored
                            	  7450: 
                            	  7451: ; Returns:
                            	  7452: ; A: 3
                            	  7453: ; [04]: left sprite attributes
                            	  7454: ; [05]: right sprite attributes
                            	  7455: ;
                            	  7456:     even
                            	  7457: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003C730 4EF90002C312    	  7458:     jmp     c_anim_set_sprite_desc_level_palette_row
