                            	  6539:     ; Decrement the distance remaining.
                            	  6540:     ;
02:0003C134 41EC0394        	  6541:     lea     ($0394,A4),A0
02:0003C138 53302000        	  6542:     subq.b  #1,(A0,D2.W)
                            	  6543:     even
