                            	  1718: ;------------------------------------------------------------------------------
                            	  1719: ; _copy_bank_to_window
                            	  1720: ;   D0.w = bank number (0-7)
                            	  1721: ;   Copies bank 0-6 into $FF8000 when cache misses. Bank 7 is exempt.
                            	  1722: ;------------------------------------------------------------------------------
                            	  1723: _copy_bank_to_window:
02:0002A9FA 02400007        	  1724:     andi.w  #$0007,D0
02:0002A9FE 0C400007        	  1725:     cmpi.w  #7,D0
02:0002AA02 6734            	  1726:     beq.s   .skip
02:0002AA04 B03900FF083F    	  1727:     cmp.b   (_current_window_bank).l,D0
02:0002AA0A 672C            	  1728:     beq.s   .skip
02:0002AA0C 48E740C0        	  1729:     movem.l D1/A0-A1,-(SP)
02:0002AA10 3200            	  1730:     move.w  D0,D1
02:0002AA12 E549            	  1731:     lsl.w   #2,D1
02:0002AA14 41F90002A9DA    	  1732:     lea     (_bank_rom_bases).l,A0
02:0002AA1A 20701000        	  1733:     movea.l (A0,D1.W),A0
02:0002AA1E 43F900FF8000    	  1734:     lea     (BANK_WINDOW_BASE).l,A1
02:0002AA24 323C0FFF        	  1735:     move.w  #BANK_WINDOW_SIZE/4-1,D1
                            	  1736: .copy_loop:
02:0002AA28 22D8            	  1737:     move.l  (A0)+,(A1)+
02:0002AA2A 51C9FFFC        	  1738:     dbra    D1,.copy_loop
02:0002AA2E 13C000FF083F    	  1739:     move.b  D0,(_current_window_bank).l
02:0002AA34 4CDF0302        	  1740:     movem.l (SP)+,D1/A0-A1
                            	  1741: .skip:
02:0002AA38 4E75            	  1742:     rts
                            	  1743: 
                            	  1744: ;------------------------------------------------------------------------------
                            	  1745: ; _ensure_bank_window
                            	  1746: ;   Reads MMC1_PRG and ensures $FF8000 currently mirrors that PRG bank.
                            	  1747: ;   Preserves D0 and all address registers used by callers.
                            	  1748: ;------------------------------------------------------------------------------
                            	  1749: _ensure_bank_window:
02:0002AA3A 48E78000        	  1750:     movem.l D0,-(SP)
02:0002AA3E 7000            	  1751:     moveq   #0,D0
02:0002AA40 103900FF0815    	  1752:     move.b  (MMC1_PRG).l,D0
02:0002AA46 02400007        	  1753:     andi.w  #$0007,D0
02:0002AA4A B03900FF083F    	  1754:     cmp.b   (_current_window_bank).l,D0
02:0002AA50 6702            	  1755:     beq.s   .done
02:0002AA52 61A6            	  1756:     bsr     _copy_bank_to_window
                            	  1757: .done:
02:0002AA54 4CDF0001        	  1758:     movem.l (SP)+,D0
02:0002AA58 4E75            	  1759:     rts
                            	  1760: 
                            	  1761: ;==============================================================================
                            	  1762: ; Controller I/O
                            	  1763: ;==============================================================================
                            	  1764: 
                            	  1765: ;------------------------------------------------------------------------------
                            	  1766: ; _ctrl_strobe — $4016 write (T27).
                            	  1767: ;
                            	  1768: ; On every call: read Genesis controller 1 via hardware I/O (TH two-phase),
                            	  1769: ; build an 8-bit NES button latch byte, and reset the serial read index.
                            	  1770: ;
                            	  1771: ; NES button order (bit0=A, bit1=B, bit2=Sel, bit3=Start,
                            	  1772: ;                   bit4=Up, bit5=Down, bit6=Left, bit7=Right).
                            	  1773: ; Genesis bits are active-low (0 = pressed).
                            	  1774: ;
                            	  1775: ; Latch storage (in Genesis work-RAM above NES address space):
                            	  1776: ;   CTL1_LATCH = ($1100,A4) = $FF1100 — latched NES button byte
                            	  1777: ;   CTL1_IDX   = ($1101,A4) = $FF1101 — serial read index (0–7)
                            	  1778: ;------------------------------------------------------------------------------
                            	  1779: _ctrl_strobe:
                            	  1780:     ; Gate: the NES protocol writes $01 then $00 to $4016.  The transpiled
                            	  1781:     ; code preserves this as two jsr _ctrl_strobe calls — first with D0=1
                            	  1782:     ; (strobe-on), then D0=0 (strobe-off = latch).  Only the D0=0 call
                            	  1783:     ; needs to actually poll the pad.  Skipping the D0=1 call halves the
                            	  1784:     ; TH toggle frequency, which prevents ReadOneController's debounce
                            	  1785:     ; loop from trapping on real hardware where rapid toggling produces
                            	  1786:     ; inconsistent reads from the 3-button pad multiplexer.
02:0002AA5A 4A00            	  1787:     tst.b   D0
02:0002AA5C 660000A0        	  1788:     bne     .cs_skip             ; D0 != 0 → strobe-on phase, no-op
                            	  1789: 
02:0002AA60 48E77000        	  1790:     movem.l D1-D3,-(SP)
                            	  1791:     ; Phase 1: TH=1 → bits[5:4]=C,B  bits[3:0]=Right,Left,Down,Up (active low)
                            	  1792:     ; CTRL register ($A10009) already set to $40 by EntryPoint init.
02:0002AA64 13FC004000A10003	  1793:     move.b  #$40,($A10003).l    ; assert TH=1
02:0002AA6C 4E71            	  1794:     nop                          ; 4 NOPs settling time for real hardware
02:0002AA6E 4E71            	  1795:     nop
02:0002AA70 4E71            	  1796:     nop
02:0002AA72 4E71            	  1797:     nop
02:0002AA74 123900A10003    	  1798:     move.b  ($A10003).l,D1      ; D1 = TH=1 data
                            	  1799:     ; Phase 2: TH=0 → bits[5:4]=Start,A  bits[3:0]=Right,Left,Down,Up (active low)
02:0002AA7A 13FC000000A10003	  1800:     move.b  #$00,($A10003).l    ; assert TH=0
02:0002AA82 4E71            	  1801:     nop
02:0002AA84 4E71            	  1802:     nop
02:0002AA86 4E71            	  1803:     nop
02:0002AA88 4E71            	  1804:     nop
02:0002AA8A 143900A10003    	  1805:     move.b  ($A10003).l,D2      ; D2 = TH=0 data
                            	  1806:     ; Restore TH=1 idle state (standard Genesis practice)
02:0002AA90 13FC004000A10003	  1807:     move.b  #$40,($A10003).l
                            	  1808:     ; Build NES button byte
                            	  1809:     ; Button mapping (user request): NES B = Genesis A, NES A = Genesis B.
                            	  1810:     ; Genesis B sits where the user's primary attack thumb lands, so it
                            	  1811:     ; drives the NES "sword/attack" (NES A).  Genesis A falls to NES B
                            	  1812:     ; ("item" — boomerang, bombs, candle, etc.).
02:0002AA98 7600            	  1813:     moveq   #0,D3
02:0002AA9A 08010004        	  1814:     btst    #4,D1               ; Genesis B: TH=1 bit4 (active low) → NES A
02:0002AA9E 6604            	  1815:     bne.s   .cs_no_a
02:0002AAA0 08C30000        	  1816:     bset    #0,D3
                            	  1817: .cs_no_a:
02:0002AAA4 08020004        	  1818:     btst    #4,D2               ; Genesis A: TH=0 bit4 (active low) → NES B
02:0002AAA8 6604            	  1819:     bne.s   .cs_no_b
02:0002AAAA 08C30001        	  1820:     bset    #1,D3
                            	  1821: .cs_no_b:
                            	  1822:     ; Phase 2.3: Genesis C → NES Select remap.  The 3-button pad has no
                            	  1823:     ; hardware Select; the diary standardized on C so the user can
                            	  1824:     ; eliminate save slots in file-select and access the NES pause menu.
02:0002AAAE 08010005        	  1825:     btst    #5,D1               ; C button: TH=1 bit5 (active low)
02:0002AAB2 6604            	  1826:     bne.s   .cs_no_select
02:0002AAB4 08C30002        	  1827:     bset    #2,D3               ; NES Select
                            	  1828: .cs_no_select:
02:0002AAB8 08020005        	  1829:     btst    #5,D2               ; Start: TH=0 bit5 (active low)
02:0002AABC 6604            	  1830:     bne.s   .cs_no_start
02:0002AABE 08C30003        	  1831:     bset    #3,D3
                            	  1832: .cs_no_start:
02:0002AAC2 08010000        	  1833:     btst    #0,D1               ; Up: TH=1 bit0 (active low)
02:0002AAC6 6604            	  1834:     bne.s   .cs_no_up
02:0002AAC8 08C30004        	  1835:     bset    #4,D3
                            	  1836: .cs_no_up:
02:0002AACC 08010001        	  1837:     btst    #1,D1               ; Down: TH=1 bit1 (active low)
02:0002AAD0 6604            	  1838:     bne.s   .cs_no_down
02:0002AAD2 08C30005        	  1839:     bset    #5,D3
                            	  1840: .cs_no_down:
02:0002AAD6 08010002        	  1841:     btst    #2,D1               ; Left: TH=1 bit2 (active low)
02:0002AADA 6604            	  1842:     bne.s   .cs_no_left
02:0002AADC 08C30006        	  1843:     bset    #6,D3
                            	  1844: .cs_no_left:
02:0002AAE0 08010003        	  1845:     btst    #3,D1               ; Right: TH=1 bit3 (active low)
02:0002AAE4 6604            	  1846:     bne.s   .cs_no_right
02:0002AAE6 08C30007        	  1847:     bset    #7,D3
                            	  1848: .cs_no_right:
02:0002AAEA 19431100        	  1849:     move.b  D3,($1100,A4)       ; store latched NES button byte
02:0002AAEE 197C00001101    	  1850:     move.b  #0,($1101,A4)       ; reset serial index
02:0002AAF4 523900FF100A    	  1851:     addq.b  #1,($00FF100A).l    ; Phase 2.4: input-poll probe counter
02:0002AAFA 4CDF000E        	  1852:     movem.l (SP)+,D1-D3
                            	  1853: .cs_skip:
02:0002AAFE 4E75            	  1854:     rts
                            	  1855: 
                            	  1856: ;------------------------------------------------------------------------------
                            	  1857: ; _ctrl_read_1 — $4016 read (T27).
                            	  1858: ;
                            	  1859: ; Returns the next button bit from the latch in D0.b (bit0 = button state,
                            	  1860: ; 1 = pressed).  Buttons are in NES order: A, B, Sel, Start, Up, Down, Left,
                            	  1861: ; Right (index 0–7).  Returns 0 when index overflows past 7.
                            	  1862: ;------------------------------------------------------------------------------
                            	  1863: _ctrl_read_1:
02:0002AB00 7200            	  1864:     moveq   #0,D1
02:0002AB02 122C1101        	  1865:     move.b  ($1101,A4),D1       ; D1.l = current index (zero-extended)
02:0002AB06 0C010008        	  1866:     cmpi.b  #8,D1
02:0002AB0A 6C12            	  1867:     bge.s   .cr1_overflow
02:0002AB0C 522C1101        	  1868:     addq.b  #1,($1101,A4)       ; advance index for next read
02:0002AB10 7000            	  1869:     moveq   #0,D0
02:0002AB12 102C1100        	  1870:     move.b  ($1100,A4),D0       ; D0 = latched button byte
02:0002AB16 E228            	  1871:     lsr.b   D1,D0               ; shift right by index → target bit in bit0
02:0002AB18 02000001        	  1872:     andi.b  #1,D0               ; isolate bit0
02:0002AB1C 4E75            	  1873:     rts
                            	  1874: .cr1_overflow:
02:0002AB1E 7000            	  1875:     moveq   #0,D0
02:0002AB20 4E75            	  1876:     rts
                            	  1877: 
                            	  1878: ;------------------------------------------------------------------------------
                            	  1879: ; _ctrl_read_2 — $4017 read: controller 2 / frame counter.
                            	  1880: ; Return 0.
                            	  1881: ;------------------------------------------------------------------------------
                            	  1882: _ctrl_read_2:
02:0002AB22 7000            	  1883:     moveq   #0,D0
02:0002AB24 4E75            	  1884:     rts
                            	  1885: 
                            	  1886: ;==============================================================================
                            	  1887: ; SRAM helpers (Phase 9.7)
                            	  1888: ;==============================================================================
                            	  1889: ;
                            	  1890: ; Genesis cartridges declare battery-backed SRAM in the ROM header at
                            	  1891: ; $1B0-$1BB.  We declare a 4 KB odd-byte SRAM region at $200001-$203FFF
                            	  1892: ; (genesis_shell.asm).  In gpgx and on real Mega Everdrive flashcarts the
                            	  1893: ; cart area at $200000 is shared between ROM and SRAM; writing $01 to the
                            	  1894: ; mapper port at $A130F1 swaps SRAM in.  Writing $00 swaps ROM back.
                            	  1895: ;
                            	  1896: ; Logical SRAM offset N (0 .. $1FFF) maps to bus address $200001 + (N << 1):
                            	  1897: ; only the odd byte of each word is wired up, hence the 8 KB cart-address
                            	  1898: ; window for 4 KB of usable storage.
                            	  1899: ;
                            	  1900: ; Helpers leave the mapping in the SRAM-enabled state after _sram_enable so
                            	  1901: ; the save-slot read/write helpers in 9.8 don't have to toggle the port on
                            	  1902: ; every byte.  Boot calls _sram_enable once from EntryPoint.
                            	  1903: ;------------------------------------------------------------------------------
                            	  1904: 
                            	  1905: SRAM_PORT       equ $A130F1
                            	  1906: SRAM_BASE_ODD   equ $200001
                            	  1907: 
                            	  1908: ;------------------------------------------------------------------------------
                            	  1909: ; P31: FileBChecksums — relocated from ROM code label to writable work RAM.
                            	  1910: ;
                            	  1911: ; On NES, this was a RAM variable holding 6 bytes (3 slots × 2-byte checksum).
                            	  1912: ; The transpiler incorrectly placed it as a code label inside z_01.asm, which
                            	  1913: ; maps to ROM on Genesis.  All writes silently fail on real hardware, breaking
                            	  1914: ; the File B → File A copy chain (checksums never match on re-read).
                            	  1915: ;
                            	  1916: ; $FF1200 is in the NES RAM mirror range ($0800-$1FFF) which is valid writable
                            	  1917: ; work RAM on Genesis but unused by any NES game code.
                            	  1918: ;------------------------------------------------------------------------------
                            	  1919: FileBChecksums  equ $00FF1200
                            	  1920: 
                            	  1921: ;------------------------------------------------------------------------------
                            	  1922: ; _sram_enable — switch cart area to SRAM mapping.  Clobbers nothing.
                            	  1923: ;------------------------------------------------------------------------------
                            	  1924: _sram_enable:
02:0002AB26 13FC000100A130F1	  1925:     move.b  #$01,(SRAM_PORT).l
02:0002AB2E 4E75            	  1926:     rts
                            	  1927: 
                            	  1928: ;------------------------------------------------------------------------------
                            	  1929: ; _sram_disable — switch cart area back to ROM.  Used by tooling only;
                            	  1930: ; gameplay leaves SRAM mapped in continuously.
                            	  1931: ;------------------------------------------------------------------------------
                            	  1932: _sram_disable:
02:0002AB30 13FC000000A130F1	  1933:     move.b  #$00,(SRAM_PORT).l
02:0002AB38 4E75            	  1934:     rts
                            	  1935: 
                            	  1936: ;------------------------------------------------------------------------------
                            	  1937: ; _sram_read_byte — read one byte from logical SRAM offset.
                            	  1938: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1939: ; Out: D0.b = byte
                            	  1940: ;------------------------------------------------------------------------------
                            	  1941: _sram_read_byte:
02:0002AB3A 48E70080        	  1942:     movem.l A0,-(SP)
02:0002AB3E 028000001FFF    	  1943:     andi.l  #$00001FFF,D0
02:0002AB44 D080            	  1944:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0002AB46 207C00200001    	  1945:     movea.l #SRAM_BASE_ODD,A0
02:0002AB4C 10300800        	  1946:     move.b  (A0,D0.L),D0
02:0002AB50 205F            	  1947:     movem.l (SP)+,A0
02:0002AB52 4E75            	  1948:     rts
                            	  1949: 
                            	  1950: ;------------------------------------------------------------------------------
                            	  1951: ; _sram_write_byte — write one byte to logical SRAM offset.
                            	  1952: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1953: ;      D1.b = byte to store
                            	  1954: ;------------------------------------------------------------------------------
                            	  1955: _sram_write_byte:
02:0002AB54 48E78080        	  1956:     movem.l A0/D0,-(SP)
02:0002AB58 028000001FFF    	  1957:     andi.l  #$00001FFF,D0
02:0002AB5E D080            	  1958:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0002AB60 207C00200001    	  1959:     movea.l #SRAM_BASE_ODD,A0
02:0002AB66 11810800        	  1960:     move.b  D1,(A0,D0.L)
02:0002AB6A 4CDF0101        	  1961:     movem.l (SP)+,A0/D0
02:0002AB6E 4E75            	  1962:     rts
                            	  1963: 
                            	  1964: ;------------------------------------------------------------------------------
                            	  1965: ; Phase 9.8 — bulk save-slot copy helpers.
                            	  1966: ;
                            	  1967: ; NES Zelda's three save slots live at NES $6000-$67FF (2 KB), which the
                            	  1968: ; shell mirrors at work RAM $FF6000-$FF67FF.  z_02 reads/writes go to that
                            	  1969: ; mirror via NES_SRAM equ $FF6000.  To make saves persist across power
                            	  1970: ; cycles we copy:
                            	  1971: ;   _sram_load_save_slots    cart SRAM → mirror   (called once at boot)
                            	  1972: ;   _sram_commit_save_slots  mirror   → cart SRAM (called from save funnel)
                            	  1973: ;
                            	  1974: ; Cart SRAM is odd-byte at $200001 with stride 2; logical offset N (0..$7FF)
                            	  1975: ; lands at bus $200001 + N*2.
                            	  1976: ;
                            	  1977: ; Both helpers preserve all caller registers.
                            	  1978: ;------------------------------------------------------------------------------
                            	  1979: _sram_load_save_slots:
02:0002AB70 48E7C0C0        	  1980:     movem.l D0/D1/A0/A1,-(SP)
02:0002AB74 207C00FF6000    	  1981:     movea.l #$00FF6000,A0               ; mirror destination
02:0002AB7A 227C00200001    	  1982:     movea.l #SRAM_BASE_ODD,A1           ; cart SRAM source ($200001)
02:0002AB80 323C07FF        	  1983:     move.w  #$07FF,D1                   ; 2048 bytes - 1
                            	  1984: .lsl_loop:
02:0002AB84 1011            	  1985:     move.b  (A1),D0
02:0002AB86 10C0            	  1986:     move.b  D0,(A0)+
02:0002AB88 5489            	  1987:     addq.l  #2,A1                       ; advance odd-byte stride
02:0002AB8A 51C9FFF8        	  1988:     dbra    D1,.lsl_loop
                            	  1989:     ; T36: Zero-fill the remainder of the NES SRAM window ($FF6800..$FF7FFF).
                            	  1990:     ; NES has 8 KB of SRAM at $6000-$7FFF but Zelda's save-slots only occupy
                            	  1991:     ; the first 2 KB ($6000-$67FF).  z_05 AssignObjSpawnPositions reads
                            	  1992:     ; SRAM[$08FE+$00EB] which can land past offset $7FF (e.g. $FF6975 for
                            	  1993:     ; OW room $77).  On NES those bytes read 0 (unmapped or cleared by
                            	  1994:     ; ROM init).  Without this zero-fill, the read hits work-RAM residue
                            	  1995:     ; and corrupts the cave-dweller type calculation ($0350 := $6A+idx),
                            	  1996:     ; spawning a phantom cave-person that halts Link via $00AC=$40.
                            	  1997:     ; A0 already points at $FF6800 after the slot copy.
02:0002AB8E 323C17FF        	  1998:     move.w  #$17FF,D1                   ; 6144 bytes - 1 ($6800..$7FFF)
02:0002AB92 7000            	  1999:     moveq   #0,D0
                            	  2000: .lsl_zero:
02:0002AB94 10C0            	  2001:     move.b  D0,(A0)+
02:0002AB96 51C9FFFC        	  2002:     dbra    D1,.lsl_zero
