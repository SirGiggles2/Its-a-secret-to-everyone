02:000411B6 6748            	  2943:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2944:     ; The direction is negative (left or up).
                            	  2945:     ;
                            	  2946:     ; If the coordinate does not cross (<) the boundary, then
                            	  2947:     ; go set mask $FF, so that no button is excluded.
                            	  2948:     ;
02:000411B8 102C0002        	  2949:     move.b  ($0002,A4),D0
02:000411BC 41F900041130    	  2950:     lea     (BorderBounds).l,A0
02:000411C2 12303000        	  2951:     move.b  (A0,D3.W),D1
02:000411C6 B001            	  2952:     cmp.b   D1,D0
02:000411C8 6548            	  2953:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2954:     even
