02:00030B9C 662E            	  3353:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  3354:     ; The effect involves turning grayscale rendering on and off
                            	  3355:     ; in PPUMASK.
                            	  3356:     ;
                            	  3357:     ; Start by setting A register to the PPU mask shifted right to
                            	  3358:     ; throw away the grayscale bit.
                            	  3359:     ;
02:00030B9E 102C00FE        	  3360:     move.b  ($00FE,A4),D0
02:00030BA2 E208            	  3361:     lsr.b  #1,D0   ; LSR A
                            	  3362:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  3363:     ;
02:00030BA4 7600            	  3364:     moveq   #0,D3
02:00030BA6 16342028        	  3365:     move.b  ($28,A4,D2.W),D3
                            	  3366:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  3367:     ; Carry will have been set, because of the comparison (CPY).
                            	  3368:     ;
02:00030BAA 0C030016        	  3369:     cmpi.b  #$16,D3
02:00030BAE 6706            	  3370:     beq  _anon_z01_54
02:00030BB0 0C030011        	  3371:     cmpi.b  #$11,D3
02:00030BB4 6604            	  3372:     bne  _L_z01_UpdateBombFlashEffect_Clear
