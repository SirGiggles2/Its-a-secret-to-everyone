02:00030240 41F9000301E1    	  1889:     lea     (TrapAllowedDirs-1).l,A0
02:00030246 12302000        	  1890:     move.b  (A0,D2.W),D1
02:0003024A C001            	  1891:     and.b  D1,D0
02:0003024C 6712            	  1892:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1893:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  1894:     ;
02:0003024E 41EC00AC        	  1895:     lea     ($00AC,A4),A0
02:00030252 52302000        	  1896:     addq.b  #1,(A0,D2.W)
02:00030256 7070            	  1897:     moveq   #112,D0
02:00030258 41EC03BC        	  1898:     lea     ($03BC,A4),A0
02:0003025C 11802000        	  1899:     move.b  D0,(A0,D2.W)
                            	  1900:     even
                            	  1901: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
