02:0003EB26 103C00C0        	 12223:     move.b  #$C0,D0
02:0003EB2A 19400028        	 12224:     move.b  D0,($0028,A4)
                            	 12225:     ; Set scene phase 1, and go draw Ganon.
                            	 12226:     ;
02:0003EB2E 522C0445        	 12227:     addq.b  #1,($0445,A4)
02:0003EB32 6702            	 12228:     beq.s  __far_z_04_0116
02:0003EB34 6032            	 12229:     jmp  Ganon_DrawBodyFrame0
                            	 12230: __far_z_04_0116:
