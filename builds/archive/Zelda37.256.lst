02:0003C008 41EC0084        	  6398:     lea     ($0084,A4),A0
02:0003C00C 10302000        	  6399:     move.b  (A0,D2.W),D0
02:0003C010 023C00EE        	  6400:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C014 41F90003BFD6    	  6401:     lea     (DigdoggerSpriteOffsetsY).l,A0
