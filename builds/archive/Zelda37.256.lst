02:0003CB2A 12302000        	  7927:     move.b  (A0,D2.W),D1
02:0003CB2E B001            	  7928:     cmp.b   D1,D0
02:0003CB30 651C            	  7929:     bcs  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003CB32 41EC03D0        	  7930:     lea     ($03D0,A4),A0
02:0003CB36 53302000        	  7931:     subq.b  #1,(A0,D2.W)
02:0003CB3A 6612            	  7932:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003CB3C E308            	  7933:     lsl.b  #1,D0   ; ASL A
02:0003CB3E 41EC03D0        	  7934:     lea     ($03D0,A4),A0
02:0003CB42 11802000        	  7935:     move.b  D0,(A0,D2.W)
02:0003CB46 41EC03E4        	  7936:     lea     ($03E4,A4),A0
