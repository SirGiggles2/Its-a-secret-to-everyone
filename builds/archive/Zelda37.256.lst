                            	  5571: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow:
                            	  5572:     ; Start preparing to draw an arrow.
                            	  5573:     ;
                            	  5574:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5575:     ; and no horizontal flipping in [0F].
                            	  5576:     ;
02:0004BB46 7002            	  5577:     moveq   #2,D0
02:0004BB48 1940000C        	  5578:     move.b  D0,($000C,A4)
02:0004BB4C 7000            	  5579:     moveq   #0,D0
02:0004BB4E 1940000F        	  5580:     move.b  D0,($000F,A4)
                            	  5581:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5582:     ; and go draw.
                            	  5583:     ;
02:0004BB52 41EC0098        	  5584:     lea     ($0098,A4),A0
02:0004BB56 10302000        	  5585:     move.b  (A0,D2.W),D0
02:0004BB5A 4EB90003088C    	  5586:     jsr     GetOppositeDir
02:0004BB60 7000            	  5587:     moveq   #0,D0
02:0004BB62 6000FEF0        	  5588:     jmp     SetAttrAndDrawArrow
                            	  5589: 
                            	  5590:     even
                            	  5591: CheckState30:
                            	  5592:     ; If major state <> $30, go check other states.
                            	  5593:     ;
02:0004BB66 0C000030        	  5594:     cmpi.b  #$30,D0
02:0004BB6A 6656            	  5595:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5596:     ; State $3x. Slow down.
                            	  5597:     ;
                            	  5598:     ; Reset grid offset for movement.
                            	  5599:     ;
02:0004BB6C 7000            	  5600:     moveq   #0,D0
02:0004BB6E 41EC0394        	  5601:     lea     ($0394,A4),A0
02:0004BB72 11802000        	  5602:     move.b  D0,(A0,D2.W)
                            	  5603:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5604:     ;
02:0004BB76 7040            	  5605:     moveq   #64,D0
02:0004BB78 41EC03BC        	  5606:     lea     ($03BC,A4),A0
02:0004BB7C 11802000        	  5607:     move.b  D0,(A0,D2.W)
                            	  5608:     ; If facing left and X < 2, then go change state to $40. The
                            	  5609:     ; boomerang is too close to the left edge of the screen.
                            	  5610:     ; Another move might make it wrap around.
                            	  5611:     ;
02:0004BB80 41EC0098        	  5612:     lea     ($0098,A4),A0
02:0004BB84 10302000        	  5613:     move.b  (A0,D2.W),D0
02:0004BB88 1940000F        	  5614:     move.b  D0,($000F,A4)
02:0004BB8C 02000002        	  5615:     andi.b #$02,D0
02:0004BB90 670A            	  5616:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004BB92 10342070        	  5617:     move.b  ($70,A4,D2.W),D0
02:0004BB96 0C000002        	  5618:     cmpi.b  #$02,D0
02:0004BB9A 650E            	  5619:     bcs  _L_z07_CheckState30_SetState40
                            	  5620:     even
                            	  5621: _L_z07_CheckState30_MoveBoomerang:
                            	  5622:     ; Move the boomerang.
                            	  5623:     ;
02:0004BB9C 6100F570        	  5624:     jsr     MoveObject
                            	  5625:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5626:     ; state to $40.
                            	  5627:     ;
02:0004BBA0 41EC0380        	  5628:     lea     ($0380,A4),A0
02:0004BBA4 53302000        	  5629:     subq.b  #1,(A0,D2.W)
02:0004BBA8 6614            	  5630:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5631:     even
                            	  5632: _L_z07_CheckState30_SetState40:
                            	  5633:     ; Set state $40, and a time to move of $20 frames.
                            	  5634:     ;
                            	  5635:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5636:     ;
                            	  5637:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5638:     ;
02:0004BBAA 7020            	  5639:     moveq   #32,D0
02:0004BBAC 41EC0380        	  5640:     lea     ($0380,A4),A0
02:0004BBB0 11802000        	  5641:     move.b  D0,(A0,D2.W)
02:0004BBB4 7040            	  5642:     moveq   #64,D0
02:0004BBB6 41EC00AC        	  5643:     lea     ($00AC,A4),A0
02:0004BBBA 11802000        	  5644:     move.b  D0,(A0,D2.W)
                            	  5645:     even
                            	  5646: _L_z07_CheckState30_AnimateBoomerang:
02:0004BBBE 600000EC        	  5647:     jmp     AnimateBoomerangAndCheckCollision
                            	  5648: 
                            	  5649:     even
                            	  5650: _L_z07_CheckState30_CheckOtherStates:
                            	  5651:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5652:     ;
                            	  5653:     ; The boomerang will now return. Reset the grid offset.
                            	  5654:     ;
02:0004BBC2 7000            	  5655:     moveq   #0,D0
02:0004BBC4 41EC0394        	  5656:     lea     ($0394,A4),A0
02:0004BBC8 11802000        	  5657:     move.b  D0,(A0,D2.W)
                            	  5658:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5659:     ;
02:0004BBCC 0C02000D        	  5660:     cmpi.b  #$0D,D2
02:0004BBD0 6408            	  5661:     bcc  _anon_z07_30
02:0004BBD2 41EC042C        	  5662:     lea     ($042C,A4),A0
02:0004BBD6 10302000        	  5663:     move.b  (A0,D2.W),D0
                            	  5664: _anon_z07_30:
02:0004BBDA 4EB9000308E4    	  5665:     jsr     GetDirectionsAndDistancesToTarget
                            	  5666:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5667:     ; then go move towards the thrower, draw, and check collisions.
                            	  5668:     ;
02:0004BBE0 1014            	  5669:     move.b  ($0000,A4),D0
02:0004BBE2 0C000002        	  5670:     cmpi.b  #$02,D0
02:0004BBE6 666A            	  5671:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5672:     ; The boomerang has reached the thrower.
                            	  5673:     ;
                            	  5674:     ; Reset the distance to move.
                            	  5675:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5676:     ;
02:0004BBE8 7000            	  5677:     moveq   #0,D0
02:0004BBEA 41EC0380        	  5678:     lea     ($0380,A4),A0
02:0004BBEE 11802000        	  5679:     move.b  D0,(A0,D2.W)
02:0004BBF2 0C02000D        	  5680:     cmpi.b  #$0D,D2
02:0004BBF6 6524            	  5681:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5682:     ; Link has caught the boomerang.
                            	  5683:     ;
                            	  5684:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; If Link catches it some time after throwing it,
                            	  5687:     ; his state will become $20, and he will show the catch animation.
                            	  5688:     ;
                            	  5689:     ; But if he catches it right after throwing it, the state becomes
                            	  5690:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5691:     ;
02:0004BBF8 102C00AC        	  5692:     move.b  ($00AC,A4),D0
02:0004BBFC 00000020        	  5693:     ori.b #$20,D0
02:0004BC00 194000AC        	  5694:     move.b  D0,($00AC,A4)
                            	  5695:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5696:     ; up the new state.
                            	  5697:     ;
02:0004BC04 7001            	  5698:     moveq   #1,D0
02:0004BC06 194003D0        	  5699:     move.b  D0,($03D0,A4)
                            	  5700:     ; Deactivate the boomerang.
                            	  5701:     ;
02:0004BC0A 760F            	  5702:     moveq   #15,D3
02:0004BC0C 7000            	  5703:     moveq   #0,D0
02:0004BC0E 41EC00AC        	  5704:     lea     ($00AC,A4),A0
02:0004BC12 11803000        	  5705:     move.b  D0,(A0,D3.W)
02:0004BC16 0A3C0001        	  5706:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004BC1A 4E75            	  5707:     rts
                            	  5708: 
                            	  5709:     even
                            	  5710: _L_z07_CheckState30_CatchBoomerang:
                            	  5711:     ; A monster caught the boomerang that it threw.
                            	  5712:     ;
                            	  5713:     ; Set a timer for the thrower based on a random value:
                            	  5714:     ; < $30: $30
                            	  5715:     ; < $70: $50
                            	  5716:     ; Else:  $70
                            	  5717:     ;
02:0004BC1C 7630            	  5718:     moveq   #48,D3
02:0004BC1E 10342018        	  5719:     move.b  ($18,A4,D2.W),D0
02:0004BC22 0C000030        	  5720:     cmpi.b  #$30,D0
02:0004BC26 650A            	  5721:     bcs  _L_z07_CheckState30_SetThrowerTimer
