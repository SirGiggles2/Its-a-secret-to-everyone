02:0003D88E 6408            	  9721:     bcc  _anon_z04_122
02:0003D890 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003D894 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
