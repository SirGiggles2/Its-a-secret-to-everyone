                            	  7303: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7304:     ; If the "monsters from edges" long timer expired, then
                            	  7305:     ; go bring the monster in.
                            	  7306:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7307:     ;
                            	  7308:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7309:     ; residual position so enemies keep their previous-room
                            	  7310:     ; positions instead of being re-edge-spawned (matches NES).
02:0004C884 102C004B        	  7311:     move.b  ($004B,A4),D0
02:0004C888 662E            	  7312:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
