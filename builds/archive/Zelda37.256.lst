02:0002BF8A 08000008        	  2282:     btst    #8,D0
02:0002BF8E 670A            	  2283:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2284:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2285:     eori    #$01,CCR
02:0002BF98 4E75            	  2286:     rts
                            	  2287: .cc_cnr:
02:0002BF9A 023C00FE        	  2288:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2289:     eori    #$01,CCR
02:0002BFA2 4E75            	  2290:     rts
                            	  2291: 
