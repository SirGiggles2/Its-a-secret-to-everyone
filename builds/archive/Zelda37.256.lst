                            	   727: _L_z01_CopyCommonCodeToRam_Loop:
02:0002E9E4 1214            	   728:     move.b  ($00,A4),D1   ; ptr lo
02:0002E9E6 182C0001        	   729:     move.b  ($01,A4),D4  ; ptr hi
02:0002E9EA 024100FF        	   730:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E9EE E14C            	   731:     lsl.w   #8,D4
02:0002E9F0 8841            	   732:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E9F2 48C4            	   733:     ext.l   D4
02:0002E9F4 D8BC00FF0000    	   734:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E9FA 2044            	   735:     movea.l D4,A0
02:0002E9FC 10303000        	   736:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EA00 122C0002        	   737:     move.b  ($02,A4),D1   ; ptr lo
02:0002EA04 182C0003        	   738:     move.b  ($03,A4),D4  ; ptr hi
02:0002EA08 024100FF        	   739:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EA0C E14C            	   740:     lsl.w   #8,D4
02:0002EA0E 8841            	   741:     or.w    D1,D4
02:0002EA10 48C4            	   742:     ext.l   D4
02:0002EA12 D8BC00FF0000    	   743:     add.l   #NES_RAM,D4
02:0002EA18 2044            	   744:     movea.l D4,A0
02:0002EA1A 11803000        	   745:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   746:     ; Increment source address.
                            	   747:     ;
02:0002EA1E 1014            	   748:     move.b  ($0000,A4),D0
02:0002EA20 023C00EE        	   749:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EA24 123C0001        	   750:     move.b  #$01,D1
02:0002EA28 D101            	   751:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EA2A 1880            	   752:     move.b  D0,($0000,A4)
