                            	   733: ;------------------------------------------------------------------------------
                            	   734: ; _c_move_object_shim — MoveObject trampoline.
                            	   735: ;
                            	   736: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   737: ;   Input:     D2 = slot (0..11)
                            	   738: ;   Preserves: D2, A4, A5
                            	   739: ;   Clobbers:  D0, D1, D3, A0
                            	   740: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   741: ;
                            	   742: ; GCC side:
                            	   743: ;   void c_move_object(unsigned short slot);
                            	   744: ;     slot arrives as a 16-bit value on the stack.
                            	   745: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   746: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   747: ;   never clobbered by gcc.
                            	   748: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   749: ;   semantics can exist in a pure C port).
                            	   750: ;------------------------------------------------------------------------------
                            	   751: _c_move_object_shim:
                            	   752:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   753:     move.b  #$AA,($0900,A4)
                            	   754:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   755:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   756:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   757:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   758:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   759:     moveq   #0,D0
02:0002B658 3002            	   760:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   761:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   762:     jsr     c_move_object
02:0002B662 588F            	   763:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   764:     rts
                            	   765: 
                            	   766: ;==============================================================================
                            	   767: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   768: ; and tail-call the native asm function.
                            	   769: ;
                            	   770: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   771: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   772: ; sign-extended).
                            	   773: ;==============================================================================
                            	   774: 
                            	   775: ;------------------------------------------------------------------------------
                            	   776: ; void c_copy_bank_to_window(unsigned int bank);
                            	   777: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   778: ;------------------------------------------------------------------------------
                            	   779: c_copy_bank_to_window:
02:0002B666 202F0004        	   780:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   781:     jmp     _copy_bank_to_window
                            	   782: 
                            	   783: ;------------------------------------------------------------------------------
                            	   784: ; unsigned char c_ppu_read_2(void);
                            	   785: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   786: ; C return: gcc expects result in D0.
                            	   787: ;------------------------------------------------------------------------------
                            	   788: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   789:     jmp     _ppu_read_2
                            	   790: 
                            	   791: ;------------------------------------------------------------------------------
                            	   792: ; void c_ppu_write_6(unsigned int val);
                            	   793: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   794: ;------------------------------------------------------------------------------
                            	   795: c_ppu_write_6:
02:0002B674 202F0004        	   796:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   797:     jmp     _ppu_write_6
                            	   798: 
                            	   799: ;------------------------------------------------------------------------------
                            	   800: ; void c_ppu_write_7(unsigned int val);
                            	   801: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   802: ;------------------------------------------------------------------------------
                            	   803: c_ppu_write_7:
02:0002B67E 202F0004        	   804:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   805:     jmp     _ppu_write_7
                            	   806: 
                            	   807: ;------------------------------------------------------------------------------
                            	   808: ; void c_turn_off_all_video(void);
                            	   809: ; Native: jsr TurnOffAllVideo (no register args, no return value).
