02:000331C8 1003            	   537:     move.b  D3,D0
02:000331CA 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:000331CC 19430016        	   539:     move.b  D3,($0016,A4)
02:000331D0 6100D3BA        	   540:     jsr     FetchFileAAddressSet
02:000331D4 61001C38        	   541:     jsr     FormatFileA
