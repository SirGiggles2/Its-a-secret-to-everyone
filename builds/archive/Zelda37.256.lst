02:0003BA60 101D            	  5597:     move.b  (A5)+,D0  ; PLA
02:0003BA62 41EC0098        	  5598:     lea     ($0098,A4),A0
02:0003BA66 11802000        	  5599:     move.b  D0,(A0,D2.W)
                            	  5600:     ; If this segment is still alive, then return.
                            	  5601:     ;
02:0003BA6A 41EC0405        	  5602:     lea     ($0405,A4),A0
02:0003BA6E 10302000        	  5603:     move.b  (A0,D2.W),D0
02:0003BA72 6774            	  5604:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5605:     ; This segment is dead. We'll swap the tail segment with this
                            	  5606:     ; dead segment. This way, moldorm heads are always rooted
                            	  5607:     ; in slots 5 and $A; and the segments are continguous.
                            	  5608:     ;
                            	  5609:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5610:     ;
                            	  5611:     ; Note that this is not a true swap, because the tail's HP
                            	  5612:     ; might be less than $20.
                            	  5613:     ;
02:0003BA74 7020            	  5614:     moveq   #32,D0
02:0003BA76 41EC0485        	  5615:     lea     ($0485,A4),A0
02:0003BA7A 11802000        	  5616:     move.b  D0,(A0,D2.W)
02:0003BA7E 61000608        	  5617:     jsr     CheckBossHitReaction
                            	  5618:     ; Look for the tail segment, starting from the low end
                            	  5619:     ; of the chain that this dead segment belongs to.
                            	  5620:     ;
02:0003BA82 163C00FF        	  5621:     move.b  #$FF,D3
02:0003BA86 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003BA8A 6502            	  5623:     bcs  _anon_z04_80
02:0003BA8C 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
02:0003BA8E 5203            	  5626:     addq.b  #1,D3
02:0003BA90 41EC0350        	  5627:     lea     ($0350,A4),A0
02:0003BA94 10303000        	  5628:     move.b  (A0,D3.W),D0
02:0003BA98 0C000041        	  5629:     cmpi.b  #$41,D0
02:0003BA9C 66F0            	  5630:     bne  _anon_z04_80
                            	  5631:     ; I don't know why the object timer of the tail segment that will
                            	  5632:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5633:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5634:     ; there, the object timer is set to 6.
                            	  5635:     ;
02:0003BA9E 7011            	  5636:     moveq   #17,D0
02:0003BAA0 19803029        	  5637:     move.b  D0,($29,A4,D3.W)
                            	  5638:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5639:     ; segment to the tail segment.
                            	  5640:     ;
02:0003BAA4 41EC04F0        	  5641:     lea     ($04F0,A4),A0
02:0003BAA8 10302000        	  5642:     move.b  (A0,D2.W),D0
02:0003BAAC 41EC04F1        	  5643:     lea     ($04F1,A4),A0
02:0003BAB0 11803000        	  5644:     move.b  D0,(A0,D3.W)
02:0003BAB4 10342070        	  5645:     move.b  ($70,A4,D2.W),D0
02:0003BAB8 19803071        	  5646:     move.b  D0,($71,A4,D3.W)
02:0003BABC 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003BAC0 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003BAC4 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003BAC8 11803000        	  5650:     move.b  D0,(A0,D3.W)
                            	  5651:     ; If the tail segment found is also a head, then
                            	  5652:     ; the last segment has died. Return.
                            	  5653:     ;
02:0003BACC 0C030004        	  5654:     cmpi.b  #$04,D3
02:0003BAD0 6716            	  5655:     beq  _L_z04_UpdateMoldorm_Exit
02:0003BAD2 0C030009        	  5656:     cmpi.b  #$09,D3
02:0003BAD6 6710            	  5657:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5658:     ; Else finish swapping the segments.
                            	  5659:     ; Set the tail segment's type to the dead dummy object.
                            	  5660:     ;
02:0003BAD8 705D            	  5661:     moveq   #93,D0
02:0003BADA 41EC0350        	  5662:     lea     ($0350,A4),A0
02:0003BADE 11803000        	  5663:     move.b  D0,(A0,D3.W)
                            	  5664:     ; Reset the metastate of the current segment, so that it comes
                            	  5665:     ; back to life.
                            	  5666:     ;
02:0003BAE2 4EB90004CC86    	  5667:     jsr     ResetObjMetastate
