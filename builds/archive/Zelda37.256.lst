                            	  5115: _L_z07_SpreadShot_NextCorner:
                            	  5116:     ; Prepare to process the next corner.
                            	  5117:     ;
                            	  5118:     ; First, restore X offset [02] and Y offset [03].
                            	  5119:     ;
02:0004B842 101D            	  5120:     move.b  (A5)+,D0  ; PLA
02:0004B844 19400003        	  5121:     move.b  D0,($0003,A4)
02:0004B848 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004B84A 19400002        	  5123:     move.b  D0,($0002,A4)
                            	  5124:     ; Take turns negating X offset or Y offset for the next round.
                            	  5125:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5126:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5127:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5128:     ; - Fourth turn: doesn't matter
                            	  5129:     ;
                            	  5130:     ;
                            	  5131:     ; Get the loop index.
02:0004B84E 101D            	  5132:     move.b  (A5)+,D0  ; PLA
02:0004B850 1B00            	  5133:     move.b  D0,-(A5)  ; PHA
02:0004B852 7600            	  5134:     moveq   #0,D3
02:0004B854 1600            	  5135:     move.b  D0,D3
02:0004B856 0C030001        	  5136:     cmpi.b  #$01,D3
02:0004B85A 6602            	  5137:     bne  _anon_z07_25
02:0004B85C 7603            	  5138:     moveq   #3,D3
                            	  5139: _anon_z07_25:
02:0004B85E 10343000        	  5140:     move.b  ($00,A4,D3.W),D0
02:0004B862 4600            	  5141:     eori.b #$FF,D0
02:0004B864 023C00EE        	  5142:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B868 123C0001        	  5143:     move.b  #$01,D1
02:0004B86C D101            	  5144:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004B86E 19803000        	  5145:     move.b  D0,($00,A4,D3.W)
                            	  5146:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5147:     ;
02:0004B872 101D            	  5148:     move.b  (A5)+,D0  ; PLA
02:0004B874 7600            	  5149:     moveq   #0,D3
02:0004B876 1600            	  5150:     move.b  D0,D3
02:0004B878 5303            	  5151:     subq.b  #1,D3
02:0004B87A 6A00FF18        	  5152:     bpl  _L_z07_SpreadShot_DrawShotCorner
