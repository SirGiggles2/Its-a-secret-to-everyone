02:0003C112 41EC0098        	  6528:     lea     ($0098,A4),A0
02:0003C116 16302000        	  6529:     move.b  (A0,D2.W),D3
02:0003C11A 5303            	  6530:     subq.b  #1,D3
                            	  6531:     ; Add the speed to the X coordinate.
                            	  6532:     ;
02:0003C11C 10342070        	  6533:     move.b  ($70,A4,D2.W),D0
02:0003C120 023C00EE        	  6534:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C124 41F90003C08E    	  6535:     lea     (AquamentusSpeeds).l,A0
02:0003C12A 12303000        	  6536:     move.b  (A0,D3.W),D1
02:0003C12E D101            	  6537:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
