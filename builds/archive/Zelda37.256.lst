02:0004BA54 19400004        	  5435:     move.b  D0,($0004,A4)
                            	  5436:     ; If this is a monster's arrow, add 2 to sprite attributes in [04].
                            	  5437:     ; This chooses palette row 6.
                            	  5438:     ;
                            	  5439:     ; Otherwise, add the arrow item value less 1. This chooses
                            	  5440:     ; palette row 4 if the arrow is wooden, otherwise 5 for silver.
                            	  5441:     ;
02:0004BA58 0C02000D        	  5442:     cmpi.b  #$0D,D2
02:0004BA5C 641E            	  5443:     bcc  _L_z07_SetAttrAndDrawArrow_PlayerArrow
02:0004BA5E 41EC034F        	  5444:     lea     ($034F,A4),A0
02:0004BA62 10302000        	  5445:     move.b  (A0,D2.W),D0
02:0004BA66 0C00005B        	  5446:     cmpi.b  #$5B,D0
02:0004BA6A 6610            	  5447:     bne  _L_z07_SetAttrAndDrawArrow_PlayerArrow
02:0004BA6C 102C0004        	  5448:     move.b  ($0004,A4),D0
02:0004BA70 023C00EE        	  5449:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BA74 123C0002        	  5450:     move.b  #$02,D1
02:0004BA78 D101            	  5451:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004BA7A 661C            	  5452:     bne  _L_z07_SetAttrAndDrawArrow_SetAttr
                            	  5453:     even
                            	  5454: _L_z07_SetAttrAndDrawArrow_PlayerArrow:
02:0004BA7C 023C00EE        	  5455:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BA80 122C0659        	  5456:     move.b  ($0659,A4),D1
02:0004BA84 D101            	  5457:     addx.b  D1,D0   ; ADC InvArrow
02:0004BA86 003C0011        	  5458:     ori     #$11,CCR  ; SEC: set C+X
02:0004BA8A 123C0001        	  5459:     move.b  #$01,D1
02:0004BA8E 0A3C0010        	  5460:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BA92 9101            	  5461:     subx.b  D1,D0   ; SBC #$01
02:0004BA94 0A3C0010        	  5462:     eori    #$10,CCR  ; restore X = 6502 C
