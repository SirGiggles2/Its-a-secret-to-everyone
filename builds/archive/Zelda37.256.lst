02:000408B2 E308            	  1761:     lsl.b  #1,D0   ; ASL A
02:000408B4 E308            	  1762:     lsl.b  #1,D0   ; ASL A
02:000408B6 E308            	  1763:     lsl.b  #1,D0   ; ASL A
