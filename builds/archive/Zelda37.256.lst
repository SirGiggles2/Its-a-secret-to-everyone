02:000331AE 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:000331B0 48C4            	   530:     ext.l   D4
02:000331B2 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000331B8 2044            	   532:     movea.l D4,A0
