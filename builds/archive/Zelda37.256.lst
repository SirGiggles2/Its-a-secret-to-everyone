02:00031418 6034            	  4361:     jmp     Anim_WriteSpritePair
                            	  4362: 
                            	  4363: ; Params:
                            	  4364: ; [00]: Object X
                            	  4365: ; [01]: Object Y
                            	  4366: ; [02]: Left tile
                            	  4367: ; [03]: Right tile
                            	  4368: ; [04]: Left attributes
                            	  4369: ; [05]: Right attributes
                            	  4370: ; [07]: Has two sides
                            	  4371: ; [08]: Cycle sprite index
                            	  4372: ; [0A]: X separation
                            	  4373: ; [0F]: Flip horizontally
                            	  4374: ; [0343]: LeftSpriteOffset
                            	  4375: ; [0344]: RightSpriteOffset
                            	  4376: ;
                            	  4377: ; If [0F] = 0, write the sprite pair with no further processing.
                            	  4378: ;
                            	  4379:     even
