02:0003CA88 6600009A        	  7858:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003CA8C 103C0080        	  7859:     move.b  #$80,D0
02:0003CA90 6100C93E        	  7860:     jsr     UpdateCommonWanderer
