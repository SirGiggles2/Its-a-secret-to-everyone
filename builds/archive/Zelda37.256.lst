02:00035E78 7600            	  4584:     moveq   #0,D3
02:00035E7A 162C0416        	  4585:     move.b  ($0416,A4),D3
                            	  4586:     ; Increment the index variable to point to the next character
                            	  4587:     ; for the next time.
                            	  4588:     ;
02:00035E7E 522C0416        	  4589:     addq.b  #1,($0416,A4)
                            	  4590:     ; Get the current character.
                            	  4591:     ;
02:00035E82 1214            	  4592:     move.b  ($00,A4),D1   ; ptr lo
02:00035E84 182C0001        	  4593:     move.b  ($01,A4),D4  ; ptr hi
02:00035E88 024100FF        	  4594:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035E8C E14C            	  4595:     lsl.w   #8,D4
02:00035E8E 8841            	  4596:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035E90 48C4            	  4597:     ext.l   D4
02:00035E92 D8BC00FF0000    	  4598:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035E98 2044            	  4599:     movea.l D4,A0
02:00035E9A 10303000        	  4600:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4601:     ; If the character is $25, then it's a special space. It will still
                            	  4602:     ; take up space, but will not take time to show -- meaning that
                            	  4603:     ; we'll go look up the next character to transfer.
                            	  4604:     ;
02:00035E9E 0200003F        	  4605:     andi.b #$3F,D0
02:00035EA2 0C000025        	  4606:     cmpi.b  #$25,D0
02:00035EA6 67BA            	  4607:     beq  _anon_z02_32
                            	  4608:     ; We have a non-space character. Put it in the transfer record.
                            	  4609:     ;
02:00035EA8 19400305        	  4610:     move.b  D0,($0305,A4)
                            	  4611:     ; Play the "heart taken/character" tune.
                            	  4612:     ;
02:00035EAC 7010            	  4613:     moveq   #16,D0
02:00035EAE 19400604        	  4614:     move.b  D0,($0604,A4)
                            	  4615:     ; If the high 2 bits of character element = 0, then return.
                            	  4616:     ;
02:00035EB2 1214            	  4617:     move.b  ($00,A4),D1   ; ptr lo
02:00035EB4 182C0001        	  4618:     move.b  ($01,A4),D4  ; ptr hi
02:00035EB8 024100FF        	  4619:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035EBC E14C            	  4620:     lsl.w   #8,D4
02:00035EBE 8841            	  4621:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035EC0 48C4            	  4622:     ext.l   D4
02:00035EC2 D8BC00FF0000    	  4623:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035EC8 2044            	  4624:     movea.l D4,A0
02:00035ECA 10303000        	  4625:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00035ECE 020000C0        	  4626:     andi.b #$C0,D0
02:00035ED2 6602            	  4627:     bne.s  __far_z_02_0010
02:00035ED4 6032            	  4628:     jmp  LA9F4_Exit
                            	  4629: __far_z_02_0010:
                            	  4630:     ; Determine an index based on the high 2 bits of the character element:
                            	  4631:     ;   $80: 0
                            	  4632:     ;   $40: 1
                            	  4633:     ;   $C0: 2
                            	  4634:     ;
02:00035ED6 7602            	  4635:     moveq   #2,D3
02:00035ED8 0C0000C0        	  4636:     cmpi.b  #$C0,D0
02:00035EDC 670A            	  4637:     beq  _anon_z02_33
02:00035EDE 5303            	  4638:     subq.b  #1,D3
02:00035EE0 0C000040        	  4639:     cmpi.b  #$40,D0
02:00035EE4 6702            	  4640:     beq  _anon_z02_33
02:00035EE6 5303            	  4641:     subq.b  #1,D3
                            	  4642: _anon_z02_33:
                            	  4643:     ; The index chooses the low VRAM address of the start
                            	  4644:     ; of another line:
                            	  4645:     ;   0: $C4: front of the second line
                            	  4646:     ;   1: $E4: front of the third line
                            	  4647:     ;   2: $A4: front of the first line
                            	  4648:     ;
02:00035EE8 41F900035E30    	  4649:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00035EEE 10303000        	  4650:     move.b  (A0,D3.W),D0
02:00035EF2 1940045F        	  4651:     move.b  D0,($045F,A4)
                            	  4652:     ; If index = 2, then we've reached the end of the text,
                            	  4653:     ; and low VRAM address is moved to the front of the first line.
                            	  4654:     ; So, advance the state of the person object, and unhalt Link.
                            	  4655:     ;
02:00035EF6 0C030002        	  4656:     cmpi.b  #$02,D3
02:00035EFA 6702            	  4657:     beq.s  __far_z_02_0011
02:00035EFC 600A            	  4658:     jmp  LA9F4_Exit
                            	  4659: __far_z_02_0011:
02:00035EFE 522C00AD        	  4660:     addq.b  #1,($00AD,A4)
02:00035F02 7000            	  4661:     moveq   #0,D0
02:00035F04 194000AC        	  4662:     move.b  D0,($00AC,A4)
                            	  4663:     even
