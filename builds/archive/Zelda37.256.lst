02:0003E99E 0C020009        	 12018:     cmpi.b  #$09,D2
02:0003E9A2 6604            	 12019:     bne  _anon_z04_157
02:0003E9A4 522C00AD        	 12020:     addq.b  #1,($00AD,A4)
                            	 12021: _anon_z04_157:
                            	 12022:     ; Go to state 1 to orbit.
                            	 12023:     ;
02:0003E9A8 41EC00AC        	 12024:     lea     ($00AC,A4),A0
02:0003E9AC 52302000        	 12025:     addq.b  #1,(A0,D2.W)
                            	 12026:     ; TODO: ?
                            	 12027:     ;
02:0003E9B0 103C0080        	 12028:     move.b  #$80,D0
02:0003E9B4 41EC0098        	 12029:     lea     ($0098,A4),A0
02:0003E9B8 11802000        	 12030:     move.b  D0,(A0,D2.W)
                            	 12031:     ; Set angle $18 (N).
                            	 12032:     ;
02:0003E9BC 7018            	 12033:     moveq   #24,D0
02:0003E9BE 41EC0394        	 12034:     lea     ($0394,A4),A0
02:0003E9C2 11802000        	 12035:     move.b  D0,(A0,D2.W)
                            	 12036:     ; This location is right above Patra.
                            	 12037:     ; Set X coordinate to Patra's.
                            	 12038:     ;
02:0003E9C6 102C0071        	 12039:     move.b  ($0071,A4),D0
02:0003E9CA 19802070        	 12040:     move.b  D0,($70,A4,D2.W)
                            	 12041:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12042:     ; Else use radius $18. Store the chosen value in [00].
                            	 12043:     ;
02:0003E9CE 702C            	 12044:     moveq   #44,D0
02:0003E9D0 7600            	 12045:     moveq   #0,D3
02:0003E9D2 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003E9D6 16302000        	 12047:     move.b  (A0,D2.W),D3
02:0003E9DA 0C030025        	 12048:     cmpi.b  #$25,D3
02:0003E9DE 6702            	 12049:     beq  _anon_z04_158
02:0003E9E0 7018            	 12050:     moveq   #24,D0
                            	 12051: _anon_z04_158:
02:0003E9E2 1880            	 12052:     move.b  D0,($0000,A4)
                            	 12053:     ; This location is right above Patra.
                            	 12054:     ; Set Y coordinate to (Patra's Y - [00]).
                            	 12055:     ;
02:0003E9E4 102C0085        	 12056:     move.b  ($0085,A4),D0
02:0003E9E8 003C0011        	 12057:     ori     #$11,CCR  ; SEC: set C+X
02:0003E9EC 1214            	 12058:     move.b  ($0000,A4),D1
02:0003E9EE 0A3C0010        	 12059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E9F2 9101            	 12060:     subx.b  D1,D0   ; SBC $00
02:0003E9F4 0A3C0010        	 12061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E9F8 41EC0084        	 12062:     lea     ($0084,A4),A0
02:0003E9FC 11802000        	 12063:     move.b  D0,(A0,D2.W)
                            	 12064:     even
