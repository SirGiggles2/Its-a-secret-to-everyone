02:0004B808 6438            	  5086:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5087:     ; Add the object's Y (the center of the spread) and the
                            	  5088:     ; current offset in [03] to set sprite Y in [01].
                            	  5089:     ;
02:0004B80A 41EC0084        	  5090:     lea     ($0084,A4),A0
02:0004B80E 10302000        	  5091:     move.b  (A0,D2.W),D0
02:0004B812 023C00EE        	  5092:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B816 122C0003        	  5093:     move.b  ($0003,A4),D1
02:0004B81A D101            	  5094:     addx.b  D1,D0   ; ADC $03
02:0004B81C 19400001        	  5095:     move.b  D0,($0001,A4)
                            	  5096:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5097:     ;
02:0004B820 7600            	  5098:     moveq   #0,D3
02:0004B822 162C0010        	  5099:     move.b  ($0010,A4),D3
02:0004B826 670C            	  5100:     beq  _L_z07_SpreadShot_Draw
02:0004B828 0C00003E        	  5101:     cmpi.b  #$3E,D0
02:0004B82C 6514            	  5102:     bcs  _L_z07_SpreadShot_NextCorner
02:0004B82E 0C0000E8        	  5103:     cmpi.b  #$E8,D0
