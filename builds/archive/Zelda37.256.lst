                            	 12069: PatraChild_State1:
                            	 12070:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12071:     ;
02:0003EA02 10342070        	 12072:     move.b  ($70,A4,D2.W),D0
02:0003EA06 023C00EE        	 12073:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EA0A 122C046C        	 12074:     move.b  ($046C,A4),D1
02:0003EA0E D101            	 12075:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003EA10 19802070        	 12076:     move.b  D0,($70,A4,D2.W)
02:0003EA14 41EC0084        	 12077:     lea     ($0084,A4),A0
02:0003EA18 10302000        	 12078:     move.b  (A0,D2.W),D0
02:0003EA1C 023C00EE        	 12079:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EA20 122C0479        	 12080:     move.b  ($0479,A4),D1
02:0003EA24 D101            	 12081:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003EA26 41EC0084        	 12082:     lea     ($0084,A4),A0
02:0003EA2A 11802000        	 12083:     move.b  D0,(A0,D2.W)
                            	 12084:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12085:     ;
02:0003EA2E 7000            	 12086:     moveq   #0,D0
02:0003EA30 1940000B        	 12087:     move.b  D0,($000B,A4)
                            	 12088:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12089:     ; monster's angle by $70, else by $60 to go slower.
                            	 12090:     ;
02:0003EA34 7070            	 12091:     moveq   #112,D0
02:0003EA36 7600            	 12092:     moveq   #0,D3
02:0003EA38 41EC034F        	 12093:     lea     ($034F,A4),A0
02:0003EA3C 16302000        	 12094:     move.b  (A0,D2.W),D3
02:0003EA40 0C030025        	 12095:     cmpi.b  #$25,D3
02:0003EA44 6702            	 12096:     beq  _anon_z04_159
02:0003EA46 7060            	 12097:     moveq   #96,D0
                            	 12098: _anon_z04_159:
02:0003EA48 61000D9C        	 12099:     jsr     DecreaseObjectAngle
                            	 12100:     ; Load Patra's maneuver index.
                            	 12101:     ; It determines which counts of bits are looked up below.
                            	 12102:     ;
02:0003EA4C 7600            	 12103:     moveq   #0,D3
02:0003EA4E 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003EA52 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003EA56 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003EA5A 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003EA5E 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003EA60 41F90003E952    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003EA66 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003EA6A 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003EA6C 41F90003E956    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003EA72 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003EA76 7600            	 12118:     moveq   #0,D3
02:0003EA78 1600            	 12119:     move.b  D0,D3
02:0003EA7A 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003EA7C 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003EA7E 41F90003E954    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003EA84 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003EA88 7600            	 12131:     moveq   #0,D3
02:0003EA8A 1600            	 12132:     move.b  D0,D3
                            	 12133:     even
                            	 12134: _L_z04_PatraChild_State1_Rotate:
02:0003EA8C 61000BA8        	 12135:     jsr     RotateObjectLocation
02:0003EA90 41EC0084        	 12136:     lea     ($0084,A4),A0
02:0003EA94 11802000        	 12137:     move.b  D0,(A0,D2.W)
02:0003EA98 611C            	 12138:     jsr     PatraChild_Draw
                            	 12139:     ; If Patra's state still = 0, then the last patra child has not
                            	 12140:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 12141:     ;
02:0003EA9A 102C00AD        	 12142:     move.b  ($00AD,A4),D0
02:0003EA9E 6714            	 12143:     beq  _L_z04_PatraChild_State1_Exit
02:0003EAA0 4EB9000316B4    	 12144:     jsr     CheckMonsterCollisions
                            	 12145:     ; If the monster died, then change to the dead dummy object.
                            	 12146:     ;
02:0003EAA6 41EC0405        	 12147:     lea     ($0405,A4),A0
02:0003EAAA 10302000        	 12148:     move.b  (A0,D2.W),D0
02:0003EAAE 6704            	 12149:     beq  _L_z04_PatraChild_State1_Exit
02:0003EAB0 6100FA94        	 12150:     jsr     SetDeadDummyObjType
                            	 12151:     even
