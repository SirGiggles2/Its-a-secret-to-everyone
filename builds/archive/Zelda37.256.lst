02:0003138C 7001            	  4295:     moveq   #1,D0
02:0003138E 19400007        	  4296:     move.b  D0,($0007,A4)
02:00031392 7008            	  4297:     moveq   #8,D0
02:00031394 1940000A        	  4298:     move.b  D0,($000A,A4)
02:00031398 41F9000310E8    	  4299:     lea     (ObjAnimations).l,A0
02:0003139E 10303000        	  4300:     move.b  (A0,D3.W),D0
02:000313A2 023C00EE        	  4301:     andi    #$EE,CCR  ; CLC: clear C+X
02:000313A6 122C000D        	  4302:     move.b  ($000D,A4),D1
02:000313AA D101            	  4303:     addx.b  D1,D0   ; ADC $0D
02:000313AC 7600            	  4304:     moveq   #0,D3
02:000313AE 1600            	  4305:     move.b  D0,D3
02:000313B0 41F900031168    	  4306:     lea     (ObjAnimFrameHeap).l,A0
02:000313B6 10303000        	  4307:     move.b  (A0,D3.W),D0
02:000313BA 19400002        	  4308:     move.b  D0,($0002,A4)
02:000313BE 023C00EE        	  4309:     andi    #$EE,CCR  ; CLC: clear C+X
