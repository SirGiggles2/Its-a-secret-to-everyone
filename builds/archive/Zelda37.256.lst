                            	  5012:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5013:     ; These will be negated appropriately for each corner.
                            	  5014:     ;
02:0004B77C 41EC0098        	  5015:     lea     ($0098,A4),A0
02:0004B780 10302000        	  5016:     move.b  (A0,D2.W),D0
02:0004B784 19400002        	  5017:     move.b  D0,($0002,A4)
02:0004B788 19400003        	  5018:     move.b  D0,($0003,A4)
                            	  5019:     ; Reset [0F] to not flip horizontally.
                            	  5020:     ;
02:0004B78C 7000            	  5021:     moveq   #0,D0
02:0004B78E 1940000F        	  5022:     move.b  D0,($000F,A4)
                            	  5023:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5024:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5025:     ;
02:0004B792 7603            	  5026:     moveq   #3,D3
                            	  5027:     even
                            	  5028: _L_z07_SpreadShot_DrawShotCorner:
02:0004B794 1003            	  5029:     move.b  D3,D0
02:0004B796 1B00            	  5030:     move.b  D0,-(A5)  ; PHA
                            	  5031:     ; Save offset X [02] and Y offset [03].
                            	  5032:     ;
02:0004B798 102C0002        	  5033:     move.b  ($0002,A4),D0
02:0004B79C 1B00            	  5034:     move.b  D0,-(A5)  ; PHA
02:0004B79E 102C0003        	  5035:     move.b  ($0003,A4),D0
02:0004B7A2 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
                            	  5037:     ; Calculate and set sprite attributes for this corner:
                            	  5038:     ;   base attribute OR (frame counter AND 3)
                            	  5039:     ;
                            	  5040:     ; The base attribute defines how to flip the sprite.
                            	  5041:     ; The frame counter makes the shot flash by cycling each
                            	  5042:     ; palette row.
                            	  5043:     ;
02:0004B7A4 102C0015        	  5044:     move.b  ($0015,A4),D0
02:0004B7A8 02000003        	  5045:     andi.b #$03,D0
02:0004B7AC 41F90004B60A    	  5046:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004B7B2 12303000        	  5047:     move.b  (A0,D3.W),D1
02:0004B7B6 8001            	  5048:     or.b  D1,D0
02:0004B7B8 4EB90003162A    	  5049:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5050:     ; Add the object's X (the center of the spread) and the
                            	  5051:     ; current offset in [02] to set sprite X in [00].
                            	  5052:     ;
02:0004B7BE 10342070        	  5053:     move.b  ($70,A4,D2.W),D0
02:0004B7C2 023C00EE        	  5054:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B7C6 122C0002        	  5055:     move.b  ($0002,A4),D1
02:0004B7CA D101            	  5056:     addx.b  D1,D0   ; ADC $02
02:0004B7CC 1880            	  5057:     move.b  D0,($0000,A4)
                            	  5058:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5059:     ; Else calculate the distance from object X to sprite X.
                            	  5060:     ;
02:0004B7CE 12342070        	  5061:     move.b  ($70,A4,D2.W),D1
02:0004B7D2 B001            	  5062:     cmp.b   D1,D0
02:0004B7D4 651A            	  5063:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004B7D6 0C0000FC        	  5064:     cmpi.b  #$FC,D0
02:0004B7DA 6466            	  5065:     bcc  _L_z07_SpreadShot_NextCorner
02:0004B7DC 003C0011        	  5066:     ori     #$11,CCR  ; SEC: set C+X
02:0004B7E0 12342070        	  5067:     move.b  ($70,A4,D2.W),D1
02:0004B7E4 0A3C0010        	  5068:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B7E8 9101            	  5069:     subx.b  D1,D0   ; SBC ObjX,X
02:0004B7EA 0A3C0010        	  5070:     eori    #$10,CCR  ; restore X = 6502 C
02:0004B7EE 6014            	  5071:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5072: 
                            	  5073:     even
                            	  5074: _L_z07_SpreadShot_ReverseSub:
02:0004B7F0 10342070        	  5075:     move.b  ($70,A4,D2.W),D0
02:0004B7F4 003C0011        	  5076:     ori     #$11,CCR  ; SEC: set C+X
02:0004B7F8 1214            	  5077:     move.b  ($0000,A4),D1
02:0004B7FA 0A3C0010        	  5078:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B7FE 9101            	  5079:     subx.b  D1,D0   ; SBC $00
02:0004B800 0A3C0010        	  5080:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5081:     even
                            	  5082: _L_z07_SpreadShot_CheckDistance:
                            	  5083:     ; If distance >= $20, skip this corner.
                            	  5084:     ;
