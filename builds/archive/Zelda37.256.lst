02:00030198 1880            	  1802:     move.b  D0,($0000,A4)
                            	  1803:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  1804:     ; then we'll make 4 traps.
                            	  1805:     ;
02:0003019A 41EC034F        	  1806:     lea     ($034F,A4),A0
02:0003019E 12302000        	  1807:     move.b  (A0,D2.W),D1
02:000301A2 B001            	  1808:     cmp.b   D1,D0
02:000301A4 6702            	  1809:     beq  _L_z01_InitTrap_Full_LoopTrap
02:000301A6 7603            	  1810:     moveq   #3,D3
                            	  1811:     even
                            	  1812: _L_z01_InitTrap_Full_LoopTrap:
                            	  1813:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  1814:     ;
