02:0002E6AC 6000D340        	   247:     jmp     c_unhalt_link
                            	   248: 
                            	   249: InitCaveContinue:
                            	   250:     ; Get this cave's index (object type - $6A).
                            	   251:     ;
02:0002E6B0 102C0350        	   252:     move.b  ($0350,A4),D0
02:0002E6B4 003C0011        	   253:     ori     #$11,CCR  ; SEC: set C+X
02:0002E6B8 123C006A        	   254:     move.b  #$6A,D1
02:0002E6BC 0A3C0010        	   255:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E6C0 9101            	   256:     subx.b  D1,D0   ; SBC #$6A
02:0002E6C2 0A3C0010        	   257:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E6C6 7600            	   258:     moveq   #0,D3
02:0002E6C8 1600            	   259:     move.b  D0,D3
                            	   260:     ; Get the person text selector by looking up the text selector byte
                            	   261:     ; for this index, and masking it with $3F.
                            	   262:     ;
02:0002E6CA 41F90002E67A    	   263:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E6D0 10303000        	   264:     move.b  (A0,D3.W),D0
02:0002E6D4 1B00            	   265:     move.b  D0,-(A5)  ; PHA
02:0002E6D6 0200003F        	   266:     andi.b #$3F,D0
02:0002E6DA 19400415        	   267:     move.b  D0,($0415,A4)
                            	   268:     ; Pop and mask the text selector byte with $C0 to get the
                            	   269:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   270:     ;
02:0002E6DE 101D            	   271:     move.b  (A5)+,D0  ; PLA
02:0002E6E0 020000C0        	   272:     andi.b #$C0,D0
02:0002E6E4 19400003        	   273:     move.b  D0,($0003,A4)
                            	   274:     ; At this point, the Y register still has the cave index.
                            	   275:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   276:     ;
02:0002E6E8 103C00FD        	   277:     move.b  #$FD,D0
                            	   278: _anon_z01_0:
02:0002E6EC 023C00EE        	   279:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E6F0 123C0003        	   280:     move.b  #$03,D1
02:0002E6F4 D101            	   281:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E6F6 5303            	   282:     subq.b  #1,D3
02:0002E6F8 6AF2            	   283:     bpl  _anon_z01_0
02:0002E6FA 7600            	   284:     moveq   #0,D3
02:0002E6FC 1600            	   285:     move.b  D0,D3
                            	   286:     ; Loop over the wares from 0 to 2.
                            	   287:     ;
02:0002E6FE 7400            	   288:     moveq   #0,D2
                            	   289:     even
                            	   290: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   291:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   292:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   293:     ;
02:0002E700 41F900FF6A7E    	   294:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E706 10303000        	   295:     move.b  (A0,D3.W),D0
02:0002E70A 41EC0422        	   296:     lea     ($0422,A4),A0
02:0002E70E 11802000        	   297:     move.b  D0,(A0,D2.W)
                            	   298:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   299:     ;
02:0002E712 020000C0        	   300:     andi.b #$C0,D0
02:0002E716 19802000        	   301:     move.b  D0,($00,A4,D2.W)
                            	   302:     ; Copy 3 prices from the Cave level block info.
                            	   303:     ;
02:0002E71A 41F900FF6ABA    	   304:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E720 10303000        	   305:     move.b  (A0,D3.W),D0
02:0002E724 41EC0430        	   306:     lea     ($0430,A4),A0
02:0002E728 11802000        	   307:     move.b  D0,(A0,D2.W)
                            	   308:     ; Bottom of the wares copying loop.
                            	   309:     ;
02:0002E72C 5203            	   310:     addq.b  #1,D3
02:0002E72E 5202            	   311:     addq.b  #1,D2
02:0002E730 0C020003        	   312:     cmpi.b  #$03,D2
02:0002E734 66CA            	   313:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   314:     ; Get the top 2 bits of text selector byte in [03],
                            	   315:     ; shift them to the bottom, and combine them with [00].
                            	   316:     ;
02:0002E736 102C0003        	   317:     move.b  ($0003,A4),D0
02:0002E73A E308            	   318:     lsl.b  #1,D0   ; ASL A
02:0002E73C E310            	   319:     roxl.b  #1,D0   ; ROL A
02:0002E73E E310            	   320:     roxl.b  #1,D0   ; ROL A
02:0002E740 1214            	   321:     move.b  ($0000,A4),D1
02:0002E742 8001            	   322:     or.b  D1,D0
02:0002E744 1880            	   323:     move.b  D0,($0000,A4)
                            	   324:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   325:     ; and combine them with [00].
                            	   326:     ;
02:0002E746 102C0002        	   327:     move.b  ($0002,A4),D0
02:0002E74A E208            	   328:     lsr.b  #1,D0   ; LSR A
02:0002E74C E208            	   329:     lsr.b  #1,D0   ; LSR A
02:0002E74E E208            	   330:     lsr.b  #1,D0   ; LSR A
02:0002E750 E208            	   331:     lsr.b  #1,D0   ; LSR A
02:0002E752 1214            	   332:     move.b  ($0000,A4),D1
02:0002E754 8001            	   333:     or.b  D1,D0
02:0002E756 1880            	   334:     move.b  D0,($0000,A4)
                            	   335:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   336:     ; and combine them with [00] into CaveFlags.
                            	   337:     ;
02:0002E758 102C0001        	   338:     move.b  ($0001,A4),D0
02:0002E75C E208            	   339:     lsr.b  #1,D0   ; LSR A
02:0002E75E E208            	   340:     lsr.b  #1,D0   ; LSR A
02:0002E760 1214            	   341:     move.b  ($0000,A4),D1
02:0002E762 8001            	   342:     or.b  D1,D0
02:0002E764 19400413        	   343:     move.b  D0,($0413,A4)
                            	   344:     ; The end result is a byte with 8 cave flags.
                            	   345:     ;
                            	   346:     ; If cave flag "money game" is missing, then go finish up,
                            	   347:     ; instead of choosing random amounts for the money game.
                            	   348:     ;
02:0002E768 02000020        	   349:     andi.b #$20,D0
02:0002E76C 6700009E        	   350:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   351:     ; Determine an index randomly with increasing probability,
                            	   352:     ; from 6 to 1. Start with the following test:
                            	   353:     ;
                            	   354:     ;   If $FF < Random, then go use index 6.
                            	   355:     ;
02:0002E770 103C00FF        	   356:     move.b  #$FF,D0
02:0002E774 7606            	   357:     moveq   #6,D3
                            	   358:     even
                            	   359: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E776 122C0019        	   360:     move.b  ($0019,A4),D1
02:0002E77A B001            	   361:     cmp.b   D1,D0
02:0002E77C 6516            	   362:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   363:     ; If the test fails, then subtract $2B from the reference number.
                            	   364:     ;
02:0002E77E 003C0011        	   365:     ori     #$11,CCR  ; SEC: set C+X
02:0002E782 123C002B        	   366:     move.b  #$2B,D1
02:0002E786 0A3C0010        	   367:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E78A 9101            	   368:     subx.b  D1,D0   ; SBC #$2B
02:0002E78C 0A3C0010        	   369:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E790 5303            	   370:     subq.b  #1,D3
02:0002E792 66E2            	   371:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   372:     even
                            	   373: _L_z01_InitCaveContinue_FoundPermutation:
                            	   374:     ; The index chooses the last offset of a permutation of three indexes.
                            	   375:     ;
02:0002E794 7400            	   376:     moveq   #0,D2
02:0002E796 41F90002E6A2    	   377:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E79C 14303000        	   378:     move.b  (A0,D3.W),D2
                            	   379:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   380:     ;
02:0002E7A0 7602            	   381:     moveq   #2,D3
                            	   382:     even
                            	   383: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E7A2 41F90002E690    	   384:     lea     (MoneyGamePermutations).l,A0
02:0002E7A8 10302000        	   385:     move.b  (A0,D2.W),D0
02:0002E7AC 41EC046C        	   386:     lea     ($046C,A4),A0
02:0002E7B0 11803000        	   387:     move.b  D0,(A0,D3.W)
02:0002E7B4 5302            	   388:     subq.b  #1,D2
02:0002E7B6 5303            	   389:     subq.b  #1,D3
02:0002E7B8 6AE8            	   390:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   391:     ; With the first bit of another random number, choose 10 or 40
                            	   392:     ; to put in [046F]. This is a random amount to lose.
                            	   393:     ;
02:0002E7BA 102C001A        	   394:     move.b  ($001A,A4),D0
02:0002E7BE 02000001        	   395:     andi.b #$01,D0
02:0002E7C2 7600            	   396:     moveq   #0,D3
02:0002E7C4 1600            	   397:     move.b  D0,D3
02:0002E7C6 41F90002E68E    	   398:     lea     (MoneyGameLossAmounts).l,A0
02:0002E7CC 10303000        	   399:     move.b  (A0,D3.W),D0
02:0002E7D0 1940046F        	   400:     move.b  D0,($046F,A4)
                            	   401:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   402:     ;
02:0002E7D4 700A            	   403:     moveq   #10,D0
02:0002E7D6 19400470        	   404:     move.b  D0,($0470,A4)
                            	   405:     ; With a different bit of the second random number,
                            	   406:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   407:     ;
02:0002E7DA 7614            	   408:     moveq   #20,D3
02:0002E7DC 102C001A        	   409:     move.b  ($001A,A4),D0
02:0002E7E0 02000002        	   410:     andi.b #$02,D0
02:0002E7E4 6702            	   411:     beq  _anon_z01_1
02:0002E7E6 7632            	   412:     moveq   #50,D3
                            	   413: _anon_z01_1:
02:0002E7E8 19430471        	   414:     move.b  D3,($0471,A4)
