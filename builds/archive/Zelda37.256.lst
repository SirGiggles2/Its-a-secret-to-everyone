                            	  3242:     ; leave the chase target coordinates with his old coordinates.
                            	  3243:     ;
02:0004ABF8 102C0061        	  3244:     move.b  ($0061,A4),D0
02:0004ABFC 122C0070        	  3245:     move.b  ($0070,A4),D1
02:0004AC00 B001            	  3246:     cmp.b   D1,D0
02:0004AC02 6610            	  3247:     bne  _L_z07_BeginUpdateWorld_LoopObject
