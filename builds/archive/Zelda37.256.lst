02:0003DCC2 4EB900030890    	 10257:     jsr     Abs
02:0003DCC8 7400            	 10258:     moveq   #0,D2
02:0003DCCA 61000166        	 10259:     jsr     Gleeok_CalcSegmentLimits
                            	 10260:     ; Get the absolute V-distance from the head to the base,
                            	 10261:     ; and divide it be 4.
