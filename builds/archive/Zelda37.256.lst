                            	  2539: _L_z04_UpdateTektiteOrBoulder_CheckStunned:
                            	  2540:     ; If we have the magic clock, or the monster is stunned; 
                            	  2541:     ; then go animate, draw, and check collisions.
                            	  2542:     ;
02:0003A3E6 102C066C        	  2543:     move.b  ($066C,A4),D0
02:0003A3EA 1234203D        	  2544:     move.b  ($3D,A4,D2.W),D1
02:0003A3EE 8001            	  2545:     or.b  D1,D0
02:0003A3F0 66F0            	  2546:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2547:     ; If state <> 0, go update the jump.
                            	  2548:     ;
02:0003A3F2 41EC00AC        	  2549:     lea     ($00AC,A4),A0
02:0003A3F6 10302000        	  2550:     move.b  (A0,D2.W),D0
02:0003A3FA 660000C0        	  2551:     bne  _L_z04_UpdateTektiteOrBoulder_State1
                            	  2552:     ; State 0. On the ground.
                            	  2553:     ;
                            	  2554:     ; If timer <> 0, then go animate, draw, and check collisions.
                            	  2555:     ;
02:0003A3FE 10342028        	  2556:     move.b  ($28,A4,D2.W),D0
