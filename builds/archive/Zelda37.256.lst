02:0003CB92 10302000        	  7971:     move.b  (A0,D2.W),D0
02:0003CB96 678A            	  7972:     beq  _L_z04_UpdateLikeLike_Exit
                            	  7973:     ; But once it has died, then let Link move again.
                            	  7974:     ;
02:0003CB98 7000            	  7975:     moveq   #0,D0
02:0003CB9A 19400512        	  7976:     move.b  D0,($0512,A4)
02:0003CB9E 6000CCEE        	  7977:     jmp     HideSpritesOverLink
