02:0003C18E 651E            	  6600:     bcs  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  6601:     ; Add the displacement for this fireball to its Y coordinate.
                            	  6602:     ;
02:0003C190 41EC0084        	  6603:     lea     ($0084,A4),A0
02:0003C194 10302000        	  6604:     move.b  (A0,D2.W),D0
02:0003C198 023C00EE        	  6605:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C19C 41EC0478        	  6606:     lea     ($0478,A4),A0
02:0003C1A0 12302000        	  6607:     move.b  (A0,D2.W),D1
02:0003C1A4 D101            	  6608:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C1A6 41EC0084        	  6609:     lea     ($0084,A4),A0
02:0003C1AA 11802000        	  6610:     move.b  D0,(A0,D2.W)
                            	  6611:     even
                            	  6612: _L_z04_Aquamentus_Shoot_NextLoopObject:
                            	  6613:     ; Bottom of the loop.
