02:0003B4E4 41EC0412        	  4931:     lea     ($0412,A4),A0
02:0003B4E8 16302000        	  4932:     move.b  (A0,D2.W),D3
02:0003B4EC 41F90003B31E    	  4933:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003B4F2 10303000        	  4934:     move.b  (A0,D3.W),D0
02:0003B4F6 0200000F        	  4935:     andi.b #$0F,D0
02:0003B4FA 41EC0098        	  4936:     lea     ($0098,A4),A0
