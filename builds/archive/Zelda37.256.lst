02:0003C0D4 0C000088        	  6495:     cmpi.b  #$88,D0
02:0003C0D8 6414            	  6496:     bcc  _L_z04_Aquamentus_Move_CheckRightLimit
02:0003C0DA 103C0088        	  6497:     move.b  #$88,D0
02:0003C0DE 19802070        	  6498:     move.b  D0,($70,A4,D2.W)
02:0003C0E2 7001            	  6499:     moveq   #1,D0
02:0003C0E4 41EC0098        	  6500:     lea     ($0098,A4),A0
