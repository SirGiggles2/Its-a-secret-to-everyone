02:0002BFAE 670A            	  2296:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2297:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2298:     eori    #$01,CCR
02:0002BFB8 4E75            	  2299:     rts
                            	  2300: .cc_cnras:
02:0002BFBA 023C00FE        	  2301:     andi    #$FE,CCR
