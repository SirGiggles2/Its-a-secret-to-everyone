                            	  6374: Digdogger_Draw:
02:0003BFDE 7006            	  6375:     moveq   #6,D0
02:0003BFE0 4EB90004C480    	  6376:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  6377:     ; If this is a child digdogger, then go draw it.
                            	  6378:     ;
02:0003BFE6 41EC046B        	  6379:     lea     ($046B,A4),A0
02:0003BFEA 10302000        	  6380:     move.b  (A0,D2.W),D0
02:0003BFEE 666C            	  6381:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  6382:     ; For each part of the big digdogger, from 0 to 3,
                            	  6383:     ; indexed by Y register:
