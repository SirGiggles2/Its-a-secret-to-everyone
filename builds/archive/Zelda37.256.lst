02:0004A504 4EB9000310DA    	  2363:     jsr     MapScreenPosToPpuAddr
02:0004A50A 7400            	  2364:     moveq   #0,D2
02:0004A50C 142C0301        	  2365:     move.b  ($0301,A4),D2
                            	  2366:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2367:     ;
                            	  2368:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2369:     ; In total, 11 bytes will be written.
                            	  2370:     ;
                            	  2371:     ; First, write the high byte of PPU address in each record.
                            	  2372:     ;
02:0004A510 1014            	  2373:     move.b  ($0000,A4),D0
02:0004A512 41EC0302        	  2374:     lea     ($0302,A4),A0
02:0004A516 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004A51A 41EC0307        	  2376:     lea     ($0307,A4),A0
02:0004A51E 11802000        	  2377:     move.b  D0,(A0,D2.W)
                            	  2378:     ; Write the low address in the first record. In the second record,
                            	  2379:     ; write (low address + 1).
                            	  2380:     ;
02:0004A522 102C0001        	  2381:     move.b  ($0001,A4),D0
02:0004A526 41EC0303        	  2382:     lea     ($0303,A4),A0
02:0004A52A 11802000        	  2383:     move.b  D0,(A0,D2.W)
02:0004A52E 41EC0308        	  2384:     lea     ($0308,A4),A0
02:0004A532 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:0004A536 41EC0308        	  2386:     lea     ($0308,A4),A0
02:0004A53A 52302000        	  2387:     addq.b  #1,(A0,D2.W)
                            	  2388:     ; Write the first tile twice in each record. Patch them later.
                            	  2389:     ;
02:0004A53E 102C0005        	  2390:     move.b  ($0005,A4),D0
02:0004A542 41EC0305        	  2391:     lea     ($0305,A4),A0
02:0004A546 11802000        	  2392:     move.b  D0,(A0,D2.W)
02:0004A54A 41EC0306        	  2393:     lea     ($0306,A4),A0
02:0004A54E 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:0004A552 41EC030A        	  2395:     lea     ($030A,A4),A0
02:0004A556 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:0004A55A 41EC030B        	  2397:     lea     ($030B,A4),A0
02:0004A55E 11802000        	  2398:     move.b  D0,(A0,D2.W)
                            	  2399:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2400:     ; Add 1 more to the second byte in each record.
                            	  2401:     ; Here is an example result of this manipulation:
                            	  2402:     ;   record 1: $70, $71
                            	  2403:     ;   record 2: $72, $73
                            	  2404:     ;
02:0004A562 0C000046        	  2405:     cmpi.b  #$46,D0
