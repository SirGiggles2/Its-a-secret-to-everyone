                            	  5822: ; [07]: damage points
                            	  5823: ; [0E]: vertical threshold
                            	  5824: ;
                            	  5825:     even
                            	  5826: CheckMonsterSlenderWeaponCollision:
02:00031E1E 19400007        	  5827:     move.b  D0,($0007,A4)
02:00031E22 102C000D        	  5828:     move.b  ($000D,A4),D0
02:00031E26 1940000E        	  5829:     move.b  D0,($000E,A4)
                            	  5830: ; Params:
                            	  5831: ; X: monster object slot
                            	  5832: ; [00]: weapon object slot
                            	  5833: ; [02]: monster object mid X
                            	  5834: ; [03]: monster object mid Y
                            	  5835: ; [07]: damage points
                            	  5836: ; [09]: damage type
                            	  5837: ; [0D]: horizontal threshold
                            	  5838: ; [0E]: vertical threshold
                            	  5839: ;
                            	  5840: ; Returns:
                            	  5841: ; [06]: 1 if objects collide
                            	  5842: ;
