02:000449F8 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:000449FC 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00044A00 E14C            	  8725:     lsl.w   #8,D4
02:00044A02 8841            	  8726:     or.w    D1,D4             ; D4 = NES ptr addr
02:00044A04 48C4            	  8727:     ext.l   D4
