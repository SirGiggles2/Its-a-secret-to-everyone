                            	  5014: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003B5A0 19400001        	  5015:     move.b  D0,($0001,A4)
02:0003B5A4 61000104        	  5016:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5017:     ; The default image is the hand open.
                            	  5018:     ; If animation frame = 0, then return.
                            	  5019:     ;
02:0003B5A8 7400            	  5020:     moveq   #0,D2
02:0003B5AA 142C0340        	  5021:     move.b  ($0340,A4),D2
02:0003B5AE 41EC03E4        	  5022:     lea     ($03E4,A4),A0
02:0003B5B2 10302000        	  5023:     move.b  (A0,D2.W),D0
02:0003B5B6 6724            	  5024:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5025:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5026:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5027:     ; The right side is correctly the right side of a closed hand.
                            	  5028:     ; But the left side is Keese. So, we have to patch the left
                            	  5029:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5030:     ;
                            	  5031:     ; Keep in mind that left and right sprites might be flipped.
                            	  5032:     ;
02:0003B5B8 7600            	  5033:     moveq   #0,D3
02:0003B5BA 1614            	  5034:     move.b  ($0000,A4),D3
02:0003B5BC 41EC0201        	  5035:     lea     ($0201,A4),A0
02:0003B5C0 10303000        	  5036:     move.b  (A0,D3.W),D0
02:0003B5C4 0C00009C        	  5037:     cmpi.b  #$9C,D0
02:0003B5C8 6706            	  5038:     beq  _anon_z04_68
02:0003B5CA 7600            	  5039:     moveq   #0,D3
02:0003B5CC 162C0001        	  5040:     move.b  ($0001,A4),D3
                            	  5041: _anon_z04_68:
02:0003B5D0 103C00AC        	  5042:     move.b  #$AC,D0
