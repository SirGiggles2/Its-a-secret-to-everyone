02:0003F536 E308            	 13688:     lsl.b  #1,D0   ; ASL A
02:0003F538 E308            	 13689:     lsl.b  #1,D0   ; ASL A
02:0003F53A 1214            	 13690:     move.b  ($0000,A4),D1
02:0003F53C 8001            	 13691:     or.b  D1,D0
02:0003F53E 1880            	 13692:     move.b  D0,($0000,A4)
                            	 13693:     even
                            	 13694: _L_z04_TurnTowardsPlayer8_SkipVertical:
                            	 13695:     ; Get the index of the object's direction.
                            	 13696:     ;
02:0003F540 610000C2        	 13697:     jsr     GetObjDir8Index
                            	 13698:     ; Check 3 directions turning left:
                            	 13699:     ; 1. right from object direction
                            	 13700:     ; 2. object direction
                            	 13701:     ; 3. left from object direction
                            	 13702:     ;
                            	 13703:     ; If the target direction matches any of these, then
                            	 13704:     ; leave the object's direction alone.
                            	 13705:     ;
02:0003F544 7003            	 13706:     moveq   #3,D0
02:0003F546 19400001        	 13707:     move.b  D0,($0001,A4)
02:0003F54A 5203            	 13708:     addq.b  #1,D3
                            	 13709:     even
