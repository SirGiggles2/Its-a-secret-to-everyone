02:0003107A 6630            	  4030:     bne  _L_z01_CheckMazes_CheckMountainMaze
02:0003107C 41F90003105E    	  4031:     lea     (ForestMazeDirs).l,A0
02:00031082 12302000        	  4032:     move.b  (A0,D2.W),D1
02:00031086 B001            	  4033:     cmp.b   D1,D0
02:00031088 6618            	  4034:     bne  _L_z01_CheckMazes_Mismatch
                            	  4035:     ; The direction matches the step.
                            	  4036:     ;
02:0003108A 0C020003        	  4037:     cmpi.b  #$03,D2
02:0003108E 6742            	  4038:     beq  _L_z01_CheckMazes_PlaySecretTune
                            	  4039:     even
                            	  4040: _L_z01_CheckMazes_AdvanceMaze:
