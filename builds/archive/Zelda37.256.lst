02:0003A110 4EB90004ADB4    	  2075:     jsr     GetCollidableTileStill
02:0003A116 0C00008D        	  2076:     cmpi.b  #$8D,D0
02:0003A11A 6512            	  2077:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A11C 0C000099        	  2078:     cmpi.b  #$99,D0
02:0003A120 640C            	  2079:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2080:     ; Flag the zora active, and set up the object.
