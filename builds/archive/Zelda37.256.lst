02:00042AE2 7600            	  5049:     moveq   #0,D3
02:00042AE4 162C00EB        	  5050:     move.b  ($00EB,A4),D3
02:00042AE8 41F900FF68FE    	  5051:     lea     (NES_SRAM+$08FE).l,A0
02:00042AEE 10303000        	  5052:     move.b  (A0,D3.W),D0
                            	  5053: _anon_z05_106:
