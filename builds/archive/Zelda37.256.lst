02:00042FE6 1014            	  5783:     move.b  ($0000,A4),D0
02:00042FE8 41EC0302        	  5784:     lea     ($0302,A4),A0
02:00042FEC 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:00042FF0 5202            	  5786:     addq.b  #1,D2
02:00042FF2 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00042FF6 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00042FFA 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:00042FFE 5202            	  5790:     addq.b  #1,D2
02:00043000 102C0006        	  5791:     move.b  ($0006,A4),D0
02:00043004 41EC0302        	  5792:     lea     ($0302,A4),A0
