                            	 11534: Lamnola_UpdateHead:
                            	 11535:     ; If X coordinate is not a multiple of 8, then return.
                            	 11536:     ;
02:0003E65E 10342070        	 11537:     move.b  ($70,A4,D2.W),D0
02:0003E662 02000007        	 11538:     andi.b #$07,D0
02:0003E666 6702            	 11539:     beq.s  __far_z_04_0112
02:0003E668 60F2            	 11540:     jmp  L12A6F_Exit
                            	 11541: __far_z_04_0112:
                            	 11542:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11543:     ; We had to account for the usual offset of 3.
                            	 11544:     ;
02:0003E66A 41EC0084        	 11545:     lea     ($0084,A4),A0
02:0003E66E 10302000        	 11546:     move.b  (A0,D2.W),D0
02:0003E672 023C00EE        	 11547:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E676 123C0003        	 11548:     move.b  #$03,D1
02:0003E67A D101            	 11549:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E67C 02000007        	 11550:     andi.b #$07,D0
02:0003E680 6702            	 11551:     beq.s  __far_z_04_0113
02:0003E682 60D8            	 11552:     jmp  L12A6F_Exit
                            	 11553: __far_z_04_0113:
                            	 11554:     ; Will loop 4 times, propagating directions down the chain,
                            	 11555:     ; by pulling from the bottom.
                            	 11556:     ;
02:0003E684 7004            	 11557:     moveq   #4,D0
02:0003E686 1880            	 11558:     move.b  D0,($0000,A4)
                            	 11559:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11560:     ;
02:0003E688 7600            	 11561:     moveq   #0,D3
02:0003E68A 0C020005        	 11562:     cmpi.b  #$05,D2
02:0003E68E 6702            	 11563:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003E690 7605            	 11564:     moveq   #5,D3
                            	 11565:     even
                            	 11566: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11567:     ; Loop over every segment under the head, starting from the tail.
                            	 11568:     ; Copy the next segment's direction to the current one in this loop.
                            	 11569:     ;
02:0003E692 41EC009A        	 11570:     lea     ($009A,A4),A0
02:0003E696 10303000        	 11571:     move.b  (A0,D3.W),D0
02:0003E69A 41EC0099        	 11572:     lea     ($0099,A4),A0
02:0003E69E 11803000        	 11573:     move.b  D0,(A0,D3.W)
02:0003E6A2 5203            	 11574:     addq.b  #1,D3
02:0003E6A4 5314            	 11575:     subq.b  #1,($0000,A4)
02:0003E6A6 66EA            	 11576:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11577:     ; If this head segment is not aligned with a square, then return.
                            	 11578:     ;
02:0003E6A8 10342070        	 11579:     move.b  ($70,A4,D2.W),D0
02:0003E6AC 0200000F        	 11580:     andi.b #$0F,D0
02:0003E6B0 660000BA        	 11581:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11582:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11583:     ; We had to account for the usual offset of 3.
                            	 11584:     ;
02:0003E6B4 41EC0084        	 11585:     lea     ($0084,A4),A0
02:0003E6B8 10302000        	 11586:     move.b  (A0,D2.W),D0
02:0003E6BC 023C00EE        	 11587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6C0 123C0003        	 11588:     move.b  #$03,D1
02:0003E6C4 D101            	 11589:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E6C6 0200000F        	 11590:     andi.b #$0F,D0
02:0003E6CA 660000A0        	 11591:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11592:     ; Store the opposite of the facing direction in [00].
                            	 11593:     ;
02:0003E6CE 41EC0098        	 11594:     lea     ($0098,A4),A0
02:0003E6D2 10302000        	 11595:     move.b  (A0,D2.W),D0
02:0003E6D6 E208            	 11596:     lsr.b  #1,D0   ; LSR A
02:0003E6D8 02000005        	 11597:     andi.b #$05,D0
02:0003E6DC 1880            	 11598:     move.b  D0,($0000,A4)
02:0003E6DE 41EC0098        	 11599:     lea     ($0098,A4),A0
02:0003E6E2 10302000        	 11600:     move.b  (A0,D2.W),D0
02:0003E6E6 E308            	 11601:     lsl.b  #1,D0   ; ASL A
02:0003E6E8 0200000A        	 11602:     andi.b #$0A,D0
02:0003E6EC 1214            	 11603:     move.b  ($0000,A4),D1
02:0003E6EE 8001            	 11604:     or.b  D1,D0
                            	 11605:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11606:     ;
02:0003E6F0 0A00000F        	 11607:     eori.b #$0F,D0
02:0003E6F4 1940050F        	 11608:     move.b  D0,($050F,A4)
                            	 11609:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11610:     ;
02:0003E6F8 10342018        	 11611:     move.b  ($18,A4,D2.W),D0
02:0003E6FC 0C000080        	 11612:     cmpi.b  #$80,D0
02:0003E700 656C            	 11613:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11614:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11615:     ; Load the monster's facing direction.
                            	 11616:     ;
02:0003E702 41EC0098        	 11617:     lea     ($0098,A4),A0
02:0003E706 10302000        	 11618:     move.b  (A0,D2.W),D0
                            	 11619:     ; Load the next random number into Y register.
                            	 11620:     ;
02:0003E70A 7600            	 11621:     moveq   #0,D3
02:0003E70C 16342019        	 11622:     move.b  ($19,A4,D2.W),D3
                            	 11623:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11624:     ; to keep moving straight.
                            	 11625:     ;
02:0003E710 0C030080        	 11626:     cmpi.b  #$80,D3
02:0003E714 6418            	 11627:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11628:     even
                            	 11629: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11630:     ; Loop to rotate the direction bit over the mask.
                            	 11631:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11632:     ; facing direction.
                            	 11633:     ;
                            	 11634:     ; Shift right the copy of the direction.
                            	 11635:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11636:     ;
02:0003E716 E208            	 11637:     lsr.b  #1,D0   ; LSR A
02:0003E718 6402            	 11638:     bcc  _anon_z04_151
02:0003E71A 7008            	 11639:     moveq   #8,D0
                            	 11640: _anon_z04_151:
                            	 11641:     ; If the current direction bit is masked off, then we've reached
                            	 11642:     ; the opposite direction. Loop again.
                            	 11643:     ;
02:0003E71C 122C050F        	 11644:     move.b  ($050F,A4),D1
02:0003E720 C200            	 11645:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E722 67F2            	 11646:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11647:     ; If Y register >= $40, then break out of the loop.
                            	 11648:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11649:     ;
02:0003E724 0C030040        	 11650:     cmpi.b  #$40,D3
02:0003E728 6404            	 11651:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11652:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11653:     ; and loop again now.
                            	 11654:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11655:     ;
02:0003E72A 7640            	 11656:     moveq   #64,D3
02:0003E72C 65E8            	 11657:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11658:     even
                            	 11659: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11660:     ; Change the facing direction to the direction found.
                            	 11661:     ;
02:0003E72E 41EC0098        	 11662:     lea     ($0098,A4),A0
02:0003E732 11802000        	 11663:     move.b  D0,(A0,D2.W)
                            	 11664:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11665:     ;
