02:0003C02A 10303000        	  6409:     move.b  (A0,D3.W),D0
02:0003C02E 4EB90003162A    	  6410:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003C034 1003            	  6411:     move.b  D3,D0
