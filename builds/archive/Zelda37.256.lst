02:0003B50E 10302000        	  4946:     move.b  (A0,D2.W),D0
02:0003B512 0C000007        	  4947:     cmpi.b  #$07,D0
02:0003B516 652C            	  4948:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  4949:     ; It has reached the end of a trip.
