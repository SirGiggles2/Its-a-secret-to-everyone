                            	  5742: _L_z07_CheckState30_MoveTowardThrower:
                            	  5743:     ; Move towards the thrower.
                            	  5744:     ;
                            	  5745:     ; Middle speed index 4 goes equally fast in X and Y axes.
                            	  5746:     ;
02:0004BC52 7604            	  5747:     moveq   #4,D3
02:0004BC54 4EB900030932    	  5748:     jsr     _CalcDiagonalSpeedIndex
                            	  5749:     ; Move vertically towards the thrower.
                            	  5750:     ;
02:0004BC5A 41F90004B934    	  5751:     lea     (BoomerangQSpeedFracsY).l,A0
02:0004BC60 10303000        	  5752:     move.b  (A0,D3.W),D0
02:0004BC64 4EB9000309B8    	  5753:     jsr     SetBoomerangSpeed
02:0004BC6A 102C000A        	  5754:     move.b  ($000A,A4),D0
02:0004BC6E 1940000F        	  5755:     move.b  D0,($000F,A4)
02:0004BC72 41EC0098        	  5756:     lea     ($0098,A4),A0
02:0004BC76 11802000        	  5757:     move.b  D0,(A0,D2.W)
02:0004BC7A 1003            	  5758:     move.b  D3,D0
02:0004BC7C 1B00            	  5759:     move.b  D0,-(A5)  ; PHA
02:0004BC7E 6100F48E        	  5760:     jsr     MoveObject
                            	  5761:     ; Move horizontally towards the thrower.
                            	  5762:     ;
02:0004BC82 101D            	  5763:     move.b  (A5)+,D0  ; PLA
02:0004BC84 7600            	  5764:     moveq   #0,D3
02:0004BC86 1600            	  5765:     move.b  D0,D3
02:0004BC88 41F90004B93E    	  5766:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004BC8E 10303000        	  5767:     move.b  (A0,D3.W),D0
02:0004BC92 4EB9000309B8    	  5768:     jsr     SetBoomerangSpeed
