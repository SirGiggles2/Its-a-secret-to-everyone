02:000301AA 023C00EE        	  1816:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  1817:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  1818:     ;
02:000301AE 122C0340        	  1819:     move.b  ($0340,A4),D1
02:000301B2 D101            	  1820:     addx.b  D1,D0   ; ADC CurObjIndex
02:000301B4 7400            	  1821:     moveq   #0,D2
02:000301B6 1400            	  1822:     move.b  D0,D2
                            	  1823:     ; Look up and set the location for this iteration's individual trap.
                            	  1824:     ;
02:000301B8 41F90003017C    	  1825:     lea     (TrapXs).l,A0
02:000301BE 10303000        	  1826:     move.b  (A0,D3.W),D0
02:000301C2 19802070        	  1827:     move.b  D0,($70,A4,D2.W)
02:000301C6 41F900030182    	  1828:     lea     (TrapYs).l,A0
02:000301CC 10303000        	  1829:     move.b  (A0,D3.W),D0
02:000301D0 41EC0084        	  1830:     lea     ($0084,A4),A0
02:000301D4 11802000        	  1831:     move.b  D0,(A0,D2.W)
02:000301D8 619E            	  1832:     jsr     InitOneSimpleObject
02:000301DA 5302            	  1833:     subq.b  #1,D2
02:000301DC 5303            	  1834:     subq.b  #1,D3
02:000301DE 6AC8            	  1835:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:000301E0 4E75            	  1836:     rts
