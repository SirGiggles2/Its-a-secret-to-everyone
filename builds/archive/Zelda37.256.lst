                            	  4010:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4011:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4012:     ;
                            	  4013:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4014:     ; a doorway to be part of it.
                            	  4015:     ;
