                            	  3571: 
                            	  3572: ; Each byte describes an item. The high nibble is the type.
                            	  3573: ; The low nibble is the value. Its meaning depends on the type.
                            	  3574: ;
                            	  3575: ; 0x - individuals
                            	  3576: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  3577: ; * bit mask: value doesn't matter.
                            	  3578: ;
                            	  3579: ; 1x - amounts
                            	  3580: ; Value is an amount to add.
                            	  3581: ;
                            	  3582: ; 2x - grades
                            	  3583: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  3584: ;
                            	  3585: ; 3x - error?
                            	  3586: ; Produces an item value of $FF.
                            	  3587: ;
                            	  3588:     even
                            	  3589: ItemIdToDescriptor:
