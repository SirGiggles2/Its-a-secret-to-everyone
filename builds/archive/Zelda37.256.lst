02:0003C2F4 123C0010        	  6798:     move.b  #$10,D1
02:0003C2F8 D101            	  6799:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C2FA 19802070        	  6800:     move.b  D0,($70,A4,D2.W)
02:0003C2FE 163C00F0        	  6801:     move.b  #$F0,D3
