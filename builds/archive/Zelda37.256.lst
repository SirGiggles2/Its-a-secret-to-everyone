02:00031AC6 122C0009        	  5272:     move.b  ($0009,A4),D1
02:00031ACA C001            	  5273:     and.b  D1,D0
02:00031ACC 6704            	  5274:     beq  _anon_z01_88
02:00031ACE 61000348        	  5275:     jsr     PlayParryTune
                            	  5276: _anon_z01_88:
                            	  5277:     ; Set the boomerang state to return fast to the thrower.
