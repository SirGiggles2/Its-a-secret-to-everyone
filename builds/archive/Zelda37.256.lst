                            	  5082: Wallmaster_PrepareToDraw:
02:0003B61C 4EF90002BEFA    	  5083:     jmp     c_wallmaster_prepare_to_draw
                            	  5084: 
                            	  5085: Wallmaster_CalcStartPosition:
02:0003B622 41EC0412        	  5086:     lea     ($0412,A4),A0
02:0003B626 11802000        	  5087:     move.b  D0,(A0,D2.W)
02:0003B62A 19430003        	  5088:     move.b  D3,($0003,A4)
                            	  5089:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5090:     ;
02:0003B62E 7024            	  5091:     moveq   #36,D0
