02:00043B84 10303000        	  7055:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043B88 0C0000C4        	  7056:     cmpi.b  #$C4,D0
02:00043B8C 6728            	  7057:     beq  _L_z05_CheckShortcut_WriteStairs
02:00043B8E 0C0000BC        	  7058:     cmpi.b  #$BC,D0
02:00043B92 6720            	  7059:     beq  _L_z05_CheckShortcut_Exit
02:00043B94 0C0000D8        	  7060:     cmpi.b  #$D8,D0
