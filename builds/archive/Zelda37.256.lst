                            	  4083: _L_z01_CheckMazes_PlaySecretTune:
                            	  4084:     ; Play secret tune, and let the player leave the maze.
                            	  4085:     ;
02:000310D2 7004            	  4086:     moveq   #4,D0
02:000310D4 19400602        	  4087:     move.b  D0,($0602,A4)
02:000310D8 4E75            	  4088:     rts
                            	  4089: 
                            	  4090: ; Params:
                            	  4091: ; [02]: Y
                            	  4092: ; [03]: X
                            	  4093: ;
                            	  4094: ; Returns:
                            	  4095: ; [00]: high byte of PPU address
                            	  4096: ; [01]: low byte of PPU address
                            	  4097: ;
                            	  4098: ;
                            	  4099: ; Turn the 16-bit value 08YY into the PPU address
                            	  4100: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  4101: ;
                            	  4102: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  4103: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  4104: ;
                            	  4105:     even
                            	  4106: MapScreenPosToPpuAddr:
02:000310DA 6000A98A        	  4107:     jmp     c_map_screen_pos_to_ppu_addr
