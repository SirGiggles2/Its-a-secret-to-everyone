                            	 13725:     ; Check 3 directions turning right:
                            	 13726:     ; 1. left of object direction
                            	 13727:     ; 2. object direction
                            	 13728:     ; 3. right of object direction
                            	 13729:     ;
                            	 13730:     ; If any direction component of the target direction matches
                            	 13731:     ; these, then see if we should turn to this direction.
                            	 13732:     ;
02:0003F570 7003            	 13733:     moveq   #3,D0
02:0003F572 19400001        	 13734:     move.b  D0,($0001,A4)
02:0003F576 5203            	 13735:     addq.b  #1,D3
                            	 13736:     even
