02:00030312 9101            	  1995:     subx.b  D1,D0   ; SBC $00
02:00030314 0A3C0010        	  1996:     eori    #$10,CCR  ; restore X = 6502 C
02:00030318 61000576        	  1997:     jsr     Abs
