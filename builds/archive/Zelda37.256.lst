                            	  1615:     even
                            	  1616: InitMode4:
02:000407BA 7400            	  1617:     moveq   #0,D2
02:000407BC 142C0013        	  1618:     move.b  ($0013,A4),D2
02:000407C0 6604            	  1619:     bne.s  __far_z_05_0023
02:000407C2 60000084        	  1620:     jmp  InitMode_EnterRoom
                            	  1621: __far_z_05_0023:
02:000407C6 5302            	  1622:     subq.b  #1,D2
02:000407C8 6612            	  1623:     bne  _L_z05_InitMode4_CheckSub2
                            	  1624:     ; Submode 1.
                            	  1625:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1626:     ;
                            	  1627:     ; TODO:
                            	  1628:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1629:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1630:     ; A positive value triggers this submode 1 to transfer
                            	  1631:     ; the whole play area.
                            	  1632:     ;
                            	  1633:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1634:     ; a good state reflecting the new room. The only thing
                            	  1635:     ; needed is possibly to brighten the room by way of
                            	  1636:     ; changing the palette.
                            	  1637:     ;
                            	  1638:     ; So why does mode 7 trigger this?
                            	  1639:     ; Is there another mode that truly needs this behavior?
                            	  1640:     ;
02:000407CA 102C00E9        	  1641:     move.b  ($00E9,A4),D0
02:000407CE 6B06            	  1642:     bmi  _anon_z05_40
02:000407D0 61003492        	  1643:     jsr     CopyNextRowToTransferBuf
02:000407D4 6404            	  1644:     bcc  _L_z05_InitMode4_Exit
                            	  1645: _anon_z05_40:
02:000407D6 522C0013        	  1646:     addq.b  #1,($0013,A4)
                            	  1647:     even
                            	  1648: _L_z05_InitMode4_Exit:
02:000407DA 4E75            	  1649:     rts
                            	  1650: 
                            	  1651:     even
                            	  1652: _L_z05_InitMode4_CheckSub2:
02:000407DC 5302            	  1653:     subq.b  #1,D2
02:000407DE 6702            	  1654:     beq.s  __far_z_05_0024
02:000407E0 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
