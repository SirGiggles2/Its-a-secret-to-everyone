02:0003C098 662C            	  6464:     bne  _L_z04_Aquamentus_Move_Move
                            	  6465:     ; Set a random distance to move of 7 or $F pixels.
                            	  6466:     ;
02:0003C09A 10342018        	  6467:     move.b  ($18,A4,D2.W),D0
02:0003C09E 1B00            	  6468:     move.b  D0,-(A5)  ; PHA
02:0003C0A0 0200000F        	  6469:     andi.b #$0F,D0
02:0003C0A4 00000007        	  6470:     ori.b #$07,D0
02:0003C0A8 41EC0394        	  6471:     lea     ($0394,A4),A0
02:0003C0AC 11802000        	  6472:     move.b  D0,(A0,D2.W)
02:0003C0B0 101D            	  6473:     move.b  (A5)+,D0  ; PLA
                            	  6474:     ; Randomly head left or right.
                            	  6475:     ;
02:0003C0B2 02000001        	  6476:     andi.b #$01,D0
02:0003C0B6 7600            	  6477:     moveq   #0,D3
02:0003C0B8 1600            	  6478:     move.b  D0,D3
02:0003C0BA 5203            	  6479:     addq.b  #1,D3
02:0003C0BC 41EC0098        	  6480:     lea     ($0098,A4),A0
02:0003C0C0 11832000        	  6481:     move.b  D3,(A0,D2.W)
02:0003C0C4 4E75            	  6482:     rts
