02:0003B9C4 1940009D        	  5528:     move.b  D0,($009D,A4)
02:0003B9C8 19400385        	  5529:     move.b  D0,($0385,A4)
02:0003B9CC 102C0022        	  5530:     move.b  ($0022,A4),D0
02:0003B9D0 02000007        	  5531:     andi.b #$07,D0
02:0003B9D4 7600            	  5532:     moveq   #0,D3
