                            	  5825: CalcBoomerangFrame:
                            	  5826:     ; The minor state (low 3 bits of state) is used to
                            	  5827:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5828:     ;
                            	  5829:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5830:     ; In other words, don't offset the coordinate below.
                            	  5831:     ;
02:0004BD18 7000            	  5832:     moveq   #0,D0
02:0004BD1A 1880            	  5833:     move.b  D0,($0000,A4)
02:0004BD1C 41EC00AC        	  5834:     lea     ($00AC,A4),A0
02:0004BD20 10302000        	  5835:     move.b  (A0,D2.W),D0
02:0004BD24 0200000F        	  5836:     andi.b #$0F,D0
02:0004BD28 7600            	  5837:     moveq   #0,D3
02:0004BD2A 1600            	  5838:     move.b  D0,D3
02:0004BD2C 7000            	  5839:     moveq   #0,D0
02:0004BD2E 19400001        	  5840:     move.b  D0,($0001,A4)
02:0004BD32 41F90004B920    	  5841:     lea     (BoomerangFrameCycle).l,A0
02:0004BD38 10303000        	  5842:     move.b  (A0,D3.W),D0
02:0004BD3C 1940000C        	  5843:     move.b  D0,($000C,A4)
                            	  5844:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5845:     ;
02:0004BD40 1003            	  5846:     move.b  D3,D0
02:0004BD42 41F90004B92A    	  5847:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004BD48 10303000        	  5848:     move.b  (A0,D3.W),D0
02:0004BD4C 19400004        	  5849:     move.b  D0,($0004,A4)
                            	  5850:     ; TODO: ?
                            	  5851:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5852:     ; Else add the item value of the magic boomerang.
                            	  5853:     ;
                            	  5854:     ; But none of the values in the base sprite attributes array is 8.
                            	  5855:     ;
                            	  5856:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5857:     ; the inventory will always be added to the base sprite attribute.
                            	  5858:     ;
                            	  5859:     ; So, palette row 4 or 5 will be chosen.
                            	  5860:     ;
02:0004BD50 7600            	  5861:     moveq   #0,D3
02:0004BD52 0C000008        	  5862:     cmpi.b  #$08,D0
02:0004BD56 6706            	  5863:     beq  _anon_z07_31
02:0004BD58 7600            	  5864:     moveq   #0,D3
02:0004BD5A 162C0675        	  5865:     move.b  ($0675,A4),D3
