                            	  5010: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  5011:     ; Link and the shot are facing opposite directions.
                            	  5012:     ; Link can parry certain weapons/shots.
                            	  5013:     ;
                            	  5014:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  5015:     ; no harmful collision; but it still counts as a shot collision.
                            	  5016:     ; So, go treat this as a parry.
                            	  5017:     ;
02:00031902 41EC034F        	  5018:     lea     ($034F,A4),A0
02:00031906 10302000        	  5019:     move.b  (A0,D2.W),D0
02:0003190A 0C000055        	  5020:     cmpi.b  #$55,D0
02:0003190E 650E            	  5021:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031910 0C00005B        	  5022:     cmpi.b  #$5B,D0
02:00031914 6408            	  5023:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  5024:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  5025:     ; So, go harm Link.
                            	  5026:     ;
02:00031916 102C0676        	  5027:     move.b  ($0676,A4),D0
02:0003191A 6602            	  5028:     bne.s  __far_z_01_0046
02:0003191C 600E            	  5029:     jmp  HarmLink
                            	  5030: __far_z_01_0046:
