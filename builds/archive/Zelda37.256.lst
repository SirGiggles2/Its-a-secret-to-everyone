                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:000364AE 103C00FF        	  5176:     move.b  #$FF,D0
02:000364B2 19400325        	  5177:     move.b  D0,($0325,A4)
02:000364B6 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:000364BA 7020            	  5181:     moveq   #32,D0
02:000364BC 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:000364C0 7400            	  5185:     moveq   #0,D2
02:000364C2 142C050C        	  5186:     move.b  ($050C,A4),D2
02:000364C6 41F90003626C    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:000364CC 10302000        	  5188:     move.b  (A0,D2.W),D0
02:000364D0 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:000364D4 102C050D        	  5192:     move.b  ($050D,A4),D0
02:000364D8 7600            	  5193:     moveq   #0,D3
02:000364DA 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:000364DC E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:000364DE E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:000364E0 E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:000364E2 E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:000364E4 E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:000364E6 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:000364EA 41F900036278    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:000364F0 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:000364F4 E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:000364F6 5303            	  5212:     subq.b  #1,D3
02:000364F8 6AFA            	  5213:     bpl  _anon_z02_43
02:000364FA 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:000364FE 7600            	  5218:     moveq   #0,D3
02:00036500 162C050E        	  5219:     move.b  ($050E,A4),D3
02:00036504 0C030017        	  5220:     cmpi.b  #$17,D3
02:00036508 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:0003650C 7400            	  5224:     moveq   #0,D2
02:0003650E 142C0016        	  5225:     move.b  ($0016,A4),D2
02:00036512 41EC062D        	  5226:     lea     ($062D,A4),A0
02:00036516 10302000        	  5227:     move.b  (A0,D2.W),D0
02:0003651A 6608            	  5228:     bne  _anon_z02_44
02:0003651C 0C030010        	  5229:     cmpi.b  #$10,D3
02:00036520 64000114        	  5230:     bcc  _L_z02_DrawCredits_IncLine
                            	  5231: _anon_z02_44:
02:00036524 7400            	  5232:     moveq   #0,D2
02:00036526 142C0016        	  5233:     move.b  ($0016,A4),D2
02:0003652A 41EC062D        	  5234:     lea     ($062D,A4),A0
02:0003652E 10302000        	  5235:     move.b  (A0,D2.W),D0
                            	  5236:     ; In the second quest, skip lines $C to $F.
                            	  5237:     ;
02:00036532 670E            	  5238:     beq  _anon_z02_45
02:00036534 0C03000C        	  5239:     cmpi.b  #$0C,D3
02:00036538 6508            	  5240:     bcs  _anon_z02_45
02:0003653A 0C030010        	  5241:     cmpi.b  #$10,D3
02:0003653E 650000F6        	  5242:     bcs  _L_z02_DrawCredits_IncLine
                            	  5243: _anon_z02_45:
02:00036542 41F900036284    	  5244:     lea     (CreditsTextAddrsLo).l,A0
02:00036548 10303000        	  5245:     move.b  (A0,D3.W),D0
02:0003654C 1880            	  5246:     move.b  D0,($0000,A4)
02:0003654E 41F90003629C    	  5247:     lea     (CreditsTextAddrsHi).l,A0
02:00036554 10303000        	  5248:     move.b  (A0,D3.W),D0
02:00036558 19400001        	  5249:     move.b  D0,($0001,A4)
                            	  5250:     ; First read the length of the string.
                            	  5251:     ;
02:0003655C 7600            	  5252:     moveq   #0,D3
02:0003655E 1214            	  5253:     move.b  ($00,A4),D1   ; ptr lo
02:00036560 182C0001        	  5254:     move.b  ($01,A4),D4  ; ptr hi
02:00036564 024100FF        	  5255:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036568 E14C            	  5256:     lsl.w   #8,D4
02:0003656A 8841            	  5257:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003656C 48C4            	  5258:     ext.l   D4
02:0003656E D8BC00FF0000    	  5259:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036574 2044            	  5260:     movea.l D4,A0
02:00036576 10303000        	  5261:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003657A 19400002        	  5262:     move.b  D0,($0002,A4)
                            	  5263:     ; Second, read the offset where the first character goes
                            	  5264:     ; in the line.
                            	  5265:     ;
02:0003657E 5203            	  5266:     addq.b  #1,D3
02:00036580 1214            	  5267:     move.b  ($00,A4),D1   ; ptr lo
02:00036582 182C0001        	  5268:     move.b  ($01,A4),D4  ; ptr hi
02:00036586 024100FF        	  5269:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003658A E14C            	  5270:     lsl.w   #8,D4
02:0003658C 8841            	  5271:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003658E 48C4            	  5272:     ext.l   D4
02:00036590 D8BC00FF0000    	  5273:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036596 2044            	  5274:     movea.l D4,A0
02:00036598 10303000        	  5275:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003659C 7400            	  5276:     moveq   #0,D2
02:0003659E 1400            	  5277:     move.b  D0,D2
                            	  5278:     ; Loop over each character in the rest of the credits source record.
                            	  5279:     ;
02:000365A0 5203            	  5280:     addq.b  #1,D3
                            	  5281: _anon_z02_46:
02:000365A2 1214            	  5282:     move.b  ($00,A4),D1   ; ptr lo
02:000365A4 182C0001        	  5283:     move.b  ($01,A4),D4  ; ptr hi
02:000365A8 024100FF        	  5284:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000365AC E14C            	  5285:     lsl.w   #8,D4
02:000365AE 8841            	  5286:     or.w    D1,D4             ; D4 = NES ptr addr
02:000365B0 48C4            	  5287:     ext.l   D4
02:000365B2 D8BC00FF0000    	  5288:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000365B8 2044            	  5289:     movea.l D4,A0
02:000365BA 10303000        	  5290:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000365BE 41EC0305        	  5291:     lea     ($0305,A4),A0
02:000365C2 11802000        	  5292:     move.b  D0,(A0,D2.W)
02:000365C6 5203            	  5293:     addq.b  #1,D3
02:000365C8 5202            	  5294:     addq.b  #1,D2
02:000365CA 532C0002        	  5295:     subq.b  #1,($0002,A4)
02:000365CE 66D2            	  5296:     bne  _anon_z02_46
                            	  5297:     ; If line index <> $11, go increment.
                            	  5298:     ;
02:000365D0 7600            	  5299:     moveq   #0,D3
02:000365D2 162C050E        	  5300:     move.b  ($050E,A4),D3
02:000365D6 0C03000C        	  5301:     cmpi.b  #$0C,D3
02:000365DA 655A            	  5302:     bcs  _L_z02_DrawCredits_IncLine
02:000365DC 0C030011        	  5303:     cmpi.b  #$11,D3
