                            	  7738: __far_z_07_0124:
                            	  7739:     ; 7 of every 8 frames, return.
                            	  7740:     ;
02:0004CCAE 102C0015        	  7741:     move.b  ($0015,A4),D0
02:0004CCB2 02000007        	  7742:     andi.b #$07,D0
02:0004CCB6 0C000004        	  7743:     cmpi.b  #$04,D0
02:0004CCBA 6702            	  7744:     beq.s  __far_z_07_0125
02:0004CCBC 604C            	  7745:     jmp  L1FF28_Exit
                            	  7746: __far_z_07_0125:
                            	  7747:     ; So, every 8 frames:
                            	  7748:     ; 1. Increment the secret color cycle count.
                            	  7749:     ; 2. Change the water palette.
                            	  7750:     ;
                            	  7751:     ; But when the count = $B, go reveal the stairs.
                            	  7752:     ;
02:0004CCBE 522C051A        	  7753:     addq.b  #1,($051A,A4)
02:0004CCC2 0C03000B        	  7754:     cmpi.b  #$0B,D3
02:0004CCC6 6602            	  7755:     bne.s  __far_z_07_0126
02:0004CCC8 6042            	  7756:     jmp  RevealPondStairs
