02:0003A690 41EC041F        	  2902:     lea     ($041F,A4),A0
02:0003A694 10302000        	  2903:     move.b  (A0,D2.W),D0
02:0003A698 023C00EE        	  2904:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A69C 1214            	  2905:     move.b  ($0000,A4),D1
02:0003A69E D101            	  2906:     addx.b  D1,D0   ; ADC $00
02:0003A6A0 41EC041F        	  2907:     lea     ($041F,A4),A0
02:0003A6A4 11802000        	  2908:     move.b  D0,(A0,D2.W)
                            	  2909:     ; Carry over to the high speed byte.
                            	  2910:     ;
02:0003A6A8 41EC0412        	  2911:     lea     ($0412,A4),A0
02:0003A6AC 10302000        	  2912:     move.b  (A0,D2.W),D0
02:0003A6B0 123C0000        	  2913:     move.b  #$00,D1
02:0003A6B4 D101            	  2914:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A6B6 41EC0412        	  2915:     lea     ($0412,A4),A0
02:0003A6BA 11802000        	  2916:     move.b  D0,(A0,D2.W)
                            	  2917:     ; *Signed comparison*:
                            	  2918:     ; If the high speed byte < high max speed byte, then return.
                            	  2919:     ;
                            	  2920:     ; Note that this is not a general purpose signed comparison,
