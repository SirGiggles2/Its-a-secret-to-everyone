02:0003A0CE 142C0059        	  2041:     move.b  ($0059,A4),D2
                            	  2042:     even
                            	  2043: _L_z04_CheckZora_LoopTileCandidate:
                            	  2044:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2045:     ; If it = 0 or $F0, go loop again.
                            	  2046:     ;
02:0003A0D2 7600            	  2047:     moveq   #0,D3
02:0003A0D4 162C000D        	  2048:     move.b  ($000D,A4),D3
02:0003A0D8 10343018        	  2049:     move.b  ($18,A4,D3.W),D0
02:0003A0DC 020000F0        	  2050:     andi.b #$F0,D0
02:0003A0E0 19802070        	  2051:     move.b  D0,($70,A4,D2.W)
02:0003A0E4 6748            	  2052:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A0E6 0C0000F0        	  2053:     cmpi.b  #$F0,D0
02:0003A0EA 6742            	  2054:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2055:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2056:     ; If it < $50 or >= $E0, go loop again.
                            	  2057:     ;
02:0003A0EC 10343018        	  2058:     move.b  ($18,A4,D3.W),D0
02:0003A0F0 E308            	  2059:     lsl.b  #1,D0   ; ASL A
02:0003A0F2 E308            	  2060:     lsl.b  #1,D0   ; ASL A
02:0003A0F4 E308            	  2061:     lsl.b  #1,D0   ; ASL A
02:0003A0F6 E308            	  2062:     lsl.b  #1,D0   ; ASL A
02:0003A0F8 0C000050        	  2063:     cmpi.b  #$50,D0
02:0003A0FC 6530            	  2064:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A0FE 0C0000E0        	  2065:     cmpi.b  #$E0,D0
02:0003A102 642A            	  2066:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2067:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2068:     ;
02:0003A104 0000000D        	  2069:     ori.b #$0D,D0
02:0003A108 41EC0084        	  2070:     lea     ($0084,A4),A0
02:0003A10C 11802000        	  2071:     move.b  D0,(A0,D2.W)
                            	  2072:     ; Get the tile at that location.
                            	  2073:     ; If it's not a water tile, then go loop again.
