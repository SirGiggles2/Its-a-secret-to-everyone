                            	 12264:     ;
02:0003EB56 194000AC        	 12265:     move.b  D0,($00AC,A4)
02:0003EB5A 19400505        	 12266:     move.b  D0,($0505,A4)
02:0003EB5E 7020            	 12267:     moveq   #32,D0
02:0003EB60 19400600        	 12268:     move.b  D0,($0600,A4)
02:0003EB64 522C0445        	 12269:     addq.b  #1,($0445,A4)
                            	 12270:     even
