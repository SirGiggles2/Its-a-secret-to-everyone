                            	  1795:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  1796:     ;
02:00030194 7605            	  1797:     moveq   #5,D3
                            	  1798:     ; The individual trap objects to make will be of type $49.
                            	  1799:     ; Store it in [00].
                            	  1800:     ;
