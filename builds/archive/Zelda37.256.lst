                            	  7337: _L_z07_InitObject_InitMonsterFromEdge:
02:0004C8C2 7400            	  7338:     moveq   #0,D2
02:0004C8C4 142C0340        	  7339:     move.b  ($0340,A4),D2
                            	  7340:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7341:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7342:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7343:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7344:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7345:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7346:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7347:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7348:     ; corrupting them and causing a deterministic address-error
                            	  7349:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7350:     ; identified by Codex static review.)
                            	  7351: _L_z07_P47_pre_check:
02:0004C8C8 102C0525        	  7352:     move.b  ($0525,A4),D0
02:0004C8CC 020000F0        	  7353:     andi.b  #$F0,D0
02:0004C8D0 0C000040        	  7354:     cmpi.b  #$40,D0
02:0004C8D4 6506            	  7355:     blo     _L_z07_P47_pre_snap
02:0004C8D6 0C0000E0        	  7356:     cmpi.b  #$E0,D0
02:0004C8DA 6506            	  7357:     blo     _L_z07_P47_pre_ok
                            	  7358: _L_z07_P47_pre_snap:
02:0004C8DC 197C00480525    	  7359:     move.b  #$48,($0525,A4)
                            	  7360: _L_z07_P47_pre_ok:
02:0004C8E2 7005            	  7361:     moveq   #5,D0
02:0004C8E4 610004F4        	  7362:     jsr     SwitchBank
02:0004C8E8 4EB90004167A    	  7363:     jsr     FindNextEdgeSpawnCell
                            	  7364:     ; Post-walk 1: bottom-edge snap.
02:0004C8EE 102C0525        	  7365:     move.b  ($0525,A4),D0
02:0004C8F2 020000F0        	  7366:     andi.b  #$F0,D0
02:0004C8F6 0C0000E0        	  7367:     cmpi.b  #$E0,D0
02:0004C8FA 660C            	  7368:     bne     _L_z07_P47_post1_ok
02:0004C8FC 197C00480525    	  7369:     move.b  #$48,($0525,A4)
02:0004C902 4EB90004167A    	  7370:     jsr     FindNextEdgeSpawnCell
                            	  7371: _L_z07_P47_post1_ok:
                            	  7372:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7373:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004C908 7600            	  7374:     moveq   #0,D3
02:0004C90A 162C0525        	  7375:     move.b  ($0525,A4),D3
02:0004C90E 0243000F        	  7376:     andi.w  #$000F,D3
02:0004C912 C6FC002C        	  7377:     mulu.w  #44,D3
02:0004C916 203C00FF6530    	  7378:     move.l  #$FF6530,D0
02:0004C91C D083            	  7379:     add.l   D3,D0
02:0004C91E 7600            	  7380:     moveq   #0,D3
02:0004C920 162C0525        	  7381:     move.b  ($0525,A4),D3
02:0004C924 E84B            	  7382:     lsr.w   #4,D3
02:0004C926 5943            	  7383:     subi.w  #4,D3
02:0004C928 E34B            	  7384:     lsl.w   #1,D3
02:0004C92A D083            	  7385:     add.l   D3,D0
02:0004C92C 2040            	  7386:     movea.l D0,A0
02:0004C92E 1010            	  7387:     move.b  (A0),D0
02:0004C930 0C000084        	  7388:     cmpi.b  #$84,D0
02:0004C934 6544            	  7389:     blo     _L_z07_P47_post2_ok
                            	  7390:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7391:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7392:     ; writes to the $05xx region.
02:0004C936 7800            	  7393:     moveq   #0,D4
                            	  7394: _L_z07_P47_fb_loop:
02:0004C938 41FAE48C        	  7395:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004C93C 12304000        	  7396:     move.b  (A0,D4.W),D1
02:0004C940 19410525        	  7397:     move.b  D1,($0525,A4)
                            	  7398:     ; Validate fallback cell walkable.
02:0004C944 7600            	  7399:     moveq   #0,D3
02:0004C946 1601            	  7400:     move.b  D1,D3
02:0004C948 0243000F        	  7401:     andi.w  #$000F,D3
02:0004C94C C6FC002C        	  7402:     mulu.w  #44,D3
02:0004C950 203C00FF6530    	  7403:     move.l  #$FF6530,D0
02:0004C956 D083            	  7404:     add.l   D3,D0
02:0004C958 7600            	  7405:     moveq   #0,D3
02:0004C95A 1601            	  7406:     move.b  D1,D3
02:0004C95C E84B            	  7407:     lsr.w   #4,D3
02:0004C95E 5943            	  7408:     subi.w  #4,D3
02:0004C960 E34B            	  7409:     lsl.w   #1,D3
02:0004C962 D083            	  7410:     add.l   D3,D0
02:0004C964 2040            	  7411:     movea.l D0,A0
02:0004C966 0C100084        	  7412:     cmpi.b  #$84,(A0)
02:0004C96A 650E            	  7413:     blo     _L_z07_P47_post2_ok
02:0004C96C 5204            	  7414:     addq.b  #1,D4
02:0004C96E 0C040008        	  7415:     cmpi.b  #8,D4
02:0004C972 65C4            	  7416:     blo     _L_z07_P47_fb_loop
                            	  7417:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7418:     ; rather than looping).
02:0004C974 197C00480525    	  7419:     move.b  #$48,($0525,A4)
                            	  7420: _L_z07_P47_post2_ok:
                            	  7421:     ; Extract and set the monster's location.
                            	  7422:     ;
02:0004C97A 102C0525        	  7423:     move.b  ($0525,A4),D0
                            	  7424:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7425:     ;
02:0004C97E 1B00            	  7426:     move.b  D0,-(A5)  ; PHA
02:0004C980 E308            	  7427:     lsl.b  #1,D0   ; ASL A
02:0004C982 E308            	  7428:     lsl.b  #1,D0   ; ASL A
02:0004C984 E308            	  7429:     lsl.b  #1,D0   ; ASL A
02:0004C986 E308            	  7430:     lsl.b  #1,D0   ; ASL A
02:0004C988 19802070        	  7431:     move.b  D0,($70,A4,D2.W)
                            	  7432:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7433:     ;
02:0004C98C 101D            	  7434:     move.b  (A5)+,D0  ; PLA
02:0004C98E 020000F0        	  7435:     andi.b #$F0,D0
02:0004C992 003C0011        	  7436:     ori     #$11,CCR  ; SEC: set C+X
02:0004C996 123C0003        	  7437:     move.b  #$03,D1
02:0004C99A 0A3C0010        	  7438:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C99E 9101            	  7439:     subx.b  D1,D0   ; SBC #$03
02:0004C9A0 0A3C0010        	  7440:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C9A4 41EC0084        	  7441:     lea     ($0084,A4),A0
02:0004C9A8 11802000        	  7442:     move.b  D0,(A0,D2.W)
                            	  7443:     ; Set the monsters-from-edges long timer to a random value
                            	  7444:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7445:     ;
02:0004C9AC 10342019        	  7446:     move.b  ($19,A4,D2.W),D0
02:0004C9B0 02000003        	  7447:     andi.b #$03,D0
02:0004C9B4 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C9B8 123C0002        	  7449:     move.b  #$02,D1
02:0004C9BC D101            	  7450:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004C9BE 1940004B        	  7451:     move.b  D0,($004B,A4)
                            	  7452:     ; If the distance to Link is too close to Link, then
                            	  7453:     ; go flag the monster uninitialized again, so we can
                            	  7454:     ; try to spawn it again next time.
                            	  7455:     ;
02:0004C9C2 7005            	  7456:     moveq   #5,D0
