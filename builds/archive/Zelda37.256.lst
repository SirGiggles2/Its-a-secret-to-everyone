02:00036486 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036488 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:0003648C 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
