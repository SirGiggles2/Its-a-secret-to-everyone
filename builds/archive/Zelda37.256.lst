                            	  5678: ControlMoldormFlight_JumpTable:
02:0003BAF8 0003BB08        	  5679:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BAFC 0003BB08        	  5680:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BB00 0003BB08        	  5681:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BB04 0003BB3C        	  5682:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
