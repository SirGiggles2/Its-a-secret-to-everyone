02:00031400 4A02            	  4342:     cmpi.b  #$00,D2
02:00031402 6602            	  4343:     bne.s  __far_z_01_0030
02:00031404 6014            	  4344:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  4345: __far_z_01_0030:
                            	  4346:     ; For other objects, the caller controls mirroring and flipping.
                            	  4347:     ;
                            	  4348:     ; If mirrored [0C], then draw it mirrored.
                            	  4349:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  4350:     ;
02:00031406 7600            	  4351:     moveq   #0,D3
02:00031408 162C000C        	  4352:     move.b  ($000C,A4),D3
02:0003140C 6602            	  4353:     bne.s  __far_z_01_0031
