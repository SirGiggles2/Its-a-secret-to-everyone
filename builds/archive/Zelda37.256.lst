02:00031AB2 60000102        	  5259:     jmp  L74D8_Exit
                            	  5260: __far_z_01_0048:
                            	  5261:     ; If the weapon is a boomerang ...
                            	  5262:     ;
02:00031AB6 0C03000F        	  5263:     cmpi.b  #$0F,D3
