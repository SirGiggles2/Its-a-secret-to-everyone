02:000301F0 660000B2        	  1846:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1847:     ; State 0. Sensing.
                            	  1848:     ;
                            	  1849:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1850:     ; then go see if the horizontal distance is shorter.
                            	  1851:     ;
02:000301F4 102C0084        	  1852:     move.b  ($0084,A4),D0
02:000301F8 003C0011        	  1853:     ori     #$11,CCR  ; SEC: set C+X
02:000301FC 41EC0084        	  1854:     lea     ($0084,A4),A0
02:00030200 12302000        	  1855:     move.b  (A0,D2.W),D1
02:00030204 0A3C0010        	  1856:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030208 9101            	  1857:     subx.b  D1,D0   ; SBC ObjY,X
02:0003020A 0A3C0010        	  1858:     eori    #$10,CCR  ; restore X = 6502 C
02:0003020E 61000680        	  1859:     jsr     Abs
02:00030212 0C00000E        	  1860:     cmpi.b  #$0E,D0
02:00030216 644C            	  1861:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1862:     ; Determine the horizontal direction toward Link;
                            	  1863:     ; and if Link and the trap are at the same X, then we can't move
                            	  1864:     ; along this axis. Go see about moving vertically.
                            	  1865:     ;
02:00030218 7601            	  1866:     moveq   #1,D3
02:0003021A 102C0070        	  1867:     move.b  ($0070,A4),D0
02:0003021E 12342070        	  1868:     move.b  ($70,A4,D2.W),D1
02:00030222 B001            	  1869:     cmp.b   D1,D0
02:00030224 673E            	  1870:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030226 6402            	  1871:     bcc  _anon_z01_26
02:00030228 7602            	  1872:     moveq   #2,D3
                            	  1873: _anon_z01_26:
                            	  1874:     ; Remember the original X coordinate.
                            	  1875:     ;
02:0003022A 10342070        	  1876:     move.b  ($70,A4,D2.W),D0
                            	  1877:     even
                            	  1878: _L_z01_UpdateTrap_Full_GoToState1:
02:0003022E 41EC0380        	  1879:     lea     ($0380,A4),A0
02:00030232 11802000        	  1880:     move.b  D0,(A0,D2.W)
                            	  1881:     ; Set facing direction to the horizontal one that we determined.
                            	  1882:     ;
02:00030236 1003            	  1883:     move.b  D3,D0
02:00030238 41EC0098        	  1884:     lea     ($0098,A4),A0
02:0003023C 11802000        	  1885:     move.b  D0,(A0,D2.W)
                            	  1886:     ; If the direction we determined is not allowed for this trap, then
                            	  1887:     ; go draw and check collisions.
