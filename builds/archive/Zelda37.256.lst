02:00043C3C 12302000        	  7156:     move.b  (A0,D2.W),D1
02:00043C40 B001            	  7157:     cmp.b   D1,D0
02:00043C42 6704            	  7158:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00043C44 5302            	  7159:     subq.b  #1,D2
02:00043C46 66EE            	  7160:     bne  _anon_z05_149
                            	  7161:     even
