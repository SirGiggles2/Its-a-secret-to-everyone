                            	  5046: HarmLink:
02:0003192C 61000564        	  5047:     jsr     BeginShove
                            	  5048:     ; Flag collision with [0C], even though [06] was already set.
                            	  5049:     ;
02:00031930 522C000C        	  5050:     addq.b  #1,($000C,A4)
                            	  5051:     ; Unpack the damage points for the monster's type.
                            	  5052:     ; The low nibble is the high byte.
                            	  5053:     ; (Damage points byte AND $F0) is the low byte.
                            	  5054:     ;
02:00031934 7600            	  5055:     moveq   #0,D3
02:00031936 41EC034F        	  5056:     lea     ($034F,A4),A0
02:0003193A 16302000        	  5057:     move.b  (A0,D2.W),D3
02:0003193E 41F9000317A0    	  5058:     lea     (ObjTypeToDamagePoints).l,A0
02:00031944 10303000        	  5059:     move.b  (A0,D3.W),D0
02:00031948 1B00            	  5060:     move.b  D0,-(A5)  ; PHA
02:0003194A 0200000F        	  5061:     andi.b #$0F,D0
02:0003194E 1940000D        	  5062:     move.b  D0,($000D,A4)
02:00031952 101D            	  5063:     move.b  (A5)+,D0  ; PLA
02:00031954 020000F0        	  5064:     andi.b #$F0,D0
02:00031958 1940000E        	  5065:     move.b  D0,($000E,A4)
                            	  5066: ; Params:
                            	  5067: ; X: object index of the attacker
                            	  5068: ; [0D]: damage points high byte
                            	  5069: ; [0E]: damage points low byte
                            	  5070: ;
                            	  5071: ;
                            	  5072: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  5073: ;
                            	  5074:     even
                            	  5075: Link_BeHarmed:
02:0003195C 7600            	  5076:     moveq   #0,D3
02:0003195E 41EC034F        	  5077:     lea     ($034F,A4),A0
02:00031962 16302000        	  5078:     move.b  (A0,D2.W),D3
02:00031966 0C03002E        	  5079:     cmpi.b  #$2E,D3
02:0003196A 6706            	  5080:     beq  _anon_z01_85
02:0003196C 7008            	  5081:     moveq   #8,D0
02:0003196E 6100EB92        	  5082:     jsr     PlaySample
                            	  5083: _anon_z01_85:
                            	  5084:     ; For every level of ring (1 or 2), divide the 16-bit damage amount in [0E:0D] by 2.
                            	  5085:     ;
02:00031972 7600            	  5086:     moveq   #0,D3
02:00031974 162C0662        	  5087:     move.b  ($0662,A4),D3
02:00031978 6718            	  5088:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  5089: _anon_z01_86:
02:0003197A 122C000D        	  5090:     move.b  ($000D,A4),D1
02:0003197E E209            	  5091:     lsr.b  #1,D1   ; LSR $0D
02:00031980 1941000D        	  5092:     move.b  D1,($000D,A4)
02:00031984 122C000E        	  5093:     move.b  ($000E,A4),D1
02:00031988 E211            	  5094:     roxr.b  #1,D1   ; ROR $0E
02:0003198A 1941000E        	  5095:     move.b  D1,($000E,A4)
02:0003198E 5303            	  5096:     subq.b  #1,D3
02:00031990 66E8            	  5097:     bne  _anon_z01_86
                            	  5098:     even
                            	  5099: _L_z01_Link_BeHarmed_ResetHelp:
                            	  5100:     ; Reset values used in special item drops.
                            	  5101:     ;
02:00031992 7000            	  5102:     moveq   #0,D0
02:00031994 19400627        	  5103:     move.b  D0,($0627,A4)
02:00031998 19400050        	  5104:     move.b  D0,($0050,A4)
02:0003199C 19400051        	  5105:     move.b  D0,($0051,A4)
                            	  5106:     ; If heart partial >= low damage points byte, then simply
                            	  5107:     ; subtract the damage byte from heart partial.
                            	  5108:     ; Else go borrow from full hearts.
                            	  5109:     ;
02:000319A0 102C0670        	  5110:     move.b  ($0670,A4),D0
02:000319A4 122C000E        	  5111:     move.b  ($000E,A4),D1
02:000319A8 B001            	  5112:     cmp.b   D1,D0
02:000319AA 6546            	  5113:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:000319AC 003C0011        	  5114:     ori     #$11,CCR  ; SEC: set C+X
02:000319B0 122C000E        	  5115:     move.b  ($000E,A4),D1
02:000319B4 0A3C0010        	  5116:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000319B8 9101            	  5117:     subx.b  D1,D0   ; SBC $0E
02:000319BA 0A3C0010        	  5118:     eori    #$10,CCR  ; restore X = 6502 C
02:000319BE 19400670        	  5119:     move.b  D0,($0670,A4)
                            	  5120:     ; If full hearts >= high damage points byte, then simply
                            	  5121:     ; subtract the damage byte from full hearts.
                            	  5122:     ; Else go handle Link dying.
                            	  5123:     ;
02:000319C2 102C066F        	  5124:     move.b  ($066F,A4),D0
02:000319C6 0200000F        	  5125:     andi.b #$0F,D0
02:000319CA 122C000D        	  5126:     move.b  ($000D,A4),D1
02:000319CE B001            	  5127:     cmp.b   D1,D0
02:000319D0 6554            	  5128:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:000319D2 102C066F        	  5129:     move.b  ($066F,A4),D0
02:000319D6 003C0011        	  5130:     ori     #$11,CCR  ; SEC: set C+X
02:000319DA 122C000D        	  5131:     move.b  ($000D,A4),D1
02:000319DE 0A3C0010        	  5132:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000319E2 9101            	  5133:     subx.b  D1,D0   ; SBC $0D
02:000319E4 0A3C0010        	  5134:     eori    #$10,CCR  ; restore X = 6502 C
02:000319E8 1940066F        	  5135:     move.b  D0,($066F,A4)
02:000319EC 0A3C0001        	  5136:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000319F0 4E75            	  5137:     rts
                            	  5138: 
                            	  5139:     even
                            	  5140: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  5141:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  5142:     ;   full heart=4 partial heart=$70
                            	  5143:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  5144:     ; But the method here yields $3EF, because partial heart is
                            	  5145:     ; considered full when = $FF instead of $100.
                            	  5146:     ;
02:000319F2 102C000E        	  5147:     move.b  ($000E,A4),D0
02:000319F6 003C0011        	  5148:     ori     #$11,CCR  ; SEC: set C+X
02:000319FA 122C0670        	  5149:     move.b  ($0670,A4),D1
02:000319FE 0A3C0010        	  5150:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031A02 9101            	  5151:     subx.b  D1,D0   ; SBC HeartPartial
02:00031A04 0A3C0010        	  5152:     eori    #$10,CCR  ; restore X = 6502 C
02:00031A08 1940000E        	  5153:     move.b  D0,($000E,A4)
02:00031A0C 102C066F        	  5154:     move.b  ($066F,A4),D0
02:00031A10 0200000F        	  5155:     andi.b #$0F,D0
02:00031A14 6710            	  5156:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031A16 532C066F        	  5157:     subq.b  #1,($066F,A4)
02:00031A1A 103C00FF        	  5158:     move.b  #$FF,D0
02:00031A1E 19400670        	  5159:     move.b  D0,($0670,A4)
02:00031A22 6600FF6E        	  5160:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  5161:     even
                            	  5162: _L_z01_Link_BeHarmed_HandleDied:
                            	  5163:     ; Link died.
                            	  5164:     ;
                            	  5165:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  5166:     ; Make Link face down.
                            	  5167:     ; Go to mode $11.
                            	  5168:     ;
02:00031A26 102C066F        	  5169:     move.b  ($066F,A4),D0
02:00031A2A 020000F0        	  5170:     andi.b #$F0,D0
02:00031A2E 1940066F        	  5171:     move.b  D0,($066F,A4)
02:00031A32 4EB90004AA30    	  5172:     jsr     EndGameMode
02:00031A38 19400670        	  5173:     move.b  D0,($0670,A4)
02:00031A3C 194000AC        	  5174:     move.b  D0,($00AC,A4)
02:00031A40 7011            	  5175:     moveq   #17,D0
02:00031A42 19400012        	  5176:     move.b  D0,($0012,A4)
02:00031A46 7004            	  5177:     moveq   #4,D0
02:00031A48 19400098        	  5178:     move.b  D0,($0098,A4)
                            	  5179: _anon_z01_87:
02:00031A4C 4E75            	  5180:     rts
                            	  5181: 
                            	  5182: ; Params:
                            	  5183: ; X: monster slot
                            	  5184: ; Y: weapon slot
                            	  5185: ; [02]: monster mid X
                            	  5186: ; [03]: monster mid Y
                            	  5187: ;
                            	  5188: ; Returns:
                            	  5189: ; [00]: weapon slot
                            	  5190: ;
                            	  5191: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  5192: ;
                            	  5193:     even
                            	  5194: CheckMonsterBoomerangOrFoodCollision:
02:00031A4E 41EC00AC        	  5195:     lea     ($00AC,A4),A0
02:00031A52 10303000        	  5196:     move.b  (A0,D3.W),D0
02:00031A56 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00031A58 65F2            	  5198:     bcs  _anon_z01_87
02:00031A5A 1883            	  5199:     move.b  D3,($0000,A4)
                            	  5200:     ; Set boomerang damage type (2) in [09].
                            	  5201:     ;
02:00031A5C 7002            	  5202:     moveq   #2,D0
02:00031A5E 19400009        	  5203:     move.b  D0,($0009,A4)
                            	  5204:     ; Set collision threshold $A in both axes.
                            	  5205:     ;
02:00031A62 700A            	  5206:     moveq   #10,D0
02:00031A64 1940000D        	  5207:     move.b  D0,($000D,A4)
02:00031A68 1940000E        	  5208:     move.b  D0,($000E,A4)
                            	  5209:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  5210:     ;
02:00031A6C 10343070        	  5211:     move.b  ($70,A4,D3.W),D0
02:00031A70 023C00EE        	  5212:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031A74 123C0004        	  5213:     move.b  #$04,D1
02:00031A78 D101            	  5214:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031A7A 19400004        	  5215:     move.b  D0,($0004,A4)
                            	  5216:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  5217:     ;
02:00031A7E 41EC0084        	  5218:     lea     ($0084,A4),A0
02:00031A82 10303000        	  5219:     move.b  (A0,D3.W),D0
02:00031A86 023C00EE        	  5220:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031A8A 123C0008        	  5221:     move.b  #$08,D1
02:00031A8E D101            	  5222:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  5223: ; Params:
                            	  5224: ; A: weapon object mid Y
                            	  5225: ; X: monster object slot
                            	  5226: ; Y: weapon object slot
                            	  5227: ; [00]: weapon object slot
                            	  5228: ; [02]: monster object mid X
                            	  5229: ; [03]: monster object mid Y
                            	  5230: ; [04]: weapon object mid X
                            	  5231: ; [07]: damage points
                            	  5232: ; [09]: damage type
                            	  5233: ; [0D]: horizontal threshold
                            	  5234: ; [0E]: vertical threshold
                            	  5235: ;
                            	  5236: ; Returns:
                            	  5237: ; [06]: 1 if objects collide
                            	  5238: ;
                            	  5239:     even
                            	  5240: CheckMonsterWeaponCollision:
02:00031A90 19400005        	  5241:     move.b  D0,($0005,A4)
                            	  5242:     ; Reset [06] for no collision.
                            	  5243:     ;
02:00031A94 7000            	  5244:     moveq   #0,D0
02:00031A96 19400006        	  5245:     move.b  D0,($0006,A4)
                            	  5246:     ; If the weapon's not active (state = 0), then return.
                            	  5247:     ;
02:00031A9A 7600            	  5248:     moveq   #0,D3
02:00031A9C 1614            	  5249:     move.b  ($0000,A4),D3
02:00031A9E 41EC00AC        	  5250:     lea     ($00AC,A4),A0
02:00031AA2 10303000        	  5251:     move.b  (A0,D3.W),D0
02:00031AA6 6604            	  5252:     bne.s  __far_z_01_0047
02:00031AA8 6000010C        	  5253:     jmp  L74D8_Exit
                            	  5254: __far_z_01_0047:
                            	  5255:     ; If the objects do not collide, then return.
