                            	  6387: _L_z04_Digdogger_Draw_LoopPart:
                            	  6388:     ; Store in [00] the X coordinate offset for the current corner.
                            	  6389:     ;
02:0003BFF2 10342070        	  6390:     move.b  ($70,A4,D2.W),D0
02:0003BFF6 023C00EE        	  6391:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BFFA 41F90003BFD2    	  6392:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003C000 12303000        	  6393:     move.b  (A0,D3.W),D1
