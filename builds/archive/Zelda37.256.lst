                            	  3821: UpdateArmos:
02:0003AD0C 6100E830        	  3822:     jsr     UpdateGoriya
                            	  3823:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3824:     ;
02:0003AD10 41EC00C0        	  3825:     lea     ($00C0,A4),A0
02:0003AD14 10302000        	  3826:     move.b  (A0,D2.W),D0
