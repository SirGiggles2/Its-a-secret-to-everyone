02:0003EF8E 41EC00AC        	 12854:     lea     ($00AC,A4),A0
02:0003EF92 10303000        	 12855:     move.b  (A0,D3.W),D0
02:0003EF96 0C000010        	 12856:     cmpi.b  #$10,D0
02:0003EF9A 66DE            	 12857:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12858:     ; Check for collision with an arrow; and return if no collision.
                            	 12859:     ;
02:0003EF9C 4EB900031D5A    	 12860:     jsr     CheckMonsterArrowOrRodCollision
02:0003EFA2 102C0006        	 12861:     move.b  ($0006,A4),D0
02:0003EFA6 67D2            	 12862:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12863:     ; Set the Ganon phase to "dying".
                            	 12864:     ;
02:0003EFA8 41EC042C        	 12865:     lea     ($042C,A4),A0
02:0003EFAC 52302000        	 12866:     addq.b  #1,(A0,D2.W)
                            	 12867:     ; Now his body does flash.
                            	 12868:     ;
02:0003EFB0 7028            	 12869:     moveq   #40,D0
02:0003EFB2 41EC04F0        	 12870:     lea     ($04F0,A4),A0
02:0003EFB6 11802000        	 12871:     move.b  D0,(A0,D2.W)
                            	 12872:     ; Set initial cloud distance 8.
                            	 12873:     ;
02:0003EFBA 7008            	 12874:     moveq   #8,D0
02:0003EFBC 41EC0478        	 12875:     lea     ($0478,A4),A0
02:0003EFC0 11802000        	 12876:     move.b  D0,(A0,D2.W)
02:0003EFC4 0A3C0001        	 12877:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003EFC8 4E75            	 12878:     rts
