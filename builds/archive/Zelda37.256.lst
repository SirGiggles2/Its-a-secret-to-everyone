                            	  5105:     even
                            	  5106: _L_z07_SpreadShot_Draw:
                            	  5107:     ; Draw the corner.
                            	  5108:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5109:     ;
