02:0003092C 19400004        	  2941:     move.b  D0,($0004,A4)
02:00030930 4E75            	  2942:     rts
                            	  2943: 
                            	  2944: ; Params:
                            	  2945: ; Y: middle speed index (4)
                            	  2946: ; [03]: horizontal distance
                            	  2947: ; [04]: vertical distance
                            	  2948: ; [0A]: vertical direction
                            	  2949: ; [0B]: horizontal direction
                            	  2950: ;
                            	  2951: ; Returns:
                            	  2952: ; Y: speed index (0 to 8) for the angle
                            	  2953: ;
                            	  2954: ;
                            	  2955: ; TODO: call it speed index or angle?
                            	  2956: ; Store the middle speed index in [00]. It will be changed to the
                            	  2957: ; right speed index to use incrementally.
                            	  2958: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  2959: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  2960: ;
                            	  2961:     even
                            	  2962: _CalcDiagonalSpeedIndex:
02:00030932 1883            	  2963:     move.b  D3,($0000,A4)
                            	  2964:     ; Assuming horizontal distance >= vertical distance, the
                            	  2965:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  2966:     ;
02:00030934 103C00FF        	  2967:     move.b  #$FF,D0
02:00030938 19400001        	  2968:     move.b  D0,($0001,A4)
                            	  2969:     ; TODO:
                            	  2970:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  2971:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  2972:     ;
                            	  2973:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  2974:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  2975:     ; of the farther distance faster.
                            	  2976:     ;
02:0003093C 102C0003        	  2977:     move.b  ($0003,A4),D0
02:00030940 122C0004        	  2978:     move.b  ($0004,A4),D1
02:00030944 B001            	  2979:     cmp.b   D1,D0
02:00030946 6416            	  2980:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030948 1B00            	  2981:     move.b  D0,-(A5)  ; PHA
02:0003094A 102C0004        	  2982:     move.b  ($0004,A4),D0
02:0003094E 19400003        	  2983:     move.b  D0,($0003,A4)
02:00030952 101D            	  2984:     move.b  (A5)+,D0  ; PLA
02:00030954 19400004        	  2985:     move.b  D0,($0004,A4)
02:00030958 7001            	  2986:     moveq   #1,D0
02:0003095A 19400001        	  2987:     move.b  D0,($0001,A4)
