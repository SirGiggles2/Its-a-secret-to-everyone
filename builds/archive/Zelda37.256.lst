                            	  5473: CheckState20:
                            	  5474:     ; If major state <> $20, go check other states.
                            	  5475:     ;
02:0004BAA8 0C000020        	  5476:     cmpi.b  #$20,D0
02:0004BAAC 6704            	  5477:     beq.s  __far_z_07_0083
02:0004BAAE 600000B6        	  5478:     jmp  CheckState30
                            	  5479: __far_z_07_0083:
                            	  5480:     ; State $2x. Spark.
                            	  5481:     ;
                            	  5482:     ; Change the state to $28, and decrement animation counter.
                            	  5483:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5484:     ; (with Link, if this is a monster's boomerang).
                            	  5485:     ;
                            	  5486:     ; TODO: Why state $28?
                            	  5487:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5488:     ; start over again when spinning.
                            	  5489:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5490:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5491:     ; any drawing code depends on the minor state.
                            	  5492:     ;
02:0004BAB2 7028            	  5493:     moveq   #40,D0
02:0004BAB4 41EC00AC        	  5494:     lea     ($00AC,A4),A0
02:0004BAB8 11802000        	  5495:     move.b  D0,(A0,D2.W)
02:0004BABC 41EC03D0        	  5496:     lea     ($03D0,A4),A0
02:0004BAC0 53302000        	  5497:     subq.b  #1,(A0,D2.W)
02:0004BAC4 6702            	  5498:     beq.s  __far_z_07_0084
02:0004BAC6 6060            	  5499:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5500: __far_z_07_0084:
                            	  5501:     ; Animation counter = 0.
                            	  5502:     ;
                            	  5503:     ; Set state to $40. It will become $50 below in
                            	  5504:     ; HandleArrowOrBoomerangBlocked.
                            	  5505:     ;
02:0004BAC8 7040            	  5506:     moveq   #64,D0
02:0004BACA 41EC00AC        	  5507:     lea     ($00AC,A4),A0
02:0004BACE 11802000        	  5508:     move.b  D0,(A0,D2.W)
                            	  5509:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5510:     ; Else go handle the boomerang being blocked.
                            	  5511:     ;
02:0004BAD2 0C02000D        	  5512:     cmpi.b  #$0D,D2
02:0004BAD6 640E            	  5513:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004BAD8 41EC034F        	  5514:     lea     ($034F,A4),A0
02:0004BADC 10302000        	  5515:     move.b  (A0,D2.W),D0
02:0004BAE0 0C00005B        	  5516:     cmpi.b  #$5B,D0
02:0004BAE4 6708            	  5517:     beq  _L_z07_CheckState20_Deactivate
                            	  5518:     even
                            	  5519: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004BAE6 0C020012        	  5520:     cmpi.b  #$12,D2
02:0004BAEA 6702            	  5521:     beq.s  __far_z_07_0085
02:0004BAEC 6016            	  5522:     jmp  HandleArrowOrBoomerangBlocked
                            	  5523: __far_z_07_0085:
                            	  5524:     even
                            	  5525: _L_z07_CheckState20_Deactivate:
02:0004BAEE 61000534        	  5526:     jsr     ResetObjState
                            	  5527:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5528:     ; including clearing object type.
                            	  5529:     ;
02:0004BAF2 0C02000D        	  5530:     cmpi.b  #$0D,D2
02:0004BAF6 6406            	  5531:     bcc  _anon_z07_29
02:0004BAF8 4EB90003999C    	  5532:     jsr     DestroyCountedMonsterShot
                            	  5533: _anon_z07_29:
02:0004BAFE 0A3C0001        	  5534:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004BB02 4E75            	  5535:     rts
                            	  5536: 
                            	  5537:     even
                            	  5538: HandleArrowOrBoomerangBlocked:
                            	  5539:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5540:     ;
02:0004BB04 7003            	  5541:     moveq   #3,D0
02:0004BB06 41EC03D0        	  5542:     lea     ($03D0,A4),A0
02:0004BB0A 11802000        	  5543:     move.b  D0,(A0,D2.W)
                            	  5544:     ; Add $10 to the state to make it $2x.
                            	  5545:     ;
02:0004BB0E 41EC00AC        	  5546:     lea     ($00AC,A4),A0
02:0004BB12 10302000        	  5547:     move.b  (A0,D2.W),D0
02:0004BB16 023C00EE        	  5548:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BB1A 123C0010        	  5549:     move.b  #$10,D1
02:0004BB1E D101            	  5550:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004BB20 41EC00AC        	  5551:     lea     ($00AC,A4),A0
02:0004BB24 11802000        	  5552:     move.b  D0,(A0,D2.W)
                            	  5553:     even
                            	  5554: DrawArrowOrBoomerangAndCheckCollisions:
                            	  5555:     ; If the weapon is a boomerang (not a monster arrow nor player arrow),
                            	  5556:     ; then go draw it and check for a collision.
                            	  5557:     ;
02:0004BB28 0C02000D        	  5558:     cmpi.b  #$0D,D2
02:0004BB2C 640E            	  5559:     bcc  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_DrawPlayerWeapon
02:0004BB2E 41EC034F        	  5560:     lea     ($034F,A4),A0
02:0004BB32 10302000        	  5561:     move.b  (A0,D2.W),D0
02:0004BB36 0C00005B        	  5562:     cmpi.b  #$5B,D0
02:0004BB3A 670A            	  5563:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
                            	  5564:     even
                            	  5565: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_DrawPlayerWeapon:
02:0004BB3C 0C020012        	  5566:     cmpi.b  #$12,D2
02:0004BB40 6704            	  5567:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
02:0004BB42 600001AA        	  5568:     jmp     DrawBoomerangAndCheckCollision
                            	  5569: 
