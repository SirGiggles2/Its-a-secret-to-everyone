02:00035FDC 704C            	  4772:     moveq   #76,D0
02:00035FDE 19400344        	  4773:     move.b  D0,($0344,A4)
02:00035FE2 7621            	  4774:     moveq   #33,D3
02:00035FE4 6100B596        	  4775:     jsr     Anim_WriteSpecificItemSprites
