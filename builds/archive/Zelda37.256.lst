                            	  3902: UpdatePondFairy:
02:0003AD9A 610045AC        	  3903:     jsr     DrawFairy
                            	  3904:     ; If not in state 0, then go handle states 1 to 3.
                            	  3905:     ;
02:0003AD9E 102C00AD        	  3906:     move.b  ($00AD,A4),D0
02:0003ADA2 6702            	  3907:     beq.s  __far_z_04_0035
02:0003ADA4 602A            	  3908:     jmp  PondFairy_HandleOtherStates
                            	  3909: __far_z_04_0035:
                            	  3910:     ; State 0.
                            	  3911:     ;
                            	  3912:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3913:     ;
02:0003ADA6 102C0084        	  3914:     move.b  ($0084,A4),D0
02:0003ADAA 0C0000AD        	  3915:     cmpi.b  #$AD,D0
02:0003ADAE 661E            	  3916:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3917:     ; If Link's X < $70 or >= $81, then return.
                            	  3918:     ;
02:0003ADB0 102C0070        	  3919:     move.b  ($0070,A4),D0
02:0003ADB4 0C000070        	  3920:     cmpi.b  #$70,D0
02:0003ADB8 6514            	  3921:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003ADBA 0C000081        	  3922:     cmpi.b  #$81,D0
02:0003ADBE 640E            	  3923:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3924:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3925:     ; halt Link, and start filling hearts.
                            	  3926:     ;
02:0003ADC0 522C00AD        	  3927:     addq.b  #1,($00AD,A4)
02:0003ADC4 7040            	  3928:     moveq   #64,D0
02:0003ADC6 194000AC        	  3929:     move.b  D0,($00AC,A4)
02:0003ADCA 19400063        	  3930:     move.b  D0,($0063,A4)
                            	  3931:     even
                            	  3932: _L_z04_UpdatePondFairy_Exit:
02:0003ADCE 4E75            	  3933:     rts
                            	  3934: 
                            	  3935:     even
                            	  3936: PondFairy_HandleOtherStates:
02:0003ADD0 0C000001        	  3937:     cmpi.b  #$01,D0
02:0003ADD4 6610            	  3938:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3939:     ; State 1. Flying and filling hearts.
                            	  3940:     ;
                            	  3941:     ; If still filling hearts, then go draw Link and hearts.
                            	  3942:     ;
02:0003ADD6 102C0063        	  3943:     move.b  ($0063,A4),D0
02:0003ADDA 6620            	  3944:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3945:     ; If not filling hearts anymore, then go to state 2,
                            	  3946:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3947:     ; a little while after we finish filling hearts.
                            	  3948:     ;
02:0003ADDC 522C00AD        	  3949:     addq.b  #1,($00AD,A4)
02:0003ADE0 7050            	  3950:     moveq   #80,D0
02:0003ADE2 19400029        	  3951:     move.b  D0,($0029,A4)
                            	  3952:     even
                            	  3953: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3954:     ; If state <> 2 (so, it's 3), then return.
                            	  3955:     ;
                            	  3956:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3957:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3958:     ; was set to, and we'll return.
                            	  3959:     ;
02:0003ADE6 0C000002        	  3960:     cmpi.b  #$02,D0
02:0003ADEA 6634            	  3961:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3962:     ; State = 2.
                            	  3963:     ;
                            	  3964:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3965:     ;
02:0003ADEC 102C0029        	  3966:     move.b  ($0029,A4),D0
02:0003ADF0 660A            	  3967:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3968:     ; Else go to state 3, and unhalt Link.
                            	  3969:     ;
02:0003ADF2 522C00AD        	  3970:     addq.b  #1,($00AD,A4)
02:0003ADF6 7000            	  3971:     moveq   #0,D0
02:0003ADF8 194000AC        	  3972:     move.b  D0,($00AC,A4)
                            	  3973:     even
                            	  3974: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  3975:     ; TODO: but why, since Link is halted?
                            	  3976:     ;
                            	  3977:     ; Reset the input direction, so that Link doesn't animate
                            	  3978:     ; when drawing him.
02:0003ADFC 7600            	  3979:     moveq   #0,D3
02:0003ADFE 194303F8        	  3980:     move.b  D3,($03F8,A4)
                            	  3981:     ; Save and reset Link's state.
                            	  3982:     ;
                            	  3983:     ; TODO: but why, since Link is halted?
                            	  3984:     ;
02:0003AE02 102C00AC        	  3985:     move.b  ($00AC,A4),D0
02:0003AE06 1B00            	  3986:     move.b  D0,-(A5)  ; PHA
02:0003AE08 194300AC        	  3987:     move.b  D3,($00AC,A4)
02:0003AE0C 4EB90004B39A    	  3988:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  3989:     ; Restore Link's state.
                            	  3990:     ;
02:0003AE12 101D            	  3991:     move.b  (A5)+,D0  ; PLA
02:0003AE14 194000AC        	  3992:     move.b  D0,($00AC,A4)
02:0003AE18 6110            	  3993:     jsr     PondFairy_MoveHearts
                            	  3994:     ; Restore the object slot.
                            	  3995:     ;
02:0003AE1A 7400            	  3996:     moveq   #0,D2
02:0003AE1C 142C0340        	  3997:     move.b  ($0340,A4),D2
                            	  3998:     even
