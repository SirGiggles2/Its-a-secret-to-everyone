                            	 12308: __far_z_04_0120:
                            	 12309:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12310:     ; Collisions were checked already.
                            	 12311:     ;
                            	 12312:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12313:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12314:     ;
02:0003EBA0 0C000001        	 12315:     cmpi.b  #$01,D0
02:0003EBA4 6702            	 12316:     beq.s  __far_z_04_0121
