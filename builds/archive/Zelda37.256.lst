                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:0003FAA0 103C00FD        	   447:     move.b  #$FD,D0
02:0003FAA4 613A            	   448:     jsr     MovePositionMarkers
02:0003FAA6 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:0003FAAA 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FAAE 123C0003        	   451:     move.b  #$03,D1
02:0003FAB2 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003FAB4 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
02:0003FAB8 0C0000F0        	   456:     cmpi.b  #$F0,D0
02:0003FABC 6406            	   457:     bcc.s  __far_z_05_0001
02:0003FABE 4EF90002D994    	   458:     jmp  Exit
                            	   459: __far_z_05_0001:
                            	   460:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   461:     ;
02:0003FAC4 1940005C        	   462:     move.b  D0,($005C,A4)
                            	   463:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   464:     ;
                            	   465:     ; UNKNOWN: But why not do this in OW, too?
                            	   466:     ;
02:0003FAC8 102C0010        	   467:     move.b  ($0010,A4),D0
02:0003FACC 6706            	   468:     beq  _anon_z05_4
02:0003FACE 4EB90003105A    	   469:     jsr     WriteBlankPrioritySprites
                            	   470: _anon_z05_4:
                            	   471:     ; We reached the end. So, reset hardware vertical scroll
                            	   472:     ; and submenu state.
                            	   473:     ;
02:0003FAD4 7000            	   474:     moveq   #0,D0
02:0003FAD6 194000FC        	   475:     move.b  D0,($00FC,A4)
02:0003FADA 194000E1        	   476:     move.b  D0,($00E1,A4)
                            	   477:     ; Move the position markers 2 pixels down, because we
                            	   478:     ; overshot and reached vertical scroll $F2.
                            	   479:     ;
02:0003FADE 7002            	   480:     moveq   #2,D0
                            	   481: ; Params:
                            	   482: ; A: vertical velocity of menu scrolling
                            	   483: ;
                            	   484: ;
                            	   485: ; [00] holds the vertical velocity of menu scrolling.
                            	   486:     even
                            	   487: MovePositionMarkers:
02:0003FAE0 1880            	   488:     move.b  D0,($0000,A4)
                            	   489:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   490:     ;
02:0003FAE2 102C0254        	   491:     move.b  ($0254,A4),D0
02:0003FAE6 0C0000F8        	   492:     cmpi.b  #$F8,D0
02:0003FAEA 670C            	   493:     beq  _anon_z05_5
02:0003FAEC 023C00EE        	   494:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FAF0 1214            	   495:     move.b  ($0000,A4),D1
02:0003FAF2 D101            	   496:     addx.b  D1,D0   ; ADC $00
02:0003FAF4 19400254        	   497:     move.b  D0,($0254,A4)
                            	   498: _anon_z05_5:
                            	   499:     ; If in UW and have the compass, then move the triforce position marker.
                            	   500:     ;
02:0003FAF8 102C0010        	   501:     move.b  ($0010,A4),D0
02:0003FAFC 6606            	   502:     bne.s  __far_z_05_0002
02:0003FAFE 4EF90002D994    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:0003FB04 61004EC2        	   505:     jsr     HasCompass
02:0003FB08 6606            	   506:     bne.s  __far_z_05_0003
02:0003FB0A 4EF90002D994    	   507:     jmp  Exit
                            	   508: __far_z_05_0003:
02:0003FB10 102C0258        	   509:     move.b  ($0258,A4),D0
02:0003FB14 023C00EE        	   510:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FB18 1214            	   511:     move.b  ($0000,A4),D1
02:0003FB1A D101            	   512:     addx.b  D1,D0   ; ADC $00
02:0003FB1C 19400258        	   513:     move.b  D0,($0258,A4)
                            	   514:     even
