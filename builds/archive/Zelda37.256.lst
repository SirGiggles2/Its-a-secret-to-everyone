02:0004B886 41EC0098        	  5164:     lea     ($0098,A4),A0
02:0004B88A 10302000        	  5165:     move.b  (A0,D2.W),D0
02:0004B88E 0C0000E8        	  5166:     cmpi.b  #$E8,D0
