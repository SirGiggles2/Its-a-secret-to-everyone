02:0003CEC0 67000084        	  7851:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7852:     ; Decrement grid offset / distance remaining.
                            	  7853:     ;
02:0003CEC4 41EC0394        	  7854:     lea     ($0394,A4),A0
02:0003CEC8 53302000        	  7855:     subq.b  #1,(A0,D2.W)
