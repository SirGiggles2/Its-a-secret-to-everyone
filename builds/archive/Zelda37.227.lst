                            	  8480:     ; decrement the distance remaining, and move.
                            	  8481:     ;
02:0003D3B6 41EC0394        	  8482:     lea     ($0394,A4),A0
02:0003D3BA 10302000        	  8483:     move.b  (A0,D2.W),D0
02:0003D3BE 670A            	  8484:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D3C0 41EC0394        	  8485:     lea     ($0394,A4),A0
