02:0004D9B0 605C            	  7988:     jmp  L1FF28_Exit
                            	  7989: __far_z_07_0128:
                            	  7990:     ; 7 of every 8 frames, return.
                            	  7991:     ;
02:0004D9B2 102C0015        	  7992:     move.b  ($0015,A4),D0
02:0004D9B6 02000007        	  7993:     andi.b #$07,D0
02:0004D9BA 0C000004        	  7994:     cmpi.b  #$04,D0
02:0004D9BE 6702            	  7995:     beq.s  __far_z_07_0129
02:0004D9C0 604C            	  7996:     jmp  L1FF28_Exit
                            	  7997: __far_z_07_0129:
                            	  7998:     ; So, every 8 frames:
                            	  7999:     ; 1. Increment the secret color cycle count.
                            	  8000:     ; 2. Change the water palette.
                            	  8001:     ;
                            	  8002:     ; But when the count = $B, go reveal the stairs.
                            	  8003:     ;
02:0004D9C2 522C051A        	  8004:     addq.b  #1,($051A,A4)
02:0004D9C6 0C03000B        	  8005:     cmpi.b  #$0B,D3
02:0004D9CA 6602            	  8006:     bne.s  __far_z_07_0130
02:0004D9CC 6042            	  8007:     jmp  RevealPondStairs
