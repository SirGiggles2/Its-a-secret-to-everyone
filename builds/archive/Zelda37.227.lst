                            	 12396: __far_z_04_0125:
                            	 12397:     ; State = 0.
                            	 12398:     ;
                            	 12399:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12400:     ; This is the only patra child shown in the first fame.
                            	 12401:     ;
02:0003F0CA 0C020002        	 12402:     cmpi.b  #$02,D2
02:0003F0CE 6732            	 12403:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12404:     ; The patra child in slot 2 is the last one to be updated.
                            	 12405:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12406:     ;
                            	 12407:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12408:     ; shown.
                            	 12409:     ;
02:0003F0D0 102C00AE        	 12410:     move.b  ($00AE,A4),D0
02:0003F0D4 6700008E        	 12411:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12412:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12413:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12414:     ;
02:0003F0D8 1002            	 12415:     move.b  D2,D0
                            	 12416:     ; Subtract 3 from the object slot to get the angle where the
                            	 12417:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12418:     ;
02:0003F0DA 003C0011        	 12419:     ori     #$11,CCR  ; SEC: set C+X
02:0003F0DE 123C0003        	 12420:     move.b  #$03,D1
02:0003F0E2 0A3C0010        	 12421:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0E6 9101            	 12422:     subx.b  D1,D0   ; SBC #$03
02:0003F0E8 0A3C0010        	 12423:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0EC 7600            	 12424:     moveq   #0,D3
02:0003F0EE 1600            	 12425:     move.b  D0,D3
                            	 12426:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12427:     ; then return.
                            	 12428:     ;
02:0003F0F0 102C0396        	 12429:     move.b  ($0396,A4),D0
02:0003F0F4 41F90003F0AE    	 12430:     lea     (PatraChildStartAngles).l,A0
02:0003F0FA 12303000        	 12431:     move.b  (A0,D3.W),D1
02:0003F0FE B001            	 12432:     cmp.b   D1,D0
02:0003F100 6662            	 12433:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12434:     even
