02:00031EA6 1940000D        	  6925:     move.b  D0,($000D,A4)
02:00031EAA 1940000E        	  6926:     move.b  D0,($000E,A4)
                            	  6927:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6928:     ;
02:00031EAE 10343070        	  6929:     move.b  ($70,A4,D3.W),D0
02:00031EB2 023C00EE        	  6930:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031EB6 123C0004        	  6931:     move.b  #$04,D1
02:00031EBA D101            	  6932:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031EBC 19400004        	  6933:     move.b  D0,($0004,A4)
                            	  6934:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6935:     ;
02:00031EC0 41EC0084        	  6936:     lea     ($0084,A4),A0
02:00031EC4 10303000        	  6937:     move.b  (A0,D3.W),D0
02:00031EC8 023C00EE        	  6938:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031ECC 123C0008        	  6939:     move.b  #$08,D1
02:00031ED0 D101            	  6940:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6941: ; Params:
                            	  6942: ; A: weapon object mid Y
                            	  6943: ; X: monster object slot
                            	  6944: ; Y: weapon object slot
                            	  6945: ; [00]: weapon object slot
                            	  6946: ; [02]: monster object mid X
                            	  6947: ; [03]: monster object mid Y
                            	  6948: ; [04]: weapon object mid X
                            	  6949: ; [07]: damage points
                            	  6950: ; [09]: damage type
                            	  6951: ; [0D]: horizontal threshold
                            	  6952: ; [0E]: vertical threshold
                            	  6953: ;
