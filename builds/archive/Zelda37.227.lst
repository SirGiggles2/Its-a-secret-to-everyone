                            	  7867: _L_z01_BeginShove_MonsterDefender:
                            	  7868:     ; A monster is the defender. A weapon is the attacker.
                            	  7869:     ;
                            	  7870:     ; Set the shove direction to the weapon's direction,
                            	  7871:     ; instead of the direction passed in [0B].
