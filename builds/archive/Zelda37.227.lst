02:0003DEF6 122C0002        	  9987:     move.b  ($0002,A4),D1
02:0003DEFA E309            	  9988:     lsl.b  #1,D1   ; ASL $02
02:0003DEFC 19410002        	  9989:     move.b  D1,($0002,A4)
02:0003DF00 122C0002        	  9990:     move.b  ($0002,A4),D1
02:0003DF04 C200            	  9991:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF06 6708            	  9992:     beq  _anon_z04_120
02:0003DF08 41EC0084        	  9993:     lea     ($0084,A4),A0
02:0003DF0C 52302000        	  9994:     addq.b  #1,(A0,D2.W)
                            	  9995: _anon_z04_120:
                            	  9996:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9997:     ;
02:0003DF10 122C0002        	  9998:     move.b  ($0002,A4),D1
02:0003DF14 E309            	  9999:     lsl.b  #1,D1   ; ASL $02
02:0003DF16 19410002        	 10000:     move.b  D1,($0002,A4)
02:0003DF1A 122C0002        	 10001:     move.b  ($0002,A4),D1
02:0003DF1E C200            	 10002:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF20 6708            	 10003:     beq  _anon_z04_121
02:0003DF22 41EC0084        	 10004:     lea     ($0084,A4),A0
