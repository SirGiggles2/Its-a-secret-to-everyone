02:00044DFE 602E            	  8115:     jmp  L1725A_Exit
                            	  8116: __far_z_05_0107:
                            	  8117:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8118:     ; and represents the current row of the submenu being processed.
                            	  8119:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8120:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8121:     ;
                            	  8122:     ; If the bottom bit is set, go prepare the full black row.
                            	  8123:     ;
02:00044E00 E208            	  8124:     lsr.b  #1,D0   ; LSR A
02:00044E02 7600            	  8125:     moveq   #0,D3
02:00044E04 1600            	  8126:     move.b  D0,D3
02:00044E06 6402            	  8127:     bcc.s  __far_z_05_0108
02:00044E08 6026            	  8128:     jmp  PrepFullBlackRow
                            	  8129: __far_z_05_0108:
                            	  8130:     ; Submenu rows $D to $15 are parts of the map.
                            	  8131:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8132:     ;
                            	  8133:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8134:     ; buffer for this row.
                            	  8135:     ;
02:00044E0A 0C00000D        	  8136:     cmpi.b  #$0D,D0
02:00044E0E 640C            	  8137:     bcc  _anon_z05_167
02:00044E10 41F900044DD4    	  8138:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044E16 10303000        	  8139:     move.b  (A0,D3.W),D0
