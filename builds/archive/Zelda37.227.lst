02:0003D0EC 023C00EE        	  8108:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0F0 123C000E        	  8109:     move.b  #$0E,D1
02:0003D0F4 D101            	  8110:     addx.b  D1,D0   ; ADC #$0E (X flag = 6502 C)
02:0003D0F6 19802070        	  8111:     move.b  D0,($70,A4,D2.W)
                            	  8112:     ; Save the original Y, and temporarily add 6 to it.
                            	  8113:     ;
02:0003D0FA 41EC0084        	  8114:     lea     ($0084,A4),A0
02:0003D0FE 10302000        	  8115:     move.b  (A0,D2.W),D0
02:0003D102 1B00            	  8116:     move.b  D0,-(A5)  ; PHA
02:0003D104 023C00EE        	  8117:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D108 123C0006        	  8118:     move.b  #$06,D1
02:0003D10C D101            	  8119:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:0003D10E 41EC0084        	  8120:     lea     ($0084,A4),A0
02:0003D112 11802000        	  8121:     move.b  D0,(A0,D2.W)
                            	  8122:     ; Check again at relative hotspot ($E, $E).
                            	  8123:     ;
