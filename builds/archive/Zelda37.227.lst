                            	  7522:     ; We want to handle "enemies from the edges of the screen".
                            	  7523:     ;
                            	  7524:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7525:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7526:     ; that does not spawn with a cloud (type >= $53);
                            	  7527:     ; 
                            	  7528:     ; then go initialize the object.
                            	  7529:     ;
02:0004D538 102C0010        	  7530:     move.b  ($0010,A4),D0
02:0004D53C 66000196        	  7531:     bne  _L_z07_InitObject_NormalSpawn
02:0004D540 102C04CD        	  7532:     move.b  ($04CD,A4),D0
02:0004D544 02000008        	  7533:     andi.b #$08,D0
02:0004D548 6700018A        	  7534:     beq  _L_z07_InitObject_NormalSpawn
02:0004D54C 41EC034F        	  7535:     lea     ($034F,A4),A0
02:0004D550 10302000        	  7536:     move.b  (A0,D2.W),D0
02:0004D554 0C000011        	  7537:     cmpi.b  #$11,D0
02:0004D558 6700017A        	  7538:     beq  _L_z07_InitObject_NormalSpawn
02:0004D55C 0C000040        	  7539:     cmpi.b  #$40,D0
02:0004D560 67000172        	  7540:     beq  _L_z07_InitObject_NormalSpawn
02:0004D564 0C00001E        	  7541:     cmpi.b  #$1E,D0
02:0004D568 6700016A        	  7542:     beq  _L_z07_InitObject_NormalSpawn
02:0004D56C 0C00002E        	  7543:     cmpi.b  #$2E,D0
02:0004D570 67000162        	  7544:     beq  _L_z07_InitObject_NormalSpawn
02:0004D574 0C000053        	  7545:     cmpi.b  #$53,D0
