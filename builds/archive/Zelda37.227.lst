                            	  7130: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7131:     ; Advance the substate.
                            	  7132:     ;
02:0003CA08 41EC042C        	  7133:     lea     ($042C,A4),A0
02:0003CA0C 52302000        	  7134:     addq.b  #1,(A0,D2.W)
                            	  7135:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7136:     ;
02:0003CA10 41EC042C        	  7137:     lea     ($042C,A4),A0
02:0003CA14 10302000        	  7138:     move.b  (A0,D2.W),D0
02:0003CA18 0C000002        	  7139:     cmpi.b  #$02,D0
