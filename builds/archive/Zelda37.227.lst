                            	  4242: DoorwayBoundsMinUnder:
02:000422C2 3D              	  4243:     dc.b    $3D, $BF, $00, $D2
02:000422C3 BF
02:000422C4 00
02:000422C5 D2
                            	  4244: 
                            	  4245: ; Player coordinate must be < these bounds.
                            	  4246: ; Using these bounds; the player will be considered within the
                            	  4247: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4248: ; at the edge.
                            	  4249: ;
                            	  4250:     even
                            	  4251: DoorwayBoundsMaxUnder:
02:000422C6 5C              	  4252:     dc.b    $5C, $DE, $1F, $F1
02:000422C7 DE
02:000422C8 1F
02:000422C9 F1
                            	  4253: 
                            	  4254: ; Params:
                            	  4255: ; [0F]: moving direction
                            	  4256: ;
                            	  4257: ; Returns:
                            	  4258: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4259: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4260: ;
                            	  4261: ; When not at or in a doorway, this function leaves
                            	  4262: ; [0F] moving direction as is.
                            	  4263: ;
                            	  4264: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4265: ; will be left as is, assuming that it had been reset before this
                            	  4266: ; routine by BoundByRoom.
                            	  4267: ;
                            	  4268: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4269: ;
                            	  4270: ;
                            	  4271: ; If already in a doorway, go handle it separately.
                            	  4272: ;
                            	  4273:     even
                            	  4274: CheckDoorway:
02:000422CA 102C0053        	  4275:     move.b  ($0053,A4),D0
02:000422CE 6648            	  4276:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4277:     even
                            	  4278: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4279:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4280:     ;
                            	  4281:     ; To match a doorway:
                            	  4282:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4283:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4284:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4285:     ;
                            	  4286:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4287:     ; a doorway to be part of it.
                            	  4288:     ;
02:000422D0 102C0098        	  4289:     move.b  ($0098,A4),D0
02:000422D4 61000122        	  4290:     jsr     GetPlayerCoordsForDirection
02:000422D8 7603            	  4291:     moveq   #3,D3
                            	  4292:     even
