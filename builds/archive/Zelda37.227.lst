                            	  8218:     ;
02:0003D1CE 7000            	  8219:     moveq   #0,D0
02:0003D1D0 19400028        	  8220:     move.b  D0,($0028,A4)
02:0003D1D4 19400405        	  8221:     move.b  D0,($0405,A4)
02:0003D1D8 194000C0        	  8222:     move.b  D0,($00C0,A4)
02:0003D1DC 194000D3        	  8223:     move.b  D0,($00D3,A4)
                            	  8224:     ; Restart the monster's movement frame cycle: frame 0, counter 4
