02:0002B6C6 2F00            	   557:     move.l  D0,-(SP)
02:0002B6C8 7200            	   558:     moveq   #0,D1
02:0002B6CA 1202            	   559:     move.b  D2,D1
02:0002B6CC 2F01            	   560:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   561:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   562:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   563:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   564:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   565:     addq.l  #8,SP
