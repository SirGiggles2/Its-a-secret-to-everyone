                            	  7064: __far_z_07_0123:
                            	  7065: ; Params:
                            	  7066: ; X: object index
                            	  7067: ;
                            	  7068: ; Returns:
                            	  7069: ; Y: animation frame
                            	  7070: ; [00]: object X
                            	  7071: ; [01]: object Y
                            	  7072: ; [0F]: flip horizontal
                            	  7073: ;
                            	  7074: ; As the object walks, the animation counter rolls down.
                            	  7075: ;
                            	  7076:     even
