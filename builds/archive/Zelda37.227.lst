02:0004C438 10343070        	  5226:     move.b  ($70,A4,D3.W),D0
02:0004C43C 19802070        	  5227:     move.b  D0,($70,A4,D2.W)
02:0004C440 41EC0084        	  5228:     lea     ($0084,A4),A0
02:0004C444 10303000        	  5229:     move.b  (A0,D3.W),D0
02:0004C448 41EC0084        	  5230:     lea     ($0084,A4),A0
02:0004C44C 11802000        	  5231:     move.b  D0,(A0,D2.W)
02:0004C450 41EC0098        	  5232:     lea     ($0098,A4),A0
02:0004C454 10303000        	  5233:     move.b  (A0,D3.W),D0
02:0004C458 41EC0098        	  5234:     lea     ($0098,A4),A0
02:0004C45C 11802000        	  5235:     move.b  D0,(A0,D2.W)
