                            	  4421:     ; UNKNOWN:
                            	  4422:     ; This seems to be unused code triggered by object attribute $10.
                            	  4423:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4424:     ;
02:0004BEF4 6100016C        	  4425:     jsr     ReverseObjDir
02:0004BEF8 60000104        	  4426:     jmp     CheckBoundary
