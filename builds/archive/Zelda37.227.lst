                            	 14196: TurnTowardsPlayer8:
                            	 14197:     ; Build a direction in [00] towards the player.
                            	 14198:     ;
                            	 14199:     ; First, calculate a horizontal component:
                            	 14200:     ;
                            	 14201:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14202:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14203:     ; else                               [00] := 2 (left)
                            	 14204:     ;
02:0003FD7C 7600            	 14205:     moveq   #0,D3
02:0003FD7E 1883            	 14206:     move.b  D3,($0000,A4)
02:0003FD80 5203            	 14207:     addq.b  #1,D3
02:0003FD82 102C0061        	 14208:     move.b  ($0061,A4),D0
