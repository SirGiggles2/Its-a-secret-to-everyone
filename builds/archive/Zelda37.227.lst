02:0004036A 102C0010        	   521:     move.b  ($0010,A4),D0
02:0004036E 6606            	   522:     bne.s  __far_z_05_0005
02:00040370 4EF90002D16E    	   523:     jmp  Exit
                            	   524: __far_z_05_0005:
02:00040376 6100514A        	   525:     jsr     HasCompass
02:0004037A 6606            	   526:     bne.s  __far_z_05_0006
02:0004037C 4EF90002D16E    	   527:     jmp  Exit
