02:00030DE2 194000AC        	  4749:     move.b  D0,($00AC,A4)
                            	  4750: ; Places the weapon $10 pixels away from the player in the
                            	  4751: ; player's direction.
                            	  4752: ;
                            	  4753: ; Params:
                            	  4754: ; A: $10 for right and down
                            	  4755: ; X: object index
                            	  4756: ;
                            	  4757: ;
                            	  4758: ; Set the offset choices to:
