                            	  5349: ; Params:
                            	  5350: ; [02]: bitmask for target door.
                            	  5351: ;
                            	  5352: ; Returns:
                            	  5353: ; A: door attribute for desired direction in current room.
                            	  5354: ; [01]: same as [02] if found; $10 otherwise
                            	  5355: ; [03]: reverse direction index
                            	  5356: ;
                            	  5357: ; Door bits:
                            	  5358: ; 1: E
                            	  5359: ; 2: W
                            	  5360: ; 4: S
                            	  5361: ; 8: N
                            	  5362: ;
                            	  5363: ;
                            	  5364: ; Start with single-bit mask 1.
                            	  5365:     even
