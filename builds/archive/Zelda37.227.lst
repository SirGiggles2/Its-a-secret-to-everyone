                            	  2356:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2357:     ;
                            	  2358:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2359:     ; In total, 11 bytes will be written.
                            	  2360:     ;
                            	  2361:     ; First, write the high byte of PPU address in each record.
                            	  2362:     ;
02:0004B00A 1014            	  2363:     move.b  ($0000,A4),D0
02:0004B00C 41EC0302        	  2364:     lea     ($0302,A4),A0
02:0004B010 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:0004B014 41EC0307        	  2366:     lea     ($0307,A4),A0
02:0004B018 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; Write the low address in the first record. In the second record,
                            	  2369:     ; write (low address + 1).
                            	  2370:     ;
02:0004B01C 102C0001        	  2371:     move.b  ($0001,A4),D0
02:0004B020 41EC0303        	  2372:     lea     ($0303,A4),A0
02:0004B024 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B028 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B02C 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004B030 41EC0308        	  2376:     lea     ($0308,A4),A0
02:0004B034 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     ; Write the first tile twice in each record. Patch them later.
                            	  2379:     ;
02:0004B038 102C0005        	  2380:     move.b  ($0005,A4),D0
02:0004B03C 41EC0305        	  2381:     lea     ($0305,A4),A0
02:0004B040 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B044 41EC0306        	  2383:     lea     ($0306,A4),A0
02:0004B048 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B04C 41EC030A        	  2385:     lea     ($030A,A4),A0
02:0004B050 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004B054 41EC030B        	  2387:     lea     ($030B,A4),A0
02:0004B058 11802000        	  2388:     move.b  D0,(A0,D2.W)
                            	  2389:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
