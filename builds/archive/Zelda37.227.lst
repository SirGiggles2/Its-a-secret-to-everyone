                            	  3201: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3202:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3203:     ; the mound frame images:
                            	  3204:     ;
                            	  3205:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3206:     ;
                            	  3207:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3208:     ;
                            	  3209:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3210:     ;
02:0003AD92 003C0011        	  3211:     ori     #$11,CCR  ; SEC: set C+X
02:0003AD96 123C0001        	  3212:     move.b  #$01,D1
02:0003AD9A 0A3C0010        	  3213:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AD9E 9101            	  3214:     subx.b  D1,D0   ; SBC #$01
02:0003ADA0 0A3C0010        	  3215:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ADA4 E308            	  3216:     lsl.b  #1,D0   ; ASL A
02:0003ADA6 023C00EE        	  3217:     andi    #$EE,CCR  ; CLC: clear C+X
