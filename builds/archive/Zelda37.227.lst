02:0003CF94 10302000        	  7959:     move.b  (A0,D2.W),D0
02:0003CF98 023C00EE        	  7960:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF9C 41F90003CE7A    	  7961:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CFA2 12303000        	  7962:     move.b  (A0,D3.W),D1
