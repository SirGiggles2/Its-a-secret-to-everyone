                            	  7785: _anon_z05_156:
02:00044B9A 101D            	  7786:     move.b  (A5)+,D0  ; PLA
                            	  7787:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7788:     ; then the player walked all the way to the edge of the play
                            	  7789:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7790:     ;
                            	  7791:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7792:     ; edge of the play area. So, set a relative position that
                            	  7793:     ; reflects that distance: $28 or -$28.
                            	  7794:     ;
                            	  7795:     ; If walking in a decreasing direction (left or up), then
                            	  7796:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7797:     ;
                            	  7798:     ; If walking in an increasing direction (right or down), then
                            	  7799:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7800:     ;
02:00044B9C 02000007        	  7801:     andi.b #$07,D0
02:00044BA0 0C000002        	  7802:     cmpi.b  #$02,D0
