02:0002E91A 123C0010        	  1731:     move.b  #$10,D1
02:0002E91E 0A3C0010        	  1732:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E922 9101            	  1733:     subx.b  D1,D0   ; SBC #$10
02:0002E924 0A3C0010        	  1734:     eori    #$10,CCR  ; restore X = 6502 C
