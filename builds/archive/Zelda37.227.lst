                            	  5681: LayOutDoors:
                            	  5682:     ; Copies the right door face for the direction, type, and state
                            	  5683:     ; of the door to the play area tile map.
                            	  5684:     ;
                            	  5685:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5686:     ; that are not true doors.
                            	  5687:     ;
02:000437B0 7403            	  5688:     moveq   #3,D2
                            	  5689:     even
                            	  5690: L_LayOutDoors_LoopDoors:
                            	  5691:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5692:     ;
02:000437B2 7001            	  5693:     moveq   #1,D0
                            	  5694:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5695:     ;
                            	  5696:     ; [06] indicates whether we're handling the first half of
                            	  5697:     ; the door: Left half for N/S, Top half for E/W.
                            	  5698:     ;
02:000437B4 19400006        	  5699:     move.b  D0,($0006,A4)
                            	  5700:     even
                            	  5701: L_LayOutDoors_LoopHalves:
02:000437B8 1002            	  5702:     move.b  D2,D0
02:000437BA 1B00            	  5703:     move.b  D0,-(A5)  ; PHA
02:000437BC 1940000B        	  5704:     move.b  D0,($000B,A4)
02:000437C0 41F90004378C    	  5705:     lea     (DoorBits).l,A0
02:000437C6 10302000        	  5706:     move.b  (A0,D2.W),D0
02:000437CA 19400002        	  5707:     move.b  D0,($0002,A4)
02:000437CE 6100FD4A        	  5708:     jsr     FindDoorAttrByDoorBit
                            	  5709:     ; Begin looking for the door face for the door attribute.
                            	  5710:     ; In general, use the door type as the provisional face;
                            	  5711:     ; except turn 4 into 8.
                            	  5712:     ;
02:000437D2 0C000005        	  5713:     cmpi.b  #$05,D0
02:000437D6 642A            	  5714:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000437D8 0C000004        	  5715:     cmpi.b  #$04,D0
02:000437DC 6608            	  5716:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:000437DE 7008            	  5717:     moveq   #8,D0
02:000437E0 6620            	  5718:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5719:     even
                            	  5720: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5721:     ; We jump here if the door type is bombable and was opened.
                            	  5722:     ; Change the provisional door face to value 9, which
                            	  5723:     ; will become the "hole in the wall".
                            	  5724:     ;
02:000437E2 7009            	  5725:     moveq   #9,D0
02:000437E4 665A            	  5726:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5727:     even
                            	  5728: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5729:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5730:     ; the mask of opened doors, because this is not a true door.
                            	  5731:     ;
02:000437E6 1B00            	  5732:     move.b  D0,-(A5)  ; PHA
02:000437E8 102C0002        	  5733:     move.b  ($0002,A4),D0
02:000437EC 4600            	  5734:     eori.b #$FF,D0
02:000437EE 122C00EE        	  5735:     move.b  ($00EE,A4),D1
02:000437F2 C001            	  5736:     and.b  D1,D0
02:000437F4 194000EE        	  5737:     move.b  D0,($00EE,A4)
02:000437F8 101D            	  5738:     move.b  (A5)+,D0  ; PLA
                            	  5739:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5740:     ;
02:000437FA 0C000001        	  5741:     cmpi.b  #$01,D0
02:000437FE 6402            	  5742:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043800 7004            	  5743:     moveq   #4,D0
                            	  5744:     even
                            	  5745: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5746:     ; The door attribute (DA) has been mapped to a
                            	  5747:     ; provisional door face value (PF) in %A as follows:
                            	  5748:     ;
                            	  5749:     ; DA PF Meaning
                            	  5750:     ; -------------
                            	  5751:     ; 0  4  open
                            	  5752:     ; 1  1  wall
                            	  5753:     ; 2  2  false wall
                            	  5754:     ; 3  3  false wall 2
                            	  5755:     ; 4  8  bombable
                            	  5756:     ; 5  5  key
                            	  5757:     ; 6  6  key 2
                            	  5758:     ; 7  7  shutter
                            	  5759:     ;
                            	  5760:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5761:     ; has been cleared, if the type was "open" or any wall.
                            	  5762:     ;
                            	  5763:     ;
                            	  5764:     ; Save the provisional face.
02:00043802 1B00            	  5765:     move.b  D0,-(A5)  ; PHA
                            	  5766:     ; If the current direction points to a door that has been opened,
                            	  5767:     ; then see if we need to set door flags.
                            	  5768:     ;
02:00043804 102C00EE        	  5769:     move.b  ($00EE,A4),D0
02:00043808 122C0002        	  5770:     move.b  ($0002,A4),D1
02:0004380C C001            	  5771:     and.b  D1,D0
02:0004380E 7400            	  5772:     moveq   #0,D2
02:00043810 1400            	  5773:     move.b  D0,D2
02:00043812 101D            	  5774:     move.b  (A5)+,D0  ; PLA
02:00043814 122C0002        	  5775:     move.b  ($0002,A4),D1
02:00043818 B401            	  5776:     cmp.b   D1,D2
02:0004381A 6624            	  5777:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5778:     ; The current direction points to a door that has been opened.
                            	  5779:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; Save provisional door face in Y register.
02:0004381C 7600            	  5783:     moveq   #0,D3
02:0004381E 1600            	  5784:     move.b  D0,D3
02:00043820 101D            	  5785:     move.b  (A5)+,D0  ; PLA
02:00043822 1B00            	  5786:     move.b  D0,-(A5)  ; PHA
02:00043824 7400            	  5787:     moveq   #0,D2
02:00043826 1400            	  5788:     move.b  D0,D2
02:00043828 1003            	  5789:     move.b  D3,D0
                            	  5790:     ; If provisional door face is not for a shutter, then
                            	  5791:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5792:     ;
                            	  5793:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5794:     ;
02:0004382A 0C000007        	  5795:     cmpi.b  #$07,D0
02:0004382E 670E            	  5796:     beq  _anon_z05_111
02:00043830 1B00            	  5797:     move.b  D0,-(A5)  ; PHA
02:00043832 6100DDE2        	  5798:     jsr     SetDoorFlag
02:00043836 101D            	  5799:     move.b  (A5)+,D0  ; PLA
                            	  5800:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5801:     ; then go make it 9 (open "bombable").
                            	  5802:     ; Else make it 4 (open "door").
                            	  5803:     ;
02:00043838 0C000008        	  5804:     cmpi.b  #$08,D0
02:0004383C 67A4            	  5805:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5806: _anon_z05_111:
02:0004383E 7004            	  5807:     moveq   #4,D0
                            	  5808:     even
                            	  5809: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5810:     ; For opened doors, the provisional door face has become:
                            	  5811:     ;
                            	  5812:     ; DA PF Meaning
                            	  5813:     ; -------------
                            	  5814:     ; 0  4  open
                            	  5815:     ; 1  1  wall
                            	  5816:     ; 2  2  false wall
                            	  5817:     ; 3  3  false wall 2
                            	  5818:     ; 4  9  bombable
                            	  5819:     ; 5  4  key
                            	  5820:     ; 6  4  key 2
                            	  5821:     ; 7  4  shutter
                            	  5822:     ;
                            	  5823:     ;
                            	  5824:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5825:     ;
02:00043840 7400            	  5826:     moveq   #0,D2
02:00043842 142C0006        	  5827:     move.b  ($0006,A4),D2
02:00043846 6712            	  5828:     beq  _anon_z05_112
02:00043848 7400            	  5829:     moveq   #0,D2
02:0004384A 142C000B        	  5830:     move.b  ($000B,A4),D2
02:0004384E 1B00            	  5831:     move.b  D0,-(A5)  ; PHA
02:00043850 6100FCC8        	  5832:     jsr     FindDoorAttrByDoorBit
02:00043854 61001CFC        	  5833:     jsr     CalcOpenDoorwayMask
02:00043858 101D            	  5834:     move.b  (A5)+,D0  ; PLA
                            	  5835: _anon_z05_112:
                            	  5836:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5837:     ; because the visible door face is already a wall.
                            	  5838:     ;
02:0004385A 0C000004        	  5839:     cmpi.b  #$04,D0
02:0004385E 650000DC        	  5840:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5841:     ; For all other provisional face values, calculate:
                            	  5842:     ; door face := provisional face - 3
02:00043862 003C0011        	  5843:     ori     #$11,CCR  ; SEC: set C+X
