02:0004C878 11802000        	  5851:     move.b  D0,(A0,D2.W)
                            	  5852:     ; If facing left and X < 2, then go change state to $40. The
                            	  5853:     ; boomerang is too close to the left edge of the screen.
                            	  5854:     ; Another move might make it wrap around.
