                            	  2524: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2525:     ; If instead the direction is a decreasing one, then
                            	  2526:     ; rotate right to correspond to the lower level number.
                            	  2527:     ; Then go test this new mask.
                            	  2528:     ;
02:0002FF1C 1214            	  2529:     move.b  ($0000,A4),D1
02:0002FF1E E209            	  2530:     lsr.b  #1,D1   ; LSR $00
02:0002FF20 1881            	  2531:     move.b  D1,($0000,A4)
02:0002FF22 64CE            	  2532:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FF24 1214            	  2533:     move.b  ($0000,A4),D1
02:0002FF26 E211            	  2534:     roxr.b  #1,D1   ; ROR $00
02:0002FF28 1881            	  2535:     move.b  D1,($0000,A4)
02:0002FF2A 60C6            	  2536:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
