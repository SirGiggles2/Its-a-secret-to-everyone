02:0003F1B2 162C045F        	 12525:     move.b  ($045F,A4),D3
                            	 12526:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12527:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12528:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12529:     ;
02:0003F1B6 41EC034F        	 12530:     lea     ($034F,A4),A0
02:0003F1BA 10302000        	 12531:     move.b  (A0,D2.W),D0
02:0003F1BE 0C000025        	 12532:     cmpi.b  #$25,D0
