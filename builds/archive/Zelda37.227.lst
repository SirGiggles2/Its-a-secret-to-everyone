02:00033644 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:00033648 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003364C E14C            	   528:     lsl.w   #8,D4
02:0003364E 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033650 48C4            	   530:     ext.l   D4
02:00033652 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033658 2044            	   532:     movea.l D4,A0
02:0003365A 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003365E 41EC0633        	   534:     lea     ($0633,A4),A0
02:00033662 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033666 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:00033668 1003            	   537:     move.b  D3,D0
02:0003366A 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003366C 19430016        	   539:     move.b  D3,($0016,A4)
02:00033670 6100D156        	   540:     jsr     FetchFileAAddressSet
02:00033674 61001C46        	   541:     jsr     FormatFileA
02:00033678 7000            	   542:     moveq   #0,D0
02:0003367A 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
