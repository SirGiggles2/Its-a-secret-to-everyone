02:00030D80 020000F0        	  4680:     andi.b #$F0,D0
02:00030D84 0C000010        	  4681:     cmpi.b  #$10,D0
02:00030D88 661A            	  4682:     bne  _L_z01_WieldBomb_FoundSlot
                            	  4683:     ; Else look at slot $11.
