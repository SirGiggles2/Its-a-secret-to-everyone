02:0003CE92 8001            	  7820:     or.b  D1,D0
02:0003CE94 660000AE        	  7821:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7822:     ; Every odd screen frame, go straight to drawing
                            	  7823:     ; and checking collisions.
