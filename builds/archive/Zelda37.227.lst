                            	  6057: _anon_z01_76:
                            	  6058:     ; If it's Link, write the sprites. He's never mirrored.
                            	  6059:     ;
02:00031842 4A02            	  6060:     cmpi.b  #$00,D2
02:00031844 6602            	  6061:     bne.s  __far_z_01_0054
02:00031846 6014            	  6062:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  6063: __far_z_01_0054:
