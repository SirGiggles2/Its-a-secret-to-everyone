02:0003D11A 41EC0084        	  8128:     lea     ($0084,A4),A0
02:0003D11E 11802000        	  8129:     move.b  D0,(A0,D2.W)
02:0003D122 101D            	  8130:     move.b  (A5)+,D0  ; PLA
02:0003D124 19802070        	  8131:     move.b  D0,($70,A4,D2.W)
                            	  8132:     even
