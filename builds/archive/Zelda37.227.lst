                            	  5746:     ;
                            	  5747:     ; Set state to $40. It will become $50 below in
                            	  5748:     ; HandleArrowOrBoomerangBlocked.
                            	  5749:     ;
02:0004C7C4 7040            	  5750:     moveq   #64,D0
02:0004C7C6 41EC00AC        	  5751:     lea     ($00AC,A4),A0
02:0004C7CA 11802000        	  5752:     move.b  D0,(A0,D2.W)
                            	  5753:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5754:     ; Else go handle the boomerang being blocked.
                            	  5755:     ;
02:0004C7CE 0C02000D        	  5756:     cmpi.b  #$0D,D2
02:0004C7D2 640E            	  5757:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C7D4 41EC034F        	  5758:     lea     ($034F,A4),A0
02:0004C7D8 10302000        	  5759:     move.b  (A0,D2.W),D0
