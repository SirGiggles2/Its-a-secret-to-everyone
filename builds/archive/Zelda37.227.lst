02:0003F4DA 610000B2        	 12998:     jsr     Ganon_GetCurCloudRight
02:0003F4DE 619A            	 12999:     jsr     Ganon_DrawCloud
02:0003F4E0 610000A6        	 13000:     jsr     Ganon_GetCurCloudLeft
