                            	  3710: DrawGhiniAndCheckCollisions:
02:0003B14A 4EB90004D182    	  3711:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B150 1940000D        	  3712:     move.b  D0,($000D,A4)
                            	  3713:     ; If the direction has an "up" component, then keep the
                            	  3714:     ; frame image 0, and go figure out horizontal flipping.
                            	  3715:     ;
02:0003B154 41EC0098        	  3716:     lea     ($0098,A4),A0
02:0003B158 10302000        	  3717:     move.b  (A0,D2.W),D0
02:0003B15C 02000008        	  3718:     andi.b #$08,D0
02:0003B160 6614            	  3719:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3720:     ; Else make the frame image 1 for the "down" frame.
                            	  3721:     ; Note that this is the frame image to use, even if there's no
                            	  3722:     ; down component in the direction.
                            	  3723:     ;
02:0003B162 522C000D        	  3724:     addq.b  #1,($000D,A4)
                            	  3725:     ; If right is a component of the direction, then go set horizontal
                            	  3726:     ; flipping. Else leave horizontal flipping = 0.
                            	  3727:     ;
02:0003B166 41EC0098        	  3728:     lea     ($0098,A4),A0
02:0003B16A 10302000        	  3729:     move.b  (A0,D2.W),D0
02:0003B16E 02000001        	  3730:     andi.b #$01,D0
02:0003B172 6714            	  3731:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B174 660E            	  3732:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3733:     even
