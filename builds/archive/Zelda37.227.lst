                            	  8450:     even
                            	  8451: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8452:     ; If the teleporting distance remaining is even, then draw
                            	  8453:     ; and check collisions, else return.
                            	  8454:     ;
                            	  8455:     ; This means that when 0, the monster is walking.
                            	  8456:     ; So, draw and check collisions every frame.
                            	  8457:     ;
                            	  8458:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8459:     ; translucently -- every other frame.
                            	  8460:     ;
02:0003D39E 41EC0394        	  8461:     lea     ($0394,A4),A0
02:0003D3A2 10302000        	  8462:     move.b  (A0,D2.W),D0
02:0003D3A6 E208            	  8463:     lsr.b  #1,D0   ; LSR A
02:0003D3A8 6402            	  8464:     bcc.s  __far_z_04_0076
02:0003D3AA 603A            	  8465:     jmp  L11E17_Exit
                            	  8466: __far_z_04_0076:
                            	  8467:     even
