02:0002FEB0 6710            	  2456:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0002FEB2 1002            	  2457:     move.b  D2,D0
02:0002FEB4 1B00            	  2458:     move.b  D0,-(A5)  ; PHA
02:0002FEB6 4EB90004BFD8    	  2459:     jsr     GoToNextModeFromPlay
02:0002FEBC 101D            	  2460:     move.b  (A5)+,D0  ; PLA
02:0002FEBE 7400            	  2461:     moveq   #0,D2
