                            	  9655:     ;
                            	  9656:     ; Item ID 3 normally means the master sword. But because the
                            	  9657:     ; usual value meaning "no item" ($3F) can't fit in the level
                            	  9658:     ; block attribute for a room item (up to $1F); use 3 to
                            	  9659:     ; stand in for it.
                            	  9660:     ;
