02:0004C862 0C000030        	  5838:     cmpi.b  #$30,D0
02:0004C866 6656            	  5839:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5840:     ; State $3x. Slow down.
                            	  5841:     ;
                            	  5842:     ; Reset grid offset for movement.
                            	  5843:     ;
