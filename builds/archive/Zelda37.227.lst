                            	  1806:     ; Enter method 1.
                            	  1807:     ;
                            	  1808:     ; Set up Link's exit from underground.
                            	  1809:     ;
02:00041132 7600            	  1810:     moveq   #0,D3
02:00041134 162C00EB        	  1811:     move.b  ($00EB,A4),D3
02:00041138 41F900FF687E    	  1812:     lea     (NES_SRAM+$087E).l,A0
02:0004113E 10303000        	  1813:     move.b  (A0,D3.W),D0
02:00041142 020000F0        	  1814:     andi.b #$F0,D0
02:00041146 19400070        	  1815:     move.b  D0,($0070,A4)
02:0004114A 41F900FF6AFE    	  1816:     lea     (NES_SRAM+$0AFE).l,A0
02:00041150 10303000        	  1817:     move.b  (A0,D3.W),D0
02:00041154 02000007        	  1818:     andi.b #$07,D0
02:00041158 E308            	  1819:     lsl.b  #1,D0   ; ASL A
02:0004115A E308            	  1820:     lsl.b  #1,D0   ; ASL A
02:0004115C E308            	  1821:     lsl.b  #1,D0   ; ASL A
02:0004115E E308            	  1822:     lsl.b  #1,D0   ; ASL A
                            	  1823:     ; Add the first Y where Link can come out of underground.
                            	  1824:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
