02:0004CBD4 41F90004CAF6    	  6306:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004CBDA 12303000        	  6307:     move.b  (A0,D3.W),D1
02:0004CBDE D101            	  6308:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004CBE0 41EC0084        	  6309:     lea     ($0084,A4),A0
