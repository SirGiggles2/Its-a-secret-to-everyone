02:00030E0A 102C0098        	  4780:     move.b  ($0098,A4),D0
02:00030E0E E208            	  4781:     lsr.b  #1,D0   ; LSR A
02:00030E10 E208            	  4782:     lsr.b  #1,D0   ; LSR A
02:00030E12 6110            	  4783:     jsr     ChooseOffsetForDirectionH
02:00030E14 122C0084        	  4784:     move.b  ($0084,A4),D1
02:00030E18 D101            	  4785:     addx.b  D1,D0   ; ADC ObjY
02:00030E1A 41EC0084        	  4786:     lea     ($0084,A4),A0
