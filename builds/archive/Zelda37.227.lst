02:0003B27E 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:0003B282 E208            	  3925:     lsr.b  #1,D0   ; LSR A
02:0003B284 6512            	  3926:     bcs  _anon_z04_53
                            	  3927:     ; Finish initializing based on type.
                            	  3928:     ;
02:0003B286 41EC034F        	  3929:     lea     ($034F,A4),A0
02:0003B28A 10302000        	  3930:     move.b  (A0,D2.W),D0
02:0003B28E 0C000022        	  3931:     cmpi.b  #$22,D0
