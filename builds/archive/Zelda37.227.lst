                            	  8435: ; Description:
                            	  8436: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8437: ; When walking, the object timer is set. When teleporting,
                            	  8438: ; the teleporting distance remaining is set.
                            	  8439: ;
                            	  8440: ; If we have the magic clock, then only go draw and check collisions.
                            	  8441: ;
                            	  8442:     even
                            	  8443: UpdateBlueWizzrobe:
02:0003D390 102C066C        	  8444:     move.b  ($066C,A4),D0
02:0003D394 6702            	  8445:     beq.s  __far_z_04_0075
02:0003D396 6014            	  8446:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8447: __far_z_04_0075:
02:0003D398 6116            	  8448:     jsr     BlueWizzrobe_WalkOrTeleport
