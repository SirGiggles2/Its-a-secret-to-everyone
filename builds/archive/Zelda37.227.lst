02:00036328 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:0003632C 522C0416        	  4595:     addq.b  #1,($0416,A4)
