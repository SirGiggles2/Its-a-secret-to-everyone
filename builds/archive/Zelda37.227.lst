                            	  6753:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6754:     ;
02:00031D60 7001            	  6755:     moveq   #1,D0
02:00031D62 19400604        	  6756:     move.b  D0,($0604,A4)
02:00031D66 7000            	  6757:     moveq   #0,D0
02:00031D68 19400006        	  6758:     move.b  D0,($0006,A4)
