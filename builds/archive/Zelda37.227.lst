                            	  6264:     even
                            	  6265: _L_z07_UpdateSwordOrRod_Add4:
                            	  6266:     ; Set [00] to (state - 1) * 4:
                            	  6267:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6268:     ;
02:0004CB82 023C00EE        	  6269:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CB86 123C0004        	  6270:     move.b  #$04,D1
02:0004CB8A D101            	  6271:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004CB8C 5303            	  6272:     subq.b  #1,D3
02:0004CB8E 66F2            	  6273:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004CB90 1880            	  6274:     move.b  D0,($0000,A4)
                            	  6275:     ; Set object's direction to player's. It might have changed
                            	  6276:     ; since the last frame.
                            	  6277:     ;
02:0004CB92 102C0098        	  6278:     move.b  ($0098,A4),D0
02:0004CB96 41EC0098        	  6279:     lea     ($0098,A4),A0
02:0004CB9A 11802000        	  6280:     move.b  D0,(A0,D2.W)
                            	  6281:     ; Add [00] and the reverse index of the direction to get
                            	  6282:     ; the byte offset of the pixel offset.
                            	  6283:     ;
02:0004CB9E 4EB900030BF8    	  6284:     jsr     GetOppositeDir
02:0004CBA4 1003            	  6285:     move.b  D3,D0
02:0004CBA6 023C00EE        	  6286:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBAA 1214            	  6287:     move.b  ($0000,A4),D1
02:0004CBAC D101            	  6288:     addx.b  D1,D0   ; ADC $00
02:0004CBAE 7600            	  6289:     moveq   #0,D3
02:0004CBB0 1600            	  6290:     move.b  D0,D3
                            	  6291:     ; Set object's X to player's X + offset for state and direction.
                            	  6292:     ; Copy the result to [00].
                            	  6293:     ;
02:0004CBB2 102C0070        	  6294:     move.b  ($0070,A4),D0
02:0004CBB6 023C00EE        	  6295:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBBA 41F90004CAE6    	  6296:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004CBC0 12303000        	  6297:     move.b  (A0,D3.W),D1
02:0004CBC4 D101            	  6298:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:0004CBC6 19802070        	  6299:     move.b  D0,($70,A4,D2.W)
02:0004CBCA 1880            	  6300:     move.b  D0,($0000,A4)
                            	  6301:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6302:     ; Copy the result to [01].
                            	  6303:     ;
