                            	  6883:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6884:     ; Make Link face down.
                            	  6885:     ; Go to mode $11.
                            	  6886:     ;
02:00031E68 102C066F        	  6887:     move.b  ($066F,A4),D0
02:00031E6C 020000F0        	  6888:     andi.b #$F0,D0
02:00031E70 1940066F        	  6889:     move.b  D0,($066F,A4)
02:00031E74 4EB90004B550    	  6890:     jsr     EndGameMode
02:00031E7A 19400670        	  6891:     move.b  D0,($0670,A4)
02:00031E7E 194000AC        	  6892:     move.b  D0,($00AC,A4)
02:00031E82 7011            	  6893:     moveq   #17,D0
02:00031E84 19400012        	  6894:     move.b  D0,($0012,A4)
02:00031E88 7004            	  6895:     moveq   #4,D0
02:00031E8A 19400098        	  6896:     move.b  D0,($0098,A4)
                            	  6897: _anon_z01_87:
02:00031E8E 4E75            	  6898:     rts
                            	  6899: 
                            	  6900: ; Params:
                            	  6901: ; X: monster slot
                            	  6902: ; Y: weapon slot
                            	  6903: ; [02]: monster mid X
                            	  6904: ; [03]: monster mid Y
                            	  6905: ;
                            	  6906: ; Returns:
                            	  6907: ; [00]: weapon slot
                            	  6908: ;
                            	  6909: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6910: ;
                            	  6911:     even
                            	  6912: CheckMonsterBoomerangOrFoodCollision:
02:00031E90 41EC00AC        	  6913:     lea     ($00AC,A4),A0
02:00031E94 10303000        	  6914:     move.b  (A0,D3.W),D0
02:00031E98 E308            	  6915:     lsl.b  #1,D0   ; ASL A
02:00031E9A 65F2            	  6916:     bcs  _anon_z01_87
02:00031E9C 1883            	  6917:     move.b  D3,($0000,A4)
                            	  6918:     ; Set boomerang damage type (2) in [09].
                            	  6919:     ;
