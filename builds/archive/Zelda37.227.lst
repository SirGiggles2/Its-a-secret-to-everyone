                            	  9874: Manhandla_Draw:
02:0003DE20 4EB90004D182    	  9875:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9876:     ; Push the "frame image and sprite attributes" value.
                            	  9877:     ;
02:0003DE26 41EC0478        	  9878:     lea     ($0478,A4),A0
02:0003DE2A 10302000        	  9879:     move.b  (A0,D2.W),D0
02:0003DE2E 1B00            	  9880:     move.b  D0,-(A5)  ; PHA
                            	  9881:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9882:     ; passed along as is.
                            	  9883:     ;
02:0003DE30 02000080        	  9884:     andi.b #$80,D0
02:0003DE34 00000001        	  9885:     ori.b #$01,D0
02:0003DE38 4EB900031A6C    	  9886:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DE3E 101D            	  9887:     move.b  (A5)+,D0  ; PLA
02:0003DE40 1B00            	  9888:     move.b  D0,-(A5)  ; PHA
                            	  9889:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9890:     ;
02:0003DE42 02000040        	  9891:     andi.b #$40,D0
02:0003DE46 6704            	  9892:     beq  _anon_z04_116
02:0003DE48 522C000F        	  9893:     addq.b  #1,($000F,A4)
                            	  9894: _anon_z04_116:
02:0003DE4C 101D            	  9895:     move.b  (A5)+,D0  ; PLA
                            	  9896:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9897:     ; These are the 2 frame images of the horizontal hands.
                            	  9898:     ;
                            	  9899:     ; Else draw the base and vertical hands mirrored.
                            	  9900:     ;
02:0003DE4E 0200000F        	  9901:     andi.b #$0F,D0
02:0003DE52 0C000002        	  9902:     cmpi.b  #$02,D0
02:0003DE56 670C            	  9903:     beq  _anon_z04_117
02:0003DE58 0C000003        	  9904:     cmpi.b  #$03,D0
02:0003DE5C 6706            	  9905:     beq  _anon_z04_117
