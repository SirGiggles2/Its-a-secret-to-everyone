02:0003180E 4A02            	  6034:     cmpi.b  #$00,D2
02:00031810 6722            	  6035:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00031812 0C02000D        	  6036:     cmpi.b  #$0D,D2
