                            	  7547:     even
                            	  7548: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7549:     ; If the "monsters from edges" long timer expired, then
                            	  7550:     ; go bring the monster in.
                            	  7551:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7552:     ;
                            	  7553:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7554:     ; residual position so enemies keep their previous-room
                            	  7555:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D57C 102C004B        	  7556:     move.b  ($004B,A4),D0
02:0004D580 662E            	  7557:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7558:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D582 102C000F        	  7559:     move.b  ($000F,A4),D0
02:0004D586 0C0000FF        	  7560:     cmpi.b  #$FF,D0
02:0004D58A 662E            	  7561:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D58C 41EC0070        	  7562:     lea     ($0070,A4),A0
02:0004D590 10302000        	  7563:     move.b  (A0,D2.W),D0
02:0004D594 660A            	  7564:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D596 41EC0084        	  7565:     lea     ($0084,A4),A0
02:0004D59A 10302000        	  7566:     move.b  (A0,D2.W),D0
02:0004D59E 671A            	  7567:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7568:     even
                            	  7569: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
