                            	  3950: FormatHeartsInTextBuf:
                            	  3951:     ; [$0E]: hearts value
                            	  3952:     ; [$0F]: heart partial
                            	  3953:     ; Y: The offset of first character in buffer
                            	  3954:     ;
                            	  3955:     ; The end of the bottom row is $12 bytes after the
                            	  3956:     ; start of the top row. We're writing to two transfer
                            	  3957:     ; records. We write the top row in the first transfer
                            	  3958:     ; record wherever the caller chooses. The second
                            	  3959:     ; transfer record has to begin with the heart tiles.
                            	  3960:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3961:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3962:     ;
                            	  3963:     ; Store the starting offset in [$0D].
02:000308B8 1943000D        	  3964:     move.b  D3,($000D,A4)
02:000308BC 102C000E        	  3965:     move.b  ($000E,A4),D0
02:000308C0 1B00            	  3966:     move.b  D0,-(A5)  ; PHA
02:000308C2 0200000F        	  3967:     andi.b #$0F,D0
02:000308C6 1880            	  3968:     move.b  D0,($0000,A4)
02:000308C8 700F            	  3969:     moveq   #15,D0
02:000308CA 003C0011        	  3970:     ori     #$11,CCR  ; SEC: set C+X
02:000308CE 1214            	  3971:     move.b  ($0000,A4),D1
02:000308D0 0A3C0010        	  3972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000308D4 9101            	  3973:     subx.b  D1,D0   ; SBC $00
02:000308D6 0A3C0010        	  3974:     eori    #$10,CCR  ; restore X = 6502 C
02:000308DA 1880            	  3975:     move.b  D0,($0000,A4)
02:000308DC 101D            	  3976:     move.b  (A5)+,D0  ; PLA
02:000308DE E208            	  3977:     lsr.b  #1,D0   ; LSR A
02:000308E0 E208            	  3978:     lsr.b  #1,D0   ; LSR A
02:000308E2 E208            	  3979:     lsr.b  #1,D0   ; LSR A
02:000308E4 E208            	  3980:     lsr.b  #1,D0   ; LSR A
02:000308E6 19400001        	  3981:     move.b  D0,($0001,A4)
02:000308EA 700F            	  3982:     moveq   #15,D0
02:000308EC 003C0011        	  3983:     ori     #$11,CCR  ; SEC: set C+X
02:000308F0 122C0001        	  3984:     move.b  ($0001,A4),D1
02:000308F4 0A3C0010        	  3985:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000308F8 9101            	  3986:     subx.b  D1,D0   ; SBC $01
02:000308FA 0A3C0010        	  3987:     eori    #$10,CCR  ; restore X = 6502 C
02:000308FE 19400001        	  3988:     move.b  D0,($0001,A4)
                            	  3989:     ; At this point,
                            	  3990:     ; [$00] = $F - hearts
                            	  3991:     ; [$01] = $F - heart containers
                            	  3992:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3993:     ;
                            	  3994:     ; Also, Y is still set to the value passed in.
                            	  3995:     ;
02:00030902 7400            	  3996:     moveq   #0,D2
02:00030904 1003            	  3997:     move.b  D3,D0
02:00030906 023C00EE        	  3998:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003090A 123C0007        	  3999:     move.b  #$07,D1
02:0003090E D101            	  4000:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030910 1940000B        	  4001:     move.b  D0,($000B,A4)
