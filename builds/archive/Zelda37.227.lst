                            	  2724: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2725:     ; If reversal count >= 2, then
                            	  2726:     ; 1. invert the horizontal component of facing direction,
                            	  2727:     ;    to face away from the chase target
                            	  2728:     ; 2. reset the reversal count to 0.
                            	  2729:     ;
                            	  2730:     ; This prevents a jumper from getting stuck in a corner.
                            	  2731:     ;
                            	  2732:     ; For example, if a tektite's direction is down and right,
                            	  2733:     ; and jumps into the top right corner of the room:
                            	  2734:     ; 1. The right room boundary is hit. So the direction is
                            	  2735:     ;    automatically reversed to up and left.
                            	  2736:     ; 2. The next frame, the top room boundary is hit.
                            	  2737:     ;    The direction is reversed to down and right.
                            	  2738:     ;
                            	  2739:     ; As you can see, an endless loop has been made.
                            	  2740:     ;
02:0003A9EE 41EC0451        	  2741:     lea     ($0451,A4),A0
02:0003A9F2 10302000        	  2742:     move.b  (A0,D2.W),D0
02:0003A9F6 0C000002        	  2743:     cmpi.b  #$02,D0
02:0003A9FA 651E            	  2744:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A9FC 41EC0098        	  2745:     lea     ($0098,A4),A0
02:0003AA00 10302000        	  2746:     move.b  (A0,D2.W),D0
02:0003AA04 0A000003        	  2747:     eori.b #$03,D0
02:0003AA08 41EC0098        	  2748:     lea     ($0098,A4),A0
02:0003AA0C 11802000        	  2749:     move.b  D0,(A0,D2.W)
02:0003AA10 7000            	  2750:     moveq   #0,D0
02:0003AA12 41EC0451        	  2751:     lea     ($0451,A4),A0
02:0003AA16 11802000        	  2752:     move.b  D0,(A0,D2.W)
                            	  2753:     even
                            	  2754: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2755:     ; If the object is a boulder, then make sure its facing direction
                            	  2756:     ; has a down vertical component.
                            	  2757:     ;
02:0003AA1A 610001F8        	  2758:     jsr     Jumper_PointBoulderDownward
                            	  2759:     ; For the given direction, get the Y offset of the destination
                            	  2760:     ; of the jump.
                            	  2761:     ;
                            	  2762:     ; Add it to the object's Y, and store this destination Y.
                            	  2763:     ;
