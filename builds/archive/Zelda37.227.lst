                            	   559: UpdateMenuStartOW:
                            	   560:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   561:     ; make it look completely empty, and no piece has been won.
                            	   562:     ;
02:000403DC 7617            	   563:     moveq   #23,D3
                            	   564: _anon_z05_6:
02:000403DE 7400            	   565:     moveq   #0,D2
02:000403E0 41F900040394    	   566:     lea     (TriforceTransferBufOffsets).l,A0
02:000403E6 14303000        	   567:     move.b  (A0,D3.W),D2
02:000403EA 41F9000403C4    	   568:     lea     (TriforceTransferBufTiles).l,A0
02:000403F0 10303000        	   569:     move.b  (A0,D3.W),D0
02:000403F4 41F900047674    	   570:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403FA 11802000        	   571:     move.b  D0,(A0,D2.W)
02:000403FE 5303            	   572:     subq.b  #1,D3
02:00040400 6ADC            	   573:     bpl  _anon_z05_6
                            	   574:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   575:     ;
02:00040402 5203            	   576:     addq.b  #1,D3
                            	   577:     ; Outer loop.
                            	   578:     ; A level test bit in [06] will be used to see whether
                            	   579:     ; we have a triforce piece.
                            	   580:     ;
02:00040404 7001            	   581:     moveq   #1,D0
02:00040406 19400006        	   582:     move.b  D0,($0006,A4)
                            	   583:     even
                            	   584: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   585:     ; Inner loop.
                            	   586:     ; Each level bit will make 3 triforce tile slots be
                            	   587:     ; checked and replaced.
                            	   588:     ;
02:0004040A 7003            	   589:     moveq   #3,D0
02:0004040C 19400007        	   590:     move.b  D0,($0007,A4)
                            	   591:     even
                            	   592: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   593:     ; Get the offset into the submenu triforce transfer buffers of
                            	   594:     ; the current tile slot.
                            	   595:     ;
02:00040410 7400            	   596:     moveq   #0,D2
02:00040412 41F900040394    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:00040418 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:0004041C 102C0006        	   605:     move.b  ($0006,A4),D0
02:00040420 122C0671        	   606:     move.b  ($0671,A4),D1
02:00040424 C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040426 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
                            	   615:     ; Else replace it with the one at the current triforce tile slot
                            	   616:     ; in the replacement list.
                            	   617:     ;
02:00040428 41F900047674    	   618:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004042E 10302000        	   619:     move.b  (A0,D2.W),D0
02:00040432 0C0000E5        	   620:     cmpi.b  #$E5,D0
02:00040436 6712            	   621:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040438 0C0000E6        	   622:     cmpi.b  #$E6,D0
02:0004043C 670C            	   623:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0004043E 41F9000403AC    	   624:     lea     (TriforceTriforceBufReplacements).l,A0
02:00040444 10303000        	   625:     move.b  (A0,D3.W),D0
02:00040448 6004            	   626:     jmp     _anon_z05_7
                            	   627: 
                            	   628:     even
                            	   629: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0004044A 103C00F5        	   630:     move.b  #$F5,D0
                            	   631: _anon_z05_7:
02:0004044E 41F900047674    	   632:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040454 11802000        	   633:     move.b  D0,(A0,D2.W)
                            	   634:     even
                            	   635: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   636:     ; Bottom of the inner loop.
                            	   637:     ;
                            	   638:     ; Increment the triforce tile slot.
                            	   639:     ; Decrement [07] and loop again, if it's not 0.
                            	   640:     ;
02:00040458 5203            	   641:     addq.b  #1,D3
02:0004045A 532C0007        	   642:     subq.b  #1,($0007,A4)
02:0004045E 66B0            	   643:     bne  _L_z05_UpdateMenuStartOW_LoopTile
