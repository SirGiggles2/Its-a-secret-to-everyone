02:00041EBA 12302000        	  3700:     move.b  (A0,D2.W),D1
02:00041EBE 0A3C0010        	  3701:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EC2 9101            	  3702:     subx.b  D1,D0   ; SBC ObjY,X
02:00041EC4 0A3C0010        	  3703:     eori    #$10,CCR  ; restore X = 6502 C
02:00041EC8 6030            	  3704:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3705: 
                            	  3706: _anon_z05_85:
                            	  3707:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3708:     ; between the ladder and Link.
                            	  3709:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3710:     ;
02:00041ECA 102C0084        	  3711:     move.b  ($0084,A4),D0
02:00041ECE 023C00EE        	  3712:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041ED2 123C0003        	  3713:     move.b  #$03,D1
02:00041ED6 D101            	  3714:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041ED8 41EC0084        	  3715:     lea     ($0084,A4),A0
02:00041EDC 12302000        	  3716:     move.b  (A0,D2.W),D1
02:00041EE0 B001            	  3717:     cmp.b   D1,D0
02:00041EE2 6648            	  3718:     bne  _L_z05_CheckLadder_StashLadder
02:00041EE4 102C0070        	  3719:     move.b  ($0070,A4),D0
02:00041EE8 003C0011        	  3720:     ori     #$11,CCR  ; SEC: set C+X
02:00041EEC 12342070        	  3721:     move.b  ($70,A4,D2.W),D1
02:00041EF0 0A3C0010        	  3722:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EF4 9101            	  3723:     subx.b  D1,D0   ; SBC ObjX,X
02:00041EF6 0A3C0010        	  3724:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3725:     even
                            	  3726: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3727:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3728:     ; If > $10, go put the ladder away.
                            	  3729:     ;
02:00041EFA 4EB900030BFC    	  3730:     jsr     Abs
02:00041F00 1880            	  3731:     move.b  D0,($0000,A4)
02:00041F02 0C000010        	  3732:     cmpi.b  #$10,D0
02:00041F06 6532            	  3733:     bcs  _L_z05_CheckLadder_SetState2
02:00041F08 0C000010        	  3734:     cmpi.b  #$10,D0
02:00041F0C 661E            	  3735:     bne  _L_z05_CheckLadder_StashLadder
                            	  3736:     ; Distance = $10. If player's not facing in the same direction as
                            	  3737:     ; the ladder, go put away the ladder.
                            	  3738:     ;
02:00041F0E 102C0098        	  3739:     move.b  ($0098,A4),D0
02:00041F12 41EC0098        	  3740:     lea     ($0098,A4),A0
02:00041F16 12302000        	  3741:     move.b  (A0,D2.W),D1
02:00041F1A B001            	  3742:     cmp.b   D1,D0
02:00041F1C 660E            	  3743:     bne  _L_z05_CheckLadder_StashLadder
                            	  3744:     ; Distance = $10, and player's facing in the same direction.
                            	  3745:     ;
                            	  3746:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3747:     ; ladder and had not stepped onto it yet.
                            	  3748:     ; Go handle movement on it, but don't change state yet.
                            	  3749:     ;
                            	  3750:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3751:     ; off of the ladder. So the ladder should be put away. In this
                            	  3752:     ; case, fall thru.
                            	  3753:     ;
02:00041F1E 41EC00AC        	  3754:     lea     ($00AC,A4),A0
02:00041F22 10302000        	  3755:     move.b  (A0,D2.W),D0
02:00041F26 0C000001        	  3756:     cmpi.b  #$01,D0
02:00041F2A 6718            	  3757:     beq  _L_z05_CheckLadder_HandleInput
                            	  3758:     even
                            	  3759: _L_z05_CheckLadder_StashLadder:
                            	  3760:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3761:     ;
02:00041F2C 7000            	  3762:     moveq   #0,D0
02:00041F2E 19400064        	  3763:     move.b  D0,($0064,A4)
02:00041F32 4EB90004D966    	  3764:     jsr     DestroyMonster
                            	  3765:     even
                            	  3766: _L_z05_CheckLadder_Exit:
02:00041F38 4E75            	  3767:     rts
                            	  3768: 
                            	  3769:     even
                            	  3770: _L_z05_CheckLadder_SetState2:
                            	  3771:     ;  Set state 2, because we're on the ladder.
                            	  3772:     ;
02:00041F3A 7002            	  3773:     moveq   #2,D0
02:00041F3C 41EC00AC        	  3774:     lea     ($00AC,A4),A0
02:00041F40 11802000        	  3775:     move.b  D0,(A0,D2.W)
                            	  3776:     even
                            	  3777: _L_z05_CheckLadder_HandleInput:
                            	  3778:     ; If input direction = 0, go draw and reset moving direction.
                            	  3779:     ;
02:00041F44 102C03F8        	  3780:     move.b  ($03F8,A4),D0
02:00041F48 67000086        	  3781:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3782:     ; Input direction <> 0. The player intends to move.
                            	  3783:     ; So, see if we need to override the moving direction.
                            	  3784:     ;
                            	  3785:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3786:     ; go draw and set moving direction to Link's direction.
                            	  3787:     ;
                            	  3788:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3789:     ; been blocked by the water.
                            	  3790:     ;
                            	  3791:     ; Or, Link already passed over the point right over the ladder
                            	  3792:     ; and was allowed to move onto the tiles after the ladder.
                            	  3793:     ;
02:00041F4C 102C0098        	  3794:     move.b  ($0098,A4),D0
02:00041F50 7600            	  3795:     moveq   #0,D3
02:00041F52 1614            	  3796:     move.b  ($0000,A4),D3
02:00041F54 670C            	  3797:     beq  _anon_z05_86
02:00041F56 41EC0098        	  3798:     lea     ($0098,A4),A0
02:00041F5A 12302000        	  3799:     move.b  (A0,D2.W),D1
02:00041F5E B001            	  3800:     cmp.b   D1,D0
02:00041F60 676E            	  3801:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3802: _anon_z05_86:
                            	  3803:     ; Distance = 0, or facing different directions.
                            	  3804:     ;
                            	  3805:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3806:     ; then go draw and keep moving.
                            	  3807:     ;
                            	  3808:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3809:     ;
                            	  3810:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3811:     ; to move onto the tiles after the ladder.
                            	  3812:     ;
                            	  3813:     ; Note that if Link is not moving, then this test will fail,
                            	  3814:     ; and case (D) will catch it.
                            	  3815:     ;
02:00041F62 41EC0098        	  3816:     lea     ($0098,A4),A0
02:00041F66 10302000        	  3817:     move.b  (A0,D2.W),D0
02:00041F6A 122C000F        	  3818:     move.b  ($000F,A4),D1
02:00041F6E B001            	  3819:     cmp.b   D1,D0
02:00041F70 675E            	  3820:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3821:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3822:     ; then go draw and move in ladder's direction.
                            	  3823:     ;
                            	  3824:     ; You can always step off the ladder where you came from.
                            	  3825:     ;
02:00041F72 4EB900030BF8    	  3826:     jsr     GetOppositeDir
02:00041F78 122C0098        	  3827:     move.b  ($0098,A4),D1
02:00041F7C B001            	  3828:     cmp.b   D1,D0
02:00041F7E 6750            	  3829:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3830:     ; D. If opposite of ladder's direction <> down,
                            	  3831:     ; or input direction <> up,
                            	  3832:     ; then go reset moving direction, and draw.
                            	  3833:     ;
                            	  3834:     ; This will catch all cases of Link facing perpendicular to
                            	  3835:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3836:     ; ladder direction is up and input direction is up (E).
                            	  3837:     ;
02:00041F80 0C000004        	  3838:     cmpi.b  #$04,D0
02:00041F84 6648            	  3839:     bne  _anon_z05_87
02:00041F86 102C03F8        	  3840:     move.b  ($03F8,A4),D0
02:00041F8A 0C000008        	  3841:     cmpi.b  #$08,D0
02:00041F8E 663E            	  3842:     bne  _anon_z05_87
                            	  3843:     ; E. The ladder's direction is up and input direction is up.
                            	  3844:     ;
                            	  3845:     ; An earlier call to check tile collision would have blocked
                            	  3846:     ; movement, because the tile under Link's top half is a water tile.
                            	  3847:     ; But because Link is squarely on the ladder, we really have
                            	  3848:     ; to check the tile above that one.
                            	  3849:     ;
                            	  3850:     ; Set moving direction to input direction (up) and switch X to
                            	  3851:     ; the player's slot for the purpose of checking tile collision below.
                            	  3852:     ; Based on that, we'll set moving direction according to walkability.
                            	  3853:     ;
02:00041F90 6158            	  3854:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3855:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3856:     ;
02:00041F92 102C0084        	  3857:     move.b  ($0084,A4),D0
02:00041F96 1B00            	  3858:     move.b  D0,-(A5)  ; PHA
02:00041F98 003C0011        	  3859:     ori     #$11,CCR  ; SEC: set C+X
02:00041F9C 123C0008        	  3860:     move.b  #$08,D1
02:00041FA0 0A3C0010        	  3861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041FA4 9101            	  3862:     subx.b  D1,D0   ; SBC #$08
02:00041FA6 0A3C0010        	  3863:     eori    #$10,CCR  ; restore X = 6502 C
02:00041FAA 19400084        	  3864:     move.b  D0,($0084,A4)
02:00041FAE 4EB90004B8DE    	  3865:     jsr     GetCollidingTileMoving
02:00041FB4 101D            	  3866:     move.b  (A5)+,D0  ; PLA
02:00041FB6 19400084        	  3867:     move.b  D0,($0084,A4)
                            	  3868:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3869:     ; direction as the input direction (in a roundabout way).
                            	  3870:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3871:     ;
02:00041FBA 102C000F        	  3872:     move.b  ($000F,A4),D0
02:00041FBE 7600            	  3873:     moveq   #0,D3
02:00041FC0 162C049E        	  3874:     move.b  ($049E,A4),D3
02:00041FC4 122C034A        	  3875:     move.b  ($034A,A4),D1
02:00041FC8 B601            	  3876:     cmp.b   D1,D3
02:00041FCA 6500FF78        	  3877:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3878: _anon_z05_87:
                            	  3879:     ; Set A to reset moving direction in [0F].
                            	  3880:     ;
02:00041FCE 7000            	  3881:     moveq   #0,D0
                            	  3882:     even
                            	  3883: _L_z05_CheckLadder_DrawLadder:
                            	  3884:     ; Draw the ladder.
                            	  3885:     ;
02:00041FD0 1B00            	  3886:     move.b  D0,-(A5)  ; PHA
02:00041FD2 7400            	  3887:     moveq   #0,D2
02:00041FD4 142C0064        	  3888:     move.b  ($0064,A4),D2
02:00041FD8 4EB90004D182    	  3889:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041FDE 760C            	  3890:     moveq   #12,D3
02:00041FE0 7000            	  3891:     moveq   #0,D0
02:00041FE2 4EB90003197E    	  3892:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041FE8 101D            	  3893:     move.b  (A5)+,D0  ; PLA
                            	  3894: ; Params:
                            	  3895: ; A: direction
                            	  3896: ;
                            	  3897: ; Returns:
                            	  3898: ; [0F]: direction
                            	  3899: ;
                            	  3900:     even
                            	  3901: SetMovingDirAndSwitchToPlayerSlot:
02:00041FEA 4EF90002C048    	  3902:     jmp     c_set_moving_dir_switch_player
                            	  3903: 
                            	  3904: FindNextEdgeSpawnCell:
                            	  3905:     ; Load [0A] with the value before the call.
                            	  3906:     ;
02:00041FF0 102C0525        	  3907:     move.b  ($0525,A4),D0
02:00041FF4 1940000A        	  3908:     move.b  D0,($000A,A4)
                            	  3909:     even
                            	  3910: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3911:     ; Loop to look for a place to spawn a monster from the edge
                            	  3912:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3913:     ;
                            	  3914:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3915:     ; We'll move down $10 pixels.
                            	  3916:     ;
02:00041FF8 7610            	  3917:     moveq   #16,D3
02:00041FFA 102C000A        	  3918:     move.b  ($000A,A4),D0
02:00041FFE 0200000F        	  3919:     andi.b #$0F,D0
02:00042002 670A            	  3920:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3921:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3922:     ; Don't move vertically.
                            	  3923:     ;
02:00042004 163C00F0        	  3924:     move.b  #$F0,D3
02:00042008 0C00000F        	  3925:     cmpi.b  #$0F,D0
02:0004200C 6610            	  3926:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3927:     even
                            	  3928: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3929:     ; Else low nibble = $F. We're at the right edge,
                            	  3930:     ; and we'll move up $10 pixels.
                            	  3931:     ;
02:0004200E 1003            	  3932:     move.b  D3,D0
02:00042010 023C00EE        	  3933:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042014 122C000A        	  3934:     move.b  ($000A,A4),D1
02:00042018 D101            	  3935:     addx.b  D1,D0   ; ADC $0A
02:0004201A 1940000A        	  3936:     move.b  D0,($000A,A4)
                            	  3937:     even
                            	  3938: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3939:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3940:     ; Move right one pixel.
                            	  3941:     ;
02:0004201E 102C000A        	  3942:     move.b  ($000A,A4),D0
02:00042022 020000F0        	  3943:     andi.b #$F0,D0
02:00042026 0C0000E0        	  3944:     cmpi.b  #$E0,D0
02:0004202A 6606            	  3945:     bne  _anon_z05_88
02:0004202C 522C000A        	  3946:     addq.b  #1,($000A,A4)
02:00042030 600A            	  3947:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3948: 
                            	  3949: _anon_z05_88:
                            	  3950:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3951:     ; Dont' move horizontally.
                            	  3952:     ;
02:00042032 0C000040        	  3953:     cmpi.b  #$40,D0
02:00042036 6604            	  3954:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3955:     ; Else high nibble = 4. We're at the top edge.
                            	  3956:     ; Move left 1 pixel.
                            	  3957:     ;
02:00042038 532C000A        	  3958:     subq.b  #1,($000A,A4)
                            	  3959:     even
                            	  3960: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3961:     ; Time to get the address of the column.
                            	  3962:     ; Starting at the top of the leftmost column.
                            	  3963:     ;
02:0004203C 6100268E        	  3964:     jsr     FetchTileMapAddr
02:00042040 7005            	  3965:     moveq   #5,D0
02:00042042 4EB90002A9FA    	  3966:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3967:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3968:     ; in order to point to the column we want.
                            	  3969:     ;
02:00042048 102C000A        	  3970:     move.b  ($000A,A4),D0
02:0004204C 0200000F        	  3971:     andi.b #$0F,D0
02:00042050 7600            	  3972:     moveq   #0,D3
02:00042052 1600            	  3973:     move.b  D0,D3
02:00042054 670C            	  3974:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3975: _anon_z05_89:
02:00042056 702C            	  3976:     moveq   #44,D0
02:00042058 4EB90003104E    	  3977:     jsr     AddToInt16At0
02:0004205E 5303            	  3978:     subq.b  #1,D3
02:00042060 66F4            	  3979:     bne  _anon_z05_89
                            	  3980:     even
                            	  3981: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3982:     ; Turn the row part of [0A] into a tile index.
                            	  3983:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3984:     ;
02:00042062 102C000A        	  3985:     move.b  ($000A,A4),D0
02:00042066 020000F0        	  3986:     andi.b #$F0,D0
02:0004206A 003C0011        	  3987:     ori     #$11,CCR  ; SEC: set C+X
02:0004206E 123C0040        	  3988:     move.b  #$40,D1
02:00042072 0A3C0010        	  3989:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042076 9101            	  3990:     subx.b  D1,D0   ; SBC #$40
02:00042078 0A3C0010        	  3991:     eori    #$10,CCR  ; restore X = 6502 C
02:0004207C E208            	  3992:     lsr.b  #1,D0   ; LSR A
02:0004207E E208            	  3993:     lsr.b  #1,D0   ; LSR A
02:00042080 E208            	  3994:     lsr.b  #1,D0   ; LSR A
02:00042082 7600            	  3995:     moveq   #0,D3
02:00042084 1600            	  3996:     move.b  D0,D3
                            	  3997:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3998:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3999:     ; when coming in from the edges.
                            	  4000:     ;
02:00042086 1214            	  4001:     move.b  ($00,A4),D1   ; ptr lo
02:00042088 182C0001        	  4002:     move.b  ($01,A4),D4  ; ptr hi
02:0004208C 024100FF        	  4003:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042090 E14C            	  4004:     lsl.w   #8,D4
02:00042092 8841            	  4005:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042094 48C4            	  4006:     ext.l   D4
02:00042096 D8BC00FF0000    	  4007:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004209C 2044            	  4008:     movea.l D4,A0
02:0004209E 10303000        	  4009:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000420A2 0C000084        	  4010:     cmpi.b  #$84,D0
02:000420A6 650E            	  4011:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  4012:     ; Bottom of the loop.
                            	  4013:     ; If you reach the original cell, then stop.
                            	  4014:     ;
02:000420A8 102C000A        	  4015:     move.b  ($000A,A4),D0
02:000420AC 122C0525        	  4016:     move.b  ($0525,A4),D1
02:000420B0 B001            	  4017:     cmp.b   D1,D0
02:000420B2 6600FF44        	  4018:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  4019:     even
                            	  4020: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  4021:     ; Set the spawn cell to the one we found.
                            	  4022:     ;
02:000420B6 102C000A        	  4023:     move.b  ($000A,A4),D0
02:000420BA 19400525        	  4024:     move.b  D0,($0525,A4)
02:000420BE 4E75            	  4025:     rts
                            	  4026: 
                            	  4027:     even
                            	  4028: InitModeB:
02:000420C0 102C0013        	  4029:     move.b  ($0013,A4),D0
02:000420C4 4EB90002AECA    	  4030:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
