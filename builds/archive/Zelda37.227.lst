02:0003C610 7006            	  6592:     moveq   #6,D0
02:0003C612 4EB90004D17C    	  6593:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  6594:     ; If this is a child digdogger, then go draw it.
                            	  6595:     ;
02:0003C618 41EC046B        	  6596:     lea     ($046B,A4),A0
02:0003C61C 10302000        	  6597:     move.b  (A0,D2.W),D0
02:0003C620 666C            	  6598:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  6599:     ; For each part of the big digdogger, from 0 to 3,
                            	  6600:     ; indexed by Y register:
