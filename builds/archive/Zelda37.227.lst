02:0003042E 7078            	  3243:     moveq   #120,D0
02:00030430 1880            	  3244:     move.b  D0,($0000,A4)
02:00030432 41EC0098        	  3245:     lea     ($0098,A4),A0
02:00030436 10302000        	  3246:     move.b  (A0,D2.W),D0
02:0003043A 0200000C        	  3247:     andi.b #$0C,D0
