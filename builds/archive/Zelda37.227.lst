02:0003A466 0200000F        	  1850:     andi.b #$0F,D0
02:0003A46A 023C00EE        	  1851:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A46E 6608            	  1852:     bne  _L_z04_Gel_MoveSplitting_Exit
