                            	  1793:     ; There's more than one way to enter a room.
                            	  1794:     ;
                            	  1795:     ; 1: Out of a cave, dungeon, or cellar
                            	  1796:     ;     a. Walking exit
                            	  1797:     ;     b. Next to stairs
                            	  1798:     ; 2: Room to room
                            	  1799:     ;
                            	  1800:     ; Determine which one we need.
                            	  1801:     ;
