                            	  4220: ; Player coordinate must be >= these bounds.
                            	  4221: ; Using these bounds; the player will be considered within the
                            	  4222: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4223: ;
                            	  4224:     even
