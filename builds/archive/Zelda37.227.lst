                            	 10113: _L_z04_UpdateGohma_AnimateClosedEye:
                            	 10114:     ; Here the eye is closed. So animate it this way.
                            	 10115:     ; Increment the animation counter, and if <> 8, then
                            	 10116:     ; go shoot, draw, and check collisions.
                            	 10117:     ;
02:0003DFF0 41EC0478        	 10118:     lea     ($0478,A4),A0
