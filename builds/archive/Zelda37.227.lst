02:0003E786 102C04D7        	 11154:     move.b  ($04D7,A4),D0
02:0003E78A 023C00EE        	 11155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E78E 123C0007        	 11156:     move.b  #$07,D1
02:0003E792 D101            	 11157:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E794 7400            	 11158:     moveq   #0,D2
02:0003E796 1400            	 11159:     move.b  D0,D2
                            	 11160:     ; Flag it uninitialized, so that it will be initialized next frame.
