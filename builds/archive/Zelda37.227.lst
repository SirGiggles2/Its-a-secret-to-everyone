02:0004CD48 E208            	  6512:     lsr.b  #1,D0   ; LSR A
02:0004CD4A E208            	  6513:     lsr.b  #1,D0   ; LSR A
02:0004CD4C E208            	  6514:     lsr.b  #1,D0   ; LSR A
02:0004CD4E E208            	  6515:     lsr.b  #1,D0   ; LSR A
02:0004CD50 1214            	  6516:     move.b  ($0000,A4),D1
02:0004CD52 B001            	  6517:     cmp.b   D1,D0
