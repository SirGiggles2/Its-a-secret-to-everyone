                            	 10006: _anon_z04_121:
                            	 10007:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10008:     ;
02:0003DF2A 41EC0412        	 10009:     lea     ($0412,A4),A0
02:0003DF2E 10302000        	 10010:     move.b  (A0,D2.W),D0
