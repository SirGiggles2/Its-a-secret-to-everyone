                            	  7991: UpdatePolsVoiceState1_Jumping:
                            	  7992:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7993:     ;
02:0003CFE4 41EC0444        	  7994:     lea     ($0444,A4),A0
02:0003CFE8 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003CFEC 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFF0 123C0038        	  7997:     move.b  #$38,D1
02:0003CFF4 D101            	  7998:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFF6 41EC0444        	  7999:     lea     ($0444,A4),A0
02:0003CFFA 11802000        	  8000:     move.b  D0,(A0,D2.W)
                            	  8001:     ; Add Carry to high speed byte (vertical).
                            	  8002:     ;
02:0003CFFE 41EC0412        	  8003:     lea     ($0412,A4),A0
02:0003D002 10302000        	  8004:     move.b  (A0,D2.W),D0
02:0003D006 123C0000        	  8005:     move.b  #$00,D1
02:0003D00A D101            	  8006:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D00C 41EC0412        	  8007:     lea     ($0412,A4),A0
02:0003D010 11802000        	  8008:     move.b  D0,(A0,D2.W)
                            	  8009:     ; Add high speed byte to Y coordinate.
                            	  8010:     ;
02:0003D014 023C00EE        	  8011:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D018 41EC0084        	  8012:     lea     ($0084,A4),A0
02:0003D01C 12302000        	  8013:     move.b  (A0,D2.W),D1
02:0003D020 D101            	  8014:     addx.b  D1,D0   ; ADC ObjY,X
02:0003D022 41EC0084        	  8015:     lea     ($0084,A4),A0
02:0003D026 11802000        	  8016:     move.b  D0,(A0,D2.W)
                            	  8017:     ; If the speed is still negative, then return.
                            	  8018:     ;
02:0003D02A 41EC0412        	  8019:     lea     ($0412,A4),A0
02:0003D02E 10302000        	  8020:     move.b  (A0,D2.W),D0
02:0003D032 6B0000AC        	  8021:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8022:     ; If Y coordinate still < target Y, then return.
                            	  8023:     ;
02:0003D036 41EC0084        	  8024:     lea     ($0084,A4),A0
02:0003D03A 10302000        	  8025:     move.b  (A0,D2.W),D0
02:0003D03E 41EC042C        	  8026:     lea     ($042C,A4),A0
02:0003D042 12302000        	  8027:     move.b  (A0,D2.W),D1
02:0003D046 B001            	  8028:     cmp.b   D1,D0
02:0003D048 65000096        	  8029:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8030:     ; Else reached the destination. Go to state 0.
                            	  8031:     ;
02:0003D04C 7000            	  8032:     moveq   #0,D0
02:0003D04E 41EC00AC        	  8033:     lea     ($00AC,A4),A0
02:0003D052 11802000        	  8034:     move.b  D0,(A0,D2.W)
                            	  8035:     ; Reset 16-bit vertical speed.
                            	  8036:     ;
02:0003D056 41EC0444        	  8037:     lea     ($0444,A4),A0
02:0003D05A 11802000        	  8038:     move.b  D0,(A0,D2.W)
02:0003D05E 41EC0412        	  8039:     lea     ($0412,A4),A0
02:0003D062 11802000        	  8040:     move.b  D0,(A0,D2.W)
                            	  8041:     ; Choose a random direction to face in.
                            	  8042:     ;
02:0003D066 10342018        	  8043:     move.b  ($18,A4,D2.W),D0
02:0003D06A 02000003        	  8044:     andi.b #$03,D0
02:0003D06E 7600            	  8045:     moveq   #0,D3
02:0003D070 1600            	  8046:     move.b  D0,D3
02:0003D072 41F90003CE82    	  8047:     lea     (PolsVoiceDirections).l,A0
02:0003D078 10303000        	  8048:     move.b  (A0,D3.W),D0
02:0003D07C 41EC0098        	  8049:     lea     ($0098,A4),A0
02:0003D080 11802000        	  8050:     move.b  D0,(A0,D2.W)
                            	  8051:     ; Randomly set distance-to-move to $30 or $70.
                            	  8052:     ;
02:0003D084 10342018        	  8053:     move.b  ($18,A4,D2.W),D0
02:0003D088 02000040        	  8054:     andi.b #$40,D0
02:0003D08C 123C0030        	  8055:     move.b  #$30,D1
02:0003D090 D101            	  8056:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D092 41EC0394        	  8057:     lea     ($0394,A4),A0
02:0003D096 11802000        	  8058:     move.b  D0,(A0,D2.W)
                            	  8059:     ; Align the monster with a square horizontally.
                            	  8060:     ;
                            	  8061:     ; If in the left half of a square, align with that square.
                            	  8062:     ; If in the right half, align with the next square.
                            	  8063:     ;
02:0003D09A 10342070        	  8064:     move.b  ($70,A4,D2.W),D0
02:0003D09E 023C00EE        	  8065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0A2 123C0008        	  8066:     move.b  #$08,D1
02:0003D0A6 D101            	  8067:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D0A8 020000F0        	  8068:     andi.b #$F0,D0
02:0003D0AC 19802070        	  8069:     move.b  D0,($70,A4,D2.W)
                            	  8070:     ; Align the monster with a square vertically.
                            	  8071:     ;
                            	  8072:     ; If in the top half of a square, align with that square.
                            	  8073:     ; If in the bottom half, align with the next square.
                            	  8074:     ;
02:0003D0B0 41EC0084        	  8075:     lea     ($0084,A4),A0
02:0003D0B4 10302000        	  8076:     move.b  (A0,D2.W),D0
02:0003D0B8 023C00EE        	  8077:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0BC 123C0008        	  8078:     move.b  #$08,D1
02:0003D0C0 D101            	  8079:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D0C2 020000F0        	  8080:     andi.b #$F0,D0
                            	  8081:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8082:     ;
02:0003D0C6 003C0011        	  8083:     ori     #$11,CCR  ; SEC: set C+X
02:0003D0CA 123C0003        	  8084:     move.b  #$03,D1
02:0003D0CE 0A3C0010        	  8085:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D0D2 9101            	  8086:     subx.b  D1,D0   ; SBC #$03
02:0003D0D4 0A3C0010        	  8087:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D0D8 41EC0084        	  8088:     lea     ($0084,A4),A0
02:0003D0DC 11802000        	  8089:     move.b  D0,(A0,D2.W)
                            	  8090:     even
                            	  8091: _L_z04_UpdatePolsVoiceState1_Jumping_Exit:
02:0003D0E0 4E75            	  8092:     rts
                            	  8093: 
