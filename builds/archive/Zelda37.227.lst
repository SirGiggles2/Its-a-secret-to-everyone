                            	  2353: _L_z04__TryShooting_TryShootingNow:
                            	  2354:     ; Summary
                            	  2355:     ;
                            	  2356:     ; if temporarily invincible then
                            	  2357:     ;   shoot timer := 0
                            	  2358:     ; elif shoot timer > 0 then
                            	  2359:     ;   decrement shoot timer
                            	  2360:     ; elif wants to shoot then
                            	  2361:     ;   shoot timer := $30
                            	  2362:     ;
                            	  2363:     ; qspeed := [01]
                            	  2364:     ;
                            	  2365:     ; if shoot timer <> 0 then
                            	  2366:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2367:     ;     shoot
                            	  2368:     ;     if succeeded then
                            	  2369:     ;       shoot timer := 0
                            	  2370:     ;       qspeed := 0
                            	  2371:     ;   else
                            	  2372:     ;     qspeed := 0
                            	  2373:     ;
                            	  2374:     ; Push a 0 q-speed, in case the monster is in shooting time.
