                            	 10139: GohmaLegOffsetsX:
02:0003E022 F0              	 10140:     dc.b    $F0, $10
02:0003E023 10
                            	 10141: 
                            	 10142: ; Params:
                            	 10143: ; A: eye frame image
                            	 10144: ;
                            	 10145: ; Draw the eye with the frame image passed in.
                            	 10146: ;
                            	 10147:     even
                            	 10148: Gohma_AnimateAndDraw:
02:0003E024 1B00            	 10149:     move.b  D0,-(A5)  ; PHA
02:0003E026 4EB90004D182    	 10150:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003E02C 6164            	 10151:     jsr     Gohma_SetSpriteAttributes
02:0003E02E 101D            	 10152:     move.b  (A5)+,D0  ; PLA
02:0003E030 4EB900031776    	 10153:     jsr     DrawObjectMirrored
02:0003E036 7010            	 10154:     moveq   #16,D0
02:0003E038 4EB90004D17C    	 10155:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10156:     ; Draw the right legs.
                            	 10157:     ;
02:0003E03E 7601            	 10158:     moveq   #1,D3
02:0003E040 6102            	 10159:     jsr     Gohma_DrawLegsOneSide
                            	 10160:     ; Draw the left legs.
                            	 10161:     ;
02:0003E042 7600            	 10162:     moveq   #0,D3
                            	 10163: ; Params:
                            	 10164: ; Y: side: 0 for left, 1 for right
                            	 10165: ;
                            	 10166: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10167: ; store the sprite's X in [00].
                            	 10168: ;
                            	 10169:     even
                            	 10170: Gohma_DrawLegsOneSide:
02:0003E044 10342070        	 10171:     move.b  ($70,A4,D2.W),D0
02:0003E048 023C00EE        	 10172:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E04C 41F90003E022    	 10173:     lea     (GohmaLegOffsetsX).l,A0
02:0003E052 12303000        	 10174:     move.b  (A0,D3.W),D1
02:0003E056 D101            	 10175:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E058 1880            	 10176:     move.b  D0,($0000,A4)
                            	 10177:     ; The object's Y is the sprite's.
                            	 10178:     ;
02:0003E05A 41EC0084        	 10179:     lea     ($0084,A4),A0
02:0003E05E 10302000        	 10180:     move.b  (A0,D2.W),D0
02:0003E062 19400001        	 10181:     move.b  D0,($0001,A4)
02:0003E066 612A            	 10182:     jsr     Gohma_SetSpriteAttributes
                            	 10183:     ; There are only two frame images for legs: left and right.
                            	 10184:     ; There are two animation frames. They are animated as follows:
                            	 10185:     ;
                            	 10186:     ; Frame 0:
                            	 10187:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10188:     ; horizontal flipping = frame number = 0
                            	 10189:     ; 
                            	 10190:     ; Frame 1:
                            	 10191:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10192:     ; horizontal flipping = frame number = 1
                            	 10193:     ;
02:0003E068 4EB90004D154    	 10194:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E06E 1003            	 10195:     move.b  D3,D0
02:0003E070 023C00EE        	 10196:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E074 41EC03E4        	 10197:     lea     ($03E4,A4),A0
02:0003E078 12302000        	 10198:     move.b  (A0,D2.W),D1
02:0003E07C D101            	 10199:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E07E 02000001        	 10200:     andi.b #$01,D0
02:0003E082 023C00EE        	 10201:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E086 123C0004        	 10202:     move.b  #$04,D1
02:0003E08A D101            	 10203:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E08C 4EF90003177A    	 10204:     jmp     DrawObjectNotMirrored
                            	 10205: 
                            	 10206: ; Returns:
                            	 10207: ; [04]: left side sprite attributes
                            	 10208: ; [05]: right side sprite attributes
                            	 10209: ;
                            	 10210:     even
                            	 10211: Gohma_SetSpriteAttributes:
02:0003E092 4EF90002BF4C    	 10212:     jmp     c_gohma_set_sprite_attributes
