                            	  9921:     ;   Else:   down
                            	  9922:     ;
02:0003DE74 7001            	  9923:     moveq   #1,D0
02:0003DE76 7600            	  9924:     moveq   #0,D3
02:0003DE78 16342018        	  9925:     move.b  ($18,A4,D2.W),D3
02:0003DE7C 0C0300B0        	  9926:     cmpi.b  #$B0,D3
02:0003DE80 640A            	  9927:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE82 E308            	  9928:     lsl.b  #1,D0   ; ASL A
02:0003DE84 0C030060        	  9929:     cmpi.b  #$60,D3
02:0003DE88 6402            	  9930:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE8A E308            	  9931:     lsl.b  #1,D0   ; ASL A
