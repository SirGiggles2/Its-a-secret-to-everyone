                            	 13111: Ganon_DrawBody:
                            	 13112:     ; Loop over four 16x16 images that make up Ganon.
                            	 13113:     ; There are 6 animation frames.
                            	 13114:     ;
02:0003F5C4 7603            	 13115:     moveq   #3,D3
                            	 13116:     even
                            	 13117: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13118:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13119:     ;
02:0003F5C6 10342070        	 13120:     move.b  ($70,A4,D2.W),D0
02:0003F5CA 023C00EE        	 13121:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5CE 41F90003F5B8    	 13122:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F5D4 12303000        	 13123:     move.b  (A0,D3.W),D1
02:0003F5D8 D101            	 13124:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F5DA 1880            	 13125:     move.b  D0,($0000,A4)
                            	 13126:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13127:     ;
02:0003F5DC 41EC0084        	 13128:     lea     ($0084,A4),A0
02:0003F5E0 10302000        	 13129:     move.b  (A0,D2.W),D0
02:0003F5E4 023C00EE        	 13130:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5E8 41F90003F5BC    	 13131:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F5EE 12303000        	 13132:     move.b  (A0,D3.W),D1
02:0003F5F2 D101            	 13133:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F5F4 19400001        	 13134:     move.b  D0,($0001,A4)
                            	 13135:     ; Each part has a horizontal flipping flag.
                            	 13136:     ;
02:0003F5F8 41F90003F5C0    	 13137:     lea     (GanonSpriteHFlips).l,A0
02:0003F5FE 10303000        	 13138:     move.b  (A0,D3.W),D0
02:0003F602 1940000F        	 13139:     move.b  D0,($000F,A4)
                            	 13140:     ; Save and copy the loop index (the current part) to [07].
                            	 13141:     ;
02:0003F606 1003            	 13142:     move.b  D3,D0
02:0003F608 1B00            	 13143:     move.b  D0,-(A5)  ; PHA
02:0003F60A 19400007        	 13144:     move.b  D0,($0007,A4)
                            	 13145:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13146:     ; that make it up.
                            	 13147:     ;
02:0003F60E 41EC046B        	 13148:     lea     ($046B,A4),A0
02:0003F612 10302000        	 13149:     move.b  (A0,D2.W),D0
02:0003F616 E308            	 13150:     lsl.b  #1,D0   ; ASL A
02:0003F618 E308            	 13151:     lsl.b  #1,D0   ; ASL A
                            	 13152:     ; Add [07] -- the index of the current part.
                            	 13153:     ;
                            	 13154:     ; Now you have an index into the frame image table, for the
                            	 13155:     ; current image part of the current animation frame.
                            	 13156:     ;
02:0003F61A 122C0007        	 13157:     move.b  ($0007,A4),D1
02:0003F61E D101            	 13158:     addx.b  D1,D0   ; ADC $07
02:0003F620 7600            	 13159:     moveq   #0,D3
02:0003F622 1600            	 13160:     move.b  D0,D3
02:0003F624 41F90003F5A0    	 13161:     lea     (GanonFrameImages).l,A0
02:0003F62A 10303000        	 13162:     move.b  (A0,D3.W),D0
02:0003F62E 4EB90003177A    	 13163:     jsr     DrawObjectNotMirrored
02:0003F634 101D            	 13164:     move.b  (A5)+,D0  ; PLA
                            	 13165:     ; Bottom of the part loop.
                            	 13166:     ;
02:0003F636 7600            	 13167:     moveq   #0,D3
02:0003F638 1600            	 13168:     move.b  D0,D3
02:0003F63A 5303            	 13169:     subq.b  #1,D3
02:0003F63C 6A88            	 13170:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F63E 4E75            	 13171:     rts
