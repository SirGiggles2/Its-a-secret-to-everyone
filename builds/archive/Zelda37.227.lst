                            	  6728: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6729:     ; Link and the shot are facing opposite directions.
                            	  6730:     ; Link can parry certain weapons/shots.
                            	  6731:     ;
                            	  6732:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6733:     ; no harmful collision; but it still counts as a shot collision.
                            	  6734:     ; So, go treat this as a parry.
                            	  6735:     ;
02:00031D44 41EC034F        	  6736:     lea     ($034F,A4),A0
02:00031D48 10302000        	  6737:     move.b  (A0,D2.W),D0
02:00031D4C 0C000055        	  6738:     cmpi.b  #$55,D0
02:00031D50 650E            	  6739:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031D52 0C00005B        	  6740:     cmpi.b  #$5B,D0
02:00031D56 6408            	  6741:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6742:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6743:     ; So, go harm Link.
                            	  6744:     ;
02:00031D58 102C0676        	  6745:     move.b  ($0676,A4),D0
02:00031D5C 6602            	  6746:     bne.s  __far_z_01_0070
02:00031D5E 600E            	  6747:     jmp  HarmLink
                            	  6748: __far_z_01_0070:
                            	  6749:     even
