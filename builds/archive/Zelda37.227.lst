                            	 13174: Ganon_CheckCollisions:
                            	 13175:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13176:     ; Store in [02] and [03].
                            	 13177:     ;
02:0003F640 10342070        	 13178:     move.b  ($70,A4,D2.W),D0
02:0003F644 023C00EE        	 13179:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F648 123C0010        	 13180:     move.b  #$10,D1
02:0003F64C D101            	 13181:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F64E 19400002        	 13182:     move.b  D0,($0002,A4)
02:0003F652 41EC0084        	 13183:     lea     ($0084,A4),A0
02:0003F656 10302000        	 13184:     move.b  (A0,D2.W),D0
02:0003F65A 023C00EE        	 13185:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F65E 123C0010        	 13186:     move.b  #$10,D1
02:0003F662 D101            	 13187:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F664 19400003        	 13188:     move.b  D0,($0003,A4)
                            	 13189:     ; Check for a collision with Link.
                            	 13190:     ;
                            	 13191:     ; We can't call CheckLinkCollision, because we need to
                            	 13192:     ; customize Ganon's midpoint.
                            	 13193:     ;
                            	 13194:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13195:     ; detection, if Link is invincible. Initialize variables that will
                            	 13196:     ; be returned from the partial collision check routine. Then
                            	 13197:     ; call it.
                            	 13198:     ;
02:0003F668 102C04F0        	 13199:     move.b  ($04F0,A4),D0
02:0003F66C 6616            	 13200:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F66E 19400006        	 13201:     move.b  D0,($0006,A4)
02:0003F672 19400009        	 13202:     move.b  D0,($0009,A4)
02:0003F676 1940000C        	 13203:     move.b  D0,($000C,A4)
02:0003F67A 7600            	 13204:     moveq   #0,D3
02:0003F67C 1883            	 13205:     move.b  D3,($0000,A4)
02:0003F67E 4EB900031C76    	 13206:     jsr     CheckLinkCollisionPreinit
                            	 13207:     even
                            	 13208: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13209:     ; If Ganon is not in state 0, then he's brown.
                            	 13210:     ; Go check collision with an arrow.
                            	 13211:     ;
02:0003F684 41EC00AC        	 13212:     lea     ($00AC,A4),A0
02:0003F688 10302000        	 13213:     move.b  (A0,D2.W),D0
02:0003F68C 6652            	 13214:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13215:     ; If timer <> 0, then Ganon is visible.
                            	 13216:     ; He can't be harmed like this. So, return.
                            	 13217:     ;
02:0003F68E 10342028        	 13218:     move.b  ($28,A4,D2.W),D0
02:0003F692 664A            	 13219:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F694 760D            	 13220:     moveq   #13,D3
02:0003F696 4EB900032140    	 13221:     jsr     CheckMonsterSwordCollision
                            	 13222:     ; If Ganon has died according to the usual collision check rules
                            	 13223:     ; (HP = 0), then:
                            	 13224:     ; 1. Restore HP to the initial value $F0
                            	 13225:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13226:     ; 3. Change palette row 7 to make Ganon brown
                            	 13227:     ;
02:0003F69C 41EC0405        	 13228:     lea     ($0405,A4),A0
02:0003F6A0 10302000        	 13229:     move.b  (A0,D2.W),D0
02:0003F6A4 6718            	 13230:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F6A6 103C00F0        	 13231:     move.b  #$F0,D0
02:0003F6AA 41EC0485        	 13232:     lea     ($0485,A4),A0
02:0003F6AE 11802000        	 13233:     move.b  D0,(A0,D2.W)
02:0003F6B2 41EC00AC        	 13234:     lea     ($00AC,A4),A0
02:0003F6B6 53302000        	 13235:     subq.b  #1,(A0,D2.W)
02:0003F6BA 61000084        	 13236:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13237:     even
                            	 13238: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13239:     ; If Ganon was harmed, then play the sound effect
                            	 13240:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13241:     ;
02:0003F6BE 41EC04F0        	 13242:     lea     ($04F0,A4),A0
02:0003F6C2 10302000        	 13243:     move.b  (A0,D2.W),D0
02:0003F6C6 670A            	 13244:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F6C8 6100A17C        	 13245:     jsr     PlayBossHitCryIfNeeded
02:0003F6CC 7040            	 13246:     moveq   #64,D0
02:0003F6CE 19802028        	 13247:     move.b  D0,($28,A4,D2.W)
                            	 13248:     even
                            	 13249: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13250:     ; Reset metastate, because Ganon cannot die this way.
                            	 13251:     ;
02:0003F6D2 4EB90004D98A    	 13252:     jsr     ResetObjMetastate
                            	 13253:     ; Reset shove info and invincibility timer, because Ganon
                            	 13254:     ; doesn't react at all as a usual monster.
                            	 13255:     ;
02:0003F6D8 4EB900032048    	 13256:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13257:     even
                            	 13258: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F6DE 4E75            	 13259:     rts
                            	 13260: 
                            	 13261:     even
                            	 13262: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13263:     ; If the silver arrow is not in the inventory, then return.
                            	 13264:     ;
02:0003F6E0 102C0659        	 13265:     move.b  ($0659,A4),D0
02:0003F6E4 0C000002        	 13266:     cmpi.b  #$02,D0
02:0003F6E8 66F4            	 13267:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13268:     ; Reset the collision return value [06].
                            	 13269:     ;
02:0003F6EA 7000            	 13270:     moveq   #0,D0
02:0003F6EC 19400006        	 13271:     move.b  D0,($0006,A4)
                            	 13272:     ; If there's no arrow in flight, then return.
                            	 13273:     ;
