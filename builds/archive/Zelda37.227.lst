02:00031D1A 12302000        	  6713:     move.b  (A0,D2.W),D1
02:00031D1E 8001            	  6714:     or.b  D1,D0
02:00031D20 0200000C        	  6715:     andi.b #$0C,D0
02:00031D24 0C00000C        	  6716:     cmpi.b  #$0C,D0
02:00031D28 671A            	  6717:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031D2A 102C0098        	  6718:     move.b  ($0098,A4),D0
02:00031D2E 41EC0098        	  6719:     lea     ($0098,A4),A0
02:00031D32 12302000        	  6720:     move.b  (A0,D2.W),D1
02:00031D36 8001            	  6721:     or.b  D1,D0
02:00031D38 02000003        	  6722:     andi.b #$03,D0
02:00031D3C 0C000003        	  6723:     cmpi.b  #$03,D0
02:00031D40 6702            	  6724:     beq.s  __far_z_01_0069
02:00031D42 602A            	  6725:     jmp  HarmLink
