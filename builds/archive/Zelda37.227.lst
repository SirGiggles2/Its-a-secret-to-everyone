                            	  3589:     ; If facing down, then use frame image offset 2.
                            	  3590:     ;
02:0003B080 41EC0098        	  3591:     lea     ($0098,A4),A0
02:0003B084 10302000        	  3592:     move.b  (A0,D2.W),D0
02:0003B088 7600            	  3593:     moveq   #0,D3
02:0003B08A 1600            	  3594:     move.b  D0,D3
02:0003B08C 0200000C        	  3595:     andi.b #$0C,D0
02:0003B090 670C            	  3596:     beq  _L_z04_UpdateOctorock_CheckHorizontal
