                            	  2270: __far_z_04_0019:
02:0003A724 61000592        	  2271:     jsr     UpdateBurrower
                            	  2272:     ; If zora died in the call above, then it happened while in
                            	  2273:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2274:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2275:     ; not come back after killing it.
                            	  2276:     ;
                            	  2277:     ; If state <> 3 or timer <> $FD,
                            	  2278:     ; then go see if the object needs to be destroyed.
                            	  2279:     ;
02:0003A728 41EC00AC        	  2280:     lea     ($00AC,A4),A0
