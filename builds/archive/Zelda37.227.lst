02:0003DFF8 41EC0478        	 10120:     lea     ($0478,A4),A0
02:0003DFFC 10302000        	 10121:     move.b  (A0,D2.W),D0
02:0003E000 0C000008        	 10122:     cmpi.b  #$08,D0
02:0003E004 66C2            	 10123:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	 10124:     ; Roll over the eye animation counter to 0.
                            	 10125:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	 10126:     ;
02:0003E006 7000            	 10127:     moveq   #0,D0
02:0003E008 41EC0478        	 10128:     lea     ($0478,A4),A0
02:0003E00C 11802000        	 10129:     move.b  D0,(A0,D2.W)
02:0003E010 41EC046B        	 10130:     lea     ($046B,A4),A0
02:0003E014 10302000        	 10131:     move.b  (A0,D2.W),D0
02:0003E018 02000001        	 10132:     andi.b #$01,D0
02:0003E01C 0A000001        	 10133:     eori.b #$01,D0
                            	 10134:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	 10135:     ;
