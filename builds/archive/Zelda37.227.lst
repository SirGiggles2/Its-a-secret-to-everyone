                            	  3241:     ; If Link's X has not changed since the last frame
                            	  3242:     ; (when Link was the target), then XOR the chase target
                            	  3243:     ; coordinates (which were Link's coordinates last frame).
                            	  3244:     ;
                            	  3245:     ; This ends up reflecting Link's coordinates across the room;
