                            	  2344: UpdateWhirlwind_Full:
                            	  2345:     ; Get Link's halted state.
                            	  2346:     ;
02:0002FDF8 102C00AC        	  2347:     move.b  ($00AC,A4),D0
02:0002FDFC 02000040        	  2348:     andi.b #$40,D0
02:0002FE00 7600            	  2349:     moveq   #0,D3
02:0002FE02 1600            	  2350:     move.b  D0,D3
                            	  2351:     ; Add 2 to whirlwind X.
                            	  2352:     ;
02:0002FE04 7002            	  2353:     moveq   #2,D0
02:0002FE06 023C00EE        	  2354:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FE0A 12342070        	  2355:     move.b  ($70,A4,D2.W),D1
02:0002FE0E D101            	  2356:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FE10 19802070        	  2357:     move.b  D0,($70,A4,D2.W)
                            	  2358:     ; If Link is not halted or teleporting state = 0, then
                            	  2359:     ; go check for collision with Link.
                            	  2360:     ;
02:0002FE14 0C030040        	  2361:     cmpi.b  #$40,D3
02:0002FE18 6638            	  2362:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FE1A 7600            	  2363:     moveq   #0,D3
02:0002FE1C 162C0522        	  2364:     move.b  ($0522,A4),D3
02:0002FE20 6730            	  2365:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2366:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2367:     ;
                            	  2368:     ; Set Link's X to whirlwind's.
                            	  2369:     ;
02:0002FE22 19400070        	  2370:     move.b  D0,($0070,A4)
                            	  2371:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2372:     ; the right screen edge and draw.
                            	  2373:     ;
02:0002FE26 5303            	  2374:     subq.b  #1,D3
02:0002FE28 6776            	  2375:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FE2A 0C000080        	  2376:     cmpi.b  #$80,D0
02:0002FE2E 6670            	  2377:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2378:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2379:     ;
                            	  2380:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2381:     ;
02:0002FE30 E308            	  2382:     lsl.b  #1,D0   ; ASL A
02:0002FE32 194000AC        	  2383:     move.b  D0,($00AC,A4)
02:0002FE36 19400522        	  2384:     move.b  D0,($0522,A4)
02:0002FE3A 41EC034F        	  2385:     lea     ($034F,A4),A0
02:0002FE3E 11802000        	  2386:     move.b  D0,(A0,D2.W)
                            	  2387:     ; Update the player position marker, and draw one last time.
                            	  2388:     ;
02:0002FE42 1002            	  2389:     move.b  D2,D0
02:0002FE44 1B00            	  2390:     move.b  D0,-(A5)  ; PHA
02:0002FE46 610010F2        	  2391:     jsr     UpdatePlayerPositionMarker
02:0002FE4A 101D            	  2392:     move.b  (A5)+,D0  ; PLA
02:0002FE4C 7400            	  2393:     moveq   #0,D2
02:0002FE4E 1400            	  2394:     move.b  D0,D2
02:0002FE50 6070            	  2395:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
