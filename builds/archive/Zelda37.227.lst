                            	  8109: Submenu_CueTransferRowUW:
                            	  8110:     ; If menu scroll value is negative, then we transferred everything.
                            	  8111:     ; So, return.
                            	  8112:     ;
02:00044DF8 102C005E        	  8113:     move.b  ($005E,A4),D0
