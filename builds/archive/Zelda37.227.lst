                            	   420: ;------------------------------------------------------------------------------
                            	   421: ; _c_move_object_shim — MoveObject trampoline.
                            	   422: ;
                            	   423: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   424: ;   Input:     D2 = slot (0..11)
                            	   425: ;   Preserves: D2, A4, A5
                            	   426: ;   Clobbers:  D0, D1, D3, A0
                            	   427: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   428: ;
                            	   429: ; GCC side:
                            	   430: ;   void c_move_object(unsigned short slot);
                            	   431: ;     slot arrives as a 16-bit value on the stack.
                            	   432: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   433: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   434: ;   never clobbered by gcc.
                            	   435: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   436: ;   semantics can exist in a pure C port).
                            	   437: ;------------------------------------------------------------------------------
                            	   438: _c_move_object_shim:
                            	   439:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   440:     move.b  #$AA,($0900,A4)
                            	   441:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   442:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   443:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   444:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   445:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   446:     moveq   #0,D0
02:0002B658 3002            	   447:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   448:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   449:     jsr     c_move_object
02:0002B662 588F            	   450:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   451:     rts
                            	   452: 
                            	   453: ;==============================================================================
                            	   454: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   455: ; and tail-call the native asm function.
                            	   456: ;
                            	   457: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   458: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   459: ; sign-extended).
                            	   460: ;==============================================================================
                            	   461: 
                            	   462: ;------------------------------------------------------------------------------
                            	   463: ; void c_copy_bank_to_window(unsigned int bank);
                            	   464: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   465: ;------------------------------------------------------------------------------
                            	   466: c_copy_bank_to_window:
02:0002B666 202F0004        	   467:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   468:     jmp     _copy_bank_to_window
                            	   469: 
                            	   470: ;------------------------------------------------------------------------------
                            	   471: ; unsigned char c_ppu_read_2(void);
                            	   472: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   473: ; C return: gcc expects result in D0.
                            	   474: ;------------------------------------------------------------------------------
                            	   475: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   476:     jmp     _ppu_read_2
                            	   477: 
                            	   478: ;------------------------------------------------------------------------------
                            	   479: ; void c_ppu_write_6(unsigned int val);
                            	   480: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   481: ;------------------------------------------------------------------------------
                            	   482: c_ppu_write_6:
02:0002B674 202F0004        	   483:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   484:     jmp     _ppu_write_6
                            	   485: 
                            	   486: ;------------------------------------------------------------------------------
                            	   487: ; void c_ppu_write_7(unsigned int val);
                            	   488: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   489: ;------------------------------------------------------------------------------
                            	   490: c_ppu_write_7:
02:0002B67E 202F0004        	   491:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   492:     jmp     _ppu_write_7
                            	   493: 
                            	   494: ;------------------------------------------------------------------------------
                            	   495: ; void c_turn_off_all_video(void);
                            	   496: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   497: ;------------------------------------------------------------------------------
                            	   498: c_turn_off_all_video:
02:0002B688 4EF90004ABBE    	   499:     jmp     TurnOffAllVideo
