02:0003A4B4 102C04CC        	  1906:     move.b  ($04CC,A4),D0
02:0003A4B8 6620            	  1907:     bne  _L_z04_UpdateStatues_Shoot
                            	  1908:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1909:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1910:     ; - layout $23: pattern 1: 2 statues
                            	  1911:     ; - layout $24: pattern 0: 4 statues
                            	  1912:     ;
02:0003A4BA 4EB90004AFDC    	  1913:     jsr     GetUniqueRoomId
02:0003A4C0 7601            	  1914:     moveq   #1,D3
                            	  1915: _anon_z04_30:
02:0003A4C2 41F90003A494    	  1916:     lea     (StatueRoomLayouts).l,A0
02:0003A4C8 12303000        	  1917:     move.b  (A0,D3.W),D1
02:0003A4CC B001            	  1918:     cmp.b   D1,D0
02:0003A4CE 670A            	  1919:     beq  _L_z04_UpdateStatues_Shoot
02:0003A4D0 5303            	  1920:     subq.b  #1,D3
02:0003A4D2 6AEE            	  1921:     bpl  _anon_z04_30
