02:00030360 9101            	  3135:     subx.b  D1,D0   ; SBC ObjY,X
02:00030362 0A3C0010        	  3136:     eori    #$10,CCR  ; restore X = 6502 C
02:00030366 61000894        	  3137:     jsr     Abs
