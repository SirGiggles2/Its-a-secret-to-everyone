02:0003D172 7008            	  8184:     moveq   #8,D0
02:0003D174 41EC03D0        	  8185:     lea     ($03D0,A4),A0
02:0003D178 11802000        	  8186:     move.b  D0,(A0,D2.W)
02:0003D17C 7600            	  8187:     moveq   #0,D3
02:0003D17E 41EC03E4        	  8188:     lea     ($03E4,A4),A0
02:0003D182 16302000        	  8189:     move.b  (A0,D2.W),D3
02:0003D186 5203            	  8190:     addq.b  #1,D3
02:0003D188 1003            	  8191:     move.b  D3,D0
02:0003D18A 02000003        	  8192:     andi.b #$03,D0
02:0003D18E 41EC03E4        	  8193:     lea     ($03E4,A4),A0
02:0003D192 11802000        	  8194:     move.b  D0,(A0,D2.W)
                            	  8195:     even
                            	  8196: _L_z04_UpdateLikeLike_Draw:
                            	  8197:     ; Draw.
                            	  8198:     ;
