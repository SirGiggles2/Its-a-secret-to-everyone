                            	  7881:     ;
02:0003241E 41EC04BF        	  7882:     lea     ($04BF,A4),A0
02:00032422 10302000        	  7883:     move.b  (A0,D2.W),D0
02:00032426 02000080        	  7884:     andi.b #$80,D0
