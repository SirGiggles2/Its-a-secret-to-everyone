02:00030CDA 9101            	  4588:     subx.b  D1,D0   ; SBC $04
02:00030CDC 0A3C0010        	  4589:     eori    #$10,CCR  ; restore X = 6502 C
02:00030CE0 0C000008        	  4590:     cmpi.b  #$08,D0
