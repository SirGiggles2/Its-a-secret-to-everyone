02:00045538 1600            	  9191:     move.b  D0,D3
                            	  9192:     ; The map marks are arranged in the same order as all the
                            	  9193:     ; possible values of OpenDoorMask.
                            	  9194:     ;
                            	  9195:     ; Add $E2 for the first map mark tile, and store it in the
                            	  9196:     ; dynamic transfer buf at the current offset.
