02:0003D1AA 4EB900031AF6    	  8205:     jsr     CheckMonsterCollisions
02:0003D1B0 41EC042C        	  8206:     lea     ($042C,A4),A0
02:0003D1B4 10302000        	  8207:     move.b  (A0,D2.W),D0
