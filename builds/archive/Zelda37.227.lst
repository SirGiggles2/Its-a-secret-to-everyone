                            	   195: InitCave:
                            	   196:     ; The person goes at location ($78, $80).
                            	   197:     ;
02:0002DE82 7078            	   198:     moveq   #120,D0
02:0002DE84 163C0080        	   199:     move.b  #$80,D3
02:0002DE88 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
