02:000365C8 41EC0302        	  4903:     lea     ($0302,A4),A0
02:000365CC 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:000365D0 5303            	  4905:     subq.b  #1,D3
02:000365D2 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:000365D4 7600            	  4910:     moveq   #0,D3
02:000365D6 162C0413        	  4911:     move.b  ($0413,A4),D3
02:000365DA 41F900036574    	  4912:     lea     (PeaceText).l,A0
02:000365E0 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000365E4 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:000365E8 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000365EA 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
02:000365EE 0C000024        	  4920:     cmpi.b  #$24,D0
02:000365F2 6706            	  4921:     beq  _anon_z02_36
02:000365F4 7010            	  4922:     moveq   #16,D0
02:000365F6 19400604        	  4923:     move.b  D0,($0604,A4)
                            	  4924: _anon_z02_36:
                            	  4925:     ; Point to the next character in the string.
                            	  4926:     ;
02:000365FA 522C0413        	  4927:     addq.b  #1,($0413,A4)
                            	  4928:     ; Replace the low byte of the VRAM address with the one
                            	  4929:     ; where the next character should be written.
                            	  4930:     ;
02:000365FE 41F900036540    	  4931:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00036604 10303000        	  4932:     move.b  (A0,D3.W),D0
02:00036608 19400303        	  4933:     move.b  D0,($0303,A4)
                            	  4934:     ; Once the low VRAM address rolls over,
                            	  4935:     ; increment the high address.
                            	  4936:     ;
02:0003660C 0C0000A0        	  4937:     cmpi.b  #$A0,D0
02:00036610 6406            	  4938:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:00036612 7023            	  4939:     moveq   #35,D0
