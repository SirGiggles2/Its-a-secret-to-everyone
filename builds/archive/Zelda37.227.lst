02:000445D0 9101            	  7389:     subx.b  D1,D0   ; SBC #$40
02:000445D2 0A3C0010        	  7390:     eori    #$10,CCR  ; restore X = 6502 C
02:000445D6 E208            	  7391:     lsr.b  #1,D0   ; LSR A
02:000445D8 E208            	  7392:     lsr.b  #1,D0   ; LSR A
02:000445DA E208            	  7393:     lsr.b  #1,D0   ; LSR A
