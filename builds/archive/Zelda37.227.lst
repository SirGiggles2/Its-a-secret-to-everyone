02:0003227C 10343070        	  7574:     move.b  ($70,A4,D3.W),D0
02:00032280 023C00EE        	  7575:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032284 123C0006        	  7576:     move.b  #$06,D1
