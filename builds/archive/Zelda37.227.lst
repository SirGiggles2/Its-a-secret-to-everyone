02:0003C56A 10302000        	  6523:     move.b  (A0,D2.W),D0
02:0003C56E 122C0002        	  6524:     move.b  ($0002,A4),D1
02:0003C572 E309            	  6525:     lsl.b  #1,D1   ; ASL $02
02:0003C574 19410002        	  6526:     move.b  D1,($0002,A4)
02:0003C578 122C0002        	  6527:     move.b  ($0002,A4),D1
02:0003C57C C200            	  6528:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C57E 6716            	  6529:     beq  _L_z04_Digdogger_Move_Down
02:0003C580 10342070        	  6530:     move.b  ($70,A4,D2.W),D0
02:0003C584 122C0003        	  6531:     move.b  ($0003,A4),D1
02:0003C588 0A3C0010        	  6532:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C58C 9101            	  6533:     subx.b  D1,D0   ; SBC $03
02:0003C58E 0A3C0010        	  6534:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C592 19802070        	  6535:     move.b  D0,($70,A4,D2.W)
                            	  6536:     even
                            	  6537: _L_z04_Digdogger_Move_Down:
                            	  6538:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6539:     ;
02:0003C596 41EC0098        	  6540:     lea     ($0098,A4),A0
02:0003C59A 10302000        	  6541:     move.b  (A0,D2.W),D0
02:0003C59E 122C0002        	  6542:     move.b  ($0002,A4),D1
02:0003C5A2 E309            	  6543:     lsl.b  #1,D1   ; ASL $02
02:0003C5A4 19410002        	  6544:     move.b  D1,($0002,A4)
02:0003C5A8 122C0002        	  6545:     move.b  ($0002,A4),D1
02:0003C5AC C200            	  6546:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5AE 6716            	  6547:     beq  _L_z04_Digdogger_Move_Up
02:0003C5B0 41EC0084        	  6548:     lea     ($0084,A4),A0
02:0003C5B4 10302000        	  6549:     move.b  (A0,D2.W),D0
02:0003C5B8 122C0003        	  6550:     move.b  ($0003,A4),D1
02:0003C5BC D101            	  6551:     addx.b  D1,D0   ; ADC $03
02:0003C5BE 41EC0084        	  6552:     lea     ($0084,A4),A0
02:0003C5C2 11802000        	  6553:     move.b  D0,(A0,D2.W)
                            	  6554:     even
                            	  6555: _L_z04_Digdogger_Move_Up:
                            	  6556:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6557:     ;
02:0003C5C6 41EC0098        	  6558:     lea     ($0098,A4),A0
02:0003C5CA 10302000        	  6559:     move.b  (A0,D2.W),D0
02:0003C5CE 122C0002        	  6560:     move.b  ($0002,A4),D1
02:0003C5D2 E309            	  6561:     lsl.b  #1,D1   ; ASL $02
02:0003C5D4 19410002        	  6562:     move.b  D1,($0002,A4)
02:0003C5D8 122C0002        	  6563:     move.b  ($0002,A4),D1
02:0003C5DC C200            	  6564:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5DE 671E            	  6565:     beq  _L_z04_Digdogger_Move_End
02:0003C5E0 41EC0084        	  6566:     lea     ($0084,A4),A0
02:0003C5E4 10302000        	  6567:     move.b  (A0,D2.W),D0
02:0003C5E8 122C0003        	  6568:     move.b  ($0003,A4),D1
02:0003C5EC 0A3C0010        	  6569:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5F0 9101            	  6570:     subx.b  D1,D0   ; SBC $03
02:0003C5F2 0A3C0010        	  6571:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5F6 41EC0084        	  6572:     lea     ($0084,A4),A0
02:0003C5FA 11802000        	  6573:     move.b  D0,(A0,D2.W)
                            	  6574:     even
