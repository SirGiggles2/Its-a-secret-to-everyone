02:000459AE 7400            	   167:     moveq   #0,D2
02:000459B0 1942005C        	   168:     move.b  D2,($005C,A4)
02:000459B4 19420301        	   169:     move.b  D2,($0301,A4)
02:000459B8 4E75            	   170:     rts
