02:000422F4 12303000        	  4301:     move.b  (A0,D3.W),D1
02:000422F8 B001            	  4302:     cmp.b   D1,D0
02:000422FA 6510            	  4303:     bcs  _anon_z05_95
02:000422FC 41F9000422BE    	  4304:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042302 12303000        	  4305:     move.b  (A0,D3.W),D1
02:00042306 B001            	  4306:     cmp.b   D1,D0
02:00042308 65000082        	  4307:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4308: _anon_z05_95:
