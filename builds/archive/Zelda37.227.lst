                            	 10015:     ;
02:0003DF38 7000            	 10016:     moveq   #0,D0
02:0003DF3A 41EC0412        	 10017:     lea     ($0412,A4),A0
02:0003DF3E 11802000        	 10018:     move.b  D0,(A0,D2.W)
02:0003DF42 61001DBA        	 10019:     jsr     ReverseObjDir8
02:0003DF46 41EC045E        	 10020:     lea     ($045E,A4),A0
02:0003DF4A 10302000        	 10021:     move.b  (A0,D2.W),D0
02:0003DF4E 41EC045E        	 10022:     lea     ($045E,A4),A0
02:0003DF52 52302000        	 10023:     addq.b  #1,(A0,D2.W)
                            	 10024:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10025:     ; should randomly change direction.
