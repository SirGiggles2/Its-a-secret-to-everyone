                            	  3402: _L_z04_UpdateRedLeever_Subtract:
                            	  3403:     ; The point is to get the absolute distance between the two.
                            	  3404:     ;
02:0003AF06 102C0001        	  3405:     move.b  ($0001,A4),D0
02:0003AF0A 003C0011        	  3406:     ori     #$11,CCR  ; SEC: set C+X
02:0003AF0E 122C0002        	  3407:     move.b  ($0002,A4),D1
