02:0003DF58 640A            	 10028:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DF5A 7000            	 10029:     moveq   #0,D0
02:0003DF5C 41EC0451        	 10030:     lea     ($0451,A4),A0
