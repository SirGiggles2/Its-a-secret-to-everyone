02:0003AECA 6704            	  3371:     beq  _anon_z04_45
02:0003AECC 163C00D8        	  3372:     move.b  #$D8,D3
                            	  3373: _anon_z04_45:
02:0003AED0 1883            	  3374:     move.b  D3,($0000,A4)
                            	  3375:     ; [01] holds Link's X coordinate.
                            	  3376:     ;
02:0003AED2 102C0070        	  3377:     move.b  ($0070,A4),D0
02:0003AED6 19400001        	  3378:     move.b  D0,($0001,A4)
                            	  3379:     ; Add Link's X and the horizontal offset.
                            	  3380:     ;
02:0003AEDA 023C00EE        	  3381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AEDE 1214            	  3382:     move.b  ($0000,A4),D1
02:0003AEE0 D101            	  3383:     addx.b  D1,D0   ; ADC $00
                            	  3384:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3385:     ;
02:0003AEE2 020000F8        	  3386:     andi.b #$F8,D0
                            	  3387:     ; Assign that result to the leever's X coordinate and [02].
                            	  3388:     ;
