                            	 12519: _anon_z04_159:
02:0003F1AC 61000EAE        	 12520:     jsr     DecreaseObjectAngle
                            	 12521:     ; Load Patra's maneuver index.
                            	 12522:     ; It determines which counts of bits are looked up below.
                            	 12523:     ;
