02:0003C8AE 7600            	  6958:     moveq   #0,D3
02:0003C8B0 162C0341        	  6959:     move.b  ($0341,A4),D3
02:0003C8B4 41F900031742    	  6960:     lea     (SpriteOffsets).l,A0
02:0003C8BA 10303000        	  6961:     move.b  (A0,D3.W),D0
02:0003C8BE 7600            	  6962:     moveq   #0,D3
02:0003C8C0 1600            	  6963:     move.b  D0,D3
02:0003C8C2 101D            	  6964:     move.b  (A5)+,D0  ; PLA
02:0003C8C4 41EC0201        	  6965:     lea     ($0201,A4),A0
02:0003C8C8 11803000        	  6966:     move.b  D0,(A0,D3.W)
02:0003C8CC 1014            	  6967:     move.b  ($0000,A4),D0
02:0003C8CE 41EC0203        	  6968:     lea     ($0203,A4),A0
02:0003C8D2 11803000        	  6969:     move.b  D0,(A0,D3.W)
02:0003C8D6 102C0001        	  6970:     move.b  ($0001,A4),D0
02:0003C8DA 4EF900031AC0    	  6971:     jmp     Anim_EndWriteSprite
