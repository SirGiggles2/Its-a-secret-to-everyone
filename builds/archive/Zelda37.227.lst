                            	  6858: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6859:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6860:     ;   full heart=4 partial heart=$70
                            	  6861:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6862:     ; But the method here yields $3EF, because partial heart is
                            	  6863:     ; considered full when = $FF instead of $100.
                            	  6864:     ;
02:00031E34 102C000E        	  6865:     move.b  ($000E,A4),D0
02:00031E38 003C0011        	  6866:     ori     #$11,CCR  ; SEC: set C+X
02:00031E3C 122C0670        	  6867:     move.b  ($0670,A4),D1
02:00031E40 0A3C0010        	  6868:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E44 9101            	  6869:     subx.b  D1,D0   ; SBC HeartPartial
02:00031E46 0A3C0010        	  6870:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E4A 1940000E        	  6871:     move.b  D0,($000E,A4)
02:00031E4E 102C066F        	  6872:     move.b  ($066F,A4),D0
02:00031E52 0200000F        	  6873:     andi.b #$0F,D0
02:00031E56 6710            	  6874:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031E58 532C066F        	  6875:     subq.b  #1,($066F,A4)
02:00031E5C 103C00FF        	  6876:     move.b  #$FF,D0
02:00031E60 19400670        	  6877:     move.b  D0,($0670,A4)
02:00031E64 6600FF6E        	  6878:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6879:     even
                            	  6880: _L_z01_Link_BeHarmed_HandleDied:
                            	  6881:     ; Link died.
