                            	  1893: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1894:     ; Choose a distance to walk depending on the door you
                            	  1895:     ; come out of.
                            	  1896:     ;
                            	  1897:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1898:     ;
                            	  1899:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1900:     ; then you have shorter distance to cover. So use the
                            	  1901:     ; previous value as is to use indexes 0 and 1.
                            	  1902:     ;
                            	  1903:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1904:     ; to get out of the way of the wall or door.
                            	  1905:     ;
02:000411DC 610039E8        	  1906:     jsr     GetPassedDoorType
02:000411E0 02000007        	  1907:     andi.b #$07,D0
02:000411E4 6710            	  1908:     beq  _anon_z05_45
02:000411E6 0C000005        	  1909:     cmpi.b  #$05,D0
02:000411EA 670A            	  1910:     beq  _anon_z05_45
