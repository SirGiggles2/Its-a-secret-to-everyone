                            	  6326: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6327:     ; Store the weapon's frame (horizontal or vertical)
                            	  6328:     ; for the direction chosen above in [0C].
                            	  6329:     ;
02:0004CC0A 4EB900030BF8    	  6330:     jsr     GetOppositeDir
02:0004CC10 41F90004C644    	  6331:     lea     (RDirectionToWeaponFrame).l,A0
02:0004CC16 10303000        	  6332:     move.b  (A0,D3.W),D0
02:0004CC1A 1940000C        	  6333:     move.b  D0,($000C,A4)
                            	  6334:     ; Calculate sprite attributes.
                            	  6335:     ;
                            	  6336:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6337:     ;   base attribute OR 1
                            	  6338:     ; So, it uses palette row 5.
                            	  6339:     ;
02:0004CC1E 41F90004C648    	  6340:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004CC24 10303000        	  6341:     move.b  (A0,D3.W),D0
02:0004CC28 0C02000D        	  6342:     cmpi.b  #$0D,D2
02:0004CC2C 6706            	  6343:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004CC2E 00000001        	  6344:     ori.b #$01,D0
02:0004CC32 601C            	  6345:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6346: 
                            	  6347:     even
                            	  6348: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6349:     ; The weapon is the sword.
                            	  6350:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6351:     ;
02:0004CC34 023C00EE        	  6352:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CC38 122C0657        	  6353:     move.b  ($0657,A4),D1
02:0004CC3C D101            	  6354:     addx.b  D1,D0   ; ADC Items
02:0004CC3E 003C0011        	  6355:     ori     #$11,CCR  ; SEC: set C+X
02:0004CC42 123C0001        	  6356:     move.b  #$01,D1
02:0004CC46 0A3C0010        	  6357:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CC4A 9101            	  6358:     subx.b  D1,D0   ; SBC #$01
02:0004CC4C 0A3C0010        	  6359:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6360:     even
                            	  6361: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6362:     ; Set sprite attributes to the calculated value above.
                            	  6363:     ;
02:0004CC50 4EB900031A6C    	  6364:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6365:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6366:     ;
02:0004CC56 0C030002        	  6367:     cmpi.b  #$02,D3
02:0004CC5A 6604            	  6368:     bne  _anon_z07_33
02:0004CC5C 522C000F        	  6369:     addq.b  #1,($000F,A4)
