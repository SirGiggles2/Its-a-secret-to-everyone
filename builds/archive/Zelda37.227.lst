02:0003DFCC 53302000        	 10094:     subq.b  #1,(A0,D2.W)
                            	 10095:     ; If it became 0, then set it to $41, and shoot fireball $56.
                            	 10096:     ;
02:0003DFD0 6610            	 10097:     bne  _L_z04_UpdateGohma_AnimateAndCheckCollisions
02:0003DFD2 7041            	 10098:     moveq   #65,D0
02:0003DFD4 41EC0380        	 10099:     lea     ($0380,A4),A0
