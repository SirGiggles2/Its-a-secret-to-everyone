02:0003BBFC 19430003        	  5255:     move.b  D3,($0003,A4)
                            	  5256:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5257:     ;
02:0003BC00 7024            	  5258:     moveq   #36,D0
02:0003BC02 7600            	  5259:     moveq   #0,D3
02:0003BC04 162C03F8        	  5260:     move.b  ($03F8,A4),D3
02:0003BC08 6702            	  5261:     beq  _anon_z04_70
02:0003BC0A 7032            	  5262:     moveq   #50,D0
                            	  5263: _anon_z04_70:
                            	  5264:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5265:     ; 1. negate the distance
                            	  5266:     ; 2. add 8 to the instruction offset to access
                            	  5267:     ;    the opposite direction for the same wall
                            	  5268:     ;
02:0003BC0C 7600            	  5269:     moveq   #0,D3
02:0003BC0E 162C0098        	  5270:     move.b  ($0098,A4),D3
02:0003BC12 122C0002        	  5271:     move.b  ($0002,A4),D1
02:0003BC16 B601            	  5272:     cmp.b   D1,D3
02:0003BC18 662A            	  5273:     bne  _anon_z04_71
02:0003BC1A 1B00            	  5274:     move.b  D0,-(A5)  ; PHA
02:0003BC1C 41EC0412        	  5275:     lea     ($0412,A4),A0
02:0003BC20 10302000        	  5276:     move.b  (A0,D2.W),D0
02:0003BC24 023C00EE        	  5277:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC28 123C0008        	  5278:     move.b  #$08,D1
02:0003BC2C D101            	  5279:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BC2E 41EC0412        	  5280:     lea     ($0412,A4),A0
02:0003BC32 11802000        	  5281:     move.b  D0,(A0,D2.W)
02:0003BC36 101D            	  5282:     move.b  (A5)+,D0  ; PLA
02:0003BC38 4600            	  5283:     eori.b #$FF,D0
02:0003BC3A 023C00EE        	  5284:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC3E 123C0001        	  5285:     move.b  #$01,D1
02:0003BC42 D101            	  5286:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5287: _anon_z04_71:
                            	  5288:     ; Add the distance and Link's minor coordinate to calculate
                            	  5289:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5290:     ; In general, the monster will be put in front of Link.
                            	  5291:     ;
02:0003BC44 023C00EE        	  5292:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC48 1214            	  5293:     move.b  ($0000,A4),D1
02:0003BC4A D101            	  5294:     addx.b  D1,D0   ; ADC $00
02:0003BC4C 19400004        	  5295:     move.b  D0,($0004,A4)
                            	  5296:     ; By default, will return index 0 to choose the minimum value
                            	  5297:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5298:     ; if Link is at the wall with a smaller major coordinate.
                            	  5299:     ;
02:0003BC50 7600            	  5300:     moveq   #0,D3
                            	  5301:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5302:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5303:     ; to access the block for the other direction along the same axis,
                            	  5304:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5305:     ;
02:0003BC52 102C0001        	  5306:     move.b  ($0001,A4),D0
02:0003BC56 122C0003        	  5307:     move.b  ($0003,A4),D1
02:0003BC5A B001            	  5308:     cmp.b   D1,D0
02:0003BC5C 671C            	  5309:     beq  _anon_z04_72
02:0003BC5E 41EC0412        	  5310:     lea     ($0412,A4),A0
02:0003BC62 10302000        	  5311:     move.b  (A0,D2.W),D0
02:0003BC66 023C00EE        	  5312:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC6A 123C0010        	  5313:     move.b  #$10,D1
02:0003BC6E D101            	  5314:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BC70 41EC0412        	  5315:     lea     ($0412,A4),A0
02:0003BC74 11802000        	  5316:     move.b  D0,(A0,D2.W)
02:0003BC78 5203            	  5317:     addq.b  #1,D3
                            	  5318: _anon_z04_72:
