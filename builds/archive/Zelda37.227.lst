                            	   777:     ; Load the person text current character index.
                            	   778:     ;
02:0002E298 7600            	   779:     moveq   #0,D3
02:0002E29A 162C0416        	   780:     move.b  ($0416,A4),D3
                            	   781:     ; Increment the index variable to point to the next character
                            	   782:     ; for next time.
                            	   783:     ;
02:0002E29E 522C0416        	   784:     addq.b  #1,($0416,A4)
                            	   785:     ; Get the current character.
                            	   786:     ;
02:0002E2A2 1214            	   787:     move.b  ($00,A4),D1   ; ptr lo
02:0002E2A4 182C0001        	   788:     move.b  ($01,A4),D4  ; ptr hi
02:0002E2A8 024100FF        	   789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E2AC E14C            	   790:     lsl.w   #8,D4
02:0002E2AE 8841            	   791:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E2B0 48C4            	   792:     ext.l   D4
02:0002E2B2 D8BC00FF0000    	   793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E2B8 2044            	   794:     movea.l D4,A0
