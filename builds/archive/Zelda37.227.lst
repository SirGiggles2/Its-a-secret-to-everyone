                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:000402DA 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:000402DE 02000010        	   446:     andi.b #$10,D0
02:000402E2 6606            	   447:     bne.s  __far_z_05_0003
02:000402E4 4EF90002D16E    	   448:     jmp  Exit
                            	   449: __far_z_05_0003:
02:000402EA 102C0254        	   450:     move.b  ($0254,A4),D0
02:000402EE 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:000402F0 102C0258        	   452:     move.b  ($0258,A4),D0
02:000402F4 1B00            	   453:     move.b  D0,-(A5)  ; PHA
02:000402F6 4EB90004AB6E    	   454:     jsr     HideAllSprites
02:000402FC 101D            	   455:     move.b  (A5)+,D0  ; PLA
02:000402FE 19400258        	   456:     move.b  D0,($0258,A4)
02:00040302 101D            	   457:     move.b  (A5)+,D0  ; PLA
02:00040304 19400254        	   458:     move.b  D0,($0254,A4)
02:00040308 522C00E1        	   459:     addq.b  #1,($00E1,A4)
02:0004030C 0A3C0001        	   460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040310 4E75            	   461:     rts
                            	   462: 
