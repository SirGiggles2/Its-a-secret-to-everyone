02:000317CA 162C000E        	  6012:     move.b  ($000E,A4),D3
02:000317CE 7001            	  6013:     moveq   #1,D0
02:000317D0 19400007        	  6014:     move.b  D0,($0007,A4)
02:000317D4 7008            	  6015:     moveq   #8,D0
02:000317D6 1940000A        	  6016:     move.b  D0,($000A,A4)
02:000317DA 41F90003152A    	  6017:     lea     (ObjAnimations).l,A0
02:000317E0 10303000        	  6018:     move.b  (A0,D3.W),D0
02:000317E4 023C00EE        	  6019:     andi    #$EE,CCR  ; CLC: clear C+X
02:000317E8 122C000D        	  6020:     move.b  ($000D,A4),D1
02:000317EC D101            	  6021:     addx.b  D1,D0   ; ADC $0D
02:000317EE 7600            	  6022:     moveq   #0,D3
02:000317F0 1600            	  6023:     move.b  D0,D3
02:000317F2 41F9000315AA    	  6024:     lea     (ObjAnimFrameHeap).l,A0
02:000317F8 10303000        	  6025:     move.b  (A0,D3.W),D0
02:000317FC 19400002        	  6026:     move.b  D0,($0002,A4)
02:00031800 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
