                            	  7527: Dodongo_Draw:
02:0003CC86 610000F4        	  7528:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7529:     ; Make a 5-way direction index out of the facing direction
                            	  7530:     ; by shifting right once, and store it in [00].
                            	  7531:     ;
02:0003CC8A 41EC0098        	  7532:     lea     ($0098,A4),A0
02:0003CC8E 10302000        	  7533:     move.b  (A0,D2.W),D0
02:0003CC92 E208            	  7534:     lsr.b  #1,D0   ; LSR A
02:0003CC94 1880            	  7535:     move.b  D0,($0000,A4)
                            	  7536:     ; If state = 0, go handle animating the two frames of this state.
                            	  7537:     ;
02:0003CC96 7600            	  7538:     moveq   #0,D3
02:0003CC98 41EC00AC        	  7539:     lea     ($00AC,A4),A0
02:0003CC9C 16302000        	  7540:     move.b  (A0,D2.W),D3
02:0003CCA0 6744            	  7541:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7542:     ; If state > 1, then the monster is stunned (state 2).
                            	  7543:     ; So, go switch frames every $20 screen frames.
                            	  7544:     ;
02:0003CCA2 7020            	  7545:     moveq   #32,D0
02:0003CCA4 5303            	  7546:     subq.b  #1,D3
02:0003CCA6 6640            	  7547:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7548:     ; State = 1. Bloated.
                            	  7549:     ;
                            	  7550:     ; In substate 0, go animate as usual for walking.
                            	  7551:     ;
02:0003CCA8 7600            	  7552:     moveq   #0,D3
02:0003CCAA 41EC042C        	  7553:     lea     ($042C,A4),A0
02:0003CCAE 16302000        	  7554:     move.b  (A0,D2.W),D3
02:0003CCB2 6732            	  7555:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7556:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7557:     ; go fade the boss; so that some frames are not drawn.
                            	  7558:     ;
02:0003CCB4 0C030002        	  7559:     cmpi.b  #$02,D3
02:0003CCB8 6718            	  7560:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CCBA 0C030003        	  7561:     cmpi.b  #$03,D3
02:0003CCBE 6712            	  7562:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7563:     ; State 1, substate 1
                            	  7564:     ;
                            	  7565:     ; Add $14 to the frame image index to index into the bloated
                            	  7566:     ; frame images and H-flips.
                            	  7567:     ;
02:0003CCC0 1014            	  7568:     move.b  ($0000,A4),D0
02:0003CCC2 023C00EE        	  7569:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCC6 123C0014        	  7570:     move.b  #$14,D1
02:0003CCCA D101            	  7571:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CCCC 7600            	  7572:     moveq   #0,D3
02:0003CCCE 1600            	  7573:     move.b  D0,D3
02:0003CCD0 6032            	  7574:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7575: 
                            	  7576:     even
                            	  7577: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7578:     ; In bloated substates 2 and 3:
                            	  7579:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7580:     ;
02:0003CCD2 102C0015        	  7581:     move.b  ($0015,A4),D0
02:0003CCD6 02000002        	  7582:     andi.b #$02,D0
02:0003CCDA 6604            	  7583:     bne.s  __far_z_04_0071
02:0003CCDC 600000A6        	  7584:     jmp  L11B00_Exit
                            	  7585: __far_z_04_0071:
02:0003CCE0 7600            	  7586:     moveq   #0,D3
02:0003CCE2 1614            	  7587:     move.b  ($0000,A4),D3
02:0003CCE4 601E            	  7588:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7589: 
                            	  7590:     even
                            	  7591: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7592:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7593:     ;
02:0003CCE6 7008            	  7594:     moveq   #8,D0
                            	  7595:     even
                            	  7596: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CCE8 7600            	  7597:     moveq   #0,D3
02:0003CCEA 1614            	  7598:     move.b  ($0000,A4),D3
02:0003CCEC 122C0015        	  7599:     move.b  ($0015,A4),D1
02:0003CCF0 C001            	  7600:     and.b  D1,D0
02:0003CCF2 6710            	  7601:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7602:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7603:     ; in order to index into the second set of frame image numbers.
                            	  7604:     ;
02:0003CCF4 1003            	  7605:     move.b  D3,D0
02:0003CCF6 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCFA 123C0005        	  7607:     move.b  #$05,D1
02:0003CCFE D101            	  7608:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CD00 7600            	  7609:     moveq   #0,D3
02:0003CD02 1600            	  7610:     move.b  D0,D3
                            	  7611:     even
                            	  7612: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7613:     ; Start preparing sprites.
                            	  7614:     ;
02:0003CD04 4EB90004D182    	  7615:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CD0A 1003            	  7616:     move.b  D3,D0
02:0003CD0C 1B00            	  7617:     move.b  D0,-(A5)  ; PHA
                            	  7618:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7619:     ;
02:0003CD0E 41F90003CC68    	  7620:     lea     (DodongoFrameHFlips).l,A0
02:0003CD14 10303000        	  7621:     move.b  (A0,D3.W),D0
02:0003CD18 1940000F        	  7622:     move.b  D0,($000F,A4)
02:0003CD1C 41F90003CC5E    	  7623:     lea     (DodongoFrameImages).l,A0
02:0003CD22 10303000        	  7624:     move.b  (A0,D3.W),D0
                            	  7625:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7626:     ; They are drawn mirrored.
                            	  7627:     ;
02:0003CD26 0C000007        	  7628:     cmpi.b  #$07,D0
02:0003CD2A 6706            	  7629:     beq  _anon_z04_92
02:0003CD2C 0C000009        	  7630:     cmpi.b  #$09,D0
02:0003CD30 6608            	  7631:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7632: _anon_z04_92:
02:0003CD32 4EB900031776    	  7633:     jsr     DrawObjectMirrored
02:0003CD38 6006            	  7634:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7635: 
                            	  7636:     even
                            	  7637: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7638:     ; No other frame images are mirrored.
                            	  7639:     ;
02:0003CD3A 4EB90003177A    	  7640:     jsr     DrawObjectNotMirrored
                            	  7641:     even
                            	  7642: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD40 101D            	  7643:     move.b  (A5)+,D0  ; PLA
02:0003CD42 7600            	  7644:     moveq   #0,D3
02:0003CD44 1600            	  7645:     move.b  D0,D3
                            	  7646:     ; If facing vertically, then return. There's no other side to draw.
                            	  7647:     ;
02:0003CD46 41EC0098        	  7648:     lea     ($0098,A4),A0
02:0003CD4A 10302000        	  7649:     move.b  (A0,D2.W),D0
02:0003CD4E 02000003        	  7650:     andi.b #$03,D0
02:0003CD52 6602            	  7651:     bne.s  __far_z_04_0072
02:0003CD54 602E            	  7652:     jmp  L11B00_Exit
                            	  7653: __far_z_04_0072:
                            	  7654:     ; Else draw the right side.
                            	  7655:     ;
                            	  7656:     ; Keep the Y coordinate in [01].
                            	  7657:     ; But, store (X + $10) in [00].
                            	  7658:     ;
02:0003CD56 10342070        	  7659:     move.b  ($70,A4,D2.W),D0
02:0003CD5A 023C00EE        	  7660:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD5E 123C0010        	  7661:     move.b  #$10,D1
02:0003CD62 D101            	  7662:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD64 1880            	  7663:     move.b  D0,($0000,A4)
02:0003CD66 6114            	  7664:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7665:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7666:     ;
                            	  7667:     ; So, if we had animation frame 1, direction left:
                            	  7668:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7669:     ; - frame image index = 6 (1 + 5)
                            	  7670:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7671:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7672:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7673:     ;
                            	  7674:     ; So, 3 would have been the frame number used above for
                            	  7675:     ; the left side.
                            	  7676:     ;
                            	  7677:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7678:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7679:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7680:     ; on the right.
                            	  7681:     ;
02:0003CD68 41F90003CC5E    	  7682:     lea     (DodongoFrameImages).l,A0
02:0003CD6E 10303000        	  7683:     move.b  (A0,D3.W),D0
02:0003CD72 0A000001        	  7684:     eori.b #$01,D0
02:0003CD76 4EF90003177A    	  7685:     jmp     DrawObjectNotMirrored
                            	  7686: 
                            	  7687: ; Returns:
                            	  7688: ; A: 3
                            	  7689: ; [04]: left sprite attributes
                            	  7690: ; [05]: right sprite attributes
                            	  7691: ;
                            	  7692:     even
                            	  7693: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD7C 7003            	  7694:     moveq   #3,D0
02:0003CD7E 4EB900031A6C    	  7695:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7696:     even
