02:0003D1E0 41EC03E4        	  8226:     lea     ($03E4,A4),A0
02:0003D1E4 11802000        	  8227:     move.b  D0,(A0,D2.W)
02:0003D1E8 7004            	  8228:     moveq   #4,D0
02:0003D1EA 41EC03D0        	  8229:     lea     ($03D0,A4),A0
02:0003D1EE 11802000        	  8230:     move.b  D0,(A0,D2.W)
                            	  8231:     ; Now Link can't move.
                            	  8232:     ;
02:0003D1F2 522C0512        	  8233:     addq.b  #1,($0512,A4)
                            	  8234:     even
