02:00031ED8 19400006        	  6963:     move.b  D0,($0006,A4)
                            	  6964:     ; If the weapon's not active (state = 0), then return.
                            	  6965:     ;
02:00031EDC 7600            	  6966:     moveq   #0,D3
02:00031EDE 1614            	  6967:     move.b  ($0000,A4),D3
02:00031EE0 41EC00AC        	  6968:     lea     ($00AC,A4),A0
02:00031EE4 10303000        	  6969:     move.b  (A0,D3.W),D0
02:00031EE8 6604            	  6970:     bne.s  __far_z_01_0071
02:00031EEA 6000010C        	  6971:     jmp  L74D8_Exit
