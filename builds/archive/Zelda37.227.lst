                            	  7592:     ; Shouldn't it be based on the weapon's direction?
                            	  7593:     ;
02:000322A2 10343070        	  7594:     move.b  ($70,A4,D3.W),D0
02:000322A6 023C00EE        	  7595:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322AA 123C0008        	  7596:     move.b  #$08,D1
02:000322AE D101            	  7597:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000322B0 19400004        	  7598:     move.b  D0,($0004,A4)
02:000322B4 41EC0084        	  7599:     lea     ($0084,A4),A0
02:000322B8 10303000        	  7600:     move.b  (A0,D3.W),D0
02:000322BC 023C00EE        	  7601:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322C0 123C0006        	  7602:     move.b  #$06,D1
02:000322C4 D101            	  7603:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7604: _anon_z01_98:
                            	  7605:     ; The A register will be copied to [05] and used here.
                            	  7606:     ;
02:000322C6 6000FC0A        	  7607:     jmp     CheckMonsterWeaponCollision
                            	  7608: 
                            	  7609: ; Params:
                            	  7610: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7611: ; [00]: weapon object slot (unused)
                            	  7612: ; [02]: object 1 mid X
                            	  7613: ; [03]: object 1 mid Y
                            	  7614: ; [04]: object 2 mid X
                            	  7615: ; [05]: object 2 mid Y
                            	  7616: ;
                            	  7617: ; Returns:
                            	  7618: ; A: 1 if objects collide
                            	  7619: ; Y: weapon object slot
                            	  7620: ; Z: 0 if objects collide
                            	  7621: ; [06]: 1 if objects collide
                            	  7622: ; [0A]: horizontal distance
                            	  7623: ; [0B]: vertical distance
                            	  7624: ;
                            	  7625: ;
                            	  7626: ; Use the same threshold value horizontally and vertically.
                            	  7627: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7628: ;
                            	  7629:     even
                            	  7630: DoObjectsCollide:
02:000322CA 1940000D        	  7631:     move.b  D0,($000D,A4)
02:000322CE 1940000E        	  7632:     move.b  D0,($000E,A4)
                            	  7633: ; Params:
                            	  7634: ; [00]: weapon or Link object slot (unused)
                            	  7635: ; [02]: object 1 mid X
                            	  7636: ; [03]: object 1 mid Y
                            	  7637: ; [04]: object 2 mid X
                            	  7638: ; [05]: object 2 mid Y
                            	  7639: ; [0D]: horizontal threshold
                            	  7640: ; [0E]: vertical threshold
                            	  7641: ;
                            	  7642: ; Returns:
                            	  7643: ; A: 1 if objects collide
                            	  7644: ; Y: weapon or Link object slot (copied from [00])
                            	  7645: ; Z: 0 if objects collide
                            	  7646: ; [06]: 1 if objects collide
                            	  7647: ; [0A]: horizontal distance
                            	  7648: ; [0B]: vertical distance
                            	  7649: ;
                            	  7650: ;
                            	  7651: ; Reset [06] to indicate no collision by default.
                            	  7652: ;
                            	  7653:     even
                            	  7654: DoObjectsCollideWithThresholds:
02:000322D2 7000            	  7655:     moveq   #0,D0
02:000322D4 19400006        	  7656:     move.b  D0,($0006,A4)
02:000322D8 7600            	  7657:     moveq   #0,D3
02:000322DA 1614            	  7658:     move.b  ($0000,A4),D3
                            	  7659:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7660:     ;
02:000322DC 102C0002        	  7661:     move.b  ($0002,A4),D0
02:000322E0 003C0011        	  7662:     ori     #$11,CCR  ; SEC: set C+X
02:000322E4 122C0004        	  7663:     move.b  ($0004,A4),D1
02:000322E8 0A3C0010        	  7664:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000322EC 9101            	  7665:     subx.b  D1,D0   ; SBC $04
02:000322EE 0A3C0010        	  7666:     eori    #$10,CCR  ; restore X = 6502 C
02:000322F2 6100E908        	  7667:     jsr     Abs
02:000322F6 1940000A        	  7668:     move.b  D0,($000A,A4)
                            	  7669:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7670:     ;
02:000322FA 122C000D        	  7671:     move.b  ($000D,A4),D1
02:000322FE B001            	  7672:     cmp.b   D1,D0
02:00032300 642A            	  7673:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7674:     ; Store in [0B] the vertical distance between the two objects.
                            	  7675:     ;
02:00032302 102C0003        	  7676:     move.b  ($0003,A4),D0
02:00032306 003C0011        	  7677:     ori     #$11,CCR  ; SEC: set C+X
02:0003230A 122C0005        	  7678:     move.b  ($0005,A4),D1
02:0003230E 0A3C0010        	  7679:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032312 9101            	  7680:     subx.b  D1,D0   ; SBC $05
02:00032314 0A3C0010        	  7681:     eori    #$10,CCR  ; restore X = 6502 C
02:00032318 6100E8E2        	  7682:     jsr     Abs
02:0003231C 1940000B        	  7683:     move.b  D0,($000B,A4)
                            	  7684:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7685:     ;
02:00032320 122C000E        	  7686:     move.b  ($000E,A4),D1
02:00032324 B001            	  7687:     cmp.b   D1,D0
02:00032326 6404            	  7688:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7689:     ; If we get here, then the objects are close enough in both axes.
                            	  7690:     ; Return 1.
                            	  7691:     ;
02:00032328 522C0006        	  7692:     addq.b  #1,($0006,A4)
                            	  7693:     even
                            	  7694: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:0003232C 102C0006        	  7695:     move.b  ($0006,A4),D0
02:00032330 4E75            	  7696:     rts
                            	  7697: 
                            	  7698: ; Params:
                            	  7699: ; X: caller's object index, a monster
                            	  7700: ;    the attacker, if monster attacks Link
                            	  7701: ;    else defender, if weapon attacks monster
                            	  7702: ; [00]: 0 if monster attacks Link (defender),
                            	  7703: ;       else weapon slot (attacker)
                            	  7704: ; [09]: damage type,
                            	  7705: ;       only if a monster is defending
                            	  7706: ; TODO:
                            	  7707: ; [0B]: direction
                            	  7708: ;
                            	  7709: ; Only monsters (and fire) call this routine.
                            	  7710: ;
                            	  7711: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7712: ;
                            	  7713: ; On the other hand, if a weapon attacks a monster,
                            	  7714: ; the monster sets [00] to the weapon's slot.
                            	  7715: ;
                            	  7716: ;
                            	  7717: ; If a weapon attacks a monster, and the weapon's damage
                            	  7718: ; type matches the monster's invincibility mask;
                            	  7719: ; then return without shoving.
                            	  7720: ;
                            	  7721: ; If a monster attacks Link, then damage type will be 0.
                            	  7722: ;
                            	  7723:     even
                            	  7724: BeginShove:
02:00032332 7600            	  7725:     moveq   #0,D3
02:00032334 1614            	  7726:     move.b  ($0000,A4),D3
02:00032336 0C02000D        	  7727:     cmpi.b  #$0D,D2
02:0003233A 6412            	  7728:     bcc  _anon_z01_99
02:0003233C 41EC04B2        	  7729:     lea     ($04B2,A4),A0
02:00032340 10302000        	  7730:     move.b  (A0,D2.W),D0
02:00032344 122C0009        	  7731:     move.b  ($0009,A4),D1
02:00032348 C001            	  7732:     and.b  D1,D0
02:0003234A 660000C4        	  7733:     bne  _L_z01_BeginShove_Exit
                            	  7734: _anon_z01_99:
                            	  7735:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7736:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7737:     ;
                            	  7738:     ; If instead a monster is defending, then all this calculation
                            	  7739:     ; won't matter, because the shove direction will be set to the
                            	  7740:     ; weapon's direction.
                            	  7741:     ;
                            	  7742:     ; As such, calculate a direction from the monster to the defender,
                            	  7743:     ; assuming it's Link.
                            	  7744:     ;
                            	  7745:     ; Start with an assumption that the direction is vertical:
                            	  7746:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7747:     ;
02:0003234E 7008            	  7748:     moveq   #8,D0
02:00032350 19400008        	  7749:     move.b  D0,($0008,A4)
02:00032354 41EC0084        	  7750:     lea     ($0084,A4),A0
02:00032358 10302000        	  7751:     move.b  (A0,D2.W),D0
02:0003235C 19400004        	  7752:     move.b  D0,($0004,A4)
02:00032360 41EC0084        	  7753:     lea     ($0084,A4),A0
02:00032364 10303000        	  7754:     move.b  (A0,D3.W),D0
02:00032368 19400005        	  7755:     move.b  D0,($0005,A4)
                            	  7756:     ; If the defender is Link and his grid offset <> 0 then
                            	  7757:     ; use his usual object direction variable to determine
                            	  7758:     ; which axis to check.
                            	  7759:     ;
02:0003236C 4A03            	  7760:     cmpi.b  #$00,D3
02:0003236E 6612            	  7761:     bne  _anon_z01_100
02:00032370 102C0394        	  7762:     move.b  ($0394,A4),D0
02:00032374 670C            	  7763:     beq  _anon_z01_100
02:00032376 102C0098        	  7764:     move.b  ($0098,A4),D0
02:0003237A 02000003        	  7765:     andi.b #$03,D0
02:0003237E 660C            	  7766:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032380 6720            	  7767:     beq  _L_z01_BeginShove_CheckVertical
                            	  7768: _anon_z01_100:
                            	  7769:     ; For monsters defending, or Link with grid offset = 0,
                            	  7770:     ; check direction in [0B].
                            	  7771:     ;
                            	  7772:     ; For monsters defending, this won't matter. For Link with grid
                            	  7773:     ; offset = 0, I believe the result will be arbitrary.
                            	  7774:     ;
                            	  7775:     ; TODO:
                            	  7776:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7777:     ; It doesn't seem to be if candle fire attacks him.
                            	  7778:     ;
02:00032382 102C000B        	  7779:     move.b  ($000B,A4),D0
02:00032386 0C000004        	  7780:     cmpi.b  #$04,D0
02:0003238A 6416            	  7781:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7782:     even
                            	  7783: _L_z01_BeginShove_CheckHorizontal:
                            	  7784:     ; If the direction checked is left or right,
                            	  7785:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7786:     ;
02:0003238C 7002            	  7787:     moveq   #2,D0
02:0003238E 19400008        	  7788:     move.b  D0,($0008,A4)
02:00032392 10342070        	  7789:     move.b  ($70,A4,D2.W),D0
02:00032396 19400004        	  7790:     move.b  D0,($0004,A4)
02:0003239A 10343070        	  7791:     move.b  ($70,A4,D3.W),D0
02:0003239E 19400005        	  7792:     move.b  D0,($0005,A4)
                            	  7793:     even
                            	  7794: _L_z01_BeginShove_CheckVertical:
                            	  7795:     ; If the monster is down or right of the other object,
                            	  7796:     ; then use the opposite direction already in [08].
                            	  7797:     ; Else shift [08] right to turn it into the opposite
                            	  7798:     ; direction up or down.
                            	  7799:     ;
                            	  7800:     ; Again assuming Link is the defender; after this, [08] points
                            	  7801:     ; Link away from the monster.
                            	  7802:     ;
02:000323A2 102C0004        	  7803:     move.b  ($0004,A4),D0
02:000323A6 122C0005        	  7804:     move.b  ($0005,A4),D1
02:000323AA B001            	  7805:     cmp.b   D1,D0
02:000323AC 640A            	  7806:     bcc  _anon_z01_101
02:000323AE 122C0008        	  7807:     move.b  ($0008,A4),D1
02:000323B2 E209            	  7808:     lsr.b  #1,D1   ; LSR $08
02:000323B4 19410008        	  7809:     move.b  D1,($0008,A4)
                            	  7810: _anon_z01_101:
                            	  7811:     ; If a monster is the defender, go handle it separately.
                            	  7812:     ;
02:000323B8 4A03            	  7813:     cmpi.b  #$00,D3
02:000323BA 6656            	  7814:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7815:     ; Link is the defender.
                            	  7816:     ;
                            	  7817:     ; If Link is invincible, return without shoving.
                            	  7818:     ;
02:000323BC 102C04F0        	  7819:     move.b  ($04F0,A4),D0
02:000323C0 664E            	  7820:     bne  _L_z01_BeginShove_Exit
                            	  7821:     ; Store the shove direction we determined.
                            	  7822:     ;
                            	  7823:     ; Turn on the high bit to indicate that the next time we try to
                            	  7824:     ; move by shoving, it will be the first time for this shove action.
                            	  7825:     ;
02:000323C2 102C0008        	  7826:     move.b  ($0008,A4),D0
02:000323C6 00000080        	  7827:     ori.b #$80,D0
02:000323CA 194000C0        	  7828:     move.b  D0,($00C0,A4)
                            	  7829:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7830:     ;
02:000323CE 7018            	  7831:     moveq   #24,D0
02:000323D0 194004F0        	  7832:     move.b  D0,($04F0,A4)
02:000323D4 7020            	  7833:     moveq   #32,D0
02:000323D6 194000D3        	  7834:     move.b  D0,($00D3,A4)
                            	  7835:     ; If Link was shoved by one of his own weapons, then
                            	  7836:     ; nothing else to do. Return.
                            	  7837:     ;
02:000323DA 0C02000D        	  7838:     cmpi.b  #$0D,D2
02:000323DE 6430            	  7839:     bcc  _L_z01_BeginShove_Exit
                            	  7840:     ; Link was shoved by a monster.
                            	  7841:     ;
                            	  7842:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7843:     ; then return.
                            	  7844:     ;
02:000323E0 41EC04BF        	  7845:     lea     ($04BF,A4),A0
02:000323E4 10302000        	  7846:     move.b  (A0,D2.W),D0
02:000323E8 02000080        	  7847:     andi.b #$80,D0
02:000323EC 6622            	  7848:     bne  _L_z01_BeginShove_Exit
                            	  7849:     ; If the attacker is a vire, then return.
                            	  7850:     ;
02:000323EE 41EC034F        	  7851:     lea     ($034F,A4),A0
02:000323F2 10302000        	  7852:     move.b  (A0,D2.W),D0
02:000323F6 0C000012        	  7853:     cmpi.b  #$12,D0
02:000323FA 6714            	  7854:     beq  _L_z01_BeginShove_Exit
                            	  7855:     ; Turn the attacker in the opposite direction.
                            	  7856:     ;
02:000323FC 41EC0098        	  7857:     lea     ($0098,A4),A0
02:00032400 10302000        	  7858:     move.b  (A0,D2.W),D0
02:00032404 6100E7F2        	  7859:     jsr     GetOppositeDir
02:00032408 41EC0098        	  7860:     lea     ($0098,A4),A0
02:0003240C 11802000        	  7861:     move.b  D0,(A0,D2.W)
                            	  7862:     even
