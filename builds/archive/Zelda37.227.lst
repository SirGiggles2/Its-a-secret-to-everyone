02:00030D0C 9101            	  4616:     subx.b  D1,D0   ; SBC $04
02:00030D0E 0A3C0010        	  4617:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D12 19400003        	  4618:     move.b  D0,($0003,A4)
02:00030D16 122C0004        	  4619:     move.b  ($0004,A4),D1
02:00030D1A B001            	  4620:     cmp.b   D1,D0
02:00030D1C 64C8            	  4621:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
