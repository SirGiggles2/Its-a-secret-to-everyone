02:0003C7D2 41EC0478        	  6825:     lea     ($0478,A4),A0
02:0003C7D6 12302000        	  6826:     move.b  (A0,D2.W),D1
02:0003C7DA D101            	  6827:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C7DC 41EC0084        	  6828:     lea     ($0084,A4),A0
