                            	 11143:     ; If the segment is not a head, then skip making a flying head.
                            	 11144:     ;
                            	 11145:     ; TODO:
                            	 11146:     ; But how can we get here in this case, since earlier branches
                            	 11147:     ; would have been taken to skip all this for all other segments?
                            	 11148:     ;
02:0003E780 0C020005        	 11149:     cmpi.b  #$05,D2
