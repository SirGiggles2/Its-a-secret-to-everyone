02:0002FEA0 10342070        	  2442:     move.b  ($70,A4,D2.W),D0
02:0002FEA4 0C0000F0        	  2443:     cmpi.b  #$F0,D0
02:0002FEA8 6518            	  2444:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445:     ; The whirlwind has reached the right edge of the screen.
