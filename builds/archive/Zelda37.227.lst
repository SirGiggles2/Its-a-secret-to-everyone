                            	  7843: _L_z04_UpdatePolsVoice_State0:
                            	  7844:     ; State 0. Walking.
                            	  7845:     ;
                            	  7846:     ; If grid offset = 0, then no more distance to cover.
                            	  7847:     ; So, go change to state 1 -- jumping.
                            	  7848:     ;
02:0003CEB8 41EC0394        	  7849:     lea     ($0394,A4),A0
