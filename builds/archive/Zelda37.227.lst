                            	  4097:     ;
02:0003B396 102C0029        	  4098:     move.b  ($0029,A4),D0
02:0003B39A 660A            	  4099:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4100:     ; Else go to state 3, and unhalt Link.
