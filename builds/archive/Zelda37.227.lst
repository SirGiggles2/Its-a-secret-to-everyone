                            	  6096: _anon_z05_120:
                            	  6097:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6098:     ;
                            	  6099:     ; Shutters and the commands to open a door always change
                            	  6100:     ; tiles.
                            	  6101:     ;
02:00043A3A 61000130        	  6102:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6103:     even
                            	  6104: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6105:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6106:     ; We need to remember how many tiles need to be copied
                            	  6107:     ; in each transfer record.
                            	  6108:     ;
02:00043A3E 102C0006        	  6109:     move.b  ($0006,A4),D0
02:00043A42 19400004        	  6110:     move.b  D0,($0004,A4)
                            	  6111:     ; Write the transfer record header for the door.
                            	  6112:     ;
                            	  6113:     ;
                            	  6114:     ; VRAM address high byte of door
02:00043A46 1014            	  6115:     move.b  ($0000,A4),D0
02:00043A48 41EC0302        	  6116:     lea     ($0302,A4),A0
02:00043A4C 11802000        	  6117:     move.b  D0,(A0,D2.W)
02:00043A50 5202            	  6118:     addq.b  #1,D2
02:00043A52 102C0001        	  6119:     move.b  ($0001,A4),D0
02:00043A56 41EC0302        	  6120:     lea     ($0302,A4),A0
02:00043A5A 11802000        	  6121:     move.b  D0,(A0,D2.W)
02:00043A5E 5202            	  6122:     addq.b  #1,D2
02:00043A60 102C0006        	  6123:     move.b  ($0006,A4),D0
02:00043A64 41EC0302        	  6124:     lea     ($0302,A4),A0
02:00043A68 11802000        	  6125:     move.b  D0,(A0,D2.W)
02:00043A6C 5202            	  6126:     addq.b  #1,D2
                            	  6127: _anon_z05_121:
                            	  6128:     ; Write two tiles in a short loop indexed by [04].
                            	  6129:     ;
02:00043A6E 6100ED1C        	  6130:     jsr     WriteDoorFaceTileHorizontally
02:00043A72 66FA            	  6131:     bne  _anon_z05_121
                            	  6132:     ; OR the low VRAM address with $20 to go down one row
                            	  6133:     ; in order to work on the second row of door tiles.
                            	  6134:     ;
02:00043A74 7020            	  6135:     moveq   #32,D0
02:00043A76 122C0001        	  6136:     move.b  ($0001,A4),D1
02:00043A7A 8001            	  6137:     or.b  D1,D0
02:00043A7C 19400001        	  6138:     move.b  D0,($0001,A4)
                            	  6139:     ; Bottom of the loop.
                            	  6140:     ; Loop again to write the second transfer record for the
                            	  6141:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6142:     ;
02:00043A80 532C0005        	  6143:     subq.b  #1,($0005,A4)
02:00043A84 66B8            	  6144:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6145:     ; Write the end marker, and update buffer length.
                            	  6146:     ;
02:00043A86 103C00FF        	  6147:     move.b  #$FF,D0
02:00043A8A 41EC0302        	  6148:     lea     ($0302,A4),A0
02:00043A8E 11802000        	  6149:     move.b  D0,(A0,D2.W)
02:00043A92 1002            	  6150:     move.b  D2,D0
02:00043A94 19400301        	  6151:     move.b  D0,($0301,A4)
                            	  6152:     ; Increment the command.
                            	  6153:     ;
02:00043A98 522C0054        	  6154:     addq.b  #1,($0054,A4)
                            	  6155:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6156:     ; and resetting the door command.
                            	  6157:     ; This ends up catching original states 3 and 7.
                            	  6158:     ;
                            	  6159:     ; Else set door timer to 8 and return.
                            	  6160:     ;
02:00043A9C 102C0054        	  6161:     move.b  ($0054,A4),D0
02:00043AA0 02000003        	  6162:     andi.b #$03,D0
02:00043AA4 6708            	  6163:     beq  _anon_z05_122
02:00043AA6 7008            	  6164:     moveq   #8,D0
02:00043AA8 19400027        	  6165:     move.b  D0,($0027,A4)
02:00043AAC 4E75            	  6166:     rts
                            	  6167: 
                            	  6168: _anon_z05_122:
                            	  6169:     ; If the door command = 4 after incrementing it, then
                            	  6170:     ; it was 3 (close door). So:
                            	  6171:     ; 1. reset this door's flag
                            	  6172:     ; 2. remove it from the opened door mask
                            	  6173:     ; 3. reset the door command
                            	  6174:     ; 4. go lay out doors in the play area map
                            	  6175:     ;
02:00043AAE 102C0054        	  6176:     move.b  ($0054,A4),D0
02:00043AB2 0C000004        	  6177:     cmpi.b  #$04,D0
02:00043AB6 6626            	  6178:     bne  _anon_z05_123
02:00043AB8 7400            	  6179:     moveq   #0,D2
02:00043ABA 142C0009        	  6180:     move.b  ($0009,A4),D2
02:00043ABE 6100DB5C        	  6181:     jsr     ResetDoorFlag
02:00043AC2 102C0055        	  6182:     move.b  ($0055,A4),D0
02:00043AC6 0A00000F        	  6183:     eori.b #$0F,D0
02:00043ACA 122C00EE        	  6184:     move.b  ($00EE,A4),D1
