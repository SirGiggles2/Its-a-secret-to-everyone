                            	  6704: __far_z_01_0068:
                            	  6705:     ; If Link and the shot are not facing opposite directions,
                            	  6706:     ; then go harm Link.
                            	  6707:     ;
                            	  6708:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6709:     ; component of a monster that can move diagonally.
                            	  6710:     ;
02:00031D12 102C0098        	  6711:     move.b  ($0098,A4),D0
