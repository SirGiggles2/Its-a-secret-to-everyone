02:0003F526 7402            	 13028:     moveq   #2,D2
                            	 13029:     even
                            	 13030: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F528 19420340        	 13031:     move.b  D2,($0340,A4)
                            	 13032:     ; If object slot < 5 or = 7, then move every frame.
                            	 13033:     ; Else move 3 out of every 4 frames.
                            	 13034:     ;
                            	 13035:     ; This makes pieces spread out in somewhat of a circle,
                            	 13036:     ; by making the pieces at cardinal directions move at
                            	 13037:     ; full speed while the diagonal ones move a little slower.
                            	 13038:     ;
02:0003F52C 0C020005        	 13039:     cmpi.b  #$05,D2
02:0003F530 6510            	 13040:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F532 0C020007        	 13041:     cmpi.b  #$07,D2
02:0003F536 670A            	 13042:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F538 102C0015        	 13043:     move.b  ($0015,A4),D0
02:0003F53C 02000003        	 13044:     andi.b #$03,D0
02:0003F540 6704            	 13045:     beq  _anon_z04_164
