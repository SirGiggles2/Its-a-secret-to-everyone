02:00030E7E 41EC03A8        	  4868:     lea     ($03A8,A4),A0
02:00030E82 11802000        	  4869:     move.b  D0,(A0,D2.W)
02:00030E86 7020            	  4870:     moveq   #32,D0
02:00030E88 41EC03BC        	  4871:     lea     ($03BC,A4),A0
