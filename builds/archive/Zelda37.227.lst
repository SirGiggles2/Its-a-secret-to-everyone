                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:0003362E 4EB90004ABBE    	   518:     jsr     TurnOffAllVideo
02:00033634 7000            	   519:     moveq   #0,D0
02:00033636 19400016        	   520:     move.b  D0,($0016,A4)
02:0003363A 6100D18C        	   521:     jsr     FetchFileAAddressSet
02:0003363E 7602            	   522:     moveq   #2,D3
                            	   523:     even
