                            	  6807: _anon_z01_86:
02:00031DBC 122C000D        	  6808:     move.b  ($000D,A4),D1
02:00031DC0 E209            	  6809:     lsr.b  #1,D1   ; LSR $0D
02:00031DC2 1941000D        	  6810:     move.b  D1,($000D,A4)
02:00031DC6 122C000E        	  6811:     move.b  ($000E,A4),D1
02:00031DCA E211            	  6812:     roxr.b  #1,D1   ; ROR $0E
02:00031DCC 1941000E        	  6813:     move.b  D1,($000E,A4)
02:00031DD0 5303            	  6814:     subq.b  #1,D3
02:00031DD2 66E8            	  6815:     bne  _anon_z01_86
