02:000366F6 7400            	  5058:     moveq   #0,D2
02:000366F8 142C0016        	  5059:     move.b  ($0016,A4),D2
02:000366FC 41EC062D        	  5060:     lea     ($062D,A4),A0
02:00036700 10302000        	  5061:     move.b  (A0,D2.W),D0
02:00036704 6702            	  5062:     beq  _anon_z02_40
02:00036706 5203            	  5063:     addq.b  #1,D3
