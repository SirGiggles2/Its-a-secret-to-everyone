                            	  3738:     ;
02:0003B176 41EC0098        	  3739:     lea     ($0098,A4),A0
02:0003B17A 10302000        	  3740:     move.b  (A0,D2.W),D0
02:0003B17E 02000002        	  3741:     andi.b #$02,D0
02:0003B182 6704            	  3742:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
