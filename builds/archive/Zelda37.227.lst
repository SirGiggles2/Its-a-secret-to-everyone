                            	  7434: ChangePlayMapSquareOW:
02:00044634 1002            	  7435:     move.b  D2,D0
02:00044636 1B00            	  7436:     move.b  D0,-(A5)  ; PHA
                            	  7437:     ; We're dealing with squares.
                            	  7438:     ; So, align the object's X coordinate with 16 pixels.
                            	  7439:     ;
02:00044638 10342070        	  7440:     move.b  ($70,A4,D2.W),D0
02:0004463C 020000F0        	  7441:     andi.b #$F0,D0
                            	  7442:     ; Divide it by 4 to get the offset of the address of the column
                            	  7443:     ; in play area map.
                            	  7444:     ;
                            	  7445:     ; The calculation is: address offset = (X / 8) * 2
                            	  7446:     ; 8 for the width of the column; 2 for the width of the address
                            	  7447:     ;
02:00044640 E208            	  7448:     lsr.b  #1,D0   ; LSR A
02:00044642 E208            	  7449:     lsr.b  #1,D0   ; LSR A
02:00044644 7400            	  7450:     moveq   #0,D2
02:00044646 1400            	  7451:     move.b  D0,D2
                            	  7452:     ; Store the address of the column in [00:01].
                            	  7453:     ;
02:00044648 41F90004A87A    	  7454:     lea     (PlayAreaColumnAddrs).l,A0
02:0004464E 10302000        	  7455:     move.b  (A0,D2.W),D0
02:00044652 1880            	  7456:     move.b  D0,($0000,A4)
02:00044654 41F90004A87B    	  7457:     lea     (PlayAreaColumnAddrs+1).l,A0
02:0004465A 10302000        	  7458:     move.b  (A0,D2.W),D0
02:0004465E 19400001        	  7459:     move.b  D0,($0001,A4)
02:00044662 101D            	  7460:     move.b  (A5)+,D0  ; PLA
02:00044664 1B00            	  7461:     move.b  D0,-(A5)  ; PHA
02:00044666 7400            	  7462:     moveq   #0,D2
02:00044668 1400            	  7463:     move.b  D0,D2
                            	  7464:     ; Align the object's Y coordinate with 16 pixels.
                            	  7465:     ;
02:0004466A 41EC0084        	  7466:     lea     ($0084,A4),A0
02:0004466E 10302000        	  7467:     move.b  (A0,D2.W),D0
02:00044672 020000F0        	  7468:     andi.b #$F0,D0
                            	  7469:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7470:     ; the height of each row.
                            	  7471:     ;
02:00044676 003C0011        	  7472:     ori     #$11,CCR  ; SEC: set C+X
02:0004467A 123C0040        	  7473:     move.b  #$40,D1
02:0004467E 0A3C0010        	  7474:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044682 9101            	  7475:     subx.b  D1,D0   ; SBC #$40
02:00044684 0A3C0010        	  7476:     eori    #$10,CCR  ; restore X = 6502 C
02:00044688 E208            	  7477:     lsr.b  #1,D0   ; LSR A
02:0004468A E208            	  7478:     lsr.b  #1,D0   ; LSR A
02:0004468C E208            	  7479:     lsr.b  #1,D0   ; LSR A
                            	  7480:     ; Add this row offset to the column address.
                            	  7481:     ;
02:0004468E 4EB90003104E    	  7482:     jsr     AddToInt16At0
                            	  7483:     ; Assume that we'll write a type 1 square with primary square
                            	  7484:     ; taken from [05]. If so, the square index doesn't matter
                            	  7485:     ; as long as >= $10. See WriteSquareOW.
                            	  7486:     ;
02:00044694 7600            	  7487:     moveq   #0,D3
02:00044696 7410            	  7488:     moveq   #16,D2
02:00044698 102C0005        	  7489:     move.b  ($0005,A4),D0
                            	  7490:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7491:     ; So, we have to look up the square index corresponding
                            	  7492:     ; to primary square/tile in [05].
                            	  7493:     ;
                            	  7494:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7495:     ; then the X register will have the square index value.
                            	  7496:     ;
02:0004469C 0C000027        	  7497:     cmpi.b  #$27,D0
