02:0003DEAC 123C0080        	  9951:     move.b  #$80,D1
02:0003DEB0 D101            	  9952:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DEB2 41EC041F        	  9953:     lea     ($041F,A4),A0
02:0003DEB6 11802000        	  9954:     move.b  D0,(A0,D2.W)
                            	  9955:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9956:     ;
02:0003DEBA 640000A8        	  9957:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9958:     ; Increase the distance traveled, and move 1.
                            	  9959:     ;
02:0003DEBE 41EC0412        	  9960:     lea     ($0412,A4),A0
02:0003DEC2 52302000        	  9961:     addq.b  #1,(A0,D2.W)
                            	  9962:     ; Set a direction mask in [02], starting with right (1).
                            	  9963:     ;
02:0003DEC6 7001            	  9964:     moveq   #1,D0
02:0003DEC8 19400002        	  9965:     move.b  D0,($0002,A4)
                            	  9966:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9967:     ;
02:0003DECC 41EC0098        	  9968:     lea     ($0098,A4),A0
02:0003DED0 10302000        	  9969:     move.b  (A0,D2.W),D0
02:0003DED4 122C0002        	  9970:     move.b  ($0002,A4),D1
02:0003DED8 C200            	  9971:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEDA 6704            	  9972:     beq  _anon_z04_118
02:0003DEDC 52342070        	  9973:     addq.b  #1,($70,A4,D2.W)
                            	  9974: _anon_z04_118:
                            	  9975:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9976:     ;
02:0003DEE0 122C0002        	  9977:     move.b  ($0002,A4),D1
02:0003DEE4 E309            	  9978:     lsl.b  #1,D1   ; ASL $02
02:0003DEE6 19410002        	  9979:     move.b  D1,($0002,A4)
02:0003DEEA 122C0002        	  9980:     move.b  ($0002,A4),D1
02:0003DEEE C200            	  9981:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEF0 6704            	  9982:     beq  _anon_z04_119
02:0003DEF2 53342070        	  9983:     subq.b  #1,($70,A4,D2.W)
                            	  9984: _anon_z04_119:
