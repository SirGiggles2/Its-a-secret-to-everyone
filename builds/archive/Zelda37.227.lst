02:0003228A 19400004        	  7578:     move.b  D0,($0004,A4)
02:0003228E 41EC0084        	  7579:     lea     ($0084,A4),A0
02:00032292 10303000        	  7580:     move.b  (A0,D3.W),D0
02:00032296 023C00EE        	  7581:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003229A 123C0008        	  7582:     move.b  #$08,D1
02:0003229E D101            	  7583:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
