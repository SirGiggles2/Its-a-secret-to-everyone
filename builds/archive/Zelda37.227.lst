                            	  2496: __far_z_01_0017:
                            	  2497:     ; If we have gotten this triforce piece, then go try to make a
                            	  2498:     ; whirlwind.
                            	  2499:     ;
02:0002FEFA 1214            	  2500:     move.b  ($0000,A4),D1
02:0002FEFC C200            	  2501:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FEFE 662C            	  2502:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2503:     ; We have not gotten this piece.
                            	  2504:     ; First, advance the teleporting index again.
                            	  2505:     ;
02:0002FF00 6150            	  2506:     jsr     AdvanceTeleportingLevelIndex
                            	  2507:     ; If the direction Link is facing is an increasing one, then
                            	  2508:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2509:     ; level number. Then go test this new mask.
                            	  2510:     ;
02:0002FF02 102C0098        	  2511:     move.b  ($0098,A4),D0
02:0002FF06 02000009        	  2512:     andi.b #$09,D0
02:0002FF0A 6710            	  2513:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FF0C 1214            	  2514:     move.b  ($0000,A4),D1
02:0002FF0E E309            	  2515:     lsl.b  #1,D1   ; ASL $00
02:0002FF10 1881            	  2516:     move.b  D1,($0000,A4)
02:0002FF12 64DE            	  2517:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FF14 1214            	  2518:     move.b  ($0000,A4),D1
02:0002FF16 E311            	  2519:     roxl.b  #1,D1   ; ROL $00
02:0002FF18 1881            	  2520:     move.b  D1,($0000,A4)
02:0002FF1A 60D6            	  2521:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
