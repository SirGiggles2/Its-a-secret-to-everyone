02:0003E7A4 102C0075        	 11167:     move.b  ($0075,A4),D0
02:0003E7A8 19802070        	 11168:     move.b  D0,($70,A4,D2.W)
02:0003E7AC 102C0089        	 11169:     move.b  ($0089,A4),D0
02:0003E7B0 41EC0084        	 11170:     lea     ($0084,A4),A0
02:0003E7B4 11802000        	 11171:     move.b  D0,(A0,D2.W)
                            	 11172:     ; Set object type $46 (flying head).
