                            	  5898:     ;
02:0004C8BE 7000            	  5899:     moveq   #0,D0
02:0004C8C0 41EC0394        	  5900:     lea     ($0394,A4),A0
02:0004C8C4 11802000        	  5901:     move.b  D0,(A0,D2.W)
                            	  5902:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5903:     ;
02:0004C8C8 0C02000D        	  5904:     cmpi.b  #$0D,D2
02:0004C8CC 6408            	  5905:     bcc  _anon_z07_30
02:0004C8CE 41EC042C        	  5906:     lea     ($042C,A4),A0
02:0004C8D2 10302000        	  5907:     move.b  (A0,D2.W),D0
                            	  5908: _anon_z07_30:
02:0004C8D6 4EB900030C50    	  5909:     jsr     GetDirectionsAndDistancesToTarget
                            	  5910:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5911:     ; then go move towards the thrower, draw, and check collisions.
                            	  5912:     ;
02:0004C8DC 1014            	  5913:     move.b  ($0000,A4),D0
02:0004C8DE 0C000002        	  5914:     cmpi.b  #$02,D0
02:0004C8E2 666A            	  5915:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5916:     ; The boomerang has reached the thrower.
                            	  5917:     ;
                            	  5918:     ; Reset the distance to move.
                            	  5919:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5920:     ;
02:0004C8E4 7000            	  5921:     moveq   #0,D0
02:0004C8E6 41EC0380        	  5922:     lea     ($0380,A4),A0
02:0004C8EA 11802000        	  5923:     move.b  D0,(A0,D2.W)
02:0004C8EE 0C02000D        	  5924:     cmpi.b  #$0D,D2
02:0004C8F2 6524            	  5925:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5926:     ; Link has caught the boomerang.
                            	  5927:     ;
                            	  5928:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5929:     ;
                            	  5930:     ; If Link catches it some time after throwing it,
                            	  5931:     ; his state will become $20, and he will show the catch animation.
                            	  5932:     ;
                            	  5933:     ; But if he catches it right after throwing it, the state becomes
                            	  5934:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5935:     ;
