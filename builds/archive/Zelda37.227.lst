                            	 14216:     even
                            	 14217: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 14218:     ; Second, calculate a vertical component.
                            	 14219:     ; Combine it with the horizontal component:
                            	 14220:     ;
                            	 14221:     ; Y := 4 (down)
                            	 14222:     ; if observed player Y <> object Y then
                            	 14223:     ;   if observed player Y < object Y then
                            	 14224:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 14225:     ;   [00] := [00] | Y
                            	 14226:     ;
02:0003FD94 7601            	 14227:     moveq   #1,D3
02:0003FD96 102C0062        	 14228:     move.b  ($0062,A4),D0
02:0003FD9A 41EC0084        	 14229:     lea     ($0084,A4),A0
02:0003FD9E 12302000        	 14230:     move.b  (A0,D2.W),D1
