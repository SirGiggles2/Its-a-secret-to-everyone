                            	  6195: _anon_z05_123:
                            	  6196:     ; Door command <> 4.
                            	  6197:     ; It must be 8, which means it was 7: open door.
                            	  6198:     ;
                            	  6199:     ; If the door is a shutter (7), then go add the door to the
                            	  6200:     ; opened door mask, reset door command, and lay out doors.
                            	  6201:     ;
02:00043ADE 102C0055        	  6202:     move.b  ($0055,A4),D0
02:00043AE2 19400002        	  6203:     move.b  D0,($0002,A4)
02:00043AE6 6100FA32        	  6204:     jsr     FindDoorAttrByDoorBit
02:00043AEA 0C000007        	  6205:     cmpi.b  #$07,D0
02:00043AEE 676E            	  6206:     beq  _anon_z05_124
                            	  6207:     ; Else the door is not a shutter.
                            	  6208:     ;
                            	  6209:     ;
                            	  6210:     ; [09] door direction index
02:00043AF0 7400            	  6211:     moveq   #0,D2
02:00043AF2 142C0009        	  6212:     move.b  ($0009,A4),D2
02:00043AF6 6100DB1E        	  6213:     jsr     SetDoorFlag
                            	  6214:     ; Get the next room's ID.
                            	  6215:     ;
02:00043AFA 1003            	  6216:     move.b  D3,D0
02:00043AFC 023C00EE        	  6217:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043B00 41F9000439BC    	  6218:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043B06 12302000        	  6219:     move.b  (A0,D2.W),D1
02:00043B0A D101            	  6220:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043B0C 7600            	  6221:     moveq   #0,D3
02:00043B0E 1600            	  6222:     move.b  D0,D3
                            	  6223:     ; Flip the door direction index.
                            	  6224:     ;
02:00043B10 1002            	  6225:     move.b  D2,D0
02:00043B12 0A000001        	  6226:     eori.b #$01,D0
02:00043B16 7400            	  6227:     moveq   #0,D2
02:00043B18 1400            	  6228:     move.b  D0,D2
                            	  6229:     ; Set the door flag for the opposite door in the next room.
                            	  6230:     ;
02:00043B1A 1214            	  6231:     move.b  ($00,A4),D1   ; ptr lo
02:00043B1C 182C0001        	  6232:     move.b  ($01,A4),D4  ; ptr hi
02:00043B20 024100FF        	  6233:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B24 E14C            	  6234:     lsl.w   #8,D4
02:00043B26 8841            	  6235:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043B28 48C4            	  6236:     ext.l   D4
02:00043B2A D8BC00FF0000    	  6237:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043B30 2044            	  6238:     movea.l D4,A0
02:00043B32 10303000        	  6239:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043B36 41F90004AD12    	  6240:     lea     (LevelMasks).l,A0
02:00043B3C 12302000        	  6241:     move.b  (A0,D2.W),D1
02:00043B40 8001            	  6242:     or.b  D1,D0
02:00043B42 1214            	  6243:     move.b  ($00,A4),D1   ; ptr lo
02:00043B44 182C0001        	  6244:     move.b  ($01,A4),D4  ; ptr hi
02:00043B48 024100FF        	  6245:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B4C E14C            	  6246:     lsl.w   #8,D4
02:00043B4E 8841            	  6247:     or.w    D1,D4
02:00043B50 48C4            	  6248:     ext.l   D4
02:00043B52 D8BC00FF0000    	  6249:     add.l   #NES_RAM,D4
02:00043B58 2044            	  6250:     movea.l D4,A0
02:00043B5A 11803000        	  6251:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6252: _anon_z05_124:
                            	  6253:     ; Add the door to the opened door mask, reset door command,
                            	  6254:     ; and lay out doors.
                            	  6255:     ;
02:00043B5E 102C0055        	  6256:     move.b  ($0055,A4),D0
02:00043B62 122C00EE        	  6257:     move.b  ($00EE,A4),D1
02:00043B66 8001            	  6258:     or.b  D1,D0
02:00043B68 6000FF66        	  6259:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6260: 
                            	  6261: ; Params:
                            	  6262: ; [08]: 0 if closed
                            	  6263: ;
                            	  6264: ; Returns:
                            	  6265: ; X: current length of dynamic transfer buf
                            	  6266: ; [00]: door VRAM address high byte
                            	  6267: ; [01]: door VRAM address low byte
                            	  6268: ; [02:03]: address of door tiles for direction and face
                            	  6269: ; [05]: 2, the number of transfer records to write
                            	  6270: ; [06]: 2, the number of tiles in each record
                            	  6271: ; [07]: 0, the first index of a tile to transfer
                            	  6272: ; [09]: door direction index
                            	  6273: ;
                            	  6274: ; Note that this routine is called with triggered doors:
                            	  6275: ; doors that can change state. Their door type numbers are >= 4.
                            	  6276: ;
                            	  6277: ; If this routine were ever called with a fixed door
                            	  6278: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6279: ; values for the door face.
                            	  6280: ;
                            	  6281: ;
                            	  6282: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6283: ;
                            	  6284:     even
                            	  6285: PrepareWriteHorizontalDoorTransferRecords:
02:00043B6C 102C0055        	  6286:     move.b  ($0055,A4),D0
02:00043B70 19400002        	  6287:     move.b  D0,($0002,A4)
02:00043B74 6100F9A4        	  6288:     jsr     FindDoorAttrByDoorBit
02:00043B78 0C000005        	  6289:     cmpi.b  #$05,D0
02:00043B7C 650C            	  6290:     bcs  _anon_z05_125
02:00043B7E 1B00            	  6291:     move.b  D0,-(A5)  ; PHA
02:00043B80 7004            	  6292:     moveq   #4,D0
02:00043B82 4EB90003073E    	  6293:     jsr     PlaySample
02:00043B88 101D            	  6294:     move.b  (A5)+,D0  ; PLA
                            	  6295: _anon_z05_125:
                            	  6296:     ; Calculate the door face index in three parts.
                            	  6297:     ;
                            	  6298:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6299:     ; (provisional face index in Y register).
                            	  6300:     ;
02:00043B8A 0C000004        	  6301:     cmpi.b  #$04,D0
02:00043B8E 6602            	  6302:     bne  _anon_z05_126
02:00043B90 7008            	  6303:     moveq   #8,D0
                            	  6304: _anon_z05_126:
02:00043B92 0C000001        	  6305:     cmpi.b  #$01,D0
02:00043B96 6602            	  6306:     bne  _anon_z05_127
02:00043B98 7004            	  6307:     moveq   #4,D0
                            	  6308: _anon_z05_127:
                            	  6309:     ; Second, subtract 3 from provisional face index.
                            	  6310:     ;
02:00043B9A 003C0011        	  6311:     ori     #$11,CCR  ; SEC: set C+X
02:00043B9E 123C0003        	  6312:     move.b  #$03,D1
02:00043BA2 0A3C0010        	  6313:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043BA6 9101            	  6314:     subx.b  D1,D0   ; SBC #$03
02:00043BA8 0A3C0010        	  6315:     eori    #$10,CCR  ; restore X = 6502 C
02:00043BAC 7600            	  6316:     moveq   #0,D3
02:00043BAE 1600            	  6317:     move.b  D0,D3
                            	  6318:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6319:     ; face index >= 3, then subtract 1 from it.
                            	  6320:     ;
                            	  6321:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6322:     ; then make it 1.
                            	  6323:     ;
02:00043BB0 102C0008        	  6324:     move.b  ($0008,A4),D0
02:00043BB4 6708            	  6325:     beq  _anon_z05_128
02:00043BB6 0C030005        	  6326:     cmpi.b  #$05,D3
02:00043BBA 670A            	  6327:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043BBC 7601            	  6328:     moveq   #1,D3
                            	  6329: _anon_z05_128:
02:00043BBE 0C030003        	  6330:     cmpi.b  #$03,D3
02:00043BC2 6502            	  6331:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043BC4 5303            	  6332:     subq.b  #1,D3
                            	  6333:     even
                            	  6334: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6335:     ; The routine that returned the door type also returned its
                            	  6336:     ; reverse direction index in [03].
                            	  6337:     ;
                            	  6338:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6339:     ;
02:00043BC6 7003            	  6340:     moveq   #3,D0
02:00043BC8 003C0011        	  6341:     ori     #$11,CCR  ; SEC: set C+X
02:00043BCC 122C0003        	  6342:     move.b  ($0003,A4),D1
02:00043BD0 0A3C0010        	  6343:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043BD4 9101            	  6344:     subx.b  D1,D0   ; SBC $03
02:00043BD6 0A3C0010        	  6345:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6346:     ; Call this to put the address of door face tiles in [02:03].
                            	  6347:     ;
02:00043BDA 6100FD7A        	  6348:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6349:     ; Return the address of the door in the nametable in [01:00].
                            	  6350:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6351:     ;
02:00043BDE 41F9000439B4    	  6352:     lea     (DoorVramAddrsHi).l,A0
02:00043BE4 10302000        	  6353:     move.b  (A0,D2.W),D0
02:00043BE8 1880            	  6354:     move.b  D0,($0000,A4)
02:00043BEA 41F9000439B8    	  6355:     lea     (DoorVramAddrsLo).l,A0
02:00043BF0 10302000        	  6356:     move.b  (A0,D2.W),D0
02:00043BF4 19400001        	  6357:     move.b  D0,($0001,A4)
                            	  6358:     ; Return the direction of the door in [09], and the dynamic
                            	  6359:     ; transfer buf length in X register.
                            	  6360:     ;
02:00043BF8 19420009        	  6361:     move.b  D2,($0009,A4)
02:00043BFC 7400            	  6362:     moveq   #0,D2
02:00043BFE 142C0301        	  6363:     move.b  ($0301,A4),D2
                            	  6364:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6365:     ;
02:00043C02 7000            	  6366:     moveq   #0,D0
02:00043C04 19400007        	  6367:     move.b  D0,($0007,A4)
02:00043C08 7002            	  6368:     moveq   #2,D0
02:00043C0A 19400006        	  6369:     move.b  D0,($0006,A4)
02:00043C0E 19400005        	  6370:     move.b  D0,($0005,A4)
02:00043C12 0A3C0001        	  6371:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043C16 4E75            	  6372:     rts
