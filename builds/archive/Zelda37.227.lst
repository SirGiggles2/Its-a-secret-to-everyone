                            	  6764: HarmLink:
02:00031D6E 610005C2        	  6765:     jsr     BeginShove
                            	  6766:     ; Flag collision with [0C], even though [06] was already set.
                            	  6767:     ;
02:00031D72 522C000C        	  6768:     addq.b  #1,($000C,A4)
                            	  6769:     ; Unpack the damage points for the monster's type.
                            	  6770:     ; The low nibble is the high byte.
                            	  6771:     ; (Damage points byte AND $F0) is the low byte.
                            	  6772:     ;
02:00031D76 7600            	  6773:     moveq   #0,D3
02:00031D78 41EC034F        	  6774:     lea     ($034F,A4),A0
02:00031D7C 16302000        	  6775:     move.b  (A0,D2.W),D3
02:00031D80 41F900031BE2    	  6776:     lea     (ObjTypeToDamagePoints).l,A0
02:00031D86 10303000        	  6777:     move.b  (A0,D3.W),D0
02:00031D8A 1B00            	  6778:     move.b  D0,-(A5)  ; PHA
02:00031D8C 0200000F        	  6779:     andi.b #$0F,D0
02:00031D90 1940000D        	  6780:     move.b  D0,($000D,A4)
02:00031D94 101D            	  6781:     move.b  (A5)+,D0  ; PLA
02:00031D96 020000F0        	  6782:     andi.b #$F0,D0
02:00031D9A 1940000E        	  6783:     move.b  D0,($000E,A4)
                            	  6784: ; Params:
                            	  6785: ; X: object index of the attacker
                            	  6786: ; [0D]: damage points high byte
                            	  6787: ; [0E]: damage points low byte
                            	  6788: ;
                            	  6789: ;
                            	  6790: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6791: ;
                            	  6792:     even
                            	  6793: Link_BeHarmed:
02:00031D9E 7600            	  6794:     moveq   #0,D3
02:00031DA0 41EC034F        	  6795:     lea     ($034F,A4),A0
02:00031DA4 16302000        	  6796:     move.b  (A0,D2.W),D3
02:00031DA8 0C03002E        	  6797:     cmpi.b  #$2E,D3
02:00031DAC 6706            	  6798:     beq  _anon_z01_85
02:00031DAE 7008            	  6799:     moveq   #8,D0
02:00031DB0 6100E98C        	  6800:     jsr     PlaySample
                            	  6801: _anon_z01_85:
