                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034E3E 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034E42 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034E46 123C0008        	  2617:     move.b  #$08,D1
02:00034E4A D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034E4C 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034E50 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034E54 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034E58 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034E5C 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034E60 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034E62 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034E66 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
02:00034E6A 123C0008        	  2645:     move.b  #$08,D1
02:00034E6E 0A3C0010        	  2646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E72 9101            	  2647:     subx.b  D1,D0   ; SBC #$08
02:00034E74 0A3C0010        	  2648:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E78 19400423        	  2649:     move.b  D0,($0423,A4)
                            	  2650:     ; It also means that we went past the end of the save slot
                            	  2651:     ; info name. Set the offset to the beginning of the name.
02:00034E7C 7600            	  2652:     moveq   #0,D3
02:00034E7E 162C0016        	  2653:     move.b  ($0016,A4),D3
02:00034E82 41F9000347BE    	  2654:     lea     (SlotToNameOffset).l,A0
02:00034E88 10303000        	  2655:     move.b  (A0,D3.W),D0
02:00034E8C 19400421        	  2656:     move.b  D0,($0421,A4)
                            	  2657:     ; If the name cursor has gone past the end of the field,
                            	  2658:     ; then wrap around.
02:00034E90 102C0070        	  2659:     move.b  ($0070,A4),D0
02:00034E94 0C0000B0        	  2660:     cmpi.b  #$B0,D0
02:00034E98 6640            	  2661:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034E9A 7070            	  2662:     moveq   #112,D0
02:00034E9C 19400070        	  2663:     move.b  D0,($0070,A4)
                            	  2664:     even
                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034EA0 7600            	  2672:     moveq   #0,D3
02:00034EA2 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034EA6 41F9000347BE    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034EAC 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034EB0 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034EB4 B001            	  2677:     cmp.b   D1,D0
02:00034EB6 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034EB8 5300            	  2679:     subq.b  #1,D0
02:00034EBA 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034EBE 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034EC2 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034EC6 5101            	  2683:     subi.b  #8,D1
02:00034EC8 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034ECC 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034ECE 7600            	  2686:     moveq   #0,D3
02:00034ED0 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034ED2 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034ED6 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2691:     even
