02:00039C56 41EC03D0        	   745:     lea     ($03D0,A4),A0
02:00039C5A 11803000        	   746:     move.b  D0,(A0,D3.W)
                            	   747:     ; Have the monster wait a random amount of time, up to $3F frames.
