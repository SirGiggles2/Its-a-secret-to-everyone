                            	  5169: 
                            	  5170: ; Each byte describes an item. The high nibble is the type.
                            	  5171: ; The low nibble is the value. Its meaning depends on the type.
                            	  5172: ;
                            	  5173: ; 0x - individuals
                            	  5174: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5175: ; * bit mask: value doesn't matter.
                            	  5176: ;
                            	  5177: ; 1x - amounts
                            	  5178: ; Value is an amount to add.
                            	  5179: ;
                            	  5180: ; 2x - grades
                            	  5181: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5182: ;
                            	  5183: ; 3x - error?
                            	  5184: ; Produces an item value of $FF.
                            	  5185: ;
                            	  5186:     even
