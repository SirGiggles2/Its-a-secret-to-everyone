                            	  2718: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2719:     ; Set state 1 to jump.
                            	  2720:     ;
02:0003A9E6 41EC00AC        	  2721:     lea     ($00AC,A4),A0
