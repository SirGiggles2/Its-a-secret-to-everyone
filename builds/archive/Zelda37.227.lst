                            	  5154: DrawCredits:
                            	  5155:     ; Make a transfer record of a full row of blank tiles.
                            	  5156:     ;
02:00036938 761F            	  5157:     moveq   #31,D3
02:0003693A 7024            	  5158:     moveq   #36,D0
                            	  5159: _anon_z02_41:
02:0003693C 41EC0305        	  5160:     lea     ($0305,A4),A0
02:00036940 11803000        	  5161:     move.b  D0,(A0,D3.W)
02:00036944 5303            	  5162:     subq.b  #1,D3
02:00036946 6AF4            	  5163:     bpl  _anon_z02_41
                            	  5164:     ; No wall tiles go in row 0.
                            	  5165:     ;
02:00036948 102C050A        	  5166:     move.b  ($050A,A4),D0
02:0003694C 672C            	  5167:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5168:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5169:     ; Rows 2 to $2D get side walls.
                            	  5170:     ;
02:0003694E 0C000001        	  5171:     cmpi.b  #$01,D0
02:00036952 6708            	  5172:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036954 0C00002E        	  5173:     cmpi.b  #$2E,D0
02:00036958 6514            	  5174:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:0003695A 661E            	  5175:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5176:     even
                            	  5177: _L_z02_DrawCredits_WriteHorizontalWalls:
02:0003695C 7619            	  5178:     moveq   #25,D3
02:0003695E 103C00FA        	  5179:     move.b  #$FA,D0
                            	  5180: _anon_z02_42:
02:00036962 41EC0308        	  5181:     lea     ($0308,A4),A0
02:00036966 11803000        	  5182:     move.b  D0,(A0,D3.W)
02:0003696A 5303            	  5183:     subq.b  #1,D3
02:0003696C 6AF4            	  5184:     bpl  _anon_z02_42
                            	  5185:     even
                            	  5186: _L_z02_DrawCredits_WriteSideWalls:
02:0003696E 103C00FA        	  5187:     move.b  #$FA,D0
02:00036972 19400308        	  5188:     move.b  D0,($0308,A4)
02:00036976 19400321        	  5189:     move.b  D0,($0321,A4)
                            	  5190:     even
                            	  5191: _L_z02_DrawCredits_TerminateRecords:
                            	  5192:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5193:     ; attributes or only tiles.
                            	  5194:     ;
02:0003697A 103C00FF        	  5195:     move.b  #$FF,D0
02:0003697E 19400325        	  5196:     move.b  D0,($0325,A4)
02:00036982 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:00036986 7020            	  5200:     moveq   #32,D0
02:00036988 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:0003698C 7400            	  5204:     moveq   #0,D2
02:0003698E 142C050C        	  5205:     move.b  ($050C,A4),D2
02:00036992 41F900036738    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:00036998 10302000        	  5207:     move.b  (A0,D2.W),D0
02:0003699C 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:000369A0 102C050D        	  5211:     move.b  ($050D,A4),D0
02:000369A4 7600            	  5212:     moveq   #0,D3
02:000369A6 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:000369A8 E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:000369AA E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:000369AC E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:000369AE E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:000369B0 E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:000369B2 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:000369B6 41F900036744    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:000369BC 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
