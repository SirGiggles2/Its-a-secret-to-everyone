02:00032466 41EC046B        	  7916:     lea     ($046B,A4),A0
02:0003246A 10302000        	  7917:     move.b  (A0,D2.W),D0
02:0003246E 0C000003        	  7918:     cmpi.b  #$03,D0
02:00032472 6624            	  7919:     bne  _L_z01_BeginShove_Exit2
