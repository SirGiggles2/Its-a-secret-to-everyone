                            	 10214: Gohma_CheckCollisions:
                            	 10215:     ; Save the boss's X coordinate.
                            	 10216:     ;
02:0003E098 10342070        	 10217:     move.b  ($70,A4,D2.W),D0
02:0003E09C 1B00            	 10218:     move.b  D0,-(A5)  ; PHA
                            	 10219:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10220:     ; on the left side.
                            	 10221:     ;
02:0003E09E 003C0011        	 10222:     ori     #$11,CCR  ; SEC: set C+X
02:0003E0A2 123C0010        	 10223:     move.b  #$10,D1
02:0003E0A6 0A3C0010        	 10224:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E0AA 9101            	 10225:     subx.b  D1,D0   ; SBC #$10
02:0003E0AC 0A3C0010        	 10226:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E0B0 19802070        	 10227:     move.b  D0,($70,A4,D2.W)
                            	 10228:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10229:     ; from left to right, indexed by [0F].
                            	 10230:     ;
02:0003E0B4 7005            	 10231:     moveq   #5,D0
02:0003E0B6 1940000F        	 10232:     move.b  D0,($000F,A4)
                            	 10233:     even
                            	 10234: _L_z04_Gohma_CheckCollisions_LoopSprite:
02:0003E0BA 4EB900031AF6    	 10235:     jsr     CheckMonsterCollisions
                            	 10236:     ; Add 8 to the X coordinate for the next part.
                            	 10237:     ;
02:0003E0C0 10342070        	 10238:     move.b  ($70,A4,D2.W),D0
02:0003E0C4 023C00EE        	 10239:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E0C8 123C0008        	 10240:     move.b  #$08,D1
02:0003E0CC D101            	 10241:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E0CE 19802070        	 10242:     move.b  D0,($70,A4,D2.W)
02:0003E0D2 532C000F        	 10243:     subq.b  #1,($000F,A4)
02:0003E0D6 66E2            	 10244:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	 10245:     ; Restore the boss's X coordinate.
