02:00031772 1003            	  5920:     move.b  D3,D0
02:00031774 6004            	  5921:     jmp     DrawObjectNotMirrored
                            	  5922: 
                            	  5923: ; Params:
                            	  5924: ; A: frame image
                            	  5925: ; X: object index
                            	  5926: ; [00]: object X
                            	  5927: ; [01]: object Y
                            	  5928: ;
                            	  5929: ;
                            	  5930: ; Set [0C] mirrored.
                            	  5931:     even
                            	  5932: DrawObjectMirrored:
02:00031776 7601            	  5933:     moveq   #1,D3
02:00031778 6602            	  5934:     bne  _anon_z01_75
                            	  5935: ; Params:
                            	  5936: ; A: frame image
                            	  5937: ; X: object index
                            	  5938: ; [00]: object X
                            	  5939: ; [01]: object Y
                            	  5940: ; [0F]: flip horizontally
                            	  5941: ;
                            	  5942:     even
                            	  5943: DrawObjectNotMirrored:
02:0003177A 7600            	  5944:     moveq   #0,D3
                            	  5945: _anon_z01_75:
02:0003177C 1943000C        	  5946:     move.b  D3,($000C,A4)
                            	  5947:     ; Set animation index = object type + 1.
                            	  5948:     ;
02:00031780 7600            	  5949:     moveq   #0,D3
02:00031782 41EC034F        	  5950:     lea     ($034F,A4),A0
02:00031786 16302000        	  5951:     move.b  (A0,D2.W),D3
                            	  5952: ; Params:
                            	  5953: ; A: frame
                            	  5954: ; X: object index/cycle sprite index
                            	  5955: ; Y: object type
                            	  5956: ; [00]: object X
                            	  5957: ; [01]: object Y
                            	  5958: ; [0C]: mirrored
                            	  5959: ; [0F]: flip horizontally
                            	  5960: ;
                            	  5961: ; Note:
                            	  5962: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5963: ;
                            	  5964: ; The animation index of most objects is (object type + 1),
                            	  5965: ; to make up for the fact that Link uses two animation indexes.
                            	  5966: ;
                            	  5967:     even
                            	  5968: DrawObjectWithType:
02:0003178A 5203            	  5969:     addq.b  #1,D3
                            	  5970: ; Params:
                            	  5971: ; A: frame
                            	  5972: ; X: object index/cycle sprite index
                            	  5973: ; Y: animation index
                            	  5974: ; [00]: object X
                            	  5975: ; [01]: object Y
                            	  5976: ; [0C]: mirrored
                            	  5977: ; [0F]: flip horizontally
                            	  5978: ;
                            	  5979: ; Note:
                            	  5980: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5981: ; But Link uses [0F] for flipping without checking [0C].
                            	  5982: ;
                            	  5983: ;
                            	  5984: ; [0D] holds frame.
                            	  5985:     even
                            	  5986: DrawObjectWithAnim:
02:0003178C 1940000D        	  5987:     move.b  D0,($000D,A4)
02:00031790 1943000E        	  5988:     move.b  D3,($000E,A4)
02:00031794 19420008        	  5989:     move.b  D2,($0008,A4)
                            	  5990:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5991:     ;
02:00031798 7600            	  5992:     moveq   #0,D3
02:0003179A 162C0341        	  5993:     move.b  ($0341,A4),D3
02:0003179E 41F900031742    	  5994:     lea     (SpriteOffsets).l,A0
02:000317A4 10303000        	  5995:     move.b  (A0,D3.W),D0
02:000317A8 19400343        	  5996:     move.b  D0,($0343,A4)
02:000317AC 41F900031743    	  5997:     lea     (SpriteOffsets+1).l,A0
02:000317B2 10303000        	  5998:     move.b  (A0,D3.W),D0
                            	  5999:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  6000:     ;
02:000317B6 4A02            	  6001:     cmpi.b  #$00,D2
02:000317B8 6702            	  6002:     beq.s  __far_z_01_0053
02:000317BA 6008            	  6003:     jmp  DrawObjectWithAnimAndSpecificSprites
