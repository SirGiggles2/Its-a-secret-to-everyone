02:00031808 D101            	  6029:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0003180A 19400003        	  6030:     move.b  D0,($0003,A4)
                            	  6031:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  6032:     ; then go set attributes and write sprites.
