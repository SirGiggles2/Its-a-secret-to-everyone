                            	  6065:     ;
                            	  6066:     ; If mirrored [0C], then draw it mirrored.
                            	  6067:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  6068:     ;
02:00031848 7600            	  6069:     moveq   #0,D3
02:0003184A 162C000C        	  6070:     move.b  ($000C,A4),D3
02:0003184E 6602            	  6071:     bne.s  __far_z_01_0055
