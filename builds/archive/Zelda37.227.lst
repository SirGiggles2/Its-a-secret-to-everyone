02:0003B386 522C00AD        	  4081:     addq.b  #1,($00AD,A4)
02:0003B38A 7050            	  4082:     moveq   #80,D0
02:0003B38C 19400029        	  4083:     move.b  D0,($0029,A4)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4086:     ; If state <> 2 (so, it's 3), then return.
                            	  4087:     ;
                            	  4088:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4089:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4090:     ; was set to, and we'll return.
                            	  4091:     ;
02:0003B390 0C000002        	  4092:     cmpi.b  #$02,D0
02:0003B394 6634            	  4093:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4094:     ; State = 2.
