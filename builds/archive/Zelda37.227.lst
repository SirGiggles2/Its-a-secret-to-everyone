                            	  4824: 
                            	  4825: ; Params:
                            	  4826: ; [02:03]: address of door tiles for direction and face
                            	  4827: ; [04]: count of tiles remaining
                            	  4828: ; [07]: current index (0 to 3) of the tile to copy
                            	  4829: ;       to the dynamic transfer buf
                            	  4830: ; [09]: door direction index
                            	  4831: ;
                            	  4832: ; Returns:
                            	  4833: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4834: ; [04]: original value - 1
                            	  4835: ; [07]: original value + 1
                            	  4836: ;
                            	  4837: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4838: ; vertically. The point of this routine is to access them
                            	  4839: ; horizontally in order to transfer them to a nametable.
                            	  4840: ;
                            	  4841: ;
                            	  4842: ; For the direction index in [09], look up the base offset of the
                            	  4843: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4844: ; the door face tiles at [02:03].
                            	  4845: ;
                            	  4846:     even
                            	  4847: WriteDoorFaceTileHorizontally:
02:0004278C 7600            	  4848:     moveq   #0,D3
02:0004278E 162C0009        	  4849:     move.b  ($0009,A4),D3
02:00042792 41F9000439B0    	  4850:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:00042798 10303000        	  4851:     move.b  (A0,D3.W),D0
                            	  4852:     ; Add [07] to the base offset we got above. This yields one
                            	  4853:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4854:     ;
02:0004279C 023C00EE        	  4855:     andi    #$EE,CCR  ; CLC: clear C+X
02:000427A0 122C0007        	  4856:     move.b  ($0007,A4),D1
02:000427A4 D101            	  4857:     addx.b  D1,D0   ; ADC $07
02:000427A6 7600            	  4858:     moveq   #0,D3
02:000427A8 1600            	  4859:     move.b  D0,D3
                            	  4860:     ; With that index, look up the index to use with the door face
                            	  4861:     ; list of tiles at [02:03].
                            	  4862:     ;
02:000427AA 41F9000439A2    	  4863:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000427B0 10303000        	  4864:     move.b  (A0,D3.W),D0
02:000427B4 7600            	  4865:     moveq   #0,D3
02:000427B6 1600            	  4866:     move.b  D0,D3
                            	  4867:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4868:     ; and copy it to the dynamic transfer buf.
                            	  4869:     ;
02:000427B8 122C0002        	  4870:     move.b  ($02,A4),D1   ; ptr lo
02:000427BC 182C0003        	  4871:     move.b  ($03,A4),D4  ; ptr hi
02:000427C0 024100FF        	  4872:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000427C4 E14C            	  4873:     lsl.w   #8,D4
02:000427C6 8841            	  4874:     or.w    D1,D4             ; D4 = NES ptr addr
02:000427C8 48C4            	  4875:     ext.l   D4
02:000427CA D8BC00FF0000    	  4876:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000427D0 2044            	  4877:     movea.l D4,A0
02:000427D2 10303000        	  4878:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000427D6 41EC0302        	  4879:     lea     ($0302,A4),A0
02:000427DA 11802000        	  4880:     move.b  D0,(A0,D2.W)
                            	  4881:     ; Prepare for the next call:
                            	  4882:     ; - increment dynamic transfer buf pointer
                            	  4883:     ; - increment index of tile to copy [07]
                            	  4884:     ; - decrement count of tiles remaining
                            	  4885:     ;
02:000427DE 5202            	  4886:     addq.b  #1,D2
02:000427E0 522C0007        	  4887:     addq.b  #1,($0007,A4)
02:000427E4 532C0004        	  4888:     subq.b  #1,($0004,A4)
02:000427E8 4E75            	  4889:     rts
