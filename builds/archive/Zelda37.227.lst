                            	   972:     ;
                            	   973:     ; Because there's only a play area and no status bar in
                            	   974:     ; nametable 2, you have to add 7 to the high byte instead of 8.
                            	   975:     ; So, the top of the play area in NT 0 is at $2100.
                            	   976:     ; But the top of the play area in NT 2 is at $2800.
                            	   977:     ;
                            	   978:     ; This assumes that you want to scroll vertically, where the
                            	   979:     ; two scroll areas must be contiguous vertically.
02:000406F4 0200000F        	   980:     andi.b #$0F,D0
02:000406F8 023C00EE        	   981:     andi    #$EE,CCR  ; CLC: clear C+X
02:000406FC 123C0027        	   982:     move.b  #$27,D1
02:00040700 D101            	   983:     addx.b  D1,D0   ; ADC #$27 (X flag = 6502 C)
02:00040702 19400302        	   984:     move.b  D0,($0302,A4)
02:00040706 102C0098        	   985:     move.b  ($0098,A4),D0
02:0004070A 0C000004        	   986:     cmpi.b  #$04,D0
02:0004070E 6404            	   987:     bcc  _anon_z05_20
                            	   988:     ; then you DO have to account for the status bar.
                            	   989:     ; So, add $100 (by incrementing high byte) to move
                            	   990:     ; everything down 64 pixels.
                            	   991:     ;
                            	   992:     ; Now the play areas will line up in NT 0 and NT 2 when
                            	   993:     ; we change mirroring to vertical at the end of this mode.
02:00040710 522C0302        	   994:     addq.b  #1,($0302,A4)
