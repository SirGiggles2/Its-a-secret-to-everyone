02:0003F19C 41EC034F        	 12514:     lea     ($034F,A4),A0
02:0003F1A0 16302000        	 12515:     move.b  (A0,D2.W),D3
02:0003F1A4 0C030025        	 12516:     cmpi.b  #$25,D3
02:0003F1A8 6702            	 12517:     beq  _anon_z04_159
