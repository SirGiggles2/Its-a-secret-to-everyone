                            	 10033: _L_z04_UpdateGohma_AnimateEye:
                            	 10034:     ; Animate the eye.
                            	 10035:     ;
                            	 10036:     ; First, if the counter for when to open the eye next = 0, then
                            	 10037:     ; set it to a random value at least $C0; and set the timer for
                            	 10038:     ; keeping the eye open to $80.
                            	 10039:     ;
                            	 10040:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10041:     ; every other frame.
                            	 10042:     ;
02:0003DF64 41EC042C        	 10043:     lea     ($042C,A4),A0
02:0003DF68 10302000        	 10044:     move.b  (A0,D2.W),D0
02:0003DF6C 661E            	 10045:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF6E 103C0080        	 10046:     move.b  #$80,D0
02:0003DF72 41EC0444        	 10047:     lea     ($0444,A4),A0
02:0003DF76 11802000        	 10048:     move.b  D0,(A0,D2.W)
02:0003DF7A 103C00C0        	 10049:     move.b  #$C0,D0
02:0003DF7E 12342018        	 10050:     move.b  ($18,A4,D2.W),D1
02:0003DF82 8001            	 10051:     or.b  D1,D0
02:0003DF84 41EC042C        	 10052:     lea     ($042C,A4),A0
02:0003DF88 11802000        	 10053:     move.b  D0,(A0,D2.W)
                            	 10054:     even
                            	 10055: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10056:     ; Decrement the next-open-eye counter.
                            	 10057:     ;
02:0003DF8C 102C0015        	 10058:     move.b  ($0015,A4),D0
02:0003DF90 E208            	 10059:     lsr.b  #1,D0   ; LSR A
02:0003DF92 6408            	 10060:     bcc  _anon_z04_122
02:0003DF94 41EC042C        	 10061:     lea     ($042C,A4),A0
02:0003DF98 53302000        	 10062:     subq.b  #1,(A0,D2.W)
                            	 10063: _anon_z04_122:
                            	 10064:     ; If open eye timer = 0, then the eye is closed.
                            	 10065:     ; Go animate it differently.
                            	 10066:     ;
02:0003DF9C 41EC0444        	 10067:     lea     ($0444,A4),A0
02:0003DFA0 10302000        	 10068:     move.b  (A0,D2.W),D0
02:0003DFA4 674A            	 10069:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10070:     ; Else decrement the open eye timer.
                            	 10071:     ;
02:0003DFA6 41EC0444        	 10072:     lea     ($0444,A4),A0
02:0003DFAA 53302000        	 10073:     subq.b  #1,(A0,D2.W)
                            	 10074:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10075:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10076:     ;
02:0003DFAE 7602            	 10077:     moveq   #2,D3
02:0003DFB0 0C000070        	 10078:     cmpi.b  #$70,D0
02:0003DFB4 6408            	 10079:     bcc  _anon_z04_123
02:0003DFB6 0C000010        	 10080:     cmpi.b  #$10,D0
02:0003DFBA 6502            	 10081:     bcs  _anon_z04_123
02:0003DFBC 5203            	 10082:     addq.b  #1,D3
                            	 10083: _anon_z04_123:
02:0003DFBE 1003            	 10084:     move.b  D3,D0
                            	 10085:     even
                            	 10086: _L_z04_UpdateGohma_SetEyeStateAndShoot:
