                            	  4937: UpdateBombFlashEffect:
                            	  4938:     ; If state <> $13, return.
                            	  4939:     ;
02:00030EFC 41EC00AC        	  4940:     lea     ($00AC,A4),A0
02:00030F00 10302000        	  4941:     move.b  (A0,D2.W),D0
02:00030F04 0C000013        	  4942:     cmpi.b  #$13,D0
02:00030F08 662E            	  4943:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4944:     ; The effect involves turning grayscale rendering on and off
                            	  4945:     ; in PPUMASK.
                            	  4946:     ;
                            	  4947:     ; Start by setting A register to the PPU mask shifted right to
                            	  4948:     ; throw away the grayscale bit.
                            	  4949:     ;
02:00030F0A 102C00FE        	  4950:     move.b  ($00FE,A4),D0
02:00030F0E E208            	  4951:     lsr.b  #1,D0   ; LSR A
