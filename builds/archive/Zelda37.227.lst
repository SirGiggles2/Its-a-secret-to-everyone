                            	  6047: __far_z_05_0091:
                            	  6048:     ; Turn the door command into the desired open or closed state
                            	  6049:     ; to store in [08].
                            	  6050:     ;
                            	  6051:     ; cmd:  7 6 3 2 
                            	  6052:     ; [08]: 2 0 0 0
                            	  6053:     ;
                            	  6054:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6055:     ; commands intended to be used.
                            	  6056:     ;
                            	  6057:     ; 3 is the end state of 2: close
                            	  6058:     ; 7 is the end state of 6: open
                            	  6059:     ;
02:000439DC 02000007        	  6060:     andi.b #$07,D0
02:000439E0 7601            	  6061:     moveq   #1,D3
02:000439E2 19430002        	  6062:     move.b  D3,($0002,A4)
02:000439E6 122C0002        	  6063:     move.b  ($0002,A4),D1
02:000439EA C200            	  6064:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000439EC 6702            	  6065:     beq  _anon_z05_118
02:000439EE E208            	  6066:     lsr.b  #1,D0   ; LSR A
                            	  6067: _anon_z05_118:
02:000439F0 0C000002        	  6068:     cmpi.b  #$02,D0
02:000439F4 6606            	  6069:     bne  _anon_z05_119
                            	  6070:     ; Command 2 sets Link's timer to $30.
                            	  6071:     ;
02:000439F6 7630            	  6072:     moveq   #48,D3
02:000439F8 19430028        	  6073:     move.b  D3,($0028,A4)
                            	  6074: _anon_z05_119:
02:000439FC 02000003        	  6075:     andi.b #$03,D0
02:00043A00 003C0011        	  6076:     ori     #$11,CCR  ; SEC: set C+X
02:00043A04 123C0001        	  6077:     move.b  #$01,D1
02:00043A08 0A3C0010        	  6078:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A0C 9101            	  6079:     subx.b  D1,D0   ; SBC #$01
02:00043A0E 0A3C0010        	  6080:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A12 02000002        	  6081:     andi.b #$02,D0
02:00043A16 19400008        	  6082:     move.b  D0,($0008,A4)
                            	  6083:     ; The command to close a key door or bombable wall does not
                            	  6084:     ; do anything.
                            	  6085:     ;
02:00043A1A 102C0054        	  6086:     move.b  ($0054,A4),D0
02:00043A1E 0C000005        	  6087:     cmpi.b  #$05,D0
02:00043A22 6416            	  6088:     bcc  _anon_z05_120
02:00043A24 102C0055        	  6089:     move.b  ($0055,A4),D0
02:00043A28 19400002        	  6090:     move.b  D0,($0002,A4)
02:00043A2C 6100FAEC        	  6091:     jsr     FindDoorAttrByDoorBit
02:00043A30 0C000007        	  6092:     cmpi.b  #$07,D0
02:00043A34 6704            	  6093:     beq  _anon_z05_120
02:00043A36 6000009C        	  6094:     jmp     L_ResetDoorCmdAndLayOutDoors
