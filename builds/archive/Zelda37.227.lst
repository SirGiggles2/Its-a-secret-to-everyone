02:0003B0C2 41EC03E4        	  3636:     lea     ($03E4,A4),A0
02:0003B0C6 12302000        	  3637:     move.b  (A0,D2.W),D1
02:0003B0CA B300            	  3638:     eor.b  D1,D0
02:0003B0CC 41EC03E4        	  3639:     lea     ($03E4,A4),A0
02:0003B0D0 11802000        	  3640:     move.b  D0,(A0,D2.W)
                            	  3641:     even
