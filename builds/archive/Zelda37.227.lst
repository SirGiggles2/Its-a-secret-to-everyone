                            	  6604: _L_z04_Digdogger_Draw_LoopPart:
                            	  6605:     ; Store in [00] the X coordinate offset for the current corner.
                            	  6606:     ;
02:0003C624 10342070        	  6607:     move.b  ($70,A4,D2.W),D0
02:0003C628 023C00EE        	  6608:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C62C 41F90003C604    	  6609:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003C632 12303000        	  6610:     move.b  (A0,D3.W),D1
02:0003C636 D101            	  6611:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003C638 1880            	  6612:     move.b  D0,($0000,A4)
                            	  6613:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  6614:     ;
02:0003C63A 41EC0084        	  6615:     lea     ($0084,A4),A0
02:0003C63E 10302000        	  6616:     move.b  (A0,D2.W),D0
02:0003C642 023C00EE        	  6617:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C646 41F90003C608    	  6618:     lea     (DigdoggerSpriteOffsetsY).l,A0
