02:000401FC 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:00040200 123C0003        	   328:     move.b  #$03,D1
02:00040204 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040208 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:0004020A 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:0004020E 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:00040212 0C000041        	   335:     cmpi.b  #$41,D0
02:00040216 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
                            	   338:     ; Advance the submenu state.
                            	   339:     ; If in OW or in a cellar, we're done. Return.
                            	   340:     ;
02:0004021A 522C00E1        	   341:     addq.b  #1,($00E1,A4)
02:0004021E 102C0010        	   342:     move.b  ($0010,A4),D0
02:00040222 67000084        	   343:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:00040226 102C0012        	   344:     move.b  ($0012,A4),D0
02:0004022A 0C000009        	   345:     cmpi.b  #$09,D0
02:0004022E 6778            	   346:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   347:     ; Calculate the X coordinate of the submenu position marker.
                            	   348:     ;
                            	   349:     ; First, mask off the high nibble of the room ID and multiply by
                            	   350:     ; the width of a tile, 8. Store the result in [00].
                            	   351:     ;
02:00040230 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:00040234 0200000F        	   353:     andi.b #$0F,D0
02:00040238 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:0004023A E308            	   355:     lsl.b  #1,D0   ; ASL A
02:0004023C E308            	   356:     lsl.b  #1,D0   ; ASL A
02:0004023E 1880            	   357:     move.b  D0,($0000,A4)
                            	   358:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   359:     ; negative or left rotation by ($10 - rotation value).
                            	   360:     ;
                            	   361:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   362:     ; the width of a tile. Then negate it. The final result is the
                            	   363:     ; negative offset.
                            	   364:     ;
02:00040240 103900FF6BAB    	   365:     move.b  (NES_SRAM+$0BAB).l,D0
02:00040246 0C000008        	   366:     cmpi.b  #$08,D0
02:0004024A 6520            	   367:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:0004024C 7010            	   368:     moveq   #16,D0
02:0004024E 123900FF6BAB    	   369:     move.b  (NES_SRAM+$0BAB).l,D1
02:00040254 0A3C0010        	   370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040258 9101            	   371:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:0004025A 0A3C0010        	   372:     eori    #$10,CCR  ; restore X = 6502 C
02:0004025E E308            	   373:     lsl.b  #1,D0   ; ASL A
02:00040260 E308            	   374:     lsl.b  #1,D0   ; ASL A
02:00040262 E308            	   375:     lsl.b  #1,D0   ; ASL A
02:00040264 4EB900030C00    	   376:     jsr     Negate
02:0004026A 6006            	   377:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   378: 
                            	   379:     even
                            	   380: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   381:     ; The submenu map's rotation < 8.
                            	   382:     ; It represents the number of tiles to move right.
                            	   383:     ; So, multiply it by 8.
                            	   384:     ;
02:0004026C E308            	   385:     lsl.b  #1,D0   ; ASL A
02:0004026E E308            	   386:     lsl.b  #1,D0   ; ASL A
02:00040270 E308            	   387:     lsl.b  #1,D0   ; ASL A
                            	   388:     even
                            	   389: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   390:     ; Add the offset we calculated, and $62 to [00] to get
                            	   391:     ; the position marker's X coordinate.
                            	   392:     ;
02:00040272 023C00EE        	   393:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040276 1214            	   394:     move.b  ($0000,A4),D1
02:00040278 D101            	   395:     addx.b  D1,D0   ; ADC $00
02:0004027A 023C00EE        	   396:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004027E 123C0062        	   397:     move.b  #$62,D1
02:00040282 D101            	   398:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040284 19400253        	   399:     move.b  D0,($0253,A4)
                            	   400:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   401:     ; Divide by 2 to get a multiple of the tile height.
                            	   402:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   403:     ;
02:00040288 102C00EB        	   404:     move.b  ($00EB,A4),D0
02:0004028C 020000F0        	   405:     andi.b #$F0,D0
02:00040290 E208            	   406:     lsr.b  #1,D0   ; LSR A
02:00040292 123C0069        	   407:     move.b  #$69,D1
02:00040296 D101            	   408:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040298 19400250        	   409:     move.b  D0,($0250,A4)
                            	   410:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   411:     ;
02:0004029C 703E            	   412:     moveq   #62,D0
02:0004029E 19400251        	   413:     move.b  D0,($0251,A4)
02:000402A2 7000            	   414:     moveq   #0,D0
02:000402A4 19400252        	   415:     move.b  D0,($0252,A4)
                            	   416:     even
                            	   417: _L_z05_UpdateMenuScrollDownUW_Exit:
02:000402A8 4E75            	   418:     rts
                            	   419: 
                            	   420:     even
                            	   421: UpdateMenuActive:
02:000402AA 610052CE        	   422:     jsr     DrawSubmenuItems
02:000402AE 61005392        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:000402B2 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:000402B6 02000088        	   430:     andi.b #$88,D0
02:000402BA 0C000088        	   431:     cmpi.b  #$88,D0
02:000402BE 661A            	   432:     bne  _anon_z05_3
02:000402C0 4EB90004B550    	   433:     jsr     EndGameMode
02:000402C6 194000E1        	   434:     move.b  D0,($00E1,A4)
02:000402CA 7008            	   435:     moveq   #8,D0
02:000402CC 19400012        	   436:     move.b  D0,($0012,A4)
02:000402D0 7000            	   437:     moveq   #0,D0
02:000402D2 19400619        	   438:     move.b  D0,($0619,A4)
02:000402D6 60001336        	   439:     jmp     SilenceSound
