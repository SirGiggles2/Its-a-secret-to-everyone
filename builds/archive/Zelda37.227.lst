02:0002B6F6 E048            	   583:     lsr.w   #8,D0
02:0002B6F8 7400            	   584:     moveq   #0,D2
02:0002B6FA 1400            	   585:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   586:     rts
