02:0003F554 41F90003F424    	 13057:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F55A 12302000        	 13058:     move.b  (A0,D2.W),D1
02:0003F55E 8001            	 13059:     or.b  D1,D0
02:0003F560 19400003        	 13060:     move.b  D0,($0003,A4)
02:0003F564 41F90003F42E    	 13061:     lea     (GanonBurstTiles).l,A0
02:0003F56A 10302000        	 13062:     move.b  (A0,D2.W),D0
02:0003F56E 4EB900031A76    	 13063:     jsr     Anim_WriteSprite
