02:0002DE8C 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DE90 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DE94 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DE96 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DE9A 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DE9C 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DEA0 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DEA2 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DEA6 6502            	   212:     bcs.s  __far_z_01_0000
