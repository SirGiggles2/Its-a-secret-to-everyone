                            	  4068: PondFairy_HandleOtherStates:
02:0003B37A 0C000001        	  4069:     cmpi.b  #$01,D0
02:0003B37E 6610            	  4070:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4071:     ; State 1. Flying and filling hearts.
                            	  4072:     ;
                            	  4073:     ; If still filling hearts, then go draw Link and hearts.
                            	  4074:     ;
02:0003B380 102C0063        	  4075:     move.b  ($0063,A4),D0
02:0003B384 6620            	  4076:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4077:     ; If not filling hearts anymore, then go to state 2,
                            	  4078:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4079:     ; a little while after we finish filling hearts.
