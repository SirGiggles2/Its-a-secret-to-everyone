02:000454EA 7600            	  9154:     moveq   #0,D3
02:000454EC 162C00EB        	  9155:     move.b  ($00EB,A4),D3
02:000454F0 1214            	  9156:     move.b  ($00,A4),D1   ; ptr lo
02:000454F2 182C0001        	  9157:     move.b  ($01,A4),D4  ; ptr hi
02:000454F6 024100FF        	  9158:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000454FA E14C            	  9159:     lsl.w   #8,D4
02:000454FC 8841            	  9160:     or.w    D1,D4             ; D4 = NES ptr addr
02:000454FE 48C4            	  9161:     ext.l   D4
02:00045500 D8BC00FF0000    	  9162:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00045506 2044            	  9163:     movea.l D4,A0
02:00045508 10303000        	  9164:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004550C 02000020        	  9165:     andi.b #$20,D0
                            	  9166:     ; If it's been visited, then check each of the 4 doors,
                            	  9167:     ; and build an open door mask.
