                            	  5428: ReachedTopWallBottom:
                            	  5429:     ; Read a zero tile. Reached the bottom of a top wall.
                            	  5430:     ;
                            	  5431:     ; Set up A and X to move top and bottom offsets to the next column.
                            	  5432:     ;
02:000435A4 7013            	  5433:     moveq   #19,D0
