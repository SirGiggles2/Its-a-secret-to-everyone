                            	  5010: UpdateMode13WinGame_Sub3:
                            	  5011:     ; After scrolling 8 pixels, draw another tile row.
                            	  5012:     ;
02:00036694 102C050B        	  5013:     move.b  ($050B,A4),D0
02:00036698 0C000008        	  5014:     cmpi.b  #$08,D0
02:0003669C 6B1A            	  5015:     bmi  _anon_z02_37
02:0003669E 102C050B        	  5016:     move.b  ($050B,A4),D0
02:000366A2 123C0008        	  5017:     move.b  #$08,D1
02:000366A6 0A3C0010        	  5018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000366AA 9101            	  5019:     subx.b  D1,D0   ; SBC #$08
02:000366AC 0A3C0010        	  5020:     eori    #$10,CCR  ; restore X = 6502 C
02:000366B0 1940050B        	  5021:     move.b  D0,($050B,A4)
