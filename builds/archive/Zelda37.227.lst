02:0004D70C 41EC04BF        	  7738:     lea     ($04BF,A4),A0
02:0004D710 11802000        	  7739:     move.b  D0,(A0,D2.W)
02:0004D714 1003            	  7740:     move.b  D3,D0
02:0004D716 1880            	  7741:     move.b  D0,($0000,A4)
                            	  7742:     ; Hit points are packed two values to a byte.
