02:0004CBF4 0200000F        	  6317:     andi.b #$0F,D0
02:0004CBF8 7600            	  6318:     moveq   #0,D3
02:0004CBFA 1600            	  6319:     move.b  D0,D3
02:0004CBFC 7008            	  6320:     moveq   #8,D0
02:0004CBFE 5303            	  6321:     subq.b  #1,D3
