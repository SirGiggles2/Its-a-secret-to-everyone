02:0004BF6E 102C0012        	  4538:     move.b  ($0012,A4),D0
02:0004BF72 0C000005        	  4539:     cmpi.b  #$05,D0
02:0004BF76 6704            	  4540:     beq.s  __far_z_07_0062
