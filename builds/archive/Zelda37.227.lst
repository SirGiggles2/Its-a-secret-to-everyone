02:000366C0 123C0080        	  5028:     move.b  #$80,D1
02:000366C4 D101            	  5029:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000366C6 19400058        	  5030:     move.b  D0,($0058,A4)
                            	  5031:     ; Carry over to the tile offset and current V-scroll.
                            	  5032:     ;
02:000366CA 6404            	  5033:     bcc  _anon_z02_38
02:000366CC 522C050B        	  5034:     addq.b  #1,($050B,A4)
                            	  5035: _anon_z02_38:
02:000366D0 102C00FC        	  5036:     move.b  ($00FC,A4),D0
02:000366D4 123C0000        	  5037:     move.b  #$00,D1
02:000366D8 D101            	  5038:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000366DA 194000FC        	  5039:     move.b  D0,($00FC,A4)
                            	  5040:     ; If we've reached the bottom of a nametable, then
                            	  5041:     ; roll over current V-scroll to 0, and increase number of
                            	  5042:     ; screens scrolled.
                            	  5043:     ;
02:000366DE 0C0000F0        	  5044:     cmpi.b  #$F0,D0
02:000366E2 7000            	  5045:     moveq   #0,D0
02:000366E4 6508            	  5046:     bcs  _anon_z02_39
02:000366E6 194000FC        	  5047:     move.b  D0,($00FC,A4)
02:000366EA 522C00E2        	  5048:     addq.b  #1,($00E2,A4)
                            	  5049: _anon_z02_39:
                            	  5050:     ; Roll the carry from the comparison above into bit 0.
                            	  5051:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5052:     ;
