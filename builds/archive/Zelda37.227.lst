02:0003B3EE 003C0011        	  4174:     ori     #$11,CCR  ; SEC: set C+X
02:0003B3F2 123C0003        	  4175:     move.b  #$03,D1
02:0003B3F6 0A3C0010        	  4176:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B3FA 9101            	  4177:     subx.b  D1,D0   ; SBC #$03
02:0003B3FC 0A3C0010        	  4178:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B400 7600            	  4179:     moveq   #0,D3
02:0003B402 1600            	  4180:     move.b  D0,D3
02:0003B404 102C0396        	  4181:     move.b  ($0396,A4),D0
