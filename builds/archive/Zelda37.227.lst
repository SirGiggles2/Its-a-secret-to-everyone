02:0003F24A 701B            	 12604:     moveq   #27,D0
02:0003F24C 19400505        	 12605:     move.b  D0,($0505,A4)
                            	 12606:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12607:     ;
02:0003F250 102C0028        	 12608:     move.b  ($0028,A4),D0
02:0003F254 6644            	 12609:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12610:     ; Once the timer expires, it's time to brighten the room.
                            	 12611:     ;
                            	 12612:     ; Save the current object slot.
02:0003F256 1002            	 12613:     move.b  D2,D0
02:0003F258 1B00            	 12614:     move.b  D0,-(A5)  ; PHA
02:0003F25A 6100089E        	 12615:     jsr     UpdateCandle
02:0003F25E 101D            	 12616:     move.b  (A5)+,D0  ; PLA
02:0003F260 7400            	 12617:     moveq   #0,D2
02:0003F262 1400            	 12618:     move.b  D0,D2
                            	 12619:     ; Turn off the room brightening flag, because we're controlling it
                            	 12620:     ; here instead of in the Mode 5 object update loop.
                            	 12621:     ;
02:0003F264 7000            	 12622:     moveq   #0,D0
02:0003F266 1940051E        	 12623:     move.b  D0,($051E,A4)
                            	 12624:     ; On the first frame of the fade-to-light cycle, play the
                            	 12625:     ; Triforce/Ganon song.
                            	 12626:     ;
02:0003F26A 102C051C        	 12627:     move.b  ($051C,A4),D0
02:0003F26E 0C0000C0        	 12628:     cmpi.b  #$C0,D0
02:0003F272 6606            	 12629:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F274 7002            	 12630:     moveq   #2,D0
02:0003F276 19400600        	 12631:     move.b  D0,($0600,A4)
