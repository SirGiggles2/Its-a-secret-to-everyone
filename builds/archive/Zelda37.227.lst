                            	  2398: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2399:     ; Link is not halted or teleporting state = 0.
                            	  2400:     ; Try to pick up Link.
                            	  2401:     ;
                            	  2402:     ; If the whirlwind does not collide with Link, then go check
                            	  2403:     ; for the screen's right edge.
                            	  2404:     ;
02:0002FE52 61001DEC        	  2405:     jsr     CheckLinkCollision
02:0002FE56 102C0006        	  2406:     move.b  ($0006,A4),D0
02:0002FE5A 6744            	  2407:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2408:     ; Collided with Link.
                            	  2409:     ;
                            	  2410:     ; Make Link face right. Reset shove info and subroom type.
                            	  2411:     ;
02:0002FE5C 7001            	  2412:     moveq   #1,D0
02:0002FE5E 19400098        	  2413:     move.b  D0,($0098,A4)
02:0002FE62 E208            	  2414:     lsr.b  #1,D0   ; LSR A
02:0002FE64 194000C0        	  2415:     move.b  D0,($00C0,A4)
02:0002FE68 194000D3        	  2416:     move.b  D0,($00D3,A4)
02:0002FE6C 1940005A        	  2417:     move.b  D0,($005A,A4)
                            	  2418:     ; Halt Link (state $40), and hide him.
                            	  2419:     ;
02:0002FE70 7040            	  2420:     moveq   #64,D0
02:0002FE72 194000AC        	  2421:     move.b  D0,($00AC,A4)
02:0002FE76 103C00F8        	  2422:     move.b  #$F8,D0
02:0002FE7A 19400248        	  2423:     move.b  D0,($0248,A4)
02:0002FE7E 1940024C        	  2424:     move.b  D0,($024C,A4)
                            	  2425:     ; Find and set the room that will behave as the previous room
                            	  2426:     ; when scrolling right to the room with the level's entrance.
                            	  2427:     ;
02:0002FE82 102C0523        	  2428:     move.b  ($0523,A4),D0
02:0002FE86 02000007        	  2429:     andi.b #$07,D0
02:0002FE8A 7600            	  2430:     moveq   #0,D3
02:0002FE8C 1600            	  2431:     move.b  D0,D3
02:0002FE8E 41F90002FDF0    	  2432:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FE94 10303000        	  2433:     move.b  (A0,D3.W),D0
02:0002FE98 194000EA        	  2434:     move.b  D0,($00EA,A4)
                            	  2435:     ; Set teleporting state 1.
                            	  2436:     ;
02:0002FE9C 522C0522        	  2437:     addq.b  #1,($0522,A4)
                            	  2438:     even
                            	  2439: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2440:     ; If whirlwind's X < $F0, go draw.
