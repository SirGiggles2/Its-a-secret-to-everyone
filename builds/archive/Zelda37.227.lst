02:0003BAE4 0C000007        	  5114:     cmpi.b  #$07,D0
02:0003BAE8 652C            	  5115:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  5116:     ; It has reached the end of a trip.
