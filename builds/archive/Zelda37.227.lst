                            	  4232:     even
                            	  4233: DoorwayBoundsMaxOver:
02:000422BE 5E              	  4234:     dc.b    $5E, $DE, $21, $F1
02:000422BF DE
02:000422C0 21
02:000422C1 F1
                            	  4235: 
                            	  4236: ; Player coordinate must be >= these bounds.
                            	  4237: ; Using these bounds; the player will be considered within the
                            	  4238: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4239: ; at the edge.
