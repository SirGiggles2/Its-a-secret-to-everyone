02:0003CF7E 41F90003CE72    	  7951:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF84 10303000        	  7952:     move.b  (A0,D3.W),D0
02:0003CF88 41EC0412        	  7953:     lea     ($0412,A4),A0
02:0003CF8C 11802000        	  7954:     move.b  D0,(A0,D2.W)
                            	  7955:     ; Look up the Y offset for the current direction.
                            	  7956:     ; Add it to object Y to set the destination Y of the jump.
