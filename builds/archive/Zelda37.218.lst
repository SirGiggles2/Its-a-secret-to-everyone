                            	  3732: 
                            	  3733: ; Params:
                            	  3734: ; [0F]: movement direction
                            	  3735: ;
                            	  3736: ; Returns:
                            	  3737: ; [0F]: movement direction or 0
                            	  3738: ;
                            	  3739: ;
