                            	  6906: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6907:     ; Reset values used in special item drops.
                            	  6908:     ;
02:00031C5C 7000            	  6909:     moveq   #0,D0
02:00031C5E 19400627        	  6910:     move.b  D0,($0627,A4)
02:00031C62 19400050        	  6911:     move.b  D0,($0050,A4)
02:00031C66 19400051        	  6912:     move.b  D0,($0051,A4)
                            	  6913:     ; If heart partial >= low damage points byte, then simply
                            	  6914:     ; subtract the damage byte from heart partial.
                            	  6915:     ; Else go borrow from full hearts.
                            	  6916:     ;
02:00031C6A 102C0670        	  6917:     move.b  ($0670,A4),D0
02:00031C6E 122C000E        	  6918:     move.b  ($000E,A4),D1
02:00031C72 B001            	  6919:     cmp.b   D1,D0
02:00031C74 6546            	  6920:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031C76 003C0011        	  6921:     ori     #$11,CCR  ; SEC: set C+X
02:00031C7A 122C000E        	  6922:     move.b  ($000E,A4),D1
02:00031C7E 0A3C0010        	  6923:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C82 9101            	  6924:     subx.b  D1,D0   ; SBC $0E
02:00031C84 0A3C0010        	  6925:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C88 19400670        	  6926:     move.b  D0,($0670,A4)
                            	  6927:     ; If full hearts >= high damage points byte, then simply
                            	  6928:     ; subtract the damage byte from full hearts.
                            	  6929:     ; Else go handle Link dying.
