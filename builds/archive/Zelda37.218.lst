02:0003E7CC 7600            	 11363:     moveq   #0,D3
02:0003E7CE 162C04D7        	 11364:     move.b  ($04D7,A4),D3
02:0003E7D2 41F90004AE96    	 11365:     lea     (LevelMasks).l,A0
02:0003E7D8 10303000        	 11366:     move.b  (A0,D3.W),D0
02:0003E7DC 122C0511        	 11367:     move.b  ($0511,A4),D1
02:0003E7E0 8001            	 11368:     or.b  D1,D0
02:0003E7E2 19400511        	 11369:     move.b  D0,($0511,A4)
02:0003E7E6 1880            	 11370:     move.b  D0,($0000,A4)
                            	 11371:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11372:     ; Count them up, and store the amount in [00].
                            	 11373:     ;
02:0003E7E8 7000            	 11374:     moveq   #0,D0
02:0003E7EA 7604            	 11375:     moveq   #4,D3
                            	 11376: _anon_z04_143:
02:0003E7EC 1214            	 11377:     move.b  ($0000,A4),D1
02:0003E7EE E209            	 11378:     lsr.b  #1,D1   ; LSR $00
02:0003E7F0 1881            	 11379:     move.b  D1,($0000,A4)
02:0003E7F2 123C0000        	 11380:     move.b  #$00,D1
02:0003E7F6 D101            	 11381:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E7F8 5303            	 11382:     subq.b  #1,D3
02:0003E7FA 66F0            	 11383:     bne  _anon_z04_143
02:0003E7FC 1880            	 11384:     move.b  D0,($0000,A4)
                            	 11385:     ; Compare the number of dead necks to the original number
                            	 11386:     ; (object type - $41).
