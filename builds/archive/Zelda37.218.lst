02:00030B0A 102C0003        	  4633:     move.b  ($0003,A4),D0
02:00030B0E 003C0011        	  4634:     ori     #$11,CCR  ; SEC: set C+X
02:00030B12 122C0004        	  4635:     move.b  ($0004,A4),D1
02:00030B16 0A3C0010        	  4636:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B1A 9101            	  4637:     subx.b  D1,D0   ; SBC $04
02:00030B1C 0A3C0010        	  4638:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B20 0C000008        	  4639:     cmpi.b  #$08,D0
02:00030B24 6538            	  4640:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4641:     even
                            	  4642: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4643:     ; TODO: call it speed index or angle?
                            	  4644:     ; Otherwise, go to the next speed index (angle).
                            	  4645:     ;
02:00030B26 1014            	  4646:     move.b  ($0000,A4),D0
02:00030B28 023C00EE        	  4647:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030B2C 122C0001        	  4648:     move.b  ($0001,A4),D1
02:00030B30 D101            	  4649:     addx.b  D1,D0   ; ADC $01
02:00030B32 1880            	  4650:     move.b  D0,($0000,A4)
                            	  4651:     ; TODO: call it speed index or angle?
                            	  4652:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4653:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4654:     ;
02:00030B34 6728            	  4655:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030B36 0C000008        	  4656:     cmpi.b  #$08,D0
02:00030B3A 6722            	  4657:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4658:     ; Subtract the lesser distance from the greater distance.
