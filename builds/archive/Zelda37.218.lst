02:0004394A 642A            	  5854:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004394C 0C000004        	  5855:     cmpi.b  #$04,D0
02:00043950 6608            	  5856:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:00043952 7008            	  5857:     moveq   #8,D0
02:00043954 6620            	  5858:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5859:     even
                            	  5860: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5861:     ; We jump here if the door type is bombable and was opened.
                            	  5862:     ; Change the provisional door face to value 9, which
                            	  5863:     ; will become the "hole in the wall".
                            	  5864:     ;
02:00043956 7009            	  5865:     moveq   #9,D0
02:00043958 665A            	  5866:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5867:     even
                            	  5868: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5869:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5870:     ; the mask of opened doors, because this is not a true door.
                            	  5871:     ;
02:0004395A 1B00            	  5872:     move.b  D0,-(A5)  ; PHA
02:0004395C 102C0002        	  5873:     move.b  ($0002,A4),D0
02:00043960 4600            	  5874:     eori.b #$FF,D0
02:00043962 122C00EE        	  5875:     move.b  ($00EE,A4),D1
02:00043966 C001            	  5876:     and.b  D1,D0
02:00043968 194000EE        	  5877:     move.b  D0,($00EE,A4)
02:0004396C 101D            	  5878:     move.b  (A5)+,D0  ; PLA
                            	  5879:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5880:     ;
02:0004396E 0C000001        	  5881:     cmpi.b  #$01,D0
02:00043972 6402            	  5882:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043974 7004            	  5883:     moveq   #4,D0
                            	  5884:     even
                            	  5885: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5886:     ; The door attribute (DA) has been mapped to a
                            	  5887:     ; provisional door face value (PF) in %A as follows:
                            	  5888:     ;
                            	  5889:     ; DA PF Meaning
                            	  5890:     ; -------------
                            	  5891:     ; 0  4  open
                            	  5892:     ; 1  1  wall
                            	  5893:     ; 2  2  false wall
                            	  5894:     ; 3  3  false wall 2
                            	  5895:     ; 4  8  bombable
                            	  5896:     ; 5  5  key
                            	  5897:     ; 6  6  key 2
                            	  5898:     ; 7  7  shutter
                            	  5899:     ;
                            	  5900:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5901:     ; has been cleared, if the type was "open" or any wall.
                            	  5902:     ;
                            	  5903:     ;
                            	  5904:     ; Save the provisional face.
02:00043976 1B00            	  5905:     move.b  D0,-(A5)  ; PHA
                            	  5906:     ; If the current direction points to a door that has been opened,
                            	  5907:     ; then see if we need to set door flags.
                            	  5908:     ;
02:00043978 102C00EE        	  5909:     move.b  ($00EE,A4),D0
02:0004397C 122C0002        	  5910:     move.b  ($0002,A4),D1
02:00043980 C001            	  5911:     and.b  D1,D0
02:00043982 7400            	  5912:     moveq   #0,D2
02:00043984 1400            	  5913:     move.b  D0,D2
02:00043986 101D            	  5914:     move.b  (A5)+,D0  ; PLA
02:00043988 122C0002        	  5915:     move.b  ($0002,A4),D1
02:0004398C B401            	  5916:     cmp.b   D1,D2
02:0004398E 6624            	  5917:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5918:     ; The current direction points to a door that has been opened.
                            	  5919:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5920:     ;
                            	  5921:     ;
                            	  5922:     ; Save provisional door face in Y register.
02:00043990 7600            	  5923:     moveq   #0,D3
02:00043992 1600            	  5924:     move.b  D0,D3
02:00043994 101D            	  5925:     move.b  (A5)+,D0  ; PLA
02:00043996 1B00            	  5926:     move.b  D0,-(A5)  ; PHA
02:00043998 7400            	  5927:     moveq   #0,D2
02:0004399A 1400            	  5928:     move.b  D0,D2
02:0004399C 1003            	  5929:     move.b  D3,D0
                            	  5930:     ; If provisional door face is not for a shutter, then
                            	  5931:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5932:     ;
                            	  5933:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5934:     ;
02:0004399E 0C000007        	  5935:     cmpi.b  #$07,D0
02:000439A2 670E            	  5936:     beq  _anon_z05_111
02:000439A4 1B00            	  5937:     move.b  D0,-(A5)  ; PHA
02:000439A6 6100DD54        	  5938:     jsr     SetDoorFlag
02:000439AA 101D            	  5939:     move.b  (A5)+,D0  ; PLA
                            	  5940:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5941:     ; then go make it 9 (open "bombable").
                            	  5942:     ; Else make it 4 (open "door").
                            	  5943:     ;
02:000439AC 0C000008        	  5944:     cmpi.b  #$08,D0
02:000439B0 67A4            	  5945:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5946: _anon_z05_111:
02:000439B2 7004            	  5947:     moveq   #4,D0
                            	  5948:     even
                            	  5949: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5950:     ; For opened doors, the provisional door face has become:
                            	  5951:     ;
                            	  5952:     ; DA PF Meaning
                            	  5953:     ; -------------
                            	  5954:     ; 0  4  open
                            	  5955:     ; 1  1  wall
                            	  5956:     ; 2  2  false wall
                            	  5957:     ; 3  3  false wall 2
                            	  5958:     ; 4  9  bombable
                            	  5959:     ; 5  4  key
                            	  5960:     ; 6  4  key 2
                            	  5961:     ; 7  4  shutter
                            	  5962:     ;
                            	  5963:     ;
                            	  5964:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5965:     ;
02:000439B4 7400            	  5966:     moveq   #0,D2
02:000439B6 142C0006        	  5967:     move.b  ($0006,A4),D2
02:000439BA 6712            	  5968:     beq  _anon_z05_112
02:000439BC 7400            	  5969:     moveq   #0,D2
02:000439BE 142C000B        	  5970:     move.b  ($000B,A4),D2
02:000439C2 1B00            	  5971:     move.b  D0,-(A5)  ; PHA
02:000439C4 6100FCC8        	  5972:     jsr     FindDoorAttrByDoorBit
02:000439C8 61001D0C        	  5973:     jsr     CalcOpenDoorwayMask
02:000439CC 101D            	  5974:     move.b  (A5)+,D0  ; PLA
                            	  5975: _anon_z05_112:
                            	  5976:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5977:     ; because the visible door face is already a wall.
                            	  5978:     ;
02:000439CE 0C000004        	  5979:     cmpi.b  #$04,D0
02:000439D2 650000DC        	  5980:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5981:     ; For all other provisional face values, calculate:
                            	  5982:     ; door face := provisional face - 3
02:000439D6 003C0011        	  5983:     ori     #$11,CCR  ; SEC: set C+X
02:000439DA 123C0003        	  5984:     move.b  #$03,D1
02:000439DE 0A3C0010        	  5985:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439E2 9101            	  5986:     subx.b  D1,D0   ; SBC #$03
02:000439E4 0A3C0010        	  5987:     eori    #$10,CCR  ; restore X = 6502 C
02:000439E8 7600            	  5988:     moveq   #0,D3
02:000439EA 1600            	  5989:     move.b  D0,D3
                            	  5990:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5991:     ; subtract one.
                            	  5992:     ;
02:000439EC 0C030003        	  5993:     cmpi.b  #$03,D3
02:000439F0 6502            	  5994:     bcs  _anon_z05_113
02:000439F2 5303            	  5995:     subq.b  #1,D3
                            	  5996: _anon_z05_113:
                            	  5997:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5998:     ;
                            	  5999:     ; DT DFC DFO Meaning
                            	  6000:     ; ------------------
                            	  6001:     ; 0  1   1   open
                            	  6002:     ; 4  4   5   bombable
                            	  6003:     ; 5  2   1   key
                            	  6004:     ; 6  2   1   key 2
                            	  6005:     ; 7  3   1   shutter
                            	  6006:     ;
                            	  6007:     ;
                            	  6008:     ; Get the direction index.
02:000439F4 101D            	  6009:     move.b  (A5)+,D0  ; PLA
02:000439F6 1B00            	  6010:     move.b  D0,-(A5)  ; PHA
02:000439F8 610000D0        	  6011:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6012:     ; If handling the second half, then offset to the second half
                            	  6013:     ; of the tiles.
                            	  6014:     ;
02:000439FC 102C0006        	  6015:     move.b  ($0006,A4),D0
02:00043A00 6618            	  6016:     bne  _anon_z05_114
02:00043A02 41F900043918    	  6017:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00043A08 10302000        	  6018:     move.b  (A0,D2.W),D0
02:00043A0C 4EB900030E8E    	  6019:     jsr     AddToInt16At0
02:00043A12 7006            	  6020:     moveq   #6,D0
02:00043A14 4EB900030E96    	  6021:     jsr     AddToInt16At2
                            	  6022: _anon_z05_114:
                            	  6023:     ; Fix Y at 0 for copying source tiles to destination.
                            	  6024:     ; Pointers will be incremented instead of Y.
02:00043A1A 7600            	  6025:     moveq   #0,D3
02:00043A1C 41F90004391C    	  6026:     lea     (DirIndexToDoorColumnCount).l,A0
02:00043A22 10302000        	  6027:     move.b  (A0,D2.W),D0
02:00043A26 19400005        	  6028:     move.b  D0,($0005,A4)
                            	  6029:     even
                            	  6030: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  6031:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  6032:     ;
02:00043A2A 101D            	  6033:     move.b  (A5)+,D0  ; PLA
02:00043A2C 1B00            	  6034:     move.b  D0,-(A5)  ; PHA
02:00043A2E 7400            	  6035:     moveq   #0,D2
02:00043A30 1400            	  6036:     move.b  D0,D2
                            	  6037:     ; For each row (2 or 3) in the door, indexed by X,
                            	  6038:     ; starting from highest index down to 0:
                            	  6039:     ;
02:00043A32 41F900043920    	  6040:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043A38 10302000        	  6041:     move.b  (A0,D2.W),D0
02:00043A3C 7400            	  6042:     moveq   #0,D2
02:00043A3E 1400            	  6043:     move.b  D0,D2
                            	  6044:     even
                            	  6045: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00043A40 122C0002        	  6046:     move.b  ($02,A4),D1   ; ptr lo
02:00043A44 182C0003        	  6047:     move.b  ($03,A4),D4  ; ptr hi
02:00043A48 024100FF        	  6048:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A4C E14C            	  6049:     lsl.w   #8,D4
02:00043A4E 8841            	  6050:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043A50 48C4            	  6051:     ext.l   D4
02:00043A52 D8BC00FF0000    	  6052:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043A58 2044            	  6053:     movea.l D4,A0
02:00043A5A 10303000        	  6054:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043A5E 1214            	  6055:     move.b  ($00,A4),D1   ; ptr lo
02:00043A60 182C0001        	  6056:     move.b  ($01,A4),D4  ; ptr hi
02:00043A64 024100FF        	  6057:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A68 E14C            	  6058:     lsl.w   #8,D4
02:00043A6A 8841            	  6059:     or.w    D1,D4
02:00043A6C 48C4            	  6060:     ext.l   D4
02:00043A6E D8BC00FF0000    	  6061:     add.l   #NES_RAM,D4
02:00043A74 2044            	  6062:     movea.l D4,A0
02:00043A76 11803000        	  6063:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00043A7A 4EB900030E92    	  6064:     jsr     Add1ToInt16At2
02:00043A80 41F900043914    	  6065:     lea     (NextDoorTileOffsets).l,A0
02:00043A86 10302000        	  6066:     move.b  (A0,D2.W),D0
02:00043A8A 4EB900030E8E    	  6067:     jsr     AddToInt16At0
                            	  6068:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  6069:     ; go 1 more tile down, to start the next column at the right place.
                            	  6070:     ; We have to compensate for the fact that E/W doors are 
                            	  6071:     ; shorter vertically than N/S doors.
02:00043A90 4A02            	  6072:     cmpi.b  #$00,D2
02:00043A92 6610            	  6073:     bne  _anon_z05_115
02:00043A94 101D            	  6074:     move.b  (A5)+,D0  ; PLA
02:00043A96 1B00            	  6075:     move.b  D0,-(A5)  ; PHA
02:00043A98 0C000002        	  6076:     cmpi.b  #$02,D0
02:00043A9C 6406            	  6077:     bcc  _anon_z05_115
02:00043A9E 4EB900030E8C    	  6078:     jsr     Add1ToInt16At0
                            	  6079: _anon_z05_115:
                            	  6080:     ; Bottom of the tile row copying loop.
                            	  6081:     ; Decrement the row index.
                            	  6082:     ;
02:00043AA4 5302            	  6083:     subq.b  #1,D2
02:00043AA6 6A98            	  6084:     bpl  _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile
                            	  6085:     ; Bottom of the column copying loop.
                            	  6086:     ; Decrease the column counter.
                            	  6087:     ;
02:00043AA8 532C0005        	  6088:     subq.b  #1,($0005,A4)
02:00043AAC 6600FF7C        	  6089:     bne  _L_z05_L_LayOutDoors_LoopHalves_LoopColumn
                            	  6090:     even
                            	  6091: _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf:
                            	  6092:     ; Bottom of the door halves loop.
                            	  6093:     ;
02:00043AB0 101D            	  6094:     move.b  (A5)+,D0  ; PLA
