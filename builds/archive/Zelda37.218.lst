                            	  6383: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6384:     ; Digdogger is big, but room boundary checks and
                            	  6385:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6386:     ; Therefore, we have to check these things four times,
                            	  6387:     ; in different corners of the boss.
                            	  6388:     ;
                            	  6389:     ; Loop 4 times, from 0 to 3.
                            	  6390:     ;
02:0003C2AA 7600            	  6391:     moveq   #0,D3
02:0003C2AC 41EC0478        	  6392:     lea     ($0478,A4),A0
02:0003C2B0 16302000        	  6393:     move.b  (A0,D2.W),D3
                            	  6394:     ; Change the coordinates to one corner.
                            	  6395:     ;
02:0003C2B4 10342070        	  6396:     move.b  ($70,A4,D2.W),D0
02:0003C2B8 023C00EE        	  6397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2BC 41F90003C170    	  6398:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C2C2 12303000        	  6399:     move.b  (A0,D3.W),D1
02:0003C2C6 D101            	  6400:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C2C8 19802070        	  6401:     move.b  D0,($70,A4,D2.W)
02:0003C2CC 41EC0084        	  6402:     lea     ($0084,A4),A0
02:0003C2D0 10302000        	  6403:     move.b  (A0,D2.W),D0
02:0003C2D4 023C00EE        	  6404:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2D8 41F90003C174    	  6405:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C2DE 12303000        	  6406:     move.b  (A0,D3.W),D1
02:0003C2E2 D101            	  6407:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C2E4 41EC0084        	  6408:     lea     ($0084,A4),A0
02:0003C2E8 11802000        	  6409:     move.b  D0,(A0,D2.W)
                            	  6410:     ; Check the room boundary and object collisions in this temporary location.
                            	  6411:     ;
02:0003C2EC 61003A60        	  6412:     jsr     BoundFlyer
02:0003C2F0 4EB90003197E    	  6413:     jsr     CheckMonsterCollisions
                            	  6414:     ; Increase the loop index, and loop again until it = 4.
