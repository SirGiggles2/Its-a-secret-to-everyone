02:0003EDCA 66EA            	 12142:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12143:     ; If this head segment is not aligned with a square, then return.
                            	 12144:     ;
02:0003EDCC 10342070        	 12145:     move.b  ($70,A4,D2.W),D0
02:0003EDD0 0200000F        	 12146:     andi.b #$0F,D0
02:0003EDD4 660000BA        	 12147:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12148:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12149:     ; We had to account for the usual offset of 3.
                            	 12150:     ;
02:0003EDD8 41EC0084        	 12151:     lea     ($0084,A4),A0
02:0003EDDC 10302000        	 12152:     move.b  (A0,D2.W),D0
02:0003EDE0 023C00EE        	 12153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDE4 123C0003        	 12154:     move.b  #$03,D1
02:0003EDE8 D101            	 12155:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDEA 0200000F        	 12156:     andi.b #$0F,D0
02:0003EDEE 660000A0        	 12157:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12158:     ; Store the opposite of the facing direction in [00].
                            	 12159:     ;
02:0003EDF2 41EC0098        	 12160:     lea     ($0098,A4),A0
02:0003EDF6 10302000        	 12161:     move.b  (A0,D2.W),D0
02:0003EDFA E208            	 12162:     lsr.b  #1,D0   ; LSR A
02:0003EDFC 02000005        	 12163:     andi.b #$05,D0
02:0003EE00 1880            	 12164:     move.b  D0,($0000,A4)
02:0003EE02 41EC0098        	 12165:     lea     ($0098,A4),A0
02:0003EE06 10302000        	 12166:     move.b  (A0,D2.W),D0
02:0003EE0A E308            	 12167:     lsl.b  #1,D0   ; ASL A
02:0003EE0C 0200000A        	 12168:     andi.b #$0A,D0
02:0003EE10 1214            	 12169:     move.b  ($0000,A4),D1
02:0003EE12 8001            	 12170:     or.b  D1,D0
                            	 12171:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12172:     ;
02:0003EE14 0A00000F        	 12173:     eori.b #$0F,D0
02:0003EE18 1940050F        	 12174:     move.b  D0,($050F,A4)
                            	 12175:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12176:     ;
02:0003EE1C 10342018        	 12177:     move.b  ($18,A4,D2.W),D0
02:0003EE20 0C000080        	 12178:     cmpi.b  #$80,D0
02:0003EE24 656C            	 12179:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12180:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12181:     ; Load the monster's facing direction.
                            	 12182:     ;
02:0003EE26 41EC0098        	 12183:     lea     ($0098,A4),A0
02:0003EE2A 10302000        	 12184:     move.b  (A0,D2.W),D0
                            	 12185:     ; Load the next random number into Y register.
                            	 12186:     ;
02:0003EE2E 7600            	 12187:     moveq   #0,D3
02:0003EE30 16342019        	 12188:     move.b  ($19,A4,D2.W),D3
                            	 12189:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12190:     ; to keep moving straight.
                            	 12191:     ;
02:0003EE34 0C030080        	 12192:     cmpi.b  #$80,D3
02:0003EE38 6418            	 12193:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12194:     even
                            	 12195: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12196:     ; Loop to rotate the direction bit over the mask.
                            	 12197:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12198:     ; facing direction.
                            	 12199:     ;
                            	 12200:     ; Shift right the copy of the direction.
                            	 12201:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12202:     ;
02:0003EE3A E208            	 12203:     lsr.b  #1,D0   ; LSR A
02:0003EE3C 6402            	 12204:     bcc  _anon_z04_151
02:0003EE3E 7008            	 12205:     moveq   #8,D0
                            	 12206: _anon_z04_151:
                            	 12207:     ; If the current direction bit is masked off, then we've reached
                            	 12208:     ; the opposite direction. Loop again.
                            	 12209:     ;
02:0003EE40 122C050F        	 12210:     move.b  ($050F,A4),D1
02:0003EE44 C200            	 12211:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE46 67F2            	 12212:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12213:     ; If Y register >= $40, then break out of the loop.
                            	 12214:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12215:     ;
02:0003EE48 0C030040        	 12216:     cmpi.b  #$40,D3
02:0003EE4C 6404            	 12217:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12218:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12219:     ; and loop again now.
                            	 12220:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12221:     ;
02:0003EE4E 7640            	 12222:     moveq   #64,D3
02:0003EE50 65E8            	 12223:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12224:     even
                            	 12225: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12226:     ; Change the facing direction to the direction found.
                            	 12227:     ;
02:0003EE52 41EC0098        	 12228:     lea     ($0098,A4),A0
02:0003EE56 11802000        	 12229:     move.b  D0,(A0,D2.W)
                            	 12230:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12231:     ;
02:0003EE5A 1940000F        	 12232:     move.b  D0,($000F,A4)
02:0003EE5E 4EB90003093E    	 12233:     jsr     BoundByRoom
                            	 12234:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12235:     ;
02:0003EE64 102C000F        	 12236:     move.b  ($000F,A4),D0
02:0003EE68 6618            	 12237:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12238:     even
                            	 12239: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12240:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12241:     ; for looking for any non-opposite direction that is not blocked.
                            	 12242:     ;
02:0003EE6A 41EC0098        	 12243:     lea     ($0098,A4),A0
02:0003EE6E 10302000        	 12244:     move.b  (A0,D2.W),D0
                            	 12245:     even
                            	 12246: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12247:     ; Shift right the copy of the direction.
                            	 12248:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12249:     ;
02:0003EE72 E208            	 12250:     lsr.b  #1,D0   ; LSR A
02:0003EE74 6402            	 12251:     bcc  _anon_z04_152
02:0003EE76 7008            	 12252:     moveq   #8,D0
                            	 12253: _anon_z04_152:
                            	 12254:     ; If the current direction bit is not masked off, then go check the
                            	 12255:     ; room boundary in this direction.
                            	 12256:     ; Else we've reached the opposite direction. Loop again.
                            	 12257:     ;
02:0003EE78 122C050F        	 12258:     move.b  ($050F,A4),D1
02:0003EE7C C200            	 12259:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE7E 66D2            	 12260:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE80 67F0            	 12261:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12262:     even
                            	 12263: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12264:     ; We found a direction that was not blocked by the room boundary.
                            	 12265:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12266:     ;
02:0003EE82 4EB90004BA8A    	 12267:     jsr     GetCollidingTileMoving
02:0003EE88 122C034A        	 12268:     move.b  ($034A,A4),D1
02:0003EE8C B001            	 12269:     cmp.b   D1,D0
02:0003EE8E 64DA            	 12270:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12271:     even
                            	 12272: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12273:     ; TODO: confirm this
                            	 12274:     ;
