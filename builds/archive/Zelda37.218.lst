                            	  5276: SpreadShot:
                            	  5277:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5278:     ;
                            	  5279:     ; The shot is spreading out.
                            	  5280:     ;
                            	  5281:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5282:     ; These will be negated appropriately for each corner.
                            	  5283:     ;
02:0004C63A 41EC0098        	  5284:     lea     ($0098,A4),A0
02:0004C63E 10302000        	  5285:     move.b  (A0,D2.W),D0
02:0004C642 19400002        	  5286:     move.b  D0,($0002,A4)
02:0004C646 19400003        	  5287:     move.b  D0,($0003,A4)
                            	  5288:     ; Reset [0F] to not flip horizontally.
                            	  5289:     ;
02:0004C64A 7000            	  5290:     moveq   #0,D0
02:0004C64C 1940000F        	  5291:     move.b  D0,($000F,A4)
                            	  5292:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5293:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5294:     ;
02:0004C650 7603            	  5295:     moveq   #3,D3
                            	  5296:     even
                            	  5297: _L_z07_SpreadShot_DrawShotCorner:
02:0004C652 1003            	  5298:     move.b  D3,D0
02:0004C654 1B00            	  5299:     move.b  D0,-(A5)  ; PHA
                            	  5300:     ; Save offset X [02] and Y offset [03].
                            	  5301:     ;
02:0004C656 102C0002        	  5302:     move.b  ($0002,A4),D0
02:0004C65A 1B00            	  5303:     move.b  D0,-(A5)  ; PHA
02:0004C65C 102C0003        	  5304:     move.b  ($0003,A4),D0
02:0004C660 1B00            	  5305:     move.b  D0,-(A5)  ; PHA
                            	  5306:     ; Calculate and set sprite attributes for this corner:
                            	  5307:     ;   base attribute OR (frame counter AND 3)
                            	  5308:     ;
                            	  5309:     ; The base attribute defines how to flip the sprite.
                            	  5310:     ; The frame counter makes the shot flash by cycling each
                            	  5311:     ; palette row.
                            	  5312:     ;
02:0004C662 102C0015        	  5313:     move.b  ($0015,A4),D0
02:0004C666 02000003        	  5314:     andi.b #$03,D0
02:0004C66A 41F90004C4C8    	  5315:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C670 12303000        	  5316:     move.b  (A0,D3.W),D1
02:0004C674 8001            	  5317:     or.b  D1,D0
02:0004C676 4EB9000318F4    	  5318:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5319:     ; Add the object's X (the center of the spread) and the
                            	  5320:     ; current offset in [02] to set sprite X in [00].
                            	  5321:     ;
02:0004C67C 10342070        	  5322:     move.b  ($70,A4,D2.W),D0
02:0004C680 023C00EE        	  5323:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C684 122C0002        	  5324:     move.b  ($0002,A4),D1
02:0004C688 D101            	  5325:     addx.b  D1,D0   ; ADC $02
02:0004C68A 1880            	  5326:     move.b  D0,($0000,A4)
                            	  5327:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5328:     ; Else calculate the distance from object X to sprite X.
                            	  5329:     ;
02:0004C68C 12342070        	  5330:     move.b  ($70,A4,D2.W),D1
02:0004C690 B001            	  5331:     cmp.b   D1,D0
02:0004C692 651A            	  5332:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C694 0C0000FC        	  5333:     cmpi.b  #$FC,D0
02:0004C698 6466            	  5334:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C69A 003C0011        	  5335:     ori     #$11,CCR  ; SEC: set C+X
02:0004C69E 12342070        	  5336:     move.b  ($70,A4,D2.W),D1
02:0004C6A2 0A3C0010        	  5337:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C6A6 9101            	  5338:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C6A8 0A3C0010        	  5339:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C6AC 6014            	  5340:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5341: 
                            	  5342:     even
                            	  5343: _L_z07_SpreadShot_ReverseSub:
02:0004C6AE 10342070        	  5344:     move.b  ($70,A4,D2.W),D0
02:0004C6B2 003C0011        	  5345:     ori     #$11,CCR  ; SEC: set C+X
02:0004C6B6 1214            	  5346:     move.b  ($0000,A4),D1
02:0004C6B8 0A3C0010        	  5347:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C6BC 9101            	  5348:     subx.b  D1,D0   ; SBC $00
02:0004C6BE 0A3C0010        	  5349:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5350:     even
                            	  5351: _L_z07_SpreadShot_CheckDistance:
                            	  5352:     ; If distance >= $20, skip this corner.
                            	  5353:     ;
02:0004C6C2 0C000020        	  5354:     cmpi.b  #$20,D0
02:0004C6C6 6438            	  5355:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5356:     ; Add the object's Y (the center of the spread) and the
                            	  5357:     ; current offset in [03] to set sprite Y in [01].
                            	  5358:     ;
02:0004C6C8 41EC0084        	  5359:     lea     ($0084,A4),A0
02:0004C6CC 10302000        	  5360:     move.b  (A0,D2.W),D0
02:0004C6D0 023C00EE        	  5361:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6D4 122C0003        	  5362:     move.b  ($0003,A4),D1
02:0004C6D8 D101            	  5363:     addx.b  D1,D0   ; ADC $03
02:0004C6DA 19400001        	  5364:     move.b  D0,($0001,A4)
                            	  5365:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5366:     ;
02:0004C6DE 7600            	  5367:     moveq   #0,D3
02:0004C6E0 162C0010        	  5368:     move.b  ($0010,A4),D3
02:0004C6E4 670C            	  5369:     beq  _L_z07_SpreadShot_Draw
02:0004C6E6 0C00003E        	  5370:     cmpi.b  #$3E,D0
02:0004C6EA 6514            	  5371:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C6EC 0C0000E8        	  5372:     cmpi.b  #$E8,D0
02:0004C6F0 640E            	  5373:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5374:     even
                            	  5375: _L_z07_SpreadShot_Draw:
                            	  5376:     ; Draw the corner.
                            	  5377:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5378:     ;
02:0004C6F2 7002            	  5379:     moveq   #2,D0
02:0004C6F4 1940000C        	  5380:     move.b  D0,($000C,A4)
02:0004C6F8 7623            	  5381:     moveq   #35,D3
02:0004C6FA 4EB900031814    	  5382:     jsr     Anim_WriteItemSprites
                            	  5383:     even
                            	  5384: _L_z07_SpreadShot_NextCorner:
                            	  5385:     ; Prepare to process the next corner.
                            	  5386:     ;
                            	  5387:     ; First, restore X offset [02] and Y offset [03].
                            	  5388:     ;
02:0004C700 101D            	  5389:     move.b  (A5)+,D0  ; PLA
02:0004C702 19400003        	  5390:     move.b  D0,($0003,A4)
02:0004C706 101D            	  5391:     move.b  (A5)+,D0  ; PLA
02:0004C708 19400002        	  5392:     move.b  D0,($0002,A4)
                            	  5393:     ; Take turns negating X offset or Y offset for the next round.
                            	  5394:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5395:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5396:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5397:     ; - Fourth turn: doesn't matter
                            	  5398:     ;
                            	  5399:     ;
                            	  5400:     ; Get the loop index.
02:0004C70C 101D            	  5401:     move.b  (A5)+,D0  ; PLA
02:0004C70E 1B00            	  5402:     move.b  D0,-(A5)  ; PHA
02:0004C710 7600            	  5403:     moveq   #0,D3
02:0004C712 1600            	  5404:     move.b  D0,D3
02:0004C714 0C030001        	  5405:     cmpi.b  #$01,D3
02:0004C718 6602            	  5406:     bne  _anon_z07_25
02:0004C71A 7603            	  5407:     moveq   #3,D3
                            	  5408: _anon_z07_25:
02:0004C71C 10343000        	  5409:     move.b  ($00,A4,D3.W),D0
02:0004C720 4600            	  5410:     eori.b #$FF,D0
02:0004C722 023C00EE        	  5411:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C726 123C0001        	  5412:     move.b  #$01,D1
02:0004C72A D101            	  5413:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C72C 19803000        	  5414:     move.b  D0,($00,A4,D3.W)
                            	  5415:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5416:     ;
02:0004C730 101D            	  5417:     move.b  (A5)+,D0  ; PLA
02:0004C732 7600            	  5418:     moveq   #0,D3
02:0004C734 1600            	  5419:     move.b  D0,D3
02:0004C736 5303            	  5420:     subq.b  #1,D3
02:0004C738 6A00FF18        	  5421:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5422:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5423:     ;
                            	  5424:     ; Decrease the base negative offset to get farther away from
                            	  5425:     ; the center point.
                            	  5426:     ;
02:0004C73C 41EC0098        	  5427:     lea     ($0098,A4),A0
02:0004C740 53302000        	  5428:     subq.b  #1,(A0,D2.W)
                            	  5429:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5430:     ;
                            	  5431:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5432:     ;
02:0004C744 41EC0098        	  5433:     lea     ($0098,A4),A0
02:0004C748 10302000        	  5434:     move.b  (A0,D2.W),D0
02:0004C74C 0C0000E8        	  5435:     cmpi.b  #$E8,D0
02:0004C750 6702            	  5436:     beq.s  __far_z_07_0081
02:0004C752 6004            	  5437:     jmp  L1F49F_Exit
                            	  5438: __far_z_07_0081:
02:0004C754 6000FED2        	  5439:     jmp     DeactivateLinkShot
                            	  5440: 
                            	  5441:     even
                            	  5442: L1F49F_Exit:
02:0004C758 4E75            	  5443:     rts
                            	  5444: 
                            	  5445:     even
                            	  5446: UpdateBoomerangOrFood:
                            	  5447:     ; If state = 0, then not active. So, return.
                            	  5448:     ;
02:0004C75A 41EC00AC        	  5449:     lea     ($00AC,A4),A0
02:0004C75E 10302000        	  5450:     move.b  (A0,D2.W),D0
02:0004C762 6602            	  5451:     bne.s  __far_z_07_0082
02:0004C764 60F2            	  5452:     jmp  L1F49F_Exit
                            	  5453: __far_z_07_0082:
                            	  5454:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5455:     ;
02:0004C766 E308            	  5456:     lsl.b  #1,D0   ; ASL A
02:0004C768 6504            	  5457:     bcs.s  __far_z_07_0083
02:0004C76A 600000AA        	  5458:     jmp  UpdateArrowOrBoomerang
                            	  5459: __far_z_07_0083:
                            	  5460:     ; The object is food.
                            	  5461:     ;
                            	  5462:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5463:     ; If we reach state $83, then go deactivate the object.
                            	  5464:     ;
                            	  5465:     ; Nothing changes between the states. So, they are used as
                            	  5466:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5467:     ;
02:0004C76E 10342028        	  5468:     move.b  ($28,A4,D2.W),D0
02:0004C772 6622            	  5469:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
