                            	  2086: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2087:     ; We got here in one of three ways:
                            	  2088:     ;
                            	  2089:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2090:     ;    explicitly.
                            	  2091:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2092:     ;    held an offset that was added to base palette attribute
                            	  2093:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2094:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2095:     ;    held absolute attributes.
                            	  2096:     ;
                            	  2097:     ; At this point, A holds the final sprite attributes.
02:0004AFCA 7400            	  2098:     moveq   #0,D2
02:0004AFCC 1942000C        	  2099:     move.b  D2,($000C,A4)
02:0004AFD0 740F            	  2100:     moveq   #15,D2
                            	  2101:     ; Write sprites.
                            	  2102:     ; A holds the calculated sprite attributes.
                            	  2103:     ; Y holds the item slot.
02:0004AFD2 4EF900031806    	  2104:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2105: 
                            	  2106:     even
                            	  2107: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2108:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2109:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2110:     ; which here represents an offset from the palette row.
                            	  2111:     ;
02:0004AFD8 023C00EE        	  2112:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AFDC 122C0004        	  2113:     move.b  ($0004,A4),D1
02:0004AFE0 D101            	  2114:     addx.b  D1,D0   ; ADC $04
