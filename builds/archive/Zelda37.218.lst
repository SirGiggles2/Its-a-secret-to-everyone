02:00031C4A 1941000D        	  6899:     move.b  D1,($000D,A4)
02:00031C4E 122C000E        	  6900:     move.b  ($000E,A4),D1
02:00031C52 E211            	  6901:     roxr.b  #1,D1   ; ROR $0E
02:00031C54 1941000E        	  6902:     move.b  D1,($000E,A4)
