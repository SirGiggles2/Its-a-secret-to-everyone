02:0003AD38 6674            	  3343:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3344:     ; Only allow two red leevers at a time.
                            	  3345:     ;
02:0003AD3A 102C0510        	  3346:     move.b  ($0510,A4),D0
02:0003AD3E 0C000002        	  3347:     cmpi.b  #$02,D0
02:0003AD42 646A            	  3348:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3349:     ; Face in the same direction as Link.
                            	  3350:     ;
02:0003AD44 102C0098        	  3351:     move.b  ($0098,A4),D0
02:0003AD48 41EC0098        	  3352:     lea     ($0098,A4),A0
02:0003AD4C 11802000        	  3353:     move.b  D0,(A0,D2.W)
                            	  3354:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3355:     ;
02:0003AD50 10342019        	  3356:     move.b  ($19,A4,D2.W),D0
02:0003AD54 0C0000C0        	  3357:     cmpi.b  #$C0,D0
02:0003AD58 6506            	  3358:     bcs  _anon_z04_43
02:0003AD5A 4EB90004C20E    	  3359:     jsr     ReverseObjDir
                            	  3360: _anon_z04_43:
                            	  3361:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3362:     ;
02:0003AD60 41EC0098        	  3363:     lea     ($0098,A4),A0
02:0003AD64 10302000        	  3364:     move.b  (A0,D2.W),D0
02:0003AD68 0200000C        	  3365:     andi.b #$0C,D0
02:0003AD6C 6742            	  3366:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3367:     ; Begin with the leever's X set to Link's X.
                            	  3368:     ;
02:0003AD6E 102C0070        	  3369:     move.b  ($0070,A4),D0
02:0003AD72 19802070        	  3370:     move.b  D0,($70,A4,D2.W)
                            	  3371:     ; If facing down, then use Y offset $28.
                            	  3372:     ; Else store Y offset -$28 in [00].
                            	  3373:     ;
02:0003AD76 7628            	  3374:     moveq   #40,D3
02:0003AD78 41EC0098        	  3375:     lea     ($0098,A4),A0
02:0003AD7C 10302000        	  3376:     move.b  (A0,D2.W),D0
02:0003AD80 02000008        	  3377:     andi.b #$08,D0
02:0003AD84 6704            	  3378:     beq  _anon_z04_44
02:0003AD86 163C00D8        	  3379:     move.b  #$D8,D3
                            	  3380: _anon_z04_44:
02:0003AD8A 1883            	  3381:     move.b  D3,($0000,A4)
                            	  3382:     ; Add Link's Y and the vertical offset.
                            	  3383:     ;
02:0003AD8C 102C0084        	  3384:     move.b  ($0084,A4),D0
02:0003AD90 023C00EE        	  3385:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD94 1214            	  3386:     move.b  ($0000,A4),D1
02:0003AD96 D101            	  3387:     addx.b  D1,D0   ; ADC $00
                            	  3388:     ; Sanitize the Y coordinate:
                            	  3389:     ; (Y AND $F0) OR $D
                            	  3390:     ;
02:0003AD98 020000F0        	  3391:     andi.b #$F0,D0
02:0003AD9C 0000000D        	  3392:     ori.b #$0D,D0
02:0003ADA0 41EC0084        	  3393:     lea     ($0084,A4),A0
02:0003ADA4 11802000        	  3394:     move.b  D0,(A0,D2.W)
                            	  3395:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3396:     ; go see if the tile is valid to come out of.
                            	  3397:     ;
                            	  3398:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3399:     ;
02:0003ADA8 0C00005D        	  3400:     cmpi.b  #$5D,D0
02:0003ADAC 647A            	  3401:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3402:     even
