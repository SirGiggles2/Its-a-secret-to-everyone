02:00030702 0200000F        	  4016:     andi.b #$0F,D0
02:00030706 1880            	  4017:     move.b  D0,($0000,A4)
02:00030708 700F            	  4018:     moveq   #15,D0
02:0003070A 003C0011        	  4019:     ori     #$11,CCR  ; SEC: set C+X
