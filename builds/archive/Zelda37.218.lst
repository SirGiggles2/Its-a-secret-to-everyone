                            	  7551: DodongoBombNegativeLimits:
02:0003CB76 F4              	  7552:     dc.b    $F4, $F0
02:0003CB77 F0
                            	  7553: 
                            	  7554: ; Params:
                            	  7555: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7556: ; [00]: monster hotspot X
                            	  7557: ; [01]: monster hotspot Y
                            	  7558: ; [02]: bomb hotspot X
                            	  7559: ; [03]: bomb hotspot Y
                            	  7560: ;
                            	  7561: ; Returns:
                            	  7562: ; A: 0 if the bomb is in range of the monster
                            	  7563: ; Z: 1 if the bomb is in range of the monster
                            	  7564: ; [04]: horizontal distance
                            	  7565: ; [05]: vertical distance
                            	  7566: ;
                            	  7567: ; Store the positive limit in [06], and the negative one in [07].
                            	  7568: ;
                            	  7569:     even
                            	  7570: Dodongo_IsBombInRange:
02:0003CB78 41F90003CB74    	  7571:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CB7E 10303000        	  7572:     move.b  (A0,D3.W),D0
02:0003CB82 19400006        	  7573:     move.b  D0,($0006,A4)
02:0003CB86 41F90003CB76    	  7574:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CB8C 10303000        	  7575:     move.b  (A0,D3.W),D0
02:0003CB90 19400007        	  7576:     move.b  D0,($0007,A4)
                            	  7577:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7578:     ; the bomb is near enough the monster.
                            	  7579:     ;
02:0003CB94 7003            	  7580:     moveq   #3,D0
02:0003CB96 19400008        	  7581:     move.b  D0,($0008,A4)
                            	  7582:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7583:     ;
02:0003CB9A 7601            	  7584:     moveq   #1,D3
                            	  7585:     even
                            	  7586: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7587:     ; Subtract the bomb's coordinate from the boss's,
                            	  7588:     ; The loop index determines the coordinate.
                            	  7589:     ;
02:0003CB9C 10343000        	  7590:     move.b  ($00,A4,D3.W),D0
02:0003CBA0 003C0011        	  7591:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBA4 12343002        	  7592:     move.b  ($02,A4,D3.W),D1
02:0003CBA8 0A3C0010        	  7593:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBAC 9101            	  7594:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBAE 0A3C0010        	  7595:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7596:     ; If the distance >= positive offset, or < negative offset;
                            	  7597:     ; then loop again.
                            	  7598:     ;
02:0003CBB2 122C0006        	  7599:     move.b  ($0006,A4),D1
02:0003CBB6 B001            	  7600:     cmp.b   D1,D0
02:0003CBB8 6A16            	  7601:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBBA 122C0007        	  7602:     move.b  ($0007,A4),D1
02:0003CBBE B001            	  7603:     cmp.b   D1,D0
02:0003CBC0 6B0E            	  7604:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7605:     ; The distance is close enough in this axis.
                            	  7606:     ;
                            	  7607:     ; Store the distance in this axis in [05] or [04],
                            	  7608:     ; depending on the loop index.
                            	  7609:     ;
02:0003CBC2 19803004        	  7610:     move.b  D0,($04,A4,D3.W)
                            	  7611:     ; Shift [08] right, because we're in range in this axis.
                            	  7612:     ;
02:0003CBC6 122C0008        	  7613:     move.b  ($0008,A4),D1
02:0003CBCA E209            	  7614:     lsr.b  #1,D1   ; LSR $08
02:0003CBCC 19410008        	  7615:     move.b  D1,($0008,A4)
                            	  7616:     even
                            	  7617: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CBD0 5303            	  7618:     subq.b  #1,D3
02:0003CBD2 6AC8            	  7619:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7620:     ; If close enough in both axes, then [08] will be 0.
                            	  7621:     ;
02:0003CBD4 102C0008        	  7622:     move.b  ($0008,A4),D0
02:0003CBD8 4E75            	  7623:     rts
                            	  7624: 
                            	  7625: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7626: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7627: ;
                            	  7628: ; But these are not typical direction indexes. Instead a
                            	  7629: ; 5-way index is used.
                            	  7630: ; A direction shifted right once becomes a 5-way index.
                            	  7631: ; The fourth element is unused.
                            	  7632: ;
                            	  7633:     even
                            	  7634: DodongoFrameImages:
02:0003CBDA 00              	  7635:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CBDB 01
02:0003CBDC 06
02:0003CBDD FF
02:0003CBDE 08
02:0003CBDF 02
02:0003CBE0 03
02:0003CBE1 06
02:0003CBE2 FF              	  7636:     dc.b    $FF, $08
02:0003CBE3 08
                            	  7637: 
                            	  7638:     even
                            	  7639: DodongoFrameHFlips:
02:0003CBE4 00              	  7640:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CBE5 40
02:0003CBE6 00
02:0003CBE7 FF
02:0003CBE8 00
02:0003CBE9 00
02:0003CBEA 40
02:0003CBEB 40
02:0003CBEC FF              	  7641:     dc.b    $FF, $40
02:0003CBED 40
                            	  7642: 
                            	  7643:     even
                            	  7644: DodongoFrameImagesBloated:
02:0003CBEE 04              	  7645:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CBEF 05
02:0003CBF0 07
02:0003CBF1 FF
02:0003CBF2 09
02:0003CBF3 04
02:0003CBF4 05
02:0003CBF5 07
02:0003CBF6 FF              	  7646:     dc.b    $FF, $09
02:0003CBF7 09
                            	  7647: 
                            	  7648:     even
                            	  7649: DodongoFrameHFlipsBloated:
02:0003CBF8 00              	  7650:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CBF9 40
02:0003CBFA 00
02:0003CBFB FF
02:0003CBFC 00
02:0003CBFD 00
02:0003CBFE 40
02:0003CBFF 00
02:0003CC00 FF              	  7651:     dc.b    $FF, $00
02:0003CC01 00
