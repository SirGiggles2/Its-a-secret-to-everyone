                            	 10031: Manhandla_Draw:
02:0003DDE8 4EB90004D344    	 10032:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 10033:     ; Push the "frame image and sprite attributes" value.
                            	 10034:     ;
02:0003DDEE 41EC0478        	 10035:     lea     ($0478,A4),A0
02:0003DDF2 10302000        	 10036:     move.b  (A0,D2.W),D0
02:0003DDF6 1B00            	 10037:     move.b  D0,-(A5)  ; PHA
                            	 10038:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	 10039:     ; passed along as is.
                            	 10040:     ;
02:0003DDF8 02000080        	 10041:     andi.b #$80,D0
