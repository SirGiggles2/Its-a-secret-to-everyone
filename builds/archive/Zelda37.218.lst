                            	  2772: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2773:     ; Set state 1 to jump.
                            	  2774:     ;
02:0003A8EC 41EC00AC        	  2775:     lea     ($00AC,A4),A0
