                            	  3742:     even
                            	  3743: CheckLadder:
02:00041F8C 7400            	  3744:     moveq   #0,D2
02:00041F8E 142C0064        	  3745:     move.b  ($0064,A4),D2
02:00041F92 670000BE        	  3746:     beq  _L_z05_CheckLadder_Exit
                            	  3747:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3748:     ;
02:00041F96 41EC00AC        	  3749:     lea     ($00AC,A4),A0
02:00041F9A 10302000        	  3750:     move.b  (A0,D2.W),D0
02:00041F9E 670000A6        	  3751:     beq  _L_z05_CheckLadder_StashLadder
                            	  3752:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3753:     ; between the ladder and Link.
                            	  3754:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3755:     ;
02:00041FA2 41EC0098        	  3756:     lea     ($0098,A4),A0
02:00041FA6 10302000        	  3757:     move.b  (A0,D2.W),D0
02:00041FAA 0200000C        	  3758:     andi.b #$0C,D0
02:00041FAE 6734            	  3759:     beq  _anon_z05_85
02:00041FB0 102C0070        	  3760:     move.b  ($0070,A4),D0
02:00041FB4 12342070        	  3761:     move.b  ($70,A4,D2.W),D1
02:00041FB8 B001            	  3762:     cmp.b   D1,D0
02:00041FBA 6600008A        	  3763:     bne  _L_z05_CheckLadder_StashLadder
02:00041FBE 102C0084        	  3764:     move.b  ($0084,A4),D0
02:00041FC2 023C00EE        	  3765:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041FC6 123C0003        	  3766:     move.b  #$03,D1
02:00041FCA D101            	  3767:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041FCC 003C0011        	  3768:     ori     #$11,CCR  ; SEC: set C+X
02:00041FD0 41EC0084        	  3769:     lea     ($0084,A4),A0
02:00041FD4 12302000        	  3770:     move.b  (A0,D2.W),D1
02:00041FD8 0A3C0010        	  3771:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041FDC 9101            	  3772:     subx.b  D1,D0   ; SBC ObjY,X
02:00041FDE 0A3C0010        	  3773:     eori    #$10,CCR  ; restore X = 6502 C
02:00041FE2 6030            	  3774:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3775: 
                            	  3776: _anon_z05_85:
                            	  3777:     ; If instead it's facing horizontally, calculate the horizontal distance
