02:0003F562 19400340        	 13238:     move.b  D0,($0340,A4)
02:0003F566 0A3C0001        	 13239:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F56A 4E75            	 13240:     rts
                            	 13241: 
