02:0003C508 9101            	  6658:     subx.b  D1,D0   ; SBC $03
02:0003C50A 0A3C0010        	  6659:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C50E 19802070        	  6660:     move.b  D0,($70,A4,D2.W)
                            	  6661:     even
