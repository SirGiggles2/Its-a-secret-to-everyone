02:0002E0B8 19400604        	   820:     move.b  D0,($0604,A4)
                            	   821:     ; If the high 2 bits of character element = 0, then return.
                            	   822:     ;
02:0002E0BC 1214            	   823:     move.b  ($00,A4),D1   ; ptr lo
02:0002E0BE 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
