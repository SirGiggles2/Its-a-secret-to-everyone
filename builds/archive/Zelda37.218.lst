                            	  5933: _anon_z07_30:
02:0004CA98 4EB900030A90    	  5934:     jsr     GetDirectionsAndDistancesToTarget
                            	  5935:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5936:     ; then go move towards the thrower, draw, and check collisions.
                            	  5937:     ;
02:0004CA9E 1014            	  5938:     move.b  ($0000,A4),D0
