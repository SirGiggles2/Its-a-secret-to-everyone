02:00033CA6 41F900033A02    	  1070:     lea     (DemoLineTextAddrs).l,A0
02:00033CAC 30300000        	  1071:     move.w  (A0,D0.W),D0        ; D0.w = offset into DemoTextFields
02:00033CB0 41F9000337EE    	  1072:     lea     (DemoTextFields).l,A0
02:00033CB6 D0C0            	  1073:     adda.w  D0,A0               ; A0 -> text field entry in ROM
02:00033CB8 7600            	  1074:     moveq   #0,D3               ; Y index into text field
02:00033CBA 10303000        	  1075:     move.b  (A0,D3.W),D0        ; first byte = column offset
02:00033CBE 7400            	  1076:     moveq   #0,D2
02:00033CC0 1400            	  1077:     move.b  D0,D2
