02:0002E08E 182C0001        	   799:     move.b  ($01,A4),D4  ; ptr hi
02:0002E092 024100FF        	   800:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E096 E14C            	   801:     lsl.w   #8,D4
02:0002E098 8841            	   802:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E09A 48C4            	   803:     ext.l   D4
