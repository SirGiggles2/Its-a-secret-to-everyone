                            	 12107: __far_z_04_0123:
                            	 12108:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12109:     ; We had to account for the usual offset of 3.
                            	 12110:     ;
02:0003ED8E 41EC0084        	 12111:     lea     ($0084,A4),A0
02:0003ED92 10302000        	 12112:     move.b  (A0,D2.W),D0
02:0003ED96 023C00EE        	 12113:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED9A 123C0003        	 12114:     move.b  #$03,D1
02:0003ED9E D101            	 12115:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDA0 02000007        	 12116:     andi.b #$07,D0
02:0003EDA4 6702            	 12117:     beq.s  __far_z_04_0124
02:0003EDA6 60D8            	 12118:     jmp  L12A6F_Exit
                            	 12119: __far_z_04_0124:
                            	 12120:     ; Will loop 4 times, propagating directions down the chain,
                            	 12121:     ; by pulling from the bottom.
                            	 12122:     ;
02:0003EDA8 7004            	 12123:     moveq   #4,D0
02:0003EDAA 1880            	 12124:     move.b  D0,($0000,A4)
                            	 12125:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12126:     ;
