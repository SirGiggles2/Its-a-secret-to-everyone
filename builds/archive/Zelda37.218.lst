02:0003AEEA D101            	  3576:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003AEEC 0C000006        	  3577:     cmpi.b  #$06,D0
02:0003AEF0 6506            	  3578:     bcs  _anon_z04_47
02:0003AEF2 532C0510        	  3579:     subq.b  #1,($0510,A4)
02:0003AEF6 7000            	  3580:     moveq   #0,D0
                            	  3581: _anon_z04_47:
