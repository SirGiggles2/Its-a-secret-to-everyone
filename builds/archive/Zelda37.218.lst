                            	  4089:     ; else
                            	  4090:     ;   if slot <> 0 and (has clock or stunned) then
                            	  4091:     ;     return
                            	  4092:     ;   else
                            	  4093:     ;     if input dir = 0
                            	  4094:     ;       use 0
                            	  4095:     ;     else
                            	  4096:     ;       use input direction
                            	  4097:     ;
