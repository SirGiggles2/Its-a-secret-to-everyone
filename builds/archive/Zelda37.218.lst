                            	  6016: _anon_z04_81:
                            	  6017:     ; Chase while flying, as usual.
                            	  6018:     ;
02:0003C0A4 61003D34        	  6019:     jsr     Flyer_Chase
                            	  6020:     ; If timer has not expired, then
                            	  6021:     ; go see if it's time to propagate direction changes down the chain.
                            	  6022:     ;
02:0003C0A8 10342028        	  6023:     move.b  ($28,A4,D2.W),D0
02:0003C0AC 6702            	  6024:     beq.s  __far_z_04_0045
