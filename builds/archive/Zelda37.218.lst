                            	  4336: PlayerScreenEdgeBounds:
02:0004C044 3D              	  4337:     dc.b    $3D, $DD, $00, $F0
02:0004C045 DD
02:0004C046 00
02:0004C047 F0
                            	  4338: 
                            	  4339: ; Params:
                            	  4340: ; [0E]: $FF, if blocked by a door
                            	  4341: ; [0F]: movement direction
                            	  4342: ;
                            	  4343: ; Returns:
                            	  4344: ; [0F]: untouched, or changed if blocked or need to change
                            	  4345: ;
                            	  4346: ; Summary:
                            	  4347: ;
                            	  4348: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4349: ; Then allow movement or go to the next room. Otherwise,
                            	  4350: ; check passive tile objects and stop moving.
                            	  4351: ;
                            	  4352: ; For other objects: First, if moving, test the colliding tile for
                            	  4353: ; walkability. Otherwise search for a walkable direction starting
                            	  4354: ; from input direction.
                            	  4355: ;
                            	  4356: ; When you find a walkable direction, see if it makes the object
                            	  4357: ; cross a boundary. If it doesn't, then make this direction
                            	  4358: ; the objection direction. Otherwise, keep looping.
                            	  4359: ;
                            	  4360: ; If no walkable direction is found, then stop moving.
                            	  4361: ;
                            	  4362: ;
                            	  4363: ; if is player
                            	  4364: ;   if at doorway
                            	  4365: ;     go handle a walkable direction
                            	  4366: ;   if blocked by door
                            	  4367: ;     return
                            	  4368: ;
                            	  4369:     even
                            	  4370: Walker_CheckTileCollision:
                            	  4371:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4372:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4373:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4374:     ; reset) for Link and every other object. Only the tile
                            	  4375:     ; walkability decision in CheckTiles is overridden.
02:0004C048 4A02            	  4376:     cmpi.b  #$00,D2
02:0004C04A 6614            	  4377:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004C04C 102C0053        	  4378:     move.b  ($0053,A4),D0
02:0004C050 6704            	  4379:     beq  _anon_z07_16
02:0004C052 600000BE        	  4380:     jmp     GoWalkableDir
                            	  4381: 
                            	  4382: _anon_z07_16:
02:0004C056 102C000E        	  4383:     move.b  ($000E,A4),D0
02:0004C05A 6A04            	  4384:     bpl.s  __far_z_07_0051
02:0004C05C 600000AC        	  4385:     jmp  L1F148_Exit
                            	  4386: __far_z_07_0051:
                            	  4387:     even
                            	  4388: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4389:     ; If grid offset <> 0, return.
                            	  4390:     ;
02:0004C060 41EC0394        	  4391:     lea     ($0394,A4),A0
02:0004C064 10302000        	  4392:     move.b  (A0,D2.W),D0
02:0004C068 6704            	  4393:     beq.s  __far_z_07_0052
02:0004C06A 6000009E        	  4394:     jmp  L1F148_Exit
                            	  4395: __far_z_07_0052:
                            	  4396:     ; Grid offset = 0.
                            	  4397:     ; The object is at a point between cells in the grid.
                            	  4398:     ; So, we can check tiles for collision.
                            	  4399:     ;
                            	  4400:     ; Reset [0E] alternate direction search step.
                            	  4401:     ;
02:0004C06E 1940000E        	  4402:     move.b  D0,($000E,A4)
                            	  4403:     ; If there's a movement direction, go check tile collision.
                            	  4404:     ;
02:0004C072 102C000F        	  4405:     move.b  ($000F,A4),D0
02:0004C076 6702            	  4406:     beq.s  __far_z_07_0053
02:0004C078 602E            	  4407:     jmp  CheckTiles
                            	  4408: __far_z_07_0053:
                            	  4409:     ; Moving direction = 0.
                            	  4410:     ; If object is the player, return.
                            	  4411:     ;
02:0004C07A 4A02            	  4412:     cmpi.b  #$00,D2
02:0004C07C 6604            	  4413:     bne.s  __far_z_07_0054
02:0004C07E 6000008A        	  4414:     jmp  L1F148_Exit
                            	  4415: __far_z_07_0054:
                            	  4416:     ; Moving direction = 0.
                            	  4417:     ; The object is not the player.
                            	  4418:     ;
                            	  4419:     ; If object does not have attribute $10, then
                            	  4420:     ; set movement direction to input direction,
                            	  4421:     ; and go try to turn to an unblocked direction in order to move.
                            	  4422:     ;
02:0004C082 41EC04BF        	  4423:     lea     ($04BF,A4),A0
02:0004C086 10302000        	  4424:     move.b  (A0,D2.W),D0
02:0004C08A 02000010        	  4425:     andi.b #$10,D0
02:0004C08E 6702            	  4426:     beq.s  __far_z_07_0055
02:0004C090 600E            	  4427:     jmp  Reverse
                            	  4428: __far_z_07_0055:
02:0004C092 41EC03F8        	  4429:     lea     ($03F8,A4),A0
02:0004C096 10302000        	  4430:     move.b  (A0,D2.W),D0
02:0004C09A 1940000F        	  4431:     move.b  D0,($000F,A4)
02:0004C09E 6038            	  4432:     jmp     TryNextDir
                            	  4433: 
                            	  4434:     even
