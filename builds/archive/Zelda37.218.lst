02:0003DE9C 122C0002        	 10127:     move.b  ($0002,A4),D1
02:0003DEA0 C200            	 10128:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEA2 6704            	 10129:     beq  _anon_z04_118
