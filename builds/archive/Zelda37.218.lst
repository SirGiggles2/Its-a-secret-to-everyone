02:0004D14A 9101            	  6848:     subx.b  D1,D0   ; SBC ObjY,X
02:0004D14C 0A3C0010        	  6849:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D150 4EB900030A3C    	  6850:     jsr     Abs
