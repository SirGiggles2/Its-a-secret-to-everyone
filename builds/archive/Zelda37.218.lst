02:0004D77E 142C0340        	  7609:     move.b  ($0340,A4),D2
                            	  7610:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7611:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7612:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7613:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7614:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7615:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7616:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7617:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7618:     ; corrupting them and causing a deterministic address-error
                            	  7619:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7620:     ; identified by Codex static review.)
                            	  7621: _L_z07_P47_pre_check:
02:0004D782 102C0525        	  7622:     move.b  ($0525,A4),D0
02:0004D786 020000F0        	  7623:     andi.b  #$F0,D0
02:0004D78A 0C000040        	  7624:     cmpi.b  #$40,D0
02:0004D78E 6506            	  7625:     blo     _L_z07_P47_pre_snap
02:0004D790 0C0000E0        	  7626:     cmpi.b  #$E0,D0
02:0004D794 6506            	  7627:     blo     _L_z07_P47_pre_ok
                            	  7628: _L_z07_P47_pre_snap:
02:0004D796 197C00480525    	  7629:     move.b  #$48,($0525,A4)
                            	  7630: _L_z07_P47_pre_ok:
02:0004D79C 7005            	  7631:     moveq   #5,D0
02:0004D79E 61000500        	  7632:     jsr     SwitchBank
02:0004D7A2 4EB90004210C    	  7633:     jsr     FindNextEdgeSpawnCell
                            	  7634:     ; Post-walk 1: bottom-edge snap.
02:0004D7A8 102C0525        	  7635:     move.b  ($0525,A4),D0
02:0004D7AC 020000F0        	  7636:     andi.b  #$F0,D0
02:0004D7B0 0C0000E0        	  7637:     cmpi.b  #$E0,D0
02:0004D7B4 660C            	  7638:     bne     _L_z07_P47_post1_ok
02:0004D7B6 197C00480525    	  7639:     move.b  #$48,($0525,A4)
02:0004D7BC 4EB90004210C    	  7640:     jsr     FindNextEdgeSpawnCell
                            	  7641: _L_z07_P47_post1_ok:
                            	  7642:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7643:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D7C2 7600            	  7644:     moveq   #0,D3
02:0004D7C4 162C0525        	  7645:     move.b  ($0525,A4),D3
02:0004D7C8 0243000F        	  7646:     andi.w  #$000F,D3
02:0004D7CC C6FC002C        	  7647:     mulu.w  #44,D3
02:0004D7D0 203C00FF6530    	  7648:     move.l  #$FF6530,D0
02:0004D7D6 D083            	  7649:     add.l   D3,D0
02:0004D7D8 7600            	  7650:     moveq   #0,D3
02:0004D7DA 162C0525        	  7651:     move.b  ($0525,A4),D3
02:0004D7DE E84B            	  7652:     lsr.w   #4,D3
02:0004D7E0 5943            	  7653:     subi.w  #4,D3
02:0004D7E2 E34B            	  7654:     lsl.w   #1,D3
02:0004D7E4 D083            	  7655:     add.l   D3,D0
02:0004D7E6 2040            	  7656:     movea.l D0,A0
02:0004D7E8 1010            	  7657:     move.b  (A0),D0
02:0004D7EA 0C000084        	  7658:     cmpi.b  #$84,D0
02:0004D7EE 6544            	  7659:     blo     _L_z07_P47_post2_ok
                            	  7660:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7661:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7662:     ; writes to the $05xx region.
02:0004D7F0 7800            	  7663:     moveq   #0,D4
                            	  7664: _L_z07_P47_fb_loop:
