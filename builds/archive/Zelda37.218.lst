02:0003AA06 0A3C0010        	  2926:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA0A 9101            	  2927:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AA0C 0A3C0010        	  2928:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AA10 4EB900030A3C    	  2929:     jsr     Abs
