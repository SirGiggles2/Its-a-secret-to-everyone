                            	  1373: ;----------------------------------------------------------------------
                            	  1374: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1375: ; Layout per slot:
                            	  1376: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1377: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1378: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1379: ;   +3 reserved
                            	  1380: ;
                            	  1381: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1382: ; values are placeholders.
                            	  1383: ;----------------------------------------------------------------------
                            	  1384: PsgDrumTable:
02:00000DF6 E7              	  1385:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000DF7 00
02:00000DF8 00
02:00000DF9 00
02:00000DFA E4              	  1386:     dc.b    $E4, $E0, 48,  $00         ; 1: hi-hat  — white NF=00, ~5 frames
02:00000DFB E0
02:00000DFC 30
02:00000DFD 00
02:00000DFE E5              	  1387:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000DFF FF
02:00000E00 0E
02:00000E01 00
02:00000E02 E4              	  1388:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
02:00000E03 E0
02:00000E04 30
02:00000E05 00
                            	  1389:     even
