02:00031D2C 700A            	  7013:     moveq   #10,D0
02:00031D2E 1940000D        	  7014:     move.b  D0,($000D,A4)
02:00031D32 1940000E        	  7015:     move.b  D0,($000E,A4)
                            	  7016:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  7017:     ;
02:00031D36 10343070        	  7018:     move.b  ($70,A4,D3.W),D0
02:00031D3A 023C00EE        	  7019:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D3E 123C0004        	  7020:     move.b  #$04,D1
02:00031D42 D101            	  7021:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031D44 19400004        	  7022:     move.b  D0,($0004,A4)
                            	  7023:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  7024:     ;
02:00031D48 41EC0084        	  7025:     lea     ($0084,A4),A0
02:00031D4C 10303000        	  7026:     move.b  (A0,D3.W),D0
02:00031D50 023C00EE        	  7027:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D54 123C0008        	  7028:     move.b  #$08,D1
02:00031D58 D101            	  7029:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7030: ; Params:
                            	  7031: ; A: weapon object mid Y
                            	  7032: ; X: monster object slot
                            	  7033: ; Y: weapon object slot
                            	  7034: ; [00]: weapon object slot
                            	  7035: ; [02]: monster object mid X
                            	  7036: ; [03]: monster object mid Y
                            	  7037: ; [04]: weapon object mid X
                            	  7038: ; [07]: damage points
                            	  7039: ; [09]: damage type
