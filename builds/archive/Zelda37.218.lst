                            	 10100: 
                            	 10101:     even
                            	 10102: _L_z04_UpdateGohma_Move:
                            	 10103:     ; Add $80 to the movement accumulator.
                            	 10104:     ;
02:0003DE68 41EC041F        	 10105:     lea     ($041F,A4),A0
02:0003DE6C 10302000        	 10106:     move.b  (A0,D2.W),D0
02:0003DE70 023C00EE        	 10107:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE74 123C0080        	 10108:     move.b  #$80,D1
02:0003DE78 D101            	 10109:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE7A 41EC041F        	 10110:     lea     ($041F,A4),A0
02:0003DE7E 11802000        	 10111:     move.b  D0,(A0,D2.W)
                            	 10112:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	 10113:     ;
