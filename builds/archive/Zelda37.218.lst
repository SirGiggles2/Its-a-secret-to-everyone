                            	  4088: UpdatePondFairy:
02:0003B24A 6100499E        	  4089:     jsr     DrawFairy
                            	  4090:     ; If not in state 0, then go handle states 1 to 3.
                            	  4091:     ;
02:0003B24E 102C00AD        	  4092:     move.b  ($00AD,A4),D0
02:0003B252 6702            	  4093:     beq.s  __far_z_04_0037
02:0003B254 602A            	  4094:     jmp  PondFairy_HandleOtherStates
                            	  4095: __far_z_04_0037:
                            	  4096:     ; State 0.
                            	  4097:     ;
                            	  4098:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4099:     ;
02:0003B256 102C0084        	  4100:     move.b  ($0084,A4),D0
02:0003B25A 0C0000AD        	  4101:     cmpi.b  #$AD,D0
02:0003B25E 661E            	  4102:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4103:     ; If Link's X < $70 or >= $81, then return.
                            	  4104:     ;
02:0003B260 102C0070        	  4105:     move.b  ($0070,A4),D0
02:0003B264 0C000070        	  4106:     cmpi.b  #$70,D0
02:0003B268 6514            	  4107:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B26A 0C000081        	  4108:     cmpi.b  #$81,D0
02:0003B26E 640E            	  4109:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4110:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4111:     ; halt Link, and start filling hearts.
                            	  4112:     ;
02:0003B270 522C00AD        	  4113:     addq.b  #1,($00AD,A4)
02:0003B274 7040            	  4114:     moveq   #64,D0
02:0003B276 194000AC        	  4115:     move.b  D0,($00AC,A4)
02:0003B27A 19400063        	  4116:     move.b  D0,($0063,A4)
                            	  4117:     even
                            	  4118: _L_z04_UpdatePondFairy_Exit:
02:0003B27E 4E75            	  4119:     rts
                            	  4120: 
                            	  4121:     even
                            	  4122: PondFairy_HandleOtherStates:
02:0003B280 0C000001        	  4123:     cmpi.b  #$01,D0
02:0003B284 6610            	  4124:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4125:     ; State 1. Flying and filling hearts.
                            	  4126:     ;
                            	  4127:     ; If still filling hearts, then go draw Link and hearts.
                            	  4128:     ;
02:0003B286 102C0063        	  4129:     move.b  ($0063,A4),D0
02:0003B28A 6620            	  4130:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4131:     ; If not filling hearts anymore, then go to state 2,
                            	  4132:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4133:     ; a little while after we finish filling hearts.
                            	  4134:     ;
02:0003B28C 522C00AD        	  4135:     addq.b  #1,($00AD,A4)
02:0003B290 7050            	  4136:     moveq   #80,D0
02:0003B292 19400029        	  4137:     move.b  D0,($0029,A4)
                            	  4138:     even
                            	  4139: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4140:     ; If state <> 2 (so, it's 3), then return.
                            	  4141:     ;
                            	  4142:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4143:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4144:     ; was set to, and we'll return.
                            	  4145:     ;
02:0003B296 0C000002        	  4146:     cmpi.b  #$02,D0
02:0003B29A 6634            	  4147:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4148:     ; State = 2.
                            	  4149:     ;
                            	  4150:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4151:     ;
02:0003B29C 102C0029        	  4152:     move.b  ($0029,A4),D0
02:0003B2A0 660A            	  4153:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4154:     ; Else go to state 3, and unhalt Link.
                            	  4155:     ;
02:0003B2A2 522C00AD        	  4156:     addq.b  #1,($00AD,A4)
02:0003B2A6 7000            	  4157:     moveq   #0,D0
02:0003B2A8 194000AC        	  4158:     move.b  D0,($00AC,A4)
                            	  4159:     even
                            	  4160: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4161:     ; TODO: but why, since Link is halted?
                            	  4162:     ;
                            	  4163:     ; Reset the input direction, so that Link doesn't animate
                            	  4164:     ; when drawing him.
02:0003B2AC 7600            	  4165:     moveq   #0,D3
02:0003B2AE 194303F8        	  4166:     move.b  D3,($03F8,A4)
                            	  4167:     ; Save and reset Link's state.
                            	  4168:     ;
                            	  4169:     ; TODO: but why, since Link is halted?
                            	  4170:     ;
02:0003B2B2 102C00AC        	  4171:     move.b  ($00AC,A4),D0
02:0003B2B6 1B00            	  4172:     move.b  D0,-(A5)  ; PHA
02:0003B2B8 194300AC        	  4173:     move.b  D3,($00AC,A4)
02:0003B2BC 4EB90004C258    	  4174:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4175:     ; Restore Link's state.
                            	  4176:     ;
02:0003B2C2 101D            	  4177:     move.b  (A5)+,D0  ; PLA
02:0003B2C4 194000AC        	  4178:     move.b  D0,($00AC,A4)
02:0003B2C8 6110            	  4179:     jsr     PondFairy_MoveHearts
