02:0003D11A 41EC03E4        	  8326:     lea     ($03E4,A4),A0
02:0003D11E 16302000        	  8327:     move.b  (A0,D2.W),D3
02:0003D122 5203            	  8328:     addq.b  #1,D3
02:0003D124 1003            	  8329:     move.b  D3,D0
02:0003D126 02000003        	  8330:     andi.b #$03,D0
02:0003D12A 41EC03E4        	  8331:     lea     ($03E4,A4),A0
02:0003D12E 11802000        	  8332:     move.b  D0,(A0,D2.W)
