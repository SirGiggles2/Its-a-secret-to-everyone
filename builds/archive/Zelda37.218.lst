                            	  8573: ; Description:
                            	  8574: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8575: ; When walking, the object timer is set. When teleporting,
                            	  8576: ; the teleporting distance remaining is set.
                            	  8577: ;
                            	  8578: ; If we have the magic clock, then only go draw and check collisions.
                            	  8579: ;
                            	  8580:     even
                            	  8581: UpdateBlueWizzrobe:
02:0003D32C 102C066C        	  8582:     move.b  ($066C,A4),D0
02:0003D330 6702            	  8583:     beq.s  __far_z_04_0075
02:0003D332 6014            	  8584:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8585: __far_z_04_0075:
