02:0003C52C 41EC0084        	  6673:     lea     ($0084,A4),A0
02:0003C530 10302000        	  6674:     move.b  (A0,D2.W),D0
02:0003C534 122C0003        	  6675:     move.b  ($0003,A4),D1
