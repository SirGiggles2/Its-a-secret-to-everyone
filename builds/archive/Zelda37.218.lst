                            	  4256:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4257:     ;
02:0003B33C 102C0071        	  4258:     move.b  ($0071,A4),D0
02:0003B340 19802070        	  4259:     move.b  D0,($70,A4,D2.W)
                            	  4260:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  4261:     ;
02:0003B344 102C0085        	  4262:     move.b  ($0085,A4),D0
02:0003B348 003C0011        	  4263:     ori     #$11,CCR  ; SEC: set C+X
02:0003B34C 123C001C        	  4264:     move.b  #$1C,D1
02:0003B350 0A3C0010        	  4265:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B354 9101            	  4266:     subx.b  D1,D0   ; SBC #$1C
02:0003B356 0A3C0010        	  4267:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B35A 41EC0084        	  4268:     lea     ($0084,A4),A0
