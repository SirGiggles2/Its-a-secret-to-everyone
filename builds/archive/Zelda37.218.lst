02:000403E6 102C0010        	   520:     move.b  ($0010,A4),D0
02:000403EA 6606            	   521:     bne.s  __far_z_05_0005
02:000403EC 4EF90002CF42    	   522:     jmp  Exit
                            	   523: __far_z_05_0005:
02:000403F2 61005252        	   524:     jsr     HasCompass
02:000403F6 6606            	   525:     bne.s  __far_z_05_0006
