                            	  5650: _L_z07_UpdateArrowOrBoomerang_CompareLimit:
                            	  5651:     ; For boomerangs, compare it to the movement limit.
                            	  5652:     ; If it reached the limit, set state $20 and a new movement
                            	  5653:     ; limit of $10, and go handle the rest as if blocked.
                            	  5654:     ; State $20 will become $30 below in HandleArrowOrBoomerangBlocked.
                            	  5655:     ;
                            	  5656:     ; Otherwise, only animate and check collision as usual.
                            	  5657:     ;
