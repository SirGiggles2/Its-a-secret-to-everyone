                            	  5359: _anon_z04_69:
02:0003BB6E 4E75            	  5360:     rts
                            	  5361: 
                            	  5362: ; Params:
                            	  5363: ; A: offset of first instruction for left wall (0)
                            	  5364: ;    or top wall ($20)
                            	  5365: ; Y: Link's minimum major coordinate
                            	  5366: ; [00]: Link's coordinate along minor axis
                            	  5367: ; [01]: Link's coordinate along major axis
                            	  5368: ; [02]: a decreasing direction along the wall (left or up)
                            	  5369: ;
                            	  5370: ; Returns:
                            	  5371: ; Y: index of initial major coordinate of Wallmaster
                            	  5372: ; [04]: initial minor coordinate of Wallmaster
                            	  5373: ;
                            	  5374: ; Store the initial offset for this axis.
                            	  5375: ;
                            	  5376:     even
                            	  5377: Wallmaster_CalcStartPosition:
02:0003BB70 41EC0412        	  5378:     lea     ($0412,A4),A0
02:0003BB74 11802000        	  5379:     move.b  D0,(A0,D2.W)
02:0003BB78 19430003        	  5380:     move.b  D3,($0003,A4)
                            	  5381:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5382:     ;
02:0003BB7C 7024            	  5383:     moveq   #36,D0
02:0003BB7E 7600            	  5384:     moveq   #0,D3
02:0003BB80 162C03F8        	  5385:     move.b  ($03F8,A4),D3
02:0003BB84 6702            	  5386:     beq  _anon_z04_70
02:0003BB86 7032            	  5387:     moveq   #50,D0
                            	  5388: _anon_z04_70:
                            	  5389:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5390:     ; 1. negate the distance
                            	  5391:     ; 2. add 8 to the instruction offset to access
                            	  5392:     ;    the opposite direction for the same wall
                            	  5393:     ;
02:0003BB88 7600            	  5394:     moveq   #0,D3
02:0003BB8A 162C0098        	  5395:     move.b  ($0098,A4),D3
02:0003BB8E 122C0002        	  5396:     move.b  ($0002,A4),D1
02:0003BB92 B601            	  5397:     cmp.b   D1,D3
02:0003BB94 662A            	  5398:     bne  _anon_z04_71
02:0003BB96 1B00            	  5399:     move.b  D0,-(A5)  ; PHA
02:0003BB98 41EC0412        	  5400:     lea     ($0412,A4),A0
02:0003BB9C 10302000        	  5401:     move.b  (A0,D2.W),D0
02:0003BBA0 023C00EE        	  5402:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBA4 123C0008        	  5403:     move.b  #$08,D1
02:0003BBA8 D101            	  5404:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBAA 41EC0412        	  5405:     lea     ($0412,A4),A0
02:0003BBAE 11802000        	  5406:     move.b  D0,(A0,D2.W)
02:0003BBB2 101D            	  5407:     move.b  (A5)+,D0  ; PLA
02:0003BBB4 4600            	  5408:     eori.b #$FF,D0
02:0003BBB6 023C00EE        	  5409:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBBA 123C0001        	  5410:     move.b  #$01,D1
02:0003BBBE D101            	  5411:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5412: _anon_z04_71:
                            	  5413:     ; Add the distance and Link's minor coordinate to calculate
                            	  5414:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5415:     ; In general, the monster will be put in front of Link.
                            	  5416:     ;
02:0003BBC0 023C00EE        	  5417:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBC4 1214            	  5418:     move.b  ($0000,A4),D1
02:0003BBC6 D101            	  5419:     addx.b  D1,D0   ; ADC $00
02:0003BBC8 19400004        	  5420:     move.b  D0,($0004,A4)
                            	  5421:     ; By default, will return index 0 to choose the minimum value
                            	  5422:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5423:     ; if Link is at the wall with a smaller major coordinate.
                            	  5424:     ;
02:0003BBCC 7600            	  5425:     moveq   #0,D3
                            	  5426:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5427:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5428:     ; to access the block for the other direction along the same axis,
                            	  5429:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5430:     ;
02:0003BBCE 102C0001        	  5431:     move.b  ($0001,A4),D0
02:0003BBD2 122C0003        	  5432:     move.b  ($0003,A4),D1
02:0003BBD6 B001            	  5433:     cmp.b   D1,D0
02:0003BBD8 671C            	  5434:     beq  _anon_z04_72
02:0003BBDA 41EC0412        	  5435:     lea     ($0412,A4),A0
02:0003BBDE 10302000        	  5436:     move.b  (A0,D2.W),D0
02:0003BBE2 023C00EE        	  5437:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBE6 123C0010        	  5438:     move.b  #$10,D1
02:0003BBEA D101            	  5439:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BBEC 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003BBF0 11802000        	  5441:     move.b  D0,(A0,D2.W)
02:0003BBF4 5203            	  5442:     addq.b  #1,D3
