                            	  2860: _anon_z04_37:
02:0003A982 61000196        	  2861:     jsr     Jumper_PointBoulderDownward
                            	  2862:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2863:     ;
02:0003A986 7000            	  2864:     moveq   #0,D0
02:0003A988 41EC0451        	  2865:     lea     ($0451,A4),A0
02:0003A98C 11802000        	  2866:     move.b  D0,(A0,D2.W)
                            	  2867:     ; Get the base offset for the kind of jumper the object is.
                            	  2868:     ;
02:0003A990 6100015E        	  2869:     jsr     Jumper_GetKind
02:0003A994 41F90003A880    	  2870:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A99A 10303000        	  2871:     move.b  (A0,D3.W),D0
                            	  2872:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2873:     ;
                            	  2874:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2875:     ; does not have $B elements like the tektites' sets.
                            	  2876:     ;
                            	  2877:     ; Boulder does not need the upward accelerations.
                            	  2878:     ; So, the elements for those are used for the starting speeds
                            	  2879:     ; at 04:88F2.
                            	  2880:     ;
02:0003A99E 023C00EE        	  2881:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9A2 41EC0098        	  2882:     lea     ($0098,A4),A0
02:0003A9A6 12302000        	  2883:     move.b  (A0,D2.W),D1
02:0003A9AA D101            	  2884:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A9AC 7600            	  2885:     moveq   #0,D3
02:0003A9AE 1600            	  2886:     move.b  D0,D3
02:0003A9B0 41F90003A85E    	  2887:     lea     (JumperYAccelerations).l,A0
02:0003A9B6 10303000        	  2888:     move.b  (A0,D3.W),D0
02:0003A9BA 7602            	  2889:     moveq   #2,D3
02:0003A9BC 61000162        	  2890:     jsr     Jumper_MoveY
                            	  2891:     ; If the facing direction has a left component, then
                            	  2892:     ; subtract 1 from the object's X.
                            	  2893:     ;
                            	  2894:     ; Else add 1.
                            	  2895:     ;
02:0003A9C0 163C00FF        	  2896:     move.b  #$FF,D3
