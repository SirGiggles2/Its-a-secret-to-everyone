                            	 11257: __far_z_04_0107:
                            	 11258:     ; The segment is not a head nor bottom. So, we can use a
                            	 11259:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11260:     ; that is drawn under Link and the heads.
                            	 11261:     ;
02:0003E706 4EB9000318F8    	 11262:     jsr     Anim_WriteLevelPaletteSprite
                            	 11263:     even
                            	 11264: Gleeok_CheckCollisions:
                            	 11265:     ; If this segment is not the head nor the bottom of the neck,
                            	 11266:     ; then loop again to process the next segment.
                            	 11267:     ;
                            	 11268:     ; This kind of segment is only drawn, and is not checked
                            	 11269:     ; for object collisions.
                            	 11270:     ;
02:0003E70C 0C020005        	 11271:     cmpi.b  #$05,D2
02:0003E710 670A            	 11272:     beq  _anon_z04_141
02:0003E712 0C020001        	 11273:     cmpi.b  #$01,D2
02:0003E716 6704            	 11274:     beq  _anon_z04_141
02:0003E718 6000010C        	 11275:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11276: 
                            	 11277: _anon_z04_141:
02:0003E71C 4EB90003197E    	 11278:     jsr     CheckMonsterCollisions
                            	 11279:     ; If this segment was harmed, then set the writhing counter,
                            	 11280:     ; and the animation counter to its lower value.
                            	 11281:     ;
02:0003E722 41EC00C0        	 11282:     lea     ($00C0,A4),A0
02:0003E726 10302000        	 11283:     move.b  (A0,D2.W),D0
02:0003E72A 670A            	 11284:     beq  _anon_z04_142
02:0003E72C 7006            	 11285:     moveq   #6,D0
02:0003E72E 194004E6        	 11286:     move.b  D0,($04E6,A4)
02:0003E732 19400510        	 11287:     move.b  D0,($0510,A4)
                            	 11288: _anon_z04_142:
02:0003E736 4EB90004BCB2    	 11289:     jsr     ResetShoveInfo
                            	 11290:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11291:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11292:     ;
02:0003E73C 0C020001        	 11293:     cmpi.b  #$01,D2
02:0003E740 670000DE        	 11294:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E744 6100AF88        	 11295:     jsr     PlayBossHitCryIfNeeded
                            	 11296:     ; If this neck has not died, then go loop again.
                            	 11297:     ;
02:0003E748 41EC0405        	 11298:     lea     ($0405,A4),A0
02:0003E74C 10302000        	 11299:     move.b  (A0,D2.W),D0
02:0003E750 670000D4        	 11300:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11301:     ; This neck died. So, prepare to make a flying head.
                            	 11302:     ;
02:0003E754 7060            	 11303:     moveq   #96,D0
02:0003E756 41EC0485        	 11304:     lea     ($0485,A4),A0
02:0003E75A 11802000        	 11305:     move.b  D0,(A0,D2.W)
02:0003E75E 1002            	 11306:     move.b  D2,D0
02:0003E760 1B00            	 11307:     move.b  D0,-(A5)  ; PHA
                            	 11308:     ; If the segment is not a head, then skip making a flying head.
                            	 11309:     ;
                            	 11310:     ; TODO:
                            	 11311:     ; But how can we get here in this case, since earlier branches
                            	 11312:     ; would have been taken to skip all this for all other segments?
                            	 11313:     ;
02:0003E762 0C020005        	 11314:     cmpi.b  #$05,D2
02:0003E766 663C            	 11315:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11316:     ; The flying head will go in slot (neck index + 7).
                            	 11317:     ; Switch the X register to it.
                            	 11318:     ;
02:0003E768 102C04D7        	 11319:     move.b  ($04D7,A4),D0
02:0003E76C 023C00EE        	 11320:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E770 123C0007        	 11321:     move.b  #$07,D1
02:0003E774 D101            	 11322:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E776 7400            	 11323:     moveq   #0,D2
02:0003E778 1400            	 11324:     move.b  D0,D2
                            	 11325:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11326:     ;
02:0003E77A 103C00FF        	 11327:     move.b  #$FF,D0
02:0003E77E 41EC0492        	 11328:     lea     ($0492,A4),A0
02:0003E782 11802000        	 11329:     move.b  D0,(A0,D2.W)
                            	 11330:     ; Copy the original head's coordinates to it.
                            	 11331:     ;
02:0003E786 102C0075        	 11332:     move.b  ($0075,A4),D0
02:0003E78A 19802070        	 11333:     move.b  D0,($70,A4,D2.W)
02:0003E78E 102C0089        	 11334:     move.b  ($0089,A4),D0
02:0003E792 41EC0084        	 11335:     lea     ($0084,A4),A0
02:0003E796 11802000        	 11336:     move.b  D0,(A0,D2.W)
                            	 11337:     ; Set object type $46 (flying head).
                            	 11338:     ;
02:0003E79A 7046            	 11339:     moveq   #70,D0
02:0003E79C 41EC034F        	 11340:     lea     ($034F,A4),A0
02:0003E7A0 11802000        	 11341:     move.b  D0,(A0,D2.W)
                            	 11342:     even
                            	 11343: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E7A4 101D            	 11344:     move.b  (A5)+,D0  ; PLA
02:0003E7A6 7400            	 11345:     moveq   #0,D2
02:0003E7A8 1400            	 11346:     move.b  D0,D2
                            	 11347:     ; Hide the original head's sprite, and the base segment's sprite.
