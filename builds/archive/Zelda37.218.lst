                            	  3407: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3408:     ; Begin with the leever's Y set to Link's Y.
                            	  3409:     ;
02:0003ADB0 102C0084        	  3410:     move.b  ($0084,A4),D0
02:0003ADB4 41EC0084        	  3411:     lea     ($0084,A4),A0
02:0003ADB8 11802000        	  3412:     move.b  D0,(A0,D2.W)
                            	  3413:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3414:     ; it's too close to the top edge of the screen. So, return.
                            	  3415:     ;
02:0003ADBC 0C00005D        	  3416:     cmpi.b  #$5D,D0
