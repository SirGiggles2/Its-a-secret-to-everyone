                            	  9897: Manhandla_Move:
                            	  9898:     ; Implement a way of manifesting the fractional part of the speed
                            	  9899:     ; in the movement.
                            	  9900:     ;
                            	  9901:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9902:     ; byte to add to the coordinates, then the effective speed would
                            	  9903:     ; be 1 pixel a frame instead of 1.25.
                            	  9904:     ;
                            	  9905:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9906:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9907:     ;
                            	  9908:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9909:     ;
                            	  9910:     ;   SA := SA + (SL AND $E0)
                            	  9911:     ;   [03] := SH + carry
                            	  9912:     ;
                            	  9913:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9914:     ;
02:0003DCC4 41EC041F        	  9915:     lea     ($041F,A4),A0
02:0003DCC8 10302000        	  9916:     move.b  (A0,D2.W),D0
02:0003DCCC 020000E0        	  9917:     andi.b #$E0,D0
02:0003DCD0 023C00EE        	  9918:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCD4 41EC0412        	  9919:     lea     ($0412,A4),A0
02:0003DCD8 12302000        	  9920:     move.b  (A0,D2.W),D1
02:0003DCDC D101            	  9921:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DCDE 41EC0412        	  9922:     lea     ($0412,A4),A0
02:0003DCE2 11802000        	  9923:     move.b  D0,(A0,D2.W)
                            	  9924:     ; Assign (high speed byte + carry) to [03].
                            	  9925:     ;
02:0003DCE6 41EC042C        	  9926:     lea     ($042C,A4),A0
02:0003DCEA 10302000        	  9927:     move.b  (A0,D2.W),D0
02:0003DCEE 123C0000        	  9928:     move.b  #$00,D1
02:0003DCF2 D101            	  9929:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCF4 19400003        	  9930:     move.b  D0,($0003,A4)
                            	  9931:     ; Change coordinates by the speed amount/offset in [03]
                            	  9932:     ; according to the direction.
                            	  9933:     ;
                            	  9934:     ; Start with a mask of $A1 in [02]:
                            	  9935:     ; - low nibble represents the right direction
                            	  9936:     ; - high nibble is used to set or clear carry as we go along
                            	  9937:     ;
02:0003DCF8 103C00A1        	  9938:     move.b  #$A1,D0
02:0003DCFC 19400002        	  9939:     move.b  D0,($0002,A4)
                            	  9940:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9941:     ;
02:0003DD00 41EC0098        	  9942:     lea     ($0098,A4),A0
02:0003DD04 10302000        	  9943:     move.b  (A0,D2.W),D0
02:0003DD08 122C0002        	  9944:     move.b  ($0002,A4),D1
02:0003DD0C C200            	  9945:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD0E 6712            	  9946:     beq  _L_z04_Manhandla_Move_Left
02:0003DD10 10342070        	  9947:     move.b  ($70,A4,D2.W),D0
02:0003DD14 023C00EE        	  9948:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD18 122C0003        	  9949:     move.b  ($0003,A4),D1
02:0003DD1C D101            	  9950:     addx.b  D1,D0   ; ADC $03
02:0003DD1E 19802070        	  9951:     move.b  D0,($70,A4,D2.W)
                            	  9952:     even
                            	  9953: _L_z04_Manhandla_Move_Left:
                            	  9954:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9955:     ;
02:0003DD22 41EC0098        	  9956:     lea     ($0098,A4),A0
02:0003DD26 10302000        	  9957:     move.b  (A0,D2.W),D0
02:0003DD2A 122C0002        	  9958:     move.b  ($0002,A4),D1
02:0003DD2E E309            	  9959:     lsl.b  #1,D1   ; ASL $02
02:0003DD30 19410002        	  9960:     move.b  D1,($0002,A4)
02:0003DD34 122C0002        	  9961:     move.b  ($0002,A4),D1
02:0003DD38 C200            	  9962:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD3A 6716            	  9963:     beq  _L_z04_Manhandla_Move_Down
02:0003DD3C 10342070        	  9964:     move.b  ($70,A4,D2.W),D0
02:0003DD40 122C0003        	  9965:     move.b  ($0003,A4),D1
02:0003DD44 0A3C0010        	  9966:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD48 9101            	  9967:     subx.b  D1,D0   ; SBC $03
02:0003DD4A 0A3C0010        	  9968:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD4E 19802070        	  9969:     move.b  D0,($70,A4,D2.W)
                            	  9970:     even
                            	  9971: _L_z04_Manhandla_Move_Down:
                            	  9972:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9973:     ;
02:0003DD52 41EC0098        	  9974:     lea     ($0098,A4),A0
02:0003DD56 10302000        	  9975:     move.b  (A0,D2.W),D0
02:0003DD5A 122C0002        	  9976:     move.b  ($0002,A4),D1
02:0003DD5E E309            	  9977:     lsl.b  #1,D1   ; ASL $02
02:0003DD60 19410002        	  9978:     move.b  D1,($0002,A4)
02:0003DD64 122C0002        	  9979:     move.b  ($0002,A4),D1
02:0003DD68 C200            	  9980:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD6A 6716            	  9981:     beq  _L_z04_Manhandla_Move_Up
02:0003DD6C 41EC0084        	  9982:     lea     ($0084,A4),A0
02:0003DD70 10302000        	  9983:     move.b  (A0,D2.W),D0
02:0003DD74 122C0003        	  9984:     move.b  ($0003,A4),D1
02:0003DD78 D101            	  9985:     addx.b  D1,D0   ; ADC $03
02:0003DD7A 41EC0084        	  9986:     lea     ($0084,A4),A0
02:0003DD7E 11802000        	  9987:     move.b  D0,(A0,D2.W)
                            	  9988:     even
                            	  9989: _L_z04_Manhandla_Move_Up:
                            	  9990:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9991:     ;
02:0003DD82 41EC0098        	  9992:     lea     ($0098,A4),A0
02:0003DD86 10302000        	  9993:     move.b  (A0,D2.W),D0
02:0003DD8A 122C0002        	  9994:     move.b  ($0002,A4),D1
02:0003DD8E E309            	  9995:     lsl.b  #1,D1   ; ASL $02
02:0003DD90 19410002        	  9996:     move.b  D1,($0002,A4)
02:0003DD94 122C0002        	  9997:     move.b  ($0002,A4),D1
02:0003DD98 C200            	  9998:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD9A 671E            	  9999:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD9C 41EC0084        	 10000:     lea     ($0084,A4),A0
02:0003DDA0 10302000        	 10001:     move.b  (A0,D2.W),D0
02:0003DDA4 122C0003        	 10002:     move.b  ($0003,A4),D1
02:0003DDA8 0A3C0010        	 10003:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DDAC 9101            	 10004:     subx.b  D1,D0   ; SBC $03
02:0003DDAE 0A3C0010        	 10005:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DDB2 41EC0084        	 10006:     lea     ($0084,A4),A0
02:0003DDB6 11802000        	 10007:     move.b  D0,(A0,D2.W)
                            	 10008:     even
                            	 10009: _L_z04_Manhandla_Move_IncFrameAccum:
                            	 10010:     ; To the frame accumulator, add:
                            	 10011:     ; - a random value between 0 and 3
                            	 10012:     ; - [03] the effective high speed byte calculated for this screen frame
                            	 10013:     ;
02:0003DDBA 10342019        	 10014:     move.b  ($19,A4,D2.W),D0
02:0003DDBE 02000003        	 10015:     andi.b #$03,D0
02:0003DDC2 023C00EE        	 10016:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDC6 122C0003        	 10017:     move.b  ($0003,A4),D1
02:0003DDCA D101            	 10018:     addx.b  D1,D0   ; ADC $03
02:0003DDCC 41EC0451        	 10019:     lea     ($0451,A4),A0
02:0003DDD0 12302000        	 10020:     move.b  (A0,D2.W),D1
02:0003DDD4 D101            	 10021:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DDD6 41EC0451        	 10022:     lea     ($0451,A4),A0
02:0003DDDA 11802000        	 10023:     move.b  D0,(A0,D2.W)
02:0003DDDE 61001F6E        	 10024:     jsr     BoundFlyer
