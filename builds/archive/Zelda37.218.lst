02:0003F2AE 7000            	 12861:     moveq   #0,D0
02:0003F2B0 41EC046B        	 12862:     lea     ($046B,A4),A0
02:0003F2B4 11802000        	 12863:     move.b  D0,(A0,D2.W)
02:0003F2B8 60000352        	 12864:     jmp     Ganon_DrawBody
