02:0003B020 4EB90003197E    	  3736:     jsr     CheckMonsterCollisions
                            	  3737:     ; If the monster is still alive, then return.
                            	  3738:     ;
02:0003B026 41EC0405        	  3739:     lea     ($0405,A4),A0
02:0003B02A 10302000        	  3740:     move.b  (A0,D2.W),D0
02:0003B02E 671E            	  3741:     beq  _L_z04_UpdateGhini_Exit
                            	  3742:     ; For each object slot from $B to 1:
                            	  3743:     ; If the object is a flying ghini ($22),
                            	  3744:     ; then kill it by setting metastate to $11.
                            	  3745:     ;
02:0003B030 760B            	  3746:     moveq   #11,D3
                            	  3747:     even
                            	  3748: _L_z04_UpdateGhini_LoopObject:
02:0003B032 41EC034F        	  3749:     lea     ($034F,A4),A0
02:0003B036 10303000        	  3750:     move.b  (A0,D3.W),D0
02:0003B03A 0C000022        	  3751:     cmpi.b  #$22,D0
02:0003B03E 660A            	  3752:     bne  _anon_z04_50
02:0003B040 7011            	  3753:     moveq   #17,D0
02:0003B042 41EC0405        	  3754:     lea     ($0405,A4),A0
02:0003B046 11803000        	  3755:     move.b  D0,(A0,D3.W)
                            	  3756: _anon_z04_50:
02:0003B04A 5303            	  3757:     subq.b  #1,D3
