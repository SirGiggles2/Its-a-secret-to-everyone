                            	  3255: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3256:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3257:     ; the mound frame images:
                            	  3258:     ;
                            	  3259:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3260:     ;
                            	  3261:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3262:     ;
                            	  3263:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3264:     ;
02:0003AC98 003C0011        	  3265:     ori     #$11,CCR  ; SEC: set C+X
