02:0003A9C8 10302000        	  2898:     move.b  (A0,D2.W),D0
02:0003A9CC 02000002        	  2899:     andi.b #$02,D0
02:0003A9D0 6602            	  2900:     bne  _anon_z04_38
02:0003A9D2 7601            	  2901:     moveq   #1,D3
                            	  2902: _anon_z04_38:
