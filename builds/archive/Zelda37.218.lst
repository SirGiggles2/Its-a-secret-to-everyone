02:0003D13C 10302000        	  8339:     move.b  (A0,D2.W),D0
02:0003D140 4EB9000315FE    	  8340:     jsr     DrawObjectMirrored
                            	  8341:     ; Check collisions. If Link was not captured, then return.
                            	  8342:     ;
02:0003D146 4EB90003197E    	  8343:     jsr     CheckMonsterCollisions
02:0003D14C 41EC042C        	  8344:     lea     ($042C,A4),A0
