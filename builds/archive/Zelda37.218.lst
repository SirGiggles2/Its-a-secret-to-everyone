                            	  3796: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3797:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3798:     ; If > $10, go put the ladder away.
                            	  3799:     ;
02:00042014 4EB900030A3C    	  3800:     jsr     Abs
02:0004201A 1880            	  3801:     move.b  D0,($0000,A4)
02:0004201C 0C000010        	  3802:     cmpi.b  #$10,D0
02:00042020 6532            	  3803:     bcs  _L_z05_CheckLadder_SetState2
02:00042022 0C000010        	  3804:     cmpi.b  #$10,D0
02:00042026 661E            	  3805:     bne  _L_z05_CheckLadder_StashLadder
                            	  3806:     ; Distance = $10. If player's not facing in the same direction as
                            	  3807:     ; the ladder, go put away the ladder.
                            	  3808:     ;
02:00042028 102C0098        	  3809:     move.b  ($0098,A4),D0
02:0004202C 41EC0098        	  3810:     lea     ($0098,A4),A0
02:00042030 12302000        	  3811:     move.b  (A0,D2.W),D1
02:00042034 B001            	  3812:     cmp.b   D1,D0
02:00042036 660E            	  3813:     bne  _L_z05_CheckLadder_StashLadder
                            	  3814:     ; Distance = $10, and player's facing in the same direction.
                            	  3815:     ;
                            	  3816:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3817:     ; ladder and had not stepped onto it yet.
                            	  3818:     ; Go handle movement on it, but don't change state yet.
                            	  3819:     ;
                            	  3820:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3821:     ; off of the ladder. So the ladder should be put away. In this
                            	  3822:     ; case, fall thru.
                            	  3823:     ;
02:00042038 41EC00AC        	  3824:     lea     ($00AC,A4),A0
02:0004203C 10302000        	  3825:     move.b  (A0,D2.W),D0
02:00042040 0C000001        	  3826:     cmpi.b  #$01,D0
02:00042044 6718            	  3827:     beq  _L_z05_CheckLadder_HandleInput
                            	  3828:     even
                            	  3829: _L_z05_CheckLadder_StashLadder:
                            	  3830:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3831:     ;
02:00042046 7000            	  3832:     moveq   #0,D0
02:00042048 19400064        	  3833:     move.b  D0,($0064,A4)
02:0004204C 4EB90004DB28    	  3834:     jsr     DestroyMonster
                            	  3835:     even
