                            	  7937: _anon_z05_156:
02:00044D1E 101D            	  7938:     move.b  (A5)+,D0  ; PLA
                            	  7939:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7940:     ; then the player walked all the way to the edge of the play
                            	  7941:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7942:     ;
                            	  7943:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7944:     ; edge of the play area. So, set a relative position that
                            	  7945:     ; reflects that distance: $28 or -$28.
                            	  7946:     ;
                            	  7947:     ; If walking in a decreasing direction (left or up), then
                            	  7948:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7949:     ;
                            	  7950:     ; If walking in an increasing direction (right or down), then
                            	  7951:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7952:     ;
02:00044D20 02000007        	  7953:     andi.b #$07,D0
02:00044D24 0C000002        	  7954:     cmpi.b  #$02,D0
02:00044D28 6506            	  7955:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00044D2A 0C000005        	  7956:     cmpi.b  #$05,D0
