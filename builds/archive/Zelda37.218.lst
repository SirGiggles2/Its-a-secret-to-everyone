02:0004CAA4 666A            	  5940:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5941:     ; The boomerang has reached the thrower.
                            	  5942:     ;
                            	  5943:     ; Reset the distance to move.
                            	  5944:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5945:     ;
02:0004CAA6 7000            	  5946:     moveq   #0,D0
02:0004CAA8 41EC0380        	  5947:     lea     ($0380,A4),A0
02:0004CAAC 11802000        	  5948:     move.b  D0,(A0,D2.W)
02:0004CAB0 0C02000D        	  5949:     cmpi.b  #$0D,D2
02:0004CAB4 6524            	  5950:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5951:     ; Link has caught the boomerang.
                            	  5952:     ;
                            	  5953:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5954:     ;
                            	  5955:     ; If Link catches it some time after throwing it,
                            	  5956:     ; his state will become $20, and he will show the catch animation.
                            	  5957:     ;
                            	  5958:     ; But if he catches it right after throwing it, the state becomes
                            	  5959:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5960:     ;
02:0004CAB6 102C00AC        	  5961:     move.b  ($00AC,A4),D0
02:0004CABA 00000020        	  5962:     ori.b #$20,D0
02:0004CABE 194000AC        	  5963:     move.b  D0,($00AC,A4)
                            	  5964:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5965:     ; up the new state.
                            	  5966:     ;
02:0004CAC2 7001            	  5967:     moveq   #1,D0
02:0004CAC4 194003D0        	  5968:     move.b  D0,($03D0,A4)
                            	  5969:     ; Deactivate the boomerang.
                            	  5970:     ;
02:0004CAC8 760F            	  5971:     moveq   #15,D3
02:0004CACA 7000            	  5972:     moveq   #0,D0
02:0004CACC 41EC00AC        	  5973:     lea     ($00AC,A4),A0
02:0004CAD0 11803000        	  5974:     move.b  D0,(A0,D3.W)
02:0004CAD4 0A3C0001        	  5975:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004CAD8 4E75            	  5976:     rts
                            	  5977: 
                            	  5978:     even
