                            	  4436:     ; UNKNOWN:
                            	  4437:     ; This seems to be unused code triggered by object attribute $10.
                            	  4438:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4439:     ;
02:0004C0A0 6100016C        	  4440:     jsr     ReverseObjDir
02:0004C0A4 60000104        	  4441:     jmp     CheckBoundary
                            	  4442: 
