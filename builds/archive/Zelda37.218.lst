02:0003F134 0A3C0010        	 12645:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F138 9101            	 12646:     subx.b  D1,D0   ; SBC $00
02:0003F13A 0A3C0010        	 12647:     eori    #$10,CCR  ; restore X = 6502 C
