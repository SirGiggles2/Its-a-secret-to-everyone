                            	   319: _anon_z05_2:
                            	   320:     ; Move position markers and advance nametable scrolling;
                            	   321:     ; so that we scroll down 3 pixels.
                            	   322:     ;
02:0004026E 7003            	   323:     moveq   #3,D0
02:00040270 6100015C        	   324:     jsr     MovePositionMarkers
02:00040274 102C00FC        	   325:     move.b  ($00FC,A4),D0
02:00040278 003C0011        	   326:     ori     #$11,CCR  ; SEC: set C+X
02:0004027C 123C0003        	   327:     move.b  #$03,D1
02:00040280 0A3C0010        	   328:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040284 9101            	   329:     subx.b  D1,D0   ; SBC #$03
02:00040286 0A3C0010        	   330:     eori    #$10,CCR  ; restore X = 6502 C
