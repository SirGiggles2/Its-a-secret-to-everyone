02:0003E062 003C0011        	 10371:     ori     #$11,CCR  ; SEC: set C+X
02:0003E066 123C0032        	 10372:     move.b  #$32,D1
02:0003E06A 0A3C0010        	 10373:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E06E 9101            	 10374:     subx.b  D1,D0   ; SBC #$32
02:0003E070 0A3C0010        	 10375:     eori    #$10,CCR  ; restore X = 6502 C
