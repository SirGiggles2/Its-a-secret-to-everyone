02:0003F4F8 6100FF62        	 13184:     jsr     Ganon_DrawCloud
02:0003F4FC 61000090        	 13185:     jsr     Ganon_GetCurCloudRight
02:0003F500 6100FF5A        	 13186:     jsr     Ganon_DrawCloud
                            	 13187:     ; Save the object index.
