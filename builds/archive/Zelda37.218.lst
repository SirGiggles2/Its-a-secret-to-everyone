                            	 12561: __far_z_04_0125:
                            	 12562:     ; State = 0.
                            	 12563:     ;
                            	 12564:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12565:     ; This is the only patra child shown in the first fame.
                            	 12566:     ;
02:0003F0AC 0C020002        	 12567:     cmpi.b  #$02,D2
02:0003F0B0 6732            	 12568:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12569:     ; The patra child in slot 2 is the last one to be updated.
                            	 12570:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12571:     ;
                            	 12572:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12573:     ; shown.
                            	 12574:     ;
02:0003F0B2 102C00AE        	 12575:     move.b  ($00AE,A4),D0
02:0003F0B6 6700008E        	 12576:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12577:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12578:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12579:     ;
02:0003F0BA 1002            	 12580:     move.b  D2,D0
                            	 12581:     ; Subtract 3 from the object slot to get the angle where the
                            	 12582:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12583:     ;
02:0003F0BC 003C0011        	 12584:     ori     #$11,CCR  ; SEC: set C+X
02:0003F0C0 123C0003        	 12585:     move.b  #$03,D1
02:0003F0C4 0A3C0010        	 12586:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0C8 9101            	 12587:     subx.b  D1,D0   ; SBC #$03
02:0003F0CA 0A3C0010        	 12588:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0CE 7600            	 12589:     moveq   #0,D3
02:0003F0D0 1600            	 12590:     move.b  D0,D3
                            	 12591:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12592:     ; then return.
                            	 12593:     ;
02:0003F0D2 102C0396        	 12594:     move.b  ($0396,A4),D0
02:0003F0D6 41F90003F090    	 12595:     lea     (PatraChildStartAngles).l,A0
02:0003F0DC 12303000        	 12596:     move.b  (A0,D3.W),D1
02:0003F0E0 B001            	 12597:     cmp.b   D1,D0
02:0003F0E2 6662            	 12598:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12599:     even
