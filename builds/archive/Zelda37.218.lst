02:0003B5F1 00
02:0003B5F2 01
                            	  4632: 
                            	  4633: ; Returns:
                            	  4634: ; C: 1 if there is a mismatch between current quest
                            	  4635: ;    and quest number for the secret in the room
                            	  4636: ;
                            	  4637: ;
                            	  4638: ; The quest secret is in the high two bits.
                            	  4639: ;
                            	  4640:     even
                            	  4641: IsQuestSecretMismatch:
02:0003B5F4 102C04CD        	  4642:     move.b  ($04CD,A4),D0
02:0003B5F8 E208            	  4643:     lsr.b  #1,D0   ; LSR A
02:0003B5FA E208            	  4644:     lsr.b  #1,D0   ; LSR A
02:0003B5FC E208            	  4645:     lsr.b  #1,D0   ; LSR A
02:0003B5FE E208            	  4646:     lsr.b  #1,D0   ; LSR A
02:0003B600 E208            	  4647:     lsr.b  #1,D0   ; LSR A
02:0003B602 E208            	  4648:     lsr.b  #1,D0   ; LSR A
                            	  4649:     ; If it's 0, then return C=0.
                            	  4650:     ;
02:0003B604 6726            	  4651:     beq  _L_z04_IsQuestSecretMismatch_ReturnFalse
                            	  4652:     ; Look up a quest number (0 or 1) indexed by quest secret (0 or 1).
                            	  4653:     ;
02:0003B606 7600            	  4654:     moveq   #0,D3
02:0003B608 1600            	  4655:     move.b  D0,D3
02:0003B60A 41F90003B5F0    	  4656:     lea     (SecretQuestNumbers).l,A0
02:0003B610 10303000        	  4657:     move.b  (A0,D3.W),D0
                            	  4658:     ; If the save slot's quest number matches the room's
                            	  4659:     ; secret quest number, then return C=0.
                            	  4660:     ;
02:0003B614 7600            	  4661:     moveq   #0,D3
02:0003B616 162C0016        	  4662:     move.b  ($0016,A4),D3
02:0003B61A 41EC062D        	  4663:     lea     ($062D,A4),A0
02:0003B61E 12303000        	  4664:     move.b  (A0,D3.W),D1
02:0003B622 B001            	  4665:     cmp.b   D1,D0
02:0003B624 6706            	  4666:     beq  _L_z04_IsQuestSecretMismatch_ReturnFalse
                            	  4667:     ; Else return C=1. There is a mismatch in quest numbers.
                            	  4668:     ;
02:0003B626 003C0011        	  4669:     ori     #$11,CCR  ; SEC: set C+X
02:0003B62A 4E75            	  4670:     rts
