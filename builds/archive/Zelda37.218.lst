02:00031BA2 12302000        	  6802:     move.b  (A0,D2.W),D1
02:00031BA6 8001            	  6803:     or.b  D1,D0
02:00031BA8 0200000C        	  6804:     andi.b #$0C,D0
02:00031BAC 0C00000C        	  6805:     cmpi.b  #$0C,D0
02:00031BB0 671A            	  6806:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031BB2 102C0098        	  6807:     move.b  ($0098,A4),D0
02:00031BB6 41EC0098        	  6808:     lea     ($0098,A4),A0
02:00031BBA 12302000        	  6809:     move.b  (A0,D2.W),D1
02:00031BBE 8001            	  6810:     or.b  D1,D0
02:00031BC0 02000003        	  6811:     andi.b #$03,D0
02:00031BC4 0C000003        	  6812:     cmpi.b  #$03,D0
