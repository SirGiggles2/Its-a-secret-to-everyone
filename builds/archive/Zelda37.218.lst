                            	  7468: Dodongo_TryEatBomb:
                            	  7469:     ; Try to eat the bomb.
                            	  7470:     ;
                            	  7471:     ; If the bomb is not in range of the monster, then return.
                            	  7472:     ;
                            	  7473:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7474:     ;
02:0003CB06 7601            	  7475:     moveq   #1,D3
02:0003CB08 616E            	  7476:     jsr     Dodongo_IsBombInRange
02:0003CB0A 6666            	  7477:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7478:     ; Will loop from 1 to 0, indexed by [00].
                            	  7479:     ;
02:0003CB0C 7001            	  7480:     moveq   #1,D0
02:0003CB0E 1880            	  7481:     move.b  D0,($0000,A4)
                            	  7482:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7483:     ;
02:0003CB10 41EC0098        	  7484:     lea     ($0098,A4),A0
02:0003CB14 10302000        	  7485:     move.b  (A0,D2.W),D0
02:0003CB18 E208            	  7486:     lsr.b  #1,D0   ; LSR A
02:0003CB1A 7600            	  7487:     moveq   #0,D3
02:0003CB1C 1600            	  7488:     move.b  D0,D3
                            	  7489:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7490:     ; position depends on the orientation of the monster.
                            	  7491:     ;
                            	  7492:     ; Start with the horizontal distance.
                            	  7493:     ;
02:0003CB1E 102C0004        	  7494:     move.b  ($0004,A4),D0
                            	  7495:     even
                            	  7496: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7497:     ; Look up the limits for the given direction.
                            	  7498:     ;
                            	  7499:     ; If the distance from the bomb < negative limit,
                            	  7500:     ; or >= positive limit, then return.
                            	  7501:     ;
                            	  7502:     ; Note that these are simple signed comparisons that work,
                            	  7503:     ; because the operands are in a small range.
                            	  7504:     ;
02:0003CB22 41F90003CA5C    	  7505:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB28 12303000        	  7506:     move.b  (A0,D3.W),D1
02:0003CB2C B001            	  7507:     cmp.b   D1,D0
02:0003CB2E 6B42            	  7508:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB30 41F90003CA62    	  7509:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB36 12303000        	  7510:     move.b  (A0,D3.W),D1
02:0003CB3A B001            	  7511:     cmp.b   D1,D0
02:0003CB3C 6A34            	  7512:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7513:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7514:     ;
02:0003CB3E 1003            	  7515:     move.b  D3,D0
02:0003CB40 023C00EE        	  7516:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB44 123C000A        	  7517:     move.b  #$0A,D1
02:0003CB48 D101            	  7518:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB4A 7600            	  7519:     moveq   #0,D3
02:0003CB4C 1600            	  7520:     move.b  D0,D3
                            	  7521:     ; Bottom of the loop.
                            	  7522:     ;
                            	  7523:     ; Load the vertical distance for the next iteration.
                            	  7524:     ; Decrement loop counter.
                            	  7525:     ;
02:0003CB4E 102C0005        	  7526:     move.b  ($0005,A4),D0
02:0003CB52 5314            	  7527:     subq.b  #1,($0000,A4)
02:0003CB54 6ACC            	  7528:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7529:     ; If we get here, then the bomb was within range of the mouth.
                            	  7530:     ; Go to state 1 (bloated).
                            	  7531:     ;
02:0003CB56 41EC00AC        	  7532:     lea     ($00AC,A4),A0
02:0003CB5A 52302000        	  7533:     addq.b  #1,(A0,D2.W)
                            	  7534:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7535:     ;
02:0003CB5E 7610            	  7536:     moveq   #16,D3
02:0003CB60 7000            	  7537:     moveq   #0,D0
02:0003CB62 41EC00AC        	  7538:     lea     ($00AC,A4),A0
02:0003CB66 11803000        	  7539:     move.b  D0,(A0,D3.W)
02:0003CB6A 41EC042C        	  7540:     lea     ($042C,A4),A0
02:0003CB6E 11802000        	  7541:     move.b  D0,(A0,D2.W)
                            	  7542:     even
