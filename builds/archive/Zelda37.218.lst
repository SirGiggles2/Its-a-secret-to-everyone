02:0003E7AA 102C04D7        	 11349:     move.b  ($04D7,A4),D0
02:0003E7AE E308            	 11350:     lsl.b  #1,D0   ; ASL A
02:0003E7B0 E308            	 11351:     lsl.b  #1,D0   ; ASL A
02:0003E7B2 E308            	 11352:     lsl.b  #1,D0   ; ASL A
02:0003E7B4 7600            	 11353:     moveq   #0,D3
02:0003E7B6 1600            	 11354:     move.b  D0,D3
02:0003E7B8 103C00F8        	 11355:     move.b  #$F8,D0
02:0003E7BC 41EC0200        	 11356:     lea     ($0200,A4),A0
02:0003E7C0 11803000        	 11357:     move.b  D0,(A0,D3.W)
02:0003E7C4 41EC0220        	 11358:     lea     ($0220,A4),A0
02:0003E7C8 11803000        	 11359:     move.b  D0,(A0,D3.W)
                            	 11360:     ; Add the bit for this neck to the dead neck mask.
