                            	  8118: UpdatePolsVoiceState1_Jumping:
                            	  8119:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8120:     ;
02:0003CF60 41EC0444        	  8121:     lea     ($0444,A4),A0
02:0003CF64 10302000        	  8122:     move.b  (A0,D2.W),D0
02:0003CF68 023C00EE        	  8123:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF6C 123C0038        	  8124:     move.b  #$38,D1
02:0003CF70 D101            	  8125:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CF72 41EC0444        	  8126:     lea     ($0444,A4),A0
02:0003CF76 11802000        	  8127:     move.b  D0,(A0,D2.W)
                            	  8128:     ; Add Carry to high speed byte (vertical).
                            	  8129:     ;
02:0003CF7A 41EC0412        	  8130:     lea     ($0412,A4),A0
02:0003CF7E 10302000        	  8131:     move.b  (A0,D2.W),D0
02:0003CF82 123C0000        	  8132:     move.b  #$00,D1
02:0003CF86 D101            	  8133:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CF88 41EC0412        	  8134:     lea     ($0412,A4),A0
02:0003CF8C 11802000        	  8135:     move.b  D0,(A0,D2.W)
                            	  8136:     ; Add high speed byte to Y coordinate.
                            	  8137:     ;
02:0003CF90 023C00EE        	  8138:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF94 41EC0084        	  8139:     lea     ($0084,A4),A0
02:0003CF98 12302000        	  8140:     move.b  (A0,D2.W),D1
02:0003CF9C D101            	  8141:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CF9E 41EC0084        	  8142:     lea     ($0084,A4),A0
02:0003CFA2 11802000        	  8143:     move.b  D0,(A0,D2.W)
                            	  8144:     ; If the speed is still negative, then return.
                            	  8145:     ;
02:0003CFA6 41EC0412        	  8146:     lea     ($0412,A4),A0
02:0003CFAA 10302000        	  8147:     move.b  (A0,D2.W),D0
02:0003CFAE 6B0000AC        	  8148:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8149:     ; If Y coordinate still < target Y, then return.
                            	  8150:     ;
02:0003CFB2 41EC0084        	  8151:     lea     ($0084,A4),A0
02:0003CFB6 10302000        	  8152:     move.b  (A0,D2.W),D0
02:0003CFBA 41EC042C        	  8153:     lea     ($042C,A4),A0
02:0003CFBE 12302000        	  8154:     move.b  (A0,D2.W),D1
02:0003CFC2 B001            	  8155:     cmp.b   D1,D0
02:0003CFC4 65000096        	  8156:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8157:     ; Else reached the destination. Go to state 0.
                            	  8158:     ;
02:0003CFC8 7000            	  8159:     moveq   #0,D0
02:0003CFCA 41EC00AC        	  8160:     lea     ($00AC,A4),A0
02:0003CFCE 11802000        	  8161:     move.b  D0,(A0,D2.W)
                            	  8162:     ; Reset 16-bit vertical speed.
                            	  8163:     ;
02:0003CFD2 41EC0444        	  8164:     lea     ($0444,A4),A0
02:0003CFD6 11802000        	  8165:     move.b  D0,(A0,D2.W)
02:0003CFDA 41EC0412        	  8166:     lea     ($0412,A4),A0
02:0003CFDE 11802000        	  8167:     move.b  D0,(A0,D2.W)
                            	  8168:     ; Choose a random direction to face in.
                            	  8169:     ;
02:0003CFE2 10342018        	  8170:     move.b  ($18,A4,D2.W),D0
02:0003CFE6 02000003        	  8171:     andi.b #$03,D0
02:0003CFEA 7600            	  8172:     moveq   #0,D3
02:0003CFEC 1600            	  8173:     move.b  D0,D3
02:0003CFEE 41F90003CDFE    	  8174:     lea     (PolsVoiceDirections).l,A0
02:0003CFF4 10303000        	  8175:     move.b  (A0,D3.W),D0
02:0003CFF8 41EC0098        	  8176:     lea     ($0098,A4),A0
02:0003CFFC 11802000        	  8177:     move.b  D0,(A0,D2.W)
                            	  8178:     ; Randomly set distance-to-move to $30 or $70.
                            	  8179:     ;
02:0003D000 10342018        	  8180:     move.b  ($18,A4,D2.W),D0
02:0003D004 02000040        	  8181:     andi.b #$40,D0
02:0003D008 123C0030        	  8182:     move.b  #$30,D1
02:0003D00C D101            	  8183:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D00E 41EC0394        	  8184:     lea     ($0394,A4),A0
02:0003D012 11802000        	  8185:     move.b  D0,(A0,D2.W)
                            	  8186:     ; Align the monster with a square horizontally.
                            	  8187:     ;
                            	  8188:     ; If in the left half of a square, align with that square.
                            	  8189:     ; If in the right half, align with the next square.
                            	  8190:     ;
02:0003D016 10342070        	  8191:     move.b  ($70,A4,D2.W),D0
02:0003D01A 023C00EE        	  8192:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D01E 123C0008        	  8193:     move.b  #$08,D1
02:0003D022 D101            	  8194:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
