02:00030D5A 6706            	  5009:     beq  _anon_z01_54
02:00030D5C 0C030011        	  5010:     cmpi.b  #$11,D3
02:00030D60 6604            	  5011:     bne  _L_z01_UpdateBombFlashEffect_Clear
