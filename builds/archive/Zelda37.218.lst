                            	  8021:     ;
02:0003CE94 41EC0098        	  8022:     lea     ($0098,A4),A0
02:0003CE98 10302000        	  8023:     move.b  (A0,D2.W),D0
02:0003CE9C 0A00000C        	  8024:     eori.b #$0C,D0
02:0003CEA0 41EC0098        	  8025:     lea     ($0098,A4),A0
02:0003CEA4 11802000        	  8026:     move.b  D0,(A0,D2.W)
02:0003CEA8 6000008C        	  8027:     jmp     L_PolsVoice_DrawAndCheckCollisions
