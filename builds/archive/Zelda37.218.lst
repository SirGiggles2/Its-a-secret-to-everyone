02:0004B23C 123C000A        	  2427:     move.b  #$0A,D1
02:0004B240 D101            	  2428:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0004B242 19400301        	  2429:     move.b  D0,($0301,A4)
02:0004B246 101D            	  2430:     move.b  (A5)+,D0  ; PLA
02:0004B248 7400            	  2431:     moveq   #0,D2
02:0004B24A 1400            	  2432:     move.b  D0,D2
02:0004B24C 7005            	  2433:     moveq   #5,D0
