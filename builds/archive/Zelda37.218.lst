                            	  3670: _L_z04_UpdateOctorock_SaveOffset:
02:0003AFB0 1B00            	  3671:     move.b  D0,-(A5)  ; PHA
                            	  3672:     ; Decrement the animation counter, and roll over if needed.
                            	  3673:     ;
02:0003AFB2 41EC03D0        	  3674:     lea     ($03D0,A4),A0
02:0003AFB6 53302000        	  3675:     subq.b  #1,(A0,D2.W)
02:0003AFBA 661E            	  3676:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003AFBC 7006            	  3677:     moveq   #6,D0
02:0003AFBE 41EC03D0        	  3678:     lea     ($03D0,A4),A0
02:0003AFC2 11802000        	  3679:     move.b  D0,(A0,D2.W)
                            	  3680:     ; There are actually 6 frame images divided into 2 sets.
                            	  3681:     ; Each set depicts one animation frame. In each set there are
                            	  3682:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3683:     ;
                            	  3684:     ; The movement frame will keep track of the base offset of
                            	  3685:     ; the current set for the current animation frame: 0 or 3.
                            	  3686:     ;
                            	  3687:     ; So, XOR the movement frame with 3.
                            	  3688:     ;
02:0003AFC6 E208            	  3689:     lsr.b  #1,D0   ; LSR A
02:0003AFC8 41EC03E4        	  3690:     lea     ($03E4,A4),A0
02:0003AFCC 12302000        	  3691:     move.b  (A0,D2.W),D1
02:0003AFD0 B300            	  3692:     eor.b  D1,D0
02:0003AFD2 41EC03E4        	  3693:     lea     ($03E4,A4),A0
02:0003AFD6 11802000        	  3694:     move.b  D0,(A0,D2.W)
                            	  3695:     even
                            	  3696: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3697:     ; Add the base offset and the directional offset, and save the result.
                            	  3698:     ;
02:0003AFDA 101D            	  3699:     move.b  (A5)+,D0  ; PLA
02:0003AFDC 023C00EE        	  3700:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFE0 41EC03E4        	  3701:     lea     ($03E4,A4),A0
02:0003AFE4 12302000        	  3702:     move.b  (A0,D2.W),D1
02:0003AFE8 D101            	  3703:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AFEA 1B00            	  3704:     move.b  D0,-(A5)  ; PHA
                            	  3705:     ; If facing vertically, go draw mirrored.
                            	  3706:     ;
02:0003AFEC 41EC0098        	  3707:     lea     ($0098,A4),A0
02:0003AFF0 10302000        	  3708:     move.b  (A0,D2.W),D0
02:0003AFF4 0200000C        	  3709:     andi.b #$0C,D0
02:0003AFF8 660E            	  3710:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3711:     ; Else draw not mirrored.
                            	  3712:     ;
02:0003AFFA 101D            	  3713:     move.b  (A5)+,D0  ; PLA
02:0003AFFC 4EB900031602    	  3714:     jsr     DrawObjectNotMirrored
02:0003B002 4EF90003197E    	  3715:     jmp     CheckMonsterCollisions
                            	  3716: 
                            	  3717:     even
                            	  3718: _L_z04_UpdateOctorock_DrawMirrored:
02:0003B008 101D            	  3719:     move.b  (A5)+,D0  ; PLA
                            	  3720: ; Params:
                            	  3721: ; A: frame image
                            	  3722: ; X: object index
                            	  3723: ; [00]: object X
                            	  3724: ; [01]: object Y
                            	  3725: ;
                            	  3726:     even
