02:0003A192 664E            	  1633:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A194 41EC04F0        	  1634:     lea     ($04F0,A4),A0
02:0003A198 10302000        	  1635:     move.b  (A0,D2.W),D0
02:0003A19C 6744            	  1636:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1637:     ; If vertically aligned with the square grid, then
                            	  1638:     ; use a horizontal direction mask (3).
                            	  1639:     ;
                            	  1640:     ; Keep in mind that most objects are aligned vertically when
                            	  1641:     ; the low nibble of their Y is $D.
                            	  1642:     ;
