                            	   216: _L_z01_InitCave_TakeType:
                            	   217:     ; Else the cave/person simply does:
                            	   218:     ; - taken:     no person, no text
                            	   219:     ; - not taken: show a person and text
                            	   220:     ;
                            	   221:     ; So, if the item was not taken, then go set up the text.
                            	   222:     ;
02:0002DC7E 610032B4        	   223:     jsr     GetRoomFlagUWItemState
02:0002DC82 6602            	   224:     bne.s  __far_z_01_0001
02:0002DC84 600A            	   225:     jmp  InitCaveContinue
