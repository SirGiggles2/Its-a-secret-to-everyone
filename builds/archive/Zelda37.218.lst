02:0003AF80 4EB90004D344    	  3642:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3643:     ; If facing down, then use frame image offset 2.
                            	  3644:     ;
02:0003AF86 41EC0098        	  3645:     lea     ($0098,A4),A0
02:0003AF8A 10302000        	  3646:     move.b  (A0,D2.W),D0
02:0003AF8E 7600            	  3647:     moveq   #0,D3
02:0003AF90 1600            	  3648:     move.b  D0,D3
02:0003AF92 0200000C        	  3649:     andi.b #$0C,D0
02:0003AF96 670C            	  3650:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AF98 7002            	  3651:     moveq   #2,D0
02:0003AF9A 0C030008        	  3652:     cmpi.b  #$08,D3
02:0003AF9E 6610            	  3653:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3654:     ; Else facing up. Use frame image offset 1.
