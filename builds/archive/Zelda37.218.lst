02:0003A1A8 0200000F        	  1646:     andi.b #$0F,D0
02:0003A1AC 0C00000D        	  1647:     cmpi.b  #$0D,D0
02:0003A1B0 6602            	  1648:     bne  _anon_z04_26
02:0003A1B2 7603            	  1649:     moveq   #3,D3
                            	  1650: _anon_z04_26:
02:0003A1B4 1883            	  1651:     move.b  D3,($0000,A4)
                            	  1652:     ; If horizontally aligned with the square grid, then
                            	  1653:     ; use a vertical direction mask ($C).
                            	  1654:     ;
02:0003A1B6 7600            	  1655:     moveq   #0,D3
02:0003A1B8 10342070        	  1656:     move.b  ($70,A4,D2.W),D0
02:0003A1BC 0200000F        	  1657:     andi.b #$0F,D0
02:0003A1C0 6602            	  1658:     bne  _anon_z04_27
02:0003A1C2 760C            	  1659:     moveq   #12,D3
                            	  1660: _anon_z04_27:
02:0003A1C4 1003            	  1661:     move.b  D3,D0
                            	  1662:     ; Combine the two masks. At most one will be 0.
                            	  1663:     ;
02:0003A1C6 1214            	  1664:     move.b  ($0000,A4),D1
02:0003A1C8 8001            	  1665:     or.b  D1,D0
                            	  1666:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1667:     ; with the grid.
                            	  1668:     ;
                            	  1669:     ; If so, then go to state 1 to do a "big shove".
                            	  1670:     ; Else go to state 2, to immediately split in two.
                            	  1671:     ;
                            	  1672:     ; Examples:
                            	  1673:     ; It would be aligned, if moving left along a tile as usual.
                            	  1674:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1675:     ; - The collision check routines would have made the zol
                            	  1676:     ;   face in the direction of the weapon.
                            	  1677:     ; - See CheckMonsterWeaponCollision.
                            	  1678:     ;
02:0003A1CA 122C0098        	  1679:     move.b  ($0098,A4),D1
02:0003A1CE C001            	  1680:     and.b  D1,D0
02:0003A1D0 6608            	  1681:     bne  _anon_z04_28
02:0003A1D2 41EC00AC        	  1682:     lea     ($00AC,A4),A0
02:0003A1D6 52302000        	  1683:     addq.b  #1,(A0,D2.W)
                            	  1684: _anon_z04_28:
