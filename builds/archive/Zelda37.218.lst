                            	  4328: ; To be considered within a doorway, one condition is that
                            	  4329: ; Link's perpendicular coordinate ([00]) has to match the doorway's
                            	  4330: ; (X=$78 for verticals, Y=$8D for horizontals).
                            	  4331: ;
