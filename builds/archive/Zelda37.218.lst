                            	  6098:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6099:     ;
02:0003C0E2 10342028        	  6100:     move.b  ($28,A4,D2.W),D0
02:0003C0E6 0C000010        	  6101:     cmpi.b  #$10,D0
02:0003C0EA 6702            	  6102:     beq.s  __far_z_04_0049
02:0003C0EC 6058            	  6103:     jmp  L1156B_Exit
