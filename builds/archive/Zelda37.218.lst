                            	  6843:     ;
02:00031BE8 7001            	  6844:     moveq   #1,D0
02:00031BEA 19400604        	  6845:     move.b  D0,($0604,A4)
02:00031BEE 7000            	  6846:     moveq   #0,D0
02:00031BF0 19400006        	  6847:     move.b  D0,($0006,A4)
