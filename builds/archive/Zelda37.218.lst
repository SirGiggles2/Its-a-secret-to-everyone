02:0003F516 0C020007        	 13206:     cmpi.b  #$07,D2
02:0003F51A 670A            	 13207:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F51C 102C0015        	 13208:     move.b  ($0015,A4),D0
02:0003F520 02000003        	 13209:     andi.b #$03,D0
02:0003F524 6704            	 13210:     beq  _anon_z04_164
                            	 13211:     even
