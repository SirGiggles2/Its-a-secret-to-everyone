                            	   235: InitCaveContinue:
                            	   236:     ; Get this cave's index (object type - $6A).
                            	   237:     ;
02:0002DC90 102C0350        	   238:     move.b  ($0350,A4),D0
02:0002DC94 003C0011        	   239:     ori     #$11,CCR  ; SEC: set C+X
02:0002DC98 123C006A        	   240:     move.b  #$6A,D1
02:0002DC9C 0A3C0010        	   241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DCA0 9101            	   242:     subx.b  D1,D0   ; SBC #$6A
02:0002DCA2 0A3C0010        	   243:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DCA6 7600            	   244:     moveq   #0,D3
02:0002DCA8 1600            	   245:     move.b  D0,D3
                            	   246:     ; Get the person text selector by looking up the text selector byte
                            	   247:     ; for this index, and masking it with $3F.
                            	   248:     ;
02:0002DCAA 41F90002DC28    	   249:     lea     (OverworldPersonTextSelectors).l,A0
02:0002DCB0 10303000        	   250:     move.b  (A0,D3.W),D0
02:0002DCB4 1B00            	   251:     move.b  D0,-(A5)  ; PHA
02:0002DCB6 0200003F        	   252:     andi.b #$3F,D0
02:0002DCBA 19400415        	   253:     move.b  D0,($0415,A4)
                            	   254:     ; Pop and mask the text selector byte with $C0 to get the
                            	   255:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   256:     ;
02:0002DCBE 101D            	   257:     move.b  (A5)+,D0  ; PLA
02:0002DCC0 020000C0        	   258:     andi.b #$C0,D0
02:0002DCC4 19400003        	   259:     move.b  D0,($0003,A4)
                            	   260:     ; At this point, the Y register still has the cave index.
                            	   261:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   262:     ;
02:0002DCC8 103C00FD        	   263:     move.b  #$FD,D0
                            	   264: _anon_z01_0:
02:0002DCCC 023C00EE        	   265:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DCD0 123C0003        	   266:     move.b  #$03,D1
02:0002DCD4 D101            	   267:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002DCD6 5303            	   268:     subq.b  #1,D3
02:0002DCD8 6AF2            	   269:     bpl  _anon_z01_0
02:0002DCDA 7600            	   270:     moveq   #0,D3
02:0002DCDC 1600            	   271:     move.b  D0,D3
                            	   272:     ; Loop over the wares from 0 to 2.
                            	   273:     ;
02:0002DCDE 7400            	   274:     moveq   #0,D2
                            	   275:     even
                            	   276: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   277:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   278:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   279:     ;
02:0002DCE0 41F900FF6A7E    	   280:     lea     (NES_SRAM+$0A7E).l,A0
02:0002DCE6 10303000        	   281:     move.b  (A0,D3.W),D0
02:0002DCEA 41EC0422        	   282:     lea     ($0422,A4),A0
02:0002DCEE 11802000        	   283:     move.b  D0,(A0,D2.W)
                            	   284:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   285:     ;
02:0002DCF2 020000C0        	   286:     andi.b #$C0,D0
02:0002DCF6 19802000        	   287:     move.b  D0,($00,A4,D2.W)
                            	   288:     ; Copy 3 prices from the Cave level block info.
                            	   289:     ;
02:0002DCFA 41F900FF6ABA    	   290:     lea     (NES_SRAM+$0ABA).l,A0
02:0002DD00 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002DD04 41EC0430        	   292:     lea     ($0430,A4),A0
02:0002DD08 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Bottom of the wares copying loop.
                            	   295:     ;
02:0002DD0C 5203            	   296:     addq.b  #1,D3
02:0002DD0E 5202            	   297:     addq.b  #1,D2
02:0002DD10 0C020003        	   298:     cmpi.b  #$03,D2
02:0002DD14 66CA            	   299:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   300:     ; Get the top 2 bits of text selector byte in [03],
                            	   301:     ; shift them to the bottom, and combine them with [00].
                            	   302:     ;
02:0002DD16 102C0003        	   303:     move.b  ($0003,A4),D0
02:0002DD1A E308            	   304:     lsl.b  #1,D0   ; ASL A
02:0002DD1C E310            	   305:     roxl.b  #1,D0   ; ROL A
02:0002DD1E E310            	   306:     roxl.b  #1,D0   ; ROL A
02:0002DD20 1214            	   307:     move.b  ($0000,A4),D1
02:0002DD22 8001            	   308:     or.b  D1,D0
02:0002DD24 1880            	   309:     move.b  D0,($0000,A4)
                            	   310:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   311:     ; and combine them with [00].
                            	   312:     ;
02:0002DD26 102C0002        	   313:     move.b  ($0002,A4),D0
02:0002DD2A E208            	   314:     lsr.b  #1,D0   ; LSR A
02:0002DD2C E208            	   315:     lsr.b  #1,D0   ; LSR A
02:0002DD2E E208            	   316:     lsr.b  #1,D0   ; LSR A
02:0002DD30 E208            	   317:     lsr.b  #1,D0   ; LSR A
02:0002DD32 1214            	   318:     move.b  ($0000,A4),D1
02:0002DD34 8001            	   319:     or.b  D1,D0
02:0002DD36 1880            	   320:     move.b  D0,($0000,A4)
                            	   321:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   322:     ; and combine them with [00] into CaveFlags.
                            	   323:     ;
02:0002DD38 102C0001        	   324:     move.b  ($0001,A4),D0
02:0002DD3C E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002DD3E E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002DD40 1214            	   327:     move.b  ($0000,A4),D1
02:0002DD42 8001            	   328:     or.b  D1,D0
02:0002DD44 19400413        	   329:     move.b  D0,($0413,A4)
                            	   330:     ; The end result is a byte with 8 cave flags.
                            	   331:     ;
                            	   332:     ; If cave flag "money game" is missing, then go finish up,
                            	   333:     ; instead of choosing random amounts for the money game.
                            	   334:     ;
02:0002DD48 02000020        	   335:     andi.b #$20,D0
02:0002DD4C 6700009E        	   336:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   337:     ; Determine an index randomly with increasing probability,
                            	   338:     ; from 6 to 1. Start with the following test:
                            	   339:     ;
                            	   340:     ;   If $FF < Random, then go use index 6.
                            	   341:     ;
02:0002DD50 103C00FF        	   342:     move.b  #$FF,D0
02:0002DD54 7606            	   343:     moveq   #6,D3
                            	   344:     even
                            	   345: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002DD56 122C0019        	   346:     move.b  ($0019,A4),D1
02:0002DD5A B001            	   347:     cmp.b   D1,D0
02:0002DD5C 6516            	   348:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   349:     ; If the test fails, then subtract $2B from the reference number.
                            	   350:     ;
02:0002DD5E 003C0011        	   351:     ori     #$11,CCR  ; SEC: set C+X
02:0002DD62 123C002B        	   352:     move.b  #$2B,D1
02:0002DD66 0A3C0010        	   353:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DD6A 9101            	   354:     subx.b  D1,D0   ; SBC #$2B
02:0002DD6C 0A3C0010        	   355:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DD70 5303            	   356:     subq.b  #1,D3
02:0002DD72 66E2            	   357:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   358:     even
                            	   359: _L_z01_InitCaveContinue_FoundPermutation:
                            	   360:     ; The index chooses the last offset of a permutation of three indexes.
                            	   361:     ;
02:0002DD74 7400            	   362:     moveq   #0,D2
02:0002DD76 41F90002DC50    	   363:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002DD7C 14303000        	   364:     move.b  (A0,D3.W),D2
                            	   365:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   366:     ;
02:0002DD80 7602            	   367:     moveq   #2,D3
                            	   368:     even
                            	   369: _L_z01_InitCaveContinue_CopyPermutation:
02:0002DD82 41F90002DC3E    	   370:     lea     (MoneyGamePermutations).l,A0
02:0002DD88 10302000        	   371:     move.b  (A0,D2.W),D0
02:0002DD8C 41EC046C        	   372:     lea     ($046C,A4),A0
02:0002DD90 11803000        	   373:     move.b  D0,(A0,D3.W)
02:0002DD94 5302            	   374:     subq.b  #1,D2
02:0002DD96 5303            	   375:     subq.b  #1,D3
02:0002DD98 6AE8            	   376:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   377:     ; With the first bit of another random number, choose 10 or 40
                            	   378:     ; to put in [046F]. This is a random amount to lose.
                            	   379:     ;
02:0002DD9A 102C001A        	   380:     move.b  ($001A,A4),D0
02:0002DD9E 02000001        	   381:     andi.b #$01,D0
02:0002DDA2 7600            	   382:     moveq   #0,D3
02:0002DDA4 1600            	   383:     move.b  D0,D3
02:0002DDA6 41F90002DC3C    	   384:     lea     (MoneyGameLossAmounts).l,A0
02:0002DDAC 10303000        	   385:     move.b  (A0,D3.W),D0
02:0002DDB0 1940046F        	   386:     move.b  D0,($046F,A4)
                            	   387:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   388:     ;
02:0002DDB4 700A            	   389:     moveq   #10,D0
02:0002DDB6 19400470        	   390:     move.b  D0,($0470,A4)
                            	   391:     ; With a different bit of the second random number,
                            	   392:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   393:     ;
02:0002DDBA 7614            	   394:     moveq   #20,D3
02:0002DDBC 102C001A        	   395:     move.b  ($001A,A4),D0
02:0002DDC0 02000002        	   396:     andi.b #$02,D0
02:0002DDC4 6702            	   397:     beq  _anon_z01_1
02:0002DDC6 7632            	   398:     moveq   #50,D3
                            	   399: _anon_z01_1:
02:0002DDC8 19430471        	   400:     move.b  D3,($0471,A4)
                            	   401:     ; The 3 amounts are now in [046F] to [0471].
                            	   402:     ; Reference these amounts using the permutation of indexes
                            	   403:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   404:     ;
02:0002DDCC 7402            	   405:     moveq   #2,D2
                            	   406:     even
