                            	  5927:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5928:     ;
02:0004CA8A 0C02000D        	  5929:     cmpi.b  #$0D,D2
02:0004CA8E 6408            	  5930:     bcc  _anon_z07_30
02:0004CA90 41EC042C        	  5931:     lea     ($042C,A4),A0
