                            	  1811:     ; There's more than one way to enter a room.
                            	  1812:     ;
                            	  1813:     ; 1: Out of a cave, dungeon, or cellar
                            	  1814:     ;     a. Walking exit
                            	  1815:     ;     b. Next to stairs
                            	  1816:     ; 2: Room to room
                            	  1817:     ;
                            	  1818:     ; Determine which one we need.
                            	  1819:     ;
02:000411C2 102C005A        	  1820:     move.b  ($005A,A4),D0
