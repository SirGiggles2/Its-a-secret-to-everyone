                            	  8044: _L_z04_UpdatePolsVoice_SetState1:
                            	  8045:     ; If already in state 1, then go draw and check collisions.
                            	  8046:     ;
02:0003CEC2 41EC00AC        	  8047:     lea     ($00AC,A4),A0
02:0003CEC6 10302000        	  8048:     move.b  (A0,D2.W),D0
02:0003CECA 6702            	  8049:     beq.s  __far_z_04_0074
