                            	 12912: Ganon_MoveAndShoot:
                            	 12913:     ; Change the animation frame every screen frame; so that
                            	 12914:     ; when Ganon is hit, he appears in a random pose.
                            	 12915:     ;
02:0003F2F4 41EC046B        	 12916:     lea     ($046B,A4),A0
02:0003F2F8 52302000        	 12917:     addq.b  #1,(A0,D2.W)
                            	 12918:     ; The animation cycle has 6 frames.
                            	 12919:     ;
02:0003F2FC 41EC046B        	 12920:     lea     ($046B,A4),A0
02:0003F300 10302000        	 12921:     move.b  (A0,D2.W),D0
02:0003F304 0C000006        	 12922:     cmpi.b  #$06,D0
