                            	  6026: __far_z_04_0045:
                            	  6027:     even
                            	  6028: Moldorm_ChangeFlyingState:
                            	  6029:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  6030:     ;
02:0003C0B0 61000096        	  6031:     jsr     Flyer_MoldormDecideState
02:0003C0B4 7010            	  6032:     moveq   #16,D0
02:0003C0B6 19802028        	  6033:     move.b  D0,($28,A4,D2.W)
                            	  6034:     ; If the next lower slot's direction <> 0, then
                            	  6035:     ; go propagate direction changes down the chain.
                            	  6036:     ;
                            	  6037:     ; But you had to have propagated directions once for the
                            	  6038:     ; next lower direction to be set. How does it happen?
                            	  6039:     ;
                            	  6040:     ; Within a flyer state, the flying routines turn the flyer
                            	  6041:     ; and set the object timer to $10 several times. After any of
                            	  6042:     ; those times will the test succeed.
                            	  6043:     ;
                            	  6044:     ; When a flying state ends, timer will be 0, triggering the code
                            	  6045:     ; in this block to set the timer to $10, and try to propagate
                            	  6046:     ; directions.
                            	  6047:     ;
                            	  6048:     ; But this is also the case the first time here.
                            	  6049:     ;
                            	  6050:     ; So, I believe that the point of this test is to delay moving
                            	  6051:     ; the lower (not head) segments when starting out.
                            	  6052:     ;
02:0003C0BA 41EC0097        	  6053:     lea     ($0097,A4),A0
02:0003C0BE 10302000        	  6054:     move.b  (A0,D2.W),D0
02:0003C0C2 6702            	  6055:     beq.s  __far_z_04_0046
02:0003C0C4 601C            	  6056:     jmp  Moldorm_PropagateDirs
                            	  6057: __far_z_04_0046:
02:0003C0C6 4E75            	  6058:     rts
                            	  6059: 
                            	  6060:     even
                            	  6061: Moldorm_Wander:
                            	  6062:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6063:     ; Only the head controls the movement direction.
                            	  6064:     ;
02:0003C0C8 0C020005        	  6065:     cmpi.b  #$05,D2
02:0003C0CC 6708            	  6066:     beq  _anon_z04_82
02:0003C0CE 0C02000A        	  6067:     cmpi.b  #$0A,D2
