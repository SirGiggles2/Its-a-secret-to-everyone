                            	 11200: __far_z_04_0105:
                            	 11201: ; Description:
                            	 11202: ; This block applies to heads and the bottom segment of a neck.
                            	 11203: ; These are drawn with sprites that come first in order, so that
                            	 11204: ; they are drawn above all other sprites, including Link.
                            	 11205: ;
                            	 11206: ; Params:
                            	 11207: ; A: tile number
                            	 11208: ;
                            	 11209: ; Normal sprite with level palette row
                            	 11210:     even
                            	 11211: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E6B6 7603            	 11212:     moveq   #3,D3
02:0003E6B8 19430003        	 11213:     move.b  D3,($0003,A4)
02:0003E6BC 1B00            	 11214:     move.b  D0,-(A5)  ; PHA
                            	 11215:     ; To calculate the base offset of the sprite record:
                            	 11216:     ; offset := neck index * 8
                            	 11217:     ;
                            	 11218:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11219:     ; at an even index.
                            	 11220:     ;
02:0003E6BE 102C04D7        	 11221:     move.b  ($04D7,A4),D0
02:0003E6C2 E308            	 11222:     lsl.b  #1,D0   ; ASL A
02:0003E6C4 E308            	 11223:     lsl.b  #1,D0   ; ASL A
02:0003E6C6 E308            	 11224:     lsl.b  #1,D0   ; ASL A
                            	 11225:     ; But if the segment is not a head (not at object slot 5), then
                            	 11226:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11227:     ;
02:0003E6C8 0C020005        	 11228:     cmpi.b  #$05,D2
02:0003E6CC 670A            	 11229:     beq  _anon_z04_139
02:0003E6CE 023C00EE        	 11230:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6D2 123C0020        	 11231:     move.b  #$20,D1
02:0003E6D6 D101            	 11232:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11233: _anon_z04_139:
02:0003E6D8 7600            	 11234:     moveq   #0,D3
02:0003E6DA 1600            	 11235:     move.b  D0,D3
02:0003E6DC 101D            	 11236:     move.b  (A5)+,D0  ; PLA
02:0003E6DE 4EB90003192C    	 11237:     jsr     Anim_WriteSpecificSprite
02:0003E6E4 6026            	 11238:     jmp     Gleeok_CheckCollisions
                            	 11239: 
                            	 11240:     even
