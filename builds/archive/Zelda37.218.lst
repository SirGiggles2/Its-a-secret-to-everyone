                            	  2407: _L_z04__TryShooting_TryShootingNow:
                            	  2408:     ; Summary
                            	  2409:     ;
                            	  2410:     ; if temporarily invincible then
                            	  2411:     ;   shoot timer := 0
                            	  2412:     ; elif shoot timer > 0 then
                            	  2413:     ;   decrement shoot timer
                            	  2414:     ; elif wants to shoot then
                            	  2415:     ;   shoot timer := $30
                            	  2416:     ;
                            	  2417:     ; qspeed := [01]
                            	  2418:     ;
                            	  2419:     ; if shoot timer <> 0 then
                            	  2420:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2421:     ;     shoot
                            	  2422:     ;     if succeeded then
                            	  2423:     ;       shoot timer := 0
                            	  2424:     ;       qspeed := 0
                            	  2425:     ;   else
                            	  2426:     ;     qspeed := 0
                            	  2427:     ;
                            	  2428:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A6BC 102C0001        	  2429:     move.b  ($0001,A4),D0
02:0003A6C0 1883            	  2430:     move.b  D3,($0000,A4)
02:0003A6C2 1B00            	  2431:     move.b  D0,-(A5)  ; PHA
02:0003A6C4 7600            	  2432:     moveq   #0,D3
