                            	  7392: Dodongo_CheckBombHit:
                            	  7393:     ; If state <> 0 (not moving), then return.
                            	  7394:     ;
02:0003CA74 41EC00AC        	  7395:     lea     ($00AC,A4),A0
02:0003CA78 10302000        	  7396:     move.b  (A0,D2.W),D0
02:0003CA7C 66000086        	  7397:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7398:     ; If facing vertically, then store (X + 8) in [00].
                            	  7399:     ; Else store (X + $10).
                            	  7400:     ;
02:0003CA80 10342070        	  7401:     move.b  ($70,A4,D2.W),D0
02:0003CA84 023C00EE        	  7402:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA88 123C0008        	  7403:     move.b  #$08,D1
02:0003CA8C D101            	  7404:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA8E 7600            	  7405:     moveq   #0,D3
02:0003CA90 41EC0098        	  7406:     lea     ($0098,A4),A0
02:0003CA94 16302000        	  7407:     move.b  (A0,D2.W),D3
02:0003CA98 0C030004        	  7408:     cmpi.b  #$04,D3
02:0003CA9C 6406            	  7409:     bcc  _anon_z04_91
02:0003CA9E 123C0008        	  7410:     move.b  #$08,D1
02:0003CAA2 D101            	  7411:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7412: _anon_z04_91:
02:0003CAA4 1880            	  7413:     move.b  D0,($0000,A4)
                            	  7414:     ; Store (Y + 8) in [01].
                            	  7415:     ;
02:0003CAA6 41EC0084        	  7416:     lea     ($0084,A4),A0
02:0003CAAA 10302000        	  7417:     move.b  (A0,D2.W),D0
02:0003CAAE 123C0008        	  7418:     move.b  #$08,D1
02:0003CAB2 D101            	  7419:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAB4 19400001        	  7420:     move.b  D0,($0001,A4)
                            	  7421:     ; Only check the first bomb slot ($10).
                            	  7422:     ;
                            	  7423:     ; Store the bomb's (X + 8) in [02].
                            	  7424:     ;
02:0003CAB8 7610            	  7425:     moveq   #16,D3
02:0003CABA 10343070        	  7426:     move.b  ($70,A4,D3.W),D0
02:0003CABE 123C0008        	  7427:     move.b  #$08,D1
02:0003CAC2 D101            	  7428:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAC4 19400002        	  7429:     move.b  D0,($0002,A4)
                            	  7430:     ; Store the bomb's (Y + 8) in [03].
                            	  7431:     ;
02:0003CAC8 41EC0084        	  7432:     lea     ($0084,A4),A0
02:0003CACC 10303000        	  7433:     move.b  (A0,D3.W),D0
02:0003CAD0 123C0008        	  7434:     move.b  #$08,D1
02:0003CAD4 D101            	  7435:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAD6 19400003        	  7436:     move.b  D0,($0003,A4)
                            	  7437:     ; But, if there's no bomb, then return.
                            	  7438:     ;
02:0003CADA 41EC00AC        	  7439:     lea     ($00AC,A4),A0
02:0003CADE 10303000        	  7440:     move.b  (A0,D3.W),D0
02:0003CAE2 6720            	  7441:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7442:     ; If the bomb has not exploded (state $12), then
                            	  7443:     ; go see if Dodongo will eat it.
