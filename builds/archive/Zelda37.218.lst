                            	  2155: CheckZora:
                            	  2156:     ; If the zora attribute of this room is off, return.
                            	  2157:     ;
02:0003A502 7600            	  2158:     moveq   #0,D3
02:0003A504 162C00EB        	  2159:     move.b  ($00EB,A4),D3
02:0003A508 41F900FF687E    	  2160:     lea     (NES_SRAM+$087E).l,A0
02:0003A50E 10303000        	  2161:     move.b  (A0,D3.W),D0
02:0003A512 02000008        	  2162:     andi.b #$08,D0
02:0003A516 677C            	  2163:     beq  _L_z04_CheckZora_Exit
                            	  2164:     ; If zora is active, return.
                            	  2165:     ;
02:0003A518 102C0514        	  2166:     move.b  ($0514,A4),D0
02:0003A51C 6676            	  2167:     bne  _L_z04_CheckZora_Exit
                            	  2168:     ; Look for an empty monster slot. If none is found, return.
                            	  2169:     ;
02:0003A51E 4EB90004DB34    	  2170:     jsr     FindEmptyMonsterSlot
02:0003A524 676E            	  2171:     beq  _L_z04_CheckZora_Exit
                            	  2172:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2173:     ; Indexed by [0D].
                            	  2174:     ;
02:0003A526 700D            	  2175:     moveq   #13,D0
02:0003A528 1940000D        	  2176:     move.b  D0,($000D,A4)
                            	  2177:     ; Switch to the new object slot.
                            	  2178:     ;
02:0003A52C 7400            	  2179:     moveq   #0,D2
02:0003A52E 142C0059        	  2180:     move.b  ($0059,A4),D2
                            	  2181:     even
                            	  2182: _L_z04_CheckZora_LoopTileCandidate:
                            	  2183:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2184:     ; If it = 0 or $F0, go loop again.
                            	  2185:     ;
02:0003A532 7600            	  2186:     moveq   #0,D3
02:0003A534 162C000D        	  2187:     move.b  ($000D,A4),D3
02:0003A538 10343018        	  2188:     move.b  ($18,A4,D3.W),D0
02:0003A53C 020000F0        	  2189:     andi.b #$F0,D0
02:0003A540 19802070        	  2190:     move.b  D0,($70,A4,D2.W)
02:0003A544 6748            	  2191:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A546 0C0000F0        	  2192:     cmpi.b  #$F0,D0
02:0003A54A 6742            	  2193:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2194:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2195:     ; If it < $50 or >= $E0, go loop again.
                            	  2196:     ;
02:0003A54C 10343018        	  2197:     move.b  ($18,A4,D3.W),D0
02:0003A550 E308            	  2198:     lsl.b  #1,D0   ; ASL A
02:0003A552 E308            	  2199:     lsl.b  #1,D0   ; ASL A
02:0003A554 E308            	  2200:     lsl.b  #1,D0   ; ASL A
02:0003A556 E308            	  2201:     lsl.b  #1,D0   ; ASL A
02:0003A558 0C000050        	  2202:     cmpi.b  #$50,D0
02:0003A55C 6530            	  2203:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A55E 0C0000E0        	  2204:     cmpi.b  #$E0,D0
02:0003A562 642A            	  2205:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2206:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2207:     ;
02:0003A564 0000000D        	  2208:     ori.b #$0D,D0
02:0003A568 41EC0084        	  2209:     lea     ($0084,A4),A0
02:0003A56C 11802000        	  2210:     move.b  D0,(A0,D2.W)
                            	  2211:     ; Get the tile at that location.
                            	  2212:     ; If it's not a water tile, then go loop again.
                            	  2213:     ;
02:0003A570 4EB90004BA80    	  2214:     jsr     GetCollidableTileStill
02:0003A576 0C00008D        	  2215:     cmpi.b  #$8D,D0
02:0003A57A 6512            	  2216:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A57C 0C000099        	  2217:     cmpi.b  #$99,D0
02:0003A580 640C            	  2218:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2219:     ; Flag the zora active, and set up the object.
                            	  2220:     ;
02:0003A582 522C0514        	  2221:     addq.b  #1,($0514,A4)
02:0003A586 7011            	  2222:     moveq   #17,D0
02:0003A588 4EF90004DB2E    	  2223:     jmp     SetTypeAndClearObject
                            	  2224: 
                            	  2225:     even
