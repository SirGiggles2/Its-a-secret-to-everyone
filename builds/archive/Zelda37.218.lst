                            	  7654: Dodongo_Draw:
02:0003CC02 610000F4        	  7655:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7656:     ; Make a 5-way direction index out of the facing direction
                            	  7657:     ; by shifting right once, and store it in [00].
                            	  7658:     ;
02:0003CC06 41EC0098        	  7659:     lea     ($0098,A4),A0
02:0003CC0A 10302000        	  7660:     move.b  (A0,D2.W),D0
02:0003CC0E E208            	  7661:     lsr.b  #1,D0   ; LSR A
02:0003CC10 1880            	  7662:     move.b  D0,($0000,A4)
                            	  7663:     ; If state = 0, go handle animating the two frames of this state.
                            	  7664:     ;
02:0003CC12 7600            	  7665:     moveq   #0,D3
02:0003CC14 41EC00AC        	  7666:     lea     ($00AC,A4),A0
02:0003CC18 16302000        	  7667:     move.b  (A0,D2.W),D3
02:0003CC1C 6744            	  7668:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7669:     ; If state > 1, then the monster is stunned (state 2).
                            	  7670:     ; So, go switch frames every $20 screen frames.
                            	  7671:     ;
02:0003CC1E 7020            	  7672:     moveq   #32,D0
02:0003CC20 5303            	  7673:     subq.b  #1,D3
02:0003CC22 6640            	  7674:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7675:     ; State = 1. Bloated.
                            	  7676:     ;
                            	  7677:     ; In substate 0, go animate as usual for walking.
                            	  7678:     ;
02:0003CC24 7600            	  7679:     moveq   #0,D3
02:0003CC26 41EC042C        	  7680:     lea     ($042C,A4),A0
02:0003CC2A 16302000        	  7681:     move.b  (A0,D2.W),D3
02:0003CC2E 6732            	  7682:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7683:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7684:     ; go fade the boss; so that some frames are not drawn.
                            	  7685:     ;
02:0003CC30 0C030002        	  7686:     cmpi.b  #$02,D3
02:0003CC34 6718            	  7687:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC36 0C030003        	  7688:     cmpi.b  #$03,D3
02:0003CC3A 6712            	  7689:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7690:     ; State 1, substate 1
                            	  7691:     ;
                            	  7692:     ; Add $14 to the frame image index to index into the bloated
                            	  7693:     ; frame images and H-flips.
                            	  7694:     ;
02:0003CC3C 1014            	  7695:     move.b  ($0000,A4),D0
02:0003CC3E 023C00EE        	  7696:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC42 123C0014        	  7697:     move.b  #$14,D1
02:0003CC46 D101            	  7698:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC48 7600            	  7699:     moveq   #0,D3
02:0003CC4A 1600            	  7700:     move.b  D0,D3
02:0003CC4C 6032            	  7701:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7702: 
                            	  7703:     even
                            	  7704: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7705:     ; In bloated substates 2 and 3:
                            	  7706:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7707:     ;
02:0003CC4E 102C0015        	  7708:     move.b  ($0015,A4),D0
02:0003CC52 02000002        	  7709:     andi.b #$02,D0
02:0003CC56 6604            	  7710:     bne.s  __far_z_04_0071
02:0003CC58 600000A6        	  7711:     jmp  L11B00_Exit
                            	  7712: __far_z_04_0071:
02:0003CC5C 7600            	  7713:     moveq   #0,D3
02:0003CC5E 1614            	  7714:     move.b  ($0000,A4),D3
02:0003CC60 601E            	  7715:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7716: 
                            	  7717:     even
                            	  7718: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7719:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7720:     ;
02:0003CC62 7008            	  7721:     moveq   #8,D0
                            	  7722:     even
                            	  7723: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CC64 7600            	  7724:     moveq   #0,D3
02:0003CC66 1614            	  7725:     move.b  ($0000,A4),D3
02:0003CC68 122C0015        	  7726:     move.b  ($0015,A4),D1
02:0003CC6C C001            	  7727:     and.b  D1,D0
02:0003CC6E 6710            	  7728:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7729:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7730:     ; in order to index into the second set of frame image numbers.
                            	  7731:     ;
02:0003CC70 1003            	  7732:     move.b  D3,D0
02:0003CC72 023C00EE        	  7733:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC76 123C0005        	  7734:     move.b  #$05,D1
02:0003CC7A D101            	  7735:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC7C 7600            	  7736:     moveq   #0,D3
02:0003CC7E 1600            	  7737:     move.b  D0,D3
                            	  7738:     even
                            	  7739: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7740:     ; Start preparing sprites.
                            	  7741:     ;
02:0003CC80 4EB90004D344    	  7742:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC86 1003            	  7743:     move.b  D3,D0
02:0003CC88 1B00            	  7744:     move.b  D0,-(A5)  ; PHA
                            	  7745:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7746:     ;
02:0003CC8A 41F90003CBE4    	  7747:     lea     (DodongoFrameHFlips).l,A0
02:0003CC90 10303000        	  7748:     move.b  (A0,D3.W),D0
02:0003CC94 1940000F        	  7749:     move.b  D0,($000F,A4)
02:0003CC98 41F90003CBDA    	  7750:     lea     (DodongoFrameImages).l,A0
02:0003CC9E 10303000        	  7751:     move.b  (A0,D3.W),D0
                            	  7752:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7753:     ; They are drawn mirrored.
                            	  7754:     ;
02:0003CCA2 0C000007        	  7755:     cmpi.b  #$07,D0
02:0003CCA6 6706            	  7756:     beq  _anon_z04_92
02:0003CCA8 0C000009        	  7757:     cmpi.b  #$09,D0
02:0003CCAC 6608            	  7758:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7759: _anon_z04_92:
02:0003CCAE 4EB9000315FE    	  7760:     jsr     DrawObjectMirrored
02:0003CCB4 6006            	  7761:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7762: 
                            	  7763:     even
                            	  7764: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7765:     ; No other frame images are mirrored.
                            	  7766:     ;
02:0003CCB6 4EB900031602    	  7767:     jsr     DrawObjectNotMirrored
                            	  7768:     even
                            	  7769: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CCBC 101D            	  7770:     move.b  (A5)+,D0  ; PLA
02:0003CCBE 7600            	  7771:     moveq   #0,D3
02:0003CCC0 1600            	  7772:     move.b  D0,D3
                            	  7773:     ; If facing vertically, then return. There's no other side to draw.
                            	  7774:     ;
02:0003CCC2 41EC0098        	  7775:     lea     ($0098,A4),A0
02:0003CCC6 10302000        	  7776:     move.b  (A0,D2.W),D0
02:0003CCCA 02000003        	  7777:     andi.b #$03,D0
02:0003CCCE 6602            	  7778:     bne.s  __far_z_04_0072
02:0003CCD0 602E            	  7779:     jmp  L11B00_Exit
                            	  7780: __far_z_04_0072:
                            	  7781:     ; Else draw the right side.
                            	  7782:     ;
                            	  7783:     ; Keep the Y coordinate in [01].
                            	  7784:     ; But, store (X + $10) in [00].
                            	  7785:     ;
02:0003CCD2 10342070        	  7786:     move.b  ($70,A4,D2.W),D0
02:0003CCD6 023C00EE        	  7787:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCDA 123C0010        	  7788:     move.b  #$10,D1
02:0003CCDE D101            	  7789:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CCE0 1880            	  7790:     move.b  D0,($0000,A4)
02:0003CCE2 6114            	  7791:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7792:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7793:     ;
                            	  7794:     ; So, if we had animation frame 1, direction left:
                            	  7795:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7796:     ; - frame image index = 6 (1 + 5)
                            	  7797:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7798:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7799:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7800:     ;
                            	  7801:     ; So, 3 would have been the frame number used above for
                            	  7802:     ; the left side.
                            	  7803:     ;
                            	  7804:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7805:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7806:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7807:     ; on the right.
                            	  7808:     ;
02:0003CCE4 41F90003CBDA    	  7809:     lea     (DodongoFrameImages).l,A0
02:0003CCEA 10303000        	  7810:     move.b  (A0,D3.W),D0
02:0003CCEE 0A000001        	  7811:     eori.b #$01,D0
02:0003CCF2 4EF900031602    	  7812:     jmp     DrawObjectNotMirrored
                            	  7813: 
                            	  7814: ; Returns:
                            	  7815: ; A: 3
                            	  7816: ; [04]: left sprite attributes
                            	  7817: ; [05]: right sprite attributes
                            	  7818: ;
                            	  7819:     even
