                            	  7970: _L_z04_UpdatePolsVoice_State0:
                            	  7971:     ; State 0. Walking.
                            	  7972:     ;
                            	  7973:     ; If grid offset = 0, then no more distance to cover.
                            	  7974:     ; So, go change to state 1 -- jumping.
                            	  7975:     ;
02:0003CE34 41EC0394        	  7976:     lea     ($0394,A4),A0
02:0003CE38 10302000        	  7977:     move.b  (A0,D2.W),D0
02:0003CE3C 67000084        	  7978:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7979:     ; Decrement grid offset / distance remaining.
                            	  7980:     ;
02:0003CE40 41EC0394        	  7981:     lea     ($0394,A4),A0
02:0003CE44 53302000        	  7982:     subq.b  #1,(A0,D2.W)
                            	  7983:     ; Move vertically.
                            	  7984:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7985:     ;
02:0003CE48 41EC0084        	  7986:     lea     ($0084,A4),A0
02:0003CE4C 10302000        	  7987:     move.b  (A0,D2.W),D0
02:0003CE50 023C00EE        	  7988:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE54 41F90003CDE4    	  7989:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE5A 12303000        	  7990:     move.b  (A0,D3.W),D1
02:0003CE5E D101            	  7991:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CE60 41EC0084        	  7992:     lea     ($0084,A4),A0
02:0003CE64 11802000        	  7993:     move.b  D0,(A0,D2.W)
                            	  7994:     even
                            	  7995: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7996:     ; If the square the monster is over is walkable, then
                            	  7997:     ; go draw and check object collisions.
                            	  7998:     ;
02:0003CE68 610001F4        	  7999:     jsr     PolsVoice_IsSquareWalkable
02:0003CE6C 6452            	  8000:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  8001:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  8002:     ; then go change to state 1.
                            	  8003:     ;
02:0003CE6E 41EC041F        	  8004:     lea     ($041F,A4),A0
02:0003CE72 10302000        	  8005:     move.b  (A0,D2.W),D0
02:0003CE76 020000FC        	  8006:     andi.b #$FC,D0
02:0003CE7A 0C0000B0        	  8007:     cmpi.b  #$B0,D0
02:0003CE7E 6742            	  8008:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CE80 0C0000F4        	  8009:     cmpi.b  #$F4,D0
02:0003CE84 643C            	  8010:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  8011:     ; Else blocked by something else.
                            	  8012:     ;
                            	  8013:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  8014:     ;
02:0003CE86 41EC0098        	  8015:     lea     ($0098,A4),A0
02:0003CE8A 10302000        	  8016:     move.b  (A0,D2.W),D0
02:0003CE8E 02000003        	  8017:     andi.b #$03,D0
02:0003CE92 6618            	  8018:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  8019:     ; Else facing vertically. Flip the direction.
