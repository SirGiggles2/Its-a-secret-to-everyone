                            	  3840: _L_z05_CheckLadder_SetState2:
                            	  3841:     ;  Set state 2, because we're on the ladder.
                            	  3842:     ;
02:00042054 7002            	  3843:     moveq   #2,D0
02:00042056 41EC00AC        	  3844:     lea     ($00AC,A4),A0
