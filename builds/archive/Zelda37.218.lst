02:0004CA50 10342070        	  5886:     move.b  ($70,A4,D2.W),D0
02:0004CA54 0C000002        	  5887:     cmpi.b  #$02,D0
02:0004CA58 650E            	  5888:     bcs  _L_z07_CheckState30_SetState40
