02:00030BCC 41EC00AC        	  4736:     lea     ($00AC,A4),A0
02:00030BD0 10302000        	  4737:     move.b  (A0,D2.W),D0
02:00030BD4 670E            	  4738:     beq  _L_z01_WieldBomb_FoundSlot
02:00030BD6 020000F0        	  4739:     andi.b #$F0,D0
02:00030BDA 0C000010        	  4740:     cmpi.b  #$10,D0
