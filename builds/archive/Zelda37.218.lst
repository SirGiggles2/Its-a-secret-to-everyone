02:0003CE06 102C066C        	  7945:     move.b  ($066C,A4),D0
02:0003CE0A 1234203D        	  7946:     move.b  ($3D,A4,D2.W),D1
02:0003CE0E 8001            	  7947:     or.b  D1,D0
02:0003CE10 660000AE        	  7948:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7949:     ; Every odd screen frame, go straight to drawing
                            	  7950:     ; and checking collisions.
                            	  7951:     ;
02:0003CE14 102C0015        	  7952:     move.b  ($0015,A4),D0
02:0003CE18 E208            	  7953:     lsr.b  #1,D0   ; LSR A
02:0003CE1A 6404            	  7954:     bcc.s  __far_z_04_0073
02:0003CE1C 60000118        	  7955:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7956: __far_z_04_0073:
                            	  7957:     ; Otherwise move horizontally.
                            	  7958:     ;
02:0003CE20 610002A8        	  7959:     jsr     PolsVoice_MoveX
                            	  7960:     ; If state <> 0, then the monster is jumping.
                            	  7961:     ; Go handle vertical movement.
