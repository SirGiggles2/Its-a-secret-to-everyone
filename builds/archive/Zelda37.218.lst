02:00031D1C 10303000        	  7003:     move.b  (A0,D3.W),D0
02:00031D20 E308            	  7004:     lsl.b  #1,D0   ; ASL A
02:00031D22 65F2            	  7005:     bcs  _anon_z01_87
02:00031D24 1883            	  7006:     move.b  D3,($0000,A4)
                            	  7007:     ; Set boomerang damage type (2) in [09].
                            	  7008:     ;
