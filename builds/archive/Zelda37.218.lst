02:0003F5AC 003C0011        	 13278:     ori     #$11,CCR  ; SEC: set C+X
02:0003F5B0 41EC0478        	 13279:     lea     ($0478,A4),A0
02:0003F5B4 12302000        	 13280:     move.b  (A0,D2.W),D1
02:0003F5B8 0A3C0010        	 13281:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F5BC 9101            	 13282:     subx.b  D1,D0   ; SBC Ganon_ObjCloudDist,X
