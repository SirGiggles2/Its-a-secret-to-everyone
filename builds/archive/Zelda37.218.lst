                            	  7698: ; Params:
                            	  7699: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7700: ; [00]: weapon object slot (unused)
                            	  7701: ; [02]: object 1 mid X
                            	  7702: ; [03]: object 1 mid Y
                            	  7703: ; [04]: object 2 mid X
                            	  7704: ; [05]: object 2 mid Y
                            	  7705: ;
                            	  7706: ; Returns:
                            	  7707: ; A: 1 if objects collide
                            	  7708: ; Y: weapon object slot
                            	  7709: ; Z: 0 if objects collide
                            	  7710: ; [06]: 1 if objects collide
                            	  7711: ; [0A]: horizontal distance
                            	  7712: ; [0B]: vertical distance
                            	  7713: ;
                            	  7714: ;
                            	  7715: ; Use the same threshold value horizontally and vertically.
                            	  7716: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7717: ;
                            	  7718:     even
                            	  7719: DoObjectsCollide:
02:00032152 1940000D        	  7720:     move.b  D0,($000D,A4)
