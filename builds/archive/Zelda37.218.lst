02:0003C01C 41EC0350        	  5948:     lea     ($0350,A4),A0
02:0003C020 10303000        	  5949:     move.b  (A0,D3.W),D0
02:0003C024 0C000041        	  5950:     cmpi.b  #$41,D0
02:0003C028 66F0            	  5951:     bne  _anon_z04_80
                            	  5952:     ; I don't know why the object timer of the tail segment that will
                            	  5953:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5954:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5955:     ; there, the object timer is set to 6.
                            	  5956:     ;
02:0003C02A 7011            	  5957:     moveq   #17,D0
02:0003C02C 19803029        	  5958:     move.b  D0,($29,A4,D3.W)
                            	  5959:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5960:     ; segment to the tail segment.
                            	  5961:     ;
02:0003C030 41EC04F0        	  5962:     lea     ($04F0,A4),A0
02:0003C034 10302000        	  5963:     move.b  (A0,D2.W),D0
02:0003C038 41EC04F1        	  5964:     lea     ($04F1,A4),A0
