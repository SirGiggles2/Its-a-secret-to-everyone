                            	 12045:     ; The goal is to swap the current dead segment with the tail segment.
                            	 12046:     ;
02:0003ED10 163C00FF        	 12047:     move.b  #$FF,D3
02:0003ED14 0C020006        	 12048:     cmpi.b  #$06,D2
