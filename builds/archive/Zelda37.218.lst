02:0003BB48 020000F0        	  5347:     andi.b #$F0,D0
02:0003BB4C 00000001        	  5348:     ori.b #$01,D0
02:0003BB50 4EB9000318F4    	  5349:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5350:     ; If the sprite attributes for this step have horizontal flipping ($40),
