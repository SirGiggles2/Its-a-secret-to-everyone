02:0003E802 003C0011        	 11389:     ori     #$11,CCR  ; SEC: set C+X
02:0003E806 123C0041        	 11390:     move.b  #$41,D1
02:0003E80A 0A3C0010        	 11391:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E80E 9101            	 11392:     subx.b  D1,D0   ; SBC #$41
02:0003E810 0A3C0010        	 11393:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E814 1214            	 11394:     move.b  ($0000,A4),D1
02:0003E816 B001            	 11395:     cmp.b   D1,D0
                            	 11396:     ; If they're equal, then go handle the whole boss dying.
