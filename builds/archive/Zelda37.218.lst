                            	  3128: ; Three sets of border coordinates:
                            	  3129: ; - outer OW
                            	  3130: ; - outer UW
                            	  3131: ; - inner
                            	  3132: ;
                            	  3133: ; Within each set, the coordinates are arranged:
                            	  3134: ; down, up, right, left
                            	  3135: ;
                            	  3136:     even
                            	  3137: BorderBounds:
02:00041BA8 D6              	  3138:     dc.b    $D6, $45, $E9, $07, $C6, $55, $D9, $17
02:00041BA9 45
02:00041BAA E9
02:00041BAB 07
02:00041BAC C6
02:00041BAD 55
02:00041BAE D9
02:00041BAF 17
02:00041BB0 BE              	  3139:     dc.b    $BE, $54, $D1, $1F
02:00041BB1 54
02:00041BB2 D1
02:00041BB3 1F
                            	  3140: 
                            	  3141:     even
                            	  3142: Link_FilterInput:
                            	  3143:     ; [00] holds the opposite of Link's facing direction.
                            	  3144:     ;
02:00041BB4 102C0098        	  3145:     move.b  ($0098,A4),D0
02:00041BB8 4EB900030A38    	  3146:     jsr     GetOppositeDir
02:00041BBE 1880            	  3147:     move.b  D0,($0000,A4)
                            	  3148:     ; Call GetOppositeDir again to use this mapping:
                            	  3149:     ; In Dir: 1 2 4 8
                            	  3150:     ;         -------
                            	  3151:     ; Index:  2 3 0 1
                            	  3152:     ;
02:00041BC0 4EB900030A38    	  3153:     jsr     GetOppositeDir
                            	  3154:     ; Get the appropriate coordinate for the direction:
                            	  3155:     ; X for horizontal
                            	  3156:     ; Y for vertical
                            	  3157:     ;
02:00041BC6 102C0070        	  3158:     move.b  ($0070,A4),D0
02:00041BCA 0C030002        	  3159:     cmpi.b  #$02,D3
02:00041BCE 6404            	  3160:     bcc  _anon_z05_74
02:00041BD0 102C0084        	  3161:     move.b  ($0084,A4),D0
                            	  3162: _anon_z05_74:
02:00041BD4 19400002        	  3163:     move.b  D0,($0002,A4)
                            	  3164:     ; Mask A button and directions if inner border is crossed.
                            	  3165:     ;
02:00041BD8 1003            	  3166:     move.b  D3,D0
02:00041BDA 1B00            	  3167:     move.b  D0,-(A5)  ; PHA
02:00041BDC 023C00EE        	  3168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BE0 123C0008        	  3169:     move.b  #$08,D1
02:00041BE4 D101            	  3170:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041BE6 7600            	  3171:     moveq   #0,D3
02:00041BE8 1600            	  3172:     move.b  D0,D3
02:00041BEA 103C0080        	  3173:     move.b  #$80,D0
02:00041BEE 6134            	  3174:     jsr     MaskInputInBorder
02:00041BF0 101D            	  3175:     move.b  (A5)+,D0  ; PLA
02:00041BF2 7600            	  3176:     moveq   #0,D3
02:00041BF4 1600            	  3177:     move.b  D0,D3
                            	  3178:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3179:     ; boundary using player's direction and reverse direction index.
                            	  3180:     ;
02:00041BF6 102C0001        	  3181:     move.b  ($0001,A4),D0
02:00041BFA 0C0000FF        	  3182:     cmpi.b  #$FF,D0
02:00041BFE 660C            	  3183:     bne  _anon_z05_75
02:00041C00 102C0098        	  3184:     move.b  ($0098,A4),D0
02:00041C04 1880            	  3185:     move.b  D0,($0000,A4)
02:00041C06 4EB900030A38    	  3186:     jsr     GetOppositeDir
                            	  3187: _anon_z05_75:
                            	  3188:     ; If in UW, use the second set of bounds by adding 4
                            	  3189:     ; to reverse direction index.
                            	  3190:     ;
                            	  3191:     ; Else in OW, and use first set that begins at offset 0.
                            	  3192:     ;
02:00041C0C 102C0010        	  3193:     move.b  ($0010,A4),D0
02:00041C10 6710            	  3194:     beq  _anon_z05_76
02:00041C12 1003            	  3195:     move.b  D3,D0
02:00041C14 023C00EE        	  3196:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C18 123C0004        	  3197:     move.b  #$04,D1
02:00041C1C D101            	  3198:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041C1E 7600            	  3199:     moveq   #0,D3
02:00041C20 1600            	  3200:     move.b  D0,D3
                            	  3201: _anon_z05_76:
                            	  3202:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3203:     ;
02:00041C22 7000            	  3204:     moveq   #0,D0
                            	  3205: ; Params:
                            	  3206: ; A: mask of buttons to block
                            	  3207: ; Y: offset into BorderBounds
                            	  3208: ; [00]: direction
                            	  3209: ; [02]: coordinate
                            	  3210: ;
                            	  3211: ; Returns:
                            	  3212: ; [01]: button mask that was used
                            	  3213: ;       (set to $FF if boundary not crossed)
                            	  3214: ;
                            	  3215:     even
                            	  3216: MaskInputInBorder:
02:00041C24 19400001        	  3217:     move.b  D0,($0001,A4)
                            	  3218:     ; If direction is positive (right or down), then go handle it separately.
                            	  3219:     ;
02:00041C28 1014            	  3220:     move.b  ($0000,A4),D0
02:00041C2A 0200000A        	  3221:     andi.b #$0A,D0
02:00041C2E 6748            	  3222:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3223:     ; The direction is negative (left or up).
                            	  3224:     ;
                            	  3225:     ; If the coordinate does not cross (<) the boundary, then
                            	  3226:     ; go set mask $FF, so that no button is excluded.
                            	  3227:     ;
02:00041C30 102C0002        	  3228:     move.b  ($0002,A4),D0
02:00041C34 41F900041BA8    	  3229:     lea     (BorderBounds).l,A0
02:00041C3A 12303000        	  3230:     move.b  (A0,D3.W),D1
02:00041C3E B001            	  3231:     cmp.b   D1,D0
02:00041C40 6548            	  3232:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3233:     even
                            	  3234: _L_z05_MaskInputInBorder_MaskButtons:
