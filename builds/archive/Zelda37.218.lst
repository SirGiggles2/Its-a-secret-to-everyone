                            	  5919: _L_z07_CheckState30_CheckOtherStates:
                            	  5920:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5921:     ;
                            	  5922:     ; The boomerang will now return. Reset the grid offset.
                            	  5923:     ;
