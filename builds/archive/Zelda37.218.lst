                            	  4964: 
                            	  4965: ; Params:
                            	  4966: ; [02:03]: address of door tiles for direction and face
                            	  4967: ; [04]: count of tiles remaining
                            	  4968: ; [07]: current index (0 to 3) of the tile to copy
                            	  4969: ;       to the dynamic transfer buf
                            	  4970: ; [09]: door direction index
                            	  4971: ;
                            	  4972: ; Returns:
                            	  4973: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4974: ; [04]: original value - 1
                            	  4975: ; [07]: original value + 1
                            	  4976: ;
                            	  4977: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4978: ; vertically. The point of this routine is to access them
                            	  4979: ; horizontally in order to transfer them to a nametable.
                            	  4980: ;
                            	  4981: ;
                            	  4982: ; For the direction index in [09], look up the base offset of the
                            	  4983: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4984: ; the door face tiles at [02:03].
                            	  4985: ;
                            	  4986:     even
                            	  4987: WriteDoorFaceTileHorizontally:
02:00042900 7600            	  4988:     moveq   #0,D3
02:00042902 162C0009        	  4989:     move.b  ($0009,A4),D3
02:00042906 41F900043B24    	  4990:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0004290C 10303000        	  4991:     move.b  (A0,D3.W),D0
                            	  4992:     ; Add [07] to the base offset we got above. This yields one
                            	  4993:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4994:     ;
02:00042910 023C00EE        	  4995:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042914 122C0007        	  4996:     move.b  ($0007,A4),D1
02:00042918 D101            	  4997:     addx.b  D1,D0   ; ADC $07
02:0004291A 7600            	  4998:     moveq   #0,D3
02:0004291C 1600            	  4999:     move.b  D0,D3
                            	  5000:     ; With that index, look up the index to use with the door face
                            	  5001:     ; list of tiles at [02:03].
                            	  5002:     ;
02:0004291E 41F900043B16    	  5003:     lea     (HorizontalDoorFaceIndexes).l,A0
02:00042924 10303000        	  5004:     move.b  (A0,D3.W),D0
02:00042928 7600            	  5005:     moveq   #0,D3
02:0004292A 1600            	  5006:     move.b  D0,D3
                            	  5007:     ; Now we can read one of four tiles inside a door face tile map,
                            	  5008:     ; and copy it to the dynamic transfer buf.
                            	  5009:     ;
02:0004292C 122C0002        	  5010:     move.b  ($02,A4),D1   ; ptr lo
02:00042930 182C0003        	  5011:     move.b  ($03,A4),D4  ; ptr hi
02:00042934 024100FF        	  5012:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042938 E14C            	  5013:     lsl.w   #8,D4
02:0004293A 8841            	  5014:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004293C 48C4            	  5015:     ext.l   D4
02:0004293E D8BC00FF0000    	  5016:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042944 2044            	  5017:     movea.l D4,A0
02:00042946 10303000        	  5018:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004294A 41EC0302        	  5019:     lea     ($0302,A4),A0
02:0004294E 11802000        	  5020:     move.b  D0,(A0,D2.W)
                            	  5021:     ; Prepare for the next call:
                            	  5022:     ; - increment dynamic transfer buf pointer
                            	  5023:     ; - increment index of tile to copy [07]
                            	  5024:     ; - decrement count of tiles remaining
                            	  5025:     ;
02:00042952 5202            	  5026:     addq.b  #1,D2
02:00042954 522C0007        	  5027:     addq.b  #1,($0007,A4)
02:00042958 532C0004        	  5028:     subq.b  #1,($0004,A4)
02:0004295C 4E75            	  5029:     rts
                            	  5030: 
                            	  5031:     even
