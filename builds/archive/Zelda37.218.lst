                            	  8525: _anon_z05_174:
                            	  8526:     ; Two input directions, and at least one of them is walkable.
                            	  8527:     ;
                            	  8528:     ; Make Link go straight in one direction on the next grid line.
                            	  8529:     ;
02:000450DE 7600            	  8530:     moveq   #0,D3
02:000450E0 1600            	  8531:     move.b  D0,D3
02:000450E2 522C0057        	  8532:     addq.b  #1,($0057,A4)
                            	  8533:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8534:     ; object direction and input direction to last walkable direction
                            	  8535:     ; found, and set Link's speed.
                            	  8536:     ;
                            	  8537:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8538:     ;
02:000450E6 7400            	  8539:     moveq   #0,D2
02:000450E8 102C000D        	  8540:     move.b  ($000D,A4),D0
02:000450EC 0C030001        	  8541:     cmpi.b  #$01,D3
02:000450F0 67000096        	  8542:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:000450F4 7600            	  8543:     moveq   #0,D3
02:000450F6 162C0010        	  8544:     move.b  ($0010,A4),D3
02:000450FA 6700008C        	  8545:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8546:     ; In UW. There are two input directions, and they're both walkable.
                            	  8547:     ;
                            	  8548:     ; Normally, turn to the direction that's perpendicular to object
                            	  8549:     ; direction. But keep going straight after that, while diagonal
                            	  8550:     ; input is held.
                            	  8551:     ;
                            	  8552:     ; Handle special cases for doors.
                            	  8553:     ;
                            	  8554:     ;
                            	  8555:     ; 1. Link at horizontal doors.
                            	  8556:     ;
                            	  8557:     ; If Link's X = $20 or $D0 then
                            	  8558:     ;   If Link's Y = $85 and facing down then
                            	  8559:     ;     Go set object direction and input direction to object
                            	  8560:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8561:     ;     Link_GoStraightWhenDiagInput.
                            	  8562:     ;   Else
                            	  8563:     ;     Go turn to the perpendicular direction
                            	  8564:     ;
02:000450FE 7600            	  8565:     moveq   #0,D3
02:00045100 162C0070        	  8566:     move.b  ($0070,A4),D3
02:00045104 0C030020        	  8567:     cmpi.b  #$20,D3
02:00045108 6706            	  8568:     beq  _anon_z05_175
02:0004510A 0C0300D0        	  8569:     cmpi.b  #$D0,D3
02:0004510E 661C            	  8570:     bne  _anon_z05_176
