                            	  7269: __far_z_04_0065:
                            	  7270:     ; New bloated substate >= 2.
                            	  7271:     ;
                            	  7272:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7273:     ; which will transition to state 0 (moving).
                            	  7274:     ;
                            	  7275:     ; Note that if the bomb hits >= 2, then:
                            	  7276:     ; - If new substate = 2, then substate 2 will wait,
                            	  7277:     ;   and then transition to substate 3.
                            	  7278:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7279:     ;
