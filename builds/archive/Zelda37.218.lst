02:00030D48 662E            	  4992:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4993:     ; The effect involves turning grayscale rendering on and off
                            	  4994:     ; in PPUMASK.
                            	  4995:     ;
                            	  4996:     ; Start by setting A register to the PPU mask shifted right to
                            	  4997:     ; throw away the grayscale bit.
                            	  4998:     ;
