                            	 13384: Ganon_CheckCollisions:
                            	 13385:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13386:     ; Store in [02] and [03].
                            	 13387:     ;
02:0003F688 10342070        	 13388:     move.b  ($70,A4,D2.W),D0
02:0003F68C 023C00EE        	 13389:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F690 123C0010        	 13390:     move.b  #$10,D1
02:0003F694 D101            	 13391:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F696 19400002        	 13392:     move.b  D0,($0002,A4)
02:0003F69A 41EC0084        	 13393:     lea     ($0084,A4),A0
02:0003F69E 10302000        	 13394:     move.b  (A0,D2.W),D0
02:0003F6A2 023C00EE        	 13395:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F6A6 123C0010        	 13396:     move.b  #$10,D1
02:0003F6AA D101            	 13397:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F6AC 19400003        	 13398:     move.b  D0,($0003,A4)
                            	 13399:     ; Check for a collision with Link.
                            	 13400:     ;
                            	 13401:     ; We can't call CheckLinkCollision, because we need to
                            	 13402:     ; customize Ganon's midpoint.
                            	 13403:     ;
                            	 13404:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13405:     ; detection, if Link is invincible. Initialize variables that will
                            	 13406:     ; be returned from the partial collision check routine. Then
                            	 13407:     ; call it.
                            	 13408:     ;
02:0003F6B0 102C04F0        	 13409:     move.b  ($04F0,A4),D0
02:0003F6B4 6616            	 13410:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F6B6 19400006        	 13411:     move.b  D0,($0006,A4)
02:0003F6BA 19400009        	 13412:     move.b  D0,($0009,A4)
02:0003F6BE 1940000C        	 13413:     move.b  D0,($000C,A4)
02:0003F6C2 7600            	 13414:     moveq   #0,D3
02:0003F6C4 1883            	 13415:     move.b  D3,($0000,A4)
02:0003F6C6 4EB900031AFE    	 13416:     jsr     CheckLinkCollisionPreinit
                            	 13417:     even
                            	 13418: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13419:     ; If Ganon is not in state 0, then he's brown.
                            	 13420:     ; Go check collision with an arrow.
                            	 13421:     ;
02:0003F6CC 41EC00AC        	 13422:     lea     ($00AC,A4),A0
02:0003F6D0 10302000        	 13423:     move.b  (A0,D2.W),D0
02:0003F6D4 6652            	 13424:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13425:     ; If timer <> 0, then Ganon is visible.
                            	 13426:     ; He can't be harmed like this. So, return.
                            	 13427:     ;
02:0003F6D6 10342028        	 13428:     move.b  ($28,A4,D2.W),D0
02:0003F6DA 664A            	 13429:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F6DC 760D            	 13430:     moveq   #13,D3
02:0003F6DE 4EB900031FC8    	 13431:     jsr     CheckMonsterSwordCollision
                            	 13432:     ; If Ganon has died according to the usual collision check rules
                            	 13433:     ; (HP = 0), then:
                            	 13434:     ; 1. Restore HP to the initial value $F0
                            	 13435:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13436:     ; 3. Change palette row 7 to make Ganon brown
                            	 13437:     ;
02:0003F6E4 41EC0405        	 13438:     lea     ($0405,A4),A0
02:0003F6E8 10302000        	 13439:     move.b  (A0,D2.W),D0
02:0003F6EC 6718            	 13440:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F6EE 103C00F0        	 13441:     move.b  #$F0,D0
02:0003F6F2 41EC0485        	 13442:     lea     ($0485,A4),A0
02:0003F6F6 11802000        	 13443:     move.b  D0,(A0,D2.W)
02:0003F6FA 41EC00AC        	 13444:     lea     ($00AC,A4),A0
02:0003F6FE 53302000        	 13445:     subq.b  #1,(A0,D2.W)
02:0003F702 61000084        	 13446:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13447:     even
                            	 13448: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13449:     ; If Ganon was harmed, then play the sound effect
                            	 13450:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13451:     ;
02:0003F706 41EC04F0        	 13452:     lea     ($04F0,A4),A0
02:0003F70A 10302000        	 13453:     move.b  (A0,D2.W),D0
02:0003F70E 670A            	 13454:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F710 61009FBC        	 13455:     jsr     PlayBossHitCryIfNeeded
02:0003F714 7040            	 13456:     moveq   #64,D0
02:0003F716 19802028        	 13457:     move.b  D0,($28,A4,D2.W)
                            	 13458:     even
                            	 13459: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13460:     ; Reset metastate, because Ganon cannot die this way.
                            	 13461:     ;
02:0003F71A 4EB90004DB4C    	 13462:     jsr     ResetObjMetastate
                            	 13463:     ; Reset shove info and invincibility timer, because Ganon
                            	 13464:     ; doesn't react at all as a usual monster.
                            	 13465:     ;
02:0003F720 4EB900031ED0    	 13466:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13467:     even
                            	 13468: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F726 4E75            	 13469:     rts
                            	 13470: 
                            	 13471:     even
                            	 13472: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13473:     ; If the silver arrow is not in the inventory, then return.
                            	 13474:     ;
02:0003F728 102C0659        	 13475:     move.b  ($0659,A4),D0
02:0003F72C 0C000002        	 13476:     cmpi.b  #$02,D0
02:0003F730 66F4            	 13477:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13478:     ; Reset the collision return value [06].
                            	 13479:     ;
02:0003F732 7000            	 13480:     moveq   #0,D0
02:0003F734 19400006        	 13481:     move.b  D0,($0006,A4)
                            	 13482:     ; If there's no arrow in flight, then return.
                            	 13483:     ;
02:0003F738 7612            	 13484:     moveq   #18,D3
02:0003F73A 41EC00AC        	 13485:     lea     ($00AC,A4),A0
02:0003F73E 10303000        	 13486:     move.b  (A0,D3.W),D0
02:0003F742 0C000010        	 13487:     cmpi.b  #$10,D0
02:0003F746 66DE            	 13488:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13489:     ; Check for collision with an arrow; and return if no collision.
                            	 13490:     ;
02:0003F748 4EB900032024    	 13491:     jsr     CheckMonsterArrowOrRodCollision
02:0003F74E 102C0006        	 13492:     move.b  ($0006,A4),D0
02:0003F752 67D2            	 13493:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13494:     ; Set the Ganon phase to "dying".
                            	 13495:     ;
02:0003F754 41EC042C        	 13496:     lea     ($042C,A4),A0
02:0003F758 52302000        	 13497:     addq.b  #1,(A0,D2.W)
                            	 13498:     ; Now his body does flash.
                            	 13499:     ;
02:0003F75C 7028            	 13500:     moveq   #40,D0
02:0003F75E 41EC04F0        	 13501:     lea     ($04F0,A4),A0
02:0003F762 11802000        	 13502:     move.b  D0,(A0,D2.W)
                            	 13503:     ; Set initial cloud distance 8.
                            	 13504:     ;
02:0003F766 7008            	 13505:     moveq   #8,D0
02:0003F768 41EC0478        	 13506:     lea     ($0478,A4),A0
02:0003F76C 11802000        	 13507:     move.b  D0,(A0,D2.W)
02:0003F770 0A3C0001        	 13508:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F774 4E75            	 13509:     rts
                            	 13510: 
                            	 13511:     even
