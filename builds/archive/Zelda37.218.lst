                            	  3427: _anon_z04_45:
02:0003ADD6 1883            	  3428:     move.b  D3,($0000,A4)
                            	  3429:     ; [01] holds Link's X coordinate.
                            	  3430:     ;
02:0003ADD8 102C0070        	  3431:     move.b  ($0070,A4),D0
02:0003ADDC 19400001        	  3432:     move.b  D0,($0001,A4)
                            	  3433:     ; Add Link's X and the horizontal offset.
                            	  3434:     ;
02:0003ADE0 023C00EE        	  3435:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADE4 1214            	  3436:     move.b  ($0000,A4),D1
02:0003ADE6 D101            	  3437:     addx.b  D1,D0   ; ADC $00
                            	  3438:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3439:     ;
02:0003ADE8 020000F8        	  3440:     andi.b #$F8,D0
                            	  3441:     ; Assign that result to the leever's X coordinate and [02].
                            	  3442:     ;
02:0003ADEC 19802070        	  3443:     move.b  D0,($70,A4,D2.W)
02:0003ADF0 19400002        	  3444:     move.b  D0,($0002,A4)
                            	  3445:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3446:     ;
02:0003ADF4 122C0001        	  3447:     move.b  ($0001,A4),D1
02:0003ADF8 B001            	  3448:     cmp.b   D1,D0
02:0003ADFA 6510            	  3449:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003ADFC 1B00            	  3450:     move.b  D0,-(A5)  ; PHA
02:0003ADFE 102C0001        	  3451:     move.b  ($0001,A4),D0
02:0003AE02 19400002        	  3452:     move.b  D0,($0002,A4)
02:0003AE06 101D            	  3453:     move.b  (A5)+,D0  ; PLA
02:0003AE08 19400001        	  3454:     move.b  D0,($0001,A4)
                            	  3455:     even
                            	  3456: _L_z04_UpdateRedLeever_Subtract:
                            	  3457:     ; The point is to get the absolute distance between the two.
                            	  3458:     ;
02:0003AE0C 102C0001        	  3459:     move.b  ($0001,A4),D0
02:0003AE10 003C0011        	  3460:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE14 122C0002        	  3461:     move.b  ($0002,A4),D1
02:0003AE18 0A3C0010        	  3462:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE1C 9101            	  3463:     subx.b  D1,D0   ; SBC $02
02:0003AE1E 0A3C0010        	  3464:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3465:     ; If the absolute distance >= $30, then return.
                            	  3466:     ; It means that the leever's X coordinate wrapped around
                            	  3467:     ; the left or right edge of the screen.
                            	  3468:     ;
02:0003AE22 0C000030        	  3469:     cmpi.b  #$30,D0
02:0003AE26 6486            	  3470:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3471:     even
                            	  3472: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3473:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3474:     ;
