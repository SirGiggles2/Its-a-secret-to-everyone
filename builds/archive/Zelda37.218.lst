02:0003EED6 0A3C0010        	 12312:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEDA 640A            	 12313:     bcc  _anon_z04_154
02:0003EEDC 122C0003        	 12314:     move.b  ($0003,A4),D1
02:0003EEE0 E309            	 12315:     lsl.b  #1,D1   ; ASL $03
02:0003EEE2 19410003        	 12316:     move.b  D1,($0003,A4)
                            	 12317: _anon_z04_154:
                            	 12318:     ; If the horizontal direction toward Link is not allowed, then
