                            	  3983: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3984:     ; Loop to look for a place to spawn a monster from the edge
                            	  3985:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3986:     ;
                            	  3987:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3988:     ; We'll move down $10 pixels.
                            	  3989:     ;
02:00042114 7610            	  3990:     moveq   #16,D3
02:00042116 102C000A        	  3991:     move.b  ($000A,A4),D0
02:0004211A 0200000F        	  3992:     andi.b #$0F,D0
02:0004211E 670A            	  3993:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3994:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3995:     ; Don't move vertically.
                            	  3996:     ;
02:00042120 163C00F0        	  3997:     move.b  #$F0,D3
02:00042124 0C00000F        	  3998:     cmpi.b  #$0F,D0
02:00042128 6610            	  3999:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  4000:     even
                            	  4001: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  4002:     ; Else low nibble = $F. We're at the right edge,
                            	  4003:     ; and we'll move up $10 pixels.
                            	  4004:     ;
02:0004212A 1003            	  4005:     move.b  D3,D0
02:0004212C 023C00EE        	  4006:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042130 122C000A        	  4007:     move.b  ($000A,A4),D1
02:00042134 D101            	  4008:     addx.b  D1,D0   ; ADC $0A
02:00042136 1940000A        	  4009:     move.b  D0,($000A,A4)
                            	  4010:     even
                            	  4011: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  4012:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  4013:     ; Move right one pixel.
                            	  4014:     ;
02:0004213A 102C000A        	  4015:     move.b  ($000A,A4),D0
02:0004213E 020000F0        	  4016:     andi.b #$F0,D0
02:00042142 0C0000E0        	  4017:     cmpi.b  #$E0,D0
02:00042146 6606            	  4018:     bne  _anon_z05_88
02:00042148 522C000A        	  4019:     addq.b  #1,($000A,A4)
02:0004214C 600A            	  4020:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4021: 
                            	  4022: _anon_z05_88:
                            	  4023:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  4024:     ; Dont' move horizontally.
                            	  4025:     ;
02:0004214E 0C000040        	  4026:     cmpi.b  #$40,D0
02:00042152 6604            	  4027:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4028:     ; Else high nibble = 4. We're at the top edge.
                            	  4029:     ; Move left 1 pixel.
                            	  4030:     ;
02:00042154 532C000A        	  4031:     subq.b  #1,($000A,A4)
                            	  4032:     even
                            	  4033: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  4034:     ; Time to get the address of the column.
                            	  4035:     ; Starting at the top of the leftmost column.
                            	  4036:     ;
02:00042158 610026E6        	  4037:     jsr     FetchTileMapAddr
02:0004215C 7005            	  4038:     moveq   #5,D0
02:0004215E 4EB90002A9FA    	  4039:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  4040:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  4041:     ; in order to point to the column we want.
                            	  4042:     ;
02:00042164 102C000A        	  4043:     move.b  ($000A,A4),D0
02:00042168 0200000F        	  4044:     andi.b #$0F,D0
02:0004216C 7600            	  4045:     moveq   #0,D3
02:0004216E 1600            	  4046:     move.b  D0,D3
02:00042170 670C            	  4047:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  4048: _anon_z05_89:
02:00042172 702C            	  4049:     moveq   #44,D0
