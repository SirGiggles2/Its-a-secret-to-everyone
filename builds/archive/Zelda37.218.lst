02:00030710 0A3C0010        	  4021:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030714 9101            	  4022:     subx.b  D1,D0   ; SBC $00
02:00030716 0A3C0010        	  4023:     eori    #$10,CCR  ; restore X = 6502 C
02:0003071A 1880            	  4024:     move.b  D0,($0000,A4)
02:0003071C 101D            	  4025:     move.b  (A5)+,D0  ; PLA
02:0003071E E208            	  4026:     lsr.b  #1,D0   ; LSR A
02:00030720 E208            	  4027:     lsr.b  #1,D0   ; LSR A
02:00030722 E208            	  4028:     lsr.b  #1,D0   ; LSR A
02:00030724 E208            	  4029:     lsr.b  #1,D0   ; LSR A
