02:00030B3C 102C0003        	  4661:     move.b  ($0003,A4),D0
02:00030B40 003C0011        	  4662:     ori     #$11,CCR  ; SEC: set C+X
02:00030B44 122C0004        	  4663:     move.b  ($0004,A4),D1
02:00030B48 0A3C0010        	  4664:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B4C 9101            	  4665:     subx.b  D1,D0   ; SBC $04
02:00030B4E 0A3C0010        	  4666:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B52 19400003        	  4667:     move.b  D0,($0003,A4)
02:00030B56 122C0004        	  4668:     move.b  ($0004,A4),D1
02:00030B5A B001            	  4669:     cmp.b   D1,D0
02:00030B5C 64C8            	  4670:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4671:     even
