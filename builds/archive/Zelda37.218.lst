02:0003A958 10303000        	  2833:     move.b  (A0,D3.W),D0
02:0003A95C 41EC0412        	  2834:     lea     ($0412,A4),A0
02:0003A960 11802000        	  2835:     move.b  D0,(A0,D2.W)
                            	  2836:     ; Reset the vertical speed low byte.
