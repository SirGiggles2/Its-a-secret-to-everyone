                            	 12052: _L_z04_UpdateLamnola_FindTail:
02:0003ED1C 5203            	 12053:     addq.b  #1,D3
02:0003ED1E 41EC0350        	 12054:     lea     ($0350,A4),A0
02:0003ED22 10303000        	 12055:     move.b  (A0,D3.W),D0
02:0003ED26 122C04E7        	 12056:     move.b  ($04E7,A4),D1
02:0003ED2A B001            	 12057:     cmp.b   D1,D0
02:0003ED2C 66EE            	 12058:     bne  _L_z04_UpdateLamnola_FindTail
                            	 12059:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 12060:     ;
02:0003ED2E 7011            	 12061:     moveq   #17,D0
02:0003ED30 19803029        	 12062:     move.b  D0,($29,A4,D3.W)
                            	 12063:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 12064:     ; to the tail segment.
                            	 12065:     ;
02:0003ED34 41EC04F0        	 12066:     lea     ($04F0,A4),A0
02:0003ED38 10302000        	 12067:     move.b  (A0,D2.W),D0
02:0003ED3C 41EC04F1        	 12068:     lea     ($04F1,A4),A0
02:0003ED40 11803000        	 12069:     move.b  D0,(A0,D3.W)
02:0003ED44 10342070        	 12070:     move.b  ($70,A4,D2.W),D0
02:0003ED48 19803071        	 12071:     move.b  D0,($71,A4,D3.W)
02:0003ED4C 41EC0084        	 12072:     lea     ($0084,A4),A0
02:0003ED50 10302000        	 12073:     move.b  (A0,D2.W),D0
02:0003ED54 41EC0085        	 12074:     lea     ($0085,A4),A0
02:0003ED58 11803000        	 12075:     move.b  D0,(A0,D3.W)
                            	 12076:     ; If the tail segment found is a head, then the whole lamnola died.
