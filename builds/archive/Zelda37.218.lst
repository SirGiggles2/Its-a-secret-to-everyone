                            	  2438:     ; then Y := shoot timer - 1
                            	  2439:     ;
02:0003A6D0 7600            	  2440:     moveq   #0,D3
02:0003A6D2 41EC0451        	  2441:     lea     ($0451,A4),A0
02:0003A6D6 16302000        	  2442:     move.b  (A0,D2.W),D3
02:0003A6DA 5303            	  2443:     subq.b  #1,D3
                            	  2444:     ; If Y register < 0, then shoot timer is 0.
                            	  2445:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2446:     ; Else go set a non-zero speed and return.
