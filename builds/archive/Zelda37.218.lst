                            	 12829: 
                            	 12830: ; Description:
                            	 12831: ; Lift up the Triforce of Courage while the room is light.
                            	 12832: ;
                            	 12833: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12834: ;
                            	 12835:     even
                            	 12836: Ganon_ScenePhase1:
02:0003F28E 701B            	 12837:     moveq   #27,D0
02:0003F290 19400505        	 12838:     move.b  D0,($0505,A4)
                            	 12839:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12840:     ;
02:0003F294 102C0028        	 12841:     move.b  ($0028,A4),D0
02:0003F298 6702            	 12842:     beq.s  __far_z_04_0128
02:0003F29A 6012            	 12843:     jmp  Ganon_DrawBodyFrame0
                            	 12844: __far_z_04_0128:
                            	 12845:     ; Once the timer expires:
                            	 12846:     ; 1. unhalt Link
                            	 12847:     ; 2. clear the item to lift
                            	 12848:     ; 3. play level 9 song
                            	 12849:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12850:     ;
02:0003F29C 194000AC        	 12851:     move.b  D0,($00AC,A4)
02:0003F2A0 19400505        	 12852:     move.b  D0,($0505,A4)
02:0003F2A4 7020            	 12853:     moveq   #32,D0
02:0003F2A6 19400600        	 12854:     move.b  D0,($0600,A4)
02:0003F2AA 522C0445        	 12855:     addq.b  #1,($0445,A4)
                            	 12856:     even
                            	 12857: Ganon_DrawBodyFrame0:
                            	 12858:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12859:     ; with animation frame 0.
