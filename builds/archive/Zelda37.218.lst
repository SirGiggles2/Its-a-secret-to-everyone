                            	 10133:     ;
02:0003DEA8 122C0002        	 10134:     move.b  ($0002,A4),D1
02:0003DEAC E309            	 10135:     lsl.b  #1,D1   ; ASL $02
02:0003DEAE 19410002        	 10136:     move.b  D1,($0002,A4)
02:0003DEB2 122C0002        	 10137:     move.b  ($0002,A4),D1
02:0003DEB6 C200            	 10138:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEB8 6704            	 10139:     beq  _anon_z04_119
