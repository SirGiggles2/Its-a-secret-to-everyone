02:0003D336 61000334        	  8587:     jsr     BlueWizzrobe_TryShooting
                            	  8588:     even
                            	  8589: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8590:     ; If the teleporting distance remaining is even, then draw
                            	  8591:     ; and check collisions, else return.
                            	  8592:     ;
                            	  8593:     ; This means that when 0, the monster is walking.
                            	  8594:     ; So, draw and check collisions every frame.
                            	  8595:     ;
                            	  8596:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8597:     ; translucently -- every other frame.
                            	  8598:     ;
02:0003D33A 41EC0394        	  8599:     lea     ($0394,A4),A0
02:0003D33E 10302000        	  8600:     move.b  (A0,D2.W),D0
02:0003D342 E208            	  8601:     lsr.b  #1,D0   ; LSR A
02:0003D344 6402            	  8602:     bcc.s  __far_z_04_0076
02:0003D346 603A            	  8603:     jmp  L11E17_Exit
                            	  8604: __far_z_04_0076:
                            	  8605:     even
