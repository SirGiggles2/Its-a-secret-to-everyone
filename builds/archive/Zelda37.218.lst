02:00041C5E 102C0098        	  3250:     move.b  ($0098,A4),D0
02:00041C62 0200000C        	  3251:     andi.b #$0C,D0
02:00041C66 6602            	  3252:     bne  _anon_z05_77
02:00041C68 7603            	  3253:     moveq   #3,D3
                            	  3254: _anon_z05_77:
