                            	  4076: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  4077:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  4078:     ;
                            	  4079:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  4080:     ;         or object direction when <> 0.
                            	  4081:     ;
                            	  4082:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  4083:     ;
                            	  4084:     ; if slot = 0 and grid offset <> 0 then
                            	  4085:     ;   if input dir = 0 then
                            	  4086:     ;     use 0
                            	  4087:     ;   else
