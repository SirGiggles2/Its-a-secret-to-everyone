                            	  8051: __far_z_04_0074:
                            	  8052:     ; Go to state 1.
                            	  8053:     ;
02:0003CECE 41EC00AC        	  8054:     lea     ($00AC,A4),A0
02:0003CED2 52302000        	  8055:     addq.b  #1,(A0,D2.W)
                            	  8056:     ; Subtract 1 from facing direction to make an index.
                            	  8057:     ;
02:0003CED6 7600            	  8058:     moveq   #0,D3
02:0003CED8 41EC0098        	  8059:     lea     ($0098,A4),A0
02:0003CEDC 16302000        	  8060:     move.b  (A0,D2.W),D3
02:0003CEE0 5303            	  8061:     subq.b  #1,D3
                            	  8062:     ; If Y coordinate < $78, make the index 3 for down.
                            	  8063:     ;
02:0003CEE2 41EC0084        	  8064:     lea     ($0084,A4),A0
02:0003CEE6 10302000        	  8065:     move.b  (A0,D2.W),D0
02:0003CEEA 0C000078        	  8066:     cmpi.b  #$78,D0
02:0003CEEE 6402            	  8067:     bcc  _anon_z04_97
02:0003CEF0 7603            	  8068:     moveq   #3,D3
                            	  8069: _anon_z04_97:
                            	  8070:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  8071:     ;
02:0003CEF2 0C0000A8        	  8072:     cmpi.b  #$A8,D0
02:0003CEF6 6502            	  8073:     bcs  _anon_z04_98
02:0003CEF8 7607            	  8074:     moveq   #7,D3
                            	  8075: _anon_z04_98:
                            	  8076:     ; Set the vertical speed for the beginning of the jump.
                            	  8077:     ;
02:0003CEFA 41F90003CDEE    	  8078:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF00 10303000        	  8079:     move.b  (A0,D3.W),D0
02:0003CF04 41EC0412        	  8080:     lea     ($0412,A4),A0
02:0003CF08 11802000        	  8081:     move.b  D0,(A0,D2.W)
                            	  8082:     ; Look up the Y offset for the current direction.
                            	  8083:     ; Add it to object Y to set the destination Y of the jump.
