02:0003AF64 41EC034F        	  3629:     lea     ($034F,A4),A0
02:0003AF68 16302000        	  3630:     move.b  (A0,D2.W),D3
02:0003AF6C 0C030007        	  3631:     cmpi.b  #$07,D3
02:0003AF70 6708            	  3632:     beq  _L_z04_UpdateOctorock_Shoot
