                            	  1824:     ; Enter method 1.
                            	  1825:     ;
                            	  1826:     ; Set up Link's exit from underground.
                            	  1827:     ;
02:000411CE 7600            	  1828:     moveq   #0,D3
02:000411D0 162C00EB        	  1829:     move.b  ($00EB,A4),D3
02:000411D4 41F900FF687E    	  1830:     lea     (NES_SRAM+$087E).l,A0
02:000411DA 10303000        	  1831:     move.b  (A0,D3.W),D0
02:000411DE 020000F0        	  1832:     andi.b #$F0,D0
02:000411E2 19400070        	  1833:     move.b  D0,($0070,A4)
02:000411E6 41F900FF6AFE    	  1834:     lea     (NES_SRAM+$0AFE).l,A0
02:000411EC 10303000        	  1835:     move.b  (A0,D3.W),D0
02:000411F0 02000007        	  1836:     andi.b #$07,D0
02:000411F4 E308            	  1837:     lsl.b  #1,D0   ; ASL A
02:000411F6 E308            	  1838:     lsl.b  #1,D0   ; ASL A
02:000411F8 E308            	  1839:     lsl.b  #1,D0   ; ASL A
02:000411FA E308            	  1840:     lsl.b  #1,D0   ; ASL A
                            	  1841:     ; Add the first Y where Link can come out of underground.
                            	  1842:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:000411FC 123C004D        	  1843:     move.b  #$4D,D1
