                            	  2778: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2779:     ; If reversal count >= 2, then
                            	  2780:     ; 1. invert the horizontal component of facing direction,
                            	  2781:     ;    to face away from the chase target
                            	  2782:     ; 2. reset the reversal count to 0.
                            	  2783:     ;
                            	  2784:     ; This prevents a jumper from getting stuck in a corner.
                            	  2785:     ;
                            	  2786:     ; For example, if a tektite's direction is down and right,
                            	  2787:     ; and jumps into the top right corner of the room:
                            	  2788:     ; 1. The right room boundary is hit. So the direction is
                            	  2789:     ;    automatically reversed to up and left.
                            	  2790:     ; 2. The next frame, the top room boundary is hit.
                            	  2791:     ;    The direction is reversed to down and right.
                            	  2792:     ;
                            	  2793:     ; As you can see, an endless loop has been made.
                            	  2794:     ;
02:0003A8F4 41EC0451        	  2795:     lea     ($0451,A4),A0
02:0003A8F8 10302000        	  2796:     move.b  (A0,D2.W),D0
02:0003A8FC 0C000002        	  2797:     cmpi.b  #$02,D0
02:0003A900 651E            	  2798:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A902 41EC0098        	  2799:     lea     ($0098,A4),A0
02:0003A906 10302000        	  2800:     move.b  (A0,D2.W),D0
02:0003A90A 0A000003        	  2801:     eori.b #$03,D0
02:0003A90E 41EC0098        	  2802:     lea     ($0098,A4),A0
02:0003A912 11802000        	  2803:     move.b  D0,(A0,D2.W)
02:0003A916 7000            	  2804:     moveq   #0,D0
02:0003A918 41EC0451        	  2805:     lea     ($0451,A4),A0
02:0003A91C 11802000        	  2806:     move.b  D0,(A0,D2.W)
                            	  2807:     even
                            	  2808: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2809:     ; If the object is a boulder, then make sure its facing direction
                            	  2810:     ; has a down vertical component.
                            	  2811:     ;
02:0003A920 610001F8        	  2812:     jsr     Jumper_PointBoulderDownward
                            	  2813:     ; For the given direction, get the Y offset of the destination
                            	  2814:     ; of the jump.
                            	  2815:     ;
                            	  2816:     ; Add it to the object's Y, and store this destination Y.
                            	  2817:     ;
02:0003A924 7600            	  2818:     moveq   #0,D3
02:0003A926 41EC0098        	  2819:     lea     ($0098,A4),A0
