                            	  2915: __far_z_04_0024:
                            	  2916:     ; Going down. We have to consider the target Y.
                            	  2917:     ;
                            	  2918:     ; If the absolute vertical distance to the target position >= 3,
                            	  2919:     ; then go animate, draw, and check collisions.
                            	  2920:     ;
02:0003A9F2 41EC0084        	  2921:     lea     ($0084,A4),A0
02:0003A9F6 10302000        	  2922:     move.b  (A0,D2.W),D0
