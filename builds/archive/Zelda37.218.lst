                            	  9813:     ;
02:0003DC58 41EC0405        	  9814:     lea     ($0405,A4),A0
02:0003DC5C 10302000        	  9815:     move.b  (A0,D2.W),D0
02:0003DC60 674E            	  9816:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DC62 4EB90004BCB2    	  9817:     jsr     ResetShoveInfo
