02:0003C0D4 6070            	  6069:     jmp  L1156B_Exit
                            	  6070: __far_z_04_0047:
                            	  6071: _anon_z04_82:
                            	  6072:     ; Turn randomly while flying, as usual.
                            	  6073:     ;
02:0003C0D6 61003DE0        	  6074:     jsr     Flyer_Wander
                            	  6075:     ; After every turn, the common flyer routines set timer to $10.
                            	  6076:     ; This can be used as a signal for moldorm to propagate
                            	  6077:     ; direction changes down the chain.
                            	  6078:     ;
                            	  6079:     ; Between each turn, timer <> $10.
                            	  6080:     ;
                            	  6081:     ; At the end of the delay after the last turn, timer = 0.
                            	  6082:     ; This is a signal that that flying state ended, and a new one
                            	  6083:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6084:     ; we can propagate direction changes again; and start
                            	  6085:     ; a new flying interval by setting timer to $10. This will make
                            	  6086:     ; the next flying state delay that amount of time before turning
                            	  6087:     ; the first time.
                            	  6088:     ;
                            	  6089:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6090:     ; arm the timer again, and shift directions down the chain.
                            	  6091:     ;
02:0003C0DA 10342028        	  6092:     move.b  ($28,A4,D2.W),D0
02:0003C0DE 6602            	  6093:     bne.s  __far_z_04_0048
02:0003C0E0 60CE            	  6094:     jmp  Moldorm_ChangeFlyingState
                            	  6095: __far_z_04_0048:
                            	  6096:     even
