                            	  7126: UpdateDodongoState0_Move:
                            	  7127:     ; If facing left, then push X offset 0 on the stack.
                            	  7128:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7129:     ;
                            	  7130:     ; We would like to use one set of coordinates only.
                            	  7131:     ; But movement would break down, if we did; because
                            	  7132:     ; Dodongo is so long.
                            	  7133:     ;
                            	  7134:     ; So, when not facing left, we temporarily shift the
                            	  7135:     ; X coordinate to be closer to the other side of the monster.
                            	  7136:     ;
02:0003C88E 7600            	  7137:     moveq   #0,D3
02:0003C890 41EC0098        	  7138:     lea     ($0098,A4),A0
02:0003C894 10302000        	  7139:     move.b  (A0,D2.W),D0
02:0003C898 0200000D        	  7140:     andi.b #$0D,D0
02:0003C89C 6716            	  7141:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C89E 10342070        	  7142:     move.b  ($70,A4,D2.W),D0
02:0003C8A2 023C00EE        	  7143:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8A6 123C0010        	  7144:     move.b  #$10,D1
02:0003C8AA D101            	  7145:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C8AC 19802070        	  7146:     move.b  D0,($70,A4,D2.W)
02:0003C8B0 163C00F0        	  7147:     move.b  #$F0,D3
                            	  7148:     even
                            	  7149: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C8B4 1003            	  7150:     move.b  D3,D0
02:0003C8B6 1B00            	  7151:     move.b  D0,-(A5)  ; PHA
02:0003C8B8 7020            	  7152:     moveq   #32,D0
02:0003C8BA 41EC041F        	  7153:     lea     ($041F,A4),A0
02:0003C8BE 11802000        	  7154:     move.b  D0,(A0,D2.W)
02:0003C8C2 6100CF08        	  7155:     jsr     Wanderer_TargetPlayer
                            	  7156:     ; Pop the offset and add it to the X coordinate.
                            	  7157:     ;
                            	  7158:     ; This brings the X coordinate back to the unique value
                            	  7159:     ; that represents the position.
                            	  7160:     ;
02:0003C8C6 101D            	  7161:     move.b  (A5)+,D0  ; PLA
02:0003C8C8 023C00EE        	  7162:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8CC 12342070        	  7163:     move.b  ($70,A4,D2.W),D1
02:0003C8D0 D101            	  7164:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C8D2 19802070        	  7165:     move.b  D0,($70,A4,D2.W)
                            	  7166:     ; If X coordinate < $20, then face right.
                            	  7167:     ;
02:0003C8D6 0C000020        	  7168:     cmpi.b  #$20,D0
02:0003C8DA 640A            	  7169:     bcc  _anon_z04_89
02:0003C8DC 7001            	  7170:     moveq   #1,D0
02:0003C8DE 41EC0098        	  7171:     lea     ($0098,A4),A0
02:0003C8E2 11802000        	  7172:     move.b  D0,(A0,D2.W)
