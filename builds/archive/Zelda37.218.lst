02:0003C51E E309            	  6668:     lsl.b  #1,D1   ; ASL $02
02:0003C520 19410002        	  6669:     move.b  D1,($0002,A4)
02:0003C524 122C0002        	  6670:     move.b  ($0002,A4),D1
02:0003C528 C200            	  6671:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
