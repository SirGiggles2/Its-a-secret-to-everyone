                            	   352: ;------------------------------------------------------------------------------
                            	   353: ; _c_move_object_shim — MoveObject trampoline.
                            	   354: ;
                            	   355: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   356: ;   Input:     D2 = slot (0..11)
                            	   357: ;   Preserves: D2, A4, A5
                            	   358: ;   Clobbers:  D0, D1, D3, A0
                            	   359: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   360: ;
                            	   361: ; GCC side:
                            	   362: ;   void c_move_object(unsigned short slot);
                            	   363: ;     slot arrives as a 16-bit value on the stack.
                            	   364: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   365: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   366: ;   never clobbered by gcc.
                            	   367: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   368: ;   semantics can exist in a pure C port).
                            	   369: ;------------------------------------------------------------------------------
                            	   370: _c_move_object_shim:
                            	   371:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   372:     move.b  #$AA,($0900,A4)
                            	   373:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   374:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   375:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   376:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   377:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   378:     moveq   #0,D0
02:0002B658 3002            	   379:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   380:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   381:     jsr     c_move_object
02:0002B662 588F            	   382:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   383:     rts
                            	   384: 
                            	   385: ;==============================================================================
                            	   386: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   387: ; and tail-call the native asm function.
                            	   388: ;
                            	   389: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   390: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   391: ; sign-extended).
                            	   392: ;==============================================================================
                            	   393: 
                            	   394: ;------------------------------------------------------------------------------
                            	   395: ; void c_copy_bank_to_window(unsigned int bank);
                            	   396: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   397: ;------------------------------------------------------------------------------
                            	   398: c_copy_bank_to_window:
02:0002B666 202F0004        	   399:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   400:     jmp     _copy_bank_to_window
                            	   401: 
                            	   402: ;------------------------------------------------------------------------------
                            	   403: ; unsigned char c_ppu_read_2(void);
                            	   404: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   405: ; C return: gcc expects result in D0.
                            	   406: ;------------------------------------------------------------------------------
                            	   407: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   408:     jmp     _ppu_read_2
                            	   409: 
                            	   410: ;------------------------------------------------------------------------------
                            	   411: ; void c_ppu_write_6(unsigned int val);
                            	   412: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   413: ;------------------------------------------------------------------------------
                            	   414: c_ppu_write_6:
02:0002B674 202F0004        	   415:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   416:     jmp     _ppu_write_6
                            	   417: 
                            	   418: ;------------------------------------------------------------------------------
                            	   419: ; void c_ppu_write_7(unsigned int val);
                            	   420: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   421: ;------------------------------------------------------------------------------
                            	   422: c_ppu_write_7:
02:0002B67E 202F0004        	   423:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   424:     jmp     _ppu_write_7
                            	   425: 
