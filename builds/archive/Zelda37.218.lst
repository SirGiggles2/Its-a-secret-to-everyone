02:0003DE00 4EB9000318F4    	 10043:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DE06 101D            	 10044:     move.b  (A5)+,D0  ; PLA
02:0003DE08 1B00            	 10045:     move.b  D0,-(A5)  ; PHA
                            	 10046:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	 10047:     ;
02:0003DE0A 02000040        	 10048:     andi.b #$40,D0
02:0003DE0E 6704            	 10049:     beq  _anon_z04_116
02:0003DE10 522C000F        	 10050:     addq.b  #1,($000F,A4)
