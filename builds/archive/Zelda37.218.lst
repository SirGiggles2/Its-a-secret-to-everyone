                            	  8505: HaveInput:
                            	  8506:     ; There were input directions.
                            	  8507:     ;
                            	  8508:     ; If there was only one input direction, go set object direction
                            	  8509:     ; to input direction, and set Link's speed.
                            	  8510:     ;
                            	  8511:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8512:     ; (X is still 0, because it's Link's object index).
                            	  8513:     ;
02:000450C8 102C000F        	  8514:     move.b  ($000F,A4),D0
