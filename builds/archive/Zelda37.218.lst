                            	  3780:     ;
02:00041FE4 102C0084        	  3781:     move.b  ($0084,A4),D0
02:00041FE8 023C00EE        	  3782:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041FEC 123C0003        	  3783:     move.b  #$03,D1
02:00041FF0 D101            	  3784:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041FF2 41EC0084        	  3785:     lea     ($0084,A4),A0
02:00041FF6 12302000        	  3786:     move.b  (A0,D2.W),D1
02:00041FFA B001            	  3787:     cmp.b   D1,D0
02:00041FFC 6648            	  3788:     bne  _L_z05_CheckLadder_StashLadder
02:00041FFE 102C0070        	  3789:     move.b  ($0070,A4),D0
02:00042002 003C0011        	  3790:     ori     #$11,CCR  ; SEC: set C+X
02:00042006 12342070        	  3791:     move.b  ($70,A4,D2.W),D1
02:0004200A 0A3C0010        	  3792:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004200E 9101            	  3793:     subx.b  D1,D0   ; SBC ObjX,X
02:00042010 0A3C0010        	  3794:     eori    #$10,CCR  ; restore X = 6502 C
