02:0003EEC4 003C0011        	 12307:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEC8 41EC0084        	 12308:     lea     ($0084,A4),A0
02:0003EECC 12302000        	 12309:     move.b  (A0,D2.W),D1
02:0003EED0 0A3C0010        	 12310:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
