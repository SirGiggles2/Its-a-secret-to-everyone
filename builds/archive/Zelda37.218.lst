02:0003DEDC E309            	 10156:     lsl.b  #1,D1   ; ASL $02
02:0003DEDE 19410002        	 10157:     move.b  D1,($0002,A4)
02:0003DEE2 122C0002        	 10158:     move.b  ($0002,A4),D1
