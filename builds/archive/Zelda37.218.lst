02:0002DDCE 7600            	   408:     moveq   #0,D3
02:0002DDD0 41EC046C        	   409:     lea     ($046C,A4),A0
02:0002DDD4 16302000        	   410:     move.b  (A0,D2.W),D3
02:0002DDD8 41EC046F        	   411:     lea     ($046F,A4),A0
02:0002DDDC 10303000        	   412:     move.b  (A0,D3.W),D0
02:0002DDE0 41EC0448        	   413:     lea     ($0448,A4),A0
02:0002DDE4 11802000        	   414:     move.b  D0,(A0,D2.W)
02:0002DDE8 5302            	   415:     subq.b  #1,D2
02:0002DDEA 6AE2            	   416:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   417:     even
