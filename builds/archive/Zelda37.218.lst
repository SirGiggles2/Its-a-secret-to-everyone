02:0004B176 41EC0084        	  2348:     lea     ($0084,A4),A0
02:0004B17A 10302000        	  2349:     move.b  (A0,D2.W),D0
02:0004B17E 19400002        	  2350:     move.b  D0,($0002,A4)
02:0004B182 4EB9000313A4    	  2351:     jsr     MapScreenPosToPpuAddr
02:0004B188 7400            	  2352:     moveq   #0,D2
02:0004B18A 142C0301        	  2353:     move.b  ($0301,A4),D2
                            	  2354:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2355:     ;
                            	  2356:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2357:     ; In total, 11 bytes will be written.
                            	  2358:     ;
                            	  2359:     ; First, write the high byte of PPU address in each record.
                            	  2360:     ;
02:0004B18E 1014            	  2361:     move.b  ($0000,A4),D0
02:0004B190 41EC0302        	  2362:     lea     ($0302,A4),A0
02:0004B194 11802000        	  2363:     move.b  D0,(A0,D2.W)
02:0004B198 41EC0307        	  2364:     lea     ($0307,A4),A0
02:0004B19C 11802000        	  2365:     move.b  D0,(A0,D2.W)
                            	  2366:     ; Write the low address in the first record. In the second record,
                            	  2367:     ; write (low address + 1).
                            	  2368:     ;
02:0004B1A0 102C0001        	  2369:     move.b  ($0001,A4),D0
02:0004B1A4 41EC0303        	  2370:     lea     ($0303,A4),A0
02:0004B1A8 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0004B1AC 41EC0308        	  2372:     lea     ($0308,A4),A0
02:0004B1B0 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B1B4 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B1B8 52302000        	  2375:     addq.b  #1,(A0,D2.W)
                            	  2376:     ; Write the first tile twice in each record. Patch them later.
                            	  2377:     ;
02:0004B1BC 102C0005        	  2378:     move.b  ($0005,A4),D0
02:0004B1C0 41EC0305        	  2379:     lea     ($0305,A4),A0
02:0004B1C4 11802000        	  2380:     move.b  D0,(A0,D2.W)
02:0004B1C8 41EC0306        	  2381:     lea     ($0306,A4),A0
02:0004B1CC 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B1D0 41EC030A        	  2383:     lea     ($030A,A4),A0
02:0004B1D4 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B1D8 41EC030B        	  2385:     lea     ($030B,A4),A0
02:0004B1DC 11802000        	  2386:     move.b  D0,(A0,D2.W)
                            	  2387:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2388:     ; Add 1 more to the second byte in each record.
                            	  2389:     ; Here is an example result of this manipulation:
                            	  2390:     ;   record 1: $70, $71
                            	  2391:     ;   record 2: $72, $73
                            	  2392:     ;
02:0004B1E0 0C000046        	  2393:     cmpi.b  #$46,D0
02:0004B1E4 6530            	  2394:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B1E6 0C0000F3        	  2395:     cmpi.b  #$F3,D0
02:0004B1EA 642A            	  2396:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B1EC 023C00EE        	  2397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B1F0 123C0002        	  2398:     move.b  #$02,D1
02:0004B1F4 D101            	  2399:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B1F6 41EC030A        	  2400:     lea     ($030A,A4),A0
02:0004B1FA 11802000        	  2401:     move.b  D0,(A0,D2.W)
02:0004B1FE 41EC030B        	  2402:     lea     ($030B,A4),A0
02:0004B202 11802000        	  2403:     move.b  D0,(A0,D2.W)
02:0004B206 41EC0306        	  2404:     lea     ($0306,A4),A0
02:0004B20A 52302000        	  2405:     addq.b  #1,(A0,D2.W)
02:0004B20E 41EC030B        	  2406:     lea     ($030B,A4),A0
02:0004B212 52302000        	  2407:     addq.b  #1,(A0,D2.W)
