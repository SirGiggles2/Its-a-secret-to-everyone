02:0003F2C4 6704            	 12875:     beq.s  __far_z_04_0129
02:0003F2C6 600000A4        	 12876:     jmp  Ganon_Dying
                            	 12877: __far_z_04_0129:
02:0003F2CA 610003BC        	 12878:     jsr     Ganon_CheckCollisions
02:0003F2CE 6100A3FE        	 12879:     jsr     PlayBossHitCryIfNeeded
                            	 12880:     ; Go handle the brown state specially.
                            	 12881:     ;
02:0003F2D2 41EC00AC        	 12882:     lea     ($00AC,A4),A0
02:0003F2D6 10302000        	 12883:     move.b  (A0,D2.W),D0
02:0003F2DA 6702            	 12884:     beq.s  __far_z_04_0130
