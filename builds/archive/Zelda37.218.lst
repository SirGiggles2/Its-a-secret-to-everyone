                            	  5748: __far_z_07_0087:
                            	  5749:     ; State $2x. Spark.
                            	  5750:     ;
                            	  5751:     ; Change the state to $28, and decrement animation counter.
                            	  5752:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5753:     ; (with Link, if this is a monster's boomerang).
                            	  5754:     ;
                            	  5755:     ; TODO: Why state $28?
                            	  5756:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5757:     ; start over again when spinning.
                            	  5758:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5759:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5760:     ; any drawing code depends on the minor state.
                            	  5761:     ;
02:0004C970 7028            	  5762:     moveq   #40,D0
02:0004C972 41EC00AC        	  5763:     lea     ($00AC,A4),A0
