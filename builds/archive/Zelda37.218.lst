02:0003CDA0 E208            	  7887:     lsr.b  #1,D0   ; LSR A
02:0003CDA2 E208            	  7888:     lsr.b  #1,D0   ; LSR A
                            	  7889:     ; If movement frame = 1, add 3 to frame image to access
                            	  7890:     ; the second animation frame's images.
                            	  7891:     ;
02:0003CDA4 7600            	  7892:     moveq   #0,D3
02:0003CDA6 41EC03E4        	  7893:     lea     ($03E4,A4),A0
02:0003CDAA 16302000        	  7894:     move.b  (A0,D2.W),D3
02:0003CDAE 671E            	  7895:     beq  _anon_z04_95
02:0003CDB0 023C00EE        	  7896:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDB4 123C0003        	  7897:     move.b  #$03,D1
02:0003CDB8 D101            	  7898:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7899:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7900:     ;
                            	  7901:     ; Down has two frame images, but up only has one. By flipping
                            	  7902:     ; horizontally, you get two frame images.
                            	  7903:     ;
02:0003CDBA 7600            	  7904:     moveq   #0,D3
02:0003CDBC 41EC0098        	  7905:     lea     ($0098,A4),A0
02:0003CDC0 16302000        	  7906:     move.b  (A0,D2.W),D3
02:0003CDC4 0C030008        	  7907:     cmpi.b  #$08,D3
02:0003CDC8 6604            	  7908:     bne  _anon_z04_95
02:0003CDCA 522C000F        	  7909:     addq.b  #1,($000F,A4)
                            	  7910: _anon_z04_95:
02:0003CDCE 4EB900031602    	  7911:     jsr     DrawObjectNotMirrored
02:0003CDD4 0A3C0001        	  7912:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
