                            	  2541: ModeE_HandleAOrB:
02:00034C24 102C0420        	  2542:     move.b  ($0420,A4),D0
                            	  2543:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2544:     ; the name field.
02:00034C28 6646            	  2545:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034C2A 7600            	  2546:     moveq   #0,D3
02:00034C2C 162C0016        	  2547:     move.b  ($0016,A4),D3
02:00034C30 0C030003        	  2548:     cmpi.b  #$03,D3
02:00034C34 6602            	  2549:     bne.s  __far_z_02_0007
02:00034C36 60E4            	  2550:     jmp  LA10A_Exit
                            	  2551: __far_z_02_0007:
                            	  2552:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2553:     ; in the current slot's name.
02:00034C38 41F900034646    	  2554:     lea     (SlotToNameOffset).l,A0
02:00034C3E 10303000        	  2555:     move.b  (A0,D3.W),D0
02:00034C42 19400421        	  2556:     move.b  D0,($0421,A4)
                            	  2557:     ; Get the offset of the end of the initial name character
                            	  2558:     ; transfer record header for the current slot.
02:00034C46 7400            	  2559:     moveq   #0,D2
02:00034C48 41F90003464A    	  2560:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034C4E 14303000        	  2561:     move.b  (A0,D3.W),D2
02:00034C52 7602            	  2562:     moveq   #2,D3
                            	  2563:     even
                            	  2564: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00034C54 41F900034616    	  2565:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034C5A 10302000        	  2566:     move.b  (A0,D2.W),D0
02:00034C5E 41EC0422        	  2567:     lea     ($0422,A4),A0
02:00034C62 11803000        	  2568:     move.b  D0,(A0,D3.W)
02:00034C66 5302            	  2569:     subq.b  #1,D2
02:00034C68 5303            	  2570:     subq.b  #1,D3
02:00034C6A 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034C6C 522C0420        	  2572:     addq.b  #1,($0420,A4)
                            	  2573:     even
                            	  2574: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2575:     ; At this point:
                            	  2576:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2577:     ;   - This will be changed as the player inputs characters.
                            	  2578:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2579:     ;   - This will be changed as the player inputs characters.
                            	  2580:     ; - InitializedNameField [$0420] is set to 1.
                            	  2581:     ;
02:00034C70 102C00F8        	  2582:     move.b  ($00F8,A4),D0
02:00034C74 020000C0        	  2583:     andi.b #$C0,D0
02:00034C78 670000E8        	  2584:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2585:     ; A or B was pressed.
                            	  2586:     ;
02:00034C7C 0C000040        	  2587:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034C80 660000A6        	  2588:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2589:     ; A was pressed.
                            	  2590:     ;
                            	  2591:     ; Request to play the character click tune (same as bomb set).
02:00034C84 7620            	  2592:     moveq   #32,D3
02:00034C86 19430604        	  2593:     move.b  D3,($0604,A4)
02:00034C8A 7602            	  2594:     moveq   #2,D3
                            	  2595:     even
                            	  2596: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034C8C 41EC0422        	  2597:     lea     ($0422,A4),A0
02:00034C90 10303000        	  2598:     move.b  (A0,D3.W),D0
02:00034C94 41EC0302        	  2599:     lea     ($0302,A4),A0
02:00034C98 11803000        	  2600:     move.b  D0,(A0,D3.W)
02:00034C9C 5303            	  2601:     subq.b  #1,D3
02:00034C9E 6AEC            	  2602:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034CA0 19430306        	  2603:     move.b  D3,($0306,A4)
02:00034CA4 7400            	  2604:     moveq   #0,D2
02:00034CA6 142C0421        	  2605:     move.b  ($0421,A4),D2
02:00034CAA 7600            	  2606:     moveq   #0,D3
02:00034CAC 162C041F        	  2607:     move.b  ($041F,A4),D3
02:00034CB0 41F9000345EA    	  2608:     lea     (ModeE_CharMap).l,A0
02:00034CB6 10303000        	  2609:     move.b  (A0,D3.W),D0
02:00034CBA 19400305        	  2610:     move.b  D0,($0305,A4)
02:00034CBE 41EC0638        	  2611:     lea     ($0638,A4),A0
02:00034CC2 11802000        	  2612:     move.b  D0,(A0,D2.W)
                            	  2613:     even
                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034CC6 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034CCA 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034CCE 123C0008        	  2617:     move.b  #$08,D1
02:00034CD2 D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034CD4 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034CD8 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034CDC 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034CE0 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034CE4 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034CE8 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034CEA 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034CEE 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
02:00034CF2 123C0008        	  2645:     move.b  #$08,D1
02:00034CF6 0A3C0010        	  2646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034CFA 9101            	  2647:     subx.b  D1,D0   ; SBC #$08
02:00034CFC 0A3C0010        	  2648:     eori    #$10,CCR  ; restore X = 6502 C
02:00034D00 19400423        	  2649:     move.b  D0,($0423,A4)
                            	  2650:     ; It also means that we went past the end of the save slot
                            	  2651:     ; info name. Set the offset to the beginning of the name.
02:00034D04 7600            	  2652:     moveq   #0,D3
02:00034D06 162C0016        	  2653:     move.b  ($0016,A4),D3
02:00034D0A 41F900034646    	  2654:     lea     (SlotToNameOffset).l,A0
02:00034D10 10303000        	  2655:     move.b  (A0,D3.W),D0
02:00034D14 19400421        	  2656:     move.b  D0,($0421,A4)
                            	  2657:     ; If the name cursor has gone past the end of the field,
                            	  2658:     ; then wrap around.
02:00034D18 102C0070        	  2659:     move.b  ($0070,A4),D0
02:00034D1C 0C0000B0        	  2660:     cmpi.b  #$B0,D0
02:00034D20 6640            	  2661:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034D22 7070            	  2662:     moveq   #112,D0
02:00034D24 19400070        	  2663:     move.b  D0,($0070,A4)
                            	  2664:     even
                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034D28 7600            	  2672:     moveq   #0,D3
02:00034D2A 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034D2E 41F900034646    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034D34 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034D38 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034D3C B001            	  2677:     cmp.b   D1,D0
02:00034D3E 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034D40 5300            	  2679:     subq.b  #1,D0
02:00034D42 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034D46 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034D4A 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034D4E 5101            	  2683:     subi.b  #8,D1
02:00034D50 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034D54 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034D56 7600            	  2686:     moveq   #0,D3
02:00034D58 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034D5A 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034D5E 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2691:     even
                            	  2692: _L_z02_ModeE_HandleAOrB_Exit:
02:00034D62 60000096        	  2693:     jmp     ModeE_SetNameCursorSpriteX
                            	  2694: 
