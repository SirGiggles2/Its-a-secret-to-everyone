02:0004D748 0C0000FF        	  7585:     cmpi.b  #$FF,D0
02:0004D74C 662E            	  7586:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D74E 41EC0070        	  7587:     lea     ($0070,A4),A0
02:0004D752 10302000        	  7588:     move.b  (A0,D2.W),D0
