                            	  1676: AnimateDemoPhase0Subphase1:
02:0003436E 102C0438        	  1677:     move.b  ($0438,A4),D0
02:00034372 666C            	  1678:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1679:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1680:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1681:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00034374 7000            	  1682:     moveq   #0,D0
02:00034376 102C0437        	  1683:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:0003437A EB48            	  1684:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:0003437C 41F90003415E    	  1685:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00034382 D0C0            	  1686:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1687:     ; Set up DynTileBuf header: $3F, $00, $20
02:00034384 197C003F0302    	  1688:     move.b  #$3F,($0302,A4)
02:0003438A 197C00000303    	  1689:     move.b  #$00,($0303,A4)
02:00034390 7020            	  1690:     moveq   #32,D0
02:00034392 19400304        	  1691:     move.b  D0,($0304,A4)
                            	  1692:     ; End marker at DynTileBuf+4+31
02:00034396 761F            	  1693:     moveq   #31,D3
02:00034398 103C00FF        	  1694:     move.b  #$FF,D0
02:0003439C 43EC0306        	  1695:     lea     ($0306,A4),A1
02:000343A0 13803000        	  1696:     move.b  D0,(A1,D3.W)
                            	  1697:     even
                            	  1698: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:000343A4 10303000        	  1699:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:000343A8 43EC0305        	  1700:     lea     ($0305,A4),A1
02:000343AC 13803000        	  1701:     move.b  D0,(A1,D3.W)
02:000343B0 5303            	  1702:     subq.b  #1,D3
02:000343B2 6AF0            	  1703:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1704:     ; Advance the subphase cycle.
                            	  1705:     ;
02:000343B4 522C0437        	  1706:     addq.b  #1,($0437,A4)
                            	  1707:     ; Set the timer to the delay for the current point in the cycle.
                            	  1708:     ;
02:000343B8 7600            	  1709:     moveq   #0,D3
02:000343BA 162C0437        	  1710:     move.b  ($0437,A4),D3
02:000343BE 41F90003435D    	  1711:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:000343C4 10303000        	  1712:     move.b  (A0,D3.W),D0
02:000343C8 19400438        	  1713:     move.b  D0,($0438,A4)
02:000343CC 0C03000E        	  1714:     cmpi.b  #$0E,D3
02:000343D0 650E            	  1715:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1716:     ; Advance to the next demo phase.
                            	  1717:     ;
02:000343D2 522C042C        	  1718:     addq.b  #1,($042C,A4)
02:000343D6 7000            	  1719:     moveq   #0,D0
02:000343D8 1940042D        	  1720:     move.b  D0,($042D,A4)
02:000343DC 19400011        	  1721:     move.b  D0,($0011,A4)
                            	  1722:     even
