02:0003F580 9101            	 13252:     subx.b  D1,D0   ; SBC Ganon_ObjCloudDist,X
02:0003F582 0A3C0010        	 13253:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F586 1880            	 13254:     move.b  D0,($0000,A4)
