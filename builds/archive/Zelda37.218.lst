                            	   440: _anon_z05_3:
                            	   441:     ; If Start was pressed, then hide all sprites except
                            	   442:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   443:     ;
02:00040356 102C00F8        	   444:     move.b  ($00F8,A4),D0
02:0004035A 02000010        	   445:     andi.b #$10,D0
02:0004035E 6606            	   446:     bne.s  __far_z_05_0003
02:00040360 4EF90002CF42    	   447:     jmp  Exit
                            	   448: __far_z_05_0003:
02:00040366 102C0254        	   449:     move.b  ($0254,A4),D0
02:0004036A 1B00            	   450:     move.b  D0,-(A5)  ; PHA
02:0004036C 102C0258        	   451:     move.b  ($0258,A4),D0
02:00040370 1B00            	   452:     move.b  D0,-(A5)  ; PHA
02:00040372 4EB90004ACF2    	   453:     jsr     HideAllSprites
02:00040378 101D            	   454:     move.b  (A5)+,D0  ; PLA
02:0004037A 19400258        	   455:     move.b  D0,($0258,A4)
02:0004037E 101D            	   456:     move.b  (A5)+,D0  ; PLA
02:00040380 19400254        	   457:     move.b  D0,($0254,A4)
02:00040384 522C00E1        	   458:     addq.b  #1,($00E1,A4)
02:00040388 0A3C0001        	   459:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004038C 4E75            	   460:     rts
                            	   461: 
                            	   462:     even
                            	   463: UpdateMenuScrollUp:
                            	   464:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   465:     ;
02:0004038E 103C00FD        	   466:     move.b  #$FD,D0
02:00040392 613A            	   467:     jsr     MovePositionMarkers
02:00040394 102C00FC        	   468:     move.b  ($00FC,A4),D0
02:00040398 023C00EE        	   469:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004039C 123C0003        	   470:     move.b  #$03,D1
02:000403A0 D101            	   471:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000403A2 194000FC        	   472:     move.b  D0,($00FC,A4)
                            	   473:     ; If hardware vertical scroll still < $F0, then return.
                            	   474:     ;
02:000403A6 0C0000F0        	   475:     cmpi.b  #$F0,D0
02:000403AA 6406            	   476:     bcc.s  __far_z_05_0004
02:000403AC 4EF90002CF42    	   477:     jmp  Exit
                            	   478: __far_z_05_0004:
                            	   479:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   480:     ;
02:000403B2 1940005C        	   481:     move.b  D0,($005C,A4)
                            	   482:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   483:     ;
                            	   484:     ; UNKNOWN: But why not do this in OW, too?
                            	   485:     ;
02:000403B6 102C0010        	   486:     move.b  ($0010,A4),D0
02:000403BA 6706            	   487:     beq  _anon_z05_4
02:000403BC 4EB9000312F8    	   488:     jsr     WriteBlankPrioritySprites
                            	   489: _anon_z05_4:
                            	   490:     ; We reached the end. So, reset hardware vertical scroll
                            	   491:     ; and submenu state.
                            	   492:     ;
02:000403C2 7000            	   493:     moveq   #0,D0
02:000403C4 194000FC        	   494:     move.b  D0,($00FC,A4)
02:000403C8 194000E1        	   495:     move.b  D0,($00E1,A4)
                            	   496:     ; Move the position markers 2 pixels down, because we
                            	   497:     ; overshot and reached vertical scroll $F2.
                            	   498:     ;
02:000403CC 7002            	   499:     moveq   #2,D0
                            	   500: ; Params:
                            	   501: ; A: vertical velocity of menu scrolling
                            	   502: ;
                            	   503: ;
                            	   504: ; [00] holds the vertical velocity of menu scrolling.
                            	   505:     even
                            	   506: MovePositionMarkers:
02:000403CE 1880            	   507:     move.b  D0,($0000,A4)
                            	   508:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   509:     ;
02:000403D0 102C0254        	   510:     move.b  ($0254,A4),D0
02:000403D4 0C0000F8        	   511:     cmpi.b  #$F8,D0
02:000403D8 670C            	   512:     beq  _anon_z05_5
02:000403DA 023C00EE        	   513:     andi    #$EE,CCR  ; CLC: clear C+X
02:000403DE 1214            	   514:     move.b  ($0000,A4),D1
02:000403E0 D101            	   515:     addx.b  D1,D0   ; ADC $00
02:000403E2 19400254        	   516:     move.b  D0,($0254,A4)
                            	   517: _anon_z05_5:
                            	   518:     ; If in UW and have the compass, then move the triforce position marker.
