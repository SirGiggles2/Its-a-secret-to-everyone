02:0004C540 4EB900030A38    	  5145:     jsr     GetOppositeDir
02:0004C546 102C0015        	  5146:     move.b  ($0015,A4),D0
02:0004C54A 02000003        	  5147:     andi.b #$03,D0
02:0004C54E 41F90004C80A    	  5148:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004C554 12303000        	  5149:     move.b  (A0,D3.W),D1
02:0004C558 8001            	  5150:     or.b  D1,D0
02:0004C55A 4EB9000318F4    	  5151:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5152:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  5153:     ;
02:0004C560 41F90004C806    	  5154:     lea     (RDirectionToWeaponFrame).l,A0
02:0004C566 10303000        	  5155:     move.b  (A0,D3.W),D0
02:0004C56A 1940000C        	  5156:     move.b  D0,($000C,A4)
                            	  5157:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  5158:     ;
02:0004C56E 0C030002        	  5159:     cmpi.b  #$02,D3
02:0004C572 6604            	  5160:     bne  _anon_z07_24
02:0004C574 522C000F        	  5161:     addq.b  #1,($000F,A4)
                            	  5162: _anon_z07_24:
                            	  5163:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  5164:     ;   $57 (sword shot) => $22
                            	  5165:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  5166:     ;
02:0004C578 7622            	  5167:     moveq   #34,D3
02:0004C57A 0C02000D        	  5168:     cmpi.b  #$0D,D2
02:0004C57E 6410            	  5169:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004C580 41EC034F        	  5170:     lea     ($034F,A4),A0
02:0004C584 10302000        	  5171:     move.b  (A0,D2.W),D0
02:0004C588 0C000057        	  5172:     cmpi.b  #$57,D0
02:0004C58C 6710            	  5173:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004C58E 660C            	  5174:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  5175:     even
                            	  5176: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  5177:     ; But if the player shot it, the choice depends on the shot's state.
                            	  5178:     ;   high bit set (magic)   => $23
                            	  5179:     ;   high bit clear (sword) => $22
                            	  5180:     ;
02:0004C590 41EC00AC        	  5181:     lea     ($00AC,A4),A0
02:0004C594 10302000        	  5182:     move.b  (A0,D2.W),D0
02:0004C598 E308            	  5183:     lsl.b  #1,D0   ; ASL A
02:0004C59A 6402            	  5184:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  5185:     even
