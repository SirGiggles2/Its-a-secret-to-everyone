02:0004C5B0 60000082        	  5203:     jmp  SetShotSpreadingState
                            	  5204: __far_z_07_0078:
                            	  5205:     ; This is a magic shot.
                            	  5206:     ;
                            	  5207:     ; If missing the magic book, go deactivate the shot object.
                            	  5208:     ;
02:0004C5B4 102C0661        	  5209:     move.b  ($0661,A4),D0
02:0004C5B8 6602            	  5210:     bne.s  __far_z_07_0079
02:0004C5BA 6072            	  5211:     jmp  DeactivateShot
                            	  5212: __far_z_07_0079:
                            	  5213:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5214:     ; unused, so it only has to depend on having an empty slot.
                            	  5215:     ;
                            	  5216:     ; If successful, Link's state will have been changed to "using item".
                            	  5217:     ; But we don't want that in this case.
                            	  5218:     ;
                            	  5219:     ; For both these reasons, save state and restore it afterward.
                            	  5220:     ;
02:0004C5BC 102C00AC        	  5221:     move.b  ($00AC,A4),D0
02:0004C5C0 1B00            	  5222:     move.b  D0,-(A5)  ; PHA
02:0004C5C2 102C0513        	  5223:     move.b  ($0513,A4),D0
02:0004C5C6 1B00            	  5224:     move.b  D0,-(A5)  ; PHA
02:0004C5C8 7000            	  5225:     moveq   #0,D0
02:0004C5CA 19400513        	  5226:     move.b  D0,($0513,A4)
02:0004C5CE 4EB900030C82    	  5227:     jsr     WieldCandle
02:0004C5D4 101D            	  5228:     move.b  (A5)+,D0  ; PLA
02:0004C5D6 19400513        	  5229:     move.b  D0,($0513,A4)
02:0004C5DA 101D            	  5230:     move.b  (A5)+,D0  ; PLA
02:0004C5DC 194000AC        	  5231:     move.b  D0,($00AC,A4)
                            	  5232:     ; State $21 means that a moving fire was just made.
                            	  5233:     ;
                            	  5234:     ; If it's any another value, then we didn't find an empty slot
                            	  5235:     ; to make a fire. In this case, all that's left to do is to go
                            	  5236:     ; deactivate the shot object.
                            	  5237:     ;
02:0004C5E0 41EC00AC        	  5238:     lea     ($00AC,A4),A0
02:0004C5E4 10302000        	  5239:     move.b  (A0,D2.W),D0
02:0004C5E8 0C000021        	  5240:     cmpi.b  #$21,D0
02:0004C5EC 6702            	  5241:     beq.s  __far_z_07_0080
02:0004C5EE 6038            	  5242:     jmp  DeactivateLinkShot
                            	  5243: __far_z_07_0080:
                            	  5244:     ; Make state $22 for a standing fire.
                            	  5245:     ;
02:0004C5F0 41EC00AC        	  5246:     lea     ($00AC,A4),A0
02:0004C5F4 52302000        	  5247:     addq.b  #1,(A0,D2.W)
                            	  5248:     ; Copy the shot's position and direction to the fire.
                            	  5249:     ;
02:0004C5F8 760E            	  5250:     moveq   #14,D3
02:0004C5FA 10343070        	  5251:     move.b  ($70,A4,D3.W),D0
02:0004C5FE 19802070        	  5252:     move.b  D0,($70,A4,D2.W)
02:0004C602 41EC0084        	  5253:     lea     ($0084,A4),A0
02:0004C606 10303000        	  5254:     move.b  (A0,D3.W),D0
02:0004C60A 41EC0084        	  5255:     lea     ($0084,A4),A0
02:0004C60E 11802000        	  5256:     move.b  D0,(A0,D2.W)
02:0004C612 41EC0098        	  5257:     lea     ($0098,A4),A0
02:0004C616 10303000        	  5258:     move.b  (A0,D3.W),D0
02:0004C61A 41EC0098        	  5259:     lea     ($0098,A4),A0
02:0004C61E 11802000        	  5260:     move.b  D0,(A0,D2.W)
                            	  5261:     ; The fire lasts $4F frames.
                            	  5262:     ; Deactivate the shot.
                            	  5263:     ;
02:0004C622 704F            	  5264:     moveq   #79,D0
02:0004C624 19802028        	  5265:     move.b  D0,($28,A4,D2.W)
                            	  5266:     even
