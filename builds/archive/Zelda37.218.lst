02:00041C46 122C0001        	  3238:     move.b  ($0001,A4),D1
02:00041C4A C001            	  3239:     and.b  D1,D0
02:00041C4C 194000F8        	  3240:     move.b  D0,($00F8,A4)
                            	  3241:     ; If in OW or button mask <> 0, return.
                            	  3242:     ;
02:00041C50 102C0010        	  3243:     move.b  ($0010,A4),D0
