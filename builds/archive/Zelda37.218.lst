02:00034BF6 5202            	  2514:     addq.b  #1,D2
02:00034BF8 41F90003463C    	  2515:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
02:00034BFE 12302000        	  2516:     move.b  (A0,D2.W),D1
