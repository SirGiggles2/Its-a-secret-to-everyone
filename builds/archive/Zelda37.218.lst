                            	  2772: _L_z02_ModeEandF_WriteCharBoardCursorSpritePosition_WriteCursorCoords:
02:00034E18 102C0085        	  2773:     move.b  ($0085,A4),D0
02:00034E1C 610E            	  2774:     jsr     ModifyFlashingCursorY
02:00034E1E 19430208        	  2775:     move.b  D3,($0208,A4)
02:00034E22 102C0071        	  2776:     move.b  ($0071,A4),D0
02:00034E26 1940020B        	  2777:     move.b  D0,($020B,A4)
02:00034E2A 4E75            	  2778:     rts
                            	  2779: 
                            	  2780: ; Params:
                            	  2781: ; A: cursor Y
                            	  2782: ;
                            	  2783: ; Returns:
                            	  2784: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2785: ;
                            	  2786: ; Description:
                            	  2787: ; Adjust the Y coordinate to account for the visible part of
                            	  2788: ; block cursor being in the bottom half of sprite.
                            	  2789: ; Also, make the cursor flash.
                            	  2790: ;
                            	  2791:     even
                            	  2792: ModifyFlashingCursorY:
02:00034E2C 003C0011        	  2793:     ori     #$11,CCR  ; SEC: set C+X
02:00034E30 123C0008        	  2794:     move.b  #$08,D1
02:00034E34 0A3C0010        	  2795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E38 9101            	  2796:     subx.b  D1,D0   ; SBC #$08
02:00034E3A 0A3C0010        	  2797:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E3E 7600            	  2798:     moveq   #0,D3
02:00034E40 1600            	  2799:     move.b  D0,D3
02:00034E42 102C0015        	  2800:     move.b  ($0015,A4),D0
02:00034E46 02000008        	  2801:     andi.b #$08,D0
02:00034E4A 6604            	  2802:     bne  _anon_z02_13
02:00034E4C 163C00F8        	  2803:     move.b  #$F8,D3
