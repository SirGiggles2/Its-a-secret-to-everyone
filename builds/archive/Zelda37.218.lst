                            	   558: UpdateMenuStartOW:
                            	   559:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   560:     ; make it look completely empty, and no piece has been won.
                            	   561:     ;
02:00040458 7617            	   562:     moveq   #23,D3
                            	   563: _anon_z05_6:
02:0004045A 7400            	   564:     moveq   #0,D2
02:0004045C 41F900040410    	   565:     lea     (TriforceTransferBufOffsets).l,A0
02:00040462 14303000        	   566:     move.b  (A0,D3.W),D2
02:00040466 41F900040440    	   567:     lea     (TriforceTransferBufTiles).l,A0
02:0004046C 10303000        	   568:     move.b  (A0,D3.W),D0
02:00040470 41F9000477F8    	   569:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040476 11802000        	   570:     move.b  D0,(A0,D2.W)
02:0004047A 5303            	   571:     subq.b  #1,D3
02:0004047C 6ADC            	   572:     bpl  _anon_z05_6
                            	   573:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   574:     ;
02:0004047E 5203            	   575:     addq.b  #1,D3
                            	   576:     ; Outer loop.
                            	   577:     ; A level test bit in [06] will be used to see whether
                            	   578:     ; we have a triforce piece.
                            	   579:     ;
02:00040480 7001            	   580:     moveq   #1,D0
02:00040482 19400006        	   581:     move.b  D0,($0006,A4)
                            	   582:     even
                            	   583: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   584:     ; Inner loop.
                            	   585:     ; Each level bit will make 3 triforce tile slots be
                            	   586:     ; checked and replaced.
                            	   587:     ;
02:00040486 7003            	   588:     moveq   #3,D0
02:00040488 19400007        	   589:     move.b  D0,($0007,A4)
                            	   590:     even
                            	   591: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   592:     ; Get the offset into the submenu triforce transfer buffers of
                            	   593:     ; the current tile slot.
                            	   594:     ;
02:0004048C 7400            	   595:     moveq   #0,D2
02:0004048E 41F900040410    	   596:     lea     (TriforceTransferBufOffsets).l,A0
02:00040494 14303000        	   597:     move.b  (A0,D3.W),D2
                            	   598:     ; If the level test bit is not in the triforce mask, then we don't
                            	   599:     ; have this piece. So, go loop again, and leave the tile in the
                            	   600:     ; empty state.
                            	   601:     ;
                            	   602:     ;
                            	   603:     ; [06] level test mask
02:00040498 102C0006        	   604:     move.b  ($0006,A4),D0
02:0004049C 122C0671        	   605:     move.b  ($0671,A4),D1
02:000404A0 C200            	   606:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000404A2 6730            	   607:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   608:     ; We have the triforce piece.
                            	   609:     ;
                            	   610:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   611:     ; then make it $F5. These are tiles that were half full, and now
                            	   612:     ; need to be full.
                            	   613:     ;
                            	   614:     ; Else replace it with the one at the current triforce tile slot
                            	   615:     ; in the replacement list.
                            	   616:     ;
02:000404A4 41F9000477F8    	   617:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000404AA 10302000        	   618:     move.b  (A0,D2.W),D0
02:000404AE 0C0000E5        	   619:     cmpi.b  #$E5,D0
02:000404B2 6712            	   620:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000404B4 0C0000E6        	   621:     cmpi.b  #$E6,D0
02:000404B8 670C            	   622:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000404BA 41F900040428    	   623:     lea     (TriforceTriforceBufReplacements).l,A0
02:000404C0 10303000        	   624:     move.b  (A0,D3.W),D0
02:000404C4 6004            	   625:     jmp     _anon_z05_7
                            	   626: 
                            	   627:     even
                            	   628: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:000404C6 103C00F5        	   629:     move.b  #$F5,D0
                            	   630: _anon_z05_7:
02:000404CA 41F9000477F8    	   631:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000404D0 11802000        	   632:     move.b  D0,(A0,D2.W)
                            	   633:     even
                            	   634: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   635:     ; Bottom of the inner loop.
                            	   636:     ;
                            	   637:     ; Increment the triforce tile slot.
                            	   638:     ; Decrement [07] and loop again, if it's not 0.
                            	   639:     ;
02:000404D4 5203            	   640:     addq.b  #1,D3
02:000404D6 532C0007        	   641:     subq.b  #1,($0007,A4)
02:000404DA 66B0            	   642:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   643:     ; Bottom of the outer loop.
                            	   644:     ;
                            	   645:     ; Shift the level test bit [06] left to test the next level.
                            	   646:     ; When it becomes 0, we're done.
                            	   647:     ;
02:000404DC 122C0006        	   648:     move.b  ($0006,A4),D1
02:000404E0 E309            	   649:     lsl.b  #1,D1   ; ASL $06
02:000404E2 19410006        	   650:     move.b  D1,($0006,A4)
02:000404E6 669E            	   651:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:000404E8 522C00E1        	   652:     addq.b  #1,($00E1,A4)
02:000404EC 4E75            	   653:     rts
                            	   654: 
                            	   655:     even
                            	   656: ScrollWorld:
02:000404EE 102C0015        	   657:     move.b  ($0015,A4),D0
                            	   658:     ; The purpose of this is to delay vertical scrolling.
                            	   659:     ; OW: once every two frames
                            	   660:     ; UW: once every four frames
                            	   661:     ; Horizontal scrolling happens every frame.
