02:0003C2FA 52302000        	  6417:     addq.b  #1,(A0,D2.W)
02:0003C2FE 41EC0478        	  6418:     lea     ($0478,A4),A0
02:0003C302 10302000        	  6419:     move.b  (A0,D2.W),D0
02:0003C306 0C000004        	  6420:     cmpi.b  #$04,D0
02:0003C30A 659E            	  6421:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
