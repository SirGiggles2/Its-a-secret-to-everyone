                            	  6006: Moldorm_Chase:
                            	  6007:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6008:     ; Only the head controls the movement direction.
                            	  6009:     ;
02:0003C094 0C020005        	  6010:     cmpi.b  #$05,D2
02:0003C098 670A            	  6011:     beq  _anon_z04_81
