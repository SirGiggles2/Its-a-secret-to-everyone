                            	  1980: _L_z04_UpdateStatues_Shoot:
                            	  1981:     ; Look for an empty monster slot.
                            	  1982:     ; If none is found, return.
                            	  1983:     ;
                            	  1984:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1985:     ; object. This routine takes a shooter object, and instantiates
                            	  1986:     ; a fireball object at the shooter's location.
                            	  1987:     ;
                            	  1988:     ; The object slot we set up here will behave as the shooter.
                            	  1989:     ; For each fireball index, this object slot will have its coordinates
                            	  1990:     ; changed.
                            	  1991:     ;
                            	  1992:     ; Note that this means that:
                            	  1993:     ; 1. The first fireball made will be its own shooter.
                            	  1994:     ;    Practically, there's nothing special about this.
                            	  1995:     ; 2. If there is more than one fireball made in a frame,
                            	  1996:     ;    then two of them will come from the same statue.
                            	  1997:     ;
                            	  1998:     ;
                            	  1999:     ; Save the fireball pattern.
02:0003A3E0 1003            	  2000:     move.b  D3,D0
02:0003A3E2 1B00            	  2001:     move.b  D0,-(A5)  ; PHA
02:0003A3E4 4EB90004DB34    	  2002:     jsr     FindEmptyMonsterSlot
02:0003A3EA 0C000001        	  2003:     cmpi.b  #$01,D0
02:0003A3EE 101D            	  2004:     move.b  (A5)+,D0  ; PLA
02:0003A3F0 6400010A        	  2005:     bcc  _L_z04_UpdateStatues_Exit
                            	  2006:     ; If we found a slot, but it < 6, return.
                            	  2007:     ;
02:0003A3F4 0C030006        	  2008:     cmpi.b  #$06,D3
02:0003A3F8 65000102        	  2009:     bcs  _L_z04_UpdateStatues_Exit
                            	  2010:     ; Store the object slot in [0A].
                            	  2011:     ; Store fireball pattern in [0B].
                            	  2012:     ;
02:0003A3FC 1943000A        	  2013:     move.b  D3,($000A,A4)
02:0003A400 1940000B        	  2014:     move.b  D0,($000B,A4)
                            	  2015:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  2016:     ;
02:0003A404 7600            	  2017:     moveq   #0,D3
02:0003A406 1600            	  2018:     move.b  D0,D3
02:0003A408 7400            	  2019:     moveq   #0,D2
02:0003A40A 41F90003A39C    	  2020:     lea     (StatueFireballCounts).l,A0
02:0003A410 14303000        	  2021:     move.b  (A0,D3.W),D2
                            	  2022:     even
                            	  2023: _L_z04_UpdateStatues_LoopFireball:
                            	  2024:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2025:     ;
                            	  2026:     ; Decrement the fireball timer at this index.
                            	  2027:     ;
02:0003A414 7600            	  2028:     moveq   #0,D3
02:0003A416 41EC04E8        	  2029:     lea     ($04E8,A4),A0
02:0003A41A 16302000        	  2030:     move.b  (A0,D2.W),D3
02:0003A41E 5303            	  2031:     subq.b  #1,D3
02:0003A420 1003            	  2032:     move.b  D3,D0
02:0003A422 41EC04E8        	  2033:     lea     ($04E8,A4),A0
02:0003A426 11802000        	  2034:     move.b  D0,(A0,D2.W)
                            	  2035:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2036:     ; to make a fireball. Go loop again.
                            	  2037:     ;
02:0003A42A 5203            	  2038:     addq.b  #1,D3
02:0003A42C 660000C8        	  2039:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2040:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2041:     ; This fireball index will wait another $100 frames.
                            	  2042:     ;
02:0003A430 10342018        	  2043:     move.b  ($18,A4,D2.W),D0
02:0003A434 0C0000F0        	  2044:     cmpi.b  #$F0,D0
02:0003A438 640000BC        	  2045:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2046:     ; Else choose one of four start times for the fireball based on
                            	  2047:     ; the random value.
                            	  2048:     ;
02:0003A43C 02000003        	  2049:     andi.b #$03,D0
02:0003A440 7600            	  2050:     moveq   #0,D3
02:0003A442 1600            	  2051:     move.b  D0,D3
02:0003A444 41F90003A3A0    	  2052:     lea     (StatueFireballStartTimes).l,A0
02:0003A44A 10303000        	  2053:     move.b  (A0,D3.W),D0
02:0003A44E 41EC04E8        	  2054:     lea     ($04E8,A4),A0
02:0003A452 11802000        	  2055:     move.b  D0,(A0,D2.W)
                            	  2056:     ; The coordinate lists are divided into sets for each pattern.
                            	  2057:     ;
                            	  2058:     ; Look up the index of the base of the set for the pattern in use.
                            	  2059:     ; Add it to the fireball index in X register to get the index of
                            	  2060:     ; the coordinate we want within each coordinate list.
                            	  2061:     ;
                            	  2062:     ;
                            	  2063:     ; Pattern
02:0003A456 7600            	  2064:     moveq   #0,D3
02:0003A458 162C000B        	  2065:     move.b  ($000B,A4),D3
02:0003A45C 1002            	  2066:     move.b  D2,D0
02:0003A45E 023C00EE        	  2067:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A462 41F90003A3A4    	  2068:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A468 12303000        	  2069:     move.b  (A0,D3.W),D1
02:0003A46C D101            	  2070:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A46E 7600            	  2071:     moveq   #0,D3
02:0003A470 1600            	  2072:     move.b  D0,D3
02:0003A472 1002            	  2073:     move.b  D2,D0
02:0003A474 1B00            	  2074:     move.b  D0,-(A5)  ; PHA
                            	  2075:     ; Get Link's coordinates into [00] and [01].
                            	  2076:     ;
02:0003A476 7400            	  2077:     moveq   #0,D2
02:0003A478 4EB90004D344    	  2078:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2079:     ; Switch to the new fireball's object slot.
                            	  2080:     ;
02:0003A47E 7400            	  2081:     moveq   #0,D2
02:0003A480 142C000A        	  2082:     move.b  ($000A,A4),D2
                            	  2083:     ; Look up and set the X coordinate for the fireball object.
                            	  2084:     ; Also store it in [02].
                            	  2085:     ;
02:0003A484 41F90003A3A8    	  2086:     lea     (StatueXs).l,A0
02:0003A48A 10303000        	  2087:     move.b  (A0,D3.W),D0
02:0003A48E 19400002        	  2088:     move.b  D0,($0002,A4)
02:0003A492 19802070        	  2089:     move.b  D0,($70,A4,D2.W)
                            	  2090:     ; Look up and set the Y coordinate for the fireball object.
                            	  2091:     ; Also store it in [03].
                            	  2092:     ;
02:0003A496 41F90003A3B0    	  2093:     lea     (StatueYs).l,A0
02:0003A49C 10303000        	  2094:     move.b  (A0,D3.W),D0
02:0003A4A0 19400003        	  2095:     move.b  D0,($0003,A4)
02:0003A4A4 41EC0084        	  2096:     lea     ($0084,A4),A0
02:0003A4A8 11802000        	  2097:     move.b  D0,(A0,D2.W)
                            	  2098:     ; Set mask value 3 in [04].
                            	  2099:     ;
02:0003A4AC 7003            	  2100:     moveq   #3,D0
02:0003A4AE 19400004        	  2101:     move.b  D0,($0004,A4)
                            	  2102:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2103:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2104:     ;
02:0003A4B2 7601            	  2105:     moveq   #1,D3
                            	  2106:     even
                            	  2107: _L_z04_UpdateStatues_LoopAxis:
02:0003A4B4 10343000        	  2108:     move.b  ($00,A4,D3.W),D0
02:0003A4B8 003C0011        	  2109:     ori     #$11,CCR  ; SEC: set C+X
02:0003A4BC 12343002        	  2110:     move.b  ($02,A4,D3.W),D1
02:0003A4C0 0A3C0010        	  2111:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A4C4 9101            	  2112:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A4C6 0A3C0010        	  2113:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A4CA 0C000018        	  2114:     cmpi.b  #$18,D0
02:0003A4CE 6A10            	  2115:     bpl  _anon_z04_31
02:0003A4D0 0C0000E8        	  2116:     cmpi.b  #$E8,D0
02:0003A4D4 6B0A            	  2117:     bmi  _anon_z04_31
02:0003A4D6 122C0004        	  2118:     move.b  ($0004,A4),D1
02:0003A4DA E209            	  2119:     lsr.b  #1,D1   ; LSR $04
02:0003A4DC 19410004        	  2120:     move.b  D1,($0004,A4)
                            	  2121: _anon_z04_31:
02:0003A4E0 5303            	  2122:     subq.b  #1,D3
02:0003A4E2 6AD0            	  2123:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2124:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2125:     ; 0 or 1 time, instead of 2.
                            	  2126:     ;
                            	  2127:     ; This, in turn, means that the distance between Link and the
                            	  2128:     ; fireball was >= $18 in at least one axis.
                            	  2129:     ;
                            	  2130:     ; So, we're OK to finish making the fireball.
                            	  2131:     ;
02:0003A4E4 102C0004        	  2132:     move.b  ($0004,A4),D0
02:0003A4E8 6706            	  2133:     beq  _anon_z04_32
02:0003A4EA 7055            	  2134:     moveq   #85,D0
02:0003A4EC 6100F794        	  2135:     jsr     ShootFireball
                            	  2136: _anon_z04_32:
02:0003A4F0 101D            	  2137:     move.b  (A5)+,D0  ; PLA
02:0003A4F2 7400            	  2138:     moveq   #0,D2
02:0003A4F4 1400            	  2139:     move.b  D0,D2
                            	  2140:     even
                            	  2141: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2142:     ; Bottom of the loop.
                            	  2143:     ; Loop while fireball index >= 0.
                            	  2144:     ;
02:0003A4F6 5302            	  2145:     subq.b  #1,D2
02:0003A4F8 6A00FF1A        	  2146:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2147:     even
