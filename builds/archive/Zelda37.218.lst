                            	  8007:     ; If secret color cycle >= $C, return.
                            	  8008:     ;
02:0004DB66 7600            	  8009:     moveq   #0,D3
02:0004DB68 162C051A        	  8010:     move.b  ($051A,A4),D3
02:0004DB6C 0C03000C        	  8011:     cmpi.b  #$0C,D3
02:0004DB70 6502            	  8012:     bcs.s  __far_z_07_0128
