02:0004CBBE 6602            	  6084:     bne.s  __far_z_07_0093
02:0004CBC0 6014            	  6085:     jmp  CalcBoomerangFrame
                            	  6086: __far_z_07_0093:
02:0004CBC2 7003            	  6087:     moveq   #3,D0
02:0004CBC4 41EC03D0        	  6088:     lea     ($03D0,A4),A0
02:0004CBC8 11802000        	  6089:     move.b  D0,(A0,D2.W)
02:0004CBCC 7020            	  6090:     moveq   #32,D0
02:0004CBCE 41EC00AC        	  6091:     lea     ($00AC,A4),A0
02:0004CBD2 11802000        	  6092:     move.b  D0,(A0,D2.W)
                            	  6093:     even
                            	  6094: CalcBoomerangFrame:
                            	  6095:     ; The minor state (low 3 bits of state) is used to
                            	  6096:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  6097:     ;
                            	  6098:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  6099:     ; In other words, don't offset the coordinate below.
                            	  6100:     ;
02:0004CBD6 7000            	  6101:     moveq   #0,D0
02:0004CBD8 1880            	  6102:     move.b  D0,($0000,A4)
02:0004CBDA 41EC00AC        	  6103:     lea     ($00AC,A4),A0
02:0004CBDE 10302000        	  6104:     move.b  (A0,D2.W),D0
02:0004CBE2 0200000F        	  6105:     andi.b #$0F,D0
02:0004CBE6 7600            	  6106:     moveq   #0,D3
02:0004CBE8 1600            	  6107:     move.b  D0,D3
02:0004CBEA 7000            	  6108:     moveq   #0,D0
02:0004CBEC 19400001        	  6109:     move.b  D0,($0001,A4)
02:0004CBF0 41F90004C7DE    	  6110:     lea     (BoomerangFrameCycle).l,A0
02:0004CBF6 10303000        	  6111:     move.b  (A0,D3.W),D0
02:0004CBFA 1940000C        	  6112:     move.b  D0,($000C,A4)
                            	  6113:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  6114:     ;
02:0004CBFE 1003            	  6115:     move.b  D3,D0
02:0004CC00 41F90004C7E8    	  6116:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004CC06 10303000        	  6117:     move.b  (A0,D3.W),D0
02:0004CC0A 19400004        	  6118:     move.b  D0,($0004,A4)
                            	  6119:     ; TODO: ?
                            	  6120:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  6121:     ; Else add the item value of the magic boomerang.
                            	  6122:     ;
