                            	  4193: PondFairy_MoveHearts:
                            	  4194:     ; Loop over each heart from object slot 2 to 9.
                            	  4195:     ;
                            	  4196:     ; Even though they are not standalone objects, their info
                            	  4197:     ; is stored in those object slots.
                            	  4198:     ;
02:0003B2DA 7402            	  4199:     moveq   #2,D2
                            	  4200:     even
                            	  4201: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4202:     ; If the current heart's state <> 0, then go move it.
                            	  4203:     ; Else we have to wait for it to come out at the right time.
                            	  4204:     ;
02:0003B2DC 41EC00AC        	  4205:     lea     ($00AC,A4),A0
02:0003B2E0 10302000        	  4206:     move.b  (A0,D2.W),D0
02:0003B2E4 667C            	  4207:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4208:     ; The current heart's state = 0.
                            	  4209:     ;
                            	  4210:     ; If object slot = 2, then go make it appear. This is the first
                            	  4211:     ; heart to show up.
                            	  4212:     ;
02:0003B2E6 0C020002        	  4213:     cmpi.b  #$02,D2
02:0003B2EA 6732            	  4214:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4215:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4216:     ; go start over.
                            	  4217:     ;
                            	  4218:     ; TODO:
                            	  4219:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4220:     ;
02:0003B2EC 102C00AE        	  4221:     move.b  ($00AE,A4),D0
02:0003B2F0 67EA            	  4222:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4223:     ; Look up the starting angle of this heart with the index
                            	  4224:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4225:     ; then loop again.
                            	  4226:     ;
02:0003B2F2 1002            	  4227:     move.b  D2,D0
02:0003B2F4 003C0011        	  4228:     ori     #$11,CCR  ; SEC: set C+X
02:0003B2F8 123C0003        	  4229:     move.b  #$03,D1
02:0003B2FC 0A3C0010        	  4230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B300 9101            	  4231:     subx.b  D1,D0   ; SBC #$03
02:0003B302 0A3C0010        	  4232:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B306 7600            	  4233:     moveq   #0,D3
02:0003B308 1600            	  4234:     move.b  D0,D3
02:0003B30A 102C0396        	  4235:     move.b  ($0396,A4),D0
02:0003B30E 41F90003B2D2    	  4236:     lea     (PondHeartStartAngles).l,A0
02:0003B314 12303000        	  4237:     move.b  (A0,D3.W),D1
02:0003B318 B001            	  4238:     cmp.b   D1,D0
02:0003B31A 66000086        	  4239:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4240:     even
