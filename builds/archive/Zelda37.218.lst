02:0003EC98 10342070        	 11989:     move.b  ($70,A4,D2.W),D0
02:0003EC9C 1B00            	 11990:     move.b  D0,-(A5)  ; PHA
                            	 11991:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11992:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11993:     ;
02:0003EC9E 023C00EE        	 11994:     andi    #$EE,CCR  ; CLC: clear C+X
