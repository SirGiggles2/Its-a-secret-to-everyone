02:0003C56C 9101            	  6695:     subx.b  D1,D0   ; SBC $03
02:0003C56E 0A3C0010        	  6696:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C572 41EC0084        	  6697:     lea     ($0084,A4),A0
