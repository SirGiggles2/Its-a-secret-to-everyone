02:00043B4C 6602            	  6185:     bne.s  __far_z_05_0094
02:00043B4E 60C4            	  6186:     jmp  L165D4_Exit
                            	  6187: __far_z_05_0094:
                            	  6188:     ; Turn the door command into the desired open or closed state
                            	  6189:     ; to store in [08].
                            	  6190:     ;
                            	  6191:     ; cmd:  7 6 3 2 
                            	  6192:     ; [08]: 2 0 0 0
                            	  6193:     ;
                            	  6194:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6195:     ; commands intended to be used.
                            	  6196:     ;
                            	  6197:     ; 3 is the end state of 2: close
                            	  6198:     ; 7 is the end state of 6: open
                            	  6199:     ;
02:00043B50 02000007        	  6200:     andi.b #$07,D0
02:00043B54 7601            	  6201:     moveq   #1,D3
02:00043B56 19430002        	  6202:     move.b  D3,($0002,A4)
02:00043B5A 122C0002        	  6203:     move.b  ($0002,A4),D1
02:00043B5E C200            	  6204:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043B60 6702            	  6205:     beq  _anon_z05_118
02:00043B62 E208            	  6206:     lsr.b  #1,D0   ; LSR A
                            	  6207: _anon_z05_118:
02:00043B64 0C000002        	  6208:     cmpi.b  #$02,D0
02:00043B68 6606            	  6209:     bne  _anon_z05_119
                            	  6210:     ; Command 2 sets Link's timer to $30.
                            	  6211:     ;
02:00043B6A 7630            	  6212:     moveq   #48,D3
02:00043B6C 19430028        	  6213:     move.b  D3,($0028,A4)
                            	  6214: _anon_z05_119:
02:00043B70 02000003        	  6215:     andi.b #$03,D0
02:00043B74 003C0011        	  6216:     ori     #$11,CCR  ; SEC: set C+X
02:00043B78 123C0001        	  6217:     move.b  #$01,D1
02:00043B7C 0A3C0010        	  6218:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043B80 9101            	  6219:     subx.b  D1,D0   ; SBC #$01
02:00043B82 0A3C0010        	  6220:     eori    #$10,CCR  ; restore X = 6502 C
02:00043B86 02000002        	  6221:     andi.b #$02,D0
02:00043B8A 19400008        	  6222:     move.b  D0,($0008,A4)
                            	  6223:     ; The command to close a key door or bombable wall does not
                            	  6224:     ; do anything.
                            	  6225:     ;
02:00043B8E 102C0054        	  6226:     move.b  ($0054,A4),D0
02:00043B92 0C000005        	  6227:     cmpi.b  #$05,D0
02:00043B96 6416            	  6228:     bcc  _anon_z05_120
02:00043B98 102C0055        	  6229:     move.b  ($0055,A4),D0
02:00043B9C 19400002        	  6230:     move.b  D0,($0002,A4)
02:00043BA0 6100FAEC        	  6231:     jsr     FindDoorAttrByDoorBit
02:00043BA4 0C000007        	  6232:     cmpi.b  #$07,D0
02:00043BA8 6704            	  6233:     beq  _anon_z05_120
02:00043BAA 6000009C        	  6234:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  6235: 
                            	  6236: _anon_z05_120:
                            	  6237:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6238:     ;
                            	  6239:     ; Shutters and the commands to open a door always change
                            	  6240:     ; tiles.
                            	  6241:     ;
02:00043BAE 61000130        	  6242:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6243:     even
                            	  6244: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6245:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6246:     ; We need to remember how many tiles need to be copied
                            	  6247:     ; in each transfer record.
                            	  6248:     ;
02:00043BB2 102C0006        	  6249:     move.b  ($0006,A4),D0
02:00043BB6 19400004        	  6250:     move.b  D0,($0004,A4)
                            	  6251:     ; Write the transfer record header for the door.
                            	  6252:     ;
                            	  6253:     ;
                            	  6254:     ; VRAM address high byte of door
02:00043BBA 1014            	  6255:     move.b  ($0000,A4),D0
02:00043BBC 41EC0302        	  6256:     lea     ($0302,A4),A0
02:00043BC0 11802000        	  6257:     move.b  D0,(A0,D2.W)
02:00043BC4 5202            	  6258:     addq.b  #1,D2
02:00043BC6 102C0001        	  6259:     move.b  ($0001,A4),D0
02:00043BCA 41EC0302        	  6260:     lea     ($0302,A4),A0
02:00043BCE 11802000        	  6261:     move.b  D0,(A0,D2.W)
02:00043BD2 5202            	  6262:     addq.b  #1,D2
02:00043BD4 102C0006        	  6263:     move.b  ($0006,A4),D0
02:00043BD8 41EC0302        	  6264:     lea     ($0302,A4),A0
02:00043BDC 11802000        	  6265:     move.b  D0,(A0,D2.W)
02:00043BE0 5202            	  6266:     addq.b  #1,D2
                            	  6267: _anon_z05_121:
                            	  6268:     ; Write two tiles in a short loop indexed by [04].
                            	  6269:     ;
02:00043BE2 6100ED1C        	  6270:     jsr     WriteDoorFaceTileHorizontally
02:00043BE6 66FA            	  6271:     bne  _anon_z05_121
                            	  6272:     ; OR the low VRAM address with $20 to go down one row
                            	  6273:     ; in order to work on the second row of door tiles.
                            	  6274:     ;
02:00043BE8 7020            	  6275:     moveq   #32,D0
02:00043BEA 122C0001        	  6276:     move.b  ($0001,A4),D1
02:00043BEE 8001            	  6277:     or.b  D1,D0
02:00043BF0 19400001        	  6278:     move.b  D0,($0001,A4)
                            	  6279:     ; Bottom of the loop.
                            	  6280:     ; Loop again to write the second transfer record for the
                            	  6281:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6282:     ;
02:00043BF4 532C0005        	  6283:     subq.b  #1,($0005,A4)
02:00043BF8 66B8            	  6284:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6285:     ; Write the end marker, and update buffer length.
                            	  6286:     ;
02:00043BFA 103C00FF        	  6287:     move.b  #$FF,D0
02:00043BFE 41EC0302        	  6288:     lea     ($0302,A4),A0
02:00043C02 11802000        	  6289:     move.b  D0,(A0,D2.W)
02:00043C06 1002            	  6290:     move.b  D2,D0
02:00043C08 19400301        	  6291:     move.b  D0,($0301,A4)
                            	  6292:     ; Increment the command.
                            	  6293:     ;
02:00043C0C 522C0054        	  6294:     addq.b  #1,($0054,A4)
                            	  6295:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6296:     ; and resetting the door command.
                            	  6297:     ; This ends up catching original states 3 and 7.
                            	  6298:     ;
                            	  6299:     ; Else set door timer to 8 and return.
                            	  6300:     ;
02:00043C10 102C0054        	  6301:     move.b  ($0054,A4),D0
02:00043C14 02000003        	  6302:     andi.b #$03,D0
02:00043C18 6708            	  6303:     beq  _anon_z05_122
02:00043C1A 7008            	  6304:     moveq   #8,D0
02:00043C1C 19400027        	  6305:     move.b  D0,($0027,A4)
02:00043C20 4E75            	  6306:     rts
                            	  6307: 
                            	  6308: _anon_z05_122:
                            	  6309:     ; If the door command = 4 after incrementing it, then
                            	  6310:     ; it was 3 (close door). So:
                            	  6311:     ; 1. reset this door's flag
                            	  6312:     ; 2. remove it from the opened door mask
                            	  6313:     ; 3. reset the door command
                            	  6314:     ; 4. go lay out doors in the play area map
                            	  6315:     ;
02:00043C22 102C0054        	  6316:     move.b  ($0054,A4),D0
02:00043C26 0C000004        	  6317:     cmpi.b  #$04,D0
02:00043C2A 6626            	  6318:     bne  _anon_z05_123
02:00043C2C 7400            	  6319:     moveq   #0,D2
02:00043C2E 142C0009        	  6320:     move.b  ($0009,A4),D2
02:00043C32 6100DACE        	  6321:     jsr     ResetDoorFlag
02:00043C36 102C0055        	  6322:     move.b  ($0055,A4),D0
02:00043C3A 0A00000F        	  6323:     eori.b #$0F,D0
02:00043C3E 122C00EE        	  6324:     move.b  ($00EE,A4),D1
02:00043C42 C001            	  6325:     and.b  D1,D0
                            	  6326:     even
                            	  6327: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043C44 194000EE        	  6328:     move.b  D0,($00EE,A4)
                            	  6329:     even
                            	  6330: L_ResetDoorCmdAndLayOutDoors:
02:00043C48 7000            	  6331:     moveq   #0,D0
02:00043C4A 19400054        	  6332:     move.b  D0,($0054,A4)
02:00043C4E 6000FCD4        	  6333:     jmp     LayOutDoors
                            	  6334: 
                            	  6335: _anon_z05_123:
                            	  6336:     ; Door command <> 4.
                            	  6337:     ; It must be 8, which means it was 7: open door.
                            	  6338:     ;
                            	  6339:     ; If the door is a shutter (7), then go add the door to the
                            	  6340:     ; opened door mask, reset door command, and lay out doors.
                            	  6341:     ;
02:00043C52 102C0055        	  6342:     move.b  ($0055,A4),D0
02:00043C56 19400002        	  6343:     move.b  D0,($0002,A4)
02:00043C5A 6100FA32        	  6344:     jsr     FindDoorAttrByDoorBit
02:00043C5E 0C000007        	  6345:     cmpi.b  #$07,D0
02:00043C62 676E            	  6346:     beq  _anon_z05_124
                            	  6347:     ; Else the door is not a shutter.
                            	  6348:     ;
                            	  6349:     ;
                            	  6350:     ; [09] door direction index
02:00043C64 7400            	  6351:     moveq   #0,D2
02:00043C66 142C0009        	  6352:     move.b  ($0009,A4),D2
02:00043C6A 6100DA90        	  6353:     jsr     SetDoorFlag
                            	  6354:     ; Get the next room's ID.
                            	  6355:     ;
02:00043C6E 1003            	  6356:     move.b  D3,D0
02:00043C70 023C00EE        	  6357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043C74 41F900043B30    	  6358:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043C7A 12302000        	  6359:     move.b  (A0,D2.W),D1
02:00043C7E D101            	  6360:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043C80 7600            	  6361:     moveq   #0,D3
02:00043C82 1600            	  6362:     move.b  D0,D3
                            	  6363:     ; Flip the door direction index.
                            	  6364:     ;
02:00043C84 1002            	  6365:     move.b  D2,D0
02:00043C86 0A000001        	  6366:     eori.b #$01,D0
02:00043C8A 7400            	  6367:     moveq   #0,D2
02:00043C8C 1400            	  6368:     move.b  D0,D2
                            	  6369:     ; Set the door flag for the opposite door in the next room.
                            	  6370:     ;
02:00043C8E 1214            	  6371:     move.b  ($00,A4),D1   ; ptr lo
02:00043C90 182C0001        	  6372:     move.b  ($01,A4),D4  ; ptr hi
02:00043C94 024100FF        	  6373:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C98 E14C            	  6374:     lsl.w   #8,D4
02:00043C9A 8841            	  6375:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043C9C 48C4            	  6376:     ext.l   D4
02:00043C9E D8BC00FF0000    	  6377:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043CA4 2044            	  6378:     movea.l D4,A0
02:00043CA6 10303000        	  6379:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043CAA 41F90004AE96    	  6380:     lea     (LevelMasks).l,A0
02:00043CB0 12302000        	  6381:     move.b  (A0,D2.W),D1
02:00043CB4 8001            	  6382:     or.b  D1,D0
02:00043CB6 1214            	  6383:     move.b  ($00,A4),D1   ; ptr lo
02:00043CB8 182C0001        	  6384:     move.b  ($01,A4),D4  ; ptr hi
02:00043CBC 024100FF        	  6385:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043CC0 E14C            	  6386:     lsl.w   #8,D4
02:00043CC2 8841            	  6387:     or.w    D1,D4
02:00043CC4 48C4            	  6388:     ext.l   D4
02:00043CC6 D8BC00FF0000    	  6389:     add.l   #NES_RAM,D4
02:00043CCC 2044            	  6390:     movea.l D4,A0
02:00043CCE 11803000        	  6391:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6392: _anon_z05_124:
                            	  6393:     ; Add the door to the opened door mask, reset door command,
                            	  6394:     ; and lay out doors.
                            	  6395:     ;
02:00043CD2 102C0055        	  6396:     move.b  ($0055,A4),D0
02:00043CD6 122C00EE        	  6397:     move.b  ($00EE,A4),D1
02:00043CDA 8001            	  6398:     or.b  D1,D0
02:00043CDC 6000FF66        	  6399:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6400: 
                            	  6401: ; Params:
                            	  6402: ; [08]: 0 if closed
                            	  6403: ;
                            	  6404: ; Returns:
                            	  6405: ; X: current length of dynamic transfer buf
                            	  6406: ; [00]: door VRAM address high byte
                            	  6407: ; [01]: door VRAM address low byte
                            	  6408: ; [02:03]: address of door tiles for direction and face
                            	  6409: ; [05]: 2, the number of transfer records to write
                            	  6410: ; [06]: 2, the number of tiles in each record
                            	  6411: ; [07]: 0, the first index of a tile to transfer
                            	  6412: ; [09]: door direction index
                            	  6413: ;
                            	  6414: ; Note that this routine is called with triggered doors:
                            	  6415: ; doors that can change state. Their door type numbers are >= 4.
                            	  6416: ;
                            	  6417: ; If this routine were ever called with a fixed door
                            	  6418: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6419: ; values for the door face.
                            	  6420: ;
                            	  6421: ;
                            	  6422: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6423: ;
                            	  6424:     even
                            	  6425: PrepareWriteHorizontalDoorTransferRecords:
02:00043CE0 102C0055        	  6426:     move.b  ($0055,A4),D0
02:00043CE4 19400002        	  6427:     move.b  D0,($0002,A4)
02:00043CE8 6100F9A4        	  6428:     jsr     FindDoorAttrByDoorBit
02:00043CEC 0C000005        	  6429:     cmpi.b  #$05,D0
02:00043CF0 650C            	  6430:     bcs  _anon_z05_125
02:00043CF2 1B00            	  6431:     move.b  D0,-(A5)  ; PHA
02:00043CF4 7004            	  6432:     moveq   #4,D0
02:00043CF6 4EB900030580    	  6433:     jsr     PlaySample
02:00043CFC 101D            	  6434:     move.b  (A5)+,D0  ; PLA
                            	  6435: _anon_z05_125:
                            	  6436:     ; Calculate the door face index in three parts.
                            	  6437:     ;
                            	  6438:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6439:     ; (provisional face index in Y register).
                            	  6440:     ;
02:00043CFE 0C000004        	  6441:     cmpi.b  #$04,D0
02:00043D02 6602            	  6442:     bne  _anon_z05_126
02:00043D04 7008            	  6443:     moveq   #8,D0
                            	  6444: _anon_z05_126:
02:00043D06 0C000001        	  6445:     cmpi.b  #$01,D0
02:00043D0A 6602            	  6446:     bne  _anon_z05_127
02:00043D0C 7004            	  6447:     moveq   #4,D0
                            	  6448: _anon_z05_127:
                            	  6449:     ; Second, subtract 3 from provisional face index.
                            	  6450:     ;
02:00043D0E 003C0011        	  6451:     ori     #$11,CCR  ; SEC: set C+X
02:00043D12 123C0003        	  6452:     move.b  #$03,D1
02:00043D16 0A3C0010        	  6453:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043D1A 9101            	  6454:     subx.b  D1,D0   ; SBC #$03
02:00043D1C 0A3C0010        	  6455:     eori    #$10,CCR  ; restore X = 6502 C
02:00043D20 7600            	  6456:     moveq   #0,D3
02:00043D22 1600            	  6457:     move.b  D0,D3
                            	  6458:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6459:     ; face index >= 3, then subtract 1 from it.
                            	  6460:     ;
                            	  6461:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6462:     ; then make it 1.
                            	  6463:     ;
02:00043D24 102C0008        	  6464:     move.b  ($0008,A4),D0
02:00043D28 6708            	  6465:     beq  _anon_z05_128
02:00043D2A 0C030005        	  6466:     cmpi.b  #$05,D3
02:00043D2E 670A            	  6467:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D30 7601            	  6468:     moveq   #1,D3
                            	  6469: _anon_z05_128:
02:00043D32 0C030003        	  6470:     cmpi.b  #$03,D3
02:00043D36 6502            	  6471:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D38 5303            	  6472:     subq.b  #1,D3
                            	  6473:     even
                            	  6474: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6475:     ; The routine that returned the door type also returned its
                            	  6476:     ; reverse direction index in [03].
                            	  6477:     ;
                            	  6478:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6479:     ;
02:00043D3A 7003            	  6480:     moveq   #3,D0
02:00043D3C 003C0011        	  6481:     ori     #$11,CCR  ; SEC: set C+X
02:00043D40 122C0003        	  6482:     move.b  ($0003,A4),D1
02:00043D44 0A3C0010        	  6483:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043D48 9101            	  6484:     subx.b  D1,D0   ; SBC $03
02:00043D4A 0A3C0010        	  6485:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6486:     ; Call this to put the address of door face tiles in [02:03].
                            	  6487:     ;
02:00043D4E 6100FD7A        	  6488:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6489:     ; Return the address of the door in the nametable in [01:00].
                            	  6490:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6491:     ;
02:00043D52 41F900043B28    	  6492:     lea     (DoorVramAddrsHi).l,A0
02:00043D58 10302000        	  6493:     move.b  (A0,D2.W),D0
02:00043D5C 1880            	  6494:     move.b  D0,($0000,A4)
02:00043D5E 41F900043B2C    	  6495:     lea     (DoorVramAddrsLo).l,A0
02:00043D64 10302000        	  6496:     move.b  (A0,D2.W),D0
02:00043D68 19400001        	  6497:     move.b  D0,($0001,A4)
                            	  6498:     ; Return the direction of the door in [09], and the dynamic
                            	  6499:     ; transfer buf length in X register.
                            	  6500:     ;
02:00043D6C 19420009        	  6501:     move.b  D2,($0009,A4)
02:00043D70 7400            	  6502:     moveq   #0,D2
02:00043D72 142C0301        	  6503:     move.b  ($0301,A4),D2
                            	  6504:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6505:     ;
02:00043D76 7000            	  6506:     moveq   #0,D0
02:00043D78 19400007        	  6507:     move.b  D0,($0007,A4)
02:00043D7C 7002            	  6508:     moveq   #2,D0
02:00043D7E 19400006        	  6509:     move.b  D0,($0006,A4)
02:00043D82 19400005        	  6510:     move.b  D0,($0005,A4)
02:00043D86 0A3C0001        	  6511:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043D8A 4E75            	  6512:     rts
                            	  6513: 
                            	  6514:     even
                            	  6515: ColumnDirectoryUW:
02:00043D8C 00043568        	  6516:     dc.l    ColumnHeapUW0
02:00043D90 00043578        	  6517:     dc.l    ColumnHeapUW1
