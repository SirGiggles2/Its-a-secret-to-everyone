                            	  6947: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6948:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6949:     ;   full heart=4 partial heart=$70
                            	  6950:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6951:     ; But the method here yields $3EF, because partial heart is
                            	  6952:     ; considered full when = $FF instead of $100.
                            	  6953:     ;
02:00031CBC 102C000E        	  6954:     move.b  ($000E,A4),D0
02:00031CC0 003C0011        	  6955:     ori     #$11,CCR  ; SEC: set C+X
02:00031CC4 122C0670        	  6956:     move.b  ($0670,A4),D1
02:00031CC8 0A3C0010        	  6957:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031CCC 9101            	  6958:     subx.b  D1,D0   ; SBC HeartPartial
02:00031CCE 0A3C0010        	  6959:     eori    #$10,CCR  ; restore X = 6502 C
02:00031CD2 1940000E        	  6960:     move.b  D0,($000E,A4)
02:00031CD6 102C066F        	  6961:     move.b  ($066F,A4),D0
02:00031CDA 0200000F        	  6962:     andi.b #$0F,D0
02:00031CDE 6710            	  6963:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031CE0 532C066F        	  6964:     subq.b  #1,($066F,A4)
02:00031CE4 103C00FF        	  6965:     move.b  #$FF,D0
02:00031CE8 19400670        	  6966:     move.b  D0,($0670,A4)
02:00031CEC 6600FF6E        	  6967:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6968:     even
                            	  6969: _L_z01_Link_BeHarmed_HandleDied:
                            	  6970:     ; Link died.
                            	  6971:     ;
                            	  6972:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6973:     ; Make Link face down.
                            	  6974:     ; Go to mode $11.
                            	  6975:     ;
02:00031CF0 102C066F        	  6976:     move.b  ($066F,A4),D0
02:00031CF4 020000F0        	  6977:     andi.b #$F0,D0
02:00031CF8 1940066F        	  6978:     move.b  D0,($066F,A4)
02:00031CFC 4EB90004B6FC    	  6979:     jsr     EndGameMode
02:00031D02 19400670        	  6980:     move.b  D0,($0670,A4)
02:00031D06 194000AC        	  6981:     move.b  D0,($00AC,A4)
02:00031D0A 7011            	  6982:     moveq   #17,D0
02:00031D0C 19400012        	  6983:     move.b  D0,($0012,A4)
02:00031D10 7004            	  6984:     moveq   #4,D0
02:00031D12 19400098        	  6985:     move.b  D0,($0098,A4)
                            	  6986: _anon_z01_87:
02:00031D16 4E75            	  6987:     rts
                            	  6988: 
                            	  6989: ; Params:
                            	  6990: ; X: monster slot
                            	  6991: ; Y: weapon slot
                            	  6992: ; [02]: monster mid X
                            	  6993: ; [03]: monster mid Y
                            	  6994: ;
                            	  6995: ; Returns:
                            	  6996: ; [00]: weapon slot
                            	  6997: ;
