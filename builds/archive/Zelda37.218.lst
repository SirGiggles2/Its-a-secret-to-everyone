                            	  8618:     ; decrement the distance remaining, and move.
                            	  8619:     ;
02:0003D352 41EC0394        	  8620:     lea     ($0394,A4),A0
02:0003D356 10302000        	  8621:     move.b  (A0,D2.W),D0
