                            	 13321: Ganon_DrawBody:
                            	 13322:     ; Loop over four 16x16 images that make up Ganon.
                            	 13323:     ; There are 6 animation frames.
                            	 13324:     ;
02:0003F60C 7603            	 13325:     moveq   #3,D3
                            	 13326:     even
                            	 13327: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13328:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13329:     ;
02:0003F60E 10342070        	 13330:     move.b  ($70,A4,D2.W),D0
02:0003F612 023C00EE        	 13331:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F616 41F90003F600    	 13332:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F61C 12303000        	 13333:     move.b  (A0,D3.W),D1
02:0003F620 D101            	 13334:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F622 1880            	 13335:     move.b  D0,($0000,A4)
                            	 13336:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13337:     ;
02:0003F624 41EC0084        	 13338:     lea     ($0084,A4),A0
02:0003F628 10302000        	 13339:     move.b  (A0,D2.W),D0
02:0003F62C 023C00EE        	 13340:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F630 41F90003F604    	 13341:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F636 12303000        	 13342:     move.b  (A0,D3.W),D1
02:0003F63A D101            	 13343:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F63C 19400001        	 13344:     move.b  D0,($0001,A4)
                            	 13345:     ; Each part has a horizontal flipping flag.
                            	 13346:     ;
02:0003F640 41F90003F608    	 13347:     lea     (GanonSpriteHFlips).l,A0
02:0003F646 10303000        	 13348:     move.b  (A0,D3.W),D0
02:0003F64A 1940000F        	 13349:     move.b  D0,($000F,A4)
                            	 13350:     ; Save and copy the loop index (the current part) to [07].
                            	 13351:     ;
02:0003F64E 1003            	 13352:     move.b  D3,D0
02:0003F650 1B00            	 13353:     move.b  D0,-(A5)  ; PHA
02:0003F652 19400007        	 13354:     move.b  D0,($0007,A4)
                            	 13355:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13356:     ; that make it up.
                            	 13357:     ;
02:0003F656 41EC046B        	 13358:     lea     ($046B,A4),A0
02:0003F65A 10302000        	 13359:     move.b  (A0,D2.W),D0
02:0003F65E E308            	 13360:     lsl.b  #1,D0   ; ASL A
02:0003F660 E308            	 13361:     lsl.b  #1,D0   ; ASL A
                            	 13362:     ; Add [07] -- the index of the current part.
                            	 13363:     ;
                            	 13364:     ; Now you have an index into the frame image table, for the
                            	 13365:     ; current image part of the current animation frame.
                            	 13366:     ;
02:0003F662 122C0007        	 13367:     move.b  ($0007,A4),D1
02:0003F666 D101            	 13368:     addx.b  D1,D0   ; ADC $07
02:0003F668 7600            	 13369:     moveq   #0,D3
02:0003F66A 1600            	 13370:     move.b  D0,D3
02:0003F66C 41F90003F5E8    	 13371:     lea     (GanonFrameImages).l,A0
02:0003F672 10303000        	 13372:     move.b  (A0,D3.W),D0
02:0003F676 4EB900031602    	 13373:     jsr     DrawObjectNotMirrored
02:0003F67C 101D            	 13374:     move.b  (A5)+,D0  ; PLA
                            	 13375:     ; Bottom of the part loop.
                            	 13376:     ;
02:0003F67E 7600            	 13377:     moveq   #0,D3
02:0003F680 1600            	 13378:     move.b  D0,D3
02:0003F682 5303            	 13379:     subq.b  #1,D3
02:0003F684 6A88            	 13380:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F686 4E75            	 13381:     rts
