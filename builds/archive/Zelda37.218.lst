                            	  7573: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7574:     ; If the "monsters from edges" long timer expired, then
                            	  7575:     ; go bring the monster in.
                            	  7576:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7577:     ;
                            	  7578:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7579:     ; residual position so enemies keep their previous-room
                            	  7580:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D73E 102C004B        	  7581:     move.b  ($004B,A4),D0
02:0004D742 662E            	  7582:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7583:     ; timer == 0. Check for fresh room-entry + residual position.
