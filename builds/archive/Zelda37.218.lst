                            	  6593: Digdogger_Move:
                            	  6594:     ; This calculation is the same one used in Manhandla to
                            	  6595:     ; manifest the fractional speed over several frames.
                            	  6596:     ;
                            	  6597:     ; To summarize, the formula is:
                            	  6598:     ;
                            	  6599:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6600:     ;
                            	  6601:     ;   SA := SA + (SL AND $E0)
                            	  6602:     ;   [03] := SH + carry
                            	  6603:     ;
                            	  6604:     ; See 04:A28E Manhandla_Move.
                            	  6605:     ;
02:0003C484 41EC041F        	  6606:     lea     ($041F,A4),A0
02:0003C488 10302000        	  6607:     move.b  (A0,D2.W),D0
02:0003C48C 020000E0        	  6608:     andi.b #$E0,D0
02:0003C490 023C00EE        	  6609:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C494 41EC0412        	  6610:     lea     ($0412,A4),A0
02:0003C498 12302000        	  6611:     move.b  (A0,D2.W),D1
02:0003C49C D101            	  6612:     addx.b  D1,D0   ; ADC $0412,X
02:0003C49E 41EC0412        	  6613:     lea     ($0412,A4),A0
02:0003C4A2 11802000        	  6614:     move.b  D0,(A0,D2.W)
                            	  6615:     ; Assign (high speed byte + carry) to [03].
                            	  6616:     ;
02:0003C4A6 41EC042C        	  6617:     lea     ($042C,A4),A0
02:0003C4AA 10302000        	  6618:     move.b  (A0,D2.W),D0
02:0003C4AE 123C0000        	  6619:     move.b  #$00,D1
02:0003C4B2 D101            	  6620:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C4B4 19400003        	  6621:     move.b  D0,($0003,A4)
                            	  6622:     ; Change coordinates by the speed amount/offset in [03]
                            	  6623:     ; according to the direction.
                            	  6624:     ;
                            	  6625:     ; Start with a mask of $A1 in [02]:
                            	  6626:     ; - low nibble represents the right direction
                            	  6627:     ; - high nibble is used to set or clear carry as we go along
                            	  6628:     ;
02:0003C4B8 103C00A1        	  6629:     move.b  #$A1,D0
02:0003C4BC 19400002        	  6630:     move.b  D0,($0002,A4)
                            	  6631:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6632:     ;
02:0003C4C0 41EC0098        	  6633:     lea     ($0098,A4),A0
02:0003C4C4 10302000        	  6634:     move.b  (A0,D2.W),D0
02:0003C4C8 122C0002        	  6635:     move.b  ($0002,A4),D1
02:0003C4CC C200            	  6636:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4CE 6712            	  6637:     beq  _L_z04_Digdogger_Move_Left
02:0003C4D0 10342070        	  6638:     move.b  ($70,A4,D2.W),D0
02:0003C4D4 023C00EE        	  6639:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4D8 122C0003        	  6640:     move.b  ($0003,A4),D1
02:0003C4DC D101            	  6641:     addx.b  D1,D0   ; ADC $03
02:0003C4DE 19802070        	  6642:     move.b  D0,($70,A4,D2.W)
                            	  6643:     even
                            	  6644: _L_z04_Digdogger_Move_Left:
                            	  6645:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6646:     ;
02:0003C4E2 41EC0098        	  6647:     lea     ($0098,A4),A0
02:0003C4E6 10302000        	  6648:     move.b  (A0,D2.W),D0
02:0003C4EA 122C0002        	  6649:     move.b  ($0002,A4),D1
02:0003C4EE E309            	  6650:     lsl.b  #1,D1   ; ASL $02
02:0003C4F0 19410002        	  6651:     move.b  D1,($0002,A4)
02:0003C4F4 122C0002        	  6652:     move.b  ($0002,A4),D1
02:0003C4F8 C200            	  6653:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4FA 6716            	  6654:     beq  _L_z04_Digdogger_Move_Down
02:0003C4FC 10342070        	  6655:     move.b  ($70,A4,D2.W),D0
