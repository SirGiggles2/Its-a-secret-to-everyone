                            	  3336: _anon_z04_42:
                            	  3337:     ; State 0.
                            	  3338:     ;
                            	  3339:     ; In state we determine whether to burst out of the ground.
                            	  3340:     ; If the long timer has not expired, then return.
                            	  3341:     ;
