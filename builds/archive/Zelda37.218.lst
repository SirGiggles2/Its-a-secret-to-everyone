02:0004CB44 1600            	  6034:     move.b  D0,D3
02:0004CB46 41F90004C7FC    	  6035:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004CB4C 10303000        	  6036:     move.b  (A0,D3.W),D0
02:0004CB50 4EB900030B64    	  6037:     jsr     SetBoomerangSpeed
