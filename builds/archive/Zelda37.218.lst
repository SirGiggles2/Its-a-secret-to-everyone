02:0003E020 1880            	 10333:     move.b  D0,($0000,A4)
                            	 10334:     ; The object's Y is the sprite's.
                            	 10335:     ;
02:0003E022 41EC0084        	 10336:     lea     ($0084,A4),A0
02:0003E026 10302000        	 10337:     move.b  (A0,D2.W),D0
02:0003E02A 19400001        	 10338:     move.b  D0,($0001,A4)
02:0003E02E 612A            	 10339:     jsr     Gohma_SetSpriteAttributes
                            	 10340:     ; There are only two frame images for legs: left and right.
                            	 10341:     ; There are two animation frames. They are animated as follows:
                            	 10342:     ;
                            	 10343:     ; Frame 0:
                            	 10344:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10345:     ; horizontal flipping = frame number = 0
                            	 10346:     ; 
                            	 10347:     ; Frame 1:
                            	 10348:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10349:     ; horizontal flipping = frame number = 1
                            	 10350:     ;
02:0003E030 4EB90004D316    	 10351:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E036 1003            	 10352:     move.b  D3,D0
02:0003E038 023C00EE        	 10353:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E03C 41EC03E4        	 10354:     lea     ($03E4,A4),A0
02:0003E040 12302000        	 10355:     move.b  (A0,D2.W),D1
02:0003E044 D101            	 10356:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E046 02000001        	 10357:     andi.b #$01,D0
02:0003E04A 023C00EE        	 10358:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E04E 123C0004        	 10359:     move.b  #$04,D1
02:0003E052 D101            	 10360:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E054 4EF900031602    	 10361:     jmp     DrawObjectNotMirrored
                            	 10362: 
                            	 10363: ; Returns:
