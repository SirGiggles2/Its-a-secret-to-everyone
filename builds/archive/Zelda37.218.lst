02:0003DE3A 662C            	 10074:     bne  _L_z04_UpdateGohma_Move
                            	 10075:     ; If Random:
                            	 10076:     ;   >= $B0: right
                            	 10077:     ;   >= $60: left
                            	 10078:     ;   Else:   down
                            	 10079:     ;
02:0003DE3C 7001            	 10080:     moveq   #1,D0
02:0003DE3E 7600            	 10081:     moveq   #0,D3
02:0003DE40 16342018        	 10082:     move.b  ($18,A4,D2.W),D3
02:0003DE44 0C0300B0        	 10083:     cmpi.b  #$B0,D3
02:0003DE48 640A            	 10084:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE4A E308            	 10085:     lsl.b  #1,D0   ; ASL A
02:0003DE4C 0C030060        	 10086:     cmpi.b  #$60,D3
02:0003DE50 6402            	 10087:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE52 E308            	 10088:     lsl.b  #1,D0   ; ASL A
                            	 10089:     even
                            	 10090: _L_z04_UpdateGohma_ChangeDir:
02:0003DE54 41EC0098        	 10091:     lea     ($0098,A4),A0
02:0003DE58 11802000        	 10092:     move.b  D0,(A0,D2.W)
