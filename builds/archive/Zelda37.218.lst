                            	  6989: Aquamentus_Draw:
                            	  6990:     ; Every $10 screen frames, switch animation frames.
                            	  6991:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6992:     ; The last tile of frame 0 is at index 5.
                            	  6993:     ; The last tile of frame 1 is at index $B.
                            	  6994:     ;
02:0003C78A 7605            	  6995:     moveq   #5,D3
02:0003C78C 102C0015        	  6996:     move.b  ($0015,A4),D0
02:0003C790 02000010        	  6997:     andi.b #$10,D0
02:0003C794 6602            	  6998:     bne  _anon_z04_88
02:0003C796 760B            	  6999:     moveq   #11,D3
                            	  7000: _anon_z04_88:
02:0003C798 1943000A        	  7001:     move.b  D3,($000A,A4)
                            	  7002:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  7003:     ;
02:0003C79C 7005            	  7004:     moveq   #5,D0
02:0003C79E 1940000B        	  7005:     move.b  D0,($000B,A4)
                            	  7006:     even
                            	  7007: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7A2 7600            	  7008:     moveq   #0,D3
02:0003C7A4 162C000B        	  7009:     move.b  ($000B,A4),D3
                            	  7010:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  7011:     ; Store it in [00].
                            	  7012:     ;
02:0003C7A8 10342070        	  7013:     move.b  ($70,A4,D2.W),D0
02:0003C7AC 023C00EE        	  7014:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7B0 41F90003C784    	  7015:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7B6 12303000        	  7016:     move.b  (A0,D3.W),D1
02:0003C7BA D101            	  7017:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7BC 1880            	  7018:     move.b  D0,($0000,A4)
                            	  7019:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  7020:     ; Store it in [01].
                            	  7021:     ;
02:0003C7BE 41EC0084        	  7022:     lea     ($0084,A4),A0
02:0003C7C2 10302000        	  7023:     move.b  (A0,D2.W),D0
02:0003C7C6 023C00EE        	  7024:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7CA 41F90003C77E    	  7025:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C7D0 12303000        	  7026:     move.b  (A0,D3.W),D1
02:0003C7D4 D101            	  7027:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C7D6 19400001        	  7028:     move.b  D0,($0001,A4)
                            	  7029:     ; Calculate sprite attributes:
                            	  7030:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7031:     ;
                            	  7032:     ; If the boss is temporarily invincible, then
                            	  7033:     ; this makes it flash by cycling all the palette rows.
                            	  7034:     ;
                            	  7035:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7036:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7037:     ;
02:0003C7DA 41EC04F0        	  7038:     lea     ($04F0,A4),A0
02:0003C7DE 10302000        	  7039:     move.b  (A0,D2.W),D0
02:0003C7E2 02000003        	  7040:     andi.b #$03,D0
02:0003C7E6 0A000003        	  7041:     eori.b #$03,D0
02:0003C7EA 19400003        	  7042:     move.b  D0,($0003,A4)
02:0003C7EE 7600            	  7043:     moveq   #0,D3
02:0003C7F0 162C000A        	  7044:     move.b  ($000A,A4),D3
                            	  7045:     ; Look up the tile for this sprite.
                            	  7046:     ; If it's not the first one (face), then go write the sprite record.
                            	  7047:     ;
02:0003C7F4 41F90003C772    	  7048:     lea     (AquamentusTiles).l,A0
02:0003C7FA 10303000        	  7049:     move.b  (A0,D3.W),D0
02:0003C7FE 12390003C772    	  7050:     move.b  (AquamentusTiles).l,D1
02:0003C804 B001            	  7051:     cmp.b   D1,D0
02:0003C806 6610            	  7052:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7053:     ; Else it's the first one (the face tile).
                            	  7054:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7055:     ;
                            	  7056:     ; $CC/CD shows the closed mouth face.
                            	  7057:     ; $C0/C1 shows the open mouth face.
                            	  7058:     ;
02:0003C808 7600            	  7059:     moveq   #0,D3
02:0003C80A 16342028        	  7060:     move.b  ($28,A4,D2.W),D3
02:0003C80E 0C030020        	  7061:     cmpi.b  #$20,D3
02:0003C812 6404            	  7062:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C814 103C00C0        	  7063:     move.b  #$C0,D0
                            	  7064:     even
