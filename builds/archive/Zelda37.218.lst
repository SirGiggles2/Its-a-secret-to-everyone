                            	 12131:     even
                            	 12132: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12133:     ; Loop over every segment under the head, starting from the tail.
                            	 12134:     ; Copy the next segment's direction to the current one in this loop.
                            	 12135:     ;
02:0003EDB6 41EC009A        	 12136:     lea     ($009A,A4),A0
02:0003EDBA 10303000        	 12137:     move.b  (A0,D3.W),D0
02:0003EDBE 41EC0099        	 12138:     lea     ($0099,A4),A0
02:0003EDC2 11803000        	 12139:     move.b  D0,(A0,D3.W)
02:0003EDC6 5203            	 12140:     addq.b  #1,D3
