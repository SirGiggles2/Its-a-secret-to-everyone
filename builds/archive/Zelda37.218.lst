02:0003C04C 10302000        	  5969:     move.b  (A0,D2.W),D0
02:0003C050 41EC0085        	  5970:     lea     ($0085,A4),A0
02:0003C054 11803000        	  5971:     move.b  D0,(A0,D3.W)
                            	  5972:     ; If the tail segment found is also a head, then
