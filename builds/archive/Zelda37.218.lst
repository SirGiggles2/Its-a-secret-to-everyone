                            	 13195: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F50C 19420340        	 13196:     move.b  D2,($0340,A4)
                            	 13197:     ; If object slot < 5 or = 7, then move every frame.
                            	 13198:     ; Else move 3 out of every 4 frames.
                            	 13199:     ;
                            	 13200:     ; This makes pieces spread out in somewhat of a circle,
                            	 13201:     ; by making the pieces at cardinal directions move at
                            	 13202:     ; full speed while the diagonal ones move a little slower.
                            	 13203:     ;
