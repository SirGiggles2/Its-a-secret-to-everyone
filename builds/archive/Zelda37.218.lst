02:0003F538 41F90003F406    	 13222:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F53E 12302000        	 13223:     move.b  (A0,D2.W),D1
02:0003F542 8001            	 13224:     or.b  D1,D0
02:0003F544 19400003        	 13225:     move.b  D0,($0003,A4)
02:0003F548 41F90003F410    	 13226:     lea     (GanonBurstTiles).l,A0
02:0003F54E 10302000        	 13227:     move.b  (A0,D2.W),D0
02:0003F552 4EB9000318FE    	 13228:     jsr     Anim_WriteSprite
                            	 13229:     ; Bottom of the loop.
