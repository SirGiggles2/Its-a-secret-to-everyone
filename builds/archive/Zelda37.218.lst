02:0003DE1A 0C000002        	 10059:     cmpi.b  #$02,D0
02:0003DE1E 670C            	 10060:     beq  _anon_z04_117
02:0003DE20 0C000003        	 10061:     cmpi.b  #$03,D0
02:0003DE24 6706            	 10062:     beq  _anon_z04_117
02:0003DE26 4EF9000315FE    	 10063:     jmp     DrawObjectMirrored
                            	 10064: 
