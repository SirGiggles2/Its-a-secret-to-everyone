                            	  8014: __far_z_07_0128:
                            	  8015:     ; 7 of every 8 frames, return.
                            	  8016:     ;
02:0004DB74 102C0015        	  8017:     move.b  ($0015,A4),D0
02:0004DB78 02000007        	  8018:     andi.b #$07,D0
02:0004DB7C 0C000004        	  8019:     cmpi.b  #$04,D0
02:0004DB80 6702            	  8020:     beq.s  __far_z_07_0129
02:0004DB82 604C            	  8021:     jmp  L1FF28_Exit
                            	  8022: __far_z_07_0129:
                            	  8023:     ; So, every 8 frames:
                            	  8024:     ; 1. Increment the secret color cycle count.
                            	  8025:     ; 2. Change the water palette.
                            	  8026:     ;
                            	  8027:     ; But when the count = $B, go reveal the stairs.
