                            	  4444: CheckTiles:
                            	  4445:     ifne TURBO_LINK
                            	  4446:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4447:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004C0A8 4A02            	  4448:     tst.b   D2
02:0004C0AA 6608            	  4449:     bne.s   _L_z07_CheckTiles_notLink
02:0004C0AC 197C0024049E    	  4450:     move.b  #$24,($049E,A4)
02:0004C0B2 605E            	  4451:     jmp     GoWalkableDir
                            	  4452: _L_z07_CheckTiles_notLink:
                            	  4453:     endc
                            	  4454:     ; The code below applies to Link and other objects.
                            	  4455:     ;
                            	  4456:     ; Test the moving direction's walkability.
                            	  4457:     ;
                            	  4458:     ; For the player, this is enough. For other objects, this 
                            	  4459:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4460:     ;
                            	  4461:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4462:     ;
02:0004C0B4 6100F9D4        	  4463:     jsr     GetCollidingTileMoving
02:0004C0B8 122C034A        	  4464:     move.b  ($034A,A4),D1
02:0004C0BC B001            	  4465:     cmp.b   D1,D0
02:0004C0BE 6402            	  4466:     bcc.s  __far_z_07_0056
