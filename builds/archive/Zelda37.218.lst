                            	  4247:     ;
02:0003B326 103C0080        	  4248:     move.b  #$80,D0
02:0003B32A 41EC0098        	  4249:     lea     ($0098,A4),A0
02:0003B32E 11802000        	  4250:     move.b  D0,(A0,D2.W)
                            	  4251:     ; Starting angle $18 (N).
                            	  4252:     ;
