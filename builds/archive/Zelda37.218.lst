02:0004CB22 4EB900030B64    	  6022:     jsr     SetBoomerangSpeed
02:0004CB28 102C000A        	  6023:     move.b  ($000A,A4),D0
02:0004CB2C 1940000F        	  6024:     move.b  D0,($000F,A4)
02:0004CB30 41EC0098        	  6025:     lea     ($0098,A4),A0
02:0004CB34 11802000        	  6026:     move.b  D0,(A0,D2.W)
02:0004CB38 1003            	  6027:     move.b  D3,D0
