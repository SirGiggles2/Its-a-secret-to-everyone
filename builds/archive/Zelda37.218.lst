02:0002DC60 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DC64 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DC68 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DC6A 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DC6E 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DC70 0C00007B        	   209:     cmpi.b  #$7B,D0
