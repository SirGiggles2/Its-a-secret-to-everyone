                            	  7231: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  7232:     ; To animate the state, the animation counter had to have
                            	  7233:     ; reached 0. Right after this routine, the counter will be
                            	  7234:     ; rolled over, and the movement frame will be switched.
                            	  7235:     ;
                            	  7236:     ; So, set movement frame to 1 (legs together) at the end of
                            	  7237:     ; the animation here, in order to immediately change it to
                            	  7238:     ; 0 (legs apart) after this.
                            	  7239:     ;
02:0004D38C 7001            	  7240:     moveq   #1,D0
02:0004D38E 194003E4        	  7241:     move.b  D0,($03E4,A4)
02:0004D392 4E75            	  7242:     rts
                            	  7243: 
                            	  7244:     even
