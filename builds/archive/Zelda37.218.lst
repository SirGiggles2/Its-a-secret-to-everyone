02:00030D4E E208            	  5000:     lsr.b  #1,D0   ; LSR A
                            	  5001:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  5002:     ;
02:00030D50 7600            	  5003:     moveq   #0,D3
02:00030D52 16342028        	  5004:     move.b  ($28,A4,D2.W),D3
                            	  5005:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  5006:     ; Carry will have been set, because of the comparison (CPY).
                            	  5007:     ;
