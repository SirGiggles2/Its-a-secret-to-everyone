02:0003ECA6 D101            	 11996:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003ECA8 19802070        	 11997:     move.b  D0,($70,A4,D2.W)
                            	 11998:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11999:     ; to store in [03].
                            	 12000:     ;
02:0003ECAC 102C04E6        	 12001:     move.b  ($04E6,A4),D0
