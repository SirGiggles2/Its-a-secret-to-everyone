                            	  5890: _L_z01_CheckMazes_PlaySecretTune:
                            	  5891:     ; Play secret tune, and let the player leave the maze.
                            	  5892:     ;
02:0003139C 7004            	  5893:     moveq   #4,D0
02:0003139E 19400602        	  5894:     move.b  D0,($0602,A4)
02:000313A2 4E75            	  5895:     rts
                            	  5896: 
                            	  5897: ; Params:
                            	  5898: ; [02]: Y
                            	  5899: ; [03]: X
                            	  5900: ;
                            	  5901: ; Returns:
                            	  5902: ; [00]: high byte of PPU address
                            	  5903: ; [01]: low byte of PPU address
                            	  5904: ;
                            	  5905: ;
                            	  5906: ; Turn the 16-bit value 08YY into the PPU address
                            	  5907: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5908: ;
                            	  5909: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5910: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5911: ;
                            	  5912:     even
