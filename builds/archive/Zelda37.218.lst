                            	  7610:     ; the height of each row.
                            	  7611:     ;
02:000447EA 003C0011        	  7612:     ori     #$11,CCR  ; SEC: set C+X
02:000447EE 123C0040        	  7613:     move.b  #$40,D1
02:000447F2 0A3C0010        	  7614:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000447F6 9101            	  7615:     subx.b  D1,D0   ; SBC #$40
02:000447F8 0A3C0010        	  7616:     eori    #$10,CCR  ; restore X = 6502 C
02:000447FC E208            	  7617:     lsr.b  #1,D0   ; LSR A
02:000447FE E208            	  7618:     lsr.b  #1,D0   ; LSR A
02:00044800 E208            	  7619:     lsr.b  #1,D0   ; LSR A
                            	  7620:     ; Add this row offset to the column address.
