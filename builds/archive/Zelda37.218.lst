02:0002E756 123C0010        	  1780:     move.b  #$10,D1
02:0002E75A 0A3C0010        	  1781:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E75E 9101            	  1782:     subx.b  D1,D0   ; SBC #$10
02:0002E760 0A3C0010        	  1783:     eori    #$10,CCR  ; restore X = 6502 C
