02:0003ED08 41EC0485        	 12038:     lea     ($0485,A4),A0
02:0003ED0C 11802000        	 12039:     move.b  D0,(A0,D2.W)
                            	 12040:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 12041:     ;
                            	 12042:     ; From the lowest slot, look for one that has the original lamnola
                            	 12043:     ; object type.
