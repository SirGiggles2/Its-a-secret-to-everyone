                            	  1065:     ; PATCHED (P8): Replace broken NES indirect-pointer text lookup with
                            	  1066:     ; direct M68K addressing. DemoLineTextAddrs contains word offsets.
02:00033C9C 102C042E        	  1067:     move.b  ($042E,A4),D0
02:00033CA0 024000FF        	  1068:     andi.w  #$00FF,D0
