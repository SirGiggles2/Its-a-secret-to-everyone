02:0004511A 6642            	  8575:     bne  _anon_z05_177
02:0004511C 102C0098        	  8576:     move.b  ($0098,A4),D0
02:00045120 02000004        	  8577:     andi.b #$04,D0
02:00045124 6738            	  8578:     beq  _anon_z05_177
