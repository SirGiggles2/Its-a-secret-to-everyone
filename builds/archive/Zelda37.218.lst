                            	  1962:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1963:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1964:     ; - layout $23: pattern 1: 2 statues
                            	  1965:     ; - layout $24: pattern 0: 4 statues
                            	  1966:     ;
02:0003A3C0 4EB90004B160    	  1967:     jsr     GetUniqueRoomId
02:0003A3C6 7601            	  1968:     moveq   #1,D3
