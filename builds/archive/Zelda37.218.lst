                            	   339:     ;
02:00040296 522C00E1        	   340:     addq.b  #1,($00E1,A4)
02:0004029A 102C0010        	   341:     move.b  ($0010,A4),D0
02:0004029E 67000084        	   342:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:000402A2 102C0012        	   343:     move.b  ($0012,A4),D0
02:000402A6 0C000009        	   344:     cmpi.b  #$09,D0
02:000402AA 6778            	   345:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   346:     ; Calculate the X coordinate of the submenu position marker.
                            	   347:     ;
                            	   348:     ; First, mask off the high nibble of the room ID and multiply by
                            	   349:     ; the width of a tile, 8. Store the result in [00].
                            	   350:     ;
02:000402AC 102C00EB        	   351:     move.b  ($00EB,A4),D0
02:000402B0 0200000F        	   352:     andi.b #$0F,D0
02:000402B4 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:000402B6 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:000402B8 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:000402BA 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   358:     ; negative or left rotation by ($10 - rotation value).
                            	   359:     ;
                            	   360:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   361:     ; the width of a tile. Then negate it. The final result is the
                            	   362:     ; negative offset.
                            	   363:     ;
02:000402BC 103900FF6BAB    	   364:     move.b  (NES_SRAM+$0BAB).l,D0
02:000402C2 0C000008        	   365:     cmpi.b  #$08,D0
02:000402C6 6520            	   366:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:000402C8 7010            	   367:     moveq   #16,D0
02:000402CA 123900FF6BAB    	   368:     move.b  (NES_SRAM+$0BAB).l,D1
02:000402D0 0A3C0010        	   369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000402D4 9101            	   370:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:000402D6 0A3C0010        	   371:     eori    #$10,CCR  ; restore X = 6502 C
02:000402DA E308            	   372:     lsl.b  #1,D0   ; ASL A
02:000402DC E308            	   373:     lsl.b  #1,D0   ; ASL A
02:000402DE E308            	   374:     lsl.b  #1,D0   ; ASL A
02:000402E0 4EB900030A40    	   375:     jsr     Negate
02:000402E6 6006            	   376:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   377: 
                            	   378:     even
                            	   379: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   380:     ; The submenu map's rotation < 8.
                            	   381:     ; It represents the number of tiles to move right.
                            	   382:     ; So, multiply it by 8.
                            	   383:     ;
02:000402E8 E308            	   384:     lsl.b  #1,D0   ; ASL A
02:000402EA E308            	   385:     lsl.b  #1,D0   ; ASL A
02:000402EC E308            	   386:     lsl.b  #1,D0   ; ASL A
                            	   387:     even
                            	   388: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   389:     ; Add the offset we calculated, and $62 to [00] to get
                            	   390:     ; the position marker's X coordinate.
                            	   391:     ;
02:000402EE 023C00EE        	   392:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402F2 1214            	   393:     move.b  ($0000,A4),D1
02:000402F4 D101            	   394:     addx.b  D1,D0   ; ADC $00
02:000402F6 023C00EE        	   395:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402FA 123C0062        	   396:     move.b  #$62,D1
02:000402FE D101            	   397:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040300 19400253        	   398:     move.b  D0,($0253,A4)
                            	   399:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   400:     ; Divide by 2 to get a multiple of the tile height.
                            	   401:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   402:     ;
02:00040304 102C00EB        	   403:     move.b  ($00EB,A4),D0
02:00040308 020000F0        	   404:     andi.b #$F0,D0
02:0004030C E208            	   405:     lsr.b  #1,D0   ; LSR A
02:0004030E 123C0069        	   406:     move.b  #$69,D1
02:00040312 D101            	   407:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040314 19400250        	   408:     move.b  D0,($0250,A4)
                            	   409:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   410:     ;
02:00040318 703E            	   411:     moveq   #62,D0
02:0004031A 19400251        	   412:     move.b  D0,($0251,A4)
02:0004031E 7000            	   413:     moveq   #0,D0
02:00040320 19400252        	   414:     move.b  D0,($0252,A4)
                            	   415:     even
                            	   416: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040324 4E75            	   417:     rts
                            	   418: 
                            	   419:     even
                            	   420: UpdateMenuActive:
02:00040326 610053D6        	   421:     jsr     DrawSubmenuItems
02:0004032A 6100549A        	   422:     jsr     UpdateSubmenuSelection
                            	   423:     ; If buttons Up and A are down on the second controller, then
                            	   424:     ; 1. reset submenu state
                            	   425:     ; 2. go to mode 8
                            	   426:     ; 3. silence sound
                            	   427:     ;
02:0004032E 102C00FB        	   428:     move.b  ($00FB,A4),D0
02:00040332 02000088        	   429:     andi.b #$88,D0
02:00040336 0C000088        	   430:     cmpi.b  #$88,D0
02:0004033A 661A            	   431:     bne  _anon_z05_3
02:0004033C 4EB90004B6FC    	   432:     jsr     EndGameMode
02:00040342 194000E1        	   433:     move.b  D0,($00E1,A4)
02:00040346 7008            	   434:     moveq   #8,D0
02:00040348 19400012        	   435:     move.b  D0,($0012,A4)
02:0004034C 7000            	   436:     moveq   #0,D0
02:0004034E 19400619        	   437:     move.b  D0,($0619,A4)
02:00040352 600013A0        	   438:     jmp     SilenceSound
