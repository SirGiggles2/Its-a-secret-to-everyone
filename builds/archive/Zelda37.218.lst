                            	 12886: __far_z_04_0130:
                            	 12887:     ; State = 0: Blue
                            	 12888:     ;
                            	 12889:     ; If timer = 0, then go move around and shoot.
                            	 12890:     ;
02:0003F2DE 10342028        	 12891:     move.b  ($28,A4,D2.W),D0
02:0003F2E2 6602            	 12892:     bne.s  __far_z_04_0131
02:0003F2E4 600E            	 12893:     jmp  Ganon_MoveAndShoot
                            	 12894: __far_z_04_0131:
                            	 12895:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12896:     ; Collisions were checked already.
                            	 12897:     ;
                            	 12898:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12899:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12900:     ;
02:0003F2E6 0C000001        	 12901:     cmpi.b  #$01,D0
02:0003F2EA 6702            	 12902:     beq.s  __far_z_04_0132
02:0003F2EC 6078            	 12903:     jmp  L_Ganon_DrawBody
                            	 12904: __far_z_04_0132:
