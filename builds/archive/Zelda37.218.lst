02:0003CF0C 41EC0084        	  8085:     lea     ($0084,A4),A0
02:0003CF10 10302000        	  8086:     move.b  (A0,D2.W),D0
02:0003CF14 023C00EE        	  8087:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF18 41F90003CDF6    	  8088:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF1E 12303000        	  8089:     move.b  (A0,D3.W),D1
02:0003CF22 D101            	  8090:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF24 41EC042C        	  8091:     lea     ($042C,A4),A0
02:0003CF28 11802000        	  8092:     move.b  D0,(A0,D2.W)
                            	  8093:     ; Turn the index into a direction again by adding 1.
                            	  8094:     ; Store the facing direction.
                            	  8095:     ;
02:0003CF2C 5203            	  8096:     addq.b  #1,D3
02:0003CF2E 41EC0098        	  8097:     lea     ($0098,A4),A0
