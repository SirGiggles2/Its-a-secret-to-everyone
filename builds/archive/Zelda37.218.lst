                            	  3764: DrawGhiniAndCheckCollisions:
02:0003B050 4EB90004D344    	  3765:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B056 1940000D        	  3766:     move.b  D0,($000D,A4)
                            	  3767:     ; If the direction has an "up" component, then keep the
                            	  3768:     ; frame image 0, and go figure out horizontal flipping.
                            	  3769:     ;
02:0003B05A 41EC0098        	  3770:     lea     ($0098,A4),A0
02:0003B05E 10302000        	  3771:     move.b  (A0,D2.W),D0
02:0003B062 02000008        	  3772:     andi.b #$08,D0
02:0003B066 6614            	  3773:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3774:     ; Else make the frame image 1 for the "down" frame.
                            	  3775:     ; Note that this is the frame image to use, even if there's no
                            	  3776:     ; down component in the direction.
                            	  3777:     ;
02:0003B068 522C000D        	  3778:     addq.b  #1,($000D,A4)
                            	  3779:     ; If right is a component of the direction, then go set horizontal
                            	  3780:     ; flipping. Else leave horizontal flipping = 0.
                            	  3781:     ;
02:0003B06C 41EC0098        	  3782:     lea     ($0098,A4),A0
02:0003B070 10302000        	  3783:     move.b  (A0,D2.W),D0
02:0003B074 02000001        	  3784:     andi.b #$01,D0
02:0003B078 6714            	  3785:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B07A 660E            	  3786:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3787:     even
                            	  3788: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3789:     ; Set horizontal flipping if right is a direction component.
                            	  3790:     ; This essentially the same test as above, but for when we jump
                            	  3791:     ; from the "up" test.
                            	  3792:     ;
02:0003B07C 41EC0098        	  3793:     lea     ($0098,A4),A0
02:0003B080 10302000        	  3794:     move.b  (A0,D2.W),D0
02:0003B084 02000002        	  3795:     andi.b #$02,D0
02:0003B088 6704            	  3796:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3797:     even
                            	  3798: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B08A 522C000F        	  3799:     addq.b  #1,($000F,A4)
                            	  3800:     even
                            	  3801: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B08E 102C000D        	  3802:     move.b  ($000D,A4),D0
                            	  3803: ; Params:
                            	  3804: ; A: frame image
                            	  3805: ; X: object index
                            	  3806: ; [00]: object X
                            	  3807: ; [01]: object Y
                            	  3808: ; [0F]: flip horizontally
                            	  3809: ;
                            	  3810: ; Returns:
                            	  3811: ; [00]: 0 for Link slot
                            	  3812: ; [06]: 1 if objects collide
                            	  3813: ; [09]: 0 for Link damage type (none)
                            	  3814: ; [0C]: 1 if objects collide
                            	  3815: ; [034B]: ShotCollidesWithLink
                            	  3816: ;
                            	  3817:     even
                            	  3818: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003B092 4EB900031602    	  3819:     jsr     DrawObjectNotMirrored
02:0003B098 4EF900031AC8    	  3820:     jmp     CheckLinkCollision
                            	  3821: 
                            	  3822:     even
                            	  3823: SecretArmosRoomIds:
02:0003B09E 24              	  3824:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B09F 0B
02:0003B0A0 1C
02:0003B0A1 22
02:0003B0A2 34
02:0003B0A3 3D
02:0003B0A4 4E
                            	  3825: 
                            	  3826:     even
                            	  3827: SecretArmosXs:
02:0003B0A6 E0              	  3828:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B0A7 B0
02:0003B0A8 B0
02:0003B0A9 30
02:0003B0AA 40
02:0003B0AB 90
02:0003B0AC A0
                            	  3829: 
                            	  3830:     even
                            	  3831: InitArmosOrFlyingGhini:
                            	  3832:     ; In UpdateObject, this object was flagged "initialized".
                            	  3833:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3834:     ;
02:0003B0AE 10342028        	  3835:     move.b  ($28,A4,D2.W),D0
02:0003B0B2 41EC0492        	  3836:     lea     ($0492,A4),A0
02:0003B0B6 11802000        	  3837:     move.b  D0,(A0,D2.W)
                            	  3838:     ; If it's still fading in, then go finish some initialization needed
                            	  3839:     ; for fading in.
                            	  3840:     ;
02:0003B0BA 660000B6        	  3841:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3842:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3843:     ; go finish initializing it.
                            	  3844:     ;
02:0003B0BE 41EC034F        	  3845:     lea     ($034F,A4),A0
02:0003B0C2 10302000        	  3846:     move.b  (A0,D2.W),D0
02:0003B0C6 0C000022        	  3847:     cmpi.b  #$22,D0
02:0003B0CA 670000A6        	  3848:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3849:     ; Else we have an armos.
                            	  3850:     ;
                            	  3851:     ; Store stairs tile $70 in [00] for use later.
                            	  3852:     ;
02:0003B0CE 7070            	  3853:     moveq   #112,D0
02:0003B0D0 1880            	  3854:     move.b  D0,($0000,A4)
                            	  3855:     ; Look for the current room ID in an array of room ID's that
                            	  3856:     ; have armos secrets.
                            	  3857:     ;
02:0003B0D2 7606            	  3858:     moveq   #6,D3
                            	  3859:     even
                            	  3860: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B0D4 102C00EB        	  3861:     move.b  ($00EB,A4),D0
                            	  3862:     ; If this element does not match the current room ID, go loop again.
                            	  3863:     ;
02:0003B0D8 41F90003B09E    	  3864:     lea     (SecretArmosRoomIds).l,A0
02:0003B0DE 12303000        	  3865:     move.b  (A0,D3.W),D1
02:0003B0E2 B001            	  3866:     cmp.b   D1,D0
02:0003B0E4 6648            	  3867:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3868:     ; The secret (usually stairs) is under one of the armoses.
                            	  3869:     ;
                            	  3870:     ; If the armos's X coordinate does not match the one needed
                            	  3871:     ; for the current room in the list, then go loop again.
                            	  3872:     ;
02:0003B0E6 10342070        	  3873:     move.b  ($70,A4,D2.W),D0
02:0003B0EA 41F90003B0A6    	  3874:     lea     (SecretArmosXs).l,A0
02:0003B0F0 12303000        	  3875:     move.b  (A0,D3.W),D1
02:0003B0F4 B001            	  3876:     cmp.b   D1,D0
02:0003B0F6 6636            	  3877:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3878:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3879:     ;
02:0003B0F8 41EC0084        	  3880:     lea     ($0084,A4),A0
02:0003B0FC 10302000        	  3881:     move.b  (A0,D2.W),D0
02:0003B100 0C000080        	  3882:     cmpi.b  #$80,D0
02:0003B104 6628            	  3883:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3884:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3885:     ;
02:0003B106 4A03            	  3886:     cmpi.b  #$00,D3
02:0003B108 662C            	  3887:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3888:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3889:     ; has the power bracelet.
                            	  3890:     ;
                            	  3891:     ; Set up the room item with the armos's coordinates.
                            	  3892:     ;
02:0003B10A 19400097        	  3893:     move.b  D0,($0097,A4)
02:0003B10E 10342070        	  3894:     move.b  ($70,A4,D2.W),D0
02:0003B112 19400083        	  3895:     move.b  D0,($0083,A4)
                            	  3896:     ; This resets the room item's state, which activates it.
                            	  3897:     ;
02:0003B116 194300BF        	  3898:     move.b  D3,($00BF,A4)
                            	  3899:     ; Set the room item ID.
                            	  3900:     ;
02:0003B11A 7014            	  3901:     moveq   #20,D0
02:0003B11C 194000AB        	  3902:     move.b  D0,($00AB,A4)
                            	  3903:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3904:     ;
                            	  3905:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3906:     ;
                            	  3907:     ; Note that, if the item was already taken, then the room item
                            	  3908:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3909:     ; it will be ignored, because that routine checks whether
                            	  3910:     ; the item was taken.
                            	  3911:     ;
02:0003B120 4EB900030F34    	  3912:     jsr     GetRoomFlagUWItemState
02:0003B126 660A            	  3913:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B128 610006FE        	  3914:     jsr     PlaySecretFoundTune
02:0003B12C 6604            	  3915:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3916:     even
                            	  3917: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3918:     ; Bottom of the loop.
                            	  3919:     ;
02:0003B12E 5303            	  3920:     subq.b  #1,D3
02:0003B130 6AA2            	  3921:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3922:     even
                            	  3923: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3924:     ; Not found, or found the power bracelet.
                            	  3925:     ; Use a floor tile $26 to replace the armos.
                            	  3926:     ;
02:0003B132 7026            	  3927:     moveq   #38,D0
02:0003B134 1880            	  3928:     move.b  D0,($0000,A4)
                            	  3929:     even
