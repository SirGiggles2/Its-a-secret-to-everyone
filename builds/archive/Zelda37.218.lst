                            	 10190: _L_z04_UpdateGohma_AnimateEye:
                            	 10191:     ; Animate the eye.
                            	 10192:     ;
                            	 10193:     ; First, if the counter for when to open the eye next = 0, then
                            	 10194:     ; set it to a random value at least $C0; and set the timer for
                            	 10195:     ; keeping the eye open to $80.
                            	 10196:     ;
                            	 10197:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10198:     ; every other frame.
                            	 10199:     ;
02:0003DF2C 41EC042C        	 10200:     lea     ($042C,A4),A0
02:0003DF30 10302000        	 10201:     move.b  (A0,D2.W),D0
02:0003DF34 661E            	 10202:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF36 103C0080        	 10203:     move.b  #$80,D0
02:0003DF3A 41EC0444        	 10204:     lea     ($0444,A4),A0
02:0003DF3E 11802000        	 10205:     move.b  D0,(A0,D2.W)
02:0003DF42 103C00C0        	 10206:     move.b  #$C0,D0
02:0003DF46 12342018        	 10207:     move.b  ($18,A4,D2.W),D1
02:0003DF4A 8001            	 10208:     or.b  D1,D0
02:0003DF4C 41EC042C        	 10209:     lea     ($042C,A4),A0
02:0003DF50 11802000        	 10210:     move.b  D0,(A0,D2.W)
                            	 10211:     even
