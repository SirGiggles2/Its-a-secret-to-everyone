02:00031C8C 102C066F        	  6931:     move.b  ($066F,A4),D0
02:00031C90 0200000F        	  6932:     andi.b #$0F,D0
02:00031C94 122C000D        	  6933:     move.b  ($000D,A4),D1
02:00031C98 B001            	  6934:     cmp.b   D1,D0
02:00031C9A 6554            	  6935:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031C9C 102C066F        	  6936:     move.b  ($066F,A4),D0
02:00031CA0 003C0011        	  6937:     ori     #$11,CCR  ; SEC: set C+X
02:00031CA4 122C000D        	  6938:     move.b  ($000D,A4),D1
02:00031CA8 0A3C0010        	  6939:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031CAC 9101            	  6940:     subx.b  D1,D0   ; SBC $0D
02:00031CAE 0A3C0010        	  6941:     eori    #$10,CCR  ; restore X = 6502 C
02:00031CB2 1940066F        	  6942:     move.b  D0,($066F,A4)
02:00031CB6 0A3C0001        	  6943:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031CBA 4E75            	  6944:     rts
