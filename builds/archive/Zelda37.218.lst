02:0003AE2E 122C034A        	  3476:     move.b  ($034A,A4),D1
02:0003AE32 B001            	  3477:     cmp.b   D1,D0
02:0003AE34 6400FF78        	  3478:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE38 522C0510        	  3479:     addq.b  #1,($0510,A4)
                            	  3480:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3481:     ; and pick up whatever the new value is for state 1.
                            	  3482:     ;
02:0003AE3C 7001            	  3483:     moveq   #1,D0
02:0003AE3E 41EC03D0        	  3484:     lea     ($03D0,A4),A0
02:0003AE42 11802000        	  3485:     move.b  D0,(A0,D2.W)
                            	  3486:     ; Set the long timer to 2, meaning 20 frames.
                            	  3487:     ;
02:0003AE46 E308            	  3488:     lsl.b  #1,D0   ; ASL A
02:0003AE48 1940004D        	  3489:     move.b  D0,($004D,A4)
02:0003AE4C 6100008C        	  3490:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3491:     ; The leever has to face Link in order to move toward him.
                            	  3492:     ;
02:0003AE50 4EB90004C20E    	  3493:     jsr     ReverseObjDir
                            	  3494:     even
