                            	  2393: UpdateWhirlwind_Full:
                            	  2394:     ; Get Link's halted state.
                            	  2395:     ;
02:0002FC34 102C00AC        	  2396:     move.b  ($00AC,A4),D0
02:0002FC38 02000040        	  2397:     andi.b #$40,D0
02:0002FC3C 7600            	  2398:     moveq   #0,D3
02:0002FC3E 1600            	  2399:     move.b  D0,D3
                            	  2400:     ; Add 2 to whirlwind X.
                            	  2401:     ;
02:0002FC40 7002            	  2402:     moveq   #2,D0
02:0002FC42 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FC46 12342070        	  2404:     move.b  ($70,A4,D2.W),D1
02:0002FC4A D101            	  2405:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FC4C 19802070        	  2406:     move.b  D0,($70,A4,D2.W)
                            	  2407:     ; If Link is not halted or teleporting state = 0, then
                            	  2408:     ; go check for collision with Link.
                            	  2409:     ;
02:0002FC50 0C030040        	  2410:     cmpi.b  #$40,D3
02:0002FC54 6638            	  2411:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FC56 7600            	  2412:     moveq   #0,D3
02:0002FC58 162C0522        	  2413:     move.b  ($0522,A4),D3
02:0002FC5C 6730            	  2414:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2415:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2416:     ;
                            	  2417:     ; Set Link's X to whirlwind's.
                            	  2418:     ;
02:0002FC5E 19400070        	  2419:     move.b  D0,($0070,A4)
                            	  2420:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2421:     ; the right screen edge and draw.
                            	  2422:     ;
02:0002FC62 5303            	  2423:     subq.b  #1,D3
02:0002FC64 6776            	  2424:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FC66 0C000080        	  2425:     cmpi.b  #$80,D0
02:0002FC6A 6670            	  2426:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2427:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2428:     ;
                            	  2429:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2430:     ;
02:0002FC6C E308            	  2431:     lsl.b  #1,D0   ; ASL A
02:0002FC6E 194000AC        	  2432:     move.b  D0,($00AC,A4)
02:0002FC72 19400522        	  2433:     move.b  D0,($0522,A4)
02:0002FC76 41EC034F        	  2434:     lea     ($034F,A4),A0
02:0002FC7A 11802000        	  2435:     move.b  D0,(A0,D2.W)
                            	  2436:     ; Update the player position marker, and draw one last time.
                            	  2437:     ;
02:0002FC7E 1002            	  2438:     move.b  D2,D0
02:0002FC80 1B00            	  2439:     move.b  D0,-(A5)  ; PHA
02:0002FC82 610010F6        	  2440:     jsr     UpdatePlayerPositionMarker
02:0002FC86 101D            	  2441:     move.b  (A5)+,D0  ; PLA
02:0002FC88 7400            	  2442:     moveq   #0,D2
02:0002FC8A 1400            	  2443:     move.b  D0,D2
02:0002FC8C 6070            	  2444:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445: 
                            	  2446:     even
                            	  2447: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2448:     ; Link is not halted or teleporting state = 0.
                            	  2449:     ; Try to pick up Link.
                            	  2450:     ;
                            	  2451:     ; If the whirlwind does not collide with Link, then go check
                            	  2452:     ; for the screen's right edge.
                            	  2453:     ;
02:0002FC8E 61001E38        	  2454:     jsr     CheckLinkCollision
02:0002FC92 102C0006        	  2455:     move.b  ($0006,A4),D0
02:0002FC96 6744            	  2456:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2457:     ; Collided with Link.
                            	  2458:     ;
                            	  2459:     ; Make Link face right. Reset shove info and subroom type.
                            	  2460:     ;
02:0002FC98 7001            	  2461:     moveq   #1,D0
02:0002FC9A 19400098        	  2462:     move.b  D0,($0098,A4)
02:0002FC9E E208            	  2463:     lsr.b  #1,D0   ; LSR A
02:0002FCA0 194000C0        	  2464:     move.b  D0,($00C0,A4)
02:0002FCA4 194000D3        	  2465:     move.b  D0,($00D3,A4)
02:0002FCA8 1940005A        	  2466:     move.b  D0,($005A,A4)
                            	  2467:     ; Halt Link (state $40), and hide him.
                            	  2468:     ;
02:0002FCAC 7040            	  2469:     moveq   #64,D0
02:0002FCAE 194000AC        	  2470:     move.b  D0,($00AC,A4)
02:0002FCB2 103C00F8        	  2471:     move.b  #$F8,D0
02:0002FCB6 19400248        	  2472:     move.b  D0,($0248,A4)
02:0002FCBA 1940024C        	  2473:     move.b  D0,($024C,A4)
                            	  2474:     ; Find and set the room that will behave as the previous room
                            	  2475:     ; when scrolling right to the room with the level's entrance.
                            	  2476:     ;
02:0002FCBE 102C0523        	  2477:     move.b  ($0523,A4),D0
02:0002FCC2 02000007        	  2478:     andi.b #$07,D0
02:0002FCC6 7600            	  2479:     moveq   #0,D3
02:0002FCC8 1600            	  2480:     move.b  D0,D3
02:0002FCCA 41F90002FC2C    	  2481:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FCD0 10303000        	  2482:     move.b  (A0,D3.W),D0
02:0002FCD4 194000EA        	  2483:     move.b  D0,($00EA,A4)
                            	  2484:     ; Set teleporting state 1.
                            	  2485:     ;
02:0002FCD8 522C0522        	  2486:     addq.b  #1,($0522,A4)
                            	  2487:     even
                            	  2488: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2489:     ; If whirlwind's X < $F0, go draw.
                            	  2490:     ;
02:0002FCDC 10342070        	  2491:     move.b  ($70,A4,D2.W),D0
02:0002FCE0 0C0000F0        	  2492:     cmpi.b  #$F0,D0
02:0002FCE4 6518            	  2493:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2494:     ; The whirlwind has reached the right edge of the screen.
                            	  2495:     ;
                            	  2496:     ; Destroy the object.
                            	  2497:     ;
02:0002FCE6 611A            	  2498:     jsr     DestroyWhirlwind
                            	  2499:     ; If teleporting state <> 0, we picked up Link.
                            	  2500:     ; So, go to the next mode.
                            	  2501:     ;
                            	  2502:     ; Either way, draw one last time.
                            	  2503:     ;
02:0002FCE8 102C0522        	  2504:     move.b  ($0522,A4),D0
02:0002FCEC 6710            	  2505:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0002FCEE 1002            	  2506:     move.b  D2,D0
02:0002FCF0 1B00            	  2507:     move.b  D0,-(A5)  ; PHA
02:0002FCF2 4EB90004C184    	  2508:     jsr     GoToNextModeFromPlay
02:0002FCF8 101D            	  2509:     move.b  (A5)+,D0  ; PLA
02:0002FCFA 7400            	  2510:     moveq   #0,D2
02:0002FCFC 1400            	  2511:     move.b  D0,D2
                            	  2512:     even
                            	  2513: _L_z01_UpdateWhirlwind_Full_Draw:
02:0002FCFE 600000A8        	  2514:     jmp     DrawWhirlwind
                            	  2515: 
                            	  2516:     even
                            	  2517: DestroyWhirlwind:
02:0002FD02 6000BB10        	  2518:     jmp     c_destroy_whirlwind
                            	  2519: 
                            	  2520: SummonWhirlwind:
                            	  2521:     ; If not in mode 5, return.
                            	  2522:     ;
02:0002FD06 102C0012        	  2523:     move.b  ($0012,A4),D0
02:0002FD0A 0C000005        	  2524:     cmpi.b  #$05,D0
02:0002FD0E 6704            	  2525:     beq.s  __far_z_01_0016
02:0002FD10 60000094        	  2526:     jmp  L6104_Exit
                            	  2527: __far_z_01_0016:
                            	  2528:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2529:     ;
02:0002FD14 6178            	  2530:     jsr     AdvanceTeleportingLevelIndex
02:0002FD16 102C0523        	  2531:     move.b  ($0523,A4),D0
02:0002FD1A 02000007        	  2532:     andi.b #$07,D0
02:0002FD1E 7600            	  2533:     moveq   #0,D3
02:0002FD20 1600            	  2534:     move.b  D0,D3
02:0002FD22 41F90004AE96    	  2535:     lea     (LevelMasks).l,A0
02:0002FD28 10303000        	  2536:     move.b  (A0,D3.W),D0
02:0002FD2C 1880            	  2537:     move.b  D0,($0000,A4)
                            	  2538:     even
                            	  2539: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2540:     ; If there are no triforce pieces, then return.
                            	  2541:     ;
02:0002FD2E 102C0671        	  2542:     move.b  ($0671,A4),D0
02:0002FD32 6602            	  2543:     bne.s  __far_z_01_0017
02:0002FD34 6070            	  2544:     jmp  L6104_Exit
                            	  2545: __far_z_01_0017:
                            	  2546:     ; If we have gotten this triforce piece, then go try to make a
                            	  2547:     ; whirlwind.
                            	  2548:     ;
02:0002FD36 1214            	  2549:     move.b  ($0000,A4),D1
02:0002FD38 C200            	  2550:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FD3A 662C            	  2551:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2552:     ; We have not gotten this piece.
                            	  2553:     ; First, advance the teleporting index again.
                            	  2554:     ;
02:0002FD3C 6150            	  2555:     jsr     AdvanceTeleportingLevelIndex
                            	  2556:     ; If the direction Link is facing is an increasing one, then
                            	  2557:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2558:     ; level number. Then go test this new mask.
                            	  2559:     ;
02:0002FD3E 102C0098        	  2560:     move.b  ($0098,A4),D0
02:0002FD42 02000009        	  2561:     andi.b #$09,D0
02:0002FD46 6710            	  2562:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FD48 1214            	  2563:     move.b  ($0000,A4),D1
02:0002FD4A E309            	  2564:     lsl.b  #1,D1   ; ASL $00
02:0002FD4C 1881            	  2565:     move.b  D1,($0000,A4)
02:0002FD4E 64DE            	  2566:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FD50 1214            	  2567:     move.b  ($0000,A4),D1
02:0002FD52 E311            	  2568:     roxl.b  #1,D1   ; ROL $00
02:0002FD54 1881            	  2569:     move.b  D1,($0000,A4)
02:0002FD56 60D6            	  2570:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2571: 
                            	  2572:     even
                            	  2573: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2574:     ; If instead the direction is a decreasing one, then
                            	  2575:     ; rotate right to correspond to the lower level number.
                            	  2576:     ; Then go test this new mask.
                            	  2577:     ;
02:0002FD58 1214            	  2578:     move.b  ($0000,A4),D1
02:0002FD5A E209            	  2579:     lsr.b  #1,D1   ; LSR $00
02:0002FD5C 1881            	  2580:     move.b  D1,($0000,A4)
02:0002FD5E 64CE            	  2581:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FD60 1214            	  2582:     move.b  ($0000,A4),D1
02:0002FD62 E211            	  2583:     roxr.b  #1,D1   ; ROR $00
02:0002FD64 1881            	  2584:     move.b  D1,($0000,A4)
02:0002FD66 60C6            	  2585:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2586: 
                            	  2587:     even
                            	  2588: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  2589:     ; If already summoned or in the middle of teleporting, then
                            	  2590:     ; return and don't summon another one.
                            	  2591:     ;
02:0002FD68 102C0508        	  2592:     move.b  ($0508,A4),D0
02:0002FD6C 122C0522        	  2593:     move.b  ($0522,A4),D1
02:0002FD70 8001            	  2594:     or.b  D1,D0
02:0002FD72 6702            	  2595:     beq.s  __far_z_01_0018
02:0002FD74 6030            	  2596:     jmp  L6104_Exit
                            	  2597: __far_z_01_0018:
                            	  2598:     ; Return if we can't find an empty monster slot.
                            	  2599:     ;
02:0002FD76 4EB90004DB34    	  2600:     jsr     FindEmptyMonsterSlot
02:0002FD7C 6602            	  2601:     bne.s  __far_z_01_0019
02:0002FD7E 6026            	  2602:     jmp  L6104_Exit
                            	  2603: __far_z_01_0019:
                            	  2604:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  2605:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  2606:     ;
02:0002FD80 522C0508        	  2607:     addq.b  #1,($0508,A4)
02:0002FD84 1003            	  2608:     move.b  D3,D0
02:0002FD86 7400            	  2609:     moveq   #0,D2
02:0002FD88 1400            	  2610:     move.b  D0,D2
02:0002FD8A 6000FE9C        	  2611:     jmp     SetUpWhirlwind
                            	  2612: 
                            	  2613:     even
                            	  2614: AdvanceTeleportingLevelIndex:
                            	  2615:     ; If Link is facing an increasing direction (right or down), then
                            	  2616:     ; increase the index. Otherwise, decrease it.
                            	  2617:     ;
02:0002FD8E 522C0523        	  2618:     addq.b  #1,($0523,A4)
02:0002FD92 102C0098        	  2619:     move.b  ($0098,A4),D0
02:0002FD96 02000009        	  2620:     andi.b #$09,D0
02:0002FD9A 6702            	  2621:     beq.s  __far_z_01_0020
02:0002FD9C 6008            	  2622:     jmp  L6104_Exit
                            	  2623: __far_z_01_0020:
02:0002FD9E 532C0523        	  2624:     subq.b  #1,($0523,A4)
02:0002FDA2 532C0523        	  2625:     subq.b  #1,($0523,A4)
                            	  2626:     even
                            	  2627: L6104_Exit:
02:0002FDA6 4E75            	  2628:     rts
                            	  2629: 
                            	  2630:     even
                            	  2631: DrawWhirlwind:
                            	  2632:     ; Frames last 1 screen frame.
                            	  2633:     ;
02:0002FDA8 7001            	  2634:     moveq   #1,D0
02:0002FDAA 4EB90004D33E    	  2635:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  2636:     ; The whirlwind flashes by using a palette row based on the
                            	  2637:     ; screen frame counter.
                            	  2638:     ;
02:0002FDB0 102C0015        	  2639:     move.b  ($0015,A4),D0
02:0002FDB4 02000003        	  2640:     andi.b #$03,D0
02:0002FDB8 61001B3A        	  2641:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2642:     ; Flip horizontally based on movement frame, which is
                            	  2643:     ; switched based on animation counter.
                            	  2644:     ;
02:0002FDBC 4EB90004D316    	  2645:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0002FDC2 7000            	  2646:     moveq   #0,D0
02:0002FDC4 6000183C        	  2647:     jmp     DrawObjectNotMirrored
                            	  2648: 
                            	  2649:     even
