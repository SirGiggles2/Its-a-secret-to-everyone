02:0004CA3A 11802000        	  5876:     move.b  D0,(A0,D2.W)
                            	  5877:     ; If facing left and X < 2, then go change state to $40. The
                            	  5878:     ; boomerang is too close to the left edge of the screen.
                            	  5879:     ; Another move might make it wrap around.
                            	  5880:     ;
02:0004CA3E 41EC0098        	  5881:     lea     ($0098,A4),A0
