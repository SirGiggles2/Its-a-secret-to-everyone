02:00031B42 123C0008        	  6749:     move.b  #$08,D1
02:00031B46 D101            	  6750:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031B48 19400004        	  6751:     move.b  D0,($0004,A4)
02:00031B4C 102C0084        	  6752:     move.b  ($0084,A4),D0
02:00031B50 023C00EE        	  6753:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031B54 123C0008        	  6754:     move.b  #$08,D1
02:00031B58 D101            	  6755:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031B5A 19400005        	  6756:     move.b  D0,($0005,A4)
