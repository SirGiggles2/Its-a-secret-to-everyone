02:0004CB5E 41EC0098        	  6040:     lea     ($0098,A4),A0
02:0004CB62 11802000        	  6041:     move.b  D0,(A0,D2.W)
02:0004CB66 6100F42A        	  6042:     jsr     MoveObject
                            	  6043:     even
                            	  6044: AnimateBoomerangAndCheckCollision:
                            	  6045:     ; Decrement animation counter; and when it reaches 0:
                            	  6046:     ; 1. arm it again for 2 frames
                            	  6047:     ; 2. advance the minor state within a cycle of 8
                            	  6048:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  6049:     ;
02:0004CB6A 41EC03D0        	  6050:     lea     ($03D0,A4),A0
02:0004CB6E 53302000        	  6051:     subq.b  #1,(A0,D2.W)
02:0004CB72 6702            	  6052:     beq.s  __far_z_07_0090
02:0004CB74 6036            	  6053:     jmp  DrawBoomerangAndCheckCollision
                            	  6054: __far_z_07_0090:
02:0004CB76 7002            	  6055:     moveq   #2,D0
02:0004CB78 41EC03D0        	  6056:     lea     ($03D0,A4),A0
02:0004CB7C 11802000        	  6057:     move.b  D0,(A0,D2.W)
02:0004CB80 41EC00AC        	  6058:     lea     ($00AC,A4),A0
02:0004CB84 52302000        	  6059:     addq.b  #1,(A0,D2.W)
02:0004CB88 41EC00AC        	  6060:     lea     ($00AC,A4),A0
02:0004CB8C 10302000        	  6061:     move.b  (A0,D2.W),D0
02:0004CB90 02000077        	  6062:     andi.b #$77,D0
02:0004CB94 41EC00AC        	  6063:     lea     ($00AC,A4),A0
02:0004CB98 11802000        	  6064:     move.b  D0,(A0,D2.W)
02:0004CB9C 0C02000D        	  6065:     cmpi.b  #$0D,D2
02:0004CBA0 6402            	  6066:     bcc.s  __far_z_07_0091
02:0004CBA2 6032            	  6067:     jmp  CalcBoomerangFrame
                            	  6068: __far_z_07_0091:
02:0004CBA4 7602            	  6069:     moveq   #2,D3
02:0004CBA6 4EB90003064A    	  6070:     jsr     PlayBoomerangSfx
                            	  6071:     even
                            	  6072: DrawBoomerangAndCheckCollision:
                            	  6073:     ; If the boomerang belongs to a monster, then check for
                            	  6074:     ; collision with Link.
                            	  6075:     ;
                            	  6076:     ; If they collide, then set state $20 and animation counter 3.
                            	  6077:     ;
02:0004CBAC 0C02000D        	  6078:     cmpi.b  #$0D,D2
02:0004CBB0 6502            	  6079:     bcs.s  __far_z_07_0092
02:0004CBB2 6022            	  6080:     jmp  CalcBoomerangFrame
