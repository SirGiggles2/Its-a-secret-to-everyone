                            	  8348: Submenu_CueTransferRowOW:
                            	  8349:     ;
                            	  8350:     ;
                            	  8351:     ; If menu scroll value is negative, then we transferred everything.
                            	  8352:     ; So, return.
                            	  8353:     ;
