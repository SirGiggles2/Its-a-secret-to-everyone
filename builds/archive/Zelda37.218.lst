                            	  4007: UpdateArmos:
02:0003B1BC 6100E73E        	  4008:     jsr     UpdateGoriya
                            	  4009:     ; If it's still shoved, then don't animate. Only go draw.
                            	  4010:     ;
02:0003B1C0 41EC00C0        	  4011:     lea     ($00C0,A4),A0
02:0003B1C4 10302000        	  4012:     move.b  (A0,D2.W),D0
02:0003B1C8 6702            	  4013:     beq.s  __far_z_04_0035
02:0003B1CA 602A            	  4014:     jmp  DrawArmosAndCheckCollisions
                            	  4015: __far_z_04_0035:
                            	  4016:     ; Animate.
                            	  4017:     ;
                            	  4018:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  4019:     ; then only go draw.
                            	  4020:     ;
02:0003B1CC 41EC03D0        	  4021:     lea     ($03D0,A4),A0
02:0003B1D0 53302000        	  4022:     subq.b  #1,(A0,D2.W)
02:0003B1D4 6702            	  4023:     beq.s  __far_z_04_0036
02:0003B1D6 601E            	  4024:     jmp  DrawArmosAndCheckCollisions
                            	  4025: __far_z_04_0036:
                            	  4026:     ; Armos animation frames last 6 screen frames.
                            	  4027:     ;
02:0003B1D8 7006            	  4028:     moveq   #6,D0
02:0003B1DA 41EC03D0        	  4029:     lea     ($03D0,A4),A0
02:0003B1DE 11802000        	  4030:     move.b  D0,(A0,D2.W)
                            	  4031:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4032:     ; change the position of the shield. To keep fixed it in place,
                            	  4033:     ; there are separate frame images for each animation frame.
                            	  4034:     ;
                            	  4035:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4036:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4037:     ;
                            	  4038:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4039:     ; Then choose the direction at the point of drawing below.
                            	  4040:     ;
02:0003B1E2 41EC03E4        	  4041:     lea     ($03E4,A4),A0
02:0003B1E6 10302000        	  4042:     move.b  (A0,D2.W),D0
02:0003B1EA 0A000002        	  4043:     eori.b #$02,D0
02:0003B1EE 41EC03E4        	  4044:     lea     ($03E4,A4),A0
02:0003B1F2 11802000        	  4045:     move.b  D0,(A0,D2.W)
                            	  4046:     even
                            	  4047: DrawArmosAndCheckCollisions:
02:0003B1F6 4EB90004D344    	  4048:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B1FC 7600            	  4049:     moveq   #0,D3
02:0003B1FE 41EC0098        	  4050:     lea     ($0098,A4),A0
02:0003B202 16302000        	  4051:     move.b  (A0,D2.W),D3
                            	  4052:     ; If facing up, then use the second frame image in the set ("back").
                            	  4053:     ; Else use the second.
                            	  4054:     ;
02:0003B206 0C030008        	  4055:     cmpi.b  #$08,D3
02:0003B20A 6602            	  4056:     bne  _anon_z04_54
02:0003B20C 7001            	  4057:     moveq   #1,D0
                            	  4058: _anon_z04_54:
02:0003B20E 023C00EE        	  4059:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B212 41EC03E4        	  4060:     lea     ($03E4,A4),A0
02:0003B216 12302000        	  4061:     move.b  (A0,D2.W),D1
02:0003B21A D101            	  4062:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B21C 4EB900031602    	  4063:     jsr     DrawObjectNotMirrored
                            	  4064:     ; If the armos is still fading in, then go for check collision with Link,
                            	  4065:     ; but not with weapons.
                            	  4066:     ;
02:0003B222 10342028        	  4067:     move.b  ($28,A4,D2.W),D0
02:0003B226 661C            	  4068:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  4069:     ; Else check for all collisions.
                            	  4070:     ;
02:0003B228 4EB90003197E    	  4071:     jsr     CheckMonsterCollisions
                            	  4072:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  4073:     ;
02:0003B22E 41EC0405        	  4074:     lea     ($0405,A4),A0
02:0003B232 10302000        	  4075:     move.b  (A0,D2.W),D0
02:0003B236 670A            	  4076:     beq  _anon_z04_55
02:0003B238 705D            	  4077:     moveq   #93,D0
02:0003B23A 41EC034F        	  4078:     lea     ($034F,A4),A0
02:0003B23E 11802000        	  4079:     move.b  D0,(A0,D2.W)
