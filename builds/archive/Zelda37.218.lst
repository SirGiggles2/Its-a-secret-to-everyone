                            	 12345:     ;
                            	 12346:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12347:     ;
                            	 12348:     ; Start with a mask of $A1 in [02]:
                            	 12349:     ; - low nibble represents the right direction
                            	 12350:     ; - high nibble is used to set or clear carry as we go along
