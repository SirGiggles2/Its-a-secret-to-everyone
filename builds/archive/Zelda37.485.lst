                            	  7781: UpdatePatraChild:
                            	  7782:     ; If state = 1, then go orbit.
                            	  7783:     ;
02:0003B8DC 41EC00AC        	  7784:     lea     ($00AC,A4),A0
02:0003B8E0 10302000        	  7785:     move.b  (A0,D2.W),D0
02:0003B8E4 6704            	  7786:     beq.s  __far_z_04_0086
02:0003B8E6 6000009E        	  7787:     jmp  PatraChild_State1
                            	  7788: __far_z_04_0086:
                            	  7789:     ; State = 0.
                            	  7790:     ;
                            	  7791:     ; If the current object slot is 2, then go initialize the patra child.
                            	  7792:     ; This is the only patra child shown in the first fame.
                            	  7793:     ;
02:0003B8EA 0C020002        	  7794:     cmpi.b  #$02,D2
02:0003B8EE 6732            	  7795:     beq  _L_z04_UpdatePatraChild_Ready
                            	  7796:     ; The patra child in slot 2 is the last one to be updated.
                            	  7797:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  7798:     ;
                            	  7799:     ; This means that in the first frame, slot 2 is the only one to be
                            	  7800:     ; shown.
                            	  7801:     ;
02:0003B8F0 102C00AE        	  7802:     move.b  ($00AE,A4),D0
02:0003B8F4 6700008E        	  7803:     beq  _L_z04_UpdatePatraChild_Exit
                            	  7804:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  7805:     ; here to wait to be shown at the top position (N) one at a time.
                            	  7806:     ;
02:0003B8F8 1002            	  7807:     move.b  D2,D0
                            	  7808:     ; Subtract 3 from the object slot to get the angle where the
                            	  7809:     ; patra child in object slot 2 should be for the current one to appear.
                            	  7810:     ;
02:0003B8FA 003C0011        	  7811:     ori     #$11,CCR  ; SEC: set C+X
02:0003B8FE 123C0003        	  7812:     move.b  #$03,D1
02:0003B902 0A3C0010        	  7813:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B906 9101            	  7814:     subx.b  D1,D0   ; SBC #$03
02:0003B908 0A3C0010        	  7815:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B90C 7600            	  7816:     moveq   #0,D3
02:0003B90E 1600            	  7817:     move.b  D0,D3
                            	  7818:     ; If the patra child in slot 2 has not reached the required angle,
                            	  7819:     ; then return.
                            	  7820:     ;
02:0003B910 102C0396        	  7821:     move.b  ($0396,A4),D0
02:0003B914 41F90003B8CE    	  7822:     lea     (PatraChildStartAngles).l,A0
02:0003B91A 12303000        	  7823:     move.b  (A0,D3.W),D1
02:0003B91E B001            	  7824:     cmp.b   D1,D0
02:0003B920 6662            	  7825:     bne  _L_z04_UpdatePatraChild_Exit
                            	  7826:     even
                            	  7827: _L_z04_UpdatePatraChild_Ready:
                            	  7828:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  7829:     ; the patra parent's state.
                            	  7830:     ;
02:0003B922 0C020009        	  7831:     cmpi.b  #$09,D2
02:0003B926 6604            	  7832:     bne  _anon_z04_157
02:0003B928 522C00AD        	  7833:     addq.b  #1,($00AD,A4)
                            	  7834: _anon_z04_157:
                            	  7835:     ; Go to state 1 to orbit.
                            	  7836:     ;
02:0003B92C 41EC00AC        	  7837:     lea     ($00AC,A4),A0
02:0003B930 52302000        	  7838:     addq.b  #1,(A0,D2.W)
                            	  7839:     ; TODO: ?
                            	  7840:     ;
02:0003B934 103C0080        	  7841:     move.b  #$80,D0
02:0003B938 41EC0098        	  7842:     lea     ($0098,A4),A0
02:0003B93C 11802000        	  7843:     move.b  D0,(A0,D2.W)
                            	  7844:     ; Set angle $18 (N).
                            	  7845:     ;
02:0003B940 7018            	  7846:     moveq   #24,D0
02:0003B942 41EC0394        	  7847:     lea     ($0394,A4),A0
02:0003B946 11802000        	  7848:     move.b  D0,(A0,D2.W)
                            	  7849:     ; This location is right above Patra.
                            	  7850:     ; Set X coordinate to Patra's.
                            	  7851:     ;
02:0003B94A 102C0071        	  7852:     move.b  ($0071,A4),D0
02:0003B94E 19802070        	  7853:     move.b  D0,($70,A4,D2.W)
                            	  7854:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  7855:     ; Else use radius $18. Store the chosen value in [00].
                            	  7856:     ;
02:0003B952 702C            	  7857:     moveq   #44,D0
02:0003B954 7600            	  7858:     moveq   #0,D3
02:0003B956 41EC034F        	  7859:     lea     ($034F,A4),A0
02:0003B95A 16302000        	  7860:     move.b  (A0,D2.W),D3
02:0003B95E 0C030025        	  7861:     cmpi.b  #$25,D3
02:0003B962 6702            	  7862:     beq  _anon_z04_158
02:0003B964 7018            	  7863:     moveq   #24,D0
                            	  7864: _anon_z04_158:
02:0003B966 1880            	  7865:     move.b  D0,($0000,A4)
                            	  7866:     ; This location is right above Patra.
                            	  7867:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  7868:     ;
02:0003B968 102C0085        	  7869:     move.b  ($0085,A4),D0
02:0003B96C 003C0011        	  7870:     ori     #$11,CCR  ; SEC: set C+X
02:0003B970 1214            	  7871:     move.b  ($0000,A4),D1
02:0003B972 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B976 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B978 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B97C 41EC0084        	  7875:     lea     ($0084,A4),A0
02:0003B980 11802000        	  7876:     move.b  D0,(A0,D2.W)
                            	  7877:     even
                            	  7878: _L_z04_UpdatePatraChild_Exit:
02:0003B984 4E75            	  7879:     rts
                            	  7880: 
