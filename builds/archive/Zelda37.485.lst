                            	  1841: 
                            	  1842: ; Maps an item slot to a value used in calculating the
                            	  1843: ; sprite palette row attribute.
                            	  1844: ;
                            	  1845: ; For most items, the value is the sprite palette row attribute
                            	  1846: ; itself.
                            	  1847: ;
                            	  1848: ; Some items will use the value as an amount to add to the
                            	  1849: ; item value in the slot.
                            	  1850: ;
                            	  1851:     even
