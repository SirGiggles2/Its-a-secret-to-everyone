02:0002CE14 242F000C        	  4582:     move.l  12(SP),D2       ; slot arg → D2
02:0002CE18 4EB90003C23C    	  4583:     jsr     ShootLimited
02:0002CE1E 7000            	  4584:     moveq   #0,D0
02:0002CE20 6406            	  4585:     bcc.s   .csl_no_carry
02:0002CE22 008000000100    	  4586:     ori.l   #$100,D0
                            	  4587: .csl_no_carry:
02:0002CE28 1003            	  4588:     move.b  D3,D0           ; low byte = new child slot
02:0002CE2A 261F            	  4589:     move.l  (SP)+,D3
02:0002CE2C 241F            	  4590:     move.l  (SP)+,D2
02:0002CE2E 4E75            	  4591:     rts
