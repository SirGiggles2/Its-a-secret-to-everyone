                            	   678: 
                            	   679: ;==============================================================================
                            	   680: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   681: ;
                            	   682: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   683: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   684: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   685: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   686: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   687: ;
                            	   688: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   689: ;
                            	   690: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   691: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   692: ;==============================================================================
                            	   693:     ifne DEBUG_TELEPORT
                            	   694: _debug_teleport_check:
                            	   695:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   696:     tst.b   ($0010,A4)
                            	   697:     bne     .dtc_no
                            	   698:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   699:     cmpi.b  #$05,($0012,A4)
                            	   700:     bne     .dtc_no
                            	   701:     tst.b   ($0013,A4)
                            	   702:     bne     .dtc_no
                            	   703:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   704:     ;
                            	   705:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   706:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   707:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   708:     ; So the bit map is:
                            	   709:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   710:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   711:     move.b  ($00F8,A4),D1
                            	   712:     andi.b  #$0F,D1
                            	   713:     beq     .dtc_no
                            	   714:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   715:     moveq   #0,D0
                            	   716:     btst    #3,D1                   ; Up
                            	   717:     bne.s   .dtc_dir_set
                            	   718:     moveq   #1,D0
                            	   719:     btst    #2,D1                   ; Down
                            	   720:     bne.s   .dtc_dir_set
                            	   721:     moveq   #2,D0
                            	   722:     btst    #1,D1                   ; Left
                            	   723:     bne.s   .dtc_dir_set
                            	   724:     moveq   #3,D0                   ; Right (bit 0)
                            	   725: .dtc_dir_set:
                            	   726:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   727:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   728:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   729:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   730:     move.b  ($00EB,A4),D2
                            	   731:     move.b  D2,D3
                            	   732:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   733:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   734:     tst.b   D0
                            	   735:     bne.s   .dtc_not_up
                            	   736:     tst.b   D2
                            	   737:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   738:     bra.s   .dtc_apply
                            	   739: .dtc_not_up:
                            	   740:     cmpi.b  #1,D0
                            	   741:     bne.s   .dtc_not_down
                            	   742:     cmpi.b  #7,D2
                            	   743:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   744:     bra.s   .dtc_apply
                            	   745: .dtc_not_down:
                            	   746:     cmpi.b  #2,D0
                            	   747:     bne.s   .dtc_not_left
                            	   748:     tst.b   D3
                            	   749:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   750:     bra.s   .dtc_apply
                            	   751: .dtc_not_left:
                            	   752:     cmpi.b  #$0F,D3
                            	   753:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   754: .dtc_apply:
                            	   755:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   756:     lea     (NextRoomIdOffsets).l,A0
                            	   757:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   758:     move.b  ($00EB,A4),D0
                            	   759:     add.b   D1,D0
                            	   760:     move.b  D0,($00EB,A4)
                            	   761:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   762:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   763:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   764:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   765:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   766:     ; movement update doesn't immediately retrigger the edge.
                            	   767:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   768:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   769:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   770:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   771:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   772:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   773:     ; skip that setup.
                            	   774:     jsr     LayOutRoom
                            	   775:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   776:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   777:     ; kick that from here with arbitrary state causes crashes when the
                            	   778:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   779:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   780:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   781:     ; per target room.
                            	   782:     clr.b   ($00F8,A4)
                            	   783:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   784:                                          ; doesn't walk during sweep settle
                            	   785:     moveq   #1,D0
                            	   786:     rts
                            	   787: .dtc_edge:
                            	   788:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   789:     ; interpret it as "walk into wall" animation.
                            	   790:     clr.b   ($00F8,A4)
                            	   791:     clr.b   ($00FA,A4)
                            	   792:     moveq   #1,D0
                            	   793:     rts
                            	   794: .dtc_no:
                            	   795:     moveq   #0,D0
                            	   796:     rts
                            	   797:     endc
                            	   798: 
                            	   799: ;==============================================================================
                            	   800: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   801: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   802: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   803: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   804: ;==============================================================================
                            	   805:     ifne TURBO_LINK
                            	   806: _turbo_link_boost:
                            	   807:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   808:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   809:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   810:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A24 4E75            	   811:     rts
                            	   812: _turbo_link_boost_disabled:
                            	   813:     ; OW gate
02:00049A26 4A2C0010        	   814:     tst.b   ($0010,A4)
02:00049A2A 6670            	   815:     bne     .tlb_exit
                            	   816:     ; Mode 5 / Submode 0 only
02:00049A2C 0C2C00050012    	   817:     cmpi.b  #$05,($0012,A4)
02:00049A32 6668            	   818:     bne     .tlb_exit
02:00049A34 4A2C0013        	   819:     tst.b   ($0013,A4)
02:00049A38 6662            	   820:     bne     .tlb_exit
                            	   821:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049A3A 122C00FA        	   822:     move.b  ($00FA,A4),D1
02:00049A3E 0201000F        	   823:     andi.b  #$0F,D1
02:00049A42 6758            	   824:     beq     .tlb_exit
                            	   825:     ; Edge-safe clamps.
02:00049A44 08010003        	   826:     btst    #3,D1                   ; Up (bit 3)
02:00049A48 6710            	   827:     beq     .tlb_no_up
02:00049A4A 102C0084        	   828:     move.b  ($0084,A4),D0
02:00049A4E 0C000040        	   829:     cmpi.b  #$40,D0
02:00049A52 6306            	   830:     bls     .tlb_no_up
02:00049A54 5900            	   831:     subi.b  #4,D0
02:00049A56 19400084        	   832:     move.b  D0,($0084,A4)
                            	   833: .tlb_no_up:
02:00049A5A 08010002        	   834:     btst    #2,D1                   ; Down (bit 2)
02:00049A5E 6710            	   835:     beq     .tlb_no_down
02:00049A60 102C0084        	   836:     move.b  ($0084,A4),D0
02:00049A64 0C0000D0        	   837:     cmpi.b  #$D0,D0
02:00049A68 6406            	   838:     bcc     .tlb_no_down
02:00049A6A 5800            	   839:     addi.b  #4,D0
02:00049A6C 19400084        	   840:     move.b  D0,($0084,A4)
                            	   841: .tlb_no_down:
02:00049A70 08010001        	   842:     btst    #1,D1                   ; Left (bit 1)
02:00049A74 6710            	   843:     beq     .tlb_no_left
02:00049A76 102C0070        	   844:     move.b  ($0070,A4),D0
02:00049A7A 0C00000A        	   845:     cmpi.b  #$0A,D0
02:00049A7E 6306            	   846:     bls     .tlb_no_left
02:00049A80 5900            	   847:     subi.b  #4,D0
02:00049A82 19400070        	   848:     move.b  D0,($0070,A4)
                            	   849: .tlb_no_left:
02:00049A86 08010000        	   850:     btst    #0,D1                   ; Right (bit 0)
02:00049A8A 6710            	   851:     beq     .tlb_no_right
02:00049A8C 102C0070        	   852:     move.b  ($0070,A4),D0
02:00049A90 0C0000E6        	   853:     cmpi.b  #$E6,D0
02:00049A94 6406            	   854:     bcc     .tlb_no_right
02:00049A96 5800            	   855:     addi.b  #4,D0
02:00049A98 19400070        	   856:     move.b  D0,($0070,A4)
                            	   857: .tlb_no_right:
                            	   858: .tlb_exit:
02:00049A9C 4E75            	   859:     rts
                            	   860:     endc
