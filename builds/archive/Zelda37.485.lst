                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:00039112 102C0084        	  2425:     move.b  ($0084,A4),D0
02:00039116 0C0000AD        	  2426:     cmpi.b  #$AD,D0
02:0003911A 661E            	  2427:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2428:     ; If Link's X < $70 or >= $81, then return.
                            	  2429:     ;
02:0003911C 102C0070        	  2430:     move.b  ($0070,A4),D0
02:00039120 0C000070        	  2431:     cmpi.b  #$70,D0
02:00039124 6514            	  2432:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039126 0C000081        	  2433:     cmpi.b  #$81,D0
02:0003912A 640E            	  2434:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2435:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2436:     ; halt Link, and start filling hearts.
                            	  2437:     ;
02:0003912C 522C00AD        	  2438:     addq.b  #1,($00AD,A4)
02:00039130 7040            	  2439:     moveq   #64,D0
02:00039132 194000AC        	  2440:     move.b  D0,($00AC,A4)
02:00039136 19400063        	  2441:     move.b  D0,($0063,A4)
                            	  2442:     even
                            	  2443: _L_z04_UpdatePondFairy_Exit:
