                            	  3240:     ; the last object slot for monsters and tile objects
                            	  3241:     ;
                            	  3242:     ; Before the first frame of mode 5, the current object slot variable
                            	  3243:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3244:     ;
                            	  3245:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3246:     ;
02:0004797A 700B            	  3247:     moveq   #11,D0
02:0004797C 19400340        	  3248:     move.b  D0,($0340,A4)
