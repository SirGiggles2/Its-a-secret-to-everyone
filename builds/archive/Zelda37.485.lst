02:00038E74 103C00A0        	  2018:     move.b  #$A0,D0
02:00038E78 7600            	  2019:     moveq   #0,D3
02:00038E7A 41EC034F        	  2020:     lea     ($034F,A4),A0
02:00038E7E 16302000        	  2021:     move.b  (A0,D2.W),D3
02:00038E82 0C030009        	  2022:     cmpi.b  #$09,D3
02:00038E86 6402            	  2023:     bcc  _anon_z04_48
02:00038E88 7070            	  2024:     moveq   #112,D0
                            	  2025: _anon_z04_48:
02:00038E8A 41EC041F        	  2026:     lea     ($041F,A4),A0
02:00038E8E 11802000        	  2027:     move.b  D0,(A0,D2.W)
02:00038E92 6100F372        	  2028:     jsr     Wanderer_TargetPlayer
                            	  2029:     ; If the octorock is slow, then use q-speed $20.
                            	  2030:     ; Else double it.
                            	  2031:     ;
02:00038E96 7020            	  2032:     moveq   #32,D0
02:00038E98 7600            	  2033:     moveq   #0,D3
02:00038E9A 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038E9E 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038EA2 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038EA6 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038EA8 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038EAC 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038EAE E308            	  2040:     lsl.b  #1,D0   ; ASL A
                            	  2041:     even
                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038EB0 7653            	  2045:     moveq   #83,D3
02:00038EB2 6100F97C        	  2046:     jsr     _TryShooting
02:00038EB6 4EB900049092    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038EBC 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038EC0 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038EC4 7600            	  2052:     moveq   #0,D3
02:00038EC6 1600            	  2053:     move.b  D0,D3
02:00038EC8 0200000C        	  2054:     andi.b #$0C,D0
02:00038ECC 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038ECE 7002            	  2056:     moveq   #2,D0
02:00038ED0 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038ED4 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
                            	  2060:     ;
02:00038ED6 7001            	  2061:     moveq   #1,D0
