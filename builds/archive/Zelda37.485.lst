02:00041A90 162C00EB        	  9056:     move.b  ($00EB,A4),D3
02:00041A94 41F900FF6A7E    	  9057:     lea     (NES_SRAM+$0A7E).l,A0
02:00041A9A 10303000        	  9058:     move.b  (A0,D3.W),D0
