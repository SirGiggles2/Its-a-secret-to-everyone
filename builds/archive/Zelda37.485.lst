                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002A9F4 0000E9F4        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002A9F8 000129F4
02:0002A9FC 000169F4        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002AA00 0001A9F4
02:0002AA04 0001E9F4        	  1715:     dc.l    _nes_bank_04_data, _nes_bank_05_data
02:0002AA08 000229F4
02:0002AA0C 000269F4        	  1716:     dc.l    _nes_bank_06_data, 0
