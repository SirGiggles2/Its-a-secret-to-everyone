02:00038E26 6506            	  1983:     bcs  _anon_z04_47
02:00038E28 532C0510        	  1984:     subq.b  #1,($0510,A4)
02:00038E2C 7000            	  1985:     moveq   #0,D0
                            	  1986: _anon_z04_47:
