02:0000E436 650A            	   812:     blo.s   .nt_no_a_mirror
02:0000E438 0C412800        	   813:     cmpi.w  #$2800,D1
02:0000E43C 6404            	   814:     bhs.s   .nt_no_a_mirror
02:0000E43E 04410400        	   815:     subi.w  #$0400,D1
                            	   816: .nt_no_a_mirror:
                            	   817: 
                            	   818:     ; Dispatch on NT_A vs NT_B tile ranges.
02:0000E442 0C412800        	   819:     cmpi.w  #$2800,D1
