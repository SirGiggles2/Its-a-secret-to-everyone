                            	  3166:     ; If the value is 0 (Link *is* the target), then
                            	  3167:     ; skip this and go update objects.
                            	  3168:     ;
02:000478EC 102C0060        	  3169:     move.b  ($0060,A4),D0
02:000478F0 0A000001        	  3170:     eori.b #$01,D0
02:000478F4 19400060        	  3171:     move.b  D0,($0060,A4)
02:000478F8 671C            	  3172:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3173:     ; If Link's X has not changed since the last frame
                            	  3174:     ; (when Link was the target), then XOR the chase target
                            	  3175:     ; coordinates (which were Link's coordinates last frame).
                            	  3176:     ;
                            	  3177:     ; This ends up reflecting Link's coordinates across the room;
                            	  3178:     ; so that monsters chase away from him.
                            	  3179:     ;
                            	  3180:     ; But if Link's X has changed since the last frame, then
                            	  3181:     ; leave the chase target coordinates with his old coordinates.
                            	  3182:     ;
02:000478FA 102C0061        	  3183:     move.b  ($0061,A4),D0
02:000478FE 122C0070        	  3184:     move.b  ($0070,A4),D1
02:00047902 B001            	  3185:     cmp.b   D1,D0
02:00047904 6610            	  3186:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:00047906 4600            	  3187:     eori.b #$FF,D0
02:00047908 19400061        	  3188:     move.b  D0,($0061,A4)
02:0004790C 102C0062        	  3189:     move.b  ($0062,A4),D0
02:00047910 4600            	  3190:     eori.b #$FF,D0
02:00047912 19400062        	  3191:     move.b  D0,($0062,A4)
                            	  3192:     even
