02:0002B5FA EB4E            	  3529:     lsl.w   #5,D6                   ; * $20
02:0002B5FC 02400003        	  3530:     andi.w  #$0003,D0               ; color slot
02:0002B600 E348            	  3531:     lsl.w   #1,D0                   ; * 2
