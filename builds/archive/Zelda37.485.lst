02:00039910 61000082        	  3527:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  3528:     ; The default image is the hand open.
                            	  3529:     ; If animation frame = 0, then return.
                            	  3530:     ;
02:00039914 7400            	  3531:     moveq   #0,D2
02:00039916 142C0340        	  3532:     move.b  ($0340,A4),D2
02:0003991A 41EC03E4        	  3533:     lea     ($03E4,A4),A0
02:0003991E 10302000        	  3534:     move.b  (A0,D2.W),D0
02:00039922 6724            	  3535:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  3536:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  3537:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  3538:     ; The right side is correctly the right side of a closed hand.
                            	  3539:     ; But the left side is Keese. So, we have to patch the left
                            	  3540:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  3541:     ;
                            	  3542:     ; Keep in mind that left and right sprites might be flipped.
                            	  3543:     ;
02:00039924 7600            	  3544:     moveq   #0,D3
02:00039926 1614            	  3545:     move.b  ($0000,A4),D3
02:00039928 41EC0201        	  3546:     lea     ($0201,A4),A0
02:0003992C 10303000        	  3547:     move.b  (A0,D3.W),D0
02:00039930 0C00009C        	  3548:     cmpi.b  #$9C,D0
02:00039934 6706            	  3549:     beq  _anon_z04_68
02:00039936 7600            	  3550:     moveq   #0,D3
02:00039938 162C0001        	  3551:     move.b  ($0001,A4),D3
                            	  3552: _anon_z04_68:
