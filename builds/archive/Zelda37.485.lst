                            	  4781: Aquamentus_Draw:
                            	  4782:     ; Every $10 screen frames, switch animation frames.
                            	  4783:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  4784:     ; The last tile of frame 0 is at index 5.
                            	  4785:     ; The last tile of frame 1 is at index $B.
                            	  4786:     ;
02:0003A23A 7605            	  4787:     moveq   #5,D3
02:0003A23C 102C0015        	  4788:     move.b  ($0015,A4),D0
02:0003A240 02000010        	  4789:     andi.b #$10,D0
02:0003A244 6602            	  4790:     bne  _anon_z04_88
02:0003A246 760B            	  4791:     moveq   #11,D3
                            	  4792: _anon_z04_88:
02:0003A248 1943000A        	  4793:     move.b  D3,($000A,A4)
                            	  4794:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  4795:     ;
02:0003A24C 7005            	  4796:     moveq   #5,D0
02:0003A24E 1940000B        	  4797:     move.b  D0,($000B,A4)
                            	  4798:     even
                            	  4799: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A252 7600            	  4800:     moveq   #0,D3
02:0003A254 162C000B        	  4801:     move.b  ($000B,A4),D3
                            	  4802:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  4803:     ; Store it in [00].
                            	  4804:     ;
02:0003A258 10342070        	  4805:     move.b  ($70,A4,D2.W),D0
02:0003A25C 023C00EE        	  4806:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A260 41F90003A234    	  4807:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A266 12303000        	  4808:     move.b  (A0,D3.W),D1
02:0003A26A D101            	  4809:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A26C 1880            	  4810:     move.b  D0,($0000,A4)
                            	  4811:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  4812:     ; Store it in [01].
                            	  4813:     ;
02:0003A26E 41EC0084        	  4814:     lea     ($0084,A4),A0
02:0003A272 10302000        	  4815:     move.b  (A0,D2.W),D0
02:0003A276 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A27A 41F90003A22E    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A280 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A284 D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A286 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A28A 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A28E 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A292 02000003        	  4832:     andi.b #$03,D0
02:0003A296 0A000003        	  4833:     eori.b #$03,D0
02:0003A29A 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A29E 7600            	  4835:     moveq   #0,D3
02:0003A2A0 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A2A4 41F90003A222    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A2AA 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A2AE 12390003A222    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A2B4 B001            	  4843:     cmp.b   D1,D0
02:0003A2B6 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
