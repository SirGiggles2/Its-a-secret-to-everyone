02:00048486 123C0001        	  4968:     move.b  #$01,D1
02:0004848A D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004848C 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
