02:0003BACE 19400505        	  8065:     move.b  D0,($0505,A4)
                            	  8066:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8067:     ;
02:0003BAD2 102C0028        	  8068:     move.b  ($0028,A4),D0
02:0003BAD6 6702            	  8069:     beq.s  __far_z_04_0089
