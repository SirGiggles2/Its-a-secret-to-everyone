02:0000E44A 0C412C00        	   821:     cmpi.w  #$2C00,D1
02:0000E44E 64000188        	   822:     bhs     .nt_noop                 ; ≥$2C00 → palette/skip
02:0000E452 0C412BC0        	   823:     cmpi.w  #$2BC0,D1
