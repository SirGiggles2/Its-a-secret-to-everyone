02:0003A7AA 10342070        	  5501:     move.b  ($70,A4,D2.W),D0
02:0003A7AE 023C00EE        	  5502:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7B2 123C0008        	  5503:     move.b  #$08,D1
02:0003A7B6 D101            	  5504:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A7B8 020000F0        	  5505:     andi.b #$F0,D0
02:0003A7BC 19802070        	  5506:     move.b  D0,($70,A4,D2.W)
                            	  5507:     ; Align the monster with a square vertically.
                            	  5508:     ;
                            	  5509:     ; If in the top half of a square, align with that square.
                            	  5510:     ; If in the bottom half, align with the next square.
