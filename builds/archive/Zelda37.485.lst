                            	  1814:     ;
02:00038CE6 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038CEA 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038CEE 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038CF2 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038CF6 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038CF8 7628            	  1826:     moveq   #40,D3
02:00038CFA 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038CFE 10302000        	  1828:     move.b  (A0,D2.W),D0
