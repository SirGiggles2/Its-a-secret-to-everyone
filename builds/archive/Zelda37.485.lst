02:00039B6E 00039B7E        	  3824:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039B72 00039B7E        	  3825:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039B76 00039B7E        	  3826:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039B7A 00039BB2        	  3827:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
                            	  3828: 
                            	  3829:     even
                            	  3830: Moldorm_Chase:
                            	  3831:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3832:     ; Only the head controls the movement direction.
                            	  3833:     ;
02:00039B7E 0C020005        	  3834:     cmpi.b  #$05,D2
02:00039B82 670A            	  3835:     beq  _anon_z04_81
02:00039B84 0C02000A        	  3836:     cmpi.b  #$0A,D2
02:00039B88 6704            	  3837:     beq.s  __far_z_04_0025
02:00039B8A 600000A4        	  3838:     jmp  L1156B_Exit
                            	  3839: __far_z_04_0025:
                            	  3840: _anon_z04_81:
                            	  3841:     ; Chase while flying, as usual.
