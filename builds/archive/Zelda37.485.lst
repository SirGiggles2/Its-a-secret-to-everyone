02:00038D94 0C000003        	  1905:     cmpi.b  #$03,D0
02:00038D98 666E            	  1906:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  1907:     ; State 3.
                            	  1908:     ;
                            	  1909:     ; If being shoved, go shove, animate, and draw the leever.
