                            	  7775: HaveInput:
                            	  7776:     ; There were input directions.
                            	  7777:     ;
                            	  7778:     ; If there was only one input direction, go set object direction
                            	  7779:     ; to input direction, and set Link's speed.
                            	  7780:     ;
                            	  7781:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7782:     ; (X is still 0, because it's Link's object index).
                            	  7783:     ;
02:00041214 102C000F        	  7784:     move.b  ($000F,A4),D0
02:00041218 0C030001        	  7785:     cmpi.b  #$01,D3
02:0004121C 670000B6        	  7786:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7787:     ; There were more than one input directions.
                            	  7788:     ;
                            	  7789:     ; If none were walkable, go set input direction to 0, and return.
                            	  7790:     ;
02:00041220 102C000C        	  7791:     move.b  ($000C,A4),D0
02:00041224 6604            	  7792:     bne  _anon_z05_174
02:00041226 600000FC        	  7793:     jmp     SetLinkInputDir
                            	  7794: 
                            	  7795: _anon_z05_174:
                            	  7796:     ; Two input directions, and at least one of them is walkable.
                            	  7797:     ;
                            	  7798:     ; Make Link go straight in one direction on the next grid line.
                            	  7799:     ;
02:0004122A 7600            	  7800:     moveq   #0,D3
02:0004122C 1600            	  7801:     move.b  D0,D3
02:0004122E 522C0057        	  7802:     addq.b  #1,($0057,A4)
                            	  7803:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7804:     ; object direction and input direction to last walkable direction
                            	  7805:     ; found, and set Link's speed.
                            	  7806:     ;
                            	  7807:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7808:     ;
02:00041232 7400            	  7809:     moveq   #0,D2
02:00041234 102C000D        	  7810:     move.b  ($000D,A4),D0
02:00041238 0C030001        	  7811:     cmpi.b  #$01,D3
02:0004123C 67000096        	  7812:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00041240 7600            	  7813:     moveq   #0,D3
02:00041242 162C0010        	  7814:     move.b  ($0010,A4),D3
02:00041246 6700008C        	  7815:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7816:     ; In UW. There are two input directions, and they're both walkable.
                            	  7817:     ;
                            	  7818:     ; Normally, turn to the direction that's perpendicular to object
                            	  7819:     ; direction. But keep going straight after that, while diagonal
                            	  7820:     ; input is held.
                            	  7821:     ;
                            	  7822:     ; Handle special cases for doors.
                            	  7823:     ;
                            	  7824:     ;
                            	  7825:     ; 1. Link at horizontal doors.
                            	  7826:     ;
                            	  7827:     ; If Link's X = $20 or $D0 then
                            	  7828:     ;   If Link's Y = $85 and facing down then
                            	  7829:     ;     Go set object direction and input direction to object
                            	  7830:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7831:     ;     Link_GoStraightWhenDiagInput.
                            	  7832:     ;   Else
                            	  7833:     ;     Go turn to the perpendicular direction
                            	  7834:     ;
02:0004124A 7600            	  7835:     moveq   #0,D3
02:0004124C 162C0070        	  7836:     move.b  ($0070,A4),D3
02:00041250 0C030020        	  7837:     cmpi.b  #$20,D3
02:00041254 6706            	  7838:     beq  _anon_z05_175
02:00041256 0C0300D0        	  7839:     cmpi.b  #$D0,D3
02:0004125A 661C            	  7840:     bne  _anon_z05_176
                            	  7841: _anon_z05_175:
02:0004125C 7600            	  7842:     moveq   #0,D3
02:0004125E 162C0084        	  7843:     move.b  ($0084,A4),D3
02:00041262 0C030085        	  7844:     cmpi.b  #$85,D3
02:00041266 6642            	  7845:     bne  _anon_z05_177
02:00041268 102C0098        	  7846:     move.b  ($0098,A4),D0
02:0004126C 02000004        	  7847:     andi.b #$04,D0
02:00041270 6738            	  7848:     beq  _anon_z05_177
                            	  7849:     even
                            	  7850: _L_z05_HaveInput_SetLinkDirToObjDir:
02:00041272 102C0098        	  7851:     move.b  ($0098,A4),D0
02:00041276 665C            	  7852:     bne  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7853: _anon_z05_176:
                            	  7854:     ; If allowed to turn when input is diagonal (2 directions), then
                            	  7855:     ; go take the direction perpendicular to object direction.
                            	  7856:     ;
02:00041278 102C0098        	  7857:     move.b  ($0098,A4),D0
02:0004127C 7400            	  7858:     moveq   #0,D2
02:0004127E 142C0056        	  7859:     move.b  ($0056,A4),D2
02:00041282 6726            	  7860:     beq  _anon_z05_177
                            	  7861:     ; At this point, Link_GoStraightWhenDiagInput is true.
                            	  7862:     ;
                            	  7863:     ;
                            	  7864:     ; 2. Link at top door.
                            	  7865:     ;
                            	  7866:     ; If Link's X <> $78 or Link's Y <> $5D then
                            	  7867:     ;   Go set object direction and input direction to object
                            	  7868:     ;   direction, and set Link's speed. Also, *SET*
                            	  7869:     ;   Link_GoStraightWhenDiagInput.
                            	  7870:     ;
02:00041284 7600            	  7871:     moveq   #0,D3
02:00041286 162C0010        	  7872:     move.b  ($0010,A4),D3
02:0004128A 6748            	  7873:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
