                            	  9023: ; Y: value to cycle
                            	  9024: ;
                            	  9025: ; If A = 0, does nothing.
                            	  9026: ; If A = 1, Y := (Y + 1) mod 9
                            	  9027: ; If A = 2, Y := (Y - 1) mod 9
