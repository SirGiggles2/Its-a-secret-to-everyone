                            	  2111:     ;
02:00038F22 41EC0098        	  2112:     lea     ($0098,A4),A0
02:00038F26 10302000        	  2113:     move.b  (A0,D2.W),D0
02:00038F2A 0200000C        	  2114:     andi.b #$0C,D0
02:00038F2E 660C            	  2115:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2116:     ; Else draw not mirrored.
