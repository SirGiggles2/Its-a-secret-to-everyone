02:00038D0E 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038D12 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038D16 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D1A 1214            	  1841:     move.b  ($0000,A4),D1
02:00038D1C D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038D1E 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
