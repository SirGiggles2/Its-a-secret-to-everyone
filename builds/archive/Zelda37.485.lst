                            	  2413: UpdatePondFairy:
02:00039106 610031C0        	  2414:     jsr     DrawFairy
                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:0003910A 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:0003910E 6702            	  2418:     beq.s  __far_z_04_0020
