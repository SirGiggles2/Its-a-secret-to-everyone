02:000354B8 1940050D        	  4978:     move.b  D0,($050D,A4)
                            	  4979:     ; Increment the VRAM page number.
                            	  4980:     ;
02:000354BC 7600            	  4981:     moveq   #0,D3
02:000354BE 162C050C        	  4982:     move.b  ($050C,A4),D3
02:000354C2 5203            	  4983:     addq.b  #1,D3
