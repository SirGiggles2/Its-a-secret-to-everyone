02:000384AA 41EC0098        	   624:     lea     ($0098,A4),A0
02:000384AE 11802000        	   625:     move.b  D0,(A0,D2.W)
02:000384B2 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:000384B6 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:000384BA 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:000384BE 7074            	   629:     moveq   #116,D0
02:000384C0 4EB90004720A    	   630:     jsr     ChangeTileObjTiles
