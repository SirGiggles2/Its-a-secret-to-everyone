02:0003BDD9 10
02:0003BDDA 00
02:0003BDDB 10
                            	  8493: 
                            	  8494:     even
                            	  8495: GanonSpriteOffsetsY:
02:0003BDDC 00              	  8496:     dc.b    $00, $00, $10, $10
02:0003BDDD 00
02:0003BDDE 10
02:0003BDDF 10
                            	  8497: 
