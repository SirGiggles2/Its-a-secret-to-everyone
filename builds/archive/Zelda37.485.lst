02:0003BAC2 19400601        	  8052:     move.b  D0,($0601,A4)
                            	  8053: _anon_z04_160:
02:0003BAC6 0A3C0001        	  8054:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BACA 4E75            	  8055:     rts
                            	  8056: 
                            	  8057: ; Description:
                            	  8058: ; Lift up the Triforce of Courage while the room is light.
