                            	   828: ;==============================================================================
                            	   829: ; prep_phrase — ported from PrepPhrase
                            	   830: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   831: ;==============================================================================
                            	   832: prep_phrase:
02:000007FE 43F900000E20    	   833:     lea     (MusicBlob).l,A1
02:00000804 7200            	   834:     moveq   #0,D1
02:00000806 123900FFE002    	   835:     move.b  (m_phrase).l,D1
02:0000080C 5341            	   836:     subq.w  #1,D1
02:0000080E 12311000        	   837:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000812 024100FF        	   838:     andi.w  #$FF,D1
                            	   839: 
                            	   840:     ; byte 0: NoteLengthTableBase
02:00000816 13F1100000FFE003	   841:     move.b  (A1,D1.w),(m_len_base).l
02:0000081E 5241            	   842:     addq.w  #1,D1
                            	   843:     ; byte 1: script ptr lo
02:00000820 7400            	   844:     moveq   #0,D2
02:00000822 14311000        	   845:     move.b  (A1,D1.w),D2
02:00000826 5241            	   846:     addq.w  #1,D1
                            	   847:     ; byte 2: script ptr hi
02:00000828 7600            	   848:     moveq   #0,D3
02:0000082A 16311000        	   849:     move.b  (A1,D1.w),D3
02:0000082E 5241            	   850:     addq.w  #1,D1
02:00000830 E14B            	   851:     lsl.w   #8,D3
02:00000832 8642            	   852:     or.w    D2,D3                        ; D3 = NES CPU address
02:00000834 967C8D60        	   853:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:00000838 02830000FFFF    	   854:     andi.l  #$FFFF,D3
02:0000083E 41F900000E20    	   855:     lea     (MusicBlob).l,A0
02:00000844 D1C3            	   856:     adda.l  D3,A0                        ; A0 = M68K script base
02:00000846 23C800FFE008    	   857:     move.l  A0,(m_script_ptr).l
                            	   858: 
                            	   859:     ; byte 3: NoteOffsetSongTrg
02:0000084C 13F1100000FFE01C	   860:     move.b  (A1,D1.w),(m_trg_off).l
02:00000854 5241            	   861:     addq.w  #1,D1
                            	   862:     ; byte 4: NoteOffsetSongSq0
02:00000856 13F1100000FFE014	   863:     move.b  (A1,D1.w),(m_sq0_off).l
02:0000085E 5241            	   864:     addq.w  #1,D1
                            	   865:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:00000860 13F1100000FFE024	   866:     move.b  (A1,D1.w),(m_noise_off).l
02:00000868 13F1100000FFE006	   867:     move.b  (A1,D1.w),(m_noise_first).l
02:00000870 5241            	   868:     addq.w  #1,D1
                            	   869:     ; byte 6: SongEnvelopeSelector
02:00000872 13F1100000FFE004	   870:     move.b  (A1,D1.w),(m_env_sel).l
02:0000087A 5241            	   871:     addq.w  #1,D1
                            	   872:     ; byte 7: mystery
02:0000087C 13F1100000FFE005	   873:     move.b  (A1,D1.w),(m_mystery).l
                            	   874: 
                            	   875:     ; Reset counters and Sq1 offset
02:00000884 13FC000100FFE00D	   876:     move.b  #1,(m_sq1_cnt).l
02:0000088C 13FC000100FFE015	   877:     move.b  #1,(m_sq0_cnt).l
02:00000894 13FC000100FFE01D	   878:     move.b  #1,(m_trg_cnt).l
02:0000089C 13FC000100FFE025	   879:     move.b  #1,(m_noise_cnt).l
02:000008A4 423900FFE00C    	   880:     clr.b   (m_sq1_off).l
02:000008AA 423900FFE021    	   881:     clr.b   (m_trg_rep_n).l
02:000008B0 4E75            	   882:     rts
                            	   883: 
                            	   884: ;==============================================================================
                            	   885: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   886: ;==============================================================================
                            	   887: tick_sq1:
02:000008B2 533900FFE00D    	   888:     subq.b  #1,(m_sq1_cnt).l
02:000008B8 6600010E        	   889:     bne     tick_sq0                     ; no new note
                            	   890: .read:
02:000008BC 207900FFE008    	   891:     move.l  (m_script_ptr).l,A0
02:000008C2 7200            	   892:     moveq   #0,D1
02:000008C4 123900FFE00C    	   893:     move.b  (m_sq1_off).l,D1
02:000008CA 523900FFE00C    	   894:     addq.b  #1,(m_sq1_off).l
02:000008D0 10301000        	   895:     move.b  (A0,D1.w),D0
02:000008D4 673A            	   896:     beq.s   .song_ended
02:000008D6 4A00            	   897:     tst.b   D0
02:000008D8 6B02            	   898:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:000008DA 6022            	   899:     bra.s   .play_note
                            	   900: .prep_then_note:
02:000008DC 6100027C        	   901:     bsr     get_song_note_length         ; D0 in → D0 length
02:000008E0 13C000FFE00E    	   902:     move.b  D0,(m_sq1_len).l
02:000008E6 207900FFE008    	   903:     move.l  (m_script_ptr).l,A0
02:000008EC 7200            	   904:     moveq   #0,D1
02:000008EE 123900FFE00C    	   905:     move.b  (m_sq1_off).l,D1
02:000008F4 523900FFE00C    	   906:     addq.b  #1,(m_sq1_off).l
02:000008FA 10301000        	   907:     move.b  (A0,D1.w),D0
                            	   908: .play_note:
02:000008FE 61000274        	   909:     bsr     emit_note_sq1                 ; D0 = note id
02:00000902 13F900FFE00E00FF	   910:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:0000090A E00D
02:0000090C 600000BA        	   911:     bra     tick_sq0
                            	   912: .song_ended:
02:00000910 103900FFE000    	   913:     move.b  (m_song).l,D0
02:00000916 020000F1        	   914:     andi.b  #$F1,D0
02:0000091A 6604            	   915:     bne.s   .play_again
02:0000091C 60000430        	   916:     bra     music_silence
                            	   917: .play_again:
02:00000920 6102            	   918:     bsr     play_next_phrase_no_tick
02:00000922 6098            	   919:     bra.s   .read
                            	   920: 
                            	   921: ;----------------------------------------------------------------------
                            	   922: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   923: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   924: ; to restart a looping song when $00 opcode is read.
                            	   925: ;----------------------------------------------------------------------
                            	   926: play_next_phrase_no_tick:
02:00000924 103900FFE000    	   927:     move.b  (m_song).l,D0
02:0000092A 6B7E            	   928:     bmi     .nsp_demo
02:0000092C B03C0001        	   929:     cmp.b   #$01,D0
02:00000930 675A            	   930:     beq     .nsp_ow
02:00000932 B03C0040        	   931:     cmp.b   #$40,D0
02:00000936 6738            	   932:     beq     .nsp_uw
02:00000938 B03C0010        	   933:     cmp.b   #$10,D0
02:0000093C 6716            	   934:     beq     .nsp_ending
                            	   935:     ; single-phrase: rebuild phrase from bit
02:0000093E 7200            	   936:     moveq   #0,D1
02:00000940 7400            	   937:     moveq   #0,D2
02:00000942 1400            	   938:     move.b  D0,D2
                            	   939: .nsp_loop:
02:00000944 5201            	   940:     addq.b  #1,D1
02:00000946 E20A            	   941:     lsr.b   #1,D2
02:00000948 64FA            	   942:     bcc     .nsp_loop
02:0000094A 13C100FFE002    	   943:     move.b  D1,(m_phrase).l
02:00000950 6000FEAC        	   944:     bra     prep_phrase
                            	   945: .nsp_ending:
02:00000954 523900FFE002    	   946:     addq.b  #1,(m_phrase).l
02:0000095A 0C39001A00FFE002	   947:     cmpi.b  #$1A,(m_phrase).l
02:00000962 6600FE9A        	   948:     bne     prep_phrase
02:00000966 13FC001400FFE002	   949:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:0000096E 60B4            	   950:     bra     play_next_phrase_no_tick
                            	   951: .nsp_uw:
02:00000970 523900FFE002    	   952:     addq.b  #1,(m_phrase).l
02:00000976 0C39001200FFE002	   953:     cmpi.b  #$12,(m_phrase).l
02:0000097E 6600FE7E        	   954:     bne     prep_phrase
02:00000982 13FC000F00FFE002	   955:     move.b  #$0F,(m_phrase).l
02:0000098A 6098            	   956:     bra     play_next_phrase_no_tick
                            	   957: .nsp_ow:
02:0000098C 523900FFE002    	   958:     addq.b  #1,(m_phrase).l
02:00000992 0C39001000FFE002	   959:     cmpi.b  #$10,(m_phrase).l
02:0000099A 6600FE62        	   960:     bne     prep_phrase
02:0000099E 13FC000900FFE002	   961:     move.b  #$09,(m_phrase).l
02:000009A6 6000FF7C        	   962:     bra     play_next_phrase_no_tick
                            	   963: .nsp_demo:
02:000009AA 523900FFE002    	   964:     addq.b  #1,(m_phrase).l
02:000009B0 0C39002400FFE002	   965:     cmpi.b  #$24,(m_phrase).l
02:000009B8 6600FE44        	   966:     bne     prep_phrase
02:000009BC 13FC001900FFE002	   967:     move.b  #$19,(m_phrase).l
02:000009C4 6000FF5E        	   968:     bra     play_next_phrase_no_tick
                            	   969: 
                            	   970: ;==============================================================================
                            	   971: ; tick_sq0 — Sq0 channel update
                            	   972: ;==============================================================================
                            	   973: tick_sq0:
02:000009C8 4A3900FFE014    	   974:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:000009CE 6754            	   975:     beq     tick_trg
02:000009D0 533900FFE015    	   976:     subq.b  #1,(m_sq0_cnt).l
02:000009D6 664C            	   977:     bne     tick_trg
02:000009D8 207900FFE008    	   978:     move.l  (m_script_ptr).l,A0
02:000009DE 7200            	   979:     moveq   #0,D1
02:000009E0 123900FFE014    	   980:     move.b  (m_sq0_off).l,D1
02:000009E6 523900FFE014    	   981:     addq.b  #1,(m_sq0_off).l
02:000009EC 10301000        	   982:     move.b  (A0,D1.w),D0
02:000009F0 4A00            	   983:     tst.b   D0
02:000009F2 6A22            	   984:     bpl.s   .play
02:000009F4 61000164        	   985:     bsr     get_song_note_length
02:000009F8 13C000FFE016    	   986:     move.b  D0,(m_sq0_len).l
02:000009FE 207900FFE008    	   987:     move.l  (m_script_ptr).l,A0
02:00000A04 7200            	   988:     moveq   #0,D1
02:00000A06 123900FFE014    	   989:     move.b  (m_sq0_off).l,D1
02:00000A0C 523900FFE014    	   990:     addq.b  #1,(m_sq0_off).l
02:00000A12 10301000        	   991:     move.b  (A0,D1.w),D0
                            	   992: .play:
02:00000A16 610001BA        	   993:     bsr     emit_note_sq0
02:00000A1A 13F900FFE01600FF	   994:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A22 E015
                            	   995:     bra     tick_trg
                            	   996: 
                            	   997: ;==============================================================================
                            	   998: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   999: ;==============================================================================
                            	  1000: tick_trg:
02:00000A24 4A3900FFE01C    	  1001:     tst.b   (m_trg_off).l
02:00000A2A 6700009E        	  1002:     beq     tick_noise
02:00000A2E 533900FFE01D    	  1003:     subq.b  #1,(m_trg_cnt).l
02:00000A34 66000094        	  1004:     bne     tick_noise
                            	  1005: .prep_note_or_passage:
02:00000A38 207900FFE008    	  1006:     move.l  (m_script_ptr).l,A0
02:00000A3E 7200            	  1007:     moveq   #0,D1
02:00000A40 123900FFE01C    	  1008:     move.b  (m_trg_off).l,D1
02:00000A46 523900FFE01C    	  1009:     addq.b  #1,(m_trg_off).l
02:00000A4C 10301000        	  1010:     move.b  (A0,D1.w),D0
02:00000A50 676A            	  1011:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000A52 4A00            	  1012:     tst.b   D0
02:00000A54 6A56            	  1013:     bpl.s   .play_note_trg                ; direct note
02:00000A56 0C0000F0        	  1014:     cmpi.b  #$F0,D0
02:00000A5A 6718            	  1015:     beq.s   .end_of_passage
02:00000A5C 652A            	  1016:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1017:     ; $F1-$FF → start passage
02:00000A5E 040000F0        	  1018:     subi.b  #$F0,D0
02:00000A62 13C000FFE021    	  1019:     move.b  D0,(m_trg_rep_n).l
02:00000A68 13F900FFE01C00FF	  1020:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000A70 E022
02:00000A72 60C4            	  1021:     bra.s   .prep_note_or_passage
                            	  1022: .end_of_passage:
02:00000A74 533900FFE021    	  1023:     subq.b  #1,(m_trg_rep_n).l
02:00000A7A 670A            	  1024:     beq.s   .pass_done
02:00000A7C 13F900FFE02200FF	  1025:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000A84 E01C
                            	  1026: .pass_done:
02:00000A86 60B0            	  1027:     bra.s   .prep_note_or_passage
                            	  1028: .prep_note_trg:
02:00000A88 610000D0        	  1029:     bsr     get_song_note_length
02:00000A8C 13C000FFE01E    	  1030:     move.b  D0,(m_trg_len).l
02:00000A92 207900FFE008    	  1031:     move.l  (m_script_ptr).l,A0
02:00000A98 7200            	  1032:     moveq   #0,D1
02:00000A9A 123900FFE01C    	  1033:     move.b  (m_trg_off).l,D1
02:00000AA0 523900FFE01C    	  1034:     addq.b  #1,(m_trg_off).l
02:00000AA6 10301000        	  1035:     move.b  (A0,D1.w),D0
02:00000AAA 6710            	  1036:     beq.s   .silence_trg
                            	  1037: .play_note_trg:
02:00000AAC 61000182        	  1038:     bsr     emit_note_trg
02:00000AB0 13F900FFE01E00FF	  1039:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AB8 E01D
02:00000ABA 600E            	  1040:     bra     tick_noise
                            	  1041: .silence_trg:
02:00000ABC 610001E6        	  1042:     bsr     key_off_trg
02:00000AC0 13F900FFE01E00FF	  1043:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AC8 E01D
                            	  1044:     bra     tick_noise
                            	  1045: 
                            	  1046: ;==============================================================================
                            	  1047: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1048: ;==============================================================================
                            	  1049: tick_noise:
02:00000ACA 103900FFE000    	  1050:     move.b  (m_song).l,D0
02:00000AD0 02000091        	  1051:     andi.b  #$91,D0
02:00000AD4 67000082        	  1052:     beq     .tn_done
                            	  1053:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1054:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1055:     ; a hit fires below.
02:00000AD8 61000250        	  1056:     bsr     noise_decay_tick
02:00000ADC 533900FFE025    	  1057:     subq.b  #1,(m_noise_cnt).l
02:00000AE2 6674            	  1058:     bne     .tn_done
                            	  1059: .read:
02:00000AE4 207900FFE008    	  1060:     move.l  (m_script_ptr).l,A0
02:00000AEA 7200            	  1061:     moveq   #0,D1
02:00000AEC 123900FFE024    	  1062:     move.b  (m_noise_off).l,D1
02:00000AF2 523900FFE024    	  1063:     addq.b  #1,(m_noise_off).l
02:00000AF8 10301000        	  1064:     move.b  (A0,D1.w),D0
02:00000AFC 660C            	  1065:     bne.s   .got
02:00000AFE 13F900FFE00600FF	  1066:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B06 E024
02:00000B08 60DA            	  1067:     bra.s   .read
                            	  1068: .got:
02:00000B0A 1800            	  1069:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1070:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1071:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1072:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1073:     ; (0,7,6). For our port we replicate exactly.
02:00000B0C 7400            	  1074:     moveq   #0,D2
02:00000B0E 1404            	  1075:     move.b  D4,D2
                            	  1076:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B10 7000            	  1077:     moveq   #0,D0
02:00000B12 08020000        	  1078:     btst    #0,D2
02:00000B16 6704            	  1079:     beq.s   .b0
02:00000B18 08C00002        	  1080:     bset    #2,D0
                            	  1081: .b0:
02:00000B1C 08020007        	  1082:     btst    #7,D2
02:00000B20 6704            	  1083:     beq.s   .b7
02:00000B22 08C00001        	  1084:     bset    #1,D0
                            	  1085: .b7:
02:00000B26 08020006        	  1086:     btst    #6,D2
02:00000B2A 6704            	  1087:     beq.s   .b6
02:00000B2C 08C00000        	  1088:     bset    #0,D0
                            	  1089: .b6:
02:00000B30 7200            	  1090:     moveq   #0,D1
02:00000B32 123900FFE003    	  1091:     move.b  (m_len_base).l,D1
02:00000B38 D240            	  1092:     add.w   D0,D1
02:00000B3A 43F900000DDC    	  1093:     lea     (NoteLengthTables).l,A1
02:00000B40 13F1100000FFE025	  1094:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1095:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000B48 1004            	  1096:     move.b  D4,D0
02:00000B4A 0200003E        	  1097:     andi.b  #$3E,D0
02:00000B4E E808            	  1098:     lsr.b   #4,D0
02:00000B50 7200            	  1099:     moveq   #0,D1
02:00000B52 1200            	  1100:     move.b  D0,D1
                            	  1101:     ; Map to PSG noise: set volume + period
02:00000B54 6100015A        	  1102:     bsr     set_psg_noise
                            	  1103: .tn_done:
02:00000B58 4E75            	  1104:     rts
