02:0000E63A 3A04            	  1083:     move.w  D4,D5
02:0000E63C E84D            	  1084:     lsr.w   #4,D5
02:0000E63E 02450003        	  1085:     andi.w  #$0003,D5
02:0000E642 EB4D            	  1086:     lsl.w   #5,D5
02:0000E644 E14D            	  1087:     lsl.w   #8,D5
02:0000E646 5443            	  1088:     addq.w  #2,D3
02:0000E648 610002C4        	  1089:     bsr     _attr_write_2x2
02:0000E64C 5543            	  1090:     subq.w  #2,D3
                            	  1091: 
