02:0002B606 3006            	  3537:     move.w  D6,D0
02:0002B608 4840            	  3538:     swap    D0
02:0002B60A 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B610 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
