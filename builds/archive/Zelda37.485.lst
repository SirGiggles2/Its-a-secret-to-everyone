                            	  2305: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:00033892 41F900033160    	  2306:     lea     (ModeEandFCursorSprites).l,A0
02:00033898 10303000        	  2307:     move.b  (A0,D3.W),D0
02:0003389C 41EC0201        	  2308:     lea     ($0201,A4),A0
02:000338A0 11803000        	  2309:     move.b  D0,(A0,D3.W)
02:000338A4 5303            	  2310:     subq.b  #1,D3
02:000338A6 6AEA            	  2311:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000338A8 7600            	  2312:     moveq   #0,D3
02:000338AA 162C0016        	  2313:     move.b  ($0016,A4),D3
02:000338AE 41F900033116    	  2314:     lea     (ModeEandFSlotCursorYs).l,A0
02:000338B4 10303000        	  2315:     move.b  (A0,D3.W),D0
02:000338B8 19400084        	  2316:     move.b  D0,($0084,A4)
02:000338BC 19400200        	  2317:     move.b  D0,($0200,A4)
02:000338C0 102C0012        	  2318:     move.b  ($0012,A4),D0
02:000338C4 0C00000F        	  2319:     cmpi.b  #$0F,D0
                            	  2320:     ; There's more work in mode $E.
                            	  2321:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2322:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000338C8 6736            	  2323:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:000338CA 103C00F3        	  2324:     move.b  #$F3,D0
02:000338CE 19400201        	  2325:     move.b  D0,($0201,A4)
                            	  2326:     ; Because the visible part of the cursor block sprite is
                            	  2327:     ; in the bottom, move the name cursor's sprite 8 pixels
