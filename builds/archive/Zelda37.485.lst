                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3944:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3945:     ;
02:00039BF4 7004            	  3946:     moveq   #4,D0
02:00039BF6 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039BF8 7600            	  3950:     moveq   #0,D3
02:00039BFA 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039BFE 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
