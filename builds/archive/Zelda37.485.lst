02:000487E0 7000            	  5480:     moveq   #0,D0
02:000487E2 41EC0394        	  5481:     lea     ($0394,A4),A0
02:000487E6 11802000        	  5482:     move.b  D0,(A0,D2.W)
                            	  5483:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5484:     ;
02:000487EA 0C02000D        	  5485:     cmpi.b  #$0D,D2
02:000487EE 6408            	  5486:     bcc  _anon_z07_30
02:000487F0 41EC042C        	  5487:     lea     ($042C,A4),A0
02:000487F4 10302000        	  5488:     move.b  (A0,D2.W),D0
                            	  5489: _anon_z07_30:
02:000487F8 4EB900030A5E    	  5490:     jsr     GetDirectionsAndDistancesToTarget
                            	  5491:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5492:     ; then go move towards the thrower, draw, and check collisions.
                            	  5493:     ;
02:000487FE 1014            	  5494:     move.b  ($0000,A4),D0
02:00048800 0C000002        	  5495:     cmpi.b  #$02,D0
02:00048804 666A            	  5496:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5497:     ; The boomerang has reached the thrower.
                            	  5498:     ;
                            	  5499:     ; Reset the distance to move.
                            	  5500:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5501:     ;
02:00048806 7000            	  5502:     moveq   #0,D0
02:00048808 41EC0380        	  5503:     lea     ($0380,A4),A0
02:0004880C 11802000        	  5504:     move.b  D0,(A0,D2.W)
02:00048810 0C02000D        	  5505:     cmpi.b  #$0D,D2
02:00048814 6524            	  5506:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5507:     ; Link has caught the boomerang.
                            	  5508:     ;
                            	  5509:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5510:     ;
                            	  5511:     ; If Link catches it some time after throwing it,
                            	  5512:     ; his state will become $20, and he will show the catch animation.
                            	  5513:     ;
                            	  5514:     ; But if he catches it right after throwing it, the state becomes
                            	  5515:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5516:     ;
02:00048816 102C00AC        	  5517:     move.b  ($00AC,A4),D0
02:0004881A 00000020        	  5518:     ori.b #$20,D0
02:0004881E 194000AC        	  5519:     move.b  D0,($00AC,A4)
                            	  5520:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5521:     ; up the new state.
                            	  5522:     ;
02:00048822 7001            	  5523:     moveq   #1,D0
02:00048824 194003D0        	  5524:     move.b  D0,($03D0,A4)
                            	  5525:     ; Deactivate the boomerang.
                            	  5526:     ;
02:00048828 760F            	  5527:     moveq   #15,D3
02:0004882A 7000            	  5528:     moveq   #0,D0
02:0004882C 41EC00AC        	  5529:     lea     ($00AC,A4),A0
02:00048830 11803000        	  5530:     move.b  D0,(A0,D3.W)
02:00048834 0A3C0001        	  5531:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00048838 4E75            	  5532:     rts
                            	  5533: 
                            	  5534:     even
                            	  5535: _L_z07_CheckState30_CatchBoomerang:
                            	  5536:     ; A monster caught the boomerang that it threw.
                            	  5537:     ;
                            	  5538:     ; Set a timer for the thrower based on a random value:
                            	  5539:     ; < $30: $30
                            	  5540:     ; < $70: $50
                            	  5541:     ; Else:  $70
