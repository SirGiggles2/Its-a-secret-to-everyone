02:00034E12 123C0010        	  4368:     move.b  #$10,D1
02:00034E16 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E1A 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E1C 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
