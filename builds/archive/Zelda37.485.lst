                            	  8565:     even
                            	  8566: Ganon_CheckCollisions:
                            	  8567:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  8568:     ; Store in [02] and [03].
                            	  8569:     ;
02:0003BE60 10342070        	  8570:     move.b  ($70,A4,D2.W),D0
02:0003BE64 023C00EE        	  8571:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE68 123C0010        	  8572:     move.b  #$10,D1
02:0003BE6C D101            	  8573:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BE6E 19400002        	  8574:     move.b  D0,($0002,A4)
02:0003BE72 41EC0084        	  8575:     lea     ($0084,A4),A0
02:0003BE76 10302000        	  8576:     move.b  (A0,D2.W),D0
02:0003BE7A 023C00EE        	  8577:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE7E 123C0010        	  8578:     move.b  #$10,D1
02:0003BE82 D101            	  8579:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BE84 19400003        	  8580:     move.b  D0,($0003,A4)
                            	  8581:     ; Check for a collision with Link.
                            	  8582:     ;
                            	  8583:     ; We can't call CheckLinkCollision, because we need to
                            	  8584:     ; customize Ganon's midpoint.
                            	  8585:     ;
                            	  8586:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  8587:     ; detection, if Link is invincible. Initialize variables that will
                            	  8588:     ; be returned from the partial collision check routine. Then
                            	  8589:     ; call it.
                            	  8590:     ;
02:0003BE88 102C04F0        	  8591:     move.b  ($04F0,A4),D0
02:0003BE8C 6616            	  8592:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003BE8E 19400006        	  8593:     move.b  D0,($0006,A4)
02:0003BE92 19400009        	  8594:     move.b  D0,($0009,A4)
02:0003BE96 1940000C        	  8595:     move.b  D0,($000C,A4)
02:0003BE9A 7600            	  8596:     moveq   #0,D3
02:0003BE9C 1883            	  8597:     move.b  D3,($0000,A4)
02:0003BE9E 4EB9000311F4    	  8598:     jsr     CheckLinkCollisionPreinit
                            	  8599:     even
                            	  8600: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  8601:     ; If Ganon is not in state 0, then he's brown.
                            	  8602:     ; Go check collision with an arrow.
                            	  8603:     ;
02:0003BEA4 41EC00AC        	  8604:     lea     ($00AC,A4),A0
02:0003BEA8 10302000        	  8605:     move.b  (A0,D2.W),D0
02:0003BEAC 6652            	  8606:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  8607:     ; If timer <> 0, then Ganon is visible.
                            	  8608:     ; He can't be harmed like this. So, return.
                            	  8609:     ;
02:0003BEAE 10342028        	  8610:     move.b  ($28,A4,D2.W),D0
02:0003BEB2 664A            	  8611:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003BEB4 760D            	  8612:     moveq   #13,D3
02:0003BEB6 4EB90003122E    	  8613:     jsr     CheckMonsterSwordCollision
                            	  8614:     ; If Ganon has died according to the usual collision check rules
                            	  8615:     ; (HP = 0), then:
                            	  8616:     ; 1. Restore HP to the initial value $F0
                            	  8617:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  8618:     ; 3. Change palette row 7 to make Ganon brown
                            	  8619:     ;
02:0003BEBC 41EC0405        	  8620:     lea     ($0405,A4),A0
02:0003BEC0 10302000        	  8621:     move.b  (A0,D2.W),D0
02:0003BEC4 6718            	  8622:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003BEC6 103C00F0        	  8623:     move.b  #$F0,D0
02:0003BECA 41EC0485        	  8624:     lea     ($0485,A4),A0
02:0003BECE 11802000        	  8625:     move.b  D0,(A0,D2.W)
02:0003BED2 41EC00AC        	  8626:     lea     ($00AC,A4),A0
02:0003BED6 53302000        	  8627:     subq.b  #1,(A0,D2.W)
02:0003BEDA 61000084        	  8628:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  8629:     even
                            	  8630: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  8631:     ; If Ganon was harmed, then play the sound effect
                            	  8632:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  8633:     ;
02:0003BEDE 41EC04F0        	  8634:     lea     ($04F0,A4),A0
02:0003BEE2 10302000        	  8635:     move.b  (A0,D2.W),D0
02:0003BEE6 670A            	  8636:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003BEE8 6100C2EE        	  8637:     jsr     PlayBossHitCryIfNeeded
02:0003BEEC 7040            	  8638:     moveq   #64,D0
02:0003BEEE 19802028        	  8639:     move.b  D0,($28,A4,D2.W)
                            	  8640:     even
                            	  8641: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  8642:     ; Reset metastate, because Ganon cannot die this way.
                            	  8643:     ;
02:0003BEF2 4EB900049892    	  8644:     jsr     ResetObjMetastate
                            	  8645:     ; Reset shove info and invincibility timer, because Ganon
                            	  8646:     ; doesn't react at all as a usual monster.
                            	  8647:     ;
02:0003BEF8 4EB90003121C    	  8648:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	  8649:     even
                            	  8650: _L_z04_Ganon_CheckCollisions_Exit:
02:0003BEFE 4E75            	  8651:     rts
                            	  8652: 
                            	  8653:     even
                            	  8654: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  8655:     ; If the silver arrow is not in the inventory, then return.
                            	  8656:     ;
02:0003BF00 102C0659        	  8657:     move.b  ($0659,A4),D0
02:0003BF04 0C000002        	  8658:     cmpi.b  #$02,D0
02:0003BF08 66F4            	  8659:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8660:     ; Reset the collision return value [06].
                            	  8661:     ;
02:0003BF0A 7000            	  8662:     moveq   #0,D0
02:0003BF0C 19400006        	  8663:     move.b  D0,($0006,A4)
                            	  8664:     ; If there's no arrow in flight, then return.
                            	  8665:     ;
02:0003BF10 7612            	  8666:     moveq   #18,D3
02:0003BF12 41EC00AC        	  8667:     lea     ($00AC,A4),A0
02:0003BF16 10303000        	  8668:     move.b  (A0,D3.W),D0
02:0003BF1A 0C000010        	  8669:     cmpi.b  #$10,D0
02:0003BF1E 66DE            	  8670:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8671:     ; Check for collision with an arrow; and return if no collision.
                            	  8672:     ;
02:0003BF20 4EB900031236    	  8673:     jsr     CheckMonsterArrowOrRodCollision
02:0003BF26 102C0006        	  8674:     move.b  ($0006,A4),D0
02:0003BF2A 67D2            	  8675:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	  8676:     ; Set the Ganon phase to "dying".
                            	  8677:     ;
02:0003BF2C 41EC042C        	  8678:     lea     ($042C,A4),A0
02:0003BF30 52302000        	  8679:     addq.b  #1,(A0,D2.W)
                            	  8680:     ; Now his body does flash.
                            	  8681:     ;
02:0003BF34 7028            	  8682:     moveq   #40,D0
02:0003BF36 41EC04F0        	  8683:     lea     ($04F0,A4),A0
02:0003BF3A 11802000        	  8684:     move.b  D0,(A0,D2.W)
                            	  8685:     ; Set initial cloud distance 8.
                            	  8686:     ;
02:0003BF3E 7008            	  8687:     moveq   #8,D0
02:0003BF40 41EC0478        	  8688:     lea     ($0478,A4),A0
02:0003BF44 11802000        	  8689:     move.b  D0,(A0,D2.W)
02:0003BF48 0A3C0001        	  8690:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BF4C 4E75            	  8691:     rts
                            	  8692: 
                            	  8693:     even
