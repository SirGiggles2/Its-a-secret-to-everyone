02:00039C0A 41EC0381        	  3961:     lea     ($0381,A4),A0
02:00039C0E 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:00039C12 41EC0099        	  3963:     lea     ($0099,A4),A0
02:00039C16 11803000        	  3964:     move.b  D0,(A0,D3.W)
