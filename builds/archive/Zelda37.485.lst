                            	  3424: Obj_Shove:
                            	  3425:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3426:     ; then go handle it separately.
                            	  3427:     ;
02:00047AD0 41EC00C0        	  3428:     lea     ($00C0,A4),A0
02:00047AD4 10302000        	  3429:     move.b  (A0,D2.W),D0
02:00047AD8 E308            	  3430:     lsl.b  #1,D0   ; ASL A
