02:0000E64E 3A04            	  1093:     move.w  D4,D5
02:0000E650 EC4D            	  1094:     lsr.w   #6,D5
02:0000E652 02450003        	  1095:     andi.w  #$0003,D5
02:0000E656 EB4D            	  1096:     lsl.w   #5,D5
02:0000E658 E14D            	  1097:     lsl.w   #8,D5
02:0000E65A 5442            	  1098:     addq.w  #2,D2
02:0000E65C 5443            	  1099:     addq.w  #2,D3
02:0000E65E 610002AE        	  1100:     bsr     _attr_write_2x2
