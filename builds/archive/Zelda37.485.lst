02:000391B4 123C0003        	  2554:     move.b  #$03,D1
02:000391B8 0A3C0010        	  2555:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000391BC 9101            	  2556:     subx.b  D1,D0   ; SBC #$03
02:000391BE 0A3C0010        	  2557:     eori    #$10,CCR  ; restore X = 6502 C
