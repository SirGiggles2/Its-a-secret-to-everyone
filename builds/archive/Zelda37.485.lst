02:00038F94 102C00EB        	  2186:     move.b  ($00EB,A4),D0
                            	  2187:     ; If this element does not match the current room ID, go loop again.
                            	  2188:     ;
02:00038F98 41F900038F5E    	  2189:     lea     (SecretArmosRoomIds).l,A0
02:00038F9E 12303000        	  2190:     move.b  (A0,D3.W),D1
02:00038FA2 B001            	  2191:     cmp.b   D1,D0
02:00038FA4 6648            	  2192:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2193:     ; The secret (usually stairs) is under one of the armoses.
                            	  2194:     ;
                            	  2195:     ; If the armos's X coordinate does not match the one needed
                            	  2196:     ; for the current room in the list, then go loop again.
                            	  2197:     ;
02:00038FA6 10342070        	  2198:     move.b  ($70,A4,D2.W),D0
02:00038FAA 41F900038F66    	  2199:     lea     (SecretArmosXs).l,A0
02:00038FB0 12303000        	  2200:     move.b  (A0,D3.W),D1
02:00038FB4 B001            	  2201:     cmp.b   D1,D0
02:00038FB6 6636            	  2202:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2203:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2204:     ;
02:00038FB8 41EC0084        	  2205:     lea     ($0084,A4),A0
02:00038FBC 10302000        	  2206:     move.b  (A0,D2.W),D0
02:00038FC0 0C000080        	  2207:     cmpi.b  #$80,D0
02:00038FC4 6628            	  2208:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2209:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2210:     ;
02:00038FC6 4A03            	  2211:     cmpi.b  #$00,D3
02:00038FC8 662C            	  2212:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2213:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2214:     ; has the power bracelet.
                            	  2215:     ;
                            	  2216:     ; Set up the room item with the armos's coordinates.
                            	  2217:     ;
02:00038FCA 19400097        	  2218:     move.b  D0,($0097,A4)
02:00038FCE 10342070        	  2219:     move.b  ($70,A4,D2.W),D0
02:00038FD2 19400083        	  2220:     move.b  D0,($0083,A4)
                            	  2221:     ; This resets the room item's state, which activates it.
                            	  2222:     ;
02:00038FD6 194300BF        	  2223:     move.b  D3,($00BF,A4)
                            	  2224:     ; Set the room item ID.
                            	  2225:     ;
02:00038FDA 7014            	  2226:     moveq   #20,D0
02:00038FDC 194000AB        	  2227:     move.b  D0,($00AB,A4)
                            	  2228:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2229:     ;
                            	  2230:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2231:     ;
                            	  2232:     ; Note that, if the item was already taken, then the room item
                            	  2233:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2234:     ; it will be ignored, because that routine checks whether
                            	  2235:     ; the item was taken.
                            	  2236:     ;
02:00038FE0 4EB900030B56    	  2237:     jsr     GetRoomFlagUWItemState
02:00038FE6 660A            	  2238:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00038FE8 6100069A        	  2239:     jsr     PlaySecretFoundTune
02:00038FEC 6604            	  2240:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2241:     even
