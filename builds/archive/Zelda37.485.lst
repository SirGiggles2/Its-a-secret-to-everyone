                            	  5907: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5908:     ; Store the weapon's frame (horizontal or vertical)
                            	  5909:     ; for the direction chosen above in [0C].
                            	  5910:     ;
02:00048B2C 4EB900030A4E    	  5911:     jsr     GetOppositeDir
02:00048B32 41F900048566    	  5912:     lea     (RDirectionToWeaponFrame).l,A0
02:00048B38 10303000        	  5913:     move.b  (A0,D3.W),D0
02:00048B3C 1940000C        	  5914:     move.b  D0,($000C,A4)
                            	  5915:     ; Calculate sprite attributes.
                            	  5916:     ;
                            	  5917:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5918:     ;   base attribute OR 1
                            	  5919:     ; So, it uses palette row 5.
                            	  5920:     ;
02:00048B40 41F90004856A    	  5921:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048B46 10303000        	  5922:     move.b  (A0,D3.W),D0
02:00048B4A 0C02000D        	  5923:     cmpi.b  #$0D,D2
02:00048B4E 6706            	  5924:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048B50 00000001        	  5925:     ori.b #$01,D0
02:00048B54 601C            	  5926:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5927: 
                            	  5928:     even
                            	  5929: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5930:     ; The weapon is the sword.
                            	  5931:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5932:     ;
02:00048B56 023C00EE        	  5933:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B5A 122C0657        	  5934:     move.b  ($0657,A4),D1
02:00048B5E D101            	  5935:     addx.b  D1,D0   ; ADC Items
02:00048B60 003C0011        	  5936:     ori     #$11,CCR  ; SEC: set C+X
02:00048B64 123C0001        	  5937:     move.b  #$01,D1
02:00048B68 0A3C0010        	  5938:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048B6C 9101            	  5939:     subx.b  D1,D0   ; SBC #$01
02:00048B6E 0A3C0010        	  5940:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5941:     even
                            	  5942: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5943:     ; Set sprite attributes to the calculated value above.
                            	  5944:     ;
02:00048B72 4EB900031110    	  5945:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5946:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5947:     ;
02:00048B78 0C030002        	  5948:     cmpi.b  #$02,D3
02:00048B7C 6604            	  5949:     bne  _anon_z07_33
02:00048B7E 522C000F        	  5950:     addq.b  #1,($000F,A4)
