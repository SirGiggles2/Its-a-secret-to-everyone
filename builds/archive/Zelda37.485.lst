02:0003E6D8 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003E6DC B001            	  3917:     cmp.b   D1,D0
02:0003E6DE 640E            	  3918:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
