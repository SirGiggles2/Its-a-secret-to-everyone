                            	  4490: _anon_z02_35:
02:00034F50 41F900034ECC    	  4491:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00034F56 10303000        	  4492:     move.b  (A0,D3.W),D0
02:00034F5A 41EC0302        	  4493:     lea     ($0302,A4),A0
02:00034F5E 11803000        	  4494:     move.b  D0,(A0,D3.W)
02:00034F62 5303            	  4495:     subq.b  #1,D3
02:00034F64 6AEA            	  4496:     bpl  _anon_z02_35
                            	  4497:     ; Load a character from the string and copy it to
                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:00034F66 7600            	  4500:     moveq   #0,D3
02:00034F68 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034F6C 41F900034F06    	  4502:     lea     (PeaceText).l,A0
02:00034F72 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034F76 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:00034F7A 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034F7C 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
02:00034F80 0C000024        	  4510:     cmpi.b  #$24,D0
02:00034F84 6706            	  4511:     beq  _anon_z02_36
02:00034F86 7010            	  4512:     moveq   #16,D0
02:00034F88 19400604        	  4513:     move.b  D0,($0604,A4)
                            	  4514: _anon_z02_36:
                            	  4515:     ; Point to the next character in the string.
                            	  4516:     ;
02:00034F8C 522C0413        	  4517:     addq.b  #1,($0413,A4)
                            	  4518:     ; Replace the low byte of the VRAM address with the one
