02:0003E684 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003E688 41F90003E654    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E68E 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003E692 B001            	  3878:     cmp.b   D1,D0
02:0003E694 6510            	  3879:     bcs  _anon_z05_95
02:0003E696 41F90003E658    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E69C 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E6A0 B001            	  3882:     cmp.b   D1,D0
02:0003E6A2 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
