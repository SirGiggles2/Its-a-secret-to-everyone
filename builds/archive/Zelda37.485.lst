                            	  2834: _L_z05_MaskInputInBorder_PositiveDir:
                            	  2835:     ; The direction is positive.
                            	  2836:     ;
                            	  2837:     ; If the coordinate crosses (<) the boundary, then
                            	  2838:     ; go mask buttons.
                            	  2839:     ;
                            	  2840:     ;
                            	  2841:     ; Get coordinate in [02].
02:0003DFB2 102C0002        	  2842:     move.b  ($0002,A4),D0
02:0003DFB6 41F90003DEE2    	  2843:     lea     (BorderBounds).l,A0
02:0003DFBC 12303000        	  2844:     move.b  (A0,D3.W),D1
02:0003DFC0 B001            	  2845:     cmp.b   D1,D0
