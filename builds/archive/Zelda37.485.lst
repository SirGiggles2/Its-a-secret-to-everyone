02:00048B8A 0200000F        	  5956:     andi.b #$0F,D0
02:00048B8E 0C000001        	  5957:     cmpi.b  #$01,D0
02:00048B92 6604            	  5958:     bne.s  __far_z_07_0085
02:00048B94 600000AA        	  5959:     jmp  L1F854_Exit
