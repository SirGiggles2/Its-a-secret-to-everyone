                            	   808: _L_z01_TransferDemoPatterns_LoopBlock:
                            	   809:     ; Loop over each block.
                            	   810:     ;
02:0002F5D0 102C051D        	   811:     move.b  ($051D,A4),D0
02:0002F5D4 E308            	   812:     lsl.b  #1,D0   ; ASL A
02:0002F5D6 7400            	   813:     moveq   #0,D2
02:0002F5D8 1400            	   814:     move.b  D0,D2
                            	   815:     ; Put block address in [00:01] and size in [03:02].
                            	   816:     ; Load destination VRAM address and set it.
                            	   817:     ; The size and VRAM address have the high byte first.
                            	   818:     ;
