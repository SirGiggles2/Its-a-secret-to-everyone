02:000354AC 7006            	  4967:     moveq   #6,D0
                            	  4968: _anon_z02_49:
                            	  4969:     ; If the VRAM line number has not just been incremented to
                            	  4970:     ; the reference line number count, then go write NT attributes.
                            	  4971:     ;
02:000354AE 122C050D        	  4972:     move.b  ($050D,A4),D1
