02:00039B8E 610027FE        	  3843:     jsr     Flyer_Chase
                            	  3844:     ; If timer has not expired, then
                            	  3845:     ; go see if it's time to propagate direction changes down the chain.
                            	  3846:     ;
02:00039B92 10342028        	  3847:     move.b  ($28,A4,D2.W),D0
02:00039B96 6702            	  3848:     beq.s  __far_z_04_0026
02:00039B98 6032            	  3849:     jmp  Moldorm_PropagateDirs
                            	  3850: __far_z_04_0026:
