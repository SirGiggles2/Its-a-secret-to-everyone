02:00035074 7000            	  4635:     moveq   #0,D0
02:00035076 6508            	  4636:     bcs  _anon_z02_39
02:00035078 194000FC        	  4637:     move.b  D0,($00FC,A4)
02:0003507C 522C00E2        	  4638:     addq.b  #1,($00E2,A4)
                            	  4639: _anon_z02_39:
