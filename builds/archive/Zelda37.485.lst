                            	   346: _L_z04_Exit_SetDirTowardTarget:
                            	   347:     ; Set the monster's facing direction to the chosen direction
                            	   348:     ; toward the chase target.
                            	   349:     ;
02:000382CC 41EC0098        	   350:     lea     ($0098,A4),A0
02:000382D0 11832000        	   351:     move.b  D3,(A0,D2.W)
                            	   352:     ; Set turn timer to a random value.
                            	   353:     ;
02:000382D4 10342018        	   354:     move.b  ($18,A4,D2.W),D0
02:000382D8 41EC0478        	   355:     lea     ($0478,A4),A0
02:000382DC 11802000        	   356:     move.b  D0,(A0,D2.W)
                            	   357:     ; Set "wants to shoot" flag to 1.
                            	   358:     ;
02:000382E0 7001            	   359:     moveq   #1,D0
02:000382E2 41EC0412        	   360:     lea     ($0412,A4),A0
02:000382E6 11802000        	   361:     move.b  D0,(A0,D2.W)
                            	   362:     ; Go set input direction to facing direction.
                            	   363:     ;
