02:0003A51A 7008            	  5184:     moveq   #8,D0
02:0003A51C 4EB90004908C    	  5185:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5186:     ; If facing left, then enable horizontal flipping.
