                            	  1374: ;----------------------------------------------------------------------
                            	  1375: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1376: ; Layout per slot:
                            	  1377: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1378: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1379: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1380: ;   +3 reserved
                            	  1381: ;
                            	  1382: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1383: ; values are placeholders.
                            	  1384: ;----------------------------------------------------------------------
                            	  1385: PsgDrumTable:
02:00000E10 E7              	  1386:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000E11 00
02:00000E12 00
02:00000E13 00
02:00000E14 E4              	  1387:     dc.b    $E4, $E0, 48,  $00         ; 1: hi-hat  — white NF=00, ~5 frames
02:00000E15 E0
02:00000E16 30
02:00000E17 00
02:00000E18 E5              	  1388:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000E19 FF
02:00000E1A 0E
02:00000E1B 00
02:00000E1C E4              	  1389:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
02:00000E1D E0
02:00000E1E 30
02:00000E1F 00
