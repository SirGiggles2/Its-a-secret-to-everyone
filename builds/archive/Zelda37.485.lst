                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038D42 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038D46 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038D4A 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038D4E 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D52 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038D54 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038D58 0C000030        	  1874:     cmpi.b  #$30,D0
