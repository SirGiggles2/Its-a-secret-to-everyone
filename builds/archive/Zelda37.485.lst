                            	  2303:     ; VDP command: VRAM write $F800 + DMA trigger bit
02:0002AD6A 23FC7800008300C0	  2304:     move.l  #$78000083,(VDP_CTRL).l
02:0002AD72 0004
                            	  2305:     ; Flip active bank: bank just DMA'd becomes "previous"; other bank becomes active
02:0002AD74 0A39000100FF2400	  2306:     eori.b  #1,(SAT_ACTIVE_BANK).l
02:0002AD7C 4CDF0003        	  2307:     movem.l (SP)+,D0/D1
