                            	  2019: ;==============================================================================
                            	  2020: ; OAM DMA
                            	  2021: ;==============================================================================
                            	  2022: 
                            	  2023: ;------------------------------------------------------------------------------
                            	  2024: ; _oam_dma — $4014 write: OAM DMA transfer.
                            	  2025: ;
                            	  2026: ; On NES, writing page number P to $4014 copies 256 bytes from CPU page P
                            	  2027: ; ($PP00–$PPFF) to OAM.  Zelda writes #$02, meaning copy from $0200–$02FF.
                            	  2028: ; NES $0200–$02FF = Genesis $FF0200–$FF02FF.
                            	  2029: ;
                            	  2030: ; T23: Convert 64 NES OAM entries → 64 Genesis SAT entries, write to VRAM $D800.
                            	  2031: ;
                            	  2032: ; NES OAM entry layout (4 bytes, address is OAM byte index):
                            	  2033: ;   [0] Y position (sprite top − 1; visible on scanline Y+1)
                            	  2034: ;   [1] Tile index (0–255, pattern table determined by PPUCTRL bit 3)
                            	  2035: ;   [2] Attribute: bit7=Vflip, bit6=Hflip, bit5=behind-BG, bits1:0=sprite palette
                            	  2036: ;   [3] X position (sprite left edge, 0–255)
                            	  2037: ;
                            	  2038: ; Genesis SAT entry layout (8 bytes at VRAM $D800 + sprite*8):
                            	  2039: ;   Word 0 [bits 8:0]: Y position (=NES_Y+129 for 240-line; 128=top of screen)
                            	  2040: ;   Word 1 [bits 11:8]: size (00=8×8 px); [bits 6:0]: link to next sprite index
                            	  2041: ;   Word 2: tile word → bit15=priority, bits14:13=palette, bit12=Vflip, bit11=Hflip,
                            	  2042: ;                        bits10:0=tile index
                            	  2043: ;   Word 3 [bits 8:0]: X position (=NES_X+128; 128=left of screen)
                            	  2044: ;
                            	  2045: ; Sprite palette mapping: NES sprite palette 0–3 → Genesis palette 0–3 directly.
                            	  2046: ;   (T25 will map NES sprite palettes to CRAM entries 32–63 = Genesis palettes 2–3.)
                            	  2047: ; Priority: bit15 = 1 (sprites always above background planes).
                            	  2048: ; Off-screen: NES Y+129 ≥ 368 means off-screen naturally; no special case needed.
                            	  2049: ;------------------------------------------------------------------------------
                            	  2050: _oam_dma:
                            	  2051:     ifne CHR_EXPANSION_ENABLED
02:0002ABDE 48E7FFE0        	  2052:     movem.l D0-D7/A0-A2,-(SP)
                            	  2053:     else
                            	  2054:     movem.l D0-D7/A0/A2,-(SP)
                            	  2055:     endc
                            	  2056: 
                            	  2057:     ; VSRAM scroll is now driven by _apply_genesis_scroll in IsrNmi.
                            	  2058:     ; The old static 8px bias has been removed.
                            	  2059: 
                            	  2060:     ; Phase 1 (HW adoption): write into SAT_SHADOW bank instead of VDP data
                            	  2061:     ; port.  DMA from the same bank happens at the top of the NEXT frame's
                            	  2062:     ; VBlankISR via _oam_dma_flush.  One-frame OAM display latency.
02:0002ABE2 45F900FF2000    	  2063:     lea     (SAT_SHADOW_A).l,A2
02:0002ABE8 4A3900FF2400    	  2064:     tst.b   (SAT_ACTIVE_BANK).l
02:0002ABEE 6706            	  2065:     beq.s   .sat_bank_picked
02:0002ABF0 45F900FF2200    	  2066:     lea     (SAT_SHADOW_B).l,A2
                            	  2067: .sat_bank_picked:
                            	  2068: 
02:0002ABF6 41F900FF0200    	  2069:     lea     (NES_RAM_BASE+$0200).l,A0  ; A0 → NES OAM buffer ($FF0200)
02:0002ABFC 7E3F            	  2070:     moveq   #63,D7                     ; loop: 64 sprites (dbra counts 63→0)
02:0002ABFE 7C00            	  2071:     moveq   #0,D6                      ; D6 = current sprite index (0..63)
                            	  2072:     ; V64 gap compensation: when the display wraps through the 32px gap
                            	  2073:     ; at pixels 480-511, BG content below the gap is shifted 32px down.
                            	  2074:     ; Compute the Genesis Y threshold: sprites at or below this line need
                            	  2075:     ; +32 to match their shifted BG text.  Store in D6 upper word (0=no gap).
02:0002AC00 3A3900FF0838    	  2076:     move.w  (ACTIVE_EVENT_VSRAM).l,D5
02:0002AC06 064500E0        	  2077:     addi.w  #224,D5
02:0002AC0A 0C450200        	  2078:     cmpi.w  #512,D5
02:0002AC0E 6310            	  2079:     bls.s   .oam_no_gap_setup          ; display doesn't wrap through gap
02:0002AC10 3A3C0260        	  2080:     move.w  #608,D5                    ; 608 = 480 (gap start) + 128 (Y origin)
02:0002AC14 9A7900FF0838    	  2081:     sub.w   (ACTIVE_EVENT_VSRAM).l,D5  ; D5 = gap threshold in Genesis Y
02:0002AC1A 4846            	  2082:     swap    D6
02:0002AC1C 3C05            	  2083:     move.w  D5,D6
02:0002AC1E 4846            	  2084:     swap    D6
                            	  2085: .oam_no_gap_setup:
                            	  2086: 
                            	  2087: .oam_loop:
                            	  2088:     ; ── Read 4 NES OAM bytes ────────────────────────────�
02:0002AC20 7000            	  2089:     moveq   #0,D0
02:0002AC22 1018            	  2090:     move.b  (A0)+,D0            ; D0.w = NES Y (sprite top − 1)
02:0002AC24 7200            	  2091:     moveq   #0,D1
02:0002AC26 1218            	  2092:     move.b  (A0)+,D1            ; D1.w = tile index
02:0002AC28 7400            	  2093:     moveq   #0,D2
02:0002AC2A 1418            	  2094:     move.b  (A0)+,D2            ; D2.w = attribute byte
02:0002AC2C 7600            	  2095:     moveq   #0,D3
02:0002AC2E 1618            	  2096:     move.b  (A0)+,D3            ; D3.w = NES X
                            	  2097: 
                            	  2098:     ; ── Word 0: Genesis Y ─────────────────────────────�
                            	  2099:     ; NES sprite is visible on scanline (NES_Y + 1).
                            	  2100:     ; Genesis 240-line: screen line 0 is at Y=128 → Genesis Y = 128 + screen_line
                            	  2101:     ;   = 128 + (NES_Y + 1) = NES_Y + 129
                            	  2102:     ; Sprites with NES_Y ≥ 239 produce Genesis Y ≥ 368 which is naturally off-screen.
02:0002AC30 3800            	  2103:     move.w  D0,D4
02:0002AC32 06440081        	  2104:     addi.w  #129,D4
                            	  2105:     ; Phase 12: _ags_compute_stage adds +8 to VSRAM for overscan in ALL
                            	  2106:     ; modes.  This shifts the BG up 8px.  Sprites must compensate with a
                            	  2107:     ; matching -8 Y lift, otherwise they appear 8px too low relative to
                            	  2108:     ; background text/tiles.  Previously gated to Mode 0 only (Diary #26),
                            	  2109:     ; but fs2_probe confirmed VSRAM=8 during file-select, proving the lift
                            	  2110:     ; must be unconditional.
02:0002AC36 0C000008        	  2111:     cmpi.b  #8,D0
02:0002AC3A 6502            	  2112:     bcs.s   .oam_gap_check          ; NES Y < 8 → skip lift (top-edge)
02:0002AC3C 5144            	  2113:     subi.w  #8,D4
                            	  2114: .oam_gap_check:
02:0002AC3E 4846            	  2115:     swap    D6                      ; access gap threshold from upper word
02:0002AC40 4A46            	  2116:     tst.w   D6
02:0002AC42 6712            	  2117:     beq.s   .oam_gap_done           ; 0 = no gap visible
                            	  2118:     ; Gradual ramp: offset = clamp(sprite_Y - gap_top + 1, 0, 32).
                            	  2119:     ; Sprites well above the gap get 0 (untouched); sprites crossing the gap
                            	  2120:     ; boundary ramp in at 1px/frame up to a max +32 shift to match the shifted
                            	  2121:     ; BG below the V64 dead zone.  Avoids the single-frame 32px teleport that
                            	  2122:     ; occurred with a hard threshold.  D0 is scratch here — it's reloaded at
                            	  2123:     ; the top of the next .oam_loop iteration.
02:0002AC44 3004            	  2124:     move.w  D4,D0                   ; D0 = adjusted sprite Y
02:0002AC46 9046            	  2125:     sub.w   D6,D0                   ; D0 = Y - gap_top
02:0002AC48 5240            	  2126:     addq.w  #1,D0                   ; D0 = Y - gap_top + 1
02:0002AC4A 6F0A            	  2127:     ble.s   .oam_gap_done           ; <= 0: sprite above gap, no offset
02:0002AC4C 0C400020        	  2128:     cmpi.w  #32,D0
02:0002AC50 6302            	  2129:     bls.s   .oam_gap_apply
02:0002AC52 7020            	  2130:     moveq   #32,D0                  ; cap ramp at full 32px shift
                            	  2131: .oam_gap_apply:
02:0002AC54 D840            	  2132:     add.w   D0,D4                   ; apply gradual offset
                            	  2133: .oam_gap_done:
02:0002AC56 4846            	  2134:     swap    D6                      ; restore sprite index in low word
                            	  2135: .oam_write_y:
02:0002AC58 34C4            	  2136:     move.w  D4,(A2)+                ; Phase 1: SAT_SHADOW write (was VDP_DATA)
                            	  2137: 
                            	  2138:     ; ── Word 1: size | link ────────────────────────────�
                            	  2139:     ; Link field: chain sprites 0→1→2→...→63→0
02:0002AC5A 3806            	  2140:     move.w  D6,D4
02:0002AC5C 5244            	  2141:     addq.w  #1,D4               ; D4 = this_sprite_index + 1
02:0002AC5E 0C440040        	  2142:     cmpi.w  #64,D4              ; is this the last sprite?
02:0002AC62 6602            	  2143:     bne     .write_link
02:0002AC64 7800            	  2144:     moveq   #0,D4               ; yes → link = 0 (terminate list)
                            	  2145: .write_link:
                            	  2146:     ; Size: check PPUCTRL bit 5 for 8×16 sprite mode
                            	  2147:     ; Genesis SAT word 1: [11:10]=H-size, [9:8]=V-size, [6:0]=link
02:0002AC66 0839000500FF0804	  2148:     btst    #5,(PPU_CTRL).l
02:0002AC6E 6704            	  2149:     beq.s   .oam_size_done
02:0002AC70 00440100        	  2150:     ori.w   #$0100,D4           ; V-size = 2 (8×16: two 8×8 cells stacked)
                            	  2151: .oam_size_done:
02:0002AC74 34C4            	  2152:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write size | link
                            	  2153: 
                            	  2154:     ; ── Word 2: tile word (priority | palette | Vflip | Hflip | tile) ────
                            	  2155:     ; Compute Genesis tile index based on sprite size mode
02:0002AC76 0839000500FF0804	  2156:     btst    #5,(PPU_CTRL).l
02:0002AC7E 6712            	  2157:     beq.s   .oam_8x8
                            	  2158:     ; 8×16 mode: tile byte bit 0 = pattern table, bits 7:1 = tile pair
02:0002AC80 3A01            	  2159:     move.w  D1,D5
02:0002AC82 02450001        	  2160:     andi.w  #$0001,D5           ; pattern table bit
02:0002AC86 E14D            	  2161:     lsl.w   #8,D5               ; $0000 or $0100
02:0002AC88 3801            	  2162:     move.w  D1,D4
02:0002AC8A 024400FE        	  2163:     andi.w  #$00FE,D4           ; tile pair (even tile number)
02:0002AC8E 8A44            	  2164:     or.w    D4,D5               ; Genesis tile index
02:0002AC90 6014            	  2165:     bra.s   .oam_have_tile
                            	  2166: .oam_8x8:
                            	  2167:     ; 8×8 mode: check PPUCTRL bit 3 for sprite pattern table
02:0002AC92 3A01            	  2168:     move.w  D1,D5
02:0002AC94 024500FF        	  2169:     andi.w  #$00FF,D5
02:0002AC98 0839000300FF0804	  2170:     btst    #3,(PPU_CTRL).l
02:0002ACA0 6704            	  2171:     beq.s   .oam_have_tile
02:0002ACA2 00450100        	  2172:     ori.w   #$0100,D5           ; pattern table $1000 → tile +$100
                            	  2173: .oam_have_tile:
                            	  2174:     ifne CHR_EXPANSION_ENABLED
                            	  2175:     ; T-CHR S9 v8: NES sprite sub-palettes packed into UNUSED TAIL SLOTS of BG
                            	  2176:     ; palettes — sub-pal 0/1/2 → PAL0 (biased to slots 4/8/12), sub-pal 3 → PAL1
                            	  2177:     ; (biased to slot 4).  BG palettes themselves untouched.  CHR tiles live in
                            	  2178:     ; copy N (0..3) at VRAM $0000/$4000/$6000/$8000.
02:0002ACA6 3802            	  2179:     move.w  D2,D4
02:0002ACA8 02440003        	  2180:     andi.w  #$0003,D4           ; NES sub-palette (0..3)
02:0002ACAC D844            	  2181:     add.w   D4,D4               ; word index
02:0002ACAE 43FA0046        	  2182:     lea     (.oam_tile_bias_tbl,PC),A1
02:0002ACB2 DA714000        	  2183:     add.w   (A1,D4.W),D5        ; apply per-copy tile bias
02:0002ACB6 024507FF        	  2184:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2185:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2186:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
02:0002ACBA 08020005        	  2187:     btst    #5,D2
02:0002ACBE 6604            	  2188:     bne.s   .spr_low_prio_che
02:0002ACC0 00458000        	  2189:     ori.w   #$8000,D5           ; bit 15 = high priority
                            	  2190: .spr_low_prio_che:
02:0002ACC4 43FA0038        	  2191:     lea     (.oam_pal_bits_tbl,PC),A1
02:0002ACC8 8A714000        	  2192:     or.w    (A1,D4.W),D5        ; OR in palette bits (PAL0/PAL0/PAL0/PAL1)
                            	  2193:     else
                            	  2194:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2195:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2196:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
                            	  2197:     btst    #5,D2
                            	  2198:     bne.s   .spr_low_prio_noche
                            	  2199:     ori.w   #$8000,D5           ; bit 15 = high priority (sprite over planes)
                            	  2200: .spr_low_prio_noche:
                            	  2201:     ; Palette: NES sprite attr[1:0] → Genesis bits[14:13], offset +2
                            	  2202:     move.w  D2,D4
                            	  2203:     andi.w  #$0003,D4           ; isolate NES sprite palette (0–3)
                            	  2204:     ori.w   #$0002,D4           ; offset: NES sprite pal 0,1→Genesis pal 2,3
                            	  2205:     andi.w  #$0003,D4           ; mask (0→2, 1→3, 2→2, 3→3)
                            	  2206:     lsl.w   #5,D4               ; shift left 5
                            	  2207:     lsl.w   #8,D4               ; shift left 8 more → total shift 13 → bits[14:13]
                            	  2208:     or.w    D4,D5               ; merge palette
                            	  2209:     endc
                            	  2210:     ; V-flip: NES attr bit 7 → Genesis tile word bit 12
02:0002ACCC 08020007        	  2211:     btst    #7,D2
02:0002ACD0 6704            	  2212:     beq     .no_vflip
02:0002ACD2 00451000        	  2213:     ori.w   #$1000,D5           ; set bit 12
                            	  2214: .no_vflip:
                            	  2215:     ; H-flip: NES attr bit 6 → Genesis tile word bit 11
02:0002ACD6 08020006        	  2216:     btst    #6,D2
02:0002ACDA 6704            	  2217:     beq     .no_hflip
02:0002ACDC 00450800        	  2218:     ori.w   #$0800,D5           ; set bit 11
                            	  2219: .no_hflip:
02:0002ACE0 34C5            	  2220:     move.w  D5,(A2)+            ; Phase 1: SAT_SHADOW write tile word
                            	  2221: 
                            	  2222:     ; ── Word 3: Genesis X ─────────────────────────────�
                            	  2223:     ; Genesis 40-cell: screen column 0 is at X=128 → Genesis X = NES_X + 128
02:0002ACE2 3803            	  2224:     move.w  D3,D4
02:0002ACE4 06440080        	  2225:     addi.w  #128,D4
02:0002ACE8 34C4            	  2226:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write X
                            	  2227: 
02:0002ACEA 5246            	  2228:     addq.w  #1,D6               ; advance sprite index
02:0002ACEC 51CFFF32        	  2229:     dbra    D7,.oam_loop
                            	  2230:     ifne CHR_EXPANSION_ENABLED
02:0002ACF0 4CDF07FF        	  2231:     movem.l (SP)+,D0-D7/A0-A2
                            	  2232:     else
                            	  2233:     movem.l (SP)+,D0-D7/A0/A2
                            	  2234:     endc
02:0002ACF4 4E75            	  2235:     rts
                            	  2236: 
                            	  2237:     ifne CHR_EXPANSION_ENABLED
                            	  2238: .oam_tile_bias_tbl:
02:0002ACF6 0000            	  2239:     dc.w    0                   ; NES sub-pal 0 → shared bank A @ VRAM $0000
02:0002ACF8 0200            	  2240:     dc.w    512                 ; NES sub-pal 1 → bank B @ VRAM $4000 (tile 512)
02:0002ACFA 0400            	  2241:     dc.w    1024                ; NES sub-pal 2 → bank C @ VRAM $8000 (tile 1024)
02:0002ACFC 0000            	  2242:     dc.w    0                   ; NES sub-pal 3 → shared bank A @ VRAM $0000
                            	  2243: .oam_pal_bits_tbl:
02:0002ACFE 0000            	  2244:     dc.w    $0000               ; sub-pal 0 → PAL0 (bits 14:13 = 00)
02:0002AD00 0000            	  2245:     dc.w    $0000               ; sub-pal 1 → PAL0
02:0002AD02 0000            	  2246:     dc.w    $0000               ; sub-pal 2 → PAL0
02:0002AD04 2000            	  2247:     dc.w    $2000               ; sub-pal 3 → PAL1 (bits 14:13 = 01)
                            	  2248:     endc
                            	  2249: 
                            	  2250: ;==============================================================================
                            	  2251: ; _oam_dma_flush — Phase 1: transfer previous-frame SAT_SHADOW bank via VDP
                            	  2252: ;   68k→VRAM DMA to sprite attribute table at $F800.
                            	  2253: ;
                            	  2254: ; Must be called at the TOP of VBlankISR (before IsrNmi).  IsrNmi can extend
                            	  2255: ; into active display past scanline 40, so scheduling the DMA at the tail of
                            	  2256: ; VBlankISR would miss vblank.  The DMA source is the bank CURRENTLY flagged
                            	  2257: ; by SAT_ACTIVE_BANK — that is, the bank the previous frame's _oam_dma just
                            	  2258: ; finished filling.  After DMA setup the flag flips so the new frame's
                            	  2259: ; _oam_dma writes the OTHER bank.
                            	  2260: ;
                            	  2261: ; DMA params:
                            	  2262: ;   Reg 19/20: length = 256 words ($0100)
                            	  2263: ;   Reg 21/22/23: source = SAT_SHADOW_A or SAT_SHADOW_B (word address / 2)
                            	  2264: ;   VDP cmd: $78000083 (VRAM write $F800 + CD5 DMA bit)
                            	  2265: ;
                            	  2266: ; No busy-poll needed: DMA is fire-and-forget from 68k RAM.  Next VDP access
                            	  2267: ; (later in VBlankISR) will stall briefly if transfer still in flight.
                            	  2268: ;==============================================================================
                            	  2269:     even
                            	  2270: _oam_dma_flush:
02:0002AD06 48E7C000        	  2271:     movem.l D0/D1,-(SP)
02:0002AD0A 7000            	  2272:     moveq   #0,D0
02:0002AD0C 103900FF2400    	  2273:     move.b  (SAT_ACTIVE_BANK).l,D0
                            	  2274:     ; D0 = 0 → source = SAT_SHADOW_A; D0 = 1 → source = SAT_SHADOW_B
02:0002AD12 223C00FF2000    	  2275:     move.l  #SAT_SHADOW_A,D1
02:0002AD18 4A00            	  2276:     tst.b   D0
02:0002AD1A 6706            	  2277:     beq.s   .oflush_src_ready
02:0002AD1C 223C00FF2200    	  2278:     move.l  #SAT_SHADOW_B,D1
                            	  2279: .oflush_src_ready:
                            	  2280:     ; Length: 256 words. Reg 19 = lo byte = $00, Reg 20 = hi byte = $01
02:0002AD22 33FC930000C00004	  2281:     move.w  #$9300,(VDP_CTRL).l   ; Reg 19: length lo = $00
02:0002AD2A 33FC940100C00004	  2282:     move.w  #$9401,(VDP_CTRL).l   ; Reg 20: length hi = $01
                            	  2283:     ; Source addr in words: D1 >> 1
02:0002AD32 E289            	  2284:     lsr.l   #1,D1
                            	  2285:     ; Reg 21 = source[7:0]
02:0002AD34 3001            	  2286:     move.w  D1,D0
02:0002AD36 024000FF        	  2287:     andi.w  #$00FF,D0
02:0002AD3A 00409500        	  2288:     ori.w   #$9500,D0
02:0002AD3E 33C000C00004    	  2289:     move.w  D0,(VDP_CTRL).l
