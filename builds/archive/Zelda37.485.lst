                            	  5621: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5622:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5623:     ; We need to remember how many tiles need to be copied
                            	  5624:     ; in each transfer record.
                            	  5625:     ;
02:0003FD90 102C0006        	  5626:     move.b  ($0006,A4),D0
02:0003FD94 19400004        	  5627:     move.b  D0,($0004,A4)
                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:0003FD98 1014            	  5632:     move.b  ($0000,A4),D0
02:0003FD9A 41EC0302        	  5633:     lea     ($0302,A4),A0
02:0003FD9E 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:0003FDA2 5202            	  5635:     addq.b  #1,D2
02:0003FDA4 102C0001        	  5636:     move.b  ($0001,A4),D0
02:0003FDA8 41EC0302        	  5637:     lea     ($0302,A4),A0
02:0003FDAC 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:0003FDB0 5202            	  5639:     addq.b  #1,D2
02:0003FDB2 102C0006        	  5640:     move.b  ($0006,A4),D0
02:0003FDB6 41EC0302        	  5641:     lea     ($0302,A4),A0
02:0003FDBA 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:0003FDBE 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:0003FDC0 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:0003FDC4 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:0003FDC6 7020            	  5652:     moveq   #32,D0
02:0003FDC8 122C0001        	  5653:     move.b  ($0001,A4),D1
02:0003FDCC 8001            	  5654:     or.b  D1,D0
02:0003FDCE 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:0003FDD2 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:0003FDD6 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:0003FDD8 103C00FF        	  5664:     move.b  #$FF,D0
02:0003FDDC 41EC0302        	  5665:     lea     ($0302,A4),A0
02:0003FDE0 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:0003FDE4 1002            	  5667:     move.b  D2,D0
02:0003FDE6 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:0003FDEA 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:0003FDEE 102C0054        	  5678:     move.b  ($0054,A4),D0
02:0003FDF2 02000003        	  5679:     andi.b #$03,D0
02:0003FDF6 6708            	  5680:     beq  _anon_z05_122
02:0003FDF8 7008            	  5681:     moveq   #8,D0
02:0003FDFA 19400027        	  5682:     move.b  D0,($0027,A4)
02:0003FDFE 4E75            	  5683:     rts
                            	  5684: 
                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:0003FE00 102C0054        	  5693:     move.b  ($0054,A4),D0
02:0003FE04 0C000004        	  5694:     cmpi.b  #$04,D0
02:0003FE08 6626            	  5695:     bne  _anon_z05_123
02:0003FE0A 7400            	  5696:     moveq   #0,D2
02:0003FE0C 142C0009        	  5697:     move.b  ($0009,A4),D2
02:0003FE10 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:0003FE14 102C0055        	  5699:     move.b  ($0055,A4),D0
02:0003FE18 0A00000F        	  5700:     eori.b #$0F,D0
02:0003FE1C 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:0003FE20 C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0003FE22 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:0003FE26 7000            	  5708:     moveq   #0,D0
02:0003FE28 19400054        	  5709:     move.b  D0,($0054,A4)
02:0003FE2C 6000FCD4        	  5710:     jmp     LayOutDoors
                            	  5711: 
                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:0003FE30 102C0055        	  5719:     move.b  ($0055,A4),D0
02:0003FE34 19400002        	  5720:     move.b  D0,($0002,A4)
02:0003FE38 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:0003FE3C 0C000007        	  5722:     cmpi.b  #$07,D0
02:0003FE40 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:0003FE42 7400            	  5728:     moveq   #0,D2
02:0003FE44 142C0009        	  5729:     move.b  ($0009,A4),D2
02:0003FE48 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:0003FE4C 1003            	  5733:     move.b  D3,D0
02:0003FE4E 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FE52 41F90003FD0E    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:0003FE58 12302000        	  5736:     move.b  (A0,D2.W),D1
02:0003FE5C D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0003FE5E 7600            	  5738:     moveq   #0,D3
02:0003FE60 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:0003FE62 1002            	  5742:     move.b  D2,D0
02:0003FE64 0A000001        	  5743:     eori.b #$01,D0
02:0003FE68 7400            	  5744:     moveq   #0,D2
02:0003FE6A 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:0003FE6C 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:0003FE6E 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
