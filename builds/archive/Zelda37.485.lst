02:0004879A 11802000        	  5432:     move.b  D0,(A0,D2.W)
                            	  5433:     ; If facing left and X < 2, then go change state to $40. The
                            	  5434:     ; boomerang is too close to the left edge of the screen.
                            	  5435:     ; Another move might make it wrap around.
                            	  5436:     ;
02:0004879E 41EC0098        	  5437:     lea     ($0098,A4),A0
