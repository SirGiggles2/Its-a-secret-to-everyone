                            	  4477: UpdatePeaceTextbox:
                            	  4478:     ; Only emit a character once every 8 frames --
                            	  4479:     ; when (counter [0412] MOD 8) = 4.
                            	  4480:     ;
02:00034F3C 522C0412        	  4481:     addq.b  #1,($0412,A4)
02:00034F40 102C0412        	  4482:     move.b  ($0412,A4),D0
02:00034F44 02000007        	  4483:     andi.b #$07,D0
02:00034F48 0C000004        	  4484:     cmpi.b  #$04,D0
