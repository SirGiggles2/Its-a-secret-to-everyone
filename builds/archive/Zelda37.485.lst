02:00035498 522C050D        	  4957:     addq.b  #1,($050D,A4)
                            	  4958:     ; In each VRAM page there are 8 lines, except in ones where
                            	  4959:     ; (page MOD 4) = 3. This means $23xx and $2Bxx.
                            	  4960:     ; These pages have 6 lines.
