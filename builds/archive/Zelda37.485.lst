                            	  2156:     ; in the current slot's name.
02:00033762 41F900033176    	  2157:     lea     (SlotToNameOffset).l,A0
02:00033768 10303000        	  2158:     move.b  (A0,D3.W),D0
02:0003376C 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:00033770 7400            	  2162:     moveq   #0,D2
02:00033772 41F90003317A    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033778 14303000        	  2164:     move.b  (A0,D3.W),D2
