02:00034E72 0A3C0010        	  4404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E76 9101            	  4405:     subx.b  D1,D0   ; SBC #$10
02:00034E78 0A3C0010        	  4406:     eori    #$10,CCR  ; restore X = 6502 C
