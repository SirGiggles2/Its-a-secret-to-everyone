02:00038C8A 0C0000C0        	  1762:     cmpi.b  #$C0,D0
02:00038C8E 6506            	  1763:     bcs  _anon_z04_43
02:00038C90 4EB900048002    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
02:00038C96 41EC0098        	  1768:     lea     ($0098,A4),A0
02:00038C9A 10302000        	  1769:     move.b  (A0,D2.W),D0
02:00038C9E 0200000C        	  1770:     andi.b #$0C,D0
