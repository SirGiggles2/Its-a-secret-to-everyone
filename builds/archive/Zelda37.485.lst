                            	  8713: _anon_z04_165:
02:0003BF6A 1003            	  8714:     move.b  D3,D0
02:0003BF6C 1B00            	  8715:     move.b  D0,-(A5)  ; PHA
                            	  8716:     ; Get the length, to append to the dynamic transfer buf.
                            	  8717:     ;
02:0003BF6E 7400            	  8718:     moveq   #0,D2
02:0003BF70 142C0301        	  8719:     move.b  ($0301,A4),D2
                            	  8720:     ; Copy the 8 bytes of the palette row transfer record template.
                            	  8721:     ;
02:0003BF74 7600            	  8722:     moveq   #0,D3
                            	  8723:     even
                            	  8724: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003BF76 41F90003BF4E    	  8725:     lea     (GanonColorTransferRecord).l,A0
02:0003BF7C 10303000        	  8726:     move.b  (A0,D3.W),D0
02:0003BF80 41EC0302        	  8727:     lea     ($0302,A4),A0
02:0003BF84 11802000        	  8728:     move.b  D0,(A0,D2.W)
02:0003BF88 5202            	  8729:     addq.b  #1,D2
