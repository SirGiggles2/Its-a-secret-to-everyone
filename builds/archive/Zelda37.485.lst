                            	  5564: __far_z_05_0076:
                            	  5565:     ; Turn the door command into the desired open or closed state
                            	  5566:     ; to store in [08].
                            	  5567:     ;
                            	  5568:     ; cmd:  7 6 3 2 
                            	  5569:     ; [08]: 2 0 0 0
                            	  5570:     ;
                            	  5571:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5572:     ; commands intended to be used.
                            	  5573:     ;
                            	  5574:     ; 3 is the end state of 2: close
                            	  5575:     ; 7 is the end state of 6: open
                            	  5576:     ;
02:0003FD2E 02000007        	  5577:     andi.b #$07,D0
02:0003FD32 7601            	  5578:     moveq   #1,D3
02:0003FD34 19430002        	  5579:     move.b  D3,($0002,A4)
02:0003FD38 122C0002        	  5580:     move.b  ($0002,A4),D1
02:0003FD3C C200            	  5581:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003FD3E 6702            	  5582:     beq  _anon_z05_118
02:0003FD40 E208            	  5583:     lsr.b  #1,D0   ; LSR A
                            	  5584: _anon_z05_118:
02:0003FD42 0C000002        	  5585:     cmpi.b  #$02,D0
02:0003FD46 6606            	  5586:     bne  _anon_z05_119
                            	  5587:     ; Command 2 sets Link's timer to $30.
                            	  5588:     ;
02:0003FD48 7630            	  5589:     moveq   #48,D3
02:0003FD4A 19430028        	  5590:     move.b  D3,($0028,A4)
                            	  5591: _anon_z05_119:
02:0003FD4E 02000003        	  5592:     andi.b #$03,D0
02:0003FD52 003C0011        	  5593:     ori     #$11,CCR  ; SEC: set C+X
02:0003FD56 123C0001        	  5594:     move.b  #$01,D1
02:0003FD5A 0A3C0010        	  5595:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FD5E 9101            	  5596:     subx.b  D1,D0   ; SBC #$01
02:0003FD60 0A3C0010        	  5597:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FD64 02000002        	  5598:     andi.b #$02,D0
02:0003FD68 19400008        	  5599:     move.b  D0,($0008,A4)
                            	  5600:     ; The command to close a key door or bombable wall does not
                            	  5601:     ; do anything.
                            	  5602:     ;
02:0003FD6C 102C0054        	  5603:     move.b  ($0054,A4),D0
