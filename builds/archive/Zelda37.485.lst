                            	  2445: 
                            	  2446:     even
                            	  2447: PondFairy_HandleOtherStates:
02:0003913C 0C000001        	  2448:     cmpi.b  #$01,D0
02:00039140 6610            	  2449:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2450:     ; State 1. Flying and filling hearts.
                            	  2451:     ;
                            	  2452:     ; If still filling hearts, then go draw Link and hearts.
                            	  2453:     ;
02:00039142 102C0063        	  2454:     move.b  ($0063,A4),D0
02:00039146 6620            	  2455:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2456:     ; If not filling hearts anymore, then go to state 2,
                            	  2457:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2458:     ; a little while after we finish filling hearts.
                            	  2459:     ;
02:00039148 522C00AD        	  2460:     addq.b  #1,($00AD,A4)
02:0003914C 7050            	  2461:     moveq   #80,D0
02:0003914E 19400029        	  2462:     move.b  D0,($0029,A4)
                            	  2463:     even
                            	  2464: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2465:     ; If state <> 2 (so, it's 3), then return.
                            	  2466:     ;
                            	  2467:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2468:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2469:     ; was set to, and we'll return.
                            	  2470:     ;
02:00039152 0C000002        	  2471:     cmpi.b  #$02,D0
02:00039156 6634            	  2472:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2473:     ; State = 2.
                            	  2474:     ;
                            	  2475:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2476:     ;
02:00039158 102C0029        	  2477:     move.b  ($0029,A4),D0
02:0003915C 660A            	  2478:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2479:     ; Else go to state 3, and unhalt Link.
                            	  2480:     ;
02:0003915E 522C00AD        	  2481:     addq.b  #1,($00AD,A4)
02:00039162 7000            	  2482:     moveq   #0,D0
02:00039164 194000AC        	  2483:     move.b  D0,($00AC,A4)
                            	  2484:     even
