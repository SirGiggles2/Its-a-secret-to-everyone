02:00038D2E B001            	  1853:     cmp.b   D1,D0
02:00038D30 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038D32 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038D34 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038D38 19400002        	  1857:     move.b  D0,($0002,A4)
