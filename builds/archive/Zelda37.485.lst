                            	  1106:     ;======================================================================
                            	  1107:     ; T19: Palette writes ($3F00–$3F1F) → Genesis CRAM.
                            	  1108:     ;======================================================================
                            	  1109: .t19_palette:
02:0000E668 0C413F20        	  1110:     cmpi.w  #$3F20,D1
02:0000E66C 6472            	  1111:     bhs.s   .nt_skip_write          ; ≥$3F20: mirror / overflow — skip
                            	  1112: 
                            	  1113:     ; Compute CRAM address from PPU_VADDR
02:0000E66E 3401            	  1114:     move.w  D1,D2
02:0000E670 04423F00        	  1115:     subi.w  #$3F00,D2               ; D2.w = offset (0..31)
02:0000E674 0242001F        	  1116:     andi.w  #$001F,D2               ; mask to 5 bits
                            	  1117: 
                            	  1118:     ; NES palette handling:
                            	  1119:     ; Offsets 0-15  ($3F00-$3F0F): BG palettes → Genesis CRAM pal 0-3
                            	  1120:     ; Offset entry-0s (0,4,8,12,16,20,24,28): universal BG color mirror
                            	  1121:     ; Offsets 16-31 ($3F10-$3F1F): sprite palettes → Genesis CRAM pal 2-3
                            	  1122:     ;   (NES sprite pal 0,2→Genesis pal 2; NES sprite pal 1,3→Genesis pal 3)
                            	  1123:     ; Sequential last-write-wins: sprite pals 2,3 end up in PAL2/PAL3 which
                            	  1124:     ; gives correct sprite colors (red hearts, green grass) while BG text
                            	  1125:     ; only uses PAL0/PAL1 during the story phase, so BG2/BG3 clobber is OK.
                            	  1126:     ; _oam_dma maps NES sprite pal bits → Gen pal 2/3 to match.
02:0000E678 0C420010        	  1127:     cmpi.w  #$10,D2
02:0000E67C 652C            	  1128:     blo.s   .t19_bg_color           ; offset < 16: BG palette
                            	  1129:     ; Sprite palette (offset 16-31)
02:0000E67E 3602            	  1130:     move.w  D2,D3
02:0000E680 02430003        	  1131:     andi.w  #$0003,D3               ; color slot within palette
02:0000E684 6720            	  1132:     beq.s   .t19_spr_entry0         ; slot 0 → BG mirror
                            	  1133:     ; Non-entry-0 sprite color: remap
                            	  1134:     ifne CHR_EXPANSION_ENABLED
                            	  1135:     ; T-CHR S8 (v2): pack sprite sub-palettes into unused tail slots of BG
                            	  1136:     ; palettes so BG PAL0-3[0..3] stay untouched.
                            	  1137:     ;   sub-pal 0 → PAL0[4..7]   (CRAM base $08, bias +4 pixels)
                            	  1138:     ;   sub-pal 1 → PAL0[8..11]  (CRAM base $10, bias +8 pixels)
                            	  1139:     ;   sub-pal 2 → PAL0[12..15] (CRAM base $18, bias +12 pixels)
                            	  1140:     ;   sub-pal 3 → PAL1[4..7]   (CRAM base $28, bias +4 pixels, different palette)
02:0000E686 3602            	  1141:     move.w  D2,D3
02:0000E688 04430010        	  1142:     subi.w  #$10,D3                 ; D3 = 0..15 within sprite range
02:0000E68C E44B            	  1143:     lsr.w   #2,D3                   ; D3 = sub-pal (0..3)
02:0000E68E D643            	  1144:     add.w   D3,D3                   ; * 2 for word index
02:0000E690 43F90000E6E8    	  1145:     lea     (.t19_spr_cram_base).l,A1
02:0000E696 36313000        	  1146:     move.w  (A1,D3.W),D3            ; D3 = CRAM base for this sub-pal
02:0000E69A 3802            	  1147:     move.w  D2,D4
02:0000E69C 02440003        	  1148:     andi.w  #$0003,D4               ; color slot (1..3)
02:0000E6A0 D844            	  1149:     add.w   D4,D4                   ; * 2
02:0000E6A2 D644            	  1150:     add.w   D4,D3                   ; D3 = CRAM address
                            	  1151:     else
                            	  1152:     ; Legacy last-write-wins: NES sprite pal 0-3 → Gen pal 2|3 (2,3,2,3).
                            	  1153:     move.w  D2,D3
                            	  1154:     subi.w  #$10,D3                 ; 0-15 range
                            	  1155:     lsr.w   #2,D3                   ; NES sprite pal (0-3)
                            	  1156:     ori.w   #$0002,D3               ; Genesis pal = NES_pal | 2 (→ 2,3,2,3)
                            	  1157:     lsl.w   #5,D3                   ; * $20 = CRAM palette base
                            	  1158:     move.w  D2,D2
                            	  1159:     andi.w  #$0003,D2               ; color slot (1-3)
                            	  1160:     lsl.w   #1,D2                   ; * 2
                            	  1161:     add.w   D2,D3                   ; D3 = CRAM address
                            	  1162:     endc
02:0000E6A4 6012            	  1163:     bra.s   .t19_have_cram
                            	  1164: .t19_spr_entry0:
                            	  1165:     ; Sprite entry-0 = BG mirror: remap 16→0, 20→4, 24→8, 28→12
02:0000E6A6 04420010        	  1166:     subi.w  #$10,D2
                            	  1167: .t19_bg_color:
02:0000E6AA 3602            	  1168:     move.w  D2,D3
02:0000E6AC E44B            	  1169:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:0000E6AE EB4B            	  1170:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:0000E6B0 02420003        	  1171:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
02:0000E6B4 E34A            	  1172:     lsl.w   #1,D2                   ; D2.w = color * 2
02:0000E6B6 D642            	  1173:     add.w   D2,D3                   ; D3.w = CRAM address (0..$66)
