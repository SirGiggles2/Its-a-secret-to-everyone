02:0004794A 10302000        	  3216:     move.b  (A0,D2.W),D0
02:0004794E 02000001        	  3217:     andi.b #$01,D0
02:00047952 6620            	  3218:     bne  _L_z07_BeginUpdateWorld_NextObject
                            	  3219:     ; If no attribute 1, then it indicates not to skip drawing. So, animate and draw.
                            	  3220:     ;
02:00047954 41EC04BF        	  3221:     lea     ($04BF,A4),A0
02:00047958 10302000        	  3222:     move.b  (A0,D2.W),D0
02:0004795C 02000004        	  3223:     andi.b #$04,D0
