                            	  5304: __far_z_07_0077:
                            	  5305:     ; State $2x. Spark.
                            	  5306:     ;
                            	  5307:     ; Change the state to $28, and decrement animation counter.
                            	  5308:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5309:     ; (with Link, if this is a monster's boomerang).
                            	  5310:     ;
                            	  5311:     ; TODO: Why state $28?
                            	  5312:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5313:     ; start over again when spinning.
                            	  5314:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5315:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5316:     ; any drawing code depends on the minor state.
                            	  5317:     ;
02:000486D0 7028            	  5318:     moveq   #40,D0
02:000486D2 41EC00AC        	  5319:     lea     ($00AC,A4),A0
02:000486D6 11802000        	  5320:     move.b  D0,(A0,D2.W)
02:000486DA 41EC03D0        	  5321:     lea     ($03D0,A4),A0
02:000486DE 53302000        	  5322:     subq.b  #1,(A0,D2.W)
02:000486E2 6702            	  5323:     beq.s  __far_z_07_0078
02:000486E4 6060            	  5324:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5325: __far_z_07_0078:
                            	  5326:     ; Animation counter = 0.
                            	  5327:     ;
                            	  5328:     ; Set state to $40. It will become $50 below in
                            	  5329:     ; HandleArrowOrBoomerangBlocked.
                            	  5330:     ;
02:000486E6 7040            	  5331:     moveq   #64,D0
02:000486E8 41EC00AC        	  5332:     lea     ($00AC,A4),A0
02:000486EC 11802000        	  5333:     move.b  D0,(A0,D2.W)
                            	  5334:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5335:     ; Else go handle the boomerang being blocked.
                            	  5336:     ;
02:000486F0 0C02000D        	  5337:     cmpi.b  #$0D,D2
02:000486F4 640E            	  5338:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:000486F6 41EC034F        	  5339:     lea     ($034F,A4),A0
