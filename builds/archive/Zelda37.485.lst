02:0002AD44 2001            	  2291:     move.l  D1,D0
02:0002AD46 E088            	  2292:     lsr.l   #8,D0
02:0002AD48 024000FF        	  2293:     andi.w  #$00FF,D0
02:0002AD4C 00409600        	  2294:     ori.w   #$9600,D0
02:0002AD50 33C000C00004    	  2295:     move.w  D0,(VDP_CTRL).l
                            	  2296:     ; Reg 23 = source[22:16] with bit 7 clear (68k→VRAM mode)
02:0002AD56 2001            	  2297:     move.l  D1,D0
02:0002AD58 E088            	  2298:     lsr.l   #8,D0
02:0002AD5A E088            	  2299:     lsr.l   #8,D0
02:0002AD5C 0240007F        	  2300:     andi.w  #$007F,D0
02:0002AD60 00409700        	  2301:     ori.w   #$9700,D0
