                            	  7843: _L_z04_UpdatePolsVoice_State0:
                            	  7844:     ; State 0. Walking.
                            	  7845:     ;
                            	  7846:     ; If grid offset = 0, then no more distance to cover.
                            	  7847:     ; So, go change to state 1 -- jumping.
                            	  7848:     ;
02:0003CE8E 41EC0394        	  7849:     lea     ($0394,A4),A0
02:0003CE92 10302000        	  7850:     move.b  (A0,D2.W),D0
02:0003CE96 67000084        	  7851:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7852:     ; Decrement grid offset / distance remaining.
                            	  7853:     ;
02:0003CE9A 41EC0394        	  7854:     lea     ($0394,A4),A0
02:0003CE9E 53302000        	  7855:     subq.b  #1,(A0,D2.W)
                            	  7856:     ; Move vertically.
                            	  7857:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7858:     ;
