02:0003A43C 0200000F        	  1850:     andi.b #$0F,D0
02:0003A440 023C00EE        	  1851:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A444 6608            	  1852:     bne  _L_z04_Gel_MoveSplitting_Exit
