02:00044D92 162C0070        	  8318:     move.b  ($0070,A4),D3
02:00044D96 0C030020        	  8319:     cmpi.b  #$20,D3
02:00044D9A 6706            	  8320:     beq  _anon_z05_175
02:00044D9C 0C0300D0        	  8321:     cmpi.b  #$D0,D3
