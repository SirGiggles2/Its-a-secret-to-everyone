                            	  5142: _L_z07_SpreadShot_NextCorner:
                            	  5143:     ; Prepare to process the next corner.
                            	  5144:     ;
                            	  5145:     ; First, restore X offset [02] and Y offset [03].
                            	  5146:     ;
02:0004C19C 101D            	  5147:     move.b  (A5)+,D0  ; PLA
02:0004C19E 19400003        	  5148:     move.b  D0,($0003,A4)
02:0004C1A2 101D            	  5149:     move.b  (A5)+,D0  ; PLA
02:0004C1A4 19400002        	  5150:     move.b  D0,($0002,A4)
                            	  5151:     ; Take turns negating X offset or Y offset for the next round.
                            	  5152:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5153:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5154:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5155:     ; - Fourth turn: doesn't matter
                            	  5156:     ;
                            	  5157:     ;
                            	  5158:     ; Get the loop index.
02:0004C1A8 101D            	  5159:     move.b  (A5)+,D0  ; PLA
02:0004C1AA 1B00            	  5160:     move.b  D0,-(A5)  ; PHA
02:0004C1AC 7600            	  5161:     moveq   #0,D3
02:0004C1AE 1600            	  5162:     move.b  D0,D3
02:0004C1B0 0C030001        	  5163:     cmpi.b  #$01,D3
02:0004C1B4 6602            	  5164:     bne  _anon_z07_25
02:0004C1B6 7603            	  5165:     moveq   #3,D3
                            	  5166: _anon_z07_25:
02:0004C1B8 10343000        	  5167:     move.b  ($00,A4,D3.W),D0
02:0004C1BC 4600            	  5168:     eori.b #$FF,D0
02:0004C1BE 023C00EE        	  5169:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1C2 123C0001        	  5170:     move.b  #$01,D1
02:0004C1C6 D101            	  5171:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C1C8 19803000        	  5172:     move.b  D0,($00,A4,D3.W)
                            	  5173:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5174:     ;
02:0004C1CC 101D            	  5175:     move.b  (A5)+,D0  ; PLA
02:0004C1CE 7600            	  5176:     moveq   #0,D3
02:0004C1D0 1600            	  5177:     move.b  D0,D3
02:0004C1D2 5303            	  5178:     subq.b  #1,D3
02:0004C1D4 6A00FF18        	  5179:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5180:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5181:     ;
                            	  5182:     ; Decrease the base negative offset to get farther away from
                            	  5183:     ; the center point.
                            	  5184:     ;
02:0004C1D8 41EC0098        	  5185:     lea     ($0098,A4),A0
02:0004C1DC 53302000        	  5186:     subq.b  #1,(A0,D2.W)
                            	  5187:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5188:     ;
                            	  5189:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5190:     ;
02:0004C1E0 41EC0098        	  5191:     lea     ($0098,A4),A0
02:0004C1E4 10302000        	  5192:     move.b  (A0,D2.W),D0
02:0004C1E8 0C0000E8        	  5193:     cmpi.b  #$E8,D0
02:0004C1EC 6702            	  5194:     beq.s  __far_z_07_0078
02:0004C1EE 6004            	  5195:     jmp  L1F49F_Exit
                            	  5196: __far_z_07_0078:
02:0004C1F0 6000FED2        	  5197:     jmp     DeactivateLinkShot
                            	  5198: 
                            	  5199:     even
