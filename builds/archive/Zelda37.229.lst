02:0003B4B2 12342070        	  4290:     move.b  ($70,A4,D2.W),D1
02:0003B4B6 B001            	  4291:     cmp.b   D1,D0
02:0003B4B8 667C            	  4292:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  4293:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  4294:     ; is positive; then go use it along with a flag that indicates that
                            	  4295:     ; Link is "down" from the object.
                            	  4296:     ;
02:0003B4BA 7600            	  4297:     moveq   #0,D3
