02:00030D9E 122C0001        	  4543:     move.b  ($0001,A4),D1
02:00030DA2 B601            	  4544:     cmp.b   D1,D3
02:00030DA4 6412            	  4545:     bcc  _L_z01_GetOneDirectionAndDistanceToTarget_Subtract
02:00030DA6 19400002        	  4546:     move.b  D0,($0002,A4)
02:00030DAA 19430001        	  4547:     move.b  D3,($0001,A4)
02:00030DAE 122C000A        	  4548:     move.b  ($000A,A4),D1
