02:0004BB12 41EC0394        	  4159:     lea     ($0394,A4),A0
02:0004BB16 10302000        	  4160:     move.b  (A0,D2.W),D0
02:0004BB1A 6704            	  4161:     beq.s  __far_z_07_0049
02:0004BB1C 6000009E        	  4162:     jmp  L1F148_Exit
                            	  4163: __far_z_07_0049:
                            	  4164:     ; Grid offset = 0.
                            	  4165:     ; The object is at a point between cells in the grid.
                            	  4166:     ; So, we can check tiles for collision.
                            	  4167:     ;
                            	  4168:     ; Reset [0E] alternate direction search step.
                            	  4169:     ;
02:0004BB20 1940000E        	  4170:     move.b  D0,($000E,A4)
                            	  4171:     ; If there's a movement direction, go check tile collision.
                            	  4172:     ;
