02:0003C9E2 52302000        	  7134:     addq.b  #1,(A0,D2.W)
                            	  7135:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7136:     ;
02:0003C9E6 41EC042C        	  7137:     lea     ($042C,A4),A0
