02:0003ED2C 02000007        	 11898:     andi.b #$07,D0
02:0003ED30 6702            	 11899:     beq.s  __far_z_04_0123
02:0003ED32 60F2            	 11900:     jmp  L12A6F_Exit
                            	 11901: __far_z_04_0123:
                            	 11902:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11903:     ; We had to account for the usual offset of 3.
                            	 11904:     ;
02:0003ED34 41EC0084        	 11905:     lea     ($0084,A4),A0
02:0003ED38 10302000        	 11906:     move.b  (A0,D2.W),D0
02:0003ED3C 023C00EE        	 11907:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED40 123C0003        	 11908:     move.b  #$03,D1
02:0003ED44 D101            	 11909:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED46 02000007        	 11910:     andi.b #$07,D0
02:0003ED4A 6702            	 11911:     beq.s  __far_z_04_0124
02:0003ED4C 60D8            	 11912:     jmp  L12A6F_Exit
                            	 11913: __far_z_04_0124:
                            	 11914:     ; Will loop 4 times, propagating directions down the chain,
                            	 11915:     ; by pulling from the bottom.
                            	 11916:     ;
02:0003ED4E 7004            	 11917:     moveq   #4,D0
02:0003ED50 1880            	 11918:     move.b  D0,($0000,A4)
                            	 11919:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11920:     ;
02:0003ED52 7600            	 11921:     moveq   #0,D3
02:0003ED54 0C020005        	 11922:     cmpi.b  #$05,D2
02:0003ED58 6702            	 11923:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED5A 7605            	 11924:     moveq   #5,D3
                            	 11925:     even
                            	 11926: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11927:     ; Loop over every segment under the head, starting from the tail.
                            	 11928:     ; Copy the next segment's direction to the current one in this loop.
                            	 11929:     ;
02:0003ED5C 41EC009A        	 11930:     lea     ($009A,A4),A0
02:0003ED60 10303000        	 11931:     move.b  (A0,D3.W),D0
02:0003ED64 41EC0099        	 11932:     lea     ($0099,A4),A0
02:0003ED68 11803000        	 11933:     move.b  D0,(A0,D3.W)
02:0003ED6C 5203            	 11934:     addq.b  #1,D3
02:0003ED6E 5314            	 11935:     subq.b  #1,($0000,A4)
02:0003ED70 66EA            	 11936:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11937:     ; If this head segment is not aligned with a square, then return.
                            	 11938:     ;
02:0003ED72 10342070        	 11939:     move.b  ($70,A4,D2.W),D0
02:0003ED76 0200000F        	 11940:     andi.b #$0F,D0
02:0003ED7A 660000BA        	 11941:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11942:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11943:     ; We had to account for the usual offset of 3.
                            	 11944:     ;
02:0003ED7E 41EC0084        	 11945:     lea     ($0084,A4),A0
02:0003ED82 10302000        	 11946:     move.b  (A0,D2.W),D0
02:0003ED86 023C00EE        	 11947:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED8A 123C0003        	 11948:     move.b  #$03,D1
02:0003ED8E D101            	 11949:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED90 0200000F        	 11950:     andi.b #$0F,D0
02:0003ED94 660000A0        	 11951:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11952:     ; Store the opposite of the facing direction in [00].
                            	 11953:     ;
02:0003ED98 41EC0098        	 11954:     lea     ($0098,A4),A0
02:0003ED9C 10302000        	 11955:     move.b  (A0,D2.W),D0
02:0003EDA0 E208            	 11956:     lsr.b  #1,D0   ; LSR A
02:0003EDA2 02000005        	 11957:     andi.b #$05,D0
02:0003EDA6 1880            	 11958:     move.b  D0,($0000,A4)
02:0003EDA8 41EC0098        	 11959:     lea     ($0098,A4),A0
02:0003EDAC 10302000        	 11960:     move.b  (A0,D2.W),D0
02:0003EDB0 E308            	 11961:     lsl.b  #1,D0   ; ASL A
02:0003EDB2 0200000A        	 11962:     andi.b #$0A,D0
02:0003EDB6 1214            	 11963:     move.b  ($0000,A4),D1
02:0003EDB8 8001            	 11964:     or.b  D1,D0
                            	 11965:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11966:     ;
02:0003EDBA 0A00000F        	 11967:     eori.b #$0F,D0
02:0003EDBE 1940050F        	 11968:     move.b  D0,($050F,A4)
                            	 11969:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11970:     ;
02:0003EDC2 10342018        	 11971:     move.b  ($18,A4,D2.W),D0
02:0003EDC6 0C000080        	 11972:     cmpi.b  #$80,D0
02:0003EDCA 656C            	 11973:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11974:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11975:     ; Load the monster's facing direction.
                            	 11976:     ;
02:0003EDCC 41EC0098        	 11977:     lea     ($0098,A4),A0
02:0003EDD0 10302000        	 11978:     move.b  (A0,D2.W),D0
                            	 11979:     ; Load the next random number into Y register.
                            	 11980:     ;
02:0003EDD4 7600            	 11981:     moveq   #0,D3
02:0003EDD6 16342019        	 11982:     move.b  ($19,A4,D2.W),D3
                            	 11983:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11984:     ; to keep moving straight.
                            	 11985:     ;
02:0003EDDA 0C030080        	 11986:     cmpi.b  #$80,D3
02:0003EDDE 6418            	 11987:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11988:     even
                            	 11989: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11990:     ; Loop to rotate the direction bit over the mask.
                            	 11991:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11992:     ; facing direction.
                            	 11993:     ;
                            	 11994:     ; Shift right the copy of the direction.
                            	 11995:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11996:     ;
02:0003EDE0 E208            	 11997:     lsr.b  #1,D0   ; LSR A
02:0003EDE2 6402            	 11998:     bcc  _anon_z04_151
02:0003EDE4 7008            	 11999:     moveq   #8,D0
                            	 12000: _anon_z04_151:
                            	 12001:     ; If the current direction bit is masked off, then we've reached
                            	 12002:     ; the opposite direction. Loop again.
                            	 12003:     ;
02:0003EDE6 122C050F        	 12004:     move.b  ($050F,A4),D1
02:0003EDEA C200            	 12005:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDEC 67F2            	 12006:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12007:     ; If Y register >= $40, then break out of the loop.
                            	 12008:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12009:     ;
02:0003EDEE 0C030040        	 12010:     cmpi.b  #$40,D3
02:0003EDF2 6404            	 12011:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12012:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12013:     ; and loop again now.
                            	 12014:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12015:     ;
02:0003EDF4 7640            	 12016:     moveq   #64,D3
02:0003EDF6 65E8            	 12017:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12018:     even
                            	 12019: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12020:     ; Change the facing direction to the direction found.
                            	 12021:     ;
02:0003EDF8 41EC0098        	 12022:     lea     ($0098,A4),A0
02:0003EDFC 11802000        	 12023:     move.b  D0,(A0,D2.W)
                            	 12024:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12025:     ;
02:0003EE00 1940000F        	 12026:     move.b  D0,($000F,A4)
02:0003EE04 4EB900030B6C    	 12027:     jsr     BoundByRoom
                            	 12028:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12029:     ;
02:0003EE0A 102C000F        	 12030:     move.b  ($000F,A4),D0
02:0003EE0E 6618            	 12031:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12032:     even
                            	 12033: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12034:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12035:     ; for looking for any non-opposite direction that is not blocked.
                            	 12036:     ;
02:0003EE10 41EC0098        	 12037:     lea     ($0098,A4),A0
02:0003EE14 10302000        	 12038:     move.b  (A0,D2.W),D0
                            	 12039:     even
                            	 12040: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12041:     ; Shift right the copy of the direction.
                            	 12042:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12043:     ;
02:0003EE18 E208            	 12044:     lsr.b  #1,D0   ; LSR A
02:0003EE1A 6402            	 12045:     bcc  _anon_z04_152
02:0003EE1C 7008            	 12046:     moveq   #8,D0
                            	 12047: _anon_z04_152:
                            	 12048:     ; If the current direction bit is not masked off, then go check the
                            	 12049:     ; room boundary in this direction.
                            	 12050:     ; Else we've reached the opposite direction. Loop again.
                            	 12051:     ;
02:0003EE1E 122C050F        	 12052:     move.b  ($050F,A4),D1
02:0003EE22 C200            	 12053:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE24 66D2            	 12054:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE26 67F0            	 12055:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12056:     even
                            	 12057: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12058:     ; We found a direction that was not blocked by the room boundary.
                            	 12059:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12060:     ;
02:0003EE28 4EB90004B6F0    	 12061:     jsr     GetCollidingTileMoving
02:0003EE2E 122C034A        	 12062:     move.b  ($034A,A4),D1
02:0003EE32 B001            	 12063:     cmp.b   D1,D0
02:0003EE34 64DA            	 12064:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12065:     even
                            	 12066: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12067:     ; TODO: confirm this
                            	 12068:     ;
                            	 12069:     ; If there were a room that had lamnolas, and they could get
                            	 12070:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12071:     ; an infinite loop.
                            	 12072:     ;
                            	 12073:     ; But, the only room with that configuration has those blocks
                            	 12074:     ; blocked off with a push block, which can only be pushed after
                            	 12075:     ; all monsters are killed.
                            	 12076:     ;
02:0003EE36 4E75            	 12077:     rts
                            	 12078: 
                            	 12079:     even
                            	 12080: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12081:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12082:     ;
02:0003EE38 7001            	 12083:     moveq   #1,D0
02:0003EE3A 19400002        	 12084:     move.b  D0,($0002,A4)
02:0003EE3E 102C0070        	 12085:     move.b  ($0070,A4),D0
02:0003EE42 003C0011        	 12086:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE46 12342070        	 12087:     move.b  ($70,A4,D2.W),D1
02:0003EE4A 0A3C0010        	 12088:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE4E 9101            	 12089:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EE50 0A3C0010        	 12090:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE54 640A            	 12091:     bcc  _anon_z04_153
02:0003EE56 122C0002        	 12092:     move.b  ($0002,A4),D1
02:0003EE5A E309            	 12093:     lsl.b  #1,D1   ; ASL $02
02:0003EE5C 19410002        	 12094:     move.b  D1,($0002,A4)
                            	 12095: _anon_z04_153:
                            	 12096:     ; Find the vertical direction toward Link and store it in [03].
                            	 12097:     ;
02:0003EE60 7004            	 12098:     moveq   #4,D0
02:0003EE62 19400003        	 12099:     move.b  D0,($0003,A4)
02:0003EE66 102C0084        	 12100:     move.b  ($0084,A4),D0
02:0003EE6A 003C0011        	 12101:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE6E 41EC0084        	 12102:     lea     ($0084,A4),A0
02:0003EE72 12302000        	 12103:     move.b  (A0,D2.W),D1
02:0003EE76 0A3C0010        	 12104:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE7A 9101            	 12105:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EE7C 0A3C0010        	 12106:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE80 640A            	 12107:     bcc  _anon_z04_154
02:0003EE82 122C0003        	 12108:     move.b  ($0003,A4),D1
02:0003EE86 E309            	 12109:     lsl.b  #1,D1   ; ASL $03
02:0003EE88 19410003        	 12110:     move.b  D1,($0003,A4)
                            	 12111: _anon_z04_154:
                            	 12112:     ; If the horizontal direction toward Link is not allowed, then
                            	 12113:     ; go check the vertical direction.
                            	 12114:     ;
02:0003EE8C 102C0002        	 12115:     move.b  ($0002,A4),D0
02:0003EE90 122C050F        	 12116:     move.b  ($050F,A4),D1
02:0003EE94 C200            	 12117:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE96 6708            	 12118:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12119:     ; If the horizontal direction toward Link is the same direction
                            	 12120:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12121:     ;
02:0003EE98 122C0098        	 12122:     move.b  ($0098,A4),D1
02:0003EE9C C200            	 12123:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE9E 6604            	 12124:     bne  _anon_z04_155
                            	 12125:     even
                            	 12126: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12127:     ; Load the vertical direction toward Link in order to test it for
                            	 12128:     ; room boundary and tile collision.
                            	 12129:     ;
02:0003EEA0 102C0003        	 12130:     move.b  ($0003,A4),D0
                            	 12131: _anon_z04_155:
                            	 12132:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12133:     ;
02:0003EEA4 6000FF52        	 12134:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12135: 
                            	 12136:     even
                            	 12137: Lamnola_Move:
                            	 12138:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12139:     ;
                            	 12140:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12141:     ;
                            	 12142:     ; Start with a mask of $A1 in [02]:
                            	 12143:     ; - low nibble represents the right direction
                            	 12144:     ; - high nibble is used to set or clear carry as we go along
                            	 12145:     ;
02:0003EEA8 103C00A1        	 12146:     move.b  #$A1,D0
02:0003EEAC 19400002        	 12147:     move.b  D0,($0002,A4)
                            	 12148:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12149:     ;
02:0003EEB0 41EC0098        	 12150:     lea     ($0098,A4),A0
02:0003EEB4 10302000        	 12151:     move.b  (A0,D2.W),D0
02:0003EEB8 122C0002        	 12152:     move.b  ($0002,A4),D1
02:0003EEBC C200            	 12153:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEBE 6712            	 12154:     beq  _L_z04_Lamnola_Move_Left
02:0003EEC0 10342070        	 12155:     move.b  ($70,A4,D2.W),D0
02:0003EEC4 023C00EE        	 12156:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEC8 122C04E6        	 12157:     move.b  ($04E6,A4),D1
02:0003EECC D101            	 12158:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EECE 19802070        	 12159:     move.b  D0,($70,A4,D2.W)
                            	 12160:     even
                            	 12161: _L_z04_Lamnola_Move_Left:
                            	 12162:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 12163:     ;
02:0003EED2 41EC0098        	 12164:     lea     ($0098,A4),A0
02:0003EED6 10302000        	 12165:     move.b  (A0,D2.W),D0
02:0003EEDA 122C0002        	 12166:     move.b  ($0002,A4),D1
02:0003EEDE E309            	 12167:     lsl.b  #1,D1   ; ASL $02
02:0003EEE0 19410002        	 12168:     move.b  D1,($0002,A4)
02:0003EEE4 122C0002        	 12169:     move.b  ($0002,A4),D1
02:0003EEE8 C200            	 12170:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEEA 6716            	 12171:     beq  _L_z04_Lamnola_Move_Down
02:0003EEEC 10342070        	 12172:     move.b  ($70,A4,D2.W),D0
02:0003EEF0 122C04E6        	 12173:     move.b  ($04E6,A4),D1
02:0003EEF4 0A3C0010        	 12174:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEF8 9101            	 12175:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EEFA 0A3C0010        	 12176:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEFE 19802070        	 12177:     move.b  D0,($70,A4,D2.W)
                            	 12178:     even
