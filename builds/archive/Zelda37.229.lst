                            	  5676: 
                            	  5677: ; Params:
                            	  5678: ; [02]: Y
                            	  5679: ; [03]: X
                            	  5680: ;
                            	  5681: ; Returns:
                            	  5682: ; [00]: high byte of PPU address
                            	  5683: ; [01]: low byte of PPU address
                            	  5684: ;
                            	  5685: ;
                            	  5686: ; Turn the 16-bit value 08YY into the PPU address
                            	  5687: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5688: ;
                            	  5689: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5690: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5691: ;
                            	  5692:     even
