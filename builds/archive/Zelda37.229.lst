                            	  9632: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9633:     ; At this point, we have a hand that just died.
                            	  9634:     ;
                            	  9635:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9636:     ;
02:0003DC38 7603            	  9637:     moveq   #3,D3
                            	  9638:     ; Count how many are allocated.
