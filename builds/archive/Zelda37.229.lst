                            	  5633:     ;
                            	  5634:     ; [06] indicates whether we're handling the first half of
                            	  5635:     ; the door: Left half for N/S, Top half for E/W.
                            	  5636:     ;
02:00043612 19400006        	  5637:     move.b  D0,($0006,A4)
                            	  5638:     even
                            	  5639: L_LayOutDoors_LoopHalves:
02:00043616 1002            	  5640:     move.b  D2,D0
02:00043618 1B00            	  5641:     move.b  D0,-(A5)  ; PHA
02:0004361A 1940000B        	  5642:     move.b  D0,($000B,A4)
02:0004361E 41F9000435EA    	  5643:     lea     (DoorBits).l,A0
02:00043624 10302000        	  5644:     move.b  (A0,D2.W),D0
02:00043628 19400002        	  5645:     move.b  D0,($0002,A4)
02:0004362C 6100FD4A        	  5646:     jsr     FindDoorAttrByDoorBit
                            	  5647:     ; Begin looking for the door face for the door attribute.
                            	  5648:     ; In general, use the door type as the provisional face;
                            	  5649:     ; except turn 4 into 8.
                            	  5650:     ;
02:00043630 0C000005        	  5651:     cmpi.b  #$05,D0
02:00043634 642A            	  5652:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043636 0C000004        	  5653:     cmpi.b  #$04,D0
02:0004363A 6608            	  5654:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0004363C 7008            	  5655:     moveq   #8,D0
02:0004363E 6620            	  5656:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5657:     even
                            	  5658: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5659:     ; We jump here if the door type is bombable and was opened.
                            	  5660:     ; Change the provisional door face to value 9, which
                            	  5661:     ; will become the "hole in the wall".
                            	  5662:     ;
02:00043640 7009            	  5663:     moveq   #9,D0
02:00043642 665A            	  5664:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5665:     even
                            	  5666: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5667:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5668:     ; the mask of opened doors, because this is not a true door.
                            	  5669:     ;
02:00043644 1B00            	  5670:     move.b  D0,-(A5)  ; PHA
02:00043646 102C0002        	  5671:     move.b  ($0002,A4),D0
02:0004364A 4600            	  5672:     eori.b #$FF,D0
02:0004364C 122C00EE        	  5673:     move.b  ($00EE,A4),D1
02:00043650 C001            	  5674:     and.b  D1,D0
02:00043652 194000EE        	  5675:     move.b  D0,($00EE,A4)
02:00043656 101D            	  5676:     move.b  (A5)+,D0  ; PLA
                            	  5677:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5678:     ;
02:00043658 0C000001        	  5679:     cmpi.b  #$01,D0
02:0004365C 6402            	  5680:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004365E 7004            	  5681:     moveq   #4,D0
                            	  5682:     even
                            	  5683: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5684:     ; The door attribute (DA) has been mapped to a
                            	  5685:     ; provisional door face value (PF) in %A as follows:
                            	  5686:     ;
                            	  5687:     ; DA PF Meaning
                            	  5688:     ; -------------
                            	  5689:     ; 0  4  open
                            	  5690:     ; 1  1  wall
                            	  5691:     ; 2  2  false wall
                            	  5692:     ; 3  3  false wall 2
                            	  5693:     ; 4  8  bombable
                            	  5694:     ; 5  5  key
                            	  5695:     ; 6  6  key 2
                            	  5696:     ; 7  7  shutter
                            	  5697:     ;
                            	  5698:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5699:     ; has been cleared, if the type was "open" or any wall.
                            	  5700:     ;
                            	  5701:     ;
                            	  5702:     ; Save the provisional face.
02:00043660 1B00            	  5703:     move.b  D0,-(A5)  ; PHA
                            	  5704:     ; If the current direction points to a door that has been opened,
                            	  5705:     ; then see if we need to set door flags.
                            	  5706:     ;
02:00043662 102C00EE        	  5707:     move.b  ($00EE,A4),D0
02:00043666 122C0002        	  5708:     move.b  ($0002,A4),D1
02:0004366A C001            	  5709:     and.b  D1,D0
02:0004366C 7400            	  5710:     moveq   #0,D2
02:0004366E 1400            	  5711:     move.b  D0,D2
02:00043670 101D            	  5712:     move.b  (A5)+,D0  ; PLA
02:00043672 122C0002        	  5713:     move.b  ($0002,A4),D1
02:00043676 B401            	  5714:     cmp.b   D1,D2
02:00043678 6624            	  5715:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5716:     ; The current direction points to a door that has been opened.
                            	  5717:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5718:     ;
                            	  5719:     ;
                            	  5720:     ; Save provisional door face in Y register.
02:0004367A 7600            	  5721:     moveq   #0,D3
02:0004367C 1600            	  5722:     move.b  D0,D3
02:0004367E 101D            	  5723:     move.b  (A5)+,D0  ; PLA
02:00043680 1B00            	  5724:     move.b  D0,-(A5)  ; PHA
02:00043682 7400            	  5725:     moveq   #0,D2
02:00043684 1400            	  5726:     move.b  D0,D2
02:00043686 1003            	  5727:     move.b  D3,D0
                            	  5728:     ; If provisional door face is not for a shutter, then
                            	  5729:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5730:     ;
                            	  5731:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5732:     ;
02:00043688 0C000007        	  5733:     cmpi.b  #$07,D0
02:0004368C 670E            	  5734:     beq  _anon_z05_111
02:0004368E 1B00            	  5735:     move.b  D0,-(A5)  ; PHA
02:00043690 6100DDFE        	  5736:     jsr     SetDoorFlag
02:00043694 101D            	  5737:     move.b  (A5)+,D0  ; PLA
                            	  5738:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5739:     ; then go make it 9 (open "bombable").
                            	  5740:     ; Else make it 4 (open "door").
                            	  5741:     ;
02:00043696 0C000008        	  5742:     cmpi.b  #$08,D0
02:0004369A 67A4            	  5743:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5744: _anon_z05_111:
02:0004369C 7004            	  5745:     moveq   #4,D0
                            	  5746:     even
                            	  5747: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5748:     ; For opened doors, the provisional door face has become:
                            	  5749:     ;
                            	  5750:     ; DA PF Meaning
                            	  5751:     ; -------------
                            	  5752:     ; 0  4  open
                            	  5753:     ; 1  1  wall
                            	  5754:     ; 2  2  false wall
                            	  5755:     ; 3  3  false wall 2
                            	  5756:     ; 4  9  bombable
                            	  5757:     ; 5  4  key
                            	  5758:     ; 6  4  key 2
                            	  5759:     ; 7  4  shutter
                            	  5760:     ;
                            	  5761:     ;
                            	  5762:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5763:     ;
02:0004369E 7400            	  5764:     moveq   #0,D2
02:000436A0 142C0006        	  5765:     move.b  ($0006,A4),D2
02:000436A4 6712            	  5766:     beq  _anon_z05_112
02:000436A6 7400            	  5767:     moveq   #0,D2
02:000436A8 142C000B        	  5768:     move.b  ($000B,A4),D2
02:000436AC 1B00            	  5769:     move.b  D0,-(A5)  ; PHA
02:000436AE 6100FCC8        	  5770:     jsr     FindDoorAttrByDoorBit
02:000436B2 61001CB4        	  5771:     jsr     CalcOpenDoorwayMask
02:000436B6 101D            	  5772:     move.b  (A5)+,D0  ; PLA
                            	  5773: _anon_z05_112:
                            	  5774:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5775:     ; because the visible door face is already a wall.
                            	  5776:     ;
02:000436B8 0C000004        	  5777:     cmpi.b  #$04,D0
02:000436BC 650000DC        	  5778:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5779:     ; For all other provisional face values, calculate:
                            	  5780:     ; door face := provisional face - 3
02:000436C0 003C0011        	  5781:     ori     #$11,CCR  ; SEC: set C+X
02:000436C4 123C0003        	  5782:     move.b  #$03,D1
02:000436C8 0A3C0010        	  5783:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000436CC 9101            	  5784:     subx.b  D1,D0   ; SBC #$03
02:000436CE 0A3C0010        	  5785:     eori    #$10,CCR  ; restore X = 6502 C
02:000436D2 7600            	  5786:     moveq   #0,D3
02:000436D4 1600            	  5787:     move.b  D0,D3
                            	  5788:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5789:     ; subtract one.
                            	  5790:     ;
02:000436D6 0C030003        	  5791:     cmpi.b  #$03,D3
02:000436DA 6502            	  5792:     bcs  _anon_z05_113
02:000436DC 5303            	  5793:     subq.b  #1,D3
                            	  5794: _anon_z05_113:
                            	  5795:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5796:     ;
                            	  5797:     ; DT DFC DFO Meaning
                            	  5798:     ; ------------------
                            	  5799:     ; 0  1   1   open
                            	  5800:     ; 4  4   5   bombable
                            	  5801:     ; 5  2   1   key
                            	  5802:     ; 6  2   1   key 2
                            	  5803:     ; 7  3   1   shutter
                            	  5804:     ;
                            	  5805:     ;
                            	  5806:     ; Get the direction index.
02:000436DE 101D            	  5807:     move.b  (A5)+,D0  ; PLA
02:000436E0 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:000436E2 610000D0        	  5809:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5810:     ; If handling the second half, then offset to the second half
                            	  5811:     ; of the tiles.
                            	  5812:     ;
02:000436E6 102C0006        	  5813:     move.b  ($0006,A4),D0
02:000436EA 6618            	  5814:     bne  _anon_z05_114
02:000436EC 41F900043602    	  5815:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000436F2 10302000        	  5816:     move.b  (A0,D2.W),D0
02:000436F6 4EB9000310BC    	  5817:     jsr     AddToInt16At0
02:000436FC 7006            	  5818:     moveq   #6,D0
02:000436FE 4EB9000310C4    	  5819:     jsr     AddToInt16At2
                            	  5820: _anon_z05_114:
                            	  5821:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5822:     ; Pointers will be incremented instead of Y.
02:00043704 7600            	  5823:     moveq   #0,D3
02:00043706 41F900043606    	  5824:     lea     (DirIndexToDoorColumnCount).l,A0
02:0004370C 10302000        	  5825:     move.b  (A0,D2.W),D0
02:00043710 19400005        	  5826:     move.b  D0,($0005,A4)
                            	  5827:     even
                            	  5828: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5829:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5830:     ;
02:00043714 101D            	  5831:     move.b  (A5)+,D0  ; PLA
02:00043716 1B00            	  5832:     move.b  D0,-(A5)  ; PHA
02:00043718 7400            	  5833:     moveq   #0,D2
02:0004371A 1400            	  5834:     move.b  D0,D2
                            	  5835:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5836:     ; starting from highest index down to 0:
                            	  5837:     ;
02:0004371C 41F90004360A    	  5838:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043722 10302000        	  5839:     move.b  (A0,D2.W),D0
02:00043726 7400            	  5840:     moveq   #0,D2
02:00043728 1400            	  5841:     move.b  D0,D2
                            	  5842:     even
                            	  5843: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:0004372A 122C0002        	  5844:     move.b  ($02,A4),D1   ; ptr lo
02:0004372E 182C0003        	  5845:     move.b  ($03,A4),D4  ; ptr hi
02:00043732 024100FF        	  5846:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043736 E14C            	  5847:     lsl.w   #8,D4
02:00043738 8841            	  5848:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004373A 48C4            	  5849:     ext.l   D4
02:0004373C D8BC00FF0000    	  5850:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043742 2044            	  5851:     movea.l D4,A0
02:00043744 10303000        	  5852:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043748 1214            	  5853:     move.b  ($00,A4),D1   ; ptr lo
02:0004374A 182C0001        	  5854:     move.b  ($01,A4),D4  ; ptr hi
02:0004374E 024100FF        	  5855:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043752 E14C            	  5856:     lsl.w   #8,D4
02:00043754 8841            	  5857:     or.w    D1,D4
02:00043756 48C4            	  5858:     ext.l   D4
02:00043758 D8BC00FF0000    	  5859:     add.l   #NES_RAM,D4
02:0004375E 2044            	  5860:     movea.l D4,A0
02:00043760 11803000        	  5861:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00043764 4EB9000310C0    	  5862:     jsr     Add1ToInt16At2
02:0004376A 41F9000435FE    	  5863:     lea     (NextDoorTileOffsets).l,A0
02:00043770 10302000        	  5864:     move.b  (A0,D2.W),D0
02:00043774 4EB9000310BC    	  5865:     jsr     AddToInt16At0
                            	  5866:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5867:     ; go 1 more tile down, to start the next column at the right place.
                            	  5868:     ; We have to compensate for the fact that E/W doors are 
                            	  5869:     ; shorter vertically than N/S doors.
02:0004377A 4A02            	  5870:     cmpi.b  #$00,D2
02:0004377C 6610            	  5871:     bne  _anon_z05_115
02:0004377E 101D            	  5872:     move.b  (A5)+,D0  ; PLA
02:00043780 1B00            	  5873:     move.b  D0,-(A5)  ; PHA
02:00043782 0C000002        	  5874:     cmpi.b  #$02,D0
02:00043786 6406            	  5875:     bcc  _anon_z05_115
02:00043788 4EB9000310BA    	  5876:     jsr     Add1ToInt16At0
