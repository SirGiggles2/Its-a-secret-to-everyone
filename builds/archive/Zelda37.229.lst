                            	  8013: Submenu_CueTransferRowUW:
                            	  8014:     ; If menu scroll value is negative, then we transferred everything.
                            	  8015:     ; So, return.
                            	  8016:     ;
02:00044C0E 102C005E        	  8017:     move.b  ($005E,A4),D0
02:00044C12 6A02            	  8018:     bpl.s  __far_z_05_0107
02:00044C14 602E            	  8019:     jmp  L1725A_Exit
                            	  8020: __far_z_05_0107:
                            	  8021:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8022:     ; and represents the current row of the submenu being processed.
                            	  8023:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8024:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8025:     ;
                            	  8026:     ; If the bottom bit is set, go prepare the full black row.
                            	  8027:     ;
02:00044C16 E208            	  8028:     lsr.b  #1,D0   ; LSR A
02:00044C18 7600            	  8029:     moveq   #0,D3
02:00044C1A 1600            	  8030:     move.b  D0,D3
02:00044C1C 6402            	  8031:     bcc.s  __far_z_05_0108
02:00044C1E 6026            	  8032:     jmp  PrepFullBlackRow
                            	  8033: __far_z_05_0108:
                            	  8034:     ; Submenu rows $D to $15 are parts of the map.
                            	  8035:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8036:     ;
                            	  8037:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8038:     ; buffer for this row.
                            	  8039:     ;
02:00044C20 0C00000D        	  8040:     cmpi.b  #$0D,D0
02:00044C24 640C            	  8041:     bcc  _anon_z05_167
02:00044C26 41F900044BEA    	  8042:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044C2C 10303000        	  8043:     move.b  (A0,D3.W),D0
                            	  8044:     even
                            	  8045: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044C30 606E            	  8046:     jmp     SelectTransferBufAndDecCounter
                            	  8047: 
                            	  8048: _anon_z05_167:
                            	  8049:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  8050:     ; of the big map sheet.
                            	  8051:     ;
02:00044C32 0C000015        	  8052:     cmpi.b  #$15,D0
02:00044C36 6604            	  8053:     bne  _anon_z05_168
02:00044C38 7042            	  8054:     moveq   #66,D0
02:00044C3A 60F4            	  8055:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8056: 
                            	  8057: _anon_z05_168:
                            	  8058:     ; Else row is between $D and $14. Prepare a map row.
                            	  8059:     ;
02:00044C3C 610005B8        	  8060:     jsr     Submenu_WriteSheetMapRowTransferRecord
                            	  8061:     even
                            	  8062: DecSubmenuScroll:
                            	  8063:     ; Decrease the counter for the next frame.
                            	  8064:     ;
02:00044C40 532C005E        	  8065:     subq.b  #1,($005E,A4)
                            	  8066:     even
