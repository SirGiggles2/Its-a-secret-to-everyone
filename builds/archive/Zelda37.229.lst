02:0003C99E 41F90003C8CA    	  7102:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C9A4 10303000        	  7103:     move.b  (A0,D3.W),D0
02:0003C9A8 41EC045E        	  7104:     lea     ($045E,A4),A0
