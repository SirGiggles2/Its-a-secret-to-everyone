02:0003DDD6 0200000F        	  9860:     andi.b #$0F,D0
02:0003DDDA 0C000002        	  9861:     cmpi.b  #$02,D0
02:0003DDDE 670C            	  9862:     beq  _anon_z04_117
02:0003DDE0 0C000003        	  9863:     cmpi.b  #$03,D0
02:0003DDE4 6706            	  9864:     beq  _anon_z04_117
02:0003DDE6 4EF9000317B6    	  9865:     jmp     DrawObjectMirrored
