                            	  5183:     even
                            	  5184: _L_z02_DrawCredits_TerminateRecords:
                            	  5185:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5186:     ; attributes or only tiles.
                            	  5187:     ;
02:00036950 103C00FF        	  5188:     move.b  #$FF,D0
02:00036954 19400325        	  5189:     move.b  D0,($0325,A4)
02:00036958 19400330        	  5190:     move.b  D0,($0330,A4)
                            	  5191:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5192:     ;
02:0003695C 7020            	  5193:     moveq   #32,D0
02:0003695E 19400304        	  5194:     move.b  D0,($0304,A4)
                            	  5195:     ; Write the high byte of the current VRAM page.
                            	  5196:     ;
02:00036962 7400            	  5197:     moveq   #0,D2
02:00036964 142C050C        	  5198:     move.b  ($050C,A4),D2
02:00036968 41F90003670E    	  5199:     lea     (CreditLineVramAddrsHi).l,A0
02:0003696E 10302000        	  5200:     move.b  (A0,D2.W),D0
02:00036972 19400302        	  5201:     move.b  D0,($0302,A4)
                            	  5202:     ; The line number will be used to shift the task mask below.
                            	  5203:     ;
02:00036976 102C050D        	  5204:     move.b  ($050D,A4),D0
02:0003697A 7600            	  5205:     moveq   #0,D3
02:0003697C 1600            	  5206:     move.b  D0,D3
                            	  5207:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5208:     ;
02:0003697E E308            	  5209:     lsl.b  #1,D0   ; ASL A
02:00036980 E308            	  5210:     lsl.b  #1,D0   ; ASL A
