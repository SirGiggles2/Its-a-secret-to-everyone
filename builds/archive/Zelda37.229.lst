02:0003B030 7020            	  3573:     moveq   #32,D0
02:0003B032 7600            	  3574:     moveq   #0,D3
02:0003B034 41EC034F        	  3575:     lea     ($034F,A4),A0
02:0003B038 16302000        	  3576:     move.b  (A0,D2.W),D3
02:0003B03C 0C030007        	  3577:     cmpi.b  #$07,D3
02:0003B040 6708            	  3578:     beq  _L_z04_UpdateOctorock_Shoot
02:0003B042 0C030009        	  3579:     cmpi.b  #$09,D3
02:0003B046 6702            	  3580:     beq  _L_z04_UpdateOctorock_Shoot
02:0003B048 E308            	  3581:     lsl.b  #1,D0   ; ASL A
                            	  3582:     even
                            	  3583: _L_z04_UpdateOctorock_Shoot:
                            	  3584:     ; Shoot a flying rock (object type $53).
                            	  3585:     ;
02:0003B04A 7653            	  3586:     moveq   #83,D3
