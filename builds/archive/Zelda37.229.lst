02:0003241A 41EC04F0        	  7694:     lea     ($04F0,A4),A0
02:0003241E 10302000        	  7695:     move.b  (A0,D2.W),D0
02:00032422 6656            	  7696:     bne  _L_z01_BeginShove_Exit2
                            	  7697:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7698:     ;
02:00032424 41EC034F        	  7699:     lea     ($034F,A4),A0
02:00032428 10302000        	  7700:     move.b  (A0,D2.W),D0
02:0003242C 0C000033        	  7701:     cmpi.b  #$33,D0
02:00032430 6706            	  7702:     beq  _L_z01_BeginShove_Gohma
02:00032432 0C000034        	  7703:     cmpi.b  #$34,D0
02:00032436 661E            	  7704:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7705:     even
                            	  7706: _L_z01_BeginShove_Gohma:
                            	  7707:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7708:     ; then return, so that the hit doesn't register.
                            	  7709:     ;
02:00032438 102C000F        	  7710:     move.b  ($000F,A4),D0
02:0003243C 0C000003        	  7711:     cmpi.b  #$03,D0
02:00032440 6706            	  7712:     beq  _anon_z01_103
02:00032442 0C000004        	  7713:     cmpi.b  #$04,D0
02:00032446 6632            	  7714:     bne  _L_z01_BeginShove_Exit2
                            	  7715: _anon_z01_103:
                            	  7716:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7717:     ;
02:00032448 41EC046B        	  7718:     lea     ($046B,A4),A0
02:0003244C 10302000        	  7719:     move.b  (A0,D2.W),D0
02:00032450 0C000003        	  7720:     cmpi.b  #$03,D0
02:00032454 6624            	  7721:     bne  _L_z01_BeginShove_Exit2
                            	  7722:     even
                            	  7723: _L_z01_BeginShove_SetShoveDir:
                            	  7724:     ; Store the shove direction for the monster.
