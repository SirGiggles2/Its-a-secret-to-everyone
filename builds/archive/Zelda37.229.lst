02:000303C6 660000B2        	  3034:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  3035:     ; State 0. Sensing.
                            	  3036:     ;
                            	  3037:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  3038:     ; then go see if the horizontal distance is shorter.
