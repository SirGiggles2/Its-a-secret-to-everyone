02:0003CEAA 023C00EE        	  7861:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEAE 41F90003CE3E    	  7862:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CEB4 12303000        	  7863:     move.b  (A0,D3.W),D1
02:0003CEB8 D101            	  7864:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CEBA 41EC0084        	  7865:     lea     ($0084,A4),A0
02:0003CEBE 11802000        	  7866:     move.b  D0,(A0,D2.W)
                            	  7867:     even
                            	  7868: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7869:     ; If the square the monster is over is walkable, then
                            	  7870:     ; go draw and check object collisions.
