                            	  5003: UpdateMode13WinGame_Sub3:
                            	  5004:     ; After scrolling 8 pixels, draw another tile row.
                            	  5005:     ;
02:0003666A 102C050B        	  5006:     move.b  ($050B,A4),D0
02:0003666E 0C000008        	  5007:     cmpi.b  #$08,D0
02:00036672 6B1A            	  5008:     bmi  _anon_z02_37
02:00036674 102C050B        	  5009:     move.b  ($050B,A4),D0
02:00036678 123C0008        	  5010:     move.b  #$08,D1
02:0003667C 0A3C0010        	  5011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036680 9101            	  5012:     subx.b  D1,D0   ; SBC #$08
02:00036682 0A3C0010        	  5013:     eori    #$10,CCR  ; restore X = 6502 C
02:00036686 1940050B        	  5014:     move.b  D0,($050B,A4)
02:0003668A 61000282        	  5015:     jsr     DrawCredits
                            	  5016: _anon_z02_37:
                            	  5017:     ; Add $80 to the scroll speed fraction.
                            	  5018:     ;
02:0003668E 102C0058        	  5019:     move.b  ($0058,A4),D0
02:00036692 023C00EE        	  5020:     andi    #$EE,CCR  ; CLC: clear C+X
02:00036696 123C0080        	  5021:     move.b  #$80,D1
02:0003669A D101            	  5022:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003669C 19400058        	  5023:     move.b  D0,($0058,A4)
                            	  5024:     ; Carry over to the tile offset and current V-scroll.
                            	  5025:     ;
02:000366A0 6404            	  5026:     bcc  _anon_z02_38
02:000366A2 522C050B        	  5027:     addq.b  #1,($050B,A4)
                            	  5028: _anon_z02_38:
02:000366A6 102C00FC        	  5029:     move.b  ($00FC,A4),D0
02:000366AA 123C0000        	  5030:     move.b  #$00,D1
02:000366AE D101            	  5031:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000366B0 194000FC        	  5032:     move.b  D0,($00FC,A4)
                            	  5033:     ; If we've reached the bottom of a nametable, then
                            	  5034:     ; roll over current V-scroll to 0, and increase number of
                            	  5035:     ; screens scrolled.
                            	  5036:     ;
02:000366B4 0C0000F0        	  5037:     cmpi.b  #$F0,D0
02:000366B8 7000            	  5038:     moveq   #0,D0
02:000366BA 6508            	  5039:     bcs  _anon_z02_39
02:000366BC 194000FC        	  5040:     move.b  D0,($00FC,A4)
02:000366C0 522C00E2        	  5041:     addq.b  #1,($00E2,A4)
                            	  5042: _anon_z02_39:
                            	  5043:     ; Roll the carry from the comparison above into bit 0.
                            	  5044:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5045:     ;
02:000366C4 E310            	  5046:     roxl.b  #1,D0   ; ROL A
02:000366C6 1940005C        	  5047:     move.b  D0,($005C,A4)
                            	  5048:     ; Put the quest number in Y register.
                            	  5049:     ;
02:000366CA 7600            	  5050:     moveq   #0,D3
02:000366CC 7400            	  5051:     moveq   #0,D2
02:000366CE 142C0016        	  5052:     move.b  ($0016,A4),D2
02:000366D2 41EC062D        	  5053:     lea     ($062D,A4),A0
02:000366D6 10302000        	  5054:     move.b  (A0,D2.W),D0
02:000366DA 6702            	  5055:     beq  _anon_z02_40
02:000366DC 5203            	  5056:     addq.b  #1,D3
                            	  5057: _anon_z02_40:
                            	  5058:     ; If we're not showing the last screen, then return.
                            	  5059:     ;
02:000366DE 102C00E2        	  5060:     move.b  ($00E2,A4),D0
02:000366E2 41F900036666    	  5061:     lea     (CreditsLastScreenList).l,A0
02:000366E8 12303000        	  5062:     move.b  (A0,D3.W),D1
02:000366EC B001            	  5063:     cmp.b   D1,D0
02:000366EE 651C            	  5064:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  5065:     ; If we haven't scrolled the last amount in the last screen,
                            	  5066:     ; then return.
                            	  5067:     ;
02:000366F0 102C00FC        	  5068:     move.b  ($00FC,A4),D0
02:000366F4 41F900036668    	  5069:     lea     (CreditsLastVscrollList).l,A0
02:000366FA 12303000        	  5070:     move.b  (A0,D3.W),D1
02:000366FE B001            	  5071:     cmp.b   D1,D0
02:00036700 650A            	  5072:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  5073:     ; But if we have, then go to the next submode, and set a timer
                            	  5074:     ; to wait $40 frames in the next submode.
                            	  5075:     ;
02:00036702 522C0013        	  5076:     addq.b  #1,($0013,A4)
