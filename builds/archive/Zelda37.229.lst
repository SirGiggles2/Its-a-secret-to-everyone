                            	  6591: Digdogger_Draw:
02:0003C5E6 7006            	  6592:     moveq   #6,D0
02:0003C5E8 4EB90004CDDA    	  6593:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  6594:     ; If this is a child digdogger, then go draw it.
                            	  6595:     ;
02:0003C5EE 41EC046B        	  6596:     lea     ($046B,A4),A0
02:0003C5F2 10302000        	  6597:     move.b  (A0,D2.W),D0
02:0003C5F6 666C            	  6598:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  6599:     ; For each part of the big digdogger, from 0 to 3,
                            	  6600:     ; indexed by Y register:
                            	  6601:     ;
02:0003C5F8 7600            	  6602:     moveq   #0,D3
                            	  6603:     even
                            	  6604: _L_z04_Digdogger_Draw_LoopPart:
                            	  6605:     ; Store in [00] the X coordinate offset for the current corner.
                            	  6606:     ;
02:0003C5FA 10342070        	  6607:     move.b  ($70,A4,D2.W),D0
02:0003C5FE 023C00EE        	  6608:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C602 41F90003C5DA    	  6609:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003C608 12303000        	  6610:     move.b  (A0,D3.W),D1
02:0003C60C D101            	  6611:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003C60E 1880            	  6612:     move.b  D0,($0000,A4)
                            	  6613:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  6614:     ;
02:0003C610 41EC0084        	  6615:     lea     ($0084,A4),A0
02:0003C614 10302000        	  6616:     move.b  (A0,D2.W),D0
02:0003C618 023C00EE        	  6617:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C61C 41F90003C5DE    	  6618:     lea     (DigdoggerSpriteOffsetsY).l,A0
02:0003C622 12303000        	  6619:     move.b  (A0,D3.W),D1
02:0003C626 D101            	  6620:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsY,Y
02:0003C628 19400001        	  6621:     move.b  D0,($0001,A4)
                            	  6622:     ; Load and set the sprite attributes for this part.
                            	  6623:     ; Vertical flipping is set appropriately here.
                            	  6624:     ;
02:0003C62C 41F90003C5E2    	  6625:     lea     (DigdoggerSpriteAttrs).l,A0
02:0003C632 10303000        	  6626:     move.b  (A0,D3.W),D0
02:0003C636 4EB900031AAC    	  6627:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003C63C 1003            	  6628:     move.b  D3,D0
02:0003C63E 1B00            	  6629:     move.b  D0,-(A5)  ; PHA
                            	  6630:     ; Parts at odd indexes are flipped horizontally.
                            	  6631:     ;
02:0003C640 02000001        	  6632:     andi.b #$01,D0
02:0003C644 1940000F        	  6633:     move.b  D0,($000F,A4)
02:0003C648 7000            	  6634:     moveq   #0,D0
02:0003C64A 4EB9000317BA    	  6635:     jsr     DrawObjectNotMirrored
02:0003C650 101D            	  6636:     move.b  (A5)+,D0  ; PLA
02:0003C652 7600            	  6637:     moveq   #0,D3
02:0003C654 1600            	  6638:     move.b  D0,D3
                            	  6639:     ; Bottom of the loop.
