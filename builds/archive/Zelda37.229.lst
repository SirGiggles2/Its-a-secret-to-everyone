02:0003029C 19802070        	  2882:     move.b  D0,($70,A4,D2.W)
02:000302A0 102C0001        	  2883:     move.b  ($0001,A4),D0
02:000302A4 023C00EE        	  2884:     andi    #$EE,CCR  ; CLC: clear C+X
02:000302A8 41F9000301E8    	  2885:     lea     (LinkToSquareOffsetsY).l,A0
02:000302AE 12303000        	  2886:     move.b  (A0,D3.W),D1
