                            	  7991: UpdatePolsVoiceState1_Jumping:
                            	  7992:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7993:     ;
02:0003CFBA 41EC0444        	  7994:     lea     ($0444,A4),A0
02:0003CFBE 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003CFC2 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFC6 123C0038        	  7997:     move.b  #$38,D1
02:0003CFCA D101            	  7998:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFCC 41EC0444        	  7999:     lea     ($0444,A4),A0
02:0003CFD0 11802000        	  8000:     move.b  D0,(A0,D2.W)
                            	  8001:     ; Add Carry to high speed byte (vertical).
                            	  8002:     ;
02:0003CFD4 41EC0412        	  8003:     lea     ($0412,A4),A0
02:0003CFD8 10302000        	  8004:     move.b  (A0,D2.W),D0
02:0003CFDC 123C0000        	  8005:     move.b  #$00,D1
02:0003CFE0 D101            	  8006:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFE2 41EC0412        	  8007:     lea     ($0412,A4),A0
02:0003CFE6 11802000        	  8008:     move.b  D0,(A0,D2.W)
                            	  8009:     ; Add high speed byte to Y coordinate.
                            	  8010:     ;
02:0003CFEA 023C00EE        	  8011:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFEE 41EC0084        	  8012:     lea     ($0084,A4),A0
02:0003CFF2 12302000        	  8013:     move.b  (A0,D2.W),D1
02:0003CFF6 D101            	  8014:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CFF8 41EC0084        	  8015:     lea     ($0084,A4),A0
02:0003CFFC 11802000        	  8016:     move.b  D0,(A0,D2.W)
                            	  8017:     ; If the speed is still negative, then return.
                            	  8018:     ;
02:0003D000 41EC0412        	  8019:     lea     ($0412,A4),A0
02:0003D004 10302000        	  8020:     move.b  (A0,D2.W),D0
02:0003D008 6B0000AC        	  8021:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8022:     ; If Y coordinate still < target Y, then return.
                            	  8023:     ;
02:0003D00C 41EC0084        	  8024:     lea     ($0084,A4),A0
02:0003D010 10302000        	  8025:     move.b  (A0,D2.W),D0
02:0003D014 41EC042C        	  8026:     lea     ($042C,A4),A0
02:0003D018 12302000        	  8027:     move.b  (A0,D2.W),D1
02:0003D01C B001            	  8028:     cmp.b   D1,D0
02:0003D01E 65000096        	  8029:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8030:     ; Else reached the destination. Go to state 0.
                            	  8031:     ;
02:0003D022 7000            	  8032:     moveq   #0,D0
02:0003D024 41EC00AC        	  8033:     lea     ($00AC,A4),A0
02:0003D028 11802000        	  8034:     move.b  D0,(A0,D2.W)
                            	  8035:     ; Reset 16-bit vertical speed.
                            	  8036:     ;
02:0003D02C 41EC0444        	  8037:     lea     ($0444,A4),A0
02:0003D030 11802000        	  8038:     move.b  D0,(A0,D2.W)
02:0003D034 41EC0412        	  8039:     lea     ($0412,A4),A0
02:0003D038 11802000        	  8040:     move.b  D0,(A0,D2.W)
                            	  8041:     ; Choose a random direction to face in.
                            	  8042:     ;
02:0003D03C 10342018        	  8043:     move.b  ($18,A4,D2.W),D0
02:0003D040 02000003        	  8044:     andi.b #$03,D0
02:0003D044 7600            	  8045:     moveq   #0,D3
02:0003D046 1600            	  8046:     move.b  D0,D3
02:0003D048 41F90003CE58    	  8047:     lea     (PolsVoiceDirections).l,A0
02:0003D04E 10303000        	  8048:     move.b  (A0,D3.W),D0
02:0003D052 41EC0098        	  8049:     lea     ($0098,A4),A0
02:0003D056 11802000        	  8050:     move.b  D0,(A0,D2.W)
                            	  8051:     ; Randomly set distance-to-move to $30 or $70.
                            	  8052:     ;
02:0003D05A 10342018        	  8053:     move.b  ($18,A4,D2.W),D0
02:0003D05E 02000040        	  8054:     andi.b #$40,D0
02:0003D062 123C0030        	  8055:     move.b  #$30,D1
02:0003D066 D101            	  8056:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D068 41EC0394        	  8057:     lea     ($0394,A4),A0
02:0003D06C 11802000        	  8058:     move.b  D0,(A0,D2.W)
                            	  8059:     ; Align the monster with a square horizontally.
                            	  8060:     ;
                            	  8061:     ; If in the left half of a square, align with that square.
                            	  8062:     ; If in the right half, align with the next square.
                            	  8063:     ;
02:0003D070 10342070        	  8064:     move.b  ($70,A4,D2.W),D0
02:0003D074 023C00EE        	  8065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D078 123C0008        	  8066:     move.b  #$08,D1
02:0003D07C D101            	  8067:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D07E 020000F0        	  8068:     andi.b #$F0,D0
02:0003D082 19802070        	  8069:     move.b  D0,($70,A4,D2.W)
                            	  8070:     ; Align the monster with a square vertically.
                            	  8071:     ;
                            	  8072:     ; If in the top half of a square, align with that square.
                            	  8073:     ; If in the bottom half, align with the next square.
                            	  8074:     ;
02:0003D086 41EC0084        	  8075:     lea     ($0084,A4),A0
02:0003D08A 10302000        	  8076:     move.b  (A0,D2.W),D0
02:0003D08E 023C00EE        	  8077:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D092 123C0008        	  8078:     move.b  #$08,D1
02:0003D096 D101            	  8079:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D098 020000F0        	  8080:     andi.b #$F0,D0
                            	  8081:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8082:     ;
02:0003D09C 003C0011        	  8083:     ori     #$11,CCR  ; SEC: set C+X
02:0003D0A0 123C0003        	  8084:     move.b  #$03,D1
02:0003D0A4 0A3C0010        	  8085:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D0A8 9101            	  8086:     subx.b  D1,D0   ; SBC #$03
02:0003D0AA 0A3C0010        	  8087:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D0AE 41EC0084        	  8088:     lea     ($0084,A4),A0
02:0003D0B2 11802000        	  8089:     move.b  D0,(A0,D2.W)
                            	  8090:     even
