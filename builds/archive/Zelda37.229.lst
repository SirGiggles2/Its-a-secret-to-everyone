                            	  7536: _anon_z01_99:
                            	  7537:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7538:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7539:     ;
                            	  7540:     ; If instead a monster is defending, then all this calculation
                            	  7541:     ; won't matter, because the shove direction will be set to the
                            	  7542:     ; weapon's direction.
                            	  7543:     ;
                            	  7544:     ; As such, calculate a direction from the monster to the defender,
                            	  7545:     ; assuming it's Link.
                            	  7546:     ;
                            	  7547:     ; Start with an assumption that the direction is vertical:
                            	  7548:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7549:     ;
02:00032330 7008            	  7550:     moveq   #8,D0
02:00032332 19400008        	  7551:     move.b  D0,($0008,A4)
02:00032336 41EC0084        	  7552:     lea     ($0084,A4),A0
02:0003233A 10302000        	  7553:     move.b  (A0,D2.W),D0
02:0003233E 19400004        	  7554:     move.b  D0,($0004,A4)
02:00032342 41EC0084        	  7555:     lea     ($0084,A4),A0
02:00032346 10303000        	  7556:     move.b  (A0,D3.W),D0
02:0003234A 19400005        	  7557:     move.b  D0,($0005,A4)
                            	  7558:     ; If the defender is Link and his grid offset <> 0 then
                            	  7559:     ; use his usual object direction variable to determine
                            	  7560:     ; which axis to check.
                            	  7561:     ;
02:0003234E 4A03            	  7562:     cmpi.b  #$00,D3
02:00032350 6612            	  7563:     bne  _anon_z01_100
02:00032352 102C0394        	  7564:     move.b  ($0394,A4),D0
02:00032356 670C            	  7565:     beq  _anon_z01_100
02:00032358 102C0098        	  7566:     move.b  ($0098,A4),D0
02:0003235C 02000003        	  7567:     andi.b #$03,D0
02:00032360 660C            	  7568:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032362 6720            	  7569:     beq  _L_z01_BeginShove_CheckVertical
                            	  7570: _anon_z01_100:
                            	  7571:     ; For monsters defending, or Link with grid offset = 0,
                            	  7572:     ; check direction in [0B].
                            	  7573:     ;
                            	  7574:     ; For monsters defending, this won't matter. For Link with grid
                            	  7575:     ; offset = 0, I believe the result will be arbitrary.
                            	  7576:     ;
                            	  7577:     ; TODO:
                            	  7578:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7579:     ; It doesn't seem to be if candle fire attacks him.
                            	  7580:     ;
02:00032364 102C000B        	  7581:     move.b  ($000B,A4),D0
02:00032368 0C000004        	  7582:     cmpi.b  #$04,D0
02:0003236C 6416            	  7583:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7584:     even
                            	  7585: _L_z01_BeginShove_CheckHorizontal:
                            	  7586:     ; If the direction checked is left or right,
                            	  7587:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7588:     ;
02:0003236E 7002            	  7589:     moveq   #2,D0
02:00032370 19400008        	  7590:     move.b  D0,($0008,A4)
02:00032374 10342070        	  7591:     move.b  ($70,A4,D2.W),D0
02:00032378 19400004        	  7592:     move.b  D0,($0004,A4)
02:0003237C 10343070        	  7593:     move.b  ($70,A4,D3.W),D0
02:00032380 19400005        	  7594:     move.b  D0,($0005,A4)
                            	  7595:     even
                            	  7596: _L_z01_BeginShove_CheckVertical:
                            	  7597:     ; If the monster is down or right of the other object,
                            	  7598:     ; then use the opposite direction already in [08].
                            	  7599:     ; Else shift [08] right to turn it into the opposite
                            	  7600:     ; direction up or down.
                            	  7601:     ;
                            	  7602:     ; Again assuming Link is the defender; after this, [08] points
                            	  7603:     ; Link away from the monster.
                            	  7604:     ;
02:00032384 102C0004        	  7605:     move.b  ($0004,A4),D0
02:00032388 122C0005        	  7606:     move.b  ($0005,A4),D1
02:0003238C B001            	  7607:     cmp.b   D1,D0
02:0003238E 640A            	  7608:     bcc  _anon_z01_101
02:00032390 122C0008        	  7609:     move.b  ($0008,A4),D1
02:00032394 E209            	  7610:     lsr.b  #1,D1   ; LSR $08
02:00032396 19410008        	  7611:     move.b  D1,($0008,A4)
                            	  7612: _anon_z01_101:
                            	  7613:     ; If a monster is the defender, go handle it separately.
                            	  7614:     ;
02:0003239A 4A03            	  7615:     cmpi.b  #$00,D3
02:0003239C 6656            	  7616:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7617:     ; Link is the defender.
                            	  7618:     ;
                            	  7619:     ; If Link is invincible, return without shoving.
                            	  7620:     ;
02:0003239E 102C04F0        	  7621:     move.b  ($04F0,A4),D0
02:000323A2 664E            	  7622:     bne  _L_z01_BeginShove_Exit
                            	  7623:     ; Store the shove direction we determined.
                            	  7624:     ;
                            	  7625:     ; Turn on the high bit to indicate that the next time we try to
                            	  7626:     ; move by shoving, it will be the first time for this shove action.
                            	  7627:     ;
02:000323A4 102C0008        	  7628:     move.b  ($0008,A4),D0
02:000323A8 00000080        	  7629:     ori.b #$80,D0
02:000323AC 194000C0        	  7630:     move.b  D0,($00C0,A4)
                            	  7631:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7632:     ;
02:000323B0 7018            	  7633:     moveq   #24,D0
02:000323B2 194004F0        	  7634:     move.b  D0,($04F0,A4)
02:000323B6 7020            	  7635:     moveq   #32,D0
02:000323B8 194000D3        	  7636:     move.b  D0,($00D3,A4)
                            	  7637:     ; If Link was shoved by one of his own weapons, then
                            	  7638:     ; nothing else to do. Return.
                            	  7639:     ;
02:000323BC 0C02000D        	  7640:     cmpi.b  #$0D,D2
02:000323C0 6430            	  7641:     bcc  _L_z01_BeginShove_Exit
                            	  7642:     ; Link was shoved by a monster.
                            	  7643:     ;
                            	  7644:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7645:     ; then return.
                            	  7646:     ;
02:000323C2 41EC04BF        	  7647:     lea     ($04BF,A4),A0
02:000323C6 10302000        	  7648:     move.b  (A0,D2.W),D0
02:000323CA 02000080        	  7649:     andi.b #$80,D0
02:000323CE 6622            	  7650:     bne  _L_z01_BeginShove_Exit
                            	  7651:     ; If the attacker is a vire, then return.
                            	  7652:     ;
02:000323D0 41EC034F        	  7653:     lea     ($034F,A4),A0
02:000323D4 10302000        	  7654:     move.b  (A0,D2.W),D0
02:000323D8 0C000012        	  7655:     cmpi.b  #$12,D0
02:000323DC 6714            	  7656:     beq  _L_z01_BeginShove_Exit
                            	  7657:     ; Turn the attacker in the opposite direction.
                            	  7658:     ;
02:000323DE 41EC0098        	  7659:     lea     ($0098,A4),A0
02:000323E2 10302000        	  7660:     move.b  (A0,D2.W),D0
02:000323E6 6100E87E        	  7661:     jsr     GetOppositeDir
02:000323EA 41EC0098        	  7662:     lea     ($0098,A4),A0
02:000323EE 11802000        	  7663:     move.b  D0,(A0,D2.W)
                            	  7664:     even
