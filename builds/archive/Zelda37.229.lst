02:00031D6E 41EC0098        	  6588:     lea     ($0098,A4),A0
02:00031D72 12302000        	  6589:     move.b  (A0,D2.W),D1
02:00031D76 8001            	  6590:     or.b  D1,D0
02:00031D78 02000003        	  6591:     andi.b #$03,D0
02:00031D7C 0C000003        	  6592:     cmpi.b  #$03,D0
02:00031D80 6702            	  6593:     beq.s  __far_z_01_0068
