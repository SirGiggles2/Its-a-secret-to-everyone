02:0003F066 123C0003        	 12379:     move.b  #$03,D1
02:0003F06A 0A3C0010        	 12380:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F06E 9101            	 12381:     subx.b  D1,D0   ; SBC #$03
02:0003F070 0A3C0010        	 12382:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F074 7600            	 12383:     moveq   #0,D3
02:0003F076 1600            	 12384:     move.b  D0,D3
                            	 12385:     ; If the patra child in slot 2 has not reached the required angle,
