                            	  6597: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6598:     ; Link and the shot are facing opposite directions.
                            	  6599:     ; Link can parry certain weapons/shots.
                            	  6600:     ;
                            	  6601:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6602:     ; no harmful collision; but it still counts as a shot collision.
                            	  6603:     ; So, go treat this as a parry.
                            	  6604:     ;
02:00031D84 41EC034F        	  6605:     lea     ($034F,A4),A0
02:00031D88 10302000        	  6606:     move.b  (A0,D2.W),D0
02:00031D8C 0C000055        	  6607:     cmpi.b  #$55,D0
02:00031D90 650E            	  6608:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031D92 0C00005B        	  6609:     cmpi.b  #$5B,D0
02:00031D96 6408            	  6610:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6611:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6612:     ; So, go harm Link.
                            	  6613:     ;
02:00031D98 102C0676        	  6614:     move.b  ($0676,A4),D0
02:00031D9C 6602            	  6615:     bne.s  __far_z_01_0069
02:00031D9E 600E            	  6616:     jmp  HarmLink
                            	  6617: __far_z_01_0069:
                            	  6618:     even
