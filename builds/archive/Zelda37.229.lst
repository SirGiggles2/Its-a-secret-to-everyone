02:0003CECC 10302000        	  7878:     move.b  (A0,D2.W),D0
02:0003CED0 020000FC        	  7879:     andi.b #$FC,D0
02:0003CED4 0C0000B0        	  7880:     cmpi.b  #$B0,D0
