02:00042144 B001            	  4235:     cmp.b   D1,D0
02:00042146 6622            	  4236:     bne  _anon_z05_95
02:00042148 102C0001        	  4237:     move.b  ($0001,A4),D0
02:0004214C 41F900042118    	  4238:     lea     (DoorwayBoundsMinOver).l,A0
02:00042152 12303000        	  4239:     move.b  (A0,D3.W),D1
02:00042156 B001            	  4240:     cmp.b   D1,D0
02:00042158 6510            	  4241:     bcs  _anon_z05_95
02:0004215A 41F90004211C    	  4242:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042160 12303000        	  4243:     move.b  (A0,D3.W),D1
02:00042164 B001            	  4244:     cmp.b   D1,D0
02:00042166 65000082        	  4245:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
