                            	  5970:     ; If mode = $12, or door timer <> 0, or door command = 0,
                            	  5971:     ; then return.
                            	  5972:     ;
02:0004381E 102C0012        	  5973:     move.b  ($0012,A4),D0
02:00043822 0C000012        	  5974:     cmpi.b  #$12,D0
02:00043826 6602            	  5975:     bne.s  __far_z_05_0089
02:00043828 60D4            	  5976:     jmp  L165D4_Exit
                            	  5977: __far_z_05_0089:
02:0004382A 102C0027        	  5978:     move.b  ($0027,A4),D0
02:0004382E 6702            	  5979:     beq.s  __far_z_05_0090
02:00043830 60CC            	  5980:     jmp  L165D4_Exit
                            	  5981: __far_z_05_0090:
02:00043832 102C0054        	  5982:     move.b  ($0054,A4),D0
02:00043836 6602            	  5983:     bne.s  __far_z_05_0091
02:00043838 60C4            	  5984:     jmp  L165D4_Exit
                            	  5985: __far_z_05_0091:
                            	  5986:     ; Turn the door command into the desired open or closed state
                            	  5987:     ; to store in [08].
                            	  5988:     ;
                            	  5989:     ; cmd:  7 6 3 2 
                            	  5990:     ; [08]: 2 0 0 0
                            	  5991:     ;
                            	  5992:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5993:     ; commands intended to be used.
                            	  5994:     ;
                            	  5995:     ; 3 is the end state of 2: close
                            	  5996:     ; 7 is the end state of 6: open
                            	  5997:     ;
02:0004383A 02000007        	  5998:     andi.b #$07,D0
02:0004383E 7601            	  5999:     moveq   #1,D3
02:00043840 19430002        	  6000:     move.b  D3,($0002,A4)
02:00043844 122C0002        	  6001:     move.b  ($0002,A4),D1
02:00043848 C200            	  6002:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004384A 6702            	  6003:     beq  _anon_z05_118
02:0004384C E208            	  6004:     lsr.b  #1,D0   ; LSR A
                            	  6005: _anon_z05_118:
02:0004384E 0C000002        	  6006:     cmpi.b  #$02,D0
02:00043852 6606            	  6007:     bne  _anon_z05_119
                            	  6008:     ; Command 2 sets Link's timer to $30.
                            	  6009:     ;
02:00043854 7630            	  6010:     moveq   #48,D3
02:00043856 19430028        	  6011:     move.b  D3,($0028,A4)
                            	  6012: _anon_z05_119:
02:0004385A 02000003        	  6013:     andi.b #$03,D0
02:0004385E 003C0011        	  6014:     ori     #$11,CCR  ; SEC: set C+X
02:00043862 123C0001        	  6015:     move.b  #$01,D1
02:00043866 0A3C0010        	  6016:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004386A 9101            	  6017:     subx.b  D1,D0   ; SBC #$01
02:0004386C 0A3C0010        	  6018:     eori    #$10,CCR  ; restore X = 6502 C
02:00043870 02000002        	  6019:     andi.b #$02,D0
02:00043874 19400008        	  6020:     move.b  D0,($0008,A4)
                            	  6021:     ; The command to close a key door or bombable wall does not
                            	  6022:     ; do anything.
                            	  6023:     ;
02:00043878 102C0054        	  6024:     move.b  ($0054,A4),D0
02:0004387C 0C000005        	  6025:     cmpi.b  #$05,D0
02:00043880 6416            	  6026:     bcc  _anon_z05_120
02:00043882 102C0055        	  6027:     move.b  ($0055,A4),D0
02:00043886 19400002        	  6028:     move.b  D0,($0002,A4)
02:0004388A 6100FAEC        	  6029:     jsr     FindDoorAttrByDoorBit
02:0004388E 0C000007        	  6030:     cmpi.b  #$07,D0
02:00043892 6704            	  6031:     beq  _anon_z05_120
02:00043894 6000009C        	  6032:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  6033: 
                            	  6034: _anon_z05_120:
                            	  6035:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6036:     ;
                            	  6037:     ; Shutters and the commands to open a door always change
                            	  6038:     ; tiles.
                            	  6039:     ;
02:00043898 61000130        	  6040:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6041:     even
                            	  6042: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6043:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6044:     ; We need to remember how many tiles need to be copied
                            	  6045:     ; in each transfer record.
                            	  6046:     ;
02:0004389C 102C0006        	  6047:     move.b  ($0006,A4),D0
02:000438A0 19400004        	  6048:     move.b  D0,($0004,A4)
                            	  6049:     ; Write the transfer record header for the door.
                            	  6050:     ;
                            	  6051:     ;
                            	  6052:     ; VRAM address high byte of door
02:000438A4 1014            	  6053:     move.b  ($0000,A4),D0
02:000438A6 41EC0302        	  6054:     lea     ($0302,A4),A0
02:000438AA 11802000        	  6055:     move.b  D0,(A0,D2.W)
02:000438AE 5202            	  6056:     addq.b  #1,D2
02:000438B0 102C0001        	  6057:     move.b  ($0001,A4),D0
02:000438B4 41EC0302        	  6058:     lea     ($0302,A4),A0
02:000438B8 11802000        	  6059:     move.b  D0,(A0,D2.W)
02:000438BC 5202            	  6060:     addq.b  #1,D2
02:000438BE 102C0006        	  6061:     move.b  ($0006,A4),D0
02:000438C2 41EC0302        	  6062:     lea     ($0302,A4),A0
02:000438C6 11802000        	  6063:     move.b  D0,(A0,D2.W)
02:000438CA 5202            	  6064:     addq.b  #1,D2
                            	  6065: _anon_z05_121:
                            	  6066:     ; Write two tiles in a short loop indexed by [04].
                            	  6067:     ;
02:000438CC 6100ED1C        	  6068:     jsr     WriteDoorFaceTileHorizontally
02:000438D0 66FA            	  6069:     bne  _anon_z05_121
                            	  6070:     ; OR the low VRAM address with $20 to go down one row
                            	  6071:     ; in order to work on the second row of door tiles.
                            	  6072:     ;
02:000438D2 7020            	  6073:     moveq   #32,D0
02:000438D4 122C0001        	  6074:     move.b  ($0001,A4),D1
02:000438D8 8001            	  6075:     or.b  D1,D0
02:000438DA 19400001        	  6076:     move.b  D0,($0001,A4)
                            	  6077:     ; Bottom of the loop.
                            	  6078:     ; Loop again to write the second transfer record for the
                            	  6079:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6080:     ;
02:000438DE 532C0005        	  6081:     subq.b  #1,($0005,A4)
02:000438E2 66B8            	  6082:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6083:     ; Write the end marker, and update buffer length.
                            	  6084:     ;
02:000438E4 103C00FF        	  6085:     move.b  #$FF,D0
02:000438E8 41EC0302        	  6086:     lea     ($0302,A4),A0
02:000438EC 11802000        	  6087:     move.b  D0,(A0,D2.W)
02:000438F0 1002            	  6088:     move.b  D2,D0
02:000438F2 19400301        	  6089:     move.b  D0,($0301,A4)
                            	  6090:     ; Increment the command.
                            	  6091:     ;
02:000438F6 522C0054        	  6092:     addq.b  #1,($0054,A4)
                            	  6093:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6094:     ; and resetting the door command.
                            	  6095:     ; This ends up catching original states 3 and 7.
                            	  6096:     ;
                            	  6097:     ; Else set door timer to 8 and return.
                            	  6098:     ;
02:000438FA 102C0054        	  6099:     move.b  ($0054,A4),D0
02:000438FE 02000003        	  6100:     andi.b #$03,D0
02:00043902 6708            	  6101:     beq  _anon_z05_122
02:00043904 7008            	  6102:     moveq   #8,D0
02:00043906 19400027        	  6103:     move.b  D0,($0027,A4)
02:0004390A 4E75            	  6104:     rts
                            	  6105: 
                            	  6106: _anon_z05_122:
                            	  6107:     ; If the door command = 4 after incrementing it, then
                            	  6108:     ; it was 3 (close door). So:
                            	  6109:     ; 1. reset this door's flag
                            	  6110:     ; 2. remove it from the opened door mask
                            	  6111:     ; 3. reset the door command
                            	  6112:     ; 4. go lay out doors in the play area map
                            	  6113:     ;
02:0004390C 102C0054        	  6114:     move.b  ($0054,A4),D0
02:00043910 0C000004        	  6115:     cmpi.b  #$04,D0
02:00043914 6626            	  6116:     bne  _anon_z05_123
02:00043916 7400            	  6117:     moveq   #0,D2
02:00043918 142C0009        	  6118:     move.b  ($0009,A4),D2
02:0004391C 6100DB78        	  6119:     jsr     ResetDoorFlag
02:00043920 102C0055        	  6120:     move.b  ($0055,A4),D0
02:00043924 0A00000F        	  6121:     eori.b #$0F,D0
02:00043928 122C00EE        	  6122:     move.b  ($00EE,A4),D1
02:0004392C C001            	  6123:     and.b  D1,D0
                            	  6124:     even
                            	  6125: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004392E 194000EE        	  6126:     move.b  D0,($00EE,A4)
                            	  6127:     even
                            	  6128: L_ResetDoorCmdAndLayOutDoors:
02:00043932 7000            	  6129:     moveq   #0,D0
02:00043934 19400054        	  6130:     move.b  D0,($0054,A4)
02:00043938 6000FCD4        	  6131:     jmp     LayOutDoors
                            	  6132: 
                            	  6133: _anon_z05_123:
                            	  6134:     ; Door command <> 4.
                            	  6135:     ; It must be 8, which means it was 7: open door.
                            	  6136:     ;
                            	  6137:     ; If the door is a shutter (7), then go add the door to the
                            	  6138:     ; opened door mask, reset door command, and lay out doors.
                            	  6139:     ;
02:0004393C 102C0055        	  6140:     move.b  ($0055,A4),D0
02:00043940 19400002        	  6141:     move.b  D0,($0002,A4)
02:00043944 6100FA32        	  6142:     jsr     FindDoorAttrByDoorBit
02:00043948 0C000007        	  6143:     cmpi.b  #$07,D0
02:0004394C 676E            	  6144:     beq  _anon_z05_124
                            	  6145:     ; Else the door is not a shutter.
                            	  6146:     ;
                            	  6147:     ;
                            	  6148:     ; [09] door direction index
02:0004394E 7400            	  6149:     moveq   #0,D2
02:00043950 142C0009        	  6150:     move.b  ($0009,A4),D2
02:00043954 6100DB3A        	  6151:     jsr     SetDoorFlag
                            	  6152:     ; Get the next room's ID.
                            	  6153:     ;
02:00043958 1003            	  6154:     move.b  D3,D0
02:0004395A 023C00EE        	  6155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004395E 41F90004381A    	  6156:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043964 12302000        	  6157:     move.b  (A0,D2.W),D1
02:00043968 D101            	  6158:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0004396A 7600            	  6159:     moveq   #0,D3
02:0004396C 1600            	  6160:     move.b  D0,D3
                            	  6161:     ; Flip the door direction index.
                            	  6162:     ;
02:0004396E 1002            	  6163:     move.b  D2,D0
02:00043970 0A000001        	  6164:     eori.b #$01,D0
02:00043974 7400            	  6165:     moveq   #0,D2
02:00043976 1400            	  6166:     move.b  D0,D2
                            	  6167:     ; Set the door flag for the opposite door in the next room.
                            	  6168:     ;
02:00043978 1214            	  6169:     move.b  ($00,A4),D1   ; ptr lo
02:0004397A 182C0001        	  6170:     move.b  ($01,A4),D4  ; ptr hi
02:0004397E 024100FF        	  6171:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043982 E14C            	  6172:     lsl.w   #8,D4
02:00043984 8841            	  6173:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043986 48C4            	  6174:     ext.l   D4
02:00043988 D8BC00FF0000    	  6175:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004398E 2044            	  6176:     movea.l D4,A0
02:00043990 10303000        	  6177:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043994 41F90004AB28    	  6178:     lea     (LevelMasks).l,A0
02:0004399A 12302000        	  6179:     move.b  (A0,D2.W),D1
02:0004399E 8001            	  6180:     or.b  D1,D0
02:000439A0 1214            	  6181:     move.b  ($00,A4),D1   ; ptr lo
02:000439A2 182C0001        	  6182:     move.b  ($01,A4),D4  ; ptr hi
02:000439A6 024100FF        	  6183:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439AA E14C            	  6184:     lsl.w   #8,D4
02:000439AC 8841            	  6185:     or.w    D1,D4
02:000439AE 48C4            	  6186:     ext.l   D4
02:000439B0 D8BC00FF0000    	  6187:     add.l   #NES_RAM,D4
02:000439B6 2044            	  6188:     movea.l D4,A0
02:000439B8 11803000        	  6189:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6190: _anon_z05_124:
                            	  6191:     ; Add the door to the opened door mask, reset door command,
                            	  6192:     ; and lay out doors.
                            	  6193:     ;
02:000439BC 102C0055        	  6194:     move.b  ($0055,A4),D0
02:000439C0 122C00EE        	  6195:     move.b  ($00EE,A4),D1
02:000439C4 8001            	  6196:     or.b  D1,D0
02:000439C6 6000FF66        	  6197:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6198: 
                            	  6199: ; Params:
                            	  6200: ; [08]: 0 if closed
                            	  6201: ;
                            	  6202: ; Returns:
                            	  6203: ; X: current length of dynamic transfer buf
                            	  6204: ; [00]: door VRAM address high byte
                            	  6205: ; [01]: door VRAM address low byte
                            	  6206: ; [02:03]: address of door tiles for direction and face
                            	  6207: ; [05]: 2, the number of transfer records to write
                            	  6208: ; [06]: 2, the number of tiles in each record
                            	  6209: ; [07]: 0, the first index of a tile to transfer
                            	  6210: ; [09]: door direction index
                            	  6211: ;
                            	  6212: ; Note that this routine is called with triggered doors:
                            	  6213: ; doors that can change state. Their door type numbers are >= 4.
                            	  6214: ;
                            	  6215: ; If this routine were ever called with a fixed door
                            	  6216: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6217: ; values for the door face.
                            	  6218: ;
                            	  6219: ;
                            	  6220: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6221: ;
                            	  6222:     even
                            	  6223: PrepareWriteHorizontalDoorTransferRecords:
02:000439CA 102C0055        	  6224:     move.b  ($0055,A4),D0
02:000439CE 19400002        	  6225:     move.b  D0,($0002,A4)
02:000439D2 6100F9A4        	  6226:     jsr     FindDoorAttrByDoorBit
02:000439D6 0C000005        	  6227:     cmpi.b  #$05,D0
02:000439DA 650C            	  6228:     bcs  _anon_z05_125
02:000439DC 1B00            	  6229:     move.b  D0,-(A5)  ; PHA
02:000439DE 7004            	  6230:     moveq   #4,D0
02:000439E0 4EB9000307BC    	  6231:     jsr     PlaySample
02:000439E6 101D            	  6232:     move.b  (A5)+,D0  ; PLA
                            	  6233: _anon_z05_125:
                            	  6234:     ; Calculate the door face index in three parts.
                            	  6235:     ;
                            	  6236:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6237:     ; (provisional face index in Y register).
                            	  6238:     ;
02:000439E8 0C000004        	  6239:     cmpi.b  #$04,D0
02:000439EC 6602            	  6240:     bne  _anon_z05_126
02:000439EE 7008            	  6241:     moveq   #8,D0
                            	  6242: _anon_z05_126:
02:000439F0 0C000001        	  6243:     cmpi.b  #$01,D0
02:000439F4 6602            	  6244:     bne  _anon_z05_127
02:000439F6 7004            	  6245:     moveq   #4,D0
                            	  6246: _anon_z05_127:
                            	  6247:     ; Second, subtract 3 from provisional face index.
                            	  6248:     ;
02:000439F8 003C0011        	  6249:     ori     #$11,CCR  ; SEC: set C+X
02:000439FC 123C0003        	  6250:     move.b  #$03,D1
02:00043A00 0A3C0010        	  6251:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A04 9101            	  6252:     subx.b  D1,D0   ; SBC #$03
02:00043A06 0A3C0010        	  6253:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A0A 7600            	  6254:     moveq   #0,D3
02:00043A0C 1600            	  6255:     move.b  D0,D3
                            	  6256:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6257:     ; face index >= 3, then subtract 1 from it.
                            	  6258:     ;
                            	  6259:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6260:     ; then make it 1.
                            	  6261:     ;
02:00043A0E 102C0008        	  6262:     move.b  ($0008,A4),D0
02:00043A12 6708            	  6263:     beq  _anon_z05_128
02:00043A14 0C030005        	  6264:     cmpi.b  #$05,D3
02:00043A18 670A            	  6265:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043A1A 7601            	  6266:     moveq   #1,D3
                            	  6267: _anon_z05_128:
02:00043A1C 0C030003        	  6268:     cmpi.b  #$03,D3
02:00043A20 6502            	  6269:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043A22 5303            	  6270:     subq.b  #1,D3
                            	  6271:     even
                            	  6272: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6273:     ; The routine that returned the door type also returned its
                            	  6274:     ; reverse direction index in [03].
                            	  6275:     ;
                            	  6276:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6277:     ;
02:00043A24 7003            	  6278:     moveq   #3,D0
02:00043A26 003C0011        	  6279:     ori     #$11,CCR  ; SEC: set C+X
02:00043A2A 122C0003        	  6280:     move.b  ($0003,A4),D1
02:00043A2E 0A3C0010        	  6281:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A32 9101            	  6282:     subx.b  D1,D0   ; SBC $03
02:00043A34 0A3C0010        	  6283:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6284:     ; Call this to put the address of door face tiles in [02:03].
                            	  6285:     ;
02:00043A38 6100FD7A        	  6286:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6287:     ; Return the address of the door in the nametable in [01:00].
                            	  6288:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6289:     ;
02:00043A3C 41F900043812    	  6290:     lea     (DoorVramAddrsHi).l,A0
02:00043A42 10302000        	  6291:     move.b  (A0,D2.W),D0
02:00043A46 1880            	  6292:     move.b  D0,($0000,A4)
02:00043A48 41F900043816    	  6293:     lea     (DoorVramAddrsLo).l,A0
02:00043A4E 10302000        	  6294:     move.b  (A0,D2.W),D0
02:00043A52 19400001        	  6295:     move.b  D0,($0001,A4)
                            	  6296:     ; Return the direction of the door in [09], and the dynamic
                            	  6297:     ; transfer buf length in X register.
                            	  6298:     ;
02:00043A56 19420009        	  6299:     move.b  D2,($0009,A4)
02:00043A5A 7400            	  6300:     moveq   #0,D2
02:00043A5C 142C0301        	  6301:     move.b  ($0301,A4),D2
                            	  6302:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6303:     ;
02:00043A60 7000            	  6304:     moveq   #0,D0
02:00043A62 19400007        	  6305:     move.b  D0,($0007,A4)
02:00043A66 7002            	  6306:     moveq   #2,D0
02:00043A68 19400006        	  6307:     move.b  D0,($0006,A4)
02:00043A6C 19400005        	  6308:     move.b  D0,($0005,A4)
