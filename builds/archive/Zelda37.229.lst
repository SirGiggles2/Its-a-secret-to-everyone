02:00039EF4 41EC0394        	  1120:     lea     ($0394,A4),A0
02:00039EF8 10302000        	  1121:     move.b  (A0,D2.W),D0
02:00039EFC 023C00EE        	  1122:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039F00 123C0002        	  1123:     move.b  #$02,D1
