                            	  9699: Manhandla_Move:
                            	  9700:     ; Implement a way of manifesting the fractional part of the speed
                            	  9701:     ; in the movement.
                            	  9702:     ;
                            	  9703:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9704:     ; byte to add to the coordinates, then the effective speed would
                            	  9705:     ; be 1 pixel a frame instead of 1.25.
                            	  9706:     ;
                            	  9707:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9708:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9709:     ;
                            	  9710:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9711:     ;
                            	  9712:     ;   SA := SA + (SL AND $E0)
                            	  9713:     ;   [03] := SH + carry
                            	  9714:     ;
                            	  9715:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9716:     ;
02:0003DC84 41EC041F        	  9717:     lea     ($041F,A4),A0
02:0003DC88 10302000        	  9718:     move.b  (A0,D2.W),D0
02:0003DC8C 020000E0        	  9719:     andi.b #$E0,D0
02:0003DC90 023C00EE        	  9720:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC94 41EC0412        	  9721:     lea     ($0412,A4),A0
02:0003DC98 12302000        	  9722:     move.b  (A0,D2.W),D1
02:0003DC9C D101            	  9723:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC9E 41EC0412        	  9724:     lea     ($0412,A4),A0
02:0003DCA2 11802000        	  9725:     move.b  D0,(A0,D2.W)
                            	  9726:     ; Assign (high speed byte + carry) to [03].
                            	  9727:     ;
02:0003DCA6 41EC042C        	  9728:     lea     ($042C,A4),A0
02:0003DCAA 10302000        	  9729:     move.b  (A0,D2.W),D0
02:0003DCAE 123C0000        	  9730:     move.b  #$00,D1
02:0003DCB2 D101            	  9731:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCB4 19400003        	  9732:     move.b  D0,($0003,A4)
                            	  9733:     ; Change coordinates by the speed amount/offset in [03]
                            	  9734:     ; according to the direction.
                            	  9735:     ;
                            	  9736:     ; Start with a mask of $A1 in [02]:
                            	  9737:     ; - low nibble represents the right direction
                            	  9738:     ; - high nibble is used to set or clear carry as we go along
                            	  9739:     ;
02:0003DCB8 103C00A1        	  9740:     move.b  #$A1,D0
02:0003DCBC 19400002        	  9741:     move.b  D0,($0002,A4)
                            	  9742:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9743:     ;
02:0003DCC0 41EC0098        	  9744:     lea     ($0098,A4),A0
02:0003DCC4 10302000        	  9745:     move.b  (A0,D2.W),D0
02:0003DCC8 122C0002        	  9746:     move.b  ($0002,A4),D1
02:0003DCCC C200            	  9747:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCCE 6712            	  9748:     beq  _L_z04_Manhandla_Move_Left
02:0003DCD0 10342070        	  9749:     move.b  ($70,A4,D2.W),D0
02:0003DCD4 023C00EE        	  9750:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCD8 122C0003        	  9751:     move.b  ($0003,A4),D1
02:0003DCDC D101            	  9752:     addx.b  D1,D0   ; ADC $03
02:0003DCDE 19802070        	  9753:     move.b  D0,($70,A4,D2.W)
                            	  9754:     even
                            	  9755: _L_z04_Manhandla_Move_Left:
                            	  9756:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9757:     ;
02:0003DCE2 41EC0098        	  9758:     lea     ($0098,A4),A0
02:0003DCE6 10302000        	  9759:     move.b  (A0,D2.W),D0
02:0003DCEA 122C0002        	  9760:     move.b  ($0002,A4),D1
02:0003DCEE E309            	  9761:     lsl.b  #1,D1   ; ASL $02
02:0003DCF0 19410002        	  9762:     move.b  D1,($0002,A4)
02:0003DCF4 122C0002        	  9763:     move.b  ($0002,A4),D1
02:0003DCF8 C200            	  9764:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCFA 6716            	  9765:     beq  _L_z04_Manhandla_Move_Down
02:0003DCFC 10342070        	  9766:     move.b  ($70,A4,D2.W),D0
02:0003DD00 122C0003        	  9767:     move.b  ($0003,A4),D1
02:0003DD04 0A3C0010        	  9768:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD08 9101            	  9769:     subx.b  D1,D0   ; SBC $03
02:0003DD0A 0A3C0010        	  9770:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD0E 19802070        	  9771:     move.b  D0,($70,A4,D2.W)
                            	  9772:     even
                            	  9773: _L_z04_Manhandla_Move_Down:
                            	  9774:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9775:     ;
02:0003DD12 41EC0098        	  9776:     lea     ($0098,A4),A0
02:0003DD16 10302000        	  9777:     move.b  (A0,D2.W),D0
02:0003DD1A 122C0002        	  9778:     move.b  ($0002,A4),D1
02:0003DD1E E309            	  9779:     lsl.b  #1,D1   ; ASL $02
02:0003DD20 19410002        	  9780:     move.b  D1,($0002,A4)
02:0003DD24 122C0002        	  9781:     move.b  ($0002,A4),D1
02:0003DD28 C200            	  9782:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD2A 6716            	  9783:     beq  _L_z04_Manhandla_Move_Up
02:0003DD2C 41EC0084        	  9784:     lea     ($0084,A4),A0
02:0003DD30 10302000        	  9785:     move.b  (A0,D2.W),D0
02:0003DD34 122C0003        	  9786:     move.b  ($0003,A4),D1
02:0003DD38 D101            	  9787:     addx.b  D1,D0   ; ADC $03
02:0003DD3A 41EC0084        	  9788:     lea     ($0084,A4),A0
02:0003DD3E 11802000        	  9789:     move.b  D0,(A0,D2.W)
                            	  9790:     even
                            	  9791: _L_z04_Manhandla_Move_Up:
                            	  9792:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9793:     ;
02:0003DD42 41EC0098        	  9794:     lea     ($0098,A4),A0
02:0003DD46 10302000        	  9795:     move.b  (A0,D2.W),D0
02:0003DD4A 122C0002        	  9796:     move.b  ($0002,A4),D1
02:0003DD4E E309            	  9797:     lsl.b  #1,D1   ; ASL $02
02:0003DD50 19410002        	  9798:     move.b  D1,($0002,A4)
02:0003DD54 122C0002        	  9799:     move.b  ($0002,A4),D1
02:0003DD58 C200            	  9800:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD5A 671E            	  9801:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD5C 41EC0084        	  9802:     lea     ($0084,A4),A0
02:0003DD60 10302000        	  9803:     move.b  (A0,D2.W),D0
02:0003DD64 122C0003        	  9804:     move.b  ($0003,A4),D1
02:0003DD68 0A3C0010        	  9805:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD6C 9101            	  9806:     subx.b  D1,D0   ; SBC $03
02:0003DD6E 0A3C0010        	  9807:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD72 41EC0084        	  9808:     lea     ($0084,A4),A0
02:0003DD76 11802000        	  9809:     move.b  D0,(A0,D2.W)
                            	  9810:     even
                            	  9811: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9812:     ; To the frame accumulator, add:
                            	  9813:     ; - a random value between 0 and 3
                            	  9814:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9815:     ;
02:0003DD7A 10342019        	  9816:     move.b  ($19,A4,D2.W),D0
02:0003DD7E 02000003        	  9817:     andi.b #$03,D0
02:0003DD82 023C00EE        	  9818:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD86 122C0003        	  9819:     move.b  ($0003,A4),D1
02:0003DD8A D101            	  9820:     addx.b  D1,D0   ; ADC $03
02:0003DD8C 41EC0451        	  9821:     lea     ($0451,A4),A0
02:0003DD90 12302000        	  9822:     move.b  (A0,D2.W),D1
02:0003DD94 D101            	  9823:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DD96 41EC0451        	  9824:     lea     ($0451,A4),A0
02:0003DD9A 11802000        	  9825:     move.b  D0,(A0,D2.W)
02:0003DD9E 61001E0A        	  9826:     jsr     BoundFlyer
                            	  9827:     ; TODO:
