                            	  5802: AnimateBoomerangAndCheckCollision:
                            	  5803:     ; Decrement animation counter; and when it reaches 0:
                            	  5804:     ; 1. arm it again for 2 frames
                            	  5805:     ; 2. advance the minor state within a cycle of 8
                            	  5806:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5807:     ;
02:0004C606 41EC03D0        	  5808:     lea     ($03D0,A4),A0
02:0004C60A 53302000        	  5809:     subq.b  #1,(A0,D2.W)
