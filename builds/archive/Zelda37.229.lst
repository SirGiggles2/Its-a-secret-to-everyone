02:0004C56C 11803000        	  5732:     move.b  D0,(A0,D3.W)
02:0004C570 0A3C0001        	  5733:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C574 4E75            	  5734:     rts
