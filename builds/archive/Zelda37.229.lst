02:0004D23A 61000500        	  7390:     jsr     SwitchBank
02:0004D23E 4EB900041E4E    	  7391:     jsr     FindNextEdgeSpawnCell
                            	  7392:     ; Post-walk 1: bottom-edge snap.
02:0004D244 102C0525        	  7393:     move.b  ($0525,A4),D0
02:0004D248 020000F0        	  7394:     andi.b  #$F0,D0
02:0004D24C 0C0000E0        	  7395:     cmpi.b  #$E0,D0
