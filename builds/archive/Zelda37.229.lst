                            	  9096:     ; The map marks are arranged in the same order as all the
                            	  9097:     ; possible values of OpenDoorMask.
                            	  9098:     ;
                            	  9099:     ; Add $E2 for the first map mark tile, and store it in the
                            	  9100:     ; dynamic transfer buf at the current offset.
                            	  9101:     ;
