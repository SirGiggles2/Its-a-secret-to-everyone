02:0003AF2E 0C000003        	  3446:     cmpi.b  #$03,D0
02:0003AF32 666E            	  3447:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  3448:     ; State 3.
                            	  3449:     ;
                            	  3450:     ; If being shoved, go shove, animate, and draw the leever.
