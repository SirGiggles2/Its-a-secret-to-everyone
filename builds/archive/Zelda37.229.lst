02:0003B4E4 4600            	  4312:     eori.b #$FF,D0
02:0003B4E6 023C00EE        	  4313:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B4EA 123C0001        	  4314:     move.b  #$01,D1
02:0003B4EE D101            	  4315:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4316:     even
