                            	  2992:     ; then we'll make 4 traps.
                            	  2993:     ;
02:00030370 41EC034F        	  2994:     lea     ($034F,A4),A0
02:00030374 12302000        	  2995:     move.b  (A0,D2.W),D1
02:00030378 B001            	  2996:     cmp.b   D1,D0
