                            	  8431:     even
                            	  8432: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8433:     ; If the teleporting distance remaining is even, then draw
                            	  8434:     ; and check collisions, else return.
                            	  8435:     ;
                            	  8436:     ; This means that when 0, the monster is walking.
                            	  8437:     ; So, draw and check collisions every frame.
                            	  8438:     ;
                            	  8439:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8440:     ; translucently -- every other frame.
                            	  8441:     ;
02:0003D356 41EC0394        	  8442:     lea     ($0394,A4),A0
02:0003D35A 10302000        	  8443:     move.b  (A0,D2.W),D0
02:0003D35E E208            	  8444:     lsr.b  #1,D0   ; LSR A
02:0003D360 6402            	  8445:     bcc.s  __far_z_04_0076
02:0003D362 603A            	  8446:     jmp  L11E17_Exit
                            	  8447: __far_z_04_0076:
                            	  8448:     even
