                            	   649: c_reset_door_flag:
02:0002B720 7000            	   650:     moveq   #0,D0
02:0002B722 3002            	   651:     move.w  D2,D0
02:0002B724 2F00            	   652:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	   653:     jsr     z05_reset_door_flag
02:0002B72C 588F            	   654:     addq.l  #4,SP
02:0002B72E 4E75            	   655:     rts
