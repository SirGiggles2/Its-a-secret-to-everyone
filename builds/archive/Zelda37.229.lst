02:0003C7A4 023C00EE        	  6824:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7A8 41EC0478        	  6825:     lea     ($0478,A4),A0
02:0003C7AC 12302000        	  6826:     move.b  (A0,D2.W),D1
02:0003C7B0 D101            	  6827:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C7B2 41EC0084        	  6828:     lea     ($0084,A4),A0
