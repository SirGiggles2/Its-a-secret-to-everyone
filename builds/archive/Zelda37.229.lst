                            	  1804: CopyCommonCodeToRam:
                            	  1805:     ; PATCHED: NOP — all code is in flat ROM on Genesis.
02:0002EAEE 4E75            	  1806:     rts
02:0002EAF0 7000            	  1807:     moveq   #0,D0
02:0002EAF2 1880            	  1808:     move.b  D0,($0000,A4)
02:0002EAF4 103C00A5        	  1809:     move.b  #$A5,D0
02:0002EAF8 19400001        	  1810:     move.b  D0,($0001,A4)
02:0002EAFC 103C0090        	  1811:     move.b  #$90,D0
02:0002EB00 19400002        	  1812:     move.b  D0,($0002,A4)
02:0002EB04 706C            	  1813:     moveq   #108,D0
02:0002EB06 19400003        	  1814:     move.b  D0,($0003,A4)
02:0002EB0A 7600            	  1815:     moveq   #0,D3
