                            	  3590: CheckCaveEdge:
02:00041CC0 4EB90004BBEA    	  3591:     jsr     CheckScreenEdge
                            	  3592:     ; If the player touched the edge of the screen and triggered
                            	  3593:     ; a transition to another mode, then go set up the right mode.
                            	  3594:     ;
02:00041CC6 102C0011        	  3595:     move.b  ($0011,A4),D0
02:00041CCA 6602            	  3596:     bne.s  __far_z_05_0073
02:00041CCC 60CC            	  3597:     jmp  GoToModeAFromCave
                            	  3598: __far_z_05_0073:
02:00041CCE 4E75            	  3599:     rts
                            	  3600: 
                            	  3601: ; Params:
                            	  3602: ; [0F]: movement direction
                            	  3603: ;
                            	  3604: ; Returns:
                            	  3605: ; [0F]: movement direction or 0
                            	  3606: ;
                            	  3607: ;
                            	  3608: ; If the ladder's not in use, return.
                            	  3609: ;
                            	  3610:     even
                            	  3611: CheckLadder:
02:00041CD0 7400            	  3612:     moveq   #0,D2
02:00041CD2 142C0064        	  3613:     move.b  ($0064,A4),D2
02:00041CD6 670000BE        	  3614:     beq  _L_z05_CheckLadder_Exit
                            	  3615:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3616:     ;
02:00041CDA 41EC00AC        	  3617:     lea     ($00AC,A4),A0
02:00041CDE 10302000        	  3618:     move.b  (A0,D2.W),D0
02:00041CE2 670000A6        	  3619:     beq  _L_z05_CheckLadder_StashLadder
                            	  3620:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3621:     ; between the ladder and Link.
                            	  3622:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3623:     ;
02:00041CE6 41EC0098        	  3624:     lea     ($0098,A4),A0
02:00041CEA 10302000        	  3625:     move.b  (A0,D2.W),D0
02:00041CEE 0200000C        	  3626:     andi.b #$0C,D0
02:00041CF2 6734            	  3627:     beq  _anon_z05_85
02:00041CF4 102C0070        	  3628:     move.b  ($0070,A4),D0
02:00041CF8 12342070        	  3629:     move.b  ($70,A4,D2.W),D1
02:00041CFC B001            	  3630:     cmp.b   D1,D0
02:00041CFE 6600008A        	  3631:     bne  _L_z05_CheckLadder_StashLadder
02:00041D02 102C0084        	  3632:     move.b  ($0084,A4),D0
02:00041D06 023C00EE        	  3633:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D0A 123C0003        	  3634:     move.b  #$03,D1
02:00041D0E D101            	  3635:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D10 003C0011        	  3636:     ori     #$11,CCR  ; SEC: set C+X
02:00041D14 41EC0084        	  3637:     lea     ($0084,A4),A0
02:00041D18 12302000        	  3638:     move.b  (A0,D2.W),D1
02:00041D1C 0A3C0010        	  3639:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D20 9101            	  3640:     subx.b  D1,D0   ; SBC ObjY,X
02:00041D22 0A3C0010        	  3641:     eori    #$10,CCR  ; restore X = 6502 C
02:00041D26 6030            	  3642:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3643: 
                            	  3644: _anon_z05_85:
                            	  3645:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3646:     ; between the ladder and Link.
                            	  3647:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3648:     ;
02:00041D28 102C0084        	  3649:     move.b  ($0084,A4),D0
02:00041D2C 023C00EE        	  3650:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D30 123C0003        	  3651:     move.b  #$03,D1
02:00041D34 D101            	  3652:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D36 41EC0084        	  3653:     lea     ($0084,A4),A0
02:00041D3A 12302000        	  3654:     move.b  (A0,D2.W),D1
02:00041D3E B001            	  3655:     cmp.b   D1,D0
02:00041D40 6648            	  3656:     bne  _L_z05_CheckLadder_StashLadder
02:00041D42 102C0070        	  3657:     move.b  ($0070,A4),D0
02:00041D46 003C0011        	  3658:     ori     #$11,CCR  ; SEC: set C+X
02:00041D4A 12342070        	  3659:     move.b  ($70,A4,D2.W),D1
02:00041D4E 0A3C0010        	  3660:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D52 9101            	  3661:     subx.b  D1,D0   ; SBC ObjX,X
02:00041D54 0A3C0010        	  3662:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3663:     even
                            	  3664: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3665:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3666:     ; If > $10, go put the ladder away.
                            	  3667:     ;
02:00041D58 4EB900030C6A    	  3668:     jsr     Abs
02:00041D5E 1880            	  3669:     move.b  D0,($0000,A4)
02:00041D60 0C000010        	  3670:     cmpi.b  #$10,D0
02:00041D64 6532            	  3671:     bcs  _L_z05_CheckLadder_SetState2
02:00041D66 0C000010        	  3672:     cmpi.b  #$10,D0
02:00041D6A 661E            	  3673:     bne  _L_z05_CheckLadder_StashLadder
                            	  3674:     ; Distance = $10. If player's not facing in the same direction as
                            	  3675:     ; the ladder, go put away the ladder.
                            	  3676:     ;
02:00041D6C 102C0098        	  3677:     move.b  ($0098,A4),D0
02:00041D70 41EC0098        	  3678:     lea     ($0098,A4),A0
02:00041D74 12302000        	  3679:     move.b  (A0,D2.W),D1
02:00041D78 B001            	  3680:     cmp.b   D1,D0
02:00041D7A 660E            	  3681:     bne  _L_z05_CheckLadder_StashLadder
                            	  3682:     ; Distance = $10, and player's facing in the same direction.
                            	  3683:     ;
                            	  3684:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3685:     ; ladder and had not stepped onto it yet.
                            	  3686:     ; Go handle movement on it, but don't change state yet.
                            	  3687:     ;
                            	  3688:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3689:     ; off of the ladder. So the ladder should be put away. In this
                            	  3690:     ; case, fall thru.
                            	  3691:     ;
02:00041D7C 41EC00AC        	  3692:     lea     ($00AC,A4),A0
02:00041D80 10302000        	  3693:     move.b  (A0,D2.W),D0
02:00041D84 0C000001        	  3694:     cmpi.b  #$01,D0
02:00041D88 6718            	  3695:     beq  _L_z05_CheckLadder_HandleInput
                            	  3696:     even
                            	  3697: _L_z05_CheckLadder_StashLadder:
                            	  3698:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3699:     ;
02:00041D8A 7000            	  3700:     moveq   #0,D0
02:00041D8C 19400064        	  3701:     move.b  D0,($0064,A4)
02:00041D90 4EB90004D5C4    	  3702:     jsr     DestroyMonster
                            	  3703:     even
                            	  3704: _L_z05_CheckLadder_Exit:
02:00041D96 4E75            	  3705:     rts
                            	  3706: 
                            	  3707:     even
                            	  3708: _L_z05_CheckLadder_SetState2:
                            	  3709:     ;  Set state 2, because we're on the ladder.
                            	  3710:     ;
02:00041D98 7002            	  3711:     moveq   #2,D0
02:00041D9A 41EC00AC        	  3712:     lea     ($00AC,A4),A0
02:00041D9E 11802000        	  3713:     move.b  D0,(A0,D2.W)
                            	  3714:     even
                            	  3715: _L_z05_CheckLadder_HandleInput:
                            	  3716:     ; If input direction = 0, go draw and reset moving direction.
                            	  3717:     ;
02:00041DA2 102C03F8        	  3718:     move.b  ($03F8,A4),D0
02:00041DA6 67000086        	  3719:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3720:     ; Input direction <> 0. The player intends to move.
                            	  3721:     ; So, see if we need to override the moving direction.
                            	  3722:     ;
                            	  3723:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3724:     ; go draw and set moving direction to Link's direction.
                            	  3725:     ;
                            	  3726:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3727:     ; been blocked by the water.
                            	  3728:     ;
                            	  3729:     ; Or, Link already passed over the point right over the ladder
                            	  3730:     ; and was allowed to move onto the tiles after the ladder.
                            	  3731:     ;
02:00041DAA 102C0098        	  3732:     move.b  ($0098,A4),D0
02:00041DAE 7600            	  3733:     moveq   #0,D3
02:00041DB0 1614            	  3734:     move.b  ($0000,A4),D3
02:00041DB2 670C            	  3735:     beq  _anon_z05_86
02:00041DB4 41EC0098        	  3736:     lea     ($0098,A4),A0
02:00041DB8 12302000        	  3737:     move.b  (A0,D2.W),D1
02:00041DBC B001            	  3738:     cmp.b   D1,D0
02:00041DBE 676E            	  3739:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3740: _anon_z05_86:
                            	  3741:     ; Distance = 0, or facing different directions.
                            	  3742:     ;
                            	  3743:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3744:     ; then go draw and keep moving.
                            	  3745:     ;
                            	  3746:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3747:     ;
                            	  3748:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3749:     ; to move onto the tiles after the ladder.
                            	  3750:     ;
                            	  3751:     ; Note that if Link is not moving, then this test will fail,
                            	  3752:     ; and case (D) will catch it.
                            	  3753:     ;
02:00041DC0 41EC0098        	  3754:     lea     ($0098,A4),A0
02:00041DC4 10302000        	  3755:     move.b  (A0,D2.W),D0
02:00041DC8 122C000F        	  3756:     move.b  ($000F,A4),D1
02:00041DCC B001            	  3757:     cmp.b   D1,D0
02:00041DCE 675E            	  3758:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3759:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3760:     ; then go draw and move in ladder's direction.
                            	  3761:     ;
                            	  3762:     ; You can always step off the ladder where you came from.
                            	  3763:     ;
02:00041DD0 4EB900030C66    	  3764:     jsr     GetOppositeDir
02:00041DD6 122C0098        	  3765:     move.b  ($0098,A4),D1
02:00041DDA B001            	  3766:     cmp.b   D1,D0
02:00041DDC 6750            	  3767:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3768:     ; D. If opposite of ladder's direction <> down,
                            	  3769:     ; or input direction <> up,
                            	  3770:     ; then go reset moving direction, and draw.
                            	  3771:     ;
                            	  3772:     ; This will catch all cases of Link facing perpendicular to
                            	  3773:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3774:     ; ladder direction is up and input direction is up (E).
                            	  3775:     ;
02:00041DDE 0C000004        	  3776:     cmpi.b  #$04,D0
02:00041DE2 6648            	  3777:     bne  _anon_z05_87
02:00041DE4 102C03F8        	  3778:     move.b  ($03F8,A4),D0
02:00041DE8 0C000008        	  3779:     cmpi.b  #$08,D0
02:00041DEC 663E            	  3780:     bne  _anon_z05_87
                            	  3781:     ; E. The ladder's direction is up and input direction is up.
                            	  3782:     ;
                            	  3783:     ; An earlier call to check tile collision would have blocked
                            	  3784:     ; movement, because the tile under Link's top half is a water tile.
                            	  3785:     ; But because Link is squarely on the ladder, we really have
                            	  3786:     ; to check the tile above that one.
                            	  3787:     ;
                            	  3788:     ; Set moving direction to input direction (up) and switch X to
                            	  3789:     ; the player's slot for the purpose of checking tile collision below.
                            	  3790:     ; Based on that, we'll set moving direction according to walkability.
                            	  3791:     ;
02:00041DEE 6158            	  3792:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3793:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3794:     ;
02:00041DF0 102C0084        	  3795:     move.b  ($0084,A4),D0
02:00041DF4 1B00            	  3796:     move.b  D0,-(A5)  ; PHA
02:00041DF6 003C0011        	  3797:     ori     #$11,CCR  ; SEC: set C+X
02:00041DFA 123C0008        	  3798:     move.b  #$08,D1
02:00041DFE 0A3C0010        	  3799:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041E02 9101            	  3800:     subx.b  D1,D0   ; SBC #$08
02:00041E04 0A3C0010        	  3801:     eori    #$10,CCR  ; restore X = 6502 C
02:00041E08 19400084        	  3802:     move.b  D0,($0084,A4)
02:00041E0C 4EB90004B6F0    	  3803:     jsr     GetCollidingTileMoving
02:00041E12 101D            	  3804:     move.b  (A5)+,D0  ; PLA
02:00041E14 19400084        	  3805:     move.b  D0,($0084,A4)
                            	  3806:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3807:     ; direction as the input direction (in a roundabout way).
                            	  3808:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3809:     ;
02:00041E18 102C000F        	  3810:     move.b  ($000F,A4),D0
02:00041E1C 7600            	  3811:     moveq   #0,D3
02:00041E1E 162C049E        	  3812:     move.b  ($049E,A4),D3
02:00041E22 122C034A        	  3813:     move.b  ($034A,A4),D1
02:00041E26 B601            	  3814:     cmp.b   D1,D3
02:00041E28 6500FF78        	  3815:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3816: _anon_z05_87:
                            	  3817:     ; Set A to reset moving direction in [0F].
                            	  3818:     ;
02:00041E2C 7000            	  3819:     moveq   #0,D0
                            	  3820:     even
                            	  3821: _L_z05_CheckLadder_DrawLadder:
                            	  3822:     ; Draw the ladder.
                            	  3823:     ;
02:00041E2E 1B00            	  3824:     move.b  D0,-(A5)  ; PHA
02:00041E30 7400            	  3825:     moveq   #0,D2
02:00041E32 142C0064        	  3826:     move.b  ($0064,A4),D2
02:00041E36 4EB90004CDE0    	  3827:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041E3C 760C            	  3828:     moveq   #12,D3
02:00041E3E 7000            	  3829:     moveq   #0,D0
