02:0003B0B0 41EC03E4        	  3647:     lea     ($03E4,A4),A0
02:0003B0B4 12302000        	  3648:     move.b  (A0,D2.W),D1
02:0003B0B8 D101            	  3649:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0BA 1B00            	  3650:     move.b  D0,-(A5)  ; PHA
