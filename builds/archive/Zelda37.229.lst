                            	  4846:     ; The effect involves turning grayscale rendering on and off
                            	  4847:     ; in PPUMASK.
                            	  4848:     ;
                            	  4849:     ; Start by setting A register to the PPU mask shifted right to
                            	  4850:     ; throw away the grayscale bit.
                            	  4851:     ;
