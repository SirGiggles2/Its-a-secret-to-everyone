                            	  1655:     even
                            	  1656: InitMode4:
02:00040F0E 7400            	  1657:     moveq   #0,D2
02:00040F10 142C0013        	  1658:     move.b  ($0013,A4),D2
02:00040F14 6604            	  1659:     bne.s  __far_z_05_0026
02:00040F16 60000084        	  1660:     jmp  InitMode_EnterRoom
                            	  1661: __far_z_05_0026:
02:00040F1A 5302            	  1662:     subq.b  #1,D2
02:00040F1C 6612            	  1663:     bne  _L_z05_InitMode4_CheckSub2
                            	  1664:     ; Submode 1.
                            	  1665:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1666:     ;
                            	  1667:     ; TODO:
                            	  1668:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1669:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1670:     ; A positive value triggers this submode 1 to transfer
                            	  1671:     ; the whole play area.
                            	  1672:     ;
                            	  1673:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1674:     ; a good state reflecting the new room. The only thing
                            	  1675:     ; needed is possibly to brighten the room by way of
                            	  1676:     ; changing the palette.
                            	  1677:     ;
                            	  1678:     ; So why does mode 7 trigger this?
                            	  1679:     ; Is there another mode that truly needs this behavior?
                            	  1680:     ;
02:00040F1E 102C00E9        	  1681:     move.b  ($00E9,A4),D0
02:00040F22 6B06            	  1682:     bmi  _anon_z05_40
02:00040F24 61003610        	  1683:     jsr     CopyNextRowToTransferBuf
02:00040F28 6404            	  1684:     bcc  _L_z05_InitMode4_Exit
                            	  1685: _anon_z05_40:
02:00040F2A 522C0013        	  1686:     addq.b  #1,($0013,A4)
                            	  1687:     even
                            	  1688: _L_z05_InitMode4_Exit:
02:00040F2E 4E75            	  1689:     rts
                            	  1690: 
                            	  1691:     even
                            	  1692: _L_z05_InitMode4_CheckSub2:
02:00040F30 5302            	  1693:     subq.b  #1,D2
02:00040F32 6702            	  1694:     beq.s  __far_z_05_0027
02:00040F34 6058            	  1695:     jmp  InitMode4_Sub3
                            	  1696: __far_z_05_0027:
                            	  1697:     ; Submode 2.
                            	  1698:     ;
02:00040F36 7600            	  1699:     moveq   #0,D3
02:00040F38 162C00EB        	  1700:     move.b  ($00EB,A4),D3
02:00040F3C 6100443C        	  1701:     jsr     IsDarkRoom_Bank5
02:00040F40 6702            	  1702:     beq.s  __far_z_05_0028
02:00040F42 6052            	  1703:     jmp  InitMode4_GoToSub0
                            	  1704: __far_z_05_0028:
                            	  1705:     ; This is a light room.
                            	  1706:     ; See if we have to brighten it after leaving a dark room.
                            	  1707:     ;
02:00040F44 102C0098        	  1708:     move.b  ($0098,A4),D0
02:00040F48 61004278        	  1709:     jsr     CalcNextRoomByDir
                            	  1710:     ; Subtract RoomId from next room ID that was calculated
                            	  1711:     ; to get room ID offset in that direction.
02:00040F4C 003C0011        	  1712:     ori     #$11,CCR  ; SEC: set C+X
02:00040F50 122C00EB        	  1713:     move.b  ($00EB,A4),D1
02:00040F54 0A3C0010        	  1714:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040F58 9101            	  1715:     subx.b  D1,D0   ; SBC RoomId
02:00040F5A 0A3C0010        	  1716:     eori    #$10,CCR  ; restore X = 6502 C
02:00040F5E 4EB900030C6E    	  1717:     jsr     Negate
02:00040F64 023C00EE        	  1718:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040F68 122C00EB        	  1719:     move.b  ($00EB,A4),D1
02:00040F6C D101            	  1720:     addx.b  D1,D0   ; ADC RoomId
02:00040F6E 7600            	  1721:     moveq   #0,D3
02:00040F70 1600            	  1722:     move.b  D0,D3
02:00040F72 61004406        	  1723:     jsr     IsDarkRoom_Bank5
02:00040F76 6602            	  1724:     bne.s  __far_z_05_0029
02:00040F78 601C            	  1725:     jmp  InitMode4_GoToSub0
                            	  1726: __far_z_05_0029:
                            	  1727:     ; The previous room was dark.
                            	  1728:     ;
02:00040F7A 102C051F        	  1729:     move.b  ($051F,A4),D0
02:00040F7E 6702            	  1730:     beq.s  __far_z_05_0030
02:00040F80 6014            	  1731:     jmp  InitMode4_GoToSub0
                            	  1732: __far_z_05_0030:
02:00040F82 103C00C0        	  1733:     move.b  #$C0,D0
                            	  1734: ; Params:
                            	  1735: ; A: start index of cycle
                            	  1736: ;
                            	  1737:     even
                            	  1738: SetFadeCycleAndAdvanceSubmode:
02:00040F86 4EF90002C036    	  1739:     jmp     c_set_fade_cycle_advance_submode
                            	  1740: 
                            	  1741: _anon_z05_41:
02:00040F8C 4E75            	  1742:     rts
                            	  1743: 
                            	  1744:     even
                            	  1745: InitMode4_Sub3:
                            	  1746:     ; Submode 3.
                            	  1747:     ;
02:00040F8E 4EB900031438    	  1748:     jsr     AnimateWorldFading
02:00040F94 66F6            	  1749:     bne  _anon_z05_41
                            	  1750:     even
                            	  1751: InitMode4_GoToSub0:
02:00040F96 4EF90002B9E8    	  1752:     jmp     c_init_mode4_go_to_sub0
                            	  1753: 
                            	  1754: InitMode_EnterRoom:
02:00040F9C 4EB90004B132    	  1755:     jsr     DrawSpritesBetweenRooms
02:00040FA2 4EB90004B150    	  1756:     jsr     ResetPlayerState
                            	  1757:     ; Reset [0300] to [051F].
                            	  1758:     ;
02:00040FA8 7005            	  1759:     moveq   #5,D0
02:00040FAA 761F            	  1760:     moveq   #31,D3
02:00040FAC 4EB90004A98A    	  1761:     jsr     ClearRam0300UpTo
                            	  1762:     ; Reset door trigger info.
                            	  1763:     ;
02:00040FB2 7000            	  1764:     moveq   #0,D0
02:00040FB4 19400054        	  1765:     move.b  D0,($0054,A4)
02:00040FB8 19400055        	  1766:     move.b  D0,($0055,A4)
                            	  1767:     ; Store level block attribute byte F for convenience.
                            	  1768:     ;
02:00040FBC 7600            	  1769:     moveq   #0,D3
02:00040FBE 162C00EB        	  1770:     move.b  ($00EB,A4),D3
02:00040FC2 41F900FF6AFE    	  1771:     lea     (NES_SRAM+$0AFE).l,A0
02:00040FC8 10303000        	  1772:     move.b  (A0,D3.W),D0
02:00040FCC 194004CD        	  1773:     move.b  D0,($04CD,A4)
02:00040FD0 61003A4C        	  1774:     jsr     ResetInvObjState
                            	  1775:     ; There's more than one way to enter a room.
                            	  1776:     ;
                            	  1777:     ; 1: Out of a cave, dungeon, or cellar
                            	  1778:     ;     a. Walking exit
                            	  1779:     ;     b. Next to stairs
