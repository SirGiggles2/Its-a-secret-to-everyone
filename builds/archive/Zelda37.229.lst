02:00044D74 522C0057        	  8284:     addq.b  #1,($0057,A4)
                            	  8285:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8286:     ; object direction and input direction to last walkable direction
                            	  8287:     ; found, and set Link's speed.
                            	  8288:     ;
                            	  8289:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8290:     ;
02:00044D78 7400            	  8291:     moveq   #0,D2
02:00044D7A 102C000D        	  8292:     move.b  ($000D,A4),D0
02:00044D7E 0C030001        	  8293:     cmpi.b  #$01,D3
