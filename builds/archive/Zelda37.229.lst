02:00031ED4 10303000        	  6783:     move.b  (A0,D3.W),D0
02:00031ED8 E308            	  6784:     lsl.b  #1,D0   ; ASL A
02:00031EDA 65F2            	  6785:     bcs  _anon_z01_87
