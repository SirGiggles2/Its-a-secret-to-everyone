02:0003CEF2 10302000        	  7896:     move.b  (A0,D2.W),D0
02:0003CEF6 0A00000C        	  7897:     eori.b #$0C,D0
02:0003CEFA 41EC0098        	  7898:     lea     ($0098,A4),A0
