02:0002E47A 102C067E        	   888:     move.b  ($067E,A4),D0
02:0002E47E 023C00EE        	   889:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E482 123C0014        	   890:     move.b  #$14,D1
02:0002E486 D101            	   891:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E488 1940067E        	   892:     move.b  D0,($067E,A4)
                            	   893:     ; Mark this secret taken.
