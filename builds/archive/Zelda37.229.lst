02:0002CC82 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002CC84 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002CC88 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002CC8A 7000            	   323:     moveq   #0,D0
02:0002CC8C 6100E1E6        	   324:     jsr     _apu_write_4015  ; APU/IO write
