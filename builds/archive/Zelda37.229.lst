                            	  4317: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  4318:     ;
                            	  4319:     ;
                            	  4320:     ; [0E] holds reverse index of doorway direction found.
                            	  4321:     ;
02:000421EA 1943000E        	  4322:     move.b  D3,($000E,A4)
                            	  4323:     ; Store input direction in [02] and [0C].
                            	  4324:     ;
