02:00031EF2 023C00EE        	  6799:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031EF6 123C0004        	  6800:     move.b  #$04,D1
02:00031EFA D101            	  6801:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031EFC 19400004        	  6802:     move.b  D0,($0004,A4)
                            	  6803:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6804:     ;
02:00031F00 41EC0084        	  6805:     lea     ($0084,A4),A0
02:00031F04 10303000        	  6806:     move.b  (A0,D3.W),D0
02:00031F08 023C00EE        	  6807:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F0C 123C0008        	  6808:     move.b  #$08,D1
02:00031F10 D101            	  6809:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6810: ; Params:
                            	  6811: ; A: weapon object mid Y
                            	  6812: ; X: monster object slot
                            	  6813: ; Y: weapon object slot
                            	  6814: ; [00]: weapon object slot
                            	  6815: ; [02]: monster object mid X
                            	  6816: ; [03]: monster object mid Y
                            	  6817: ; [04]: weapon object mid X
                            	  6818: ; [07]: damage points
                            	  6819: ; [09]: damage type
                            	  6820: ; [0D]: horizontal threshold
                            	  6821: ; [0E]: vertical threshold
                            	  6822: ;
