02:0002BFAA 08000008        	  2022:     btst    #8,D0
02:0002BFAE 670A            	  2023:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2024:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2025:     eori    #$01,CCR
02:0002BFB8 4E75            	  2026:     rts
                            	  2027: .cc_cnras:
02:0002BFBA 023C00FE        	  2028:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2029:     eori    #$01,CCR
02:0002BFC2 4E75            	  2030:     rts
                            	  2031: 
