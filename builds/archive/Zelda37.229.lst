02:0003E6A8 6602            	 11049:     bne.s  __far_z_04_0107
02:0003E6AA 60B0            	 11050:     jmp  Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions
                            	 11051: __far_z_04_0107:
                            	 11052:     ; The segment is not a head nor bottom. So, we can use a
                            	 11053:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11054:     ; that is drawn under Link and the heads.
                            	 11055:     ;
02:0003E6AC 4EB900031AB0    	 11056:     jsr     Anim_WriteLevelPaletteSprite
                            	 11057:     even
                            	 11058: Gleeok_CheckCollisions:
                            	 11059:     ; If this segment is not the head nor the bottom of the neck,
                            	 11060:     ; then loop again to process the next segment.
                            	 11061:     ;
                            	 11062:     ; This kind of segment is only drawn, and is not checked
                            	 11063:     ; for object collisions.
                            	 11064:     ;
02:0003E6B2 0C020005        	 11065:     cmpi.b  #$05,D2
02:0003E6B6 670A            	 11066:     beq  _anon_z04_141
02:0003E6B8 0C020001        	 11067:     cmpi.b  #$01,D2
02:0003E6BC 6704            	 11068:     beq  _anon_z04_141
02:0003E6BE 6000010C        	 11069:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11070: 
                            	 11071: _anon_z04_141:
02:0003E6C2 4EB900031B36    	 11072:     jsr     CheckMonsterCollisions
                            	 11073:     ; If this segment was harmed, then set the writhing counter,
                            	 11074:     ; and the animation counter to its lower value.
                            	 11075:     ;
02:0003E6C8 41EC00C0        	 11076:     lea     ($00C0,A4),A0
02:0003E6CC 10302000        	 11077:     move.b  (A0,D2.W),D0
02:0003E6D0 670A            	 11078:     beq  _anon_z04_142
02:0003E6D2 7006            	 11079:     moveq   #6,D0
02:0003E6D4 194004E6        	 11080:     move.b  D0,($04E6,A4)
02:0003E6D8 19400510        	 11081:     move.b  D0,($0510,A4)
                            	 11082: _anon_z04_142:
02:0003E6DC 4EB90004B764    	 11083:     jsr     ResetShoveInfo
                            	 11084:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11085:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11086:     ;
02:0003E6E2 0C020001        	 11087:     cmpi.b  #$01,D2
02:0003E6E6 670000DE        	 11088:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E6EA 6100B130        	 11089:     jsr     PlayBossHitCryIfNeeded
                            	 11090:     ; If this neck has not died, then go loop again.
                            	 11091:     ;
02:0003E6EE 41EC0405        	 11092:     lea     ($0405,A4),A0
02:0003E6F2 10302000        	 11093:     move.b  (A0,D2.W),D0
02:0003E6F6 670000D4        	 11094:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11095:     ; This neck died. So, prepare to make a flying head.
                            	 11096:     ;
02:0003E6FA 7060            	 11097:     moveq   #96,D0
02:0003E6FC 41EC0485        	 11098:     lea     ($0485,A4),A0
02:0003E700 11802000        	 11099:     move.b  D0,(A0,D2.W)
02:0003E704 1002            	 11100:     move.b  D2,D0
02:0003E706 1B00            	 11101:     move.b  D0,-(A5)  ; PHA
                            	 11102:     ; If the segment is not a head, then skip making a flying head.
                            	 11103:     ;
                            	 11104:     ; TODO:
                            	 11105:     ; But how can we get here in this case, since earlier branches
                            	 11106:     ; would have been taken to skip all this for all other segments?
                            	 11107:     ;
02:0003E708 0C020005        	 11108:     cmpi.b  #$05,D2
02:0003E70C 663C            	 11109:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11110:     ; The flying head will go in slot (neck index + 7).
                            	 11111:     ; Switch the X register to it.
                            	 11112:     ;
02:0003E70E 102C04D7        	 11113:     move.b  ($04D7,A4),D0
02:0003E712 023C00EE        	 11114:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E716 123C0007        	 11115:     move.b  #$07,D1
02:0003E71A D101            	 11116:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E71C 7400            	 11117:     moveq   #0,D2
02:0003E71E 1400            	 11118:     move.b  D0,D2
                            	 11119:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11120:     ;
02:0003E720 103C00FF        	 11121:     move.b  #$FF,D0
02:0003E724 41EC0492        	 11122:     lea     ($0492,A4),A0
02:0003E728 11802000        	 11123:     move.b  D0,(A0,D2.W)
                            	 11124:     ; Copy the original head's coordinates to it.
                            	 11125:     ;
02:0003E72C 102C0075        	 11126:     move.b  ($0075,A4),D0
02:0003E730 19802070        	 11127:     move.b  D0,($70,A4,D2.W)
02:0003E734 102C0089        	 11128:     move.b  ($0089,A4),D0
02:0003E738 41EC0084        	 11129:     lea     ($0084,A4),A0
02:0003E73C 11802000        	 11130:     move.b  D0,(A0,D2.W)
                            	 11131:     ; Set object type $46 (flying head).
                            	 11132:     ;
02:0003E740 7046            	 11133:     moveq   #70,D0
02:0003E742 41EC034F        	 11134:     lea     ($034F,A4),A0
02:0003E746 11802000        	 11135:     move.b  D0,(A0,D2.W)
                            	 11136:     even
                            	 11137: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E74A 101D            	 11138:     move.b  (A5)+,D0  ; PLA
02:0003E74C 7400            	 11139:     moveq   #0,D2
02:0003E74E 1400            	 11140:     move.b  D0,D2
                            	 11141:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11142:     ;
02:0003E750 102C04D7        	 11143:     move.b  ($04D7,A4),D0
02:0003E754 E308            	 11144:     lsl.b  #1,D0   ; ASL A
02:0003E756 E308            	 11145:     lsl.b  #1,D0   ; ASL A
02:0003E758 E308            	 11146:     lsl.b  #1,D0   ; ASL A
02:0003E75A 7600            	 11147:     moveq   #0,D3
02:0003E75C 1600            	 11148:     move.b  D0,D3
02:0003E75E 103C00F8        	 11149:     move.b  #$F8,D0
02:0003E762 41EC0200        	 11150:     lea     ($0200,A4),A0
02:0003E766 11803000        	 11151:     move.b  D0,(A0,D3.W)
02:0003E76A 41EC0220        	 11152:     lea     ($0220,A4),A0
02:0003E76E 11803000        	 11153:     move.b  D0,(A0,D3.W)
                            	 11154:     ; Add the bit for this neck to the dead neck mask.
                            	 11155:     ; Copy it to [00].
                            	 11156:     ;
02:0003E772 7600            	 11157:     moveq   #0,D3
02:0003E774 162C04D7        	 11158:     move.b  ($04D7,A4),D3
02:0003E778 41F90004AB28    	 11159:     lea     (LevelMasks).l,A0
02:0003E77E 10303000        	 11160:     move.b  (A0,D3.W),D0
02:0003E782 122C0511        	 11161:     move.b  ($0511,A4),D1
02:0003E786 8001            	 11162:     or.b  D1,D0
02:0003E788 19400511        	 11163:     move.b  D0,($0511,A4)
02:0003E78C 1880            	 11164:     move.b  D0,($0000,A4)
                            	 11165:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11166:     ; Count them up, and store the amount in [00].
                            	 11167:     ;
02:0003E78E 7000            	 11168:     moveq   #0,D0
02:0003E790 7604            	 11169:     moveq   #4,D3
                            	 11170: _anon_z04_143:
02:0003E792 1214            	 11171:     move.b  ($0000,A4),D1
02:0003E794 E209            	 11172:     lsr.b  #1,D1   ; LSR $00
02:0003E796 1881            	 11173:     move.b  D1,($0000,A4)
02:0003E798 123C0000        	 11174:     move.b  #$00,D1
02:0003E79C D101            	 11175:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E79E 5303            	 11176:     subq.b  #1,D3
02:0003E7A0 66F0            	 11177:     bne  _anon_z04_143
02:0003E7A2 1880            	 11178:     move.b  D0,($0000,A4)
                            	 11179:     ; Compare the number of dead necks to the original number
                            	 11180:     ; (object type - $41).
                            	 11181:     ;
02:0003E7A4 102C0350        	 11182:     move.b  ($0350,A4),D0
02:0003E7A8 003C0011        	 11183:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7AC 123C0041        	 11184:     move.b  #$41,D1
02:0003E7B0 0A3C0010        	 11185:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7B4 9101            	 11186:     subx.b  D1,D0   ; SBC #$41
02:0003E7B6 0A3C0010        	 11187:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7BA 1214            	 11188:     move.b  ($0000,A4),D1
02:0003E7BC B001            	 11189:     cmp.b   D1,D0
                            	 11190:     ; If they're equal, then go handle the whole boss dying.
                            	 11191:     ;
02:0003E7BE 671C            	 11192:     beq  _L_z04_Gleeok_CheckCollisions_BossDied
                            	 11193:     ; Else reset object metastate of the segment, and return.
                            	 11194:     ;
02:0003E7C0 4EF90004D5E8    	 11195:     jmp     ResetObjMetastate
                            	 11196: 
                            	 11197:     even
                            	 11198: _L_z04_Gleeok_CheckCollisions_ResetMetastate:
