02:000362F0 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:000362F2 102C045F        	  4579:     move.b  ($045F,A4),D0
02:000362F6 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:000362FA 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:000362FE 7000            	  4584:     moveq   #0,D0
02:00036300 1880            	  4585:     move.b  D0,($0000,A4)
02:00036302 7000            	  4586:     moveq   #0,D0
02:00036304 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:00036308 7600            	  4590:     moveq   #0,D3
02:0003630A 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:0003630E 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:00036312 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:00036314 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
