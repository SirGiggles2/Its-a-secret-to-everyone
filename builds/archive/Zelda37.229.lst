                            	  3052:     ; along this axis. Go see about moving vertically.
                            	  3053:     ;
02:000303EE 7601            	  3054:     moveq   #1,D3
02:000303F0 102C0070        	  3055:     move.b  ($0070,A4),D0
02:000303F4 12342070        	  3056:     move.b  ($70,A4,D2.W),D1
02:000303F8 B001            	  3057:     cmp.b   D1,D0
