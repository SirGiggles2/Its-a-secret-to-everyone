                            	   688:     ; Store in [00] the type of projectile the monster will throw.
                            	   689:     ;
02:00039BC0 1880            	   690:     move.b  D0,($0000,A4)
                            	   691:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   692:     ;
02:00039BC2 102C066C        	   693:     move.b  ($066C,A4),D0
02:00039BC6 1234203D        	   694:     move.b  ($3D,A4,D2.W),D1
02:00039BCA 8001            	   695:     or.b  D1,D0
02:00039BCC 6672            	   696:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   697:     ; Try to shoot. Return, if it failed.
