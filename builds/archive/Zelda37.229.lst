                            	  7642: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD16 101D            	  7643:     move.b  (A5)+,D0  ; PLA
02:0003CD18 7600            	  7644:     moveq   #0,D3
02:0003CD1A 1600            	  7645:     move.b  D0,D3
                            	  7646:     ; If facing vertically, then return. There's no other side to draw.
                            	  7647:     ;
02:0003CD1C 41EC0098        	  7648:     lea     ($0098,A4),A0
02:0003CD20 10302000        	  7649:     move.b  (A0,D2.W),D0
02:0003CD24 02000003        	  7650:     andi.b #$03,D0
02:0003CD28 6602            	  7651:     bne.s  __far_z_04_0072
02:0003CD2A 602E            	  7652:     jmp  L11B00_Exit
                            	  7653: __far_z_04_0072:
                            	  7654:     ; Else draw the right side.
                            	  7655:     ;
                            	  7656:     ; Keep the Y coordinate in [01].
                            	  7657:     ; But, store (X + $10) in [00].
                            	  7658:     ;
02:0003CD2C 10342070        	  7659:     move.b  ($70,A4,D2.W),D0
02:0003CD30 023C00EE        	  7660:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD34 123C0010        	  7661:     move.b  #$10,D1
02:0003CD38 D101            	  7662:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD3A 1880            	  7663:     move.b  D0,($0000,A4)
02:0003CD3C 6114            	  7664:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7665:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7666:     ;
                            	  7667:     ; So, if we had animation frame 1, direction left:
                            	  7668:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7669:     ; - frame image index = 6 (1 + 5)
                            	  7670:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7671:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7672:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7673:     ;
                            	  7674:     ; So, 3 would have been the frame number used above for
                            	  7675:     ; the left side.
                            	  7676:     ;
                            	  7677:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7678:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7679:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7680:     ; on the right.
                            	  7681:     ;
02:0003CD3E 41F90003CC34    	  7682:     lea     (DodongoFrameImages).l,A0
02:0003CD44 10303000        	  7683:     move.b  (A0,D3.W),D0
02:0003CD48 0A000001        	  7684:     eori.b #$01,D0
02:0003CD4C 4EF9000317BA    	  7685:     jmp     DrawObjectNotMirrored
                            	  7686: 
                            	  7687: ; Returns:
                            	  7688: ; A: 3
                            	  7689: ; [04]: left sprite attributes
                            	  7690: ; [05]: right sprite attributes
                            	  7691: ;
                            	  7692:     even
                            	  7693: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD52 7003            	  7694:     moveq   #3,D0
02:0003CD54 4EB900031AAC    	  7695:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7696:     even
