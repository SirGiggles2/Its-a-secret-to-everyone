02:0003AFDA 10303000        	  3536:     move.b  (A0,D3.W),D0
02:0003AFDE 41EC03BC        	  3537:     lea     ($03BC,A4),A0
02:0003AFE2 11802000        	  3538:     move.b  D0,(A0,D2.W)
02:0003AFE6 41F90003ADEA    	  3539:     lea     (RedLeeverStateTimes).l,A0
02:0003AFEC 10303000        	  3540:     move.b  (A0,D3.W),D0
