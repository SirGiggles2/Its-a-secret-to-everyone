02:00030E14 0A000001        	  4604:     eori.b #$01,D0
02:00030E18 7600            	  4605:     moveq   #0,D3
02:00030E1A 1600            	  4606:     move.b  D0,D3
02:00030E1C 41EC00AC        	  4607:     lea     ($00AC,A4),A0
02:00030E20 10303000        	  4608:     move.b  (A0,D3.W),D0
