                            	  5147: DrawCredits:
                            	  5148:     ; Make a transfer record of a full row of blank tiles.
                            	  5149:     ;
02:0003690E 761F            	  5150:     moveq   #31,D3
02:00036910 7024            	  5151:     moveq   #36,D0
                            	  5152: _anon_z02_41:
02:00036912 41EC0305        	  5153:     lea     ($0305,A4),A0
02:00036916 11803000        	  5154:     move.b  D0,(A0,D3.W)
02:0003691A 5303            	  5155:     subq.b  #1,D3
02:0003691C 6AF4            	  5156:     bpl  _anon_z02_41
                            	  5157:     ; No wall tiles go in row 0.
                            	  5158:     ;
02:0003691E 102C050A        	  5159:     move.b  ($050A,A4),D0
02:00036922 672C            	  5160:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5161:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5162:     ; Rows 2 to $2D get side walls.
                            	  5163:     ;
02:00036924 0C000001        	  5164:     cmpi.b  #$01,D0
02:00036928 6708            	  5165:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:0003692A 0C00002E        	  5166:     cmpi.b  #$2E,D0
02:0003692E 6514            	  5167:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00036930 661E            	  5168:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5169:     even
