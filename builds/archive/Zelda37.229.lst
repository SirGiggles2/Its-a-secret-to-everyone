02:0002E9C4 1B00            	  1669:     move.b  D0,-(A5)  ; PHA
02:0002E9C6 020000F0        	  1670:     andi.b #$F0,D0
02:0002E9CA 003C0011        	  1671:     ori     #$11,CCR  ; SEC: set C+X
02:0002E9CE 123C0010        	  1672:     move.b  #$10,D1
02:0002E9D2 0A3C0010        	  1673:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E9D6 9101            	  1674:     subx.b  D1,D0   ; SBC #$10
02:0002E9D8 0A3C0010        	  1675:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E9DC 1880            	  1676:     move.b  D0,($0000,A4)
                            	  1677:     ; Get (HeartValues - 1 heart)
                            	  1678:     ;
02:0002E9DE 101D            	  1679:     move.b  (A5)+,D0  ; PLA
02:0002E9E0 0200000F        	  1680:     andi.b #$0F,D0
02:0002E9E4 003C0011        	  1681:     ori     #$11,CCR  ; SEC: set C+X
02:0002E9E8 123C0001        	  1682:     move.b  #$01,D1
02:0002E9EC 0A3C0010        	  1683:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E9F0 9101            	  1684:     subx.b  D1,D0   ; SBC #$01
02:0002E9F2 0A3C0010        	  1685:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1686:     ; If the result is negative, then make the full hearts 0.
                            	  1687:     ;
02:0002E9F6 6A02            	  1688:     bpl  _anon_z01_19
02:0002E9F8 7000            	  1689:     moveq   #0,D0
