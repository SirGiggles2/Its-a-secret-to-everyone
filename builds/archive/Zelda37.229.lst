                            	   595: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   596: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   597:     move.l  D0,-(SP)
02:0002B6C8 7200            	   598:     moveq   #0,D1
02:0002B6CA 1202            	   599:     move.b  D2,D1
02:0002B6CC 2F01            	   600:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   601:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   602:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   603:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   604:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   605:     addq.l  #8,SP
02:0002B6E2 201F            	   606:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   607:     rts
                            	   608: 
                            	   609: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   610: c_add_door_flags:
02:0002B6E6 4EF900000000    	   611:     jmp     z05_add_door_flags
