02:0004AED2 D101            	  2434:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0004AED4 19400301        	  2435:     move.b  D0,($0301,A4)
02:0004AED8 101D            	  2436:     move.b  (A5)+,D0  ; PLA
02:0004AEDA 7400            	  2437:     moveq   #0,D2
02:0004AEDC 1400            	  2438:     move.b  D0,D2
02:0004AEDE 7005            	  2439:     moveq   #5,D0
02:0004AEE0 6100285A        	  2440:     jsr     SwitchBank
