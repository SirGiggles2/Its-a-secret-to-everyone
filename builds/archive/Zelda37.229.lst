02:0002E126 102C001A        	   403:     move.b  ($001A,A4),D0
02:0002E12A 02000002        	   404:     andi.b #$02,D0
02:0002E12E 6702            	   405:     beq  _anon_z01_1
02:0002E130 7632            	   406:     moveq   #50,D3
