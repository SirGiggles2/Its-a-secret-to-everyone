02:0003CDDA 7000            	  7745:     moveq   #0,D0
02:0003CDDC 1980203D        	  7746:     move.b  D0,($3D,A4,D2.W)
02:0003CDE0 7008            	  7747:     moveq   #8,D0
02:0003CDE2 4EB90004CDDA    	  7748:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7749:     ; If facing left, then enable horizontal flipping.
                            	  7750:     ;
02:0003CDE8 41EC0098        	  7751:     lea     ($0098,A4),A0
02:0003CDEC 10302000        	  7752:     move.b  (A0,D2.W),D0
02:0003CDF0 0C000002        	  7753:     cmpi.b  #$02,D0
02:0003CDF4 6604            	  7754:     bne  _anon_z04_94
02:0003CDF6 522C000F        	  7755:     addq.b  #1,($000F,A4)
                            	  7756: _anon_z04_94:
                            	  7757:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7758:     ; This is the base frame image.
                            	  7759:     ;
02:0003CDFA E208            	  7760:     lsr.b  #1,D0   ; LSR A
02:0003CDFC E208            	  7761:     lsr.b  #1,D0   ; LSR A
                            	  7762:     ; If movement frame = 1, add 3 to frame image to access
                            	  7763:     ; the second animation frame's images.
                            	  7764:     ;
02:0003CDFE 7600            	  7765:     moveq   #0,D3
02:0003CE00 41EC03E4        	  7766:     lea     ($03E4,A4),A0
02:0003CE04 16302000        	  7767:     move.b  (A0,D2.W),D3
02:0003CE08 671E            	  7768:     beq  _anon_z04_95
02:0003CE0A 023C00EE        	  7769:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE0E 123C0003        	  7770:     move.b  #$03,D1
02:0003CE12 D101            	  7771:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7772:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7773:     ;
                            	  7774:     ; Down has two frame images, but up only has one. By flipping
                            	  7775:     ; horizontally, you get two frame images.
                            	  7776:     ;
02:0003CE14 7600            	  7777:     moveq   #0,D3
02:0003CE16 41EC0098        	  7778:     lea     ($0098,A4),A0
02:0003CE1A 16302000        	  7779:     move.b  (A0,D2.W),D3
02:0003CE1E 0C030008        	  7780:     cmpi.b  #$08,D3
02:0003CE22 6604            	  7781:     bne  _anon_z04_95
02:0003CE24 522C000F        	  7782:     addq.b  #1,($000F,A4)
