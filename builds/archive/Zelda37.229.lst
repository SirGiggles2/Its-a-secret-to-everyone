02:000403A6 194000E2        	   697:     move.b  D0,($00E2,A4)
02:000403AA 6404            	   698:     bcc  _anon_z05_10
02:000403AC 532C0058        	   699:     subq.b  #1,($0058,A4)
                            	   700: _anon_z05_10:
02:000403B0 0C0000E0        	   701:     cmpi.b  #$E0,D0
