                            	  6258: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6259:     ; Digdogger is big, but room boundary checks and
                            	  6260:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6261:     ; Therefore, we have to check these things four times,
                            	  6262:     ; in different corners of the boss.
                            	  6263:     ;
                            	  6264:     ; Loop 4 times, from 0 to 3.
                            	  6265:     ;
02:0003C304 7600            	  6266:     moveq   #0,D3
02:0003C306 41EC0478        	  6267:     lea     ($0478,A4),A0
02:0003C30A 16302000        	  6268:     move.b  (A0,D2.W),D3
                            	  6269:     ; Change the coordinates to one corner.
                            	  6270:     ;
02:0003C30E 10342070        	  6271:     move.b  ($70,A4,D2.W),D0
02:0003C312 023C00EE        	  6272:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C316 41F90003C1CA    	  6273:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C31C 12303000        	  6274:     move.b  (A0,D3.W),D1
02:0003C320 D101            	  6275:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C322 19802070        	  6276:     move.b  D0,($70,A4,D2.W)
02:0003C326 41EC0084        	  6277:     lea     ($0084,A4),A0
02:0003C32A 10302000        	  6278:     move.b  (A0,D2.W),D0
02:0003C32E 023C00EE        	  6279:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C332 41F90003C1CE    	  6280:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C338 12303000        	  6281:     move.b  (A0,D3.W),D1
02:0003C33C D101            	  6282:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C33E 41EC0084        	  6283:     lea     ($0084,A4),A0
02:0003C342 11802000        	  6284:     move.b  D0,(A0,D2.W)
                            	  6285:     ; Check the room boundary and object collisions in this temporary location.
                            	  6286:     ;
02:0003C346 61003862        	  6287:     jsr     BoundFlyer
02:0003C34A 4EB900031B36    	  6288:     jsr     CheckMonsterCollisions
                            	  6289:     ; Increase the loop index, and loop again until it = 4.
