02:00039ED8 11802000        	  1110:     move.b  D0,(A0,D2.W)
02:00039EDC 10342070        	  1111:     move.b  ($70,A4,D2.W),D0
02:00039EE0 023C00EE        	  1112:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039EE4 41F900039DD6    	  1113:     lea     (ShotBounceWidths).l,A0
02:00039EEA 12303000        	  1114:     move.b  (A0,D3.W),D1
