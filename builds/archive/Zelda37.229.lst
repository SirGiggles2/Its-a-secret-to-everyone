02:0003BB38 10303000        	  5176:     move.b  (A0,D3.W),D0
02:0003BB3C 1880            	  5177:     move.b  D0,($0000,A4)
02:0003BB3E 41F900031783    	  5178:     lea     (SpriteOffsets+1).l,A0
02:0003BB44 10303000        	  5179:     move.b  (A0,D3.W),D0
                            	  5180:     even
                            	  5181: _L_z04_L_Wallmaster_State1_PatchSprites:
