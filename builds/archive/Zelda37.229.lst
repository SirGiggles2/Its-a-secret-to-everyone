02:00041954 6710            	  3062:     beq  _anon_z05_76
02:00041956 1003            	  3063:     move.b  D3,D0
02:00041958 023C00EE        	  3064:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004195C 123C0004        	  3065:     move.b  #$04,D1
