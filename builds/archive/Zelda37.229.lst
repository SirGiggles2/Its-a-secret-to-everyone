02:0004C55A 194000AC        	  5721:     move.b  D0,($00AC,A4)
                            	  5722:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5723:     ; up the new state.
                            	  5724:     ;
02:0004C55E 7001            	  5725:     moveq   #1,D0
02:0004C560 194003D0        	  5726:     move.b  D0,($03D0,A4)
