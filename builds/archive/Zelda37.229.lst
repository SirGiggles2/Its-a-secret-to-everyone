                            	 12355: __far_z_04_0125:
                            	 12356:     ; State = 0.
                            	 12357:     ;
                            	 12358:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12359:     ; This is the only patra child shown in the first fame.
                            	 12360:     ;
02:0003F052 0C020002        	 12361:     cmpi.b  #$02,D2
02:0003F056 6732            	 12362:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12363:     ; The patra child in slot 2 is the last one to be updated.
                            	 12364:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12365:     ;
                            	 12366:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12367:     ; shown.
                            	 12368:     ;
02:0003F058 102C00AE        	 12369:     move.b  ($00AE,A4),D0
02:0003F05C 6700008E        	 12370:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12371:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12372:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12373:     ;
02:0003F060 1002            	 12374:     move.b  D2,D0
                            	 12375:     ; Subtract 3 from the object slot to get the angle where the
                            	 12376:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12377:     ;
