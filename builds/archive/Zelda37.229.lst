02:000303D2 41EC0084        	  3042:     lea     ($0084,A4),A0
02:000303D6 12302000        	  3043:     move.b  (A0,D2.W),D1
02:000303DA 0A3C0010        	  3044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000303DE 9101            	  3045:     subx.b  D1,D0   ; SBC ObjY,X
02:000303E0 0A3C0010        	  3046:     eori    #$10,CCR  ; restore X = 6502 C
02:000303E4 61000884        	  3047:     jsr     Abs
02:000303E8 0C00000E        	  3048:     cmpi.b  #$0E,D0
02:000303EC 644C            	  3049:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  3050:     ; Determine the horizontal direction toward Link;
