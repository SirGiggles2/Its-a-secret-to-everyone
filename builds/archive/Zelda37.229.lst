                            	  5286: 
                            	  5287: ; Params:
                            	  5288: ; [02]: bitmask for target door.
                            	  5289: ;
                            	  5290: ; Returns:
                            	  5291: ; A: door attribute for desired direction in current room.
                            	  5292: ; [01]: same as [02] if found; $10 otherwise
                            	  5293: ; [03]: reverse direction index
                            	  5294: ;
                            	  5295: ; Door bits:
                            	  5296: ; 1: E
                            	  5297: ; 2: W
                            	  5298: ; 4: S
                            	  5299: ; 8: N
                            	  5300: ;
                            	  5301: ;
                            	  5302: ; Start with single-bit mask 1.
                            	  5303:     even
                            	  5304: FindDoorAttrByDoorBit:
02:00043378 7001            	  5305:     moveq   #1,D0
02:0004337A 19400001        	  5306:     move.b  D0,($0001,A4)
02:0004337E 7003            	  5307:     moveq   #3,D0
02:00043380 19400003        	  5308:     move.b  D0,($0003,A4)
                            	  5309:     even
                            	  5310: _L_z05_FindDoorAttrByDoorBit_LoopDoorBit:
02:00043384 7600            	  5311:     moveq   #0,D3
02:00043386 162C00EB        	  5312:     move.b  ($00EB,A4),D3
02:0004338A 41F900FF687E    	  5313:     lea     (NES_SRAM+$087E).l,A0
02:00043390 10303000        	  5314:     move.b  (A0,D3.W),D0
02:00043394 7600            	  5315:     moveq   #0,D3
