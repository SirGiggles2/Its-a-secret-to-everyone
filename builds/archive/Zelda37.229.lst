02:0004BFE2 102C0015        	  4904:     move.b  ($0015,A4),D0
02:0004BFE6 02000003        	  4905:     andi.b #$03,D0
02:0004BFEA 41F90004C2A6    	  4906:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BFF0 12303000        	  4907:     move.b  (A0,D3.W),D1
02:0004BFF4 8001            	  4908:     or.b  D1,D0
02:0004BFF6 4EB900031AAC    	  4909:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4910:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
