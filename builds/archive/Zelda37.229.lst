02:0003F842 1880            	 13472:     move.b  D0,($0000,A4)
                            	 13473:     ; If the global kill count = $10, set the dropped item to a fairy.
                            	 13474:     ;
02:0003F844 7023            	 13475:     moveq   #35,D0
02:0003F846 7600            	 13476:     moveq   #0,D3
02:0003F848 162C0627        	 13477:     move.b  ($0627,A4),D3
02:0003F84C 0C030010        	 13478:     cmpi.b  #$10,D3
02:0003F850 6716            	 13479:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13480:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13481:     ; But there is a random chance that the item drop will be canceled.
                            	 13482:     ;
02:0003F852 102C0050        	 13483:     move.b  ($0050,A4),D0
