02:0004C09A 19802070        	  5010:     move.b  D0,($70,A4,D2.W)
02:0004C09E 41EC0084        	  5011:     lea     ($0084,A4),A0
02:0004C0A2 10303000        	  5012:     move.b  (A0,D3.W),D0
02:0004C0A6 41EC0084        	  5013:     lea     ($0084,A4),A0
02:0004C0AA 11802000        	  5014:     move.b  D0,(A0,D2.W)
02:0004C0AE 41EC0098        	  5015:     lea     ($0098,A4),A0
02:0004C0B2 10303000        	  5016:     move.b  (A0,D3.W),D0
02:0004C0B6 41EC0098        	  5017:     lea     ($0098,A4),A0
