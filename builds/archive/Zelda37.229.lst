02:0003CF4C 0C0000A8        	  7945:     cmpi.b  #$A8,D0
02:0003CF50 6502            	  7946:     bcs  _anon_z04_98
02:0003CF52 7607            	  7947:     moveq   #7,D3
                            	  7948: _anon_z04_98:
                            	  7949:     ; Set the vertical speed for the beginning of the jump.
                            	  7950:     ;
02:0003CF54 41F90003CE48    	  7951:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
