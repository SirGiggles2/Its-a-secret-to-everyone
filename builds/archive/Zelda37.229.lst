02:00039C0E 41EC03BC        	   730:     lea     ($03BC,A4),A0
02:00039C12 11803000        	   731:     move.b  D0,(A0,D3.W)
                            	   732:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   733:     ;
