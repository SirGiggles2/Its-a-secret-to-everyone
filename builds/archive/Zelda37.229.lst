02:0003DDFA 662C            	  9876:     bne  _L_z04_UpdateGohma_Move
                            	  9877:     ; If Random:
                            	  9878:     ;   >= $B0: right
                            	  9879:     ;   >= $60: left
                            	  9880:     ;   Else:   down
                            	  9881:     ;
02:0003DDFC 7001            	  9882:     moveq   #1,D0
02:0003DDFE 7600            	  9883:     moveq   #0,D3
02:0003DE00 16342018        	  9884:     move.b  ($18,A4,D2.W),D3
02:0003DE04 0C0300B0        	  9885:     cmpi.b  #$B0,D3
02:0003DE08 640A            	  9886:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE0A E308            	  9887:     lsl.b  #1,D0   ; ASL A
02:0003DE0C 0C030060        	  9888:     cmpi.b  #$60,D3
02:0003DE10 6402            	  9889:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE12 E308            	  9890:     lsl.b  #1,D0   ; ASL A
                            	  9891:     even
                            	  9892: _L_z04_UpdateGohma_ChangeDir:
02:0003DE14 41EC0098        	  9893:     lea     ($0098,A4),A0
02:0003DE18 11802000        	  9894:     move.b  D0,(A0,D2.W)
                            	  9895:     ; Now we can go straight without changing direction for some time.
                            	  9896:     ;
02:0003DE1C 41EC0451        	  9897:     lea     ($0451,A4),A0
02:0003DE20 52302000        	  9898:     addq.b  #1,(A0,D2.W)
                            	  9899:     ; Go animate the eye.
                            	  9900:     ;
02:0003DE24 600000C6        	  9901:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9902: 
                            	  9903:     even
                            	  9904: _L_z04_UpdateGohma_Move:
                            	  9905:     ; Add $80 to the movement accumulator.
                            	  9906:     ;
02:0003DE28 41EC041F        	  9907:     lea     ($041F,A4),A0
02:0003DE2C 10302000        	  9908:     move.b  (A0,D2.W),D0
02:0003DE30 023C00EE        	  9909:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE34 123C0080        	  9910:     move.b  #$80,D1
02:0003DE38 D101            	  9911:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE3A 41EC041F        	  9912:     lea     ($041F,A4),A0
02:0003DE3E 11802000        	  9913:     move.b  D0,(A0,D2.W)
                            	  9914:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9915:     ;
02:0003DE42 640000A8        	  9916:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9917:     ; Increase the distance traveled, and move 1.
                            	  9918:     ;
02:0003DE46 41EC0412        	  9919:     lea     ($0412,A4),A0
02:0003DE4A 52302000        	  9920:     addq.b  #1,(A0,D2.W)
                            	  9921:     ; Set a direction mask in [02], starting with right (1).
                            	  9922:     ;
02:0003DE4E 7001            	  9923:     moveq   #1,D0
02:0003DE50 19400002        	  9924:     move.b  D0,($0002,A4)
                            	  9925:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9926:     ;
02:0003DE54 41EC0098        	  9927:     lea     ($0098,A4),A0
02:0003DE58 10302000        	  9928:     move.b  (A0,D2.W),D0
02:0003DE5C 122C0002        	  9929:     move.b  ($0002,A4),D1
02:0003DE60 C200            	  9930:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE62 6704            	  9931:     beq  _anon_z04_118
02:0003DE64 52342070        	  9932:     addq.b  #1,($70,A4,D2.W)
                            	  9933: _anon_z04_118:
                            	  9934:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9935:     ;
02:0003DE68 122C0002        	  9936:     move.b  ($0002,A4),D1
02:0003DE6C E309            	  9937:     lsl.b  #1,D1   ; ASL $02
02:0003DE6E 19410002        	  9938:     move.b  D1,($0002,A4)
02:0003DE72 122C0002        	  9939:     move.b  ($0002,A4),D1
02:0003DE76 C200            	  9940:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE78 6704            	  9941:     beq  _anon_z04_119
02:0003DE7A 53342070        	  9942:     subq.b  #1,($70,A4,D2.W)
                            	  9943: _anon_z04_119:
                            	  9944:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9945:     ;
02:0003DE7E 122C0002        	  9946:     move.b  ($0002,A4),D1
02:0003DE82 E309            	  9947:     lsl.b  #1,D1   ; ASL $02
02:0003DE84 19410002        	  9948:     move.b  D1,($0002,A4)
02:0003DE88 122C0002        	  9949:     move.b  ($0002,A4),D1
02:0003DE8C C200            	  9950:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE8E 6708            	  9951:     beq  _anon_z04_120
02:0003DE90 41EC0084        	  9952:     lea     ($0084,A4),A0
02:0003DE94 52302000        	  9953:     addq.b  #1,(A0,D2.W)
                            	  9954: _anon_z04_120:
                            	  9955:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9956:     ;
02:0003DE98 122C0002        	  9957:     move.b  ($0002,A4),D1
02:0003DE9C E309            	  9958:     lsl.b  #1,D1   ; ASL $02
02:0003DE9E 19410002        	  9959:     move.b  D1,($0002,A4)
02:0003DEA2 122C0002        	  9960:     move.b  ($0002,A4),D1
02:0003DEA6 C200            	  9961:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEA8 6708            	  9962:     beq  _anon_z04_121
02:0003DEAA 41EC0084        	  9963:     lea     ($0084,A4),A0
02:0003DEAE 53302000        	  9964:     subq.b  #1,(A0,D2.W)
                            	  9965: _anon_z04_121:
                            	  9966:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9967:     ;
02:0003DEB2 41EC0412        	  9968:     lea     ($0412,A4),A0
02:0003DEB6 10302000        	  9969:     move.b  (A0,D2.W),D0
02:0003DEBA 0C000020        	  9970:     cmpi.b  #$20,D0
02:0003DEBE 662C            	  9971:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9972:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9973:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9974:     ;
02:0003DEC0 7000            	  9975:     moveq   #0,D0
02:0003DEC2 41EC0412        	  9976:     lea     ($0412,A4),A0
02:0003DEC6 11802000        	  9977:     move.b  D0,(A0,D2.W)
02:0003DECA 61001D0C        	  9978:     jsr     ReverseObjDir8
02:0003DECE 41EC045E        	  9979:     lea     ($045E,A4),A0
02:0003DED2 10302000        	  9980:     move.b  (A0,D2.W),D0
02:0003DED6 41EC045E        	  9981:     lea     ($045E,A4),A0
02:0003DEDA 52302000        	  9982:     addq.b  #1,(A0,D2.W)
                            	  9983:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9984:     ; should randomly change direction.
                            	  9985:     ;
02:0003DEDE E208            	  9986:     lsr.b  #1,D0   ; LSR A
02:0003DEE0 640A            	  9987:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DEE2 7000            	  9988:     moveq   #0,D0
02:0003DEE4 41EC0451        	  9989:     lea     ($0451,A4),A0
02:0003DEE8 11802000        	  9990:     move.b  D0,(A0,D2.W)
                            	  9991:     even
                            	  9992: _L_z04_UpdateGohma_AnimateEye:
                            	  9993:     ; Animate the eye.
                            	  9994:     ;
                            	  9995:     ; First, if the counter for when to open the eye next = 0, then
                            	  9996:     ; set it to a random value at least $C0; and set the timer for
                            	  9997:     ; keeping the eye open to $80.
                            	  9998:     ;
                            	  9999:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10000:     ; every other frame.
                            	 10001:     ;
02:0003DEEC 41EC042C        	 10002:     lea     ($042C,A4),A0
02:0003DEF0 10302000        	 10003:     move.b  (A0,D2.W),D0
02:0003DEF4 661E            	 10004:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEF6 103C0080        	 10005:     move.b  #$80,D0
02:0003DEFA 41EC0444        	 10006:     lea     ($0444,A4),A0
02:0003DEFE 11802000        	 10007:     move.b  D0,(A0,D2.W)
02:0003DF02 103C00C0        	 10008:     move.b  #$C0,D0
02:0003DF06 12342018        	 10009:     move.b  ($18,A4,D2.W),D1
02:0003DF0A 8001            	 10010:     or.b  D1,D0
02:0003DF0C 41EC042C        	 10011:     lea     ($042C,A4),A0
02:0003DF10 11802000        	 10012:     move.b  D0,(A0,D2.W)
                            	 10013:     even
                            	 10014: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10015:     ; Decrement the next-open-eye counter.
                            	 10016:     ;
02:0003DF14 102C0015        	 10017:     move.b  ($0015,A4),D0
02:0003DF18 E208            	 10018:     lsr.b  #1,D0   ; LSR A
02:0003DF1A 6408            	 10019:     bcc  _anon_z04_122
02:0003DF1C 41EC042C        	 10020:     lea     ($042C,A4),A0
02:0003DF20 53302000        	 10021:     subq.b  #1,(A0,D2.W)
                            	 10022: _anon_z04_122:
                            	 10023:     ; If open eye timer = 0, then the eye is closed.
                            	 10024:     ; Go animate it differently.
                            	 10025:     ;
02:0003DF24 41EC0444        	 10026:     lea     ($0444,A4),A0
02:0003DF28 10302000        	 10027:     move.b  (A0,D2.W),D0
02:0003DF2C 674A            	 10028:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10029:     ; Else decrement the open eye timer.
                            	 10030:     ;
02:0003DF2E 41EC0444        	 10031:     lea     ($0444,A4),A0
02:0003DF32 53302000        	 10032:     subq.b  #1,(A0,D2.W)
                            	 10033:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10034:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10035:     ;
02:0003DF36 7602            	 10036:     moveq   #2,D3
02:0003DF38 0C000070        	 10037:     cmpi.b  #$70,D0
02:0003DF3C 6408            	 10038:     bcc  _anon_z04_123
02:0003DF3E 0C000010        	 10039:     cmpi.b  #$10,D0
02:0003DF42 6502            	 10040:     bcs  _anon_z04_123
02:0003DF44 5203            	 10041:     addq.b  #1,D3
                            	 10042: _anon_z04_123:
02:0003DF46 1003            	 10043:     move.b  D3,D0
                            	 10044:     even
                            	 10045: _L_z04_UpdateGohma_SetEyeStateAndShoot:
02:0003DF48 41EC046B        	 10046:     lea     ($046B,A4),A0
02:0003DF4C 11802000        	 10047:     move.b  D0,(A0,D2.W)
                            	 10048:     even
                            	 10049: _L_z04_UpdateGohma_ShootAnimateCollide:
                            	 10050:     ; Decrement the shoot timer.
                            	 10051:     ;
02:0003DF50 41EC0380        	 10052:     lea     ($0380,A4),A0
02:0003DF54 53302000        	 10053:     subq.b  #1,(A0,D2.W)
                            	 10054:     ; If it became 0, then set it to $41, and shoot fireball $56.
                            	 10055:     ;
02:0003DF58 6610            	 10056:     bne  _L_z04_UpdateGohma_AnimateAndCheckCollisions
02:0003DF5A 7041            	 10057:     moveq   #65,D0
02:0003DF5C 41EC0380        	 10058:     lea     ($0380,A4),A0
02:0003DF60 11802000        	 10059:     move.b  D0,(A0,D2.W)
02:0003DF64 7056            	 10060:     moveq   #86,D0
02:0003DF66 6100BE68        	 10061:     jsr     ShootFireball
                            	 10062:     even
                            	 10063: _L_z04_UpdateGohma_AnimateAndCheckCollisions:
                            	 10064:     ; Pass the frame image for the eye.
                            	 10065:     ;
02:0003DF6A 41EC046B        	 10066:     lea     ($046B,A4),A0
02:0003DF6E 10302000        	 10067:     move.b  (A0,D2.W),D0
02:0003DF72 6138            	 10068:     jsr     Gohma_AnimateAndDraw
02:0003DF74 600000AA        	 10069:     jmp     Gohma_CheckCollisions
                            	 10070: 
                            	 10071:     even
                            	 10072: _L_z04_UpdateGohma_AnimateClosedEye:
                            	 10073:     ; Here the eye is closed. So animate it this way.
                            	 10074:     ; Increment the animation counter, and if <> 8, then
                            	 10075:     ; go shoot, draw, and check collisions.
                            	 10076:     ;
02:0003DF78 41EC0478        	 10077:     lea     ($0478,A4),A0
02:0003DF7C 52302000        	 10078:     addq.b  #1,(A0,D2.W)
02:0003DF80 41EC0478        	 10079:     lea     ($0478,A4),A0
02:0003DF84 10302000        	 10080:     move.b  (A0,D2.W),D0
02:0003DF88 0C000008        	 10081:     cmpi.b  #$08,D0
02:0003DF8C 66C2            	 10082:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	 10083:     ; Roll over the eye animation counter to 0.
                            	 10084:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	 10085:     ;
02:0003DF8E 7000            	 10086:     moveq   #0,D0
02:0003DF90 41EC0478        	 10087:     lea     ($0478,A4),A0
02:0003DF94 11802000        	 10088:     move.b  D0,(A0,D2.W)
02:0003DF98 41EC046B        	 10089:     lea     ($046B,A4),A0
02:0003DF9C 10302000        	 10090:     move.b  (A0,D2.W),D0
02:0003DFA0 02000001        	 10091:     andi.b #$01,D0
02:0003DFA4 0A000001        	 10092:     eori.b #$01,D0
                            	 10093:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	 10094:     ;
02:0003DFA8 609E            	 10095:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	 10096: 
                            	 10097:     even
                            	 10098: GohmaLegOffsetsX:
02:0003DFAA F0              	 10099:     dc.b    $F0, $10
02:0003DFAB 10
                            	 10100: 
                            	 10101: ; Params:
                            	 10102: ; A: eye frame image
                            	 10103: ;
                            	 10104: ; Draw the eye with the frame image passed in.
                            	 10105: ;
                            	 10106:     even
                            	 10107: Gohma_AnimateAndDraw:
02:0003DFAC 1B00            	 10108:     move.b  D0,-(A5)  ; PHA
02:0003DFAE 4EB90004CDE0    	 10109:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003DFB4 6164            	 10110:     jsr     Gohma_SetSpriteAttributes
02:0003DFB6 101D            	 10111:     move.b  (A5)+,D0  ; PLA
02:0003DFB8 4EB9000317B6    	 10112:     jsr     DrawObjectMirrored
02:0003DFBE 7010            	 10113:     moveq   #16,D0
02:0003DFC0 4EB90004CDDA    	 10114:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10115:     ; Draw the right legs.
                            	 10116:     ;
02:0003DFC6 7601            	 10117:     moveq   #1,D3
02:0003DFC8 6102            	 10118:     jsr     Gohma_DrawLegsOneSide
                            	 10119:     ; Draw the left legs.
                            	 10120:     ;
02:0003DFCA 7600            	 10121:     moveq   #0,D3
                            	 10122: ; Params:
                            	 10123: ; Y: side: 0 for left, 1 for right
                            	 10124: ;
                            	 10125: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10126: ; store the sprite's X in [00].
                            	 10127: ;
                            	 10128:     even
                            	 10129: Gohma_DrawLegsOneSide:
02:0003DFCC 10342070        	 10130:     move.b  ($70,A4,D2.W),D0
02:0003DFD0 023C00EE        	 10131:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFD4 41F90003DFAA    	 10132:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFDA 12303000        	 10133:     move.b  (A0,D3.W),D1
02:0003DFDE D101            	 10134:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DFE0 1880            	 10135:     move.b  D0,($0000,A4)
                            	 10136:     ; The object's Y is the sprite's.
                            	 10137:     ;
02:0003DFE2 41EC0084        	 10138:     lea     ($0084,A4),A0
02:0003DFE6 10302000        	 10139:     move.b  (A0,D2.W),D0
02:0003DFEA 19400001        	 10140:     move.b  D0,($0001,A4)
02:0003DFEE 612A            	 10141:     jsr     Gohma_SetSpriteAttributes
                            	 10142:     ; There are only two frame images for legs: left and right.
                            	 10143:     ; There are two animation frames. They are animated as follows:
                            	 10144:     ;
                            	 10145:     ; Frame 0:
                            	 10146:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10147:     ; horizontal flipping = frame number = 0
                            	 10148:     ; 
                            	 10149:     ; Frame 1:
                            	 10150:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10151:     ; horizontal flipping = frame number = 1
                            	 10152:     ;
02:0003DFF0 4EB90004CDB2    	 10153:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFF6 1003            	 10154:     move.b  D3,D0
02:0003DFF8 023C00EE        	 10155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFFC 41EC03E4        	 10156:     lea     ($03E4,A4),A0
02:0003E000 12302000        	 10157:     move.b  (A0,D2.W),D1
02:0003E004 D101            	 10158:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E006 02000001        	 10159:     andi.b #$01,D0
02:0003E00A 023C00EE        	 10160:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E00E 123C0004        	 10161:     move.b  #$04,D1
02:0003E012 D101            	 10162:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E014 4EF9000317BA    	 10163:     jmp     DrawObjectNotMirrored
                            	 10164: 
                            	 10165: ; Returns:
                            	 10166: ; [04]: left side sprite attributes
                            	 10167: ; [05]: right side sprite attributes
                            	 10168: ;
                            	 10169:     even
                            	 10170: Gohma_SetSpriteAttributes:
02:0003E01A 4EF90002BF4C    	 10171:     jmp     c_gohma_set_sprite_attributes
                            	 10172: 
                            	 10173: Gohma_CheckCollisions:
                            	 10174:     ; Save the boss's X coordinate.
                            	 10175:     ;
02:0003E020 10342070        	 10176:     move.b  ($70,A4,D2.W),D0
02:0003E024 1B00            	 10177:     move.b  D0,-(A5)  ; PHA
                            	 10178:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10179:     ; on the left side.
                            	 10180:     ;
02:0003E026 003C0011        	 10181:     ori     #$11,CCR  ; SEC: set C+X
02:0003E02A 123C0010        	 10182:     move.b  #$10,D1
02:0003E02E 0A3C0010        	 10183:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E032 9101            	 10184:     subx.b  D1,D0   ; SBC #$10
02:0003E034 0A3C0010        	 10185:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E038 19802070        	 10186:     move.b  D0,($70,A4,D2.W)
                            	 10187:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10188:     ; from left to right, indexed by [0F].
                            	 10189:     ;
02:0003E03C 7005            	 10190:     moveq   #5,D0
02:0003E03E 1940000F        	 10191:     move.b  D0,($000F,A4)
                            	 10192:     even
                            	 10193: _L_z04_Gohma_CheckCollisions_LoopSprite:
02:0003E042 4EB900031B36    	 10194:     jsr     CheckMonsterCollisions
                            	 10195:     ; Add 8 to the X coordinate for the next part.
                            	 10196:     ;
02:0003E048 10342070        	 10197:     move.b  ($70,A4,D2.W),D0
02:0003E04C 023C00EE        	 10198:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E050 123C0008        	 10199:     move.b  #$08,D1
02:0003E054 D101            	 10200:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E056 19802070        	 10201:     move.b  D0,($70,A4,D2.W)
02:0003E05A 532C000F        	 10202:     subq.b  #1,($000F,A4)
02:0003E05E 66E2            	 10203:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	 10204:     ; Restore the boss's X coordinate.
                            	 10205:     ;
02:0003E060 101D            	 10206:     move.b  (A5)+,D0  ; PLA
02:0003E062 19802070        	 10207:     move.b  D0,($70,A4,D2.W)
02:0003E066 4E75            	 10208:     rts
                            	 10209: 
                            	 10210:     even
                            	 10211: Gohma_HandleWeaponCollision:
