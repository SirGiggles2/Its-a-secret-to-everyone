                            	  5329: Wallmaster_PutSpriteBehindBgIfNeeded:
                            	  5330:     ; Loop twice, from 1 to 0, in order to check the left and right
                            	  5331:     ; extents of the sprite (X and X+8).
                            	  5332:     ;
02:0003BC5E 7401            	  5333:     moveq   #1,D2
                            	  5334:     even
                            	  5335: _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_LoopExtent:
                            	  5336:     ; If sprite X + extent >= $E9 or < $18, then
                            	  5337:     ; add priority attribute to show this sprite behind the background.
                            	  5338:     ;
02:0003BC60 41EC0203        	  5339:     lea     ($0203,A4),A0
02:0003BC64 10303000        	  5340:     move.b  (A0,D3.W),D0
02:0003BC68 023C00EE        	  5341:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC6C 41F900030A06    	  5342:     lea     (SpriteRelativeExtents).l,A0
