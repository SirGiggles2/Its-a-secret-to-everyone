02:00039C4E 02000003        	   764:     andi.b #$03,D0
02:00039C52 4EB90002AECA    	   765:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	   766:     even
                            	   767: UpdateBlock_JumpTable:
02:00039C58 00039C64        	   768:     dc.l    UpdateBlock0Idle   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C5C 00039D4E        	   769:     dc.l    UpdateBlock1Moving   ; jump table entry (32-bit for _m68k_tablejump)
