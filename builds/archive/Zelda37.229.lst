                            	  7372: ChangePlayMapSquareOW:
02:00044492 1002            	  7373:     move.b  D2,D0
02:00044494 1B00            	  7374:     move.b  D0,-(A5)  ; PHA
                            	  7375:     ; We're dealing with squares.
                            	  7376:     ; So, align the object's X coordinate with 16 pixels.
                            	  7377:     ;
02:00044496 10342070        	  7378:     move.b  ($70,A4,D2.W),D0
02:0004449A 020000F0        	  7379:     andi.b #$F0,D0
                            	  7380:     ; Divide it by 4 to get the offset of the address of the column
                            	  7381:     ; in play area map.
                            	  7382:     ;
                            	  7383:     ; The calculation is: address offset = (X / 8) * 2
                            	  7384:     ; 8 for the width of the column; 2 for the width of the address
                            	  7385:     ;
02:0004449E E208            	  7386:     lsr.b  #1,D0   ; LSR A
02:000444A0 E208            	  7387:     lsr.b  #1,D0   ; LSR A
02:000444A2 7400            	  7388:     moveq   #0,D2
02:000444A4 1400            	  7389:     move.b  D0,D2
                            	  7390:     ; Store the address of the column in [00:01].
                            	  7391:     ;
02:000444A6 41F90004A690    	  7392:     lea     (PlayAreaColumnAddrs).l,A0
02:000444AC 10302000        	  7393:     move.b  (A0,D2.W),D0
02:000444B0 1880            	  7394:     move.b  D0,($0000,A4)
02:000444B2 41F90004A691    	  7395:     lea     (PlayAreaColumnAddrs+1).l,A0
02:000444B8 10302000        	  7396:     move.b  (A0,D2.W),D0
02:000444BC 19400001        	  7397:     move.b  D0,($0001,A4)
02:000444C0 101D            	  7398:     move.b  (A5)+,D0  ; PLA
02:000444C2 1B00            	  7399:     move.b  D0,-(A5)  ; PHA
02:000444C4 7400            	  7400:     moveq   #0,D2
02:000444C6 1400            	  7401:     move.b  D0,D2
                            	  7402:     ; Align the object's Y coordinate with 16 pixels.
                            	  7403:     ;
02:000444C8 41EC0084        	  7404:     lea     ($0084,A4),A0
02:000444CC 10302000        	  7405:     move.b  (A0,D2.W),D0
02:000444D0 020000F0        	  7406:     andi.b #$F0,D0
                            	  7407:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7408:     ; the height of each row.
                            	  7409:     ;
02:000444D4 003C0011        	  7410:     ori     #$11,CCR  ; SEC: set C+X
02:000444D8 123C0040        	  7411:     move.b  #$40,D1
02:000444DC 0A3C0010        	  7412:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000444E0 9101            	  7413:     subx.b  D1,D0   ; SBC #$40
02:000444E2 0A3C0010        	  7414:     eori    #$10,CCR  ; restore X = 6502 C
02:000444E6 E208            	  7415:     lsr.b  #1,D0   ; LSR A
02:000444E8 E208            	  7416:     lsr.b  #1,D0   ; LSR A
02:000444EA E208            	  7417:     lsr.b  #1,D0   ; LSR A
                            	  7418:     ; Add this row offset to the column address.
                            	  7419:     ;
02:000444EC 4EB9000310BC    	  7420:     jsr     AddToInt16At0
                            	  7421:     ; Assume that we'll write a type 1 square with primary square
                            	  7422:     ; taken from [05]. If so, the square index doesn't matter
                            	  7423:     ; as long as >= $10. See WriteSquareOW.
                            	  7424:     ;
02:000444F2 7600            	  7425:     moveq   #0,D3
02:000444F4 7410            	  7426:     moveq   #16,D2
02:000444F6 102C0005        	  7427:     move.b  ($0005,A4),D0
                            	  7428:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7429:     ; So, we have to look up the square index corresponding
                            	  7430:     ; to primary square/tile in [05].
                            	  7431:     ;
                            	  7432:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7433:     ; then the X register will have the square index value.
                            	  7434:     ;
02:000444FA 0C000027        	  7435:     cmpi.b  #$27,D0
