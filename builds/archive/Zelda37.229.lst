                            	  6633: HarmLink:
02:00031DAE 61000564        	  6634:     jsr     BeginShove
                            	  6635:     ; Flag collision with [0C], even though [06] was already set.
                            	  6636:     ;
02:00031DB2 522C000C        	  6637:     addq.b  #1,($000C,A4)
                            	  6638:     ; Unpack the damage points for the monster's type.
                            	  6639:     ; The low nibble is the high byte.
                            	  6640:     ; (Damage points byte AND $F0) is the low byte.
                            	  6641:     ;
02:00031DB6 7600            	  6642:     moveq   #0,D3
02:00031DB8 41EC034F        	  6643:     lea     ($034F,A4),A0
02:00031DBC 16302000        	  6644:     move.b  (A0,D2.W),D3
02:00031DC0 41F900031C22    	  6645:     lea     (ObjTypeToDamagePoints).l,A0
02:00031DC6 10303000        	  6646:     move.b  (A0,D3.W),D0
02:00031DCA 1B00            	  6647:     move.b  D0,-(A5)  ; PHA
02:00031DCC 0200000F        	  6648:     andi.b #$0F,D0
02:00031DD0 1940000D        	  6649:     move.b  D0,($000D,A4)
02:00031DD4 101D            	  6650:     move.b  (A5)+,D0  ; PLA
02:00031DD6 020000F0        	  6651:     andi.b #$F0,D0
02:00031DDA 1940000E        	  6652:     move.b  D0,($000E,A4)
                            	  6653: ; Params:
                            	  6654: ; X: object index of the attacker
                            	  6655: ; [0D]: damage points high byte
                            	  6656: ; [0E]: damage points low byte
                            	  6657: ;
                            	  6658: ;
                            	  6659: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6660: ;
                            	  6661:     even
                            	  6662: Link_BeHarmed:
02:00031DDE 7600            	  6663:     moveq   #0,D3
02:00031DE0 41EC034F        	  6664:     lea     ($034F,A4),A0
02:00031DE4 16302000        	  6665:     move.b  (A0,D2.W),D3
02:00031DE8 0C03002E        	  6666:     cmpi.b  #$2E,D3
