02:0003BBB8 6100E1E6        	  5237:     jsr     DrawObjectNotMirroredOverLink
                            	  5238:     ; Store the offsets of the sprites to show over Link
                            	  5239:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
                            	  5240:     ;
