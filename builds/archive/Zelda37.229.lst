02:0003AC10 41EC041F        	  3034:     lea     ($041F,A4),A0
02:0003AC14 10302000        	  3035:     move.b  (A0,D2.W),D0
02:0003AC18 023C00EE        	  3036:     andi    #$EE,CCR  ; CLC: clear C+X
