                            	  4558: __far_z_02_0009:
                            	  4559:     ; Set the timer to wait 6 frames after the next character about
                            	  4560:     ; to be shown.
                            	  4561:     ;
02:000362D4 7006            	  4562:     moveq   #6,D0
02:000362D6 19400029        	  4563:     move.b  D0,($0029,A4)
                            	  4564:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4565:     ; to the dynamic transfer buf.
                            	  4566:     ;
02:000362DA 7604            	  4567:     moveq   #4,D3
                            	  4568: _anon_z02_31:
02:000362DC 41F9000362BA    	  4569:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000362E2 10303000        	  4570:     move.b  (A0,D3.W),D0
02:000362E6 41EC0302        	  4571:     lea     ($0302,A4),A0
