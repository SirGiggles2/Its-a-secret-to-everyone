                            	  4240:     ; the screen edge, or stop moving.
                            	  4241:     ;
02:0004BB74 4A02            	  4242:     cmpi.b  #$00,D2
02:0004BB76 6602            	  4243:     bne.s  __far_z_07_0054
02:0004BB78 6022            	  4244:     jmp  PlayerUnwalkable
                            	  4245: __far_z_07_0054:
