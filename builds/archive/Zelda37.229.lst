02:0003CF3C 41EC0084        	  7937:     lea     ($0084,A4),A0
02:0003CF40 10302000        	  7938:     move.b  (A0,D2.W),D0
02:0003CF44 0C000078        	  7939:     cmpi.b  #$78,D0
02:0003CF48 6402            	  7940:     bcc  _anon_z04_97
02:0003CF4A 7603            	  7941:     moveq   #3,D3
                            	  7942: _anon_z04_97:
