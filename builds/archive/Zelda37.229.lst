                            	   559: UpdateMenuStartOW:
                            	   560:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   561:     ; make it look completely empty, and no piece has been won.
                            	   562:     ;
02:000402B6 7617            	   563:     moveq   #23,D3
                            	   564: _anon_z05_6:
02:000402B8 7400            	   565:     moveq   #0,D2
02:000402BA 41F90004026E    	   566:     lea     (TriforceTransferBufOffsets).l,A0
02:000402C0 14303000        	   567:     move.b  (A0,D3.W),D2
02:000402C4 41F90004029E    	   568:     lea     (TriforceTransferBufTiles).l,A0
02:000402CA 10303000        	   569:     move.b  (A0,D3.W),D0
02:000402CE 41F90004748A    	   570:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000402D4 11802000        	   571:     move.b  D0,(A0,D2.W)
02:000402D8 5303            	   572:     subq.b  #1,D3
02:000402DA 6ADC            	   573:     bpl  _anon_z05_6
                            	   574:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   575:     ;
02:000402DC 5203            	   576:     addq.b  #1,D3
                            	   577:     ; Outer loop.
                            	   578:     ; A level test bit in [06] will be used to see whether
                            	   579:     ; we have a triforce piece.
                            	   580:     ;
02:000402DE 7001            	   581:     moveq   #1,D0
02:000402E0 19400006        	   582:     move.b  D0,($0006,A4)
                            	   583:     even
                            	   584: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   585:     ; Inner loop.
                            	   586:     ; Each level bit will make 3 triforce tile slots be
                            	   587:     ; checked and replaced.
                            	   588:     ;
02:000402E4 7003            	   589:     moveq   #3,D0
02:000402E6 19400007        	   590:     move.b  D0,($0007,A4)
                            	   591:     even
                            	   592: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   593:     ; Get the offset into the submenu triforce transfer buffers of
                            	   594:     ; the current tile slot.
                            	   595:     ;
02:000402EA 7400            	   596:     moveq   #0,D2
02:000402EC 41F90004026E    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:000402F2 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:000402F6 102C0006        	   605:     move.b  ($0006,A4),D0
02:000402FA 122C0671        	   606:     move.b  ($0671,A4),D1
02:000402FE C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040300 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
                            	   615:     ; Else replace it with the one at the current triforce tile slot
                            	   616:     ; in the replacement list.
                            	   617:     ;
02:00040302 41F90004748A    	   618:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040308 10302000        	   619:     move.b  (A0,D2.W),D0
02:0004030C 0C0000E5        	   620:     cmpi.b  #$E5,D0
02:00040310 6712            	   621:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040312 0C0000E6        	   622:     cmpi.b  #$E6,D0
02:00040316 670C            	   623:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040318 41F900040286    	   624:     lea     (TriforceTriforceBufReplacements).l,A0
02:0004031E 10303000        	   625:     move.b  (A0,D3.W),D0
02:00040322 6004            	   626:     jmp     _anon_z05_7
                            	   627: 
                            	   628:     even
                            	   629: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:00040324 103C00F5        	   630:     move.b  #$F5,D0
                            	   631: _anon_z05_7:
02:00040328 41F90004748A    	   632:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004032E 11802000        	   633:     move.b  D0,(A0,D2.W)
                            	   634:     even
                            	   635: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   636:     ; Bottom of the inner loop.
                            	   637:     ;
                            	   638:     ; Increment the triforce tile slot.
                            	   639:     ; Decrement [07] and loop again, if it's not 0.
                            	   640:     ;
02:00040332 5203            	   641:     addq.b  #1,D3
02:00040334 532C0007        	   642:     subq.b  #1,($0007,A4)
02:00040338 66B0            	   643:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   644:     ; Bottom of the outer loop.
                            	   645:     ;
                            	   646:     ; Shift the level test bit [06] left to test the next level.
                            	   647:     ; When it becomes 0, we're done.
                            	   648:     ;
02:0004033A 122C0006        	   649:     move.b  ($0006,A4),D1
02:0004033E E309            	   650:     lsl.b  #1,D1   ; ASL $06
02:00040340 19410006        	   651:     move.b  D1,($0006,A4)
02:00040344 669E            	   652:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:00040346 522C00E1        	   653:     addq.b  #1,($00E1,A4)
02:0004034A 4E75            	   654:     rts
