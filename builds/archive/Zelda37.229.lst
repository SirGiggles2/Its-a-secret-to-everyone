                            	 10232:     even
                            	 10233: _L_z04_Gohma_HandleWeaponCollision_CheckEyeOpen:
                            	 10234:     ; If the state of the eye is not 3, then go parry.
                            	 10235:     ;
02:0003E092 41EC046B        	 10236:     lea     ($046B,A4),A0
