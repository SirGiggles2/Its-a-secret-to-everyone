                            	  1926: _L_z04_UpdateStatues_Shoot:
                            	  1927:     ; Look for an empty monster slot.
                            	  1928:     ; If none is found, return.
                            	  1929:     ;
                            	  1930:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1931:     ; object. This routine takes a shooter object, and instantiates
                            	  1932:     ; a fireball object at the shooter's location.
                            	  1933:     ;
                            	  1934:     ; The object slot we set up here will behave as the shooter.
                            	  1935:     ; For each fireball index, this object slot will have its coordinates
                            	  1936:     ; changed.
                            	  1937:     ;
                            	  1938:     ; Note that this means that:
                            	  1939:     ; 1. The first fireball made will be its own shooter.
                            	  1940:     ;    Practically, there's nothing special about this.
                            	  1941:     ; 2. If there is more than one fireball made in a frame,
                            	  1942:     ;    then two of them will come from the same statue.
                            	  1943:     ;
                            	  1944:     ;
                            	  1945:     ; Save the fireball pattern.
02:0003A4B0 1003            	  1946:     move.b  D3,D0
02:0003A4B2 1B00            	  1947:     move.b  D0,-(A5)  ; PHA
02:0003A4B4 4EB90004D5D0    	  1948:     jsr     FindEmptyMonsterSlot
02:0003A4BA 0C000001        	  1949:     cmpi.b  #$01,D0
02:0003A4BE 101D            	  1950:     move.b  (A5)+,D0  ; PLA
02:0003A4C0 6400010A        	  1951:     bcc  _L_z04_UpdateStatues_Exit
                            	  1952:     ; If we found a slot, but it < 6, return.
                            	  1953:     ;
02:0003A4C4 0C030006        	  1954:     cmpi.b  #$06,D3
02:0003A4C8 65000102        	  1955:     bcs  _L_z04_UpdateStatues_Exit
                            	  1956:     ; Store the object slot in [0A].
                            	  1957:     ; Store fireball pattern in [0B].
                            	  1958:     ;
02:0003A4CC 1943000A        	  1959:     move.b  D3,($000A,A4)
02:0003A4D0 1940000B        	  1960:     move.b  D0,($000B,A4)
                            	  1961:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1962:     ;
02:0003A4D4 7600            	  1963:     moveq   #0,D3
02:0003A4D6 1600            	  1964:     move.b  D0,D3
02:0003A4D8 7400            	  1965:     moveq   #0,D2
02:0003A4DA 41F90003A46C    	  1966:     lea     (StatueFireballCounts).l,A0
02:0003A4E0 14303000        	  1967:     move.b  (A0,D3.W),D2
                            	  1968:     even
                            	  1969: _L_z04_UpdateStatues_LoopFireball:
                            	  1970:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1971:     ;
                            	  1972:     ; Decrement the fireball timer at this index.
                            	  1973:     ;
02:0003A4E4 7600            	  1974:     moveq   #0,D3
02:0003A4E6 41EC04E8        	  1975:     lea     ($04E8,A4),A0
02:0003A4EA 16302000        	  1976:     move.b  (A0,D2.W),D3
02:0003A4EE 5303            	  1977:     subq.b  #1,D3
02:0003A4F0 1003            	  1978:     move.b  D3,D0
02:0003A4F2 41EC04E8        	  1979:     lea     ($04E8,A4),A0
02:0003A4F6 11802000        	  1980:     move.b  D0,(A0,D2.W)
                            	  1981:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1982:     ; to make a fireball. Go loop again.
                            	  1983:     ;
02:0003A4FA 5203            	  1984:     addq.b  #1,D3
02:0003A4FC 660000C8        	  1985:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1986:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1987:     ; This fireball index will wait another $100 frames.
                            	  1988:     ;
02:0003A500 10342018        	  1989:     move.b  ($18,A4,D2.W),D0
02:0003A504 0C0000F0        	  1990:     cmpi.b  #$F0,D0
02:0003A508 640000BC        	  1991:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1992:     ; Else choose one of four start times for the fireball based on
                            	  1993:     ; the random value.
                            	  1994:     ;
02:0003A50C 02000003        	  1995:     andi.b #$03,D0
02:0003A510 7600            	  1996:     moveq   #0,D3
02:0003A512 1600            	  1997:     move.b  D0,D3
02:0003A514 41F90003A470    	  1998:     lea     (StatueFireballStartTimes).l,A0
02:0003A51A 10303000        	  1999:     move.b  (A0,D3.W),D0
02:0003A51E 41EC04E8        	  2000:     lea     ($04E8,A4),A0
02:0003A522 11802000        	  2001:     move.b  D0,(A0,D2.W)
                            	  2002:     ; The coordinate lists are divided into sets for each pattern.
                            	  2003:     ;
                            	  2004:     ; Look up the index of the base of the set for the pattern in use.
                            	  2005:     ; Add it to the fireball index in X register to get the index of
                            	  2006:     ; the coordinate we want within each coordinate list.
                            	  2007:     ;
                            	  2008:     ;
                            	  2009:     ; Pattern
02:0003A526 7600            	  2010:     moveq   #0,D3
02:0003A528 162C000B        	  2011:     move.b  ($000B,A4),D3
02:0003A52C 1002            	  2012:     move.b  D2,D0
02:0003A52E 023C00EE        	  2013:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A532 41F90003A474    	  2014:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A538 12303000        	  2015:     move.b  (A0,D3.W),D1
02:0003A53C D101            	  2016:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A53E 7600            	  2017:     moveq   #0,D3
02:0003A540 1600            	  2018:     move.b  D0,D3
