                            	  7728:     ;
02:00032456 102C0008        	  7729:     move.b  ($0008,A4),D0
02:0003245A 00000080        	  7730:     ori.b #$80,D0
02:0003245E 41EC00C0        	  7731:     lea     ($00C0,A4),A0
02:00032462 11802000        	  7732:     move.b  D0,(A0,D2.W)
                            	  7733:     ; Mark the monster invincible $10 frames, and should move $40 pixels.
                            	  7734:     ;
02:00032466 7040            	  7735:     moveq   #64,D0
02:00032468 41EC00D3        	  7736:     lea     ($00D3,A4),A0
02:0003246C 11802000        	  7737:     move.b  D0,(A0,D2.W)
02:00032470 7010            	  7738:     moveq   #16,D0
02:00032472 41EC04F0        	  7739:     lea     ($04F0,A4),A0
02:00032476 11802000        	  7740:     move.b  D0,(A0,D2.W)
                            	  7741:     even
