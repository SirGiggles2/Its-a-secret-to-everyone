                            	 13070: Ganon_DrawBody:
                            	 13071:     ; Loop over four 16x16 images that make up Ganon.
                            	 13072:     ; There are 6 animation frames.
                            	 13073:     ;
02:0003F54C 7603            	 13074:     moveq   #3,D3
                            	 13075:     even
                            	 13076: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13077:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13078:     ;
02:0003F54E 10342070        	 13079:     move.b  ($70,A4,D2.W),D0
02:0003F552 023C00EE        	 13080:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F556 41F90003F540    	 13081:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F55C 12303000        	 13082:     move.b  (A0,D3.W),D1
02:0003F560 D101            	 13083:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F562 1880            	 13084:     move.b  D0,($0000,A4)
                            	 13085:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13086:     ;
02:0003F564 41EC0084        	 13087:     lea     ($0084,A4),A0
02:0003F568 10302000        	 13088:     move.b  (A0,D2.W),D0
02:0003F56C 023C00EE        	 13089:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F570 41F90003F544    	 13090:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F576 12303000        	 13091:     move.b  (A0,D3.W),D1
02:0003F57A D101            	 13092:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F57C 19400001        	 13093:     move.b  D0,($0001,A4)
                            	 13094:     ; Each part has a horizontal flipping flag.
                            	 13095:     ;
02:0003F580 41F90003F548    	 13096:     lea     (GanonSpriteHFlips).l,A0
02:0003F586 10303000        	 13097:     move.b  (A0,D3.W),D0
02:0003F58A 1940000F        	 13098:     move.b  D0,($000F,A4)
                            	 13099:     ; Save and copy the loop index (the current part) to [07].
                            	 13100:     ;
02:0003F58E 1003            	 13101:     move.b  D3,D0
02:0003F590 1B00            	 13102:     move.b  D0,-(A5)  ; PHA
02:0003F592 19400007        	 13103:     move.b  D0,($0007,A4)
                            	 13104:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13105:     ; that make it up.
                            	 13106:     ;
02:0003F596 41EC046B        	 13107:     lea     ($046B,A4),A0
02:0003F59A 10302000        	 13108:     move.b  (A0,D2.W),D0
02:0003F59E E308            	 13109:     lsl.b  #1,D0   ; ASL A
02:0003F5A0 E308            	 13110:     lsl.b  #1,D0   ; ASL A
                            	 13111:     ; Add [07] -- the index of the current part.
                            	 13112:     ;
                            	 13113:     ; Now you have an index into the frame image table, for the
                            	 13114:     ; current image part of the current animation frame.
                            	 13115:     ;
02:0003F5A2 122C0007        	 13116:     move.b  ($0007,A4),D1
02:0003F5A6 D101            	 13117:     addx.b  D1,D0   ; ADC $07
02:0003F5A8 7600            	 13118:     moveq   #0,D3
02:0003F5AA 1600            	 13119:     move.b  D0,D3
02:0003F5AC 41F90003F528    	 13120:     lea     (GanonFrameImages).l,A0
02:0003F5B2 10303000        	 13121:     move.b  (A0,D3.W),D0
02:0003F5B6 4EB9000317BA    	 13122:     jsr     DrawObjectNotMirrored
02:0003F5BC 101D            	 13123:     move.b  (A5)+,D0  ; PLA
                            	 13124:     ; Bottom of the part loop.
                            	 13125:     ;
02:0003F5BE 7600            	 13126:     moveq   #0,D3
02:0003F5C0 1600            	 13127:     move.b  D0,D3
02:0003F5C2 5303            	 13128:     subq.b  #1,D3
02:0003F5C4 6A88            	 13129:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F5C6 4E75            	 13130:     rts
