02:0003B41C 123C001C        	  4210:     move.b  #$1C,D1
02:0003B420 0A3C0010        	  4211:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B424 9101            	  4212:     subx.b  D1,D0   ; SBC #$1C
02:0003B426 0A3C0010        	  4213:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B42A 41EC0084        	  4214:     lea     ($0084,A4),A0
