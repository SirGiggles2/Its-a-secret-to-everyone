                            	  2000: ;==============================================================================
                            	  2001: ; EXPORT side — carry-returning shims.
                            	  2002: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2003: ; reproduces the original function's carry normalization.
                            	  2004: ;==============================================================================
                            	  2005: 
                            	  2006: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2007: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2008:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2009:     btst    #8,D0
02:0002BF8E 670A            	  2010:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2011:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2012:     eori    #$01,CCR
02:0002BF98 4E75            	  2013:     rts
                            	  2014: .cc_cnr:
02:0002BF9A 023C00FE        	  2015:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2016:     eori    #$01,CCR
02:0002BFA2 4E75            	  2017:     rts
                            	  2018: 
                            	  2019: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2020: c_copy_next_row_advance_submode:
