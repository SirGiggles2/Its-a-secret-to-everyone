                            	  1646: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithHeartContainer:
                            	  1647:     ; The player chose the heart container.
                            	  1648:     ;
                            	  1649:     ; If the number of heart containers < 4, then
                            	  1650:     ; - leave the number of heart containers alone
                            	  1651:     ; - set HeartPartial to 0, so Link will die with one more hit
                            	  1652:     ;
                            	  1653:     ; Then go flag this offer taken.
                            	  1654:     ;
02:0002E9A6 102C066F        	  1655:     move.b  ($066F,A4),D0
02:0002E9AA 020000F0        	  1656:     andi.b #$F0,D0
02:0002E9AE 0C000030        	  1657:     cmpi.b  #$30,D0
02:0002E9B2 640C            	  1658:     bcc  _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_Reduce
02:0002E9B4 1940066F        	  1659:     move.b  D0,($066F,A4)
02:0002E9B8 7000            	  1660:     moveq   #0,D0
02:0002E9BA 19400670        	  1661:     move.b  D0,($0670,A4)
