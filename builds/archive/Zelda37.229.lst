02:0002E390 7604            	   755:     moveq   #4,D3
                            	   756: _anon_z01_7:
02:0002E392 41F90002E36C    	   757:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E398 10303000        	   758:     move.b  (A0,D3.W),D0
02:0002E39C 41EC0302        	   759:     lea     ($0302,A4),A0
02:0002E3A0 11803000        	   760:     move.b  D0,(A0,D3.W)
02:0002E3A4 5303            	   761:     subq.b  #1,D3
02:0002E3A6 6AEA            	   762:     bpl  _anon_z01_7
                            	   763:     even
                            	   764: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   765:     ; Replace the low byte of the VRAM address with the one
                            	   766:     ; where the next character should be written.
                            	   767:     ;
02:0002E3A8 102C045F        	   768:     move.b  ($045F,A4),D0
02:0002E3AC 19400303        	   769:     move.b  D0,($0303,A4)
                            	   770:     ; Increment the low VRAM address for the next character.
                            	   771:     ;
02:0002E3B0 522C045F        	   772:     addq.b  #1,($045F,A4)
                            	   773:     ; Use the person text selector to look up the address of the
                            	   774:     ; text for the textbox. Store the address in [00:01].
                            	   775:     ;
02:0002E3B4 7600            	   776:     moveq   #0,D3
02:0002E3B6 162C0415        	   777:     move.b  ($0415,A4),D3
02:0002E3BA 41F90002D9F0    	   778:     lea     (PersonTextAddrs).l,A0
02:0002E3C0 10303000        	   779:     move.b  (A0,D3.W),D0
02:0002E3C4 1880            	   780:     move.b  D0,($0000,A4)
02:0002E3C6 5203            	   781:     addq.b  #1,D3
02:0002E3C8 41F90002D9F0    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E3CE 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E3D2 19400001        	   784:     move.b  D0,($0001,A4)
                            	   785:     ; Load the person text current character index.
                            	   786:     ;
02:0002E3D6 7600            	   787:     moveq   #0,D3
02:0002E3D8 162C0416        	   788:     move.b  ($0416,A4),D3
                            	   789:     ; Increment the index variable to point to the next character
                            	   790:     ; for next time.
                            	   791:     ;
02:0002E3DC 522C0416        	   792:     addq.b  #1,($0416,A4)
                            	   793:     ; Get the current character.
                            	   794:     ;
02:0002E3E0 1214            	   795:     move.b  ($00,A4),D1   ; ptr lo
02:0002E3E2 182C0001        	   796:     move.b  ($01,A4),D4  ; ptr hi
02:0002E3E6 024100FF        	   797:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E3EA E14C            	   798:     lsl.w   #8,D4
02:0002E3EC 8841            	   799:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E3EE 48C4            	   800:     ext.l   D4
02:0002E3F0 D8BC00FF0000    	   801:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E3F6 2044            	   802:     movea.l D4,A0
02:0002E3F8 10303000        	   803:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   804:     ; If the character is $25, then it's a special space. It will still
                            	   805:     ; take up space, but will not take time to show -- meaning that
                            	   806:     ; we'll go look up the next character to transfer.
                            	   807:     ;
02:0002E3FC 0200003F        	   808:     andi.b #$3F,D0
02:0002E400 0C000025        	   809:     cmpi.b  #$25,D0
02:0002E404 67A2            	   810:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   811:     ; We have a non-space character. Put it in the transfer record.
                            	   812:     ;
02:0002E406 19400305        	   813:     move.b  D0,($0305,A4)
                            	   814:     ; Play the "heart taken/character" sound effect.
                            	   815:     ;
02:0002E40A 7010            	   816:     moveq   #16,D0
02:0002E40C 19400604        	   817:     move.b  D0,($0604,A4)
                            	   818:     ; If the high 2 bits of character element = 0, then return.
                            	   819:     ;
02:0002E410 1214            	   820:     move.b  ($00,A4),D1   ; ptr lo
02:0002E412 182C0001        	   821:     move.b  ($01,A4),D4  ; ptr hi
02:0002E416 024100FF        	   822:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E41A E14C            	   823:     lsl.w   #8,D4
02:0002E41C 8841            	   824:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E41E 48C4            	   825:     ext.l   D4
02:0002E420 D8BC00FF0000    	   826:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E426 2044            	   827:     movea.l D4,A0
02:0002E428 10303000        	   828:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E42C 020000C0        	   829:     andi.b #$C0,D0
02:0002E430 672E            	   830:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   831:     ; Determine an index based on the high 2 bits of the character element:
                            	   832:     ;   $80: 0
                            	   833:     ;   $40: 1
                            	   834:     ;   $C0: 2
                            	   835:     ;
02:0002E432 7602            	   836:     moveq   #2,D3
02:0002E434 0C0000C0        	   837:     cmpi.b  #$C0,D0
02:0002E438 670A            	   838:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E43A 5303            	   839:     subq.b  #1,D3
02:0002E43C 0C000040        	   840:     cmpi.b  #$40,D0
02:0002E440 6702            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E442 5303            	   842:     subq.b  #1,D3
                            	   843:     even
                            	   844: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   845:     ; The index chooses the low VRAM address of the start
                            	   846:     ; of another line:
                            	   847:     ;   0: $C4: front of the second line
                            	   848:     ;   1: $E4: front of the third line
                            	   849:     ;   2: $A4: front of the first line
                            	   850:     ;
                            	   851:     ; Look up the low VRAM address and store it.
                            	   852:     ;
02:0002E444 41F90002E372    	   853:     lea     (TextboxLineAddrsLo).l,A0
02:0002E44A 10303000        	   854:     move.b  (A0,D3.W),D0
02:0002E44E 1940045F        	   855:     move.b  D0,($045F,A4)
                            	   856:     ; If index = 2, then we've reached the end of the text,
                            	   857:     ; and low VRAM address is moved to the front of the first line.
                            	   858:     ; So, advance the state of the person object, and unhalt Link.
                            	   859:     ;
02:0002E452 0C030002        	   860:     cmpi.b  #$02,D3
02:0002E456 6608            	   861:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E458 522C00AD        	   862:     addq.b  #1,($00AD,A4)
02:0002E45C 6100FB98        	   863:     jsr     UnhaltLink
                            	   864:     even
