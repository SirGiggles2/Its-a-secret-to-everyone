02:00039C02 41EC00AC        	   725:     lea     ($00AC,A4),A0
02:00039C06 11803000        	   726:     move.b  D0,(A0,D3.W)
                            	   727:     ; Fly at q-speed $A0 (2.5 pixels a frame).
