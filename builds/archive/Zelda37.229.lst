                            	  6862: Aquamentus_Draw:
                            	  6863:     ; Every $10 screen frames, switch animation frames.
                            	  6864:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6865:     ; The last tile of frame 0 is at index 5.
                            	  6866:     ; The last tile of frame 1 is at index $B.
                            	  6867:     ;
02:0003C7E4 7605            	  6868:     moveq   #5,D3
02:0003C7E6 102C0015        	  6869:     move.b  ($0015,A4),D0
02:0003C7EA 02000010        	  6870:     andi.b #$10,D0
02:0003C7EE 6602            	  6871:     bne  _anon_z04_88
02:0003C7F0 760B            	  6872:     moveq   #11,D3
                            	  6873: _anon_z04_88:
02:0003C7F2 1943000A        	  6874:     move.b  D3,($000A,A4)
                            	  6875:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6876:     ;
02:0003C7F6 7005            	  6877:     moveq   #5,D0
02:0003C7F8 1940000B        	  6878:     move.b  D0,($000B,A4)
                            	  6879:     even
                            	  6880: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7FC 7600            	  6881:     moveq   #0,D3
02:0003C7FE 162C000B        	  6882:     move.b  ($000B,A4),D3
                            	  6883:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6884:     ; Store it in [00].
                            	  6885:     ;
02:0003C802 10342070        	  6886:     move.b  ($70,A4,D2.W),D0
02:0003C806 023C00EE        	  6887:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C80A 41F90003C7DE    	  6888:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C810 12303000        	  6889:     move.b  (A0,D3.W),D1
02:0003C814 D101            	  6890:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C816 1880            	  6891:     move.b  D0,($0000,A4)
                            	  6892:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6893:     ; Store it in [01].
                            	  6894:     ;
02:0003C818 41EC0084        	  6895:     lea     ($0084,A4),A0
02:0003C81C 10302000        	  6896:     move.b  (A0,D2.W),D0
02:0003C820 023C00EE        	  6897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C824 41F90003C7D8    	  6898:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C82A 12303000        	  6899:     move.b  (A0,D3.W),D1
02:0003C82E D101            	  6900:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C830 19400001        	  6901:     move.b  D0,($0001,A4)
                            	  6902:     ; Calculate sprite attributes:
                            	  6903:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6904:     ;
                            	  6905:     ; If the boss is temporarily invincible, then
                            	  6906:     ; this makes it flash by cycling all the palette rows.
                            	  6907:     ;
                            	  6908:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6909:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6910:     ;
02:0003C834 41EC04F0        	  6911:     lea     ($04F0,A4),A0
02:0003C838 10302000        	  6912:     move.b  (A0,D2.W),D0
02:0003C83C 02000003        	  6913:     andi.b #$03,D0
02:0003C840 0A000003        	  6914:     eori.b #$03,D0
02:0003C844 19400003        	  6915:     move.b  D0,($0003,A4)
02:0003C848 7600            	  6916:     moveq   #0,D3
02:0003C84A 162C000A        	  6917:     move.b  ($000A,A4),D3
                            	  6918:     ; Look up the tile for this sprite.
                            	  6919:     ; If it's not the first one (face), then go write the sprite record.
                            	  6920:     ;
02:0003C84E 41F90003C7CC    	  6921:     lea     (AquamentusTiles).l,A0
02:0003C854 10303000        	  6922:     move.b  (A0,D3.W),D0
02:0003C858 12390003C7CC    	  6923:     move.b  (AquamentusTiles).l,D1
02:0003C85E B001            	  6924:     cmp.b   D1,D0
02:0003C860 6610            	  6925:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6926:     ; Else it's the first one (the face tile).
                            	  6927:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6928:     ;
                            	  6929:     ; $CC/CD shows the closed mouth face.
                            	  6930:     ; $C0/C1 shows the open mouth face.
                            	  6931:     ;
02:0003C862 7600            	  6932:     moveq   #0,D3
02:0003C864 16342028        	  6933:     move.b  ($28,A4,D2.W),D3
02:0003C868 0C030020        	  6934:     cmpi.b  #$20,D3
02:0003C86C 6404            	  6935:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C86E 103C00C0        	  6936:     move.b  #$C0,D0
                            	  6937:     even
                            	  6938: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C872 610E            	  6939:     jsr     WriteBossSprite
                            	  6940:     ; Bottom of the loop.
                            	  6941:     ; Decrement tile index and loop index.
                            	  6942:     ;
02:0003C874 532C000A        	  6943:     subq.b  #1,($000A,A4)
02:0003C878 532C000B        	  6944:     subq.b  #1,($000B,A4)
02:0003C87C 6A00FF7E        	  6945:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C880 4E75            	  6946:     rts
                            	  6947: 
                            	  6948: ; Params:
                            	  6949: ; A: tile
                            	  6950: ; [00]: X
                            	  6951: ; [01]: Y
                            	  6952: ; [03]: sprite attributes
                            	  6953: ;
                            	  6954: ; Save the tile
                            	  6955:     even
                            	  6956: WriteBossSprite:
02:0003C882 1B00            	  6957:     move.b  D0,-(A5)  ; PHA
02:0003C884 7600            	  6958:     moveq   #0,D3
02:0003C886 162C0341        	  6959:     move.b  ($0341,A4),D3
02:0003C88A 41F900031782    	  6960:     lea     (SpriteOffsets).l,A0
02:0003C890 10303000        	  6961:     move.b  (A0,D3.W),D0
02:0003C894 7600            	  6962:     moveq   #0,D3
02:0003C896 1600            	  6963:     move.b  D0,D3
02:0003C898 101D            	  6964:     move.b  (A5)+,D0  ; PLA
02:0003C89A 41EC0201        	  6965:     lea     ($0201,A4),A0
02:0003C89E 11803000        	  6966:     move.b  D0,(A0,D3.W)
02:0003C8A2 1014            	  6967:     move.b  ($0000,A4),D0
02:0003C8A4 41EC0203        	  6968:     lea     ($0203,A4),A0
02:0003C8A8 11803000        	  6969:     move.b  D0,(A0,D3.W)
02:0003C8AC 102C0001        	  6970:     move.b  ($0001,A4),D0
02:0003C8B0 4EF900031B00    	  6971:     jmp     Anim_EndWriteSprite
