                            	  7668:     even
                            	  7669: _L_z01_BeginShove_MonsterDefender:
                            	  7670:     ; A monster is the defender. A weapon is the attacker.
                            	  7671:     ;
                            	  7672:     ; Set the shove direction to the weapon's direction,
                            	  7673:     ; instead of the direction passed in [0B].
                            	  7674:     ;
02:000323F4 41EC0098        	  7675:     lea     ($0098,A4),A0
02:000323F8 10303000        	  7676:     move.b  (A0,D3.W),D0
02:000323FC 19400008        	  7677:     move.b  D0,($0008,A4)
                            	  7678:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7679:     ; combine the shove direction with $40.
                            	  7680:     ;
                            	  7681:     ; TODO:
                            	  7682:     ; But the shoving routing doesn't read this flag.
                            	  7683:     ;
02:00032400 41EC04BF        	  7684:     lea     ($04BF,A4),A0
02:00032404 10302000        	  7685:     move.b  (A0,D2.W),D0
02:00032408 02000080        	  7686:     andi.b #$80,D0
02:0003240C 670C            	  7687:     beq  _anon_z01_102
02:0003240E 102C0008        	  7688:     move.b  ($0008,A4),D0
02:00032412 00000040        	  7689:     ori.b #$40,D0
02:00032416 19400008        	  7690:     move.b  D0,($0008,A4)
                            	  7691: _anon_z01_102:
                            	  7692:     ; If the monster is invincible, then return without shoving.
