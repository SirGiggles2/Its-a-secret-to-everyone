02:0002E378 6100C680        	   741:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E37C 4EB90004BCFC    	   742:     jsr     Link_EndMoveAndDraw_Bank1
                            	   743:     ; If the person's timer has not expired, then return.
