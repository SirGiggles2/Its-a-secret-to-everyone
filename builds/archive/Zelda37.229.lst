                            	 10994: __far_z_04_0105:
                            	 10995: ; Description:
                            	 10996: ; This block applies to heads and the bottom segment of a neck.
                            	 10997: ; These are drawn with sprites that come first in order, so that
                            	 10998: ; they are drawn above all other sprites, including Link.
                            	 10999: ;
                            	 11000: ; Params:
                            	 11001: ; A: tile number
                            	 11002: ;
                            	 11003: ; Normal sprite with level palette row
                            	 11004:     even
                            	 11005: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E65C 7603            	 11006:     moveq   #3,D3
02:0003E65E 19430003        	 11007:     move.b  D3,($0003,A4)
02:0003E662 1B00            	 11008:     move.b  D0,-(A5)  ; PHA
                            	 11009:     ; To calculate the base offset of the sprite record:
                            	 11010:     ; offset := neck index * 8
                            	 11011:     ;
                            	 11012:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11013:     ; at an even index.
                            	 11014:     ;
02:0003E664 102C04D7        	 11015:     move.b  ($04D7,A4),D0
02:0003E668 E308            	 11016:     lsl.b  #1,D0   ; ASL A
02:0003E66A E308            	 11017:     lsl.b  #1,D0   ; ASL A
02:0003E66C E308            	 11018:     lsl.b  #1,D0   ; ASL A
                            	 11019:     ; But if the segment is not a head (not at object slot 5), then
                            	 11020:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11021:     ;
02:0003E66E 0C020005        	 11022:     cmpi.b  #$05,D2
02:0003E672 670A            	 11023:     beq  _anon_z04_139
02:0003E674 023C00EE        	 11024:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E678 123C0020        	 11025:     move.b  #$20,D1
02:0003E67C D101            	 11026:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11027: _anon_z04_139:
02:0003E67E 7600            	 11028:     moveq   #0,D3
02:0003E680 1600            	 11029:     move.b  D0,D3
02:0003E682 101D            	 11030:     move.b  (A5)+,D0  ; PLA
02:0003E684 4EB900031AE4    	 11031:     jsr     Anim_WriteSpecificSprite
02:0003E68A 6026            	 11032:     jmp     Gleeok_CheckCollisions
                            	 11033: 
                            	 11034:     even
                            	 11035: Gleeok_DrawHeadAndCheckCollisions:
02:0003E68C 7405            	 11036:     moveq   #5,D2
                            	 11037:     even
                            	 11038: Gleeok_DrawSegmentAndCheckCollisions:
