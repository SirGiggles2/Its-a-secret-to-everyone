                            	  2115:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2116:     ; which here represents an offset from the palette row.
                            	  2117:     ;
02:0004AC6A 023C00EE        	  2118:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AC6E 122C0004        	  2119:     move.b  ($0004,A4),D1
02:0004AC72 D101            	  2120:     addx.b  D1,D0   ; ADC $04
02:0004AC74 4A02            	  2121:     cmpi.b  #$00,D2
02:0004AC76 66E4            	  2122:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC78 0C000002        	  2123:     cmpi.b  #$02,D0
02:0004AC7C 66DE            	  2124:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC7E 7620            	  2125:     moveq   #32,D3
