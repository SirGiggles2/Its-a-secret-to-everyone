                            	  1817: _L_z01_CopyCommonCodeToRam_Loop:
02:0002EB0C 1214            	  1818:     move.b  ($00,A4),D1   ; ptr lo
02:0002EB0E 182C0001        	  1819:     move.b  ($01,A4),D4  ; ptr hi
02:0002EB12 024100FF        	  1820:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EB16 E14C            	  1821:     lsl.w   #8,D4
02:0002EB18 8841            	  1822:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002EB1A 48C4            	  1823:     ext.l   D4
02:0002EB1C D8BC00FF0000    	  1824:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EB22 2044            	  1825:     movea.l D4,A0
02:0002EB24 10303000        	  1826:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EB28 122C0002        	  1827:     move.b  ($02,A4),D1   ; ptr lo
02:0002EB2C 182C0003        	  1828:     move.b  ($03,A4),D4  ; ptr hi
02:0002EB30 024100FF        	  1829:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EB34 E14C            	  1830:     lsl.w   #8,D4
02:0002EB36 8841            	  1831:     or.w    D1,D4
02:0002EB38 48C4            	  1832:     ext.l   D4
02:0002EB3A D8BC00FF0000    	  1833:     add.l   #NES_RAM,D4
02:0002EB40 2044            	  1834:     movea.l D4,A0
02:0002EB42 11803000        	  1835:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  1836:     ; Increment source address.
                            	  1837:     ;
02:0002EB46 1014            	  1838:     move.b  ($0000,A4),D0
02:0002EB48 023C00EE        	  1839:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EB4C 123C0001        	  1840:     move.b  #$01,D1
02:0002EB50 D101            	  1841:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EB52 1880            	  1842:     move.b  D0,($0000,A4)
02:0002EB54 102C0001        	  1843:     move.b  ($0001,A4),D0
02:0002EB58 123C0000        	  1844:     move.b  #$00,D1
02:0002EB5C D101            	  1845:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EB5E 19400001        	  1846:     move.b  D0,($0001,A4)
                            	  1847:     ; Increment destination address.
                            	  1848:     ;
02:0002EB62 102C0002        	  1849:     move.b  ($0002,A4),D0
02:0002EB66 023C00EE        	  1850:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EB6A 123C0001        	  1851:     move.b  #$01,D1
02:0002EB6E D101            	  1852:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EB70 19400002        	  1853:     move.b  D0,($0002,A4)
02:0002EB74 102C0003        	  1854:     move.b  ($0003,A4),D0
02:0002EB78 123C0000        	  1855:     move.b  #$00,D1
02:0002EB7C D101            	  1856:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EB7E 19400003        	  1857:     move.b  D0,($0003,A4)
02:0002EB82 0C00007F        	  1858:     cmpi.b  #$7F,D0
02:0002EB86 6684            	  1859:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002EB88 102C0002        	  1860:     move.b  ($0002,A4),D0
02:0002EB8C 4A00            	  1861:     cmpi.b  #$00,D0
02:0002EB8E 6600FF7C        	  1862:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002EB92 0A3C0001        	  1863:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
