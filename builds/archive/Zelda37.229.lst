02:0003CF5E 41EC0412        	  7953:     lea     ($0412,A4),A0
02:0003CF62 11802000        	  7954:     move.b  D0,(A0,D2.W)
                            	  7955:     ; Look up the Y offset for the current direction.
                            	  7956:     ; Add it to object Y to set the destination Y of the jump.
                            	  7957:     ;
02:0003CF66 41EC0084        	  7958:     lea     ($0084,A4),A0
02:0003CF6A 10302000        	  7959:     move.b  (A0,D2.W),D0
02:0003CF6E 023C00EE        	  7960:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF72 41F90003CE50    	  7961:     lea     (PolsVoiceDestinationYOffsets).l,A0
