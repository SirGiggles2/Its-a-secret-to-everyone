                            	 13487:     ; [51] HelpDropValue determines which kind:
                            	 13488:     ; - 0:     5 rupees
                            	 13489:     ; - other: bomb
                            	 13490:     ;
02:0003F85C 700F            	 13491:     moveq   #15,D0
02:0003F85E 7600            	 13492:     moveq   #0,D3
02:0003F860 162C0051        	 13493:     move.b  ($0051,A4),D3
02:0003F864 6702            	 13494:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
02:0003F866 7000            	 13495:     moveq   #0,D0
                            	 13496:     even
                            	 13497: _L_z04_SetUpDroppedItem_SetHelpItem:
02:0003F868 1880            	 13498:     move.b  D0,($0000,A4)
