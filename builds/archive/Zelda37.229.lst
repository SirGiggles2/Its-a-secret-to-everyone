                            	  9640:     ; Store the count in [00].
                            	  9641:     ;
02:0003DC3A 7000            	  9642:     moveq   #0,D0
02:0003DC3C 1880            	  9643:     move.b  D0,($0000,A4)
                            	  9644:     even
