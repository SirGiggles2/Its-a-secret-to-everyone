02:0003C35C 10302000        	  6294:     move.b  (A0,D2.W),D0
02:0003C360 0C000004        	  6295:     cmpi.b  #$04,D0
02:0003C364 659E            	  6296:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6297:     ; Restore the original coordinates.
