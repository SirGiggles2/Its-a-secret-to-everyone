                            	   915:     even
                            	   916: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_LoopWare:
                            	   917:     ; If this item is nothing, then loop again.
                            	   918:     ;
02:0002E49A 41EC0422        	   919:     lea     ($0422,A4),A0
02:0002E49E 10302000        	   920:     move.b  (A0,D2.W),D0
02:0002E4A2 0200003F        	   921:     andi.b #$3F,D0
02:0002E4A6 0C00003F        	   922:     cmpi.b  #$3F,D0
02:0002E4AA 6732            	   923:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   924:     ; If Link's X <> item's X, then loop again.
                            	   925:     ;
02:0002E4AC 102C0070        	   926:     move.b  ($0070,A4),D0
02:0002E4B0 41F90002E22A    	   927:     lea     (CaveWareXs).l,A0
02:0002E4B6 12302000        	   928:     move.b  (A0,D2.W),D1
02:0002E4BA B001            	   929:     cmp.b   D1,D0
02:0002E4BC 6620            	   930:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   931:     ; If the vertical distance between Link and the item < 6, then
                            	   932:     ; go try to take it.
                            	   933:     ;
02:0002E4BE 102C0084        	   934:     move.b  ($0084,A4),D0
02:0002E4C2 003C0011        	   935:     ori     #$11,CCR  ; SEC: set C+X
02:0002E4C6 123C0098        	   936:     move.b  #$98,D1
02:0002E4CA 0A3C0010        	   937:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E4CE 9101            	   938:     subx.b  D1,D0   ; SBC #$98
02:0002E4D0 0A3C0010        	   939:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E4D4 61002794        	   940:     jsr     Abs
02:0002E4D8 0C000006        	   941:     cmpi.b  #$06,D0
