02:00039BA2 10342018        	   671:     move.b  ($18,A4,D2.W),D0
02:00039BA6 0C000023        	   672:     cmpi.b  #$23,D0
02:00039BAA 6708            	   673:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:00039BAC 0C000077        	   674:     cmpi.b  #$77,D0
02:00039BB0 6600008E        	   675:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
