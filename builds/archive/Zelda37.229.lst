                            	  5071: 
                            	  5072: ; Each byte describes an item. The high nibble is the type.
                            	  5073: ; The low nibble is the value. Its meaning depends on the type.
                            	  5074: ;
                            	  5075: ; 0x - individuals
                            	  5076: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5077: ; * bit mask: value doesn't matter.
                            	  5078: ;
                            	  5079: ; 1x - amounts
                            	  5080: ; Value is an amount to add.
                            	  5081: ;
                            	  5082: ; 2x - grades
                            	  5083: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5084: ;
                            	  5085: ; 3x - error?
                            	  5086: ; Produces an item value of $FF.
                            	  5087: ;
                            	  5088:     even
