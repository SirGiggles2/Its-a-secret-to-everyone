                            	  4407: GetDirectionsAndDistancesToTarget:
02:00030CBE 1B00            	  4408:     move.b  D0,-(A5)  ; PHA
02:00030CC0 7600            	  4409:     moveq   #0,D3
02:00030CC2 1600            	  4410:     move.b  D0,D3
02:00030CC4 7002            	  4411:     moveq   #2,D0
02:00030CC6 1940000A        	  4412:     move.b  D0,($000A,A4)
02:00030CCA 10343070        	  4413:     move.b  ($70,A4,D3.W),D0
02:00030CCE 7600            	  4414:     moveq   #0,D3
02:00030CD0 16342070        	  4415:     move.b  ($70,A4,D2.W),D3
02:00030CD4 610000C0        	  4416:     jsr     GetOneDirectionAndDistanceToTarget
02:00030CD8 19400003        	  4417:     move.b  D0,($0003,A4)
02:00030CDC 102C000A        	  4418:     move.b  ($000A,A4),D0
02:00030CE0 1940000B        	  4419:     move.b  D0,($000B,A4)
                            	  4420:     ; Handle the vertical.
                            	  4421:     ;
02:00030CE4 101D            	  4422:     move.b  (A5)+,D0  ; PLA
02:00030CE6 7600            	  4423:     moveq   #0,D3
02:00030CE8 1600            	  4424:     move.b  D0,D3
02:00030CEA 7008            	  4425:     moveq   #8,D0
02:00030CEC 1940000A        	  4426:     move.b  D0,($000A,A4)
02:00030CF0 41EC0084        	  4427:     lea     ($0084,A4),A0
02:00030CF4 10303000        	  4428:     move.b  (A0,D3.W),D0
02:00030CF8 7600            	  4429:     moveq   #0,D3
02:00030CFA 41EC0084        	  4430:     lea     ($0084,A4),A0
02:00030CFE 16302000        	  4431:     move.b  (A0,D2.W),D3
02:00030D02 61000092        	  4432:     jsr     GetOneDirectionAndDistanceToTarget
02:00030D06 19400004        	  4433:     move.b  D0,($0004,A4)
02:00030D0A 4E75            	  4434:     rts
                            	  4435: 
                            	  4436: ; Params:
                            	  4437: ; Y: middle speed index (4)
                            	  4438: ; [03]: horizontal distance
                            	  4439: ; [04]: vertical distance
                            	  4440: ; [0A]: vertical direction
                            	  4441: ; [0B]: horizontal direction
                            	  4442: ;
                            	  4443: ; Returns:
                            	  4444: ; Y: speed index (0 to 8) for the angle
                            	  4445: ;
                            	  4446: ;
                            	  4447: ; TODO: call it speed index or angle?
                            	  4448: ; Store the middle speed index in [00]. It will be changed to the
                            	  4449: ; right speed index to use incrementally.
                            	  4450: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4451: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4452: ;
                            	  4453:     even
                            	  4454: _CalcDiagonalSpeedIndex:
02:00030D0C 1883            	  4455:     move.b  D3,($0000,A4)
                            	  4456:     ; Assuming horizontal distance >= vertical distance, the
                            	  4457:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4458:     ;
02:00030D0E 103C00FF        	  4459:     move.b  #$FF,D0
02:00030D12 19400001        	  4460:     move.b  D0,($0001,A4)
                            	  4461:     ; TODO:
                            	  4462:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4463:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4464:     ;
                            	  4465:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4466:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4467:     ; of the farther distance faster.
                            	  4468:     ;
02:00030D16 102C0003        	  4469:     move.b  ($0003,A4),D0
02:00030D1A 122C0004        	  4470:     move.b  ($0004,A4),D1
02:00030D1E B001            	  4471:     cmp.b   D1,D0
02:00030D20 6416            	  4472:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030D22 1B00            	  4473:     move.b  D0,-(A5)  ; PHA
02:00030D24 102C0004        	  4474:     move.b  ($0004,A4),D0
02:00030D28 19400003        	  4475:     move.b  D0,($0003,A4)
02:00030D2C 101D            	  4476:     move.b  (A5)+,D0  ; PLA
02:00030D2E 19400004        	  4477:     move.b  D0,($0004,A4)
02:00030D32 7001            	  4478:     moveq   #1,D0
02:00030D34 19400001        	  4479:     move.b  D0,($0001,A4)
                            	  4480:     even
                            	  4481: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4482:     ; TODO: call it speed index or angle?
                            	  4483:     ; If the difference in distances is within 8 pixels,
                            	  4484:     ; return the speed index (angle) we have.
                            	  4485:     ;
02:00030D38 102C0003        	  4486:     move.b  ($0003,A4),D0
02:00030D3C 003C0011        	  4487:     ori     #$11,CCR  ; SEC: set C+X
02:00030D40 122C0004        	  4488:     move.b  ($0004,A4),D1
02:00030D44 0A3C0010        	  4489:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030D48 9101            	  4490:     subx.b  D1,D0   ; SBC $04
02:00030D4A 0A3C0010        	  4491:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D4E 0C000008        	  4492:     cmpi.b  #$08,D0
02:00030D52 6538            	  4493:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4494:     even
                            	  4495: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4496:     ; TODO: call it speed index or angle?
                            	  4497:     ; Otherwise, go to the next speed index (angle).
                            	  4498:     ;
02:00030D54 1014            	  4499:     move.b  ($0000,A4),D0
02:00030D56 023C00EE        	  4500:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D5A 122C0001        	  4501:     move.b  ($0001,A4),D1
02:00030D5E D101            	  4502:     addx.b  D1,D0   ; ADC $01
02:00030D60 1880            	  4503:     move.b  D0,($0000,A4)
                            	  4504:     ; TODO: call it speed index or angle?
                            	  4505:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4506:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4507:     ;
02:00030D62 6728            	  4508:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030D64 0C000008        	  4509:     cmpi.b  #$08,D0
02:00030D68 6722            	  4510:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4511:     ; Subtract the lesser distance from the greater distance.
                            	  4512:     ; If they still haven't crossed, then we can turn more.
                            	  4513:     ;
02:00030D6A 102C0003        	  4514:     move.b  ($0003,A4),D0
02:00030D6E 003C0011        	  4515:     ori     #$11,CCR  ; SEC: set C+X
02:00030D72 122C0004        	  4516:     move.b  ($0004,A4),D1
02:00030D76 0A3C0010        	  4517:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030D7A 9101            	  4518:     subx.b  D1,D0   ; SBC $04
02:00030D7C 0A3C0010        	  4519:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D80 19400003        	  4520:     move.b  D0,($0003,A4)
02:00030D84 122C0004        	  4521:     move.b  ($0004,A4),D1
02:00030D88 B001            	  4522:     cmp.b   D1,D0
02:00030D8A 64C8            	  4523:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4524:     even
                            	  4525: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4526:     ; TODO: call it speed index or angle?
                            	  4527:     ; Return the speed index (angle) we found.
                            	  4528:     ;
02:00030D8C 7600            	  4529:     moveq   #0,D3
02:00030D8E 1614            	  4530:     move.b  ($0000,A4),D3
02:00030D90 4E75            	  4531:     rts
                            	  4532: 
