02:0003BB8E 41EC0084        	  5224:     lea     ($0084,A4),A0
02:0003BB92 10302000        	  5225:     move.b  (A0,D2.W),D0
02:0003BB96 19400084        	  5226:     move.b  D0,($0084,A4)
02:0003BB9A 4EB90004BCF4    	  5227:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BBA0 4EB900030A08    	  5228:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BBA6 7400            	  5229:     moveq   #0,D2
