02:0003F82E 122C052A        	 13466:     move.b  ($052A,A4),D1
02:0003F832 D101            	 13467:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0003F834 7600            	 13468:     moveq   #0,D3
02:0003F836 1600            	 13469:     move.b  D0,D3
