02:00030DFA 41EC00AC        	  4589:     lea     ($00AC,A4),A0
02:00030DFE 10302000        	  4590:     move.b  (A0,D2.W),D0
02:00030E02 670E            	  4591:     beq  _L_z01_WieldBomb_FoundSlot
02:00030E04 020000F0        	  4592:     andi.b #$F0,D0
02:00030E08 0C000010        	  4593:     cmpi.b  #$10,D0
