02:00030380 023C00EE        	  3004:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  3005:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  3006:     ;
02:00030384 122C0340        	  3007:     move.b  ($0340,A4),D1
02:00030388 D101            	  3008:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003038A 7400            	  3009:     moveq   #0,D2
02:0003038C 1400            	  3010:     move.b  D0,D2
