                            	   223: UpdateMenuCommon1:
02:00040066 4EB90004A984    	   224:     jsr     HideAllSprites
02:0004006C 4EB900030FA8    	   225:     jsr     UpdatePlayerPositionMarker
02:00040072 4EB90004AAA0    	   226:     jsr     UpdateTriforcePositionMarker
                            	   227:     ; Move position markers and hardware vertical scroll position
                            	   228:     ; down 1 pixel.
                            	   229:     ;
                            	   230:     ; Because we'll be above the top of NT 0, switch to NT 2 to
                            	   231:     ; be at the bottom of NT 2.
                            	   232:     ;
02:00040078 103C00EF        	   233:     move.b  #$EF,D0
02:0004007C 194000FC        	   234:     move.b  D0,($00FC,A4)
02:00040080 1940005C        	   235:     move.b  D0,($005C,A4)
02:00040084 7001            	   236:     moveq   #1,D0
02:00040086 610001A4        	   237:     jsr     MovePositionMarkers
02:0004008A 522C00E1        	   238:     addq.b  #1,($00E1,A4)
                            	   239:     ; SubmenuScrollProgress begins at $2B. Each frame it will be
                            	   240:     ; decremented. It encodes a submenu row index in bits 1 to 7,
                            	   241:     ; and a flag in bit 0.
                            	   242:     ;
                            	   243:     ; When the flag is 1, a full row of black tiles will be transferred
                            	   244:     ; at the current row. Otherwise, one of various static visual
                            	   245:     ; elements will be transferred.
                            	   246:     ;
                            	   247:     ; For example:
                            	   248:     ; 1. In the first frame of scrolling, $2B indicates that a full row
                            	   249:     ;    of black tiles must be transferred to row $15.
                            	   250:     ; 2. In the second frame ($2A), submenu row will again be
                            	   251:     ;    $15, but something else will be transferred.
                            	   252:     ; 3. In the third frame ($29), a full row of black tiles will be
                            	   253:     ;    transferred to row $14.
                            	   254:     ;
02:0004008E 702B            	   255:     moveq   #43,D0
02:00040090 1940005E        	   256:     move.b  D0,($005E,A4)
                            	   257:     ; In UW, this variable will be used to scan every room in order
                            	   258:     ; to build the big sheet map in the submenu. It will range
                            	   259:     ; from $7F to 0.
                            	   260:     ;
02:00040094 707F            	   261:     moveq   #127,D0
02:00040096 1940005D        	   262:     move.b  D0,($005D,A4)
                            	   263:     even
                            	   264: UpdateMenu_Return:
02:0004009A 4E75            	   265:     rts
                            	   266: 
                            	   267:     even
                            	   268: UpdateMenuCommon2:
                            	   269:     ; Cue the transfer of first set of submenu nametable attributes to NT 2.
                            	   270:     ; Advance state.
                            	   271:     ;
02:0004009C 7048            	   272:     moveq   #72,D0
                            	   273:     even
                            	   274: SelectTransferBufAndIncState:
02:0004009E 4EF90002BEB0    	   275:     jmp     c_select_transfer_buf_and_inc_state
                            	   276: 
                            	   277: _anon_z05_1:
02:000400A4 522C00E1        	   278:     addq.b  #1,($00E1,A4)
02:000400A8 4E75            	   279:     rts
                            	   280: 
                            	   281:     even
                            	   282: UpdateMenuCommon3:
                            	   283:     ; Cue the transfer of second set of submenu nametable attributes to NT 2.
                            	   284:     ; Advance state.
                            	   285:     ;
02:000400AA 704A            	   286:     moveq   #74,D0
02:000400AC 6702            	   287:     beq.s  __far_z_05_0000
02:000400AE 60EE            	   288:     jmp  SelectTransferBufAndIncState
                            	   289: __far_z_05_0000:
                            	   290:     even
                            	   291: UpdateMenuCommon4:
                            	   292:     ; Cue the transfer of a blank row of tiles to the bottom of NT 2.
                            	   293:     ; Advance state.
                            	   294:     ;
02:000400B0 704C            	   295:     moveq   #76,D0
02:000400B2 6702            	   296:     beq.s  __far_z_05_0001
02:000400B4 60E8            	   297:     jmp  SelectTransferBufAndIncState
                            	   298: __far_z_05_0001:
                            	   299:     even
