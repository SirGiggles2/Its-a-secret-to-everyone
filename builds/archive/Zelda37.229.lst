02:00039BD6 103C0080        	   704:     move.b  #$80,D0
02:00039BDA 41EC00AC        	   705:     lea     ($00AC,A4),A0
02:00039BDE 11802000        	   706:     move.b  D0,(A0,D2.W)
                            	   707:     ; Reset the "wants to shoot" flag.
                            	   708:     ;
02:00039BE2 7000            	   709:     moveq   #0,D0
02:00039BE4 41EC0412        	   710:     lea     ($0412,A4),A0
02:00039BE8 11802000        	   711:     move.b  D0,(A0,D2.W)
                            	   712:     ; Have the shot keep track of the monster.
                            	   713:     ;
02:00039BEC 1002            	   714:     move.b  D2,D0
02:00039BEE 41EC042C        	   715:     lea     ($042C,A4),A0
02:00039BF2 11803000        	   716:     move.b  D0,(A0,D3.W)
                            	   717:     ; Have the monster keep track of the shot.
                            	   718:     ;
02:00039BF6 1003            	   719:     move.b  D3,D0
02:00039BF8 41EC042C        	   720:     lea     ($042C,A4),A0
02:00039BFC 11802000        	   721:     move.b  D0,(A0,D2.W)
                            	   722:     ; Set the shot's state to $10, which is the flying state for them.
