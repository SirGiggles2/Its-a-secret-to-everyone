02:00040042 000402B6        	   212:     dc.l    UpdateMenuStartOW   ; jump table entry (32-bit for _m68k_tablejump)
02:00040046 00040066        	   213:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:0004004A 0004009C        	   214:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:0004004E 000400AA        	   215:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
02:00040052 000400B0        	   216:     dc.l    UpdateMenuCommon4   ; jump table entry (32-bit for _m68k_tablejump)
02:00040056 000400BC        	   217:     dc.l    UpdateMenu5OW   ; jump table entry (32-bit for _m68k_tablejump)
02:0004005A 000400C2        	   218:     dc.l    UpdateMenuScrollDownOW   ; jump table entry (32-bit for _m68k_tablejump)
02:0004005E 00040184        	   219:     dc.l    UpdateMenuActive   ; jump table entry (32-bit for _m68k_tablejump)
