                            	   203: InitCave:
                            	   204:     ; The person goes at location ($78, $80).
                            	   205:     ;
02:0002DFC0 7078            	   206:     moveq   #120,D0
02:0002DFC2 163C0080        	   207:     move.b  #$80,D3
02:0002DFC6 610001A0        	   208:     jsr     SetUpCommonCaveObjects
                            	   209:     ; If the cave/person does not remember state (give item, door charge),
                            	   210:     ; then go handle other kinds.
                            	   211:     ;
02:0002DFCA 102C0350        	   212:     move.b  ($0350,A4),D0
02:0002DFCE 0C000072        	   213:     cmpi.b  #$72,D0
02:0002DFD2 6714            	   214:     beq  _L_z01_InitCave_TakeType
02:0002DFD4 0C000071        	   215:     cmpi.b  #$71,D0
02:0002DFD8 670E            	   216:     beq  _L_z01_InitCave_TakeType
02:0002DFDA 0C00007B        	   217:     cmpi.b  #$7B,D0
02:0002DFDE 6408            	   218:     bcc  _L_z01_InitCave_TakeType
02:0002DFE0 0C00006E        	   219:     cmpi.b  #$6E,D0
02:0002DFE4 6502            	   220:     bcs.s  __far_z_01_0000
02:0002DFE6 6012            	   221:     jmp  InitCaveContinue
                            	   222: __far_z_01_0000:
                            	   223:     even
                            	   224: _L_z01_InitCave_TakeType:
                            	   225:     ; Else the cave/person simply does:
                            	   226:     ; - taken:     no person, no text
                            	   227:     ; - not taken: show a person and text
                            	   228:     ;
                            	   229:     ; So, if the item was not taken, then go set up the text.
                            	   230:     ;
02:0002DFE8 61003178        	   231:     jsr     GetRoomFlagUWItemState
02:0002DFEC 6602            	   232:     bne.s  __far_z_01_0001
02:0002DFEE 600A            	   233:     jmp  InitCaveContinue
                            	   234: __far_z_01_0001:
                            	   235:     ; Otherwise destroy the person object, and let Link continue.
                            	   236:     ;
02:0002DFF0 7000            	   237:     moveq   #0,D0
02:0002DFF2 19400350        	   238:     move.b  D0,($0350,A4)
                            	   239:     even
                            	   240: UnhaltLink:
02:0002DFF6 6000D9F6        	   241:     jmp     c_unhalt_link
                            	   242: 
                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002DFFA 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002DFFE 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E002 123C006A        	   248:     move.b  #$6A,D1
02:0002E006 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E00A 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E00C 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E010 7600            	   252:     moveq   #0,D3
02:0002E012 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E014 41F90002DF92    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E01A 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E01E 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E020 0200003F        	   260:     andi.b #$3F,D0
02:0002E024 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E028 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E02A 020000C0        	   266:     andi.b #$C0,D0
02:0002E02E 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
