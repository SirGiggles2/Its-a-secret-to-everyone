                            	   613: ;==============================================================================
                            	   614: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   615: ;==============================================================================
                            	   616: 
                            	   617: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   618: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   619: c_split_room_id:
02:0002B6EC 4EB900000000    	   620:     jsr     z05_split_room_id
02:0002B6F2 7600            	   621:     moveq   #0,D3
02:0002B6F4 1600            	   622:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   623:     lsr.w   #8,D0
02:0002B6F8 7400            	   624:     moveq   #0,D2
02:0002B6FA 1400            	   625:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   626:     rts
                            	   627: 
                            	   628: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   629: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   630: c_is_dark_room:
02:0002B6FE 7000            	   631:     moveq   #0,D0
02:0002B700 3003            	   632:     move.w  D3,D0
02:0002B702 2F00            	   633:     move.l  D0,-(SP)
02:0002B704 4EB900000000    	   634:     jsr     z05_is_dark_room
02:0002B70A 588F            	   635:     addq.l  #4,SP
02:0002B70C 4A00            	   636:     tst.b   D0
02:0002B70E 4E75            	   637:     rts
                            	   638: 
                            	   639: ; SetDoorFlag — D2=dir_idx. Calls get_room_flags internally, writes flag.
                            	   640: c_set_door_flag:
02:0002B710 7000            	   641:     moveq   #0,D0
02:0002B712 3002            	   642:     move.w  D2,D0
02:0002B714 2F00            	   643:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	   644:     jsr     z05_set_door_flag
02:0002B71C 588F            	   645:     addq.l  #4,SP
02:0002B71E 4E75            	   646:     rts
                            	   647: 
