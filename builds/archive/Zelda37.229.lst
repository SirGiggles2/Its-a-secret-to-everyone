02:00031E2E 003C0011        	  6701:     ori     #$11,CCR  ; SEC: set C+X
02:00031E32 122C000E        	  6702:     move.b  ($000E,A4),D1
02:00031E36 0A3C0010        	  6703:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E3A 9101            	  6704:     subx.b  D1,D0   ; SBC $0E
02:00031E3C 0A3C0010        	  6705:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E40 19400670        	  6706:     move.b  D0,($0670,A4)
                            	  6707:     ; If full hearts >= high damage points byte, then simply
                            	  6708:     ; subtract the damage byte from full hearts.
                            	  6709:     ; Else go handle Link dying.
