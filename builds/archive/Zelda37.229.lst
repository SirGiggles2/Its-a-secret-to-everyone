02:00045362 11803000        	  9107:     move.b  D0,(A0,D3.W)
02:00045366 4E75            	  9108:     rts
                            	  9109: 
                            	  9110: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  9111: ; based on doorway type and room flags. Each call will shift the next
                            	  9112: ; doorway state bit into OpenDoorwayMask.
                            	  9113: ;
                            	  9114: ; Params:
                            	  9115: ; A: door attribute
                            	  9116: ; X: direction index
                            	  9117: ;
                            	  9118: ; Returns:
                            	  9119: ; A: untouched
