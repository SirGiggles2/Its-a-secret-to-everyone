                            	  4147: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4148:     ; If the current heart's state <> 0, then go move it.
                            	  4149:     ; Else we have to wait for it to come out at the right time.
                            	  4150:     ;
02:0003B3AC 41EC00AC        	  4151:     lea     ($00AC,A4),A0
02:0003B3B0 10302000        	  4152:     move.b  (A0,D2.W),D0
02:0003B3B4 667C            	  4153:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4154:     ; The current heart's state = 0.
                            	  4155:     ;
                            	  4156:     ; If object slot = 2, then go make it appear. This is the first
                            	  4157:     ; heart to show up.
                            	  4158:     ;
02:0003B3B6 0C020002        	  4159:     cmpi.b  #$02,D2
02:0003B3BA 6732            	  4160:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4161:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4162:     ; go start over.
                            	  4163:     ;
                            	  4164:     ; TODO:
                            	  4165:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4166:     ;
02:0003B3BC 102C00AE        	  4167:     move.b  ($00AE,A4),D0
02:0003B3C0 67EA            	  4168:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4169:     ; Look up the starting angle of this heart with the index
                            	  4170:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4171:     ; then loop again.
                            	  4172:     ;
02:0003B3C2 1002            	  4173:     move.b  D2,D0
02:0003B3C4 003C0011        	  4174:     ori     #$11,CCR  ; SEC: set C+X
02:0003B3C8 123C0003        	  4175:     move.b  #$03,D1
02:0003B3CC 0A3C0010        	  4176:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B3D0 9101            	  4177:     subx.b  D1,D0   ; SBC #$03
02:0003B3D2 0A3C0010        	  4178:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B3D6 7600            	  4179:     moveq   #0,D3
02:0003B3D8 1600            	  4180:     move.b  D0,D3
02:0003B3DA 102C0396        	  4181:     move.b  ($0396,A4),D0
02:0003B3DE 41F90003B3A2    	  4182:     lea     (PondHeartStartAngles).l,A0
02:0003B3E4 12303000        	  4183:     move.b  (A0,D3.W),D1
02:0003B3E8 B001            	  4184:     cmp.b   D1,D0
02:0003B3EA 66000086        	  4185:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4186:     even
