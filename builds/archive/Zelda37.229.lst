                            	  4041: __far_z_04_0037:
                            	  4042:     ; State 0.
                            	  4043:     ;
                            	  4044:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4045:     ;
02:0003B326 102C0084        	  4046:     move.b  ($0084,A4),D0
