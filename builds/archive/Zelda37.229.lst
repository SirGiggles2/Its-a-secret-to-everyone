02:0003B050 4EB90004CDE0    	  3588:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3589:     ; If facing down, then use frame image offset 2.
                            	  3590:     ;
02:0003B056 41EC0098        	  3591:     lea     ($0098,A4),A0
02:0003B05A 10302000        	  3592:     move.b  (A0,D2.W),D0
02:0003B05E 7600            	  3593:     moveq   #0,D3
02:0003B060 1600            	  3594:     move.b  D0,D3
02:0003B062 0200000C        	  3595:     andi.b #$0C,D0
02:0003B066 670C            	  3596:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003B068 7002            	  3597:     moveq   #2,D0
02:0003B06A 0C030008        	  3598:     cmpi.b  #$08,D3
02:0003B06E 6610            	  3599:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3600:     ; Else facing up. Use frame image offset 1.
                            	  3601:     ;
