                            	  6727: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6728:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6729:     ;   full heart=4 partial heart=$70
                            	  6730:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6731:     ; But the method here yields $3EF, because partial heart is
                            	  6732:     ; considered full when = $FF instead of $100.
                            	  6733:     ;
02:00031E74 102C000E        	  6734:     move.b  ($000E,A4),D0
02:00031E78 003C0011        	  6735:     ori     #$11,CCR  ; SEC: set C+X
02:00031E7C 122C0670        	  6736:     move.b  ($0670,A4),D1
02:00031E80 0A3C0010        	  6737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E84 9101            	  6738:     subx.b  D1,D0   ; SBC HeartPartial
02:00031E86 0A3C0010        	  6739:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E8A 1940000E        	  6740:     move.b  D0,($000E,A4)
02:00031E8E 102C066F        	  6741:     move.b  ($066F,A4),D0
02:00031E92 0200000F        	  6742:     andi.b #$0F,D0
02:00031E96 6710            	  6743:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031E98 532C066F        	  6744:     subq.b  #1,($066F,A4)
02:00031E9C 103C00FF        	  6745:     move.b  #$FF,D0
02:00031EA0 19400670        	  6746:     move.b  D0,($0670,A4)
02:00031EA4 6600FF6E        	  6747:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6748:     even
                            	  6749: _L_z01_Link_BeHarmed_HandleDied:
                            	  6750:     ; Link died.
                            	  6751:     ;
                            	  6752:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6753:     ; Make Link face down.
                            	  6754:     ; Go to mode $11.
                            	  6755:     ;
02:00031EA8 102C066F        	  6756:     move.b  ($066F,A4),D0
02:00031EAC 020000F0        	  6757:     andi.b #$F0,D0
02:00031EB0 1940066F        	  6758:     move.b  D0,($066F,A4)
02:00031EB4 4EB90004B366    	  6759:     jsr     EndGameMode
02:00031EBA 19400670        	  6760:     move.b  D0,($0670,A4)
02:00031EBE 194000AC        	  6761:     move.b  D0,($00AC,A4)
02:00031EC2 7011            	  6762:     moveq   #17,D0
02:00031EC4 19400012        	  6763:     move.b  D0,($0012,A4)
02:00031EC8 7004            	  6764:     moveq   #4,D0
02:00031ECA 19400098        	  6765:     move.b  D0,($0098,A4)
                            	  6766: _anon_z01_87:
02:00031ECE 4E75            	  6767:     rts
                            	  6768: 
                            	  6769: ; Params:
                            	  6770: ; X: monster slot
                            	  6771: ; Y: weapon slot
                            	  6772: ; [02]: monster mid X
                            	  6773: ; [03]: monster mid Y
                            	  6774: ;
                            	  6775: ; Returns:
                            	  6776: ; [00]: weapon slot
                            	  6777: ;
