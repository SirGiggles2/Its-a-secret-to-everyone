02:0003BAD0 19400012        	  5130:     move.b  D0,($0012,A4)
02:0003BAD4 7000            	  5131:     moveq   #0,D0
02:0003BAD6 194000AC        	  5132:     move.b  D0,($00AC,A4)
02:0003BADA 19400011        	  5133:     move.b  D0,($0011,A4)
02:0003BADE 19400013        	  5134:     move.b  D0,($0013,A4)
                            	  5135:     even
