02:0004C61C 41EC00AC        	  5816:     lea     ($00AC,A4),A0
02:0004C620 52302000        	  5817:     addq.b  #1,(A0,D2.W)
02:0004C624 41EC00AC        	  5818:     lea     ($00AC,A4),A0
02:0004C628 10302000        	  5819:     move.b  (A0,D2.W),D0
02:0004C62C 02000077        	  5820:     andi.b #$77,D0
02:0004C630 41EC00AC        	  5821:     lea     ($00AC,A4),A0
02:0004C634 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004C638 0C02000D        	  5823:     cmpi.b  #$0D,D2
02:0004C63C 6402            	  5824:     bcc.s  __far_z_07_0088
02:0004C63E 6032            	  5825:     jmp  CalcBoomerangFrame
                            	  5826: __far_z_07_0088:
02:0004C640 7602            	  5827:     moveq   #2,D3
02:0004C642 4EB900030886    	  5828:     jsr     PlayBoomerangSfx
