02:00030366 19400001        	  2982:     move.b  D0,($0001,A4)
                            	  2983:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2984:     ;
02:0003036A 7605            	  2985:     moveq   #5,D3
                            	  2986:     ; The individual trap objects to make will be of type $49.
                            	  2987:     ; Store it in [00].
