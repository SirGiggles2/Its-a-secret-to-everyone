                            	 11216: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11217:     ; The whole gleeok died, because the last neck died.
                            	 11218:     ;
                            	 11219:     ; First, hide the first $10 sprites: the attached heads.
                            	 11220:     ;
02:0003E7DC 4EB9000314DC    	 11221:     jsr     WriteBlankPrioritySprites
02:0003E7E2 61000F5C        	 11222:     jsr     PlayBossDeathCry
                            	 11223:     ; We want a death spark. So, set the metastate of the first
                            	 11224:     ; monster slot to $11.
                            	 11225:     ;
02:0003E7E6 7011            	 11226:     moveq   #17,D0
02:0003E7E8 19400406        	 11227:     move.b  D0,($0406,A4)
                            	 11228:     ; Reset the object type of slots 2 to $A.
                            	 11229:     ;
                            	 11230:     ; Beware a left over fireball in slot $B!
                            	 11231:     ;
02:0003E7EC 7601            	 11232:     moveq   #1,D3
                            	 11233:     even
                            	 11234: _L_z04_Gleeok_CheckCollisions_DestroyFireballs:
