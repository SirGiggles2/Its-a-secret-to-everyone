02:0003AF58 41EC0098        	  3473:     lea     ($0098,A4),A0
02:0003AF5C 10302000        	  3474:     move.b  (A0,D2.W),D0
02:0003AF60 1940000F        	  3475:     move.b  D0,($000F,A4)
