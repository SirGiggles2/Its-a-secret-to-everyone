02:00039B8C 41EC034F        	   661:     lea     ($034F,A4),A0
02:00039B90 16302000        	   662:     move.b  (A0,D2.W),D3
02:00039B94 0C030005        	   663:     cmpi.b  #$05,D3
02:00039B98 671C            	   664:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   665:     ; If it's not a red goriya either, then return.
                            	   666:     ;
02:00039B9A 0C030006        	   667:     cmpi.b  #$06,D3
02:00039B9E 660000A0        	   668:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   669:     ; If a random value <> $23 nor $77, then return.
