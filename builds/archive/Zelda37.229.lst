                            	   460: ;------------------------------------------------------------------------------
                            	   461: ; _c_move_object_shim — MoveObject trampoline.
                            	   462: ;
                            	   463: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   464: ;   Input:     D2 = slot (0..11)
                            	   465: ;   Preserves: D2, A4, A5
                            	   466: ;   Clobbers:  D0, D1, D3, A0
                            	   467: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   468: ;
                            	   469: ; GCC side:
                            	   470: ;   void c_move_object(unsigned short slot);
                            	   471: ;     slot arrives as a 16-bit value on the stack.
                            	   472: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   473: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   474: ;   never clobbered by gcc.
                            	   475: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   476: ;   semantics can exist in a pure C port).
                            	   477: ;------------------------------------------------------------------------------
                            	   478: _c_move_object_shim:
                            	   479:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   480:     move.b  #$AA,($0900,A4)
                            	   481:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   482:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   483:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   484:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   485:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   486:     moveq   #0,D0
02:0002B658 3002            	   487:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   488:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   489:     jsr     c_move_object
02:0002B662 588F            	   490:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   491:     rts
                            	   492: 
                            	   493: ;==============================================================================
                            	   494: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   495: ; and tail-call the native asm function.
                            	   496: ;
                            	   497: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   498: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   499: ; sign-extended).
                            	   500: ;==============================================================================
                            	   501: 
                            	   502: ;------------------------------------------------------------------------------
                            	   503: ; void c_copy_bank_to_window(unsigned int bank);
                            	   504: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   505: ;------------------------------------------------------------------------------
                            	   506: c_copy_bank_to_window:
02:0002B666 202F0004        	   507:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   508:     jmp     _copy_bank_to_window
                            	   509: 
                            	   510: ;------------------------------------------------------------------------------
                            	   511: ; unsigned char c_ppu_read_2(void);
                            	   512: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   513: ; C return: gcc expects result in D0.
                            	   514: ;------------------------------------------------------------------------------
                            	   515: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   516:     jmp     _ppu_read_2
                            	   517: 
                            	   518: ;------------------------------------------------------------------------------
                            	   519: ; void c_ppu_write_6(unsigned int val);
                            	   520: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   521: ;------------------------------------------------------------------------------
                            	   522: c_ppu_write_6:
02:0002B674 202F0004        	   523:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   524:     jmp     _ppu_write_6
                            	   525: 
                            	   526: ;------------------------------------------------------------------------------
                            	   527: ; void c_ppu_write_7(unsigned int val);
                            	   528: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   529: ;------------------------------------------------------------------------------
                            	   530: c_ppu_write_7:
02:0002B67E 202F0004        	   531:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   532:     jmp     _ppu_write_7
                            	   533: 
                            	   534: ;------------------------------------------------------------------------------
                            	   535: ; void c_turn_off_all_video(void);
                            	   536: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   537: ;------------------------------------------------------------------------------
                            	   538: c_turn_off_all_video:
02:0002B688 4EF90004A9D4    	   539:     jmp     TurnOffAllVideo
                            	   540: 
                            	   541: ;==============================================================================
                            	   542: ; EXPORT side — z_03 entry point.
                            	   543: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   544: ; the transpiler emits that label pointing to this shim instead of the
                            	   545: ; z_03 asm body. The C function takes no args and returns void.
                            	   546: ;==============================================================================
                            	   547: 
                            	   548: ;------------------------------------------------------------------------------
                            	   549: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   550: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   551: ;------------------------------------------------------------------------------
                            	   552: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   553:     jmp     z03_transfer_level_pattern_blocks
                            	   554: 
