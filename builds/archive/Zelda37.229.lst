02:0004000E 4EB90002AECA    	   192:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	   193:     even
                            	   194: UpdateMenuUW_JumpTable:
02:00040014 0004009A        	   195:     dc.l    UpdateMenu_Return   ; jump table entry (32-bit for _m68k_tablejump)
02:00040018 00040066        	   196:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:0004001C 0004009C        	   197:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:00040020 000400AA        	   198:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
