02:00031D60 0200000C        	  6584:     andi.b #$0C,D0
02:00031D64 0C00000C        	  6585:     cmpi.b  #$0C,D0
02:00031D68 671A            	  6586:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
