02:0003B4C4 123C0003        	  4300:     move.b  #$03,D1
02:0003B4C8 D101            	  4301:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003B4CA 003C0011        	  4302:     ori     #$11,CCR  ; SEC: set C+X
02:0003B4CE 41EC0084        	  4303:     lea     ($0084,A4),A0
02:0003B4D2 12302000        	  4304:     move.b  (A0,D2.W),D1
02:0003B4D6 0A3C0010        	  4305:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B4DA 9101            	  4306:     subx.b  D1,D0   ; SBC ObjY,X
02:0003B4DC 0A3C0010        	  4307:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B4E0 6A0E            	  4308:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  4309:     ; Else negate it, and indicate Link is "up" from the object.
