                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:00033610 4EB90004A9D4    	   518:     jsr     TurnOffAllVideo
02:00033616 7000            	   519:     moveq   #0,D0
02:00033618 19400016        	   520:     move.b  D0,($0016,A4)
02:0003361C 6100D228        	   521:     jsr     FetchFileAAddressSet
02:00033620 7602            	   522:     moveq   #2,D3
                            	   523:     even
                            	   524: _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot:
02:00033622 122C0006        	   525:     move.b  ($06,A4),D1   ; ptr lo
02:00033626 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:0003362A 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003362E E14C            	   528:     lsl.w   #8,D4
02:00033630 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033632 48C4            	   530:     ext.l   D4
02:00033634 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003363A 2044            	   532:     movea.l D4,A0
02:0003363C 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033640 41EC0633        	   534:     lea     ($0633,A4),A0
02:00033644 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033648 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:0003364A 1003            	   537:     move.b  D3,D0
02:0003364C 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003364E 19430016        	   539:     move.b  D3,($0016,A4)
02:00033652 6100D1F2        	   540:     jsr     FetchFileAAddressSet
02:00033656 61001C46        	   541:     jsr     FormatFileA
02:0003365A 7000            	   542:     moveq   #0,D0
02:0003365C 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:00033660 6100D1E4        	   550:     jsr     FetchFileAAddressSet
02:00033664 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00033666 7600            	   552:     moveq   #0,D3
02:00033668 1600            	   553:     move.b  D0,D3
                            	   554:     even
