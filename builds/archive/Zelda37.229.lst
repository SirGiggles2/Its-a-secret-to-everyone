                            	  1901: UpdateStatues:
                            	  1902:     ; If person fireballs are enabled (from the two fires), then
                            	  1903:     ; go make fireballs with pattern 2.
                            	  1904:     ;
02:0003A488 7602            	  1905:     moveq   #2,D3
02:0003A48A 102C04CC        	  1906:     move.b  ($04CC,A4),D0
02:0003A48E 6620            	  1907:     bne  _L_z04_UpdateStatues_Shoot
                            	  1908:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1909:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1910:     ; - layout $23: pattern 1: 2 statues
                            	  1911:     ; - layout $24: pattern 0: 4 statues
                            	  1912:     ;
02:0003A490 4EB90004ADF2    	  1913:     jsr     GetUniqueRoomId
02:0003A496 7601            	  1914:     moveq   #1,D3
                            	  1915: _anon_z04_30:
02:0003A498 41F90003A46A    	  1916:     lea     (StatueRoomLayouts).l,A0
02:0003A49E 12303000        	  1917:     move.b  (A0,D3.W),D1
02:0003A4A2 B001            	  1918:     cmp.b   D1,D0
02:0003A4A4 670A            	  1919:     beq  _L_z04_UpdateStatues_Shoot
02:0003A4A6 5303            	  1920:     subq.b  #1,D3
02:0003A4A8 6AEE            	  1921:     bpl  _anon_z04_30
02:0003A4AA 0A3C0001        	  1922:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A4AE 4E75            	  1923:     rts
