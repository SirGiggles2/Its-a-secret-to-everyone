                            	  8416: ; Description:
                            	  8417: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8418: ; When walking, the object timer is set. When teleporting,
                            	  8419: ; the teleporting distance remaining is set.
                            	  8420: ;
                            	  8421: ; If we have the magic clock, then only go draw and check collisions.
                            	  8422: ;
                            	  8423:     even
                            	  8424: UpdateBlueWizzrobe:
02:0003D348 102C066C        	  8425:     move.b  ($066C,A4),D0
