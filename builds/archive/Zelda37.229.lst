02:0003B014 41EC034F        	  3561:     lea     ($034F,A4),A0
02:0003B018 16302000        	  3562:     move.b  (A0,D2.W),D3
02:0003B01C 0C030009        	  3563:     cmpi.b  #$09,D3
02:0003B020 6402            	  3564:     bcc  _anon_z04_48
02:0003B022 7070            	  3565:     moveq   #112,D0
                            	  3566: _anon_z04_48:
