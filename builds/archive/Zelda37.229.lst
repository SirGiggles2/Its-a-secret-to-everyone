                            	  3959:     ; Set the spawn cell to the one we found.
                            	  3960:     ;
02:00041F14 102C000A        	  3961:     move.b  ($000A,A4),D0
02:00041F18 19400525        	  3962:     move.b  D0,($0525,A4)
