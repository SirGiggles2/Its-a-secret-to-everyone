                            	  4855:     ;
02:00030F7E 7600            	  4856:     moveq   #0,D3
02:00030F80 16342028        	  4857:     move.b  ($28,A4,D2.W),D3
                            	  4858:     ; At times $16 and $11, rotate carry=1 to the low bit.
