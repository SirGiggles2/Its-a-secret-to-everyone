02:00031D00 19400004        	  6531:     move.b  D0,($0004,A4)
02:00031D04 102C0084        	  6532:     move.b  ($0084,A4),D0
02:00031D08 023C00EE        	  6533:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D0C 123C0008        	  6534:     move.b  #$08,D1
