02:00041972 6748            	  3090:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3091:     ; The direction is negative (left or up).
                            	  3092:     ;
                            	  3093:     ; If the coordinate does not cross (<) the boundary, then
                            	  3094:     ; go set mask $FF, so that no button is excluded.
                            	  3095:     ;
02:00041974 102C0002        	  3096:     move.b  ($0002,A4),D0
02:00041978 41F9000418EC    	  3097:     lea     (BorderBounds).l,A0
02:0004197E 12303000        	  3098:     move.b  (A0,D3.W),D1
02:00041982 B001            	  3099:     cmp.b   D1,D0
02:00041984 6548            	  3100:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3101:     even
