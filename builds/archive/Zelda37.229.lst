                            	 11200:     even
                            	 11201: _L_z04_Gleeok_CheckCollisions_NextLoopSegment:
                            	 11202:     ; Bottom of the segment loop.
                            	 11203:     ; Decrement segment object slot.
                            	 11204:     ;
                            	 11205:     ; If >= 1, then go draw the next segment and check collisions.
                            	 11206:     ; Else return.
                            	 11207:     ;
