02:00030218 66EC            	  2809:     bne  _L_z01_CheckPassiveTileObjects_NextTile
                            	  2810:     ; We'll be computing the location of the square.
                            	  2811:     ; Start with Link's location.
                            	  2812:     ;
02:0003021A 102C0070        	  2813:     move.b  ($0070,A4),D0
02:0003021E 1880            	  2814:     move.b  D0,($0000,A4)
02:00030220 102C0084        	  2815:     move.b  ($0084,A4),D0
02:00030224 19400001        	  2816:     move.b  D0,($0001,A4)
02:00030228 102C0098        	  2817:     move.b  ($0098,A4),D0
02:0003022C 0200000C        	  2818:     andi.b #$0C,D0
02:00030230 6726            	  2819:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2820:     ; Link is facing vertically.
                            	  2821:     ;
                            	  2822:     ; If Link touched the left side of the square with the right side
                            	  2823:     ; of his body, then add 8 to X.
                            	  2824:     ;
                            	  2825:     ; If Link touched the right side of the square with the left side
                            	  2826:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2827:     ;
02:00030232 102C0002        	  2828:     move.b  ($0002,A4),D0
02:00030236 02000003        	  2829:     andi.b #$03,D0
02:0003023A 7600            	  2830:     moveq   #0,D3
02:0003023C 1600            	  2831:     move.b  D0,D3
02:0003023E 1014            	  2832:     move.b  ($0000,A4),D0
02:00030240 0C030002        	  2833:     cmpi.b  #$02,D3
02:00030244 640A            	  2834:     bcc  _anon_z01_24
02:00030246 023C00EE        	  2835:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003024A 123C0008        	  2836:     move.b  #$08,D1
02:0003024E D101            	  2837:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  2838: _anon_z01_24:
