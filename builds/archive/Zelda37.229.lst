02:000302BC 41EC0492        	  2894:     lea     ($0492,A4),A0
02:000302C0 10302000        	  2895:     move.b  (A0,D2.W),D0
02:000302C4 676C            	  2896:     beq  _L_z01_CheckPassiveTileObjects_ExitX0
                            	  2897:     ; Because armos and flying ghini fade into existence over a little time,
