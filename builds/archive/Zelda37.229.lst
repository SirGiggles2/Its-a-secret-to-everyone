02:00039D1C 11802000        	   877:     move.b  D0,(A0,D2.W)
02:00039D20 41EC00AC        	   878:     lea     ($00AC,A4),A0
02:00039D24 52302000        	   879:     addq.b  #1,(A0,D2.W)
02:00039D28 522C00F7        	   880:     addq.b  #1,($00F7,A4)
02:00039D2C 7074            	   881:     moveq   #116,D0
