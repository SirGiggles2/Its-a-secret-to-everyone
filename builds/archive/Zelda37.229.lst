                            	  3010: Link_FilterInput:
                            	  3011:     ; [00] holds the opposite of Link's facing direction.
                            	  3012:     ;
02:000418F8 102C0098        	  3013:     move.b  ($0098,A4),D0
02:000418FC 4EB900030C66    	  3014:     jsr     GetOppositeDir
02:00041902 1880            	  3015:     move.b  D0,($0000,A4)
                            	  3016:     ; Call GetOppositeDir again to use this mapping:
                            	  3017:     ; In Dir: 1 2 4 8
                            	  3018:     ;         -------
                            	  3019:     ; Index:  2 3 0 1
                            	  3020:     ;
02:00041904 4EB900030C66    	  3021:     jsr     GetOppositeDir
                            	  3022:     ; Get the appropriate coordinate for the direction:
                            	  3023:     ; X for horizontal
                            	  3024:     ; Y for vertical
                            	  3025:     ;
02:0004190A 102C0070        	  3026:     move.b  ($0070,A4),D0
02:0004190E 0C030002        	  3027:     cmpi.b  #$02,D3
02:00041912 6404            	  3028:     bcc  _anon_z05_74
02:00041914 102C0084        	  3029:     move.b  ($0084,A4),D0
                            	  3030: _anon_z05_74:
02:00041918 19400002        	  3031:     move.b  D0,($0002,A4)
                            	  3032:     ; Mask A button and directions if inner border is crossed.
                            	  3033:     ;
02:0004191C 1003            	  3034:     move.b  D3,D0
02:0004191E 1B00            	  3035:     move.b  D0,-(A5)  ; PHA
02:00041920 023C00EE        	  3036:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041924 123C0008        	  3037:     move.b  #$08,D1
02:00041928 D101            	  3038:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0004192A 7600            	  3039:     moveq   #0,D3
02:0004192C 1600            	  3040:     move.b  D0,D3
02:0004192E 103C0080        	  3041:     move.b  #$80,D0
02:00041932 6134            	  3042:     jsr     MaskInputInBorder
02:00041934 101D            	  3043:     move.b  (A5)+,D0  ; PLA
02:00041936 7600            	  3044:     moveq   #0,D3
02:00041938 1600            	  3045:     move.b  D0,D3
                            	  3046:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3047:     ; boundary using player's direction and reverse direction index.
                            	  3048:     ;
02:0004193A 102C0001        	  3049:     move.b  ($0001,A4),D0
