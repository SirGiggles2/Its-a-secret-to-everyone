                            	  3847:     even
                            	  3848: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3849:     ; Loop to look for a place to spawn a monster from the edge
                            	  3850:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3851:     ;
                            	  3852:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3853:     ; We'll move down $10 pixels.
                            	  3854:     ;
02:00041E56 7610            	  3855:     moveq   #16,D3
02:00041E58 102C000A        	  3856:     move.b  ($000A,A4),D0
02:00041E5C 0200000F        	  3857:     andi.b #$0F,D0
02:00041E60 670A            	  3858:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3859:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3860:     ; Don't move vertically.
                            	  3861:     ;
02:00041E62 163C00F0        	  3862:     move.b  #$F0,D3
02:00041E66 0C00000F        	  3863:     cmpi.b  #$0F,D0
02:00041E6A 6610            	  3864:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3865:     even
                            	  3866: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3867:     ; Else low nibble = $F. We're at the right edge,
                            	  3868:     ; and we'll move up $10 pixels.
                            	  3869:     ;
02:00041E6C 1003            	  3870:     move.b  D3,D0
02:00041E6E 023C00EE        	  3871:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041E72 122C000A        	  3872:     move.b  ($000A,A4),D1
02:00041E76 D101            	  3873:     addx.b  D1,D0   ; ADC $0A
02:00041E78 1940000A        	  3874:     move.b  D0,($000A,A4)
                            	  3875:     even
                            	  3876: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3877:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3878:     ; Move right one pixel.
                            	  3879:     ;
02:00041E7C 102C000A        	  3880:     move.b  ($000A,A4),D0
02:00041E80 020000F0        	  3881:     andi.b #$F0,D0
02:00041E84 0C0000E0        	  3882:     cmpi.b  #$E0,D0
02:00041E88 6606            	  3883:     bne  _anon_z05_88
02:00041E8A 522C000A        	  3884:     addq.b  #1,($000A,A4)
02:00041E8E 600A            	  3885:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3886: 
                            	  3887: _anon_z05_88:
                            	  3888:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3889:     ; Dont' move horizontally.
                            	  3890:     ;
02:00041E90 0C000040        	  3891:     cmpi.b  #$40,D0
02:00041E94 6604            	  3892:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3893:     ; Else high nibble = 4. We're at the top edge.
                            	  3894:     ; Move left 1 pixel.
                            	  3895:     ;
02:00041E96 532C000A        	  3896:     subq.b  #1,($000A,A4)
                            	  3897:     even
                            	  3898: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3899:     ; Time to get the address of the column.
                            	  3900:     ; Starting at the top of the leftmost column.
                            	  3901:     ;
02:00041E9A 6100268E        	  3902:     jsr     FetchTileMapAddr
02:00041E9E 7005            	  3903:     moveq   #5,D0
02:00041EA0 4EB90002A9FA    	  3904:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3905:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3906:     ; in order to point to the column we want.
                            	  3907:     ;
02:00041EA6 102C000A        	  3908:     move.b  ($000A,A4),D0
02:00041EAA 0200000F        	  3909:     andi.b #$0F,D0
02:00041EAE 7600            	  3910:     moveq   #0,D3
02:00041EB0 1600            	  3911:     move.b  D0,D3
02:00041EB2 670C            	  3912:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3913: _anon_z05_89:
02:00041EB4 702C            	  3914:     moveq   #44,D0
02:00041EB6 4EB9000310BC    	  3915:     jsr     AddToInt16At0
02:00041EBC 5303            	  3916:     subq.b  #1,D3
02:00041EBE 66F4            	  3917:     bne  _anon_z05_89
                            	  3918:     even
                            	  3919: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3920:     ; Turn the row part of [0A] into a tile index.
                            	  3921:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3922:     ;
02:00041EC0 102C000A        	  3923:     move.b  ($000A,A4),D0
02:00041EC4 020000F0        	  3924:     andi.b #$F0,D0
02:00041EC8 003C0011        	  3925:     ori     #$11,CCR  ; SEC: set C+X
02:00041ECC 123C0040        	  3926:     move.b  #$40,D1
02:00041ED0 0A3C0010        	  3927:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041ED4 9101            	  3928:     subx.b  D1,D0   ; SBC #$40
02:00041ED6 0A3C0010        	  3929:     eori    #$10,CCR  ; restore X = 6502 C
02:00041EDA E208            	  3930:     lsr.b  #1,D0   ; LSR A
02:00041EDC E208            	  3931:     lsr.b  #1,D0   ; LSR A
02:00041EDE E208            	  3932:     lsr.b  #1,D0   ; LSR A
02:00041EE0 7600            	  3933:     moveq   #0,D3
02:00041EE2 1600            	  3934:     move.b  D0,D3
                            	  3935:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3936:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3937:     ; when coming in from the edges.
                            	  3938:     ;
02:00041EE4 1214            	  3939:     move.b  ($00,A4),D1   ; ptr lo
02:00041EE6 182C0001        	  3940:     move.b  ($01,A4),D4  ; ptr hi
02:00041EEA 024100FF        	  3941:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041EEE E14C            	  3942:     lsl.w   #8,D4
02:00041EF0 8841            	  3943:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041EF2 48C4            	  3944:     ext.l   D4
02:00041EF4 D8BC00FF0000    	  3945:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041EFA 2044            	  3946:     movea.l D4,A0
02:00041EFC 10303000        	  3947:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041F00 0C000084        	  3948:     cmpi.b  #$84,D0
02:00041F04 650E            	  3949:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3950:     ; Bottom of the loop.
                            	  3951:     ; If you reach the original cell, then stop.
                            	  3952:     ;
02:00041F06 102C000A        	  3953:     move.b  ($000A,A4),D0
02:00041F0A 122C0525        	  3954:     move.b  ($0525,A4),D1
02:00041F0E B001            	  3955:     cmp.b   D1,D0
02:00041F10 6600FF44        	  3956:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3957:     even
