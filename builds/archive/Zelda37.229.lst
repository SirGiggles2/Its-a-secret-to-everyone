02:00030442 12342070        	  3100:     move.b  ($70,A4,D2.W),D1
02:00030446 0A3C0010        	  3101:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003044A 9101            	  3102:     subx.b  D1,D0   ; SBC ObjX,X
02:0003044C 0A3C0010        	  3103:     eori    #$10,CCR  ; restore X = 6502 C
02:00030450 61000818        	  3104:     jsr     Abs
02:00030454 0C00000E        	  3105:     cmpi.b  #$0E,D0
02:00030458 64DC            	  3106:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3107:     ; Determine the vertical direction toward Link;
                            	  3108:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3109:     ; along this axis. Go draw and check object collisions.
                            	  3110:     ;
02:0003045A 7604            	  3111:     moveq   #4,D3
02:0003045C 102C0084        	  3112:     move.b  ($0084,A4),D0
02:00030460 41EC0084        	  3113:     lea     ($0084,A4),A0
02:00030464 12302000        	  3114:     move.b  (A0,D2.W),D1
02:00030468 B001            	  3115:     cmp.b   D1,D0
02:0003046A 67CA            	  3116:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003046C 6402            	  3117:     bcc  _anon_z01_27
02:0003046E 7608            	  3118:     moveq   #8,D3
                            	  3119: _anon_z01_27:
                            	  3120:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3121:     ; set the vertical direction we determined, and other preparations.
                            	  3122:     ;
02:00030470 41EC0084        	  3123:     lea     ($0084,A4),A0
02:00030474 10302000        	  3124:     move.b  (A0,D2.W),D0
02:00030478 668A            	  3125:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3126:     even
                            	  3127: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3128:     ; State 1 and 2.
                            	  3129:     ;
                            	  3130:     ; Move in the direction it's facing.
                            	  3131:     ;
02:0003047A 41EC0098        	  3132:     lea     ($0098,A4),A0
02:0003047E 10302000        	  3133:     move.b  (A0,D2.W),D0
02:00030482 1940000F        	  3134:     move.b  D0,($000F,A4)
02:00030486 4EB90004BA44    	  3135:     jsr     MoveObject
                            	  3136:     ; Truncate the grid offset to square length ($10).
                            	  3137:     ;
02:0003048C 41EC0394        	  3138:     lea     ($0394,A4),A0
02:00030490 10302000        	  3139:     move.b  (A0,D2.W),D0
02:00030494 0200000F        	  3140:     andi.b #$0F,D0
02:00030498 6608            	  3141:     bne  _anon_z01_28
02:0003049A 41EC0394        	  3142:     lea     ($0394,A4),A0
02:0003049E 11802000        	  3143:     move.b  D0,(A0,D2.W)
                            	  3144: _anon_z01_28:
                            	  3145:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3146:     ;
02:000304A2 610017DC        	  3147:     jsr     CheckLinkCollision
                            	  3148:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3149:     ; and current coordinate to the trap's X.
                            	  3150:     ;
02:000304A6 7600            	  3151:     moveq   #0,D3
02:000304A8 16342070        	  3152:     move.b  ($70,A4,D2.W),D3
02:000304AC 7078            	  3153:     moveq   #120,D0
02:000304AE 1880            	  3154:     move.b  D0,($0000,A4)
02:000304B0 41EC0098        	  3155:     lea     ($0098,A4),A0
02:000304B4 10302000        	  3156:     move.b  (A0,D2.W),D0
02:000304B8 0200000C        	  3157:     andi.b #$0C,D0
02:000304BC 6710            	  3158:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3159:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3160:     ; and current coordinate to the trap's Y.
                            	  3161:     ;
02:000304BE 7600            	  3162:     moveq   #0,D3
02:000304C0 41EC0084        	  3163:     lea     ($0084,A4),A0
02:000304C4 16302000        	  3164:     move.b  (A0,D2.W),D3
02:000304C8 103C0090        	  3165:     move.b  #$90,D0
02:000304CC 1880            	  3166:     move.b  D0,($0000,A4)
                            	  3167:     even
                            	  3168: _L_z01_UpdateTrap_Full_Finish:
                            	  3169:     ; If in state 2, then go finish handling it.
                            	  3170:     ;
02:000304CE 41EC00AC        	  3171:     lea     ($00AC,A4),A0
02:000304D2 10302000        	  3172:     move.b  (A0,D2.W),D0
02:000304D6 02000001        	  3173:     andi.b #$01,D0
02:000304DA 6744            	  3174:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3175:     ; Finish handling state 1.
                            	  3176:     ;
                            	  3177:     ; Get the distance between the current coordinate and the target.
                            	  3178:     ;
02:000304DC 1003            	  3179:     move.b  D3,D0
02:000304DE 003C0011        	  3180:     ori     #$11,CCR  ; SEC: set C+X
02:000304E2 1214            	  3181:     move.b  ($0000,A4),D1
02:000304E4 0A3C0010        	  3182:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304E8 9101            	  3183:     subx.b  D1,D0   ; SBC $00
02:000304EA 0A3C0010        	  3184:     eori    #$10,CCR  ; restore X = 6502 C
02:000304EE 6100077A        	  3185:     jsr     Abs
                            	  3186:     ; If distance >= 5, go draw.
                            	  3187:     ;
02:000304F2 0C000005        	  3188:     cmpi.b  #$05,D0
02:000304F6 6426            	  3189:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  3190:     ; Else reverse direction, and advace to state 2
                            	  3191:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  3192:     ;
02:000304F8 41EC0098        	  3193:     lea     ($0098,A4),A0
02:000304FC 10302000        	  3194:     move.b  (A0,D2.W),D0
02:00030500 61000764        	  3195:     jsr     GetOppositeDir
02:00030504 41EC0098        	  3196:     lea     ($0098,A4),A0
02:00030508 11802000        	  3197:     move.b  D0,(A0,D2.W)
02:0003050C 7020            	  3198:     moveq   #32,D0
02:0003050E 41EC03BC        	  3199:     lea     ($03BC,A4),A0
02:00030512 11802000        	  3200:     move.b  D0,(A0,D2.W)
02:00030516 41EC00AC        	  3201:     lea     ($00AC,A4),A0
02:0003051A 52302000        	  3202:     addq.b  #1,(A0,D2.W)
                            	  3203:     even
