02:0003F43C 41EC0478        	 12942:     lea     ($0478,A4),A0
02:0003F440 10302000        	 12943:     move.b  (A0,D2.W),D0
02:0003F444 6712            	 12944:     beq  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F446 102C0015        	 12945:     move.b  ($0015,A4),D0
02:0003F44A 02000007        	 12946:     andi.b #$07,D0
02:0003F44E 6608            	 12947:     bne  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F450 41EC0478        	 12948:     lea     ($0478,A4),A0
