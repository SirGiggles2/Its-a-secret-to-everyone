                            	  3041:     ; Carry over to the high speed byte.
                            	  3042:     ;
02:0003AC28 41EC0412        	  3043:     lea     ($0412,A4),A0
02:0003AC2C 10302000        	  3044:     move.b  (A0,D2.W),D0
02:0003AC30 123C0000        	  3045:     move.b  #$00,D1
02:0003AC34 D101            	  3046:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AC36 41EC0412        	  3047:     lea     ($0412,A4),A0
