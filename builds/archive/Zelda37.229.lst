                            	  7924: __far_z_04_0074:
                            	  7925:     ; Go to state 1.
                            	  7926:     ;
02:0003CF28 41EC00AC        	  7927:     lea     ($00AC,A4),A0
02:0003CF2C 52302000        	  7928:     addq.b  #1,(A0,D2.W)
                            	  7929:     ; Subtract 1 from facing direction to make an index.
