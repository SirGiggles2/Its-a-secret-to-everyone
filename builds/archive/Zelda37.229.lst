02:00041964 1600            	  3068:     move.b  D0,D3
                            	  3069: _anon_z05_76:
                            	  3070:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3071:     ;
02:00041966 7000            	  3072:     moveq   #0,D0
                            	  3073: ; Params:
                            	  3074: ; A: mask of buttons to block
                            	  3075: ; Y: offset into BorderBounds
                            	  3076: ; [00]: direction
                            	  3077: ; [02]: coordinate
                            	  3078: ;
                            	  3079: ; Returns:
                            	  3080: ; [01]: button mask that was used
                            	  3081: ;       (set to $FF if boundary not crossed)
                            	  3082: ;
                            	  3083:     even
                            	  3084: MaskInputInBorder:
02:00041968 19400001        	  3085:     move.b  D0,($0001,A4)
                            	  3086:     ; If direction is positive (right or down), then go handle it separately.
                            	  3087:     ;
02:0004196C 1014            	  3088:     move.b  ($0000,A4),D0
