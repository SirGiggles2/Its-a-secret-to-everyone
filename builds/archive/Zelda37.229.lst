                            	 12951: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12952:     ; Draw the four clouds at diagonal corners.
                            	 12953:     ;
02:0003F458 610000B6        	 12954:     jsr     Ganon_GetCurCloudLeft
02:0003F45C 610000BE        	 12955:     jsr     Ganon_GetCurCloudTop
02:0003F460 61A0            	 12956:     jsr     Ganon_DrawCloud
02:0003F462 610000B2        	 12957:     jsr     Ganon_GetCurCloudRight
02:0003F466 619A            	 12958:     jsr     Ganon_DrawCloud
02:0003F468 610000A6        	 12959:     jsr     Ganon_GetCurCloudLeft
02:0003F46C 610000B4        	 12960:     jsr     Ganon_GetCurCloudBottom
02:0003F470 6190            	 12961:     jsr     Ganon_DrawCloud
02:0003F472 610000A2        	 12962:     jsr     Ganon_GetCurCloudRight
02:0003F476 618A            	 12963:     jsr     Ganon_DrawCloud
                            	 12964:     ; Draw the top and bottom clouds.
                            	 12965:     ;
02:0003F478 10342070        	 12966:     move.b  ($70,A4,D2.W),D0
02:0003F47C 1880            	 12967:     move.b  D0,($0000,A4)
02:0003F47E 6100009C        	 12968:     jsr     Ganon_GetCurCloudTop
02:0003F482 6100FF7E        	 12969:     jsr     Ganon_DrawCloud
02:0003F486 6100009A        	 12970:     jsr     Ganon_GetCurCloudBottom
02:0003F48A 6100FF76        	 12971:     jsr     Ganon_DrawCloud
                            	 12972:     ; Draw the left and right clouds.
                            	 12973:     ;
02:0003F48E 61000080        	 12974:     jsr     Ganon_GetCurCloudLeft
02:0003F492 41EC0084        	 12975:     lea     ($0084,A4),A0
02:0003F496 10302000        	 12976:     move.b  (A0,D2.W),D0
02:0003F49A 19400001        	 12977:     move.b  D0,($0001,A4)
02:0003F49E 6100FF62        	 12978:     jsr     Ganon_DrawCloud
02:0003F4A2 6172            	 12979:     jsr     Ganon_GetCurCloudRight
02:0003F4A4 6100FF5C        	 12980:     jsr     Ganon_DrawCloud
                            	 12981:     ; Save the object index.
                            	 12982:     ;
02:0003F4A8 102C0340        	 12983:     move.b  ($0340,A4),D0
02:0003F4AC 1B00            	 12984:     move.b  D0,-(A5)  ; PHA
                            	 12985:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12986:     ;
02:0003F4AE 7402            	 12987:     moveq   #2,D2
                            	 12988:     even
                            	 12989: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F4B0 19420340        	 12990:     move.b  D2,($0340,A4)
                            	 12991:     ; If object slot < 5 or = 7, then move every frame.
                            	 12992:     ; Else move 3 out of every 4 frames.
                            	 12993:     ;
                            	 12994:     ; This makes pieces spread out in somewhat of a circle,
                            	 12995:     ; by making the pieces at cardinal directions move at
                            	 12996:     ; full speed while the diagonal ones move a little slower.
                            	 12997:     ;
02:0003F4B4 0C020005        	 12998:     cmpi.b  #$05,D2
02:0003F4B8 6510            	 12999:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F4BA 0C020007        	 13000:     cmpi.b  #$07,D2
02:0003F4BE 670A            	 13001:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F4C0 102C0015        	 13002:     move.b  ($0015,A4),D0
02:0003F4C4 02000003        	 13003:     andi.b #$03,D0
02:0003F4C8 6704            	 13004:     beq  _anon_z04_164
                            	 13005:     even
                            	 13006: _L_z04_Ganon_DrawBurst_Move:
02:0003F4CA 6100DFD6        	 13007:     jsr     BlueWizzrobe_Move
                            	 13008: _anon_z04_164:
02:0003F4CE 4EB90004CDE0    	 13009:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 13010:     ; The frame counter will make the sprite flash.
                            	 13011:     ; The array has the horizontal and vertical flipping attributes.
                            	 13012:     ; Combine them into [03].
                            	 13013:     ;
02:0003F4D4 102C0015        	 13014:     move.b  ($0015,A4),D0
02:0003F4D8 02000003        	 13015:     andi.b #$03,D0
02:0003F4DC 41F90003F3AC    	 13016:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F4E2 12302000        	 13017:     move.b  (A0,D2.W),D1
02:0003F4E6 8001            	 13018:     or.b  D1,D0
02:0003F4E8 19400003        	 13019:     move.b  D0,($0003,A4)
02:0003F4EC 41F90003F3B6    	 13020:     lea     (GanonBurstTiles).l,A0
02:0003F4F2 10302000        	 13021:     move.b  (A0,D2.W),D0
02:0003F4F6 4EB900031AB6    	 13022:     jsr     Anim_WriteSprite
                            	 13023:     ; Bottom of the loop.
                            	 13024:     ; Increment object slot while <= 9.
                            	 13025:     ;
02:0003F4FC 5202            	 13026:     addq.b  #1,D2
02:0003F4FE 0C02000A        	 13027:     cmpi.b  #$0A,D2
02:0003F502 65AC            	 13028:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 13029:     ; Restore the object index.
                            	 13030:     ;
02:0003F504 101D            	 13031:     move.b  (A5)+,D0  ; PLA
02:0003F506 19400340        	 13032:     move.b  D0,($0340,A4)
02:0003F50A 0A3C0001        	 13033:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F50E 4E75            	 13034:     rts
                            	 13035: 
                            	 13036: ; Returns:
                            	 13037: ; [00]: X coordinate
                            	 13038: ;
                            	 13039:     even
