                            	  1250: _L_z04_UpdateFireball_Move:
                            	  1251:     ; A movement routine is used that works along one axis.
                            	  1252:     ; So, load its parameters, and call it for each axis individually.
                            	  1253:     ;
                            	  1254:     ; First, load the horizontal direction into [0F].
                            	  1255:     ;
02:00039FFA 41EC0412        	  1256:     lea     ($0412,A4),A0
02:00039FFE 10302000        	  1257:     move.b  (A0,D2.W),D0
02:0003A002 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:0003A006 41EC041F        	  1262:     lea     ($041F,A4),A0
02:0003A00A 10302000        	  1263:     move.b  (A0,D2.W),D0
02:0003A00E 7600            	  1264:     moveq   #0,D3
02:0003A010 41EC0451        	  1265:     lea     ($0451,A4),A0
02:0003A014 16302000        	  1266:     move.b  (A0,D2.W),D3
02:0003A018 613E            	  1267:     jsr     Fireball_MoveOneAxis
02:0003A01A 41EC0451        	  1268:     lea     ($0451,A4),A0
02:0003A01E 11802000        	  1269:     move.b  D0,(A0,D2.W)
                            	  1270:     ; Second, load the vertical direction into [0F].
                            	  1271:     ;
02:0003A022 41EC0437        	  1272:     lea     ($0437,A4),A0
02:0003A026 10302000        	  1273:     move.b  (A0,D2.W),D0
02:0003A02A 1940000F        	  1274:     move.b  D0,($000F,A4)
                            	  1275:     ; Load the vertical q-speed and position fraction,
                            	  1276:     ; move, then save the position fraction.
                            	  1277:     ;
02:0003A02E 41EC0444        	  1278:     lea     ($0444,A4),A0
02:0003A032 10302000        	  1279:     move.b  (A0,D2.W),D0
02:0003A036 7600            	  1280:     moveq   #0,D3
02:0003A038 41EC045E        	  1281:     lea     ($045E,A4),A0
02:0003A03C 16302000        	  1282:     move.b  (A0,D2.W),D3
