02:0003BAB6 10302000        	  5113:     move.b  (A0,D2.W),D0
02:0003BABA 0C000007        	  5114:     cmpi.b  #$07,D0
02:0003BABE 652C            	  5115:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  5116:     ; It has reached the end of a trip.
                            	  5117:     ;
