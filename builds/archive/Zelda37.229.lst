                            	  4880: UpdatePeaceTextbox:
                            	  4881:     ; Only emit a character once every 8 frames --
                            	  4882:     ; when (counter [0412] MOD 8) = 4.
                            	  4883:     ;
02:00036580 522C0412        	  4884:     addq.b  #1,($0412,A4)
02:00036584 102C0412        	  4885:     move.b  ($0412,A4),D0
02:00036588 02000007        	  4886:     andi.b #$07,D0
02:0003658C 0C000004        	  4887:     cmpi.b  #$04,D0
02:00036590 665C            	  4888:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4889:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4890:     ; to the dynamic transfer buf.
                            	  4891:     ;
02:00036592 7604            	  4892:     moveq   #4,D3
                            	  4893: _anon_z02_35:
02:00036594 41F900036510    	  4894:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:0003659A 10303000        	  4895:     move.b  (A0,D3.W),D0
02:0003659E 41EC0302        	  4896:     lea     ($0302,A4),A0
02:000365A2 11803000        	  4897:     move.b  D0,(A0,D3.W)
02:000365A6 5303            	  4898:     subq.b  #1,D3
02:000365A8 6AEA            	  4899:     bpl  _anon_z02_35
                            	  4900:     ; Load a character from the string and copy it to
                            	  4901:     ; the transfer record until we read character $FF.
                            	  4902:     ;
02:000365AA 7600            	  4903:     moveq   #0,D3
02:000365AC 162C0413        	  4904:     move.b  ($0413,A4),D3
02:000365B0 41F90003654A    	  4905:     lea     (PeaceText).l,A0
02:000365B6 10303000        	  4906:     move.b  (A0,D3.W),D0
02:000365BA 0C0000FF        	  4907:     cmpi.b  #$FF,D0
02:000365BE 6730            	  4908:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000365C0 19400305        	  4909:     move.b  D0,($0305,A4)
                            	  4910:     ; A regular space takes as much time to emit as any character.
                            	  4911:     ; But it makes no sound.
                            	  4912:     ;
02:000365C4 0C000024        	  4913:     cmpi.b  #$24,D0
02:000365C8 6706            	  4914:     beq  _anon_z02_36
02:000365CA 7010            	  4915:     moveq   #16,D0
02:000365CC 19400604        	  4916:     move.b  D0,($0604,A4)
                            	  4917: _anon_z02_36:
                            	  4918:     ; Point to the next character in the string.
                            	  4919:     ;
02:000365D0 522C0413        	  4920:     addq.b  #1,($0413,A4)
                            	  4921:     ; Replace the low byte of the VRAM address with the one
                            	  4922:     ; where the next character should be written.
                            	  4923:     ;
02:000365D4 41F900036516    	  4924:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000365DA 10303000        	  4925:     move.b  (A0,D3.W),D0
02:000365DE 19400303        	  4926:     move.b  D0,($0303,A4)
                            	  4927:     ; Once the low VRAM address rolls over,
                            	  4928:     ; increment the high address.
                            	  4929:     ;
02:000365E2 0C0000A0        	  4930:     cmpi.b  #$A0,D0
02:000365E6 6406            	  4931:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000365E8 7023            	  4932:     moveq   #35,D0
02:000365EA 19400302        	  4933:     move.b  D0,($0302,A4)
