02:00034ED0 11803000        	  2706:     move.b  D0,(A0,D3.W)
02:00034ED4 5303            	  2707:     subq.b  #1,D3
02:00034ED6 6AEA            	  2708:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00034ED8 7600            	  2709:     moveq   #0,D3
02:00034EDA 162C0016        	  2710:     move.b  ($0016,A4),D3
02:00034EDE 41F900034740    	  2711:     lea     (ModeEandFSlotCursorYs).l,A0
02:00034EE4 10303000        	  2712:     move.b  (A0,D3.W),D0
02:00034EE8 19400084        	  2713:     move.b  D0,($0084,A4)
02:00034EEC 19400200        	  2714:     move.b  D0,($0200,A4)
02:00034EF0 102C0012        	  2715:     move.b  ($0012,A4),D0
02:00034EF4 0C00000F        	  2716:     cmpi.b  #$0F,D0
                            	  2717:     ; There's more work in mode $E.
                            	  2718:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2719:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00034EF8 6736            	  2720:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00034EFA 103C00F3        	  2721:     move.b  #$F3,D0
02:00034EFE 19400201        	  2722:     move.b  D0,($0201,A4)
                            	  2723:     ; Because the visible part of the cursor block sprite is
                            	  2724:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2725:     ; above its ObjY.
02:00034F02 102C0084        	  2726:     move.b  ($0084,A4),D0
02:00034F06 003C0011        	  2727:     ori     #$11,CCR  ; SEC: set C+X
02:00034F0A 123C0008        	  2728:     move.b  #$08,D1
02:00034F0E 0A3C0010        	  2729:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F12 9101            	  2730:     subx.b  D1,D0   ; SBC #$08
02:00034F14 0A3C0010        	  2731:     eori    #$10,CCR  ; restore X = 6502 C
02:00034F18 19400204        	  2732:     move.b  D0,($0204,A4)
02:00034F1C 7070            	  2733:     moveq   #112,D0
02:00034F1E 19400070        	  2734:     move.b  D0,($0070,A4)
02:00034F22 103C0087        	  2735:     move.b  #$87,D0
02:00034F26 19400085        	  2736:     move.b  D0,($0085,A4)
02:00034F2A 7030            	  2737:     moveq   #48,D0
02:00034F2C 19400071        	  2738:     move.b  D0,($0071,A4)
