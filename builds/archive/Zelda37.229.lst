                            	   313: UpdateMenuScrollDownOW:
02:000400C2 61004BBA        	   314:     jsr     Submenu_CueTransferRowOW
02:000400C6 6004            	   315:     jmp     _anon_z05_2
                            	   316: 
                            	   317:     even
                            	   318: UpdateMenuScrollDownUW:
02:000400C8 61004B44        	   319:     jsr     Submenu_CueTransferRowUW
                            	   320: _anon_z05_2:
                            	   321:     ; Move position markers and advance nametable scrolling;
                            	   322:     ; so that we scroll down 3 pixels.
                            	   323:     ;
02:000400CC 7003            	   324:     moveq   #3,D0
02:000400CE 6100015C        	   325:     jsr     MovePositionMarkers
02:000400D2 102C00FC        	   326:     move.b  ($00FC,A4),D0
02:000400D6 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:000400DA 123C0003        	   328:     move.b  #$03,D1
02:000400DE 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000400E2 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:000400E4 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:000400E8 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:000400EC 0C000041        	   335:     cmpi.b  #$41,D0
02:000400F0 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
                            	   338:     ; Advance the submenu state.
                            	   339:     ; If in OW or in a cellar, we're done. Return.
                            	   340:     ;
02:000400F4 522C00E1        	   341:     addq.b  #1,($00E1,A4)
02:000400F8 102C0010        	   342:     move.b  ($0010,A4),D0
02:000400FC 67000084        	   343:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:00040100 102C0012        	   344:     move.b  ($0012,A4),D0
02:00040104 0C000009        	   345:     cmpi.b  #$09,D0
02:00040108 6778            	   346:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   347:     ; Calculate the X coordinate of the submenu position marker.
                            	   348:     ;
                            	   349:     ; First, mask off the high nibble of the room ID and multiply by
                            	   350:     ; the width of a tile, 8. Store the result in [00].
                            	   351:     ;
02:0004010A 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:0004010E 0200000F        	   353:     andi.b #$0F,D0
02:00040112 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:00040114 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:00040116 E308            	   356:     lsl.b  #1,D0   ; ASL A
02:00040118 1880            	   357:     move.b  D0,($0000,A4)
                            	   358:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   359:     ; negative or left rotation by ($10 - rotation value).
                            	   360:     ;
                            	   361:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   362:     ; the width of a tile. Then negate it. The final result is the
                            	   363:     ; negative offset.
                            	   364:     ;
02:0004011A 103900FF6BAB    	   365:     move.b  (NES_SRAM+$0BAB).l,D0
02:00040120 0C000008        	   366:     cmpi.b  #$08,D0
02:00040124 6520            	   367:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:00040126 7010            	   368:     moveq   #16,D0
02:00040128 123900FF6BAB    	   369:     move.b  (NES_SRAM+$0BAB).l,D1
02:0004012E 0A3C0010        	   370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040132 9101            	   371:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:00040134 0A3C0010        	   372:     eori    #$10,CCR  ; restore X = 6502 C
02:00040138 E308            	   373:     lsl.b  #1,D0   ; ASL A
02:0004013A E308            	   374:     lsl.b  #1,D0   ; ASL A
02:0004013C E308            	   375:     lsl.b  #1,D0   ; ASL A
02:0004013E 4EB900030C6E    	   376:     jsr     Negate
02:00040144 6006            	   377:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   378: 
                            	   379:     even
                            	   380: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   381:     ; The submenu map's rotation < 8.
                            	   382:     ; It represents the number of tiles to move right.
                            	   383:     ; So, multiply it by 8.
                            	   384:     ;
02:00040146 E308            	   385:     lsl.b  #1,D0   ; ASL A
02:00040148 E308            	   386:     lsl.b  #1,D0   ; ASL A
02:0004014A E308            	   387:     lsl.b  #1,D0   ; ASL A
                            	   388:     even
                            	   389: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   390:     ; Add the offset we calculated, and $62 to [00] to get
                            	   391:     ; the position marker's X coordinate.
                            	   392:     ;
02:0004014C 023C00EE        	   393:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040150 1214            	   394:     move.b  ($0000,A4),D1
02:00040152 D101            	   395:     addx.b  D1,D0   ; ADC $00
02:00040154 023C00EE        	   396:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040158 123C0062        	   397:     move.b  #$62,D1
02:0004015C D101            	   398:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:0004015E 19400253        	   399:     move.b  D0,($0253,A4)
                            	   400:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   401:     ; Divide by 2 to get a multiple of the tile height.
                            	   402:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   403:     ;
02:00040162 102C00EB        	   404:     move.b  ($00EB,A4),D0
02:00040166 020000F0        	   405:     andi.b #$F0,D0
02:0004016A E208            	   406:     lsr.b  #1,D0   ; LSR A
02:0004016C 123C0069        	   407:     move.b  #$69,D1
02:00040170 D101            	   408:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040172 19400250        	   409:     move.b  D0,($0250,A4)
                            	   410:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   411:     ;
02:00040176 703E            	   412:     moveq   #62,D0
02:00040178 19400251        	   413:     move.b  D0,($0251,A4)
02:0004017C 7000            	   414:     moveq   #0,D0
02:0004017E 19400252        	   415:     move.b  D0,($0252,A4)
                            	   416:     even
                            	   417: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040182 4E75            	   418:     rts
                            	   419: 
                            	   420:     even
                            	   421: UpdateMenuActive:
02:00040184 6100520A        	   422:     jsr     DrawSubmenuItems
02:00040188 610052CE        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:0004018C 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:00040190 02000088        	   430:     andi.b #$88,D0
02:00040194 0C000088        	   431:     cmpi.b  #$88,D0
02:00040198 661A            	   432:     bne  _anon_z05_3
02:0004019A 4EB90004B366    	   433:     jsr     EndGameMode
02:000401A0 194000E1        	   434:     move.b  D0,($00E1,A4)
02:000401A4 7008            	   435:     moveq   #8,D0
02:000401A6 19400012        	   436:     move.b  D0,($0012,A4)
02:000401AA 7000            	   437:     moveq   #0,D0
02:000401AC 19400619        	   438:     move.b  D0,($0619,A4)
02:000401B0 600012D6        	   439:     jmp     SilenceSound
                            	   440: 
                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:000401B4 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:000401B8 02000010        	   446:     andi.b #$10,D0
02:000401BC 6606            	   447:     bne.s  __far_z_05_0003
