02:0003B32E 661E            	  4048:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4049:     ; If Link's X < $70 or >= $81, then return.
                            	  4050:     ;
02:0003B330 102C0070        	  4051:     move.b  ($0070,A4),D0
02:0003B334 0C000070        	  4052:     cmpi.b  #$70,D0
02:0003B338 6514            	  4053:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B33A 0C000081        	  4054:     cmpi.b  #$81,D0
02:0003B33E 640E            	  4055:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4056:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4057:     ; halt Link, and start filling hearts.
                            	  4058:     ;
02:0003B340 522C00AD        	  4059:     addq.b  #1,($00AD,A4)
02:0003B344 7040            	  4060:     moveq   #64,D0
02:0003B346 194000AC        	  4061:     move.b  D0,($00AC,A4)
02:0003B34A 19400063        	  4062:     move.b  D0,($0063,A4)
