02:00041C28 6704            	  3506:     beq.s  __far_z_05_0070
02:00041C2A 60000092        	  3507:     jmp  L14F72_Exit
                            	  3508: __far_z_05_0070:
                            	  3509:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3510:     ;
02:00041C2E 102C0084        	  3511:     move.b  ($0084,A4),D0
02:00041C32 0C00009D        	  3512:     cmpi.b  #$9D,D0
02:00041C36 6704            	  3513:     beq.s  __far_z_05_0071
02:00041C38 60000086        	  3514:     jmp  CheckCaveEdge
                            	  3515: __far_z_05_0071:
                            	  3516:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3517:     ; X = $50: 1
                            	  3518:     ; X = $80: 2
                            	  3519:     ; X = $B0: 3
                            	  3520:     ;
                            	  3521:     ; If he's not on any, then return.
                            	  3522:     ;
02:00041C3C 7601            	  3523:     moveq   #1,D3
02:00041C3E 102C0070        	  3524:     move.b  ($0070,A4),D0
02:00041C42 0C000050        	  3525:     cmpi.b  #$50,D0
02:00041C46 6712            	  3526:     beq  _anon_z05_83
02:00041C48 5203            	  3527:     addq.b  #1,D3
02:00041C4A 0C000080        	  3528:     cmpi.b  #$80,D0
02:00041C4E 670A            	  3529:     beq  _anon_z05_83
02:00041C50 5203            	  3530:     addq.b  #1,D3
02:00041C52 0C0000B0        	  3531:     cmpi.b  #$B0,D0
02:00041C56 6702            	  3532:     beq.s  __far_z_05_0072
02:00041C58 6064            	  3533:     jmp  L14F72_Exit
                            	  3534: __far_z_05_0072:
                            	  3535: _anon_z05_83:
                            	  3536:     ; Look for the current room in the cellar/shortcut room array.
                            	  3537:     ;
02:00041C5A 1883            	  3538:     move.b  D3,($0000,A4)
02:00041C5C 163C00FF        	  3539:     move.b  #$FF,D3
02:00041C60 102C00EB        	  3540:     move.b  ($00EB,A4),D0
                            	  3541: _anon_z05_84:
02:00041C64 5203            	  3542:     addq.b  #1,D3
02:00041C66 41F900FF6BB2    	  3543:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C6C 12303000        	  3544:     move.b  (A0,D3.W),D1
02:00041C70 B001            	  3545:     cmp.b   D1,D0
02:00041C72 66F0            	  3546:     bne  _anon_z05_84
                            	  3547:     ; Add the value of the shortcut chosen to whatever index
                            	  3548:     ; the current room has in the array.
                            	  3549:     ;
                            	  3550:     ; This yields the index of one of the three shortcut rooms
                            	  3551:     ; after the current one.
                            	  3552:     ;
02:00041C74 1003            	  3553:     move.b  D3,D0
02:00041C76 023C00EE        	  3554:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C7A 1214            	  3555:     move.b  ($0000,A4),D1
02:00041C7C D101            	  3556:     addx.b  D1,D0   ; ADC $00
                            	  3557:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3558:     ;
02:00041C7E 02000003        	  3559:     andi.b #$03,D0
02:00041C82 7600            	  3560:     moveq   #0,D3
02:00041C84 1600            	  3561:     move.b  D0,D3
02:00041C86 41F900FF6BB2    	  3562:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C8C 10303000        	  3563:     move.b  (A0,D3.W),D0
                            	  3564: ; Params:
                            	  3565: ; A: destination room ID
                            	  3566: ;
                            	  3567:     even
                            	  3568: GoToModeAFromCellar:
02:00041C90 194000EB        	  3569:     move.b  D0,($00EB,A4)
02:00041C94 4EB90004AB30    	  3570:     jsr     MarkRoomVisited
                            	  3571:     even
                            	  3572: GoToModeAFromCave:
02:00041C9A 700A            	  3573:     moveq   #10,D0
02:00041C9C 19400012        	  3574:     move.b  D0,($0012,A4)
                            	  3575:     even
                            	  3576: EndPrepareMode:
02:00041CA0 7000            	  3577:     moveq   #0,D0
02:00041CA2 19400013        	  3578:     move.b  D0,($0013,A4)
02:00041CA6 19400011        	  3579:     move.b  D0,($0011,A4)
02:00041CAA 1940000F        	  3580:     move.b  D0,($000F,A4)
02:00041CAE 194000AC        	  3581:     move.b  D0,($00AC,A4)
02:00041CB2 194000C0        	  3582:     move.b  D0,($00C0,A4)
02:00041CB6 194000D3        	  3583:     move.b  D0,($00D3,A4)
02:00041CBA 194004F0        	  3584:     move.b  D0,($04F0,A4)
                            	  3585:     even
