                            	  5119:     ;
02:0003BAC0 41EC042C        	  5120:     lea     ($042C,A4),A0
02:0003BAC4 10302000        	  5121:     move.b  (A0,D2.W),D0
02:0003BAC8 6718            	  5122:     beq  _L_z04_L_Wallmaster_State1_SetState
                            	  5123:     ; At the end of a trip where Link was captured:
