                            	  4723: 
                            	  4724: ; Returns:
                            	  4725: ; X: last object slot tested, regardless of whether it's empty
                            	  4726: ;
                            	  4727: ; Fails if no empty slot was found, or the blue candle was already used.
                            	  4728: ;
