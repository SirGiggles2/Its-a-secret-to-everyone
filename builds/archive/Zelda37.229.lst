02:0004AE10 19400002        	  2356:     move.b  D0,($0002,A4)
02:0004AE14 4EB90003155C    	  2357:     jsr     MapScreenPosToPpuAddr
02:0004AE1A 7400            	  2358:     moveq   #0,D2
02:0004AE1C 142C0301        	  2359:     move.b  ($0301,A4),D2
                            	  2360:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2361:     ;
                            	  2362:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2363:     ; In total, 11 bytes will be written.
                            	  2364:     ;
                            	  2365:     ; First, write the high byte of PPU address in each record.
                            	  2366:     ;
02:0004AE20 1014            	  2367:     move.b  ($0000,A4),D0
02:0004AE22 41EC0302        	  2368:     lea     ($0302,A4),A0
02:0004AE26 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:0004AE2A 41EC0307        	  2370:     lea     ($0307,A4),A0
02:0004AE2E 11802000        	  2371:     move.b  D0,(A0,D2.W)
                            	  2372:     ; Write the low address in the first record. In the second record,
                            	  2373:     ; write (low address + 1).
                            	  2374:     ;
02:0004AE32 102C0001        	  2375:     move.b  ($0001,A4),D0
02:0004AE36 41EC0303        	  2376:     lea     ($0303,A4),A0
02:0004AE3A 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:0004AE3E 41EC0308        	  2378:     lea     ($0308,A4),A0
02:0004AE42 11802000        	  2379:     move.b  D0,(A0,D2.W)
02:0004AE46 41EC0308        	  2380:     lea     ($0308,A4),A0
02:0004AE4A 52302000        	  2381:     addq.b  #1,(A0,D2.W)
                            	  2382:     ; Write the first tile twice in each record. Patch them later.
                            	  2383:     ;
02:0004AE4E 102C0005        	  2384:     move.b  ($0005,A4),D0
02:0004AE52 41EC0305        	  2385:     lea     ($0305,A4),A0
02:0004AE56 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004AE5A 41EC0306        	  2387:     lea     ($0306,A4),A0
02:0004AE5E 11802000        	  2388:     move.b  D0,(A0,D2.W)
02:0004AE62 41EC030A        	  2389:     lea     ($030A,A4),A0
02:0004AE66 11802000        	  2390:     move.b  D0,(A0,D2.W)
02:0004AE6A 41EC030B        	  2391:     lea     ($030B,A4),A0
02:0004AE6E 11802000        	  2392:     move.b  D0,(A0,D2.W)
                            	  2393:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2394:     ; Add 1 more to the second byte in each record.
                            	  2395:     ; Here is an example result of this manipulation:
                            	  2396:     ;   record 1: $70, $71
                            	  2397:     ;   record 2: $72, $73
                            	  2398:     ;
02:0004AE72 0C000046        	  2399:     cmpi.b  #$46,D0
02:0004AE76 6530            	  2400:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004AE78 0C0000F3        	  2401:     cmpi.b  #$F3,D0
02:0004AE7C 642A            	  2402:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004AE7E 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AE82 123C0002        	  2404:     move.b  #$02,D1
02:0004AE86 D101            	  2405:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004AE88 41EC030A        	  2406:     lea     ($030A,A4),A0
02:0004AE8C 11802000        	  2407:     move.b  D0,(A0,D2.W)
02:0004AE90 41EC030B        	  2408:     lea     ($030B,A4),A0
02:0004AE94 11802000        	  2409:     move.b  D0,(A0,D2.W)
02:0004AE98 41EC0306        	  2410:     lea     ($0306,A4),A0
02:0004AE9C 52302000        	  2411:     addq.b  #1,(A0,D2.W)
02:0004AEA0 41EC030B        	  2412:     lea     ($030B,A4),A0
02:0004AEA4 52302000        	  2413:     addq.b  #1,(A0,D2.W)
                            	  2414:     even
                            	  2415: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2416:     ; Set the count byte in each record to $82:
                            	  2417:     ; 2 tiles arranged vertically
                            	  2418:     ;
02:0004AEA8 103C0082        	  2419:     move.b  #$82,D0
02:0004AEAC 41EC0304        	  2420:     lea     ($0304,A4),A0
02:0004AEB0 11802000        	  2421:     move.b  D0,(A0,D2.W)
