02:0003EF20 10302000        	 12191:     move.b  (A0,D2.W),D0
02:0003EF24 122C04E6        	 12192:     move.b  ($04E6,A4),D1
02:0003EF28 D101            	 12193:     addx.b  D1,D0   ; ADC Lamnola_Speed
