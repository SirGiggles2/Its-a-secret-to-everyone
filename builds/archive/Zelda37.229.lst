02:0003CE64 1234203D        	  7819:     move.b  ($3D,A4,D2.W),D1
02:0003CE68 8001            	  7820:     or.b  D1,D0
02:0003CE6A 660000AE        	  7821:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7822:     ; Every odd screen frame, go straight to drawing
                            	  7823:     ; and checking collisions.
                            	  7824:     ;
02:0003CE6E 102C0015        	  7825:     move.b  ($0015,A4),D0
02:0003CE72 E208            	  7826:     lsr.b  #1,D0   ; LSR A
02:0003CE74 6404            	  7827:     bcc.s  __far_z_04_0073
02:0003CE76 60000118        	  7828:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7829: __far_z_04_0073:
                            	  7830:     ; Otherwise move horizontally.
                            	  7831:     ;
02:0003CE7A 6100028A        	  7832:     jsr     PolsVoice_MoveX
                            	  7833:     ; If state <> 0, then the monster is jumping.
                            	  7834:     ; Go handle vertical movement.
                            	  7835:     ;
02:0003CE7E 41EC00AC        	  7836:     lea     ($00AC,A4),A0
02:0003CE82 10302000        	  7837:     move.b  (A0,D2.W),D0
02:0003CE86 6706            	  7838:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CE88 61000130        	  7839:     jsr     UpdatePolsVoiceState1_Jumping
