02:00039B84 11802000        	   654:     move.b  D0,(A0,D2.W)
                            	   655:     ; Goriya will throw a boomerang (object type $5C).
                            	   656:     ;
02:00039B88 705C            	   657:     moveq   #92,D0
                            	   658:     ; If the monster is a blue goriya, go check the timer.
