02:00031E44 102C066F        	  6711:     move.b  ($066F,A4),D0
02:00031E48 0200000F        	  6712:     andi.b #$0F,D0
02:00031E4C 122C000D        	  6713:     move.b  ($000D,A4),D1
02:00031E50 B001            	  6714:     cmp.b   D1,D0
02:00031E52 6554            	  6715:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031E54 102C066F        	  6716:     move.b  ($066F,A4),D0
02:00031E58 003C0011        	  6717:     ori     #$11,CCR  ; SEC: set C+X
02:00031E5C 122C000D        	  6718:     move.b  ($000D,A4),D1
02:00031E60 0A3C0010        	  6719:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E64 9101            	  6720:     subx.b  D1,D0   ; SBC $0D
02:00031E66 0A3C0010        	  6721:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E6A 1940066F        	  6722:     move.b  D0,($066F,A4)
02:00031E6E 0A3C0001        	  6723:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031E72 4E75            	  6724:     rts
                            	  6725: 
