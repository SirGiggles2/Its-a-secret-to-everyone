                            	  3012:     ;
02:0003038E 41F900030352    	  3013:     lea     (TrapXs).l,A0
02:00030394 10303000        	  3014:     move.b  (A0,D3.W),D0
02:00030398 19802070        	  3015:     move.b  D0,($70,A4,D2.W)
02:0003039C 41F900030358    	  3016:     lea     (TrapYs).l,A0
02:000303A2 10303000        	  3017:     move.b  (A0,D3.W),D0
02:000303A6 41EC0084        	  3018:     lea     ($0084,A4),A0
02:000303AA 11802000        	  3019:     move.b  D0,(A0,D2.W)
