                            	  5787: AnimateAndDrawObjectWalking:
02:000317AC 4EB90004CD7C    	  5788:     jsr     AnimateObjectWalking
02:000317B2 1003            	  5789:     move.b  D3,D0
02:000317B4 6004            	  5790:     jmp     DrawObjectNotMirrored
                            	  5791: 
                            	  5792: ; Params:
                            	  5793: ; A: frame image
                            	  5794: ; X: object index
                            	  5795: ; [00]: object X
                            	  5796: ; [01]: object Y
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; Set [0C] mirrored.
                            	  5800:     even
                            	  5801: DrawObjectMirrored:
02:000317B6 7601            	  5802:     moveq   #1,D3
02:000317B8 6602            	  5803:     bne  _anon_z01_75
                            	  5804: ; Params:
                            	  5805: ; A: frame image
                            	  5806: ; X: object index
                            	  5807: ; [00]: object X
                            	  5808: ; [01]: object Y
                            	  5809: ; [0F]: flip horizontally
                            	  5810: ;
                            	  5811:     even
                            	  5812: DrawObjectNotMirrored:
02:000317BA 7600            	  5813:     moveq   #0,D3
                            	  5814: _anon_z01_75:
02:000317BC 1943000C        	  5815:     move.b  D3,($000C,A4)
                            	  5816:     ; Set animation index = object type + 1.
                            	  5817:     ;
02:000317C0 7600            	  5818:     moveq   #0,D3
02:000317C2 41EC034F        	  5819:     lea     ($034F,A4),A0
02:000317C6 16302000        	  5820:     move.b  (A0,D2.W),D3
                            	  5821: ; Params:
                            	  5822: ; A: frame
                            	  5823: ; X: object index/cycle sprite index
                            	  5824: ; Y: object type
                            	  5825: ; [00]: object X
                            	  5826: ; [01]: object Y
                            	  5827: ; [0C]: mirrored
                            	  5828: ; [0F]: flip horizontally
                            	  5829: ;
                            	  5830: ; Note:
                            	  5831: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5832: ;
                            	  5833: ; The animation index of most objects is (object type + 1),
                            	  5834: ; to make up for the fact that Link uses two animation indexes.
                            	  5835: ;
                            	  5836:     even
                            	  5837: DrawObjectWithType:
02:000317CA 5203            	  5838:     addq.b  #1,D3
                            	  5839: ; Params:
                            	  5840: ; A: frame
                            	  5841: ; X: object index/cycle sprite index
                            	  5842: ; Y: animation index
                            	  5843: ; [00]: object X
                            	  5844: ; [01]: object Y
                            	  5845: ; [0C]: mirrored
                            	  5846: ; [0F]: flip horizontally
                            	  5847: ;
                            	  5848: ; Note:
                            	  5849: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5850: ; But Link uses [0F] for flipping without checking [0C].
                            	  5851: ;
                            	  5852: ;
                            	  5853: ; [0D] holds frame.
                            	  5854:     even
                            	  5855: DrawObjectWithAnim:
02:000317CC 1940000D        	  5856:     move.b  D0,($000D,A4)
02:000317D0 1943000E        	  5857:     move.b  D3,($000E,A4)
02:000317D4 19420008        	  5858:     move.b  D2,($0008,A4)
                            	  5859:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5860:     ;
02:000317D8 7600            	  5861:     moveq   #0,D3
02:000317DA 162C0341        	  5862:     move.b  ($0341,A4),D3
02:000317DE 41F900031782    	  5863:     lea     (SpriteOffsets).l,A0
02:000317E4 10303000        	  5864:     move.b  (A0,D3.W),D0
02:000317E8 19400343        	  5865:     move.b  D0,($0343,A4)
02:000317EC 41F900031783    	  5866:     lea     (SpriteOffsets+1).l,A0
02:000317F2 10303000        	  5867:     move.b  (A0,D3.W),D0
                            	  5868:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5869:     ;
02:000317F6 4A02            	  5870:     cmpi.b  #$00,D2
02:000317F8 6702            	  5871:     beq.s  __far_z_01_0052
02:000317FA 6008            	  5872:     jmp  DrawObjectWithAnimAndSpecificSprites
