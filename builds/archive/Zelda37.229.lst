                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E04A 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E050 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E054 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E058 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E05C 020000C0        	   294:     andi.b #$C0,D0
02:0002E060 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E064 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E06A 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E06E 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E072 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E076 5203            	   304:     addq.b  #1,D3
02:0002E078 5202            	   305:     addq.b  #1,D2
02:0002E07A 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E07E 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E080 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E084 E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E086 E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E088 E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E08A 1214            	   315:     move.b  ($0000,A4),D1
02:0002E08C 8001            	   316:     or.b  D1,D0
02:0002E08E 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E090 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E094 E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E096 E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E098 E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E09A E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E09C 1214            	   326:     move.b  ($0000,A4),D1
02:0002E09E 8001            	   327:     or.b  D1,D0
02:0002E0A0 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E0A2 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E0A6 E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E0A8 E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E0AA 1214            	   335:     move.b  ($0000,A4),D1
02:0002E0AC 8001            	   336:     or.b  D1,D0
02:0002E0AE 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E0B2 02000020        	   343:     andi.b #$20,D0
02:0002E0B6 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E0BA 103C00FF        	   350:     move.b  #$FF,D0
02:0002E0BE 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E0C0 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E0C4 B001            	   355:     cmp.b   D1,D0
02:0002E0C6 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E0C8 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E0CC 123C002B        	   360:     move.b  #$2B,D1
02:0002E0D0 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E0D4 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E0D6 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E0DA 5303            	   364:     subq.b  #1,D3
02:0002E0DC 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
