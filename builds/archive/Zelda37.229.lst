02:000302B4 41EC0084        	  2888:     lea     ($0084,A4),A0
02:000302B8 11802000        	  2889:     move.b  D0,(A0,D2.W)
                            	  2890:     ; Return, if the empty slot we found indicates it was initialized.
                            	  2891:     ; I don't know how it would get in this state, because when
                            	  2892:     ; a monster is destroyed, type is assigned 0, and it's uninitialized.
