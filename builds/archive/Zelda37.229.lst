02:00031E14 7000            	  6689:     moveq   #0,D0
02:00031E16 19400627        	  6690:     move.b  D0,($0627,A4)
02:00031E1A 19400050        	  6691:     move.b  D0,($0050,A4)
02:00031E1E 19400051        	  6692:     move.b  D0,($0051,A4)
                            	  6693:     ; If heart partial >= low damage points byte, then simply
                            	  6694:     ; subtract the damage byte from heart partial.
                            	  6695:     ; Else go borrow from full hearts.
                            	  6696:     ;
02:00031E22 102C0670        	  6697:     move.b  ($0670,A4),D0
02:00031E26 122C000E        	  6698:     move.b  ($000E,A4),D1
02:00031E2A B001            	  6699:     cmp.b   D1,D0
