                            	  2269: 
                            	  2270: ; Params:
                            	  2271: ; A: Y coordinate
                            	  2272: ; X: object index
                            	  2273: ;
                            	  2274:     even
                            	  2275: InitWhirlwind:
02:0002FE9C 6000BDAC        	  2276:     jmp     c_init_whirlwind
                            	  2277: 
                            	  2278: SetUpWhirlwind:
02:0002FEA0 6000BB58        	  2279:     jmp     c_set_up_whirlwind
                            	  2280: 
                            	  2281: WhirlwindPrevRoomIdList:
02:0002FEA4 36              	  2282:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FEA5 3B
02:0002FEA6 73
02:0002FEA7 44
02:0002FEA8 0A
02:0002FEA9 21
02:0002FEAA 41
02:0002FEAB 6C
                            	  2283: 
                            	  2284:     even
                            	  2285: UpdateWhirlwind_Full:
                            	  2286:     ; Get Link's halted state.
                            	  2287:     ;
02:0002FEAC 102C00AC        	  2288:     move.b  ($00AC,A4),D0
02:0002FEB0 02000040        	  2289:     andi.b #$40,D0
02:0002FEB4 7600            	  2290:     moveq   #0,D3
02:0002FEB6 1600            	  2291:     move.b  D0,D3
                            	  2292:     ; Add 2 to whirlwind X.
                            	  2293:     ;
02:0002FEB8 7002            	  2294:     moveq   #2,D0
02:0002FEBA 023C00EE        	  2295:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FEBE 12342070        	  2296:     move.b  ($70,A4,D2.W),D1
02:0002FEC2 D101            	  2297:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FEC4 19802070        	  2298:     move.b  D0,($70,A4,D2.W)
                            	  2299:     ; If Link is not halted or teleporting state = 0, then
                            	  2300:     ; go check for collision with Link.
                            	  2301:     ;
02:0002FEC8 0C030040        	  2302:     cmpi.b  #$40,D3
02:0002FECC 6638            	  2303:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FECE 7600            	  2304:     moveq   #0,D3
02:0002FED0 162C0522        	  2305:     move.b  ($0522,A4),D3
02:0002FED4 6730            	  2306:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2307:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2308:     ;
                            	  2309:     ; Set Link's X to whirlwind's.
                            	  2310:     ;
02:0002FED6 19400070        	  2311:     move.b  D0,($0070,A4)
                            	  2312:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2313:     ; the right screen edge and draw.
                            	  2314:     ;
02:0002FEDA 5303            	  2315:     subq.b  #1,D3
02:0002FEDC 6776            	  2316:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FEDE 0C000080        	  2317:     cmpi.b  #$80,D0
02:0002FEE2 6670            	  2318:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2319:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2320:     ;
                            	  2321:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2322:     ;
02:0002FEE4 E308            	  2323:     lsl.b  #1,D0   ; ASL A
02:0002FEE6 194000AC        	  2324:     move.b  D0,($00AC,A4)
02:0002FEEA 19400522        	  2325:     move.b  D0,($0522,A4)
02:0002FEEE 41EC034F        	  2326:     lea     ($034F,A4),A0
02:0002FEF2 11802000        	  2327:     move.b  D0,(A0,D2.W)
                            	  2328:     ; Update the player position marker, and draw one last time.
                            	  2329:     ;
02:0002FEF6 1002            	  2330:     move.b  D2,D0
02:0002FEF8 1B00            	  2331:     move.b  D0,-(A5)  ; PHA
02:0002FEFA 610010AC        	  2332:     jsr     UpdatePlayerPositionMarker
02:0002FEFE 101D            	  2333:     move.b  (A5)+,D0  ; PLA
02:0002FF00 7400            	  2334:     moveq   #0,D2
02:0002FF02 1400            	  2335:     move.b  D0,D2
02:0002FF04 6070            	  2336:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2337: 
                            	  2338:     even
                            	  2339: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2340:     ; Link is not halted or teleporting state = 0.
                            	  2341:     ; Try to pick up Link.
                            	  2342:     ;
                            	  2343:     ; If the whirlwind does not collide with Link, then go check
                            	  2344:     ; for the screen's right edge.
                            	  2345:     ;
02:0002FF06 61001D78        	  2346:     jsr     CheckLinkCollision
02:0002FF0A 102C0006        	  2347:     move.b  ($0006,A4),D0
02:0002FF0E 6744            	  2348:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2349:     ; Collided with Link.
                            	  2350:     ;
                            	  2351:     ; Make Link face right. Reset shove info and subroom type.
                            	  2352:     ;
02:0002FF10 7001            	  2353:     moveq   #1,D0
02:0002FF12 19400098        	  2354:     move.b  D0,($0098,A4)
02:0002FF16 E208            	  2355:     lsr.b  #1,D0   ; LSR A
02:0002FF18 194000C0        	  2356:     move.b  D0,($00C0,A4)
02:0002FF1C 194000D3        	  2357:     move.b  D0,($00D3,A4)
02:0002FF20 1940005A        	  2358:     move.b  D0,($005A,A4)
                            	  2359:     ; Halt Link (state $40), and hide him.
                            	  2360:     ;
02:0002FF24 7040            	  2361:     moveq   #64,D0
02:0002FF26 194000AC        	  2362:     move.b  D0,($00AC,A4)
02:0002FF2A 103C00F8        	  2363:     move.b  #$F8,D0
02:0002FF2E 19400248        	  2364:     move.b  D0,($0248,A4)
02:0002FF32 1940024C        	  2365:     move.b  D0,($024C,A4)
                            	  2366:     ; Find and set the room that will behave as the previous room
                            	  2367:     ; when scrolling right to the room with the level's entrance.
                            	  2368:     ;
02:0002FF36 102C0523        	  2369:     move.b  ($0523,A4),D0
02:0002FF3A 02000007        	  2370:     andi.b #$07,D0
02:0002FF3E 7600            	  2371:     moveq   #0,D3
02:0002FF40 1600            	  2372:     move.b  D0,D3
02:0002FF42 41F90002FEA4    	  2373:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FF48 10303000        	  2374:     move.b  (A0,D3.W),D0
02:0002FF4C 194000EA        	  2375:     move.b  D0,($00EA,A4)
                            	  2376:     ; Set teleporting state 1.
                            	  2377:     ;
02:0002FF50 522C0522        	  2378:     addq.b  #1,($0522,A4)
                            	  2379:     even
                            	  2380: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2381:     ; If whirlwind's X < $F0, go draw.
                            	  2382:     ;
02:0002FF54 10342070        	  2383:     move.b  ($70,A4,D2.W),D0
02:0002FF58 0C0000F0        	  2384:     cmpi.b  #$F0,D0
02:0002FF5C 6518            	  2385:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2386:     ; The whirlwind has reached the right edge of the screen.
                            	  2387:     ;
                            	  2388:     ; Destroy the object.
                            	  2389:     ;
02:0002FF5E 611A            	  2390:     jsr     DestroyWhirlwind
                            	  2391:     ; If teleporting state <> 0, we picked up Link.
                            	  2392:     ; So, go to the next mode.
                            	  2393:     ;
                            	  2394:     ; Either way, draw one last time.
                            	  2395:     ;
02:0002FF60 102C0522        	  2396:     move.b  ($0522,A4),D0
02:0002FF64 6710            	  2397:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0002FF66 1002            	  2398:     move.b  D2,D0
02:0002FF68 1B00            	  2399:     move.b  D0,-(A5)  ; PHA
02:0002FF6A 4EB90004BC36    	  2400:     jsr     GoToNextModeFromPlay
02:0002FF70 101D            	  2401:     move.b  (A5)+,D0  ; PLA
02:0002FF72 7400            	  2402:     moveq   #0,D2
02:0002FF74 1400            	  2403:     move.b  D0,D2
                            	  2404:     even
                            	  2405: _L_z01_UpdateWhirlwind_Full_Draw:
02:0002FF76 600000A8        	  2406:     jmp     DrawWhirlwind
                            	  2407: 
                            	  2408:     even
                            	  2409: DestroyWhirlwind:
02:0002FF7A 6000B898        	  2410:     jmp     c_destroy_whirlwind
                            	  2411: 
                            	  2412: SummonWhirlwind:
                            	  2413:     ; If not in mode 5, return.
                            	  2414:     ;
02:0002FF7E 102C0012        	  2415:     move.b  ($0012,A4),D0
02:0002FF82 0C000005        	  2416:     cmpi.b  #$05,D0
02:0002FF86 6704            	  2417:     beq.s  __far_z_01_0015
02:0002FF88 60000094        	  2418:     jmp  L6104_Exit
                            	  2419: __far_z_01_0015:
                            	  2420:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2421:     ;
02:0002FF8C 6178            	  2422:     jsr     AdvanceTeleportingLevelIndex
02:0002FF8E 102C0523        	  2423:     move.b  ($0523,A4),D0
02:0002FF92 02000007        	  2424:     andi.b #$07,D0
02:0002FF96 7600            	  2425:     moveq   #0,D3
02:0002FF98 1600            	  2426:     move.b  D0,D3
02:0002FF9A 41F90004AB28    	  2427:     lea     (LevelMasks).l,A0
02:0002FFA0 10303000        	  2428:     move.b  (A0,D3.W),D0
02:0002FFA4 1880            	  2429:     move.b  D0,($0000,A4)
                            	  2430:     even
                            	  2431: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2432:     ; If there are no triforce pieces, then return.
                            	  2433:     ;
02:0002FFA6 102C0671        	  2434:     move.b  ($0671,A4),D0
02:0002FFAA 6602            	  2435:     bne.s  __far_z_01_0016
02:0002FFAC 6070            	  2436:     jmp  L6104_Exit
                            	  2437: __far_z_01_0016:
                            	  2438:     ; If we have gotten this triforce piece, then go try to make a
                            	  2439:     ; whirlwind.
                            	  2440:     ;
02:0002FFAE 1214            	  2441:     move.b  ($0000,A4),D1
02:0002FFB0 C200            	  2442:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FFB2 662C            	  2443:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2444:     ; We have not gotten this piece.
                            	  2445:     ; First, advance the teleporting index again.
                            	  2446:     ;
02:0002FFB4 6150            	  2447:     jsr     AdvanceTeleportingLevelIndex
                            	  2448:     ; If the direction Link is facing is an increasing one, then
                            	  2449:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2450:     ; level number. Then go test this new mask.
                            	  2451:     ;
02:0002FFB6 102C0098        	  2452:     move.b  ($0098,A4),D0
02:0002FFBA 02000009        	  2453:     andi.b #$09,D0
02:0002FFBE 6710            	  2454:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FFC0 1214            	  2455:     move.b  ($0000,A4),D1
