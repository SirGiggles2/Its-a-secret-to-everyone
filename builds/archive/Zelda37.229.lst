                            	  1886: _L_z01_TransferDemoPatterns_LoopBlock:
                            	  1887:     ; Loop over each block.
                            	  1888:     ;
02:0002EBB4 102C051D        	  1889:     move.b  ($051D,A4),D0
02:0002EBB8 E308            	  1890:     lsl.b  #1,D0   ; ASL A
02:0002EBBA 7400            	  1891:     moveq   #0,D2
02:0002EBBC 1400            	  1892:     move.b  D0,D2
                            	  1893:     ; Put block address in [00:01] and size in [03:02].
                            	  1894:     ; Load destination VRAM address and set it.
                            	  1895:     ; The size and VRAM address have the high byte first.
                            	  1896:     ;
02:0002EBBE 41F90002EB98    	  1897:     lea     (DemoPatternBlockAddrs).l,A0
02:0002EBC4 3A02            	  1898:     move.w  D2,D5
02:0002EBC6 DA45            	  1899:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0002EBC8 2A305000        	  1900:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002EBCC 29450004        	  1901:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002EBD0 41F90002EBA0    	  1902:     lea     (DemoPatternBlockSizes).l,A0
02:0002EBD6 10302000        	  1903:     move.b  (A0,D2.W),D0
