                            	  5852: CalcBoomerangFrame:
                            	  5853:     ; The minor state (low 3 bits of state) is used to
                            	  5854:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5855:     ;
                            	  5856:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5857:     ; In other words, don't offset the coordinate below.
                            	  5858:     ;
02:0004C672 7000            	  5859:     moveq   #0,D0
02:0004C674 1880            	  5860:     move.b  D0,($0000,A4)
02:0004C676 41EC00AC        	  5861:     lea     ($00AC,A4),A0
02:0004C67A 10302000        	  5862:     move.b  (A0,D2.W),D0
02:0004C67E 0200000F        	  5863:     andi.b #$0F,D0
02:0004C682 7600            	  5864:     moveq   #0,D3
02:0004C684 1600            	  5865:     move.b  D0,D3
02:0004C686 7000            	  5866:     moveq   #0,D0
02:0004C688 19400001        	  5867:     move.b  D0,($0001,A4)
02:0004C68C 41F90004C27A    	  5868:     lea     (BoomerangFrameCycle).l,A0
02:0004C692 10303000        	  5869:     move.b  (A0,D3.W),D0
02:0004C696 1940000C        	  5870:     move.b  D0,($000C,A4)
                            	  5871:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5872:     ;
02:0004C69A 1003            	  5873:     move.b  D3,D0
02:0004C69C 41F90004C284    	  5874:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C6A2 10303000        	  5875:     move.b  (A0,D3.W),D0
