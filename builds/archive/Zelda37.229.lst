02:0002E0E0 41F90002DFBA    	   371:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E0E6 14303000        	   372:     move.b  (A0,D3.W),D2
                            	   373:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   374:     ;
02:0002E0EA 7602            	   375:     moveq   #2,D3
                            	   376:     even
                            	   377: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E0EC 41F90002DFA8    	   378:     lea     (MoneyGamePermutations).l,A0
02:0002E0F2 10302000        	   379:     move.b  (A0,D2.W),D0
02:0002E0F6 41EC046C        	   380:     lea     ($046C,A4),A0
02:0002E0FA 11803000        	   381:     move.b  D0,(A0,D3.W)
02:0002E0FE 5302            	   382:     subq.b  #1,D2
02:0002E100 5303            	   383:     subq.b  #1,D3
02:0002E102 6AE8            	   384:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   385:     ; With the first bit of another random number, choose 10 or 40
                            	   386:     ; to put in [046F]. This is a random amount to lose.
                            	   387:     ;
02:0002E104 102C001A        	   388:     move.b  ($001A,A4),D0
02:0002E108 02000001        	   389:     andi.b #$01,D0
02:0002E10C 7600            	   390:     moveq   #0,D3
02:0002E10E 1600            	   391:     move.b  D0,D3
02:0002E110 41F90002DFA6    	   392:     lea     (MoneyGameLossAmounts).l,A0
02:0002E116 10303000        	   393:     move.b  (A0,D3.W),D0
02:0002E11A 1940046F        	   394:     move.b  D0,($046F,A4)
                            	   395:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   396:     ;
02:0002E11E 700A            	   397:     moveq   #10,D0
02:0002E120 19400470        	   398:     move.b  D0,($0470,A4)
                            	   399:     ; With a different bit of the second random number,
                            	   400:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   401:     ;
