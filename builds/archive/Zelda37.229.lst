                            	  9833: Manhandla_Draw:
02:0003DDA8 4EB90004CDE0    	  9834:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9835:     ; Push the "frame image and sprite attributes" value.
                            	  9836:     ;
02:0003DDAE 41EC0478        	  9837:     lea     ($0478,A4),A0
02:0003DDB2 10302000        	  9838:     move.b  (A0,D2.W),D0
02:0003DDB6 1B00            	  9839:     move.b  D0,-(A5)  ; PHA
                            	  9840:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9841:     ; passed along as is.
                            	  9842:     ;
02:0003DDB8 02000080        	  9843:     andi.b #$80,D0
02:0003DDBC 00000001        	  9844:     ori.b #$01,D0
02:0003DDC0 4EB900031AAC    	  9845:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DDC6 101D            	  9846:     move.b  (A5)+,D0  ; PLA
02:0003DDC8 1B00            	  9847:     move.b  D0,-(A5)  ; PHA
                            	  9848:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9849:     ;
02:0003DDCA 02000040        	  9850:     andi.b #$40,D0
02:0003DDCE 6704            	  9851:     beq  _anon_z04_116
02:0003DDD0 522C000F        	  9852:     addq.b  #1,($000F,A4)
                            	  9853: _anon_z04_116:
02:0003DDD4 101D            	  9854:     move.b  (A5)+,D0  ; PLA
                            	  9855:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9856:     ; These are the 2 frame images of the horizontal hands.
