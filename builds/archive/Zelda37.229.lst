                            	   584: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   585: c_has_compass:
02:0002B6B2 4EB900000000    	   586:     jsr     z05_has_compass
02:0002B6B8 4A00            	   587:     tst.b   D0
02:0002B6BA 4E75            	   588:     rts
                            	   589: 
                            	   590: c_has_map:
02:0002B6BC 4EB900000000    	   591:     jsr     z05_has_map
02:0002B6C2 4A00            	   592:     tst.b   D0
02:0002B6C4 4E75            	   593:     rts
