02:0003E06C 6614            	 10216:     bne  _L_z04_Gohma_HandleWeaponCollision_CheckHitEye
02:0003E06E 7028            	 10217:     moveq   #40,D0
02:0003E070 41EC00AC        	 10218:     lea     ($00AC,A4),A0
02:0003E074 11803000        	 10219:     move.b  D0,(A0,D3.W)
02:0003E078 7004            	 10220:     moveq   #4,D0
02:0003E07A 41EC03D0        	 10221:     lea     ($03D0,A4),A0
02:0003E07E 11803000        	 10222:     move.b  D0,(A0,D3.W)
                            	 10223:     even
                            	 10224: _L_z04_Gohma_HandleWeaponCollision_CheckHitEye:
                            	 10225:     ; If it did not hit part 3 nor 4, then go play the parry sound effect.
                            	 10226:     ;
02:0003E082 102C000F        	 10227:     move.b  ($000F,A4),D0
