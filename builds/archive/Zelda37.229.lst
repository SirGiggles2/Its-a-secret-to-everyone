02:000400B6 61004B56        	   301:     jsr     Submenu_CueTransferRowUW
02:000400BA 60E8            	   302:     jmp     _anon_z05_1
                            	   303: 
                            	   304:     even
                            	   305: UpdateMenu5OW:
                            	   306:     ; Cue the transfer of "TRIFORCE" text.
                            	   307:     ;
02:000400BC 705C            	   308:     moveq   #92,D0
02:000400BE 6702            	   309:     beq.s  __far_z_05_0002
02:000400C0 60DC            	   310:     jmp  SelectTransferBufAndIncState
                            	   311: __far_z_05_0002:
