02:00030E7E E208            	  4684:     lsr.b  #1,D0   ; LSR A
02:00030E80 6110            	  4685:     jsr     ChooseOffsetForDirectionH
02:00030E82 122C0084        	  4686:     move.b  ($0084,A4),D1
02:00030E86 D101            	  4687:     addx.b  D1,D0   ; ADC ObjY
02:00030E88 41EC0084        	  4688:     lea     ($0084,A4),A0
