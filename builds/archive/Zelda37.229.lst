02:00041C12 4EB9000308D2    	  3493:     jsr     CheckPersonBlocking
02:00041C18 101D            	  3494:     move.b  (A5)+,D0  ; PLA
                            	  3495:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3496:     ;
02:00041C1A 0C00000C        	  3497:     cmpi.b  #$0C,D0
02:00041C1E 6704            	  3498:     beq.s  __far_z_05_0069
02:00041C20 6000009E        	  3499:     jmp  CheckCaveEdge
                            	  3500: __far_z_05_0069:
                            	  3501:     ; In a shortcut cave (mode $C).
