                            	  6989: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6990:     ; To animate the state, the animation counter had to have
                            	  6991:     ; reached 0. Right after this routine, the counter will be
                            	  6992:     ; rolled over, and the movement frame will be switched.
                            	  6993:     ;
                            	  6994:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6995:     ; the animation here, in order to immediately change it to
                            	  6996:     ; 0 (legs apart) after this.
                            	  6997:     ;
02:0004CE28 7001            	  6998:     moveq   #1,D0
02:0004CE2A 194003E4        	  6999:     move.b  D0,($03E4,A4)
02:0004CE2E 4E75            	  7000:     rts
                            	  7001: 
                            	  7002:     even
