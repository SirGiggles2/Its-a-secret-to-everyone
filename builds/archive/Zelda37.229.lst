                            	  4553:     ; If the difference between the coordinates < 9, increment [00].
                            	  4554:     ;
02:00030DB8 102C0002        	  4555:     move.b  ($0002,A4),D0
02:00030DBC 003C0011        	  4556:     ori     #$11,CCR  ; SEC: set C+X
02:00030DC0 122C0001        	  4557:     move.b  ($0001,A4),D1
02:00030DC4 0A3C0010        	  4558:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030DC8 9101            	  4559:     subx.b  D1,D0   ; SBC $01
02:00030DCA 0A3C0010        	  4560:     eori    #$10,CCR  ; restore X = 6502 C
02:00030DCE 0C000009        	  4561:     cmpi.b  #$09,D0
02:00030DD2 6402            	  4562:     bcc  _anon_z01_52
