                            	  3616: _L_z04_UpdateOctorock_SaveOffset:
02:0003B080 1B00            	  3617:     move.b  D0,-(A5)  ; PHA
                            	  3618:     ; Decrement the animation counter, and roll over if needed.
                            	  3619:     ;
02:0003B082 41EC03D0        	  3620:     lea     ($03D0,A4),A0
02:0003B086 53302000        	  3621:     subq.b  #1,(A0,D2.W)
02:0003B08A 661E            	  3622:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B08C 7006            	  3623:     moveq   #6,D0
02:0003B08E 41EC03D0        	  3624:     lea     ($03D0,A4),A0
02:0003B092 11802000        	  3625:     move.b  D0,(A0,D2.W)
                            	  3626:     ; There are actually 6 frame images divided into 2 sets.
                            	  3627:     ; Each set depicts one animation frame. In each set there are
                            	  3628:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3629:     ;
                            	  3630:     ; The movement frame will keep track of the base offset of
                            	  3631:     ; the current set for the current animation frame: 0 or 3.
                            	  3632:     ;
                            	  3633:     ; So, XOR the movement frame with 3.
                            	  3634:     ;
02:0003B096 E208            	  3635:     lsr.b  #1,D0   ; LSR A
02:0003B098 41EC03E4        	  3636:     lea     ($03E4,A4),A0
02:0003B09C 12302000        	  3637:     move.b  (A0,D2.W),D1
02:0003B0A0 B300            	  3638:     eor.b  D1,D0
02:0003B0A2 41EC03E4        	  3639:     lea     ($03E4,A4),A0
02:0003B0A6 11802000        	  3640:     move.b  D0,(A0,D2.W)
                            	  3641:     even
                            	  3642: _L_z04_UpdateOctorock_CalcFinalOffset:
