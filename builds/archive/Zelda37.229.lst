                            	  6999: UpdateDodongoState0_Move:
                            	  7000:     ; If facing left, then push X offset 0 on the stack.
                            	  7001:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7002:     ;
                            	  7003:     ; We would like to use one set of coordinates only.
                            	  7004:     ; But movement would break down, if we did; because
                            	  7005:     ; Dodongo is so long.
                            	  7006:     ;
                            	  7007:     ; So, when not facing left, we temporarily shift the
                            	  7008:     ; X coordinate to be closer to the other side of the monster.
                            	  7009:     ;
02:0003C8E8 7600            	  7010:     moveq   #0,D3
02:0003C8EA 41EC0098        	  7011:     lea     ($0098,A4),A0
02:0003C8EE 10302000        	  7012:     move.b  (A0,D2.W),D0
02:0003C8F2 0200000D        	  7013:     andi.b #$0D,D0
02:0003C8F6 6716            	  7014:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C8F8 10342070        	  7015:     move.b  ($70,A4,D2.W),D0
02:0003C8FC 023C00EE        	  7016:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C900 123C0010        	  7017:     move.b  #$10,D1
02:0003C904 D101            	  7018:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C906 19802070        	  7019:     move.b  D0,($70,A4,D2.W)
02:0003C90A 163C00F0        	  7020:     move.b  #$F0,D3
                            	  7021:     even
                            	  7022: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C90E 1003            	  7023:     move.b  D3,D0
02:0003C910 1B00            	  7024:     move.b  D0,-(A5)  ; PHA
02:0003C912 7020            	  7025:     moveq   #32,D0
02:0003C914 41EC041F        	  7026:     lea     ($041F,A4),A0
02:0003C918 11802000        	  7027:     move.b  D0,(A0,D2.W)
02:0003C91C 6100CFFC        	  7028:     jsr     Wanderer_TargetPlayer
                            	  7029:     ; Pop the offset and add it to the X coordinate.
                            	  7030:     ;
                            	  7031:     ; This brings the X coordinate back to the unique value
                            	  7032:     ; that represents the position.
                            	  7033:     ;
02:0003C920 101D            	  7034:     move.b  (A5)+,D0  ; PLA
02:0003C922 023C00EE        	  7035:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C926 12342070        	  7036:     move.b  ($70,A4,D2.W),D1
