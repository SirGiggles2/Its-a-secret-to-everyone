                            	  6468: Digdogger_Move:
                            	  6469:     ; This calculation is the same one used in Manhandla to
                            	  6470:     ; manifest the fractional speed over several frames.
                            	  6471:     ;
                            	  6472:     ; To summarize, the formula is:
                            	  6473:     ;
                            	  6474:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6475:     ;
                            	  6476:     ;   SA := SA + (SL AND $E0)
                            	  6477:     ;   [03] := SH + carry
                            	  6478:     ;
                            	  6479:     ; See 04:A28E Manhandla_Move.
                            	  6480:     ;
02:0003C4DE 41EC041F        	  6481:     lea     ($041F,A4),A0
02:0003C4E2 10302000        	  6482:     move.b  (A0,D2.W),D0
02:0003C4E6 020000E0        	  6483:     andi.b #$E0,D0
02:0003C4EA 023C00EE        	  6484:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4EE 41EC0412        	  6485:     lea     ($0412,A4),A0
02:0003C4F2 12302000        	  6486:     move.b  (A0,D2.W),D1
02:0003C4F6 D101            	  6487:     addx.b  D1,D0   ; ADC $0412,X
02:0003C4F8 41EC0412        	  6488:     lea     ($0412,A4),A0
02:0003C4FC 11802000        	  6489:     move.b  D0,(A0,D2.W)
                            	  6490:     ; Assign (high speed byte + carry) to [03].
                            	  6491:     ;
02:0003C500 41EC042C        	  6492:     lea     ($042C,A4),A0
02:0003C504 10302000        	  6493:     move.b  (A0,D2.W),D0
02:0003C508 123C0000        	  6494:     move.b  #$00,D1
02:0003C50C D101            	  6495:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C50E 19400003        	  6496:     move.b  D0,($0003,A4)
                            	  6497:     ; Change coordinates by the speed amount/offset in [03]
                            	  6498:     ; according to the direction.
                            	  6499:     ;
                            	  6500:     ; Start with a mask of $A1 in [02]:
                            	  6501:     ; - low nibble represents the right direction
                            	  6502:     ; - high nibble is used to set or clear carry as we go along
                            	  6503:     ;
02:0003C512 103C00A1        	  6504:     move.b  #$A1,D0
02:0003C516 19400002        	  6505:     move.b  D0,($0002,A4)
                            	  6506:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6507:     ;
02:0003C51A 41EC0098        	  6508:     lea     ($0098,A4),A0
02:0003C51E 10302000        	  6509:     move.b  (A0,D2.W),D0
02:0003C522 122C0002        	  6510:     move.b  ($0002,A4),D1
02:0003C526 C200            	  6511:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C528 6712            	  6512:     beq  _L_z04_Digdogger_Move_Left
02:0003C52A 10342070        	  6513:     move.b  ($70,A4,D2.W),D0
02:0003C52E 023C00EE        	  6514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C532 122C0003        	  6515:     move.b  ($0003,A4),D1
02:0003C536 D101            	  6516:     addx.b  D1,D0   ; ADC $03
02:0003C538 19802070        	  6517:     move.b  D0,($70,A4,D2.W)
                            	  6518:     even
                            	  6519: _L_z04_Digdogger_Move_Left:
                            	  6520:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6521:     ;
02:0003C53C 41EC0098        	  6522:     lea     ($0098,A4),A0
02:0003C540 10302000        	  6523:     move.b  (A0,D2.W),D0
02:0003C544 122C0002        	  6524:     move.b  ($0002,A4),D1
02:0003C548 E309            	  6525:     lsl.b  #1,D1   ; ASL $02
02:0003C54A 19410002        	  6526:     move.b  D1,($0002,A4)
02:0003C54E 122C0002        	  6527:     move.b  ($0002,A4),D1
02:0003C552 C200            	  6528:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C554 6716            	  6529:     beq  _L_z04_Digdogger_Move_Down
02:0003C556 10342070        	  6530:     move.b  ($70,A4,D2.W),D0
02:0003C55A 122C0003        	  6531:     move.b  ($0003,A4),D1
02:0003C55E 0A3C0010        	  6532:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C562 9101            	  6533:     subx.b  D1,D0   ; SBC $03
02:0003C564 0A3C0010        	  6534:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C568 19802070        	  6535:     move.b  D0,($70,A4,D2.W)
                            	  6536:     even
                            	  6537: _L_z04_Digdogger_Move_Down:
                            	  6538:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6539:     ;
02:0003C56C 41EC0098        	  6540:     lea     ($0098,A4),A0
02:0003C570 10302000        	  6541:     move.b  (A0,D2.W),D0
02:0003C574 122C0002        	  6542:     move.b  ($0002,A4),D1
02:0003C578 E309            	  6543:     lsl.b  #1,D1   ; ASL $02
02:0003C57A 19410002        	  6544:     move.b  D1,($0002,A4)
02:0003C57E 122C0002        	  6545:     move.b  ($0002,A4),D1
02:0003C582 C200            	  6546:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C584 6716            	  6547:     beq  _L_z04_Digdogger_Move_Up
02:0003C586 41EC0084        	  6548:     lea     ($0084,A4),A0
02:0003C58A 10302000        	  6549:     move.b  (A0,D2.W),D0
02:0003C58E 122C0003        	  6550:     move.b  ($0003,A4),D1
02:0003C592 D101            	  6551:     addx.b  D1,D0   ; ADC $03
02:0003C594 41EC0084        	  6552:     lea     ($0084,A4),A0
02:0003C598 11802000        	  6553:     move.b  D0,(A0,D2.W)
                            	  6554:     even
                            	  6555: _L_z04_Digdogger_Move_Up:
                            	  6556:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6557:     ;
02:0003C59C 41EC0098        	  6558:     lea     ($0098,A4),A0
02:0003C5A0 10302000        	  6559:     move.b  (A0,D2.W),D0
02:0003C5A4 122C0002        	  6560:     move.b  ($0002,A4),D1
02:0003C5A8 E309            	  6561:     lsl.b  #1,D1   ; ASL $02
02:0003C5AA 19410002        	  6562:     move.b  D1,($0002,A4)
02:0003C5AE 122C0002        	  6563:     move.b  ($0002,A4),D1
02:0003C5B2 C200            	  6564:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5B4 671E            	  6565:     beq  _L_z04_Digdogger_Move_End
02:0003C5B6 41EC0084        	  6566:     lea     ($0084,A4),A0
02:0003C5BA 10302000        	  6567:     move.b  (A0,D2.W),D0
02:0003C5BE 122C0003        	  6568:     move.b  ($0003,A4),D1
02:0003C5C2 0A3C0010        	  6569:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5C6 9101            	  6570:     subx.b  D1,D0   ; SBC $03
02:0003C5C8 0A3C0010        	  6571:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5CC 41EC0084        	  6572:     lea     ($0084,A4),A0
02:0003C5D0 11802000        	  6573:     move.b  D0,(A0,D2.W)
                            	  6574:     even
                            	  6575: _L_z04_Digdogger_Move_End:
02:0003C5D4 4EF90004CDE0    	  6576:     jmp     Anim_FetchObjPosForSpriteDescriptor
                            	  6577: 
                            	  6578:     even
                            	  6579: DigdoggerSpriteOffsetsX:
02:0003C5DA 00              	  6580:     dc.b    $00, $10, $00, $10
02:0003C5DB 10
02:0003C5DC 00
02:0003C5DD 10
                            	  6581: 
                            	  6582:     even
                            	  6583: DigdoggerSpriteOffsetsY:
02:0003C5DE 00              	  6584:     dc.b    $00, $00, $10, $10
02:0003C5DF 00
02:0003C5E0 10
02:0003C5E1 10
