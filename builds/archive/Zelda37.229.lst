02:0003AFB2 023C00EE        	  3520:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFB6 123C0001        	  3521:     move.b  #$01,D1
02:0003AFBA D101            	  3522:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003AFBC 0C000006        	  3523:     cmpi.b  #$06,D0
02:0003AFC0 6506            	  3524:     bcs  _anon_z04_47
02:0003AFC2 532C0510        	  3525:     subq.b  #1,($0510,A4)
02:0003AFC6 7000            	  3526:     moveq   #0,D0
                            	  3527: _anon_z04_47:
