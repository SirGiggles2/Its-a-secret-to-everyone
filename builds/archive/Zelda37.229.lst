                            	  7527: Dodongo_Draw:
02:0003CC5C 610000F4        	  7528:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7529:     ; Make a 5-way direction index out of the facing direction
                            	  7530:     ; by shifting right once, and store it in [00].
                            	  7531:     ;
02:0003CC60 41EC0098        	  7532:     lea     ($0098,A4),A0
02:0003CC64 10302000        	  7533:     move.b  (A0,D2.W),D0
02:0003CC68 E208            	  7534:     lsr.b  #1,D0   ; LSR A
02:0003CC6A 1880            	  7535:     move.b  D0,($0000,A4)
                            	  7536:     ; If state = 0, go handle animating the two frames of this state.
                            	  7537:     ;
02:0003CC6C 7600            	  7538:     moveq   #0,D3
02:0003CC6E 41EC00AC        	  7539:     lea     ($00AC,A4),A0
02:0003CC72 16302000        	  7540:     move.b  (A0,D2.W),D3
02:0003CC76 6744            	  7541:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7542:     ; If state > 1, then the monster is stunned (state 2).
                            	  7543:     ; So, go switch frames every $20 screen frames.
                            	  7544:     ;
02:0003CC78 7020            	  7545:     moveq   #32,D0
02:0003CC7A 5303            	  7546:     subq.b  #1,D3
02:0003CC7C 6640            	  7547:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7548:     ; State = 1. Bloated.
                            	  7549:     ;
                            	  7550:     ; In substate 0, go animate as usual for walking.
                            	  7551:     ;
02:0003CC7E 7600            	  7552:     moveq   #0,D3
02:0003CC80 41EC042C        	  7553:     lea     ($042C,A4),A0
02:0003CC84 16302000        	  7554:     move.b  (A0,D2.W),D3
02:0003CC88 6732            	  7555:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7556:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7557:     ; go fade the boss; so that some frames are not drawn.
                            	  7558:     ;
02:0003CC8A 0C030002        	  7559:     cmpi.b  #$02,D3
02:0003CC8E 6718            	  7560:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC90 0C030003        	  7561:     cmpi.b  #$03,D3
02:0003CC94 6712            	  7562:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7563:     ; State 1, substate 1
                            	  7564:     ;
                            	  7565:     ; Add $14 to the frame image index to index into the bloated
                            	  7566:     ; frame images and H-flips.
                            	  7567:     ;
02:0003CC96 1014            	  7568:     move.b  ($0000,A4),D0
02:0003CC98 023C00EE        	  7569:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC9C 123C0014        	  7570:     move.b  #$14,D1
02:0003CCA0 D101            	  7571:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CCA2 7600            	  7572:     moveq   #0,D3
02:0003CCA4 1600            	  7573:     move.b  D0,D3
02:0003CCA6 6032            	  7574:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7575: 
                            	  7576:     even
                            	  7577: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7578:     ; In bloated substates 2 and 3:
                            	  7579:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7580:     ;
02:0003CCA8 102C0015        	  7581:     move.b  ($0015,A4),D0
02:0003CCAC 02000002        	  7582:     andi.b #$02,D0
02:0003CCB0 6604            	  7583:     bne.s  __far_z_04_0071
02:0003CCB2 600000A6        	  7584:     jmp  L11B00_Exit
                            	  7585: __far_z_04_0071:
02:0003CCB6 7600            	  7586:     moveq   #0,D3
02:0003CCB8 1614            	  7587:     move.b  ($0000,A4),D3
02:0003CCBA 601E            	  7588:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7589: 
                            	  7590:     even
                            	  7591: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7592:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7593:     ;
02:0003CCBC 7008            	  7594:     moveq   #8,D0
                            	  7595:     even
                            	  7596: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CCBE 7600            	  7597:     moveq   #0,D3
02:0003CCC0 1614            	  7598:     move.b  ($0000,A4),D3
02:0003CCC2 122C0015        	  7599:     move.b  ($0015,A4),D1
02:0003CCC6 C001            	  7600:     and.b  D1,D0
02:0003CCC8 6710            	  7601:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7602:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7603:     ; in order to index into the second set of frame image numbers.
                            	  7604:     ;
02:0003CCCA 1003            	  7605:     move.b  D3,D0
02:0003CCCC 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCD0 123C0005        	  7607:     move.b  #$05,D1
02:0003CCD4 D101            	  7608:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CCD6 7600            	  7609:     moveq   #0,D3
02:0003CCD8 1600            	  7610:     move.b  D0,D3
                            	  7611:     even
                            	  7612: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7613:     ; Start preparing sprites.
                            	  7614:     ;
02:0003CCDA 4EB90004CDE0    	  7615:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCE0 1003            	  7616:     move.b  D3,D0
02:0003CCE2 1B00            	  7617:     move.b  D0,-(A5)  ; PHA
                            	  7618:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7619:     ;
02:0003CCE4 41F90003CC3E    	  7620:     lea     (DodongoFrameHFlips).l,A0
02:0003CCEA 10303000        	  7621:     move.b  (A0,D3.W),D0
02:0003CCEE 1940000F        	  7622:     move.b  D0,($000F,A4)
02:0003CCF2 41F90003CC34    	  7623:     lea     (DodongoFrameImages).l,A0
02:0003CCF8 10303000        	  7624:     move.b  (A0,D3.W),D0
                            	  7625:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7626:     ; They are drawn mirrored.
                            	  7627:     ;
02:0003CCFC 0C000007        	  7628:     cmpi.b  #$07,D0
02:0003CD00 6706            	  7629:     beq  _anon_z04_92
02:0003CD02 0C000009        	  7630:     cmpi.b  #$09,D0
02:0003CD06 6608            	  7631:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7632: _anon_z04_92:
02:0003CD08 4EB9000317B6    	  7633:     jsr     DrawObjectMirrored
02:0003CD0E 6006            	  7634:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7635: 
                            	  7636:     even
                            	  7637: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7638:     ; No other frame images are mirrored.
                            	  7639:     ;
02:0003CD10 4EB9000317BA    	  7640:     jsr     DrawObjectNotMirrored
