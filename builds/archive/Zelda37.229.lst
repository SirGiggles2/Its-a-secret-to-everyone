02:0003C92C 19802070        	  7038:     move.b  D0,($70,A4,D2.W)
                            	  7039:     ; If X coordinate < $20, then face right.
                            	  7040:     ;
02:0003C930 0C000020        	  7041:     cmpi.b  #$20,D0
02:0003C934 640A            	  7042:     bcc  _anon_z04_89
02:0003C936 7001            	  7043:     moveq   #1,D0
02:0003C938 41EC0098        	  7044:     lea     ($0098,A4),A0
