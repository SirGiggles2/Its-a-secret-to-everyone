                            	 13133: Ganon_CheckCollisions:
                            	 13134:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13135:     ; Store in [02] and [03].
                            	 13136:     ;
02:0003F5C8 10342070        	 13137:     move.b  ($70,A4,D2.W),D0
02:0003F5CC 023C00EE        	 13138:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5D0 123C0010        	 13139:     move.b  #$10,D1
02:0003F5D4 D101            	 13140:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5D6 19400002        	 13141:     move.b  D0,($0002,A4)
02:0003F5DA 41EC0084        	 13142:     lea     ($0084,A4),A0
02:0003F5DE 10302000        	 13143:     move.b  (A0,D2.W),D0
02:0003F5E2 023C00EE        	 13144:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5E6 123C0010        	 13145:     move.b  #$10,D1
02:0003F5EA D101            	 13146:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5EC 19400003        	 13147:     move.b  D0,($0003,A4)
                            	 13148:     ; Check for a collision with Link.
                            	 13149:     ;
                            	 13150:     ; We can't call CheckLinkCollision, because we need to
                            	 13151:     ; customize Ganon's midpoint.
                            	 13152:     ;
                            	 13153:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13154:     ; detection, if Link is invincible. Initialize variables that will
                            	 13155:     ; be returned from the partial collision check routine. Then
                            	 13156:     ; call it.
                            	 13157:     ;
02:0003F5F0 102C04F0        	 13158:     move.b  ($04F0,A4),D0
02:0003F5F4 6616            	 13159:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F5F6 19400006        	 13160:     move.b  D0,($0006,A4)
02:0003F5FA 19400009        	 13161:     move.b  D0,($0009,A4)
02:0003F5FE 1940000C        	 13162:     move.b  D0,($000C,A4)
02:0003F602 7600            	 13163:     moveq   #0,D3
02:0003F604 1883            	 13164:     move.b  D3,($0000,A4)
02:0003F606 4EB900031CB6    	 13165:     jsr     CheckLinkCollisionPreinit
                            	 13166:     even
                            	 13167: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13168:     ; If Ganon is not in state 0, then he's brown.
                            	 13169:     ; Go check collision with an arrow.
                            	 13170:     ;
02:0003F60C 41EC00AC        	 13171:     lea     ($00AC,A4),A0
02:0003F610 10302000        	 13172:     move.b  (A0,D2.W),D0
02:0003F614 6652            	 13173:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13174:     ; If timer <> 0, then Ganon is visible.
                            	 13175:     ; He can't be harmed like this. So, return.
                            	 13176:     ;
02:0003F616 10342028        	 13177:     move.b  ($28,A4,D2.W),D0
02:0003F61A 664A            	 13178:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F61C 760D            	 13179:     moveq   #13,D3
02:0003F61E 4EB900032180    	 13180:     jsr     CheckMonsterSwordCollision
                            	 13181:     ; If Ganon has died according to the usual collision check rules
                            	 13182:     ; (HP = 0), then:
                            	 13183:     ; 1. Restore HP to the initial value $F0
                            	 13184:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13185:     ; 3. Change palette row 7 to make Ganon brown
                            	 13186:     ;
02:0003F624 41EC0405        	 13187:     lea     ($0405,A4),A0
02:0003F628 10302000        	 13188:     move.b  (A0,D2.W),D0
02:0003F62C 6718            	 13189:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F62E 103C00F0        	 13190:     move.b  #$F0,D0
02:0003F632 41EC0485        	 13191:     lea     ($0485,A4),A0
02:0003F636 11802000        	 13192:     move.b  D0,(A0,D2.W)
02:0003F63A 41EC00AC        	 13193:     lea     ($00AC,A4),A0
02:0003F63E 53302000        	 13194:     subq.b  #1,(A0,D2.W)
02:0003F642 61000084        	 13195:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13196:     even
                            	 13197: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13198:     ; If Ganon was harmed, then play the sound effect
                            	 13199:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13200:     ;
02:0003F646 41EC04F0        	 13201:     lea     ($04F0,A4),A0
02:0003F64A 10302000        	 13202:     move.b  (A0,D2.W),D0
02:0003F64E 670A            	 13203:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F650 6100A1CA        	 13204:     jsr     PlayBossHitCryIfNeeded
02:0003F654 7040            	 13205:     moveq   #64,D0
02:0003F656 19802028        	 13206:     move.b  D0,($28,A4,D2.W)
                            	 13207:     even
                            	 13208: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13209:     ; Reset metastate, because Ganon cannot die this way.
                            	 13210:     ;
02:0003F65A 4EB90004D5E8    	 13211:     jsr     ResetObjMetastate
                            	 13212:     ; Reset shove info and invincibility timer, because Ganon
                            	 13213:     ; doesn't react at all as a usual monster.
                            	 13214:     ;
02:0003F660 4EB900032088    	 13215:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13216:     even
                            	 13217: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F666 4E75            	 13218:     rts
                            	 13219: 
                            	 13220:     even
                            	 13221: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13222:     ; If the silver arrow is not in the inventory, then return.
                            	 13223:     ;
02:0003F668 102C0659        	 13224:     move.b  ($0659,A4),D0
02:0003F66C 0C000002        	 13225:     cmpi.b  #$02,D0
02:0003F670 66F4            	 13226:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13227:     ; Reset the collision return value [06].
                            	 13228:     ;
02:0003F672 7000            	 13229:     moveq   #0,D0
02:0003F674 19400006        	 13230:     move.b  D0,($0006,A4)
                            	 13231:     ; If there's no arrow in flight, then return.
                            	 13232:     ;
02:0003F678 7612            	 13233:     moveq   #18,D3
02:0003F67A 41EC00AC        	 13234:     lea     ($00AC,A4),A0
02:0003F67E 10303000        	 13235:     move.b  (A0,D3.W),D0
02:0003F682 0C000010        	 13236:     cmpi.b  #$10,D0
02:0003F686 66DE            	 13237:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13238:     ; Check for collision with an arrow; and return if no collision.
                            	 13239:     ;
02:0003F688 4EB9000321DC    	 13240:     jsr     CheckMonsterArrowOrRodCollision
02:0003F68E 102C0006        	 13241:     move.b  ($0006,A4),D0
02:0003F692 67D2            	 13242:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13243:     ; Set the Ganon phase to "dying".
                            	 13244:     ;
02:0003F694 41EC042C        	 13245:     lea     ($042C,A4),A0
02:0003F698 52302000        	 13246:     addq.b  #1,(A0,D2.W)
                            	 13247:     ; Now his body does flash.
                            	 13248:     ;
02:0003F69C 7028            	 13249:     moveq   #40,D0
02:0003F69E 41EC04F0        	 13250:     lea     ($04F0,A4),A0
02:0003F6A2 11802000        	 13251:     move.b  D0,(A0,D2.W)
                            	 13252:     ; Set initial cloud distance 8.
                            	 13253:     ;
02:0003F6A6 7008            	 13254:     moveq   #8,D0
02:0003F6A8 41EC0478        	 13255:     lea     ($0478,A4),A0
02:0003F6AC 11802000        	 13256:     move.b  D0,(A0,D2.W)
02:0003F6B0 0A3C0001        	 13257:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6B4 4E75            	 13258:     rts
                            	 13259: 
                            	 13260:     even
