02:0004C660 41EC03D0        	  5846:     lea     ($03D0,A4),A0
02:0004C664 11802000        	  5847:     move.b  D0,(A0,D2.W)
02:0004C668 7020            	  5848:     moveq   #32,D0
02:0004C66A 41EC00AC        	  5849:     lea     ($00AC,A4),A0
