02:0003C166 1880            	  5998:     move.b  D0,($0000,A4)
                            	  5999:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6000:     ;
02:0003C168 7600            	  6001:     moveq   #0,D3
02:0003C16A 0C020005        	  6002:     cmpi.b  #$05,D2
