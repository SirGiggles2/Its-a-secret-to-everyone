                            	  6896: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6897:     ; Link and the shot are facing opposite directions.
                            	  6898:     ; Link can parry certain weapons/shots.
                            	  6899:     ;
                            	  6900:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6901:     ; no harmful collision; but it still counts as a shot collision.
                            	  6902:     ; So, go treat this as a parry.
                            	  6903:     ;
02:00031B12 41EC034F        	  6904:     lea     ($034F,A4),A0
02:00031B16 10302000        	  6905:     move.b  (A0,D2.W),D0
02:00031B1A 0C000055        	  6906:     cmpi.b  #$55,D0
