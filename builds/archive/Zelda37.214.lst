                            	   655:     even
                            	   656: ScrollWorld:
02:00040460 102C0015        	   657:     move.b  ($0015,A4),D0
                            	   658:     ; The purpose of this is to delay vertical scrolling.
                            	   659:     ; OW: once every two frames
                            	   660:     ; UW: once every four frames
                            	   661:     ; Horizontal scrolling happens every frame.
02:00040464 02000003        	   662:     andi.b #$03,D0
02:00040468 7600            	   663:     moveq   #0,D3
02:0004046A 162C0010        	   664:     move.b  ($0010,A4),D3
02:0004046E 6604            	   665:     bne  _anon_z05_8
02:00040470 02000001        	   666:     andi.b #$01,D0
                            	   667: _anon_z05_8:
02:00040474 122C00E6        	   668:     move.b  ($00E6,A4),D1
02:00040478 B001            	   669:     cmp.b   D1,D0
02:0004047A 6704            	   670:     beq.s  __far_z_05_0007
02:0004047C 600000DE        	   671:     jmp  ScrollWorldH
