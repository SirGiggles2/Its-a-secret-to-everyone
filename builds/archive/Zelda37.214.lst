02:0003A080 61000210        	  1579:     jsr     Gel_MoveSplitting
02:0003A084 6408            	  1580:     bcc  _anon_z04_24
02:0003A086 41EC00AC        	  1581:     lea     ($00AC,A4),A0
02:0003A08A 52302000        	  1582:     addq.b  #1,(A0,D2.W)
