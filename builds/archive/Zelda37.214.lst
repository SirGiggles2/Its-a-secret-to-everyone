                            	  7028:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  7029:     ; Store it in [00].
                            	  7030:     ;
02:0003C718 10342070        	  7031:     move.b  ($70,A4,D2.W),D0
02:0003C71C 023C00EE        	  7032:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C720 41F90003C6F4    	  7033:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C726 12303000        	  7034:     move.b  (A0,D3.W),D1
02:0003C72A D101            	  7035:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C72C 1880            	  7036:     move.b  D0,($0000,A4)
                            	  7037:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  7038:     ; Store it in [01].
                            	  7039:     ;
02:0003C72E 41EC0084        	  7040:     lea     ($0084,A4),A0
02:0003C732 10302000        	  7041:     move.b  (A0,D2.W),D0
02:0003C736 023C00EE        	  7042:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C73A 41F90003C6EE    	  7043:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C740 12303000        	  7044:     move.b  (A0,D3.W),D1
02:0003C744 D101            	  7045:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C746 19400001        	  7046:     move.b  D0,($0001,A4)
                            	  7047:     ; Calculate sprite attributes:
                            	  7048:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7049:     ;
                            	  7050:     ; If the boss is temporarily invincible, then
                            	  7051:     ; this makes it flash by cycling all the palette rows.
                            	  7052:     ;
                            	  7053:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7054:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7055:     ;
02:0003C74A 41EC04F0        	  7056:     lea     ($04F0,A4),A0
02:0003C74E 10302000        	  7057:     move.b  (A0,D2.W),D0
02:0003C752 02000003        	  7058:     andi.b #$03,D0
02:0003C756 0A000003        	  7059:     eori.b #$03,D0
02:0003C75A 19400003        	  7060:     move.b  D0,($0003,A4)
02:0003C75E 7600            	  7061:     moveq   #0,D3
02:0003C760 162C000A        	  7062:     move.b  ($000A,A4),D3
                            	  7063:     ; Look up the tile for this sprite.
                            	  7064:     ; If it's not the first one (face), then go write the sprite record.
                            	  7065:     ;
02:0003C764 41F90003C6E2    	  7066:     lea     (AquamentusTiles).l,A0
02:0003C76A 10303000        	  7067:     move.b  (A0,D3.W),D0
02:0003C76E 12390003C6E2    	  7068:     move.b  (AquamentusTiles).l,D1
02:0003C774 B001            	  7069:     cmp.b   D1,D0
02:0003C776 6610            	  7070:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7071:     ; Else it's the first one (the face tile).
                            	  7072:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7073:     ;
                            	  7074:     ; $CC/CD shows the closed mouth face.
                            	  7075:     ; $C0/C1 shows the open mouth face.
                            	  7076:     ;
02:0003C778 7600            	  7077:     moveq   #0,D3
02:0003C77A 16342028        	  7078:     move.b  ($28,A4,D2.W),D3
02:0003C77E 0C030020        	  7079:     cmpi.b  #$20,D3
02:0003C782 6404            	  7080:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C784 103C00C0        	  7081:     move.b  #$C0,D0
