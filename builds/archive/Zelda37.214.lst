                            	  4633: ; Params:
                            	  4634: ; Y: middle speed index (4)
                            	  4635: ; [03]: horizontal distance
                            	  4636: ; [04]: vertical distance
                            	  4637: ; [0A]: vertical direction
                            	  4638: ; [0B]: horizontal direction
                            	  4639: ;
                            	  4640: ; Returns:
                            	  4641: ; Y: speed index (0 to 8) for the angle
                            	  4642: ;
                            	  4643: ;
                            	  4644: ; TODO: call it speed index or angle?
                            	  4645: ; Store the middle speed index in [00]. It will be changed to the
                            	  4646: ; right speed index to use incrementally.
                            	  4647: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4648: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4649: ;
                            	  4650:     even
                            	  4651: _CalcDiagonalSpeedIndex:
02:000309C8 1883            	  4652:     move.b  D3,($0000,A4)
                            	  4653:     ; Assuming horizontal distance >= vertical distance, the
                            	  4654:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4655:     ;
02:000309CA 103C00FF        	  4656:     move.b  #$FF,D0
02:000309CE 19400001        	  4657:     move.b  D0,($0001,A4)
                            	  4658:     ; TODO:
                            	  4659:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4660:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4661:     ;
                            	  4662:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4663:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4664:     ; of the farther distance faster.
                            	  4665:     ;
02:000309D2 102C0003        	  4666:     move.b  ($0003,A4),D0
02:000309D6 122C0004        	  4667:     move.b  ($0004,A4),D1
02:000309DA B001            	  4668:     cmp.b   D1,D0
02:000309DC 6416            	  4669:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
