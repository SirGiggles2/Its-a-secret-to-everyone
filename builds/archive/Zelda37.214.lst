                            	 11588: __far_z_04_0112:
                            	 11589:     ; The animation timer has expired. There are two choices for arming it.
                            	 11590:     ;
                            	 11591:     ; When writhing after a hit, Gleeok animates faster.
                            	 11592:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11593:     ; Otherwise, set a longer time ($10).
                            	 11594:     ;
02:0003E89E 7010            	 11595:     moveq   #16,D0
02:0003E8A0 7600            	 11596:     moveq   #0,D3
02:0003E8A2 162C0510        	 11597:     move.b  ($0510,A4),D3
02:0003E8A6 6706            	 11598:     beq  _anon_z04_144
02:0003E8A8 532C0510        	 11599:     subq.b  #1,($0510,A4)
02:0003E8AC 7006            	 11600:     moveq   #6,D0
                            	 11601: _anon_z04_144:
