                            	  1998: _L_z04_UpdateStatues_Shoot:
                            	  1999:     ; Look for an empty monster slot.
                            	  2000:     ; If none is found, return.
                            	  2001:     ;
                            	  2002:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  2003:     ; object. This routine takes a shooter object, and instantiates
                            	  2004:     ; a fireball object at the shooter's location.
                            	  2005:     ;
                            	  2006:     ; The object slot we set up here will behave as the shooter.
                            	  2007:     ; For each fireball index, this object slot will have its coordinates
                            	  2008:     ; changed.
                            	  2009:     ;
                            	  2010:     ; Note that this means that:
                            	  2011:     ; 1. The first fireball made will be its own shooter.
                            	  2012:     ;    Practically, there's nothing special about this.
                            	  2013:     ; 2. If there is more than one fireball made in a frame,
                            	  2014:     ;    then two of them will come from the same statue.
                            	  2015:     ;
                            	  2016:     ;
                            	  2017:     ; Save the fireball pattern.
02:0003A350 1003            	  2018:     move.b  D3,D0
02:0003A352 1B00            	  2019:     move.b  D0,-(A5)  ; PHA
02:0003A354 4EB90004DAC4    	  2020:     jsr     FindEmptyMonsterSlot
02:0003A35A 0C000001        	  2021:     cmpi.b  #$01,D0
02:0003A35E 101D            	  2022:     move.b  (A5)+,D0  ; PLA
02:0003A360 6400010A        	  2023:     bcc  _L_z04_UpdateStatues_Exit
                            	  2024:     ; If we found a slot, but it < 6, return.
                            	  2025:     ;
02:0003A364 0C030006        	  2026:     cmpi.b  #$06,D3
02:0003A368 65000102        	  2027:     bcs  _L_z04_UpdateStatues_Exit
                            	  2028:     ; Store the object slot in [0A].
                            	  2029:     ; Store fireball pattern in [0B].
                            	  2030:     ;
02:0003A36C 1943000A        	  2031:     move.b  D3,($000A,A4)
02:0003A370 1940000B        	  2032:     move.b  D0,($000B,A4)
                            	  2033:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  2034:     ;
02:0003A374 7600            	  2035:     moveq   #0,D3
02:0003A376 1600            	  2036:     move.b  D0,D3
02:0003A378 7400            	  2037:     moveq   #0,D2
02:0003A37A 41F90003A30C    	  2038:     lea     (StatueFireballCounts).l,A0
02:0003A380 14303000        	  2039:     move.b  (A0,D3.W),D2
                            	  2040:     even
                            	  2041: _L_z04_UpdateStatues_LoopFireball:
                            	  2042:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2043:     ;
                            	  2044:     ; Decrement the fireball timer at this index.
                            	  2045:     ;
02:0003A384 7600            	  2046:     moveq   #0,D3
02:0003A386 41EC04E8        	  2047:     lea     ($04E8,A4),A0
02:0003A38A 16302000        	  2048:     move.b  (A0,D2.W),D3
02:0003A38E 5303            	  2049:     subq.b  #1,D3
02:0003A390 1003            	  2050:     move.b  D3,D0
02:0003A392 41EC04E8        	  2051:     lea     ($04E8,A4),A0
02:0003A396 11802000        	  2052:     move.b  D0,(A0,D2.W)
                            	  2053:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2054:     ; to make a fireball. Go loop again.
                            	  2055:     ;
02:0003A39A 5203            	  2056:     addq.b  #1,D3
02:0003A39C 660000C8        	  2057:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2058:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2059:     ; This fireball index will wait another $100 frames.
                            	  2060:     ;
02:0003A3A0 10342018        	  2061:     move.b  ($18,A4,D2.W),D0
02:0003A3A4 0C0000F0        	  2062:     cmpi.b  #$F0,D0
02:0003A3A8 640000BC        	  2063:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2064:     ; Else choose one of four start times for the fireball based on
                            	  2065:     ; the random value.
                            	  2066:     ;
