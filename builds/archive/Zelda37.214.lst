02:0004394E 123C0003        	  5985:     move.b  #$03,D1
02:00043952 0A3C0010        	  5986:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043956 9101            	  5987:     subx.b  D1,D0   ; SBC #$03
02:00043958 0A3C0010        	  5988:     eori    #$10,CCR  ; restore X = 6502 C
