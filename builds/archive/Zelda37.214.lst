                            	  5969: _L_z01_CheckMazes_PlaySecretTune:
                            	  5970:     ; Play secret tune, and let the player leave the maze.
                            	  5971:     ;
02:000312E2 7004            	  5972:     moveq   #4,D0
02:000312E4 19400602        	  5973:     move.b  D0,($0602,A4)
02:000312E8 4E75            	  5974:     rts
                            	  5975: 
                            	  5976: ; Params:
                            	  5977: ; [02]: Y
                            	  5978: ; [03]: X
                            	  5979: ;
                            	  5980: ; Returns:
                            	  5981: ; [00]: high byte of PPU address
                            	  5982: ; [01]: low byte of PPU address
                            	  5983: ;
                            	  5984: ;
                            	  5985: ; Turn the 16-bit value 08YY into the PPU address
                            	  5986: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5987: ;
                            	  5988: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5989: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5990: ;
                            	  5991:     even
                            	  5992: MapScreenPosToPpuAddr:
02:000312EA 6000A77A        	  5993:     jmp     c_map_screen_pos_to_ppu_addr
