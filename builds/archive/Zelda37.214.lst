02:00030EB6 0C0000F0        	  5391:     cmpi.b  #$F0,D0
02:00030EBA 6504            	  5392:     bcs.s  __far_z_01_0037
02:00030EBC 6000010A        	  5393:     jmp  L6C28_Exit
