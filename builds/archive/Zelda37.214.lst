                            	  3845: SecretArmosXs:
02:0003B016 E0              	  3846:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B017 B0
02:0003B018 B0
02:0003B019 30
02:0003B01A 40
02:0003B01B 90
02:0003B01C A0
