                            	 12006: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EC08 10342070        	 12007:     move.b  ($70,A4,D2.W),D0
02:0003EC0C 1B00            	 12008:     move.b  D0,-(A5)  ; PHA
                            	 12009:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 12010:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 12011:     ;
02:0003EC0E 023C00EE        	 12012:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EC12 123C0004        	 12013:     move.b  #$04,D1
02:0003EC16 D101            	 12014:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EC18 19802070        	 12015:     move.b  D0,($70,A4,D2.W)
                            	 12016:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 12017:     ; to store in [03].
                            	 12018:     ;
02:0003EC1C 102C04E6        	 12019:     move.b  ($04E6,A4),D0
02:0003EC20 0A000003        	 12020:     eori.b #$03,D0
02:0003EC24 19400003        	 12021:     move.b  D0,($0003,A4)
                            	 12022:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 12023:     ;
02:0003EC28 103C009E        	 12024:     move.b  #$9E,D0
02:0003EC2C 0C020005        	 12025:     cmpi.b  #$05,D2
02:0003EC30 670A            	 12026:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC32 0C02000A        	 12027:     cmpi.b  #$0A,D2
02:0003EC36 6704            	 12028:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC38 103C00A0        	 12029:     move.b  #$A0,D0
                            	 12030:     even
                            	 12031: _L_z04_UpdateLamnola_Draw:
02:0003EC3C 4EB900031844    	 12032:     jsr     Anim_WriteSprite
02:0003EC42 101D            	 12033:     move.b  (A5)+,D0  ; PLA
02:0003EC44 19802070        	 12034:     move.b  D0,($70,A4,D2.W)
02:0003EC48 41EC0098        	 12035:     lea     ($0098,A4),A0
02:0003EC4C 10302000        	 12036:     move.b  (A0,D2.W),D0
02:0003EC50 1B00            	 12037:     move.b  D0,-(A5)  ; PHA
02:0003EC52 4EB9000318C4    	 12038:     jsr     CheckMonsterCollisions
02:0003EC58 101D            	 12039:     move.b  (A5)+,D0  ; PLA
02:0003EC5A 41EC0098        	 12040:     lea     ($0098,A4),A0
02:0003EC5E 11802000        	 12041:     move.b  D0,(A0,D2.W)
                            	 12042:     ; If still alive, then return.
                            	 12043:     ;
02:0003EC62 41EC0405        	 12044:     lea     ($0405,A4),A0
02:0003EC66 10302000        	 12045:     move.b  (A0,D2.W),D0
02:0003EC6A 6604            	 12046:     bne.s  __far_z_04_0120
02:0003EC6C 6000FF72        	 12047:     jmp  L129EA_Exit
                            	 12048: __far_z_04_0120:
                            	 12049:     ; Otherwise, the segment is dead.
                            	 12050:     ;
02:0003EC70 4EB90004BC32    	 12051:     jsr     ResetShoveInfo
                            	 12052:     ; Set the current segment's HP to the initial value in anticipation
                            	 12053:     ; of bringing this segment back to life.
                            	 12054:     ;
02:0003EC76 7020            	 12055:     moveq   #32,D0
02:0003EC78 41EC0485        	 12056:     lea     ($0485,A4),A0
02:0003EC7C 11802000        	 12057:     move.b  D0,(A0,D2.W)
                            	 12058:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 12059:     ;
                            	 12060:     ; From the lowest slot, look for one that has the original lamnola
                            	 12061:     ; object type.
                            	 12062:     ;
                            	 12063:     ; The goal is to swap the current dead segment with the tail segment.
                            	 12064:     ;
02:0003EC80 163C00FF        	 12065:     move.b  #$FF,D3
02:0003EC84 0C020006        	 12066:     cmpi.b  #$06,D2
02:0003EC88 6502            	 12067:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EC8A 7604            	 12068:     moveq   #4,D3
                            	 12069:     even
                            	 12070: _L_z04_UpdateLamnola_FindTail:
02:0003EC8C 5203            	 12071:     addq.b  #1,D3
02:0003EC8E 41EC0350        	 12072:     lea     ($0350,A4),A0
02:0003EC92 10303000        	 12073:     move.b  (A0,D3.W),D0
02:0003EC96 122C04E7        	 12074:     move.b  ($04E7,A4),D1
02:0003EC9A B001            	 12075:     cmp.b   D1,D0
02:0003EC9C 66EE            	 12076:     bne  _L_z04_UpdateLamnola_FindTail
                            	 12077:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 12078:     ;
02:0003EC9E 7011            	 12079:     moveq   #17,D0
02:0003ECA0 19803029        	 12080:     move.b  D0,($29,A4,D3.W)
                            	 12081:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 12082:     ; to the tail segment.
                            	 12083:     ;
02:0003ECA4 41EC04F0        	 12084:     lea     ($04F0,A4),A0
02:0003ECA8 10302000        	 12085:     move.b  (A0,D2.W),D0
02:0003ECAC 41EC04F1        	 12086:     lea     ($04F1,A4),A0
02:0003ECB0 11803000        	 12087:     move.b  D0,(A0,D3.W)
02:0003ECB4 10342070        	 12088:     move.b  ($70,A4,D2.W),D0
02:0003ECB8 19803071        	 12089:     move.b  D0,($71,A4,D3.W)
02:0003ECBC 41EC0084        	 12090:     lea     ($0084,A4),A0
02:0003ECC0 10302000        	 12091:     move.b  (A0,D2.W),D0
02:0003ECC4 41EC0085        	 12092:     lea     ($0085,A4),A0
02:0003ECC8 11803000        	 12093:     move.b  D0,(A0,D3.W)
                            	 12094:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 12095:     ; So, return and leave it dead.
                            	 12096:     ;
02:0003ECCC 0C030004        	 12097:     cmpi.b  #$04,D3
02:0003ECD0 6604            	 12098:     bne.s  __far_z_04_0121
02:0003ECD2 6000FF0C        	 12099:     jmp  L129EA_Exit
                            	 12100: __far_z_04_0121:
02:0003ECD6 0C030009        	 12101:     cmpi.b  #$09,D3
02:0003ECDA 6604            	 12102:     bne.s  __far_z_04_0122
02:0003ECDC 6000FF02        	 12103:     jmp  L129EA_Exit
                            	 12104: __far_z_04_0122:
                            	 12105:     ; Change the tail segment to the dead dummy object, and
                            	 12106:     ; bring the current segment back to life.
                            	 12107:     ;
02:0003ECE0 705D            	 12108:     moveq   #93,D0
02:0003ECE2 41EC0350        	 12109:     lea     ($0350,A4),A0
02:0003ECE6 11803000        	 12110:     move.b  D0,(A0,D3.W)
02:0003ECEA 4EF90004DAFC    	 12111:     jmp     ResetObjMetastate
                            	 12112: 
                            	 12113:     even
                            	 12114: L12A6F_Exit:
02:0003ECF0 4E75            	 12115:     rts
                            	 12116: 
                            	 12117:     even
                            	 12118: Lamnola_UpdateHead:
                            	 12119:     ; If X coordinate is not a multiple of 8, then return.
                            	 12120:     ;
02:0003ECF2 10342070        	 12121:     move.b  ($70,A4,D2.W),D0
02:0003ECF6 02000007        	 12122:     andi.b #$07,D0
02:0003ECFA 6702            	 12123:     beq.s  __far_z_04_0123
02:0003ECFC 60F2            	 12124:     jmp  L12A6F_Exit
                            	 12125: __far_z_04_0123:
                            	 12126:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12127:     ; We had to account for the usual offset of 3.
                            	 12128:     ;
02:0003ECFE 41EC0084        	 12129:     lea     ($0084,A4),A0
02:0003ED02 10302000        	 12130:     move.b  (A0,D2.W),D0
02:0003ED06 023C00EE        	 12131:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED0A 123C0003        	 12132:     move.b  #$03,D1
02:0003ED0E D101            	 12133:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED10 02000007        	 12134:     andi.b #$07,D0
02:0003ED14 6702            	 12135:     beq.s  __far_z_04_0124
02:0003ED16 60D8            	 12136:     jmp  L12A6F_Exit
                            	 12137: __far_z_04_0124:
                            	 12138:     ; Will loop 4 times, propagating directions down the chain,
                            	 12139:     ; by pulling from the bottom.
                            	 12140:     ;
02:0003ED18 7004            	 12141:     moveq   #4,D0
02:0003ED1A 1880            	 12142:     move.b  D0,($0000,A4)
                            	 12143:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12144:     ;
02:0003ED1C 7600            	 12145:     moveq   #0,D3
02:0003ED1E 0C020005        	 12146:     cmpi.b  #$05,D2
02:0003ED22 6702            	 12147:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED24 7605            	 12148:     moveq   #5,D3
                            	 12149:     even
                            	 12150: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12151:     ; Loop over every segment under the head, starting from the tail.
                            	 12152:     ; Copy the next segment's direction to the current one in this loop.
                            	 12153:     ;
02:0003ED26 41EC009A        	 12154:     lea     ($009A,A4),A0
02:0003ED2A 10303000        	 12155:     move.b  (A0,D3.W),D0
02:0003ED2E 41EC0099        	 12156:     lea     ($0099,A4),A0
02:0003ED32 11803000        	 12157:     move.b  D0,(A0,D3.W)
02:0003ED36 5203            	 12158:     addq.b  #1,D3
02:0003ED38 5314            	 12159:     subq.b  #1,($0000,A4)
02:0003ED3A 66EA            	 12160:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12161:     ; If this head segment is not aligned with a square, then return.
                            	 12162:     ;
02:0003ED3C 10342070        	 12163:     move.b  ($70,A4,D2.W),D0
02:0003ED40 0200000F        	 12164:     andi.b #$0F,D0
02:0003ED44 660000BA        	 12165:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12166:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12167:     ; We had to account for the usual offset of 3.
                            	 12168:     ;
02:0003ED48 41EC0084        	 12169:     lea     ($0084,A4),A0
02:0003ED4C 10302000        	 12170:     move.b  (A0,D2.W),D0
02:0003ED50 023C00EE        	 12171:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED54 123C0003        	 12172:     move.b  #$03,D1
02:0003ED58 D101            	 12173:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED5A 0200000F        	 12174:     andi.b #$0F,D0
02:0003ED5E 660000A0        	 12175:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12176:     ; Store the opposite of the facing direction in [00].
                            	 12177:     ;
02:0003ED62 41EC0098        	 12178:     lea     ($0098,A4),A0
02:0003ED66 10302000        	 12179:     move.b  (A0,D2.W),D0
02:0003ED6A E208            	 12180:     lsr.b  #1,D0   ; LSR A
02:0003ED6C 02000005        	 12181:     andi.b #$05,D0
02:0003ED70 1880            	 12182:     move.b  D0,($0000,A4)
02:0003ED72 41EC0098        	 12183:     lea     ($0098,A4),A0
02:0003ED76 10302000        	 12184:     move.b  (A0,D2.W),D0
02:0003ED7A E308            	 12185:     lsl.b  #1,D0   ; ASL A
02:0003ED7C 0200000A        	 12186:     andi.b #$0A,D0
02:0003ED80 1214            	 12187:     move.b  ($0000,A4),D1
02:0003ED82 8001            	 12188:     or.b  D1,D0
                            	 12189:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12190:     ;
02:0003ED84 0A00000F        	 12191:     eori.b #$0F,D0
02:0003ED88 1940050F        	 12192:     move.b  D0,($050F,A4)
                            	 12193:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12194:     ;
02:0003ED8C 10342018        	 12195:     move.b  ($18,A4,D2.W),D0
02:0003ED90 0C000080        	 12196:     cmpi.b  #$80,D0
02:0003ED94 656C            	 12197:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12198:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12199:     ; Load the monster's facing direction.
                            	 12200:     ;
02:0003ED96 41EC0098        	 12201:     lea     ($0098,A4),A0
02:0003ED9A 10302000        	 12202:     move.b  (A0,D2.W),D0
                            	 12203:     ; Load the next random number into Y register.
                            	 12204:     ;
02:0003ED9E 7600            	 12205:     moveq   #0,D3
02:0003EDA0 16342019        	 12206:     move.b  ($19,A4,D2.W),D3
                            	 12207:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12208:     ; to keep moving straight.
                            	 12209:     ;
02:0003EDA4 0C030080        	 12210:     cmpi.b  #$80,D3
02:0003EDA8 6418            	 12211:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12212:     even
                            	 12213: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12214:     ; Loop to rotate the direction bit over the mask.
                            	 12215:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12216:     ; facing direction.
                            	 12217:     ;
                            	 12218:     ; Shift right the copy of the direction.
                            	 12219:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12220:     ;
02:0003EDAA E208            	 12221:     lsr.b  #1,D0   ; LSR A
02:0003EDAC 6402            	 12222:     bcc  _anon_z04_151
02:0003EDAE 7008            	 12223:     moveq   #8,D0
                            	 12224: _anon_z04_151:
                            	 12225:     ; If the current direction bit is masked off, then we've reached
                            	 12226:     ; the opposite direction. Loop again.
                            	 12227:     ;
02:0003EDB0 122C050F        	 12228:     move.b  ($050F,A4),D1
02:0003EDB4 C200            	 12229:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDB6 67F2            	 12230:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12231:     ; If Y register >= $40, then break out of the loop.
                            	 12232:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12233:     ;
02:0003EDB8 0C030040        	 12234:     cmpi.b  #$40,D3
02:0003EDBC 6404            	 12235:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12236:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12237:     ; and loop again now.
                            	 12238:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12239:     ;
02:0003EDBE 7640            	 12240:     moveq   #64,D3
02:0003EDC0 65E8            	 12241:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12242:     even
                            	 12243: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12244:     ; Change the facing direction to the direction found.
                            	 12245:     ;
02:0003EDC2 41EC0098        	 12246:     lea     ($0098,A4),A0
02:0003EDC6 11802000        	 12247:     move.b  D0,(A0,D2.W)
                            	 12248:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12249:     ;
02:0003EDCA 1940000F        	 12250:     move.b  D0,($000F,A4)
02:0003EDCE 4EB90003080E    	 12251:     jsr     BoundByRoom
                            	 12252:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12253:     ;
02:0003EDD4 102C000F        	 12254:     move.b  ($000F,A4),D0
02:0003EDD8 6618            	 12255:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12256:     even
                            	 12257: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12258:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12259:     ; for looking for any non-opposite direction that is not blocked.
                            	 12260:     ;
02:0003EDDA 41EC0098        	 12261:     lea     ($0098,A4),A0
02:0003EDDE 10302000        	 12262:     move.b  (A0,D2.W),D0
                            	 12263:     even
                            	 12264: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12265:     ; Shift right the copy of the direction.
                            	 12266:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12267:     ;
02:0003EDE2 E208            	 12268:     lsr.b  #1,D0   ; LSR A
02:0003EDE4 6402            	 12269:     bcc  _anon_z04_152
02:0003EDE6 7008            	 12270:     moveq   #8,D0
                            	 12271: _anon_z04_152:
                            	 12272:     ; If the current direction bit is not masked off, then go check the
                            	 12273:     ; room boundary in this direction.
                            	 12274:     ; Else we've reached the opposite direction. Loop again.
                            	 12275:     ;
02:0003EDE8 122C050F        	 12276:     move.b  ($050F,A4),D1
02:0003EDEC C200            	 12277:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDEE 66D2            	 12278:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EDF0 67F0            	 12279:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12280:     even
                            	 12281: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12282:     ; We found a direction that was not blocked by the room boundary.
                            	 12283:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12284:     ;
