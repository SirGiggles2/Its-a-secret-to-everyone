                            	  6140: ; X: object index/cycle sprite index
                            	  6141: ; Y: animation index
                            	  6142: ; [00]: object X
                            	  6143: ; [01]: object Y
                            	  6144: ; [0C]: mirrored
                            	  6145: ; [0F]: flip horizontally
                            	  6146: ;
                            	  6147: ; Note:
                            	  6148: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6149: ; But Link uses [0F] for flipping without checking [0C].
                            	  6150: ;
                            	  6151: ;
                            	  6152: ; [0D] holds frame.
                            	  6153:     even
