                            	  3151:     ; Index:  2 3 0 1
                            	  3152:     ;
02:00041B32 4EB900030908    	  3153:     jsr     GetOppositeDir
                            	  3154:     ; Get the appropriate coordinate for the direction:
                            	  3155:     ; X for horizontal
                            	  3156:     ; Y for vertical
                            	  3157:     ;
