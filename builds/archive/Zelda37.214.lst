                            	  2378: ; Params:
                            	  2379: ; A: Y coordinate
                            	  2380: ; X: object index
                            	  2381: ;
                            	  2382:     even
                            	  2383: InitWhirlwind:
02:0002FAE2 6000C166        	  2384:     jmp     c_init_whirlwind
                            	  2385: 
                            	  2386: SetUpWhirlwind:
02:0002FAE6 6000BF12        	  2387:     jmp     c_set_up_whirlwind
                            	  2388: 
                            	  2389: WhirlwindPrevRoomIdList:
02:0002FAEA 36              	  2390:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FAEB 3B
02:0002FAEC 73
02:0002FAED 44
02:0002FAEE 0A
02:0002FAEF 21
02:0002FAF0 41
02:0002FAF1 6C
                            	  2391: 
                            	  2392:     even
                            	  2393: UpdateWhirlwind_Full:
                            	  2394:     ; Get Link's halted state.
                            	  2395:     ;
02:0002FAF2 102C00AC        	  2396:     move.b  ($00AC,A4),D0
02:0002FAF6 02000040        	  2397:     andi.b #$40,D0
02:0002FAFA 7600            	  2398:     moveq   #0,D3
02:0002FAFC 1600            	  2399:     move.b  D0,D3
                            	  2400:     ; Add 2 to whirlwind X.
                            	  2401:     ;
02:0002FAFE 7002            	  2402:     moveq   #2,D0
02:0002FB00 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FB04 12342070        	  2404:     move.b  ($70,A4,D2.W),D1
02:0002FB08 D101            	  2405:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FB0A 19802070        	  2406:     move.b  D0,($70,A4,D2.W)
                            	  2407:     ; If Link is not halted or teleporting state = 0, then
                            	  2408:     ; go check for collision with Link.
                            	  2409:     ;
02:0002FB0E 0C030040        	  2410:     cmpi.b  #$40,D3
02:0002FB12 6638            	  2411:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FB14 7600            	  2412:     moveq   #0,D3
02:0002FB16 162C0522        	  2413:     move.b  ($0522,A4),D3
02:0002FB1A 6730            	  2414:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2415:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2416:     ;
                            	  2417:     ; Set Link's X to whirlwind's.
                            	  2418:     ;
02:0002FB1C 19400070        	  2419:     move.b  D0,($0070,A4)
                            	  2420:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2421:     ; the right screen edge and draw.
                            	  2422:     ;
02:0002FB20 5303            	  2423:     subq.b  #1,D3
02:0002FB22 6776            	  2424:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FB24 0C000080        	  2425:     cmpi.b  #$80,D0
02:0002FB28 6670            	  2426:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2427:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2428:     ;
                            	  2429:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2430:     ;
02:0002FB2A E308            	  2431:     lsl.b  #1,D0   ; ASL A
02:0002FB2C 194000AC        	  2432:     move.b  D0,($00AC,A4)
02:0002FB30 19400522        	  2433:     move.b  D0,($0522,A4)
02:0002FB34 41EC034F        	  2434:     lea     ($034F,A4),A0
02:0002FB38 11802000        	  2435:     move.b  D0,(A0,D2.W)
                            	  2436:     ; Update the player position marker, and draw one last time.
                            	  2437:     ;
02:0002FB3C 1002            	  2438:     move.b  D2,D0
02:0002FB3E 1B00            	  2439:     move.b  D0,-(A5)  ; PHA
02:0002FB40 61001122        	  2440:     jsr     UpdatePlayerPositionMarker
02:0002FB44 101D            	  2441:     move.b  (A5)+,D0  ; PLA
02:0002FB46 7400            	  2442:     moveq   #0,D2
02:0002FB48 1400            	  2443:     move.b  D0,D2
02:0002FB4A 6070            	  2444:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445: 
                            	  2446:     even
                            	  2447: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2448:     ; Link is not halted or teleporting state = 0.
                            	  2449:     ; Try to pick up Link.
                            	  2450:     ;
                            	  2451:     ; If the whirlwind does not collide with Link, then go check
                            	  2452:     ; for the screen's right edge.
                            	  2453:     ;
02:0002FB4C 61001EC0        	  2454:     jsr     CheckLinkCollision
02:0002FB50 102C0006        	  2455:     move.b  ($0006,A4),D0
02:0002FB54 6744            	  2456:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2457:     ; Collided with Link.
                            	  2458:     ;
                            	  2459:     ; Make Link face right. Reset shove info and subroom type.
                            	  2460:     ;
02:0002FB56 7001            	  2461:     moveq   #1,D0
02:0002FB58 19400098        	  2462:     move.b  D0,($0098,A4)
02:0002FB5C E208            	  2463:     lsr.b  #1,D0   ; LSR A
02:0002FB5E 194000C0        	  2464:     move.b  D0,($00C0,A4)
02:0002FB62 194000D3        	  2465:     move.b  D0,($00D3,A4)
02:0002FB66 1940005A        	  2466:     move.b  D0,($005A,A4)
                            	  2467:     ; Halt Link (state $40), and hide him.
                            	  2468:     ;
02:0002FB6A 7040            	  2469:     moveq   #64,D0
02:0002FB6C 194000AC        	  2470:     move.b  D0,($00AC,A4)
02:0002FB70 103C00F8        	  2471:     move.b  #$F8,D0
02:0002FB74 19400248        	  2472:     move.b  D0,($0248,A4)
02:0002FB78 1940024C        	  2473:     move.b  D0,($024C,A4)
                            	  2474:     ; Find and set the room that will behave as the previous room
                            	  2475:     ; when scrolling right to the room with the level's entrance.
                            	  2476:     ;
02:0002FB7C 102C0523        	  2477:     move.b  ($0523,A4),D0
02:0002FB80 02000007        	  2478:     andi.b #$07,D0
02:0002FB84 7600            	  2479:     moveq   #0,D3
02:0002FB86 1600            	  2480:     move.b  D0,D3
02:0002FB88 41F90002FAEA    	  2481:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FB8E 10303000        	  2482:     move.b  (A0,D3.W),D0
02:0002FB92 194000EA        	  2483:     move.b  D0,($00EA,A4)
                            	  2484:     ; Set teleporting state 1.
                            	  2485:     ;
02:0002FB96 522C0522        	  2486:     addq.b  #1,($0522,A4)
                            	  2487:     even
                            	  2488: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2489:     ; If whirlwind's X < $F0, go draw.
                            	  2490:     ;
02:0002FB9A 10342070        	  2491:     move.b  ($70,A4,D2.W),D0
02:0002FB9E 0C0000F0        	  2492:     cmpi.b  #$F0,D0
02:0002FBA2 6518            	  2493:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2494:     ; The whirlwind has reached the right edge of the screen.
                            	  2495:     ;
                            	  2496:     ; Destroy the object.
                            	  2497:     ;
02:0002FBA4 611A            	  2498:     jsr     DestroyWhirlwind
                            	  2499:     ; If teleporting state <> 0, we picked up Link.
                            	  2500:     ; So, go to the next mode.
                            	  2501:     ;
                            	  2502:     ; Either way, draw one last time.
                            	  2503:     ;
02:0002FBA6 102C0522        	  2504:     move.b  ($0522,A4),D0
02:0002FBAA 6710            	  2505:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0002FBAC 1002            	  2506:     move.b  D2,D0
02:0002FBAE 1B00            	  2507:     move.b  D0,-(A5)  ; PHA
02:0002FBB0 4EB90004C104    	  2508:     jsr     GoToNextModeFromPlay
02:0002FBB6 101D            	  2509:     move.b  (A5)+,D0  ; PLA
02:0002FBB8 7400            	  2510:     moveq   #0,D2
02:0002FBBA 1400            	  2511:     move.b  D0,D2
                            	  2512:     even
                            	  2513: _L_z01_UpdateWhirlwind_Full_Draw:
02:0002FBBC 600000A8        	  2514:     jmp     DrawWhirlwind
                            	  2515: 
                            	  2516:     even
                            	  2517: DestroyWhirlwind:
02:0002FBC0 6000BC52        	  2518:     jmp     c_destroy_whirlwind
                            	  2519: 
                            	  2520: SummonWhirlwind:
                            	  2521:     ; If not in mode 5, return.
                            	  2522:     ;
02:0002FBC4 102C0012        	  2523:     move.b  ($0012,A4),D0
02:0002FBC8 0C000005        	  2524:     cmpi.b  #$05,D0
02:0002FBCC 6704            	  2525:     beq.s  __far_z_01_0016
02:0002FBCE 60000094        	  2526:     jmp  L6104_Exit
                            	  2527: __far_z_01_0016:
                            	  2528:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2529:     ;
02:0002FBD2 6178            	  2530:     jsr     AdvanceTeleportingLevelIndex
02:0002FBD4 102C0523        	  2531:     move.b  ($0523,A4),D0
02:0002FBD8 02000007        	  2532:     andi.b #$07,D0
02:0002FBDC 7600            	  2533:     moveq   #0,D3
02:0002FBDE 1600            	  2534:     move.b  D0,D3
02:0002FBE0 41F90004AE08    	  2535:     lea     (LevelMasks).l,A0
