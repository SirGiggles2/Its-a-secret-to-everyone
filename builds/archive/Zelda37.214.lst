                            	 10604: _L_z04_UpdateGleeok_LoadNeckBytes:
                            	 10605:     ; Load neck data.
                            	 10606:     ;
                            	 10607:     ; For each segment from 5 to 0, indexed by Y register:
                            	 10608:     ; - load coordinates into object slots 6 to 1
                            	 10609:     ; - load miscellany into an array at [0413]
                            	 10610:     ;
02:0003E174 1214            	 10611:     move.b  ($00,A4),D1   ; ptr lo
02:0003E176 182C0001        	 10612:     move.b  ($01,A4),D4  ; ptr hi
02:0003E17A 024100FF        	 10613:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E17E E14C            	 10614:     lsl.w   #8,D4
02:0003E180 8841            	 10615:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003E182 48C4            	 10616:     ext.l   D4
02:0003E184 D8BC00FF0000    	 10617:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003E18A 2044            	 10618:     movea.l D4,A0
02:0003E18C 10303000        	 10619:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
