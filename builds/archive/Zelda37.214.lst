                            	  5284:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5285:     ; These will be negated appropriately for each corner.
                            	  5286:     ;
02:0004C5BA 41EC0098        	  5287:     lea     ($0098,A4),A0
02:0004C5BE 10302000        	  5288:     move.b  (A0,D2.W),D0
02:0004C5C2 19400002        	  5289:     move.b  D0,($0002,A4)
02:0004C5C6 19400003        	  5290:     move.b  D0,($0003,A4)
                            	  5291:     ; Reset [0F] to not flip horizontally.
                            	  5292:     ;
