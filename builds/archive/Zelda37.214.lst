02:0004364A 1881            	  5533:     move.b  D1,($0000,A4)
02:0004364C 1214            	  5534:     move.b  ($0000,A4),D1
02:0004364E E209            	  5535:     lsr.b  #1,D1   ; LSR $00
02:00043650 1881            	  5536:     move.b  D1,($0000,A4)
02:00043652 1214            	  5537:     move.b  ($0000,A4),D1
02:00043654 E209            	  5538:     lsr.b  #1,D1   ; LSR $00
