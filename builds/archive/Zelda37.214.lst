02:0003A342 B001            	  1990:     cmp.b   D1,D0
02:0003A344 670A            	  1991:     beq  _L_z04_UpdateStatues_Shoot
02:0003A346 5303            	  1992:     subq.b  #1,D3
02:0003A348 6AEE            	  1993:     bpl  _anon_z04_30
