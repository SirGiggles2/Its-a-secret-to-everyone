                            	  5353: TryTakeRoomItem:
                            	  5354:     ; If Link is halted, then return.
                            	  5355:     ;
02:00030E84 102C00AC        	  5356:     move.b  ($00AC,A4),D0
02:00030E88 020000C0        	  5357:     andi.b #$C0,D0
02:00030E8C 0C000040        	  5358:     cmpi.b  #$40,D0
02:00030E90 67EC            	  5359:     beq  _anon_z01_63
                            	  5360:     ; If player took the room item, then return.
                            	  5361:     ;
02:00030E92 61AE            	  5362:     jsr     GetRoomFlagUWItemState
02:00030E94 66E8            	  5363:     bne  _anon_z01_63
                            	  5364:     ; Switch to room item object slot $13.
                            	  5365:     ;
02:00030E96 7413            	  5366:     moveq   #19,D2
                            	  5367:     ; If room item object wasn't activated, then return.
                            	  5368:     ;
02:00030E98 41EC00AC        	  5369:     lea     ($00AC,A4),A0
02:00030E9C 10302000        	  5370:     move.b  (A0,D2.W),D0
02:00030EA0 6BDC            	  5371:     bmi  _anon_z01_63
                            	  5372:     ; Pass RoomItemId, also known as [98][$13] and ObjDir[$13],
                            	  5373:     ; to try to take the item.
                            	  5374:     ;
02:00030EA2 41EC0098        	  5375:     lea     ($0098,A4),A0
02:00030EA6 10302000        	  5376:     move.b  (A0,D2.W),D0
02:00030EAA 19400004        	  5377:     move.b  D0,($0004,A4)
                            	  5378: ; Params:
                            	  5379: ; X: object index
                            	  5380: ; [04]: item type
                            	  5381: ;
                            	  5382: ;
                            	  5383: ; If the lifetime timer of the item >= $F0, then return;
                            	  5384: ; so that the player can't pick it up right away.
                            	  5385: ;
                            	  5386: ; [03A8][X] is used to count down the life of the item.
                            	  5387:     even
                            	  5388: TryTakeItem:
02:00030EAE 41EC03A8        	  5389:     lea     ($03A8,A4),A0
