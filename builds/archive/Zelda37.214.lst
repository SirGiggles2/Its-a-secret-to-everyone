02:0003CE84 023C00EE        	  8105:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE88 41F90003CD66    	  8106:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CE8E 12303000        	  8107:     move.b  (A0,D3.W),D1
