                            	  7575: ChangePlayMapSquareOW:
02:0004471C 1002            	  7576:     move.b  D2,D0
02:0004471E 1B00            	  7577:     move.b  D0,-(A5)  ; PHA
                            	  7578:     ; We're dealing with squares.
                            	  7579:     ; So, align the object's X coordinate with 16 pixels.
                            	  7580:     ;
02:00044720 10342070        	  7581:     move.b  ($70,A4,D2.W),D0
02:00044724 020000F0        	  7582:     andi.b #$F0,D0
                            	  7583:     ; Divide it by 4 to get the offset of the address of the column
                            	  7584:     ; in play area map.
                            	  7585:     ;
                            	  7586:     ; The calculation is: address offset = (X / 8) * 2
                            	  7587:     ; 8 for the width of the column; 2 for the width of the address
                            	  7588:     ;
02:00044728 E208            	  7589:     lsr.b  #1,D0   ; LSR A
02:0004472A E208            	  7590:     lsr.b  #1,D0   ; LSR A
02:0004472C 7400            	  7591:     moveq   #0,D2
02:0004472E 1400            	  7592:     move.b  D0,D2
