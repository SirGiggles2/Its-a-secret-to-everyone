02:00033476 41EC0630        	   565:     lea     ($0630,A4),A0
02:0003347A 11803000        	   566:     move.b  D0,(A0,D3.W)
02:0003347E 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033482 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033486 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003348A E14C            	   570:     lsl.w   #8,D4
02:0003348C 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003348E 48C4            	   572:     ext.l   D4
02:00033490 D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033496 2044            	   574:     movea.l D4,A0
02:00033498 10303000        	   575:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003349C 41EC062D        	   576:     lea     ($062D,A4),A0
02:000334A0 11803000        	   577:     move.b  D0,(A0,D3.W)
