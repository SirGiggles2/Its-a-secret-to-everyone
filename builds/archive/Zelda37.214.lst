02:0004474C 1B00            	  7602:     move.b  D0,-(A5)  ; PHA
02:0004474E 7400            	  7603:     moveq   #0,D2
02:00044750 1400            	  7604:     move.b  D0,D2
                            	  7605:     ; Align the object's Y coordinate with 16 pixels.
                            	  7606:     ;
02:00044752 41EC0084        	  7607:     lea     ($0084,A4),A0
