02:000401CA 61004D22        	   300:     jsr     Submenu_CueTransferRowUW
02:000401CE 60E8            	   301:     jmp     _anon_z05_1
                            	   302: 
                            	   303:     even
                            	   304: UpdateMenu5OW:
                            	   305:     ; Cue the transfer of "TRIFORCE" text.
                            	   306:     ;
02:000401D0 705C            	   307:     moveq   #92,D0
02:000401D2 6702            	   308:     beq.s  __far_z_05_0002
02:000401D4 60DE            	   309:     jmp  SelectTransferBufAndIncState
                            	   310: __far_z_05_0002:
