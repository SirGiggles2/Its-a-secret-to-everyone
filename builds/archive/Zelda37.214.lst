02:0003E6FE 102C0089        	 11352:     move.b  ($0089,A4),D0
02:0003E702 41EC0084        	 11353:     lea     ($0084,A4),A0
02:0003E706 11802000        	 11354:     move.b  D0,(A0,D2.W)
