                            	  7664:     ;
02:00031FF0 41EC034F        	  7665:     lea     ($034F,A4),A0
02:00031FF4 10302000        	  7666:     move.b  (A0,D2.W),D0
02:00031FF8 0C00000B        	  7667:     cmpi.b  #$0B,D0
02:00031FFC 6706            	  7668:     beq  _anon_z01_96
02:00031FFE 0C00000C        	  7669:     cmpi.b  #$0C,D0
02:00032002 6622            	  7670:     bne  _anon_z01_97
                            	  7671: _anon_z01_96:
02:00032004 41EC0098        	  7672:     lea     ($0098,A4),A0
02:00032008 10303000        	  7673:     move.b  (A0,D3.W),D0
02:0003200C 41EC0098        	  7674:     lea     ($0098,A4),A0
02:00032010 12302000        	  7675:     move.b  (A0,D2.W),D1
02:00032014 8001            	  7676:     or.b  D1,D0
02:00032016 0C00000C        	  7677:     cmpi.b  #$0C,D0
02:0003201A 6602            	  7678:     bne.s  __far_z_01_0093
02:0003201C 600C            	  7679:     jmp  PlayParryTune
                            	  7680: __far_z_01_0093:
02:0003201E 0C000003        	  7681:     cmpi.b  #$03,D0
02:00032022 6602            	  7682:     bne.s  __far_z_01_0094
02:00032024 6004            	  7683:     jmp  PlayParryTune
                            	  7684: __far_z_01_0094:
                            	  7685: _anon_z01_97:
                            	  7686:     ; Else shove the monster.
                            	  7687:     ;
02:00032026 600000DA        	  7688:     jmp     BeginShove
                            	  7689: 
