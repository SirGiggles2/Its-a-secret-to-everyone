                            	  5403: _L_z02_DrawCredits_WriteAttributes:
                            	  5404:     ; Every 4 rows, we have to transfer NT attributes.
                            	  5405:     ; So, when (counter MOD 4) <> 0, skip filling an attribute record.
                            	  5406:     ;
