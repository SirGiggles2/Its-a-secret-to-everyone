02:0003B202 19400029        	  4155:     move.b  D0,($0029,A4)
                            	  4156:     even
                            	  4157: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4158:     ; If state <> 2 (so, it's 3), then return.
                            	  4159:     ;
                            	  4160:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4161:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4162:     ; was set to, and we'll return.
                            	  4163:     ;
02:0003B206 0C000002        	  4164:     cmpi.b  #$02,D0
02:0003B20A 6634            	  4165:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4166:     ; State = 2.
