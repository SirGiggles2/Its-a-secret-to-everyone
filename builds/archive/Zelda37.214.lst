                            	 12779: 
                            	 12780: ; Description:
                            	 12781: ; Lift up the Triforce of Courage while the room is dark.
                            	 12782: ;
                            	 12783: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12784: ;
                            	 12785:     even
                            	 12786: Ganon_ScenePhase0:
02:0003F19C 701B            	 12787:     moveq   #27,D0
02:0003F19E 19400505        	 12788:     move.b  D0,($0505,A4)
                            	 12789:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12790:     ;
02:0003F1A2 102C0028        	 12791:     move.b  ($0028,A4),D0
02:0003F1A6 6644            	 12792:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12793:     ; Once the timer expires, it's time to brighten the room.
                            	 12794:     ;
                            	 12795:     ; Save the current object slot.
02:0003F1A8 1002            	 12796:     move.b  D2,D0
02:0003F1AA 1B00            	 12797:     move.b  D0,-(A5)  ; PHA
02:0003F1AC 6100093A        	 12798:     jsr     UpdateCandle
02:0003F1B0 101D            	 12799:     move.b  (A5)+,D0  ; PLA
02:0003F1B2 7400            	 12800:     moveq   #0,D2
02:0003F1B4 1400            	 12801:     move.b  D0,D2
                            	 12802:     ; Turn off the room brightening flag, because we're controlling it
                            	 12803:     ; here instead of in the Mode 5 object update loop.
                            	 12804:     ;
02:0003F1B6 7000            	 12805:     moveq   #0,D0
02:0003F1B8 1940051E        	 12806:     move.b  D0,($051E,A4)
                            	 12807:     ; On the first frame of the fade-to-light cycle, play the
                            	 12808:     ; Triforce/Ganon song.
                            	 12809:     ;
02:0003F1BC 102C051C        	 12810:     move.b  ($051C,A4),D0
02:0003F1C0 0C0000C0        	 12811:     cmpi.b  #$C0,D0
02:0003F1C4 6606            	 12812:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F1C6 7002            	 12813:     moveq   #2,D0
02:0003F1C8 19400600        	 12814:     move.b  D0,($0600,A4)
                            	 12815:     even
                            	 12816: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
