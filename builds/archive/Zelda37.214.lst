02:00030F4C 142C0012        	  5461:     move.b  ($0012,A4),D2
02:00030F50 0C020005        	  5462:     cmpi.b  #$05,D2
02:00030F54 6712            	  5463:     beq  _L_z01_TakeItem_SkipLift
02:00030F56 143C0080        	  5464:     move.b  #$80,D2
02:00030F5A 19420506        	  5465:     move.b  D2,($0506,A4)
02:00030F5E 7408            	  5466:     moveq   #8,D2
