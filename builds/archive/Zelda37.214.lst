                            	  4692: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4693:     ; TODO: call it speed index or angle?
                            	  4694:     ; Otherwise, go to the next speed index (angle).
                            	  4695:     ;
02:00030A10 1014            	  4696:     move.b  ($0000,A4),D0
02:00030A12 023C00EE        	  4697:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030A16 122C0001        	  4698:     move.b  ($0001,A4),D1
02:00030A1A D101            	  4699:     addx.b  D1,D0   ; ADC $01
02:00030A1C 1880            	  4700:     move.b  D0,($0000,A4)
                            	  4701:     ; TODO: call it speed index or angle?
                            	  4702:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4703:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4704:     ;
02:00030A1E 6728            	  4705:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030A20 0C000008        	  4706:     cmpi.b  #$08,D0
