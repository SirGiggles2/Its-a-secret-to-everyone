02:0003E6D8 102C04D7        	 11337:     move.b  ($04D7,A4),D0
02:0003E6DC 023C00EE        	 11338:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6E0 123C0007        	 11339:     move.b  #$07,D1
02:0003E6E4 D101            	 11340:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E6E6 7400            	 11341:     moveq   #0,D2
02:0003E6E8 1400            	 11342:     move.b  D0,D2
                            	 11343:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11344:     ;
02:0003E6EA 103C00FF        	 11345:     move.b  #$FF,D0
02:0003E6EE 41EC0492        	 11346:     lea     ($0492,A4),A0
02:0003E6F2 11802000        	 11347:     move.b  D0,(A0,D2.W)
