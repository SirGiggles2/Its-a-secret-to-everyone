                            	  6934:     ; Flag collision with [0C], even though [06] was already set.
                            	  6935:     ;
02:00031B40 522C000C        	  6936:     addq.b  #1,($000C,A4)
                            	  6937:     ; Unpack the damage points for the monster's type.
                            	  6938:     ; The low nibble is the high byte.
                            	  6939:     ; (Damage points byte AND $F0) is the low byte.
                            	  6940:     ;
02:00031B44 7600            	  6941:     moveq   #0,D3
02:00031B46 41EC034F        	  6942:     lea     ($034F,A4),A0
02:00031B4A 16302000        	  6943:     move.b  (A0,D2.W),D3
02:00031B4E 41F9000319B0    	  6944:     lea     (ObjTypeToDamagePoints).l,A0
02:00031B54 10303000        	  6945:     move.b  (A0,D3.W),D0
02:00031B58 1B00            	  6946:     move.b  D0,-(A5)  ; PHA
02:00031B5A 0200000F        	  6947:     andi.b #$0F,D0
02:00031B5E 1940000D        	  6948:     move.b  D0,($000D,A4)
02:00031B62 101D            	  6949:     move.b  (A5)+,D0  ; PLA
02:00031B64 020000F0        	  6950:     andi.b #$F0,D0
02:00031B68 1940000E        	  6951:     move.b  D0,($000E,A4)
                            	  6952: ; Params:
                            	  6953: ; X: object index of the attacker
                            	  6954: ; [0D]: damage points high byte
                            	  6955: ; [0E]: damage points low byte
                            	  6956: ;
                            	  6957: ;
                            	  6958: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6959: ;
                            	  6960:     even
                            	  6961: Link_BeHarmed:
02:00031B6C 7600            	  6962:     moveq   #0,D3
02:00031B6E 41EC034F        	  6963:     lea     ($034F,A4),A0
02:00031B72 16302000        	  6964:     move.b  (A0,D2.W),D3
02:00031B76 0C03002E        	  6965:     cmpi.b  #$2E,D3
02:00031B7A 6706            	  6966:     beq  _anon_z01_85
02:00031B7C 7008            	  6967:     moveq   #8,D0
02:00031B7E 6100E8BE        	  6968:     jsr     PlaySample
                            	  6969: _anon_z01_85:
                            	  6970:     ; For every level of ring (1 or 2), divide the 16-bit damage amount in [0E:0D] by 2.
                            	  6971:     ;
02:00031B82 7600            	  6972:     moveq   #0,D3
02:00031B84 162C0662        	  6973:     move.b  ($0662,A4),D3
02:00031B88 6718            	  6974:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  6975: _anon_z01_86:
02:00031B8A 122C000D        	  6976:     move.b  ($000D,A4),D1
02:00031B8E E209            	  6977:     lsr.b  #1,D1   ; LSR $0D
02:00031B90 1941000D        	  6978:     move.b  D1,($000D,A4)
02:00031B94 122C000E        	  6979:     move.b  ($000E,A4),D1
02:00031B98 E211            	  6980:     roxr.b  #1,D1   ; ROR $0E
02:00031B9A 1941000E        	  6981:     move.b  D1,($000E,A4)
02:00031B9E 5303            	  6982:     subq.b  #1,D3
02:00031BA0 66E8            	  6983:     bne  _anon_z01_86
                            	  6984:     even
                            	  6985: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6986:     ; Reset values used in special item drops.
                            	  6987:     ;
02:00031BA2 7000            	  6988:     moveq   #0,D0
02:00031BA4 19400627        	  6989:     move.b  D0,($0627,A4)
02:00031BA8 19400050        	  6990:     move.b  D0,($0050,A4)
02:00031BAC 19400051        	  6991:     move.b  D0,($0051,A4)
                            	  6992:     ; If heart partial >= low damage points byte, then simply
                            	  6993:     ; subtract the damage byte from heart partial.
                            	  6994:     ; Else go borrow from full hearts.
                            	  6995:     ;
02:00031BB0 102C0670        	  6996:     move.b  ($0670,A4),D0
02:00031BB4 122C000E        	  6997:     move.b  ($000E,A4),D1
02:00031BB8 B001            	  6998:     cmp.b   D1,D0
02:00031BBA 6546            	  6999:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031BBC 003C0011        	  7000:     ori     #$11,CCR  ; SEC: set C+X
02:00031BC0 122C000E        	  7001:     move.b  ($000E,A4),D1
02:00031BC4 0A3C0010        	  7002:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031BC8 9101            	  7003:     subx.b  D1,D0   ; SBC $0E
02:00031BCA 0A3C0010        	  7004:     eori    #$10,CCR  ; restore X = 6502 C
02:00031BCE 19400670        	  7005:     move.b  D0,($0670,A4)
                            	  7006:     ; If full hearts >= high damage points byte, then simply
                            	  7007:     ; subtract the damage byte from full hearts.
                            	  7008:     ; Else go handle Link dying.
                            	  7009:     ;
02:00031BD2 102C066F        	  7010:     move.b  ($066F,A4),D0
02:00031BD6 0200000F        	  7011:     andi.b #$0F,D0
02:00031BDA 122C000D        	  7012:     move.b  ($000D,A4),D1
02:00031BDE B001            	  7013:     cmp.b   D1,D0
02:00031BE0 6554            	  7014:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031BE2 102C066F        	  7015:     move.b  ($066F,A4),D0
02:00031BE6 003C0011        	  7016:     ori     #$11,CCR  ; SEC: set C+X
02:00031BEA 122C000D        	  7017:     move.b  ($000D,A4),D1
02:00031BEE 0A3C0010        	  7018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031BF2 9101            	  7019:     subx.b  D1,D0   ; SBC $0D
02:00031BF4 0A3C0010        	  7020:     eori    #$10,CCR  ; restore X = 6502 C
02:00031BF8 1940066F        	  7021:     move.b  D0,($066F,A4)
02:00031BFC 0A3C0001        	  7022:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031C00 4E75            	  7023:     rts
                            	  7024: 
                            	  7025:     even
                            	  7026: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  7027:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  7028:     ;   full heart=4 partial heart=$70
                            	  7029:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  7030:     ; But the method here yields $3EF, because partial heart is
                            	  7031:     ; considered full when = $FF instead of $100.
                            	  7032:     ;
02:00031C02 102C000E        	  7033:     move.b  ($000E,A4),D0
02:00031C06 003C0011        	  7034:     ori     #$11,CCR  ; SEC: set C+X
02:00031C0A 122C0670        	  7035:     move.b  ($0670,A4),D1
02:00031C0E 0A3C0010        	  7036:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C12 9101            	  7037:     subx.b  D1,D0   ; SBC HeartPartial
02:00031C14 0A3C0010        	  7038:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C18 1940000E        	  7039:     move.b  D0,($000E,A4)
02:00031C1C 102C066F        	  7040:     move.b  ($066F,A4),D0
02:00031C20 0200000F        	  7041:     andi.b #$0F,D0
02:00031C24 6710            	  7042:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031C26 532C066F        	  7043:     subq.b  #1,($066F,A4)
02:00031C2A 103C00FF        	  7044:     move.b  #$FF,D0
02:00031C2E 19400670        	  7045:     move.b  D0,($0670,A4)
02:00031C32 6600FF6E        	  7046:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  7047:     even
                            	  7048: _L_z01_Link_BeHarmed_HandleDied:
                            	  7049:     ; Link died.
                            	  7050:     ;
                            	  7051:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  7052:     ; Make Link face down.
                            	  7053:     ; Go to mode $11.
                            	  7054:     ;
02:00031C36 102C066F        	  7055:     move.b  ($066F,A4),D0
02:00031C3A 020000F0        	  7056:     andi.b #$F0,D0
02:00031C3E 1940066F        	  7057:     move.b  D0,($066F,A4)
02:00031C42 4EB90004B66E    	  7058:     jsr     EndGameMode
02:00031C48 19400670        	  7059:     move.b  D0,($0670,A4)
02:00031C4C 194000AC        	  7060:     move.b  D0,($00AC,A4)
02:00031C50 7011            	  7061:     moveq   #17,D0
02:00031C52 19400012        	  7062:     move.b  D0,($0012,A4)
02:00031C56 7004            	  7063:     moveq   #4,D0
02:00031C58 19400098        	  7064:     move.b  D0,($0098,A4)
                            	  7065: _anon_z01_87:
02:00031C5C 4E75            	  7066:     rts
                            	  7067: 
                            	  7068: ; Params:
                            	  7069: ; X: monster slot
                            	  7070: ; Y: weapon slot
                            	  7071: ; [02]: monster mid X
                            	  7072: ; [03]: monster mid Y
                            	  7073: ;
                            	  7074: ; Returns:
                            	  7075: ; [00]: weapon slot
                            	  7076: ;
                            	  7077: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  7078: ;
                            	  7079:     even
                            	  7080: CheckMonsterBoomerangOrFoodCollision:
02:00031C5E 41EC00AC        	  7081:     lea     ($00AC,A4),A0
02:00031C62 10303000        	  7082:     move.b  (A0,D3.W),D0
02:00031C66 E308            	  7083:     lsl.b  #1,D0   ; ASL A
02:00031C68 65F2            	  7084:     bcs  _anon_z01_87
02:00031C6A 1883            	  7085:     move.b  D3,($0000,A4)
                            	  7086:     ; Set boomerang damage type (2) in [09].
                            	  7087:     ;
02:00031C6C 7002            	  7088:     moveq   #2,D0
02:00031C6E 19400009        	  7089:     move.b  D0,($0009,A4)
                            	  7090:     ; Set collision threshold $A in both axes.
                            	  7091:     ;
02:00031C72 700A            	  7092:     moveq   #10,D0
02:00031C74 1940000D        	  7093:     move.b  D0,($000D,A4)
02:00031C78 1940000E        	  7094:     move.b  D0,($000E,A4)
                            	  7095:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  7096:     ;
02:00031C7C 10343070        	  7097:     move.b  ($70,A4,D3.W),D0
02:00031C80 023C00EE        	  7098:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031C84 123C0004        	  7099:     move.b  #$04,D1
02:00031C88 D101            	  7100:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031C8A 19400004        	  7101:     move.b  D0,($0004,A4)
                            	  7102:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  7103:     ;
02:00031C8E 41EC0084        	  7104:     lea     ($0084,A4),A0
02:00031C92 10303000        	  7105:     move.b  (A0,D3.W),D0
02:00031C96 023C00EE        	  7106:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031C9A 123C0008        	  7107:     move.b  #$08,D1
02:00031C9E D101            	  7108:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7109: ; Params:
                            	  7110: ; A: weapon object mid Y
                            	  7111: ; X: monster object slot
                            	  7112: ; Y: weapon object slot
                            	  7113: ; [00]: weapon object slot
                            	  7114: ; [02]: monster object mid X
                            	  7115: ; [03]: monster object mid Y
                            	  7116: ; [04]: weapon object mid X
                            	  7117: ; [07]: damage points
                            	  7118: ; [09]: damage type
                            	  7119: ; [0D]: horizontal threshold
                            	  7120: ; [0E]: vertical threshold
                            	  7121: ;
                            	  7122: ; Returns:
                            	  7123: ; [06]: 1 if objects collide
                            	  7124: ;
                            	  7125:     even
                            	  7126: CheckMonsterWeaponCollision:
02:00031CA0 19400005        	  7127:     move.b  D0,($0005,A4)
                            	  7128:     ; Reset [06] for no collision.
                            	  7129:     ;
02:00031CA4 7000            	  7130:     moveq   #0,D0
02:00031CA6 19400006        	  7131:     move.b  D0,($0006,A4)
                            	  7132:     ; If the weapon's not active (state = 0), then return.
                            	  7133:     ;
02:00031CAA 7600            	  7134:     moveq   #0,D3
02:00031CAC 1614            	  7135:     move.b  ($0000,A4),D3
02:00031CAE 41EC00AC        	  7136:     lea     ($00AC,A4),A0
02:00031CB2 10303000        	  7137:     move.b  (A0,D3.W),D0
02:00031CB6 6604            	  7138:     bne.s  __far_z_01_0071
02:00031CB8 6000010C        	  7139:     jmp  L74D8_Exit
                            	  7140: __far_z_01_0071:
                            	  7141:     ; If the objects do not collide, then return.
                            	  7142:     ;
02:00031CBC 610003E4        	  7143:     jsr     DoObjectsCollideWithThresholds
02:00031CC0 6604            	  7144:     bne.s  __far_z_01_0072
02:00031CC2 60000102        	  7145:     jmp  L74D8_Exit
                            	  7146: __far_z_01_0072:
                            	  7147:     ; If the weapon is a boomerang ...
                            	  7148:     ;
02:00031CC6 0C03000F        	  7149:     cmpi.b  #$0F,D3
02:00031CCA 6702            	  7150:     beq.s  __far_z_01_0073
02:00031CCC 603E            	  7151:     jmp  HandleMonsterWeaponCollision
                            	  7152: __far_z_01_0073:
                            	  7153:     ; ... and the monster is invincible to it,
                            	  7154:     ; then play the parry sound.
                            	  7155:     ;
02:00031CCE 41EC04B2        	  7156:     lea     ($04B2,A4),A0
02:00031CD2 10302000        	  7157:     move.b  (A0,D2.W),D0
02:00031CD6 122C0009        	  7158:     move.b  ($0009,A4),D1
02:00031CDA C001            	  7159:     and.b  D1,D0
02:00031CDC 6704            	  7160:     beq  _anon_z01_88
02:00031CDE 6100034A        	  7161:     jsr     PlayParryTune
                            	  7162: _anon_z01_88:
                            	  7163:     ; Set the boomerang state to return fast to the thrower.
                            	  7164:     ;
02:00031CE2 7050            	  7165:     moveq   #80,D0
02:00031CE4 41EC00AC        	  7166:     lea     ($00AC,A4),A0
02:00031CE8 11803000        	  7167:     move.b  D0,(A0,D3.W)
                            	  7168:     ; If the monster is invincible to the boomerang, then return.
                            	  7169:     ;
