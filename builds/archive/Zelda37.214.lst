02:0003C878 10302000        	  7217:     move.b  (A0,D2.W),D0
02:0003C87C 4EB90002AECA    	  7218:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7219:     even
