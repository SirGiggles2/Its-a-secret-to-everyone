02:0003C090 41EC0381        	  6155:     lea     ($0381,A4),A0
02:0003C094 11803000        	  6156:     move.b  D0,(A0,D3.W)
02:0003C098 41EC0099        	  6157:     lea     ($0099,A4),A0
