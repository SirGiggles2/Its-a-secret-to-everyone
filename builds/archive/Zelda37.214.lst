02:0004015C 0004017C        	   213:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:00040160 000401B2        	   214:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:00040164 000401BE        	   215:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
02:00040168 000401C4        	   216:     dc.l    UpdateMenuCommon4   ; jump table entry (32-bit for _m68k_tablejump)
02:0004016C 000401D0        	   217:     dc.l    UpdateMenu5OW   ; jump table entry (32-bit for _m68k_tablejump)
02:00040170 000401D6        	   218:     dc.l    UpdateMenuScrollDownOW   ; jump table entry (32-bit for _m68k_tablejump)
02:00040174 00040298        	   219:     dc.l    UpdateMenuActive   ; jump table entry (32-bit for _m68k_tablejump)
