02:0003ACF4 6704            	  3396:     beq  _anon_z04_44
02:0003ACF6 163C00D8        	  3397:     move.b  #$D8,D3
                            	  3398: _anon_z04_44:
02:0003ACFA 1883            	  3399:     move.b  D3,($0000,A4)
                            	  3400:     ; Add Link's Y and the vertical offset.
                            	  3401:     ;
02:0003ACFC 102C0084        	  3402:     move.b  ($0084,A4),D0
02:0003AD00 023C00EE        	  3403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD04 1214            	  3404:     move.b  ($0000,A4),D1
02:0003AD06 D101            	  3405:     addx.b  D1,D0   ; ADC $00
                            	  3406:     ; Sanitize the Y coordinate:
                            	  3407:     ; (Y AND $F0) OR $D
                            	  3408:     ;
02:0003AD08 020000F0        	  3409:     andi.b #$F0,D0
02:0003AD0C 0000000D        	  3410:     ori.b #$0D,D0
