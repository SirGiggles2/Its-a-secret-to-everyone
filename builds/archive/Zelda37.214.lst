                            	  3849: InitArmosOrFlyingGhini:
                            	  3850:     ; In UpdateObject, this object was flagged "initialized".
                            	  3851:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3852:     ;
02:0003B01E 10342028        	  3853:     move.b  ($28,A4,D2.W),D0
02:0003B022 41EC0492        	  3854:     lea     ($0492,A4),A0
02:0003B026 11802000        	  3855:     move.b  D0,(A0,D2.W)
                            	  3856:     ; If it's still fading in, then go finish some initialization needed
                            	  3857:     ; for fading in.
                            	  3858:     ;
02:0003B02A 660000B6        	  3859:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3860:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3861:     ; go finish initializing it.
                            	  3862:     ;
02:0003B02E 41EC034F        	  3863:     lea     ($034F,A4),A0
02:0003B032 10302000        	  3864:     move.b  (A0,D2.W),D0
02:0003B036 0C000022        	  3865:     cmpi.b  #$22,D0
02:0003B03A 670000A6        	  3866:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3867:     ; Else we have an armos.
                            	  3868:     ;
                            	  3869:     ; Store stairs tile $70 in [00] for use later.
                            	  3870:     ;
02:0003B03E 7070            	  3871:     moveq   #112,D0
02:0003B040 1880            	  3872:     move.b  D0,($0000,A4)
                            	  3873:     ; Look for the current room ID in an array of room ID's that
                            	  3874:     ; have armos secrets.
                            	  3875:     ;
02:0003B042 7606            	  3876:     moveq   #6,D3
                            	  3877:     even
                            	  3878: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B044 102C00EB        	  3879:     move.b  ($00EB,A4),D0
                            	  3880:     ; If this element does not match the current room ID, go loop again.
                            	  3881:     ;
02:0003B048 41F90003B00E    	  3882:     lea     (SecretArmosRoomIds).l,A0
02:0003B04E 12303000        	  3883:     move.b  (A0,D3.W),D1
02:0003B052 B001            	  3884:     cmp.b   D1,D0
02:0003B054 6648            	  3885:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3886:     ; The secret (usually stairs) is under one of the armoses.
                            	  3887:     ;
                            	  3888:     ; If the armos's X coordinate does not match the one needed
                            	  3889:     ; for the current room in the list, then go loop again.
                            	  3890:     ;
02:0003B056 10342070        	  3891:     move.b  ($70,A4,D2.W),D0
02:0003B05A 41F90003B016    	  3892:     lea     (SecretArmosXs).l,A0
02:0003B060 12303000        	  3893:     move.b  (A0,D3.W),D1
02:0003B064 B001            	  3894:     cmp.b   D1,D0
02:0003B066 6636            	  3895:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3896:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3897:     ;
02:0003B068 41EC0084        	  3898:     lea     ($0084,A4),A0
02:0003B06C 10302000        	  3899:     move.b  (A0,D2.W),D0
02:0003B070 0C000080        	  3900:     cmpi.b  #$80,D0
02:0003B074 6628            	  3901:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3902:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3903:     ;
02:0003B076 4A03            	  3904:     cmpi.b  #$00,D3
02:0003B078 662C            	  3905:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3906:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3907:     ; has the power bracelet.
                            	  3908:     ;
                            	  3909:     ; Set up the room item with the armos's coordinates.
                            	  3910:     ;
02:0003B07A 19400097        	  3911:     move.b  D0,($0097,A4)
02:0003B07E 10342070        	  3912:     move.b  ($70,A4,D2.W),D0
02:0003B082 19400083        	  3913:     move.b  D0,($0083,A4)
                            	  3914:     ; This resets the room item's state, which activates it.
                            	  3915:     ;
02:0003B086 194300BF        	  3916:     move.b  D3,($00BF,A4)
                            	  3917:     ; Set the room item ID.
                            	  3918:     ;
02:0003B08A 7014            	  3919:     moveq   #20,D0
02:0003B08C 194000AB        	  3920:     move.b  D0,($00AB,A4)
                            	  3921:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3922:     ;
                            	  3923:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3924:     ;
                            	  3925:     ; Note that, if the item was already taken, then the room item
                            	  3926:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3927:     ; it will be ignored, because that routine checks whether
                            	  3928:     ; the item was taken.
                            	  3929:     ;
02:0003B090 4EB900030E42    	  3930:     jsr     GetRoomFlagUWItemState
02:0003B096 660A            	  3931:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B098 610006FE        	  3932:     jsr     PlaySecretFoundTune
02:0003B09C 6604            	  3933:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3934:     even
                            	  3935: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3936:     ; Bottom of the loop.
                            	  3937:     ;
02:0003B09E 5303            	  3938:     subq.b  #1,D3
02:0003B0A0 6AA2            	  3939:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3940:     even
                            	  3941: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3942:     ; Not found, or found the power bracelet.
                            	  3943:     ; Use a floor tile $26 to replace the armos.
                            	  3944:     ;
02:0003B0A2 7026            	  3945:     moveq   #38,D0
02:0003B0A4 1880            	  3946:     move.b  D0,($0000,A4)
                            	  3947:     even
                            	  3948: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B0A6 1014            	  3949:     move.b  ($0000,A4),D0
                            	  3950:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3951:     ;
02:0003B0A8 1B00            	  3952:     move.b  D0,-(A5)  ; PHA
02:0003B0AA 0C000070        	  3953:     cmpi.b  #$70,D0
02:0003B0AE 6604            	  3954:     bne  _anon_z04_51
02:0003B0B0 610006E6        	  3955:     jsr     PlaySecretFoundTune
                            	  3956: _anon_z04_51:
                            	  3957:     ; Replace the tile where the armos was.
                            	  3958:     ;
02:0003B0B4 522C00F7        	  3959:     addq.b  #1,($00F7,A4)
02:0003B0B8 101D            	  3960:     move.b  (A5)+,D0  ; PLA
02:0003B0BA 4EB90004B0D8    	  3961:     jsr     ChangeTileObjTiles
                            	  3962:     ; Because the armos object is aligned to the square grid
                            	  3963:     ; (because it was made from a square),
                            	  3964:     ; set its grid offset to 3 to compensate.
                            	  3965:     ;
                            	  3966:     ; Most objects are aligned to the grid vertically when the
                            	  3967:     ; low nibble is $D.
                            	  3968:     ;
02:0003B0C0 7003            	  3969:     moveq   #3,D0
02:0003B0C2 41EC0394        	  3970:     lea     ($0394,A4),A0
02:0003B0C6 11802000        	  3971:     move.b  D0,(A0,D2.W)
                            	  3972:     ; Set a speed (q-speed fraction) randomly:
                            	  3973:     ; $20 if random value < $80
                            	  3974:     ; $60 otherwise
                            	  3975:     ;
02:0003B0CA 7020            	  3976:     moveq   #32,D0
02:0003B0CC 7600            	  3977:     moveq   #0,D3
02:0003B0CE 16342019        	  3978:     move.b  ($19,A4,D2.W),D3
02:0003B0D2 0C030080        	  3979:     cmpi.b  #$80,D3
02:0003B0D6 6502            	  3980:     bcs  _anon_z04_52
02:0003B0D8 7060            	  3981:     moveq   #96,D0
                            	  3982: _anon_z04_52:
02:0003B0DA 41EC03BC        	  3983:     lea     ($03BC,A4),A0
02:0003B0DE 11802000        	  3984:     move.b  D0,(A0,D2.W)
                            	  3985:     even
                            	  3986: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3987:     ; Facing and input directions down.
                            	  3988:     ;
02:0003B0E2 7004            	  3989:     moveq   #4,D0
02:0003B0E4 41EC03F8        	  3990:     lea     ($03F8,A4),A0
02:0003B0E8 11802000        	  3991:     move.b  D0,(A0,D2.W)
02:0003B0EC 41EC0098        	  3992:     lea     ($0098,A4),A0
02:0003B0F0 11802000        	  3993:     move.b  D0,(A0,D2.W)
                            	  3994:     ; Every other frame, return without drawing.
                            	  3995:     ;
02:0003B0F4 10342028        	  3996:     move.b  ($28,A4,D2.W),D0
02:0003B0F8 E208            	  3997:     lsr.b  #1,D0   ; LSR A
02:0003B0FA 6512            	  3998:     bcs  _anon_z04_53
                            	  3999:     ; Finish initializing based on type.
                            	  4000:     ;
02:0003B0FC 41EC034F        	  4001:     lea     ($034F,A4),A0
02:0003B100 10302000        	  4002:     move.b  (A0,D2.W),D0
02:0003B104 0C000022        	  4003:     cmpi.b  #$22,D0
02:0003B108 6602            	  4004:     bne.s  __far_z_04_0034
02:0003B10A 6008            	  4005:     jmp  L_EndInitFlyingGhini
                            	  4006: __far_z_04_0034:
02:0003B10C 6158            	  4007:     jsr     DrawArmosAndCheckCollisions
                            	  4008: _anon_z04_53:
02:0003B10E 0A3C0001        	  4009:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B112 4E75            	  4010:     rts
                            	  4011: 
                            	  4012:     even
                            	  4013: L_EndInitFlyingGhini:
02:0003B114 6100FEAA        	  4014:     jsr     DrawGhiniAndCheckCollisions
                            	  4015:     ; If we're finally leaving the object flagged "initialized",
                            	  4016:     ; then reset metastate and initialize this as a flyer.
                            	  4017:     ;
02:0003B118 41EC0492        	  4018:     lea     ($0492,A4),A0
02:0003B11C 10302000        	  4019:     move.b  (A0,D2.W),D0
02:0003B120 66EC            	  4020:     bne  _anon_z04_53
02:0003B122 4EB90004DAF6    	  4021:     jsr     ResetObjMetastateAndTimer
02:0003B128 6000F44A        	  4022:     jmp     EndInitFlyer
