                            	  8262: Submenu_CueTransferRowUW:
                            	  8263:     ; If menu scroll value is negative, then we transferred everything.
                            	  8264:     ; So, return.
                            	  8265:     ;
02:00044EEE 102C005E        	  8266:     move.b  ($005E,A4),D0
02:00044EF2 6A02            	  8267:     bpl.s  __far_z_05_0110
02:00044EF4 602E            	  8268:     jmp  L1725A_Exit
                            	  8269: __far_z_05_0110:
                            	  8270:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8271:     ; and represents the current row of the submenu being processed.
                            	  8272:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8273:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8274:     ;
                            	  8275:     ; If the bottom bit is set, go prepare the full black row.
                            	  8276:     ;
02:00044EF6 E208            	  8277:     lsr.b  #1,D0   ; LSR A
02:00044EF8 7600            	  8278:     moveq   #0,D3
02:00044EFA 1600            	  8279:     move.b  D0,D3
02:00044EFC 6402            	  8280:     bcc.s  __far_z_05_0111
02:00044EFE 6026            	  8281:     jmp  PrepFullBlackRow
                            	  8282: __far_z_05_0111:
                            	  8283:     ; Submenu rows $D to $15 are parts of the map.
                            	  8284:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8285:     ;
                            	  8286:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8287:     ; buffer for this row.
                            	  8288:     ;
02:00044F00 0C00000D        	  8289:     cmpi.b  #$0D,D0
02:00044F04 640C            	  8290:     bcc  _anon_z05_167
02:00044F06 41F900044ECA    	  8291:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044F0C 10303000        	  8292:     move.b  (A0,D3.W),D0
                            	  8293:     even
