02:0002E034 0A3C0010        	   940:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E038 9101            	   941:     subx.b  D1,D0   ; SBC #$98
02:0002E03A 0A3C0010        	   942:     eori    #$10,CCR  ; restore X = 6502 C
