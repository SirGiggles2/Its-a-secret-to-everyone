02:00042362 122C03F8        	  4311:     move.b  ($03F8,A4),D1
02:00042366 C001            	  4312:     and.b  D1,D0
                            	  4313:     ; If neither direction matched input direction, then
                            	  4314:     ; change input direction to facing direction.
                            	  4315:     ;
02:00042368 6604            	  4316:     bne  _anon_z05_94
02:0004236A 102C0098        	  4317:     move.b  ($0098,A4),D0
                            	  4318: _anon_z05_94:
