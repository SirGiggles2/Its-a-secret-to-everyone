02:0003EBE2 41EC0098        	 11987:     lea     ($0098,A4),A0
02:0003EBE6 10302000        	 11988:     move.b  (A0,D2.W),D0
02:0003EBEA 6602            	 11989:     bne.s  __far_z_04_0119
02:0003EBEC 60F2            	 11990:     jmp  L129EA_Exit
                            	 11991: __far_z_04_0119:
                            	 11992:     ; If we have the magic clock, then go draw and check collisions.
                            	 11993:     ;
02:0003EBEE 102C066C        	 11994:     move.b  ($066C,A4),D0
02:0003EBF2 6614            	 11995:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
02:0003EBF4 6100027C        	 11996:     jsr     Lamnola_Move
                            	 11997:     ; If the current segment is a head, then update the direction it's facing.
