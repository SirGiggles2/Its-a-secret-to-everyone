02:0004C648 41EC0084        	  5362:     lea     ($0084,A4),A0
02:0004C64C 10302000        	  5363:     move.b  (A0,D2.W),D0
02:0004C650 023C00EE        	  5364:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C654 122C0003        	  5365:     move.b  ($0003,A4),D1
02:0004C658 D101            	  5366:     addx.b  D1,D0   ; ADC $03
02:0004C65A 19400001        	  5367:     move.b  D0,($0001,A4)
