02:000368F4 1940050D        	  5388:     move.b  D0,($050D,A4)
                            	  5389:     ; Increment the VRAM page number.
                            	  5390:     ;
02:000368F8 7600            	  5391:     moveq   #0,D3
02:000368FA 162C050C        	  5392:     move.b  ($050C,A4),D3
02:000368FE 5203            	  5393:     addq.b  #1,D3
                            	  5394:     ; If it has reached $C, then roll it over to 0.
                            	  5395:     ;
