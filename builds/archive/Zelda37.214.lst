02:00036130 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:00036134 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036138 E14C            	  4626:     lsl.w   #8,D4
