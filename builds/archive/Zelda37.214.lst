                            	  3687:     even
                            	  3688: _L_z04_UpdateOctorock_SaveOffset:
02:0003AF20 1B00            	  3689:     move.b  D0,-(A5)  ; PHA
                            	  3690:     ; Decrement the animation counter, and roll over if needed.
                            	  3691:     ;
02:0003AF22 41EC03D0        	  3692:     lea     ($03D0,A4),A0
02:0003AF26 53302000        	  3693:     subq.b  #1,(A0,D2.W)
02:0003AF2A 661E            	  3694:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003AF2C 7006            	  3695:     moveq   #6,D0
02:0003AF2E 41EC03D0        	  3696:     lea     ($03D0,A4),A0
02:0003AF32 11802000        	  3697:     move.b  D0,(A0,D2.W)
                            	  3698:     ; There are actually 6 frame images divided into 2 sets.
                            	  3699:     ; Each set depicts one animation frame. In each set there are
                            	  3700:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3701:     ;
                            	  3702:     ; The movement frame will keep track of the base offset of
                            	  3703:     ; the current set for the current animation frame: 0 or 3.
                            	  3704:     ;
                            	  3705:     ; So, XOR the movement frame with 3.
                            	  3706:     ;
02:0003AF36 E208            	  3707:     lsr.b  #1,D0   ; LSR A
02:0003AF38 41EC03E4        	  3708:     lea     ($03E4,A4),A0
02:0003AF3C 12302000        	  3709:     move.b  (A0,D2.W),D1
02:0003AF40 B300            	  3710:     eor.b  D1,D0
02:0003AF42 41EC03E4        	  3711:     lea     ($03E4,A4),A0
02:0003AF46 11802000        	  3712:     move.b  D0,(A0,D2.W)
                            	  3713:     even
                            	  3714: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3715:     ; Add the base offset and the directional offset, and save the result.
                            	  3716:     ;
