                            	  1520: Flyer_KeeseDecideState:
                            	  1521:     ; Go to the next state randomly:
                            	  1522:     ; Random >= $A0: 2
                            	  1523:     ; Random >= $20: 3
                            	  1524:     ; Else:          4
                            	  1525:     ;
                            	  1526:     ; Set up 6 turns.
                            	  1527:     ;
02:0003A01E 7602            	  1528:     moveq   #2,D3
