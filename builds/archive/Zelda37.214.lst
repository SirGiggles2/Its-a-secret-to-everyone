02:00039F98 0A3C0010        	  1463:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039F9C 9101            	  1464:     subx.b  D1,D0   ; SBC #$2C
02:00039F9E 0A3C0010        	  1465:     eori    #$10,CCR  ; restore X = 6502 C
02:00039FA2 1940052E        	  1466:     move.b  D0,($052E,A4)
