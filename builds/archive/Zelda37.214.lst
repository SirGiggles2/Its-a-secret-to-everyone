02:00030A06 0A3C0010        	  4688:     eori    #$10,CCR  ; restore X = 6502 C
02:00030A0A 0C000008        	  4689:     cmpi.b  #$08,D0
02:00030A0E 6538            	  4690:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
