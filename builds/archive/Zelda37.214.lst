02:0003AD14 11802000        	  3412:     move.b  D0,(A0,D2.W)
                            	  3413:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3414:     ; go see if the tile is valid to come out of.
                            	  3415:     ;
                            	  3416:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3417:     ;
02:0003AD18 0C00005D        	  3418:     cmpi.b  #$5D,D0
02:0003AD1C 647A            	  3419:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3420:     even
                            	  3421: _L_z04_UpdateRedLeever_Exit:
