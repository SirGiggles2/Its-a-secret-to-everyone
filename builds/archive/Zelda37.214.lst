02:0003CC30 1600            	  7790:     move.b  D0,D3
                            	  7791:     ; If facing vertically, then return. There's no other side to draw.
                            	  7792:     ;
02:0003CC32 41EC0098        	  7793:     lea     ($0098,A4),A0
02:0003CC36 10302000        	  7794:     move.b  (A0,D2.W),D0
