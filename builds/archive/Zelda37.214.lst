                            	  6120: ; Params:
                            	  6121: ; A: frame
                            	  6122: ; X: object index/cycle sprite index
                            	  6123: ; Y: object type
                            	  6124: ; [00]: object X
                            	  6125: ; [01]: object Y
                            	  6126: ; [0C]: mirrored
                            	  6127: ; [0F]: flip horizontally
                            	  6128: ;
                            	  6129: ; Note:
                            	  6130: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6131: ;
                            	  6132: ; The animation index of most objects is (object type + 1),
                            	  6133: ; to make up for the fact that Link uses two animation indexes.
                            	  6134: ;
                            	  6135:     even
