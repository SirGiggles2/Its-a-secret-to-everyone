02:0004CA3A 00000020        	  5965:     ori.b #$20,D0
02:0004CA3E 194000AC        	  5966:     move.b  D0,($00AC,A4)
                            	  5967:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5968:     ; up the new state.
                            	  5969:     ;
02:0004CA42 7001            	  5970:     moveq   #1,D0
02:0004CA44 194003D0        	  5971:     move.b  D0,($03D0,A4)
