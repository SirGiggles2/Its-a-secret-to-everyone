02:00031CF0 10302000        	  7171:     move.b  (A0,D2.W),D0
02:00031CF4 122C0009        	  7172:     move.b  ($0009,A4),D1
02:00031CF8 C001            	  7173:     and.b  D1,D0
02:00031CFA 6704            	  7174:     beq.s  __far_z_01_0074
02:00031CFC 600000C8        	  7175:     jmp  L74D8_Exit
                            	  7176: __far_z_01_0074:
                            	  7177:     ; Still the boomerang.
                            	  7178:     ; Reset [07] damage points, and set the monster's stun timer to $10 ($A0 frames).
                            	  7179:     ;
02:00031D00 7000            	  7180:     moveq   #0,D0
02:00031D02 19400007        	  7181:     move.b  D0,($0007,A4)
02:00031D06 7010            	  7182:     moveq   #16,D0
02:00031D08 1980203D        	  7183:     move.b  D0,($3D,A4,D2.W)
                            	  7184:     even
                            	  7185: HandleMonsterWeaponCollision:
                            	  7186:     ; If the monster is invincible to this damage type, then
                            	  7187:     ; go play parry sound if needed, and return.
                            	  7188:     ;
02:00031D0C 41EC04B2        	  7189:     lea     ($04B2,A4),A0
02:00031D10 10302000        	  7190:     move.b  (A0,D2.W),D0
02:00031D14 122C0009        	  7191:     move.b  ($0009,A4),D1
02:00031D18 C001            	  7192:     and.b  D1,D0
02:00031D1A 6704            	  7193:     beq.s  __far_z_01_0075
02:00031D1C 600000AA        	  7194:     jmp  L_PlayParrySoundForDamageType
                            	  7195: __far_z_01_0075:
