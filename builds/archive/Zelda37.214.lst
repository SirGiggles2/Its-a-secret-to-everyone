02:0003E62C 1B00            	 11232:     move.b  D0,-(A5)  ; PHA
                            	 11233:     ; To calculate the base offset of the sprite record:
                            	 11234:     ; offset := neck index * 8
                            	 11235:     ;
                            	 11236:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11237:     ; at an even index.
                            	 11238:     ;
02:0003E62E 102C04D7        	 11239:     move.b  ($04D7,A4),D0
02:0003E632 E308            	 11240:     lsl.b  #1,D0   ; ASL A
02:0003E634 E308            	 11241:     lsl.b  #1,D0   ; ASL A
02:0003E636 E308            	 11242:     lsl.b  #1,D0   ; ASL A
