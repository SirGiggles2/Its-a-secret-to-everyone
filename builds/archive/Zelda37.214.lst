02:000309E0 102C0004        	  4671:     move.b  ($0004,A4),D0
02:000309E4 19400003        	  4672:     move.b  D0,($0003,A4)
02:000309E8 101D            	  4673:     move.b  (A5)+,D0  ; PLA
02:000309EA 19400004        	  4674:     move.b  D0,($0004,A4)
02:000309EE 7001            	  4675:     moveq   #1,D0
02:000309F0 19400001        	  4676:     move.b  D0,($0001,A4)
