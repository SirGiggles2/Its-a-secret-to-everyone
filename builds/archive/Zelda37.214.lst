                            	  1743:     even
                            	  1744: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithMoney:
                            	  1745:     ; Post 50 rupees more to subtract, and go flag this offer taken.
                            	  1746:     ;
02:0002E5DC 023C00EE        	  1747:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E5E0 122C067E        	  1748:     move.b  ($067E,A4),D1
02:0002E5E4 D101            	  1749:     addx.b  D1,D0   ; ADC RupeesToSubtract
02:0002E5E6 1940067E        	  1750:     move.b  D0,($067E,A4)
02:0002E5EA 605C            	  1751:     jmp     _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_EndLifeOrMoney
                            	  1752: 
