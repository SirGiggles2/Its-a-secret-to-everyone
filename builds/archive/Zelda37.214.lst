02:0003AEB4 41EC034F        	  3633:     lea     ($034F,A4),A0
02:0003AEB8 16302000        	  3634:     move.b  (A0,D2.W),D3
02:0003AEBC 0C030009        	  3635:     cmpi.b  #$09,D3
02:0003AEC0 6402            	  3636:     bcc  _anon_z04_48
02:0003AEC2 7070            	  3637:     moveq   #112,D0
                            	  3638: _anon_z04_48:
