                            	   583: _L_z02_UpdateMode0Demo_Sub2_LoopHeart:
02:000334AE 1214            	   584:     move.b  ($00,A4),D1   ; ptr lo
02:000334B0 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:000334B4 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000334B8 E14C            	   587:     lsl.w   #8,D4
02:000334BA 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:000334BC 48C4            	   589:     ext.l   D4
02:000334BE D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000334C4 2044            	   591:     movea.l D4,A0
02:000334C6 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000334CA 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:000334CC 1002            	   594:     move.b  D2,D0
02:000334CE E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:000334D0 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:000334D2 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:000334D4 020000F0        	   602:     andi.b #$F0,D0
02:000334D8 1940000C        	   603:     move.b  D0,($000C,A4)
02:000334DC E208            	   604:     lsr.b  #1,D0   ; LSR A
02:000334DE E208            	   605:     lsr.b  #1,D0   ; LSR A
02:000334E0 E208            	   606:     lsr.b  #1,D0   ; LSR A
02:000334E2 E208            	   607:     lsr.b  #1,D0   ; LSR A
02:000334E4 122C000C        	   608:     move.b  ($000C,A4),D1
02:000334E8 8001            	   609:     or.b  D1,D0
02:000334EA 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
02:000334EC 101D            	   613:     move.b  (A5)+,D0  ; PLA
02:000334EE 41EC0650        	   614:     lea     ($0650,A4),A0
02:000334F2 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:000334F6 5203            	   618:     addq.b  #1,D3
02:000334F8 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:000334FA 0C020006        	   622:     cmpi.b  #$06,D2
02:000334FE 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:00033500 1002            	   624:     move.b  D2,D0
02:00033502 E208            	   625:     lsr.b  #1,D0   ; LSR A
02:00033504 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
02:00033506 1003            	   629:     move.b  D3,D0
02:00033508 123C0026        	   630:     move.b  #$26,D1
02:0003350C D101            	   631:     addx.b  D1,D0   ; ADC #$26 (X flag = 6502 C)
02:0003350E 7600            	   632:     moveq   #0,D3
02:00033510 1600            	   633:     move.b  D0,D3
02:00033512 609A            	   634:     jmp     _L_z02_UpdateMode0Demo_Sub2_LoopHeart
