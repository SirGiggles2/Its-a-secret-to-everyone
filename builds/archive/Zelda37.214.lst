02:0003BB52 023C00EE        	  5455:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB56 123C0010        	  5456:     move.b  #$10,D1
02:0003BB5A D101            	  5457:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BB5C 41EC0412        	  5458:     lea     ($0412,A4),A0
02:0003BB60 11802000        	  5459:     move.b  D0,(A0,D2.W)
02:0003BB64 5203            	  5460:     addq.b  #1,D3
