02:0004031E 4EF90002CE00    	   477:     jmp  Exit
                            	   478: __far_z_05_0004:
                            	   479:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   480:     ;
02:00040324 1940005C        	   481:     move.b  D0,($005C,A4)
                            	   482:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   483:     ;
                            	   484:     ; UNKNOWN: But why not do this in OW, too?
                            	   485:     ;
02:00040328 102C0010        	   486:     move.b  ($0010,A4),D0
02:0004032C 6706            	   487:     beq  _anon_z05_4
02:0004032E 4EB90003123E    	   488:     jsr     WriteBlankPrioritySprites
                            	   489: _anon_z05_4:
                            	   490:     ; We reached the end. So, reset hardware vertical scroll
                            	   491:     ; and submenu state.
                            	   492:     ;
02:00040334 7000            	   493:     moveq   #0,D0
02:00040336 194000FC        	   494:     move.b  D0,($00FC,A4)
02:0004033A 194000E1        	   495:     move.b  D0,($00E1,A4)
                            	   496:     ; Move the position markers 2 pixels down, because we
                            	   497:     ; overshot and reached vertical scroll $F2.
                            	   498:     ;
02:0004033E 7002            	   499:     moveq   #2,D0
                            	   500: ; Params:
                            	   501: ; A: vertical velocity of menu scrolling
                            	   502: ;
                            	   503: ;
                            	   504: ; [00] holds the vertical velocity of menu scrolling.
                            	   505:     even
                            	   506: MovePositionMarkers:
02:00040340 1880            	   507:     move.b  D0,($0000,A4)
