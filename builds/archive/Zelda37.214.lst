02:0004B10A 41EC0307        	  2362:     lea     ($0307,A4),A0
02:0004B10E 11802000        	  2363:     move.b  D0,(A0,D2.W)
                            	  2364:     ; Write the low address in the first record. In the second record,
                            	  2365:     ; write (low address + 1).
                            	  2366:     ;
02:0004B112 102C0001        	  2367:     move.b  ($0001,A4),D0
02:0004B116 41EC0303        	  2368:     lea     ($0303,A4),A0
02:0004B11A 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:0004B11E 41EC0308        	  2370:     lea     ($0308,A4),A0
02:0004B122 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0004B126 41EC0308        	  2372:     lea     ($0308,A4),A0
02:0004B12A 52302000        	  2373:     addq.b  #1,(A0,D2.W)
