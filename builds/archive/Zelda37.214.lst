                            	  5868: WriteBlankPrioritySprites:
                            	  5869:     ; UNKNOWN: Why are their Y coordinates $3D and $DD?
                            	  5870:     ; Those values are the highest and lowest that Link can normally take.
                            	  5871:     ;
                            	  5872:     ; Repeat two sprites in the first $10 records. They have
                            	  5873:     ; transparent tile $1C, priority 1 (behind BG), and X=0.
                            	  5874:     ; The first of the pair has Y=$3D, and the second one has Y=$DD.
                            	  5875:     ;
                            	  5876:     ; These sprites are first in the list. So they are used for things
                            	  5877:     ; that must be shown above everything else, including Link.
                            	  5878:     ;
02:0003123E 7600            	  5879:     moveq   #0,D3
02:00031240 7400            	  5880:     moveq   #0,D2
