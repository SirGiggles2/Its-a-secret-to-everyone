                            	  7240: __far_z_01_0077:
                            	  7241: _anon_z01_91:
02:00031D6E 41EC0098        	  7242:     lea     ($0098,A4),A0
02:00031D72 10303000        	  7243:     move.b  (A0,D3.W),D0
02:00031D76 41EC0098        	  7244:     lea     ($0098,A4),A0
02:00031D7A 12302000        	  7245:     move.b  (A0,D2.W),D1
02:00031D7E 8001            	  7246:     or.b  D1,D0
02:00031D80 0C00000C        	  7247:     cmpi.b  #$0C,D0
02:00031D84 6602            	  7248:     bne.s  __far_z_01_0078
