                            	  5355: Wallmaster_PrepareToDraw:
02:0003BA9C 7008            	  5356:     moveq   #8,D0
02:0003BA9E 4EB90004D2BE    	  5357:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5358:     ; For the current step, look up the sprite flipping attributes.
                            	  5359:     ;
02:0003BAA4 7600            	  5360:     moveq   #0,D3
02:0003BAA6 41EC0412        	  5361:     lea     ($0412,A4),A0
02:0003BAAA 16302000        	  5362:     move.b  (A0,D2.W),D3
02:0003BAAE 41F90003B79E    	  5363:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003BAB4 10303000        	  5364:     move.b  (A0,D3.W),D0
02:0003BAB8 020000F0        	  5365:     andi.b #$F0,D0
02:0003BABC 00000001        	  5366:     ori.b #$01,D0
02:0003BAC0 4EB90003183A    	  5367:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5368:     ; If the sprite attributes for this step have horizontal flipping ($40),
                            	  5369:     ; then mask it off, and turn on horizontal flipping with [0F].
                            	  5370:     ;
02:0003BAC6 02000040        	  5371:     andi.b #$40,D0
02:0003BACA 6712            	  5372:     beq  _anon_z04_69
02:0003BACC 102C0004        	  5373:     move.b  ($0004,A4),D0
02:0003BAD0 0200008F        	  5374:     andi.b #$8F,D0
02:0003BAD4 4EB90003183A    	  5375:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003BADA 522C000F        	  5376:     addq.b  #1,($000F,A4)
                            	  5377: _anon_z04_69:
02:0003BADE 4E75            	  5378:     rts
                            	  5379: 
                            	  5380: ; Params:
                            	  5381: ; A: offset of first instruction for left wall (0)
                            	  5382: ;    or top wall ($20)
                            	  5383: ; Y: Link's minimum major coordinate
                            	  5384: ; [00]: Link's coordinate along minor axis
                            	  5385: ; [01]: Link's coordinate along major axis
                            	  5386: ; [02]: a decreasing direction along the wall (left or up)
                            	  5387: ;
                            	  5388: ; Returns:
                            	  5389: ; Y: index of initial major coordinate of Wallmaster
                            	  5390: ; [04]: initial minor coordinate of Wallmaster
                            	  5391: ;
                            	  5392: ; Store the initial offset for this axis.
                            	  5393: ;
                            	  5394:     even
                            	  5395: Wallmaster_CalcStartPosition:
