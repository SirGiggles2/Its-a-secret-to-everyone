                            	  5489: 
                            	  5490: ; Params:
                            	  5491: ; [02]: bitmask for target door.
                            	  5492: ;
                            	  5493: ; Returns:
                            	  5494: ; A: door attribute for desired direction in current room.
                            	  5495: ; [01]: same as [02] if found; $10 otherwise
                            	  5496: ; [03]: reverse direction index
                            	  5497: ;
                            	  5498: ; Door bits:
                            	  5499: ; 1: E
                            	  5500: ; 2: W
                            	  5501: ; 4: S
                            	  5502: ; 8: N
                            	  5503: ;
                            	  5504: ;
                            	  5505: ; Start with single-bit mask 1.
                            	  5506:     even
                            	  5507: FindDoorAttrByDoorBit:
02:00043602 7001            	  5508:     moveq   #1,D0
02:00043604 19400001        	  5509:     move.b  D0,($0001,A4)
02:00043608 7003            	  5510:     moveq   #3,D0
02:0004360A 19400003        	  5511:     move.b  D0,($0003,A4)
                            	  5512:     even
