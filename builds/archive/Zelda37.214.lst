                            	  2250: ;==============================================================================
                            	  2251: ; _oam_dma_flush — Phase 1: transfer previous-frame SAT_SHADOW bank via VDP
                            	  2252: ;   68k→VRAM DMA to sprite attribute table at $F800.
                            	  2253: ;
                            	  2254: ; Must be called at the TOP of VBlankISR (before IsrNmi).  IsrNmi can extend
                            	  2255: ; into active display past scanline 40, so scheduling the DMA at the tail of
                            	  2256: ; VBlankISR would miss vblank.  The DMA source is the bank CURRENTLY flagged
                            	  2257: ; by SAT_ACTIVE_BANK — that is, the bank the previous frame's _oam_dma just
                            	  2258: ; finished filling.  After DMA setup the flag flips so the new frame's
                            	  2259: ; _oam_dma writes the OTHER bank.
                            	  2260: ;
                            	  2261: ; DMA params:
                            	  2262: ;   Reg 19/20: length = 256 words ($0100)
                            	  2263: ;   Reg 21/22/23: source = SAT_SHADOW_A or SAT_SHADOW_B (word address / 2)
                            	  2264: ;   VDP cmd: $78000083 (VRAM write $F800 + CD5 DMA bit)
                            	  2265: ;
                            	  2266: ; No busy-poll needed: DMA is fire-and-forget from 68k RAM.  Next VDP access
                            	  2267: ; (later in VBlankISR) will stall briefly if transfer still in flight.
                            	  2268: ;==============================================================================
                            	  2269:     even
                            	  2270: _oam_dma_flush:
02:0002ACEC 48E7C000        	  2271:     movem.l D0/D1,-(SP)
02:0002ACF0 7000            	  2272:     moveq   #0,D0
02:0002ACF2 103900FF2400    	  2273:     move.b  (SAT_ACTIVE_BANK).l,D0
                            	  2274:     ; D0 = 0 → source = SAT_SHADOW_A; D0 = 1 → source = SAT_SHADOW_B
02:0002ACF8 223C00FF2000    	  2275:     move.l  #SAT_SHADOW_A,D1
02:0002ACFE 4A00            	  2276:     tst.b   D0
02:0002AD00 6706            	  2277:     beq.s   .oflush_src_ready
02:0002AD02 223C00FF2200    	  2278:     move.l  #SAT_SHADOW_B,D1
                            	  2279: .oflush_src_ready:
                            	  2280:     ; Length: 256 words. Reg 19 = lo byte = $00, Reg 20 = hi byte = $01
02:0002AD08 33FC930000C00004	  2281:     move.w  #$9300,(VDP_CTRL).l   ; Reg 19: length lo = $00
02:0002AD10 33FC940100C00004	  2282:     move.w  #$9401,(VDP_CTRL).l   ; Reg 20: length hi = $01
                            	  2283:     ; Source addr in words: D1 >> 1
02:0002AD18 E289            	  2284:     lsr.l   #1,D1
                            	  2285:     ; Reg 21 = source[7:0]
02:0002AD1A 3001            	  2286:     move.w  D1,D0
02:0002AD1C 024000FF        	  2287:     andi.w  #$00FF,D0
02:0002AD20 00409500        	  2288:     ori.w   #$9500,D0
02:0002AD24 33C000C00004    	  2289:     move.w  D0,(VDP_CTRL).l
                            	  2290:     ; Reg 22 = source[15:8]
02:0002AD2A 2001            	  2291:     move.l  D1,D0
02:0002AD2C E088            	  2292:     lsr.l   #8,D0
02:0002AD2E 024000FF        	  2293:     andi.w  #$00FF,D0
02:0002AD32 00409600        	  2294:     ori.w   #$9600,D0
02:0002AD36 33C000C00004    	  2295:     move.w  D0,(VDP_CTRL).l
                            	  2296:     ; Reg 23 = source[22:16] with bit 7 clear (68k→VRAM mode)
02:0002AD3C 2001            	  2297:     move.l  D1,D0
02:0002AD3E E088            	  2298:     lsr.l   #8,D0
02:0002AD40 E088            	  2299:     lsr.l   #8,D0
02:0002AD42 0240007F        	  2300:     andi.w  #$007F,D0
02:0002AD46 00409700        	  2301:     ori.w   #$9700,D0
02:0002AD4A 33C000C00004    	  2302:     move.w  D0,(VDP_CTRL).l
                            	  2303:     ; VDP command: VRAM write $F800 + DMA trigger bit
02:0002AD50 23FC7800008300C0	  2304:     move.l  #$78000083,(VDP_CTRL).l
02:0002AD58 0004
                            	  2305:     ; Flip active bank: bank just DMA'd becomes "previous"; other bank becomes active
02:0002AD5A 0A39000100FF2400	  2306:     eori.b  #1,(SAT_ACTIVE_BANK).l
02:0002AD62 4CDF0003        	  2307:     movem.l (SP)+,D0/D1
