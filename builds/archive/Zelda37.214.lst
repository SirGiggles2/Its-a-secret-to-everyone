02:0004D62E 023C00EE        	  7529:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D632 123C0001        	  7530:     move.b  #$01,D1
02:0004D636 D101            	  7531:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004D638 0C00000A        	  7532:     cmpi.b  #$0A,D0
