                            	  3273: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3274:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3275:     ; the mound frame images:
                            	  3276:     ;
                            	  3277:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3278:     ;
                            	  3279:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3280:     ;
                            	  3281:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3282:     ;
02:0003AC08 003C0011        	  3283:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC0C 123C0001        	  3284:     move.b  #$01,D1
02:0003AC10 0A3C0010        	  3285:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC14 9101            	  3286:     subx.b  D1,D0   ; SBC #$01
02:0003AC16 0A3C0010        	  3287:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC1A E308            	  3288:     lsl.b  #1,D0   ; ASL A
02:0003AC1C 023C00EE        	  3289:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC20 41EC03E4        	  3290:     lea     ($03E4,A4),A0
02:0003AC24 12302000        	  3291:     move.b  (A0,D2.W),D1
02:0003AC28 D101            	  3292:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  3293:     even
