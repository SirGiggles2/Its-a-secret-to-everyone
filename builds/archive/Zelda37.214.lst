                            	  1587: UpdateZolState2_Split:
                            	  1588:     ; We'll create two gels, but destroy the zol. So, increase
                            	  1589:     ; the object count by 1 only.
                            	  1590:     ;
02:0003A090 522C034E        	  1591:     addq.b  #1,($034E,A4)
02:0003A094 4EB90004DAB2    	  1592:     jsr     DestroyMonster
02:0003A09A 612C            	  1593:     jsr     CreateChildGel
                            	  1594:     ; If the zol's direction is vertical, then set the first child gel's
                            	  1595:     ; direction to left, else up.
                            	  1596:     ;
02:0003A09C 41EC0098        	  1597:     lea     ($0098,A4),A0
02:0003A0A0 10302000        	  1598:     move.b  (A0,D2.W),D0
02:0003A0A4 0C000004        	  1599:     cmpi.b  #$04,D0
02:0003A0A8 7002            	  1600:     moveq   #2,D0
02:0003A0AA 6402            	  1601:     bcc  _anon_z04_25
02:0003A0AC 7008            	  1602:     moveq   #8,D0
                            	  1603: _anon_z04_25:
02:0003A0AE 41EC0098        	  1604:     lea     ($0098,A4),A0
02:0003A0B2 11803000        	  1605:     move.b  D0,(A0,D3.W)
02:0003A0B6 1B00            	  1606:     move.b  D0,-(A5)  ; PHA
02:0003A0B8 610E            	  1607:     jsr     CreateChildGel
02:0003A0BA 101D            	  1608:     move.b  (A5)+,D0  ; PLA
                            	  1609:     ; Set the second child gel's direction to the opposite of the first one's.
                            	  1610:     ;
02:0003A0BC E208            	  1611:     lsr.b  #1,D0   ; LSR A
02:0003A0BE 41EC0098        	  1612:     lea     ($0098,A4),A0
02:0003A0C2 11803000        	  1613:     move.b  D0,(A0,D3.W)
02:0003A0C6 4E75            	  1614:     rts
