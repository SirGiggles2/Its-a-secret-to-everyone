                            	 10087: UpdateGohma:
                            	 10088:     ; If flagged not to continue straight, then choose a random facing direction.
                            	 10089:     ;
02:0003DDA2 41EC0451        	 10090:     lea     ($0451,A4),A0
02:0003DDA6 10302000        	 10091:     move.b  (A0,D2.W),D0
02:0003DDAA 662C            	 10092:     bne  _L_z04_UpdateGohma_Move
                            	 10093:     ; If Random:
                            	 10094:     ;   >= $B0: right
                            	 10095:     ;   >= $60: left
                            	 10096:     ;   Else:   down
                            	 10097:     ;
02:0003DDAC 7001            	 10098:     moveq   #1,D0
02:0003DDAE 7600            	 10099:     moveq   #0,D3
02:0003DDB0 16342018        	 10100:     move.b  ($18,A4,D2.W),D3
02:0003DDB4 0C0300B0        	 10101:     cmpi.b  #$B0,D3
02:0003DDB8 640A            	 10102:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDBA E308            	 10103:     lsl.b  #1,D0   ; ASL A
02:0003DDBC 0C030060        	 10104:     cmpi.b  #$60,D3
02:0003DDC0 6402            	 10105:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDC2 E308            	 10106:     lsl.b  #1,D0   ; ASL A
                            	 10107:     even
                            	 10108: _L_z04_UpdateGohma_ChangeDir:
