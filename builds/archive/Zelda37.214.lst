                            	  7625: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D706 7400            	  7626:     moveq   #0,D2
02:0004D708 142C0340        	  7627:     move.b  ($0340,A4),D2
                            	  7628:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7629:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7630:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7631:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7632:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7633:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7634:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7635:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7636:     ; corrupting them and causing a deterministic address-error
                            	  7637:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7638:     ; identified by Codex static review.)
                            	  7639: _L_z07_P47_pre_check:
02:0004D70C 102C0525        	  7640:     move.b  ($0525,A4),D0
02:0004D710 020000F0        	  7641:     andi.b  #$F0,D0
02:0004D714 0C000040        	  7642:     cmpi.b  #$40,D0
02:0004D718 6506            	  7643:     blo     _L_z07_P47_pre_snap
02:0004D71A 0C0000E0        	  7644:     cmpi.b  #$E0,D0
02:0004D71E 6506            	  7645:     blo     _L_z07_P47_pre_ok
                            	  7646: _L_z07_P47_pre_snap:
02:0004D720 197C00480525    	  7647:     move.b  #$48,($0525,A4)
                            	  7648: _L_z07_P47_pre_ok:
02:0004D726 7005            	  7649:     moveq   #5,D0
02:0004D728 61000526        	  7650:     jsr     SwitchBank
02:0004D72C 4EB90004207E    	  7651:     jsr     FindNextEdgeSpawnCell
                            	  7652:     ; Post-walk 1: bottom-edge snap.
02:0004D732 102C0525        	  7653:     move.b  ($0525,A4),D0
02:0004D736 020000F0        	  7654:     andi.b  #$F0,D0
02:0004D73A 0C0000E0        	  7655:     cmpi.b  #$E0,D0
02:0004D73E 660C            	  7656:     bne     _L_z07_P47_post1_ok
02:0004D740 197C00480525    	  7657:     move.b  #$48,($0525,A4)
02:0004D746 4EB90004207E    	  7658:     jsr     FindNextEdgeSpawnCell
                            	  7659: _L_z07_P47_post1_ok:
                            	  7660:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7661:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D74C 7600            	  7662:     moveq   #0,D3
02:0004D74E 162C0525        	  7663:     move.b  ($0525,A4),D3
02:0004D752 0243000F        	  7664:     andi.w  #$000F,D3
02:0004D756 C6FC002C        	  7665:     mulu.w  #44,D3
02:0004D75A 203C00FF6530    	  7666:     move.l  #$FF6530,D0
02:0004D760 D083            	  7667:     add.l   D3,D0
02:0004D762 7600            	  7668:     moveq   #0,D3
02:0004D764 162C0525        	  7669:     move.b  ($0525,A4),D3
02:0004D768 E84B            	  7670:     lsr.w   #4,D3
02:0004D76A 5943            	  7671:     subi.w  #4,D3
02:0004D76C E34B            	  7672:     lsl.w   #1,D3
02:0004D76E D083            	  7673:     add.l   D3,D0
02:0004D770 2040            	  7674:     movea.l D0,A0
02:0004D772 1010            	  7675:     move.b  (A0),D0
02:0004D774 0C000084        	  7676:     cmpi.b  #$84,D0
02:0004D778 6544            	  7677:     blo     _L_z07_P47_post2_ok
                            	  7678:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7679:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7680:     ; writes to the $05xx region.
02:0004D77A 7800            	  7681:     moveq   #0,D4
                            	  7682: _L_z07_P47_fb_loop:
02:0004D77C 41FAE44C        	  7683:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D780 12304000        	  7684:     move.b  (A0,D4.W),D1
02:0004D784 19410525        	  7685:     move.b  D1,($0525,A4)
                            	  7686:     ; Validate fallback cell walkable.
02:0004D788 7600            	  7687:     moveq   #0,D3
02:0004D78A 1601            	  7688:     move.b  D1,D3
02:0004D78C 0243000F        	  7689:     andi.w  #$000F,D3
02:0004D790 C6FC002C        	  7690:     mulu.w  #44,D3
02:0004D794 203C00FF6530    	  7691:     move.l  #$FF6530,D0
02:0004D79A D083            	  7692:     add.l   D3,D0
02:0004D79C 7600            	  7693:     moveq   #0,D3
02:0004D79E 1601            	  7694:     move.b  D1,D3
02:0004D7A0 E84B            	  7695:     lsr.w   #4,D3
02:0004D7A2 5943            	  7696:     subi.w  #4,D3
02:0004D7A4 E34B            	  7697:     lsl.w   #1,D3
02:0004D7A6 D083            	  7698:     add.l   D3,D0
02:0004D7A8 2040            	  7699:     movea.l D0,A0
02:0004D7AA 0C100084        	  7700:     cmpi.b  #$84,(A0)
02:0004D7AE 650E            	  7701:     blo     _L_z07_P47_post2_ok
02:0004D7B0 5204            	  7702:     addq.b  #1,D4
02:0004D7B2 0C040008        	  7703:     cmpi.b  #8,D4
02:0004D7B6 65C4            	  7704:     blo     _L_z07_P47_fb_loop
                            	  7705:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7706:     ; rather than looping).
02:0004D7B8 197C00480525    	  7707:     move.b  #$48,($0525,A4)
                            	  7708: _L_z07_P47_post2_ok:
                            	  7709:     ; Extract and set the monster's location.
                            	  7710:     ;
02:0004D7BE 102C0525        	  7711:     move.b  ($0525,A4),D0
                            	  7712:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7713:     ;
02:0004D7C2 1B00            	  7714:     move.b  D0,-(A5)  ; PHA
02:0004D7C4 E308            	  7715:     lsl.b  #1,D0   ; ASL A
02:0004D7C6 E308            	  7716:     lsl.b  #1,D0   ; ASL A
02:0004D7C8 E308            	  7717:     lsl.b  #1,D0   ; ASL A
02:0004D7CA E308            	  7718:     lsl.b  #1,D0   ; ASL A
02:0004D7CC 19802070        	  7719:     move.b  D0,($70,A4,D2.W)
                            	  7720:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7721:     ;
02:0004D7D0 101D            	  7722:     move.b  (A5)+,D0  ; PLA
02:0004D7D2 020000F0        	  7723:     andi.b #$F0,D0
02:0004D7D6 003C0011        	  7724:     ori     #$11,CCR  ; SEC: set C+X
02:0004D7DA 123C0003        	  7725:     move.b  #$03,D1
02:0004D7DE 0A3C0010        	  7726:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D7E2 9101            	  7727:     subx.b  D1,D0   ; SBC #$03
02:0004D7E4 0A3C0010        	  7728:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D7E8 41EC0084        	  7729:     lea     ($0084,A4),A0
02:0004D7EC 11802000        	  7730:     move.b  D0,(A0,D2.W)
                            	  7731:     ; Set the monsters-from-edges long timer to a random value
                            	  7732:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7733:     ;
02:0004D7F0 10342019        	  7734:     move.b  ($19,A4,D2.W),D0
02:0004D7F4 02000003        	  7735:     andi.b #$03,D0
02:0004D7F8 023C00EE        	  7736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D7FC 123C0002        	  7737:     move.b  #$02,D1
02:0004D800 D101            	  7738:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004D802 1940004B        	  7739:     move.b  D0,($004B,A4)
                            	  7740:     ; If the distance to Link is too close to Link, then
                            	  7741:     ; go flag the monster uninitialized again, so we can
                            	  7742:     ; try to spawn it again next time.
                            	  7743:     ;
02:0004D806 7005            	  7744:     moveq   #5,D0
02:0004D808 61000446        	  7745:     jsr     SwitchBank
02:0004D80C 4EB900041572    	  7746:     jsr     IsDistanceSafeToSpawn
02:0004D812 6500FEB4        	  7747:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7748:     ; OK to spawn.
                            	  7749:     ; In this situation, monsters don't spawn from a cloud.
                            	  7750:     ;
02:0004D816 7000            	  7751:     moveq   #0,D0
02:0004D818 41EC0405        	  7752:     lea     ($0405,A4),A0
02:0004D81C 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     even
                            	  7755: _L_z07_InitObject_NormalSpawn:
02:0004D820 7004            	  7756:     moveq   #4,D0
02:0004D822 6100042C        	  7757:     jsr     SwitchBank
                            	  7758:     ; For monsters that spawn in a cloud, set their start time to
                            	  7759:     ; the same value as the object slot; so that they all start
                            	  7760:     ; moving at different times.
                            	  7761:     ;
02:0004D826 7400            	  7762:     moveq   #0,D2
02:0004D828 142C0340        	  7763:     move.b  ($0340,A4),D2
02:0004D82C 7600            	  7764:     moveq   #0,D3
