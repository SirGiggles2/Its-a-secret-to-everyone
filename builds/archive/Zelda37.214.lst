                            	   440: _anon_z05_3:
                            	   441:     ; If Start was pressed, then hide all sprites except
                            	   442:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   443:     ;
02:000402C8 102C00F8        	   444:     move.b  ($00F8,A4),D0
02:000402CC 02000010        	   445:     andi.b #$10,D0
02:000402D0 6606            	   446:     bne.s  __far_z_05_0003
