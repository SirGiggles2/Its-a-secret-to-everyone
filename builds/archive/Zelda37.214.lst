02:0003B2B8 003C0011        	  4281:     ori     #$11,CCR  ; SEC: set C+X
02:0003B2BC 123C001C        	  4282:     move.b  #$1C,D1
02:0003B2C0 0A3C0010        	  4283:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B2C4 9101            	  4284:     subx.b  D1,D0   ; SBC #$1C
02:0003B2C6 0A3C0010        	  4285:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B2CA 41EC0084        	  4286:     lea     ($0084,A4),A0
