                            	  2080:     ;
                            	  2081:     ; Pattern
02:0003A3C6 7600            	  2082:     moveq   #0,D3
02:0003A3C8 162C000B        	  2083:     move.b  ($000B,A4),D3
02:0003A3CC 1002            	  2084:     move.b  D2,D0
02:0003A3CE 023C00EE        	  2085:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3D2 41F90003A314    	  2086:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A3D8 12303000        	  2087:     move.b  (A0,D3.W),D1
02:0003A3DC D101            	  2088:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A3DE 7600            	  2089:     moveq   #0,D3
02:0003A3E0 1600            	  2090:     move.b  D0,D3
02:0003A3E2 1002            	  2091:     move.b  D2,D0
