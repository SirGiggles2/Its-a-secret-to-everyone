                            	  3676:     even
                            	  3677: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  3678:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  3679:     ;
02:0003AF14 0C030001        	  3680:     cmpi.b  #$01,D3
