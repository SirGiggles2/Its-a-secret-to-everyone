02:0004D68C 102C04CD        	  7575:     move.b  ($04CD,A4),D0
02:0004D690 02000008        	  7576:     andi.b #$08,D0
02:0004D694 6700018A        	  7577:     beq  _L_z07_InitObject_NormalSpawn
02:0004D698 41EC034F        	  7578:     lea     ($034F,A4),A0
02:0004D69C 10302000        	  7579:     move.b  (A0,D2.W),D0
02:0004D6A0 0C000011        	  7580:     cmpi.b  #$11,D0
02:0004D6A4 6700017A        	  7581:     beq  _L_z07_InitObject_NormalSpawn
02:0004D6A8 0C000040        	  7582:     cmpi.b  #$40,D0
02:0004D6AC 67000172        	  7583:     beq  _L_z07_InitObject_NormalSpawn
02:0004D6B0 0C00001E        	  7584:     cmpi.b  #$1E,D0
02:0004D6B4 6700016A        	  7585:     beq  _L_z07_InitObject_NormalSpawn
02:0004D6B8 0C00002E        	  7586:     cmpi.b  #$2E,D0
02:0004D6BC 67000162        	  7587:     beq  _L_z07_InitObject_NormalSpawn
02:0004D6C0 0C000053        	  7588:     cmpi.b  #$53,D0
02:0004D6C4 6400015A        	  7589:     bcc  _L_z07_InitObject_NormalSpawn
