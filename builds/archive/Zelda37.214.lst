                            	  6116:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6117:     ;
02:0003C052 10342028        	  6118:     move.b  ($28,A4,D2.W),D0
02:0003C056 0C000010        	  6119:     cmpi.b  #$10,D0
02:0003C05A 6702            	  6120:     beq.s  __far_z_04_0049
02:0003C05C 6058            	  6121:     jmp  L1156B_Exit
