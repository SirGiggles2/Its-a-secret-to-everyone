02:0002E60C 020000F0        	  1778:     andi.b #$F0,D0
02:0002E610 003C0011        	  1779:     ori     #$11,CCR  ; SEC: set C+X
02:0002E614 123C0010        	  1780:     move.b  #$10,D1
02:0002E618 0A3C0010        	  1781:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E61C 9101            	  1782:     subx.b  D1,D0   ; SBC #$10
02:0002E61E 0A3C0010        	  1783:     eori    #$10,CCR  ; restore X = 6502 C
