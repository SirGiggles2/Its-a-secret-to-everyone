                            	  7621: CheckMonsterShotCollision:
02:00031FAC 61000084        	  7622:     jsr     CheckMonsterSlenderWeaponCollision
                            	  7623:     ; If no collision, return.
                            	  7624:     ;
02:00031FB0 102C0006        	  7625:     move.b  ($0006,A4),D0
02:00031FB4 6602            	  7626:     bne.s  __far_z_01_0091
02:00031FB6 6078            	  7627:     jmp  L763A_Exit
                            	  7628: __far_z_01_0091:
                            	  7629:     ; $12 is the arrow and rod slot. But this routine will only
                            	  7630:     ; be called if it's an arrow.
                            	  7631:     ;
                            	  7632:     ; If the weapon is an arrow and the monster is Pol's Voice;
