                            	  4168:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4169:     ;
02:0003B20C 102C0029        	  4170:     move.b  ($0029,A4),D0
02:0003B210 660A            	  4171:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4172:     ; Else go to state 3, and unhalt Link.
                            	  4173:     ;
