02:0004475E 003C0011        	  7613:     ori     #$11,CCR  ; SEC: set C+X
02:00044762 123C0040        	  7614:     move.b  #$40,D1
02:00044766 0A3C0010        	  7615:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004476A 9101            	  7616:     subx.b  D1,D0   ; SBC #$40
02:0004476C 0A3C0010        	  7617:     eori    #$10,CCR  ; restore X = 6502 C
02:00044770 E208            	  7618:     lsr.b  #1,D0   ; LSR A
02:00044772 E208            	  7619:     lsr.b  #1,D0   ; LSR A
02:00044774 E208            	  7620:     lsr.b  #1,D0   ; LSR A
