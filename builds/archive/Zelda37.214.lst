                            	  3977: FindNextEdgeSpawnCell:
                            	  3978:     ; Load [0A] with the value before the call.
                            	  3979:     ;
02:0004207E 102C0525        	  3980:     move.b  ($0525,A4),D0
02:00042082 1940000A        	  3981:     move.b  D0,($000A,A4)
                            	  3982:     even
                            	  3983: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3984:     ; Loop to look for a place to spawn a monster from the edge
                            	  3985:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3986:     ;
                            	  3987:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3988:     ; We'll move down $10 pixels.
                            	  3989:     ;
02:00042086 7610            	  3990:     moveq   #16,D3
02:00042088 102C000A        	  3991:     move.b  ($000A,A4),D0
02:0004208C 0200000F        	  3992:     andi.b #$0F,D0
02:00042090 670A            	  3993:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3994:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3995:     ; Don't move vertically.
                            	  3996:     ;
02:00042092 163C00F0        	  3997:     move.b  #$F0,D3
02:00042096 0C00000F        	  3998:     cmpi.b  #$0F,D0
02:0004209A 6610            	  3999:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  4000:     even
                            	  4001: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  4002:     ; Else low nibble = $F. We're at the right edge,
                            	  4003:     ; and we'll move up $10 pixels.
                            	  4004:     ;
02:0004209C 1003            	  4005:     move.b  D3,D0
02:0004209E 023C00EE        	  4006:     andi    #$EE,CCR  ; CLC: clear C+X
02:000420A2 122C000A        	  4007:     move.b  ($000A,A4),D1
02:000420A6 D101            	  4008:     addx.b  D1,D0   ; ADC $0A
02:000420A8 1940000A        	  4009:     move.b  D0,($000A,A4)
                            	  4010:     even
                            	  4011: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  4012:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  4013:     ; Move right one pixel.
                            	  4014:     ;
02:000420AC 102C000A        	  4015:     move.b  ($000A,A4),D0
02:000420B0 020000F0        	  4016:     andi.b #$F0,D0
02:000420B4 0C0000E0        	  4017:     cmpi.b  #$E0,D0
02:000420B8 6606            	  4018:     bne  _anon_z05_88
02:000420BA 522C000A        	  4019:     addq.b  #1,($000A,A4)
02:000420BE 600A            	  4020:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4021: 
                            	  4022: _anon_z05_88:
                            	  4023:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  4024:     ; Dont' move horizontally.
                            	  4025:     ;
02:000420C0 0C000040        	  4026:     cmpi.b  #$40,D0
02:000420C4 6604            	  4027:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4028:     ; Else high nibble = 4. We're at the top edge.
                            	  4029:     ; Move left 1 pixel.
                            	  4030:     ;
02:000420C6 532C000A        	  4031:     subq.b  #1,($000A,A4)
                            	  4032:     even
                            	  4033: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  4034:     ; Time to get the address of the column.
                            	  4035:     ; Starting at the top of the leftmost column.
                            	  4036:     ;
02:000420CA 610026E8        	  4037:     jsr     FetchTileMapAddr
02:000420CE 7005            	  4038:     moveq   #5,D0
02:000420D0 4EB90002A9FA    	  4039:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  4040:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  4041:     ; in order to point to the column we want.
                            	  4042:     ;
02:000420D6 102C000A        	  4043:     move.b  ($000A,A4),D0
02:000420DA 0200000F        	  4044:     andi.b #$0F,D0
02:000420DE 7600            	  4045:     moveq   #0,D3
02:000420E0 1600            	  4046:     move.b  D0,D3
02:000420E2 670C            	  4047:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  4048: _anon_z05_89:
02:000420E4 702C            	  4049:     moveq   #44,D0
02:000420E6 4EB900030D78    	  4050:     jsr     AddToInt16At0
02:000420EC 5303            	  4051:     subq.b  #1,D3
02:000420EE 66F4            	  4052:     bne  _anon_z05_89
                            	  4053:     even
                            	  4054: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  4055:     ; Turn the row part of [0A] into a tile index.
                            	  4056:     ; row := (([0A] AND $F0) - $40) / 8
                            	  4057:     ;
02:000420F0 102C000A        	  4058:     move.b  ($000A,A4),D0
02:000420F4 020000F0        	  4059:     andi.b #$F0,D0
02:000420F8 003C0011        	  4060:     ori     #$11,CCR  ; SEC: set C+X
02:000420FC 123C0040        	  4061:     move.b  #$40,D1
02:00042100 0A3C0010        	  4062:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042104 9101            	  4063:     subx.b  D1,D0   ; SBC #$40
02:00042106 0A3C0010        	  4064:     eori    #$10,CCR  ; restore X = 6502 C
02:0004210A E208            	  4065:     lsr.b  #1,D0   ; LSR A
02:0004210C E208            	  4066:     lsr.b  #1,D0   ; LSR A
02:0004210E E208            	  4067:     lsr.b  #1,D0   ; LSR A
02:00042110 7600            	  4068:     moveq   #0,D3
02:00042112 1600            	  4069:     move.b  D0,D3
                            	  4070:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  4071:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  4072:     ; when coming in from the edges.
                            	  4073:     ;
02:00042114 1214            	  4074:     move.b  ($00,A4),D1   ; ptr lo
02:00042116 182C0001        	  4075:     move.b  ($01,A4),D4  ; ptr hi
02:0004211A 024100FF        	  4076:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004211E E14C            	  4077:     lsl.w   #8,D4
02:00042120 8841            	  4078:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042122 48C4            	  4079:     ext.l   D4
02:00042124 D8BC00FF0000    	  4080:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004212A 2044            	  4081:     movea.l D4,A0
02:0004212C 10303000        	  4082:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042130 0C000084        	  4083:     cmpi.b  #$84,D0
02:00042134 650E            	  4084:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  4085:     ; Bottom of the loop.
                            	  4086:     ; If you reach the original cell, then stop.
                            	  4087:     ;
02:00042136 102C000A        	  4088:     move.b  ($000A,A4),D0
02:0004213A 122C0525        	  4089:     move.b  ($0525,A4),D1
02:0004213E B001            	  4090:     cmp.b   D1,D0
02:00042140 6600FF44        	  4091:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  4092:     even
                            	  4093: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  4094:     ; Set the spawn cell to the one we found.
