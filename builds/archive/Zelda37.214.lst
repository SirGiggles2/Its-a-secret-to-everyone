                            	  3236:     ;
02:000300B6 102C0070        	  3237:     move.b  ($0070,A4),D0
02:000300BA 003C0011        	  3238:     ori     #$11,CCR  ; SEC: set C+X
02:000300BE 12342070        	  3239:     move.b  ($70,A4,D2.W),D1
02:000300C2 0A3C0010        	  3240:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000300C6 9101            	  3241:     subx.b  D1,D0   ; SBC ObjX,X
02:000300C8 0A3C0010        	  3242:     eori    #$10,CCR  ; restore X = 6502 C
02:000300CC 61000850        	  3243:     jsr     Abs
