                            	 11950:     ; Mode $13 will start with a curtain furling effect.
                            	 11951:     ; Set up the decreasing column ($20), and the increasing column (1).
                            	 11952:     ; Prepare the background by filling the tile map with blank tile $24.
                            	 11953:     ;
02:0003EBAA 7020            	 11954:     moveq   #32,D0
02:0003EBAC 1940007C        	 11955:     move.b  D0,($007C,A4)
02:0003EBB0 7001            	 11956:     moveq   #1,D0
02:0003EBB2 1940007D        	 11957:     move.b  D0,($007D,A4)
02:0003EBB6 7024            	 11958:     moveq   #36,D0
02:0003EBB8 1940000A        	 11959:     move.b  D0,($000A,A4)
02:0003EBBC 4EF90004B1DC    	 11960:     jmp     FillTileMap
                            	 11961: 
                            	 11962:     even
