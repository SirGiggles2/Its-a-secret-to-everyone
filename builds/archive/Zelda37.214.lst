02:00030A2E 122C0004        	  4713:     move.b  ($0004,A4),D1
02:00030A32 0A3C0010        	  4714:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030A36 9101            	  4715:     subx.b  D1,D0   ; SBC $04
02:00030A38 0A3C0010        	  4716:     eori    #$10,CCR  ; restore X = 6502 C
02:00030A3C 19400003        	  4717:     move.b  D0,($0003,A4)
02:00030A40 122C0004        	  4718:     move.b  ($0004,A4),D1
02:00030A44 B001            	  4719:     cmp.b   D1,D0
02:00030A46 64C8            	  4720:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4721:     even
