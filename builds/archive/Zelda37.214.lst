                            	 12912: __far_z_04_0131:
                            	 12913:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12914:     ; Collisions were checked already.
                            	 12915:     ;
                            	 12916:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12917:     ; in anticipation of moving around when timer becomes 0 next frame.
