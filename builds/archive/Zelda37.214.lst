02:0003CF8E 123C0008        	  8211:     move.b  #$08,D1
02:0003CF92 D101            	  8212:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CF94 020000F0        	  8213:     andi.b #$F0,D0
02:0003CF98 19802070        	  8214:     move.b  D0,($70,A4,D2.W)
                            	  8215:     ; Align the monster with a square vertically.
                            	  8216:     ;
                            	  8217:     ; If in the top half of a square, align with that square.
                            	  8218:     ; If in the bottom half, align with the next square.
                            	  8219:     ;
02:0003CF9C 41EC0084        	  8220:     lea     ($0084,A4),A0
02:0003CFA0 10302000        	  8221:     move.b  (A0,D2.W),D0
02:0003CFA4 023C00EE        	  8222:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFA8 123C0008        	  8223:     move.b  #$08,D1
02:0003CFAC D101            	  8224:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CFAE 020000F0        	  8225:     andi.b #$F0,D0
                            	  8226:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8227:     ;
02:0003CFB2 003C0011        	  8228:     ori     #$11,CCR  ; SEC: set C+X
02:0003CFB6 123C0003        	  8229:     move.b  #$03,D1
02:0003CFBA 0A3C0010        	  8230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CFBE 9101            	  8231:     subx.b  D1,D0   ; SBC #$03
02:0003CFC0 0A3C0010        	  8232:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CFC4 41EC0084        	  8233:     lea     ($0084,A4),A0
02:0003CFC8 11802000        	  8234:     move.b  D0,(A0,D2.W)
