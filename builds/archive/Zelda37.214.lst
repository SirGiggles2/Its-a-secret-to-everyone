02:0004D14A 0200000F        	  6926:     andi.b #$0F,D0
02:0004D14E 003C0011        	  6927:     ori     #$11,CCR  ; SEC: set C+X
02:0004D152 123C0002        	  6928:     move.b  #$02,D1
02:0004D156 0A3C0010        	  6929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D15A 9101            	  6930:     subx.b  D1,D0   ; SBC #$02
02:0004D15C 0A3C0010        	  6931:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6932: ; Params:
                            	  6933: ; A: frame image (1 to 3)
                            	  6934: ; X: object index
                            	  6935: ; [00]: X
                            	  6936: ; [01]: Y
                            	  6937: ;
                            	  6938: ;
                            	  6939: ; [0C] frame image
