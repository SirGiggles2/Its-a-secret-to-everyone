                            	  4447: CheckTiles:
                            	  4448:     ifne TURBO_LINK
                            	  4449:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4450:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004C028 4A02            	  4451:     tst.b   D2
02:0004C02A 6608            	  4452:     bne.s   _L_z07_CheckTiles_notLink
02:0004C02C 197C0024049E    	  4453:     move.b  #$24,($049E,A4)
