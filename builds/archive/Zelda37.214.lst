                            	  5470: _L_z01_TakeItem_SkipLift:
                            	  5471:     ; Look up the item slot and sprite attributes by the item type.
                            	  5472:     ;
02:00030F68 7400            	  5473:     moveq   #0,D2
02:00030F6A 1400            	  5474:     move.b  D0,D2
02:00030F6C 41F900030DB2    	  5475:     lea     (ItemIdToSlot).l,A0
02:00030F72 10302000        	  5476:     move.b  (A0,D2.W),D0
02:00030F76 7600            	  5477:     moveq   #0,D3
02:00030F78 1600            	  5478:     move.b  D0,D3
02:00030F7A 41F900030DD6    	  5479:     lea     (ItemIdToDescriptor).l,A0
02:00030F80 10302000        	  5480:     move.b  (A0,D2.W),D0
                            	  5481:     ; [0A] holds the item value from the low nibble of descriptor.
                            	  5482:     ;
02:00030F84 1B00            	  5483:     move.b  D0,-(A5)  ; PHA
02:00030F86 0200000F        	  5484:     andi.b #$0F,D0
02:00030F8A 1940000A        	  5485:     move.b  D0,($000A,A4)
