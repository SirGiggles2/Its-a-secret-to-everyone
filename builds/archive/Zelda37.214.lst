                            	  5057:     ;
02:00030C40 0C030016        	  5058:     cmpi.b  #$16,D3
02:00030C44 6706            	  5059:     beq  _anon_z01_54
02:00030C46 0C030011        	  5060:     cmpi.b  #$11,D3
02:00030C4A 6604            	  5061:     bne  _L_z01_UpdateBombFlashEffect_Clear
