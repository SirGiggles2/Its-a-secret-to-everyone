                            	   308: ;------------------------------------------------------------------------------
                            	   309: ; _c_move_object_shim — MoveObject trampoline.
                            	   310: ;
                            	   311: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   312: ;   Input:     D2 = slot (0..11)
                            	   313: ;   Preserves: D2, A4, A5
                            	   314: ;   Clobbers:  D0, D1, D3, A0
                            	   315: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   316: ;
                            	   317: ; GCC side:
                            	   318: ;   void c_move_object(unsigned short slot);
                            	   319: ;     slot arrives as a 16-bit value on the stack.
                            	   320: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   321: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   322: ;   never clobbered by gcc.
                            	   323: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   324: ;   semantics can exist in a pure C port).
                            	   325: ;------------------------------------------------------------------------------
                            	   326: _c_move_object_shim:
                            	   327:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   328:     move.b  #$AA,($0900,A4)
                            	   329:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   330:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   331:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   332:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   333:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   334:     moveq   #0,D0
02:0002B658 3002            	   335:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   336:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   337:     jsr     c_move_object
02:0002B662 588F            	   338:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   339:     rts
                            	   340: 
                            	   341: ;==============================================================================
                            	   342: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   343: ; and tail-call the native asm function.
                            	   344: ;
                            	   345: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   346: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   347: ; sign-extended).
                            	   348: ;==============================================================================
                            	   349: 
                            	   350: ;------------------------------------------------------------------------------
