                            	  2531: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2532: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2533: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2534: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2535: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2536: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2537:     even
                            	  2538: ModeE_SyncCharBoardCursorToIndex:
02:00034B64 4EF90002BADC    	  2539:     jmp     c_mode_e_sync_char_board_cursor
                            	  2540: 
                            	  2541: ModeE_HandleAOrB:
02:00034B6A 102C0420        	  2542:     move.b  ($0420,A4),D0
                            	  2543:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2544:     ; the name field.
02:00034B6E 6646            	  2545:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034B70 7600            	  2546:     moveq   #0,D3
02:00034B72 162C0016        	  2547:     move.b  ($0016,A4),D3
02:00034B76 0C030003        	  2548:     cmpi.b  #$03,D3
02:00034B7A 6602            	  2549:     bne.s  __far_z_02_0007
02:00034B7C 60E4            	  2550:     jmp  LA10A_Exit
                            	  2551: __far_z_02_0007:
                            	  2552:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2553:     ; in the current slot's name.
02:00034B7E 41F90003458C    	  2554:     lea     (SlotToNameOffset).l,A0
02:00034B84 10303000        	  2555:     move.b  (A0,D3.W),D0
02:00034B88 19400421        	  2556:     move.b  D0,($0421,A4)
                            	  2557:     ; Get the offset of the end of the initial name character
                            	  2558:     ; transfer record header for the current slot.
02:00034B8C 7400            	  2559:     moveq   #0,D2
02:00034B8E 41F900034590    	  2560:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034B94 14303000        	  2561:     move.b  (A0,D3.W),D2
02:00034B98 7602            	  2562:     moveq   #2,D3
                            	  2563:     even
                            	  2564: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00034B9A 41F90003455C    	  2565:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034BA0 10302000        	  2566:     move.b  (A0,D2.W),D0
02:00034BA4 41EC0422        	  2567:     lea     ($0422,A4),A0
02:00034BA8 11803000        	  2568:     move.b  D0,(A0,D3.W)
02:00034BAC 5302            	  2569:     subq.b  #1,D2
02:00034BAE 5303            	  2570:     subq.b  #1,D3
02:00034BB0 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034BB2 522C0420        	  2572:     addq.b  #1,($0420,A4)
                            	  2573:     even
                            	  2574: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2575:     ; At this point:
                            	  2576:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2577:     ;   - This will be changed as the player inputs characters.
                            	  2578:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2579:     ;   - This will be changed as the player inputs characters.
                            	  2580:     ; - InitializedNameField [$0420] is set to 1.
                            	  2581:     ;
02:00034BB6 102C00F8        	  2582:     move.b  ($00F8,A4),D0
02:00034BBA 020000C0        	  2583:     andi.b #$C0,D0
02:00034BBE 670000E8        	  2584:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2585:     ; A or B was pressed.
                            	  2586:     ;
02:00034BC2 0C000040        	  2587:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034BC6 660000A6        	  2588:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2589:     ; A was pressed.
                            	  2590:     ;
                            	  2591:     ; Request to play the character click tune (same as bomb set).
02:00034BCA 7620            	  2592:     moveq   #32,D3
02:00034BCC 19430604        	  2593:     move.b  D3,($0604,A4)
02:00034BD0 7602            	  2594:     moveq   #2,D3
                            	  2595:     even
                            	  2596: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034BD2 41EC0422        	  2597:     lea     ($0422,A4),A0
02:00034BD6 10303000        	  2598:     move.b  (A0,D3.W),D0
02:00034BDA 41EC0302        	  2599:     lea     ($0302,A4),A0
02:00034BDE 11803000        	  2600:     move.b  D0,(A0,D3.W)
02:00034BE2 5303            	  2601:     subq.b  #1,D3
02:00034BE4 6AEC            	  2602:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034BE6 19430306        	  2603:     move.b  D3,($0306,A4)
02:00034BEA 7400            	  2604:     moveq   #0,D2
02:00034BEC 142C0421        	  2605:     move.b  ($0421,A4),D2
02:00034BF0 7600            	  2606:     moveq   #0,D3
02:00034BF2 162C041F        	  2607:     move.b  ($041F,A4),D3
02:00034BF6 41F900034530    	  2608:     lea     (ModeE_CharMap).l,A0
02:00034BFC 10303000        	  2609:     move.b  (A0,D3.W),D0
02:00034C00 19400305        	  2610:     move.b  D0,($0305,A4)
02:00034C04 41EC0638        	  2611:     lea     ($0638,A4),A0
02:00034C08 11802000        	  2612:     move.b  D0,(A0,D2.W)
                            	  2613:     even
                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034C0C 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034C10 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034C14 123C0008        	  2617:     move.b  #$08,D1
02:00034C18 D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034C1A 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034C1E 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034C22 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034C26 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034C2A 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034C2E 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034C30 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034C34 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
