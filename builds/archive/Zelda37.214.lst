02:0003BFB0 10342070        	  5984:     move.b  ($70,A4,D2.W),D0
02:0003BFB4 19803071        	  5985:     move.b  D0,($71,A4,D3.W)
02:0003BFB8 41EC0084        	  5986:     lea     ($0084,A4),A0
02:0003BFBC 10302000        	  5987:     move.b  (A0,D2.W),D0
02:0003BFC0 41EC0085        	  5988:     lea     ($0085,A4),A0
02:0003BFC4 11803000        	  5989:     move.b  D0,(A0,D3.W)
