                            	  4140: PondFairy_HandleOtherStates:
02:0003B1F0 0C000001        	  4141:     cmpi.b  #$01,D0
02:0003B1F4 6610            	  4142:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4143:     ; State 1. Flying and filling hearts.
                            	  4144:     ;
                            	  4145:     ; If still filling hearts, then go draw Link and hearts.
                            	  4146:     ;
02:0003B1F6 102C0063        	  4147:     move.b  ($0063,A4),D0
02:0003B1FA 6620            	  4148:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4149:     ; If not filling hearts anymore, then go to state 2,
                            	  4150:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4151:     ; a little while after we finish filling hearts.
