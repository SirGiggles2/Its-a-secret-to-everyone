                            	  1689: ; [end inline] dat\ObjListAddrs.inc
                            	  1690: 
                            	  1691:     even
                            	  1692: InitMode4:
02:0004106C 7400            	  1693:     moveq   #0,D2
02:0004106E 142C0013        	  1694:     move.b  ($0013,A4),D2
02:00041072 6604            	  1695:     bne.s  __far_z_05_0028
02:00041074 60000086        	  1696:     jmp  InitMode_EnterRoom
                            	  1697: __far_z_05_0028:
02:00041078 5302            	  1698:     subq.b  #1,D2
02:0004107A 6612            	  1699:     bne  _L_z05_InitMode4_CheckSub2
                            	  1700:     ; Submode 1.
                            	  1701:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1702:     ;
                            	  1703:     ; TODO:
                            	  1704:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1705:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1706:     ; A positive value triggers this submode 1 to transfer
                            	  1707:     ; the whole play area.
                            	  1708:     ;
                            	  1709:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1710:     ; a good state reflecting the new room. The only thing
                            	  1711:     ; needed is possibly to brighten the room by way of
                            	  1712:     ; changing the palette.
                            	  1713:     ;
                            	  1714:     ; So why does mode 7 trigger this?
                            	  1715:     ; Is there another mode that truly needs this behavior?
                            	  1716:     ;
02:0004107C 102C00E9        	  1717:     move.b  ($00E9,A4),D0
02:00041080 6B06            	  1718:     bmi  _anon_z05_40
02:00041082 6100373C        	  1719:     jsr     CopyNextRowToTransferBuf
02:00041086 6404            	  1720:     bcc  _L_z05_InitMode4_Exit
                            	  1721: _anon_z05_40:
02:00041088 522C0013        	  1722:     addq.b  #1,($0013,A4)
                            	  1723:     even
                            	  1724: _L_z05_InitMode4_Exit:
02:0004108C 4E75            	  1725:     rts
                            	  1726: 
                            	  1727:     even
                            	  1728: _L_z05_InitMode4_CheckSub2:
02:0004108E 5302            	  1729:     subq.b  #1,D2
02:00041090 6702            	  1730:     beq.s  __far_z_05_0029
02:00041092 605A            	  1731:     jmp  InitMode4_Sub3
                            	  1732: __far_z_05_0029:
                            	  1733:     ; Submode 2.
                            	  1734:     ;
02:00041094 7600            	  1735:     moveq   #0,D3
02:00041096 162C00EB        	  1736:     move.b  ($00EB,A4),D3
02:0004109A 610045BE        	  1737:     jsr     IsDarkRoom_Bank5
02:0004109E 6702            	  1738:     beq.s  __far_z_05_0030
02:000410A0 6054            	  1739:     jmp  InitMode4_GoToSub0
                            	  1740: __far_z_05_0030:
                            	  1741:     ; This is a light room.
                            	  1742:     ; See if we have to brighten it after leaving a dark room.
                            	  1743:     ;
02:000410A2 102C0098        	  1744:     move.b  ($0098,A4),D0
02:000410A6 610043FA        	  1745:     jsr     CalcNextRoomByDir
                            	  1746:     ; Subtract RoomId from next room ID that was calculated
                            	  1747:     ; to get room ID offset in that direction.
02:000410AA 003C0011        	  1748:     ori     #$11,CCR  ; SEC: set C+X
02:000410AE 122C00EB        	  1749:     move.b  ($00EB,A4),D1
02:000410B2 0A3C0010        	  1750:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000410B6 9101            	  1751:     subx.b  D1,D0   ; SBC RoomId
02:000410B8 0A3C0010        	  1752:     eori    #$10,CCR  ; restore X = 6502 C
02:000410BC 4EB900030920    	  1753:     jsr     Negate
02:000410C2 023C00EE        	  1754:     andi    #$EE,CCR  ; CLC: clear C+X
02:000410C6 122C00EB        	  1755:     move.b  ($00EB,A4),D1
02:000410CA D101            	  1756:     addx.b  D1,D0   ; ADC RoomId
02:000410CC 7600            	  1757:     moveq   #0,D3
02:000410CE 1600            	  1758:     move.b  D0,D3
02:000410D0 61004588        	  1759:     jsr     IsDarkRoom_Bank5
02:000410D4 6602            	  1760:     bne.s  __far_z_05_0031
02:000410D6 601E            	  1761:     jmp  InitMode4_GoToSub0
                            	  1762: __far_z_05_0031:
                            	  1763:     ; The previous room was dark.
                            	  1764:     ;
02:000410D8 102C051F        	  1765:     move.b  ($051F,A4),D0
02:000410DC 6702            	  1766:     beq.s  __far_z_05_0032
02:000410DE 6016            	  1767:     jmp  InitMode4_GoToSub0
                            	  1768: __far_z_05_0032:
02:000410E0 103C00C0        	  1769:     move.b  #$C0,D0
                            	  1770: ; Params:
                            	  1771: ; A: start index of cycle
                            	  1772: ;
                            	  1773:     even
