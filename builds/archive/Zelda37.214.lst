                            	   779: UpdateBlock0Idle:
                            	   780:     ; If there are monsters in the room, go reset the push timer and return.
                            	   781:     ;
02:00039A72 102C034D        	   782:     move.b  ($034D,A4),D0
02:00039A76 6604            	   783:     bne.s  __far_z_04_0005
02:00039A78 600000DA        	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0005:
                            	   786:     ; If Link's X is aligned with the block's, then get the difference
                            	   787:     ; between Link's (Y + 3) and the block's Y.
                            	   788:     ; Then go test the difference.
                            	   789:     ;
02:00039A7C 102C0070        	   790:     move.b  ($0070,A4),D0
02:00039A80 12342070        	   791:     move.b  ($70,A4,D2.W),D1
02:00039A84 B001            	   792:     cmp.b   D1,D0
02:00039A86 6628            	   793:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039A88 7600            	   794:     moveq   #0,D3
02:00039A8A 102C0084        	   795:     move.b  ($0084,A4),D0
02:00039A8E 023C00EE        	   796:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039A92 123C0003        	   797:     move.b  #$03,D1
02:00039A96 D101            	   798:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039A98 003C0011        	   799:     ori     #$11,CCR  ; SEC: set C+X
02:00039A9C 41EC0084        	   800:     lea     ($0084,A4),A0
02:00039AA0 12302000        	   801:     move.b  (A0,D2.W),D1
02:00039AA4 0A3C0010        	   802:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039AA8 9101            	   803:     subx.b  D1,D0   ; SBC ObjY,X
02:00039AAA 0A3C0010        	   804:     eori    #$10,CCR  ; restore X = 6502 C
02:00039AAE 6036            	   805:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   806: 
                            	   807:     even
                            	   808: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   809:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   810:     ; go reset the push timer.
                            	   811:     ;
02:00039AB0 102C0084        	   812:     move.b  ($0084,A4),D0
02:00039AB4 023C00EE        	   813:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039AB8 123C0003        	   814:     move.b  #$03,D1
02:00039ABC D101            	   815:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039ABE 41EC0084        	   816:     lea     ($0084,A4),A0
02:00039AC2 12302000        	   817:     move.b  (A0,D2.W),D1
02:00039AC6 B001            	   818:     cmp.b   D1,D0
02:00039AC8 6704            	   819:     beq.s  __far_z_04_0006
02:00039ACA 60000088        	   820:     jmp  ResetPushTimer
                            	   821: __far_z_04_0006:
                            	   822:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   823:     ; Get the difference in X.
                            	   824:     ;
02:00039ACE 7602            	   825:     moveq   #2,D3
02:00039AD0 102C0070        	   826:     move.b  ($0070,A4),D0
02:00039AD4 003C0011        	   827:     ori     #$11,CCR  ; SEC: set C+X
02:00039AD8 12342070        	   828:     move.b  ($70,A4,D2.W),D1
02:00039ADC 0A3C0010        	   829:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039AE0 9101            	   830:     subx.b  D1,D0   ; SBC ObjX,X
02:00039AE2 0A3C0010        	   831:     eori    #$10,CCR  ; restore X = 6502 C
                            	   832:     even
                            	   833: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   834:     ; If the difference in coordinates is negative, then Link is
                            	   835:     ; up or left of the block.
                            	   836:     ;
                            	   837:     ; In that case, increase Y register to index the correct opposite
                            	   838:     ; direction below. Also, negate the difference, so we test
                            	   839:     ; positive values.
                            	   840:     ;
02:00039AE6 6A08            	   841:     bpl  _anon_z04_14
02:00039AE8 5203            	   842:     addq.b  #1,D3
02:00039AEA 4EB900030920    	   843:     jsr     Negate
                            	   844: _anon_z04_14:
                            	   845:     ; If the distance >= $11, then go reset the push timer and return.
                            	   846:     ;
02:00039AF0 0C000011        	   847:     cmpi.b  #$11,D0
02:00039AF4 6502            	   848:     bcs.s  __far_z_04_0007
02:00039AF6 605C            	   849:     jmp  ResetPushTimer
                            	   850: __far_z_04_0007:
                            	   851:     ; At this point, Link is aligned with the block.
                            	   852:     ;
                            	   853:     ; If the input direction is not the required direction based on
                            	   854:     ; Link's placement; then go reset the push timer and return.
                            	   855:     ;
02:00039AF8 102C03F8        	   856:     move.b  ($03F8,A4),D0
02:00039AFC 41F900039A50    	   857:     lea     (BlockPushDirections).l,A0
02:00039B02 12303000        	   858:     move.b  (A0,D3.W),D1
02:00039B06 B001            	   859:     cmp.b   D1,D0
02:00039B08 6702            	   860:     beq.s  __far_z_04_0008
02:00039B0A 6048            	   861:     jmp  ResetPushTimer
                            	   862: __far_z_04_0008:
                            	   863:     ; Link is truly pushing the block.
                            	   864:     ;
                            	   865:     ; Increase the push timer.
                            	   866:     ;
02:00039B0C 41EC0412        	   867:     lea     ($0412,A4),A0
02:00039B10 52302000        	   868:     addq.b  #1,(A0,D2.W)
                            	   869:     ; If the push timer still < $10, return.
                            	   870:     ;
02:00039B14 7600            	   871:     moveq   #0,D3
02:00039B16 41EC0412        	   872:     lea     ($0412,A4),A0
02:00039B1A 16302000        	   873:     move.b  (A0,D2.W),D3
02:00039B1E 0C030010        	   874:     cmpi.b  #$10,D3
02:00039B22 6402            	   875:     bcc.s  __far_z_04_0009
02:00039B24 6034            	   876:     jmp  L10262_Exit
