                            	  2375:     ;
02:0004B12E 102C0005        	  2376:     move.b  ($0005,A4),D0
02:0004B132 41EC0305        	  2377:     lea     ($0305,A4),A0
02:0004B136 11802000        	  2378:     move.b  D0,(A0,D2.W)
02:0004B13A 41EC0306        	  2379:     lea     ($0306,A4),A0
02:0004B13E 11802000        	  2380:     move.b  D0,(A0,D2.W)
02:0004B142 41EC030A        	  2381:     lea     ($030A,A4),A0
02:0004B146 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B14A 41EC030B        	  2383:     lea     ($030B,A4),A0
02:0004B14E 11802000        	  2384:     move.b  D0,(A0,D2.W)
                            	  2385:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
