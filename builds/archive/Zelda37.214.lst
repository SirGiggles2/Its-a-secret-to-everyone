                            	  6038:     ; If timer has not expired, then
                            	  6039:     ; go see if it's time to propagate direction changes down the chain.
                            	  6040:     ;
02:0003C018 10342028        	  6041:     move.b  ($28,A4,D2.W),D0
02:0003C01C 6702            	  6042:     beq.s  __far_z_04_0045
02:0003C01E 6032            	  6043:     jmp  Moldorm_PropagateDirs
                            	  6044: __far_z_04_0045:
                            	  6045:     even
                            	  6046: Moldorm_ChangeFlyingState:
                            	  6047:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  6048:     ;
02:0003C020 61000096        	  6049:     jsr     Flyer_MoldormDecideState
02:0003C024 7010            	  6050:     moveq   #16,D0
02:0003C026 19802028        	  6051:     move.b  D0,($28,A4,D2.W)
                            	  6052:     ; If the next lower slot's direction <> 0, then
                            	  6053:     ; go propagate direction changes down the chain.
                            	  6054:     ;
                            	  6055:     ; But you had to have propagated directions once for the
                            	  6056:     ; next lower direction to be set. How does it happen?
                            	  6057:     ;
                            	  6058:     ; Within a flyer state, the flying routines turn the flyer
                            	  6059:     ; and set the object timer to $10 several times. After any of
                            	  6060:     ; those times will the test succeed.
                            	  6061:     ;
                            	  6062:     ; When a flying state ends, timer will be 0, triggering the code
                            	  6063:     ; in this block to set the timer to $10, and try to propagate
                            	  6064:     ; directions.
                            	  6065:     ;
                            	  6066:     ; But this is also the case the first time here.
                            	  6067:     ;
                            	  6068:     ; So, I believe that the point of this test is to delay moving
                            	  6069:     ; the lower (not head) segments when starting out.
                            	  6070:     ;
02:0003C02A 41EC0097        	  6071:     lea     ($0097,A4),A0
02:0003C02E 10302000        	  6072:     move.b  (A0,D2.W),D0
02:0003C032 6702            	  6073:     beq.s  __far_z_04_0046
02:0003C034 601C            	  6074:     jmp  Moldorm_PropagateDirs
                            	  6075: __far_z_04_0046:
02:0003C036 4E75            	  6076:     rts
                            	  6077: 
                            	  6078:     even
                            	  6079: Moldorm_Wander:
                            	  6080:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6081:     ; Only the head controls the movement direction.
                            	  6082:     ;
02:0003C038 0C020005        	  6083:     cmpi.b  #$05,D2
02:0003C03C 6708            	  6084:     beq  _anon_z04_82
02:0003C03E 0C02000A        	  6085:     cmpi.b  #$0A,D2
02:0003C042 6702            	  6086:     beq.s  __far_z_04_0047
