02:0003AF4C 023C00EE        	  3718:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF50 41EC03E4        	  3719:     lea     ($03E4,A4),A0
02:0003AF54 12302000        	  3720:     move.b  (A0,D2.W),D1
02:0003AF58 D101            	  3721:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AF5A 1B00            	  3722:     move.b  D0,-(A5)  ; PHA
