                            	  5366: _L_z02_DrawCredits_IncVramLine:
02:000368D4 522C050D        	  5367:     addq.b  #1,($050D,A4)
                            	  5368:     ; In each VRAM page there are 8 lines, except in ones where
                            	  5369:     ; (page MOD 4) = 3. This means $23xx and $2Bxx.
                            	  5370:     ; These pages have 6 lines.
                            	  5371:     ;
02:000368D8 102C050C        	  5372:     move.b  ($050C,A4),D0
02:000368DC 02000003        	  5373:     andi.b #$03,D0
02:000368E0 0C000003        	  5374:     cmpi.b  #$03,D0
02:000368E4 7008            	  5375:     moveq   #8,D0
02:000368E6 6502            	  5376:     bcs  _anon_z02_49
02:000368E8 7006            	  5377:     moveq   #6,D0
                            	  5378: _anon_z02_49:
                            	  5379:     ; If the VRAM line number has not just been incremented to
                            	  5380:     ; the reference line number count, then go write NT attributes.
                            	  5381:     ;
02:000368EA 122C050D        	  5382:     move.b  ($050D,A4),D1
02:000368EE B001            	  5383:     cmp.b   D1,D0
02:000368F0 661C            	  5384:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5385:     ; Else roll over the VRAM line to 0.
                            	  5386:     ;
