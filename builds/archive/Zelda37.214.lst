                            	  5387: _L_z07_SpreadShot_NextCorner:
                            	  5388:     ; Prepare to process the next corner.
                            	  5389:     ;
                            	  5390:     ; First, restore X offset [02] and Y offset [03].
                            	  5391:     ;
02:0004C680 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C682 19400003        	  5393:     move.b  D0,($0003,A4)
02:0004C686 101D            	  5394:     move.b  (A5)+,D0  ; PLA
02:0004C688 19400002        	  5395:     move.b  D0,($0002,A4)
                            	  5396:     ; Take turns negating X offset or Y offset for the next round.
                            	  5397:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5398:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5399:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5400:     ; - Fourth turn: doesn't matter
                            	  5401:     ;
                            	  5402:     ;
                            	  5403:     ; Get the loop index.
02:0004C68C 101D            	  5404:     move.b  (A5)+,D0  ; PLA
02:0004C68E 1B00            	  5405:     move.b  D0,-(A5)  ; PHA
02:0004C690 7600            	  5406:     moveq   #0,D3
02:0004C692 1600            	  5407:     move.b  D0,D3
02:0004C694 0C030001        	  5408:     cmpi.b  #$01,D3
02:0004C698 6602            	  5409:     bne  _anon_z07_25
02:0004C69A 7603            	  5410:     moveq   #3,D3
                            	  5411: _anon_z07_25:
02:0004C69C 10343000        	  5412:     move.b  ($00,A4,D3.W),D0
