                            	 11944:     ;
02:0003EB98 19400011        	 11945:     move.b  D0,($0011,A4)
02:0003EB9C 19400013        	 11946:     move.b  D0,($0013,A4)
02:0003EBA0 194000AC        	 11947:     move.b  D0,($00AC,A4)
