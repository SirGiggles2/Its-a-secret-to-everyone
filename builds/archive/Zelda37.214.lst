02:0003A3FE 19400002        	  2106:     move.b  D0,($0002,A4)
02:0003A402 19802070        	  2107:     move.b  D0,($70,A4,D2.W)
                            	  2108:     ; Look up and set the Y coordinate for the fireball object.
                            	  2109:     ; Also store it in [03].
                            	  2110:     ;
02:0003A406 41F90003A320    	  2111:     lea     (StatueYs).l,A0
02:0003A40C 10303000        	  2112:     move.b  (A0,D3.W),D0
02:0003A410 19400003        	  2113:     move.b  D0,($0003,A4)
02:0003A414 41EC0084        	  2114:     lea     ($0084,A4),A0
02:0003A418 11802000        	  2115:     move.b  D0,(A0,D2.W)
                            	  2116:     ; Set mask value 3 in [04].
