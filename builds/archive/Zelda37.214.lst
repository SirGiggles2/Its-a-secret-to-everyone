02:0003B96C 41F90003B79E    	  5206:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003B972 10303000        	  5207:     move.b  (A0,D3.W),D0
02:0003B976 0200000F        	  5208:     andi.b #$0F,D0
