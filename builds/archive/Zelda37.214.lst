                            	  3642:     ; If the octorock is slow, then use q-speed $20.
                            	  3643:     ; Else double it.
                            	  3644:     ;
02:0003AED0 7020            	  3645:     moveq   #32,D0
02:0003AED2 7600            	  3646:     moveq   #0,D3
02:0003AED4 41EC034F        	  3647:     lea     ($034F,A4),A0
02:0003AED8 16302000        	  3648:     move.b  (A0,D2.W),D3
02:0003AEDC 0C030007        	  3649:     cmpi.b  #$07,D3
02:0003AEE0 6708            	  3650:     beq  _L_z04_UpdateOctorock_Shoot
02:0003AEE2 0C030009        	  3651:     cmpi.b  #$09,D3
02:0003AEE6 6702            	  3652:     beq  _L_z04_UpdateOctorock_Shoot
02:0003AEE8 E308            	  3653:     lsl.b  #1,D0   ; ASL A
                            	  3654:     even
                            	  3655: _L_z04_UpdateOctorock_Shoot:
                            	  3656:     ; Shoot a flying rock (object type $53).
                            	  3657:     ;
02:0003AEEA 7653            	  3658:     moveq   #83,D3
02:0003AEEC 6100F706        	  3659:     jsr     _TryShooting
02:0003AEF0 4EB90004D2CE    	  3660:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3661:     ; If facing down, then use frame image offset 2.
                            	  3662:     ;
02:0003AEF6 41EC0098        	  3663:     lea     ($0098,A4),A0
02:0003AEFA 10302000        	  3664:     move.b  (A0,D2.W),D0
02:0003AEFE 7600            	  3665:     moveq   #0,D3
02:0003AF00 1600            	  3666:     move.b  D0,D3
02:0003AF02 0200000C        	  3667:     andi.b #$0C,D0
02:0003AF06 670C            	  3668:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AF08 7002            	  3669:     moveq   #2,D0
02:0003AF0A 0C030008        	  3670:     cmpi.b  #$08,D3
02:0003AF0E 6610            	  3671:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3672:     ; Else facing up. Use frame image offset 1.
                            	  3673:     ;
02:0003AF10 7001            	  3674:     moveq   #1,D0
