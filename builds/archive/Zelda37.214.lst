02:0002E626 0200000F        	  1788:     andi.b #$0F,D0
02:0002E62A 003C0011        	  1789:     ori     #$11,CCR  ; SEC: set C+X
02:0002E62E 123C0001        	  1790:     move.b  #$01,D1
02:0002E632 0A3C0010        	  1791:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E636 9101            	  1792:     subx.b  D1,D0   ; SBC #$01
02:0002E638 0A3C0010        	  1793:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1794:     ; If the result is negative, then make the full hearts 0.
                            	  1795:     ;
02:0002E63C 6A02            	  1796:     bpl  _anon_z01_19
02:0002E63E 7000            	  1797:     moveq   #0,D0
