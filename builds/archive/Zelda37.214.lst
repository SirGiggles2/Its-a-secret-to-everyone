                            	  7691: PlayParryTune:
02:0003202A 7001            	  7692:     moveq   #1,D0
02:0003202C 19400604        	  7693:     move.b  D0,($0604,A4)
                            	  7694:     even
                            	  7695: L763A_Exit:
02:00032030 4E75            	  7696:     rts
                            	  7697: 
                            	  7698: ; Params:
                            	  7699: ; A: damage points
                            	  7700: ; X: monster object slot
                            	  7701: ; [00]: weapon object slot
                            	  7702: ; [02]: monster object mid X
                            	  7703: ; [03]: monster object mid Y
                            	  7704: ; [09]: damage type
                            	  7705: ; [0D]: horizontal threshold
                            	  7706: ;
                            	  7707: ; Returns:
                            	  7708: ; [06]: 1 if objects collide
                            	  7709: ; [07]: damage points
                            	  7710: ; [0E]: vertical threshold
                            	  7711: ;
                            	  7712:     even
                            	  7713: CheckMonsterSlenderWeaponCollision:
02:00032032 19400007        	  7714:     move.b  D0,($0007,A4)
02:00032036 102C000D        	  7715:     move.b  ($000D,A4),D0
02:0003203A 1940000E        	  7716:     move.b  D0,($000E,A4)
                            	  7717: ; Params:
                            	  7718: ; X: monster object slot
                            	  7719: ; [00]: weapon object slot
                            	  7720: ; [02]: monster object mid X
                            	  7721: ; [03]: monster object mid Y
                            	  7722: ; [07]: damage points
                            	  7723: ; [09]: damage type
                            	  7724: ; [0D]: horizontal threshold
                            	  7725: ; [0E]: vertical threshold
                            	  7726: ;
                            	  7727: ; Returns:
                            	  7728: ; [06]: 1 if objects collide
                            	  7729: ;
                            	  7730:     even
                            	  7731: CheckMonsterSlenderWeaponCollision2:
02:0003203E 7600            	  7732:     moveq   #0,D3
02:00032040 1614            	  7733:     move.b  ($0000,A4),D3
                            	  7734:     ; If Link is facing vertically, then:
                            	  7735:     ; [04] := (weapon X + 6)
                            	  7736:     ; A    := (weapon Y + 8)
                            	  7737:     ;
                            	  7738:     ; Shouldn't it be based on the weapon's direction?
                            	  7739:     ;
02:00032042 102C0098        	  7740:     move.b  ($0098,A4),D0
02:00032046 0200000C        	  7741:     andi.b #$0C,D0
02:0003204A 6726            	  7742:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:0003204C 10343070        	  7743:     move.b  ($70,A4,D3.W),D0
02:00032050 023C00EE        	  7744:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032054 123C0006        	  7745:     move.b  #$06,D1
02:00032058 D101            	  7746:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:0003205A 19400004        	  7747:     move.b  D0,($0004,A4)
02:0003205E 41EC0084        	  7748:     lea     ($0084,A4),A0
02:00032062 10303000        	  7749:     move.b  (A0,D3.W),D0
02:00032066 023C00EE        	  7750:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003206A 123C0008        	  7751:     move.b  #$08,D1
02:0003206E D101            	  7752:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00032070 6024            	  7753:     jmp     _anon_z01_98
                            	  7754: 
                            	  7755:     even
                            	  7756: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7757:     ; Else Link is facing horizontally.
                            	  7758:     ; [04] := (weapon X + 8)
                            	  7759:     ; A    := (weapon Y + 6)
                            	  7760:     ;
                            	  7761:     ; Shouldn't it be based on the weapon's direction?
                            	  7762:     ;
02:00032072 10343070        	  7763:     move.b  ($70,A4,D3.W),D0
02:00032076 023C00EE        	  7764:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003207A 123C0008        	  7765:     move.b  #$08,D1
02:0003207E D101            	  7766:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00032080 19400004        	  7767:     move.b  D0,($0004,A4)
02:00032084 41EC0084        	  7768:     lea     ($0084,A4),A0
02:00032088 10303000        	  7769:     move.b  (A0,D3.W),D0
02:0003208C 023C00EE        	  7770:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032090 123C0006        	  7771:     move.b  #$06,D1
02:00032094 D101            	  7772:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7773: _anon_z01_98:
                            	  7774:     ; The A register will be copied to [05] and used here.
                            	  7775:     ;
02:00032096 6000FC08        	  7776:     jmp     CheckMonsterWeaponCollision
                            	  7777: 
                            	  7778: ; Params:
                            	  7779: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7780: ; [00]: weapon object slot (unused)
                            	  7781: ; [02]: object 1 mid X
                            	  7782: ; [03]: object 1 mid Y
                            	  7783: ; [04]: object 2 mid X
                            	  7784: ; [05]: object 2 mid Y
                            	  7785: ;
                            	  7786: ; Returns:
                            	  7787: ; A: 1 if objects collide
                            	  7788: ; Y: weapon object slot
                            	  7789: ; Z: 0 if objects collide
                            	  7790: ; [06]: 1 if objects collide
                            	  7791: ; [0A]: horizontal distance
                            	  7792: ; [0B]: vertical distance
                            	  7793: ;
                            	  7794: ;
                            	  7795: ; Use the same threshold value horizontally and vertically.
                            	  7796: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7797: ;
                            	  7798:     even
                            	  7799: DoObjectsCollide:
02:0003209A 1940000D        	  7800:     move.b  D0,($000D,A4)
02:0003209E 1940000E        	  7801:     move.b  D0,($000E,A4)
                            	  7802: ; Params:
                            	  7803: ; [00]: weapon or Link object slot (unused)
                            	  7804: ; [02]: object 1 mid X
                            	  7805: ; [03]: object 1 mid Y
                            	  7806: ; [04]: object 2 mid X
                            	  7807: ; [05]: object 2 mid Y
                            	  7808: ; [0D]: horizontal threshold
                            	  7809: ; [0E]: vertical threshold
                            	  7810: ;
                            	  7811: ; Returns:
                            	  7812: ; A: 1 if objects collide
                            	  7813: ; Y: weapon or Link object slot (copied from [00])
                            	  7814: ; Z: 0 if objects collide
                            	  7815: ; [06]: 1 if objects collide
                            	  7816: ; [0A]: horizontal distance
                            	  7817: ; [0B]: vertical distance
                            	  7818: ;
                            	  7819: ;
                            	  7820: ; Reset [06] to indicate no collision by default.
                            	  7821: ;
                            	  7822:     even
                            	  7823: DoObjectsCollideWithThresholds:
02:000320A2 7000            	  7824:     moveq   #0,D0
02:000320A4 19400006        	  7825:     move.b  D0,($0006,A4)
02:000320A8 7600            	  7826:     moveq   #0,D3
02:000320AA 1614            	  7827:     move.b  ($0000,A4),D3
                            	  7828:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7829:     ;
02:000320AC 102C0002        	  7830:     move.b  ($0002,A4),D0
02:000320B0 003C0011        	  7831:     ori     #$11,CCR  ; SEC: set C+X
02:000320B4 122C0004        	  7832:     move.b  ($0004,A4),D1
02:000320B8 0A3C0010        	  7833:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320BC 9101            	  7834:     subx.b  D1,D0   ; SBC $04
02:000320BE 0A3C0010        	  7835:     eori    #$10,CCR  ; restore X = 6502 C
02:000320C2 6100E85A        	  7836:     jsr     Abs
02:000320C6 1940000A        	  7837:     move.b  D0,($000A,A4)
                            	  7838:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7839:     ;
02:000320CA 122C000D        	  7840:     move.b  ($000D,A4),D1
02:000320CE B001            	  7841:     cmp.b   D1,D0
02:000320D0 642A            	  7842:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7843:     ; Store in [0B] the vertical distance between the two objects.
                            	  7844:     ;
02:000320D2 102C0003        	  7845:     move.b  ($0003,A4),D0
02:000320D6 003C0011        	  7846:     ori     #$11,CCR  ; SEC: set C+X
02:000320DA 122C0005        	  7847:     move.b  ($0005,A4),D1
02:000320DE 0A3C0010        	  7848:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320E2 9101            	  7849:     subx.b  D1,D0   ; SBC $05
02:000320E4 0A3C0010        	  7850:     eori    #$10,CCR  ; restore X = 6502 C
02:000320E8 6100E834        	  7851:     jsr     Abs
02:000320EC 1940000B        	  7852:     move.b  D0,($000B,A4)
                            	  7853:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7854:     ;
02:000320F0 122C000E        	  7855:     move.b  ($000E,A4),D1
02:000320F4 B001            	  7856:     cmp.b   D1,D0
02:000320F6 6404            	  7857:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7858:     ; If we get here, then the objects are close enough in both axes.
                            	  7859:     ; Return 1.
                            	  7860:     ;
02:000320F8 522C0006        	  7861:     addq.b  #1,($0006,A4)
                            	  7862:     even
                            	  7863: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:000320FC 102C0006        	  7864:     move.b  ($0006,A4),D0
02:00032100 4E75            	  7865:     rts
                            	  7866: 
                            	  7867: ; Params:
                            	  7868: ; X: caller's object index, a monster
                            	  7869: ;    the attacker, if monster attacks Link
                            	  7870: ;    else defender, if weapon attacks monster
                            	  7871: ; [00]: 0 if monster attacks Link (defender),
                            	  7872: ;       else weapon slot (attacker)
                            	  7873: ; [09]: damage type,
                            	  7874: ;       only if a monster is defending
                            	  7875: ; TODO:
                            	  7876: ; [0B]: direction
                            	  7877: ;
                            	  7878: ; Only monsters (and fire) call this routine.
                            	  7879: ;
                            	  7880: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7881: ;
                            	  7882: ; On the other hand, if a weapon attacks a monster,
                            	  7883: ; the monster sets [00] to the weapon's slot.
                            	  7884: ;
                            	  7885: ;
                            	  7886: ; If a weapon attacks a monster, and the weapon's damage
                            	  7887: ; type matches the monster's invincibility mask;
                            	  7888: ; then return without shoving.
                            	  7889: ;
                            	  7890: ; If a monster attacks Link, then damage type will be 0.
                            	  7891: ;
                            	  7892:     even
                            	  7893: BeginShove:
02:00032102 7600            	  7894:     moveq   #0,D3
02:00032104 1614            	  7895:     move.b  ($0000,A4),D3
02:00032106 0C02000D        	  7896:     cmpi.b  #$0D,D2
02:0003210A 6412            	  7897:     bcc  _anon_z01_99
02:0003210C 41EC04B2        	  7898:     lea     ($04B2,A4),A0
02:00032110 10302000        	  7899:     move.b  (A0,D2.W),D0
02:00032114 122C0009        	  7900:     move.b  ($0009,A4),D1
02:00032118 C001            	  7901:     and.b  D1,D0
02:0003211A 660000C4        	  7902:     bne  _L_z01_BeginShove_Exit
                            	  7903: _anon_z01_99:
                            	  7904:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7905:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7906:     ;
                            	  7907:     ; If instead a monster is defending, then all this calculation
                            	  7908:     ; won't matter, because the shove direction will be set to the
                            	  7909:     ; weapon's direction.
                            	  7910:     ;
                            	  7911:     ; As such, calculate a direction from the monster to the defender,
                            	  7912:     ; assuming it's Link.
                            	  7913:     ;
                            	  7914:     ; Start with an assumption that the direction is vertical:
                            	  7915:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7916:     ;
02:0003211E 7008            	  7917:     moveq   #8,D0
02:00032120 19400008        	  7918:     move.b  D0,($0008,A4)
02:00032124 41EC0084        	  7919:     lea     ($0084,A4),A0
02:00032128 10302000        	  7920:     move.b  (A0,D2.W),D0
02:0003212C 19400004        	  7921:     move.b  D0,($0004,A4)
02:00032130 41EC0084        	  7922:     lea     ($0084,A4),A0
02:00032134 10303000        	  7923:     move.b  (A0,D3.W),D0
02:00032138 19400005        	  7924:     move.b  D0,($0005,A4)
                            	  7925:     ; If the defender is Link and his grid offset <> 0 then
                            	  7926:     ; use his usual object direction variable to determine
                            	  7927:     ; which axis to check.
                            	  7928:     ;
02:0003213C 4A03            	  7929:     cmpi.b  #$00,D3
02:0003213E 6612            	  7930:     bne  _anon_z01_100
02:00032140 102C0394        	  7931:     move.b  ($0394,A4),D0
02:00032144 670C            	  7932:     beq  _anon_z01_100
02:00032146 102C0098        	  7933:     move.b  ($0098,A4),D0
02:0003214A 02000003        	  7934:     andi.b #$03,D0
02:0003214E 660C            	  7935:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032150 6720            	  7936:     beq  _L_z01_BeginShove_CheckVertical
                            	  7937: _anon_z01_100:
                            	  7938:     ; For monsters defending, or Link with grid offset = 0,
                            	  7939:     ; check direction in [0B].
                            	  7940:     ;
                            	  7941:     ; For monsters defending, this won't matter. For Link with grid
                            	  7942:     ; offset = 0, I believe the result will be arbitrary.
                            	  7943:     ;
                            	  7944:     ; TODO:
                            	  7945:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7946:     ; It doesn't seem to be if candle fire attacks him.
                            	  7947:     ;
02:00032152 102C000B        	  7948:     move.b  ($000B,A4),D0
02:00032156 0C000004        	  7949:     cmpi.b  #$04,D0
02:0003215A 6416            	  7950:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7951:     even
                            	  7952: _L_z01_BeginShove_CheckHorizontal:
                            	  7953:     ; If the direction checked is left or right,
                            	  7954:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7955:     ;
02:0003215C 7002            	  7956:     moveq   #2,D0
02:0003215E 19400008        	  7957:     move.b  D0,($0008,A4)
02:00032162 10342070        	  7958:     move.b  ($70,A4,D2.W),D0
02:00032166 19400004        	  7959:     move.b  D0,($0004,A4)
02:0003216A 10343070        	  7960:     move.b  ($70,A4,D3.W),D0
02:0003216E 19400005        	  7961:     move.b  D0,($0005,A4)
                            	  7962:     even
                            	  7963: _L_z01_BeginShove_CheckVertical:
                            	  7964:     ; If the monster is down or right of the other object,
                            	  7965:     ; then use the opposite direction already in [08].
                            	  7966:     ; Else shift [08] right to turn it into the opposite
                            	  7967:     ; direction up or down.
                            	  7968:     ;
                            	  7969:     ; Again assuming Link is the defender; after this, [08] points
                            	  7970:     ; Link away from the monster.
                            	  7971:     ;
02:00032172 102C0004        	  7972:     move.b  ($0004,A4),D0
02:00032176 122C0005        	  7973:     move.b  ($0005,A4),D1
02:0003217A B001            	  7974:     cmp.b   D1,D0
02:0003217C 640A            	  7975:     bcc  _anon_z01_101
02:0003217E 122C0008        	  7976:     move.b  ($0008,A4),D1
02:00032182 E209            	  7977:     lsr.b  #1,D1   ; LSR $08
02:00032184 19410008        	  7978:     move.b  D1,($0008,A4)
                            	  7979: _anon_z01_101:
                            	  7980:     ; If a monster is the defender, go handle it separately.
                            	  7981:     ;
02:00032188 4A03            	  7982:     cmpi.b  #$00,D3
02:0003218A 6656            	  7983:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7984:     ; Link is the defender.
                            	  7985:     ;
                            	  7986:     ; If Link is invincible, return without shoving.
                            	  7987:     ;
02:0003218C 102C04F0        	  7988:     move.b  ($04F0,A4),D0
02:00032190 664E            	  7989:     bne  _L_z01_BeginShove_Exit
                            	  7990:     ; Store the shove direction we determined.
                            	  7991:     ;
