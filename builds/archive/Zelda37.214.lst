                            	  7591: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7592:     ; If the "monsters from edges" long timer expired, then
                            	  7593:     ; go bring the monster in.
                            	  7594:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7595:     ;
                            	  7596:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7597:     ; residual position so enemies keep their previous-room
                            	  7598:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D6C8 102C004B        	  7599:     move.b  ($004B,A4),D0
02:0004D6CC 662E            	  7600:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7601:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D6CE 102C000F        	  7602:     move.b  ($000F,A4),D0
02:0004D6D2 0C0000FF        	  7603:     cmpi.b  #$FF,D0
02:0004D6D6 662E            	  7604:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D6D8 41EC0070        	  7605:     lea     ($0070,A4),A0
02:0004D6DC 10302000        	  7606:     move.b  (A0,D2.W),D0
02:0004D6E0 660A            	  7607:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D6E2 41EC0084        	  7608:     lea     ($0084,A4),A0
02:0004D6E6 10302000        	  7609:     move.b  (A0,D2.W),D0
02:0004D6EA 671A            	  7610:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7611:     even
