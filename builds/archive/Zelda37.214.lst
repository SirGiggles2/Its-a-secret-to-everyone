                            	  8590: 
                            	  8591: ; Description:
                            	  8592: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8593: ; When walking, the object timer is set. When teleporting,
                            	  8594: ; the teleporting distance remaining is set.
                            	  8595: ;
                            	  8596: ; If we have the magic clock, then only go draw and check collisions.
                            	  8597: ;
                            	  8598:     even
                            	  8599: UpdateBlueWizzrobe:
02:0003D29C 102C066C        	  8600:     move.b  ($066C,A4),D0
02:0003D2A0 6702            	  8601:     beq.s  __far_z_04_0075
02:0003D2A2 6014            	  8602:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8603: __far_z_04_0075:
02:0003D2A4 6116            	  8604:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D2A6 61000334        	  8605:     jsr     BlueWizzrobe_TryShooting
                            	  8606:     even
                            	  8607: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8608:     ; If the teleporting distance remaining is even, then draw
                            	  8609:     ; and check collisions, else return.
                            	  8610:     ;
                            	  8611:     ; This means that when 0, the monster is walking.
                            	  8612:     ; So, draw and check collisions every frame.
                            	  8613:     ;
                            	  8614:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8615:     ; translucently -- every other frame.
                            	  8616:     ;
02:0003D2AA 41EC0394        	  8617:     lea     ($0394,A4),A0
02:0003D2AE 10302000        	  8618:     move.b  (A0,D2.W),D0
02:0003D2B2 E208            	  8619:     lsr.b  #1,D0   ; LSR A
02:0003D2B4 6402            	  8620:     bcc.s  __far_z_04_0076
02:0003D2B6 603A            	  8621:     jmp  L11E17_Exit
                            	  8622: __far_z_04_0076:
                            	  8623:     even
                            	  8624: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D2B8 600004FA        	  8625:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8626: 
                            	  8627:     even
                            	  8628: BlueWizzrobe_WalkOrTeleport:
                            	  8629:     ; If timer has not expired, then go walk.
                            	  8630:     ;
02:0003D2BC 10342028        	  8631:     move.b  ($28,A4,D2.W),D0
02:0003D2C0 661C            	  8632:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8633:     ; Timer = 0. Only teleporting now.
                            	  8634:     ;
                            	  8635:     ; If there is still distance to go while translucent, then
                            	  8636:     ; decrement the distance remaining, and move.
                            	  8637:     ;
02:0003D2C2 41EC0394        	  8638:     lea     ($0394,A4),A0
02:0003D2C6 10302000        	  8639:     move.b  (A0,D2.W),D0
02:0003D2CA 670A            	  8640:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D2CC 41EC0394        	  8641:     lea     ($0394,A4),A0
02:0003D2D0 53302000        	  8642:     subq.b  #1,(A0,D2.W)
02:0003D2D4 602A            	  8643:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8644: 
                            	  8645:     even
                            	  8646: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8647:     ; Distance remaining = 0. Still teleporting.
                            	  8648:     ;
02:0003D2D6 6100021A        	  8649:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003D2DA 600000B0        	  8650:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8651: 
                            	  8652:     even
                            	  8653: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8654:     ; Timer:
                            	  8655:     ;   >= $10: Turn if needed and move every other frame
                            	  8656:     ;   > 1:    Do nothing
                            	  8657:     ;   = 1:    Choose a place to teleport to.
