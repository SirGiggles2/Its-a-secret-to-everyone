                            	  2425: _L_z04__TryShooting_TryShootingNow:
                            	  2426:     ; Summary
                            	  2427:     ;
                            	  2428:     ; if temporarily invincible then
                            	  2429:     ;   shoot timer := 0
                            	  2430:     ; elif shoot timer > 0 then
                            	  2431:     ;   decrement shoot timer
                            	  2432:     ; elif wants to shoot then
                            	  2433:     ;   shoot timer := $30
                            	  2434:     ;
                            	  2435:     ; qspeed := [01]
                            	  2436:     ;
                            	  2437:     ; if shoot timer <> 0 then
                            	  2438:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2439:     ;     shoot
                            	  2440:     ;     if succeeded then
                            	  2441:     ;       shoot timer := 0
                            	  2442:     ;       qspeed := 0
                            	  2443:     ;   else
                            	  2444:     ;     qspeed := 0
                            	  2445:     ;
                            	  2446:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A62C 102C0001        	  2447:     move.b  ($0001,A4),D0
02:0003A630 1883            	  2448:     move.b  D3,($0000,A4)
02:0003A632 1B00            	  2449:     move.b  D0,-(A5)  ; PHA
02:0003A634 7600            	  2450:     moveq   #0,D3
                            	  2451:     ; If not temporarily invincible,
                            	  2452:     ;
02:0003A636 41EC04F0        	  2453:     lea     ($04F0,A4),A0
02:0003A63A 10302000        	  2454:     move.b  (A0,D2.W),D0
02:0003A63E 661A            	  2455:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2456:     ; then Y := shoot timer - 1
                            	  2457:     ;
02:0003A640 7600            	  2458:     moveq   #0,D3
02:0003A642 41EC0451        	  2459:     lea     ($0451,A4),A0
02:0003A646 16302000        	  2460:     move.b  (A0,D2.W),D3
02:0003A64A 5303            	  2461:     subq.b  #1,D3
                            	  2462:     ; If Y register < 0, then shoot timer is 0.
                            	  2463:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2464:     ; Else go set a non-zero speed and return.
                            	  2465:     ;
02:0003A64C 6A0C            	  2466:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A64E 41EC0412        	  2467:     lea     ($0412,A4),A0
02:0003A652 10302000        	  2468:     move.b  (A0,D2.W),D0
02:0003A656 6736            	  2469:     beq  _L_z04__TryShooting_SetSpeed
02:0003A658 7630            	  2470:     moveq   #48,D3
                            	  2471:     even
