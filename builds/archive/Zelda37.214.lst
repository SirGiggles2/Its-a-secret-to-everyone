02:0003EBF8 0C020005        	 11999:     cmpi.b  #$05,D2
02:0003EBFC 6706            	 12000:     beq  _anon_z04_150
02:0003EBFE 0C02000A        	 12001:     cmpi.b  #$0A,D2
