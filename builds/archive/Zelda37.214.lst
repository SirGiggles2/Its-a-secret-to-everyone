02:00033458 122C000A        	   556:     move.b  ($0A,A4),D1   ; ptr lo
02:0003345C 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:00033460 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033464 E14C            	   559:     lsl.w   #8,D4
02:00033466 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033468 48C4            	   561:     ext.l   D4
02:0003346A D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033470 2044            	   563:     movea.l D4,A0
