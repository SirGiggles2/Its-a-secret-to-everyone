                            	  8136: UpdatePolsVoiceState1_Jumping:
                            	  8137:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8138:     ;
02:0003CED0 41EC0444        	  8139:     lea     ($0444,A4),A0
02:0003CED4 10302000        	  8140:     move.b  (A0,D2.W),D0
