                            	   312: UpdateMenuScrollDownOW:
02:000401D6 61004D86        	   313:     jsr     Submenu_CueTransferRowOW
02:000401DA 6004            	   314:     jmp     _anon_z05_2
                            	   315: 
                            	   316:     even
                            	   317: UpdateMenuScrollDownUW:
02:000401DC 61004D10        	   318:     jsr     Submenu_CueTransferRowUW
                            	   319: _anon_z05_2:
                            	   320:     ; Move position markers and advance nametable scrolling;
                            	   321:     ; so that we scroll down 3 pixels.
                            	   322:     ;
02:000401E0 7003            	   323:     moveq   #3,D0
02:000401E2 6100015C        	   324:     jsr     MovePositionMarkers
02:000401E6 102C00FC        	   325:     move.b  ($00FC,A4),D0
02:000401EA 003C0011        	   326:     ori     #$11,CCR  ; SEC: set C+X
02:000401EE 123C0003        	   327:     move.b  #$03,D1
02:000401F2 0A3C0010        	   328:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000401F6 9101            	   329:     subx.b  D1,D0   ; SBC #$03
02:000401F8 0A3C0010        	   330:     eori    #$10,CCR  ; restore X = 6502 C
02:000401FC 194000FC        	   331:     move.b  D0,($00FC,A4)
                            	   332:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   333:     ;
02:00040200 0C000041        	   334:     cmpi.b  #$41,D0
02:00040204 66000090        	   335:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   336:     ; VScroll reached $41.
                            	   337:     ; Advance the submenu state.
                            	   338:     ; If in OW or in a cellar, we're done. Return.
                            	   339:     ;
02:00040208 522C00E1        	   340:     addq.b  #1,($00E1,A4)
02:0004020C 102C0010        	   341:     move.b  ($0010,A4),D0
02:00040210 67000084        	   342:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:00040214 102C0012        	   343:     move.b  ($0012,A4),D0
02:00040218 0C000009        	   344:     cmpi.b  #$09,D0
02:0004021C 6778            	   345:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   346:     ; Calculate the X coordinate of the submenu position marker.
                            	   347:     ;
                            	   348:     ; First, mask off the high nibble of the room ID and multiply by
                            	   349:     ; the width of a tile, 8. Store the result in [00].
                            	   350:     ;
02:0004021E 102C00EB        	   351:     move.b  ($00EB,A4),D0
02:00040222 0200000F        	   352:     andi.b #$0F,D0
02:00040226 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:00040228 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:0004022A E308            	   355:     lsl.b  #1,D0   ; ASL A
02:0004022C 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   358:     ; negative or left rotation by ($10 - rotation value).
                            	   359:     ;
                            	   360:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   361:     ; the width of a tile. Then negate it. The final result is the
                            	   362:     ; negative offset.
                            	   363:     ;
02:0004022E 103900FF6BAB    	   364:     move.b  (NES_SRAM+$0BAB).l,D0
02:00040234 0C000008        	   365:     cmpi.b  #$08,D0
02:00040238 6520            	   366:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:0004023A 7010            	   367:     moveq   #16,D0
02:0004023C 123900FF6BAB    	   368:     move.b  (NES_SRAM+$0BAB).l,D1
02:00040242 0A3C0010        	   369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040246 9101            	   370:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:00040248 0A3C0010        	   371:     eori    #$10,CCR  ; restore X = 6502 C
02:0004024C E308            	   372:     lsl.b  #1,D0   ; ASL A
02:0004024E E308            	   373:     lsl.b  #1,D0   ; ASL A
02:00040250 E308            	   374:     lsl.b  #1,D0   ; ASL A
02:00040252 4EB900030920    	   375:     jsr     Negate
02:00040258 6006            	   376:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   377: 
                            	   378:     even
                            	   379: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   380:     ; The submenu map's rotation < 8.
                            	   381:     ; It represents the number of tiles to move right.
                            	   382:     ; So, multiply it by 8.
                            	   383:     ;
02:0004025A E308            	   384:     lsl.b  #1,D0   ; ASL A
02:0004025C E308            	   385:     lsl.b  #1,D0   ; ASL A
02:0004025E E308            	   386:     lsl.b  #1,D0   ; ASL A
                            	   387:     even
                            	   388: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   389:     ; Add the offset we calculated, and $62 to [00] to get
                            	   390:     ; the position marker's X coordinate.
                            	   391:     ;
02:00040260 023C00EE        	   392:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040264 1214            	   393:     move.b  ($0000,A4),D1
02:00040266 D101            	   394:     addx.b  D1,D0   ; ADC $00
02:00040268 023C00EE        	   395:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004026C 123C0062        	   396:     move.b  #$62,D1
02:00040270 D101            	   397:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040272 19400253        	   398:     move.b  D0,($0253,A4)
                            	   399:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   400:     ; Divide by 2 to get a multiple of the tile height.
                            	   401:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   402:     ;
02:00040276 102C00EB        	   403:     move.b  ($00EB,A4),D0
02:0004027A 020000F0        	   404:     andi.b #$F0,D0
02:0004027E E208            	   405:     lsr.b  #1,D0   ; LSR A
02:00040280 123C0069        	   406:     move.b  #$69,D1
02:00040284 D101            	   407:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040286 19400250        	   408:     move.b  D0,($0250,A4)
                            	   409:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   410:     ;
02:0004028A 703E            	   411:     moveq   #62,D0
02:0004028C 19400251        	   412:     move.b  D0,($0251,A4)
02:00040290 7000            	   413:     moveq   #0,D0
02:00040292 19400252        	   414:     move.b  D0,($0252,A4)
                            	   415:     even
                            	   416: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040296 4E75            	   417:     rts
                            	   418: 
                            	   419:     even
                            	   420: UpdateMenuActive:
02:00040298 610053D6        	   421:     jsr     DrawSubmenuItems
02:0004029C 6100549A        	   422:     jsr     UpdateSubmenuSelection
                            	   423:     ; If buttons Up and A are down on the second controller, then
                            	   424:     ; 1. reset submenu state
                            	   425:     ; 2. go to mode 8
                            	   426:     ; 3. silence sound
                            	   427:     ;
02:000402A0 102C00FB        	   428:     move.b  ($00FB,A4),D0
02:000402A4 02000088        	   429:     andi.b #$88,D0
02:000402A8 0C000088        	   430:     cmpi.b  #$88,D0
02:000402AC 661A            	   431:     bne  _anon_z05_3
02:000402AE 4EB90004B66E    	   432:     jsr     EndGameMode
02:000402B4 194000E1        	   433:     move.b  D0,($00E1,A4)
02:000402B8 7008            	   434:     moveq   #8,D0
02:000402BA 19400012        	   435:     move.b  D0,($0012,A4)
02:000402BE 7000            	   436:     moveq   #0,D0
02:000402C0 19400619        	   437:     move.b  D0,($0619,A4)
02:000402C4 600013A0        	   438:     jmp     SilenceSound
