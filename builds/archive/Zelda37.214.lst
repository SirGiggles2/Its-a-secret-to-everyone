                            	  3499:     ; and pick up whatever the new value is for state 1.
                            	  3500:     ;
02:0003ADAC 7001            	  3501:     moveq   #1,D0
02:0003ADAE 41EC03D0        	  3502:     lea     ($03D0,A4),A0
