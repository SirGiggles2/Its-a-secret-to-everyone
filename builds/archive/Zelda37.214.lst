                            	   195: InitCave:
                            	   196:     ; The person goes at location ($78, $80).
                            	   197:     ;
02:0002DB14 7078            	   198:     moveq   #120,D0
02:0002DB16 163C0080        	   199:     move.b  #$80,D3
02:0002DB1A 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
                            	   203:     ;
02:0002DB1E 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DB22 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DB26 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DB28 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DB2C 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DB2E 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DB32 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DB34 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DB38 6502            	   212:     bcs.s  __far_z_01_0000
02:0002DB3A 6012            	   213:     jmp  InitCaveContinue
                            	   214: __far_z_01_0000:
                            	   215:     even
                            	   216: _L_z01_InitCave_TakeType:
                            	   217:     ; Else the cave/person simply does:
                            	   218:     ; - taken:     no person, no text
                            	   219:     ; - not taken: show a person and text
                            	   220:     ;
                            	   221:     ; So, if the item was not taken, then go set up the text.
                            	   222:     ;
02:0002DB3C 61003304        	   223:     jsr     GetRoomFlagUWItemState
02:0002DB40 6602            	   224:     bne.s  __far_z_01_0001
02:0002DB42 600A            	   225:     jmp  InitCaveContinue
                            	   226: __far_z_01_0001:
                            	   227:     ; Otherwise destroy the person object, and let Link continue.
                            	   228:     ;
02:0002DB44 7000            	   229:     moveq   #0,D0
02:0002DB46 19400350        	   230:     move.b  D0,($0350,A4)
                            	   231:     even
                            	   232: UnhaltLink:
02:0002DB4A 6000DEA2        	   233:     jmp     c_unhalt_link
                            	   234: 
                            	   235: InitCaveContinue:
                            	   236:     ; Get this cave's index (object type - $6A).
                            	   237:     ;
02:0002DB4E 102C0350        	   238:     move.b  ($0350,A4),D0
02:0002DB52 003C0011        	   239:     ori     #$11,CCR  ; SEC: set C+X
02:0002DB56 123C006A        	   240:     move.b  #$6A,D1
02:0002DB5A 0A3C0010        	   241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DB5E 9101            	   242:     subx.b  D1,D0   ; SBC #$6A
02:0002DB60 0A3C0010        	   243:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DB64 7600            	   244:     moveq   #0,D3
02:0002DB66 1600            	   245:     move.b  D0,D3
                            	   246:     ; Get the person text selector by looking up the text selector byte
                            	   247:     ; for this index, and masking it with $3F.
                            	   248:     ;
02:0002DB68 41F90002DAE6    	   249:     lea     (OverworldPersonTextSelectors).l,A0
02:0002DB6E 10303000        	   250:     move.b  (A0,D3.W),D0
02:0002DB72 1B00            	   251:     move.b  D0,-(A5)  ; PHA
02:0002DB74 0200003F        	   252:     andi.b #$3F,D0
02:0002DB78 19400415        	   253:     move.b  D0,($0415,A4)
                            	   254:     ; Pop and mask the text selector byte with $C0 to get the
                            	   255:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   256:     ;
02:0002DB7C 101D            	   257:     move.b  (A5)+,D0  ; PLA
02:0002DB7E 020000C0        	   258:     andi.b #$C0,D0
02:0002DB82 19400003        	   259:     move.b  D0,($0003,A4)
                            	   260:     ; At this point, the Y register still has the cave index.
                            	   261:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   262:     ;
02:0002DB86 103C00FD        	   263:     move.b  #$FD,D0
                            	   264: _anon_z01_0:
02:0002DB8A 023C00EE        	   265:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DB8E 123C0003        	   266:     move.b  #$03,D1
02:0002DB92 D101            	   267:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002DB94 5303            	   268:     subq.b  #1,D3
02:0002DB96 6AF2            	   269:     bpl  _anon_z01_0
02:0002DB98 7600            	   270:     moveq   #0,D3
02:0002DB9A 1600            	   271:     move.b  D0,D3
                            	   272:     ; Loop over the wares from 0 to 2.
                            	   273:     ;
02:0002DB9C 7400            	   274:     moveq   #0,D2
                            	   275:     even
                            	   276: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   277:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   278:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   279:     ;
02:0002DB9E 41F900FF6A7E    	   280:     lea     (NES_SRAM+$0A7E).l,A0
02:0002DBA4 10303000        	   281:     move.b  (A0,D3.W),D0
02:0002DBA8 41EC0422        	   282:     lea     ($0422,A4),A0
02:0002DBAC 11802000        	   283:     move.b  D0,(A0,D2.W)
                            	   284:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   285:     ;
02:0002DBB0 020000C0        	   286:     andi.b #$C0,D0
02:0002DBB4 19802000        	   287:     move.b  D0,($00,A4,D2.W)
                            	   288:     ; Copy 3 prices from the Cave level block info.
                            	   289:     ;
02:0002DBB8 41F900FF6ABA    	   290:     lea     (NES_SRAM+$0ABA).l,A0
02:0002DBBE 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002DBC2 41EC0430        	   292:     lea     ($0430,A4),A0
02:0002DBC6 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Bottom of the wares copying loop.
                            	   295:     ;
02:0002DBCA 5203            	   296:     addq.b  #1,D3
02:0002DBCC 5202            	   297:     addq.b  #1,D2
02:0002DBCE 0C020003        	   298:     cmpi.b  #$03,D2
02:0002DBD2 66CA            	   299:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   300:     ; Get the top 2 bits of text selector byte in [03],
                            	   301:     ; shift them to the bottom, and combine them with [00].
                            	   302:     ;
02:0002DBD4 102C0003        	   303:     move.b  ($0003,A4),D0
02:0002DBD8 E308            	   304:     lsl.b  #1,D0   ; ASL A
02:0002DBDA E310            	   305:     roxl.b  #1,D0   ; ROL A
02:0002DBDC E310            	   306:     roxl.b  #1,D0   ; ROL A
02:0002DBDE 1214            	   307:     move.b  ($0000,A4),D1
02:0002DBE0 8001            	   308:     or.b  D1,D0
02:0002DBE2 1880            	   309:     move.b  D0,($0000,A4)
                            	   310:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   311:     ; and combine them with [00].
                            	   312:     ;
02:0002DBE4 102C0002        	   313:     move.b  ($0002,A4),D0
02:0002DBE8 E208            	   314:     lsr.b  #1,D0   ; LSR A
02:0002DBEA E208            	   315:     lsr.b  #1,D0   ; LSR A
02:0002DBEC E208            	   316:     lsr.b  #1,D0   ; LSR A
02:0002DBEE E208            	   317:     lsr.b  #1,D0   ; LSR A
02:0002DBF0 1214            	   318:     move.b  ($0000,A4),D1
02:0002DBF2 8001            	   319:     or.b  D1,D0
02:0002DBF4 1880            	   320:     move.b  D0,($0000,A4)
                            	   321:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   322:     ; and combine them with [00] into CaveFlags.
                            	   323:     ;
02:0002DBF6 102C0001        	   324:     move.b  ($0001,A4),D0
02:0002DBFA E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002DBFC E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002DBFE 1214            	   327:     move.b  ($0000,A4),D1
02:0002DC00 8001            	   328:     or.b  D1,D0
02:0002DC02 19400413        	   329:     move.b  D0,($0413,A4)
                            	   330:     ; The end result is a byte with 8 cave flags.
                            	   331:     ;
                            	   332:     ; If cave flag "money game" is missing, then go finish up,
                            	   333:     ; instead of choosing random amounts for the money game.
                            	   334:     ;
02:0002DC06 02000020        	   335:     andi.b #$20,D0
02:0002DC0A 6700009E        	   336:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   337:     ; Determine an index randomly with increasing probability,
                            	   338:     ; from 6 to 1. Start with the following test:
                            	   339:     ;
                            	   340:     ;   If $FF < Random, then go use index 6.
                            	   341:     ;
02:0002DC0E 103C00FF        	   342:     move.b  #$FF,D0
02:0002DC12 7606            	   343:     moveq   #6,D3
                            	   344:     even
                            	   345: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002DC14 122C0019        	   346:     move.b  ($0019,A4),D1
02:0002DC18 B001            	   347:     cmp.b   D1,D0
02:0002DC1A 6516            	   348:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   349:     ; If the test fails, then subtract $2B from the reference number.
                            	   350:     ;
02:0002DC1C 003C0011        	   351:     ori     #$11,CCR  ; SEC: set C+X
02:0002DC20 123C002B        	   352:     move.b  #$2B,D1
02:0002DC24 0A3C0010        	   353:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DC28 9101            	   354:     subx.b  D1,D0   ; SBC #$2B
02:0002DC2A 0A3C0010        	   355:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DC2E 5303            	   356:     subq.b  #1,D3
02:0002DC30 66E2            	   357:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   358:     even
