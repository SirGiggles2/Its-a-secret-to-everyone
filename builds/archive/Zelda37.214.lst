                            	 11306: _anon_z04_142:
02:0003E6A6 4EB90004BC32    	 11307:     jsr     ResetShoveInfo
                            	 11308:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11309:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11310:     ;
