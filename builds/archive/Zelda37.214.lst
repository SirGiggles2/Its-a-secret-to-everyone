02:0004D12C 0200000F        	  6897:     andi.b #$0F,D0
02:0004D130 0C000002        	  6898:     cmpi.b  #$02,D0
02:0004D134 6604            	  6899:     bne.s  __far_z_07_0119
02:0004D136 6000FF22        	  6900:     jmp  L1F95F_Exit
                            	  6901: __far_z_07_0119:
                            	  6902:     ; Otherwise, we drew one dust cloud. Go draw the others.
