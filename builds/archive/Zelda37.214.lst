02:00039F48 003C0011        	  1416:     ori     #$11,CCR  ; SEC: set C+X
02:00039F4C 123C002B        	  1417:     move.b  #$2B,D1
02:00039F50 0A3C0010        	  1418:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039F54 9101            	  1419:     subx.b  D1,D0   ; SBC #$2B
02:00039F56 0A3C0010        	  1420:     eori    #$10,CCR  ; restore X = 6502 C
02:00039F5A 6008            	  1421:     jmp     _L_z04_UpdateBubble_Animate
                            	  1422: 
