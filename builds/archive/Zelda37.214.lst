02:00040480 7008            	   673:     moveq   #8,D0
02:00040482 122C0098        	   674:     move.b  ($0098,A4),D1
02:00040486 C200            	   675:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040488 6602            	   676:     bne.s  __far_z_05_0008
02:0004048A 606E            	   677:     jmp  ScrollWorldDownOrH
                            	   678: __far_z_05_0008:
                            	   679:     ; then scroll up.
                            	   680:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   681:     ;
02:0004048C 532C00E9        	   682:     subq.b  #1,($00E9,A4)
02:00040490 102C0084        	   683:     move.b  ($0084,A4),D0
02:00040494 0C0000DD        	   684:     cmpi.b  #$DD,D0
02:00040498 640A            	   685:     bcc  _anon_z05_9
02:0004049A 123C0008        	   686:     move.b  #$08,D1
02:0004049E D101            	   687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000404A0 19400084        	   688:     move.b  D0,($0084,A4)
                            	   689: _anon_z05_9:
02:000404A4 102C00E2        	   690:     move.b  ($00E2,A4),D0
02:000404A8 003C0011        	   691:     ori     #$11,CCR  ; SEC: set C+X
02:000404AC 123C0020        	   692:     move.b  #$20,D1
02:000404B0 0A3C0010        	   693:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000404B4 9101            	   694:     subx.b  D1,D0   ; SBC #$20
02:000404B6 0A3C0010        	   695:     eori    #$10,CCR  ; restore X = 6502 C
02:000404BA 194000E2        	   696:     move.b  D0,($00E2,A4)
02:000404BE 6404            	   697:     bcc  _anon_z05_10
02:000404C0 532C0058        	   698:     subq.b  #1,($0058,A4)
                            	   699: _anon_z05_10:
02:000404C4 0C0000E0        	   700:     cmpi.b  #$E0,D0
02:000404C8 661E            	   701:     bne  _L_z05_ScrollWorld_Exit
02:000404CA 102C0058        	   702:     move.b  ($0058,A4),D0
02:000404CE 0C000020        	   703:     cmpi.b  #$20,D0
02:000404D2 6716            	   704:     beq  _L_z05_ScrollWorld_LimitLow
02:000404D4 0C000027        	   705:     cmpi.b  #$27,D0
02:000404D8 660E            	   706:     bne  _L_z05_ScrollWorld_Exit
