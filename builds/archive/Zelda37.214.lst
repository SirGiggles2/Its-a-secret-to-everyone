                            	  7509:     ; Metastate = $14
                            	  7510:     ;
                            	  7511:     ; Copy the object type, so that it can be used in setting up
                            	  7512:     ; a dropped item.
                            	  7513:     ;
02:0004D608 41EC034F        	  7514:     lea     ($034F,A4),A0
02:0004D60C 10302000        	  7515:     move.b  (A0,D2.W),D0
02:0004D610 41EC0412        	  7516:     lea     ($0412,A4),A0
02:0004D614 11802000        	  7517:     move.b  D0,(A0,D2.W)
                            	  7518:     ; Certain objects don't advance the world kill cycle.
