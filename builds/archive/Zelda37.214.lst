02:0003E6B0 670000DE        	 11312:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E6B4 6100AF5E        	 11313:     jsr     PlayBossHitCryIfNeeded
                            	 11314:     ; If this neck has not died, then go loop again.
                            	 11315:     ;
02:0003E6B8 41EC0405        	 11316:     lea     ($0405,A4),A0
02:0003E6BC 10302000        	 11317:     move.b  (A0,D2.W),D0
02:0003E6C0 670000D4        	 11318:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11319:     ; This neck died. So, prepare to make a flying head.
                            	 11320:     ;
02:0003E6C4 7060            	 11321:     moveq   #96,D0
02:0003E6C6 41EC0485        	 11322:     lea     ($0485,A4),A0
02:0003E6CA 11802000        	 11323:     move.b  D0,(A0,D2.W)
02:0003E6CE 1002            	 11324:     move.b  D2,D0
02:0003E6D0 1B00            	 11325:     move.b  D0,-(A5)  ; PHA
                            	 11326:     ; If the segment is not a head, then skip making a flying head.
                            	 11327:     ;
                            	 11328:     ; TODO:
                            	 11329:     ; But how can we get here in this case, since earlier branches
                            	 11330:     ; would have been taken to skip all this for all other segments?
                            	 11331:     ;
02:0003E6D2 0C020005        	 11332:     cmpi.b  #$05,D2
02:0003E6D6 663C            	 11333:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11334:     ; The flying head will go in slot (neck index + 7).
                            	 11335:     ; Switch the X register to it.
