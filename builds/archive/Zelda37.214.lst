                            	  1994: _L_z01_TransferDemoPatterns_LoopBlock:
                            	  1995:     ; Loop over each block.
                            	  1996:     ;
02:0002E7FA 102C051D        	  1997:     move.b  ($051D,A4),D0
02:0002E7FE E308            	  1998:     lsl.b  #1,D0   ; ASL A
02:0002E800 7400            	  1999:     moveq   #0,D2
02:0002E802 1400            	  2000:     move.b  D0,D2
                            	  2001:     ; Put block address in [00:01] and size in [03:02].
                            	  2002:     ; Load destination VRAM address and set it.
                            	  2003:     ; The size and VRAM address have the high byte first.
                            	  2004:     ;
