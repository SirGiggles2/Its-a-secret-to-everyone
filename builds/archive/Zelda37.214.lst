                            	  4008: FormatHeartsInTextBuf:
                            	  4009:     ; [$0E]: hearts value
                            	  4010:     ; [$0F]: heart partial
                            	  4011:     ; Y: The offset of first character in buffer
                            	  4012:     ;
                            	  4013:     ; The end of the bottom row is $12 bytes after the
                            	  4014:     ; start of the top row. We're writing to two transfer
                            	  4015:     ; records. We write the top row in the first transfer
                            	  4016:     ; record wherever the caller chooses. The second
                            	  4017:     ; transfer record has to begin with the heart tiles.
                            	  4018:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  4019:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  4020:     ;
                            	  4021:     ; Store the starting offset in [$0D].
02:000305C8 1943000D        	  4022:     move.b  D3,($000D,A4)
02:000305CC 102C000E        	  4023:     move.b  ($000E,A4),D0
02:000305D0 1B00            	  4024:     move.b  D0,-(A5)  ; PHA
02:000305D2 0200000F        	  4025:     andi.b #$0F,D0
02:000305D6 1880            	  4026:     move.b  D0,($0000,A4)
02:000305D8 700F            	  4027:     moveq   #15,D0
02:000305DA 003C0011        	  4028:     ori     #$11,CCR  ; SEC: set C+X
02:000305DE 1214            	  4029:     move.b  ($0000,A4),D1
02:000305E0 0A3C0010        	  4030:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000305E4 9101            	  4031:     subx.b  D1,D0   ; SBC $00
02:000305E6 0A3C0010        	  4032:     eori    #$10,CCR  ; restore X = 6502 C
02:000305EA 1880            	  4033:     move.b  D0,($0000,A4)
02:000305EC 101D            	  4034:     move.b  (A5)+,D0  ; PLA
02:000305EE E208            	  4035:     lsr.b  #1,D0   ; LSR A
02:000305F0 E208            	  4036:     lsr.b  #1,D0   ; LSR A
02:000305F2 E208            	  4037:     lsr.b  #1,D0   ; LSR A
02:000305F4 E208            	  4038:     lsr.b  #1,D0   ; LSR A
02:000305F6 19400001        	  4039:     move.b  D0,($0001,A4)
02:000305FA 700F            	  4040:     moveq   #15,D0
02:000305FC 003C0011        	  4041:     ori     #$11,CCR  ; SEC: set C+X
02:00030600 122C0001        	  4042:     move.b  ($0001,A4),D1
02:00030604 0A3C0010        	  4043:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030608 9101            	  4044:     subx.b  D1,D0   ; SBC $01
02:0003060A 0A3C0010        	  4045:     eori    #$10,CCR  ; restore X = 6502 C
02:0003060E 19400001        	  4046:     move.b  D0,($0001,A4)
                            	  4047:     ; At this point,
                            	  4048:     ; [$00] = $F - hearts
                            	  4049:     ; [$01] = $F - heart containers
                            	  4050:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  4051:     ;
                            	  4052:     ; Also, Y is still set to the value passed in.
                            	  4053:     ;
02:00030612 7400            	  4054:     moveq   #0,D2
02:00030614 1003            	  4055:     move.b  D3,D0
02:00030616 023C00EE        	  4056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003061A 123C0007        	  4057:     move.b  #$07,D1
02:0003061E D101            	  4058:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030620 1940000B        	  4059:     move.b  D0,($000B,A4)
                            	  4060:     ; Y keeps track of index of heart in row.
                            	  4061:     ; Start at the end of the first row.
02:00030624 7607            	  4062:     moveq   #7,D3
