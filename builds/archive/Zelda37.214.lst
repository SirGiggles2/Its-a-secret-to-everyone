02:0003CD14 7600            	  7910:     moveq   #0,D3
02:0003CD16 41EC03E4        	  7911:     lea     ($03E4,A4),A0
02:0003CD1A 16302000        	  7912:     move.b  (A0,D2.W),D3
02:0003CD1E 671E            	  7913:     beq  _anon_z04_95
02:0003CD20 023C00EE        	  7914:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD24 123C0003        	  7915:     move.b  #$03,D1
