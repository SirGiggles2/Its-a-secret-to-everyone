02:00030C32 662E            	  5042:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  5043:     ; The effect involves turning grayscale rendering on and off
                            	  5044:     ; in PPUMASK.
                            	  5045:     ;
                            	  5046:     ; Start by setting A register to the PPU mask shifted right to
                            	  5047:     ; throw away the grayscale bit.
                            	  5048:     ;
02:00030C34 102C00FE        	  5049:     move.b  ($00FE,A4),D0
02:00030C38 E208            	  5050:     lsr.b  #1,D0   ; LSR A
                            	  5051:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  5052:     ;
02:00030C3A 7600            	  5053:     moveq   #0,D3
02:00030C3C 16342028        	  5054:     move.b  ($28,A4,D2.W),D3
                            	  5055:     ; At times $16 and $11, rotate carry=1 to the low bit.
