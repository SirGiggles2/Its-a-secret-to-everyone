                            	 10049: Manhandla_Draw:
02:0003DD58 4EB90004D2CE    	 10050:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 10051:     ; Push the "frame image and sprite attributes" value.
                            	 10052:     ;
