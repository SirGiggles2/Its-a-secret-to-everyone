02:0004D2A2 10302000        	  7165:     move.b  (A0,D2.W),D0
02:0004D2A6 6702            	  7166:     beq  _anon_z07_37
02:0004D2A8 5203            	  7167:     addq.b  #1,D3
                            	  7168: _anon_z07_37:
02:0004D2AA 41EC0098        	  7169:     lea     ($0098,A4),A0
02:0004D2AE 10302000        	  7170:     move.b  (A0,D2.W),D0
02:0004D2B2 02000001        	  7171:     andi.b #$01,D0
02:0004D2B6 6604            	  7172:     bne  _anon_z07_38
02:0004D2B8 522C000F        	  7173:     addq.b  #1,($000F,A4)
