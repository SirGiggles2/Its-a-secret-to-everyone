02:0003DD66 1B00            	 10055:     move.b  D0,-(A5)  ; PHA
                            	 10056:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	 10057:     ; passed along as is.
                            	 10058:     ;
02:0003DD68 02000080        	 10059:     andi.b #$80,D0
02:0003DD6C 00000001        	 10060:     ori.b #$01,D0
