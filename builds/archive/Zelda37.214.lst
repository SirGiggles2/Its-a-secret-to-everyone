02:00045054 522C0057        	  8533:     addq.b  #1,($0057,A4)
                            	  8534:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8535:     ; object direction and input direction to last walkable direction
                            	  8536:     ; found, and set Link's speed.
                            	  8537:     ;
                            	  8538:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8539:     ;
02:00045058 7400            	  8540:     moveq   #0,D2
02:0004505A 102C000D        	  8541:     move.b  ($000D,A4),D0
