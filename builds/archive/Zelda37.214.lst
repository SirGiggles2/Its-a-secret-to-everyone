                            	  6188: __far_z_05_0094:
                            	  6189:     ; Turn the door command into the desired open or closed state
                            	  6190:     ; to store in [08].
                            	  6191:     ;
                            	  6192:     ; cmd:  7 6 3 2 
                            	  6193:     ; [08]: 2 0 0 0
                            	  6194:     ;
                            	  6195:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6196:     ; commands intended to be used.
                            	  6197:     ;
                            	  6198:     ; 3 is the end state of 2: close
                            	  6199:     ; 7 is the end state of 6: open
                            	  6200:     ;
02:00043AC4 02000007        	  6201:     andi.b #$07,D0
02:00043AC8 7601            	  6202:     moveq   #1,D3
02:00043ACA 19430002        	  6203:     move.b  D3,($0002,A4)
02:00043ACE 122C0002        	  6204:     move.b  ($0002,A4),D1
02:00043AD2 C200            	  6205:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043AD4 6702            	  6206:     beq  _anon_z05_118
02:00043AD6 E208            	  6207:     lsr.b  #1,D0   ; LSR A
                            	  6208: _anon_z05_118:
02:00043AD8 0C000002        	  6209:     cmpi.b  #$02,D0
02:00043ADC 6606            	  6210:     bne  _anon_z05_119
                            	  6211:     ; Command 2 sets Link's timer to $30.
                            	  6212:     ;
02:00043ADE 7630            	  6213:     moveq   #48,D3
02:00043AE0 19430028        	  6214:     move.b  D3,($0028,A4)
                            	  6215: _anon_z05_119:
02:00043AE4 02000003        	  6216:     andi.b #$03,D0
02:00043AE8 003C0011        	  6217:     ori     #$11,CCR  ; SEC: set C+X
02:00043AEC 123C0001        	  6218:     move.b  #$01,D1
02:00043AF0 0A3C0010        	  6219:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043AF4 9101            	  6220:     subx.b  D1,D0   ; SBC #$01
02:00043AF6 0A3C0010        	  6221:     eori    #$10,CCR  ; restore X = 6502 C
02:00043AFA 02000002        	  6222:     andi.b #$02,D0
02:00043AFE 19400008        	  6223:     move.b  D0,($0008,A4)
                            	  6224:     ; The command to close a key door or bombable wall does not
                            	  6225:     ; do anything.
                            	  6226:     ;
02:00043B02 102C0054        	  6227:     move.b  ($0054,A4),D0
02:00043B06 0C000005        	  6228:     cmpi.b  #$05,D0
02:00043B0A 6416            	  6229:     bcc  _anon_z05_120
02:00043B0C 102C0055        	  6230:     move.b  ($0055,A4),D0
02:00043B10 19400002        	  6231:     move.b  D0,($0002,A4)
02:00043B14 6100FAEC        	  6232:     jsr     FindDoorAttrByDoorBit
02:00043B18 0C000007        	  6233:     cmpi.b  #$07,D0
02:00043B1C 6704            	  6234:     beq  _anon_z05_120
02:00043B1E 6000009C        	  6235:     jmp     L_ResetDoorCmdAndLayOutDoors
