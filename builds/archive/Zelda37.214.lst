02:0003A3B2 1600            	  2069:     move.b  D0,D3
02:0003A3B4 41F90003A310    	  2070:     lea     (StatueFireballStartTimes).l,A0
02:0003A3BA 10303000        	  2071:     move.b  (A0,D3.W),D0
02:0003A3BE 41EC04E8        	  2072:     lea     ($04E8,A4),A0
02:0003A3C2 11802000        	  2073:     move.b  D0,(A0,D2.W)
                            	  2074:     ; The coordinate lists are divided into sets for each pattern.
                            	  2075:     ;
