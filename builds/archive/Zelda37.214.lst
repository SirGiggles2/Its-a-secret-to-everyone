02:00030ECE 003C0011        	  5401:     ori     #$11,CCR  ; SEC: set C+X
02:00030ED2 41EC0084        	  5402:     lea     ($0084,A4),A0
02:00030ED6 12302000        	  5403:     move.b  (A0,D2.W),D1
02:00030EDA 0A3C0010        	  5404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030EDE 9101            	  5405:     subx.b  D1,D0   ; SBC ObjY,X
02:00030EE0 0A3C0010        	  5406:     eori    #$10,CCR  ; restore X = 6502 C
02:00030EE4 6100FA38        	  5407:     jsr     Abs
02:00030EE8 0C000009        	  5408:     cmpi.b  #$09,D0
02:00030EEC 6504            	  5409:     bcs.s  __far_z_01_0038
