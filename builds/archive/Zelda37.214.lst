                            	  5576:     ; so that we keep processing the wall tile list.
02:0004368E 19400006        	  5577:     move.b  D0,($0006,A4)
02:00043692 7419            	  5578:     moveq   #25,D2
02:00043694 6704            	  5579:     beq.s  __far_z_05_0085
02:00043696 600000D8        	  5580:     jmp  MoveWallPtrs
