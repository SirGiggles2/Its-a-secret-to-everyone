02:0003DC88 122C0003        	  9967:     move.b  ($0003,A4),D1
02:0003DC8C D101            	  9968:     addx.b  D1,D0   ; ADC $03
02:0003DC8E 19802070        	  9969:     move.b  D0,($70,A4,D2.W)
                            	  9970:     even
