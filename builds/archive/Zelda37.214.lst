                            	  4568: _anon_z02_31:
02:000360C8 41F9000360A6    	  4569:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000360CE 10303000        	  4570:     move.b  (A0,D3.W),D0
02:000360D2 41EC0302        	  4571:     lea     ($0302,A4),A0
02:000360D6 11803000        	  4572:     move.b  D0,(A0,D3.W)
02:000360DA 5303            	  4573:     subq.b  #1,D3
02:000360DC 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:000360DE 102C045F        	  4579:     move.b  ($045F,A4),D0
02:000360E2 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:000360E6 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:000360EA 7000            	  4584:     moveq   #0,D0
02:000360EC 1880            	  4585:     move.b  D0,($0000,A4)
02:000360EE 7000            	  4586:     moveq   #0,D0
02:000360F0 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:000360F4 7600            	  4590:     moveq   #0,D3
02:000360F6 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:000360FA 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:000360FE 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:00036100 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:00036104 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036108 E14C            	  4601:     lsl.w   #8,D4
02:0003610A 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003610C 48C4            	  4603:     ext.l   D4
02:0003610E D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036114 2044            	  4605:     movea.l D4,A0
02:00036116 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:0003611A 0200003F        	  4611:     andi.b #$3F,D0
