02:0003AD42 163C00D8        	  3444:     move.b  #$D8,D3
                            	  3445: _anon_z04_45:
02:0003AD46 1883            	  3446:     move.b  D3,($0000,A4)
                            	  3447:     ; [01] holds Link's X coordinate.
                            	  3448:     ;
02:0003AD48 102C0070        	  3449:     move.b  ($0070,A4),D0
02:0003AD4C 19400001        	  3450:     move.b  D0,($0001,A4)
                            	  3451:     ; Add Link's X and the horizontal offset.
                            	  3452:     ;
02:0003AD50 023C00EE        	  3453:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD54 1214            	  3454:     move.b  ($0000,A4),D1
02:0003AD56 D101            	  3455:     addx.b  D1,D0   ; ADC $00
                            	  3456:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3457:     ;
02:0003AD58 020000F8        	  3458:     andi.b #$F8,D0
                            	  3459:     ; Assign that result to the leever's X coordinate and [02].
                            	  3460:     ;
02:0003AD5C 19802070        	  3461:     move.b  D0,($70,A4,D2.W)
02:0003AD60 19400002        	  3462:     move.b  D0,($0002,A4)
                            	  3463:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3464:     ;
02:0003AD64 122C0001        	  3465:     move.b  ($0001,A4),D1
02:0003AD68 B001            	  3466:     cmp.b   D1,D0
02:0003AD6A 6510            	  3467:     bcs  _L_z04_UpdateRedLeever_Subtract
