02:0003CBF6 1003            	  7761:     move.b  D3,D0
02:0003CBF8 1B00            	  7762:     move.b  D0,-(A5)  ; PHA
                            	  7763:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7764:     ;
02:0003CBFA 41F90003CB54    	  7765:     lea     (DodongoFrameHFlips).l,A0
02:0003CC00 10303000        	  7766:     move.b  (A0,D3.W),D0
02:0003CC04 1940000F        	  7767:     move.b  D0,($000F,A4)
02:0003CC08 41F90003CB4A    	  7768:     lea     (DodongoFrameImages).l,A0
02:0003CC0E 10303000        	  7769:     move.b  (A0,D3.W),D0
                            	  7770:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7771:     ; They are drawn mirrored.
