                            	  3431:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3432:     ; it's too close to the top edge of the screen. So, return.
                            	  3433:     ;
02:0003AD2C 0C00005D        	  3434:     cmpi.b  #$5D,D0
