02:000423BC 12303000        	  4419:     move.b  (A0,D3.W),D1
02:000423C0 B001            	  4420:     cmp.b   D1,D0
02:000423C2 6510            	  4421:     bcs  _anon_z05_95
02:000423C4 41F900042386    	  4422:     lea     (DoorwayBoundsMaxOver).l,A0
02:000423CA 12303000        	  4423:     move.b  (A0,D3.W),D1
02:000423CE B001            	  4424:     cmp.b   D1,D0
02:000423D0 65000082        	  4425:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4426: _anon_z05_95:
