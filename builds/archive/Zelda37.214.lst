02:0003CF78 123C0030        	  8200:     move.b  #$30,D1
02:0003CF7C D101            	  8201:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003CF7E 41EC0394        	  8202:     lea     ($0394,A4),A0
02:0003CF82 11802000        	  8203:     move.b  D0,(A0,D2.W)
                            	  8204:     ; Align the monster with a square horizontally.
                            	  8205:     ;
                            	  8206:     ; If in the left half of a square, align with that square.
                            	  8207:     ; If in the right half, align with the next square.
                            	  8208:     ;
02:0003CF86 10342070        	  8209:     move.b  ($70,A4,D2.W),D0
