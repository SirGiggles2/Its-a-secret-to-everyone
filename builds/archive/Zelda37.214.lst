                            	  7695:     ; In substate 0, go animate as usual for walking.
                            	  7696:     ;
02:0003CB94 7600            	  7697:     moveq   #0,D3
02:0003CB96 41EC042C        	  7698:     lea     ($042C,A4),A0
02:0003CB9A 16302000        	  7699:     move.b  (A0,D2.W),D3
