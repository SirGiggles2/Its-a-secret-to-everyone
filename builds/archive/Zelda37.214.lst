                            	   463: UpdateMenuScrollUp:
                            	   464:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   465:     ;
02:00040300 103C00FD        	   466:     move.b  #$FD,D0
02:00040304 613A            	   467:     jsr     MovePositionMarkers
02:00040306 102C00FC        	   468:     move.b  ($00FC,A4),D0
