                            	  1617: CreateChildGel:
02:0003A0C8 7014            	  1618:     moveq   #20,D0
                            	  1619:     ; Use the shooting operation to create the gel object.
                            	  1620:     ;
02:0003A0CA 1880            	  1621:     move.b  D0,($0000,A4)
02:0003A0CC 61005998        	  1622:     jsr     ShootLimited
                            	  1623:     ; Shots start in state $10. But Child Gel needs to start in state 0.
                            	  1624:     ;
02:0003A0D0 7000            	  1625:     moveq   #0,D0
02:0003A0D2 41EC00AC        	  1626:     lea     ($00AC,A4),A0
02:0003A0D6 11803000        	  1627:     move.b  D0,(A0,D3.W)
                            	  1628:     ; Give the child the same grid offset as the parent.
                            	  1629:     ;
02:0003A0DA 41EC0394        	  1630:     lea     ($0394,A4),A0
02:0003A0DE 10302000        	  1631:     move.b  (A0,D2.W),D0
02:0003A0E2 41EC0394        	  1632:     lea     ($0394,A4),A0
02:0003A0E6 11803000        	  1633:     move.b  D0,(A0,D3.W)
02:0003A0EA 4E75            	  1634:     rts
