                            	  4965: 
                            	  4966: ; Params:
                            	  4967: ; [02:03]: address of door tiles for direction and face
                            	  4968: ; [04]: count of tiles remaining
                            	  4969: ; [07]: current index (0 to 3) of the tile to copy
                            	  4970: ;       to the dynamic transfer buf
                            	  4971: ; [09]: door direction index
                            	  4972: ;
                            	  4973: ; Returns:
                            	  4974: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4975: ; [04]: original value - 1
                            	  4976: ; [07]: original value + 1
                            	  4977: ;
                            	  4978: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4979: ; vertically. The point of this routine is to access them
                            	  4980: ; horizontally in order to transfer them to a nametable.
                            	  4981: ;
                            	  4982: ;
                            	  4983: ; For the direction index in [09], look up the base offset of the
                            	  4984: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4985: ; the door face tiles at [02:03].
                            	  4986: ;
                            	  4987:     even
                            	  4988: WriteDoorFaceTileHorizontally:
02:00042874 7600            	  4989:     moveq   #0,D3
02:00042876 162C0009        	  4990:     move.b  ($0009,A4),D3
02:0004287A 41F900043A98    	  4991:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:00042880 10303000        	  4992:     move.b  (A0,D3.W),D0
                            	  4993:     ; Add [07] to the base offset we got above. This yields one
                            	  4994:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4995:     ;
02:00042884 023C00EE        	  4996:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042888 122C0007        	  4997:     move.b  ($0007,A4),D1
02:0004288C D101            	  4998:     addx.b  D1,D0   ; ADC $07
02:0004288E 7600            	  4999:     moveq   #0,D3
02:00042890 1600            	  5000:     move.b  D0,D3
                            	  5001:     ; With that index, look up the index to use with the door face
                            	  5002:     ; list of tiles at [02:03].
                            	  5003:     ;
02:00042892 41F900043A8A    	  5004:     lea     (HorizontalDoorFaceIndexes).l,A0
02:00042898 10303000        	  5005:     move.b  (A0,D3.W),D0
02:0004289C 7600            	  5006:     moveq   #0,D3
02:0004289E 1600            	  5007:     move.b  D0,D3
                            	  5008:     ; Now we can read one of four tiles inside a door face tile map,
                            	  5009:     ; and copy it to the dynamic transfer buf.
                            	  5010:     ;
02:000428A0 122C0002        	  5011:     move.b  ($02,A4),D1   ; ptr lo
02:000428A4 182C0003        	  5012:     move.b  ($03,A4),D4  ; ptr hi
02:000428A8 024100FF        	  5013:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000428AC E14C            	  5014:     lsl.w   #8,D4
02:000428AE 8841            	  5015:     or.w    D1,D4             ; D4 = NES ptr addr
02:000428B0 48C4            	  5016:     ext.l   D4
02:000428B2 D8BC00FF0000    	  5017:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000428B8 2044            	  5018:     movea.l D4,A0
02:000428BA 10303000        	  5019:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000428BE 41EC0302        	  5020:     lea     ($0302,A4),A0
02:000428C2 11802000        	  5021:     move.b  D0,(A0,D2.W)
                            	  5022:     ; Prepare for the next call:
                            	  5023:     ; - increment dynamic transfer buf pointer
                            	  5024:     ; - increment index of tile to copy [07]
                            	  5025:     ; - decrement count of tiles remaining
                            	  5026:     ;
02:000428C6 5202            	  5027:     addq.b  #1,D2
02:000428C8 522C0007        	  5028:     addq.b  #1,($0007,A4)
02:000428CC 532C0004        	  5029:     subq.b  #1,($0004,A4)
02:000428D0 4E75            	  5030:     rts
