02:0003C958 6034            	  7334:     jmp  L11989_Exit
                            	  7335: __far_z_04_0067:
                            	  7336:     ; Save the X coordinate.
                            	  7337:     ; Then add $10 to check the right-hand side.
                            	  7338:     ;
02:0003C95A 10342070        	  7339:     move.b  ($70,A4,D2.W),D0
02:0003C95E 1B00            	  7340:     move.b  D0,-(A5)  ; PHA
02:0003C960 023C00EE        	  7341:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C964 123C0010        	  7342:     move.b  #$10,D1
