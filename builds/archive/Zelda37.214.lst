02:000404DA 7023            	   710:     moveq   #35,D0
02:000404DC 19400058        	   711:     move.b  D0,($0058,A4)
02:000404E0 103C00A0        	   712:     move.b  #$A0,D0
02:000404E4 194000E2        	   713:     move.b  D0,($00E2,A4)
                            	   714:     even
