                            	  4327: 
                            	  4328: ; To be considered within a doorway, one condition is that
                            	  4329: ; Link's perpendicular coordinate ([00]) has to match the doorway's
                            	  4330: ; (X=$78 for verticals, Y=$8D for horizontals).
                            	  4331: ;
                            	  4332: ; See GetPlayerCoordsForDirection.
                            	  4333: ;
                            	  4334:     even
                            	  4335: DoorwayRequiredCoord:
02:0004237E 78              	  4336:     dc.b    $78, $78, $8D, $8D
02:0004237F 78
02:00042380 8D
02:00042381 8D
                            	  4337: 
                            	  4338: ; Player coordinate must be >= these bounds.
                            	  4339: ; Using these bounds; the player will be considered within the
                            	  4340: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4341: ;
                            	  4342:     even
                            	  4343: DoorwayBoundsMinOver:
02:00042382 3D              	  4344:     dc.b    $3D, $BD, $00, $CF
02:00042383 BD
02:00042384 00
02:00042385 CF
                            	  4345: 
                            	  4346: ; Player coordinate must be < these bounds.
                            	  4347: ; Using these bounds; the player will be considered within the
                            	  4348: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4349: ;
                            	  4350:     even
                            	  4351: DoorwayBoundsMaxOver:
02:00042386 5E              	  4352:     dc.b    $5E, $DE, $21, $F1
02:00042387 DE
02:00042388 21
02:00042389 F1
                            	  4353: 
                            	  4354: ; Player coordinate must be >= these bounds.
                            	  4355: ; Using these bounds; the player will be considered within the
                            	  4356: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4357: ; at the edge.
                            	  4358: ;
                            	  4359:     even
                            	  4360: DoorwayBoundsMinUnder:
02:0004238A 3D              	  4361:     dc.b    $3D, $BF, $00, $D2
02:0004238B BF
02:0004238C 00
02:0004238D D2
                            	  4362: 
                            	  4363: ; Player coordinate must be < these bounds.
                            	  4364: ; Using these bounds; the player will be considered within the
                            	  4365: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4366: ; at the edge.
                            	  4367: ;
                            	  4368:     even
                            	  4369: DoorwayBoundsMaxUnder:
02:0004238E 5C              	  4370:     dc.b    $5C, $DE, $1F, $F1
02:0004238F DE
02:00042390 1F
02:00042391 F1
                            	  4371: 
                            	  4372: ; Params:
                            	  4373: ; [0F]: moving direction
                            	  4374: ;
                            	  4375: ; Returns:
                            	  4376: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4377: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4378: ;
                            	  4379: ; When not at or in a doorway, this function leaves
                            	  4380: ; [0F] moving direction as is.
                            	  4381: ;
                            	  4382: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4383: ; will be left as is, assuming that it had been reset before this
                            	  4384: ; routine by BoundByRoom.
                            	  4385: ;
                            	  4386: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4387: ;
                            	  4388: ;
                            	  4389: ; If already in a doorway, go handle it separately.
                            	  4390: ;
                            	  4391:     even
                            	  4392: CheckDoorway:
02:00042392 102C0053        	  4393:     move.b  ($0053,A4),D0
02:00042396 6648            	  4394:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4395:     even
                            	  4396: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4397:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4398:     ;
                            	  4399:     ; To match a doorway:
                            	  4400:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4401:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4402:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4403:     ;
                            	  4404:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4405:     ; a doorway to be part of it.
                            	  4406:     ;
02:00042398 102C0098        	  4407:     move.b  ($0098,A4),D0
02:0004239C 61000122        	  4408:     jsr     GetPlayerCoordsForDirection
02:000423A0 7603            	  4409:     moveq   #3,D3
                            	  4410:     even
