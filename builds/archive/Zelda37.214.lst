02:0003CBAE 023C00EE        	  7714:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBB2 123C0014        	  7715:     move.b  #$14,D1
02:0003CBB6 D101            	  7716:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CBB8 7600            	  7717:     moveq   #0,D3
02:0003CBBA 1600            	  7718:     move.b  D0,D3
02:0003CBBC 6032            	  7719:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
