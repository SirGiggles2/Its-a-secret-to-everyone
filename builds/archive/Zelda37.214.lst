02:0003E776 123C0041        	 11408:     move.b  #$41,D1
02:0003E77A 0A3C0010        	 11409:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E77E 9101            	 11410:     subx.b  D1,D0   ; SBC #$41
02:0003E780 0A3C0010        	 11411:     eori    #$10,CCR  ; restore X = 6502 C
