02:0002DF7C 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
02:0002DF80 024100FF        	   825:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002DF84 E14C            	   826:     lsl.w   #8,D4
02:0002DF86 8841            	   827:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002DF88 48C4            	   828:     ext.l   D4
