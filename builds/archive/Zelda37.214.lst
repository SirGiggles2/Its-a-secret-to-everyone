02:0003DD78 1B00            	 10063:     move.b  D0,-(A5)  ; PHA
                            	 10064:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	 10065:     ;
02:0003DD7A 02000040        	 10066:     andi.b #$40,D0
02:0003DD7E 6704            	 10067:     beq  _anon_z04_116
02:0003DD80 522C000F        	 10068:     addq.b  #1,($000F,A4)
                            	 10069: _anon_z04_116:
02:0003DD84 101D            	 10070:     move.b  (A5)+,D0  ; PLA
                            	 10071:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	 10072:     ; These are the 2 frame images of the horizontal hands.
                            	 10073:     ;
                            	 10074:     ; Else draw the base and vertical hands mirrored.
                            	 10075:     ;
02:0003DD86 0200000F        	 10076:     andi.b #$0F,D0
02:0003DD8A 0C000002        	 10077:     cmpi.b  #$02,D0
02:0003DD8E 670C            	 10078:     beq  _anon_z04_117
02:0003DD90 0C000003        	 10079:     cmpi.b  #$03,D0
