                            	   194: UpdateMenuUW_JumpTable:
02:0004012A 000401B0        	   195:     dc.l    UpdateMenu_Return   ; jump table entry (32-bit for _m68k_tablejump)
02:0004012E 0004017C        	   196:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:00040132 000401B2        	   197:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:00040136 000401BE        	   198:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
