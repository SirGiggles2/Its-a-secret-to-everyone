02:0003BA62 19400070        	  5329:     move.b  D0,($0070,A4)
02:0003BA66 41EC0084        	  5330:     lea     ($0084,A4),A0
02:0003BA6A 10302000        	  5331:     move.b  (A0,D2.W),D0
02:0003BA6E 19400084        	  5332:     move.b  D0,($0084,A4)
02:0003BA72 4EB90004C1D8    	  5333:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BA78 4EB9000306AA    	  5334:     jsr     ShowLinkSpritesBehindHorizontalDoors
