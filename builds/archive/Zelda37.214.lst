02:00031FDE 41EC00AC        	  7653:     lea     ($00AC,A4),A0
02:00031FE2 11803000        	  7654:     move.b  D0,(A0,D3.W)
02:00031FE6 7003            	  7655:     moveq   #3,D0
02:00031FE8 41EC03D0        	  7656:     lea     ($03D0,A4),A0
02:00031FEC 11803000        	  7657:     move.b  D0,(A0,D3.W)
                            	  7658:     even
