02:0003DDC8 11802000        	 10110:     move.b  D0,(A0,D2.W)
                            	 10111:     ; Now we can go straight without changing direction for some time.
                            	 10112:     ;
02:0003DDCC 41EC0451        	 10113:     lea     ($0451,A4),A0
02:0003DDD0 52302000        	 10114:     addq.b  #1,(A0,D2.W)
                            	 10115:     ; Go animate the eye.
                            	 10116:     ;
02:0003DDD4 600000C6        	 10117:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	 10118: 
                            	 10119:     even
                            	 10120: _L_z04_UpdateGohma_Move:
                            	 10121:     ; Add $80 to the movement accumulator.
                            	 10122:     ;
02:0003DDD8 41EC041F        	 10123:     lea     ($041F,A4),A0
02:0003DDDC 10302000        	 10124:     move.b  (A0,D2.W),D0
02:0003DDE0 023C00EE        	 10125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDE4 123C0080        	 10126:     move.b  #$80,D1
02:0003DDE8 D101            	 10127:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DDEA 41EC041F        	 10128:     lea     ($041F,A4),A0
02:0003DDEE 11802000        	 10129:     move.b  D0,(A0,D2.W)
                            	 10130:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	 10131:     ;
02:0003DDF2 640000A8        	 10132:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	 10133:     ; Increase the distance traveled, and move 1.
                            	 10134:     ;
02:0003DDF6 41EC0412        	 10135:     lea     ($0412,A4),A0
02:0003DDFA 52302000        	 10136:     addq.b  #1,(A0,D2.W)
                            	 10137:     ; Set a direction mask in [02], starting with right (1).
                            	 10138:     ;
02:0003DDFE 7001            	 10139:     moveq   #1,D0
02:0003DE00 19400002        	 10140:     move.b  D0,($0002,A4)
                            	 10141:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	 10142:     ;
02:0003DE04 41EC0098        	 10143:     lea     ($0098,A4),A0
02:0003DE08 10302000        	 10144:     move.b  (A0,D2.W),D0
02:0003DE0C 122C0002        	 10145:     move.b  ($0002,A4),D1
02:0003DE10 C200            	 10146:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE12 6704            	 10147:     beq  _anon_z04_118
02:0003DE14 52342070        	 10148:     addq.b  #1,($70,A4,D2.W)
                            	 10149: _anon_z04_118:
                            	 10150:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	 10151:     ;
02:0003DE18 122C0002        	 10152:     move.b  ($0002,A4),D1
02:0003DE1C E309            	 10153:     lsl.b  #1,D1   ; ASL $02
02:0003DE1E 19410002        	 10154:     move.b  D1,($0002,A4)
02:0003DE22 122C0002        	 10155:     move.b  ($0002,A4),D1
02:0003DE26 C200            	 10156:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE28 6704            	 10157:     beq  _anon_z04_119
02:0003DE2A 53342070        	 10158:     subq.b  #1,($70,A4,D2.W)
                            	 10159: _anon_z04_119:
                            	 10160:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	 10161:     ;
02:0003DE2E 122C0002        	 10162:     move.b  ($0002,A4),D1
02:0003DE32 E309            	 10163:     lsl.b  #1,D1   ; ASL $02
02:0003DE34 19410002        	 10164:     move.b  D1,($0002,A4)
02:0003DE38 122C0002        	 10165:     move.b  ($0002,A4),D1
02:0003DE3C C200            	 10166:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE3E 6708            	 10167:     beq  _anon_z04_120
02:0003DE40 41EC0084        	 10168:     lea     ($0084,A4),A0
02:0003DE44 52302000        	 10169:     addq.b  #1,(A0,D2.W)
                            	 10170: _anon_z04_120:
                            	 10171:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	 10172:     ;
02:0003DE48 122C0002        	 10173:     move.b  ($0002,A4),D1
02:0003DE4C E309            	 10174:     lsl.b  #1,D1   ; ASL $02
02:0003DE4E 19410002        	 10175:     move.b  D1,($0002,A4)
02:0003DE52 122C0002        	 10176:     move.b  ($0002,A4),D1
02:0003DE56 C200            	 10177:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE58 6708            	 10178:     beq  _anon_z04_121
02:0003DE5A 41EC0084        	 10179:     lea     ($0084,A4),A0
02:0003DE5E 53302000        	 10180:     subq.b  #1,(A0,D2.W)
                            	 10181: _anon_z04_121:
                            	 10182:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10183:     ;
02:0003DE62 41EC0412        	 10184:     lea     ($0412,A4),A0
02:0003DE66 10302000        	 10185:     move.b  (A0,D2.W),D0
02:0003DE6A 0C000020        	 10186:     cmpi.b  #$20,D0
02:0003DE6E 662C            	 10187:     bne  _L_z04_UpdateGohma_AnimateEye
                            	 10188:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	 10189:     ; Reverse the facing direction, and increase the number of sprints.
                            	 10190:     ;
02:0003DE70 7000            	 10191:     moveq   #0,D0
02:0003DE72 41EC0412        	 10192:     lea     ($0412,A4),A0
02:0003DE76 11802000        	 10193:     move.b  D0,(A0,D2.W)
02:0003DE7A 61001E72        	 10194:     jsr     ReverseObjDir8
02:0003DE7E 41EC045E        	 10195:     lea     ($045E,A4),A0
02:0003DE82 10302000        	 10196:     move.b  (A0,D2.W),D0
02:0003DE86 41EC045E        	 10197:     lea     ($045E,A4),A0
02:0003DE8A 52302000        	 10198:     addq.b  #1,(A0,D2.W)
                            	 10199:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10200:     ; should randomly change direction.
                            	 10201:     ;
02:0003DE8E E208            	 10202:     lsr.b  #1,D0   ; LSR A
02:0003DE90 640A            	 10203:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DE92 7000            	 10204:     moveq   #0,D0
02:0003DE94 41EC0451        	 10205:     lea     ($0451,A4),A0
02:0003DE98 11802000        	 10206:     move.b  D0,(A0,D2.W)
                            	 10207:     even
                            	 10208: _L_z04_UpdateGohma_AnimateEye:
                            	 10209:     ; Animate the eye.
                            	 10210:     ;
                            	 10211:     ; First, if the counter for when to open the eye next = 0, then
                            	 10212:     ; set it to a random value at least $C0; and set the timer for
                            	 10213:     ; keeping the eye open to $80.
                            	 10214:     ;
                            	 10215:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10216:     ; every other frame.
                            	 10217:     ;
02:0003DE9C 41EC042C        	 10218:     lea     ($042C,A4),A0
02:0003DEA0 10302000        	 10219:     move.b  (A0,D2.W),D0
02:0003DEA4 661E            	 10220:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEA6 103C0080        	 10221:     move.b  #$80,D0
02:0003DEAA 41EC0444        	 10222:     lea     ($0444,A4),A0
02:0003DEAE 11802000        	 10223:     move.b  D0,(A0,D2.W)
02:0003DEB2 103C00C0        	 10224:     move.b  #$C0,D0
02:0003DEB6 12342018        	 10225:     move.b  ($18,A4,D2.W),D1
02:0003DEBA 8001            	 10226:     or.b  D1,D0
02:0003DEBC 41EC042C        	 10227:     lea     ($042C,A4),A0
02:0003DEC0 11802000        	 10228:     move.b  D0,(A0,D2.W)
                            	 10229:     even
                            	 10230: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10231:     ; Decrement the next-open-eye counter.
                            	 10232:     ;
02:0003DEC4 102C0015        	 10233:     move.b  ($0015,A4),D0
02:0003DEC8 E208            	 10234:     lsr.b  #1,D0   ; LSR A
02:0003DECA 6408            	 10235:     bcc  _anon_z04_122
02:0003DECC 41EC042C        	 10236:     lea     ($042C,A4),A0
02:0003DED0 53302000        	 10237:     subq.b  #1,(A0,D2.W)
                            	 10238: _anon_z04_122:
                            	 10239:     ; If open eye timer = 0, then the eye is closed.
                            	 10240:     ; Go animate it differently.
                            	 10241:     ;
02:0003DED4 41EC0444        	 10242:     lea     ($0444,A4),A0
02:0003DED8 10302000        	 10243:     move.b  (A0,D2.W),D0
02:0003DEDC 674A            	 10244:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10245:     ; Else decrement the open eye timer.
                            	 10246:     ;
02:0003DEDE 41EC0444        	 10247:     lea     ($0444,A4),A0
02:0003DEE2 53302000        	 10248:     subq.b  #1,(A0,D2.W)
                            	 10249:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10250:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10251:     ;
02:0003DEE6 7602            	 10252:     moveq   #2,D3
02:0003DEE8 0C000070        	 10253:     cmpi.b  #$70,D0
02:0003DEEC 6408            	 10254:     bcc  _anon_z04_123
02:0003DEEE 0C000010        	 10255:     cmpi.b  #$10,D0
02:0003DEF2 6502            	 10256:     bcs  _anon_z04_123
02:0003DEF4 5203            	 10257:     addq.b  #1,D3
                            	 10258: _anon_z04_123:
02:0003DEF6 1003            	 10259:     move.b  D3,D0
                            	 10260:     even
