                            	  5268: 
                            	  5269: ; Each byte describes an item. The high nibble is the type.
                            	  5270: ; The low nibble is the value. Its meaning depends on the type.
                            	  5271: ;
                            	  5272: ; 0x - individuals
                            	  5273: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5274: ; * bit mask: value doesn't matter.
                            	  5275: ;
                            	  5276: ; 1x - amounts
                            	  5277: ; Value is an amount to add.
                            	  5278: ;
                            	  5279: ; 2x - grades
                            	  5280: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5281: ;
                            	  5282: ; 3x - error?
                            	  5283: ; Produces an item value of $FF.
                            	  5284: ;
                            	  5285:     even
                            	  5286: ItemIdToDescriptor:
