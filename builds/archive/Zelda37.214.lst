                            	  3474: _L_z04_UpdateRedLeever_Subtract:
                            	  3475:     ; The point is to get the absolute distance between the two.
                            	  3476:     ;
02:0003AD7C 102C0001        	  3477:     move.b  ($0001,A4),D0
02:0003AD80 003C0011        	  3478:     ori     #$11,CCR  ; SEC: set C+X
02:0003AD84 122C0002        	  3479:     move.b  ($0002,A4),D1
02:0003AD88 0A3C0010        	  3480:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AD8C 9101            	  3481:     subx.b  D1,D0   ; SBC $02
02:0003AD8E 0A3C0010        	  3482:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3483:     ; If the absolute distance >= $30, then return.
                            	  3484:     ; It means that the leever's X coordinate wrapped around
                            	  3485:     ; the left or right edge of the screen.
                            	  3486:     ;
02:0003AD92 0C000030        	  3487:     cmpi.b  #$30,D0
