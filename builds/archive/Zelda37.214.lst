                            	   353: ;------------------------------------------------------------------------------
                            	   354: c_copy_bank_to_window:
02:0002B666 202F0004        	   355:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   356:     jmp     _copy_bank_to_window
