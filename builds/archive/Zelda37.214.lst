                            	  3782: DrawGhiniAndCheckCollisions:
02:0003AFC0 4EB90004D2CE    	  3783:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AFC6 1940000D        	  3784:     move.b  D0,($000D,A4)
                            	  3785:     ; If the direction has an "up" component, then keep the
                            	  3786:     ; frame image 0, and go figure out horizontal flipping.
                            	  3787:     ;
02:0003AFCA 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003AFCE 10302000        	  3789:     move.b  (A0,D2.W),D0
02:0003AFD2 02000008        	  3790:     andi.b #$08,D0
02:0003AFD6 6614            	  3791:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3792:     ; Else make the frame image 1 for the "down" frame.
                            	  3793:     ; Note that this is the frame image to use, even if there's no
                            	  3794:     ; down component in the direction.
                            	  3795:     ;
02:0003AFD8 522C000D        	  3796:     addq.b  #1,($000D,A4)
                            	  3797:     ; If right is a component of the direction, then go set horizontal
                            	  3798:     ; flipping. Else leave horizontal flipping = 0.
                            	  3799:     ;
02:0003AFDC 41EC0098        	  3800:     lea     ($0098,A4),A0
02:0003AFE0 10302000        	  3801:     move.b  (A0,D2.W),D0
02:0003AFE4 02000001        	  3802:     andi.b #$01,D0
02:0003AFE8 6714            	  3803:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003AFEA 660E            	  3804:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3805:     even
                            	  3806: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3807:     ; Set horizontal flipping if right is a direction component.
                            	  3808:     ; This essentially the same test as above, but for when we jump
                            	  3809:     ; from the "up" test.
                            	  3810:     ;
02:0003AFEC 41EC0098        	  3811:     lea     ($0098,A4),A0
02:0003AFF0 10302000        	  3812:     move.b  (A0,D2.W),D0
02:0003AFF4 02000002        	  3813:     andi.b #$02,D0
02:0003AFF8 6704            	  3814:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3815:     even
                            	  3816: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003AFFA 522C000F        	  3817:     addq.b  #1,($000F,A4)
                            	  3818:     even
                            	  3819: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003AFFE 102C000D        	  3820:     move.b  ($000D,A4),D0
                            	  3821: ; Params:
                            	  3822: ; A: frame image
                            	  3823: ; X: object index
                            	  3824: ; [00]: object X
                            	  3825: ; [01]: object Y
                            	  3826: ; [0F]: flip horizontally
                            	  3827: ;
                            	  3828: ; Returns:
                            	  3829: ; [00]: 0 for Link slot
                            	  3830: ; [06]: 1 if objects collide
                            	  3831: ; [09]: 0 for Link damage type (none)
                            	  3832: ; [0C]: 1 if objects collide
                            	  3833: ; [034B]: ShotCollidesWithLink
                            	  3834: ;
                            	  3835:     even
