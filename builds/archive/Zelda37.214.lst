02:0003AFAA 0C000022        	  3769:     cmpi.b  #$22,D0
02:0003AFAE 660A            	  3770:     bne  _anon_z04_50
02:0003AFB0 7011            	  3771:     moveq   #17,D0
02:0003AFB2 41EC0405        	  3772:     lea     ($0405,A4),A0
02:0003AFB6 11803000        	  3773:     move.b  D0,(A0,D3.W)
                            	  3774: _anon_z04_50:
