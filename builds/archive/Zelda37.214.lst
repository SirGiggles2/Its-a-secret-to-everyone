02:00039E8E 10302000        	  1321:     move.b  (A0,D2.W),D0
02:00039E92 1940000F        	  1322:     move.b  D0,($000F,A4)
                            	  1323:     ; Load the vertical q-speed and position fraction,
                            	  1324:     ; move, then save the position fraction.
                            	  1325:     ;
02:00039E96 41EC0444        	  1326:     lea     ($0444,A4),A0
