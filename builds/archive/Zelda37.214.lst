                            	  8547:     ; In UW. There are two input directions, and they're both walkable.
                            	  8548:     ;
                            	  8549:     ; Normally, turn to the direction that's perpendicular to object
                            	  8550:     ; direction. But keep going straight after that, while diagonal
                            	  8551:     ; input is held.
                            	  8552:     ;
                            	  8553:     ; Handle special cases for doors.
                            	  8554:     ;
                            	  8555:     ;
                            	  8556:     ; 1. Link at horizontal doors.
                            	  8557:     ;
                            	  8558:     ; If Link's X = $20 or $D0 then
                            	  8559:     ;   If Link's Y = $85 and facing down then
                            	  8560:     ;     Go set object direction and input direction to object
                            	  8561:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8562:     ;     Link_GoStraightWhenDiagInput.
                            	  8563:     ;   Else
                            	  8564:     ;     Go turn to the perpendicular direction
                            	  8565:     ;
02:00045070 7600            	  8566:     moveq   #0,D3
02:00045072 162C0070        	  8567:     move.b  ($0070,A4),D3
02:00045076 0C030020        	  8568:     cmpi.b  #$20,D3
02:0004507A 6706            	  8569:     beq  _anon_z05_175
