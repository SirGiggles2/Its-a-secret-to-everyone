                            	  6248: 
                            	  6249: ; Params:
                            	  6250: ; [00]: Object X
                            	  6251: ; [01]: Object Y
                            	  6252: ; [02]: Left tile
                            	  6253: ; [03]: Right tile
                            	  6254: ; [04]: Left attributes
                            	  6255: ; [05]: Right attributes
                            	  6256: ; [07]: Has two sides
                            	  6257: ; [08]: Cycle sprite index
                            	  6258: ; [0A]: X separation
                            	  6259: ; [0F]: Flip horizontally
                            	  6260: ; [0343]: LeftSpriteOffset
                            	  6261: ; [0344]: RightSpriteOffset
                            	  6262: ;
