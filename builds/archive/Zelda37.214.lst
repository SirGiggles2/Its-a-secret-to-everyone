02:0003CA0E 123C0008        	  7428:     move.b  #$08,D1
02:0003CA12 D101            	  7429:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7430: _anon_z04_91:
02:0003CA14 1880            	  7431:     move.b  D0,($0000,A4)
                            	  7432:     ; Store (Y + 8) in [01].
                            	  7433:     ;
02:0003CA16 41EC0084        	  7434:     lea     ($0084,A4),A0
02:0003CA1A 10302000        	  7435:     move.b  (A0,D2.W),D0
02:0003CA1E 123C0008        	  7436:     move.b  #$08,D1
02:0003CA22 D101            	  7437:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA24 19400001        	  7438:     move.b  D0,($0001,A4)
                            	  7439:     ; Only check the first bomb slot ($10).
                            	  7440:     ;
                            	  7441:     ; Store the bomb's (X + 8) in [02].
                            	  7442:     ;
02:0003CA28 7610            	  7443:     moveq   #16,D3
02:0003CA2A 10343070        	  7444:     move.b  ($70,A4,D3.W),D0
02:0003CA2E 123C0008        	  7445:     move.b  #$08,D1
02:0003CA32 D101            	  7446:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA34 19400002        	  7447:     move.b  D0,($0002,A4)
                            	  7448:     ; Store the bomb's (Y + 8) in [03].
                            	  7449:     ;
02:0003CA38 41EC0084        	  7450:     lea     ($0084,A4),A0
02:0003CA3C 10303000        	  7451:     move.b  (A0,D3.W),D0
02:0003CA40 123C0008        	  7452:     move.b  #$08,D1
02:0003CA44 D101            	  7453:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA46 19400003        	  7454:     move.b  D0,($0003,A4)
                            	  7455:     ; But, if there's no bomb, then return.
                            	  7456:     ;
02:0003CA4A 41EC00AC        	  7457:     lea     ($00AC,A4),A0
02:0003CA4E 10303000        	  7458:     move.b  (A0,D3.W),D0
02:0003CA52 6720            	  7459:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7460:     ; If the bomb has not exploded (state $12), then
