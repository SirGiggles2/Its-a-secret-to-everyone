                            	  7256: DealDamage:
                            	  7257:     ; Play the "harmed" sound.
                            	  7258:     ;
02:00031D90 7002            	  7259:     moveq   #2,D0
02:00031D92 19400604        	  7260:     move.b  D0,($0604,A4)
                            	  7261:     ; Subtract the damage points from HP; if damage points >= HP,
                            	  7262:     ; then go handle the monster dying.
