                            	  7569: DodongoBombNegativeLimits:
02:0003CAE6 F4              	  7570:     dc.b    $F4, $F0
02:0003CAE7 F0
                            	  7571: 
                            	  7572: ; Params:
                            	  7573: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7574: ; [00]: monster hotspot X
                            	  7575: ; [01]: monster hotspot Y
                            	  7576: ; [02]: bomb hotspot X
                            	  7577: ; [03]: bomb hotspot Y
                            	  7578: ;
                            	  7579: ; Returns:
                            	  7580: ; A: 0 if the bomb is in range of the monster
                            	  7581: ; Z: 1 if the bomb is in range of the monster
                            	  7582: ; [04]: horizontal distance
                            	  7583: ; [05]: vertical distance
                            	  7584: ;
                            	  7585: ; Store the positive limit in [06], and the negative one in [07].
                            	  7586: ;
                            	  7587:     even
                            	  7588: Dodongo_IsBombInRange:
02:0003CAE8 41F90003CAE4    	  7589:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CAEE 10303000        	  7590:     move.b  (A0,D3.W),D0
02:0003CAF2 19400006        	  7591:     move.b  D0,($0006,A4)
02:0003CAF6 41F90003CAE6    	  7592:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CAFC 10303000        	  7593:     move.b  (A0,D3.W),D0
02:0003CB00 19400007        	  7594:     move.b  D0,($0007,A4)
                            	  7595:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7596:     ; the bomb is near enough the monster.
                            	  7597:     ;
02:0003CB04 7003            	  7598:     moveq   #3,D0
02:0003CB06 19400008        	  7599:     move.b  D0,($0008,A4)
                            	  7600:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7601:     ;
02:0003CB0A 7601            	  7602:     moveq   #1,D3
                            	  7603:     even
                            	  7604: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7605:     ; Subtract the bomb's coordinate from the boss's,
                            	  7606:     ; The loop index determines the coordinate.
                            	  7607:     ;
02:0003CB0C 10343000        	  7608:     move.b  ($00,A4,D3.W),D0
02:0003CB10 003C0011        	  7609:     ori     #$11,CCR  ; SEC: set C+X
02:0003CB14 12343002        	  7610:     move.b  ($02,A4,D3.W),D1
02:0003CB18 0A3C0010        	  7611:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CB1C 9101            	  7612:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CB1E 0A3C0010        	  7613:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7614:     ; If the distance >= positive offset, or < negative offset;
                            	  7615:     ; then loop again.
                            	  7616:     ;
02:0003CB22 122C0006        	  7617:     move.b  ($0006,A4),D1
02:0003CB26 B001            	  7618:     cmp.b   D1,D0
02:0003CB28 6A16            	  7619:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CB2A 122C0007        	  7620:     move.b  ($0007,A4),D1
02:0003CB2E B001            	  7621:     cmp.b   D1,D0
02:0003CB30 6B0E            	  7622:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7623:     ; The distance is close enough in this axis.
                            	  7624:     ;
                            	  7625:     ; Store the distance in this axis in [05] or [04],
                            	  7626:     ; depending on the loop index.
                            	  7627:     ;
02:0003CB32 19803004        	  7628:     move.b  D0,($04,A4,D3.W)
                            	  7629:     ; Shift [08] right, because we're in range in this axis.
                            	  7630:     ;
02:0003CB36 122C0008        	  7631:     move.b  ($0008,A4),D1
02:0003CB3A E209            	  7632:     lsr.b  #1,D1   ; LSR $08
02:0003CB3C 19410008        	  7633:     move.b  D1,($0008,A4)
                            	  7634:     even
                            	  7635: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CB40 5303            	  7636:     subq.b  #1,D3
02:0003CB42 6AC8            	  7637:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7638:     ; If close enough in both axes, then [08] will be 0.
                            	  7639:     ;
02:0003CB44 102C0008        	  7640:     move.b  ($0008,A4),D0
02:0003CB48 4E75            	  7641:     rts
                            	  7642: 
                            	  7643: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7644: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7645: ;
                            	  7646: ; But these are not typical direction indexes. Instead a
                            	  7647: ; 5-way index is used.
                            	  7648: ; A direction shifted right once becomes a 5-way index.
                            	  7649: ; The fourth element is unused.
                            	  7650: ;
                            	  7651:     even
