                            	   558: UpdateMenuStartOW:
                            	   559:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   560:     ; make it look completely empty, and no piece has been won.
                            	   561:     ;
02:000403CA 7617            	   562:     moveq   #23,D3
                            	   563: _anon_z05_6:
02:000403CC 7400            	   564:     moveq   #0,D2
02:000403CE 41F900040382    	   565:     lea     (TriforceTransferBufOffsets).l,A0
02:000403D4 14303000        	   566:     move.b  (A0,D3.W),D2
02:000403D8 41F9000403B2    	   567:     lea     (TriforceTransferBufTiles).l,A0
02:000403DE 10303000        	   568:     move.b  (A0,D3.W),D0
02:000403E2 41F90004776A    	   569:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403E8 11802000        	   570:     move.b  D0,(A0,D2.W)
02:000403EC 5303            	   571:     subq.b  #1,D3
02:000403EE 6ADC            	   572:     bpl  _anon_z05_6
                            	   573:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   574:     ;
02:000403F0 5203            	   575:     addq.b  #1,D3
                            	   576:     ; Outer loop.
                            	   577:     ; A level test bit in [06] will be used to see whether
                            	   578:     ; we have a triforce piece.
                            	   579:     ;
02:000403F2 7001            	   580:     moveq   #1,D0
02:000403F4 19400006        	   581:     move.b  D0,($0006,A4)
                            	   582:     even
                            	   583: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   584:     ; Inner loop.
                            	   585:     ; Each level bit will make 3 triforce tile slots be
                            	   586:     ; checked and replaced.
                            	   587:     ;
02:000403F8 7003            	   588:     moveq   #3,D0
02:000403FA 19400007        	   589:     move.b  D0,($0007,A4)
                            	   590:     even
                            	   591: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   592:     ; Get the offset into the submenu triforce transfer buffers of
                            	   593:     ; the current tile slot.
                            	   594:     ;
02:000403FE 7400            	   595:     moveq   #0,D2
02:00040400 41F900040382    	   596:     lea     (TriforceTransferBufOffsets).l,A0
02:00040406 14303000        	   597:     move.b  (A0,D3.W),D2
                            	   598:     ; If the level test bit is not in the triforce mask, then we don't
                            	   599:     ; have this piece. So, go loop again, and leave the tile in the
                            	   600:     ; empty state.
                            	   601:     ;
                            	   602:     ;
                            	   603:     ; [06] level test mask
02:0004040A 102C0006        	   604:     move.b  ($0006,A4),D0
02:0004040E 122C0671        	   605:     move.b  ($0671,A4),D1
02:00040412 C200            	   606:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040414 6730            	   607:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   608:     ; We have the triforce piece.
                            	   609:     ;
                            	   610:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   611:     ; then make it $F5. These are tiles that were half full, and now
                            	   612:     ; need to be full.
                            	   613:     ;
                            	   614:     ; Else replace it with the one at the current triforce tile slot
                            	   615:     ; in the replacement list.
                            	   616:     ;
02:00040416 41F90004776A    	   617:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004041C 10302000        	   618:     move.b  (A0,D2.W),D0
02:00040420 0C0000E5        	   619:     cmpi.b  #$E5,D0
02:00040424 6712            	   620:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040426 0C0000E6        	   621:     cmpi.b  #$E6,D0
02:0004042A 670C            	   622:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0004042C 41F90004039A    	   623:     lea     (TriforceTriforceBufReplacements).l,A0
02:00040432 10303000        	   624:     move.b  (A0,D3.W),D0
02:00040436 6004            	   625:     jmp     _anon_z05_7
                            	   626: 
                            	   627:     even
                            	   628: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:00040438 103C00F5        	   629:     move.b  #$F5,D0
                            	   630: _anon_z05_7:
02:0004043C 41F90004776A    	   631:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040442 11802000        	   632:     move.b  D0,(A0,D2.W)
                            	   633:     even
                            	   634: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   635:     ; Bottom of the inner loop.
                            	   636:     ;
                            	   637:     ; Increment the triforce tile slot.
                            	   638:     ; Decrement [07] and loop again, if it's not 0.
                            	   639:     ;
02:00040446 5203            	   640:     addq.b  #1,D3
02:00040448 532C0007        	   641:     subq.b  #1,($0007,A4)
02:0004044C 66B0            	   642:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   643:     ; Bottom of the outer loop.
                            	   644:     ;
                            	   645:     ; Shift the level test bit [06] left to test the next level.
                            	   646:     ; When it becomes 0, we're done.
                            	   647:     ;
02:0004044E 122C0006        	   648:     move.b  ($0006,A4),D1
02:00040452 E309            	   649:     lsl.b  #1,D1   ; ASL $06
02:00040454 19410006        	   650:     move.b  D1,($0006,A4)
02:00040458 669E            	   651:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0004045A 522C00E1        	   652:     addq.b  #1,($00E1,A4)
02:0004045E 4E75            	   653:     rts
