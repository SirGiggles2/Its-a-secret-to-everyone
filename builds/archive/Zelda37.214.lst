02:0004361A 10303000        	  5517:     move.b  (A0,D3.W),D0
02:0004361E 7600            	  5518:     moveq   #0,D3
02:00043620 162C0003        	  5519:     move.b  ($0003,A4),D3
02:00043624 0C030002        	  5520:     cmpi.b  #$02,D3
02:00043628 6510            	  5521:     bcs  _anon_z05_106
02:0004362A 7600            	  5522:     moveq   #0,D3
02:0004362C 162C00EB        	  5523:     move.b  ($00EB,A4),D3
02:00043630 41F900FF68FE    	  5524:     lea     (NES_SRAM+$08FE).l,A0
02:00043636 10303000        	  5525:     move.b  (A0,D3.W),D0
                            	  5526: _anon_z05_106:
02:0004363A 1880            	  5527:     move.b  D0,($0000,A4)
