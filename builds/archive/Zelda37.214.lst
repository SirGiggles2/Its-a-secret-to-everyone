                            	  9915: Manhandla_Move:
                            	  9916:     ; Implement a way of manifesting the fractional part of the speed
                            	  9917:     ; in the movement.
                            	  9918:     ;
                            	  9919:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9920:     ; byte to add to the coordinates, then the effective speed would
                            	  9921:     ; be 1 pixel a frame instead of 1.25.
                            	  9922:     ;
                            	  9923:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9924:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9925:     ;
                            	  9926:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9927:     ;
                            	  9928:     ;   SA := SA + (SL AND $E0)
                            	  9929:     ;   [03] := SH + carry
                            	  9930:     ;
                            	  9931:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9932:     ;
02:0003DC34 41EC041F        	  9933:     lea     ($041F,A4),A0
02:0003DC38 10302000        	  9934:     move.b  (A0,D2.W),D0
02:0003DC3C 020000E0        	  9935:     andi.b #$E0,D0
02:0003DC40 023C00EE        	  9936:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC44 41EC0412        	  9937:     lea     ($0412,A4),A0
02:0003DC48 12302000        	  9938:     move.b  (A0,D2.W),D1
02:0003DC4C D101            	  9939:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC4E 41EC0412        	  9940:     lea     ($0412,A4),A0
02:0003DC52 11802000        	  9941:     move.b  D0,(A0,D2.W)
                            	  9942:     ; Assign (high speed byte + carry) to [03].
                            	  9943:     ;
02:0003DC56 41EC042C        	  9944:     lea     ($042C,A4),A0
02:0003DC5A 10302000        	  9945:     move.b  (A0,D2.W),D0
02:0003DC5E 123C0000        	  9946:     move.b  #$00,D1
02:0003DC62 D101            	  9947:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DC64 19400003        	  9948:     move.b  D0,($0003,A4)
                            	  9949:     ; Change coordinates by the speed amount/offset in [03]
                            	  9950:     ; according to the direction.
                            	  9951:     ;
                            	  9952:     ; Start with a mask of $A1 in [02]:
                            	  9953:     ; - low nibble represents the right direction
                            	  9954:     ; - high nibble is used to set or clear carry as we go along
                            	  9955:     ;
