                            	  7634:     ; checking routine above dealt some. This way it dies for sure.
                            	  7635:     ;
02:00031FB8 0C030012        	  7636:     cmpi.b  #$12,D3
02:00031FBC 6702            	  7637:     beq.s  __far_z_01_0092
02:00031FBE 6030            	  7638:     jmp  ParryOrShove
                            	  7639: __far_z_01_0092:
02:00031FC0 41EC034F        	  7640:     lea     ($034F,A4),A0
02:00031FC4 10302000        	  7641:     move.b  (A0,D2.W),D0
02:00031FC8 0C000016        	  7642:     cmpi.b  #$16,D0
02:00031FCC 660E            	  7643:     bne  _anon_z01_95
02:00031FCE 7000            	  7644:     moveq   #0,D0
02:00031FD0 41EC0485        	  7645:     lea     ($0485,A4),A0
02:00031FD4 11802000        	  7646:     move.b  D0,(A0,D2.W)
02:00031FD8 6000FDB6        	  7647:     jmp     DealDamage
                            	  7648: 
