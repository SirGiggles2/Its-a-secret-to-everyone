                            	  5406: _anon_z04_70:
                            	  5407:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5408:     ; 1. negate the distance
                            	  5409:     ; 2. add 8 to the instruction offset to access
                            	  5410:     ;    the opposite direction for the same wall
                            	  5411:     ;
02:0003BAF8 7600            	  5412:     moveq   #0,D3
02:0003BAFA 162C0098        	  5413:     move.b  ($0098,A4),D3
02:0003BAFE 122C0002        	  5414:     move.b  ($0002,A4),D1
02:0003BB02 B601            	  5415:     cmp.b   D1,D3
02:0003BB04 662A            	  5416:     bne  _anon_z04_71
02:0003BB06 1B00            	  5417:     move.b  D0,-(A5)  ; PHA
02:0003BB08 41EC0412        	  5418:     lea     ($0412,A4),A0
02:0003BB0C 10302000        	  5419:     move.b  (A0,D2.W),D0
02:0003BB10 023C00EE        	  5420:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB14 123C0008        	  5421:     move.b  #$08,D1
02:0003BB18 D101            	  5422:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB1A 41EC0412        	  5423:     lea     ($0412,A4),A0
02:0003BB1E 11802000        	  5424:     move.b  D0,(A0,D2.W)
02:0003BB22 101D            	  5425:     move.b  (A5)+,D0  ; PLA
02:0003BB24 4600            	  5426:     eori.b #$FF,D0
02:0003BB26 023C00EE        	  5427:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB2A 123C0001        	  5428:     move.b  #$01,D1
02:0003BB2E D101            	  5429:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5430: _anon_z04_71:
                            	  5431:     ; Add the distance and Link's minor coordinate to calculate
                            	  5432:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5433:     ; In general, the monster will be put in front of Link.
                            	  5434:     ;
02:0003BB30 023C00EE        	  5435:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB34 1214            	  5436:     move.b  ($0000,A4),D1
02:0003BB36 D101            	  5437:     addx.b  D1,D0   ; ADC $00
02:0003BB38 19400004        	  5438:     move.b  D0,($0004,A4)
                            	  5439:     ; By default, will return index 0 to choose the minimum value
                            	  5440:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5441:     ; if Link is at the wall with a smaller major coordinate.
                            	  5442:     ;
02:0003BB3C 7600            	  5443:     moveq   #0,D3
                            	  5444:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5445:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5446:     ; to access the block for the other direction along the same axis,
                            	  5447:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5448:     ;
02:0003BB3E 102C0001        	  5449:     move.b  ($0001,A4),D0
02:0003BB42 122C0003        	  5450:     move.b  ($0003,A4),D1
02:0003BB46 B001            	  5451:     cmp.b   D1,D0
02:0003BB48 671C            	  5452:     beq  _anon_z04_72
02:0003BB4A 41EC0412        	  5453:     lea     ($0412,A4),A0
