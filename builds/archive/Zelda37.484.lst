02:0003C8AE 1214            	   345:     move.b  ($0000,A4),D1
02:0003C8B0 D101            	   346:     addx.b  D1,D0   ; ADC $00
02:0003C8B2 19400254        	   347:     move.b  D0,($0254,A4)
