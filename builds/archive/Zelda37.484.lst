02:00034E6A 19400072        	  4400:     move.b  D0,($0072,A4)
02:00034E6E 102C0085        	  4401:     move.b  ($0085,A4),D0
02:00034E72 003C0011        	  4402:     ori     #$11,CCR  ; SEC: set C+X
02:00034E76 123C0010        	  4403:     move.b  #$10,D1
02:00034E7A 0A3C0010        	  4404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E7E 9101            	  4405:     subx.b  D1,D0   ; SBC #$10
02:00034E80 0A3C0010        	  4406:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E84 19400086        	  4407:     move.b  D0,($0086,A4)
