02:0002BFD8 003C0001        	  2522:     ori     #$01,CCR
02:0002BFDC 0A3C0001        	  2523:     eori    #$01,CCR
02:0002BFE0 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002BFE2 023C00FE        	  2526:     andi    #$FE,CCR
02:0002BFE6 0A3C0001        	  2527:     eori    #$01,CCR
02:0002BFEA 4E75            	  2528:     rts
