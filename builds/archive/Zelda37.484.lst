02:0003A1D4 103C00FF        	  4714:     move.b  #$FF,D0
02:0003A1D8 41EC0478        	  4715:     lea     ($0478,A4),A0
02:0003A1DC 11803000        	  4716:     move.b  D0,(A0,D3.W)
02:0003A1E0 4E75            	  4717:     rts
