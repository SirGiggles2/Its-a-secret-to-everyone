                            	   683: 
                            	   684: ;==============================================================================
                            	   685: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   686: ;
                            	   687: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   688: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   689: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   690: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   691: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   692: ;
                            	   693: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   694: ;
                            	   695: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   696: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   697: ;==============================================================================
                            	   698:     ifne DEBUG_TELEPORT
                            	   699: _debug_teleport_check:
                            	   700:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   701:     tst.b   ($0010,A4)
                            	   702:     bne     .dtc_no
                            	   703:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   704:     cmpi.b  #$05,($0012,A4)
                            	   705:     bne     .dtc_no
                            	   706:     tst.b   ($0013,A4)
                            	   707:     bne     .dtc_no
                            	   708:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   709:     ;
                            	   710:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   711:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   712:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   713:     ; So the bit map is:
                            	   714:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   715:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   716:     move.b  ($00F8,A4),D1
                            	   717:     andi.b  #$0F,D1
                            	   718:     beq     .dtc_no
                            	   719:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   720:     moveq   #0,D0
                            	   721:     btst    #3,D1                   ; Up
                            	   722:     bne.s   .dtc_dir_set
                            	   723:     moveq   #1,D0
                            	   724:     btst    #2,D1                   ; Down
                            	   725:     bne.s   .dtc_dir_set
                            	   726:     moveq   #2,D0
                            	   727:     btst    #1,D1                   ; Left
                            	   728:     bne.s   .dtc_dir_set
                            	   729:     moveq   #3,D0                   ; Right (bit 0)
                            	   730: .dtc_dir_set:
                            	   731:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   732:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   733:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   734:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   735:     move.b  ($00EB,A4),D2
                            	   736:     move.b  D2,D3
                            	   737:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   738:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   739:     tst.b   D0
                            	   740:     bne.s   .dtc_not_up
                            	   741:     tst.b   D2
                            	   742:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   743:     bra.s   .dtc_apply
                            	   744: .dtc_not_up:
                            	   745:     cmpi.b  #1,D0
                            	   746:     bne.s   .dtc_not_down
                            	   747:     cmpi.b  #7,D2
                            	   748:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   749:     bra.s   .dtc_apply
                            	   750: .dtc_not_down:
                            	   751:     cmpi.b  #2,D0
                            	   752:     bne.s   .dtc_not_left
                            	   753:     tst.b   D3
                            	   754:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   755:     bra.s   .dtc_apply
                            	   756: .dtc_not_left:
                            	   757:     cmpi.b  #$0F,D3
                            	   758:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   759: .dtc_apply:
                            	   760:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   761:     lea     (NextRoomIdOffsets).l,A0
                            	   762:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   763:     move.b  ($00EB,A4),D0
                            	   764:     add.b   D1,D0
                            	   765:     move.b  D0,($00EB,A4)
                            	   766:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   767:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   768:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   769:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   770:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   771:     ; movement update doesn't immediately retrigger the edge.
                            	   772:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   773:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   774:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   775:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   776:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   777:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   778:     ; skip that setup.
                            	   779:     jsr     LayOutRoom
                            	   780:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   781:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   782:     ; kick that from here with arbitrary state causes crashes when the
                            	   783:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   784:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   785:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   786:     ; per target room.
                            	   787:     clr.b   ($00F8,A4)
                            	   788:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   789:                                          ; doesn't walk during sweep settle
                            	   790:     moveq   #1,D0
                            	   791:     rts
                            	   792: .dtc_edge:
                            	   793:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   794:     ; interpret it as "walk into wall" animation.
                            	   795:     clr.b   ($00F8,A4)
                            	   796:     clr.b   ($00FA,A4)
                            	   797:     moveq   #1,D0
                            	   798:     rts
                            	   799: .dtc_no:
                            	   800:     moveq   #0,D0
                            	   801:     rts
                            	   802:     endc
                            	   803: 
                            	   804: ;==============================================================================
                            	   805: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   806: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   807: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   808: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   809: ;==============================================================================
                            	   810:     ifne TURBO_LINK
                            	   811: _turbo_link_boost:
                            	   812:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   813:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   814:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   815:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A2C 4E75            	   816:     rts
                            	   817: _turbo_link_boost_disabled:
                            	   818:     ; OW gate
02:00049A2E 4A2C0010        	   819:     tst.b   ($0010,A4)
02:00049A32 6670            	   820:     bne     .tlb_exit
                            	   821:     ; Mode 5 / Submode 0 only
02:00049A34 0C2C00050012    	   822:     cmpi.b  #$05,($0012,A4)
02:00049A3A 6668            	   823:     bne     .tlb_exit
02:00049A3C 4A2C0013        	   824:     tst.b   ($0013,A4)
02:00049A40 6662            	   825:     bne     .tlb_exit
                            	   826:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049A42 122C00FA        	   827:     move.b  ($00FA,A4),D1
02:00049A46 0201000F        	   828:     andi.b  #$0F,D1
02:00049A4A 6758            	   829:     beq     .tlb_exit
                            	   830:     ; Edge-safe clamps.
02:00049A4C 08010003        	   831:     btst    #3,D1                   ; Up (bit 3)
02:00049A50 6710            	   832:     beq     .tlb_no_up
02:00049A52 102C0084        	   833:     move.b  ($0084,A4),D0
02:00049A56 0C000040        	   834:     cmpi.b  #$40,D0
02:00049A5A 6306            	   835:     bls     .tlb_no_up
02:00049A5C 5900            	   836:     subi.b  #4,D0
02:00049A5E 19400084        	   837:     move.b  D0,($0084,A4)
                            	   838: .tlb_no_up:
02:00049A62 08010002        	   839:     btst    #2,D1                   ; Down (bit 2)
02:00049A66 6710            	   840:     beq     .tlb_no_down
02:00049A68 102C0084        	   841:     move.b  ($0084,A4),D0
02:00049A6C 0C0000D0        	   842:     cmpi.b  #$D0,D0
02:00049A70 6406            	   843:     bcc     .tlb_no_down
02:00049A72 5800            	   844:     addi.b  #4,D0
02:00049A74 19400084        	   845:     move.b  D0,($0084,A4)
                            	   846: .tlb_no_down:
02:00049A78 08010001        	   847:     btst    #1,D1                   ; Left (bit 1)
02:00049A7C 6710            	   848:     beq     .tlb_no_left
02:00049A7E 102C0070        	   849:     move.b  ($0070,A4),D0
02:00049A82 0C00000A        	   850:     cmpi.b  #$0A,D0
02:00049A86 6306            	   851:     bls     .tlb_no_left
02:00049A88 5900            	   852:     subi.b  #4,D0
02:00049A8A 19400070        	   853:     move.b  D0,($0070,A4)
                            	   854: .tlb_no_left:
02:00049A8E 08010000        	   855:     btst    #0,D1                   ; Right (bit 0)
02:00049A92 6710            	   856:     beq     .tlb_no_right
02:00049A94 102C0070        	   857:     move.b  ($0070,A4),D0
02:00049A98 0C0000E6        	   858:     cmpi.b  #$E6,D0
02:00049A9C 6406            	   859:     bcc     .tlb_no_right
02:00049A9E 5800            	   860:     addi.b  #4,D0
02:00049AA0 19400070        	   861:     move.b  D0,($0070,A4)
                            	   862: .tlb_no_right:
                            	   863: .tlb_exit:
02:00049AA4 4E75            	   864:     rts
                            	   865:     endc
