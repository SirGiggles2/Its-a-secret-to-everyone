                            	   315:     ; Get the absolute vertical distance between
                            	   316:     ; the monster and the chase target.
                            	   317:     ;
02:00038296 102C0062        	   318:     move.b  ($0062,A4),D0
02:0003829A 003C0011        	   319:     ori     #$11,CCR  ; SEC: set C+X
02:0003829E 41EC0084        	   320:     lea     ($0084,A4),A0
02:000382A2 12302000        	   321:     move.b  (A0,D2.W),D1
02:000382A6 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000382AA 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:000382AC 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
02:000382B0 6A0C            	   325:     bpl  _anon_z04_9
02:000382B2 4600            	   326:     eori.b #$FF,D0
02:000382B4 023C00EE        	   327:     andi    #$EE,CCR  ; CLC: clear C+X
02:000382B8 123C0001        	   328:     move.b  #$01,D1
