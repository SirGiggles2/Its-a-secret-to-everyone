                            	  1120: _anon_z04_34:
02:00038836 7020            	  1121:     moveq   #32,D0
                            	  1122: ; Params:
                            	  1123: ; A: q-speed of the monster
                            	  1124: ; Y: shot object type
                            	  1125: ;
                            	  1126: ; [01] holds the q-speed of the monster
                            	  1127:     even
                            	  1128: _TryShooting:
02:00038838 19400001        	  1129:     move.b  D0,($0001,A4)
                            	  1130:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1131:     ;
02:0003883C 41EC034F        	  1132:     lea     ($034F,A4),A0
02:00038840 10302000        	  1133:     move.b  (A0,D2.W),D0
02:00038844 0C000003        	  1134:     cmpi.b  #$03,D0
02:00038848 6726            	  1135:     beq  _L_z04__TryShooting_TryShootingNow
02:0003884A 0C000001        	  1136:     cmpi.b  #$01,D0
02:0003884E 6720            	  1137:     beq  _L_z04__TryShooting_TryShootingNow
02:00038850 0C000009        	  1138:     cmpi.b  #$09,D0
02:00038854 671A            	  1139:     beq  _L_z04__TryShooting_TryShootingNow
02:00038856 0C00000A        	  1140:     cmpi.b  #$0A,D0
02:0003885A 6714            	  1141:     beq  _L_z04__TryShooting_TryShootingNow
02:0003885C 41EC0451        	  1142:     lea     ($0451,A4),A0
02:00038860 10302000        	  1143:     move.b  (A0,D2.W),D0
02:00038864 660A            	  1144:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1145:     ; and a random value < $F8, then return.
                            	  1146:     ;
02:00038866 10342018        	  1147:     move.b  ($18,A4,D2.W),D0
02:0003886A 0C0000F8        	  1148:     cmpi.b  #$F8,D0
02:0003886E 656C            	  1149:     bcs  _L_z04__TryShooting_Exit
                            	  1150:     even
                            	  1151: _L_z04__TryShooting_TryShootingNow:
                            	  1152:     ; Summary
                            	  1153:     ;
                            	  1154:     ; if temporarily invincible then
                            	  1155:     ;   shoot timer := 0
                            	  1156:     ; elif shoot timer > 0 then
                            	  1157:     ;   decrement shoot timer
                            	  1158:     ; elif wants to shoot then
                            	  1159:     ;   shoot timer := $30
                            	  1160:     ;
                            	  1161:     ; qspeed := [01]
                            	  1162:     ;
                            	  1163:     ; if shoot timer <> 0 then
                            	  1164:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1165:     ;     shoot
                            	  1166:     ;     if succeeded then
                            	  1167:     ;       shoot timer := 0
                            	  1168:     ;       qspeed := 0
                            	  1169:     ;   else
                            	  1170:     ;     qspeed := 0
                            	  1171:     ;
                            	  1172:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038870 102C0001        	  1173:     move.b  ($0001,A4),D0
02:00038874 1883            	  1174:     move.b  D3,($0000,A4)
02:00038876 1B00            	  1175:     move.b  D0,-(A5)  ; PHA
02:00038878 7600            	  1176:     moveq   #0,D3
                            	  1177:     ; If not temporarily invincible,
                            	  1178:     ;
02:0003887A 41EC04F0        	  1179:     lea     ($04F0,A4),A0
02:0003887E 10302000        	  1180:     move.b  (A0,D2.W),D0
02:00038882 661A            	  1181:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1182:     ; then Y := shoot timer - 1
                            	  1183:     ;
02:00038884 7600            	  1184:     moveq   #0,D3
02:00038886 41EC0451        	  1185:     lea     ($0451,A4),A0
02:0003888A 16302000        	  1186:     move.b  (A0,D2.W),D3
02:0003888E 5303            	  1187:     subq.b  #1,D3
                            	  1188:     ; If Y register < 0, then shoot timer is 0.
                            	  1189:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1190:     ; Else go set a non-zero speed and return.
                            	  1191:     ;
02:00038890 6A0C            	  1192:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038892 41EC0412        	  1193:     lea     ($0412,A4),A0
02:00038896 10302000        	  1194:     move.b  (A0,D2.W),D0
02:0003889A 6736            	  1195:     beq  _L_z04__TryShooting_SetSpeed
02:0003889C 7630            	  1196:     moveq   #48,D3
                            	  1197:     even
                            	  1198: _L_z04__TryShooting_SetShootTimer:
                            	  1199:     ; shoot timer := Y
                            	  1200:     ;
02:0003889E 1003            	  1201:     move.b  D3,D0
02:000388A0 41EC0451        	  1202:     lea     ($0451,A4),A0
02:000388A4 11802000        	  1203:     move.b  D0,(A0,D2.W)
                            	  1204:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1205:     ;
02:000388A8 6728            	  1206:     beq  _L_z04__TryShooting_SetSpeed
                            	  1207:     ; shoot timer <> 0
                            	  1208:     ; If shoot timer <> $10, then go set a zero speed.
                            	  1209:     ;
02:000388AA 0C030010        	  1210:     cmpi.b  #$10,D3
02:000388AE 661C            	  1211:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1212:     ; If we have the magic clock, or the monster is stunned, then
