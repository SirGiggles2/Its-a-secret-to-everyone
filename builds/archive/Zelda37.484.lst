02:0002C954 08000008        	  3884:     btst    #8,D0
02:0002C958 6706            	  3885:     beq.s   .cc_aqspf
02:0002C95A 003C0011        	  3886:     ori     #$11,CCR
02:0002C95E 4E75            	  3887:     rts
                            	  3888: .cc_aqspf:
02:0002C960 023C00EE        	  3889:     andi    #$EE,CCR
02:0002C964 4E75            	  3890:     rts
