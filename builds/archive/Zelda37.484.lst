                            	  4154: UpdateZeldaTextbox:
02:00034C9A 4EB90004805A    	  4155:     jsr     Link_EndMoveAndDraw
                            	  4156:     ; If Zelda's timer has not expired, then return.
                            	  4157:     ;
02:00034CA0 102C0029        	  4158:     move.b  ($0029,A4),D0
02:00034CA4 6704            	  4159:     beq.s  __far_z_02_0004
02:00034CA6 600000C6        	  4160:     jmp  LA9F4_Exit
                            	  4161: __far_z_02_0004:
                            	  4162:     ; Set the timer to wait 6 frames after the next character about
                            	  4163:     ; to be shown.
                            	  4164:     ;
02:00034CAA 7006            	  4165:     moveq   #6,D0
02:00034CAC 19400029        	  4166:     move.b  D0,($0029,A4)
                            	  4167:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4168:     ; to the dynamic transfer buf.
                            	  4169:     ;
02:00034CB0 7604            	  4170:     moveq   #4,D3
                            	  4171: _anon_z02_31:
02:00034CB2 41F900034C90    	  4172:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034CB8 10303000        	  4173:     move.b  (A0,D3.W),D0
02:00034CBC 41EC0302        	  4174:     lea     ($0302,A4),A0
02:00034CC0 11803000        	  4175:     move.b  D0,(A0,D3.W)
02:00034CC4 5303            	  4176:     subq.b  #1,D3
02:00034CC6 6AEA            	  4177:     bpl  _anon_z02_31
                            	  4178: _anon_z02_32:
                            	  4179:     ; Replace the low byte of the VRAM address with the one
                            	  4180:     ; where the next character should be written.
                            	  4181:     ;
02:00034CC8 102C045F        	  4182:     move.b  ($045F,A4),D0
02:00034CCC 19400303        	  4183:     move.b  D0,($0303,A4)
                            	  4184:     ; Increment the low VRAM address for the next character.
                            	  4185:     ;
02:00034CD0 522C045F        	  4186:     addq.b  #1,($045F,A4)
02:00034CD4 7000            	  4187:     moveq   #0,D0
02:00034CD6 1880            	  4188:     move.b  D0,($0000,A4)
02:00034CD8 7000            	  4189:     moveq   #0,D0
02:00034CDA 19400001        	  4190:     move.b  D0,($0001,A4)
                            	  4191:     ; Load the person text current character index.
                            	  4192:     ;
02:00034CDE 7600            	  4193:     moveq   #0,D3
02:00034CE0 162C0416        	  4194:     move.b  ($0416,A4),D3
                            	  4195:     ; Increment the index variable to point to the next character
                            	  4196:     ; for the next time.
                            	  4197:     ;
02:00034CE4 522C0416        	  4198:     addq.b  #1,($0416,A4)
                            	  4199:     ; Get the current character.
                            	  4200:     ;
02:00034CE8 1214            	  4201:     move.b  ($00,A4),D1   ; ptr lo
02:00034CEA 182C0001        	  4202:     move.b  ($01,A4),D4  ; ptr hi
02:00034CEE 024100FF        	  4203:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034CF2 E14C            	  4204:     lsl.w   #8,D4
02:00034CF4 8841            	  4205:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034CF6 48C4            	  4206:     ext.l   D4
02:00034CF8 D8BC00FF0000    	  4207:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034CFE 2044            	  4208:     movea.l D4,A0
02:00034D00 10303000        	  4209:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4210:     ; If the character is $25, then it's a special space. It will still
                            	  4211:     ; take up space, but will not take time to show -- meaning that
                            	  4212:     ; we'll go look up the next character to transfer.
                            	  4213:     ;
02:00034D04 0200003F        	  4214:     andi.b #$3F,D0
02:00034D08 0C000025        	  4215:     cmpi.b  #$25,D0
02:00034D0C 67BA            	  4216:     beq  _anon_z02_32
                            	  4217:     ; We have a non-space character. Put it in the transfer record.
                            	  4218:     ;
02:00034D0E 19400305        	  4219:     move.b  D0,($0305,A4)
                            	  4220:     ; Play the "heart taken/character" tune.
                            	  4221:     ;
02:00034D12 7010            	  4222:     moveq   #16,D0
02:00034D14 19400604        	  4223:     move.b  D0,($0604,A4)
                            	  4224:     ; If the high 2 bits of character element = 0, then return.
                            	  4225:     ;
02:00034D18 1214            	  4226:     move.b  ($00,A4),D1   ; ptr lo
02:00034D1A 182C0001        	  4227:     move.b  ($01,A4),D4  ; ptr hi
02:00034D1E 024100FF        	  4228:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034D22 E14C            	  4229:     lsl.w   #8,D4
02:00034D24 8841            	  4230:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034D26 48C4            	  4231:     ext.l   D4
02:00034D28 D8BC00FF0000    	  4232:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034D2E 2044            	  4233:     movea.l D4,A0
02:00034D30 10303000        	  4234:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034D34 020000C0        	  4235:     andi.b #$C0,D0
02:00034D38 6602            	  4236:     bne.s  __far_z_02_0005
02:00034D3A 6032            	  4237:     jmp  LA9F4_Exit
                            	  4238: __far_z_02_0005:
                            	  4239:     ; Determine an index based on the high 2 bits of the character element:
                            	  4240:     ;   $80: 0
                            	  4241:     ;   $40: 1
                            	  4242:     ;   $C0: 2
                            	  4243:     ;
02:00034D3C 7602            	  4244:     moveq   #2,D3
