                            	  2061: ; Params:
                            	  2062: ; A: frame image
                            	  2063: ; X: object index
                            	  2064: ; [00]: object X
                            	  2065: ; [01]: object Y
                            	  2066: ; [0F]: flip horizontally
                            	  2067: ;
                            	  2068:     even
                            	  2069: DrawObjectNotMirrored:
02:00030E26 7600            	  2070:     moveq   #0,D3
                            	  2071: _anon_z01_75:
02:00030E28 1943000C        	  2072:     move.b  D3,($000C,A4)
                            	  2073:     ; Set animation index = object type + 1.
                            	  2074:     ;
02:00030E2C 7600            	  2075:     moveq   #0,D3
02:00030E2E 41EC034F        	  2076:     lea     ($034F,A4),A0
02:00030E32 16302000        	  2077:     move.b  (A0,D2.W),D3
                            	  2078: ; Params:
                            	  2079: ; A: frame
                            	  2080: ; X: object index/cycle sprite index
                            	  2081: ; Y: object type
                            	  2082: ; [00]: object X
                            	  2083: ; [01]: object Y
                            	  2084: ; [0C]: mirrored
                            	  2085: ; [0F]: flip horizontally
                            	  2086: ;
                            	  2087: ; Note:
                            	  2088: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2089: ;
                            	  2090: ; The animation index of most objects is (object type + 1),
                            	  2091: ; to make up for the fact that Link uses two animation indexes.
                            	  2092: ;
                            	  2093:     even
                            	  2094: DrawObjectWithType:
02:00030E36 5203            	  2095:     addq.b  #1,D3
                            	  2096: ; Params:
                            	  2097: ; A: frame
                            	  2098: ; X: object index/cycle sprite index
                            	  2099: ; Y: animation index
                            	  2100: ; [00]: object X
                            	  2101: ; [01]: object Y
                            	  2102: ; [0C]: mirrored
                            	  2103: ; [0F]: flip horizontally
                            	  2104: ;
                            	  2105: ; Note:
                            	  2106: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2107: ; But Link uses [0F] for flipping without checking [0C].
                            	  2108: ;
                            	  2109: ;
                            	  2110: ; [0D] holds frame.
                            	  2111:     even
                            	  2112: DrawObjectWithAnim:
02:00030E38 1940000D        	  2113:     move.b  D0,($000D,A4)
02:00030E3C 1943000E        	  2114:     move.b  D3,($000E,A4)
02:00030E40 19420008        	  2115:     move.b  D2,($0008,A4)
                            	  2116:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2117:     ;
02:00030E44 7600            	  2118:     moveq   #0,D3
02:00030E46 162C0341        	  2119:     move.b  ($0341,A4),D3
02:00030E4A 41F900030DEE    	  2120:     lea     (SpriteOffsets).l,A0
02:00030E50 10303000        	  2121:     move.b  (A0,D3.W),D0
02:00030E54 19400343        	  2122:     move.b  D0,($0343,A4)
02:00030E58 41F900030DEF    	  2123:     lea     (SpriteOffsets+1).l,A0
02:00030E5E 10303000        	  2124:     move.b  (A0,D3.W),D0
                            	  2125:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  2126:     ;
02:00030E62 4A02            	  2127:     cmpi.b  #$00,D2
02:00030E64 6702            	  2128:     beq.s  __far_z_01_0001
02:00030E66 6008            	  2129:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  2130: __far_z_01_0001:
