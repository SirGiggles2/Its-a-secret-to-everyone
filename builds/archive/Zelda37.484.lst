02:0000E4A2 23C300C00004    	   852:     move.l  D3,(VDP_CTRL).l
                            	   853: 
02:0000E4A8 61000454        	   854:     bsr     _compose_bg_tile_word
02:0000E4AC 33C000C00000    	   855:     move.w  D0,(VDP_DATA).l
                            	   856: 
