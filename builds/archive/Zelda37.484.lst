                            	   739: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F530 1214            	   740:     move.b  ($00,A4),D1   ; ptr lo
02:0002F532 182C0001        	   741:     move.b  ($01,A4),D4  ; ptr hi
02:0002F536 024100FF        	   742:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F53A E14C            	   743:     lsl.w   #8,D4
02:0002F53C 8841            	   744:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F53E 48C4            	   745:     ext.l   D4
02:0002F540 D8BC00FF0000    	   746:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F546 2044            	   747:     movea.l D4,A0
02:0002F548 10303000        	   748:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F54C 122C0002        	   749:     move.b  ($02,A4),D1   ; ptr lo
02:0002F550 182C0003        	   750:     move.b  ($03,A4),D4  ; ptr hi
02:0002F554 024100FF        	   751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F558 E14C            	   752:     lsl.w   #8,D4
02:0002F55A 8841            	   753:     or.w    D1,D4
02:0002F55C 48C4            	   754:     ext.l   D4
02:0002F55E D8BC00FF0000    	   755:     add.l   #NES_RAM,D4
02:0002F564 2044            	   756:     movea.l D4,A0
02:0002F566 11803000        	   757:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   758:     ; Increment source address.
                            	   759:     ;
02:0002F56A 1014            	   760:     move.b  ($0000,A4),D0
02:0002F56C 023C00EE        	   761:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F570 123C0001        	   762:     move.b  #$01,D1
02:0002F574 D101            	   763:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F576 1880            	   764:     move.b  D0,($0000,A4)
02:0002F578 102C0001        	   765:     move.b  ($0001,A4),D0
02:0002F57C 123C0000        	   766:     move.b  #$00,D1
02:0002F580 D101            	   767:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F582 19400001        	   768:     move.b  D0,($0001,A4)
                            	   769:     ; Increment destination address.
                            	   770:     ;
02:0002F586 102C0002        	   771:     move.b  ($0002,A4),D0
02:0002F58A 023C00EE        	   772:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F58E 123C0001        	   773:     move.b  #$01,D1
02:0002F592 D101            	   774:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F594 19400002        	   775:     move.b  D0,($0002,A4)
02:0002F598 102C0003        	   776:     move.b  ($0003,A4),D0
02:0002F59C 123C0000        	   777:     move.b  #$00,D1
02:0002F5A0 D101            	   778:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F5A2 19400003        	   779:     move.b  D0,($0003,A4)
02:0002F5A6 0C00007F        	   780:     cmpi.b  #$7F,D0
02:0002F5AA 6684            	   781:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002F5AC 102C0002        	   782:     move.b  ($0002,A4),D0
02:0002F5B0 4A00            	   783:     cmpi.b  #$00,D0
02:0002F5B2 6600FF7C        	   784:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002F5B6 0A3C0001        	   785:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002F5BA 4E75            	   786:     rts
