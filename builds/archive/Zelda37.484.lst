02:0000E3EA 61000330        	   746:     bsr     _chr_convert_upload
02:0000E3EE 0839000500FF0804	   747:     btst    #5,(PPU_CTRL).l
02:0000E3F6 6716            	   748:     beq.s   .chr_uploaded
02:0000E3F8 303900FF0832    	   749:     move.w  (CHR_BUF_VADDR).l,D0
02:0000E3FE 0C401F20        	   750:     cmpi.w  #$1F20,D0
02:0000E402 650A            	   751:     blo.s   .chr_uploaded
02:0000E404 0C401F40        	   752:     cmpi.w  #$1F40,D0
02:0000E408 6404            	   753:     bhs.s   .chr_uploaded
