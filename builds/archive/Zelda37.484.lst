                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038D4A 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038D4E 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
