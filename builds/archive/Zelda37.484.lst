                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:00048468 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:0004846A 19400003        	  4946:     move.b  D0,($0003,A4)
02:0004846E 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:00048470 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:00048474 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:00048476 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:00048478 7600            	  4959:     moveq   #0,D3
02:0004847A 1600            	  4960:     move.b  D0,D3
02:0004847C 0C030001        	  4961:     cmpi.b  #$01,D3
02:00048480 6602            	  4962:     bne  _anon_z07_25
02:00048482 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
