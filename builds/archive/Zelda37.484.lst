                            	  5448:     ;
02:000487C2 6100F654        	  5449:     jsr     MoveObject
                            	  5450:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5451:     ; state to $40.
                            	  5452:     ;
02:000487C6 41EC0380        	  5453:     lea     ($0380,A4),A0
02:000487CA 53302000        	  5454:     subq.b  #1,(A0,D2.W)
02:000487CE 6614            	  5455:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5456:     even
                            	  5457: _L_z07_CheckState30_SetState40:
                            	  5458:     ; Set state $40, and a time to move of $20 frames.
                            	  5459:     ;
                            	  5460:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5461:     ;
                            	  5462:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5463:     ;
02:000487D0 7020            	  5464:     moveq   #32,D0
02:000487D2 41EC0380        	  5465:     lea     ($0380,A4),A0
02:000487D6 11802000        	  5466:     move.b  D0,(A0,D2.W)
02:000487DA 7040            	  5467:     moveq   #64,D0
02:000487DC 41EC00AC        	  5468:     lea     ($00AC,A4),A0
02:000487E0 11802000        	  5469:     move.b  D0,(A0,D2.W)
                            	  5470:     even
