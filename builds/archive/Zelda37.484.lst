                            	  5280: _L_z04_UpdatePolsVoice_State0:
                            	  5281:     ; State 0. Walking.
                            	  5282:     ;
                            	  5283:     ; If grid offset = 0, then no more distance to cover.
                            	  5284:     ; So, go change to state 1 -- jumping.
                            	  5285:     ;
02:0003A5D0 41EC0394        	  5286:     lea     ($0394,A4),A0
02:0003A5D4 10302000        	  5287:     move.b  (A0,D2.W),D0
02:0003A5D8 67000084        	  5288:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5289:     ; Decrement grid offset / distance remaining.
                            	  5290:     ;
02:0003A5DC 41EC0394        	  5291:     lea     ($0394,A4),A0
02:0003A5E0 53302000        	  5292:     subq.b  #1,(A0,D2.W)
                            	  5293:     ; Move vertically.
                            	  5294:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5295:     ;
02:0003A5E4 41EC0084        	  5296:     lea     ($0084,A4),A0
02:0003A5E8 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0003A5EC 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5F0 41F90003A580    	  5299:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A5F6 12303000        	  5300:     move.b  (A0,D3.W),D1
02:0003A5FA D101            	  5301:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A5FC 41EC0084        	  5302:     lea     ($0084,A4),A0
02:0003A600 11802000        	  5303:     move.b  D0,(A0,D2.W)
                            	  5304:     even
                            	  5305: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5306:     ; If the square the monster is over is walkable, then
                            	  5307:     ; go draw and check object collisions.
                            	  5308:     ;
02:0003A604 610001F4        	  5309:     jsr     PolsVoice_IsSquareWalkable
02:0003A608 6452            	  5310:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5311:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5312:     ; then go change to state 1.
                            	  5313:     ;
02:0003A60A 41EC041F        	  5314:     lea     ($041F,A4),A0
02:0003A60E 10302000        	  5315:     move.b  (A0,D2.W),D0
02:0003A612 020000FC        	  5316:     andi.b #$FC,D0
02:0003A616 0C0000B0        	  5317:     cmpi.b  #$B0,D0
02:0003A61A 6742            	  5318:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A61C 0C0000F4        	  5319:     cmpi.b  #$F4,D0
02:0003A620 643C            	  5320:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5321:     ; Else blocked by something else.
                            	  5322:     ;
                            	  5323:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5324:     ;
02:0003A622 41EC0098        	  5325:     lea     ($0098,A4),A0
02:0003A626 10302000        	  5326:     move.b  (A0,D2.W),D0
02:0003A62A 02000003        	  5327:     andi.b #$03,D0
02:0003A62E 6618            	  5328:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5329:     ; Else facing vertically. Flip the direction.
                            	  5330:     ; Go draw.
                            	  5331:     ;
02:0003A630 41EC0098        	  5332:     lea     ($0098,A4),A0
02:0003A634 10302000        	  5333:     move.b  (A0,D2.W),D0
02:0003A638 0A00000C        	  5334:     eori.b #$0C,D0
02:0003A63C 41EC0098        	  5335:     lea     ($0098,A4),A0
02:0003A640 11802000        	  5336:     move.b  D0,(A0,D2.W)
02:0003A644 6000008C        	  5337:     jmp     L_PolsVoice_DrawAndCheckCollisions
