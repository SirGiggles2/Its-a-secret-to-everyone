02:000484AC 41EC0098        	  4989:     lea     ($0098,A4),A0
02:000484B0 10302000        	  4990:     move.b  (A0,D2.W),D0
02:000484B4 0C0000E8        	  4991:     cmpi.b  #$E8,D0
