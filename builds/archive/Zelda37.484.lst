02:00047E58 10302000        	  3980:     move.b  (A0,D2.W),D0
02:00047E5C 123C0000        	  3981:     move.b  #$00,D1
02:00047E60 0A3C0010        	  3982:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E64 9101            	  3983:     subx.b  D1,D0   ; SBC #$00
02:00047E66 0A3C0010        	  3984:     eori    #$10,CCR  ; restore X = 6502 C
02:00047E6A 41EC0084        	  3985:     lea     ($0084,A4),A0
02:00047E6E 11802000        	  3986:     move.b  D0,(A0,D2.W)
