02:0003DF70 6748            	  2792:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2793:     ; The direction is negative (left or up).
                            	  2794:     ;
                            	  2795:     ; If the coordinate does not cross (<) the boundary, then
                            	  2796:     ; go set mask $FF, so that no button is excluded.
                            	  2797:     ;
02:0003DF72 102C0002        	  2798:     move.b  ($0002,A4),D0
02:0003DF76 41F90003DEEA    	  2799:     lea     (BorderBounds).l,A0
02:0003DF7C 12303000        	  2800:     move.b  (A0,D3.W),D1
02:0003DF80 B001            	  2801:     cmp.b   D1,D0
02:0003DF82 6548            	  2802:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2803:     even
