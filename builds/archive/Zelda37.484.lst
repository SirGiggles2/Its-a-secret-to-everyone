02:0004726C 41EC0305        	  2349:     lea     ($0305,A4),A0
02:00047270 11802000        	  2350:     move.b  D0,(A0,D2.W)
02:00047274 41EC0306        	  2351:     lea     ($0306,A4),A0
02:00047278 11802000        	  2352:     move.b  D0,(A0,D2.W)
02:0004727C 41EC030A        	  2353:     lea     ($030A,A4),A0
02:00047280 11802000        	  2354:     move.b  D0,(A0,D2.W)
02:00047284 41EC030B        	  2355:     lea     ($030B,A4),A0
02:00047288 11802000        	  2356:     move.b  D0,(A0,D2.W)
                            	  2357:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
