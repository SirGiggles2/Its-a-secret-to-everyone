02:0003DF00 1880            	  2717:     move.b  D0,($0000,A4)
                            	  2718:     ; Call GetOppositeDir again to use this mapping:
                            	  2719:     ; In Dir: 1 2 4 8
                            	  2720:     ;         -------
                            	  2721:     ; Index:  2 3 0 1
                            	  2722:     ;
02:0003DF02 4EB900030A56    	  2723:     jsr     GetOppositeDir
                            	  2724:     ; Get the appropriate coordinate for the direction:
                            	  2725:     ; X for horizontal
                            	  2726:     ; Y for vertical
                            	  2727:     ;
02:0003DF08 102C0070        	  2728:     move.b  ($0070,A4),D0
02:0003DF0C 0C030002        	  2729:     cmpi.b  #$02,D3
02:0003DF10 6404            	  2730:     bcc  _anon_z05_74
02:0003DF12 102C0084        	  2731:     move.b  ($0084,A4),D0
                            	  2732: _anon_z05_74:
02:0003DF16 19400002        	  2733:     move.b  D0,($0002,A4)
                            	  2734:     ; Mask A button and directions if inner border is crossed.
                            	  2735:     ;
02:0003DF1A 1003            	  2736:     move.b  D3,D0
02:0003DF1C 1B00            	  2737:     move.b  D0,-(A5)  ; PHA
02:0003DF1E 023C00EE        	  2738:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF22 123C0008        	  2739:     move.b  #$08,D1
02:0003DF26 D101            	  2740:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003DF28 7600            	  2741:     moveq   #0,D3
02:0003DF2A 1600            	  2742:     move.b  D0,D3
02:0003DF2C 103C0080        	  2743:     move.b  #$80,D0
02:0003DF30 6134            	  2744:     jsr     MaskInputInBorder
02:0003DF32 101D            	  2745:     move.b  (A5)+,D0  ; PLA
02:0003DF34 7600            	  2746:     moveq   #0,D3
02:0003DF36 1600            	  2747:     move.b  D0,D3
                            	  2748:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2749:     ; boundary using player's direction and reverse direction index.
                            	  2750:     ;
02:0003DF38 102C0001        	  2751:     move.b  ($0001,A4),D0
02:0003DF3C 0C0000FF        	  2752:     cmpi.b  #$FF,D0
02:0003DF40 660C            	  2753:     bne  _anon_z05_75
02:0003DF42 102C0098        	  2754:     move.b  ($0098,A4),D0
02:0003DF46 1880            	  2755:     move.b  D0,($0000,A4)
02:0003DF48 4EB900030A56    	  2756:     jsr     GetOppositeDir
                            	  2757: _anon_z05_75:
                            	  2758:     ; If in UW, use the second set of bounds by adding 4
                            	  2759:     ; to reverse direction index.
                            	  2760:     ;
                            	  2761:     ; Else in OW, and use first set that begins at offset 0.
                            	  2762:     ;
02:0003DF4E 102C0010        	  2763:     move.b  ($0010,A4),D0
02:0003DF52 6710            	  2764:     beq  _anon_z05_76
02:0003DF54 1003            	  2765:     move.b  D3,D0
02:0003DF56 023C00EE        	  2766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF5A 123C0004        	  2767:     move.b  #$04,D1
02:0003DF5E D101            	  2768:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DF60 7600            	  2769:     moveq   #0,D3
02:0003DF62 1600            	  2770:     move.b  D0,D3
                            	  2771: _anon_z05_76:
                            	  2772:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2773:     ;
02:0003DF64 7000            	  2774:     moveq   #0,D0
                            	  2775: ; Params:
                            	  2776: ; A: mask of buttons to block
                            	  2777: ; Y: offset into BorderBounds
                            	  2778: ; [00]: direction
                            	  2779: ; [02]: coordinate
                            	  2780: ;
                            	  2781: ; Returns:
                            	  2782: ; [01]: button mask that was used
                            	  2783: ;       (set to $FF if boundary not crossed)
                            	  2784: ;
                            	  2785:     even
                            	  2786: MaskInputInBorder:
02:0003DF66 19400001        	  2787:     move.b  D0,($0001,A4)
                            	  2788:     ; If direction is positive (right or down), then go handle it separately.
                            	  2789:     ;
02:0003DF6A 1014            	  2790:     move.b  ($0000,A4),D0
