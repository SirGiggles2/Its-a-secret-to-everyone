                            	  5410: L_PolsVoice_DrawAndCheckCollisions:
02:0003A6D2 7008            	  5411:     moveq   #8,D0
02:0003A6D4 4EB900049094    	  5412:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003A6DA 41EC03E4        	  5413:     lea     ($03E4,A4),A0
02:0003A6DE 10302000        	  5414:     move.b  (A0,D2.W),D0
02:0003A6E2 4EB900030E22    	  5415:     jsr     DrawObjectMirrored
                            	  5416:     ; Pols Voice is invincible to everything but the sword,
                            	  5417:     ; during normal collision detection.
