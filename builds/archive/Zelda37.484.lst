02:00038CB6 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038CBA 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038CBE 02000008        	  1782:     andi.b #$08,D0
02:00038CC2 6704            	  1783:     beq  _anon_z04_44
02:00038CC4 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
