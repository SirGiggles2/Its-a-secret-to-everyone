02:0003A6E8 103C00FE        	  5421:     move.b  #$FE,D0
02:0003A6EC 41EC04B2        	  5422:     lea     ($04B2,A4),A0
02:0003A6F0 11802000        	  5423:     move.b  D0,(A0,D2.W)
02:0003A6F4 4EB900031192    	  5424:     jsr     CheckMonsterCollisions
