02:00034E50 7413            	  4388:     moveq   #19,D2
02:00034E52 4EB900046FC6    	  4389:     jsr     AnimateItemObject
02:00034E58 7401            	  4390:     moveq   #1,D2
02:00034E5A 4EB90004909A    	  4391:     jsr     Anim_FetchObjPosForSpriteDescriptor
