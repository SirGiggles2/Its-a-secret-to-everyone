02:0000E65A 02450003        	  1095:     andi.w  #$0003,D5
02:0000E65E EB4D            	  1096:     lsl.w   #5,D5
02:0000E660 E14D            	  1097:     lsl.w   #8,D5
02:0000E662 5442            	  1098:     addq.w  #2,D2
02:0000E664 5443            	  1099:     addq.w  #2,D3
02:0000E666 610002AE        	  1100:     bsr     _attr_write_2x2
