02:0003CA5A 122C0098        	   563:     move.b  ($0098,A4),D1
02:0003CA5E C200            	   564:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CA60 6602            	   565:     bne.s  __far_z_05_0006
