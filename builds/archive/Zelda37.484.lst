02:00047980 669C            	  3237:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3238:     ; Set the current object slot to what it should be when we
                            	  3239:     ; begin updating objects again next frame: $B
                            	  3240:     ; the last object slot for monsters and tile objects
                            	  3241:     ;
                            	  3242:     ; Before the first frame of mode 5, the current object slot variable
                            	  3243:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3244:     ;
                            	  3245:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3246:     ;
02:00047982 700B            	  3247:     moveq   #11,D0
02:00047984 19400340        	  3248:     move.b  D0,($0340,A4)
