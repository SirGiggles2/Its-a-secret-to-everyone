02:0003CA72 123C0008        	   574:     move.b  #$08,D1
02:0003CA76 0A3C0010        	   575:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CA7A 9101            	   576:     subx.b  D1,D0   ; SBC #$08
02:0003CA7C 0A3C0010        	   577:     eori    #$10,CCR  ; restore X = 6502 C
