                            	   579: _anon_z05_11:
02:0003CA84 102C00E2        	   580:     move.b  ($00E2,A4),D0
02:0003CA88 023C00EE        	   581:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA8C 123C0020        	   582:     move.b  #$20,D1
02:0003CA90 D101            	   583:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
