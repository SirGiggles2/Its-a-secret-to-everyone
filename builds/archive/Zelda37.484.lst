02:0004841A 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:0004841E 1214            	  4902:     move.b  ($0000,A4),D1
02:00048420 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048424 9101            	  4904:     subx.b  D1,D0   ; SBC $00
