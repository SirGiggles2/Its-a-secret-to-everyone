02:0003BD5A 0C020007        	  8433:     cmpi.b  #$07,D2
02:0003BD5E 670A            	  8434:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003BD60 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0003BD64 02000003        	  8436:     andi.b #$03,D0
02:0003BD68 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
                            	  8439: _L_z04_Ganon_DrawBurst_Move:
02:0003BD6A 6100EDA2        	  8440:     jsr     BlueWizzrobe_Move
                            	  8441: _anon_z04_164:
02:0003BD6E 4EB90004909A    	  8442:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8443:     ; The frame counter will make the sprite flash.
                            	  8444:     ; The array has the horizontal and vertical flipping attributes.
                            	  8445:     ; Combine them into [03].
                            	  8446:     ;
02:0003BD74 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0003BD78 02000003        	  8448:     andi.b #$03,D0
02:0003BD7C 41F90003BC4C    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BD82 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BD86 8001            	  8451:     or.b  D1,D0
02:0003BD88 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BD8C 41F90003BC56    	  8453:     lea     (GanonBurstTiles).l,A0
02:0003BD92 10302000        	  8454:     move.b  (A0,D2.W),D0
02:0003BD96 4EB900031122    	  8455:     jsr     Anim_WriteSprite
                            	  8456:     ; Bottom of the loop.
                            	  8457:     ; Increment object slot while <= 9.
                            	  8458:     ;
02:0003BD9C 5202            	  8459:     addq.b  #1,D2
02:0003BD9E 0C02000A        	  8460:     cmpi.b  #$0A,D2
02:0003BDA2 65AC            	  8461:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8462:     ; Restore the object index.
                            	  8463:     ;
02:0003BDA4 101D            	  8464:     move.b  (A5)+,D0  ; PLA
02:0003BDA6 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BDAA 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BDAE 4E75            	  8467:     rts
                            	  8468: 
                            	  8469: ; Returns:
                            	  8470: ; [00]: X coordinate
                            	  8471: ;
                            	  8472:     even
