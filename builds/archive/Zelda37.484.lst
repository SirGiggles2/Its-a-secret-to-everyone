02:0003E684 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003E688 B001            	  3873:     cmp.b   D1,D0
02:0003E68A 6622            	  3874:     bne  _anon_z05_95
02:0003E68C 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003E690 41F90003E65C    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E696 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003E69A B001            	  3878:     cmp.b   D1,D0
02:0003E69C 6510            	  3879:     bcs  _anon_z05_95
02:0003E69E 41F90003E660    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E6A4 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E6A8 B001            	  3882:     cmp.b   D1,D0
02:0003E6AA 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
