                            	   195: ;==============================================================================
                            	   196: ; $000200 — Boot code
                            	   197: ;==============================================================================
                            	   198: 
                            	   199:     ; Stage-2a: named section; build/genesis.ld pins to $200.
                            	   200:     section "text",code
                            	   201: 
                            	   202: ;------------------------------------------------------------------------------
                            	   203: ; EntryPoint — 68000 reset vector lands here.
                            	   204: ; The 68000 boots with SR = $2700 (supervisor, all IRQs masked). We leave
                            	   205: ; interrupts masked through the entire init sequence and lower the mask at
                            	   206: ; the end of MainLoop via the STOP instruction.
                            	   207: ;------------------------------------------------------------------------------
                            	   208: EntryPoint:
                            	   209:     ;--------------------------------------------------------------------------
                            	   210:     ; TMSS handshake — check VERSION_PORT bit[0]; if set, this is a TMSS
                            	   211:     ; hardware revision that requires writing 'SEGA' ($53454741) to $A14000
                            	   212:     ; before VDP access is allowed. Safe to skip on pre-TMSS hardware.
                            	   213:     ;--------------------------------------------------------------------------
02:00000000 103900A10001    	   214:     move.b  (VERSION_PORT).l,D0
02:00000006 0200000F        	   215:     andi.b  #$0F,D0
02:0000000A 6710            	   216:     beq.s   .skip_tmss
02:0000000C 23FC5345474100A1	   217:     move.l  #$53454741,(TMSS_PORT).l   ; 'S','E','G','A'
02:00000014 4000
02:00000016 700F            	   218:     moveq   #15,D0
                            	   219: .tmss_delay:
02:00000018 51C8FFFE        	   220:     dbra    D0,.tmss_delay              ; ~80 cycles delay for VDP unlock
                            	   221: .skip_tmss:
                            	   222: 
                            	   223:     ;--------------------------------------------------------------------------
                            	   224:     ; Stop Z80 — hold it in reset to prevent bus contention during init.
                            	   225:     ;--------------------------------------------------------------------------
02:0000001C 33FC010000A11100	   226:     move.w  #$0100,(Z80_BUSREQ).l
02:00000024 33FC010000A11200	   227:     move.w  #$0100,(Z80_RESET).l
                            	   228: .z80wait:
02:0000002C 0839000000A11100	   229:     btst    #0,(Z80_BUSREQ).l            ; BUSACK = bit 0 of high byte $A11100;
02:00000034 66F6            	   230:     bne.s   .z80wait                    ; wait until Z80 releases the bus
                            	   231: 
                            	   232:     ;--------------------------------------------------------------------------
                            	   233:     ; VDP register init — H32 mode, display OFF during init.
                            	   234:     ;
                            	   235:     ; COLORFIX: Reg 0 = $8004. bit 2 MUST BE 1.
                            	   236:     ;   $8000 (bit2=0) → dingy/dark colors on hardware despite correct CRAM.
                            	   237:     ;   $8004 (bit2=1) → correct colors.
                            	   238:     ;--------------------------------------------------------------------------
02:00000036 33FC800400C00004	   239:     move.w  #$8004,(VDP_CTRL).l  ; Reg  0: bit2=1 (colorfix), no H-int, no left-blank
02:0000003E 33FC813400C00004	   240:     move.w  #$8134,(VDP_CTRL).l  ; Reg  1: display OFF, VBlank IRQ, DMA, M5 (Genesis)
02:00000046 33FC823000C00004	   241:     move.w  #$8230,(VDP_CTRL).l  ; Reg  2: Plane A @ $C000  ($C000/$2000=6 → $30)
02:0000004E 33FC832C00C00004	   242:     move.w  #$832C,(VDP_CTRL).l  ; Reg  3: Window  @ $B000  (bits[5:1]=22 → $2C)
02:00000056 33FC840700C00004	   243:     move.w  #$8407,(VDP_CTRL).l  ; Reg  4: Plane B @ $E000  ($E000/$2000=7 → $07)
02:0000005E 33FC857C00C00004	   244:     move.w  #$857C,(VDP_CTRL).l  ; Reg  5: Sprite table @ $F800 ($F800/$200=124 → $7C)
02:00000066 33FC860000C00004	   245:     move.w  #$8600,(VDP_CTRL).l  ; Reg  6: sprite table high bit = 0
02:0000006E 33FC870000C00004	   246:     move.w  #$8700,(VDP_CTRL).l  ; Reg  7: BG color = palette 0, color 0
02:00000076 33FC880000C00004	   247:     move.w  #$8800,(VDP_CTRL).l  ; Reg  8: SMS compat = 0 (unused in M5)
02:0000007E 33FC890000C00004	   248:     move.w  #$8900,(VDP_CTRL).l  ; Reg  9: SMS compat = 0 (unused in M5)
02:00000086 33FC8AFF00C00004	   249:     move.w  #$8AFF,(VDP_CTRL).l  ; Reg 10: H-int counter = $FF (effectively disabled)
02:0000008E 33FC8B0000C00004	   250:     move.w  #$8B00,(VDP_CTRL).l  ; Reg 11: full-screen V-scroll, full H-scroll
02:00000096 33FC8C0000C00004	   251:     move.w  #$8C00,(VDP_CTRL).l  ; Reg 12: H32 (bits7,0=0), no interlace, no shadow/hl
02:0000009E 33FC8D3F00C00004	   252:     move.w  #$8D3F,(VDP_CTRL).l  ; Reg 13: H-scroll table @ $FC00 ($FC00/$400=63 → $3F)
02:000000A6 33FC8E0000C00004	   253:     move.w  #$8E00,(VDP_CTRL).l  ; Reg 14: pattern gen base = 0 (SMS compat, unused M5)
02:000000AE 33FC8F0200C00004	   254:     move.w  #$8F02,(VDP_CTRL).l  ; Reg 15: auto-increment = 2 (word per VRAM access)
02:000000B6 33FC901100C00004	   255:     move.w  #$9011,(VDP_CTRL).l  ; Reg 16: scroll size 64H × 64V → $11
02:000000BE 33FC910000C00004	   256:     move.w  #$9100,(VDP_CTRL).l  ; Reg 17: window H position = 0 (H window off)
                            	   257:     ; Phase 2 v2: enable Window for top 8 rows (HUD isolation).
                            	   258:     ; $2000-$20FF NES nametable writes (rows 0-7) route to Window at $B000
                            	   259:     ; via _ppu_write_7 AND _transfer_tilebuf_fast HUD branches.  Plane A
                            	   260:     ; bulk writes to rows 0-7 stay at $C000 — invisible under Window overlay.
02:000000C6 33FC920800C00004	   261:     move.w  #$9208,(VDP_CTRL).l  ; Reg 18: window V position = 8 (covers rows 0-7)
                            	   262:     ; Regs 19-23 (DMA) intentionally SKIPPED — writing reg 23 arms the
                            	   263:     ; VDP DMA pending state on real hardware, causing subsequent CRAM/VRAM
                            	   264:     ; commands to be intercepted as DMA triggers.  DMA regs default to 0
                            	   265:     ; and must only be written immediately before a DMA operation.
                            	   266: 
                            	   267:     ;--------------------------------------------------------------------------
                            	   268:     ; Phase 6.2: Clear VRAM via VDP DMA fill.
                            	   269:     ; With display off and no other DMA pending, a single 64 KB byte-fill
                            	   270:     ; completes in ~38 µs on real hardware (vs. ~3.5 ms for the previous
                            	   271:     ; 32768-word CPU loop), reclaiming ~6 frames of boot time.
                            	   272:     ;
                            	   273:     ; Sequence:
                            	   274:     ;   1. Reg 15 (auto-increment) = 1 → byte stride for the fill.
                            	   275:     ;   2. Regs 19/20 (DMA length low/high) = 0 → documented VDP quirk:
                            	   276:     ;      length $0000 means "fill 65536 bytes" (full 64 KB).
                            	   277:     ;   3. Reg 23 (DMA source high) = $80 → VRAM-fill mode.
                            	   278:     ;   4. Write address command to VDP_CTRL with DMA bit (CD5=1) set.
                            	   279:     ;   5. Write fill word to VDP_DATA — DMA begins using the upper byte as
                            	   280:     ;      the fill value.  We write $0000 so the fill byte is $00.
                            	   281:     ;   6. Poll VDP status until DMA-busy bit (bit 1) clears.
                            	   282:     ;   7. Restore auto-increment to 2 for normal word writes later.
                            	   283:     ;--------------------------------------------------------------------------
02:000000CE 33FC8F0100C00004	   284:     move.w  #$8F01,(VDP_CTRL).l  ; Reg 15: auto-increment = 1 (byte stride)
02:000000D6 33FC930000C00004	   285:     move.w  #$9300,(VDP_CTRL).l  ; Reg 19: DMA length low  = $00
02:000000DE 33FC940000C00004	   286:     move.w  #$9400,(VDP_CTRL).l  ; Reg 20: DMA length high = $00 ($0000 = 65536)
02:000000E6 33FC978000C00004	   287:     move.w  #$9780,(VDP_CTRL).l  ; Reg 23: DMA mode = VRAM fill
02:000000EE 23FC4000008000C0	   288:     move.l  #$40000080,(VDP_CTRL).l  ; VRAM write $0000 + DMA bit (CD5=1)
02:000000F6 0004
02:000000F8 33FC000000C00000	   289:     move.w  #$0000,(VDP_DATA).l  ; Fill byte = upper byte = $00; DMA begins
                            	   290: .vram_dma_wait:
02:00000100 303900C00004    	   291:     move.w  (VDP_CTRL).l,D0
02:00000106 08000001        	   292:     btst    #1,D0                ; bit 1 = DMA busy
02:0000010A 66F4            	   293:     bne.s   .vram_dma_wait
02:0000010C 33FC8F0200C00004	   294:     move.w  #$8F02,(VDP_CTRL).l  ; Reg 15: restore auto-increment = 2
                            	   295: 
                            	   296:     ;--------------------------------------------------------------------------
                            	   297:     ; Plane B blank fill — use tile $05FF (VRAM $BFE0) as a dedicated blank.
                            	   298:     ; Tile $05FF lives in the gap between Zelda CHR ($0000-$BE00 worst case)
                            	   299:     ; and Plane A nametable ($C000), so Zelda's dynamic CHR uploads never
                            	   300:     ; stomp it. Upload 32 zero bytes to tile $05FF explicitly (VRAM is already
                            	   301:     ; zeroed above, but we re-assert post-CHR-load safety by keeping the tile
                            	   302:     ; outside the Zelda CHR window). Fill plane B with tile index $05FF.
                            	   303:     ; This replaces tile $0200, which was inside Zelda's BG CHR bank and
                            	   304:     ; held octorok-sprite data after CHR upload → visible blue-checker
                            	   305:     ; leak through transparent plane A pixels during intro story scroll.
                            	   306:     ;--------------------------------------------------------------------------
02:00000114 23FCBFE0000300C0	   307:     move.l  #$BFE00003,(VDP_CTRL).l  ; VRAM write to $BFE0 (tile $5FF data)
02:0000011C 0004
02:0000011E 700F            	   308:     moveq   #15,D0
                            	   309: .blank_tile_fill:
02:00000120 33FC000000C00000	   310:     move.w  #0,(VDP_DATA).l
02:00000128 51C8FFF6        	   311:     dbra    D0,.blank_tile_fill
                            	   312:     ;--------------------------------------------------------------------------
                            	   313:     ; Plane B fill — 2048 words of tile $05FF.
                            	   314:     ; Phase 6.3 (VRAM→VRAM DMA propagate-copy) was attempted here but caused
                            	   315:     ; an ExcBusError under gpgx; reverted to the CPU loop since the savings
                            	   316:     ; (~0.3 frames) aren't worth risking the baseline.
                            	   317:     ;--------------------------------------------------------------------------
02:0000012C 23FC6000000300C0	   318:     move.l  #$60000003,(VDP_CTRL).l  ; VRAM write to $E000 (plane B map)
02:00000134 0004
02:00000136 303C07FF        	   319:     move.w  #2047,D0
                            	   320: .planeb_fill:
02:0000013A 33FC05FF00C00000	   321:     move.w  #$05FF,(VDP_DATA).l
02:00000142 51C8FFF6        	   322:     dbra    D0,.planeb_fill
                            	   323: 
                            	   324:     ;--------------------------------------------------------------------------
                            	   325:     ; Phase 2 v2: fill Window nametable at $B000 with blank tile $05FF.
                            	   326:     ; Without this, Window (now active top 8 rows) renders tile index $0000
                            	   327:     ; (CHR tile 0) = garbage art before game writes HUD content.
                            	   328:     ; Window map is 32x32 = 1024 bytes = 512 words.
                            	   329:     ; VDP cmd $70000002: $B000 A[15:14]=10, addr13-0=$3000, lower word=2.
                            	   330:     ;--------------------------------------------------------------------------
02:00000146 23FC7000000200C0	   331:     move.l  #$70000002,(VDP_CTRL).l  ; VRAM write to $B000 (Window map)
02:0000014E 0004
02:00000150 303C01FF        	   332:     move.w  #511,D0
                            	   333: .window_fill:
02:00000154 33FC05FF00C00000	   334:     move.w  #$05FF,(VDP_DATA).l
02:0000015C 51C8FFF6        	   335:     dbra    D0,.window_fill
                            	   336: 
                            	   337:     ;--------------------------------------------------------------------------
                            	   338:     ; Write test palette — pure green to CRAM[0] (background color slot).
                            	   339:     ; Reg 7 above set background = palette 0, color 0 → CRAM entry 0.
                            	   340:     ;
                            	   341:     ; Result on screen: solid green = VDP init correct (colorfix working).
                            	   342:     ; Dingy/dark green = check that Reg 0 is $8004, NOT $8000.
                            	   343:     ;--------------------------------------------------------------------------
02:00000160 23FCC000000000C0	   344:     move.l  #CRAM_WRITE_0000,(VDP_CTRL).l
02:00000168 0004
02:0000016A 33FC00E000C00000	   345:     move.w  #COLOR_GREEN,(VDP_DATA).l
                            	   346: 
                            	   347:     ;--------------------------------------------------------------------------
                            	   348:     ; Display on
                            	   349:     ;--------------------------------------------------------------------------
02:00000172 33FC817400C00004	   350:     move.w  #$8174,(VDP_CTRL).l  ; Reg 1: DISP=1, VBlank IRQ, DMA, M5
                            	   351: 
                            	   352:     ;--------------------------------------------------------------------------
                            	   353:     ; Clear NES RAM ($FF0000–$FF07FF) — 2KB of NES work RAM mapped into
                            	   354:     ; Genesis RAM at the top of the address space.
                            	   355:     ; Also clears PPU state block ($FF0800–$FF080F) in the same pass.
                            	   356:     ;--------------------------------------------------------------------------
02:0000017A 207C00FF0000    	   357:     movea.l #NES_RAM_BASE,A0
02:00000180 303C041F        	   358:     move.w  #(NES_RAM_SIZE+PPU_STATE_SIZE)/2-1,D0  ; 1031 words
                            	   359: .nesramclear:
02:00000184 30FC0000        	   360:     move.w  #0,(A0)+
02:00000188 51C8FFFA        	   361:     dbra    D0,.nesramclear
                            	   362: 
                            	   363:     ; Phase 1: clear SAT_SHADOW double-buffer + SAT_ACTIVE_BANK flag.
                            	   364:     ; Genesis sprite Y=0 lies 128px above screen → all shadow sprites start
                            	   365:     ; off-screen.  First _oam_dma fill overrides with real game state.
02:0000018C 207C00FF2000    	   366:     movea.l #SAT_SHADOW_A,A0
02:00000192 303C01FF        	   367:     move.w  #(SAT_SHADOW_SIZE*2)/2-1,D0   ; 2 banks × 512 bytes → 512 words
                            	   368: .sat_shadow_clear:
02:00000196 30FC0000        	   369:     move.w  #0,(A0)+
02:0000019A 51C8FFFA        	   370:     dbra    D0,.sat_shadow_clear
02:0000019E 423900FF2400    	   371:     clr.b   (SAT_ACTIVE_BANK).l            ; start with bank A active
                            	   372: 
                            	   373:     ;--------------------------------------------------------------------------
                            	   374:     ; T4: Initialize NES register equivalents before handing off to Zelda code.
                            	   375:     ;
                            	   376:     ;   A4 = NES_RAM_BASE ($FF0000) — base for all (offset,A4) NES RAM accesses
                            	   377:     ;   A5 = NES_STACK_INIT ($FF0200) — NES stack starts at SP=$FF, so the
                            	   378:     ;        first PHA decrements to $FF01FF.  A5 points one-past the top.
                            	   379:     ;   D7 = $FF — 6502 SP shadow (used by TSX/TXS and stack bound checks)
                            	   380:     ;--------------------------------------------------------------------------
02:000001A4 287C00FF0000    	   381:     movea.l #NES_RAM_BASE,A4
02:000001AA 2A7C00FF0200    	   382:     movea.l #NES_STACK_INIT,A5
02:000001B0 7EFF            	   383:     moveq   #-1,D7                  ; D7 = $FF (NES SP shadow)
                            	   384: 
02:000001B2 6100025C        	   385:     jsr     audio_init              ; Initialize YM2612 + PSG
                            	   386: 
                            	   387:     ; Request the title/demo song on boot as a smoke test for the native
                            	   388:     ; M68K music player.  music_tick (called from VBlank) will pick this
                            	   389:     ; up on the first frame after SR is lowered.
02:000001B6 13FC008000FFE001	   390:     move.b  #$80,(m_song_req).l
                            	   391: 
                            	   392:     ; Pre-write tile buffer sentinel so the first NMI's TransferCurTileBuf
                            	   393:     ; doesn't parse zeroed RAM as phantom records.  DynTileBuf = NES $0302.
02:000001BE 197C00FF0302    	   394:     move.b  #$FF,($0302,A4)
                            	   395: 
                            	   396:     ; Seed LAST_GAMEMODE to $FF so the first _mode_transition_check always
                            	   397:     ; fires a transition (harmless because PPU latches are already zero but
                            	   398:     ; forces a clean VSRAM init).
02:000001C4 13FC00FF00FF083E	   399:     move.b  #$FF,($00FF083E).l       ; LAST_GAMEMODE
02:000001CC 13FC00FF00FF083F	   400:     move.b  #$FF,(_current_window_bank).l ; P33: force first bank-window copy
                            	   401: 
                            	   402:     ;--------------------------------------------------------------------------
                            	   403:     ; Phase 9.7 — Cartridge SRAM declared in header at $1B0-$1BB.  The header
                            	   404:     ; alone is enough for gpgx to allocate the SRAM domain, but writes to
                            	   405:     ; $200001+ via the M68K bus are routed to ROM unless the SRAM mapper
                            	   406:     ; port at $A130F1 is set to $01 (verified by bizhawk_sram_smoke probe:
                            	   407:     ; without the port write the bus reads back $FF, with it the writes
                            	   408:     ; persist into the gpgx SRAM domain).
                            	   409:     ;--------------------------------------------------------------------------
                            	   410:     ;--------------------------------------------------------------------------
                            	   411:     ; Controller port 1 — set TH pin as output once during init.
                            	   412:     ; Doing this inside _ctrl_strobe on every call caused rapid CTRL-register
                            	   413:     ; writes that destabilised the 3-button pad multiplexer on real hardware,
                            	   414:     ; producing inconsistent reads that trapped the ReadOneController
                            	   415:     ; debounce loop in an infinite retry → d-pad freeze while held.
                            	   416:     ;--------------------------------------------------------------------------
02:000001D4 13FC004000A10009	   417:     move.b  #$40,($A10009).l        ; Port 1 CTRL: bit6 (TH) = output
02:000001DC 13FC004000A10003	   418:     move.b  #$40,($A10003).l        ; Port 1 DATA: TH=1 (idle state)
                            	   419: 
02:000001E4 13FC000100A130F1	   420:     move.b  #$01,($A130F1).l        ; SRAM mapper enable (write-only port)
                            	   421:     ; Phase 9.7 SRAM self-test: write a sentinel pattern to the LAST four
                            	   422:     ; odd-byte slots of cart SRAM ($203FF9/$203FFB/$203FFD/$203FFF).  This
                            	   423:     ; lives at the very end of the declared SRAM window, far away from
                            	   424:     ; the NES save-slot range that Phase 9.8 will use ($200001-$200CFF
                            	   425:     ; covering NES $6000-$67FF).  Purpose: gives the smoke probe a
                            	   426:     ; deterministic check that the M68K bus path actually writes through
                            	   427:     ; the cart mapper into the gpgx SRAM file (BizHawk's Lua "M68K BUS"
                            	   428:     ; domain bypasses the mapper and is unreliable for this).
02:000001EC 13FC005A00203FF9	   429:     move.b  #$5A,($203FF9).l
02:000001F4 13FC00A500203FFB	   430:     move.b  #$A5,($203FFB).l
02:000001FC 13FC00C300203FFD	   431:     move.b  #$C3,($203FFD).l
02:00000204 13FC003C00203FFF	   432:     move.b  #$3C,($203FFF).l
                            	   433:     ; Phase 9.8 — Restore the three NES save slots (NES $6000-$67FF) from
                            	   434:     ; cart SRAM into the work-RAM mirror at $FF6000 BEFORE Zelda runs.
                            	   435:     ; The mirror is what z_02 reads/writes via NES_SRAM equ $FF6000.
                            	   436:     ; Without this restore, every cold boot would see all-$FF SRAM data.
02:0000020C 4EB90002AB92    	   437:     jsr     _sram_load_save_slots
                            	   438: 
                            	   439:     ; Native intro path is the boot default. vblank_mode is flipped to 1
                            	   440:     ; by the Start handoff trampoline (Task 9) immediately before resuming
                            	   441:     ; the translated main loop.
02:00000212 13FC000000FF0FFC	   442:     move.b  #0,(vblank_mode).l
02:0000021A 42B900FF0FF8    	   443:     clr.l   (s_intro_frame_counter).l
                            	   444: 
                            	   445:     ;--------------------------------------------------------------------------
                            	   446:     ; Lower interrupt mask so VBlank (level 6) can fire.
                            	   447:     ; A4/A5/D7 are initialised above — IsrNmi is now safe to execute.
                            	   448:     ; IPL=0: all interrupt levels pass (VBlank=6, NMI-like=7).
                            	   449:     ;--------------------------------------------------------------------------
02:00000220 027CF8FF        	   450:     andi.w  #$F8FF,SR               ; IPL → 0: enable VBlank
                            	   451: 
                            	   452:     ;--------------------------------------------------------------------------
                            	   453:     ; Hand off to Zelda — jump to IsrReset (the NES Reset vector handler).
                            	   454:     ; IsrReset polls PPU $2002 (VBlank) twice, initialises MMC1, then jumps
                            	   455:     ; to RunGame which spins in LoopForever waiting for VBlank NMI.
                            	   456:     ;
                            	   457:     ; NOTE: VBlankISR below is wired to IsrNmi once T4 is validated.
                            	   458:     ; For T4, VBlank is masked by genesis boot SR ($2700) and IsrReset's SEI
                            	   459:     ; (now a NOP), so LoopForever just spins — that is the expected T4 state.
                            	   460:     ;--------------------------------------------------------------------------
02:00000224 4EB900000000    	   461:     jsr     intro_main          ; native intro owns the loop now
                            	   462: 
                            	   463:     ;--------------------------------------------------------------------------
                            	   464:     ; Safety net — should never be reached.
                            	   465:     ;--------------------------------------------------------------------------
                            	   466: HaltForever:
02:0000022A 4E722700        	   467:     stop    #$2700
02:0000022E 60FA            	   468:     bra.s   HaltForever
                            	   469: 
                            	   470: ;==============================================================================
                            	   471: ; VBlankISR — T4: call IsrNmi (Zelda's NMI handler) then return.
                            	   472: ; IsrNmi is defined in zelda_translated/z_07.asm (included below).
                            	   473: ;
                            	   474: ; T4 note: during boot, SR=$2700 so this ISR never fires while IsrReset runs.
                            	   475: ; Once RunGame hits LoopForever and we lower SR (T5+), this fires every frame.
                            	   476: ;==============================================================================
                            	   477: VBlankISR:
02:00000230 48E7FFFE        	   478:     movem.l D0-D7/A0-A6,-(SP)
02:00000234 4A3900FF0FFC    	   479:     tst.b   (vblank_mode).l
02:0000023A 660C            	   480:     bne.s   .vbi_transpiled
                            	   481:     ; --- native intro path: music + frame counter only ---
02:0000023C 6100045A        	   482:     bsr     music_tick
02:00000240 52B900FF0FF8    	   483:     addq.l  #1,(s_intro_frame_counter).l
02:00000246 6038            	   484:     bra.s   .vbi_done
                            	   485: .vbi_transpiled:
                            	   486:     ; --- existing transpiled path (unchanged) ---
                            	   487:     ; Only call IsrNmi if PPUCTRL bit 7 = 1 (NMI enable).
                            	   488:     ; On NES, VBlank NMI fires only when PPUCTRL.$80 is set.
                            	   489:     ; During IsrReset warmup PPUCTRL=0, so IsrNmi is suppressed
                            	   490:     ; until RunGame writes $A0 to $2000.
02:00000248 0839000700FF0804	   491:     btst    #7,($00FF0804).l        ; PPU_CTRL = $FF0804, bit 7 = NMI enable
02:00000250 672E            	   492:     beq.s   .vbi_done
02:00000252 523900FF1003    	   493:     addq.b  #1,($00FF1003).l        ; Phase 2.4: NMI probe counter
                            	   494:     ; Phase 1 (HW adoption): flush previous frame's SAT_SHADOW to VRAM $F800
                            	   495:     ; via 68k→VRAM DMA.  Must run before _ags_prearm/IsrNmi so the DMA
                            	   496:     ; trigger fires early in vblank (IsrNmi can extend into active display).
                            	   497:     ; _oam_dma_flush also flips SAT_ACTIVE_BANK so the NEXT IsrNmi fill
                            	   498:     ; populates the other bank.
02:00000258 4EB90002AD0E    	   499:     bsr     _oam_dma_flush
                            	   500:     ; Pre-arm pending VSRAM + H-int state from previous frame's _ags_flush.
                            	   501:     ; Must run BEFORE IsrNmi: IsrNmi can extend into active display past
                            	   502:     ; scanline 40, so doing the VDP writes after-the-fact (inside _ags_flush)
                            	   503:     ; misses the pinned-title band. _ags_prearm guarantees the write lands
                            	   504:     ; in vblank.
02:0000025E 4EB90000E1E0    	   505:     bsr     _ags_prearm
                            	   506:     ; Phase 1 mode-transition purge — catches GameMode changes and zeroes
                            	   507:     ; PPU latches + direct-writes VSRAM[0]/[1] inside the blanking window
                            	   508:     ; so VSRAM bleed from the prior mode cannot contaminate the first frame
                            	   509:     ; of the new mode.  Must run BEFORE IsrNmi (IsrNmi would otherwise
                            	   510:     ; apply the stale scroll shadows mid-NMI).
02:00000264 4EB90000E2DC    	   511:     bsr     _mode_transition_check
02:0000026A 4EB900046BA8    	   512:     jsr     IsrNmi
                            	   513:     ; Stage 2b: C-runtime heartbeat. Confirms the gcc/ld/objcopy
                            	   514:     ; toolchain integration is live. Observable at &c_probe_counter
                            	   515:     ; (address in whatif.lst — .bss region $FFC000+). void(void);
                            	   516:     ; standard SysV m68k ABI clobbers D0/D1/A0/A1 and no NES regs.
02:00000270 4EB900000000    	   517:     jsr     c_probe_tick
                            	   518:     ; Advance the native music player one tick (YM2612 + PSG writes).
                            	   519:     ; Mirrors the original NES engine which drove music from NMI.
02:00000276 61000420        	   520:     bsr     music_tick
                            	   521:     ; Flush PPU scroll shadows → VDP VSRAM / H-scroll / H-int queue.
                            	   522:     ; Deferred to here (post-NMI, still in VBlank) so the two transpiler-
                            	   523:     ; injected `bsr _apply_genesis_scroll` sites inside IsrNmi cannot
                            	   524:     ; double-program the VDP mid-NMI. _ags_flush reads CurVScroll/
                            	   525:     ; CurHScroll/IsSprite0CheckActive from NES zero-page via A4, which
                            	   526:     ; VBlankISR's movem preserved from the interrupted caller (RunGame
                            	   527:     ; establishes A4 = $FF0000 before LoopForever).
02:0000027A 4EB90000E1B0    	   528:     bsr     _ags_flush
                            	   529: .vbi_done:
02:00000280 4CDF7FFF        	   530:     movem.l (SP)+,D0-D7/A0-A6
02:00000284 4E73            	   531:     rte
                            	   532: 
                            	   533: ;==============================================================================
                            	   534: ; HBlankISR — queue-popping H-int dispatcher + DMC DAC streamer.
                            	   535: ;
                            	   536: ; Two fundamentally different uses of HINT now share this ISR:
                            	   537: ;
                            	   538: ;   (a) Scroll splits.  1-2 HINTs per frame fire at specific lines, drain
                            	   539: ;       the HINT_Q* queue, write VSRAM, then self-disable HINT via reg 0.
                            	   540: ;       This is the original behaviour, unchanged.
                            	   541: ;
                            	   542: ;   (b) DMC DAC streaming.  While audio_driver's dmc_trigger is active,
                            	   543: ;       HINT is armed every line (reg 10 = 0) and this ISR streams one PCM
                            	   544: ;       byte per fire to YM2612 reg $2A.  Detected by dmc_active != 0 at
                            	   545: ;       ISR entry.  In DMC mode we bypass the scroll queue entirely —
                            	   546: ;       title screen and intro don't use scroll splits anyway.
                            	   547: ;
                            	   548: ; Detection is at the very top of the ISR so the DMC path has minimal
                            	   549: ; latency.  dmc_hint_tick is defined in audio_driver.asm and handles the
                            	   550: ; full stream-one-byte-or-end-of-sample logic.
                            	   551: ;
                            	   552: ; State contract for scroll-path (unchanged):
                            	   553: ;   _ags_flush   writes NEXT-frame staged state (STAGED_*)
                            	   554: ;   _ags_prearm  promotes STAGED_* -> active HINT_Q* before display starts
                            	   555: ;   HINT_Q_COUNT ≥ 1 when H-int is armed via Reg 0 bit 4 for the CURRENT frame
                            	   556: ;   HINT_Q0_CTR  = initial Reg 10 value for the current frame
                            	   557: ;   HINT_Q0_VSRAM = VSRAM value to write when the current frame's H-int fires
                            	   558: ;   HINT_Q1_* remain available for future chained events
                            	   559: ;==============================================================================
                            	   560: HBlankISR:
02:00000286 4A3900FFE100    	   561:     tst.b   (dmc_active).l                  ; DMC streaming?
02:0000028C 670E            	   562:     beq.s   .scroll_path                    ; no → scroll queue handler
02:0000028E 48E78080        	   563:     movem.l D0/A0,-(SP)
02:00000292 610003A6        	   564:     bsr     dmc_hint_tick
02:00000296 4CDF0101        	   565:     movem.l (SP)+,D0/A0
02:0000029A 4E73            	   566:     rte
                            	   567: 
                            	   568: .scroll_path:
02:0000029C 48E7C080        	   569:     movem.l D0-D1/A0,-(SP)
02:000002A0 41F900FF0816    	   570:     lea     (HINT_Q_COUNT).l,A0
02:000002A6 1010            	   571:     move.b  (A0),D0
02:000002A8 6738            	   572:     beq.s   .hi_disable                     ; defensive: empty queue
02:000002AA 5310            	   573:     subq.b  #1,(A0)                         ; decrement remaining count
                            	   574:     ; Write queued VSRAM FIRST (critical path)
02:000002AC 23FC4000001000C0	   575:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:000002B4 0004
02:000002B6 33F900FF081800C0	   576:     move.w  (HINT_Q0_VSRAM).l,(VDP_DATA).l
02:000002BE 0000
                            	   577:     ; If another event is pending, re-arm Reg 10 and promote Q1 → Q0
02:000002C0 4A10            	   578:     tst.b   (A0)
02:000002C2 671E            	   579:     beq.s   .hi_disable
02:000002C4 7200            	   580:     moveq   #0,D1
02:000002C6 123900FF081A    	   581:     move.b  (HINT_Q1_CTR).l,D1
02:000002CC 827C8A00        	   582:     or.w    #$8A00,D1
02:000002D0 33C100C00004    	   583:     move.w  D1,(VDP_CTRL).l                 ; Reg 10 = delta to next event
02:000002D6 33F900FF081C00FF	   584:     move.w  (HINT_Q1_VSRAM).l,(HINT_Q0_VSRAM).l
02:000002DE 0818
02:000002E0 6008            	   585:     bra.s   .hi_done
                            	   586: .hi_disable:
02:000002E2 33FC800400C00004	   587:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: disable H-int
                            	   588: .hi_done:
02:000002EA 4CDF0103        	   589:     movem.l (SP)+,D0-D1/A0
02:000002EE 4E73            	   590:     rte
                            	   591: 
                            	   592: ;==============================================================================
                            	   593: ; Exception forensics handlers
                            	   594: ;
                            	   595: ; On any exception: save type, stacked SR, faulting PC, and all data/address
                            	   596: ; registers to a known RAM block at $FF0900 before spinning.  The T5 probe
                            	   597: ; (and BizHawk debugger) can then read this block to identify the fault.
                            	   598: ;
                            	   599: ; 68000 stack frames:
                            	   600: ;   Bus Error (vec 2) / Address Error (vec 3):
                            	   601: ;     SP+0  function code / misc (word)
                            	   602: ;     SP+2  access address (long)
                            	   603: ;     SP+6  instruction register (word)
                            	   604: ;     SP+8  SR at exception time
                            	   605: ;     SP+10 PC of faulting instruction (long)
                            	   606: ;   All other exceptions:
                            	   607: ;     SP+0  SR at exception time
                            	   608: ;     SP+2  PC of faulting instruction (long)
                            	   609: ;
                            	   610: ; Forensics RAM layout ($FF0900):
                            	   611: ;   $FF0900: exception type byte (2=bus error, 3=addr error, 0=other)
                            	   612: ;   $FF0901: (pad)
                            	   613: ;   $FF0902: stacked SR (word)
                            	   614: ;   $FF0904: faulting PC (long)
                            	   615: ;   $FF0908: D0–D7, A0–A6 saved by MOVEM.L (15 longs = 60 bytes, ends $FF0943)
                            	   616: ;==============================================================================
                            	   617: 
                            	   618: ExcBusError:
02:000002F0 13FC000200FF0900	   619:     move.b  #2,($FF0900).l
02:000002F8 33EF000800FF0902	   620:     move.w  8(SP),($FF0902).l
02:00000300 23EF000A00FF0904	   621:     move.l  10(SP),($FF0904).l
02:00000308 48F97FFF00FF0908	   622:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   623: .spin:
02:00000310 60FE            	   624:     bra.s   .spin
                            	   625: 
                            	   626: ExcAddrError:
02:00000312 13FC000300FF0900	   627:     move.b  #3,($FF0900).l
02:0000031A 33EF000800FF0902	   628:     move.w  8(SP),($FF0902).l           ; SR
02:00000322 23EF000A00FF0904	   629:     move.l  10(SP),($FF0904).l          ; PC
02:0000032A 33D700FF0944    	   630:     move.w  0(SP),($FF0944).l           ; status word
02:00000330 23EF000200FF0946	   631:     move.l  2(SP),($FF0946).l           ; access address (faulting addr)
02:00000338 33EF000600FF094A	   632:     move.w  6(SP),($FF094A).l           ; instruction register (opcode)
02:00000340 48F97FFF00FF0908	   633:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   634: .spin:
02:00000348 60FE            	   635:     bra.s   .spin
                            	   636: 
                            	   637: DefaultException:
02:0000034A 13FC000000FF0900	   638:     move.b  #0,($FF0900).l
02:00000352 33D700FF0902    	   639:     move.w  (SP),($FF0902).l
02:00000358 23EF000200FF0904	   640:     move.l  2(SP),($FF0904).l
02:00000360 48F97FFF00FF0908	   641:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   642: .spin:
02:00000368 60FE            	   643:     bra.s   .spin
                            	   644: 
                            	   645: ;==============================================================================
                            	   646: ; NES I/O emulation layer — real implementations of _ppu_*, _apu_*, _ctrl_*,
                            	   647: ; _oam_dma, _mmc1_*, _indirect_stub.  Must be included BEFORE any bank file
                            	   648: ; so all helpers are defined when z_XX.asm code references them.
                            	   649: ; (With --no-stubs the bank files no longer emit these labels themselves.)
                            	   650: ;==============================================================================
                            	   651:     include "audio_driver.asm"

