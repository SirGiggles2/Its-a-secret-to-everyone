                            	  3962:     ; To allow a wide speed range, we keep the quarter speed.
                            	  3963:     ; Here, apply it 4 times to get the full speed.
02:00047E36 6106            	  3964:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E38 6104            	  3965:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E3A 61000002        	  3966:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
                            	  3967:     even
                            	  3968: _L_z07_MoveObject_ApplyQSpeedToPosition:
02:00047E3E 102C000F        	  3969:     move.b  ($000F,A4),D0
02:00047E42 E208            	  3970:     lsr.b  #1,D0   ; LSR A
02:00047E44 654C            	  3971:     bcs  _L_z07_MoveObject_Right
02:00047E46 E208            	  3972:     lsr.b  #1,D0   ; LSR A
02:00047E48 655E            	  3973:     bcs  _L_z07_MoveObject_Left
02:00047E4A E208            	  3974:     lsr.b  #1,D0   ; LSR A
02:00047E4C 6526            	  3975:     bcs  _L_z07_MoveObject_Down
