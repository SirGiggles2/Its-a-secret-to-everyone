                            	   831:     ; NT_B cache lives at NT_CACHE_BASE + 960 (rows 30..59 slot).
02:0000E466 024000FF        	   832:     andi.w  #$00FF,D0                ; D0.w = tile index
02:0000E46A 3602            	   833:     move.w  D2,D3
02:0000E46C 064303C0        	   834:     addi.w  #960,D3                  ; D3.w = NT_B cache offset (960..1919)
02:0000E470 41F900FF0840    	   835:     lea     (NT_CACHE_BASE).l,A0
02:0000E476 11803000        	   836:     move.b  D0,(A0,D3.W)
                            	   837: 
02:0000E47A 3602            	   838:     move.w  D2,D3
02:0000E47C 0243001F        	   839:     andi.w  #$001F,D3
02:0000E480 E34B            	   840:     lsl.w   #1,D3                    ; D3.w = col * 2
                            	   841: 
02:0000E482 EA4A            	   842:     lsr.w   #5,D2                    ; D2.w = row within NT_B (0…29)
02:0000E484 0642001E        	   843:     addi.w  #30,D2                   ; offset into Plane A rows 30..59
02:0000E488 C4FC0080        	   844:     mulu.w  #$0080,D2                ; D2.l = row * $80 (row ≤ 59)
02:0000E48C D443            	   845:     add.w   D3,D2
02:0000E48E 0642C000        	   846:     addi.w  #$C000,D2                ; D2.w = VDP VRAM addr
                            	   847: 
02:0000E492 2602            	   848:     move.l  D2,D3
02:0000E494 028300003FFF    	   849:     andi.l  #$00003FFF,D3
02:0000E49A 4843            	   850:     swap    D3
