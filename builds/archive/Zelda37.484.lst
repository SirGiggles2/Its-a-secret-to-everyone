02:00038280 7608            	   305:     moveq   #8,D3
02:00038282 102C0062        	   306:     move.b  ($0062,A4),D0
02:00038286 41EC0084        	   307:     lea     ($0084,A4),A0
02:0003828A 12302000        	   308:     move.b  (A0,D2.W),D1
02:0003828E B001            	   309:     cmp.b   D1,D0
02:00038290 6542            	   310:     bcs  _L_z04_Exit_SetDirTowardTarget
02:00038292 7604            	   311:     moveq   #4,D3
02:00038294 663E            	   312:     bne  _L_z04_Exit_SetDirTowardTarget
                            	   313:     even
