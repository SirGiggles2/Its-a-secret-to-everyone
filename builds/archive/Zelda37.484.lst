02:00034E12 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E16 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034E1A 123C0010        	  4368:     move.b  #$10,D1
02:00034E1E 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E22 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E24 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E28 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
