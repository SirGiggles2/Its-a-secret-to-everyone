02:00033768 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:0003376A 41F90003317E    	  2157:     lea     (SlotToNameOffset).l,A0
02:00033770 10303000        	  2158:     move.b  (A0,D3.W),D0
02:00033774 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:00033778 7400            	  2162:     moveq   #0,D2
02:0003377A 41F900033182    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033780 14303000        	  2164:     move.b  (A0,D3.W),D2
02:00033784 7602            	  2165:     moveq   #2,D3
