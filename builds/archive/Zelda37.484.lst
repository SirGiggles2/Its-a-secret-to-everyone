                            	  4032: PlayerScreenEdgeBounds:
02:00047ECA 3D              	  4033:     dc.b    $3D, $DD, $00, $F0
02:00047ECB DD
02:00047ECC 00
02:00047ECD F0
                            	  4034: 
                            	  4035: ; Params:
                            	  4036: ; [0E]: $FF, if blocked by a door
                            	  4037: ; [0F]: movement direction
                            	  4038: ;
                            	  4039: ; Returns:
                            	  4040: ; [0F]: untouched, or changed if blocked or need to change
                            	  4041: ;
                            	  4042: ; Summary:
                            	  4043: ;
                            	  4044: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4045: ; Then allow movement or go to the next room. Otherwise,
                            	  4046: ; check passive tile objects and stop moving.
                            	  4047: ;
                            	  4048: ; For other objects: First, if moving, test the colliding tile for
                            	  4049: ; walkability. Otherwise search for a walkable direction starting
                            	  4050: ; from input direction.
                            	  4051: ;
                            	  4052: ; When you find a walkable direction, see if it makes the object
                            	  4053: ; cross a boundary. If it doesn't, then make this direction
                            	  4054: ; the objection direction. Otherwise, keep looping.
                            	  4055: ;
                            	  4056: ; If no walkable direction is found, then stop moving.
                            	  4057: ;
                            	  4058: ;
                            	  4059: ; if is player
                            	  4060: ;   if at doorway
                            	  4061: ;     go handle a walkable direction
                            	  4062: ;   if blocked by door
                            	  4063: ;     return
                            	  4064: ;
                            	  4065:     even
                            	  4066: Walker_CheckTileCollision:
                            	  4067:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4068:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4069:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4070:     ; reset) for Link and every other object. Only the tile
                            	  4071:     ; walkability decision in CheckTiles is overridden.
02:00047ECE 4A02            	  4072:     cmpi.b  #$00,D2
02:00047ED0 6614            	  4073:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:00047ED2 102C0053        	  4074:     move.b  ($0053,A4),D0
02:00047ED6 6704            	  4075:     beq  _anon_z07_16
02:00047ED8 600000BE        	  4076:     jmp     GoWalkableDir
                            	  4077: 
                            	  4078: _anon_z07_16:
02:00047EDC 102C000E        	  4079:     move.b  ($000E,A4),D0
02:00047EE0 6A04            	  4080:     bpl.s  __far_z_07_0046
02:00047EE2 600000AC        	  4081:     jmp  L1F148_Exit
                            	  4082: __far_z_07_0046:
                            	  4083:     even
                            	  4084: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4085:     ; If grid offset <> 0, return.
                            	  4086:     ;
02:00047EE6 41EC0394        	  4087:     lea     ($0394,A4),A0
02:00047EEA 10302000        	  4088:     move.b  (A0,D2.W),D0
02:00047EEE 6704            	  4089:     beq.s  __far_z_07_0047
02:00047EF0 6000009E        	  4090:     jmp  L1F148_Exit
                            	  4091: __far_z_07_0047:
                            	  4092:     ; Grid offset = 0.
                            	  4093:     ; The object is at a point between cells in the grid.
                            	  4094:     ; So, we can check tiles for collision.
                            	  4095:     ;
                            	  4096:     ; Reset [0E] alternate direction search step.
                            	  4097:     ;
02:00047EF4 1940000E        	  4098:     move.b  D0,($000E,A4)
                            	  4099:     ; If there's a movement direction, go check tile collision.
                            	  4100:     ;
02:00047EF8 102C000F        	  4101:     move.b  ($000F,A4),D0
02:00047EFC 6702            	  4102:     beq.s  __far_z_07_0048
02:00047EFE 602E            	  4103:     jmp  CheckTiles
                            	  4104: __far_z_07_0048:
                            	  4105:     ; Moving direction = 0.
                            	  4106:     ; If object is the player, return.
                            	  4107:     ;
02:00047F00 4A02            	  4108:     cmpi.b  #$00,D2
02:00047F02 6604            	  4109:     bne.s  __far_z_07_0049
02:00047F04 6000008A        	  4110:     jmp  L1F148_Exit
                            	  4111: __far_z_07_0049:
                            	  4112:     ; Moving direction = 0.
                            	  4113:     ; The object is not the player.
                            	  4114:     ;
                            	  4115:     ; If object does not have attribute $10, then
                            	  4116:     ; set movement direction to input direction,
                            	  4117:     ; and go try to turn to an unblocked direction in order to move.
                            	  4118:     ;
02:00047F08 41EC04BF        	  4119:     lea     ($04BF,A4),A0
02:00047F0C 10302000        	  4120:     move.b  (A0,D2.W),D0
02:00047F10 02000010        	  4121:     andi.b #$10,D0
02:00047F14 6702            	  4122:     beq.s  __far_z_07_0050
02:00047F16 600E            	  4123:     jmp  Reverse
                            	  4124: __far_z_07_0050:
02:00047F18 41EC03F8        	  4125:     lea     ($03F8,A4),A0
02:00047F1C 10302000        	  4126:     move.b  (A0,D2.W),D0
02:00047F20 1940000F        	  4127:     move.b  D0,($000F,A4)
02:00047F24 6038            	  4128:     jmp     TryNextDir
                            	  4129: 
                            	  4130:     even
                            	  4131: Reverse:
                            	  4132:     ; UNKNOWN:
                            	  4133:     ; This seems to be unused code triggered by object attribute $10.
                            	  4134:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4135:     ;
02:00047F26 610000E2        	  4136:     jsr     ReverseObjDir
02:00047F2A 6000009E        	  4137:     jmp     CheckBoundary
                            	  4138: 
                            	  4139:     even
                            	  4140: CheckTiles:
                            	  4141:     ifne TURBO_LINK
                            	  4142:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4143:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00047F2E 4A02            	  4144:     tst.b   D2
02:00047F30 6608            	  4145:     bne.s   _L_z07_CheckTiles_notLink
02:00047F32 197C0024049E    	  4146:     move.b  #$24,($049E,A4)
02:00047F38 605E            	  4147:     jmp     GoWalkableDir
                            	  4148: _L_z07_CheckTiles_notLink:
                            	  4149:     endc
                            	  4150:     ; The code below applies to Link and other objects.
                            	  4151:     ;
                            	  4152:     ; Test the moving direction's walkability.
                            	  4153:     ;
                            	  4154:     ; For the player, this is enough. For other objects, this 
                            	  4155:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4156:     ;
                            	  4157:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4158:     ;
02:00047F3A 6100FB88        	  4159:     jsr     GetCollidingTileMoving
02:00047F3E 122C034A        	  4160:     move.b  ($034A,A4),D1
02:00047F42 B001            	  4161:     cmp.b   D1,D0
02:00047F44 6402            	  4162:     bcc.s  __far_z_07_0051
02:00047F46 6050            	  4163:     jmp  GoWalkableDir
                            	  4164: __far_z_07_0051:
                            	  4165:     ; The colliding tile is unwalkable.
                            	  4166:     ;
                            	  4167:     ; If object is the player, then go check passive tile objects and
                            	  4168:     ; the screen edge, or stop moving.
                            	  4169:     ;
02:00047F48 4A02            	  4170:     cmpi.b  #$00,D2
02:00047F4A 6602            	  4171:     bne.s  __far_z_07_0052
02:00047F4C 6022            	  4172:     jmp  PlayerUnwalkable
                            	  4173: __far_z_07_0052:
                            	  4174:     even
                            	  4175: CheckObjAttr10AndAltDir:
                            	  4176:     ; Not the player.
                            	  4177:     ; If object attribute has $10, go to the unused code above
                            	  4178:     ; to reverse direction.
                            	  4179:     ;
02:00047F4E 41EC04BF        	  4180:     lea     ($04BF,A4),A0
02:00047F52 10302000        	  4181:     move.b  (A0,D2.W),D0
02:00047F56 02000010        	  4182:     andi.b #$10,D0
02:00047F5A 6702            	  4183:     beq.s  __far_z_07_0053
02:00047F5C 60C8            	  4184:     jmp  Reverse
                            	  4185: __far_z_07_0053:
                            	  4186:     even
                            	  4187: TryNextDir:
                            	  4188:     ; Get the next direction to check, and set moving direction to it.
                            	  4189:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4190:     ;
02:00047F5E 61000080        	  4191:     jsr     Walker_GetNextAltDir
02:00047F62 1940000F        	  4192:     move.b  D0,($000F,A4)
02:00047F66 102C000E        	  4193:     move.b  ($000E,A4),D0
02:00047F6A 6702            	  4194:     beq.s  __far_z_07_0054
02:00047F6C 60C0            	  4195:     jmp  CheckTiles
                            	  4196: __far_z_07_0054:
02:00047F6E 4E75            	  4197:     rts
                            	  4198: 
                            	  4199:     even
                            	  4200: PlayerUnwalkable:
                            	  4201:     ; Tile is not walkable. Object is player.
                            	  4202:     ;
                            	  4203:     ; Check passive tile objects and the screen edge, and stop moving.
                            	  4204:     ;
                            	  4205:     ; First, if in OW, check passive tile objects (armos and regular gravestone).
                            	  4206:     ;
02:00047F70 102C0010        	  4207:     move.b  ($0010,A4),D0
02:00047F74 660C            	  4208:     bne  _L_z07_PlayerUnwalkable_StopMoving
02:00047F76 7001            	  4209:     moveq   #1,D0
02:00047F78 61001A74        	  4210:     jsr     SwitchBank
02:00047F7C 4EB900030924    	  4211:     jsr     CheckPassiveTileObjects
                            	  4212:     even
                            	  4213: _L_z07_PlayerUnwalkable_StopMoving:
                            	  4214:     ; Reset moving direction and buttons pressed.
                            	  4215:     ; If in UW, we're done.
                            	  4216:     ; In OW, go check the screen edge.
                            	  4217:     ;
02:00047F82 610E            	  4218:     jsr     ResetMovingDir
02:00047F84 194000F8        	  4219:     move.b  D0,($00F8,A4)
02:00047F88 102C0010        	  4220:     move.b  ($0010,A4),D0
02:00047F8C 6602            	  4221:     bne.s  __far_z_07_0055
02:00047F8E 6008            	  4222:     jmp  GoWalkableDir
                            	  4223: __far_z_07_0055:
                            	  4224:     even
                            	  4225: L1F148_Exit:
02:00047F90 4E75            	  4226:     rts
                            	  4227: 
                            	  4228: ; Returns:
                            	  4229: ; A: 0
                            	  4230: ; [0F]: 0
                            	  4231: ;
                            	  4232:     even
                            	  4233: ResetMovingDir:
02:00047F92 4EF90002B7A2    	  4234:     jmp     c_reset_moving_dir
                            	  4235: 
                            	  4236: GoWalkableDir:
                            	  4237:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4238:     ; makes the object cross a boundary. Then go check another direction if it does,
