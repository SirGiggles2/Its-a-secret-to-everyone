                            	  3885: Moldorm_Wander:
                            	  3886:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3887:     ; Only the head controls the movement direction.
                            	  3888:     ;
02:00039BBA 0C020005        	  3889:     cmpi.b  #$05,D2
02:00039BBE 6708            	  3890:     beq  _anon_z04_82
02:00039BC0 0C02000A        	  3891:     cmpi.b  #$0A,D2
02:00039BC4 6702            	  3892:     beq.s  __far_z_04_0028
02:00039BC6 6070            	  3893:     jmp  L1156B_Exit
                            	  3894: __far_z_04_0028:
                            	  3895: _anon_z04_82:
                            	  3896:     ; Turn randomly while flying, as usual.
                            	  3897:     ;
02:00039BC8 610028AA        	  3898:     jsr     Flyer_Wander
                            	  3899:     ; After every turn, the common flyer routines set timer to $10.
                            	  3900:     ; This can be used as a signal for moldorm to propagate
                            	  3901:     ; direction changes down the chain.
                            	  3902:     ;
                            	  3903:     ; Between each turn, timer <> $10.
                            	  3904:     ;
                            	  3905:     ; At the end of the delay after the last turn, timer = 0.
                            	  3906:     ; This is a signal that that flying state ended, and a new one
                            	  3907:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  3908:     ; we can propagate direction changes again; and start
                            	  3909:     ; a new flying interval by setting timer to $10. This will make
                            	  3910:     ; the next flying state delay that amount of time before turning
                            	  3911:     ; the first time.
                            	  3912:     ;
                            	  3913:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  3914:     ; arm the timer again, and shift directions down the chain.
                            	  3915:     ;
02:00039BCC 10342028        	  3916:     move.b  ($28,A4,D2.W),D0
02:00039BD0 6602            	  3917:     bne.s  __far_z_04_0029
02:00039BD2 60CE            	  3918:     jmp  Moldorm_ChangeFlyingState
                            	  3919: __far_z_04_0029:
                            	  3920:     even
                            	  3921: Moldorm_PropagateDirs:
                            	  3922:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  3923:     ;
02:00039BD4 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:00039BD8 0C000010        	  3925:     cmpi.b  #$10,D0
02:00039BDC 6702            	  3926:     beq.s  __far_z_04_0030
02:00039BDE 6058            	  3927:     jmp  L1156B_Exit
                            	  3928: __far_z_04_0030:
                            	  3929:     ; Timer = $10.
                            	  3930:     ;
                            	  3931:     ; If deferred bounce direction <> 0, then
                            	  3932:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  3933:     ;
02:00039BE0 41EC03BC        	  3934:     lea     ($03BC,A4),A0
02:00039BE4 10302000        	  3935:     move.b  (A0,D2.W),D0
02:00039BE8 6712            	  3936:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:00039BEA 41EC0098        	  3937:     lea     ($0098,A4),A0
02:00039BEE 11802000        	  3938:     move.b  D0,(A0,D2.W)
02:00039BF2 7000            	  3939:     moveq   #0,D0
02:00039BF4 41EC03BC        	  3940:     lea     ($03BC,A4),A0
02:00039BF8 11802000        	  3941:     move.b  D0,(A0,D2.W)
                            	  3942:     even
                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3944:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3945:     ;
02:00039BFC 7004            	  3946:     moveq   #4,D0
02:00039BFE 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039C00 7600            	  3950:     moveq   #0,D3
02:00039C02 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039C06 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:00039C08 7605            	  3953:     moveq   #5,D3
                            	  3954:     even
                            	  3955: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  3956:     ; Copy old direction from a higher slot to the lower one;
                            	  3957:     ; and to the lower one's facing direction.
                            	  3958:     ;
02:00039C0A 41EC0382        	  3959:     lea     ($0382,A4),A0
02:00039C0E 10303000        	  3960:     move.b  (A0,D3.W),D0
02:00039C12 41EC0381        	  3961:     lea     ($0381,A4),A0
02:00039C16 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:00039C1A 41EC0099        	  3963:     lea     ($0099,A4),A0
02:00039C1E 11803000        	  3964:     move.b  D0,(A0,D3.W)
                            	  3965:     ; Bottom of the loop.
                            	  3966:     ; Increment segment index.
                            	  3967:     ; Decrement loop counter.
                            	  3968:     ;
02:00039C22 5203            	  3969:     addq.b  #1,D3
02:00039C24 5314            	  3970:     subq.b  #1,($0000,A4)
02:00039C26 66E2            	  3971:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  3972:     ; Copy current direction to old direction.
