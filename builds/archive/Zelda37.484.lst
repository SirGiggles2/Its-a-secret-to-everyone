                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A6FC 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A700 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A704 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A708 123C0038        	  5434:     move.b  #$38,D1
02:0003A70C D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A70E 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A712 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A716 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A71A 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A71E 123C0000        	  5442:     move.b  #$00,D1
02:0003A722 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A724 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A728 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A72C 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A730 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A734 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A738 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A73A 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A73E 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A742 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A746 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A74A 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A74E 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A752 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A756 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0003A75A 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0003A75E B001            	  5465:     cmp.b   D1,D0
02:0003A760 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
                            	  5468:     ;
02:0003A764 7000            	  5469:     moveq   #0,D0
02:0003A766 41EC00AC        	  5470:     lea     ($00AC,A4),A0
02:0003A76A 11802000        	  5471:     move.b  D0,(A0,D2.W)
                            	  5472:     ; Reset 16-bit vertical speed.
                            	  5473:     ;
02:0003A76E 41EC0444        	  5474:     lea     ($0444,A4),A0
02:0003A772 11802000        	  5475:     move.b  D0,(A0,D2.W)
02:0003A776 41EC0412        	  5476:     lea     ($0412,A4),A0
02:0003A77A 11802000        	  5477:     move.b  D0,(A0,D2.W)
                            	  5478:     ; Choose a random direction to face in.
                            	  5479:     ;
02:0003A77E 10342018        	  5480:     move.b  ($18,A4,D2.W),D0
02:0003A782 02000003        	  5481:     andi.b #$03,D0
02:0003A786 7600            	  5482:     moveq   #0,D3
02:0003A788 1600            	  5483:     move.b  D0,D3
02:0003A78A 41F90003A59A    	  5484:     lea     (PolsVoiceDirections).l,A0
