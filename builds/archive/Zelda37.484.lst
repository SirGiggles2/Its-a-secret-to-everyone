02:00030F06 6034            	  2205:     jmp     Anim_WriteSpritePair
                            	  2206: 
                            	  2207: ; Params:
                            	  2208: ; [00]: Object X
                            	  2209: ; [01]: Object Y
                            	  2210: ; [02]: Left tile
                            	  2211: ; [03]: Right tile
                            	  2212: ; [04]: Left attributes
                            	  2213: ; [05]: Right attributes
                            	  2214: ; [07]: Has two sides
                            	  2215: ; [08]: Cycle sprite index
                            	  2216: ; [0A]: X separation
                            	  2217: ; [0F]: Flip horizontally
                            	  2218: ; [0343]: LeftSpriteOffset
                            	  2219: ; [0344]: RightSpriteOffset
                            	  2220: ;
                            	  2221: ; If [0F] = 0, write the sprite pair with no further processing.
                            	  2222: ;
                            	  2223:     even
                            	  2224: Anim_WriteHorizontallyFlippableSpritePair:
02:00030F08 102C000F        	  2225:     move.b  ($000F,A4),D0
02:00030F0C 6602            	  2226:     bne.s  __far_z_01_0004
02:00030F0E 602C            	  2227:     jmp  Anim_WriteSpritePair
                            	  2228: __far_z_01_0004:
                            	  2229:     ; Otherwise, reverse the two sides.
                            	  2230:     ;
02:00030F10 102C0002        	  2231:     move.b  ($0002,A4),D0
