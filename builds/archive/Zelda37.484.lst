                            	  2480: ;==============================================================================
                            	  2481: ; DMC APU register stubs (Phase D)
                            	  2482: ;
                            	  2483: ; Zelda's SelectDMC routine (transpiled at z_00.asm:_L_z00_DriveSample_*)
                            	  2484: ; writes the APU DMC registers in a fixed order whenever it wants to play
                            	  2485: ; a sample effect:
                            	  2486: ;
                            	  2487: ;     $4010  <- SampleRates[idx-1]   ; rate nibble (low 4 bits)
                            	  2488: ;     $4012  <- SampleAddrs[idx-1]   ; start addr high byte ($C000 + b*64)
                            	  2489: ;     $4013  <- SampleLengths[idx-1] ; length byte (length = b*16 + 1)
                            	  2490: ;     $4015  <- $0F                  ; enable all non-DMC channels
                            	  2491: ;     $4015  <- $1F                  ; OR in bit 4 -> DMC playback
                            	  2492: ;
                            	  2493: ; We shadow $4010 and $4012 on write so that when $4015 arrives with bit 4
                            	  2494: ; set we can recover the intended sample index via DMC_SAMPLE_LOOKUP.
                            	  2495: ;==============================================================================
                            	  2496: _apu_write_4010:
02:0002AE7E 13C000FFE10C    	  2497:     move.b  D0,(dmc_rate_sel).l
02:0002AE84 4E75            	  2498:     rts
                            	  2499: 
                            	  2500: _apu_write_4012:
02:0002AE86 13C000FFE10D    	  2501:     move.b  D0,(dmc_addr_sel).l
02:0002AE8C 4E75            	  2502:     rts
                            	  2503: 
                            	  2504: _apu_write_4013:
02:0002AE8E 13C000FFE10E    	  2505:     move.b  D0,(dmc_len_sel).l
02:0002AE94 4E75            	  2506:     rts
                            	  2507: 
                            	  2508: _apu_write_4015:
02:0002AE96 08000004        	  2509:     btst    #4,D0                       ; DMC enable bit?
02:0002AE9A 673E            	  2510:     beq.s   .no_dmc                     ; clearing → stop playback
                            	  2511:     ; Look up (addr, rate) in DMC_SAMPLE_LOOKUP.  Walk 7 {addr,rate,idx,0}
                            	  2512:     ; quads; on match, load the 1-based index into D1 and call dmc_trigger.
02:0002AE9C 48E77080        	  2513:     movem.l D1-D3/A0,-(SP)
02:0002AEA0 143900FFE10D    	  2514:     move.b  (dmc_addr_sel).l,D2
02:0002AEA6 163900FFE10C    	  2515:     move.b  (dmc_rate_sel).l,D3
02:0002AEAC 41F90000194A    	  2516:     lea     (DMC_SAMPLE_LOOKUP).l,A0
02:0002AEB2 7206            	  2517:     moveq   #DMC_SAMPLE_COUNT-1,D1
                            	  2518: .scan:
02:0002AEB4 B410            	  2519:     cmp.b   (A0),D2
02:0002AEB6 6616            	  2520:     bne.s   .next
02:0002AEB8 B6280001        	  2521:     cmp.b   1(A0),D3
02:0002AEBC 6610            	  2522:     bne.s   .next
                            	  2523:     ; Match: 3rd byte of the quad is the 1-based index
02:0002AEBE 7200            	  2524:     moveq   #0,D1
02:0002AEC0 12280002        	  2525:     move.b  2(A0),D1
02:0002AEC4 1001            	  2526:     move.b  D1,D0                       ; dmc_trigger wants index in D0.b
02:0002AEC6 4EB9000005D2    	  2527:     bsr     dmc_trigger
02:0002AECC 6006            	  2528:     bra.s   .done
                            	  2529: .next:
02:0002AECE 5888            	  2530:     addq.l  #4,A0
02:0002AED0 51C9FFE2        	  2531:     dbra    D1,.scan
                            	  2532:     ; No match — silently ignore (unknown rate/addr combo, not fatal)
                            	  2533: .done:
02:0002AED4 4CDF010E        	  2534:     movem.l (SP)+,D1-D3/A0
02:0002AED8 4E75            	  2535:     rts
                            	  2536: .no_dmc:
                            	  2537:     ; Bit 4 clear — if DMC currently playing, stop it.
02:0002AEDA 4A3900FFE100    	  2538:     tst.b   (dmc_active).l
02:0002AEE0 6706            	  2539:     beq.s   .no_dmc_done
02:0002AEE2 42B900FFE108    	  2540:     clr.l   (dmc_remain).l
                            	  2541: .no_dmc_done:
02:0002AEE8 4E75            	  2542:     rts
                            	  2543: 
                            	  2544: ;==============================================================================
                            	  2545: ; _indirect_stub — JMP (abs) indirect placeholder.
                            	  2546: ; Called when the transpiler can't resolve an indirect jump target at
                            	  2547: ; translate-time.  Halts via an infinite bra so BizHawk shows PC stuck here.
                            	  2548: ; In T9+ these will be replaced by computed dispatch tables.
                            	  2549: ;==============================================================================
                            	  2550: _indirect_stub:
02:0002AEEA 60FE            	  2551:     bra.s   _indirect_stub          ; spin — caught as deliberate halt in T9+
                            	  2552: 
                            	  2553: ;==============================================================================
                            	  2554: ; _m68k_tablejump — M68K-native replacement for the NES JSR-trick TableJump.
                            	  2555: ;
                            	  2556: ; On NES, "JSR TableJump" is a JSR-trick: the bytes after the JSR are a
                            	  2557: ; table of 16-bit vectors.  TableJump pops the return address from the 6502
                            	  2558: ; stack to find the table base, then jumps through it using the value in A.
                            	  2559: ;
                            	  2560: ; In M68K, BSR pushes the return address (= table base) onto A7 (M68K stack),
                            	  2561: ; not A5 (our NES stack).  The original TableJump pulled from A5 (zeros),
                            	  2562: ; constructing a bogus NES address and jumping into garbage.
                            	  2563: ;
                            	  2564: ; This replacement correctly pops the M68K return address as the dc.l table
                            	  2565: ; base, indexes by D0.b × 4, and dispatches.
                            	  2566: ;
                            	  2567: ; Calling convention:
                            	  2568: ;   D0.b = mode index
                            	  2569: ;   (A7)  = base address of the dc.l jump table (pushed by BSR)
                            	  2570: ;   Jumps directly to the selected target (does not RTS).
                            	  2571: ;==============================================================================
                            	  2572: _m68k_tablejump:
02:0002AEEC 205F            	  2573:     movea.l (SP)+,A0        ; pop M68K return address = dc.l table base
02:0002AEEE C07C00FF        	  2574:     and.w   #$00FF,D0       ; zero-extend mode byte → word
02:0002AEF2 E548            	  2575:     lsl.w   #2,D0           ; D0.w = index × 4  (each dc.l = 4 bytes)
02:0002AEF4 20700000        	  2576:     movea.l (A0,D0.W),A0   ; load 32-bit target address from table
02:0002AEF8 4ED0            	  2577:     jmp     (A0)            ; dispatch (no return)
                            	  2578: 
                            	  2579: ;==============================================================================
                            	  2580: ; _clear_nametable_fast — Fast replacement for ClearNameTable.
                            	  2581: ;
                            	  2582: ; Fills Plane A with a tile word directly via VDP_DATA (bypassing _ppu_write_7)
                            	  2583: ; and clears NT_CACHE.  V64 plane: NT0 ($20) → rows 0-29, NT1 ($28) → rows 30-59.
                            	  2584: ;
                            	  2585: ; Input:
                            	  2586: ;   D0.b = hi byte of NES PPU address ($20 = nametable 0, $28 = nametable 1)
                            	  2587: ;   D2.b = tile index to fill with
                            	  2588: ;   D3.b = attribute byte (always 0 for Zelda clear; palette 0 used)
                            	  2589: ;
                            	  2590: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2591: ; Updates PPU_VADDR to the post-clear address (matching original behavior).
                            	  2592: ;==============================================================================
                            	  2593:     even
                            	  2594: _clear_nametable_fast:
02:0002AEFA 48E7F880        	  2595:     movem.l D0-D4/A0,-(SP)
                            	  2596: 
                            	  2597:     ; Save NT selection before D0 is clobbered
02:0002AEFE 1800            	  2598:     move.b  D0,D4                   ; D4.b = NT hi byte ($20 or $28)
                            	  2599: 
                            	  2600:     ; Compute the end PPU_VADDR: start + 1024 tiles + 64 attributes = +$0440
02:0002AF00 024000FF        	  2601:     andi.w  #$00FF,D0
02:0002AF04 E148            	  2602:     lsl.w   #8,D0                   ; D0.w = PPU base ($2000 or $2800)
02:0002AF06 06400440        	  2603:     addi.w  #$0440,D0
02:0002AF0A 33C000FF0802    	  2604:     move.w  D0,(PPU_VADDR).l        ; set PPU_VADDR to expected end value
                            	  2605: 
                            	  2606:     ; Build tile word from the current BG pattern-table selection
02:0002AF10 7000            	  2607:     moveq   #0,D0
02:0002AF12 1002            	  2608:     move.b  D2,D0                   ; D0.w = raw tile index
02:0002AF14 4EB90000E8FE    	  2609:     bsr     _compose_bg_tile_word
02:0002AF1A 3200            	  2610:     move.w  D0,D1                   ; D1.w = tile word to write
                            	  2611: 
                            	  2612:     ; Determine VRAM start address based on NT selection
02:0002AF1C 0C040028        	  2613:     cmpi.b  #$28,D4
02:0002AF20 672A            	  2614:     beq.s   .cnf_nt1
                            	  2615: 
                            	  2616:     ; ---- NT0: Fill Plane A rows 0-29 starting at $C000 ----
                            	  2617:     ; Phase 2c: also fill Window nametable rows 0-7 (256 tiles = 512 bytes).
                            	  2618:     ; Without this, NT0-clear requests leave stale HUD tiles in Window
                            	  2619:     ; after a mode transition that clears NT0.
02:0002AF22 23FC7000000200C0	  2620:     move.l  #$70000002,(VDP_CTRL).l ; VRAM write at $B000 (Window)
02:0002AF2A 0004
02:0002AF2C 363C00FF        	  2621:     move.w  #255,D3                 ; 32 cols * 8 rows - 1
                            	  2622: .cnf_window_fill:
02:0002AF30 33C100C00000    	  2623:     move.w  D1,(VDP_DATA).l
02:0002AF36 51CBFFF8        	  2624:     dbf     D3,.cnf_window_fill
                            	  2625: 
02:0002AF3A 23FC4000000300C0	  2626:     move.l  #$40000003,(VDP_CTRL).l ; VRAM write at $C000
02:0002AF42 0004
                            	  2627:     ; Clear NT_CACHE offsets 0-959 (NT0)
02:0002AF44 41F900FF0840    	  2628:     lea     (NT_CACHE_BASE).l,A0
02:0002AF4A 6010            	  2629:     bra.s   .cnf_fill
                            	  2630: 
                            	  2631: .cnf_nt1:
                            	  2632:     ; ---- NT1: Fill Plane A rows 30-63 starting at $CF00 ----
                            	  2633:     ; 34 rows = 30 NT1 rows + 4 gap rows (prevents garbage when scroll wraps).
                            	  2634:     ; $CF00 = $C000 + 30*$80.  VDP command: ($CF00 & $3FFF)<<16 | $40000003
                            	  2635:     ; NT1 doesn't touch HUD range — skip Window fill.
02:0002AF4C 23FC4F00000300C0	  2636:     move.l  #$4F000003,(VDP_CTRL).l ; VRAM write at $CF00
02:0002AF54 0004
                            	  2637:     ; Clear NT_CACHE offsets 960-1919 (NT1)
02:0002AF56 41F900FF0C00    	  2638:     lea     (NT_CACHE_BASE+960).l,A0
                            	  2639: 
                            	  2640: .cnf_fill:
                            	  2641:     ; Write tiles to Plane A rows.  Plane A is 64 tiles wide,
                            	  2642:     ; so after each 32-tile NES row we must skip 32 unused tiles.
                            	  2643:     ; NT0: 30 rows (0-29).  NT1: 34 rows (30-63, includes 4 gap rows).
02:0002AF5C 0C040028        	  2644:     cmpi.b  #$28,D4
02:0002AF60 6604            	  2645:     bne.s   .cnf_nt0_count
02:0002AF62 7621            	  2646:     moveq   #34-1,D3                ; NT1: 34 rows (fills gap rows 60-63)
02:0002AF64 6002            	  2647:     bra.s   .cnf_row
                            	  2648: .cnf_nt0_count:
02:0002AF66 761D            	  2649:     moveq   #30-1,D3                ; NT0: 30 rows
                            	  2650: .cnf_row:
02:0002AF68 781F            	  2651:     moveq   #32-1,D4                ; 32 cols per row
                            	  2652: .cnf_col:
02:0002AF6A 33C100C00000    	  2653:     move.w  D1,(VDP_DATA).l
02:0002AF70 51CCFFF8        	  2654:     dbf     D4,.cnf_col
                            	  2655: 
                            	  2656:     ; Skip 32 unused tile slots (64 bytes) in Plane A row.
02:0002AF74 781F            	  2657:     moveq   #32-1,D4
                            	  2658: .cnf_skip:
02:0002AF76 33C100C00000    	  2659:     move.w  D1,(VDP_DATA).l         ; write same tile to unused slots (harmless)
02:0002AF7C 51CCFFF8        	  2660:     dbf     D4,.cnf_skip
                            	  2661: 
02:0002AF80 51CBFFE6        	  2662:     dbf     D3,.cnf_row
                            	  2663: 
                            	  2664:     ; ---- Clear NT_CACHE (960 bytes for the selected NT) ----
02:0002AF84 363C03BF        	  2665:     move.w  #960-1,D3
02:0002AF88 1001            	  2666:     move.b  D1,D0                   ; fill byte = tile index
                            	  2667: .cnf_cache:
02:0002AF8A 10C0            	  2668:     move.b  D0,(A0)+
02:0002AF8C 51CBFFFC        	  2669:     dbf     D3,.cnf_cache
                            	  2670: 
                            	  2671:     ; Clear matching transfer-interpreter palette shadow for this NT.
02:0002AF90 0C040028        	  2672:     cmpi.b  #$28,D4
02:0002AF94 6708            	  2673:     beq.s   .cnf_attr_nt1
02:0002AF96 41F900FF1400    	  2674:     lea     (NT_ATTR_CACHE_BASE).l,A0
02:0002AF9C 6006            	  2675:     bra.s   .cnf_attr_fill
                            	  2676: .cnf_attr_nt1:
02:0002AF9E 41F900FF17C0    	  2677:     lea     (NT_ATTR_CACHE_BASE+960).l,A0
                            	  2678: .cnf_attr_fill:
02:0002AFA4 363C03BF        	  2679:     move.w  #960-1,D3
02:0002AFA8 4200            	  2680:     clr.b   D0
                            	  2681: .cnf_attr_loop:
02:0002AFAA 10C0            	  2682:     move.b  D0,(A0)+
02:0002AFAC 51CBFFFC        	  2683:     dbf     D3,.cnf_attr_loop
                            	  2684: 
                            	  2685: .cnf_done:
02:0002AFB0 4CDF011F        	  2686:     movem.l (SP)+,D0-D4/A0
02:0002AFB4 4E75            	  2687:     rts
