02:0003BAFA 11802000        	  8090:     move.b  D0,(A0,D2.W)
02:0003BAFE 600002EC        	  8091:     jmp     Ganon_DrawBody
                            	  8092: 
                            	  8093: ; Description:
                            	  8094: ; Fighting Ganon.
                            	  8095: ;
                            	  8096: ; If Ganon is dying, go handle it.
