                            	  6771: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6772:     ; To animate the state, the animation counter had to have
                            	  6773:     ; reached 0. Right after this routine, the counter will be
                            	  6774:     ; rolled over, and the movement frame will be switched.
                            	  6775:     ;
                            	  6776:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6777:     ; the animation here, in order to immediately change it to
                            	  6778:     ; 0 (legs apart) after this.
                            	  6779:     ;
02:000490E2 7001            	  6780:     moveq   #1,D0
02:000490E4 194003E4        	  6781:     move.b  D0,($03E4,A4)
02:000490E8 4E75            	  6782:     rts
