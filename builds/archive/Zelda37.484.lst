02:0002B5F8 0018            	  3508:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0002B5FA 0028            	  3509:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3510: .ttf_pal_have_cram_new:
