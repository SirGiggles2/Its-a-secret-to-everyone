02:000472A6 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:000472AA 41EC030B        	  2372:     lea     ($030B,A4),A0
02:000472AE 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:000472B2 41EC0306        	  2374:     lea     ($0306,A4),A0
