02:0002B60E 3006            	  3537:     move.w  D6,D0
02:0002B610 4840            	  3538:     swap    D0
02:0002B612 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B618 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
