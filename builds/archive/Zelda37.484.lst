02:0000E646 02450003        	  1085:     andi.w  #$0003,D5
02:0000E64A EB4D            	  1086:     lsl.w   #5,D5
02:0000E64C E14D            	  1087:     lsl.w   #8,D5
02:0000E64E 5443            	  1088:     addq.w  #2,D3
