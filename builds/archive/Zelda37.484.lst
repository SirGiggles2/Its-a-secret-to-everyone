                            	  5416: CheckState30:
                            	  5417:     ; If major state <> $30, go check other states.
                            	  5418:     ;
02:0004878C 0C000030        	  5419:     cmpi.b  #$30,D0
02:00048790 6656            	  5420:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5421:     ; State $3x. Slow down.
                            	  5422:     ;
                            	  5423:     ; Reset grid offset for movement.
                            	  5424:     ;
02:00048792 7000            	  5425:     moveq   #0,D0
02:00048794 41EC0394        	  5426:     lea     ($0394,A4),A0
02:00048798 11802000        	  5427:     move.b  D0,(A0,D2.W)
                            	  5428:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5429:     ;
02:0004879C 7040            	  5430:     moveq   #64,D0
02:0004879E 41EC03BC        	  5431:     lea     ($03BC,A4),A0
02:000487A2 11802000        	  5432:     move.b  D0,(A0,D2.W)
                            	  5433:     ; If facing left and X < 2, then go change state to $40. The
                            	  5434:     ; boomerang is too close to the left edge of the screen.
                            	  5435:     ; Another move might make it wrap around.
                            	  5436:     ;
02:000487A6 41EC0098        	  5437:     lea     ($0098,A4),A0
02:000487AA 10302000        	  5438:     move.b  (A0,D2.W),D0
02:000487AE 1940000F        	  5439:     move.b  D0,($000F,A4)
02:000487B2 02000002        	  5440:     andi.b #$02,D0
