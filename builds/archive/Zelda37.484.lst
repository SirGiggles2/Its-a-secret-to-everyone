                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:0003FEC6 102C0055        	  5803:     move.b  ($0055,A4),D0
02:0003FECA 19400002        	  5804:     move.b  D0,($0002,A4)
02:0003FECE 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:0003FED2 0C000005        	  5806:     cmpi.b  #$05,D0
02:0003FED6 650C            	  5807:     bcs  _anon_z05_125
02:0003FED8 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:0003FEDA 7004            	  5809:     moveq   #4,D0
02:0003FEDC 4EB9000309B0    	  5810:     jsr     PlaySample
02:0003FEE2 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:0003FEE4 0C000004        	  5818:     cmpi.b  #$04,D0
02:0003FEE8 6602            	  5819:     bne  _anon_z05_126
02:0003FEEA 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:0003FEEC 0C000001        	  5822:     cmpi.b  #$01,D0
02:0003FEF0 6602            	  5823:     bne  _anon_z05_127
02:0003FEF2 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:0003FEF4 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEF8 123C0003        	  5829:     move.b  #$03,D1
02:0003FEFC 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF00 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:0003FF02 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF06 7600            	  5833:     moveq   #0,D3
02:0003FF08 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:0003FF0A 102C0008        	  5841:     move.b  ($0008,A4),D0
02:0003FF0E 6708            	  5842:     beq  _anon_z05_128
02:0003FF10 0C030005        	  5843:     cmpi.b  #$05,D3
02:0003FF14 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF16 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:0003FF18 0C030003        	  5847:     cmpi.b  #$03,D3
02:0003FF1C 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF1E 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:0003FF20 7003            	  5857:     moveq   #3,D0
02:0003FF22 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF26 122C0003        	  5859:     move.b  ($0003,A4),D1
02:0003FF2A 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF2E 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:0003FF30 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:0003FF34 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:0003FF38 41F90003FD0E    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:0003FF3E 10302000        	  5870:     move.b  (A0,D2.W),D0
02:0003FF42 1880            	  5871:     move.b  D0,($0000,A4)
02:0003FF44 41F90003FD12    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:0003FF4A 10302000        	  5873:     move.b  (A0,D2.W),D0
02:0003FF4E 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:0003FF52 19420009        	  5878:     move.b  D2,($0009,A4)
02:0003FF56 7400            	  5879:     moveq   #0,D2
02:0003FF58 142C0301        	  5880:     move.b  ($0301,A4),D2
