                            	  4986: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  4987:     ; Bloated timer =>
                            	  4988:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  4989:     ; 1:     go advance the substate
                            	  4990:     ; other: go decrement Bloated timer
                            	  4991:     ;
02:0003A3CC 7600            	  4992:     moveq   #0,D3
02:0003A3CE 41EC045E        	  4993:     lea     ($045E,A4),A0
02:0003A3D2 16302000        	  4994:     move.b  (A0,D2.W),D3
02:0003A3D6 5303            	  4995:     subq.b  #1,D3
02:0003A3D8 6750            	  4996:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A3DA 6B04            	  4997:     bmi.s  __far_z_04_0043
02:0003A3DC 60000080        	  4998:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  4999: __far_z_04_0043:
                            	  5000:     ; Set the bloated timer according to the substate.
                            	  5001:     ;
02:0003A3E0 7600            	  5002:     moveq   #0,D3
02:0003A3E2 41EC042C        	  5003:     lea     ($042C,A4),A0
02:0003A3E6 16302000        	  5004:     move.b  (A0,D2.W),D3
02:0003A3EA 41F90003A328    	  5005:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A3F0 10303000        	  5006:     move.b  (A0,D3.W),D0
02:0003A3F4 41EC045E        	  5007:     lea     ($045E,A4),A0
02:0003A3F8 11802000        	  5008:     move.b  D0,(A0,D2.W)
                            	  5009:     ; If substate <> 0, go decrement bloated timer.
                            	  5010:     ;
02:0003A3FC 4A03            	  5011:     cmpi.b  #$00,D3
02:0003A3FE 6702            	  5012:     beq.s  __far_z_04_0044
02:0003A400 605C            	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0044:
                            	  5015:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5016:     ;
02:0003A402 7610            	  5017:     moveq   #16,D3
02:0003A404 7000            	  5018:     moveq   #0,D0
02:0003A406 41EC00AC        	  5019:     lea     ($00AC,A4),A0
02:0003A40A 11803000        	  5020:     move.b  D0,(A0,D3.W)
                            	  5021:     ; Increment the number of bomb hits.
                            	  5022:     ;
02:0003A40E 41EC0437        	  5023:     lea     ($0437,A4),A0
02:0003A412 10302000        	  5024:     move.b  (A0,D2.W),D0
02:0003A416 023C00EE        	  5025:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A41A 123C0001        	  5026:     move.b  #$01,D1
02:0003A41E D101            	  5027:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A420 41EC0437        	  5028:     lea     ($0437,A4),A0
02:0003A424 11802000        	  5029:     move.b  D0,(A0,D2.W)
02:0003A428 6034            	  5030:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  5031: 
                            	  5032:     even
                            	  5033: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5034:     ; Advance the substate.
                            	  5035:     ;
02:0003A42A 41EC042C        	  5036:     lea     ($042C,A4),A0
02:0003A42E 52302000        	  5037:     addq.b  #1,(A0,D2.W)
                            	  5038:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5039:     ;
02:0003A432 41EC042C        	  5040:     lea     ($042C,A4),A0
02:0003A436 10302000        	  5041:     move.b  (A0,D2.W),D0
02:0003A43A 0C000002        	  5042:     cmpi.b  #$02,D0
02:0003A43E 6402            	  5043:     bcc.s  __far_z_04_0045
02:0003A440 601C            	  5044:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5045: __far_z_04_0045:
                            	  5046:     ; New bloated substate >= 2.
                            	  5047:     ;
                            	  5048:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5049:     ; which will transition to state 0 (moving).
                            	  5050:     ;
                            	  5051:     ; Note that if the bomb hits >= 2, then:
                            	  5052:     ; - If new substate = 2, then substate 2 will wait,
                            	  5053:     ;   and then transition to substate 3.
                            	  5054:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5055:     ;
02:0003A442 7600            	  5056:     moveq   #0,D3
02:0003A444 41EC0437        	  5057:     lea     ($0437,A4),A0
02:0003A448 16302000        	  5058:     move.b  (A0,D2.W),D3
02:0003A44C 0C030002        	  5059:     cmpi.b  #$02,D3
02:0003A450 6502            	  5060:     bcs.s  __far_z_04_0046
02:0003A452 600A            	  5061:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5062: __far_z_04_0046:
02:0003A454 7004            	  5063:     moveq   #4,D0
02:0003A456 41EC042C        	  5064:     lea     ($042C,A4),A0
02:0003A45A 11802000        	  5065:     move.b  D0,(A0,D2.W)
                            	  5066:     even
