                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BA72 701B            	  7996:     moveq   #27,D0
02:0003BA74 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BA78 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0003BA7C 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0003BA7E 1002            	  8005:     move.b  D2,D0
02:0003BA80 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0003BA82 610007F0        	  8007:     jsr     UpdateCandle
02:0003BA86 101D            	  8008:     move.b  (A5)+,D0  ; PLA
02:0003BA88 7400            	  8009:     moveq   #0,D2
02:0003BA8A 1400            	  8010:     move.b  D0,D2
                            	  8011:     ; Turn off the room brightening flag, because we're controlling it
                            	  8012:     ; here instead of in the Mode 5 object update loop.
                            	  8013:     ;
02:0003BA8C 7000            	  8014:     moveq   #0,D0
02:0003BA8E 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
                            	  8017:     ; Triforce/Ganon song.
                            	  8018:     ;
02:0003BA92 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0003BA96 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0003BA9A 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BA9C 7002            	  8022:     moveq   #2,D0
02:0003BA9E 19400600        	  8023:     move.b  D0,($0600,A4)
                            	  8024:     even
