                            	  5787: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  5788:     ; Timer:
                            	  5789:     ;   >= $10: Turn if needed and move every other frame
                            	  5790:     ;   > 1:    Do nothing
                            	  5791:     ;   = 1:    Choose a place to teleport to.
                            	  5792:     ;
                            	  5793:     ; Notice that walking is slower than teleporting; and there is
                            	  5794:     ; a pause of $10 frames at the end.
                            	  5795:     ;
02:0003A9F6 0C000010        	  5796:     cmpi.b  #$10,D0
