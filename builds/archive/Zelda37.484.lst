02:00048740 123C0010        	  5374:     move.b  #$10,D1
02:00048744 D101            	  5375:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00048746 41EC00AC        	  5376:     lea     ($00AC,A4),A0
02:0004874A 11802000        	  5377:     move.b  D0,(A0,D2.W)
