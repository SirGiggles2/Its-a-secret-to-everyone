02:000387A2 E308            	  1038:     lsl.b  #1,D0   ; ASL A
02:000387A4 E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:000387A6 E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:000387A8 E308            	  1041:     lsl.b  #1,D0   ; ASL A
