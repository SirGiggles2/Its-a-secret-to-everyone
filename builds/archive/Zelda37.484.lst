                            	  1710: 
                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002A9FC 0000E9FC        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA00 000129FC
02:0002AA04 000169FC        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002AA08 0001A9FC
02:0002AA0C 0001E9FC        	  1715:     dc.l    _nes_bank_04_data, _nes_bank_05_data
02:0002AA10 000229FC
02:0002AA14 000269FC        	  1716:     dc.l    _nes_bank_06_data, 0
02:0002AA18 00000000
