                            	  5354: _L_z04_UpdatePolsVoice_SetState1:
                            	  5355:     ; If already in state 1, then go draw and check collisions.
                            	  5356:     ;
02:0003A65E 41EC00AC        	  5357:     lea     ($00AC,A4),A0
02:0003A662 10302000        	  5358:     move.b  (A0,D2.W),D0
02:0003A666 6702            	  5359:     beq.s  __far_z_04_0048
02:0003A668 6068            	  5360:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5361: __far_z_04_0048:
                            	  5362:     ; Go to state 1.
                            	  5363:     ;
02:0003A66A 41EC00AC        	  5364:     lea     ($00AC,A4),A0
02:0003A66E 52302000        	  5365:     addq.b  #1,(A0,D2.W)
                            	  5366:     ; Subtract 1 from facing direction to make an index.
                            	  5367:     ;
02:0003A672 7600            	  5368:     moveq   #0,D3
02:0003A674 41EC0098        	  5369:     lea     ($0098,A4),A0
02:0003A678 16302000        	  5370:     move.b  (A0,D2.W),D3
02:0003A67C 5303            	  5371:     subq.b  #1,D3
                            	  5372:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5373:     ;
02:0003A67E 41EC0084        	  5374:     lea     ($0084,A4),A0
02:0003A682 10302000        	  5375:     move.b  (A0,D2.W),D0
02:0003A686 0C000078        	  5376:     cmpi.b  #$78,D0
02:0003A68A 6402            	  5377:     bcc  _anon_z04_97
02:0003A68C 7603            	  5378:     moveq   #3,D3
                            	  5379: _anon_z04_97:
                            	  5380:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5381:     ;
02:0003A68E 0C0000A8        	  5382:     cmpi.b  #$A8,D0
02:0003A692 6502            	  5383:     bcs  _anon_z04_98
02:0003A694 7607            	  5384:     moveq   #7,D3
                            	  5385: _anon_z04_98:
                            	  5386:     ; Set the vertical speed for the beginning of the jump.
                            	  5387:     ;
02:0003A696 41F90003A58A    	  5388:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003A69C 10303000        	  5389:     move.b  (A0,D3.W),D0
02:0003A6A0 41EC0412        	  5390:     lea     ($0412,A4),A0
02:0003A6A4 11802000        	  5391:     move.b  D0,(A0,D2.W)
                            	  5392:     ; Look up the Y offset for the current direction.
                            	  5393:     ; Add it to object Y to set the destination Y of the jump.
                            	  5394:     ;
02:0003A6A8 41EC0084        	  5395:     lea     ($0084,A4),A0
02:0003A6AC 10302000        	  5396:     move.b  (A0,D2.W),D0
02:0003A6B0 023C00EE        	  5397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A6B4 41F90003A592    	  5398:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003A6BA 12303000        	  5399:     move.b  (A0,D3.W),D1
02:0003A6BE D101            	  5400:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003A6C0 41EC042C        	  5401:     lea     ($042C,A4),A0
02:0003A6C4 11802000        	  5402:     move.b  D0,(A0,D2.W)
                            	  5403:     ; Turn the index into a direction again by adding 1.
                            	  5404:     ; Store the facing direction.
                            	  5405:     ;
02:0003A6C8 5203            	  5406:     addq.b  #1,D3
02:0003A6CA 41EC0098        	  5407:     lea     ($0098,A4),A0
02:0003A6CE 11832000        	  5408:     move.b  D3,(A0,D2.W)
