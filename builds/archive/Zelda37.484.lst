02:00038F8A 10302000        	  2171:     move.b  (A0,D2.W),D0
02:00038F8E 0C000022        	  2172:     cmpi.b  #$22,D0
02:00038F92 670000A6        	  2173:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2174:     ; Else we have an armos.
