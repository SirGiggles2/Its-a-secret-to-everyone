02:00047E22 7010            	  3955:     moveq   #16,D0
02:00047E24 163C00F0        	  3956:     move.b  #$F0,D3
                            	  3957: _anon_z07_15:
02:00047E28 1940010E        	  3958:     move.b  D0,($010E,A4)
02:00047E2C 1943010F        	  3959:     move.b  D3,($010F,A4)
02:00047E30 102C000F        	  3960:     move.b  ($000F,A4),D0
