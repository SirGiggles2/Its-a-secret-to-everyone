                            	  2135: DrawObjectWithAnimAndSpecificSprites:
02:00030E70 19400344        	  2136:     move.b  D0,($0344,A4)
02:00030E74 7600            	  2137:     moveq   #0,D3
02:00030E76 162C000E        	  2138:     move.b  ($000E,A4),D3
02:00030E7A 7001            	  2139:     moveq   #1,D0
02:00030E7C 19400007        	  2140:     move.b  D0,($0007,A4)
02:00030E80 7008            	  2141:     moveq   #8,D0
02:00030E82 1940000A        	  2142:     move.b  D0,($000A,A4)
02:00030E86 41F900030BD6    	  2143:     lea     (ObjAnimations).l,A0
02:00030E8C 10303000        	  2144:     move.b  (A0,D3.W),D0
02:00030E90 023C00EE        	  2145:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030E94 122C000D        	  2146:     move.b  ($000D,A4),D1
02:00030E98 D101            	  2147:     addx.b  D1,D0   ; ADC $0D
02:00030E9A 7600            	  2148:     moveq   #0,D3
02:00030E9C 1600            	  2149:     move.b  D0,D3
02:00030E9E 41F900030C56    	  2150:     lea     (ObjAnimFrameHeap).l,A0
02:00030EA4 10303000        	  2151:     move.b  (A0,D3.W),D0
02:00030EA8 19400002        	  2152:     move.b  D0,($0002,A4)
02:00030EAC 023C00EE        	  2153:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EB0 123C0002        	  2154:     move.b  #$02,D1
02:00030EB4 D101            	  2155:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030EB6 19400003        	  2156:     move.b  D0,($0003,A4)
                            	  2157:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  2158:     ; then go set attributes and write sprites.
                            	  2159:     ;
02:00030EBA 4A02            	  2160:     cmpi.b  #$00,D2
02:00030EBC 6722            	  2161:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00030EBE 0C02000D        	  2162:     cmpi.b  #$0D,D2
02:00030EC2 641C            	  2163:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
