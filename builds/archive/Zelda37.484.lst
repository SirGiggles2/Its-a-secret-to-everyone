                            	  4692:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  4693:     ;
                            	  4694:     ; Set the timer to a random time, at least $70 frames.
                            	  4695:     ;
02:0003A1AE 10342018        	  4696:     move.b  ($18,A4,D2.W),D0
02:0003A1B2 00000070        	  4697:     ori.b #$70,D0
02:0003A1B6 19802028        	  4698:     move.b  D0,($28,A4,D2.W)
                            	  4699:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  4700:     ;
02:0003A1BA 6168            	  4701:     jsr     ShootFireball55
02:0003A1BC 7000            	  4702:     moveq   #0,D0
02:0003A1BE 41EC0478        	  4703:     lea     ($0478,A4),A0
02:0003A1C2 11803000        	  4704:     move.b  D0,(A0,D3.W)
