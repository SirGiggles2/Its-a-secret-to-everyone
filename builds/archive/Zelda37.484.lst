02:0000E43A 0C412400        	   811:     cmpi.w  #$2400,D1
02:0000E43E 650A            	   812:     blo.s   .nt_no_a_mirror
02:0000E440 0C412800        	   813:     cmpi.w  #$2800,D1
02:0000E444 6404            	   814:     bhs.s   .nt_no_a_mirror
02:0000E446 04410400        	   815:     subi.w  #$0400,D1
