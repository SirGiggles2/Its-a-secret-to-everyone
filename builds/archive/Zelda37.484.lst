02:00039002 0C000070        	  2260:     cmpi.b  #$70,D0
02:00039006 6604            	  2261:     bne  _anon_z04_51
02:00039008 61000682        	  2262:     jsr     PlaySecretFoundTune
                            	  2263: _anon_z04_51:
                            	  2264:     ; Replace the tile where the armos was.
                            	  2265:     ;
02:0003900C 522C00F7        	  2266:     addq.b  #1,($00F7,A4)
02:00039010 101D            	  2267:     move.b  (A5)+,D0  ; PLA
02:00039012 4EB900047212    	  2268:     jsr     ChangeTileObjTiles
                            	  2269:     ; Because the armos object is aligned to the square grid
                            	  2270:     ; (because it was made from a square),
                            	  2271:     ; set its grid offset to 3 to compensate.
                            	  2272:     ;
                            	  2273:     ; Most objects are aligned to the grid vertically when the
                            	  2274:     ; low nibble is $D.
                            	  2275:     ;
02:00039018 7003            	  2276:     moveq   #3,D0
02:0003901A 41EC0394        	  2277:     lea     ($0394,A4),A0
02:0003901E 11802000        	  2278:     move.b  D0,(A0,D2.W)
                            	  2279:     ; Set a speed (q-speed fraction) randomly:
                            	  2280:     ; $20 if random value < $80
                            	  2281:     ; $60 otherwise
                            	  2282:     ;
02:00039022 7020            	  2283:     moveq   #32,D0
02:00039024 7600            	  2284:     moveq   #0,D3
02:00039026 16342019        	  2285:     move.b  ($19,A4,D2.W),D3
02:0003902A 0C030080        	  2286:     cmpi.b  #$80,D3
02:0003902E 6502            	  2287:     bcs  _anon_z04_52
02:00039030 7060            	  2288:     moveq   #96,D0
                            	  2289: _anon_z04_52:
02:00039032 41EC03BC        	  2290:     lea     ($03BC,A4),A0
02:00039036 11802000        	  2291:     move.b  D0,(A0,D2.W)
                            	  2292:     even
                            	  2293: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  2294:     ; Facing and input directions down.
                            	  2295:     ;
02:0003903A 7004            	  2296:     moveq   #4,D0
02:0003903C 41EC03F8        	  2297:     lea     ($03F8,A4),A0
02:00039040 11802000        	  2298:     move.b  D0,(A0,D2.W)
02:00039044 41EC0098        	  2299:     lea     ($0098,A4),A0
02:00039048 11802000        	  2300:     move.b  D0,(A0,D2.W)
                            	  2301:     ; Every other frame, return without drawing.
                            	  2302:     ;
02:0003904C 10342028        	  2303:     move.b  ($28,A4,D2.W),D0
02:00039050 E208            	  2304:     lsr.b  #1,D0   ; LSR A
02:00039052 6512            	  2305:     bcs  _anon_z04_53
                            	  2306:     ; Finish initializing based on type.
                            	  2307:     ;
02:00039054 41EC034F        	  2308:     lea     ($034F,A4),A0
02:00039058 10302000        	  2309:     move.b  (A0,D2.W),D0
02:0003905C 0C000022        	  2310:     cmpi.b  #$22,D0
