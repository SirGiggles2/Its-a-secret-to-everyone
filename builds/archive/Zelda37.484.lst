                            	  2183: _anon_z01_76:
                            	  2184:     ; If it's Link, write the sprites. He's never mirrored.
                            	  2185:     ;
02:00030EEE 4A02            	  2186:     cmpi.b  #$00,D2
02:00030EF0 6602            	  2187:     bne.s  __far_z_01_0002
02:00030EF2 6014            	  2188:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  2189: __far_z_01_0002:
                            	  2190:     ; For other objects, the caller controls mirroring and flipping.
                            	  2191:     ;
                            	  2192:     ; If mirrored [0C], then draw it mirrored.
                            	  2193:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  2194:     ;
02:00030EF4 7600            	  2195:     moveq   #0,D3
02:00030EF6 162C000C        	  2196:     move.b  ($000C,A4),D3
02:00030EFA 6602            	  2197:     bne.s  __far_z_01_0003
02:00030EFC 600A            	  2198:     jmp  Anim_WriteHorizontallyFlippableSpritePair
