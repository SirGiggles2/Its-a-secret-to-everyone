                            	  5567: _L_z07_CheckState30_MoveTowardThrower:
                            	  5568:     ; Move towards the thrower.
                            	  5569:     ;
                            	  5570:     ; Middle speed index 4 goes equally fast in X and Y axes.
                            	  5571:     ;
02:00048878 7604            	  5572:     moveq   #4,D3
02:0004887A 4EB900030A6A    	  5573:     jsr     _CalcDiagonalSpeedIndex
