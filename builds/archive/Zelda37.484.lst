                            	   255: _anon_z04_7:
                            	   256:     ; If speed = 0, or the object is between squares;
                            	   257:     ; then go set input direction to facing direction.
                            	   258:     ;
02:00038214 41EC03BC        	   259:     lea     ($03BC,A4),A0
02:00038218 10302000        	   260:     move.b  (A0,D2.W),D0
02:0003821C 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:00038220 41EC0394        	   262:     lea     ($0394,A4),A0
02:00038224 10302000        	   263:     move.b  (A0,D2.W),D0
02:00038228 0200000F        	   264:     andi.b #$0F,D0
02:0003822C 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:00038230 41EC0394        	   268:     lea     ($0394,A4),A0
02:00038234 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:00038238 41EC041F        	   273:     lea     ($041F,A4),A0
02:0003823C 10302000        	   274:     move.b  (A0,D2.W),D0
02:00038240 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:00038244 B001            	   276:     cmp.b   D1,D0
02:00038246 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:0003824A 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:0003824E 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:00038252 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:00038256 102C0061        	   284:     move.b  ($0061,A4),D0
02:0003825A 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:0003825E 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:00038262 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038266 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:00038268 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:0003826C 6A0C            	   290:     bpl  _anon_z04_8
02:0003826E 4600            	   291:     eori.b #$FF,D0
02:00038270 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038274 123C0001        	   293:     move.b  #$01,D1
02:00038278 D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
                            	   297:     ;
02:0003827A 0C000009        	   298:     cmpi.b  #$09,D0
02:0003827E 6416            	   299:     bcc  _L_z04_Exit_CheckVerticalDistance
                            	   300:     even
