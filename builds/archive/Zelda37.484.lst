                            	  9384:     ; if observed player Y <> object Y then
                            	  9385:     ;   if observed player Y < object Y then
                            	  9386:     ;     Y := Y << 1   -- makes it 8 (up)
                            	  9387:     ;   [00] := [00] | Y
                            	  9388:     ;
02:0003C3CE 7601            	  9389:     moveq   #1,D3
02:0003C3D0 102C0062        	  9390:     move.b  ($0062,A4),D0
02:0003C3D4 41EC0084        	  9391:     lea     ($0084,A4),A0
