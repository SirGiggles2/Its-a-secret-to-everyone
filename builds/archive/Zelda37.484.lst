                            	  1106: ;==============================================================================
                            	  1107: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1108: ; Input: D0 = control byte → Output: D0 = length
                            	  1109: ;==============================================================================
                            	  1110: get_song_note_length:
02:00000B62 02400007        	  1111:     andi.w  #$07,D0
02:00000B66 7200            	  1112:     moveq   #0,D1
02:00000B68 123900FFE003    	  1113:     move.b  (m_len_base).l,D1
02:00000B6E D240            	  1114:     add.w   D0,D1
02:00000B70 43F900000DE4    	  1115:     lea     (NoteLengthTables).l,A1
02:00000B76 10311000        	  1116:     move.b  (A1,D1.w),D0
02:00000B7A 4E75            	  1117:     rts
                            	  1118: 
                            	  1119: ;==============================================================================
                            	  1120: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1121: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1122: ;==============================================================================
                            	  1123: emit_note_sq1:
02:00000B7C 024000FF        	  1124:     andi.w  #$FF,D0
02:00000B80 43F900000D72    	  1125:     lea     (MusicNotePeriodTable).l,A1
02:00000B86 7400            	  1126:     moveq   #0,D2
02:00000B88 14310001        	  1127:     move.b  1(A1,D0.w),D2                 ; lo
02:00000B8C 67000106        	  1128:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000B90 7600            	  1129:     moveq   #0,D3
02:00000B92 16310000        	  1130:     move.b  0(A1,D0.w),D3                 ; hi
02:00000B96 E14B            	  1131:     lsl.w   #8,D3
02:00000B98 8642            	  1132:     or.w    D2,D3                          ; D3.w = period
02:00000B9A 024307FF        	  1133:     andi.w  #$07FF,D3
02:00000B9E 13C200FFE010    	  1134:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000BA4 3403            	  1135:     move.w  D3,D2
02:00000BA6 263C00021986    	  1136:     move.l  #NES_YM_K5_PULSE,D3
02:00000BAC 6100F804        	  1137:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1138:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000BB0 103C0028        	  1139:     move.b  #$28,D0
02:00000BB4 7200            	  1140:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000BB6 6100F7B2        	  1141:     bsr     ym_write1
02:00000BBA 103C00A4        	  1142:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000BBE 1202            	  1143:     move.b  D2,D1
02:00000BC0 6100F7A8        	  1144:     bsr     ym_write1
02:00000BC4 103C00A0        	  1145:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000BC8 1203            	  1146:     move.b  D3,D1
02:00000BCA 6100F79E        	  1147:     bsr     ym_write1
                            	  1148:     ; Key on ch 0, all ops
02:00000BCE 103C0028        	  1149:     move.b  #$28,D0
02:00000BD2 123C00F0        	  1150:     move.b  #$F0,D1
02:00000BD6 6000F792        	  1151:     bra     ym_write1
                            	  1152: 
                            	  1153: ;==============================================================================
                            	  1154: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1155: ;==============================================================================
                            	  1156: emit_note_sq0:
02:00000BDA 024000FF        	  1157:     andi.w  #$FF,D0
02:00000BDE 43F900000D72    	  1158:     lea     (MusicNotePeriodTable).l,A1
02:00000BE4 7400            	  1159:     moveq   #0,D2
02:00000BE6 14310001        	  1160:     move.b  1(A1,D0.w),D2
02:00000BEA 670000B4        	  1161:     beq     key_off_sq0
02:00000BEE 7600            	  1162:     moveq   #0,D3
02:00000BF0 16310000        	  1163:     move.b  0(A1,D0.w),D3
02:00000BF4 E14B            	  1164:     lsl.w   #8,D3
02:00000BF6 8642            	  1165:     or.w    D2,D3
02:00000BF8 024307FF        	  1166:     andi.w  #$07FF,D3
02:00000BFC 13C200FFE018    	  1167:     move.b  D2,(m_sq0_per).l
02:00000C02 3403            	  1168:     move.w  D3,D2
02:00000C04 263C00021986    	  1169:     move.l  #NES_YM_K5_PULSE,D3
02:00000C0A 6100F7A6        	  1170:     bsr     nes_to_ym_freq
                            	  1171:     ; Key off first so the envelope attack phase retriggers
02:00000C0E 103C0028        	  1172:     move.b  #$28,D0
02:00000C12 7201            	  1173:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C14 6100F754        	  1174:     bsr     ym_write1
02:00000C18 103C00A5        	  1175:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000C1C 1202            	  1176:     move.b  D2,D1
02:00000C1E 6100F74A        	  1177:     bsr     ym_write1
02:00000C22 103C00A1        	  1178:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C26 1203            	  1179:     move.b  D3,D1
02:00000C28 6100F740        	  1180:     bsr     ym_write1
02:00000C2C 103C0028        	  1181:     move.b  #$28,D0
02:00000C30 123C00F1        	  1182:     move.b  #$F1,D1
02:00000C34 6000F734        	  1183:     bra     ym_write1
                            	  1184: 
                            	  1185: ;==============================================================================
                            	  1186: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1187: ;==============================================================================
                            	  1188: emit_note_trg:
02:00000C38 024000FF        	  1189:     andi.w  #$FF,D0
02:00000C3C 43F900000D72    	  1190:     lea     (MusicNotePeriodTable).l,A1
02:00000C42 7400            	  1191:     moveq   #0,D2
02:00000C44 14310001        	  1192:     move.b  1(A1,D0.w),D2
02:00000C48 6762            	  1193:     beq     key_off_trg
02:00000C4A 7600            	  1194:     moveq   #0,D3
02:00000C4C 16310000        	  1195:     move.b  0(A1,D0.w),D3
02:00000C50 E14B            	  1196:     lsl.w   #8,D3
02:00000C52 8642            	  1197:     or.w    D2,D3
02:00000C54 024307FF        	  1198:     andi.w  #$07FF,D3
02:00000C58 13C200FFE020    	  1199:     move.b  D2,(m_trg_per).l
02:00000C5E 3403            	  1200:     move.w  D3,D2
02:00000C60 263C00010CC3    	  1201:     move.l  #NES_YM_K5_TRI,D3
02:00000C66 6100F74A        	  1202:     bsr     nes_to_ym_freq
                            	  1203:     ; Key off first so the bass envelope retriggers per note
02:00000C6A 103C0028        	  1204:     move.b  #$28,D0
02:00000C6E 7202            	  1205:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000C70 6100F6F8        	  1206:     bsr     ym_write1
02:00000C74 103C00A6        	  1207:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000C78 1202            	  1208:     move.b  D2,D1
02:00000C7A 6100F6EE        	  1209:     bsr     ym_write1
02:00000C7E 103C00A2        	  1210:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000C82 1203            	  1211:     move.b  D3,D1
02:00000C84 6100F6E4        	  1212:     bsr     ym_write1
02:00000C88 103C0028        	  1213:     move.b  #$28,D0
02:00000C8C 123C00F2        	  1214:     move.b  #$F2,D1
02:00000C90 6000F6D8        	  1215:     bra     ym_write1
                            	  1216: 
                            	  1217: ;==============================================================================
                            	  1218: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1219: ;==============================================================================
                            	  1220: key_off_sq1:
02:00000C94 103C0028        	  1221:     move.b  #$28,D0
02:00000C98 123C0000        	  1222:     move.b  #$00,D1
02:00000C9C 6000F6CC        	  1223:     bra     ym_write1
                            	  1224: key_off_sq0:
02:00000CA0 103C0028        	  1225:     move.b  #$28,D0
02:00000CA4 123C0001        	  1226:     move.b  #$01,D1
02:00000CA8 6000F6C0        	  1227:     bra     ym_write1
                            	  1228: key_off_trg:
02:00000CAC 103C0028        	  1229:     move.b  #$28,D0
02:00000CB0 123C0002        	  1230:     move.b  #$02,D1
02:00000CB4 6000F6B4        	  1231:     bra     ym_write1
                            	  1232: 
                            	  1233: ;==============================================================================
                            	  1234: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1235: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1236: ;
                            	  1237: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1238: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1239: ;     PsgDrumTable.
                            	  1240: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1241: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1242: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1243: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1244: ;     noise_decay_tick.
                            	  1245: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1246: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1247: ;==============================================================================
                            	  1248: set_psg_noise:
                            	  1249:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1250:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1251:     ; music drums resume on the next beat.
02:00000CB8 4A3900FF0606    	  1252:     tst.b   ($00FF0606).l
02:00000CBE 661A            	  1253:     bne.s   .sfx_owns_psg
02:00000CC0 4A01            	  1254:     tst.b   D1
02:00000CC2 6618            	  1255:     bne.s   .not_rest
                            	  1256:     ; Rest: silence the PSG noise channel immediately.
02:00000CC4 423900FFE026    	  1257:     clr.b   (m_noise_level).l
02:00000CCA 423900FFE027    	  1258:     clr.b   (m_noise_decay).l
02:00000CD0 13FC00FF00C00011	  1259:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000CD8 4E75            	  1260:     rts
                            	  1261: .sfx_owns_psg:
02:00000CDA 4E75            	  1262:     rts
                            	  1263: .not_rest:
02:00000CDC 7000            	  1264:     moveq   #0,D0
02:00000CDE 1001            	  1265:     move.b  D1,D0
02:00000CE0 E548            	  1266:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000CE2 43F900000E18    	  1267:     lea     (PsgDrumTable).l,A1
02:00000CE8 D3C0            	  1268:     adda.l  D0,A1
02:00000CEA 1019            	  1269:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1270:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000CEC B03900FFE028    	  1271:     cmp.b   (m_last_psg_nc).l,D0
02:00000CF2 670C            	  1272:     beq.s   .nc_same
02:00000CF4 13C000FFE028    	  1273:     move.b  D0,(m_last_psg_nc).l
02:00000CFA 13C000C00011    	  1274:     move.b  D0,(PSG_PORT).l
                            	  1275: .nc_same:
02:00000D00 1019            	  1276:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D02 13C000FFE026    	  1277:     move.b  D0,(m_noise_level).l
02:00000D08 1019            	  1278:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D0A 13C000FFE027    	  1279:     move.b  D0,(m_noise_decay).l
                            	  1280:     bra     write_psg_noise_vol
                            	  1281: 
                            	  1282: ;==============================================================================
                            	  1283: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1284: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1285: ; Preserves D1.
                            	  1286: ;==============================================================================
                            	  1287: write_psg_noise_vol:
02:00000D10 4A3900FF0606    	  1288:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D16 6618            	  1289:     bne.s   .wpnv_skip
02:00000D18 7000            	  1290:     moveq   #0,D0
02:00000D1A 103900FFE026    	  1291:     move.b  (m_noise_level).l,D0
02:00000D20 E808            	  1292:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D22 0A00000F        	  1293:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D26 000000F0        	  1294:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D2A 13C000C00011    	  1295:     move.b  D0,(PSG_PORT).l
                            	  1296: .wpnv_skip:
02:00000D30 4E75            	  1297:     rts
                            	  1298: 
                            	  1299: ;==============================================================================
                            	  1300: ; noise_decay_tick — linear envelope decay step.
                            	  1301: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1302: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1303: ; Preserves D1.
                            	  1304: ;==============================================================================
                            	  1305: noise_decay_tick:
02:00000D32 4A3900FF0606    	  1306:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000D38 661A            	  1307:     bne.s   .nd_done
02:00000D3A 103900FFE026    	  1308:     move.b  (m_noise_level).l,D0
02:00000D40 6712            	  1309:     beq.s   .nd_done                        ; already silent
02:00000D42 903900FFE027    	  1310:     sub.b   (m_noise_decay).l,D0
02:00000D48 6402            	  1311:     bcc.s   .nd_store                       ; no underflow → new level
02:00000D4A 7000            	  1312:     moveq   #0,D0                           ; underflow → silent
                            	  1313: .nd_store:
02:00000D4C 13C000FFE026    	  1314:     move.b  D0,(m_noise_level).l
02:00000D52 60BC            	  1315:     bra     write_psg_noise_vol
                            	  1316: .nd_done:
02:00000D54 4E75            	  1317:     rts
                            	  1318: 
                            	  1319: ;==============================================================================
                            	  1320: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1321: ;==============================================================================
                            	  1322: music_silence:
02:00000D56 423900FFE000    	  1323:     clr.b   (m_song).l
02:00000D5C 6100FF36        	  1324:     bsr     key_off_sq1
02:00000D60 6100FF3E        	  1325:     bsr     key_off_sq0
02:00000D64 6100FF46        	  1326:     bsr     key_off_trg
02:00000D68 13FC00FF00C00011	  1327:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000D70 4E75            	  1328:     rts
                            	  1329: 
