                            	  4186: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  4187:     ; Digdogger is big, but room boundary checks and
                            	  4188:     ; object collision checks assume a 16x16 monster or smaller.
                            	  4189:     ; Therefore, we have to check these things four times,
                            	  4190:     ; in different corners of the boss.
                            	  4191:     ;
                            	  4192:     ; Loop 4 times, from 0 to 3.
                            	  4193:     ;
02:00039D7A 7600            	  4194:     moveq   #0,D3
02:00039D7C 41EC0478        	  4195:     lea     ($0478,A4),A0
02:00039D80 16302000        	  4196:     move.b  (A0,D2.W),D3
                            	  4197:     ; Change the coordinates to one corner.
                            	  4198:     ;
02:00039D84 10342070        	  4199:     move.b  ($70,A4,D2.W),D0
02:00039D88 023C00EE        	  4200:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039D8C 41F900039C40    	  4201:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039D92 12303000        	  4202:     move.b  (A0,D3.W),D1
02:00039D96 D101            	  4203:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:00039D98 19802070        	  4204:     move.b  D0,($70,A4,D2.W)
02:00039D9C 41EC0084        	  4205:     lea     ($0084,A4),A0
02:00039DA0 10302000        	  4206:     move.b  (A0,D2.W),D0
02:00039DA4 023C00EE        	  4207:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039DA8 41F900039C44    	  4208:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039DAE 12303000        	  4209:     move.b  (A0,D3.W),D1
02:00039DB2 D101            	  4210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039DB4 41EC0084        	  4211:     lea     ($0084,A4),A0
02:00039DB8 11802000        	  4212:     move.b  D0,(A0,D2.W)
                            	  4213:     ; Check the room boundary and object collisions in this temporary location.
