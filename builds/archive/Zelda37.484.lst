02:0003A1FE 10302000        	  4742:     move.b  (A0,D2.W),D0
02:0003A202 023C00EE        	  4743:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A206 41EC0478        	  4744:     lea     ($0478,A4),A0
02:0003A20A 12302000        	  4745:     move.b  (A0,D2.W),D1
02:0003A20E D101            	  4746:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A210 41EC0084        	  4747:     lea     ($0084,A4),A0
02:0003A214 11802000        	  4748:     move.b  D0,(A0,D2.W)
                            	  4749:     even
                            	  4750: _L_z04_Aquamentus_Shoot_NextLoopObject:
