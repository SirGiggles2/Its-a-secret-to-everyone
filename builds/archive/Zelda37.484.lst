02:0003BA36 10302000        	  7961:     move.b  (A0,D2.W),D0
02:0003BA3A 6704            	  7962:     beq  _L_z04_PatraChild_State1_Exit
02:0003BA3C 6100FDD4        	  7963:     jsr     SetDeadDummyObjType
                            	  7964:     even
