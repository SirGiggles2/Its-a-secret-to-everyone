02:00000E1D E0
02:00000E1E 30
02:00000E1F 00
02:00000E20 E5              	  1388:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000E21 FF
02:00000E22 0E
02:00000E23 00
02:00000E24 E4              	  1389:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
