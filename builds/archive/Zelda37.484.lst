02:0002BFB2 08000008        	  2507:     btst    #8,D0
02:0002BFB6 670A            	  2508:     beq.s   .cc_cnr
02:0002BFB8 003C0001        	  2509:     ori     #$01,CCR
02:0002BFBC 0A3C0001        	  2510:     eori    #$01,CCR
02:0002BFC0 4E75            	  2511:     rts
                            	  2512: .cc_cnr:
02:0002BFC2 023C00FE        	  2513:     andi    #$FE,CCR
02:0002BFC6 0A3C0001        	  2514:     eori    #$01,CCR
02:0002BFCA 4E75            	  2515:     rts
