02:000487B8 10342070        	  5442:     move.b  ($70,A4,D2.W),D0
02:000487BC 0C000002        	  5443:     cmpi.b  #$02,D0
02:000487C0 650E            	  5444:     bcs  _L_z07_CheckState30_SetState40
                            	  5445:     even
