                            	   726: CopyCommonCodeToRam:
                            	   727:     ; PATCHED: NOP — all code is in flat ROM on Genesis.
02:0002F512 4E75            	   728:     rts
02:0002F514 7000            	   729:     moveq   #0,D0
02:0002F516 1880            	   730:     move.b  D0,($0000,A4)
02:0002F518 103C00A5        	   731:     move.b  #$A5,D0
02:0002F51C 19400001        	   732:     move.b  D0,($0001,A4)
02:0002F520 103C0090        	   733:     move.b  #$90,D0
02:0002F524 19400002        	   734:     move.b  D0,($0002,A4)
02:0002F528 706C            	   735:     moveq   #108,D0
02:0002F52A 19400003        	   736:     move.b  D0,($0003,A4)
02:0002F52E 7600            	   737:     moveq   #0,D3
