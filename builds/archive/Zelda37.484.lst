                            	   399: L_Walker_SetInputDirAndTryShootingBoomerang:
                            	   400:     ; Set the input direction to the facing direction.
                            	   401:     ;
02:00038322 41EC0098        	   402:     lea     ($0098,A4),A0
02:00038326 10302000        	   403:     move.b  (A0,D2.W),D0
02:0003832A 41EC03F8        	   404:     lea     ($03F8,A4),A0
02:0003832E 11802000        	   405:     move.b  D0,(A0,D2.W)
                            	   406:     ; Goriya will throw a boomerang (object type $5C).
                            	   407:     ;
02:00038332 705C            	   408:     moveq   #92,D0
                            	   409:     ; If the monster is a blue goriya, go check the timer.
                            	   410:     ;
02:00038334 7600            	   411:     moveq   #0,D3
02:00038336 41EC034F        	   412:     lea     ($034F,A4),A0
02:0003833A 16302000        	   413:     move.b  (A0,D2.W),D3
02:0003833E 0C030005        	   414:     cmpi.b  #$05,D3
02:00038342 671C            	   415:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   416:     ; If it's not a red goriya either, then return.
                            	   417:     ;
02:00038344 0C030006        	   418:     cmpi.b  #$06,D3
02:00038348 660000A0        	   419:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   420:     ; If a random value <> $23 nor $77, then return.
                            	   421:     ;
02:0003834C 10342018        	   422:     move.b  ($18,A4,D2.W),D0
02:00038350 0C000023        	   423:     cmpi.b  #$23,D0
02:00038354 6708            	   424:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:00038356 0C000077        	   425:     cmpi.b  #$77,D0
02:0003835A 6600008E        	   426:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   427:     even
                            	   428: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang:
                            	   429:     ; Goriya will throw a boomerang (object type $5C).
                            	   430:     ;
02:0003835E 705C            	   431:     moveq   #92,D0
                            	   432:     even
                            	   433: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot:
                            	   434:     ; If object timer <> 0, return.
                            	   435:     ;
02:00038360 7600            	   436:     moveq   #0,D3
02:00038362 16342028        	   437:     move.b  ($28,A4,D2.W),D3
02:00038366 66000082        	   438:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   439:     ; Store in [00] the type of projectile the monster will throw.
                            	   440:     ;
02:0003836A 1880            	   441:     move.b  D0,($0000,A4)
                            	   442:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   443:     ;
02:0003836C 102C066C        	   444:     move.b  ($066C,A4),D0
02:00038370 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:00038374 8001            	   446:     or.b  D1,D0
02:00038376 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
                            	   449:     ;
02:00038378 1014            	   450:     move.b  ($0000,A4),D0
02:0003837A 61003EBA        	   451:     jsr     _ShootIfWanted
02:0003837E 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:00038380 103C0080        	   455:     move.b  #$80,D0
02:00038384 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:00038388 11802000        	   457:     move.b  D0,(A0,D2.W)
                            	   458:     ; Reset the "wants to shoot" flag.
                            	   459:     ;
02:0003838C 7000            	   460:     moveq   #0,D0
02:0003838E 41EC0412        	   461:     lea     ($0412,A4),A0
02:00038392 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
                            	   464:     ;
02:00038396 1002            	   465:     move.b  D2,D0
02:00038398 41EC042C        	   466:     lea     ($042C,A4),A0
02:0003839C 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:000383A0 1003            	   470:     move.b  D3,D0
02:000383A2 41EC042C        	   471:     lea     ($042C,A4),A0
02:000383A6 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
02:000383AA 7010            	   475:     moveq   #16,D0
02:000383AC 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:000383B0 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   479:     ;
02:000383B4 103C00A0        	   480:     move.b  #$A0,D0
02:000383B8 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:000383BC 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:000383C0 7051            	   485:     moveq   #81,D0
