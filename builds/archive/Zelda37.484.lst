02:0003A5A2 102C066C        	  5255:     move.b  ($066C,A4),D0
02:0003A5A6 1234203D        	  5256:     move.b  ($3D,A4,D2.W),D1
02:0003A5AA 8001            	  5257:     or.b  D1,D0
02:0003A5AC 660000AE        	  5258:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5259:     ; Every odd screen frame, go straight to drawing
                            	  5260:     ; and checking collisions.
                            	  5261:     ;
02:0003A5B0 102C0015        	  5262:     move.b  ($0015,A4),D0
