02:00032ECE 761F            	  1296:     moveq   #31,D3
02:00032ED0 103C00FF        	  1297:     move.b  #$FF,D0
02:00032ED4 43EC0306        	  1298:     lea     ($0306,A4),A1
02:00032ED8 13803000        	  1299:     move.b  D0,(A1,D3.W)
