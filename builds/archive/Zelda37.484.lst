02:00030F16 102C0003        	  2233:     move.b  ($0003,A4),D0
02:00030F1A 19400002        	  2234:     move.b  D0,($0002,A4)
02:00030F1E 101D            	  2235:     move.b  (A5)+,D0  ; PLA
02:00030F20 19400003        	  2236:     move.b  D0,($0003,A4)
                            	  2237:     ; Set the horizontal flip sprite attributes.
                            	  2238:     ;
02:00030F24 102C0004        	  2239:     move.b  ($0004,A4),D0
02:00030F28 0A000040        	  2240:     eori.b #$40,D0
02:00030F2C 19400004        	  2241:     move.b  D0,($0004,A4)
02:00030F30 102C0005        	  2242:     move.b  ($0005,A4),D0
02:00030F34 0A000040        	  2243:     eori.b #$40,D0
02:00030F38 19400005        	  2244:     move.b  D0,($0005,A4)
                            	  2245: ; Params:
                            	  2246: ; [00]: Object X
