                            	  8711: Ganon_AppendPaletteRowTransferRecord_Triforce:
02:0003BF70 7608            	  8712:     moveq   #8,D3
                            	  8713: _anon_z04_165:
02:0003BF72 1003            	  8714:     move.b  D3,D0
02:0003BF74 1B00            	  8715:     move.b  D0,-(A5)  ; PHA
                            	  8716:     ; Get the length, to append to the dynamic transfer buf.
                            	  8717:     ;
02:0003BF76 7400            	  8718:     moveq   #0,D2
02:0003BF78 142C0301        	  8719:     move.b  ($0301,A4),D2
                            	  8720:     ; Copy the 8 bytes of the palette row transfer record template.
                            	  8721:     ;
02:0003BF7C 7600            	  8722:     moveq   #0,D3
                            	  8723:     even
                            	  8724: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003BF7E 41F90003BF56    	  8725:     lea     (GanonColorTransferRecord).l,A0
02:0003BF84 10303000        	  8726:     move.b  (A0,D3.W),D0
02:0003BF88 41EC0302        	  8727:     lea     ($0302,A4),A0
02:0003BF8C 11802000        	  8728:     move.b  D0,(A0,D2.W)
02:0003BF90 5202            	  8729:     addq.b  #1,D2
02:0003BF92 5203            	  8730:     addq.b  #1,D3
02:0003BF94 0C030008        	  8731:     cmpi.b  #$08,D3
02:0003BF98 66E4            	  8732:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003BF9A 19420301        	  8733:     move.b  D2,($0301,A4)
02:0003BF9E 101D            	  8734:     move.b  (A5)+,D0  ; PLA
02:0003BFA0 7600            	  8735:     moveq   #0,D3
02:0003BFA2 1600            	  8736:     move.b  D0,D3
                            	  8737:     ; Overwrite the last 3 colors in the record, with the ones
                            	  8738:     ; ending at the index passed in.
                            	  8739:     ;
02:0003BFA4 7402            	  8740:     moveq   #2,D2
                            	  8741:     even
                            	  8742: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors:
02:0003BFA6 41F90003BF5E    	  8743:     lea     (GanonColorSets).l,A0
02:0003BFAC 10303000        	  8744:     move.b  (A0,D3.W),D0
02:0003BFB0 41EC0306        	  8745:     lea     ($0306,A4),A0
02:0003BFB4 11802000        	  8746:     move.b  D0,(A0,D2.W)
02:0003BFB8 5303            	  8747:     subq.b  #1,D3
02:0003BFBA 5302            	  8748:     subq.b  #1,D2
02:0003BFBC 6AE8            	  8749:     bpl  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors
02:0003BFBE 7400            	  8750:     moveq   #0,D2
02:0003BFC0 142C0340        	  8751:     move.b  ($0340,A4),D2
