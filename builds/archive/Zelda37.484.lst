02:00048850 0C000070        	  5548:     cmpi.b  #$70,D0
02:00048854 6502            	  5549:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:00048856 7670            	  5550:     moveq   #112,D3
                            	  5551:     even
                            	  5552: _L_z07_CheckState30_SetThrowerTimer:
02:00048858 1003            	  5553:     move.b  D3,D0
02:0004885A 7600            	  5554:     moveq   #0,D3
02:0004885C 41EC042C        	  5555:     lea     ($042C,A4),A0
02:00048860 16302000        	  5556:     move.b  (A0,D2.W),D3
02:00048864 19803028        	  5557:     move.b  D0,($28,A4,D3.W)
                            	  5558:     ; Reset the thrower's state to make it idle or restart its state machine.
                            	  5559:     ; Destroy the monster's boomerang.
