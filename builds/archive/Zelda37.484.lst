02:00047244 41EC0307        	  2334:     lea     ($0307,A4),A0
02:00047248 11802000        	  2335:     move.b  D0,(A0,D2.W)
                            	  2336:     ; Write the low address in the first record. In the second record,
                            	  2337:     ; write (low address + 1).
                            	  2338:     ;
02:0004724C 102C0001        	  2339:     move.b  ($0001,A4),D0
02:00047250 41EC0303        	  2340:     lea     ($0303,A4),A0
