02:00041266 162C0084        	  7843:     move.b  ($0084,A4),D3
02:0004126A 0C030085        	  7844:     cmpi.b  #$85,D3
02:0004126E 6642            	  7845:     bne  _anon_z05_177
02:00041270 102C0098        	  7846:     move.b  ($0098,A4),D0
02:00041274 02000004        	  7847:     andi.b #$04,D0
02:00041278 6738            	  7848:     beq  _anon_z05_177
                            	  7849:     even
