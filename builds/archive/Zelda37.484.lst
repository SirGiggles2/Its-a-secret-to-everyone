02:0003BAE6 19400505        	  8079:     move.b  D0,($0505,A4)
02:0003BAEA 7020            	  8080:     moveq   #32,D0
02:0003BAEC 19400600        	  8081:     move.b  D0,($0600,A4)
02:0003BAF0 522C0445        	  8082:     addq.b  #1,($0445,A4)
                            	  8083:     even
