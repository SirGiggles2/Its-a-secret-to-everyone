02:000495F6 7400            	  7283:     moveq   #0,D2
02:000495F8 142C0340        	  7284:     move.b  ($0340,A4),D2
02:000495FC 7600            	  7285:     moveq   #0,D3
02:000495FE 41EC034F        	  7286:     lea     ($034F,A4),A0
