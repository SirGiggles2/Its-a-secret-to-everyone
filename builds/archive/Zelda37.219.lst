                            	  2379:     ;
02:0004B1BA 102C0005        	  2380:     move.b  ($0005,A4),D0
02:0004B1BE 41EC0305        	  2381:     lea     ($0305,A4),A0
02:0004B1C2 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B1C6 41EC0306        	  2383:     lea     ($0306,A4),A0
02:0004B1CA 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B1CE 41EC030A        	  2385:     lea     ($030A,A4),A0
02:0004B1D2 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004B1D6 41EC030B        	  2387:     lea     ($030B,A4),A0
