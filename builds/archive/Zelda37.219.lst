                            	  3742: DrawGhiniAndCheckCollisions:
02:0003B092 4EB90004D304    	  3743:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B098 1940000D        	  3744:     move.b  D0,($000D,A4)
                            	  3745:     ; If the direction has an "up" component, then keep the
                            	  3746:     ; frame image 0, and go figure out horizontal flipping.
                            	  3747:     ;
02:0003B09C 41EC0098        	  3748:     lea     ($0098,A4),A0
02:0003B0A0 10302000        	  3749:     move.b  (A0,D2.W),D0
02:0003B0A4 02000008        	  3750:     andi.b #$08,D0
02:0003B0A8 6614            	  3751:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3752:     ; Else make the frame image 1 for the "down" frame.
                            	  3753:     ; Note that this is the frame image to use, even if there's no
                            	  3754:     ; down component in the direction.
                            	  3755:     ;
02:0003B0AA 522C000D        	  3756:     addq.b  #1,($000D,A4)
                            	  3757:     ; If right is a component of the direction, then go set horizontal
                            	  3758:     ; flipping. Else leave horizontal flipping = 0.
                            	  3759:     ;
02:0003B0AE 41EC0098        	  3760:     lea     ($0098,A4),A0
02:0003B0B2 10302000        	  3761:     move.b  (A0,D2.W),D0
02:0003B0B6 02000001        	  3762:     andi.b #$01,D0
02:0003B0BA 6714            	  3763:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B0BC 660E            	  3764:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3765:     even
                            	  3766: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3767:     ; Set horizontal flipping if right is a direction component.
                            	  3768:     ; This essentially the same test as above, but for when we jump
                            	  3769:     ; from the "up" test.
                            	  3770:     ;
02:0003B0BE 41EC0098        	  3771:     lea     ($0098,A4),A0
02:0003B0C2 10302000        	  3772:     move.b  (A0,D2.W),D0
02:0003B0C6 02000002        	  3773:     andi.b #$02,D0
02:0003B0CA 6704            	  3774:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3775:     even
                            	  3776: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B0CC 522C000F        	  3777:     addq.b  #1,($000F,A4)
                            	  3778:     even
                            	  3779: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B0D0 102C000D        	  3780:     move.b  ($000D,A4),D0
                            	  3781: ; Params:
                            	  3782: ; A: frame image
                            	  3783: ; X: object index
                            	  3784: ; [00]: object X
                            	  3785: ; [01]: object Y
                            	  3786: ; [0F]: flip horizontally
                            	  3787: ;
                            	  3788: ; Returns:
                            	  3789: ; [00]: 0 for Link slot
                            	  3790: ; [06]: 1 if objects collide
                            	  3791: ; [09]: 0 for Link damage type (none)
                            	  3792: ; [0C]: 1 if objects collide
