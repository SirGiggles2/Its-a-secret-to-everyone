02:0003DCA8 0C00003C        	  9813:     cmpi.b  #$3C,D0
02:0003DCAC 6602            	  9814:     bne  _anon_z04_113
02:0003DCAE 5214            	  9815:     addq.b  #1,($0000,A4)
                            	  9816: _anon_z04_113:
02:0003DCB0 5303            	  9817:     subq.b  #1,D3
