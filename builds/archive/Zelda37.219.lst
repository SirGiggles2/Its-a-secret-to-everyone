                            	  7104: UpdateDodongoState0_Move:
                            	  7105:     ; If facing left, then push X offset 0 on the stack.
                            	  7106:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7107:     ;
                            	  7108:     ; We would like to use one set of coordinates only.
                            	  7109:     ; But movement would break down, if we did; because
                            	  7110:     ; Dodongo is so long.
                            	  7111:     ;
                            	  7112:     ; So, when not facing left, we temporarily shift the
                            	  7113:     ; X coordinate to be closer to the other side of the monster.
                            	  7114:     ;
02:0003C8D0 7600            	  7115:     moveq   #0,D3
02:0003C8D2 41EC0098        	  7116:     lea     ($0098,A4),A0
02:0003C8D6 10302000        	  7117:     move.b  (A0,D2.W),D0
02:0003C8DA 0200000D        	  7118:     andi.b #$0D,D0
02:0003C8DE 6716            	  7119:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C8E0 10342070        	  7120:     move.b  ($70,A4,D2.W),D0
02:0003C8E4 023C00EE        	  7121:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8E8 123C0010        	  7122:     move.b  #$10,D1
02:0003C8EC D101            	  7123:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C8EE 19802070        	  7124:     move.b  D0,($70,A4,D2.W)
02:0003C8F2 163C00F0        	  7125:     move.b  #$F0,D3
                            	  7126:     even
                            	  7127: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C8F6 1003            	  7128:     move.b  D3,D0
02:0003C8F8 1B00            	  7129:     move.b  D0,-(A5)  ; PHA
02:0003C8FA 7020            	  7130:     moveq   #32,D0
02:0003C8FC 41EC041F        	  7131:     lea     ($041F,A4),A0
02:0003C900 11802000        	  7132:     move.b  D0,(A0,D2.W)
02:0003C904 6100CF40        	  7133:     jsr     Wanderer_TargetPlayer
                            	  7134:     ; Pop the offset and add it to the X coordinate.
                            	  7135:     ;
                            	  7136:     ; This brings the X coordinate back to the unique value
                            	  7137:     ; that represents the position.
