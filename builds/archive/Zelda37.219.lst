                            	  2377: 
                            	  2378: ; Params:
                            	  2379: ; A: Y coordinate
                            	  2380: ; X: object index
                            	  2381: ;
                            	  2382:     even
                            	  2383: InitWhirlwind:
02:0002FC9E 6000BFAA        	  2384:     jmp     c_init_whirlwind
                            	  2385: 
                            	  2386: SetUpWhirlwind:
02:0002FCA2 6000BD56        	  2387:     jmp     c_set_up_whirlwind
                            	  2388: 
                            	  2389: WhirlwindPrevRoomIdList:
02:0002FCA6 36              	  2390:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FCA7 3B
02:0002FCA8 73
02:0002FCA9 44
02:0002FCAA 0A
02:0002FCAB 21
02:0002FCAC 41
02:0002FCAD 6C
                            	  2391: 
                            	  2392:     even
                            	  2393: UpdateWhirlwind_Full:
                            	  2394:     ; Get Link's halted state.
                            	  2395:     ;
02:0002FCAE 102C00AC        	  2396:     move.b  ($00AC,A4),D0
02:0002FCB2 02000040        	  2397:     andi.b #$40,D0
02:0002FCB6 7600            	  2398:     moveq   #0,D3
02:0002FCB8 1600            	  2399:     move.b  D0,D3
                            	  2400:     ; Add 2 to whirlwind X.
                            	  2401:     ;
02:0002FCBA 7002            	  2402:     moveq   #2,D0
02:0002FCBC 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FCC0 12342070        	  2404:     move.b  ($70,A4,D2.W),D1
02:0002FCC4 D101            	  2405:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FCC6 19802070        	  2406:     move.b  D0,($70,A4,D2.W)
                            	  2407:     ; If Link is not halted or teleporting state = 0, then
                            	  2408:     ; go check for collision with Link.
                            	  2409:     ;
02:0002FCCA 0C030040        	  2410:     cmpi.b  #$40,D3
02:0002FCCE 6638            	  2411:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FCD0 7600            	  2412:     moveq   #0,D3
02:0002FCD2 162C0522        	  2413:     move.b  ($0522,A4),D3
02:0002FCD6 6730            	  2414:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2415:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2416:     ;
                            	  2417:     ; Set Link's X to whirlwind's.
                            	  2418:     ;
02:0002FCD8 19400070        	  2419:     move.b  D0,($0070,A4)
                            	  2420:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2421:     ; the right screen edge and draw.
                            	  2422:     ;
02:0002FCDC 5303            	  2423:     subq.b  #1,D3
02:0002FCDE 6776            	  2424:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FCE0 0C000080        	  2425:     cmpi.b  #$80,D0
02:0002FCE4 6670            	  2426:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2427:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2428:     ;
                            	  2429:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2430:     ;
02:0002FCE6 E308            	  2431:     lsl.b  #1,D0   ; ASL A
02:0002FCE8 194000AC        	  2432:     move.b  D0,($00AC,A4)
02:0002FCEC 19400522        	  2433:     move.b  D0,($0522,A4)
02:0002FCF0 41EC034F        	  2434:     lea     ($034F,A4),A0
02:0002FCF4 11802000        	  2435:     move.b  D0,(A0,D2.W)
                            	  2436:     ; Update the player position marker, and draw one last time.
                            	  2437:     ;
02:0002FCF8 1002            	  2438:     move.b  D2,D0
02:0002FCFA 1B00            	  2439:     move.b  D0,-(A5)  ; PHA
02:0002FCFC 610010F6        	  2440:     jsr     UpdatePlayerPositionMarker
02:0002FD00 101D            	  2441:     move.b  (A5)+,D0  ; PLA
02:0002FD02 7400            	  2442:     moveq   #0,D2
02:0002FD04 1400            	  2443:     move.b  D0,D2
02:0002FD06 6070            	  2444:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445: 
                            	  2446:     even
                            	  2447: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2448:     ; Link is not halted or teleporting state = 0.
                            	  2449:     ; Try to pick up Link.
                            	  2450:     ;
                            	  2451:     ; If the whirlwind does not collide with Link, then go check
                            	  2452:     ; for the screen's right edge.
                            	  2453:     ;
02:0002FD08 61001E38        	  2454:     jsr     CheckLinkCollision
02:0002FD0C 102C0006        	  2455:     move.b  ($0006,A4),D0
02:0002FD10 6744            	  2456:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2457:     ; Collided with Link.
                            	  2458:     ;
                            	  2459:     ; Make Link face right. Reset shove info and subroom type.
                            	  2460:     ;
02:0002FD12 7001            	  2461:     moveq   #1,D0
02:0002FD14 19400098        	  2462:     move.b  D0,($0098,A4)
02:0002FD18 E208            	  2463:     lsr.b  #1,D0   ; LSR A
02:0002FD1A 194000C0        	  2464:     move.b  D0,($00C0,A4)
02:0002FD1E 194000D3        	  2465:     move.b  D0,($00D3,A4)
02:0002FD22 1940005A        	  2466:     move.b  D0,($005A,A4)
                            	  2467:     ; Halt Link (state $40), and hide him.
                            	  2468:     ;
02:0002FD26 7040            	  2469:     moveq   #64,D0
02:0002FD28 194000AC        	  2470:     move.b  D0,($00AC,A4)
02:0002FD2C 103C00F8        	  2471:     move.b  #$F8,D0
02:0002FD30 19400248        	  2472:     move.b  D0,($0248,A4)
02:0002FD34 1940024C        	  2473:     move.b  D0,($024C,A4)
                            	  2474:     ; Find and set the room that will behave as the previous room
                            	  2475:     ; when scrolling right to the room with the level's entrance.
                            	  2476:     ;
02:0002FD38 102C0523        	  2477:     move.b  ($0523,A4),D0
02:0002FD3C 02000007        	  2478:     andi.b #$07,D0
02:0002FD40 7600            	  2479:     moveq   #0,D3
02:0002FD42 1600            	  2480:     move.b  D0,D3
02:0002FD44 41F90002FCA6    	  2481:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FD4A 10303000        	  2482:     move.b  (A0,D3.W),D0
02:0002FD4E 194000EA        	  2483:     move.b  D0,($00EA,A4)
                            	  2484:     ; Set teleporting state 1.
                            	  2485:     ;
02:0002FD52 522C0522        	  2486:     addq.b  #1,($0522,A4)
                            	  2487:     even
                            	  2488: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2489:     ; If whirlwind's X < $F0, go draw.
                            	  2490:     ;
02:0002FD56 10342070        	  2491:     move.b  ($70,A4,D2.W),D0
02:0002FD5A 0C0000F0        	  2492:     cmpi.b  #$F0,D0
02:0002FD5E 6518            	  2493:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2494:     ; The whirlwind has reached the right edge of the screen.
                            	  2495:     ;
                            	  2496:     ; Destroy the object.
                            	  2497:     ;
02:0002FD60 611A            	  2498:     jsr     DestroyWhirlwind
                            	  2499:     ; If teleporting state <> 0, we picked up Link.
                            	  2500:     ; So, go to the next mode.
                            	  2501:     ;
                            	  2502:     ; Either way, draw one last time.
                            	  2503:     ;
02:0002FD62 102C0522        	  2504:     move.b  ($0522,A4),D0
02:0002FD66 6710            	  2505:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0002FD68 1002            	  2506:     move.b  D2,D0
02:0002FD6A 1B00            	  2507:     move.b  D0,-(A5)  ; PHA
02:0002FD6C 4EB90004C15A    	  2508:     jsr     GoToNextModeFromPlay
02:0002FD72 101D            	  2509:     move.b  (A5)+,D0  ; PLA
02:0002FD74 7400            	  2510:     moveq   #0,D2
02:0002FD76 1400            	  2511:     move.b  D0,D2
                            	  2512:     even
                            	  2513: _L_z01_UpdateWhirlwind_Full_Draw:
02:0002FD78 600000A8        	  2514:     jmp     DrawWhirlwind
                            	  2515: 
                            	  2516:     even
                            	  2517: DestroyWhirlwind:
02:0002FD7C 6000BA96        	  2518:     jmp     c_destroy_whirlwind
                            	  2519: 
                            	  2520: SummonWhirlwind:
                            	  2521:     ; If not in mode 5, return.
                            	  2522:     ;
02:0002FD80 102C0012        	  2523:     move.b  ($0012,A4),D0
02:0002FD84 0C000005        	  2524:     cmpi.b  #$05,D0
02:0002FD88 6704            	  2525:     beq.s  __far_z_01_0016
02:0002FD8A 60000094        	  2526:     jmp  L6104_Exit
                            	  2527: __far_z_01_0016:
                            	  2528:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2529:     ;
02:0002FD8E 6178            	  2530:     jsr     AdvanceTeleportingLevelIndex
02:0002FD90 102C0523        	  2531:     move.b  ($0523,A4),D0
02:0002FD94 02000007        	  2532:     andi.b #$07,D0
02:0002FD98 7600            	  2533:     moveq   #0,D3
02:0002FD9A 1600            	  2534:     move.b  D0,D3
02:0002FD9C 41F90004AE94    	  2535:     lea     (LevelMasks).l,A0
02:0002FDA2 10303000        	  2536:     move.b  (A0,D3.W),D0
02:0002FDA6 1880            	  2537:     move.b  D0,($0000,A4)
                            	  2538:     even
                            	  2539: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2540:     ; If there are no triforce pieces, then return.
                            	  2541:     ;
02:0002FDA8 102C0671        	  2542:     move.b  ($0671,A4),D0
02:0002FDAC 6602            	  2543:     bne.s  __far_z_01_0017
02:0002FDAE 6070            	  2544:     jmp  L6104_Exit
                            	  2545: __far_z_01_0017:
                            	  2546:     ; If we have gotten this triforce piece, then go try to make a
                            	  2547:     ; whirlwind.
                            	  2548:     ;
02:0002FDB0 1214            	  2549:     move.b  ($0000,A4),D1
02:0002FDB2 C200            	  2550:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FDB4 662C            	  2551:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2552:     ; We have not gotten this piece.
                            	  2553:     ; First, advance the teleporting index again.
                            	  2554:     ;
02:0002FDB6 6150            	  2555:     jsr     AdvanceTeleportingLevelIndex
                            	  2556:     ; If the direction Link is facing is an increasing one, then
                            	  2557:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2558:     ; level number. Then go test this new mask.
                            	  2559:     ;
02:0002FDB8 102C0098        	  2560:     move.b  ($0098,A4),D0
02:0002FDBC 02000009        	  2561:     andi.b #$09,D0
02:0002FDC0 6710            	  2562:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FDC2 1214            	  2563:     move.b  ($0000,A4),D1
