02:00031CC4 1941000D        	  6899:     move.b  D1,($000D,A4)
02:00031CC8 122C000E        	  6900:     move.b  ($000E,A4),D1
02:00031CCC E211            	  6901:     roxr.b  #1,D1   ; ROR $0E
02:00031CCE 1941000E        	  6902:     move.b  D1,($000E,A4)
02:00031CD2 5303            	  6903:     subq.b  #1,D3
02:00031CD4 66E8            	  6904:     bne  _anon_z01_86
                            	  6905:     even
                            	  6906: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6907:     ; Reset values used in special item drops.
                            	  6908:     ;
02:00031CD6 7000            	  6909:     moveq   #0,D0
02:00031CD8 19400627        	  6910:     move.b  D0,($0627,A4)
02:00031CDC 19400050        	  6911:     move.b  D0,($0050,A4)
02:00031CE0 19400051        	  6912:     move.b  D0,($0051,A4)
                            	  6913:     ; If heart partial >= low damage points byte, then simply
                            	  6914:     ; subtract the damage byte from heart partial.
                            	  6915:     ; Else go borrow from full hearts.
                            	  6916:     ;
02:00031CE4 102C0670        	  6917:     move.b  ($0670,A4),D0
02:00031CE8 122C000E        	  6918:     move.b  ($000E,A4),D1
02:00031CEC B001            	  6919:     cmp.b   D1,D0
02:00031CEE 6546            	  6920:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031CF0 003C0011        	  6921:     ori     #$11,CCR  ; SEC: set C+X
02:00031CF4 122C000E        	  6922:     move.b  ($000E,A4),D1
02:00031CF8 0A3C0010        	  6923:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031CFC 9101            	  6924:     subx.b  D1,D0   ; SBC $0E
02:00031CFE 0A3C0010        	  6925:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D02 19400670        	  6926:     move.b  D0,($0670,A4)
                            	  6927:     ; If full hearts >= high damage points byte, then simply
                            	  6928:     ; subtract the damage byte from full hearts.
                            	  6929:     ; Else go handle Link dying.
                            	  6930:     ;
02:00031D06 102C066F        	  6931:     move.b  ($066F,A4),D0
02:00031D0A 0200000F        	  6932:     andi.b #$0F,D0
02:00031D0E 122C000D        	  6933:     move.b  ($000D,A4),D1
02:00031D12 B001            	  6934:     cmp.b   D1,D0
02:00031D14 6554            	  6935:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031D16 102C066F        	  6936:     move.b  ($066F,A4),D0
02:00031D1A 003C0011        	  6937:     ori     #$11,CCR  ; SEC: set C+X
02:00031D1E 122C000D        	  6938:     move.b  ($000D,A4),D1
02:00031D22 0A3C0010        	  6939:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D26 9101            	  6940:     subx.b  D1,D0   ; SBC $0D
02:00031D28 0A3C0010        	  6941:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D2C 1940066F        	  6942:     move.b  D0,($066F,A4)
02:00031D30 0A3C0001        	  6943:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031D34 4E75            	  6944:     rts
