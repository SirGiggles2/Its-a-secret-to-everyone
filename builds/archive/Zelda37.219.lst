                            	  2823: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2824:     ; State 1. Jumping.
                            	  2825:     ;
                            	  2826:     ; Keep the object inside the bounds of the room.
                            	  2827:     ;
02:0003A9AE 6100539A        	  2828:     jsr     BoundFlyer
                            	  2829:     ; If the object was blocked at the room boundary, then
                            	  2830:     ; increase boundary reversal count, and go set up another jump.
