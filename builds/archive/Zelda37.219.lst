                            	  6031: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  6032:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  6033:     ;
02:00043A28 101D            	  6034:     move.b  (A5)+,D0  ; PLA
02:00043A2A 1B00            	  6035:     move.b  D0,-(A5)  ; PHA
02:00043A2C 7400            	  6036:     moveq   #0,D2
02:00043A2E 1400            	  6037:     move.b  D0,D2
                            	  6038:     ; For each row (2 or 3) in the door, indexed by X,
                            	  6039:     ; starting from highest index down to 0:
                            	  6040:     ;
02:00043A30 41F90004391E    	  6041:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043A36 10302000        	  6042:     move.b  (A0,D2.W),D0
02:00043A3A 7400            	  6043:     moveq   #0,D2
02:00043A3C 1400            	  6044:     move.b  D0,D2
                            	  6045:     even
                            	  6046: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00043A3E 122C0002        	  6047:     move.b  ($02,A4),D1   ; ptr lo
02:00043A42 182C0003        	  6048:     move.b  ($03,A4),D4  ; ptr hi
02:00043A46 024100FF        	  6049:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A4A E14C            	  6050:     lsl.w   #8,D4
02:00043A4C 8841            	  6051:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043A4E 48C4            	  6052:     ext.l   D4
02:00043A50 D8BC00FF0000    	  6053:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043A56 2044            	  6054:     movea.l D4,A0
02:00043A58 10303000        	  6055:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043A5C 1214            	  6056:     move.b  ($00,A4),D1   ; ptr lo
02:00043A5E 182C0001        	  6057:     move.b  ($01,A4),D4  ; ptr hi
02:00043A62 024100FF        	  6058:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A66 E14C            	  6059:     lsl.w   #8,D4
02:00043A68 8841            	  6060:     or.w    D1,D4
02:00043A6A 48C4            	  6061:     ext.l   D4
02:00043A6C D8BC00FF0000    	  6062:     add.l   #NES_RAM,D4
02:00043A72 2044            	  6063:     movea.l D4,A0
02:00043A74 11803000        	  6064:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00043A78 4EB900030F0C    	  6065:     jsr     Add1ToInt16At2
02:00043A7E 41F900043912    	  6066:     lea     (NextDoorTileOffsets).l,A0
02:00043A84 10302000        	  6067:     move.b  (A0,D2.W),D0
02:00043A88 4EB900030F08    	  6068:     jsr     AddToInt16At0
                            	  6069:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  6070:     ; go 1 more tile down, to start the next column at the right place.
                            	  6071:     ; We have to compensate for the fact that E/W doors are 
                            	  6072:     ; shorter vertically than N/S doors.
02:00043A8E 4A02            	  6073:     cmpi.b  #$00,D2
02:00043A90 6610            	  6074:     bne  _anon_z05_115
02:00043A92 101D            	  6075:     move.b  (A5)+,D0  ; PLA
02:00043A94 1B00            	  6076:     move.b  D0,-(A5)  ; PHA
02:00043A96 0C000002        	  6077:     cmpi.b  #$02,D0
02:00043A9A 6406            	  6078:     bcc  _anon_z05_115
02:00043A9C 4EB900030F06    	  6079:     jsr     Add1ToInt16At0
