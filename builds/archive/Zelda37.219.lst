02:000365A4 123C0008        	  5017:     move.b  #$08,D1
02:000365A8 0A3C0010        	  5018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000365AC 9101            	  5019:     subx.b  D1,D0   ; SBC #$08
02:000365AE 0A3C0010        	  5020:     eori    #$10,CCR  ; restore X = 6502 C
