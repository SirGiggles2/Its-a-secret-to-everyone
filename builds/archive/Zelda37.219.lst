                            	  3809: InitArmosOrFlyingGhini:
                            	  3810:     ; In UpdateObject, this object was flagged "initialized".
                            	  3811:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3812:     ;
02:0003B0F0 10342028        	  3813:     move.b  ($28,A4,D2.W),D0
02:0003B0F4 41EC0492        	  3814:     lea     ($0492,A4),A0
02:0003B0F8 11802000        	  3815:     move.b  D0,(A0,D2.W)
                            	  3816:     ; If it's still fading in, then go finish some initialization needed
                            	  3817:     ; for fading in.
                            	  3818:     ;
02:0003B0FC 660000B6        	  3819:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3820:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3821:     ; go finish initializing it.
                            	  3822:     ;
02:0003B100 41EC034F        	  3823:     lea     ($034F,A4),A0
02:0003B104 10302000        	  3824:     move.b  (A0,D2.W),D0
02:0003B108 0C000022        	  3825:     cmpi.b  #$22,D0
02:0003B10C 670000A6        	  3826:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3827:     ; Else we have an armos.
                            	  3828:     ;
                            	  3829:     ; Store stairs tile $70 in [00] for use later.
                            	  3830:     ;
02:0003B110 7070            	  3831:     moveq   #112,D0
02:0003B112 1880            	  3832:     move.b  D0,($0000,A4)
                            	  3833:     ; Look for the current room ID in an array of room ID's that
                            	  3834:     ; have armos secrets.
                            	  3835:     ;
02:0003B114 7606            	  3836:     moveq   #6,D3
                            	  3837:     even
                            	  3838: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B116 102C00EB        	  3839:     move.b  ($00EB,A4),D0
