                            	  5337: _anon_z04_69:
02:0003BBB0 4E75            	  5338:     rts
                            	  5339: 
                            	  5340: ; Params:
                            	  5341: ; A: offset of first instruction for left wall (0)
                            	  5342: ;    or top wall ($20)
                            	  5343: ; Y: Link's minimum major coordinate
                            	  5344: ; [00]: Link's coordinate along minor axis
                            	  5345: ; [01]: Link's coordinate along major axis
                            	  5346: ; [02]: a decreasing direction along the wall (left or up)
                            	  5347: ;
                            	  5348: ; Returns:
                            	  5349: ; Y: index of initial major coordinate of Wallmaster
                            	  5350: ; [04]: initial minor coordinate of Wallmaster
                            	  5351: ;
                            	  5352: ; Store the initial offset for this axis.
                            	  5353: ;
                            	  5354:     even
                            	  5355: Wallmaster_CalcStartPosition:
02:0003BBB2 41EC0412        	  5356:     lea     ($0412,A4),A0
02:0003BBB6 11802000        	  5357:     move.b  D0,(A0,D2.W)
02:0003BBBA 19430003        	  5358:     move.b  D3,($0003,A4)
                            	  5359:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5360:     ;
02:0003BBBE 7024            	  5361:     moveq   #36,D0
02:0003BBC0 7600            	  5362:     moveq   #0,D3
02:0003BBC2 162C03F8        	  5363:     move.b  ($03F8,A4),D3
02:0003BBC6 6702            	  5364:     beq  _anon_z04_70
02:0003BBC8 7032            	  5365:     moveq   #50,D0
                            	  5366: _anon_z04_70:
                            	  5367:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5368:     ; 1. negate the distance
                            	  5369:     ; 2. add 8 to the instruction offset to access
                            	  5370:     ;    the opposite direction for the same wall
                            	  5371:     ;
02:0003BBCA 7600            	  5372:     moveq   #0,D3
02:0003BBCC 162C0098        	  5373:     move.b  ($0098,A4),D3
02:0003BBD0 122C0002        	  5374:     move.b  ($0002,A4),D1
02:0003BBD4 B601            	  5375:     cmp.b   D1,D3
02:0003BBD6 662A            	  5376:     bne  _anon_z04_71
02:0003BBD8 1B00            	  5377:     move.b  D0,-(A5)  ; PHA
02:0003BBDA 41EC0412        	  5378:     lea     ($0412,A4),A0
02:0003BBDE 10302000        	  5379:     move.b  (A0,D2.W),D0
02:0003BBE2 023C00EE        	  5380:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBE6 123C0008        	  5381:     move.b  #$08,D1
02:0003BBEA D101            	  5382:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBEC 41EC0412        	  5383:     lea     ($0412,A4),A0
02:0003BBF0 11802000        	  5384:     move.b  D0,(A0,D2.W)
02:0003BBF4 101D            	  5385:     move.b  (A5)+,D0  ; PLA
02:0003BBF6 4600            	  5386:     eori.b #$FF,D0
02:0003BBF8 023C00EE        	  5387:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBFC 123C0001        	  5388:     move.b  #$01,D1
02:0003BC00 D101            	  5389:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5390: _anon_z04_71:
                            	  5391:     ; Add the distance and Link's minor coordinate to calculate
                            	  5392:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5393:     ; In general, the monster will be put in front of Link.
                            	  5394:     ;
02:0003BC02 023C00EE        	  5395:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC06 1214            	  5396:     move.b  ($0000,A4),D1
02:0003BC08 D101            	  5397:     addx.b  D1,D0   ; ADC $00
02:0003BC0A 19400004        	  5398:     move.b  D0,($0004,A4)
                            	  5399:     ; By default, will return index 0 to choose the minimum value
                            	  5400:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5401:     ; if Link is at the wall with a smaller major coordinate.
                            	  5402:     ;
02:0003BC0E 7600            	  5403:     moveq   #0,D3
                            	  5404:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5405:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5406:     ; to access the block for the other direction along the same axis,
                            	  5407:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5408:     ;
02:0003BC10 102C0001        	  5409:     move.b  ($0001,A4),D0
02:0003BC14 122C0003        	  5410:     move.b  ($0003,A4),D1
02:0003BC18 B001            	  5411:     cmp.b   D1,D0
02:0003BC1A 671C            	  5412:     beq  _anon_z04_72
02:0003BC1C 41EC0412        	  5413:     lea     ($0412,A4),A0
02:0003BC20 10302000        	  5414:     move.b  (A0,D2.W),D0
02:0003BC24 023C00EE        	  5415:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC28 123C0010        	  5416:     move.b  #$10,D1
02:0003BC2C D101            	  5417:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BC2E 41EC0412        	  5418:     lea     ($0412,A4),A0
02:0003BC32 11802000        	  5419:     move.b  D0,(A0,D2.W)
02:0003BC36 5203            	  5420:     addq.b  #1,D3
