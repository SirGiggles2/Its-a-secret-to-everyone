                            	  3232: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3233:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3234:     ; then this trap definitely wasn't triggered.
                            	  3235:     ; Go draw and check collisions.
                            	  3236:     ;
02:00030272 102C0070        	  3237:     move.b  ($0070,A4),D0
02:00030276 003C0011        	  3238:     ori     #$11,CCR  ; SEC: set C+X
02:0003027A 12342070        	  3239:     move.b  ($70,A4,D2.W),D1
02:0003027E 0A3C0010        	  3240:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030282 9101            	  3241:     subx.b  D1,D0   ; SBC ObjX,X
02:00030284 0A3C0010        	  3242:     eori    #$10,CCR  ; restore X = 6502 C
02:00030288 6100082C        	  3243:     jsr     Abs
02:0003028C 0C00000E        	  3244:     cmpi.b  #$0E,D0
02:00030290 64DC            	  3245:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3246:     ; Determine the vertical direction toward Link;
                            	  3247:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3248:     ; along this axis. Go draw and check object collisions.
                            	  3249:     ;
02:00030292 7604            	  3250:     moveq   #4,D3
02:00030294 102C0084        	  3251:     move.b  ($0084,A4),D0
02:00030298 41EC0084        	  3252:     lea     ($0084,A4),A0
02:0003029C 12302000        	  3253:     move.b  (A0,D2.W),D1
02:000302A0 B001            	  3254:     cmp.b   D1,D0
02:000302A2 67CA            	  3255:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000302A4 6402            	  3256:     bcc  _anon_z01_27
02:000302A6 7608            	  3257:     moveq   #8,D3
                            	  3258: _anon_z01_27:
                            	  3259:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3260:     ; set the vertical direction we determined, and other preparations.
                            	  3261:     ;
02:000302A8 41EC0084        	  3262:     lea     ($0084,A4),A0
02:000302AC 10302000        	  3263:     move.b  (A0,D2.W),D0
02:000302B0 668A            	  3264:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3265:     even
                            	  3266: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3267:     ; State 1 and 2.
                            	  3268:     ;
                            	  3269:     ; Move in the direction it's facing.
                            	  3270:     ;
02:000302B2 41EC0098        	  3271:     lea     ($0098,A4),A0
02:000302B6 10302000        	  3272:     move.b  (A0,D2.W),D0
02:000302BA 1940000F        	  3273:     move.b  D0,($000F,A4)
02:000302BE 4EB90004BF68    	  3274:     jsr     MoveObject
                            	  3275:     ; Truncate the grid offset to square length ($10).
                            	  3276:     ;
02:000302C4 41EC0394        	  3277:     lea     ($0394,A4),A0
02:000302C8 10302000        	  3278:     move.b  (A0,D2.W),D0
02:000302CC 0200000F        	  3279:     andi.b #$0F,D0
02:000302D0 6608            	  3280:     bne  _anon_z01_28
02:000302D2 41EC0394        	  3281:     lea     ($0394,A4),A0
02:000302D6 11802000        	  3282:     move.b  D0,(A0,D2.W)
                            	  3283: _anon_z01_28:
                            	  3284:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3285:     ;
02:000302DA 61001866        	  3286:     jsr     CheckLinkCollision
                            	  3287:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3288:     ; and current coordinate to the trap's X.
                            	  3289:     ;
02:000302DE 7600            	  3290:     moveq   #0,D3
02:000302E0 16342070        	  3291:     move.b  ($70,A4,D2.W),D3
02:000302E4 7078            	  3292:     moveq   #120,D0
02:000302E6 1880            	  3293:     move.b  D0,($0000,A4)
02:000302E8 41EC0098        	  3294:     lea     ($0098,A4),A0
02:000302EC 10302000        	  3295:     move.b  (A0,D2.W),D0
02:000302F0 0200000C        	  3296:     andi.b #$0C,D0
02:000302F4 6710            	  3297:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3298:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3299:     ; and current coordinate to the trap's Y.
                            	  3300:     ;
02:000302F6 7600            	  3301:     moveq   #0,D3
02:000302F8 41EC0084        	  3302:     lea     ($0084,A4),A0
02:000302FC 16302000        	  3303:     move.b  (A0,D2.W),D3
02:00030300 103C0090        	  3304:     move.b  #$90,D0
02:00030304 1880            	  3305:     move.b  D0,($0000,A4)
                            	  3306:     even
                            	  3307: _L_z01_UpdateTrap_Full_Finish:
                            	  3308:     ; If in state 2, then go finish handling it.
                            	  3309:     ;
02:00030306 41EC00AC        	  3310:     lea     ($00AC,A4),A0
02:0003030A 10302000        	  3311:     move.b  (A0,D2.W),D0
02:0003030E 02000001        	  3312:     andi.b #$01,D0
02:00030312 6744            	  3313:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3314:     ; Finish handling state 1.
                            	  3315:     ;
                            	  3316:     ; Get the distance between the current coordinate and the target.
                            	  3317:     ;
02:00030314 1003            	  3318:     move.b  D3,D0
02:00030316 003C0011        	  3319:     ori     #$11,CCR  ; SEC: set C+X
02:0003031A 1214            	  3320:     move.b  ($0000,A4),D1
02:0003031C 0A3C0010        	  3321:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030320 9101            	  3322:     subx.b  D1,D0   ; SBC $00
02:00030322 0A3C0010        	  3323:     eori    #$10,CCR  ; restore X = 6502 C
02:00030326 6100078E        	  3324:     jsr     Abs
                            	  3325:     ; If distance >= 5, go draw.
                            	  3326:     ;
02:0003032A 0C000005        	  3327:     cmpi.b  #$05,D0
02:0003032E 6426            	  3328:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  3329:     ; Else reverse direction, and advace to state 2
