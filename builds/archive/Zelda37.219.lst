02:00041C5A 760C            	  3250:     moveq   #12,D3
02:00041C5C 102C0098        	  3251:     move.b  ($0098,A4),D0
02:00041C60 0200000C        	  3252:     andi.b #$0C,D0
02:00041C64 6602            	  3253:     bne  _anon_z05_77
02:00041C66 7603            	  3254:     moveq   #3,D3
                            	  3255: _anon_z05_77:
02:00041C68 1003            	  3256:     move.b  D3,D0
02:00041C6A 122C03F8        	  3257:     move.b  ($03F8,A4),D1
02:00041C6E C001            	  3258:     and.b  D1,D0
02:00041C70 194003F8        	  3259:     move.b  D0,($03F8,A4)
