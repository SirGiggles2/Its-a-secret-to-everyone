02:0004C998 123C0010        	  5793:     move.b  #$10,D1
02:0004C99C D101            	  5794:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C99E 41EC00AC        	  5795:     lea     ($00AC,A4),A0
02:0004C9A2 11802000        	  5796:     move.b  D0,(A0,D2.W)
                            	  5797:     even
