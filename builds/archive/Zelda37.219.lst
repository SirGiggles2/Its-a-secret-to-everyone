                            	  2756: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2757:     ; If reversal count >= 2, then
                            	  2758:     ; 1. invert the horizontal component of facing direction,
                            	  2759:     ;    to face away from the chase target
                            	  2760:     ; 2. reset the reversal count to 0.
                            	  2761:     ;
                            	  2762:     ; This prevents a jumper from getting stuck in a corner.
                            	  2763:     ;
                            	  2764:     ; For example, if a tektite's direction is down and right,
                            	  2765:     ; and jumps into the top right corner of the room:
                            	  2766:     ; 1. The right room boundary is hit. So the direction is
                            	  2767:     ;    automatically reversed to up and left.
                            	  2768:     ; 2. The next frame, the top room boundary is hit.
                            	  2769:     ;    The direction is reversed to down and right.
                            	  2770:     ;
                            	  2771:     ; As you can see, an endless loop has been made.
                            	  2772:     ;
02:0003A936 41EC0451        	  2773:     lea     ($0451,A4),A0
02:0003A93A 10302000        	  2774:     move.b  (A0,D2.W),D0
02:0003A93E 0C000002        	  2775:     cmpi.b  #$02,D0
02:0003A942 651E            	  2776:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A944 41EC0098        	  2777:     lea     ($0098,A4),A0
02:0003A948 10302000        	  2778:     move.b  (A0,D2.W),D0
02:0003A94C 0A000003        	  2779:     eori.b #$03,D0
02:0003A950 41EC0098        	  2780:     lea     ($0098,A4),A0
02:0003A954 11802000        	  2781:     move.b  D0,(A0,D2.W)
02:0003A958 7000            	  2782:     moveq   #0,D0
02:0003A95A 41EC0451        	  2783:     lea     ($0451,A4),A0
02:0003A95E 11802000        	  2784:     move.b  D0,(A0,D2.W)
                            	  2785:     even
                            	  2786: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2787:     ; If the object is a boulder, then make sure its facing direction
                            	  2788:     ; has a down vertical component.
                            	  2789:     ;
02:0003A962 610001F8        	  2790:     jsr     Jumper_PointBoulderDownward
                            	  2791:     ; For the given direction, get the Y offset of the destination
                            	  2792:     ; of the jump.
                            	  2793:     ;
                            	  2794:     ; Add it to the object's Y, and store this destination Y.
                            	  2795:     ;
02:0003A966 7600            	  2796:     moveq   #0,D3
02:0003A968 41EC0098        	  2797:     lea     ($0098,A4),A0
02:0003A96C 16302000        	  2798:     move.b  (A0,D2.W),D3
02:0003A970 41EC0084        	  2799:     lea     ($0084,A4),A0
02:0003A974 10302000        	  2800:     move.b  (A0,D2.W),D0
02:0003A978 023C00EE        	  2801:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A97C 41F90003A894    	  2802:     lea     (JumperYOffsets).l,A0
02:0003A982 12303000        	  2803:     move.b  (A0,D3.W),D1
02:0003A986 D101            	  2804:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A988 41EC0444        	  2805:     lea     ($0444,A4),A0
02:0003A98C 11802000        	  2806:     move.b  D0,(A0,D2.W)
                            	  2807:     ; Set the starting speed, depending on the object type.
                            	  2808:     ;
02:0003A990 610001A0        	  2809:     jsr     Jumper_GetKind
02:0003A994 41F90003A8BE    	  2810:     lea     (JumperStartSpeedsHi).l,A0
02:0003A99A 10303000        	  2811:     move.b  (A0,D3.W),D0
02:0003A99E 41EC0412        	  2812:     lea     ($0412,A4),A0
02:0003A9A2 11802000        	  2813:     move.b  D0,(A0,D2.W)
                            	  2814:     ; Reset the vertical speed low byte.
                            	  2815:     ; Then go animate, draw, and check collisions.
