02:0003A322 12342028        	  1804:     move.b  ($28,A4,D2.W),D1
02:0003A326 8001            	  1805:     or.b  D1,D0
02:0003A328 6630            	  1806:     bne  _L_z04_UpdateNormalZolOrGel_Exit
                            	  1807:     ; Choose a random index (0 to 3) to look up an amount of time.
