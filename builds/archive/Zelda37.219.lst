                            	  7525: DodongoBombPositiveLimits:
02:0003CBB6 0C              	  7526:     dc.b    $0C, $11
02:0003CBB7 11
                            	  7527: 
                            	  7528:     even
                            	  7529: DodongoBombNegativeLimits:
02:0003CBB8 F4              	  7530:     dc.b    $F4, $F0
02:0003CBB9 F0
                            	  7531: 
                            	  7532: ; Params:
                            	  7533: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7534: ; [00]: monster hotspot X
                            	  7535: ; [01]: monster hotspot Y
                            	  7536: ; [02]: bomb hotspot X
                            	  7537: ; [03]: bomb hotspot Y
                            	  7538: ;
                            	  7539: ; Returns:
                            	  7540: ; A: 0 if the bomb is in range of the monster
                            	  7541: ; Z: 1 if the bomb is in range of the monster
                            	  7542: ; [04]: horizontal distance
                            	  7543: ; [05]: vertical distance
                            	  7544: ;
                            	  7545: ; Store the positive limit in [06], and the negative one in [07].
                            	  7546: ;
                            	  7547:     even
                            	  7548: Dodongo_IsBombInRange:
02:0003CBBA 41F90003CBB6    	  7549:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBC0 10303000        	  7550:     move.b  (A0,D3.W),D0
02:0003CBC4 19400006        	  7551:     move.b  D0,($0006,A4)
02:0003CBC8 41F90003CBB8    	  7552:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CBCE 10303000        	  7553:     move.b  (A0,D3.W),D0
02:0003CBD2 19400007        	  7554:     move.b  D0,($0007,A4)
                            	  7555:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7556:     ; the bomb is near enough the monster.
                            	  7557:     ;
02:0003CBD6 7003            	  7558:     moveq   #3,D0
02:0003CBD8 19400008        	  7559:     move.b  D0,($0008,A4)
                            	  7560:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7561:     ;
02:0003CBDC 7601            	  7562:     moveq   #1,D3
                            	  7563:     even
                            	  7564: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7565:     ; Subtract the bomb's coordinate from the boss's,
                            	  7566:     ; The loop index determines the coordinate.
                            	  7567:     ;
02:0003CBDE 10343000        	  7568:     move.b  ($00,A4,D3.W),D0
02:0003CBE2 003C0011        	  7569:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBE6 12343002        	  7570:     move.b  ($02,A4,D3.W),D1
02:0003CBEA 0A3C0010        	  7571:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBEE 9101            	  7572:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBF0 0A3C0010        	  7573:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7574:     ; If the distance >= positive offset, or < negative offset;
                            	  7575:     ; then loop again.
                            	  7576:     ;
02:0003CBF4 122C0006        	  7577:     move.b  ($0006,A4),D1
02:0003CBF8 B001            	  7578:     cmp.b   D1,D0
02:0003CBFA 6A16            	  7579:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBFC 122C0007        	  7580:     move.b  ($0007,A4),D1
02:0003CC00 B001            	  7581:     cmp.b   D1,D0
02:0003CC02 6B0E            	  7582:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7583:     ; The distance is close enough in this axis.
                            	  7584:     ;
                            	  7585:     ; Store the distance in this axis in [05] or [04],
                            	  7586:     ; depending on the loop index.
                            	  7587:     ;
02:0003CC04 19803004        	  7588:     move.b  D0,($04,A4,D3.W)
                            	  7589:     ; Shift [08] right, because we're in range in this axis.
                            	  7590:     ;
02:0003CC08 122C0008        	  7591:     move.b  ($0008,A4),D1
02:0003CC0C E209            	  7592:     lsr.b  #1,D1   ; LSR $08
02:0003CC0E 19410008        	  7593:     move.b  D1,($0008,A4)
                            	  7594:     even
                            	  7595: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC12 5303            	  7596:     subq.b  #1,D3
02:0003CC14 6AC8            	  7597:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7598:     ; If close enough in both axes, then [08] will be 0.
                            	  7599:     ;
02:0003CC16 102C0008        	  7600:     move.b  ($0008,A4),D0
02:0003CC1A 4E75            	  7601:     rts
                            	  7602: 
                            	  7603: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7604: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7605: ;
                            	  7606: ; But these are not typical direction indexes. Instead a
                            	  7607: ; 5-way index is used.
                            	  7608: ; A direction shifted right once becomes a 5-way index.
                            	  7609: ; The fourth element is unused.
                            	  7610: ;
                            	  7611:     even
                            	  7612: DodongoFrameImages:
02:0003CC1C 00              	  7613:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CC1D 01
02:0003CC1E 06
02:0003CC1F FF
02:0003CC20 08
02:0003CC21 02
02:0003CC22 03
02:0003CC23 06
02:0003CC24 FF              	  7614:     dc.b    $FF, $08
02:0003CC25 08
                            	  7615: 
                            	  7616:     even
                            	  7617: DodongoFrameHFlips:
02:0003CC26 00              	  7618:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CC27 40
02:0003CC28 00
02:0003CC29 FF
02:0003CC2A 00
02:0003CC2B 00
02:0003CC2C 40
02:0003CC2D 40
02:0003CC2E FF              	  7619:     dc.b    $FF, $40
02:0003CC2F 40
                            	  7620: 
                            	  7621:     even
                            	  7622: DodongoFrameImagesBloated:
02:0003CC30 04              	  7623:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CC31 05
02:0003CC32 07
02:0003CC33 FF
02:0003CC34 09
02:0003CC35 04
02:0003CC36 05
02:0003CC37 07
02:0003CC38 FF              	  7624:     dc.b    $FF, $09
02:0003CC39 09
                            	  7625: 
                            	  7626:     even
                            	  7627: DodongoFrameHFlipsBloated:
02:0003CC3A 00              	  7628:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC3B 40
02:0003CC3C 00
02:0003CC3D FF
02:0003CC3E 00
02:0003CC3F 00
02:0003CC40 40
02:0003CC41 00
02:0003CC42 FF              	  7629:     dc.b    $FF, $00
02:0003CC43 00
