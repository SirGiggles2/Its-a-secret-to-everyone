                            	  3841:     ;
02:0003B11A 41F90003B0E0    	  3842:     lea     (SecretArmosRoomIds).l,A0
02:0003B120 12303000        	  3843:     move.b  (A0,D3.W),D1
02:0003B124 B001            	  3844:     cmp.b   D1,D0
02:0003B126 6648            	  3845:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3846:     ; The secret (usually stairs) is under one of the armoses.
                            	  3847:     ;
                            	  3848:     ; If the armos's X coordinate does not match the one needed
                            	  3849:     ; for the current room in the list, then go loop again.
