02:0003F2A4 7002            	 12791:     moveq   #2,D0
02:0003F2A6 19400601        	 12792:     move.b  D0,($0601,A4)
                            	 12793: _anon_z04_160:
02:0003F2AA 0A3C0001        	 12794:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F2AE 4E75            	 12795:     rts
                            	 12796: 
                            	 12797: ; Description:
                            	 12798: ; Lift up the Triforce of Courage while the room is light.
                            	 12799: ;
                            	 12800: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12801: ;
                            	 12802:     even
                            	 12803: Ganon_ScenePhase1:
02:0003F2B0 701B            	 12804:     moveq   #27,D0
02:0003F2B2 19400505        	 12805:     move.b  D0,($0505,A4)
                            	 12806:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12807:     ;
02:0003F2B6 102C0028        	 12808:     move.b  ($0028,A4),D0
02:0003F2BA 6702            	 12809:     beq.s  __far_z_04_0128
02:0003F2BC 6012            	 12810:     jmp  Ganon_DrawBodyFrame0
                            	 12811: __far_z_04_0128:
                            	 12812:     ; Once the timer expires:
                            	 12813:     ; 1. unhalt Link
                            	 12814:     ; 2. clear the item to lift
                            	 12815:     ; 3. play level 9 song
                            	 12816:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12817:     ;
02:0003F2BE 194000AC        	 12818:     move.b  D0,($00AC,A4)
02:0003F2C2 19400505        	 12819:     move.b  D0,($0505,A4)
02:0003F2C6 7020            	 12820:     moveq   #32,D0
02:0003F2C8 19400600        	 12821:     move.b  D0,($0600,A4)
02:0003F2CC 522C0445        	 12822:     addq.b  #1,($0445,A4)
                            	 12823:     even
                            	 12824: Ganon_DrawBodyFrame0:
                            	 12825:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12826:     ; with animation frame 0.
                            	 12827:     ;
02:0003F2D0 7000            	 12828:     moveq   #0,D0
02:0003F2D2 41EC046B        	 12829:     lea     ($046B,A4),A0
02:0003F2D6 11802000        	 12830:     move.b  D0,(A0,D2.W)
02:0003F2DA 6000032C        	 12831:     jmp     Ganon_DrawBody
