02:0003ED94 41EC0350        	 12058:     lea     ($0350,A4),A0
02:0003ED98 11803000        	 12059:     move.b  D0,(A0,D3.W)
02:0003ED9C 4EF90004DB0C    	 12060:     jmp     ResetObjMetastate
                            	 12061: 
                            	 12062:     even
                            	 12063: L12A6F_Exit:
02:0003EDA2 4E75            	 12064:     rts
                            	 12065: 
                            	 12066:     even
                            	 12067: Lamnola_UpdateHead:
                            	 12068:     ; If X coordinate is not a multiple of 8, then return.
                            	 12069:     ;
02:0003EDA4 10342070        	 12070:     move.b  ($70,A4,D2.W),D0
02:0003EDA8 02000007        	 12071:     andi.b #$07,D0
02:0003EDAC 6702            	 12072:     beq.s  __far_z_04_0123
02:0003EDAE 60F2            	 12073:     jmp  L12A6F_Exit
                            	 12074: __far_z_04_0123:
                            	 12075:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12076:     ; We had to account for the usual offset of 3.
                            	 12077:     ;
02:0003EDB0 41EC0084        	 12078:     lea     ($0084,A4),A0
02:0003EDB4 10302000        	 12079:     move.b  (A0,D2.W),D0
02:0003EDB8 023C00EE        	 12080:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDBC 123C0003        	 12081:     move.b  #$03,D1
02:0003EDC0 D101            	 12082:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDC2 02000007        	 12083:     andi.b #$07,D0
02:0003EDC6 6702            	 12084:     beq.s  __far_z_04_0124
02:0003EDC8 60D8            	 12085:     jmp  L12A6F_Exit
                            	 12086: __far_z_04_0124:
                            	 12087:     ; Will loop 4 times, propagating directions down the chain,
                            	 12088:     ; by pulling from the bottom.
                            	 12089:     ;
02:0003EDCA 7004            	 12090:     moveq   #4,D0
02:0003EDCC 1880            	 12091:     move.b  D0,($0000,A4)
                            	 12092:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12093:     ;
02:0003EDCE 7600            	 12094:     moveq   #0,D3
02:0003EDD0 0C020005        	 12095:     cmpi.b  #$05,D2
02:0003EDD4 6702            	 12096:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EDD6 7605            	 12097:     moveq   #5,D3
                            	 12098:     even
                            	 12099: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12100:     ; Loop over every segment under the head, starting from the tail.
                            	 12101:     ; Copy the next segment's direction to the current one in this loop.
                            	 12102:     ;
02:0003EDD8 41EC009A        	 12103:     lea     ($009A,A4),A0
02:0003EDDC 10303000        	 12104:     move.b  (A0,D3.W),D0
02:0003EDE0 41EC0099        	 12105:     lea     ($0099,A4),A0
02:0003EDE4 11803000        	 12106:     move.b  D0,(A0,D3.W)
02:0003EDE8 5203            	 12107:     addq.b  #1,D3
02:0003EDEA 5314            	 12108:     subq.b  #1,($0000,A4)
02:0003EDEC 66EA            	 12109:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12110:     ; If this head segment is not aligned with a square, then return.
                            	 12111:     ;
02:0003EDEE 10342070        	 12112:     move.b  ($70,A4,D2.W),D0
02:0003EDF2 0200000F        	 12113:     andi.b #$0F,D0
02:0003EDF6 660000BA        	 12114:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12115:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12116:     ; We had to account for the usual offset of 3.
                            	 12117:     ;
02:0003EDFA 41EC0084        	 12118:     lea     ($0084,A4),A0
02:0003EDFE 10302000        	 12119:     move.b  (A0,D2.W),D0
02:0003EE02 023C00EE        	 12120:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EE06 123C0003        	 12121:     move.b  #$03,D1
02:0003EE0A D101            	 12122:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EE0C 0200000F        	 12123:     andi.b #$0F,D0
02:0003EE10 660000A0        	 12124:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12125:     ; Store the opposite of the facing direction in [00].
                            	 12126:     ;
02:0003EE14 41EC0098        	 12127:     lea     ($0098,A4),A0
02:0003EE18 10302000        	 12128:     move.b  (A0,D2.W),D0
02:0003EE1C E208            	 12129:     lsr.b  #1,D0   ; LSR A
02:0003EE1E 02000005        	 12130:     andi.b #$05,D0
02:0003EE22 1880            	 12131:     move.b  D0,($0000,A4)
02:0003EE24 41EC0098        	 12132:     lea     ($0098,A4),A0
02:0003EE28 10302000        	 12133:     move.b  (A0,D2.W),D0
02:0003EE2C E308            	 12134:     lsl.b  #1,D0   ; ASL A
02:0003EE2E 0200000A        	 12135:     andi.b #$0A,D0
02:0003EE32 1214            	 12136:     move.b  ($0000,A4),D1
02:0003EE34 8001            	 12137:     or.b  D1,D0
                            	 12138:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12139:     ;
02:0003EE36 0A00000F        	 12140:     eori.b #$0F,D0
02:0003EE3A 1940050F        	 12141:     move.b  D0,($050F,A4)
                            	 12142:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12143:     ;
02:0003EE3E 10342018        	 12144:     move.b  ($18,A4,D2.W),D0
02:0003EE42 0C000080        	 12145:     cmpi.b  #$80,D0
02:0003EE46 656C            	 12146:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12147:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12148:     ; Load the monster's facing direction.
                            	 12149:     ;
02:0003EE48 41EC0098        	 12150:     lea     ($0098,A4),A0
02:0003EE4C 10302000        	 12151:     move.b  (A0,D2.W),D0
                            	 12152:     ; Load the next random number into Y register.
                            	 12153:     ;
02:0003EE50 7600            	 12154:     moveq   #0,D3
02:0003EE52 16342019        	 12155:     move.b  ($19,A4,D2.W),D3
                            	 12156:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12157:     ; to keep moving straight.
                            	 12158:     ;
02:0003EE56 0C030080        	 12159:     cmpi.b  #$80,D3
02:0003EE5A 6418            	 12160:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12161:     even
                            	 12162: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12163:     ; Loop to rotate the direction bit over the mask.
                            	 12164:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12165:     ; facing direction.
                            	 12166:     ;
                            	 12167:     ; Shift right the copy of the direction.
                            	 12168:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12169:     ;
02:0003EE5C E208            	 12170:     lsr.b  #1,D0   ; LSR A
02:0003EE5E 6402            	 12171:     bcc  _anon_z04_151
02:0003EE60 7008            	 12172:     moveq   #8,D0
                            	 12173: _anon_z04_151:
                            	 12174:     ; If the current direction bit is masked off, then we've reached
                            	 12175:     ; the opposite direction. Loop again.
                            	 12176:     ;
02:0003EE62 122C050F        	 12177:     move.b  ($050F,A4),D1
02:0003EE66 C200            	 12178:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE68 67F2            	 12179:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12180:     ; If Y register >= $40, then break out of the loop.
                            	 12181:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12182:     ;
02:0003EE6A 0C030040        	 12183:     cmpi.b  #$40,D3
02:0003EE6E 6404            	 12184:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12185:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12186:     ; and loop again now.
                            	 12187:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12188:     ;
02:0003EE70 7640            	 12189:     moveq   #64,D3
02:0003EE72 65E8            	 12190:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12191:     even
                            	 12192: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12193:     ; Change the facing direction to the direction found.
                            	 12194:     ;
02:0003EE74 41EC0098        	 12195:     lea     ($0098,A4),A0
02:0003EE78 11802000        	 12196:     move.b  D0,(A0,D2.W)
                            	 12197:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12198:     ;
02:0003EE7C 1940000F        	 12199:     move.b  D0,($000F,A4)
02:0003EE80 4EB9000309B8    	 12200:     jsr     BoundByRoom
                            	 12201:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12202:     ;
02:0003EE86 102C000F        	 12203:     move.b  ($000F,A4),D0
02:0003EE8A 6618            	 12204:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12205:     even
                            	 12206: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12207:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12208:     ; for looking for any non-opposite direction that is not blocked.
                            	 12209:     ;
02:0003EE8C 41EC0098        	 12210:     lea     ($0098,A4),A0
02:0003EE90 10302000        	 12211:     move.b  (A0,D2.W),D0
                            	 12212:     even
                            	 12213: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12214:     ; Shift right the copy of the direction.
                            	 12215:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12216:     ;
02:0003EE94 E208            	 12217:     lsr.b  #1,D0   ; LSR A
02:0003EE96 6402            	 12218:     bcc  _anon_z04_152
02:0003EE98 7008            	 12219:     moveq   #8,D0
                            	 12220: _anon_z04_152:
                            	 12221:     ; If the current direction bit is not masked off, then go check the
                            	 12222:     ; room boundary in this direction.
                            	 12223:     ; Else we've reached the opposite direction. Loop again.
                            	 12224:     ;
02:0003EE9A 122C050F        	 12225:     move.b  ($050F,A4),D1
02:0003EE9E C200            	 12226:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEA0 66D2            	 12227:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EEA2 67F0            	 12228:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12229:     even
                            	 12230: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12231:     ; We found a direction that was not blocked by the room boundary.
                            	 12232:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12233:     ;
02:0003EEA4 4EB90004BA60    	 12234:     jsr     GetCollidingTileMoving
02:0003EEAA 122C034A        	 12235:     move.b  ($034A,A4),D1
02:0003EEAE B001            	 12236:     cmp.b   D1,D0
02:0003EEB0 64DA            	 12237:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12238:     even
                            	 12239: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12240:     ; TODO: confirm this
                            	 12241:     ;
                            	 12242:     ; If there were a room that had lamnolas, and they could get
                            	 12243:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12244:     ; an infinite loop.
                            	 12245:     ;
                            	 12246:     ; But, the only room with that configuration has those blocks
                            	 12247:     ; blocked off with a push block, which can only be pushed after
                            	 12248:     ; all monsters are killed.
                            	 12249:     ;
02:0003EEB2 4E75            	 12250:     rts
                            	 12251: 
                            	 12252:     even
                            	 12253: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12254:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12255:     ;
02:0003EEB4 7001            	 12256:     moveq   #1,D0
02:0003EEB6 19400002        	 12257:     move.b  D0,($0002,A4)
02:0003EEBA 102C0070        	 12258:     move.b  ($0070,A4),D0
02:0003EEBE 003C0011        	 12259:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEC2 12342070        	 12260:     move.b  ($70,A4,D2.W),D1
02:0003EEC6 0A3C0010        	 12261:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EECA 9101            	 12262:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EECC 0A3C0010        	 12263:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EED0 640A            	 12264:     bcc  _anon_z04_153
02:0003EED2 122C0002        	 12265:     move.b  ($0002,A4),D1
02:0003EED6 E309            	 12266:     lsl.b  #1,D1   ; ASL $02
02:0003EED8 19410002        	 12267:     move.b  D1,($0002,A4)
                            	 12268: _anon_z04_153:
                            	 12269:     ; Find the vertical direction toward Link and store it in [03].
                            	 12270:     ;
02:0003EEDC 7004            	 12271:     moveq   #4,D0
02:0003EEDE 19400003        	 12272:     move.b  D0,($0003,A4)
02:0003EEE2 102C0084        	 12273:     move.b  ($0084,A4),D0
02:0003EEE6 003C0011        	 12274:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEEA 41EC0084        	 12275:     lea     ($0084,A4),A0
02:0003EEEE 12302000        	 12276:     move.b  (A0,D2.W),D1
02:0003EEF2 0A3C0010        	 12277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEF6 9101            	 12278:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EEF8 0A3C0010        	 12279:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEFC 640A            	 12280:     bcc  _anon_z04_154
02:0003EEFE 122C0003        	 12281:     move.b  ($0003,A4),D1
02:0003EF02 E309            	 12282:     lsl.b  #1,D1   ; ASL $03
02:0003EF04 19410003        	 12283:     move.b  D1,($0003,A4)
                            	 12284: _anon_z04_154:
                            	 12285:     ; If the horizontal direction toward Link is not allowed, then
                            	 12286:     ; go check the vertical direction.
                            	 12287:     ;
02:0003EF08 102C0002        	 12288:     move.b  ($0002,A4),D0
02:0003EF0C 122C050F        	 12289:     move.b  ($050F,A4),D1
02:0003EF10 C200            	 12290:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF12 6708            	 12291:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12292:     ; If the horizontal direction toward Link is the same direction
                            	 12293:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12294:     ;
02:0003EF14 122C0098        	 12295:     move.b  ($0098,A4),D1
02:0003EF18 C200            	 12296:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF1A 6604            	 12297:     bne  _anon_z04_155
                            	 12298:     even
                            	 12299: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12300:     ; Load the vertical direction toward Link in order to test it for
                            	 12301:     ; room boundary and tile collision.
                            	 12302:     ;
02:0003EF1C 102C0003        	 12303:     move.b  ($0003,A4),D0
                            	 12304: _anon_z04_155:
                            	 12305:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12306:     ;
02:0003EF20 6000FF52        	 12307:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12308: 
                            	 12309:     even
                            	 12310: Lamnola_Move:
                            	 12311:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12312:     ;
                            	 12313:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12314:     ;
                            	 12315:     ; Start with a mask of $A1 in [02]:
                            	 12316:     ; - low nibble represents the right direction
                            	 12317:     ; - high nibble is used to set or clear carry as we go along
                            	 12318:     ;
02:0003EF24 103C00A1        	 12319:     move.b  #$A1,D0
02:0003EF28 19400002        	 12320:     move.b  D0,($0002,A4)
                            	 12321:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12322:     ;
02:0003EF2C 41EC0098        	 12323:     lea     ($0098,A4),A0
02:0003EF30 10302000        	 12324:     move.b  (A0,D2.W),D0
02:0003EF34 122C0002        	 12325:     move.b  ($0002,A4),D1
02:0003EF38 C200            	 12326:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF3A 6712            	 12327:     beq  _L_z04_Lamnola_Move_Left
02:0003EF3C 10342070        	 12328:     move.b  ($70,A4,D2.W),D0
02:0003EF40 023C00EE        	 12329:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF44 122C04E6        	 12330:     move.b  ($04E6,A4),D1
02:0003EF48 D101            	 12331:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EF4A 19802070        	 12332:     move.b  D0,($70,A4,D2.W)
                            	 12333:     even
                            	 12334: _L_z04_Lamnola_Move_Left:
                            	 12335:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 12336:     ;
02:0003EF4E 41EC0098        	 12337:     lea     ($0098,A4),A0
02:0003EF52 10302000        	 12338:     move.b  (A0,D2.W),D0
02:0003EF56 122C0002        	 12339:     move.b  ($0002,A4),D1
02:0003EF5A E309            	 12340:     lsl.b  #1,D1   ; ASL $02
02:0003EF5C 19410002        	 12341:     move.b  D1,($0002,A4)
02:0003EF60 122C0002        	 12342:     move.b  ($0002,A4),D1
02:0003EF64 C200            	 12343:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF66 6716            	 12344:     beq  _L_z04_Lamnola_Move_Down
02:0003EF68 10342070        	 12345:     move.b  ($70,A4,D2.W),D0
02:0003EF6C 122C04E6        	 12346:     move.b  ($04E6,A4),D1
02:0003EF70 0A3C0010        	 12347:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF74 9101            	 12348:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EF76 0A3C0010        	 12349:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF7A 19802070        	 12350:     move.b  D0,($70,A4,D2.W)
                            	 12351:     even
                            	 12352: _L_z04_Lamnola_Move_Down:
                            	 12353:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	 12354:     ;
02:0003EF7E 41EC0098        	 12355:     lea     ($0098,A4),A0
02:0003EF82 10302000        	 12356:     move.b  (A0,D2.W),D0
02:0003EF86 122C0002        	 12357:     move.b  ($0002,A4),D1
02:0003EF8A E309            	 12358:     lsl.b  #1,D1   ; ASL $02
02:0003EF8C 19410002        	 12359:     move.b  D1,($0002,A4)
02:0003EF90 122C0002        	 12360:     move.b  ($0002,A4),D1
02:0003EF94 C200            	 12361:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF96 6716            	 12362:     beq  _L_z04_Lamnola_Move_Up
02:0003EF98 41EC0084        	 12363:     lea     ($0084,A4),A0
02:0003EF9C 10302000        	 12364:     move.b  (A0,D2.W),D0
02:0003EFA0 122C04E6        	 12365:     move.b  ($04E6,A4),D1
02:0003EFA4 D101            	 12366:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EFA6 41EC0084        	 12367:     lea     ($0084,A4),A0
02:0003EFAA 11802000        	 12368:     move.b  D0,(A0,D2.W)
                            	 12369:     even
                            	 12370: _L_z04_Lamnola_Move_Up:
                            	 12371:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	 12372:     ;
02:0003EFAE 41EC0098        	 12373:     lea     ($0098,A4),A0
02:0003EFB2 10302000        	 12374:     move.b  (A0,D2.W),D0
02:0003EFB6 122C0002        	 12375:     move.b  ($0002,A4),D1
02:0003EFBA E309            	 12376:     lsl.b  #1,D1   ; ASL $02
02:0003EFBC 19410002        	 12377:     move.b  D1,($0002,A4)
02:0003EFC0 122C0002        	 12378:     move.b  ($0002,A4),D1
02:0003EFC4 C200            	 12379:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EFC6 671E            	 12380:     beq  _L_z04_Lamnola_Move_Exit
02:0003EFC8 41EC0084        	 12381:     lea     ($0084,A4),A0
02:0003EFCC 10302000        	 12382:     move.b  (A0,D2.W),D0
02:0003EFD0 122C04E6        	 12383:     move.b  ($04E6,A4),D1
02:0003EFD4 0A3C0010        	 12384:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EFD8 9101            	 12385:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EFDA 0A3C0010        	 12386:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EFDE 41EC0084        	 12387:     lea     ($0084,A4),A0
02:0003EFE2 11802000        	 12388:     move.b  D0,(A0,D2.W)
