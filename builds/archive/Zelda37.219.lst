02:0003A9C0 6000FF74        	  2836:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2837: 
                            	  2838: _anon_z04_37:
02:0003A9C4 61000196        	  2839:     jsr     Jumper_PointBoulderDownward
                            	  2840:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2841:     ;
02:0003A9C8 7000            	  2842:     moveq   #0,D0
02:0003A9CA 41EC0451        	  2843:     lea     ($0451,A4),A0
02:0003A9CE 11802000        	  2844:     move.b  D0,(A0,D2.W)
                            	  2845:     ; Get the base offset for the kind of jumper the object is.
                            	  2846:     ;
02:0003A9D2 6100015E        	  2847:     jsr     Jumper_GetKind
02:0003A9D6 41F90003A8C2    	  2848:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A9DC 10303000        	  2849:     move.b  (A0,D3.W),D0
                            	  2850:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2851:     ;
                            	  2852:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2853:     ; does not have $B elements like the tektites' sets.
                            	  2854:     ;
                            	  2855:     ; Boulder does not need the upward accelerations.
                            	  2856:     ; So, the elements for those are used for the starting speeds
                            	  2857:     ; at 04:88F2.
                            	  2858:     ;
