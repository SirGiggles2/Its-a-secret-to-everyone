02:0003F538 0C020007        	 13173:     cmpi.b  #$07,D2
02:0003F53C 670A            	 13174:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F53E 102C0015        	 13175:     move.b  ($0015,A4),D0
