                            	  5782: HandleArrowOrBoomerangBlocked:
                            	  5783:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5784:     ;
02:0004C982 7003            	  5785:     moveq   #3,D0
02:0004C984 41EC03D0        	  5786:     lea     ($03D0,A4),A0
02:0004C988 11802000        	  5787:     move.b  D0,(A0,D2.W)
                            	  5788:     ; Add $10 to the state to make it $2x.
                            	  5789:     ;
02:0004C98C 41EC00AC        	  5790:     lea     ($00AC,A4),A0
02:0004C990 10302000        	  5791:     move.b  (A0,D2.W),D0
