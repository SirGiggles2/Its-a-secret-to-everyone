02:00034CB0 60E4            	  2550:     jmp  LA10A_Exit
                            	  2551: __far_z_02_0007:
                            	  2552:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2553:     ; in the current slot's name.
02:00034CB2 41F9000346C0    	  2554:     lea     (SlotToNameOffset).l,A0
02:00034CB8 10303000        	  2555:     move.b  (A0,D3.W),D0
02:00034CBC 19400421        	  2556:     move.b  D0,($0421,A4)
                            	  2557:     ; Get the offset of the end of the initial name character
                            	  2558:     ; transfer record header for the current slot.
02:00034CC0 7400            	  2559:     moveq   #0,D2
02:00034CC2 41F9000346C4    	  2560:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034CC8 14303000        	  2561:     move.b  (A0,D3.W),D2
02:00034CCC 7602            	  2562:     moveq   #2,D3
