Source: "genesis_shell.asm"
                            	   650: 
                            	   651: ;==============================================================================
                            	   652: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   653: ;
                            	   654: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   655: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   656: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   657: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   658: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   659: ;
                            	   660: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   661: ;
                            	   662: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   663: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   664: ;==============================================================================
                            	   665:     ifne DEBUG_TELEPORT
                            	   666: _debug_teleport_check:
                            	   667:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   668:     tst.b   ($0010,A4)
                            	   669:     bne     .dtc_no
                            	   670:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   671:     cmpi.b  #$05,($0012,A4)
                            	   672:     bne     .dtc_no
                            	   673:     tst.b   ($0013,A4)
                            	   674:     bne     .dtc_no
                            	   675:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   676:     ;
                            	   677:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   678:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   679:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   680:     ; So the bit map is:
                            	   681:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   682:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   683:     move.b  ($00F8,A4),D1
                            	   684:     andi.b  #$0F,D1
                            	   685:     beq     .dtc_no
                            	   686:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   687:     moveq   #0,D0
                            	   688:     btst    #3,D1                   ; Up
                            	   689:     bne.s   .dtc_dir_set
                            	   690:     moveq   #1,D0
                            	   691:     btst    #2,D1                   ; Down
                            	   692:     bne.s   .dtc_dir_set
                            	   693:     moveq   #2,D0
                            	   694:     btst    #1,D1                   ; Left
                            	   695:     bne.s   .dtc_dir_set
                            	   696:     moveq   #3,D0                   ; Right (bit 0)
                            	   697: .dtc_dir_set:
                            	   698:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   699:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   700:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   701:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   702:     move.b  ($00EB,A4),D2
                            	   703:     move.b  D2,D3
                            	   704:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   705:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   706:     tst.b   D0
                            	   707:     bne.s   .dtc_not_up
                            	   708:     tst.b   D2
                            	   709:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   710:     bra.s   .dtc_apply
                            	   711: .dtc_not_up:
                            	   712:     cmpi.b  #1,D0
                            	   713:     bne.s   .dtc_not_down
                            	   714:     cmpi.b  #7,D2
                            	   715:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   716:     bra.s   .dtc_apply
                            	   717: .dtc_not_down:
                            	   718:     cmpi.b  #2,D0
                            	   719:     bne.s   .dtc_not_left
                            	   720:     tst.b   D3
                            	   721:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   722:     bra.s   .dtc_apply
                            	   723: .dtc_not_left:
                            	   724:     cmpi.b  #$0F,D3
                            	   725:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   726: .dtc_apply:
                            	   727:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   728:     lea     (NextRoomIdOffsets).l,A0
                            	   729:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   730:     move.b  ($00EB,A4),D0
                            	   731:     add.b   D1,D0
                            	   732:     move.b  D0,($00EB,A4)
                            	   733:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   734:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   735:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   736:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   737:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   738:     ; movement update doesn't immediately retrigger the edge.
                            	   739:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   740:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   741:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   742:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   743:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   744:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   745:     ; skip that setup.
                            	   746:     jsr     LayOutRoom
                            	   747:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   748:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   749:     ; kick that from here with arbitrary state causes crashes when the
                            	   750:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   751:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   752:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   753:     ; per target room.
                            	   754:     clr.b   ($00F8,A4)
                            	   755:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   756:                                          ; doesn't walk during sweep settle
                            	   757:     moveq   #1,D0
                            	   758:     rts
                            	   759: .dtc_edge:
                            	   760:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   761:     ; interpret it as "walk into wall" animation.
                            	   762:     clr.b   ($00F8,A4)
                            	   763:     clr.b   ($00FA,A4)
                            	   764:     moveq   #1,D0
                            	   765:     rts
                            	   766: .dtc_no:
                            	   767:     moveq   #0,D0
                            	   768:     rts
                            	   769:     endc
                            	   770: 
                            	   771: ;==============================================================================
                            	   772: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   773: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   774: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   775: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   776: ;==============================================================================
                            	   777:     ifne TURBO_LINK
                            	   778: _turbo_link_boost:
                            	   779:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   780:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   781:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   782:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:0004DC9E 4E75            	   783:     rts
                            	   784: _turbo_link_boost_disabled:
                            	   785:     ; OW gate
02:0004DCA0 4A2C0010        	   786:     tst.b   ($0010,A4)
02:0004DCA4 6670            	   787:     bne     .tlb_exit
                            	   788:     ; Mode 5 / Submode 0 only
02:0004DCA6 0C2C00050012    	   789:     cmpi.b  #$05,($0012,A4)
02:0004DCAC 6668            	   790:     bne     .tlb_exit
02:0004DCAE 4A2C0013        	   791:     tst.b   ($0013,A4)
02:0004DCB2 6662            	   792:     bne     .tlb_exit
                            	   793:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:0004DCB4 122C00FA        	   794:     move.b  ($00FA,A4),D1
02:0004DCB8 0201000F        	   795:     andi.b  #$0F,D1
02:0004DCBC 6758            	   796:     beq     .tlb_exit
                            	   797:     ; Edge-safe clamps.
02:0004DCBE 08010003        	   798:     btst    #3,D1                   ; Up (bit 3)
02:0004DCC2 6710            	   799:     beq.s   .tlb_no_up
02:0004DCC4 102C0084        	   800:     move.b  ($0084,A4),D0
02:0004DCC8 0C000040        	   801:     cmpi.b  #$40,D0
02:0004DCCC 6306            	   802:     bls.s   .tlb_no_up
02:0004DCCE 5900            	   803:     subi.b  #4,D0
02:0004DCD0 19400084        	   804:     move.b  D0,($0084,A4)
                            	   805: .tlb_no_up:
02:0004DCD4 08010002        	   806:     btst    #2,D1                   ; Down (bit 2)
02:0004DCD8 6710            	   807:     beq.s   .tlb_no_down
02:0004DCDA 102C0084        	   808:     move.b  ($0084,A4),D0
02:0004DCDE 0C0000D0        	   809:     cmpi.b  #$D0,D0
02:0004DCE2 6406            	   810:     bcc.s   .tlb_no_down
02:0004DCE4 5800            	   811:     addi.b  #4,D0
02:0004DCE6 19400084        	   812:     move.b  D0,($0084,A4)
                            	   813: .tlb_no_down:
02:0004DCEA 08010001        	   814:     btst    #1,D1                   ; Left (bit 1)
02:0004DCEE 6710            	   815:     beq.s   .tlb_no_left
02:0004DCF0 102C0070        	   816:     move.b  ($0070,A4),D0
02:0004DCF4 0C00000A        	   817:     cmpi.b  #$0A,D0
02:0004DCF8 6306            	   818:     bls.s   .tlb_no_left
02:0004DCFA 5900            	   819:     subi.b  #4,D0
02:0004DCFC 19400070        	   820:     move.b  D0,($0070,A4)
                            	   821: .tlb_no_left:
02:0004DD00 08010000        	   822:     btst    #0,D1                   ; Right (bit 0)
02:0004DD04 6710            	   823:     beq.s   .tlb_no_right
02:0004DD06 102C0070        	   824:     move.b  ($0070,A4),D0
02:0004DD0A 0C0000E6        	   825:     cmpi.b  #$E6,D0
02:0004DD0E 6406            	   826:     bcc.s   .tlb_no_right
02:0004DD10 5800            	   827:     addi.b  #4,D0
02:0004DD12 19400070        	   828:     move.b  D0,($0070,A4)
                            	   829: .tlb_no_right:
                            	   830: .tlb_exit:
02:0004DD16 4E75            	   831:     rts
