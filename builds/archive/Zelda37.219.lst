                            	  7461:     ;
02:0003CB52 41EC0098        	  7462:     lea     ($0098,A4),A0
02:0003CB56 10302000        	  7463:     move.b  (A0,D2.W),D0
02:0003CB5A E208            	  7464:     lsr.b  #1,D0   ; LSR A
02:0003CB5C 7600            	  7465:     moveq   #0,D3
02:0003CB5E 1600            	  7466:     move.b  D0,D3
                            	  7467:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7468:     ; position depends on the orientation of the monster.
                            	  7469:     ;
                            	  7470:     ; Start with the horizontal distance.
                            	  7471:     ;
02:0003CB60 102C0004        	  7472:     move.b  ($0004,A4),D0
                            	  7473:     even
                            	  7474: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7475:     ; Look up the limits for the given direction.
                            	  7476:     ;
                            	  7477:     ; If the distance from the bomb < negative limit,
                            	  7478:     ; or >= positive limit, then return.
                            	  7479:     ;
                            	  7480:     ; Note that these are simple signed comparisons that work,
                            	  7481:     ; because the operands are in a small range.
                            	  7482:     ;
02:0003CB64 41F90003CA9E    	  7483:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB6A 12303000        	  7484:     move.b  (A0,D3.W),D1
02:0003CB6E B001            	  7485:     cmp.b   D1,D0
02:0003CB70 6B42            	  7486:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB72 41F90003CAA4    	  7487:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB78 12303000        	  7488:     move.b  (A0,D3.W),D1
02:0003CB7C B001            	  7489:     cmp.b   D1,D0
02:0003CB7E 6A34            	  7490:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7491:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7492:     ;
02:0003CB80 1003            	  7493:     move.b  D3,D0
02:0003CB82 023C00EE        	  7494:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB86 123C000A        	  7495:     move.b  #$0A,D1
02:0003CB8A D101            	  7496:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB8C 7600            	  7497:     moveq   #0,D3
02:0003CB8E 1600            	  7498:     move.b  D0,D3
                            	  7499:     ; Bottom of the loop.
                            	  7500:     ;
                            	  7501:     ; Load the vertical distance for the next iteration.
                            	  7502:     ; Decrement loop counter.
                            	  7503:     ;
02:0003CB90 102C0005        	  7504:     move.b  ($0005,A4),D0
02:0003CB94 5314            	  7505:     subq.b  #1,($0000,A4)
02:0003CB96 6ACC            	  7506:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7507:     ; If we get here, then the bomb was within range of the mouth.
                            	  7508:     ; Go to state 1 (bloated).
                            	  7509:     ;
02:0003CB98 41EC00AC        	  7510:     lea     ($00AC,A4),A0
02:0003CB9C 52302000        	  7511:     addq.b  #1,(A0,D2.W)
                            	  7512:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7513:     ;
02:0003CBA0 7610            	  7514:     moveq   #16,D3
02:0003CBA2 7000            	  7515:     moveq   #0,D0
02:0003CBA4 41EC00AC        	  7516:     lea     ($00AC,A4),A0
02:0003CBA8 11803000        	  7517:     move.b  D0,(A0,D3.W)
02:0003CBAC 41EC042C        	  7518:     lea     ($042C,A4),A0
02:0003CBB0 11802000        	  7519:     move.b  D0,(A0,D2.W)
                            	  7520:     even
                            	  7521: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CBB4 4E75            	  7522:     rts
                            	  7523: 
