                            	  3314: _anon_z04_42:
                            	  3315:     ; State 0.
                            	  3316:     ;
                            	  3317:     ; In state we determine whether to burst out of the ground.
                            	  3318:     ; If the long timer has not expired, then return.
                            	  3319:     ;
02:0003AD76 102C004D        	  3320:     move.b  ($004D,A4),D0
02:0003AD7A 6674            	  3321:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3322:     ; Only allow two red leevers at a time.
                            	  3323:     ;
02:0003AD7C 102C0510        	  3324:     move.b  ($0510,A4),D0
02:0003AD80 0C000002        	  3325:     cmpi.b  #$02,D0
02:0003AD84 646A            	  3326:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3327:     ; Face in the same direction as Link.
                            	  3328:     ;
02:0003AD86 102C0098        	  3329:     move.b  ($0098,A4),D0
02:0003AD8A 41EC0098        	  3330:     lea     ($0098,A4),A0
02:0003AD8E 11802000        	  3331:     move.b  D0,(A0,D2.W)
                            	  3332:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3333:     ;
02:0003AD92 10342019        	  3334:     move.b  ($19,A4,D2.W),D0
02:0003AD96 0C0000C0        	  3335:     cmpi.b  #$C0,D0
