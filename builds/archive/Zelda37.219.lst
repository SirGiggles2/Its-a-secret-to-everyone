                            	  6087:     ;
02:0003C130 41EC03BC        	  6088:     lea     ($03BC,A4),A0
02:0003C134 10302000        	  6089:     move.b  (A0,D2.W),D0
02:0003C138 6712            	  6090:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C13A 41EC0098        	  6091:     lea     ($0098,A4),A0
02:0003C13E 11802000        	  6092:     move.b  D0,(A0,D2.W)
02:0003C142 7000            	  6093:     moveq   #0,D0
