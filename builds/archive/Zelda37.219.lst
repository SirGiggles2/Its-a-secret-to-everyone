                            	  1958: _L_z04_UpdateStatues_Shoot:
                            	  1959:     ; Look for an empty monster slot.
                            	  1960:     ; If none is found, return.
                            	  1961:     ;
                            	  1962:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1963:     ; object. This routine takes a shooter object, and instantiates
                            	  1964:     ; a fireball object at the shooter's location.
                            	  1965:     ;
                            	  1966:     ; The object slot we set up here will behave as the shooter.
                            	  1967:     ; For each fireball index, this object slot will have its coordinates
                            	  1968:     ; changed.
                            	  1969:     ;
                            	  1970:     ; Note that this means that:
                            	  1971:     ; 1. The first fireball made will be its own shooter.
                            	  1972:     ;    Practically, there's nothing special about this.
                            	  1973:     ; 2. If there is more than one fireball made in a frame,
                            	  1974:     ;    then two of them will come from the same statue.
                            	  1975:     ;
                            	  1976:     ;
                            	  1977:     ; Save the fireball pattern.
02:0003A422 1003            	  1978:     move.b  D3,D0
02:0003A424 1B00            	  1979:     move.b  D0,-(A5)  ; PHA
02:0003A426 4EB90004DAF4    	  1980:     jsr     FindEmptyMonsterSlot
02:0003A42C 0C000001        	  1981:     cmpi.b  #$01,D0
02:0003A430 101D            	  1982:     move.b  (A5)+,D0  ; PLA
02:0003A432 6400010A        	  1983:     bcc  _L_z04_UpdateStatues_Exit
                            	  1984:     ; If we found a slot, but it < 6, return.
                            	  1985:     ;
02:0003A436 0C030006        	  1986:     cmpi.b  #$06,D3
02:0003A43A 65000102        	  1987:     bcs  _L_z04_UpdateStatues_Exit
                            	  1988:     ; Store the object slot in [0A].
                            	  1989:     ; Store fireball pattern in [0B].
                            	  1990:     ;
02:0003A43E 1943000A        	  1991:     move.b  D3,($000A,A4)
02:0003A442 1940000B        	  1992:     move.b  D0,($000B,A4)
                            	  1993:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1994:     ;
02:0003A446 7600            	  1995:     moveq   #0,D3
02:0003A448 1600            	  1996:     move.b  D0,D3
02:0003A44A 7400            	  1997:     moveq   #0,D2
02:0003A44C 41F90003A3DE    	  1998:     lea     (StatueFireballCounts).l,A0
02:0003A452 14303000        	  1999:     move.b  (A0,D3.W),D2
                            	  2000:     even
                            	  2001: _L_z04_UpdateStatues_LoopFireball:
                            	  2002:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2003:     ;
                            	  2004:     ; Decrement the fireball timer at this index.
                            	  2005:     ;
02:0003A456 7600            	  2006:     moveq   #0,D3
02:0003A458 41EC04E8        	  2007:     lea     ($04E8,A4),A0
02:0003A45C 16302000        	  2008:     move.b  (A0,D2.W),D3
02:0003A460 5303            	  2009:     subq.b  #1,D3
02:0003A462 1003            	  2010:     move.b  D3,D0
02:0003A464 41EC04E8        	  2011:     lea     ($04E8,A4),A0
02:0003A468 11802000        	  2012:     move.b  D0,(A0,D2.W)
                            	  2013:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2014:     ; to make a fireball. Go loop again.
                            	  2015:     ;
02:0003A46C 5203            	  2016:     addq.b  #1,D3
02:0003A46E 660000C8        	  2017:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2018:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2019:     ; This fireball index will wait another $100 frames.
                            	  2020:     ;
02:0003A472 10342018        	  2021:     move.b  ($18,A4,D2.W),D0
02:0003A476 0C0000F0        	  2022:     cmpi.b  #$F0,D0
02:0003A47A 640000BC        	  2023:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2024:     ; Else choose one of four start times for the fireball based on
                            	  2025:     ; the random value.
                            	  2026:     ;
02:0003A47E 02000003        	  2027:     andi.b #$03,D0
02:0003A482 7600            	  2028:     moveq   #0,D3
02:0003A484 1600            	  2029:     move.b  D0,D3
02:0003A486 41F90003A3E2    	  2030:     lea     (StatueFireballStartTimes).l,A0
02:0003A48C 10303000        	  2031:     move.b  (A0,D3.W),D0
02:0003A490 41EC04E8        	  2032:     lea     ($04E8,A4),A0
02:0003A494 11802000        	  2033:     move.b  D0,(A0,D2.W)
                            	  2034:     ; The coordinate lists are divided into sets for each pattern.
                            	  2035:     ;
                            	  2036:     ; Look up the index of the base of the set for the pattern in use.
                            	  2037:     ; Add it to the fireball index in X register to get the index of
                            	  2038:     ; the coordinate we want within each coordinate list.
                            	  2039:     ;
                            	  2040:     ;
                            	  2041:     ; Pattern
02:0003A498 7600            	  2042:     moveq   #0,D3
02:0003A49A 162C000B        	  2043:     move.b  ($000B,A4),D3
02:0003A49E 1002            	  2044:     move.b  D2,D0
02:0003A4A0 023C00EE        	  2045:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4A4 41F90003A3E6    	  2046:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A4AA 12303000        	  2047:     move.b  (A0,D3.W),D1
02:0003A4AE D101            	  2048:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A4B0 7600            	  2049:     moveq   #0,D3
02:0003A4B2 1600            	  2050:     move.b  D0,D3
02:0003A4B4 1002            	  2051:     move.b  D2,D0
02:0003A4B6 1B00            	  2052:     move.b  D0,-(A5)  ; PHA
                            	  2053:     ; Get Link's coordinates into [00] and [01].
                            	  2054:     ;
02:0003A4B8 7400            	  2055:     moveq   #0,D2
02:0003A4BA 4EB90004D304    	  2056:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2057:     ; Switch to the new fireball's object slot.
                            	  2058:     ;
02:0003A4C0 7400            	  2059:     moveq   #0,D2
02:0003A4C2 142C000A        	  2060:     move.b  ($000A,A4),D2
                            	  2061:     ; Look up and set the X coordinate for the fireball object.
                            	  2062:     ; Also store it in [02].
                            	  2063:     ;
02:0003A4C6 41F90003A3EA    	  2064:     lea     (StatueXs).l,A0
02:0003A4CC 10303000        	  2065:     move.b  (A0,D3.W),D0
02:0003A4D0 19400002        	  2066:     move.b  D0,($0002,A4)
02:0003A4D4 19802070        	  2067:     move.b  D0,($70,A4,D2.W)
                            	  2068:     ; Look up and set the Y coordinate for the fireball object.
                            	  2069:     ; Also store it in [03].
                            	  2070:     ;
02:0003A4D8 41F90003A3F2    	  2071:     lea     (StatueYs).l,A0
02:0003A4DE 10303000        	  2072:     move.b  (A0,D3.W),D0
02:0003A4E2 19400003        	  2073:     move.b  D0,($0003,A4)
02:0003A4E6 41EC0084        	  2074:     lea     ($0084,A4),A0
02:0003A4EA 11802000        	  2075:     move.b  D0,(A0,D2.W)
                            	  2076:     ; Set mask value 3 in [04].
                            	  2077:     ;
02:0003A4EE 7003            	  2078:     moveq   #3,D0
02:0003A4F0 19400004        	  2079:     move.b  D0,($0004,A4)
                            	  2080:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2081:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2082:     ;
02:0003A4F4 7601            	  2083:     moveq   #1,D3
                            	  2084:     even
                            	  2085: _L_z04_UpdateStatues_LoopAxis:
02:0003A4F6 10343000        	  2086:     move.b  ($00,A4,D3.W),D0
02:0003A4FA 003C0011        	  2087:     ori     #$11,CCR  ; SEC: set C+X
02:0003A4FE 12343002        	  2088:     move.b  ($02,A4,D3.W),D1
02:0003A502 0A3C0010        	  2089:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A506 9101            	  2090:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A508 0A3C0010        	  2091:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A50C 0C000018        	  2092:     cmpi.b  #$18,D0
02:0003A510 6A10            	  2093:     bpl  _anon_z04_31
02:0003A512 0C0000E8        	  2094:     cmpi.b  #$E8,D0
02:0003A516 6B0A            	  2095:     bmi  _anon_z04_31
02:0003A518 122C0004        	  2096:     move.b  ($0004,A4),D1
02:0003A51C E209            	  2097:     lsr.b  #1,D1   ; LSR $04
02:0003A51E 19410004        	  2098:     move.b  D1,($0004,A4)
                            	  2099: _anon_z04_31:
02:0003A522 5303            	  2100:     subq.b  #1,D3
02:0003A524 6AD0            	  2101:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2102:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2103:     ; 0 or 1 time, instead of 2.
                            	  2104:     ;
                            	  2105:     ; This, in turn, means that the distance between Link and the
                            	  2106:     ; fireball was >= $18 in at least one axis.
                            	  2107:     ;
                            	  2108:     ; So, we're OK to finish making the fireball.
                            	  2109:     ;
02:0003A526 102C0004        	  2110:     move.b  ($0004,A4),D0
02:0003A52A 6706            	  2111:     beq  _anon_z04_32
02:0003A52C 7055            	  2112:     moveq   #85,D0
02:0003A52E 6100F7CC        	  2113:     jsr     ShootFireball
                            	  2114: _anon_z04_32:
