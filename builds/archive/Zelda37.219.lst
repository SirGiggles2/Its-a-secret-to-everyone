                            	  4081:     ; If Link's X < $70 or >= $81, then return.
                            	  4082:     ;
02:0003B2A2 102C0070        	  4083:     move.b  ($0070,A4),D0
02:0003B2A6 0C000070        	  4084:     cmpi.b  #$70,D0
02:0003B2AA 6514            	  4085:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B2AC 0C000081        	  4086:     cmpi.b  #$81,D0
