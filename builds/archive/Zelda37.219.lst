02:0004CB38 41EC03D0        	  6031:     lea     ($03D0,A4),A0
02:0004CB3C 11802000        	  6032:     move.b  D0,(A0,D2.W)
02:0004CB40 41EC00AC        	  6033:     lea     ($00AC,A4),A0
02:0004CB44 52302000        	  6034:     addq.b  #1,(A0,D2.W)
02:0004CB48 41EC00AC        	  6035:     lea     ($00AC,A4),A0
02:0004CB4C 10302000        	  6036:     move.b  (A0,D2.W),D0
02:0004CB50 02000077        	  6037:     andi.b #$77,D0
02:0004CB54 41EC00AC        	  6038:     lea     ($00AC,A4),A0
02:0004CB58 11802000        	  6039:     move.b  D0,(A0,D2.W)
02:0004CB5C 0C02000D        	  6040:     cmpi.b  #$0D,D2
02:0004CB60 6402            	  6041:     bcc.s  __far_z_07_0091
02:0004CB62 6032            	  6042:     jmp  CalcBoomerangFrame
                            	  6043: __far_z_07_0091:
