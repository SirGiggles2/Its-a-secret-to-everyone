                            	  3385: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3386:     ; Begin with the leever's Y set to Link's Y.
                            	  3387:     ;
02:0003ADF2 102C0084        	  3388:     move.b  ($0084,A4),D0
02:0003ADF6 41EC0084        	  3389:     lea     ($0084,A4),A0
02:0003ADFA 11802000        	  3390:     move.b  D0,(A0,D2.W)
                            	  3391:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3392:     ; it's too close to the top edge of the screen. So, return.
                            	  3393:     ;
02:0003ADFE 0C00005D        	  3394:     cmpi.b  #$5D,D0
02:0003AE02 65EC            	  3395:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3396:     ; If facing right, then use X offset $28.
                            	  3397:     ; Else store X offset -$28 in [00].
                            	  3398:     ;
02:0003AE04 7628            	  3399:     moveq   #40,D3
02:0003AE06 41EC0098        	  3400:     lea     ($0098,A4),A0
02:0003AE0A 10302000        	  3401:     move.b  (A0,D2.W),D0
02:0003AE0E 02000002        	  3402:     andi.b #$02,D0
02:0003AE12 6704            	  3403:     beq  _anon_z04_45
02:0003AE14 163C00D8        	  3404:     move.b  #$D8,D3
                            	  3405: _anon_z04_45:
02:0003AE18 1883            	  3406:     move.b  D3,($0000,A4)
                            	  3407:     ; [01] holds Link's X coordinate.
                            	  3408:     ;
02:0003AE1A 102C0070        	  3409:     move.b  ($0070,A4),D0
02:0003AE1E 19400001        	  3410:     move.b  D0,($0001,A4)
                            	  3411:     ; Add Link's X and the horizontal offset.
                            	  3412:     ;
02:0003AE22 023C00EE        	  3413:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE26 1214            	  3414:     move.b  ($0000,A4),D1
02:0003AE28 D101            	  3415:     addx.b  D1,D0   ; ADC $00
                            	  3416:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3417:     ;
02:0003AE2A 020000F8        	  3418:     andi.b #$F8,D0
                            	  3419:     ; Assign that result to the leever's X coordinate and [02].
                            	  3420:     ;
02:0003AE2E 19802070        	  3421:     move.b  D0,($70,A4,D2.W)
02:0003AE32 19400002        	  3422:     move.b  D0,($0002,A4)
                            	  3423:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3424:     ;
02:0003AE36 122C0001        	  3425:     move.b  ($0001,A4),D1
02:0003AE3A B001            	  3426:     cmp.b   D1,D0
02:0003AE3C 6510            	  3427:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003AE3E 1B00            	  3428:     move.b  D0,-(A5)  ; PHA
02:0003AE40 102C0001        	  3429:     move.b  ($0001,A4),D0
02:0003AE44 19400002        	  3430:     move.b  D0,($0002,A4)
02:0003AE48 101D            	  3431:     move.b  (A5)+,D0  ; PLA
02:0003AE4A 19400001        	  3432:     move.b  D0,($0001,A4)
                            	  3433:     even
                            	  3434: _L_z04_UpdateRedLeever_Subtract:
                            	  3435:     ; The point is to get the absolute distance between the two.
                            	  3436:     ;
02:0003AE4E 102C0001        	  3437:     move.b  ($0001,A4),D0
02:0003AE52 003C0011        	  3438:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE56 122C0002        	  3439:     move.b  ($0002,A4),D1
02:0003AE5A 0A3C0010        	  3440:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE5E 9101            	  3441:     subx.b  D1,D0   ; SBC $02
02:0003AE60 0A3C0010        	  3442:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3443:     ; If the absolute distance >= $30, then return.
                            	  3444:     ; It means that the leever's X coordinate wrapped around
                            	  3445:     ; the left or right edge of the screen.
                            	  3446:     ;
02:0003AE64 0C000030        	  3447:     cmpi.b  #$30,D0
02:0003AE68 6486            	  3448:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3449:     even
                            	  3450: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3451:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3452:     ;
02:0003AE6A 4EB90004BA56    	  3453:     jsr     GetCollidableTileStill
02:0003AE70 122C034A        	  3454:     move.b  ($034A,A4),D1
02:0003AE74 B001            	  3455:     cmp.b   D1,D0
02:0003AE76 6400FF78        	  3456:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE7A 522C0510        	  3457:     addq.b  #1,($0510,A4)
                            	  3458:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3459:     ; and pick up whatever the new value is for state 1.
                            	  3460:     ;
02:0003AE7E 7001            	  3461:     moveq   #1,D0
02:0003AE80 41EC03D0        	  3462:     lea     ($03D0,A4),A0
02:0003AE84 11802000        	  3463:     move.b  D0,(A0,D2.W)
                            	  3464:     ; Set the long timer to 2, meaning 20 frames.
                            	  3465:     ;
02:0003AE88 E308            	  3466:     lsl.b  #1,D0   ; ASL A
02:0003AE8A 1940004D        	  3467:     move.b  D0,($004D,A4)
02:0003AE8E 6100008C        	  3468:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3469:     ; The leever has to face Link in order to move toward him.
                            	  3470:     ;
02:0003AE92 4EB90004C1E4    	  3471:     jsr     ReverseObjDir
                            	  3472:     even
                            	  3473: _L_z04_UpdateRedLeever_CheckOtherStates:
