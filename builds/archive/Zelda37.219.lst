                            	  1698: __far_z_05_0028:
02:00041104 5302            	  1699:     subq.b  #1,D2
02:00041106 6612            	  1700:     bne  _L_z05_InitMode4_CheckSub2
                            	  1701:     ; Submode 1.
                            	  1702:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1703:     ;
                            	  1704:     ; TODO:
                            	  1705:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1706:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1707:     ; A positive value triggers this submode 1 to transfer
                            	  1708:     ; the whole play area.
                            	  1709:     ;
                            	  1710:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1711:     ; a good state reflecting the new room. The only thing
                            	  1712:     ; needed is possibly to brighten the room by way of
                            	  1713:     ; changing the palette.
                            	  1714:     ;
                            	  1715:     ; So why does mode 7 trigger this?
                            	  1716:     ; Is there another mode that truly needs this behavior?
                            	  1717:     ;
02:00041108 102C00E9        	  1718:     move.b  ($00E9,A4),D0
02:0004110C 6B06            	  1719:     bmi  _anon_z05_40
02:0004110E 6100373A        	  1720:     jsr     CopyNextRowToTransferBuf
02:00041112 6404            	  1721:     bcc  _L_z05_InitMode4_Exit
                            	  1722: _anon_z05_40:
02:00041114 522C0013        	  1723:     addq.b  #1,($0013,A4)
                            	  1724:     even
                            	  1725: _L_z05_InitMode4_Exit:
02:00041118 4E75            	  1726:     rts
                            	  1727: 
                            	  1728:     even
                            	  1729: _L_z05_InitMode4_CheckSub2:
02:0004111A 5302            	  1730:     subq.b  #1,D2
02:0004111C 6702            	  1731:     beq.s  __far_z_05_0029
02:0004111E 605A            	  1732:     jmp  InitMode4_Sub3
                            	  1733: __far_z_05_0029:
                            	  1734:     ; Submode 2.
                            	  1735:     ;
02:00041120 7600            	  1736:     moveq   #0,D3
02:00041122 162C00EB        	  1737:     move.b  ($00EB,A4),D3
02:00041126 610045BE        	  1738:     jsr     IsDarkRoom_Bank5
02:0004112A 6702            	  1739:     beq.s  __far_z_05_0030
02:0004112C 6054            	  1740:     jmp  InitMode4_GoToSub0
                            	  1741: __far_z_05_0030:
                            	  1742:     ; This is a light room.
                            	  1743:     ; See if we have to brighten it after leaving a dark room.
                            	  1744:     ;
02:0004112E 102C0098        	  1745:     move.b  ($0098,A4),D0
02:00041132 610043FA        	  1746:     jsr     CalcNextRoomByDir
                            	  1747:     ; Subtract RoomId from next room ID that was calculated
                            	  1748:     ; to get room ID offset in that direction.
02:00041136 003C0011        	  1749:     ori     #$11,CCR  ; SEC: set C+X
02:0004113A 122C00EB        	  1750:     move.b  ($00EB,A4),D1
02:0004113E 0A3C0010        	  1751:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041142 9101            	  1752:     subx.b  D1,D0   ; SBC RoomId
02:00041144 0A3C0010        	  1753:     eori    #$10,CCR  ; restore X = 6502 C
02:00041148 4EB900030ABA    	  1754:     jsr     Negate
02:0004114E 023C00EE        	  1755:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041152 122C00EB        	  1756:     move.b  ($00EB,A4),D1
02:00041156 D101            	  1757:     addx.b  D1,D0   ; ADC RoomId
02:00041158 7600            	  1758:     moveq   #0,D3
02:0004115A 1600            	  1759:     move.b  D0,D3
02:0004115C 61004588        	  1760:     jsr     IsDarkRoom_Bank5
02:00041160 6602            	  1761:     bne.s  __far_z_05_0031
02:00041162 601E            	  1762:     jmp  InitMode4_GoToSub0
                            	  1763: __far_z_05_0031:
