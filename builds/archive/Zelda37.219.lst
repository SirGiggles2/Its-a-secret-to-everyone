02:00043B4A 6602            	  6186:     bne.s  __far_z_05_0094
02:00043B4C 60C4            	  6187:     jmp  L165D4_Exit
                            	  6188: __far_z_05_0094:
                            	  6189:     ; Turn the door command into the desired open or closed state
                            	  6190:     ; to store in [08].
                            	  6191:     ;
                            	  6192:     ; cmd:  7 6 3 2 
                            	  6193:     ; [08]: 2 0 0 0
                            	  6194:     ;
                            	  6195:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6196:     ; commands intended to be used.
                            	  6197:     ;
                            	  6198:     ; 3 is the end state of 2: close
                            	  6199:     ; 7 is the end state of 6: open
                            	  6200:     ;
02:00043B4E 02000007        	  6201:     andi.b #$07,D0
02:00043B52 7601            	  6202:     moveq   #1,D3
02:00043B54 19430002        	  6203:     move.b  D3,($0002,A4)
02:00043B58 122C0002        	  6204:     move.b  ($0002,A4),D1
02:00043B5C C200            	  6205:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043B5E 6702            	  6206:     beq  _anon_z05_118
02:00043B60 E208            	  6207:     lsr.b  #1,D0   ; LSR A
                            	  6208: _anon_z05_118:
02:00043B62 0C000002        	  6209:     cmpi.b  #$02,D0
02:00043B66 6606            	  6210:     bne  _anon_z05_119
                            	  6211:     ; Command 2 sets Link's timer to $30.
                            	  6212:     ;
02:00043B68 7630            	  6213:     moveq   #48,D3
02:00043B6A 19430028        	  6214:     move.b  D3,($0028,A4)
                            	  6215: _anon_z05_119:
02:00043B6E 02000003        	  6216:     andi.b #$03,D0
02:00043B72 003C0011        	  6217:     ori     #$11,CCR  ; SEC: set C+X
02:00043B76 123C0001        	  6218:     move.b  #$01,D1
02:00043B7A 0A3C0010        	  6219:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043B7E 9101            	  6220:     subx.b  D1,D0   ; SBC #$01
02:00043B80 0A3C0010        	  6221:     eori    #$10,CCR  ; restore X = 6502 C
02:00043B84 02000002        	  6222:     andi.b #$02,D0
02:00043B88 19400008        	  6223:     move.b  D0,($0008,A4)
                            	  6224:     ; The command to close a key door or bombable wall does not
                            	  6225:     ; do anything.
                            	  6226:     ;
02:00043B8C 102C0054        	  6227:     move.b  ($0054,A4),D0
02:00043B90 0C000005        	  6228:     cmpi.b  #$05,D0
02:00043B94 6416            	  6229:     bcc  _anon_z05_120
02:00043B96 102C0055        	  6230:     move.b  ($0055,A4),D0
02:00043B9A 19400002        	  6231:     move.b  D0,($0002,A4)
02:00043B9E 6100FAEC        	  6232:     jsr     FindDoorAttrByDoorBit
02:00043BA2 0C000007        	  6233:     cmpi.b  #$07,D0
02:00043BA6 6704            	  6234:     beq  _anon_z05_120
02:00043BA8 6000009C        	  6235:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  6236: 
                            	  6237: _anon_z05_120:
                            	  6238:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6239:     ;
                            	  6240:     ; Shutters and the commands to open a door always change
                            	  6241:     ; tiles.
                            	  6242:     ;
02:00043BAC 61000130        	  6243:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6244:     even
                            	  6245: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6246:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6247:     ; We need to remember how many tiles need to be copied
                            	  6248:     ; in each transfer record.
                            	  6249:     ;
02:00043BB0 102C0006        	  6250:     move.b  ($0006,A4),D0
02:00043BB4 19400004        	  6251:     move.b  D0,($0004,A4)
                            	  6252:     ; Write the transfer record header for the door.
                            	  6253:     ;
                            	  6254:     ;
                            	  6255:     ; VRAM address high byte of door
02:00043BB8 1014            	  6256:     move.b  ($0000,A4),D0
02:00043BBA 41EC0302        	  6257:     lea     ($0302,A4),A0
02:00043BBE 11802000        	  6258:     move.b  D0,(A0,D2.W)
02:00043BC2 5202            	  6259:     addq.b  #1,D2
02:00043BC4 102C0001        	  6260:     move.b  ($0001,A4),D0
02:00043BC8 41EC0302        	  6261:     lea     ($0302,A4),A0
02:00043BCC 11802000        	  6262:     move.b  D0,(A0,D2.W)
02:00043BD0 5202            	  6263:     addq.b  #1,D2
02:00043BD2 102C0006        	  6264:     move.b  ($0006,A4),D0
02:00043BD6 41EC0302        	  6265:     lea     ($0302,A4),A0
02:00043BDA 11802000        	  6266:     move.b  D0,(A0,D2.W)
02:00043BDE 5202            	  6267:     addq.b  #1,D2
                            	  6268: _anon_z05_121:
                            	  6269:     ; Write two tiles in a short loop indexed by [04].
                            	  6270:     ;
02:00043BE0 6100ED1C        	  6271:     jsr     WriteDoorFaceTileHorizontally
02:00043BE4 66FA            	  6272:     bne  _anon_z05_121
                            	  6273:     ; OR the low VRAM address with $20 to go down one row
                            	  6274:     ; in order to work on the second row of door tiles.
                            	  6275:     ;
02:00043BE6 7020            	  6276:     moveq   #32,D0
02:00043BE8 122C0001        	  6277:     move.b  ($0001,A4),D1
02:00043BEC 8001            	  6278:     or.b  D1,D0
02:00043BEE 19400001        	  6279:     move.b  D0,($0001,A4)
                            	  6280:     ; Bottom of the loop.
                            	  6281:     ; Loop again to write the second transfer record for the
                            	  6282:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6283:     ;
02:00043BF2 532C0005        	  6284:     subq.b  #1,($0005,A4)
02:00043BF6 66B8            	  6285:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6286:     ; Write the end marker, and update buffer length.
                            	  6287:     ;
02:00043BF8 103C00FF        	  6288:     move.b  #$FF,D0
02:00043BFC 41EC0302        	  6289:     lea     ($0302,A4),A0
02:00043C00 11802000        	  6290:     move.b  D0,(A0,D2.W)
02:00043C04 1002            	  6291:     move.b  D2,D0
02:00043C06 19400301        	  6292:     move.b  D0,($0301,A4)
                            	  6293:     ; Increment the command.
                            	  6294:     ;
02:00043C0A 522C0054        	  6295:     addq.b  #1,($0054,A4)
                            	  6296:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6297:     ; and resetting the door command.
                            	  6298:     ; This ends up catching original states 3 and 7.
                            	  6299:     ;
                            	  6300:     ; Else set door timer to 8 and return.
                            	  6301:     ;
02:00043C0E 102C0054        	  6302:     move.b  ($0054,A4),D0
02:00043C12 02000003        	  6303:     andi.b #$03,D0
02:00043C16 6708            	  6304:     beq  _anon_z05_122
02:00043C18 7008            	  6305:     moveq   #8,D0
02:00043C1A 19400027        	  6306:     move.b  D0,($0027,A4)
02:00043C1E 4E75            	  6307:     rts
                            	  6308: 
                            	  6309: _anon_z05_122:
                            	  6310:     ; If the door command = 4 after incrementing it, then
                            	  6311:     ; it was 3 (close door). So:
                            	  6312:     ; 1. reset this door's flag
                            	  6313:     ; 2. remove it from the opened door mask
                            	  6314:     ; 3. reset the door command
                            	  6315:     ; 4. go lay out doors in the play area map
                            	  6316:     ;
02:00043C20 102C0054        	  6317:     move.b  ($0054,A4),D0
02:00043C24 0C000004        	  6318:     cmpi.b  #$04,D0
02:00043C28 6626            	  6319:     bne  _anon_z05_123
02:00043C2A 7400            	  6320:     moveq   #0,D2
02:00043C2C 142C0009        	  6321:     move.b  ($0009,A4),D2
02:00043C30 6100DACE        	  6322:     jsr     ResetDoorFlag
02:00043C34 102C0055        	  6323:     move.b  ($0055,A4),D0
02:00043C38 0A00000F        	  6324:     eori.b #$0F,D0
02:00043C3C 122C00EE        	  6325:     move.b  ($00EE,A4),D1
02:00043C40 C001            	  6326:     and.b  D1,D0
                            	  6327:     even
                            	  6328: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043C42 194000EE        	  6329:     move.b  D0,($00EE,A4)
                            	  6330:     even
                            	  6331: L_ResetDoorCmdAndLayOutDoors:
02:00043C46 7000            	  6332:     moveq   #0,D0
02:00043C48 19400054        	  6333:     move.b  D0,($0054,A4)
02:00043C4C 6000FCD4        	  6334:     jmp     LayOutDoors
                            	  6335: 
                            	  6336: _anon_z05_123:
                            	  6337:     ; Door command <> 4.
                            	  6338:     ; It must be 8, which means it was 7: open door.
                            	  6339:     ;
                            	  6340:     ; If the door is a shutter (7), then go add the door to the
                            	  6341:     ; opened door mask, reset door command, and lay out doors.
                            	  6342:     ;
02:00043C50 102C0055        	  6343:     move.b  ($0055,A4),D0
02:00043C54 19400002        	  6344:     move.b  D0,($0002,A4)
02:00043C58 6100FA32        	  6345:     jsr     FindDoorAttrByDoorBit
02:00043C5C 0C000007        	  6346:     cmpi.b  #$07,D0
02:00043C60 676E            	  6347:     beq  _anon_z05_124
                            	  6348:     ; Else the door is not a shutter.
                            	  6349:     ;
                            	  6350:     ;
                            	  6351:     ; [09] door direction index
02:00043C62 7400            	  6352:     moveq   #0,D2
02:00043C64 142C0009        	  6353:     move.b  ($0009,A4),D2
02:00043C68 6100DA90        	  6354:     jsr     SetDoorFlag
                            	  6355:     ; Get the next room's ID.
                            	  6356:     ;
02:00043C6C 1003            	  6357:     move.b  D3,D0
02:00043C6E 023C00EE        	  6358:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043C72 41F900043B2E    	  6359:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043C78 12302000        	  6360:     move.b  (A0,D2.W),D1
02:00043C7C D101            	  6361:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043C7E 7600            	  6362:     moveq   #0,D3
02:00043C80 1600            	  6363:     move.b  D0,D3
                            	  6364:     ; Flip the door direction index.
                            	  6365:     ;
02:00043C82 1002            	  6366:     move.b  D2,D0
02:00043C84 0A000001        	  6367:     eori.b #$01,D0
02:00043C88 7400            	  6368:     moveq   #0,D2
02:00043C8A 1400            	  6369:     move.b  D0,D2
                            	  6370:     ; Set the door flag for the opposite door in the next room.
                            	  6371:     ;
02:00043C8C 1214            	  6372:     move.b  ($00,A4),D1   ; ptr lo
02:00043C8E 182C0001        	  6373:     move.b  ($01,A4),D4  ; ptr hi
02:00043C92 024100FF        	  6374:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C96 E14C            	  6375:     lsl.w   #8,D4
02:00043C98 8841            	  6376:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043C9A 48C4            	  6377:     ext.l   D4
02:00043C9C D8BC00FF0000    	  6378:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043CA2 2044            	  6379:     movea.l D4,A0
02:00043CA4 10303000        	  6380:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043CA8 41F90004AE94    	  6381:     lea     (LevelMasks).l,A0
02:00043CAE 12302000        	  6382:     move.b  (A0,D2.W),D1
02:00043CB2 8001            	  6383:     or.b  D1,D0
02:00043CB4 1214            	  6384:     move.b  ($00,A4),D1   ; ptr lo
02:00043CB6 182C0001        	  6385:     move.b  ($01,A4),D4  ; ptr hi
02:00043CBA 024100FF        	  6386:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043CBE E14C            	  6387:     lsl.w   #8,D4
02:00043CC0 8841            	  6388:     or.w    D1,D4
02:00043CC2 48C4            	  6389:     ext.l   D4
02:00043CC4 D8BC00FF0000    	  6390:     add.l   #NES_RAM,D4
02:00043CCA 2044            	  6391:     movea.l D4,A0
02:00043CCC 11803000        	  6392:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6393: _anon_z05_124:
                            	  6394:     ; Add the door to the opened door mask, reset door command,
                            	  6395:     ; and lay out doors.
                            	  6396:     ;
02:00043CD0 102C0055        	  6397:     move.b  ($0055,A4),D0
02:00043CD4 122C00EE        	  6398:     move.b  ($00EE,A4),D1
02:00043CD8 8001            	  6399:     or.b  D1,D0
02:00043CDA 6000FF66        	  6400:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6401: 
                            	  6402: ; Params:
                            	  6403: ; [08]: 0 if closed
                            	  6404: ;
                            	  6405: ; Returns:
                            	  6406: ; X: current length of dynamic transfer buf
                            	  6407: ; [00]: door VRAM address high byte
                            	  6408: ; [01]: door VRAM address low byte
                            	  6409: ; [02:03]: address of door tiles for direction and face
                            	  6410: ; [05]: 2, the number of transfer records to write
                            	  6411: ; [06]: 2, the number of tiles in each record
                            	  6412: ; [07]: 0, the first index of a tile to transfer
                            	  6413: ; [09]: door direction index
                            	  6414: ;
                            	  6415: ; Note that this routine is called with triggered doors:
                            	  6416: ; doors that can change state. Their door type numbers are >= 4.
                            	  6417: ;
                            	  6418: ; If this routine were ever called with a fixed door
                            	  6419: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6420: ; values for the door face.
                            	  6421: ;
                            	  6422: ;
                            	  6423: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6424: ;
                            	  6425:     even
                            	  6426: PrepareWriteHorizontalDoorTransferRecords:
02:00043CDE 102C0055        	  6427:     move.b  ($0055,A4),D0
02:00043CE2 19400002        	  6428:     move.b  D0,($0002,A4)
02:00043CE6 6100F9A4        	  6429:     jsr     FindDoorAttrByDoorBit
02:00043CEA 0C000005        	  6430:     cmpi.b  #$05,D0
02:00043CEE 650C            	  6431:     bcs  _anon_z05_125
02:00043CF0 1B00            	  6432:     move.b  D0,-(A5)  ; PHA
02:00043CF2 7004            	  6433:     moveq   #4,D0
02:00043CF4 4EB9000305FA    	  6434:     jsr     PlaySample
02:00043CFA 101D            	  6435:     move.b  (A5)+,D0  ; PLA
                            	  6436: _anon_z05_125:
                            	  6437:     ; Calculate the door face index in three parts.
                            	  6438:     ;
                            	  6439:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6440:     ; (provisional face index in Y register).
                            	  6441:     ;
02:00043CFC 0C000004        	  6442:     cmpi.b  #$04,D0
02:00043D00 6602            	  6443:     bne  _anon_z05_126
02:00043D02 7008            	  6444:     moveq   #8,D0
                            	  6445: _anon_z05_126:
02:00043D04 0C000001        	  6446:     cmpi.b  #$01,D0
02:00043D08 6602            	  6447:     bne  _anon_z05_127
02:00043D0A 7004            	  6448:     moveq   #4,D0
                            	  6449: _anon_z05_127:
                            	  6450:     ; Second, subtract 3 from provisional face index.
                            	  6451:     ;
02:00043D0C 003C0011        	  6452:     ori     #$11,CCR  ; SEC: set C+X
02:00043D10 123C0003        	  6453:     move.b  #$03,D1
02:00043D14 0A3C0010        	  6454:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043D18 9101            	  6455:     subx.b  D1,D0   ; SBC #$03
02:00043D1A 0A3C0010        	  6456:     eori    #$10,CCR  ; restore X = 6502 C
02:00043D1E 7600            	  6457:     moveq   #0,D3
02:00043D20 1600            	  6458:     move.b  D0,D3
                            	  6459:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6460:     ; face index >= 3, then subtract 1 from it.
                            	  6461:     ;
                            	  6462:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6463:     ; then make it 1.
                            	  6464:     ;
02:00043D22 102C0008        	  6465:     move.b  ($0008,A4),D0
02:00043D26 6708            	  6466:     beq  _anon_z05_128
02:00043D28 0C030005        	  6467:     cmpi.b  #$05,D3
02:00043D2C 670A            	  6468:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D2E 7601            	  6469:     moveq   #1,D3
                            	  6470: _anon_z05_128:
02:00043D30 0C030003        	  6471:     cmpi.b  #$03,D3
02:00043D34 6502            	  6472:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043D36 5303            	  6473:     subq.b  #1,D3
                            	  6474:     even
                            	  6475: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6476:     ; The routine that returned the door type also returned its
                            	  6477:     ; reverse direction index in [03].
                            	  6478:     ;
                            	  6479:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6480:     ;
02:00043D38 7003            	  6481:     moveq   #3,D0
02:00043D3A 003C0011        	  6482:     ori     #$11,CCR  ; SEC: set C+X
02:00043D3E 122C0003        	  6483:     move.b  ($0003,A4),D1
