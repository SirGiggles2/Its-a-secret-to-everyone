02:0003E036 41F90003E00C    	 10297:     lea     (GohmaLegOffsetsX).l,A0
02:0003E03C 12303000        	 10298:     move.b  (A0,D3.W),D1
02:0003E040 D101            	 10299:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E042 1880            	 10300:     move.b  D0,($0000,A4)
                            	 10301:     ; The object's Y is the sprite's.
                            	 10302:     ;
02:0003E044 41EC0084        	 10303:     lea     ($0084,A4),A0
02:0003E048 10302000        	 10304:     move.b  (A0,D2.W),D0
02:0003E04C 19400001        	 10305:     move.b  D0,($0001,A4)
02:0003E050 612A            	 10306:     jsr     Gohma_SetSpriteAttributes
                            	 10307:     ; There are only two frame images for legs: left and right.
                            	 10308:     ; There are two animation frames. They are animated as follows:
                            	 10309:     ;
                            	 10310:     ; Frame 0:
                            	 10311:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10312:     ; horizontal flipping = frame number = 0
                            	 10313:     ; 
                            	 10314:     ; Frame 1:
                            	 10315:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10316:     ; horizontal flipping = frame number = 1
                            	 10317:     ;
02:0003E052 4EB90004D2D6    	 10318:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E058 1003            	 10319:     move.b  D3,D0
02:0003E05A 023C00EE        	 10320:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E05E 41EC03E4        	 10321:     lea     ($03E4,A4),A0
02:0003E062 12302000        	 10322:     move.b  (A0,D2.W),D1
02:0003E066 D101            	 10323:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E068 02000001        	 10324:     andi.b #$01,D0
02:0003E06C 023C00EE        	 10325:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E070 123C0004        	 10326:     move.b  #$04,D1
02:0003E074 D101            	 10327:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E076 4EF90003167C    	 10328:     jmp     DrawObjectNotMirrored
                            	 10329: 
