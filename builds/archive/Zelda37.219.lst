02:0003C86C 7600            	  7063:     moveq   #0,D3
02:0003C86E 162C0341        	  7064:     move.b  ($0341,A4),D3
02:0003C872 41F900031644    	  7065:     lea     (SpriteOffsets).l,A0
02:0003C878 10303000        	  7066:     move.b  (A0,D3.W),D0
02:0003C87C 7600            	  7067:     moveq   #0,D3
02:0003C87E 1600            	  7068:     move.b  D0,D3
02:0003C880 101D            	  7069:     move.b  (A5)+,D0  ; PLA
02:0003C882 41EC0201        	  7070:     lea     ($0201,A4),A0
02:0003C886 11803000        	  7071:     move.b  D0,(A0,D3.W)
02:0003C88A 1014            	  7072:     move.b  ($0000,A4),D0
02:0003C88C 41EC0203        	  7073:     lea     ($0203,A4),A0
02:0003C890 11803000        	  7074:     move.b  D0,(A0,D3.W)
02:0003C894 102C0001        	  7075:     move.b  ($0001,A4),D0
02:0003C898 4EF9000319C2    	  7076:     jmp     Anim_EndWriteSprite
