                            	  6946:     even
                            	  6947: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6948:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6949:     ;   full heart=4 partial heart=$70
                            	  6950:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6951:     ; But the method here yields $3EF, because partial heart is
                            	  6952:     ; considered full when = $FF instead of $100.
                            	  6953:     ;
02:00031D36 102C000E        	  6954:     move.b  ($000E,A4),D0
02:00031D3A 003C0011        	  6955:     ori     #$11,CCR  ; SEC: set C+X
02:00031D3E 122C0670        	  6956:     move.b  ($0670,A4),D1
02:00031D42 0A3C0010        	  6957:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D46 9101            	  6958:     subx.b  D1,D0   ; SBC HeartPartial
02:00031D48 0A3C0010        	  6959:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D4C 1940000E        	  6960:     move.b  D0,($000E,A4)
02:00031D50 102C066F        	  6961:     move.b  ($066F,A4),D0
02:00031D54 0200000F        	  6962:     andi.b #$0F,D0
02:00031D58 6710            	  6963:     beq  _L_z01_Link_BeHarmed_HandleDied
