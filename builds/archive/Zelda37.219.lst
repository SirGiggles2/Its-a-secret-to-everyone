                            	  8555:     even
                            	  8556: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8557:     ; If the teleporting distance remaining is even, then draw
                            	  8558:     ; and check collisions, else return.
                            	  8559:     ;
                            	  8560:     ; This means that when 0, the monster is walking.
                            	  8561:     ; So, draw and check collisions every frame.
                            	  8562:     ;
                            	  8563:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8564:     ; translucently -- every other frame.
                            	  8565:     ;
02:0003D35C 41EC0394        	  8566:     lea     ($0394,A4),A0
02:0003D360 10302000        	  8567:     move.b  (A0,D2.W),D0
02:0003D364 E208            	  8568:     lsr.b  #1,D0   ; LSR A
02:0003D366 6402            	  8569:     bcc.s  __far_z_04_0076
02:0003D368 603A            	  8570:     jmp  L11E17_Exit
                            	  8571: __far_z_04_0076:
                            	  8572:     even
