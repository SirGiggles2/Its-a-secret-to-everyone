                            	  3621:     ; If facing down, then use frame image offset 2.
                            	  3622:     ;
02:0003AFC8 41EC0098        	  3623:     lea     ($0098,A4),A0
02:0003AFCC 10302000        	  3624:     move.b  (A0,D2.W),D0
02:0003AFD0 7600            	  3625:     moveq   #0,D3
02:0003AFD2 1600            	  3626:     move.b  D0,D3
02:0003AFD4 0200000C        	  3627:     andi.b #$0C,D0
02:0003AFD8 670C            	  3628:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AFDA 7002            	  3629:     moveq   #2,D0
