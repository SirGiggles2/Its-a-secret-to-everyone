                            	  4582: 
                            	  4583: ; Params:
                            	  4584: ; Y: middle speed index (4)
                            	  4585: ; [03]: horizontal distance
                            	  4586: ; [04]: vertical distance
                            	  4587: ; [0A]: vertical direction
                            	  4588: ; [0B]: horizontal direction
                            	  4589: ;
                            	  4590: ; Returns:
                            	  4591: ; Y: speed index (0 to 8) for the angle
                            	  4592: ;
                            	  4593: ;
                            	  4594: ; TODO: call it speed index or angle?
                            	  4595: ; Store the middle speed index in [00]. It will be changed to the
                            	  4596: ; right speed index to use incrementally.
                            	  4597: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4598: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4599: ;
                            	  4600:     even
                            	  4601: _CalcDiagonalSpeedIndex:
02:00030B58 1883            	  4602:     move.b  D3,($0000,A4)
                            	  4603:     ; Assuming horizontal distance >= vertical distance, the
                            	  4604:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4605:     ;
02:00030B5A 103C00FF        	  4606:     move.b  #$FF,D0
02:00030B5E 19400001        	  4607:     move.b  D0,($0001,A4)
                            	  4608:     ; TODO:
                            	  4609:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4610:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4611:     ;
                            	  4612:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4613:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4614:     ; of the farther distance faster.
                            	  4615:     ;
02:00030B62 102C0003        	  4616:     move.b  ($0003,A4),D0
02:00030B66 122C0004        	  4617:     move.b  ($0004,A4),D1
02:00030B6A B001            	  4618:     cmp.b   D1,D0
02:00030B6C 6416            	  4619:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030B6E 1B00            	  4620:     move.b  D0,-(A5)  ; PHA
02:00030B70 102C0004        	  4621:     move.b  ($0004,A4),D0
02:00030B74 19400003        	  4622:     move.b  D0,($0003,A4)
02:00030B78 101D            	  4623:     move.b  (A5)+,D0  ; PLA
02:00030B7A 19400004        	  4624:     move.b  D0,($0004,A4)
02:00030B7E 7001            	  4625:     moveq   #1,D0
02:00030B80 19400001        	  4626:     move.b  D0,($0001,A4)
                            	  4627:     even
                            	  4628: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4629:     ; TODO: call it speed index or angle?
                            	  4630:     ; If the difference in distances is within 8 pixels,
                            	  4631:     ; return the speed index (angle) we have.
                            	  4632:     ;
02:00030B84 102C0003        	  4633:     move.b  ($0003,A4),D0
02:00030B88 003C0011        	  4634:     ori     #$11,CCR  ; SEC: set C+X
02:00030B8C 122C0004        	  4635:     move.b  ($0004,A4),D1
02:00030B90 0A3C0010        	  4636:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B94 9101            	  4637:     subx.b  D1,D0   ; SBC $04
02:00030B96 0A3C0010        	  4638:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B9A 0C000008        	  4639:     cmpi.b  #$08,D0
02:00030B9E 6538            	  4640:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4641:     even
                            	  4642: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4643:     ; TODO: call it speed index or angle?
                            	  4644:     ; Otherwise, go to the next speed index (angle).
                            	  4645:     ;
02:00030BA0 1014            	  4646:     move.b  ($0000,A4),D0
02:00030BA2 023C00EE        	  4647:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030BA6 122C0001        	  4648:     move.b  ($0001,A4),D1
02:00030BAA D101            	  4649:     addx.b  D1,D0   ; ADC $01
02:00030BAC 1880            	  4650:     move.b  D0,($0000,A4)
                            	  4651:     ; TODO: call it speed index or angle?
                            	  4652:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4653:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4654:     ;
02:00030BAE 6728            	  4655:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030BB0 0C000008        	  4656:     cmpi.b  #$08,D0
02:00030BB4 6722            	  4657:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4658:     ; Subtract the lesser distance from the greater distance.
                            	  4659:     ; If they still haven't crossed, then we can turn more.
                            	  4660:     ;
02:00030BB6 102C0003        	  4661:     move.b  ($0003,A4),D0
02:00030BBA 003C0011        	  4662:     ori     #$11,CCR  ; SEC: set C+X
02:00030BBE 122C0004        	  4663:     move.b  ($0004,A4),D1
02:00030BC2 0A3C0010        	  4664:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030BC6 9101            	  4665:     subx.b  D1,D0   ; SBC $04
02:00030BC8 0A3C0010        	  4666:     eori    #$10,CCR  ; restore X = 6502 C
02:00030BCC 19400003        	  4667:     move.b  D0,($0003,A4)
02:00030BD0 122C0004        	  4668:     move.b  ($0004,A4),D1
02:00030BD4 B001            	  4669:     cmp.b   D1,D0
02:00030BD6 64C8            	  4670:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4671:     even
                            	  4672: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4673:     ; TODO: call it speed index or angle?
                            	  4674:     ; Return the speed index (angle) we found.
                            	  4675:     ;
02:00030BD8 7600            	  4676:     moveq   #0,D3
02:00030BDA 1614            	  4677:     move.b  ($0000,A4),D3
02:00030BDC 4E75            	  4678:     rts
