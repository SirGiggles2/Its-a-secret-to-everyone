                            	  1773: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_Reduce:
                            	  1774:     ; Store (HeartValues - 1 heart container) in [00].
                            	  1775:     ;
02:0002E7C2 102C066F        	  1776:     move.b  ($066F,A4),D0
02:0002E7C6 1B00            	  1777:     move.b  D0,-(A5)  ; PHA
02:0002E7C8 020000F0        	  1778:     andi.b #$F0,D0
02:0002E7CC 003C0011        	  1779:     ori     #$11,CCR  ; SEC: set C+X
02:0002E7D0 123C0010        	  1780:     move.b  #$10,D1
02:0002E7D4 0A3C0010        	  1781:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E7D8 9101            	  1782:     subx.b  D1,D0   ; SBC #$10
02:0002E7DA 0A3C0010        	  1783:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E7DE 1880            	  1784:     move.b  D0,($0000,A4)
                            	  1785:     ; Get (HeartValues - 1 heart)
                            	  1786:     ;
02:0002E7E0 101D            	  1787:     move.b  (A5)+,D0  ; PLA
02:0002E7E2 0200000F        	  1788:     andi.b #$0F,D0
02:0002E7E6 003C0011        	  1789:     ori     #$11,CCR  ; SEC: set C+X
02:0002E7EA 123C0001        	  1790:     move.b  #$01,D1
02:0002E7EE 0A3C0010        	  1791:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E7F2 9101            	  1792:     subx.b  D1,D0   ; SBC #$01
02:0002E7F4 0A3C0010        	  1793:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1794:     ; If the result is negative, then make the full hearts 0.
                            	  1795:     ;
02:0002E7F8 6A02            	  1796:     bpl  _anon_z01_19
02:0002E7FA 7000            	  1797:     moveq   #0,D0
