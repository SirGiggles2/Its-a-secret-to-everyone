02:0003DE4E 4EF90003167C    	 10033:     jmp     DrawObjectNotMirrored
                            	 10034: 
                            	 10035:     even
                            	 10036: UpdateGohma:
                            	 10037:     ; If flagged not to continue straight, then choose a random facing direction.
                            	 10038:     ;
02:0003DE54 41EC0451        	 10039:     lea     ($0451,A4),A0
02:0003DE58 10302000        	 10040:     move.b  (A0,D2.W),D0
02:0003DE5C 662C            	 10041:     bne  _L_z04_UpdateGohma_Move
                            	 10042:     ; If Random:
                            	 10043:     ;   >= $B0: right
                            	 10044:     ;   >= $60: left
                            	 10045:     ;   Else:   down
                            	 10046:     ;
02:0003DE5E 7001            	 10047:     moveq   #1,D0
02:0003DE60 7600            	 10048:     moveq   #0,D3
02:0003DE62 16342018        	 10049:     move.b  ($18,A4,D2.W),D3
02:0003DE66 0C0300B0        	 10050:     cmpi.b  #$B0,D3
02:0003DE6A 640A            	 10051:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE6C E308            	 10052:     lsl.b  #1,D0   ; ASL A
02:0003DE6E 0C030060        	 10053:     cmpi.b  #$60,D3
02:0003DE72 6402            	 10054:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE74 E308            	 10055:     lsl.b  #1,D0   ; ASL A
                            	 10056:     even
                            	 10057: _L_z04_UpdateGohma_ChangeDir:
02:0003DE76 41EC0098        	 10058:     lea     ($0098,A4),A0
02:0003DE7A 11802000        	 10059:     move.b  D0,(A0,D2.W)
                            	 10060:     ; Now we can go straight without changing direction for some time.
                            	 10061:     ;
02:0003DE7E 41EC0451        	 10062:     lea     ($0451,A4),A0
02:0003DE82 52302000        	 10063:     addq.b  #1,(A0,D2.W)
                            	 10064:     ; Go animate the eye.
