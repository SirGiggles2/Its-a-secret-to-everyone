02:0003DEA8 41EC0412        	 10084:     lea     ($0412,A4),A0
02:0003DEAC 52302000        	 10085:     addq.b  #1,(A0,D2.W)
                            	 10086:     ; Set a direction mask in [02], starting with right (1).
