                            	 13333: Ganon_CheckCollisions:
                            	 13334:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13335:     ; Store in [02] and [03].
                            	 13336:     ;
02:0003F684 10342070        	 13337:     move.b  ($70,A4,D2.W),D0
02:0003F688 023C00EE        	 13338:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F68C 123C0010        	 13339:     move.b  #$10,D1
02:0003F690 D101            	 13340:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F692 19400002        	 13341:     move.b  D0,($0002,A4)
02:0003F696 41EC0084        	 13342:     lea     ($0084,A4),A0
02:0003F69A 10302000        	 13343:     move.b  (A0,D2.W),D0
02:0003F69E 023C00EE        	 13344:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F6A2 123C0010        	 13345:     move.b  #$10,D1
02:0003F6A6 D101            	 13346:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F6A8 19400003        	 13347:     move.b  D0,($0003,A4)
                            	 13348:     ; Check for a collision with Link.
                            	 13349:     ;
                            	 13350:     ; We can't call CheckLinkCollision, because we need to
                            	 13351:     ; customize Ganon's midpoint.
                            	 13352:     ;
                            	 13353:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13354:     ; detection, if Link is invincible. Initialize variables that will
                            	 13355:     ; be returned from the partial collision check routine. Then
                            	 13356:     ; call it.
                            	 13357:     ;
02:0003F6AC 102C04F0        	 13358:     move.b  ($04F0,A4),D0
02:0003F6B0 6616            	 13359:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F6B2 19400006        	 13360:     move.b  D0,($0006,A4)
02:0003F6B6 19400009        	 13361:     move.b  D0,($0009,A4)
02:0003F6BA 1940000C        	 13362:     move.b  D0,($000C,A4)
02:0003F6BE 7600            	 13363:     moveq   #0,D3
02:0003F6C0 1883            	 13364:     move.b  D3,($0000,A4)
02:0003F6C2 4EB900031B78    	 13365:     jsr     CheckLinkCollisionPreinit
                            	 13366:     even
                            	 13367: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13368:     ; If Ganon is not in state 0, then he's brown.
                            	 13369:     ; Go check collision with an arrow.
                            	 13370:     ;
02:0003F6C8 41EC00AC        	 13371:     lea     ($00AC,A4),A0
02:0003F6CC 10302000        	 13372:     move.b  (A0,D2.W),D0
02:0003F6D0 6652            	 13373:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13374:     ; If timer <> 0, then Ganon is visible.
                            	 13375:     ; He can't be harmed like this. So, return.
                            	 13376:     ;
02:0003F6D2 10342028        	 13377:     move.b  ($28,A4,D2.W),D0
02:0003F6D6 664A            	 13378:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F6D8 760D            	 13379:     moveq   #13,D3
02:0003F6DA 4EB900032042    	 13380:     jsr     CheckMonsterSwordCollision
                            	 13381:     ; If Ganon has died according to the usual collision check rules
                            	 13382:     ; (HP = 0), then:
                            	 13383:     ; 1. Restore HP to the initial value $F0
                            	 13384:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13385:     ; 3. Change palette row 7 to make Ganon brown
                            	 13386:     ;
02:0003F6E0 41EC0405        	 13387:     lea     ($0405,A4),A0
02:0003F6E4 10302000        	 13388:     move.b  (A0,D2.W),D0
02:0003F6E8 6718            	 13389:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F6EA 103C00F0        	 13390:     move.b  #$F0,D0
02:0003F6EE 41EC0485        	 13391:     lea     ($0485,A4),A0
02:0003F6F2 11802000        	 13392:     move.b  D0,(A0,D2.W)
02:0003F6F6 41EC00AC        	 13393:     lea     ($00AC,A4),A0
02:0003F6FA 53302000        	 13394:     subq.b  #1,(A0,D2.W)
02:0003F6FE 61000084        	 13395:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13396:     even
                            	 13397: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13398:     ; If Ganon was harmed, then play the sound effect
                            	 13399:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13400:     ;
02:0003F702 41EC04F0        	 13401:     lea     ($04F0,A4),A0
02:0003F706 10302000        	 13402:     move.b  (A0,D2.W),D0
02:0003F70A 670A            	 13403:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F70C 6100A03A        	 13404:     jsr     PlayBossHitCryIfNeeded
02:0003F710 7040            	 13405:     moveq   #64,D0
02:0003F712 19802028        	 13406:     move.b  D0,($28,A4,D2.W)
                            	 13407:     even
                            	 13408: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13409:     ; Reset metastate, because Ganon cannot die this way.
                            	 13410:     ;
02:0003F716 4EB90004DB0C    	 13411:     jsr     ResetObjMetastate
                            	 13412:     ; Reset shove info and invincibility timer, because Ganon
                            	 13413:     ; doesn't react at all as a usual monster.
                            	 13414:     ;
02:0003F71C 4EB900031F4A    	 13415:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13416:     even
                            	 13417: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F722 4E75            	 13418:     rts
                            	 13419: 
                            	 13420:     even
                            	 13421: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13422:     ; If the silver arrow is not in the inventory, then return.
                            	 13423:     ;
