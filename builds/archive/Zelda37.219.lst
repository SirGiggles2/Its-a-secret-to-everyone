02:0003F2E8 600000A4        	 12843:     jmp  Ganon_Dying
                            	 12844: __far_z_04_0129:
02:0003F2EC 61000396        	 12845:     jsr     Ganon_CheckCollisions
02:0003F2F0 6100A456        	 12846:     jsr     PlayBossHitCryIfNeeded
                            	 12847:     ; Go handle the brown state specially.
                            	 12848:     ;
02:0003F2F4 41EC00AC        	 12849:     lea     ($00AC,A4),A0
