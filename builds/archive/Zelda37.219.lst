02:0004D73E 142C0340        	  7584:     move.b  ($0340,A4),D2
                            	  7585:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7586:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7587:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7588:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7589:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7590:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7591:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7592:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7593:     ; corrupting them and causing a deterministic address-error
                            	  7594:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7595:     ; identified by Codex static review.)
                            	  7596: _L_z07_P47_pre_check:
02:0004D742 102C0525        	  7597:     move.b  ($0525,A4),D0
02:0004D746 020000F0        	  7598:     andi.b  #$F0,D0
