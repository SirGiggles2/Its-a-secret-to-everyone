02:0003A576 162C000D        	  2165:     move.b  ($000D,A4),D3
02:0003A57A 10343018        	  2166:     move.b  ($18,A4,D3.W),D0
02:0003A57E 020000F0        	  2167:     andi.b #$F0,D0
02:0003A582 19802070        	  2168:     move.b  D0,($70,A4,D2.W)
02:0003A586 6748            	  2169:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A588 0C0000F0        	  2170:     cmpi.b  #$F0,D0
02:0003A58C 6742            	  2171:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2172:     ; Turn the random value into a $10 pixel aligned Y coordinate.
