                            	  7948: _L_z04_UpdatePolsVoice_State0:
                            	  7949:     ; State 0. Walking.
                            	  7950:     ;
                            	  7951:     ; If grid offset = 0, then no more distance to cover.
                            	  7952:     ; So, go change to state 1 -- jumping.
                            	  7953:     ;
02:0003CE76 41EC0394        	  7954:     lea     ($0394,A4),A0
02:0003CE7A 10302000        	  7955:     move.b  (A0,D2.W),D0
02:0003CE7E 67000084        	  7956:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7957:     ; Decrement grid offset / distance remaining.
                            	  7958:     ;
02:0003CE82 41EC0394        	  7959:     lea     ($0394,A4),A0
02:0003CE86 53302000        	  7960:     subq.b  #1,(A0,D2.W)
                            	  7961:     ; Move vertically.
                            	  7962:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7963:     ;
02:0003CE8A 41EC0084        	  7964:     lea     ($0084,A4),A0
02:0003CE8E 10302000        	  7965:     move.b  (A0,D2.W),D0
02:0003CE92 023C00EE        	  7966:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE96 41F90003CE26    	  7967:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE9C 12303000        	  7968:     move.b  (A0,D3.W),D1
02:0003CEA0 D101            	  7969:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CEA2 41EC0084        	  7970:     lea     ($0084,A4),A0
02:0003CEA6 11802000        	  7971:     move.b  D0,(A0,D2.W)
                            	  7972:     even
                            	  7973: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7974:     ; If the square the monster is over is walkable, then
                            	  7975:     ; go draw and check object collisions.
                            	  7976:     ;
02:0003CEAA 610001F4        	  7977:     jsr     PolsVoice_IsSquareWalkable
02:0003CEAE 6452            	  7978:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7979:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7980:     ; then go change to state 1.
                            	  7981:     ;
02:0003CEB0 41EC041F        	  7982:     lea     ($041F,A4),A0
02:0003CEB4 10302000        	  7983:     move.b  (A0,D2.W),D0
02:0003CEB8 020000FC        	  7984:     andi.b #$FC,D0
02:0003CEBC 0C0000B0        	  7985:     cmpi.b  #$B0,D0
02:0003CEC0 6742            	  7986:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CEC2 0C0000F4        	  7987:     cmpi.b  #$F4,D0
02:0003CEC6 643C            	  7988:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7989:     ; Else blocked by something else.
                            	  7990:     ;
                            	  7991:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7992:     ;
02:0003CEC8 41EC0098        	  7993:     lea     ($0098,A4),A0
02:0003CECC 10302000        	  7994:     move.b  (A0,D2.W),D0
02:0003CED0 02000003        	  7995:     andi.b #$03,D0
02:0003CED4 6618            	  7996:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7997:     ; Else facing vertically. Flip the direction.
                            	  7998:     ; Go draw.
                            	  7999:     ;
02:0003CED6 41EC0098        	  8000:     lea     ($0098,A4),A0
02:0003CEDA 10302000        	  8001:     move.b  (A0,D2.W),D0
02:0003CEDE 0A00000C        	  8002:     eori.b #$0C,D0
02:0003CEE2 41EC0098        	  8003:     lea     ($0098,A4),A0
02:0003CEE6 11802000        	  8004:     move.b  D0,(A0,D2.W)
02:0003CEEA 6000008C        	  8005:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  8006: 
                            	  8007:     even
                            	  8008: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  8009:     ; Facing horizontally. Flip the direction.
                            	  8010:     ; Move two pixels, and go draw.
                            	  8011:     ;
02:0003CEEE 0A000003        	  8012:     eori.b #$03,D0
02:0003CEF2 41EC0098        	  8013:     lea     ($0098,A4),A0
02:0003CEF6 11802000        	  8014:     move.b  D0,(A0,D2.W)
02:0003CEFA 61000210        	  8015:     jsr     PolsVoice_MoveX
02:0003CEFE 6100020C        	  8016:     jsr     PolsVoice_MoveX
                            	  8017:     even
                            	  8018: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003CF02 6074            	  8019:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  8020: 
                            	  8021:     even
                            	  8022: _L_z04_UpdatePolsVoice_SetState1:
                            	  8023:     ; If already in state 1, then go draw and check collisions.
                            	  8024:     ;
02:0003CF04 41EC00AC        	  8025:     lea     ($00AC,A4),A0
02:0003CF08 10302000        	  8026:     move.b  (A0,D2.W),D0
02:0003CF0C 6702            	  8027:     beq.s  __far_z_04_0074
02:0003CF0E 6068            	  8028:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  8029: __far_z_04_0074:
                            	  8030:     ; Go to state 1.
                            	  8031:     ;
02:0003CF10 41EC00AC        	  8032:     lea     ($00AC,A4),A0
02:0003CF14 52302000        	  8033:     addq.b  #1,(A0,D2.W)
                            	  8034:     ; Subtract 1 from facing direction to make an index.
                            	  8035:     ;
02:0003CF18 7600            	  8036:     moveq   #0,D3
02:0003CF1A 41EC0098        	  8037:     lea     ($0098,A4),A0
02:0003CF1E 16302000        	  8038:     move.b  (A0,D2.W),D3
02:0003CF22 5303            	  8039:     subq.b  #1,D3
                            	  8040:     ; If Y coordinate < $78, make the index 3 for down.
                            	  8041:     ;
02:0003CF24 41EC0084        	  8042:     lea     ($0084,A4),A0
02:0003CF28 10302000        	  8043:     move.b  (A0,D2.W),D0
02:0003CF2C 0C000078        	  8044:     cmpi.b  #$78,D0
02:0003CF30 6402            	  8045:     bcc  _anon_z04_97
02:0003CF32 7603            	  8046:     moveq   #3,D3
                            	  8047: _anon_z04_97:
                            	  8048:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  8049:     ;
02:0003CF34 0C0000A8        	  8050:     cmpi.b  #$A8,D0
02:0003CF38 6502            	  8051:     bcs  _anon_z04_98
02:0003CF3A 7607            	  8052:     moveq   #7,D3
                            	  8053: _anon_z04_98:
                            	  8054:     ; Set the vertical speed for the beginning of the jump.
                            	  8055:     ;
02:0003CF3C 41F90003CE30    	  8056:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF42 10303000        	  8057:     move.b  (A0,D3.W),D0
02:0003CF46 41EC0412        	  8058:     lea     ($0412,A4),A0
02:0003CF4A 11802000        	  8059:     move.b  D0,(A0,D2.W)
                            	  8060:     ; Look up the Y offset for the current direction.
                            	  8061:     ; Add it to object Y to set the destination Y of the jump.
                            	  8062:     ;
02:0003CF4E 41EC0084        	  8063:     lea     ($0084,A4),A0
02:0003CF52 10302000        	  8064:     move.b  (A0,D2.W),D0
02:0003CF56 023C00EE        	  8065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF5A 41F90003CE38    	  8066:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF60 12303000        	  8067:     move.b  (A0,D3.W),D1
02:0003CF64 D101            	  8068:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF66 41EC042C        	  8069:     lea     ($042C,A4),A0
02:0003CF6A 11802000        	  8070:     move.b  D0,(A0,D2.W)
                            	  8071:     ; Turn the index into a direction again by adding 1.
                            	  8072:     ; Store the facing direction.
                            	  8073:     ;
02:0003CF6E 5203            	  8074:     addq.b  #1,D3
02:0003CF70 41EC0098        	  8075:     lea     ($0098,A4),A0
02:0003CF74 11832000        	  8076:     move.b  D3,(A0,D2.W)
                            	  8077:     even
                            	  8078: L_PolsVoice_DrawAndCheckCollisions:
02:0003CF78 7008            	  8079:     moveq   #8,D0
02:0003CF7A 4EB90004D2FE    	  8080:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003CF80 41EC03E4        	  8081:     lea     ($03E4,A4),A0
02:0003CF84 10302000        	  8082:     move.b  (A0,D2.W),D0
02:0003CF88 4EB900031678    	  8083:     jsr     DrawObjectMirrored
                            	  8084:     ; Pols Voice is invincible to everything but the sword,
                            	  8085:     ; during normal collision detection.
                            	  8086:     ;
                            	  8087:     ; The arrow is a special case.
                            	  8088:     ;
02:0003CF8E 103C00FE        	  8089:     move.b  #$FE,D0
02:0003CF92 41EC04B2        	  8090:     lea     ($04B2,A4),A0
02:0003CF96 11802000        	  8091:     move.b  D0,(A0,D2.W)
02:0003CF9A 4EB9000319F8    	  8092:     jsr     CheckMonsterCollisions
02:0003CFA0 4E75            	  8093:     rts
