02:0004D74E 6506            	  7600:     blo     _L_z07_P47_pre_snap
02:0004D750 0C0000E0        	  7601:     cmpi.b  #$E0,D0
02:0004D754 6506            	  7602:     blo     _L_z07_P47_pre_ok
                            	  7603: _L_z07_P47_pre_snap:
02:0004D756 197C00480525    	  7604:     move.b  #$48,($0525,A4)
