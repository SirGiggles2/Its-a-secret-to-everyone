                            	  7247: __far_z_04_0065:
                            	  7248:     ; New bloated substate >= 2.
                            	  7249:     ;
                            	  7250:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7251:     ; which will transition to state 0 (moving).
                            	  7252:     ;
                            	  7253:     ; Note that if the bomb hits >= 2, then:
                            	  7254:     ; - If new substate = 2, then substate 2 will wait,
                            	  7255:     ;   and then transition to substate 3.
                            	  7256:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7257:     ;
02:0003C9DE 7600            	  7258:     moveq   #0,D3
02:0003C9E0 41EC0437        	  7259:     lea     ($0437,A4),A0
02:0003C9E4 16302000        	  7260:     move.b  (A0,D2.W),D3
