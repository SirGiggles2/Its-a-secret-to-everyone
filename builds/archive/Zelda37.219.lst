02:00031CB8 162C0662        	  6894:     move.b  ($0662,A4),D3
02:00031CBC 6718            	  6895:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  6896: _anon_z01_86:
02:00031CBE 122C000D        	  6897:     move.b  ($000D,A4),D1
