                            	  9833:     ; Also set its timer to $10.
                            	  9834:     ;
02:0003DCBA 61001B9C        	  9835:     jsr     PlayBossDeathCry
02:0003DCBE 705D            	  9836:     moveq   #93,D0
02:0003DCC0 19400354        	  9837:     move.b  D0,($0354,A4)
02:0003DCC4 7010            	  9838:     moveq   #16,D0
02:0003DCC6 1940040A        	  9839:     move.b  D0,($040A,A4)
02:0003DCCA 1940002D        	  9840:     move.b  D0,($002D,A4)
                            	  9841:     even
