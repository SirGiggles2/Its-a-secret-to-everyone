                            	  5904:     ; This segment is dead. We'll swap the tail segment with this
                            	  5905:     ; dead segment. This way, moldorm heads are always rooted
                            	  5906:     ; in slots 5 and $A; and the segments are continguous.
                            	  5907:     ;
                            	  5908:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5909:     ;
