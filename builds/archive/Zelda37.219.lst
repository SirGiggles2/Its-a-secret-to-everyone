                            	  6109: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6110:     ; Copy old direction from a higher slot to the lower one;
                            	  6111:     ; and to the lower one's facing direction.
                            	  6112:     ;
02:0003C15A 41EC0382        	  6113:     lea     ($0382,A4),A0
02:0003C15E 10303000        	  6114:     move.b  (A0,D3.W),D0
02:0003C162 41EC0381        	  6115:     lea     ($0381,A4),A0
