02:0004CBD0 0C000008        	  6106:     cmpi.b  #$08,D0
02:0004CBD4 6706            	  6107:     beq  _anon_z07_31
02:0004CBD6 7600            	  6108:     moveq   #0,D3
02:0004CBD8 162C0675        	  6109:     move.b  ($0675,A4),D3
