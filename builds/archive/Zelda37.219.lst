02:0003F35C E208            	 12923:     lsr.b  #1,D0   ; LSR A
02:0003F35E 6410            	 12924:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003F360 41EC00AC        	 12925:     lea     ($00AC,A4),A0
02:0003F364 53302000        	 12926:     subq.b  #1,(A0,D2.W)
                            	 12927:     ; If the state becomes 0, then Ganon is blue again.
                            	 12928:     ; Go switch his palette row to reflect it.
