                            	  6006: Moldorm_ChangeFlyingState:
                            	  6007:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  6008:     ;
02:0003C0F2 61000096        	  6009:     jsr     Flyer_MoldormDecideState
02:0003C0F6 7010            	  6010:     moveq   #16,D0
02:0003C0F8 19802028        	  6011:     move.b  D0,($28,A4,D2.W)
                            	  6012:     ; If the next lower slot's direction <> 0, then
                            	  6013:     ; go propagate direction changes down the chain.
                            	  6014:     ;
                            	  6015:     ; But you had to have propagated directions once for the
                            	  6016:     ; next lower direction to be set. How does it happen?
                            	  6017:     ;
                            	  6018:     ; Within a flyer state, the flying routines turn the flyer
                            	  6019:     ; and set the object timer to $10 several times. After any of
                            	  6020:     ; those times will the test succeed.
                            	  6021:     ;
                            	  6022:     ; When a flying state ends, timer will be 0, triggering the code
                            	  6023:     ; in this block to set the timer to $10, and try to propagate
                            	  6024:     ; directions.
                            	  6025:     ;
                            	  6026:     ; But this is also the case the first time here.
                            	  6027:     ;
                            	  6028:     ; So, I believe that the point of this test is to delay moving
                            	  6029:     ; the lower (not head) segments when starting out.
                            	  6030:     ;
02:0003C0FC 41EC0097        	  6031:     lea     ($0097,A4),A0
02:0003C100 10302000        	  6032:     move.b  (A0,D2.W),D0
02:0003C104 6702            	  6033:     beq.s  __far_z_04_0046
02:0003C106 601C            	  6034:     jmp  Moldorm_PropagateDirs
                            	  6035: __far_z_04_0046:
02:0003C108 4E75            	  6036:     rts
                            	  6037: 
                            	  6038:     even
                            	  6039: Moldorm_Wander:
                            	  6040:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6041:     ; Only the head controls the movement direction.
                            	  6042:     ;
02:0003C10A 0C020005        	  6043:     cmpi.b  #$05,D2
02:0003C10E 6708            	  6044:     beq  _anon_z04_82
02:0003C110 0C02000A        	  6045:     cmpi.b  #$0A,D2
02:0003C114 6702            	  6046:     beq.s  __far_z_04_0047
02:0003C116 6070            	  6047:     jmp  L1156B_Exit
                            	  6048: __far_z_04_0047:
                            	  6049: _anon_z04_82:
                            	  6050:     ; Turn randomly while flying, as usual.
                            	  6051:     ;
02:0003C118 61003D9A        	  6052:     jsr     Flyer_Wander
                            	  6053:     ; After every turn, the common flyer routines set timer to $10.
                            	  6054:     ; This can be used as a signal for moldorm to propagate
                            	  6055:     ; direction changes down the chain.
                            	  6056:     ;
                            	  6057:     ; Between each turn, timer <> $10.
                            	  6058:     ;
                            	  6059:     ; At the end of the delay after the last turn, timer = 0.
                            	  6060:     ; This is a signal that that flying state ended, and a new one
                            	  6061:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6062:     ; we can propagate direction changes again; and start
                            	  6063:     ; a new flying interval by setting timer to $10. This will make
                            	  6064:     ; the next flying state delay that amount of time before turning
                            	  6065:     ; the first time.
                            	  6066:     ;
                            	  6067:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6068:     ; arm the timer again, and shift directions down the chain.
                            	  6069:     ;
02:0003C11C 10342028        	  6070:     move.b  ($28,A4,D2.W),D0
02:0003C120 6602            	  6071:     bne.s  __far_z_04_0048
02:0003C122 60CE            	  6072:     jmp  Moldorm_ChangeFlyingState
                            	  6073: __far_z_04_0048:
                            	  6074:     even
                            	  6075: Moldorm_PropagateDirs:
                            	  6076:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6077:     ;
02:0003C124 10342028        	  6078:     move.b  ($28,A4,D2.W),D0
02:0003C128 0C000010        	  6079:     cmpi.b  #$10,D0
02:0003C12C 6702            	  6080:     beq.s  __far_z_04_0049
02:0003C12E 6058            	  6081:     jmp  L1156B_Exit
