02:0003F254 102C0028        	 12740:     move.b  ($0028,A4),D0
02:0003F258 6644            	 12741:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12742:     ; Once the timer expires, it's time to brighten the room.
                            	 12743:     ;
                            	 12744:     ; Save the current object slot.
02:0003F25A 1002            	 12745:     move.b  D2,D0
02:0003F25C 1B00            	 12746:     move.b  D0,-(A5)  ; PHA
02:0003F25E 61000914        	 12747:     jsr     UpdateCandle
02:0003F262 101D            	 12748:     move.b  (A5)+,D0  ; PLA
02:0003F264 7400            	 12749:     moveq   #0,D2
02:0003F266 1400            	 12750:     move.b  D0,D2
                            	 12751:     ; Turn off the room brightening flag, because we're controlling it
                            	 12752:     ; here instead of in the Mode 5 object update loop.
                            	 12753:     ;
02:0003F268 7000            	 12754:     moveq   #0,D0
02:0003F26A 1940051E        	 12755:     move.b  D0,($051E,A4)
                            	 12756:     ; On the first frame of the fade-to-light cycle, play the
                            	 12757:     ; Triforce/Ganon song.
                            	 12758:     ;
02:0003F26E 102C051C        	 12759:     move.b  ($051C,A4),D0
02:0003F272 0C0000C0        	 12760:     cmpi.b  #$C0,D0
02:0003F276 6606            	 12761:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F278 7002            	 12762:     moveq   #2,D0
02:0003F27A 19400600        	 12763:     move.b  D0,($0600,A4)
                            	 12764:     even
                            	 12765: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12766:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12767:     ;
02:0003F27E 102C051C        	 12768:     move.b  ($051C,A4),D0
02:0003F282 0200000F        	 12769:     andi.b #$0F,D0
02:0003F286 0C000004        	 12770:     cmpi.b  #$04,D0
02:0003F28A 6702            	 12771:     beq.s  __far_z_04_0126
02:0003F28C 6042            	 12772:     jmp  Ganon_DrawBodyFrame0
