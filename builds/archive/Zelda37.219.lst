02:0004129E 61003A3C        	  1940:     jsr     SetupObjRoomBounds
                            	  1941:     ; Set current object slot variable to $B, to be ready for the
                            	  1942:     ; first frame of mode 5. So, that it begins updating objects
                            	  1943:     ; at slot $B.
                            	  1944:     ;
02:000412A2 740B            	  1945:     moveq   #11,D2
02:000412A4 19420340        	  1946:     move.b  D2,($0340,A4)
                            	  1947: _anon_z05_46:
