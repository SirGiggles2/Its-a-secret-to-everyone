                            	 10157: _L_z04_UpdateGohma_AnimateEye:
                            	 10158:     ; Animate the eye.
                            	 10159:     ;
                            	 10160:     ; First, if the counter for when to open the eye next = 0, then
                            	 10161:     ; set it to a random value at least $C0; and set the timer for
                            	 10162:     ; keeping the eye open to $80.
                            	 10163:     ;
                            	 10164:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10165:     ; every other frame.
                            	 10166:     ;
02:0003DF4E 41EC042C        	 10167:     lea     ($042C,A4),A0
02:0003DF52 10302000        	 10168:     move.b  (A0,D2.W),D0
02:0003DF56 661E            	 10169:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF58 103C0080        	 10170:     move.b  #$80,D0
02:0003DF5C 41EC0444        	 10171:     lea     ($0444,A4),A0
02:0003DF60 11802000        	 10172:     move.b  D0,(A0,D2.W)
02:0003DF64 103C00C0        	 10173:     move.b  #$C0,D0
02:0003DF68 12342018        	 10174:     move.b  ($18,A4,D2.W),D1
02:0003DF6C 8001            	 10175:     or.b  D1,D0
02:0003DF6E 41EC042C        	 10176:     lea     ($042C,A4),A0
02:0003DF72 11802000        	 10177:     move.b  D0,(A0,D2.W)
                            	 10178:     even
