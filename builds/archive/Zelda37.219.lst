02:0004B186 7400            	  2354:     moveq   #0,D2
02:0004B188 142C0301        	  2355:     move.b  ($0301,A4),D2
                            	  2356:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2357:     ;
                            	  2358:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2359:     ; In total, 11 bytes will be written.
                            	  2360:     ;
                            	  2361:     ; First, write the high byte of PPU address in each record.
                            	  2362:     ;
02:0004B18C 1014            	  2363:     move.b  ($0000,A4),D0
02:0004B18E 41EC0302        	  2364:     lea     ($0302,A4),A0
02:0004B192 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:0004B196 41EC0307        	  2366:     lea     ($0307,A4),A0
02:0004B19A 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; Write the low address in the first record. In the second record,
                            	  2369:     ; write (low address + 1).
                            	  2370:     ;
02:0004B19E 102C0001        	  2371:     move.b  ($0001,A4),D0
02:0004B1A2 41EC0303        	  2372:     lea     ($0303,A4),A0
02:0004B1A6 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B1AA 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B1AE 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004B1B2 41EC0308        	  2376:     lea     ($0308,A4),A0
02:0004B1B6 52302000        	  2377:     addq.b  #1,(A0,D2.W)
