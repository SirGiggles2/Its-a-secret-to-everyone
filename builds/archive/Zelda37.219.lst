02:00030330 41EC0098        	  3332:     lea     ($0098,A4),A0
02:00030334 10302000        	  3333:     move.b  (A0,D2.W),D0
02:00030338 61000778        	  3334:     jsr     GetOppositeDir
02:0003033C 41EC0098        	  3335:     lea     ($0098,A4),A0
02:00030340 11802000        	  3336:     move.b  D0,(A0,D2.W)
02:00030344 7020            	  3337:     moveq   #32,D0
02:00030346 41EC03BC        	  3338:     lea     ($03BC,A4),A0
02:0003034A 11802000        	  3339:     move.b  D0,(A0,D2.W)
02:0003034E 41EC00AC        	  3340:     lea     ($00AC,A4),A0
02:00030352 52302000        	  3341:     addq.b  #1,(A0,D2.W)
                            	  3342:     even
