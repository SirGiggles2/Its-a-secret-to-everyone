                            	  6571: Digdogger_Move:
                            	  6572:     ; This calculation is the same one used in Manhandla to
                            	  6573:     ; manifest the fractional speed over several frames.
                            	  6574:     ;
                            	  6575:     ; To summarize, the formula is:
                            	  6576:     ;
                            	  6577:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6578:     ;
                            	  6579:     ;   SA := SA + (SL AND $E0)
                            	  6580:     ;   [03] := SH + carry
                            	  6581:     ;
                            	  6582:     ; See 04:A28E Manhandla_Move.
                            	  6583:     ;
02:0003C4C6 41EC041F        	  6584:     lea     ($041F,A4),A0
02:0003C4CA 10302000        	  6585:     move.b  (A0,D2.W),D0
02:0003C4CE 020000E0        	  6586:     andi.b #$E0,D0
02:0003C4D2 023C00EE        	  6587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4D6 41EC0412        	  6588:     lea     ($0412,A4),A0
02:0003C4DA 12302000        	  6589:     move.b  (A0,D2.W),D1
02:0003C4DE D101            	  6590:     addx.b  D1,D0   ; ADC $0412,X
02:0003C4E0 41EC0412        	  6591:     lea     ($0412,A4),A0
02:0003C4E4 11802000        	  6592:     move.b  D0,(A0,D2.W)
                            	  6593:     ; Assign (high speed byte + carry) to [03].
                            	  6594:     ;
02:0003C4E8 41EC042C        	  6595:     lea     ($042C,A4),A0
02:0003C4EC 10302000        	  6596:     move.b  (A0,D2.W),D0
02:0003C4F0 123C0000        	  6597:     move.b  #$00,D1
02:0003C4F4 D101            	  6598:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C4F6 19400003        	  6599:     move.b  D0,($0003,A4)
                            	  6600:     ; Change coordinates by the speed amount/offset in [03]
                            	  6601:     ; according to the direction.
                            	  6602:     ;
                            	  6603:     ; Start with a mask of $A1 in [02]:
                            	  6604:     ; - low nibble represents the right direction
                            	  6605:     ; - high nibble is used to set or clear carry as we go along
                            	  6606:     ;
02:0003C4FA 103C00A1        	  6607:     move.b  #$A1,D0
02:0003C4FE 19400002        	  6608:     move.b  D0,($0002,A4)
                            	  6609:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6610:     ;
02:0003C502 41EC0098        	  6611:     lea     ($0098,A4),A0
02:0003C506 10302000        	  6612:     move.b  (A0,D2.W),D0
02:0003C50A 122C0002        	  6613:     move.b  ($0002,A4),D1
02:0003C50E C200            	  6614:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C510 6712            	  6615:     beq  _L_z04_Digdogger_Move_Left
02:0003C512 10342070        	  6616:     move.b  ($70,A4,D2.W),D0
02:0003C516 023C00EE        	  6617:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C51A 122C0003        	  6618:     move.b  ($0003,A4),D1
02:0003C51E D101            	  6619:     addx.b  D1,D0   ; ADC $03
02:0003C520 19802070        	  6620:     move.b  D0,($70,A4,D2.W)
                            	  6621:     even
