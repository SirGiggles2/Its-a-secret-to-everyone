                            	  7046:     even
                            	  7047: CheckMonsterWeaponCollision:
02:00031DD4 19400005        	  7048:     move.b  D0,($0005,A4)
                            	  7049:     ; Reset [06] for no collision.
                            	  7050:     ;
02:00031DD8 7000            	  7051:     moveq   #0,D0
02:00031DDA 19400006        	  7052:     move.b  D0,($0006,A4)
                            	  7053:     ; If the weapon's not active (state = 0), then return.
                            	  7054:     ;
