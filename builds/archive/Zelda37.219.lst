02:00030790 0A3C0010        	  4023:     eori    #$10,CCR  ; restore X = 6502 C
02:00030794 1880            	  4024:     move.b  D0,($0000,A4)
02:00030796 101D            	  4025:     move.b  (A5)+,D0  ; PLA
02:00030798 E208            	  4026:     lsr.b  #1,D0   ; LSR A
