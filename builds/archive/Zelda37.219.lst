                            	  7001: CheckMonsterBoomerangOrFoodCollision:
02:00031D92 41EC00AC        	  7002:     lea     ($00AC,A4),A0
02:00031D96 10303000        	  7003:     move.b  (A0,D3.W),D0
02:00031D9A E308            	  7004:     lsl.b  #1,D0   ; ASL A
02:00031D9C 65F2            	  7005:     bcs  _anon_z01_87
02:00031D9E 1883            	  7006:     move.b  D3,($0000,A4)
                            	  7007:     ; Set boomerang damage type (2) in [09].
                            	  7008:     ;
