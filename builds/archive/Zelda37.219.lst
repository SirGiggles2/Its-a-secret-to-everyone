                            	 14382: TurnTowardsPlayer8:
                            	 14383:     ; Build a direction in [00] towards the player.
                            	 14384:     ;
                            	 14385:     ; First, calculate a horizontal component:
                            	 14386:     ;
                            	 14387:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14388:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14389:     ; else                               [00] := 2 (left)
                            	 14390:     ;
02:0003FDF6 7600            	 14391:     moveq   #0,D3
02:0003FDF8 1883            	 14392:     move.b  D3,($0000,A4)
02:0003FDFA 5203            	 14393:     addq.b  #1,D3
02:0003FDFC 102C0061        	 14394:     move.b  ($0061,A4),D0
02:0003FE00 12342070        	 14395:     move.b  ($70,A4,D2.W),D1
02:0003FE04 B001            	 14396:     cmp.b   D1,D0
02:0003FE06 6706            	 14397:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003FE08 6402            	 14398:     bcc  _anon_z04_175
02:0003FE0A 5203            	 14399:     addq.b  #1,D3
                            	 14400: _anon_z04_175:
02:0003FE0C 1883            	 14401:     move.b  D3,($0000,A4)
                            	 14402:     even
                            	 14403: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 14404:     ; Second, calculate a vertical component.
                            	 14405:     ; Combine it with the horizontal component:
                            	 14406:     ;
                            	 14407:     ; Y := 4 (down)
                            	 14408:     ; if observed player Y <> object Y then
                            	 14409:     ;   if observed player Y < object Y then
                            	 14410:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 14411:     ;   [00] := [00] | Y
                            	 14412:     ;
02:0003FE0E 7601            	 14413:     moveq   #1,D3
02:0003FE10 102C0062        	 14414:     move.b  ($0062,A4),D0
02:0003FE14 41EC0084        	 14415:     lea     ($0084,A4),A0
02:0003FE18 12302000        	 14416:     move.b  (A0,D2.W),D1
02:0003FE1C B001            	 14417:     cmp.b   D1,D0
