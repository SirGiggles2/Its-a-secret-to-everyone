                            	  1925: _L_z01_CopyCommonCodeToRam_Loop:
02:0002E90E 1214            	  1926:     move.b  ($00,A4),D1   ; ptr lo
02:0002E910 182C0001        	  1927:     move.b  ($01,A4),D4  ; ptr hi
02:0002E914 024100FF        	  1928:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E918 E14C            	  1929:     lsl.w   #8,D4
02:0002E91A 8841            	  1930:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E91C 48C4            	  1931:     ext.l   D4
02:0002E91E D8BC00FF0000    	  1932:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E924 2044            	  1933:     movea.l D4,A0
02:0002E926 10303000        	  1934:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E92A 122C0002        	  1935:     move.b  ($02,A4),D1   ; ptr lo
02:0002E92E 182C0003        	  1936:     move.b  ($03,A4),D4  ; ptr hi
02:0002E932 024100FF        	  1937:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E936 E14C            	  1938:     lsl.w   #8,D4
02:0002E938 8841            	  1939:     or.w    D1,D4
02:0002E93A 48C4            	  1940:     ext.l   D4
02:0002E93C D8BC00FF0000    	  1941:     add.l   #NES_RAM,D4
02:0002E942 2044            	  1942:     movea.l D4,A0
02:0002E944 11803000        	  1943:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  1944:     ; Increment source address.
                            	  1945:     ;
02:0002E948 1014            	  1946:     move.b  ($0000,A4),D0
02:0002E94A 023C00EE        	  1947:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E94E 123C0001        	  1948:     move.b  #$01,D1
02:0002E952 D101            	  1949:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002E954 1880            	  1950:     move.b  D0,($0000,A4)
02:0002E956 102C0001        	  1951:     move.b  ($0001,A4),D0
02:0002E95A 123C0000        	  1952:     move.b  #$00,D1
02:0002E95E D101            	  1953:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002E960 19400001        	  1954:     move.b  D0,($0001,A4)
                            	  1955:     ; Increment destination address.
                            	  1956:     ;
02:0002E964 102C0002        	  1957:     move.b  ($0002,A4),D0
02:0002E968 023C00EE        	  1958:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E96C 123C0001        	  1959:     move.b  #$01,D1
02:0002E970 D101            	  1960:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002E972 19400002        	  1961:     move.b  D0,($0002,A4)
02:0002E976 102C0003        	  1962:     move.b  ($0003,A4),D0
02:0002E97A 123C0000        	  1963:     move.b  #$00,D1
02:0002E97E D101            	  1964:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002E980 19400003        	  1965:     move.b  D0,($0003,A4)
02:0002E984 0C00007F        	  1966:     cmpi.b  #$7F,D0
02:0002E988 6684            	  1967:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002E98A 102C0002        	  1968:     move.b  ($0002,A4),D0
02:0002E98E 4A00            	  1969:     cmpi.b  #$00,D0
02:0002E990 6600FF7C        	  1970:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002E994 0A3C0001        	  1971:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
