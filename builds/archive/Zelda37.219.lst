                            	  9998: Manhandla_Draw:
02:0003DE0A 4EB90004D304    	  9999:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 10000:     ; Push the "frame image and sprite attributes" value.
                            	 10001:     ;
02:0003DE10 41EC0478        	 10002:     lea     ($0478,A4),A0
02:0003DE14 10302000        	 10003:     move.b  (A0,D2.W),D0
02:0003DE18 1B00            	 10004:     move.b  D0,-(A5)  ; PHA
                            	 10005:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	 10006:     ; passed along as is.
                            	 10007:     ;
02:0003DE1A 02000080        	 10008:     andi.b #$80,D0
02:0003DE1E 00000001        	 10009:     ori.b #$01,D0
02:0003DE22 4EB90003196E    	 10010:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DE28 101D            	 10011:     move.b  (A5)+,D0  ; PLA
02:0003DE2A 1B00            	 10012:     move.b  D0,-(A5)  ; PHA
                            	 10013:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	 10014:     ;
02:0003DE2C 02000040        	 10015:     andi.b #$40,D0
02:0003DE30 6704            	 10016:     beq  _anon_z04_116
02:0003DE32 522C000F        	 10017:     addq.b  #1,($000F,A4)
                            	 10018: _anon_z04_116:
02:0003DE36 101D            	 10019:     move.b  (A5)+,D0  ; PLA
                            	 10020:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	 10021:     ; These are the 2 frame images of the horizontal hands.
                            	 10022:     ;
                            	 10023:     ; Else draw the base and vertical hands mirrored.
                            	 10024:     ;
02:0003DE38 0200000F        	 10025:     andi.b #$0F,D0
02:0003DE3C 0C000002        	 10026:     cmpi.b  #$02,D0
02:0003DE40 670C            	 10027:     beq  _anon_z04_117
02:0003DE42 0C000003        	 10028:     cmpi.b  #$03,D0
02:0003DE46 6706            	 10029:     beq  _anon_z04_117
02:0003DE48 4EF900031678    	 10030:     jmp     DrawObjectMirrored
                            	 10031: 
