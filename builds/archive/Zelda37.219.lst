02:0003F3C2 D101            	 12987:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003F3C4 19802070        	 12988:     move.b  D0,($70,A4,D2.W)
02:0003F3C8 41EC0084        	 12989:     lea     ($0084,A4),A0
02:0003F3CC 10302000        	 12990:     move.b  (A0,D2.W),D0
02:0003F3D0 123C0008        	 12991:     move.b  #$08,D1
02:0003F3D4 D101            	 12992:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F3D6 41EC0084        	 12993:     lea     ($0084,A4),A0
