                            	  5994: _anon_z04_81:
                            	  5995:     ; Chase while flying, as usual.
                            	  5996:     ;
02:0003C0E6 61003CEE        	  5997:     jsr     Flyer_Chase
                            	  5998:     ; If timer has not expired, then
                            	  5999:     ; go see if it's time to propagate direction changes down the chain.
                            	  6000:     ;
02:0003C0EA 10342028        	  6001:     move.b  ($28,A4,D2.W),D0
02:0003C0EE 6702            	  6002:     beq.s  __far_z_04_0045
