02:0003B218 601E            	  4002:     jmp  DrawArmosAndCheckCollisions
                            	  4003: __far_z_04_0036:
                            	  4004:     ; Armos animation frames last 6 screen frames.
                            	  4005:     ;
02:0003B21A 7006            	  4006:     moveq   #6,D0
02:0003B21C 41EC03D0        	  4007:     lea     ($03D0,A4),A0
02:0003B220 11802000        	  4008:     move.b  D0,(A0,D2.W)
                            	  4009:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4010:     ; change the position of the shield. To keep fixed it in place,
                            	  4011:     ; there are separate frame images for each animation frame.
                            	  4012:     ;
                            	  4013:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4014:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4015:     ;
                            	  4016:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4017:     ; Then choose the direction at the point of drawing below.
                            	  4018:     ;
02:0003B224 41EC03E4        	  4019:     lea     ($03E4,A4),A0
02:0003B228 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003B22C 0A000002        	  4021:     eori.b #$02,D0
02:0003B230 41EC03E4        	  4022:     lea     ($03E4,A4),A0
02:0003B234 11802000        	  4023:     move.b  D0,(A0,D2.W)
                            	  4024:     even
