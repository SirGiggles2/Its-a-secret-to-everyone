02:0003F446 123C0004        	 13057:     move.b  #$04,D1
02:0003F44A D101            	 13058:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F44C 19803072        	 13059:     move.b  D0,($72,A4,D3.W)
02:0003F450 41EC0084        	 13060:     lea     ($0084,A4),A0
