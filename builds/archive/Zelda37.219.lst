02:0003C14E 1880            	  6101:     move.b  D0,($0000,A4)
                            	  6102:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6103:     ;
02:0003C150 7600            	  6104:     moveq   #0,D3
02:0003C152 0C020005        	  6105:     cmpi.b  #$05,D2
02:0003C156 6702            	  6106:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C158 7605            	  6107:     moveq   #5,D3
