02:0003B63E E208            	  4623:     lsr.b  #1,D0   ; LSR A
02:0003B640 E208            	  4624:     lsr.b  #1,D0   ; LSR A
02:0003B642 E208            	  4625:     lsr.b  #1,D0   ; LSR A
02:0003B644 E208            	  4626:     lsr.b  #1,D0   ; LSR A
