02:0003F29A 6702            	 12781:     beq.s  __far_z_04_0127
02:0003F29C 6032            	 12782:     jmp  Ganon_DrawBodyFrame0
                            	 12783: __far_z_04_0127:
                            	 12784:     even
                            	 12785: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 12786:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 12787:     ; In this case, I think it means Ganon is shouting.
