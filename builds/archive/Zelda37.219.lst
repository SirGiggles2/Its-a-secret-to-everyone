02:0003F552 102C0015        	 13187:     move.b  ($0015,A4),D0
02:0003F556 02000003        	 13188:     andi.b #$03,D0
02:0003F55A 41F90003F428    	 13189:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F560 12302000        	 13190:     move.b  (A0,D2.W),D1
02:0003F564 8001            	 13191:     or.b  D1,D0
02:0003F566 19400003        	 13192:     move.b  D0,($0003,A4)
02:0003F56A 41F90003F432    	 13193:     lea     (GanonBurstTiles).l,A0
02:0003F570 10302000        	 13194:     move.b  (A0,D2.W),D0
02:0003F574 4EB900031978    	 13195:     jsr     Anim_WriteSprite
                            	 13196:     ; Bottom of the loop.
                            	 13197:     ; Increment object slot while <= 9.
                            	 13198:     ;
02:0003F57A 5202            	 13199:     addq.b  #1,D2
02:0003F57C 0C02000A        	 13200:     cmpi.b  #$0A,D2
