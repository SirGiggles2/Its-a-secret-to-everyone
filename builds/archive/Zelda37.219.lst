                            	  7938: _anon_z05_156:
02:00044D1C 101D            	  7939:     move.b  (A5)+,D0  ; PLA
                            	  7940:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7941:     ; then the player walked all the way to the edge of the play
                            	  7942:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7943:     ;
                            	  7944:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7945:     ; edge of the play area. So, set a relative position that
                            	  7946:     ; reflects that distance: $28 or -$28.
                            	  7947:     ;
                            	  7948:     ; If walking in a decreasing direction (left or up), then
                            	  7949:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7950:     ;
                            	  7951:     ; If walking in an increasing direction (right or down), then
                            	  7952:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7953:     ;
02:00044D1E 02000007        	  7954:     andi.b #$07,D0
02:00044D22 0C000002        	  7955:     cmpi.b  #$02,D0
