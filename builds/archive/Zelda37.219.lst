                            	  3999: FormatHeartsInTextBuf:
                            	  4000:     ; [$0E]: hearts value
                            	  4001:     ; [$0F]: heart partial
                            	  4002:     ; Y: The offset of first character in buffer
                            	  4003:     ;
                            	  4004:     ; The end of the bottom row is $12 bytes after the
                            	  4005:     ; start of the top row. We're writing to two transfer
                            	  4006:     ; records. We write the top row in the first transfer
                            	  4007:     ; record wherever the caller chooses. The second
                            	  4008:     ; transfer record has to begin with the heart tiles.
                            	  4009:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  4010:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  4011:     ;
                            	  4012:     ; Store the starting offset in [$0D].
