02:0004C948 41EC00AC        	  5751:     lea     ($00AC,A4),A0
02:0004C94C 11802000        	  5752:     move.b  D0,(A0,D2.W)
                            	  5753:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5754:     ; Else go handle the boomerang being blocked.
                            	  5755:     ;
02:0004C950 0C02000D        	  5756:     cmpi.b  #$0D,D2
02:0004C954 640E            	  5757:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C956 41EC034F        	  5758:     lea     ($034F,A4),A0
02:0004C95A 10302000        	  5759:     move.b  (A0,D2.W),D0
02:0004C95E 0C00005B        	  5760:     cmpi.b  #$5B,D0
02:0004C962 6708            	  5761:     beq  _L_z07_CheckState20_Deactivate
                            	  5762:     even
                            	  5763: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004C964 0C020012        	  5764:     cmpi.b  #$12,D2
