                            	  6986: _anon_z01_87:
02:00031D90 4E75            	  6987:     rts
                            	  6988: 
                            	  6989: ; Params:
                            	  6990: ; X: monster slot
                            	  6991: ; Y: weapon slot
                            	  6992: ; [02]: monster mid X
                            	  6993: ; [03]: monster mid Y
                            	  6994: ;
                            	  6995: ; Returns:
                            	  6996: ; [00]: weapon slot
                            	  6997: ;
                            	  6998: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6999: ;
