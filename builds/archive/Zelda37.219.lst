02:0003B244 16302000        	  4029:     move.b  (A0,D2.W),D3
                            	  4030:     ; If facing up, then use the second frame image in the set ("back").
                            	  4031:     ; Else use the second.
                            	  4032:     ;
02:0003B248 0C030008        	  4033:     cmpi.b  #$08,D3
02:0003B24C 6602            	  4034:     bne  _anon_z04_54
02:0003B24E 7001            	  4035:     moveq   #1,D0
                            	  4036: _anon_z04_54:
