                            	  5815: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow:
                            	  5816:     ; Start preparing to draw an arrow.
                            	  5817:     ;
                            	  5818:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5819:     ; and no horizontal flipping in [0F].
                            	  5820:     ;
02:0004C9C4 7002            	  5821:     moveq   #2,D0
02:0004C9C6 1940000C        	  5822:     move.b  D0,($000C,A4)
02:0004C9CA 7000            	  5823:     moveq   #0,D0
02:0004C9CC 1940000F        	  5824:     move.b  D0,($000F,A4)
                            	  5825:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5826:     ; and go draw.
                            	  5827:     ;
02:0004C9D0 41EC0098        	  5828:     lea     ($0098,A4),A0
02:0004C9D4 10302000        	  5829:     move.b  (A0,D2.W),D0
02:0004C9D8 4EB900030AB2    	  5830:     jsr     GetOppositeDir
