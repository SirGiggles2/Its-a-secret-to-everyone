                            	  2362: _TryShooting:
02:0003A6C6 19400001        	  2363:     move.b  D0,($0001,A4)
                            	  2364:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2365:     ;
02:0003A6CA 41EC034F        	  2366:     lea     ($034F,A4),A0
02:0003A6CE 10302000        	  2367:     move.b  (A0,D2.W),D0
02:0003A6D2 0C000003        	  2368:     cmpi.b  #$03,D0
02:0003A6D6 6726            	  2369:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6D8 0C000001        	  2370:     cmpi.b  #$01,D0
02:0003A6DC 6720            	  2371:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6DE 0C000009        	  2372:     cmpi.b  #$09,D0
02:0003A6E2 671A            	  2373:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6E4 0C00000A        	  2374:     cmpi.b  #$0A,D0
02:0003A6E8 6714            	  2375:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6EA 41EC0451        	  2376:     lea     ($0451,A4),A0
02:0003A6EE 10302000        	  2377:     move.b  (A0,D2.W),D0
02:0003A6F2 660A            	  2378:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2379:     ; and a random value < $F8, then return.
                            	  2380:     ;
02:0003A6F4 10342018        	  2381:     move.b  ($18,A4,D2.W),D0
02:0003A6F8 0C0000F8        	  2382:     cmpi.b  #$F8,D0
02:0003A6FC 656C            	  2383:     bcs  _L_z04__TryShooting_Exit
                            	  2384:     even
                            	  2385: _L_z04__TryShooting_TryShootingNow:
                            	  2386:     ; Summary
                            	  2387:     ;
                            	  2388:     ; if temporarily invincible then
                            	  2389:     ;   shoot timer := 0
                            	  2390:     ; elif shoot timer > 0 then
                            	  2391:     ;   decrement shoot timer
                            	  2392:     ; elif wants to shoot then
                            	  2393:     ;   shoot timer := $30
                            	  2394:     ;
                            	  2395:     ; qspeed := [01]
                            	  2396:     ;
                            	  2397:     ; if shoot timer <> 0 then
                            	  2398:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2399:     ;     shoot
                            	  2400:     ;     if succeeded then
                            	  2401:     ;       shoot timer := 0
                            	  2402:     ;       qspeed := 0
                            	  2403:     ;   else
                            	  2404:     ;     qspeed := 0
                            	  2405:     ;
                            	  2406:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A6FE 102C0001        	  2407:     move.b  ($0001,A4),D0
02:0003A702 1883            	  2408:     move.b  D3,($0000,A4)
02:0003A704 1B00            	  2409:     move.b  D0,-(A5)  ; PHA
02:0003A706 7600            	  2410:     moveq   #0,D3
                            	  2411:     ; If not temporarily invincible,
                            	  2412:     ;
02:0003A708 41EC04F0        	  2413:     lea     ($04F0,A4),A0
02:0003A70C 10302000        	  2414:     move.b  (A0,D2.W),D0
02:0003A710 661A            	  2415:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2416:     ; then Y := shoot timer - 1
                            	  2417:     ;
02:0003A712 7600            	  2418:     moveq   #0,D3
02:0003A714 41EC0451        	  2419:     lea     ($0451,A4),A0
02:0003A718 16302000        	  2420:     move.b  (A0,D2.W),D3
02:0003A71C 5303            	  2421:     subq.b  #1,D3
                            	  2422:     ; If Y register < 0, then shoot timer is 0.
                            	  2423:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2424:     ; Else go set a non-zero speed and return.
                            	  2425:     ;
02:0003A71E 6A0C            	  2426:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A720 41EC0412        	  2427:     lea     ($0412,A4),A0
02:0003A724 10302000        	  2428:     move.b  (A0,D2.W),D0
02:0003A728 6736            	  2429:     beq  _L_z04__TryShooting_SetSpeed
02:0003A72A 7630            	  2430:     moveq   #48,D3
                            	  2431:     even
                            	  2432: _L_z04__TryShooting_SetShootTimer:
                            	  2433:     ; shoot timer := Y
                            	  2434:     ;
02:0003A72C 1003            	  2435:     move.b  D3,D0
02:0003A72E 41EC0451        	  2436:     lea     ($0451,A4),A0
02:0003A732 11802000        	  2437:     move.b  D0,(A0,D2.W)
                            	  2438:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2439:     ;
02:0003A736 6728            	  2440:     beq  _L_z04__TryShooting_SetSpeed
                            	  2441:     ; shoot timer <> 0
                            	  2442:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2443:     ;
02:0003A738 0C030010        	  2444:     cmpi.b  #$10,D3
02:0003A73C 661C            	  2445:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2446:     ; If we have the magic clock, or the monster is stunned, then
                            	  2447:     ; go set a zero speed.
                            	  2448:     ;
02:0003A73E 102C066C        	  2449:     move.b  ($066C,A4),D0
02:0003A742 1234203D        	  2450:     move.b  ($3D,A4,D2.W),D1
02:0003A746 8001            	  2451:     or.b  D1,D0
02:0003A748 6610            	  2452:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2453:     ; Shoot.
                            	  2454:     ;
02:0003A74A 1014            	  2455:     move.b  ($0000,A4),D0
02:0003A74C 611E            	  2456:     jsr     _ShootIfWanted2
                            	  2457:     ; If it failed, go set a non-zero speed.
                            	  2458:     ;
02:0003A74E 6510            	  2459:     bcs  _L_z04__TryShooting_SetSpeed
                            	  2460:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2461:     ;
02:0003A750 7000            	  2462:     moveq   #0,D0
02:0003A752 41EC0412        	  2463:     lea     ($0412,A4),A0
02:0003A756 11802000        	  2464:     move.b  D0,(A0,D2.W)
                            	  2465:     even
