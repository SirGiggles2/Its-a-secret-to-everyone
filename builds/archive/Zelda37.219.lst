                            	  5833: 
                            	  5834:     even
                            	  5835: CheckState30:
                            	  5836:     ; If major state <> $30, go check other states.
                            	  5837:     ;
02:0004C9E4 0C000030        	  5838:     cmpi.b  #$30,D0
02:0004C9E8 6656            	  5839:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5840:     ; State $3x. Slow down.
                            	  5841:     ;
                            	  5842:     ; Reset grid offset for movement.
                            	  5843:     ;
02:0004C9EA 7000            	  5844:     moveq   #0,D0
02:0004C9EC 41EC0394        	  5845:     lea     ($0394,A4),A0
02:0004C9F0 11802000        	  5846:     move.b  D0,(A0,D2.W)
                            	  5847:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5848:     ;
02:0004C9F4 7040            	  5849:     moveq   #64,D0
02:0004C9F6 41EC03BC        	  5850:     lea     ($03BC,A4),A0
02:0004C9FA 11802000        	  5851:     move.b  D0,(A0,D2.W)
                            	  5852:     ; If facing left and X < 2, then go change state to $40. The
                            	  5853:     ; boomerang is too close to the left edge of the screen.
                            	  5854:     ; Another move might make it wrap around.
                            	  5855:     ;
02:0004C9FE 41EC0098        	  5856:     lea     ($0098,A4),A0
02:0004CA02 10302000        	  5857:     move.b  (A0,D2.W),D0
02:0004CA06 1940000F        	  5858:     move.b  D0,($000F,A4)
02:0004CA0A 02000002        	  5859:     andi.b #$02,D0
02:0004CA0E 670A            	  5860:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004CA10 10342070        	  5861:     move.b  ($70,A4,D2.W),D0
02:0004CA14 0C000002        	  5862:     cmpi.b  #$02,D0
02:0004CA18 650E            	  5863:     bcs  _L_z07_CheckState30_SetState40
                            	  5864:     even
                            	  5865: _L_z07_CheckState30_MoveBoomerang:
                            	  5866:     ; Move the boomerang.
                            	  5867:     ;
02:0004CA1A 6100F54C        	  5868:     jsr     MoveObject
                            	  5869:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5870:     ; state to $40.
                            	  5871:     ;
02:0004CA1E 41EC0380        	  5872:     lea     ($0380,A4),A0
02:0004CA22 53302000        	  5873:     subq.b  #1,(A0,D2.W)
