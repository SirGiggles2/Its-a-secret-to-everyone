02:00044826 B001            	  7647:     cmp.b   D1,D0
02:00044828 6704            	  7648:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:0004482A 5302            	  7649:     subq.b  #1,D2
02:0004482C 66EE            	  7650:     bne  _anon_z05_149
                            	  7651:     even
