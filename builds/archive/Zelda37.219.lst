02:0003A2E8 7005            	  1771:     moveq   #5,D0
02:0003A2EA 19802028        	  1772:     move.b  D0,($28,A4,D2.W)
02:0003A2EE 41EC00AC        	  1773:     lea     ($00AC,A4),A0
02:0003A2F2 52302000        	  1774:     addq.b  #1,(A0,D2.W)
