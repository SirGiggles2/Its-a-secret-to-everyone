02:0004C4CE 6008            	  5091:     jmp  DrawSwordShotOrMagicShot
                            	  5092: __far_z_07_0077:
02:0004C4D0 41EC0394        	  5093:     lea     ($0394,A4),A0
02:0004C4D4 11802000        	  5094:     move.b  D0,(A0,D2.W)
                            	  5095:     even
                            	  5096: DrawSwordShotOrMagicShot:
                            	  5097:     ; Prepare the sprite position.
                            	  5098:     ;
02:0004C4D8 61000E2A        	  5099:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  5100:     ; If the direction is horizontal, move the sprites down 3 pixels.
                            	  5101:     ;
02:0004C4DC 41EC0098        	  5102:     lea     ($0098,A4),A0
02:0004C4E0 10302000        	  5103:     move.b  (A0,D2.W),D0
02:0004C4E4 1B00            	  5104:     move.b  D0,-(A5)  ; PHA
02:0004C4E6 02000003        	  5105:     andi.b #$03,D0
02:0004C4EA 6712            	  5106:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004C4EC 102C0001        	  5107:     move.b  ($0001,A4),D0
02:0004C4F0 023C00EE        	  5108:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C4F4 123C0003        	  5109:     move.b  #$03,D1
02:0004C4F8 D101            	  5110:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004C4FA 19400001        	  5111:     move.b  D0,($0001,A4)
                            	  5112:     even
                            	  5113: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004C4FE 101D            	  5114:     move.b  (A5)+,D0  ; PLA
                            	  5115:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  5116:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  5117:     ;
                            	  5118:     ;
                            	  5119:     ; Call this only to get reverse direction index.
02:0004C500 4EB900030AB2    	  5120:     jsr     GetOppositeDir
02:0004C506 102C0015        	  5121:     move.b  ($0015,A4),D0
02:0004C50A 02000003        	  5122:     andi.b #$03,D0
02:0004C50E 41F90004C7CA    	  5123:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004C514 12303000        	  5124:     move.b  (A0,D3.W),D1
02:0004C518 8001            	  5125:     or.b  D1,D0
02:0004C51A 4EB90003196E    	  5126:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5127:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  5128:     ;
02:0004C520 41F90004C7C6    	  5129:     lea     (RDirectionToWeaponFrame).l,A0
02:0004C526 10303000        	  5130:     move.b  (A0,D3.W),D0
02:0004C52A 1940000C        	  5131:     move.b  D0,($000C,A4)
                            	  5132:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  5133:     ;
02:0004C52E 0C030002        	  5134:     cmpi.b  #$02,D3
02:0004C532 6604            	  5135:     bne  _anon_z07_24
02:0004C534 522C000F        	  5136:     addq.b  #1,($000F,A4)
                            	  5137: _anon_z07_24:
                            	  5138:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  5139:     ;   $57 (sword shot) => $22
                            	  5140:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  5141:     ;
02:0004C538 7622            	  5142:     moveq   #34,D3
02:0004C53A 0C02000D        	  5143:     cmpi.b  #$0D,D2
02:0004C53E 6410            	  5144:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004C540 41EC034F        	  5145:     lea     ($034F,A4),A0
02:0004C544 10302000        	  5146:     move.b  (A0,D2.W),D0
02:0004C548 0C000057        	  5147:     cmpi.b  #$57,D0
02:0004C54C 6710            	  5148:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004C54E 660C            	  5149:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  5150:     even
                            	  5151: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  5152:     ; But if the player shot it, the choice depends on the shot's state.
                            	  5153:     ;   high bit set (magic)   => $23
                            	  5154:     ;   high bit clear (sword) => $22
                            	  5155:     ;
02:0004C550 41EC00AC        	  5156:     lea     ($00AC,A4),A0
02:0004C554 10302000        	  5157:     move.b  (A0,D2.W),D0
02:0004C558 E308            	  5158:     lsl.b  #1,D0   ; ASL A
02:0004C55A 6402            	  5159:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  5160:     even
                            	  5161: _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites:
02:0004C55C 7623            	  5162:     moveq   #35,D3
                            	  5163:     even
                            	  5164: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004C55E 4EF90003188E    	  5165:     jmp     Anim_WriteItemSprites
                            	  5166: 
                            	  5167: ; Params:
                            	  5168: ; X: shot object index
                            	  5169: ;
                            	  5170: ; If the object is a sword shot, go spread out the shot.
                            	  5171: ;
                            	  5172:     even
                            	  5173: HandleShotBlocked:
02:0004C564 41EC00AC        	  5174:     lea     ($00AC,A4),A0
02:0004C568 10302000        	  5175:     move.b  (A0,D2.W),D0
02:0004C56C E308            	  5176:     lsl.b  #1,D0   ; ASL A
02:0004C56E 6504            	  5177:     bcs.s  __far_z_07_0078
02:0004C570 60000082        	  5178:     jmp  SetShotSpreadingState
                            	  5179: __far_z_07_0078:
                            	  5180:     ; This is a magic shot.
                            	  5181:     ;
                            	  5182:     ; If missing the magic book, go deactivate the shot object.
                            	  5183:     ;
02:0004C574 102C0661        	  5184:     move.b  ($0661,A4),D0
02:0004C578 6602            	  5185:     bne.s  __far_z_07_0079
02:0004C57A 6072            	  5186:     jmp  DeactivateShot
                            	  5187: __far_z_07_0079:
                            	  5188:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5189:     ; unused, so it only has to depend on having an empty slot.
                            	  5190:     ;
                            	  5191:     ; If successful, Link's state will have been changed to "using item".
                            	  5192:     ; But we don't want that in this case.
                            	  5193:     ;
                            	  5194:     ; For both these reasons, save state and restore it afterward.
                            	  5195:     ;
02:0004C57C 102C00AC        	  5196:     move.b  ($00AC,A4),D0
02:0004C580 1B00            	  5197:     move.b  D0,-(A5)  ; PHA
02:0004C582 102C0513        	  5198:     move.b  ($0513,A4),D0
02:0004C586 1B00            	  5199:     move.b  D0,-(A5)  ; PHA
02:0004C588 7000            	  5200:     moveq   #0,D0
02:0004C58A 19400513        	  5201:     move.b  D0,($0513,A4)
02:0004C58E 4EB900030CFC    	  5202:     jsr     WieldCandle
02:0004C594 101D            	  5203:     move.b  (A5)+,D0  ; PLA
02:0004C596 19400513        	  5204:     move.b  D0,($0513,A4)
02:0004C59A 101D            	  5205:     move.b  (A5)+,D0  ; PLA
02:0004C59C 194000AC        	  5206:     move.b  D0,($00AC,A4)
                            	  5207:     ; State $21 means that a moving fire was just made.
                            	  5208:     ;
                            	  5209:     ; If it's any another value, then we didn't find an empty slot
                            	  5210:     ; to make a fire. In this case, all that's left to do is to go
                            	  5211:     ; deactivate the shot object.
                            	  5212:     ;
02:0004C5A0 41EC00AC        	  5213:     lea     ($00AC,A4),A0
02:0004C5A4 10302000        	  5214:     move.b  (A0,D2.W),D0
02:0004C5A8 0C000021        	  5215:     cmpi.b  #$21,D0
02:0004C5AC 6702            	  5216:     beq.s  __far_z_07_0080
02:0004C5AE 6038            	  5217:     jmp  DeactivateLinkShot
                            	  5218: __far_z_07_0080:
                            	  5219:     ; Make state $22 for a standing fire.
                            	  5220:     ;
02:0004C5B0 41EC00AC        	  5221:     lea     ($00AC,A4),A0
02:0004C5B4 52302000        	  5222:     addq.b  #1,(A0,D2.W)
                            	  5223:     ; Copy the shot's position and direction to the fire.
                            	  5224:     ;
02:0004C5B8 760E            	  5225:     moveq   #14,D3
02:0004C5BA 10343070        	  5226:     move.b  ($70,A4,D3.W),D0
02:0004C5BE 19802070        	  5227:     move.b  D0,($70,A4,D2.W)
02:0004C5C2 41EC0084        	  5228:     lea     ($0084,A4),A0
02:0004C5C6 10303000        	  5229:     move.b  (A0,D3.W),D0
02:0004C5CA 41EC0084        	  5230:     lea     ($0084,A4),A0
02:0004C5CE 11802000        	  5231:     move.b  D0,(A0,D2.W)
02:0004C5D2 41EC0098        	  5232:     lea     ($0098,A4),A0
02:0004C5D6 10303000        	  5233:     move.b  (A0,D3.W),D0
02:0004C5DA 41EC0098        	  5234:     lea     ($0098,A4),A0
02:0004C5DE 11802000        	  5235:     move.b  D0,(A0,D2.W)
                            	  5236:     ; The fire lasts $4F frames.
                            	  5237:     ; Deactivate the shot.
                            	  5238:     ;
02:0004C5E2 704F            	  5239:     moveq   #79,D0
02:0004C5E4 19802028        	  5240:     move.b  D0,($28,A4,D2.W)
                            	  5241:     even
                            	  5242: DeactivateLinkShot:
02:0004C5E8 4EF90002BC8E    	  5243:     jmp     c_deactivate_link_shot
                            	  5244: 
                            	  5245: DeactivateShot:
02:0004C5EE 4EF90002BC7E    	  5246:     jmp     c_deactivate_shot
                            	  5247: 
                            	  5248: SetShotSpreadingState:
02:0004C5F4 4EF90002B8B6    	  5249:     jmp     c_set_shot_spreading_state
                            	  5250: 
                            	  5251: SpreadShot:
                            	  5252:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5253:     ;
                            	  5254:     ; The shot is spreading out.
                            	  5255:     ;
                            	  5256:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5257:     ; These will be negated appropriately for each corner.
                            	  5258:     ;
02:0004C5FA 41EC0098        	  5259:     lea     ($0098,A4),A0
02:0004C5FE 10302000        	  5260:     move.b  (A0,D2.W),D0
02:0004C602 19400002        	  5261:     move.b  D0,($0002,A4)
02:0004C606 19400003        	  5262:     move.b  D0,($0003,A4)
                            	  5263:     ; Reset [0F] to not flip horizontally.
                            	  5264:     ;
02:0004C60A 7000            	  5265:     moveq   #0,D0
02:0004C60C 1940000F        	  5266:     move.b  D0,($000F,A4)
                            	  5267:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5268:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5269:     ;
02:0004C610 7603            	  5270:     moveq   #3,D3
                            	  5271:     even
                            	  5272: _L_z07_SpreadShot_DrawShotCorner:
02:0004C612 1003            	  5273:     move.b  D3,D0
02:0004C614 1B00            	  5274:     move.b  D0,-(A5)  ; PHA
                            	  5275:     ; Save offset X [02] and Y offset [03].
                            	  5276:     ;
02:0004C616 102C0002        	  5277:     move.b  ($0002,A4),D0
02:0004C61A 1B00            	  5278:     move.b  D0,-(A5)  ; PHA
02:0004C61C 102C0003        	  5279:     move.b  ($0003,A4),D0
02:0004C620 1B00            	  5280:     move.b  D0,-(A5)  ; PHA
                            	  5281:     ; Calculate and set sprite attributes for this corner:
                            	  5282:     ;   base attribute OR (frame counter AND 3)
                            	  5283:     ;
                            	  5284:     ; The base attribute defines how to flip the sprite.
                            	  5285:     ; The frame counter makes the shot flash by cycling each
                            	  5286:     ; palette row.
                            	  5287:     ;
02:0004C622 102C0015        	  5288:     move.b  ($0015,A4),D0
02:0004C626 02000003        	  5289:     andi.b #$03,D0
02:0004C62A 41F90004C488    	  5290:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C630 12303000        	  5291:     move.b  (A0,D3.W),D1
02:0004C634 8001            	  5292:     or.b  D1,D0
02:0004C636 4EB90003196E    	  5293:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5294:     ; Add the object's X (the center of the spread) and the
                            	  5295:     ; current offset in [02] to set sprite X in [00].
                            	  5296:     ;
02:0004C63C 10342070        	  5297:     move.b  ($70,A4,D2.W),D0
02:0004C640 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C644 122C0002        	  5299:     move.b  ($0002,A4),D1
02:0004C648 D101            	  5300:     addx.b  D1,D0   ; ADC $02
02:0004C64A 1880            	  5301:     move.b  D0,($0000,A4)
                            	  5302:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5303:     ; Else calculate the distance from object X to sprite X.
                            	  5304:     ;
02:0004C64C 12342070        	  5305:     move.b  ($70,A4,D2.W),D1
02:0004C650 B001            	  5306:     cmp.b   D1,D0
02:0004C652 651A            	  5307:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C654 0C0000FC        	  5308:     cmpi.b  #$FC,D0
02:0004C658 6466            	  5309:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C65A 003C0011        	  5310:     ori     #$11,CCR  ; SEC: set C+X
02:0004C65E 12342070        	  5311:     move.b  ($70,A4,D2.W),D1
02:0004C662 0A3C0010        	  5312:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C666 9101            	  5313:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C668 0A3C0010        	  5314:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C66C 6014            	  5315:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5316: 
                            	  5317:     even
                            	  5318: _L_z07_SpreadShot_ReverseSub:
02:0004C66E 10342070        	  5319:     move.b  ($70,A4,D2.W),D0
02:0004C672 003C0011        	  5320:     ori     #$11,CCR  ; SEC: set C+X
02:0004C676 1214            	  5321:     move.b  ($0000,A4),D1
02:0004C678 0A3C0010        	  5322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C67C 9101            	  5323:     subx.b  D1,D0   ; SBC $00
02:0004C67E 0A3C0010        	  5324:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5325:     even
                            	  5326: _L_z07_SpreadShot_CheckDistance:
                            	  5327:     ; If distance >= $20, skip this corner.
                            	  5328:     ;
02:0004C682 0C000020        	  5329:     cmpi.b  #$20,D0
02:0004C686 6438            	  5330:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5331:     ; Add the object's Y (the center of the spread) and the
                            	  5332:     ; current offset in [03] to set sprite Y in [01].
                            	  5333:     ;
02:0004C688 41EC0084        	  5334:     lea     ($0084,A4),A0
02:0004C68C 10302000        	  5335:     move.b  (A0,D2.W),D0
02:0004C690 023C00EE        	  5336:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C694 122C0003        	  5337:     move.b  ($0003,A4),D1
02:0004C698 D101            	  5338:     addx.b  D1,D0   ; ADC $03
02:0004C69A 19400001        	  5339:     move.b  D0,($0001,A4)
                            	  5340:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5341:     ;
02:0004C69E 7600            	  5342:     moveq   #0,D3
02:0004C6A0 162C0010        	  5343:     move.b  ($0010,A4),D3
02:0004C6A4 670C            	  5344:     beq  _L_z07_SpreadShot_Draw
02:0004C6A6 0C00003E        	  5345:     cmpi.b  #$3E,D0
02:0004C6AA 6514            	  5346:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C6AC 0C0000E8        	  5347:     cmpi.b  #$E8,D0
02:0004C6B0 640E            	  5348:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5349:     even
                            	  5350: _L_z07_SpreadShot_Draw:
                            	  5351:     ; Draw the corner.
                            	  5352:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5353:     ;
02:0004C6B2 7002            	  5354:     moveq   #2,D0
02:0004C6B4 1940000C        	  5355:     move.b  D0,($000C,A4)
02:0004C6B8 7623            	  5356:     moveq   #35,D3
02:0004C6BA 4EB90003188E    	  5357:     jsr     Anim_WriteItemSprites
                            	  5358:     even
                            	  5359: _L_z07_SpreadShot_NextCorner:
                            	  5360:     ; Prepare to process the next corner.
                            	  5361:     ;
                            	  5362:     ; First, restore X offset [02] and Y offset [03].
                            	  5363:     ;
02:0004C6C0 101D            	  5364:     move.b  (A5)+,D0  ; PLA
02:0004C6C2 19400003        	  5365:     move.b  D0,($0003,A4)
02:0004C6C6 101D            	  5366:     move.b  (A5)+,D0  ; PLA
02:0004C6C8 19400002        	  5367:     move.b  D0,($0002,A4)
                            	  5368:     ; Take turns negating X offset or Y offset for the next round.
                            	  5369:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5370:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5371:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5372:     ; - Fourth turn: doesn't matter
                            	  5373:     ;
                            	  5374:     ;
                            	  5375:     ; Get the loop index.
02:0004C6CC 101D            	  5376:     move.b  (A5)+,D0  ; PLA
02:0004C6CE 1B00            	  5377:     move.b  D0,-(A5)  ; PHA
02:0004C6D0 7600            	  5378:     moveq   #0,D3
02:0004C6D2 1600            	  5379:     move.b  D0,D3
02:0004C6D4 0C030001        	  5380:     cmpi.b  #$01,D3
02:0004C6D8 6602            	  5381:     bne  _anon_z07_25
02:0004C6DA 7603            	  5382:     moveq   #3,D3
                            	  5383: _anon_z07_25:
02:0004C6DC 10343000        	  5384:     move.b  ($00,A4,D3.W),D0
02:0004C6E0 4600            	  5385:     eori.b #$FF,D0
02:0004C6E2 023C00EE        	  5386:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6E6 123C0001        	  5387:     move.b  #$01,D1
02:0004C6EA D101            	  5388:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C6EC 19803000        	  5389:     move.b  D0,($00,A4,D3.W)
                            	  5390:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5391:     ;
02:0004C6F0 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C6F2 7600            	  5393:     moveq   #0,D3
02:0004C6F4 1600            	  5394:     move.b  D0,D3
02:0004C6F6 5303            	  5395:     subq.b  #1,D3
02:0004C6F8 6A00FF18        	  5396:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5397:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5398:     ;
                            	  5399:     ; Decrease the base negative offset to get farther away from
                            	  5400:     ; the center point.
                            	  5401:     ;
02:0004C6FC 41EC0098        	  5402:     lea     ($0098,A4),A0
02:0004C700 53302000        	  5403:     subq.b  #1,(A0,D2.W)
                            	  5404:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5405:     ;
                            	  5406:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5407:     ;
02:0004C704 41EC0098        	  5408:     lea     ($0098,A4),A0
02:0004C708 10302000        	  5409:     move.b  (A0,D2.W),D0
02:0004C70C 0C0000E8        	  5410:     cmpi.b  #$E8,D0
