                            	 11167: __far_z_04_0105:
                            	 11168: ; Description:
                            	 11169: ; This block applies to heads and the bottom segment of a neck.
                            	 11170: ; These are drawn with sprites that come first in order, so that
                            	 11171: ; they are drawn above all other sprites, including Link.
                            	 11172: ;
                            	 11173: ; Params:
                            	 11174: ; A: tile number
                            	 11175: ;
                            	 11176: ; Normal sprite with level palette row
                            	 11177:     even
                            	 11178: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E6D8 7603            	 11179:     moveq   #3,D3
02:0003E6DA 19430003        	 11180:     move.b  D3,($0003,A4)
02:0003E6DE 1B00            	 11181:     move.b  D0,-(A5)  ; PHA
                            	 11182:     ; To calculate the base offset of the sprite record:
                            	 11183:     ; offset := neck index * 8
                            	 11184:     ;
                            	 11185:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11186:     ; at an even index.
                            	 11187:     ;
02:0003E6E0 102C04D7        	 11188:     move.b  ($04D7,A4),D0
02:0003E6E4 E308            	 11189:     lsl.b  #1,D0   ; ASL A
02:0003E6E6 E308            	 11190:     lsl.b  #1,D0   ; ASL A
02:0003E6E8 E308            	 11191:     lsl.b  #1,D0   ; ASL A
                            	 11192:     ; But if the segment is not a head (not at object slot 5), then
                            	 11193:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11194:     ;
02:0003E6EA 0C020005        	 11195:     cmpi.b  #$05,D2
02:0003E6EE 670A            	 11196:     beq  _anon_z04_139
02:0003E6F0 023C00EE        	 11197:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6F4 123C0020        	 11198:     move.b  #$20,D1
02:0003E6F8 D101            	 11199:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11200: _anon_z04_139:
02:0003E6FA 7600            	 11201:     moveq   #0,D3
02:0003E6FC 1600            	 11202:     move.b  D0,D3
02:0003E6FE 101D            	 11203:     move.b  (A5)+,D0  ; PLA
02:0003E700 4EB9000319A6    	 11204:     jsr     Anim_WriteSpecificSprite
02:0003E706 6026            	 11205:     jmp     Gleeok_CheckCollisions
                            	 11206: 
                            	 11207:     even
