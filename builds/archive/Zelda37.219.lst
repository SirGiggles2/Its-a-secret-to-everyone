                            	   559: UpdateMenuStartOW:
                            	   560:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   561:     ; make it look completely empty, and no piece has been won.
                            	   562:     ;
02:00040456 7617            	   563:     moveq   #23,D3
                            	   564: _anon_z05_6:
02:00040458 7400            	   565:     moveq   #0,D2
02:0004045A 41F90004040E    	   566:     lea     (TriforceTransferBufOffsets).l,A0
02:00040460 14303000        	   567:     move.b  (A0,D3.W),D2
02:00040464 41F90004043E    	   568:     lea     (TriforceTransferBufTiles).l,A0
02:0004046A 10303000        	   569:     move.b  (A0,D3.W),D0
02:0004046E 41F9000477F6    	   570:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040474 11802000        	   571:     move.b  D0,(A0,D2.W)
02:00040478 5303            	   572:     subq.b  #1,D3
02:0004047A 6ADC            	   573:     bpl  _anon_z05_6
                            	   574:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   575:     ;
02:0004047C 5203            	   576:     addq.b  #1,D3
                            	   577:     ; Outer loop.
                            	   578:     ; A level test bit in [06] will be used to see whether
                            	   579:     ; we have a triforce piece.
                            	   580:     ;
02:0004047E 7001            	   581:     moveq   #1,D0
02:00040480 19400006        	   582:     move.b  D0,($0006,A4)
                            	   583:     even
                            	   584: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   585:     ; Inner loop.
                            	   586:     ; Each level bit will make 3 triforce tile slots be
                            	   587:     ; checked and replaced.
                            	   588:     ;
02:00040484 7003            	   589:     moveq   #3,D0
02:00040486 19400007        	   590:     move.b  D0,($0007,A4)
                            	   591:     even
                            	   592: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   593:     ; Get the offset into the submenu triforce transfer buffers of
                            	   594:     ; the current tile slot.
                            	   595:     ;
02:0004048A 7400            	   596:     moveq   #0,D2
02:0004048C 41F90004040E    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:00040492 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:00040496 102C0006        	   605:     move.b  ($0006,A4),D0
02:0004049A 122C0671        	   606:     move.b  ($0671,A4),D1
02:0004049E C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000404A0 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
                            	   615:     ; Else replace it with the one at the current triforce tile slot
                            	   616:     ; in the replacement list.
                            	   617:     ;
