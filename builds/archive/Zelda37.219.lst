02:0004CB0C 10303000        	  6011:     move.b  (A0,D3.W),D0
02:0004CB10 4EB900030BDE    	  6012:     jsr     SetBoomerangSpeed
02:0004CB16 102C000B        	  6013:     move.b  ($000B,A4),D0
