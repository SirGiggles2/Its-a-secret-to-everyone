02:0003B658 162C0016        	  4640:     move.b  ($0016,A4),D3
02:0003B65C 41EC062D        	  4641:     lea     ($062D,A4),A0
02:0003B660 12303000        	  4642:     move.b  (A0,D3.W),D1
02:0003B664 B001            	  4643:     cmp.b   D1,D0
