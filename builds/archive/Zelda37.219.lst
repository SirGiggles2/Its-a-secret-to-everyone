                            	  6744: _anon_z01_84:
                            	  6745:     ; Store Link's midpoint coordinates in [04] and [05].
                            	  6746:     ;
02:00031BB4 102C0070        	  6747:     move.b  ($0070,A4),D0
02:00031BB8 023C00EE        	  6748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BBC 123C0008        	  6749:     move.b  #$08,D1
02:00031BC0 D101            	  6750:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031BC2 19400004        	  6751:     move.b  D0,($0004,A4)
02:00031BC6 102C0084        	  6752:     move.b  ($0084,A4),D0
02:00031BCA 023C00EE        	  6753:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BCE 123C0008        	  6754:     move.b  #$08,D1
02:00031BD2 D101            	  6755:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031BD4 19400005        	  6756:     move.b  D0,($0005,A4)
                            	  6757:     ; If both objects are 9 pixels apart or more, then return no collision.
                            	  6758:     ;
