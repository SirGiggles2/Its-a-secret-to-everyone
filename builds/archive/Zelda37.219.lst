02:0003C316 023C00EE        	  6382:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C31A 41F90003C1B6    	  6383:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C320 12303000        	  6384:     move.b  (A0,D3.W),D1
02:0003C324 D101            	  6385:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C326 41EC0084        	  6386:     lea     ($0084,A4),A0
02:0003C32A 11802000        	  6387:     move.b  D0,(A0,D2.W)
