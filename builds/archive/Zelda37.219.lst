                            	  3668: _anon_z05_83:
                            	  3669:     ; Look for the current room in the cellar/shortcut room array.
                            	  3670:     ;
02:00041F14 1883            	  3671:     move.b  D3,($0000,A4)
02:00041F16 163C00FF        	  3672:     move.b  #$FF,D3
02:00041F1A 102C00EB        	  3673:     move.b  ($00EB,A4),D0
                            	  3674: _anon_z05_84:
02:00041F1E 5203            	  3675:     addq.b  #1,D3
02:00041F20 41F900FF6BB2    	  3676:     lea     (NES_SRAM+$0BB2).l,A0
02:00041F26 12303000        	  3677:     move.b  (A0,D3.W),D1
02:00041F2A B001            	  3678:     cmp.b   D1,D0
02:00041F2C 66F0            	  3679:     bne  _anon_z05_84
                            	  3680:     ; Add the value of the shortcut chosen to whatever index
                            	  3681:     ; the current room has in the array.
                            	  3682:     ;
                            	  3683:     ; This yields the index of one of the three shortcut rooms
                            	  3684:     ; after the current one.
                            	  3685:     ;
02:00041F2E 1003            	  3686:     move.b  D3,D0
02:00041F30 023C00EE        	  3687:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F34 1214            	  3688:     move.b  ($0000,A4),D1
02:00041F36 D101            	  3689:     addx.b  D1,D0   ; ADC $00
                            	  3690:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3691:     ;
02:00041F38 02000003        	  3692:     andi.b #$03,D0
02:00041F3C 7600            	  3693:     moveq   #0,D3
02:00041F3E 1600            	  3694:     move.b  D0,D3
02:00041F40 41F900FF6BB2    	  3695:     lea     (NES_SRAM+$0BB2).l,A0
02:00041F46 10303000        	  3696:     move.b  (A0,D3.W),D0
                            	  3697: ; Params:
                            	  3698: ; A: destination room ID
                            	  3699: ;
                            	  3700:     even
