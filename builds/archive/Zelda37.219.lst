                            	 13162: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F52E 19420340        	 13163:     move.b  D2,($0340,A4)
                            	 13164:     ; If object slot < 5 or = 7, then move every frame.
                            	 13165:     ; Else move 3 out of every 4 frames.
                            	 13166:     ;
                            	 13167:     ; This makes pieces spread out in somewhat of a circle,
                            	 13168:     ; by making the pieces at cardinal directions move at
                            	 13169:     ; full speed while the diagonal ones move a little slower.
