                            	 10263: GohmaLegOffsetsX:
02:0003E00C F0              	 10264:     dc.b    $F0, $10
02:0003E00D 10
                            	 10265: 
                            	 10266: ; Params:
                            	 10267: ; A: eye frame image
                            	 10268: ;
