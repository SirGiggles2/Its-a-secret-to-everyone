02:0004CAA8 0C000070        	  5967:     cmpi.b  #$70,D0
02:0004CAAC 6502            	  5968:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004CAAE 7670            	  5969:     moveq   #112,D3
                            	  5970:     even
