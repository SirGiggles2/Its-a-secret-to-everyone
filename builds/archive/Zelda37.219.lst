                            	  3129: ; Three sets of border coordinates:
                            	  3130: ; - outer OW
                            	  3131: ; - outer UW
                            	  3132: ; - inner
                            	  3133: ;
                            	  3134: ; Within each set, the coordinates are arranged:
                            	  3135: ; down, up, right, left
                            	  3136: ;
                            	  3137:     even
                            	  3138: BorderBounds:
02:00041BA6 D6              	  3139:     dc.b    $D6, $45, $E9, $07, $C6, $55, $D9, $17
02:00041BA7 45
02:00041BA8 E9
02:00041BA9 07
02:00041BAA C6
02:00041BAB 55
02:00041BAC D9
02:00041BAD 17
02:00041BAE BE              	  3140:     dc.b    $BE, $54, $D1, $1F
02:00041BAF 54
02:00041BB0 D1
02:00041BB1 1F
                            	  3141: 
                            	  3142:     even
                            	  3143: Link_FilterInput:
                            	  3144:     ; [00] holds the opposite of Link's facing direction.
                            	  3145:     ;
02:00041BB2 102C0098        	  3146:     move.b  ($0098,A4),D0
02:00041BB6 4EB900030AB2    	  3147:     jsr     GetOppositeDir
02:00041BBC 1880            	  3148:     move.b  D0,($0000,A4)
                            	  3149:     ; Call GetOppositeDir again to use this mapping:
                            	  3150:     ; In Dir: 1 2 4 8
                            	  3151:     ;         -------
                            	  3152:     ; Index:  2 3 0 1
                            	  3153:     ;
02:00041BBE 4EB900030AB2    	  3154:     jsr     GetOppositeDir
                            	  3155:     ; Get the appropriate coordinate for the direction:
                            	  3156:     ; X for horizontal
                            	  3157:     ; Y for vertical
                            	  3158:     ;
02:00041BC4 102C0070        	  3159:     move.b  ($0070,A4),D0
02:00041BC8 0C030002        	  3160:     cmpi.b  #$02,D3
02:00041BCC 6404            	  3161:     bcc  _anon_z05_74
02:00041BCE 102C0084        	  3162:     move.b  ($0084,A4),D0
                            	  3163: _anon_z05_74:
02:00041BD2 19400002        	  3164:     move.b  D0,($0002,A4)
                            	  3165:     ; Mask A button and directions if inner border is crossed.
                            	  3166:     ;
02:00041BD6 1003            	  3167:     move.b  D3,D0
02:00041BD8 1B00            	  3168:     move.b  D0,-(A5)  ; PHA
02:00041BDA 023C00EE        	  3169:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BDE 123C0008        	  3170:     move.b  #$08,D1
02:00041BE2 D101            	  3171:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041BE4 7600            	  3172:     moveq   #0,D3
02:00041BE6 1600            	  3173:     move.b  D0,D3
02:00041BE8 103C0080        	  3174:     move.b  #$80,D0
02:00041BEC 6134            	  3175:     jsr     MaskInputInBorder
02:00041BEE 101D            	  3176:     move.b  (A5)+,D0  ; PLA
02:00041BF0 7600            	  3177:     moveq   #0,D3
02:00041BF2 1600            	  3178:     move.b  D0,D3
                            	  3179:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3180:     ; boundary using player's direction and reverse direction index.
                            	  3181:     ;
02:00041BF4 102C0001        	  3182:     move.b  ($0001,A4),D0
02:00041BF8 0C0000FF        	  3183:     cmpi.b  #$FF,D0
02:00041BFC 660C            	  3184:     bne  _anon_z05_75
02:00041BFE 102C0098        	  3185:     move.b  ($0098,A4),D0
02:00041C02 1880            	  3186:     move.b  D0,($0000,A4)
02:00041C04 4EB900030AB2    	  3187:     jsr     GetOppositeDir
                            	  3188: _anon_z05_75:
                            	  3189:     ; If in UW, use the second set of bounds by adding 4
                            	  3190:     ; to reverse direction index.
                            	  3191:     ;
                            	  3192:     ; Else in OW, and use first set that begins at offset 0.
                            	  3193:     ;
02:00041C0A 102C0010        	  3194:     move.b  ($0010,A4),D0
02:00041C0E 6710            	  3195:     beq  _anon_z05_76
02:00041C10 1003            	  3196:     move.b  D3,D0
02:00041C12 023C00EE        	  3197:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C16 123C0004        	  3198:     move.b  #$04,D1
02:00041C1A D101            	  3199:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041C1C 7600            	  3200:     moveq   #0,D3
02:00041C1E 1600            	  3201:     move.b  D0,D3
                            	  3202: _anon_z05_76:
                            	  3203:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3204:     ;
02:00041C20 7000            	  3205:     moveq   #0,D0
                            	  3206: ; Params:
                            	  3207: ; A: mask of buttons to block
                            	  3208: ; Y: offset into BorderBounds
                            	  3209: ; [00]: direction
                            	  3210: ; [02]: coordinate
                            	  3211: ;
                            	  3212: ; Returns:
                            	  3213: ; [01]: button mask that was used
                            	  3214: ;       (set to $FF if boundary not crossed)
                            	  3215: ;
                            	  3216:     even
                            	  3217: MaskInputInBorder:
02:00041C22 19400001        	  3218:     move.b  D0,($0001,A4)
                            	  3219:     ; If direction is positive (right or down), then go handle it separately.
                            	  3220:     ;
02:00041C26 1014            	  3221:     move.b  ($0000,A4),D0
02:00041C28 0200000A        	  3222:     andi.b #$0A,D0
02:00041C2C 6748            	  3223:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3224:     ; The direction is negative (left or up).
                            	  3225:     ;
                            	  3226:     ; If the coordinate does not cross (<) the boundary, then
                            	  3227:     ; go set mask $FF, so that no button is excluded.
                            	  3228:     ;
02:00041C2E 102C0002        	  3229:     move.b  ($0002,A4),D0
02:00041C32 41F900041BA6    	  3230:     lea     (BorderBounds).l,A0
02:00041C38 12303000        	  3231:     move.b  (A0,D3.W),D1
02:00041C3C B001            	  3232:     cmp.b   D1,D0
02:00041C3E 6548            	  3233:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3234:     even
                            	  3235: _L_z05_MaskInputInBorder_MaskButtons:
                            	  3236:     ; The boundary was crossed. Mask buttons.
