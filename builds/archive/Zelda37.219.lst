02:000343EC 666C            	  1678:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1679:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1680:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1681:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:000343EE 7000            	  1682:     moveq   #0,D0
02:000343F0 102C0437        	  1683:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:000343F4 EB48            	  1684:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:000343F6 41F9000341D8    	  1685:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:000343FC D0C0            	  1686:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1687:     ; Set up DynTileBuf header: $3F, $00, $20
02:000343FE 197C003F0302    	  1688:     move.b  #$3F,($0302,A4)
02:00034404 197C00000303    	  1689:     move.b  #$00,($0303,A4)
02:0003440A 7020            	  1690:     moveq   #32,D0
02:0003440C 19400304        	  1691:     move.b  D0,($0304,A4)
                            	  1692:     ; End marker at DynTileBuf+4+31
02:00034410 761F            	  1693:     moveq   #31,D3
02:00034412 103C00FF        	  1694:     move.b  #$FF,D0
02:00034416 43EC0306        	  1695:     lea     ($0306,A4),A1
02:0003441A 13803000        	  1696:     move.b  D0,(A1,D3.W)
