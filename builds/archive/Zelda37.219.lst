02:0004CB2E 53302000        	  6026:     subq.b  #1,(A0,D2.W)
02:0004CB32 6702            	  6027:     beq.s  __far_z_07_0090
02:0004CB34 6036            	  6028:     jmp  DrawBoomerangAndCheckCollision
