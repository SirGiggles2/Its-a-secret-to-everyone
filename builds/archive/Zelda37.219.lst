                            	  7916: UpdatePolsVoice:
02:0003CE44 0C020001        	  7917:     cmpi.b  #$01,D2
                            	  7918:     bne  _anon_z04_96
                            	  7919: _anon_z04_96:
                            	  7920:     ; If we have the magic clock, or is stunned, then
                            	  7921:     ; go draw and check collisions.
                            	  7922:     ;
02:0003CE48 102C066C        	  7923:     move.b  ($066C,A4),D0
02:0003CE4C 1234203D        	  7924:     move.b  ($3D,A4,D2.W),D1
02:0003CE50 8001            	  7925:     or.b  D1,D0
02:0003CE52 660000AE        	  7926:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7927:     ; Every odd screen frame, go straight to drawing
                            	  7928:     ; and checking collisions.
                            	  7929:     ;
02:0003CE56 102C0015        	  7930:     move.b  ($0015,A4),D0
02:0003CE5A E208            	  7931:     lsr.b  #1,D0   ; LSR A
02:0003CE5C 6404            	  7932:     bcc.s  __far_z_04_0073
02:0003CE5E 60000118        	  7933:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7934: __far_z_04_0073:
                            	  7935:     ; Otherwise move horizontally.
                            	  7936:     ;
02:0003CE62 610002A8        	  7937:     jsr     PolsVoice_MoveX
                            	  7938:     ; If state <> 0, then the monster is jumping.
                            	  7939:     ; Go handle vertical movement.
                            	  7940:     ;
02:0003CE66 41EC00AC        	  7941:     lea     ($00AC,A4),A0
02:0003CE6A 10302000        	  7942:     move.b  (A0,D2.W),D0
02:0003CE6E 6706            	  7943:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CE70 61000130        	  7944:     jsr     UpdatePolsVoiceState1_Jumping
02:0003CE74 6034            	  7945:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
