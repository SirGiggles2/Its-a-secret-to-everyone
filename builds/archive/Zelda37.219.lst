02:0003B01E 023C00EE        	  3678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B022 41EC03E4        	  3679:     lea     ($03E4,A4),A0
02:0003B026 12302000        	  3680:     move.b  (A0,D2.W),D1
02:0003B02A D101            	  3681:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B02C 1B00            	  3682:     move.b  D0,-(A5)  ; PHA
                            	  3683:     ; If facing vertically, go draw mirrored.
                            	  3684:     ;
02:0003B02E 41EC0098        	  3685:     lea     ($0098,A4),A0
02:0003B032 10302000        	  3686:     move.b  (A0,D2.W),D0
02:0003B036 0200000C        	  3687:     andi.b #$0C,D0
02:0003B03A 660E            	  3688:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3689:     ; Else draw not mirrored.
