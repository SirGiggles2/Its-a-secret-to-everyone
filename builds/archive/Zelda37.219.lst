02:0003DEE6 19410002        	 10113:     move.b  D1,($0002,A4)
02:0003DEEA 122C0002        	 10114:     move.b  ($0002,A4),D1
02:0003DEEE C200            	 10115:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEF0 6708            	 10116:     beq  _anon_z04_120
02:0003DEF2 41EC0084        	 10117:     lea     ($0084,A4),A0
