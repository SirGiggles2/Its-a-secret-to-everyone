                            	 11224: __far_z_04_0107:
                            	 11225:     ; The segment is not a head nor bottom. So, we can use a
                            	 11226:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11227:     ; that is drawn under Link and the heads.
                            	 11228:     ;
02:0003E728 4EB900031972    	 11229:     jsr     Anim_WriteLevelPaletteSprite
                            	 11230:     even
                            	 11231: Gleeok_CheckCollisions:
                            	 11232:     ; If this segment is not the head nor the bottom of the neck,
                            	 11233:     ; then loop again to process the next segment.
                            	 11234:     ;
                            	 11235:     ; This kind of segment is only drawn, and is not checked
                            	 11236:     ; for object collisions.
                            	 11237:     ;
02:0003E72E 0C020005        	 11238:     cmpi.b  #$05,D2
02:0003E732 670A            	 11239:     beq  _anon_z04_141
02:0003E734 0C020001        	 11240:     cmpi.b  #$01,D2
02:0003E738 6704            	 11241:     beq  _anon_z04_141
02:0003E73A 6000010C        	 11242:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11243: 
                            	 11244: _anon_z04_141:
02:0003E73E 4EB9000319F8    	 11245:     jsr     CheckMonsterCollisions
                            	 11246:     ; If this segment was harmed, then set the writhing counter,
                            	 11247:     ; and the animation counter to its lower value.
                            	 11248:     ;
02:0003E744 41EC00C0        	 11249:     lea     ($00C0,A4),A0
02:0003E748 10302000        	 11250:     move.b  (A0,D2.W),D0
02:0003E74C 670A            	 11251:     beq  _anon_z04_142
02:0003E74E 7006            	 11252:     moveq   #6,D0
02:0003E750 194004E6        	 11253:     move.b  D0,($04E6,A4)
02:0003E754 19400510        	 11254:     move.b  D0,($0510,A4)
                            	 11255: _anon_z04_142:
02:0003E758 4EB90004BC88    	 11256:     jsr     ResetShoveInfo
                            	 11257:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11258:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11259:     ;
02:0003E75E 0C020001        	 11260:     cmpi.b  #$01,D2
02:0003E762 670000DE        	 11261:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E766 6100AFE0        	 11262:     jsr     PlayBossHitCryIfNeeded
                            	 11263:     ; If this neck has not died, then go loop again.
                            	 11264:     ;
02:0003E76A 41EC0405        	 11265:     lea     ($0405,A4),A0
02:0003E76E 10302000        	 11266:     move.b  (A0,D2.W),D0
02:0003E772 670000D4        	 11267:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11268:     ; This neck died. So, prepare to make a flying head.
                            	 11269:     ;
02:0003E776 7060            	 11270:     moveq   #96,D0
02:0003E778 41EC0485        	 11271:     lea     ($0485,A4),A0
02:0003E77C 11802000        	 11272:     move.b  D0,(A0,D2.W)
02:0003E780 1002            	 11273:     move.b  D2,D0
02:0003E782 1B00            	 11274:     move.b  D0,-(A5)  ; PHA
                            	 11275:     ; If the segment is not a head, then skip making a flying head.
                            	 11276:     ;
                            	 11277:     ; TODO:
                            	 11278:     ; But how can we get here in this case, since earlier branches
                            	 11279:     ; would have been taken to skip all this for all other segments?
                            	 11280:     ;
02:0003E784 0C020005        	 11281:     cmpi.b  #$05,D2
02:0003E788 663C            	 11282:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11283:     ; The flying head will go in slot (neck index + 7).
                            	 11284:     ; Switch the X register to it.
                            	 11285:     ;
02:0003E78A 102C04D7        	 11286:     move.b  ($04D7,A4),D0
02:0003E78E 023C00EE        	 11287:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E792 123C0007        	 11288:     move.b  #$07,D1
02:0003E796 D101            	 11289:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E798 7400            	 11290:     moveq   #0,D2
02:0003E79A 1400            	 11291:     move.b  D0,D2
                            	 11292:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11293:     ;
02:0003E79C 103C00FF        	 11294:     move.b  #$FF,D0
02:0003E7A0 41EC0492        	 11295:     lea     ($0492,A4),A0
02:0003E7A4 11802000        	 11296:     move.b  D0,(A0,D2.W)
                            	 11297:     ; Copy the original head's coordinates to it.
                            	 11298:     ;
02:0003E7A8 102C0075        	 11299:     move.b  ($0075,A4),D0
02:0003E7AC 19802070        	 11300:     move.b  D0,($70,A4,D2.W)
02:0003E7B0 102C0089        	 11301:     move.b  ($0089,A4),D0
02:0003E7B4 41EC0084        	 11302:     lea     ($0084,A4),A0
02:0003E7B8 11802000        	 11303:     move.b  D0,(A0,D2.W)
                            	 11304:     ; Set object type $46 (flying head).
                            	 11305:     ;
02:0003E7BC 7046            	 11306:     moveq   #70,D0
02:0003E7BE 41EC034F        	 11307:     lea     ($034F,A4),A0
02:0003E7C2 11802000        	 11308:     move.b  D0,(A0,D2.W)
                            	 11309:     even
                            	 11310: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E7C6 101D            	 11311:     move.b  (A5)+,D0  ; PLA
02:0003E7C8 7400            	 11312:     moveq   #0,D2
02:0003E7CA 1400            	 11313:     move.b  D0,D2
                            	 11314:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11315:     ;
02:0003E7CC 102C04D7        	 11316:     move.b  ($04D7,A4),D0
02:0003E7D0 E308            	 11317:     lsl.b  #1,D0   ; ASL A
02:0003E7D2 E308            	 11318:     lsl.b  #1,D0   ; ASL A
02:0003E7D4 E308            	 11319:     lsl.b  #1,D0   ; ASL A
02:0003E7D6 7600            	 11320:     moveq   #0,D3
02:0003E7D8 1600            	 11321:     move.b  D0,D3
02:0003E7DA 103C00F8        	 11322:     move.b  #$F8,D0
02:0003E7DE 41EC0200        	 11323:     lea     ($0200,A4),A0
02:0003E7E2 11803000        	 11324:     move.b  D0,(A0,D3.W)
02:0003E7E6 41EC0220        	 11325:     lea     ($0220,A4),A0
02:0003E7EA 11803000        	 11326:     move.b  D0,(A0,D3.W)
                            	 11327:     ; Add the bit for this neck to the dead neck mask.
                            	 11328:     ; Copy it to [00].
                            	 11329:     ;
02:0003E7EE 7600            	 11330:     moveq   #0,D3
02:0003E7F0 162C04D7        	 11331:     move.b  ($04D7,A4),D3
02:0003E7F4 41F90004AE94    	 11332:     lea     (LevelMasks).l,A0
02:0003E7FA 10303000        	 11333:     move.b  (A0,D3.W),D0
02:0003E7FE 122C0511        	 11334:     move.b  ($0511,A4),D1
02:0003E802 8001            	 11335:     or.b  D1,D0
02:0003E804 19400511        	 11336:     move.b  D0,($0511,A4)
02:0003E808 1880            	 11337:     move.b  D0,($0000,A4)
                            	 11338:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11339:     ; Count them up, and store the amount in [00].
                            	 11340:     ;
02:0003E80A 7000            	 11341:     moveq   #0,D0
02:0003E80C 7604            	 11342:     moveq   #4,D3
                            	 11343: _anon_z04_143:
02:0003E80E 1214            	 11344:     move.b  ($0000,A4),D1
02:0003E810 E209            	 11345:     lsr.b  #1,D1   ; LSR $00
02:0003E812 1881            	 11346:     move.b  D1,($0000,A4)
02:0003E814 123C0000        	 11347:     move.b  #$00,D1
02:0003E818 D101            	 11348:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E81A 5303            	 11349:     subq.b  #1,D3
02:0003E81C 66F0            	 11350:     bne  _anon_z04_143
02:0003E81E 1880            	 11351:     move.b  D0,($0000,A4)
                            	 11352:     ; Compare the number of dead necks to the original number
                            	 11353:     ; (object type - $41).
                            	 11354:     ;
02:0003E820 102C0350        	 11355:     move.b  ($0350,A4),D0
02:0003E824 003C0011        	 11356:     ori     #$11,CCR  ; SEC: set C+X
02:0003E828 123C0041        	 11357:     move.b  #$41,D1
02:0003E82C 0A3C0010        	 11358:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E830 9101            	 11359:     subx.b  D1,D0   ; SBC #$41
02:0003E832 0A3C0010        	 11360:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E836 1214            	 11361:     move.b  ($0000,A4),D1
02:0003E838 B001            	 11362:     cmp.b   D1,D0
                            	 11363:     ; If they're equal, then go handle the whole boss dying.
                            	 11364:     ;
02:0003E83A 671C            	 11365:     beq  _L_z04_Gleeok_CheckCollisions_BossDied
                            	 11366:     ; Else reset object metastate of the segment, and return.
                            	 11367:     ;
02:0003E83C 4EF90004DB0C    	 11368:     jmp     ResetObjMetastate
                            	 11369: 
                            	 11370:     even
                            	 11371: _L_z04_Gleeok_CheckCollisions_ResetMetastate:
