                            	  4128:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4129:     ;
02:0003B2DE 102C0029        	  4130:     move.b  ($0029,A4),D0
02:0003B2E2 660A            	  4131:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4132:     ; Else go to state 3, and unhalt Link.
                            	  4133:     ;
