02:0003CDBC 4EB9000319F8    	  7847:     jsr     CheckMonsterCollisions
                            	  7848:     ; Darknuts are never stunned.
                            	  7849:     ;
02:0003CDC2 7000            	  7850:     moveq   #0,D0
02:0003CDC4 1980203D        	  7851:     move.b  D0,($3D,A4,D2.W)
02:0003CDC8 7008            	  7852:     moveq   #8,D0
02:0003CDCA 4EB90004D2FE    	  7853:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7854:     ; If facing left, then enable horizontal flipping.
                            	  7855:     ;
02:0003CDD0 41EC0098        	  7856:     lea     ($0098,A4),A0
02:0003CDD4 10302000        	  7857:     move.b  (A0,D2.W),D0
02:0003CDD8 0C000002        	  7858:     cmpi.b  #$02,D0
02:0003CDDC 6604            	  7859:     bne  _anon_z04_94
02:0003CDDE 522C000F        	  7860:     addq.b  #1,($000F,A4)
                            	  7861: _anon_z04_94:
                            	  7862:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7863:     ; This is the base frame image.
                            	  7864:     ;
02:0003CDE2 E208            	  7865:     lsr.b  #1,D0   ; LSR A
02:0003CDE4 E208            	  7866:     lsr.b  #1,D0   ; LSR A
                            	  7867:     ; If movement frame = 1, add 3 to frame image to access
                            	  7868:     ; the second animation frame's images.
                            	  7869:     ;
02:0003CDE6 7600            	  7870:     moveq   #0,D3
02:0003CDE8 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003CDEC 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003CDF0 671E            	  7873:     beq  _anon_z04_95
02:0003CDF2 023C00EE        	  7874:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDF6 123C0003        	  7875:     move.b  #$03,D1
02:0003CDFA D101            	  7876:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7877:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7878:     ;
                            	  7879:     ; Down has two frame images, but up only has one. By flipping
                            	  7880:     ; horizontally, you get two frame images.
                            	  7881:     ;
02:0003CDFC 7600            	  7882:     moveq   #0,D3
02:0003CDFE 41EC0098        	  7883:     lea     ($0098,A4),A0
02:0003CE02 16302000        	  7884:     move.b  (A0,D2.W),D3
02:0003CE06 0C030008        	  7885:     cmpi.b  #$08,D3
02:0003CE0A 6604            	  7886:     bne  _anon_z04_95
02:0003CE0C 522C000F        	  7887:     addq.b  #1,($000F,A4)
