02:0004125A 673E            	  1898:     beq  _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1899:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1900:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1901:     ;
02:0004125C 7600            	  1902:     moveq   #0,D3
02:0004125E 102C0098        	  1903:     move.b  ($0098,A4),D0
02:00041262 02000003        	  1904:     andi.b #$03,D0
02:00041266 670E            	  1905:     beq  _L_z05_InitMode_EnterRoom_ChooseWalkDistance
02:00041268 02000001        	  1906:     andi.b #$01,D0
