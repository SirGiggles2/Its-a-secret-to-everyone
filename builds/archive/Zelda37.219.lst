                            	  2750: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2751:     ; Set state 1 to jump.
                            	  2752:     ;
02:0003A92E 41EC00AC        	  2753:     lea     ($00AC,A4),A0
