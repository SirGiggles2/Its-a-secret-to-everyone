02:00041F6C 194000C0        	  3715:     move.b  D0,($00C0,A4)
02:00041F70 194000D3        	  3716:     move.b  D0,($00D3,A4)
02:00041F74 194004F0        	  3717:     move.b  D0,($04F0,A4)
