                            	  2160: _L_z04_CheckZora_LoopTileCandidate:
                            	  2161:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2162:     ; If it = 0 or $F0, go loop again.
                            	  2163:     ;
