02:00031B8C 600000E0        	  6728:     jmp  L73A9_Exit
                            	  6729: __far_z_01_0062:
                            	  6730:     ; If the object is a monster's shot/projectile, and it's not in a
                            	  6731:     ; state that it can do damage; then return no collision.
