                            	  1994: _L_z01_TransferDemoPatterns_LoopBlock:
                            	  1995:     ; Loop over each block.
                            	  1996:     ;
02:0002E9B6 102C051D        	  1997:     move.b  ($051D,A4),D0
02:0002E9BA E308            	  1998:     lsl.b  #1,D0   ; ASL A
02:0002E9BC 7400            	  1999:     moveq   #0,D2
02:0002E9BE 1400            	  2000:     move.b  D0,D2
                            	  2001:     ; Put block address in [00:01] and size in [03:02].
                            	  2002:     ; Load destination VRAM address and set it.
                            	  2003:     ; The size and VRAM address have the high byte first.
                            	  2004:     ;
02:0002E9C0 41F90002E99A    	  2005:     lea     (DemoPatternBlockAddrs).l,A0
02:0002E9C6 3A02            	  2006:     move.w  D2,D5
02:0002E9C8 DA45            	  2007:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0002E9CA 2A305000        	  2008:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002E9CE 29450004        	  2009:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002E9D2 41F90002E9A2    	  2010:     lea     (DemoPatternBlockSizes).l,A0
02:0002E9D8 10302000        	  2011:     move.b  (A0,D2.W),D0
02:0002E9DC 19400002        	  2012:     move.b  D0,($0002,A4)
02:0002E9E0 41F90002E9A6    	  2013:     lea     (DemoPatternVramAddrs).l,A0
02:0002E9E6 10302000        	  2014:     move.b  (A0,D2.W),D0
02:0002E9EA 4EB90000E32C    	  2015:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0002E9F0 5202            	  2016:     addq.b  #1,D2
                            	  2017:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:0002E9F2 41F90002E9A2    	  2018:     lea     (DemoPatternBlockSizes).l,A0
