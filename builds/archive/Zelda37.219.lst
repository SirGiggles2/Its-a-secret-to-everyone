                            	 11389: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11390:     ; The whole gleeok died, because the last neck died.
                            	 11391:     ;
                            	 11392:     ; First, hide the first $10 sprites: the attached heads.
                            	 11393:     ;
