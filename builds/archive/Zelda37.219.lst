02:0002E788 4A02            	  1733:     cmpi.b  #$00,D2
02:0002E78A 671C            	  1734:     beq  _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithHeartContainer
                            	  1735:     ; The player chose the money.
                            	  1736:     ; But if he doesn't have enough, then return.
                            	  1737:     ;
02:0002E78C 7032            	  1738:     moveq   #50,D0
02:0002E78E 122C066D        	  1739:     move.b  ($066D,A4),D1
02:0002E792 B001            	  1740:     cmp.b   D1,D0
02:0002E794 6702            	  1741:     beq  _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithMoney
02:0002E796 64EE            	  1742:     bcc  _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_Exit
                            	  1743:     even
                            	  1744: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithMoney:
                            	  1745:     ; Post 50 rupees more to subtract, and go flag this offer taken.
                            	  1746:     ;
02:0002E798 023C00EE        	  1747:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E79C 122C067E        	  1748:     move.b  ($067E,A4),D1
02:0002E7A0 D101            	  1749:     addx.b  D1,D0   ; ADC RupeesToSubtract
02:0002E7A2 1940067E        	  1750:     move.b  D0,($067E,A4)
02:0002E7A6 605C            	  1751:     jmp     _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_EndLifeOrMoney
                            	  1752: 
