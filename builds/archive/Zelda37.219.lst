                            	  6793: __far_z_01_0068:
                            	  6794:     ; If Link and the shot are not facing opposite directions,
                            	  6795:     ; then go harm Link.
                            	  6796:     ;
                            	  6797:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6798:     ; component of a monster that can move diagonally.
                            	  6799:     ;
02:00031C14 102C0098        	  6800:     move.b  ($0098,A4),D0
02:00031C18 41EC0098        	  6801:     lea     ($0098,A4),A0
02:00031C1C 12302000        	  6802:     move.b  (A0,D2.W),D1
02:00031C20 8001            	  6803:     or.b  D1,D0
02:00031C22 0200000C        	  6804:     andi.b #$0C,D0
02:00031C26 0C00000C        	  6805:     cmpi.b  #$0C,D0
02:00031C2A 671A            	  6806:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031C2C 102C0098        	  6807:     move.b  ($0098,A4),D0
02:00031C30 41EC0098        	  6808:     lea     ($0098,A4),A0
02:00031C34 12302000        	  6809:     move.b  (A0,D2.W),D1
02:00031C38 8001            	  6810:     or.b  D1,D0
02:00031C3A 02000003        	  6811:     andi.b #$03,D0
02:00031C3E 0C000003        	  6812:     cmpi.b  #$03,D0
02:00031C42 6702            	  6813:     beq.s  __far_z_01_0069
02:00031C44 602A            	  6814:     jmp  HarmLink
