                            	   368: ;------------------------------------------------------------------------------
                            	   369: ; _c_move_object_shim — MoveObject trampoline.
                            	   370: ;
                            	   371: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   372: ;   Input:     D2 = slot (0..11)
                            	   373: ;   Preserves: D2, A4, A5
                            	   374: ;   Clobbers:  D0, D1, D3, A0
                            	   375: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   376: ;
                            	   377: ; GCC side:
                            	   378: ;   void c_move_object(unsigned short slot);
                            	   379: ;     slot arrives as a 16-bit value on the stack.
                            	   380: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   381: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   382: ;   never clobbered by gcc.
                            	   383: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   384: ;   semantics can exist in a pure C port).
                            	   385: ;------------------------------------------------------------------------------
                            	   386: _c_move_object_shim:
                            	   387:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   388:     move.b  #$AA,($0900,A4)
                            	   389:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   390:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   391:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   392:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   393:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   394:     moveq   #0,D0
02:0002B658 3002            	   395:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   396:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   397:     jsr     c_move_object
02:0002B662 588F            	   398:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   399:     rts
                            	   400: 
                            	   401: ;==============================================================================
                            	   402: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   403: ; and tail-call the native asm function.
                            	   404: ;
                            	   405: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   406: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   407: ; sign-extended).
                            	   408: ;==============================================================================
                            	   409: 
                            	   410: ;------------------------------------------------------------------------------
                            	   411: ; void c_copy_bank_to_window(unsigned int bank);
                            	   412: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   413: ;------------------------------------------------------------------------------
                            	   414: c_copy_bank_to_window:
02:0002B666 202F0004        	   415:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   416:     jmp     _copy_bank_to_window
                            	   417: 
                            	   418: ;------------------------------------------------------------------------------
                            	   419: ; unsigned char c_ppu_read_2(void);
                            	   420: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   421: ; C return: gcc expects result in D0.
                            	   422: ;------------------------------------------------------------------------------
                            	   423: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   424:     jmp     _ppu_read_2
                            	   425: 
                            	   426: ;------------------------------------------------------------------------------
                            	   427: ; void c_ppu_write_6(unsigned int val);
                            	   428: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   429: ;------------------------------------------------------------------------------
                            	   430: c_ppu_write_6:
02:0002B674 202F0004        	   431:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   432:     jmp     _ppu_write_6
                            	   433: 
                            	   434: ;------------------------------------------------------------------------------
                            	   435: ; void c_ppu_write_7(unsigned int val);
                            	   436: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   437: ;------------------------------------------------------------------------------
                            	   438: c_ppu_write_7:
02:0002B67E 202F0004        	   439:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   440:     jmp     _ppu_write_7
                            	   441: 
                            	   442: ;------------------------------------------------------------------------------
