02:00032182 023C00EE        	  7664:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032186 123C0006        	  7665:     move.b  #$06,D1
02:0003218A D101            	  7666:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:0003218C 19400004        	  7667:     move.b  D0,($0004,A4)
02:00032190 41EC0084        	  7668:     lea     ($0084,A4),A0
02:00032194 10303000        	  7669:     move.b  (A0,D3.W),D0
02:00032198 023C00EE        	  7670:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003219C 123C0008        	  7671:     move.b  #$08,D1
02:000321A0 D101            	  7672:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321A2 6024            	  7673:     jmp     _anon_z01_98
                            	  7674: 
                            	  7675:     even
                            	  7676: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7677:     ; Else Link is facing horizontally.
                            	  7678:     ; [04] := (weapon X + 8)
                            	  7679:     ; A    := (weapon Y + 6)
                            	  7680:     ;
                            	  7681:     ; Shouldn't it be based on the weapon's direction?
                            	  7682:     ;
02:000321A4 10343070        	  7683:     move.b  ($70,A4,D3.W),D0
02:000321A8 023C00EE        	  7684:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321AC 123C0008        	  7685:     move.b  #$08,D1
02:000321B0 D101            	  7686:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321B2 19400004        	  7687:     move.b  D0,($0004,A4)
02:000321B6 41EC0084        	  7688:     lea     ($0084,A4),A0
02:000321BA 10303000        	  7689:     move.b  (A0,D3.W),D0
02:000321BE 023C00EE        	  7690:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321C2 123C0006        	  7691:     move.b  #$06,D1
02:000321C6 D101            	  7692:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7693: _anon_z01_98:
                            	  7694:     ; The A register will be copied to [05] and used here.
                            	  7695:     ;
02:000321C8 6000FC0A        	  7696:     jmp     CheckMonsterWeaponCollision
                            	  7697: 
                            	  7698: ; Params:
                            	  7699: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7700: ; [00]: weapon object slot (unused)
                            	  7701: ; [02]: object 1 mid X
                            	  7702: ; [03]: object 1 mid Y
                            	  7703: ; [04]: object 2 mid X
                            	  7704: ; [05]: object 2 mid Y
                            	  7705: ;
                            	  7706: ; Returns:
                            	  7707: ; A: 1 if objects collide
                            	  7708: ; Y: weapon object slot
                            	  7709: ; Z: 0 if objects collide
                            	  7710: ; [06]: 1 if objects collide
                            	  7711: ; [0A]: horizontal distance
                            	  7712: ; [0B]: vertical distance
                            	  7713: ;
                            	  7714: ;
                            	  7715: ; Use the same threshold value horizontally and vertically.
                            	  7716: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7717: ;
                            	  7718:     even
                            	  7719: DoObjectsCollide:
02:000321CC 1940000D        	  7720:     move.b  D0,($000D,A4)
02:000321D0 1940000E        	  7721:     move.b  D0,($000E,A4)
                            	  7722: ; Params:
                            	  7723: ; [00]: weapon or Link object slot (unused)
                            	  7724: ; [02]: object 1 mid X
                            	  7725: ; [03]: object 1 mid Y
                            	  7726: ; [04]: object 2 mid X
                            	  7727: ; [05]: object 2 mid Y
                            	  7728: ; [0D]: horizontal threshold
                            	  7729: ; [0E]: vertical threshold
                            	  7730: ;
                            	  7731: ; Returns:
                            	  7732: ; A: 1 if objects collide
                            	  7733: ; Y: weapon or Link object slot (copied from [00])
                            	  7734: ; Z: 0 if objects collide
                            	  7735: ; [06]: 1 if objects collide
                            	  7736: ; [0A]: horizontal distance
                            	  7737: ; [0B]: vertical distance
                            	  7738: ;
                            	  7739: ;
                            	  7740: ; Reset [06] to indicate no collision by default.
                            	  7741: ;
                            	  7742:     even
                            	  7743: DoObjectsCollideWithThresholds:
02:000321D4 7000            	  7744:     moveq   #0,D0
02:000321D6 19400006        	  7745:     move.b  D0,($0006,A4)
02:000321DA 7600            	  7746:     moveq   #0,D3
02:000321DC 1614            	  7747:     move.b  ($0000,A4),D3
                            	  7748:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7749:     ;
02:000321DE 102C0002        	  7750:     move.b  ($0002,A4),D0
02:000321E2 003C0011        	  7751:     ori     #$11,CCR  ; SEC: set C+X
02:000321E6 122C0004        	  7752:     move.b  ($0004,A4),D1
02:000321EA 0A3C0010        	  7753:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321EE 9101            	  7754:     subx.b  D1,D0   ; SBC $04
02:000321F0 0A3C0010        	  7755:     eori    #$10,CCR  ; restore X = 6502 C
02:000321F4 6100E8C0        	  7756:     jsr     Abs
02:000321F8 1940000A        	  7757:     move.b  D0,($000A,A4)
                            	  7758:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7759:     ;
02:000321FC 122C000D        	  7760:     move.b  ($000D,A4),D1
02:00032200 B001            	  7761:     cmp.b   D1,D0
02:00032202 642A            	  7762:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7763:     ; Store in [0B] the vertical distance between the two objects.
                            	  7764:     ;
02:00032204 102C0003        	  7765:     move.b  ($0003,A4),D0
02:00032208 003C0011        	  7766:     ori     #$11,CCR  ; SEC: set C+X
02:0003220C 122C0005        	  7767:     move.b  ($0005,A4),D1
02:00032210 0A3C0010        	  7768:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032214 9101            	  7769:     subx.b  D1,D0   ; SBC $05
02:00032216 0A3C0010        	  7770:     eori    #$10,CCR  ; restore X = 6502 C
02:0003221A 6100E89A        	  7771:     jsr     Abs
02:0003221E 1940000B        	  7772:     move.b  D0,($000B,A4)
                            	  7773:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7774:     ;
02:00032222 122C000E        	  7775:     move.b  ($000E,A4),D1
02:00032226 B001            	  7776:     cmp.b   D1,D0
02:00032228 6404            	  7777:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7778:     ; If we get here, then the objects are close enough in both axes.
                            	  7779:     ; Return 1.
                            	  7780:     ;
02:0003222A 522C0006        	  7781:     addq.b  #1,($0006,A4)
                            	  7782:     even
                            	  7783: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:0003222E 102C0006        	  7784:     move.b  ($0006,A4),D0
02:00032232 4E75            	  7785:     rts
                            	  7786: 
                            	  7787: ; Params:
                            	  7788: ; X: caller's object index, a monster
                            	  7789: ;    the attacker, if monster attacks Link
                            	  7790: ;    else defender, if weapon attacks monster
                            	  7791: ; [00]: 0 if monster attacks Link (defender),
                            	  7792: ;       else weapon slot (attacker)
                            	  7793: ; [09]: damage type,
                            	  7794: ;       only if a monster is defending
                            	  7795: ; TODO:
                            	  7796: ; [0B]: direction
                            	  7797: ;
                            	  7798: ; Only monsters (and fire) call this routine.
                            	  7799: ;
                            	  7800: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7801: ;
                            	  7802: ; On the other hand, if a weapon attacks a monster,
                            	  7803: ; the monster sets [00] to the weapon's slot.
                            	  7804: ;
                            	  7805: ;
                            	  7806: ; If a weapon attacks a monster, and the weapon's damage
                            	  7807: ; type matches the monster's invincibility mask;
                            	  7808: ; then return without shoving.
                            	  7809: ;
                            	  7810: ; If a monster attacks Link, then damage type will be 0.
                            	  7811: ;
                            	  7812:     even
                            	  7813: BeginShove:
02:00032234 7600            	  7814:     moveq   #0,D3
02:00032236 1614            	  7815:     move.b  ($0000,A4),D3
02:00032238 0C02000D        	  7816:     cmpi.b  #$0D,D2
02:0003223C 6412            	  7817:     bcc  _anon_z01_99
02:0003223E 41EC04B2        	  7818:     lea     ($04B2,A4),A0
02:00032242 10302000        	  7819:     move.b  (A0,D2.W),D0
02:00032246 122C0009        	  7820:     move.b  ($0009,A4),D1
02:0003224A C001            	  7821:     and.b  D1,D0
02:0003224C 660000C4        	  7822:     bne  _L_z01_BeginShove_Exit
                            	  7823: _anon_z01_99:
                            	  7824:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7825:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7826:     ;
                            	  7827:     ; If instead a monster is defending, then all this calculation
                            	  7828:     ; won't matter, because the shove direction will be set to the
                            	  7829:     ; weapon's direction.
                            	  7830:     ;
                            	  7831:     ; As such, calculate a direction from the monster to the defender,
                            	  7832:     ; assuming it's Link.
                            	  7833:     ;
                            	  7834:     ; Start with an assumption that the direction is vertical:
                            	  7835:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7836:     ;
02:00032250 7008            	  7837:     moveq   #8,D0
02:00032252 19400008        	  7838:     move.b  D0,($0008,A4)
02:00032256 41EC0084        	  7839:     lea     ($0084,A4),A0
02:0003225A 10302000        	  7840:     move.b  (A0,D2.W),D0
02:0003225E 19400004        	  7841:     move.b  D0,($0004,A4)
02:00032262 41EC0084        	  7842:     lea     ($0084,A4),A0
02:00032266 10303000        	  7843:     move.b  (A0,D3.W),D0
02:0003226A 19400005        	  7844:     move.b  D0,($0005,A4)
                            	  7845:     ; If the defender is Link and his grid offset <> 0 then
                            	  7846:     ; use his usual object direction variable to determine
                            	  7847:     ; which axis to check.
                            	  7848:     ;
02:0003226E 4A03            	  7849:     cmpi.b  #$00,D3
02:00032270 6612            	  7850:     bne  _anon_z01_100
02:00032272 102C0394        	  7851:     move.b  ($0394,A4),D0
02:00032276 670C            	  7852:     beq  _anon_z01_100
02:00032278 102C0098        	  7853:     move.b  ($0098,A4),D0
02:0003227C 02000003        	  7854:     andi.b #$03,D0
02:00032280 660C            	  7855:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032282 6720            	  7856:     beq  _L_z01_BeginShove_CheckVertical
                            	  7857: _anon_z01_100:
                            	  7858:     ; For monsters defending, or Link with grid offset = 0,
                            	  7859:     ; check direction in [0B].
                            	  7860:     ;
                            	  7861:     ; For monsters defending, this won't matter. For Link with grid
                            	  7862:     ; offset = 0, I believe the result will be arbitrary.
                            	  7863:     ;
                            	  7864:     ; TODO:
                            	  7865:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7866:     ; It doesn't seem to be if candle fire attacks him.
                            	  7867:     ;
02:00032284 102C000B        	  7868:     move.b  ($000B,A4),D0
02:00032288 0C000004        	  7869:     cmpi.b  #$04,D0
02:0003228C 6416            	  7870:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7871:     even
                            	  7872: _L_z01_BeginShove_CheckHorizontal:
                            	  7873:     ; If the direction checked is left or right,
                            	  7874:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7875:     ;
02:0003228E 7002            	  7876:     moveq   #2,D0
02:00032290 19400008        	  7877:     move.b  D0,($0008,A4)
02:00032294 10342070        	  7878:     move.b  ($70,A4,D2.W),D0
02:00032298 19400004        	  7879:     move.b  D0,($0004,A4)
02:0003229C 10343070        	  7880:     move.b  ($70,A4,D3.W),D0
02:000322A0 19400005        	  7881:     move.b  D0,($0005,A4)
                            	  7882:     even
                            	  7883: _L_z01_BeginShove_CheckVertical:
                            	  7884:     ; If the monster is down or right of the other object,
                            	  7885:     ; then use the opposite direction already in [08].
                            	  7886:     ; Else shift [08] right to turn it into the opposite
                            	  7887:     ; direction up or down.
                            	  7888:     ;
                            	  7889:     ; Again assuming Link is the defender; after this, [08] points
                            	  7890:     ; Link away from the monster.
                            	  7891:     ;
02:000322A4 102C0004        	  7892:     move.b  ($0004,A4),D0
02:000322A8 122C0005        	  7893:     move.b  ($0005,A4),D1
02:000322AC B001            	  7894:     cmp.b   D1,D0
02:000322AE 640A            	  7895:     bcc  _anon_z01_101
02:000322B0 122C0008        	  7896:     move.b  ($0008,A4),D1
02:000322B4 E209            	  7897:     lsr.b  #1,D1   ; LSR $08
02:000322B6 19410008        	  7898:     move.b  D1,($0008,A4)
                            	  7899: _anon_z01_101:
                            	  7900:     ; If a monster is the defender, go handle it separately.
                            	  7901:     ;
02:000322BA 4A03            	  7902:     cmpi.b  #$00,D3
02:000322BC 6656            	  7903:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7904:     ; Link is the defender.
                            	  7905:     ;
                            	  7906:     ; If Link is invincible, return without shoving.
                            	  7907:     ;
02:000322BE 102C04F0        	  7908:     move.b  ($04F0,A4),D0
02:000322C2 664E            	  7909:     bne  _L_z01_BeginShove_Exit
                            	  7910:     ; Store the shove direction we determined.
                            	  7911:     ;
                            	  7912:     ; Turn on the high bit to indicate that the next time we try to
                            	  7913:     ; move by shoving, it will be the first time for this shove action.
                            	  7914:     ;
02:000322C4 102C0008        	  7915:     move.b  ($0008,A4),D0
02:000322C8 00000080        	  7916:     ori.b #$80,D0
02:000322CC 194000C0        	  7917:     move.b  D0,($00C0,A4)
                            	  7918:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7919:     ;
02:000322D0 7018            	  7920:     moveq   #24,D0
02:000322D2 194004F0        	  7921:     move.b  D0,($04F0,A4)
02:000322D6 7020            	  7922:     moveq   #32,D0
02:000322D8 194000D3        	  7923:     move.b  D0,($00D3,A4)
                            	  7924:     ; If Link was shoved by one of his own weapons, then
                            	  7925:     ; nothing else to do. Return.
                            	  7926:     ;
02:000322DC 0C02000D        	  7927:     cmpi.b  #$0D,D2
02:000322E0 6430            	  7928:     bcc  _L_z01_BeginShove_Exit
                            	  7929:     ; Link was shoved by a monster.
                            	  7930:     ;
                            	  7931:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7932:     ; then return.
                            	  7933:     ;
02:000322E2 41EC04BF        	  7934:     lea     ($04BF,A4),A0
02:000322E6 10302000        	  7935:     move.b  (A0,D2.W),D0
02:000322EA 02000080        	  7936:     andi.b #$80,D0
02:000322EE 6622            	  7937:     bne  _L_z01_BeginShove_Exit
                            	  7938:     ; If the attacker is a vire, then return.
                            	  7939:     ;
02:000322F0 41EC034F        	  7940:     lea     ($034F,A4),A0
02:000322F4 10302000        	  7941:     move.b  (A0,D2.W),D0
02:000322F8 0C000012        	  7942:     cmpi.b  #$12,D0
02:000322FC 6714            	  7943:     beq  _L_z01_BeginShove_Exit
                            	  7944:     ; Turn the attacker in the opposite direction.
                            	  7945:     ;
02:000322FE 41EC0098        	  7946:     lea     ($0098,A4),A0
02:00032302 10302000        	  7947:     move.b  (A0,D2.W),D0
02:00032306 6100E7AA        	  7948:     jsr     GetOppositeDir
02:0003230A 41EC0098        	  7949:     lea     ($0098,A4),A0
02:0003230E 11802000        	  7950:     move.b  D0,(A0,D2.W)
                            	  7951:     even
                            	  7952: _L_z01_BeginShove_Exit:
02:00032312 4E75            	  7953:     rts
                            	  7954: 
                            	  7955:     even
                            	  7956: _L_z01_BeginShove_MonsterDefender:
                            	  7957:     ; A monster is the defender. A weapon is the attacker.
                            	  7958:     ;
                            	  7959:     ; Set the shove direction to the weapon's direction,
                            	  7960:     ; instead of the direction passed in [0B].
                            	  7961:     ;
02:00032314 41EC0098        	  7962:     lea     ($0098,A4),A0
02:00032318 10303000        	  7963:     move.b  (A0,D3.W),D0
02:0003231C 19400008        	  7964:     move.b  D0,($0008,A4)
                            	  7965:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7966:     ; combine the shove direction with $40.
                            	  7967:     ;
                            	  7968:     ; TODO:
                            	  7969:     ; But the shoving routing doesn't read this flag.
                            	  7970:     ;
02:00032320 41EC04BF        	  7971:     lea     ($04BF,A4),A0
02:00032324 10302000        	  7972:     move.b  (A0,D2.W),D0
02:00032328 02000080        	  7973:     andi.b #$80,D0
02:0003232C 670C            	  7974:     beq  _anon_z01_102
02:0003232E 102C0008        	  7975:     move.b  ($0008,A4),D0
02:00032332 00000040        	  7976:     ori.b #$40,D0
02:00032336 19400008        	  7977:     move.b  D0,($0008,A4)
                            	  7978: _anon_z01_102:
                            	  7979:     ; If the monster is invincible, then return without shoving.
                            	  7980:     ;
02:0003233A 41EC04F0        	  7981:     lea     ($04F0,A4),A0
02:0003233E 10302000        	  7982:     move.b  (A0,D2.W),D0
02:00032342 6656            	  7983:     bne  _L_z01_BeginShove_Exit2
                            	  7984:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7985:     ;
02:00032344 41EC034F        	  7986:     lea     ($034F,A4),A0
02:00032348 10302000        	  7987:     move.b  (A0,D2.W),D0
02:0003234C 0C000033        	  7988:     cmpi.b  #$33,D0
02:00032350 6706            	  7989:     beq  _L_z01_BeginShove_Gohma
02:00032352 0C000034        	  7990:     cmpi.b  #$34,D0
02:00032356 661E            	  7991:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7992:     even
                            	  7993: _L_z01_BeginShove_Gohma:
                            	  7994:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7995:     ; then return, so that the hit doesn't register.
                            	  7996:     ;
02:00032358 102C000F        	  7997:     move.b  ($000F,A4),D0
02:0003235C 0C000003        	  7998:     cmpi.b  #$03,D0
02:00032360 6706            	  7999:     beq  _anon_z01_103
02:00032362 0C000004        	  8000:     cmpi.b  #$04,D0
02:00032366 6632            	  8001:     bne  _L_z01_BeginShove_Exit2
                            	  8002: _anon_z01_103:
                            	  8003:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  8004:     ;
02:00032368 41EC046B        	  8005:     lea     ($046B,A4),A0
02:0003236C 10302000        	  8006:     move.b  (A0,D2.W),D0
02:00032370 0C000003        	  8007:     cmpi.b  #$03,D0
02:00032374 6624            	  8008:     bne  _L_z01_BeginShove_Exit2
                            	  8009:     even
                            	  8010: _L_z01_BeginShove_SetShoveDir:
                            	  8011:     ; Store the shove direction for the monster.
                            	  8012:     ;
                            	  8013:     ; Turn on the high bit to indicate that the next time we try to
                            	  8014:     ; move by shoving, it will be the first time for this shove action.
                            	  8015:     ;
02:00032376 102C0008        	  8016:     move.b  ($0008,A4),D0
