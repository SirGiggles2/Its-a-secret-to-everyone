                            	  4887: UpdatePeaceTextbox:
                            	  4888:     ; Only emit a character once every 8 frames --
                            	  4889:     ; when (counter [0412] MOD 8) = 4.
                            	  4890:     ;
02:000364AC 522C0412        	  4891:     addq.b  #1,($0412,A4)
02:000364B0 102C0412        	  4892:     move.b  ($0412,A4),D0
02:000364B4 02000007        	  4893:     andi.b #$07,D0
02:000364B8 0C000004        	  4894:     cmpi.b  #$04,D0
02:000364BC 665C            	  4895:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4896:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4897:     ; to the dynamic transfer buf.
                            	  4898:     ;
02:000364BE 7604            	  4899:     moveq   #4,D3
                            	  4900: _anon_z02_35:
02:000364C0 41F90003643C    	  4901:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:000364C6 10303000        	  4902:     move.b  (A0,D3.W),D0
02:000364CA 41EC0302        	  4903:     lea     ($0302,A4),A0
02:000364CE 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:000364D2 5303            	  4905:     subq.b  #1,D3
02:000364D4 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:000364D6 7600            	  4910:     moveq   #0,D3
02:000364D8 162C0413        	  4911:     move.b  ($0413,A4),D3
02:000364DC 41F900036476    	  4912:     lea     (PeaceText).l,A0
02:000364E2 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000364E6 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:000364EA 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000364EC 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
02:000364F0 0C000024        	  4920:     cmpi.b  #$24,D0
02:000364F4 6706            	  4921:     beq  _anon_z02_36
02:000364F6 7010            	  4922:     moveq   #16,D0
02:000364F8 19400604        	  4923:     move.b  D0,($0604,A4)
                            	  4924: _anon_z02_36:
                            	  4925:     ; Point to the next character in the string.
                            	  4926:     ;
02:000364FC 522C0413        	  4927:     addq.b  #1,($0413,A4)
                            	  4928:     ; Replace the low byte of the VRAM address with the one
                            	  4929:     ; where the next character should be written.
                            	  4930:     ;
02:00036500 41F900036442    	  4931:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00036506 10303000        	  4932:     move.b  (A0,D3.W),D0
02:0003650A 19400303        	  4933:     move.b  D0,($0303,A4)
                            	  4934:     ; Once the low VRAM address rolls over,
                            	  4935:     ; increment the high address.
