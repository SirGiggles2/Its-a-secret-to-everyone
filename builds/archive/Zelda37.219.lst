                            	  2302: __far_z_04_0019:
02:0003A66C 61000592        	  2303:     jsr     UpdateBurrower
                            	  2304:     ; If zora died in the call above, then it happened while in
                            	  2305:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2306:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2307:     ; not come back after killing it.
                            	  2308:     ;
                            	  2309:     ; If state <> 3 or timer <> $FD,
                            	  2310:     ; then go see if the object needs to be destroyed.
                            	  2311:     ;
02:0003A670 41EC00AC        	  2312:     lea     ($00AC,A4),A0
02:0003A674 10302000        	  2313:     move.b  (A0,D2.W),D0
02:0003A678 0C000003        	  2314:     cmpi.b  #$03,D0
02:0003A67C 6616            	  2315:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003A67E 10342028        	  2316:     move.b  ($28,A4,D2.W),D0
02:0003A682 0C0000FD        	  2317:     cmpi.b  #$FD,D0
02:0003A686 660C            	  2318:     bne  _L_z04_UpdateZora_DestroyWhenDone
