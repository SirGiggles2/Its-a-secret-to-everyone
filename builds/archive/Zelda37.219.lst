                            	  4550:     even
                            	  4551: UpdateZeldaTextbox:
02:000361E4 4EB90004C234    	  4552:     jsr     Link_EndMoveAndDraw
                            	  4553:     ; If Zelda's timer has not expired, then return.
                            	  4554:     ;
02:000361EA 102C0029        	  4555:     move.b  ($0029,A4),D0
02:000361EE 6704            	  4556:     beq.s  __far_z_02_0009
02:000361F0 600000C6        	  4557:     jmp  LA9F4_Exit
                            	  4558: __far_z_02_0009:
                            	  4559:     ; Set the timer to wait 6 frames after the next character about
                            	  4560:     ; to be shown.
                            	  4561:     ;
02:000361F4 7006            	  4562:     moveq   #6,D0
02:000361F6 19400029        	  4563:     move.b  D0,($0029,A4)
                            	  4564:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4565:     ; to the dynamic transfer buf.
                            	  4566:     ;
02:000361FA 7604            	  4567:     moveq   #4,D3
                            	  4568: _anon_z02_31:
02:000361FC 41F9000361DA    	  4569:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00036202 10303000        	  4570:     move.b  (A0,D3.W),D0
02:00036206 41EC0302        	  4571:     lea     ($0302,A4),A0
02:0003620A 11803000        	  4572:     move.b  D0,(A0,D3.W)
02:0003620E 5303            	  4573:     subq.b  #1,D3
02:00036210 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:00036212 102C045F        	  4579:     move.b  ($045F,A4),D0
02:00036216 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:0003621A 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:0003621E 7000            	  4584:     moveq   #0,D0
02:00036220 1880            	  4585:     move.b  D0,($0000,A4)
02:00036222 7000            	  4586:     moveq   #0,D0
02:00036224 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:00036228 7600            	  4590:     moveq   #0,D3
02:0003622A 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:0003622E 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:00036232 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:00036234 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:00036238 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003623C E14C            	  4601:     lsl.w   #8,D4
02:0003623E 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036240 48C4            	  4603:     ext.l   D4
02:00036242 D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036248 2044            	  4605:     movea.l D4,A0
02:0003624A 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:0003624E 0200003F        	  4611:     andi.b #$3F,D0
02:00036252 0C000025        	  4612:     cmpi.b  #$25,D0
02:00036256 67BA            	  4613:     beq  _anon_z02_32
                            	  4614:     ; We have a non-space character. Put it in the transfer record.
                            	  4615:     ;
02:00036258 19400305        	  4616:     move.b  D0,($0305,A4)
                            	  4617:     ; Play the "heart taken/character" tune.
                            	  4618:     ;
02:0003625C 7010            	  4619:     moveq   #16,D0
02:0003625E 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:00036262 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:00036264 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:00036268 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003626C E14C            	  4626:     lsl.w   #8,D4
02:0003626E 8841            	  4627:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036270 48C4            	  4628:     ext.l   D4
02:00036272 D8BC00FF0000    	  4629:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036278 2044            	  4630:     movea.l D4,A0
02:0003627A 10303000        	  4631:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003627E 020000C0        	  4632:     andi.b #$C0,D0
02:00036282 6602            	  4633:     bne.s  __far_z_02_0010
02:00036284 6032            	  4634:     jmp  LA9F4_Exit
                            	  4635: __far_z_02_0010:
                            	  4636:     ; Determine an index based on the high 2 bits of the character element:
                            	  4637:     ;   $80: 0
                            	  4638:     ;   $40: 1
                            	  4639:     ;   $C0: 2
                            	  4640:     ;
02:00036286 7602            	  4641:     moveq   #2,D3
02:00036288 0C0000C0        	  4642:     cmpi.b  #$C0,D0
02:0003628C 670A            	  4643:     beq  _anon_z02_33
02:0003628E 5303            	  4644:     subq.b  #1,D3
02:00036290 0C000040        	  4645:     cmpi.b  #$40,D0
