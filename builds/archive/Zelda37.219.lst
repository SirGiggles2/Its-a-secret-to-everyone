02:0002E0B0 7006            	   753:     moveq   #6,D0
02:0002E0B2 19400029        	   754:     move.b  D0,($0029,A4)
                            	   755:     ; Copy the 5 bytes of the textbox character transfer record template
                            	   756:     ; to the dynamic transfer buf.
                            	   757:     ;
02:0002E0B6 7604            	   758:     moveq   #4,D3
                            	   759: _anon_z01_7:
02:0002E0B8 41F90002E092    	   760:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E0BE 10303000        	   761:     move.b  (A0,D3.W),D0
02:0002E0C2 41EC0302        	   762:     lea     ($0302,A4),A0
02:0002E0C6 11803000        	   763:     move.b  D0,(A0,D3.W)
02:0002E0CA 5303            	   764:     subq.b  #1,D3
02:0002E0CC 6AEA            	   765:     bpl  _anon_z01_7
                            	   766:     even
                            	   767: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   768:     ; Replace the low byte of the VRAM address with the one
                            	   769:     ; where the next character should be written.
                            	   770:     ;
02:0002E0CE 102C045F        	   771:     move.b  ($045F,A4),D0
02:0002E0D2 19400303        	   772:     move.b  D0,($0303,A4)
                            	   773:     ; Increment the low VRAM address for the next character.
                            	   774:     ;
02:0002E0D6 522C045F        	   775:     addq.b  #1,($045F,A4)
                            	   776:     ; Use the person text selector to look up the address of the
                            	   777:     ; text for the textbox. Store the address in [00:01].
                            	   778:     ;
02:0002E0DA 7600            	   779:     moveq   #0,D3
02:0002E0DC 162C0415        	   780:     move.b  ($0415,A4),D3
02:0002E0E0 41F90002D700    	   781:     lea     (PersonTextAddrs).l,A0
02:0002E0E6 10303000        	   782:     move.b  (A0,D3.W),D0
02:0002E0EA 1880            	   783:     move.b  D0,($0000,A4)
02:0002E0EC 5203            	   784:     addq.b  #1,D3
02:0002E0EE 41F90002D700    	   785:     lea     (PersonTextAddrs).l,A0
02:0002E0F4 10303000        	   786:     move.b  (A0,D3.W),D0
02:0002E0F8 19400001        	   787:     move.b  D0,($0001,A4)
                            	   788:     ; Load the person text current character index.
                            	   789:     ;
02:0002E0FC 7600            	   790:     moveq   #0,D3
02:0002E0FE 162C0416        	   791:     move.b  ($0416,A4),D3
                            	   792:     ; Increment the index variable to point to the next character
                            	   793:     ; for next time.
                            	   794:     ;
02:0002E102 522C0416        	   795:     addq.b  #1,($0416,A4)
                            	   796:     ; Get the current character.
                            	   797:     ;
02:0002E106 1214            	   798:     move.b  ($00,A4),D1   ; ptr lo
02:0002E108 182C0001        	   799:     move.b  ($01,A4),D4  ; ptr hi
02:0002E10C 024100FF        	   800:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E110 E14C            	   801:     lsl.w   #8,D4
02:0002E112 8841            	   802:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E114 48C4            	   803:     ext.l   D4
02:0002E116 D8BC00FF0000    	   804:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E11C 2044            	   805:     movea.l D4,A0
02:0002E11E 10303000        	   806:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   807:     ; If the character is $25, then it's a special space. It will still
                            	   808:     ; take up space, but will not take time to show -- meaning that
                            	   809:     ; we'll go look up the next character to transfer.
                            	   810:     ;
02:0002E122 0200003F        	   811:     andi.b #$3F,D0
02:0002E126 0C000025        	   812:     cmpi.b  #$25,D0
02:0002E12A 67A2            	   813:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   814:     ; We have a non-space character. Put it in the transfer record.
                            	   815:     ;
02:0002E12C 19400305        	   816:     move.b  D0,($0305,A4)
                            	   817:     ; Play the "heart taken/character" sound effect.
                            	   818:     ;
02:0002E130 7010            	   819:     moveq   #16,D0
02:0002E132 19400604        	   820:     move.b  D0,($0604,A4)
                            	   821:     ; If the high 2 bits of character element = 0, then return.
                            	   822:     ;
02:0002E136 1214            	   823:     move.b  ($00,A4),D1   ; ptr lo
02:0002E138 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
02:0002E13C 024100FF        	   825:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E140 E14C            	   826:     lsl.w   #8,D4
02:0002E142 8841            	   827:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E144 48C4            	   828:     ext.l   D4
02:0002E146 D8BC00FF0000    	   829:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E14C 2044            	   830:     movea.l D4,A0
02:0002E14E 10303000        	   831:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E152 020000C0        	   832:     andi.b #$C0,D0
02:0002E156 672E            	   833:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   834:     ; Determine an index based on the high 2 bits of the character element:
                            	   835:     ;   $80: 0
                            	   836:     ;   $40: 1
                            	   837:     ;   $C0: 2
                            	   838:     ;
02:0002E158 7602            	   839:     moveq   #2,D3
02:0002E15A 0C0000C0        	   840:     cmpi.b  #$C0,D0
02:0002E15E 670A            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E160 5303            	   842:     subq.b  #1,D3
02:0002E162 0C000040        	   843:     cmpi.b  #$40,D0
02:0002E166 6702            	   844:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E168 5303            	   845:     subq.b  #1,D3
                            	   846:     even
                            	   847: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   848:     ; The index chooses the low VRAM address of the start
                            	   849:     ; of another line:
                            	   850:     ;   0: $C4: front of the second line
                            	   851:     ;   1: $E4: front of the third line
                            	   852:     ;   2: $A4: front of the first line
                            	   853:     ;
                            	   854:     ; Look up the low VRAM address and store it.
                            	   855:     ;
02:0002E16A 41F90002E098    	   856:     lea     (TextboxLineAddrsLo).l,A0
02:0002E170 10303000        	   857:     move.b  (A0,D3.W),D0
02:0002E174 1940045F        	   858:     move.b  D0,($045F,A4)
                            	   859:     ; If index = 2, then we've reached the end of the text,
                            	   860:     ; and low VRAM address is moved to the front of the first line.
                            	   861:     ; So, advance the state of the person object, and unhalt Link.
                            	   862:     ;
02:0002E178 0C030002        	   863:     cmpi.b  #$02,D3
02:0002E17C 6608            	   864:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E17E 522C00AD        	   865:     addq.b  #1,($00AD,A4)
02:0002E182 6100FB82        	   866:     jsr     UnhaltLink
                            	   867:     even
