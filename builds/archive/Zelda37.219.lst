                            	 11373:     even
                            	 11374: _L_z04_Gleeok_CheckCollisions_NextLoopSegment:
                            	 11375:     ; Bottom of the segment loop.
                            	 11376:     ; Decrement segment object slot.
                            	 11377:     ;
                            	 11378:     ; If >= 1, then go draw the next segment and check collisions.
                            	 11379:     ; Else return.
                            	 11380:     ;
02:0003E848 5302            	 11381:     subq.b  #1,D2
02:0003E84A 0C020001        	 11382:     cmpi.b  #$01,D2
02:0003E84E 6404            	 11383:     bcc.s  __far_z_04_0108
