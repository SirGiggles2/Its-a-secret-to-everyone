                            	  6763: __far_z_01_0064:
                            	  6764:     ; They collide. Now find out how they collide.
                            	  6765:     ;
                            	  6766:     ; If it's a regular monster, go harm Link.
                            	  6767:     ;
02:00031BE4 41EC034F        	  6768:     lea     ($034F,A4),A0
02:00031BE8 10302000        	  6769:     move.b  (A0,D2.W),D0
02:00031BEC 0C000053        	  6770:     cmpi.b  #$53,D0
02:00031BF0 6402            	  6771:     bcc.s  __far_z_01_0065
02:00031BF2 607C            	  6772:     jmp  HarmLink
                            	  6773: __far_z_01_0065:
                            	  6774:     ; Here, the attacker is a monster's shot/projectile.
                            	  6775:     ; Flag this kind of collision.
                            	  6776:     ;
02:00031BF4 522C034B        	  6777:     addq.b  #1,($034B,A4)
                            	  6778:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
