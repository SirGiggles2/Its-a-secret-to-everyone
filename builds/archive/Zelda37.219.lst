                            	  9797: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9798:     ; At this point, we have a hand that just died.
                            	  9799:     ;
                            	  9800:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9801:     ;
02:0003DC9A 7603            	  9802:     moveq   #3,D3
                            	  9803:     ; Count how many are allocated.
                            	  9804:     ; This includes the current dead one, and the other living ones.
                            	  9805:     ; Store the count in [00].
                            	  9806:     ;
02:0003DC9C 7000            	  9807:     moveq   #0,D0
02:0003DC9E 1880            	  9808:     move.b  D0,($0000,A4)
                            	  9809:     even
                            	  9810: _L_z04_Manhandla_CheckCollisions_LoopHand:
