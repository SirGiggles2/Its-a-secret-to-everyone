                            	  1754: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithHeartContainer:
                            	  1755:     ; The player chose the heart container.
                            	  1756:     ;
                            	  1757:     ; If the number of heart containers < 4, then
                            	  1758:     ; - leave the number of heart containers alone
                            	  1759:     ; - set HeartPartial to 0, so Link will die with one more hit
                            	  1760:     ;
                            	  1761:     ; Then go flag this offer taken.
                            	  1762:     ;
02:0002E7A8 102C066F        	  1763:     move.b  ($066F,A4),D0
02:0002E7AC 020000F0        	  1764:     andi.b #$F0,D0
02:0002E7B0 0C000030        	  1765:     cmpi.b  #$30,D0
02:0002E7B4 640C            	  1766:     bcc  _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_Reduce
02:0002E7B6 1940066F        	  1767:     move.b  D0,($066F,A4)
02:0002E7BA 7000            	  1768:     moveq   #0,D0
02:0002E7BC 19400670        	  1769:     move.b  D0,($0670,A4)
02:0002E7C0 6042            	  1770:     jmp     _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_EndLifeOrMoney
                            	  1771: 
