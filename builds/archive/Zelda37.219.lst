02:0003E084 003C0011        	 10338:     ori     #$11,CCR  ; SEC: set C+X
02:0003E088 123C0032        	 10339:     move.b  #$32,D1
02:0003E08C 0A3C0010        	 10340:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E090 9101            	 10341:     subx.b  D1,D0   ; SBC #$32
02:0003E092 0A3C0010        	 10342:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E096 4EF90003196E    	 10343:     jmp     Anim_SetSpriteDescriptorAttributes
