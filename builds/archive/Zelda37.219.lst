                            	  5875:     even
                            	  5876: _L_z07_CheckState30_SetState40:
                            	  5877:     ; Set state $40, and a time to move of $20 frames.
                            	  5878:     ;
                            	  5879:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5880:     ;
                            	  5881:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5882:     ;
02:0004CA28 7020            	  5883:     moveq   #32,D0
02:0004CA2A 41EC0380        	  5884:     lea     ($0380,A4),A0
