02:0003C05E 41EC0350        	  5926:     lea     ($0350,A4),A0
02:0003C062 10303000        	  5927:     move.b  (A0,D3.W),D0
02:0003C066 0C000041        	  5928:     cmpi.b  #$41,D0
02:0003C06A 66F0            	  5929:     bne  _anon_z04_80
                            	  5930:     ; I don't know why the object timer of the tail segment that will
                            	  5931:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5932:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5933:     ; there, the object timer is set to 6.
                            	  5934:     ;
02:0003C06C 7011            	  5935:     moveq   #17,D0
02:0003C06E 19803029        	  5936:     move.b  D0,($29,A4,D3.W)
                            	  5937:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5938:     ; segment to the tail segment.
                            	  5939:     ;
02:0003C072 41EC04F0        	  5940:     lea     ($04F0,A4),A0
02:0003C076 10302000        	  5941:     move.b  (A0,D2.W),D0
02:0003C07A 41EC04F1        	  5942:     lea     ($04F1,A4),A0
02:0003C07E 11803000        	  5943:     move.b  D0,(A0,D3.W)
02:0003C082 10342070        	  5944:     move.b  ($70,A4,D2.W),D0
02:0003C086 19803071        	  5945:     move.b  D0,($71,A4,D3.W)
02:0003C08A 41EC0084        	  5946:     lea     ($0084,A4),A0
02:0003C08E 10302000        	  5947:     move.b  (A0,D2.W),D0
02:0003C092 41EC0085        	  5948:     lea     ($0085,A4),A0
02:0003C096 11803000        	  5949:     move.b  D0,(A0,D3.W)
                            	  5950:     ; If the tail segment found is also a head, then
