                            	   293:     ; Advance state.
                            	   294:     ;
02:00040250 704C            	   295:     moveq   #76,D0
02:00040252 6702            	   296:     beq.s  __far_z_05_0001
02:00040254 60E8            	   297:     jmp  SelectTransferBufAndIncState
                            	   298: __far_z_05_0001:
                            	   299:     even
                            	   300: UpdateMenu5UW:
02:00040256 61004D22        	   301:     jsr     Submenu_CueTransferRowUW
02:0004025A 60E8            	   302:     jmp     _anon_z05_1
                            	   303: 
                            	   304:     even
                            	   305: UpdateMenu5OW:
                            	   306:     ; Cue the transfer of "TRIFORCE" text.
                            	   307:     ;
02:0004025C 705C            	   308:     moveq   #92,D0
02:0004025E 6702            	   309:     beq.s  __far_z_05_0002
02:00040260 60DC            	   310:     jmp  SelectTransferBufAndIncState
                            	   311: __far_z_05_0002:
                            	   312:     even
                            	   313: UpdateMenuScrollDownOW:
02:00040262 61004D86        	   314:     jsr     Submenu_CueTransferRowOW
02:00040266 6004            	   315:     jmp     _anon_z05_2
                            	   316: 
                            	   317:     even
                            	   318: UpdateMenuScrollDownUW:
02:00040268 61004D10        	   319:     jsr     Submenu_CueTransferRowUW
                            	   320: _anon_z05_2:
                            	   321:     ; Move position markers and advance nametable scrolling;
                            	   322:     ; so that we scroll down 3 pixels.
                            	   323:     ;
02:0004026C 7003            	   324:     moveq   #3,D0
02:0004026E 6100015C        	   325:     jsr     MovePositionMarkers
02:00040272 102C00FC        	   326:     move.b  ($00FC,A4),D0
02:00040276 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:0004027A 123C0003        	   328:     move.b  #$03,D1
02:0004027E 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040282 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:00040284 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:00040288 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:0004028C 0C000041        	   335:     cmpi.b  #$41,D0
02:00040290 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
                            	   338:     ; Advance the submenu state.
                            	   339:     ; If in OW or in a cellar, we're done. Return.
                            	   340:     ;
02:00040294 522C00E1        	   341:     addq.b  #1,($00E1,A4)
02:00040298 102C0010        	   342:     move.b  ($0010,A4),D0
02:0004029C 67000084        	   343:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:000402A0 102C0012        	   344:     move.b  ($0012,A4),D0
02:000402A4 0C000009        	   345:     cmpi.b  #$09,D0
02:000402A8 6778            	   346:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   347:     ; Calculate the X coordinate of the submenu position marker.
                            	   348:     ;
                            	   349:     ; First, mask off the high nibble of the room ID and multiply by
                            	   350:     ; the width of a tile, 8. Store the result in [00].
                            	   351:     ;
02:000402AA 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:000402AE 0200000F        	   353:     andi.b #$0F,D0
02:000402B2 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:000402B4 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:000402B6 E308            	   356:     lsl.b  #1,D0   ; ASL A
02:000402B8 1880            	   357:     move.b  D0,($0000,A4)
                            	   358:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   359:     ; negative or left rotation by ($10 - rotation value).
                            	   360:     ;
                            	   361:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   362:     ; the width of a tile. Then negate it. The final result is the
                            	   363:     ; negative offset.
                            	   364:     ;
02:000402BA 103900FF6BAB    	   365:     move.b  (NES_SRAM+$0BAB).l,D0
02:000402C0 0C000008        	   366:     cmpi.b  #$08,D0
02:000402C4 6520            	   367:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:000402C6 7010            	   368:     moveq   #16,D0
02:000402C8 123900FF6BAB    	   369:     move.b  (NES_SRAM+$0BAB).l,D1
02:000402CE 0A3C0010        	   370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000402D2 9101            	   371:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:000402D4 0A3C0010        	   372:     eori    #$10,CCR  ; restore X = 6502 C
02:000402D8 E308            	   373:     lsl.b  #1,D0   ; ASL A
02:000402DA E308            	   374:     lsl.b  #1,D0   ; ASL A
02:000402DC E308            	   375:     lsl.b  #1,D0   ; ASL A
02:000402DE 4EB900030ABA    	   376:     jsr     Negate
02:000402E4 6006            	   377:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   378: 
                            	   379:     even
                            	   380: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   381:     ; The submenu map's rotation < 8.
                            	   382:     ; It represents the number of tiles to move right.
                            	   383:     ; So, multiply it by 8.
                            	   384:     ;
02:000402E6 E308            	   385:     lsl.b  #1,D0   ; ASL A
02:000402E8 E308            	   386:     lsl.b  #1,D0   ; ASL A
02:000402EA E308            	   387:     lsl.b  #1,D0   ; ASL A
                            	   388:     even
                            	   389: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   390:     ; Add the offset we calculated, and $62 to [00] to get
                            	   391:     ; the position marker's X coordinate.
                            	   392:     ;
02:000402EC 023C00EE        	   393:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402F0 1214            	   394:     move.b  ($0000,A4),D1
02:000402F2 D101            	   395:     addx.b  D1,D0   ; ADC $00
02:000402F4 023C00EE        	   396:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402F8 123C0062        	   397:     move.b  #$62,D1
02:000402FC D101            	   398:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:000402FE 19400253        	   399:     move.b  D0,($0253,A4)
                            	   400:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   401:     ; Divide by 2 to get a multiple of the tile height.
                            	   402:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   403:     ;
02:00040302 102C00EB        	   404:     move.b  ($00EB,A4),D0
02:00040306 020000F0        	   405:     andi.b #$F0,D0
02:0004030A E208            	   406:     lsr.b  #1,D0   ; LSR A
02:0004030C 123C0069        	   407:     move.b  #$69,D1
02:00040310 D101            	   408:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040312 19400250        	   409:     move.b  D0,($0250,A4)
                            	   410:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   411:     ;
02:00040316 703E            	   412:     moveq   #62,D0
02:00040318 19400251        	   413:     move.b  D0,($0251,A4)
02:0004031C 7000            	   414:     moveq   #0,D0
02:0004031E 19400252        	   415:     move.b  D0,($0252,A4)
                            	   416:     even
                            	   417: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040322 4E75            	   418:     rts
                            	   419: 
                            	   420:     even
                            	   421: UpdateMenuActive:
02:00040324 610053D6        	   422:     jsr     DrawSubmenuItems
02:00040328 6100549A        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:0004032C 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:00040330 02000088        	   430:     andi.b #$88,D0
02:00040334 0C000088        	   431:     cmpi.b  #$88,D0
02:00040338 661A            	   432:     bne  _anon_z05_3
02:0004033A 4EB90004B6D2    	   433:     jsr     EndGameMode
02:00040340 194000E1        	   434:     move.b  D0,($00E1,A4)
02:00040344 7008            	   435:     moveq   #8,D0
02:00040346 19400012        	   436:     move.b  D0,($0012,A4)
02:0004034A 7000            	   437:     moveq   #0,D0
02:0004034C 19400619        	   438:     move.b  D0,($0619,A4)
02:00040350 600013A0        	   439:     jmp     SilenceSound
                            	   440: 
                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:00040354 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:00040358 02000010        	   446:     andi.b #$10,D0
02:0004035C 6606            	   447:     bne.s  __far_z_05_0003
02:0004035E 4EF90002CFBC    	   448:     jmp  Exit
                            	   449: __far_z_05_0003:
02:00040364 102C0254        	   450:     move.b  ($0254,A4),D0
02:00040368 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:0004036A 102C0258        	   452:     move.b  ($0258,A4),D0
02:0004036E 1B00            	   453:     move.b  D0,-(A5)  ; PHA
02:00040370 4EB90004ACF0    	   454:     jsr     HideAllSprites
02:00040376 101D            	   455:     move.b  (A5)+,D0  ; PLA
02:00040378 19400258        	   456:     move.b  D0,($0258,A4)
02:0004037C 101D            	   457:     move.b  (A5)+,D0  ; PLA
02:0004037E 19400254        	   458:     move.b  D0,($0254,A4)
02:00040382 522C00E1        	   459:     addq.b  #1,($00E1,A4)
02:00040386 0A3C0001        	   460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004038A 4E75            	   461:     rts
                            	   462: 
                            	   463:     even
                            	   464: UpdateMenuScrollUp:
                            	   465:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   466:     ;
02:0004038C 103C00FD        	   467:     move.b  #$FD,D0
02:00040390 613A            	   468:     jsr     MovePositionMarkers
02:00040392 102C00FC        	   469:     move.b  ($00FC,A4),D0
02:00040396 023C00EE        	   470:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004039A 123C0003        	   471:     move.b  #$03,D1
02:0004039E D101            	   472:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000403A0 194000FC        	   473:     move.b  D0,($00FC,A4)
                            	   474:     ; If hardware vertical scroll still < $F0, then return.
                            	   475:     ;
02:000403A4 0C0000F0        	   476:     cmpi.b  #$F0,D0
02:000403A8 6406            	   477:     bcc.s  __far_z_05_0004
02:000403AA 4EF90002CFBC    	   478:     jmp  Exit
                            	   479: __far_z_05_0004:
                            	   480:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   481:     ;
02:000403B0 1940005C        	   482:     move.b  D0,($005C,A4)
                            	   483:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   484:     ;
                            	   485:     ; UNKNOWN: But why not do this in OW, too?
                            	   486:     ;
02:000403B4 102C0010        	   487:     move.b  ($0010,A4),D0
02:000403B8 6706            	   488:     beq  _anon_z05_4
02:000403BA 4EB900031372    	   489:     jsr     WriteBlankPrioritySprites
                            	   490: _anon_z05_4:
                            	   491:     ; We reached the end. So, reset hardware vertical scroll
                            	   492:     ; and submenu state.
                            	   493:     ;
02:000403C0 7000            	   494:     moveq   #0,D0
02:000403C2 194000FC        	   495:     move.b  D0,($00FC,A4)
02:000403C6 194000E1        	   496:     move.b  D0,($00E1,A4)
                            	   497:     ; Move the position markers 2 pixels down, because we
                            	   498:     ; overshot and reached vertical scroll $F2.
                            	   499:     ;
02:000403CA 7002            	   500:     moveq   #2,D0
                            	   501: ; Params:
                            	   502: ; A: vertical velocity of menu scrolling
                            	   503: ;
                            	   504: ;
                            	   505: ; [00] holds the vertical velocity of menu scrolling.
                            	   506:     even
                            	   507: MovePositionMarkers:
02:000403CC 1880            	   508:     move.b  D0,($0000,A4)
                            	   509:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   510:     ;
02:000403CE 102C0254        	   511:     move.b  ($0254,A4),D0
02:000403D2 0C0000F8        	   512:     cmpi.b  #$F8,D0
02:000403D6 670C            	   513:     beq  _anon_z05_5
02:000403D8 023C00EE        	   514:     andi    #$EE,CCR  ; CLC: clear C+X
02:000403DC 1214            	   515:     move.b  ($0000,A4),D1
02:000403DE D101            	   516:     addx.b  D1,D0   ; ADC $00
02:000403E0 19400254        	   517:     move.b  D0,($0254,A4)
                            	   518: _anon_z05_5:
                            	   519:     ; If in UW and have the compass, then move the triforce position marker.
                            	   520:     ;
02:000403E4 102C0010        	   521:     move.b  ($0010,A4),D0
02:000403E8 6606            	   522:     bne.s  __far_z_05_0005
02:000403EA 4EF90002CFBC    	   523:     jmp  Exit
                            	   524: __far_z_05_0005:
02:000403F0 61005252        	   525:     jsr     HasCompass
02:000403F4 6606            	   526:     bne.s  __far_z_05_0006
02:000403F6 4EF90002CFBC    	   527:     jmp  Exit
                            	   528: __far_z_05_0006:
02:000403FC 102C0258        	   529:     move.b  ($0258,A4),D0
02:00040400 023C00EE        	   530:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040404 1214            	   531:     move.b  ($0000,A4),D1
02:00040406 D101            	   532:     addx.b  D1,D0   ; ADC $00
02:00040408 19400258        	   533:     move.b  D0,($0258,A4)
                            	   534:     even
