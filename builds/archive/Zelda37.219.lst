                            	  8506: HaveInput:
                            	  8507:     ; There were input directions.
                            	  8508:     ;
                            	  8509:     ; If there was only one input direction, go set object direction
                            	  8510:     ; to input direction, and set Link's speed.
                            	  8511:     ;
                            	  8512:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8513:     ; (X is still 0, because it's Link's object index).
                            	  8514:     ;
02:000450C6 102C000F        	  8515:     move.b  ($000F,A4),D0
