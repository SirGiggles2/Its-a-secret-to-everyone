                            	 12528: __far_z_04_0125:
                            	 12529:     ; State = 0.
                            	 12530:     ;
                            	 12531:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12532:     ; This is the only patra child shown in the first fame.
                            	 12533:     ;
02:0003F0CE 0C020002        	 12534:     cmpi.b  #$02,D2
02:0003F0D2 6732            	 12535:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12536:     ; The patra child in slot 2 is the last one to be updated.
                            	 12537:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12538:     ;
                            	 12539:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12540:     ; shown.
                            	 12541:     ;
02:0003F0D4 102C00AE        	 12542:     move.b  ($00AE,A4),D0
02:0003F0D8 6700008E        	 12543:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12544:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12545:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12546:     ;
02:0003F0DC 1002            	 12547:     move.b  D2,D0
                            	 12548:     ; Subtract 3 from the object slot to get the angle where the
                            	 12549:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12550:     ;
02:0003F0DE 003C0011        	 12551:     ori     #$11,CCR  ; SEC: set C+X
02:0003F0E2 123C0003        	 12552:     move.b  #$03,D1
02:0003F0E6 0A3C0010        	 12553:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0EA 9101            	 12554:     subx.b  D1,D0   ; SBC #$03
02:0003F0EC 0A3C0010        	 12555:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0F0 7600            	 12556:     moveq   #0,D3
02:0003F0F2 1600            	 12557:     move.b  D0,D3
                            	 12558:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12559:     ; then return.
                            	 12560:     ;
