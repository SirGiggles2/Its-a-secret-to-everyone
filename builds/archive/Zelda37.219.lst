                            	  3993: __far_z_04_0035:
                            	  3994:     ; Animate.
                            	  3995:     ;
                            	  3996:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3997:     ; then only go draw.
                            	  3998:     ;
02:0003B20E 41EC03D0        	  3999:     lea     ($03D0,A4),A0
