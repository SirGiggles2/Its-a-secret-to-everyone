                            	  3265: _L_z05_MaskInputInBorder_PositiveDir:
                            	  3266:     ; The direction is positive.
                            	  3267:     ;
                            	  3268:     ; If the coordinate crosses (<) the boundary, then
                            	  3269:     ; go mask buttons.
                            	  3270:     ;
                            	  3271:     ;
                            	  3272:     ; Get coordinate in [02].
02:00041C76 102C0002        	  3273:     move.b  ($0002,A4),D0
02:00041C7A 41F900041BA6    	  3274:     lea     (BorderBounds).l,A0
02:00041C80 12303000        	  3275:     move.b  (A0,D3.W),D1
02:00041C84 B001            	  3276:     cmp.b   D1,D0
02:00041C86 65B8            	  3277:     bcs  _L_z05_MaskInputInBorder_MaskButtons
