02:00031DA2 19400009        	  7010:     move.b  D0,($0009,A4)
                            	  7011:     ; Set collision threshold $A in both axes.
                            	  7012:     ;
02:00031DA6 700A            	  7013:     moveq   #10,D0
02:00031DA8 1940000D        	  7014:     move.b  D0,($000D,A4)
02:00031DAC 1940000E        	  7015:     move.b  D0,($000E,A4)
                            	  7016:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  7017:     ;
02:00031DB0 10343070        	  7018:     move.b  ($70,A4,D3.W),D0
02:00031DB4 023C00EE        	  7019:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031DB8 123C0004        	  7020:     move.b  #$04,D1
02:00031DBC D101            	  7021:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031DBE 19400004        	  7022:     move.b  D0,($0004,A4)
                            	  7023:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  7024:     ;
02:00031DC2 41EC0084        	  7025:     lea     ($0084,A4),A0
02:00031DC6 10303000        	  7026:     move.b  (A0,D3.W),D0
02:00031DCA 023C00EE        	  7027:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031DCE 123C0008        	  7028:     move.b  #$08,D1
02:00031DD2 D101            	  7029:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7030: ; Params:
                            	  7031: ; A: weapon object mid Y
                            	  7032: ; X: monster object slot
                            	  7033: ; Y: weapon object slot
                            	  7034: ; [00]: weapon object slot
                            	  7035: ; [02]: monster object mid X
                            	  7036: ; [03]: monster object mid Y
                            	  7037: ; [04]: weapon object mid X
                            	  7038: ; [07]: damage points
                            	  7039: ; [09]: damage type
                            	  7040: ; [0D]: horizontal threshold
                            	  7041: ; [0E]: vertical threshold
                            	  7042: ;
                            	  7043: ; Returns:
                            	  7044: ; [06]: 1 if objects collide
