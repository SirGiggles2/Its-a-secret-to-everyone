02:000407A2 660A            	  1014:     bne  _L_z05_InitMode7_Sub3And4_TransferPlayAreaAttrsToNT2_Vertical
02:000407A4 E208            	  1015:     lsr.b  #1,D0   ; LSR A
02:000407A6 122C0098        	  1016:     move.b  ($0098,A4),D1
