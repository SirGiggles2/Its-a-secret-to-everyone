02:0003AEAE 670A            	  3486:     beq  _L_z04_UpdateRedLeever_CheckStunned
02:0003AEB0 4EB90004BC28    	  3487:     jsr     Obj_Shove
02:0003AEB6 600000AE        	  3488:     jmp     RedLeever_AnimateAndCheckCollisions
                            	  3489: 
                            	  3490:     even
                            	  3491: _L_z04_UpdateRedLeever_CheckStunned:
                            	  3492:     ; If we have the magic clock or the leever is stunned, then
                            	  3493:     ; go animate, draw, and check for collisions.
                            	  3494:     ;
02:0003AEBA 102C066C        	  3495:     move.b  ($066C,A4),D0
02:0003AEBE 1234203D        	  3496:     move.b  ($3D,A4,D2.W),D1
02:0003AEC2 8001            	  3497:     or.b  D1,D0
02:0003AEC4 6704            	  3498:     beq.s  __far_z_04_0030
02:0003AEC6 6000009E        	  3499:     jmp  RedLeever_AnimateAndCheckCollisions
                            	  3500: __far_z_04_0030:
                            	  3501:     ; If the leever is blocked by a tile or the room boundary,
                            	  3502:     ; then go to the next state, in addition to animating, drawing,
                            	  3503:     ; and checking for collisions.
                            	  3504:     ;
