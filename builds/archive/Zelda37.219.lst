02:00045110 162C0084        	  8574:     move.b  ($0084,A4),D3
02:00045114 0C030085        	  8575:     cmpi.b  #$85,D3
02:00045118 6642            	  8576:     bne  _anon_z05_177
02:0004511A 102C0098        	  8577:     move.b  ($0098,A4),D0
02:0004511E 02000004        	  8578:     andi.b #$04,D0
02:00045122 6738            	  8579:     beq  _anon_z05_177
