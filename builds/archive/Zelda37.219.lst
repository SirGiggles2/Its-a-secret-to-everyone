                            	  8518:     ; There were more than one input directions.
                            	  8519:     ;
                            	  8520:     ; If none were walkable, go set input direction to 0, and return.
                            	  8521:     ;
02:000450D2 102C000C        	  8522:     move.b  ($000C,A4),D0
