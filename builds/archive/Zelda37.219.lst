02:000365C2 123C0080        	  5028:     move.b  #$80,D1
02:000365C6 D101            	  5029:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000365C8 19400058        	  5030:     move.b  D0,($0058,A4)
                            	  5031:     ; Carry over to the tile offset and current V-scroll.
