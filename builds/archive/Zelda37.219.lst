02:0003F31A 52302000        	 12884:     addq.b  #1,(A0,D2.W)
                            	 12885:     ; The animation cycle has 6 frames.
                            	 12886:     ;
02:0003F31E 41EC046B        	 12887:     lea     ($046B,A4),A0
02:0003F322 10302000        	 12888:     move.b  (A0,D2.W),D0
02:0003F326 0C000006        	 12889:     cmpi.b  #$06,D0
02:0003F32A 660A            	 12890:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003F32C 7000            	 12891:     moveq   #0,D0
02:0003F32E 41EC046B        	 12892:     lea     ($046B,A4),A0
