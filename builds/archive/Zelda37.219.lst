02:000412C6 1980203D        	  1957:     move.b  D0,($3D,A4,D2.W)
02:000412CA 41EC03D0        	  1958:     lea     ($03D0,A4),A0
02:000412CE 52302000        	  1959:     addq.b  #1,(A0,D2.W)
02:000412D2 41EC0405        	  1960:     lea     ($0405,A4),A0
02:000412D6 52302000        	  1961:     addq.b  #1,(A0,D2.W)
02:000412DA 7020            	  1962:     moveq   #32,D0
02:000412DC 41EC03BC        	  1963:     lea     ($03BC,A4),A0
