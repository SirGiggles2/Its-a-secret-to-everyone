02:0003B254 41EC03E4        	  4038:     lea     ($03E4,A4),A0
02:0003B258 12302000        	  4039:     move.b  (A0,D2.W),D1
02:0003B25C D101            	  4040:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B25E 4EB90003167C    	  4041:     jsr     DrawObjectNotMirrored
