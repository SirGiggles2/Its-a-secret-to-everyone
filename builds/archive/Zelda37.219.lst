02:0003AD9C 4EB90004C1E4    	  3337:     jsr     ReverseObjDir
                            	  3338: _anon_z04_43:
                            	  3339:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3340:     ;
02:0003ADA2 41EC0098        	  3341:     lea     ($0098,A4),A0
02:0003ADA6 10302000        	  3342:     move.b  (A0,D2.W),D0
02:0003ADAA 0200000C        	  3343:     andi.b #$0C,D0
02:0003ADAE 6742            	  3344:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3345:     ; Begin with the leever's X set to Link's X.
                            	  3346:     ;
02:0003ADB0 102C0070        	  3347:     move.b  ($0070,A4),D0
02:0003ADB4 19802070        	  3348:     move.b  D0,($70,A4,D2.W)
                            	  3349:     ; If facing down, then use Y offset $28.
                            	  3350:     ; Else store Y offset -$28 in [00].
                            	  3351:     ;
02:0003ADB8 7628            	  3352:     moveq   #40,D3
02:0003ADBA 41EC0098        	  3353:     lea     ($0098,A4),A0
02:0003ADBE 10302000        	  3354:     move.b  (A0,D2.W),D0
02:0003ADC2 02000008        	  3355:     andi.b #$08,D0
02:0003ADC6 6704            	  3356:     beq  _anon_z04_44
02:0003ADC8 163C00D8        	  3357:     move.b  #$D8,D3
                            	  3358: _anon_z04_44:
02:0003ADCC 1883            	  3359:     move.b  D3,($0000,A4)
                            	  3360:     ; Add Link's Y and the vertical offset.
                            	  3361:     ;
02:0003ADCE 102C0084        	  3362:     move.b  ($0084,A4),D0
02:0003ADD2 023C00EE        	  3363:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADD6 1214            	  3364:     move.b  ($0000,A4),D1
02:0003ADD8 D101            	  3365:     addx.b  D1,D0   ; ADC $00
                            	  3366:     ; Sanitize the Y coordinate:
                            	  3367:     ; (Y AND $F0) OR $D
                            	  3368:     ;
02:0003ADDA 020000F0        	  3369:     andi.b #$F0,D0
02:0003ADDE 0000000D        	  3370:     ori.b #$0D,D0
02:0003ADE2 41EC0084        	  3371:     lea     ($0084,A4),A0
02:0003ADE6 11802000        	  3372:     move.b  D0,(A0,D2.W)
                            	  3373:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3374:     ; go see if the tile is valid to come out of.
                            	  3375:     ;
                            	  3376:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3377:     ;
02:0003ADEA 0C00005D        	  3378:     cmpi.b  #$5D,D0
02:0003ADEE 647A            	  3379:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3380:     even
