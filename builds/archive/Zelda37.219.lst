02:00031B94 10302000        	  6734:     move.b  (A0,D2.W),D0
02:00031B98 0C000053        	  6735:     cmpi.b  #$53,D0
02:00031B9C 6516            	  6736:     bcs  _anon_z01_84
02:00031B9E 41EC00AC        	  6737:     lea     ($00AC,A4),A0
02:00031BA2 10302000        	  6738:     move.b  (A0,D2.W),D0
02:00031BA6 020000F0        	  6739:     andi.b #$F0,D0
02:00031BAA 0C000010        	  6740:     cmpi.b  #$10,D0
02:00031BAE 6704            	  6741:     beq.s  __far_z_01_0063
02:00031BB0 600000BC        	  6742:     jmp  L73A9_Exit
