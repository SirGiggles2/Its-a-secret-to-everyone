02:0003F2FE 6058            	 12852:     jmp  Ganon_UpdateBrownState
                            	 12853: __far_z_04_0130:
                            	 12854:     ; State = 0: Blue
                            	 12855:     ;
                            	 12856:     ; If timer = 0, then go move around and shoot.
                            	 12857:     ;
02:0003F300 10342028        	 12858:     move.b  ($28,A4,D2.W),D0
02:0003F304 6602            	 12859:     bne.s  __far_z_04_0131
02:0003F306 600E            	 12860:     jmp  Ganon_MoveAndShoot
                            	 12861: __far_z_04_0131:
                            	 12862:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12863:     ; Collisions were checked already.
                            	 12864:     ;
                            	 12865:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12866:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12867:     ;
02:0003F308 0C000001        	 12868:     cmpi.b  #$01,D0
02:0003F30C 6702            	 12869:     beq.s  __far_z_04_0132
02:0003F30E 6078            	 12870:     jmp  L_Ganon_DrawBody
                            	 12871: __far_z_04_0132:
