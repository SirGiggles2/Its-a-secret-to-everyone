                            	 13270: Ganon_DrawBody:
                            	 13271:     ; Loop over four 16x16 images that make up Ganon.
                            	 13272:     ; There are 6 animation frames.
                            	 13273:     ;
02:0003F608 7603            	 13274:     moveq   #3,D3
                            	 13275:     even
                            	 13276: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13277:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13278:     ;
02:0003F60A 10342070        	 13279:     move.b  ($70,A4,D2.W),D0
02:0003F60E 023C00EE        	 13280:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F612 41F90003F5FC    	 13281:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F618 12303000        	 13282:     move.b  (A0,D3.W),D1
02:0003F61C D101            	 13283:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F61E 1880            	 13284:     move.b  D0,($0000,A4)
                            	 13285:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13286:     ;
02:0003F620 41EC0084        	 13287:     lea     ($0084,A4),A0
02:0003F624 10302000        	 13288:     move.b  (A0,D2.W),D0
02:0003F628 023C00EE        	 13289:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F62C 41F90003F600    	 13290:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F632 12303000        	 13291:     move.b  (A0,D3.W),D1
02:0003F636 D101            	 13292:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F638 19400001        	 13293:     move.b  D0,($0001,A4)
                            	 13294:     ; Each part has a horizontal flipping flag.
                            	 13295:     ;
02:0003F63C 41F90003F604    	 13296:     lea     (GanonSpriteHFlips).l,A0
02:0003F642 10303000        	 13297:     move.b  (A0,D3.W),D0
02:0003F646 1940000F        	 13298:     move.b  D0,($000F,A4)
                            	 13299:     ; Save and copy the loop index (the current part) to [07].
                            	 13300:     ;
02:0003F64A 1003            	 13301:     move.b  D3,D0
02:0003F64C 1B00            	 13302:     move.b  D0,-(A5)  ; PHA
02:0003F64E 19400007        	 13303:     move.b  D0,($0007,A4)
                            	 13304:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13305:     ; that make it up.
                            	 13306:     ;
02:0003F652 41EC046B        	 13307:     lea     ($046B,A4),A0
02:0003F656 10302000        	 13308:     move.b  (A0,D2.W),D0
02:0003F65A E308            	 13309:     lsl.b  #1,D0   ; ASL A
02:0003F65C E308            	 13310:     lsl.b  #1,D0   ; ASL A
                            	 13311:     ; Add [07] -- the index of the current part.
                            	 13312:     ;
                            	 13313:     ; Now you have an index into the frame image table, for the
                            	 13314:     ; current image part of the current animation frame.
                            	 13315:     ;
02:0003F65E 122C0007        	 13316:     move.b  ($0007,A4),D1
02:0003F662 D101            	 13317:     addx.b  D1,D0   ; ADC $07
02:0003F664 7600            	 13318:     moveq   #0,D3
02:0003F666 1600            	 13319:     move.b  D0,D3
02:0003F668 41F90003F5E4    	 13320:     lea     (GanonFrameImages).l,A0
02:0003F66E 10303000        	 13321:     move.b  (A0,D3.W),D0
02:0003F672 4EB90003167C    	 13322:     jsr     DrawObjectNotMirrored
02:0003F678 101D            	 13323:     move.b  (A5)+,D0  ; PLA
                            	 13324:     ; Bottom of the part loop.
                            	 13325:     ;
02:0003F67A 7600            	 13326:     moveq   #0,D3
02:0003F67C 1600            	 13327:     move.b  D0,D3
02:0003F67E 5303            	 13328:     subq.b  #1,D3
02:0003F680 6A88            	 13329:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F682 4E75            	 13330:     rts
