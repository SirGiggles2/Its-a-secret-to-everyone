                            	  8526: _anon_z05_174:
                            	  8527:     ; Two input directions, and at least one of them is walkable.
                            	  8528:     ;
                            	  8529:     ; Make Link go straight in one direction on the next grid line.
                            	  8530:     ;
02:000450DC 7600            	  8531:     moveq   #0,D3
02:000450DE 1600            	  8532:     move.b  D0,D3
02:000450E0 522C0057        	  8533:     addq.b  #1,($0057,A4)
                            	  8534:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8535:     ; object direction and input direction to last walkable direction
                            	  8536:     ; found, and set Link's speed.
                            	  8537:     ;
                            	  8538:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8539:     ;
02:000450E4 7400            	  8540:     moveq   #0,D2
02:000450E6 102C000D        	  8541:     move.b  ($000D,A4),D0
02:000450EA 0C030001        	  8542:     cmpi.b  #$01,D3
02:000450EE 67000096        	  8543:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:000450F2 7600            	  8544:     moveq   #0,D3
02:000450F4 162C0010        	  8545:     move.b  ($0010,A4),D3
02:000450F8 6700008C        	  8546:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8547:     ; In UW. There are two input directions, and they're both walkable.
                            	  8548:     ;
                            	  8549:     ; Normally, turn to the direction that's perpendicular to object
                            	  8550:     ; direction. But keep going straight after that, while diagonal
                            	  8551:     ; input is held.
                            	  8552:     ;
                            	  8553:     ; Handle special cases for doors.
                            	  8554:     ;
                            	  8555:     ;
                            	  8556:     ; 1. Link at horizontal doors.
                            	  8557:     ;
                            	  8558:     ; If Link's X = $20 or $D0 then
                            	  8559:     ;   If Link's Y = $85 and facing down then
                            	  8560:     ;     Go set object direction and input direction to object
                            	  8561:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8562:     ;     Link_GoStraightWhenDiagInput.
                            	  8563:     ;   Else
                            	  8564:     ;     Go turn to the perpendicular direction
                            	  8565:     ;
02:000450FC 7600            	  8566:     moveq   #0,D3
02:000450FE 162C0070        	  8567:     move.b  ($0070,A4),D3
02:00045102 0C030020        	  8568:     cmpi.b  #$20,D3
02:00045106 6706            	  8569:     beq  _anon_z05_175
02:00045108 0C0300D0        	  8570:     cmpi.b  #$D0,D3
02:0004510C 661C            	  8571:     bne  _anon_z05_176
                            	  8572: _anon_z05_175:
