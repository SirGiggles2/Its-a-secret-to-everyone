                            	  1912: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1913:     ; Choose a distance to walk depending on the door you
                            	  1914:     ; come out of.
                            	  1915:     ;
                            	  1916:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1917:     ;
                            	  1918:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1919:     ; then you have shorter distance to cover. So use the
                            	  1920:     ; previous value as is to use indexes 0 and 1.
                            	  1921:     ;
                            	  1922:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1923:     ; to get out of the way of the wall or door.
                            	  1924:     ;
02:00041276 61003AD0        	  1925:     jsr     GetPassedDoorType
02:0004127A 02000007        	  1926:     andi.b #$07,D0
02:0004127E 6710            	  1927:     beq  _anon_z05_45
02:00041280 0C000005        	  1928:     cmpi.b  #$05,D0
02:00041284 670A            	  1929:     beq  _anon_z05_45
02:00041286 0C000006        	  1930:     cmpi.b  #$06,D0
02:0004128A 6704            	  1931:     beq  _anon_z05_45
02:0004128C 5203            	  1932:     addq.b  #1,D3
02:0004128E 5203            	  1933:     addq.b  #1,D3
                            	  1934: _anon_z05_45:
02:00041290 41F900040BEA    	  1935:     lea     (EnteringRoomRelativePositions).l,A0
02:00041296 10303000        	  1936:     move.b  (A0,D3.W),D0
                            	  1937:     even
