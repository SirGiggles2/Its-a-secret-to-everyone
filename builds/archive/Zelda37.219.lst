02:0003C044 41EC0485        	  5914:     lea     ($0485,A4),A0
02:0003C048 11802000        	  5915:     move.b  D0,(A0,D2.W)
02:0003C04C 6100062A        	  5916:     jsr     CheckBossHitReaction
                            	  5917:     ; Look for the tail segment, starting from the low end
                            	  5918:     ; of the chain that this dead segment belongs to.
                            	  5919:     ;
02:0003C050 163C00FF        	  5920:     move.b  #$FF,D3
02:0003C054 0C020006        	  5921:     cmpi.b  #$06,D2
02:0003C058 6502            	  5922:     bcs  _anon_z04_80
02:0003C05A 7604            	  5923:     moveq   #4,D3
                            	  5924: _anon_z04_80:
