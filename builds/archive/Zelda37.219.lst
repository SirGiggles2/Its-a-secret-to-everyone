02:0003B14A 662C            	  3865:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3866:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3867:     ; has the power bracelet.
                            	  3868:     ;
                            	  3869:     ; Set up the room item with the armos's coordinates.
                            	  3870:     ;
02:0003B14C 19400097        	  3871:     move.b  D0,($0097,A4)
02:0003B150 10342070        	  3872:     move.b  ($70,A4,D2.W),D0
02:0003B154 19400083        	  3873:     move.b  D0,($0083,A4)
                            	  3874:     ; This resets the room item's state, which activates it.
                            	  3875:     ;
