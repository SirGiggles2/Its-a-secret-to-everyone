                            	  1912: CopyCommonCodeToRam:
                            	  1913:     ; PATCHED: NOP — all code is in flat ROM on Genesis.
02:0002E8F0 4E75            	  1914:     rts
02:0002E8F2 7000            	  1915:     moveq   #0,D0
02:0002E8F4 1880            	  1916:     move.b  D0,($0000,A4)
02:0002E8F6 103C00A5        	  1917:     move.b  #$A5,D0
02:0002E8FA 19400001        	  1918:     move.b  D0,($0001,A4)
02:0002E8FE 103C0090        	  1919:     move.b  #$90,D0
02:0002E902 19400002        	  1920:     move.b  D0,($0002,A4)
02:0002E906 706C            	  1921:     moveq   #108,D0
02:0002E908 19400003        	  1922:     move.b  D0,($0003,A4)
02:0002E90C 7600            	  1923:     moveq   #0,D3
