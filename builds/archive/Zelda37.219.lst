02:0003F4DE 610000D0        	 13130:     jsr     Ganon_GetCurCloudRight
02:0003F4E2 619A            	 13131:     jsr     Ganon_DrawCloud
02:0003F4E4 610000A8        	 13132:     jsr     Ganon_GetCurCloudLeft
