                            	  7632: Dodongo_Draw:
02:0003CC44 610000F4        	  7633:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7634:     ; Make a 5-way direction index out of the facing direction
                            	  7635:     ; by shifting right once, and store it in [00].
                            	  7636:     ;
02:0003CC48 41EC0098        	  7637:     lea     ($0098,A4),A0
02:0003CC4C 10302000        	  7638:     move.b  (A0,D2.W),D0
02:0003CC50 E208            	  7639:     lsr.b  #1,D0   ; LSR A
02:0003CC52 1880            	  7640:     move.b  D0,($0000,A4)
                            	  7641:     ; If state = 0, go handle animating the two frames of this state.
                            	  7642:     ;
02:0003CC54 7600            	  7643:     moveq   #0,D3
02:0003CC56 41EC00AC        	  7644:     lea     ($00AC,A4),A0
02:0003CC5A 16302000        	  7645:     move.b  (A0,D2.W),D3
02:0003CC5E 6744            	  7646:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7647:     ; If state > 1, then the monster is stunned (state 2).
                            	  7648:     ; So, go switch frames every $20 screen frames.
                            	  7649:     ;
02:0003CC60 7020            	  7650:     moveq   #32,D0
02:0003CC62 5303            	  7651:     subq.b  #1,D3
02:0003CC64 6640            	  7652:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7653:     ; State = 1. Bloated.
                            	  7654:     ;
                            	  7655:     ; In substate 0, go animate as usual for walking.
                            	  7656:     ;
02:0003CC66 7600            	  7657:     moveq   #0,D3
02:0003CC68 41EC042C        	  7658:     lea     ($042C,A4),A0
02:0003CC6C 16302000        	  7659:     move.b  (A0,D2.W),D3
02:0003CC70 6732            	  7660:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7661:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7662:     ; go fade the boss; so that some frames are not drawn.
                            	  7663:     ;
02:0003CC72 0C030002        	  7664:     cmpi.b  #$02,D3
02:0003CC76 6718            	  7665:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC78 0C030003        	  7666:     cmpi.b  #$03,D3
02:0003CC7C 6712            	  7667:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7668:     ; State 1, substate 1
                            	  7669:     ;
                            	  7670:     ; Add $14 to the frame image index to index into the bloated
                            	  7671:     ; frame images and H-flips.
                            	  7672:     ;
02:0003CC7E 1014            	  7673:     move.b  ($0000,A4),D0
02:0003CC80 023C00EE        	  7674:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC84 123C0014        	  7675:     move.b  #$14,D1
02:0003CC88 D101            	  7676:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC8A 7600            	  7677:     moveq   #0,D3
02:0003CC8C 1600            	  7678:     move.b  D0,D3
02:0003CC8E 6032            	  7679:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7680: 
                            	  7681:     even
                            	  7682: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7683:     ; In bloated substates 2 and 3:
                            	  7684:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7685:     ;
02:0003CC90 102C0015        	  7686:     move.b  ($0015,A4),D0
02:0003CC94 02000002        	  7687:     andi.b #$02,D0
02:0003CC98 6604            	  7688:     bne.s  __far_z_04_0071
02:0003CC9A 600000A6        	  7689:     jmp  L11B00_Exit
                            	  7690: __far_z_04_0071:
02:0003CC9E 7600            	  7691:     moveq   #0,D3
02:0003CCA0 1614            	  7692:     move.b  ($0000,A4),D3
02:0003CCA2 601E            	  7693:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7694: 
                            	  7695:     even
                            	  7696: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7697:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7698:     ;
02:0003CCA4 7008            	  7699:     moveq   #8,D0
                            	  7700:     even
                            	  7701: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CCA6 7600            	  7702:     moveq   #0,D3
02:0003CCA8 1614            	  7703:     move.b  ($0000,A4),D3
02:0003CCAA 122C0015        	  7704:     move.b  ($0015,A4),D1
02:0003CCAE C001            	  7705:     and.b  D1,D0
02:0003CCB0 6710            	  7706:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7707:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7708:     ; in order to index into the second set of frame image numbers.
                            	  7709:     ;
02:0003CCB2 1003            	  7710:     move.b  D3,D0
02:0003CCB4 023C00EE        	  7711:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCB8 123C0005        	  7712:     move.b  #$05,D1
02:0003CCBC D101            	  7713:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CCBE 7600            	  7714:     moveq   #0,D3
02:0003CCC0 1600            	  7715:     move.b  D0,D3
                            	  7716:     even
                            	  7717: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7718:     ; Start preparing sprites.
                            	  7719:     ;
02:0003CCC2 4EB90004D304    	  7720:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCC8 1003            	  7721:     move.b  D3,D0
02:0003CCCA 1B00            	  7722:     move.b  D0,-(A5)  ; PHA
                            	  7723:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7724:     ;
02:0003CCCC 41F90003CC26    	  7725:     lea     (DodongoFrameHFlips).l,A0
02:0003CCD2 10303000        	  7726:     move.b  (A0,D3.W),D0
02:0003CCD6 1940000F        	  7727:     move.b  D0,($000F,A4)
02:0003CCDA 41F90003CC1C    	  7728:     lea     (DodongoFrameImages).l,A0
02:0003CCE0 10303000        	  7729:     move.b  (A0,D3.W),D0
                            	  7730:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7731:     ; They are drawn mirrored.
                            	  7732:     ;
02:0003CCE4 0C000007        	  7733:     cmpi.b  #$07,D0
02:0003CCE8 6706            	  7734:     beq  _anon_z04_92
02:0003CCEA 0C000009        	  7735:     cmpi.b  #$09,D0
02:0003CCEE 6608            	  7736:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7737: _anon_z04_92:
02:0003CCF0 4EB900031678    	  7738:     jsr     DrawObjectMirrored
02:0003CCF6 6006            	  7739:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7740: 
                            	  7741:     even
                            	  7742: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7743:     ; No other frame images are mirrored.
                            	  7744:     ;
02:0003CCF8 4EB90003167C    	  7745:     jsr     DrawObjectNotMirrored
                            	  7746:     even
                            	  7747: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CCFE 101D            	  7748:     move.b  (A5)+,D0  ; PLA
02:0003CD00 7600            	  7749:     moveq   #0,D3
02:0003CD02 1600            	  7750:     move.b  D0,D3
                            	  7751:     ; If facing vertically, then return. There's no other side to draw.
                            	  7752:     ;
02:0003CD04 41EC0098        	  7753:     lea     ($0098,A4),A0
02:0003CD08 10302000        	  7754:     move.b  (A0,D2.W),D0
02:0003CD0C 02000003        	  7755:     andi.b #$03,D0
02:0003CD10 6602            	  7756:     bne.s  __far_z_04_0072
02:0003CD12 602E            	  7757:     jmp  L11B00_Exit
                            	  7758: __far_z_04_0072:
                            	  7759:     ; Else draw the right side.
                            	  7760:     ;
                            	  7761:     ; Keep the Y coordinate in [01].
                            	  7762:     ; But, store (X + $10) in [00].
                            	  7763:     ;
02:0003CD14 10342070        	  7764:     move.b  ($70,A4,D2.W),D0
02:0003CD18 023C00EE        	  7765:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD1C 123C0010        	  7766:     move.b  #$10,D1
02:0003CD20 D101            	  7767:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD22 1880            	  7768:     move.b  D0,($0000,A4)
02:0003CD24 6114            	  7769:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7770:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7771:     ;
                            	  7772:     ; So, if we had animation frame 1, direction left:
                            	  7773:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7774:     ; - frame image index = 6 (1 + 5)
                            	  7775:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7776:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7777:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7778:     ;
                            	  7779:     ; So, 3 would have been the frame number used above for
                            	  7780:     ; the left side.
                            	  7781:     ;
                            	  7782:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7783:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7784:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7785:     ; on the right.
                            	  7786:     ;
02:0003CD26 41F90003CC1C    	  7787:     lea     (DodongoFrameImages).l,A0
02:0003CD2C 10303000        	  7788:     move.b  (A0,D3.W),D0
02:0003CD30 0A000001        	  7789:     eori.b #$01,D0
02:0003CD34 4EF90003167C    	  7790:     jmp     DrawObjectNotMirrored
                            	  7791: 
                            	  7792: ; Returns:
                            	  7793: ; A: 3
                            	  7794: ; [04]: left sprite attributes
                            	  7795: ; [05]: right sprite attributes
                            	  7796: ;
                            	  7797:     even
                            	  7798: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD3A 7003            	  7799:     moveq   #3,D0
02:0003CD3C 4EB90003196E    	  7800:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7801:     even
                            	  7802: L11B00_Exit:
02:0003CD42 4E75            	  7803:     rts
