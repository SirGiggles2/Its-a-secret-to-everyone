02:0003F470 41EC009A        	 13070:     lea     ($009A,A4),A0
02:0003F474 11803000        	 13071:     move.b  D0,(A0,D3.W)
02:0003F478 5303            	 13072:     subq.b  #1,D3
02:0003F47A 6AC2            	 13073:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
