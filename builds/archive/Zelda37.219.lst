02:00030254 12302000        	  3217:     move.b  (A0,D2.W),D1
02:00030258 C001            	  3218:     and.b  D1,D0
02:0003025A 6712            	  3219:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3220:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  3221:     ;
02:0003025C 41EC00AC        	  3222:     lea     ($00AC,A4),A0
02:00030260 52302000        	  3223:     addq.b  #1,(A0,D2.W)
02:00030264 7070            	  3224:     moveq   #112,D0
02:00030266 41EC03BC        	  3225:     lea     ($03BC,A4),A0
02:0003026A 11802000        	  3226:     move.b  D0,(A0,D2.W)
