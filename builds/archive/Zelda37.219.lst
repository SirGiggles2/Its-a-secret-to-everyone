                            	  5822: LayOutDoors:
                            	  5823:     ; Copies the right door face for the direction, type, and state
                            	  5824:     ; of the door to the play area tile map.
                            	  5825:     ;
                            	  5826:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5827:     ; that are not true doors.
                            	  5828:     ;
02:00043922 7403            	  5829:     moveq   #3,D2
                            	  5830:     even
                            	  5831: L_LayOutDoors_LoopDoors:
                            	  5832:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5833:     ;
02:00043924 7001            	  5834:     moveq   #1,D0
                            	  5835:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5836:     ;
                            	  5837:     ; [06] indicates whether we're handling the first half of
                            	  5838:     ; the door: Left half for N/S, Top half for E/W.
                            	  5839:     ;
02:00043926 19400006        	  5840:     move.b  D0,($0006,A4)
                            	  5841:     even
                            	  5842: L_LayOutDoors_LoopHalves:
02:0004392A 1002            	  5843:     move.b  D2,D0
02:0004392C 1B00            	  5844:     move.b  D0,-(A5)  ; PHA
02:0004392E 1940000B        	  5845:     move.b  D0,($000B,A4)
02:00043932 41F9000438FE    	  5846:     lea     (DoorBits).l,A0
02:00043938 10302000        	  5847:     move.b  (A0,D2.W),D0
02:0004393C 19400002        	  5848:     move.b  D0,($0002,A4)
02:00043940 6100FD4A        	  5849:     jsr     FindDoorAttrByDoorBit
                            	  5850:     ; Begin looking for the door face for the door attribute.
                            	  5851:     ; In general, use the door type as the provisional face;
                            	  5852:     ; except turn 4 into 8.
                            	  5853:     ;
02:00043944 0C000005        	  5854:     cmpi.b  #$05,D0
02:00043948 642A            	  5855:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004394A 0C000004        	  5856:     cmpi.b  #$04,D0
02:0004394E 6608            	  5857:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:00043950 7008            	  5858:     moveq   #8,D0
02:00043952 6620            	  5859:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5860:     even
                            	  5861: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5862:     ; We jump here if the door type is bombable and was opened.
                            	  5863:     ; Change the provisional door face to value 9, which
                            	  5864:     ; will become the "hole in the wall".
                            	  5865:     ;
02:00043954 7009            	  5866:     moveq   #9,D0
02:00043956 665A            	  5867:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5868:     even
                            	  5869: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5870:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5871:     ; the mask of opened doors, because this is not a true door.
                            	  5872:     ;
02:00043958 1B00            	  5873:     move.b  D0,-(A5)  ; PHA
02:0004395A 102C0002        	  5874:     move.b  ($0002,A4),D0
02:0004395E 4600            	  5875:     eori.b #$FF,D0
02:00043960 122C00EE        	  5876:     move.b  ($00EE,A4),D1
02:00043964 C001            	  5877:     and.b  D1,D0
02:00043966 194000EE        	  5878:     move.b  D0,($00EE,A4)
02:0004396A 101D            	  5879:     move.b  (A5)+,D0  ; PLA
                            	  5880:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5881:     ;
02:0004396C 0C000001        	  5882:     cmpi.b  #$01,D0
02:00043970 6402            	  5883:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043972 7004            	  5884:     moveq   #4,D0
                            	  5885:     even
                            	  5886: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5887:     ; The door attribute (DA) has been mapped to a
                            	  5888:     ; provisional door face value (PF) in %A as follows:
                            	  5889:     ;
                            	  5890:     ; DA PF Meaning
                            	  5891:     ; -------------
                            	  5892:     ; 0  4  open
                            	  5893:     ; 1  1  wall
                            	  5894:     ; 2  2  false wall
                            	  5895:     ; 3  3  false wall 2
                            	  5896:     ; 4  8  bombable
                            	  5897:     ; 5  5  key
                            	  5898:     ; 6  6  key 2
                            	  5899:     ; 7  7  shutter
                            	  5900:     ;
                            	  5901:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5902:     ; has been cleared, if the type was "open" or any wall.
                            	  5903:     ;
                            	  5904:     ;
                            	  5905:     ; Save the provisional face.
02:00043974 1B00            	  5906:     move.b  D0,-(A5)  ; PHA
                            	  5907:     ; If the current direction points to a door that has been opened,
                            	  5908:     ; then see if we need to set door flags.
                            	  5909:     ;
02:00043976 102C00EE        	  5910:     move.b  ($00EE,A4),D0
02:0004397A 122C0002        	  5911:     move.b  ($0002,A4),D1
02:0004397E C001            	  5912:     and.b  D1,D0
02:00043980 7400            	  5913:     moveq   #0,D2
02:00043982 1400            	  5914:     move.b  D0,D2
02:00043984 101D            	  5915:     move.b  (A5)+,D0  ; PLA
02:00043986 122C0002        	  5916:     move.b  ($0002,A4),D1
02:0004398A B401            	  5917:     cmp.b   D1,D2
02:0004398C 6624            	  5918:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5919:     ; The current direction points to a door that has been opened.
                            	  5920:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5921:     ;
                            	  5922:     ;
                            	  5923:     ; Save provisional door face in Y register.
02:0004398E 7600            	  5924:     moveq   #0,D3
02:00043990 1600            	  5925:     move.b  D0,D3
02:00043992 101D            	  5926:     move.b  (A5)+,D0  ; PLA
02:00043994 1B00            	  5927:     move.b  D0,-(A5)  ; PHA
02:00043996 7400            	  5928:     moveq   #0,D2
02:00043998 1400            	  5929:     move.b  D0,D2
02:0004399A 1003            	  5930:     move.b  D3,D0
                            	  5931:     ; If provisional door face is not for a shutter, then
                            	  5932:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5933:     ;
                            	  5934:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5935:     ;
02:0004399C 0C000007        	  5936:     cmpi.b  #$07,D0
02:000439A0 670E            	  5937:     beq  _anon_z05_111
02:000439A2 1B00            	  5938:     move.b  D0,-(A5)  ; PHA
02:000439A4 6100DD54        	  5939:     jsr     SetDoorFlag
02:000439A8 101D            	  5940:     move.b  (A5)+,D0  ; PLA
                            	  5941:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5942:     ; then go make it 9 (open "bombable").
                            	  5943:     ; Else make it 4 (open "door").
                            	  5944:     ;
02:000439AA 0C000008        	  5945:     cmpi.b  #$08,D0
02:000439AE 67A4            	  5946:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5947: _anon_z05_111:
02:000439B0 7004            	  5948:     moveq   #4,D0
                            	  5949:     even
                            	  5950: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5951:     ; For opened doors, the provisional door face has become:
                            	  5952:     ;
                            	  5953:     ; DA PF Meaning
                            	  5954:     ; -------------
                            	  5955:     ; 0  4  open
                            	  5956:     ; 1  1  wall
                            	  5957:     ; 2  2  false wall
                            	  5958:     ; 3  3  false wall 2
                            	  5959:     ; 4  9  bombable
                            	  5960:     ; 5  4  key
                            	  5961:     ; 6  4  key 2
                            	  5962:     ; 7  4  shutter
                            	  5963:     ;
                            	  5964:     ;
                            	  5965:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5966:     ;
02:000439B2 7400            	  5967:     moveq   #0,D2
02:000439B4 142C0006        	  5968:     move.b  ($0006,A4),D2
02:000439B8 6712            	  5969:     beq  _anon_z05_112
02:000439BA 7400            	  5970:     moveq   #0,D2
02:000439BC 142C000B        	  5971:     move.b  ($000B,A4),D2
02:000439C0 1B00            	  5972:     move.b  D0,-(A5)  ; PHA
02:000439C2 6100FCC8        	  5973:     jsr     FindDoorAttrByDoorBit
02:000439C6 61001D0C        	  5974:     jsr     CalcOpenDoorwayMask
02:000439CA 101D            	  5975:     move.b  (A5)+,D0  ; PLA
                            	  5976: _anon_z05_112:
                            	  5977:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5978:     ; because the visible door face is already a wall.
                            	  5979:     ;
02:000439CC 0C000004        	  5980:     cmpi.b  #$04,D0
02:000439D0 650000DC        	  5981:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5982:     ; For all other provisional face values, calculate:
                            	  5983:     ; door face := provisional face - 3
02:000439D4 003C0011        	  5984:     ori     #$11,CCR  ; SEC: set C+X
02:000439D8 123C0003        	  5985:     move.b  #$03,D1
02:000439DC 0A3C0010        	  5986:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439E0 9101            	  5987:     subx.b  D1,D0   ; SBC #$03
02:000439E2 0A3C0010        	  5988:     eori    #$10,CCR  ; restore X = 6502 C
02:000439E6 7600            	  5989:     moveq   #0,D3
02:000439E8 1600            	  5990:     move.b  D0,D3
                            	  5991:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5992:     ; subtract one.
                            	  5993:     ;
02:000439EA 0C030003        	  5994:     cmpi.b  #$03,D3
02:000439EE 6502            	  5995:     bcs  _anon_z05_113
02:000439F0 5303            	  5996:     subq.b  #1,D3
                            	  5997: _anon_z05_113:
                            	  5998:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5999:     ;
                            	  6000:     ; DT DFC DFO Meaning
                            	  6001:     ; ------------------
                            	  6002:     ; 0  1   1   open
                            	  6003:     ; 4  4   5   bombable
                            	  6004:     ; 5  2   1   key
                            	  6005:     ; 6  2   1   key 2
                            	  6006:     ; 7  3   1   shutter
                            	  6007:     ;
                            	  6008:     ;
                            	  6009:     ; Get the direction index.
02:000439F2 101D            	  6010:     move.b  (A5)+,D0  ; PLA
02:000439F4 1B00            	  6011:     move.b  D0,-(A5)  ; PHA
02:000439F6 610000D0        	  6012:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6013:     ; If handling the second half, then offset to the second half
                            	  6014:     ; of the tiles.
                            	  6015:     ;
02:000439FA 102C0006        	  6016:     move.b  ($0006,A4),D0
02:000439FE 6618            	  6017:     bne  _anon_z05_114
02:00043A00 41F900043916    	  6018:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00043A06 10302000        	  6019:     move.b  (A0,D2.W),D0
02:00043A0A 4EB900030F08    	  6020:     jsr     AddToInt16At0
02:00043A10 7006            	  6021:     moveq   #6,D0
02:00043A12 4EB900030F10    	  6022:     jsr     AddToInt16At2
                            	  6023: _anon_z05_114:
                            	  6024:     ; Fix Y at 0 for copying source tiles to destination.
                            	  6025:     ; Pointers will be incremented instead of Y.
02:00043A18 7600            	  6026:     moveq   #0,D3
02:00043A1A 41F90004391A    	  6027:     lea     (DirIndexToDoorColumnCount).l,A0
02:00043A20 10302000        	  6028:     move.b  (A0,D2.W),D0
02:00043A24 19400005        	  6029:     move.b  D0,($0005,A4)
