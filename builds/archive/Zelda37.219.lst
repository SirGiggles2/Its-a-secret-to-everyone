02:00045674 182C0001        	  9310:     move.b  ($01,A4),D4  ; ptr hi
02:00045678 024100FF        	  9311:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004567C E14C            	  9312:     lsl.w   #8,D4
