                            	  6967: Aquamentus_Draw:
                            	  6968:     ; Every $10 screen frames, switch animation frames.
                            	  6969:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6970:     ; The last tile of frame 0 is at index 5.
                            	  6971:     ; The last tile of frame 1 is at index $B.
                            	  6972:     ;
02:0003C7CC 7605            	  6973:     moveq   #5,D3
02:0003C7CE 102C0015        	  6974:     move.b  ($0015,A4),D0
02:0003C7D2 02000010        	  6975:     andi.b #$10,D0
02:0003C7D6 6602            	  6976:     bne  _anon_z04_88
02:0003C7D8 760B            	  6977:     moveq   #11,D3
                            	  6978: _anon_z04_88:
02:0003C7DA 1943000A        	  6979:     move.b  D3,($000A,A4)
                            	  6980:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6981:     ;
02:0003C7DE 7005            	  6982:     moveq   #5,D0
02:0003C7E0 1940000B        	  6983:     move.b  D0,($000B,A4)
                            	  6984:     even
                            	  6985: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7E4 7600            	  6986:     moveq   #0,D3
02:0003C7E6 162C000B        	  6987:     move.b  ($000B,A4),D3
                            	  6988:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6989:     ; Store it in [00].
                            	  6990:     ;
02:0003C7EA 10342070        	  6991:     move.b  ($70,A4,D2.W),D0
02:0003C7EE 023C00EE        	  6992:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7F2 41F90003C7C6    	  6993:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7F8 12303000        	  6994:     move.b  (A0,D3.W),D1
02:0003C7FC D101            	  6995:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7FE 1880            	  6996:     move.b  D0,($0000,A4)
                            	  6997:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6998:     ; Store it in [01].
                            	  6999:     ;
02:0003C800 41EC0084        	  7000:     lea     ($0084,A4),A0
02:0003C804 10302000        	  7001:     move.b  (A0,D2.W),D0
02:0003C808 023C00EE        	  7002:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C80C 41F90003C7C0    	  7003:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C812 12303000        	  7004:     move.b  (A0,D3.W),D1
02:0003C816 D101            	  7005:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C818 19400001        	  7006:     move.b  D0,($0001,A4)
                            	  7007:     ; Calculate sprite attributes:
                            	  7008:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7009:     ;
                            	  7010:     ; If the boss is temporarily invincible, then
                            	  7011:     ; this makes it flash by cycling all the palette rows.
                            	  7012:     ;
                            	  7013:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7014:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7015:     ;
02:0003C81C 41EC04F0        	  7016:     lea     ($04F0,A4),A0
02:0003C820 10302000        	  7017:     move.b  (A0,D2.W),D0
02:0003C824 02000003        	  7018:     andi.b #$03,D0
02:0003C828 0A000003        	  7019:     eori.b #$03,D0
02:0003C82C 19400003        	  7020:     move.b  D0,($0003,A4)
02:0003C830 7600            	  7021:     moveq   #0,D3
02:0003C832 162C000A        	  7022:     move.b  ($000A,A4),D3
                            	  7023:     ; Look up the tile for this sprite.
                            	  7024:     ; If it's not the first one (face), then go write the sprite record.
                            	  7025:     ;
02:0003C836 41F90003C7B4    	  7026:     lea     (AquamentusTiles).l,A0
02:0003C83C 10303000        	  7027:     move.b  (A0,D3.W),D0
02:0003C840 12390003C7B4    	  7028:     move.b  (AquamentusTiles).l,D1
02:0003C846 B001            	  7029:     cmp.b   D1,D0
02:0003C848 6610            	  7030:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7031:     ; Else it's the first one (the face tile).
                            	  7032:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7033:     ;
                            	  7034:     ; $CC/CD shows the closed mouth face.
                            	  7035:     ; $C0/C1 shows the open mouth face.
                            	  7036:     ;
02:0003C84A 7600            	  7037:     moveq   #0,D3
02:0003C84C 16342028        	  7038:     move.b  ($28,A4,D2.W),D3
02:0003C850 0C030020        	  7039:     cmpi.b  #$20,D3
02:0003C854 6404            	  7040:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C856 103C00C0        	  7041:     move.b  #$C0,D0
                            	  7042:     even
                            	  7043: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C85A 610E            	  7044:     jsr     WriteBossSprite
                            	  7045:     ; Bottom of the loop.
                            	  7046:     ; Decrement tile index and loop index.
                            	  7047:     ;
02:0003C85C 532C000A        	  7048:     subq.b  #1,($000A,A4)
02:0003C860 532C000B        	  7049:     subq.b  #1,($000B,A4)
02:0003C864 6A00FF7E        	  7050:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C868 4E75            	  7051:     rts
                            	  7052: 
                            	  7053: ; Params:
                            	  7054: ; A: tile
                            	  7055: ; [00]: X
                            	  7056: ; [01]: Y
                            	  7057: ; [03]: sprite attributes
                            	  7058: ;
                            	  7059: ; Save the tile
                            	  7060:     even
