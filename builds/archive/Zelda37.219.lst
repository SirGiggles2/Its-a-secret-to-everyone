02:0003A27C 41EC00AC        	  1713:     lea     ($00AC,A4),A0
02:0003A280 16302000        	  1714:     move.b  (A0,D2.W),D3
02:0003A284 6758            	  1715:     beq  _L_z04_Gel_Move_State0
02:0003A286 5303            	  1716:     subq.b  #1,D3
02:0003A288 666E            	  1717:     bne  _L_z04_Gel_Move_State2
                            	  1718:     ; State 1.
                            	  1719:     ;
                            	  1720:     ; If the timer has not expired, then move.
