                            	  8096: UpdatePolsVoiceState1_Jumping:
                            	  8097:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8098:     ;
02:0003CFA2 41EC0444        	  8099:     lea     ($0444,A4),A0
02:0003CFA6 10302000        	  8100:     move.b  (A0,D2.W),D0
02:0003CFAA 023C00EE        	  8101:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFAE 123C0038        	  8102:     move.b  #$38,D1
02:0003CFB2 D101            	  8103:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFB4 41EC0444        	  8104:     lea     ($0444,A4),A0
02:0003CFB8 11802000        	  8105:     move.b  D0,(A0,D2.W)
                            	  8106:     ; Add Carry to high speed byte (vertical).
                            	  8107:     ;
02:0003CFBC 41EC0412        	  8108:     lea     ($0412,A4),A0
02:0003CFC0 10302000        	  8109:     move.b  (A0,D2.W),D0
02:0003CFC4 123C0000        	  8110:     move.b  #$00,D1
02:0003CFC8 D101            	  8111:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFCA 41EC0412        	  8112:     lea     ($0412,A4),A0
02:0003CFCE 11802000        	  8113:     move.b  D0,(A0,D2.W)
                            	  8114:     ; Add high speed byte to Y coordinate.
                            	  8115:     ;
02:0003CFD2 023C00EE        	  8116:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFD6 41EC0084        	  8117:     lea     ($0084,A4),A0
02:0003CFDA 12302000        	  8118:     move.b  (A0,D2.W),D1
