02:00030FC8 66E8            	  5284:     bne  _anon_z01_63
                            	  5285:     ; Switch to room item object slot $13.
                            	  5286:     ;
02:00030FCA 7413            	  5287:     moveq   #19,D2
                            	  5288:     ; If room item object wasn't activated, then return.
                            	  5289:     ;
02:00030FCC 41EC00AC        	  5290:     lea     ($00AC,A4),A0
02:00030FD0 10302000        	  5291:     move.b  (A0,D2.W),D0
02:00030FD4 6BDC            	  5292:     bmi  _anon_z01_63
                            	  5293:     ; Pass RoomItemId, also known as [98][$13] and ObjDir[$13],
                            	  5294:     ; to try to take the item.
                            	  5295:     ;
02:00030FD6 41EC0098        	  5296:     lea     ($0098,A4),A0
02:00030FDA 10302000        	  5297:     move.b  (A0,D2.W),D0
02:00030FDE 19400004        	  5298:     move.b  D0,($0004,A4)
                            	  5299: ; Params:
                            	  5300: ; X: object index
                            	  5301: ; [04]: item type
                            	  5302: ;
                            	  5303: ;
                            	  5304: ; If the lifetime timer of the item >= $F0, then return;
                            	  5305: ; so that the player can't pick it up right away.
                            	  5306: ;
                            	  5307: ; [03A8][X] is used to count down the life of the item.
