                            	  1876: _L_z05_InitMode_EnterRoom_Method2:
                            	  1877:     ; Enter method 2.
                            	  1878:     ; Room to room.
                            	  1879:     ;
                            	  1880:     ; Get the direction that the player is entering from.
                            	  1881:     ;
02:00041236 102C0098        	  1882:     move.b  ($0098,A4),D0
02:0004123A 19400053        	  1883:     move.b  D0,($0053,A4)
02:0004123E 4EB900030AB2    	  1884:     jsr     GetOppositeDir
                            	  1885:     ; If the player is entering from a door that was opened, then
                            	  1886:     ; set the "close" door command.
                            	  1887:     ;
02:00041244 122C00EE        	  1888:     move.b  ($00EE,A4),D1
02:00041248 C001            	  1889:     and.b  D1,D0
02:0004124A 19400055        	  1890:     move.b  D0,($0055,A4)
02:0004124E 6706            	  1891:     beq  _anon_z05_43
02:00041250 7002            	  1892:     moveq   #2,D0
02:00041252 19400054        	  1893:     move.b  D0,($0054,A4)
                            	  1894: _anon_z05_43:
                            	  1895:     ; If in OW, go reset Link's relative position, and work on objects.
