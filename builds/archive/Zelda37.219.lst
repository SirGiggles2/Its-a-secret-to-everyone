02:00034CD4 10302000        	  2566:     move.b  (A0,D2.W),D0
02:00034CD8 41EC0422        	  2567:     lea     ($0422,A4),A0
02:00034CDC 11803000        	  2568:     move.b  D0,(A0,D3.W)
02:00034CE0 5302            	  2569:     subq.b  #1,D2
02:00034CE2 5303            	  2570:     subq.b  #1,D3
02:00034CE4 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034CE6 522C0420        	  2572:     addq.b  #1,($0420,A4)
                            	  2573:     even
                            	  2574: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2575:     ; At this point:
                            	  2576:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2577:     ;   - This will be changed as the player inputs characters.
                            	  2578:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2579:     ;   - This will be changed as the player inputs characters.
                            	  2580:     ; - InitializedNameField [$0420] is set to 1.
                            	  2581:     ;
02:00034CEA 102C00F8        	  2582:     move.b  ($00F8,A4),D0
02:00034CEE 020000C0        	  2583:     andi.b #$C0,D0
02:00034CF2 670000E8        	  2584:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2585:     ; A or B was pressed.
                            	  2586:     ;
02:00034CF6 0C000040        	  2587:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034CFA 660000A6        	  2588:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2589:     ; A was pressed.
                            	  2590:     ;
                            	  2591:     ; Request to play the character click tune (same as bomb set).
02:00034CFE 7620            	  2592:     moveq   #32,D3
02:00034D00 19430604        	  2593:     move.b  D3,($0604,A4)
02:00034D04 7602            	  2594:     moveq   #2,D3
                            	  2595:     even
                            	  2596: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034D06 41EC0422        	  2597:     lea     ($0422,A4),A0
02:00034D0A 10303000        	  2598:     move.b  (A0,D3.W),D0
02:00034D0E 41EC0302        	  2599:     lea     ($0302,A4),A0
02:00034D12 11803000        	  2600:     move.b  D0,(A0,D3.W)
02:00034D16 5303            	  2601:     subq.b  #1,D3
02:00034D18 6AEC            	  2602:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034D1A 19430306        	  2603:     move.b  D3,($0306,A4)
02:00034D1E 7400            	  2604:     moveq   #0,D2
02:00034D20 142C0421        	  2605:     move.b  ($0421,A4),D2
02:00034D24 7600            	  2606:     moveq   #0,D3
02:00034D26 162C041F        	  2607:     move.b  ($041F,A4),D3
02:00034D2A 41F900034664    	  2608:     lea     (ModeE_CharMap).l,A0
02:00034D30 10303000        	  2609:     move.b  (A0,D3.W),D0
02:00034D34 19400305        	  2610:     move.b  D0,($0305,A4)
02:00034D38 41EC0638        	  2611:     lea     ($0638,A4),A0
02:00034D3C 11802000        	  2612:     move.b  D0,(A0,D2.W)
                            	  2613:     even
                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034D40 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034D44 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034D48 123C0008        	  2617:     move.b  #$08,D1
02:00034D4C D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034D4E 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034D52 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034D56 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034D5A 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034D5E 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034D62 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034D64 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034D68 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
02:00034D6C 123C0008        	  2645:     move.b  #$08,D1
02:00034D70 0A3C0010        	  2646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034D74 9101            	  2647:     subx.b  D1,D0   ; SBC #$08
02:00034D76 0A3C0010        	  2648:     eori    #$10,CCR  ; restore X = 6502 C
02:00034D7A 19400423        	  2649:     move.b  D0,($0423,A4)
                            	  2650:     ; It also means that we went past the end of the save slot
                            	  2651:     ; info name. Set the offset to the beginning of the name.
02:00034D7E 7600            	  2652:     moveq   #0,D3
02:00034D80 162C0016        	  2653:     move.b  ($0016,A4),D3
02:00034D84 41F9000346C0    	  2654:     lea     (SlotToNameOffset).l,A0
02:00034D8A 10303000        	  2655:     move.b  (A0,D3.W),D0
02:00034D8E 19400421        	  2656:     move.b  D0,($0421,A4)
                            	  2657:     ; If the name cursor has gone past the end of the field,
                            	  2658:     ; then wrap around.
02:00034D92 102C0070        	  2659:     move.b  ($0070,A4),D0
02:00034D96 0C0000B0        	  2660:     cmpi.b  #$B0,D0
02:00034D9A 6640            	  2661:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034D9C 7070            	  2662:     moveq   #112,D0
02:00034D9E 19400070        	  2663:     move.b  D0,($0070,A4)
                            	  2664:     even
                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034DA2 7600            	  2672:     moveq   #0,D3
02:00034DA4 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034DA8 41F9000346C0    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034DAE 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034DB2 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034DB6 B001            	  2677:     cmp.b   D1,D0
02:00034DB8 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034DBA 5300            	  2679:     subq.b  #1,D0
02:00034DBC 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034DC0 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034DC4 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034DC8 5101            	  2683:     subi.b  #8,D1
02:00034DCA 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034DCE 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034DD0 7600            	  2686:     moveq   #0,D3
02:00034DD2 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034DD4 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034DD8 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2691:     even
                            	  2692: _L_z02_ModeE_HandleAOrB_Exit:
02:00034DDC 60000096        	  2693:     jmp     ModeE_SetNameCursorSpriteX
                            	  2694: 
                            	  2695:     even
                            	  2696: ModeEandF_SetUpCursorSprites:
                            	  2697:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2698:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2699:     ; These are the cursor sprites.
02:00034DE0 760A            	  2700:     moveq   #10,D3
                            	  2701:     even
                            	  2702: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:00034DE2 41F9000346AA    	  2703:     lea     (ModeEandFCursorSprites).l,A0
02:00034DE8 10303000        	  2704:     move.b  (A0,D3.W),D0
02:00034DEC 41EC0201        	  2705:     lea     ($0201,A4),A0
02:00034DF0 11803000        	  2706:     move.b  D0,(A0,D3.W)
02:00034DF4 5303            	  2707:     subq.b  #1,D3
02:00034DF6 6AEA            	  2708:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00034DF8 7600            	  2709:     moveq   #0,D3
02:00034DFA 162C0016        	  2710:     move.b  ($0016,A4),D3
02:00034DFE 41F900034660    	  2711:     lea     (ModeEandFSlotCursorYs).l,A0
02:00034E04 10303000        	  2712:     move.b  (A0,D3.W),D0
02:00034E08 19400084        	  2713:     move.b  D0,($0084,A4)
02:00034E0C 19400200        	  2714:     move.b  D0,($0200,A4)
02:00034E10 102C0012        	  2715:     move.b  ($0012,A4),D0
02:00034E14 0C00000F        	  2716:     cmpi.b  #$0F,D0
                            	  2717:     ; There's more work in mode $E.
                            	  2718:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2719:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00034E18 6736            	  2720:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00034E1A 103C00F3        	  2721:     move.b  #$F3,D0
02:00034E1E 19400201        	  2722:     move.b  D0,($0201,A4)
                            	  2723:     ; Because the visible part of the cursor block sprite is
                            	  2724:     ; in the bottom, move the name cursor's sprite 8 pixels
