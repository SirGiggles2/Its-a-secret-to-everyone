02:0003B270 41EC0405        	  4052:     lea     ($0405,A4),A0
02:0003B274 10302000        	  4053:     move.b  (A0,D2.W),D0
02:0003B278 670A            	  4054:     beq  _anon_z04_55
02:0003B27A 705D            	  4055:     moveq   #93,D0
02:0003B27C 41EC034F        	  4056:     lea     ($034F,A4),A0
02:0003B280 11802000        	  4057:     move.b  D0,(A0,D2.W)
