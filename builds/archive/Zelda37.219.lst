                            	  8078: IsrReset:
                            	  8079:     ; SEI: NES IRQ disable — NOP on Genesis (VBlank=NMI fires regardless of IRQ mask)
                            	  8080:     ; CLD: decimal mode ignored (68000 has no decimal mode)
02:0004DBC2 7000            	  8081:     moveq   #0,D0
02:0004DBC4 4EB90000E058    	  8082:     jsr     _ppu_write_0  ; PPU $2000 write, D0=val
02:0004DBCA 143C00FF        	  8083:     move.b  #$FF,D2
02:0004DBCE 1E02            	  8084:     move.b  D2,D7   ; TXS: fake SP update (D7=NES SP shadow)
