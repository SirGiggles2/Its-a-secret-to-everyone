02:00031DE0 1614            	  7056:     move.b  ($0000,A4),D3
02:00031DE2 41EC00AC        	  7057:     lea     ($00AC,A4),A0
02:00031DE6 10303000        	  7058:     move.b  (A0,D3.W),D0
