                            	  6855:     ; Flag collision with [0C], even though [06] was already set.
                            	  6856:     ;
02:00031C74 522C000C        	  6857:     addq.b  #1,($000C,A4)
                            	  6858:     ; Unpack the damage points for the monster's type.
                            	  6859:     ; The low nibble is the high byte.
                            	  6860:     ; (Damage points byte AND $F0) is the low byte.
                            	  6861:     ;
02:00031C78 7600            	  6862:     moveq   #0,D3
02:00031C7A 41EC034F        	  6863:     lea     ($034F,A4),A0
02:00031C7E 16302000        	  6864:     move.b  (A0,D2.W),D3
02:00031C82 41F900031AE4    	  6865:     lea     (ObjTypeToDamagePoints).l,A0
02:00031C88 10303000        	  6866:     move.b  (A0,D3.W),D0
02:00031C8C 1B00            	  6867:     move.b  D0,-(A5)  ; PHA
02:00031C8E 0200000F        	  6868:     andi.b #$0F,D0
02:00031C92 1940000D        	  6869:     move.b  D0,($000D,A4)
02:00031C96 101D            	  6870:     move.b  (A5)+,D0  ; PLA
02:00031C98 020000F0        	  6871:     andi.b #$F0,D0
02:00031C9C 1940000E        	  6872:     move.b  D0,($000E,A4)
                            	  6873: ; Params:
                            	  6874: ; X: object index of the attacker
                            	  6875: ; [0D]: damage points high byte
                            	  6876: ; [0E]: damage points low byte
                            	  6877: ;
                            	  6878: ;
                            	  6879: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6880: ;
                            	  6881:     even
                            	  6882: Link_BeHarmed:
02:00031CA0 7600            	  6883:     moveq   #0,D3
02:00031CA2 41EC034F        	  6884:     lea     ($034F,A4),A0
02:00031CA6 16302000        	  6885:     move.b  (A0,D2.W),D3
02:00031CAA 0C03002E        	  6886:     cmpi.b  #$2E,D3
02:00031CAE 6706            	  6887:     beq  _anon_z01_85
02:00031CB0 7008            	  6888:     moveq   #8,D0
02:00031CB2 6100E946        	  6889:     jsr     PlaySample
                            	  6890: _anon_z01_85:
