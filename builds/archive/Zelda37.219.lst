02:0003DF94 53302000        	 10197:     subq.b  #1,(A0,D2.W)
                            	 10198:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10199:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10200:     ;
02:0003DF98 7602            	 10201:     moveq   #2,D3
02:0003DF9A 0C000070        	 10202:     cmpi.b  #$70,D0
02:0003DF9E 6408            	 10203:     bcc  _anon_z04_123
02:0003DFA0 0C000010        	 10204:     cmpi.b  #$10,D0
02:0003DFA4 6502            	 10205:     bcs  _anon_z04_123
02:0003DFA6 5203            	 10206:     addq.b  #1,D3
