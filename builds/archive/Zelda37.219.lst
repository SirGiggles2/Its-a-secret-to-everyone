02:00044748 E208            	  7532:     lsr.b  #1,D0   ; LSR A
02:0004474A E208            	  7533:     lsr.b  #1,D0   ; LSR A
02:0004474C E208            	  7534:     lsr.b  #1,D0   ; LSR A
