                            	  9864: Manhandla_Move:
                            	  9865:     ; Implement a way of manifesting the fractional part of the speed
                            	  9866:     ; in the movement.
                            	  9867:     ;
                            	  9868:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9869:     ; byte to add to the coordinates, then the effective speed would
                            	  9870:     ; be 1 pixel a frame instead of 1.25.
                            	  9871:     ;
                            	  9872:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9873:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9874:     ;
                            	  9875:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9876:     ;
                            	  9877:     ;   SA := SA + (SL AND $E0)
                            	  9878:     ;   [03] := SH + carry
                            	  9879:     ;
                            	  9880:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9881:     ;
02:0003DCE6 41EC041F        	  9882:     lea     ($041F,A4),A0
02:0003DCEA 10302000        	  9883:     move.b  (A0,D2.W),D0
02:0003DCEE 020000E0        	  9884:     andi.b #$E0,D0
02:0003DCF2 023C00EE        	  9885:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCF6 41EC0412        	  9886:     lea     ($0412,A4),A0
02:0003DCFA 12302000        	  9887:     move.b  (A0,D2.W),D1
02:0003DCFE D101            	  9888:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DD00 41EC0412        	  9889:     lea     ($0412,A4),A0
02:0003DD04 11802000        	  9890:     move.b  D0,(A0,D2.W)
                            	  9891:     ; Assign (high speed byte + carry) to [03].
                            	  9892:     ;
02:0003DD08 41EC042C        	  9893:     lea     ($042C,A4),A0
02:0003DD0C 10302000        	  9894:     move.b  (A0,D2.W),D0
02:0003DD10 123C0000        	  9895:     move.b  #$00,D1
02:0003DD14 D101            	  9896:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DD16 19400003        	  9897:     move.b  D0,($0003,A4)
                            	  9898:     ; Change coordinates by the speed amount/offset in [03]
                            	  9899:     ; according to the direction.
                            	  9900:     ;
                            	  9901:     ; Start with a mask of $A1 in [02]:
                            	  9902:     ; - low nibble represents the right direction
                            	  9903:     ; - high nibble is used to set or clear carry as we go along
                            	  9904:     ;
02:0003DD1A 103C00A1        	  9905:     move.b  #$A1,D0
02:0003DD1E 19400002        	  9906:     move.b  D0,($0002,A4)
                            	  9907:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9908:     ;
02:0003DD22 41EC0098        	  9909:     lea     ($0098,A4),A0
02:0003DD26 10302000        	  9910:     move.b  (A0,D2.W),D0
02:0003DD2A 122C0002        	  9911:     move.b  ($0002,A4),D1
02:0003DD2E C200            	  9912:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD30 6712            	  9913:     beq  _L_z04_Manhandla_Move_Left
02:0003DD32 10342070        	  9914:     move.b  ($70,A4,D2.W),D0
02:0003DD36 023C00EE        	  9915:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD3A 122C0003        	  9916:     move.b  ($0003,A4),D1
02:0003DD3E D101            	  9917:     addx.b  D1,D0   ; ADC $03
02:0003DD40 19802070        	  9918:     move.b  D0,($70,A4,D2.W)
                            	  9919:     even
                            	  9920: _L_z04_Manhandla_Move_Left:
                            	  9921:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9922:     ;
02:0003DD44 41EC0098        	  9923:     lea     ($0098,A4),A0
02:0003DD48 10302000        	  9924:     move.b  (A0,D2.W),D0
02:0003DD4C 122C0002        	  9925:     move.b  ($0002,A4),D1
02:0003DD50 E309            	  9926:     lsl.b  #1,D1   ; ASL $02
02:0003DD52 19410002        	  9927:     move.b  D1,($0002,A4)
02:0003DD56 122C0002        	  9928:     move.b  ($0002,A4),D1
02:0003DD5A C200            	  9929:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD5C 6716            	  9930:     beq  _L_z04_Manhandla_Move_Down
02:0003DD5E 10342070        	  9931:     move.b  ($70,A4,D2.W),D0
02:0003DD62 122C0003        	  9932:     move.b  ($0003,A4),D1
02:0003DD66 0A3C0010        	  9933:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD6A 9101            	  9934:     subx.b  D1,D0   ; SBC $03
02:0003DD6C 0A3C0010        	  9935:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD70 19802070        	  9936:     move.b  D0,($70,A4,D2.W)
                            	  9937:     even
                            	  9938: _L_z04_Manhandla_Move_Down:
                            	  9939:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9940:     ;
02:0003DD74 41EC0098        	  9941:     lea     ($0098,A4),A0
02:0003DD78 10302000        	  9942:     move.b  (A0,D2.W),D0
02:0003DD7C 122C0002        	  9943:     move.b  ($0002,A4),D1
02:0003DD80 E309            	  9944:     lsl.b  #1,D1   ; ASL $02
02:0003DD82 19410002        	  9945:     move.b  D1,($0002,A4)
02:0003DD86 122C0002        	  9946:     move.b  ($0002,A4),D1
02:0003DD8A C200            	  9947:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD8C 6716            	  9948:     beq  _L_z04_Manhandla_Move_Up
02:0003DD8E 41EC0084        	  9949:     lea     ($0084,A4),A0
02:0003DD92 10302000        	  9950:     move.b  (A0,D2.W),D0
02:0003DD96 122C0003        	  9951:     move.b  ($0003,A4),D1
02:0003DD9A D101            	  9952:     addx.b  D1,D0   ; ADC $03
02:0003DD9C 41EC0084        	  9953:     lea     ($0084,A4),A0
02:0003DDA0 11802000        	  9954:     move.b  D0,(A0,D2.W)
                            	  9955:     even
                            	  9956: _L_z04_Manhandla_Move_Up:
                            	  9957:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9958:     ;
02:0003DDA4 41EC0098        	  9959:     lea     ($0098,A4),A0
02:0003DDA8 10302000        	  9960:     move.b  (A0,D2.W),D0
02:0003DDAC 122C0002        	  9961:     move.b  ($0002,A4),D1
02:0003DDB0 E309            	  9962:     lsl.b  #1,D1   ; ASL $02
02:0003DDB2 19410002        	  9963:     move.b  D1,($0002,A4)
02:0003DDB6 122C0002        	  9964:     move.b  ($0002,A4),D1
02:0003DDBA C200            	  9965:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DDBC 671E            	  9966:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DDBE 41EC0084        	  9967:     lea     ($0084,A4),A0
02:0003DDC2 10302000        	  9968:     move.b  (A0,D2.W),D0
02:0003DDC6 122C0003        	  9969:     move.b  ($0003,A4),D1
02:0003DDCA 0A3C0010        	  9970:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DDCE 9101            	  9971:     subx.b  D1,D0   ; SBC $03
02:0003DDD0 0A3C0010        	  9972:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DDD4 41EC0084        	  9973:     lea     ($0084,A4),A0
02:0003DDD8 11802000        	  9974:     move.b  D0,(A0,D2.W)
                            	  9975:     even
                            	  9976: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9977:     ; To the frame accumulator, add:
                            	  9978:     ; - a random value between 0 and 3
                            	  9979:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9980:     ;
02:0003DDDC 10342019        	  9981:     move.b  ($19,A4,D2.W),D0
02:0003DDE0 02000003        	  9982:     andi.b #$03,D0
02:0003DDE4 023C00EE        	  9983:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDE8 122C0003        	  9984:     move.b  ($0003,A4),D1
02:0003DDEC D101            	  9985:     addx.b  D1,D0   ; ADC $03
02:0003DDEE 41EC0451        	  9986:     lea     ($0451,A4),A0
02:0003DDF2 12302000        	  9987:     move.b  (A0,D2.W),D1
02:0003DDF6 D101            	  9988:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DDF8 41EC0451        	  9989:     lea     ($0451,A4),A0
02:0003DDFC 11802000        	  9990:     move.b  D0,(A0,D2.W)
02:0003DE00 61001F48        	  9991:     jsr     BoundFlyer
                            	  9992:     ; TODO:
                            	  9993:     ; I don't see why this is needed.
                            	  9994:     ;
02:0003DE04 4EF90004D304    	  9995:     jmp     Anim_FetchObjPosForSpriteDescriptor
