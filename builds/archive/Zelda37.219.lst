02:00041C40 102C00F8        	  3238:     move.b  ($00F8,A4),D0
02:00041C44 122C0001        	  3239:     move.b  ($0001,A4),D1
02:00041C48 C001            	  3240:     and.b  D1,D0
02:00041C4A 194000F8        	  3241:     move.b  D0,($00F8,A4)
                            	  3242:     ; If in OW or button mask <> 0, return.
                            	  3243:     ;
02:00041C4E 102C0010        	  3244:     move.b  ($0010,A4),D0
02:00041C52 6720            	  3245:     beq  _L_z05_MaskInputInBorder_Exit
02:00041C54 102C0001        	  3246:     move.b  ($0001,A4),D0
02:00041C58 661A            	  3247:     bne  _L_z05_MaskInputInBorder_Exit
                            	  3248:     ; Mask off input directions perpendicular to player's facing.
