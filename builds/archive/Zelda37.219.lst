02:0003D076 023C00EE        	  8182:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D07A 123C0008        	  8183:     move.b  #$08,D1
02:0003D07E D101            	  8184:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
