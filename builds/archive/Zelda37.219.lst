02:0003DC8A 0C020005        	  9790:     cmpi.b  #$05,D2
02:0003DC8E 660A            	  9791:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC90 41EC0405        	  9792:     lea     ($0405,A4),A0
02:0003DC94 11802000        	  9793:     move.b  D0,(A0,D2.W)
