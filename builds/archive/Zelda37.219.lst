02:0003A2CC 41EC0394        	  1753:     lea     ($0394,A4),A0
02:0003A2D0 11802000        	  1754:     move.b  D0,(A0,D2.W)
02:0003A2D4 41EC00AC        	  1755:     lea     ($00AC,A4),A0
02:0003A2D8 52302000        	  1756:     addq.b  #1,(A0,D2.W)
                            	  1757:     even
