                            	  1791: InitMode_EnterRoom:
02:00041188 4EB90004B49E    	  1792:     jsr     DrawSpritesBetweenRooms
02:0004118E 4EB90004B4BC    	  1793:     jsr     ResetPlayerState
                            	  1794:     ; Reset [0300] to [051F].
                            	  1795:     ;
02:00041194 7005            	  1796:     moveq   #5,D0
02:00041196 761F            	  1797:     moveq   #31,D3
02:00041198 4EB90004ACF6    	  1798:     jsr     ClearRam0300UpTo
                            	  1799:     ; Reset door trigger info.
                            	  1800:     ;
02:0004119E 7000            	  1801:     moveq   #0,D0
02:000411A0 19400054        	  1802:     move.b  D0,($0054,A4)
02:000411A4 19400055        	  1803:     move.b  D0,($0055,A4)
                            	  1804:     ; Store level block attribute byte F for convenience.
                            	  1805:     ;
02:000411A8 7600            	  1806:     moveq   #0,D3
02:000411AA 162C00EB        	  1807:     move.b  ($00EB,A4),D3
02:000411AE 41F900FF6AFE    	  1808:     lea     (NES_SRAM+$0AFE).l,A0
02:000411B4 10303000        	  1809:     move.b  (A0,D3.W),D0
02:000411B8 194004CD        	  1810:     move.b  D0,($04CD,A4)
02:000411BC 61003B84        	  1811:     jsr     ResetInvObjState
                            	  1812:     ; There's more than one way to enter a room.
                            	  1813:     ;
                            	  1814:     ; 1: Out of a cave, dungeon, or cellar
                            	  1815:     ;     a. Walking exit
                            	  1816:     ;     b. Next to stairs
                            	  1817:     ; 2: Room to room
                            	  1818:     ;
                            	  1819:     ; Determine which one we need.
                            	  1820:     ;
02:000411C0 102C005A        	  1821:     move.b  ($005A,A4),D0
02:000411C4 6770            	  1822:     beq  _L_z05_InitMode_EnterRoom_Method2
02:000411C6 102C0010        	  1823:     move.b  ($0010,A4),D0
02:000411CA 665C            	  1824:     bne  _anon_z05_42
                            	  1825:     ; Enter method 1.
                            	  1826:     ;
                            	  1827:     ; Set up Link's exit from underground.
                            	  1828:     ;
02:000411CC 7600            	  1829:     moveq   #0,D3
02:000411CE 162C00EB        	  1830:     move.b  ($00EB,A4),D3
02:000411D2 41F900FF687E    	  1831:     lea     (NES_SRAM+$087E).l,A0
02:000411D8 10303000        	  1832:     move.b  (A0,D3.W),D0
02:000411DC 020000F0        	  1833:     andi.b #$F0,D0
02:000411E0 19400070        	  1834:     move.b  D0,($0070,A4)
02:000411E4 41F900FF6AFE    	  1835:     lea     (NES_SRAM+$0AFE).l,A0
02:000411EA 10303000        	  1836:     move.b  (A0,D3.W),D0
02:000411EE 02000007        	  1837:     andi.b #$07,D0
02:000411F2 E308            	  1838:     lsl.b  #1,D0   ; ASL A
02:000411F4 E308            	  1839:     lsl.b  #1,D0   ; ASL A
02:000411F6 E308            	  1840:     lsl.b  #1,D0   ; ASL A
02:000411F8 E308            	  1841:     lsl.b  #1,D0   ; ASL A
                            	  1842:     ; Add the first Y where Link can come out of underground.
                            	  1843:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:000411FA 123C004D        	  1844:     move.b  #$4D,D1
02:000411FE D101            	  1845:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00041200 19400084        	  1846:     move.b  D0,($0084,A4)
                            	  1847:     ; If the player didn't step on a cave entrance to go underground,
                            	  1848:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1849:     ;
02:00041204 7600            	  1850:     moveq   #0,D3
02:00041206 162C0065        	  1851:     move.b  ($0065,A4),D3
02:0004120A 0C030024        	  1852:     cmpi.b  #$24,D3
02:0004120E 6618            	  1853:     bne  _anon_z05_42
                            	  1854:     ; Enter method 1-a.
                            	  1855:     ;
                            	  1856:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1857:     ;
02:00041210 19400412        	  1858:     move.b  D0,($0412,A4)
02:00041214 023C00EE        	  1859:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041218 123C0010        	  1860:     move.b  #$10,D1
02:0004121C D101            	  1861:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004121E 19400084        	  1862:     move.b  D0,($0084,A4)
02:00041222 7008            	  1863:     moveq   #8,D0
02:00041224 19400603        	  1864:     move.b  D0,($0603,A4)
                            	  1865: _anon_z05_42:
                            	  1866:     ; This part is the same no matter if the player went
                            	  1867:     ; underground by stairs or a cave entrance.
                            	  1868:     ;
02:00041228 7004            	  1869:     moveq   #4,D0
02:0004122A 19400098        	  1870:     move.b  D0,($0098,A4)
02:0004122E 7000            	  1871:     moveq   #0,D0
02:00041230 19400053        	  1872:     move.b  D0,($0053,A4)
02:00041234 6064            	  1873:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
