                            	  1728:     even
                            	  1729: _L_z04_Gel_Move_Move:
                            	  1730:     ; Blocked or timer expired.
                            	  1731:     ;
                            	  1732:     ; Set X coordinate to ((X + 8) AND $F0).
                            	  1733:     ;
02:0003A296 10342070        	  1734:     move.b  ($70,A4,D2.W),D0
02:0003A29A 023C00EE        	  1735:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A29E 123C0008        	  1736:     move.b  #$08,D1
02:0003A2A2 D101            	  1737:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2A4 020000F0        	  1738:     andi.b #$F0,D0
02:0003A2A8 19802070        	  1739:     move.b  D0,($70,A4,D2.W)
                            	  1740:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1741:     ;
02:0003A2AC 41EC0084        	  1742:     lea     ($0084,A4),A0
02:0003A2B0 10302000        	  1743:     move.b  (A0,D2.W),D0
02:0003A2B4 123C0008        	  1744:     move.b  #$08,D1
02:0003A2B8 D101            	  1745:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2BA 020000F0        	  1746:     andi.b #$F0,D0
02:0003A2BE 0000000D        	  1747:     ori.b #$0D,D0
02:0003A2C2 41EC0084        	  1748:     lea     ($0084,A4),A0
02:0003A2C6 11802000        	  1749:     move.b  D0,(A0,D2.W)
                            	  1750:     ; Reset the grid offset, and go to state 2.
                            	  1751:     ;
