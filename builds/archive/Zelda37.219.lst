02:0000E634 3A04            	  1093:     move.w  D4,D5
02:0000E636 EC4D            	  1094:     lsr.w   #6,D5
02:0000E638 02450003        	  1095:     andi.w  #$0003,D5
02:0000E63C EB4D            	  1096:     lsl.w   #5,D5
02:0000E63E E14D            	  1097:     lsl.w   #8,D5
02:0000E640 5442            	  1098:     addq.w  #2,D2
02:0000E642 5443            	  1099:     addq.w  #2,D3
02:0000E644 610002AE        	  1100:     bsr     _attr_write_2x2
02:0000E648 5542            	  1101:     subq.w  #2,D2
02:0000E64A 5543            	  1102:     subq.w  #2,D3
