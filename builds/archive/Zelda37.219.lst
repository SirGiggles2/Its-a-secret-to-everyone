02:00039BBA 41EC0084        	   794:     lea     ($0084,A4),A0
02:00039BBE 12302000        	   795:     move.b  (A0,D2.W),D1
02:00039BC2 0A3C0010        	   796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039BC6 9101            	   797:     subx.b  D1,D0   ; SBC ObjY,X
02:00039BC8 0A3C0010        	   798:     eori    #$10,CCR  ; restore X = 6502 C
