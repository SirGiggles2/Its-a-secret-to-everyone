                            	  8540: ; Description:
                            	  8541: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8542: ; When walking, the object timer is set. When teleporting,
                            	  8543: ; the teleporting distance remaining is set.
                            	  8544: ;
                            	  8545: ; If we have the magic clock, then only go draw and check collisions.
                            	  8546: ;
                            	  8547:     even
                            	  8548: UpdateBlueWizzrobe:
02:0003D34E 102C066C        	  8549:     move.b  ($066C,A4),D0
