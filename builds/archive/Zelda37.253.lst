02:00031E2E 19400051        	  5850:     move.b  D0,($0051,A4)
                            	  5851:     ; If heart partial >= low damage points byte, then simply
                            	  5852:     ; subtract the damage byte from heart partial.
                            	  5853:     ; Else go borrow from full hearts.
                            	  5854:     ;
02:00031E32 102C0670        	  5855:     move.b  ($0670,A4),D0
02:00031E36 122C000E        	  5856:     move.b  ($000E,A4),D1
02:00031E3A B001            	  5857:     cmp.b   D1,D0
02:00031E3C 6546            	  5858:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031E3E 003C0011        	  5859:     ori     #$11,CCR  ; SEC: set C+X
02:00031E42 122C000E        	  5860:     move.b  ($000E,A4),D1
02:00031E46 0A3C0010        	  5861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E4A 9101            	  5862:     subx.b  D1,D0   ; SBC $0E
02:00031E4C 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E50 19400670        	  5864:     move.b  D0,($0670,A4)
                            	  5865:     ; If full hearts >= high damage points byte, then simply
