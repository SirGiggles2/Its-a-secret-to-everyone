                            	  3738: _L_z07_WieldFlute_Found:
                            	  3739:     ; Found.
                            	  3740:     ;
                            	  3741:     ; If it was the first room in the list, handle it specially.
                            	  3742:     ; This room is the only one in Q1 with a flute secret. It's also
                            	  3743:     ; the only one in the list without a flute secret in Q2.
                            	  3744:     ;
