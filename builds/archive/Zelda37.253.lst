02:000304BE 67CA            	  2334:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000304C0 6402            	  2335:     bcc  _anon_z01_27
02:000304C2 7608            	  2336:     moveq   #8,D3
                            	  2337: _anon_z01_27:
