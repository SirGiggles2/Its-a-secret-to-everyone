02:0002E612 0C000072        	   239:     cmpi.b  #$72,D0
02:0002E616 6714            	   240:     beq  _L_z01_InitCave_TakeType
02:0002E618 0C000071        	   241:     cmpi.b  #$71,D0
02:0002E61C 670E            	   242:     beq  _L_z01_InitCave_TakeType
02:0002E61E 0C00007B        	   243:     cmpi.b  #$7B,D0
02:0002E622 6408            	   244:     bcc  _L_z01_InitCave_TakeType
02:0002E624 0C00006E        	   245:     cmpi.b  #$6E,D0
