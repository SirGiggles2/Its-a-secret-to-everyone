02:00030DEC 67F4            	  3739:     beq  _anon_z01_52
                            	  3740:     ; Look in slot $10. If it's empty or there's a fire
                            	  3741:     ; (state = 0, or major state <> $10), then
                            	  3742:     ; go activate a bomb.
                            	  3743:     ;
02:00030DEE 7410            	  3744:     moveq   #16,D2
02:00030DF0 41EC00AC        	  3745:     lea     ($00AC,A4),A0
02:00030DF4 10302000        	  3746:     move.b  (A0,D2.W),D0
02:00030DF8 6724            	  3747:     beq  _L_z01_WieldBomb_FoundSlot
02:00030DFA 020000F0        	  3748:     andi.b #$F0,D0
02:00030DFE 0C000010        	  3749:     cmpi.b  #$10,D0
02:00030E02 661A            	  3750:     bne  _L_z01_WieldBomb_FoundSlot
                            	  3751:     ; Else look at slot $11.
                            	  3752:     ; If there's a bomb there (major state = $10), then return.
                            	  3753:     ;
02:00030E04 5202            	  3754:     addq.b  #1,D2
02:00030E06 41EC00AC        	  3755:     lea     ($00AC,A4),A0
02:00030E0A 10302000        	  3756:     move.b  (A0,D2.W),D0
02:00030E0E 670E            	  3757:     beq  _L_z01_WieldBomb_FoundSlot
02:00030E10 020000F0        	  3758:     andi.b #$F0,D0
02:00030E14 0C000010        	  3759:     cmpi.b  #$10,D0
02:00030E18 6604            	  3760:     bne.s  __far_z_01_0021
02:00030E1A 60000080        	  3761:     jmp  L69AB_Exit
