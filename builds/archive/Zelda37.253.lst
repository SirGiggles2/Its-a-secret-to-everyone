                            	 12365: Ganon_UpdateBrownState:
                            	 12366:     ; Every other frame decrement the state.
                            	 12367:     ; But every frame draw Ganon either translucent or opaque.
                            	 12368:     ;
02:0003F086 102C0015        	 12369:     move.b  ($0015,A4),D0
02:0003F08A E208            	 12370:     lsr.b  #1,D0   ; LSR A
