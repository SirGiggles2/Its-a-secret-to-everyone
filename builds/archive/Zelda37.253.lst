02:00041664 122C0001        	  2959:     move.b  ($0001,A4),D1
02:00041668 C001            	  2960:     and.b  D1,D0
02:0004166A 194000F8        	  2961:     move.b  D0,($00F8,A4)
                            	  2962:     ; If in OW or button mask <> 0, return.
