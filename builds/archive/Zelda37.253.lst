02:00035A8C 19400003        	  3824:     move.b  D0,($0003,A4)
                            	  3825:     ; [$04] is used as an index and sprite attributes.
                            	  3826:     ; It takes on values 0 to 2.
                            	  3827:     ; As an index, it represents a save slot.
                            	  3828:     ; As attributes, these values represent palettes 4 to 6.
02:00035A90 7000            	  3829:     moveq   #0,D0
02:00035A92 6100C028        	  3830:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  3831:     ; We want to start with sprite 4 (offset $10).
                            	  3832:     ; Begin with 8, so that the loop will add 8 and
                            	  3833:     ; put us at the offset we want.
02:00035A96 7008            	  3834:     moveq   #8,D0
