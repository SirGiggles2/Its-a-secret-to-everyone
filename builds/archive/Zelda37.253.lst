02:0003F02A 6702            	 12298:     beq.s  __far_z_04_0119
02:0003F02C 6058            	 12299:     jmp  Ganon_UpdateBrownState
                            	 12300: __far_z_04_0119:
                            	 12301:     ; State = 0: Blue
                            	 12302:     ;
                            	 12303:     ; If timer = 0, then go move around and shoot.
                            	 12304:     ;
02:0003F02E 10342028        	 12305:     move.b  ($28,A4,D2.W),D0
02:0003F032 6602            	 12306:     bne.s  __far_z_04_0120
02:0003F034 600E            	 12307:     jmp  Ganon_MoveAndShoot
                            	 12308: __far_z_04_0120:
                            	 12309:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12310:     ; Collisions were checked already.
                            	 12311:     ;
                            	 12312:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12313:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12314:     ;
02:0003F036 0C000001        	 12315:     cmpi.b  #$01,D0
02:0003F03A 6702            	 12316:     beq.s  __far_z_04_0121
02:0003F03C 6078            	 12317:     jmp  L_Ganon_DrawBody
                            	 12318: __far_z_04_0121:
