                            	  5591: CheckState30:
                            	  5592:     ; If major state <> $30, go check other states.
                            	  5593:     ;
02:0004BFFC 0C000030        	  5594:     cmpi.b  #$30,D0
02:0004C000 6656            	  5595:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5596:     ; State $3x. Slow down.
                            	  5597:     ;
                            	  5598:     ; Reset grid offset for movement.
                            	  5599:     ;
02:0004C002 7000            	  5600:     moveq   #0,D0
02:0004C004 41EC0394        	  5601:     lea     ($0394,A4),A0
02:0004C008 11802000        	  5602:     move.b  D0,(A0,D2.W)
                            	  5603:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5604:     ;
02:0004C00C 7040            	  5605:     moveq   #64,D0
02:0004C00E 41EC03BC        	  5606:     lea     ($03BC,A4),A0
02:0004C012 11802000        	  5607:     move.b  D0,(A0,D2.W)
                            	  5608:     ; If facing left and X < 2, then go change state to $40. The
                            	  5609:     ; boomerang is too close to the left edge of the screen.
                            	  5610:     ; Another move might make it wrap around.
                            	  5611:     ;
02:0004C016 41EC0098        	  5612:     lea     ($0098,A4),A0
02:0004C01A 10302000        	  5613:     move.b  (A0,D2.W),D0
02:0004C01E 1940000F        	  5614:     move.b  D0,($000F,A4)
02:0004C022 02000002        	  5615:     andi.b #$02,D0
02:0004C026 670A            	  5616:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C028 10342070        	  5617:     move.b  ($70,A4,D2.W),D0
02:0004C02C 0C000002        	  5618:     cmpi.b  #$02,D0
02:0004C030 650E            	  5619:     bcs  _L_z07_CheckState30_SetState40
                            	  5620:     even
                            	  5621: _L_z07_CheckState30_MoveBoomerang:
                            	  5622:     ; Move the boomerang.
                            	  5623:     ;
02:0004C032 6100F570        	  5624:     jsr     MoveObject
                            	  5625:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5626:     ; state to $40.
                            	  5627:     ;
02:0004C036 41EC0380        	  5628:     lea     ($0380,A4),A0
02:0004C03A 53302000        	  5629:     subq.b  #1,(A0,D2.W)
02:0004C03E 6614            	  5630:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5631:     even
                            	  5632: _L_z07_CheckState30_SetState40:
                            	  5633:     ; Set state $40, and a time to move of $20 frames.
                            	  5634:     ;
                            	  5635:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5636:     ;
                            	  5637:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5638:     ;
02:0004C040 7020            	  5639:     moveq   #32,D0
02:0004C042 41EC0380        	  5640:     lea     ($0380,A4),A0
02:0004C046 11802000        	  5641:     move.b  D0,(A0,D2.W)
02:0004C04A 7040            	  5642:     moveq   #64,D0
02:0004C04C 41EC00AC        	  5643:     lea     ($00AC,A4),A0
02:0004C050 11802000        	  5644:     move.b  D0,(A0,D2.W)
                            	  5645:     even
