                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:000415D2 102C0098        	  2866:     move.b  ($0098,A4),D0
02:000415D6 4EB900030C72    	  2867:     jsr     GetOppositeDir
02:000415DC 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:000415DE 4EB900030C72    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:000415E4 102C0070        	  2879:     move.b  ($0070,A4),D0
02:000415E8 0C030002        	  2880:     cmpi.b  #$02,D3
02:000415EC 6404            	  2881:     bcc  _anon_z05_74
02:000415EE 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:000415F2 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:000415F6 1003            	  2887:     move.b  D3,D0
02:000415F8 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:000415FA 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:000415FE 123C0008        	  2890:     move.b  #$08,D1
02:00041602 D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041604 7600            	  2892:     moveq   #0,D3
02:00041606 1600            	  2893:     move.b  D0,D3
02:00041608 103C0080        	  2894:     move.b  #$80,D0
02:0004160C 6134            	  2895:     jsr     MaskInputInBorder
02:0004160E 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:00041610 7600            	  2897:     moveq   #0,D3
02:00041612 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:00041614 102C0001        	  2902:     move.b  ($0001,A4),D0
02:00041618 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:0004161C 660C            	  2904:     bne  _anon_z05_75
02:0004161E 102C0098        	  2905:     move.b  ($0098,A4),D0
02:00041622 1880            	  2906:     move.b  D0,($0000,A4)
02:00041624 4EB900030C72    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:0004162A 102C0010        	  2914:     move.b  ($0010,A4),D0
02:0004162E 6710            	  2915:     beq  _anon_z05_76
02:00041630 1003            	  2916:     move.b  D3,D0
02:00041632 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041636 123C0004        	  2918:     move.b  #$04,D1
02:0004163A D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004163C 7600            	  2920:     moveq   #0,D3
02:0004163E 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:00041640 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
02:00041642 19400001        	  2938:     move.b  D0,($0001,A4)
                            	  2939:     ; If direction is positive (right or down), then go handle it separately.
                            	  2940:     ;
02:00041646 1014            	  2941:     move.b  ($0000,A4),D0
02:00041648 0200000A        	  2942:     andi.b #$0A,D0
02:0004164C 6748            	  2943:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2944:     ; The direction is negative (left or up).
                            	  2945:     ;
                            	  2946:     ; If the coordinate does not cross (<) the boundary, then
                            	  2947:     ; go set mask $FF, so that no button is excluded.
                            	  2948:     ;
02:0004164E 102C0002        	  2949:     move.b  ($0002,A4),D0
02:00041652 41F9000415C6    	  2950:     lea     (BorderBounds).l,A0
02:00041658 12303000        	  2951:     move.b  (A0,D3.W),D1
02:0004165C B001            	  2952:     cmp.b   D1,D0
02:0004165E 6548            	  2953:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2954:     even
