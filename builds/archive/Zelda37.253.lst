                            	  9494:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9495:     ;
02:0003DB4C 41EC0098        	  9496:     lea     ($0098,A4),A0
02:0003DB50 10302000        	  9497:     move.b  (A0,D2.W),D0
02:0003DB54 122C0002        	  9498:     move.b  ($0002,A4),D1
02:0003DB58 E309            	  9499:     lsl.b  #1,D1   ; ASL $02
02:0003DB5A 19410002        	  9500:     move.b  D1,($0002,A4)
02:0003DB5E 122C0002        	  9501:     move.b  ($0002,A4),D1
02:0003DB62 C200            	  9502:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DB64 671E            	  9503:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DB66 41EC0084        	  9504:     lea     ($0084,A4),A0
02:0003DB6A 10302000        	  9505:     move.b  (A0,D2.W),D0
02:0003DB6E 122C0003        	  9506:     move.b  ($0003,A4),D1
02:0003DB72 0A3C0010        	  9507:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DB76 9101            	  9508:     subx.b  D1,D0   ; SBC $03
02:0003DB78 0A3C0010        	  9509:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DB7C 41EC0084        	  9510:     lea     ($0084,A4),A0
02:0003DB80 11802000        	  9511:     move.b  D0,(A0,D2.W)
                            	  9512:     even
                            	  9513: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9514:     ; To the frame accumulator, add:
                            	  9515:     ; - a random value between 0 and 3
                            	  9516:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9517:     ;
02:0003DB84 10342019        	  9518:     move.b  ($19,A4,D2.W),D0
02:0003DB88 02000003        	  9519:     andi.b #$03,D0
02:0003DB8C 023C00EE        	  9520:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DB90 122C0003        	  9521:     move.b  ($0003,A4),D1
02:0003DB94 D101            	  9522:     addx.b  D1,D0   ; ADC $03
02:0003DB96 41EC0451        	  9523:     lea     ($0451,A4),A0
02:0003DB9A 12302000        	  9524:     move.b  (A0,D2.W),D1
02:0003DB9E D101            	  9525:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DBA0 41EC0451        	  9526:     lea     ($0451,A4),A0
02:0003DBA4 11802000        	  9527:     move.b  D0,(A0,D2.W)
