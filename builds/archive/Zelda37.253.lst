                            	  4005: UpdateBombFlashEffect:
                            	  4006:     ; If state <> $13, return.
                            	  4007:     ;
02:00030F76 41EC00AC        	  4008:     lea     ($00AC,A4),A0
02:00030F7A 10302000        	  4009:     move.b  (A0,D2.W),D0
02:00030F7E 0C000013        	  4010:     cmpi.b  #$13,D0
02:00030F82 662E            	  4011:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4012:     ; The effect involves turning grayscale rendering on and off
                            	  4013:     ; in PPUMASK.
                            	  4014:     ;
                            	  4015:     ; Start by setting A register to the PPU mask shifted right to
                            	  4016:     ; throw away the grayscale bit.
                            	  4017:     ;
02:00030F84 102C00FE        	  4018:     move.b  ($00FE,A4),D0
02:00030F88 E208            	  4019:     lsr.b  #1,D0   ; LSR A
                            	  4020:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4021:     ;
02:00030F8A 7600            	  4022:     moveq   #0,D3
02:00030F8C 16342028        	  4023:     move.b  ($28,A4,D2.W),D3
                            	  4024:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4025:     ; Carry will have been set, because of the comparison (CPY).
                            	  4026:     ;
02:00030F90 0C030016        	  4027:     cmpi.b  #$16,D3
02:00030F94 6706            	  4028:     beq  _anon_z01_54
02:00030F96 0C030011        	  4029:     cmpi.b  #$11,D3
02:00030F9A 6604            	  4030:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  4031: _anon_z01_54:
02:00030F9C E310            	  4032:     roxl.b  #1,D0   ; ROL A
02:00030F9E 600E            	  4033:     jmp     _L_z01_UpdateBombFlashEffect_SetMask
                            	  4034: 
                            	  4035:     even
                            	  4036: _L_z01_UpdateBombFlashEffect_Clear:
                            	  4037:     ; At times $12 and $D, shift left to make the low bit 0.
                            	  4038:     ;
02:00030FA0 0C030012        	  4039:     cmpi.b  #$12,D3
02:00030FA4 6706            	  4040:     beq  _anon_z01_55
02:00030FA6 0C03000D        	  4041:     cmpi.b  #$0D,D3
02:00030FAA 6606            	  4042:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4043: _anon_z01_55:
02:00030FAC E308            	  4044:     lsl.b  #1,D0   ; ASL A
                            	  4045:     even
                            	  4046: _L_z01_UpdateBombFlashEffect_SetMask:
                            	  4047:     ; Only at times $16, $11, $12, $D do we commit the mask
                            	  4048:     ; we calculated.
                            	  4049:     ;
02:00030FAE 194000FE        	  4050:     move.b  D0,($00FE,A4)
                            	  4051:     even
                            	  4052: _L_z01_UpdateBombFlashEffect_Exit:
02:00030FB2 4E75            	  4053:     rts
                            	  4054: 
                            	  4055:     even
