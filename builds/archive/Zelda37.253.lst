02:0003EE84 0A3C0010        	 12059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE88 9101            	 12060:     subx.b  D1,D0   ; SBC $00
02:0003EE8A 0A3C0010        	 12061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE8E 41EC0084        	 12062:     lea     ($0084,A4),A0
