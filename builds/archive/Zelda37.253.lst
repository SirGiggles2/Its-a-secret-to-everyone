                            	  7556: UpdatePolsVoice:
02:0003CCA8 0C020001        	  7557:     cmpi.b  #$01,D2
                            	  7558:     bne  _anon_z04_96
                            	  7559: _anon_z04_96:
                            	  7560:     ; If we have the magic clock, or is stunned, then
                            	  7561:     ; go draw and check collisions.
                            	  7562:     ;
02:0003CCAC 102C066C        	  7563:     move.b  ($066C,A4),D0
02:0003CCB0 1234203D        	  7564:     move.b  ($3D,A4,D2.W),D1
02:0003CCB4 8001            	  7565:     or.b  D1,D0
02:0003CCB6 660000AE        	  7566:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7567:     ; Every odd screen frame, go straight to drawing
                            	  7568:     ; and checking collisions.
                            	  7569:     ;
02:0003CCBA 102C0015        	  7570:     move.b  ($0015,A4),D0
02:0003CCBE E208            	  7571:     lsr.b  #1,D0   ; LSR A
02:0003CCC0 6404            	  7572:     bcc.s  __far_z_04_0068
02:0003CCC2 60000118        	  7573:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7574: __far_z_04_0068:
                            	  7575:     ; Otherwise move horizontally.
                            	  7576:     ;
02:0003CCC6 61000248        	  7577:     jsr     PolsVoice_MoveX
                            	  7578:     ; If state <> 0, then the monster is jumping.
                            	  7579:     ; Go handle vertical movement.
                            	  7580:     ;
02:0003CCCA 41EC00AC        	  7581:     lea     ($00AC,A4),A0
02:0003CCCE 10302000        	  7582:     move.b  (A0,D2.W),D0
02:0003CCD2 6706            	  7583:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CCD4 61000130        	  7584:     jsr     UpdatePolsVoiceState1_Jumping
02:0003CCD8 6034            	  7585:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  7586: 
                            	  7587:     even
                            	  7588: _L_z04_UpdatePolsVoice_State0:
                            	  7589:     ; State 0. Walking.
                            	  7590:     ;
                            	  7591:     ; If grid offset = 0, then no more distance to cover.
                            	  7592:     ; So, go change to state 1 -- jumping.
                            	  7593:     ;
02:0003CCDA 41EC0394        	  7594:     lea     ($0394,A4),A0
02:0003CCDE 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003CCE2 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003CCE6 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003CCEA 53302000        	  7600:     subq.b  #1,(A0,D2.W)
                            	  7601:     ; Move vertically.
                            	  7602:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7603:     ;
02:0003CCEE 41EC0084        	  7604:     lea     ($0084,A4),A0
02:0003CCF2 10302000        	  7605:     move.b  (A0,D2.W),D0
02:0003CCF6 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCFA 41F90003CC8A    	  7607:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CD00 12303000        	  7608:     move.b  (A0,D3.W),D1
02:0003CD04 D101            	  7609:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CD06 41EC0084        	  7610:     lea     ($0084,A4),A0
02:0003CD0A 11802000        	  7611:     move.b  D0,(A0,D2.W)
                            	  7612:     even
                            	  7613: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7614:     ; If the square the monster is over is walkable, then
                            	  7615:     ; go draw and check object collisions.
                            	  7616:     ;
02:0003CD0E 610001F4        	  7617:     jsr     PolsVoice_IsSquareWalkable
02:0003CD12 6452            	  7618:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7619:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7620:     ; then go change to state 1.
                            	  7621:     ;
02:0003CD14 41EC041F        	  7622:     lea     ($041F,A4),A0
02:0003CD18 10302000        	  7623:     move.b  (A0,D2.W),D0
02:0003CD1C 020000FC        	  7624:     andi.b #$FC,D0
02:0003CD20 0C0000B0        	  7625:     cmpi.b  #$B0,D0
02:0003CD24 6742            	  7626:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CD26 0C0000F4        	  7627:     cmpi.b  #$F4,D0
02:0003CD2A 643C            	  7628:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7629:     ; Else blocked by something else.
                            	  7630:     ;
                            	  7631:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7632:     ;
02:0003CD2C 41EC0098        	  7633:     lea     ($0098,A4),A0
02:0003CD30 10302000        	  7634:     move.b  (A0,D2.W),D0
02:0003CD34 02000003        	  7635:     andi.b #$03,D0
02:0003CD38 6618            	  7636:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7637:     ; Else facing vertically. Flip the direction.
                            	  7638:     ; Go draw.
                            	  7639:     ;
02:0003CD3A 41EC0098        	  7640:     lea     ($0098,A4),A0
02:0003CD3E 10302000        	  7641:     move.b  (A0,D2.W),D0
02:0003CD42 0A00000C        	  7642:     eori.b #$0C,D0
02:0003CD46 41EC0098        	  7643:     lea     ($0098,A4),A0
02:0003CD4A 11802000        	  7644:     move.b  D0,(A0,D2.W)
02:0003CD4E 6000008C        	  7645:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7646: 
                            	  7647:     even
                            	  7648: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  7649:     ; Facing horizontally. Flip the direction.
                            	  7650:     ; Move two pixels, and go draw.
                            	  7651:     ;
02:0003CD52 0A000003        	  7652:     eori.b #$03,D0
02:0003CD56 41EC0098        	  7653:     lea     ($0098,A4),A0
02:0003CD5A 11802000        	  7654:     move.b  D0,(A0,D2.W)
02:0003CD5E 610001B0        	  7655:     jsr     PolsVoice_MoveX
02:0003CD62 610001AC        	  7656:     jsr     PolsVoice_MoveX
                            	  7657:     even
                            	  7658: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003CD66 6074            	  7659:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7660: 
                            	  7661:     even
                            	  7662: _L_z04_UpdatePolsVoice_SetState1:
                            	  7663:     ; If already in state 1, then go draw and check collisions.
                            	  7664:     ;
02:0003CD68 41EC00AC        	  7665:     lea     ($00AC,A4),A0
02:0003CD6C 10302000        	  7666:     move.b  (A0,D2.W),D0
02:0003CD70 6702            	  7667:     beq.s  __far_z_04_0069
02:0003CD72 6068            	  7668:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7669: __far_z_04_0069:
                            	  7670:     ; Go to state 1.
                            	  7671:     ;
02:0003CD74 41EC00AC        	  7672:     lea     ($00AC,A4),A0
02:0003CD78 52302000        	  7673:     addq.b  #1,(A0,D2.W)
                            	  7674:     ; Subtract 1 from facing direction to make an index.
                            	  7675:     ;
02:0003CD7C 7600            	  7676:     moveq   #0,D3
02:0003CD7E 41EC0098        	  7677:     lea     ($0098,A4),A0
02:0003CD82 16302000        	  7678:     move.b  (A0,D2.W),D3
02:0003CD86 5303            	  7679:     subq.b  #1,D3
                            	  7680:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7681:     ;
02:0003CD88 41EC0084        	  7682:     lea     ($0084,A4),A0
02:0003CD8C 10302000        	  7683:     move.b  (A0,D2.W),D0
02:0003CD90 0C000078        	  7684:     cmpi.b  #$78,D0
02:0003CD94 6402            	  7685:     bcc  _anon_z04_97
02:0003CD96 7603            	  7686:     moveq   #3,D3
                            	  7687: _anon_z04_97:
                            	  7688:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7689:     ;
02:0003CD98 0C0000A8        	  7690:     cmpi.b  #$A8,D0
02:0003CD9C 6502            	  7691:     bcs  _anon_z04_98
02:0003CD9E 7607            	  7692:     moveq   #7,D3
                            	  7693: _anon_z04_98:
                            	  7694:     ; Set the vertical speed for the beginning of the jump.
                            	  7695:     ;
02:0003CDA0 41F90003CC94    	  7696:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CDA6 10303000        	  7697:     move.b  (A0,D3.W),D0
02:0003CDAA 41EC0412        	  7698:     lea     ($0412,A4),A0
02:0003CDAE 11802000        	  7699:     move.b  D0,(A0,D2.W)
                            	  7700:     ; Look up the Y offset for the current direction.
                            	  7701:     ; Add it to object Y to set the destination Y of the jump.
                            	  7702:     ;
02:0003CDB2 41EC0084        	  7703:     lea     ($0084,A4),A0
02:0003CDB6 10302000        	  7704:     move.b  (A0,D2.W),D0
02:0003CDBA 023C00EE        	  7705:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDBE 41F90003CC9C    	  7706:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CDC4 12303000        	  7707:     move.b  (A0,D3.W),D1
02:0003CDC8 D101            	  7708:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CDCA 41EC042C        	  7709:     lea     ($042C,A4),A0
02:0003CDCE 11802000        	  7710:     move.b  D0,(A0,D2.W)
                            	  7711:     ; Turn the index into a direction again by adding 1.
                            	  7712:     ; Store the facing direction.
                            	  7713:     ;
02:0003CDD2 5203            	  7714:     addq.b  #1,D3
02:0003CDD4 41EC0098        	  7715:     lea     ($0098,A4),A0
02:0003CDD8 11832000        	  7716:     move.b  D3,(A0,D2.W)
                            	  7717:     even
                            	  7718: L_PolsVoice_DrawAndCheckCollisions:
02:0003CDDC 7008            	  7719:     moveq   #8,D0
02:0003CDDE 4EB90004C916    	  7720:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003CDE4 41EC03E4        	  7721:     lea     ($03E4,A4),A0
02:0003CDE8 10302000        	  7722:     move.b  (A0,D2.W),D0
02:0003CDEC 4EB9000317C6    	  7723:     jsr     DrawObjectMirrored
                            	  7724:     ; Pols Voice is invincible to everything but the sword,
                            	  7725:     ; during normal collision detection.
                            	  7726:     ;
                            	  7727:     ; The arrow is a special case.
                            	  7728:     ;
02:0003CDF2 103C00FE        	  7729:     move.b  #$FE,D0
02:0003CDF6 41EC04B2        	  7730:     lea     ($04B2,A4),A0
02:0003CDFA 11802000        	  7731:     move.b  D0,(A0,D2.W)
02:0003CDFE 4EB900031B46    	  7732:     jsr     CheckMonsterCollisions
02:0003CE04 4E75            	  7733:     rts
                            	  7734: 
                            	  7735:     even
                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003CE06 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003CE0A 10302000        	  7740:     move.b  (A0,D2.W),D0
02:0003CE0E 023C00EE        	  7741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE12 123C0038        	  7742:     move.b  #$38,D1
02:0003CE16 D101            	  7743:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CE18 41EC0444        	  7744:     lea     ($0444,A4),A0
02:0003CE1C 11802000        	  7745:     move.b  D0,(A0,D2.W)
                            	  7746:     ; Add Carry to high speed byte (vertical).
                            	  7747:     ;
02:0003CE20 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003CE24 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003CE28 123C0000        	  7750:     move.b  #$00,D1
02:0003CE2C D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CE2E 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003CE32 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003CE36 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE3A 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003CE3E 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003CE42 D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CE44 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003CE48 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003CE4C 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003CE50 10302000        	  7765:     move.b  (A0,D2.W),D0
02:0003CE54 6B0000AC        	  7766:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7767:     ; If Y coordinate still < target Y, then return.
                            	  7768:     ;
02:0003CE58 41EC0084        	  7769:     lea     ($0084,A4),A0
02:0003CE5C 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003CE60 41EC042C        	  7771:     lea     ($042C,A4),A0
