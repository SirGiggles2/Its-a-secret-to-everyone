02:0003CEEC 123C0003        	  7829:     move.b  #$03,D1
02:0003CEF0 0A3C0010        	  7830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CEF4 9101            	  7831:     subx.b  D1,D0   ; SBC #$03
02:0003CEF6 0A3C0010        	  7832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CEFA 41EC0084        	  7833:     lea     ($0084,A4),A0
02:0003CEFE 11802000        	  7834:     move.b  D0,(A0,D2.W)
                            	  7835:     even
