                            	  5755: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  5756:     ; Link and the shot are facing opposite directions.
                            	  5757:     ; Link can parry certain weapons/shots.
                            	  5758:     ;
                            	  5759:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  5760:     ; no harmful collision; but it still counts as a shot collision.
                            	  5761:     ; So, go treat this as a parry.
                            	  5762:     ;
02:00031D94 41EC034F        	  5763:     lea     ($034F,A4),A0
02:00031D98 10302000        	  5764:     move.b  (A0,D2.W),D0
02:00031D9C 0C000055        	  5765:     cmpi.b  #$55,D0
02:00031DA0 650E            	  5766:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031DA2 0C00005B        	  5767:     cmpi.b  #$5B,D0
02:00031DA6 6408            	  5768:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  5769:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  5770:     ; So, go harm Link.
                            	  5771:     ;
02:00031DA8 102C0676        	  5772:     move.b  ($0676,A4),D0
02:00031DAC 6602            	  5773:     bne.s  __far_z_01_0060
02:00031DAE 600E            	  5774:     jmp  HarmLink
                            	  5775: __far_z_01_0060:
                            	  5776:     even
                            	  5777: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  5778:     ; Else Link parries.
                            	  5779:     ;
                            	  5780:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  5781:     ;
02:00031DB0 7001            	  5782:     moveq   #1,D0
02:00031DB2 19400604        	  5783:     move.b  D0,($0604,A4)
02:00031DB6 7000            	  5784:     moveq   #0,D0
02:00031DB8 19400006        	  5785:     move.b  D0,($0006,A4)
