02:0003C70E 7600            	  6739:     moveq   #0,D3
02:0003C710 162C0341        	  6740:     move.b  ($0341,A4),D3
02:0003C714 41F900031792    	  6741:     lea     (SpriteOffsets).l,A0
02:0003C71A 10303000        	  6742:     move.b  (A0,D3.W),D0
02:0003C71E 7600            	  6743:     moveq   #0,D3
02:0003C720 1600            	  6744:     move.b  D0,D3
02:0003C722 101D            	  6745:     move.b  (A5)+,D0  ; PLA
02:0003C724 41EC0201        	  6746:     lea     ($0201,A4),A0
02:0003C728 11803000        	  6747:     move.b  D0,(A0,D3.W)
02:0003C72C 1014            	  6748:     move.b  ($0000,A4),D0
02:0003C72E 41EC0203        	  6749:     lea     ($0203,A4),A0
02:0003C732 11803000        	  6750:     move.b  D0,(A0,D3.W)
02:0003C736 102C0001        	  6751:     move.b  ($0001,A4),D0
02:0003C73A 4EF900031B10    	  6752:     jmp     Anim_EndWriteSprite
