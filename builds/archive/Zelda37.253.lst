                            	  4229: 
                            	  4230: ; Each byte describes an item. The high nibble is the type.
                            	  4231: ; The low nibble is the value. Its meaning depends on the type.
                            	  4232: ;
                            	  4233: ; 0x - individuals
                            	  4234: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4235: ; * bit mask: value doesn't matter.
                            	  4236: ;
                            	  4237: ; 1x - amounts
                            	  4238: ; Value is an amount to add.
                            	  4239: ;
                            	  4240: ; 2x - grades
                            	  4241: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4242: ;
                            	  4243: ; 3x - error?
                            	  4244: ; Produces an item value of $FF.
                            	  4245: ;
                            	  4246:     even
