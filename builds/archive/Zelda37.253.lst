                            	  8134: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8135:     ; If the teleporting distance remaining is even, then draw
                            	  8136:     ; and check collisions, else return.
                            	  8137:     ;
                            	  8138:     ; This means that when 0, the monster is walking.
                            	  8139:     ; So, draw and check collisions every frame.
                            	  8140:     ;
                            	  8141:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8142:     ; translucently -- every other frame.
                            	  8143:     ;
02:0003D160 41EC0394        	  8144:     lea     ($0394,A4),A0
02:0003D164 10302000        	  8145:     move.b  (A0,D2.W),D0
02:0003D168 E208            	  8146:     lsr.b  #1,D0   ; LSR A
02:0003D16A 6402            	  8147:     bcc.s  __far_z_04_0071
02:0003D16C 603A            	  8148:     jmp  L11E17_Exit
