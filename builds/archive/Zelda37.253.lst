02:0003DC04 662C            	  9578:     bne  _L_z04_UpdateGohma_Move
                            	  9579:     ; If Random:
                            	  9580:     ;   >= $B0: right
                            	  9581:     ;   >= $60: left
                            	  9582:     ;   Else:   down
                            	  9583:     ;
02:0003DC06 7001            	  9584:     moveq   #1,D0
02:0003DC08 7600            	  9585:     moveq   #0,D3
02:0003DC0A 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003DC0E 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003DC12 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DC14 E308            	  9589:     lsl.b  #1,D0   ; ASL A
02:0003DC16 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003DC1A 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DC1C E308            	  9592:     lsl.b  #1,D0   ; ASL A
