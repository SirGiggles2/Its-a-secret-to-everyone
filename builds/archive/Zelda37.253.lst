02:0003CC2C 7008            	  7492:     moveq   #8,D0
02:0003CC2E 4EB90004C916    	  7493:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7494:     ; If facing left, then enable horizontal flipping.
                            	  7495:     ;
02:0003CC34 41EC0098        	  7496:     lea     ($0098,A4),A0
02:0003CC38 10302000        	  7497:     move.b  (A0,D2.W),D0
02:0003CC3C 0C000002        	  7498:     cmpi.b  #$02,D0
02:0003CC40 6604            	  7499:     bne  _anon_z04_94
02:0003CC42 522C000F        	  7500:     addq.b  #1,($000F,A4)
                            	  7501: _anon_z04_94:
                            	  7502:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7503:     ; This is the base frame image.
                            	  7504:     ;
02:0003CC46 E208            	  7505:     lsr.b  #1,D0   ; LSR A
02:0003CC48 E208            	  7506:     lsr.b  #1,D0   ; LSR A
                            	  7507:     ; If movement frame = 1, add 3 to frame image to access
                            	  7508:     ; the second animation frame's images.
                            	  7509:     ;
02:0003CC4A 7600            	  7510:     moveq   #0,D3
02:0003CC4C 41EC03E4        	  7511:     lea     ($03E4,A4),A0
02:0003CC50 16302000        	  7512:     move.b  (A0,D2.W),D3
02:0003CC54 671E            	  7513:     beq  _anon_z04_95
02:0003CC56 023C00EE        	  7514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC5A 123C0003        	  7515:     move.b  #$03,D1
02:0003CC5E D101            	  7516:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7517:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7518:     ;
                            	  7519:     ; Down has two frame images, but up only has one. By flipping
                            	  7520:     ; horizontally, you get two frame images.
                            	  7521:     ;
02:0003CC60 7600            	  7522:     moveq   #0,D3
02:0003CC62 41EC0098        	  7523:     lea     ($0098,A4),A0
02:0003CC66 16302000        	  7524:     move.b  (A0,D2.W),D3
02:0003CC6A 0C030008        	  7525:     cmpi.b  #$08,D3
02:0003CC6E 6604            	  7526:     bne  _anon_z04_95
02:0003CC70 522C000F        	  7527:     addq.b  #1,($000F,A4)
