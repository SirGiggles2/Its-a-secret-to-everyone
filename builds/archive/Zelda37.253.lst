02:0003F33A 1B00            	 12722:     move.b  D0,-(A5)  ; PHA
02:0003F33C 19400007        	 12723:     move.b  D0,($0007,A4)
                            	 12724:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12725:     ; that make it up.
                            	 12726:     ;
02:0003F340 41EC046B        	 12727:     lea     ($046B,A4),A0
02:0003F344 10302000        	 12728:     move.b  (A0,D2.W),D0
02:0003F348 E308            	 12729:     lsl.b  #1,D0   ; ASL A
02:0003F34A E308            	 12730:     lsl.b  #1,D0   ; ASL A
                            	 12731:     ; Add [07] -- the index of the current part.
                            	 12732:     ;
                            	 12733:     ; Now you have an index into the frame image table, for the
                            	 12734:     ; current image part of the current animation frame.
                            	 12735:     ;
02:0003F34C 122C0007        	 12736:     move.b  ($0007,A4),D1
02:0003F350 D101            	 12737:     addx.b  D1,D0   ; ADC $07
02:0003F352 7600            	 12738:     moveq   #0,D3
02:0003F354 1600            	 12739:     move.b  D0,D3
02:0003F356 41F90003F2D2    	 12740:     lea     (GanonFrameImages).l,A0
02:0003F35C 10303000        	 12741:     move.b  (A0,D3.W),D0
02:0003F360 4EB9000317CA    	 12742:     jsr     DrawObjectNotMirrored
02:0003F366 101D            	 12743:     move.b  (A5)+,D0  ; PLA
                            	 12744:     ; Bottom of the part loop.
                            	 12745:     ;
02:0003F368 7600            	 12746:     moveq   #0,D3
02:0003F36A 1600            	 12747:     move.b  D0,D3
02:0003F36C 5303            	 12748:     subq.b  #1,D3
02:0003F36E 6A88            	 12749:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F370 4E75            	 12750:     rts
