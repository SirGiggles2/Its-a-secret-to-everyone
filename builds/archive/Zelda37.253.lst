                            	   702: UpdateBlock:
02:00039BD0 41EC00AC        	   703:     lea     ($00AC,A4),A0
02:00039BD4 10302000        	   704:     move.b  (A0,D2.W),D0
02:00039BD8 02000003        	   705:     andi.b #$03,D0
02:00039BDC 4EB90002AECA    	   706:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	   707:     even
                            	   708: UpdateBlock_JumpTable:
02:00039BE2 00039BEE        	   709:     dc.l    UpdateBlock0Idle   ; jump table entry (32-bit for _m68k_tablejump)
02:00039BE6 00039CD8        	   710:     dc.l    UpdateBlock1Moving   ; jump table entry (32-bit for _m68k_tablejump)
02:00039BEA 00039D22        	   711:     dc.l    UpdateBlock2Done   ; jump table entry (32-bit for _m68k_tablejump)
                            	   712: 
                            	   713:     even
                            	   714: UpdateBlock0Idle:
                            	   715:     ; If there are monsters in the room, go reset the push timer and return.
                            	   716:     ;
02:00039BEE 102C034D        	   717:     move.b  ($034D,A4),D0
02:00039BF2 6604            	   718:     bne.s  __far_z_04_0005
02:00039BF4 600000DA        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00039BF8 102C0070        	   725:     move.b  ($0070,A4),D0
02:00039BFC 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:00039C00 B001            	   727:     cmp.b   D1,D0
02:00039C02 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039C04 7600            	   729:     moveq   #0,D3
02:00039C06 102C0084        	   730:     move.b  ($0084,A4),D0
02:00039C0A 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039C0E 123C0003        	   732:     move.b  #$03,D1
02:00039C12 D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039C14 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00039C18 41EC0084        	   735:     lea     ($0084,A4),A0
02:00039C1C 12302000        	   736:     move.b  (A0,D2.W),D1
02:00039C20 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039C24 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00039C26 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:00039C2A 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:00039C2C 102C0084        	   747:     move.b  ($0084,A4),D0
02:00039C30 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039C34 123C0003        	   749:     move.b  #$03,D1
02:00039C38 D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039C3A 41EC0084        	   751:     lea     ($0084,A4),A0
02:00039C3E 12302000        	   752:     move.b  (A0,D2.W),D1
02:00039C42 B001            	   753:     cmp.b   D1,D0
02:00039C44 6704            	   754:     beq.s  __far_z_04_0006
02:00039C46 60000088        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:00039C4A 7602            	   760:     moveq   #2,D3
02:00039C4C 102C0070        	   761:     move.b  ($0070,A4),D0
02:00039C50 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00039C54 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00039C58 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039C5C 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:00039C5E 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00039C62 6A08            	   776:     bpl  _anon_z04_14
02:00039C64 5203            	   777:     addq.b  #1,D3
02:00039C66 4EB900030C7A    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:00039C6C 0C000011        	   782:     cmpi.b  #$11,D0
02:00039C70 6502            	   783:     bcs.s  __far_z_04_0007
02:00039C72 605C            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00039C74 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00039C78 41F900039BCC    	   792:     lea     (BlockPushDirections).l,A0
02:00039C7E 12303000        	   793:     move.b  (A0,D3.W),D1
