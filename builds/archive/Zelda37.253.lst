02:0003E9AE 1940007C        	 11371:     move.b  D0,($007C,A4)
02:0003E9B2 7001            	 11372:     moveq   #1,D0
02:0003E9B4 1940007D        	 11373:     move.b  D0,($007D,A4)
02:0003E9B8 7024            	 11374:     moveq   #36,D0
02:0003E9BA 1940000A        	 11375:     move.b  D0,($000A,A4)
02:0003E9BE 4EF90004AA82    	 11376:     jmp     FillTileMap
