02:00031C9E 19400009        	  5637:     move.b  D0,($0009,A4)
02:00031CA2 1940000C        	  5638:     move.b  D0,($000C,A4)
02:00031CA6 7600            	  5639:     moveq   #0,D3
02:00031CA8 1883            	  5640:     move.b  D3,($0000,A4)
