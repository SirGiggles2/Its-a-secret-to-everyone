                            	  2138: __far_z_04_0017:
02:0003A610 61000592        	  2139:     jsr     UpdateBurrower
                            	  2140:     ; If zora died in the call above, then it happened while in
                            	  2141:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2142:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2143:     ; not come back after killing it.
                            	  2144:     ;
                            	  2145:     ; If state <> 3 or timer <> $FD,
                            	  2146:     ; then go see if the object needs to be destroyed.
                            	  2147:     ;
02:0003A614 41EC00AC        	  2148:     lea     ($00AC,A4),A0
02:0003A618 10302000        	  2149:     move.b  (A0,D2.W),D0
02:0003A61C 0C000003        	  2150:     cmpi.b  #$03,D0
02:0003A620 6616            	  2151:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003A622 10342028        	  2152:     move.b  ($28,A4,D2.W),D0
02:0003A626 0C0000FD        	  2153:     cmpi.b  #$FD,D0
02:0003A62A 660C            	  2154:     bne  _L_z04_UpdateZora_DestroyWhenDone
                            	  2155:     ; Shoot a fireball; and set the timer so that it expires faster.
                            	  2156:     ;
02:0003A62C 7055            	  2157:     moveq   #85,D0
02:0003A62E 6100F72A        	  2158:     jsr     ShootFireball
02:0003A632 7020            	  2159:     moveq   #32,D0
02:0003A634 19802028        	  2160:     move.b  D0,($28,A4,D2.W)
                            	  2161:     even
                            	  2162: _L_z04_UpdateZora_DestroyWhenDone:
                            	  2163:     ; If state = 0, then destroy zora object.
                            	  2164:     ; Also flag it inactive, so that the object update loop will try
                            	  2165:     ; to make another one.
                            	  2166:     ;
02:0003A638 41EC00AC        	  2167:     lea     ($00AC,A4),A0
02:0003A63C 10302000        	  2168:     move.b  (A0,D2.W),D0
02:0003A640 6702            	  2169:     beq.s  __far_z_04_0018
02:0003A642 60C2            	  2170:     jmp  L10797_Exit
