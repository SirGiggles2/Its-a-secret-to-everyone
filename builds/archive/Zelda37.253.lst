02:0003156A 4E75            	  4833:     rts
                            	  4834: 
                            	  4835: ; Params:
                            	  4836: ; [02]: Y
                            	  4837: ; [03]: X
                            	  4838: ;
                            	  4839: ; Returns:
                            	  4840: ; [00]: high byte of PPU address
                            	  4841: ; [01]: low byte of PPU address
                            	  4842: ;
                            	  4843: ;
                            	  4844: ; Turn the 16-bit value 08YY into the PPU address
                            	  4845: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  4846: ;
                            	  4847: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  4848: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  4849: ;
                            	  4850:     even
                            	  4851: MapScreenPosToPpuAddr:
02:0003156C 6000A4F8        	  4852:     jmp     c_map_screen_pos_to_ppu_addr
