02:0003C3D2 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003C3D6 E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003C3D8 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003C3DC 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003C3E0 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
