                            	 12240: _anon_z04_160:
02:0003EFD8 0A3C0001        	 12241:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003EFDC 4E75            	 12242:     rts
                            	 12243: 
                            	 12244: ; Description:
                            	 12245: ; Lift up the Triforce of Courage while the room is light.
                            	 12246: ;
                            	 12247: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12248: ;
                            	 12249:     even
                            	 12250: Ganon_ScenePhase1:
02:0003EFDE 701B            	 12251:     moveq   #27,D0
02:0003EFE0 19400505        	 12252:     move.b  D0,($0505,A4)
                            	 12253:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12254:     ;
