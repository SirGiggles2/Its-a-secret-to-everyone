                            	 12258: __far_z_04_0117:
                            	 12259:     ; Once the timer expires:
                            	 12260:     ; 1. unhalt Link
                            	 12261:     ; 2. clear the item to lift
                            	 12262:     ; 3. play level 9 song
                            	 12263:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12264:     ;
02:0003EFEC 194000AC        	 12265:     move.b  D0,($00AC,A4)
02:0003EFF0 19400505        	 12266:     move.b  D0,($0505,A4)
02:0003EFF4 7020            	 12267:     moveq   #32,D0
02:0003EFF6 19400600        	 12268:     move.b  D0,($0600,A4)
02:0003EFFA 522C0445        	 12269:     addq.b  #1,($0445,A4)
                            	 12270:     even
                            	 12271: Ganon_DrawBodyFrame0:
