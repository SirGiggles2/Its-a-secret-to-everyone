02:0002E77C 7600            	   442:     moveq   #0,D3
02:0002E77E 41EC046C        	   443:     lea     ($046C,A4),A0
02:0002E782 16302000        	   444:     move.b  (A0,D2.W),D3
02:0002E786 41EC046F        	   445:     lea     ($046F,A4),A0
02:0002E78A 10303000        	   446:     move.b  (A0,D3.W),D0
02:0002E78E 41EC0448        	   447:     lea     ($0448,A4),A0
02:0002E792 11802000        	   448:     move.b  D0,(A0,D2.W)
02:0002E796 5302            	   449:     subq.b  #1,D2
02:0002E798 6AE2            	   450:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
