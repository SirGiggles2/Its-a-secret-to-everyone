                            	  1590:     even
                            	  1591: InitWhirlwind:
02:0002FF9E 6000BCAA        	  1592:     jmp     c_init_whirlwind
                            	  1593: 
                            	  1594: SetUpWhirlwind:
02:0002FFA2 6000BA56        	  1595:     jmp     c_set_up_whirlwind
                            	  1596: 
                            	  1597: WhirlwindPrevRoomIdList:
02:0002FFA6 36              	  1598:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FFA7 3B
02:0002FFA8 73
02:0002FFA9 44
02:0002FFAA 0A
02:0002FFAB 21
02:0002FFAC 41
02:0002FFAD 6C
                            	  1599: 
                            	  1600:     even
                            	  1601: UpdateWhirlwind_Full:
                            	  1602:     ; Get Link's halted state.
                            	  1603:     ;
02:0002FFAE 102C00AC        	  1604:     move.b  ($00AC,A4),D0
02:0002FFB2 02000040        	  1605:     andi.b #$40,D0
02:0002FFB6 7600            	  1606:     moveq   #0,D3
02:0002FFB8 1600            	  1607:     move.b  D0,D3
                            	  1608:     ; Add 2 to whirlwind X.
                            	  1609:     ;
02:0002FFBA 7002            	  1610:     moveq   #2,D0
02:0002FFBC 023C00EE        	  1611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FFC0 12342070        	  1612:     move.b  ($70,A4,D2.W),D1
02:0002FFC4 D101            	  1613:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FFC6 19802070        	  1614:     move.b  D0,($70,A4,D2.W)
                            	  1615:     ; If Link is not halted or teleporting state = 0, then
                            	  1616:     ; go check for collision with Link.
                            	  1617:     ;
02:0002FFCA 0C030040        	  1618:     cmpi.b  #$40,D3
02:0002FFCE 6638            	  1619:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FFD0 7600            	  1620:     moveq   #0,D3
02:0002FFD2 162C0522        	  1621:     move.b  ($0522,A4),D3
02:0002FFD6 6730            	  1622:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1623:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1624:     ;
                            	  1625:     ; Set Link's X to whirlwind's.
                            	  1626:     ;
02:0002FFD8 19400070        	  1627:     move.b  D0,($0070,A4)
                            	  1628:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1629:     ; the right screen edge and draw.
                            	  1630:     ;
02:0002FFDC 5303            	  1631:     subq.b  #1,D3
02:0002FFDE 6776            	  1632:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FFE0 0C000080        	  1633:     cmpi.b  #$80,D0
02:0002FFE4 6670            	  1634:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1635:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1636:     ;
                            	  1637:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1638:     ;
02:0002FFE6 E308            	  1639:     lsl.b  #1,D0   ; ASL A
02:0002FFE8 194000AC        	  1640:     move.b  D0,($00AC,A4)
02:0002FFEC 19400522        	  1641:     move.b  D0,($0522,A4)
02:0002FFF0 41EC034F        	  1642:     lea     ($034F,A4),A0
02:0002FFF4 11802000        	  1643:     move.b  D0,(A0,D2.W)
                            	  1644:     ; Update the player position marker, and draw one last time.
                            	  1645:     ;
02:0002FFF8 1002            	  1646:     move.b  D2,D0
02:0002FFFA 1B00            	  1647:     move.b  D0,-(A5)  ; PHA
02:0002FFFC 61000FB6        	  1648:     jsr     UpdatePlayerPositionMarker
02:00030000 101D            	  1649:     move.b  (A5)+,D0  ; PLA
02:00030002 7400            	  1650:     moveq   #0,D2
02:00030004 1400            	  1651:     move.b  D0,D2
02:00030006 6070            	  1652:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1653: 
                            	  1654:     even
                            	  1655: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1656:     ; Link is not halted or teleporting state = 0.
                            	  1657:     ; Try to pick up Link.
                            	  1658:     ;
                            	  1659:     ; If the whirlwind does not collide with Link, then go check
                            	  1660:     ; for the screen's right edge.
                            	  1661:     ;
02:00030008 61001C86        	  1662:     jsr     CheckLinkCollision
02:0003000C 102C0006        	  1663:     move.b  ($0006,A4),D0
02:00030010 6744            	  1664:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1665:     ; Collided with Link.
                            	  1666:     ;
                            	  1667:     ; Make Link face right. Reset shove info and subroom type.
                            	  1668:     ;
02:00030012 7001            	  1669:     moveq   #1,D0
02:00030014 19400098        	  1670:     move.b  D0,($0098,A4)
02:00030018 E208            	  1671:     lsr.b  #1,D0   ; LSR A
02:0003001A 194000C0        	  1672:     move.b  D0,($00C0,A4)
02:0003001E 194000D3        	  1673:     move.b  D0,($00D3,A4)
02:00030022 1940005A        	  1674:     move.b  D0,($005A,A4)
                            	  1675:     ; Halt Link (state $40), and hide him.
                            	  1676:     ;
02:00030026 7040            	  1677:     moveq   #64,D0
02:00030028 194000AC        	  1678:     move.b  D0,($00AC,A4)
02:0003002C 103C00F8        	  1679:     move.b  #$F8,D0
02:00030030 19400248        	  1680:     move.b  D0,($0248,A4)
02:00030034 1940024C        	  1681:     move.b  D0,($024C,A4)
                            	  1682:     ; Find and set the room that will behave as the previous room
                            	  1683:     ; when scrolling right to the room with the level's entrance.
                            	  1684:     ;
02:00030038 102C0523        	  1685:     move.b  ($0523,A4),D0
02:0003003C 02000007        	  1686:     andi.b #$07,D0
02:00030040 7600            	  1687:     moveq   #0,D3
02:00030042 1600            	  1688:     move.b  D0,D3
02:00030044 41F90002FFA6    	  1689:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0003004A 10303000        	  1690:     move.b  (A0,D3.W),D0
02:0003004E 194000EA        	  1691:     move.b  D0,($00EA,A4)
                            	  1692:     ; Set teleporting state 1.
                            	  1693:     ;
02:00030052 522C0522        	  1694:     addq.b  #1,($0522,A4)
                            	  1695:     even
                            	  1696: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1697:     ; If whirlwind's X < $F0, go draw.
                            	  1698:     ;
02:00030056 10342070        	  1699:     move.b  ($70,A4,D2.W),D0
02:0003005A 0C0000F0        	  1700:     cmpi.b  #$F0,D0
02:0003005E 6518            	  1701:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1702:     ; The whirlwind has reached the right edge of the screen.
                            	  1703:     ;
                            	  1704:     ; Destroy the object.
                            	  1705:     ;
02:00030060 611A            	  1706:     jsr     DestroyWhirlwind
                            	  1707:     ; If teleporting state <> 0, we picked up Link.
                            	  1708:     ; So, go to the next mode.
                            	  1709:     ;
                            	  1710:     ; Either way, draw one last time.
                            	  1711:     ;
02:00030062 102C0522        	  1712:     move.b  ($0522,A4),D0
02:00030066 6710            	  1713:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030068 1002            	  1714:     move.b  D2,D0
02:0003006A 1B00            	  1715:     move.b  D0,-(A5)  ; PHA
02:0003006C 4EB90004B796    	  1716:     jsr     GoToNextModeFromPlay
02:00030072 101D            	  1717:     move.b  (A5)+,D0  ; PLA
02:00030074 7400            	  1718:     moveq   #0,D2
02:00030076 1400            	  1719:     move.b  D0,D2
                            	  1720:     even
                            	  1721: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030078 60000094        	  1722:     jmp     DrawWhirlwind
                            	  1723: 
                            	  1724:     even
                            	  1725: DestroyWhirlwind:
02:0003007C 6000B796        	  1726:     jmp     c_destroy_whirlwind
                            	  1727: 
                            	  1728: SummonWhirlwind:
                            	  1729:     ; If not in mode 5, return.
                            	  1730:     ;
02:00030080 102C0012        	  1731:     move.b  ($0012,A4),D0
02:00030084 0C000005        	  1732:     cmpi.b  #$05,D0
02:00030088 6704            	  1733:     beq.s  __far_z_01_0007
02:0003008A 60000080        	  1734:     jmp  L6104_Exit
                            	  1735: __far_z_01_0007:
                            	  1736:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  1737:     ;
02:0003008E 6178            	  1738:     jsr     AdvanceTeleportingLevelIndex
02:00030090 102C0523        	  1739:     move.b  ($0523,A4),D0
02:00030094 02000007        	  1740:     andi.b #$07,D0
02:00030098 7600            	  1741:     moveq   #0,D3
02:0003009A 1600            	  1742:     move.b  D0,D3
02:0003009C 41F90004A6AE    	  1743:     lea     (LevelMasks).l,A0
02:000300A2 10303000        	  1744:     move.b  (A0,D3.W),D0
02:000300A6 1880            	  1745:     move.b  D0,($0000,A4)
                            	  1746:     even
                            	  1747: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  1748:     ; If there are no triforce pieces, then return.
                            	  1749:     ;
02:000300A8 102C0671        	  1750:     move.b  ($0671,A4),D0
02:000300AC 6602            	  1751:     bne.s  __far_z_01_0008
02:000300AE 605C            	  1752:     jmp  L6104_Exit
                            	  1753: __far_z_01_0008:
                            	  1754:     ; If we have gotten this triforce piece, then go try to make a
                            	  1755:     ; whirlwind.
                            	  1756:     ;
02:000300B0 1214            	  1757:     move.b  ($0000,A4),D1
