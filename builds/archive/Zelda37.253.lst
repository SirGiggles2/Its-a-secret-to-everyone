                            	  3018: FormatHeartsInTextBuf:
                            	  3019:     ; [$0E]: hearts value
                            	  3020:     ; [$0F]: heart partial
                            	  3021:     ; Y: The offset of first character in buffer
                            	  3022:     ;
                            	  3023:     ; The end of the bottom row is $12 bytes after the
                            	  3024:     ; start of the top row. We're writing to two transfer
                            	  3025:     ; records. We write the top row in the first transfer
                            	  3026:     ; record wherever the caller chooses. The second
                            	  3027:     ; transfer record has to begin with the heart tiles.
                            	  3028:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3029:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3030:     ;
                            	  3031:     ; Store the starting offset in [$0D].
02:00030932 1943000D        	  3032:     move.b  D3,($000D,A4)
02:00030936 102C000E        	  3033:     move.b  ($000E,A4),D0
02:0003093A 1B00            	  3034:     move.b  D0,-(A5)  ; PHA
02:0003093C 0200000F        	  3035:     andi.b #$0F,D0
02:00030940 1880            	  3036:     move.b  D0,($0000,A4)
02:00030942 700F            	  3037:     moveq   #15,D0
02:00030944 003C0011        	  3038:     ori     #$11,CCR  ; SEC: set C+X
