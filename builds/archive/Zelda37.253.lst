02:00031D5A 020000F0        	  5728:     andi.b #$F0,D0
02:00031D5E 6702            	  5729:     beq.s  __far_z_01_0058
02:00031D60 605C            	  5730:     jmp  HarmLink
                            	  5731: __far_z_01_0058:
