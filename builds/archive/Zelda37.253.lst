                            	 12332:     ; The animation cycle has 6 frames.
                            	 12333:     ;
02:0003F04C 41EC046B        	 12334:     lea     ($046B,A4),A0
02:0003F050 10302000        	 12335:     move.b  (A0,D2.W),D0
02:0003F054 0C000006        	 12336:     cmpi.b  #$06,D0
