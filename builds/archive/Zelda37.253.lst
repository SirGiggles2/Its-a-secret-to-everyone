                            	   269: InitCaveContinue:
                            	   270:     ; Get this cave's index (object type - $6A).
                            	   271:     ;
02:0002E63E 102C0350        	   272:     move.b  ($0350,A4),D0
02:0002E642 003C0011        	   273:     ori     #$11,CCR  ; SEC: set C+X
02:0002E646 123C006A        	   274:     move.b  #$6A,D1
02:0002E64A 0A3C0010        	   275:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E64E 9101            	   276:     subx.b  D1,D0   ; SBC #$6A
02:0002E650 0A3C0010        	   277:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E654 7600            	   278:     moveq   #0,D3
02:0002E656 1600            	   279:     move.b  D0,D3
                            	   280:     ; Get the person text selector by looking up the text selector byte
                            	   281:     ; for this index, and masking it with $3F.
                            	   282:     ;
02:0002E658 41F90002E5D6    	   283:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E65E 10303000        	   284:     move.b  (A0,D3.W),D0
02:0002E662 1B00            	   285:     move.b  D0,-(A5)  ; PHA
02:0002E664 0200003F        	   286:     andi.b #$3F,D0
02:0002E668 19400415        	   287:     move.b  D0,($0415,A4)
                            	   288:     ; Pop and mask the text selector byte with $C0 to get the
                            	   289:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   290:     ;
02:0002E66C 101D            	   291:     move.b  (A5)+,D0  ; PLA
02:0002E66E 020000C0        	   292:     andi.b #$C0,D0
02:0002E672 19400003        	   293:     move.b  D0,($0003,A4)
                            	   294:     ; At this point, the Y register still has the cave index.
                            	   295:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   296:     ;
02:0002E676 103C00FD        	   297:     move.b  #$FD,D0
                            	   298: _anon_z01_0:
02:0002E67A 023C00EE        	   299:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E67E 123C0003        	   300:     move.b  #$03,D1
02:0002E682 D101            	   301:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E684 5303            	   302:     subq.b  #1,D3
02:0002E686 6AF2            	   303:     bpl  _anon_z01_0
02:0002E688 7600            	   304:     moveq   #0,D3
02:0002E68A 1600            	   305:     move.b  D0,D3
                            	   306:     ; Loop over the wares from 0 to 2.
                            	   307:     ;
02:0002E68C 7400            	   308:     moveq   #0,D2
                            	   309:     even
                            	   310: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   311:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   312:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   313:     ;
02:0002E68E 41F900FF6A7E    	   314:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E694 10303000        	   315:     move.b  (A0,D3.W),D0
02:0002E698 41EC0422        	   316:     lea     ($0422,A4),A0
02:0002E69C 11802000        	   317:     move.b  D0,(A0,D2.W)
                            	   318:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   319:     ;
02:0002E6A0 020000C0        	   320:     andi.b #$C0,D0
02:0002E6A4 19802000        	   321:     move.b  D0,($00,A4,D2.W)
                            	   322:     ; Copy 3 prices from the Cave level block info.
                            	   323:     ;
02:0002E6A8 41F900FF6ABA    	   324:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E6AE 10303000        	   325:     move.b  (A0,D3.W),D0
02:0002E6B2 41EC0430        	   326:     lea     ($0430,A4),A0
02:0002E6B6 11802000        	   327:     move.b  D0,(A0,D2.W)
                            	   328:     ; Bottom of the wares copying loop.
                            	   329:     ;
02:0002E6BA 5203            	   330:     addq.b  #1,D3
02:0002E6BC 5202            	   331:     addq.b  #1,D2
02:0002E6BE 0C020003        	   332:     cmpi.b  #$03,D2
02:0002E6C2 66CA            	   333:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   334:     ; Get the top 2 bits of text selector byte in [03],
                            	   335:     ; shift them to the bottom, and combine them with [00].
                            	   336:     ;
02:0002E6C4 102C0003        	   337:     move.b  ($0003,A4),D0
02:0002E6C8 E308            	   338:     lsl.b  #1,D0   ; ASL A
02:0002E6CA E310            	   339:     roxl.b  #1,D0   ; ROL A
02:0002E6CC E310            	   340:     roxl.b  #1,D0   ; ROL A
02:0002E6CE 1214            	   341:     move.b  ($0000,A4),D1
02:0002E6D0 8001            	   342:     or.b  D1,D0
02:0002E6D2 1880            	   343:     move.b  D0,($0000,A4)
                            	   344:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   345:     ; and combine them with [00].
                            	   346:     ;
02:0002E6D4 102C0002        	   347:     move.b  ($0002,A4),D0
02:0002E6D8 E208            	   348:     lsr.b  #1,D0   ; LSR A
02:0002E6DA E208            	   349:     lsr.b  #1,D0   ; LSR A
02:0002E6DC E208            	   350:     lsr.b  #1,D0   ; LSR A
02:0002E6DE E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0002E6E0 1214            	   352:     move.b  ($0000,A4),D1
02:0002E6E2 8001            	   353:     or.b  D1,D0
02:0002E6E4 1880            	   354:     move.b  D0,($0000,A4)
                            	   355:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   356:     ; and combine them with [00] into CaveFlags.
                            	   357:     ;
02:0002E6E6 102C0001        	   358:     move.b  ($0001,A4),D0
02:0002E6EA E208            	   359:     lsr.b  #1,D0   ; LSR A
02:0002E6EC E208            	   360:     lsr.b  #1,D0   ; LSR A
02:0002E6EE 1214            	   361:     move.b  ($0000,A4),D1
02:0002E6F0 8001            	   362:     or.b  D1,D0
02:0002E6F2 19400413        	   363:     move.b  D0,($0413,A4)
                            	   364:     ; The end result is a byte with 8 cave flags.
                            	   365:     ;
                            	   366:     ; If cave flag "money game" is missing, then go finish up,
                            	   367:     ; instead of choosing random amounts for the money game.
                            	   368:     ;
02:0002E6F6 02000020        	   369:     andi.b #$20,D0
02:0002E6FA 6700009E        	   370:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   371:     ; Determine an index randomly with increasing probability,
                            	   372:     ; from 6 to 1. Start with the following test:
                            	   373:     ;
                            	   374:     ;   If $FF < Random, then go use index 6.
                            	   375:     ;
02:0002E6FE 103C00FF        	   376:     move.b  #$FF,D0
02:0002E702 7606            	   377:     moveq   #6,D3
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E704 122C0019        	   380:     move.b  ($0019,A4),D1
02:0002E708 B001            	   381:     cmp.b   D1,D0
02:0002E70A 6516            	   382:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   383:     ; If the test fails, then subtract $2B from the reference number.
                            	   384:     ;
02:0002E70C 003C0011        	   385:     ori     #$11,CCR  ; SEC: set C+X
02:0002E710 123C002B        	   386:     move.b  #$2B,D1
02:0002E714 0A3C0010        	   387:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E718 9101            	   388:     subx.b  D1,D0   ; SBC #$2B
02:0002E71A 0A3C0010        	   389:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E71E 5303            	   390:     subq.b  #1,D3
02:0002E720 66E2            	   391:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   392:     even
                            	   393: _L_z01_InitCaveContinue_FoundPermutation:
                            	   394:     ; The index chooses the last offset of a permutation of three indexes.
                            	   395:     ;
02:0002E722 7400            	   396:     moveq   #0,D2
02:0002E724 41F90002E5FE    	   397:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E72A 14303000        	   398:     move.b  (A0,D3.W),D2
                            	   399:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   400:     ;
02:0002E72E 7602            	   401:     moveq   #2,D3
                            	   402:     even
                            	   403: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E730 41F90002E5EC    	   404:     lea     (MoneyGamePermutations).l,A0
02:0002E736 10302000        	   405:     move.b  (A0,D2.W),D0
02:0002E73A 41EC046C        	   406:     lea     ($046C,A4),A0
02:0002E73E 11803000        	   407:     move.b  D0,(A0,D3.W)
02:0002E742 5302            	   408:     subq.b  #1,D2
02:0002E744 5303            	   409:     subq.b  #1,D3
02:0002E746 6AE8            	   410:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   411:     ; With the first bit of another random number, choose 10 or 40
                            	   412:     ; to put in [046F]. This is a random amount to lose.
                            	   413:     ;
02:0002E748 102C001A        	   414:     move.b  ($001A,A4),D0
02:0002E74C 02000001        	   415:     andi.b #$01,D0
02:0002E750 7600            	   416:     moveq   #0,D3
02:0002E752 1600            	   417:     move.b  D0,D3
02:0002E754 41F90002E5EA    	   418:     lea     (MoneyGameLossAmounts).l,A0
02:0002E75A 10303000        	   419:     move.b  (A0,D3.W),D0
02:0002E75E 1940046F        	   420:     move.b  D0,($046F,A4)
                            	   421:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   422:     ;
02:0002E762 700A            	   423:     moveq   #10,D0
02:0002E764 19400470        	   424:     move.b  D0,($0470,A4)
                            	   425:     ; With a different bit of the second random number,
                            	   426:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   427:     ;
02:0002E768 7614            	   428:     moveq   #20,D3
02:0002E76A 102C001A        	   429:     move.b  ($001A,A4),D0
02:0002E76E 02000002        	   430:     andi.b #$02,D0
02:0002E772 6702            	   431:     beq  _anon_z01_1
02:0002E774 7632            	   432:     moveq   #50,D3
                            	   433: _anon_z01_1:
