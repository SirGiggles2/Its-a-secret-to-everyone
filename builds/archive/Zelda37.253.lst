                            	  5791: HarmLink:
02:00031DBE 61000564        	  5792:     jsr     BeginShove
                            	  5793:     ; Flag collision with [0C], even though [06] was already set.
                            	  5794:     ;
02:00031DC2 522C000C        	  5795:     addq.b  #1,($000C,A4)
                            	  5796:     ; Unpack the damage points for the monster's type.
                            	  5797:     ; The low nibble is the high byte.
                            	  5798:     ; (Damage points byte AND $F0) is the low byte.
                            	  5799:     ;
02:00031DC6 7600            	  5800:     moveq   #0,D3
02:00031DC8 41EC034F        	  5801:     lea     ($034F,A4),A0
02:00031DCC 16302000        	  5802:     move.b  (A0,D2.W),D3
02:00031DD0 41F900031C32    	  5803:     lea     (ObjTypeToDamagePoints).l,A0
02:00031DD6 10303000        	  5804:     move.b  (A0,D3.W),D0
02:00031DDA 1B00            	  5805:     move.b  D0,-(A5)  ; PHA
