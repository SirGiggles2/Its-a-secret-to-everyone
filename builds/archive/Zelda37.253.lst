                            	  3069: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3070:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3071:     ; the mound frame images:
                            	  3072:     ;
                            	  3073:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3074:     ;
                            	  3075:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3076:     ;
                            	  3077:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3078:     ;
02:0003AC7E 003C0011        	  3079:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC82 123C0001        	  3080:     move.b  #$01,D1
02:0003AC86 0A3C0010        	  3081:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC8A 9101            	  3082:     subx.b  D1,D0   ; SBC #$01
02:0003AC8C 0A3C0010        	  3083:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC90 E308            	  3084:     lsl.b  #1,D0   ; ASL A
02:0003AC92 023C00EE        	  3085:     andi    #$EE,CCR  ; CLC: clear C+X
