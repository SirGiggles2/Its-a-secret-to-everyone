                            	  4897:     ;
02:0004BB50 7622            	  4898:     moveq   #34,D3
02:0004BB52 0C02000D        	  4899:     cmpi.b  #$0D,D2
02:0004BB56 6410            	  4900:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BB58 41EC034F        	  4901:     lea     ($034F,A4),A0
02:0004BB5C 10302000        	  4902:     move.b  (A0,D2.W),D0
