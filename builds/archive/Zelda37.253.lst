02:00041928 670A            	  3381:     beq  _anon_z05_83
02:0004192A 5203            	  3382:     addq.b  #1,D3
02:0004192C 0C0000B0        	  3383:     cmpi.b  #$B0,D0
02:00041930 6702            	  3384:     beq.s  __far_z_05_0062
02:00041932 604C            	  3385:     jmp  L14F72_Exit
                            	  3386: __far_z_05_0062:
                            	  3387: _anon_z05_83:
                            	  3388:     ; Look for the current room in the cellar/shortcut room array.
                            	  3389:     ;
02:00041934 1883            	  3390:     move.b  D3,($0000,A4)
02:00041936 163C00FF        	  3391:     move.b  #$FF,D3
02:0004193A 102C00EB        	  3392:     move.b  ($00EB,A4),D0
                            	  3393: _anon_z05_84:
02:0004193E 5203            	  3394:     addq.b  #1,D3
02:00041940 41F900FF6BB2    	  3395:     lea     (NES_SRAM+$0BB2).l,A0
02:00041946 12303000        	  3396:     move.b  (A0,D3.W),D1
02:0004194A B001            	  3397:     cmp.b   D1,D0
02:0004194C 66F0            	  3398:     bne  _anon_z05_84
                            	  3399:     ; Add the value of the shortcut chosen to whatever index
                            	  3400:     ; the current room has in the array.
                            	  3401:     ;
                            	  3402:     ; This yields the index of one of the three shortcut rooms
                            	  3403:     ; after the current one.
                            	  3404:     ;
02:0004194E 1003            	  3405:     move.b  D3,D0
02:00041950 023C00EE        	  3406:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041954 1214            	  3407:     move.b  ($0000,A4),D1
02:00041956 D101            	  3408:     addx.b  D1,D0   ; ADC $00
                            	  3409:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3410:     ;
02:00041958 02000003        	  3411:     andi.b #$03,D0
02:0004195C 7600            	  3412:     moveq   #0,D3
02:0004195E 1600            	  3413:     move.b  D0,D3
02:00041960 41F900FF6BB2    	  3414:     lea     (NES_SRAM+$0BB2).l,A0
02:00041966 10303000        	  3415:     move.b  (A0,D3.W),D0
                            	  3416: ; Params:
                            	  3417: ; A: destination room ID
                            	  3418: ;
                            	  3419:     even
                            	  3420: GoToModeAFromCellar:
02:0004196A 194000EB        	  3421:     move.b  D0,($00EB,A4)
02:0004196E 4EB90004A6B6    	  3422:     jsr     MarkRoomVisited
                            	  3423:     even
                            	  3424: GoToModeAFromCave:
02:00041974 700A            	  3425:     moveq   #10,D0
02:00041976 19400012        	  3426:     move.b  D0,($0012,A4)
                            	  3427:     even
                            	  3428: EndPrepareMode:
02:0004197A 4EF90002C45C    	  3429:     jmp     c_end_prepare_mode
                            	  3430: 
                            	  3431: L14F72_Exit:
02:00041980 4E75            	  3432:     rts
