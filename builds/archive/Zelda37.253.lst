02:0003BF0C 41EC0485        	  5615:     lea     ($0485,A4),A0
02:0003BF10 11802000        	  5616:     move.b  D0,(A0,D2.W)
02:0003BF14 61000608        	  5617:     jsr     CheckBossHitReaction
                            	  5618:     ; Look for the tail segment, starting from the low end
