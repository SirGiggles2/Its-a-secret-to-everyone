02:0003B062 41EC0098        	  3607:     lea     ($0098,A4),A0
02:0003B066 10302000        	  3608:     move.b  (A0,D2.W),D0
02:0003B06A 02000002        	  3609:     andi.b #$02,D0
02:0003B06E 6704            	  3610:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3611:     even
