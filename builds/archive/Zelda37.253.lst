                            	  2364:     ;
02:000304F6 61001798        	  2365:     jsr     CheckLinkCollision
                            	  2366:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  2367:     ; and current coordinate to the trap's X.
                            	  2368:     ;
02:000304FA 7600            	  2369:     moveq   #0,D3
02:000304FC 16342070        	  2370:     move.b  ($70,A4,D2.W),D3
02:00030500 7078            	  2371:     moveq   #120,D0
02:00030502 1880            	  2372:     move.b  D0,($0000,A4)
02:00030504 41EC0098        	  2373:     lea     ($0098,A4),A0
02:00030508 10302000        	  2374:     move.b  (A0,D2.W),D0
02:0003050C 0200000C        	  2375:     andi.b #$0C,D0
02:00030510 6710            	  2376:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  2377:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  2378:     ; and current coordinate to the trap's Y.
                            	  2379:     ;
02:00030512 7600            	  2380:     moveq   #0,D3
02:00030514 41EC0084        	  2381:     lea     ($0084,A4),A0
02:00030518 16302000        	  2382:     move.b  (A0,D2.W),D3
02:0003051C 103C0090        	  2383:     move.b  #$90,D0
02:00030520 1880            	  2384:     move.b  D0,($0000,A4)
                            	  2385:     even
                            	  2386: _L_z01_UpdateTrap_Full_Finish:
                            	  2387:     ; If in state 2, then go finish handling it.
                            	  2388:     ;
02:00030522 41EC00AC        	  2389:     lea     ($00AC,A4),A0
02:00030526 10302000        	  2390:     move.b  (A0,D2.W),D0
02:0003052A 02000001        	  2391:     andi.b #$01,D0
02:0003052E 6744            	  2392:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  2393:     ; Finish handling state 1.
                            	  2394:     ;
                            	  2395:     ; Get the distance between the current coordinate and the target.
                            	  2396:     ;
02:00030530 1003            	  2397:     move.b  D3,D0
02:00030532 003C0011        	  2398:     ori     #$11,CCR  ; SEC: set C+X
02:00030536 1214            	  2399:     move.b  ($0000,A4),D1
02:00030538 0A3C0010        	  2400:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003053C 9101            	  2401:     subx.b  D1,D0   ; SBC $00
02:0003053E 0A3C0010        	  2402:     eori    #$10,CCR  ; restore X = 6502 C
02:00030542 61000732        	  2403:     jsr     Abs
                            	  2404:     ; If distance >= 5, go draw.
                            	  2405:     ;
