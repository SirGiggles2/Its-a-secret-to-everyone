02:0004BFCC 0C00005B        	  5562:     cmpi.b  #$5B,D0
02:0004BFD0 670A            	  5563:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
                            	  5564:     even
