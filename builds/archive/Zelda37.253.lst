                            	  5096: ReachedTopWallBottom:
                            	  5097:     ; Read a zero tile. Reached the bottom of a top wall.
                            	  5098:     ;
                            	  5099:     ; Set up A and X to move top and bottom offsets to the next column.
                            	  5100:     ;
02:00042FDA 7013            	  5101:     moveq   #19,D0
