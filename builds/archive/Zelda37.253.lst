02:0004C104 1940000F        	  5755:     move.b  D0,($000F,A4)
02:0004C108 41EC0098        	  5756:     lea     ($0098,A4),A0
02:0004C10C 11802000        	  5757:     move.b  D0,(A0,D2.W)
02:0004C110 1003            	  5758:     move.b  D3,D0
02:0004C112 1B00            	  5759:     move.b  D0,-(A5)  ; PHA
02:0004C114 6100F48E        	  5760:     jsr     MoveObject
                            	  5761:     ; Move horizontally towards the thrower.
                            	  5762:     ;
02:0004C118 101D            	  5763:     move.b  (A5)+,D0  ; PLA
02:0004C11A 7600            	  5764:     moveq   #0,D3
02:0004C11C 1600            	  5765:     move.b  D0,D3
02:0004C11E 41F90004BDD4    	  5766:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C124 10303000        	  5767:     move.b  (A0,D3.W),D0
02:0004C128 4EB900030D9E    	  5768:     jsr     SetBoomerangSpeed
02:0004C12E 102C000B        	  5769:     move.b  ($000B,A4),D0
02:0004C132 1940000F        	  5770:     move.b  D0,($000F,A4)
02:0004C136 41EC0098        	  5771:     lea     ($0098,A4),A0
02:0004C13A 11802000        	  5772:     move.b  D0,(A0,D2.W)
02:0004C13E 6100F464        	  5773:     jsr     MoveObject
                            	  5774:     even
                            	  5775: AnimateBoomerangAndCheckCollision:
                            	  5776:     ; Decrement animation counter; and when it reaches 0:
                            	  5777:     ; 1. arm it again for 2 frames
                            	  5778:     ; 2. advance the minor state within a cycle of 8
                            	  5779:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5780:     ;
