02:0003A990 D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A992 7600            	  2699:     moveq   #0,D3
02:0003A994 1600            	  2700:     move.b  D0,D3
02:0003A996 41F90003A844    	  2701:     lea     (JumperYAccelerations).l,A0
02:0003A99C 10303000        	  2702:     move.b  (A0,D3.W),D0
02:0003A9A0 7602            	  2703:     moveq   #2,D3
02:0003A9A2 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
