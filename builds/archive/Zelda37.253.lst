02:0004A99A 4EB90003156C    	  2363:     jsr     MapScreenPosToPpuAddr
02:0004A9A0 7400            	  2364:     moveq   #0,D2
02:0004A9A2 142C0301        	  2365:     move.b  ($0301,A4),D2
                            	  2366:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2367:     ;
                            	  2368:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2369:     ; In total, 11 bytes will be written.
                            	  2370:     ;
                            	  2371:     ; First, write the high byte of PPU address in each record.
                            	  2372:     ;
02:0004A9A6 1014            	  2373:     move.b  ($0000,A4),D0
02:0004A9A8 41EC0302        	  2374:     lea     ($0302,A4),A0
02:0004A9AC 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004A9B0 41EC0307        	  2376:     lea     ($0307,A4),A0
02:0004A9B4 11802000        	  2377:     move.b  D0,(A0,D2.W)
                            	  2378:     ; Write the low address in the first record. In the second record,
                            	  2379:     ; write (low address + 1).
                            	  2380:     ;
02:0004A9B8 102C0001        	  2381:     move.b  ($0001,A4),D0
02:0004A9BC 41EC0303        	  2382:     lea     ($0303,A4),A0
02:0004A9C0 11802000        	  2383:     move.b  D0,(A0,D2.W)
02:0004A9C4 41EC0308        	  2384:     lea     ($0308,A4),A0
02:0004A9C8 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:0004A9CC 41EC0308        	  2386:     lea     ($0308,A4),A0
02:0004A9D0 52302000        	  2387:     addq.b  #1,(A0,D2.W)
                            	  2388:     ; Write the first tile twice in each record. Patch them later.
                            	  2389:     ;
02:0004A9D4 102C0005        	  2390:     move.b  ($0005,A4),D0
02:0004A9D8 41EC0305        	  2391:     lea     ($0305,A4),A0
02:0004A9DC 11802000        	  2392:     move.b  D0,(A0,D2.W)
02:0004A9E0 41EC0306        	  2393:     lea     ($0306,A4),A0
02:0004A9E4 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:0004A9E8 41EC030A        	  2395:     lea     ($030A,A4),A0
02:0004A9EC 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:0004A9F0 41EC030B        	  2397:     lea     ($030B,A4),A0
02:0004A9F4 11802000        	  2398:     move.b  D0,(A0,D2.W)
                            	  2399:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2400:     ; Add 1 more to the second byte in each record.
                            	  2401:     ; Here is an example result of this manipulation:
                            	  2402:     ;   record 1: $70, $71
                            	  2403:     ;   record 2: $72, $73
                            	  2404:     ;
02:0004A9F8 0C000046        	  2405:     cmpi.b  #$46,D0
02:0004A9FC 6530            	  2406:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004A9FE 0C0000F3        	  2407:     cmpi.b  #$F3,D0
02:0004AA02 642A            	  2408:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004AA04 023C00EE        	  2409:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AA08 123C0002        	  2410:     move.b  #$02,D1
02:0004AA0C D101            	  2411:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004AA0E 41EC030A        	  2412:     lea     ($030A,A4),A0
02:0004AA12 11802000        	  2413:     move.b  D0,(A0,D2.W)
