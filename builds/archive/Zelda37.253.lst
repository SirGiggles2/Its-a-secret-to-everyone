02:0003CF4A 1003            	  7874:     move.b  D3,D0
02:0003CF4C 02000003        	  7875:     andi.b #$03,D0
02:0003CF50 41EC03E4        	  7876:     lea     ($03E4,A4),A0
02:0003CF54 11802000        	  7877:     move.b  D0,(A0,D2.W)
                            	  7878:     even
                            	  7879: _L_z04_UpdateLikeLike_Draw:
                            	  7880:     ; Draw.
