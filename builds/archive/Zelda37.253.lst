                            	  5571: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow:
                            	  5572:     ; Start preparing to draw an arrow.
                            	  5573:     ;
                            	  5574:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5575:     ; and no horizontal flipping in [0F].
                            	  5576:     ;
02:0004BFDC 7002            	  5577:     moveq   #2,D0
02:0004BFDE 1940000C        	  5578:     move.b  D0,($000C,A4)
02:0004BFE2 7000            	  5579:     moveq   #0,D0
02:0004BFE4 1940000F        	  5580:     move.b  D0,($000F,A4)
                            	  5581:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5582:     ; and go draw.
                            	  5583:     ;
02:0004BFE8 41EC0098        	  5584:     lea     ($0098,A4),A0
02:0004BFEC 10302000        	  5585:     move.b  (A0,D2.W),D0
02:0004BFF0 4EB900030C72    	  5586:     jsr     GetOppositeDir
02:0004BFF6 7000            	  5587:     moveq   #0,D0
02:0004BFF8 6000FEF0        	  5588:     jmp     SetAttrAndDrawArrow
