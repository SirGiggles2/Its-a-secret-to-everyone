02:0003F9D0 1214            	 13690:     move.b  ($0000,A4),D1
02:0003F9D2 8001            	 13691:     or.b  D1,D0
02:0003F9D4 1880            	 13692:     move.b  D0,($0000,A4)
                            	 13693:     even
