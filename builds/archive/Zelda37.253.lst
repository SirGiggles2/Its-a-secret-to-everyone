                            	  5349: LayOutDoors:
                            	  5350:     ; Copies the right door face for the direction, type, and state
                            	  5351:     ; of the door to the play area tile map.
                            	  5352:     ;
                            	  5353:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5354:     ; that are not true doors.
                            	  5355:     ;
02:000431E6 7403            	  5356:     moveq   #3,D2
                            	  5357:     even
                            	  5358: L_LayOutDoors_LoopDoors:
                            	  5359:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5360:     ;
02:000431E8 7001            	  5361:     moveq   #1,D0
                            	  5362:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5363:     ;
                            	  5364:     ; [06] indicates whether we're handling the first half of
                            	  5365:     ; the door: Left half for N/S, Top half for E/W.
                            	  5366:     ;
02:000431EA 19400006        	  5367:     move.b  D0,($0006,A4)
                            	  5368:     even
                            	  5369: L_LayOutDoors_LoopHalves:
02:000431EE 1002            	  5370:     move.b  D2,D0
02:000431F0 1B00            	  5371:     move.b  D0,-(A5)  ; PHA
02:000431F2 1940000B        	  5372:     move.b  D0,($000B,A4)
02:000431F6 41F9000431C2    	  5373:     lea     (DoorBits).l,A0
02:000431FC 10302000        	  5374:     move.b  (A0,D2.W),D0
02:00043200 19400002        	  5375:     move.b  D0,($0002,A4)
02:00043204 6100FD4A        	  5376:     jsr     FindDoorAttrByDoorBit
                            	  5377:     ; Begin looking for the door face for the door attribute.
                            	  5378:     ; In general, use the door type as the provisional face;
                            	  5379:     ; except turn 4 into 8.
                            	  5380:     ;
02:00043208 0C000005        	  5381:     cmpi.b  #$05,D0
02:0004320C 642A            	  5382:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004320E 0C000004        	  5383:     cmpi.b  #$04,D0
02:00043212 6608            	  5384:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:00043214 7008            	  5385:     moveq   #8,D0
02:00043216 6620            	  5386:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5387:     even
                            	  5388: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5389:     ; We jump here if the door type is bombable and was opened.
                            	  5390:     ; Change the provisional door face to value 9, which
                            	  5391:     ; will become the "hole in the wall".
                            	  5392:     ;
02:00043218 7009            	  5393:     moveq   #9,D0
02:0004321A 665A            	  5394:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5395:     even
                            	  5396: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5397:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5398:     ; the mask of opened doors, because this is not a true door.
                            	  5399:     ;
02:0004321C 1B00            	  5400:     move.b  D0,-(A5)  ; PHA
02:0004321E 102C0002        	  5401:     move.b  ($0002,A4),D0
02:00043222 4600            	  5402:     eori.b #$FF,D0
02:00043224 122C00EE        	  5403:     move.b  ($00EE,A4),D1
02:00043228 C001            	  5404:     and.b  D1,D0
02:0004322A 194000EE        	  5405:     move.b  D0,($00EE,A4)
02:0004322E 101D            	  5406:     move.b  (A5)+,D0  ; PLA
                            	  5407:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5408:     ;
02:00043230 0C000001        	  5409:     cmpi.b  #$01,D0
02:00043234 6402            	  5410:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043236 7004            	  5411:     moveq   #4,D0
                            	  5412:     even
                            	  5413: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5414:     ; The door attribute (DA) has been mapped to a
                            	  5415:     ; provisional door face value (PF) in %A as follows:
                            	  5416:     ;
                            	  5417:     ; DA PF Meaning
                            	  5418:     ; -------------
                            	  5419:     ; 0  4  open
                            	  5420:     ; 1  1  wall
                            	  5421:     ; 2  2  false wall
                            	  5422:     ; 3  3  false wall 2
                            	  5423:     ; 4  8  bombable
                            	  5424:     ; 5  5  key
                            	  5425:     ; 6  6  key 2
                            	  5426:     ; 7  7  shutter
                            	  5427:     ;
                            	  5428:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5429:     ; has been cleared, if the type was "open" or any wall.
                            	  5430:     ;
                            	  5431:     ;
                            	  5432:     ; Save the provisional face.
02:00043238 1B00            	  5433:     move.b  D0,-(A5)  ; PHA
                            	  5434:     ; If the current direction points to a door that has been opened,
                            	  5435:     ; then see if we need to set door flags.
                            	  5436:     ;
02:0004323A 102C00EE        	  5437:     move.b  ($00EE,A4),D0
02:0004323E 122C0002        	  5438:     move.b  ($0002,A4),D1
02:00043242 C001            	  5439:     and.b  D1,D0
02:00043244 7400            	  5440:     moveq   #0,D2
02:00043246 1400            	  5441:     move.b  D0,D2
02:00043248 101D            	  5442:     move.b  (A5)+,D0  ; PLA
02:0004324A 122C0002        	  5443:     move.b  ($0002,A4),D1
02:0004324E B401            	  5444:     cmp.b   D1,D2
02:00043250 6624            	  5445:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5446:     ; The current direction points to a door that has been opened.
                            	  5447:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5448:     ;
                            	  5449:     ;
                            	  5450:     ; Save provisional door face in Y register.
02:00043252 7600            	  5451:     moveq   #0,D3
02:00043254 1600            	  5452:     move.b  D0,D3
02:00043256 101D            	  5453:     move.b  (A5)+,D0  ; PLA
02:00043258 1B00            	  5454:     move.b  D0,-(A5)  ; PHA
02:0004325A 7400            	  5455:     moveq   #0,D2
02:0004325C 1400            	  5456:     move.b  D0,D2
02:0004325E 1003            	  5457:     move.b  D3,D0
                            	  5458:     ; If provisional door face is not for a shutter, then
                            	  5459:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5460:     ;
                            	  5461:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5462:     ;
02:00043260 0C000007        	  5463:     cmpi.b  #$07,D0
02:00043264 670E            	  5464:     beq  _anon_z05_111
02:00043266 1B00            	  5465:     move.b  D0,-(A5)  ; PHA
02:00043268 6100DF68        	  5466:     jsr     SetDoorFlag
02:0004326C 101D            	  5467:     move.b  (A5)+,D0  ; PLA
                            	  5468:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5469:     ; then go make it 9 (open "bombable").
                            	  5470:     ; Else make it 4 (open "door").
                            	  5471:     ;
02:0004326E 0C000008        	  5472:     cmpi.b  #$08,D0
02:00043272 67A4            	  5473:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5474: _anon_z05_111:
02:00043274 7004            	  5475:     moveq   #4,D0
                            	  5476:     even
                            	  5477: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5478:     ; For opened doors, the provisional door face has become:
                            	  5479:     ;
                            	  5480:     ; DA PF Meaning
                            	  5481:     ; -------------
                            	  5482:     ; 0  4  open
                            	  5483:     ; 1  1  wall
                            	  5484:     ; 2  2  false wall
                            	  5485:     ; 3  3  false wall 2
                            	  5486:     ; 4  9  bombable
                            	  5487:     ; 5  4  key
                            	  5488:     ; 6  4  key 2
                            	  5489:     ; 7  4  shutter
                            	  5490:     ;
                            	  5491:     ;
                            	  5492:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5493:     ;
02:00043276 7400            	  5494:     moveq   #0,D2
02:00043278 142C0006        	  5495:     move.b  ($0006,A4),D2
02:0004327C 6712            	  5496:     beq  _anon_z05_112
02:0004327E 7400            	  5497:     moveq   #0,D2
02:00043280 142C000B        	  5498:     move.b  ($000B,A4),D2
02:00043284 1B00            	  5499:     move.b  D0,-(A5)  ; PHA
02:00043286 6100FCC8        	  5500:     jsr     FindDoorAttrByDoorBit
02:0004328A 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:0004328E 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:00043290 0C000004        	  5507:     cmpi.b  #$04,D0
02:00043294 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00043298 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:0004329C 123C0003        	  5512:     move.b  #$03,D1
02:000432A0 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000432A4 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:000432A6 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:000432AA 7600            	  5516:     moveq   #0,D3
02:000432AC 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:000432AE 0C030003        	  5521:     cmpi.b  #$03,D3
02:000432B2 6502            	  5522:     bcs  _anon_z05_113
02:000432B4 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
