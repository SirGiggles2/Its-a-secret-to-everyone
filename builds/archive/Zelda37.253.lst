                            	  2098: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2099:     ; We got here in one of three ways:
                            	  2100:     ;
                            	  2101:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2102:     ;    explicitly.
                            	  2103:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2104:     ;    held an offset that was added to base palette attribute
                            	  2105:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2106:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2107:     ;    held absolute attributes.
                            	  2108:     ;
                            	  2109:     ; At this point, A holds the final sprite attributes.
02:0004A7E2 7400            	  2110:     moveq   #0,D2
02:0004A7E4 1942000C        	  2111:     move.b  D2,($000C,A4)
02:0004A7E8 740F            	  2112:     moveq   #15,D2
                            	  2113:     ; Write sprites.
                            	  2114:     ; A holds the calculated sprite attributes.
                            	  2115:     ; Y holds the item slot.
02:0004A7EA 4EF9000319CE    	  2116:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2117: 
                            	  2118:     even
