                            	  5742: _L_z07_CheckState30_MoveTowardThrower:
                            	  5743:     ; Move towards the thrower.
                            	  5744:     ;
                            	  5745:     ; Middle speed index 4 goes equally fast in X and Y axes.
                            	  5746:     ;
02:0004C0E8 7604            	  5747:     moveq   #4,D3
02:0004C0EA 4EB900030D18    	  5748:     jsr     _CalcDiagonalSpeedIndex
                            	  5749:     ; Move vertically towards the thrower.
                            	  5750:     ;
02:0004C0F0 41F90004BDCA    	  5751:     lea     (BoomerangQSpeedFracsY).l,A0
