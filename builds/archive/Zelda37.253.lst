                            	  2016: CheckZora:
                            	  2017:     ; If the zora attribute of this room is off, return.
                            	  2018:     ;
02:0003A538 7600            	  2019:     moveq   #0,D3
02:0003A53A 162C00EB        	  2020:     move.b  ($00EB,A4),D3
02:0003A53E 41F900FF687E    	  2021:     lea     (NES_SRAM+$087E).l,A0
02:0003A544 10303000        	  2022:     move.b  (A0,D3.W),D0
02:0003A548 02000008        	  2023:     andi.b #$08,D0
02:0003A54C 677C            	  2024:     beq  _L_z04_CheckZora_Exit
                            	  2025:     ; If zora is active, return.
                            	  2026:     ;
02:0003A54E 102C0514        	  2027:     move.b  ($0514,A4),D0
02:0003A552 6676            	  2028:     bne  _L_z04_CheckZora_Exit
                            	  2029:     ; Look for an empty monster slot. If none is found, return.
                            	  2030:     ;
02:0003A554 4EB90004D104    	  2031:     jsr     FindEmptyMonsterSlot
02:0003A55A 676E            	  2032:     beq  _L_z04_CheckZora_Exit
                            	  2033:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2034:     ; Indexed by [0D].
                            	  2035:     ;
02:0003A55C 700D            	  2036:     moveq   #13,D0
02:0003A55E 1940000D        	  2037:     move.b  D0,($000D,A4)
                            	  2038:     ; Switch to the new object slot.
                            	  2039:     ;
