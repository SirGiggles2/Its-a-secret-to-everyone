                            	  6041: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6042:     ; Digdogger is big, but room boundary checks and
                            	  6043:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6044:     ; Therefore, we have to check these things four times,
                            	  6045:     ; in different corners of the boss.
                            	  6046:     ;
                            	  6047:     ; Loop 4 times, from 0 to 3.
                            	  6048:     ;
02:0003C192 7600            	  6049:     moveq   #0,D3
02:0003C194 41EC0478        	  6050:     lea     ($0478,A4),A0
02:0003C198 16302000        	  6051:     move.b  (A0,D2.W),D3
                            	  6052:     ; Change the coordinates to one corner.
                            	  6053:     ;
02:0003C19C 10342070        	  6054:     move.b  ($70,A4,D2.W),D0
02:0003C1A0 023C00EE        	  6055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C1A4 41F90003C058    	  6056:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C1AA 12303000        	  6057:     move.b  (A0,D3.W),D1
02:0003C1AE D101            	  6058:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C1B0 19802070        	  6059:     move.b  D0,($70,A4,D2.W)
02:0003C1B4 41EC0084        	  6060:     lea     ($0084,A4),A0
02:0003C1B8 10302000        	  6061:     move.b  (A0,D2.W),D0
02:0003C1BC 023C00EE        	  6062:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C1C0 41F90003C05C    	  6063:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C1C6 12303000        	  6064:     move.b  (A0,D3.W),D1
02:0003C1CA D101            	  6065:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C1CC 41EC0084        	  6066:     lea     ($0084,A4),A0
02:0003C1D0 11802000        	  6067:     move.b  D0,(A0,D2.W)
                            	  6068:     ; Check the room boundary and object collisions in this temporary location.
                            	  6069:     ;
02:0003C1D4 61003734        	  6070:     jsr     BoundFlyer
02:0003C1D8 4EB900031B46    	  6071:     jsr     CheckMonsterCollisions
                            	  6072:     ; Increase the loop index, and loop again until it = 4.
                            	  6073:     ;
02:0003C1DE 41EC0478        	  6074:     lea     ($0478,A4),A0
02:0003C1E2 52302000        	  6075:     addq.b  #1,(A0,D2.W)
02:0003C1E6 41EC0478        	  6076:     lea     ($0478,A4),A0
02:0003C1EA 10302000        	  6077:     move.b  (A0,D2.W),D0
02:0003C1EE 0C000004        	  6078:     cmpi.b  #$04,D0
02:0003C1F2 659E            	  6079:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6080:     ; Restore the original coordinates.
                            	  6081:     ;
