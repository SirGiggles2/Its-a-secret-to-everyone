02:00031E5C 122C000D        	  5871:     move.b  ($000D,A4),D1
02:00031E60 B001            	  5872:     cmp.b   D1,D0
02:00031E62 6554            	  5873:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031E64 102C066F        	  5874:     move.b  ($066F,A4),D0
02:00031E68 003C0011        	  5875:     ori     #$11,CCR  ; SEC: set C+X
02:00031E6C 122C000D        	  5876:     move.b  ($000D,A4),D1
02:00031E70 0A3C0010        	  5877:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E74 9101            	  5878:     subx.b  D1,D0   ; SBC $0D
02:00031E76 0A3C0010        	  5879:     eori    #$10,CCR  ; restore X = 6502 C
