02:00034D96 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00034D98 41F9000347A6    	  2548:     lea     (SlotToNameOffset).l,A0
02:00034D9E 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00034DA2 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00034DA6 7400            	  2553:     moveq   #0,D2
02:00034DA8 41F9000347AA    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034DAE 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00034DB2 7602            	  2556:     moveq   #2,D3
