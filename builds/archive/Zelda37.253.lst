                            	  5538: HandleArrowOrBoomerangBlocked:
                            	  5539:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5540:     ;
02:0004BF9A 7003            	  5541:     moveq   #3,D0
02:0004BF9C 41EC03D0        	  5542:     lea     ($03D0,A4),A0
02:0004BFA0 11802000        	  5543:     move.b  D0,(A0,D2.W)
                            	  5544:     ; Add $10 to the state to make it $2x.
                            	  5545:     ;
02:0004BFA4 41EC00AC        	  5546:     lea     ($00AC,A4),A0
02:0004BFA8 10302000        	  5547:     move.b  (A0,D2.W),D0
02:0004BFAC 023C00EE        	  5548:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BFB0 123C0010        	  5549:     move.b  #$10,D1
02:0004BFB4 D101            	  5550:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004BFB6 41EC00AC        	  5551:     lea     ($00AC,A4),A0
02:0004BFBA 11802000        	  5552:     move.b  D0,(A0,D2.W)
                            	  5553:     even
