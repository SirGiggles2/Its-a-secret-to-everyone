                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:0003659E 7600            	  4891:     moveq   #0,D3
02:000365A0 162C0413        	  4892:     move.b  ($0413,A4),D3
02:000365A4 41F90003653E    	  4893:     lea     (PeaceText).l,A0
02:000365AA 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000365AE 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000365B2 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000365B4 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
