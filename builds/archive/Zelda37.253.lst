02:00030E1E 1002            	  3769:     move.b  D2,D0
02:00030E20 0A000001        	  3770:     eori.b #$01,D0
02:00030E24 7600            	  3771:     moveq   #0,D3
02:00030E26 1600            	  3772:     move.b  D0,D3
02:00030E28 41EC00AC        	  3773:     lea     ($00AC,A4),A0
02:00030E2C 10303000        	  3774:     move.b  (A0,D3.W),D0
