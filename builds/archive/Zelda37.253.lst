02:000364A6 123C0010        	  4794:     move.b  #$10,D1
02:000364AA 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000364AE 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:000364B0 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
