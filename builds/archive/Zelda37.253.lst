                            	  5650: _L_z07_CheckState30_CheckOtherStates:
                            	  5651:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5652:     ;
                            	  5653:     ; The boomerang will now return. Reset the grid offset.
                            	  5654:     ;
02:0004C058 7000            	  5655:     moveq   #0,D0
02:0004C05A 41EC0394        	  5656:     lea     ($0394,A4),A0
02:0004C05E 11802000        	  5657:     move.b  D0,(A0,D2.W)
                            	  5658:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5659:     ;
02:0004C062 0C02000D        	  5660:     cmpi.b  #$0D,D2
02:0004C066 6408            	  5661:     bcc  _anon_z07_30
02:0004C068 41EC042C        	  5662:     lea     ($042C,A4),A0
02:0004C06C 10302000        	  5663:     move.b  (A0,D2.W),D0
                            	  5664: _anon_z07_30:
02:0004C070 4EB900030CCA    	  5665:     jsr     GetDirectionsAndDistancesToTarget
                            	  5666:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5667:     ; then go move towards the thrower, draw, and check collisions.
                            	  5668:     ;
02:0004C076 1014            	  5669:     move.b  ($0000,A4),D0
02:0004C078 0C000002        	  5670:     cmpi.b  #$02,D0
02:0004C07C 666A            	  5671:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5672:     ; The boomerang has reached the thrower.
                            	  5673:     ;
                            	  5674:     ; Reset the distance to move.
                            	  5675:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5676:     ;
02:0004C07E 7000            	  5677:     moveq   #0,D0
02:0004C080 41EC0380        	  5678:     lea     ($0380,A4),A0
02:0004C084 11802000        	  5679:     move.b  D0,(A0,D2.W)
02:0004C088 0C02000D        	  5680:     cmpi.b  #$0D,D2
02:0004C08C 6524            	  5681:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5682:     ; Link has caught the boomerang.
                            	  5683:     ;
                            	  5684:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; If Link catches it some time after throwing it,
                            	  5687:     ; his state will become $20, and he will show the catch animation.
                            	  5688:     ;
                            	  5689:     ; But if he catches it right after throwing it, the state becomes
                            	  5690:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5691:     ;
02:0004C08E 102C00AC        	  5692:     move.b  ($00AC,A4),D0
02:0004C092 00000020        	  5693:     ori.b #$20,D0
02:0004C096 194000AC        	  5694:     move.b  D0,($00AC,A4)
                            	  5695:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5696:     ; up the new state.
                            	  5697:     ;
02:0004C09A 7001            	  5698:     moveq   #1,D0
02:0004C09C 194003D0        	  5699:     move.b  D0,($03D0,A4)
                            	  5700:     ; Deactivate the boomerang.
                            	  5701:     ;
02:0004C0A0 760F            	  5702:     moveq   #15,D3
02:0004C0A2 7000            	  5703:     moveq   #0,D0
02:0004C0A4 41EC00AC        	  5704:     lea     ($00AC,A4),A0
02:0004C0A8 11803000        	  5705:     move.b  D0,(A0,D3.W)
02:0004C0AC 0A3C0001        	  5706:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C0B0 4E75            	  5707:     rts
                            	  5708: 
                            	  5709:     even
                            	  5710: _L_z07_CheckState30_CatchBoomerang:
                            	  5711:     ; A monster caught the boomerang that it threw.
                            	  5712:     ;
                            	  5713:     ; Set a timer for the thrower based on a random value:
                            	  5714:     ; < $30: $30
                            	  5715:     ; < $70: $50
                            	  5716:     ; Else:  $70
                            	  5717:     ;
02:0004C0B2 7630            	  5718:     moveq   #48,D3
02:0004C0B4 10342018        	  5719:     move.b  ($18,A4,D2.W),D0
02:0004C0B8 0C000030        	  5720:     cmpi.b  #$30,D0
02:0004C0BC 650A            	  5721:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004C0BE 7650            	  5722:     moveq   #80,D3
02:0004C0C0 0C000070        	  5723:     cmpi.b  #$70,D0
02:0004C0C4 6502            	  5724:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004C0C6 7670            	  5725:     moveq   #112,D3
                            	  5726:     even
                            	  5727: _L_z07_CheckState30_SetThrowerTimer:
02:0004C0C8 1003            	  5728:     move.b  D3,D0
