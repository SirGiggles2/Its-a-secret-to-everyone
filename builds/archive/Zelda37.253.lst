                            	  7926: HaveInput:
                            	  7927:     ; There were input directions.
                            	  7928:     ;
                            	  7929:     ; If there was only one input direction, go set object direction
                            	  7930:     ; to input direction, and set Link's speed.
                            	  7931:     ;
                            	  7932:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7933:     ; (X is still 0, because it's Link's object index).
                            	  7934:     ;
02:000448F8 102C000F        	  7935:     move.b  ($000F,A4),D0
02:000448FC 0C030001        	  7936:     cmpi.b  #$01,D3
02:00044900 670000B6        	  7937:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7938:     ; There were more than one input directions.
                            	  7939:     ;
                            	  7940:     ; If none were walkable, go set input direction to 0, and return.
                            	  7941:     ;
02:00044904 102C000C        	  7942:     move.b  ($000C,A4),D0
02:00044908 6604            	  7943:     bne  _anon_z05_174
02:0004490A 60000128        	  7944:     jmp     SetLinkInputDir
                            	  7945: 
                            	  7946: _anon_z05_174:
                            	  7947:     ; Two input directions, and at least one of them is walkable.
                            	  7948:     ;
                            	  7949:     ; Make Link go straight in one direction on the next grid line.
                            	  7950:     ;
02:0004490E 7600            	  7951:     moveq   #0,D3
02:00044910 1600            	  7952:     move.b  D0,D3
02:00044912 522C0057        	  7953:     addq.b  #1,($0057,A4)
                            	  7954:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7955:     ; object direction and input direction to last walkable direction
                            	  7956:     ; found, and set Link's speed.
                            	  7957:     ;
                            	  7958:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7959:     ;
02:00044916 7400            	  7960:     moveq   #0,D2
02:00044918 102C000D        	  7961:     move.b  ($000D,A4),D0
02:0004491C 0C030001        	  7962:     cmpi.b  #$01,D3
02:00044920 67000096        	  7963:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00044924 7600            	  7964:     moveq   #0,D3
02:00044926 162C0010        	  7965:     move.b  ($0010,A4),D3
02:0004492A 6700008C        	  7966:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7967:     ; In UW. There are two input directions, and they're both walkable.
                            	  7968:     ;
                            	  7969:     ; Normally, turn to the direction that's perpendicular to object
                            	  7970:     ; direction. But keep going straight after that, while diagonal
                            	  7971:     ; input is held.
                            	  7972:     ;
                            	  7973:     ; Handle special cases for doors.
                            	  7974:     ;
                            	  7975:     ;
                            	  7976:     ; 1. Link at horizontal doors.
                            	  7977:     ;
                            	  7978:     ; If Link's X = $20 or $D0 then
                            	  7979:     ;   If Link's Y = $85 and facing down then
                            	  7980:     ;     Go set object direction and input direction to object
                            	  7981:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7982:     ;     Link_GoStraightWhenDiagInput.
                            	  7983:     ;   Else
                            	  7984:     ;     Go turn to the perpendicular direction
                            	  7985:     ;
02:0004492E 7600            	  7986:     moveq   #0,D3
02:00044930 162C0070        	  7987:     move.b  ($0070,A4),D3
02:00044934 0C030020        	  7988:     cmpi.b  #$20,D3
02:00044938 6706            	  7989:     beq  _anon_z05_175
02:0004493A 0C0300D0        	  7990:     cmpi.b  #$D0,D3
02:0004493E 661C            	  7991:     bne  _anon_z05_176
                            	  7992: _anon_z05_175:
02:00044940 7600            	  7993:     moveq   #0,D3
02:00044942 162C0084        	  7994:     move.b  ($0084,A4),D3
02:00044946 0C030085        	  7995:     cmpi.b  #$85,D3
02:0004494A 6642            	  7996:     bne  _anon_z05_177
02:0004494C 102C0098        	  7997:     move.b  ($0098,A4),D0
02:00044950 02000004        	  7998:     andi.b #$04,D0
02:00044954 6738            	  7999:     beq  _anon_z05_177
                            	  8000:     even
                            	  8001: _L_z05_HaveInput_SetLinkDirToObjDir:
02:00044956 102C0098        	  8002:     move.b  ($0098,A4),D0
02:0004495A 665C            	  8003:     bne  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8004: _anon_z05_176:
                            	  8005:     ; If allowed to turn when input is diagonal (2 directions), then
                            	  8006:     ; go take the direction perpendicular to object direction.
                            	  8007:     ;
02:0004495C 102C0098        	  8008:     move.b  ($0098,A4),D0
02:00044960 7400            	  8009:     moveq   #0,D2
02:00044962 142C0056        	  8010:     move.b  ($0056,A4),D2
02:00044966 6726            	  8011:     beq  _anon_z05_177
                            	  8012:     ; At this point, Link_GoStraightWhenDiagInput is true.
                            	  8013:     ;
                            	  8014:     ;
                            	  8015:     ; 2. Link at top door.
