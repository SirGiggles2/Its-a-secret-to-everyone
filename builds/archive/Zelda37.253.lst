02:0003AA20 12342019        	  2766:     move.b  ($19,A4,D2.W),D1
02:0003AA24 D101            	  2767:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AA26 0C000020        	  2768:     cmpi.b  #$20,D0
02:0003AA2A 6412            	  2769:     bcc  _anon_z04_39
02:0003AA2C 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:0003AA30 123C0040        	  2771:     move.b  #$40,D1
02:0003AA34 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA38 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:0003AA3A 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
