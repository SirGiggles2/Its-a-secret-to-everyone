                            	 13647: TurnTowardsPlayer8:
                            	 13648:     ; Build a direction in [00] towards the player.
                            	 13649:     ;
                            	 13650:     ; First, calculate a horizontal component:
                            	 13651:     ;
                            	 13652:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13653:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13654:     ; else                               [00] := 2 (left)
                            	 13655:     ;
02:0003F99C 7600            	 13656:     moveq   #0,D3
02:0003F99E 1883            	 13657:     move.b  D3,($0000,A4)
02:0003F9A0 5203            	 13658:     addq.b  #1,D3
02:0003F9A2 102C0061        	 13659:     move.b  ($0061,A4),D0
02:0003F9A6 12342070        	 13660:     move.b  ($70,A4,D2.W),D1
02:0003F9AA B001            	 13661:     cmp.b   D1,D0
02:0003F9AC 6706            	 13662:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003F9AE 6402            	 13663:     bcc  _anon_z04_175
02:0003F9B0 5203            	 13664:     addq.b  #1,D3
                            	 13665: _anon_z04_175:
02:0003F9B2 1883            	 13666:     move.b  D3,($0000,A4)
                            	 13667:     even
                            	 13668: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13669:     ; Second, calculate a vertical component.
                            	 13670:     ; Combine it with the horizontal component:
                            	 13671:     ;
                            	 13672:     ; Y := 4 (down)
                            	 13673:     ; if observed player Y <> object Y then
                            	 13674:     ;   if observed player Y < object Y then
                            	 13675:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13676:     ;   [00] := [00] | Y
                            	 13677:     ;
02:0003F9B4 7601            	 13678:     moveq   #1,D3
02:0003F9B6 102C0062        	 13679:     move.b  ($0062,A4),D0
02:0003F9BA 41EC0084        	 13680:     lea     ($0084,A4),A0
02:0003F9BE 12302000        	 13681:     move.b  (A0,D2.W),D1
02:0003F9C2 B001            	 13682:     cmp.b   D1,D0
02:0003F9C4 6710            	 13683:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003F9C6 6402            	 13684:     bcc  _anon_z04_176
02:0003F9C8 5203            	 13685:     addq.b  #1,D3
                            	 13686: _anon_z04_176:
