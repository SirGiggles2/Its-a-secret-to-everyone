02:00039F90 41EC041F        	  1203:     lea     ($041F,A4),A0
02:00039F94 10302000        	  1204:     move.b  (A0,D2.W),D0
02:00039F98 7600            	  1205:     moveq   #0,D3
02:00039F9A 41EC0451        	  1206:     lea     ($0451,A4),A0
02:00039F9E 16302000        	  1207:     move.b  (A0,D2.W),D3
