02:0003F014 6704            	 12289:     beq.s  __far_z_04_0118
02:0003F016 600000A4        	 12290:     jmp  Ganon_Dying
                            	 12291: __far_z_04_0118:
02:0003F01A 61000356        	 12292:     jsr     Ganon_CheckCollisions
02:0003F01E 6100A7F0        	 12293:     jsr     PlayBossHitCryIfNeeded
                            	 12294:     ; Go handle the brown state specially.
                            	 12295:     ;
02:0003F022 41EC00AC        	 12296:     lea     ($00AC,A4),A0
