                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:00040000 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:00040002 7400            	   545:     moveq   #0,D2
02:00040004 41F90003FFB8    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0004000A 14303000        	   547:     move.b  (A0,D3.W),D2
02:0004000E 41F90003FFE8    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:00040014 10303000        	   549:     move.b  (A0,D3.W),D0
02:00040018 41F900047010    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004001E 11802000        	   551:     move.b  D0,(A0,D2.W)
02:00040022 5303            	   552:     subq.b  #1,D3
02:00040024 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:00040026 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:00040028 7001            	   561:     moveq   #1,D0
02:0004002A 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0004002E 7003            	   569:     moveq   #3,D0
02:00040030 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:00040034 7400            	   576:     moveq   #0,D2
02:00040036 41F90003FFB8    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0004003C 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:00040040 102C0006        	   585:     move.b  ($0006,A4),D0
02:00040044 122C0671        	   586:     move.b  ($0671,A4),D1
02:00040048 C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004004A 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0004004C 41F900047010    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040052 10302000        	   599:     move.b  (A0,D2.W),D0
02:00040056 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0004005A 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0004005C 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:00040060 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040062 41F90003FFD0    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:00040068 10303000        	   605:     move.b  (A0,D3.W),D0
02:0004006C 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0004006E 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:00040072 41F900047010    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040078 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:0004007C 5203            	   621:     addq.b  #1,D3
02:0004007E 532C0007        	   622:     subq.b  #1,($0007,A4)
02:00040082 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:00040084 122C0006        	   629:     move.b  ($0006,A4),D1
02:00040088 E309            	   630:     lsl.b  #1,D1   ; ASL $06
02:0004008A 19410006        	   631:     move.b  D1,($0006,A4)
02:0004008E 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:00040090 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:00040094 4E75            	   634:     rts
                            	   635: 
                            	   636:     even
                            	   637: ScrollWorld:
02:00040096 102C0015        	   638:     move.b  ($0015,A4),D0
                            	   639:     ; The purpose of this is to delay vertical scrolling.
                            	   640:     ; OW: once every two frames
                            	   641:     ; UW: once every four frames
                            	   642:     ; Horizontal scrolling happens every frame.
02:0004009A 02000003        	   643:     andi.b #$03,D0
02:0004009E 7600            	   644:     moveq   #0,D3
02:000400A0 162C0010        	   645:     move.b  ($0010,A4),D3
02:000400A4 6604            	   646:     bne  _anon_z05_8
02:000400A6 02000001        	   647:     andi.b #$01,D0
                            	   648: _anon_z05_8:
02:000400AA 122C00E6        	   649:     move.b  ($00E6,A4),D1
02:000400AE B001            	   650:     cmp.b   D1,D0
02:000400B0 6704            	   651:     beq.s  __far_z_05_0004
02:000400B2 600000DE        	   652:     jmp  ScrollWorldH
                            	   653: __far_z_05_0004:
02:000400B6 7008            	   654:     moveq   #8,D0
02:000400B8 122C0098        	   655:     move.b  ($0098,A4),D1
02:000400BC C200            	   656:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000400BE 6602            	   657:     bne.s  __far_z_05_0005
