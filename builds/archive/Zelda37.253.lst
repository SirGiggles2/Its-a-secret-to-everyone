                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003DC32 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003DC36 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003DC3A 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC3E 123C0080        	  9612:     move.b  #$80,D1
02:0003DC42 D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DC44 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003DC48 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003DC4C 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
