02:00030E80 19802070        	  3845:     move.b  D0,($70,A4,D2.W)
                            	  3846:     ; Set object's Y to player's Y + offset for direction.
                            	  3847:     ;
02:00030E84 102C0098        	  3848:     move.b  ($0098,A4),D0
02:00030E88 E208            	  3849:     lsr.b  #1,D0   ; LSR A
02:00030E8A E208            	  3850:     lsr.b  #1,D0   ; LSR A
02:00030E8C 6110            	  3851:     jsr     ChooseOffsetForDirectionH
02:00030E8E 122C0084        	  3852:     move.b  ($0084,A4),D1
02:00030E92 D101            	  3853:     addx.b  D1,D0   ; ADC ObjY
02:00030E94 41EC0084        	  3854:     lea     ($0084,A4),A0
