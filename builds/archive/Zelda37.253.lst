02:0003C432 122C0002        	  6343:     move.b  ($0002,A4),D1
02:0003C436 E309            	  6344:     lsl.b  #1,D1   ; ASL $02
02:0003C438 19410002        	  6345:     move.b  D1,($0002,A4)
02:0003C43C 122C0002        	  6346:     move.b  ($0002,A4),D1
02:0003C440 C200            	  6347:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C442 671E            	  6348:     beq  _L_z04_Digdogger_Move_End
02:0003C444 41EC0084        	  6349:     lea     ($0084,A4),A0
02:0003C448 10302000        	  6350:     move.b  (A0,D2.W),D0
02:0003C44C 122C0003        	  6351:     move.b  ($0003,A4),D1
02:0003C450 0A3C0010        	  6352:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C454 9101            	  6353:     subx.b  D1,D0   ; SBC $03
02:0003C456 0A3C0010        	  6354:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C45A 41EC0084        	  6355:     lea     ($0084,A4),A0
