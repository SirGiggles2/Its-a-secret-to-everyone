                            	  3805: PlaceWeaponForPlayerStateAndAnim:
                            	  3806:     ; Set player's animation counter to 1, so that it will roll over
                            	  3807:     ; as soon as possible, causing movement frame to become 0 (legs apart),
                            	  3808:     ; which is how we want to end item-use animations.
                            	  3809:     ;
                            	  3810:     ; Set player's state to $10 (wielding sword/item).
                            	  3811:     ;
