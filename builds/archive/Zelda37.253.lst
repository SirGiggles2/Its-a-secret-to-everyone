                            	  7407: _anon_z05_156:
02:00044594 101D            	  7408:     move.b  (A5)+,D0  ; PLA
                            	  7409:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7410:     ; then the player walked all the way to the edge of the play
                            	  7411:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7412:     ;
                            	  7413:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7414:     ; edge of the play area. So, set a relative position that
                            	  7415:     ; reflects that distance: $28 or -$28.
                            	  7416:     ;
                            	  7417:     ; If walking in a decreasing direction (left or up), then
                            	  7418:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7419:     ;
                            	  7420:     ; If walking in an increasing direction (right or down), then
                            	  7421:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7422:     ;
02:00044596 02000007        	  7423:     andi.b #$07,D0
02:0004459A 0C000002        	  7424:     cmpi.b  #$02,D0
