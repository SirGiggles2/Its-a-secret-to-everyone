02:000344DA EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:000344DC 41F9000342BE    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:000344E2 D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
