02:00031EF6 1940000D        	  5952:     move.b  D0,($000D,A4)
02:00031EFA 1940000E        	  5953:     move.b  D0,($000E,A4)
                            	  5954:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  5955:     ;
02:00031EFE 10343070        	  5956:     move.b  ($70,A4,D3.W),D0
02:00031F02 023C00EE        	  5957:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F06 123C0004        	  5958:     move.b  #$04,D1
02:00031F0A D101            	  5959:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031F0C 19400004        	  5960:     move.b  D0,($0004,A4)
                            	  5961:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  5962:     ;
02:00031F10 41EC0084        	  5963:     lea     ($0084,A4),A0
02:00031F14 10303000        	  5964:     move.b  (A0,D3.W),D0
02:00031F18 023C00EE        	  5965:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F1C 123C0008        	  5966:     move.b  #$08,D1
02:00031F20 D101            	  5967:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  5968: ; Params:
                            	  5969: ; A: weapon object mid Y
                            	  5970: ; X: monster object slot
                            	  5971: ; Y: weapon object slot
                            	  5972: ; [00]: weapon object slot
                            	  5973: ; [02]: monster object mid X
                            	  5974: ; [03]: monster object mid Y
                            	  5975: ; [04]: weapon object mid X
                            	  5976: ; [07]: damage points
                            	  5977: ; [09]: damage type
                            	  5978: ; [0D]: horizontal threshold
                            	  5979: ; [0E]: vertical threshold
                            	  5980: ;
