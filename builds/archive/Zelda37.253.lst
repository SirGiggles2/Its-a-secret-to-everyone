02:0003AF66 4EB90004C91C    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:0003AF6C 41EC0098        	  3459:     lea     ($0098,A4),A0
02:0003AF70 10302000        	  3460:     move.b  (A0,D2.W),D0
02:0003AF74 7600            	  3461:     moveq   #0,D3
02:0003AF76 1600            	  3462:     move.b  D0,D3
02:0003AF78 0200000C        	  3463:     andi.b #$0C,D0
02:0003AF7C 670C            	  3464:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AF7E 7002            	  3465:     moveq   #2,D0
