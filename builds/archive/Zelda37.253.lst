02:0003A1C4 610001F0        	  1495:     jsr     Gel_CheckCollisions
02:0003A1C8 41EC0405        	  1496:     lea     ($0405,A4),A0
02:0003A1CC 10302000        	  1497:     move.b  (A0,D2.W),D0
02:0003A1D0 664E            	  1498:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A1D2 41EC04F0        	  1499:     lea     ($04F0,A4),A0
02:0003A1D6 10302000        	  1500:     move.b  (A0,D2.W),D0
02:0003A1DA 6744            	  1501:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1502:     ; If vertically aligned with the square grid, then
                            	  1503:     ; use a horizontal direction mask (3).
                            	  1504:     ;
                            	  1505:     ; Keep in mind that most objects are aligned vertically when
                            	  1506:     ; the low nibble of their Y is $D.
                            	  1507:     ;
02:0003A1DC 7600            	  1508:     moveq   #0,D3
02:0003A1DE 41EC0084        	  1509:     lea     ($0084,A4),A0
02:0003A1E2 10302000        	  1510:     move.b  (A0,D2.W),D0
02:0003A1E6 0200000F        	  1511:     andi.b #$0F,D0
02:0003A1EA 0C00000D        	  1512:     cmpi.b  #$0D,D0
02:0003A1EE 6602            	  1513:     bne  _anon_z04_26
02:0003A1F0 7603            	  1514:     moveq   #3,D3
                            	  1515: _anon_z04_26:
02:0003A1F2 1883            	  1516:     move.b  D3,($0000,A4)
                            	  1517:     ; If horizontally aligned with the square grid, then
                            	  1518:     ; use a vertical direction mask ($C).
                            	  1519:     ;
02:0003A1F4 7600            	  1520:     moveq   #0,D3
02:0003A1F6 10342070        	  1521:     move.b  ($70,A4,D2.W),D0
02:0003A1FA 0200000F        	  1522:     andi.b #$0F,D0
02:0003A1FE 6602            	  1523:     bne  _anon_z04_27
02:0003A200 760C            	  1524:     moveq   #12,D3
                            	  1525: _anon_z04_27:
02:0003A202 1003            	  1526:     move.b  D3,D0
                            	  1527:     ; Combine the two masks. At most one will be 0.
                            	  1528:     ;
02:0003A204 1214            	  1529:     move.b  ($0000,A4),D1
02:0003A206 8001            	  1530:     or.b  D1,D0
                            	  1531:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1532:     ; with the grid.
                            	  1533:     ;
                            	  1534:     ; If so, then go to state 1 to do a "big shove".
                            	  1535:     ; Else go to state 2, to immediately split in two.
                            	  1536:     ;
                            	  1537:     ; Examples:
                            	  1538:     ; It would be aligned, if moving left along a tile as usual.
                            	  1539:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1540:     ; - The collision check routines would have made the zol
                            	  1541:     ;   face in the direction of the weapon.
                            	  1542:     ; - See CheckMonsterWeaponCollision.
                            	  1543:     ;
02:0003A208 122C0098        	  1544:     move.b  ($0098,A4),D1
02:0003A20C C001            	  1545:     and.b  D1,D0
02:0003A20E 6608            	  1546:     bne  _anon_z04_28
02:0003A210 41EC00AC        	  1547:     lea     ($00AC,A4),A0
02:0003A214 52302000        	  1548:     addq.b  #1,(A0,D2.W)
                            	  1549: _anon_z04_28:
