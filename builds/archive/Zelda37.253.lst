02:0003644A 123C0010        	  4759:     move.b  #$10,D1
02:0003644E 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036452 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00036454 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
