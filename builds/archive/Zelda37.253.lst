02:0003CEAE 123C0030        	  7800:     move.b  #$30,D1
02:0003CEB2 D101            	  7801:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003CEB4 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003CEB8 11802000        	  7803:     move.b  D0,(A0,D2.W)
                            	  7804:     ; Align the monster with a square horizontally.
                            	  7805:     ;
