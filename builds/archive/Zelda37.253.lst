                            	   707: ;------------------------------------------------------------------------------
                            	   708: ; _c_move_object_shim — MoveObject trampoline.
                            	   709: ;
                            	   710: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   711: ;   Input:     D2 = slot (0..11)
                            	   712: ;   Preserves: D2, A4, A5
                            	   713: ;   Clobbers:  D0, D1, D3, A0
                            	   714: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   715: ;
                            	   716: ; GCC side:
                            	   717: ;   void c_move_object(unsigned short slot);
                            	   718: ;     slot arrives as a 16-bit value on the stack.
                            	   719: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   720: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   721: ;   never clobbered by gcc.
                            	   722: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   723: ;   semantics can exist in a pure C port).
                            	   724: ;------------------------------------------------------------------------------
                            	   725: _c_move_object_shim:
                            	   726:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   727:     move.b  #$AA,($0900,A4)
                            	   728:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   729:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   730:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   731:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   732:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   733:     moveq   #0,D0
02:0002B658 3002            	   734:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   735:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   736:     jsr     c_move_object
02:0002B662 588F            	   737:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   738:     rts
                            	   739: 
                            	   740: ;==============================================================================
                            	   741: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   742: ; and tail-call the native asm function.
                            	   743: ;
                            	   744: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   745: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   746: ; sign-extended).
                            	   747: ;==============================================================================
                            	   748: 
                            	   749: ;------------------------------------------------------------------------------
                            	   750: ; void c_copy_bank_to_window(unsigned int bank);
                            	   751: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   752: ;------------------------------------------------------------------------------
                            	   753: c_copy_bank_to_window:
02:0002B666 202F0004        	   754:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   755:     jmp     _copy_bank_to_window
                            	   756: 
                            	   757: ;------------------------------------------------------------------------------
                            	   758: ; unsigned char c_ppu_read_2(void);
                            	   759: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   760: ; C return: gcc expects result in D0.
                            	   761: ;------------------------------------------------------------------------------
                            	   762: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   763:     jmp     _ppu_read_2
                            	   764: 
                            	   765: ;------------------------------------------------------------------------------
                            	   766: ; void c_ppu_write_6(unsigned int val);
                            	   767: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   768: ;------------------------------------------------------------------------------
                            	   769: c_ppu_write_6:
02:0002B674 202F0004        	   770:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   771:     jmp     _ppu_write_6
                            	   772: 
                            	   773: ;------------------------------------------------------------------------------
                            	   774: ; void c_ppu_write_7(unsigned int val);
                            	   775: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   776: ;------------------------------------------------------------------------------
                            	   777: c_ppu_write_7:
02:0002B67E 202F0004        	   778:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   779:     jmp     _ppu_write_7
                            	   780: 
