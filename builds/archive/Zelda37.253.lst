                            	  5885: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  5886:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  5887:     ;   full heart=4 partial heart=$70
                            	  5888:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  5889:     ; But the method here yields $3EF, because partial heart is
                            	  5890:     ; considered full when = $FF instead of $100.
                            	  5891:     ;
02:00031E84 102C000E        	  5892:     move.b  ($000E,A4),D0
02:00031E88 003C0011        	  5893:     ori     #$11,CCR  ; SEC: set C+X
02:00031E8C 122C0670        	  5894:     move.b  ($0670,A4),D1
02:00031E90 0A3C0010        	  5895:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E94 9101            	  5896:     subx.b  D1,D0   ; SBC HeartPartial
02:00031E96 0A3C0010        	  5897:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E9A 1940000E        	  5898:     move.b  D0,($000E,A4)
02:00031E9E 102C066F        	  5899:     move.b  ($066F,A4),D0
02:00031EA2 0200000F        	  5900:     andi.b #$0F,D0
02:00031EA6 6710            	  5901:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031EA8 532C066F        	  5902:     subq.b  #1,($066F,A4)
02:00031EAC 103C00FF        	  5903:     move.b  #$FF,D0
02:00031EB0 19400670        	  5904:     move.b  D0,($0670,A4)
02:00031EB4 6600FF6E        	  5905:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  5906:     even
                            	  5907: _L_z01_Link_BeHarmed_HandleDied:
                            	  5908:     ; Link died.
                            	  5909:     ;
                            	  5910:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  5911:     ; Make Link face down.
                            	  5912:     ; Go to mode $11.
                            	  5913:     ;
02:00031EB8 102C066F        	  5914:     move.b  ($066F,A4),D0
02:00031EBC 020000F0        	  5915:     andi.b #$F0,D0
02:00031EC0 1940066F        	  5916:     move.b  D0,($066F,A4)
02:00031EC4 4EB90004AEC6    	  5917:     jsr     EndGameMode
02:00031ECA 19400670        	  5918:     move.b  D0,($0670,A4)
02:00031ECE 194000AC        	  5919:     move.b  D0,($00AC,A4)
02:00031ED2 7011            	  5920:     moveq   #17,D0
02:00031ED4 19400012        	  5921:     move.b  D0,($0012,A4)
