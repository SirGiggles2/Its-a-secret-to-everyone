02:0003F004 11802000        	 12277:     move.b  D0,(A0,D2.W)
02:0003F008 600002EC        	 12278:     jmp     Ganon_DrawBody
                            	 12279: 
                            	 12280: ; Description:
                            	 12281: ; Fighting Ganon.
