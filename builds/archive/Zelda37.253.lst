02:000322F0 10343070        	  6621:     move.b  ($70,A4,D3.W),D0
02:000322F4 023C00EE        	  6622:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322F8 123C0008        	  6623:     move.b  #$08,D1
02:000322FC D101            	  6624:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000322FE 19400004        	  6625:     move.b  D0,($0004,A4)
02:00032302 41EC0084        	  6626:     lea     ($0084,A4),A0
02:00032306 10303000        	  6627:     move.b  (A0,D3.W),D0
02:0003230A 023C00EE        	  6628:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003230E 123C0006        	  6629:     move.b  #$06,D1
