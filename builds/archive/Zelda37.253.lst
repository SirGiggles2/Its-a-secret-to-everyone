02:000322CE 023C00EE        	  6602:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322D2 123C0006        	  6603:     move.b  #$06,D1
02:000322D6 D101            	  6604:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:000322D8 19400004        	  6605:     move.b  D0,($0004,A4)
02:000322DC 41EC0084        	  6606:     lea     ($0084,A4),A0
02:000322E0 10303000        	  6607:     move.b  (A0,D3.W),D0
02:000322E4 023C00EE        	  6608:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322E8 123C0008        	  6609:     move.b  #$08,D1
02:000322EC D101            	  6610:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
