                            	  5007: SpreadShot:
                            	  5008:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5009:     ;
                            	  5010:     ; The shot is spreading out.
                            	  5011:     ;
                            	  5012:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5013:     ; These will be negated appropriately for each corner.
                            	  5014:     ;
02:0004BC12 41EC0098        	  5015:     lea     ($0098,A4),A0
02:0004BC16 10302000        	  5016:     move.b  (A0,D2.W),D0
02:0004BC1A 19400002        	  5017:     move.b  D0,($0002,A4)
02:0004BC1E 19400003        	  5018:     move.b  D0,($0003,A4)
                            	  5019:     ; Reset [0F] to not flip horizontally.
                            	  5020:     ;
02:0004BC22 7000            	  5021:     moveq   #0,D0
02:0004BC24 1940000F        	  5022:     move.b  D0,($000F,A4)
                            	  5023:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5024:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5025:     ;
02:0004BC28 7603            	  5026:     moveq   #3,D3
                            	  5027:     even
                            	  5028: _L_z07_SpreadShot_DrawShotCorner:
02:0004BC2A 1003            	  5029:     move.b  D3,D0
02:0004BC2C 1B00            	  5030:     move.b  D0,-(A5)  ; PHA
                            	  5031:     ; Save offset X [02] and Y offset [03].
                            	  5032:     ;
02:0004BC2E 102C0002        	  5033:     move.b  ($0002,A4),D0
02:0004BC32 1B00            	  5034:     move.b  D0,-(A5)  ; PHA
02:0004BC34 102C0003        	  5035:     move.b  ($0003,A4),D0
02:0004BC38 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
                            	  5037:     ; Calculate and set sprite attributes for this corner:
                            	  5038:     ;   base attribute OR (frame counter AND 3)
                            	  5039:     ;
                            	  5040:     ; The base attribute defines how to flip the sprite.
                            	  5041:     ; The frame counter makes the shot flash by cycling each
                            	  5042:     ; palette row.
                            	  5043:     ;
02:0004BC3A 102C0015        	  5044:     move.b  ($0015,A4),D0
02:0004BC3E 02000003        	  5045:     andi.b #$03,D0
02:0004BC42 41F90004BAA0    	  5046:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004BC48 12303000        	  5047:     move.b  (A0,D3.W),D1
02:0004BC4C 8001            	  5048:     or.b  D1,D0
02:0004BC4E 4EB900031ABC    	  5049:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5050:     ; Add the object's X (the center of the spread) and the
                            	  5051:     ; current offset in [02] to set sprite X in [00].
                            	  5052:     ;
02:0004BC54 10342070        	  5053:     move.b  ($70,A4,D2.W),D0
02:0004BC58 023C00EE        	  5054:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BC5C 122C0002        	  5055:     move.b  ($0002,A4),D1
02:0004BC60 D101            	  5056:     addx.b  D1,D0   ; ADC $02
02:0004BC62 1880            	  5057:     move.b  D0,($0000,A4)
                            	  5058:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5059:     ; Else calculate the distance from object X to sprite X.
                            	  5060:     ;
02:0004BC64 12342070        	  5061:     move.b  ($70,A4,D2.W),D1
02:0004BC68 B001            	  5062:     cmp.b   D1,D0
02:0004BC6A 651A            	  5063:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004BC6C 0C0000FC        	  5064:     cmpi.b  #$FC,D0
02:0004BC70 6466            	  5065:     bcc  _L_z07_SpreadShot_NextCorner
02:0004BC72 003C0011        	  5066:     ori     #$11,CCR  ; SEC: set C+X
02:0004BC76 12342070        	  5067:     move.b  ($70,A4,D2.W),D1
02:0004BC7A 0A3C0010        	  5068:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BC7E 9101            	  5069:     subx.b  D1,D0   ; SBC ObjX,X
02:0004BC80 0A3C0010        	  5070:     eori    #$10,CCR  ; restore X = 6502 C
02:0004BC84 6014            	  5071:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5072: 
                            	  5073:     even
                            	  5074: _L_z07_SpreadShot_ReverseSub:
02:0004BC86 10342070        	  5075:     move.b  ($70,A4,D2.W),D0
02:0004BC8A 003C0011        	  5076:     ori     #$11,CCR  ; SEC: set C+X
02:0004BC8E 1214            	  5077:     move.b  ($0000,A4),D1
02:0004BC90 0A3C0010        	  5078:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BC94 9101            	  5079:     subx.b  D1,D0   ; SBC $00
02:0004BC96 0A3C0010        	  5080:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5081:     even
                            	  5082: _L_z07_SpreadShot_CheckDistance:
                            	  5083:     ; If distance >= $20, skip this corner.
                            	  5084:     ;
02:0004BC9A 0C000020        	  5085:     cmpi.b  #$20,D0
02:0004BC9E 6438            	  5086:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5087:     ; Add the object's Y (the center of the spread) and the
                            	  5088:     ; current offset in [03] to set sprite Y in [01].
                            	  5089:     ;
02:0004BCA0 41EC0084        	  5090:     lea     ($0084,A4),A0
02:0004BCA4 10302000        	  5091:     move.b  (A0,D2.W),D0
02:0004BCA8 023C00EE        	  5092:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BCAC 122C0003        	  5093:     move.b  ($0003,A4),D1
02:0004BCB0 D101            	  5094:     addx.b  D1,D0   ; ADC $03
02:0004BCB2 19400001        	  5095:     move.b  D0,($0001,A4)
                            	  5096:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5097:     ;
02:0004BCB6 7600            	  5098:     moveq   #0,D3
02:0004BCB8 162C0010        	  5099:     move.b  ($0010,A4),D3
02:0004BCBC 670C            	  5100:     beq  _L_z07_SpreadShot_Draw
02:0004BCBE 0C00003E        	  5101:     cmpi.b  #$3E,D0
02:0004BCC2 6514            	  5102:     bcs  _L_z07_SpreadShot_NextCorner
02:0004BCC4 0C0000E8        	  5103:     cmpi.b  #$E8,D0
02:0004BCC8 640E            	  5104:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5105:     even
                            	  5106: _L_z07_SpreadShot_Draw:
                            	  5107:     ; Draw the corner.
                            	  5108:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5109:     ;
02:0004BCCA 7002            	  5110:     moveq   #2,D0
02:0004BCCC 1940000C        	  5111:     move.b  D0,($000C,A4)
02:0004BCD0 7623            	  5112:     moveq   #35,D3
02:0004BCD2 4EB9000319DC    	  5113:     jsr     Anim_WriteItemSprites
                            	  5114:     even
                            	  5115: _L_z07_SpreadShot_NextCorner:
                            	  5116:     ; Prepare to process the next corner.
                            	  5117:     ;
                            	  5118:     ; First, restore X offset [02] and Y offset [03].
                            	  5119:     ;
02:0004BCD8 101D            	  5120:     move.b  (A5)+,D0  ; PLA
02:0004BCDA 19400003        	  5121:     move.b  D0,($0003,A4)
02:0004BCDE 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004BCE0 19400002        	  5123:     move.b  D0,($0002,A4)
                            	  5124:     ; Take turns negating X offset or Y offset for the next round.
                            	  5125:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5126:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5127:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5128:     ; - Fourth turn: doesn't matter
                            	  5129:     ;
                            	  5130:     ;
                            	  5131:     ; Get the loop index.
02:0004BCE4 101D            	  5132:     move.b  (A5)+,D0  ; PLA
02:0004BCE6 1B00            	  5133:     move.b  D0,-(A5)  ; PHA
02:0004BCE8 7600            	  5134:     moveq   #0,D3
02:0004BCEA 1600            	  5135:     move.b  D0,D3
