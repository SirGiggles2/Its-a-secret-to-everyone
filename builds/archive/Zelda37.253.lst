02:0003C1F6 41EC0084        	  6083:     lea     ($0084,A4),A0
02:0003C1FA 11802000        	  6084:     move.b  D0,(A0,D2.W)
02:0003C1FE 101D            	  6085:     move.b  (A5)+,D0  ; PLA
02:0003C200 19802070        	  6086:     move.b  D0,($70,A4,D2.W)
