                            	   250: _L_z01_InitCave_TakeType:
                            	   251:     ; Else the cave/person simply does:
                            	   252:     ; - taken:     no person, no text
                            	   253:     ; - not taken: show a person and text
                            	   254:     ;
                            	   255:     ; So, if the item was not taken, then go set up the text.
                            	   256:     ;
02:0002E62C 61002B42        	   257:     jsr     GetRoomFlagUWItemState
02:0002E630 6602            	   258:     bne.s  __far_z_01_0001
02:0002E632 600A            	   259:     jmp  InitCaveContinue
                            	   260: __far_z_01_0001:
                            	   261:     ; Otherwise destroy the person object, and let Link continue.
