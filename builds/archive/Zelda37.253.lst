                            	  2132: UpdateZora:
                            	  2133:     ; If we have the magic clock, then return.
                            	  2134:     ;
02:0003A608 102C066C        	  2135:     move.b  ($066C,A4),D0
02:0003A60C 6702            	  2136:     beq.s  __far_z_04_0017
