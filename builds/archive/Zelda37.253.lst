02:0002BFB0 003C0001        	  2271:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2272:     eori    #$01,CCR
02:0002BFB8 4E75            	  2273:     rts
                            	  2274: .cc_cnras:
02:0002BFBA 023C00FE        	  2275:     andi    #$FE,CCR
