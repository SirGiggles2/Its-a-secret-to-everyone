02:00030EF0 41EC0394        	  3934:     lea     ($0394,A4),A0
02:00030EF4 11802000        	  3935:     move.b  D0,(A0,D2.W)
02:00030EF8 41EC03A8        	  3936:     lea     ($03A8,A4),A0
02:00030EFC 11802000        	  3937:     move.b  D0,(A0,D2.W)
02:00030F00 7020            	  3938:     moveq   #32,D0
02:00030F02 41EC03BC        	  3939:     lea     ($03BC,A4),A0
02:00030F06 11802000        	  3940:     move.b  D0,(A0,D2.W)
