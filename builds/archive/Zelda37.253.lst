                            	  3601: 
                            	  3602: ; Params:
                            	  3603: ; Y: middle speed index (4)
                            	  3604: ; [03]: horizontal distance
                            	  3605: ; [04]: vertical distance
                            	  3606: ; [0A]: vertical direction
                            	  3607: ; [0B]: horizontal direction
                            	  3608: ;
                            	  3609: ; Returns:
                            	  3610: ; Y: speed index (0 to 8) for the angle
                            	  3611: ;
                            	  3612: ;
                            	  3613: ; TODO: call it speed index or angle?
                            	  3614: ; Store the middle speed index in [00]. It will be changed to the
                            	  3615: ; right speed index to use incrementally.
                            	  3616: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  3617: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  3618: ;
                            	  3619:     even
                            	  3620: _CalcDiagonalSpeedIndex:
02:00030D18 1883            	  3621:     move.b  D3,($0000,A4)
                            	  3622:     ; Assuming horizontal distance >= vertical distance, the
                            	  3623:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  3624:     ;
02:00030D1A 103C00FF        	  3625:     move.b  #$FF,D0
02:00030D1E 19400001        	  3626:     move.b  D0,($0001,A4)
                            	  3627:     ; TODO:
                            	  3628:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  3629:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  3630:     ;
                            	  3631:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  3632:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  3633:     ; of the farther distance faster.
                            	  3634:     ;
02:00030D22 102C0003        	  3635:     move.b  ($0003,A4),D0
02:00030D26 122C0004        	  3636:     move.b  ($0004,A4),D1
02:00030D2A B001            	  3637:     cmp.b   D1,D0
02:00030D2C 6416            	  3638:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030D2E 1B00            	  3639:     move.b  D0,-(A5)  ; PHA
02:00030D30 102C0004        	  3640:     move.b  ($0004,A4),D0
02:00030D34 19400003        	  3641:     move.b  D0,($0003,A4)
02:00030D38 101D            	  3642:     move.b  (A5)+,D0  ; PLA
02:00030D3A 19400004        	  3643:     move.b  D0,($0004,A4)
02:00030D3E 7001            	  3644:     moveq   #1,D0
02:00030D40 19400001        	  3645:     move.b  D0,($0001,A4)
                            	  3646:     even
                            	  3647: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  3648:     ; TODO: call it speed index or angle?
                            	  3649:     ; If the difference in distances is within 8 pixels,
                            	  3650:     ; return the speed index (angle) we have.
                            	  3651:     ;
02:00030D44 102C0003        	  3652:     move.b  ($0003,A4),D0
02:00030D48 003C0011        	  3653:     ori     #$11,CCR  ; SEC: set C+X
02:00030D4C 122C0004        	  3654:     move.b  ($0004,A4),D1
02:00030D50 0A3C0010        	  3655:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030D54 9101            	  3656:     subx.b  D1,D0   ; SBC $04
02:00030D56 0A3C0010        	  3657:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D5A 0C000008        	  3658:     cmpi.b  #$08,D0
02:00030D5E 6538            	  3659:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3660:     even
                            	  3661: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  3662:     ; TODO: call it speed index or angle?
                            	  3663:     ; Otherwise, go to the next speed index (angle).
                            	  3664:     ;
02:00030D60 1014            	  3665:     move.b  ($0000,A4),D0
02:00030D62 023C00EE        	  3666:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D66 122C0001        	  3667:     move.b  ($0001,A4),D1
02:00030D6A D101            	  3668:     addx.b  D1,D0   ; ADC $01
02:00030D6C 1880            	  3669:     move.b  D0,($0000,A4)
                            	  3670:     ; TODO: call it speed index or angle?
                            	  3671:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  3672:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  3673:     ;
02:00030D6E 6728            	  3674:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030D70 0C000008        	  3675:     cmpi.b  #$08,D0
02:00030D74 6722            	  3676:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3677:     ; Subtract the lesser distance from the greater distance.
                            	  3678:     ; If they still haven't crossed, then we can turn more.
                            	  3679:     ;
02:00030D76 102C0003        	  3680:     move.b  ($0003,A4),D0
02:00030D7A 003C0011        	  3681:     ori     #$11,CCR  ; SEC: set C+X
02:00030D7E 122C0004        	  3682:     move.b  ($0004,A4),D1
02:00030D82 0A3C0010        	  3683:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030D86 9101            	  3684:     subx.b  D1,D0   ; SBC $04
02:00030D88 0A3C0010        	  3685:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D8C 19400003        	  3686:     move.b  D0,($0003,A4)
02:00030D90 122C0004        	  3687:     move.b  ($0004,A4),D1
02:00030D94 B001            	  3688:     cmp.b   D1,D0
02:00030D96 64C8            	  3689:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  3690:     even
                            	  3691: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  3692:     ; TODO: call it speed index or angle?
                            	  3693:     ; Return the speed index (angle) we found.
                            	  3694:     ;
02:00030D98 7600            	  3695:     moveq   #0,D3
02:00030D9A 1614            	  3696:     move.b  ($0000,A4),D3
02:00030D9C 4E75            	  3697:     rts
