                            	  7807:     ; If in the right half, align with the next square.
                            	  7808:     ;
02:0003CEBC 10342070        	  7809:     move.b  ($70,A4,D2.W),D0
02:0003CEC0 023C00EE        	  7810:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEC4 123C0008        	  7811:     move.b  #$08,D1
02:0003CEC8 D101            	  7812:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CECA 020000F0        	  7813:     andi.b #$F0,D0
02:0003CECE 19802070        	  7814:     move.b  D0,($70,A4,D2.W)
                            	  7815:     ; Align the monster with a square vertically.
                            	  7816:     ;
                            	  7817:     ; If in the top half of a square, align with that square.
                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003CED2 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003CED6 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003CEDA 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEDE 123C0008        	  7823:     move.b  #$08,D1
02:0003CEE2 D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CEE4 020000F0        	  7825:     andi.b #$F0,D0
                            	  7826:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7827:     ;
