02:00032328 0C02000D        	  6687:     cmpi.b  #$0D,D2
02:0003232C 6412            	  6688:     bcc  _anon_z01_99
02:0003232E 41EC04B2        	  6689:     lea     ($04B2,A4),A0
02:00032332 10302000        	  6690:     move.b  (A0,D2.W),D0
02:00032336 122C0009        	  6691:     move.b  ($0009,A4),D1
02:0003233A C001            	  6692:     and.b  D1,D0
02:0003233C 660000C4        	  6693:     bne  _L_z01_BeginShove_Exit
                            	  6694: _anon_z01_99:
                            	  6695:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  6696:     ; if he is defending. The goal is to push Link away from the monster.
                            	  6697:     ;
                            	  6698:     ; If instead a monster is defending, then all this calculation
                            	  6699:     ; won't matter, because the shove direction will be set to the
                            	  6700:     ; weapon's direction.
                            	  6701:     ;
                            	  6702:     ; As such, calculate a direction from the monster to the defender,
                            	  6703:     ; assuming it's Link.
                            	  6704:     ;
                            	  6705:     ; Start with an assumption that the direction is vertical:
                            	  6706:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  6707:     ;
02:00032340 7008            	  6708:     moveq   #8,D0
02:00032342 19400008        	  6709:     move.b  D0,($0008,A4)
02:00032346 41EC0084        	  6710:     lea     ($0084,A4),A0
02:0003234A 10302000        	  6711:     move.b  (A0,D2.W),D0
02:0003234E 19400004        	  6712:     move.b  D0,($0004,A4)
02:00032352 41EC0084        	  6713:     lea     ($0084,A4),A0
02:00032356 10303000        	  6714:     move.b  (A0,D3.W),D0
02:0003235A 19400005        	  6715:     move.b  D0,($0005,A4)
                            	  6716:     ; If the defender is Link and his grid offset <> 0 then
                            	  6717:     ; use his usual object direction variable to determine
                            	  6718:     ; which axis to check.
                            	  6719:     ;
02:0003235E 4A03            	  6720:     cmpi.b  #$00,D3
02:00032360 6612            	  6721:     bne  _anon_z01_100
02:00032362 102C0394        	  6722:     move.b  ($0394,A4),D0
02:00032366 670C            	  6723:     beq  _anon_z01_100
02:00032368 102C0098        	  6724:     move.b  ($0098,A4),D0
02:0003236C 02000003        	  6725:     andi.b #$03,D0
02:00032370 660C            	  6726:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032372 6720            	  6727:     beq  _L_z01_BeginShove_CheckVertical
                            	  6728: _anon_z01_100:
                            	  6729:     ; For monsters defending, or Link with grid offset = 0,
                            	  6730:     ; check direction in [0B].
                            	  6731:     ;
                            	  6732:     ; For monsters defending, this won't matter. For Link with grid
                            	  6733:     ; offset = 0, I believe the result will be arbitrary.
                            	  6734:     ;
                            	  6735:     ; TODO:
                            	  6736:     ; Is [0B] always set if Link's grid offset = 0?
                            	  6737:     ; It doesn't seem to be if candle fire attacks him.
                            	  6738:     ;
02:00032374 102C000B        	  6739:     move.b  ($000B,A4),D0
02:00032378 0C000004        	  6740:     cmpi.b  #$04,D0
02:0003237C 6416            	  6741:     bcc  _L_z01_BeginShove_CheckVertical
                            	  6742:     even
                            	  6743: _L_z01_BeginShove_CheckHorizontal:
                            	  6744:     ; If the direction checked is left or right,
                            	  6745:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  6746:     ;
02:0003237E 7002            	  6747:     moveq   #2,D0
02:00032380 19400008        	  6748:     move.b  D0,($0008,A4)
02:00032384 10342070        	  6749:     move.b  ($70,A4,D2.W),D0
02:00032388 19400004        	  6750:     move.b  D0,($0004,A4)
02:0003238C 10343070        	  6751:     move.b  ($70,A4,D3.W),D0
02:00032390 19400005        	  6752:     move.b  D0,($0005,A4)
                            	  6753:     even
                            	  6754: _L_z01_BeginShove_CheckVertical:
                            	  6755:     ; If the monster is down or right of the other object,
                            	  6756:     ; then use the opposite direction already in [08].
                            	  6757:     ; Else shift [08] right to turn it into the opposite
                            	  6758:     ; direction up or down.
                            	  6759:     ;
                            	  6760:     ; Again assuming Link is the defender; after this, [08] points
                            	  6761:     ; Link away from the monster.
                            	  6762:     ;
02:00032394 102C0004        	  6763:     move.b  ($0004,A4),D0
02:00032398 122C0005        	  6764:     move.b  ($0005,A4),D1
02:0003239C B001            	  6765:     cmp.b   D1,D0
02:0003239E 640A            	  6766:     bcc  _anon_z01_101
02:000323A0 122C0008        	  6767:     move.b  ($0008,A4),D1
02:000323A4 E209            	  6768:     lsr.b  #1,D1   ; LSR $08
02:000323A6 19410008        	  6769:     move.b  D1,($0008,A4)
                            	  6770: _anon_z01_101:
                            	  6771:     ; If a monster is the defender, go handle it separately.
                            	  6772:     ;
02:000323AA 4A03            	  6773:     cmpi.b  #$00,D3
02:000323AC 6656            	  6774:     bne  _L_z01_BeginShove_MonsterDefender
                            	  6775:     ; Link is the defender.
                            	  6776:     ;
                            	  6777:     ; If Link is invincible, return without shoving.
                            	  6778:     ;
02:000323AE 102C04F0        	  6779:     move.b  ($04F0,A4),D0
02:000323B2 664E            	  6780:     bne  _L_z01_BeginShove_Exit
                            	  6781:     ; Store the shove direction we determined.
                            	  6782:     ;
                            	  6783:     ; Turn on the high bit to indicate that the next time we try to
                            	  6784:     ; move by shoving, it will be the first time for this shove action.
                            	  6785:     ;
02:000323B4 102C0008        	  6786:     move.b  ($0008,A4),D0
02:000323B8 00000080        	  6787:     ori.b #$80,D0
02:000323BC 194000C0        	  6788:     move.b  D0,($00C0,A4)
                            	  6789:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  6790:     ;
02:000323C0 7018            	  6791:     moveq   #24,D0
02:000323C2 194004F0        	  6792:     move.b  D0,($04F0,A4)
02:000323C6 7020            	  6793:     moveq   #32,D0
02:000323C8 194000D3        	  6794:     move.b  D0,($00D3,A4)
                            	  6795:     ; If Link was shoved by one of his own weapons, then
                            	  6796:     ; nothing else to do. Return.
                            	  6797:     ;
02:000323CC 0C02000D        	  6798:     cmpi.b  #$0D,D2
02:000323D0 6430            	  6799:     bcc  _L_z01_BeginShove_Exit
                            	  6800:     ; Link was shoved by a monster.
                            	  6801:     ;
                            	  6802:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  6803:     ; then return.
                            	  6804:     ;
02:000323D2 41EC04BF        	  6805:     lea     ($04BF,A4),A0
02:000323D6 10302000        	  6806:     move.b  (A0,D2.W),D0
02:000323DA 02000080        	  6807:     andi.b #$80,D0
02:000323DE 6622            	  6808:     bne  _L_z01_BeginShove_Exit
                            	  6809:     ; If the attacker is a vire, then return.
                            	  6810:     ;
02:000323E0 41EC034F        	  6811:     lea     ($034F,A4),A0
02:000323E4 10302000        	  6812:     move.b  (A0,D2.W),D0
02:000323E8 0C000012        	  6813:     cmpi.b  #$12,D0
02:000323EC 6714            	  6814:     beq  _L_z01_BeginShove_Exit
                            	  6815:     ; Turn the attacker in the opposite direction.
                            	  6816:     ;
02:000323EE 41EC0098        	  6817:     lea     ($0098,A4),A0
02:000323F2 10302000        	  6818:     move.b  (A0,D2.W),D0
02:000323F6 6100E87A        	  6819:     jsr     GetOppositeDir
02:000323FA 41EC0098        	  6820:     lea     ($0098,A4),A0
02:000323FE 11802000        	  6821:     move.b  D0,(A0,D2.W)
                            	  6822:     even
                            	  6823: _L_z01_BeginShove_Exit:
02:00032402 4E75            	  6824:     rts
                            	  6825: 
