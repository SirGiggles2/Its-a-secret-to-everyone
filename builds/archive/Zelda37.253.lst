02:0003A3FC 7601            	  1829:     moveq   #1,D3
                            	  1830: _anon_z04_30:
02:0003A3FE 41F90003A3D0    	  1831:     lea     (StatueRoomLayouts).l,A0
02:0003A404 12303000        	  1832:     move.b  (A0,D3.W),D1
02:0003A408 B001            	  1833:     cmp.b   D1,D0
02:0003A40A 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
02:0003A40C 5303            	  1835:     subq.b  #1,D3
02:0003A40E 6AEE            	  1836:     bpl  _anon_z04_30
02:0003A410 0A3C0001        	  1837:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
