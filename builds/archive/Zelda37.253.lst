                            	  3645: InitArmosOrFlyingGhini:
                            	  3646:     ; In UpdateObject, this object was flagged "initialized".
                            	  3647:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3648:     ;
02:0003B094 10342028        	  3649:     move.b  ($28,A4,D2.W),D0
02:0003B098 41EC0492        	  3650:     lea     ($0492,A4),A0
02:0003B09C 11802000        	  3651:     move.b  D0,(A0,D2.W)
                            	  3652:     ; If it's still fading in, then go finish some initialization needed
                            	  3653:     ; for fading in.
                            	  3654:     ;
02:0003B0A0 660000B6        	  3655:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3656:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3657:     ; go finish initializing it.
                            	  3658:     ;
02:0003B0A4 41EC034F        	  3659:     lea     ($034F,A4),A0
02:0003B0A8 10302000        	  3660:     move.b  (A0,D2.W),D0
02:0003B0AC 0C000022        	  3661:     cmpi.b  #$22,D0
02:0003B0B0 670000A6        	  3662:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3663:     ; Else we have an armos.
                            	  3664:     ;
                            	  3665:     ; Store stairs tile $70 in [00] for use later.
                            	  3666:     ;
02:0003B0B4 7070            	  3667:     moveq   #112,D0
02:0003B0B6 1880            	  3668:     move.b  D0,($0000,A4)
                            	  3669:     ; Look for the current room ID in an array of room ID's that
                            	  3670:     ; have armos secrets.
                            	  3671:     ;
02:0003B0B8 7606            	  3672:     moveq   #6,D3
                            	  3673:     even
                            	  3674: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B0BA 102C00EB        	  3675:     move.b  ($00EB,A4),D0
                            	  3676:     ; If this element does not match the current room ID, go loop again.
                            	  3677:     ;
02:0003B0BE 41F90003B084    	  3678:     lea     (SecretArmosRoomIds).l,A0
02:0003B0C4 12303000        	  3679:     move.b  (A0,D3.W),D1
02:0003B0C8 B001            	  3680:     cmp.b   D1,D0
02:0003B0CA 6648            	  3681:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3682:     ; The secret (usually stairs) is under one of the armoses.
                            	  3683:     ;
                            	  3684:     ; If the armos's X coordinate does not match the one needed
                            	  3685:     ; for the current room in the list, then go loop again.
                            	  3686:     ;
02:0003B0CC 10342070        	  3687:     move.b  ($70,A4,D2.W),D0
02:0003B0D0 41F90003B08C    	  3688:     lea     (SecretArmosXs).l,A0
02:0003B0D6 12303000        	  3689:     move.b  (A0,D3.W),D1
02:0003B0DA B001            	  3690:     cmp.b   D1,D0
02:0003B0DC 6636            	  3691:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3692:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3693:     ;
02:0003B0DE 41EC0084        	  3694:     lea     ($0084,A4),A0
02:0003B0E2 10302000        	  3695:     move.b  (A0,D2.W),D0
02:0003B0E6 0C000080        	  3696:     cmpi.b  #$80,D0
02:0003B0EA 6628            	  3697:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3698:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3699:     ;
02:0003B0EC 4A03            	  3700:     cmpi.b  #$00,D3
02:0003B0EE 662C            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3702:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3703:     ; has the power bracelet.
                            	  3704:     ;
                            	  3705:     ; Set up the room item with the armos's coordinates.
                            	  3706:     ;
02:0003B0F0 19400097        	  3707:     move.b  D0,($0097,A4)
02:0003B0F4 10342070        	  3708:     move.b  ($70,A4,D2.W),D0
02:0003B0F8 19400083        	  3709:     move.b  D0,($0083,A4)
                            	  3710:     ; This resets the room item's state, which activates it.
                            	  3711:     ;
02:0003B0FC 194300BF        	  3712:     move.b  D3,($00BF,A4)
                            	  3713:     ; Set the room item ID.
                            	  3714:     ;
02:0003B100 7014            	  3715:     moveq   #20,D0
02:0003B102 194000AB        	  3716:     move.b  D0,($00AB,A4)
                            	  3717:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3718:     ;
                            	  3719:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3720:     ;
                            	  3721:     ; Note that, if the item was already taken, then the room item
                            	  3722:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3723:     ; it will be ignored, because that routine checks whether
                            	  3724:     ; the item was taken.
                            	  3725:     ;
02:0003B106 4EB900031170    	  3726:     jsr     GetRoomFlagUWItemState
02:0003B10C 660A            	  3727:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B10E 6100069E        	  3728:     jsr     PlaySecretFoundTune
02:0003B112 6604            	  3729:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3730:     even
                            	  3731: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3732:     ; Bottom of the loop.
                            	  3733:     ;
02:0003B114 5303            	  3734:     subq.b  #1,D3
02:0003B116 6AA2            	  3735:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3736:     even
                            	  3737: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3738:     ; Not found, or found the power bracelet.
                            	  3739:     ; Use a floor tile $26 to replace the armos.
                            	  3740:     ;
02:0003B118 7026            	  3741:     moveq   #38,D0
02:0003B11A 1880            	  3742:     move.b  D0,($0000,A4)
                            	  3743:     even
                            	  3744: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B11C 1014            	  3745:     move.b  ($0000,A4),D0
                            	  3746:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3747:     ;
02:0003B11E 1B00            	  3748:     move.b  D0,-(A5)  ; PHA
02:0003B120 0C000070        	  3749:     cmpi.b  #$70,D0
02:0003B124 6604            	  3750:     bne  _anon_z04_51
02:0003B126 61000686        	  3751:     jsr     PlaySecretFoundTune
                            	  3752: _anon_z04_51:
                            	  3753:     ; Replace the tile where the armos was.
                            	  3754:     ;
02:0003B12A 522C00F7        	  3755:     addq.b  #1,($00F7,A4)
02:0003B12E 101D            	  3756:     move.b  (A5)+,D0  ; PLA
02:0003B130 4EB90004A97E    	  3757:     jsr     ChangeTileObjTiles
                            	  3758:     ; Because the armos object is aligned to the square grid
                            	  3759:     ; (because it was made from a square),
                            	  3760:     ; set its grid offset to 3 to compensate.
                            	  3761:     ;
                            	  3762:     ; Most objects are aligned to the grid vertically when the
                            	  3763:     ; low nibble is $D.
                            	  3764:     ;
02:0003B136 7003            	  3765:     moveq   #3,D0
02:0003B138 41EC0394        	  3766:     lea     ($0394,A4),A0
02:0003B13C 11802000        	  3767:     move.b  D0,(A0,D2.W)
                            	  3768:     ; Set a speed (q-speed fraction) randomly:
                            	  3769:     ; $20 if random value < $80
                            	  3770:     ; $60 otherwise
                            	  3771:     ;
02:0003B140 7020            	  3772:     moveq   #32,D0
02:0003B142 7600            	  3773:     moveq   #0,D3
02:0003B144 16342019        	  3774:     move.b  ($19,A4,D2.W),D3
02:0003B148 0C030080        	  3775:     cmpi.b  #$80,D3
02:0003B14C 6502            	  3776:     bcs  _anon_z04_52
02:0003B14E 7060            	  3777:     moveq   #96,D0
                            	  3778: _anon_z04_52:
02:0003B150 41EC03BC        	  3779:     lea     ($03BC,A4),A0
02:0003B154 11802000        	  3780:     move.b  D0,(A0,D2.W)
                            	  3781:     even
                            	  3782: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3783:     ; Facing and input directions down.
                            	  3784:     ;
02:0003B158 7004            	  3785:     moveq   #4,D0
02:0003B15A 41EC03F8        	  3786:     lea     ($03F8,A4),A0
02:0003B15E 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:0003B162 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003B166 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
                            	  3791:     ;
02:0003B16A 10342028        	  3792:     move.b  ($28,A4,D2.W),D0
02:0003B16E E208            	  3793:     lsr.b  #1,D0   ; LSR A
02:0003B170 6512            	  3794:     bcs  _anon_z04_53
                            	  3795:     ; Finish initializing based on type.
