02:00031DE0 1940000D        	  5807:     move.b  D0,($000D,A4)
02:00031DE4 101D            	  5808:     move.b  (A5)+,D0  ; PLA
02:00031DE6 020000F0        	  5809:     andi.b #$F0,D0
02:00031DEA 1940000E        	  5810:     move.b  D0,($000E,A4)
                            	  5811: ; Params:
