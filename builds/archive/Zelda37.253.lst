02:0003FF8E 102C0010        	   501:     move.b  ($0010,A4),D0
02:0003FF92 6606            	   502:     bne.s  __far_z_05_0002
02:0003FF94 4EF90002D8F0    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:0003FF9A 61004EC2        	   505:     jsr     HasCompass
02:0003FF9E 6606            	   506:     bne.s  __far_z_05_0003
02:0003FFA0 4EF90002D8F0    	   507:     jmp  Exit
