02:0003F9E8 7600            	 13713:     moveq   #0,D3
02:0003F9EA 1600            	 13714:     move.b  D0,D3
02:0003F9EC 41F90003F82C    	 13715:     lea     (Directions8).l,A0
02:0003F9F2 10303000        	 13716:     move.b  (A0,D3.W),D0
02:0003F9F6 1214            	 13717:     move.b  ($0000,A4),D1
