                            	  3641: SecretArmosXs:
02:0003B08C E0              	  3642:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B08D B0
02:0003B08E B0
02:0003B08F 30
02:0003B090 40
02:0003B091 90
02:0003B092 A0
