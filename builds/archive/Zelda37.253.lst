02:0003FA36 41F90003F82C    	 13764:     lea     (Directions8).l,A0
02:0003FA3C 10303000        	 13765:     move.b  (A0,D3.W),D0
02:0003FA40 41EC0098        	 13766:     lea     ($0098,A4),A0
