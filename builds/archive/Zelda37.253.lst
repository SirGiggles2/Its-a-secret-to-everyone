02:00030E5C 194000AC        	  3817:     move.b  D0,($00AC,A4)
                            	  3818: ; Places the weapon $10 pixels away from the player in the
                            	  3819: ; player's direction.
                            	  3820: ;
                            	  3821: ; Params:
                            	  3822: ; A: $10 for right and down
                            	  3823: ; X: object index
                            	  3824: ;
                            	  3825: ;
                            	  3826: ; Set the offset choices to:
                            	  3827: ;  $10 for right and down in [01]
                            	  3828: ; -$10 for left and up in [02]
                            	  3829: ;
                            	  3830:     even
