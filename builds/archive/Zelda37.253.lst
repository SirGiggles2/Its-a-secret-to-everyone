                            	  1615:     even
                            	  1616: InitMode4:
02:00040C50 7400            	  1617:     moveq   #0,D2
02:00040C52 142C0013        	  1618:     move.b  ($0013,A4),D2
02:00040C56 6604            	  1619:     bne.s  __far_z_05_0023
02:00040C58 60000084        	  1620:     jmp  InitMode_EnterRoom
                            	  1621: __far_z_05_0023:
02:00040C5C 5302            	  1622:     subq.b  #1,D2
02:00040C5E 6612            	  1623:     bne  _L_z05_InitMode4_CheckSub2
                            	  1624:     ; Submode 1.
                            	  1625:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1626:     ;
                            	  1627:     ; TODO:
                            	  1628:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1629:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1630:     ; A positive value triggers this submode 1 to transfer
                            	  1631:     ; the whole play area.
                            	  1632:     ;
                            	  1633:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1634:     ; a good state reflecting the new room. The only thing
                            	  1635:     ; needed is possibly to brighten the room by way of
                            	  1636:     ; changing the palette.
                            	  1637:     ;
                            	  1638:     ; So why does mode 7 trigger this?
                            	  1639:     ; Is there another mode that truly needs this behavior?
                            	  1640:     ;
02:00040C60 102C00E9        	  1641:     move.b  ($00E9,A4),D0
02:00040C64 6B06            	  1642:     bmi  _anon_z05_40
02:00040C66 61003492        	  1643:     jsr     CopyNextRowToTransferBuf
02:00040C6A 6404            	  1644:     bcc  _L_z05_InitMode4_Exit
                            	  1645: _anon_z05_40:
02:00040C6C 522C0013        	  1646:     addq.b  #1,($0013,A4)
                            	  1647:     even
                            	  1648: _L_z05_InitMode4_Exit:
02:00040C70 4E75            	  1649:     rts
                            	  1650: 
                            	  1651:     even
                            	  1652: _L_z05_InitMode4_CheckSub2:
02:00040C72 5302            	  1653:     subq.b  #1,D2
02:00040C74 6702            	  1654:     beq.s  __far_z_05_0024
02:00040C76 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
                            	  1657:     ; Submode 2.
                            	  1658:     ;
02:00040C78 7600            	  1659:     moveq   #0,D3
02:00040C7A 162C00EB        	  1660:     move.b  ($00EB,A4),D3
02:00040C7E 61004280        	  1661:     jsr     IsDarkRoom_Bank5
02:00040C82 6702            	  1662:     beq.s  __far_z_05_0025
02:00040C84 6052            	  1663:     jmp  InitMode4_GoToSub0
                            	  1664: __far_z_05_0025:
                            	  1665:     ; This is a light room.
                            	  1666:     ; See if we have to brighten it after leaving a dark room.
                            	  1667:     ;
02:00040C86 102C0098        	  1668:     move.b  ($0098,A4),D0
02:00040C8A 610040BC        	  1669:     jsr     CalcNextRoomByDir
                            	  1670:     ; Subtract RoomId from next room ID that was calculated
                            	  1671:     ; to get room ID offset in that direction.
02:00040C8E 003C0011        	  1672:     ori     #$11,CCR  ; SEC: set C+X
02:00040C92 122C00EB        	  1673:     move.b  ($00EB,A4),D1
02:00040C96 0A3C0010        	  1674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040C9A 9101            	  1675:     subx.b  D1,D0   ; SBC RoomId
02:00040C9C 0A3C0010        	  1676:     eori    #$10,CCR  ; restore X = 6502 C
02:00040CA0 4EB900030C7A    	  1677:     jsr     Negate
02:00040CA6 023C00EE        	  1678:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040CAA 122C00EB        	  1679:     move.b  ($00EB,A4),D1
02:00040CAE D101            	  1680:     addx.b  D1,D0   ; ADC RoomId
