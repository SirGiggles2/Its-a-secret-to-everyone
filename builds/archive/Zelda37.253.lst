02:00031F28 19400006        	  5990:     move.b  D0,($0006,A4)
                            	  5991:     ; If the weapon's not active (state = 0), then return.
                            	  5992:     ;
02:00031F2C 7600            	  5993:     moveq   #0,D3
02:00031F2E 1614            	  5994:     move.b  ($0000,A4),D3
02:00031F30 41EC00AC        	  5995:     lea     ($00AC,A4),A0
02:00031F34 10303000        	  5996:     move.b  (A0,D3.W),D0
