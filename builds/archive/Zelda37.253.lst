                            	  1841: _L_z04_UpdateStatues_Shoot:
                            	  1842:     ; Look for an empty monster slot.
                            	  1843:     ; If none is found, return.
                            	  1844:     ;
                            	  1845:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1846:     ; object. This routine takes a shooter object, and instantiates
                            	  1847:     ; a fireball object at the shooter's location.
                            	  1848:     ;
                            	  1849:     ; The object slot we set up here will behave as the shooter.
                            	  1850:     ; For each fireball index, this object slot will have its coordinates
                            	  1851:     ; changed.
                            	  1852:     ;
                            	  1853:     ; Note that this means that:
                            	  1854:     ; 1. The first fireball made will be its own shooter.
                            	  1855:     ;    Practically, there's nothing special about this.
                            	  1856:     ; 2. If there is more than one fireball made in a frame,
                            	  1857:     ;    then two of them will come from the same statue.
                            	  1858:     ;
                            	  1859:     ;
                            	  1860:     ; Save the fireball pattern.
02:0003A416 1003            	  1861:     move.b  D3,D0
02:0003A418 1B00            	  1862:     move.b  D0,-(A5)  ; PHA
02:0003A41A 4EB90004D104    	  1863:     jsr     FindEmptyMonsterSlot
02:0003A420 0C000001        	  1864:     cmpi.b  #$01,D0
02:0003A424 101D            	  1865:     move.b  (A5)+,D0  ; PLA
02:0003A426 6400010A        	  1866:     bcc  _L_z04_UpdateStatues_Exit
                            	  1867:     ; If we found a slot, but it < 6, return.
                            	  1868:     ;
02:0003A42A 0C030006        	  1869:     cmpi.b  #$06,D3
02:0003A42E 65000102        	  1870:     bcs  _L_z04_UpdateStatues_Exit
                            	  1871:     ; Store the object slot in [0A].
                            	  1872:     ; Store fireball pattern in [0B].
                            	  1873:     ;
02:0003A432 1943000A        	  1874:     move.b  D3,($000A,A4)
02:0003A436 1940000B        	  1875:     move.b  D0,($000B,A4)
                            	  1876:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1877:     ;
02:0003A43A 7600            	  1878:     moveq   #0,D3
02:0003A43C 1600            	  1879:     move.b  D0,D3
02:0003A43E 7400            	  1880:     moveq   #0,D2
02:0003A440 41F90003A3D2    	  1881:     lea     (StatueFireballCounts).l,A0
02:0003A446 14303000        	  1882:     move.b  (A0,D3.W),D2
                            	  1883:     even
                            	  1884: _L_z04_UpdateStatues_LoopFireball:
                            	  1885:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1886:     ;
                            	  1887:     ; Decrement the fireball timer at this index.
                            	  1888:     ;
02:0003A44A 7600            	  1889:     moveq   #0,D3
02:0003A44C 41EC04E8        	  1890:     lea     ($04E8,A4),A0
02:0003A450 16302000        	  1891:     move.b  (A0,D2.W),D3
02:0003A454 5303            	  1892:     subq.b  #1,D3
02:0003A456 1003            	  1893:     move.b  D3,D0
02:0003A458 41EC04E8        	  1894:     lea     ($04E8,A4),A0
02:0003A45C 11802000        	  1895:     move.b  D0,(A0,D2.W)
                            	  1896:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1897:     ; to make a fireball. Go loop again.
                            	  1898:     ;
02:0003A460 5203            	  1899:     addq.b  #1,D3
02:0003A462 660000C8        	  1900:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1901:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1902:     ; This fireball index will wait another $100 frames.
                            	  1903:     ;
02:0003A466 10342018        	  1904:     move.b  ($18,A4,D2.W),D0
02:0003A46A 0C0000F0        	  1905:     cmpi.b  #$F0,D0
02:0003A46E 640000BC        	  1906:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1907:     ; Else choose one of four start times for the fireball based on
                            	  1908:     ; the random value.
                            	  1909:     ;
02:0003A472 02000003        	  1910:     andi.b #$03,D0
02:0003A476 7600            	  1911:     moveq   #0,D3
02:0003A478 1600            	  1912:     move.b  D0,D3
02:0003A47A 41F90003A3D6    	  1913:     lea     (StatueFireballStartTimes).l,A0
02:0003A480 10303000        	  1914:     move.b  (A0,D3.W),D0
02:0003A484 41EC04E8        	  1915:     lea     ($04E8,A4),A0
02:0003A488 11802000        	  1916:     move.b  D0,(A0,D2.W)
                            	  1917:     ; The coordinate lists are divided into sets for each pattern.
                            	  1918:     ;
                            	  1919:     ; Look up the index of the base of the set for the pattern in use.
                            	  1920:     ; Add it to the fireball index in X register to get the index of
                            	  1921:     ; the coordinate we want within each coordinate list.
                            	  1922:     ;
                            	  1923:     ;
                            	  1924:     ; Pattern
02:0003A48C 7600            	  1925:     moveq   #0,D3
02:0003A48E 162C000B        	  1926:     move.b  ($000B,A4),D3
02:0003A492 1002            	  1927:     move.b  D2,D0
02:0003A494 023C00EE        	  1928:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A498 41F90003A3DA    	  1929:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A49E 12303000        	  1930:     move.b  (A0,D3.W),D1
02:0003A4A2 D101            	  1931:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A4A4 7600            	  1932:     moveq   #0,D3
02:0003A4A6 1600            	  1933:     move.b  D0,D3
02:0003A4A8 1002            	  1934:     move.b  D2,D0
02:0003A4AA 1B00            	  1935:     move.b  D0,-(A5)  ; PHA
                            	  1936:     ; Get Link's coordinates into [00] and [01].
                            	  1937:     ;
02:0003A4AC 7400            	  1938:     moveq   #0,D2
02:0003A4AE 4EB90004C91C    	  1939:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1940:     ; Switch to the new fireball's object slot.
                            	  1941:     ;
02:0003A4B4 7400            	  1942:     moveq   #0,D2
02:0003A4B6 142C000A        	  1943:     move.b  ($000A,A4),D2
                            	  1944:     ; Look up and set the X coordinate for the fireball object.
                            	  1945:     ; Also store it in [02].
                            	  1946:     ;
02:0003A4BA 41F90003A3DE    	  1947:     lea     (StatueXs).l,A0
02:0003A4C0 10303000        	  1948:     move.b  (A0,D3.W),D0
02:0003A4C4 19400002        	  1949:     move.b  D0,($0002,A4)
02:0003A4C8 19802070        	  1950:     move.b  D0,($70,A4,D2.W)
                            	  1951:     ; Look up and set the Y coordinate for the fireball object.
                            	  1952:     ; Also store it in [03].
                            	  1953:     ;
02:0003A4CC 41F90003A3E6    	  1954:     lea     (StatueYs).l,A0
02:0003A4D2 10303000        	  1955:     move.b  (A0,D3.W),D0
02:0003A4D6 19400003        	  1956:     move.b  D0,($0003,A4)
02:0003A4DA 41EC0084        	  1957:     lea     ($0084,A4),A0
02:0003A4DE 11802000        	  1958:     move.b  D0,(A0,D2.W)
                            	  1959:     ; Set mask value 3 in [04].
                            	  1960:     ;
02:0003A4E2 7003            	  1961:     moveq   #3,D0
02:0003A4E4 19400004        	  1962:     move.b  D0,($0004,A4)
                            	  1963:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1964:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1965:     ;
02:0003A4E8 7601            	  1966:     moveq   #1,D3
                            	  1967:     even
                            	  1968: _L_z04_UpdateStatues_LoopAxis:
02:0003A4EA 10343000        	  1969:     move.b  ($00,A4,D3.W),D0
02:0003A4EE 003C0011        	  1970:     ori     #$11,CCR  ; SEC: set C+X
02:0003A4F2 12343002        	  1971:     move.b  ($02,A4,D3.W),D1
02:0003A4F6 0A3C0010        	  1972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A4FA 9101            	  1973:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A4FC 0A3C0010        	  1974:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A500 0C000018        	  1975:     cmpi.b  #$18,D0
02:0003A504 6A10            	  1976:     bpl  _anon_z04_31
02:0003A506 0C0000E8        	  1977:     cmpi.b  #$E8,D0
02:0003A50A 6B0A            	  1978:     bmi  _anon_z04_31
02:0003A50C 122C0004        	  1979:     move.b  ($0004,A4),D1
02:0003A510 E209            	  1980:     lsr.b  #1,D1   ; LSR $04
02:0003A512 19410004        	  1981:     move.b  D1,($0004,A4)
                            	  1982: _anon_z04_31:
02:0003A516 5303            	  1983:     subq.b  #1,D3
02:0003A518 6AD0            	  1984:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1985:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1986:     ; 0 or 1 time, instead of 2.
                            	  1987:     ;
                            	  1988:     ; This, in turn, means that the distance between Link and the
                            	  1989:     ; fireball was >= $18 in at least one axis.
                            	  1990:     ;
                            	  1991:     ; So, we're OK to finish making the fireball.
                            	  1992:     ;
02:0003A51A 102C0004        	  1993:     move.b  ($0004,A4),D0
02:0003A51E 6706            	  1994:     beq  _anon_z04_32
02:0003A520 7055            	  1995:     moveq   #85,D0
02:0003A522 6100F836        	  1996:     jsr     ShootFireball
                            	  1997: _anon_z04_32:
02:0003A526 101D            	  1998:     move.b  (A5)+,D0  ; PLA
02:0003A528 7400            	  1999:     moveq   #0,D2
02:0003A52A 1400            	  2000:     move.b  D0,D2
                            	  2001:     even
                            	  2002: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2003:     ; Bottom of the loop.
                            	  2004:     ; Loop while fireball index >= 0.
                            	  2005:     ;
02:0003A52C 5302            	  2006:     subq.b  #1,D2
02:0003A52E 6A00FF1A        	  2007:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2008:     even
