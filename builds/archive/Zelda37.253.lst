                            	  4881: _anon_z02_35:
02:00036588 41F900036504    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:0003658E 10303000        	  4883:     move.b  (A0,D3.W),D0
02:00036592 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00036596 11803000        	  4885:     move.b  D0,(A0,D3.W)
