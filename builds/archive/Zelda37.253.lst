02:0004BB02 6712            	  4862:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004BB04 102C0001        	  4863:     move.b  ($0001,A4),D0
02:0004BB08 023C00EE        	  4864:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BB0C 123C0003        	  4865:     move.b  #$03,D1
