02:0003AF4E 16302000        	  3444:     move.b  (A0,D2.W),D3
02:0003AF52 0C030007        	  3445:     cmpi.b  #$07,D3
02:0003AF56 6708            	  3446:     beq  _L_z04_UpdateOctorock_Shoot
