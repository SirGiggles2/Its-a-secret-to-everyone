02:0004A7F4 122C0004        	  2125:     move.b  ($0004,A4),D1
02:0004A7F8 D101            	  2126:     addx.b  D1,D0   ; ADC $04
02:0004A7FA 4A02            	  2127:     cmpi.b  #$00,D2
02:0004A7FC 66E4            	  2128:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004A7FE 0C000002        	  2129:     cmpi.b  #$02,D0
