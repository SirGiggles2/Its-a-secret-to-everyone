                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003A976 6100015E        	  2683:     jsr     Jumper_GetKind
02:0003A97A 41F90003A866    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A980 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003A984 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A988 41EC0098        	  2696:     lea     ($0098,A4),A0
