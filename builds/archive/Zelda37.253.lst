02:000304D2 10302000        	  2351:     move.b  (A0,D2.W),D0
02:000304D6 1940000F        	  2352:     move.b  D0,($000F,A4)
02:000304DA 4EB90004B5A4    	  2353:     jsr     MoveObject
                            	  2354:     ; Truncate the grid offset to square length ($10).
                            	  2355:     ;
02:000304E0 41EC0394        	  2356:     lea     ($0394,A4),A0
02:000304E4 10302000        	  2357:     move.b  (A0,D2.W),D0
02:000304E8 0200000F        	  2358:     andi.b #$0F,D0
02:000304EC 6608            	  2359:     bne  _anon_z01_28
