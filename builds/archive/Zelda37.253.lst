02:0003EECE 41EC034F        	 12093:     lea     ($034F,A4),A0
02:0003EED2 16302000        	 12094:     move.b  (A0,D2.W),D3
02:0003EED6 0C030025        	 12095:     cmpi.b  #$25,D3
