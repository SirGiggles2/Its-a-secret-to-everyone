02:00039FA8 11802000        	  1210:     move.b  D0,(A0,D2.W)
                            	  1211:     ; Second, load the vertical direction into [0F].
                            	  1212:     ;
02:00039FAC 41EC0437        	  1213:     lea     ($0437,A4),A0
02:00039FB0 10302000        	  1214:     move.b  (A0,D2.W),D0
02:00039FB4 1940000F        	  1215:     move.b  D0,($000F,A4)
                            	  1216:     ; Load the vertical q-speed and position fraction,
                            	  1217:     ; move, then save the position fraction.
                            	  1218:     ;
02:00039FB8 41EC0444        	  1219:     lea     ($0444,A4),A0
02:00039FBC 10302000        	  1220:     move.b  (A0,D2.W),D0
02:00039FC0 7600            	  1221:     moveq   #0,D3
02:00039FC2 41EC045E        	  1222:     lea     ($045E,A4),A0
02:00039FC6 16302000        	  1223:     move.b  (A0,D2.W),D3
02:00039FCA 6116            	  1224:     jsr     Fireball_MoveOneAxis
