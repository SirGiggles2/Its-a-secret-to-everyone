                            	  5107: 
                            	  5108: ; Params:
                            	  5109: ; [00]: Object X
                            	  5110: ; [01]: Object Y
                            	  5111: ; [02]: Left tile
                            	  5112: ; [03]: Right tile
                            	  5113: ; [04]: Left attributes
                            	  5114: ; [05]: Right attributes
                            	  5115: ; [07]: Has two sides
                            	  5116: ; [08]: Cycle sprite index
                            	  5117: ; [0A]: X separation
                            	  5118: ; [0F]: Flip horizontally
                            	  5119: ; [0343]: LeftSpriteOffset
                            	  5120: ; [0344]: RightSpriteOffset
                            	  5121: ;
