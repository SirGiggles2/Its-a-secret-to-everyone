                            	  4874:     ;
                            	  4875:     ; Call this only to get reverse direction index.
02:0004BB18 4EB900030C72    	  4876:     jsr     GetOppositeDir
02:0004BB1E 102C0015        	  4877:     move.b  ($0015,A4),D0
02:0004BB22 02000003        	  4878:     andi.b #$03,D0
02:0004BB26 41F90004BDE2    	  4879:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BB2C 12303000        	  4880:     move.b  (A0,D3.W),D1
02:0004BB30 8001            	  4881:     or.b  D1,D0
02:0004BB32 4EB900031ABC    	  4882:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4883:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
