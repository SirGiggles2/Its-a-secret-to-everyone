02:00031D0A 123C0008        	  5687:     move.b  #$08,D1
02:00031D0E D101            	  5688:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031D10 19400004        	  5689:     move.b  D0,($0004,A4)
02:00031D14 102C0084        	  5690:     move.b  ($0084,A4),D0
02:00031D18 023C00EE        	  5691:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D1C 123C0008        	  5692:     move.b  #$08,D1
02:00031D20 D101            	  5693:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
