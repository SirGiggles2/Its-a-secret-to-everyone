02:00031EDA 19400098        	  5923:     move.b  D0,($0098,A4)
                            	  5924: _anon_z01_87:
02:00031EDE 4E75            	  5925:     rts
                            	  5926: 
                            	  5927: ; Params:
                            	  5928: ; X: monster slot
                            	  5929: ; Y: weapon slot
                            	  5930: ; [02]: monster mid X
                            	  5931: ; [03]: monster mid Y
                            	  5932: ;
                            	  5933: ; Returns:
                            	  5934: ; [00]: weapon slot
                            	  5935: ;
                            	  5936: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  5937: ;
                            	  5938:     even
                            	  5939: CheckMonsterBoomerangOrFoodCollision:
02:00031EE0 41EC00AC        	  5940:     lea     ($00AC,A4),A0
02:00031EE4 10303000        	  5941:     move.b  (A0,D3.W),D0
02:00031EE8 E308            	  5942:     lsl.b  #1,D0   ; ASL A
02:00031EEA 65F2            	  5943:     bcs  _anon_z01_87
