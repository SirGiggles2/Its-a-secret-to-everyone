02:0003C408 19410002        	  6327:     move.b  D1,($0002,A4)
02:0003C40C 122C0002        	  6328:     move.b  ($0002,A4),D1
02:0003C410 C200            	  6329:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C412 6716            	  6330:     beq  _L_z04_Digdogger_Move_Up
02:0003C414 41EC0084        	  6331:     lea     ($0084,A4),A0
02:0003C418 10302000        	  6332:     move.b  (A0,D2.W),D0
02:0003C41C 122C0003        	  6333:     move.b  ($0003,A4),D1
02:0003C420 D101            	  6334:     addx.b  D1,D0   ; ADC $03
02:0003C422 41EC0084        	  6335:     lea     ($0084,A4),A0
02:0003C426 11802000        	  6336:     move.b  D0,(A0,D2.W)
                            	  6337:     even
