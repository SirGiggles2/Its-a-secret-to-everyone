                            	  2311: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  2312:     ; If the horizontal distance between Link and the trap >= $E,
                            	  2313:     ; then this trap definitely wasn't triggered.
                            	  2314:     ; Go draw and check collisions.
                            	  2315:     ;
02:0003048E 102C0070        	  2316:     move.b  ($0070,A4),D0
02:00030492 003C0011        	  2317:     ori     #$11,CCR  ; SEC: set C+X
02:00030496 12342070        	  2318:     move.b  ($70,A4,D2.W),D1
02:0003049A 0A3C0010        	  2319:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003049E 9101            	  2320:     subx.b  D1,D0   ; SBC ObjX,X
02:000304A0 0A3C0010        	  2321:     eori    #$10,CCR  ; restore X = 6502 C
02:000304A4 610007D0        	  2322:     jsr     Abs
02:000304A8 0C00000E        	  2323:     cmpi.b  #$0E,D0
02:000304AC 64DC            	  2324:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  2325:     ; Determine the vertical direction toward Link;
                            	  2326:     ; and if Link and the trap are at the same Y, then we can't move
                            	  2327:     ; along this axis. Go draw and check object collisions.
                            	  2328:     ;
02:000304AE 7604            	  2329:     moveq   #4,D3
02:000304B0 102C0084        	  2330:     move.b  ($0084,A4),D0
02:000304B4 41EC0084        	  2331:     lea     ($0084,A4),A0
02:000304B8 12302000        	  2332:     move.b  (A0,D2.W),D1
