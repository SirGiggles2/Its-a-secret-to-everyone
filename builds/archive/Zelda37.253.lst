                            	  7337: _L_z07_InitObject_InitMonsterFromEdge:
02:0004CD58 7400            	  7338:     moveq   #0,D2
02:0004CD5A 142C0340        	  7339:     move.b  ($0340,A4),D2
                            	  7340:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7341:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7342:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7343:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7344:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7345:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7346:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7347:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7348:     ; corrupting them and causing a deterministic address-error
                            	  7349:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7350:     ; identified by Codex static review.)
                            	  7351: _L_z07_P47_pre_check:
02:0004CD5E 102C0525        	  7352:     move.b  ($0525,A4),D0
02:0004CD62 020000F0        	  7353:     andi.b  #$F0,D0
02:0004CD66 0C000040        	  7354:     cmpi.b  #$40,D0
02:0004CD6A 6506            	  7355:     blo     _L_z07_P47_pre_snap
02:0004CD6C 0C0000E0        	  7356:     cmpi.b  #$E0,D0
02:0004CD70 6506            	  7357:     blo     _L_z07_P47_pre_ok
                            	  7358: _L_z07_P47_pre_snap:
02:0004CD72 197C00480525    	  7359:     move.b  #$48,($0525,A4)
                            	  7360: _L_z07_P47_pre_ok:
02:0004CD78 7005            	  7361:     moveq   #5,D0
02:0004CD7A 610004F4        	  7362:     jsr     SwitchBank
02:0004CD7E 4EB900041B10    	  7363:     jsr     FindNextEdgeSpawnCell
                            	  7364:     ; Post-walk 1: bottom-edge snap.
02:0004CD84 102C0525        	  7365:     move.b  ($0525,A4),D0
02:0004CD88 020000F0        	  7366:     andi.b  #$F0,D0
02:0004CD8C 0C0000E0        	  7367:     cmpi.b  #$E0,D0
02:0004CD90 660C            	  7368:     bne     _L_z07_P47_post1_ok
02:0004CD92 197C00480525    	  7369:     move.b  #$48,($0525,A4)
02:0004CD98 4EB900041B10    	  7370:     jsr     FindNextEdgeSpawnCell
                            	  7371: _L_z07_P47_post1_ok:
                            	  7372:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7373:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004CD9E 7600            	  7374:     moveq   #0,D3
02:0004CDA0 162C0525        	  7375:     move.b  ($0525,A4),D3
02:0004CDA4 0243000F        	  7376:     andi.w  #$000F,D3
02:0004CDA8 C6FC002C        	  7377:     mulu.w  #44,D3
02:0004CDAC 203C00FF6530    	  7378:     move.l  #$FF6530,D0
02:0004CDB2 D083            	  7379:     add.l   D3,D0
02:0004CDB4 7600            	  7380:     moveq   #0,D3
02:0004CDB6 162C0525        	  7381:     move.b  ($0525,A4),D3
02:0004CDBA E84B            	  7382:     lsr.w   #4,D3
02:0004CDBC 5943            	  7383:     subi.w  #4,D3
02:0004CDBE E34B            	  7384:     lsl.w   #1,D3
02:0004CDC0 D083            	  7385:     add.l   D3,D0
02:0004CDC2 2040            	  7386:     movea.l D0,A0
02:0004CDC4 1010            	  7387:     move.b  (A0),D0
02:0004CDC6 0C000084        	  7388:     cmpi.b  #$84,D0
02:0004CDCA 6544            	  7389:     blo     _L_z07_P47_post2_ok
                            	  7390:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7391:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7392:     ; writes to the $05xx region.
02:0004CDCC 7800            	  7393:     moveq   #0,D4
                            	  7394: _L_z07_P47_fb_loop:
02:0004CDCE 41FAE48C        	  7395:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004CDD2 12304000        	  7396:     move.b  (A0,D4.W),D1
02:0004CDD6 19410525        	  7397:     move.b  D1,($0525,A4)
                            	  7398:     ; Validate fallback cell walkable.
02:0004CDDA 7600            	  7399:     moveq   #0,D3
02:0004CDDC 1601            	  7400:     move.b  D1,D3
02:0004CDDE 0243000F        	  7401:     andi.w  #$000F,D3
02:0004CDE2 C6FC002C        	  7402:     mulu.w  #44,D3
02:0004CDE6 203C00FF6530    	  7403:     move.l  #$FF6530,D0
02:0004CDEC D083            	  7404:     add.l   D3,D0
02:0004CDEE 7600            	  7405:     moveq   #0,D3
02:0004CDF0 1601            	  7406:     move.b  D1,D3
02:0004CDF2 E84B            	  7407:     lsr.w   #4,D3
02:0004CDF4 5943            	  7408:     subi.w  #4,D3
02:0004CDF6 E34B            	  7409:     lsl.w   #1,D3
02:0004CDF8 D083            	  7410:     add.l   D3,D0
02:0004CDFA 2040            	  7411:     movea.l D0,A0
02:0004CDFC 0C100084        	  7412:     cmpi.b  #$84,(A0)
02:0004CE00 650E            	  7413:     blo     _L_z07_P47_post2_ok
02:0004CE02 5204            	  7414:     addq.b  #1,D4
02:0004CE04 0C040008        	  7415:     cmpi.b  #8,D4
02:0004CE08 65C4            	  7416:     blo     _L_z07_P47_fb_loop
                            	  7417:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7418:     ; rather than looping).
02:0004CE0A 197C00480525    	  7419:     move.b  #$48,($0525,A4)
                            	  7420: _L_z07_P47_post2_ok:
                            	  7421:     ; Extract and set the monster's location.
                            	  7422:     ;
02:0004CE10 102C0525        	  7423:     move.b  ($0525,A4),D0
                            	  7424:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7425:     ;
02:0004CE14 1B00            	  7426:     move.b  D0,-(A5)  ; PHA
02:0004CE16 E308            	  7427:     lsl.b  #1,D0   ; ASL A
02:0004CE18 E308            	  7428:     lsl.b  #1,D0   ; ASL A
02:0004CE1A E308            	  7429:     lsl.b  #1,D0   ; ASL A
02:0004CE1C E308            	  7430:     lsl.b  #1,D0   ; ASL A
02:0004CE1E 19802070        	  7431:     move.b  D0,($70,A4,D2.W)
                            	  7432:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7433:     ;
02:0004CE22 101D            	  7434:     move.b  (A5)+,D0  ; PLA
02:0004CE24 020000F0        	  7435:     andi.b #$F0,D0
02:0004CE28 003C0011        	  7436:     ori     #$11,CCR  ; SEC: set C+X
02:0004CE2C 123C0003        	  7437:     move.b  #$03,D1
02:0004CE30 0A3C0010        	  7438:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CE34 9101            	  7439:     subx.b  D1,D0   ; SBC #$03
02:0004CE36 0A3C0010        	  7440:     eori    #$10,CCR  ; restore X = 6502 C
02:0004CE3A 41EC0084        	  7441:     lea     ($0084,A4),A0
02:0004CE3E 11802000        	  7442:     move.b  D0,(A0,D2.W)
                            	  7443:     ; Set the monsters-from-edges long timer to a random value
                            	  7444:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7445:     ;
02:0004CE42 10342019        	  7446:     move.b  ($19,A4,D2.W),D0
02:0004CE46 02000003        	  7447:     andi.b #$03,D0
02:0004CE4A 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CE4E 123C0002        	  7449:     move.b  #$02,D1
02:0004CE52 D101            	  7450:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004CE54 1940004B        	  7451:     move.b  D0,($004B,A4)
                            	  7452:     ; If the distance to Link is too close to Link, then
                            	  7453:     ; go flag the monster uninitialized again, so we can
