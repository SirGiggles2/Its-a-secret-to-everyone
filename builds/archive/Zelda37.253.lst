02:0003EE98 10342070        	 12072:     move.b  ($70,A4,D2.W),D0
02:0003EE9C 023C00EE        	 12073:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEA0 122C046C        	 12074:     move.b  ($046C,A4),D1
02:0003EEA4 D101            	 12075:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003EEA6 19802070        	 12076:     move.b  D0,($70,A4,D2.W)
02:0003EEAA 41EC0084        	 12077:     lea     ($0084,A4),A0
02:0003EEAE 10302000        	 12078:     move.b  (A0,D2.W),D0
02:0003EEB2 023C00EE        	 12079:     andi    #$EE,CCR  ; CLC: clear C+X
