02:0003CE8C 02000003        	  7789:     andi.b #$03,D0
02:0003CE90 7600            	  7790:     moveq   #0,D3
02:0003CE92 1600            	  7791:     move.b  D0,D3
02:0003CE94 41F90003CCA4    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003CE9A 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003CE9E 41EC0098        	  7794:     lea     ($0098,A4),A0
