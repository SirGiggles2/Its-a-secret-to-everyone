02:0003242A 41EC04F0        	  6852:     lea     ($04F0,A4),A0
02:0003242E 10302000        	  6853:     move.b  (A0,D2.W),D0
02:00032432 6656            	  6854:     bne  _L_z01_BeginShove_Exit2
                            	  6855:     ; If the monster is not a Gohma, then go store the shove direction.
