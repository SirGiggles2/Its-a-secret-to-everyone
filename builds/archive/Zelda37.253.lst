02:000317D2 41EC034F        	  4977:     lea     ($034F,A4),A0
02:000317D6 16302000        	  4978:     move.b  (A0,D2.W),D3
                            	  4979: ; Params:
                            	  4980: ; A: frame
                            	  4981: ; X: object index/cycle sprite index
                            	  4982: ; Y: object type
                            	  4983: ; [00]: object X
                            	  4984: ; [01]: object Y
                            	  4985: ; [0C]: mirrored
                            	  4986: ; [0F]: flip horizontally
                            	  4987: ;
                            	  4988: ; Note:
                            	  4989: ; If the object is not mirrored, then it's horizontally flippable.
                            	  4990: ;
                            	  4991: ; The animation index of most objects is (object type + 1),
                            	  4992: ; to make up for the fact that Link uses two animation indexes.
                            	  4993: ;
                            	  4994:     even
                            	  4995: DrawObjectWithType:
02:000317DA 5203            	  4996:     addq.b  #1,D3
                            	  4997: ; Params:
                            	  4998: ; A: frame
                            	  4999: ; X: object index/cycle sprite index
                            	  5000: ; Y: animation index
                            	  5001: ; [00]: object X
                            	  5002: ; [01]: object Y
                            	  5003: ; [0C]: mirrored
                            	  5004: ; [0F]: flip horizontally
                            	  5005: ;
                            	  5006: ; Note:
                            	  5007: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5008: ; But Link uses [0F] for flipping without checking [0C].
                            	  5009: ;
                            	  5010: ;
                            	  5011: ; [0D] holds frame.
                            	  5012:     even
