02:0003363E E14C            	   528:     lsl.w   #8,D4
02:00033640 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033642 48C4            	   530:     ext.l   D4
02:00033644 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003364A 2044            	   532:     movea.l D4,A0
02:0003364C 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033650 41EC0633        	   534:     lea     ($0633,A4),A0
02:00033654 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033658 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:0003365A 1003            	   537:     move.b  D3,D0
02:0003365C 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003365E 19430016        	   539:     move.b  D3,($0016,A4)
02:00033662 6100D236        	   540:     jsr     FetchFileAAddressSet
02:00033666 61001C3C        	   541:     jsr     FormatFileA
02:0003366A 7000            	   542:     moveq   #0,D0
