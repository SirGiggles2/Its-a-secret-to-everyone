02:0003185E 4A02            	  5061:     cmpi.b  #$00,D2
02:00031860 6722            	  5062:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00031862 0C02000D        	  5063:     cmpi.b  #$0D,D2
