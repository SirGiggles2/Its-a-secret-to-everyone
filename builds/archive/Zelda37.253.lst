                            	  6636: ; Params:
                            	  6637: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  6638: ; [00]: weapon object slot (unused)
                            	  6639: ; [02]: object 1 mid X
                            	  6640: ; [03]: object 1 mid Y
                            	  6641: ; [04]: object 2 mid X
                            	  6642: ; [05]: object 2 mid Y
                            	  6643: ;
                            	  6644: ; Returns:
                            	  6645: ; A: 1 if objects collide
                            	  6646: ; Y: weapon object slot
                            	  6647: ; Z: 0 if objects collide
                            	  6648: ; [06]: 1 if objects collide
                            	  6649: ; [0A]: horizontal distance
                            	  6650: ; [0B]: vertical distance
                            	  6651: ;
                            	  6652: ;
                            	  6653: ; Use the same threshold value horizontally and vertically.
                            	  6654: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  6655: ;
                            	  6656:     even
                            	  6657: DoObjectsCollide:
02:00032318 1940000D        	  6658:     move.b  D0,($000D,A4)
02:0003231C 1940000E        	  6659:     move.b  D0,($000E,A4)
                            	  6660: ; Params:
                            	  6661: ; [00]: weapon or Link object slot (unused)
                            	  6662: ; [02]: object 1 mid X
                            	  6663: ; [03]: object 1 mid Y
                            	  6664: ; [04]: object 2 mid X
                            	  6665: ; [05]: object 2 mid Y
                            	  6666: ; [0D]: horizontal threshold
                            	  6667: ; [0E]: vertical threshold
                            	  6668: ;
                            	  6669: ; Returns:
                            	  6670: ; A: 1 if objects collide
                            	  6671: ; Y: weapon or Link object slot (copied from [00])
                            	  6672: ; Z: 0 if objects collide
                            	  6673: ; [06]: 1 if objects collide
                            	  6674: ; [0A]: horizontal distance
                            	  6675: ; [0B]: vertical distance
                            	  6676: ;
                            	  6677: ;
                            	  6678: ; Reset [06] to indicate no collision by default.
                            	  6679: ;
                            	  6680:     even
