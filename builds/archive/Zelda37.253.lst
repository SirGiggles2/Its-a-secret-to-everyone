                            	  5473: CheckState20:
                            	  5474:     ; If major state <> $20, go check other states.
                            	  5475:     ;
02:0004BF3E 0C000020        	  5476:     cmpi.b  #$20,D0
02:0004BF42 6704            	  5477:     beq.s  __far_z_07_0083
02:0004BF44 600000B6        	  5478:     jmp  CheckState30
                            	  5479: __far_z_07_0083:
                            	  5480:     ; State $2x. Spark.
                            	  5481:     ;
                            	  5482:     ; Change the state to $28, and decrement animation counter.
                            	  5483:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5484:     ; (with Link, if this is a monster's boomerang).
                            	  5485:     ;
                            	  5486:     ; TODO: Why state $28?
                            	  5487:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5488:     ; start over again when spinning.
                            	  5489:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5490:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5491:     ; any drawing code depends on the minor state.
                            	  5492:     ;
02:0004BF48 7028            	  5493:     moveq   #40,D0
02:0004BF4A 41EC00AC        	  5494:     lea     ($00AC,A4),A0
02:0004BF4E 11802000        	  5495:     move.b  D0,(A0,D2.W)
02:0004BF52 41EC03D0        	  5496:     lea     ($03D0,A4),A0
02:0004BF56 53302000        	  5497:     subq.b  #1,(A0,D2.W)
02:0004BF5A 6702            	  5498:     beq.s  __far_z_07_0084
02:0004BF5C 6060            	  5499:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5500: __far_z_07_0084:
                            	  5501:     ; Animation counter = 0.
                            	  5502:     ;
                            	  5503:     ; Set state to $40. It will become $50 below in
                            	  5504:     ; HandleArrowOrBoomerangBlocked.
                            	  5505:     ;
02:0004BF5E 7040            	  5506:     moveq   #64,D0
02:0004BF60 41EC00AC        	  5507:     lea     ($00AC,A4),A0
02:0004BF64 11802000        	  5508:     move.b  D0,(A0,D2.W)
                            	  5509:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5510:     ; Else go handle the boomerang being blocked.
                            	  5511:     ;
02:0004BF68 0C02000D        	  5512:     cmpi.b  #$0D,D2
02:0004BF6C 640E            	  5513:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004BF6E 41EC034F        	  5514:     lea     ($034F,A4),A0
02:0004BF72 10302000        	  5515:     move.b  (A0,D2.W),D0
02:0004BF76 0C00005B        	  5516:     cmpi.b  #$5B,D0
02:0004BF7A 6708            	  5517:     beq  _L_z07_CheckState20_Deactivate
                            	  5518:     even
                            	  5519: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004BF7C 0C020012        	  5520:     cmpi.b  #$12,D2
02:0004BF80 6702            	  5521:     beq.s  __far_z_07_0085
02:0004BF82 6016            	  5522:     jmp  HandleArrowOrBoomerangBlocked
                            	  5523: __far_z_07_0085:
                            	  5524:     even
                            	  5525: _L_z07_CheckState20_Deactivate:
02:0004BF84 61000534        	  5526:     jsr     ResetObjState
                            	  5527:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5528:     ; including clearing object type.
                            	  5529:     ;
02:0004BF88 0C02000D        	  5530:     cmpi.b  #$0D,D2
02:0004BF8C 6406            	  5531:     bcc  _anon_z07_29
02:0004BF8E 4EB900039E32    	  5532:     jsr     DestroyCountedMonsterShot
