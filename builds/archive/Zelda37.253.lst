                            	 12098: _anon_z04_159:
02:0003EEDE 61000D9C        	 12099:     jsr     DecreaseObjectAngle
                            	 12100:     ; Load Patra's maneuver index.
                            	 12101:     ; It determines which counts of bits are looked up below.
                            	 12102:     ;
02:0003EEE2 7600            	 12103:     moveq   #0,D3
02:0003EEE4 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003EEE8 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003EEEC 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003EEF0 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003EEF4 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003EEF6 41F90003EDE8    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003EEFC 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003EF00 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003EF02 41F90003EDEC    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003EF08 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003EF0C 7600            	 12118:     moveq   #0,D3
02:0003EF0E 1600            	 12119:     move.b  D0,D3
02:0003EF10 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003EF12 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003EF14 41F90003EDEA    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003EF1A 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003EF1E 7600            	 12131:     moveq   #0,D3
02:0003EF20 1600            	 12132:     move.b  D0,D3
                            	 12133:     even
                            	 12134: _L_z04_PatraChild_State1_Rotate:
02:0003EF22 61000BA8        	 12135:     jsr     RotateObjectLocation
02:0003EF26 41EC0084        	 12136:     lea     ($0084,A4),A0
02:0003EF2A 11802000        	 12137:     move.b  D0,(A0,D2.W)
02:0003EF2E 611C            	 12138:     jsr     PatraChild_Draw
                            	 12139:     ; If Patra's state still = 0, then the last patra child has not
                            	 12140:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 12141:     ;
02:0003EF30 102C00AD        	 12142:     move.b  ($00AD,A4),D0
02:0003EF34 6714            	 12143:     beq  _L_z04_PatraChild_State1_Exit
02:0003EF36 4EB900031B46    	 12144:     jsr     CheckMonsterCollisions
                            	 12145:     ; If the monster died, then change to the dead dummy object.
