02:0003FFAE 1214            	   511:     move.b  ($0000,A4),D1
02:0003FFB0 D101            	   512:     addx.b  D1,D0   ; ADC $00
02:0003FFB2 19400258        	   513:     move.b  D0,($0258,A4)
