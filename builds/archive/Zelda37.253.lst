02:0004BB92 6072            	  4942:     jmp  DeactivateShot
                            	  4943: __far_z_07_0075:
                            	  4944:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4945:     ; unused, so it only has to depend on having an empty slot.
                            	  4946:     ;
                            	  4947:     ; If successful, Link's state will have been changed to "using item".
                            	  4948:     ; But we don't want that in this case.
                            	  4949:     ;
                            	  4950:     ; For both these reasons, save state and restore it afterward.
                            	  4951:     ;
02:0004BB94 102C00AC        	  4952:     move.b  ($00AC,A4),D0
02:0004BB98 1B00            	  4953:     move.b  D0,-(A5)  ; PHA
02:0004BB9A 102C0513        	  4954:     move.b  ($0513,A4),D0
02:0004BB9E 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004BBA0 7000            	  4956:     moveq   #0,D0
02:0004BBA2 19400513        	  4957:     move.b  D0,($0513,A4)
02:0004BBA6 4EB900030EBC    	  4958:     jsr     WieldCandle
02:0004BBAC 101D            	  4959:     move.b  (A5)+,D0  ; PLA
02:0004BBAE 19400513        	  4960:     move.b  D0,($0513,A4)
02:0004BBB2 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004BBB4 194000AC        	  4962:     move.b  D0,($00AC,A4)
                            	  4963:     ; State $21 means that a moving fire was just made.
                            	  4964:     ;
                            	  4965:     ; If it's any another value, then we didn't find an empty slot
                            	  4966:     ; to make a fire. In this case, all that's left to do is to go
                            	  4967:     ; deactivate the shot object.
                            	  4968:     ;
02:0004BBB8 41EC00AC        	  4969:     lea     ($00AC,A4),A0
02:0004BBBC 10302000        	  4970:     move.b  (A0,D2.W),D0
02:0004BBC0 0C000021        	  4971:     cmpi.b  #$21,D0
02:0004BBC4 6702            	  4972:     beq.s  __far_z_07_0076
02:0004BBC6 6038            	  4973:     jmp  DeactivateLinkShot
                            	  4974: __far_z_07_0076:
                            	  4975:     ; Make state $22 for a standing fire.
                            	  4976:     ;
02:0004BBC8 41EC00AC        	  4977:     lea     ($00AC,A4),A0
02:0004BBCC 52302000        	  4978:     addq.b  #1,(A0,D2.W)
