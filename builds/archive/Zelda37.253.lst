02:0003BF1C 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003BF20 6502            	  5623:     bcs  _anon_z04_80
02:0003BF22 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
