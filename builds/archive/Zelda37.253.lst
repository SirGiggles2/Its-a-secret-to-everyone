                            	  3833: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3834:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3835:     ;
                            	  3836:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3837:     ;         or object direction when <> 0.
                            	  3838:     ;
                            	  3839:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3840:     ;
                            	  3841:     ; if slot = 0 and grid offset <> 0 then
                            	  3842:     ;   if input dir = 0 then
                            	  3843:     ;     use 0
                            	  3844:     ;   else
                            	  3845:     ;     use object direction
                            	  3846:     ; else
                            	  3847:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3848:     ;     return
                            	  3849:     ;   else
                            	  3850:     ;     if input dir = 0
                            	  3851:     ;       use 0
                            	  3852:     ;     else
                            	  3853:     ;       use input direction
                            	  3854:     ;
