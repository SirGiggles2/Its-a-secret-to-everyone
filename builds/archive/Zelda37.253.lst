02:0003B172 41EC034F        	  3797:     lea     ($034F,A4),A0
02:0003B176 10302000        	  3798:     move.b  (A0,D2.W),D0
02:0003B17A 0C000022        	  3799:     cmpi.b  #$22,D0
02:0003B17E 6602            	  3800:     bne.s  __far_z_04_0032
02:0003B180 6008            	  3801:     jmp  L_EndInitFlyingGhini
                            	  3802: __far_z_04_0032:
