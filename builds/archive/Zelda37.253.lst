02:0003DB1C 41EC0098        	  9478:     lea     ($0098,A4),A0
02:0003DB20 10302000        	  9479:     move.b  (A0,D2.W),D0
02:0003DB24 122C0002        	  9480:     move.b  ($0002,A4),D1
02:0003DB28 E309            	  9481:     lsl.b  #1,D1   ; ASL $02
02:0003DB2A 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003DB2E 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003DB32 C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DB34 6716            	  9485:     beq  _L_z04_Manhandla_Move_Up
02:0003DB36 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003DB3A 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003DB3E 122C0003        	  9488:     move.b  ($0003,A4),D1
02:0003DB42 D101            	  9489:     addx.b  D1,D0   ; ADC $03
02:0003DB44 41EC0084        	  9490:     lea     ($0084,A4),A0
