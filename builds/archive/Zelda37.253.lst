02:0004BB6C 10302000        	  4913:     move.b  (A0,D2.W),D0
02:0004BB70 E308            	  4914:     lsl.b  #1,D0   ; ASL A
02:0004BB72 6402            	  4915:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
