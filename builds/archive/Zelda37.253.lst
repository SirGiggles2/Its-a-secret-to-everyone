02:0003041A 660000B2        	  2252:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2253:     ; State 0. Sensing.
                            	  2254:     ;
                            	  2255:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2256:     ; then go see if the horizontal distance is shorter.
                            	  2257:     ;
02:0003041E 102C0084        	  2258:     move.b  ($0084,A4),D0
02:00030422 003C0011        	  2259:     ori     #$11,CCR  ; SEC: set C+X
02:00030426 41EC0084        	  2260:     lea     ($0084,A4),A0
02:0003042A 12302000        	  2261:     move.b  (A0,D2.W),D1
02:0003042E 0A3C0010        	  2262:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030432 9101            	  2263:     subx.b  D1,D0   ; SBC ObjY,X
02:00030434 0A3C0010        	  2264:     eori    #$10,CCR  ; restore X = 6502 C
02:00030438 6100083C        	  2265:     jsr     Abs
02:0003043C 0C00000E        	  2266:     cmpi.b  #$0E,D0
