02:0002BF8E 670A            	  2257:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2258:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2259:     eori    #$01,CCR
02:0002BF98 4E75            	  2260:     rts
                            	  2261: .cc_cnr:
02:0002BF9A 023C00FE        	  2262:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2263:     eori    #$01,CCR
02:0002BFA2 4E75            	  2264:     rts
