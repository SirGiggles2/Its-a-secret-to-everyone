02:00031D6A 12302000        	  5740:     move.b  (A0,D2.W),D1
02:00031D6E 8001            	  5741:     or.b  D1,D0
02:00031D70 0200000C        	  5742:     andi.b #$0C,D0
02:00031D74 0C00000C        	  5743:     cmpi.b  #$0C,D0
02:00031D78 671A            	  5744:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031D7A 102C0098        	  5745:     move.b  ($0098,A4),D0
02:00031D7E 41EC0098        	  5746:     lea     ($0098,A4),A0
02:00031D82 12302000        	  5747:     move.b  (A0,D2.W),D1
02:00031D86 8001            	  5748:     or.b  D1,D0
02:00031D88 02000003        	  5749:     andi.b #$03,D0
02:00031D8C 0C000003        	  5750:     cmpi.b  #$03,D0
02:00031D90 6702            	  5751:     beq.s  __far_z_01_0059
02:00031D92 602A            	  5752:     jmp  HarmLink
                            	  5753: __far_z_01_0059:
