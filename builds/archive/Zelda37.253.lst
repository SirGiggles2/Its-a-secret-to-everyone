                            	  4980:     ;
02:0004BBD0 760E            	  4981:     moveq   #14,D3
02:0004BBD2 10343070        	  4982:     move.b  ($70,A4,D3.W),D0
02:0004BBD6 19802070        	  4983:     move.b  D0,($70,A4,D2.W)
02:0004BBDA 41EC0084        	  4984:     lea     ($0084,A4),A0
02:0004BBDE 10303000        	  4985:     move.b  (A0,D3.W),D0
02:0004BBE2 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004BBE6 11802000        	  4987:     move.b  D0,(A0,D2.W)
02:0004BBEA 41EC0098        	  4988:     lea     ($0098,A4),A0
02:0004BBEE 10303000        	  4989:     move.b  (A0,D3.W),D0
02:0004BBF2 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004BBF6 11802000        	  4991:     move.b  D0,(A0,D2.W)
