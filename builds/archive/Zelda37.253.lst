                            	 12041:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12042:     ; Else use radius $18. Store the chosen value in [00].
                            	 12043:     ;
02:0003EE64 702C            	 12044:     moveq   #44,D0
02:0003EE66 7600            	 12045:     moveq   #0,D3
02:0003EE68 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003EE6C 16302000        	 12047:     move.b  (A0,D2.W),D3
