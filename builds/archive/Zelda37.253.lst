02:0003A564 142C0059        	  2041:     move.b  ($0059,A4),D2
                            	  2042:     even
                            	  2043: _L_z04_CheckZora_LoopTileCandidate:
                            	  2044:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2045:     ; If it = 0 or $F0, go loop again.
                            	  2046:     ;
02:0003A568 7600            	  2047:     moveq   #0,D3
02:0003A56A 162C000D        	  2048:     move.b  ($000D,A4),D3
02:0003A56E 10343018        	  2049:     move.b  ($18,A4,D3.W),D0
02:0003A572 020000F0        	  2050:     andi.b #$F0,D0
02:0003A576 19802070        	  2051:     move.b  D0,($70,A4,D2.W)
02:0003A57A 6748            	  2052:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A57C 0C0000F0        	  2053:     cmpi.b  #$F0,D0
02:0003A580 6742            	  2054:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2055:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2056:     ; If it < $50 or >= $E0, go loop again.
                            	  2057:     ;
02:0003A582 10343018        	  2058:     move.b  ($18,A4,D3.W),D0
02:0003A586 E308            	  2059:     lsl.b  #1,D0   ; ASL A
02:0003A588 E308            	  2060:     lsl.b  #1,D0   ; ASL A
02:0003A58A E308            	  2061:     lsl.b  #1,D0   ; ASL A
02:0003A58C E308            	  2062:     lsl.b  #1,D0   ; ASL A
02:0003A58E 0C000050        	  2063:     cmpi.b  #$50,D0
02:0003A592 6530            	  2064:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A594 0C0000E0        	  2065:     cmpi.b  #$E0,D0
02:0003A598 642A            	  2066:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2067:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2068:     ;
02:0003A59A 0000000D        	  2069:     ori.b #$0D,D0
02:0003A59E 41EC0084        	  2070:     lea     ($0084,A4),A0
02:0003A5A2 11802000        	  2071:     move.b  D0,(A0,D2.W)
                            	  2072:     ; Get the tile at that location.
                            	  2073:     ; If it's not a water tile, then go loop again.
                            	  2074:     ;
02:0003A5A6 4EB90004B24A    	  2075:     jsr     GetCollidableTileStill
02:0003A5AC 0C00008D        	  2076:     cmpi.b  #$8D,D0
02:0003A5B0 6512            	  2077:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A5B2 0C000099        	  2078:     cmpi.b  #$99,D0
02:0003A5B6 640C            	  2079:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2080:     ; Flag the zora active, and set up the object.
                            	  2081:     ;
