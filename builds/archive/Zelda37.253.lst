                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003DCBC 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003DCC0 10302000        	  9671:     move.b  (A0,D2.W),D0
