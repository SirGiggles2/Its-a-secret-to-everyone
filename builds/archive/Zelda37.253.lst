                            	  5705:     ;
02:00031D32 41EC034F        	  5706:     lea     ($034F,A4),A0
02:00031D36 10302000        	  5707:     move.b  (A0,D2.W),D0
02:00031D3A 0C000053        	  5708:     cmpi.b  #$53,D0
02:00031D3E 6402            	  5709:     bcc.s  __far_z_01_0055
02:00031D40 607C            	  5710:     jmp  HarmLink
                            	  5711: __far_z_01_0055:
