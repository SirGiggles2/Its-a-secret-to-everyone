                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003DDD4 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003DDD6 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003DDDA 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDDE 41F90003DDB4    	  9834:     lea     (GohmaLegOffsetsX).l,A0
02:0003DDE4 12303000        	  9835:     move.b  (A0,D3.W),D1
02:0003DDE8 D101            	  9836:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DDEA 1880            	  9837:     move.b  D0,($0000,A4)
                            	  9838:     ; The object's Y is the sprite's.
                            	  9839:     ;
02:0003DDEC 41EC0084        	  9840:     lea     ($0084,A4),A0
02:0003DDF0 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003DDF4 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003DDF8 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003DDFA 4EB90004C8EE    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DE00 1003            	  9856:     move.b  D3,D0
02:0003DE02 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE06 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003DE0A 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003DE0E D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003DE10 02000001        	  9861:     andi.b #$01,D0
02:0003DE14 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE18 123C0004        	  9863:     move.b  #$04,D1
02:0003DE1C D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DE1E 4EF9000317CA    	  9865:     jmp     DrawObjectNotMirrored
                            	  9866: 
                            	  9867: ; Returns:
