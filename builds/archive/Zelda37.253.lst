                            	  3821: UpdateArmos:
02:0003B1A2 6100E830        	  3822:     jsr     UpdateGoriya
                            	  3823:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3824:     ;
02:0003B1A6 41EC00C0        	  3825:     lea     ($00C0,A4),A0
02:0003B1AA 10302000        	  3826:     move.b  (A0,D2.W),D0
02:0003B1AE 6702            	  3827:     beq.s  __far_z_04_0033
