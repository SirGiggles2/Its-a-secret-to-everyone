                            	  7954:     ; Draw the left legs.
                            	  7955:     ;
02:0003B9E0 7600            	  7956:     moveq   #0,D3
                            	  7957: ; Params:
                            	  7958: ; Y: side: 0 for left, 1 for right
                            	  7959: ;
                            	  7960: ; Add the horizontal offset for the current side to Gohma's X to
                            	  7961: ; store the sprite's X in [00].
                            	  7962: ;
                            	  7963:     even
                            	  7964: Gohma_DrawLegsOneSide:
02:0003B9E2 10342070        	  7965:     move.b  ($70,A4,D2.W),D0
02:0003B9E6 023C00EE        	  7966:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B9EA 41F90003B9C0    	  7967:     lea     (GohmaLegOffsetsX).l,A0
02:0003B9F0 12303000        	  7968:     move.b  (A0,D3.W),D1
02:0003B9F4 D101            	  7969:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B9F6 1880            	  7970:     move.b  D0,($0000,A4)
                            	  7971:     ; The object's Y is the sprite's.
                            	  7972:     ;
02:0003B9F8 41EC0084        	  7973:     lea     ($0084,A4),A0
02:0003B9FC 10302000        	  7974:     move.b  (A0,D2.W),D0
02:0003BA00 19400001        	  7975:     move.b  D0,($0001,A4)
02:0003BA04 612A            	  7976:     jsr     Gohma_SetSpriteAttributes
                            	  7977:     ; There are only two frame images for legs: left and right.
                            	  7978:     ; There are two animation frames. They are animated as follows:
                            	  7979:     ;
                            	  7980:     ; Frame 0:
                            	  7981:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  7982:     ; horizontal flipping = frame number = 0
                            	  7983:     ; 
                            	  7984:     ; Frame 1:
                            	  7985:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  7986:     ; horizontal flipping = frame number = 1
                            	  7987:     ;
02:0003BA06 4EB90004A1B0    	  7988:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003BA0C 1003            	  7989:     move.b  D3,D0
02:0003BA0E 023C00EE        	  7990:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA12 41EC03E4        	  7991:     lea     ($03E4,A4),A0
02:0003BA16 12302000        	  7992:     move.b  (A0,D2.W),D1
02:0003BA1A D101            	  7993:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003BA1C 02000001        	  7994:     andi.b #$01,D0
02:0003BA20 023C00EE        	  7995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA24 123C0004        	  7996:     move.b  #$04,D1
02:0003BA28 D101            	  7997:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BA2A 4EF900030C3C    	  7998:     jmp     DrawObjectNotMirrored
                            	  7999: 
                            	  8000: ; Returns:
                            	  8001: ; [04]: left side sprite attributes
                            	  8002: ; [05]: right side sprite attributes
