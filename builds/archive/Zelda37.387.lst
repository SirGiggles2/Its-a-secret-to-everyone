                            	  9295:     ;
                            	  9296:     ; But, the only room with that configuration has those blocks
                            	  9297:     ; blocked off with a push block, which can only be pushed after
                            	  9298:     ; all monsters are killed.
                            	  9299:     ;
02:0003C3FA 4E75            	  9300:     rts
                            	  9301: 
                            	  9302:     even
