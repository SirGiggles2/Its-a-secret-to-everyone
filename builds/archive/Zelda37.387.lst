02:000489B2 10302000        	  3279:     move.b  (A0,D2.W),D0
02:000489B6 02000001        	  3280:     andi.b #$01,D0
02:000489BA 6620            	  3281:     bne  _L_z07_BeginUpdateWorld_NextObject
                            	  3282:     ; If no attribute 1, then it indicates not to skip drawing. So, animate and draw.
                            	  3283:     ;
02:000489BC 41EC04BF        	  3284:     lea     ($04BF,A4),A0
02:000489C0 10302000        	  3285:     move.b  (A0,D2.W),D0
02:000489C4 02000004        	  3286:     andi.b #$04,D0
02:000489C8 6606            	  3287:     bne  _anon_z07_10
02:000489CA 4EB900030C2E    	  3288:     jsr     AnimateAndDrawObjectWalking
                            	  3289: _anon_z07_10:
                            	  3290:     ; Either way, we'll check collisions.
