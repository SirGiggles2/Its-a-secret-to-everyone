                            	   736: CopyCommonCodeToRam:
                            	   737:     ; PATCHED: NOP — all code is in flat ROM on Genesis.
02:0002F31C 4E75            	   738:     rts
02:0002F31E 7000            	   739:     moveq   #0,D0
02:0002F320 1880            	   740:     move.b  D0,($0000,A4)
02:0002F322 103C00A5        	   741:     move.b  #$A5,D0
02:0002F326 19400001        	   742:     move.b  D0,($0001,A4)
02:0002F32A 103C0090        	   743:     move.b  #$90,D0
02:0002F32E 19400002        	   744:     move.b  D0,($0002,A4)
02:0002F332 706C            	   745:     moveq   #108,D0
02:0002F334 19400003        	   746:     move.b  D0,($0003,A4)
02:0002F338 7600            	   747:     moveq   #0,D3
                            	   748:     even
                            	   749: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F33A 1214            	   750:     move.b  ($00,A4),D1   ; ptr lo
02:0002F33C 182C0001        	   751:     move.b  ($01,A4),D4  ; ptr hi
02:0002F340 024100FF        	   752:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F344 E14C            	   753:     lsl.w   #8,D4
02:0002F346 8841            	   754:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F348 48C4            	   755:     ext.l   D4
02:0002F34A D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F350 2044            	   757:     movea.l D4,A0
02:0002F352 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F356 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002F35A 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
02:0002F35E 024100FF        	   761:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F362 E14C            	   762:     lsl.w   #8,D4
02:0002F364 8841            	   763:     or.w    D1,D4
02:0002F366 48C4            	   764:     ext.l   D4
02:0002F368 D8BC00FF0000    	   765:     add.l   #NES_RAM,D4
02:0002F36E 2044            	   766:     movea.l D4,A0
02:0002F370 11803000        	   767:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   768:     ; Increment source address.
                            	   769:     ;
02:0002F374 1014            	   770:     move.b  ($0000,A4),D0
02:0002F376 023C00EE        	   771:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F37A 123C0001        	   772:     move.b  #$01,D1
02:0002F37E D101            	   773:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F380 1880            	   774:     move.b  D0,($0000,A4)
02:0002F382 102C0001        	   775:     move.b  ($0001,A4),D0
02:0002F386 123C0000        	   776:     move.b  #$00,D1
02:0002F38A D101            	   777:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F38C 19400001        	   778:     move.b  D0,($0001,A4)
                            	   779:     ; Increment destination address.
                            	   780:     ;
02:0002F390 102C0002        	   781:     move.b  ($0002,A4),D0
02:0002F394 023C00EE        	   782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F398 123C0001        	   783:     move.b  #$01,D1
02:0002F39C D101            	   784:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F39E 19400002        	   785:     move.b  D0,($0002,A4)
02:0002F3A2 102C0003        	   786:     move.b  ($0003,A4),D0
02:0002F3A6 123C0000        	   787:     move.b  #$00,D1
02:0002F3AA D101            	   788:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F3AC 19400003        	   789:     move.b  D0,($0003,A4)
02:0002F3B0 0C00007F        	   790:     cmpi.b  #$7F,D0
02:0002F3B4 6684            	   791:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002F3B6 102C0002        	   792:     move.b  ($0002,A4),D0
02:0002F3BA 4A00            	   793:     cmpi.b  #$00,D0
02:0002F3BC 6600FF7C        	   794:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002F3C0 0A3C0001        	   795:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002F3C4 4E75            	   796:     rts
