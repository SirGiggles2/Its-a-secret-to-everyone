                            	  9667:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  9668:     ;
02:0003C6BC 7000            	  9669:     moveq   #0,D0
02:0003C6BE 1940000B        	  9670:     move.b  D0,($000B,A4)
                            	  9671:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  9672:     ; monster's angle by $70, else by $60 to go slower.
                            	  9673:     ;
02:0003C6C2 7070            	  9674:     moveq   #112,D0
02:0003C6C4 7600            	  9675:     moveq   #0,D3
02:0003C6C6 41EC034F        	  9676:     lea     ($034F,A4),A0
02:0003C6CA 16302000        	  9677:     move.b  (A0,D2.W),D3
02:0003C6CE 0C030025        	  9678:     cmpi.b  #$25,D3
02:0003C6D2 6702            	  9679:     beq  _anon_z04_159
