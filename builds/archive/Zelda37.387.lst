                            	 10167:     ; Draw the top and bottom clouds.
                            	 10168:     ;
02:0003CA1A 10342070        	 10169:     move.b  ($70,A4,D2.W),D0
02:0003CA1E 1880            	 10170:     move.b  D0,($0000,A4)
02:0003CA20 6100009C        	 10171:     jsr     Ganon_GetCurCloudTop
02:0003CA24 6100FF7E        	 10172:     jsr     Ganon_DrawCloud
02:0003CA28 6100009A        	 10173:     jsr     Ganon_GetCurCloudBottom
02:0003CA2C 6100FF76        	 10174:     jsr     Ganon_DrawCloud
                            	 10175:     ; Draw the left and right clouds.
                            	 10176:     ;
02:0003CA30 61000080        	 10177:     jsr     Ganon_GetCurCloudLeft
02:0003CA34 41EC0084        	 10178:     lea     ($0084,A4),A0
02:0003CA38 10302000        	 10179:     move.b  (A0,D2.W),D0
02:0003CA3C 19400001        	 10180:     move.b  D0,($0001,A4)
02:0003CA40 6100FF62        	 10181:     jsr     Ganon_DrawCloud
02:0003CA44 6172            	 10182:     jsr     Ganon_GetCurCloudRight
02:0003CA46 6100FF5C        	 10183:     jsr     Ganon_DrawCloud
                            	 10184:     ; Save the object index.
                            	 10185:     ;
02:0003CA4A 102C0340        	 10186:     move.b  ($0340,A4),D0
02:0003CA4E 1B00            	 10187:     move.b  D0,-(A5)  ; PHA
                            	 10188:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 10189:     ;
02:0003CA50 7402            	 10190:     moveq   #2,D2
                            	 10191:     even
                            	 10192: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003CA52 19420340        	 10193:     move.b  D2,($0340,A4)
                            	 10194:     ; If object slot < 5 or = 7, then move every frame.
                            	 10195:     ; Else move 3 out of every 4 frames.
                            	 10196:     ;
                            	 10197:     ; This makes pieces spread out in somewhat of a circle,
                            	 10198:     ; by making the pieces at cardinal directions move at
                            	 10199:     ; full speed while the diagonal ones move a little slower.
                            	 10200:     ;
02:0003CA56 0C020005        	 10201:     cmpi.b  #$05,D2
02:0003CA5A 6510            	 10202:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003CA5C 0C020007        	 10203:     cmpi.b  #$07,D2
02:0003CA60 670A            	 10204:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003CA62 102C0015        	 10205:     move.b  ($0015,A4),D0
02:0003CA66 02000003        	 10206:     andi.b #$03,D0
02:0003CA6A 6704            	 10207:     beq  _anon_z04_164
                            	 10208:     even
                            	 10209: _L_z04_Ganon_DrawBurst_Move:
02:0003CA6C 6100E7FA        	 10210:     jsr     BlueWizzrobe_Move
                            	 10211: _anon_z04_164:
02:0003CA70 4EB90004A1DE    	 10212:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 10213:     ; The frame counter will make the sprite flash.
                            	 10214:     ; The array has the horizontal and vertical flipping attributes.
                            	 10215:     ; Combine them into [03].
                            	 10216:     ;
02:0003CA76 102C0015        	 10217:     move.b  ($0015,A4),D0
02:0003CA7A 02000003        	 10218:     andi.b #$03,D0
02:0003CA7E 41F90003C94E    	 10219:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003CA84 12302000        	 10220:     move.b  (A0,D2.W),D1
02:0003CA88 8001            	 10221:     or.b  D1,D0
02:0003CA8A 19400003        	 10222:     move.b  D0,($0003,A4)
02:0003CA8E 41F90003C958    	 10223:     lea     (GanonBurstTiles).l,A0
02:0003CA94 10302000        	 10224:     move.b  (A0,D2.W),D0
02:0003CA98 4EB900030F38    	 10225:     jsr     Anim_WriteSprite
                            	 10226:     ; Bottom of the loop.
                            	 10227:     ; Increment object slot while <= 9.
                            	 10228:     ;
02:0003CA9E 5202            	 10229:     addq.b  #1,D2
02:0003CAA0 0C02000A        	 10230:     cmpi.b  #$0A,D2
02:0003CAA4 65AC            	 10231:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 10232:     ; Restore the object index.
                            	 10233:     ;
02:0003CAA6 101D            	 10234:     move.b  (A5)+,D0  ; PLA
02:0003CAA8 19400340        	 10235:     move.b  D0,($0340,A4)
02:0003CAAC 0A3C0001        	 10236:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003CAB0 4E75            	 10237:     rts
                            	 10238: 
                            	 10239: ; Returns:
                            	 10240: ; [00]: X coordinate
                            	 10241: ;
                            	 10242:     even
                            	 10243: Ganon_GetCurCloudLeft:
