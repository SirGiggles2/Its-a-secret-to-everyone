02:00039122 0C030005        	  2383:     cmpi.b  #$05,D3
02:00039126 640A            	  2384:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00039128 41EC0098        	  2385:     lea     ($0098,A4),A0
02:0003912C 10302000        	  2386:     move.b  (A0,D2.W),D0
