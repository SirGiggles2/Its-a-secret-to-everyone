02:0003AC08 41EC03E4        	  6136:     lea     ($03E4,A4),A0
02:0003AC0C 16302000        	  6137:     move.b  (A0,D2.W),D3
02:0003AC10 671E            	  6138:     beq  _anon_z04_95
02:0003AC12 023C00EE        	  6139:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC16 123C0003        	  6140:     move.b  #$03,D1
02:0003AC1A D101            	  6141:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  6142:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  6143:     ;
                            	  6144:     ; Down has two frame images, but up only has one. By flipping
                            	  6145:     ; horizontally, you get two frame images.
                            	  6146:     ;
