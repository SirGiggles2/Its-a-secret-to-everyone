                            	  2093: ; Params:
                            	  2094: ; A: frame
                            	  2095: ; X: object index/cycle sprite index
                            	  2096: ; Y: object type
                            	  2097: ; [00]: object X
                            	  2098: ; [01]: object Y
                            	  2099: ; [0C]: mirrored
                            	  2100: ; [0F]: flip horizontally
