                            	  9758: 
                            	  9759: ; Description:
                            	  9760: ; Lift up the Triforce of Courage while the room is dark.
                            	  9761: ;
                            	  9762: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  9763: ;
                            	  9764:     even
                            	  9765: Ganon_ScenePhase0:
02:0003C774 701B            	  9766:     moveq   #27,D0
02:0003C776 19400505        	  9767:     move.b  D0,($0505,A4)
                            	  9768:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  9769:     ;
02:0003C77A 102C0028        	  9770:     move.b  ($0028,A4),D0
02:0003C77E 6644            	  9771:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  9772:     ; Once the timer expires, it's time to brighten the room.
                            	  9773:     ;
                            	  9774:     ; Save the current object slot.
02:0003C780 1002            	  9775:     move.b  D2,D0
02:0003C782 1B00            	  9776:     move.b  D0,-(A5)  ; PHA
02:0003C784 610007F0        	  9777:     jsr     UpdateCandle
02:0003C788 101D            	  9778:     move.b  (A5)+,D0  ; PLA
02:0003C78A 7400            	  9779:     moveq   #0,D2
02:0003C78C 1400            	  9780:     move.b  D0,D2
                            	  9781:     ; Turn off the room brightening flag, because we're controlling it
                            	  9782:     ; here instead of in the Mode 5 object update loop.
                            	  9783:     ;
02:0003C78E 7000            	  9784:     moveq   #0,D0
02:0003C790 1940051E        	  9785:     move.b  D0,($051E,A4)
                            	  9786:     ; On the first frame of the fade-to-light cycle, play the
                            	  9787:     ; Triforce/Ganon song.
                            	  9788:     ;
02:0003C794 102C051C        	  9789:     move.b  ($051C,A4),D0
