02:00038974 12303000        	  1261:     move.b  (A0,D3.W),D1
02:00038978 B001            	  1262:     cmp.b   D1,D0
02:0003897A 670A            	  1263:     beq  _L_z04_UpdateStatues_Shoot
02:0003897C 5303            	  1264:     subq.b  #1,D3
02:0003897E 6AEE            	  1265:     bpl  _anon_z04_30
02:00038980 0A3C0001        	  1266:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00038984 4E75            	  1267:     rts
