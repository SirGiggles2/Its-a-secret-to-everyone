02:0003AE6E D101            	  6426:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003AE70 41EC0394        	  6427:     lea     ($0394,A4),A0
02:0003AE74 11802000        	  6428:     move.b  D0,(A0,D2.W)
                            	  6429:     ; Align the monster with a square horizontally.
                            	  6430:     ;
                            	  6431:     ; If in the left half of a square, align with that square.
                            	  6432:     ; If in the right half, align with the next square.
                            	  6433:     ;
02:0003AE78 10342070        	  6434:     move.b  ($70,A4,D2.W),D0
02:0003AE7C 023C00EE        	  6435:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE80 123C0008        	  6436:     move.b  #$08,D1
02:0003AE84 D101            	  6437:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AE86 020000F0        	  6438:     andi.b #$F0,D0
02:0003AE8A 19802070        	  6439:     move.b  D0,($70,A4,D2.W)
                            	  6440:     ; Align the monster with a square vertically.
                            	  6441:     ;
                            	  6442:     ; If in the top half of a square, align with that square.
                            	  6443:     ; If in the bottom half, align with the next square.
                            	  6444:     ;
02:0003AE8E 41EC0084        	  6445:     lea     ($0084,A4),A0
02:0003AE92 10302000        	  6446:     move.b  (A0,D2.W),D0
02:0003AE96 023C00EE        	  6447:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE9A 123C0008        	  6448:     move.b  #$08,D1
02:0003AE9E D101            	  6449:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AEA0 020000F0        	  6450:     andi.b #$F0,D0
                            	  6451:     ; Make sure the lower nibble of Y is $D as usual.
                            	  6452:     ;
