02:0003A466 10302000        	  5140:     move.b  (A0,D2.W),D0
02:0003A46A 0C000004        	  5141:     cmpi.b  #$04,D0
02:0003A46E 659E            	  5142:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
