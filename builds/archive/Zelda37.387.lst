02:0003AEFA 7600            	  6495:     moveq   #0,D3
02:0003AEFC 41EC03E4        	  6496:     lea     ($03E4,A4),A0
02:0003AF00 16302000        	  6497:     move.b  (A0,D2.W),D3
02:0003AF04 5203            	  6498:     addq.b  #1,D3
02:0003AF06 1003            	  6499:     move.b  D3,D0
