02:000389DA 0C0000F0        	  1334:     cmpi.b  #$F0,D0
02:000389DE 640000BC        	  1335:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1336:     ; Else choose one of four start times for the fireball based on
                            	  1337:     ; the random value.
                            	  1338:     ;
