02:0003C6AA 023C00EE        	  9662:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C6AE 122C0479        	  9663:     move.b  ($0479,A4),D1
02:0003C6B2 D101            	  9664:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003C6B4 41EC0084        	  9665:     lea     ($0084,A4),A0
