02:00038A34 19400002        	  1378:     move.b  D0,($0002,A4)
02:00038A38 19802070        	  1379:     move.b  D0,($70,A4,D2.W)
                            	  1380:     ; Look up and set the Y coordinate for the fireball object.
                            	  1381:     ; Also store it in [03].
