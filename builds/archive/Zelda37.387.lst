02:000396F8 661E            	  3236:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3237:     ; If Link's X < $70 or >= $81, then return.
                            	  3238:     ;
02:000396FA 102C0070        	  3239:     move.b  ($0070,A4),D0
02:000396FE 0C000070        	  3240:     cmpi.b  #$70,D0
02:00039702 6514            	  3241:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039704 0C000081        	  3242:     cmpi.b  #$81,D0
02:00039708 640E            	  3243:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3244:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3245:     ; halt Link, and start filling hearts.
