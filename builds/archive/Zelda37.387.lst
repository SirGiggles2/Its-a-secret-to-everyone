02:0003ACCA 610001F4        	  6242:     jsr     PolsVoice_IsSquareWalkable
02:0003ACCE 6452            	  6243:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  6244:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  6245:     ; then go change to state 1.
                            	  6246:     ;
02:0003ACD0 41EC041F        	  6247:     lea     ($041F,A4),A0
02:0003ACD4 10302000        	  6248:     move.b  (A0,D2.W),D0
02:0003ACD8 020000FC        	  6249:     andi.b #$FC,D0
02:0003ACDC 0C0000B0        	  6250:     cmpi.b  #$B0,D0
