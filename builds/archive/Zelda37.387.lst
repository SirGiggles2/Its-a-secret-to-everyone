02:00039EEE 61000082        	  4336:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  4337:     ; The default image is the hand open.
                            	  4338:     ; If animation frame = 0, then return.
                            	  4339:     ;
02:00039EF2 7400            	  4340:     moveq   #0,D2
02:00039EF4 142C0340        	  4341:     move.b  ($0340,A4),D2
02:00039EF8 41EC03E4        	  4342:     lea     ($03E4,A4),A0
02:00039EFC 10302000        	  4343:     move.b  (A0,D2.W),D0
02:00039F00 6724            	  4344:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  4345:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  4346:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  4347:     ; The right side is correctly the right side of a closed hand.
                            	  4348:     ; But the left side is Keese. So, we have to patch the left
                            	  4349:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  4350:     ;
