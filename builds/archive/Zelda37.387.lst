02:0003F026 0C000080        	  3230:     cmpi.b  #$80,D0
02:0003F02A 670A            	  3231:     beq  _anon_z05_83
02:0003F02C 5203            	  3232:     addq.b  #1,D3
02:0003F02E 0C0000B0        	  3233:     cmpi.b  #$B0,D0
02:0003F032 6702            	  3234:     beq.s  __far_z_05_0062
02:0003F034 604C            	  3235:     jmp  L14F72_Exit
