                            	  2221: 
                            	  2222: ; Params:
                            	  2223: ; [00]: Object X
                            	  2224: ; [01]: Object Y
                            	  2225: ; [02]: Left tile
                            	  2226: ; [03]: Right tile
                            	  2227: ; [04]: Left attributes
                            	  2228: ; [05]: Right attributes
                            	  2229: ; [07]: Has two sides
                            	  2230: ; [08]: Cycle sprite index
                            	  2231: ; [0A]: X separation
                            	  2232: ; [0F]: Flip horizontally
                            	  2233: ; [0343]: LeftSpriteOffset
                            	  2234: ; [0344]: RightSpriteOffset
                            	  2235: ;
                            	  2236: ; If [0F] = 0, write the sprite pair with no further processing.
