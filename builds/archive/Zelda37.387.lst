                            	 11449: PatraSines:
02:0003D2B0 00              	 11450:     dc.b    $00, $18, $30, $47, $5A, $6A, $76, $7D
02:0003D2B1 18
02:0003D2B2 30
02:0003D2B3 47
02:0003D2B4 5A
02:0003D2B5 6A
02:0003D2B6 76
02:0003D2B7 7D
02:0003D2B8 80              	 11451:     dc.b    $80, $7D, $76, $6A, $5A, $47, $30, $18
02:0003D2B9 7D
02:0003D2BA 76
02:0003D2BB 6A
02:0003D2BC 5A
02:0003D2BD 47
02:0003D2BE 30
02:0003D2BF 18
                            	 11452: 
                            	 11453: ; Params:
                            	 11454: ; A: high bits of cosine to use in calculating Y increment
                            	 11455: ; Y: high bits of sine to use in calculating X increment
                            	 11456: ; X: object index
                            	 11457: ;
                            	 11458: ; Returns:
                            	 11459: ; A: new Y coordinate of object
                            	 11460: ;
                            	 11461: ; [06] holds the number of high bits of cosine to use
                            	 11462:     even
                            	 11463: RotateObjectLocation:
02:0003D2C0 19400006        	 11464:     move.b  D0,($0006,A4)
02:0003D2C4 19430005        	 11465:     move.b  D3,($0005,A4)
                            	 11466:     ; First, rotate the X coordinate.
                            	 11467:     ;
                            	 11468:     ; Look up the sine for the current angle, and store it in [00].
                            	 11469:     ;
02:0003D2C8 41EC0394        	 11470:     lea     ($0394,A4),A0
02:0003D2CC 10302000        	 11471:     move.b  (A0,D2.W),D0
02:0003D2D0 0200000F        	 11472:     andi.b #$0F,D0
02:0003D2D4 7600            	 11473:     moveq   #0,D3
02:0003D2D6 1600            	 11474:     move.b  D0,D3
02:0003D2D8 41F90003D2B0    	 11475:     lea     (PatraSines).l,A0
02:0003D2DE 10303000        	 11476:     move.b  (A0,D3.W),D0
02:0003D2E2 1880            	 11477:     move.b  D0,($0000,A4)
                            	 11478:     ; Mutliply q-speed by [00].
                            	 11479:     ;
                            	 11480:     ; Q-speed has the default value $20 set when entering the room.
                            	 11481:     ;
02:0003D2E4 41EC03BC        	 11482:     lea     ($03BC,A4),A0
02:0003D2E8 10302000        	 11483:     move.b  (A0,D2.W),D0
02:0003D2EC 7600            	 11484:     moveq   #0,D3
02:0003D2EE 162C0005        	 11485:     move.b  ($0005,A4),D3
02:0003D2F2 61000136        	 11486:     jsr     ShiftMultiply
                            	 11487:     ; The absolute X increment for the current angle is now in [02:03].
                            	 11488:     ;
                            	 11489:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 11490:     ;
02:0003D2F6 41EC0394        	 11491:     lea     ($0394,A4),A0
02:0003D2FA 10302000        	 11492:     move.b  (A0,D2.W),D0
02:0003D2FE 02000018        	 11493:     andi.b #$18,D0
02:0003D302 0C000010        	 11494:     cmpi.b  #$10,D0
02:0003D306 6536            	 11495:     bcs  _L_z04_RotateObjectLocation_AddToX
                            	 11496:     ; Subtract the product's fraction from the X coordinate fraction.
                            	 11497:     ;
02:0003D308 41EC0412        	 11498:     lea     ($0412,A4),A0
02:0003D30C 10302000        	 11499:     move.b  (A0,D2.W),D0
02:0003D310 003C0011        	 11500:     ori     #$11,CCR  ; SEC: set C+X
02:0003D314 122C0002        	 11501:     move.b  ($0002,A4),D1
02:0003D318 0A3C0010        	 11502:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D31C 9101            	 11503:     subx.b  D1,D0   ; SBC $02
02:0003D31E 0A3C0010        	 11504:     eori    #$10,CCR  ; restore X = 6502 C
