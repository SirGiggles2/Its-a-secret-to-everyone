                            	  3335: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  3336:     ; If the current heart's state <> 0, then go move it.
                            	  3337:     ; Else we have to wait for it to come out at the right time.
                            	  3338:     ;
02:00039776 41EC00AC        	  3339:     lea     ($00AC,A4),A0
02:0003977A 10302000        	  3340:     move.b  (A0,D2.W),D0
02:0003977E 667C            	  3341:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  3342:     ; The current heart's state = 0.
                            	  3343:     ;
                            	  3344:     ; If object slot = 2, then go make it appear. This is the first
                            	  3345:     ; heart to show up.
                            	  3346:     ;
02:00039780 0C020002        	  3347:     cmpi.b  #$02,D2
02:00039784 6732            	  3348:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  3349:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  3350:     ; go start over.
                            	  3351:     ;
                            	  3352:     ; TODO:
                            	  3353:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  3354:     ;
02:00039786 102C00AE        	  3355:     move.b  ($00AE,A4),D0
02:0003978A 67EA            	  3356:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  3357:     ; Look up the starting angle of this heart with the index
                            	  3358:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  3359:     ; then loop again.
                            	  3360:     ;
02:0003978C 1002            	  3361:     move.b  D2,D0
02:0003978E 003C0011        	  3362:     ori     #$11,CCR  ; SEC: set C+X
02:00039792 123C0003        	  3363:     move.b  #$03,D1
02:00039796 0A3C0010        	  3364:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003979A 9101            	  3365:     subx.b  D1,D0   ; SBC #$03
02:0003979C 0A3C0010        	  3366:     eori    #$10,CCR  ; restore X = 6502 C
02:000397A0 7600            	  3367:     moveq   #0,D3
02:000397A2 1600            	  3368:     move.b  D0,D3
02:000397A4 102C0396        	  3369:     move.b  ($0396,A4),D0
02:000397A8 41F90003976C    	  3370:     lea     (PondHeartStartAngles).l,A0
02:000397AE 12303000        	  3371:     move.b  (A0,D3.W),D1
02:000397B2 B001            	  3372:     cmp.b   D1,D0
02:000397B4 66000086        	  3373:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  3374:     even
