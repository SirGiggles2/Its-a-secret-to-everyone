                            	  3296: _L_z07_BeginUpdateWorld_NextObject:
                            	  3297:     ; Bottom of the object update loop.
                            	  3298:     ;
02:000489DC 532C0340        	  3299:     subq.b  #1,($0340,A4)
02:000489E0 669C            	  3300:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3301:     ; Set the current object slot to what it should be when we
                            	  3302:     ; begin updating objects again next frame: $B
                            	  3303:     ; the last object slot for monsters and tile objects
                            	  3304:     ;
                            	  3305:     ; Before the first frame of mode 5, the current object slot variable
                            	  3306:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3307:     ;
                            	  3308:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3309:     ;
02:000489E2 700B            	  3310:     moveq   #11,D0
02:000489E4 19400340        	  3311:     move.b  D0,($0340,A4)
                            	  3312:     ; If full hearts = 0, then only a partial heart is left.
                            	  3313:     ; So, turn on the "heart warning".
                            	  3314:     ;
02:000489E8 102C066F        	  3315:     move.b  ($066F,A4),D0
02:000489EC 0200000F        	  3316:     andi.b #$0F,D0
02:000489F0 660C            	  3317:     bne  _L_z07_BeginUpdateWorld_CheckUW
