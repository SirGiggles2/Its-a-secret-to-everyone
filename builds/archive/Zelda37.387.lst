                            	  7323: _L_z07_InitObject_InitMonsterFromEdge:
02:0004A61A 7400            	  7324:     moveq   #0,D2
02:0004A61C 142C0340        	  7325:     move.b  ($0340,A4),D2
                            	  7326:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7327:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7328:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7329:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7330:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7331:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7332:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7333:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7334:     ; corrupting them and causing a deterministic address-error
                            	  7335:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7336:     ; identified by Codex static review.)
                            	  7337: _L_z07_P47_pre_check:
02:0004A620 102C0525        	  7338:     move.b  ($0525,A4),D0
02:0004A624 020000F0        	  7339:     andi.b  #$F0,D0
02:0004A628 0C000040        	  7340:     cmpi.b  #$40,D0
02:0004A62C 6506            	  7341:     blo     _L_z07_P47_pre_snap
02:0004A62E 0C0000E0        	  7342:     cmpi.b  #$E0,D0
02:0004A632 6506            	  7343:     blo     _L_z07_P47_pre_ok
                            	  7344: _L_z07_P47_pre_snap:
02:0004A634 197C00480525    	  7345:     move.b  #$48,($0525,A4)
                            	  7346: _L_z07_P47_pre_ok:
02:0004A63A 7005            	  7347:     moveq   #5,D0
02:0004A63C 610004F4        	  7348:     jsr     SwitchBank
02:0004A640 4EB90003F212    	  7349:     jsr     FindNextEdgeSpawnCell
                            	  7350:     ; Post-walk 1: bottom-edge snap.
02:0004A646 102C0525        	  7351:     move.b  ($0525,A4),D0
02:0004A64A 020000F0        	  7352:     andi.b  #$F0,D0
02:0004A64E 0C0000E0        	  7353:     cmpi.b  #$E0,D0
02:0004A652 660C            	  7354:     bne     _L_z07_P47_post1_ok
02:0004A654 197C00480525    	  7355:     move.b  #$48,($0525,A4)
02:0004A65A 4EB90003F212    	  7356:     jsr     FindNextEdgeSpawnCell
                            	  7357: _L_z07_P47_post1_ok:
                            	  7358:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7359:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004A660 7600            	  7360:     moveq   #0,D3
02:0004A662 162C0525        	  7361:     move.b  ($0525,A4),D3
02:0004A666 0243000F        	  7362:     andi.w  #$000F,D3
02:0004A66A C6FC002C        	  7363:     mulu.w  #44,D3
02:0004A66E 203C00FF6530    	  7364:     move.l  #$FF6530,D0
02:0004A674 D083            	  7365:     add.l   D3,D0
02:0004A676 7600            	  7366:     moveq   #0,D3
02:0004A678 162C0525        	  7367:     move.b  ($0525,A4),D3
02:0004A67C E84B            	  7368:     lsr.w   #4,D3
02:0004A67E 5943            	  7369:     subi.w  #4,D3
02:0004A680 E34B            	  7370:     lsl.w   #1,D3
02:0004A682 D083            	  7371:     add.l   D3,D0
02:0004A684 2040            	  7372:     movea.l D0,A0
02:0004A686 1010            	  7373:     move.b  (A0),D0
02:0004A688 0C000084        	  7374:     cmpi.b  #$84,D0
02:0004A68C 6544            	  7375:     blo     _L_z07_P47_post2_ok
                            	  7376:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7377:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7378:     ; writes to the $05xx region.
02:0004A68E 7800            	  7379:     moveq   #0,D4
                            	  7380: _L_z07_P47_fb_loop:
02:0004A690 41FAE49E        	  7381:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004A694 12304000        	  7382:     move.b  (A0,D4.W),D1
02:0004A698 19410525        	  7383:     move.b  D1,($0525,A4)
                            	  7384:     ; Validate fallback cell walkable.
02:0004A69C 7600            	  7385:     moveq   #0,D3
02:0004A69E 1601            	  7386:     move.b  D1,D3
02:0004A6A0 0243000F        	  7387:     andi.w  #$000F,D3
02:0004A6A4 C6FC002C        	  7388:     mulu.w  #44,D3
02:0004A6A8 203C00FF6530    	  7389:     move.l  #$FF6530,D0
02:0004A6AE D083            	  7390:     add.l   D3,D0
02:0004A6B0 7600            	  7391:     moveq   #0,D3
02:0004A6B2 1601            	  7392:     move.b  D1,D3
02:0004A6B4 E84B            	  7393:     lsr.w   #4,D3
02:0004A6B6 5943            	  7394:     subi.w  #4,D3
02:0004A6B8 E34B            	  7395:     lsl.w   #1,D3
02:0004A6BA D083            	  7396:     add.l   D3,D0
02:0004A6BC 2040            	  7397:     movea.l D0,A0
02:0004A6BE 0C100084        	  7398:     cmpi.b  #$84,(A0)
02:0004A6C2 650E            	  7399:     blo     _L_z07_P47_post2_ok
02:0004A6C4 5204            	  7400:     addq.b  #1,D4
02:0004A6C6 0C040008        	  7401:     cmpi.b  #8,D4
02:0004A6CA 65C4            	  7402:     blo     _L_z07_P47_fb_loop
                            	  7403:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7404:     ; rather than looping).
02:0004A6CC 197C00480525    	  7405:     move.b  #$48,($0525,A4)
                            	  7406: _L_z07_P47_post2_ok:
                            	  7407:     ; Extract and set the monster's location.
                            	  7408:     ;
02:0004A6D2 102C0525        	  7409:     move.b  ($0525,A4),D0
                            	  7410:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7411:     ;
02:0004A6D6 1B00            	  7412:     move.b  D0,-(A5)  ; PHA
02:0004A6D8 E308            	  7413:     lsl.b  #1,D0   ; ASL A
02:0004A6DA E308            	  7414:     lsl.b  #1,D0   ; ASL A
02:0004A6DC E308            	  7415:     lsl.b  #1,D0   ; ASL A
02:0004A6DE E308            	  7416:     lsl.b  #1,D0   ; ASL A
02:0004A6E0 19802070        	  7417:     move.b  D0,($70,A4,D2.W)
                            	  7418:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7419:     ;
02:0004A6E4 101D            	  7420:     move.b  (A5)+,D0  ; PLA
02:0004A6E6 020000F0        	  7421:     andi.b #$F0,D0
02:0004A6EA 003C0011        	  7422:     ori     #$11,CCR  ; SEC: set C+X
02:0004A6EE 123C0003        	  7423:     move.b  #$03,D1
02:0004A6F2 0A3C0010        	  7424:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A6F6 9101            	  7425:     subx.b  D1,D0   ; SBC #$03
02:0004A6F8 0A3C0010        	  7426:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A6FC 41EC0084        	  7427:     lea     ($0084,A4),A0
02:0004A700 11802000        	  7428:     move.b  D0,(A0,D2.W)
                            	  7429:     ; Set the monsters-from-edges long timer to a random value
                            	  7430:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7431:     ;
02:0004A704 10342019        	  7432:     move.b  ($19,A4,D2.W),D0
02:0004A708 02000003        	  7433:     andi.b #$03,D0
02:0004A70C 023C00EE        	  7434:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A710 123C0002        	  7435:     move.b  #$02,D1
02:0004A714 D101            	  7436:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004A716 1940004B        	  7437:     move.b  D0,($004B,A4)
                            	  7438:     ; If the distance to Link is too close to Link, then
                            	  7439:     ; go flag the monster uninitialized again, so we can
                            	  7440:     ; try to spawn it again next time.
