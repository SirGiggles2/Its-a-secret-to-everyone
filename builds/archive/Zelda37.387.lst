02:00038AF8 E308            	  1489:     lsl.b  #1,D0   ; ASL A
02:00038AFA E308            	  1490:     lsl.b  #1,D0   ; ASL A
02:00038AFC E308            	  1491:     lsl.b  #1,D0   ; ASL A
