02:0003ACE2 0C0000F4        	  6252:     cmpi.b  #$F4,D0
02:0003ACE6 643C            	  6253:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  6254:     ; Else blocked by something else.
