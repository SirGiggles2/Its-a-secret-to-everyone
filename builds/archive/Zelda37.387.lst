02:00042628 123C001A        	  8618:     move.b  #$1A,D1
02:0004262C 0A3C0010        	  8619:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042630 9101            	  8620:     subx.b  D1,D0   ; SBC #$1A
02:00042632 0A3C0010        	  8621:     eori    #$10,CCR  ; restore X = 6502 C
02:00042636 E208            	  8622:     lsr.b  #1,D0   ; LSR A
