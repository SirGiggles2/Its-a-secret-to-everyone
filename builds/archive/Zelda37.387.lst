                            	  6210:     even
                            	  6211: _L_z07_SetUpWeaponWithState_ChooseSpeed:
                            	  6212:     ; If high bit of state is set, use $A0 else $C0 for the q-speed fraction.
                            	  6213:     ;
                            	  6214:     ; The high bit is set for magic shot, and reset for sword shot.
                            	  6215:     ;
02:00049D62 163C00C0        	  6216:     move.b  #$C0,D3
02:00049D66 41EC00AC        	  6217:     lea     ($00AC,A4),A0
02:00049D6A 10302000        	  6218:     move.b  (A0,D2.W),D0
02:00049D6E E308            	  6219:     lsl.b  #1,D0   ; ASL A
02:00049D70 6404            	  6220:     bcc  _anon_z07_35
02:00049D72 163C00A0        	  6221:     move.b  #$A0,D3
                            	  6222: _anon_z07_35:
02:00049D76 1003            	  6223:     move.b  D3,D0
02:00049D78 41EC03BC        	  6224:     lea     ($03BC,A4),A0
02:00049D7C 11802000        	  6225:     move.b  D0,(A0,D2.W)
                            	  6226:     ; Set the shot object's grid offset the same as the player's.
                            	  6227:     ;
02:00049D80 102C0394        	  6228:     move.b  ($0394,A4),D0
02:00049D84 41EC0394        	  6229:     lea     ($0394,A4),A0
02:00049D88 11802000        	  6230:     move.b  D0,(A0,D2.W)
