02:0003AE4C 7600            	  6415:     moveq   #0,D3
02:0003AE4E 1600            	  6416:     move.b  D0,D3
02:0003AE50 41F90003AC60    	  6417:     lea     (PolsVoiceDirections).l,A0
02:0003AE56 10303000        	  6418:     move.b  (A0,D3.W),D0
02:0003AE5A 41EC0098        	  6419:     lea     ($0098,A4),A0
02:0003AE5E 11802000        	  6420:     move.b  D0,(A0,D2.W)
                            	  6421:     ; Randomly set distance-to-move to $30 or $70.
                            	  6422:     ;
