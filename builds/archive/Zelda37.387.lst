02:000390C6 41EC03BC        	  2340:     lea     ($03BC,A4),A0
02:000390CA 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:000390CE 41F90003903C    	  2342:     lea     (BlueLeeverStateTimes).l,A0
