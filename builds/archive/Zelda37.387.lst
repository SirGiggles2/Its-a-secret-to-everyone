02:0003AA52 41EC042C        	  5899:     lea     ($042C,A4),A0
02:0003AA56 10302000        	  5900:     move.b  (A0,D2.W),D0
02:0003AA5A 4EB90002AECA    	  5901:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  5902:     even
                            	  5903: UpdateDodongoState1_Bloated_JumpTable:
02:0003AA60 0003AA74        	  5904:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA64 0003AA74        	  5905:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA68 0003AA74        	  5906:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA6C 0003AB0C        	  5907:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA70 0003AB12        	  5908:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
