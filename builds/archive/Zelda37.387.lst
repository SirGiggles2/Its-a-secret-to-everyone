02:000338C6 41EC0201        	  2507:     lea     ($0201,A4),A0
02:000338CA 11803000        	  2508:     move.b  D0,(A0,D3.W)
02:000338CE 5303            	  2509:     subq.b  #1,D3
02:000338D0 6AEA            	  2510:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000338D2 7600            	  2511:     moveq   #0,D3
02:000338D4 162C0016        	  2512:     move.b  ($0016,A4),D3
02:000338D8 41F900033140    	  2513:     lea     (ModeEandFSlotCursorYs).l,A0
02:000338DE 10303000        	  2514:     move.b  (A0,D3.W),D0
02:000338E2 19400084        	  2515:     move.b  D0,($0084,A4)
02:000338E6 19400200        	  2516:     move.b  D0,($0200,A4)
02:000338EA 102C0012        	  2517:     move.b  ($0012,A4),D0
02:000338EE 0C00000F        	  2518:     cmpi.b  #$0F,D0
                            	  2519:     ; There's more work in mode $E.
                            	  2520:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2521:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000338F2 6736            	  2522:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
