                            	  4676: UpdatePeaceTextbox:
                            	  4677:     ; Only emit a character once every 8 frames --
                            	  4678:     ; when (counter [0412] MOD 8) = 4.
                            	  4679:     ;
02:00034F66 522C0412        	  4680:     addq.b  #1,($0412,A4)
02:00034F6A 102C0412        	  4681:     move.b  ($0412,A4),D0
02:00034F6E 02000007        	  4682:     andi.b #$07,D0
02:00034F72 0C000004        	  4683:     cmpi.b  #$04,D0
02:00034F76 665C            	  4684:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4685:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4686:     ; to the dynamic transfer buf.
                            	  4687:     ;
02:00034F78 7604            	  4688:     moveq   #4,D3
                            	  4689: _anon_z02_35:
02:00034F7A 41F900034EF6    	  4690:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00034F80 10303000        	  4691:     move.b  (A0,D3.W),D0
02:00034F84 41EC0302        	  4692:     lea     ($0302,A4),A0
02:00034F88 11803000        	  4693:     move.b  D0,(A0,D3.W)
02:00034F8C 5303            	  4694:     subq.b  #1,D3
02:00034F8E 6AEA            	  4695:     bpl  _anon_z02_35
                            	  4696:     ; Load a character from the string and copy it to
                            	  4697:     ; the transfer record until we read character $FF.
                            	  4698:     ;
02:00034F90 7600            	  4699:     moveq   #0,D3
02:00034F92 162C0413        	  4700:     move.b  ($0413,A4),D3
02:00034F96 41F900034F30    	  4701:     lea     (PeaceText).l,A0
02:00034F9C 10303000        	  4702:     move.b  (A0,D3.W),D0
02:00034FA0 0C0000FF        	  4703:     cmpi.b  #$FF,D0
02:00034FA4 6730            	  4704:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034FA6 19400305        	  4705:     move.b  D0,($0305,A4)
                            	  4706:     ; A regular space takes as much time to emit as any character.
                            	  4707:     ; But it makes no sound.
                            	  4708:     ;
02:00034FAA 0C000024        	  4709:     cmpi.b  #$24,D0
02:00034FAE 6706            	  4710:     beq  _anon_z02_36
02:00034FB0 7010            	  4711:     moveq   #16,D0
02:00034FB2 19400604        	  4712:     move.b  D0,($0604,A4)
                            	  4713: _anon_z02_36:
                            	  4714:     ; Point to the next character in the string.
                            	  4715:     ;
02:00034FB6 522C0413        	  4716:     addq.b  #1,($0413,A4)
                            	  4717:     ; Replace the low byte of the VRAM address with the one
                            	  4718:     ; where the next character should be written.
                            	  4719:     ;
02:00034FBA 41F900034EFC    	  4720:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00034FC0 10303000        	  4721:     move.b  (A0,D3.W),D0
02:00034FC4 19400303        	  4722:     move.b  D0,($0303,A4)
                            	  4723:     ; Once the low VRAM address rolls over,
                            	  4724:     ; increment the high address.
                            	  4725:     ;
02:00034FC8 0C0000A0        	  4726:     cmpi.b  #$A0,D0
02:00034FCC 6406            	  4727:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:00034FCE 7023            	  4728:     moveq   #35,D0
02:00034FD0 19400302        	  4729:     move.b  D0,($0302,A4)
