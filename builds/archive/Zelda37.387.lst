                            	  3456:     ; State 0.
                            	  3457:     ;
                            	  3458:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  3459:     ; bracelet, then return.
                            	  3460:     ;
02:0003985A 41EC034F        	  3461:     lea     ($034F,A4),A0
02:0003985E 10302000        	  3462:     move.b  (A0,D2.W),D0
02:00039862 0C000065        	  3463:     cmpi.b  #$65,D0
