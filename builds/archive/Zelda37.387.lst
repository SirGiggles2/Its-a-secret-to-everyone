                            	  5910:     even
                            	  5911: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5912:     ; Bloated timer =>
                            	  5913:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5914:     ; 1:     go advance the substate
                            	  5915:     ; other: go decrement Bloated timer
                            	  5916:     ;
02:0003AA74 7600            	  5917:     moveq   #0,D3
02:0003AA76 41EC045E        	  5918:     lea     ($045E,A4),A0
02:0003AA7A 16302000        	  5919:     move.b  (A0,D2.W),D3
02:0003AA7E 5303            	  5920:     subq.b  #1,D3
02:0003AA80 6750            	  5921:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003AA82 6B04            	  5922:     bmi.s  __far_z_04_0051
02:0003AA84 60000080        	  5923:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5924: __far_z_04_0051:
                            	  5925:     ; Set the bloated timer according to the substate.
                            	  5926:     ;
02:0003AA88 7600            	  5927:     moveq   #0,D3
02:0003AA8A 41EC042C        	  5928:     lea     ($042C,A4),A0
02:0003AA8E 16302000        	  5929:     move.b  (A0,D2.W),D3
02:0003AA92 41F90003A9D0    	  5930:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003AA98 10303000        	  5931:     move.b  (A0,D3.W),D0
02:0003AA9C 41EC045E        	  5932:     lea     ($045E,A4),A0
02:0003AAA0 11802000        	  5933:     move.b  D0,(A0,D2.W)
                            	  5934:     ; If substate <> 0, go decrement bloated timer.
                            	  5935:     ;
02:0003AAA4 4A03            	  5936:     cmpi.b  #$00,D3
02:0003AAA6 6702            	  5937:     beq.s  __far_z_04_0052
02:0003AAA8 605C            	  5938:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5939: __far_z_04_0052:
                            	  5940:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5941:     ;
02:0003AAAA 7610            	  5942:     moveq   #16,D3
02:0003AAAC 7000            	  5943:     moveq   #0,D0
02:0003AAAE 41EC00AC        	  5944:     lea     ($00AC,A4),A0
02:0003AAB2 11803000        	  5945:     move.b  D0,(A0,D3.W)
                            	  5946:     ; Increment the number of bomb hits.
                            	  5947:     ;
02:0003AAB6 41EC0437        	  5948:     lea     ($0437,A4),A0
02:0003AABA 10302000        	  5949:     move.b  (A0,D2.W),D0
