                            	  2388:     even
                            	  2389: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  2390:     ; Or else if is zora in state 1 or 5, then use one of
                            	  2391:     ; the mound frame images:
                            	  2392:     ;
                            	  2393:     ; frame image := ((state - 1) * 2) + movement frame
                            	  2394:     ;
                            	  2395:     ; This yields 0/1 or 8/9, depending on the state.
                            	  2396:     ;
                            	  2397:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  2398:     ;
02:00039132 003C0011        	  2399:     ori     #$11,CCR  ; SEC: set C+X
02:00039136 123C0001        	  2400:     move.b  #$01,D1
02:0003913A 0A3C0010        	  2401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003913E 9101            	  2402:     subx.b  D1,D0   ; SBC #$01
02:00039140 0A3C0010        	  2403:     eori    #$10,CCR  ; restore X = 6502 C
02:00039144 E308            	  2404:     lsl.b  #1,D0   ; ASL A
02:00039146 023C00EE        	  2405:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003914A 41EC03E4        	  2406:     lea     ($03E4,A4),A0
02:0003914E 12302000        	  2407:     move.b  (A0,D2.W),D1
02:00039152 D101            	  2408:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  2409:     even
                            	  2410: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw:
02:00039154 4EB900030C38    	  2411:     jsr     DrawObjectMirrored
                            	  2412:     ; If not zora and state <> 3, 
                            	  2413:     ; or zora and state <> 2, 3, 4;
                            	  2414:     ; then return.
                            	  2415:     ;
02:0003915A 41EC034F        	  2416:     lea     ($034F,A4),A0
02:0003915E 10302000        	  2417:     move.b  (A0,D2.W),D0
02:00039162 0C000011        	  2418:     cmpi.b  #$11,D0
02:00039166 6614            	  2419:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00039168 41EC00AC        	  2420:     lea     ($00AC,A4),A0
02:0003916C 10302000        	  2421:     move.b  (A0,D2.W),D0
02:00039170 0C000002        	  2422:     cmpi.b  #$02,D0
02:00039174 6714            	  2423:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00039176 0C000004        	  2424:     cmpi.b  #$04,D0
02:0003917A 670E            	  2425:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
                            	  2426:     even
