                            	  9638:     ;
02:0003C672 102C0085        	  9639:     move.b  ($0085,A4),D0
02:0003C676 003C0011        	  9640:     ori     #$11,CCR  ; SEC: set C+X
02:0003C67A 1214            	  9641:     move.b  ($0000,A4),D1
02:0003C67C 0A3C0010        	  9642:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C680 9101            	  9643:     subx.b  D1,D0   ; SBC $00
02:0003C682 0A3C0010        	  9644:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C686 41EC0084        	  9645:     lea     ($0084,A4),A0
02:0003C68A 11802000        	  9646:     move.b  D0,(A0,D2.W)
                            	  9647:     even
