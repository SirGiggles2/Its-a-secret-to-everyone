                            	   931: 
                            	   932: ;------------------------------------------------------------------------------
                            	   933: ; _c_move_object_shim — MoveObject trampoline.
                            	   934: ;
                            	   935: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   936: ;   Input:     D2 = slot (0..11)
                            	   937: ;   Preserves: D2, A4, A5
                            	   938: ;   Clobbers:  D0, D1, D3, A0
                            	   939: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   940: ;
                            	   941: ; GCC side:
                            	   942: ;   void c_move_object(unsigned short slot);
                            	   943: ;     slot arrives as a 16-bit value on the stack.
                            	   944: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   945: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   946: ;   never clobbered by gcc.
                            	   947: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   948: ;   semantics can exist in a pure C port).
                            	   949: ;------------------------------------------------------------------------------
                            	   950: _c_move_object_shim:
                            	   951:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   952:     move.b  #$AA,($0900,A4)
                            	   953:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   954:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   955:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   956:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   957:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   958:     moveq   #0,D0
02:0002B658 3002            	   959:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   960:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   961:     jsr     c_move_object
02:0002B662 588F            	   962:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   963:     rts
                            	   964: 
                            	   965: ;==============================================================================
                            	   966: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   967: ; and tail-call the native asm function.
                            	   968: ;
                            	   969: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   970: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   971: ; sign-extended).
                            	   972: ;==============================================================================
                            	   973: 
                            	   974: ;------------------------------------------------------------------------------
                            	   975: ; void c_copy_bank_to_window(unsigned int bank);
                            	   976: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   977: ;------------------------------------------------------------------------------
                            	   978: c_copy_bank_to_window:
02:0002B666 202F0004        	   979:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   980:     jmp     _copy_bank_to_window
                            	   981: 
                            	   982: ;------------------------------------------------------------------------------
                            	   983: ; unsigned char c_ppu_read_2(void);
                            	   984: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   985: ; C return: gcc expects result in D0.
                            	   986: ;------------------------------------------------------------------------------
                            	   987: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   988:     jmp     _ppu_read_2
                            	   989: 
                            	   990: ;------------------------------------------------------------------------------
                            	   991: ; void c_ppu_write_6(unsigned int val);
                            	   992: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   993: ;------------------------------------------------------------------------------
                            	   994: c_ppu_write_6:
02:0002B674 202F0004        	   995:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   996:     jmp     _ppu_write_6
                            	   997: 
                            	   998: ;------------------------------------------------------------------------------
                            	   999: ; void c_ppu_write_7(unsigned int val);
                            	  1000: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1001: ;------------------------------------------------------------------------------
                            	  1002: c_ppu_write_7:
02:0002B67E 202F0004        	  1003:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1004:     jmp     _ppu_write_7
                            	  1005: 
                            	  1006: ;------------------------------------------------------------------------------
                            	  1007: ; void c_turn_off_all_video(void);
                            	  1008: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1009: ;------------------------------------------------------------------------------
                            	  1010: c_turn_off_all_video:
02:0002B688 4EF900047E2E    	  1011:     jmp     TurnOffAllVideo
                            	  1012: 
                            	  1013: ;==============================================================================
                            	  1014: ; EXPORT side — z_03 entry point.
                            	  1015: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1016: ; the transpiler emits that label pointing to this shim instead of the
                            	  1017: ; z_03 asm body. The C function takes no args and returns void.
                            	  1018: ;==============================================================================
                            	  1019: 
                            	  1020: ;------------------------------------------------------------------------------
                            	  1021: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1022: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1023: ;------------------------------------------------------------------------------
                            	  1024: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1025:     jmp     z03_transfer_level_pattern_blocks
                            	  1026: 
                            	  1027: ;==============================================================================
                            	  1028: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1029: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1030: ;==============================================================================
                            	  1031: 
                            	  1032: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1033:     jmp     z06_init_mode2_submodes
                            	  1034: 
                            	  1035: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1036:     jmp     z06_copy_common_data_to_ram
                            	  1037: 
                            	  1038: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1039:     jmp     z06_update_mode2_load_full
                            	  1040: 
                            	  1041: ;==============================================================================
                            	  1042: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1043: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1044: ;==============================================================================
                            	  1045: 
                            	  1046: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1047:     jmp     z05_copy_column_to_tilebuf
                            	  1048: 
                            	  1049: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	  1050:     jmp     z05_copy_row_to_tilebuf
                            	  1051: 
                            	  1052: ;==============================================================================
                            	  1053: ; EXPORT side — z_05 entry points (Stage 4a).
