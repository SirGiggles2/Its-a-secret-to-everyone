                            	  2464: UpdateRedLeever:
02:000391C0 41EC00AC        	  2465:     lea     ($00AC,A4),A0
02:000391C4 10302000        	  2466:     move.b  (A0,D2.W),D0
02:000391C8 6704            	  2467:     beq  _anon_z04_42
