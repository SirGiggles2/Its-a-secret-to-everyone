                            	  1586: _TryShooting:
02:00038B9A 19400001        	  1587:     move.b  D0,($0001,A4)
                            	  1588:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1589:     ;
02:00038B9E 41EC034F        	  1590:     lea     ($034F,A4),A0
02:00038BA2 10302000        	  1591:     move.b  (A0,D2.W),D0
02:00038BA6 0C000003        	  1592:     cmpi.b  #$03,D0
02:00038BAA 6726            	  1593:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BAC 0C000001        	  1594:     cmpi.b  #$01,D0
02:00038BB0 6720            	  1595:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BB2 0C000009        	  1596:     cmpi.b  #$09,D0
02:00038BB6 671A            	  1597:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BB8 0C00000A        	  1598:     cmpi.b  #$0A,D0
02:00038BBC 6714            	  1599:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BBE 41EC0451        	  1600:     lea     ($0451,A4),A0
02:00038BC2 10302000        	  1601:     move.b  (A0,D2.W),D0
02:00038BC6 660A            	  1602:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1603:     ; and a random value < $F8, then return.
                            	  1604:     ;
02:00038BC8 10342018        	  1605:     move.b  ($18,A4,D2.W),D0
02:00038BCC 0C0000F8        	  1606:     cmpi.b  #$F8,D0
02:00038BD0 656C            	  1607:     bcs  _L_z04__TryShooting_Exit
                            	  1608:     even
                            	  1609: _L_z04__TryShooting_TryShootingNow:
                            	  1610:     ; Summary
                            	  1611:     ;
                            	  1612:     ; if temporarily invincible then
                            	  1613:     ;   shoot timer := 0
                            	  1614:     ; elif shoot timer > 0 then
                            	  1615:     ;   decrement shoot timer
                            	  1616:     ; elif wants to shoot then
                            	  1617:     ;   shoot timer := $30
                            	  1618:     ;
                            	  1619:     ; qspeed := [01]
                            	  1620:     ;
                            	  1621:     ; if shoot timer <> 0 then
                            	  1622:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1623:     ;     shoot
                            	  1624:     ;     if succeeded then
                            	  1625:     ;       shoot timer := 0
                            	  1626:     ;       qspeed := 0
                            	  1627:     ;   else
                            	  1628:     ;     qspeed := 0
                            	  1629:     ;
                            	  1630:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038BD2 102C0001        	  1631:     move.b  ($0001,A4),D0
02:00038BD6 1883            	  1632:     move.b  D3,($0000,A4)
02:00038BD8 1B00            	  1633:     move.b  D0,-(A5)  ; PHA
02:00038BDA 7600            	  1634:     moveq   #0,D3
                            	  1635:     ; If not temporarily invincible,
                            	  1636:     ;
02:00038BDC 41EC04F0        	  1637:     lea     ($04F0,A4),A0
02:00038BE0 10302000        	  1638:     move.b  (A0,D2.W),D0
02:00038BE4 661A            	  1639:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1640:     ; then Y := shoot timer - 1
                            	  1641:     ;
02:00038BE6 7600            	  1642:     moveq   #0,D3
02:00038BE8 41EC0451        	  1643:     lea     ($0451,A4),A0
02:00038BEC 16302000        	  1644:     move.b  (A0,D2.W),D3
02:00038BF0 5303            	  1645:     subq.b  #1,D3
                            	  1646:     ; If Y register < 0, then shoot timer is 0.
                            	  1647:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1648:     ; Else go set a non-zero speed and return.
                            	  1649:     ;
02:00038BF2 6A0C            	  1650:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038BF4 41EC0412        	  1651:     lea     ($0412,A4),A0
02:00038BF8 10302000        	  1652:     move.b  (A0,D2.W),D0
02:00038BFC 6736            	  1653:     beq  _L_z04__TryShooting_SetSpeed
02:00038BFE 7630            	  1654:     moveq   #48,D3
                            	  1655:     even
                            	  1656: _L_z04__TryShooting_SetShootTimer:
                            	  1657:     ; shoot timer := Y
                            	  1658:     ;
02:00038C00 1003            	  1659:     move.b  D3,D0
02:00038C02 41EC0451        	  1660:     lea     ($0451,A4),A0
02:00038C06 11802000        	  1661:     move.b  D0,(A0,D2.W)
                            	  1662:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1663:     ;
02:00038C0A 6728            	  1664:     beq  _L_z04__TryShooting_SetSpeed
                            	  1665:     ; shoot timer <> 0
                            	  1666:     ; If shoot timer <> $10, then go set a zero speed.
