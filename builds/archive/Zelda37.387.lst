                            	  3468: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  3469:     ; If there is a mismatch between the current quest and the quest
                            	  3470:     ; needed for the secret in this room, then return.
                            	  3471:     ;
02:00039870 6100021C        	  3472:     jsr     IsQuestSecretMismatch
02:00039874 6500008A        	  3473:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  3474:     ; The gravestone and rocks can only be pushed vertically.
                            	  3475:     ; Return, if X's don't match.
                            	  3476:     ;
02:00039878 102C0070        	  3477:     move.b  ($0070,A4),D0
02:0003987C 12342070        	  3478:     move.b  ($70,A4,D2.W),D1
02:00039880 B001            	  3479:     cmp.b   D1,D0
02:00039882 667C            	  3480:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  3481:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  3482:     ; is positive; then go use it along with a flag that indicates that
                            	  3483:     ; Link is "down" from the object.
                            	  3484:     ;
02:00039884 7600            	  3485:     moveq   #0,D3
02:00039886 102C0084        	  3486:     move.b  ($0084,A4),D0
02:0003988A 023C00EE        	  3487:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003988E 123C0003        	  3488:     move.b  #$03,D1
02:00039892 D101            	  3489:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039894 003C0011        	  3490:     ori     #$11,CCR  ; SEC: set C+X
02:00039898 41EC0084        	  3491:     lea     ($0084,A4),A0
02:0003989C 12302000        	  3492:     move.b  (A0,D2.W),D1
02:000398A0 0A3C0010        	  3493:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000398A4 9101            	  3494:     subx.b  D1,D0   ; SBC ObjY,X
02:000398A6 0A3C0010        	  3495:     eori    #$10,CCR  ; restore X = 6502 C
02:000398AA 6A0E            	  3496:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  3497:     ; Else negate it, and indicate Link is "up" from the object.
                            	  3498:     ;
02:000398AC 5203            	  3499:     addq.b  #1,D3
02:000398AE 4600            	  3500:     eori.b #$FF,D0
02:000398B0 023C00EE        	  3501:     andi    #$EE,CCR  ; CLC: clear C+X
02:000398B4 123C0001        	  3502:     move.b  #$01,D1
02:000398B8 D101            	  3503:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  3504:     even
