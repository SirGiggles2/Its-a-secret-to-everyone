02:0003A8AE 41EC0478        	  5669:     lea     ($0478,A4),A0
02:0003A8B2 12302000        	  5670:     move.b  (A0,D2.W),D1
02:0003A8B6 D101            	  5671:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A8B8 41EC0084        	  5672:     lea     ($0084,A4),A0
02:0003A8BC 11802000        	  5673:     move.b  D0,(A0,D2.W)
