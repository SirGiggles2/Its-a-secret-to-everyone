02:0003D326 11802000        	 11506:     move.b  D0,(A0,D2.W)
                            	 11507:     ; And subtract the product's whole part from the X coordinate with carry.
                            	 11508:     ;
02:0003D32A 10342070        	 11509:     move.b  ($70,A4,D2.W),D0
02:0003D32E 122C0003        	 11510:     move.b  ($0003,A4),D1
02:0003D332 0A3C0010        	 11511:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D336 9101            	 11512:     subx.b  D1,D0   ; SBC $03
02:0003D338 0A3C0010        	 11513:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D33C 6024            	 11514:     jmp     _L_z04_RotateObjectLocation_SetXRotateY
                            	 11515: 
