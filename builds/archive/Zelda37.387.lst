02:00038D3C 41EC00AC        	  1869:     lea     ($00AC,A4),A0
02:00038D40 10302000        	  1870:     move.b  (A0,D2.W),D0
02:00038D44 660000C0        	  1871:     bne  _L_z04_UpdateTektiteOrBoulder_State1
