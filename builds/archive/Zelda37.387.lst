02:0003A990 41F900030C04    	  5804:     lea     (SpriteOffsets).l,A0
02:0003A996 10303000        	  5805:     move.b  (A0,D3.W),D0
02:0003A99A 7600            	  5806:     moveq   #0,D3
02:0003A99C 1600            	  5807:     move.b  D0,D3
02:0003A99E 101D            	  5808:     move.b  (A5)+,D0  ; PLA
02:0003A9A0 41EC0201        	  5809:     lea     ($0201,A4),A0
02:0003A9A4 11803000        	  5810:     move.b  D0,(A0,D3.W)
02:0003A9A8 1014            	  5811:     move.b  ($0000,A4),D0
02:0003A9AA 41EC0203        	  5812:     lea     ($0203,A4),A0
02:0003A9AE 11803000        	  5813:     move.b  D0,(A0,D3.W)
02:0003A9B2 102C0001        	  5814:     move.b  ($0001,A4),D0
