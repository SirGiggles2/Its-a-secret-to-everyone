                            	   814: TransferDemoPatterns:
02:0002F3D6 4EB900047E2E    	   815:     jsr     TurnOffAllVideo
02:0002F3DC 4EB90000E034    	   816:     jsr     _ppu_read_2  ; PPU $2002 read → D0
                            	   817:     even
                            	   818: _L_z01_TransferDemoPatterns_LoopBlock:
                            	   819:     ; Loop over each block.
                            	   820:     ;
02:0002F3E2 102C051D        	   821:     move.b  ($051D,A4),D0
02:0002F3E6 E308            	   822:     lsl.b  #1,D0   ; ASL A
02:0002F3E8 7400            	   823:     moveq   #0,D2
02:0002F3EA 1400            	   824:     move.b  D0,D2
                            	   825:     ; Put block address in [00:01] and size in [03:02].
                            	   826:     ; Load destination VRAM address and set it.
                            	   827:     ; The size and VRAM address have the high byte first.
                            	   828:     ;
02:0002F3EC 41F90002F3C6    	   829:     lea     (DemoPatternBlockAddrs).l,A0
02:0002F3F2 3A02            	   830:     move.w  D2,D5
02:0002F3F4 DA45            	   831:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0002F3F6 2A305000        	   832:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002F3FA 29450004        	   833:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002F3FE 41F90002F3CE    	   834:     lea     (DemoPatternBlockSizes).l,A0
02:0002F404 10302000        	   835:     move.b  (A0,D2.W),D0
02:0002F408 19400002        	   836:     move.b  D0,($0002,A4)
02:0002F40C 41F90002F3D2    	   837:     lea     (DemoPatternVramAddrs).l,A0
02:0002F412 10302000        	   838:     move.b  (A0,D2.W),D0
02:0002F416 4EB90000E32C    	   839:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0002F41C 5202            	   840:     addq.b  #1,D2
                            	   841:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:0002F41E 41F90002F3CE    	   842:     lea     (DemoPatternBlockSizes).l,A0
