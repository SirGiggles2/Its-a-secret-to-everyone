02:00049D4E 10342070        	  6201:     move.b  ($70,A4,D2.W),D0
02:00049D52 0C000014        	  6202:     cmpi.b  #$14,D0
02:00049D56 6402            	  6203:     bcc.s  __far_z_07_0095
02:00049D58 6034            	  6204:     jmp  ResetObjState
                            	  6205: __far_z_07_0095:
02:00049D5A 0C0000EC        	  6206:     cmpi.b  #$EC,D0
02:00049D5E 6502            	  6207:     bcs.s  __far_z_07_0096
02:00049D60 602C            	  6208:     jmp  ResetObjState
