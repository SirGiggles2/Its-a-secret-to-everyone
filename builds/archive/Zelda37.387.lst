                            	  5922:     even
                            	  5923: UpdateRodOrArrow:
                            	  5924:     ; The rod uses states $3x. Arrow uses $1x and $2x.
                            	  5925:     ;
02:00049B3C 41EC00AC        	  5926:     lea     ($00AC,A4),A0
02:00049B40 10302000        	  5927:     move.b  (A0,D2.W),D0
02:00049B44 020000F0        	  5928:     andi.b #$F0,D0
02:00049B48 0C000030        	  5929:     cmpi.b  #$30,D0
02:00049B4C 6502            	  5930:     bcs.s  __far_z_07_0090
02:00049B4E 6024            	  5931:     jmp  UpdateSwordOrRod
                            	  5932: __far_z_07_0090:
02:00049B50 6000FB70        	  5933:     jmp     UpdateArrowOrBoomerang
                            	  5934: 
                            	  5935: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5936: ; Each set contains 4 offsets in reverse direction index order:
                            	  5937: ; up, down, left, right
                            	  5938: ;
                            	  5939: ; These offsets are added to player X to get weapon X.
                            	  5940: ;
                            	  5941:     even
                            	  5942: PlayerToWeaponOffsetsX:
02:00049B54 FF              	  5943:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:00049B55 01
02:00049B56 00
02:00049B57 F8
02:00049B58 FF
02:00049B59 01
02:00049B5A F5
02:00049B5B 0B
02:00049B5C FF              	  5944:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:00049B5D 01
02:00049B5E F9
02:00049B5F 07
02:00049B60 FF
02:00049B61 01
02:00049B62 FD
02:00049B63 03
                            	  5945: 
                            	  5946: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5947: ; Each set contains 4 offsets in reverse direction index order:
                            	  5948: ; up, down, left, right
                            	  5949: ;
                            	  5950: ; These offsets are added to player Y to get weapon Y.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PlayerToWeaponOffsetsY:
02:00049B64 F7              	  5954:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:00049B65 F2
02:00049B66 F5
02:00049B67 F5
02:00049B68 F6
02:00049B69 0D
02:00049B6A 03
02:00049B6B 03
02:00049B6C F7              	  5955:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:00049B6D 09
02:00049B6E 03
02:00049B6F 03
02:00049B70 FF
02:00049B71 05
02:00049B72 03
02:00049B73 03
                            	  5956: 
                            	  5957:     even
                            	  5958: UpdateSwordOrRod:
                            	  5959:     ; If state = 0, the object is not active. So, return.
                            	  5960:     ;
02:00049B74 41EC00AC        	  5961:     lea     ($00AC,A4),A0
02:00049B78 10302000        	  5962:     move.b  (A0,D2.W),D0
02:00049B7C 0200000F        	  5963:     andi.b #$0F,D0
02:00049B80 674C            	  5964:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5965:     ; Decrement the state timer.
                            	  5966:     ; If it hasn't expired, go move the sword or rod.
                            	  5967:     ;
02:00049B82 41EC03D0        	  5968:     lea     ($03D0,A4),A0
02:00049B86 53302000        	  5969:     subq.b  #1,(A0,D2.W)
02:00049B8A 6644            	  5970:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5971:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5972:     ;
02:00049B8C 41EC00AC        	  5973:     lea     ($00AC,A4),A0
02:00049B90 10302000        	  5974:     move.b  (A0,D2.W),D0
02:00049B94 0200000F        	  5975:     andi.b #$0F,D0
02:00049B98 7600            	  5976:     moveq   #0,D3
02:00049B9A 1600            	  5977:     move.b  D0,D3
02:00049B9C 7008            	  5978:     moveq   #8,D0
02:00049B9E 5303            	  5979:     subq.b  #1,D3
02:00049BA0 6702            	  5980:     beq  _anon_z07_32
02:00049BA2 7001            	  5981:     moveq   #1,D0
                            	  5982: _anon_z07_32:
                            	  5983:     ; Set both the player's animation counter and the sword's
                            	  5984:     ; animation counter/timer to this value.
                            	  5985:     ;
02:00049BA4 194003D0        	  5986:     move.b  D0,($03D0,A4)
02:00049BA8 41EC03D0        	  5987:     lea     ($03D0,A4),A0
02:00049BAC 11802000        	  5988:     move.b  D0,(A0,D2.W)
                            	  5989:     ; Go to the next state.
                            	  5990:     ;
02:00049BB0 41EC00AC        	  5991:     lea     ($00AC,A4),A0
02:00049BB4 52302000        	  5992:     addq.b  #1,(A0,D2.W)
                            	  5993:     ; Once we reach state 6, deactivate the object.
                            	  5994:     ; Otherwise, go draw it.
                            	  5995:     ;
02:00049BB8 41EC00AC        	  5996:     lea     ($00AC,A4),A0
02:00049BBC 10302000        	  5997:     move.b  (A0,D2.W),D0
02:00049BC0 0200000F        	  5998:     andi.b #$0F,D0
02:00049BC4 0C000006        	  5999:     cmpi.b  #$06,D0
02:00049BC8 6506            	  6000:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:00049BCA 610001C2        	  6001:     jsr     ResetObjState
                            	  6002:     even
                            	  6003: _L_z07_UpdateSwordOrRod_Exit:
02:00049BCE 4E75            	  6004:     rts
                            	  6005: 
                            	  6006:     even
                            	  6007: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  6008:     ; Reset horizontal flipping in [0F].
                            	  6009:     ;
02:00049BD0 7000            	  6010:     moveq   #0,D0
02:00049BD2 1940000F        	  6011:     move.b  D0,($000F,A4)
                            	  6012:     ; If state = 5, return without drawing.
                            	  6013:     ;
02:00049BD6 41EC00AC        	  6014:     lea     ($00AC,A4),A0
02:00049BDA 10302000        	  6015:     move.b  (A0,D2.W),D0
02:00049BDE 0200000F        	  6016:     andi.b #$0F,D0
02:00049BE2 7600            	  6017:     moveq   #0,D3
02:00049BE4 1600            	  6018:     move.b  D0,D3
02:00049BE6 103C00FC        	  6019:     move.b  #$FC,D0
02:00049BEA 0C030005        	  6020:     cmpi.b  #$05,D3
02:00049BEE 67DE            	  6021:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  6022:     even
                            	  6023: _L_z07_UpdateSwordOrRod_Add4:
                            	  6024:     ; Set [00] to (state - 1) * 4:
                            	  6025:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6026:     ;
02:00049BF0 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049BF4 123C0004        	  6028:     move.b  #$04,D1
02:00049BF8 D101            	  6029:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00049BFA 5303            	  6030:     subq.b  #1,D3
02:00049BFC 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00049BFE 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
                            	  6034:     ; since the last frame.
                            	  6035:     ;
02:00049C00 102C0098        	  6036:     move.b  ($0098,A4),D0
02:00049C04 41EC0098        	  6037:     lea     ($0098,A4),A0
02:00049C08 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:00049C0C 4EB90003086C    	  6042:     jsr     GetOppositeDir
02:00049C12 1003            	  6043:     move.b  D3,D0
02:00049C14 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049C18 1214            	  6045:     move.b  ($0000,A4),D1
02:00049C1A D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:00049C1C 7600            	  6047:     moveq   #0,D3
02:00049C1E 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:00049C20 102C0070        	  6052:     move.b  ($0070,A4),D0
02:00049C24 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049C28 41F900049B54    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00049C2E 12303000        	  6055:     move.b  (A0,D3.W),D1
02:00049C32 D101            	  6056:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00049C34 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:00049C38 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:00049C3A 102C0084        	  6062:     move.b  ($0084,A4),D0
02:00049C3E 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049C42 41F900049B64    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00049C48 12303000        	  6065:     move.b  (A0,D3.W),D1
02:00049C4C D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00049C4E 41EC0084        	  6067:     lea     ($0084,A4),A0
02:00049C52 11802000        	  6068:     move.b  D0,(A0,D2.W)
02:00049C56 19400001        	  6069:     move.b  D0,($0001,A4)
                            	  6070:     ; If state = 1, use up direction.
                            	  6071:     ; Else use object direction.
                            	  6072:     ;
02:00049C5A 41EC00AC        	  6073:     lea     ($00AC,A4),A0
02:00049C5E 10302000        	  6074:     move.b  (A0,D2.W),D0
02:00049C62 0200000F        	  6075:     andi.b #$0F,D0
02:00049C66 7600            	  6076:     moveq   #0,D3
02:00049C68 1600            	  6077:     move.b  D0,D3
02:00049C6A 7008            	  6078:     moveq   #8,D0
02:00049C6C 5303            	  6079:     subq.b  #1,D3
02:00049C6E 6708            	  6080:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00049C70 41EC0098        	  6081:     lea     ($0098,A4),A0
02:00049C74 10302000        	  6082:     move.b  (A0,D2.W),D0
