02:0003CACA 06              	 10256:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003CACB 08
02:0003CACC 07
02:0003CACD 09
02:0003CACE 00
02:0003CACF 00
02:0003CAD0 01
02:0003CAD1 01
