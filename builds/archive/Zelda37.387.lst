                            	  2346: _L_z04_UpdateBurrower_Animate:
                            	  2347:     ; Advance the animation counter; possibly setting a new
                            	  2348:     ; value according to the new state.
                            	  2349:     ;
02:000390DC 7600            	  2350:     moveq   #0,D3
02:000390DE 41EC00AC        	  2351:     lea     ($00AC,A4),A0
02:000390E2 16302000        	  2352:     move.b  (A0,D2.W),D3
02:000390E6 41F900039042    	  2353:     lea     (BlueLeeverStateAnimTimes).l,A0
