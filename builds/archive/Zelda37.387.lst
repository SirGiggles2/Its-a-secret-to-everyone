                            	  2345:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2346:     ; the name field.
02:0003377C 6646            	  2347:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:0003377E 7600            	  2348:     moveq   #0,D3
02:00033780 162C0016        	  2349:     move.b  ($0016,A4),D3
02:00033784 0C030003        	  2350:     cmpi.b  #$03,D3
02:00033788 6602            	  2351:     bne.s  __far_z_02_0003
02:0003378A 60E6            	  2352:     jmp  LA10A_Exit
                            	  2353: __far_z_02_0003:
                            	  2354:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2355:     ; in the current slot's name.
02:0003378C 41F9000331A0    	  2356:     lea     (SlotToNameOffset).l,A0
02:00033792 10303000        	  2357:     move.b  (A0,D3.W),D0
02:00033796 19400421        	  2358:     move.b  D0,($0421,A4)
                            	  2359:     ; Get the offset of the end of the initial name character
                            	  2360:     ; transfer record header for the current slot.
02:0003379A 7400            	  2361:     moveq   #0,D2
02:0003379C 41F9000331A4    	  2362:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:000337A2 14303000        	  2363:     move.b  (A0,D3.W),D2
02:000337A6 7602            	  2364:     moveq   #2,D3
                            	  2365:     even
                            	  2366: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:000337A8 41F900033170    	  2367:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:000337AE 10302000        	  2368:     move.b  (A0,D2.W),D0
02:000337B2 41EC0422        	  2369:     lea     ($0422,A4),A0
02:000337B6 11803000        	  2370:     move.b  D0,(A0,D3.W)
02:000337BA 5302            	  2371:     subq.b  #1,D2
02:000337BC 5303            	  2372:     subq.b  #1,D3
02:000337BE 6AE8            	  2373:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:000337C0 522C0420        	  2374:     addq.b  #1,($0420,A4)
                            	  2375:     even
                            	  2376: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2377:     ; At this point:
                            	  2378:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2379:     ;   - This will be changed as the player inputs characters.
                            	  2380:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2381:     ;   - This will be changed as the player inputs characters.
                            	  2382:     ; - InitializedNameField [$0420] is set to 1.
                            	  2383:     ;
02:000337C4 102C00F8        	  2384:     move.b  ($00F8,A4),D0
02:000337C8 020000C0        	  2385:     andi.b #$C0,D0
02:000337CC 670000E8        	  2386:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2387:     ; A or B was pressed.
                            	  2388:     ;
02:000337D0 0C000040        	  2389:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:000337D4 660000A6        	  2390:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2391:     ; A was pressed.
                            	  2392:     ;
                            	  2393:     ; Request to play the character click tune (same as bomb set).
02:000337D8 7620            	  2394:     moveq   #32,D3
02:000337DA 19430604        	  2395:     move.b  D3,($0604,A4)
02:000337DE 7602            	  2396:     moveq   #2,D3
                            	  2397:     even
                            	  2398: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:000337E0 41EC0422        	  2399:     lea     ($0422,A4),A0
02:000337E4 10303000        	  2400:     move.b  (A0,D3.W),D0
02:000337E8 41EC0302        	  2401:     lea     ($0302,A4),A0
02:000337EC 11803000        	  2402:     move.b  D0,(A0,D3.W)
02:000337F0 5303            	  2403:     subq.b  #1,D3
02:000337F2 6AEC            	  2404:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:000337F4 19430306        	  2405:     move.b  D3,($0306,A4)
02:000337F8 7400            	  2406:     moveq   #0,D2
02:000337FA 142C0421        	  2407:     move.b  ($0421,A4),D2
02:000337FE 7600            	  2408:     moveq   #0,D3
02:00033800 162C041F        	  2409:     move.b  ($041F,A4),D3
02:00033804 41F900033144    	  2410:     lea     (ModeE_CharMap).l,A0
02:0003380A 10303000        	  2411:     move.b  (A0,D3.W),D0
02:0003380E 19400305        	  2412:     move.b  D0,($0305,A4)
02:00033812 41EC0638        	  2413:     lea     ($0638,A4),A0
02:00033816 11802000        	  2414:     move.b  D0,(A0,D2.W)
                            	  2415:     even
                            	  2416: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:0003381A 102C0070        	  2417:     move.b  ($0070,A4),D0
02:0003381E 023C00EE        	  2418:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033822 123C0008        	  2419:     move.b  #$08,D1
02:00033826 D101            	  2420:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00033828 19400070        	  2421:     move.b  D0,($0070,A4)
02:0003382C 522C0421        	  2422:     addq.b  #1,($0421,A4)
02:00033830 522C0423        	  2423:     addq.b  #1,($0423,A4)
                            	  2424:     ; If VRAM address still points inside the name field,
                            	  2425:     ; then go finish.
                            	  2426:     ;
                            	  2427:     ; The idea is that each name field in nametable begins at
                            	  2428:     ; an address ending in $E. For example, slot 0 has a name
                            	  2429:     ; at VRAM addresses $20CE to $20D5.
                            	  2430:     ;
                            	  2431:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2432:     ; the name field.
                            	  2433:     ;
                            	  2434:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2435:     ; record header.
                            	  2436:     ;
02:00033834 102C0070        	  2437:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00033838 0C0000B0        	  2438:     cmpi.b  #$B0,D0
02:0003383C 6678            	  2439:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2440:     ; The VRAM address now points outside the name field.
                            	  2441:     ; So, wrap around to the beginning of the name field.
                            	  2442:     ;
                            	  2443:     ; For example, $20D6 -> $20CE.
                            	  2444:     ;
02:0003383E 102C0423        	  2445:     move.b  ($0423,A4),D0
02:00033842 003C0011        	  2446:     ori     #$11,CCR  ; SEC: set C+X
02:00033846 123C0008        	  2447:     move.b  #$08,D1
02:0003384A 0A3C0010        	  2448:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003384E 9101            	  2449:     subx.b  D1,D0   ; SBC #$08
02:00033850 0A3C0010        	  2450:     eori    #$10,CCR  ; restore X = 6502 C
02:00033854 19400423        	  2451:     move.b  D0,($0423,A4)
                            	  2452:     ; It also means that we went past the end of the save slot
                            	  2453:     ; info name. Set the offset to the beginning of the name.
02:00033858 7600            	  2454:     moveq   #0,D3
02:0003385A 162C0016        	  2455:     move.b  ($0016,A4),D3
02:0003385E 41F9000331A0    	  2456:     lea     (SlotToNameOffset).l,A0
02:00033864 10303000        	  2457:     move.b  (A0,D3.W),D0
02:00033868 19400421        	  2458:     move.b  D0,($0421,A4)
                            	  2459:     ; If the name cursor has gone past the end of the field,
                            	  2460:     ; then wrap around.
02:0003386C 102C0070        	  2461:     move.b  ($0070,A4),D0
02:00033870 0C0000B0        	  2462:     cmpi.b  #$B0,D0
02:00033874 6640            	  2463:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033876 7070            	  2464:     moveq   #112,D0
02:00033878 19400070        	  2465:     move.b  D0,($0070,A4)
                            	  2466:     even
                            	  2467: ; PATCH P25b: FS2-E backspace handler.
                            	  2468: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2469: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2470: ; one column (8 px), and writes a space ($24) to the erased
                            	  2471: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2472: ; cannot cross into a previous slot's name field.
                            	  2473: _L_z02_ModeE_HandleAOrB_Backspace:
02:0003387C 7600            	  2474:     moveq   #0,D3
02:0003387E 162C0016        	  2475:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00033882 41F9000331A0    	  2476:     lea     (SlotToNameOffset).l,A0
02:00033888 12303000        	  2477:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:0003388C 102C0421        	  2478:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00033890 B001            	  2479:     cmp.b   D1,D0
02:00033892 6322            	  2480:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033894 5300            	  2481:     subq.b  #1,D0
02:00033896 19400421        	  2482:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:0003389A 532C0423        	  2483:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:0003389E 122C0070        	  2484:     move.b  ($0070,A4),D1
02:000338A2 5101            	  2485:     subi.b  #8,D1
02:000338A4 19410070        	  2486:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:000338A8 7224            	  2487:     moveq   #$24,D1              ; space tile
02:000338AA 7600            	  2488:     moveq   #0,D3
02:000338AC 1600            	  2489:     move.b  D0,D3                ; D3 = erased offset
02:000338AE 41EC0638        	  2490:     lea     ($0638,A4),A0
02:000338B2 11813000        	  2491:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2492:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2493:     even
