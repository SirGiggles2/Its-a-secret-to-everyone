                            	  9551: UpdatePatraChild:
                            	  9552:     ; If state = 1, then go orbit.
                            	  9553:     ;
02:0003C5E6 41EC00AC        	  9554:     lea     ($00AC,A4),A0
02:0003C5EA 10302000        	  9555:     move.b  (A0,D2.W),D0
