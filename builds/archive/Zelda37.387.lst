                            	  6256:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  6257:     ;
02:0003ACE8 41EC0098        	  6258:     lea     ($0098,A4),A0
02:0003ACEC 10302000        	  6259:     move.b  (A0,D2.W),D0
02:0003ACF0 02000003        	  6260:     andi.b #$03,D0
02:0003ACF4 6618            	  6261:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
