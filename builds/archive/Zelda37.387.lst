02:000389E6 7600            	  1340:     moveq   #0,D3
02:000389E8 1600            	  1341:     move.b  D0,D3
02:000389EA 41F900038946    	  1342:     lea     (StatueFireballStartTimes).l,A0
02:000389F0 10303000        	  1343:     move.b  (A0,D3.W),D0
02:000389F4 41EC04E8        	  1344:     lea     ($04E8,A4),A0
02:000389F8 11802000        	  1345:     move.b  D0,(A0,D2.W)
                            	  1346:     ; The coordinate lists are divided into sets for each pattern.
                            	  1347:     ;
