                            	  2527:     ; above its ObjY.
02:000338FC 102C0084        	  2528:     move.b  ($0084,A4),D0
02:00033900 003C0011        	  2529:     ori     #$11,CCR  ; SEC: set C+X
02:00033904 123C0008        	  2530:     move.b  #$08,D1
02:00033908 0A3C0010        	  2531:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003390C 9101            	  2532:     subx.b  D1,D0   ; SBC #$08
02:0003390E 0A3C0010        	  2533:     eori    #$10,CCR  ; restore X = 6502 C
02:00033912 19400204        	  2534:     move.b  D0,($0204,A4)
02:00033916 7070            	  2535:     moveq   #112,D0
02:00033918 19400070        	  2536:     move.b  D0,($0070,A4)
02:0003391C 103C0087        	  2537:     move.b  #$87,D0
02:00033920 19400085        	  2538:     move.b  D0,($0085,A4)
02:00033924 7030            	  2539:     moveq   #48,D0
02:00033926 19400071        	  2540:     move.b  D0,($0071,A4)
