02:0003C726 611C            	  9721:     jsr     PatraChild_Draw
                            	  9722:     ; If Patra's state still = 0, then the last patra child has not
                            	  9723:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  9724:     ;
