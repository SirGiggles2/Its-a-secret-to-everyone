02:0004897E 7400            	  3259:     moveq   #0,D2
02:00048980 142C0340        	  3260:     move.b  ($0340,A4),D2
02:00048984 61002028        	  3261:     jsr     DecrementInvincibilityTimer
02:00048988 41EC034F        	  3262:     lea     ($034F,A4),A0
02:0004898C 10302000        	  3263:     move.b  (A0,D2.W),D0
02:00048990 674A            	  3264:     beq  _L_z07_BeginUpdateWorld_NextObject
02:00048992 41EC034F        	  3265:     lea     ($034F,A4),A0
02:00048996 10302000        	  3266:     move.b  (A0,D2.W),D0
02:0004899A 6100193C        	  3267:     jsr     UpdateObject
                            	  3268:     ; If the object is autonomous and not checking collisions itself,
                            	  3269:     ; then see about checking collisions and drawing on its behalf.
