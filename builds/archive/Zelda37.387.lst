                            	  8587: __far_z_04_0087:
                            	  8588:     ; The animation timer has expired. There are two choices for arming it.
                            	  8589:     ;
                            	  8590:     ; When writhing after a hit, Gleeok animates faster.
                            	  8591:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  8592:     ; Otherwise, set a longer time ($10).
                            	  8593:     ;
