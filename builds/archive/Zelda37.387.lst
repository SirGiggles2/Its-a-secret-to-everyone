                            	  3394:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  3395:     ;
02:000397DE 102C0085        	  3396:     move.b  ($0085,A4),D0
02:000397E2 003C0011        	  3397:     ori     #$11,CCR  ; SEC: set C+X
02:000397E6 123C001C        	  3398:     move.b  #$1C,D1
02:000397EA 0A3C0010        	  3399:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000397EE 9101            	  3400:     subx.b  D1,D0   ; SBC #$1C
02:000397F0 0A3C0010        	  3401:     eori    #$10,CCR  ; restore X = 6502 C
02:000397F4 41EC0084        	  3402:     lea     ($0084,A4),A0
02:000397F8 11802000        	  3403:     move.b  D0,(A0,D2.W)
                            	  3404:     even
                            	  3405: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  3406:     ; Decrease the angle by $00.60.
                            	  3407:     ;
02:000397FC 7000            	  3408:     moveq   #0,D0
02:000397FE 1940000B        	  3409:     move.b  D0,($000B,A4)
