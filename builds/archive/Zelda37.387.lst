02:00048938 610015D2        	  3215:     jsr     UpdateBombOrFire
02:0004893C 7412            	  3216:     moveq   #18,D2
02:0004893E 610011FC        	  3217:     jsr     UpdateRodOrArrow
                            	  3218:     ; If it's not time to change the chase target, then
                            	  3219:     ; skip this and go update objects.
                            	  3220:     ;
02:00048942 102C004A        	  3221:     move.b  ($004A,A4),D0
02:00048946 6636            	  3222:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3223:     ; Set the chase long-timer to a random value between 0 and 7.
                            	  3224:     ;
02:00048948 102C0019        	  3225:     move.b  ($0019,A4),D0
02:0004894C 02000007        	  3226:     andi.b #$07,D0
02:00048950 1940004A        	  3227:     move.b  D0,($004A,A4)
                            	  3228:     ; Switch the flag indicating whether Link is the target.
                            	  3229:     ; If the value is 0 (Link *is* the target), then
                            	  3230:     ; skip this and go update objects.
                            	  3231:     ;
02:00048954 102C0060        	  3232:     move.b  ($0060,A4),D0
02:00048958 0A000001        	  3233:     eori.b #$01,D0
02:0004895C 19400060        	  3234:     move.b  D0,($0060,A4)
02:00048960 671C            	  3235:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3236:     ; If Link's X has not changed since the last frame
                            	  3237:     ; (when Link was the target), then XOR the chase target
                            	  3238:     ; coordinates (which were Link's coordinates last frame).
                            	  3239:     ;
                            	  3240:     ; This ends up reflecting Link's coordinates across the room;
                            	  3241:     ; so that monsters chase away from him.
                            	  3242:     ;
                            	  3243:     ; But if Link's X has changed since the last frame, then
                            	  3244:     ; leave the chase target coordinates with his old coordinates.
                            	  3245:     ;
02:00048962 102C0061        	  3246:     move.b  ($0061,A4),D0
02:00048966 122C0070        	  3247:     move.b  ($0070,A4),D1
02:0004896A B001            	  3248:     cmp.b   D1,D0
02:0004896C 6610            	  3249:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:0004896E 4600            	  3250:     eori.b #$FF,D0
02:00048970 19400061        	  3251:     move.b  D0,($0061,A4)
02:00048974 102C0062        	  3252:     move.b  ($0062,A4),D0
02:00048978 4600            	  3253:     eori.b #$FF,D0
02:0004897A 19400062        	  3254:     move.b  D0,($0062,A4)
                            	  3255:     even
