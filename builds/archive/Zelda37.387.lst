02:0003D394 7600            	 11556:     moveq   #0,D3
02:0003D396 162C0006        	 11557:     move.b  ($0006,A4),D3
02:0003D39A 6100008E        	 11558:     jsr     ShiftMultiply
                            	 11559:     ; The absolute Y increment for the current angle is now in [02:03].
