02:00038A3C 41F900038956    	  1383:     lea     (StatueYs).l,A0
02:00038A42 10303000        	  1384:     move.b  (A0,D3.W),D0
02:00038A46 19400003        	  1385:     move.b  D0,($0003,A4)
02:00038A4A 41EC0084        	  1386:     lea     ($0084,A4),A0
02:00038A4E 11802000        	  1387:     move.b  D0,(A0,D2.W)
                            	  1388:     ; Set mask value 3 in [04].
