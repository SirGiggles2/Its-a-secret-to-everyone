                            	  3222: UpdatePondFairy:
02:000396E4 610038EC        	  3223:     jsr     DrawFairy
                            	  3224:     ; If not in state 0, then go handle states 1 to 3.
                            	  3225:     ;
02:000396E8 102C00AD        	  3226:     move.b  ($00AD,A4),D0
02:000396EC 6702            	  3227:     beq.s  __far_z_04_0028
02:000396EE 602A            	  3228:     jmp  PondFairy_HandleOtherStates
                            	  3229: __far_z_04_0028:
                            	  3230:     ; State 0.
                            	  3231:     ;
                            	  3232:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3233:     ;
02:000396F0 102C0084        	  3234:     move.b  ($0084,A4),D0
