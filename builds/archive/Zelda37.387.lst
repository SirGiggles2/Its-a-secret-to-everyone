                            	  5693:     ;
02:00049962 102C00AC        	  5694:     move.b  ($00AC,A4),D0
02:00049966 00000020        	  5695:     ori.b #$20,D0
02:0004996A 194000AC        	  5696:     move.b  D0,($00AC,A4)
                            	  5697:     ; Make to set Link's animation counter to 1, so that he picks
