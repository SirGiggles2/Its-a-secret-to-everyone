                            	  4927: ;
                            	  4928: ; If the object is a sword shot, go spread out the shot.
                            	  4929: ;
                            	  4930:     even
                            	  4931: HandleShotBlocked:
02:00049450 41EC00AC        	  4932:     lea     ($00AC,A4),A0
02:00049454 10302000        	  4933:     move.b  (A0,D2.W),D0
02:00049458 E308            	  4934:     lsl.b  #1,D0   ; ASL A
02:0004945A 6504            	  4935:     bcs.s  __far_z_07_0074
02:0004945C 60000082        	  4936:     jmp  SetShotSpreadingState
                            	  4937: __far_z_07_0074:
                            	  4938:     ; This is a magic shot.
                            	  4939:     ;
                            	  4940:     ; If missing the magic book, go deactivate the shot object.
                            	  4941:     ;
02:00049460 102C0661        	  4942:     move.b  ($0661,A4),D0
02:00049464 6602            	  4943:     bne.s  __far_z_07_0075
02:00049466 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:00049468 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:0004946C 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004946E 102C0513        	  4956:     move.b  ($0513,A4),D0
02:00049472 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:00049474 7000            	  4958:     moveq   #0,D0
02:00049476 19400513        	  4959:     move.b  D0,($0513,A4)
02:0004947A 4EB9000308C6    	  4960:     jsr     WieldCandle
02:00049480 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:00049482 19400513        	  4962:     move.b  D0,($0513,A4)
02:00049486 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:00049488 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:0004948C 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:00049490 10302000        	  4972:     move.b  (A0,D2.W),D0
02:00049494 0C000021        	  4973:     cmpi.b  #$21,D0
02:00049498 6702            	  4974:     beq.s  __far_z_07_0076
02:0004949A 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
                            	  4978:     ;
02:0004949C 41EC00AC        	  4979:     lea     ($00AC,A4),A0
02:000494A0 52302000        	  4980:     addq.b  #1,(A0,D2.W)
                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:000494A4 760E            	  4983:     moveq   #14,D3
02:000494A6 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:000494AA 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:000494AE 41EC0084        	  4986:     lea     ($0084,A4),A0
02:000494B2 10303000        	  4987:     move.b  (A0,D3.W),D0
02:000494B6 41EC0084        	  4988:     lea     ($0084,A4),A0
02:000494BA 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:000494BE 41EC0098        	  4990:     lea     ($0098,A4),A0
02:000494C2 10303000        	  4991:     move.b  (A0,D3.W),D0
02:000494C6 41EC0098        	  4992:     lea     ($0098,A4),A0
02:000494CA 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
                            	  4996:     ;
02:000494CE 704F            	  4997:     moveq   #79,D0
02:000494D0 19802028        	  4998:     move.b  D0,($28,A4,D2.W)
                            	  4999:     even
                            	  5000: DeactivateLinkShot:
02:000494D4 4EF90002BC8C    	  5001:     jmp     c_deactivate_link_shot
                            	  5002: 
                            	  5003: DeactivateShot:
02:000494DA 4EF90002BC7C    	  5004:     jmp     c_deactivate_shot
                            	  5005: 
