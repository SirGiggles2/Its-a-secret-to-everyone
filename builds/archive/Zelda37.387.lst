02:0002BF88 08000008        	  2481:     btst    #8,D0
02:0002BF8C 670A            	  2482:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2483:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2484:     eori    #$01,CCR
02:0002BF96 4E75            	  2485:     rts
                            	  2486: .cc_cnr:
02:0002BF98 023C00FE        	  2487:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2488:     eori    #$01,CCR
02:0002BFA0 4E75            	  2489:     rts
