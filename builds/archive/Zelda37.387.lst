02:00042710 194000EB        	  8748:     move.b  D0,($00EB,A4)
02:00042714 101D            	  8749:     move.b  (A5)+,D0  ; PLA
02:00042716 7600            	  8750:     moveq   #0,D3
02:00042718 1600            	  8751:     move.b  D0,D3
                            	  8752:     ; The map marks are arranged in the same order as all the
                            	  8753:     ; possible values of OpenDoorMask.
                            	  8754:     ;
                            	  8755:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8756:     ; dynamic transfer buf at the current offset.
                            	  8757:     ;
02:0004271A 102C033F        	  8758:     move.b  ($033F,A4),D0
02:0004271E 023C00EE        	  8759:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042722 123C00E2        	  8760:     move.b  #$E2,D1
02:00042726 D101            	  8761:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00042728 41EC0304        	  8762:     lea     ($0304,A4),A0
02:0004272C 11803000        	  8763:     move.b  D0,(A0,D3.W)
02:00042730 4E75            	  8764:     rts
                            	  8765: 
                            	  8766: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8767: ; based on doorway type and room flags. Each call will shift the next
                            	  8768: ; doorway state bit into OpenDoorwayMask.
                            	  8769: ;
                            	  8770: ; Params:
                            	  8771: ; A: door attribute
                            	  8772: ; X: direction index
                            	  8773: ;
                            	  8774: ; Returns:
                            	  8775: ; A: untouched
                            	  8776: ;
                            	  8777:     even
                            	  8778: CalcOpenDoorwayMask:
02:00042732 7600            	  8779:     moveq   #0,D3
02:00042734 1B00            	  8780:     move.b  D0,-(A5)  ; PHA
02:00042736 0C000004        	  8781:     cmpi.b  #$04,D0
02:0004273A 6548            	  8782:     bcs  _L_z05_CalcOpenDoorwayMask_ByDoorType
                            	  8783:     ; Else we have to find out the walkability from the room flags.
                            	  8784:     ;
02:0004273C 1002            	  8785:     move.b  D2,D0
02:0004273E 1B00            	  8786:     move.b  D0,-(A5)  ; PHA
02:00042740 1003            	  8787:     move.b  D3,D0
02:00042742 1B00            	  8788:     move.b  D0,-(A5)  ; PHA
02:00042744 61005868        	  8789:     jsr     GetRoomFlags
02:00042748 023C00EE        	  8790:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004274C 41F900047F82    	  8791:     lea     (LevelMasks).l,A0
02:00042752 12302000        	  8792:     move.b  (A0,D2.W),D1
02:00042756 C001            	  8793:     and.b  D1,D0
02:00042758 6704            	  8794:     beq  _anon_z05_205
02:0004275A 003C0011        	  8795:     ori     #$11,CCR  ; SEC: set C+X
                            	  8796: _anon_z05_205:
02:0004275E 101D            	  8797:     move.b  (A5)+,D0  ; PLA
02:00042760 7600            	  8798:     moveq   #0,D3
02:00042762 1600            	  8799:     move.b  D0,D3
02:00042764 101D            	  8800:     move.b  (A5)+,D0  ; PLA
02:00042766 7400            	  8801:     moveq   #0,D2
