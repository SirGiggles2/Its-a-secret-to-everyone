                            	  1349:     ; Add it to the fireball index in X register to get the index of
                            	  1350:     ; the coordinate we want within each coordinate list.
                            	  1351:     ;
                            	  1352:     ;
                            	  1353:     ; Pattern
02:000389FC 7600            	  1354:     moveq   #0,D3
02:000389FE 162C000B        	  1355:     move.b  ($000B,A4),D3
02:00038A02 1002            	  1356:     move.b  D2,D0
02:00038A04 023C00EE        	  1357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038A08 41F90003894A    	  1358:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038A0E 12303000        	  1359:     move.b  (A0,D3.W),D1
02:00038A12 D101            	  1360:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00038A14 7600            	  1361:     moveq   #0,D3
02:00038A16 1600            	  1362:     move.b  D0,D3
02:00038A18 1002            	  1363:     move.b  D2,D0
02:00038A1A 1B00            	  1364:     move.b  D0,-(A5)  ; PHA
                            	  1365:     ; Get Link's coordinates into [00] and [01].
