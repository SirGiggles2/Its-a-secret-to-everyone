                            	  1906: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  1907:     ; Set state 1 to jump.
                            	  1908:     ;
02:00038D86 41EC00AC        	  1909:     lea     ($00AC,A4),A0
02:00038D8A 52302000        	  1910:     addq.b  #1,(A0,D2.W)
                            	  1911:     even
                            	  1912: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  1913:     ; If reversal count >= 2, then
                            	  1914:     ; 1. invert the horizontal component of facing direction,
                            	  1915:     ;    to face away from the chase target
                            	  1916:     ; 2. reset the reversal count to 0.
                            	  1917:     ;
                            	  1918:     ; This prevents a jumper from getting stuck in a corner.
                            	  1919:     ;
                            	  1920:     ; For example, if a tektite's direction is down and right,
                            	  1921:     ; and jumps into the top right corner of the room:
                            	  1922:     ; 1. The right room boundary is hit. So the direction is
                            	  1923:     ;    automatically reversed to up and left.
                            	  1924:     ; 2. The next frame, the top room boundary is hit.
                            	  1925:     ;    The direction is reversed to down and right.
                            	  1926:     ;
                            	  1927:     ; As you can see, an endless loop has been made.
                            	  1928:     ;
02:00038D8E 41EC0451        	  1929:     lea     ($0451,A4),A0
02:00038D92 10302000        	  1930:     move.b  (A0,D2.W),D0
02:00038D96 0C000002        	  1931:     cmpi.b  #$02,D0
02:00038D9A 651E            	  1932:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:00038D9C 41EC0098        	  1933:     lea     ($0098,A4),A0
02:00038DA0 10302000        	  1934:     move.b  (A0,D2.W),D0
02:00038DA4 0A000003        	  1935:     eori.b #$03,D0
02:00038DA8 41EC0098        	  1936:     lea     ($0098,A4),A0
02:00038DAC 11802000        	  1937:     move.b  D0,(A0,D2.W)
02:00038DB0 7000            	  1938:     moveq   #0,D0
02:00038DB2 41EC0451        	  1939:     lea     ($0451,A4),A0
02:00038DB6 11802000        	  1940:     move.b  D0,(A0,D2.W)
                            	  1941:     even
                            	  1942: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  1943:     ; If the object is a boulder, then make sure its facing direction
                            	  1944:     ; has a down vertical component.
                            	  1945:     ;
02:00038DBA 610001F8        	  1946:     jsr     Jumper_PointBoulderDownward
                            	  1947:     ; For the given direction, get the Y offset of the destination
                            	  1948:     ; of the jump.
                            	  1949:     ;
                            	  1950:     ; Add it to the object's Y, and store this destination Y.
                            	  1951:     ;
02:00038DBE 7600            	  1952:     moveq   #0,D3
02:00038DC0 41EC0098        	  1953:     lea     ($0098,A4),A0
02:00038DC4 16302000        	  1954:     move.b  (A0,D2.W),D3
02:00038DC8 41EC0084        	  1955:     lea     ($0084,A4),A0
02:00038DCC 10302000        	  1956:     move.b  (A0,D2.W),D0
02:00038DD0 023C00EE        	  1957:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038DD4 41F900038CEC    	  1958:     lea     (JumperYOffsets).l,A0
02:00038DDA 12303000        	  1959:     move.b  (A0,D3.W),D1
02:00038DDE D101            	  1960:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:00038DE0 41EC0444        	  1961:     lea     ($0444,A4),A0
02:00038DE4 11802000        	  1962:     move.b  D0,(A0,D2.W)
                            	  1963:     ; Set the starting speed, depending on the object type.
