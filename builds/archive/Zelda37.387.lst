                            	  6126: _anon_z04_94:
                            	  6127:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  6128:     ; This is the base frame image.
                            	  6129:     ;
02:0003AC02 E208            	  6130:     lsr.b  #1,D0   ; LSR A
02:0003AC04 E208            	  6131:     lsr.b  #1,D0   ; LSR A
                            	  6132:     ; If movement frame = 1, add 3 to frame image to access
                            	  6133:     ; the second animation frame's images.
