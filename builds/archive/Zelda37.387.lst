02:00039104 41EC034F        	  2374:     lea     ($034F,A4),A0
02:00039108 16302000        	  2375:     move.b  (A0,D2.W),D3
02:0003910C 0C030011        	  2376:     cmpi.b  #$11,D3
02:00039110 6620            	  2377:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00039112 7600            	  2378:     moveq   #0,D3
02:00039114 41EC00AC        	  2379:     lea     ($00AC,A4),A0
02:00039118 16302000        	  2380:     move.b  (A0,D2.W),D3
02:0003911C 0C030002        	  2381:     cmpi.b  #$02,D3
