                            	  2986:     ;
02:00039568 7070            	  2987:     moveq   #112,D0
02:0003956A 1880            	  2988:     move.b  D0,($0000,A4)
                            	  2989:     ; Look for the current room ID in an array of room ID's that
                            	  2990:     ; have armos secrets.
                            	  2991:     ;
02:0003956C 7606            	  2992:     moveq   #6,D3
                            	  2993:     even
                            	  2994: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003956E 102C00EB        	  2995:     move.b  ($00EB,A4),D0
                            	  2996:     ; If this element does not match the current room ID, go loop again.
                            	  2997:     ;
02:00039572 41F900039538    	  2998:     lea     (SecretArmosRoomIds).l,A0
02:00039578 12303000        	  2999:     move.b  (A0,D3.W),D1
02:0003957C B001            	  3000:     cmp.b   D1,D0
02:0003957E 6648            	  3001:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3002:     ; The secret (usually stairs) is under one of the armoses.
                            	  3003:     ;
                            	  3004:     ; If the armos's X coordinate does not match the one needed
                            	  3005:     ; for the current room in the list, then go loop again.
                            	  3006:     ;
02:00039580 10342070        	  3007:     move.b  ($70,A4,D2.W),D0
02:00039584 41F900039540    	  3008:     lea     (SecretArmosXs).l,A0
02:0003958A 12303000        	  3009:     move.b  (A0,D3.W),D1
02:0003958E B001            	  3010:     cmp.b   D1,D0
02:00039590 6636            	  3011:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3012:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3013:     ;
02:00039592 41EC0084        	  3014:     lea     ($0084,A4),A0
02:00039596 10302000        	  3015:     move.b  (A0,D2.W),D0
02:0003959A 0C000080        	  3016:     cmpi.b  #$80,D0
02:0003959E 6628            	  3017:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3018:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3019:     ;
02:000395A0 4A03            	  3020:     cmpi.b  #$00,D3
02:000395A2 662C            	  3021:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3022:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3023:     ; has the power bracelet.
                            	  3024:     ;
                            	  3025:     ; Set up the room item with the armos's coordinates.
                            	  3026:     ;
02:000395A4 19400097        	  3027:     move.b  D0,($0097,A4)
02:000395A8 10342070        	  3028:     move.b  ($70,A4,D2.W),D0
02:000395AC 19400083        	  3029:     move.b  D0,($0083,A4)
                            	  3030:     ; This resets the room item's state, which activates it.
                            	  3031:     ;
02:000395B0 194300BF        	  3032:     move.b  D3,($00BF,A4)
                            	  3033:     ; Set the room item ID.
                            	  3034:     ;
02:000395B4 7014            	  3035:     moveq   #20,D0
02:000395B6 194000AB        	  3036:     move.b  D0,($00AB,A4)
                            	  3037:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3038:     ;
                            	  3039:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3040:     ;
                            	  3041:     ; Note that, if the item was already taken, then the room item
                            	  3042:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3043:     ; it will be ignored, because that routine checks whether
                            	  3044:     ; the item was taken.
                            	  3045:     ;
02:000395BA 4EB900030974    	  3046:     jsr     GetRoomFlagUWItemState
02:000395C0 660A            	  3047:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:000395C2 6100069E        	  3048:     jsr     PlaySecretFoundTune
02:000395C6 6604            	  3049:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3050:     even
                            	  3051: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3052:     ; Bottom of the loop.
                            	  3053:     ;
02:000395C8 5303            	  3054:     subq.b  #1,D3
02:000395CA 6AA2            	  3055:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3056:     even
                            	  3057: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3058:     ; Not found, or found the power bracelet.
                            	  3059:     ; Use a floor tile $26 to replace the armos.
                            	  3060:     ;
02:000395CC 7026            	  3061:     moveq   #38,D0
02:000395CE 1880            	  3062:     move.b  D0,($0000,A4)
                            	  3063:     even
                            	  3064: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:000395D0 1014            	  3065:     move.b  ($0000,A4),D0
                            	  3066:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3067:     ;
02:000395D2 1B00            	  3068:     move.b  D0,-(A5)  ; PHA
02:000395D4 0C000070        	  3069:     cmpi.b  #$70,D0
02:000395D8 6604            	  3070:     bne  _anon_z04_51
02:000395DA 61000686        	  3071:     jsr     PlaySecretFoundTune
                            	  3072: _anon_z04_51:
                            	  3073:     ; Replace the tile where the armos was.
                            	  3074:     ;
02:000395DE 522C00F7        	  3075:     addq.b  #1,($00F7,A4)
02:000395E2 101D            	  3076:     move.b  (A5)+,D0  ; PLA
02:000395E4 4EB900048252    	  3077:     jsr     ChangeTileObjTiles
                            	  3078:     ; Because the armos object is aligned to the square grid
                            	  3079:     ; (because it was made from a square),
                            	  3080:     ; set its grid offset to 3 to compensate.
                            	  3081:     ;
                            	  3082:     ; Most objects are aligned to the grid vertically when the
                            	  3083:     ; low nibble is $D.
                            	  3084:     ;
02:000395EA 7003            	  3085:     moveq   #3,D0
02:000395EC 41EC0394        	  3086:     lea     ($0394,A4),A0
02:000395F0 11802000        	  3087:     move.b  D0,(A0,D2.W)
                            	  3088:     ; Set a speed (q-speed fraction) randomly:
                            	  3089:     ; $20 if random value < $80
                            	  3090:     ; $60 otherwise
                            	  3091:     ;
02:000395F4 7020            	  3092:     moveq   #32,D0
02:000395F6 7600            	  3093:     moveq   #0,D3
02:000395F8 16342019        	  3094:     move.b  ($19,A4,D2.W),D3
02:000395FC 0C030080        	  3095:     cmpi.b  #$80,D3
02:00039600 6502            	  3096:     bcs  _anon_z04_52
02:00039602 7060            	  3097:     moveq   #96,D0
                            	  3098: _anon_z04_52:
02:00039604 41EC03BC        	  3099:     lea     ($03BC,A4),A0
02:00039608 11802000        	  3100:     move.b  D0,(A0,D2.W)
                            	  3101:     even
                            	  3102: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3103:     ; Facing and input directions down.
                            	  3104:     ;
02:0003960C 7004            	  3105:     moveq   #4,D0
02:0003960E 41EC03F8        	  3106:     lea     ($03F8,A4),A0
02:00039612 11802000        	  3107:     move.b  D0,(A0,D2.W)
02:00039616 41EC0098        	  3108:     lea     ($0098,A4),A0
02:0003961A 11802000        	  3109:     move.b  D0,(A0,D2.W)
                            	  3110:     ; Every other frame, return without drawing.
                            	  3111:     ;
02:0003961E 10342028        	  3112:     move.b  ($28,A4,D2.W),D0
02:00039622 E208            	  3113:     lsr.b  #1,D0   ; LSR A
02:00039624 6512            	  3114:     bcs  _anon_z04_53
                            	  3115:     ; Finish initializing based on type.
                            	  3116:     ;
02:00039626 41EC034F        	  3117:     lea     ($034F,A4),A0
02:0003962A 10302000        	  3118:     move.b  (A0,D2.W),D0
02:0003962E 0C000022        	  3119:     cmpi.b  #$22,D0
