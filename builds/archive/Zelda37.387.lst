                            	  2238:     even
                            	  2239: Anim_WriteHorizontallyFlippableSpritePair:
02:00030D1E 102C000F        	  2240:     move.b  ($000F,A4),D0
02:00030D22 6602            	  2241:     bne.s  __far_z_01_0004
02:00030D24 602C            	  2242:     jmp  Anim_WriteSpritePair
