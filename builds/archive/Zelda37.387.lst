                            	  5104: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  5105:     ; Digdogger is big, but room boundary checks and
                            	  5106:     ; object collision checks assume a 16x16 monster or smaller.
                            	  5107:     ; Therefore, we have to check these things four times,
                            	  5108:     ; in different corners of the boss.
                            	  5109:     ;
                            	  5110:     ; Loop 4 times, from 0 to 3.
                            	  5111:     ;
02:0003A40E 7600            	  5112:     moveq   #0,D3
02:0003A410 41EC0478        	  5113:     lea     ($0478,A4),A0
02:0003A414 16302000        	  5114:     move.b  (A0,D2.W),D3
                            	  5115:     ; Change the coordinates to one corner.
                            	  5116:     ;
02:0003A418 10342070        	  5117:     move.b  ($70,A4,D2.W),D0
02:0003A41C 023C00EE        	  5118:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A420 41F90003A2D4    	  5119:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A426 12303000        	  5120:     move.b  (A0,D3.W),D1
02:0003A42A D101            	  5121:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A42C 19802070        	  5122:     move.b  D0,($70,A4,D2.W)
02:0003A430 41EC0084        	  5123:     lea     ($0084,A4),A0
02:0003A434 10302000        	  5124:     move.b  (A0,D2.W),D0
02:0003A438 023C00EE        	  5125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A43C 41F90003A2D8    	  5126:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A442 12303000        	  5127:     move.b  (A0,D3.W),D1
02:0003A446 D101            	  5128:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A448 41EC0084        	  5129:     lea     ($0084,A4),A0
02:0003A44C 11802000        	  5130:     move.b  D0,(A0,D2.W)
                            	  5131:     ; Check the room boundary and object collisions in this temporary location.
