02:0004A602 1940004B        	  7312:     move.b  D0,($004B,A4)
02:0004A606 41EC0492        	  7313:     lea     ($0492,A4),A0
02:0004A60A 11802000        	  7314:     move.b  D0,(A0,D2.W)
02:0004A60E 4E75            	  7315:     rts
                            	  7316:     even
