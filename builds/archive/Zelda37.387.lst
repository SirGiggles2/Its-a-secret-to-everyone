                            	  8013:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  8014:     ; on the left side.
                            	  8015:     ;
02:0003BA3C 003C0011        	  8016:     ori     #$11,CCR  ; SEC: set C+X
02:0003BA40 123C0010        	  8017:     move.b  #$10,D1
02:0003BA44 0A3C0010        	  8018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BA48 9101            	  8019:     subx.b  D1,D0   ; SBC #$10
02:0003BA4A 0A3C0010        	  8020:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BA4E 19802070        	  8021:     move.b  D0,($70,A4,D2.W)
                            	  8022:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  8023:     ; from left to right, indexed by [0F].
                            	  8024:     ;
02:0003BA52 7005            	  8025:     moveq   #5,D0
02:0003BA54 1940000F        	  8026:     move.b  D0,($000F,A4)
