                            	  1001: _L_z04_UpdateFireball_Move:
                            	  1002:     ; A movement routine is used that works along one axis.
                            	  1003:     ; So, load its parameters, and call it for each axis individually.
                            	  1004:     ;
                            	  1005:     ; First, load the horizontal direction into [0F].
                            	  1006:     ;
02:000387AE 41EC0412        	  1007:     lea     ($0412,A4),A0
02:000387B2 10302000        	  1008:     move.b  (A0,D2.W),D0
02:000387B6 1940000F        	  1009:     move.b  D0,($000F,A4)
                            	  1010:     ; Load the horizontal q-speed and position fraction,
                            	  1011:     ; move, then save the position fraction.
                            	  1012:     ;
02:000387BA 41EC041F        	  1013:     lea     ($041F,A4),A0
02:000387BE 10302000        	  1014:     move.b  (A0,D2.W),D0
02:000387C2 7600            	  1015:     moveq   #0,D3
02:000387C4 41EC0451        	  1016:     lea     ($0451,A4),A0
02:000387C8 16302000        	  1017:     move.b  (A0,D2.W),D3
02:000387CC 613E            	  1018:     jsr     Fireball_MoveOneAxis
02:000387CE 41EC0451        	  1019:     lea     ($0451,A4),A0
02:000387D2 11802000        	  1020:     move.b  D0,(A0,D2.W)
                            	  1021:     ; Second, load the vertical direction into [0F].
                            	  1022:     ;
02:000387D6 41EC0437        	  1023:     lea     ($0437,A4),A0
02:000387DA 10302000        	  1024:     move.b  (A0,D2.W),D0
02:000387DE 1940000F        	  1025:     move.b  D0,($000F,A4)
                            	  1026:     ; Load the vertical q-speed and position fraction,
                            	  1027:     ; move, then save the position fraction.
                            	  1028:     ;
02:000387E2 41EC0444        	  1029:     lea     ($0444,A4),A0
02:000387E6 10302000        	  1030:     move.b  (A0,D2.W),D0
02:000387EA 7600            	  1031:     moveq   #0,D3
02:000387EC 41EC045E        	  1032:     lea     ($045E,A4),A0
02:000387F0 16302000        	  1033:     move.b  (A0,D2.W),D3
02:000387F4 6116            	  1034:     jsr     Fireball_MoveOneAxis
