02:0003AE30 11802000        	  6404:     move.b  D0,(A0,D2.W)
                            	  6405:     ; Reset 16-bit vertical speed.
                            	  6406:     ;
02:0003AE34 41EC0444        	  6407:     lea     ($0444,A4),A0
02:0003AE38 11802000        	  6408:     move.b  D0,(A0,D2.W)
02:0003AE3C 41EC0412        	  6409:     lea     ($0412,A4),A0
02:0003AE40 11802000        	  6410:     move.b  D0,(A0,D2.W)
                            	  6411:     ; Choose a random direction to face in.
