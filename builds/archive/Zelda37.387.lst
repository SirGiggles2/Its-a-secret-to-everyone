02:0003AE18 10302000        	  6395:     move.b  (A0,D2.W),D0
02:0003AE1C 41EC042C        	  6396:     lea     ($042C,A4),A0
02:0003AE20 12302000        	  6397:     move.b  (A0,D2.W),D1
02:0003AE24 B001            	  6398:     cmp.b   D1,D0
02:0003AE26 65000096        	  6399:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  6400:     ; Else reached the destination. Go to state 0.
