02:0003C352 D101            	  9172:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003C354 0200000F        	  9173:     andi.b #$0F,D0
02:0003C358 660000A0        	  9174:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	  9175:     ; Store the opposite of the facing direction in [00].
                            	  9176:     ;
02:0003C35C 41EC0098        	  9177:     lea     ($0098,A4),A0
02:0003C360 10302000        	  9178:     move.b  (A0,D2.W),D0
02:0003C364 E208            	  9179:     lsr.b  #1,D0   ; LSR A
02:0003C366 02000005        	  9180:     andi.b #$05,D0
02:0003C36A 1880            	  9181:     move.b  D0,($0000,A4)
02:0003C36C 41EC0098        	  9182:     lea     ($0098,A4),A0
02:0003C370 10302000        	  9183:     move.b  (A0,D2.W),D0
02:0003C374 E308            	  9184:     lsl.b  #1,D0   ; ASL A
02:0003C376 0200000A        	  9185:     andi.b #$0A,D0
02:0003C37A 1214            	  9186:     move.b  ($0000,A4),D1
02:0003C37C 8001            	  9187:     or.b  D1,D0
                            	  9188:     ; Make a mask of the inverted bits of the opposite direction.
                            	  9189:     ;
02:0003C37E 0A00000F        	  9190:     eori.b #$0F,D0
02:0003C382 1940050F        	  9191:     move.b  D0,($050F,A4)
                            	  9192:     ; There's a 50% chance of going to try to turn toward Link.
                            	  9193:     ;
02:0003C386 10342018        	  9194:     move.b  ($18,A4,D2.W),D0
02:0003C38A 0C000080        	  9195:     cmpi.b  #$80,D0
02:0003C38E 656C            	  9196:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	  9197:     ; Otherwise, we randomly choose a perpendicular direction.
                            	  9198:     ; Load the monster's facing direction.
                            	  9199:     ;
02:0003C390 41EC0098        	  9200:     lea     ($0098,A4),A0
02:0003C394 10302000        	  9201:     move.b  (A0,D2.W),D0
                            	  9202:     ; Load the next random number into Y register.
                            	  9203:     ;
02:0003C398 7600            	  9204:     moveq   #0,D3
02:0003C39A 16342019        	  9205:     move.b  ($19,A4,D2.W),D3
                            	  9206:     ; Based on it, there's a 50% chance of skipping the loop,
                            	  9207:     ; to keep moving straight.
                            	  9208:     ;
02:0003C39E 0C030080        	  9209:     cmpi.b  #$80,D3
02:0003C3A2 6418            	  9210:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	  9211:     even
                            	  9212: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	  9213:     ; Loop to rotate the direction bit over the mask.
                            	  9214:     ; The goal is to calculate a direction perpendicular to the monster's
                            	  9215:     ; facing direction.
                            	  9216:     ;
                            	  9217:     ; Shift right the copy of the direction.
                            	  9218:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	  9219:     ;
02:0003C3A4 E208            	  9220:     lsr.b  #1,D0   ; LSR A
02:0003C3A6 6402            	  9221:     bcc  _anon_z04_151
02:0003C3A8 7008            	  9222:     moveq   #8,D0
                            	  9223: _anon_z04_151:
                            	  9224:     ; If the current direction bit is masked off, then we've reached
                            	  9225:     ; the opposite direction. Loop again.
                            	  9226:     ;
02:0003C3AA 122C050F        	  9227:     move.b  ($050F,A4),D1
02:0003C3AE C200            	  9228:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C3B0 67F2            	  9229:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	  9230:     ; If Y register >= $40, then break out of the loop.
                            	  9231:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	  9232:     ;
02:0003C3B2 0C030040        	  9233:     cmpi.b  #$40,D3
02:0003C3B6 6404            	  9234:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	  9235:     ; Set Y register to $40 in order to break out of the loop next time;
                            	  9236:     ; and loop again now.
                            	  9237:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	  9238:     ;
02:0003C3B8 7640            	  9239:     moveq   #64,D3
02:0003C3BA 65E8            	  9240:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	  9241:     even
                            	  9242: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	  9243:     ; Change the facing direction to the direction found.
                            	  9244:     ;
02:0003C3BC 41EC0098        	  9245:     lea     ($0098,A4),A0
02:0003C3C0 11802000        	  9246:     move.b  D0,(A0,D2.W)
                            	  9247:     ; Set moving direction [0F] for boundary and tile checks.
                            	  9248:     ;
02:0003C3C4 1940000F        	  9249:     move.b  D0,($000F,A4)
02:0003C3C8 4EB90003085C    	  9250:     jsr     BoundByRoom
                            	  9251:     ; If not blocked by the room boundary, then go check tile collision.
                            	  9252:     ;
02:0003C3CE 102C000F        	  9253:     move.b  ($000F,A4),D0
02:0003C3D2 6618            	  9254:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	  9255:     even
                            	  9256: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	  9257:     ; Else it was blocked. So, load the facing direction in preparation
                            	  9258:     ; for looking for any non-opposite direction that is not blocked.
                            	  9259:     ;
02:0003C3D4 41EC0098        	  9260:     lea     ($0098,A4),A0
02:0003C3D8 10302000        	  9261:     move.b  (A0,D2.W),D0
                            	  9262:     even
                            	  9263: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	  9264:     ; Shift right the copy of the direction.
                            	  9265:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	  9266:     ;
02:0003C3DC E208            	  9267:     lsr.b  #1,D0   ; LSR A
02:0003C3DE 6402            	  9268:     bcc  _anon_z04_152
02:0003C3E0 7008            	  9269:     moveq   #8,D0
                            	  9270: _anon_z04_152:
                            	  9271:     ; If the current direction bit is not masked off, then go check the
                            	  9272:     ; room boundary in this direction.
                            	  9273:     ; Else we've reached the opposite direction. Loop again.
                            	  9274:     ;
02:0003C3E2 122C050F        	  9275:     move.b  ($050F,A4),D1
02:0003C3E6 C200            	  9276:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C3E8 66D2            	  9277:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003C3EA 67F0            	  9278:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	  9279:     even
                            	  9280: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	  9281:     ; We found a direction that was not blocked by the room boundary.
                            	  9282:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	  9283:     ;
02:0003C3EC 4EB900048B24    	  9284:     jsr     GetCollidingTileMoving
02:0003C3F2 122C034A        	  9285:     move.b  ($034A,A4),D1
02:0003C3F6 B001            	  9286:     cmp.b   D1,D0
02:0003C3F8 64DA            	  9287:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	  9288:     even
                            	  9289: _L_z04_Lamnola_UpdateHead_Exit:
