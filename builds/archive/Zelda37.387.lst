                            	  6084: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6085:     ; Store the weapon's frame (horizontal or vertical)
                            	  6086:     ; for the direction chosen above in [0C].
                            	  6087:     ;
02:00049C78 4EB90003086C    	  6088:     jsr     GetOppositeDir
02:00049C7E 41F9000496B2    	  6089:     lea     (RDirectionToWeaponFrame).l,A0
02:00049C84 10303000        	  6090:     move.b  (A0,D3.W),D0
02:00049C88 1940000C        	  6091:     move.b  D0,($000C,A4)
                            	  6092:     ; Calculate sprite attributes.
                            	  6093:     ;
                            	  6094:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6095:     ;   base attribute OR 1
                            	  6096:     ; So, it uses palette row 5.
                            	  6097:     ;
02:00049C8C 41F9000496B6    	  6098:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049C92 10303000        	  6099:     move.b  (A0,D3.W),D0
02:00049C96 0C02000D        	  6100:     cmpi.b  #$0D,D2
02:00049C9A 6706            	  6101:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00049C9C 00000001        	  6102:     ori.b #$01,D0
02:00049CA0 601C            	  6103:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6104: 
                            	  6105:     even
                            	  6106: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6107:     ; The weapon is the sword.
                            	  6108:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6109:     ;
02:00049CA2 023C00EE        	  6110:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049CA6 122C0657        	  6111:     move.b  ($0657,A4),D1
02:00049CAA D101            	  6112:     addx.b  D1,D0   ; ADC Items
02:00049CAC 003C0011        	  6113:     ori     #$11,CCR  ; SEC: set C+X
02:00049CB0 123C0001        	  6114:     move.b  #$01,D1
02:00049CB4 0A3C0010        	  6115:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049CB8 9101            	  6116:     subx.b  D1,D0   ; SBC #$01
02:00049CBA 0A3C0010        	  6117:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6118:     even
                            	  6119: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6120:     ; Set sprite attributes to the calculated value above.
                            	  6121:     ;
02:00049CBE 4EB900030F2E    	  6122:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6123:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6124:     ;
02:00049CC4 0C030002        	  6125:     cmpi.b  #$02,D3
02:00049CC8 6604            	  6126:     bne  _anon_z07_33
02:00049CCA 522C000F        	  6127:     addq.b  #1,($000F,A4)
                            	  6128: _anon_z07_33:
                            	  6129:     ; If state = 1, return. Don't show the weapon.
                            	  6130:     ;
02:00049CCE 41EC00AC        	  6131:     lea     ($00AC,A4),A0
02:00049CD2 10302000        	  6132:     move.b  (A0,D2.W),D0
02:00049CD6 0200000F        	  6133:     andi.b #$0F,D0
02:00049CDA 0C000001        	  6134:     cmpi.b  #$01,D0
02:00049CDE 6604            	  6135:     bne.s  __far_z_07_0091
02:00049CE0 600000AA        	  6136:     jmp  L1F854_Exit
                            	  6137: __far_z_07_0091:
                            	  6138:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  6139:     ; sword or rod
                            	  6140:     ;
                            	  6141:     ;
                            	  6142:     ; Sword slot
02:00049CE4 7600            	  6143:     moveq   #0,D3
02:00049CE6 0C02000D        	  6144:     cmpi.b  #$0D,D2
02:00049CEA 6702            	  6145:     beq  _anon_z07_34
02:00049CEC 7608            	  6146:     moveq   #8,D3
                            	  6147: _anon_z07_34:
02:00049CEE 4EB900030E4E    	  6148:     jsr     Anim_WriteItemSprites
                            	  6149:     ; If state <> 3, return.
                            	  6150:     ;
02:00049CF4 41EC00AC        	  6151:     lea     ($00AC,A4),A0
02:00049CF8 10302000        	  6152:     move.b  (A0,D2.W),D0
02:00049CFC 0200000F        	  6153:     andi.b #$0F,D0
02:00049D00 0C000003        	  6154:     cmpi.b  #$03,D0
02:00049D04 6704            	  6155:     beq.s  __far_z_07_0092
02:00049D06 60000084        	  6156:     jmp  L1F854_Exit
                            	  6157: __far_z_07_0092:
                            	  6158:     ; State = 3. Time to instantiate a shot.
                            	  6159:     ;
                            	  6160:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6161:     ;
02:00049D0A 0C020012        	  6162:     cmpi.b  #$12,D2
02:00049D0E 6704            	  6163:     beq.s  __far_z_07_0093
02:00049D10 60000082        	  6164:     jmp  MakeSwordShot
                            	  6165: __far_z_07_0093:
                            	  6166:     ; Instantiate a magic shot (rod shot).
                            	  6167:     ; Switch to the shot slot $E.
                            	  6168:     ;
02:00049D14 740E            	  6169:     moveq   #14,D2
                            	  6170:     ; If high bit of state is set, return. It's already active.
                            	  6171:     ;
02:00049D16 41EC00AC        	  6172:     lea     ($00AC,A4),A0
02:00049D1A 10302000        	  6173:     move.b  (A0,D2.W),D0
02:00049D1E 6706            	  6174:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00049D20 E308            	  6175:     lsl.b  #1,D0   ; ASL A
02:00049D22 6402            	  6176:     bcc.s  __far_z_07_0094
02:00049D24 6066            	  6177:     jmp  L1F854_Exit
                            	  6178: __far_z_07_0094:
                            	  6179:     even
                            	  6180: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6181:     ; Play "magic shot" tune.
                            	  6182:     ;
02:00049D26 7004            	  6183:     moveq   #4,D0
02:00049D28 19400604        	  6184:     move.b  D0,($0604,A4)
