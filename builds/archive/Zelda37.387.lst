                            	  5179: UpdateBoomerangOrFood:
                            	  5180:     ; If state = 0, then not active. So, return.
                            	  5181:     ;
02:00049606 41EC00AC        	  5182:     lea     ($00AC,A4),A0
02:0004960A 10302000        	  5183:     move.b  (A0,D2.W),D0
02:0004960E 6602            	  5184:     bne.s  __far_z_07_0078
02:00049610 60F2            	  5185:     jmp  L1F49F_Exit
                            	  5186: __far_z_07_0078:
                            	  5187:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5188:     ;
02:00049612 E308            	  5189:     lsl.b  #1,D0   ; ASL A
02:00049614 6504            	  5190:     bcs.s  __far_z_07_0079
02:00049616 600000AA        	  5191:     jmp  UpdateArrowOrBoomerang
                            	  5192: __far_z_07_0079:
                            	  5193:     ; The object is food.
                            	  5194:     ;
                            	  5195:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5196:     ; If we reach state $83, then go deactivate the object.
                            	  5197:     ;
                            	  5198:     ; Nothing changes between the states. So, they are used as
                            	  5199:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5200:     ;
02:0004961A 10342028        	  5201:     move.b  ($28,A4,D2.W),D0
02:0004961E 6622            	  5202:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:00049620 41EC00AC        	  5203:     lea     ($00AC,A4),A0
02:00049624 52302000        	  5204:     addq.b  #1,(A0,D2.W)
02:00049628 41EC00AC        	  5205:     lea     ($00AC,A4),A0
02:0004962C 10302000        	  5206:     move.b  (A0,D2.W),D0
02:00049630 0200000F        	  5207:     andi.b #$0F,D0
02:00049634 0C000003        	  5208:     cmpi.b  #$03,D0
02:00049638 674C            	  5209:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004963A 103C00FF        	  5210:     move.b  #$FF,D0
02:0004963E 19802028        	  5211:     move.b  D0,($28,A4,D2.W)
                            	  5212:     even
                            	  5213: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5214:     ; If the template object type in the room is one of:
                            	  5215:     ; moblin, goriya, octorock, vire, keese
                            	  5216:     ; then attract these monsters to the food.
                            	  5217:     ;
                            	  5218:     ; They will chase the food instead of Link when given a chance.
                            	  5219:     ;
02:00049642 102C035F        	  5220:     move.b  ($035F,A4),D0
02:00049646 0C000003        	  5221:     cmpi.b  #$03,D0
02:0004964A 652C            	  5222:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:0004964C 0C00000B        	  5223:     cmpi.b  #$0B,D0
02:00049650 6512            	  5224:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:00049652 0C000012        	  5225:     cmpi.b  #$12,D0
