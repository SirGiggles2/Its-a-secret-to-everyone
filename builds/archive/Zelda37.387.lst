                            	  4799: UpdateMode13WinGame_Sub3:
                            	  4800:     ; After scrolling 8 pixels, draw another tile row.
                            	  4801:     ;
02:00035050 102C050B        	  4802:     move.b  ($050B,A4),D0
02:00035054 0C000008        	  4803:     cmpi.b  #$08,D0
02:00035058 6B1A            	  4804:     bmi  _anon_z02_37
02:0003505A 102C050B        	  4805:     move.b  ($050B,A4),D0
02:0003505E 123C0008        	  4806:     move.b  #$08,D1
02:00035062 0A3C0010        	  4807:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035066 9101            	  4808:     subx.b  D1,D0   ; SBC #$08
02:00035068 0A3C0010        	  4809:     eori    #$10,CCR  ; restore X = 6502 C
02:0003506C 1940050B        	  4810:     move.b  D0,($050B,A4)
02:00035070 61000282        	  4811:     jsr     DrawCredits
                            	  4812: _anon_z02_37:
                            	  4813:     ; Add $80 to the scroll speed fraction.
                            	  4814:     ;
02:00035074 102C0058        	  4815:     move.b  ($0058,A4),D0
02:00035078 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003507C 123C0080        	  4817:     move.b  #$80,D1
02:00035080 D101            	  4818:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00035082 19400058        	  4819:     move.b  D0,($0058,A4)
                            	  4820:     ; Carry over to the tile offset and current V-scroll.
                            	  4821:     ;
02:00035086 6404            	  4822:     bcc  _anon_z02_38
02:00035088 522C050B        	  4823:     addq.b  #1,($050B,A4)
                            	  4824: _anon_z02_38:
02:0003508C 102C00FC        	  4825:     move.b  ($00FC,A4),D0
02:00035090 123C0000        	  4826:     move.b  #$00,D1
02:00035094 D101            	  4827:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035096 194000FC        	  4828:     move.b  D0,($00FC,A4)
                            	  4829:     ; If we've reached the bottom of a nametable, then
                            	  4830:     ; roll over current V-scroll to 0, and increase number of
                            	  4831:     ; screens scrolled.
                            	  4832:     ;
02:0003509A 0C0000F0        	  4833:     cmpi.b  #$F0,D0
02:0003509E 7000            	  4834:     moveq   #0,D0
02:000350A0 6508            	  4835:     bcs  _anon_z02_39
02:000350A2 194000FC        	  4836:     move.b  D0,($00FC,A4)
02:000350A6 522C00E2        	  4837:     addq.b  #1,($00E2,A4)
                            	  4838: _anon_z02_39:
                            	  4839:     ; Roll the carry from the comparison above into bit 0.
                            	  4840:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  4841:     ;
02:000350AA E310            	  4842:     roxl.b  #1,D0   ; ROL A
02:000350AC 1940005C        	  4843:     move.b  D0,($005C,A4)
                            	  4844:     ; Put the quest number in Y register.
                            	  4845:     ;
02:000350B0 7600            	  4846:     moveq   #0,D3
02:000350B2 7400            	  4847:     moveq   #0,D2
