02:000480C4 023C00EE        	  2126:     andi    #$EE,CCR  ; CLC: clear C+X
02:000480C8 122C0004        	  2127:     move.b  ($0004,A4),D1
02:000480CC D101            	  2128:     addx.b  D1,D0   ; ADC $04
02:000480CE 4A02            	  2129:     cmpi.b  #$00,D2
