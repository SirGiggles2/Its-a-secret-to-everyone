                            	  2480: ;==============================================================================
                            	  2481: ; DMC APU register stubs (Phase D)
                            	  2482: ;
                            	  2483: ; Zelda's SelectDMC routine (transpiled at z_00.asm:_L_z00_DriveSample_*)
                            	  2484: ; writes the APU DMC registers in a fixed order whenever it wants to play
                            	  2485: ; a sample effect:
                            	  2486: ;
                            	  2487: ;     $4010  <- SampleRates[idx-1]   ; rate nibble (low 4 bits)
                            	  2488: ;     $4012  <- SampleAddrs[idx-1]   ; start addr high byte ($C000 + b*64)
                            	  2489: ;     $4013  <- SampleLengths[idx-1] ; length byte (length = b*16 + 1)
                            	  2490: ;     $4015  <- $0F                  ; enable all non-DMC channels
                            	  2491: ;     $4015  <- $1F                  ; OR in bit 4 -> DMC playback
                            	  2492: ;
                            	  2493: ; We shadow $4010 and $4012 on write so that when $4015 arrives with bit 4
                            	  2494: ; set we can recover the intended sample index via DMC_SAMPLE_LOOKUP.
                            	  2495: ;==============================================================================
                            	  2496: _apu_write_4010:
02:0002AE5C 13C000FFE10C    	  2497:     move.b  D0,(dmc_rate_sel).l
02:0002AE62 4E75            	  2498:     rts
                            	  2499: 
                            	  2500: _apu_write_4012:
02:0002AE64 13C000FFE10D    	  2501:     move.b  D0,(dmc_addr_sel).l
02:0002AE6A 4E75            	  2502:     rts
                            	  2503: 
                            	  2504: _apu_write_4013:
02:0002AE6C 13C000FFE10E    	  2505:     move.b  D0,(dmc_len_sel).l
02:0002AE72 4E75            	  2506:     rts
                            	  2507: 
                            	  2508: _apu_write_4015:
02:0002AE74 08000004        	  2509:     btst    #4,D0                       ; DMC enable bit?
02:0002AE78 673E            	  2510:     beq.s   .no_dmc                     ; clearing → stop playback
                            	  2511:     ; Look up (addr, rate) in DMC_SAMPLE_LOOKUP.  Walk 7 {addr,rate,idx,0}
                            	  2512:     ; quads; on match, load the 1-based index into D1 and call dmc_trigger.
02:0002AE7A 48E77080        	  2513:     movem.l D1-D3/A0,-(SP)
02:0002AE7E 143900FFE10D    	  2514:     move.b  (dmc_addr_sel).l,D2
02:0002AE84 163900FFE10C    	  2515:     move.b  (dmc_rate_sel).l,D3
02:0002AE8A 41F900001928    	  2516:     lea     (DMC_SAMPLE_LOOKUP).l,A0
02:0002AE90 7206            	  2517:     moveq   #DMC_SAMPLE_COUNT-1,D1
                            	  2518: .scan:
02:0002AE92 B410            	  2519:     cmp.b   (A0),D2
02:0002AE94 6616            	  2520:     bne.s   .next
02:0002AE96 B6280001        	  2521:     cmp.b   1(A0),D3
02:0002AE9A 6610            	  2522:     bne.s   .next
                            	  2523:     ; Match: 3rd byte of the quad is the 1-based index
02:0002AE9C 7200            	  2524:     moveq   #0,D1
02:0002AE9E 12280002        	  2525:     move.b  2(A0),D1
02:0002AEA2 1001            	  2526:     move.b  D1,D0                       ; dmc_trigger wants index in D0.b
02:0002AEA4 4EB9000005B0    	  2527:     bsr     dmc_trigger
02:0002AEAA 6006            	  2528:     bra.s   .done
                            	  2529: .next:
02:0002AEAC 5888            	  2530:     addq.l  #4,A0
02:0002AEAE 51C9FFE2        	  2531:     dbra    D1,.scan
                            	  2532:     ; No match — silently ignore (unknown rate/addr combo, not fatal)
                            	  2533: .done:
02:0002AEB2 4CDF010E        	  2534:     movem.l (SP)+,D1-D3/A0
02:0002AEB6 4E75            	  2535:     rts
                            	  2536: .no_dmc:
                            	  2537:     ; Bit 4 clear — if DMC currently playing, stop it.
02:0002AEB8 4A3900FFE100    	  2538:     tst.b   (dmc_active).l
02:0002AEBE 6706            	  2539:     beq.s   .no_dmc_done
02:0002AEC0 42B900FFE108    	  2540:     clr.l   (dmc_remain).l
                            	  2541: .no_dmc_done:
02:0002AEC6 4E75            	  2542:     rts
