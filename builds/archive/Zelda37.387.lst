                            	  9681: _anon_z04_159:
02:0003C6D6 61000D98        	  9682:     jsr     DecreaseObjectAngle
                            	  9683:     ; Load Patra's maneuver index.
                            	  9684:     ; It determines which counts of bits are looked up below.
                            	  9685:     ;
02:0003C6DA 7600            	  9686:     moveq   #0,D3
02:0003C6DC 162C045F        	  9687:     move.b  ($045F,A4),D3
                            	  9688:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  9689:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  9690:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  9691:     ;
02:0003C6E0 41EC034F        	  9692:     lea     ($034F,A4),A0
02:0003C6E4 10302000        	  9693:     move.b  (A0,D2.W),D0
02:0003C6E8 0C000025        	  9694:     cmpi.b  #$25,D0
02:0003C6EC 661E            	  9695:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003C6EE 41F90003C5E0    	  9696:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003C6F4 10303000        	  9697:     move.b  (A0,D3.W),D0
02:0003C6F8 1B00            	  9698:     move.b  D0,-(A5)  ; PHA
02:0003C6FA 41F90003C5E4    	  9699:     lea     (PatraChild1RotationSineBits).l,A0
02:0003C700 10303000        	  9700:     move.b  (A0,D3.W),D0
02:0003C704 7600            	  9701:     moveq   #0,D3
02:0003C706 1600            	  9702:     move.b  D0,D3
02:0003C708 101D            	  9703:     move.b  (A5)+,D0  ; PLA
02:0003C70A 600E            	  9704:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  9705: 
                            	  9706:     even
                            	  9707: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  9708:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  9709:     ; for both Y and X increment calculations in rotation. This leads to
                            	  9710:     ; a small circle (5) and a large circle (6).
                            	  9711:     ;
02:0003C70C 41F90003C5E2    	  9712:     lea     (PatraChild2RotationBits).l,A0
02:0003C712 10303000        	  9713:     move.b  (A0,D3.W),D0
02:0003C716 7600            	  9714:     moveq   #0,D3
02:0003C718 1600            	  9715:     move.b  D0,D3
                            	  9716:     even
