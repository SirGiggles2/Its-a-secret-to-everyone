                            	  2469: 
                            	  2470: _anon_z04_42:
                            	  2471:     ; State 0.
                            	  2472:     ;
                            	  2473:     ; In state we determine whether to burst out of the ground.
                            	  2474:     ; If the long timer has not expired, then return.
                            	  2475:     ;
02:000391CE 102C004D        	  2476:     move.b  ($004D,A4),D0
02:000391D2 6674            	  2477:     bne  _L_z04_UpdateRedLeever_Exit
                            	  2478:     ; Only allow two red leevers at a time.
                            	  2479:     ;
02:000391D4 102C0510        	  2480:     move.b  ($0510,A4),D0
02:000391D8 0C000002        	  2481:     cmpi.b  #$02,D0
02:000391DC 646A            	  2482:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2483:     ; Face in the same direction as Link.
                            	  2484:     ;
02:000391DE 102C0098        	  2485:     move.b  ($0098,A4),D0
02:000391E2 41EC0098        	  2486:     lea     ($0098,A4),A0
02:000391E6 11802000        	  2487:     move.b  D0,(A0,D2.W)
                            	  2488:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  2489:     ;
02:000391EA 10342019        	  2490:     move.b  ($19,A4,D2.W),D0
02:000391EE 0C0000C0        	  2491:     cmpi.b  #$C0,D0
02:000391F2 6506            	  2492:     bcs  _anon_z04_43
02:000391F4 4EB9000490D0    	  2493:     jsr     ReverseObjDir
                            	  2494: _anon_z04_43:
                            	  2495:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  2496:     ;
02:000391FA 41EC0098        	  2497:     lea     ($0098,A4),A0
02:000391FE 10302000        	  2498:     move.b  (A0,D2.W),D0
02:00039202 0200000C        	  2499:     andi.b #$0C,D0
02:00039206 6742            	  2500:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  2501:     ; Begin with the leever's X set to Link's X.
                            	  2502:     ;
02:00039208 102C0070        	  2503:     move.b  ($0070,A4),D0
02:0003920C 19802070        	  2504:     move.b  D0,($70,A4,D2.W)
                            	  2505:     ; If facing down, then use Y offset $28.
                            	  2506:     ; Else store Y offset -$28 in [00].
                            	  2507:     ;
02:00039210 7628            	  2508:     moveq   #40,D3
02:00039212 41EC0098        	  2509:     lea     ($0098,A4),A0
02:00039216 10302000        	  2510:     move.b  (A0,D2.W),D0
02:0003921A 02000008        	  2511:     andi.b #$08,D0
02:0003921E 6704            	  2512:     beq  _anon_z04_44
02:00039220 163C00D8        	  2513:     move.b  #$D8,D3
                            	  2514: _anon_z04_44:
02:00039224 1883            	  2515:     move.b  D3,($0000,A4)
                            	  2516:     ; Add Link's Y and the vertical offset.
                            	  2517:     ;
02:00039226 102C0084        	  2518:     move.b  ($0084,A4),D0
02:0003922A 023C00EE        	  2519:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003922E 1214            	  2520:     move.b  ($0000,A4),D1
02:00039230 D101            	  2521:     addx.b  D1,D0   ; ADC $00
                            	  2522:     ; Sanitize the Y coordinate:
                            	  2523:     ; (Y AND $F0) OR $D
                            	  2524:     ;
02:00039232 020000F0        	  2525:     andi.b #$F0,D0
02:00039236 0000000D        	  2526:     ori.b #$0D,D0
02:0003923A 41EC0084        	  2527:     lea     ($0084,A4),A0
02:0003923E 11802000        	  2528:     move.b  D0,(A0,D2.W)
                            	  2529:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2530:     ; go see if the tile is valid to come out of.
                            	  2531:     ;
                            	  2532:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2533:     ;
02:00039242 0C00005D        	  2534:     cmpi.b  #$5D,D0
02:00039246 647A            	  2535:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  2536:     even
                            	  2537: _L_z04_UpdateRedLeever_Exit:
02:00039248 4E75            	  2538:     rts
                            	  2539: 
                            	  2540:     even
                            	  2541: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  2542:     ; Begin with the leever's Y set to Link's Y.
                            	  2543:     ;
02:0003924A 102C0084        	  2544:     move.b  ($0084,A4),D0
02:0003924E 41EC0084        	  2545:     lea     ($0084,A4),A0
02:00039252 11802000        	  2546:     move.b  D0,(A0,D2.W)
                            	  2547:     ; If Y coordinate < $5D (top of the third square row), then
                            	  2548:     ; it's too close to the top edge of the screen. So, return.
                            	  2549:     ;
02:00039256 0C00005D        	  2550:     cmpi.b  #$5D,D0
02:0003925A 65EC            	  2551:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  2552:     ; If facing right, then use X offset $28.
                            	  2553:     ; Else store X offset -$28 in [00].
                            	  2554:     ;
02:0003925C 7628            	  2555:     moveq   #40,D3
02:0003925E 41EC0098        	  2556:     lea     ($0098,A4),A0
02:00039262 10302000        	  2557:     move.b  (A0,D2.W),D0
02:00039266 02000002        	  2558:     andi.b #$02,D0
02:0003926A 6704            	  2559:     beq  _anon_z04_45
02:0003926C 163C00D8        	  2560:     move.b  #$D8,D3
                            	  2561: _anon_z04_45:
02:00039270 1883            	  2562:     move.b  D3,($0000,A4)
                            	  2563:     ; [01] holds Link's X coordinate.
                            	  2564:     ;
02:00039272 102C0070        	  2565:     move.b  ($0070,A4),D0
02:00039276 19400001        	  2566:     move.b  D0,($0001,A4)
                            	  2567:     ; Add Link's X and the horizontal offset.
                            	  2568:     ;
02:0003927A 023C00EE        	  2569:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003927E 1214            	  2570:     move.b  ($0000,A4),D1
02:00039280 D101            	  2571:     addx.b  D1,D0   ; ADC $00
                            	  2572:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  2573:     ;
02:00039282 020000F8        	  2574:     andi.b #$F8,D0
                            	  2575:     ; Assign that result to the leever's X coordinate and [02].
                            	  2576:     ;
02:00039286 19802070        	  2577:     move.b  D0,($70,A4,D2.W)
02:0003928A 19400002        	  2578:     move.b  D0,($0002,A4)
                            	  2579:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  2580:     ;
02:0003928E 122C0001        	  2581:     move.b  ($0001,A4),D1
02:00039292 B001            	  2582:     cmp.b   D1,D0
02:00039294 6510            	  2583:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00039296 1B00            	  2584:     move.b  D0,-(A5)  ; PHA
02:00039298 102C0001        	  2585:     move.b  ($0001,A4),D0
02:0003929C 19400002        	  2586:     move.b  D0,($0002,A4)
02:000392A0 101D            	  2587:     move.b  (A5)+,D0  ; PLA
02:000392A2 19400001        	  2588:     move.b  D0,($0001,A4)
                            	  2589:     even
                            	  2590: _L_z04_UpdateRedLeever_Subtract:
                            	  2591:     ; The point is to get the absolute distance between the two.
                            	  2592:     ;
02:000392A6 102C0001        	  2593:     move.b  ($0001,A4),D0
02:000392AA 003C0011        	  2594:     ori     #$11,CCR  ; SEC: set C+X
02:000392AE 122C0002        	  2595:     move.b  ($0002,A4),D1
02:000392B2 0A3C0010        	  2596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000392B6 9101            	  2597:     subx.b  D1,D0   ; SBC $02
02:000392B8 0A3C0010        	  2598:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2599:     ; If the absolute distance >= $30, then return.
                            	  2600:     ; It means that the leever's X coordinate wrapped around
                            	  2601:     ; the left or right edge of the screen.
                            	  2602:     ;
02:000392BC 0C000030        	  2603:     cmpi.b  #$30,D0
02:000392C0 6486            	  2604:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2605:     even
                            	  2606: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  2607:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  2608:     ;
02:000392C2 4EB900048B1E    	  2609:     jsr     GetCollidableTileStill
02:000392C8 122C034A        	  2610:     move.b  ($034A,A4),D1
02:000392CC B001            	  2611:     cmp.b   D1,D0
02:000392CE 6400FF78        	  2612:     bcc  _L_z04_UpdateRedLeever_Exit
02:000392D2 522C0510        	  2613:     addq.b  #1,($0510,A4)
                            	  2614:     ; Set animation counter to 1, so that it will roll over this frame
                            	  2615:     ; and pick up whatever the new value is for state 1.
                            	  2616:     ;
02:000392D6 7001            	  2617:     moveq   #1,D0
02:000392D8 41EC03D0        	  2618:     lea     ($03D0,A4),A0
02:000392DC 11802000        	  2619:     move.b  D0,(A0,D2.W)
                            	  2620:     ; Set the long timer to 2, meaning 20 frames.
                            	  2621:     ;
02:000392E0 E308            	  2622:     lsl.b  #1,D0   ; ASL A
02:000392E2 1940004D        	  2623:     move.b  D0,($004D,A4)
02:000392E6 6100008C        	  2624:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  2625:     ; The leever has to face Link in order to move toward him.
                            	  2626:     ;
02:000392EA 4EB9000490D0    	  2627:     jsr     ReverseObjDir
                            	  2628:     even
                            	  2629: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  2630:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  2631:     ;
02:000392F0 41EC00AC        	  2632:     lea     ($00AC,A4),A0
02:000392F4 10302000        	  2633:     move.b  (A0,D2.W),D0
02:000392F8 0C000003        	  2634:     cmpi.b  #$03,D0
02:000392FC 666E            	  2635:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  2636:     ; State 3.
                            	  2637:     ;
                            	  2638:     ; If being shoved, go shove, animate, and draw the leever.
                            	  2639:     ;
02:000392FE 41EC00C0        	  2640:     lea     ($00C0,A4),A0
02:00039302 10302000        	  2641:     move.b  (A0,D2.W),D0
02:00039306 670A            	  2642:     beq  _L_z04_UpdateRedLeever_CheckStunned
02:00039308 4EB900048B38    	  2643:     jsr     Obj_Shove
