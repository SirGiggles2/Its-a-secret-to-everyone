                            	 10336: Ganon_CheckCollisions:
                            	 10337:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 10338:     ; Store in [02] and [03].
                            	 10339:     ;
02:0003CB6A 10342070        	 10340:     move.b  ($70,A4,D2.W),D0
02:0003CB6E 023C00EE        	 10341:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB72 123C0010        	 10342:     move.b  #$10,D1
02:0003CB76 D101            	 10343:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CB78 19400002        	 10344:     move.b  D0,($0002,A4)
02:0003CB7C 41EC0084        	 10345:     lea     ($0084,A4),A0
02:0003CB80 10302000        	 10346:     move.b  (A0,D2.W),D0
02:0003CB84 023C00EE        	 10347:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB88 123C0010        	 10348:     move.b  #$10,D1
02:0003CB8C D101            	 10349:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CB8E 19400003        	 10350:     move.b  D0,($0003,A4)
                            	 10351:     ; Check for a collision with Link.
                            	 10352:     ;
                            	 10353:     ; We can't call CheckLinkCollision, because we need to
                            	 10354:     ; customize Ganon's midpoint.
                            	 10355:     ;
                            	 10356:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 10357:     ; detection, if Link is invincible. Initialize variables that will
                            	 10358:     ; be returned from the partial collision check routine. Then
                            	 10359:     ; call it.
                            	 10360:     ;
02:0003CB92 102C04F0        	 10361:     move.b  ($04F0,A4),D0
02:0003CB96 6616            	 10362:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003CB98 19400006        	 10363:     move.b  D0,($0006,A4)
02:0003CB9C 19400009        	 10364:     move.b  D0,($0009,A4)
02:0003CBA0 1940000C        	 10365:     move.b  D0,($000C,A4)
02:0003CBA4 7600            	 10366:     moveq   #0,D3
02:0003CBA6 1883            	 10367:     move.b  D3,($0000,A4)
02:0003CBA8 4EB900031012    	 10368:     jsr     CheckLinkCollisionPreinit
                            	 10369:     even
                            	 10370: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 10371:     ; If Ganon is not in state 0, then he's brown.
                            	 10372:     ; Go check collision with an arrow.
                            	 10373:     ;
02:0003CBAE 41EC00AC        	 10374:     lea     ($00AC,A4),A0
02:0003CBB2 10302000        	 10375:     move.b  (A0,D2.W),D0
02:0003CBB6 6652            	 10376:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 10377:     ; If timer <> 0, then Ganon is visible.
                            	 10378:     ; He can't be harmed like this. So, return.
                            	 10379:     ;
02:0003CBB8 10342028        	 10380:     move.b  ($28,A4,D2.W),D0
02:0003CBBC 664A            	 10381:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003CBBE 760D            	 10382:     moveq   #13,D3
02:0003CBC0 4EB90003104C    	 10383:     jsr     CheckMonsterSwordCollision
                            	 10384:     ; If Ganon has died according to the usual collision check rules
                            	 10385:     ; (HP = 0), then:
                            	 10386:     ; 1. Restore HP to the initial value $F0
                            	 10387:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 10388:     ; 3. Change palette row 7 to make Ganon brown
                            	 10389:     ;
02:0003CBC6 41EC0405        	 10390:     lea     ($0405,A4),A0
02:0003CBCA 10302000        	 10391:     move.b  (A0,D2.W),D0
02:0003CBCE 6718            	 10392:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003CBD0 103C00F0        	 10393:     move.b  #$F0,D0
02:0003CBD4 41EC0485        	 10394:     lea     ($0485,A4),A0
02:0003CBD8 11802000        	 10395:     move.b  D0,(A0,D2.W)
02:0003CBDC 41EC00AC        	 10396:     lea     ($00AC,A4),A0
02:0003CBE0 53302000        	 10397:     subq.b  #1,(A0,D2.W)
02:0003CBE4 61000084        	 10398:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 10399:     even
                            	 10400: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 10401:     ; If Ganon was harmed, then play the sound effect
                            	 10402:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 10403:     ;
02:0003CBE8 41EC04F0        	 10404:     lea     ($04F0,A4),A0
02:0003CBEC 10302000        	 10405:     move.b  (A0,D2.W),D0
02:0003CBF0 670A            	 10406:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003CBF2 6100B60E        	 10407:     jsr     PlayBossHitCryIfNeeded
02:0003CBF6 7040            	 10408:     moveq   #64,D0
02:0003CBF8 19802028        	 10409:     move.b  D0,($28,A4,D2.W)
                            	 10410:     even
                            	 10411: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 10412:     ; Reset metastate, because Ganon cannot die this way.
                            	 10413:     ;
02:0003CBFC 4EB90004A9DE    	 10414:     jsr     ResetObjMetastate
                            	 10415:     ; Reset shove info and invincibility timer, because Ganon
                            	 10416:     ; doesn't react at all as a usual monster.
                            	 10417:     ;
02:0003CC02 4EB90003103A    	 10418:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 10419:     even
                            	 10420: _L_z04_Ganon_CheckCollisions_Exit:
02:0003CC08 4E75            	 10421:     rts
                            	 10422: 
                            	 10423:     even
                            	 10424: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 10425:     ; If the silver arrow is not in the inventory, then return.
                            	 10426:     ;
02:0003CC0A 102C0659        	 10427:     move.b  ($0659,A4),D0
02:0003CC0E 0C000002        	 10428:     cmpi.b  #$02,D0
02:0003CC12 66F4            	 10429:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10430:     ; Reset the collision return value [06].
                            	 10431:     ;
02:0003CC14 7000            	 10432:     moveq   #0,D0
02:0003CC16 19400006        	 10433:     move.b  D0,($0006,A4)
                            	 10434:     ; If there's no arrow in flight, then return.
                            	 10435:     ;
02:0003CC1A 7612            	 10436:     moveq   #18,D3
02:0003CC1C 41EC00AC        	 10437:     lea     ($00AC,A4),A0
02:0003CC20 10303000        	 10438:     move.b  (A0,D3.W),D0
02:0003CC24 0C000010        	 10439:     cmpi.b  #$10,D0
02:0003CC28 66DE            	 10440:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10441:     ; Check for collision with an arrow; and return if no collision.
                            	 10442:     ;
02:0003CC2A 4EB900031054    	 10443:     jsr     CheckMonsterArrowOrRodCollision
02:0003CC30 102C0006        	 10444:     move.b  ($0006,A4),D0
02:0003CC34 67D2            	 10445:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 10446:     ; Set the Ganon phase to "dying".
                            	 10447:     ;
02:0003CC36 41EC042C        	 10448:     lea     ($042C,A4),A0
02:0003CC3A 52302000        	 10449:     addq.b  #1,(A0,D2.W)
                            	 10450:     ; Now his body does flash.
                            	 10451:     ;
02:0003CC3E 7028            	 10452:     moveq   #40,D0
02:0003CC40 41EC04F0        	 10453:     lea     ($04F0,A4),A0
02:0003CC44 11802000        	 10454:     move.b  D0,(A0,D2.W)
                            	 10455:     ; Set initial cloud distance 8.
                            	 10456:     ;
02:0003CC48 7008            	 10457:     moveq   #8,D0
02:0003CC4A 41EC0478        	 10458:     lea     ($0478,A4),A0
02:0003CC4E 11802000        	 10459:     move.b  D0,(A0,D2.W)
02:0003CC52 0A3C0001        	 10460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003CC56 4E75            	 10461:     rts
                            	 10462: 
                            	 10463:     even
