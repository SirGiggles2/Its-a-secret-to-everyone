02:00030D2C 102C0003        	  2248:     move.b  ($0003,A4),D0
02:00030D30 19400002        	  2249:     move.b  D0,($0002,A4)
02:00030D34 101D            	  2250:     move.b  (A5)+,D0  ; PLA
02:00030D36 19400003        	  2251:     move.b  D0,($0003,A4)
