                            	  6213: _L_z04_UpdatePolsVoice_State0:
                            	  6214:     ; State 0. Walking.
                            	  6215:     ;
                            	  6216:     ; If grid offset = 0, then no more distance to cover.
                            	  6217:     ; So, go change to state 1 -- jumping.
                            	  6218:     ;
02:0003AC96 41EC0394        	  6219:     lea     ($0394,A4),A0
02:0003AC9A 10302000        	  6220:     move.b  (A0,D2.W),D0
02:0003AC9E 67000084        	  6221:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  6222:     ; Decrement grid offset / distance remaining.
                            	  6223:     ;
02:0003ACA2 41EC0394        	  6224:     lea     ($0394,A4),A0
02:0003ACA6 53302000        	  6225:     subq.b  #1,(A0,D2.W)
                            	  6226:     ; Move vertically.
                            	  6227:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  6228:     ;
02:0003ACAA 41EC0084        	  6229:     lea     ($0084,A4),A0
02:0003ACAE 10302000        	  6230:     move.b  (A0,D2.W),D0
