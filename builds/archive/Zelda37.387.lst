02:00038D30 102C066C        	  1863:     move.b  ($066C,A4),D0
02:00038D34 1234203D        	  1864:     move.b  ($3D,A4,D2.W),D1
02:00038D38 8001            	  1865:     or.b  D1,D0
02:00038D3A 66F0            	  1866:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  1867:     ; If state <> 0, go update the jump.
