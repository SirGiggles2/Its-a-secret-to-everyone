                            	  4770: Moldorm_ChangeFlyingState:
                            	  4771:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  4772:     ;
02:0003A236 61000096        	  4773:     jsr     Flyer_MoldormDecideState
02:0003A23A 7010            	  4774:     moveq   #16,D0
02:0003A23C 19802028        	  4775:     move.b  D0,($28,A4,D2.W)
                            	  4776:     ; If the next lower slot's direction <> 0, then
                            	  4777:     ; go propagate direction changes down the chain.
                            	  4778:     ;
                            	  4779:     ; But you had to have propagated directions once for the
                            	  4780:     ; next lower direction to be set. How does it happen?
                            	  4781:     ;
                            	  4782:     ; Within a flyer state, the flying routines turn the flyer
                            	  4783:     ; and set the object timer to $10 several times. After any of
                            	  4784:     ; those times will the test succeed.
                            	  4785:     ;
                            	  4786:     ; When a flying state ends, timer will be 0, triggering the code
                            	  4787:     ; in this block to set the timer to $10, and try to propagate
                            	  4788:     ; directions.
                            	  4789:     ;
                            	  4790:     ; But this is also the case the first time here.
                            	  4791:     ;
                            	  4792:     ; So, I believe that the point of this test is to delay moving
                            	  4793:     ; the lower (not head) segments when starting out.
                            	  4794:     ;
02:0003A240 41EC0097        	  4795:     lea     ($0097,A4),A0
02:0003A244 10302000        	  4796:     move.b  (A0,D2.W),D0
02:0003A248 6702            	  4797:     beq.s  __far_z_04_0035
02:0003A24A 601C            	  4798:     jmp  Moldorm_PropagateDirs
