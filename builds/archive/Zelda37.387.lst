02:000418A6 123C0040        	  7081:     move.b  #$40,D1
02:000418AA 0A3C0010        	  7082:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000418AE 9101            	  7083:     subx.b  D1,D0   ; SBC #$40
02:000418B0 0A3C0010        	  7084:     eori    #$10,CCR  ; restore X = 6502 C
02:000418B4 E208            	  7085:     lsr.b  #1,D0   ; LSR A
02:000418B6 E208            	  7086:     lsr.b  #1,D0   ; LSR A
02:000418B8 E208            	  7087:     lsr.b  #1,D0   ; LSR A
                            	  7088:     ; Add this row offset to the column address.
                            	  7089:     ;
02:000418BA 4EB9000308F0    	  7090:     jsr     AddToInt16At0
                            	  7091:     ; Assume that we'll write a type 1 square with primary square
                            	  7092:     ; taken from [05]. If so, the square index doesn't matter
                            	  7093:     ; as long as >= $10. See WriteSquareOW.
                            	  7094:     ;
02:000418C0 7600            	  7095:     moveq   #0,D3
02:000418C2 7410            	  7096:     moveq   #16,D2
02:000418C4 102C0005        	  7097:     move.b  ($0005,A4),D0
                            	  7098:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7099:     ; So, we have to look up the square index corresponding
                            	  7100:     ; to primary square/tile in [05].
                            	  7101:     ;
                            	  7102:     ; Look in primary square table from $E to 1. If a match is found,
