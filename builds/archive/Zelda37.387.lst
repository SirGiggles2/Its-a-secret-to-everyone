02:0003C5F0 6000009E        	  9557:     jmp  PatraChild_State1
                            	  9558: __far_z_04_0100:
                            	  9559:     ; State = 0.
                            	  9560:     ;
                            	  9561:     ; If the current object slot is 2, then go initialize the patra child.
                            	  9562:     ; This is the only patra child shown in the first fame.
                            	  9563:     ;
02:0003C5F4 0C020002        	  9564:     cmpi.b  #$02,D2
02:0003C5F8 6732            	  9565:     beq  _L_z04_UpdatePatraChild_Ready
                            	  9566:     ; The patra child in slot 2 is the last one to be updated.
                            	  9567:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  9568:     ;
                            	  9569:     ; This means that in the first frame, slot 2 is the only one to be
                            	  9570:     ; shown.
                            	  9571:     ;
02:0003C5FA 102C00AE        	  9572:     move.b  ($00AE,A4),D0
02:0003C5FE 6700008E        	  9573:     beq  _L_z04_UpdatePatraChild_Exit
                            	  9574:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  9575:     ; here to wait to be shown at the top position (N) one at a time.
                            	  9576:     ;
02:0003C602 1002            	  9577:     move.b  D2,D0
                            	  9578:     ; Subtract 3 from the object slot to get the angle where the
                            	  9579:     ; patra child in object slot 2 should be for the current one to appear.
                            	  9580:     ;
02:0003C604 003C0011        	  9581:     ori     #$11,CCR  ; SEC: set C+X
02:0003C608 123C0003        	  9582:     move.b  #$03,D1
02:0003C60C 0A3C0010        	  9583:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C610 9101            	  9584:     subx.b  D1,D0   ; SBC #$03
02:0003C612 0A3C0010        	  9585:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C616 7600            	  9586:     moveq   #0,D3
02:0003C618 1600            	  9587:     move.b  D0,D3
                            	  9588:     ; If the patra child in slot 2 has not reached the required angle,
                            	  9589:     ; then return.
                            	  9590:     ;
02:0003C61A 102C0396        	  9591:     move.b  ($0396,A4),D0
02:0003C61E 41F90003C5D8    	  9592:     lea     (PatraChildStartAngles).l,A0
02:0003C624 12303000        	  9593:     move.b  (A0,D3.W),D1
02:0003C628 B001            	  9594:     cmp.b   D1,D0
02:0003C62A 6662            	  9595:     bne  _L_z04_UpdatePatraChild_Exit
                            	  9596:     even
                            	  9597: _L_z04_UpdatePatraChild_Ready:
                            	  9598:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  9599:     ; the patra parent's state.
                            	  9600:     ;
02:0003C62C 0C020009        	  9601:     cmpi.b  #$09,D2
02:0003C630 6604            	  9602:     bne  _anon_z04_157
02:0003C632 522C00AD        	  9603:     addq.b  #1,($00AD,A4)
                            	  9604: _anon_z04_157:
                            	  9605:     ; Go to state 1 to orbit.
                            	  9606:     ;
02:0003C636 41EC00AC        	  9607:     lea     ($00AC,A4),A0
02:0003C63A 52302000        	  9608:     addq.b  #1,(A0,D2.W)
                            	  9609:     ; TODO: ?
                            	  9610:     ;
02:0003C63E 103C0080        	  9611:     move.b  #$80,D0
02:0003C642 41EC0098        	  9612:     lea     ($0098,A4),A0
02:0003C646 11802000        	  9613:     move.b  D0,(A0,D2.W)
                            	  9614:     ; Set angle $18 (N).
                            	  9615:     ;
02:0003C64A 7018            	  9616:     moveq   #24,D0
02:0003C64C 41EC0394        	  9617:     lea     ($0394,A4),A0
02:0003C650 11802000        	  9618:     move.b  D0,(A0,D2.W)
                            	  9619:     ; This location is right above Patra.
                            	  9620:     ; Set X coordinate to Patra's.
                            	  9621:     ;
02:0003C654 102C0071        	  9622:     move.b  ($0071,A4),D0
02:0003C658 19802070        	  9623:     move.b  D0,($70,A4,D2.W)
                            	  9624:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  9625:     ; Else use radius $18. Store the chosen value in [00].
                            	  9626:     ;
02:0003C65C 702C            	  9627:     moveq   #44,D0
02:0003C65E 7600            	  9628:     moveq   #0,D3
02:0003C660 41EC034F        	  9629:     lea     ($034F,A4),A0
02:0003C664 16302000        	  9630:     move.b  (A0,D2.W),D3
02:0003C668 0C030025        	  9631:     cmpi.b  #$25,D3
02:0003C66C 6702            	  9632:     beq  _anon_z04_158
02:0003C66E 7018            	  9633:     moveq   #24,D0
                            	  9634: _anon_z04_158:
02:0003C670 1880            	  9635:     move.b  D0,($0000,A4)
                            	  9636:     ; This location is right above Patra.
