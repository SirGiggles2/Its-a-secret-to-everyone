02:00038DEC 41F900038D16    	  1966:     lea     (JumperStartSpeedsHi).l,A0
02:00038DF2 10303000        	  1967:     move.b  (A0,D3.W),D0
02:00038DF6 41EC0412        	  1968:     lea     ($0412,A4),A0
02:00038DFA 11802000        	  1969:     move.b  D0,(A0,D2.W)
