                            	  6743: ; Description:
                            	  6744: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  6745: ; When walking, the object timer is set. When teleporting,
                            	  6746: ; the teleporting distance remaining is set.
                            	  6747: ;
                            	  6748: ; If we have the magic clock, then only go draw and check collisions.
                            	  6749: ;
                            	  6750:     even
                            	  6751: UpdateBlueWizzrobe:
02:0003B10E 102C066C        	  6752:     move.b  ($066C,A4),D0
02:0003B112 6702            	  6753:     beq.s  __far_z_04_0057
02:0003B114 6014            	  6754:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  6755: __far_z_04_0057:
02:0003B116 6116            	  6756:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003B118 61000318        	  6757:     jsr     BlueWizzrobe_TryShooting
                            	  6758:     even
                            	  6759: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  6760:     ; If the teleporting distance remaining is even, then draw
                            	  6761:     ; and check collisions, else return.
                            	  6762:     ;
                            	  6763:     ; This means that when 0, the monster is walking.
                            	  6764:     ; So, draw and check collisions every frame.
                            	  6765:     ;
                            	  6766:     ; When not 0, the monster is teleporting, and must be drawn
                            	  6767:     ; translucently -- every other frame.
                            	  6768:     ;
02:0003B11C 41EC0394        	  6769:     lea     ($0394,A4),A0
02:0003B120 10302000        	  6770:     move.b  (A0,D2.W),D0
02:0003B124 E208            	  6771:     lsr.b  #1,D0   ; LSR A
02:0003B126 6402            	  6772:     bcc.s  __far_z_04_0058
02:0003B128 603A            	  6773:     jmp  L11E17_Exit
                            	  6774: __far_z_04_0058:
                            	  6775:     even
                            	  6776: L_Wizzrobe_DrawAndCheckCollisions:
02:0003B12A 600004DE        	  6777:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  6778: 
                            	  6779:     even
