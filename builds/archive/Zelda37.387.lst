02:000494E0 4EF90002B8B6    	  5007:     jmp     c_set_shot_spreading_state
                            	  5008: 
                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:000494E6 41EC0098        	  5017:     lea     ($0098,A4),A0
02:000494EA 10302000        	  5018:     move.b  (A0,D2.W),D0
02:000494EE 19400002        	  5019:     move.b  D0,($0002,A4)
02:000494F2 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:000494F6 7000            	  5023:     moveq   #0,D0
02:000494F8 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:000494FC 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:000494FE 1003            	  5031:     move.b  D3,D0
02:00049500 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:00049502 102C0002        	  5035:     move.b  ($0002,A4),D0
02:00049506 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:00049508 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004950C 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004950E 102C0015        	  5046:     move.b  ($0015,A4),D0
02:00049512 02000003        	  5047:     andi.b #$03,D0
02:00049516 41F900049374    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004951C 12303000        	  5049:     move.b  (A0,D3.W),D1
02:00049520 8001            	  5050:     or.b  D1,D0
02:00049522 4EB900030F2E    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:00049528 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004952C 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049530 122C0002        	  5057:     move.b  ($0002,A4),D1
02:00049534 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:00049536 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:00049538 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004953C B001            	  5064:     cmp.b   D1,D0
02:0004953E 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:00049540 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:00049544 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:00049546 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004954A 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004954E 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049552 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:00049554 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:00049558 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004955A 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004955E 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:00049562 1214            	  5079:     move.b  ($0000,A4),D1
02:00049564 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049568 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004956A 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004956E 0C000020        	  5087:     cmpi.b  #$20,D0
02:00049572 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:00049574 41EC0084        	  5092:     lea     ($0084,A4),A0
02:00049578 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004957C 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049580 122C0003        	  5095:     move.b  ($0003,A4),D1
02:00049584 D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:00049586 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004958A 7600            	  5100:     moveq   #0,D3
02:0004958C 162C0010        	  5101:     move.b  ($0010,A4),D3
02:00049590 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:00049592 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:00049596 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:00049598 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004959C 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:0004959E 7002            	  5112:     moveq   #2,D0
02:000495A0 1940000C        	  5113:     move.b  D0,($000C,A4)
02:000495A4 7623            	  5114:     moveq   #35,D3
02:000495A6 4EB900030E4E    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:000495AC 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:000495AE 19400003        	  5123:     move.b  D0,($0003,A4)
02:000495B2 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:000495B4 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:000495B8 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:000495BA 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:000495BC 7600            	  5136:     moveq   #0,D3
02:000495BE 1600            	  5137:     move.b  D0,D3
02:000495C0 0C030001        	  5138:     cmpi.b  #$01,D3
02:000495C4 6602            	  5139:     bne  _anon_z07_25
02:000495C6 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:000495C8 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:000495CC 4600            	  5143:     eori.b #$FF,D0
02:000495CE 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:000495D2 123C0001        	  5145:     move.b  #$01,D1
02:000495D6 D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000495D8 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:000495DC 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:000495DE 7600            	  5151:     moveq   #0,D3
02:000495E0 1600            	  5152:     move.b  D0,D3
02:000495E2 5303            	  5153:     subq.b  #1,D3
02:000495E4 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:000495E8 41EC0098        	  5160:     lea     ($0098,A4),A0
02:000495EC 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:000495F0 41EC0098        	  5166:     lea     ($0098,A4),A0
02:000495F4 10302000        	  5167:     move.b  (A0,D2.W),D0
02:000495F8 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:000495FC 6702            	  5169:     beq.s  __far_z_07_0077
02:000495FE 6004            	  5170:     jmp  L1F49F_Exit
                            	  5171: __far_z_07_0077:
