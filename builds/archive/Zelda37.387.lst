                            	 10273: Ganon_DrawBody:
                            	 10274:     ; Loop over four 16x16 images that make up Ganon.
                            	 10275:     ; There are 6 animation frames.
                            	 10276:     ;
02:0003CAEE 7603            	 10277:     moveq   #3,D3
                            	 10278:     even
                            	 10279: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 10280:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 10281:     ;
02:0003CAF0 10342070        	 10282:     move.b  ($70,A4,D2.W),D0
02:0003CAF4 023C00EE        	 10283:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAF8 41F90003CAE2    	 10284:     lea     (GanonSpriteOffsetsX).l,A0
02:0003CAFE 12303000        	 10285:     move.b  (A0,D3.W),D1
02:0003CB02 D101            	 10286:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003CB04 1880            	 10287:     move.b  D0,($0000,A4)
                            	 10288:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 10289:     ;
02:0003CB06 41EC0084        	 10290:     lea     ($0084,A4),A0
02:0003CB0A 10302000        	 10291:     move.b  (A0,D2.W),D0
02:0003CB0E 023C00EE        	 10292:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB12 41F90003CAE6    	 10293:     lea     (GanonSpriteOffsetsY).l,A0
02:0003CB18 12303000        	 10294:     move.b  (A0,D3.W),D1
02:0003CB1C D101            	 10295:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003CB1E 19400001        	 10296:     move.b  D0,($0001,A4)
                            	 10297:     ; Each part has a horizontal flipping flag.
                            	 10298:     ;
02:0003CB22 41F90003CAEA    	 10299:     lea     (GanonSpriteHFlips).l,A0
02:0003CB28 10303000        	 10300:     move.b  (A0,D3.W),D0
02:0003CB2C 1940000F        	 10301:     move.b  D0,($000F,A4)
                            	 10302:     ; Save and copy the loop index (the current part) to [07].
                            	 10303:     ;
02:0003CB30 1003            	 10304:     move.b  D3,D0
02:0003CB32 1B00            	 10305:     move.b  D0,-(A5)  ; PHA
02:0003CB34 19400007        	 10306:     move.b  D0,($0007,A4)
                            	 10307:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 10308:     ; that make it up.
                            	 10309:     ;
02:0003CB38 41EC046B        	 10310:     lea     ($046B,A4),A0
02:0003CB3C 10302000        	 10311:     move.b  (A0,D2.W),D0
02:0003CB40 E308            	 10312:     lsl.b  #1,D0   ; ASL A
02:0003CB42 E308            	 10313:     lsl.b  #1,D0   ; ASL A
                            	 10314:     ; Add [07] -- the index of the current part.
                            	 10315:     ;
                            	 10316:     ; Now you have an index into the frame image table, for the
                            	 10317:     ; current image part of the current animation frame.
                            	 10318:     ;
02:0003CB44 122C0007        	 10319:     move.b  ($0007,A4),D1
02:0003CB48 D101            	 10320:     addx.b  D1,D0   ; ADC $07
02:0003CB4A 7600            	 10321:     moveq   #0,D3
02:0003CB4C 1600            	 10322:     move.b  D0,D3
02:0003CB4E 41F90003CACA    	 10323:     lea     (GanonFrameImages).l,A0
02:0003CB54 10303000        	 10324:     move.b  (A0,D3.W),D0
02:0003CB58 4EB900030C3C    	 10325:     jsr     DrawObjectNotMirrored
02:0003CB5E 101D            	 10326:     move.b  (A5)+,D0  ; PLA
                            	 10327:     ; Bottom of the part loop.
                            	 10328:     ;
02:0003CB60 7600            	 10329:     moveq   #0,D3
02:0003CB62 1600            	 10330:     move.b  D0,D3
02:0003CB64 5303            	 10331:     subq.b  #1,D3
02:0003CB66 6A88            	 10332:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003CB68 4E75            	 10333:     rts
