                            	  5614: _anon_z05_120:
                            	  5615:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5616:     ;
                            	  5617:     ; Shutters and the commands to open a door always change
                            	  5618:     ; tiles.
                            	  5619:     ;
02:00040B72 61000130        	  5620:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5621:     even
                            	  5622: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5623:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5624:     ; We need to remember how many tiles need to be copied
                            	  5625:     ; in each transfer record.
                            	  5626:     ;
02:00040B76 102C0006        	  5627:     move.b  ($0006,A4),D0
02:00040B7A 19400004        	  5628:     move.b  D0,($0004,A4)
                            	  5629:     ; Write the transfer record header for the door.
                            	  5630:     ;
                            	  5631:     ;
                            	  5632:     ; VRAM address high byte of door
02:00040B7E 1014            	  5633:     move.b  ($0000,A4),D0
02:00040B80 41EC0302        	  5634:     lea     ($0302,A4),A0
02:00040B84 11802000        	  5635:     move.b  D0,(A0,D2.W)
02:00040B88 5202            	  5636:     addq.b  #1,D2
02:00040B8A 102C0001        	  5637:     move.b  ($0001,A4),D0
02:00040B8E 41EC0302        	  5638:     lea     ($0302,A4),A0
02:00040B92 11802000        	  5639:     move.b  D0,(A0,D2.W)
02:00040B96 5202            	  5640:     addq.b  #1,D2
02:00040B98 102C0006        	  5641:     move.b  ($0006,A4),D0
02:00040B9C 41EC0302        	  5642:     lea     ($0302,A4),A0
02:00040BA0 11802000        	  5643:     move.b  D0,(A0,D2.W)
02:00040BA4 5202            	  5644:     addq.b  #1,D2
                            	  5645: _anon_z05_121:
                            	  5646:     ; Write two tiles in a short loop indexed by [04].
                            	  5647:     ;
02:00040BA6 6100ED1C        	  5648:     jsr     WriteDoorFaceTileHorizontally
02:00040BAA 66FA            	  5649:     bne  _anon_z05_121
                            	  5650:     ; OR the low VRAM address with $20 to go down one row
                            	  5651:     ; in order to work on the second row of door tiles.
                            	  5652:     ;
02:00040BAC 7020            	  5653:     moveq   #32,D0
02:00040BAE 122C0001        	  5654:     move.b  ($0001,A4),D1
02:00040BB2 8001            	  5655:     or.b  D1,D0
02:00040BB4 19400001        	  5656:     move.b  D0,($0001,A4)
                            	  5657:     ; Bottom of the loop.
                            	  5658:     ; Loop again to write the second transfer record for the
                            	  5659:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5660:     ;
02:00040BB8 532C0005        	  5661:     subq.b  #1,($0005,A4)
02:00040BBC 66B8            	  5662:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5663:     ; Write the end marker, and update buffer length.
                            	  5664:     ;
02:00040BBE 103C00FF        	  5665:     move.b  #$FF,D0
02:00040BC2 41EC0302        	  5666:     lea     ($0302,A4),A0
02:00040BC6 11802000        	  5667:     move.b  D0,(A0,D2.W)
02:00040BCA 1002            	  5668:     move.b  D2,D0
02:00040BCC 19400301        	  5669:     move.b  D0,($0301,A4)
                            	  5670:     ; Increment the command.
                            	  5671:     ;
02:00040BD0 522C0054        	  5672:     addq.b  #1,($0054,A4)
                            	  5673:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5674:     ; and resetting the door command.
                            	  5675:     ; This ends up catching original states 3 and 7.
                            	  5676:     ;
                            	  5677:     ; Else set door timer to 8 and return.
                            	  5678:     ;
02:00040BD4 102C0054        	  5679:     move.b  ($0054,A4),D0
02:00040BD8 02000003        	  5680:     andi.b #$03,D0
02:00040BDC 6708            	  5681:     beq  _anon_z05_122
02:00040BDE 7008            	  5682:     moveq   #8,D0
02:00040BE0 19400027        	  5683:     move.b  D0,($0027,A4)
02:00040BE4 4E75            	  5684:     rts
                            	  5685: 
                            	  5686: _anon_z05_122:
                            	  5687:     ; If the door command = 4 after incrementing it, then
                            	  5688:     ; it was 3 (close door). So:
                            	  5689:     ; 1. reset this door's flag
                            	  5690:     ; 2. remove it from the opened door mask
                            	  5691:     ; 3. reset the door command
                            	  5692:     ; 4. go lay out doors in the play area map
                            	  5693:     ;
02:00040BE6 102C0054        	  5694:     move.b  ($0054,A4),D0
02:00040BEA 0C000004        	  5695:     cmpi.b  #$04,D0
02:00040BEE 6626            	  5696:     bne  _anon_z05_123
02:00040BF0 7400            	  5697:     moveq   #0,D2
02:00040BF2 142C0009        	  5698:     move.b  ($0009,A4),D2
02:00040BF6 6100DCE2        	  5699:     jsr     ResetDoorFlag
02:00040BFA 102C0055        	  5700:     move.b  ($0055,A4),D0
02:00040BFE 0A00000F        	  5701:     eori.b #$0F,D0
02:00040C02 122C00EE        	  5702:     move.b  ($00EE,A4),D1
02:00040C06 C001            	  5703:     and.b  D1,D0
                            	  5704:     even
                            	  5705: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00040C08 194000EE        	  5706:     move.b  D0,($00EE,A4)
                            	  5707:     even
                            	  5708: L_ResetDoorCmdAndLayOutDoors:
02:00040C0C 7000            	  5709:     moveq   #0,D0
02:00040C0E 19400054        	  5710:     move.b  D0,($0054,A4)
02:00040C12 6000FCD4        	  5711:     jmp     LayOutDoors
                            	  5712: 
                            	  5713: _anon_z05_123:
                            	  5714:     ; Door command <> 4.
                            	  5715:     ; It must be 8, which means it was 7: open door.
                            	  5716:     ;
                            	  5717:     ; If the door is a shutter (7), then go add the door to the
                            	  5718:     ; opened door mask, reset door command, and lay out doors.
                            	  5719:     ;
02:00040C16 102C0055        	  5720:     move.b  ($0055,A4),D0
02:00040C1A 19400002        	  5721:     move.b  D0,($0002,A4)
02:00040C1E 6100FA32        	  5722:     jsr     FindDoorAttrByDoorBit
02:00040C22 0C000007        	  5723:     cmpi.b  #$07,D0
02:00040C26 676E            	  5724:     beq  _anon_z05_124
                            	  5725:     ; Else the door is not a shutter.
                            	  5726:     ;
                            	  5727:     ;
                            	  5728:     ; [09] door direction index
02:00040C28 7400            	  5729:     moveq   #0,D2
02:00040C2A 142C0009        	  5730:     move.b  ($0009,A4),D2
02:00040C2E 6100DCA4        	  5731:     jsr     SetDoorFlag
                            	  5732:     ; Get the next room's ID.
                            	  5733:     ;
02:00040C32 1003            	  5734:     move.b  D3,D0
02:00040C34 023C00EE        	  5735:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040C38 41F900040AF4    	  5736:     lea     (DoorNextRoomIdOffsets).l,A0
02:00040C3E 12302000        	  5737:     move.b  (A0,D2.W),D1
02:00040C42 D101            	  5738:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00040C44 7600            	  5739:     moveq   #0,D3
02:00040C46 1600            	  5740:     move.b  D0,D3
                            	  5741:     ; Flip the door direction index.
                            	  5742:     ;
02:00040C48 1002            	  5743:     move.b  D2,D0
02:00040C4A 0A000001        	  5744:     eori.b #$01,D0
02:00040C4E 7400            	  5745:     moveq   #0,D2
02:00040C50 1400            	  5746:     move.b  D0,D2
                            	  5747:     ; Set the door flag for the opposite door in the next room.
                            	  5748:     ;
02:00040C52 1214            	  5749:     move.b  ($00,A4),D1   ; ptr lo
02:00040C54 182C0001        	  5750:     move.b  ($01,A4),D4  ; ptr hi
02:00040C58 024100FF        	  5751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040C5C E14C            	  5752:     lsl.w   #8,D4
02:00040C5E 8841            	  5753:     or.w    D1,D4             ; D4 = NES ptr addr
02:00040C60 48C4            	  5754:     ext.l   D4
02:00040C62 D8BC00FF0000    	  5755:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040C68 2044            	  5756:     movea.l D4,A0
02:00040C6A 10303000        	  5757:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040C6E 41F900047F82    	  5758:     lea     (LevelMasks).l,A0
02:00040C74 12302000        	  5759:     move.b  (A0,D2.W),D1
02:00040C78 8001            	  5760:     or.b  D1,D0
02:00040C7A 1214            	  5761:     move.b  ($00,A4),D1   ; ptr lo
02:00040C7C 182C0001        	  5762:     move.b  ($01,A4),D4  ; ptr hi
02:00040C80 024100FF        	  5763:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040C84 E14C            	  5764:     lsl.w   #8,D4
02:00040C86 8841            	  5765:     or.w    D1,D4
02:00040C88 48C4            	  5766:     ext.l   D4
02:00040C8A D8BC00FF0000    	  5767:     add.l   #NES_RAM,D4
02:00040C90 2044            	  5768:     movea.l D4,A0
02:00040C92 11803000        	  5769:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5770: _anon_z05_124:
                            	  5771:     ; Add the door to the opened door mask, reset door command,
                            	  5772:     ; and lay out doors.
                            	  5773:     ;
02:00040C96 102C0055        	  5774:     move.b  ($0055,A4),D0
02:00040C9A 122C00EE        	  5775:     move.b  ($00EE,A4),D1
02:00040C9E 8001            	  5776:     or.b  D1,D0
02:00040CA0 6000FF66        	  5777:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5778: 
                            	  5779: ; Params:
                            	  5780: ; [08]: 0 if closed
                            	  5781: ;
                            	  5782: ; Returns:
                            	  5783: ; X: current length of dynamic transfer buf
                            	  5784: ; [00]: door VRAM address high byte
                            	  5785: ; [01]: door VRAM address low byte
                            	  5786: ; [02:03]: address of door tiles for direction and face
                            	  5787: ; [05]: 2, the number of transfer records to write
                            	  5788: ; [06]: 2, the number of tiles in each record
                            	  5789: ; [07]: 0, the first index of a tile to transfer
                            	  5790: ; [09]: door direction index
                            	  5791: ;
                            	  5792: ; Note that this routine is called with triggered doors:
                            	  5793: ; doors that can change state. Their door type numbers are >= 4.
                            	  5794: ;
                            	  5795: ; If this routine were ever called with a fixed door
                            	  5796: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5797: ; values for the door face.
                            	  5798: ;
                            	  5799: ;
                            	  5800: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PrepareWriteHorizontalDoorTransferRecords:
02:00040CA4 102C0055        	  5804:     move.b  ($0055,A4),D0
02:00040CA8 19400002        	  5805:     move.b  D0,($0002,A4)
02:00040CAC 6100F9A4        	  5806:     jsr     FindDoorAttrByDoorBit
02:00040CB0 0C000005        	  5807:     cmpi.b  #$05,D0
02:00040CB4 650C            	  5808:     bcs  _anon_z05_125
02:00040CB6 1B00            	  5809:     move.b  D0,-(A5)  ; PHA
02:00040CB8 7004            	  5810:     moveq   #4,D0
02:00040CBA 4EB9000307BA    	  5811:     jsr     PlaySample
02:00040CC0 101D            	  5812:     move.b  (A5)+,D0  ; PLA
                            	  5813: _anon_z05_125:
                            	  5814:     ; Calculate the door face index in three parts.
                            	  5815:     ;
                            	  5816:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5817:     ; (provisional face index in Y register).
                            	  5818:     ;
02:00040CC2 0C000004        	  5819:     cmpi.b  #$04,D0
02:00040CC6 6602            	  5820:     bne  _anon_z05_126
02:00040CC8 7008            	  5821:     moveq   #8,D0
                            	  5822: _anon_z05_126:
02:00040CCA 0C000001        	  5823:     cmpi.b  #$01,D0
02:00040CCE 6602            	  5824:     bne  _anon_z05_127
02:00040CD0 7004            	  5825:     moveq   #4,D0
                            	  5826: _anon_z05_127:
                            	  5827:     ; Second, subtract 3 from provisional face index.
                            	  5828:     ;
02:00040CD2 003C0011        	  5829:     ori     #$11,CCR  ; SEC: set C+X
02:00040CD6 123C0003        	  5830:     move.b  #$03,D1
02:00040CDA 0A3C0010        	  5831:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040CDE 9101            	  5832:     subx.b  D1,D0   ; SBC #$03
02:00040CE0 0A3C0010        	  5833:     eori    #$10,CCR  ; restore X = 6502 C
02:00040CE4 7600            	  5834:     moveq   #0,D3
02:00040CE6 1600            	  5835:     move.b  D0,D3
                            	  5836:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5837:     ; face index >= 3, then subtract 1 from it.
                            	  5838:     ;
                            	  5839:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5840:     ; then make it 1.
                            	  5841:     ;
02:00040CE8 102C0008        	  5842:     move.b  ($0008,A4),D0
02:00040CEC 6708            	  5843:     beq  _anon_z05_128
02:00040CEE 0C030005        	  5844:     cmpi.b  #$05,D3
02:00040CF2 670A            	  5845:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040CF4 7601            	  5846:     moveq   #1,D3
                            	  5847: _anon_z05_128:
02:00040CF6 0C030003        	  5848:     cmpi.b  #$03,D3
02:00040CFA 6502            	  5849:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040CFC 5303            	  5850:     subq.b  #1,D3
                            	  5851:     even
                            	  5852: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5853:     ; The routine that returned the door type also returned its
                            	  5854:     ; reverse direction index in [03].
                            	  5855:     ;
                            	  5856:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5857:     ;
02:00040CFE 7003            	  5858:     moveq   #3,D0
02:00040D00 003C0011        	  5859:     ori     #$11,CCR  ; SEC: set C+X
02:00040D04 122C0003        	  5860:     move.b  ($0003,A4),D1
02:00040D08 0A3C0010        	  5861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040D0C 9101            	  5862:     subx.b  D1,D0   ; SBC $03
02:00040D0E 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5864:     ; Call this to put the address of door face tiles in [02:03].
                            	  5865:     ;
02:00040D12 6100FD7A        	  5866:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5867:     ; Return the address of the door in the nametable in [01:00].
                            	  5868:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5869:     ;
02:00040D16 41F900040AEC    	  5870:     lea     (DoorVramAddrsHi).l,A0
02:00040D1C 10302000        	  5871:     move.b  (A0,D2.W),D0
02:00040D20 1880            	  5872:     move.b  D0,($0000,A4)
02:00040D22 41F900040AF0    	  5873:     lea     (DoorVramAddrsLo).l,A0
02:00040D28 10302000        	  5874:     move.b  (A0,D2.W),D0
02:00040D2C 19400001        	  5875:     move.b  D0,($0001,A4)
                            	  5876:     ; Return the direction of the door in [09], and the dynamic
                            	  5877:     ; transfer buf length in X register.
                            	  5878:     ;
02:00040D30 19420009        	  5879:     move.b  D2,($0009,A4)
02:00040D34 7400            	  5880:     moveq   #0,D2
02:00040D36 142C0301        	  5881:     move.b  ($0301,A4),D2
                            	  5882:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5883:     ;
02:00040D3A 7000            	  5884:     moveq   #0,D0
02:00040D3C 19400007        	  5885:     move.b  D0,($0007,A4)
02:00040D40 7002            	  5886:     moveq   #2,D0
02:00040D42 19400006        	  5887:     move.b  D0,($0006,A4)
02:00040D46 19400005        	  5888:     move.b  D0,($0005,A4)
02:00040D4A 0A3C0001        	  5889:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040D4E 4E75            	  5890:     rts
