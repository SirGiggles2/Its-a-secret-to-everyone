                            	  2100: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2101:     ; We got here in one of three ways:
                            	  2102:     ;
                            	  2103:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2104:     ;    explicitly.
                            	  2105:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2106:     ;    held an offset that was added to base palette attribute
                            	  2107:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2108:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2109:     ;    held absolute attributes.
                            	  2110:     ;
                            	  2111:     ; At this point, A holds the final sprite attributes.
02:000480B6 7400            	  2112:     moveq   #0,D2
02:000480B8 1942000C        	  2113:     move.b  D2,($000C,A4)
02:000480BC 740F            	  2114:     moveq   #15,D2
                            	  2115:     ; Write sprites.
                            	  2116:     ; A holds the calculated sprite attributes.
                            	  2117:     ; Y holds the item slot.
02:000480BE 4EF900030E40    	  2118:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2119: 
                            	  2120:     even
