                            	  3237: _anon_z05_83:
                            	  3238:     ; Look for the current room in the cellar/shortcut room array.
                            	  3239:     ;
02:0003F036 1883            	  3240:     move.b  D3,($0000,A4)
02:0003F038 163C00FF        	  3241:     move.b  #$FF,D3
02:0003F03C 102C00EB        	  3242:     move.b  ($00EB,A4),D0
                            	  3243: _anon_z05_84:
02:0003F040 5203            	  3244:     addq.b  #1,D3
02:0003F042 41F900FF6BB2    	  3245:     lea     (NES_SRAM+$0BB2).l,A0
02:0003F048 12303000        	  3246:     move.b  (A0,D3.W),D1
02:0003F04C B001            	  3247:     cmp.b   D1,D0
02:0003F04E 66F0            	  3248:     bne  _anon_z05_84
                            	  3249:     ; Add the value of the shortcut chosen to whatever index
                            	  3250:     ; the current room has in the array.
                            	  3251:     ;
                            	  3252:     ; This yields the index of one of the three shortcut rooms
                            	  3253:     ; after the current one.
                            	  3254:     ;
02:0003F050 1003            	  3255:     move.b  D3,D0
02:0003F052 023C00EE        	  3256:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F056 1214            	  3257:     move.b  ($0000,A4),D1
02:0003F058 D101            	  3258:     addx.b  D1,D0   ; ADC $00
                            	  3259:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3260:     ;
02:0003F05A 02000003        	  3261:     andi.b #$03,D0
02:0003F05E 7600            	  3262:     moveq   #0,D3
02:0003F060 1600            	  3263:     move.b  D0,D3
02:0003F062 41F900FF6BB2    	  3264:     lea     (NES_SRAM+$0BB2).l,A0
02:0003F068 10303000        	  3265:     move.b  (A0,D3.W),D0
                            	  3266: ; Params:
                            	  3267: ; A: destination room ID
                            	  3268: ;
                            	  3269:     even
                            	  3270: GoToModeAFromCellar:
02:0003F06C 194000EB        	  3271:     move.b  D0,($00EB,A4)
02:0003F070 4EB900047F8A    	  3272:     jsr     MarkRoomVisited
                            	  3273:     even
