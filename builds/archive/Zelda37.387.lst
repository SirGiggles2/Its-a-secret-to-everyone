                            	  6361: UpdatePolsVoiceState1_Jumping:
                            	  6362:     ; Add acceleration $38 to low speed byte (vertical).
                            	  6363:     ;
02:0003ADC2 41EC0444        	  6364:     lea     ($0444,A4),A0
02:0003ADC6 10302000        	  6365:     move.b  (A0,D2.W),D0
02:0003ADCA 023C00EE        	  6366:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADCE 123C0038        	  6367:     move.b  #$38,D1
02:0003ADD2 D101            	  6368:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003ADD4 41EC0444        	  6369:     lea     ($0444,A4),A0
02:0003ADD8 11802000        	  6370:     move.b  D0,(A0,D2.W)
                            	  6371:     ; Add Carry to high speed byte (vertical).
                            	  6372:     ;
02:0003ADDC 41EC0412        	  6373:     lea     ($0412,A4),A0
02:0003ADE0 10302000        	  6374:     move.b  (A0,D2.W),D0
02:0003ADE4 123C0000        	  6375:     move.b  #$00,D1
02:0003ADE8 D101            	  6376:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003ADEA 41EC0412        	  6377:     lea     ($0412,A4),A0
02:0003ADEE 11802000        	  6378:     move.b  D0,(A0,D2.W)
                            	  6379:     ; Add high speed byte to Y coordinate.
                            	  6380:     ;
02:0003ADF2 023C00EE        	  6381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADF6 41EC0084        	  6382:     lea     ($0084,A4),A0
02:0003ADFA 12302000        	  6383:     move.b  (A0,D2.W),D1
02:0003ADFE D101            	  6384:     addx.b  D1,D0   ; ADC ObjY,X
02:0003AE00 41EC0084        	  6385:     lea     ($0084,A4),A0
02:0003AE04 11802000        	  6386:     move.b  D0,(A0,D2.W)
                            	  6387:     ; If the speed is still negative, then return.
                            	  6388:     ;
02:0003AE08 41EC0412        	  6389:     lea     ($0412,A4),A0
02:0003AE0C 10302000        	  6390:     move.b  (A0,D2.W),D0
02:0003AE10 6B0000AC        	  6391:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  6392:     ; If Y coordinate still < target Y, then return.
