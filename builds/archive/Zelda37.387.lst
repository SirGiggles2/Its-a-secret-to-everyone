02:00038A66 0A3C0010        	  1401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038A6A 9101            	  1402:     subx.b  D1,D0   ; SBC $0002,Y
02:00038A6C 0A3C0010        	  1403:     eori    #$10,CCR  ; restore X = 6502 C
02:00038A70 0C000018        	  1404:     cmpi.b  #$18,D0
