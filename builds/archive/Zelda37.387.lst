02:0003D3A2 10302000        	 11564:     move.b  (A0,D2.W),D0
02:0003D3A6 003C0011        	 11565:     ori     #$11,CCR  ; SEC: set C+X
02:0003D3AA 123C0008        	 11566:     move.b  #$08,D1
02:0003D3AE 0A3C0010        	 11567:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D3B2 9101            	 11568:     subx.b  D1,D0   ; SBC #$08
