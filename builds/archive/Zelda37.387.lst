                            	   858: _L_z02_AnimateDemoPhase1Subphase2_CheckText:
                            	   859:     ; Check text and NT attributes.
                            	   860:     ;
02:000327E6 7400            	   861:     moveq   #0,D2
02:000327E8 142C0419        	   862:     move.b  ($0419,A4),D2
02:000327EC 41F900032226    	   863:     lea     (DemoLineAttrs).l,A0
02:000327F2 10302000        	   864:     move.b  (A0,D2.W),D0
02:000327F6 02000080        	   865:     andi.b #$80,D0
02:000327FA 6742            	   866:     beq  _L_z02_AnimateDemoPhase1Subphase2_ProcessAttrs
                            	   867:     ; PATCHED (P8): Replace broken NES indirect-pointer text lookup with
                            	   868:     ; direct M68K addressing. DemoLineTextAddrs contains word offsets.
02:000327FC 102C042E        	   869:     move.b  ($042E,A4),D0
02:00032800 024000FF        	   870:     andi.w  #$00FF,D0
02:00032804 E348            	   871:     lsl.w   #1,D0                ; * 2 for word-sized offset table
02:00032806 41F900032578    	   872:     lea     (DemoLineTextAddrs).l,A0
02:0003280C 30300000        	   873:     move.w  (A0,D0.W),D0        ; D0.w = offset into DemoTextFields
02:00032810 41F900032364    	   874:     lea     (DemoTextFields).l,A0
02:00032816 D0C0            	   875:     adda.w  D0,A0               ; A0 -> text field entry in ROM
02:00032818 7600            	   876:     moveq   #0,D3               ; Y index into text field
02:0003281A 10303000        	   877:     move.b  (A0,D3.W),D0        ; first byte = column offset
02:0003281E 7400            	   878:     moveq   #0,D2
02:00032820 1400            	   879:     move.b  D0,D2
                            	   880:     even
                            	   881: _L_z02_AnimateDemoPhase1Subphase2_CopyLine:
                            	   882:     ; X (D2) = offset into destination line.
                            	   883:     ; Y (D3) = offset into source tiles of current text record.
                            	   884:     ; A0 = pointer to current text field (preserved across loop).
02:00032822 5203            	   885:     addq.b  #1,D3
