02:0002B324 4EB90000E92C    	  3131:     bsr     _compose_bg_tile_word
02:0002B32A 3F00            	  3132:     move.w  D0,-(SP)
02:0002B32C 3C05            	  3133:     move.w  D5,D6
02:0002B32E 04462000        	  3134:     subi.w  #$2000,D6
