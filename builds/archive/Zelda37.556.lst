02:00047304 103C00FF        	  2390:     move.b  #$FF,D0
02:00047308 41EC030C        	  2391:     lea     ($030C,A4),A0
02:0004730C 11802000        	  2392:     move.b  D0,(A0,D2.W)
                            	  2393:     ; Update dynamic buffer length with 10 new bytes.
                            	  2394:     ;
02:00047310 1002            	  2395:     move.b  D2,D0
02:00047312 023C00EE        	  2396:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047316 123C000A        	  2397:     move.b  #$0A,D1
02:0004731A D101            	  2398:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0004731C 19400301        	  2399:     move.b  D0,($0301,A4)
02:00047320 101D            	  2400:     move.b  (A5)+,D0  ; PLA
02:00047322 7400            	  2401:     moveq   #0,D2
02:00047324 1400            	  2402:     move.b  D0,D2
02:00047326 7005            	  2403:     moveq   #5,D0
02:00047328 610026F2        	  2404:     jsr     SwitchBank
