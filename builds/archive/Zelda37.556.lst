                            	  8566: Ganon_CheckCollisions:
                            	  8567:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  8568:     ; Store in [02] and [03].
                            	  8569:     ;
02:0003BE96 10342070        	  8570:     move.b  ($70,A4,D2.W),D0
02:0003BE9A 023C00EE        	  8571:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE9E 123C0010        	  8572:     move.b  #$10,D1
02:0003BEA2 D101            	  8573:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BEA4 19400002        	  8574:     move.b  D0,($0002,A4)
02:0003BEA8 41EC0084        	  8575:     lea     ($0084,A4),A0
02:0003BEAC 10302000        	  8576:     move.b  (A0,D2.W),D0
02:0003BEB0 023C00EE        	  8577:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BEB4 123C0010        	  8578:     move.b  #$10,D1
02:0003BEB8 D101            	  8579:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BEBA 19400003        	  8580:     move.b  D0,($0003,A4)
                            	  8581:     ; Check for a collision with Link.
                            	  8582:     ;
                            	  8583:     ; We can't call CheckLinkCollision, because we need to
                            	  8584:     ; customize Ganon's midpoint.
                            	  8585:     ;
                            	  8586:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  8587:     ; detection, if Link is invincible. Initialize variables that will
                            	  8588:     ; be returned from the partial collision check routine. Then
                            	  8589:     ; call it.
                            	  8590:     ;
02:0003BEBE 102C04F0        	  8591:     move.b  ($04F0,A4),D0
02:0003BEC2 6616            	  8592:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003BEC4 19400006        	  8593:     move.b  D0,($0006,A4)
02:0003BEC8 19400009        	  8594:     move.b  D0,($0009,A4)
02:0003BECC 1940000C        	  8595:     move.b  D0,($000C,A4)
02:0003BED0 7600            	  8596:     moveq   #0,D3
02:0003BED2 1883            	  8597:     move.b  D3,($0000,A4)
02:0003BED4 4EB90003122A    	  8598:     jsr     CheckLinkCollisionPreinit
                            	  8599:     even
                            	  8600: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  8601:     ; If Ganon is not in state 0, then he's brown.
                            	  8602:     ; Go check collision with an arrow.
                            	  8603:     ;
02:0003BEDA 41EC00AC        	  8604:     lea     ($00AC,A4),A0
02:0003BEDE 10302000        	  8605:     move.b  (A0,D2.W),D0
02:0003BEE2 6652            	  8606:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  8607:     ; If timer <> 0, then Ganon is visible.
                            	  8608:     ; He can't be harmed like this. So, return.
                            	  8609:     ;
02:0003BEE4 10342028        	  8610:     move.b  ($28,A4,D2.W),D0
02:0003BEE8 664A            	  8611:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003BEEA 760D            	  8612:     moveq   #13,D3
02:0003BEEC 4EB900031264    	  8613:     jsr     CheckMonsterSwordCollision
                            	  8614:     ; If Ganon has died according to the usual collision check rules
                            	  8615:     ; (HP = 0), then:
                            	  8616:     ; 1. Restore HP to the initial value $F0
                            	  8617:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  8618:     ; 3. Change palette row 7 to make Ganon brown
                            	  8619:     ;
02:0003BEF2 41EC0405        	  8620:     lea     ($0405,A4),A0
02:0003BEF6 10302000        	  8621:     move.b  (A0,D2.W),D0
02:0003BEFA 6718            	  8622:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003BEFC 103C00F0        	  8623:     move.b  #$F0,D0
02:0003BF00 41EC0485        	  8624:     lea     ($0485,A4),A0
02:0003BF04 11802000        	  8625:     move.b  D0,(A0,D2.W)
02:0003BF08 41EC00AC        	  8626:     lea     ($00AC,A4),A0
02:0003BF0C 53302000        	  8627:     subq.b  #1,(A0,D2.W)
02:0003BF10 61000084        	  8628:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  8629:     even
                            	  8630: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  8631:     ; If Ganon was harmed, then play the sound effect
                            	  8632:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  8633:     ;
02:0003BF14 41EC04F0        	  8634:     lea     ($04F0,A4),A0
02:0003BF18 10302000        	  8635:     move.b  (A0,D2.W),D0
02:0003BF1C 670A            	  8636:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003BF1E 6100C2EE        	  8637:     jsr     PlayBossHitCryIfNeeded
02:0003BF22 7040            	  8638:     moveq   #64,D0
02:0003BF24 19802028        	  8639:     move.b  D0,($28,A4,D2.W)
                            	  8640:     even
                            	  8641: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  8642:     ; Reset metastate, because Ganon cannot die this way.
                            	  8643:     ;
02:0003BF28 4EB9000498C8    	  8644:     jsr     ResetObjMetastate
                            	  8645:     ; Reset shove info and invincibility timer, because Ganon
                            	  8646:     ; doesn't react at all as a usual monster.
                            	  8647:     ;
02:0003BF2E 4EB900031252    	  8648:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	  8649:     even
                            	  8650: _L_z04_Ganon_CheckCollisions_Exit:
02:0003BF34 4E75            	  8651:     rts
                            	  8652: 
                            	  8653:     even
                            	  8654: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  8655:     ; If the silver arrow is not in the inventory, then return.
                            	  8656:     ;
02:0003BF36 102C0659        	  8657:     move.b  ($0659,A4),D0
02:0003BF3A 0C000002        	  8658:     cmpi.b  #$02,D0
02:0003BF3E 66F4            	  8659:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8660:     ; Reset the collision return value [06].
                            	  8661:     ;
02:0003BF40 7000            	  8662:     moveq   #0,D0
02:0003BF42 19400006        	  8663:     move.b  D0,($0006,A4)
                            	  8664:     ; If there's no arrow in flight, then return.
                            	  8665:     ;
02:0003BF46 7612            	  8666:     moveq   #18,D3
02:0003BF48 41EC00AC        	  8667:     lea     ($00AC,A4),A0
02:0003BF4C 10303000        	  8668:     move.b  (A0,D3.W),D0
02:0003BF50 0C000010        	  8669:     cmpi.b  #$10,D0
02:0003BF54 66DE            	  8670:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8671:     ; Check for collision with an arrow; and return if no collision.
                            	  8672:     ;
02:0003BF56 4EB90003126C    	  8673:     jsr     CheckMonsterArrowOrRodCollision
02:0003BF5C 102C0006        	  8674:     move.b  ($0006,A4),D0
02:0003BF60 67D2            	  8675:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	  8676:     ; Set the Ganon phase to "dying".
                            	  8677:     ;
