                            	  7146: _L_z07_InitObject_InitMonsterFromEdge:
02:00049504 7400            	  7147:     moveq   #0,D2
02:00049506 142C0340        	  7148:     move.b  ($0340,A4),D2
                            	  7149:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7150:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7151:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7152:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7153:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7154:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7155:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7156:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7157:     ; corrupting them and causing a deterministic address-error
                            	  7158:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7159:     ; identified by Codex static review.)
                            	  7160: _L_z07_P47_pre_check:
02:0004950A 102C0525        	  7161:     move.b  ($0525,A4),D0
02:0004950E 020000F0        	  7162:     andi.b  #$F0,D0
02:00049512 0C000040        	  7163:     cmpi.b  #$40,D0
02:00049516 6506            	  7164:     blo     _L_z07_P47_pre_snap
02:00049518 0C0000E0        	  7165:     cmpi.b  #$E0,D0
02:0004951C 6506            	  7166:     blo     _L_z07_P47_pre_ok
                            	  7167: _L_z07_P47_pre_snap:
02:0004951E 197C00480525    	  7168:     move.b  #$48,($0525,A4)
                            	  7169: _L_z07_P47_pre_ok:
02:00049524 7005            	  7170:     moveq   #5,D0
02:00049526 610004F4        	  7171:     jsr     SwitchBank
02:0004952A 4EB90003E462    	  7172:     jsr     FindNextEdgeSpawnCell
                            	  7173:     ; Post-walk 1: bottom-edge snap.
02:00049530 102C0525        	  7174:     move.b  ($0525,A4),D0
02:00049534 020000F0        	  7175:     andi.b  #$F0,D0
02:00049538 0C0000E0        	  7176:     cmpi.b  #$E0,D0
02:0004953C 660C            	  7177:     bne     _L_z07_P47_post1_ok
02:0004953E 197C00480525    	  7178:     move.b  #$48,($0525,A4)
02:00049544 4EB90003E462    	  7179:     jsr     FindNextEdgeSpawnCell
                            	  7180: _L_z07_P47_post1_ok:
                            	  7181:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7182:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004954A 7600            	  7183:     moveq   #0,D3
02:0004954C 162C0525        	  7184:     move.b  ($0525,A4),D3
02:00049550 0243000F        	  7185:     andi.w  #$000F,D3
02:00049554 C6FC002C        	  7186:     mulu.w  #44,D3
02:00049558 203C00FF6530    	  7187:     move.l  #$FF6530,D0
02:0004955E D083            	  7188:     add.l   D3,D0
02:00049560 7600            	  7189:     moveq   #0,D3
02:00049562 162C0525        	  7190:     move.b  ($0525,A4),D3
02:00049566 E84B            	  7191:     lsr.w   #4,D3
02:00049568 5943            	  7192:     subi.w  #4,D3
02:0004956A E34B            	  7193:     lsl.w   #1,D3
02:0004956C D083            	  7194:     add.l   D3,D0
02:0004956E 2040            	  7195:     movea.l D0,A0
02:00049570 1010            	  7196:     move.b  (A0),D0
02:00049572 0C000084        	  7197:     cmpi.b  #$84,D0
02:00049576 6544            	  7198:     blo     _L_z07_P47_post2_ok
                            	  7199:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7200:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7201:     ; writes to the $05xx region.
02:00049578 7800            	  7202:     moveq   #0,D4
                            	  7203: _L_z07_P47_fb_loop:
02:0004957A 41FAE582        	  7204:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004957E 12304000        	  7205:     move.b  (A0,D4.W),D1
02:00049582 19410525        	  7206:     move.b  D1,($0525,A4)
                            	  7207:     ; Validate fallback cell walkable.
02:00049586 7600            	  7208:     moveq   #0,D3
02:00049588 1601            	  7209:     move.b  D1,D3
02:0004958A 0243000F        	  7210:     andi.w  #$000F,D3
02:0004958E C6FC002C        	  7211:     mulu.w  #44,D3
02:00049592 203C00FF6530    	  7212:     move.l  #$FF6530,D0
02:00049598 D083            	  7213:     add.l   D3,D0
02:0004959A 7600            	  7214:     moveq   #0,D3
02:0004959C 1601            	  7215:     move.b  D1,D3
02:0004959E E84B            	  7216:     lsr.w   #4,D3
02:000495A0 5943            	  7217:     subi.w  #4,D3
02:000495A2 E34B            	  7218:     lsl.w   #1,D3
02:000495A4 D083            	  7219:     add.l   D3,D0
02:000495A6 2040            	  7220:     movea.l D0,A0
02:000495A8 0C100084        	  7221:     cmpi.b  #$84,(A0)
02:000495AC 650E            	  7222:     blo     _L_z07_P47_post2_ok
02:000495AE 5204            	  7223:     addq.b  #1,D4
02:000495B0 0C040008        	  7224:     cmpi.b  #8,D4
02:000495B4 65C4            	  7225:     blo     _L_z07_P47_fb_loop
                            	  7226:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7227:     ; rather than looping).
02:000495B6 197C00480525    	  7228:     move.b  #$48,($0525,A4)
                            	  7229: _L_z07_P47_post2_ok:
                            	  7230:     ; Extract and set the monster's location.
                            	  7231:     ;
02:000495BC 102C0525        	  7232:     move.b  ($0525,A4),D0
                            	  7233:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7234:     ;
02:000495C0 1B00            	  7235:     move.b  D0,-(A5)  ; PHA
02:000495C2 E308            	  7236:     lsl.b  #1,D0   ; ASL A
02:000495C4 E308            	  7237:     lsl.b  #1,D0   ; ASL A
02:000495C6 E308            	  7238:     lsl.b  #1,D0   ; ASL A
02:000495C8 E308            	  7239:     lsl.b  #1,D0   ; ASL A
02:000495CA 19802070        	  7240:     move.b  D0,($70,A4,D2.W)
                            	  7241:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7242:     ;
02:000495CE 101D            	  7243:     move.b  (A5)+,D0  ; PLA
02:000495D0 020000F0        	  7244:     andi.b #$F0,D0
02:000495D4 003C0011        	  7245:     ori     #$11,CCR  ; SEC: set C+X
02:000495D8 123C0003        	  7246:     move.b  #$03,D1
02:000495DC 0A3C0010        	  7247:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000495E0 9101            	  7248:     subx.b  D1,D0   ; SBC #$03
02:000495E2 0A3C0010        	  7249:     eori    #$10,CCR  ; restore X = 6502 C
02:000495E6 41EC0084        	  7250:     lea     ($0084,A4),A0
02:000495EA 11802000        	  7251:     move.b  D0,(A0,D2.W)
                            	  7252:     ; Set the monsters-from-edges long timer to a random value
                            	  7253:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7254:     ;
02:000495EE 10342019        	  7255:     move.b  ($19,A4,D2.W),D0
02:000495F2 02000003        	  7256:     andi.b #$03,D0
02:000495F6 023C00EE        	  7257:     andi    #$EE,CCR  ; CLC: clear C+X
02:000495FA 123C0002        	  7258:     move.b  #$02,D1
02:000495FE D101            	  7259:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049600 1940004B        	  7260:     move.b  D0,($004B,A4)
                            	  7261:     ; If the distance to Link is too close to Link, then
                            	  7262:     ; go flag the monster uninitialized again, so we can
                            	  7263:     ; try to spawn it again next time.
                            	  7264:     ;
02:00049604 7005            	  7265:     moveq   #5,D0
02:00049606 61000414        	  7266:     jsr     SwitchBank
02:0004960A 4EB90003DA76    	  7267:     jsr     IsDistanceSafeToSpawn
02:00049610 6500FEB4        	  7268:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7269:     ; OK to spawn.
                            	  7270:     ; In this situation, monsters don't spawn from a cloud.
                            	  7271:     ;
02:00049614 7000            	  7272:     moveq   #0,D0
02:00049616 41EC0405        	  7273:     lea     ($0405,A4),A0
02:0004961A 11802000        	  7274:     move.b  D0,(A0,D2.W)
                            	  7275:     even
                            	  7276: _L_z07_InitObject_NormalSpawn:
02:0004961E 7004            	  7277:     moveq   #4,D0
02:00049620 610003FA        	  7278:     jsr     SwitchBank
                            	  7279:     ; For monsters that spawn in a cloud, set their start time to
                            	  7280:     ; the same value as the object slot; so that they all start
                            	  7281:     ; moving at different times.
                            	  7282:     ;
02:00049624 7400            	  7283:     moveq   #0,D2
02:00049626 142C0340        	  7284:     move.b  ($0340,A4),D2
02:0004962A 7600            	  7285:     moveq   #0,D3
02:0004962C 41EC034F        	  7286:     lea     ($034F,A4),A0
02:00049630 16302000        	  7287:     move.b  (A0,D2.W),D3
02:00049634 0C03001E        	  7288:     cmpi.b  #$1E,D3
02:00049638 6712            	  7289:     beq  _L_z07_InitObject_FetchAttrs
02:0004963A 0C030022        	  7290:     cmpi.b  #$22,D3
02:0004963E 670C            	  7291:     beq  _L_z07_InitObject_FetchAttrs
02:00049640 0C030053        	  7292:     cmpi.b  #$53,D3
02:00049644 6406            	  7293:     bcc  _L_z07_InitObject_FetchAttrs
02:00049646 1002            	  7294:     move.b  D2,D0
02:00049648 19802028        	  7295:     move.b  D0,($28,A4,D2.W)
                            	  7296:     even
                            	  7297: _L_z07_InitObject_FetchAttrs:
                            	  7298:     ; Store the object attributes for fast access.
