02:00038F4C 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038F50 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038F54 D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00038F56 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
                            	  2110:     ; If facing vertically, go draw mirrored.
                            	  2111:     ;
02:00038F58 41EC0098        	  2112:     lea     ($0098,A4),A0
02:00038F5C 10302000        	  2113:     move.b  (A0,D2.W),D0
02:00038F60 0200000C        	  2114:     andi.b #$0C,D0
