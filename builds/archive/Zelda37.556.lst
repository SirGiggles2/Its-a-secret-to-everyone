02:00049666 1600            	  7312:     move.b  D0,D3
02:00049668 41F90004919C    	  7313:     lea     (ObjectTypeToHpPairs).l,A0
02:0004966E 10303000        	  7314:     move.b  (A0,D3.W),D0
02:00049672 4EB90003C008    	  7315:     jsr     ExtractHitPointValue
02:00049678 41EC0485        	  7316:     lea     ($0485,A4),A0
02:0004967C 11802000        	  7317:     move.b  D0,(A0,D2.W)
                            	  7318:     ; If the object is a cave, go initialize it.
