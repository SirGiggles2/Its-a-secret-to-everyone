                            	  4744: DrawCredits:
                            	  4745:     ; Make a transfer record of a full row of blank tiles.
                            	  4746:     ;
02:00035300 761F            	  4747:     moveq   #31,D3
02:00035302 7024            	  4748:     moveq   #36,D0
                            	  4749: _anon_z02_41:
02:00035304 41EC0305        	  4750:     lea     ($0305,A4),A0
02:00035308 11803000        	  4751:     move.b  D0,(A0,D3.W)
02:0003530C 5303            	  4752:     subq.b  #1,D3
02:0003530E 6AF4            	  4753:     bpl  _anon_z02_41
                            	  4754:     ; No wall tiles go in row 0.
                            	  4755:     ;
02:00035310 102C050A        	  4756:     move.b  ($050A,A4),D0
02:00035314 672C            	  4757:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  4758:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  4759:     ; Rows 2 to $2D get side walls.
                            	  4760:     ;
02:00035316 0C000001        	  4761:     cmpi.b  #$01,D0
02:0003531A 6708            	  4762:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:0003531C 0C00002E        	  4763:     cmpi.b  #$2E,D0
02:00035320 6514            	  4764:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00035322 661E            	  4765:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  4766:     even
