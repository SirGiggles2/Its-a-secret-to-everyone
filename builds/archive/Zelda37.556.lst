                            	  3056:     ; NAMETABLE RANGE ($2000-$23BF): tile index -> Plane A word
                            	  3057:     ;==========================================================================
                            	  3058: .ttf_nt_range:
02:0002B2A0 45F900FF0840    	  3059:     lea     (NT_CACHE_BASE).l,A2
                            	  3060: 
                            	  3061: .ttf_nt_loop:
                            	  3062:     ; Get data byte
02:0002B2A6 4A04            	  3063:     tst.b   D4                      ; repeat mode?
02:0002B2A8 6602            	  3064:     bne.s   .ttf_nt_have_byte
02:0002B2AA 1418            	  3065:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3066: .ttf_nt_have_byte:
                            	  3067: 
                            	  3068:     ; Bounds check
02:0002B2AC 0C4523C0        	  3069:     cmpi.w  #$23C0,D5
02:0002B2B0 64000098        	  3070:     bhs     .ttf_nt_skip            ; long branch (added HUD guard ops)
                            	  3071: 
                            	  3072:     ; Compute index = PPU_VADDR - $2000
02:0002B2B4 3005            	  3073:     move.w  D5,D0
02:0002B2B6 04402000        	  3074:     subi.w  #$2000,D0               ; D0.w = index (0..$3BF)
                            	  3075: 
                            	  3076:     ; T39 HUD row guard (Stage B + Stage C + Stage D + P45 + perf-hoist):
                            	  3077:     ; NT_CACHE rows 0-6 (offsets $000-$0DF) may contain either legitimate
                            	  3078:     ; HUD text (OW mode) or stomped playfield data (cave modes). Skip the
                            	  3079:     ; tile only when the hoisted cave-mode flag D7 is set. Computation of
                            	  3080:     ; D7 happens once at the top of _transfer_tilebuf_fast; the inner
                            	  3081:     ; loop pays only one tst+beq per tile.
02:0002B2BA 0C4000E0        	  3082:     cmpi.w  #$00E0,D0
02:0002B2BE 6406            	  3083:     bhs.s   .ttf_nt_cache_ok        ; offset >= $E0: rows 7+, no guard
02:0002B2C0 4A07            	  3084:     tst.b   D7
02:0002B2C2 66000086        	  3085:     bne     .ttf_nt_skip
                            	  3086: .ttf_nt_cache_ok:
                            	  3087: 
                            	  3088:     ; Cache tile index in NT_CACHE
02:0002B2C6 15820000        	  3089:     move.b  D2,(A2,D0.W)
                            	  3090: 
                            	  3091:     ; Compute VDP address.
                            	  3092:     ; Phase 2 v2: rows 0-7 route to Window plane ($B000, 32-wide stride $40).
                            	  3093:     ; Rows 8-29 → Plane A ($C000, 64-wide stride $80).
02:0002B2CA 3C00            	  3094:     move.w  D0,D6                   ; save index
02:0002B2CC 0246001F        	  3095:     andi.w  #$001F,D6               ; col = index & 31
02:0002B2D0 E34E            	  3096:     lsl.w   #1,D6                   ; col * 2
02:0002B2D2 EA48            	  3097:     lsr.w   #5,D0                   ; row = index >> 5
02:0002B2D4 0C400008        	  3098:     cmpi.w  #8,D0
02:0002B2D8 6524            	  3099:     blo.s   .ttf_nt_window          ; Window plane path
                            	  3100: 
02:0002B2DA C0FC0080        	  3101:     mulu.w  #$0080,D0              ; row * $80
02:0002B2DE D046            	  3102:     add.w   D6,D0                   ; row*$80 + col*2
02:0002B2E0 0640C000        	  3103:     addi.w  #$C000,D0              ; + Plane A base
                            	  3104: 
