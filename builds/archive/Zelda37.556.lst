02:00038E92 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038E96 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038E9A 41F900038C8C    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
