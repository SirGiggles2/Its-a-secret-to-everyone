02:000338A2 19400421        	  2283:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:000338A6 532C0423        	  2284:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:000338AA 122C0070        	  2285:     move.b  ($0070,A4),D1
02:000338AE 5101            	  2286:     subi.b  #8,D1
02:000338B0 19410070        	  2287:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:000338B4 7224            	  2288:     moveq   #$24,D1              ; space tile
02:000338B6 7600            	  2289:     moveq   #0,D3
02:000338B8 1600            	  2290:     move.b  D0,D3                ; D3 = erased offset
02:000338BA 41EC0638        	  2291:     lea     ($0638,A4),A0
02:000338BE 11813000        	  2292:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
