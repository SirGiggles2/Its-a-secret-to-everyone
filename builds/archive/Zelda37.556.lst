02:0000E734 6604            	  1213:     bne.s   .inc32
02:0000E736 5241            	  1214:     addq.w  #1,D1
02:0000E738 6004            	  1215:     bra.s   .store_inc
                            	  1216: .inc32:
02:0000E73A 06410020        	  1217:     addi.w  #32,D1
                            	  1218: .store_inc:
02:0000E73E 02413FFF        	  1219:     andi.w  #$3FFF,D1               ; clamp to valid PPU address range
02:0000E742 33C100FF0802    	  1220:     move.w  D1,(PPU_VADDR).l
02:0000E748 4E75            	  1221:     rts
