02:0002B66C 33FC000000FF0802	  3557:     move.w  #$0000,(PPU_VADDR).l
02:0002B674 423900FF0800    	  3558:     clr.b   (PPU_LATCH).l
02:0002B67A 265F            	  3559:     movea.l (SP)+,A3                ; restore safety limit
02:0002B67C 6000FAE2        	  3560:     bra     .ttf_next_record        ; skip .ttf_post_record
