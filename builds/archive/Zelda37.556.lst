02:0003135E 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:00031360 41F900031332    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:00031366 3A02            	   117:     move.w  D2,D5
02:00031368 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0003136A 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0003136E 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:00031372 41F90003133E    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:00031378 10302000        	   122:     move.b  (A0,D2.W),D0
