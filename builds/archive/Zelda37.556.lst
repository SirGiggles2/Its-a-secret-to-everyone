02:0003BA06 7600            	  7916:     moveq   #0,D3
02:0003BA08 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003BA0C 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003BA10 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003BA14 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003BA18 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BA1A 41F90003B90C    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
