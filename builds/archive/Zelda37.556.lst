02:00039E0C 41EC0084        	  4228:     lea     ($0084,A4),A0
02:00039E10 11802000        	  4229:     move.b  D0,(A0,D2.W)
02:00039E14 101D            	  4230:     move.b  (A5)+,D0  ; PLA
02:00039E16 19802070        	  4231:     move.b  D0,($70,A4,D2.W)
