02:00033796 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:00033798 41F9000331AC    	  2157:     lea     (SlotToNameOffset).l,A0
02:0003379E 10303000        	  2158:     move.b  (A0,D3.W),D0
02:000337A2 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:000337A6 7400            	  2162:     moveq   #0,D2
02:000337A8 41F9000331B0    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:000337AE 14303000        	  2164:     move.b  (A0,D3.W),D2
02:000337B2 7602            	  2165:     moveq   #2,D3
