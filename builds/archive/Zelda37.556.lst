02:0002B34A DA41            	  3144:     add.w   D1,D5                   ; advance PPU_VADDR
02:0002B34C 02453FFF        	  3145:     andi.w  #$3FFF,D5
02:0002B350 5343            	  3146:     subq.w  #1,D3
