                            	  4931: _L_z07_SpreadShot_Draw:
                            	  4932:     ; Draw the corner.
                            	  4933:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4934:     ;
02:00048488 7002            	  4935:     moveq   #2,D0
02:0004848A 1940000C        	  4936:     move.b  D0,($000C,A4)
02:0004848E 7623            	  4937:     moveq   #35,D3
02:00048490 4EB900031066    	  4938:     jsr     Anim_WriteItemSprites
