02:00039C2C 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039C2E 7600            	  3950:     moveq   #0,D3
02:00039C30 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039C34 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
