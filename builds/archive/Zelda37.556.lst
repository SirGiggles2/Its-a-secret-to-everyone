                            	  1053:     ; $2400-source: allow only tile_base_row >= 4 (playfield rows 4+).
02:0000E63E 0C430004        	  1054:     cmpi.w  #4,D3
02:0000E642 650000D2        	  1055:     blo     .nt_skip_write
                            	  1056: .nt_attr_row_ok:
02:0000E646 02420007        	  1057:     andi.w  #$0007,D2
02:0000E64A E54A            	  1058:     lsl.w   #2,D2                   ; D2.w = tile_base_col (0..28)
