02:00038D08 0000000D        	  1797:     ori.b #$0D,D0
02:00038D0C 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038D10 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
