02:0003E276 0C000080        	  3229:     cmpi.b  #$80,D0
02:0003E27A 670A            	  3230:     beq  _anon_z05_83
02:0003E27C 5203            	  3231:     addq.b  #1,D3
02:0003E27E 0C0000B0        	  3232:     cmpi.b  #$B0,D0
