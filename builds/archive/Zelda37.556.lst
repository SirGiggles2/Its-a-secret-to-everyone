02:0003FDDE 41EC0302        	  5637:     lea     ($0302,A4),A0
02:0003FDE2 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:0003FDE6 5202            	  5639:     addq.b  #1,D2
02:0003FDE8 102C0006        	  5640:     move.b  ($0006,A4),D0
02:0003FDEC 41EC0302        	  5641:     lea     ($0302,A4),A0
02:0003FDF0 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:0003FDF4 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:0003FDF6 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:0003FDFA 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:0003FDFC 7020            	  5652:     moveq   #32,D0
02:0003FDFE 122C0001        	  5653:     move.b  ($0001,A4),D1
02:0003FE02 8001            	  5654:     or.b  D1,D0
02:0003FE04 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:0003FE08 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:0003FE0C 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:0003FE0E 103C00FF        	  5664:     move.b  #$FF,D0
02:0003FE12 41EC0302        	  5665:     lea     ($0302,A4),A0
02:0003FE16 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:0003FE1A 1002            	  5667:     move.b  D2,D0
02:0003FE1C 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:0003FE20 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:0003FE24 102C0054        	  5678:     move.b  ($0054,A4),D0
02:0003FE28 02000003        	  5679:     andi.b #$03,D0
02:0003FE2C 6708            	  5680:     beq  _anon_z05_122
02:0003FE2E 7008            	  5681:     moveq   #8,D0
02:0003FE30 19400027        	  5682:     move.b  D0,($0027,A4)
02:0003FE34 4E75            	  5683:     rts
