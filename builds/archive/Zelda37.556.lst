                            	  3264:     ; NAMETABLE 1 RANGE ($2800-$2BBF): tile index -> Plane A word
                            	  3265:     ; Maps NT1 tiles to Plane A rows 30-59 (V64 plane, below NT0 rows 0-29).
                            	  3266:     ;==========================================================================
                            	  3267: .ttf_nt1_range:
02:0002B43E 45F900FF0840    	  3268:     lea     (NT_CACHE_BASE).l,A2
