02:00038488 6078            	   562:     jmp  ResetPushTimer
                            	   563: __far_z_04_0001:
                            	   564:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   565:     ; Get the difference in X.
                            	   566:     ;
02:0003848A 7602            	   567:     moveq   #2,D3
02:0003848C 102C0070        	   568:     move.b  ($0070,A4),D0
02:00038490 003C0011        	   569:     ori     #$11,CCR  ; SEC: set C+X
02:00038494 12342070        	   570:     move.b  ($70,A4,D2.W),D1
02:00038498 0A3C0010        	   571:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003849C 9101            	   572:     subx.b  D1,D0   ; SBC ObjX,X
02:0003849E 0A3C0010        	   573:     eori    #$10,CCR  ; restore X = 6502 C
                            	   574:     even
                            	   575: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   576:     ; If the difference in coordinates is negative, then Link is
                            	   577:     ; up or left of the block.
                            	   578:     ;
                            	   579:     ; In that case, increase Y register to index the correct opposite
                            	   580:     ; direction below. Also, negate the difference, so we test
                            	   581:     ; positive values.
                            	   582:     ;
02:000384A2 6A06            	   583:     bpl  _anon_z04_14
02:000384A4 5203            	   584:     addq.b  #1,D3
02:000384A6 610085E4        	   585:     jsr     Negate
                            	   586: _anon_z04_14:
                            	   587:     ; If the distance >= $11, then go reset the push timer and return.
                            	   588:     ;
02:000384AA 0C000011        	   589:     cmpi.b  #$11,D0
02:000384AE 6502            	   590:     bcs.s  __far_z_04_0002
02:000384B0 6050            	   591:     jmp  ResetPushTimer
                            	   592: __far_z_04_0002:
                            	   593:     ; At this point, Link is aligned with the block.
                            	   594:     ;
                            	   595:     ; If the input direction is not the required direction based on
                            	   596:     ; Link's placement; then go reset the push timer and return.
                            	   597:     ;
02:000384B2 102C03F8        	   598:     move.b  ($03F8,A4),D0
02:000384B6 41F90003841A    	   599:     lea     (BlockPushDirections).l,A0
02:000384BC 12303000        	   600:     move.b  (A0,D3.W),D1
02:000384C0 B001            	   601:     cmp.b   D1,D0
02:000384C2 6702            	   602:     beq.s  __far_z_04_0003
02:000384C4 603C            	   603:     jmp  ResetPushTimer
                            	   604: __far_z_04_0003:
                            	   605:     ; Link is truly pushing the block.
                            	   606:     ;
                            	   607:     ; Increase the push timer.
                            	   608:     ;
02:000384C6 41EC0412        	   609:     lea     ($0412,A4),A0
02:000384CA 52302000        	   610:     addq.b  #1,(A0,D2.W)
                            	   611:     ; If the push timer still < $10, return.
                            	   612:     ;
02:000384CE 7600            	   613:     moveq   #0,D3
02:000384D0 41EC0412        	   614:     lea     ($0412,A4),A0
02:000384D4 16302000        	   615:     move.b  (A0,D2.W),D3
02:000384D8 0C030010        	   616:     cmpi.b  #$10,D3
02:000384DC 6402            	   617:     bcc.s  __far_z_04_0004
02:000384DE 6028            	   618:     jmp  L10262_Exit
