02:0003BC9C D101            	  8318:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003BC9E 19803072        	  8319:     move.b  D0,($72,A4,D3.W)
02:0003BCA2 41EC0084        	  8320:     lea     ($0084,A4),A0
