02:0003BAEC 6702            	  8041:     beq.s  __far_z_04_0088
02:0003BAEE 6032            	  8042:     jmp  Ganon_DrawBodyFrame0
                            	  8043: __far_z_04_0088:
                            	  8044:     even
                            	  8045: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8046:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8047:     ; In this case, I think it means Ganon is shouting.
                            	  8048:     ;
02:0003BAF0 0C000001        	  8049:     cmpi.b  #$01,D0
02:0003BAF4 6606            	  8050:     bne  _anon_z04_160
02:0003BAF6 7002            	  8051:     moveq   #2,D0
02:0003BAF8 19400601        	  8052:     move.b  D0,($0601,A4)
                            	  8053: _anon_z04_160:
02:0003BAFC 0A3C0001        	  8054:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BB00 4E75            	  8055:     rts
                            	  8056: 
                            	  8057: ; Description:
                            	  8058: ; Lift up the Triforce of Courage while the room is light.
                            	  8059: ;
                            	  8060: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8061: ;
                            	  8062:     even
                            	  8063: Ganon_ScenePhase1:
02:0003BB02 701B            	  8064:     moveq   #27,D0
02:0003BB04 19400505        	  8065:     move.b  D0,($0505,A4)
                            	  8066:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8067:     ;
02:0003BB08 102C0028        	  8068:     move.b  ($0028,A4),D0
02:0003BB0C 6702            	  8069:     beq.s  __far_z_04_0089
02:0003BB0E 6012            	  8070:     jmp  Ganon_DrawBodyFrame0
                            	  8071: __far_z_04_0089:
                            	  8072:     ; Once the timer expires:
                            	  8073:     ; 1. unhalt Link
                            	  8074:     ; 2. clear the item to lift
                            	  8075:     ; 3. play level 9 song
                            	  8076:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8077:     ;
02:0003BB10 194000AC        	  8078:     move.b  D0,($00AC,A4)
02:0003BB14 19400505        	  8079:     move.b  D0,($0505,A4)
02:0003BB18 7020            	  8080:     moveq   #32,D0
02:0003BB1A 19400600        	  8081:     move.b  D0,($0600,A4)
02:0003BB1E 522C0445        	  8082:     addq.b  #1,($0445,A4)
                            	  8083:     even
                            	  8084: Ganon_DrawBodyFrame0:
                            	  8085:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8086:     ; with animation frame 0.
                            	  8087:     ;
02:0003BB22 7000            	  8088:     moveq   #0,D0
02:0003BB24 41EC046B        	  8089:     lea     ($046B,A4),A0
02:0003BB28 11802000        	  8090:     move.b  D0,(A0,D2.W)
02:0003BB2C 600002EC        	  8091:     jmp     Ganon_DrawBody
                            	  8092: 
                            	  8093: ; Description:
                            	  8094: ; Fighting Ganon.
                            	  8095: ;
                            	  8096: ; If Ganon is dying, go handle it.
                            	  8097: ;
                            	  8098:     even
                            	  8099: Ganon_ScenePhase2:
02:0003BB30 41EC042C        	  8100:     lea     ($042C,A4),A0
02:0003BB34 10302000        	  8101:     move.b  (A0,D2.W),D0
02:0003BB38 6704            	  8102:     beq.s  __far_z_04_0090
02:0003BB3A 600000A4        	  8103:     jmp  Ganon_Dying
                            	  8104: __far_z_04_0090:
02:0003BB3E 61000356        	  8105:     jsr     Ganon_CheckCollisions
02:0003BB42 6100C6CA        	  8106:     jsr     PlayBossHitCryIfNeeded
                            	  8107:     ; Go handle the brown state specially.
                            	  8108:     ;
02:0003BB46 41EC00AC        	  8109:     lea     ($00AC,A4),A0
02:0003BB4A 10302000        	  8110:     move.b  (A0,D2.W),D0
02:0003BB4E 6702            	  8111:     beq.s  __far_z_04_0091
02:0003BB50 6058            	  8112:     jmp  Ganon_UpdateBrownState
                            	  8113: __far_z_04_0091:
                            	  8114:     ; State = 0: Blue
                            	  8115:     ;
                            	  8116:     ; If timer = 0, then go move around and shoot.
                            	  8117:     ;
02:0003BB52 10342028        	  8118:     move.b  ($28,A4,D2.W),D0
02:0003BB56 6602            	  8119:     bne.s  __far_z_04_0092
02:0003BB58 600E            	  8120:     jmp  Ganon_MoveAndShoot
                            	  8121: __far_z_04_0092:
                            	  8122:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8123:     ; Collisions were checked already.
                            	  8124:     ;
                            	  8125:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8126:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8127:     ;
02:0003BB5A 0C000001        	  8128:     cmpi.b  #$01,D0
02:0003BB5E 6702            	  8129:     beq.s  __far_z_04_0093
02:0003BB60 6078            	  8130:     jmp  L_Ganon_DrawBody
                            	  8131: __far_z_04_0093:
                            	  8132: ; Description:
