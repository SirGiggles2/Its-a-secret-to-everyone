02:0002B2E4 7C00            	  3106:     moveq   #0,D6
02:0002B2E6 3C00            	  3107:     move.w  D0,D6
02:0002B2E8 028600003FFF    	  3108:     andi.l  #$00003FFF,D6
02:0002B2EE 4846            	  3109:     swap    D6
02:0002B2F0 008640000003    	  3110:     ori.l   #$40000003,D6          ; CD bits + A[15:14]=3 for $C000+
02:0002B2F6 23C600C00004    	  3111:     move.l  D6,(VDP_CTRL).l
02:0002B2FC 6022            	  3112:     bra.s   .ttf_nt_emit_tile
                            	  3113: 
