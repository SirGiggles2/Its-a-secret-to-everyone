02:0003BCC2 41EC009A        	  8330:     lea     ($009A,A4),A0
02:0003BCC6 11803000        	  8331:     move.b  D0,(A0,D3.W)
02:0003BCCA 5303            	  8332:     subq.b  #1,D3
02:0003BCCC 6AC2            	  8333:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
