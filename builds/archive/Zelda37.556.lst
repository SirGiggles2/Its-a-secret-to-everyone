02:00034E3C 19400083        	  4365:     move.b  D0,($0083,A4)
02:00034E40 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E44 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034E48 123C0010        	  4368:     move.b  #$10,D1
02:00034E4C 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E50 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E52 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
