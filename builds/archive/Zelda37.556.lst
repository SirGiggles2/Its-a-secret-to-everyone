                            	  5831:     ; Reset horizontal flipping in [0F].
                            	  5832:     ;
02:00048ABA 7000            	  5833:     moveq   #0,D0
02:00048ABC 1940000F        	  5834:     move.b  D0,($000F,A4)
                            	  5835:     ; If state = 5, return without drawing.
                            	  5836:     ;
02:00048AC0 41EC00AC        	  5837:     lea     ($00AC,A4),A0
02:00048AC4 10302000        	  5838:     move.b  (A0,D2.W),D0
02:00048AC8 0200000F        	  5839:     andi.b #$0F,D0
02:00048ACC 7600            	  5840:     moveq   #0,D3
02:00048ACE 1600            	  5841:     move.b  D0,D3
02:00048AD0 103C00FC        	  5842:     move.b  #$FC,D0
02:00048AD4 0C030005        	  5843:     cmpi.b  #$05,D3
02:00048AD8 67DE            	  5844:     beq  _L_z07_UpdateSwordOrRod_Exit
