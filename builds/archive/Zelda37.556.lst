                            	  1239:     ;
02:00038900 101D            	  1240:     move.b  (A5)+,D0  ; PLA
02:00038902 41EC03BC        	  1241:     lea     ($03BC,A4),A0
02:00038906 11802000        	  1242:     move.b  D0,(A0,D2.W)
                            	  1243:     even
