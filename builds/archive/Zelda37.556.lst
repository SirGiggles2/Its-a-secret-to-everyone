                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BAA0 701B            	  7996:     moveq   #27,D0
02:0003BAA2 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BAA6 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0003BAAA 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0003BAAC 1002            	  8005:     move.b  D2,D0
02:0003BAAE 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0003BAB0 610007F0        	  8007:     jsr     UpdateCandle
