                            	  1205:     ;==========================================================================
                            	  1206:     ; .inc_ppuaddr — advance PPU_VADDR by 1 or 32.
                            	  1207:     ; PPUCTRL bit 2: 0 → +1 horizontal, 1 → +32 vertical.
                            	  1208:     ; Modifies D1.w.
                            	  1209:     ;==========================================================================
                            	  1210: .inc_ppuaddr:
02:0000E726 323900FF0802    	  1211:     move.w  (PPU_VADDR).l,D1
