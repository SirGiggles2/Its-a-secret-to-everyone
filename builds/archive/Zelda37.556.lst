02:0003BDFD 01
02:0003BDFE 02              	  8487:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003BDFF 02
02:0003BE00 03
02:0003BE01 03
02:0003BE02 04
02:0003BE03 00
02:0003BE04 05
