                            	   968: ;==============================================================================
                            	   969: ; tick_sq0 — Sq0 channel update
                            	   970: ;==============================================================================
                            	   971: tick_sq0:
02:000009FE 4A3900FFE014    	   972:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:00000A04 6754            	   973:     beq     tick_trg
02:00000A06 533900FFE015    	   974:     subq.b  #1,(m_sq0_cnt).l
02:00000A0C 664C            	   975:     bne     tick_trg
02:00000A0E 207900FFE008    	   976:     move.l  (m_script_ptr).l,A0
02:00000A14 7200            	   977:     moveq   #0,D1
02:00000A16 123900FFE014    	   978:     move.b  (m_sq0_off).l,D1
02:00000A1C 523900FFE014    	   979:     addq.b  #1,(m_sq0_off).l
02:00000A22 10301000        	   980:     move.b  (A0,D1.w),D0
02:00000A26 4A00            	   981:     tst.b   D0
02:00000A28 6A22            	   982:     bpl.s   .play
02:00000A2A 61000164        	   983:     bsr     get_song_note_length
02:00000A2E 13C000FFE016    	   984:     move.b  D0,(m_sq0_len).l
02:00000A34 207900FFE008    	   985:     move.l  (m_script_ptr).l,A0
02:00000A3A 7200            	   986:     moveq   #0,D1
02:00000A3C 123900FFE014    	   987:     move.b  (m_sq0_off).l,D1
02:00000A42 523900FFE014    	   988:     addq.b  #1,(m_sq0_off).l
02:00000A48 10301000        	   989:     move.b  (A0,D1.w),D0
                            	   990: .play:
02:00000A4C 610001BA        	   991:     bsr     emit_note_sq0
02:00000A50 13F900FFE01600FF	   992:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A58 E015
                            	   993:     bra     tick_trg
                            	   994: 
                            	   995: ;==============================================================================
                            	   996: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   997: ;==============================================================================
                            	   998: tick_trg:
02:00000A5A 4A3900FFE01C    	   999:     tst.b   (m_trg_off).l
02:00000A60 6700009E        	  1000:     beq     tick_noise
02:00000A64 533900FFE01D    	  1001:     subq.b  #1,(m_trg_cnt).l
02:00000A6A 66000094        	  1002:     bne     tick_noise
                            	  1003: .prep_note_or_passage:
02:00000A6E 207900FFE008    	  1004:     move.l  (m_script_ptr).l,A0
02:00000A74 7200            	  1005:     moveq   #0,D1
02:00000A76 123900FFE01C    	  1006:     move.b  (m_trg_off).l,D1
02:00000A7C 523900FFE01C    	  1007:     addq.b  #1,(m_trg_off).l
02:00000A82 10301000        	  1008:     move.b  (A0,D1.w),D0
02:00000A86 676A            	  1009:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000A88 4A00            	  1010:     tst.b   D0
02:00000A8A 6A56            	  1011:     bpl.s   .play_note_trg                ; direct note
02:00000A8C 0C0000F0        	  1012:     cmpi.b  #$F0,D0
02:00000A90 6718            	  1013:     beq.s   .end_of_passage
02:00000A92 652A            	  1014:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1015:     ; $F1-$FF → start passage
02:00000A94 040000F0        	  1016:     subi.b  #$F0,D0
02:00000A98 13C000FFE021    	  1017:     move.b  D0,(m_trg_rep_n).l
02:00000A9E 13F900FFE01C00FF	  1018:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000AA6 E022
02:00000AA8 60C4            	  1019:     bra.s   .prep_note_or_passage
                            	  1020: .end_of_passage:
02:00000AAA 533900FFE021    	  1021:     subq.b  #1,(m_trg_rep_n).l
02:00000AB0 670A            	  1022:     beq.s   .pass_done
02:00000AB2 13F900FFE02200FF	  1023:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000ABA E01C
                            	  1024: .pass_done:
02:00000ABC 60B0            	  1025:     bra.s   .prep_note_or_passage
                            	  1026: .prep_note_trg:
02:00000ABE 610000D0        	  1027:     bsr     get_song_note_length
02:00000AC2 13C000FFE01E    	  1028:     move.b  D0,(m_trg_len).l
02:00000AC8 207900FFE008    	  1029:     move.l  (m_script_ptr).l,A0
02:00000ACE 7200            	  1030:     moveq   #0,D1
02:00000AD0 123900FFE01C    	  1031:     move.b  (m_trg_off).l,D1
02:00000AD6 523900FFE01C    	  1032:     addq.b  #1,(m_trg_off).l
02:00000ADC 10301000        	  1033:     move.b  (A0,D1.w),D0
02:00000AE0 6710            	  1034:     beq.s   .silence_trg
                            	  1035: .play_note_trg:
02:00000AE2 61000182        	  1036:     bsr     emit_note_trg
02:00000AE6 13F900FFE01E00FF	  1037:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AEE E01D
02:00000AF0 600E            	  1038:     bra     tick_noise
                            	  1039: .silence_trg:
02:00000AF2 610001E6        	  1040:     bsr     key_off_trg
02:00000AF6 13F900FFE01E00FF	  1041:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AFE E01D
                            	  1042:     bra     tick_noise
                            	  1043: 
                            	  1044: ;==============================================================================
                            	  1045: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1046: ;==============================================================================
                            	  1047: tick_noise:
02:00000B00 103900FFE000    	  1048:     move.b  (m_song).l,D0
02:00000B06 02000091        	  1049:     andi.b  #$91,D0
02:00000B0A 67000082        	  1050:     beq     .tn_done
                            	  1051:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1052:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1053:     ; a hit fires below.
02:00000B0E 61000250        	  1054:     bsr     noise_decay_tick
02:00000B12 533900FFE025    	  1055:     subq.b  #1,(m_noise_cnt).l
02:00000B18 6674            	  1056:     bne     .tn_done
                            	  1057: .read:
02:00000B1A 207900FFE008    	  1058:     move.l  (m_script_ptr).l,A0
02:00000B20 7200            	  1059:     moveq   #0,D1
02:00000B22 123900FFE024    	  1060:     move.b  (m_noise_off).l,D1
02:00000B28 523900FFE024    	  1061:     addq.b  #1,(m_noise_off).l
02:00000B2E 10301000        	  1062:     move.b  (A0,D1.w),D0
02:00000B32 660C            	  1063:     bne.s   .got
02:00000B34 13F900FFE00600FF	  1064:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B3C E024
02:00000B3E 60DA            	  1065:     bra.s   .read
                            	  1066: .got:
02:00000B40 1800            	  1067:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1068:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1069:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1070:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1071:     ; (0,7,6). For our port we replicate exactly.
02:00000B42 7400            	  1072:     moveq   #0,D2
02:00000B44 1404            	  1073:     move.b  D4,D2
                            	  1074:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B46 7000            	  1075:     moveq   #0,D0
02:00000B48 08020000        	  1076:     btst    #0,D2
02:00000B4C 6704            	  1077:     beq.s   .b0
02:00000B4E 08C00002        	  1078:     bset    #2,D0
                            	  1079: .b0:
02:00000B52 08020007        	  1080:     btst    #7,D2
02:00000B56 6704            	  1081:     beq.s   .b7
02:00000B58 08C00001        	  1082:     bset    #1,D0
                            	  1083: .b7:
02:00000B5C 08020006        	  1084:     btst    #6,D2
02:00000B60 6704            	  1085:     beq.s   .b6
02:00000B62 08C00000        	  1086:     bset    #0,D0
                            	  1087: .b6:
02:00000B66 7200            	  1088:     moveq   #0,D1
02:00000B68 123900FFE003    	  1089:     move.b  (m_len_base).l,D1
02:00000B6E D240            	  1090:     add.w   D0,D1
02:00000B70 43F900000E12    	  1091:     lea     (NoteLengthTables).l,A1
02:00000B76 13F1100000FFE025	  1092:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1093:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000B7E 1004            	  1094:     move.b  D4,D0
02:00000B80 0200003E        	  1095:     andi.b  #$3E,D0
02:00000B84 E808            	  1096:     lsr.b   #4,D0
02:00000B86 7200            	  1097:     moveq   #0,D1
02:00000B88 1200            	  1098:     move.b  D0,D1
                            	  1099:     ; Map to PSG noise: set volume + period
02:00000B8A 6100015A        	  1100:     bsr     set_psg_noise
                            	  1101: .tn_done:
02:00000B8E 4E75            	  1102:     rts
                            	  1103: 
                            	  1104: ;==============================================================================
                            	  1105: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1106: ; Input: D0 = control byte → Output: D0 = length
                            	  1107: ;==============================================================================
                            	  1108: get_song_note_length:
02:00000B90 02400007        	  1109:     andi.w  #$07,D0
02:00000B94 7200            	  1110:     moveq   #0,D1
02:00000B96 123900FFE003    	  1111:     move.b  (m_len_base).l,D1
02:00000B9C D240            	  1112:     add.w   D0,D1
02:00000B9E 43F900000E12    	  1113:     lea     (NoteLengthTables).l,A1
02:00000BA4 10311000        	  1114:     move.b  (A1,D1.w),D0
02:00000BA8 4E75            	  1115:     rts
                            	  1116: 
                            	  1117: ;==============================================================================
                            	  1118: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1119: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1120: ;==============================================================================
                            	  1121: emit_note_sq1:
02:00000BAA 024000FF        	  1122:     andi.w  #$FF,D0
02:00000BAE 43F900000DA0    	  1123:     lea     (MusicNotePeriodTable).l,A1
02:00000BB4 7400            	  1124:     moveq   #0,D2
02:00000BB6 14310001        	  1125:     move.b  1(A1,D0.w),D2                 ; lo
02:00000BBA 67000106        	  1126:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000BBE 7600            	  1127:     moveq   #0,D3
02:00000BC0 16310000        	  1128:     move.b  0(A1,D0.w),D3                 ; hi
02:00000BC4 E14B            	  1129:     lsl.w   #8,D3
02:00000BC6 8642            	  1130:     or.w    D2,D3                          ; D3.w = period
02:00000BC8 024307FF        	  1131:     andi.w  #$07FF,D3
02:00000BCC 13C200FFE010    	  1132:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000BD2 3403            	  1133:     move.w  D3,D2
02:00000BD4 263C00021986    	  1134:     move.l  #NES_YM_K5_PULSE,D3
02:00000BDA 6100F842        	  1135:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1136:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000BDE 103C0028        	  1137:     move.b  #$28,D0
02:00000BE2 7200            	  1138:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000BE4 6100F7F0        	  1139:     bsr     ym_write1
02:00000BE8 103C00A4        	  1140:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000BEC 1202            	  1141:     move.b  D2,D1
02:00000BEE 6100F7E6        	  1142:     bsr     ym_write1
02:00000BF2 103C00A0        	  1143:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000BF6 1203            	  1144:     move.b  D3,D1
02:00000BF8 6100F7DC        	  1145:     bsr     ym_write1
                            	  1146:     ; Key on ch 0, all ops
02:00000BFC 103C0028        	  1147:     move.b  #$28,D0
02:00000C00 123C00F0        	  1148:     move.b  #$F0,D1
02:00000C04 6000F7D0        	  1149:     bra     ym_write1
                            	  1150: 
                            	  1151: ;==============================================================================
                            	  1152: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1153: ;==============================================================================
                            	  1154: emit_note_sq0:
02:00000C08 024000FF        	  1155:     andi.w  #$FF,D0
02:00000C0C 43F900000DA0    	  1156:     lea     (MusicNotePeriodTable).l,A1
02:00000C12 7400            	  1157:     moveq   #0,D2
02:00000C14 14310001        	  1158:     move.b  1(A1,D0.w),D2
02:00000C18 670000B4        	  1159:     beq     key_off_sq0
02:00000C1C 7600            	  1160:     moveq   #0,D3
02:00000C1E 16310000        	  1161:     move.b  0(A1,D0.w),D3
02:00000C22 E14B            	  1162:     lsl.w   #8,D3
02:00000C24 8642            	  1163:     or.w    D2,D3
02:00000C26 024307FF        	  1164:     andi.w  #$07FF,D3
02:00000C2A 13C200FFE018    	  1165:     move.b  D2,(m_sq0_per).l
02:00000C30 3403            	  1166:     move.w  D3,D2
02:00000C32 263C00021986    	  1167:     move.l  #NES_YM_K5_PULSE,D3
02:00000C38 6100F7E4        	  1168:     bsr     nes_to_ym_freq
                            	  1169:     ; Key off first so the envelope attack phase retriggers
02:00000C3C 103C0028        	  1170:     move.b  #$28,D0
02:00000C40 7201            	  1171:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C42 6100F792        	  1172:     bsr     ym_write1
02:00000C46 103C00A5        	  1173:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000C4A 1202            	  1174:     move.b  D2,D1
02:00000C4C 6100F788        	  1175:     bsr     ym_write1
02:00000C50 103C00A1        	  1176:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C54 1203            	  1177:     move.b  D3,D1
02:00000C56 6100F77E        	  1178:     bsr     ym_write1
02:00000C5A 103C0028        	  1179:     move.b  #$28,D0
02:00000C5E 123C00F1        	  1180:     move.b  #$F1,D1
02:00000C62 6000F772        	  1181:     bra     ym_write1
                            	  1182: 
                            	  1183: ;==============================================================================
                            	  1184: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1185: ;==============================================================================
                            	  1186: emit_note_trg:
02:00000C66 024000FF        	  1187:     andi.w  #$FF,D0
02:00000C6A 43F900000DA0    	  1188:     lea     (MusicNotePeriodTable).l,A1
02:00000C70 7400            	  1189:     moveq   #0,D2
02:00000C72 14310001        	  1190:     move.b  1(A1,D0.w),D2
02:00000C76 6762            	  1191:     beq     key_off_trg
02:00000C78 7600            	  1192:     moveq   #0,D3
02:00000C7A 16310000        	  1193:     move.b  0(A1,D0.w),D3
02:00000C7E E14B            	  1194:     lsl.w   #8,D3
02:00000C80 8642            	  1195:     or.w    D2,D3
02:00000C82 024307FF        	  1196:     andi.w  #$07FF,D3
02:00000C86 13C200FFE020    	  1197:     move.b  D2,(m_trg_per).l
02:00000C8C 3403            	  1198:     move.w  D3,D2
02:00000C8E 263C00010CC3    	  1199:     move.l  #NES_YM_K5_TRI,D3
02:00000C94 6100F788        	  1200:     bsr     nes_to_ym_freq
                            	  1201:     ; Key off first so the bass envelope retriggers per note
02:00000C98 103C0028        	  1202:     move.b  #$28,D0
02:00000C9C 7202            	  1203:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000C9E 6100F736        	  1204:     bsr     ym_write1
02:00000CA2 103C00A6        	  1205:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000CA6 1202            	  1206:     move.b  D2,D1
02:00000CA8 6100F72C        	  1207:     bsr     ym_write1
02:00000CAC 103C00A2        	  1208:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000CB0 1203            	  1209:     move.b  D3,D1
02:00000CB2 6100F722        	  1210:     bsr     ym_write1
02:00000CB6 103C0028        	  1211:     move.b  #$28,D0
02:00000CBA 123C00F2        	  1212:     move.b  #$F2,D1
02:00000CBE 6000F716        	  1213:     bra     ym_write1
                            	  1214: 
                            	  1215: ;==============================================================================
                            	  1216: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1217: ;==============================================================================
                            	  1218: key_off_sq1:
02:00000CC2 103C0028        	  1219:     move.b  #$28,D0
02:00000CC6 123C0000        	  1220:     move.b  #$00,D1
02:00000CCA 6000F70A        	  1221:     bra     ym_write1
                            	  1222: key_off_sq0:
02:00000CCE 103C0028        	  1223:     move.b  #$28,D0
02:00000CD2 123C0001        	  1224:     move.b  #$01,D1
02:00000CD6 6000F6FE        	  1225:     bra     ym_write1
                            	  1226: key_off_trg:
02:00000CDA 103C0028        	  1227:     move.b  #$28,D0
02:00000CDE 123C0002        	  1228:     move.b  #$02,D1
02:00000CE2 6000F6F2        	  1229:     bra     ym_write1
                            	  1230: 
                            	  1231: ;==============================================================================
                            	  1232: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1233: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1234: ;
                            	  1235: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1236: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1237: ;     PsgDrumTable.
                            	  1238: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1239: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1240: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1241: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1242: ;     noise_decay_tick.
                            	  1243: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1244: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1245: ;==============================================================================
                            	  1246: set_psg_noise:
                            	  1247:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1248:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1249:     ; music drums resume on the next beat.
02:00000CE6 4A3900FF0606    	  1250:     tst.b   ($00FF0606).l
02:00000CEC 661A            	  1251:     bne.s   .sfx_owns_psg
02:00000CEE 4A01            	  1252:     tst.b   D1
02:00000CF0 6618            	  1253:     bne.s   .not_rest
                            	  1254:     ; Rest: silence the PSG noise channel immediately.
02:00000CF2 423900FFE026    	  1255:     clr.b   (m_noise_level).l
02:00000CF8 423900FFE027    	  1256:     clr.b   (m_noise_decay).l
02:00000CFE 13FC00FF00C00011	  1257:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000D06 4E75            	  1258:     rts
                            	  1259: .sfx_owns_psg:
02:00000D08 4E75            	  1260:     rts
                            	  1261: .not_rest:
02:00000D0A 7000            	  1262:     moveq   #0,D0
02:00000D0C 1001            	  1263:     move.b  D1,D0
02:00000D0E E548            	  1264:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000D10 43F900000E46    	  1265:     lea     (PsgDrumTable).l,A1
02:00000D16 D3C0            	  1266:     adda.l  D0,A1
02:00000D18 1019            	  1267:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1268:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000D1A B03900FFE028    	  1269:     cmp.b   (m_last_psg_nc).l,D0
02:00000D20 670C            	  1270:     beq.s   .nc_same
02:00000D22 13C000FFE028    	  1271:     move.b  D0,(m_last_psg_nc).l
02:00000D28 13C000C00011    	  1272:     move.b  D0,(PSG_PORT).l
                            	  1273: .nc_same:
02:00000D2E 1019            	  1274:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D30 13C000FFE026    	  1275:     move.b  D0,(m_noise_level).l
02:00000D36 1019            	  1276:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D38 13C000FFE027    	  1277:     move.b  D0,(m_noise_decay).l
                            	  1278:     bra     write_psg_noise_vol
                            	  1279: 
                            	  1280: ;==============================================================================
                            	  1281: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1282: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1283: ; Preserves D1.
                            	  1284: ;==============================================================================
                            	  1285: write_psg_noise_vol:
02:00000D3E 4A3900FF0606    	  1286:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D44 6618            	  1287:     bne.s   .wpnv_skip
02:00000D46 7000            	  1288:     moveq   #0,D0
02:00000D48 103900FFE026    	  1289:     move.b  (m_noise_level).l,D0
02:00000D4E E808            	  1290:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D50 0A00000F        	  1291:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D54 000000F0        	  1292:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D58 13C000C00011    	  1293:     move.b  D0,(PSG_PORT).l
                            	  1294: .wpnv_skip:
02:00000D5E 4E75            	  1295:     rts
                            	  1296: 
                            	  1297: ;==============================================================================
                            	  1298: ; noise_decay_tick — linear envelope decay step.
                            	  1299: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1300: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1301: ; Preserves D1.
                            	  1302: ;==============================================================================
                            	  1303: noise_decay_tick:
02:00000D60 4A3900FF0606    	  1304:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000D66 661A            	  1305:     bne.s   .nd_done
02:00000D68 103900FFE026    	  1306:     move.b  (m_noise_level).l,D0
02:00000D6E 6712            	  1307:     beq.s   .nd_done                        ; already silent
02:00000D70 903900FFE027    	  1308:     sub.b   (m_noise_decay).l,D0
02:00000D76 6402            	  1309:     bcc.s   .nd_store                       ; no underflow → new level
02:00000D78 7000            	  1310:     moveq   #0,D0                           ; underflow → silent
                            	  1311: .nd_store:
02:00000D7A 13C000FFE026    	  1312:     move.b  D0,(m_noise_level).l
02:00000D80 60BC            	  1313:     bra     write_psg_noise_vol
                            	  1314: .nd_done:
02:00000D82 4E75            	  1315:     rts
                            	  1316: 
                            	  1317: ;==============================================================================
                            	  1318: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1319: ;==============================================================================
                            	  1320: music_silence:
02:00000D84 423900FFE000    	  1321:     clr.b   (m_song).l
02:00000D8A 6100FF36        	  1322:     bsr     key_off_sq1
02:00000D8E 6100FF3E        	  1323:     bsr     key_off_sq0
02:00000D92 6100FF46        	  1324:     bsr     key_off_trg
02:00000D96 13FC00FF00C00011	  1325:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000D9E 4E75            	  1326:     rts
                            	  1327: 
                            	  1328: ;==============================================================================
                            	  1329: ; Music data tables
                            	  1330: ;==============================================================================
                            	  1331:     even
                            	  1332: 
                            	  1333: ; MusicNotePeriodTable — 114 bytes, big-endian 16-bit periods indexed by
                            	  1334: ; even note IDs (byte offsets).  Pulled from reference Z_00.asm.
                            	  1335: ; (Local copy to avoid label collision with the transpiled MusicNotePeriodTable
                            	  1336: ; in zelda_translated/z_00.asm, whose in-memory layout may have `even`
                            	  1337: ; padding that breaks offset math.)
                            	  1338: MusicNotePeriodTable:
02:00000DA0 00              	  1339:     dc.b    $00,$23,$00,$6A,$03,$27,$00,$97
02:00000DA1 23
02:00000DA2 00
02:00000DA3 6A
02:00000DA4 03
02:00000DA5 27
