02:00049656 41EC04BF        	  7302:     lea     ($04BF,A4),A0
02:0004965A 11802000        	  7303:     move.b  D0,(A0,D2.W)
02:0004965E 1003            	  7304:     move.b  D3,D0
02:00049660 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Hit points are packed two values to a byte.
                            	  7307:     ; Divide the object type in half in order to index
