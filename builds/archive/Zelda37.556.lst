                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A72A 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A72E 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A732 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A736 123C0038        	  5434:     move.b  #$38,D1
02:0003A73A D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A73C 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A740 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A744 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A748 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A74C 123C0000        	  5442:     move.b  #$00,D1
02:0003A750 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A752 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A756 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A75A 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A75E 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A762 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A766 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A768 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A76C 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A770 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A774 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A778 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A77C 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A780 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A784 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0003A788 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0003A78C B001            	  5465:     cmp.b   D1,D0
02:0003A78E 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
                            	  5468:     ;
02:0003A792 7000            	  5469:     moveq   #0,D0
02:0003A794 41EC00AC        	  5470:     lea     ($00AC,A4),A0
02:0003A798 11802000        	  5471:     move.b  D0,(A0,D2.W)
                            	  5472:     ; Reset 16-bit vertical speed.
                            	  5473:     ;
02:0003A79C 41EC0444        	  5474:     lea     ($0444,A4),A0
02:0003A7A0 11802000        	  5475:     move.b  D0,(A0,D2.W)
02:0003A7A4 41EC0412        	  5476:     lea     ($0412,A4),A0
02:0003A7A8 11802000        	  5477:     move.b  D0,(A0,D2.W)
                            	  5478:     ; Choose a random direction to face in.
                            	  5479:     ;
02:0003A7AC 10342018        	  5480:     move.b  ($18,A4,D2.W),D0
02:0003A7B0 02000003        	  5481:     andi.b #$03,D0
02:0003A7B4 7600            	  5482:     moveq   #0,D3
02:0003A7B6 1600            	  5483:     move.b  D0,D3
02:0003A7B8 41F90003A5C8    	  5484:     lea     (PolsVoiceDirections).l,A0
02:0003A7BE 10303000        	  5485:     move.b  (A0,D3.W),D0
02:0003A7C2 41EC0098        	  5486:     lea     ($0098,A4),A0
02:0003A7C6 11802000        	  5487:     move.b  D0,(A0,D2.W)
                            	  5488:     ; Randomly set distance-to-move to $30 or $70.
                            	  5489:     ;
02:0003A7CA 10342018        	  5490:     move.b  ($18,A4,D2.W),D0
02:0003A7CE 02000040        	  5491:     andi.b #$40,D0
02:0003A7D2 123C0030        	  5492:     move.b  #$30,D1
02:0003A7D6 D101            	  5493:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003A7D8 41EC0394        	  5494:     lea     ($0394,A4),A0
02:0003A7DC 11802000        	  5495:     move.b  D0,(A0,D2.W)
                            	  5496:     ; Align the monster with a square horizontally.
                            	  5497:     ;
                            	  5498:     ; If in the left half of a square, align with that square.
                            	  5499:     ; If in the right half, align with the next square.
                            	  5500:     ;
02:0003A7E0 10342070        	  5501:     move.b  ($70,A4,D2.W),D0
02:0003A7E4 023C00EE        	  5502:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7E8 123C0008        	  5503:     move.b  #$08,D1
02:0003A7EC D101            	  5504:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A7EE 020000F0        	  5505:     andi.b #$F0,D0
02:0003A7F2 19802070        	  5506:     move.b  D0,($70,A4,D2.W)
                            	  5507:     ; Align the monster with a square vertically.
                            	  5508:     ;
                            	  5509:     ; If in the top half of a square, align with that square.
                            	  5510:     ; If in the bottom half, align with the next square.
                            	  5511:     ;
02:0003A7F6 41EC0084        	  5512:     lea     ($0084,A4),A0
02:0003A7FA 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0003A7FE 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A802 123C0008        	  5515:     move.b  #$08,D1
02:0003A806 D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A808 020000F0        	  5517:     andi.b #$F0,D0
                            	  5518:     ; Make sure the lower nibble of Y is $D as usual.
                            	  5519:     ;
02:0003A80C 003C0011        	  5520:     ori     #$11,CCR  ; SEC: set C+X
02:0003A810 123C0003        	  5521:     move.b  #$03,D1
02:0003A814 0A3C0010        	  5522:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A818 9101            	  5523:     subx.b  D1,D0   ; SBC #$03
02:0003A81A 0A3C0010        	  5524:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A81E 41EC0084        	  5525:     lea     ($0084,A4),A0
02:0003A822 11802000        	  5526:     move.b  D0,(A0,D2.W)
