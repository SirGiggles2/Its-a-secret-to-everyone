                            	  1609: ;==============================================================================
                            	  1610: ; NES → Genesis palette lookup table
                            	  1611: ;
                            	  1612: ; 64 × 16-bit words: index = NES color byte (0–63).
                            	  1613: ; Genesis color format: $0BGR (bits [10:8]=Blue, [6:4]=Green, [2:0]=Red, 0–7 each).
                            	  1614: ; Source: title-calibrated NES palette approximations tuned against BizHawk
                            	  1615: ; frame-200 NES reference captures, quantized to Genesis 3-bit channels.
                            	  1616: ;==============================================================================
                            	  1617:     even
                            	  1618: nes_palette_to_genesis:
                            	  1619:     ;       NES $00–$0F  (grays, blues, purples, reds, greens)
                            	  1620:     ;       Genesis CRAM = (B<<9)|(G<<5)|(R<<1)  — NOT raw $0BGR nibbles
02:0000E9AA 0666            	  1621:     dc.w    $0666   ; $00  rgb(84,84,84)     dark gray (universal BG)
02:0000E9AC 0E00            	  1622:     dc.w    $0E00   ; $01  rgb(0,0,252)     dark blue
02:0000E9AE 0A00            	  1623:     dc.w    $0A00   ; $02  rgb(0,0,188)     dark blue
02:0000E9B0 0A24            	  1624:     dc.w    $0A24   ; $03  rgb(68,40,188)   blue-violet
02:0000E9B2 0808            	  1625:     dc.w    $0808   ; $04  rgb(148,0,132)   purple
02:0000E9B4 020A            	  1626:     dc.w    $020A   ; $05  rgb(168,0,32)    dark red-magenta
02:0000E9B6 000A            	  1627:     dc.w    $000A   ; $06  rgb(168,16,0)    dark red
02:0000E9B8 0028            	  1628:     dc.w    $0028   ; $07  rgb(136,20,0)    dark red-brown
02:0000E9BA 0044            	  1629:     dc.w    $0044   ; $08  dark olive-brown
02:0000E9BC 0060            	  1630:     dc.w    $0060   ; $09  rgb(0,120,0)     dark green
02:0000E9BE 0060            	  1631:     dc.w    $0060   ; $0A  rgb(0,104,0)     dark green
02:0000E9C0 0040            	  1632:     dc.w    $0040   ; $0B  rgb(0,88,0)      very dark green
02:0000E9C2 0440            	  1633:     dc.w    $0440   ; $0C  rgb(0,64,88)     dark teal
02:0000E9C4 0000            	  1634:     dc.w    $0000   ; $0D  black (unused/invalid)
02:0000E9C6 0000            	  1635:     dc.w    $0000   ; $0E  black (unused/invalid)
02:0000E9C8 0000            	  1636:     dc.w    $0000   ; $0F  black (unused/invalid)
                            	  1637: 
                            	  1638:     ;       NES $10–$1F  (light grays, bright blues/reds, mid greens, teals)
02:0000E9CA 0AAA            	  1639:     dc.w    $0AAA   ; $10  rgb(152,152,152)  light gray
02:0000E9CC 0E60            	  1640:     dc.w    $0E60   ; $11  rgb(0,120,248)   bright blue
02:0000E9CE 0E40            	  1641:     dc.w    $0E40   ; $12  rgb(0,88,248)    bright blue
02:0000E9D0 0E46            	  1642:     dc.w    $0E46   ; $13  rgb(104,68,252)  blue-violet
02:0000E9D2 0C0C            	  1643:     dc.w    $0C0C   ; $14  rgb(216,0,204)   bright magenta
02:0000E9D4 040C            	  1644:     dc.w    $040C   ; $15  rgb(228,0,88)    bright red
02:0000E9D6 004A            	  1645:     dc.w    $004A   ; $16  orange-red
02:0000E9D8 004A            	  1646:     dc.w    $004A   ; $17  orange
02:0000E9DA 006A            	  1647:     dc.w    $006A   ; $18  rgb(172,124,0)   yellow-orange
02:0000E9DC 00A0            	  1648:     dc.w    $00A0   ; $19  rgb(0,184,0)     green
02:0000E9DE 0080            	  1649:     dc.w    $0080   ; $1A  green
02:0000E9E0 04A0            	  1650:     dc.w    $04A0   ; $1B  rgb(0,168,68)    green-teal
02:0000E9E2 0880            	  1651:     dc.w    $0880   ; $1C  rgb(0,136,136)   teal
02:0000E9E4 0000            	  1652:     dc.w    $0000   ; $1D  black (unused/invalid)
02:0000E9E6 0000            	  1653:     dc.w    $0000   ; $1E  black (unused/invalid)
02:0000E9E8 0000            	  1654:     dc.w    $0000   ; $1F  black (unused/invalid)
                            	  1655: 
                            	  1656:     ;       NES $20–$2F  (near-white, light colors, pastels)
02:0000E9EA 0EEE            	  1657:     dc.w    $0EEE   ; $20  rgb(248,248,248) near-white
02:0000E9EC 0EA4            	  1658:     dc.w    $0EA4   ; $21  rgb(60,188,252)  light cyan-blue
02:0000E9EE 0E86            	  1659:     dc.w    $0E86   ; $22  light blue
02:0000E9F0 0E68            	  1660:     dc.w    $0E68   ; $23  rgb(152,120,248) light purple-blue
02:0000E9F2 0E6E            	  1661:     dc.w    $0E6E   ; $24  rgb(248,120,248) light magenta
02:0000E9F4 084E            	  1662:     dc.w    $084E   ; $25  rgb(248,88,152)  light pink-red
02:0000E9F6 046E            	  1663:     dc.w    $046E   ; $26  rgb(248,120,88)  light orange
02:0000E9F8 048E            	  1664:     dc.w    $048E   ; $27  rgb(252,160,68)  light yellow-orange
02:0000E9FA 00CC            	  1665:     dc.w    $00CC   ; $28  yellow
02:0000E9FC 02EA            	  1666:     dc.w    $02EA   ; $29  rgb(184,248,24)  yellow-green
02:0000E9FE 04C4            	  1667:     dc.w    $04C4   ; $2A  rgb(88,216,84)   light green
02:0000EA00 08E4            	  1668:     dc.w    $08E4   ; $2B  rgb(88,248,152)  light green-teal
02:0000EA02 0CC0            	  1669:     dc.w    $0CC0   ; $2C  rgb(0,232,216)   light teal
02:0000EA04 0666            	  1670:     dc.w    $0666   ; $2D  rgb(120,120,120) medium gray
02:0000EA06 0000            	  1671:     dc.w    $0000   ; $2E  black (unused/invalid)
02:0000EA08 0000            	  1672:     dc.w    $0000   ; $2F  black (unused/invalid)
                            	  1673: 
                            	  1674:     ;       NES $30–$3F  (whites, very light pastels)
02:0000EA0A 0EEE            	  1675:     dc.w    $0EEE   ; $30  rgb(252,252,252) white
02:0000EA0C 0ECA            	  1676:     dc.w    $0ECA   ; $31  rgb(164,228,252) very light blue
02:0000EA0E 0EAA            	  1677:     dc.w    $0EAA   ; $32  rgb(184,184,248) very light purple-blue
02:0000EA10 0EAC            	  1678:     dc.w    $0EAC   ; $33  rgb(216,184,248) very light purple
