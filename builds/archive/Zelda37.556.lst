                            	  8025: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8026:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8027:     ;
02:0003BAD0 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0003BAD4 0200000F        	  8029:     andi.b #$0F,D0
02:0003BAD8 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003BADC 6702            	  8031:     beq.s  __far_z_04_0087
02:0003BADE 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
                            	  8034:     ; Set Link's timer to $C0 for the next scene phase.
