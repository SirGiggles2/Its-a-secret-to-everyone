02:0003A316 41F900030E1C    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A31C 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A320 7600            	  4881:     moveq   #0,D3
02:0003A322 1600            	  4882:     move.b  D0,D3
02:0003A324 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A326 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A32A 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A32E 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A330 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A334 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A338 102C0001        	  4889:     move.b  ($0001,A4),D0
