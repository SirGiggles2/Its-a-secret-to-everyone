02:00038EEC 4EB9000490C8    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038EF2 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038EF6 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038EFA 7600            	  2052:     moveq   #0,D3
02:00038EFC 1600            	  2053:     move.b  D0,D3
02:00038EFE 0200000C        	  2054:     andi.b #$0C,D0
02:00038F02 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038F04 7002            	  2056:     moveq   #2,D0
02:00038F06 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038F0A 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
