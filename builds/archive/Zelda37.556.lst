02:0003923E 123C001C        	  2589:     move.b  #$1C,D1
02:00039242 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039246 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:00039248 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:0003924C 41EC0084        	  2593:     lea     ($0084,A4),A0
02:00039250 11802000        	  2594:     move.b  D0,(A0,D2.W)
