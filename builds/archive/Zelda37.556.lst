02:00040A28 B001            	  7006:     cmp.b   D1,D0
02:00040A2A 6704            	  7007:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00040A2C 5302            	  7008:     subq.b  #1,D2
02:00040A2E 66EE            	  7009:     bne  _anon_z05_149
                            	  7010:     even
