02:00048A96 11802000        	  5811:     move.b  D0,(A0,D2.W)
                            	  5812:     ; Go to the next state.
                            	  5813:     ;
02:00048A9A 41EC00AC        	  5814:     lea     ($00AC,A4),A0
02:00048A9E 52302000        	  5815:     addq.b  #1,(A0,D2.W)
                            	  5816:     ; Once we reach state 6, deactivate the object.
                            	  5817:     ; Otherwise, go draw it.
                            	  5818:     ;
02:00048AA2 41EC00AC        	  5819:     lea     ($00AC,A4),A0
02:00048AA6 10302000        	  5820:     move.b  (A0,D2.W),D0
02:00048AAA 0200000F        	  5821:     andi.b #$0F,D0
02:00048AAE 0C000006        	  5822:     cmpi.b  #$06,D0
02:00048AB2 6506            	  5823:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:00048AB4 610001C2        	  5824:     jsr     ResetObjState
                            	  5825:     even
