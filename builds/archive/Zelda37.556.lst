02:000392EA D101            	  2680:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000392EC 003C0011        	  2681:     ori     #$11,CCR  ; SEC: set C+X
02:000392F0 41EC0084        	  2682:     lea     ($0084,A4),A0
02:000392F4 12302000        	  2683:     move.b  (A0,D2.W),D1
02:000392F8 0A3C0010        	  2684:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000392FC 9101            	  2685:     subx.b  D1,D0   ; SBC ObjY,X
02:000392FE 0A3C0010        	  2686:     eori    #$10,CCR  ; restore X = 6502 C
02:00039302 6A0E            	  2687:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  2688:     ; Else negate it, and indicate Link is "up" from the object.
