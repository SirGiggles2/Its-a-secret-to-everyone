                            	  1165:     ; Sprite entry-0 = BG mirror: remap 16→0, 20→4, 24→8, 28→12
02:0000E6DC 04420010        	  1166:     subi.w  #$10,D2
                            	  1167: .t19_bg_color:
02:0000E6E0 3602            	  1168:     move.w  D2,D3
02:0000E6E2 E44B            	  1169:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:0000E6E4 EB4B            	  1170:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:0000E6E6 02420003        	  1171:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
02:0000E6EA E34A            	  1172:     lsl.w   #1,D2                   ; D2.w = color * 2
02:0000E6EC D642            	  1173:     add.w   D2,D3                   ; D3.w = CRAM address (0..$66)
                            	  1174: .t19_have_cram:
                            	  1175: 
                            	  1176:     ; Issue VDP CRAM write command
02:0000E6EE 7400            	  1177:     moveq   #0,D2
02:0000E6F0 3403            	  1178:     move.w  D3,D2
02:0000E6F2 4842            	  1179:     swap    D2                      ; D2 = CRAM_addr << 16
02:0000E6F4 0082C0000000    	  1180:     ori.l   #$C0000000,D2           ; VDP CRAM-write command ($C0 = CD bits for CRAM write)
02:0000E6FA 23C200C00004    	  1181:     move.l  D2,(VDP_CTRL).l
                            	  1182: 
                            	  1183:     ; Look up NES color index (D0.b, 0..63) in NES→Genesis 16-bit color table
02:0000E700 0240003F        	  1184:     andi.w  #$003F,D0               ; D0.w = NES color index (mask high bits)
02:0000E704 41F90000E9AA    	  1185:     lea     (nes_palette_to_genesis).l,A0
02:0000E70A E348            	  1186:     lsl.w   #1,D0                   ; D0.w = byte offset into 16-bit word table
02:0000E70C 34300000        	  1187:     move.w  (A0,D0.W),D2            ; D2.w = Genesis color word ($0BGR)
02:0000E710 33C200C00000    	  1188:     move.w  D2,(VDP_DATA).l         ; write Genesis color to CRAM
