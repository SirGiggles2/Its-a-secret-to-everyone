                            	  4832: SpreadShot:
                            	  4833:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4834:     ;
                            	  4835:     ; The shot is spreading out.
                            	  4836:     ;
                            	  4837:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4838:     ; These will be negated appropriately for each corner.
                            	  4839:     ;
02:000483D0 41EC0098        	  4840:     lea     ($0098,A4),A0
02:000483D4 10302000        	  4841:     move.b  (A0,D2.W),D0
02:000483D8 19400002        	  4842:     move.b  D0,($0002,A4)
02:000483DC 19400003        	  4843:     move.b  D0,($0003,A4)
                            	  4844:     ; Reset [0F] to not flip horizontally.
                            	  4845:     ;
02:000483E0 7000            	  4846:     moveq   #0,D0
02:000483E2 1940000F        	  4847:     move.b  D0,($000F,A4)
                            	  4848:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4849:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4850:     ;
02:000483E6 7603            	  4851:     moveq   #3,D3
                            	  4852:     even
                            	  4853: _L_z07_SpreadShot_DrawShotCorner:
02:000483E8 1003            	  4854:     move.b  D3,D0
02:000483EA 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:000483EC 102C0002        	  4858:     move.b  ($0002,A4),D0
02:000483F0 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:000483F2 102C0003        	  4860:     move.b  ($0003,A4),D0
02:000483F6 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:000483F8 102C0015        	  4869:     move.b  ($0015,A4),D0
02:000483FC 02000003        	  4870:     andi.b #$03,D0
02:00048400 41F9000482DC    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048406 12303000        	  4872:     move.b  (A0,D3.W),D1
02:0004840A 8001            	  4873:     or.b  D1,D0
02:0004840C 4EB900031146    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:00048412 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:00048416 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004841A 122C0002        	  4880:     move.b  ($0002,A4),D1
02:0004841E D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:00048420 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:00048422 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:00048426 B001            	  4887:     cmp.b   D1,D0
02:00048428 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004842A 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:0004842E 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:00048430 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:00048434 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:00048438 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004843C 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:0004843E 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
02:00048442 6014            	  4896:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4897: 
                            	  4898:     even
                            	  4899: _L_z07_SpreadShot_ReverseSub:
02:00048444 10342070        	  4900:     move.b  ($70,A4,D2.W),D0
02:00048448 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:0004844C 1214            	  4902:     move.b  ($0000,A4),D1
02:0004844E 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048452 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:00048454 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4906:     even
