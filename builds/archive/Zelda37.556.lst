02:00048C22 7010            	  6015:     moveq   #16,D0
02:00048C24 4EB900030ABA    	  6016:     jsr     PlaceWeapon
                            	  6017:     ; If the direction is horizontal, and X < $14 or >= $EC, then
                            	  6018:     ; deactivate the shot object.
