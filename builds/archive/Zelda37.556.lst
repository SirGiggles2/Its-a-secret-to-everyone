                            	  2144: ModeE_HandleAOrB:
02:00033784 102C0420        	  2145:     move.b  ($0420,A4),D0
                            	  2146:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2147:     ; the name field.
02:00033788 6646            	  2148:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
