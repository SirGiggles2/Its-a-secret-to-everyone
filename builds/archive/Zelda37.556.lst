                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:0003FDCE 1014            	  5632:     move.b  ($0000,A4),D0
02:0003FDD0 41EC0302        	  5633:     lea     ($0302,A4),A0
02:0003FDD4 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:0003FDD8 5202            	  5635:     addq.b  #1,D2
