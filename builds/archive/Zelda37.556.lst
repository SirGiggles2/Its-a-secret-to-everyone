02:00038EC8 6100F372        	  2028:     jsr     Wanderer_TargetPlayer
                            	  2029:     ; If the octorock is slow, then use q-speed $20.
                            	  2030:     ; Else double it.
                            	  2031:     ;
02:00038ECC 7020            	  2032:     moveq   #32,D0
02:00038ECE 7600            	  2033:     moveq   #0,D3
02:00038ED0 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038ED4 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038ED8 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038EDC 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038EDE 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038EE2 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038EE4 E308            	  2040:     lsl.b  #1,D0   ; ASL A
                            	  2041:     even
                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038EE6 7653            	  2045:     moveq   #83,D3
