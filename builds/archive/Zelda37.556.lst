02:0002CF7C 242F000C        	  4766:     move.l  12(SP),D2       ; arg2 = slot
02:0002CF80 4EB90003C264    	  4767:     jsr     _ShootIfWanted
02:0002CF86 640C            	  4768:     bcc.s   .csiw_fail
02:0002CF88 7000            	  4769:     moveq   #0,D0
02:0002CF8A 1003            	  4770:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CF8C 008000000100    	  4771:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF92 6002            	  4772:     bra.s   .csiw_done
                            	  4773: .csiw_fail:
02:0002CF94 7000            	  4774:     moveq   #0,D0
                            	  4775: .csiw_done:
02:0002CF96 241F            	  4776:     move.l  (SP)+,D2
02:0002CF98 4E75            	  4777:     rts
