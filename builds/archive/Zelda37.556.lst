                            	   753: 
                            	   754: ;==============================================================================
                            	   755: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   756: ;
                            	   757: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   758: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   759: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   760: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   761: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   762: ;
                            	   763: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   764: ;
                            	   765: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   766: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   767: ;==============================================================================
                            	   768:     ifne DEBUG_TELEPORT
                            	   769: _debug_teleport_check:
                            	   770:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   771:     tst.b   ($0010,A4)
                            	   772:     bne     .dtc_no
                            	   773:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   774:     cmpi.b  #$05,($0012,A4)
                            	   775:     bne     .dtc_no
                            	   776:     tst.b   ($0013,A4)
                            	   777:     bne     .dtc_no
                            	   778:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   779:     ;
                            	   780:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   781:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   782:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   783:     ; So the bit map is:
                            	   784:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   785:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   786:     move.b  ($00F8,A4),D1
                            	   787:     andi.b  #$0F,D1
                            	   788:     beq     .dtc_no
                            	   789:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   790:     moveq   #0,D0
                            	   791:     btst    #3,D1                   ; Up
                            	   792:     bne.s   .dtc_dir_set
                            	   793:     moveq   #1,D0
                            	   794:     btst    #2,D1                   ; Down
                            	   795:     bne.s   .dtc_dir_set
                            	   796:     moveq   #2,D0
                            	   797:     btst    #1,D1                   ; Left
                            	   798:     bne.s   .dtc_dir_set
                            	   799:     moveq   #3,D0                   ; Right (bit 0)
                            	   800: .dtc_dir_set:
                            	   801:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   802:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   803:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   804:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   805:     move.b  ($00EB,A4),D2
                            	   806:     move.b  D2,D3
                            	   807:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   808:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   809:     tst.b   D0
                            	   810:     bne.s   .dtc_not_up
                            	   811:     tst.b   D2
                            	   812:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   813:     bra.s   .dtc_apply
                            	   814: .dtc_not_up:
                            	   815:     cmpi.b  #1,D0
                            	   816:     bne.s   .dtc_not_down
                            	   817:     cmpi.b  #7,D2
                            	   818:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   819:     bra.s   .dtc_apply
                            	   820: .dtc_not_down:
                            	   821:     cmpi.b  #2,D0
                            	   822:     bne.s   .dtc_not_left
                            	   823:     tst.b   D3
                            	   824:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   825:     bra.s   .dtc_apply
                            	   826: .dtc_not_left:
                            	   827:     cmpi.b  #$0F,D3
                            	   828:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   829: .dtc_apply:
                            	   830:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   831:     lea     (NextRoomIdOffsets).l,A0
                            	   832:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   833:     move.b  ($00EB,A4),D0
                            	   834:     add.b   D1,D0
                            	   835:     move.b  D0,($00EB,A4)
                            	   836:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   837:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   838:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   839:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   840:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   841:     ; movement update doesn't immediately retrigger the edge.
                            	   842:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   843:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   844:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   845:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   846:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   847:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   848:     ; skip that setup.
                            	   849:     jsr     LayOutRoom
                            	   850:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   851:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   852:     ; kick that from here with arbitrary state causes crashes when the
                            	   853:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   854:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   855:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   856:     ; per target room.
                            	   857:     clr.b   ($00F8,A4)
                            	   858:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   859:                                          ; doesn't walk during sweep settle
                            	   860:     moveq   #1,D0
                            	   861:     rts
                            	   862: .dtc_edge:
                            	   863:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   864:     ; interpret it as "walk into wall" animation.
                            	   865:     clr.b   ($00F8,A4)
                            	   866:     clr.b   ($00FA,A4)
                            	   867:     moveq   #1,D0
                            	   868:     rts
                            	   869: .dtc_no:
                            	   870:     moveq   #0,D0
                            	   871:     rts
                            	   872:     endc
                            	   873: 
                            	   874: ;==============================================================================
                            	   875: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   876: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   877: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   878: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   879: ;==============================================================================
                            	   880:     ifne TURBO_LINK
                            	   881: _turbo_link_boost:
                            	   882:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   883:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   884:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   885:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A5A 4E75            	   886:     rts
                            	   887: _turbo_link_boost_disabled:
                            	   888:     ; OW gate
02:00049A5C 4A2C0010        	   889:     tst.b   ($0010,A4)
02:00049A60 6670            	   890:     bne     .tlb_exit
                            	   891:     ; Mode 5 / Submode 0 only
02:00049A62 0C2C00050012    	   892:     cmpi.b  #$05,($0012,A4)
02:00049A68 6668            	   893:     bne     .tlb_exit
02:00049A6A 4A2C0013        	   894:     tst.b   ($0013,A4)
02:00049A6E 6662            	   895:     bne     .tlb_exit
                            	   896:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049A70 122C00FA        	   897:     move.b  ($00FA,A4),D1
02:00049A74 0201000F        	   898:     andi.b  #$0F,D1
02:00049A78 6758            	   899:     beq     .tlb_exit
                            	   900:     ; Edge-safe clamps.
02:00049A7A 08010003        	   901:     btst    #3,D1                   ; Up (bit 3)
02:00049A7E 6710            	   902:     beq     .tlb_no_up
02:00049A80 102C0084        	   903:     move.b  ($0084,A4),D0
02:00049A84 0C000040        	   904:     cmpi.b  #$40,D0
02:00049A88 6306            	   905:     bls     .tlb_no_up
02:00049A8A 5900            	   906:     subi.b  #4,D0
02:00049A8C 19400084        	   907:     move.b  D0,($0084,A4)
                            	   908: .tlb_no_up:
02:00049A90 08010002        	   909:     btst    #2,D1                   ; Down (bit 2)
02:00049A94 6710            	   910:     beq     .tlb_no_down
02:00049A96 102C0084        	   911:     move.b  ($0084,A4),D0
02:00049A9A 0C0000D0        	   912:     cmpi.b  #$D0,D0
02:00049A9E 6406            	   913:     bcc     .tlb_no_down
02:00049AA0 5800            	   914:     addi.b  #4,D0
02:00049AA2 19400084        	   915:     move.b  D0,($0084,A4)
                            	   916: .tlb_no_down:
02:00049AA6 08010001        	   917:     btst    #1,D1                   ; Left (bit 1)
02:00049AAA 6710            	   918:     beq     .tlb_no_left
02:00049AAC 102C0070        	   919:     move.b  ($0070,A4),D0
02:00049AB0 0C00000A        	   920:     cmpi.b  #$0A,D0
02:00049AB4 6306            	   921:     bls     .tlb_no_left
02:00049AB6 5900            	   922:     subi.b  #4,D0
02:00049AB8 19400070        	   923:     move.b  D0,($0070,A4)
                            	   924: .tlb_no_left:
02:00049ABC 08010000        	   925:     btst    #0,D1                   ; Right (bit 0)
02:00049AC0 6710            	   926:     beq     .tlb_no_right
02:00049AC2 102C0070        	   927:     move.b  ($0070,A4),D0
02:00049AC6 0C0000E6        	   928:     cmpi.b  #$E6,D0
02:00049ACA 6406            	   929:     bcc     .tlb_no_right
02:00049ACC 5800            	   930:     addi.b  #4,D0
02:00049ACE 19400070        	   931:     move.b  D0,($0070,A4)
                            	   932: .tlb_no_right:
                            	   933: .tlb_exit:
02:00049AD2 4E75            	   934:     rts
                            	   935:     endc
