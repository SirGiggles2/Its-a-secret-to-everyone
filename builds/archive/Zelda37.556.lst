                            	  2320: L_EndInitFlyingGhini:
02:0003909A 6100FEE8        	  2321:     jsr     DrawGhiniAndCheckCollisions
                            	  2322:     ; If we're finally leaving the object flagged "initialized",
                            	  2323:     ; then reset metastate and initialize this as a flyer.
                            	  2324:     ;
02:0003909E 41EC0492        	  2325:     lea     ($0492,A4),A0
02:000390A2 10302000        	  2326:     move.b  (A0,D2.W),D0
02:000390A6 66EC            	  2327:     bne  _anon_z04_53
02:000390A8 4EB9000498C2    	  2328:     jsr     ResetObjMetastateAndTimer
02:000390AE 6000F794        	  2329:     jmp     EndInitFlyer
