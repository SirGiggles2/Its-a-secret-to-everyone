02:00048C9C 1880            	  6091:     move.b  D0,($0000,A4)
02:00048C9E 101D            	  6092:     move.b  (A5)+,D0  ; PLA
02:00048CA0 E208            	  6093:     lsr.b  #1,D0   ; LSR A
02:00048CA2 E208            	  6094:     lsr.b  #1,D0   ; LSR A
02:00048CA4 E208            	  6095:     lsr.b  #1,D0   ; LSR A
02:00048CA6 E208            	  6096:     lsr.b  #1,D0   ; LSR A
02:00048CA8 1214            	  6097:     move.b  ($0000,A4),D1
02:00048CAA B001            	  6098:     cmp.b   D1,D0
02:00048CAC 6702            	  6099:     beq.s  __far_z_07_0092
02:00048CAE 60C6            	  6100:     jmp  L1F854_Exit
