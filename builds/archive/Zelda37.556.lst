02:0000EA16 0CCE            	  1681:     dc.w    $0CCE   ; $36  very light pink-beige
02:0000EA18 0ACE            	  1682:     dc.w    $0ACE   ; $37  rgb(252,224,168) very light yellow
02:0000EA1A 06CE            	  1683:     dc.w    $06CE   ; $38  rgb(248,216,120) light yellow
02:0000EA1C 06EC            	  1684:     dc.w    $06EC   ; $39  rgb(216,248,120) light yellow-green
02:0000EA1E 0AEA            	  1685:     dc.w    $0AEA   ; $3A  rgb(184,248,184) light green
