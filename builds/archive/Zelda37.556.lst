                            	   521: UpdateBlock0Idle:
                            	   522:     ; If there are monsters in the room, go reset the push timer and return.
                            	   523:     ;
02:00038430 102C034D        	   524:     move.b  ($034D,A4),D0
02:00038434 6604            	   525:     bne.s  __far_z_04_0000
02:00038436 600000CA        	   526:     jmp  ResetPushTimer
                            	   527: __far_z_04_0000:
                            	   528:     ; If Link's X is aligned with the block's, then get the difference
                            	   529:     ; between Link's (Y + 3) and the block's Y.
                            	   530:     ; Then go test the difference.
                            	   531:     ;
02:0003843A 102C0070        	   532:     move.b  ($0070,A4),D0
02:0003843E 12342070        	   533:     move.b  ($70,A4,D2.W),D1
02:00038442 B001            	   534:     cmp.b   D1,D0
02:00038444 6628            	   535:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038446 7600            	   536:     moveq   #0,D3
02:00038448 102C0084        	   537:     move.b  ($0084,A4),D0
02:0003844C 023C00EE        	   538:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038450 123C0003        	   539:     move.b  #$03,D1
02:00038454 D101            	   540:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038456 003C0011        	   541:     ori     #$11,CCR  ; SEC: set C+X
02:0003845A 41EC0084        	   542:     lea     ($0084,A4),A0
02:0003845E 12302000        	   543:     move.b  (A0,D2.W),D1
02:00038462 0A3C0010        	   544:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038466 9101            	   545:     subx.b  D1,D0   ; SBC ObjY,X
02:00038468 0A3C0010        	   546:     eori    #$10,CCR  ; restore X = 6502 C
02:0003846C 6034            	   547:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   548: 
                            	   549:     even
                            	   550: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   551:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   552:     ; go reset the push timer.
                            	   553:     ;
02:0003846E 102C0084        	   554:     move.b  ($0084,A4),D0
02:00038472 023C00EE        	   555:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038476 123C0003        	   556:     move.b  #$03,D1
02:0003847A D101            	   557:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003847C 41EC0084        	   558:     lea     ($0084,A4),A0
02:00038480 12302000        	   559:     move.b  (A0,D2.W),D1
02:00038484 B001            	   560:     cmp.b   D1,D0
