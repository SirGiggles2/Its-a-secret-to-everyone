02:00000730 6180            	   730:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   731:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   732:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   733:     ; stay wired.
02:00000732 4CDF07FF        	   734:     movem.l (SP)+,D0-D7/A0-A2
