02:0003A2FE 610E            	  4858:     jsr     WriteBossSprite
                            	  4859:     ; Bottom of the loop.
                            	  4860:     ; Decrement tile index and loop index.
                            	  4861:     ;
02:0003A300 532C000A        	  4862:     subq.b  #1,($000A,A4)
02:0003A304 532C000B        	  4863:     subq.b  #1,($000B,A4)
02:0003A308 6A00FF7E        	  4864:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A30C 4E75            	  4865:     rts
