02:0003E286 1883            	  3239:     move.b  D3,($0000,A4)
02:0003E288 163C00FF        	  3240:     move.b  #$FF,D3
02:0003E28C 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:0003E290 5203            	  3243:     addq.b  #1,D3
02:0003E292 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E298 12303000        	  3245:     move.b  (A0,D3.W),D1
02:0003E29C B001            	  3246:     cmp.b   D1,D0
02:0003E29E 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:0003E2A0 1003            	  3254:     move.b  D3,D0
02:0003E2A2 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E2A6 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E2A8 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E2AA 02000003        	  3260:     andi.b #$03,D0
02:0003E2AE 7600            	  3261:     moveq   #0,D3
02:0003E2B0 1600            	  3262:     move.b  D0,D3
02:0003E2B2 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2B8 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
