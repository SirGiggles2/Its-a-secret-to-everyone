02:0002BFE0 08000008        	  2507:     btst    #8,D0
02:0002BFE4 670A            	  2508:     beq.s   .cc_cnr
02:0002BFE6 003C0001        	  2509:     ori     #$01,CCR
02:0002BFEA 0A3C0001        	  2510:     eori    #$01,CCR
02:0002BFEE 4E75            	  2511:     rts
                            	  2512: .cc_cnr:
02:0002BFF0 023C00FE        	  2513:     andi    #$FE,CCR
02:0002BFF4 0A3C0001        	  2514:     eori    #$01,CCR
02:0002BFF8 4E75            	  2515:     rts
                            	  2516: 
