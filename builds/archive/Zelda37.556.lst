                            	  4908:     ; If distance >= $20, skip this corner.
                            	  4909:     ;
02:00048458 0C000020        	  4910:     cmpi.b  #$20,D0
02:0004845C 6438            	  4911:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4912:     ; Add the object's Y (the center of the spread) and the
                            	  4913:     ; current offset in [03] to set sprite Y in [01].
                            	  4914:     ;
02:0004845E 41EC0084        	  4915:     lea     ($0084,A4),A0
02:00048462 10302000        	  4916:     move.b  (A0,D2.W),D0
02:00048466 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004846A 122C0003        	  4918:     move.b  ($0003,A4),D1
02:0004846E D101            	  4919:     addx.b  D1,D0   ; ADC $03
02:00048470 19400001        	  4920:     move.b  D0,($0001,A4)
                            	  4921:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4922:     ;
02:00048474 7600            	  4923:     moveq   #0,D3
02:00048476 162C0010        	  4924:     move.b  ($0010,A4),D3
02:0004847A 670C            	  4925:     beq  _L_z07_SpreadShot_Draw
02:0004847C 0C00003E        	  4926:     cmpi.b  #$3E,D0
02:00048480 6514            	  4927:     bcs  _L_z07_SpreadShot_NextCorner
02:00048482 0C0000E8        	  4928:     cmpi.b  #$E8,D0
02:00048486 640E            	  4929:     bcc  _L_z07_SpreadShot_NextCorner
