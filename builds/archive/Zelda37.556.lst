02:00048C2A 41EC0098        	  6020:     lea     ($0098,A4),A0
02:00048C2E 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00048C32 02000003        	  6022:     andi.b #$03,D0
02:00048C36 6714            	  6023:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00048C38 10342070        	  6024:     move.b  ($70,A4,D2.W),D0
02:00048C3C 0C000014        	  6025:     cmpi.b  #$14,D0
