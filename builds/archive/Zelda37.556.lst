                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038D14 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038D18 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038D1A 4E75            	  1809:     rts
                            	  1810: 
