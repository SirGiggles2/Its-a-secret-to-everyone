                            	  2167: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:000337B4 41F90003317C    	  2168:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:000337BA 10302000        	  2169:     move.b  (A0,D2.W),D0
02:000337BE 41EC0422        	  2170:     lea     ($0422,A4),A0
02:000337C2 11803000        	  2171:     move.b  D0,(A0,D3.W)
02:000337C6 5302            	  2172:     subq.b  #1,D2
02:000337C8 5303            	  2173:     subq.b  #1,D3
02:000337CA 6AE8            	  2174:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:000337CC 522C0420        	  2175:     addq.b  #1,($0420,A4)
                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:000337D0 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:000337D4 020000C0        	  2186:     andi.b #$C0,D0
02:000337D8 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:000337DC 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:000337E0 660000A6        	  2191:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2192:     ; A was pressed.
                            	  2193:     ;
                            	  2194:     ; Request to play the character click tune (same as bomb set).
02:000337E4 7620            	  2195:     moveq   #32,D3
02:000337E6 19430604        	  2196:     move.b  D3,($0604,A4)
02:000337EA 7602            	  2197:     moveq   #2,D3
                            	  2198:     even
                            	  2199: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:000337EC 41EC0422        	  2200:     lea     ($0422,A4),A0
02:000337F0 10303000        	  2201:     move.b  (A0,D3.W),D0
02:000337F4 41EC0302        	  2202:     lea     ($0302,A4),A0
02:000337F8 11803000        	  2203:     move.b  D0,(A0,D3.W)
02:000337FC 5303            	  2204:     subq.b  #1,D3
02:000337FE 6AEC            	  2205:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033800 19430306        	  2206:     move.b  D3,($0306,A4)
02:00033804 7400            	  2207:     moveq   #0,D2
02:00033806 142C0421        	  2208:     move.b  ($0421,A4),D2
02:0003380A 7600            	  2209:     moveq   #0,D3
02:0003380C 162C041F        	  2210:     move.b  ($041F,A4),D3
02:00033810 41F900033150    	  2211:     lea     (ModeE_CharMap).l,A0
02:00033816 10303000        	  2212:     move.b  (A0,D3.W),D0
02:0003381A 19400305        	  2213:     move.b  D0,($0305,A4)
02:0003381E 41EC0638        	  2214:     lea     ($0638,A4),A0
02:00033822 11802000        	  2215:     move.b  D0,(A0,D2.W)
                            	  2216:     even
                            	  2217: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00033826 102C0070        	  2218:     move.b  ($0070,A4),D0
02:0003382A 023C00EE        	  2219:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003382E 123C0008        	  2220:     move.b  #$08,D1
02:00033832 D101            	  2221:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00033834 19400070        	  2222:     move.b  D0,($0070,A4)
02:00033838 522C0421        	  2223:     addq.b  #1,($0421,A4)
02:0003383C 522C0423        	  2224:     addq.b  #1,($0423,A4)
                            	  2225:     ; If VRAM address still points inside the name field,
                            	  2226:     ; then go finish.
                            	  2227:     ;
                            	  2228:     ; The idea is that each name field in nametable begins at
                            	  2229:     ; an address ending in $E. For example, slot 0 has a name
                            	  2230:     ; at VRAM addresses $20CE to $20D5.
                            	  2231:     ;
                            	  2232:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2233:     ; the name field.
                            	  2234:     ;
                            	  2235:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2236:     ; record header.
                            	  2237:     ;
02:00033840 102C0070        	  2238:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00033844 0C0000B0        	  2239:     cmpi.b  #$B0,D0
02:00033848 6678            	  2240:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2241:     ; The VRAM address now points outside the name field.
                            	  2242:     ; So, wrap around to the beginning of the name field.
                            	  2243:     ;
                            	  2244:     ; For example, $20D6 -> $20CE.
                            	  2245:     ;
02:0003384A 102C0423        	  2246:     move.b  ($0423,A4),D0
02:0003384E 003C0011        	  2247:     ori     #$11,CCR  ; SEC: set C+X
02:00033852 123C0008        	  2248:     move.b  #$08,D1
02:00033856 0A3C0010        	  2249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003385A 9101            	  2250:     subx.b  D1,D0   ; SBC #$08
02:0003385C 0A3C0010        	  2251:     eori    #$10,CCR  ; restore X = 6502 C
02:00033860 19400423        	  2252:     move.b  D0,($0423,A4)
                            	  2253:     ; It also means that we went past the end of the save slot
                            	  2254:     ; info name. Set the offset to the beginning of the name.
02:00033864 7600            	  2255:     moveq   #0,D3
02:00033866 162C0016        	  2256:     move.b  ($0016,A4),D3
02:0003386A 41F9000331AC    	  2257:     lea     (SlotToNameOffset).l,A0
02:00033870 10303000        	  2258:     move.b  (A0,D3.W),D0
02:00033874 19400421        	  2259:     move.b  D0,($0421,A4)
                            	  2260:     ; If the name cursor has gone past the end of the field,
                            	  2261:     ; then wrap around.
02:00033878 102C0070        	  2262:     move.b  ($0070,A4),D0
02:0003387C 0C0000B0        	  2263:     cmpi.b  #$B0,D0
02:00033880 6640            	  2264:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033882 7070            	  2265:     moveq   #112,D0
02:00033884 19400070        	  2266:     move.b  D0,($0070,A4)
                            	  2267:     even
                            	  2268: ; PATCH P25b: FS2-E backspace handler.
                            	  2269: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2270: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2271: ; one column (8 px), and writes a space ($24) to the erased
                            	  2272: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2273: ; cannot cross into a previous slot's name field.
                            	  2274: _L_z02_ModeE_HandleAOrB_Backspace:
02:00033888 7600            	  2275:     moveq   #0,D3
02:0003388A 162C0016        	  2276:     move.b  ($0016,A4),D3        ; D3 = current slot
02:0003388E 41F9000331AC    	  2277:     lea     (SlotToNameOffset).l,A0
02:00033894 12303000        	  2278:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00033898 102C0421        	  2279:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:0003389C B001            	  2280:     cmp.b   D1,D0
