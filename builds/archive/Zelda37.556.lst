02:0003A862 7600            	  5562:     moveq   #0,D3
02:0003A864 41EC03E4        	  5563:     lea     ($03E4,A4),A0
02:0003A868 16302000        	  5564:     move.b  (A0,D2.W),D3
02:0003A86C 5203            	  5565:     addq.b  #1,D3
02:0003A86E 1003            	  5566:     move.b  D3,D0
02:0003A870 02000003        	  5567:     andi.b #$03,D0
02:0003A874 41EC03E4        	  5568:     lea     ($03E4,A4),A0
