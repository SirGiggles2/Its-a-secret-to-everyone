                            	  2014: UpdateOctorock:
                            	  2015:     ; If the monster is a fast octorock, use turn rate $A0.
                            	  2016:     ; Else use turn rate $70.
                            	  2017:     ;
02:00038EAA 103C00A0        	  2018:     move.b  #$A0,D0
02:00038EAE 7600            	  2019:     moveq   #0,D3
02:00038EB0 41EC034F        	  2020:     lea     ($034F,A4),A0
02:00038EB4 16302000        	  2021:     move.b  (A0,D2.W),D3
02:00038EB8 0C030009        	  2022:     cmpi.b  #$09,D3
02:00038EBC 6402            	  2023:     bcc  _anon_z04_48
02:00038EBE 7070            	  2024:     moveq   #112,D0
                            	  2025: _anon_z04_48:
02:00038EC0 41EC041F        	  2026:     lea     ($041F,A4),A0
