                            	    36: ; --- PCM form (decoded, ready for YM reg $2A) --------------------------
                            	    37: DMC_SFX_01_PCM_OFF   equ     $000000
                            	    38: DMC_SFX_01_PCM_LEN   equ     $000F75
                            	    39: DMC_SFX_02_PCM_OFF   equ     $000F75
