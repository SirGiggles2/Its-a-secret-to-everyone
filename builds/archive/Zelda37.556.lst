                            	  1190: .nt_skip_write:
02:0000E716 610E            	  1191:     bsr     .inc_ppuaddr
02:0000E718 4CDF037F        	  1192:     movem.l (SP)+,D0-D6/A0-A1
02:0000E71C 4E75            	  1193:     rts
                            	  1194: 
                            	  1195:     ifne CHR_EXPANSION_ENABLED
