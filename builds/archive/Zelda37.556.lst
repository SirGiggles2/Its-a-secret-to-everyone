02:00047376 1014            	  2442:     move.b  ($0000,A4),D0
02:00047378 0C0000F0        	  2443:     cmpi.b  #$F0,D0
02:0004737C 66D2            	  2444:     bne  _L_z07_FillTileMap_Loop
