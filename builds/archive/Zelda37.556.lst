                            	  5846: _L_z07_UpdateSwordOrRod_Add4:
                            	  5847:     ; Set [00] to (state - 1) * 4:
                            	  5848:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5849:     ;
02:00048ADA 023C00EE        	  5850:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048ADE 123C0004        	  5851:     move.b  #$04,D1
02:00048AE2 D101            	  5852:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048AE4 5303            	  5853:     subq.b  #1,D3
02:00048AE6 66F2            	  5854:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048AE8 1880            	  5855:     move.b  D0,($0000,A4)
                            	  5856:     ; Set object's direction to player's. It might have changed
                            	  5857:     ; since the last frame.
                            	  5858:     ;
02:00048AEA 102C0098        	  5859:     move.b  ($0098,A4),D0
02:00048AEE 41EC0098        	  5860:     lea     ($0098,A4),A0
02:00048AF2 11802000        	  5861:     move.b  D0,(A0,D2.W)
                            	  5862:     ; Add [00] and the reverse index of the direction to get
                            	  5863:     ; the byte offset of the pixel offset.
                            	  5864:     ;
02:00048AF6 4EB900030A84    	  5865:     jsr     GetOppositeDir
02:00048AFC 1003            	  5866:     move.b  D3,D0
02:00048AFE 023C00EE        	  5867:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B02 1214            	  5868:     move.b  ($0000,A4),D1
02:00048B04 D101            	  5869:     addx.b  D1,D0   ; ADC $00
02:00048B06 7600            	  5870:     moveq   #0,D3
02:00048B08 1600            	  5871:     move.b  D0,D3
                            	  5872:     ; Set object's X to player's X + offset for state and direction.
                            	  5873:     ; Copy the result to [00].
                            	  5874:     ;
02:00048B0A 102C0070        	  5875:     move.b  ($0070,A4),D0
02:00048B0E 023C00EE        	  5876:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B12 41F900048A3E    	  5877:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048B18 12303000        	  5878:     move.b  (A0,D3.W),D1
02:00048B1C D101            	  5879:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048B1E 19802070        	  5880:     move.b  D0,($70,A4,D2.W)
02:00048B22 1880            	  5881:     move.b  D0,($0000,A4)
                            	  5882:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5883:     ; Copy the result to [01].
                            	  5884:     ;
02:00048B24 102C0084        	  5885:     move.b  ($0084,A4),D0
02:00048B28 023C00EE        	  5886:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B2C 41F900048A4E    	  5887:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048B32 12303000        	  5888:     move.b  (A0,D3.W),D1
02:00048B36 D101            	  5889:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048B38 41EC0084        	  5890:     lea     ($0084,A4),A0
02:00048B3C 11802000        	  5891:     move.b  D0,(A0,D2.W)
02:00048B40 19400001        	  5892:     move.b  D0,($0001,A4)
                            	  5893:     ; If state = 1, use up direction.
                            	  5894:     ; Else use object direction.
                            	  5895:     ;
02:00048B44 41EC00AC        	  5896:     lea     ($00AC,A4),A0
02:00048B48 10302000        	  5897:     move.b  (A0,D2.W),D0
02:00048B4C 0200000F        	  5898:     andi.b #$0F,D0
02:00048B50 7600            	  5899:     moveq   #0,D3
02:00048B52 1600            	  5900:     move.b  D0,D3
02:00048B54 7008            	  5901:     moveq   #8,D0
02:00048B56 5303            	  5902:     subq.b  #1,D3
02:00048B58 6708            	  5903:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048B5A 41EC0098        	  5904:     lea     ($0098,A4),A0
02:00048B5E 10302000        	  5905:     move.b  (A0,D2.W),D0
                            	  5906:     even
                            	  5907: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5908:     ; Store the weapon's frame (horizontal or vertical)
                            	  5909:     ; for the direction chosen above in [0C].
                            	  5910:     ;
02:00048B62 4EB900030A84    	  5911:     jsr     GetOppositeDir
02:00048B68 41F90004859C    	  5912:     lea     (RDirectionToWeaponFrame).l,A0
02:00048B6E 10303000        	  5913:     move.b  (A0,D3.W),D0
02:00048B72 1940000C        	  5914:     move.b  D0,($000C,A4)
                            	  5915:     ; Calculate sprite attributes.
                            	  5916:     ;
                            	  5917:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5918:     ;   base attribute OR 1
                            	  5919:     ; So, it uses palette row 5.
                            	  5920:     ;
02:00048B76 41F9000485A0    	  5921:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048B7C 10303000        	  5922:     move.b  (A0,D3.W),D0
02:00048B80 0C02000D        	  5923:     cmpi.b  #$0D,D2
02:00048B84 6706            	  5924:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048B86 00000001        	  5925:     ori.b #$01,D0
02:00048B8A 601C            	  5926:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5927: 
                            	  5928:     even
                            	  5929: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5930:     ; The weapon is the sword.
                            	  5931:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5932:     ;
02:00048B8C 023C00EE        	  5933:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B90 122C0657        	  5934:     move.b  ($0657,A4),D1
02:00048B94 D101            	  5935:     addx.b  D1,D0   ; ADC Items
02:00048B96 003C0011        	  5936:     ori     #$11,CCR  ; SEC: set C+X
02:00048B9A 123C0001        	  5937:     move.b  #$01,D1
02:00048B9E 0A3C0010        	  5938:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048BA2 9101            	  5939:     subx.b  D1,D0   ; SBC #$01
02:00048BA4 0A3C0010        	  5940:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5941:     even
                            	  5942: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5943:     ; Set sprite attributes to the calculated value above.
                            	  5944:     ;
02:00048BA8 4EB900031146    	  5945:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5946:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5947:     ;
02:00048BAE 0C030002        	  5948:     cmpi.b  #$02,D3
02:00048BB2 6604            	  5949:     bne  _anon_z07_33
02:00048BB4 522C000F        	  5950:     addq.b  #1,($000F,A4)
                            	  5951: _anon_z07_33:
                            	  5952:     ; If state = 1, return. Don't show the weapon.
                            	  5953:     ;
02:00048BB8 41EC00AC        	  5954:     lea     ($00AC,A4),A0
02:00048BBC 10302000        	  5955:     move.b  (A0,D2.W),D0
02:00048BC0 0200000F        	  5956:     andi.b #$0F,D0
02:00048BC4 0C000001        	  5957:     cmpi.b  #$01,D0
02:00048BC8 6604            	  5958:     bne.s  __far_z_07_0085
02:00048BCA 600000AA        	  5959:     jmp  L1F854_Exit
                            	  5960: __far_z_07_0085:
                            	  5961:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5962:     ; sword or rod
                            	  5963:     ;
                            	  5964:     ;
                            	  5965:     ; Sword slot
02:00048BCE 7600            	  5966:     moveq   #0,D3
02:00048BD0 0C02000D        	  5967:     cmpi.b  #$0D,D2
02:00048BD4 6702            	  5968:     beq  _anon_z07_34
02:00048BD6 7608            	  5969:     moveq   #8,D3
                            	  5970: _anon_z07_34:
02:00048BD8 4EB900031066    	  5971:     jsr     Anim_WriteItemSprites
                            	  5972:     ; If state <> 3, return.
                            	  5973:     ;
02:00048BDE 41EC00AC        	  5974:     lea     ($00AC,A4),A0
02:00048BE2 10302000        	  5975:     move.b  (A0,D2.W),D0
02:00048BE6 0200000F        	  5976:     andi.b #$0F,D0
02:00048BEA 0C000003        	  5977:     cmpi.b  #$03,D0
02:00048BEE 6704            	  5978:     beq.s  __far_z_07_0086
02:00048BF0 60000084        	  5979:     jmp  L1F854_Exit
                            	  5980: __far_z_07_0086:
                            	  5981:     ; State = 3. Time to instantiate a shot.
                            	  5982:     ;
                            	  5983:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  5984:     ;
02:00048BF4 0C020012        	  5985:     cmpi.b  #$12,D2
02:00048BF8 6704            	  5986:     beq.s  __far_z_07_0087
02:00048BFA 60000082        	  5987:     jmp  MakeSwordShot
                            	  5988: __far_z_07_0087:
                            	  5989:     ; Instantiate a magic shot (rod shot).
                            	  5990:     ; Switch to the shot slot $E.
                            	  5991:     ;
02:00048BFE 740E            	  5992:     moveq   #14,D2
                            	  5993:     ; If high bit of state is set, return. It's already active.
                            	  5994:     ;
02:00048C00 41EC00AC        	  5995:     lea     ($00AC,A4),A0
02:00048C04 10302000        	  5996:     move.b  (A0,D2.W),D0
02:00048C08 6706            	  5997:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00048C0A E308            	  5998:     lsl.b  #1,D0   ; ASL A
02:00048C0C 6402            	  5999:     bcc.s  __far_z_07_0088
02:00048C0E 6066            	  6000:     jmp  L1F854_Exit
