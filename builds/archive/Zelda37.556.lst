02:0002F33A 6AE8            	   412:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   413:     ; With the first bit of another random number, choose 10 or 40
                            	   414:     ; to put in [046F]. This is a random amount to lose.
                            	   415:     ;
02:0002F33C 102C001A        	   416:     move.b  ($001A,A4),D0
02:0002F340 02000001        	   417:     andi.b #$01,D0
02:0002F344 7600            	   418:     moveq   #0,D3
