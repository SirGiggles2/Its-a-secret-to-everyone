                            	  1712: _bank_rom_bases:
02:0002AA2A 0000EA2A        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA2E 00012A2A
02:0002AA32 00016A2A        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
