                            	  1372: ;----------------------------------------------------------------------
                            	  1373: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1374: ; Layout per slot:
                            	  1375: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1376: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1377: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1378: ;   +3 reserved
                            	  1379: ;
                            	  1380: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1381: ; values are placeholders.
                            	  1382: ;----------------------------------------------------------------------
                            	  1383: PsgDrumTable:
