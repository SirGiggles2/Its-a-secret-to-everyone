02:00031392 41F90003133E    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:00031398 10302000        	   130:     move.b  (A0,D2.W),D0
02:0003139C 19400003        	   131:     move.b  D0,($0003,A4)
02:000313A0 41F900031344    	   132:     lea     (CommonPatternVramAddrs).l,A0
