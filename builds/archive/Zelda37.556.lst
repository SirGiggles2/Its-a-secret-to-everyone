                            	   881: ;==============================================================================
                            	   882: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   883: ;==============================================================================
                            	   884: tick_sq1:
02:000008E0 533900FFE00D    	   885:     subq.b  #1,(m_sq1_cnt).l
02:000008E6 66000116        	   886:     bne     tick_sq0                     ; no new note
                            	   887: .read:
02:000008EA 207900FFE008    	   888:     move.l  (m_script_ptr).l,A0
02:000008F0 7200            	   889:     moveq   #0,D1
02:000008F2 123900FFE00C    	   890:     move.b  (m_sq1_off).l,D1
02:000008F8 523900FFE00C    	   891:     addq.b  #1,(m_sq1_off).l
02:000008FE 10301000        	   892:     move.b  (A0,D1.w),D0
02:00000902 673A            	   893:     beq.s   .song_ended
02:00000904 4A00            	   894:     tst.b   D0
02:00000906 6B02            	   895:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:00000908 6022            	   896:     bra.s   .play_note
                            	   897: .prep_then_note:
02:0000090A 61000284        	   898:     bsr     get_song_note_length         ; D0 in → D0 length
02:0000090E 13C000FFE00E    	   899:     move.b  D0,(m_sq1_len).l
02:00000914 207900FFE008    	   900:     move.l  (m_script_ptr).l,A0
02:0000091A 7200            	   901:     moveq   #0,D1
02:0000091C 123900FFE00C    	   902:     move.b  (m_sq1_off).l,D1
02:00000922 523900FFE00C    	   903:     addq.b  #1,(m_sq1_off).l
02:00000928 10301000        	   904:     move.b  (A0,D1.w),D0
                            	   905: .play_note:
02:0000092C 6100027C        	   906:     bsr     emit_note_sq1                 ; D0 = note id
02:00000930 13F900FFE00E00FF	   907:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:00000938 E00D
02:0000093A 600000C2        	   908:     bra     tick_sq0
                            	   909: .song_ended:
02:0000093E 13FC000100FFE02B	   910:     move.b  #1,(m_song_loop_pending).l   ; signal loop point to C poller
02:00000946 103900FFE000    	   911:     move.b  (m_song).l,D0
02:0000094C 020000F1        	   912:     andi.b  #$F1,D0
02:00000950 6604            	   913:     bne.s   .play_again
02:00000952 60000430        	   914:     bra     music_silence
                            	   915: .play_again:
02:00000956 6102            	   916:     bsr     play_next_phrase_no_tick
02:00000958 6090            	   917:     bra.s   .read
                            	   918: 
                            	   919: ;----------------------------------------------------------------------
                            	   920: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   921: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   922: ; to restart a looping song when $00 opcode is read.
                            	   923: ;----------------------------------------------------------------------
                            	   924: play_next_phrase_no_tick:
02:0000095A 103900FFE000    	   925:     move.b  (m_song).l,D0
02:00000960 6B7E            	   926:     bmi     .nsp_demo
02:00000962 B03C0001        	   927:     cmp.b   #$01,D0
02:00000966 675A            	   928:     beq     .nsp_ow
02:00000968 B03C0040        	   929:     cmp.b   #$40,D0
02:0000096C 6738            	   930:     beq     .nsp_uw
02:0000096E B03C0010        	   931:     cmp.b   #$10,D0
02:00000972 6716            	   932:     beq     .nsp_ending
                            	   933:     ; single-phrase: rebuild phrase from bit
02:00000974 7200            	   934:     moveq   #0,D1
02:00000976 7400            	   935:     moveq   #0,D2
02:00000978 1400            	   936:     move.b  D0,D2
                            	   937: .nsp_loop:
02:0000097A 5201            	   938:     addq.b  #1,D1
02:0000097C E20A            	   939:     lsr.b   #1,D2
02:0000097E 64FA            	   940:     bcc     .nsp_loop
02:00000980 13C100FFE002    	   941:     move.b  D1,(m_phrase).l
02:00000986 6000FEA4        	   942:     bra     prep_phrase
                            	   943: .nsp_ending:
02:0000098A 523900FFE002    	   944:     addq.b  #1,(m_phrase).l
02:00000990 0C39001A00FFE002	   945:     cmpi.b  #$1A,(m_phrase).l
02:00000998 6600FE92        	   946:     bne     prep_phrase
02:0000099C 13FC001400FFE002	   947:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:000009A4 60B4            	   948:     bra     play_next_phrase_no_tick
                            	   949: .nsp_uw:
02:000009A6 523900FFE002    	   950:     addq.b  #1,(m_phrase).l
02:000009AC 0C39001200FFE002	   951:     cmpi.b  #$12,(m_phrase).l
02:000009B4 6600FE76        	   952:     bne     prep_phrase
02:000009B8 13FC000F00FFE002	   953:     move.b  #$0F,(m_phrase).l
02:000009C0 6098            	   954:     bra     play_next_phrase_no_tick
                            	   955: .nsp_ow:
02:000009C2 523900FFE002    	   956:     addq.b  #1,(m_phrase).l
02:000009C8 0C39001000FFE002	   957:     cmpi.b  #$10,(m_phrase).l
02:000009D0 6600FE5A        	   958:     bne     prep_phrase
02:000009D4 13FC000900FFE002	   959:     move.b  #$09,(m_phrase).l
02:000009DC 6000FF7C        	   960:     bra     play_next_phrase_no_tick
                            	   961: .nsp_demo:
02:000009E0 523900FFE002    	   962:     addq.b  #1,(m_phrase).l
02:000009E6 0C39002400FFE002	   963:     cmpi.b  #$24,(m_phrase).l
02:000009EE 6600FE3C        	   964:     bne     prep_phrase
02:000009F2 13FC001900FFE002	   965:     move.b  #$19,(m_phrase).l
02:000009FA 6000FF5E        	   966:     bra     play_next_phrase_no_tick
