02:00038D30 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038D34 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038D38 02000002        	  1829:     andi.b #$02,D0
02:00038D3C 6704            	  1830:     beq  _anon_z04_45
02:00038D3E 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038D42 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038D44 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038D48 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038D4C 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D50 1214            	  1841:     move.b  ($0000,A4),D1
02:00038D52 D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038D54 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038D58 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038D5C 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038D60 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038D64 B001            	  1853:     cmp.b   D1,D0
02:00038D66 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038D68 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038D6A 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038D6E 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038D72 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038D74 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038D78 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038D7C 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038D80 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038D84 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D88 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038D8A 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038D8E 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038D92 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
