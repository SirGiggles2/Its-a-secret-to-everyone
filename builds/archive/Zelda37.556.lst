02:0003A53C 103C0080        	  5177:     move.b  #$80,D0
02:0003A540 6100DCF4        	  5178:     jsr     UpdateCommonWanderer
02:0003A544 4EB9000311C0    	  5179:     jsr     CheckMonsterCollisions
                            	  5180:     ; Darknuts are never stunned.
