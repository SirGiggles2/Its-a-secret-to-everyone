                            	   737: ;==============================================================================
                            	   738: ; change_song — ported from @ChangeSong
                            	   739: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   740: ;
                            	   741: ; Selects the starting phrase index for the new song, then falls into
                            	   742: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   743: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   744: ;==============================================================================
                            	   745: change_song:
02:00000738 4A00            	   746:     tst.b   D0
02:0000073A 6B46            	   747:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:0000073C B03C0006        	   748:     cmp.b   #$06,D0
02:00000740 6610            	   749:     bne.s   .not_zelda
02:00000742 13FC002400FFE002	   750:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:0000074A 610000E0        	   751:     bsr     prep_phrase
02:0000074E 60000190        	   752:     bra     tick_sq1
                            	   753: .not_zelda:
02:00000752 B03C0001        	   754:     cmp.b   #$01,D0
02:00000756 6716            	   755:     beq.s   .first_ow
02:00000758 B03C0040        	   756:     cmp.b   #$40,D0
02:0000075C 671A            	   757:     beq.s   .first_uw
02:0000075E B03C0010        	   758:     cmp.b   #$10,D0
02:00000762 6626            	   759:     bne     play_next_phrase            ; single-phrase song
02:00000764 13FC001100FFE002	   760:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:0000076C 601C            	   761:     bra     play_next_phrase
                            	   762: .first_ow:
02:0000076E 13FC000800FFE002	   763:     move.b  #$08,(m_phrase).l
02:00000776 6012            	   764:     bra     play_next_phrase
                            	   765: .first_uw:
02:00000778 13FC000F00FFE002	   766:     move.b  #$0F,(m_phrase).l
02:00000780 6008            	   767:     bra     play_next_phrase
                            	   768: .first_demo:
02:00000782 13FC001900FFE002	   769:     move.b  #$19,(m_phrase).l
                            	   770:     bra     play_next_phrase
                            	   771: 
                            	   772: ;==============================================================================
                            	   773: ; play_next_phrase — ported from PlayNextPhrase
                            	   774: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   775: ; calls prep_phrase and falls into tick_sq1.
                            	   776: ;==============================================================================
                            	   777: play_next_phrase:
02:0000078A 103900FFE000    	   778:     move.b  (m_song).l,D0
02:00000790 6B78            	   779:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:00000792 B03C0001        	   780:     cmp.b   #$01,D0
02:00000796 6758            	   781:     beq.s   .next_ow
02:00000798 B03C0040        	   782:     cmp.b   #$40,D0
02:0000079C 6738            	   783:     beq.s   .next_uw
02:0000079E B03C0010        	   784:     cmp.b   #$10,D0
02:000007A2 6718            	   785:     beq.s   .next_ending
                            	   786:     ; Single-phrase song: find bit position, phrase = index
02:000007A4 7200            	   787:     moveq   #0,D1
02:000007A6 7400            	   788:     moveq   #0,D2
02:000007A8 1400            	   789:     move.b  D0,D2
                            	   790: .bitloop:
02:000007AA 5201            	   791:     addq.b  #1,D1
02:000007AC E20A            	   792:     lsr.b   #1,D2
02:000007AE 64FA            	   793:     bcc.s   .bitloop
02:000007B0 13C100FFE002    	   794:     move.b  D1,(m_phrase).l
02:000007B6 6174            	   795:     bsr     prep_phrase
02:000007B8 60000126        	   796:     bra     tick_sq1
                            	   797: .next_ending:
02:000007BC 523900FFE002    	   798:     addq.b  #1,(m_phrase).l
02:000007C2 0C39001A00FFE002	   799:     cmpi.b  #$1A,(m_phrase).l
02:000007CA 665A            	   800:     bne.s   .prep_and_tick
02:000007CC 13FC001400FFE002	   801:     move.b  #$14,(m_phrase).l
02:000007D4 60B4            	   802:     bra     play_next_phrase
                            	   803: .next_uw:
02:000007D6 523900FFE002    	   804:     addq.b  #1,(m_phrase).l
02:000007DC 0C39001200FFE002	   805:     cmpi.b  #$12,(m_phrase).l
02:000007E4 6640            	   806:     bne.s   .prep_and_tick
02:000007E6 13FC000F00FFE002	   807:     move.b  #$0F,(m_phrase).l
02:000007EE 609A            	   808:     bra     play_next_phrase
                            	   809: .next_ow:
02:000007F0 523900FFE002    	   810:     addq.b  #1,(m_phrase).l
02:000007F6 0C39001000FFE002	   811:     cmpi.b  #$10,(m_phrase).l
02:000007FE 6626            	   812:     bne.s   .prep_and_tick
02:00000800 13FC000900FFE002	   813:     move.b  #$09,(m_phrase).l
02:00000808 6080            	   814:     bra     play_next_phrase
                            	   815: .next_demo:
02:0000080A 523900FFE002    	   816:     addq.b  #1,(m_phrase).l
02:00000810 0C39002400FFE002	   817:     cmpi.b  #$24,(m_phrase).l
02:00000818 660C            	   818:     bne.s   .prep_and_tick
02:0000081A 13FC001900FFE002	   819:     move.b  #$19,(m_phrase).l
02:00000822 6000FF66        	   820:     bra     play_next_phrase
                            	   821: .prep_and_tick:
02:00000826 6104            	   822:     bsr     prep_phrase
02:00000828 600000B6        	   823:     bra     tick_sq1
                            	   824: 
                            	   825: ;==============================================================================
                            	   826: ; prep_phrase — ported from PrepPhrase
                            	   827: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   828: ;==============================================================================
                            	   829: prep_phrase:
02:0000082C 43F900000E56    	   830:     lea     (MusicBlob).l,A1
02:00000832 7200            	   831:     moveq   #0,D1
02:00000834 123900FFE002    	   832:     move.b  (m_phrase).l,D1
02:0000083A 5341            	   833:     subq.w  #1,D1
02:0000083C 12311000        	   834:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000840 024100FF        	   835:     andi.w  #$FF,D1
                            	   836: 
                            	   837:     ; byte 0: NoteLengthTableBase
02:00000844 13F1100000FFE003	   838:     move.b  (A1,D1.w),(m_len_base).l
02:0000084C 5241            	   839:     addq.w  #1,D1
                            	   840:     ; byte 1: script ptr lo
02:0000084E 7400            	   841:     moveq   #0,D2
02:00000850 14311000        	   842:     move.b  (A1,D1.w),D2
02:00000854 5241            	   843:     addq.w  #1,D1
                            	   844:     ; byte 2: script ptr hi
02:00000856 7600            	   845:     moveq   #0,D3
02:00000858 16311000        	   846:     move.b  (A1,D1.w),D3
02:0000085C 5241            	   847:     addq.w  #1,D1
02:0000085E E14B            	   848:     lsl.w   #8,D3
02:00000860 8642            	   849:     or.w    D2,D3                        ; D3 = NES CPU address
02:00000862 967C8D60        	   850:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:00000866 02830000FFFF    	   851:     andi.l  #$FFFF,D3
02:0000086C 41F900000E56    	   852:     lea     (MusicBlob).l,A0
02:00000872 D1C3            	   853:     adda.l  D3,A0                        ; A0 = M68K script base
02:00000874 23C800FFE008    	   854:     move.l  A0,(m_script_ptr).l
                            	   855: 
                            	   856:     ; byte 3: NoteOffsetSongTrg
02:0000087A 13F1100000FFE01C	   857:     move.b  (A1,D1.w),(m_trg_off).l
02:00000882 5241            	   858:     addq.w  #1,D1
                            	   859:     ; byte 4: NoteOffsetSongSq0
02:00000884 13F1100000FFE014	   860:     move.b  (A1,D1.w),(m_sq0_off).l
02:0000088C 5241            	   861:     addq.w  #1,D1
                            	   862:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:0000088E 13F1100000FFE024	   863:     move.b  (A1,D1.w),(m_noise_off).l
02:00000896 13F1100000FFE006	   864:     move.b  (A1,D1.w),(m_noise_first).l
02:0000089E 5241            	   865:     addq.w  #1,D1
                            	   866:     ; byte 6: SongEnvelopeSelector
02:000008A0 13F1100000FFE004	   867:     move.b  (A1,D1.w),(m_env_sel).l
02:000008A8 5241            	   868:     addq.w  #1,D1
                            	   869:     ; byte 7: mystery
02:000008AA 13F1100000FFE005	   870:     move.b  (A1,D1.w),(m_mystery).l
                            	   871: 
                            	   872:     ; Reset counters and Sq1 offset
02:000008B2 13FC000100FFE00D	   873:     move.b  #1,(m_sq1_cnt).l
02:000008BA 13FC000100FFE015	   874:     move.b  #1,(m_sq0_cnt).l
02:000008C2 13FC000100FFE01D	   875:     move.b  #1,(m_trg_cnt).l
02:000008CA 13FC000100FFE025	   876:     move.b  #1,(m_noise_cnt).l
02:000008D2 423900FFE00C    	   877:     clr.b   (m_sq1_off).l
02:000008D8 423900FFE021    	   878:     clr.b   (m_trg_rep_n).l
02:000008DE 4E75            	   879:     rts
