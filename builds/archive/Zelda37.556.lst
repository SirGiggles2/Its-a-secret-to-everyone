                            	  8384: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8385:     ; Draw the four clouds at diagonal corners.
                            	  8386:     ;
02:0003BD26 610000B6        	  8387:     jsr     Ganon_GetCurCloudLeft
02:0003BD2A 610000BE        	  8388:     jsr     Ganon_GetCurCloudTop
02:0003BD2E 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0003BD30 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BD34 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BD36 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0003BD3A 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
02:0003BD3E 6190            	  8394:     jsr     Ganon_DrawCloud
02:0003BD40 610000A2        	  8395:     jsr     Ganon_GetCurCloudRight
02:0003BD44 618A            	  8396:     jsr     Ganon_DrawCloud
                            	  8397:     ; Draw the top and bottom clouds.
