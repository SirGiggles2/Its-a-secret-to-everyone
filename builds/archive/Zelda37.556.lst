02:0003A8B6 19400028        	  5595:     move.b  D0,($0028,A4)
02:0003A8BA 19400405        	  5596:     move.b  D0,($0405,A4)
02:0003A8BE 194000C0        	  5597:     move.b  D0,($00C0,A4)
02:0003A8C2 194000D3        	  5598:     move.b  D0,($00D3,A4)
                            	  5599:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  5600:     ;
