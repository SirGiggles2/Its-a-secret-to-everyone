02:00039306 4600            	  2691:     eori.b #$FF,D0
02:00039308 023C00EE        	  2692:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003930C 123C0001        	  2693:     move.b  #$01,D1
02:00039310 D101            	  2694:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  2695:     even
