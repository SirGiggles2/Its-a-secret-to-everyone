02:0002B302 D046            	  3117:     add.w   D6,D0                  ; + col*2
02:0002B304 0640B000        	  3118:     addi.w  #$B000,D0              ; + Window base
                            	  3119: 
02:0002B308 7C00            	  3120:     moveq   #0,D6
02:0002B30A 3C00            	  3121:     move.w  D0,D6
02:0002B30C 028600003FFF    	  3122:     andi.l  #$00003FFF,D6
02:0002B312 4846            	  3123:     swap    D6
02:0002B314 008640000002    	  3124:     ori.l   #$40000002,D6          ; CD bits + A[15:14]=2 for $B000
02:0002B31A 23C600C00004    	  3125:     move.l  D6,(VDP_CTRL).l
