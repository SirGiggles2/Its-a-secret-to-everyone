                            	   294: UpdateMenuScrollUp:
                            	   295:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   296:     ;
02:0003C88C 103C00FD        	   297:     move.b  #$FD,D0
02:0003C890 613A            	   298:     jsr     MovePositionMarkers
02:0003C892 102C00FC        	   299:     move.b  ($00FC,A4),D0
02:0003C896 023C00EE        	   300:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C89A 123C0003        	   301:     move.b  #$03,D1
02:0003C89E D101            	   302:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003C8A0 194000FC        	   303:     move.b  D0,($00FC,A4)
                            	   304:     ; If hardware vertical scroll still < $F0, then return.
                            	   305:     ;
