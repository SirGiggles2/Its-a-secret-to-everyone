                            	  2084: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2085:     ; We got here in one of three ways:
                            	  2086:     ;
                            	  2087:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2088:     ;    explicitly.
                            	  2089:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2090:     ;    held an offset that was added to base palette attribute
                            	  2091:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2092:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2093:     ;    held absolute attributes.
                            	  2094:     ;
                            	  2095:     ; At this point, A holds the final sprite attributes.
02:0004AF58 7400            	  2096:     moveq   #0,D2
02:0004AF5A 1942000C        	  2097:     move.b  D2,($000C,A4)
02:0004AF5E 740F            	  2098:     moveq   #15,D2
