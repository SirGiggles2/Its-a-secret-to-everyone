                            	  4439: _L_z05_CheckDoorway_InDoorway:
                            	  4440:     ; In a doorway. DoorwayDir is in A.
                            	  4441:     ;
02:000423FC 1B00            	  4442:     move.b  D0,-(A5)  ; PHA
02:000423FE 610000DC        	  4443:     jsr     GetPlayerCoordsForDirection
02:00042402 101D            	  4444:     move.b  (A5)+,D0  ; PLA
02:00042404 4EB90003093E    	  4445:     jsr     GetOppositeDir
02:0004240A 102C0001        	  4446:     move.b  ($0001,A4),D0
                            	  4447:     ; If the player is within the bounds of the doorway for DoorwayDir
                            	  4448:     ; (for example the left door way, if DoorwayDir = left;
                            	  4449:     ; instead of right doorway while DoorwayDir = left),
                            	  4450:     ; and player is facing in DoorwayDir, then go repeat the
                            	  4451:     ; original search used to enter the doorway.
