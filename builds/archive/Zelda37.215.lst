02:0003CA36 10302000        	  7435:     move.b  (A0,D2.W),D0
02:0003CA3A 123C0008        	  7436:     move.b  #$08,D1
02:0003CA3E D101            	  7437:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA40 19400001        	  7438:     move.b  D0,($0001,A4)
                            	  7439:     ; Only check the first bomb slot ($10).
