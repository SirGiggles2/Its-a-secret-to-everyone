                            	  4211: PondFairy_MoveHearts:
                            	  4212:     ; Loop over each heart from object slot 2 to 9.
                            	  4213:     ;
                            	  4214:     ; Even though they are not standalone objects, their info
                            	  4215:     ; is stored in those object slots.
                            	  4216:     ;
