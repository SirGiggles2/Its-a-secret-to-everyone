                            	  7672: Dodongo_Draw:
02:0003CB8E 610000F4        	  7673:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7674:     ; Make a 5-way direction index out of the facing direction
                            	  7675:     ; by shifting right once, and store it in [00].
                            	  7676:     ;
02:0003CB92 41EC0098        	  7677:     lea     ($0098,A4),A0
02:0003CB96 10302000        	  7678:     move.b  (A0,D2.W),D0
02:0003CB9A E208            	  7679:     lsr.b  #1,D0   ; LSR A
02:0003CB9C 1880            	  7680:     move.b  D0,($0000,A4)
                            	  7681:     ; If state = 0, go handle animating the two frames of this state.
                            	  7682:     ;
02:0003CB9E 7600            	  7683:     moveq   #0,D3
02:0003CBA0 41EC00AC        	  7684:     lea     ($00AC,A4),A0
02:0003CBA4 16302000        	  7685:     move.b  (A0,D2.W),D3
02:0003CBA8 6744            	  7686:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7687:     ; If state > 1, then the monster is stunned (state 2).
                            	  7688:     ; So, go switch frames every $20 screen frames.
                            	  7689:     ;
02:0003CBAA 7020            	  7690:     moveq   #32,D0
02:0003CBAC 5303            	  7691:     subq.b  #1,D3
02:0003CBAE 6640            	  7692:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7693:     ; State = 1. Bloated.
                            	  7694:     ;
                            	  7695:     ; In substate 0, go animate as usual for walking.
                            	  7696:     ;
02:0003CBB0 7600            	  7697:     moveq   #0,D3
02:0003CBB2 41EC042C        	  7698:     lea     ($042C,A4),A0
02:0003CBB6 16302000        	  7699:     move.b  (A0,D2.W),D3
02:0003CBBA 6732            	  7700:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7701:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7702:     ; go fade the boss; so that some frames are not drawn.
                            	  7703:     ;
02:0003CBBC 0C030002        	  7704:     cmpi.b  #$02,D3
02:0003CBC0 6718            	  7705:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CBC2 0C030003        	  7706:     cmpi.b  #$03,D3
02:0003CBC6 6712            	  7707:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7708:     ; State 1, substate 1
                            	  7709:     ;
                            	  7710:     ; Add $14 to the frame image index to index into the bloated
                            	  7711:     ; frame images and H-flips.
                            	  7712:     ;
02:0003CBC8 1014            	  7713:     move.b  ($0000,A4),D0
02:0003CBCA 023C00EE        	  7714:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBCE 123C0014        	  7715:     move.b  #$14,D1
02:0003CBD2 D101            	  7716:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CBD4 7600            	  7717:     moveq   #0,D3
02:0003CBD6 1600            	  7718:     move.b  D0,D3
02:0003CBD8 6032            	  7719:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7720: 
                            	  7721:     even
                            	  7722: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7723:     ; In bloated substates 2 and 3:
                            	  7724:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7725:     ;
02:0003CBDA 102C0015        	  7726:     move.b  ($0015,A4),D0
02:0003CBDE 02000002        	  7727:     andi.b #$02,D0
02:0003CBE2 6604            	  7728:     bne.s  __far_z_04_0071
02:0003CBE4 600000A6        	  7729:     jmp  L11B00_Exit
                            	  7730: __far_z_04_0071:
02:0003CBE8 7600            	  7731:     moveq   #0,D3
02:0003CBEA 1614            	  7732:     move.b  ($0000,A4),D3
02:0003CBEC 601E            	  7733:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7734: 
                            	  7735:     even
                            	  7736: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7737:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7738:     ;
02:0003CBEE 7008            	  7739:     moveq   #8,D0
                            	  7740:     even
                            	  7741: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CBF0 7600            	  7742:     moveq   #0,D3
02:0003CBF2 1614            	  7743:     move.b  ($0000,A4),D3
02:0003CBF4 122C0015        	  7744:     move.b  ($0015,A4),D1
02:0003CBF8 C001            	  7745:     and.b  D1,D0
02:0003CBFA 6710            	  7746:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7747:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7748:     ; in order to index into the second set of frame image numbers.
                            	  7749:     ;
02:0003CBFC 1003            	  7750:     move.b  D3,D0
02:0003CBFE 023C00EE        	  7751:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC02 123C0005        	  7752:     move.b  #$05,D1
02:0003CC06 D101            	  7753:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC08 7600            	  7754:     moveq   #0,D3
02:0003CC0A 1600            	  7755:     move.b  D0,D3
                            	  7756:     even
                            	  7757: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7758:     ; Start preparing sprites.
                            	  7759:     ;
02:0003CC0C 4EB90004D2EA    	  7760:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC12 1003            	  7761:     move.b  D3,D0
02:0003CC14 1B00            	  7762:     move.b  D0,-(A5)  ; PHA
                            	  7763:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7764:     ;
02:0003CC16 41F90003CB70    	  7765:     lea     (DodongoFrameHFlips).l,A0
02:0003CC1C 10303000        	  7766:     move.b  (A0,D3.W),D0
02:0003CC20 1940000F        	  7767:     move.b  D0,($000F,A4)
02:0003CC24 41F90003CB66    	  7768:     lea     (DodongoFrameImages).l,A0
02:0003CC2A 10303000        	  7769:     move.b  (A0,D3.W),D0
                            	  7770:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7771:     ; They are drawn mirrored.
                            	  7772:     ;
02:0003CC2E 0C000007        	  7773:     cmpi.b  #$07,D0
02:0003CC32 6706            	  7774:     beq  _anon_z04_92
02:0003CC34 0C000009        	  7775:     cmpi.b  #$09,D0
02:0003CC38 6608            	  7776:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7777: _anon_z04_92:
02:0003CC3A 4EB900031560    	  7778:     jsr     DrawObjectMirrored
02:0003CC40 6006            	  7779:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7780: 
                            	  7781:     even
                            	  7782: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7783:     ; No other frame images are mirrored.
