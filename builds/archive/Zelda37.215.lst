                            	  5939:     ; If this segment is still alive, then return.
                            	  5940:     ;
02:0003BF82 41EC0405        	  5941:     lea     ($0405,A4),A0
02:0003BF86 10302000        	  5942:     move.b  (A0,D2.W),D0
02:0003BF8A 6774            	  5943:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5944:     ; This segment is dead. We'll swap the tail segment with this
                            	  5945:     ; dead segment. This way, moldorm heads are always rooted
                            	  5946:     ; in slots 5 and $A; and the segments are continguous.
                            	  5947:     ;
                            	  5948:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5949:     ;
                            	  5950:     ; Note that this is not a true swap, because the tail's HP
                            	  5951:     ; might be less than $20.
                            	  5952:     ;
02:0003BF8C 7020            	  5953:     moveq   #32,D0
02:0003BF8E 41EC0485        	  5954:     lea     ($0485,A4),A0
02:0003BF92 11802000        	  5955:     move.b  D0,(A0,D2.W)
02:0003BF96 6100062A        	  5956:     jsr     CheckBossHitReaction
                            	  5957:     ; Look for the tail segment, starting from the low end
                            	  5958:     ; of the chain that this dead segment belongs to.
                            	  5959:     ;
02:0003BF9A 163C00FF        	  5960:     move.b  #$FF,D3
02:0003BF9E 0C020006        	  5961:     cmpi.b  #$06,D2
02:0003BFA2 6502            	  5962:     bcs  _anon_z04_80
02:0003BFA4 7604            	  5963:     moveq   #4,D3
                            	  5964: _anon_z04_80:
