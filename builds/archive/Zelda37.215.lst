                            	  4140: PondFairy_HandleOtherStates:
02:0003B20C 0C000001        	  4141:     cmpi.b  #$01,D0
02:0003B210 6610            	  4142:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4143:     ; State 1. Flying and filling hearts.
                            	  4144:     ;
                            	  4145:     ; If still filling hearts, then go draw Link and hearts.
                            	  4146:     ;
02:0003B212 102C0063        	  4147:     move.b  ($0063,A4),D0
02:0003B216 6620            	  4148:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4149:     ; If not filling hearts anymore, then go to state 2,
                            	  4150:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4151:     ; a little while after we finish filling hearts.
                            	  4152:     ;
02:0003B218 522C00AD        	  4153:     addq.b  #1,($00AD,A4)
02:0003B21C 7050            	  4154:     moveq   #80,D0
02:0003B21E 19400029        	  4155:     move.b  D0,($0029,A4)
                            	  4156:     even
                            	  4157: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4158:     ; If state <> 2 (so, it's 3), then return.
                            	  4159:     ;
                            	  4160:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4161:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4162:     ; was set to, and we'll return.
                            	  4163:     ;
02:0003B222 0C000002        	  4164:     cmpi.b  #$02,D0
02:0003B226 6634            	  4165:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4166:     ; State = 2.
