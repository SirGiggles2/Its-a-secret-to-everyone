02:0003D00A 1B00            	  8261:     move.b  D0,-(A5)  ; PHA
02:0003D00C 023C00EE        	  8262:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D010 123C0006        	  8263:     move.b  #$06,D1
02:0003D014 D101            	  8264:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:0003D016 41EC0084        	  8265:     lea     ($0084,A4),A0
02:0003D01A 11802000        	  8266:     move.b  D0,(A0,D2.W)
