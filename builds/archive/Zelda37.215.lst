                            	  4025: UpdateArmos:
02:0003B148 6100E72A        	  4026:     jsr     UpdateGoriya
                            	  4027:     ; If it's still shoved, then don't animate. Only go draw.
                            	  4028:     ;
02:0003B14C 41EC00C0        	  4029:     lea     ($00C0,A4),A0
02:0003B150 10302000        	  4030:     move.b  (A0,D2.W),D0
02:0003B154 6702            	  4031:     beq.s  __far_z_04_0035
02:0003B156 602A            	  4032:     jmp  DrawArmosAndCheckCollisions
                            	  4033: __far_z_04_0035:
                            	  4034:     ; Animate.
                            	  4035:     ;
                            	  4036:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  4037:     ; then only go draw.
                            	  4038:     ;
02:0003B158 41EC03D0        	  4039:     lea     ($03D0,A4),A0
02:0003B15C 53302000        	  4040:     subq.b  #1,(A0,D2.W)
02:0003B160 6702            	  4041:     beq.s  __far_z_04_0036
02:0003B162 601E            	  4042:     jmp  DrawArmosAndCheckCollisions
                            	  4043: __far_z_04_0036:
                            	  4044:     ; Armos animation frames last 6 screen frames.
                            	  4045:     ;
02:0003B164 7006            	  4046:     moveq   #6,D0
02:0003B166 41EC03D0        	  4047:     lea     ($03D0,A4),A0
02:0003B16A 11802000        	  4048:     move.b  D0,(A0,D2.W)
                            	  4049:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4050:     ; change the position of the shield. To keep fixed it in place,
                            	  4051:     ; there are separate frame images for each animation frame.
                            	  4052:     ;
                            	  4053:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4054:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4055:     ;
                            	  4056:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4057:     ; Then choose the direction at the point of drawing below.
                            	  4058:     ;
02:0003B16E 41EC03E4        	  4059:     lea     ($03E4,A4),A0
02:0003B172 10302000        	  4060:     move.b  (A0,D2.W),D0
02:0003B176 0A000002        	  4061:     eori.b #$02,D0
02:0003B17A 41EC03E4        	  4062:     lea     ($03E4,A4),A0
02:0003B17E 11802000        	  4063:     move.b  D0,(A0,D2.W)
                            	  4064:     even
