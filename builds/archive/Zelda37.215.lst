02:000423D8 12303000        	  4419:     move.b  (A0,D3.W),D1
02:000423DC B001            	  4420:     cmp.b   D1,D0
02:000423DE 6510            	  4421:     bcs  _anon_z05_95
02:000423E0 41F9000423A2    	  4422:     lea     (DoorwayBoundsMaxOver).l,A0
02:000423E6 12303000        	  4423:     move.b  (A0,D3.W),D1
02:000423EA B001            	  4424:     cmp.b   D1,D0
02:000423EC 65000082        	  4425:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4426: _anon_z05_95:
