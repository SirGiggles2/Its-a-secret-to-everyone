                            	  1981:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1982:     ; - layout $23: pattern 1: 2 statues
                            	  1983:     ; - layout $24: pattern 0: 4 statues
                            	  1984:     ;
02:0003A34C 4EB90004B0EE    	  1985:     jsr     GetUniqueRoomId
02:0003A352 7601            	  1986:     moveq   #1,D3
