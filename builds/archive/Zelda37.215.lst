02:000368FC 0C000003        	  5374:     cmpi.b  #$03,D0
02:00036900 7008            	  5375:     moveq   #8,D0
02:00036902 6502            	  5376:     bcs  _anon_z02_49
02:00036904 7006            	  5377:     moveq   #6,D0
                            	  5378: _anon_z02_49:
                            	  5379:     ; If the VRAM line number has not just been incremented to
                            	  5380:     ; the reference line number count, then go write NT attributes.
                            	  5381:     ;
02:00036906 122C050D        	  5382:     move.b  ($050D,A4),D1
02:0003690A B001            	  5383:     cmp.b   D1,D0
02:0003690C 661C            	  5384:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5385:     ; Else roll over the VRAM line to 0.
                            	  5386:     ;
