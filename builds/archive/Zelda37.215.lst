                            	   767: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   768:     ; Replace the low byte of the VRAM address with the one
                            	   769:     ; where the next character should be written.
                            	   770:     ;
02:0002DF48 102C045F        	   771:     move.b  ($045F,A4),D0
02:0002DF4C 19400303        	   772:     move.b  D0,($0303,A4)
                            	   773:     ; Increment the low VRAM address for the next character.
                            	   774:     ;
02:0002DF50 522C045F        	   775:     addq.b  #1,($045F,A4)
                            	   776:     ; Use the person text selector to look up the address of the
                            	   777:     ; text for the textbox. Store the address in [00:01].
                            	   778:     ;
02:0002DF54 7600            	   779:     moveq   #0,D3
02:0002DF56 162C0415        	   780:     move.b  ($0415,A4),D3
02:0002DF5A 41F90002D57A    	   781:     lea     (PersonTextAddrs).l,A0
02:0002DF60 10303000        	   782:     move.b  (A0,D3.W),D0
02:0002DF64 1880            	   783:     move.b  D0,($0000,A4)
02:0002DF66 5203            	   784:     addq.b  #1,D3
02:0002DF68 41F90002D57A    	   785:     lea     (PersonTextAddrs).l,A0
02:0002DF6E 10303000        	   786:     move.b  (A0,D3.W),D0
02:0002DF72 19400001        	   787:     move.b  D0,($0001,A4)
                            	   788:     ; Load the person text current character index.
                            	   789:     ;
02:0002DF76 7600            	   790:     moveq   #0,D3
02:0002DF78 162C0416        	   791:     move.b  ($0416,A4),D3
                            	   792:     ; Increment the index variable to point to the next character
                            	   793:     ; for next time.
                            	   794:     ;
02:0002DF7C 522C0416        	   795:     addq.b  #1,($0416,A4)
                            	   796:     ; Get the current character.
                            	   797:     ;
02:0002DF80 1214            	   798:     move.b  ($00,A4),D1   ; ptr lo
02:0002DF82 182C0001        	   799:     move.b  ($01,A4),D4  ; ptr hi
02:0002DF86 024100FF        	   800:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002DF8A E14C            	   801:     lsl.w   #8,D4
02:0002DF8C 8841            	   802:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002DF8E 48C4            	   803:     ext.l   D4
02:0002DF90 D8BC00FF0000    	   804:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002DF96 2044            	   805:     movea.l D4,A0
02:0002DF98 10303000        	   806:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   807:     ; If the character is $25, then it's a special space. It will still
