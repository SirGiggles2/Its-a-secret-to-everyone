                            	  5569: ReachedTopWallBottom:
                            	  5570:     ; Read a zero tile. Reached the bottom of a top wall.
                            	  5571:     ;
                            	  5572:     ; Set up A and X to move top and bottom offsets to the next column.
                            	  5573:     ;
02:000436A8 7013            	  5574:     moveq   #19,D0
                            	  5575:     ; TODO: I think that any value >= 4 would work here;
                            	  5576:     ; so that we keep processing the wall tile list.
02:000436AA 19400006        	  5577:     move.b  D0,($0006,A4)
02:000436AE 7419            	  5578:     moveq   #25,D2
02:000436B0 6704            	  5579:     beq.s  __far_z_05_0085
02:000436B2 600000D8        	  5580:     jmp  MoveWallPtrs
