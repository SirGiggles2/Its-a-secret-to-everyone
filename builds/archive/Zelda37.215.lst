02:0003E706 103C00FF        	 11345:     move.b  #$FF,D0
02:0003E70A 41EC0492        	 11346:     lea     ($0492,A4),A0
02:0003E70E 11802000        	 11347:     move.b  D0,(A0,D2.W)
