                            	  7625: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D722 7400            	  7626:     moveq   #0,D2
02:0004D724 142C0340        	  7627:     move.b  ($0340,A4),D2
                            	  7628:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7629:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7630:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7631:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7632:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7633:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7634:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7635:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7636:     ; corrupting them and causing a deterministic address-error
                            	  7637:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7638:     ; identified by Codex static review.)
                            	  7639: _L_z07_P47_pre_check:
02:0004D728 102C0525        	  7640:     move.b  ($0525,A4),D0
02:0004D72C 020000F0        	  7641:     andi.b  #$F0,D0
02:0004D730 0C000040        	  7642:     cmpi.b  #$40,D0
02:0004D734 6506            	  7643:     blo     _L_z07_P47_pre_snap
02:0004D736 0C0000E0        	  7644:     cmpi.b  #$E0,D0
02:0004D73A 6506            	  7645:     blo     _L_z07_P47_pre_ok
                            	  7646: _L_z07_P47_pre_snap:
02:0004D73C 197C00480525    	  7647:     move.b  #$48,($0525,A4)
                            	  7648: _L_z07_P47_pre_ok:
02:0004D742 7005            	  7649:     moveq   #5,D0
02:0004D744 61000526        	  7650:     jsr     SwitchBank
02:0004D748 4EB90004209A    	  7651:     jsr     FindNextEdgeSpawnCell
                            	  7652:     ; Post-walk 1: bottom-edge snap.
02:0004D74E 102C0525        	  7653:     move.b  ($0525,A4),D0
02:0004D752 020000F0        	  7654:     andi.b  #$F0,D0
02:0004D756 0C0000E0        	  7655:     cmpi.b  #$E0,D0
02:0004D75A 660C            	  7656:     bne     _L_z07_P47_post1_ok
02:0004D75C 197C00480525    	  7657:     move.b  #$48,($0525,A4)
02:0004D762 4EB90004209A    	  7658:     jsr     FindNextEdgeSpawnCell
                            	  7659: _L_z07_P47_post1_ok:
                            	  7660:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7661:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D768 7600            	  7662:     moveq   #0,D3
02:0004D76A 162C0525        	  7663:     move.b  ($0525,A4),D3
02:0004D76E 0243000F        	  7664:     andi.w  #$000F,D3
02:0004D772 C6FC002C        	  7665:     mulu.w  #44,D3
02:0004D776 203C00FF6530    	  7666:     move.l  #$FF6530,D0
02:0004D77C D083            	  7667:     add.l   D3,D0
02:0004D77E 7600            	  7668:     moveq   #0,D3
02:0004D780 162C0525        	  7669:     move.b  ($0525,A4),D3
02:0004D784 E84B            	  7670:     lsr.w   #4,D3
02:0004D786 5943            	  7671:     subi.w  #4,D3
02:0004D788 E34B            	  7672:     lsl.w   #1,D3
02:0004D78A D083            	  7673:     add.l   D3,D0
02:0004D78C 2040            	  7674:     movea.l D0,A0
02:0004D78E 1010            	  7675:     move.b  (A0),D0
02:0004D790 0C000084        	  7676:     cmpi.b  #$84,D0
02:0004D794 6544            	  7677:     blo     _L_z07_P47_post2_ok
                            	  7678:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7679:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7680:     ; writes to the $05xx region.
02:0004D796 7800            	  7681:     moveq   #0,D4
                            	  7682: _L_z07_P47_fb_loop:
02:0004D798 41FAE44C        	  7683:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D79C 12304000        	  7684:     move.b  (A0,D4.W),D1
02:0004D7A0 19410525        	  7685:     move.b  D1,($0525,A4)
                            	  7686:     ; Validate fallback cell walkable.
02:0004D7A4 7600            	  7687:     moveq   #0,D3
02:0004D7A6 1601            	  7688:     move.b  D1,D3
02:0004D7A8 0243000F        	  7689:     andi.w  #$000F,D3
02:0004D7AC C6FC002C        	  7690:     mulu.w  #44,D3
02:0004D7B0 203C00FF6530    	  7691:     move.l  #$FF6530,D0
02:0004D7B6 D083            	  7692:     add.l   D3,D0
02:0004D7B8 7600            	  7693:     moveq   #0,D3
02:0004D7BA 1601            	  7694:     move.b  D1,D3
02:0004D7BC E84B            	  7695:     lsr.w   #4,D3
02:0004D7BE 5943            	  7696:     subi.w  #4,D3
02:0004D7C0 E34B            	  7697:     lsl.w   #1,D3
02:0004D7C2 D083            	  7698:     add.l   D3,D0
02:0004D7C4 2040            	  7699:     movea.l D0,A0
02:0004D7C6 0C100084        	  7700:     cmpi.b  #$84,(A0)
02:0004D7CA 650E            	  7701:     blo     _L_z07_P47_post2_ok
02:0004D7CC 5204            	  7702:     addq.b  #1,D4
02:0004D7CE 0C040008        	  7703:     cmpi.b  #8,D4
02:0004D7D2 65C4            	  7704:     blo     _L_z07_P47_fb_loop
                            	  7705:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7706:     ; rather than looping).
02:0004D7D4 197C00480525    	  7707:     move.b  #$48,($0525,A4)
                            	  7708: _L_z07_P47_post2_ok:
                            	  7709:     ; Extract and set the monster's location.
                            	  7710:     ;
02:0004D7DA 102C0525        	  7711:     move.b  ($0525,A4),D0
                            	  7712:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7713:     ;
02:0004D7DE 1B00            	  7714:     move.b  D0,-(A5)  ; PHA
02:0004D7E0 E308            	  7715:     lsl.b  #1,D0   ; ASL A
02:0004D7E2 E308            	  7716:     lsl.b  #1,D0   ; ASL A
02:0004D7E4 E308            	  7717:     lsl.b  #1,D0   ; ASL A
02:0004D7E6 E308            	  7718:     lsl.b  #1,D0   ; ASL A
02:0004D7E8 19802070        	  7719:     move.b  D0,($70,A4,D2.W)
                            	  7720:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7721:     ;
02:0004D7EC 101D            	  7722:     move.b  (A5)+,D0  ; PLA
02:0004D7EE 020000F0        	  7723:     andi.b #$F0,D0
02:0004D7F2 003C0011        	  7724:     ori     #$11,CCR  ; SEC: set C+X
02:0004D7F6 123C0003        	  7725:     move.b  #$03,D1
02:0004D7FA 0A3C0010        	  7726:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D7FE 9101            	  7727:     subx.b  D1,D0   ; SBC #$03
02:0004D800 0A3C0010        	  7728:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D804 41EC0084        	  7729:     lea     ($0084,A4),A0
02:0004D808 11802000        	  7730:     move.b  D0,(A0,D2.W)
                            	  7731:     ; Set the monsters-from-edges long timer to a random value
                            	  7732:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7733:     ;
02:0004D80C 10342019        	  7734:     move.b  ($19,A4,D2.W),D0
02:0004D810 02000003        	  7735:     andi.b #$03,D0
02:0004D814 023C00EE        	  7736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D818 123C0002        	  7737:     move.b  #$02,D1
02:0004D81C D101            	  7738:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004D81E 1940004B        	  7739:     move.b  D0,($004B,A4)
                            	  7740:     ; If the distance to Link is too close to Link, then
                            	  7741:     ; go flag the monster uninitialized again, so we can
                            	  7742:     ; try to spawn it again next time.
                            	  7743:     ;
02:0004D822 7005            	  7744:     moveq   #5,D0
02:0004D824 61000446        	  7745:     jsr     SwitchBank
02:0004D828 4EB90004158E    	  7746:     jsr     IsDistanceSafeToSpawn
02:0004D82E 6500FEB4        	  7747:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7748:     ; OK to spawn.
                            	  7749:     ; In this situation, monsters don't spawn from a cloud.
                            	  7750:     ;
02:0004D832 7000            	  7751:     moveq   #0,D0
02:0004D834 41EC0405        	  7752:     lea     ($0405,A4),A0
02:0004D838 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     even
                            	  7755: _L_z07_InitObject_NormalSpawn:
02:0004D83C 7004            	  7756:     moveq   #4,D0
02:0004D83E 6100042C        	  7757:     jsr     SwitchBank
                            	  7758:     ; For monsters that spawn in a cloud, set their start time to
                            	  7759:     ; the same value as the object slot; so that they all start
                            	  7760:     ; moving at different times.
