02:0004D2D2 6604            	  7172:     bne  _anon_z07_38
02:0004D2D4 522C000F        	  7173:     addq.b  #1,($000F,A4)
                            	  7174: _anon_z07_38:
02:0004D2D8 4E75            	  7175:     rts
