                            	  2378: ; Params:
                            	  2379: ; A: Y coordinate
                            	  2380: ; X: object index
                            	  2381: ;
                            	  2382:     even
                            	  2383: InitWhirlwind:
02:0002FB18 6000C130        	  2384:     jmp     c_init_whirlwind
                            	  2385: 
                            	  2386: SetUpWhirlwind:
02:0002FB1C 6000BEDC        	  2387:     jmp     c_set_up_whirlwind
                            	  2388: 
                            	  2389: WhirlwindPrevRoomIdList:
02:0002FB20 36              	  2390:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FB21 3B
02:0002FB22 73
02:0002FB23 44
02:0002FB24 0A
02:0002FB25 21
02:0002FB26 41
02:0002FB27 6C
                            	  2391: 
                            	  2392:     even
                            	  2393: UpdateWhirlwind_Full:
                            	  2394:     ; Get Link's halted state.
                            	  2395:     ;
02:0002FB28 102C00AC        	  2396:     move.b  ($00AC,A4),D0
02:0002FB2C 02000040        	  2397:     andi.b #$40,D0
02:0002FB30 7600            	  2398:     moveq   #0,D3
02:0002FB32 1600            	  2399:     move.b  D0,D3
                            	  2400:     ; Add 2 to whirlwind X.
                            	  2401:     ;
02:0002FB34 7002            	  2402:     moveq   #2,D0
02:0002FB36 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FB3A 12342070        	  2404:     move.b  ($70,A4,D2.W),D1
02:0002FB3E D101            	  2405:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FB40 19802070        	  2406:     move.b  D0,($70,A4,D2.W)
                            	  2407:     ; If Link is not halted or teleporting state = 0, then
                            	  2408:     ; go check for collision with Link.
                            	  2409:     ;
02:0002FB44 0C030040        	  2410:     cmpi.b  #$40,D3
02:0002FB48 6638            	  2411:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FB4A 7600            	  2412:     moveq   #0,D3
02:0002FB4C 162C0522        	  2413:     move.b  ($0522,A4),D3
02:0002FB50 6730            	  2414:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2415:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2416:     ;
                            	  2417:     ; Set Link's X to whirlwind's.
                            	  2418:     ;
02:0002FB52 19400070        	  2419:     move.b  D0,($0070,A4)
                            	  2420:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2421:     ; the right screen edge and draw.
                            	  2422:     ;
02:0002FB56 5303            	  2423:     subq.b  #1,D3
02:0002FB58 6776            	  2424:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FB5A 0C000080        	  2425:     cmpi.b  #$80,D0
02:0002FB5E 6670            	  2426:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2427:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2428:     ;
                            	  2429:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2430:     ;
02:0002FB60 E308            	  2431:     lsl.b  #1,D0   ; ASL A
02:0002FB62 194000AC        	  2432:     move.b  D0,($00AC,A4)
02:0002FB66 19400522        	  2433:     move.b  D0,($0522,A4)
02:0002FB6A 41EC034F        	  2434:     lea     ($034F,A4),A0
02:0002FB6E 11802000        	  2435:     move.b  D0,(A0,D2.W)
                            	  2436:     ; Update the player position marker, and draw one last time.
                            	  2437:     ;
02:0002FB72 1002            	  2438:     move.b  D2,D0
02:0002FB74 1B00            	  2439:     move.b  D0,-(A5)  ; PHA
02:0002FB76 61001108        	  2440:     jsr     UpdatePlayerPositionMarker
02:0002FB7A 101D            	  2441:     move.b  (A5)+,D0  ; PLA
02:0002FB7C 7400            	  2442:     moveq   #0,D2
02:0002FB7E 1400            	  2443:     move.b  D0,D2
02:0002FB80 6070            	  2444:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445: 
                            	  2446:     even
                            	  2447: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2448:     ; Link is not halted or teleporting state = 0.
                            	  2449:     ; Try to pick up Link.
                            	  2450:     ;
                            	  2451:     ; If the whirlwind does not collide with Link, then go check
                            	  2452:     ; for the screen's right edge.
                            	  2453:     ;
02:0002FB82 61001EA6        	  2454:     jsr     CheckLinkCollision
02:0002FB86 102C0006        	  2455:     move.b  ($0006,A4),D0
02:0002FB8A 6744            	  2456:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2457:     ; Collided with Link.
                            	  2458:     ;
                            	  2459:     ; Make Link face right. Reset shove info and subroom type.
                            	  2460:     ;
02:0002FB8C 7001            	  2461:     moveq   #1,D0
02:0002FB8E 19400098        	  2462:     move.b  D0,($0098,A4)
02:0002FB92 E208            	  2463:     lsr.b  #1,D0   ; LSR A
02:0002FB94 194000C0        	  2464:     move.b  D0,($00C0,A4)
02:0002FB98 194000D3        	  2465:     move.b  D0,($00D3,A4)
02:0002FB9C 1940005A        	  2466:     move.b  D0,($005A,A4)
                            	  2467:     ; Halt Link (state $40), and hide him.
                            	  2468:     ;
02:0002FBA0 7040            	  2469:     moveq   #64,D0
02:0002FBA2 194000AC        	  2470:     move.b  D0,($00AC,A4)
02:0002FBA6 103C00F8        	  2471:     move.b  #$F8,D0
02:0002FBAA 19400248        	  2472:     move.b  D0,($0248,A4)
02:0002FBAE 1940024C        	  2473:     move.b  D0,($024C,A4)
                            	  2474:     ; Find and set the room that will behave as the previous room
                            	  2475:     ; when scrolling right to the room with the level's entrance.
                            	  2476:     ;
02:0002FBB2 102C0523        	  2477:     move.b  ($0523,A4),D0
02:0002FBB6 02000007        	  2478:     andi.b #$07,D0
02:0002FBBA 7600            	  2479:     moveq   #0,D3
02:0002FBBC 1600            	  2480:     move.b  D0,D3
02:0002FBBE 41F90002FB20    	  2481:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FBC4 10303000        	  2482:     move.b  (A0,D3.W),D0
02:0002FBC8 194000EA        	  2483:     move.b  D0,($00EA,A4)
                            	  2484:     ; Set teleporting state 1.
                            	  2485:     ;
02:0002FBCC 522C0522        	  2486:     addq.b  #1,($0522,A4)
                            	  2487:     even
                            	  2488: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2489:     ; If whirlwind's X < $F0, go draw.
                            	  2490:     ;
02:0002FBD0 10342070        	  2491:     move.b  ($70,A4,D2.W),D0
