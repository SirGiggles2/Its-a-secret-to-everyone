                            	  8269: __far_z_05_0110:
                            	  8270:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8271:     ; and represents the current row of the submenu being processed.
                            	  8272:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8273:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8274:     ;
                            	  8275:     ; If the bottom bit is set, go prepare the full black row.
                            	  8276:     ;
02:00044F12 E208            	  8277:     lsr.b  #1,D0   ; LSR A
02:00044F14 7600            	  8278:     moveq   #0,D3
02:00044F16 1600            	  8279:     move.b  D0,D3
02:00044F18 6402            	  8280:     bcc.s  __far_z_05_0111
02:00044F1A 6026            	  8281:     jmp  PrepFullBlackRow
                            	  8282: __far_z_05_0111:
                            	  8283:     ; Submenu rows $D to $15 are parts of the map.
                            	  8284:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8285:     ;
                            	  8286:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8287:     ; buffer for this row.
                            	  8288:     ;
02:00044F1C 0C00000D        	  8289:     cmpi.b  #$0D,D0
02:00044F20 640C            	  8290:     bcc  _anon_z05_167
02:00044F22 41F900044EE6    	  8291:     lea     (SubmenuTransferBufSelectorsUW).l,A0
