02:0003CD12 7008            	  7892:     moveq   #8,D0
02:0003CD14 4EB90004D2DA    	  7893:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7894:     ; If facing left, then enable horizontal flipping.
                            	  7895:     ;
02:0003CD1A 41EC0098        	  7896:     lea     ($0098,A4),A0
02:0003CD1E 10302000        	  7897:     move.b  (A0,D2.W),D0
02:0003CD22 0C000002        	  7898:     cmpi.b  #$02,D0
02:0003CD26 6604            	  7899:     bne  _anon_z04_94
02:0003CD28 522C000F        	  7900:     addq.b  #1,($000F,A4)
                            	  7901: _anon_z04_94:
                            	  7902:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7903:     ; This is the base frame image.
