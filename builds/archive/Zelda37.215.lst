                            	  8136: UpdatePolsVoiceState1_Jumping:
                            	  8137:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8138:     ;
02:0003CEEC 41EC0444        	  8139:     lea     ($0444,A4),A0
02:0003CEF0 10302000        	  8140:     move.b  (A0,D2.W),D0
02:0003CEF4 023C00EE        	  8141:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEF8 123C0038        	  8142:     move.b  #$38,D1
02:0003CEFC D101            	  8143:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CEFE 41EC0444        	  8144:     lea     ($0444,A4),A0
02:0003CF02 11802000        	  8145:     move.b  D0,(A0,D2.W)
                            	  8146:     ; Add Carry to high speed byte (vertical).
                            	  8147:     ;
02:0003CF06 41EC0412        	  8148:     lea     ($0412,A4),A0
02:0003CF0A 10302000        	  8149:     move.b  (A0,D2.W),D0
02:0003CF0E 123C0000        	  8150:     move.b  #$00,D1
02:0003CF12 D101            	  8151:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CF14 41EC0412        	  8152:     lea     ($0412,A4),A0
02:0003CF18 11802000        	  8153:     move.b  D0,(A0,D2.W)
                            	  8154:     ; Add high speed byte to Y coordinate.
                            	  8155:     ;
02:0003CF1C 023C00EE        	  8156:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF20 41EC0084        	  8157:     lea     ($0084,A4),A0
02:0003CF24 12302000        	  8158:     move.b  (A0,D2.W),D1
02:0003CF28 D101            	  8159:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CF2A 41EC0084        	  8160:     lea     ($0084,A4),A0
02:0003CF2E 11802000        	  8161:     move.b  D0,(A0,D2.W)
                            	  8162:     ; If the speed is still negative, then return.
                            	  8163:     ;
02:0003CF32 41EC0412        	  8164:     lea     ($0412,A4),A0
02:0003CF36 10302000        	  8165:     move.b  (A0,D2.W),D0
02:0003CF3A 6B0000AC        	  8166:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8167:     ; If Y coordinate still < target Y, then return.
                            	  8168:     ;
02:0003CF3E 41EC0084        	  8169:     lea     ($0084,A4),A0
02:0003CF42 10302000        	  8170:     move.b  (A0,D2.W),D0
02:0003CF46 41EC042C        	  8171:     lea     ($042C,A4),A0
02:0003CF4A 12302000        	  8172:     move.b  (A0,D2.W),D1
02:0003CF4E B001            	  8173:     cmp.b   D1,D0
02:0003CF50 65000096        	  8174:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8175:     ; Else reached the destination. Go to state 0.
                            	  8176:     ;
02:0003CF54 7000            	  8177:     moveq   #0,D0
02:0003CF56 41EC00AC        	  8178:     lea     ($00AC,A4),A0
02:0003CF5A 11802000        	  8179:     move.b  D0,(A0,D2.W)
                            	  8180:     ; Reset 16-bit vertical speed.
                            	  8181:     ;
02:0003CF5E 41EC0444        	  8182:     lea     ($0444,A4),A0
02:0003CF62 11802000        	  8183:     move.b  D0,(A0,D2.W)
02:0003CF66 41EC0412        	  8184:     lea     ($0412,A4),A0
02:0003CF6A 11802000        	  8185:     move.b  D0,(A0,D2.W)
                            	  8186:     ; Choose a random direction to face in.
                            	  8187:     ;
02:0003CF6E 10342018        	  8188:     move.b  ($18,A4,D2.W),D0
02:0003CF72 02000003        	  8189:     andi.b #$03,D0
02:0003CF76 7600            	  8190:     moveq   #0,D3
02:0003CF78 1600            	  8191:     move.b  D0,D3
02:0003CF7A 41F90003CD8A    	  8192:     lea     (PolsVoiceDirections).l,A0
02:0003CF80 10303000        	  8193:     move.b  (A0,D3.W),D0
02:0003CF84 41EC0098        	  8194:     lea     ($0098,A4),A0
02:0003CF88 11802000        	  8195:     move.b  D0,(A0,D2.W)
                            	  8196:     ; Randomly set distance-to-move to $30 or $70.
