                            	  5827: WriteBlankPrioritySprites:
                            	  5828:     ; UNKNOWN: Why are their Y coordinates $3D and $DD?
                            	  5829:     ; Those values are the highest and lowest that Link can normally take.
                            	  5830:     ;
                            	  5831:     ; Repeat two sprites in the first $10 records. They have
                            	  5832:     ; transparent tile $1C, priority 1 (behind BG), and X=0.
                            	  5833:     ; The first of the pair has Y=$3D, and the second one has Y=$DD.
                            	  5834:     ;
                            	  5835:     ; These sprites are first in the list. So they are used for things
                            	  5836:     ; that must be shown above everything else, including Link.
                            	  5837:     ;
02:0003125A 7600            	  5838:     moveq   #0,D3
02:0003125C 7400            	  5839:     moveq   #0,D2
