                            	  6985: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6986:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6987:     ;   full heart=4 partial heart=$70
                            	  6988:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6989:     ; But the method here yields $3EF, because partial heart is
                            	  6990:     ; considered full when = $FF instead of $100.
                            	  6991:     ;
02:00031C1E 102C000E        	  6992:     move.b  ($000E,A4),D0
02:00031C22 003C0011        	  6993:     ori     #$11,CCR  ; SEC: set C+X
02:00031C26 122C0670        	  6994:     move.b  ($0670,A4),D1
02:00031C2A 0A3C0010        	  6995:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C2E 9101            	  6996:     subx.b  D1,D0   ; SBC HeartPartial
02:00031C30 0A3C0010        	  6997:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C34 1940000E        	  6998:     move.b  D0,($000E,A4)
02:00031C38 102C066F        	  6999:     move.b  ($066F,A4),D0
02:00031C3C 0200000F        	  7000:     andi.b #$0F,D0
02:00031C40 6710            	  7001:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031C42 532C066F        	  7002:     subq.b  #1,($066F,A4)
02:00031C46 103C00FF        	  7003:     move.b  #$FF,D0
02:00031C4A 19400670        	  7004:     move.b  D0,($0670,A4)
02:00031C4E 6600FF6E        	  7005:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  7006:     even
                            	  7007: _L_z01_Link_BeHarmed_HandleDied:
                            	  7008:     ; Link died.
                            	  7009:     ;
                            	  7010:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  7011:     ; Make Link face down.
                            	  7012:     ; Go to mode $11.
                            	  7013:     ;
02:00031C52 102C066F        	  7014:     move.b  ($066F,A4),D0
02:00031C56 020000F0        	  7015:     andi.b #$F0,D0
02:00031C5A 1940066F        	  7016:     move.b  D0,($066F,A4)
02:00031C5E 4EB90004B68A    	  7017:     jsr     EndGameMode
02:00031C64 19400670        	  7018:     move.b  D0,($0670,A4)
02:00031C68 194000AC        	  7019:     move.b  D0,($00AC,A4)
02:00031C6C 7011            	  7020:     moveq   #17,D0
