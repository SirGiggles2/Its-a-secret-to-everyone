                            	  5238:     ; to make a fire. In this case, all that's left to do is to go
                            	  5239:     ; deactivate the shot object.
                            	  5240:     ;
02:0004C57C 41EC00AC        	  5241:     lea     ($00AC,A4),A0
02:0004C580 10302000        	  5242:     move.b  (A0,D2.W),D0
02:0004C584 0C000021        	  5243:     cmpi.b  #$21,D0
02:0004C588 6702            	  5244:     beq.s  __far_z_07_0080
02:0004C58A 6038            	  5245:     jmp  DeactivateLinkShot
                            	  5246: __far_z_07_0080:
                            	  5247:     ; Make state $22 for a standing fire.
