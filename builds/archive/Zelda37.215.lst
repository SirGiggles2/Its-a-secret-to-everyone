02:000363B6 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:000363BA 5303            	  4905:     subq.b  #1,D3
02:000363BC 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:000363BE 7600            	  4910:     moveq   #0,D3
02:000363C0 162C0413        	  4911:     move.b  ($0413,A4),D3
02:000363C4 41F90003635E    	  4912:     lea     (PeaceText).l,A0
02:000363CA 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000363CE 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:000363D2 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000363D4 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
02:000363D8 0C000024        	  4920:     cmpi.b  #$24,D0
02:000363DC 6706            	  4921:     beq  _anon_z02_36
02:000363DE 7010            	  4922:     moveq   #16,D0
02:000363E0 19400604        	  4923:     move.b  D0,($0604,A4)
                            	  4924: _anon_z02_36:
                            	  4925:     ; Point to the next character in the string.
                            	  4926:     ;
02:000363E4 522C0413        	  4927:     addq.b  #1,($0413,A4)
                            	  4928:     ; Replace the low byte of the VRAM address with the one
                            	  4929:     ; where the next character should be written.
                            	  4930:     ;
02:000363E8 41F90003632A    	  4931:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000363EE 10303000        	  4932:     move.b  (A0,D3.W),D0
02:000363F2 19400303        	  4933:     move.b  D0,($0303,A4)
                            	  4934:     ; Once the low VRAM address rolls over,
                            	  4935:     ; increment the high address.
                            	  4936:     ;
02:000363F6 0C0000A0        	  4937:     cmpi.b  #$A0,D0
02:000363FA 6406            	  4938:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000363FC 7023            	  4939:     moveq   #35,D0
