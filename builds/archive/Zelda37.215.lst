02:0003E8D2 023C00EE        	 11606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E8D6 123C0001        	 11607:     move.b  #$01,D1
02:0003E8DA D101            	 11608:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003E8DC 02000003        	 11609:     andi.b #$03,D0
02:0003E8E0 194004E7        	 11610:     move.b  D0,($04E7,A4)
                            	 11611:     even
