02:00031B40 6408            	  6868:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6869:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6870:     ; So, go harm Link.
                            	  6871:     ;
02:00031B42 102C0676        	  6872:     move.b  ($0676,A4),D0
02:00031B46 6602            	  6873:     bne.s  __far_z_01_0070
02:00031B48 600E            	  6874:     jmp  HarmLink
