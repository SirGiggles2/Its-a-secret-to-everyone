02:0004C59A 19802070        	  5255:     move.b  D0,($70,A4,D2.W)
02:0004C59E 41EC0084        	  5256:     lea     ($0084,A4),A0
02:0004C5A2 10303000        	  5257:     move.b  (A0,D3.W),D0
02:0004C5A6 41EC0084        	  5258:     lea     ($0084,A4),A0
