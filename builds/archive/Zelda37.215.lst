                            	  6207: 
                            	  6208: ; Params:
                            	  6209: ; [00]: Object X
                            	  6210: ; [01]: Object Y
                            	  6211: ; [02]: Left tile
                            	  6212: ; [03]: Right tile
                            	  6213: ; [04]: Left attributes
                            	  6214: ; [05]: Right attributes
                            	  6215: ; [07]: Has two sides
                            	  6216: ; [08]: Cycle sprite index
                            	  6217: ; [0A]: X separation
                            	  6218: ; [0F]: Flip horizontally
                            	  6219: ; [0343]: LeftSpriteOffset
                            	  6220: ; [0344]: RightSpriteOffset
                            	  6221: ;
