                            	  5287: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003BA3C 19400001        	  5288:     move.b  D0,($0001,A4)
02:0003BA40 61000142        	  5289:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5290:     ; The default image is the hand open.
                            	  5291:     ; If animation frame = 0, then return.
                            	  5292:     ;
02:0003BA44 7400            	  5293:     moveq   #0,D2
02:0003BA46 142C0340        	  5294:     move.b  ($0340,A4),D2
02:0003BA4A 41EC03E4        	  5295:     lea     ($03E4,A4),A0
02:0003BA4E 10302000        	  5296:     move.b  (A0,D2.W),D0
02:0003BA52 6724            	  5297:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5298:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5299:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5300:     ; The right side is correctly the right side of a closed hand.
                            	  5301:     ; But the left side is Keese. So, we have to patch the left
                            	  5302:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5303:     ;
                            	  5304:     ; Keep in mind that left and right sprites might be flipped.
                            	  5305:     ;
02:0003BA54 7600            	  5306:     moveq   #0,D3
02:0003BA56 1614            	  5307:     move.b  ($0000,A4),D3
02:0003BA58 41EC0201        	  5308:     lea     ($0201,A4),A0
02:0003BA5C 10303000        	  5309:     move.b  (A0,D3.W),D0
02:0003BA60 0C00009C        	  5310:     cmpi.b  #$9C,D0
02:0003BA64 6706            	  5311:     beq  _anon_z04_68
02:0003BA66 7600            	  5312:     moveq   #0,D3
02:0003BA68 162C0001        	  5313:     move.b  ($0001,A4),D3
                            	  5314: _anon_z04_68:
02:0003BA6C 103C00AC        	  5315:     move.b  #$AC,D0
