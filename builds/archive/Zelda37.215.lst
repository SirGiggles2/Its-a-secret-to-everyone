                            	  7212: AnimateLinkObjState:
                            	  7213:     ; If major state = $10
                            	  7214:     ;   if minor state = 0, make it 1
                            	  7215:     ;   else OR state with $30
                            	  7216:     ;   go set movement frame to 1
                            	  7217:     ;
02:0004D2F6 102C00AC        	  7218:     move.b  ($00AC,A4),D0
02:0004D2FA 02000030        	  7219:     andi.b #$30,D0
02:0004D2FE 0C000010        	  7220:     cmpi.b  #$10,D0
02:0004D302 660C            	  7221:     bne  _L_z07_AnimateLinkObjState_CheckState20
02:0004D304 102C00AC        	  7222:     move.b  ($00AC,A4),D0
02:0004D308 0200000F        	  7223:     andi.b #$0F,D0
02:0004D30C 6618            	  7224:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
02:0004D30E 6710            	  7225:     beq  _L_z07_AnimateLinkObjState_IncState
                            	  7226:     even
                            	  7227: _L_z07_AnimateLinkObjState_CheckState20:
                            	  7228:     ; If major state = $20
                            	  7229:     ;   if minor state = 0, make it 1
                            	  7230:     ;   else OR state with $30
                            	  7231:     ;   go set movement frame to 1
                            	  7232:     ;
02:0004D310 0C000020        	  7233:     cmpi.b  #$20,D0
02:0004D314 6624            	  7234:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004D316 102C00AC        	  7235:     move.b  ($00AC,A4),D0
02:0004D31A 0200000F        	  7236:     andi.b #$0F,D0
02:0004D31E 6606            	  7237:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  7238:     even
                            	  7239: _L_z07_AnimateLinkObjState_IncState:
