02:00043D68 E308            	  6543:     lsl.b  #1,D0   ; ASL A
02:00043D6A E308            	  6544:     lsl.b  #1,D0   ; ASL A
02:00043D6C 1880            	  6545:     move.b  D0,($0000,A4)
02:00043D6E 4EB900030D9C    	  6546:     jsr     AddToInt16At2
02:00043D74 1014            	  6547:     move.b  ($0000,A4),D0
02:00043D76 4EB900030D9C    	  6548:     jsr     AddToInt16At2
