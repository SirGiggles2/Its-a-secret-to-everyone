                            	 12579: __far_z_04_0125:
                            	 12580:     ; State = 0.
                            	 12581:     ;
                            	 12582:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12583:     ; This is the only patra child shown in the first fame.
                            	 12584:     ;
02:0003F038 0C020002        	 12585:     cmpi.b  #$02,D2
02:0003F03C 6732            	 12586:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12587:     ; The patra child in slot 2 is the last one to be updated.
                            	 12588:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12589:     ;
                            	 12590:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12591:     ; shown.
                            	 12592:     ;
02:0003F03E 102C00AE        	 12593:     move.b  ($00AE,A4),D0
02:0003F042 6700008E        	 12594:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12595:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12596:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12597:     ;
02:0003F046 1002            	 12598:     move.b  D2,D0
                            	 12599:     ; Subtract 3 from the object slot to get the angle where the
                            	 12600:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12601:     ;
02:0003F048 003C0011        	 12602:     ori     #$11,CCR  ; SEC: set C+X
02:0003F04C 123C0003        	 12603:     move.b  #$03,D1
02:0003F050 0A3C0010        	 12604:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F054 9101            	 12605:     subx.b  D1,D0   ; SBC #$03
02:0003F056 0A3C0010        	 12606:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F05A 7600            	 12607:     moveq   #0,D3
02:0003F05C 1600            	 12608:     move.b  D0,D3
                            	 12609:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12610:     ; then return.
                            	 12611:     ;
02:0003F05E 102C0396        	 12612:     move.b  ($0396,A4),D0
02:0003F062 41F90003F01C    	 12613:     lea     (PatraChildStartAngles).l,A0
02:0003F068 12303000        	 12614:     move.b  (A0,D3.W),D1
02:0003F06C B001            	 12615:     cmp.b   D1,D0
02:0003F06E 6662            	 12616:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12617:     even
