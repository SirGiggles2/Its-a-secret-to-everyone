02:0003347C 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033480 E14C            	   559:     lsl.w   #8,D4
02:00033482 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033484 48C4            	   561:     ext.l   D4
02:00033486 D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003348C 2044            	   563:     movea.l D4,A0
02:0003348E 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033492 41EC0630        	   565:     lea     ($0630,A4),A0
02:00033496 11803000        	   566:     move.b  D0,(A0,D3.W)
02:0003349A 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:0003349E 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:000334A2 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000334A6 E14C            	   570:     lsl.w   #8,D4
02:000334A8 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
02:000334AA 48C4            	   572:     ext.l   D4
02:000334AC D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
