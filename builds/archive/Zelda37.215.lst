02:0003BA7E 19400070        	  5329:     move.b  D0,($0070,A4)
02:0003BA82 41EC0084        	  5330:     lea     ($0084,A4),A0
02:0003BA86 10302000        	  5331:     move.b  (A0,D2.W),D0
02:0003BA8A 19400084        	  5332:     move.b  D0,($0084,A4)
02:0003BA8E 4EB90004C1F4    	  5333:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BA94 4EB9000306E0    	  5334:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BA9A 7400            	  5335:     moveq   #0,D2
02:0003BA9C 142C0340        	  5336:     move.b  ($0340,A4),D2
