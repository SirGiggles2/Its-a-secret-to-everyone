02:0003CA46 10343070        	  7444:     move.b  ($70,A4,D3.W),D0
02:0003CA4A 123C0008        	  7445:     move.b  #$08,D1
02:0003CA4E D101            	  7446:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA50 19400002        	  7447:     move.b  D0,($0002,A4)
                            	  7448:     ; Store the bomb's (Y + 8) in [03].
                            	  7449:     ;
02:0003CA54 41EC0084        	  7450:     lea     ($0084,A4),A0
02:0003CA58 10303000        	  7451:     move.b  (A0,D3.W),D0
02:0003CA5C 123C0008        	  7452:     move.b  #$08,D1
02:0003CA60 D101            	  7453:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
