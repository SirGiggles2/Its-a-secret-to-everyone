                            	  1998: _L_z04_UpdateStatues_Shoot:
                            	  1999:     ; Look for an empty monster slot.
                            	  2000:     ; If none is found, return.
                            	  2001:     ;
                            	  2002:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  2003:     ; object. This routine takes a shooter object, and instantiates
                            	  2004:     ; a fireball object at the shooter's location.
                            	  2005:     ;
                            	  2006:     ; The object slot we set up here will behave as the shooter.
                            	  2007:     ; For each fireball index, this object slot will have its coordinates
                            	  2008:     ; changed.
                            	  2009:     ;
                            	  2010:     ; Note that this means that:
                            	  2011:     ; 1. The first fireball made will be its own shooter.
                            	  2012:     ;    Practically, there's nothing special about this.
                            	  2013:     ; 2. If there is more than one fireball made in a frame,
                            	  2014:     ;    then two of them will come from the same statue.
                            	  2015:     ;
                            	  2016:     ;
                            	  2017:     ; Save the fireball pattern.
02:0003A36C 1003            	  2018:     move.b  D3,D0
02:0003A36E 1B00            	  2019:     move.b  D0,-(A5)  ; PHA
02:0003A370 4EB90004DAE0    	  2020:     jsr     FindEmptyMonsterSlot
02:0003A376 0C000001        	  2021:     cmpi.b  #$01,D0
02:0003A37A 101D            	  2022:     move.b  (A5)+,D0  ; PLA
02:0003A37C 6400010A        	  2023:     bcc  _L_z04_UpdateStatues_Exit
                            	  2024:     ; If we found a slot, but it < 6, return.
                            	  2025:     ;
02:0003A380 0C030006        	  2026:     cmpi.b  #$06,D3
02:0003A384 65000102        	  2027:     bcs  _L_z04_UpdateStatues_Exit
                            	  2028:     ; Store the object slot in [0A].
                            	  2029:     ; Store fireball pattern in [0B].
                            	  2030:     ;
02:0003A388 1943000A        	  2031:     move.b  D3,($000A,A4)
02:0003A38C 1940000B        	  2032:     move.b  D0,($000B,A4)
                            	  2033:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  2034:     ;
02:0003A390 7600            	  2035:     moveq   #0,D3
02:0003A392 1600            	  2036:     move.b  D0,D3
02:0003A394 7400            	  2037:     moveq   #0,D2
02:0003A396 41F90003A328    	  2038:     lea     (StatueFireballCounts).l,A0
02:0003A39C 14303000        	  2039:     move.b  (A0,D3.W),D2
                            	  2040:     even
                            	  2041: _L_z04_UpdateStatues_LoopFireball:
                            	  2042:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2043:     ;
                            	  2044:     ; Decrement the fireball timer at this index.
                            	  2045:     ;
02:0003A3A0 7600            	  2046:     moveq   #0,D3
02:0003A3A2 41EC04E8        	  2047:     lea     ($04E8,A4),A0
02:0003A3A6 16302000        	  2048:     move.b  (A0,D2.W),D3
02:0003A3AA 5303            	  2049:     subq.b  #1,D3
02:0003A3AC 1003            	  2050:     move.b  D3,D0
02:0003A3AE 41EC04E8        	  2051:     lea     ($04E8,A4),A0
02:0003A3B2 11802000        	  2052:     move.b  D0,(A0,D2.W)
                            	  2053:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2054:     ; to make a fireball. Go loop again.
                            	  2055:     ;
02:0003A3B6 5203            	  2056:     addq.b  #1,D3
02:0003A3B8 660000C8        	  2057:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2058:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2059:     ; This fireball index will wait another $100 frames.
                            	  2060:     ;
02:0003A3BC 10342018        	  2061:     move.b  ($18,A4,D2.W),D0
02:0003A3C0 0C0000F0        	  2062:     cmpi.b  #$F0,D0
02:0003A3C4 640000BC        	  2063:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2064:     ; Else choose one of four start times for the fireball based on
                            	  2065:     ; the random value.
                            	  2066:     ;
02:0003A3C8 02000003        	  2067:     andi.b #$03,D0
02:0003A3CC 7600            	  2068:     moveq   #0,D3
02:0003A3CE 1600            	  2069:     move.b  D0,D3
02:0003A3D0 41F90003A32C    	  2070:     lea     (StatueFireballStartTimes).l,A0
02:0003A3D6 10303000        	  2071:     move.b  (A0,D3.W),D0
02:0003A3DA 41EC04E8        	  2072:     lea     ($04E8,A4),A0
02:0003A3DE 11802000        	  2073:     move.b  D0,(A0,D2.W)
                            	  2074:     ; The coordinate lists are divided into sets for each pattern.
                            	  2075:     ;
                            	  2076:     ; Look up the index of the base of the set for the pattern in use.
                            	  2077:     ; Add it to the fireball index in X register to get the index of
                            	  2078:     ; the coordinate we want within each coordinate list.
                            	  2079:     ;
                            	  2080:     ;
                            	  2081:     ; Pattern
02:0003A3E2 7600            	  2082:     moveq   #0,D3
02:0003A3E4 162C000B        	  2083:     move.b  ($000B,A4),D3
02:0003A3E8 1002            	  2084:     move.b  D2,D0
02:0003A3EA 023C00EE        	  2085:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3EE 41F90003A330    	  2086:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A3F4 12303000        	  2087:     move.b  (A0,D3.W),D1
02:0003A3F8 D101            	  2088:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A3FA 7600            	  2089:     moveq   #0,D3
02:0003A3FC 1600            	  2090:     move.b  D0,D3
02:0003A3FE 1002            	  2091:     move.b  D2,D0
02:0003A400 1B00            	  2092:     move.b  D0,-(A5)  ; PHA
