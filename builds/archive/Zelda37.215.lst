                            	  6190: __far_z_01_0054:
                            	  6191:     ; For other objects, the caller controls mirroring and flipping.
                            	  6192:     ;
                            	  6193:     ; If mirrored [0C], then draw it mirrored.
                            	  6194:     ; Else draw it horizontally flippable, controlled by [0F].
