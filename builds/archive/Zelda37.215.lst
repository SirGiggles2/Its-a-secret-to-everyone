                            	  6611: Digdogger_Move:
                            	  6612:     ; This calculation is the same one used in Manhandla to
                            	  6613:     ; manifest the fractional speed over several frames.
                            	  6614:     ;
                            	  6615:     ; To summarize, the formula is:
                            	  6616:     ;
                            	  6617:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6618:     ;
                            	  6619:     ;   SA := SA + (SL AND $E0)
                            	  6620:     ;   [03] := SH + carry
                            	  6621:     ;
                            	  6622:     ; See 04:A28E Manhandla_Move.
                            	  6623:     ;
02:0003C410 41EC041F        	  6624:     lea     ($041F,A4),A0
02:0003C414 10302000        	  6625:     move.b  (A0,D2.W),D0
02:0003C418 020000E0        	  6626:     andi.b #$E0,D0
02:0003C41C 023C00EE        	  6627:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C420 41EC0412        	  6628:     lea     ($0412,A4),A0
02:0003C424 12302000        	  6629:     move.b  (A0,D2.W),D1
02:0003C428 D101            	  6630:     addx.b  D1,D0   ; ADC $0412,X
02:0003C42A 41EC0412        	  6631:     lea     ($0412,A4),A0
02:0003C42E 11802000        	  6632:     move.b  D0,(A0,D2.W)
                            	  6633:     ; Assign (high speed byte + carry) to [03].
                            	  6634:     ;
02:0003C432 41EC042C        	  6635:     lea     ($042C,A4),A0
02:0003C436 10302000        	  6636:     move.b  (A0,D2.W),D0
02:0003C43A 123C0000        	  6637:     move.b  #$00,D1
02:0003C43E D101            	  6638:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C440 19400003        	  6639:     move.b  D0,($0003,A4)
                            	  6640:     ; Change coordinates by the speed amount/offset in [03]
                            	  6641:     ; according to the direction.
                            	  6642:     ;
                            	  6643:     ; Start with a mask of $A1 in [02]:
                            	  6644:     ; - low nibble represents the right direction
                            	  6645:     ; - high nibble is used to set or clear carry as we go along
                            	  6646:     ;
02:0003C444 103C00A1        	  6647:     move.b  #$A1,D0
02:0003C448 19400002        	  6648:     move.b  D0,($0002,A4)
                            	  6649:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6650:     ;
02:0003C44C 41EC0098        	  6651:     lea     ($0098,A4),A0
02:0003C450 10302000        	  6652:     move.b  (A0,D2.W),D0
02:0003C454 122C0002        	  6653:     move.b  ($0002,A4),D1
02:0003C458 C200            	  6654:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C45A 6712            	  6655:     beq  _L_z04_Digdogger_Move_Left
02:0003C45C 10342070        	  6656:     move.b  ($70,A4,D2.W),D0
02:0003C460 023C00EE        	  6657:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C464 122C0003        	  6658:     move.b  ($0003,A4),D1
02:0003C468 D101            	  6659:     addx.b  D1,D0   ; ADC $03
02:0003C46A 19802070        	  6660:     move.b  D0,($70,A4,D2.W)
                            	  6661:     even
                            	  6662: _L_z04_Digdogger_Move_Left:
                            	  6663:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6664:     ;
02:0003C46E 41EC0098        	  6665:     lea     ($0098,A4),A0
02:0003C472 10302000        	  6666:     move.b  (A0,D2.W),D0
02:0003C476 122C0002        	  6667:     move.b  ($0002,A4),D1
02:0003C47A E309            	  6668:     lsl.b  #1,D1   ; ASL $02
02:0003C47C 19410002        	  6669:     move.b  D1,($0002,A4)
02:0003C480 122C0002        	  6670:     move.b  ($0002,A4),D1
02:0003C484 C200            	  6671:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C486 6716            	  6672:     beq  _L_z04_Digdogger_Move_Down
02:0003C488 10342070        	  6673:     move.b  ($70,A4,D2.W),D0
02:0003C48C 122C0003        	  6674:     move.b  ($0003,A4),D1
02:0003C490 0A3C0010        	  6675:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C494 9101            	  6676:     subx.b  D1,D0   ; SBC $03
02:0003C496 0A3C0010        	  6677:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C49A 19802070        	  6678:     move.b  D0,($70,A4,D2.W)
                            	  6679:     even
                            	  6680: _L_z04_Digdogger_Move_Down:
                            	  6681:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6682:     ;
02:0003C49E 41EC0098        	  6683:     lea     ($0098,A4),A0
02:0003C4A2 10302000        	  6684:     move.b  (A0,D2.W),D0
02:0003C4A6 122C0002        	  6685:     move.b  ($0002,A4),D1
02:0003C4AA E309            	  6686:     lsl.b  #1,D1   ; ASL $02
02:0003C4AC 19410002        	  6687:     move.b  D1,($0002,A4)
02:0003C4B0 122C0002        	  6688:     move.b  ($0002,A4),D1
02:0003C4B4 C200            	  6689:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4B6 6716            	  6690:     beq  _L_z04_Digdogger_Move_Up
02:0003C4B8 41EC0084        	  6691:     lea     ($0084,A4),A0
02:0003C4BC 10302000        	  6692:     move.b  (A0,D2.W),D0
02:0003C4C0 122C0003        	  6693:     move.b  ($0003,A4),D1
02:0003C4C4 D101            	  6694:     addx.b  D1,D0   ; ADC $03
02:0003C4C6 41EC0084        	  6695:     lea     ($0084,A4),A0
02:0003C4CA 11802000        	  6696:     move.b  D0,(A0,D2.W)
                            	  6697:     even
                            	  6698: _L_z04_Digdogger_Move_Up:
                            	  6699:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6700:     ;
