02:00036760 19400321        	  5189:     move.b  D0,($0321,A4)
                            	  5190:     even
                            	  5191: _L_z02_DrawCredits_TerminateRecords:
                            	  5192:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5193:     ; attributes or only tiles.
                            	  5194:     ;
02:00036764 103C00FF        	  5195:     move.b  #$FF,D0
02:00036768 19400325        	  5196:     move.b  D0,($0325,A4)
02:0003676C 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:00036770 7020            	  5200:     moveq   #32,D0
02:00036772 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:00036776 7400            	  5204:     moveq   #0,D2
02:00036778 142C050C        	  5205:     move.b  ($050C,A4),D2
02:0003677C 41F900036522    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:00036782 10302000        	  5207:     move.b  (A0,D2.W),D0
02:00036786 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:0003678A 102C050D        	  5211:     move.b  ($050D,A4),D0
02:0003678E 7600            	  5212:     moveq   #0,D3
02:00036790 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:00036792 E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:00036794 E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:00036796 E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:00036798 E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:0003679A E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:0003679C 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:000367A0 41F90003652E    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:000367A6 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
                            	  5228:     ; to get the bit that indicates whether this line has text.
                            	  5229:     ;
02:000367AA E308            	  5230:     lsl.b  #1,D0   ; ASL A
02:000367AC 5303            	  5231:     subq.b  #1,D3
02:000367AE 6AFA            	  5232:     bpl  _anon_z02_43
02:000367B0 6400013E        	  5233:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5234:     ; The mask inidcates that it should have text.
                            	  5235:     ; But if line index >= $17, then it doesn't.
                            	  5236:     ;
02:000367B4 7600            	  5237:     moveq   #0,D3
02:000367B6 162C050E        	  5238:     move.b  ($050E,A4),D3
02:000367BA 0C030017        	  5239:     cmpi.b  #$17,D3
02:000367BE 64000130        	  5240:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5241:     ; In the first quest, don't consider line numbers >= $10.
                            	  5242:     ;
02:000367C2 7400            	  5243:     moveq   #0,D2
02:000367C4 142C0016        	  5244:     move.b  ($0016,A4),D2
02:000367C8 41EC062D        	  5245:     lea     ($062D,A4),A0
02:000367CC 10302000        	  5246:     move.b  (A0,D2.W),D0
02:000367D0 6608            	  5247:     bne  _anon_z02_44
02:000367D2 0C030010        	  5248:     cmpi.b  #$10,D3
02:000367D6 64000114        	  5249:     bcc  _L_z02_DrawCredits_IncLine
                            	  5250: _anon_z02_44:
02:000367DA 7400            	  5251:     moveq   #0,D2
02:000367DC 142C0016        	  5252:     move.b  ($0016,A4),D2
02:000367E0 41EC062D        	  5253:     lea     ($062D,A4),A0
02:000367E4 10302000        	  5254:     move.b  (A0,D2.W),D0
                            	  5255:     ; In the second quest, skip lines $C to $F.
                            	  5256:     ;
02:000367E8 670E            	  5257:     beq  _anon_z02_45
02:000367EA 0C03000C        	  5258:     cmpi.b  #$0C,D3
02:000367EE 6508            	  5259:     bcs  _anon_z02_45
02:000367F0 0C030010        	  5260:     cmpi.b  #$10,D3
02:000367F4 650000F6        	  5261:     bcs  _L_z02_DrawCredits_IncLine
                            	  5262: _anon_z02_45:
02:000367F8 41F90003653A    	  5263:     lea     (CreditsTextAddrsLo).l,A0
02:000367FE 10303000        	  5264:     move.b  (A0,D3.W),D0
02:00036802 1880            	  5265:     move.b  D0,($0000,A4)
02:00036804 41F900036552    	  5266:     lea     (CreditsTextAddrsHi).l,A0
