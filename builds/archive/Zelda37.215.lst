                            	 11219: ; Description:
                            	 11220: ; This block applies to heads and the bottom segment of a neck.
                            	 11221: ; These are drawn with sprites that come first in order, so that
                            	 11222: ; they are drawn above all other sprites, including Link.
                            	 11223: ;
                            	 11224: ; Params:
                            	 11225: ; A: tile number
                            	 11226: ;
                            	 11227: ; Normal sprite with level palette row
                            	 11228:     even
                            	 11229: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E642 7603            	 11230:     moveq   #3,D3
02:0003E644 19430003        	 11231:     move.b  D3,($0003,A4)
02:0003E648 1B00            	 11232:     move.b  D0,-(A5)  ; PHA
                            	 11233:     ; To calculate the base offset of the sprite record:
                            	 11234:     ; offset := neck index * 8
                            	 11235:     ;
                            	 11236:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11237:     ; at an even index.
                            	 11238:     ;
02:0003E64A 102C04D7        	 11239:     move.b  ($04D7,A4),D0
02:0003E64E E308            	 11240:     lsl.b  #1,D0   ; ASL A
02:0003E650 E308            	 11241:     lsl.b  #1,D0   ; ASL A
02:0003E652 E308            	 11242:     lsl.b  #1,D0   ; ASL A
                            	 11243:     ; But if the segment is not a head (not at object slot 5), then
                            	 11244:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11245:     ;
02:0003E654 0C020005        	 11246:     cmpi.b  #$05,D2
02:0003E658 670A            	 11247:     beq  _anon_z04_139
