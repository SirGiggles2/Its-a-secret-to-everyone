                            	  6089: _anon_z04_82:
                            	  6090:     ; Turn randomly while flying, as usual.
                            	  6091:     ;
02:0003C062 61003DE2        	  6092:     jsr     Flyer_Wander
                            	  6093:     ; After every turn, the common flyer routines set timer to $10.
                            	  6094:     ; This can be used as a signal for moldorm to propagate
                            	  6095:     ; direction changes down the chain.
                            	  6096:     ;
                            	  6097:     ; Between each turn, timer <> $10.
                            	  6098:     ;
                            	  6099:     ; At the end of the delay after the last turn, timer = 0.
                            	  6100:     ; This is a signal that that flying state ended, and a new one
                            	  6101:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6102:     ; we can propagate direction changes again; and start
                            	  6103:     ; a new flying interval by setting timer to $10. This will make
                            	  6104:     ; the next flying state delay that amount of time before turning
                            	  6105:     ; the first time.
                            	  6106:     ;
                            	  6107:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6108:     ; arm the timer again, and shift directions down the chain.
                            	  6109:     ;
02:0003C066 10342028        	  6110:     move.b  ($28,A4,D2.W),D0
02:0003C06A 6602            	  6111:     bne.s  __far_z_04_0048
02:0003C06C 60CE            	  6112:     jmp  Moldorm_ChangeFlyingState
                            	  6113: __far_z_04_0048:
                            	  6114:     even
                            	  6115: Moldorm_PropagateDirs:
                            	  6116:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6117:     ;
02:0003C06E 10342028        	  6118:     move.b  ($28,A4,D2.W),D0
02:0003C072 0C000010        	  6119:     cmpi.b  #$10,D0
02:0003C076 6702            	  6120:     beq.s  __far_z_04_0049
02:0003C078 6058            	  6121:     jmp  L1156B_Exit
