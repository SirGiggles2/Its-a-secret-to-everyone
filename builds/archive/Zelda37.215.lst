02:00036160 2044            	  4630:     movea.l D4,A0
02:00036162 10303000        	  4631:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00036166 020000C0        	  4632:     andi.b #$C0,D0
02:0003616A 6602            	  4633:     bne.s  __far_z_02_0010
02:0003616C 6032            	  4634:     jmp  LA9F4_Exit
                            	  4635: __far_z_02_0010:
                            	  4636:     ; Determine an index based on the high 2 bits of the character element:
                            	  4637:     ;   $80: 0
                            	  4638:     ;   $40: 1
                            	  4639:     ;   $C0: 2
                            	  4640:     ;
02:0003616E 7602            	  4641:     moveq   #2,D3
02:00036170 0C0000C0        	  4642:     cmpi.b  #$C0,D0
02:00036174 670A            	  4643:     beq  _anon_z02_33
02:00036176 5303            	  4644:     subq.b  #1,D3
02:00036178 0C000040        	  4645:     cmpi.b  #$40,D0
02:0003617C 6702            	  4646:     beq  _anon_z02_33
02:0003617E 5303            	  4647:     subq.b  #1,D3
                            	  4648: _anon_z02_33:
                            	  4649:     ; The index chooses the low VRAM address of the start
                            	  4650:     ; of another line:
                            	  4651:     ;   0: $C4: front of the second line
                            	  4652:     ;   1: $E4: front of the third line
                            	  4653:     ;   2: $A4: front of the first line
                            	  4654:     ;
02:00036180 41F9000360C8    	  4655:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00036186 10303000        	  4656:     move.b  (A0,D3.W),D0
02:0003618A 1940045F        	  4657:     move.b  D0,($045F,A4)
                            	  4658:     ; If index = 2, then we've reached the end of the text,
                            	  4659:     ; and low VRAM address is moved to the front of the first line.
                            	  4660:     ; So, advance the state of the person object, and unhalt Link.
                            	  4661:     ;
02:0003618E 0C030002        	  4662:     cmpi.b  #$02,D3
02:00036192 6702            	  4663:     beq.s  __far_z_02_0011
02:00036194 600A            	  4664:     jmp  LA9F4_Exit
