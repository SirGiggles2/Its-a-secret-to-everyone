                            	  6401: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6402:     ; Digdogger is big, but room boundary checks and
                            	  6403:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6404:     ; Therefore, we have to check these things four times,
                            	  6405:     ; in different corners of the boss.
                            	  6406:     ;
                            	  6407:     ; Loop 4 times, from 0 to 3.
                            	  6408:     ;
02:0003C236 7600            	  6409:     moveq   #0,D3
02:0003C238 41EC0478        	  6410:     lea     ($0478,A4),A0
02:0003C23C 16302000        	  6411:     move.b  (A0,D2.W),D3
                            	  6412:     ; Change the coordinates to one corner.
                            	  6413:     ;
02:0003C240 10342070        	  6414:     move.b  ($70,A4,D2.W),D0
02:0003C244 023C00EE        	  6415:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C248 41F90003C0FC    	  6416:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C24E 12303000        	  6417:     move.b  (A0,D3.W),D1
02:0003C252 D101            	  6418:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C254 19802070        	  6419:     move.b  D0,($70,A4,D2.W)
02:0003C258 41EC0084        	  6420:     lea     ($0084,A4),A0
02:0003C25C 10302000        	  6421:     move.b  (A0,D2.W),D0
02:0003C260 023C00EE        	  6422:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C264 41F90003C100    	  6423:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C26A 12303000        	  6424:     move.b  (A0,D3.W),D1
02:0003C26E D101            	  6425:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C270 41EC0084        	  6426:     lea     ($0084,A4),A0
02:0003C274 11802000        	  6427:     move.b  D0,(A0,D2.W)
                            	  6428:     ; Check the room boundary and object collisions in this temporary location.
                            	  6429:     ;
02:0003C278 61003A62        	  6430:     jsr     BoundFlyer
02:0003C27C 4EB9000318E0    	  6431:     jsr     CheckMonsterCollisions
                            	  6432:     ; Increase the loop index, and loop again until it = 4.
                            	  6433:     ;
02:0003C282 41EC0478        	  6434:     lea     ($0478,A4),A0
02:0003C286 52302000        	  6435:     addq.b  #1,(A0,D2.W)
02:0003C28A 41EC0478        	  6436:     lea     ($0478,A4),A0
02:0003C28E 10302000        	  6437:     move.b  (A0,D2.W),D0
02:0003C292 0C000004        	  6438:     cmpi.b  #$04,D0
02:0003C296 659E            	  6439:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6440:     ; Restore the original coordinates.
                            	  6441:     ;
02:0003C298 101D            	  6442:     move.b  (A5)+,D0  ; PLA
02:0003C29A 41EC0084        	  6443:     lea     ($0084,A4),A0
02:0003C29E 11802000        	  6444:     move.b  D0,(A0,D2.W)
02:0003C2A2 101D            	  6445:     move.b  (A5)+,D0  ; PLA
02:0003C2A4 19802070        	  6446:     move.b  D0,($70,A4,D2.W)
