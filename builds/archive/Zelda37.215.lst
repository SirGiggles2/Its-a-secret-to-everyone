02:00031BAC 1941000D        	  6937:     move.b  D1,($000D,A4)
02:00031BB0 122C000E        	  6938:     move.b  ($000E,A4),D1
02:00031BB4 E211            	  6939:     roxr.b  #1,D1   ; ROR $0E
02:00031BB6 1941000E        	  6940:     move.b  D1,($000E,A4)
