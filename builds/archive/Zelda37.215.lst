02:0003BFA8 41EC0350        	  5966:     lea     ($0350,A4),A0
02:0003BFAC 10303000        	  5967:     move.b  (A0,D3.W),D0
02:0003BFB0 0C000041        	  5968:     cmpi.b  #$41,D0
02:0003BFB4 66F0            	  5969:     bne  _anon_z04_80
                            	  5970:     ; I don't know why the object timer of the tail segment that will
                            	  5971:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5972:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5973:     ; there, the object timer is set to 6.
                            	  5974:     ;
02:0003BFB6 7011            	  5975:     moveq   #17,D0
02:0003BFB8 19803029        	  5976:     move.b  D0,($29,A4,D3.W)
                            	  5977:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5978:     ; segment to the tail segment.
                            	  5979:     ;
