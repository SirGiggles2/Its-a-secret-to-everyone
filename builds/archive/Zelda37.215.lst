                            	  2878: _anon_z04_37:
02:0003A90E 61000196        	  2879:     jsr     Jumper_PointBoulderDownward
                            	  2880:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2881:     ;
02:0003A912 7000            	  2882:     moveq   #0,D0
02:0003A914 41EC0451        	  2883:     lea     ($0451,A4),A0
02:0003A918 11802000        	  2884:     move.b  D0,(A0,D2.W)
                            	  2885:     ; Get the base offset for the kind of jumper the object is.
                            	  2886:     ;
02:0003A91C 6100015E        	  2887:     jsr     Jumper_GetKind
02:0003A920 41F90003A80C    	  2888:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A926 10303000        	  2889:     move.b  (A0,D3.W),D0
                            	  2890:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2891:     ;
                            	  2892:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2893:     ; does not have $B elements like the tektites' sets.
                            	  2894:     ;
                            	  2895:     ; Boulder does not need the upward accelerations.
                            	  2896:     ; So, the elements for those are used for the starting speeds
                            	  2897:     ; at 04:88F2.
                            	  2898:     ;
02:0003A92A 023C00EE        	  2899:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A92E 41EC0098        	  2900:     lea     ($0098,A4),A0
