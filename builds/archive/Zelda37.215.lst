                            	  6944: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6945:     ; Reset values used in special item drops.
                            	  6946:     ;
02:00031BBE 7000            	  6947:     moveq   #0,D0
02:00031BC0 19400627        	  6948:     move.b  D0,($0627,A4)
02:00031BC4 19400050        	  6949:     move.b  D0,($0050,A4)
02:00031BC8 19400051        	  6950:     move.b  D0,($0051,A4)
                            	  6951:     ; If heart partial >= low damage points byte, then simply
                            	  6952:     ; subtract the damage byte from heart partial.
                            	  6953:     ; Else go borrow from full hearts.
                            	  6954:     ;
02:00031BCC 102C0670        	  6955:     move.b  ($0670,A4),D0
02:00031BD0 122C000E        	  6956:     move.b  ($000E,A4),D1
02:00031BD4 B001            	  6957:     cmp.b   D1,D0
02:00031BD6 6546            	  6958:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031BD8 003C0011        	  6959:     ori     #$11,CCR  ; SEC: set C+X
02:00031BDC 122C000E        	  6960:     move.b  ($000E,A4),D1
02:00031BE0 0A3C0010        	  6961:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031BE4 9101            	  6962:     subx.b  D1,D0   ; SBC $0E
02:00031BE6 0A3C0010        	  6963:     eori    #$10,CCR  ; restore X = 6502 C
02:00031BEA 19400670        	  6964:     move.b  D0,($0670,A4)
                            	  6965:     ; If full hearts >= high damage points byte, then simply
                            	  6966:     ; subtract the damage byte from full hearts.
                            	  6967:     ; Else go handle Link dying.
                            	  6968:     ;
02:00031BEE 102C066F        	  6969:     move.b  ($066F,A4),D0
02:00031BF2 0200000F        	  6970:     andi.b #$0F,D0
02:00031BF6 122C000D        	  6971:     move.b  ($000D,A4),D1
02:00031BFA B001            	  6972:     cmp.b   D1,D0
02:00031BFC 6554            	  6973:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031BFE 102C066F        	  6974:     move.b  ($066F,A4),D0
02:00031C02 003C0011        	  6975:     ori     #$11,CCR  ; SEC: set C+X
02:00031C06 122C000D        	  6976:     move.b  ($000D,A4),D1
02:00031C0A 0A3C0010        	  6977:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C0E 9101            	  6978:     subx.b  D1,D0   ; SBC $0D
02:00031C10 0A3C0010        	  6979:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C14 1940066F        	  6980:     move.b  D0,($066F,A4)
02:00031C18 0A3C0001        	  6981:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031C1C 4E75            	  6982:     rts
