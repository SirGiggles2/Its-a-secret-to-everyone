02:0004C662 6438            	  5358:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5359:     ; Add the object's Y (the center of the spread) and the
                            	  5360:     ; current offset in [03] to set sprite Y in [01].
                            	  5361:     ;
02:0004C664 41EC0084        	  5362:     lea     ($0084,A4),A0
02:0004C668 10302000        	  5363:     move.b  (A0,D2.W),D0
02:0004C66C 023C00EE        	  5364:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C670 122C0003        	  5365:     move.b  ($0003,A4),D1
02:0004C674 D101            	  5366:     addx.b  D1,D0   ; ADC $03
02:0004C676 19400001        	  5367:     move.b  D0,($0001,A4)
                            	  5368:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
