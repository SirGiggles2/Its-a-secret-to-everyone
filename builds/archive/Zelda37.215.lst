                            	  4121:     ; If Link's X < $70 or >= $81, then return.
                            	  4122:     ;
02:0003B1EC 102C0070        	  4123:     move.b  ($0070,A4),D0
02:0003B1F0 0C000070        	  4124:     cmpi.b  #$70,D0
