02:0003EBC8 1940007C        	 11955:     move.b  D0,($007C,A4)
02:0003EBCC 7001            	 11956:     moveq   #1,D0
02:0003EBCE 1940007D        	 11957:     move.b  D0,($007D,A4)
02:0003EBD2 7024            	 11958:     moveq   #36,D0
02:0003EBD4 1940000A        	 11959:     move.b  D0,($000A,A4)
02:0003EBD8 4EF90004B1F8    	 11960:     jmp     FillTileMap
