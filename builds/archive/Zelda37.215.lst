                            	  4441:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4442:     ;
02:0004C03C 6100016C        	  4443:     jsr     ReverseObjDir
02:0004C040 60000104        	  4444:     jmp     CheckBoundary
