                            	  3819: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B01A 102C000D        	  3820:     move.b  ($000D,A4),D0
                            	  3821: ; Params:
                            	  3822: ; A: frame image
                            	  3823: ; X: object index
                            	  3824: ; [00]: object X
                            	  3825: ; [01]: object Y
                            	  3826: ; [0F]: flip horizontally
                            	  3827: ;
                            	  3828: ; Returns:
                            	  3829: ; [00]: 0 for Link slot
                            	  3830: ; [06]: 1 if objects collide
                            	  3831: ; [09]: 0 for Link damage type (none)
                            	  3832: ; [0C]: 1 if objects collide
                            	  3833: ; [034B]: ShotCollidesWithLink
