02:0003AEEE 7600            	  3646:     moveq   #0,D3
02:0003AEF0 41EC034F        	  3647:     lea     ($034F,A4),A0
02:0003AEF4 16302000        	  3648:     move.b  (A0,D2.W),D3
02:0003AEF8 0C030007        	  3649:     cmpi.b  #$07,D3
02:0003AEFC 6708            	  3650:     beq  _L_z04_UpdateOctorock_Shoot
