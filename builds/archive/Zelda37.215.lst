02:000334CC 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:000334D0 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000334D4 E14C            	   587:     lsl.w   #8,D4
02:000334D6 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:000334D8 48C4            	   589:     ext.l   D4
02:000334DA D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000334E0 2044            	   591:     movea.l D4,A0
02:000334E2 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000334E6 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:000334E8 1002            	   594:     move.b  D2,D0
02:000334EA E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:000334EC 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:000334EE 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:000334F0 020000F0        	   602:     andi.b #$F0,D0
02:000334F4 1940000C        	   603:     move.b  D0,($000C,A4)
02:000334F8 E208            	   604:     lsr.b  #1,D0   ; LSR A
02:000334FA E208            	   605:     lsr.b  #1,D0   ; LSR A
02:000334FC E208            	   606:     lsr.b  #1,D0   ; LSR A
02:000334FE E208            	   607:     lsr.b  #1,D0   ; LSR A
02:00033500 122C000C        	   608:     move.b  ($000C,A4),D1
02:00033504 8001            	   609:     or.b  D1,D0
02:00033506 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
02:00033508 101D            	   613:     move.b  (A5)+,D0  ; PLA
02:0003350A 41EC0650        	   614:     lea     ($0650,A4),A0
02:0003350E 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033512 5203            	   618:     addq.b  #1,D3
02:00033514 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:00033516 0C020006        	   622:     cmpi.b  #$06,D2
02:0003351A 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:0003351C 1002            	   624:     move.b  D2,D0
