02:0003C972 6502            	  7333:     bcs.s  __far_z_04_0067
02:0003C974 6034            	  7334:     jmp  L11989_Exit
                            	  7335: __far_z_04_0067:
                            	  7336:     ; Save the X coordinate.
                            	  7337:     ; Then add $10 to check the right-hand side.
                            	  7338:     ;
02:0003C976 10342070        	  7339:     move.b  ($70,A4,D2.W),D0
02:0003C97A 1B00            	  7340:     move.b  D0,-(A5)  ; PHA
02:0003C97C 023C00EE        	  7341:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C980 123C0010        	  7342:     move.b  #$10,D1
02:0003C984 D101            	  7343:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C986 19802070        	  7344:     move.b  D0,($70,A4,D2.W)
02:0003C98A 6120            	  7345:     jsr     Dodongo_CheckCollisionsStandardSize
                            	  7346:     ; Restore the X coordinate.
                            	  7347:     ;
