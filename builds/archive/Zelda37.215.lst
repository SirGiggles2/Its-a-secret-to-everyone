02:0003B988 41F90003B7BA    	  5206:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003B98E 10303000        	  5207:     move.b  (A0,D3.W),D0
02:0003B992 0200000F        	  5208:     andi.b #$0F,D0
02:0003B996 41EC0098        	  5209:     lea     ($0098,A4),A0
