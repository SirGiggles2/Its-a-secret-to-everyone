02:00030C4A 0C000013        	  5000:     cmpi.b  #$13,D0
02:00030C4E 662E            	  5001:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  5002:     ; The effect involves turning grayscale rendering on and off
                            	  5003:     ; in PPUMASK.
                            	  5004:     ;
                            	  5005:     ; Start by setting A register to the PPU mask shifted right to
                            	  5006:     ; throw away the grayscale bit.
                            	  5007:     ;
02:00030C50 102C00FE        	  5008:     move.b  ($00FE,A4),D0
02:00030C54 E208            	  5009:     lsr.b  #1,D0   ; LSR A
                            	  5010:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  5011:     ;
02:00030C56 7600            	  5012:     moveq   #0,D3
02:00030C58 16342028        	  5013:     move.b  ($28,A4,D2.W),D3
                            	  5014:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  5015:     ; Carry will have been set, because of the comparison (CPY).
                            	  5016:     ;
02:00030C5C 0C030016        	  5017:     cmpi.b  #$16,D3
02:00030C60 6706            	  5018:     beq  _anon_z01_54
02:00030C62 0C030011        	  5019:     cmpi.b  #$11,D3
02:00030C66 6604            	  5020:     bne  _L_z01_UpdateBombFlashEffect_Clear
