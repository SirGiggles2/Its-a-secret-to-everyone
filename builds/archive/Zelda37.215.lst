                            	  2796: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2797:     ; If reversal count >= 2, then
                            	  2798:     ; 1. invert the horizontal component of facing direction,
                            	  2799:     ;    to face away from the chase target
                            	  2800:     ; 2. reset the reversal count to 0.
                            	  2801:     ;
                            	  2802:     ; This prevents a jumper from getting stuck in a corner.
                            	  2803:     ;
                            	  2804:     ; For example, if a tektite's direction is down and right,
                            	  2805:     ; and jumps into the top right corner of the room:
                            	  2806:     ; 1. The right room boundary is hit. So the direction is
                            	  2807:     ;    automatically reversed to up and left.
                            	  2808:     ; 2. The next frame, the top room boundary is hit.
                            	  2809:     ;    The direction is reversed to down and right.
                            	  2810:     ;
                            	  2811:     ; As you can see, an endless loop has been made.
                            	  2812:     ;
02:0003A880 41EC0451        	  2813:     lea     ($0451,A4),A0
02:0003A884 10302000        	  2814:     move.b  (A0,D2.W),D0
02:0003A888 0C000002        	  2815:     cmpi.b  #$02,D0
02:0003A88C 651E            	  2816:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A88E 41EC0098        	  2817:     lea     ($0098,A4),A0
02:0003A892 10302000        	  2818:     move.b  (A0,D2.W),D0
02:0003A896 0A000003        	  2819:     eori.b #$03,D0
02:0003A89A 41EC0098        	  2820:     lea     ($0098,A4),A0
02:0003A89E 11802000        	  2821:     move.b  D0,(A0,D2.W)
02:0003A8A2 7000            	  2822:     moveq   #0,D0
02:0003A8A4 41EC0451        	  2823:     lea     ($0451,A4),A0
02:0003A8A8 11802000        	  2824:     move.b  D0,(A0,D2.W)
                            	  2825:     even
                            	  2826: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2827:     ; If the object is a boulder, then make sure its facing direction
                            	  2828:     ; has a down vertical component.
                            	  2829:     ;
02:0003A8AC 610001F8        	  2830:     jsr     Jumper_PointBoulderDownward
                            	  2831:     ; For the given direction, get the Y offset of the destination
                            	  2832:     ; of the jump.
                            	  2833:     ;
                            	  2834:     ; Add it to the object's Y, and store this destination Y.
                            	  2835:     ;
02:0003A8B0 7600            	  2836:     moveq   #0,D3
02:0003A8B2 41EC0098        	  2837:     lea     ($0098,A4),A0
02:0003A8B6 16302000        	  2838:     move.b  (A0,D2.W),D3
02:0003A8BA 41EC0084        	  2839:     lea     ($0084,A4),A0
02:0003A8BE 10302000        	  2840:     move.b  (A0,D2.W),D0
02:0003A8C2 023C00EE        	  2841:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8C6 41F90003A7DE    	  2842:     lea     (JumperYOffsets).l,A0
02:0003A8CC 12303000        	  2843:     move.b  (A0,D3.W),D1
02:0003A8D0 D101            	  2844:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A8D2 41EC0444        	  2845:     lea     ($0444,A4),A0
02:0003A8D6 11802000        	  2846:     move.b  D0,(A0,D2.W)
                            	  2847:     ; Set the starting speed, depending on the object type.
