                            	  5547:     ; Now [$00] holds isolated door attribute.
                            	  5548:     ;
                            	  5549:     ;
                            	  5550:     ; Test mask passed in [$02] with current single-bit mask in [$01].
02:00043680 102C0002        	  5551:     move.b  ($0002,A4),D0
