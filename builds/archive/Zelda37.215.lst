02:0002DFAC 19400604        	   820:     move.b  D0,($0604,A4)
                            	   821:     ; If the high 2 bits of character element = 0, then return.
                            	   822:     ;
02:0002DFB0 1214            	   823:     move.b  ($00,A4),D1   ; ptr lo
02:0002DFB2 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
02:0002DFB6 024100FF        	   825:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002DFBA E14C            	   826:     lsl.w   #8,D4
02:0002DFBC 8841            	   827:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002DFBE 48C4            	   828:     ext.l   D4
02:0002DFC0 D8BC00FF0000    	   829:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002DFC6 2044            	   830:     movea.l D4,A0
02:0002DFC8 10303000        	   831:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
