                            	  5406: _anon_z04_70:
                            	  5407:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5408:     ; 1. negate the distance
                            	  5409:     ; 2. add 8 to the instruction offset to access
                            	  5410:     ;    the opposite direction for the same wall
                            	  5411:     ;
02:0003BB14 7600            	  5412:     moveq   #0,D3
02:0003BB16 162C0098        	  5413:     move.b  ($0098,A4),D3
02:0003BB1A 122C0002        	  5414:     move.b  ($0002,A4),D1
02:0003BB1E B601            	  5415:     cmp.b   D1,D3
02:0003BB20 662A            	  5416:     bne  _anon_z04_71
02:0003BB22 1B00            	  5417:     move.b  D0,-(A5)  ; PHA
02:0003BB24 41EC0412        	  5418:     lea     ($0412,A4),A0
02:0003BB28 10302000        	  5419:     move.b  (A0,D2.W),D0
