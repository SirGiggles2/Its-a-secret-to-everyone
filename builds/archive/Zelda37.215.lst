02:00031268 41EC0200        	  5843:     lea     ($0200,A4),A0
02:0003126C 11803000        	  5844:     move.b  D0,(A0,D3.W)
02:00031270 5202            	  5845:     addq.b  #1,D2
02:00031272 1002            	  5846:     move.b  D2,D0
02:00031274 02000007        	  5847:     andi.b #$07,D0
02:00031278 7400            	  5848:     moveq   #0,D2
02:0003127A 1400            	  5849:     move.b  D0,D2
02:0003127C 5203            	  5850:     addq.b  #1,D3
02:0003127E 0C030040        	  5851:     cmpi.b  #$40,D3
02:00031282 66DA            	  5852:     bne  _anon_z01_74
02:00031284 0A3C0001        	  5853:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031288 4E75            	  5854:     rts
