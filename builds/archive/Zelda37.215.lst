02:00039AF8 0A3C0010        	   829:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039AFC 9101            	   830:     subx.b  D1,D0   ; SBC ObjX,X
02:00039AFE 0A3C0010        	   831:     eori    #$10,CCR  ; restore X = 6502 C
