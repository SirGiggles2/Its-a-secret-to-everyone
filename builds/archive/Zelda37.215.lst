                            	  5603:     ; Load the address of second last tile in second row of PlayAreaTiles.
                            	  5604:     ; This is where we'll stop loading tiles for the room.
02:000436D6 705A            	  5605:     moveq   #90,D0
02:000436D8 19400004        	  5606:     move.b  D0,($0004,A4)
02:000436DC 7065            	  5607:     moveq   #101,D0
