02:0003BAAC 6100E11C        	  5343:     jsr     DrawObjectNotMirroredOverLink
                            	  5344:     ; Store the offsets of the sprites to show over Link
                            	  5345:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
