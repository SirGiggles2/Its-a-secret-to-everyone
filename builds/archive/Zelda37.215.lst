                            	  5378: _L_z07_SpreadShot_Draw:
                            	  5379:     ; Draw the corner.
                            	  5380:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5381:     ;
02:0004C68E 7002            	  5382:     moveq   #2,D0
02:0004C690 1940000C        	  5383:     move.b  D0,($000C,A4)
