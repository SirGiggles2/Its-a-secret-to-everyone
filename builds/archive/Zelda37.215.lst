                            	 12868:     ;
02:0003F228 194000AC        	 12869:     move.b  D0,($00AC,A4)
02:0003F22C 19400505        	 12870:     move.b  D0,($0505,A4)
02:0003F230 7020            	 12871:     moveq   #32,D0
02:0003F232 19400600        	 12872:     move.b  D0,($0600,A4)
02:0003F236 522C0445        	 12873:     addq.b  #1,($0445,A4)
                            	 12874:     even
