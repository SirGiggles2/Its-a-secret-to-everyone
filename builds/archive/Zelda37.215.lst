02:0004C714 52302000        	  5474:     addq.b  #1,(A0,D2.W)
02:0004C718 41EC00AC        	  5475:     lea     ($00AC,A4),A0
02:0004C71C 10302000        	  5476:     move.b  (A0,D2.W),D0
02:0004C720 0200000F        	  5477:     andi.b #$0F,D0
02:0004C724 0C000003        	  5478:     cmpi.b  #$03,D0
