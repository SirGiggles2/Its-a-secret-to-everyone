02:0003E6F4 102C04D7        	 11337:     move.b  ($04D7,A4),D0
02:0003E6F8 023C00EE        	 11338:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6FC 123C0007        	 11339:     move.b  #$07,D1
02:0003E700 D101            	 11340:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E702 7400            	 11341:     moveq   #0,D2
02:0003E704 1400            	 11342:     move.b  D0,D2
                            	 11343:     ; Flag it uninitialized, so that it will be initialized next frame.
