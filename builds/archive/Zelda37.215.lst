                            	  2400: ; [01] holds the q-speed of the monster
                            	  2401:     even
                            	  2402: _TryShooting:
02:0003A610 19400001        	  2403:     move.b  D0,($0001,A4)
                            	  2404:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2405:     ;
02:0003A614 41EC034F        	  2406:     lea     ($034F,A4),A0
02:0003A618 10302000        	  2407:     move.b  (A0,D2.W),D0
02:0003A61C 0C000003        	  2408:     cmpi.b  #$03,D0
02:0003A620 6726            	  2409:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A622 0C000001        	  2410:     cmpi.b  #$01,D0
02:0003A626 6720            	  2411:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A628 0C000009        	  2412:     cmpi.b  #$09,D0
02:0003A62C 671A            	  2413:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A62E 0C00000A        	  2414:     cmpi.b  #$0A,D0
02:0003A632 6714            	  2415:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A634 41EC0451        	  2416:     lea     ($0451,A4),A0
02:0003A638 10302000        	  2417:     move.b  (A0,D2.W),D0
02:0003A63C 660A            	  2418:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2419:     ; and a random value < $F8, then return.
                            	  2420:     ;
02:0003A63E 10342018        	  2421:     move.b  ($18,A4,D2.W),D0
02:0003A642 0C0000F8        	  2422:     cmpi.b  #$F8,D0
02:0003A646 656C            	  2423:     bcs  _L_z04__TryShooting_Exit
                            	  2424:     even
                            	  2425: _L_z04__TryShooting_TryShootingNow:
                            	  2426:     ; Summary
                            	  2427:     ;
                            	  2428:     ; if temporarily invincible then
                            	  2429:     ;   shoot timer := 0
                            	  2430:     ; elif shoot timer > 0 then
                            	  2431:     ;   decrement shoot timer
                            	  2432:     ; elif wants to shoot then
                            	  2433:     ;   shoot timer := $30
                            	  2434:     ;
                            	  2435:     ; qspeed := [01]
                            	  2436:     ;
                            	  2437:     ; if shoot timer <> 0 then
                            	  2438:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2439:     ;     shoot
                            	  2440:     ;     if succeeded then
                            	  2441:     ;       shoot timer := 0
                            	  2442:     ;       qspeed := 0
                            	  2443:     ;   else
                            	  2444:     ;     qspeed := 0
                            	  2445:     ;
                            	  2446:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A648 102C0001        	  2447:     move.b  ($0001,A4),D0
02:0003A64C 1883            	  2448:     move.b  D3,($0000,A4)
02:0003A64E 1B00            	  2449:     move.b  D0,-(A5)  ; PHA
02:0003A650 7600            	  2450:     moveq   #0,D3
                            	  2451:     ; If not temporarily invincible,
                            	  2452:     ;
02:0003A652 41EC04F0        	  2453:     lea     ($04F0,A4),A0
02:0003A656 10302000        	  2454:     move.b  (A0,D2.W),D0
02:0003A65A 661A            	  2455:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2456:     ; then Y := shoot timer - 1
                            	  2457:     ;
02:0003A65C 7600            	  2458:     moveq   #0,D3
02:0003A65E 41EC0451        	  2459:     lea     ($0451,A4),A0
02:0003A662 16302000        	  2460:     move.b  (A0,D2.W),D3
02:0003A666 5303            	  2461:     subq.b  #1,D3
                            	  2462:     ; If Y register < 0, then shoot timer is 0.
                            	  2463:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2464:     ; Else go set a non-zero speed and return.
                            	  2465:     ;
02:0003A668 6A0C            	  2466:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A66A 41EC0412        	  2467:     lea     ($0412,A4),A0
02:0003A66E 10302000        	  2468:     move.b  (A0,D2.W),D0
02:0003A672 6736            	  2469:     beq  _L_z04__TryShooting_SetSpeed
02:0003A674 7630            	  2470:     moveq   #48,D3
                            	  2471:     even
                            	  2472: _L_z04__TryShooting_SetShootTimer:
                            	  2473:     ; shoot timer := Y
                            	  2474:     ;
02:0003A676 1003            	  2475:     move.b  D3,D0
02:0003A678 41EC0451        	  2476:     lea     ($0451,A4),A0
02:0003A67C 11802000        	  2477:     move.b  D0,(A0,D2.W)
                            	  2478:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2479:     ;
02:0003A680 6728            	  2480:     beq  _L_z04__TryShooting_SetSpeed
                            	  2481:     ; shoot timer <> 0
                            	  2482:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2483:     ;
02:0003A682 0C030010        	  2484:     cmpi.b  #$10,D3
02:0003A686 661C            	  2485:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2486:     ; If we have the magic clock, or the monster is stunned, then
                            	  2487:     ; go set a zero speed.
                            	  2488:     ;
02:0003A688 102C066C        	  2489:     move.b  ($066C,A4),D0
02:0003A68C 1234203D        	  2490:     move.b  ($3D,A4,D2.W),D1
02:0003A690 8001            	  2491:     or.b  D1,D0
02:0003A692 6610            	  2492:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2493:     ; Shoot.
                            	  2494:     ;
02:0003A694 1014            	  2495:     move.b  ($0000,A4),D0
02:0003A696 611E            	  2496:     jsr     _ShootIfWanted2
                            	  2497:     ; If it failed, go set a non-zero speed.
                            	  2498:     ;
02:0003A698 6510            	  2499:     bcs  _L_z04__TryShooting_SetSpeed
                            	  2500:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2501:     ;
02:0003A69A 7000            	  2502:     moveq   #0,D0
02:0003A69C 41EC0412        	  2503:     lea     ($0412,A4),A0
02:0003A6A0 11802000        	  2504:     move.b  D0,(A0,D2.W)
                            	  2505:     even
                            	  2506: _L_z04__TryShooting_ZeroSpeed:
02:0003A6A4 101D            	  2507:     move.b  (A5)+,D0  ; PLA
02:0003A6A6 7000            	  2508:     moveq   #0,D0
02:0003A6A8 1B00            	  2509:     move.b  D0,-(A5)  ; PHA
                            	  2510:     even
                            	  2511: _L_z04__TryShooting_SetSpeed:
                            	  2512:     ; Set the speed to whatever was determined: 0 or the value passed in [01].
                            	  2513:     ;
02:0003A6AA 101D            	  2514:     move.b  (A5)+,D0  ; PLA
02:0003A6AC 41EC03BC        	  2515:     lea     ($03BC,A4),A0
02:0003A6B0 11802000        	  2516:     move.b  D0,(A0,D2.W)
                            	  2517:     even
