                            	  7029:     ; Store it in [00].
                            	  7030:     ;
02:0003C734 10342070        	  7031:     move.b  ($70,A4,D2.W),D0
02:0003C738 023C00EE        	  7032:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C73C 41F90003C710    	  7033:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C742 12303000        	  7034:     move.b  (A0,D3.W),D1
02:0003C746 D101            	  7035:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C748 1880            	  7036:     move.b  D0,($0000,A4)
                            	  7037:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  7038:     ; Store it in [01].
                            	  7039:     ;
02:0003C74A 41EC0084        	  7040:     lea     ($0084,A4),A0
02:0003C74E 10302000        	  7041:     move.b  (A0,D2.W),D0
02:0003C752 023C00EE        	  7042:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C756 41F90003C70A    	  7043:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C75C 12303000        	  7044:     move.b  (A0,D3.W),D1
02:0003C760 D101            	  7045:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C762 19400001        	  7046:     move.b  D0,($0001,A4)
                            	  7047:     ; Calculate sprite attributes:
                            	  7048:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7049:     ;
                            	  7050:     ; If the boss is temporarily invincible, then
                            	  7051:     ; this makes it flash by cycling all the palette rows.
                            	  7052:     ;
                            	  7053:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7054:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7055:     ;
02:0003C766 41EC04F0        	  7056:     lea     ($04F0,A4),A0
02:0003C76A 10302000        	  7057:     move.b  (A0,D2.W),D0
02:0003C76E 02000003        	  7058:     andi.b #$03,D0
02:0003C772 0A000003        	  7059:     eori.b #$03,D0
02:0003C776 19400003        	  7060:     move.b  D0,($0003,A4)
02:0003C77A 7600            	  7061:     moveq   #0,D3
02:0003C77C 162C000A        	  7062:     move.b  ($000A,A4),D3
                            	  7063:     ; Look up the tile for this sprite.
                            	  7064:     ; If it's not the first one (face), then go write the sprite record.
                            	  7065:     ;
02:0003C780 41F90003C6FE    	  7066:     lea     (AquamentusTiles).l,A0
02:0003C786 10303000        	  7067:     move.b  (A0,D3.W),D0
02:0003C78A 12390003C6FE    	  7068:     move.b  (AquamentusTiles).l,D1
02:0003C790 B001            	  7069:     cmp.b   D1,D0
02:0003C792 6610            	  7070:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7071:     ; Else it's the first one (the face tile).
                            	  7072:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7073:     ;
                            	  7074:     ; $CC/CD shows the closed mouth face.
                            	  7075:     ; $C0/C1 shows the open mouth face.
                            	  7076:     ;
02:0003C794 7600            	  7077:     moveq   #0,D3
02:0003C796 16342028        	  7078:     move.b  ($28,A4,D2.W),D3
02:0003C79A 0C030020        	  7079:     cmpi.b  #$20,D3
02:0003C79E 6404            	  7080:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C7A0 103C00C0        	  7081:     move.b  #$C0,D0
                            	  7082:     even
                            	  7083: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C7A4 610E            	  7084:     jsr     WriteBossSprite
                            	  7085:     ; Bottom of the loop.
                            	  7086:     ; Decrement tile index and loop index.
                            	  7087:     ;
02:0003C7A6 532C000A        	  7088:     subq.b  #1,($000A,A4)
02:0003C7AA 532C000B        	  7089:     subq.b  #1,($000B,A4)
02:0003C7AE 6A00FF7E        	  7090:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C7B2 4E75            	  7091:     rts
                            	  7092: 
                            	  7093: ; Params:
