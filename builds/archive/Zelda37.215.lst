                            	  5429:     ;
02:0004C6D8 41EC0098        	  5430:     lea     ($0098,A4),A0
02:0004C6DC 53302000        	  5431:     subq.b  #1,(A0,D2.W)
                            	  5432:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5433:     ;
