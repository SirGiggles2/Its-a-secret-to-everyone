                            	   779: UpdateBlock0Idle:
                            	   780:     ; If there are monsters in the room, go reset the push timer and return.
                            	   781:     ;
02:00039A8E 102C034D        	   782:     move.b  ($034D,A4),D0
02:00039A92 6604            	   783:     bne.s  __far_z_04_0005
02:00039A94 600000DA        	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0005:
                            	   786:     ; If Link's X is aligned with the block's, then get the difference
                            	   787:     ; between Link's (Y + 3) and the block's Y.
                            	   788:     ; Then go test the difference.
                            	   789:     ;
02:00039A98 102C0070        	   790:     move.b  ($0070,A4),D0
02:00039A9C 12342070        	   791:     move.b  ($70,A4,D2.W),D1
02:00039AA0 B001            	   792:     cmp.b   D1,D0
02:00039AA2 6628            	   793:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039AA4 7600            	   794:     moveq   #0,D3
02:00039AA6 102C0084        	   795:     move.b  ($0084,A4),D0
02:00039AAA 023C00EE        	   796:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039AAE 123C0003        	   797:     move.b  #$03,D1
02:00039AB2 D101            	   798:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039AB4 003C0011        	   799:     ori     #$11,CCR  ; SEC: set C+X
02:00039AB8 41EC0084        	   800:     lea     ($0084,A4),A0
02:00039ABC 12302000        	   801:     move.b  (A0,D2.W),D1
02:00039AC0 0A3C0010        	   802:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039AC4 9101            	   803:     subx.b  D1,D0   ; SBC ObjY,X
02:00039AC6 0A3C0010        	   804:     eori    #$10,CCR  ; restore X = 6502 C
02:00039ACA 6036            	   805:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   806: 
                            	   807:     even
                            	   808: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   809:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   810:     ; go reset the push timer.
                            	   811:     ;
02:00039ACC 102C0084        	   812:     move.b  ($0084,A4),D0
02:00039AD0 023C00EE        	   813:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039AD4 123C0003        	   814:     move.b  #$03,D1
02:00039AD8 D101            	   815:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039ADA 41EC0084        	   816:     lea     ($0084,A4),A0
02:00039ADE 12302000        	   817:     move.b  (A0,D2.W),D1
02:00039AE2 B001            	   818:     cmp.b   D1,D0
02:00039AE4 6704            	   819:     beq.s  __far_z_04_0006
02:00039AE6 60000088        	   820:     jmp  ResetPushTimer
                            	   821: __far_z_04_0006:
                            	   822:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   823:     ; Get the difference in X.
                            	   824:     ;
02:00039AEA 7602            	   825:     moveq   #2,D3
02:00039AEC 102C0070        	   826:     move.b  ($0070,A4),D0
02:00039AF0 003C0011        	   827:     ori     #$11,CCR  ; SEC: set C+X
