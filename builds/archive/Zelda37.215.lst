                            	  6137: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  6138:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  6139:     ;
02:0003C096 7004            	  6140:     moveq   #4,D0
02:0003C098 1880            	  6141:     move.b  D0,($0000,A4)
                            	  6142:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6143:     ;
02:0003C09A 7600            	  6144:     moveq   #0,D3
02:0003C09C 0C020005        	  6145:     cmpi.b  #$05,D2
02:0003C0A0 6702            	  6146:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C0A2 7605            	  6147:     moveq   #5,D3
                            	  6148:     even
                            	  6149: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6150:     ; Copy old direction from a higher slot to the lower one;
