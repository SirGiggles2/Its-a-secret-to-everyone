02:0003DE54 122C0002        	 10165:     move.b  ($0002,A4),D1
02:0003DE58 C200            	 10166:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE5A 6708            	 10167:     beq  _anon_z04_120
