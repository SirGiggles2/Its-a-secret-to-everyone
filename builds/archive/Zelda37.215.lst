02:00031C9C 023C00EE        	  7057:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031CA0 123C0004        	  7058:     move.b  #$04,D1
02:00031CA4 D101            	  7059:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031CA6 19400004        	  7060:     move.b  D0,($0004,A4)
                            	  7061:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  7062:     ;
02:00031CAA 41EC0084        	  7063:     lea     ($0084,A4),A0
02:00031CAE 10303000        	  7064:     move.b  (A0,D3.W),D0
02:00031CB2 023C00EE        	  7065:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031CB6 123C0008        	  7066:     move.b  #$08,D1
02:00031CBA D101            	  7067:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7068: ; Params:
                            	  7069: ; A: weapon object mid Y
                            	  7070: ; X: monster object slot
                            	  7071: ; Y: weapon object slot
                            	  7072: ; [00]: weapon object slot
                            	  7073: ; [02]: monster object mid X
                            	  7074: ; [03]: monster object mid Y
                            	  7075: ; [04]: weapon object mid X
                            	  7076: ; [07]: damage points
                            	  7077: ; [09]: damage type
                            	  7078: ; [0D]: horizontal threshold
                            	  7079: ; [0E]: vertical threshold
                            	  7080: ;
