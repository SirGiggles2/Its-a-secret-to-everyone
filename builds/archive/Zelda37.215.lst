02:0004B16E 0C000046        	  2391:     cmpi.b  #$46,D0
02:0004B172 6530            	  2392:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B174 0C0000F3        	  2393:     cmpi.b  #$F3,D0
