02:0003AF02 6702            	  3652:     beq  _L_z04_UpdateOctorock_Shoot
02:0003AF04 E308            	  3653:     lsl.b  #1,D0   ; ASL A
                            	  3654:     even
                            	  3655: _L_z04_UpdateOctorock_Shoot:
                            	  3656:     ; Shoot a flying rock (object type $53).
                            	  3657:     ;
02:0003AF06 7653            	  3658:     moveq   #83,D3
