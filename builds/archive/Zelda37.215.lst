02:0003DE3A 19410002        	 10154:     move.b  D1,($0002,A4)
02:0003DE3E 122C0002        	 10155:     move.b  ($0002,A4),D1
02:0003DE42 C200            	 10156:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE44 6704            	 10157:     beq  _anon_z04_119
