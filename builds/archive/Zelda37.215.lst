02:0004CB7E 0200000F        	  6108:     andi.b #$0F,D0
02:0004CB82 7600            	  6109:     moveq   #0,D3
02:0004CB84 1600            	  6110:     move.b  D0,D3
02:0004CB86 7000            	  6111:     moveq   #0,D0
