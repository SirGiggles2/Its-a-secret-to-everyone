                            	  3845: SecretArmosXs:
02:0003B032 E0              	  3846:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B033 B0
02:0003B034 B0
02:0003B035 30
02:0003B036 40
02:0003B037 90
02:0003B038 A0
