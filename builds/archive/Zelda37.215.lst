                            	  3148:     ; Call GetOppositeDir again to use this mapping:
                            	  3149:     ; In Dir: 1 2 4 8
                            	  3150:     ;         -------
                            	  3151:     ; Index:  2 3 0 1
                            	  3152:     ;
02:00041B4E 4EB90003093E    	  3153:     jsr     GetOppositeDir
                            	  3154:     ; Get the appropriate coordinate for the direction:
                            	  3155:     ; X for horizontal
                            	  3156:     ; Y for vertical
                            	  3157:     ;
02:00041B54 102C0070        	  3158:     move.b  ($0070,A4),D0
02:00041B58 0C030002        	  3159:     cmpi.b  #$02,D3
02:00041B5C 6404            	  3160:     bcc  _anon_z05_74
02:00041B5E 102C0084        	  3161:     move.b  ($0084,A4),D0
                            	  3162: _anon_z05_74:
02:00041B62 19400002        	  3163:     move.b  D0,($0002,A4)
                            	  3164:     ; Mask A button and directions if inner border is crossed.
                            	  3165:     ;
02:00041B66 1003            	  3166:     move.b  D3,D0
