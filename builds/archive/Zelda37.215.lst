                            	  7486: Dodongo_TryEatBomb:
                            	  7487:     ; Try to eat the bomb.
                            	  7488:     ;
                            	  7489:     ; If the bomb is not in range of the monster, then return.
                            	  7490:     ;
                            	  7491:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7492:     ;
02:0003CA92 7601            	  7493:     moveq   #1,D3
02:0003CA94 616E            	  7494:     jsr     Dodongo_IsBombInRange
02:0003CA96 6666            	  7495:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7496:     ; Will loop from 1 to 0, indexed by [00].
                            	  7497:     ;
02:0003CA98 7001            	  7498:     moveq   #1,D0
02:0003CA9A 1880            	  7499:     move.b  D0,($0000,A4)
                            	  7500:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7501:     ;
02:0003CA9C 41EC0098        	  7502:     lea     ($0098,A4),A0
02:0003CAA0 10302000        	  7503:     move.b  (A0,D2.W),D0
02:0003CAA4 E208            	  7504:     lsr.b  #1,D0   ; LSR A
02:0003CAA6 7600            	  7505:     moveq   #0,D3
02:0003CAA8 1600            	  7506:     move.b  D0,D3
                            	  7507:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7508:     ; position depends on the orientation of the monster.
                            	  7509:     ;
                            	  7510:     ; Start with the horizontal distance.
                            	  7511:     ;
02:0003CAAA 102C0004        	  7512:     move.b  ($0004,A4),D0
                            	  7513:     even
                            	  7514: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7515:     ; Look up the limits for the given direction.
                            	  7516:     ;
                            	  7517:     ; If the distance from the bomb < negative limit,
                            	  7518:     ; or >= positive limit, then return.
                            	  7519:     ;
                            	  7520:     ; Note that these are simple signed comparisons that work,
                            	  7521:     ; because the operands are in a small range.
                            	  7522:     ;
02:0003CAAE 41F90003C9E8    	  7523:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CAB4 12303000        	  7524:     move.b  (A0,D3.W),D1
02:0003CAB8 B001            	  7525:     cmp.b   D1,D0
02:0003CABA 6B42            	  7526:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CABC 41F90003C9EE    	  7527:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CAC2 12303000        	  7528:     move.b  (A0,D3.W),D1
02:0003CAC6 B001            	  7529:     cmp.b   D1,D0
02:0003CAC8 6A34            	  7530:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7531:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7532:     ;
02:0003CACA 1003            	  7533:     move.b  D3,D0
02:0003CACC 023C00EE        	  7534:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAD0 123C000A        	  7535:     move.b  #$0A,D1
02:0003CAD4 D101            	  7536:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CAD6 7600            	  7537:     moveq   #0,D3
02:0003CAD8 1600            	  7538:     move.b  D0,D3
                            	  7539:     ; Bottom of the loop.
                            	  7540:     ;
                            	  7541:     ; Load the vertical distance for the next iteration.
                            	  7542:     ; Decrement loop counter.
                            	  7543:     ;
02:0003CADA 102C0005        	  7544:     move.b  ($0005,A4),D0
02:0003CADE 5314            	  7545:     subq.b  #1,($0000,A4)
02:0003CAE0 6ACC            	  7546:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7547:     ; If we get here, then the bomb was within range of the mouth.
                            	  7548:     ; Go to state 1 (bloated).
                            	  7549:     ;
02:0003CAE2 41EC00AC        	  7550:     lea     ($00AC,A4),A0
02:0003CAE6 52302000        	  7551:     addq.b  #1,(A0,D2.W)
                            	  7552:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7553:     ;
02:0003CAEA 7610            	  7554:     moveq   #16,D3
02:0003CAEC 7000            	  7555:     moveq   #0,D0
02:0003CAEE 41EC00AC        	  7556:     lea     ($00AC,A4),A0
02:0003CAF2 11803000        	  7557:     move.b  D0,(A0,D3.W)
02:0003CAF6 41EC042C        	  7558:     lea     ($042C,A4),A0
02:0003CAFA 11802000        	  7559:     move.b  D0,(A0,D2.W)
                            	  7560:     even
