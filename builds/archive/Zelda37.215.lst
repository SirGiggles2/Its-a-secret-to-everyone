                            	   195: InitCave:
                            	   196:     ; The person goes at location ($78, $80).
                            	   197:     ;
02:0002DB4A 7078            	   198:     moveq   #120,D0
02:0002DB4C 163C0080        	   199:     move.b  #$80,D3
02:0002DB50 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
                            	   203:     ;
02:0002DB54 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DB58 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DB5C 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DB5E 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DB62 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DB64 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DB68 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DB6A 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DB6E 6502            	   212:     bcs.s  __far_z_01_0000
02:0002DB70 6012            	   213:     jmp  InitCaveContinue
                            	   214: __far_z_01_0000:
                            	   215:     even
                            	   216: _L_z01_InitCave_TakeType:
                            	   217:     ; Else the cave/person simply does:
                            	   218:     ; - taken:     no person, no text
                            	   219:     ; - not taken: show a person and text
                            	   220:     ;
                            	   221:     ; So, if the item was not taken, then go set up the text.
                            	   222:     ;
02:0002DB72 610032EA        	   223:     jsr     GetRoomFlagUWItemState
02:0002DB76 6602            	   224:     bne.s  __far_z_01_0001
02:0002DB78 600A            	   225:     jmp  InitCaveContinue
                            	   226: __far_z_01_0001:
                            	   227:     ; Otherwise destroy the person object, and let Link continue.
                            	   228:     ;
02:0002DB7A 7000            	   229:     moveq   #0,D0
02:0002DB7C 19400350        	   230:     move.b  D0,($0350,A4)
                            	   231:     even
                            	   232: UnhaltLink:
02:0002DB80 6000DE6C        	   233:     jmp     c_unhalt_link
                            	   234: 
                            	   235: InitCaveContinue:
                            	   236:     ; Get this cave's index (object type - $6A).
                            	   237:     ;
02:0002DB84 102C0350        	   238:     move.b  ($0350,A4),D0
02:0002DB88 003C0011        	   239:     ori     #$11,CCR  ; SEC: set C+X
02:0002DB8C 123C006A        	   240:     move.b  #$6A,D1
02:0002DB90 0A3C0010        	   241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DB94 9101            	   242:     subx.b  D1,D0   ; SBC #$6A
02:0002DB96 0A3C0010        	   243:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DB9A 7600            	   244:     moveq   #0,D3
02:0002DB9C 1600            	   245:     move.b  D0,D3
                            	   246:     ; Get the person text selector by looking up the text selector byte
                            	   247:     ; for this index, and masking it with $3F.
                            	   248:     ;
02:0002DB9E 41F90002DB1C    	   249:     lea     (OverworldPersonTextSelectors).l,A0
02:0002DBA4 10303000        	   250:     move.b  (A0,D3.W),D0
02:0002DBA8 1B00            	   251:     move.b  D0,-(A5)  ; PHA
02:0002DBAA 0200003F        	   252:     andi.b #$3F,D0
02:0002DBAE 19400415        	   253:     move.b  D0,($0415,A4)
                            	   254:     ; Pop and mask the text selector byte with $C0 to get the
                            	   255:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   256:     ;
02:0002DBB2 101D            	   257:     move.b  (A5)+,D0  ; PLA
02:0002DBB4 020000C0        	   258:     andi.b #$C0,D0
02:0002DBB8 19400003        	   259:     move.b  D0,($0003,A4)
                            	   260:     ; At this point, the Y register still has the cave index.
                            	   261:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   262:     ;
02:0002DBBC 103C00FD        	   263:     move.b  #$FD,D0
                            	   264: _anon_z01_0:
02:0002DBC0 023C00EE        	   265:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DBC4 123C0003        	   266:     move.b  #$03,D1
02:0002DBC8 D101            	   267:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002DBCA 5303            	   268:     subq.b  #1,D3
02:0002DBCC 6AF2            	   269:     bpl  _anon_z01_0
02:0002DBCE 7600            	   270:     moveq   #0,D3
02:0002DBD0 1600            	   271:     move.b  D0,D3
                            	   272:     ; Loop over the wares from 0 to 2.
                            	   273:     ;
02:0002DBD2 7400            	   274:     moveq   #0,D2
                            	   275:     even
                            	   276: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   277:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   278:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   279:     ;
02:0002DBD4 41F900FF6A7E    	   280:     lea     (NES_SRAM+$0A7E).l,A0
02:0002DBDA 10303000        	   281:     move.b  (A0,D3.W),D0
02:0002DBDE 41EC0422        	   282:     lea     ($0422,A4),A0
02:0002DBE2 11802000        	   283:     move.b  D0,(A0,D2.W)
                            	   284:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   285:     ;
02:0002DBE6 020000C0        	   286:     andi.b #$C0,D0
02:0002DBEA 19802000        	   287:     move.b  D0,($00,A4,D2.W)
                            	   288:     ; Copy 3 prices from the Cave level block info.
                            	   289:     ;
02:0002DBEE 41F900FF6ABA    	   290:     lea     (NES_SRAM+$0ABA).l,A0
02:0002DBF4 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002DBF8 41EC0430        	   292:     lea     ($0430,A4),A0
02:0002DBFC 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Bottom of the wares copying loop.
                            	   295:     ;
02:0002DC00 5203            	   296:     addq.b  #1,D3
02:0002DC02 5202            	   297:     addq.b  #1,D2
02:0002DC04 0C020003        	   298:     cmpi.b  #$03,D2
02:0002DC08 66CA            	   299:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   300:     ; Get the top 2 bits of text selector byte in [03],
                            	   301:     ; shift them to the bottom, and combine them with [00].
                            	   302:     ;
02:0002DC0A 102C0003        	   303:     move.b  ($0003,A4),D0
02:0002DC0E E308            	   304:     lsl.b  #1,D0   ; ASL A
02:0002DC10 E310            	   305:     roxl.b  #1,D0   ; ROL A
02:0002DC12 E310            	   306:     roxl.b  #1,D0   ; ROL A
02:0002DC14 1214            	   307:     move.b  ($0000,A4),D1
02:0002DC16 8001            	   308:     or.b  D1,D0
02:0002DC18 1880            	   309:     move.b  D0,($0000,A4)
                            	   310:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   311:     ; and combine them with [00].
                            	   312:     ;
02:0002DC1A 102C0002        	   313:     move.b  ($0002,A4),D0
02:0002DC1E E208            	   314:     lsr.b  #1,D0   ; LSR A
02:0002DC20 E208            	   315:     lsr.b  #1,D0   ; LSR A
02:0002DC22 E208            	   316:     lsr.b  #1,D0   ; LSR A
