                            	 12114: L12A6F_Exit:
02:0003ED0C 4E75            	 12115:     rts
                            	 12116: 
                            	 12117:     even
                            	 12118: Lamnola_UpdateHead:
                            	 12119:     ; If X coordinate is not a multiple of 8, then return.
                            	 12120:     ;
02:0003ED0E 10342070        	 12121:     move.b  ($70,A4,D2.W),D0
02:0003ED12 02000007        	 12122:     andi.b #$07,D0
02:0003ED16 6702            	 12123:     beq.s  __far_z_04_0123
02:0003ED18 60F2            	 12124:     jmp  L12A6F_Exit
                            	 12125: __far_z_04_0123:
                            	 12126:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12127:     ; We had to account for the usual offset of 3.
                            	 12128:     ;
02:0003ED1A 41EC0084        	 12129:     lea     ($0084,A4),A0
02:0003ED1E 10302000        	 12130:     move.b  (A0,D2.W),D0
02:0003ED22 023C00EE        	 12131:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED26 123C0003        	 12132:     move.b  #$03,D1
02:0003ED2A D101            	 12133:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED2C 02000007        	 12134:     andi.b #$07,D0
02:0003ED30 6702            	 12135:     beq.s  __far_z_04_0124
02:0003ED32 60D8            	 12136:     jmp  L12A6F_Exit
                            	 12137: __far_z_04_0124:
                            	 12138:     ; Will loop 4 times, propagating directions down the chain,
                            	 12139:     ; by pulling from the bottom.
                            	 12140:     ;
02:0003ED34 7004            	 12141:     moveq   #4,D0
02:0003ED36 1880            	 12142:     move.b  D0,($0000,A4)
                            	 12143:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12144:     ;
02:0003ED38 7600            	 12145:     moveq   #0,D3
02:0003ED3A 0C020005        	 12146:     cmpi.b  #$05,D2
02:0003ED3E 6702            	 12147:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED40 7605            	 12148:     moveq   #5,D3
                            	 12149:     even
                            	 12150: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12151:     ; Loop over every segment under the head, starting from the tail.
                            	 12152:     ; Copy the next segment's direction to the current one in this loop.
                            	 12153:     ;
02:0003ED42 41EC009A        	 12154:     lea     ($009A,A4),A0
02:0003ED46 10303000        	 12155:     move.b  (A0,D3.W),D0
02:0003ED4A 41EC0099        	 12156:     lea     ($0099,A4),A0
02:0003ED4E 11803000        	 12157:     move.b  D0,(A0,D3.W)
02:0003ED52 5203            	 12158:     addq.b  #1,D3
02:0003ED54 5314            	 12159:     subq.b  #1,($0000,A4)
02:0003ED56 66EA            	 12160:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12161:     ; If this head segment is not aligned with a square, then return.
                            	 12162:     ;
02:0003ED58 10342070        	 12163:     move.b  ($70,A4,D2.W),D0
02:0003ED5C 0200000F        	 12164:     andi.b #$0F,D0
02:0003ED60 660000BA        	 12165:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12166:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12167:     ; We had to account for the usual offset of 3.
                            	 12168:     ;
02:0003ED64 41EC0084        	 12169:     lea     ($0084,A4),A0
02:0003ED68 10302000        	 12170:     move.b  (A0,D2.W),D0
02:0003ED6C 023C00EE        	 12171:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED70 123C0003        	 12172:     move.b  #$03,D1
02:0003ED74 D101            	 12173:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED76 0200000F        	 12174:     andi.b #$0F,D0
02:0003ED7A 660000A0        	 12175:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12176:     ; Store the opposite of the facing direction in [00].
                            	 12177:     ;
02:0003ED7E 41EC0098        	 12178:     lea     ($0098,A4),A0
02:0003ED82 10302000        	 12179:     move.b  (A0,D2.W),D0
02:0003ED86 E208            	 12180:     lsr.b  #1,D0   ; LSR A
02:0003ED88 02000005        	 12181:     andi.b #$05,D0
02:0003ED8C 1880            	 12182:     move.b  D0,($0000,A4)
02:0003ED8E 41EC0098        	 12183:     lea     ($0098,A4),A0
02:0003ED92 10302000        	 12184:     move.b  (A0,D2.W),D0
02:0003ED96 E308            	 12185:     lsl.b  #1,D0   ; ASL A
02:0003ED98 0200000A        	 12186:     andi.b #$0A,D0
02:0003ED9C 1214            	 12187:     move.b  ($0000,A4),D1
02:0003ED9E 8001            	 12188:     or.b  D1,D0
                            	 12189:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12190:     ;
02:0003EDA0 0A00000F        	 12191:     eori.b #$0F,D0
02:0003EDA4 1940050F        	 12192:     move.b  D0,($050F,A4)
                            	 12193:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12194:     ;
02:0003EDA8 10342018        	 12195:     move.b  ($18,A4,D2.W),D0
02:0003EDAC 0C000080        	 12196:     cmpi.b  #$80,D0
02:0003EDB0 656C            	 12197:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12198:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12199:     ; Load the monster's facing direction.
                            	 12200:     ;
02:0003EDB2 41EC0098        	 12201:     lea     ($0098,A4),A0
02:0003EDB6 10302000        	 12202:     move.b  (A0,D2.W),D0
                            	 12203:     ; Load the next random number into Y register.
                            	 12204:     ;
02:0003EDBA 7600            	 12205:     moveq   #0,D3
02:0003EDBC 16342019        	 12206:     move.b  ($19,A4,D2.W),D3
                            	 12207:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12208:     ; to keep moving straight.
                            	 12209:     ;
02:0003EDC0 0C030080        	 12210:     cmpi.b  #$80,D3
02:0003EDC4 6418            	 12211:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12212:     even
                            	 12213: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12214:     ; Loop to rotate the direction bit over the mask.
                            	 12215:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12216:     ; facing direction.
                            	 12217:     ;
                            	 12218:     ; Shift right the copy of the direction.
                            	 12219:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12220:     ;
02:0003EDC6 E208            	 12221:     lsr.b  #1,D0   ; LSR A
02:0003EDC8 6402            	 12222:     bcc  _anon_z04_151
02:0003EDCA 7008            	 12223:     moveq   #8,D0
                            	 12224: _anon_z04_151:
                            	 12225:     ; If the current direction bit is masked off, then we've reached
                            	 12226:     ; the opposite direction. Loop again.
                            	 12227:     ;
02:0003EDCC 122C050F        	 12228:     move.b  ($050F,A4),D1
02:0003EDD0 C200            	 12229:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDD2 67F2            	 12230:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12231:     ; If Y register >= $40, then break out of the loop.
                            	 12232:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12233:     ;
02:0003EDD4 0C030040        	 12234:     cmpi.b  #$40,D3
02:0003EDD8 6404            	 12235:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12236:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12237:     ; and loop again now.
                            	 12238:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12239:     ;
02:0003EDDA 7640            	 12240:     moveq   #64,D3
02:0003EDDC 65E8            	 12241:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12242:     even
                            	 12243: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12244:     ; Change the facing direction to the direction found.
                            	 12245:     ;
02:0003EDDE 41EC0098        	 12246:     lea     ($0098,A4),A0
02:0003EDE2 11802000        	 12247:     move.b  D0,(A0,D2.W)
                            	 12248:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12249:     ;
02:0003EDE6 1940000F        	 12250:     move.b  D0,($000F,A4)
02:0003EDEA 4EB900030844    	 12251:     jsr     BoundByRoom
                            	 12252:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12253:     ;
02:0003EDF0 102C000F        	 12254:     move.b  ($000F,A4),D0
02:0003EDF4 6618            	 12255:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12256:     even
                            	 12257: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12258:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12259:     ; for looking for any non-opposite direction that is not blocked.
                            	 12260:     ;
02:0003EDF6 41EC0098        	 12261:     lea     ($0098,A4),A0
02:0003EDFA 10302000        	 12262:     move.b  (A0,D2.W),D0
                            	 12263:     even
                            	 12264: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12265:     ; Shift right the copy of the direction.
                            	 12266:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12267:     ;
02:0003EDFE E208            	 12268:     lsr.b  #1,D0   ; LSR A
02:0003EE00 6402            	 12269:     bcc  _anon_z04_152
02:0003EE02 7008            	 12270:     moveq   #8,D0
                            	 12271: _anon_z04_152:
                            	 12272:     ; If the current direction bit is not masked off, then go check the
                            	 12273:     ; room boundary in this direction.
                            	 12274:     ; Else we've reached the opposite direction. Loop again.
                            	 12275:     ;
02:0003EE04 122C050F        	 12276:     move.b  ($050F,A4),D1
02:0003EE08 C200            	 12277:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE0A 66D2            	 12278:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE0C 67F0            	 12279:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12280:     even
                            	 12281: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12282:     ; We found a direction that was not blocked by the room boundary.
                            	 12283:     ; Check tile collision. If blocked by a tile, then go look for another direction.
