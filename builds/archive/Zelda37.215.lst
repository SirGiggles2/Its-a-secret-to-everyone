                            	  2142:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2143:     ; 0 or 1 time, instead of 2.
                            	  2144:     ;
                            	  2145:     ; This, in turn, means that the distance between Link and the
                            	  2146:     ; fireball was >= $18 in at least one axis.
                            	  2147:     ;
