                            	  4219: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4220:     ; If the current heart's state <> 0, then go move it.
                            	  4221:     ; Else we have to wait for it to come out at the right time.
                            	  4222:     ;
02:0003B268 41EC00AC        	  4223:     lea     ($00AC,A4),A0
02:0003B26C 10302000        	  4224:     move.b  (A0,D2.W),D0
02:0003B270 667C            	  4225:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4226:     ; The current heart's state = 0.
                            	  4227:     ;
                            	  4228:     ; If object slot = 2, then go make it appear. This is the first
                            	  4229:     ; heart to show up.
                            	  4230:     ;
02:0003B272 0C020002        	  4231:     cmpi.b  #$02,D2
02:0003B276 6732            	  4232:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4233:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4234:     ; go start over.
                            	  4235:     ;
                            	  4236:     ; TODO:
                            	  4237:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4238:     ;
02:0003B278 102C00AE        	  4239:     move.b  ($00AE,A4),D0
02:0003B27C 67EA            	  4240:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4241:     ; Look up the starting angle of this heart with the index
                            	  4242:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4243:     ; then loop again.
                            	  4244:     ;
02:0003B27E 1002            	  4245:     move.b  D2,D0
02:0003B280 003C0011        	  4246:     ori     #$11,CCR  ; SEC: set C+X
02:0003B284 123C0003        	  4247:     move.b  #$03,D1
02:0003B288 0A3C0010        	  4248:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B28C 9101            	  4249:     subx.b  D1,D0   ; SBC #$03
02:0003B28E 0A3C0010        	  4250:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B292 7600            	  4251:     moveq   #0,D3
02:0003B294 1600            	  4252:     move.b  D0,D3
02:0003B296 102C0396        	  4253:     move.b  ($0396,A4),D0
02:0003B29A 41F90003B25E    	  4254:     lea     (PondHeartStartAngles).l,A0
02:0003B2A0 12303000        	  4255:     move.b  (A0,D3.W),D1
02:0003B2A4 B001            	  4256:     cmp.b   D1,D0
02:0003B2A6 66000086        	  4257:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
