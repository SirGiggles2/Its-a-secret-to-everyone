02:00031C8E 700A            	  7051:     moveq   #10,D0
02:00031C90 1940000D        	  7052:     move.b  D0,($000D,A4)
02:00031C94 1940000E        	  7053:     move.b  D0,($000E,A4)
                            	  7054:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  7055:     ;
