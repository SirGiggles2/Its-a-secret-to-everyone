02:0003DE8E 41EC0412        	 10192:     lea     ($0412,A4),A0
02:0003DE92 11802000        	 10193:     move.b  D0,(A0,D2.W)
02:0003DE96 61001E72        	 10194:     jsr     ReverseObjDir8
02:0003DE9A 41EC045E        	 10195:     lea     ($045E,A4),A0
02:0003DE9E 10302000        	 10196:     move.b  (A0,D2.W),D0
02:0003DEA2 41EC045E        	 10197:     lea     ($045E,A4),A0
02:0003DEA6 52302000        	 10198:     addq.b  #1,(A0,D2.W)
                            	 10199:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10200:     ; should randomly change direction.
