02:00031B5C 522C000C        	  6895:     addq.b  #1,($000C,A4)
                            	  6896:     ; Unpack the damage points for the monster's type.
                            	  6897:     ; The low nibble is the high byte.
                            	  6898:     ; (Damage points byte AND $F0) is the low byte.
                            	  6899:     ;
02:00031B60 7600            	  6900:     moveq   #0,D3
02:00031B62 41EC034F        	  6901:     lea     ($034F,A4),A0
02:00031B66 16302000        	  6902:     move.b  (A0,D2.W),D3
02:00031B6A 41F9000319CC    	  6903:     lea     (ObjTypeToDamagePoints).l,A0
02:00031B70 10303000        	  6904:     move.b  (A0,D3.W),D0
02:00031B74 1B00            	  6905:     move.b  D0,-(A5)  ; PHA
02:00031B76 0200000F        	  6906:     andi.b #$0F,D0
02:00031B7A 1940000D        	  6907:     move.b  D0,($000D,A4)
02:00031B7E 101D            	  6908:     move.b  (A5)+,D0  ; PLA
02:00031B80 020000F0        	  6909:     andi.b #$F0,D0
02:00031B84 1940000E        	  6910:     move.b  D0,($000E,A4)
                            	  6911: ; Params:
                            	  6912: ; X: object index of the attacker
                            	  6913: ; [0D]: damage points high byte
                            	  6914: ; [0E]: damage points low byte
                            	  6915: ;
                            	  6916: ;
                            	  6917: ; If object type is not whirlwind, then make the "hurt" sound effect.
