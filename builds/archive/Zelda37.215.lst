                            	  5822: LayOutDoors:
                            	  5823:     ; Copies the right door face for the direction, type, and state
                            	  5824:     ; of the door to the play area tile map.
                            	  5825:     ;
                            	  5826:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5827:     ; that are not true doors.
                            	  5828:     ;
02:000438B4 7403            	  5829:     moveq   #3,D2
                            	  5830:     even
                            	  5831: L_LayOutDoors_LoopDoors:
                            	  5832:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5833:     ;
02:000438B6 7001            	  5834:     moveq   #1,D0
                            	  5835:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5836:     ;
                            	  5837:     ; [06] indicates whether we're handling the first half of
                            	  5838:     ; the door: Left half for N/S, Top half for E/W.
                            	  5839:     ;
02:000438B8 19400006        	  5840:     move.b  D0,($0006,A4)
                            	  5841:     even
                            	  5842: L_LayOutDoors_LoopHalves:
02:000438BC 1002            	  5843:     move.b  D2,D0
02:000438BE 1B00            	  5844:     move.b  D0,-(A5)  ; PHA
02:000438C0 1940000B        	  5845:     move.b  D0,($000B,A4)
02:000438C4 41F900043890    	  5846:     lea     (DoorBits).l,A0
02:000438CA 10302000        	  5847:     move.b  (A0,D2.W),D0
02:000438CE 19400002        	  5848:     move.b  D0,($0002,A4)
02:000438D2 6100FD4A        	  5849:     jsr     FindDoorAttrByDoorBit
                            	  5850:     ; Begin looking for the door face for the door attribute.
                            	  5851:     ; In general, use the door type as the provisional face;
                            	  5852:     ; except turn 4 into 8.
                            	  5853:     ;
02:000438D6 0C000005        	  5854:     cmpi.b  #$05,D0
02:000438DA 642A            	  5855:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000438DC 0C000004        	  5856:     cmpi.b  #$04,D0
02:000438E0 6608            	  5857:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:000438E2 7008            	  5858:     moveq   #8,D0
02:000438E4 6620            	  5859:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5860:     even
                            	  5861: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5862:     ; We jump here if the door type is bombable and was opened.
                            	  5863:     ; Change the provisional door face to value 9, which
                            	  5864:     ; will become the "hole in the wall".
                            	  5865:     ;
02:000438E6 7009            	  5866:     moveq   #9,D0
02:000438E8 665A            	  5867:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5868:     even
                            	  5869: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5870:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5871:     ; the mask of opened doors, because this is not a true door.
                            	  5872:     ;
02:000438EA 1B00            	  5873:     move.b  D0,-(A5)  ; PHA
02:000438EC 102C0002        	  5874:     move.b  ($0002,A4),D0
02:000438F0 4600            	  5875:     eori.b #$FF,D0
02:000438F2 122C00EE        	  5876:     move.b  ($00EE,A4),D1
02:000438F6 C001            	  5877:     and.b  D1,D0
02:000438F8 194000EE        	  5878:     move.b  D0,($00EE,A4)
02:000438FC 101D            	  5879:     move.b  (A5)+,D0  ; PLA
                            	  5880:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5881:     ;
02:000438FE 0C000001        	  5882:     cmpi.b  #$01,D0
02:00043902 6402            	  5883:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043904 7004            	  5884:     moveq   #4,D0
                            	  5885:     even
                            	  5886: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5887:     ; The door attribute (DA) has been mapped to a
                            	  5888:     ; provisional door face value (PF) in %A as follows:
                            	  5889:     ;
                            	  5890:     ; DA PF Meaning
                            	  5891:     ; -------------
                            	  5892:     ; 0  4  open
                            	  5893:     ; 1  1  wall
                            	  5894:     ; 2  2  false wall
                            	  5895:     ; 3  3  false wall 2
                            	  5896:     ; 4  8  bombable
                            	  5897:     ; 5  5  key
                            	  5898:     ; 6  6  key 2
                            	  5899:     ; 7  7  shutter
                            	  5900:     ;
                            	  5901:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5902:     ; has been cleared, if the type was "open" or any wall.
                            	  5903:     ;
                            	  5904:     ;
                            	  5905:     ; Save the provisional face.
02:00043906 1B00            	  5906:     move.b  D0,-(A5)  ; PHA
                            	  5907:     ; If the current direction points to a door that has been opened,
                            	  5908:     ; then see if we need to set door flags.
                            	  5909:     ;
02:00043908 102C00EE        	  5910:     move.b  ($00EE,A4),D0
02:0004390C 122C0002        	  5911:     move.b  ($0002,A4),D1
02:00043910 C001            	  5912:     and.b  D1,D0
02:00043912 7400            	  5913:     moveq   #0,D2
02:00043914 1400            	  5914:     move.b  D0,D2
02:00043916 101D            	  5915:     move.b  (A5)+,D0  ; PLA
02:00043918 122C0002        	  5916:     move.b  ($0002,A4),D1
02:0004391C B401            	  5917:     cmp.b   D1,D2
02:0004391E 6624            	  5918:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5919:     ; The current direction points to a door that has been opened.
                            	  5920:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5921:     ;
                            	  5922:     ;
                            	  5923:     ; Save provisional door face in Y register.
02:00043920 7600            	  5924:     moveq   #0,D3
02:00043922 1600            	  5925:     move.b  D0,D3
02:00043924 101D            	  5926:     move.b  (A5)+,D0  ; PLA
02:00043926 1B00            	  5927:     move.b  D0,-(A5)  ; PHA
02:00043928 7400            	  5928:     moveq   #0,D2
02:0004392A 1400            	  5929:     move.b  D0,D2
02:0004392C 1003            	  5930:     move.b  D3,D0
                            	  5931:     ; If provisional door face is not for a shutter, then
                            	  5932:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5933:     ;
                            	  5934:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5935:     ;
02:0004392E 0C000007        	  5936:     cmpi.b  #$07,D0
02:00043932 670E            	  5937:     beq  _anon_z05_111
02:00043934 1B00            	  5938:     move.b  D0,-(A5)  ; PHA
02:00043936 6100DD52        	  5939:     jsr     SetDoorFlag
02:0004393A 101D            	  5940:     move.b  (A5)+,D0  ; PLA
                            	  5941:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5942:     ; then go make it 9 (open "bombable").
                            	  5943:     ; Else make it 4 (open "door").
                            	  5944:     ;
02:0004393C 0C000008        	  5945:     cmpi.b  #$08,D0
02:00043940 67A4            	  5946:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5947: _anon_z05_111:
02:00043942 7004            	  5948:     moveq   #4,D0
                            	  5949:     even
                            	  5950: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5951:     ; For opened doors, the provisional door face has become:
                            	  5952:     ;
                            	  5953:     ; DA PF Meaning
                            	  5954:     ; -------------
                            	  5955:     ; 0  4  open
                            	  5956:     ; 1  1  wall
                            	  5957:     ; 2  2  false wall
                            	  5958:     ; 3  3  false wall 2
                            	  5959:     ; 4  9  bombable
                            	  5960:     ; 5  4  key
                            	  5961:     ; 6  4  key 2
                            	  5962:     ; 7  4  shutter
                            	  5963:     ;
                            	  5964:     ;
                            	  5965:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5966:     ;
02:00043944 7400            	  5967:     moveq   #0,D2
02:00043946 142C0006        	  5968:     move.b  ($0006,A4),D2
02:0004394A 6712            	  5969:     beq  _anon_z05_112
02:0004394C 7400            	  5970:     moveq   #0,D2
02:0004394E 142C000B        	  5971:     move.b  ($000B,A4),D2
