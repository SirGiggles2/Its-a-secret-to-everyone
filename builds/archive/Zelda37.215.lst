                            	  7024: _anon_z01_87:
02:00031C78 4E75            	  7025:     rts
                            	  7026: 
                            	  7027: ; Params:
                            	  7028: ; X: monster slot
                            	  7029: ; Y: weapon slot
                            	  7030: ; [02]: monster mid X
                            	  7031: ; [03]: monster mid Y
                            	  7032: ;
                            	  7033: ; Returns:
                            	  7034: ; [00]: weapon slot
                            	  7035: ;
                            	  7036: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  7037: ;
                            	  7038:     even
                            	  7039: CheckMonsterBoomerangOrFoodCollision:
02:00031C7A 41EC00AC        	  7040:     lea     ($00AC,A4),A0
