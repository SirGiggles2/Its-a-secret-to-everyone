02:00041B6A 023C00EE        	  3168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041B6E 123C0008        	  3169:     move.b  #$08,D1
02:00041B72 D101            	  3170:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041B74 7600            	  3171:     moveq   #0,D3
02:00041B76 1600            	  3172:     move.b  D0,D3
02:00041B78 103C0080        	  3173:     move.b  #$80,D0
02:00041B7C 6134            	  3174:     jsr     MaskInputInBorder
02:00041B7E 101D            	  3175:     move.b  (A5)+,D0  ; PLA
02:00041B80 7600            	  3176:     moveq   #0,D3
02:00041B82 1600            	  3177:     move.b  D0,D3
                            	  3178:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3179:     ; boundary using player's direction and reverse direction index.
