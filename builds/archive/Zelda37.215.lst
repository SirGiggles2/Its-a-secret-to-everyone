                            	  3782: DrawGhiniAndCheckCollisions:
02:0003AFDC 4EB90004D2EA    	  3783:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AFE2 1940000D        	  3784:     move.b  D0,($000D,A4)
                            	  3785:     ; If the direction has an "up" component, then keep the
                            	  3786:     ; frame image 0, and go figure out horizontal flipping.
                            	  3787:     ;
02:0003AFE6 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003AFEA 10302000        	  3789:     move.b  (A0,D2.W),D0
02:0003AFEE 02000008        	  3790:     andi.b #$08,D0
02:0003AFF2 6614            	  3791:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3792:     ; Else make the frame image 1 for the "down" frame.
                            	  3793:     ; Note that this is the frame image to use, even if there's no
                            	  3794:     ; down component in the direction.
                            	  3795:     ;
02:0003AFF4 522C000D        	  3796:     addq.b  #1,($000D,A4)
                            	  3797:     ; If right is a component of the direction, then go set horizontal
                            	  3798:     ; flipping. Else leave horizontal flipping = 0.
                            	  3799:     ;
02:0003AFF8 41EC0098        	  3800:     lea     ($0098,A4),A0
02:0003AFFC 10302000        	  3801:     move.b  (A0,D2.W),D0
02:0003B000 02000001        	  3802:     andi.b #$01,D0
02:0003B004 6714            	  3803:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B006 660E            	  3804:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3805:     even
                            	  3806: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3807:     ; Set horizontal flipping if right is a direction component.
                            	  3808:     ; This essentially the same test as above, but for when we jump
                            	  3809:     ; from the "up" test.
                            	  3810:     ;
02:0003B008 41EC0098        	  3811:     lea     ($0098,A4),A0
02:0003B00C 10302000        	  3812:     move.b  (A0,D2.W),D0
02:0003B010 02000002        	  3813:     andi.b #$02,D0
02:0003B014 6704            	  3814:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3815:     even
