02:0003DEAC 640A            	 10203:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DEAE 7000            	 10204:     moveq   #0,D0
02:0003DEB0 41EC0451        	 10205:     lea     ($0451,A4),A0
