02:000300FC 9101            	  3241:     subx.b  D1,D0   ; SBC ObjX,X
02:000300FE 0A3C0010        	  3242:     eori    #$10,CCR  ; restore X = 6502 C
02:00030102 6100083E        	  3243:     jsr     Abs
