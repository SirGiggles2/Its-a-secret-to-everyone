                            	  5338:     ; Force animation frame 1: hand closed.
                            	  5339:     ;
02:0003BAA2 7001            	  5340:     moveq   #1,D0
02:0003BAA4 41EC03E4        	  5341:     lea     ($03E4,A4),A0
