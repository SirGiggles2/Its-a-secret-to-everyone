02:00042362 162C03F8        	  4297:     move.b  ($03F8,A4),D3
02:00042366 6726            	  4298:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
                            	  4299:     ; If the facing direction is part of the input direction, then
                            	  4300:     ; keep moving in the facing direction.
                            	  4301:     ;
02:00042368 102C0098        	  4302:     move.b  ($0098,A4),D0
02:0004236C 122C03F8        	  4303:     move.b  ($03F8,A4),D1
