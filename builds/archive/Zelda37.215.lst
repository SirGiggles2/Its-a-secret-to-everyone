                            	  3445: _anon_z04_45:
02:0003AD62 1883            	  3446:     move.b  D3,($0000,A4)
                            	  3447:     ; [01] holds Link's X coordinate.
                            	  3448:     ;
02:0003AD64 102C0070        	  3449:     move.b  ($0070,A4),D0
02:0003AD68 19400001        	  3450:     move.b  D0,($0001,A4)
                            	  3451:     ; Add Link's X and the horizontal offset.
                            	  3452:     ;
02:0003AD6C 023C00EE        	  3453:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD70 1214            	  3454:     move.b  ($0000,A4),D1
02:0003AD72 D101            	  3455:     addx.b  D1,D0   ; ADC $00
                            	  3456:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3457:     ;
02:0003AD74 020000F8        	  3458:     andi.b #$F8,D0
                            	  3459:     ; Assign that result to the leever's X coordinate and [02].
                            	  3460:     ;
02:0003AD78 19802070        	  3461:     move.b  D0,($70,A4,D2.W)
02:0003AD7C 19400002        	  3462:     move.b  D0,($0002,A4)
                            	  3463:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
