                            	  4484:     ; If object attribute has $10, go to the unused code above
                            	  4485:     ; to reverse direction.
                            	  4486:     ;
02:0004C064 41EC04BF        	  4487:     lea     ($04BF,A4),A0
02:0004C068 10302000        	  4488:     move.b  (A0,D2.W),D0
02:0004C06C 02000010        	  4489:     andi.b #$10,D0
02:0004C070 6702            	  4490:     beq.s  __far_z_07_0058
02:0004C072 60C8            	  4491:     jmp  Reverse
                            	  4492: __far_z_07_0058:
