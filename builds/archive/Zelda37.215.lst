                            	   314: ;------------------------------------------------------------------------------
                            	   315: ; _c_move_object_shim — MoveObject trampoline.
                            	   316: ;
                            	   317: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   318: ;   Input:     D2 = slot (0..11)
                            	   319: ;   Preserves: D2, A4, A5
                            	   320: ;   Clobbers:  D0, D1, D3, A0
                            	   321: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   322: ;
                            	   323: ; GCC side:
                            	   324: ;   void c_move_object(unsigned short slot);
                            	   325: ;     slot arrives as a 16-bit value on the stack.
                            	   326: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   327: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   328: ;   never clobbered by gcc.
                            	   329: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   330: ;   semantics can exist in a pure C port).
                            	   331: ;------------------------------------------------------------------------------
                            	   332: _c_move_object_shim:
                            	   333:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   334:     move.b  #$AA,($0900,A4)
                            	   335:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   336:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   337:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   338:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   339:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   340:     moveq   #0,D0
02:0002B658 3002            	   341:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   342:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   343:     jsr     c_move_object
02:0002B662 588F            	   344:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   345:     rts
                            	   346: 
                            	   347: ;==============================================================================
                            	   348: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   349: ; and tail-call the native asm function.
                            	   350: ;
                            	   351: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   352: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   353: ; sign-extended).
                            	   354: ;==============================================================================
                            	   355: 
                            	   356: ;------------------------------------------------------------------------------
                            	   357: ; void c_copy_bank_to_window(unsigned int bank);
                            	   358: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   359: ;------------------------------------------------------------------------------
                            	   360: c_copy_bank_to_window:
02:0002B666 202F0004        	   361:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   362:     jmp     _copy_bank_to_window
                            	   363: 
