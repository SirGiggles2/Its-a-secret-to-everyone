02:00033520 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
02:00033522 1003            	   629:     move.b  D3,D0
02:00033524 123C0026        	   630:     move.b  #$26,D1
02:00033528 D101            	   631:     addx.b  D1,D0   ; ADC #$26 (X flag = 6502 C)
