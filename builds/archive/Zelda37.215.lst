                            	  8590: 
                            	  8591: ; Description:
                            	  8592: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8593: ; When walking, the object timer is set. When teleporting,
                            	  8594: ; the teleporting distance remaining is set.
                            	  8595: ;
                            	  8596: ; If we have the magic clock, then only go draw and check collisions.
                            	  8597: ;
                            	  8598:     even
                            	  8599: UpdateBlueWizzrobe:
02:0003D2B8 102C066C        	  8600:     move.b  ($066C,A4),D0
02:0003D2BC 6702            	  8601:     beq.s  __far_z_04_0075
02:0003D2BE 6014            	  8602:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8603: __far_z_04_0075:
02:0003D2C0 6116            	  8604:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D2C2 61000334        	  8605:     jsr     BlueWizzrobe_TryShooting
                            	  8606:     even
                            	  8607: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8608:     ; If the teleporting distance remaining is even, then draw
                            	  8609:     ; and check collisions, else return.
                            	  8610:     ;
                            	  8611:     ; This means that when 0, the monster is walking.
                            	  8612:     ; So, draw and check collisions every frame.
                            	  8613:     ;
                            	  8614:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8615:     ; translucently -- every other frame.
                            	  8616:     ;
02:0003D2C6 41EC0394        	  8617:     lea     ($0394,A4),A0
02:0003D2CA 10302000        	  8618:     move.b  (A0,D2.W),D0
02:0003D2CE E208            	  8619:     lsr.b  #1,D0   ; LSR A
02:0003D2D0 6402            	  8620:     bcc.s  __far_z_04_0076
02:0003D2D2 603A            	  8621:     jmp  L11E17_Exit
                            	  8622: __far_z_04_0076:
                            	  8623:     even
                            	  8624: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D2D4 600004FA        	  8625:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8626: 
                            	  8627:     even
                            	  8628: BlueWizzrobe_WalkOrTeleport:
                            	  8629:     ; If timer has not expired, then go walk.
                            	  8630:     ;
