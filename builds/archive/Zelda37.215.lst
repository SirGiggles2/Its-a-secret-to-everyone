                            	  4015:     ; If we're finally leaving the object flagged "initialized",
                            	  4016:     ; then reset metastate and initialize this as a flyer.
                            	  4017:     ;
02:0003B134 41EC0492        	  4018:     lea     ($0492,A4),A0
02:0003B138 10302000        	  4019:     move.b  (A0,D2.W),D0
02:0003B13C 66EC            	  4020:     bne  _anon_z04_53
02:0003B13E 4EB90004DB12    	  4021:     jsr     ResetObjMetastateAndTimer
02:0003B144 6000F44A        	  4022:     jmp     EndInitFlyer
