02:000300EC 102C0070        	  3237:     move.b  ($0070,A4),D0
02:000300F0 003C0011        	  3238:     ori     #$11,CCR  ; SEC: set C+X
02:000300F4 12342070        	  3239:     move.b  ($70,A4,D2.W),D1
