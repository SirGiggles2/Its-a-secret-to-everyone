                            	   833: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   834:     ; If the difference in coordinates is negative, then Link is
                            	   835:     ; up or left of the block.
                            	   836:     ;
                            	   837:     ; In that case, increase Y register to index the correct opposite
                            	   838:     ; direction below. Also, negate the difference, so we test
                            	   839:     ; positive values.
                            	   840:     ;
02:00039B02 6A08            	   841:     bpl  _anon_z04_14
02:00039B04 5203            	   842:     addq.b  #1,D3
02:00039B06 4EB900030946    	   843:     jsr     Negate
                            	   844: _anon_z04_14:
                            	   845:     ; If the distance >= $11, then go reset the push timer and return.
                            	   846:     ;
02:00039B0C 0C000011        	   847:     cmpi.b  #$11,D0
02:00039B10 6502            	   848:     bcs.s  __far_z_04_0007
02:00039B12 605C            	   849:     jmp  ResetPushTimer
                            	   850: __far_z_04_0007:
                            	   851:     ; At this point, Link is aligned with the block.
                            	   852:     ;
                            	   853:     ; If the input direction is not the required direction based on
                            	   854:     ; Link's placement; then go reset the push timer and return.
                            	   855:     ;
02:00039B14 102C03F8        	   856:     move.b  ($03F8,A4),D0
02:00039B18 41F900039A6C    	   857:     lea     (BlockPushDirections).l,A0
02:00039B1E 12303000        	   858:     move.b  (A0,D3.W),D1
02:00039B22 B001            	   859:     cmp.b   D1,D0
02:00039B24 6702            	   860:     beq.s  __far_z_04_0008
02:00039B26 6048            	   861:     jmp  ResetPushTimer
                            	   862: __far_z_04_0008:
                            	   863:     ; Link is truly pushing the block.
