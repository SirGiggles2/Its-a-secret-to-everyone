02:0002DFD4 0C0000C0        	   840:     cmpi.b  #$C0,D0
02:0002DFD8 670A            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002DFDA 5303            	   842:     subq.b  #1,D3
02:0002DFDC 0C000040        	   843:     cmpi.b  #$40,D0
02:0002DFE0 6702            	   844:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
