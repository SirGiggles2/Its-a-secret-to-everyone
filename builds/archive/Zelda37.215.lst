                            	 10208: _L_z04_UpdateGohma_AnimateEye:
                            	 10209:     ; Animate the eye.
                            	 10210:     ;
                            	 10211:     ; First, if the counter for when to open the eye next = 0, then
                            	 10212:     ; set it to a random value at least $C0; and set the timer for
                            	 10213:     ; keeping the eye open to $80.
                            	 10214:     ;
                            	 10215:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10216:     ; every other frame.
                            	 10217:     ;
02:0003DEB8 41EC042C        	 10218:     lea     ($042C,A4),A0
02:0003DEBC 10302000        	 10219:     move.b  (A0,D2.W),D0
02:0003DEC0 661E            	 10220:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEC2 103C0080        	 10221:     move.b  #$80,D0
02:0003DEC6 41EC0444        	 10222:     lea     ($0444,A4),A0
02:0003DECA 11802000        	 10223:     move.b  D0,(A0,D2.W)
02:0003DECE 103C00C0        	 10224:     move.b  #$C0,D0
02:0003DED2 12342018        	 10225:     move.b  ($18,A4,D2.W),D1
02:0003DED6 8001            	 10226:     or.b  D1,D0
02:0003DED8 41EC042C        	 10227:     lea     ($042C,A4),A0
02:0003DEDC 11802000        	 10228:     move.b  D0,(A0,D2.W)
                            	 10229:     even
                            	 10230: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10231:     ; Decrement the next-open-eye counter.
                            	 10232:     ;
02:0003DEE0 102C0015        	 10233:     move.b  ($0015,A4),D0
02:0003DEE4 E208            	 10234:     lsr.b  #1,D0   ; LSR A
02:0003DEE6 6408            	 10235:     bcc  _anon_z04_122
02:0003DEE8 41EC042C        	 10236:     lea     ($042C,A4),A0
02:0003DEEC 53302000        	 10237:     subq.b  #1,(A0,D2.W)
                            	 10238: _anon_z04_122:
                            	 10239:     ; If open eye timer = 0, then the eye is closed.
                            	 10240:     ; Go animate it differently.
                            	 10241:     ;
02:0003DEF0 41EC0444        	 10242:     lea     ($0444,A4),A0
02:0003DEF4 10302000        	 10243:     move.b  (A0,D2.W),D0
02:0003DEF8 674A            	 10244:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10245:     ; Else decrement the open eye timer.
                            	 10246:     ;
02:0003DEFA 41EC0444        	 10247:     lea     ($0444,A4),A0
02:0003DEFE 53302000        	 10248:     subq.b  #1,(A0,D2.W)
                            	 10249:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10250:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10251:     ;
02:0003DF02 7602            	 10252:     moveq   #2,D3
02:0003DF04 0C000070        	 10253:     cmpi.b  #$70,D0
02:0003DF08 6408            	 10254:     bcc  _anon_z04_123
02:0003DF0A 0C000010        	 10255:     cmpi.b  #$10,D0
02:0003DF0E 6502            	 10256:     bcs  _anon_z04_123
02:0003DF10 5203            	 10257:     addq.b  #1,D3
