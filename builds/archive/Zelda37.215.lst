02:00031CC8 1614            	  7094:     move.b  ($0000,A4),D3
02:00031CCA 41EC00AC        	  7095:     lea     ($00AC,A4),A0
02:00031CCE 10303000        	  7096:     move.b  (A0,D3.W),D0
