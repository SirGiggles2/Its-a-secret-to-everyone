02:00036910 1940050D        	  5388:     move.b  D0,($050D,A4)
                            	  5389:     ; Increment the VRAM page number.
                            	  5390:     ;
02:00036914 7600            	  5391:     moveq   #0,D3
02:00036916 162C050C        	  5392:     move.b  ($050C,A4),D3
02:0003691A 5203            	  5393:     addq.b  #1,D3
                            	  5394:     ; If it has reached $C, then roll it over to 0.
                            	  5395:     ;
02:0003691C 0C03000C        	  5396:     cmpi.b  #$0C,D3
