02:0003D2DC 661C            	  8632:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8633:     ; Timer = 0. Only teleporting now.
                            	  8634:     ;
                            	  8635:     ; If there is still distance to go while translucent, then
                            	  8636:     ; decrement the distance remaining, and move.
                            	  8637:     ;
02:0003D2DE 41EC0394        	  8638:     lea     ($0394,A4),A0
02:0003D2E2 10302000        	  8639:     move.b  (A0,D2.W),D0
02:0003D2E6 670A            	  8640:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D2E8 41EC0394        	  8641:     lea     ($0394,A4),A0
02:0003D2EC 53302000        	  8642:     subq.b  #1,(A0,D2.W)
02:0003D2F0 602A            	  8643:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8644: 
                            	  8645:     even
                            	  8646: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8647:     ; Distance remaining = 0. Still teleporting.
                            	  8648:     ;
02:0003D2F2 6100021A        	  8649:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003D2F6 600000B0        	  8650:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8651: 
                            	  8652:     even
                            	  8653: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8654:     ; Timer:
                            	  8655:     ;   >= $10: Turn if needed and move every other frame
                            	  8656:     ;   > 1:    Do nothing
                            	  8657:     ;   = 1:    Choose a place to teleport to.
                            	  8658:     ;
