02:0004D2E0 53302000        	  7191:     subq.b  #1,(A0,D2.W)
02:0004D2E4 6702            	  7192:     beq.s  __far_z_07_0127
02:0004D2E6 6002            	  7193:     jmp  Anim_FetchObjPosForSpriteDescriptor
