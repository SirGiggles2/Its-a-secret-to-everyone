                            	   816: SwitchToNT1:
                            	   817:     ; When we begin scrolling left, CurHScroll = 0 and base
                            	   818:     ; nametable is 0. This shows the current room completely.
                            	   819:     ;
                            	   820:     ; The first time in ScrollWorld, the speed [00] will be
                            	   821:     ; subtracted from CurHScroll to show most of NT 0, and
                            	   822:     ; a little of NT 1 to its left. In other words, the
                            	   823:     ; scroll position now refers to a position in NT 1.
                            	   824:     ;
                            	   825:     ; [01] is this first position shown in NT 1. So, once
                            	   826:     ; CurHScroll matches it (in the first call to this routine),
                            	   827:     ; turn on this flag that makes NT 1 the base nametable.
02:000405DC 7001            	   828:     moveq   #1,D0
02:000405DE 1940005F        	   829:     move.b  D0,($005F,A4)
                            	   830:     even
