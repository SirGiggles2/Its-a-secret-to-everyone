                            	  7196: UpdateDodongoState2_Stunned:
                            	  7197:     ; Take action depending on the value of stun timer:
                            	  7198:     ; 0:     set stun timer to $20 
                            	  7199:     ; 1:     go back to state 0
                            	  7200:     ; other: return
                            	  7201:     ;
