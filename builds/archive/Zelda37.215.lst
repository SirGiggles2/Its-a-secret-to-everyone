02:0003CD2E E208            	  7906:     lsr.b  #1,D0   ; LSR A
                            	  7907:     ; If movement frame = 1, add 3 to frame image to access
                            	  7908:     ; the second animation frame's images.
                            	  7909:     ;
02:0003CD30 7600            	  7910:     moveq   #0,D3
02:0003CD32 41EC03E4        	  7911:     lea     ($03E4,A4),A0
02:0003CD36 16302000        	  7912:     move.b  (A0,D2.W),D3
02:0003CD3A 671E            	  7913:     beq  _anon_z04_95
02:0003CD3C 023C00EE        	  7914:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD40 123C0003        	  7915:     move.b  #$03,D1
02:0003CD44 D101            	  7916:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7917:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7918:     ;
                            	  7919:     ; Down has two frame images, but up only has one. By flipping
                            	  7920:     ; horizontally, you get two frame images.
                            	  7921:     ;
02:0003CD46 7600            	  7922:     moveq   #0,D3
02:0003CD48 41EC0098        	  7923:     lea     ($0098,A4),A0
02:0003CD4C 16302000        	  7924:     move.b  (A0,D2.W),D3
02:0003CD50 0C030008        	  7925:     cmpi.b  #$08,D3
02:0003CD54 6604            	  7926:     bne  _anon_z04_95
02:0003CD56 522C000F        	  7927:     addq.b  #1,($000F,A4)
