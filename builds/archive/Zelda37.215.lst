                            	  4287: Link_ModifyDirInDoorway:
                            	  4288:     ; In a doorway (UW), you can only move in the direction
                            	  4289:     ; that you entered it or the opposite.
                            	  4290:     ;
                            	  4291:     ;
                            	  4292:     ; If not in a doorway nor moving, then return.
                            	  4293:     ;
02:0004235A 102C0053        	  4294:     move.b  ($0053,A4),D0
02:0004235E 672E            	  4295:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
