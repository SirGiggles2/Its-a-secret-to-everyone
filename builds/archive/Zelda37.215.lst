02:0004BFF8 600000AC        	  4388:     jmp  L1F148_Exit
                            	  4389: __far_z_07_0051:
                            	  4390:     even
                            	  4391: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4392:     ; If grid offset <> 0, return.
                            	  4393:     ;
02:0004BFFC 41EC0394        	  4394:     lea     ($0394,A4),A0
02:0004C000 10302000        	  4395:     move.b  (A0,D2.W),D0
02:0004C004 6704            	  4396:     beq.s  __far_z_07_0052
02:0004C006 6000009E        	  4397:     jmp  L1F148_Exit
                            	  4398: __far_z_07_0052:
                            	  4399:     ; Grid offset = 0.
                            	  4400:     ; The object is at a point between cells in the grid.
                            	  4401:     ; So, we can check tiles for collision.
                            	  4402:     ;
                            	  4403:     ; Reset [0E] alternate direction search step.
                            	  4404:     ;
02:0004C00A 1940000E        	  4405:     move.b  D0,($000E,A4)
                            	  4406:     ; If there's a movement direction, go check tile collision.
                            	  4407:     ;
02:0004C00E 102C000F        	  4408:     move.b  ($000F,A4),D0
02:0004C012 6702            	  4409:     beq.s  __far_z_07_0053
02:0004C014 602E            	  4410:     jmp  CheckTiles
                            	  4411: __far_z_07_0053:
                            	  4412:     ; Moving direction = 0.
                            	  4413:     ; If object is the player, return.
                            	  4414:     ;
02:0004C016 4A02            	  4415:     cmpi.b  #$00,D2
02:0004C018 6604            	  4416:     bne.s  __far_z_07_0054
02:0004C01A 6000008A        	  4417:     jmp  L1F148_Exit
                            	  4418: __far_z_07_0054:
                            	  4419:     ; Moving direction = 0.
                            	  4420:     ; The object is not the player.
                            	  4421:     ;
                            	  4422:     ; If object does not have attribute $10, then
                            	  4423:     ; set movement direction to input direction,
                            	  4424:     ; and go try to turn to an unblocked direction in order to move.
                            	  4425:     ;
02:0004C01E 41EC04BF        	  4426:     lea     ($04BF,A4),A0
02:0004C022 10302000        	  4427:     move.b  (A0,D2.W),D0
02:0004C026 02000010        	  4428:     andi.b #$10,D0
02:0004C02A 6702            	  4429:     beq.s  __far_z_07_0055
02:0004C02C 600E            	  4430:     jmp  Reverse
                            	  4431: __far_z_07_0055:
02:0004C02E 41EC03F8        	  4432:     lea     ($03F8,A4),A0
02:0004C032 10302000        	  4433:     move.b  (A0,D2.W),D0
02:0004C036 1940000F        	  4434:     move.b  D0,($000F,A4)
