02:0003A0B0 4EB90004DACE    	  1592:     jsr     DestroyMonster
02:0003A0B6 612C            	  1593:     jsr     CreateChildGel
                            	  1594:     ; If the zol's direction is vertical, then set the first child gel's
                            	  1595:     ; direction to left, else up.
                            	  1596:     ;
02:0003A0B8 41EC0098        	  1597:     lea     ($0098,A4),A0
02:0003A0BC 10302000        	  1598:     move.b  (A0,D2.W),D0
02:0003A0C0 0C000004        	  1599:     cmpi.b  #$04,D0
02:0003A0C4 7002            	  1600:     moveq   #2,D0
