02:0003A9C2 023C00EE        	  2969:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9C6 12342019        	  2970:     move.b  ($19,A4,D2.W),D1
02:0003A9CA D101            	  2971:     addx.b  D1,D0   ; ADC Random+1,X
02:0003A9CC 0C000020        	  2972:     cmpi.b  #$20,D0
02:0003A9D0 6412            	  2973:     bcc  _anon_z04_39
02:0003A9D2 003C0011        	  2974:     ori     #$11,CCR  ; SEC: set C+X
02:0003A9D6 123C0040        	  2975:     move.b  #$40,D1
02:0003A9DA 0A3C0010        	  2976:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A9DE 9101            	  2977:     subx.b  D1,D0   ; SBC #$40
02:0003A9E0 0A3C0010        	  2978:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2979: _anon_z04_39:
