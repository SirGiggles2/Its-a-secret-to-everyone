02:0003AF0C 4EB90004D2EA    	  3660:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3661:     ; If facing down, then use frame image offset 2.
                            	  3662:     ;
02:0003AF12 41EC0098        	  3663:     lea     ($0098,A4),A0
02:0003AF16 10302000        	  3664:     move.b  (A0,D2.W),D0
02:0003AF1A 7600            	  3665:     moveq   #0,D3
02:0003AF1C 1600            	  3666:     move.b  D0,D3
02:0003AF1E 0200000C        	  3667:     andi.b #$0C,D0
02:0003AF22 670C            	  3668:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AF24 7002            	  3669:     moveq   #2,D0
02:0003AF26 0C030008        	  3670:     cmpi.b  #$08,D3
