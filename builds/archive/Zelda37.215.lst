02:0002C80C 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002C80E 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002C812 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002C814 7000            	   323:     moveq   #0,D0
02:0002C816 6100E65C        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002C81A 700F            	   325:     moveq   #15,D0
02:0002C81C 6100E656        	   326:     jsr     _apu_write_4015  ; APU/IO write
