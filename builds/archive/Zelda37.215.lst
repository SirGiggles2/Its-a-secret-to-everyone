02:0003C7BC 41F90003152C    	  7105:     lea     (SpriteOffsets).l,A0
02:0003C7C2 10303000        	  7106:     move.b  (A0,D3.W),D0
02:0003C7C6 7600            	  7107:     moveq   #0,D3
02:0003C7C8 1600            	  7108:     move.b  D0,D3
02:0003C7CA 101D            	  7109:     move.b  (A5)+,D0  ; PLA
02:0003C7CC 41EC0201        	  7110:     lea     ($0201,A4),A0
02:0003C7D0 11803000        	  7111:     move.b  D0,(A0,D3.W)
02:0003C7D4 1014            	  7112:     move.b  ($0000,A4),D0
02:0003C7D6 41EC0203        	  7113:     lea     ($0203,A4),A0
02:0003C7DA 11803000        	  7114:     move.b  D0,(A0,D3.W)
02:0003C7DE 102C0001        	  7115:     move.b  ($0001,A4),D0
