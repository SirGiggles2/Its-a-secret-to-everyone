02:0003A9BA 0C030020        	  2960:     cmpi.b  #$20,D3
02:0003A9BE 6748            	  2961:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2962:     ; Else calculate a timer value.
