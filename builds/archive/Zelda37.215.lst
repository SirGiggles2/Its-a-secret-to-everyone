02:0003E192 182C0001        	 10612:     move.b  ($01,A4),D4  ; ptr hi
02:0003E196 024100FF        	 10613:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E19A E14C            	 10614:     lsl.w   #8,D4
