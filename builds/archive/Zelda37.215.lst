                            	  6252:     ; Write the transfer record header for the door.
                            	  6253:     ;
                            	  6254:     ;
                            	  6255:     ; VRAM address high byte of door
02:00043B4A 1014            	  6256:     move.b  ($0000,A4),D0
02:00043B4C 41EC0302        	  6257:     lea     ($0302,A4),A0
02:00043B50 11802000        	  6258:     move.b  D0,(A0,D2.W)
