02:00043636 10303000        	  5517:     move.b  (A0,D3.W),D0
02:0004363A 7600            	  5518:     moveq   #0,D3
02:0004363C 162C0003        	  5519:     move.b  ($0003,A4),D3
02:00043640 0C030002        	  5520:     cmpi.b  #$02,D3
02:00043644 6510            	  5521:     bcs  _anon_z05_106
02:00043646 7600            	  5522:     moveq   #0,D3
02:00043648 162C00EB        	  5523:     move.b  ($00EB,A4),D3
02:0004364C 41F900FF68FE    	  5524:     lea     (NES_SRAM+$08FE).l,A0
02:00043652 10303000        	  5525:     move.b  (A0,D3.W),D0
                            	  5526: _anon_z05_106:
02:00043656 1880            	  5527:     move.b  D0,($0000,A4)
02:00043658 102C0003        	  5528:     move.b  ($0003,A4),D0
02:0004365C 02000001        	  5529:     andi.b #$01,D0
02:00043660 6612            	  5530:     bne  _anon_z05_107
02:00043662 1214            	  5531:     move.b  ($0000,A4),D1
02:00043664 E209            	  5532:     lsr.b  #1,D1   ; LSR $00
02:00043666 1881            	  5533:     move.b  D1,($0000,A4)
02:00043668 1214            	  5534:     move.b  ($0000,A4),D1
02:0004366A E209            	  5535:     lsr.b  #1,D1   ; LSR $00
02:0004366C 1881            	  5536:     move.b  D1,($0000,A4)
02:0004366E 1214            	  5537:     move.b  ($0000,A4),D1
02:00043670 E209            	  5538:     lsr.b  #1,D1   ; LSR $00
02:00043672 1881            	  5539:     move.b  D1,($0000,A4)
                            	  5540: _anon_z05_107:
02:00043674 1214            	  5541:     move.b  ($0000,A4),D1
02:00043676 E209            	  5542:     lsr.b  #1,D1   ; LSR $00
02:00043678 1881            	  5543:     move.b  D1,($0000,A4)
02:0004367A 1214            	  5544:     move.b  ($0000,A4),D1
02:0004367C E209            	  5545:     lsr.b  #1,D1   ; LSR $00
