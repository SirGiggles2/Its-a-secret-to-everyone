                            	  7228: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7229:     ; Bloated timer =>
                            	  7230:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7231:     ; 1:     go advance the substate
                            	  7232:     ; other: go decrement Bloated timer
                            	  7233:     ;
02:0003C8B2 7600            	  7234:     moveq   #0,D3
02:0003C8B4 41EC045E        	  7235:     lea     ($045E,A4),A0
02:0003C8B8 16302000        	  7236:     move.b  (A0,D2.W),D3
02:0003C8BC 5303            	  7237:     subq.b  #1,D3
02:0003C8BE 6750            	  7238:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C8C0 6B04            	  7239:     bmi.s  __far_z_04_0063
02:0003C8C2 60000080        	  7240:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7241: __far_z_04_0063:
                            	  7242:     ; Set the bloated timer according to the substate.
                            	  7243:     ;
02:0003C8C6 7600            	  7244:     moveq   #0,D3
02:0003C8C8 41EC042C        	  7245:     lea     ($042C,A4),A0
02:0003C8CC 16302000        	  7246:     move.b  (A0,D2.W),D3
02:0003C8D0 41F90003C7FC    	  7247:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C8D6 10303000        	  7248:     move.b  (A0,D3.W),D0
02:0003C8DA 41EC045E        	  7249:     lea     ($045E,A4),A0
02:0003C8DE 11802000        	  7250:     move.b  D0,(A0,D2.W)
                            	  7251:     ; If substate <> 0, go decrement bloated timer.
                            	  7252:     ;
02:0003C8E2 4A03            	  7253:     cmpi.b  #$00,D3
02:0003C8E4 6702            	  7254:     beq.s  __far_z_04_0064
02:0003C8E6 605C            	  7255:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7256: __far_z_04_0064:
                            	  7257:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  7258:     ;
02:0003C8E8 7610            	  7259:     moveq   #16,D3
02:0003C8EA 7000            	  7260:     moveq   #0,D0
02:0003C8EC 41EC00AC        	  7261:     lea     ($00AC,A4),A0
02:0003C8F0 11803000        	  7262:     move.b  D0,(A0,D3.W)
                            	  7263:     ; Increment the number of bomb hits.
                            	  7264:     ;
02:0003C8F4 41EC0437        	  7265:     lea     ($0437,A4),A0
02:0003C8F8 10302000        	  7266:     move.b  (A0,D2.W),D0
02:0003C8FC 023C00EE        	  7267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C900 123C0001        	  7268:     move.b  #$01,D1
02:0003C904 D101            	  7269:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003C906 41EC0437        	  7270:     lea     ($0437,A4),A0
02:0003C90A 11802000        	  7271:     move.b  D0,(A0,D2.W)
02:0003C90E 6034            	  7272:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  7273: 
                            	  7274:     even
                            	  7275: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7276:     ; Advance the substate.
                            	  7277:     ;
02:0003C910 41EC042C        	  7278:     lea     ($042C,A4),A0
02:0003C914 52302000        	  7279:     addq.b  #1,(A0,D2.W)
                            	  7280:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7281:     ;
02:0003C918 41EC042C        	  7282:     lea     ($042C,A4),A0
02:0003C91C 10302000        	  7283:     move.b  (A0,D2.W),D0
02:0003C920 0C000002        	  7284:     cmpi.b  #$02,D0
02:0003C924 6402            	  7285:     bcc.s  __far_z_04_0065
02:0003C926 601C            	  7286:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7287: __far_z_04_0065:
                            	  7288:     ; New bloated substate >= 2.
                            	  7289:     ;
                            	  7290:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7291:     ; which will transition to state 0 (moving).
                            	  7292:     ;
                            	  7293:     ; Note that if the bomb hits >= 2, then:
                            	  7294:     ; - If new substate = 2, then substate 2 will wait,
                            	  7295:     ;   and then transition to substate 3.
                            	  7296:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7297:     ;
02:0003C928 7600            	  7298:     moveq   #0,D3
02:0003C92A 41EC0437        	  7299:     lea     ($0437,A4),A0
02:0003C92E 16302000        	  7300:     move.b  (A0,D2.W),D3
02:0003C932 0C030002        	  7301:     cmpi.b  #$02,D3
02:0003C936 6502            	  7302:     bcs.s  __far_z_04_0066
02:0003C938 600A            	  7303:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7304: __far_z_04_0066:
02:0003C93A 7004            	  7305:     moveq   #4,D0
02:0003C93C 41EC042C        	  7306:     lea     ($042C,A4),A0
02:0003C940 11802000        	  7307:     move.b  D0,(A0,D2.W)
                            	  7308:     even
                            	  7309: L_Dodongo_DecrementBloatedTimer:
02:0003C944 4EF90002B902    	  7310:     jmp     c_dodongo_dec_bloated_timer
                            	  7311: 
