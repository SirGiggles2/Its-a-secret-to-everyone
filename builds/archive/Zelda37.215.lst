                            	   633:     even
                            	   634: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   635:     ; Bottom of the inner loop.
                            	   636:     ;
                            	   637:     ; Increment the triforce tile slot.
                            	   638:     ; Decrement [07] and loop again, if it's not 0.
                            	   639:     ;
02:00040462 5203            	   640:     addq.b  #1,D3
02:00040464 532C0007        	   641:     subq.b  #1,($0007,A4)
02:00040468 66B0            	   642:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   643:     ; Bottom of the outer loop.
