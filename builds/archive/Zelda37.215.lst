                            	   558: UpdateMenuStartOW:
                            	   559:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   560:     ; make it look completely empty, and no piece has been won.
                            	   561:     ;
02:000403E6 7617            	   562:     moveq   #23,D3
                            	   563: _anon_z05_6:
02:000403E8 7400            	   564:     moveq   #0,D2
02:000403EA 41F90004039E    	   565:     lea     (TriforceTransferBufOffsets).l,A0
02:000403F0 14303000        	   566:     move.b  (A0,D3.W),D2
02:000403F4 41F9000403CE    	   567:     lea     (TriforceTransferBufTiles).l,A0
02:000403FA 10303000        	   568:     move.b  (A0,D3.W),D0
02:000403FE 41F900047786    	   569:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040404 11802000        	   570:     move.b  D0,(A0,D2.W)
02:00040408 5303            	   571:     subq.b  #1,D3
02:0004040A 6ADC            	   572:     bpl  _anon_z05_6
                            	   573:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   574:     ;
02:0004040C 5203            	   575:     addq.b  #1,D3
                            	   576:     ; Outer loop.
                            	   577:     ; A level test bit in [06] will be used to see whether
                            	   578:     ; we have a triforce piece.
                            	   579:     ;
02:0004040E 7001            	   580:     moveq   #1,D0
02:00040410 19400006        	   581:     move.b  D0,($0006,A4)
                            	   582:     even
                            	   583: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   584:     ; Inner loop.
                            	   585:     ; Each level bit will make 3 triforce tile slots be
                            	   586:     ; checked and replaced.
                            	   587:     ;
02:00040414 7003            	   588:     moveq   #3,D0
02:00040416 19400007        	   589:     move.b  D0,($0007,A4)
                            	   590:     even
                            	   591: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   592:     ; Get the offset into the submenu triforce transfer buffers of
                            	   593:     ; the current tile slot.
                            	   594:     ;
02:0004041A 7400            	   595:     moveq   #0,D2
02:0004041C 41F90004039E    	   596:     lea     (TriforceTransferBufOffsets).l,A0
02:00040422 14303000        	   597:     move.b  (A0,D3.W),D2
                            	   598:     ; If the level test bit is not in the triforce mask, then we don't
                            	   599:     ; have this piece. So, go loop again, and leave the tile in the
                            	   600:     ; empty state.
                            	   601:     ;
                            	   602:     ;
                            	   603:     ; [06] level test mask
02:00040426 102C0006        	   604:     move.b  ($0006,A4),D0
02:0004042A 122C0671        	   605:     move.b  ($0671,A4),D1
02:0004042E C200            	   606:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040430 6730            	   607:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   608:     ; We have the triforce piece.
                            	   609:     ;
                            	   610:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   611:     ; then make it $F5. These are tiles that were half full, and now
                            	   612:     ; need to be full.
                            	   613:     ;
                            	   614:     ; Else replace it with the one at the current triforce tile slot
                            	   615:     ; in the replacement list.
                            	   616:     ;
02:00040432 41F900047786    	   617:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040438 10302000        	   618:     move.b  (A0,D2.W),D0
02:0004043C 0C0000E5        	   619:     cmpi.b  #$E5,D0
02:00040440 6712            	   620:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040442 0C0000E6        	   621:     cmpi.b  #$E6,D0
02:00040446 670C            	   622:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040448 41F9000403B6    	   623:     lea     (TriforceTriforceBufReplacements).l,A0
02:0004044E 10303000        	   624:     move.b  (A0,D3.W),D0
02:00040452 6004            	   625:     jmp     _anon_z05_7
                            	   626: 
