02:000360D8 600000C6        	  4557:     jmp  LA9F4_Exit
                            	  4558: __far_z_02_0009:
                            	  4559:     ; Set the timer to wait 6 frames after the next character about
                            	  4560:     ; to be shown.
                            	  4561:     ;
02:000360DC 7006            	  4562:     moveq   #6,D0
02:000360DE 19400029        	  4563:     move.b  D0,($0029,A4)
                            	  4564:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4565:     ; to the dynamic transfer buf.
