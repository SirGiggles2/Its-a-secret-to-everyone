                            	  5387: _L_z07_SpreadShot_NextCorner:
                            	  5388:     ; Prepare to process the next corner.
                            	  5389:     ;
                            	  5390:     ; First, restore X offset [02] and Y offset [03].
                            	  5391:     ;
02:0004C69C 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C69E 19400003        	  5393:     move.b  D0,($0003,A4)
02:0004C6A2 101D            	  5394:     move.b  (A5)+,D0  ; PLA
02:0004C6A4 19400002        	  5395:     move.b  D0,($0002,A4)
                            	  5396:     ; Take turns negating X offset or Y offset for the next round.
                            	  5397:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5398:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5399:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5400:     ; - Fourth turn: doesn't matter
                            	  5401:     ;
                            	  5402:     ;
                            	  5403:     ; Get the loop index.
02:0004C6A8 101D            	  5404:     move.b  (A5)+,D0  ; PLA
02:0004C6AA 1B00            	  5405:     move.b  D0,-(A5)  ; PHA
02:0004C6AC 7600            	  5406:     moveq   #0,D3
02:0004C6AE 1600            	  5407:     move.b  D0,D3
02:0004C6B0 0C030001        	  5408:     cmpi.b  #$01,D3
02:0004C6B4 6602            	  5409:     bne  _anon_z07_25
02:0004C6B6 7603            	  5410:     moveq   #3,D3
                            	  5411: _anon_z07_25:
02:0004C6B8 10343000        	  5412:     move.b  ($00,A4,D3.W),D0
02:0004C6BC 4600            	  5413:     eori.b #$FF,D0
02:0004C6BE 023C00EE        	  5414:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6C2 123C0001        	  5415:     move.b  #$01,D1
02:0004C6C6 D101            	  5416:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C6C8 19803000        	  5417:     move.b  D0,($00,A4,D3.W)
                            	  5418:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5419:     ;
02:0004C6CC 101D            	  5420:     move.b  (A5)+,D0  ; PLA
02:0004C6CE 7600            	  5421:     moveq   #0,D3
02:0004C6D0 1600            	  5422:     move.b  D0,D3
02:0004C6D2 5303            	  5423:     subq.b  #1,D3
02:0004C6D4 6A00FF18        	  5424:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5425:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
