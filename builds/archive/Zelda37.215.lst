                            	   270:     ; Advance state.
                            	   271:     ;
02:000401CE 7048            	   272:     moveq   #72,D0
                            	   273:     even
                            	   274: SelectTransferBufAndIncState:
02:000401D0 19400014        	   275:     move.b  D0,($0014,A4)
                            	   276: _anon_z05_1:
02:000401D4 522C00E1        	   277:     addq.b  #1,($00E1,A4)
02:000401D8 4E75            	   278:     rts
                            	   279: 
