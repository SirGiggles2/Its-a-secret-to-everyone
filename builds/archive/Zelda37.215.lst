02:0003CF98 D101            	  8201:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003CF9A 41EC0394        	  8202:     lea     ($0394,A4),A0
02:0003CF9E 11802000        	  8203:     move.b  D0,(A0,D2.W)
                            	  8204:     ; Align the monster with a square horizontally.
                            	  8205:     ;
