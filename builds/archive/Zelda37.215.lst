02:0003F26A 10342028        	 12909:     move.b  ($28,A4,D2.W),D0
02:0003F26E 6602            	 12910:     bne.s  __far_z_04_0131
02:0003F270 600E            	 12911:     jmp  Ganon_MoveAndShoot
                            	 12912: __far_z_04_0131:
                            	 12913:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12914:     ; Collisions were checked already.
                            	 12915:     ;
                            	 12916:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12917:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12918:     ;
02:0003F272 0C000001        	 12919:     cmpi.b  #$01,D0
02:0003F276 6702            	 12920:     beq.s  __far_z_04_0132
02:0003F278 6078            	 12921:     jmp  L_Ganon_DrawBody
                            	 12922: __far_z_04_0132:
