                            	  3474: _L_z04_UpdateRedLeever_Subtract:
                            	  3475:     ; The point is to get the absolute distance between the two.
                            	  3476:     ;
02:0003AD98 102C0001        	  3477:     move.b  ($0001,A4),D0
02:0003AD9C 003C0011        	  3478:     ori     #$11,CCR  ; SEC: set C+X
02:0003ADA0 122C0002        	  3479:     move.b  ($0002,A4),D1
02:0003ADA4 0A3C0010        	  3480:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ADA8 9101            	  3481:     subx.b  D1,D0   ; SBC $02
02:0003ADAA 0A3C0010        	  3482:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3483:     ; If the absolute distance >= $30, then return.
                            	  3484:     ; It means that the leever's X coordinate wrapped around
                            	  3485:     ; the left or right edge of the screen.
                            	  3486:     ;
02:0003ADAE 0C000030        	  3487:     cmpi.b  #$30,D0
