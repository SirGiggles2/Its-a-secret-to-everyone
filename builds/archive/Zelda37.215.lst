                            	  6855: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6856:     ; Link and the shot are facing opposite directions.
                            	  6857:     ; Link can parry certain weapons/shots.
                            	  6858:     ;
                            	  6859:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6860:     ; no harmful collision; but it still counts as a shot collision.
                            	  6861:     ; So, go treat this as a parry.
                            	  6862:     ;
02:00031B2E 41EC034F        	  6863:     lea     ($034F,A4),A0
02:00031B32 10302000        	  6864:     move.b  (A0,D2.W),D0
02:00031B36 0C000055        	  6865:     cmpi.b  #$55,D0
