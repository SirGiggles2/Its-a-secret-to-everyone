                            	 10097:     ;
02:0003DDC8 7001            	 10098:     moveq   #1,D0
02:0003DDCA 7600            	 10099:     moveq   #0,D3
02:0003DDCC 16342018        	 10100:     move.b  ($18,A4,D2.W),D3
02:0003DDD0 0C0300B0        	 10101:     cmpi.b  #$B0,D3
