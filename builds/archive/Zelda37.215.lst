02:0003E1A6 2044            	 10618:     movea.l D4,A0
02:0003E1A8 10303000        	 10619:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003E1AC 19803071        	 10620:     move.b  D0,($71,A4,D3.W)
