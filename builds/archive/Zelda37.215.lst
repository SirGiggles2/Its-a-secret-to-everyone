                            	  7654: L763A_Exit:
02:0003204C 4E75            	  7655:     rts
                            	  7656: 
                            	  7657: ; Params:
                            	  7658: ; A: damage points
                            	  7659: ; X: monster object slot
                            	  7660: ; [00]: weapon object slot
                            	  7661: ; [02]: monster object mid X
                            	  7662: ; [03]: monster object mid Y
                            	  7663: ; [09]: damage type
                            	  7664: ; [0D]: horizontal threshold
                            	  7665: ;
                            	  7666: ; Returns:
                            	  7667: ; [06]: 1 if objects collide
                            	  7668: ; [07]: damage points
                            	  7669: ; [0E]: vertical threshold
                            	  7670: ;
                            	  7671:     even
                            	  7672: CheckMonsterSlenderWeaponCollision:
02:0003204E 19400007        	  7673:     move.b  D0,($0007,A4)
02:00032052 102C000D        	  7674:     move.b  ($000D,A4),D0
02:00032056 1940000E        	  7675:     move.b  D0,($000E,A4)
                            	  7676: ; Params:
                            	  7677: ; X: monster object slot
                            	  7678: ; [00]: weapon object slot
                            	  7679: ; [02]: monster object mid X
                            	  7680: ; [03]: monster object mid Y
                            	  7681: ; [07]: damage points
                            	  7682: ; [09]: damage type
                            	  7683: ; [0D]: horizontal threshold
                            	  7684: ; [0E]: vertical threshold
                            	  7685: ;
                            	  7686: ; Returns:
                            	  7687: ; [06]: 1 if objects collide
                            	  7688: ;
                            	  7689:     even
                            	  7690: CheckMonsterSlenderWeaponCollision2:
02:0003205A 7600            	  7691:     moveq   #0,D3
02:0003205C 1614            	  7692:     move.b  ($0000,A4),D3
                            	  7693:     ; If Link is facing vertically, then:
                            	  7694:     ; [04] := (weapon X + 6)
                            	  7695:     ; A    := (weapon Y + 8)
                            	  7696:     ;
                            	  7697:     ; Shouldn't it be based on the weapon's direction?
                            	  7698:     ;
02:0003205E 102C0098        	  7699:     move.b  ($0098,A4),D0
02:00032062 0200000C        	  7700:     andi.b #$0C,D0
02:00032066 6726            	  7701:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00032068 10343070        	  7702:     move.b  ($70,A4,D3.W),D0
02:0003206C 023C00EE        	  7703:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032070 123C0006        	  7704:     move.b  #$06,D1
02:00032074 D101            	  7705:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032076 19400004        	  7706:     move.b  D0,($0004,A4)
02:0003207A 41EC0084        	  7707:     lea     ($0084,A4),A0
02:0003207E 10303000        	  7708:     move.b  (A0,D3.W),D0
02:00032082 023C00EE        	  7709:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032086 123C0008        	  7710:     move.b  #$08,D1
02:0003208A D101            	  7711:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003208C 6024            	  7712:     jmp     _anon_z01_98
                            	  7713: 
                            	  7714:     even
                            	  7715: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7716:     ; Else Link is facing horizontally.
                            	  7717:     ; [04] := (weapon X + 8)
                            	  7718:     ; A    := (weapon Y + 6)
                            	  7719:     ;
                            	  7720:     ; Shouldn't it be based on the weapon's direction?
                            	  7721:     ;
02:0003208E 10343070        	  7722:     move.b  ($70,A4,D3.W),D0
02:00032092 023C00EE        	  7723:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032096 123C0008        	  7724:     move.b  #$08,D1
02:0003209A D101            	  7725:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003209C 19400004        	  7726:     move.b  D0,($0004,A4)
02:000320A0 41EC0084        	  7727:     lea     ($0084,A4),A0
02:000320A4 10303000        	  7728:     move.b  (A0,D3.W),D0
02:000320A8 023C00EE        	  7729:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320AC 123C0006        	  7730:     move.b  #$06,D1
02:000320B0 D101            	  7731:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7732: _anon_z01_98:
                            	  7733:     ; The A register will be copied to [05] and used here.
                            	  7734:     ;
02:000320B2 6000FC08        	  7735:     jmp     CheckMonsterWeaponCollision
                            	  7736: 
                            	  7737: ; Params:
                            	  7738: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7739: ; [00]: weapon object slot (unused)
                            	  7740: ; [02]: object 1 mid X
                            	  7741: ; [03]: object 1 mid Y
                            	  7742: ; [04]: object 2 mid X
                            	  7743: ; [05]: object 2 mid Y
                            	  7744: ;
                            	  7745: ; Returns:
                            	  7746: ; A: 1 if objects collide
                            	  7747: ; Y: weapon object slot
                            	  7748: ; Z: 0 if objects collide
                            	  7749: ; [06]: 1 if objects collide
                            	  7750: ; [0A]: horizontal distance
                            	  7751: ; [0B]: vertical distance
                            	  7752: ;
                            	  7753: ;
                            	  7754: ; Use the same threshold value horizontally and vertically.
                            	  7755: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7756: ;
                            	  7757:     even
                            	  7758: DoObjectsCollide:
02:000320B6 1940000D        	  7759:     move.b  D0,($000D,A4)
02:000320BA 1940000E        	  7760:     move.b  D0,($000E,A4)
                            	  7761: ; Params:
                            	  7762: ; [00]: weapon or Link object slot (unused)
                            	  7763: ; [02]: object 1 mid X
                            	  7764: ; [03]: object 1 mid Y
                            	  7765: ; [04]: object 2 mid X
                            	  7766: ; [05]: object 2 mid Y
                            	  7767: ; [0D]: horizontal threshold
                            	  7768: ; [0E]: vertical threshold
                            	  7769: ;
                            	  7770: ; Returns:
                            	  7771: ; A: 1 if objects collide
                            	  7772: ; Y: weapon or Link object slot (copied from [00])
                            	  7773: ; Z: 0 if objects collide
                            	  7774: ; [06]: 1 if objects collide
                            	  7775: ; [0A]: horizontal distance
                            	  7776: ; [0B]: vertical distance
                            	  7777: ;
                            	  7778: ;
                            	  7779: ; Reset [06] to indicate no collision by default.
                            	  7780: ;
                            	  7781:     even
                            	  7782: DoObjectsCollideWithThresholds:
02:000320BE 7000            	  7783:     moveq   #0,D0
02:000320C0 19400006        	  7784:     move.b  D0,($0006,A4)
02:000320C4 7600            	  7785:     moveq   #0,D3
02:000320C6 1614            	  7786:     move.b  ($0000,A4),D3
                            	  7787:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7788:     ;
02:000320C8 102C0002        	  7789:     move.b  ($0002,A4),D0
02:000320CC 003C0011        	  7790:     ori     #$11,CCR  ; SEC: set C+X
02:000320D0 122C0004        	  7791:     move.b  ($0004,A4),D1
02:000320D4 0A3C0010        	  7792:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320D8 9101            	  7793:     subx.b  D1,D0   ; SBC $04
02:000320DA 0A3C0010        	  7794:     eori    #$10,CCR  ; restore X = 6502 C
02:000320DE 6100E862        	  7795:     jsr     Abs
02:000320E2 1940000A        	  7796:     move.b  D0,($000A,A4)
                            	  7797:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7798:     ;
02:000320E6 122C000D        	  7799:     move.b  ($000D,A4),D1
02:000320EA B001            	  7800:     cmp.b   D1,D0
02:000320EC 642A            	  7801:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7802:     ; Store in [0B] the vertical distance between the two objects.
                            	  7803:     ;
02:000320EE 102C0003        	  7804:     move.b  ($0003,A4),D0
02:000320F2 003C0011        	  7805:     ori     #$11,CCR  ; SEC: set C+X
02:000320F6 122C0005        	  7806:     move.b  ($0005,A4),D1
02:000320FA 0A3C0010        	  7807:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320FE 9101            	  7808:     subx.b  D1,D0   ; SBC $05
02:00032100 0A3C0010        	  7809:     eori    #$10,CCR  ; restore X = 6502 C
02:00032104 6100E83C        	  7810:     jsr     Abs
02:00032108 1940000B        	  7811:     move.b  D0,($000B,A4)
                            	  7812:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7813:     ;
02:0003210C 122C000E        	  7814:     move.b  ($000E,A4),D1
02:00032110 B001            	  7815:     cmp.b   D1,D0
02:00032112 6404            	  7816:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7817:     ; If we get here, then the objects are close enough in both axes.
                            	  7818:     ; Return 1.
                            	  7819:     ;
02:00032114 522C0006        	  7820:     addq.b  #1,($0006,A4)
                            	  7821:     even
                            	  7822: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:00032118 102C0006        	  7823:     move.b  ($0006,A4),D0
02:0003211C 4E75            	  7824:     rts
                            	  7825: 
                            	  7826: ; Params:
                            	  7827: ; X: caller's object index, a monster
                            	  7828: ;    the attacker, if monster attacks Link
                            	  7829: ;    else defender, if weapon attacks monster
                            	  7830: ; [00]: 0 if monster attacks Link (defender),
                            	  7831: ;       else weapon slot (attacker)
                            	  7832: ; [09]: damage type,
                            	  7833: ;       only if a monster is defending
                            	  7834: ; TODO:
                            	  7835: ; [0B]: direction
                            	  7836: ;
                            	  7837: ; Only monsters (and fire) call this routine.
                            	  7838: ;
                            	  7839: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7840: ;
                            	  7841: ; On the other hand, if a weapon attacks a monster,
                            	  7842: ; the monster sets [00] to the weapon's slot.
                            	  7843: ;
                            	  7844: ;
                            	  7845: ; If a weapon attacks a monster, and the weapon's damage
                            	  7846: ; type matches the monster's invincibility mask;
                            	  7847: ; then return without shoving.
                            	  7848: ;
                            	  7849: ; If a monster attacks Link, then damage type will be 0.
                            	  7850: ;
                            	  7851:     even
                            	  7852: BeginShove:
02:0003211E 7600            	  7853:     moveq   #0,D3
02:00032120 1614            	  7854:     move.b  ($0000,A4),D3
02:00032122 0C02000D        	  7855:     cmpi.b  #$0D,D2
02:00032126 6412            	  7856:     bcc  _anon_z01_99
02:00032128 41EC04B2        	  7857:     lea     ($04B2,A4),A0
02:0003212C 10302000        	  7858:     move.b  (A0,D2.W),D0
02:00032130 122C0009        	  7859:     move.b  ($0009,A4),D1
02:00032134 C001            	  7860:     and.b  D1,D0
02:00032136 660000C4        	  7861:     bne  _L_z01_BeginShove_Exit
                            	  7862: _anon_z01_99:
                            	  7863:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7864:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7865:     ;
                            	  7866:     ; If instead a monster is defending, then all this calculation
                            	  7867:     ; won't matter, because the shove direction will be set to the
                            	  7868:     ; weapon's direction.
                            	  7869:     ;
                            	  7870:     ; As such, calculate a direction from the monster to the defender,
                            	  7871:     ; assuming it's Link.
                            	  7872:     ;
                            	  7873:     ; Start with an assumption that the direction is vertical:
                            	  7874:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7875:     ;
02:0003213A 7008            	  7876:     moveq   #8,D0
02:0003213C 19400008        	  7877:     move.b  D0,($0008,A4)
02:00032140 41EC0084        	  7878:     lea     ($0084,A4),A0
02:00032144 10302000        	  7879:     move.b  (A0,D2.W),D0
02:00032148 19400004        	  7880:     move.b  D0,($0004,A4)
02:0003214C 41EC0084        	  7881:     lea     ($0084,A4),A0
02:00032150 10303000        	  7882:     move.b  (A0,D3.W),D0
02:00032154 19400005        	  7883:     move.b  D0,($0005,A4)
                            	  7884:     ; If the defender is Link and his grid offset <> 0 then
                            	  7885:     ; use his usual object direction variable to determine
                            	  7886:     ; which axis to check.
                            	  7887:     ;
02:00032158 4A03            	  7888:     cmpi.b  #$00,D3
02:0003215A 6612            	  7889:     bne  _anon_z01_100
02:0003215C 102C0394        	  7890:     move.b  ($0394,A4),D0
02:00032160 670C            	  7891:     beq  _anon_z01_100
02:00032162 102C0098        	  7892:     move.b  ($0098,A4),D0
02:00032166 02000003        	  7893:     andi.b #$03,D0
02:0003216A 660C            	  7894:     bne  _L_z01_BeginShove_CheckHorizontal
02:0003216C 6720            	  7895:     beq  _L_z01_BeginShove_CheckVertical
                            	  7896: _anon_z01_100:
                            	  7897:     ; For monsters defending, or Link with grid offset = 0,
                            	  7898:     ; check direction in [0B].
                            	  7899:     ;
                            	  7900:     ; For monsters defending, this won't matter. For Link with grid
                            	  7901:     ; offset = 0, I believe the result will be arbitrary.
                            	  7902:     ;
                            	  7903:     ; TODO:
                            	  7904:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7905:     ; It doesn't seem to be if candle fire attacks him.
                            	  7906:     ;
02:0003216E 102C000B        	  7907:     move.b  ($000B,A4),D0
02:00032172 0C000004        	  7908:     cmpi.b  #$04,D0
02:00032176 6416            	  7909:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7910:     even
                            	  7911: _L_z01_BeginShove_CheckHorizontal:
                            	  7912:     ; If the direction checked is left or right,
                            	  7913:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7914:     ;
02:00032178 7002            	  7915:     moveq   #2,D0
02:0003217A 19400008        	  7916:     move.b  D0,($0008,A4)
02:0003217E 10342070        	  7917:     move.b  ($70,A4,D2.W),D0
02:00032182 19400004        	  7918:     move.b  D0,($0004,A4)
02:00032186 10343070        	  7919:     move.b  ($70,A4,D3.W),D0
02:0003218A 19400005        	  7920:     move.b  D0,($0005,A4)
                            	  7921:     even
                            	  7922: _L_z01_BeginShove_CheckVertical:
                            	  7923:     ; If the monster is down or right of the other object,
                            	  7924:     ; then use the opposite direction already in [08].
                            	  7925:     ; Else shift [08] right to turn it into the opposite
                            	  7926:     ; direction up or down.
                            	  7927:     ;
                            	  7928:     ; Again assuming Link is the defender; after this, [08] points
                            	  7929:     ; Link away from the monster.
                            	  7930:     ;
02:0003218E 102C0004        	  7931:     move.b  ($0004,A4),D0
02:00032192 122C0005        	  7932:     move.b  ($0005,A4),D1
02:00032196 B001            	  7933:     cmp.b   D1,D0
02:00032198 640A            	  7934:     bcc  _anon_z01_101
02:0003219A 122C0008        	  7935:     move.b  ($0008,A4),D1
02:0003219E E209            	  7936:     lsr.b  #1,D1   ; LSR $08
02:000321A0 19410008        	  7937:     move.b  D1,($0008,A4)
                            	  7938: _anon_z01_101:
                            	  7939:     ; If a monster is the defender, go handle it separately.
                            	  7940:     ;
02:000321A4 4A03            	  7941:     cmpi.b  #$00,D3
02:000321A6 6656            	  7942:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7943:     ; Link is the defender.
