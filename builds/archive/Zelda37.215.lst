02:0003BB30 123C0008        	  5421:     move.b  #$08,D1
02:0003BB34 D101            	  5422:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB36 41EC0412        	  5423:     lea     ($0412,A4),A0
02:0003BB3A 11802000        	  5424:     move.b  D0,(A0,D2.W)
02:0003BB3E 101D            	  5425:     move.b  (A5)+,D0  ; PLA
02:0003BB40 4600            	  5426:     eori.b #$FF,D0
02:0003BB42 023C00EE        	  5427:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB46 123C0001        	  5428:     move.b  #$01,D1
02:0003BB4A D101            	  5429:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5430: _anon_z04_71:
                            	  5431:     ; Add the distance and Link's minor coordinate to calculate
                            	  5432:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5433:     ; In general, the monster will be put in front of Link.
                            	  5434:     ;
02:0003BB4C 023C00EE        	  5435:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB50 1214            	  5436:     move.b  ($0000,A4),D1
02:0003BB52 D101            	  5437:     addx.b  D1,D0   ; ADC $00
02:0003BB54 19400004        	  5438:     move.b  D0,($0004,A4)
                            	  5439:     ; By default, will return index 0 to choose the minimum value
                            	  5440:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5441:     ; if Link is at the wall with a smaller major coordinate.
                            	  5442:     ;
02:0003BB58 7600            	  5443:     moveq   #0,D3
                            	  5444:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5445:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5446:     ; to access the block for the other direction along the same axis,
                            	  5447:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5448:     ;
02:0003BB5A 102C0001        	  5449:     move.b  ($0001,A4),D0
02:0003BB5E 122C0003        	  5450:     move.b  ($0003,A4),D1
02:0003BB62 B001            	  5451:     cmp.b   D1,D0
02:0003BB64 671C            	  5452:     beq  _anon_z04_72
