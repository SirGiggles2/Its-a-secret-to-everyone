                            	   964: InitMode7_Sub2:
                            	   965:     ; This transfers a room's play area tiles to nametable 2.
                            	   966:     ;
                            	   967:     ; CurRow starts at the bottom ($15).
02:000406F6 61003A60        	   968:     jsr     CopyRowToTileBuf
02:000406FA 102C0302        	   969:     move.b  ($0302,A4),D0
                            	   970:     ; Change the target nametable from 0 to 2.
                            	   971:     ;
                            	   972:     ; Because there's only a play area and no status bar in
                            	   973:     ; nametable 2, you have to add 7 to the high byte instead of 8.
                            	   974:     ; So, the top of the play area in NT 0 is at $2100.
                            	   975:     ; But the top of the play area in NT 2 is at $2800.
                            	   976:     ;
                            	   977:     ; This assumes that you want to scroll vertically, where the
                            	   978:     ; two scroll areas must be contiguous vertically.
02:000406FE 0200000F        	   979:     andi.b #$0F,D0
02:00040702 023C00EE        	   980:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040706 123C0027        	   981:     move.b  #$27,D1
02:0004070A D101            	   982:     addx.b  D1,D0   ; ADC #$27 (X flag = 6502 C)
02:0004070C 19400302        	   983:     move.b  D0,($0302,A4)
02:00040710 102C0098        	   984:     move.b  ($0098,A4),D0
02:00040714 0C000004        	   985:     cmpi.b  #$04,D0
02:00040718 6404            	   986:     bcc  _anon_z05_20
                            	   987:     ; then you DO have to account for the status bar.
                            	   988:     ; So, add $100 (by incrementing high byte) to move
                            	   989:     ; everything down 64 pixels.
                            	   990:     ;
                            	   991:     ; Now the play areas will line up in NT 0 and NT 2 when
                            	   992:     ; we change mirroring to vertical at the end of this mode.
02:0004071A 522C0302        	   993:     addq.b  #1,($0302,A4)
