02:00041B9E 6710            	  3194:     beq  _anon_z05_76
02:00041BA0 1003            	  3195:     move.b  D3,D0
02:00041BA2 023C00EE        	  3196:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BA6 123C0004        	  3197:     move.b  #$04,D1
02:00041BAA D101            	  3198:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041BAC 7600            	  3199:     moveq   #0,D3
02:00041BAE 1600            	  3200:     move.b  D0,D3
                            	  3201: _anon_z05_76:
                            	  3202:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3203:     ;
02:00041BB0 7000            	  3204:     moveq   #0,D0
                            	  3205: ; Params:
                            	  3206: ; A: mask of buttons to block
                            	  3207: ; Y: offset into BorderBounds
                            	  3208: ; [00]: direction
                            	  3209: ; [02]: coordinate
                            	  3210: ;
                            	  3211: ; Returns:
                            	  3212: ; [01]: button mask that was used
                            	  3213: ;       (set to $FF if boundary not crossed)
                            	  3214: ;
                            	  3215:     even
                            	  3216: MaskInputInBorder:
02:00041BB2 19400001        	  3217:     move.b  D0,($0001,A4)
