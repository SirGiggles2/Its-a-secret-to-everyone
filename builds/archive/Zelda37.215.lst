                            	  4339: PlayerScreenEdgeBounds:
02:0004BFE0 3D              	  4340:     dc.b    $3D, $DD, $00, $F0
02:0004BFE1 DD
02:0004BFE2 00
02:0004BFE3 F0
                            	  4341: 
                            	  4342: ; Params:
                            	  4343: ; [0E]: $FF, if blocked by a door
                            	  4344: ; [0F]: movement direction
                            	  4345: ;
                            	  4346: ; Returns:
                            	  4347: ; [0F]: untouched, or changed if blocked or need to change
                            	  4348: ;
                            	  4349: ; Summary:
                            	  4350: ;
                            	  4351: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4352: ; Then allow movement or go to the next room. Otherwise,
                            	  4353: ; check passive tile objects and stop moving.
                            	  4354: ;
                            	  4355: ; For other objects: First, if moving, test the colliding tile for
                            	  4356: ; walkability. Otherwise search for a walkable direction starting
                            	  4357: ; from input direction.
                            	  4358: ;
                            	  4359: ; When you find a walkable direction, see if it makes the object
                            	  4360: ; cross a boundary. If it doesn't, then make this direction
                            	  4361: ; the objection direction. Otherwise, keep looping.
                            	  4362: ;
                            	  4363: ; If no walkable direction is found, then stop moving.
                            	  4364: ;
                            	  4365: ;
                            	  4366: ; if is player
                            	  4367: ;   if at doorway
                            	  4368: ;     go handle a walkable direction
                            	  4369: ;   if blocked by door
                            	  4370: ;     return
                            	  4371: ;
                            	  4372:     even
                            	  4373: Walker_CheckTileCollision:
                            	  4374:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4375:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4376:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4377:     ; reset) for Link and every other object. Only the tile
                            	  4378:     ; walkability decision in CheckTiles is overridden.
02:0004BFE4 4A02            	  4379:     cmpi.b  #$00,D2
02:0004BFE6 6614            	  4380:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004BFE8 102C0053        	  4381:     move.b  ($0053,A4),D0
02:0004BFEC 6704            	  4382:     beq  _anon_z07_16
02:0004BFEE 600000BE        	  4383:     jmp     GoWalkableDir
                            	  4384: 
                            	  4385: _anon_z07_16:
02:0004BFF2 102C000E        	  4386:     move.b  ($000E,A4),D0
