02:0003CC42 4EB900031564    	  7785:     jsr     DrawObjectNotMirrored
                            	  7786:     even
                            	  7787: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CC48 101D            	  7788:     move.b  (A5)+,D0  ; PLA
02:0003CC4A 7600            	  7789:     moveq   #0,D3
02:0003CC4C 1600            	  7790:     move.b  D0,D3
                            	  7791:     ; If facing vertically, then return. There's no other side to draw.
                            	  7792:     ;
02:0003CC4E 41EC0098        	  7793:     lea     ($0098,A4),A0
02:0003CC52 10302000        	  7794:     move.b  (A0,D2.W),D0
02:0003CC56 02000003        	  7795:     andi.b #$03,D0
02:0003CC5A 6602            	  7796:     bne.s  __far_z_04_0072
02:0003CC5C 602E            	  7797:     jmp  L11B00_Exit
                            	  7798: __far_z_04_0072:
                            	  7799:     ; Else draw the right side.
                            	  7800:     ;
                            	  7801:     ; Keep the Y coordinate in [01].
                            	  7802:     ; But, store (X + $10) in [00].
                            	  7803:     ;
02:0003CC5E 10342070        	  7804:     move.b  ($70,A4,D2.W),D0
02:0003CC62 023C00EE        	  7805:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC66 123C0010        	  7806:     move.b  #$10,D1
02:0003CC6A D101            	  7807:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CC6C 1880            	  7808:     move.b  D0,($0000,A4)
02:0003CC6E 6114            	  7809:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7810:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7811:     ;
                            	  7812:     ; So, if we had animation frame 1, direction left:
                            	  7813:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7814:     ; - frame image index = 6 (1 + 5)
                            	  7815:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7816:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7817:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7818:     ;
                            	  7819:     ; So, 3 would have been the frame number used above for
                            	  7820:     ; the left side.
                            	  7821:     ;
                            	  7822:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7823:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7824:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7825:     ; on the right.
                            	  7826:     ;
02:0003CC70 41F90003CB66    	  7827:     lea     (DodongoFrameImages).l,A0
02:0003CC76 10303000        	  7828:     move.b  (A0,D3.W),D0
02:0003CC7A 0A000001        	  7829:     eori.b #$01,D0
02:0003CC7E 4EF900031564    	  7830:     jmp     DrawObjectNotMirrored
                            	  7831: 
                            	  7832: ; Returns:
                            	  7833: ; A: 3
                            	  7834: ; [04]: left sprite attributes
                            	  7835: ; [05]: right sprite attributes
                            	  7836: ;
                            	  7837:     even
                            	  7838: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CC84 7003            	  7839:     moveq   #3,D0
02:0003CC86 4EB900031856    	  7840:     jsr     Anim_SetSpriteDescriptorAttributes
