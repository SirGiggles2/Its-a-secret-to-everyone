                            	 12006: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EC24 10342070        	 12007:     move.b  ($70,A4,D2.W),D0
02:0003EC28 1B00            	 12008:     move.b  D0,-(A5)  ; PHA
                            	 12009:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 12010:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 12011:     ;
02:0003EC2A 023C00EE        	 12012:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EC2E 123C0004        	 12013:     move.b  #$04,D1
02:0003EC32 D101            	 12014:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EC34 19802070        	 12015:     move.b  D0,($70,A4,D2.W)
                            	 12016:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 12017:     ; to store in [03].
                            	 12018:     ;
02:0003EC38 102C04E6        	 12019:     move.b  ($04E6,A4),D0
02:0003EC3C 0A000003        	 12020:     eori.b #$03,D0
02:0003EC40 19400003        	 12021:     move.b  D0,($0003,A4)
                            	 12022:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 12023:     ;
02:0003EC44 103C009E        	 12024:     move.b  #$9E,D0
02:0003EC48 0C020005        	 12025:     cmpi.b  #$05,D2
02:0003EC4C 670A            	 12026:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC4E 0C02000A        	 12027:     cmpi.b  #$0A,D2
02:0003EC52 6704            	 12028:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC54 103C00A0        	 12029:     move.b  #$A0,D0
                            	 12030:     even
                            	 12031: _L_z04_UpdateLamnola_Draw:
02:0003EC58 4EB900031860    	 12032:     jsr     Anim_WriteSprite
02:0003EC5E 101D            	 12033:     move.b  (A5)+,D0  ; PLA
02:0003EC60 19802070        	 12034:     move.b  D0,($70,A4,D2.W)
02:0003EC64 41EC0098        	 12035:     lea     ($0098,A4),A0
02:0003EC68 10302000        	 12036:     move.b  (A0,D2.W),D0
02:0003EC6C 1B00            	 12037:     move.b  D0,-(A5)  ; PHA
02:0003EC6E 4EB9000318E0    	 12038:     jsr     CheckMonsterCollisions
02:0003EC74 101D            	 12039:     move.b  (A5)+,D0  ; PLA
02:0003EC76 41EC0098        	 12040:     lea     ($0098,A4),A0
02:0003EC7A 11802000        	 12041:     move.b  D0,(A0,D2.W)
                            	 12042:     ; If still alive, then return.
                            	 12043:     ;
02:0003EC7E 41EC0405        	 12044:     lea     ($0405,A4),A0
02:0003EC82 10302000        	 12045:     move.b  (A0,D2.W),D0
02:0003EC86 6604            	 12046:     bne.s  __far_z_04_0120
02:0003EC88 6000FF72        	 12047:     jmp  L129EA_Exit
                            	 12048: __far_z_04_0120:
                            	 12049:     ; Otherwise, the segment is dead.
                            	 12050:     ;
02:0003EC8C 4EB90004BC4E    	 12051:     jsr     ResetShoveInfo
                            	 12052:     ; Set the current segment's HP to the initial value in anticipation
                            	 12053:     ; of bringing this segment back to life.
                            	 12054:     ;
02:0003EC92 7020            	 12055:     moveq   #32,D0
02:0003EC94 41EC0485        	 12056:     lea     ($0485,A4),A0
02:0003EC98 11802000        	 12057:     move.b  D0,(A0,D2.W)
                            	 12058:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 12059:     ;
                            	 12060:     ; From the lowest slot, look for one that has the original lamnola
                            	 12061:     ; object type.
                            	 12062:     ;
                            	 12063:     ; The goal is to swap the current dead segment with the tail segment.
                            	 12064:     ;
02:0003EC9C 163C00FF        	 12065:     move.b  #$FF,D3
02:0003ECA0 0C020006        	 12066:     cmpi.b  #$06,D2
02:0003ECA4 6502            	 12067:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003ECA6 7604            	 12068:     moveq   #4,D3
                            	 12069:     even
                            	 12070: _L_z04_UpdateLamnola_FindTail:
02:0003ECA8 5203            	 12071:     addq.b  #1,D3
02:0003ECAA 41EC0350        	 12072:     lea     ($0350,A4),A0
02:0003ECAE 10303000        	 12073:     move.b  (A0,D3.W),D0
02:0003ECB2 122C04E7        	 12074:     move.b  ($04E7,A4),D1
02:0003ECB6 B001            	 12075:     cmp.b   D1,D0
02:0003ECB8 66EE            	 12076:     bne  _L_z04_UpdateLamnola_FindTail
                            	 12077:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 12078:     ;
02:0003ECBA 7011            	 12079:     moveq   #17,D0
02:0003ECBC 19803029        	 12080:     move.b  D0,($29,A4,D3.W)
                            	 12081:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 12082:     ; to the tail segment.
                            	 12083:     ;
02:0003ECC0 41EC04F0        	 12084:     lea     ($04F0,A4),A0
02:0003ECC4 10302000        	 12085:     move.b  (A0,D2.W),D0
02:0003ECC8 41EC04F1        	 12086:     lea     ($04F1,A4),A0
02:0003ECCC 11803000        	 12087:     move.b  D0,(A0,D3.W)
02:0003ECD0 10342070        	 12088:     move.b  ($70,A4,D2.W),D0
02:0003ECD4 19803071        	 12089:     move.b  D0,($71,A4,D3.W)
02:0003ECD8 41EC0084        	 12090:     lea     ($0084,A4),A0
02:0003ECDC 10302000        	 12091:     move.b  (A0,D2.W),D0
02:0003ECE0 41EC0085        	 12092:     lea     ($0085,A4),A0
02:0003ECE4 11803000        	 12093:     move.b  D0,(A0,D3.W)
                            	 12094:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 12095:     ; So, return and leave it dead.
                            	 12096:     ;
02:0003ECE8 0C030004        	 12097:     cmpi.b  #$04,D3
02:0003ECEC 6604            	 12098:     bne.s  __far_z_04_0121
02:0003ECEE 6000FF0C        	 12099:     jmp  L129EA_Exit
                            	 12100: __far_z_04_0121:
02:0003ECF2 0C030009        	 12101:     cmpi.b  #$09,D3
02:0003ECF6 6604            	 12102:     bne.s  __far_z_04_0122
02:0003ECF8 6000FF02        	 12103:     jmp  L129EA_Exit
                            	 12104: __far_z_04_0122:
                            	 12105:     ; Change the tail segment to the dead dummy object, and
                            	 12106:     ; bring the current segment back to life.
                            	 12107:     ;
02:0003ECFC 705D            	 12108:     moveq   #93,D0
02:0003ECFE 41EC0350        	 12109:     lea     ($0350,A4),A0
02:0003ED02 11803000        	 12110:     move.b  D0,(A0,D3.W)
02:0003ED06 4EF90004DB18    	 12111:     jmp     ResetObjMetastate
