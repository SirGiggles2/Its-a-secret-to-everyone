02:0003E792 123C0041        	 11408:     move.b  #$41,D1
02:0003E796 0A3C0010        	 11409:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E79A 9101            	 11410:     subx.b  D1,D0   ; SBC #$41
