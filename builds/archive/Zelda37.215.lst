                            	   645:     ; Shift the level test bit [06] left to test the next level.
                            	   646:     ; When it becomes 0, we're done.
                            	   647:     ;
02:0004046A 122C0006        	   648:     move.b  ($0006,A4),D1
02:0004046E E309            	   649:     lsl.b  #1,D1   ; ASL $06
02:00040470 19410006        	   650:     move.b  D1,($0006,A4)
02:00040474 669E            	   651:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:00040476 522C00E1        	   652:     addq.b  #1,($00E1,A4)
02:0004047A 4E75            	   653:     rts
