                            	  7569: ; X: monster object slot
                            	  7570: ; [00]: weapon object slot
                            	  7571: ; [02]: monster object mid X
                            	  7572: ; [03]: monster object mid Y
                            	  7573: ; [09]: damage type
                            	  7574: ; [0D]: horizontal threshold
                            	  7575: ;
                            	  7576: ; Returns:
                            	  7577: ; [06]: 1 if objects collide
                            	  7578: ;
                            	  7579:     even
