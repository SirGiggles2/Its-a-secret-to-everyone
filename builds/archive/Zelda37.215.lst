                            	  5435:     ;
02:0004C6E0 41EC0098        	  5436:     lea     ($0098,A4),A0
02:0004C6E4 10302000        	  5437:     move.b  (A0,D2.W),D0
02:0004C6E8 0C0000E8        	  5438:     cmpi.b  #$E8,D0
02:0004C6EC 6702            	  5439:     beq.s  __far_z_07_0081
