02:0004C682 0C00003E        	  5373:     cmpi.b  #$3E,D0
02:0004C686 6514            	  5374:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C688 0C0000E8        	  5375:     cmpi.b  #$E8,D0
