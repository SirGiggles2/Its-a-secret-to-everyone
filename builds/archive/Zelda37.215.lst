02:0003CE02 020000FC        	  8024:     andi.b #$FC,D0
02:0003CE06 0C0000B0        	  8025:     cmpi.b  #$B0,D0
02:0003CE0A 6742            	  8026:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CE0C 0C0000F4        	  8027:     cmpi.b  #$F4,D0
