02:0003A936 D101            	  2902:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A938 7600            	  2903:     moveq   #0,D3
02:0003A93A 1600            	  2904:     move.b  D0,D3
02:0003A93C 41F90003A7EA    	  2905:     lea     (JumperYAccelerations).l,A0
02:0003A942 10303000        	  2906:     move.b  (A0,D3.W),D0
02:0003A946 7602            	  2907:     moveq   #2,D3
02:0003A948 61000162        	  2908:     jsr     Jumper_MoveY
                            	  2909:     ; If the facing direction has a left component, then
                            	  2910:     ; subtract 1 from the object's X.
