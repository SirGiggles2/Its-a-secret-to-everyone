02:0003A8DE 41F90003A808    	  2850:     lea     (JumperStartSpeedsHi).l,A0
02:0003A8E4 10303000        	  2851:     move.b  (A0,D3.W),D0
02:0003A8E8 41EC0412        	  2852:     lea     ($0412,A4),A0
02:0003A8EC 11802000        	  2853:     move.b  D0,(A0,D2.W)
                            	  2854:     ; Reset the vertical speed low byte.
