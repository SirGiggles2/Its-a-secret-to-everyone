02:0003AD12 163C00D8        	  3397:     move.b  #$D8,D3
                            	  3398: _anon_z04_44:
02:0003AD16 1883            	  3399:     move.b  D3,($0000,A4)
                            	  3400:     ; Add Link's Y and the vertical offset.
