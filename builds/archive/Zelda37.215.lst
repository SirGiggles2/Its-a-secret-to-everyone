02:0003F120 162C045F        	 12708:     move.b  ($045F,A4),D3
                            	 12709:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12710:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12711:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12712:     ;
02:0003F124 41EC034F        	 12713:     lea     ($034F,A4),A0
02:0003F128 10302000        	 12714:     move.b  (A0,D2.W),D0
02:0003F12C 0C000025        	 12715:     cmpi.b  #$25,D0
02:0003F130 661E            	 12716:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F132 41F90003F024    	 12717:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F138 10303000        	 12718:     move.b  (A0,D3.W),D0
02:0003F13C 1B00            	 12719:     move.b  D0,-(A5)  ; PHA
02:0003F13E 41F90003F028    	 12720:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F144 10303000        	 12721:     move.b  (A0,D3.W),D0
02:0003F148 7600            	 12722:     moveq   #0,D3
02:0003F14A 1600            	 12723:     move.b  D0,D3
02:0003F14C 101D            	 12724:     move.b  (A5)+,D0  ; PLA
02:0003F14E 600E            	 12725:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12726: 
                            	 12727:     even
                            	 12728: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12729:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12730:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12731:     ; a small circle (5) and a large circle (6).
                            	 12732:     ;
02:0003F150 41F90003F026    	 12733:     lea     (PatraChild2RotationBits).l,A0
02:0003F156 10303000        	 12734:     move.b  (A0,D3.W),D0
02:0003F15A 7600            	 12735:     moveq   #0,D3
02:0003F15C 1600            	 12736:     move.b  D0,D3
