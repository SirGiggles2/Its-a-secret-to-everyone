02:0003F1EC 0200000F        	 12820:     andi.b #$0F,D0
02:0003F1F0 0C000004        	 12821:     cmpi.b  #$04,D0
02:0003F1F4 6702            	 12822:     beq.s  __far_z_04_0126
02:0003F1F6 6042            	 12823:     jmp  Ganon_DrawBodyFrame0
                            	 12824: __far_z_04_0126:
