                            	 10181: _anon_z04_121:
                            	 10182:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10183:     ;
02:0003DE7E 41EC0412        	 10184:     lea     ($0412,A4),A0
02:0003DE82 10302000        	 10185:     move.b  (A0,D2.W),D0
02:0003DE86 0C000020        	 10186:     cmpi.b  #$20,D0
