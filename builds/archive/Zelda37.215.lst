02:0003C890 41EC042C        	  7216:     lea     ($042C,A4),A0
02:0003C894 10302000        	  7217:     move.b  (A0,D2.W),D0
02:0003C898 4EB90002AECA    	  7218:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7219:     even
                            	  7220: UpdateDodongoState1_Bloated_JumpTable:
02:0003C89E 0003C8B2        	  7221:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8A2 0003C8B2        	  7222:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8A6 0003C8B2        	  7223:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8AA 0003C94A        	  7224:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8AE 0003C954        	  7225:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
