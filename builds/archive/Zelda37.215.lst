                            	  7144: UpdateDodongoState0_Move:
                            	  7145:     ; If facing left, then push X offset 0 on the stack.
                            	  7146:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7147:     ;
                            	  7148:     ; We would like to use one set of coordinates only.
                            	  7149:     ; But movement would break down, if we did; because
                            	  7150:     ; Dodongo is so long.
                            	  7151:     ;
                            	  7152:     ; So, when not facing left, we temporarily shift the
                            	  7153:     ; X coordinate to be closer to the other side of the monster.
                            	  7154:     ;
02:0003C81A 7600            	  7155:     moveq   #0,D3
02:0003C81C 41EC0098        	  7156:     lea     ($0098,A4),A0
02:0003C820 10302000        	  7157:     move.b  (A0,D2.W),D0
02:0003C824 0200000D        	  7158:     andi.b #$0D,D0
02:0003C828 6716            	  7159:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C82A 10342070        	  7160:     move.b  ($70,A4,D2.W),D0
02:0003C82E 023C00EE        	  7161:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C832 123C0010        	  7162:     move.b  #$10,D1
02:0003C836 D101            	  7163:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C838 19802070        	  7164:     move.b  D0,($70,A4,D2.W)
02:0003C83C 163C00F0        	  7165:     move.b  #$F0,D3
                            	  7166:     even
                            	  7167: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C840 1003            	  7168:     move.b  D3,D0
02:0003C842 1B00            	  7169:     move.b  D0,-(A5)  ; PHA
02:0003C844 7020            	  7170:     moveq   #32,D0
02:0003C846 41EC041F        	  7171:     lea     ($041F,A4),A0
02:0003C84A 11802000        	  7172:     move.b  D0,(A0,D2.W)
02:0003C84E 6100CEF4        	  7173:     jsr     Wanderer_TargetPlayer
                            	  7174:     ; Pop the offset and add it to the X coordinate.
                            	  7175:     ;
                            	  7176:     ; This brings the X coordinate back to the unique value
                            	  7177:     ; that represents the position.
                            	  7178:     ;
02:0003C852 101D            	  7179:     move.b  (A5)+,D0  ; PLA
02:0003C854 023C00EE        	  7180:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C858 12342070        	  7181:     move.b  ($70,A4,D2.W),D1
02:0003C85C D101            	  7182:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C85E 19802070        	  7183:     move.b  D0,($70,A4,D2.W)
                            	  7184:     ; If X coordinate < $20, then face right.
                            	  7185:     ;
02:0003C862 0C000020        	  7186:     cmpi.b  #$20,D0
02:0003C866 640A            	  7187:     bcc  _anon_z04_89
02:0003C868 7001            	  7188:     moveq   #1,D0
02:0003C86A 41EC0098        	  7189:     lea     ($0098,A4),A0
02:0003C86E 11802000        	  7190:     move.b  D0,(A0,D2.W)
                            	  7191: _anon_z04_89:
02:0003C872 0A3C0001        	  7192:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C876 4E75            	  7193:     rts
