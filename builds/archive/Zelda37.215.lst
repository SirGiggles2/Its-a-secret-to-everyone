                            	  5928: _L_z01_CheckMazes_PlaySecretTune:
                            	  5929:     ; Play secret tune, and let the player leave the maze.
                            	  5930:     ;
02:000312FE 7004            	  5931:     moveq   #4,D0
02:00031300 19400602        	  5932:     move.b  D0,($0602,A4)
02:00031304 4E75            	  5933:     rts
                            	  5934: 
                            	  5935: ; Params:
                            	  5936: ; [02]: Y
                            	  5937: ; [03]: X
                            	  5938: ;
                            	  5939: ; Returns:
                            	  5940: ; [00]: high byte of PPU address
                            	  5941: ; [01]: low byte of PPU address
                            	  5942: ;
                            	  5943: ;
                            	  5944: ; Turn the 16-bit value 08YY into the PPU address
                            	  5945: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5946: ;
                            	  5947: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5948: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5949: ;
                            	  5950:     even
                            	  5951: MapScreenPosToPpuAddr:
02:00031306 6000A75E        	  5952:     jmp     c_map_screen_pos_to_ppu_addr
                            	  5953: 
