02:00032030 8001            	  7635:     or.b  D1,D0
02:00032032 0C00000C        	  7636:     cmpi.b  #$0C,D0
02:00032036 6602            	  7637:     bne.s  __far_z_01_0093
02:00032038 600C            	  7638:     jmp  PlayParryTune
                            	  7639: __far_z_01_0093:
