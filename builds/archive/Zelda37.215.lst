02:0004D70A 1940004B        	  7614:     move.b  D0,($004B,A4)
02:0004D70E 41EC0492        	  7615:     lea     ($0492,A4),A0
02:0004D712 11802000        	  7616:     move.b  D0,(A0,D2.W)
02:0004D716 4E75            	  7617:     rts
                            	  7618:     even
