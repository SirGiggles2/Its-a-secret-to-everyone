                            	  1637: Zol_CheckCollisions:
                            	  1638:     ; If not in state 0, then return.
                            	  1639:     ;
02:0003A108 41EC00AC        	  1640:     lea     ($00AC,A4),A0
02:0003A10C 10302000        	  1641:     move.b  (A0,D2.W),D0
02:0003A110 665C            	  1642:     bne  _L_z04_Zol_CheckCollisions_Exit
                            	  1643:     ; Check collisions.
                            	  1644:     ;
                            	  1645:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1646:     ; then return.
                            	  1647:     ;
02:0003A112 610001F8        	  1648:     jsr     Gel_CheckCollisions
02:0003A116 41EC0405        	  1649:     lea     ($0405,A4),A0
02:0003A11A 10302000        	  1650:     move.b  (A0,D2.W),D0
02:0003A11E 664E            	  1651:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A120 41EC04F0        	  1652:     lea     ($04F0,A4),A0
02:0003A124 10302000        	  1653:     move.b  (A0,D2.W),D0
02:0003A128 6744            	  1654:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1655:     ; If vertically aligned with the square grid, then
                            	  1656:     ; use a horizontal direction mask (3).
                            	  1657:     ;
                            	  1658:     ; Keep in mind that most objects are aligned vertically when
                            	  1659:     ; the low nibble of their Y is $D.
                            	  1660:     ;
02:0003A12A 7600            	  1661:     moveq   #0,D3
02:0003A12C 41EC0084        	  1662:     lea     ($0084,A4),A0
02:0003A130 10302000        	  1663:     move.b  (A0,D2.W),D0
02:0003A134 0200000F        	  1664:     andi.b #$0F,D0
02:0003A138 0C00000D        	  1665:     cmpi.b  #$0D,D0
02:0003A13C 6602            	  1666:     bne  _anon_z04_26
02:0003A13E 7603            	  1667:     moveq   #3,D3
                            	  1668: _anon_z04_26:
02:0003A140 1883            	  1669:     move.b  D3,($0000,A4)
                            	  1670:     ; If horizontally aligned with the square grid, then
                            	  1671:     ; use a vertical direction mask ($C).
                            	  1672:     ;
02:0003A142 7600            	  1673:     moveq   #0,D3
02:0003A144 10342070        	  1674:     move.b  ($70,A4,D2.W),D0
02:0003A148 0200000F        	  1675:     andi.b #$0F,D0
02:0003A14C 6602            	  1676:     bne  _anon_z04_27
02:0003A14E 760C            	  1677:     moveq   #12,D3
                            	  1678: _anon_z04_27:
02:0003A150 1003            	  1679:     move.b  D3,D0
                            	  1680:     ; Combine the two masks. At most one will be 0.
                            	  1681:     ;
02:0003A152 1214            	  1682:     move.b  ($0000,A4),D1
02:0003A154 8001            	  1683:     or.b  D1,D0
                            	  1684:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1685:     ; with the grid.
                            	  1686:     ;
                            	  1687:     ; If so, then go to state 1 to do a "big shove".
                            	  1688:     ; Else go to state 2, to immediately split in two.
                            	  1689:     ;
                            	  1690:     ; Examples:
                            	  1691:     ; It would be aligned, if moving left along a tile as usual.
                            	  1692:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1693:     ; - The collision check routines would have made the zol
                            	  1694:     ;   face in the direction of the weapon.
                            	  1695:     ; - See CheckMonsterWeaponCollision.
                            	  1696:     ;
02:0003A156 122C0098        	  1697:     move.b  ($0098,A4),D1
02:0003A15A C001            	  1698:     and.b  D1,D0
02:0003A15C 6608            	  1699:     bne  _anon_z04_28
02:0003A15E 41EC00AC        	  1700:     lea     ($00AC,A4),A0
02:0003A162 52302000        	  1701:     addq.b  #1,(A0,D2.W)
                            	  1702: _anon_z04_28:
02:0003A166 41EC00AC        	  1703:     lea     ($00AC,A4),A0
02:0003A16A 52302000        	  1704:     addq.b  #1,(A0,D2.W)
                            	  1705:     even
