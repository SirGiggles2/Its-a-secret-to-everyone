02:00042372 6616            	  4305:     bne  _anon_z05_94
                            	  4306:     ; If the opposite of the facing direction is part of the input direction, then
                            	  4307:     ; face the opposite direction.
                            	  4308:     ;
02:00042374 102C0098        	  4309:     move.b  ($0098,A4),D0
02:00042378 4EB90003093E    	  4310:     jsr     GetOppositeDir
02:0004237E 122C03F8        	  4311:     move.b  ($03F8,A4),D1
02:00042382 C001            	  4312:     and.b  D1,D0
                            	  4313:     ; If neither direction matched input direction, then
                            	  4314:     ; change input direction to facing direction.
                            	  4315:     ;
02:00042384 6604            	  4316:     bne  _anon_z05_94
02:00042386 102C0098        	  4317:     move.b  ($0098,A4),D0
                            	  4318: _anon_z05_94:
