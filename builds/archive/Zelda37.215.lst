02:000360E2 7604            	  4567:     moveq   #4,D3
                            	  4568: _anon_z02_31:
02:000360E4 41F9000360C2    	  4569:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000360EA 10303000        	  4570:     move.b  (A0,D3.W),D0
02:000360EE 41EC0302        	  4571:     lea     ($0302,A4),A0
02:000360F2 11803000        	  4572:     move.b  D0,(A0,D3.W)
02:000360F6 5303            	  4573:     subq.b  #1,D3
02:000360F8 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:000360FA 102C045F        	  4579:     move.b  ($045F,A4),D0
02:000360FE 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:00036102 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:00036106 7000            	  4584:     moveq   #0,D0
02:00036108 1880            	  4585:     move.b  D0,($0000,A4)
02:0003610A 7000            	  4586:     moveq   #0,D0
02:0003610C 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:00036110 7600            	  4590:     moveq   #0,D3
02:00036112 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:00036116 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:0003611A 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:0003611C 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:00036120 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036124 E14C            	  4601:     lsl.w   #8,D4
02:00036126 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036128 48C4            	  4603:     ext.l   D4
02:0003612A D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036130 2044            	  4605:     movea.l D4,A0
02:00036132 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:00036136 0200003F        	  4611:     andi.b #$3F,D0
02:0003613A 0C000025        	  4612:     cmpi.b  #$25,D0
02:0003613E 67BA            	  4613:     beq  _anon_z02_32
                            	  4614:     ; We have a non-space character. Put it in the transfer record.
                            	  4615:     ;
02:00036140 19400305        	  4616:     move.b  D0,($0305,A4)
                            	  4617:     ; Play the "heart taken/character" tune.
                            	  4618:     ;
02:00036144 7010            	  4619:     moveq   #16,D0
02:00036146 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:0003614A 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:0003614C 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:00036150 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036154 E14C            	  4626:     lsl.w   #8,D4
02:00036156 8841            	  4627:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036158 48C4            	  4628:     ext.l   D4
