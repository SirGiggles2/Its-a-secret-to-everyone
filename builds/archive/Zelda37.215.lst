02:0004B116 7400            	  2350:     moveq   #0,D2
02:0004B118 142C0301        	  2351:     move.b  ($0301,A4),D2
                            	  2352:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2353:     ;
                            	  2354:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2355:     ; In total, 11 bytes will be written.
                            	  2356:     ;
                            	  2357:     ; First, write the high byte of PPU address in each record.
                            	  2358:     ;
02:0004B11C 1014            	  2359:     move.b  ($0000,A4),D0
02:0004B11E 41EC0302        	  2360:     lea     ($0302,A4),A0
02:0004B122 11802000        	  2361:     move.b  D0,(A0,D2.W)
02:0004B126 41EC0307        	  2362:     lea     ($0307,A4),A0
02:0004B12A 11802000        	  2363:     move.b  D0,(A0,D2.W)
                            	  2364:     ; Write the low address in the first record. In the second record,
                            	  2365:     ; write (low address + 1).
                            	  2366:     ;
02:0004B12E 102C0001        	  2367:     move.b  ($0001,A4),D0
02:0004B132 41EC0303        	  2368:     lea     ($0303,A4),A0
02:0004B136 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:0004B13A 41EC0308        	  2370:     lea     ($0308,A4),A0
02:0004B13E 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0004B142 41EC0308        	  2372:     lea     ($0308,A4),A0
02:0004B146 52302000        	  2373:     addq.b  #1,(A0,D2.W)
                            	  2374:     ; Write the first tile twice in each record. Patch them later.
                            	  2375:     ;
02:0004B14A 102C0005        	  2376:     move.b  ($0005,A4),D0
02:0004B14E 41EC0305        	  2377:     lea     ($0305,A4),A0
02:0004B152 11802000        	  2378:     move.b  D0,(A0,D2.W)
02:0004B156 41EC0306        	  2379:     lea     ($0306,A4),A0
02:0004B15A 11802000        	  2380:     move.b  D0,(A0,D2.W)
02:0004B15E 41EC030A        	  2381:     lea     ($030A,A4),A0
02:0004B162 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B166 41EC030B        	  2383:     lea     ($030B,A4),A0
02:0004B16A 11802000        	  2384:     move.b  D0,(A0,D2.W)
                            	  2385:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
