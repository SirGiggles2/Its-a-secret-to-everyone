02:0003CEA0 023C00EE        	  8105:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEA4 41F90003CD82    	  8106:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CEAA 12303000        	  8107:     move.b  (A0,D3.W),D1
