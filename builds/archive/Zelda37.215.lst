                            	 10130:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	 10131:     ;
02:0003DE0E 640000A8        	 10132:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	 10133:     ; Increase the distance traveled, and move 1.
                            	 10134:     ;
02:0003DE12 41EC0412        	 10135:     lea     ($0412,A4),A0
02:0003DE16 52302000        	 10136:     addq.b  #1,(A0,D2.W)
                            	 10137:     ; Set a direction mask in [02], starting with right (1).
                            	 10138:     ;
02:0003DE1A 7001            	 10139:     moveq   #1,D0
02:0003DE1C 19400002        	 10140:     move.b  D0,($0002,A4)
