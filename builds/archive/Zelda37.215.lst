02:0003A410 41F90003A334    	  2104:     lea     (StatueXs).l,A0
02:0003A416 10303000        	  2105:     move.b  (A0,D3.W),D0
02:0003A41A 19400002        	  2106:     move.b  D0,($0002,A4)
02:0003A41E 19802070        	  2107:     move.b  D0,($70,A4,D2.W)
                            	  2108:     ; Look up and set the Y coordinate for the fireball object.
                            	  2109:     ; Also store it in [03].
                            	  2110:     ;
02:0003A422 41F90003A33C    	  2111:     lea     (StatueYs).l,A0
02:0003A428 10303000        	  2112:     move.b  (A0,D3.W),D0
02:0003A42C 19400003        	  2113:     move.b  D0,($0003,A4)
02:0003A430 41EC0084        	  2114:     lea     ($0084,A4),A0
02:0003A434 11802000        	  2115:     move.b  D0,(A0,D2.W)
                            	  2116:     ; Set mask value 3 in [04].
