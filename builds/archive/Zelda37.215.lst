02:0003A448 12343002        	  2128:     move.b  ($02,A4,D3.W),D1
02:0003A44C 0A3C0010        	  2129:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A450 9101            	  2130:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A452 0A3C0010        	  2131:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A456 0C000018        	  2132:     cmpi.b  #$18,D0
02:0003A45A 6A10            	  2133:     bpl  _anon_z04_31
02:0003A45C 0C0000E8        	  2134:     cmpi.b  #$E8,D0
