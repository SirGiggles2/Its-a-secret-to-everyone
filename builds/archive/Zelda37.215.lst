02:0003C0A4 41EC0382        	  6153:     lea     ($0382,A4),A0
02:0003C0A8 10303000        	  6154:     move.b  (A0,D3.W),D0
02:0003C0AC 41EC0381        	  6155:     lea     ($0381,A4),A0
02:0003C0B0 11803000        	  6156:     move.b  D0,(A0,D3.W)
02:0003C0B4 41EC0099        	  6157:     lea     ($0099,A4),A0
02:0003C0B8 11803000        	  6158:     move.b  D0,(A0,D3.W)
                            	  6159:     ; Bottom of the loop.
