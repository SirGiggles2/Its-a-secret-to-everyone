02:0004477E 123C0040        	  7614:     move.b  #$40,D1
02:00044782 0A3C0010        	  7615:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044786 9101            	  7616:     subx.b  D1,D0   ; SBC #$40
02:00044788 0A3C0010        	  7617:     eori    #$10,CCR  ; restore X = 6502 C
02:0004478C E208            	  7618:     lsr.b  #1,D0   ; LSR A
02:0004478E E208            	  7619:     lsr.b  #1,D0   ; LSR A
02:00044790 E208            	  7620:     lsr.b  #1,D0   ; LSR A
