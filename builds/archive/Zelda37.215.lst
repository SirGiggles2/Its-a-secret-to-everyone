                            	 11581: Gleeok_DrawBody:
                            	 11582:     ; The animation timer controls when the animation frame changes.
                            	 11583:     ; If it has not expired, then go decrement it and draw.
                            	 11584:     ;
02:0003E8B2 102C04E6        	 11585:     move.b  ($04E6,A4),D0
