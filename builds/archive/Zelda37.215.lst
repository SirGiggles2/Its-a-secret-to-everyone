02:000402BC 102C00FB        	   428:     move.b  ($00FB,A4),D0
02:000402C0 02000088        	   429:     andi.b #$88,D0
02:000402C4 0C000088        	   430:     cmpi.b  #$88,D0
02:000402C8 661A            	   431:     bne  _anon_z05_3
02:000402CA 4EB90004B68A    	   432:     jsr     EndGameMode
02:000402D0 194000E1        	   433:     move.b  D0,($00E1,A4)
02:000402D4 7008            	   434:     moveq   #8,D0
02:000402D6 19400012        	   435:     move.b  D0,($0012,A4)
02:000402DA 7000            	   436:     moveq   #0,D0
02:000402DC 19400619        	   437:     move.b  D0,($0619,A4)
02:000402E0 600013A0        	   438:     jmp     SilenceSound
