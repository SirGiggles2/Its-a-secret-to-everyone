                            	 13339: Ganon_DrawBody:
                            	 13340:     ; Loop over four 16x16 images that make up Ganon.
                            	 13341:     ; There are 6 animation frames.
                            	 13342:     ;
02:0003F598 7603            	 13343:     moveq   #3,D3
                            	 13344:     even
                            	 13345: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13346:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13347:     ;
02:0003F59A 10342070        	 13348:     move.b  ($70,A4,D2.W),D0
02:0003F59E 023C00EE        	 13349:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5A2 41F90003F58C    	 13350:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F5A8 12303000        	 13351:     move.b  (A0,D3.W),D1
02:0003F5AC D101            	 13352:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F5AE 1880            	 13353:     move.b  D0,($0000,A4)
                            	 13354:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13355:     ;
02:0003F5B0 41EC0084        	 13356:     lea     ($0084,A4),A0
02:0003F5B4 10302000        	 13357:     move.b  (A0,D2.W),D0
02:0003F5B8 023C00EE        	 13358:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5BC 41F90003F590    	 13359:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F5C2 12303000        	 13360:     move.b  (A0,D3.W),D1
02:0003F5C6 D101            	 13361:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F5C8 19400001        	 13362:     move.b  D0,($0001,A4)
                            	 13363:     ; Each part has a horizontal flipping flag.
                            	 13364:     ;
02:0003F5CC 41F90003F594    	 13365:     lea     (GanonSpriteHFlips).l,A0
02:0003F5D2 10303000        	 13366:     move.b  (A0,D3.W),D0
02:0003F5D6 1940000F        	 13367:     move.b  D0,($000F,A4)
                            	 13368:     ; Save and copy the loop index (the current part) to [07].
                            	 13369:     ;
02:0003F5DA 1003            	 13370:     move.b  D3,D0
02:0003F5DC 1B00            	 13371:     move.b  D0,-(A5)  ; PHA
02:0003F5DE 19400007        	 13372:     move.b  D0,($0007,A4)
                            	 13373:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13374:     ; that make it up.
                            	 13375:     ;
02:0003F5E2 41EC046B        	 13376:     lea     ($046B,A4),A0
02:0003F5E6 10302000        	 13377:     move.b  (A0,D2.W),D0
02:0003F5EA E308            	 13378:     lsl.b  #1,D0   ; ASL A
02:0003F5EC E308            	 13379:     lsl.b  #1,D0   ; ASL A
                            	 13380:     ; Add [07] -- the index of the current part.
                            	 13381:     ;
                            	 13382:     ; Now you have an index into the frame image table, for the
                            	 13383:     ; current image part of the current animation frame.
                            	 13384:     ;
02:0003F5EE 122C0007        	 13385:     move.b  ($0007,A4),D1
02:0003F5F2 D101            	 13386:     addx.b  D1,D0   ; ADC $07
02:0003F5F4 7600            	 13387:     moveq   #0,D3
02:0003F5F6 1600            	 13388:     move.b  D0,D3
02:0003F5F8 41F90003F574    	 13389:     lea     (GanonFrameImages).l,A0
02:0003F5FE 10303000        	 13390:     move.b  (A0,D3.W),D0
02:0003F602 4EB900031564    	 13391:     jsr     DrawObjectNotMirrored
02:0003F608 101D            	 13392:     move.b  (A5)+,D0  ; PLA
                            	 13393:     ; Bottom of the part loop.
                            	 13394:     ;
02:0003F60A 7600            	 13395:     moveq   #0,D3
02:0003F60C 1600            	 13396:     move.b  D0,D3
02:0003F60E 5303            	 13397:     subq.b  #1,D3
02:0003F610 6A88            	 13398:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F612 4E75            	 13399:     rts
                            	 13400: 
                            	 13401:     even
                            	 13402: Ganon_CheckCollisions:
                            	 13403:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13404:     ; Store in [02] and [03].
                            	 13405:     ;
02:0003F614 10342070        	 13406:     move.b  ($70,A4,D2.W),D0
02:0003F618 023C00EE        	 13407:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F61C 123C0010        	 13408:     move.b  #$10,D1
02:0003F620 D101            	 13409:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F622 19400002        	 13410:     move.b  D0,($0002,A4)
02:0003F626 41EC0084        	 13411:     lea     ($0084,A4),A0
02:0003F62A 10302000        	 13412:     move.b  (A0,D2.W),D0
02:0003F62E 023C00EE        	 13413:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F632 123C0010        	 13414:     move.b  #$10,D1
02:0003F636 D101            	 13415:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F638 19400003        	 13416:     move.b  D0,($0003,A4)
                            	 13417:     ; Check for a collision with Link.
                            	 13418:     ;
                            	 13419:     ; We can't call CheckLinkCollision, because we need to
                            	 13420:     ; customize Ganon's midpoint.
                            	 13421:     ;
                            	 13422:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13423:     ; detection, if Link is invincible. Initialize variables that will
                            	 13424:     ; be returned from the partial collision check routine. Then
                            	 13425:     ; call it.
                            	 13426:     ;
02:0003F63C 102C04F0        	 13427:     move.b  ($04F0,A4),D0
02:0003F640 6616            	 13428:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F642 19400006        	 13429:     move.b  D0,($0006,A4)
02:0003F646 19400009        	 13430:     move.b  D0,($0009,A4)
02:0003F64A 1940000C        	 13431:     move.b  D0,($000C,A4)
02:0003F64E 7600            	 13432:     moveq   #0,D3
02:0003F650 1883            	 13433:     move.b  D3,($0000,A4)
02:0003F652 4EB900031A60    	 13434:     jsr     CheckLinkCollisionPreinit
                            	 13435:     even
                            	 13436: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13437:     ; If Ganon is not in state 0, then he's brown.
                            	 13438:     ; Go check collision with an arrow.
                            	 13439:     ;
02:0003F658 41EC00AC        	 13440:     lea     ($00AC,A4),A0
02:0003F65C 10302000        	 13441:     move.b  (A0,D2.W),D0
02:0003F660 6652            	 13442:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13443:     ; If timer <> 0, then Ganon is visible.
                            	 13444:     ; He can't be harmed like this. So, return.
                            	 13445:     ;
02:0003F662 10342028        	 13446:     move.b  ($28,A4,D2.W),D0
02:0003F666 664A            	 13447:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F668 760D            	 13448:     moveq   #13,D3
02:0003F66A 4EB900031F2A    	 13449:     jsr     CheckMonsterSwordCollision
                            	 13450:     ; If Ganon has died according to the usual collision check rules
                            	 13451:     ; (HP = 0), then:
                            	 13452:     ; 1. Restore HP to the initial value $F0
                            	 13453:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13454:     ; 3. Change palette row 7 to make Ganon brown
                            	 13455:     ;
02:0003F670 41EC0405        	 13456:     lea     ($0405,A4),A0
02:0003F674 10302000        	 13457:     move.b  (A0,D2.W),D0
02:0003F678 6718            	 13458:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F67A 103C00F0        	 13459:     move.b  #$F0,D0
02:0003F67E 41EC0485        	 13460:     lea     ($0485,A4),A0
02:0003F682 11802000        	 13461:     move.b  D0,(A0,D2.W)
02:0003F686 41EC00AC        	 13462:     lea     ($00AC,A4),A0
02:0003F68A 53302000        	 13463:     subq.b  #1,(A0,D2.W)
02:0003F68E 61000084        	 13464:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13465:     even
                            	 13466: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13467:     ; If Ganon was harmed, then play the sound effect
                            	 13468:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13469:     ;
02:0003F692 41EC04F0        	 13470:     lea     ($04F0,A4),A0
02:0003F696 10302000        	 13471:     move.b  (A0,D2.W),D0
02:0003F69A 670A            	 13472:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F69C 61009F92        	 13473:     jsr     PlayBossHitCryIfNeeded
02:0003F6A0 7040            	 13474:     moveq   #64,D0
02:0003F6A2 19802028        	 13475:     move.b  D0,($28,A4,D2.W)
                            	 13476:     even
                            	 13477: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13478:     ; Reset metastate, because Ganon cannot die this way.
                            	 13479:     ;
02:0003F6A6 4EB90004DB18    	 13480:     jsr     ResetObjMetastate
                            	 13481:     ; Reset shove info and invincibility timer, because Ganon
                            	 13482:     ; doesn't react at all as a usual monster.
                            	 13483:     ;
02:0003F6AC 4EB900031E32    	 13484:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13485:     even
                            	 13486: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F6B2 4E75            	 13487:     rts
                            	 13488: 
                            	 13489:     even
                            	 13490: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13491:     ; If the silver arrow is not in the inventory, then return.
                            	 13492:     ;
02:0003F6B4 102C0659        	 13493:     move.b  ($0659,A4),D0
02:0003F6B8 0C000002        	 13494:     cmpi.b  #$02,D0
02:0003F6BC 66F4            	 13495:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13496:     ; Reset the collision return value [06].
                            	 13497:     ;
02:0003F6BE 7000            	 13498:     moveq   #0,D0
02:0003F6C0 19400006        	 13499:     move.b  D0,($0006,A4)
                            	 13500:     ; If there's no arrow in flight, then return.
                            	 13501:     ;
02:0003F6C4 7612            	 13502:     moveq   #18,D3
02:0003F6C6 41EC00AC        	 13503:     lea     ($00AC,A4),A0
02:0003F6CA 10303000        	 13504:     move.b  (A0,D3.W),D0
02:0003F6CE 0C000010        	 13505:     cmpi.b  #$10,D0
02:0003F6D2 66DE            	 13506:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13507:     ; Check for collision with an arrow; and return if no collision.
                            	 13508:     ;
02:0003F6D4 4EB900031F86    	 13509:     jsr     CheckMonsterArrowOrRodCollision
02:0003F6DA 102C0006        	 13510:     move.b  ($0006,A4),D0
02:0003F6DE 67D2            	 13511:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13512:     ; Set the Ganon phase to "dying".
                            	 13513:     ;
02:0003F6E0 41EC042C        	 13514:     lea     ($042C,A4),A0
02:0003F6E4 52302000        	 13515:     addq.b  #1,(A0,D2.W)
                            	 13516:     ; Now his body does flash.
                            	 13517:     ;
02:0003F6E8 7028            	 13518:     moveq   #40,D0
02:0003F6EA 41EC04F0        	 13519:     lea     ($04F0,A4),A0
02:0003F6EE 11802000        	 13520:     move.b  D0,(A0,D2.W)
                            	 13521:     ; Set initial cloud distance 8.
                            	 13522:     ;
02:0003F6F2 7008            	 13523:     moveq   #8,D0
02:0003F6F4 41EC0478        	 13524:     lea     ($0478,A4),A0
02:0003F6F8 11802000        	 13525:     move.b  D0,(A0,D2.W)
02:0003F6FC 0A3C0001        	 13526:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F700 4E75            	 13527:     rts
                            	 13528: 
