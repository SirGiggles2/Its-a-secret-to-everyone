                            	  4447: CheckTiles:
                            	  4448:     ifne TURBO_LINK
                            	  4449:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4450:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004C044 4A02            	  4451:     tst.b   D2
02:0004C046 6608            	  4452:     bne.s   _L_z07_CheckTiles_notLink
02:0004C048 197C0024049E    	  4453:     move.b  #$24,($049E,A4)
02:0004C04E 605E            	  4454:     jmp     GoWalkableDir
                            	  4455: _L_z07_CheckTiles_notLink:
                            	  4456:     endc
                            	  4457:     ; The code below applies to Link and other objects.
                            	  4458:     ;
                            	  4459:     ; Test the moving direction's walkability.
                            	  4460:     ;
                            	  4461:     ; For the player, this is enough. For other objects, this 
                            	  4462:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4463:     ;
                            	  4464:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4465:     ;
02:0004C050 6100F9D4        	  4466:     jsr     GetCollidingTileMoving
02:0004C054 122C034A        	  4467:     move.b  ($034A,A4),D1
02:0004C058 B001            	  4468:     cmp.b   D1,D0
02:0004C05A 6402            	  4469:     bcc.s  __far_z_07_0056
02:0004C05C 6050            	  4470:     jmp  GoWalkableDir
                            	  4471: __far_z_07_0056:
                            	  4472:     ; The colliding tile is unwalkable.
                            	  4473:     ;
                            	  4474:     ; If object is the player, then go check passive tile objects and
                            	  4475:     ; the screen edge, or stop moving.
                            	  4476:     ;
02:0004C05E 4A02            	  4477:     cmpi.b  #$00,D2
02:0004C060 6602            	  4478:     bne.s  __far_z_07_0057
02:0004C062 6022            	  4479:     jmp  PlayerUnwalkable
                            	  4480: __far_z_07_0057:
                            	  4481:     even
                            	  4482: CheckObjAttr10AndAltDir:
