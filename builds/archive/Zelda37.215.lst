02:00031570 16302000        	  6078:     move.b  (A0,D2.W),D3
                            	  6079: ; Params:
                            	  6080: ; A: frame
                            	  6081: ; X: object index/cycle sprite index
                            	  6082: ; Y: object type
                            	  6083: ; [00]: object X
                            	  6084: ; [01]: object Y
                            	  6085: ; [0C]: mirrored
                            	  6086: ; [0F]: flip horizontally
                            	  6087: ;
                            	  6088: ; Note:
                            	  6089: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6090: ;
                            	  6091: ; The animation index of most objects is (object type + 1),
                            	  6092: ; to make up for the fact that Link uses two animation indexes.
                            	  6093: ;
                            	  6094:     even
                            	  6095: DrawObjectWithType:
02:00031574 5203            	  6096:     addq.b  #1,D3
                            	  6097: ; Params:
                            	  6098: ; A: frame
                            	  6099: ; X: object index/cycle sprite index
                            	  6100: ; Y: animation index
                            	  6101: ; [00]: object X
                            	  6102: ; [01]: object Y
                            	  6103: ; [0C]: mirrored
                            	  6104: ; [0F]: flip horizontally
                            	  6105: ;
                            	  6106: ; Note:
                            	  6107: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6108: ; But Link uses [0F] for flipping without checking [0C].
                            	  6109: ;
                            	  6110: ;
                            	  6111: ; [0D] holds frame.
                            	  6112:     even
                            	  6113: DrawObjectWithAnim:
