                            	  4168:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4169:     ;
02:0003B228 102C0029        	  4170:     move.b  ($0029,A4),D0
02:0003B22C 660A            	  4171:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4172:     ; Else go to state 3, and unhalt Link.
                            	  4173:     ;
02:0003B22E 522C00AD        	  4174:     addq.b  #1,($00AD,A4)
02:0003B232 7000            	  4175:     moveq   #0,D0
02:0003B234 194000AC        	  4176:     move.b  D0,($00AC,A4)
                            	  4177:     even
