02:000312E8 B001            	  5916:     cmp.b   D1,D0
02:000312EA 670C            	  5917:     beq  _L_z01_CheckMazes_Match
02:000312EC 0C000002        	  5918:     cmpi.b  #$02,D0
02:000312F0 66E2            	  5919:     bne  _L_z01_CheckMazes_Reset
02:000312F2 0A3C0001        	  5920:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000312F6 4E75            	  5921:     rts
