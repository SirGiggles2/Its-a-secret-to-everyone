                            	  5868: CheckMazes:
02:00031292 7400            	  5869:     moveq   #0,D2
02:00031294 142C052F        	  5870:     move.b  ($052F,A4),D2
02:00031298 102C0098        	  5871:     move.b  ($0098,A4),D0
02:0003129C 7600            	  5872:     moveq   #0,D3
02:0003129E 162C00EB        	  5873:     move.b  ($00EB,A4),D3
02:000312A2 0C030061        	  5874:     cmpi.b  #$61,D3
02:000312A6 6630            	  5875:     bne  _L_z01_CheckMazes_CheckMountainMaze
02:000312A8 41F90003128A    	  5876:     lea     (ForestMazeDirs).l,A0
02:000312AE 12302000        	  5877:     move.b  (A0,D2.W),D1
02:000312B2 B001            	  5878:     cmp.b   D1,D0
02:000312B4 6618            	  5879:     bne  _L_z01_CheckMazes_Mismatch
                            	  5880:     ; The direction matches the step.
                            	  5881:     ;
02:000312B6 0C020003        	  5882:     cmpi.b  #$03,D2
02:000312BA 6742            	  5883:     beq  _L_z01_CheckMazes_PlaySecretTune
                            	  5884:     even
                            	  5885: _L_z01_CheckMazes_AdvanceMaze:
