02:0004D324 600C            	  7241:     jmp     _L_z07_AnimateLinkObjState_SetMovementFrame1
                            	  7242: 
                            	  7243:     even
                            	  7244: _L_z07_AnimateLinkObjState_CombineStateWith30:
02:0004D326 102C00AC        	  7245:     move.b  ($00AC,A4),D0
02:0004D32A 00000030        	  7246:     ori.b #$30,D0
02:0004D32E 194000AC        	  7247:     move.b  D0,($00AC,A4)
                            	  7248:     even
                            	  7249: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  7250:     ; To animate the state, the animation counter had to have
                            	  7251:     ; reached 0. Right after this routine, the counter will be
                            	  7252:     ; rolled over, and the movement frame will be switched.
                            	  7253:     ;
                            	  7254:     ; So, set movement frame to 1 (legs together) at the end of
                            	  7255:     ; the animation here, in order to immediately change it to
