                            	  9892: _L_z04_UpdateGohma_AnimateEye:
                            	  9893:     ; Animate the eye.
                            	  9894:     ;
                            	  9895:     ; First, if the counter for when to open the eye next = 0, then
                            	  9896:     ; set it to a random value at least $C0; and set the timer for
                            	  9897:     ; keeping the eye open to $80.
                            	  9898:     ;
                            	  9899:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9900:     ; every other frame.
                            	  9901:     ;
02:0003DEC8 41EC042C        	  9902:     lea     ($042C,A4),A0
02:0003DECC 10302000        	  9903:     move.b  (A0,D2.W),D0
02:0003DED0 661E            	  9904:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DED2 103C0080        	  9905:     move.b  #$80,D0
02:0003DED6 41EC0444        	  9906:     lea     ($0444,A4),A0
02:0003DEDA 11802000        	  9907:     move.b  D0,(A0,D2.W)
02:0003DEDE 103C00C0        	  9908:     move.b  #$C0,D0
02:0003DEE2 12342018        	  9909:     move.b  ($18,A4,D2.W),D1
02:0003DEE6 8001            	  9910:     or.b  D1,D0
02:0003DEE8 41EC042C        	  9911:     lea     ($042C,A4),A0
02:0003DEEC 11802000        	  9912:     move.b  D0,(A0,D2.W)
                            	  9913:     even
