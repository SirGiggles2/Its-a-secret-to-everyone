                            	  7934: UpdatePolsVoiceState1_Jumping:
                            	  7935:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7936:     ;
02:0003CFD8 41EC0444        	  7937:     lea     ($0444,A4),A0
02:0003CFDC 10302000        	  7938:     move.b  (A0,D2.W),D0
02:0003CFE0 023C00EE        	  7939:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFE4 123C0038        	  7940:     move.b  #$38,D1
02:0003CFE8 D101            	  7941:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFEA 41EC0444        	  7942:     lea     ($0444,A4),A0
02:0003CFEE 11802000        	  7943:     move.b  D0,(A0,D2.W)
                            	  7944:     ; Add Carry to high speed byte (vertical).
                            	  7945:     ;
02:0003CFF2 41EC0412        	  7946:     lea     ($0412,A4),A0
02:0003CFF6 10302000        	  7947:     move.b  (A0,D2.W),D0
02:0003CFFA 123C0000        	  7948:     move.b  #$00,D1
02:0003CFFE D101            	  7949:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D000 41EC0412        	  7950:     lea     ($0412,A4),A0
02:0003D004 11802000        	  7951:     move.b  D0,(A0,D2.W)
                            	  7952:     ; Add high speed byte to Y coordinate.
                            	  7953:     ;
02:0003D008 023C00EE        	  7954:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D00C 41EC0084        	  7955:     lea     ($0084,A4),A0
02:0003D010 12302000        	  7956:     move.b  (A0,D2.W),D1
02:0003D014 D101            	  7957:     addx.b  D1,D0   ; ADC ObjY,X
02:0003D016 41EC0084        	  7958:     lea     ($0084,A4),A0
02:0003D01A 11802000        	  7959:     move.b  D0,(A0,D2.W)
                            	  7960:     ; If the speed is still negative, then return.
                            	  7961:     ;
02:0003D01E 41EC0412        	  7962:     lea     ($0412,A4),A0
02:0003D022 10302000        	  7963:     move.b  (A0,D2.W),D0
02:0003D026 6B0000AC        	  7964:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7965:     ; If Y coordinate still < target Y, then return.
                            	  7966:     ;
02:0003D02A 41EC0084        	  7967:     lea     ($0084,A4),A0
02:0003D02E 10302000        	  7968:     move.b  (A0,D2.W),D0
02:0003D032 41EC042C        	  7969:     lea     ($042C,A4),A0
02:0003D036 12302000        	  7970:     move.b  (A0,D2.W),D1
02:0003D03A B001            	  7971:     cmp.b   D1,D0
02:0003D03C 65000096        	  7972:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7973:     ; Else reached the destination. Go to state 0.
                            	  7974:     ;
02:0003D040 7000            	  7975:     moveq   #0,D0
02:0003D042 41EC00AC        	  7976:     lea     ($00AC,A4),A0
02:0003D046 11802000        	  7977:     move.b  D0,(A0,D2.W)
                            	  7978:     ; Reset 16-bit vertical speed.
                            	  7979:     ;
02:0003D04A 41EC0444        	  7980:     lea     ($0444,A4),A0
02:0003D04E 11802000        	  7981:     move.b  D0,(A0,D2.W)
02:0003D052 41EC0412        	  7982:     lea     ($0412,A4),A0
02:0003D056 11802000        	  7983:     move.b  D0,(A0,D2.W)
                            	  7984:     ; Choose a random direction to face in.
                            	  7985:     ;
02:0003D05A 10342018        	  7986:     move.b  ($18,A4,D2.W),D0
02:0003D05E 02000003        	  7987:     andi.b #$03,D0
02:0003D062 7600            	  7988:     moveq   #0,D3
02:0003D064 1600            	  7989:     move.b  D0,D3
02:0003D066 41F90003CE76    	  7990:     lea     (PolsVoiceDirections).l,A0
02:0003D06C 10303000        	  7991:     move.b  (A0,D3.W),D0
02:0003D070 41EC0098        	  7992:     lea     ($0098,A4),A0
02:0003D074 11802000        	  7993:     move.b  D0,(A0,D2.W)
                            	  7994:     ; Randomly set distance-to-move to $30 or $70.
                            	  7995:     ;
02:0003D078 10342018        	  7996:     move.b  ($18,A4,D2.W),D0
02:0003D07C 02000040        	  7997:     andi.b #$40,D0
02:0003D080 123C0030        	  7998:     move.b  #$30,D1
02:0003D084 D101            	  7999:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D086 41EC0394        	  8000:     lea     ($0394,A4),A0
02:0003D08A 11802000        	  8001:     move.b  D0,(A0,D2.W)
                            	  8002:     ; Align the monster with a square horizontally.
                            	  8003:     ;
                            	  8004:     ; If in the left half of a square, align with that square.
                            	  8005:     ; If in the right half, align with the next square.
                            	  8006:     ;
02:0003D08E 10342070        	  8007:     move.b  ($70,A4,D2.W),D0
02:0003D092 023C00EE        	  8008:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D096 123C0008        	  8009:     move.b  #$08,D1
02:0003D09A D101            	  8010:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D09C 020000F0        	  8011:     andi.b #$F0,D0
02:0003D0A0 19802070        	  8012:     move.b  D0,($70,A4,D2.W)
                            	  8013:     ; Align the monster with a square vertically.
                            	  8014:     ;
                            	  8015:     ; If in the top half of a square, align with that square.
                            	  8016:     ; If in the bottom half, align with the next square.
                            	  8017:     ;
02:0003D0A4 41EC0084        	  8018:     lea     ($0084,A4),A0
02:0003D0A8 10302000        	  8019:     move.b  (A0,D2.W),D0
02:0003D0AC 023C00EE        	  8020:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0B0 123C0008        	  8021:     move.b  #$08,D1
02:0003D0B4 D101            	  8022:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D0B6 020000F0        	  8023:     andi.b #$F0,D0
                            	  8024:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8025:     ;
02:0003D0BA 003C0011        	  8026:     ori     #$11,CCR  ; SEC: set C+X
02:0003D0BE 123C0003        	  8027:     move.b  #$03,D1
02:0003D0C2 0A3C0010        	  8028:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D0C6 9101            	  8029:     subx.b  D1,D0   ; SBC #$03
02:0003D0C8 0A3C0010        	  8030:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D0CC 41EC0084        	  8031:     lea     ($0084,A4),A0
02:0003D0D0 11802000        	  8032:     move.b  D0,(A0,D2.W)
                            	  8033:     even
