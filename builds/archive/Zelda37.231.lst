                            	  2240:     even
                            	  2241: UpdateWhirlwind_Full:
                            	  2242:     ; Get Link's halted state.
                            	  2243:     ;
02:0002FF40 102C00AC        	  2244:     move.b  ($00AC,A4),D0
02:0002FF44 02000040        	  2245:     andi.b #$40,D0
02:0002FF48 7600            	  2246:     moveq   #0,D3
02:0002FF4A 1600            	  2247:     move.b  D0,D3
                            	  2248:     ; Add 2 to whirlwind X.
                            	  2249:     ;
02:0002FF4C 7002            	  2250:     moveq   #2,D0
02:0002FF4E 023C00EE        	  2251:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FF52 12342070        	  2252:     move.b  ($70,A4,D2.W),D1
02:0002FF56 D101            	  2253:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FF58 19802070        	  2254:     move.b  D0,($70,A4,D2.W)
                            	  2255:     ; If Link is not halted or teleporting state = 0, then
                            	  2256:     ; go check for collision with Link.
                            	  2257:     ;
02:0002FF5C 0C030040        	  2258:     cmpi.b  #$40,D3
02:0002FF60 6638            	  2259:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FF62 7600            	  2260:     moveq   #0,D3
02:0002FF64 162C0522        	  2261:     move.b  ($0522,A4),D3
02:0002FF68 6730            	  2262:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2263:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2264:     ;
                            	  2265:     ; Set Link's X to whirlwind's.
                            	  2266:     ;
02:0002FF6A 19400070        	  2267:     move.b  D0,($0070,A4)
                            	  2268:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2269:     ; the right screen edge and draw.
                            	  2270:     ;
02:0002FF6E 5303            	  2271:     subq.b  #1,D3
02:0002FF70 6776            	  2272:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FF72 0C000080        	  2273:     cmpi.b  #$80,D0
02:0002FF76 6670            	  2274:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2275:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2276:     ;
                            	  2277:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2278:     ;
02:0002FF78 E308            	  2279:     lsl.b  #1,D0   ; ASL A
02:0002FF7A 194000AC        	  2280:     move.b  D0,($00AC,A4)
02:0002FF7E 19400522        	  2281:     move.b  D0,($0522,A4)
02:0002FF82 41EC034F        	  2282:     lea     ($034F,A4),A0
02:0002FF86 11802000        	  2283:     move.b  D0,(A0,D2.W)
                            	  2284:     ; Update the player position marker, and draw one last time.
                            	  2285:     ;
02:0002FF8A 1002            	  2286:     move.b  D2,D0
02:0002FF8C 1B00            	  2287:     move.b  D0,-(A5)  ; PHA
02:0002FF8E 61001096        	  2288:     jsr     UpdatePlayerPositionMarker
02:0002FF92 101D            	  2289:     move.b  (A5)+,D0  ; PLA
02:0002FF94 7400            	  2290:     moveq   #0,D2
02:0002FF96 1400            	  2291:     move.b  D0,D2
02:0002FF98 6070            	  2292:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2293: 
                            	  2294:     even
                            	  2295: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2296:     ; Link is not halted or teleporting state = 0.
                            	  2297:     ; Try to pick up Link.
                            	  2298:     ;
                            	  2299:     ; If the whirlwind does not collide with Link, then go check
                            	  2300:     ; for the screen's right edge.
                            	  2301:     ;
