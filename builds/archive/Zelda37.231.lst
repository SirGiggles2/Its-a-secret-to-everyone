                            	  7584:     even
                            	  7585: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD34 101D            	  7586:     move.b  (A5)+,D0  ; PLA
02:0003CD36 7600            	  7587:     moveq   #0,D3
02:0003CD38 1600            	  7588:     move.b  D0,D3
                            	  7589:     ; If facing vertically, then return. There's no other side to draw.
                            	  7590:     ;
02:0003CD3A 41EC0098        	  7591:     lea     ($0098,A4),A0
02:0003CD3E 10302000        	  7592:     move.b  (A0,D2.W),D0
02:0003CD42 02000003        	  7593:     andi.b #$03,D0
02:0003CD46 6602            	  7594:     bne.s  __far_z_04_0067
02:0003CD48 602E            	  7595:     jmp  L11B00_Exit
                            	  7596: __far_z_04_0067:
                            	  7597:     ; Else draw the right side.
                            	  7598:     ;
                            	  7599:     ; Keep the Y coordinate in [01].
                            	  7600:     ; But, store (X + $10) in [00].
                            	  7601:     ;
02:0003CD4A 10342070        	  7602:     move.b  ($70,A4,D2.W),D0
02:0003CD4E 023C00EE        	  7603:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD52 123C0010        	  7604:     move.b  #$10,D1
02:0003CD56 D101            	  7605:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD58 1880            	  7606:     move.b  D0,($0000,A4)
02:0003CD5A 6114            	  7607:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7608:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7609:     ;
                            	  7610:     ; So, if we had animation frame 1, direction left:
                            	  7611:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7612:     ; - frame image index = 6 (1 + 5)
                            	  7613:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7614:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7615:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7616:     ;
                            	  7617:     ; So, 3 would have been the frame number used above for
                            	  7618:     ; the left side.
                            	  7619:     ;
                            	  7620:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7621:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7622:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7623:     ; on the right.
                            	  7624:     ;
02:0003CD5C 41F90003CC52    	  7625:     lea     (DodongoFrameImages).l,A0
02:0003CD62 10303000        	  7626:     move.b  (A0,D3.W),D0
02:0003CD66 0A000001        	  7627:     eori.b #$01,D0
02:0003CD6A 4EF900031838    	  7628:     jmp     DrawObjectNotMirrored
                            	  7629: 
                            	  7630: ; Returns:
                            	  7631: ; A: 3
                            	  7632: ; [04]: left sprite attributes
                            	  7633: ; [05]: right sprite attributes
                            	  7634: ;
                            	  7635:     even
                            	  7636: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD70 7003            	  7637:     moveq   #3,D0
02:0003CD72 4EB900031B2A    	  7638:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7639:     even
