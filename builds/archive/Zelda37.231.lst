                            	  8331:     even
                            	  8332: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8333:     ; If the teleporting distance remaining is even, then draw
                            	  8334:     ; and check collisions, else return.
                            	  8335:     ;
                            	  8336:     ; This means that when 0, the monster is walking.
                            	  8337:     ; So, draw and check collisions every frame.
                            	  8338:     ;
                            	  8339:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8340:     ; translucently -- every other frame.
                            	  8341:     ;
02:0003D332 41EC0394        	  8342:     lea     ($0394,A4),A0
02:0003D336 10302000        	  8343:     move.b  (A0,D2.W),D0
02:0003D33A E208            	  8344:     lsr.b  #1,D0   ; LSR A
02:0003D33C 6402            	  8345:     bcc.s  __far_z_04_0071
02:0003D33E 603A            	  8346:     jmp  L11E17_Exit
                            	  8347: __far_z_04_0071:
                            	  8348:     even
