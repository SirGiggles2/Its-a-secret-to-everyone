02:0003CE0A 10302000        	  7695:     move.b  (A0,D2.W),D0
02:0003CE0E 0C000002        	  7696:     cmpi.b  #$02,D0
02:0003CE12 6604            	  7697:     bne  _anon_z04_94
02:0003CE14 522C000F        	  7698:     addq.b  #1,($000F,A4)
                            	  7699: _anon_z04_94:
                            	  7700:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7701:     ; This is the base frame image.
                            	  7702:     ;
02:0003CE18 E208            	  7703:     lsr.b  #1,D0   ; LSR A
02:0003CE1A E208            	  7704:     lsr.b  #1,D0   ; LSR A
                            	  7705:     ; If movement frame = 1, add 3 to frame image to access
                            	  7706:     ; the second animation frame's images.
                            	  7707:     ;
02:0003CE1C 7600            	  7708:     moveq   #0,D3
02:0003CE1E 41EC03E4        	  7709:     lea     ($03E4,A4),A0
02:0003CE22 16302000        	  7710:     move.b  (A0,D2.W),D3
02:0003CE26 671E            	  7711:     beq  _anon_z04_95
02:0003CE28 023C00EE        	  7712:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE2C 123C0003        	  7713:     move.b  #$03,D1
02:0003CE30 D101            	  7714:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7715:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7716:     ;
                            	  7717:     ; Down has two frame images, but up only has one. By flipping
                            	  7718:     ; horizontally, you get two frame images.
                            	  7719:     ;
02:0003CE32 7600            	  7720:     moveq   #0,D3
02:0003CE34 41EC0098        	  7721:     lea     ($0098,A4),A0
02:0003CE38 16302000        	  7722:     move.b  (A0,D2.W),D3
02:0003CE3C 0C030008        	  7723:     cmpi.b  #$08,D3
02:0003CE40 6604            	  7724:     bne  _anon_z04_95
02:0003CE42 522C000F        	  7725:     addq.b  #1,($000F,A4)
