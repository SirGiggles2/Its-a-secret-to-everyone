                            	  3178: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3179:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3180:     ; the mound frame images:
                            	  3181:     ;
                            	  3182:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3183:     ;
                            	  3184:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3185:     ;
                            	  3186:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3187:     ;
02:0003ADAC 003C0011        	  3188:     ori     #$11,CCR  ; SEC: set C+X
02:0003ADB0 123C0001        	  3189:     move.b  #$01,D1
02:0003ADB4 0A3C0010        	  3190:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ADB8 9101            	  3191:     subx.b  D1,D0   ; SBC #$01
02:0003ADBA 0A3C0010        	  3192:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ADBE E308            	  3193:     lsl.b  #1,D0   ; ASL A
02:0003ADC0 023C00EE        	  3194:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADC4 41EC03E4        	  3195:     lea     ($03E4,A4),A0
02:0003ADC8 12302000        	  3196:     move.b  (A0,D2.W),D1
02:0003ADCC D101            	  3197:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  3198:     even
