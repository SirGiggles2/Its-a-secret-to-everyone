                            	  6427: Digdogger_Move:
                            	  6428:     ; This calculation is the same one used in Manhandla to
                            	  6429:     ; manifest the fractional speed over several frames.
                            	  6430:     ;
                            	  6431:     ; To summarize, the formula is:
                            	  6432:     ;
                            	  6433:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6434:     ;
                            	  6435:     ;   SA := SA + (SL AND $E0)
                            	  6436:     ;   [03] := SH + carry
                            	  6437:     ;
                            	  6438:     ; See 04:A28E Manhandla_Move.
                            	  6439:     ;
02:0003C50E 41EC041F        	  6440:     lea     ($041F,A4),A0
02:0003C512 10302000        	  6441:     move.b  (A0,D2.W),D0
02:0003C516 020000E0        	  6442:     andi.b #$E0,D0
02:0003C51A 023C00EE        	  6443:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C51E 41EC0412        	  6444:     lea     ($0412,A4),A0
02:0003C522 12302000        	  6445:     move.b  (A0,D2.W),D1
02:0003C526 D101            	  6446:     addx.b  D1,D0   ; ADC $0412,X
02:0003C528 41EC0412        	  6447:     lea     ($0412,A4),A0
02:0003C52C 11802000        	  6448:     move.b  D0,(A0,D2.W)
                            	  6449:     ; Assign (high speed byte + carry) to [03].
                            	  6450:     ;
02:0003C530 41EC042C        	  6451:     lea     ($042C,A4),A0
02:0003C534 10302000        	  6452:     move.b  (A0,D2.W),D0
02:0003C538 123C0000        	  6453:     move.b  #$00,D1
02:0003C53C D101            	  6454:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C53E 19400003        	  6455:     move.b  D0,($0003,A4)
                            	  6456:     ; Change coordinates by the speed amount/offset in [03]
                            	  6457:     ; according to the direction.
                            	  6458:     ;
                            	  6459:     ; Start with a mask of $A1 in [02]:
                            	  6460:     ; - low nibble represents the right direction
                            	  6461:     ; - high nibble is used to set or clear carry as we go along
                            	  6462:     ;
02:0003C542 103C00A1        	  6463:     move.b  #$A1,D0
02:0003C546 19400002        	  6464:     move.b  D0,($0002,A4)
                            	  6465:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6466:     ;
02:0003C54A 41EC0098        	  6467:     lea     ($0098,A4),A0
02:0003C54E 10302000        	  6468:     move.b  (A0,D2.W),D0
02:0003C552 122C0002        	  6469:     move.b  ($0002,A4),D1
02:0003C556 C200            	  6470:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C558 6712            	  6471:     beq  _L_z04_Digdogger_Move_Left
02:0003C55A 10342070        	  6472:     move.b  ($70,A4,D2.W),D0
02:0003C55E 023C00EE        	  6473:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C562 122C0003        	  6474:     move.b  ($0003,A4),D1
02:0003C566 D101            	  6475:     addx.b  D1,D0   ; ADC $03
02:0003C568 19802070        	  6476:     move.b  D0,($70,A4,D2.W)
                            	  6477:     even
                            	  6478: _L_z04_Digdogger_Move_Left:
                            	  6479:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6480:     ;
02:0003C56C 41EC0098        	  6481:     lea     ($0098,A4),A0
02:0003C570 10302000        	  6482:     move.b  (A0,D2.W),D0
02:0003C574 122C0002        	  6483:     move.b  ($0002,A4),D1
02:0003C578 E309            	  6484:     lsl.b  #1,D1   ; ASL $02
02:0003C57A 19410002        	  6485:     move.b  D1,($0002,A4)
02:0003C57E 122C0002        	  6486:     move.b  ($0002,A4),D1
02:0003C582 C200            	  6487:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C584 6716            	  6488:     beq  _L_z04_Digdogger_Move_Down
02:0003C586 10342070        	  6489:     move.b  ($70,A4,D2.W),D0
02:0003C58A 122C0003        	  6490:     move.b  ($0003,A4),D1
02:0003C58E 0A3C0010        	  6491:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C592 9101            	  6492:     subx.b  D1,D0   ; SBC $03
02:0003C594 0A3C0010        	  6493:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C598 19802070        	  6494:     move.b  D0,($70,A4,D2.W)
                            	  6495:     even
