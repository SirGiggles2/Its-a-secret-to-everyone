                            	   499: 
                            	   500: ;------------------------------------------------------------------------------
                            	   501: ; _c_move_object_shim — MoveObject trampoline.
                            	   502: ;
                            	   503: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   504: ;   Input:     D2 = slot (0..11)
                            	   505: ;   Preserves: D2, A4, A5
                            	   506: ;   Clobbers:  D0, D1, D3, A0
                            	   507: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   508: ;
                            	   509: ; GCC side:
                            	   510: ;   void c_move_object(unsigned short slot);
                            	   511: ;     slot arrives as a 16-bit value on the stack.
                            	   512: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   513: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   514: ;   never clobbered by gcc.
                            	   515: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   516: ;   semantics can exist in a pure C port).
                            	   517: ;------------------------------------------------------------------------------
                            	   518: _c_move_object_shim:
                            	   519:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   520:     move.b  #$AA,($0900,A4)
                            	   521:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   522:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   523:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   524:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   525:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   526:     moveq   #0,D0
02:0002B658 3002            	   527:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   528:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   529:     jsr     c_move_object
02:0002B662 588F            	   530:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   531:     rts
                            	   532: 
                            	   533: ;==============================================================================
                            	   534: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   535: ; and tail-call the native asm function.
                            	   536: ;
                            	   537: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   538: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   539: ; sign-extended).
                            	   540: ;==============================================================================
                            	   541: 
                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; void c_copy_bank_to_window(unsigned int bank);
                            	   544: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   545: ;------------------------------------------------------------------------------
                            	   546: c_copy_bank_to_window:
02:0002B666 202F0004        	   547:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   548:     jmp     _copy_bank_to_window
                            	   549: 
                            	   550: ;------------------------------------------------------------------------------
                            	   551: ; unsigned char c_ppu_read_2(void);
                            	   552: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   553: ; C return: gcc expects result in D0.
                            	   554: ;------------------------------------------------------------------------------
                            	   555: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   556:     jmp     _ppu_read_2
                            	   557: 
                            	   558: ;------------------------------------------------------------------------------
                            	   559: ; void c_ppu_write_6(unsigned int val);
                            	   560: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   561: ;------------------------------------------------------------------------------
                            	   562: c_ppu_write_6:
02:0002B674 202F0004        	   563:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   564:     jmp     _ppu_write_6
                            	   565: 
                            	   566: ;------------------------------------------------------------------------------
                            	   567: ; void c_ppu_write_7(unsigned int val);
                            	   568: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   569: ;------------------------------------------------------------------------------
                            	   570: c_ppu_write_7:
02:0002B67E 202F0004        	   571:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   572:     jmp     _ppu_write_7
                            	   573: 
                            	   574: ;------------------------------------------------------------------------------
                            	   575: ; void c_turn_off_all_video(void);
                            	   576: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   577: ;------------------------------------------------------------------------------
                            	   578: c_turn_off_all_video:
02:0002B688 4EF90004A9AC    	   579:     jmp     TurnOffAllVideo
                            	   580: 
                            	   581: ;==============================================================================
                            	   582: ; EXPORT side — z_03 entry point.
                            	   583: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   584: ; the transpiler emits that label pointing to this shim instead of the
                            	   585: ; z_03 asm body. The C function takes no args and returns void.
                            	   586: ;==============================================================================
                            	   587: 
                            	   588: ;------------------------------------------------------------------------------
                            	   589: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   590: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   591: ;------------------------------------------------------------------------------
                            	   592: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   593:     jmp     z03_transfer_level_pattern_blocks
                            	   594: 
                            	   595: ;==============================================================================
                            	   596: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   597: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   598: ;==============================================================================
                            	   599: 
                            	   600: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   601:     jmp     z06_init_mode2_submodes
                            	   602: 
                            	   603: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   604:     jmp     z06_copy_common_data_to_ram
                            	   605: 
                            	   606: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   607:     jmp     z06_update_mode2_load_full
                            	   608: 
                            	   609: ;==============================================================================
                            	   610: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   611: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   612: ;==============================================================================
                            	   613: 
                            	   614: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   615:     jmp     z05_copy_column_to_tilebuf
                            	   616: 
                            	   617: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   618:     jmp     z05_copy_row_to_tilebuf
                            	   619: 
                            	   620: ;==============================================================================
                            	   621: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   622: ;==============================================================================
                            	   623: 
                            	   624: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   625: c_has_compass:
02:0002B6B2 4EB900000000    	   626:     jsr     z05_has_compass
02:0002B6B8 4A00            	   627:     tst.b   D0
02:0002B6BA 4E75            	   628:     rts
                            	   629: 
                            	   630: c_has_map:
02:0002B6BC 4EB900000000    	   631:     jsr     z05_has_map
02:0002B6C2 4A00            	   632:     tst.b   D0
02:0002B6C4 4E75            	   633:     rts
                            	   634: 
                            	   635: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   636: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   637:     move.l  D0,-(SP)
02:0002B6C8 7200            	   638:     moveq   #0,D1
02:0002B6CA 1202            	   639:     move.b  D2,D1
02:0002B6CC 2F01            	   640:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   641:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   642:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   643:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   644:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   645:     addq.l  #8,SP
02:0002B6E2 201F            	   646:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   647:     rts
                            	   648: 
                            	   649: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   650: c_add_door_flags:
02:0002B6E6 4EF900000000    	   651:     jmp     z05_add_door_flags
                            	   652: 
                            	   653: ;==============================================================================
                            	   654: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   655: ;==============================================================================
                            	   656: 
                            	   657: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   658: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   659: c_split_room_id:
02:0002B6EC 4EB900000000    	   660:     jsr     z05_split_room_id
02:0002B6F2 7600            	   661:     moveq   #0,D3
02:0002B6F4 1600            	   662:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   663:     lsr.w   #8,D0
02:0002B6F8 7400            	   664:     moveq   #0,D2
02:0002B6FA 1400            	   665:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   666:     rts
                            	   667: 
                            	   668: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   669: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   670: c_is_dark_room:
02:0002B6FE 7000            	   671:     moveq   #0,D0
02:0002B700 3003            	   672:     move.w  D3,D0
02:0002B702 2F00            	   673:     move.l  D0,-(SP)
02:0002B704 4EB900000000    	   674:     jsr     z05_is_dark_room
02:0002B70A 588F            	   675:     addq.l  #4,SP
02:0002B70C 4A00            	   676:     tst.b   D0
02:0002B70E 4E75            	   677:     rts
                            	   678: 
                            	   679: ; SetDoorFlag — D2=dir_idx. Calls get_room_flags internally, writes flag.
                            	   680: c_set_door_flag:
02:0002B710 7000            	   681:     moveq   #0,D0
02:0002B712 3002            	   682:     move.w  D2,D0
02:0002B714 2F00            	   683:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	   684:     jsr     z05_set_door_flag
02:0002B71C 588F            	   685:     addq.l  #4,SP
02:0002B71E 4E75            	   686:     rts
                            	   687: 
                            	   688: ; ResetDoorFlag — D2=dir_idx.
                            	   689: c_reset_door_flag:
02:0002B720 7000            	   690:     moveq   #0,D0
02:0002B722 3002            	   691:     move.w  D2,D0
02:0002B724 2F00            	   692:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	   693:     jsr     z05_reset_door_flag
02:0002B72C 588F            	   694:     addq.l  #4,SP
02:0002B72E 4E75            	   695:     rts
                            	   696: 
