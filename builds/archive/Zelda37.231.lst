                            	  4954: ;
                            	  4955:     even
                            	  4956: HandleShotBlocked:
02:0004C018 41EC00AC        	  4957:     lea     ($00AC,A4),A0
02:0004C01C 10302000        	  4958:     move.b  (A0,D2.W),D0
02:0004C020 E308            	  4959:     lsl.b  #1,D0   ; ASL A
02:0004C022 6504            	  4960:     bcs.s  __far_z_07_0075
02:0004C024 60000082        	  4961:     jmp  SetShotSpreadingState
                            	  4962: __far_z_07_0075:
                            	  4963:     ; This is a magic shot.
                            	  4964:     ;
                            	  4965:     ; If missing the magic book, go deactivate the shot object.
                            	  4966:     ;
02:0004C028 102C0661        	  4967:     move.b  ($0661,A4),D0
02:0004C02C 6602            	  4968:     bne.s  __far_z_07_0076
02:0004C02E 6072            	  4969:     jmp  DeactivateShot
                            	  4970: __far_z_07_0076:
                            	  4971:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4972:     ; unused, so it only has to depend on having an empty slot.
                            	  4973:     ;
                            	  4974:     ; If successful, Link's state will have been changed to "using item".
                            	  4975:     ; But we don't want that in this case.
                            	  4976:     ;
                            	  4977:     ; For both these reasons, save state and restore it afterward.
                            	  4978:     ;
02:0004C030 102C00AC        	  4979:     move.b  ($00AC,A4),D0
02:0004C034 1B00            	  4980:     move.b  D0,-(A5)  ; PHA
02:0004C036 102C0513        	  4981:     move.b  ($0513,A4),D0
02:0004C03A 1B00            	  4982:     move.b  D0,-(A5)  ; PHA
02:0004C03C 7000            	  4983:     moveq   #0,D0
02:0004C03E 19400513        	  4984:     move.b  D0,($0513,A4)
02:0004C042 4EB900030F2E    	  4985:     jsr     WieldCandle
02:0004C048 101D            	  4986:     move.b  (A5)+,D0  ; PLA
02:0004C04A 19400513        	  4987:     move.b  D0,($0513,A4)
02:0004C04E 101D            	  4988:     move.b  (A5)+,D0  ; PLA
02:0004C050 194000AC        	  4989:     move.b  D0,($00AC,A4)
                            	  4990:     ; State $21 means that a moving fire was just made.
                            	  4991:     ;
                            	  4992:     ; If it's any another value, then we didn't find an empty slot
                            	  4993:     ; to make a fire. In this case, all that's left to do is to go
                            	  4994:     ; deactivate the shot object.
                            	  4995:     ;
02:0004C054 41EC00AC        	  4996:     lea     ($00AC,A4),A0
02:0004C058 10302000        	  4997:     move.b  (A0,D2.W),D0
02:0004C05C 0C000021        	  4998:     cmpi.b  #$21,D0
02:0004C060 6702            	  4999:     beq.s  __far_z_07_0077
02:0004C062 6038            	  5000:     jmp  DeactivateLinkShot
                            	  5001: __far_z_07_0077:
                            	  5002:     ; Make state $22 for a standing fire.
                            	  5003:     ;
02:0004C064 41EC00AC        	  5004:     lea     ($00AC,A4),A0
02:0004C068 52302000        	  5005:     addq.b  #1,(A0,D2.W)
                            	  5006:     ; Copy the shot's position and direction to the fire.
                            	  5007:     ;
02:0004C06C 760E            	  5008:     moveq   #14,D3
02:0004C06E 10343070        	  5009:     move.b  ($70,A4,D3.W),D0
02:0004C072 19802070        	  5010:     move.b  D0,($70,A4,D2.W)
02:0004C076 41EC0084        	  5011:     lea     ($0084,A4),A0
02:0004C07A 10303000        	  5012:     move.b  (A0,D3.W),D0
02:0004C07E 41EC0084        	  5013:     lea     ($0084,A4),A0
02:0004C082 11802000        	  5014:     move.b  D0,(A0,D2.W)
02:0004C086 41EC0098        	  5015:     lea     ($0098,A4),A0
02:0004C08A 10303000        	  5016:     move.b  (A0,D3.W),D0
02:0004C08E 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004C092 11802000        	  5018:     move.b  D0,(A0,D2.W)
                            	  5019:     ; The fire lasts $4F frames.
                            	  5020:     ; Deactivate the shot.
                            	  5021:     ;
02:0004C096 704F            	  5022:     moveq   #79,D0
02:0004C098 19802028        	  5023:     move.b  D0,($28,A4,D2.W)
                            	  5024:     even
                            	  5025: DeactivateLinkShot:
02:0004C09C 4EF90002BC8E    	  5026:     jmp     c_deactivate_link_shot
                            	  5027: 
