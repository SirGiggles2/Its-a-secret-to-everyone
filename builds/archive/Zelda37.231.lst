                            	  3595:     ; Decrement the animation counter, and roll over if needed.
                            	  3596:     ;
02:0003B0C6 41EC03D0        	  3597:     lea     ($03D0,A4),A0
02:0003B0CA 53302000        	  3598:     subq.b  #1,(A0,D2.W)
02:0003B0CE 661E            	  3599:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B0D0 7006            	  3600:     moveq   #6,D0
02:0003B0D2 41EC03D0        	  3601:     lea     ($03D0,A4),A0
02:0003B0D6 11802000        	  3602:     move.b  D0,(A0,D2.W)
                            	  3603:     ; There are actually 6 frame images divided into 2 sets.
                            	  3604:     ; Each set depicts one animation frame. In each set there are
                            	  3605:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3606:     ;
                            	  3607:     ; The movement frame will keep track of the base offset of
                            	  3608:     ; the current set for the current animation frame: 0 or 3.
                            	  3609:     ;
                            	  3610:     ; So, XOR the movement frame with 3.
                            	  3611:     ;
02:0003B0DA E208            	  3612:     lsr.b  #1,D0   ; LSR A
02:0003B0DC 41EC03E4        	  3613:     lea     ($03E4,A4),A0
02:0003B0E0 12302000        	  3614:     move.b  (A0,D2.W),D1
02:0003B0E4 B300            	  3615:     eor.b  D1,D0
02:0003B0E6 41EC03E4        	  3616:     lea     ($03E4,A4),A0
02:0003B0EA 11802000        	  3617:     move.b  D0,(A0,D2.W)
                            	  3618:     even
                            	  3619: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3620:     ; Add the base offset and the directional offset, and save the result.
                            	  3621:     ;
02:0003B0EE 101D            	  3622:     move.b  (A5)+,D0  ; PLA
02:0003B0F0 023C00EE        	  3623:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0F4 41EC03E4        	  3624:     lea     ($03E4,A4),A0
02:0003B0F8 12302000        	  3625:     move.b  (A0,D2.W),D1
02:0003B0FC D101            	  3626:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0FE 1B00            	  3627:     move.b  D0,-(A5)  ; PHA
                            	  3628:     ; If facing vertically, go draw mirrored.
                            	  3629:     ;
02:0003B100 41EC0098        	  3630:     lea     ($0098,A4),A0
02:0003B104 10302000        	  3631:     move.b  (A0,D2.W),D0
02:0003B108 0200000C        	  3632:     andi.b #$0C,D0
02:0003B10C 660E            	  3633:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3634:     ; Else draw not mirrored.
                            	  3635:     ;
02:0003B10E 101D            	  3636:     move.b  (A5)+,D0  ; PLA
02:0003B110 4EB900031838    	  3637:     jsr     DrawObjectNotMirrored
02:0003B116 4EF900031BB4    	  3638:     jmp     CheckMonsterCollisions
                            	  3639: 
                            	  3640:     even
                            	  3641: _L_z04_UpdateOctorock_DrawMirrored:
02:0003B11C 101D            	  3642:     move.b  (A5)+,D0  ; PLA
                            	  3643: ; Params:
                            	  3644: ; A: frame image
                            	  3645: ; X: object index
                            	  3646: ; [00]: object X
                            	  3647: ; [01]: object Y
                            	  3648: ;
                            	  3649:     even
                            	  3650: DrawObjectMirroredAndCheckCollisions:
02:0003B11E 4EB900031834    	  3651:     jsr     DrawObjectMirrored
02:0003B124 4EF900031BB4    	  3652:     jmp     CheckMonsterCollisions
                            	  3653: 
                            	  3654:     even
                            	  3655: UpdateGhini:
02:0003B12A 103C00FF        	  3656:     move.b  #$FF,D0
02:0003B12E 6100E80E        	  3657:     jsr     UpdateCommonWanderer
02:0003B132 6130            	  3658:     jsr     DrawGhiniAndCheckCollisions
02:0003B134 4EB900031BB4    	  3659:     jsr     CheckMonsterCollisions
                            	  3660:     ; If the monster is still alive, then return.
                            	  3661:     ;
02:0003B13A 41EC0405        	  3662:     lea     ($0405,A4),A0
02:0003B13E 10302000        	  3663:     move.b  (A0,D2.W),D0
02:0003B142 671E            	  3664:     beq  _L_z04_UpdateGhini_Exit
                            	  3665:     ; For each object slot from $B to 1:
                            	  3666:     ; If the object is a flying ghini ($22),
                            	  3667:     ; then kill it by setting metastate to $11.
                            	  3668:     ;
02:0003B144 760B            	  3669:     moveq   #11,D3
                            	  3670:     even
                            	  3671: _L_z04_UpdateGhini_LoopObject:
02:0003B146 41EC034F        	  3672:     lea     ($034F,A4),A0
02:0003B14A 10303000        	  3673:     move.b  (A0,D3.W),D0
02:0003B14E 0C000022        	  3674:     cmpi.b  #$22,D0
02:0003B152 660A            	  3675:     bne  _anon_z04_50
02:0003B154 7011            	  3676:     moveq   #17,D0
02:0003B156 41EC0405        	  3677:     lea     ($0405,A4),A0
02:0003B15A 11803000        	  3678:     move.b  D0,(A0,D3.W)
                            	  3679: _anon_z04_50:
02:0003B15E 5303            	  3680:     subq.b  #1,D3
02:0003B160 66E4            	  3681:     bne  _L_z04_UpdateGhini_LoopObject
                            	  3682:     even
                            	  3683: _L_z04_UpdateGhini_Exit:
02:0003B162 4E75            	  3684:     rts
                            	  3685: 
                            	  3686:     even
                            	  3687: DrawGhiniAndCheckCollisions:
02:0003B164 4EB90004CDB8    	  3688:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B16A 1940000D        	  3689:     move.b  D0,($000D,A4)
                            	  3690:     ; If the direction has an "up" component, then keep the
                            	  3691:     ; frame image 0, and go figure out horizontal flipping.
                            	  3692:     ;
02:0003B16E 41EC0098        	  3693:     lea     ($0098,A4),A0
02:0003B172 10302000        	  3694:     move.b  (A0,D2.W),D0
02:0003B176 02000008        	  3695:     andi.b #$08,D0
02:0003B17A 6614            	  3696:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3697:     ; Else make the frame image 1 for the "down" frame.
                            	  3698:     ; Note that this is the frame image to use, even if there's no
                            	  3699:     ; down component in the direction.
                            	  3700:     ;
02:0003B17C 522C000D        	  3701:     addq.b  #1,($000D,A4)
                            	  3702:     ; If right is a component of the direction, then go set horizontal
                            	  3703:     ; flipping. Else leave horizontal flipping = 0.
                            	  3704:     ;
02:0003B180 41EC0098        	  3705:     lea     ($0098,A4),A0
02:0003B184 10302000        	  3706:     move.b  (A0,D2.W),D0
02:0003B188 02000001        	  3707:     andi.b #$01,D0
02:0003B18C 6714            	  3708:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B18E 660E            	  3709:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3710:     even
                            	  3711: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3712:     ; Set horizontal flipping if right is a direction component.
                            	  3713:     ; This essentially the same test as above, but for when we jump
                            	  3714:     ; from the "up" test.
                            	  3715:     ;
02:0003B190 41EC0098        	  3716:     lea     ($0098,A4),A0
02:0003B194 10302000        	  3717:     move.b  (A0,D2.W),D0
02:0003B198 02000002        	  3718:     andi.b #$02,D0
02:0003B19C 6704            	  3719:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3720:     even
                            	  3721: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B19E 522C000F        	  3722:     addq.b  #1,($000F,A4)
                            	  3723:     even
                            	  3724: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B1A2 102C000D        	  3725:     move.b  ($000D,A4),D0
                            	  3726: ; Params:
                            	  3727: ; A: frame image
                            	  3728: ; X: object index
                            	  3729: ; [00]: object X
                            	  3730: ; [01]: object Y
                            	  3731: ; [0F]: flip horizontally
                            	  3732: ;
                            	  3733: ; Returns:
                            	  3734: ; [00]: 0 for Link slot
                            	  3735: ; [06]: 1 if objects collide
                            	  3736: ; [09]: 0 for Link damage type (none)
                            	  3737: ; [0C]: 1 if objects collide
                            	  3738: ; [034B]: ShotCollidesWithLink
                            	  3739: ;
                            	  3740:     even
                            	  3741: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003B1A6 4EB900031838    	  3742:     jsr     DrawObjectNotMirrored
02:0003B1AC 4EF900031CFE    	  3743:     jmp     CheckLinkCollision
                            	  3744: 
                            	  3745:     even
                            	  3746: SecretArmosRoomIds:
02:0003B1B2 24              	  3747:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B1B3 0B
02:0003B1B4 1C
02:0003B1B5 22
02:0003B1B6 34
02:0003B1B7 3D
02:0003B1B8 4E
                            	  3748: 
                            	  3749:     even
                            	  3750: SecretArmosXs:
02:0003B1BA E0              	  3751:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B1BB B0
02:0003B1BC B0
02:0003B1BD 30
02:0003B1BE 40
02:0003B1BF 90
02:0003B1C0 A0
                            	  3752: 
                            	  3753:     even
                            	  3754: InitArmosOrFlyingGhini:
                            	  3755:     ; In UpdateObject, this object was flagged "initialized".
                            	  3756:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3757:     ;
02:0003B1C2 10342028        	  3758:     move.b  ($28,A4,D2.W),D0
02:0003B1C6 41EC0492        	  3759:     lea     ($0492,A4),A0
02:0003B1CA 11802000        	  3760:     move.b  D0,(A0,D2.W)
                            	  3761:     ; If it's still fading in, then go finish some initialization needed
                            	  3762:     ; for fading in.
                            	  3763:     ;
02:0003B1CE 660000B6        	  3764:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3765:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3766:     ; go finish initializing it.
                            	  3767:     ;
02:0003B1D2 41EC034F        	  3768:     lea     ($034F,A4),A0
02:0003B1D6 10302000        	  3769:     move.b  (A0,D2.W),D0
02:0003B1DA 0C000022        	  3770:     cmpi.b  #$22,D0
02:0003B1DE 670000A6        	  3771:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3772:     ; Else we have an armos.
                            	  3773:     ;
                            	  3774:     ; Store stairs tile $70 in [00] for use later.
                            	  3775:     ;
02:0003B1E2 7070            	  3776:     moveq   #112,D0
02:0003B1E4 1880            	  3777:     move.b  D0,($0000,A4)
                            	  3778:     ; Look for the current room ID in an array of room ID's that
                            	  3779:     ; have armos secrets.
                            	  3780:     ;
02:0003B1E6 7606            	  3781:     moveq   #6,D3
                            	  3782:     even
                            	  3783: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B1E8 102C00EB        	  3784:     move.b  ($00EB,A4),D0
                            	  3785:     ; If this element does not match the current room ID, go loop again.
                            	  3786:     ;
02:0003B1EC 41F90003B1B2    	  3787:     lea     (SecretArmosRoomIds).l,A0
02:0003B1F2 12303000        	  3788:     move.b  (A0,D3.W),D1
02:0003B1F6 B001            	  3789:     cmp.b   D1,D0
02:0003B1F8 6648            	  3790:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3791:     ; The secret (usually stairs) is under one of the armoses.
                            	  3792:     ;
                            	  3793:     ; If the armos's X coordinate does not match the one needed
                            	  3794:     ; for the current room in the list, then go loop again.
                            	  3795:     ;
02:0003B1FA 10342070        	  3796:     move.b  ($70,A4,D2.W),D0
02:0003B1FE 41F90003B1BA    	  3797:     lea     (SecretArmosXs).l,A0
02:0003B204 12303000        	  3798:     move.b  (A0,D3.W),D1
02:0003B208 B001            	  3799:     cmp.b   D1,D0
02:0003B20A 6636            	  3800:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3801:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3802:     ;
02:0003B20C 41EC0084        	  3803:     lea     ($0084,A4),A0
02:0003B210 10302000        	  3804:     move.b  (A0,D2.W),D0
02:0003B214 0C000080        	  3805:     cmpi.b  #$80,D0
02:0003B218 6628            	  3806:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3807:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3808:     ;
02:0003B21A 4A03            	  3809:     cmpi.b  #$00,D3
02:0003B21C 662C            	  3810:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3811:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3812:     ; has the power bracelet.
                            	  3813:     ;
                            	  3814:     ; Set up the room item with the armos's coordinates.
                            	  3815:     ;
02:0003B21E 19400097        	  3816:     move.b  D0,($0097,A4)
02:0003B222 10342070        	  3817:     move.b  ($70,A4,D2.W),D0
02:0003B226 19400083        	  3818:     move.b  D0,($0083,A4)
                            	  3819:     ; This resets the room item's state, which activates it.
                            	  3820:     ;
02:0003B22A 194300BF        	  3821:     move.b  D3,($00BF,A4)
                            	  3822:     ; Set the room item ID.
                            	  3823:     ;
02:0003B22E 7014            	  3824:     moveq   #20,D0
02:0003B230 194000AB        	  3825:     move.b  D0,($00AB,A4)
                            	  3826:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3827:     ;
                            	  3828:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3829:     ;
                            	  3830:     ; Note that, if the item was already taken, then the room item
                            	  3831:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3832:     ; it will be ignored, because that routine checks whether
                            	  3833:     ; the item was taken.
                            	  3834:     ;
02:0003B234 4EB9000311E0    	  3835:     jsr     GetRoomFlagUWItemState
02:0003B23A 660A            	  3836:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B23C 610006B2        	  3837:     jsr     PlaySecretFoundTune
02:0003B240 6604            	  3838:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3839:     even
                            	  3840: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3841:     ; Bottom of the loop.
                            	  3842:     ;
02:0003B242 5303            	  3843:     subq.b  #1,D3
02:0003B244 6AA2            	  3844:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3845:     even
                            	  3846: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3847:     ; Not found, or found the power bracelet.
                            	  3848:     ; Use a floor tile $26 to replace the armos.
                            	  3849:     ;
02:0003B246 7026            	  3850:     moveq   #38,D0
02:0003B248 1880            	  3851:     move.b  D0,($0000,A4)
                            	  3852:     even
                            	  3853: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B24A 1014            	  3854:     move.b  ($0000,A4),D0
                            	  3855:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3856:     ;
02:0003B24C 1B00            	  3857:     move.b  D0,-(A5)  ; PHA
02:0003B24E 0C000070        	  3858:     cmpi.b  #$70,D0
02:0003B252 6604            	  3859:     bne  _anon_z04_51
02:0003B254 6100069A        	  3860:     jsr     PlaySecretFoundTune
                            	  3861: _anon_z04_51:
                            	  3862:     ; Replace the tile where the armos was.
                            	  3863:     ;
02:0003B258 522C00F7        	  3864:     addq.b  #1,($00F7,A4)
02:0003B25C 101D            	  3865:     move.b  (A5)+,D0  ; PLA
02:0003B25E 4EB90004ADD0    	  3866:     jsr     ChangeTileObjTiles
                            	  3867:     ; Because the armos object is aligned to the square grid
                            	  3868:     ; (because it was made from a square),
                            	  3869:     ; set its grid offset to 3 to compensate.
                            	  3870:     ;
                            	  3871:     ; Most objects are aligned to the grid vertically when the
                            	  3872:     ; low nibble is $D.
                            	  3873:     ;
02:0003B264 7003            	  3874:     moveq   #3,D0
02:0003B266 41EC0394        	  3875:     lea     ($0394,A4),A0
02:0003B26A 11802000        	  3876:     move.b  D0,(A0,D2.W)
                            	  3877:     ; Set a speed (q-speed fraction) randomly:
                            	  3878:     ; $20 if random value < $80
                            	  3879:     ; $60 otherwise
                            	  3880:     ;
02:0003B26E 7020            	  3881:     moveq   #32,D0
02:0003B270 7600            	  3882:     moveq   #0,D3
02:0003B272 16342019        	  3883:     move.b  ($19,A4,D2.W),D3
02:0003B276 0C030080        	  3884:     cmpi.b  #$80,D3
02:0003B27A 6502            	  3885:     bcs  _anon_z04_52
02:0003B27C 7060            	  3886:     moveq   #96,D0
                            	  3887: _anon_z04_52:
02:0003B27E 41EC03BC        	  3888:     lea     ($03BC,A4),A0
02:0003B282 11802000        	  3889:     move.b  D0,(A0,D2.W)
                            	  3890:     even
                            	  3891: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3892:     ; Facing and input directions down.
                            	  3893:     ;
02:0003B286 7004            	  3894:     moveq   #4,D0
02:0003B288 41EC03F8        	  3895:     lea     ($03F8,A4),A0
02:0003B28C 11802000        	  3896:     move.b  D0,(A0,D2.W)
02:0003B290 41EC0098        	  3897:     lea     ($0098,A4),A0
02:0003B294 11802000        	  3898:     move.b  D0,(A0,D2.W)
                            	  3899:     ; Every other frame, return without drawing.
                            	  3900:     ;
02:0003B298 10342028        	  3901:     move.b  ($28,A4,D2.W),D0
02:0003B29C E208            	  3902:     lsr.b  #1,D0   ; LSR A
02:0003B29E 6512            	  3903:     bcs  _anon_z04_53
                            	  3904:     ; Finish initializing based on type.
                            	  3905:     ;
02:0003B2A0 41EC034F        	  3906:     lea     ($034F,A4),A0
02:0003B2A4 10302000        	  3907:     move.b  (A0,D2.W),D0
02:0003B2A8 0C000022        	  3908:     cmpi.b  #$22,D0
02:0003B2AC 6602            	  3909:     bne.s  __far_z_04_0032
02:0003B2AE 6008            	  3910:     jmp  L_EndInitFlyingGhini
                            	  3911: __far_z_04_0032:
02:0003B2B0 6158            	  3912:     jsr     DrawArmosAndCheckCollisions
                            	  3913: _anon_z04_53:
02:0003B2B2 0A3C0001        	  3914:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B2B6 4E75            	  3915:     rts
                            	  3916: 
                            	  3917:     even
                            	  3918: L_EndInitFlyingGhini:
02:0003B2B8 6100FEAA        	  3919:     jsr     DrawGhiniAndCheckCollisions
                            	  3920:     ; If we're finally leaving the object flagged "initialized",
                            	  3921:     ; then reset metastate and initialize this as a flyer.
                            	  3922:     ;
02:0003B2BC 41EC0492        	  3923:     lea     ($0492,A4),A0
02:0003B2C0 10302000        	  3924:     move.b  (A0,D2.W),D0
02:0003B2C4 66EC            	  3925:     bne  _anon_z04_53
02:0003B2C6 4EB90004D5BA    	  3926:     jsr     ResetObjMetastateAndTimer
02:0003B2CC 6000F44A        	  3927:     jmp     EndInitFlyer
                            	  3928: 
                            	  3929:     even
                            	  3930: UpdateArmos:
02:0003B2D0 6100E7DA        	  3931:     jsr     UpdateGoriya
                            	  3932:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3933:     ;
02:0003B2D4 41EC00C0        	  3934:     lea     ($00C0,A4),A0
02:0003B2D8 10302000        	  3935:     move.b  (A0,D2.W),D0
02:0003B2DC 6702            	  3936:     beq.s  __far_z_04_0033
02:0003B2DE 602A            	  3937:     jmp  DrawArmosAndCheckCollisions
                            	  3938: __far_z_04_0033:
                            	  3939:     ; Animate.
                            	  3940:     ;
                            	  3941:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3942:     ; then only go draw.
                            	  3943:     ;
02:0003B2E0 41EC03D0        	  3944:     lea     ($03D0,A4),A0
02:0003B2E4 53302000        	  3945:     subq.b  #1,(A0,D2.W)
02:0003B2E8 6702            	  3946:     beq.s  __far_z_04_0034
02:0003B2EA 601E            	  3947:     jmp  DrawArmosAndCheckCollisions
                            	  3948: __far_z_04_0034:
                            	  3949:     ; Armos animation frames last 6 screen frames.
                            	  3950:     ;
02:0003B2EC 7006            	  3951:     moveq   #6,D0
02:0003B2EE 41EC03D0        	  3952:     lea     ($03D0,A4),A0
02:0003B2F2 11802000        	  3953:     move.b  D0,(A0,D2.W)
                            	  3954:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3955:     ; change the position of the shield. To keep fixed it in place,
                            	  3956:     ; there are separate frame images for each animation frame.
                            	  3957:     ;
                            	  3958:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3959:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3960:     ;
                            	  3961:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3962:     ; Then choose the direction at the point of drawing below.
                            	  3963:     ;
02:0003B2F6 41EC03E4        	  3964:     lea     ($03E4,A4),A0
02:0003B2FA 10302000        	  3965:     move.b  (A0,D2.W),D0
02:0003B2FE 0A000002        	  3966:     eori.b #$02,D0
02:0003B302 41EC03E4        	  3967:     lea     ($03E4,A4),A0
02:0003B306 11802000        	  3968:     move.b  D0,(A0,D2.W)
                            	  3969:     even
                            	  3970: DrawArmosAndCheckCollisions:
02:0003B30A 4EB90004CDB8    	  3971:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B310 7600            	  3972:     moveq   #0,D3
02:0003B312 41EC0098        	  3973:     lea     ($0098,A4),A0
02:0003B316 16302000        	  3974:     move.b  (A0,D2.W),D3
                            	  3975:     ; If facing up, then use the second frame image in the set ("back").
                            	  3976:     ; Else use the second.
                            	  3977:     ;
02:0003B31A 0C030008        	  3978:     cmpi.b  #$08,D3
02:0003B31E 6602            	  3979:     bne  _anon_z04_54
02:0003B320 7001            	  3980:     moveq   #1,D0
                            	  3981: _anon_z04_54:
02:0003B322 023C00EE        	  3982:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B326 41EC03E4        	  3983:     lea     ($03E4,A4),A0
02:0003B32A 12302000        	  3984:     move.b  (A0,D2.W),D1
02:0003B32E D101            	  3985:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B330 4EB900031838    	  3986:     jsr     DrawObjectNotMirrored
                            	  3987:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3988:     ; but not with weapons.
                            	  3989:     ;
02:0003B336 10342028        	  3990:     move.b  ($28,A4,D2.W),D0
02:0003B33A 661C            	  3991:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3992:     ; Else check for all collisions.
                            	  3993:     ;
02:0003B33C 4EB900031BB4    	  3994:     jsr     CheckMonsterCollisions
                            	  3995:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3996:     ;
02:0003B342 41EC0405        	  3997:     lea     ($0405,A4),A0
02:0003B346 10302000        	  3998:     move.b  (A0,D2.W),D0
02:0003B34A 670A            	  3999:     beq  _anon_z04_55
02:0003B34C 705D            	  4000:     moveq   #93,D0
02:0003B34E 41EC034F        	  4001:     lea     ($034F,A4),A0
02:0003B352 11802000        	  4002:     move.b  D0,(A0,D2.W)
