02:0003CC54 06
02:0003CC55 FF
02:0003CC56 08
02:0003CC57 02
02:0003CC58 03
02:0003CC59 06
02:0003CC5A FF              	  7452:     dc.b    $FF, $08
02:0003CC5B 08
