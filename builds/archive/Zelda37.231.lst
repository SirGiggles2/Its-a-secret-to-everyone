                            	  5008: 
                            	  5009: ; Each byte describes an item. The high nibble is the type.
                            	  5010: ; The low nibble is the value. Its meaning depends on the type.
                            	  5011: ;
                            	  5012: ; 0x - individuals
                            	  5013: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5014: ; * bit mask: value doesn't matter.
                            	  5015: ;
                            	  5016: ; 1x - amounts
                            	  5017: ; Value is an amount to add.
                            	  5018: ;
                            	  5019: ; 2x - grades
                            	  5020: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5021: ;
                            	  5022: ; 3x - error?
                            	  5023: ; Produces an item value of $FF.
                            	  5024: ;
                            	  5025:     even
