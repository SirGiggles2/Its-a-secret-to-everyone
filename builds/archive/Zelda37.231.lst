                            	   203: InitCave:
                            	   204:     ; The person goes at location ($78, $80).
                            	   205:     ;
02:0002E096 7078            	   206:     moveq   #120,D0
02:0002E098 163C0080        	   207:     move.b  #$80,D3
02:0002E09C 610001A0        	   208:     jsr     SetUpCommonCaveObjects
                            	   209:     ; If the cave/person does not remember state (give item, door charge),
                            	   210:     ; then go handle other kinds.
                            	   211:     ;
02:0002E0A0 102C0350        	   212:     move.b  ($0350,A4),D0
02:0002E0A4 0C000072        	   213:     cmpi.b  #$72,D0
02:0002E0A8 6714            	   214:     beq  _L_z01_InitCave_TakeType
02:0002E0AA 0C000071        	   215:     cmpi.b  #$71,D0
02:0002E0AE 670E            	   216:     beq  _L_z01_InitCave_TakeType
02:0002E0B0 0C00007B        	   217:     cmpi.b  #$7B,D0
02:0002E0B4 6408            	   218:     bcc  _L_z01_InitCave_TakeType
02:0002E0B6 0C00006E        	   219:     cmpi.b  #$6E,D0
02:0002E0BA 6502            	   220:     bcs.s  __far_z_01_0000
02:0002E0BC 6012            	   221:     jmp  InitCaveContinue
                            	   222: __far_z_01_0000:
                            	   223:     even
                            	   224: _L_z01_InitCave_TakeType:
                            	   225:     ; Else the cave/person simply does:
                            	   226:     ; - taken:     no person, no text
                            	   227:     ; - not taken: show a person and text
                            	   228:     ;
                            	   229:     ; So, if the item was not taken, then go set up the text.
                            	   230:     ;
02:0002E0BE 61003120        	   231:     jsr     GetRoomFlagUWItemState
02:0002E0C2 6602            	   232:     bne.s  __far_z_01_0001
02:0002E0C4 600A            	   233:     jmp  InitCaveContinue
                            	   234: __far_z_01_0001:
                            	   235:     ; Otherwise destroy the person object, and let Link continue.
                            	   236:     ;
02:0002E0C6 7000            	   237:     moveq   #0,D0
02:0002E0C8 19400350        	   238:     move.b  D0,($0350,A4)
                            	   239:     even
                            	   240: UnhaltLink:
02:0002E0CC 6000D920        	   241:     jmp     c_unhalt_link
                            	   242: 
                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002E0D0 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002E0D4 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E0D8 123C006A        	   248:     move.b  #$6A,D1
02:0002E0DC 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E0E0 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E0E2 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E0E6 7600            	   252:     moveq   #0,D3
02:0002E0E8 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E0EA 41F90002E068    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E0F0 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E0F4 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E0F6 0200003F        	   260:     andi.b #$3F,D0
02:0002E0FA 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E0FE 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E100 020000C0        	   266:     andi.b #$C0,D0
02:0002E104 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
                            	   269:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   270:     ;
02:0002E108 103C00FD        	   271:     move.b  #$FD,D0
                            	   272: _anon_z01_0:
02:0002E10C 023C00EE        	   273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E110 123C0003        	   274:     move.b  #$03,D1
02:0002E114 D101            	   275:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E116 5303            	   276:     subq.b  #1,D3
02:0002E118 6AF2            	   277:     bpl  _anon_z01_0
02:0002E11A 7600            	   278:     moveq   #0,D3
02:0002E11C 1600            	   279:     move.b  D0,D3
                            	   280:     ; Loop over the wares from 0 to 2.
                            	   281:     ;
02:0002E11E 7400            	   282:     moveq   #0,D2
                            	   283:     even
                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E120 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E126 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E12A 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E12E 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E132 020000C0        	   294:     andi.b #$C0,D0
02:0002E136 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E13A 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E140 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E144 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E148 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E14C 5203            	   304:     addq.b  #1,D3
02:0002E14E 5202            	   305:     addq.b  #1,D2
02:0002E150 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E154 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E156 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E15A E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E15C E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E15E E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E160 1214            	   315:     move.b  ($0000,A4),D1
02:0002E162 8001            	   316:     or.b  D1,D0
02:0002E164 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E166 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E16A E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E16C E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E16E E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E170 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E172 1214            	   326:     move.b  ($0000,A4),D1
02:0002E174 8001            	   327:     or.b  D1,D0
02:0002E176 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E178 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E17C E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E17E E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E180 1214            	   335:     move.b  ($0000,A4),D1
02:0002E182 8001            	   336:     or.b  D1,D0
02:0002E184 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E188 02000020        	   343:     andi.b #$20,D0
02:0002E18C 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E190 103C00FF        	   350:     move.b  #$FF,D0
02:0002E194 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E196 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E19A B001            	   355:     cmp.b   D1,D0
02:0002E19C 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E19E 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E1A2 123C002B        	   360:     move.b  #$2B,D1
02:0002E1A6 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E1AA 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E1AC 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E1B0 5303            	   364:     subq.b  #1,D3
02:0002E1B2 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_FoundPermutation:
                            	   368:     ; The index chooses the last offset of a permutation of three indexes.
                            	   369:     ;
02:0002E1B4 7400            	   370:     moveq   #0,D2
02:0002E1B6 41F90002E090    	   371:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E1BC 14303000        	   372:     move.b  (A0,D3.W),D2
                            	   373:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   374:     ;
02:0002E1C0 7602            	   375:     moveq   #2,D3
                            	   376:     even
                            	   377: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E1C2 41F90002E07E    	   378:     lea     (MoneyGamePermutations).l,A0
02:0002E1C8 10302000        	   379:     move.b  (A0,D2.W),D0
02:0002E1CC 41EC046C        	   380:     lea     ($046C,A4),A0
02:0002E1D0 11803000        	   381:     move.b  D0,(A0,D3.W)
02:0002E1D4 5302            	   382:     subq.b  #1,D2
02:0002E1D6 5303            	   383:     subq.b  #1,D3
02:0002E1D8 6AE8            	   384:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   385:     ; With the first bit of another random number, choose 10 or 40
                            	   386:     ; to put in [046F]. This is a random amount to lose.
                            	   387:     ;
02:0002E1DA 102C001A        	   388:     move.b  ($001A,A4),D0
02:0002E1DE 02000001        	   389:     andi.b #$01,D0
02:0002E1E2 7600            	   390:     moveq   #0,D3
02:0002E1E4 1600            	   391:     move.b  D0,D3
02:0002E1E6 41F90002E07C    	   392:     lea     (MoneyGameLossAmounts).l,A0
02:0002E1EC 10303000        	   393:     move.b  (A0,D3.W),D0
02:0002E1F0 1940046F        	   394:     move.b  D0,($046F,A4)
                            	   395:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   396:     ;
02:0002E1F4 700A            	   397:     moveq   #10,D0
02:0002E1F6 19400470        	   398:     move.b  D0,($0470,A4)
                            	   399:     ; With a different bit of the second random number,
                            	   400:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   401:     ;
02:0002E1FA 7614            	   402:     moveq   #20,D3
02:0002E1FC 102C001A        	   403:     move.b  ($001A,A4),D0
02:0002E200 02000002        	   404:     andi.b #$02,D0
02:0002E204 6702            	   405:     beq  _anon_z01_1
02:0002E206 7632            	   406:     moveq   #50,D3
                            	   407: _anon_z01_1:
02:0002E208 19430471        	   408:     move.b  D3,($0471,A4)
                            	   409:     ; The 3 amounts are now in [046F] to [0471].
                            	   410:     ; Reference these amounts using the permutation of indexes
                            	   411:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   412:     ;
02:0002E20C 7402            	   413:     moveq   #2,D2
                            	   414:     even
                            	   415: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E20E 7600            	   416:     moveq   #0,D3
02:0002E210 41EC046C        	   417:     lea     ($046C,A4),A0
02:0002E214 16302000        	   418:     move.b  (A0,D2.W),D3
02:0002E218 41EC046F        	   419:     lea     ($046F,A4),A0
02:0002E21C 10303000        	   420:     move.b  (A0,D3.W),D0
02:0002E220 41EC0448        	   421:     lea     ($0448,A4),A0
02:0002E224 11802000        	   422:     move.b  D0,(A0,D2.W)
02:0002E228 5302            	   423:     subq.b  #1,D2
02:0002E22A 6AE2            	   424:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   425:     even
                            	   426: _L_z01_InitCaveContinue_ResetTextbox:
                            	   427:     ; Reset the current character index.
                            	   428:     ;
02:0002E22C 7000            	   429:     moveq   #0,D0
02:0002E22E 19400416        	   430:     move.b  D0,($0416,A4)
                            	   431:     ; Point to the front of the first textbox line.
                            	   432:     ;
02:0002E232 10390002E44A    	   433:     move.b  (TextboxLineAddrsLo+2).l,D0
02:0002E238 1940045F        	   434:     move.b  D0,($045F,A4)
02:0002E23C 4E75            	   435:     rts
                            	   436: 
                            	   437: ; Params:
                            	   438: ; A: X coordinate
                            	   439: ; Y: Y coordinate
                            	   440: ;
                            	   441: ; Set the person's coordinates, HP, and attributes.
                            	   442: ;
                            	   443:     even
