                            	  4708: _anon_z02_34:
02:00036460 41F900FF6B7E    	  4709:     lea     (NES_SRAM+$0B7E).l,A0
02:00036466 10303000        	  4710:     move.b  (A0,D3.W),D0
02:0003646A 41EC0302        	  4711:     lea     ($0302,A4),A0
