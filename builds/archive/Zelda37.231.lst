02:000302D0 1600            	  2787:     move.b  D0,D3
02:000302D2 1014            	  2788:     move.b  ($0000,A4),D0
02:000302D4 0C030002        	  2789:     cmpi.b  #$02,D3
02:000302D8 640A            	  2790:     bcc  _anon_z01_24
