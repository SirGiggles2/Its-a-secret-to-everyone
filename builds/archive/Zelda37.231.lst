02:0002E4BC 024100FF        	   797:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E4C0 E14C            	   798:     lsl.w   #8,D4
02:0002E4C2 8841            	   799:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E4C4 48C4            	   800:     ext.l   D4
02:0002E4C6 D8BC00FF0000    	   801:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E4CC 2044            	   802:     movea.l D4,A0
