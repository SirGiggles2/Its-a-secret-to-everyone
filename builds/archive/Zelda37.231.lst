02:0004C806 023C00EE        	  6088:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C80A 41F90004C72C    	  6089:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004C810 12303000        	  6090:     move.b  (A0,D3.W),D1
