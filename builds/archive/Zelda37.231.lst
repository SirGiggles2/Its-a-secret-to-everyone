02:0003CF70 7607            	  7890:     moveq   #7,D3
                            	  7891: _anon_z04_98:
                            	  7892:     ; Set the vertical speed for the beginning of the jump.
                            	  7893:     ;
02:0003CF72 41F90003CE66    	  7894:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF78 10303000        	  7895:     move.b  (A0,D3.W),D0
02:0003CF7C 41EC0412        	  7896:     lea     ($0412,A4),A0
02:0003CF80 11802000        	  7897:     move.b  D0,(A0,D2.W)
                            	  7898:     ; Look up the Y offset for the current direction.
                            	  7899:     ; Add it to object Y to set the destination Y of the jump.
                            	  7900:     ;
02:0003CF84 41EC0084        	  7901:     lea     ($0084,A4),A0
02:0003CF88 10302000        	  7902:     move.b  (A0,D2.W),D0
02:0003CF8C 023C00EE        	  7903:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF90 41F90003CE6E    	  7904:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF96 12303000        	  7905:     move.b  (A0,D3.W),D1
02:0003CF9A D101            	  7906:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF9C 41EC042C        	  7907:     lea     ($042C,A4),A0
02:0003CFA0 11802000        	  7908:     move.b  D0,(A0,D2.W)
                            	  7909:     ; Turn the index into a direction again by adding 1.
                            	  7910:     ; Store the facing direction.
