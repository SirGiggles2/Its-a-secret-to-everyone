                            	  4920: _anon_z07_24:
                            	  4921:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4922:     ;   $57 (sword shot) => $22
                            	  4923:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4924:     ;
02:0004BFEC 7622            	  4925:     moveq   #34,D3
02:0004BFEE 0C02000D        	  4926:     cmpi.b  #$0D,D2
02:0004BFF2 6410            	  4927:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BFF4 41EC034F        	  4928:     lea     ($034F,A4),A0
02:0004BFF8 10302000        	  4929:     move.b  (A0,D2.W),D0
02:0004BFFC 0C000057        	  4930:     cmpi.b  #$57,D0
02:0004C000 6710            	  4931:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004C002 660C            	  4932:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4933:     even
                            	  4934: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4935:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4936:     ;   high bit set (magic)   => $23
                            	  4937:     ;   high bit clear (sword) => $22
                            	  4938:     ;
02:0004C004 41EC00AC        	  4939:     lea     ($00AC,A4),A0
02:0004C008 10302000        	  4940:     move.b  (A0,D2.W),D0
02:0004C00C E308            	  4941:     lsl.b  #1,D0   ; ASL A
02:0004C00E 6402            	  4942:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4943:     even
