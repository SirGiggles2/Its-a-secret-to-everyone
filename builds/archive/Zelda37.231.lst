02:0003C7D4 023C00EE        	  6783:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7D8 41EC0478        	  6784:     lea     ($0478,A4),A0
02:0003C7DC 12302000        	  6785:     move.b  (A0,D2.W),D1
02:0003C7E0 D101            	  6786:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C7E2 41EC0084        	  6787:     lea     ($0084,A4),A0
02:0003C7E6 11802000        	  6788:     move.b  D0,(A0,D2.W)
