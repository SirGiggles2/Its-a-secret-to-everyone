                            	  1629:     even
                            	  1630: InitMode4:
02:00040EE6 7400            	  1631:     moveq   #0,D2
02:00040EE8 142C0013        	  1632:     move.b  ($0013,A4),D2
02:00040EEC 6604            	  1633:     bne.s  __far_z_05_0023
02:00040EEE 60000084        	  1634:     jmp  InitMode_EnterRoom
                            	  1635: __far_z_05_0023:
02:00040EF2 5302            	  1636:     subq.b  #1,D2
02:00040EF4 6612            	  1637:     bne  _L_z05_InitMode4_CheckSub2
                            	  1638:     ; Submode 1.
                            	  1639:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1640:     ;
                            	  1641:     ; TODO:
                            	  1642:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1643:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1644:     ; A positive value triggers this submode 1 to transfer
                            	  1645:     ; the whole play area.
                            	  1646:     ;
                            	  1647:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1648:     ; a good state reflecting the new room. The only thing
                            	  1649:     ; needed is possibly to brighten the room by way of
                            	  1650:     ; changing the palette.
                            	  1651:     ;
                            	  1652:     ; So why does mode 7 trigger this?
                            	  1653:     ; Is there another mode that truly needs this behavior?
                            	  1654:     ;
02:00040EF6 102C00E9        	  1655:     move.b  ($00E9,A4),D0
02:00040EFA 6B06            	  1656:     bmi  _anon_z05_40
02:00040EFC 61003610        	  1657:     jsr     CopyNextRowToTransferBuf
02:00040F00 6404            	  1658:     bcc  _L_z05_InitMode4_Exit
                            	  1659: _anon_z05_40:
02:00040F02 522C0013        	  1660:     addq.b  #1,($0013,A4)
                            	  1661:     even
                            	  1662: _L_z05_InitMode4_Exit:
02:00040F06 4E75            	  1663:     rts
                            	  1664: 
                            	  1665:     even
                            	  1666: _L_z05_InitMode4_CheckSub2:
02:00040F08 5302            	  1667:     subq.b  #1,D2
02:00040F0A 6702            	  1668:     beq.s  __far_z_05_0024
02:00040F0C 6058            	  1669:     jmp  InitMode4_Sub3
                            	  1670: __far_z_05_0024:
                            	  1671:     ; Submode 2.
                            	  1672:     ;
02:00040F0E 7600            	  1673:     moveq   #0,D3
02:00040F10 162C00EB        	  1674:     move.b  ($00EB,A4),D3
02:00040F14 6100443C        	  1675:     jsr     IsDarkRoom_Bank5
02:00040F18 6702            	  1676:     beq.s  __far_z_05_0025
02:00040F1A 6052            	  1677:     jmp  InitMode4_GoToSub0
                            	  1678: __far_z_05_0025:
                            	  1679:     ; This is a light room.
                            	  1680:     ; See if we have to brighten it after leaving a dark room.
                            	  1681:     ;
02:00040F1C 102C0098        	  1682:     move.b  ($0098,A4),D0
02:00040F20 61004278        	  1683:     jsr     CalcNextRoomByDir
                            	  1684:     ; Subtract RoomId from next room ID that was calculated
                            	  1685:     ; to get room ID offset in that direction.
02:00040F24 003C0011        	  1686:     ori     #$11,CCR  ; SEC: set C+X
02:00040F28 122C00EB        	  1687:     move.b  ($00EB,A4),D1
02:00040F2C 0A3C0010        	  1688:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040F30 9101            	  1689:     subx.b  D1,D0   ; SBC RoomId
02:00040F32 0A3C0010        	  1690:     eori    #$10,CCR  ; restore X = 6502 C
02:00040F36 4EB900030CEC    	  1691:     jsr     Negate
02:00040F3C 023C00EE        	  1692:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040F40 122C00EB        	  1693:     move.b  ($00EB,A4),D1
02:00040F44 D101            	  1694:     addx.b  D1,D0   ; ADC RoomId
02:00040F46 7600            	  1695:     moveq   #0,D3
02:00040F48 1600            	  1696:     move.b  D0,D3
02:00040F4A 61004406        	  1697:     jsr     IsDarkRoom_Bank5
02:00040F4E 6602            	  1698:     bne.s  __far_z_05_0026
02:00040F50 601C            	  1699:     jmp  InitMode4_GoToSub0
                            	  1700: __far_z_05_0026:
                            	  1701:     ; The previous room was dark.
                            	  1702:     ;
02:00040F52 102C051F        	  1703:     move.b  ($051F,A4),D0
02:00040F56 6702            	  1704:     beq.s  __far_z_05_0027
02:00040F58 6014            	  1705:     jmp  InitMode4_GoToSub0
                            	  1706: __far_z_05_0027:
02:00040F5A 103C00C0        	  1707:     move.b  #$C0,D0
                            	  1708: ; Params:
                            	  1709: ; A: start index of cycle
                            	  1710: ;
                            	  1711:     even
                            	  1712: SetFadeCycleAndAdvanceSubmode:
02:00040F5E 4EF90002C036    	  1713:     jmp     c_set_fade_cycle_advance_submode
                            	  1714: 
                            	  1715: _anon_z05_41:
02:00040F64 4E75            	  1716:     rts
                            	  1717: 
                            	  1718:     even
                            	  1719: InitMode4_Sub3:
                            	  1720:     ; Submode 3.
                            	  1721:     ;
02:00040F66 4EB9000314B6    	  1722:     jsr     AnimateWorldFading
02:00040F6C 66F6            	  1723:     bne  _anon_z05_41
                            	  1724:     even
                            	  1725: InitMode4_GoToSub0:
02:00040F6E 4EF90002B9E8    	  1726:     jmp     c_init_mode4_go_to_sub0
                            	  1727: 
                            	  1728: InitMode_EnterRoom:
02:00040F74 4EB90004B10A    	  1729:     jsr     DrawSpritesBetweenRooms
02:00040F7A 4EB90004B128    	  1730:     jsr     ResetPlayerState
                            	  1731:     ; Reset [0300] to [051F].
                            	  1732:     ;
02:00040F80 7005            	  1733:     moveq   #5,D0
02:00040F82 761F            	  1734:     moveq   #31,D3
02:00040F84 4EB90004A962    	  1735:     jsr     ClearRam0300UpTo
                            	  1736:     ; Reset door trigger info.
                            	  1737:     ;
02:00040F8A 7000            	  1738:     moveq   #0,D0
02:00040F8C 19400054        	  1739:     move.b  D0,($0054,A4)
02:00040F90 19400055        	  1740:     move.b  D0,($0055,A4)
                            	  1741:     ; Store level block attribute byte F for convenience.
                            	  1742:     ;
02:00040F94 7600            	  1743:     moveq   #0,D3
02:00040F96 162C00EB        	  1744:     move.b  ($00EB,A4),D3
02:00040F9A 41F900FF6AFE    	  1745:     lea     (NES_SRAM+$0AFE).l,A0
02:00040FA0 10303000        	  1746:     move.b  (A0,D3.W),D0
02:00040FA4 194004CD        	  1747:     move.b  D0,($04CD,A4)
02:00040FA8 61003A4C        	  1748:     jsr     ResetInvObjState
                            	  1749:     ; There's more than one way to enter a room.
                            	  1750:     ;
                            	  1751:     ; 1: Out of a cave, dungeon, or cellar
                            	  1752:     ;     a. Walking exit
                            	  1753:     ;     b. Next to stairs
                            	  1754:     ; 2: Room to room
                            	  1755:     ;
                            	  1756:     ; Determine which one we need.
                            	  1757:     ;
02:00040FAC 102C005A        	  1758:     move.b  ($005A,A4),D0
02:00040FB0 6770            	  1759:     beq  _L_z05_InitMode_EnterRoom_Method2
02:00040FB2 102C0010        	  1760:     move.b  ($0010,A4),D0
02:00040FB6 665C            	  1761:     bne  _anon_z05_42
                            	  1762:     ; Enter method 1.
                            	  1763:     ;
                            	  1764:     ; Set up Link's exit from underground.
                            	  1765:     ;
02:00040FB8 7600            	  1766:     moveq   #0,D3
02:00040FBA 162C00EB        	  1767:     move.b  ($00EB,A4),D3
02:00040FBE 41F900FF687E    	  1768:     lea     (NES_SRAM+$087E).l,A0
02:00040FC4 10303000        	  1769:     move.b  (A0,D3.W),D0
02:00040FC8 020000F0        	  1770:     andi.b #$F0,D0
02:00040FCC 19400070        	  1771:     move.b  D0,($0070,A4)
02:00040FD0 41F900FF6AFE    	  1772:     lea     (NES_SRAM+$0AFE).l,A0
02:00040FD6 10303000        	  1773:     move.b  (A0,D3.W),D0
02:00040FDA 02000007        	  1774:     andi.b #$07,D0
02:00040FDE E308            	  1775:     lsl.b  #1,D0   ; ASL A
02:00040FE0 E308            	  1776:     lsl.b  #1,D0   ; ASL A
02:00040FE2 E308            	  1777:     lsl.b  #1,D0   ; ASL A
02:00040FE4 E308            	  1778:     lsl.b  #1,D0   ; ASL A
                            	  1779:     ; Add the first Y where Link can come out of underground.
                            	  1780:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:00040FE6 123C004D        	  1781:     move.b  #$4D,D1
02:00040FEA D101            	  1782:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00040FEC 19400084        	  1783:     move.b  D0,($0084,A4)
                            	  1784:     ; If the player didn't step on a cave entrance to go underground,
                            	  1785:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1786:     ;
