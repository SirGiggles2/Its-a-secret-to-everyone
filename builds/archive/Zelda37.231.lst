02:000403A8 19400058        	   692:     move.b  D0,($0058,A4)
02:000403AC 103C00A0        	   693:     move.b  #$A0,D0
02:000403B0 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
