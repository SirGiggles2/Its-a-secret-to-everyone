                            	   945: InitMode7_Sub2:
                            	   946:     ; This transfers a room's play area tiles to nametable 2.
                            	   947:     ;
                            	   948:     ; CurRow starts at the bottom ($15).
02:000405A6 610038E2        	   949:     jsr     CopyRowToTileBuf
02:000405AA 102C0302        	   950:     move.b  ($0302,A4),D0
                            	   951:     ; Change the target nametable from 0 to 2.
                            	   952:     ;
                            	   953:     ; Because there's only a play area and no status bar in
                            	   954:     ; nametable 2, you have to add 7 to the high byte instead of 8.
                            	   955:     ; So, the top of the play area in NT 0 is at $2100.
                            	   956:     ; But the top of the play area in NT 2 is at $2800.
                            	   957:     ;
                            	   958:     ; This assumes that you want to scroll vertically, where the
                            	   959:     ; two scroll areas must be contiguous vertically.
02:000405AE 0200000F        	   960:     andi.b #$0F,D0
02:000405B2 023C00EE        	   961:     andi    #$EE,CCR  ; CLC: clear C+X
02:000405B6 123C0027        	   962:     move.b  #$27,D1
02:000405BA D101            	   963:     addx.b  D1,D0   ; ADC #$27 (X flag = 6502 C)
02:000405BC 19400302        	   964:     move.b  D0,($0302,A4)
02:000405C0 102C0098        	   965:     move.b  ($0098,A4),D0
02:000405C4 0C000004        	   966:     cmpi.b  #$04,D0
02:000405C8 6404            	   967:     bcc  _anon_z05_20
                            	   968:     ; then you DO have to account for the status bar.
                            	   969:     ; So, add $100 (by incrementing high byte) to move
                            	   970:     ; everything down 64 pixels.
                            	   971:     ;
                            	   972:     ; Now the play areas will line up in NT 0 and NT 2 when
                            	   973:     ; we change mirroring to vertical at the end of this mode.
02:000405CA 522C0302        	   974:     addq.b  #1,($0302,A4)
                            	   975: _anon_z05_20:
02:000405CE 532C00E9        	   976:     subq.b  #1,($00E9,A4)
02:000405D2 6A06            	   977:     bpl  _anon_z05_21
                            	   978:     even
