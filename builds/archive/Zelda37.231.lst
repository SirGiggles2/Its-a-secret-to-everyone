02:0003E72C 102C04D7        	 11043:     move.b  ($04D7,A4),D0
02:0003E730 E308            	 11044:     lsl.b  #1,D0   ; ASL A
02:0003E732 E308            	 11045:     lsl.b  #1,D0   ; ASL A
02:0003E734 E308            	 11046:     lsl.b  #1,D0   ; ASL A
02:0003E736 7600            	 11047:     moveq   #0,D3
02:0003E738 1600            	 11048:     move.b  D0,D3
02:0003E73A 103C00F8        	 11049:     move.b  #$F8,D0
02:0003E73E 41EC0200        	 11050:     lea     ($0200,A4),A0
02:0003E742 11803000        	 11051:     move.b  D0,(A0,D3.W)
02:0003E746 41EC0220        	 11052:     lea     ($0220,A4),A0
02:0003E74A 11803000        	 11053:     move.b  D0,(A0,D3.W)
                            	 11054:     ; Add the bit for this neck to the dead neck mask.
                            	 11055:     ; Copy it to [00].
                            	 11056:     ;
02:0003E74E 7600            	 11057:     moveq   #0,D3
02:0003E750 162C04D7        	 11058:     move.b  ($04D7,A4),D3
02:0003E754 41F90004AB00    	 11059:     lea     (LevelMasks).l,A0
02:0003E75A 10303000        	 11060:     move.b  (A0,D3.W),D0
02:0003E75E 122C0511        	 11061:     move.b  ($0511,A4),D1
02:0003E762 8001            	 11062:     or.b  D1,D0
02:0003E764 19400511        	 11063:     move.b  D0,($0511,A4)
02:0003E768 1880            	 11064:     move.b  D0,($0000,A4)
                            	 11065:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11066:     ; Count them up, and store the amount in [00].
                            	 11067:     ;
02:0003E76A 7000            	 11068:     moveq   #0,D0
02:0003E76C 7604            	 11069:     moveq   #4,D3
                            	 11070: _anon_z04_143:
02:0003E76E 1214            	 11071:     move.b  ($0000,A4),D1
02:0003E770 E209            	 11072:     lsr.b  #1,D1   ; LSR $00
02:0003E772 1881            	 11073:     move.b  D1,($0000,A4)
02:0003E774 123C0000        	 11074:     move.b  #$00,D1
02:0003E778 D101            	 11075:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E77A 5303            	 11076:     subq.b  #1,D3
02:0003E77C 66F0            	 11077:     bne  _anon_z04_143
02:0003E77E 1880            	 11078:     move.b  D0,($0000,A4)
                            	 11079:     ; Compare the number of dead necks to the original number
                            	 11080:     ; (object type - $41).
