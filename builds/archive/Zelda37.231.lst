02:0004C5EC 41EC03D0        	  5814:     lea     ($03D0,A4),A0
02:0004C5F0 11802000        	  5815:     move.b  D0,(A0,D2.W)
02:0004C5F4 41EC00AC        	  5816:     lea     ($00AC,A4),A0
02:0004C5F8 52302000        	  5817:     addq.b  #1,(A0,D2.W)
