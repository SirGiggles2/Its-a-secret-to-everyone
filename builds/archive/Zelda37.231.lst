02:0003AA8A 41EC0451        	  2779:     lea     ($0451,A4),A0
02:0003AA8E 52302000        	  2780:     addq.b  #1,(A0,D2.W)
02:0003AA92 6000FF74        	  2781:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
