                            	  2783: _anon_z04_37:
02:0003AA96 61000196        	  2784:     jsr     Jumper_PointBoulderDownward
                            	  2785:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2786:     ;
02:0003AA9A 7000            	  2787:     moveq   #0,D0
02:0003AA9C 41EC0451        	  2788:     lea     ($0451,A4),A0
02:0003AAA0 11802000        	  2789:     move.b  D0,(A0,D2.W)
                            	  2790:     ; Get the base offset for the kind of jumper the object is.
                            	  2791:     ;
02:0003AAA4 6100015E        	  2792:     jsr     Jumper_GetKind
02:0003AAA8 41F90003A994    	  2793:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AAAE 10303000        	  2794:     move.b  (A0,D3.W),D0
                            	  2795:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2796:     ;
                            	  2797:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2798:     ; does not have $B elements like the tektites' sets.
                            	  2799:     ;
                            	  2800:     ; Boulder does not need the upward accelerations.
                            	  2801:     ; So, the elements for those are used for the starting speeds
                            	  2802:     ; at 04:88F2.
                            	  2803:     ;
02:0003AAB2 023C00EE        	  2804:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AAB6 41EC0098        	  2805:     lea     ($0098,A4),A0
02:0003AABA 12302000        	  2806:     move.b  (A0,D2.W),D1
02:0003AABE D101            	  2807:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003AAC0 7600            	  2808:     moveq   #0,D3
02:0003AAC2 1600            	  2809:     move.b  D0,D3
02:0003AAC4 41F90003A972    	  2810:     lea     (JumperYAccelerations).l,A0
02:0003AACA 10303000        	  2811:     move.b  (A0,D3.W),D0
02:0003AACE 7602            	  2812:     moveq   #2,D3
02:0003AAD0 61000162        	  2813:     jsr     Jumper_MoveY
                            	  2814:     ; If the facing direction has a left component, then
                            	  2815:     ; subtract 1 from the object's X.
                            	  2816:     ;
                            	  2817:     ; Else add 1.
                            	  2818:     ;
02:0003AAD4 163C00FF        	  2819:     move.b  #$FF,D3
02:0003AAD8 41EC0098        	  2820:     lea     ($0098,A4),A0
02:0003AADC 10302000        	  2821:     move.b  (A0,D2.W),D0
02:0003AAE0 02000002        	  2822:     andi.b #$02,D0
02:0003AAE4 6602            	  2823:     bne  _anon_z04_38
02:0003AAE6 7601            	  2824:     moveq   #1,D3
                            	  2825: _anon_z04_38:
02:0003AAE8 1003            	  2826:     move.b  D3,D0
02:0003AAEA 023C00EE        	  2827:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AAEE 12342070        	  2828:     move.b  ($70,A4,D2.W),D1
02:0003AAF2 D101            	  2829:     addx.b  D1,D0   ; ADC ObjX,X
02:0003AAF4 19802070        	  2830:     move.b  D0,($70,A4,D2.W)
                            	  2831:     ; If going up (negative v-speed high byte), then
                            	  2832:     ; go animate, draw, and check collisions.
                            	  2833:     ;
02:0003AAF8 41EC0412        	  2834:     lea     ($0412,A4),A0
02:0003AAFC 10302000        	  2835:     move.b  (A0,D2.W),D0
02:0003AB00 6A04            	  2836:     bpl.s  __far_z_04_0022
02:0003AB02 60000090        	  2837:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2838: __far_z_04_0022:
                            	  2839:     ; Going down. We have to consider the target Y.
                            	  2840:     ;
                            	  2841:     ; If the absolute vertical distance to the target position >= 3,
                            	  2842:     ; then go animate, draw, and check collisions.
                            	  2843:     ;
02:0003AB06 41EC0084        	  2844:     lea     ($0084,A4),A0
02:0003AB0A 10302000        	  2845:     move.b  (A0,D2.W),D0
02:0003AB0E 003C0011        	  2846:     ori     #$11,CCR  ; SEC: set C+X
02:0003AB12 41EC0444        	  2847:     lea     ($0444,A4),A0
02:0003AB16 12302000        	  2848:     move.b  (A0,D2.W),D1
02:0003AB1A 0A3C0010        	  2849:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AB1E 9101            	  2850:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AB20 0A3C0010        	  2851:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AB24 4EB900030CE8    	  2852:     jsr     Abs
02:0003AB2A 0C000003        	  2853:     cmpi.b  #$03,D0
02:0003AB2E 6502            	  2854:     bcs.s  __far_z_04_0023
02:0003AB30 6062            	  2855:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2856: __far_z_04_0023:
                            	  2857:     ; Distance < 3. Go to state 0.
                            	  2858:     ;
                            	  2859:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2860:     ;
02:0003AB32 4EB90004C956    	  2861:     jsr     ResetObjState
02:0003AB38 7600            	  2862:     moveq   #0,D3
02:0003AB3A 41EC034F        	  2863:     lea     ($034F,A4),A0
02:0003AB3E 16302000        	  2864:     move.b  (A0,D2.W),D3
02:0003AB42 0C030020        	  2865:     cmpi.b  #$20,D3
02:0003AB46 6748            	  2866:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2867:     ; Else calculate a timer value.
                            	  2868:     ;
                            	  2869:     ; t := (Random + $10)
                            	  2870:     ; if t < $20 then
                            	  2871:     ;   t := t - $40
                            	  2872:     ;
02:0003AB48 7010            	  2873:     moveq   #16,D0
02:0003AB4A 023C00EE        	  2874:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB4E 12342019        	  2875:     move.b  ($19,A4,D2.W),D1
02:0003AB52 D101            	  2876:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AB54 0C000020        	  2877:     cmpi.b  #$20,D0
02:0003AB58 6412            	  2878:     bcc  _anon_z04_39
02:0003AB5A 003C0011        	  2879:     ori     #$11,CCR  ; SEC: set C+X
02:0003AB5E 123C0040        	  2880:     move.b  #$40,D1
02:0003AB62 0A3C0010        	  2881:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AB66 9101            	  2882:     subx.b  D1,D0   ; SBC #$40
02:0003AB68 0A3C0010        	  2883:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2884: _anon_z04_39:
                            	  2885:     ; If the object is a blue tektite, then go use this t.
                            	  2886:     ;
02:0003AB6C 7600            	  2887:     moveq   #0,D3
02:0003AB6E 41EC034F        	  2888:     lea     ($034F,A4),A0
02:0003AB72 16302000        	  2889:     move.b  (A0,D2.W),D3
02:0003AB76 0C03000D        	  2890:     cmpi.b  #$0D,D3
02:0003AB7A 6714            	  2891:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2892:     ; t := t AND $7F
                            	  2893:     ;
02:0003AB7C 0200007F        	  2894:     andi.b #$7F,D0
                            	  2895:     ; If Random < $A0, then go use this t.
                            	  2896:     ;
02:0003AB80 7600            	  2897:     moveq   #0,D3
02:0003AB82 16342019        	  2898:     move.b  ($19,A4,D2.W),D3
02:0003AB86 0C0300A0        	  2899:     cmpi.b  #$A0,D3
02:0003AB8A 6504            	  2900:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2901:     ; t := t AND $F
                            	  2902:     ;
02:0003AB8C 0200000F        	  2903:     andi.b #$0F,D0
                            	  2904:     even
                            	  2905: _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate:
02:0003AB90 19802028        	  2906:     move.b  D0,($28,A4,D2.W)
                            	  2907:     even
                            	  2908: Jumper_AnimateAndCheckCollisions:
02:0003AB94 4EB90004CDB8    	  2909:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2910:     ; TODO: [0D] ?
                            	  2911:     ; [0D] doesn't seem to be used.
                            	  2912:     ;
02:0003AB9A 1940000D        	  2913:     move.b  D0,($000D,A4)
                            	  2914:     ; If the monster is a boulder, then go animate, draw, check collision.
