                            	  2768: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2769:     ; State 1. Jumping.
                            	  2770:     ;
                            	  2771:     ; Keep the object inside the bounds of the room.
                            	  2772:     ;
02:0003AA80 61005104        	  2773:     jsr     BoundFlyer
                            	  2774:     ; If the object was blocked at the room boundary, then
                            	  2775:     ; increase boundary reversal count, and go set up another jump.
                            	  2776:     ;
02:0003AA84 102C000F        	  2777:     move.b  ($000F,A4),D0
