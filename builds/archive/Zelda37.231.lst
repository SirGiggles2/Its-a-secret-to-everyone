                            	  2648: _L_z04_UpdateTektiteOrBoulder_CheckStunned:
                            	  2649:     ; If we have the magic clock, or the monster is stunned; 
                            	  2650:     ; then go animate, draw, and check collisions.
                            	  2651:     ;
02:0003A9AA 102C066C        	  2652:     move.b  ($066C,A4),D0
02:0003A9AE 1234203D        	  2653:     move.b  ($3D,A4,D2.W),D1
02:0003A9B2 8001            	  2654:     or.b  D1,D0
02:0003A9B4 66F0            	  2655:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2656:     ; If state <> 0, go update the jump.
                            	  2657:     ;
02:0003A9B6 41EC00AC        	  2658:     lea     ($00AC,A4),A0
02:0003A9BA 10302000        	  2659:     move.b  (A0,D2.W),D0
02:0003A9BE 660000C0        	  2660:     bne  _L_z04_UpdateTektiteOrBoulder_State1
                            	  2661:     ; State 0. On the ground.
                            	  2662:     ;
                            	  2663:     ; If timer <> 0, then go animate, draw, and check collisions.
                            	  2664:     ;
02:0003A9C2 10342028        	  2665:     move.b  ($28,A4,D2.W),D0
02:0003A9C6 660000B4        	  2666:     bne  _L_z04_UpdateTektiteOrBoulder_Animate
                            	  2667:     ; State = 0 and object timer expired. Time to jump.
