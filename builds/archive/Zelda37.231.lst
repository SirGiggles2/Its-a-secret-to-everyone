                            	  4783:     ; The effect involves turning grayscale rendering on and off
                            	  4784:     ; in PPUMASK.
                            	  4785:     ;
                            	  4786:     ; Start by setting A register to the PPU mask shifted right to
                            	  4787:     ; throw away the grayscale bit.
                            	  4788:     ;
