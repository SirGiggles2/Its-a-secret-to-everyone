02:0003C356 41EC0084        	  6236:     lea     ($0084,A4),A0
02:0003C35A 10302000        	  6237:     move.b  (A0,D2.W),D0
02:0003C35E 023C00EE        	  6238:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C362 41F90003C1FE    	  6239:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C368 12303000        	  6240:     move.b  (A0,D3.W),D1
02:0003C36C D101            	  6241:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C36E 41EC0084        	  6242:     lea     ($0084,A4),A0
02:0003C372 11802000        	  6243:     move.b  D0,(A0,D2.W)
                            	  6244:     ; Check the room boundary and object collisions in this temporary location.
