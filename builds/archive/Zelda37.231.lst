                            	  2040: ;==============================================================================
                            	  2041: ; EXPORT side — carry-returning shims.
                            	  2042: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2043: ; reproduces the original function's carry normalization.
                            	  2044: ;==============================================================================
                            	  2045: 
                            	  2046: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2047: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2048:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2049:     btst    #8,D0
02:0002BF8E 670A            	  2050:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2051:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2052:     eori    #$01,CCR
02:0002BF98 4E75            	  2053:     rts
                            	  2054: .cc_cnr:
02:0002BF9A 023C00FE        	  2055:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2056:     eori    #$01,CCR
02:0002BFA2 4E75            	  2057:     rts
                            	  2058: 
                            	  2059: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
