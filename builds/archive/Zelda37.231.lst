                            	 12970: Ganon_DrawBody:
                            	 12971:     ; Loop over four 16x16 images that make up Ganon.
                            	 12972:     ; There are 6 animation frames.
                            	 12973:     ;
02:0003F528 7603            	 12974:     moveq   #3,D3
                            	 12975:     even
                            	 12976: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12977:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12978:     ;
02:0003F52A 10342070        	 12979:     move.b  ($70,A4,D2.W),D0
02:0003F52E 023C00EE        	 12980:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F532 41F90003F51C    	 12981:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F538 12303000        	 12982:     move.b  (A0,D3.W),D1
02:0003F53C D101            	 12983:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F53E 1880            	 12984:     move.b  D0,($0000,A4)
                            	 12985:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12986:     ;
02:0003F540 41EC0084        	 12987:     lea     ($0084,A4),A0
02:0003F544 10302000        	 12988:     move.b  (A0,D2.W),D0
02:0003F548 023C00EE        	 12989:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F54C 41F90003F520    	 12990:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F552 12303000        	 12991:     move.b  (A0,D3.W),D1
02:0003F556 D101            	 12992:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F558 19400001        	 12993:     move.b  D0,($0001,A4)
                            	 12994:     ; Each part has a horizontal flipping flag.
                            	 12995:     ;
02:0003F55C 41F90003F524    	 12996:     lea     (GanonSpriteHFlips).l,A0
02:0003F562 10303000        	 12997:     move.b  (A0,D3.W),D0
02:0003F566 1940000F        	 12998:     move.b  D0,($000F,A4)
                            	 12999:     ; Save and copy the loop index (the current part) to [07].
                            	 13000:     ;
02:0003F56A 1003            	 13001:     move.b  D3,D0
02:0003F56C 1B00            	 13002:     move.b  D0,-(A5)  ; PHA
02:0003F56E 19400007        	 13003:     move.b  D0,($0007,A4)
                            	 13004:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13005:     ; that make it up.
                            	 13006:     ;
02:0003F572 41EC046B        	 13007:     lea     ($046B,A4),A0
02:0003F576 10302000        	 13008:     move.b  (A0,D2.W),D0
02:0003F57A E308            	 13009:     lsl.b  #1,D0   ; ASL A
02:0003F57C E308            	 13010:     lsl.b  #1,D0   ; ASL A
                            	 13011:     ; Add [07] -- the index of the current part.
                            	 13012:     ;
                            	 13013:     ; Now you have an index into the frame image table, for the
                            	 13014:     ; current image part of the current animation frame.
                            	 13015:     ;
02:0003F57E 122C0007        	 13016:     move.b  ($0007,A4),D1
02:0003F582 D101            	 13017:     addx.b  D1,D0   ; ADC $07
02:0003F584 7600            	 13018:     moveq   #0,D3
02:0003F586 1600            	 13019:     move.b  D0,D3
02:0003F588 41F90003F504    	 13020:     lea     (GanonFrameImages).l,A0
02:0003F58E 10303000        	 13021:     move.b  (A0,D3.W),D0
02:0003F592 4EB900031838    	 13022:     jsr     DrawObjectNotMirrored
02:0003F598 101D            	 13023:     move.b  (A5)+,D0  ; PLA
                            	 13024:     ; Bottom of the part loop.
                            	 13025:     ;
02:0003F59A 7600            	 13026:     moveq   #0,D3
02:0003F59C 1600            	 13027:     move.b  D0,D3
02:0003F59E 5303            	 13028:     subq.b  #1,D3
02:0003F5A0 6A88            	 13029:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F5A2 4E75            	 13030:     rts
