                            	  2766:     ; We'll be computing the location of the square.
                            	  2767:     ; Start with Link's location.
                            	  2768:     ;
02:000302AE 102C0070        	  2769:     move.b  ($0070,A4),D0
02:000302B2 1880            	  2770:     move.b  D0,($0000,A4)
02:000302B4 102C0084        	  2771:     move.b  ($0084,A4),D0
02:000302B8 19400001        	  2772:     move.b  D0,($0001,A4)
02:000302BC 102C0098        	  2773:     move.b  ($0098,A4),D0
02:000302C0 0200000C        	  2774:     andi.b #$0C,D0
02:000302C4 6726            	  2775:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2776:     ; Link is facing vertically.
                            	  2777:     ;
                            	  2778:     ; If Link touched the left side of the square with the right side
                            	  2779:     ; of his body, then add 8 to X.
                            	  2780:     ;
                            	  2781:     ; If Link touched the right side of the square with the left side
                            	  2782:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2783:     ;
02:000302C6 102C0002        	  2784:     move.b  ($0002,A4),D0
