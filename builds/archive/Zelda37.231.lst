                            	  7470: Dodongo_Draw:
02:0003CC7A 610000F4        	  7471:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7472:     ; Make a 5-way direction index out of the facing direction
                            	  7473:     ; by shifting right once, and store it in [00].
                            	  7474:     ;
02:0003CC7E 41EC0098        	  7475:     lea     ($0098,A4),A0
02:0003CC82 10302000        	  7476:     move.b  (A0,D2.W),D0
02:0003CC86 E208            	  7477:     lsr.b  #1,D0   ; LSR A
02:0003CC88 1880            	  7478:     move.b  D0,($0000,A4)
                            	  7479:     ; If state = 0, go handle animating the two frames of this state.
                            	  7480:     ;
02:0003CC8A 7600            	  7481:     moveq   #0,D3
02:0003CC8C 41EC00AC        	  7482:     lea     ($00AC,A4),A0
02:0003CC90 16302000        	  7483:     move.b  (A0,D2.W),D3
02:0003CC94 6744            	  7484:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7485:     ; If state > 1, then the monster is stunned (state 2).
                            	  7486:     ; So, go switch frames every $20 screen frames.
                            	  7487:     ;
02:0003CC96 7020            	  7488:     moveq   #32,D0
02:0003CC98 5303            	  7489:     subq.b  #1,D3
02:0003CC9A 6640            	  7490:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7491:     ; State = 1. Bloated.
                            	  7492:     ;
                            	  7493:     ; In substate 0, go animate as usual for walking.
                            	  7494:     ;
02:0003CC9C 7600            	  7495:     moveq   #0,D3
02:0003CC9E 41EC042C        	  7496:     lea     ($042C,A4),A0
02:0003CCA2 16302000        	  7497:     move.b  (A0,D2.W),D3
02:0003CCA6 6732            	  7498:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7499:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7500:     ; go fade the boss; so that some frames are not drawn.
                            	  7501:     ;
02:0003CCA8 0C030002        	  7502:     cmpi.b  #$02,D3
02:0003CCAC 6718            	  7503:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CCAE 0C030003        	  7504:     cmpi.b  #$03,D3
02:0003CCB2 6712            	  7505:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7506:     ; State 1, substate 1
                            	  7507:     ;
                            	  7508:     ; Add $14 to the frame image index to index into the bloated
                            	  7509:     ; frame images and H-flips.
                            	  7510:     ;
02:0003CCB4 1014            	  7511:     move.b  ($0000,A4),D0
02:0003CCB6 023C00EE        	  7512:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCBA 123C0014        	  7513:     move.b  #$14,D1
02:0003CCBE D101            	  7514:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CCC0 7600            	  7515:     moveq   #0,D3
02:0003CCC2 1600            	  7516:     move.b  D0,D3
02:0003CCC4 6032            	  7517:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7518: 
                            	  7519:     even
                            	  7520: _L_z04_Dodongo_Draw_DrawFaded:
