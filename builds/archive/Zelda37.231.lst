                            	  1670: AnimateDemoPhase0Subphase1:
02:0003453C 102C0438        	  1671:     move.b  ($0438,A4),D0
02:00034540 666C            	  1672:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00034542 7000            	  1676:     moveq   #0,D0
02:00034544 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00034548 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:0003454A 41F90003432C    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00034550 D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:00034552 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:00034558 197C00000303    	  1683:     move.b  #$00,($0303,A4)
02:0003455E 7020            	  1684:     moveq   #32,D0
02:00034560 19400304        	  1685:     move.b  D0,($0304,A4)
                            	  1686:     ; End marker at DynTileBuf+4+31
02:00034564 761F            	  1687:     moveq   #31,D3
02:00034566 103C00FF        	  1688:     move.b  #$FF,D0
02:0003456A 43EC0306        	  1689:     lea     ($0306,A4),A1
02:0003456E 13803000        	  1690:     move.b  D0,(A1,D3.W)
                            	  1691:     even
                            	  1692: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00034572 10303000        	  1693:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00034576 43EC0305        	  1694:     lea     ($0305,A4),A1
02:0003457A 13803000        	  1695:     move.b  D0,(A1,D3.W)
02:0003457E 5303            	  1696:     subq.b  #1,D3
02:00034580 6AF0            	  1697:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1698:     ; Advance the subphase cycle.
                            	  1699:     ;
02:00034582 522C0437        	  1700:     addq.b  #1,($0437,A4)
                            	  1701:     ; Set the timer to the delay for the current point in the cycle.
                            	  1702:     ;
02:00034586 7600            	  1703:     moveq   #0,D3
02:00034588 162C0437        	  1704:     move.b  ($0437,A4),D3
02:0003458C 41F90003452B    	  1705:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00034592 10303000        	  1706:     move.b  (A0,D3.W),D0
02:00034596 19400438        	  1707:     move.b  D0,($0438,A4)
02:0003459A 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:0003459E 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1710:     ; Advance to the next demo phase.
                            	  1711:     ;
02:000345A0 522C042C        	  1712:     addq.b  #1,($042C,A4)
02:000345A4 7000            	  1713:     moveq   #0,D0
02:000345A6 1940042D        	  1714:     move.b  D0,($042D,A4)
02:000345AA 19400011        	  1715:     move.b  D0,($0011,A4)
                            	  1716:     even
                            	  1717: _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation:
02:000345AE 532C0438        	  1718:     subq.b  #1,($0438,A4)
02:000345B2 6100FC26        	  1719:     jsr     UpdateWaterfallAnimation
