                            	  5607: _L_z01_CheckMazes_PlaySecretTune:
                            	  5608:     ; Play secret tune, and let the player leave the maze.
                            	  5609:     ;
02:000315D2 7004            	  5610:     moveq   #4,D0
02:000315D4 19400602        	  5611:     move.b  D0,($0602,A4)
02:000315D8 4E75            	  5612:     rts
                            	  5613: 
                            	  5614: ; Params:
                            	  5615: ; [02]: Y
                            	  5616: ; [03]: X
                            	  5617: ;
                            	  5618: ; Returns:
                            	  5619: ; [00]: high byte of PPU address
                            	  5620: ; [01]: low byte of PPU address
                            	  5621: ;
                            	  5622: ;
                            	  5623: ; Turn the 16-bit value 08YY into the PPU address
                            	  5624: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5625: ;
                            	  5626: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5627: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5628: ;
                            	  5629:     even
                            	  5630: MapScreenPosToPpuAddr:
02:000315DA 6000A48A        	  5631:     jmp     c_map_screen_pos_to_ppu_addr
                            	  5632: 
