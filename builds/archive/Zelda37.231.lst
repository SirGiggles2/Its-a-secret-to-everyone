02:0004374C 4EB90003113A    	  5839:     jsr     AddToInt16At0
                            	  5840:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5841:     ; go 1 more tile down, to start the next column at the right place.
                            	  5842:     ; We have to compensate for the fact that E/W doors are 
                            	  5843:     ; shorter vertically than N/S doors.
02:00043752 4A02            	  5844:     cmpi.b  #$00,D2
