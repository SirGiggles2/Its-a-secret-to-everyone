                            	  6016: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6017:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6018:     ; We need to remember how many tiles need to be copied
                            	  6019:     ; in each transfer record.
                            	  6020:     ;
02:00043874 102C0006        	  6021:     move.b  ($0006,A4),D0
02:00043878 19400004        	  6022:     move.b  D0,($0004,A4)
                            	  6023:     ; Write the transfer record header for the door.
                            	  6024:     ;
                            	  6025:     ;
                            	  6026:     ; VRAM address high byte of door
02:0004387C 1014            	  6027:     move.b  ($0000,A4),D0
02:0004387E 41EC0302        	  6028:     lea     ($0302,A4),A0
02:00043882 11802000        	  6029:     move.b  D0,(A0,D2.W)
02:00043886 5202            	  6030:     addq.b  #1,D2
02:00043888 102C0001        	  6031:     move.b  ($0001,A4),D0
02:0004388C 41EC0302        	  6032:     lea     ($0302,A4),A0
02:00043890 11802000        	  6033:     move.b  D0,(A0,D2.W)
02:00043894 5202            	  6034:     addq.b  #1,D2
02:00043896 102C0006        	  6035:     move.b  ($0006,A4),D0
02:0004389A 41EC0302        	  6036:     lea     ($0302,A4),A0
02:0004389E 11802000        	  6037:     move.b  D0,(A0,D2.W)
02:000438A2 5202            	  6038:     addq.b  #1,D2
                            	  6039: _anon_z05_121:
                            	  6040:     ; Write two tiles in a short loop indexed by [04].
                            	  6041:     ;
02:000438A4 6100ED1C        	  6042:     jsr     WriteDoorFaceTileHorizontally
02:000438A8 66FA            	  6043:     bne  _anon_z05_121
                            	  6044:     ; OR the low VRAM address with $20 to go down one row
                            	  6045:     ; in order to work on the second row of door tiles.
                            	  6046:     ;
02:000438AA 7020            	  6047:     moveq   #32,D0
02:000438AC 122C0001        	  6048:     move.b  ($0001,A4),D1
02:000438B0 8001            	  6049:     or.b  D1,D0
02:000438B2 19400001        	  6050:     move.b  D0,($0001,A4)
                            	  6051:     ; Bottom of the loop.
                            	  6052:     ; Loop again to write the second transfer record for the
                            	  6053:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6054:     ;
02:000438B6 532C0005        	  6055:     subq.b  #1,($0005,A4)
02:000438BA 66B8            	  6056:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6057:     ; Write the end marker, and update buffer length.
                            	  6058:     ;
02:000438BC 103C00FF        	  6059:     move.b  #$FF,D0
02:000438C0 41EC0302        	  6060:     lea     ($0302,A4),A0
02:000438C4 11802000        	  6061:     move.b  D0,(A0,D2.W)
02:000438C8 1002            	  6062:     move.b  D2,D0
02:000438CA 19400301        	  6063:     move.b  D0,($0301,A4)
                            	  6064:     ; Increment the command.
                            	  6065:     ;
02:000438CE 522C0054        	  6066:     addq.b  #1,($0054,A4)
                            	  6067:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6068:     ; and resetting the door command.
                            	  6069:     ; This ends up catching original states 3 and 7.
                            	  6070:     ;
                            	  6071:     ; Else set door timer to 8 and return.
                            	  6072:     ;
02:000438D2 102C0054        	  6073:     move.b  ($0054,A4),D0
02:000438D6 02000003        	  6074:     andi.b #$03,D0
02:000438DA 6708            	  6075:     beq  _anon_z05_122
02:000438DC 7008            	  6076:     moveq   #8,D0
02:000438DE 19400027        	  6077:     move.b  D0,($0027,A4)
02:000438E2 4E75            	  6078:     rts
                            	  6079: 
                            	  6080: _anon_z05_122:
                            	  6081:     ; If the door command = 4 after incrementing it, then
                            	  6082:     ; it was 3 (close door). So:
                            	  6083:     ; 1. reset this door's flag
                            	  6084:     ; 2. remove it from the opened door mask
                            	  6085:     ; 3. reset the door command
                            	  6086:     ; 4. go lay out doors in the play area map
                            	  6087:     ;
02:000438E4 102C0054        	  6088:     move.b  ($0054,A4),D0
02:000438E8 0C000004        	  6089:     cmpi.b  #$04,D0
02:000438EC 6626            	  6090:     bne  _anon_z05_123
02:000438EE 7400            	  6091:     moveq   #0,D2
02:000438F0 142C0009        	  6092:     move.b  ($0009,A4),D2
02:000438F4 6100DB78        	  6093:     jsr     ResetDoorFlag
02:000438F8 102C0055        	  6094:     move.b  ($0055,A4),D0
02:000438FC 0A00000F        	  6095:     eori.b #$0F,D0
02:00043900 122C00EE        	  6096:     move.b  ($00EE,A4),D1
02:00043904 C001            	  6097:     and.b  D1,D0
                            	  6098:     even
                            	  6099: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043906 194000EE        	  6100:     move.b  D0,($00EE,A4)
                            	  6101:     even
                            	  6102: L_ResetDoorCmdAndLayOutDoors:
02:0004390A 7000            	  6103:     moveq   #0,D0
02:0004390C 19400054        	  6104:     move.b  D0,($0054,A4)
02:00043910 6000FCD4        	  6105:     jmp     LayOutDoors
                            	  6106: 
                            	  6107: _anon_z05_123:
                            	  6108:     ; Door command <> 4.
                            	  6109:     ; It must be 8, which means it was 7: open door.
                            	  6110:     ;
                            	  6111:     ; If the door is a shutter (7), then go add the door to the
                            	  6112:     ; opened door mask, reset door command, and lay out doors.
                            	  6113:     ;
02:00043914 102C0055        	  6114:     move.b  ($0055,A4),D0
02:00043918 19400002        	  6115:     move.b  D0,($0002,A4)
02:0004391C 6100FA32        	  6116:     jsr     FindDoorAttrByDoorBit
02:00043920 0C000007        	  6117:     cmpi.b  #$07,D0
02:00043924 676E            	  6118:     beq  _anon_z05_124
                            	  6119:     ; Else the door is not a shutter.
                            	  6120:     ;
                            	  6121:     ;
                            	  6122:     ; [09] door direction index
02:00043926 7400            	  6123:     moveq   #0,D2
02:00043928 142C0009        	  6124:     move.b  ($0009,A4),D2
02:0004392C 6100DB3A        	  6125:     jsr     SetDoorFlag
                            	  6126:     ; Get the next room's ID.
                            	  6127:     ;
02:00043930 1003            	  6128:     move.b  D3,D0
02:00043932 023C00EE        	  6129:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043936 41F9000437F2    	  6130:     lea     (DoorNextRoomIdOffsets).l,A0
02:0004393C 12302000        	  6131:     move.b  (A0,D2.W),D1
02:00043940 D101            	  6132:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043942 7600            	  6133:     moveq   #0,D3
02:00043944 1600            	  6134:     move.b  D0,D3
                            	  6135:     ; Flip the door direction index.
                            	  6136:     ;
02:00043946 1002            	  6137:     move.b  D2,D0
02:00043948 0A000001        	  6138:     eori.b #$01,D0
02:0004394C 7400            	  6139:     moveq   #0,D2
02:0004394E 1400            	  6140:     move.b  D0,D2
                            	  6141:     ; Set the door flag for the opposite door in the next room.
                            	  6142:     ;
02:00043950 1214            	  6143:     move.b  ($00,A4),D1   ; ptr lo
02:00043952 182C0001        	  6144:     move.b  ($01,A4),D4  ; ptr hi
02:00043956 024100FF        	  6145:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004395A E14C            	  6146:     lsl.w   #8,D4
02:0004395C 8841            	  6147:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004395E 48C4            	  6148:     ext.l   D4
02:00043960 D8BC00FF0000    	  6149:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043966 2044            	  6150:     movea.l D4,A0
02:00043968 10303000        	  6151:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004396C 41F90004AB00    	  6152:     lea     (LevelMasks).l,A0
02:00043972 12302000        	  6153:     move.b  (A0,D2.W),D1
02:00043976 8001            	  6154:     or.b  D1,D0
02:00043978 1214            	  6155:     move.b  ($00,A4),D1   ; ptr lo
02:0004397A 182C0001        	  6156:     move.b  ($01,A4),D4  ; ptr hi
02:0004397E 024100FF        	  6157:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043982 E14C            	  6158:     lsl.w   #8,D4
02:00043984 8841            	  6159:     or.w    D1,D4
02:00043986 48C4            	  6160:     ext.l   D4
02:00043988 D8BC00FF0000    	  6161:     add.l   #NES_RAM,D4
02:0004398E 2044            	  6162:     movea.l D4,A0
02:00043990 11803000        	  6163:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6164: _anon_z05_124:
                            	  6165:     ; Add the door to the opened door mask, reset door command,
                            	  6166:     ; and lay out doors.
                            	  6167:     ;
02:00043994 102C0055        	  6168:     move.b  ($0055,A4),D0
02:00043998 122C00EE        	  6169:     move.b  ($00EE,A4),D1
02:0004399C 8001            	  6170:     or.b  D1,D0
02:0004399E 6000FF66        	  6171:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6172: 
                            	  6173: ; Params:
                            	  6174: ; [08]: 0 if closed
                            	  6175: ;
                            	  6176: ; Returns:
                            	  6177: ; X: current length of dynamic transfer buf
                            	  6178: ; [00]: door VRAM address high byte
                            	  6179: ; [01]: door VRAM address low byte
                            	  6180: ; [02:03]: address of door tiles for direction and face
                            	  6181: ; [05]: 2, the number of transfer records to write
                            	  6182: ; [06]: 2, the number of tiles in each record
                            	  6183: ; [07]: 0, the first index of a tile to transfer
                            	  6184: ; [09]: door direction index
                            	  6185: ;
                            	  6186: ; Note that this routine is called with triggered doors:
                            	  6187: ; doors that can change state. Their door type numbers are >= 4.
                            	  6188: ;
                            	  6189: ; If this routine were ever called with a fixed door
                            	  6190: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6191: ; values for the door face.
                            	  6192: ;
                            	  6193: ;
                            	  6194: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6195: ;
                            	  6196:     even
                            	  6197: PrepareWriteHorizontalDoorTransferRecords:
02:000439A2 102C0055        	  6198:     move.b  ($0055,A4),D0
02:000439A6 19400002        	  6199:     move.b  D0,($0002,A4)
02:000439AA 6100F9A4        	  6200:     jsr     FindDoorAttrByDoorBit
02:000439AE 0C000005        	  6201:     cmpi.b  #$05,D0
02:000439B2 650C            	  6202:     bcs  _anon_z05_125
02:000439B4 1B00            	  6203:     move.b  D0,-(A5)  ; PHA
02:000439B6 7004            	  6204:     moveq   #4,D0
02:000439B8 4EB900030850    	  6205:     jsr     PlaySample
02:000439BE 101D            	  6206:     move.b  (A5)+,D0  ; PLA
                            	  6207: _anon_z05_125:
                            	  6208:     ; Calculate the door face index in three parts.
                            	  6209:     ;
                            	  6210:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6211:     ; (provisional face index in Y register).
                            	  6212:     ;
02:000439C0 0C000004        	  6213:     cmpi.b  #$04,D0
02:000439C4 6602            	  6214:     bne  _anon_z05_126
02:000439C6 7008            	  6215:     moveq   #8,D0
                            	  6216: _anon_z05_126:
02:000439C8 0C000001        	  6217:     cmpi.b  #$01,D0
02:000439CC 6602            	  6218:     bne  _anon_z05_127
02:000439CE 7004            	  6219:     moveq   #4,D0
                            	  6220: _anon_z05_127:
                            	  6221:     ; Second, subtract 3 from provisional face index.
                            	  6222:     ;
02:000439D0 003C0011        	  6223:     ori     #$11,CCR  ; SEC: set C+X
02:000439D4 123C0003        	  6224:     move.b  #$03,D1
02:000439D8 0A3C0010        	  6225:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439DC 9101            	  6226:     subx.b  D1,D0   ; SBC #$03
02:000439DE 0A3C0010        	  6227:     eori    #$10,CCR  ; restore X = 6502 C
02:000439E2 7600            	  6228:     moveq   #0,D3
02:000439E4 1600            	  6229:     move.b  D0,D3
                            	  6230:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6231:     ; face index >= 3, then subtract 1 from it.
                            	  6232:     ;
                            	  6233:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6234:     ; then make it 1.
                            	  6235:     ;
02:000439E6 102C0008        	  6236:     move.b  ($0008,A4),D0
02:000439EA 6708            	  6237:     beq  _anon_z05_128
02:000439EC 0C030005        	  6238:     cmpi.b  #$05,D3
02:000439F0 670A            	  6239:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439F2 7601            	  6240:     moveq   #1,D3
                            	  6241: _anon_z05_128:
02:000439F4 0C030003        	  6242:     cmpi.b  #$03,D3
02:000439F8 6502            	  6243:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439FA 5303            	  6244:     subq.b  #1,D3
                            	  6245:     even
                            	  6246: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6247:     ; The routine that returned the door type also returned its
                            	  6248:     ; reverse direction index in [03].
                            	  6249:     ;
                            	  6250:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6251:     ;
02:000439FC 7003            	  6252:     moveq   #3,D0
02:000439FE 003C0011        	  6253:     ori     #$11,CCR  ; SEC: set C+X
02:00043A02 122C0003        	  6254:     move.b  ($0003,A4),D1
02:00043A06 0A3C0010        	  6255:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A0A 9101            	  6256:     subx.b  D1,D0   ; SBC $03
02:00043A0C 0A3C0010        	  6257:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6258:     ; Call this to put the address of door face tiles in [02:03].
                            	  6259:     ;
02:00043A10 6100FD7A        	  6260:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6261:     ; Return the address of the door in the nametable in [01:00].
                            	  6262:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6263:     ;
02:00043A14 41F9000437EA    	  6264:     lea     (DoorVramAddrsHi).l,A0
02:00043A1A 10302000        	  6265:     move.b  (A0,D2.W),D0
02:00043A1E 1880            	  6266:     move.b  D0,($0000,A4)
02:00043A20 41F9000437EE    	  6267:     lea     (DoorVramAddrsLo).l,A0
02:00043A26 10302000        	  6268:     move.b  (A0,D2.W),D0
02:00043A2A 19400001        	  6269:     move.b  D0,($0001,A4)
                            	  6270:     ; Return the direction of the door in [09], and the dynamic
                            	  6271:     ; transfer buf length in X register.
                            	  6272:     ;
02:00043A2E 19420009        	  6273:     move.b  D2,($0009,A4)
02:00043A32 7400            	  6274:     moveq   #0,D2
02:00043A34 142C0301        	  6275:     move.b  ($0301,A4),D2
                            	  6276:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6277:     ;
02:00043A38 7000            	  6278:     moveq   #0,D0
02:00043A3A 19400007        	  6279:     move.b  D0,($0007,A4)
02:00043A3E 7002            	  6280:     moveq   #2,D0
02:00043A40 19400006        	  6281:     move.b  D0,($0006,A4)
02:00043A44 19400005        	  6282:     move.b  D0,($0005,A4)
02:00043A48 0A3C0001        	  6283:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043A4C 4E75            	  6284:     rts
                            	  6285: 
