                            	  7284: Dodongo_TryEatBomb:
                            	  7285:     ; Try to eat the bomb.
                            	  7286:     ;
                            	  7287:     ; If the bomb is not in range of the monster, then return.
                            	  7288:     ;
                            	  7289:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7290:     ;
02:0003CB7E 7601            	  7291:     moveq   #1,D3
02:0003CB80 616E            	  7292:     jsr     Dodongo_IsBombInRange
02:0003CB82 6666            	  7293:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7294:     ; Will loop from 1 to 0, indexed by [00].
                            	  7295:     ;
02:0003CB84 7001            	  7296:     moveq   #1,D0
02:0003CB86 1880            	  7297:     move.b  D0,($0000,A4)
                            	  7298:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7299:     ;
02:0003CB88 41EC0098        	  7300:     lea     ($0098,A4),A0
02:0003CB8C 10302000        	  7301:     move.b  (A0,D2.W),D0
02:0003CB90 E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0003CB92 7600            	  7303:     moveq   #0,D3
02:0003CB94 1600            	  7304:     move.b  D0,D3
                            	  7305:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7306:     ; position depends on the orientation of the monster.
                            	  7307:     ;
                            	  7308:     ; Start with the horizontal distance.
                            	  7309:     ;
02:0003CB96 102C0004        	  7310:     move.b  ($0004,A4),D0
                            	  7311:     even
                            	  7312: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7313:     ; Look up the limits for the given direction.
                            	  7314:     ;
                            	  7315:     ; If the distance from the bomb < negative limit,
                            	  7316:     ; or >= positive limit, then return.
                            	  7317:     ;
                            	  7318:     ; Note that these are simple signed comparisons that work,
                            	  7319:     ; because the operands are in a small range.
                            	  7320:     ;
02:0003CB9A 41F90003CAD4    	  7321:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CBA0 12303000        	  7322:     move.b  (A0,D3.W),D1
02:0003CBA4 B001            	  7323:     cmp.b   D1,D0
02:0003CBA6 6B42            	  7324:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CBA8 41F90003CADA    	  7325:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CBAE 12303000        	  7326:     move.b  (A0,D3.W),D1
02:0003CBB2 B001            	  7327:     cmp.b   D1,D0
02:0003CBB4 6A34            	  7328:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7329:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7330:     ;
02:0003CBB6 1003            	  7331:     move.b  D3,D0
02:0003CBB8 023C00EE        	  7332:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBBC 123C000A        	  7333:     move.b  #$0A,D1
02:0003CBC0 D101            	  7334:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CBC2 7600            	  7335:     moveq   #0,D3
02:0003CBC4 1600            	  7336:     move.b  D0,D3
                            	  7337:     ; Bottom of the loop.
                            	  7338:     ;
                            	  7339:     ; Load the vertical distance for the next iteration.
                            	  7340:     ; Decrement loop counter.
                            	  7341:     ;
02:0003CBC6 102C0005        	  7342:     move.b  ($0005,A4),D0
02:0003CBCA 5314            	  7343:     subq.b  #1,($0000,A4)
02:0003CBCC 6ACC            	  7344:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7345:     ; If we get here, then the bomb was within range of the mouth.
                            	  7346:     ; Go to state 1 (bloated).
                            	  7347:     ;
02:0003CBCE 41EC00AC        	  7348:     lea     ($00AC,A4),A0
02:0003CBD2 52302000        	  7349:     addq.b  #1,(A0,D2.W)
                            	  7350:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7351:     ;
02:0003CBD6 7610            	  7352:     moveq   #16,D3
02:0003CBD8 7000            	  7353:     moveq   #0,D0
02:0003CBDA 41EC00AC        	  7354:     lea     ($00AC,A4),A0
02:0003CBDE 11803000        	  7355:     move.b  D0,(A0,D3.W)
02:0003CBE2 41EC042C        	  7356:     lea     ($042C,A4),A0
02:0003CBE6 11802000        	  7357:     move.b  D0,(A0,D2.W)
                            	  7358:     even
