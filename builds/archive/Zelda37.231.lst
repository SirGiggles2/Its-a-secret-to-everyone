02:0003CB30 7610            	  7241:     moveq   #16,D3
02:0003CB32 10343070        	  7242:     move.b  ($70,A4,D3.W),D0
02:0003CB36 123C0008        	  7243:     move.b  #$08,D1
02:0003CB3A D101            	  7244:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB3C 19400002        	  7245:     move.b  D0,($0002,A4)
                            	  7246:     ; Store the bomb's (Y + 8) in [03].
