02:0003CC5D 40
02:0003CC5E 00
02:0003CC5F FF
02:0003CC60 00
02:0003CC61 00
02:0003CC62 40
02:0003CC63 40
02:0003CC64 FF              	  7457:     dc.b    $FF, $40
02:0003CC65 40
