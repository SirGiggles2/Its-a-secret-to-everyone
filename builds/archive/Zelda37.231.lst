02:0003F45A 6100009C        	 12868:     jsr     Ganon_GetCurCloudTop
02:0003F45E 6100FF7E        	 12869:     jsr     Ganon_DrawCloud
02:0003F462 6100009A        	 12870:     jsr     Ganon_GetCurCloudBottom
02:0003F466 6100FF76        	 12871:     jsr     Ganon_DrawCloud
                            	 12872:     ; Draw the left and right clouds.
                            	 12873:     ;
02:0003F46A 61000080        	 12874:     jsr     Ganon_GetCurCloudLeft
02:0003F46E 41EC0084        	 12875:     lea     ($0084,A4),A0
02:0003F472 10302000        	 12876:     move.b  (A0,D2.W),D0
02:0003F476 19400001        	 12877:     move.b  D0,($0001,A4)
02:0003F47A 6100FF62        	 12878:     jsr     Ganon_DrawCloud
02:0003F47E 6172            	 12879:     jsr     Ganon_GetCurCloudRight
02:0003F480 6100FF5C        	 12880:     jsr     Ganon_DrawCloud
                            	 12881:     ; Save the object index.
                            	 12882:     ;
02:0003F484 102C0340        	 12883:     move.b  ($0340,A4),D0
02:0003F488 1B00            	 12884:     move.b  D0,-(A5)  ; PHA
                            	 12885:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12886:     ;
02:0003F48A 7402            	 12887:     moveq   #2,D2
                            	 12888:     even
                            	 12889: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F48C 19420340        	 12890:     move.b  D2,($0340,A4)
                            	 12891:     ; If object slot < 5 or = 7, then move every frame.
                            	 12892:     ; Else move 3 out of every 4 frames.
                            	 12893:     ;
                            	 12894:     ; This makes pieces spread out in somewhat of a circle,
                            	 12895:     ; by making the pieces at cardinal directions move at
                            	 12896:     ; full speed while the diagonal ones move a little slower.
                            	 12897:     ;
02:0003F490 0C020005        	 12898:     cmpi.b  #$05,D2
02:0003F494 6510            	 12899:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F496 0C020007        	 12900:     cmpi.b  #$07,D2
02:0003F49A 670A            	 12901:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F49C 102C0015        	 12902:     move.b  ($0015,A4),D0
02:0003F4A0 02000003        	 12903:     andi.b #$03,D0
02:0003F4A4 6704            	 12904:     beq  _anon_z04_164
                            	 12905:     even
                            	 12906: _L_z04_Ganon_DrawBurst_Move:
02:0003F4A6 6100DFD6        	 12907:     jsr     BlueWizzrobe_Move
                            	 12908: _anon_z04_164:
02:0003F4AA 4EB90004CDB8    	 12909:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12910:     ; The frame counter will make the sprite flash.
                            	 12911:     ; The array has the horizontal and vertical flipping attributes.
                            	 12912:     ; Combine them into [03].
                            	 12913:     ;
02:0003F4B0 102C0015        	 12914:     move.b  ($0015,A4),D0
02:0003F4B4 02000003        	 12915:     andi.b #$03,D0
02:0003F4B8 41F90003F388    	 12916:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F4BE 12302000        	 12917:     move.b  (A0,D2.W),D1
02:0003F4C2 8001            	 12918:     or.b  D1,D0
02:0003F4C4 19400003        	 12919:     move.b  D0,($0003,A4)
02:0003F4C8 41F90003F392    	 12920:     lea     (GanonBurstTiles).l,A0
02:0003F4CE 10302000        	 12921:     move.b  (A0,D2.W),D0
02:0003F4D2 4EB900031B34    	 12922:     jsr     Anim_WriteSprite
                            	 12923:     ; Bottom of the loop.
                            	 12924:     ; Increment object slot while <= 9.
                            	 12925:     ;
02:0003F4D8 5202            	 12926:     addq.b  #1,D2
02:0003F4DA 0C02000A        	 12927:     cmpi.b  #$0A,D2
02:0003F4DE 65AC            	 12928:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12929:     ; Restore the object index.
                            	 12930:     ;
02:0003F4E0 101D            	 12931:     move.b  (A5)+,D0  ; PLA
02:0003F4E2 19400340        	 12932:     move.b  D0,($0340,A4)
02:0003F4E6 0A3C0001        	 12933:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F4EA 4E75            	 12934:     rts
                            	 12935: 
                            	 12936: ; Returns:
                            	 12937: ; [00]: X coordinate
                            	 12938: ;
                            	 12939:     even
