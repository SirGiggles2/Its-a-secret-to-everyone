                            	  9492:     ; Check collisions, but never let them interfere with movement.
                            	  9493:     ;
02:0003DBBA 41EC0098        	  9494:     lea     ($0098,A4),A0
02:0003DBBE 10302000        	  9495:     move.b  (A0,D2.W),D0
02:0003DBC2 1B00            	  9496:     move.b  D0,-(A5)  ; PHA
02:0003DBC4 10342028        	  9497:     move.b  ($28,A4,D2.W),D0
02:0003DBC8 1B00            	  9498:     move.b  D0,-(A5)  ; PHA
02:0003DBCA 4EB900031BB4    	  9499:     jsr     CheckMonsterCollisions
02:0003DBD0 101D            	  9500:     move.b  (A5)+,D0  ; PLA
02:0003DBD2 19802028        	  9501:     move.b  D0,($28,A4,D2.W)
02:0003DBD6 101D            	  9502:     move.b  (A5)+,D0  ; PLA
02:0003DBD8 41EC0098        	  9503:     lea     ($0098,A4),A0
02:0003DBDC 11802000        	  9504:     move.b  D0,(A0,D2.W)
                            	  9505:     ; Don't let the base segment be temporarily invincible.
                            	  9506:     ;
02:0003DBE0 0C020005        	  9507:     cmpi.b  #$05,D2
02:0003DBE4 660A            	  9508:     bne  _anon_z04_112
02:0003DBE6 7000            	  9509:     moveq   #0,D0
02:0003DBE8 41EC04F0        	  9510:     lea     ($04F0,A4),A0
02:0003DBEC 11802000        	  9511:     move.b  D0,(A0,D2.W)
                            	  9512: _anon_z04_112:
02:0003DBF0 6100BC8C        	  9513:     jsr     PlayBossHitCryIfNeeded
                            	  9514:     ; If still alive, then return.
                            	  9515:     ;
02:0003DBF4 41EC0405        	  9516:     lea     ($0405,A4),A0
02:0003DBF8 10302000        	  9517:     move.b  (A0,D2.W),D0
02:0003DBFC 674E            	  9518:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DBFE 4EB90004B73C    	  9519:     jsr     ResetShoveInfo
                            	  9520:     ; Don't let the base die on its own.
                            	  9521:     ; If this is the base, then reset metastate, and return.
                            	  9522:     ;
                            	  9523:     ; The base only dies once the last hand dies.
                            	  9524:     ;
02:0003DC04 0C020005        	  9525:     cmpi.b  #$05,D2
02:0003DC08 660A            	  9526:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC0A 41EC0405        	  9527:     lea     ($0405,A4),A0
02:0003DC0E 11802000        	  9528:     move.b  D0,(A0,D2.W)
02:0003DC12 6038            	  9529:     jmp     _L_z04_Manhandla_CheckCollisions_Exit
                            	  9530: 
                            	  9531:     even
                            	  9532: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9533:     ; At this point, we have a hand that just died.
                            	  9534:     ;
                            	  9535:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9536:     ;
02:0003DC14 7603            	  9537:     moveq   #3,D3
                            	  9538:     ; Count how many are allocated.
                            	  9539:     ; This includes the current dead one, and the other living ones.
                            	  9540:     ; Store the count in [00].
                            	  9541:     ;
02:0003DC16 7000            	  9542:     moveq   #0,D0
02:0003DC18 1880            	  9543:     move.b  D0,($0000,A4)
                            	  9544:     even
                            	  9545: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003DC1A 41EC0350        	  9546:     lea     ($0350,A4),A0
02:0003DC1E 10303000        	  9547:     move.b  (A0,D3.W),D0
02:0003DC22 0C00003C        	  9548:     cmpi.b  #$3C,D0
02:0003DC26 6602            	  9549:     bne  _anon_z04_113
02:0003DC28 5214            	  9550:     addq.b  #1,($0000,A4)
                            	  9551: _anon_z04_113:
02:0003DC2A 5303            	  9552:     subq.b  #1,D3
02:0003DC2C 6AEC            	  9553:     bpl  _L_z04_Manhandla_CheckCollisions_LoopHand
                            	  9554:     ; Decrease by 1, to account for the current dead one.
                            	  9555:     ;
02:0003DC2E 5314            	  9556:     subq.b  #1,($0000,A4)
                            	  9557:     ; If the count >= 0 (signed comparison), then
                            	  9558:     ; go change this hand object to the dead dummy.
                            	  9559:     ;
02:0003DC30 6B02            	  9560:     bmi  _anon_z04_114
02:0003DC32 661A            	  9561:     bne  _L_z04_Manhandla_CheckCollisions_MakeDeadDummy
                            	  9562: _anon_z04_114:
                            	  9563:     ; The last hand died. So, kill the base.
                            	  9564:     ;
                            	  9565:     ; Change the base segment's object type to the dead dummy.
                            	  9566:     ; Immediately set metastate to $10, instead of waiting for
                            	  9567:     ; the dead dummy object's update routine to do it.
                            	  9568:     ; Also set its timer to $10.
                            	  9569:     ;
02:0003DC34 61001AE6        	  9570:     jsr     PlayBossDeathCry
02:0003DC38 705D            	  9571:     moveq   #93,D0
02:0003DC3A 19400354        	  9572:     move.b  D0,($0354,A4)
02:0003DC3E 7010            	  9573:     moveq   #16,D0
02:0003DC40 1940040A        	  9574:     move.b  D0,($040A,A4)
02:0003DC44 1940002D        	  9575:     move.b  D0,($002D,A4)
                            	  9576:     even
