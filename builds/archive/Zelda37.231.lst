                            	  8378: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8379:     ; Timer:
                            	  8380:     ;   >= $10: Turn if needed and move every other frame
                            	  8381:     ;   > 1:    Do nothing
                            	  8382:     ;   = 1:    Choose a place to teleport to.
                            	  8383:     ;
