                            	  2695: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2696:     ; Set state 1 to jump.
                            	  2697:     ;
02:0003AA00 41EC00AC        	  2698:     lea     ($00AC,A4),A0
02:0003AA04 52302000        	  2699:     addq.b  #1,(A0,D2.W)
                            	  2700:     even
                            	  2701: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2702:     ; If reversal count >= 2, then
                            	  2703:     ; 1. invert the horizontal component of facing direction,
                            	  2704:     ;    to face away from the chase target
                            	  2705:     ; 2. reset the reversal count to 0.
                            	  2706:     ;
                            	  2707:     ; This prevents a jumper from getting stuck in a corner.
                            	  2708:     ;
                            	  2709:     ; For example, if a tektite's direction is down and right,
                            	  2710:     ; and jumps into the top right corner of the room:
                            	  2711:     ; 1. The right room boundary is hit. So the direction is
                            	  2712:     ;    automatically reversed to up and left.
                            	  2713:     ; 2. The next frame, the top room boundary is hit.
                            	  2714:     ;    The direction is reversed to down and right.
                            	  2715:     ;
                            	  2716:     ; As you can see, an endless loop has been made.
                            	  2717:     ;
02:0003AA08 41EC0451        	  2718:     lea     ($0451,A4),A0
02:0003AA0C 10302000        	  2719:     move.b  (A0,D2.W),D0
02:0003AA10 0C000002        	  2720:     cmpi.b  #$02,D0
02:0003AA14 651E            	  2721:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003AA16 41EC0098        	  2722:     lea     ($0098,A4),A0
02:0003AA1A 10302000        	  2723:     move.b  (A0,D2.W),D0
02:0003AA1E 0A000003        	  2724:     eori.b #$03,D0
02:0003AA22 41EC0098        	  2725:     lea     ($0098,A4),A0
02:0003AA26 11802000        	  2726:     move.b  D0,(A0,D2.W)
02:0003AA2A 7000            	  2727:     moveq   #0,D0
02:0003AA2C 41EC0451        	  2728:     lea     ($0451,A4),A0
02:0003AA30 11802000        	  2729:     move.b  D0,(A0,D2.W)
                            	  2730:     even
                            	  2731: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2732:     ; If the object is a boulder, then make sure its facing direction
                            	  2733:     ; has a down vertical component.
                            	  2734:     ;
02:0003AA34 610001F8        	  2735:     jsr     Jumper_PointBoulderDownward
                            	  2736:     ; For the given direction, get the Y offset of the destination
                            	  2737:     ; of the jump.
                            	  2738:     ;
                            	  2739:     ; Add it to the object's Y, and store this destination Y.
                            	  2740:     ;
02:0003AA38 7600            	  2741:     moveq   #0,D3
02:0003AA3A 41EC0098        	  2742:     lea     ($0098,A4),A0
02:0003AA3E 16302000        	  2743:     move.b  (A0,D2.W),D3
02:0003AA42 41EC0084        	  2744:     lea     ($0084,A4),A0
02:0003AA46 10302000        	  2745:     move.b  (A0,D2.W),D0
02:0003AA4A 023C00EE        	  2746:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA4E 41F90003A966    	  2747:     lea     (JumperYOffsets).l,A0
02:0003AA54 12303000        	  2748:     move.b  (A0,D3.W),D1
02:0003AA58 D101            	  2749:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003AA5A 41EC0444        	  2750:     lea     ($0444,A4),A0
02:0003AA5E 11802000        	  2751:     move.b  D0,(A0,D2.W)
                            	  2752:     ; Set the starting speed, depending on the object type.
                            	  2753:     ;
02:0003AA62 610001A0        	  2754:     jsr     Jumper_GetKind
02:0003AA66 41F90003A990    	  2755:     lea     (JumperStartSpeedsHi).l,A0
02:0003AA6C 10303000        	  2756:     move.b  (A0,D3.W),D0
02:0003AA70 41EC0412        	  2757:     lea     ($0412,A4),A0
02:0003AA74 11802000        	  2758:     move.b  D0,(A0,D2.W)
                            	  2759:     ; Reset the vertical speed low byte.
                            	  2760:     ; Then go animate, draw, and check collisions.
                            	  2761:     ;
02:0003AA78 6100022E        	  2762:     jsr     Jumper_ResetVSpeedFrac
                            	  2763:     even
