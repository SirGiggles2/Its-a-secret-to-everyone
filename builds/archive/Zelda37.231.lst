                            	  5767:     ; might be less than $20.
                            	  5768:     ;
02:0003C08A 7020            	  5769:     moveq   #32,D0
02:0003C08C 41EC0485        	  5770:     lea     ($0485,A4),A0
02:0003C090 11802000        	  5771:     move.b  D0,(A0,D2.W)
02:0003C094 6100062A        	  5772:     jsr     CheckBossHitReaction
                            	  5773:     ; Look for the tail segment, starting from the low end
                            	  5774:     ; of the chain that this dead segment belongs to.
                            	  5775:     ;
