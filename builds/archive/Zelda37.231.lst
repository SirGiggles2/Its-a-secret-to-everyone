                            	  9599: Manhandla_Move:
                            	  9600:     ; Implement a way of manifesting the fractional part of the speed
                            	  9601:     ; in the movement.
                            	  9602:     ;
                            	  9603:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9604:     ; byte to add to the coordinates, then the effective speed would
                            	  9605:     ; be 1 pixel a frame instead of 1.25.
                            	  9606:     ;
                            	  9607:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9608:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9609:     ;
                            	  9610:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9611:     ;
                            	  9612:     ;   SA := SA + (SL AND $E0)
                            	  9613:     ;   [03] := SH + carry
                            	  9614:     ;
                            	  9615:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9616:     ;
02:0003DC60 41EC041F        	  9617:     lea     ($041F,A4),A0
02:0003DC64 10302000        	  9618:     move.b  (A0,D2.W),D0
02:0003DC68 020000E0        	  9619:     andi.b #$E0,D0
02:0003DC6C 023C00EE        	  9620:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC70 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003DC74 12302000        	  9622:     move.b  (A0,D2.W),D1
02:0003DC78 D101            	  9623:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC7A 41EC0412        	  9624:     lea     ($0412,A4),A0
02:0003DC7E 11802000        	  9625:     move.b  D0,(A0,D2.W)
                            	  9626:     ; Assign (high speed byte + carry) to [03].
                            	  9627:     ;
02:0003DC82 41EC042C        	  9628:     lea     ($042C,A4),A0
02:0003DC86 10302000        	  9629:     move.b  (A0,D2.W),D0
02:0003DC8A 123C0000        	  9630:     move.b  #$00,D1
02:0003DC8E D101            	  9631:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DC90 19400003        	  9632:     move.b  D0,($0003,A4)
                            	  9633:     ; Change coordinates by the speed amount/offset in [03]
                            	  9634:     ; according to the direction.
                            	  9635:     ;
                            	  9636:     ; Start with a mask of $A1 in [02]:
                            	  9637:     ; - low nibble represents the right direction
                            	  9638:     ; - high nibble is used to set or clear carry as we go along
                            	  9639:     ;
02:0003DC94 103C00A1        	  9640:     move.b  #$A1,D0
02:0003DC98 19400002        	  9641:     move.b  D0,($0002,A4)
                            	  9642:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9643:     ;
02:0003DC9C 41EC0098        	  9644:     lea     ($0098,A4),A0
02:0003DCA0 10302000        	  9645:     move.b  (A0,D2.W),D0
02:0003DCA4 122C0002        	  9646:     move.b  ($0002,A4),D1
02:0003DCA8 C200            	  9647:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCAA 6712            	  9648:     beq  _L_z04_Manhandla_Move_Left
02:0003DCAC 10342070        	  9649:     move.b  ($70,A4,D2.W),D0
02:0003DCB0 023C00EE        	  9650:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCB4 122C0003        	  9651:     move.b  ($0003,A4),D1
02:0003DCB8 D101            	  9652:     addx.b  D1,D0   ; ADC $03
02:0003DCBA 19802070        	  9653:     move.b  D0,($70,A4,D2.W)
                            	  9654:     even
                            	  9655: _L_z04_Manhandla_Move_Left:
                            	  9656:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9657:     ;
02:0003DCBE 41EC0098        	  9658:     lea     ($0098,A4),A0
02:0003DCC2 10302000        	  9659:     move.b  (A0,D2.W),D0
02:0003DCC6 122C0002        	  9660:     move.b  ($0002,A4),D1
02:0003DCCA E309            	  9661:     lsl.b  #1,D1   ; ASL $02
02:0003DCCC 19410002        	  9662:     move.b  D1,($0002,A4)
02:0003DCD0 122C0002        	  9663:     move.b  ($0002,A4),D1
02:0003DCD4 C200            	  9664:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCD6 6716            	  9665:     beq  _L_z04_Manhandla_Move_Down
02:0003DCD8 10342070        	  9666:     move.b  ($70,A4,D2.W),D0
02:0003DCDC 122C0003        	  9667:     move.b  ($0003,A4),D1
02:0003DCE0 0A3C0010        	  9668:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DCE4 9101            	  9669:     subx.b  D1,D0   ; SBC $03
02:0003DCE6 0A3C0010        	  9670:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DCEA 19802070        	  9671:     move.b  D0,($70,A4,D2.W)
                            	  9672:     even
                            	  9673: _L_z04_Manhandla_Move_Down:
                            	  9674:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9675:     ;
02:0003DCEE 41EC0098        	  9676:     lea     ($0098,A4),A0
02:0003DCF2 10302000        	  9677:     move.b  (A0,D2.W),D0
02:0003DCF6 122C0002        	  9678:     move.b  ($0002,A4),D1
02:0003DCFA E309            	  9679:     lsl.b  #1,D1   ; ASL $02
02:0003DCFC 19410002        	  9680:     move.b  D1,($0002,A4)
02:0003DD00 122C0002        	  9681:     move.b  ($0002,A4),D1
02:0003DD04 C200            	  9682:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD06 6716            	  9683:     beq  _L_z04_Manhandla_Move_Up
02:0003DD08 41EC0084        	  9684:     lea     ($0084,A4),A0
02:0003DD0C 10302000        	  9685:     move.b  (A0,D2.W),D0
02:0003DD10 122C0003        	  9686:     move.b  ($0003,A4),D1
02:0003DD14 D101            	  9687:     addx.b  D1,D0   ; ADC $03
02:0003DD16 41EC0084        	  9688:     lea     ($0084,A4),A0
02:0003DD1A 11802000        	  9689:     move.b  D0,(A0,D2.W)
                            	  9690:     even
                            	  9691: _L_z04_Manhandla_Move_Up:
                            	  9692:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9693:     ;
02:0003DD1E 41EC0098        	  9694:     lea     ($0098,A4),A0
02:0003DD22 10302000        	  9695:     move.b  (A0,D2.W),D0
02:0003DD26 122C0002        	  9696:     move.b  ($0002,A4),D1
02:0003DD2A E309            	  9697:     lsl.b  #1,D1   ; ASL $02
02:0003DD2C 19410002        	  9698:     move.b  D1,($0002,A4)
02:0003DD30 122C0002        	  9699:     move.b  ($0002,A4),D1
02:0003DD34 C200            	  9700:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD36 671E            	  9701:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD38 41EC0084        	  9702:     lea     ($0084,A4),A0
02:0003DD3C 10302000        	  9703:     move.b  (A0,D2.W),D0
02:0003DD40 122C0003        	  9704:     move.b  ($0003,A4),D1
02:0003DD44 0A3C0010        	  9705:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD48 9101            	  9706:     subx.b  D1,D0   ; SBC $03
02:0003DD4A 0A3C0010        	  9707:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD4E 41EC0084        	  9708:     lea     ($0084,A4),A0
02:0003DD52 11802000        	  9709:     move.b  D0,(A0,D2.W)
                            	  9710:     even
                            	  9711: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9712:     ; To the frame accumulator, add:
                            	  9713:     ; - a random value between 0 and 3
                            	  9714:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9715:     ;
02:0003DD56 10342019        	  9716:     move.b  ($19,A4,D2.W),D0
02:0003DD5A 02000003        	  9717:     andi.b #$03,D0
02:0003DD5E 023C00EE        	  9718:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD62 122C0003        	  9719:     move.b  ($0003,A4),D1
02:0003DD66 D101            	  9720:     addx.b  D1,D0   ; ADC $03
02:0003DD68 41EC0451        	  9721:     lea     ($0451,A4),A0
02:0003DD6C 12302000        	  9722:     move.b  (A0,D2.W),D1
02:0003DD70 D101            	  9723:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DD72 41EC0451        	  9724:     lea     ($0451,A4),A0
02:0003DD76 11802000        	  9725:     move.b  D0,(A0,D2.W)
02:0003DD7A 61001E0A        	  9726:     jsr     BoundFlyer
                            	  9727:     ; TODO:
                            	  9728:     ; I don't see why this is needed.
                            	  9729:     ;
02:0003DD7E 4EF90004CDB8    	  9730:     jmp     Anim_FetchObjPosForSpriteDescriptor
