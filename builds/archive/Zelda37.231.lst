02:0003CC67 05
02:0003CC68 07
02:0003CC69 FF
02:0003CC6A 09
02:0003CC6B 04
02:0003CC6C 05
02:0003CC6D 07
02:0003CC6E FF              	  7462:     dc.b    $FF, $09
02:0003CC6F 09
                            	  7463: 
