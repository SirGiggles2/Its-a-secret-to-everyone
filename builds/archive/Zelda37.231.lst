                            	  4736: 
                            	  4737: ; Params:
                            	  4738: ; [02:03]: address of door tiles for direction and face
                            	  4739: ; [04]: count of tiles remaining
                            	  4740: ; [07]: current index (0 to 3) of the tile to copy
                            	  4741: ;       to the dynamic transfer buf
                            	  4742: ; [09]: door direction index
                            	  4743: ;
                            	  4744: ; Returns:
                            	  4745: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4746: ; [04]: original value - 1
                            	  4747: ; [07]: original value + 1
                            	  4748: ;
                            	  4749: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4750: ; vertically. The point of this routine is to access them
                            	  4751: ; horizontally in order to transfer them to a nametable.
                            	  4752: ;
                            	  4753: ;
                            	  4754: ; For the direction index in [09], look up the base offset of the
                            	  4755: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4756: ; the door face tiles at [02:03].
                            	  4757: ;
                            	  4758:     even
                            	  4759: WriteDoorFaceTileHorizontally:
02:000425C2 7600            	  4760:     moveq   #0,D3
02:000425C4 162C0009        	  4761:     move.b  ($0009,A4),D3
02:000425C8 41F9000437E6    	  4762:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000425CE 10303000        	  4763:     move.b  (A0,D3.W),D0
                            	  4764:     ; Add [07] to the base offset we got above. This yields one
                            	  4765:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4766:     ;
02:000425D2 023C00EE        	  4767:     andi    #$EE,CCR  ; CLC: clear C+X
02:000425D6 122C0007        	  4768:     move.b  ($0007,A4),D1
02:000425DA D101            	  4769:     addx.b  D1,D0   ; ADC $07
02:000425DC 7600            	  4770:     moveq   #0,D3
02:000425DE 1600            	  4771:     move.b  D0,D3
                            	  4772:     ; With that index, look up the index to use with the door face
                            	  4773:     ; list of tiles at [02:03].
                            	  4774:     ;
02:000425E0 41F9000437D8    	  4775:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000425E6 10303000        	  4776:     move.b  (A0,D3.W),D0
02:000425EA 7600            	  4777:     moveq   #0,D3
02:000425EC 1600            	  4778:     move.b  D0,D3
                            	  4779:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4780:     ; and copy it to the dynamic transfer buf.
                            	  4781:     ;
02:000425EE 122C0002        	  4782:     move.b  ($02,A4),D1   ; ptr lo
02:000425F2 182C0003        	  4783:     move.b  ($03,A4),D4  ; ptr hi
02:000425F6 024100FF        	  4784:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000425FA E14C            	  4785:     lsl.w   #8,D4
02:000425FC 8841            	  4786:     or.w    D1,D4             ; D4 = NES ptr addr
02:000425FE 48C4            	  4787:     ext.l   D4
02:00042600 D8BC00FF0000    	  4788:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042606 2044            	  4789:     movea.l D4,A0
02:00042608 10303000        	  4790:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004260C 41EC0302        	  4791:     lea     ($0302,A4),A0
02:00042610 11802000        	  4792:     move.b  D0,(A0,D2.W)
                            	  4793:     ; Prepare for the next call:
                            	  4794:     ; - increment dynamic transfer buf pointer
                            	  4795:     ; - increment index of tile to copy [07]
                            	  4796:     ; - decrement count of tiles remaining
                            	  4797:     ;
02:00042614 5202            	  4798:     addq.b  #1,D2
02:00042616 522C0007        	  4799:     addq.b  #1,($0007,A4)
02:0004261A 532C0004        	  4800:     subq.b  #1,($0004,A4)
02:0004261E 4E75            	  4801:     rts
