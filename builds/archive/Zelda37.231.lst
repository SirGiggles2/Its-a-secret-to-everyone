                            	  9998: GohmaLegOffsetsX:
02:0003DF86 F0              	  9999:     dc.b    $F0, $10
02:0003DF87 10
                            	 10000: 
                            	 10001: ; Params:
                            	 10002: ; A: eye frame image
                            	 10003: ;
