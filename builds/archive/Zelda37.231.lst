02:0004C608 41EC00AC        	  5821:     lea     ($00AC,A4),A0
02:0004C60C 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004C610 0C02000D        	  5823:     cmpi.b  #$0D,D2
02:0004C614 6402            	  5824:     bcc.s  __far_z_07_0088
02:0004C616 6032            	  5825:     jmp  CalcBoomerangFrame
