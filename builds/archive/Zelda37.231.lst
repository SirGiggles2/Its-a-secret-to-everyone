                            	  6304: LayoutUWFloor:
02:00043A7E 7005            	  6305:     moveq   #5,D0
02:00043A80 4EB90002A9FA    	  6306:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043A86 61007342        	  6307:     jsr     GetUniqueRoomId
02:00043A8A 1B00            	  6308:     move.b  D0,-(A5)  ; PHA
02:00043A8C 7000            	  6309:     moveq   #0,D0
02:00043A8E 19400002        	  6310:     move.b  D0,($0002,A4)
