                            	  6434:     even
                            	  6435: CheckLinkCollisionPreinit:
                            	  6436:     ; If Link is halted or paralyzed, then return no collision.
                            	  6437:     ;
02:00031D34 102C00AC        	  6438:     move.b  ($00AC,A4),D0
02:00031D38 0C000040        	  6439:     cmpi.b  #$40,D0
02:00031D3C 6604            	  6440:     bne.s  __far_z_01_0058
02:00031D3E 600000EA        	  6441:     jmp  L73A9_Exit
                            	  6442: __far_z_01_0058:
02:00031D42 102C0512        	  6443:     move.b  ($0512,A4),D0
02:00031D46 6704            	  6444:     beq.s  __far_z_01_0059
02:00031D48 600000E0        	  6445:     jmp  L73A9_Exit
                            	  6446: __far_z_01_0059:
                            	  6447:     ; If the object is a monster's shot/projectile, and it's not in a
                            	  6448:     ; state that it can do damage; then return no collision.
