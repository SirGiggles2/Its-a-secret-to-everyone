                            	  7555: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7556:     ; Start preparing sprites.
                            	  7557:     ;
02:0003CCF8 4EB90004CDB8    	  7558:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCFE 1003            	  7559:     move.b  D3,D0
02:0003CD00 1B00            	  7560:     move.b  D0,-(A5)  ; PHA
                            	  7561:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7562:     ;
02:0003CD02 41F90003CC5C    	  7563:     lea     (DodongoFrameHFlips).l,A0
02:0003CD08 10303000        	  7564:     move.b  (A0,D3.W),D0
02:0003CD0C 1940000F        	  7565:     move.b  D0,($000F,A4)
02:0003CD10 41F90003CC52    	  7566:     lea     (DodongoFrameImages).l,A0
02:0003CD16 10303000        	  7567:     move.b  (A0,D3.W),D0
                            	  7568:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7569:     ; They are drawn mirrored.
                            	  7570:     ;
02:0003CD1A 0C000007        	  7571:     cmpi.b  #$07,D0
02:0003CD1E 6706            	  7572:     beq  _anon_z04_92
02:0003CD20 0C000009        	  7573:     cmpi.b  #$09,D0
02:0003CD24 6608            	  7574:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7575: _anon_z04_92:
