02:000418DA 1880            	  2989:     move.b  D0,($0000,A4)
                            	  2990:     ; Call GetOppositeDir again to use this mapping:
                            	  2991:     ; In Dir: 1 2 4 8
                            	  2992:     ;         -------
                            	  2993:     ; Index:  2 3 0 1
                            	  2994:     ;
02:000418DC 4EB900030CE4    	  2995:     jsr     GetOppositeDir
                            	  2996:     ; Get the appropriate coordinate for the direction:
                            	  2997:     ; X for horizontal
                            	  2998:     ; Y for vertical
                            	  2999:     ;
02:000418E2 102C0070        	  3000:     move.b  ($0070,A4),D0
02:000418E6 0C030002        	  3001:     cmpi.b  #$02,D3
02:000418EA 6404            	  3002:     bcc  _anon_z05_74
02:000418EC 102C0084        	  3003:     move.b  ($0084,A4),D0
                            	  3004: _anon_z05_74:
02:000418F0 19400002        	  3005:     move.b  D0,($0002,A4)
                            	  3006:     ; Mask A button and directions if inner border is crossed.
                            	  3007:     ;
02:000418F4 1003            	  3008:     move.b  D3,D0
02:000418F6 1B00            	  3009:     move.b  D0,-(A5)  ; PHA
02:000418F8 023C00EE        	  3010:     andi    #$EE,CCR  ; CLC: clear C+X
02:000418FC 123C0008        	  3011:     move.b  #$08,D1
02:00041900 D101            	  3012:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041902 7600            	  3013:     moveq   #0,D3
02:00041904 1600            	  3014:     move.b  D0,D3
02:00041906 103C0080        	  3015:     move.b  #$80,D0
02:0004190A 6134            	  3016:     jsr     MaskInputInBorder
02:0004190C 101D            	  3017:     move.b  (A5)+,D0  ; PLA
02:0004190E 7600            	  3018:     moveq   #0,D3
02:00041910 1600            	  3019:     move.b  D0,D3
                            	  3020:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3021:     ; boundary using player's direction and reverse direction index.
                            	  3022:     ;
02:00041912 102C0001        	  3023:     move.b  ($0001,A4),D0
02:00041916 0C0000FF        	  3024:     cmpi.b  #$FF,D0
02:0004191A 660C            	  3025:     bne  _anon_z05_75
02:0004191C 102C0098        	  3026:     move.b  ($0098,A4),D0
02:00041920 1880            	  3027:     move.b  D0,($0000,A4)
02:00041922 4EB900030CE4    	  3028:     jsr     GetOppositeDir
                            	  3029: _anon_z05_75:
                            	  3030:     ; If in UW, use the second set of bounds by adding 4
                            	  3031:     ; to reverse direction index.
                            	  3032:     ;
                            	  3033:     ; Else in OW, and use first set that begins at offset 0.
                            	  3034:     ;
02:00041928 102C0010        	  3035:     move.b  ($0010,A4),D0
02:0004192C 6710            	  3036:     beq  _anon_z05_76
02:0004192E 1003            	  3037:     move.b  D3,D0
02:00041930 023C00EE        	  3038:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041934 123C0004        	  3039:     move.b  #$04,D1
02:00041938 D101            	  3040:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004193A 7600            	  3041:     moveq   #0,D3
02:0004193C 1600            	  3042:     move.b  D0,D3
                            	  3043: _anon_z05_76:
                            	  3044:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3045:     ;
02:0004193E 7000            	  3046:     moveq   #0,D0
                            	  3047: ; Params:
                            	  3048: ; A: mask of buttons to block
                            	  3049: ; Y: offset into BorderBounds
                            	  3050: ; [00]: direction
                            	  3051: ; [02]: coordinate
                            	  3052: ;
                            	  3053: ; Returns:
                            	  3054: ; [01]: button mask that was used
                            	  3055: ;       (set to $FF if boundary not crossed)
                            	  3056: ;
                            	  3057:     even
                            	  3058: MaskInputInBorder:
02:00041940 19400001        	  3059:     move.b  D0,($0001,A4)
                            	  3060:     ; If direction is positive (right or down), then go handle it separately.
                            	  3061:     ;
02:00041944 1014            	  3062:     move.b  ($0000,A4),D0
02:00041946 0200000A        	  3063:     andi.b #$0A,D0
02:0004194A 6748            	  3064:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3065:     ; The direction is negative (left or up).
                            	  3066:     ;
                            	  3067:     ; If the coordinate does not cross (<) the boundary, then
                            	  3068:     ; go set mask $FF, so that no button is excluded.
                            	  3069:     ;
02:0004194C 102C0002        	  3070:     move.b  ($0002,A4),D0
02:00041950 41F9000418C4    	  3071:     lea     (BorderBounds).l,A0
02:00041956 12303000        	  3072:     move.b  (A0,D3.W),D1
02:0004195A B001            	  3073:     cmp.b   D1,D0
02:0004195C 6548            	  3074:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3075:     even
