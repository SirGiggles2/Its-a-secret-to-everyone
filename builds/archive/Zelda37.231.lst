                            	  7913:     ; Each cellar can have two destination rooms: A and B.
                            	  7914:     ; Tunnels use both. Treasure rooms only use room A.
                            	  7915:     ;
                            	  7916:     ; If the room that Link came from is the room A of this cellar,
                            	  7917:     ; then look up the X coordinate of the ladder on the left at index 0.
                            	  7918:     ; Else use index 1 to get the X coordinate on the right.
                            	  7919:     ;
