                            	  8051: UpdateLikeLike:
                            	  8052:     ; If the monster captured Link, then go handle it.
                            	  8053:     ;
02:0003D0E8 41EC042C        	  8054:     lea     ($042C,A4),A0
02:0003D0EC 10302000        	  8055:     move.b  (A0,D2.W),D0
02:0003D0F0 6600009A        	  8056:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003D0F4 103C0080        	  8057:     move.b  #$80,D0
02:0003D0F8 6100C844        	  8058:     jsr     UpdateCommonWanderer
                            	  8059:     ; Like-like has a 4 animation frame cycle unlike most monsters
                            	  8060:     ; which have 2.
                            	  8061:     ;
02:0003D0FC 41EC03D0        	  8062:     lea     ($03D0,A4),A0
02:0003D100 53302000        	  8063:     subq.b  #1,(A0,D2.W)
02:0003D104 6624            	  8064:     bne  _L_z04_UpdateLikeLike_Draw
02:0003D106 7008            	  8065:     moveq   #8,D0
02:0003D108 41EC03D0        	  8066:     lea     ($03D0,A4),A0
02:0003D10C 11802000        	  8067:     move.b  D0,(A0,D2.W)
02:0003D110 7600            	  8068:     moveq   #0,D3
02:0003D112 41EC03E4        	  8069:     lea     ($03E4,A4),A0
02:0003D116 16302000        	  8070:     move.b  (A0,D2.W),D3
02:0003D11A 5203            	  8071:     addq.b  #1,D3
02:0003D11C 1003            	  8072:     move.b  D3,D0
02:0003D11E 02000003        	  8073:     andi.b #$03,D0
02:0003D122 41EC03E4        	  8074:     lea     ($03E4,A4),A0
02:0003D126 11802000        	  8075:     move.b  D0,(A0,D2.W)
                            	  8076:     even
                            	  8077: _L_z04_UpdateLikeLike_Draw:
                            	  8078:     ; Draw.
                            	  8079:     ;
02:0003D12A 4EB90004CDB8    	  8080:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D130 41EC03E4        	  8081:     lea     ($03E4,A4),A0
02:0003D134 10302000        	  8082:     move.b  (A0,D2.W),D0
02:0003D138 4EB900031834    	  8083:     jsr     DrawObjectMirrored
                            	  8084:     ; Check collisions. If Link was not captured, then return.
                            	  8085:     ;
02:0003D13E 4EB900031BB4    	  8086:     jsr     CheckMonsterCollisions
02:0003D144 41EC042C        	  8087:     lea     ($042C,A4),A0
02:0003D148 10302000        	  8088:     move.b  (A0,D2.W),D0
02:0003D14C 673C            	  8089:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8090:     ; The monster captured Link.
                            	  8091:     ; Put the monster at the same location as him.
                            	  8092:     ;
02:0003D14E 102C0070        	  8093:     move.b  ($0070,A4),D0
02:0003D152 19802070        	  8094:     move.b  D0,($70,A4,D2.W)
02:0003D156 102C0084        	  8095:     move.b  ($0084,A4),D0
02:0003D15A 41EC0084        	  8096:     lea     ($0084,A4),A0
02:0003D15E 11802000        	  8097:     move.b  D0,(A0,D2.W)
                            	  8098:     ; Reset Link's timer, metastate, and shove info.
                            	  8099:     ;
02:0003D162 7000            	  8100:     moveq   #0,D0
02:0003D164 19400028        	  8101:     move.b  D0,($0028,A4)
02:0003D168 19400405        	  8102:     move.b  D0,($0405,A4)
02:0003D16C 194000C0        	  8103:     move.b  D0,($00C0,A4)
02:0003D170 194000D3        	  8104:     move.b  D0,($00D3,A4)
                            	  8105:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  8106:     ;
02:0003D174 41EC03E4        	  8107:     lea     ($03E4,A4),A0
02:0003D178 11802000        	  8108:     move.b  D0,(A0,D2.W)
02:0003D17C 7004            	  8109:     moveq   #4,D0
02:0003D17E 41EC03D0        	  8110:     lea     ($03D0,A4),A0
02:0003D182 11802000        	  8111:     move.b  D0,(A0,D2.W)
                            	  8112:     ; Now Link can't move.
                            	  8113:     ;
02:0003D186 522C0512        	  8114:     addq.b  #1,($0512,A4)
                            	  8115:     even
