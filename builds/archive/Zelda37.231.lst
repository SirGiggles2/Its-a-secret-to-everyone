02:00030EB8 19802028        	  4563:     move.b  D0,($28,A4,D2.W)
                            	  4564:     ; Start in state $11.
                            	  4565:     ;
02:00030EBC 7011            	  4566:     moveq   #17,D0
                            	  4567: ; Params:
                            	  4568: ; A: initial state
                            	  4569: ; X: object index
                            	  4570: ;
