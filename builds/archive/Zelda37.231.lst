02:00034FD2 0C000077        	  2758:     cmpi.b  #$77,D0
02:00034FD6 660E            	  2759:     bne  _L_z02_ModeEandF_WriteCharBoardCursorSpritePosition_WriteCursorCoords
02:00034FD8 103C00F8        	  2760:     move.b  #$F8,D0
02:00034FDC 19400208        	  2761:     move.b  D0,($0208,A4)
