                            	  5817: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00043702 122C0002        	  5818:     move.b  ($02,A4),D1   ; ptr lo
02:00043706 182C0003        	  5819:     move.b  ($03,A4),D4  ; ptr hi
02:0004370A 024100FF        	  5820:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004370E E14C            	  5821:     lsl.w   #8,D4
02:00043710 8841            	  5822:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043712 48C4            	  5823:     ext.l   D4
