                            	 11682: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EC1A 10342070        	 11683:     move.b  ($70,A4,D2.W),D0
02:0003EC1E 1B00            	 11684:     move.b  D0,-(A5)  ; PHA
                            	 11685:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11686:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11687:     ;
02:0003EC20 023C00EE        	 11688:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EC24 123C0004        	 11689:     move.b  #$04,D1
