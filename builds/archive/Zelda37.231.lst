                            	  8155:     even
                            	  8156: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  8157:     ; In this state, we have to draw Like-like over Link.
                            	  8158:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  8159:     ;
02:0003D1DE 4EB90004CDB8    	  8160:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D1E4 41EC03E4        	  8161:     lea     ($03E4,A4),A0
02:0003D1E8 10302000        	  8162:     move.b  (A0,D2.W),D0
02:0003D1EC 6100CC18        	  8163:     jsr     DrawObjectMirroredOverLink
                            	  8164:     ; Check object collisions.
                            	  8165:     ; If this monster hasn't died, then return.
                            	  8166:     ;
02:0003D1F0 4EB900031BB4    	  8167:     jsr     CheckMonsterCollisions
02:0003D1F6 41EC0405        	  8168:     lea     ($0405,A4),A0
02:0003D1FA 10302000        	  8169:     move.b  (A0,D2.W),D0
02:0003D1FE 678A            	  8170:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8171:     ; But once it has died, then let Link move again.
                            	  8172:     ;
02:0003D200 7000            	  8173:     moveq   #0,D0
02:0003D202 19400512        	  8174:     move.b  D0,($0512,A4)
02:0003D206 6000CBF4        	  8175:     jmp     HideSpritesOverLink
                            	  8176: 
                            	  8177:     even
