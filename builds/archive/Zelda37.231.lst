                            	  3053:     ;
02:000304CE 102C0070        	  3054:     move.b  ($0070,A4),D0
02:000304D2 003C0011        	  3055:     ori     #$11,CCR  ; SEC: set C+X
02:000304D6 12342070        	  3056:     move.b  ($70,A4,D2.W),D1
02:000304DA 0A3C0010        	  3057:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304DE 9101            	  3058:     subx.b  D1,D0   ; SBC ObjX,X
02:000304E0 0A3C0010        	  3059:     eori    #$10,CCR  ; restore X = 6502 C
02:000304E4 61000802        	  3060:     jsr     Abs
02:000304E8 0C00000E        	  3061:     cmpi.b  #$0E,D0
02:000304EC 64DC            	  3062:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3063:     ; Determine the vertical direction toward Link;
