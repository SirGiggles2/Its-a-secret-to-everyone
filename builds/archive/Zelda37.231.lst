                            	  6958: UpdateDodongoState0_Move:
                            	  6959:     ; If facing left, then push X offset 0 on the stack.
                            	  6960:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6961:     ;
                            	  6962:     ; We would like to use one set of coordinates only.
                            	  6963:     ; But movement would break down, if we did; because
                            	  6964:     ; Dodongo is so long.
                            	  6965:     ;
                            	  6966:     ; So, when not facing left, we temporarily shift the
                            	  6967:     ; X coordinate to be closer to the other side of the monster.
                            	  6968:     ;
02:0003C918 7600            	  6969:     moveq   #0,D3
02:0003C91A 41EC0098        	  6970:     lea     ($0098,A4),A0
02:0003C91E 10302000        	  6971:     move.b  (A0,D2.W),D0
02:0003C922 0200000D        	  6972:     andi.b #$0D,D0
02:0003C926 6716            	  6973:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C928 10342070        	  6974:     move.b  ($70,A4,D2.W),D0
02:0003C92C 023C00EE        	  6975:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C930 123C0010        	  6976:     move.b  #$10,D1
02:0003C934 D101            	  6977:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C936 19802070        	  6978:     move.b  D0,($70,A4,D2.W)
02:0003C93A 163C00F0        	  6979:     move.b  #$F0,D3
                            	  6980:     even
                            	  6981: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C93E 1003            	  6982:     move.b  D3,D0
02:0003C940 1B00            	  6983:     move.b  D0,-(A5)  ; PHA
02:0003C942 7020            	  6984:     moveq   #32,D0
02:0003C944 41EC041F        	  6985:     lea     ($041F,A4),A0
02:0003C948 11802000        	  6986:     move.b  D0,(A0,D2.W)
02:0003C94C 6100D02E        	  6987:     jsr     Wanderer_TargetPlayer
                            	  6988:     ; Pop the offset and add it to the X coordinate.
                            	  6989:     ;
                            	  6990:     ; This brings the X coordinate back to the unique value
                            	  6991:     ; that represents the position.
                            	  6992:     ;
02:0003C950 101D            	  6993:     move.b  (A5)+,D0  ; PLA
02:0003C952 023C00EE        	  6994:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C956 12342070        	  6995:     move.b  ($70,A4,D2.W),D1
02:0003C95A D101            	  6996:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C95C 19802070        	  6997:     move.b  D0,($70,A4,D2.W)
                            	  6998:     ; If X coordinate < $20, then face right.
                            	  6999:     ;
02:0003C960 0C000020        	  7000:     cmpi.b  #$20,D0
02:0003C964 640A            	  7001:     bcc  _anon_z04_89
02:0003C966 7001            	  7002:     moveq   #1,D0
02:0003C968 41EC0098        	  7003:     lea     ($0098,A4),A0
02:0003C96C 11802000        	  7004:     move.b  D0,(A0,D2.W)
