02:0003C5D4 122C0002        	  6519:     move.b  ($0002,A4),D1
02:0003C5D8 E309            	  6520:     lsl.b  #1,D1   ; ASL $02
02:0003C5DA 19410002        	  6521:     move.b  D1,($0002,A4)
02:0003C5DE 122C0002        	  6522:     move.b  ($0002,A4),D1
02:0003C5E2 C200            	  6523:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5E4 671E            	  6524:     beq  _L_z04_Digdogger_Move_End
02:0003C5E6 41EC0084        	  6525:     lea     ($0084,A4),A0
02:0003C5EA 10302000        	  6526:     move.b  (A0,D2.W),D0
02:0003C5EE 122C0003        	  6527:     move.b  ($0003,A4),D1
02:0003C5F2 0A3C0010        	  6528:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5F6 9101            	  6529:     subx.b  D1,D0   ; SBC $03
02:0003C5F8 0A3C0010        	  6530:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5FC 41EC0084        	  6531:     lea     ($0084,A4),A0
02:0003C600 11802000        	  6532:     move.b  D0,(A0,D2.W)
