                            	  6131: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6132:     ; The weapon is the sword.
                            	  6133:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6134:     ;
02:0004C86A 023C00EE        	  6135:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C86E 122C0657        	  6136:     move.b  ($0657,A4),D1
02:0004C872 D101            	  6137:     addx.b  D1,D0   ; ADC Items
02:0004C874 003C0011        	  6138:     ori     #$11,CCR  ; SEC: set C+X
02:0004C878 123C0001        	  6139:     move.b  #$01,D1
