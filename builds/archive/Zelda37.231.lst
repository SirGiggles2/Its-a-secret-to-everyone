02:00030D88 4E75            	  4371:     rts
                            	  4372: 
                            	  4373: ; Params:
                            	  4374: ; Y: middle speed index (4)
                            	  4375: ; [03]: horizontal distance
                            	  4376: ; [04]: vertical distance
                            	  4377: ; [0A]: vertical direction
                            	  4378: ; [0B]: horizontal direction
                            	  4379: ;
                            	  4380: ; Returns:
                            	  4381: ; Y: speed index (0 to 8) for the angle
                            	  4382: ;
                            	  4383: ;
                            	  4384: ; TODO: call it speed index or angle?
                            	  4385: ; Store the middle speed index in [00]. It will be changed to the
                            	  4386: ; right speed index to use incrementally.
                            	  4387: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4388: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4389: ;
                            	  4390:     even
                            	  4391: _CalcDiagonalSpeedIndex:
02:00030D8A 1883            	  4392:     move.b  D3,($0000,A4)
                            	  4393:     ; Assuming horizontal distance >= vertical distance, the
                            	  4394:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4395:     ;
02:00030D8C 103C00FF        	  4396:     move.b  #$FF,D0
02:00030D90 19400001        	  4397:     move.b  D0,($0001,A4)
                            	  4398:     ; TODO:
                            	  4399:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4400:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4401:     ;
                            	  4402:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4403:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4404:     ; of the farther distance faster.
                            	  4405:     ;
02:00030D94 102C0003        	  4406:     move.b  ($0003,A4),D0
02:00030D98 122C0004        	  4407:     move.b  ($0004,A4),D1
02:00030D9C B001            	  4408:     cmp.b   D1,D0
02:00030D9E 6416            	  4409:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030DA0 1B00            	  4410:     move.b  D0,-(A5)  ; PHA
02:00030DA2 102C0004        	  4411:     move.b  ($0004,A4),D0
02:00030DA6 19400003        	  4412:     move.b  D0,($0003,A4)
02:00030DAA 101D            	  4413:     move.b  (A5)+,D0  ; PLA
02:00030DAC 19400004        	  4414:     move.b  D0,($0004,A4)
02:00030DB0 7001            	  4415:     moveq   #1,D0
02:00030DB2 19400001        	  4416:     move.b  D0,($0001,A4)
                            	  4417:     even
                            	  4418: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4419:     ; TODO: call it speed index or angle?
                            	  4420:     ; If the difference in distances is within 8 pixels,
                            	  4421:     ; return the speed index (angle) we have.
                            	  4422:     ;
02:00030DB6 102C0003        	  4423:     move.b  ($0003,A4),D0
02:00030DBA 003C0011        	  4424:     ori     #$11,CCR  ; SEC: set C+X
02:00030DBE 122C0004        	  4425:     move.b  ($0004,A4),D1
02:00030DC2 0A3C0010        	  4426:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030DC6 9101            	  4427:     subx.b  D1,D0   ; SBC $04
02:00030DC8 0A3C0010        	  4428:     eori    #$10,CCR  ; restore X = 6502 C
02:00030DCC 0C000008        	  4429:     cmpi.b  #$08,D0
02:00030DD0 6538            	  4430:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4431:     even
                            	  4432: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4433:     ; TODO: call it speed index or angle?
                            	  4434:     ; Otherwise, go to the next speed index (angle).
                            	  4435:     ;
02:00030DD2 1014            	  4436:     move.b  ($0000,A4),D0
02:00030DD4 023C00EE        	  4437:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030DD8 122C0001        	  4438:     move.b  ($0001,A4),D1
02:00030DDC D101            	  4439:     addx.b  D1,D0   ; ADC $01
02:00030DDE 1880            	  4440:     move.b  D0,($0000,A4)
                            	  4441:     ; TODO: call it speed index or angle?
                            	  4442:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4443:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4444:     ;
02:00030DE0 6728            	  4445:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030DE2 0C000008        	  4446:     cmpi.b  #$08,D0
02:00030DE6 6722            	  4447:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4448:     ; Subtract the lesser distance from the greater distance.
                            	  4449:     ; If they still haven't crossed, then we can turn more.
                            	  4450:     ;
02:00030DE8 102C0003        	  4451:     move.b  ($0003,A4),D0
02:00030DEC 003C0011        	  4452:     ori     #$11,CCR  ; SEC: set C+X
02:00030DF0 122C0004        	  4453:     move.b  ($0004,A4),D1
02:00030DF4 0A3C0010        	  4454:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030DF8 9101            	  4455:     subx.b  D1,D0   ; SBC $04
02:00030DFA 0A3C0010        	  4456:     eori    #$10,CCR  ; restore X = 6502 C
02:00030DFE 19400003        	  4457:     move.b  D0,($0003,A4)
02:00030E02 122C0004        	  4458:     move.b  ($0004,A4),D1
02:00030E06 B001            	  4459:     cmp.b   D1,D0
02:00030E08 64C8            	  4460:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4461:     even
                            	  4462: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4463:     ; TODO: call it speed index or angle?
                            	  4464:     ; Return the speed index (angle) we found.
                            	  4465:     ;
02:00030E0A 7600            	  4466:     moveq   #0,D3
02:00030E0C 1614            	  4467:     move.b  ($0000,A4),D3
02:00030E0E 4E75            	  4468:     rts
