                            	  8259:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8260:     ; object direction and input direction to last walkable direction
                            	  8261:     ; found, and set Link's speed.
                            	  8262:     ;
                            	  8263:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8264:     ;
02:00044D50 7400            	  8265:     moveq   #0,D2
02:00044D52 102C000D        	  8266:     move.b  ($000D,A4),D0
