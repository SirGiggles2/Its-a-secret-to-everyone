02:0003C6DC 0200000F        	  6647:     andi.b #$0F,D0
02:0003C6E0 00000007        	  6648:     ori.b #$07,D0
02:0003C6E4 41EC0394        	  6649:     lea     ($0394,A4),A0
02:0003C6E8 11802000        	  6650:     move.b  D0,(A0,D2.W)
