                            	  4116: PondFairy_MoveHearts:
                            	  4117:     ; Loop over each heart from object slot 2 to 9.
                            	  4118:     ;
                            	  4119:     ; Even though they are not standalone objects, their info
                            	  4120:     ; is stored in those object slots.
                            	  4121:     ;
02:0003B3EE 7402            	  4122:     moveq   #2,D2
                            	  4123:     even
                            	  4124: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4125:     ; If the current heart's state <> 0, then go move it.
                            	  4126:     ; Else we have to wait for it to come out at the right time.
                            	  4127:     ;
02:0003B3F0 41EC00AC        	  4128:     lea     ($00AC,A4),A0
02:0003B3F4 10302000        	  4129:     move.b  (A0,D2.W),D0
02:0003B3F8 667C            	  4130:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4131:     ; The current heart's state = 0.
                            	  4132:     ;
                            	  4133:     ; If object slot = 2, then go make it appear. This is the first
                            	  4134:     ; heart to show up.
                            	  4135:     ;
02:0003B3FA 0C020002        	  4136:     cmpi.b  #$02,D2
02:0003B3FE 6732            	  4137:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4138:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4139:     ; go start over.
                            	  4140:     ;
                            	  4141:     ; TODO:
                            	  4142:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4143:     ;
02:0003B400 102C00AE        	  4144:     move.b  ($00AE,A4),D0
02:0003B404 67EA            	  4145:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4146:     ; Look up the starting angle of this heart with the index
                            	  4147:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4148:     ; then loop again.
                            	  4149:     ;
02:0003B406 1002            	  4150:     move.b  D2,D0
02:0003B408 003C0011        	  4151:     ori     #$11,CCR  ; SEC: set C+X
02:0003B40C 123C0003        	  4152:     move.b  #$03,D1
02:0003B410 0A3C0010        	  4153:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B414 9101            	  4154:     subx.b  D1,D0   ; SBC #$03
02:0003B416 0A3C0010        	  4155:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B41A 7600            	  4156:     moveq   #0,D3
02:0003B41C 1600            	  4157:     move.b  D0,D3
02:0003B41E 102C0396        	  4158:     move.b  ($0396,A4),D0
02:0003B422 41F90003B3E6    	  4159:     lea     (PondHeartStartAngles).l,A0
02:0003B428 12303000        	  4160:     move.b  (A0,D3.W),D1
02:0003B42C B001            	  4161:     cmp.b   D1,D0
02:0003B42E 66000086        	  4162:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4163:     even
                            	  4164: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  4165:     ; Set up this heart. Set its state to 1.
                            	  4166:     ;
