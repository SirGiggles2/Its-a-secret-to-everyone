                            	  5639:     even
                            	  5640: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5641:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5642:     ; the mask of opened doors, because this is not a true door.
                            	  5643:     ;
02:0004361C 1B00            	  5644:     move.b  D0,-(A5)  ; PHA
02:0004361E 102C0002        	  5645:     move.b  ($0002,A4),D0
02:00043622 4600            	  5646:     eori.b #$FF,D0
02:00043624 122C00EE        	  5647:     move.b  ($00EE,A4),D1
02:00043628 C001            	  5648:     and.b  D1,D0
02:0004362A 194000EE        	  5649:     move.b  D0,($00EE,A4)
02:0004362E 101D            	  5650:     move.b  (A5)+,D0  ; PLA
                            	  5651:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5652:     ;
02:00043630 0C000001        	  5653:     cmpi.b  #$01,D0
02:00043634 6402            	  5654:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043636 7004            	  5655:     moveq   #4,D0
                            	  5656:     even
                            	  5657: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5658:     ; The door attribute (DA) has been mapped to a
                            	  5659:     ; provisional door face value (PF) in %A as follows:
                            	  5660:     ;
                            	  5661:     ; DA PF Meaning
                            	  5662:     ; -------------
                            	  5663:     ; 0  4  open
                            	  5664:     ; 1  1  wall
                            	  5665:     ; 2  2  false wall
                            	  5666:     ; 3  3  false wall 2
                            	  5667:     ; 4  8  bombable
                            	  5668:     ; 5  5  key
                            	  5669:     ; 6  6  key 2
                            	  5670:     ; 7  7  shutter
                            	  5671:     ;
                            	  5672:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5673:     ; has been cleared, if the type was "open" or any wall.
                            	  5674:     ;
                            	  5675:     ;
                            	  5676:     ; Save the provisional face.
02:00043638 1B00            	  5677:     move.b  D0,-(A5)  ; PHA
                            	  5678:     ; If the current direction points to a door that has been opened,
                            	  5679:     ; then see if we need to set door flags.
                            	  5680:     ;
02:0004363A 102C00EE        	  5681:     move.b  ($00EE,A4),D0
02:0004363E 122C0002        	  5682:     move.b  ($0002,A4),D1
02:00043642 C001            	  5683:     and.b  D1,D0
02:00043644 7400            	  5684:     moveq   #0,D2
02:00043646 1400            	  5685:     move.b  D0,D2
02:00043648 101D            	  5686:     move.b  (A5)+,D0  ; PLA
02:0004364A 122C0002        	  5687:     move.b  ($0002,A4),D1
02:0004364E B401            	  5688:     cmp.b   D1,D2
02:00043650 6624            	  5689:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5690:     ; The current direction points to a door that has been opened.
                            	  5691:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5692:     ;
                            	  5693:     ;
                            	  5694:     ; Save provisional door face in Y register.
02:00043652 7600            	  5695:     moveq   #0,D3
02:00043654 1600            	  5696:     move.b  D0,D3
02:00043656 101D            	  5697:     move.b  (A5)+,D0  ; PLA
02:00043658 1B00            	  5698:     move.b  D0,-(A5)  ; PHA
02:0004365A 7400            	  5699:     moveq   #0,D2
02:0004365C 1400            	  5700:     move.b  D0,D2
02:0004365E 1003            	  5701:     move.b  D3,D0
                            	  5702:     ; If provisional door face is not for a shutter, then
                            	  5703:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5704:     ;
                            	  5705:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5706:     ;
02:00043660 0C000007        	  5707:     cmpi.b  #$07,D0
02:00043664 670E            	  5708:     beq  _anon_z05_111
02:00043666 1B00            	  5709:     move.b  D0,-(A5)  ; PHA
02:00043668 6100DDFE        	  5710:     jsr     SetDoorFlag
02:0004366C 101D            	  5711:     move.b  (A5)+,D0  ; PLA
                            	  5712:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5713:     ; then go make it 9 (open "bombable").
                            	  5714:     ; Else make it 4 (open "door").
                            	  5715:     ;
02:0004366E 0C000008        	  5716:     cmpi.b  #$08,D0
02:00043672 67A4            	  5717:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5718: _anon_z05_111:
02:00043674 7004            	  5719:     moveq   #4,D0
                            	  5720:     even
                            	  5721: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5722:     ; For opened doors, the provisional door face has become:
                            	  5723:     ;
                            	  5724:     ; DA PF Meaning
                            	  5725:     ; -------------
                            	  5726:     ; 0  4  open
                            	  5727:     ; 1  1  wall
                            	  5728:     ; 2  2  false wall
                            	  5729:     ; 3  3  false wall 2
                            	  5730:     ; 4  9  bombable
                            	  5731:     ; 5  4  key
                            	  5732:     ; 6  4  key 2
                            	  5733:     ; 7  4  shutter
                            	  5734:     ;
                            	  5735:     ;
                            	  5736:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5737:     ;
02:00043676 7400            	  5738:     moveq   #0,D2
02:00043678 142C0006        	  5739:     move.b  ($0006,A4),D2
02:0004367C 6712            	  5740:     beq  _anon_z05_112
02:0004367E 7400            	  5741:     moveq   #0,D2
02:00043680 142C000B        	  5742:     move.b  ($000B,A4),D2
02:00043684 1B00            	  5743:     move.b  D0,-(A5)  ; PHA
02:00043686 6100FCC8        	  5744:     jsr     FindDoorAttrByDoorBit
02:0004368A 61001CB4        	  5745:     jsr     CalcOpenDoorwayMask
02:0004368E 101D            	  5746:     move.b  (A5)+,D0  ; PLA
                            	  5747: _anon_z05_112:
                            	  5748:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5749:     ; because the visible door face is already a wall.
                            	  5750:     ;
02:00043690 0C000004        	  5751:     cmpi.b  #$04,D0
02:00043694 650000DC        	  5752:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5753:     ; For all other provisional face values, calculate:
                            	  5754:     ; door face := provisional face - 3
02:00043698 003C0011        	  5755:     ori     #$11,CCR  ; SEC: set C+X
02:0004369C 123C0003        	  5756:     move.b  #$03,D1
02:000436A0 0A3C0010        	  5757:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000436A4 9101            	  5758:     subx.b  D1,D0   ; SBC #$03
02:000436A6 0A3C0010        	  5759:     eori    #$10,CCR  ; restore X = 6502 C
02:000436AA 7600            	  5760:     moveq   #0,D3
02:000436AC 1600            	  5761:     move.b  D0,D3
                            	  5762:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5763:     ; subtract one.
                            	  5764:     ;
02:000436AE 0C030003        	  5765:     cmpi.b  #$03,D3
02:000436B2 6502            	  5766:     bcs  _anon_z05_113
02:000436B4 5303            	  5767:     subq.b  #1,D3
                            	  5768: _anon_z05_113:
                            	  5769:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5770:     ;
                            	  5771:     ; DT DFC DFO Meaning
                            	  5772:     ; ------------------
                            	  5773:     ; 0  1   1   open
                            	  5774:     ; 4  4   5   bombable
                            	  5775:     ; 5  2   1   key
                            	  5776:     ; 6  2   1   key 2
                            	  5777:     ; 7  3   1   shutter
                            	  5778:     ;
                            	  5779:     ;
                            	  5780:     ; Get the direction index.
02:000436B6 101D            	  5781:     move.b  (A5)+,D0  ; PLA
02:000436B8 1B00            	  5782:     move.b  D0,-(A5)  ; PHA
02:000436BA 610000D0        	  5783:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5784:     ; If handling the second half, then offset to the second half
                            	  5785:     ; of the tiles.
                            	  5786:     ;
02:000436BE 102C0006        	  5787:     move.b  ($0006,A4),D0
02:000436C2 6618            	  5788:     bne  _anon_z05_114
02:000436C4 41F9000435DA    	  5789:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000436CA 10302000        	  5790:     move.b  (A0,D2.W),D0
02:000436CE 4EB90003113A    	  5791:     jsr     AddToInt16At0
02:000436D4 7006            	  5792:     moveq   #6,D0
02:000436D6 4EB900031142    	  5793:     jsr     AddToInt16At2
                            	  5794: _anon_z05_114:
                            	  5795:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5796:     ; Pointers will be incremented instead of Y.
02:000436DC 7600            	  5797:     moveq   #0,D3
02:000436DE 41F9000435DE    	  5798:     lea     (DirIndexToDoorColumnCount).l,A0
02:000436E4 10302000        	  5799:     move.b  (A0,D2.W),D0
02:000436E8 19400005        	  5800:     move.b  D0,($0005,A4)
