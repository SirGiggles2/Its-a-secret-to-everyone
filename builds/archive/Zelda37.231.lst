                            	  5260: 
                            	  5261: ; Params:
                            	  5262: ; [02]: bitmask for target door.
                            	  5263: ;
                            	  5264: ; Returns:
                            	  5265: ; A: door attribute for desired direction in current room.
                            	  5266: ; [01]: same as [02] if found; $10 otherwise
                            	  5267: ; [03]: reverse direction index
                            	  5268: ;
                            	  5269: ; Door bits:
                            	  5270: ; 1: E
                            	  5271: ; 2: W
                            	  5272: ; 4: S
                            	  5273: ; 8: N
                            	  5274: ;
                            	  5275: ;
                            	  5276: ; Start with single-bit mask 1.
                            	  5277:     even
