02:0003E02C 123C0008        	 10099:     move.b  #$08,D1
02:0003E030 D101            	 10100:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E032 19802070        	 10101:     move.b  D0,($70,A4,D2.W)
02:0003E036 532C000F        	 10102:     subq.b  #1,($000F,A4)
