02:0003E000 1B00            	 10077:     move.b  D0,-(A5)  ; PHA
                            	 10078:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10079:     ; on the left side.
                            	 10080:     ;
02:0003E002 003C0011        	 10081:     ori     #$11,CCR  ; SEC: set C+X
02:0003E006 123C0010        	 10082:     move.b  #$10,D1
02:0003E00A 0A3C0010        	 10083:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E00E 9101            	 10084:     subx.b  D1,D0   ; SBC #$10
02:0003E010 0A3C0010        	 10085:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E014 19802070        	 10086:     move.b  D0,($70,A4,D2.W)
                            	 10087:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10088:     ; from left to right, indexed by [0F].
                            	 10089:     ;
02:0003E018 7005            	 10090:     moveq   #5,D0
02:0003E01A 1940000F        	 10091:     move.b  D0,($000F,A4)
