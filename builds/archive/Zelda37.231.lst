02:00043A66 000432AC        	  6294:     dc.l    ColumnHeapUW6
02:00043A6A 000432BE        	  6295:     dc.l    ColumnHeapUW7
02:00043A6E 000432D0        	  6296:     dc.l    ColumnHeapUW8
