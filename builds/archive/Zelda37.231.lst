                            	   797: SwitchToNT1:
                            	   798:     ; When we begin scrolling left, CurHScroll = 0 and base
                            	   799:     ; nametable is 0. This shows the current room completely.
                            	   800:     ;
                            	   801:     ; The first time in ScrollWorld, the speed [00] will be
                            	   802:     ; subtracted from CurHScroll to show most of NT 0, and
                            	   803:     ; a little of NT 1 to its left. In other words, the
                            	   804:     ; scroll position now refers to a position in NT 1.
                            	   805:     ;
                            	   806:     ; [01] is this first position shown in NT 1. So, once
                            	   807:     ; CurHScroll matches it (in the first call to this routine),
                            	   808:     ; turn on this flag that makes NT 1 the base nametable.
02:0004048C 7001            	   809:     moveq   #1,D0
02:0004048E 1940005F        	   810:     move.b  D0,($005F,A4)
                            	   811:     even
