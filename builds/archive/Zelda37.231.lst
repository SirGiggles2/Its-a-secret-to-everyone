                            	  2330: _L_z04__TryShooting_TryShootingNow:
                            	  2331:     ; Summary
                            	  2332:     ;
                            	  2333:     ; if temporarily invincible then
                            	  2334:     ;   shoot timer := 0
                            	  2335:     ; elif shoot timer > 0 then
                            	  2336:     ;   decrement shoot timer
                            	  2337:     ; elif wants to shoot then
                            	  2338:     ;   shoot timer := $30
                            	  2339:     ;
                            	  2340:     ; qspeed := [01]
                            	  2341:     ;
                            	  2342:     ; if shoot timer <> 0 then
                            	  2343:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2344:     ;     shoot
                            	  2345:     ;     if succeeded then
                            	  2346:     ;       shoot timer := 0
                            	  2347:     ;       qspeed := 0
                            	  2348:     ;   else
                            	  2349:     ;     qspeed := 0
                            	  2350:     ;
                            	  2351:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A7D0 102C0001        	  2352:     move.b  ($0001,A4),D0
02:0003A7D4 1883            	  2353:     move.b  D3,($0000,A4)
02:0003A7D6 1B00            	  2354:     move.b  D0,-(A5)  ; PHA
02:0003A7D8 7600            	  2355:     moveq   #0,D3
                            	  2356:     ; If not temporarily invincible,
                            	  2357:     ;
02:0003A7DA 41EC04F0        	  2358:     lea     ($04F0,A4),A0
02:0003A7DE 10302000        	  2359:     move.b  (A0,D2.W),D0
02:0003A7E2 661A            	  2360:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2361:     ; then Y := shoot timer - 1
                            	  2362:     ;
02:0003A7E4 7600            	  2363:     moveq   #0,D3
02:0003A7E6 41EC0451        	  2364:     lea     ($0451,A4),A0
02:0003A7EA 16302000        	  2365:     move.b  (A0,D2.W),D3
02:0003A7EE 5303            	  2366:     subq.b  #1,D3
                            	  2367:     ; If Y register < 0, then shoot timer is 0.
                            	  2368:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2369:     ; Else go set a non-zero speed and return.
                            	  2370:     ;
02:0003A7F0 6A0C            	  2371:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A7F2 41EC0412        	  2372:     lea     ($0412,A4),A0
02:0003A7F6 10302000        	  2373:     move.b  (A0,D2.W),D0
02:0003A7FA 6736            	  2374:     beq  _L_z04__TryShooting_SetSpeed
