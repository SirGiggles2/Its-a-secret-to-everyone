                            	  6570: HarmLink:
02:00031E2C 61000564        	  6571:     jsr     BeginShove
                            	  6572:     ; Flag collision with [0C], even though [06] was already set.
                            	  6573:     ;
02:00031E30 522C000C        	  6574:     addq.b  #1,($000C,A4)
                            	  6575:     ; Unpack the damage points for the monster's type.
                            	  6576:     ; The low nibble is the high byte.
                            	  6577:     ; (Damage points byte AND $F0) is the low byte.
                            	  6578:     ;
02:00031E34 7600            	  6579:     moveq   #0,D3
02:00031E36 41EC034F        	  6580:     lea     ($034F,A4),A0
02:00031E3A 16302000        	  6581:     move.b  (A0,D2.W),D3
02:00031E3E 41F900031CA0    	  6582:     lea     (ObjTypeToDamagePoints).l,A0
02:00031E44 10303000        	  6583:     move.b  (A0,D3.W),D0
02:00031E48 1B00            	  6584:     move.b  D0,-(A5)  ; PHA
02:00031E4A 0200000F        	  6585:     andi.b #$0F,D0
02:00031E4E 1940000D        	  6586:     move.b  D0,($000D,A4)
02:00031E52 101D            	  6587:     move.b  (A5)+,D0  ; PLA
02:00031E54 020000F0        	  6588:     andi.b #$F0,D0
02:00031E58 1940000E        	  6589:     move.b  D0,($000E,A4)
                            	  6590: ; Params:
                            	  6591: ; X: object index of the attacker
                            	  6592: ; [0D]: damage points high byte
                            	  6593: ; [0E]: damage points low byte
                            	  6594: ;
                            	  6595: ;
                            	  6596: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6597: ;
                            	  6598:     even
                            	  6599: Link_BeHarmed:
02:00031E5C 7600            	  6600:     moveq   #0,D3
02:00031E5E 41EC034F        	  6601:     lea     ($034F,A4),A0
02:00031E62 16302000        	  6602:     move.b  (A0,D2.W),D3
02:00031E66 0C03002E        	  6603:     cmpi.b  #$2E,D3
02:00031E6A 6706            	  6604:     beq  _anon_z01_85
02:00031E6C 7008            	  6605:     moveq   #8,D0
02:00031E6E 6100E9E0        	  6606:     jsr     PlaySample
                            	  6607: _anon_z01_85:
                            	  6608:     ; For every level of ring (1 or 2), divide the 16-bit damage amount in [0E:0D] by 2.
                            	  6609:     ;
02:00031E72 7600            	  6610:     moveq   #0,D3
02:00031E74 162C0662        	  6611:     move.b  ($0662,A4),D3
02:00031E78 6718            	  6612:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  6613: _anon_z01_86:
02:00031E7A 122C000D        	  6614:     move.b  ($000D,A4),D1
02:00031E7E E209            	  6615:     lsr.b  #1,D1   ; LSR $0D
02:00031E80 1941000D        	  6616:     move.b  D1,($000D,A4)
02:00031E84 122C000E        	  6617:     move.b  ($000E,A4),D1
02:00031E88 E211            	  6618:     roxr.b  #1,D1   ; ROR $0E
02:00031E8A 1941000E        	  6619:     move.b  D1,($000E,A4)
02:00031E8E 5303            	  6620:     subq.b  #1,D3
02:00031E90 66E8            	  6621:     bne  _anon_z01_86
                            	  6622:     even
                            	  6623: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6624:     ; Reset values used in special item drops.
                            	  6625:     ;
02:00031E92 7000            	  6626:     moveq   #0,D0
02:00031E94 19400627        	  6627:     move.b  D0,($0627,A4)
02:00031E98 19400050        	  6628:     move.b  D0,($0050,A4)
02:00031E9C 19400051        	  6629:     move.b  D0,($0051,A4)
                            	  6630:     ; If heart partial >= low damage points byte, then simply
                            	  6631:     ; subtract the damage byte from heart partial.
                            	  6632:     ; Else go borrow from full hearts.
                            	  6633:     ;
02:00031EA0 102C0670        	  6634:     move.b  ($0670,A4),D0
02:00031EA4 122C000E        	  6635:     move.b  ($000E,A4),D1
02:00031EA8 B001            	  6636:     cmp.b   D1,D0
02:00031EAA 6546            	  6637:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031EAC 003C0011        	  6638:     ori     #$11,CCR  ; SEC: set C+X
02:00031EB0 122C000E        	  6639:     move.b  ($000E,A4),D1
02:00031EB4 0A3C0010        	  6640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031EB8 9101            	  6641:     subx.b  D1,D0   ; SBC $0E
02:00031EBA 0A3C0010        	  6642:     eori    #$10,CCR  ; restore X = 6502 C
02:00031EBE 19400670        	  6643:     move.b  D0,($0670,A4)
                            	  6644:     ; If full hearts >= high damage points byte, then simply
                            	  6645:     ; subtract the damage byte from full hearts.
                            	  6646:     ; Else go handle Link dying.
                            	  6647:     ;
02:00031EC2 102C066F        	  6648:     move.b  ($066F,A4),D0
02:00031EC6 0200000F        	  6649:     andi.b #$0F,D0
02:00031ECA 122C000D        	  6650:     move.b  ($000D,A4),D1
02:00031ECE B001            	  6651:     cmp.b   D1,D0
02:00031ED0 6554            	  6652:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031ED2 102C066F        	  6653:     move.b  ($066F,A4),D0
02:00031ED6 003C0011        	  6654:     ori     #$11,CCR  ; SEC: set C+X
02:00031EDA 122C000D        	  6655:     move.b  ($000D,A4),D1
02:00031EDE 0A3C0010        	  6656:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031EE2 9101            	  6657:     subx.b  D1,D0   ; SBC $0D
02:00031EE4 0A3C0010        	  6658:     eori    #$10,CCR  ; restore X = 6502 C
02:00031EE8 1940066F        	  6659:     move.b  D0,($066F,A4)
02:00031EEC 0A3C0001        	  6660:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031EF0 4E75            	  6661:     rts
                            	  6662: 
                            	  6663:     even
                            	  6664: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6665:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6666:     ;   full heart=4 partial heart=$70
                            	  6667:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6668:     ; But the method here yields $3EF, because partial heart is
                            	  6669:     ; considered full when = $FF instead of $100.
                            	  6670:     ;
02:00031EF2 102C000E        	  6671:     move.b  ($000E,A4),D0
02:00031EF6 003C0011        	  6672:     ori     #$11,CCR  ; SEC: set C+X
02:00031EFA 122C0670        	  6673:     move.b  ($0670,A4),D1
02:00031EFE 0A3C0010        	  6674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031F02 9101            	  6675:     subx.b  D1,D0   ; SBC HeartPartial
02:00031F04 0A3C0010        	  6676:     eori    #$10,CCR  ; restore X = 6502 C
02:00031F08 1940000E        	  6677:     move.b  D0,($000E,A4)
