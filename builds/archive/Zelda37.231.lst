                            	  7393: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7394:     ; Else Link is facing horizontally.
                            	  7395:     ; [04] := (weapon X + 8)
                            	  7396:     ; A    := (weapon Y + 6)
                            	  7397:     ;
                            	  7398:     ; Shouldn't it be based on the weapon's direction?
                            	  7399:     ;
02:0003235E 10343070        	  7400:     move.b  ($70,A4,D3.W),D0
02:00032362 023C00EE        	  7401:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032366 123C0008        	  7402:     move.b  #$08,D1
02:0003236A D101            	  7403:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003236C 19400004        	  7404:     move.b  D0,($0004,A4)
02:00032370 41EC0084        	  7405:     lea     ($0084,A4),A0
02:00032374 10303000        	  7406:     move.b  (A0,D3.W),D0
02:00032378 023C00EE        	  7407:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003237C 123C0006        	  7408:     move.b  #$06,D1
02:00032380 D101            	  7409:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7410: _anon_z01_98:
                            	  7411:     ; The A register will be copied to [05] and used here.
                            	  7412:     ;
02:00032382 6000FC0C        	  7413:     jmp     CheckMonsterWeaponCollision
                            	  7414: 
                            	  7415: ; Params:
                            	  7416: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7417: ; [00]: weapon object slot (unused)
                            	  7418: ; [02]: object 1 mid X
                            	  7419: ; [03]: object 1 mid Y
                            	  7420: ; [04]: object 2 mid X
                            	  7421: ; [05]: object 2 mid Y
                            	  7422: ;
                            	  7423: ; Returns:
                            	  7424: ; A: 1 if objects collide
                            	  7425: ; Y: weapon object slot
                            	  7426: ; Z: 0 if objects collide
                            	  7427: ; [06]: 1 if objects collide
                            	  7428: ; [0A]: horizontal distance
                            	  7429: ; [0B]: vertical distance
                            	  7430: ;
                            	  7431: ;
                            	  7432: ; Use the same threshold value horizontally and vertically.
                            	  7433: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7434: ;
                            	  7435:     even
                            	  7436: DoObjectsCollide:
02:00032386 1940000D        	  7437:     move.b  D0,($000D,A4)
02:0003238A 1940000E        	  7438:     move.b  D0,($000E,A4)
                            	  7439: ; Params:
                            	  7440: ; [00]: weapon or Link object slot (unused)
                            	  7441: ; [02]: object 1 mid X
                            	  7442: ; [03]: object 1 mid Y
                            	  7443: ; [04]: object 2 mid X
                            	  7444: ; [05]: object 2 mid Y
                            	  7445: ; [0D]: horizontal threshold
                            	  7446: ; [0E]: vertical threshold
                            	  7447: ;
                            	  7448: ; Returns:
                            	  7449: ; A: 1 if objects collide
                            	  7450: ; Y: weapon or Link object slot (copied from [00])
                            	  7451: ; Z: 0 if objects collide
                            	  7452: ; [06]: 1 if objects collide
                            	  7453: ; [0A]: horizontal distance
                            	  7454: ; [0B]: vertical distance
                            	  7455: ;
                            	  7456: ;
                            	  7457: ; Reset [06] to indicate no collision by default.
                            	  7458: ;
                            	  7459:     even
                            	  7460: DoObjectsCollideWithThresholds:
02:0003238E 60009D30        	  7461:     jmp     c_do_objects_collide_with_thresholds
                            	  7462: 
                            	  7463: BeginShove:
02:00032392 7600            	  7464:     moveq   #0,D3
02:00032394 1614            	  7465:     move.b  ($0000,A4),D3
02:00032396 0C02000D        	  7466:     cmpi.b  #$0D,D2
02:0003239A 6412            	  7467:     bcc  _anon_z01_99
02:0003239C 41EC04B2        	  7468:     lea     ($04B2,A4),A0
02:000323A0 10302000        	  7469:     move.b  (A0,D2.W),D0
02:000323A4 122C0009        	  7470:     move.b  ($0009,A4),D1
02:000323A8 C001            	  7471:     and.b  D1,D0
02:000323AA 660000C4        	  7472:     bne  _L_z01_BeginShove_Exit
                            	  7473: _anon_z01_99:
                            	  7474:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7475:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7476:     ;
                            	  7477:     ; If instead a monster is defending, then all this calculation
                            	  7478:     ; won't matter, because the shove direction will be set to the
                            	  7479:     ; weapon's direction.
                            	  7480:     ;
                            	  7481:     ; As such, calculate a direction from the monster to the defender,
                            	  7482:     ; assuming it's Link.
                            	  7483:     ;
                            	  7484:     ; Start with an assumption that the direction is vertical:
                            	  7485:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7486:     ;
02:000323AE 7008            	  7487:     moveq   #8,D0
02:000323B0 19400008        	  7488:     move.b  D0,($0008,A4)
02:000323B4 41EC0084        	  7489:     lea     ($0084,A4),A0
02:000323B8 10302000        	  7490:     move.b  (A0,D2.W),D0
02:000323BC 19400004        	  7491:     move.b  D0,($0004,A4)
02:000323C0 41EC0084        	  7492:     lea     ($0084,A4),A0
02:000323C4 10303000        	  7493:     move.b  (A0,D3.W),D0
02:000323C8 19400005        	  7494:     move.b  D0,($0005,A4)
                            	  7495:     ; If the defender is Link and his grid offset <> 0 then
                            	  7496:     ; use his usual object direction variable to determine
                            	  7497:     ; which axis to check.
                            	  7498:     ;
02:000323CC 4A03            	  7499:     cmpi.b  #$00,D3
02:000323CE 6612            	  7500:     bne  _anon_z01_100
02:000323D0 102C0394        	  7501:     move.b  ($0394,A4),D0
02:000323D4 670C            	  7502:     beq  _anon_z01_100
02:000323D6 102C0098        	  7503:     move.b  ($0098,A4),D0
02:000323DA 02000003        	  7504:     andi.b #$03,D0
02:000323DE 660C            	  7505:     bne  _L_z01_BeginShove_CheckHorizontal
02:000323E0 6720            	  7506:     beq  _L_z01_BeginShove_CheckVertical
                            	  7507: _anon_z01_100:
                            	  7508:     ; For monsters defending, or Link with grid offset = 0,
                            	  7509:     ; check direction in [0B].
                            	  7510:     ;
                            	  7511:     ; For monsters defending, this won't matter. For Link with grid
                            	  7512:     ; offset = 0, I believe the result will be arbitrary.
                            	  7513:     ;
                            	  7514:     ; TODO:
                            	  7515:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7516:     ; It doesn't seem to be if candle fire attacks him.
                            	  7517:     ;
02:000323E2 102C000B        	  7518:     move.b  ($000B,A4),D0
02:000323E6 0C000004        	  7519:     cmpi.b  #$04,D0
02:000323EA 6416            	  7520:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7521:     even
                            	  7522: _L_z01_BeginShove_CheckHorizontal:
                            	  7523:     ; If the direction checked is left or right,
                            	  7524:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7525:     ;
02:000323EC 7002            	  7526:     moveq   #2,D0
02:000323EE 19400008        	  7527:     move.b  D0,($0008,A4)
02:000323F2 10342070        	  7528:     move.b  ($70,A4,D2.W),D0
02:000323F6 19400004        	  7529:     move.b  D0,($0004,A4)
02:000323FA 10343070        	  7530:     move.b  ($70,A4,D3.W),D0
02:000323FE 19400005        	  7531:     move.b  D0,($0005,A4)
                            	  7532:     even
                            	  7533: _L_z01_BeginShove_CheckVertical:
                            	  7534:     ; If the monster is down or right of the other object,
                            	  7535:     ; then use the opposite direction already in [08].
                            	  7536:     ; Else shift [08] right to turn it into the opposite
                            	  7537:     ; direction up or down.
                            	  7538:     ;
                            	  7539:     ; Again assuming Link is the defender; after this, [08] points
                            	  7540:     ; Link away from the monster.
                            	  7541:     ;
02:00032402 102C0004        	  7542:     move.b  ($0004,A4),D0
02:00032406 122C0005        	  7543:     move.b  ($0005,A4),D1
02:0003240A B001            	  7544:     cmp.b   D1,D0
02:0003240C 640A            	  7545:     bcc  _anon_z01_101
02:0003240E 122C0008        	  7546:     move.b  ($0008,A4),D1
02:00032412 E209            	  7547:     lsr.b  #1,D1   ; LSR $08
02:00032414 19410008        	  7548:     move.b  D1,($0008,A4)
                            	  7549: _anon_z01_101:
                            	  7550:     ; If a monster is the defender, go handle it separately.
                            	  7551:     ;
02:00032418 4A03            	  7552:     cmpi.b  #$00,D3
02:0003241A 6656            	  7553:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7554:     ; Link is the defender.
                            	  7555:     ;
                            	  7556:     ; If Link is invincible, return without shoving.
                            	  7557:     ;
02:0003241C 102C04F0        	  7558:     move.b  ($04F0,A4),D0
02:00032420 664E            	  7559:     bne  _L_z01_BeginShove_Exit
                            	  7560:     ; Store the shove direction we determined.
                            	  7561:     ;
                            	  7562:     ; Turn on the high bit to indicate that the next time we try to
                            	  7563:     ; move by shoving, it will be the first time for this shove action.
                            	  7564:     ;
02:00032422 102C0008        	  7565:     move.b  ($0008,A4),D0
02:00032426 00000080        	  7566:     ori.b #$80,D0
02:0003242A 194000C0        	  7567:     move.b  D0,($00C0,A4)
                            	  7568:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7569:     ;
02:0003242E 7018            	  7570:     moveq   #24,D0
02:00032430 194004F0        	  7571:     move.b  D0,($04F0,A4)
02:00032434 7020            	  7572:     moveq   #32,D0
02:00032436 194000D3        	  7573:     move.b  D0,($00D3,A4)
                            	  7574:     ; If Link was shoved by one of his own weapons, then
                            	  7575:     ; nothing else to do. Return.
                            	  7576:     ;
02:0003243A 0C02000D        	  7577:     cmpi.b  #$0D,D2
02:0003243E 6430            	  7578:     bcc  _L_z01_BeginShove_Exit
                            	  7579:     ; Link was shoved by a monster.
                            	  7580:     ;
                            	  7581:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7582:     ; then return.
                            	  7583:     ;
02:00032440 41EC04BF        	  7584:     lea     ($04BF,A4),A0
02:00032444 10302000        	  7585:     move.b  (A0,D2.W),D0
02:00032448 02000080        	  7586:     andi.b #$80,D0
02:0003244C 6622            	  7587:     bne  _L_z01_BeginShove_Exit
                            	  7588:     ; If the attacker is a vire, then return.
                            	  7589:     ;
02:0003244E 41EC034F        	  7590:     lea     ($034F,A4),A0
02:00032452 10302000        	  7591:     move.b  (A0,D2.W),D0
02:00032456 0C000012        	  7592:     cmpi.b  #$12,D0
02:0003245A 6714            	  7593:     beq  _L_z01_BeginShove_Exit
                            	  7594:     ; Turn the attacker in the opposite direction.
                            	  7595:     ;
02:0003245C 41EC0098        	  7596:     lea     ($0098,A4),A0
02:00032460 10302000        	  7597:     move.b  (A0,D2.W),D0
02:00032464 6100E87E        	  7598:     jsr     GetOppositeDir
02:00032468 41EC0098        	  7599:     lea     ($0098,A4),A0
02:0003246C 11802000        	  7600:     move.b  D0,(A0,D2.W)
                            	  7601:     even
                            	  7602: _L_z01_BeginShove_Exit:
02:00032470 4E75            	  7603:     rts
                            	  7604: 
                            	  7605:     even
                            	  7606: _L_z01_BeginShove_MonsterDefender:
                            	  7607:     ; A monster is the defender. A weapon is the attacker.
                            	  7608:     ;
                            	  7609:     ; Set the shove direction to the weapon's direction,
                            	  7610:     ; instead of the direction passed in [0B].
                            	  7611:     ;
02:00032472 41EC0098        	  7612:     lea     ($0098,A4),A0
02:00032476 10303000        	  7613:     move.b  (A0,D3.W),D0
02:0003247A 19400008        	  7614:     move.b  D0,($0008,A4)
                            	  7615:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7616:     ; combine the shove direction with $40.
                            	  7617:     ;
                            	  7618:     ; TODO:
                            	  7619:     ; But the shoving routing doesn't read this flag.
                            	  7620:     ;
02:0003247E 41EC04BF        	  7621:     lea     ($04BF,A4),A0
02:00032482 10302000        	  7622:     move.b  (A0,D2.W),D0
02:00032486 02000080        	  7623:     andi.b #$80,D0
02:0003248A 670C            	  7624:     beq  _anon_z01_102
02:0003248C 102C0008        	  7625:     move.b  ($0008,A4),D0
02:00032490 00000040        	  7626:     ori.b #$40,D0
02:00032494 19400008        	  7627:     move.b  D0,($0008,A4)
                            	  7628: _anon_z01_102:
                            	  7629:     ; If the monster is invincible, then return without shoving.
                            	  7630:     ;
02:00032498 41EC04F0        	  7631:     lea     ($04F0,A4),A0
02:0003249C 10302000        	  7632:     move.b  (A0,D2.W),D0
02:000324A0 6656            	  7633:     bne  _L_z01_BeginShove_Exit2
                            	  7634:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7635:     ;
02:000324A2 41EC034F        	  7636:     lea     ($034F,A4),A0
02:000324A6 10302000        	  7637:     move.b  (A0,D2.W),D0
02:000324AA 0C000033        	  7638:     cmpi.b  #$33,D0
02:000324AE 6706            	  7639:     beq  _L_z01_BeginShove_Gohma
02:000324B0 0C000034        	  7640:     cmpi.b  #$34,D0
02:000324B4 661E            	  7641:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7642:     even
                            	  7643: _L_z01_BeginShove_Gohma:
                            	  7644:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7645:     ; then return, so that the hit doesn't register.
                            	  7646:     ;
02:000324B6 102C000F        	  7647:     move.b  ($000F,A4),D0
02:000324BA 0C000003        	  7648:     cmpi.b  #$03,D0
02:000324BE 6706            	  7649:     beq  _anon_z01_103
02:000324C0 0C000004        	  7650:     cmpi.b  #$04,D0
02:000324C4 6632            	  7651:     bne  _L_z01_BeginShove_Exit2
                            	  7652: _anon_z01_103:
                            	  7653:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7654:     ;
02:000324C6 41EC046B        	  7655:     lea     ($046B,A4),A0
02:000324CA 10302000        	  7656:     move.b  (A0,D2.W),D0
02:000324CE 0C000003        	  7657:     cmpi.b  #$03,D0
02:000324D2 6624            	  7658:     bne  _L_z01_BeginShove_Exit2
                            	  7659:     even
