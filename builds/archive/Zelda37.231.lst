                            	  7697: _anon_z05_156:
02:000449D0 101D            	  7698:     move.b  (A5)+,D0  ; PLA
                            	  7699:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7700:     ; then the player walked all the way to the edge of the play
                            	  7701:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7702:     ;
                            	  7703:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7704:     ; edge of the play area. So, set a relative position that
                            	  7705:     ; reflects that distance: $28 or -$28.
                            	  7706:     ;
                            	  7707:     ; If walking in a decreasing direction (left or up), then
                            	  7708:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7709:     ;
                            	  7710:     ; If walking in an increasing direction (right or down), then
                            	  7711:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7712:     ;
02:000449D2 02000007        	  7713:     andi.b #$07,D0
02:000449D6 0C000002        	  7714:     cmpi.b  #$02,D0
02:000449DA 6506            	  7715:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:000449DC 0C000005        	  7716:     cmpi.b  #$05,D0
02:000449E0 6502            	  7717:     bcs  _anon_z05_157
