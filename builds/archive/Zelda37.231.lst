                            	  4328: ; Params:
                            	  4329: ; A: object index of target
                            	  4330: ; X: object index of origin
                            	  4331: ; [00]: 0
                            	  4332: ;
                            	  4333: ; Returns:
                            	  4334: ; [00]: the number of axes where the distance <= 8
                            	  4335: ; [03]: distance X
                            	  4336: ; [04]: distance Y
                            	  4337: ; [0A]: vertical direction from origin to target
                            	  4338: ; [0B]: horizontal direction from origin to target
                            	  4339: ;
                            	  4340: ;
