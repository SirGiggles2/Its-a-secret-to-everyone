                            	  4792:     ;
02:00030FFC 7600            	  4793:     moveq   #0,D3
02:00030FFE 16342028        	  4794:     move.b  ($28,A4,D2.W),D3
                            	  4795:     ; At times $16 and $11, rotate carry=1 to the low bit.
