02:0004D244 203C00FF6530    	  7406:     move.l  #$FF6530,D0
02:0004D24A D083            	  7407:     add.l   D3,D0
02:0004D24C 7600            	  7408:     moveq   #0,D3
02:0004D24E 162C0525        	  7409:     move.b  ($0525,A4),D3
02:0004D252 E84B            	  7410:     lsr.w   #4,D3
02:0004D254 5943            	  7411:     subi.w  #4,D3
02:0004D256 E34B            	  7412:     lsl.w   #1,D3
02:0004D258 D083            	  7413:     add.l   D3,D0
02:0004D25A 2040            	  7414:     movea.l D0,A0
02:0004D25C 1010            	  7415:     move.b  (A0),D0
02:0004D25E 0C000084        	  7416:     cmpi.b  #$84,D0
02:0004D262 6544            	  7417:     blo     _L_z07_P47_post2_ok
                            	  7418:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7419:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7420:     ; writes to the $05xx region.
02:0004D264 7800            	  7421:     moveq   #0,D4
                            	  7422: _L_z07_P47_fb_loop:
