                            	  6821: Aquamentus_Draw:
                            	  6822:     ; Every $10 screen frames, switch animation frames.
                            	  6823:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6824:     ; The last tile of frame 0 is at index 5.
                            	  6825:     ; The last tile of frame 1 is at index $B.
                            	  6826:     ;
02:0003C814 7605            	  6827:     moveq   #5,D3
02:0003C816 102C0015        	  6828:     move.b  ($0015,A4),D0
02:0003C81A 02000010        	  6829:     andi.b #$10,D0
02:0003C81E 6602            	  6830:     bne  _anon_z04_88
02:0003C820 760B            	  6831:     moveq   #11,D3
                            	  6832: _anon_z04_88:
02:0003C822 1943000A        	  6833:     move.b  D3,($000A,A4)
                            	  6834:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6835:     ;
02:0003C826 7005            	  6836:     moveq   #5,D0
02:0003C828 1940000B        	  6837:     move.b  D0,($000B,A4)
                            	  6838:     even
                            	  6839: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C82C 7600            	  6840:     moveq   #0,D3
02:0003C82E 162C000B        	  6841:     move.b  ($000B,A4),D3
                            	  6842:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6843:     ; Store it in [00].
                            	  6844:     ;
02:0003C832 10342070        	  6845:     move.b  ($70,A4,D2.W),D0
02:0003C836 023C00EE        	  6846:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C83A 41F90003C80E    	  6847:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C840 12303000        	  6848:     move.b  (A0,D3.W),D1
02:0003C844 D101            	  6849:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C846 1880            	  6850:     move.b  D0,($0000,A4)
                            	  6851:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6852:     ; Store it in [01].
                            	  6853:     ;
02:0003C848 41EC0084        	  6854:     lea     ($0084,A4),A0
02:0003C84C 10302000        	  6855:     move.b  (A0,D2.W),D0
02:0003C850 023C00EE        	  6856:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C854 41F90003C808    	  6857:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C85A 12303000        	  6858:     move.b  (A0,D3.W),D1
02:0003C85E D101            	  6859:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C860 19400001        	  6860:     move.b  D0,($0001,A4)
                            	  6861:     ; Calculate sprite attributes:
                            	  6862:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6863:     ;
                            	  6864:     ; If the boss is temporarily invincible, then
                            	  6865:     ; this makes it flash by cycling all the palette rows.
                            	  6866:     ;
                            	  6867:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6868:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6869:     ;
02:0003C864 41EC04F0        	  6870:     lea     ($04F0,A4),A0
02:0003C868 10302000        	  6871:     move.b  (A0,D2.W),D0
02:0003C86C 02000003        	  6872:     andi.b #$03,D0
02:0003C870 0A000003        	  6873:     eori.b #$03,D0
02:0003C874 19400003        	  6874:     move.b  D0,($0003,A4)
02:0003C878 7600            	  6875:     moveq   #0,D3
02:0003C87A 162C000A        	  6876:     move.b  ($000A,A4),D3
                            	  6877:     ; Look up the tile for this sprite.
                            	  6878:     ; If it's not the first one (face), then go write the sprite record.
                            	  6879:     ;
02:0003C87E 41F90003C7FC    	  6880:     lea     (AquamentusTiles).l,A0
02:0003C884 10303000        	  6881:     move.b  (A0,D3.W),D0
02:0003C888 12390003C7FC    	  6882:     move.b  (AquamentusTiles).l,D1
02:0003C88E B001            	  6883:     cmp.b   D1,D0
02:0003C890 6610            	  6884:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6885:     ; Else it's the first one (the face tile).
                            	  6886:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6887:     ;
                            	  6888:     ; $CC/CD shows the closed mouth face.
                            	  6889:     ; $C0/C1 shows the open mouth face.
                            	  6890:     ;
02:0003C892 7600            	  6891:     moveq   #0,D3
02:0003C894 16342028        	  6892:     move.b  ($28,A4,D2.W),D3
02:0003C898 0C030020        	  6893:     cmpi.b  #$20,D3
02:0003C89C 6404            	  6894:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C89E 103C00C0        	  6895:     move.b  #$C0,D0
