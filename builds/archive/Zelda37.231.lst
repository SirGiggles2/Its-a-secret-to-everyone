                            	  7026: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7027:     ; Bloated timer =>
                            	  7028:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7029:     ; 1:     go advance the substate
                            	  7030:     ; other: go decrement Bloated timer
                            	  7031:     ;
02:0003C99E 7600            	  7032:     moveq   #0,D3
02:0003C9A0 41EC045E        	  7033:     lea     ($045E,A4),A0
02:0003C9A4 16302000        	  7034:     move.b  (A0,D2.W),D3
02:0003C9A8 5303            	  7035:     subq.b  #1,D3
02:0003C9AA 6750            	  7036:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C9AC 6B04            	  7037:     bmi.s  __far_z_04_0058
02:0003C9AE 60000080        	  7038:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7039: __far_z_04_0058:
                            	  7040:     ; Set the bloated timer according to the substate.
                            	  7041:     ;
02:0003C9B2 7600            	  7042:     moveq   #0,D3
02:0003C9B4 41EC042C        	  7043:     lea     ($042C,A4),A0
02:0003C9B8 16302000        	  7044:     move.b  (A0,D2.W),D3
02:0003C9BC 41F90003C8FA    	  7045:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C9C2 10303000        	  7046:     move.b  (A0,D3.W),D0
02:0003C9C6 41EC045E        	  7047:     lea     ($045E,A4),A0
02:0003C9CA 11802000        	  7048:     move.b  D0,(A0,D2.W)
                            	  7049:     ; If substate <> 0, go decrement bloated timer.
                            	  7050:     ;
02:0003C9CE 4A03            	  7051:     cmpi.b  #$00,D3
02:0003C9D0 6702            	  7052:     beq.s  __far_z_04_0059
02:0003C9D2 605C            	  7053:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7054: __far_z_04_0059:
                            	  7055:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  7056:     ;
02:0003C9D4 7610            	  7057:     moveq   #16,D3
02:0003C9D6 7000            	  7058:     moveq   #0,D0
02:0003C9D8 41EC00AC        	  7059:     lea     ($00AC,A4),A0
02:0003C9DC 11803000        	  7060:     move.b  D0,(A0,D3.W)
                            	  7061:     ; Increment the number of bomb hits.
                            	  7062:     ;
02:0003C9E0 41EC0437        	  7063:     lea     ($0437,A4),A0
02:0003C9E4 10302000        	  7064:     move.b  (A0,D2.W),D0
02:0003C9E8 023C00EE        	  7065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C9EC 123C0001        	  7066:     move.b  #$01,D1
02:0003C9F0 D101            	  7067:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003C9F2 41EC0437        	  7068:     lea     ($0437,A4),A0
02:0003C9F6 11802000        	  7069:     move.b  D0,(A0,D2.W)
02:0003C9FA 6034            	  7070:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  7071: 
