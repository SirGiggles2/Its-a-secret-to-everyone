02:0003AB9E 41EC034F        	  2916:     lea     ($034F,A4),A0
02:0003ABA2 10302000        	  2917:     move.b  (A0,D2.W),D0
02:0003ABA6 0C000020        	  2918:     cmpi.b  #$20,D0
