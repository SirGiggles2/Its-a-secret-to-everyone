                            	  5802: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5803:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5804:     ;
02:000436EC 101D            	  5805:     move.b  (A5)+,D0  ; PLA
02:000436EE 1B00            	  5806:     move.b  D0,-(A5)  ; PHA
02:000436F0 7400            	  5807:     moveq   #0,D2
02:000436F2 1400            	  5808:     move.b  D0,D2
                            	  5809:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5810:     ; starting from highest index down to 0:
                            	  5811:     ;
02:000436F4 41F9000435E2    	  5812:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:000436FA 10302000        	  5813:     move.b  (A0,D2.W),D0
02:000436FE 7400            	  5814:     moveq   #0,D2
02:00043700 1400            	  5815:     move.b  D0,D2
