02:00042124 41F9000420F0    	  4212:     lea     (DoorwayBoundsMinOver).l,A0
02:0004212A 12303000        	  4213:     move.b  (A0,D3.W),D1
02:0004212E B001            	  4214:     cmp.b   D1,D0
02:00042130 6510            	  4215:     bcs  _anon_z05_95
02:00042132 41F9000420F4    	  4216:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042138 12303000        	  4217:     move.b  (A0,D3.W),D1
02:0004213C B001            	  4218:     cmp.b   D1,D0
