                            	  3789: FormatHeartsInTextBuf:
                            	  3790:     ; [$0E]: hearts value
                            	  3791:     ; [$0F]: heart partial
                            	  3792:     ; Y: The offset of first character in buffer
                            	  3793:     ;
                            	  3794:     ; The end of the bottom row is $12 bytes after the
                            	  3795:     ; start of the top row. We're writing to two transfer
                            	  3796:     ; records. We write the top row in the first transfer
                            	  3797:     ; record wherever the caller chooses. The second
                            	  3798:     ; transfer record has to begin with the heart tiles.
                            	  3799:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3800:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3801:     ;
                            	  3802:     ; Store the starting offset in [$0D].
02:000309A4 1943000D        	  3803:     move.b  D3,($000D,A4)
02:000309A8 102C000E        	  3804:     move.b  ($000E,A4),D0
02:000309AC 1B00            	  3805:     move.b  D0,-(A5)  ; PHA
02:000309AE 0200000F        	  3806:     andi.b #$0F,D0
02:000309B2 1880            	  3807:     move.b  D0,($0000,A4)
02:000309B4 700F            	  3808:     moveq   #15,D0
02:000309B6 003C0011        	  3809:     ori     #$11,CCR  ; SEC: set C+X
02:000309BA 1214            	  3810:     move.b  ($0000,A4),D1
02:000309BC 0A3C0010        	  3811:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000309C0 9101            	  3812:     subx.b  D1,D0   ; SBC $00
02:000309C2 0A3C0010        	  3813:     eori    #$10,CCR  ; restore X = 6502 C
02:000309C6 1880            	  3814:     move.b  D0,($0000,A4)
02:000309C8 101D            	  3815:     move.b  (A5)+,D0  ; PLA
02:000309CA E208            	  3816:     lsr.b  #1,D0   ; LSR A
02:000309CC E208            	  3817:     lsr.b  #1,D0   ; LSR A
02:000309CE E208            	  3818:     lsr.b  #1,D0   ; LSR A
02:000309D0 E208            	  3819:     lsr.b  #1,D0   ; LSR A
02:000309D2 19400001        	  3820:     move.b  D0,($0001,A4)
02:000309D6 700F            	  3821:     moveq   #15,D0
02:000309D8 003C0011        	  3822:     ori     #$11,CCR  ; SEC: set C+X
02:000309DC 122C0001        	  3823:     move.b  ($0001,A4),D1
02:000309E0 0A3C0010        	  3824:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000309E4 9101            	  3825:     subx.b  D1,D0   ; SBC $01
02:000309E6 0A3C0010        	  3826:     eori    #$10,CCR  ; restore X = 6502 C
02:000309EA 19400001        	  3827:     move.b  D0,($0001,A4)
                            	  3828:     ; At this point,
                            	  3829:     ; [$00] = $F - hearts
                            	  3830:     ; [$01] = $F - heart containers
                            	  3831:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3832:     ;
                            	  3833:     ; Also, Y is still set to the value passed in.
                            	  3834:     ;
02:000309EE 7400            	  3835:     moveq   #0,D2
02:000309F0 1003            	  3836:     move.b  D3,D0
02:000309F2 023C00EE        	  3837:     andi    #$EE,CCR  ; CLC: clear C+X
02:000309F6 123C0007        	  3838:     move.b  #$07,D1
02:000309FA D101            	  3839:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:000309FC 1940000B        	  3840:     move.b  D0,($000B,A4)
                            	  3841:     ; Y keeps track of index of heart in row.
                            	  3842:     ; Start at the end of the first row.
02:00030A00 7607            	  3843:     moveq   #7,D3
                            	  3844:     even
