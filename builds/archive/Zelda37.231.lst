                            	 12255: __far_z_04_0120:
                            	 12256:     ; State = 0.
                            	 12257:     ;
                            	 12258:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12259:     ; This is the only patra child shown in the first fame.
                            	 12260:     ;
02:0003F02E 0C020002        	 12261:     cmpi.b  #$02,D2
02:0003F032 6732            	 12262:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12263:     ; The patra child in slot 2 is the last one to be updated.
                            	 12264:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12265:     ;
                            	 12266:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12267:     ; shown.
                            	 12268:     ;
02:0003F034 102C00AE        	 12269:     move.b  ($00AE,A4),D0
02:0003F038 6700008E        	 12270:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12271:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12272:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12273:     ;
02:0003F03C 1002            	 12274:     move.b  D2,D0
                            	 12275:     ; Subtract 3 from the object slot to get the angle where the
                            	 12276:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12277:     ;
02:0003F03E 003C0011        	 12278:     ori     #$11,CCR  ; SEC: set C+X
02:0003F042 123C0003        	 12279:     move.b  #$03,D1
02:0003F046 0A3C0010        	 12280:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F04A 9101            	 12281:     subx.b  D1,D0   ; SBC #$03
02:0003F04C 0A3C0010        	 12282:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F050 7600            	 12283:     moveq   #0,D3
02:0003F052 1600            	 12284:     move.b  D0,D3
                            	 12285:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12286:     ; then return.
                            	 12287:     ;
02:0003F054 102C0396        	 12288:     move.b  ($0396,A4),D0
02:0003F058 41F90003F012    	 12289:     lea     (PatraChildStartAngles).l,A0
02:0003F05E 12303000        	 12290:     move.b  (A0,D3.W),D1
02:0003F062 B001            	 12291:     cmp.b   D1,D0
02:0003F064 6662            	 12292:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12293:     even
