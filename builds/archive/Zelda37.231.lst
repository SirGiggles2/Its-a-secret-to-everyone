                            	  2690: ModeEandF_SetUpCursorSprites:
                            	  2691:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2692:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2693:     ; These are the cursor sprites.
02:00034F34 760A            	  2694:     moveq   #10,D3
                            	  2695:     even
                            	  2696: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:00034F36 41F9000347FE    	  2697:     lea     (ModeEandFCursorSprites).l,A0
02:00034F3C 10303000        	  2698:     move.b  (A0,D3.W),D0
02:00034F40 41EC0201        	  2699:     lea     ($0201,A4),A0
02:00034F44 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:00034F48 5303            	  2701:     subq.b  #1,D3
02:00034F4A 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00034F4C 7600            	  2703:     moveq   #0,D3
02:00034F4E 162C0016        	  2704:     move.b  ($0016,A4),D3
02:00034F52 41F9000347B4    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:00034F58 10303000        	  2706:     move.b  (A0,D3.W),D0
02:00034F5C 19400084        	  2707:     move.b  D0,($0084,A4)
02:00034F60 19400200        	  2708:     move.b  D0,($0200,A4)
02:00034F64 102C0012        	  2709:     move.b  ($0012,A4),D0
02:00034F68 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00034F6C 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00034F6E 103C00F3        	  2715:     move.b  #$F3,D0
02:00034F72 19400201        	  2716:     move.b  D0,($0201,A4)
                            	  2717:     ; Because the visible part of the cursor block sprite is
                            	  2718:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2719:     ; above its ObjY.
02:00034F76 102C0084        	  2720:     move.b  ($0084,A4),D0
02:00034F7A 003C0011        	  2721:     ori     #$11,CCR  ; SEC: set C+X
02:00034F7E 123C0008        	  2722:     move.b  #$08,D1
02:00034F82 0A3C0010        	  2723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F86 9101            	  2724:     subx.b  D1,D0   ; SBC #$08
02:00034F88 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:00034F8C 19400204        	  2726:     move.b  D0,($0204,A4)
02:00034F90 7070            	  2727:     moveq   #112,D0
02:00034F92 19400070        	  2728:     move.b  D0,($0070,A4)
02:00034F96 103C0087        	  2729:     move.b  #$87,D0
02:00034F9A 19400085        	  2730:     move.b  D0,($0085,A4)
02:00034F9E 7030            	  2731:     moveq   #48,D0
02:00034FA0 19400071        	  2732:     move.b  D0,($0071,A4)
                            	  2733:     even
