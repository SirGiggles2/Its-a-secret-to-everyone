02:0002E558 123C0014        	   890:     move.b  #$14,D1
02:0002E55C D101            	   891:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E55E 1940067E        	   892:     move.b  D0,($067E,A4)
                            	   893:     ; Mark this secret taken.
