                            	  4551:     even
                            	  4552: _L_z01_WieldBomb_Activate:
                            	  4553:     ; We're using a bomb. Decrement the count.
                            	  4554:     ;
02:00030EAC 532C0658        	  4555:     subq.b  #1,($0658,A4)
                            	  4556:     ; Play the "set a bomb" tune.
                            	  4557:     ;
02:00030EB0 7020            	  4558:     moveq   #32,D0
02:00030EB2 19400604        	  4559:     move.b  D0,($0604,A4)
                            	  4560:     ; Reset the object timer.
                            	  4561:     ;
