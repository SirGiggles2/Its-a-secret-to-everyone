02:0003CCE0 122C0015        	  7542:     move.b  ($0015,A4),D1
02:0003CCE4 C001            	  7543:     and.b  D1,D0
02:0003CCE6 6710            	  7544:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7545:     ; For animation frame 1, add 5 to the index in Y register,
