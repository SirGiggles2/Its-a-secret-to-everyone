                            	  7331: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7332:     ; If the "monsters from edges" long timer expired, then
                            	  7333:     ; go bring the monster in.
                            	  7334:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7335:     ;
                            	  7336:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
