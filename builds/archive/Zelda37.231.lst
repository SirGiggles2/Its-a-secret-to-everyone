                            	  7522:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7523:     ;
02:0003CCC6 102C0015        	  7524:     move.b  ($0015,A4),D0
02:0003CCCA 02000002        	  7525:     andi.b #$02,D0
02:0003CCCE 6604            	  7526:     bne.s  __far_z_04_0066
02:0003CCD0 600000A6        	  7527:     jmp  L11B00_Exit
                            	  7528: __far_z_04_0066:
02:0003CCD4 7600            	  7529:     moveq   #0,D3
02:0003CCD6 1614            	  7530:     move.b  ($0000,A4),D3
02:0003CCD8 601E            	  7531:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7532: 
