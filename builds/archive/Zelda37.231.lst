02:00030164 123C0003        	  2570:     move.b  #$03,D1
02:00030168 D101            	  2571:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003016A 003C0011        	  2572:     ori     #$11,CCR  ; SEC: set C+X
02:0003016E 41EC0084        	  2573:     lea     ($0084,A4),A0
02:00030172 12302000        	  2574:     move.b  (A0,D2.W),D1
02:00030176 0A3C0010        	  2575:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003017A 9101            	  2576:     subx.b  D1,D0   ; SBC ObjY,X
02:0003017C 0A3C0010        	  2577:     eori    #$10,CCR  ; restore X = 6502 C
02:00030180 61000B66        	  2578:     jsr     Abs
