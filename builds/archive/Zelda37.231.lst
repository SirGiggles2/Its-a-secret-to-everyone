                            	  5411:     ; limit of $10, and go handle the rest as if blocked.
                            	  5412:     ; State $20 will become $30 below in HandleArrowOrBoomerangBlocked.
                            	  5413:     ;
                            	  5414:     ; Otherwise, only animate and check collision as usual.
