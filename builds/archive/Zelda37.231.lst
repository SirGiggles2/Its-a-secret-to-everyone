                            	  8120: _L_z04_UpdateLikeLike_HandleCaptured:
                            	  8121:     ; Animate up to frame 3. Then stay there.
                            	  8122:     ;
02:0003D18C 7002            	  8123:     moveq   #2,D0
02:0003D18E 41EC03E4        	  8124:     lea     ($03E4,A4),A0
02:0003D192 12302000        	  8125:     move.b  (A0,D2.W),D1
02:0003D196 B001            	  8126:     cmp.b   D1,D0
02:0003D198 651C            	  8127:     bcs  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003D19A 41EC03D0        	  8128:     lea     ($03D0,A4),A0
02:0003D19E 53302000        	  8129:     subq.b  #1,(A0,D2.W)
02:0003D1A2 6612            	  8130:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003D1A4 E308            	  8131:     lsl.b  #1,D0   ; ASL A
02:0003D1A6 41EC03D0        	  8132:     lea     ($03D0,A4),A0
02:0003D1AA 11802000        	  8133:     move.b  D0,(A0,D2.W)
02:0003D1AE 41EC03E4        	  8134:     lea     ($03E4,A4),A0
02:0003D1B2 52302000        	  8135:     addq.b  #1,(A0,D2.W)
                            	  8136:     even
                            	  8137: _L_z04_UpdateLikeLike_IncCaptureTime:
                            	  8138:     ; Increment capture time.
                            	  8139:     ;
02:0003D1B6 41EC042C        	  8140:     lea     ($042C,A4),A0
02:0003D1BA 52302000        	  8141:     addq.b  #1,(A0,D2.W)
                            	  8142:     ; Once capture time >= $60 screen frames, remove the magic shield.
                            	  8143:     ;
02:0003D1BE 41EC042C        	  8144:     lea     ($042C,A4),A0
02:0003D1C2 10302000        	  8145:     move.b  (A0,D2.W),D0
02:0003D1C6 0C000060        	  8146:     cmpi.b  #$60,D0
02:0003D1CA 6512            	  8147:     bcs  _L_z04_UpdateLikeLike_DrawAfterCapture
02:0003D1CC 7000            	  8148:     moveq   #0,D0
02:0003D1CE 19400676        	  8149:     move.b  D0,($0676,A4)
                            	  8150:     ; Set a value above $60 over and over.
                            	  8151:     ;
02:0003D1D2 103C00C0        	  8152:     move.b  #$C0,D0
02:0003D1D6 41EC042C        	  8153:     lea     ($042C,A4),A0
