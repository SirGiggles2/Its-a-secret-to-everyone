02:0003EE26 0A3C0010        	 11988:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE2A 9101            	 11989:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EE2C 0A3C0010        	 11990:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE30 640A            	 11991:     bcc  _anon_z04_153
02:0003EE32 122C0002        	 11992:     move.b  ($0002,A4),D1
