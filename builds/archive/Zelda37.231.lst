                            	 12851: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12852:     ; Draw the four clouds at diagonal corners.
                            	 12853:     ;
02:0003F434 610000B6        	 12854:     jsr     Ganon_GetCurCloudLeft
02:0003F438 610000BE        	 12855:     jsr     Ganon_GetCurCloudTop
02:0003F43C 61A0            	 12856:     jsr     Ganon_DrawCloud
02:0003F43E 610000B2        	 12857:     jsr     Ganon_GetCurCloudRight
02:0003F442 619A            	 12858:     jsr     Ganon_DrawCloud
02:0003F444 610000A6        	 12859:     jsr     Ganon_GetCurCloudLeft
02:0003F448 610000B4        	 12860:     jsr     Ganon_GetCurCloudBottom
02:0003F44C 6190            	 12861:     jsr     Ganon_DrawCloud
