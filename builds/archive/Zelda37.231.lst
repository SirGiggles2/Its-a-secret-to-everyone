02:0003EE38 19410002        	 11994:     move.b  D1,($0002,A4)
                            	 11995: _anon_z04_153:
                            	 11996:     ; Find the vertical direction toward Link and store it in [03].
                            	 11997:     ;
02:0003EE3C 7004            	 11998:     moveq   #4,D0
