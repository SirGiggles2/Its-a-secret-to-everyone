                            	  7757: _anon_z04_96:
                            	  7758:     ; If we have the magic clock, or is stunned, then
                            	  7759:     ; go draw and check collisions.
                            	  7760:     ;
02:0003CE7E 102C066C        	  7761:     move.b  ($066C,A4),D0
02:0003CE82 1234203D        	  7762:     move.b  ($3D,A4,D2.W),D1
02:0003CE86 8001            	  7763:     or.b  D1,D0
02:0003CE88 660000AE        	  7764:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7765:     ; Every odd screen frame, go straight to drawing
                            	  7766:     ; and checking collisions.
                            	  7767:     ;
02:0003CE8C 102C0015        	  7768:     move.b  ($0015,A4),D0
02:0003CE90 E208            	  7769:     lsr.b  #1,D0   ; LSR A
02:0003CE92 6404            	  7770:     bcc.s  __far_z_04_0068
02:0003CE94 60000118        	  7771:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7772: __far_z_04_0068:
                            	  7773:     ; Otherwise move horizontally.
                            	  7774:     ;
02:0003CE98 61000248        	  7775:     jsr     PolsVoice_MoveX
                            	  7776:     ; If state <> 0, then the monster is jumping.
                            	  7777:     ; Go handle vertical movement.
                            	  7778:     ;
02:0003CE9C 41EC00AC        	  7779:     lea     ($00AC,A4),A0
02:0003CEA0 10302000        	  7780:     move.b  (A0,D2.W),D0
02:0003CEA4 6706            	  7781:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CEA6 61000130        	  7782:     jsr     UpdatePolsVoiceState1_Jumping
