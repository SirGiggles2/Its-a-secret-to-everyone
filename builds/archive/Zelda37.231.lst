                            	 11753:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11754:     ;
02:0003ECB0 7011            	 11755:     moveq   #17,D0
02:0003ECB2 19803029        	 11756:     move.b  D0,($29,A4,D3.W)
                            	 11757:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11758:     ; to the tail segment.
