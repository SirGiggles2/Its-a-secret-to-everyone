02:0002E4E2 19400604        	   817:     move.b  D0,($0604,A4)
                            	   818:     ; If the high 2 bits of character element = 0, then return.
                            	   819:     ;
02:0002E4E6 1214            	   820:     move.b  ($00,A4),D1   ; ptr lo
02:0002E4E8 182C0001        	   821:     move.b  ($01,A4),D4  ; ptr hi
02:0002E4EC 024100FF        	   822:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E4F0 E14C            	   823:     lsl.w   #8,D4
02:0002E4F2 8841            	   824:     or.w    D1,D4             ; D4 = NES ptr addr
