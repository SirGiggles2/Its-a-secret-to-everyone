02:0003C088 6774            	  5759:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5760:     ; This segment is dead. We'll swap the tail segment with this
                            	  5761:     ; dead segment. This way, moldorm heads are always rooted
                            	  5762:     ; in slots 5 and $A; and the segments are continguous.
                            	  5763:     ;
