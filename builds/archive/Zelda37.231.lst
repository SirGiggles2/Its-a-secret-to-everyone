                            	  8272:     ; In UW. There are two input directions, and they're both walkable.
                            	  8273:     ;
                            	  8274:     ; Normally, turn to the direction that's perpendicular to object
                            	  8275:     ; direction. But keep going straight after that, while diagonal
                            	  8276:     ; input is held.
                            	  8277:     ;
                            	  8278:     ; Handle special cases for doors.
                            	  8279:     ;
                            	  8280:     ;
                            	  8281:     ; 1. Link at horizontal doors.
                            	  8282:     ;
                            	  8283:     ; If Link's X = $20 or $D0 then
                            	  8284:     ;   If Link's Y = $85 and facing down then
                            	  8285:     ;     Go set object direction and input direction to object
                            	  8286:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8287:     ;     Link_GoStraightWhenDiagInput.
