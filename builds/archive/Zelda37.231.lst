                            	  4576: PlaceWeaponForPlayerStateAndAnim:
                            	  4577:     ; Set player's animation counter to 1, so that it will roll over
                            	  4578:     ; as soon as possible, causing movement frame to become 0 (legs apart),
                            	  4579:     ; which is how we want to end item-use animations.
                            	  4580:     ;
                            	  4581:     ; Set player's state to $10 (wielding sword/item).
                            	  4582:     ;
02:00030EC6 7001            	  4583:     moveq   #1,D0
