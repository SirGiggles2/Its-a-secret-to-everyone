                            	  8190: _L_z04_UpdateVire_SplitUp:
                            	  8191:     ; As with Zol, we'll destroy one monster, and make two.
                            	  8192:     ; So, increase object count by 1.
                            	  8193:     ;
02:0003D222 522C034E        	  8194:     addq.b  #1,($034E,A4)
02:0003D226 4EB90004D59C    	  8195:     jsr     DestroyMonster
                            	  8196:     ; Two times, look for an empty monster slot.
                            	  8197:     ; If one is found, then use the "shoot" operation to create a red keese.
                            	  8198:     ;
