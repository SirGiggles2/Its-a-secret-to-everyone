                            	  4011: UpdatePondFairy:
02:0003B35E 610046C2        	  4012:     jsr     DrawFairy
                            	  4013:     ; If not in state 0, then go handle states 1 to 3.
                            	  4014:     ;
02:0003B362 102C00AD        	  4015:     move.b  ($00AD,A4),D0
02:0003B366 6702            	  4016:     beq.s  __far_z_04_0035
02:0003B368 602A            	  4017:     jmp  PondFairy_HandleOtherStates
                            	  4018: __far_z_04_0035:
                            	  4019:     ; State 0.
                            	  4020:     ;
                            	  4021:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4022:     ;
02:0003B36A 102C0084        	  4023:     move.b  ($0084,A4),D0
02:0003B36E 0C0000AD        	  4024:     cmpi.b  #$AD,D0
02:0003B372 661E            	  4025:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4026:     ; If Link's X < $70 or >= $81, then return.
                            	  4027:     ;
02:0003B374 102C0070        	  4028:     move.b  ($0070,A4),D0
02:0003B378 0C000070        	  4029:     cmpi.b  #$70,D0
02:0003B37C 6514            	  4030:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B37E 0C000081        	  4031:     cmpi.b  #$81,D0
02:0003B382 640E            	  4032:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4033:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4034:     ; halt Link, and start filling hearts.
                            	  4035:     ;
02:0003B384 522C00AD        	  4036:     addq.b  #1,($00AD,A4)
02:0003B388 7040            	  4037:     moveq   #64,D0
02:0003B38A 194000AC        	  4038:     move.b  D0,($00AC,A4)
02:0003B38E 19400063        	  4039:     move.b  D0,($0063,A4)
                            	  4040:     even
                            	  4041: _L_z04_UpdatePondFairy_Exit:
02:0003B392 4E75            	  4042:     rts
                            	  4043: 
                            	  4044:     even
                            	  4045: PondFairy_HandleOtherStates:
02:0003B394 0C000001        	  4046:     cmpi.b  #$01,D0
02:0003B398 6610            	  4047:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4048:     ; State 1. Flying and filling hearts.
                            	  4049:     ;
                            	  4050:     ; If still filling hearts, then go draw Link and hearts.
                            	  4051:     ;
02:0003B39A 102C0063        	  4052:     move.b  ($0063,A4),D0
02:0003B39E 6620            	  4053:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4054:     ; If not filling hearts anymore, then go to state 2,
                            	  4055:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4056:     ; a little while after we finish filling hearts.
                            	  4057:     ;
02:0003B3A0 522C00AD        	  4058:     addq.b  #1,($00AD,A4)
02:0003B3A4 7050            	  4059:     moveq   #80,D0
02:0003B3A6 19400029        	  4060:     move.b  D0,($0029,A4)
                            	  4061:     even
                            	  4062: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4063:     ; If state <> 2 (so, it's 3), then return.
                            	  4064:     ;
                            	  4065:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4066:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4067:     ; was set to, and we'll return.
                            	  4068:     ;
02:0003B3AA 0C000002        	  4069:     cmpi.b  #$02,D0
02:0003B3AE 6634            	  4070:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4071:     ; State = 2.
                            	  4072:     ;
                            	  4073:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4074:     ;
02:0003B3B0 102C0029        	  4075:     move.b  ($0029,A4),D0
02:0003B3B4 660A            	  4076:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4077:     ; Else go to state 3, and unhalt Link.
                            	  4078:     ;
02:0003B3B6 522C00AD        	  4079:     addq.b  #1,($00AD,A4)
02:0003B3BA 7000            	  4080:     moveq   #0,D0
02:0003B3BC 194000AC        	  4081:     move.b  D0,($00AC,A4)
                            	  4082:     even
                            	  4083: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4084:     ; TODO: but why, since Link is halted?
                            	  4085:     ;
                            	  4086:     ; Reset the input direction, so that Link doesn't animate
                            	  4087:     ; when drawing him.
02:0003B3C0 7600            	  4088:     moveq   #0,D3
02:0003B3C2 194303F8        	  4089:     move.b  D3,($03F8,A4)
                            	  4090:     ; Save and reset Link's state.
                            	  4091:     ;
                            	  4092:     ; TODO: but why, since Link is halted?
                            	  4093:     ;
02:0003B3C6 102C00AC        	  4094:     move.b  ($00AC,A4),D0
02:0003B3CA 1B00            	  4095:     move.b  D0,-(A5)  ; PHA
02:0003B3CC 194300AC        	  4096:     move.b  D3,($00AC,A4)
02:0003B3D0 4EB90004BCCC    	  4097:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4098:     ; Restore Link's state.
                            	  4099:     ;
02:0003B3D6 101D            	  4100:     move.b  (A5)+,D0  ; PLA
02:0003B3D8 194000AC        	  4101:     move.b  D0,($00AC,A4)
02:0003B3DC 6110            	  4102:     jsr     PondFairy_MoveHearts
                            	  4103:     ; Restore the object slot.
                            	  4104:     ;
02:0003B3DE 7400            	  4105:     moveq   #0,D2
02:0003B3E0 142C0340        	  4106:     move.b  ($0340,A4),D2
                            	  4107:     even
