02:00044C5C 6022            	  8082:     jmp  L17295_Exit
                            	  8083: __far_z_05_0106:
                            	  8084:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8085:     ; and represents the current row of the submenu being processed.
                            	  8086:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8087:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  8088:     ;
                            	  8089:     ; If the bottom bit is set, go prepare the full black row.
                            	  8090:     ;
02:00044C5E E208            	  8091:     lsr.b  #1,D0   ; LSR A
02:00044C60 7600            	  8092:     moveq   #0,D3
02:00044C62 1600            	  8093:     move.b  D0,D3
02:00044C64 6402            	  8094:     bcc.s  __far_z_05_0107
02:00044C66 60B6            	  8095:     jmp  PrepFullBlackRow
                            	  8096: __far_z_05_0107:
                            	  8097:     ; There's nothing to do for row $15.
                            	  8098:     ; If submenu row < $15, cue a transfer of a triforce or other
                            	  8099:     ; transfer buffer for this row.
                            	  8100:     ;
02:00044C68 0C000015        	  8101:     cmpi.b  #$15,D0
02:00044C6C 640E            	  8102:     bcc  _anon_z05_170
02:00044C6E 41F900044BD0    	  8103:     lea     (SubmenuTransferBufSelectorsOW).l,A0
02:00044C74 10303000        	  8104:     move.b  (A0,D3.W),D0
