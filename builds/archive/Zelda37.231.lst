02:0003C0A6 41EC0350        	  5782:     lea     ($0350,A4),A0
02:0003C0AA 10303000        	  5783:     move.b  (A0,D3.W),D0
02:0003C0AE 0C000041        	  5784:     cmpi.b  #$41,D0
02:0003C0B2 66F0            	  5785:     bne  _anon_z04_80
                            	  5786:     ; I don't know why the object timer of the tail segment that will
                            	  5787:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5788:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5789:     ; there, the object timer is set to 6.
                            	  5790:     ;
02:0003C0B4 7011            	  5791:     moveq   #17,D0
02:0003C0B6 19803029        	  5792:     move.b  D0,($29,A4,D3.W)
                            	  5793:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5794:     ; segment to the tail segment.
                            	  5795:     ;
02:0003C0BA 41EC04F0        	  5796:     lea     ($04F0,A4),A0
02:0003C0BE 10302000        	  5797:     move.b  (A0,D2.W),D0
02:0003C0C2 41EC04F1        	  5798:     lea     ($04F1,A4),A0
02:0003C0C6 11803000        	  5799:     move.b  D0,(A0,D3.W)
02:0003C0CA 10342070        	  5800:     move.b  ($70,A4,D2.W),D0
02:0003C0CE 19803071        	  5801:     move.b  D0,($71,A4,D3.W)
02:0003C0D2 41EC0084        	  5802:     lea     ($0084,A4),A0
02:0003C0D6 10302000        	  5803:     move.b  (A0,D2.W),D0
02:0003C0DA 41EC0085        	  5804:     lea     ($0085,A4),A0
02:0003C0DE 11803000        	  5805:     move.b  D0,(A0,D3.W)
                            	  5806:     ; If the tail segment found is also a head, then
                            	  5807:     ; the last segment has died. Return.
