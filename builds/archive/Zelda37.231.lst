02:00034E04 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00034E06 41F900034814    	  2548:     lea     (SlotToNameOffset).l,A0
02:00034E0C 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00034E10 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00034E14 7400            	  2553:     moveq   #0,D2
02:00034E16 41F900034818    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034E1C 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00034E20 7602            	  2556:     moveq   #2,D3
