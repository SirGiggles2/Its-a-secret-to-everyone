                            	  5850: _anon_z04_81:
                            	  5851:     ; Chase while flying, as usual.
                            	  5852:     ;
02:0003C12E 61003AE2        	  5853:     jsr     Flyer_Chase
                            	  5854:     ; If timer has not expired, then
                            	  5855:     ; go see if it's time to propagate direction changes down the chain.
                            	  5856:     ;
02:0003C132 10342028        	  5857:     move.b  ($28,A4,D2.W),D0
02:0003C136 6702            	  5858:     beq.s  __far_z_04_0041
02:0003C138 6032            	  5859:     jmp  Moldorm_PropagateDirs
                            	  5860: __far_z_04_0041:
                            	  5861:     even
                            	  5862: Moldorm_ChangeFlyingState:
                            	  5863:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5864:     ;
02:0003C13A 61000096        	  5865:     jsr     Flyer_MoldormDecideState
02:0003C13E 7010            	  5866:     moveq   #16,D0
02:0003C140 19802028        	  5867:     move.b  D0,($28,A4,D2.W)
                            	  5868:     ; If the next lower slot's direction <> 0, then
                            	  5869:     ; go propagate direction changes down the chain.
                            	  5870:     ;
                            	  5871:     ; But you had to have propagated directions once for the
                            	  5872:     ; next lower direction to be set. How does it happen?
                            	  5873:     ;
                            	  5874:     ; Within a flyer state, the flying routines turn the flyer
                            	  5875:     ; and set the object timer to $10 several times. After any of
                            	  5876:     ; those times will the test succeed.
                            	  5877:     ;
                            	  5878:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5879:     ; in this block to set the timer to $10, and try to propagate
                            	  5880:     ; directions.
                            	  5881:     ;
                            	  5882:     ; But this is also the case the first time here.
                            	  5883:     ;
                            	  5884:     ; So, I believe that the point of this test is to delay moving
                            	  5885:     ; the lower (not head) segments when starting out.
                            	  5886:     ;
02:0003C144 41EC0097        	  5887:     lea     ($0097,A4),A0
02:0003C148 10302000        	  5888:     move.b  (A0,D2.W),D0
02:0003C14C 6702            	  5889:     beq.s  __far_z_04_0042
02:0003C14E 601C            	  5890:     jmp  Moldorm_PropagateDirs
                            	  5891: __far_z_04_0042:
02:0003C150 4E75            	  5892:     rts
                            	  5893: 
                            	  5894:     even
                            	  5895: Moldorm_Wander:
                            	  5896:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5897:     ; Only the head controls the movement direction.
                            	  5898:     ;
02:0003C152 0C020005        	  5899:     cmpi.b  #$05,D2
02:0003C156 6708            	  5900:     beq  _anon_z04_82
02:0003C158 0C02000A        	  5901:     cmpi.b  #$0A,D2
02:0003C15C 6702            	  5902:     beq.s  __far_z_04_0043
02:0003C15E 6070            	  5903:     jmp  L1156B_Exit
                            	  5904: __far_z_04_0043:
                            	  5905: _anon_z04_82:
                            	  5906:     ; Turn randomly while flying, as usual.
                            	  5907:     ;
02:0003C160 61003B8E        	  5908:     jsr     Flyer_Wander
                            	  5909:     ; After every turn, the common flyer routines set timer to $10.
                            	  5910:     ; This can be used as a signal for moldorm to propagate
                            	  5911:     ; direction changes down the chain.
                            	  5912:     ;
                            	  5913:     ; Between each turn, timer <> $10.
                            	  5914:     ;
                            	  5915:     ; At the end of the delay after the last turn, timer = 0.
                            	  5916:     ; This is a signal that that flying state ended, and a new one
                            	  5917:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5918:     ; we can propagate direction changes again; and start
                            	  5919:     ; a new flying interval by setting timer to $10. This will make
                            	  5920:     ; the next flying state delay that amount of time before turning
                            	  5921:     ; the first time.
                            	  5922:     ;
