                            	  8316: ; Description:
                            	  8317: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8318: ; When walking, the object timer is set. When teleporting,
                            	  8319: ; the teleporting distance remaining is set.
                            	  8320: ;
                            	  8321: ; If we have the magic clock, then only go draw and check collisions.
                            	  8322: ;
                            	  8323:     even
                            	  8324: UpdateBlueWizzrobe:
02:0003D324 102C066C        	  8325:     move.b  ($066C,A4),D0
02:0003D328 6702            	  8326:     beq.s  __far_z_04_0070
02:0003D32A 6014            	  8327:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8328: __far_z_04_0070:
