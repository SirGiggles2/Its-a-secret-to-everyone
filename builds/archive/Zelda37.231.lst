02:0002BFAA 08000008        	  2062:     btst    #8,D0
02:0002BFAE 670A            	  2063:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2064:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2065:     eori    #$01,CCR
02:0002BFB8 4E75            	  2066:     rts
                            	  2067: .cc_cnras:
02:0002BFBA 023C00FE        	  2068:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2069:     eori    #$01,CCR
02:0002BFC2 4E75            	  2070:     rts
