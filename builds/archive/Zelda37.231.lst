                            	  3564: CheckCaveEdge:
02:00041C98 4EB90004BBC2    	  3565:     jsr     CheckScreenEdge
                            	  3566:     ; If the player touched the edge of the screen and triggered
                            	  3567:     ; a transition to another mode, then go set up the right mode.
                            	  3568:     ;
02:00041C9E 102C0011        	  3569:     move.b  ($0011,A4),D0
02:00041CA2 6602            	  3570:     bne.s  __far_z_05_0070
02:00041CA4 60CC            	  3571:     jmp  GoToModeAFromCave
                            	  3572: __far_z_05_0070:
02:00041CA6 4E75            	  3573:     rts
                            	  3574: 
                            	  3575: ; Params:
                            	  3576: ; [0F]: movement direction
                            	  3577: ;
                            	  3578: ; Returns:
                            	  3579: ; [0F]: movement direction or 0
                            	  3580: ;
                            	  3581: ;
                            	  3582: ; If the ladder's not in use, return.
                            	  3583: ;
                            	  3584:     even
                            	  3585: CheckLadder:
02:00041CA8 7400            	  3586:     moveq   #0,D2
02:00041CAA 142C0064        	  3587:     move.b  ($0064,A4),D2
02:00041CAE 670000BE        	  3588:     beq  _L_z05_CheckLadder_Exit
                            	  3589:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3590:     ;
02:00041CB2 41EC00AC        	  3591:     lea     ($00AC,A4),A0
02:00041CB6 10302000        	  3592:     move.b  (A0,D2.W),D0
02:00041CBA 670000A6        	  3593:     beq  _L_z05_CheckLadder_StashLadder
                            	  3594:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3595:     ; between the ladder and Link.
                            	  3596:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3597:     ;
02:00041CBE 41EC0098        	  3598:     lea     ($0098,A4),A0
02:00041CC2 10302000        	  3599:     move.b  (A0,D2.W),D0
02:00041CC6 0200000C        	  3600:     andi.b #$0C,D0
02:00041CCA 6734            	  3601:     beq  _anon_z05_85
02:00041CCC 102C0070        	  3602:     move.b  ($0070,A4),D0
02:00041CD0 12342070        	  3603:     move.b  ($70,A4,D2.W),D1
02:00041CD4 B001            	  3604:     cmp.b   D1,D0
02:00041CD6 6600008A        	  3605:     bne  _L_z05_CheckLadder_StashLadder
02:00041CDA 102C0084        	  3606:     move.b  ($0084,A4),D0
02:00041CDE 023C00EE        	  3607:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CE2 123C0003        	  3608:     move.b  #$03,D1
02:00041CE6 D101            	  3609:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041CE8 003C0011        	  3610:     ori     #$11,CCR  ; SEC: set C+X
02:00041CEC 41EC0084        	  3611:     lea     ($0084,A4),A0
02:00041CF0 12302000        	  3612:     move.b  (A0,D2.W),D1
02:00041CF4 0A3C0010        	  3613:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041CF8 9101            	  3614:     subx.b  D1,D0   ; SBC ObjY,X
02:00041CFA 0A3C0010        	  3615:     eori    #$10,CCR  ; restore X = 6502 C
02:00041CFE 6030            	  3616:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3617: 
                            	  3618: _anon_z05_85:
                            	  3619:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3620:     ; between the ladder and Link.
                            	  3621:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3622:     ;
02:00041D00 102C0084        	  3623:     move.b  ($0084,A4),D0
02:00041D04 023C00EE        	  3624:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D08 123C0003        	  3625:     move.b  #$03,D1
02:00041D0C D101            	  3626:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D0E 41EC0084        	  3627:     lea     ($0084,A4),A0
02:00041D12 12302000        	  3628:     move.b  (A0,D2.W),D1
02:00041D16 B001            	  3629:     cmp.b   D1,D0
02:00041D18 6648            	  3630:     bne  _L_z05_CheckLadder_StashLadder
02:00041D1A 102C0070        	  3631:     move.b  ($0070,A4),D0
02:00041D1E 003C0011        	  3632:     ori     #$11,CCR  ; SEC: set C+X
02:00041D22 12342070        	  3633:     move.b  ($70,A4,D2.W),D1
02:00041D26 0A3C0010        	  3634:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D2A 9101            	  3635:     subx.b  D1,D0   ; SBC ObjX,X
02:00041D2C 0A3C0010        	  3636:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3637:     even
                            	  3638: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3639:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3640:     ; If > $10, go put the ladder away.
                            	  3641:     ;
02:00041D30 4EB900030CE8    	  3642:     jsr     Abs
02:00041D36 1880            	  3643:     move.b  D0,($0000,A4)
02:00041D38 0C000010        	  3644:     cmpi.b  #$10,D0
02:00041D3C 6532            	  3645:     bcs  _L_z05_CheckLadder_SetState2
02:00041D3E 0C000010        	  3646:     cmpi.b  #$10,D0
02:00041D42 661E            	  3647:     bne  _L_z05_CheckLadder_StashLadder
                            	  3648:     ; Distance = $10. If player's not facing in the same direction as
                            	  3649:     ; the ladder, go put away the ladder.
                            	  3650:     ;
02:00041D44 102C0098        	  3651:     move.b  ($0098,A4),D0
02:00041D48 41EC0098        	  3652:     lea     ($0098,A4),A0
02:00041D4C 12302000        	  3653:     move.b  (A0,D2.W),D1
02:00041D50 B001            	  3654:     cmp.b   D1,D0
02:00041D52 660E            	  3655:     bne  _L_z05_CheckLadder_StashLadder
                            	  3656:     ; Distance = $10, and player's facing in the same direction.
                            	  3657:     ;
                            	  3658:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3659:     ; ladder and had not stepped onto it yet.
                            	  3660:     ; Go handle movement on it, but don't change state yet.
                            	  3661:     ;
                            	  3662:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3663:     ; off of the ladder. So the ladder should be put away. In this
                            	  3664:     ; case, fall thru.
                            	  3665:     ;
02:00041D54 41EC00AC        	  3666:     lea     ($00AC,A4),A0
02:00041D58 10302000        	  3667:     move.b  (A0,D2.W),D0
02:00041D5C 0C000001        	  3668:     cmpi.b  #$01,D0
02:00041D60 6718            	  3669:     beq  _L_z05_CheckLadder_HandleInput
                            	  3670:     even
                            	  3671: _L_z05_CheckLadder_StashLadder:
                            	  3672:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3673:     ;
02:00041D62 7000            	  3674:     moveq   #0,D0
02:00041D64 19400064        	  3675:     move.b  D0,($0064,A4)
02:00041D68 4EB90004D59C    	  3676:     jsr     DestroyMonster
                            	  3677:     even
                            	  3678: _L_z05_CheckLadder_Exit:
02:00041D6E 4E75            	  3679:     rts
                            	  3680: 
                            	  3681:     even
                            	  3682: _L_z05_CheckLadder_SetState2:
                            	  3683:     ;  Set state 2, because we're on the ladder.
                            	  3684:     ;
02:00041D70 7002            	  3685:     moveq   #2,D0
02:00041D72 41EC00AC        	  3686:     lea     ($00AC,A4),A0
02:00041D76 11802000        	  3687:     move.b  D0,(A0,D2.W)
                            	  3688:     even
                            	  3689: _L_z05_CheckLadder_HandleInput:
                            	  3690:     ; If input direction = 0, go draw and reset moving direction.
                            	  3691:     ;
02:00041D7A 102C03F8        	  3692:     move.b  ($03F8,A4),D0
02:00041D7E 67000086        	  3693:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3694:     ; Input direction <> 0. The player intends to move.
                            	  3695:     ; So, see if we need to override the moving direction.
                            	  3696:     ;
                            	  3697:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3698:     ; go draw and set moving direction to Link's direction.
                            	  3699:     ;
                            	  3700:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3701:     ; been blocked by the water.
                            	  3702:     ;
                            	  3703:     ; Or, Link already passed over the point right over the ladder
                            	  3704:     ; and was allowed to move onto the tiles after the ladder.
                            	  3705:     ;
02:00041D82 102C0098        	  3706:     move.b  ($0098,A4),D0
02:00041D86 7600            	  3707:     moveq   #0,D3
02:00041D88 1614            	  3708:     move.b  ($0000,A4),D3
02:00041D8A 670C            	  3709:     beq  _anon_z05_86
02:00041D8C 41EC0098        	  3710:     lea     ($0098,A4),A0
02:00041D90 12302000        	  3711:     move.b  (A0,D2.W),D1
02:00041D94 B001            	  3712:     cmp.b   D1,D0
02:00041D96 676E            	  3713:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3714: _anon_z05_86:
                            	  3715:     ; Distance = 0, or facing different directions.
                            	  3716:     ;
                            	  3717:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3718:     ; then go draw and keep moving.
                            	  3719:     ;
                            	  3720:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3721:     ;
                            	  3722:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3723:     ; to move onto the tiles after the ladder.
                            	  3724:     ;
                            	  3725:     ; Note that if Link is not moving, then this test will fail,
                            	  3726:     ; and case (D) will catch it.
                            	  3727:     ;
02:00041D98 41EC0098        	  3728:     lea     ($0098,A4),A0
02:00041D9C 10302000        	  3729:     move.b  (A0,D2.W),D0
02:00041DA0 122C000F        	  3730:     move.b  ($000F,A4),D1
02:00041DA4 B001            	  3731:     cmp.b   D1,D0
02:00041DA6 675E            	  3732:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3733:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3734:     ; then go draw and move in ladder's direction.
                            	  3735:     ;
                            	  3736:     ; You can always step off the ladder where you came from.
                            	  3737:     ;
02:00041DA8 4EB900030CE4    	  3738:     jsr     GetOppositeDir
02:00041DAE 122C0098        	  3739:     move.b  ($0098,A4),D1
02:00041DB2 B001            	  3740:     cmp.b   D1,D0
02:00041DB4 6750            	  3741:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3742:     ; D. If opposite of ladder's direction <> down,
                            	  3743:     ; or input direction <> up,
                            	  3744:     ; then go reset moving direction, and draw.
                            	  3745:     ;
                            	  3746:     ; This will catch all cases of Link facing perpendicular to
                            	  3747:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3748:     ; ladder direction is up and input direction is up (E).
                            	  3749:     ;
02:00041DB6 0C000004        	  3750:     cmpi.b  #$04,D0
02:00041DBA 6648            	  3751:     bne  _anon_z05_87
02:00041DBC 102C03F8        	  3752:     move.b  ($03F8,A4),D0
02:00041DC0 0C000008        	  3753:     cmpi.b  #$08,D0
02:00041DC4 663E            	  3754:     bne  _anon_z05_87
                            	  3755:     ; E. The ladder's direction is up and input direction is up.
                            	  3756:     ;
                            	  3757:     ; An earlier call to check tile collision would have blocked
                            	  3758:     ; movement, because the tile under Link's top half is a water tile.
                            	  3759:     ; But because Link is squarely on the ladder, we really have
                            	  3760:     ; to check the tile above that one.
                            	  3761:     ;
                            	  3762:     ; Set moving direction to input direction (up) and switch X to
                            	  3763:     ; the player's slot for the purpose of checking tile collision below.
                            	  3764:     ; Based on that, we'll set moving direction according to walkability.
                            	  3765:     ;
02:00041DC6 6158            	  3766:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3767:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3768:     ;
02:00041DC8 102C0084        	  3769:     move.b  ($0084,A4),D0
02:00041DCC 1B00            	  3770:     move.b  D0,-(A5)  ; PHA
02:00041DCE 003C0011        	  3771:     ori     #$11,CCR  ; SEC: set C+X
02:00041DD2 123C0008        	  3772:     move.b  #$08,D1
02:00041DD6 0A3C0010        	  3773:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DDA 9101            	  3774:     subx.b  D1,D0   ; SBC #$08
02:00041DDC 0A3C0010        	  3775:     eori    #$10,CCR  ; restore X = 6502 C
02:00041DE0 19400084        	  3776:     move.b  D0,($0084,A4)
02:00041DE4 4EB90004B6C8    	  3777:     jsr     GetCollidingTileMoving
02:00041DEA 101D            	  3778:     move.b  (A5)+,D0  ; PLA
02:00041DEC 19400084        	  3779:     move.b  D0,($0084,A4)
                            	  3780:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3781:     ; direction as the input direction (in a roundabout way).
                            	  3782:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3783:     ;
02:00041DF0 102C000F        	  3784:     move.b  ($000F,A4),D0
02:00041DF4 7600            	  3785:     moveq   #0,D3
02:00041DF6 162C049E        	  3786:     move.b  ($049E,A4),D3
02:00041DFA 122C034A        	  3787:     move.b  ($034A,A4),D1
02:00041DFE B601            	  3788:     cmp.b   D1,D3
02:00041E00 6500FF78        	  3789:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3790: _anon_z05_87:
                            	  3791:     ; Set A to reset moving direction in [0F].
                            	  3792:     ;
02:00041E04 7000            	  3793:     moveq   #0,D0
                            	  3794:     even
                            	  3795: _L_z05_CheckLadder_DrawLadder:
                            	  3796:     ; Draw the ladder.
                            	  3797:     ;
02:00041E06 1B00            	  3798:     move.b  D0,-(A5)  ; PHA
02:00041E08 7400            	  3799:     moveq   #0,D2
02:00041E0A 142C0064        	  3800:     move.b  ($0064,A4),D2
02:00041E0E 4EB90004CDB8    	  3801:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041E14 760C            	  3802:     moveq   #12,D3
02:00041E16 7000            	  3803:     moveq   #0,D0
02:00041E18 4EB900031A3C    	  3804:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041E1E 101D            	  3805:     move.b  (A5)+,D0  ; PLA
                            	  3806: ; Params:
                            	  3807: ; A: direction
                            	  3808: ;
                            	  3809: ; Returns:
                            	  3810: ; [0F]: direction
                            	  3811: ;
                            	  3812:     even
                            	  3813: SetMovingDirAndSwitchToPlayerSlot:
02:00041E20 4EF90002C048    	  3814:     jmp     c_set_moving_dir_switch_player
                            	  3815: 
                            	  3816: FindNextEdgeSpawnCell:
                            	  3817:     ; Load [0A] with the value before the call.
                            	  3818:     ;
02:00041E26 102C0525        	  3819:     move.b  ($0525,A4),D0
02:00041E2A 1940000A        	  3820:     move.b  D0,($000A,A4)
                            	  3821:     even
                            	  3822: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3823:     ; Loop to look for a place to spawn a monster from the edge
                            	  3824:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3825:     ;
                            	  3826:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3827:     ; We'll move down $10 pixels.
                            	  3828:     ;
02:00041E2E 7610            	  3829:     moveq   #16,D3
02:00041E30 102C000A        	  3830:     move.b  ($000A,A4),D0
02:00041E34 0200000F        	  3831:     andi.b #$0F,D0
02:00041E38 670A            	  3832:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3833:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3834:     ; Don't move vertically.
                            	  3835:     ;
02:00041E3A 163C00F0        	  3836:     move.b  #$F0,D3
02:00041E3E 0C00000F        	  3837:     cmpi.b  #$0F,D0
02:00041E42 6610            	  3838:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3839:     even
                            	  3840: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3841:     ; Else low nibble = $F. We're at the right edge,
