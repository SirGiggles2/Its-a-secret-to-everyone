02:000303FA 19400001        	  2938:     move.b  D0,($0001,A4)
                            	  2939:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2940:     ;
02:000303FE 7605            	  2941:     moveq   #5,D3
                            	  2942:     ; The individual trap objects to make will be of type $49.
                            	  2943:     ; Store it in [00].
