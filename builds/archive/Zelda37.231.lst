02:0003EC2A 19802070        	 11691:     move.b  D0,($70,A4,D2.W)
                            	 11692:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11693:     ; to store in [03].
                            	 11694:     ;
02:0003EC2E 102C04E6        	 11695:     move.b  ($04E6,A4),D0
