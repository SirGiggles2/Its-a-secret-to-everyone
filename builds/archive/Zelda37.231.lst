                            	  4165: 
                            	  4166: ; Params:
                            	  4167: ; [0F]: moving direction
                            	  4168: ;
                            	  4169: ; Returns:
                            	  4170: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4171: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4172: ;
                            	  4173: ; When not at or in a doorway, this function leaves
                            	  4174: ; [0F] moving direction as is.
                            	  4175: ;
                            	  4176: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4177: ; will be left as is, assuming that it had been reset before this
                            	  4178: ; routine by BoundByRoom.
                            	  4179: ;
                            	  4180: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4181: ;
                            	  4182: ;
                            	  4183: ; If already in a doorway, go handle it separately.
                            	  4184: ;
                            	  4185:     even
