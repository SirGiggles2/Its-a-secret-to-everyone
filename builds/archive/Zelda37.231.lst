02:0003CB14 6406            	  7225:     bcc  _anon_z04_91
02:0003CB16 123C0008        	  7226:     move.b  #$08,D1
02:0003CB1A D101            	  7227:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7228: _anon_z04_91:
02:0003CB1C 1880            	  7229:     move.b  D0,($0000,A4)
                            	  7230:     ; Store (Y + 8) in [01].
                            	  7231:     ;
02:0003CB1E 41EC0084        	  7232:     lea     ($0084,A4),A0
02:0003CB22 10302000        	  7233:     move.b  (A0,D2.W),D0
02:0003CB26 123C0008        	  7234:     move.b  #$08,D1
02:0003CB2A D101            	  7235:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB2C 19400001        	  7236:     move.b  D0,($0001,A4)
                            	  7237:     ; Only check the first bomb slot ($10).
