02:0003ECB6 41EC04F0        	 11760:     lea     ($04F0,A4),A0
02:0003ECBA 10302000        	 11761:     move.b  (A0,D2.W),D0
02:0003ECBE 41EC04F1        	 11762:     lea     ($04F1,A4),A0
02:0003ECC2 11803000        	 11763:     move.b  D0,(A0,D3.W)
02:0003ECC6 10342070        	 11764:     move.b  ($70,A4,D2.W),D0
02:0003ECCA 19803071        	 11765:     move.b  D0,($71,A4,D3.W)
02:0003ECCE 41EC0084        	 11766:     lea     ($0084,A4),A0
02:0003ECD2 10302000        	 11767:     move.b  (A0,D2.W),D0
02:0003ECD6 41EC0085        	 11768:     lea     ($0085,A4),A0
02:0003ECDA 11803000        	 11769:     move.b  D0,(A0,D3.W)
