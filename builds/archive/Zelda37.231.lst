02:00031D04 1940034B        	  6414:     move.b  D0,($034B,A4)
02:00031D08 19400006        	  6415:     move.b  D0,($0006,A4)
02:00031D0C 19400009        	  6416:     move.b  D0,($0009,A4)
02:00031D10 1940000C        	  6417:     move.b  D0,($000C,A4)
