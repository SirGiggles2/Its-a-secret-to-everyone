                            	  8048:     ;
                            	  8049:     ; Calculate PPU address ($28E0 + Y*$20).
                            	  8050:     ;
02:00044C1E 7028            	  8051:     moveq   #40,D0
02:00044C20 19400302        	  8052:     move.b  D0,($0302,A4)
02:00044C24 103C00C0        	  8053:     move.b  #$C0,D0
                            	  8054:     even
