02:00043720 1214            	  5827:     move.b  ($00,A4),D1   ; ptr lo
02:00043722 182C0001        	  5828:     move.b  ($01,A4),D4  ; ptr hi
02:00043726 024100FF        	  5829:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004372A E14C            	  5830:     lsl.w   #8,D4
02:0004372C 8841            	  5831:     or.w    D1,D4
02:0004372E 48C4            	  5832:     ext.l   D4
02:00043730 D8BC00FF0000    	  5833:     add.l   #NES_RAM,D4
