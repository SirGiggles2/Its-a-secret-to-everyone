                            	  1988:     ; the coordinate we want within each coordinate list.
                            	  1989:     ;
                            	  1990:     ;
                            	  1991:     ; Pattern
02:0003A574 7600            	  1992:     moveq   #0,D3
02:0003A576 162C000B        	  1993:     move.b  ($000B,A4),D3
02:0003A57A 1002            	  1994:     move.b  D2,D0
