02:0003C6F6 5203            	  6657:     addq.b  #1,D3
02:0003C6F8 41EC0098        	  6658:     lea     ($0098,A4),A0
02:0003C6FC 11832000        	  6659:     move.b  D3,(A0,D2.W)
