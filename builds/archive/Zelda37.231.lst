                            	  7867: __far_z_04_0069:
                            	  7868:     ; Go to state 1.
                            	  7869:     ;
02:0003CF46 41EC00AC        	  7870:     lea     ($00AC,A4),A0
02:0003CF4A 52302000        	  7871:     addq.b  #1,(A0,D2.W)
                            	  7872:     ; Subtract 1 from facing direction to make an index.
                            	  7873:     ;
02:0003CF4E 7600            	  7874:     moveq   #0,D3
02:0003CF50 41EC0098        	  7875:     lea     ($0098,A4),A0
02:0003CF54 16302000        	  7876:     move.b  (A0,D2.W),D3
02:0003CF58 5303            	  7877:     subq.b  #1,D3
                            	  7878:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7879:     ;
02:0003CF5A 41EC0084        	  7880:     lea     ($0084,A4),A0
02:0003CF5E 10302000        	  7881:     move.b  (A0,D2.W),D0
02:0003CF62 0C000078        	  7882:     cmpi.b  #$78,D0
02:0003CF66 6402            	  7883:     bcc  _anon_z04_97
02:0003CF68 7603            	  7884:     moveq   #3,D3
                            	  7885: _anon_z04_97:
                            	  7886:     ; If Y coordinate >= $A8, make the index 7 for up.
