02:0003CEC4 10302000        	  7803:     move.b  (A0,D2.W),D0
02:0003CEC8 023C00EE        	  7804:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CECC 41F90003CE5C    	  7805:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CED2 12303000        	  7806:     move.b  (A0,D3.W),D1
02:0003CED6 D101            	  7807:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CED8 41EC0084        	  7808:     lea     ($0084,A4),A0
02:0003CEDC 11802000        	  7809:     move.b  D0,(A0,D2.W)
                            	  7810:     even
                            	  7811: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7812:     ; If the square the monster is over is walkable, then
                            	  7813:     ; go draw and check object collisions.
