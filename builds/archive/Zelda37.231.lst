                            	 13033: Ganon_CheckCollisions:
                            	 13034:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13035:     ; Store in [02] and [03].
                            	 13036:     ;
02:0003F5A4 10342070        	 13037:     move.b  ($70,A4,D2.W),D0
02:0003F5A8 023C00EE        	 13038:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5AC 123C0010        	 13039:     move.b  #$10,D1
02:0003F5B0 D101            	 13040:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5B2 19400002        	 13041:     move.b  D0,($0002,A4)
02:0003F5B6 41EC0084        	 13042:     lea     ($0084,A4),A0
02:0003F5BA 10302000        	 13043:     move.b  (A0,D2.W),D0
02:0003F5BE 023C00EE        	 13044:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5C2 123C0010        	 13045:     move.b  #$10,D1
02:0003F5C6 D101            	 13046:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5C8 19400003        	 13047:     move.b  D0,($0003,A4)
                            	 13048:     ; Check for a collision with Link.
                            	 13049:     ;
                            	 13050:     ; We can't call CheckLinkCollision, because we need to
                            	 13051:     ; customize Ganon's midpoint.
                            	 13052:     ;
                            	 13053:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13054:     ; detection, if Link is invincible. Initialize variables that will
                            	 13055:     ; be returned from the partial collision check routine. Then
                            	 13056:     ; call it.
                            	 13057:     ;
02:0003F5CC 102C04F0        	 13058:     move.b  ($04F0,A4),D0
02:0003F5D0 6616            	 13059:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F5D2 19400006        	 13060:     move.b  D0,($0006,A4)
02:0003F5D6 19400009        	 13061:     move.b  D0,($0009,A4)
02:0003F5DA 1940000C        	 13062:     move.b  D0,($000C,A4)
02:0003F5DE 7600            	 13063:     moveq   #0,D3
02:0003F5E0 1883            	 13064:     move.b  D3,($0000,A4)
02:0003F5E2 4EB900031D34    	 13065:     jsr     CheckLinkCollisionPreinit
                            	 13066:     even
                            	 13067: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13068:     ; If Ganon is not in state 0, then he's brown.
                            	 13069:     ; Go check collision with an arrow.
                            	 13070:     ;
02:0003F5E8 41EC00AC        	 13071:     lea     ($00AC,A4),A0
02:0003F5EC 10302000        	 13072:     move.b  (A0,D2.W),D0
02:0003F5F0 6652            	 13073:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13074:     ; If timer <> 0, then Ganon is visible.
                            	 13075:     ; He can't be harmed like this. So, return.
                            	 13076:     ;
02:0003F5F2 10342028        	 13077:     move.b  ($28,A4,D2.W),D0
02:0003F5F6 664A            	 13078:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F5F8 760D            	 13079:     moveq   #13,D3
02:0003F5FA 4EB9000321FE    	 13080:     jsr     CheckMonsterSwordCollision
                            	 13081:     ; If Ganon has died according to the usual collision check rules
                            	 13082:     ; (HP = 0), then:
                            	 13083:     ; 1. Restore HP to the initial value $F0
                            	 13084:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13085:     ; 3. Change palette row 7 to make Ganon brown
                            	 13086:     ;
02:0003F600 41EC0405        	 13087:     lea     ($0405,A4),A0
02:0003F604 10302000        	 13088:     move.b  (A0,D2.W),D0
02:0003F608 6718            	 13089:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F60A 103C00F0        	 13090:     move.b  #$F0,D0
02:0003F60E 41EC0485        	 13091:     lea     ($0485,A4),A0
02:0003F612 11802000        	 13092:     move.b  D0,(A0,D2.W)
02:0003F616 41EC00AC        	 13093:     lea     ($00AC,A4),A0
02:0003F61A 53302000        	 13094:     subq.b  #1,(A0,D2.W)
02:0003F61E 61000084        	 13095:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13096:     even
                            	 13097: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13098:     ; If Ganon was harmed, then play the sound effect
                            	 13099:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13100:     ;
02:0003F622 41EC04F0        	 13101:     lea     ($04F0,A4),A0
02:0003F626 10302000        	 13102:     move.b  (A0,D2.W),D0
02:0003F62A 670A            	 13103:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F62C 6100A250        	 13104:     jsr     PlayBossHitCryIfNeeded
02:0003F630 7040            	 13105:     moveq   #64,D0
02:0003F632 19802028        	 13106:     move.b  D0,($28,A4,D2.W)
                            	 13107:     even
                            	 13108: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13109:     ; Reset metastate, because Ganon cannot die this way.
                            	 13110:     ;
02:0003F636 4EB90004D5C0    	 13111:     jsr     ResetObjMetastate
                            	 13112:     ; Reset shove info and invincibility timer, because Ganon
                            	 13113:     ; doesn't react at all as a usual monster.
                            	 13114:     ;
02:0003F63C 4EB900032106    	 13115:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13116:     even
                            	 13117: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F642 4E75            	 13118:     rts
                            	 13119: 
                            	 13120:     even
                            	 13121: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13122:     ; If the silver arrow is not in the inventory, then return.
                            	 13123:     ;
02:0003F644 102C0659        	 13124:     move.b  ($0659,A4),D0
02:0003F648 0C000002        	 13125:     cmpi.b  #$02,D0
02:0003F64C 66F4            	 13126:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13127:     ; Reset the collision return value [06].
                            	 13128:     ;
02:0003F64E 7000            	 13129:     moveq   #0,D0
02:0003F650 19400006        	 13130:     move.b  D0,($0006,A4)
                            	 13131:     ; If there's no arrow in flight, then return.
                            	 13132:     ;
02:0003F654 7612            	 13133:     moveq   #18,D3
02:0003F656 41EC00AC        	 13134:     lea     ($00AC,A4),A0
02:0003F65A 10303000        	 13135:     move.b  (A0,D3.W),D0
02:0003F65E 0C000010        	 13136:     cmpi.b  #$10,D0
02:0003F662 66DE            	 13137:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13138:     ; Check for collision with an arrow; and return if no collision.
                            	 13139:     ;
02:0003F664 4EB90003225A    	 13140:     jsr     CheckMonsterArrowOrRodCollision
02:0003F66A 102C0006        	 13141:     move.b  ($0006,A4),D0
02:0003F66E 67D2            	 13142:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13143:     ; Set the Ganon phase to "dying".
                            	 13144:     ;
02:0003F670 41EC042C        	 13145:     lea     ($042C,A4),A0
02:0003F674 52302000        	 13146:     addq.b  #1,(A0,D2.W)
                            	 13147:     ; Now his body does flash.
                            	 13148:     ;
02:0003F678 7028            	 13149:     moveq   #40,D0
02:0003F67A 41EC04F0        	 13150:     lea     ($04F0,A4),A0
02:0003F67E 11802000        	 13151:     move.b  D0,(A0,D2.W)
                            	 13152:     ; Set initial cloud distance 8.
                            	 13153:     ;
02:0003F682 7008            	 13154:     moveq   #8,D0
02:0003F684 41EC0478        	 13155:     lea     ($0478,A4),A0
02:0003F688 11802000        	 13156:     move.b  D0,(A0,D2.W)
02:0003F68C 0A3C0001        	 13157:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F690 4E75            	 13158:     rts
                            	 13159: 
