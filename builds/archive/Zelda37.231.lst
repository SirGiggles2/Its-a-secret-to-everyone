                            	  6109: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6110:     ; Store the weapon's frame (horizontal or vertical)
                            	  6111:     ; for the direction chosen above in [0C].
                            	  6112:     ;
02:0004C840 4EB900030CE4    	  6113:     jsr     GetOppositeDir
