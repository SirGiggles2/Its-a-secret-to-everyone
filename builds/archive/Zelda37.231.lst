02:0002E508 7602            	   836:     moveq   #2,D3
02:0002E50A 0C0000C0        	   837:     cmpi.b  #$C0,D0
02:0002E50E 670A            	   838:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E510 5303            	   839:     subq.b  #1,D3
02:0002E512 0C000040        	   840:     cmpi.b  #$40,D0
