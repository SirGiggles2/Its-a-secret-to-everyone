02:0003A55E 7600            	  1978:     moveq   #0,D3
02:0003A560 1600            	  1979:     move.b  D0,D3
02:0003A562 41F90003A4BE    	  1980:     lea     (StatueFireballStartTimes).l,A0
02:0003A568 10303000        	  1981:     move.b  (A0,D3.W),D0
02:0003A56C 41EC04E8        	  1982:     lea     ($04E8,A4),A0
