                            	  7382:     ; the height of each row.
                            	  7383:     ;
02:000444AC 003C0011        	  7384:     ori     #$11,CCR  ; SEC: set C+X
02:000444B0 123C0040        	  7385:     move.b  #$40,D1
02:000444B4 0A3C0010        	  7386:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000444B8 9101            	  7387:     subx.b  D1,D0   ; SBC #$40
02:000444BA 0A3C0010        	  7388:     eori    #$10,CCR  ; restore X = 6502 C
02:000444BE E208            	  7389:     lsr.b  #1,D0   ; LSR A
02:000444C0 E208            	  7390:     lsr.b  #1,D0   ; LSR A
02:000444C2 E208            	  7391:     lsr.b  #1,D0   ; LSR A
                            	  7392:     ; Add this row offset to the column address.
                            	  7393:     ;
02:000444C4 4EB90003113A    	  7394:     jsr     AddToInt16At0
                            	  7395:     ; Assume that we'll write a type 1 square with primary square
                            	  7396:     ; taken from [05]. If so, the square index doesn't matter
                            	  7397:     ; as long as >= $10. See WriteSquareOW.
                            	  7398:     ;
02:000444CA 7600            	  7399:     moveq   #0,D3
02:000444CC 7410            	  7400:     moveq   #16,D2
02:000444CE 102C0005        	  7401:     move.b  ($0005,A4),D0
                            	  7402:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7403:     ; So, we have to look up the square index corresponding
