                            	  5983:     ;
02:0004382C 7630            	  5984:     moveq   #48,D3
02:0004382E 19430028        	  5985:     move.b  D3,($0028,A4)
                            	  5986: _anon_z05_119:
02:00043832 02000003        	  5987:     andi.b #$03,D0
02:00043836 003C0011        	  5988:     ori     #$11,CCR  ; SEC: set C+X
02:0004383A 123C0001        	  5989:     move.b  #$01,D1
02:0004383E 0A3C0010        	  5990:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043842 9101            	  5991:     subx.b  D1,D0   ; SBC #$01
02:00043844 0A3C0010        	  5992:     eori    #$10,CCR  ; restore X = 6502 C
02:00043848 02000002        	  5993:     andi.b #$02,D0
02:0004384C 19400008        	  5994:     move.b  D0,($0008,A4)
                            	  5995:     ; The command to close a key door or bombable wall does not
                            	  5996:     ; do anything.
                            	  5997:     ;
02:00043850 102C0054        	  5998:     move.b  ($0054,A4),D0
02:00043854 0C000005        	  5999:     cmpi.b  #$05,D0
02:00043858 6416            	  6000:     bcc  _anon_z05_120
02:0004385A 102C0055        	  6001:     move.b  ($0055,A4),D0
02:0004385E 19400002        	  6002:     move.b  D0,($0002,A4)
