02:00030E5E 67F4            	  4510:     beq  _anon_z01_52
                            	  4511:     ; Look in slot $10. If it's empty or there's a fire
                            	  4512:     ; (state = 0, or major state <> $10), then
                            	  4513:     ; go activate a bomb.
                            	  4514:     ;
02:00030E60 7410            	  4515:     moveq   #16,D2
02:00030E62 41EC00AC        	  4516:     lea     ($00AC,A4),A0
02:00030E66 10302000        	  4517:     move.b  (A0,D2.W),D0
02:00030E6A 6724            	  4518:     beq  _L_z01_WieldBomb_FoundSlot
02:00030E6C 020000F0        	  4519:     andi.b #$F0,D0
02:00030E70 0C000010        	  4520:     cmpi.b  #$10,D0
02:00030E74 661A            	  4521:     bne  _L_z01_WieldBomb_FoundSlot
                            	  4522:     ; Else look at slot $11.
                            	  4523:     ; If there's a bomb there (major state = $10), then return.
                            	  4524:     ;
02:00030E76 5202            	  4525:     addq.b  #1,D2
02:00030E78 41EC00AC        	  4526:     lea     ($00AC,A4),A0
02:00030E7C 10302000        	  4527:     move.b  (A0,D2.W),D0
02:00030E80 670E            	  4528:     beq  _L_z01_WieldBomb_FoundSlot
02:00030E82 020000F0        	  4529:     andi.b #$F0,D0
02:00030E86 0C000010        	  4530:     cmpi.b  #$10,D0
02:00030E8A 6604            	  4531:     bne.s  __far_z_01_0028
02:00030E8C 60000080        	  4532:     jmp  L69AB_Exit
                            	  4533: __far_z_01_0028:
                            	  4534:     even
                            	  4535: _L_z01_WieldBomb_FoundSlot:
                            	  4536:     ; We found a slot that's empty or has a fire. It could be $10 or $11.
                            	  4537:     ; If the other slot has a bomb that's not yet detonating (state < $13),
                            	  4538:     ; then return.
                            	  4539:     ;
02:00030E90 1002            	  4540:     move.b  D2,D0
02:00030E92 0A000001        	  4541:     eori.b #$01,D0
02:00030E96 7600            	  4542:     moveq   #0,D3
02:00030E98 1600            	  4543:     move.b  D0,D3
02:00030E9A 41EC00AC        	  4544:     lea     ($00AC,A4),A0
02:00030E9E 10303000        	  4545:     move.b  (A0,D3.W),D0
02:00030EA2 6708            	  4546:     beq  _L_z01_WieldBomb_Activate
02:00030EA4 0C000013        	  4547:     cmpi.b  #$13,D0
