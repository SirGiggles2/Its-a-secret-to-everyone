02:0004446A 1002            	  7347:     move.b  D2,D0
02:0004446C 1B00            	  7348:     move.b  D0,-(A5)  ; PHA
                            	  7349:     ; We're dealing with squares.
                            	  7350:     ; So, align the object's X coordinate with 16 pixels.
                            	  7351:     ;
02:0004446E 10342070        	  7352:     move.b  ($70,A4,D2.W),D0
02:00044472 020000F0        	  7353:     andi.b #$F0,D0
                            	  7354:     ; Divide it by 4 to get the offset of the address of the column
                            	  7355:     ; in play area map.
                            	  7356:     ;
                            	  7357:     ; The calculation is: address offset = (X / 8) * 2
                            	  7358:     ; 8 for the width of the column; 2 for the width of the address
                            	  7359:     ;
02:00044476 E208            	  7360:     lsr.b  #1,D0   ; LSR A
02:00044478 E208            	  7361:     lsr.b  #1,D0   ; LSR A
