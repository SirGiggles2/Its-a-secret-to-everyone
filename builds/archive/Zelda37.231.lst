                            	  7367: DodongoBombNegativeLimits:
02:0003CBEE F4              	  7368:     dc.b    $F4, $F0
02:0003CBEF F0
                            	  7369: 
                            	  7370: ; Params:
                            	  7371: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7372: ; [00]: monster hotspot X
                            	  7373: ; [01]: monster hotspot Y
                            	  7374: ; [02]: bomb hotspot X
                            	  7375: ; [03]: bomb hotspot Y
                            	  7376: ;
                            	  7377: ; Returns:
                            	  7378: ; A: 0 if the bomb is in range of the monster
                            	  7379: ; Z: 1 if the bomb is in range of the monster
                            	  7380: ; [04]: horizontal distance
                            	  7381: ; [05]: vertical distance
                            	  7382: ;
                            	  7383: ; Store the positive limit in [06], and the negative one in [07].
                            	  7384: ;
                            	  7385:     even
                            	  7386: Dodongo_IsBombInRange:
02:0003CBF0 41F90003CBEC    	  7387:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBF6 10303000        	  7388:     move.b  (A0,D3.W),D0
02:0003CBFA 19400006        	  7389:     move.b  D0,($0006,A4)
02:0003CBFE 41F90003CBEE    	  7390:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CC04 10303000        	  7391:     move.b  (A0,D3.W),D0
02:0003CC08 19400007        	  7392:     move.b  D0,($0007,A4)
                            	  7393:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7394:     ; the bomb is near enough the monster.
                            	  7395:     ;
02:0003CC0C 7003            	  7396:     moveq   #3,D0
02:0003CC0E 19400008        	  7397:     move.b  D0,($0008,A4)
                            	  7398:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7399:     ;
02:0003CC12 7601            	  7400:     moveq   #1,D3
                            	  7401:     even
                            	  7402: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7403:     ; Subtract the bomb's coordinate from the boss's,
                            	  7404:     ; The loop index determines the coordinate.
                            	  7405:     ;
02:0003CC14 10343000        	  7406:     move.b  ($00,A4,D3.W),D0
02:0003CC18 003C0011        	  7407:     ori     #$11,CCR  ; SEC: set C+X
02:0003CC1C 12343002        	  7408:     move.b  ($02,A4,D3.W),D1
02:0003CC20 0A3C0010        	  7409:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CC24 9101            	  7410:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CC26 0A3C0010        	  7411:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7412:     ; If the distance >= positive offset, or < negative offset;
                            	  7413:     ; then loop again.
                            	  7414:     ;
02:0003CC2A 122C0006        	  7415:     move.b  ($0006,A4),D1
02:0003CC2E B001            	  7416:     cmp.b   D1,D0
02:0003CC30 6A16            	  7417:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CC32 122C0007        	  7418:     move.b  ($0007,A4),D1
02:0003CC36 B001            	  7419:     cmp.b   D1,D0
02:0003CC38 6B0E            	  7420:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7421:     ; The distance is close enough in this axis.
                            	  7422:     ;
                            	  7423:     ; Store the distance in this axis in [05] or [04],
                            	  7424:     ; depending on the loop index.
                            	  7425:     ;
02:0003CC3A 19803004        	  7426:     move.b  D0,($04,A4,D3.W)
                            	  7427:     ; Shift [08] right, because we're in range in this axis.
                            	  7428:     ;
02:0003CC3E 122C0008        	  7429:     move.b  ($0008,A4),D1
02:0003CC42 E209            	  7430:     lsr.b  #1,D1   ; LSR $08
02:0003CC44 19410008        	  7431:     move.b  D1,($0008,A4)
                            	  7432:     even
                            	  7433: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC48 5303            	  7434:     subq.b  #1,D3
02:0003CC4A 6AC8            	  7435:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7436:     ; If close enough in both axes, then [08] will be 0.
                            	  7437:     ;
02:0003CC4C 102C0008        	  7438:     move.b  ($0008,A4),D0
02:0003CC50 4E75            	  7439:     rts
                            	  7440: 
                            	  7441: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7442: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7443: ;
                            	  7444: ; But these are not typical direction indexes. Instead a
                            	  7445: ; 5-way index is used.
                            	  7446: ; A direction shifted right once becomes a 5-way index.
                            	  7447: ; The fourth element is unused.
                            	  7448: ;
                            	  7449:     even
                            	  7450: DodongoFrameImages:
02:0003CC52 00              	  7451:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
