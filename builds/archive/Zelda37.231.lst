                            	  2766: _L_z02_ModeEandF_WriteCharBoardCursorSpritePosition_WriteCursorCoords:
02:00034FE6 102C0085        	  2767:     move.b  ($0085,A4),D0
02:00034FEA 610E            	  2768:     jsr     ModifyFlashingCursorY
02:00034FEC 19430208        	  2769:     move.b  D3,($0208,A4)
02:00034FF0 102C0071        	  2770:     move.b  ($0071,A4),D0
02:00034FF4 1940020B        	  2771:     move.b  D0,($020B,A4)
02:00034FF8 4E75            	  2772:     rts
                            	  2773: 
                            	  2774: ; Params:
                            	  2775: ; A: cursor Y
                            	  2776: ;
                            	  2777: ; Returns:
                            	  2778: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2779: ;
                            	  2780: ; Description:
                            	  2781: ; Adjust the Y coordinate to account for the visible part of
                            	  2782: ; block cursor being in the bottom half of sprite.
                            	  2783: ; Also, make the cursor flash.
                            	  2784: ;
                            	  2785:     even
                            	  2786: ModifyFlashingCursorY:
02:00034FFA 003C0011        	  2787:     ori     #$11,CCR  ; SEC: set C+X
02:00034FFE 123C0008        	  2788:     move.b  #$08,D1
