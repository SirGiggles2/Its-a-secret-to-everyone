                            	 10951: __far_z_04_0102:
                            	 10952:     ; The segment is not a head nor bottom. So, we can use a
                            	 10953:     ; standard routine to draw. It uses one of the rolling sprites
                            	 10954:     ; that is drawn under Link and the heads.
                            	 10955:     ;
02:0003E688 4EB900031B2E    	 10956:     jsr     Anim_WriteLevelPaletteSprite
                            	 10957:     even
                            	 10958: Gleeok_CheckCollisions:
                            	 10959:     ; If this segment is not the head nor the bottom of the neck,
                            	 10960:     ; then loop again to process the next segment.
                            	 10961:     ;
                            	 10962:     ; This kind of segment is only drawn, and is not checked
                            	 10963:     ; for object collisions.
                            	 10964:     ;
02:0003E68E 0C020005        	 10965:     cmpi.b  #$05,D2
02:0003E692 670A            	 10966:     beq  _anon_z04_141
02:0003E694 0C020001        	 10967:     cmpi.b  #$01,D2
02:0003E698 6704            	 10968:     beq  _anon_z04_141
02:0003E69A 6000010C        	 10969:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10970: 
                            	 10971: _anon_z04_141:
02:0003E69E 4EB900031BB4    	 10972:     jsr     CheckMonsterCollisions
                            	 10973:     ; If this segment was harmed, then set the writhing counter,
                            	 10974:     ; and the animation counter to its lower value.
                            	 10975:     ;
02:0003E6A4 41EC00C0        	 10976:     lea     ($00C0,A4),A0
02:0003E6A8 10302000        	 10977:     move.b  (A0,D2.W),D0
02:0003E6AC 670A            	 10978:     beq  _anon_z04_142
02:0003E6AE 7006            	 10979:     moveq   #6,D0
02:0003E6B0 194004E6        	 10980:     move.b  D0,($04E6,A4)
02:0003E6B4 19400510        	 10981:     move.b  D0,($0510,A4)
                            	 10982: _anon_z04_142:
02:0003E6B8 4EB90004B73C    	 10983:     jsr     ResetShoveInfo
                            	 10984:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 10985:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 10986:     ;
02:0003E6BE 0C020001        	 10987:     cmpi.b  #$01,D2
02:0003E6C2 670000DE        	 10988:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E6C6 6100B1B6        	 10989:     jsr     PlayBossHitCryIfNeeded
                            	 10990:     ; If this neck has not died, then go loop again.
                            	 10991:     ;
02:0003E6CA 41EC0405        	 10992:     lea     ($0405,A4),A0
02:0003E6CE 10302000        	 10993:     move.b  (A0,D2.W),D0
02:0003E6D2 670000D4        	 10994:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10995:     ; This neck died. So, prepare to make a flying head.
                            	 10996:     ;
02:0003E6D6 7060            	 10997:     moveq   #96,D0
02:0003E6D8 41EC0485        	 10998:     lea     ($0485,A4),A0
02:0003E6DC 11802000        	 10999:     move.b  D0,(A0,D2.W)
02:0003E6E0 1002            	 11000:     move.b  D2,D0
02:0003E6E2 1B00            	 11001:     move.b  D0,-(A5)  ; PHA
                            	 11002:     ; If the segment is not a head, then skip making a flying head.
                            	 11003:     ;
                            	 11004:     ; TODO:
                            	 11005:     ; But how can we get here in this case, since earlier branches
                            	 11006:     ; would have been taken to skip all this for all other segments?
                            	 11007:     ;
02:0003E6E4 0C020005        	 11008:     cmpi.b  #$05,D2
02:0003E6E8 663C            	 11009:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11010:     ; The flying head will go in slot (neck index + 7).
                            	 11011:     ; Switch the X register to it.
                            	 11012:     ;
02:0003E6EA 102C04D7        	 11013:     move.b  ($04D7,A4),D0
02:0003E6EE 023C00EE        	 11014:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6F2 123C0007        	 11015:     move.b  #$07,D1
02:0003E6F6 D101            	 11016:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E6F8 7400            	 11017:     moveq   #0,D2
02:0003E6FA 1400            	 11018:     move.b  D0,D2
                            	 11019:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11020:     ;
02:0003E6FC 103C00FF        	 11021:     move.b  #$FF,D0
02:0003E700 41EC0492        	 11022:     lea     ($0492,A4),A0
02:0003E704 11802000        	 11023:     move.b  D0,(A0,D2.W)
                            	 11024:     ; Copy the original head's coordinates to it.
                            	 11025:     ;
02:0003E708 102C0075        	 11026:     move.b  ($0075,A4),D0
02:0003E70C 19802070        	 11027:     move.b  D0,($70,A4,D2.W)
02:0003E710 102C0089        	 11028:     move.b  ($0089,A4),D0
02:0003E714 41EC0084        	 11029:     lea     ($0084,A4),A0
02:0003E718 11802000        	 11030:     move.b  D0,(A0,D2.W)
                            	 11031:     ; Set object type $46 (flying head).
                            	 11032:     ;
02:0003E71C 7046            	 11033:     moveq   #70,D0
02:0003E71E 41EC034F        	 11034:     lea     ($034F,A4),A0
02:0003E722 11802000        	 11035:     move.b  D0,(A0,D2.W)
                            	 11036:     even
                            	 11037: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E726 101D            	 11038:     move.b  (A5)+,D0  ; PLA
02:0003E728 7400            	 11039:     moveq   #0,D2
02:0003E72A 1400            	 11040:     move.b  D0,D2
                            	 11041:     ; Hide the original head's sprite, and the base segment's sprite.
