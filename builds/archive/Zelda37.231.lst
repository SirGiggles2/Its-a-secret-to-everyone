                            	 10007: Gohma_AnimateAndDraw:
02:0003DF88 1B00            	 10008:     move.b  D0,-(A5)  ; PHA
02:0003DF8A 4EB90004CDB8    	 10009:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003DF90 6164            	 10010:     jsr     Gohma_SetSpriteAttributes
02:0003DF92 101D            	 10011:     move.b  (A5)+,D0  ; PLA
02:0003DF94 4EB900031834    	 10012:     jsr     DrawObjectMirrored
02:0003DF9A 7010            	 10013:     moveq   #16,D0
02:0003DF9C 4EB90004CDB2    	 10014:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10015:     ; Draw the right legs.
                            	 10016:     ;
02:0003DFA2 7601            	 10017:     moveq   #1,D3
02:0003DFA4 6102            	 10018:     jsr     Gohma_DrawLegsOneSide
                            	 10019:     ; Draw the left legs.
                            	 10020:     ;
02:0003DFA6 7600            	 10021:     moveq   #0,D3
                            	 10022: ; Params:
                            	 10023: ; Y: side: 0 for left, 1 for right
                            	 10024: ;
                            	 10025: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10026: ; store the sprite's X in [00].
                            	 10027: ;
                            	 10028:     even
                            	 10029: Gohma_DrawLegsOneSide:
02:0003DFA8 10342070        	 10030:     move.b  ($70,A4,D2.W),D0
02:0003DFAC 023C00EE        	 10031:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFB0 41F90003DF86    	 10032:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFB6 12303000        	 10033:     move.b  (A0,D3.W),D1
02:0003DFBA D101            	 10034:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DFBC 1880            	 10035:     move.b  D0,($0000,A4)
                            	 10036:     ; The object's Y is the sprite's.
                            	 10037:     ;
02:0003DFBE 41EC0084        	 10038:     lea     ($0084,A4),A0
02:0003DFC2 10302000        	 10039:     move.b  (A0,D2.W),D0
02:0003DFC6 19400001        	 10040:     move.b  D0,($0001,A4)
02:0003DFCA 612A            	 10041:     jsr     Gohma_SetSpriteAttributes
                            	 10042:     ; There are only two frame images for legs: left and right.
                            	 10043:     ; There are two animation frames. They are animated as follows:
                            	 10044:     ;
                            	 10045:     ; Frame 0:
                            	 10046:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10047:     ; horizontal flipping = frame number = 0
                            	 10048:     ; 
                            	 10049:     ; Frame 1:
                            	 10050:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10051:     ; horizontal flipping = frame number = 1
                            	 10052:     ;
02:0003DFCC 4EB90004CD8A    	 10053:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFD2 1003            	 10054:     move.b  D3,D0
02:0003DFD4 023C00EE        	 10055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFD8 41EC03E4        	 10056:     lea     ($03E4,A4),A0
02:0003DFDC 12302000        	 10057:     move.b  (A0,D2.W),D1
02:0003DFE0 D101            	 10058:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003DFE2 02000001        	 10059:     andi.b #$01,D0
02:0003DFE6 023C00EE        	 10060:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFEA 123C0004        	 10061:     move.b  #$04,D1
02:0003DFEE D101            	 10062:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DFF0 4EF900031838    	 10063:     jmp     DrawObjectNotMirrored
                            	 10064: 
