02:00031D4C 41EC034F        	  6450:     lea     ($034F,A4),A0
02:00031D50 10302000        	  6451:     move.b  (A0,D2.W),D0
02:00031D54 0C000053        	  6452:     cmpi.b  #$53,D0
02:00031D58 6516            	  6453:     bcs  _anon_z01_84
02:00031D5A 41EC00AC        	  6454:     lea     ($00AC,A4),A0
02:00031D5E 10302000        	  6455:     move.b  (A0,D2.W),D0
02:00031D62 020000F0        	  6456:     andi.b #$F0,D0
02:00031D66 0C000010        	  6457:     cmpi.b  #$10,D0
02:00031D6A 6704            	  6458:     beq.s  __far_z_01_0060
02:00031D6C 600000BC        	  6459:     jmp  L73A9_Exit
                            	  6460: __far_z_01_0060:
                            	  6461: _anon_z01_84:
                            	  6462:     ; Store Link's midpoint coordinates in [04] and [05].
                            	  6463:     ;
02:00031D70 102C0070        	  6464:     move.b  ($0070,A4),D0
02:00031D74 023C00EE        	  6465:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D78 123C0008        	  6466:     move.b  #$08,D1
02:00031D7C D101            	  6467:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031D7E 19400004        	  6468:     move.b  D0,($0004,A4)
02:00031D82 102C0084        	  6469:     move.b  ($0084,A4),D0
02:00031D86 023C00EE        	  6470:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D8A 123C0008        	  6471:     move.b  #$08,D1
02:00031D8E D101            	  6472:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031D90 19400005        	  6473:     move.b  D0,($0005,A4)
                            	  6474:     ; If both objects are 9 pixels apart or more, then return no collision.
                            	  6475:     ;
02:00031D94 7009            	  6476:     moveq   #9,D0
02:00031D96 610005EE        	  6477:     jsr     DoObjectsCollide
02:00031D9A 6604            	  6478:     bne.s  __far_z_01_0061
02:00031D9C 6000008C        	  6479:     jmp  L73A9_Exit
                            	  6480: __far_z_01_0061:
                            	  6481:     ; They collide. Now find out how they collide.
                            	  6482:     ;
                            	  6483:     ; If it's a regular monster, go harm Link.
                            	  6484:     ;
02:00031DA0 41EC034F        	  6485:     lea     ($034F,A4),A0
02:00031DA4 10302000        	  6486:     move.b  (A0,D2.W),D0
02:00031DA8 0C000053        	  6487:     cmpi.b  #$53,D0
02:00031DAC 6402            	  6488:     bcc.s  __far_z_01_0062
02:00031DAE 607C            	  6489:     jmp  HarmLink
                            	  6490: __far_z_01_0062:
                            	  6491:     ; Here, the attacker is a monster's shot/projectile.
                            	  6492:     ; Flag this kind of collision.
                            	  6493:     ;
02:00031DB0 522C034B        	  6494:     addq.b  #1,($034B,A4)
                            	  6495:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
                            	  6496:     ; then go harm Link.
                            	  6497:     ;
02:00031DB4 0C000056        	  6498:     cmpi.b  #$56,D0
02:00031DB8 6602            	  6499:     bne.s  __far_z_01_0063
02:00031DBA 6070            	  6500:     jmp  HarmLink
                            	  6501: __far_z_01_0063:
