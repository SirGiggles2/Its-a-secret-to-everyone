                            	  7987: Submenu_CueTransferRowUW:
                            	  7988:     ; If menu scroll value is negative, then we transferred everything.
                            	  7989:     ; So, return.
                            	  7990:     ;
02:00044BE6 102C005E        	  7991:     move.b  ($005E,A4),D0
02:00044BEA 6A02            	  7992:     bpl.s  __far_z_05_0104
02:00044BEC 602E            	  7993:     jmp  L1725A_Exit
                            	  7994: __far_z_05_0104:
                            	  7995:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7996:     ; and represents the current row of the submenu being processed.
                            	  7997:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7998:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7999:     ;
                            	  8000:     ; If the bottom bit is set, go prepare the full black row.
                            	  8001:     ;
02:00044BEE E208            	  8002:     lsr.b  #1,D0   ; LSR A
02:00044BF0 7600            	  8003:     moveq   #0,D3
02:00044BF2 1600            	  8004:     move.b  D0,D3
02:00044BF4 6402            	  8005:     bcc.s  __far_z_05_0105
02:00044BF6 6026            	  8006:     jmp  PrepFullBlackRow
                            	  8007: __far_z_05_0105:
                            	  8008:     ; Submenu rows $D to $15 are parts of the map.
                            	  8009:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8010:     ;
                            	  8011:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8012:     ; buffer for this row.
                            	  8013:     ;
02:00044BF8 0C00000D        	  8014:     cmpi.b  #$0D,D0
02:00044BFC 640C            	  8015:     bcc  _anon_z05_167
02:00044BFE 41F900044BC2    	  8016:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044C04 10303000        	  8017:     move.b  (A0,D3.W),D0
                            	  8018:     even
                            	  8019: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044C08 606E            	  8020:     jmp     SelectTransferBufAndDecCounter
                            	  8021: 
                            	  8022: _anon_z05_167:
                            	  8023:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  8024:     ; of the big map sheet.
                            	  8025:     ;
02:00044C0A 0C000015        	  8026:     cmpi.b  #$15,D0
02:00044C0E 6604            	  8027:     bne  _anon_z05_168
02:00044C10 7042            	  8028:     moveq   #66,D0
02:00044C12 60F4            	  8029:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8030: 
