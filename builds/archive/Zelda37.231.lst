02:0003EE42 102C0084        	 12000:     move.b  ($0084,A4),D0
02:0003EE46 003C0011        	 12001:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE4A 41EC0084        	 12002:     lea     ($0084,A4),A0
02:0003EE4E 12302000        	 12003:     move.b  (A0,D2.W),D1
02:0003EE52 0A3C0010        	 12004:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE56 9101            	 12005:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EE58 0A3C0010        	 12006:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE5C 640A            	 12007:     bcc  _anon_z04_154
02:0003EE5E 122C0003        	 12008:     move.b  ($0003,A4),D1
02:0003EE62 E309            	 12009:     lsl.b  #1,D1   ; ASL $03
02:0003EE64 19410003        	 12010:     move.b  D1,($0003,A4)
                            	 12011: _anon_z04_154:
                            	 12012:     ; If the horizontal direction toward Link is not allowed, then
                            	 12013:     ; go check the vertical direction.
                            	 12014:     ;
02:0003EE68 102C0002        	 12015:     move.b  ($0002,A4),D0
02:0003EE6C 122C050F        	 12016:     move.b  ($050F,A4),D1
