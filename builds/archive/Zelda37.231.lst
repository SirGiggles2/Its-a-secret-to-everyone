                            	 12037: Lamnola_Move:
                            	 12038:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12039:     ;
                            	 12040:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12041:     ;
                            	 12042:     ; Start with a mask of $A1 in [02]:
                            	 12043:     ; - low nibble represents the right direction
                            	 12044:     ; - high nibble is used to set or clear carry as we go along
                            	 12045:     ;
02:0003EE84 103C00A1        	 12046:     move.b  #$A1,D0
02:0003EE88 19400002        	 12047:     move.b  D0,($0002,A4)
                            	 12048:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12049:     ;
02:0003EE8C 41EC0098        	 12050:     lea     ($0098,A4),A0
02:0003EE90 10302000        	 12051:     move.b  (A0,D2.W),D0
02:0003EE94 122C0002        	 12052:     move.b  ($0002,A4),D1
02:0003EE98 C200            	 12053:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE9A 6712            	 12054:     beq  _L_z04_Lamnola_Move_Left
