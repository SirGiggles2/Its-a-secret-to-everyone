                            	  7665:     ;
02:000324D4 102C0008        	  7666:     move.b  ($0008,A4),D0
02:000324D8 00000080        	  7667:     ori.b #$80,D0
02:000324DC 41EC00C0        	  7668:     lea     ($00C0,A4),A0
02:000324E0 11802000        	  7669:     move.b  D0,(A0,D2.W)
                            	  7670:     ; Mark the monster invincible $10 frames, and should move $40 pixels.
                            	  7671:     ;
02:000324E4 7040            	  7672:     moveq   #64,D0
02:000324E6 41EC00D3        	  7673:     lea     ($00D3,A4),A0
02:000324EA 11802000        	  7674:     move.b  D0,(A0,D2.W)
02:000324EE 7010            	  7675:     moveq   #16,D0
02:000324F0 41EC04F0        	  7676:     lea     ($04F0,A4),A0
02:000324F4 11802000        	  7677:     move.b  D0,(A0,D2.W)
                            	  7678:     even
