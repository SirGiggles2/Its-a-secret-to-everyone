02:0003A552 0C0000F0        	  1972:     cmpi.b  #$F0,D0
02:0003A556 640000BC        	  1973:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1974:     ; Else choose one of four start times for the fireball based on
                            	  1975:     ; the random value.
                            	  1976:     ;
