02:0003ED22 02000007        	 11810:     andi.b #$07,D0
02:0003ED26 6702            	 11811:     beq.s  __far_z_04_0119
02:0003ED28 60D8            	 11812:     jmp  L12A6F_Exit
                            	 11813: __far_z_04_0119:
                            	 11814:     ; Will loop 4 times, propagating directions down the chain,
                            	 11815:     ; by pulling from the bottom.
                            	 11816:     ;
02:0003ED2A 7004            	 11817:     moveq   #4,D0
02:0003ED2C 1880            	 11818:     move.b  D0,($0000,A4)
                            	 11819:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11820:     ;
02:0003ED2E 7600            	 11821:     moveq   #0,D3
02:0003ED30 0C020005        	 11822:     cmpi.b  #$05,D2
02:0003ED34 6702            	 11823:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED36 7605            	 11824:     moveq   #5,D3
                            	 11825:     even
                            	 11826: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11827:     ; Loop over every segment under the head, starting from the tail.
                            	 11828:     ; Copy the next segment's direction to the current one in this loop.
                            	 11829:     ;
02:0003ED38 41EC009A        	 11830:     lea     ($009A,A4),A0
02:0003ED3C 10303000        	 11831:     move.b  (A0,D3.W),D0
02:0003ED40 41EC0099        	 11832:     lea     ($0099,A4),A0
02:0003ED44 11803000        	 11833:     move.b  D0,(A0,D3.W)
02:0003ED48 5203            	 11834:     addq.b  #1,D3
02:0003ED4A 5314            	 11835:     subq.b  #1,($0000,A4)
02:0003ED4C 66EA            	 11836:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11837:     ; If this head segment is not aligned with a square, then return.
                            	 11838:     ;
02:0003ED4E 10342070        	 11839:     move.b  ($70,A4,D2.W),D0
02:0003ED52 0200000F        	 11840:     andi.b #$0F,D0
02:0003ED56 660000BA        	 11841:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11842:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11843:     ; We had to account for the usual offset of 3.
                            	 11844:     ;
02:0003ED5A 41EC0084        	 11845:     lea     ($0084,A4),A0
02:0003ED5E 10302000        	 11846:     move.b  (A0,D2.W),D0
02:0003ED62 023C00EE        	 11847:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED66 123C0003        	 11848:     move.b  #$03,D1
02:0003ED6A D101            	 11849:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED6C 0200000F        	 11850:     andi.b #$0F,D0
02:0003ED70 660000A0        	 11851:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11852:     ; Store the opposite of the facing direction in [00].
                            	 11853:     ;
02:0003ED74 41EC0098        	 11854:     lea     ($0098,A4),A0
02:0003ED78 10302000        	 11855:     move.b  (A0,D2.W),D0
02:0003ED7C E208            	 11856:     lsr.b  #1,D0   ; LSR A
02:0003ED7E 02000005        	 11857:     andi.b #$05,D0
02:0003ED82 1880            	 11858:     move.b  D0,($0000,A4)
02:0003ED84 41EC0098        	 11859:     lea     ($0098,A4),A0
02:0003ED88 10302000        	 11860:     move.b  (A0,D2.W),D0
02:0003ED8C E308            	 11861:     lsl.b  #1,D0   ; ASL A
02:0003ED8E 0200000A        	 11862:     andi.b #$0A,D0
02:0003ED92 1214            	 11863:     move.b  ($0000,A4),D1
02:0003ED94 8001            	 11864:     or.b  D1,D0
                            	 11865:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11866:     ;
02:0003ED96 0A00000F        	 11867:     eori.b #$0F,D0
02:0003ED9A 1940050F        	 11868:     move.b  D0,($050F,A4)
                            	 11869:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11870:     ;
02:0003ED9E 10342018        	 11871:     move.b  ($18,A4,D2.W),D0
02:0003EDA2 0C000080        	 11872:     cmpi.b  #$80,D0
02:0003EDA6 656C            	 11873:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11874:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11875:     ; Load the monster's facing direction.
                            	 11876:     ;
02:0003EDA8 41EC0098        	 11877:     lea     ($0098,A4),A0
02:0003EDAC 10302000        	 11878:     move.b  (A0,D2.W),D0
                            	 11879:     ; Load the next random number into Y register.
                            	 11880:     ;
02:0003EDB0 7600            	 11881:     moveq   #0,D3
02:0003EDB2 16342019        	 11882:     move.b  ($19,A4,D2.W),D3
                            	 11883:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11884:     ; to keep moving straight.
                            	 11885:     ;
02:0003EDB6 0C030080        	 11886:     cmpi.b  #$80,D3
02:0003EDBA 6418            	 11887:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11888:     even
                            	 11889: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11890:     ; Loop to rotate the direction bit over the mask.
                            	 11891:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11892:     ; facing direction.
                            	 11893:     ;
                            	 11894:     ; Shift right the copy of the direction.
                            	 11895:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11896:     ;
02:0003EDBC E208            	 11897:     lsr.b  #1,D0   ; LSR A
02:0003EDBE 6402            	 11898:     bcc  _anon_z04_151
02:0003EDC0 7008            	 11899:     moveq   #8,D0
                            	 11900: _anon_z04_151:
                            	 11901:     ; If the current direction bit is masked off, then we've reached
                            	 11902:     ; the opposite direction. Loop again.
                            	 11903:     ;
02:0003EDC2 122C050F        	 11904:     move.b  ($050F,A4),D1
02:0003EDC6 C200            	 11905:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDC8 67F2            	 11906:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11907:     ; If Y register >= $40, then break out of the loop.
                            	 11908:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11909:     ;
02:0003EDCA 0C030040        	 11910:     cmpi.b  #$40,D3
02:0003EDCE 6404            	 11911:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11912:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11913:     ; and loop again now.
                            	 11914:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11915:     ;
02:0003EDD0 7640            	 11916:     moveq   #64,D3
02:0003EDD2 65E8            	 11917:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11918:     even
                            	 11919: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11920:     ; Change the facing direction to the direction found.
                            	 11921:     ;
02:0003EDD4 41EC0098        	 11922:     lea     ($0098,A4),A0
02:0003EDD8 11802000        	 11923:     move.b  D0,(A0,D2.W)
                            	 11924:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11925:     ;
02:0003EDDC 1940000F        	 11926:     move.b  D0,($000F,A4)
02:0003EDE0 4EB900030BEA    	 11927:     jsr     BoundByRoom
                            	 11928:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11929:     ;
02:0003EDE6 102C000F        	 11930:     move.b  ($000F,A4),D0
02:0003EDEA 6618            	 11931:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11932:     even
                            	 11933: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11934:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11935:     ; for looking for any non-opposite direction that is not blocked.
                            	 11936:     ;
02:0003EDEC 41EC0098        	 11937:     lea     ($0098,A4),A0
02:0003EDF0 10302000        	 11938:     move.b  (A0,D2.W),D0
                            	 11939:     even
                            	 11940: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11941:     ; Shift right the copy of the direction.
                            	 11942:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11943:     ;
02:0003EDF4 E208            	 11944:     lsr.b  #1,D0   ; LSR A
02:0003EDF6 6402            	 11945:     bcc  _anon_z04_152
02:0003EDF8 7008            	 11946:     moveq   #8,D0
                            	 11947: _anon_z04_152:
                            	 11948:     ; If the current direction bit is not masked off, then go check the
                            	 11949:     ; room boundary in this direction.
                            	 11950:     ; Else we've reached the opposite direction. Loop again.
                            	 11951:     ;
02:0003EDFA 122C050F        	 11952:     move.b  ($050F,A4),D1
02:0003EDFE C200            	 11953:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE00 66D2            	 11954:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE02 67F0            	 11955:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11956:     even
                            	 11957: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11958:     ; We found a direction that was not blocked by the room boundary.
                            	 11959:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11960:     ;
02:0003EE04 4EB90004B6C8    	 11961:     jsr     GetCollidingTileMoving
02:0003EE0A 122C034A        	 11962:     move.b  ($034A,A4),D1
02:0003EE0E B001            	 11963:     cmp.b   D1,D0
02:0003EE10 64DA            	 11964:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11965:     even
                            	 11966: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11967:     ; TODO: confirm this
                            	 11968:     ;
                            	 11969:     ; If there were a room that had lamnolas, and they could get
                            	 11970:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11971:     ; an infinite loop.
                            	 11972:     ;
                            	 11973:     ; But, the only room with that configuration has those blocks
                            	 11974:     ; blocked off with a push block, which can only be pushed after
                            	 11975:     ; all monsters are killed.
                            	 11976:     ;
02:0003EE12 4E75            	 11977:     rts
                            	 11978: 
                            	 11979:     even
                            	 11980: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11981:     ; Find the horizontal direction toward Link and store it in [02].
