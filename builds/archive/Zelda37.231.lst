02:0003DDB2 0200000F        	  9760:     andi.b #$0F,D0
02:0003DDB6 0C000002        	  9761:     cmpi.b  #$02,D0
02:0003DDBA 670C            	  9762:     beq  _anon_z04_117
02:0003DDBC 0C000003        	  9763:     cmpi.b  #$03,D0
02:0003DDC0 6706            	  9764:     beq  _anon_z04_117
02:0003DDC2 4EF900031834    	  9765:     jmp     DrawObjectMirrored
