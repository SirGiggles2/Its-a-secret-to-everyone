02:0003BB80 7400            	  5146:     moveq   #0,D2
02:0003BB82 142C0340        	  5147:     move.b  ($0340,A4),D2
02:0003BB86 41EC03E4        	  5148:     lea     ($03E4,A4),A0
02:0003BB8A 10302000        	  5149:     move.b  (A0,D2.W),D0
02:0003BB8E 6724            	  5150:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5151:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5152:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5153:     ; The right side is correctly the right side of a closed hand.
                            	  5154:     ; But the left side is Keese. So, we have to patch the left
                            	  5155:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5156:     ;
                            	  5157:     ; Keep in mind that left and right sprites might be flipped.
                            	  5158:     ;
02:0003BB90 7600            	  5159:     moveq   #0,D3
02:0003BB92 1614            	  5160:     move.b  ($0000,A4),D3
02:0003BB94 41EC0201        	  5161:     lea     ($0201,A4),A0
02:0003BB98 10303000        	  5162:     move.b  (A0,D3.W),D0
02:0003BB9C 0C00009C        	  5163:     cmpi.b  #$9C,D0
02:0003BBA0 6706            	  5164:     beq  _anon_z04_68
02:0003BBA2 7600            	  5165:     moveq   #0,D3
02:0003BBA4 162C0001        	  5166:     move.b  ($0001,A4),D3
                            	  5167: _anon_z04_68:
02:0003BBA8 103C00AC        	  5168:     move.b  #$AC,D0
02:0003BBAC 41EC0201        	  5169:     lea     ($0201,A4),A0
