02:0003E784 003C0011        	 11083:     ori     #$11,CCR  ; SEC: set C+X
02:0003E788 123C0041        	 11084:     move.b  #$41,D1
02:0003E78C 0A3C0010        	 11085:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E790 9101            	 11086:     subx.b  D1,D0   ; SBC #$41
02:0003E792 0A3C0010        	 11087:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E796 1214            	 11088:     move.b  ($0000,A4),D1
02:0003E798 B001            	 11089:     cmp.b   D1,D0
                            	 11090:     ; If they're equal, then go handle the whole boss dying.
