02:0003B4A4 7400            	  4218:     moveq   #0,D2
02:0003B4A6 142C0340        	  4219:     move.b  ($0340,A4),D2
02:0003B4AA 4EB900031838    	  4220:     jsr     DrawObjectNotMirrored
02:0003B4B0 101D            	  4221:     move.b  (A5)+,D0  ; PLA
02:0003B4B2 7400            	  4222:     moveq   #0,D2
