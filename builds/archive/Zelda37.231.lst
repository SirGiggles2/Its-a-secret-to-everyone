02:0003C09C 0C020006        	  5777:     cmpi.b  #$06,D2
02:0003C0A0 6502            	  5778:     bcs  _anon_z04_80
02:0003C0A2 7604            	  5779:     moveq   #4,D3
                            	  5780: _anon_z04_80:
