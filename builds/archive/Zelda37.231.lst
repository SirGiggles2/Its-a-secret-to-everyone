                            	  7073: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7074:     ; Advance the substate.
                            	  7075:     ;
02:0003C9FC 41EC042C        	  7076:     lea     ($042C,A4),A0
02:0003CA00 52302000        	  7077:     addq.b  #1,(A0,D2.W)
                            	  7078:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7079:     ;
02:0003CA04 41EC042C        	  7080:     lea     ($042C,A4),A0
02:0003CA08 10302000        	  7081:     move.b  (A0,D2.W),D0
02:0003CA0C 0C000002        	  7082:     cmpi.b  #$02,D0
02:0003CA10 6402            	  7083:     bcc.s  __far_z_04_0060
02:0003CA12 601C            	  7084:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7085: __far_z_04_0060:
                            	  7086:     ; New bloated substate >= 2.
                            	  7087:     ;
                            	  7088:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7089:     ; which will transition to state 0 (moving).
                            	  7090:     ;
                            	  7091:     ; Note that if the bomb hits >= 2, then:
                            	  7092:     ; - If new substate = 2, then substate 2 will wait,
                            	  7093:     ;   and then transition to substate 3.
                            	  7094:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7095:     ;
02:0003CA14 7600            	  7096:     moveq   #0,D3
02:0003CA16 41EC0437        	  7097:     lea     ($0437,A4),A0
02:0003CA1A 16302000        	  7098:     move.b  (A0,D2.W),D3
02:0003CA1E 0C030002        	  7099:     cmpi.b  #$02,D3
02:0003CA22 6502            	  7100:     bcs.s  __far_z_04_0061
02:0003CA24 600A            	  7101:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7102: __far_z_04_0061:
