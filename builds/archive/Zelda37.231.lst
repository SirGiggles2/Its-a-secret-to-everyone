                            	  9771: UpdateGohma:
                            	  9772:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9773:     ;
02:0003DDCE 41EC0451        	  9774:     lea     ($0451,A4),A0
02:0003DDD2 10302000        	  9775:     move.b  (A0,D2.W),D0
02:0003DDD6 662C            	  9776:     bne  _L_z04_UpdateGohma_Move
                            	  9777:     ; If Random:
                            	  9778:     ;   >= $B0: right
                            	  9779:     ;   >= $60: left
                            	  9780:     ;   Else:   down
                            	  9781:     ;
02:0003DDD8 7001            	  9782:     moveq   #1,D0
02:0003DDDA 7600            	  9783:     moveq   #0,D3
02:0003DDDC 16342018        	  9784:     move.b  ($18,A4,D2.W),D3
02:0003DDE0 0C0300B0        	  9785:     cmpi.b  #$B0,D3
02:0003DDE4 640A            	  9786:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDE6 E308            	  9787:     lsl.b  #1,D0   ; ASL A
02:0003DDE8 0C030060        	  9788:     cmpi.b  #$60,D3
02:0003DDEC 6402            	  9789:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDEE E308            	  9790:     lsl.b  #1,D0   ; ASL A
                            	  9791:     even
                            	  9792: _L_z04_UpdateGohma_ChangeDir:
02:0003DDF0 41EC0098        	  9793:     lea     ($0098,A4),A0
02:0003DDF4 11802000        	  9794:     move.b  D0,(A0,D2.W)
                            	  9795:     ; Now we can go straight without changing direction for some time.
                            	  9796:     ;
02:0003DDF8 41EC0451        	  9797:     lea     ($0451,A4),A0
02:0003DDFC 52302000        	  9798:     addq.b  #1,(A0,D2.W)
                            	  9799:     ; Go animate the eye.
                            	  9800:     ;
02:0003DE00 600000C6        	  9801:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9802: 
                            	  9803:     even
                            	  9804: _L_z04_UpdateGohma_Move:
                            	  9805:     ; Add $80 to the movement accumulator.
                            	  9806:     ;
02:0003DE04 41EC041F        	  9807:     lea     ($041F,A4),A0
02:0003DE08 10302000        	  9808:     move.b  (A0,D2.W),D0
02:0003DE0C 023C00EE        	  9809:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE10 123C0080        	  9810:     move.b  #$80,D1
02:0003DE14 D101            	  9811:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE16 41EC041F        	  9812:     lea     ($041F,A4),A0
02:0003DE1A 11802000        	  9813:     move.b  D0,(A0,D2.W)
                            	  9814:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9815:     ;
02:0003DE1E 640000A8        	  9816:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9817:     ; Increase the distance traveled, and move 1.
