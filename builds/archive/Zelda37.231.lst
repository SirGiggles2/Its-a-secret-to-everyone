02:00041C22 0C000080        	  3502:     cmpi.b  #$80,D0
02:00041C26 670A            	  3503:     beq  _anon_z05_83
02:00041C28 5203            	  3504:     addq.b  #1,D3
02:00041C2A 0C0000B0        	  3505:     cmpi.b  #$B0,D0
02:00041C2E 6702            	  3506:     beq.s  __far_z_05_0069
02:00041C30 6064            	  3507:     jmp  L14F72_Exit
                            	  3508: __far_z_05_0069:
                            	  3509: _anon_z05_83:
                            	  3510:     ; Look for the current room in the cellar/shortcut room array.
                            	  3511:     ;
02:00041C32 1883            	  3512:     move.b  D3,($0000,A4)
02:00041C34 163C00FF        	  3513:     move.b  #$FF,D3
02:00041C38 102C00EB        	  3514:     move.b  ($00EB,A4),D0
                            	  3515: _anon_z05_84:
02:00041C3C 5203            	  3516:     addq.b  #1,D3
02:00041C3E 41F900FF6BB2    	  3517:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C44 12303000        	  3518:     move.b  (A0,D3.W),D1
02:00041C48 B001            	  3519:     cmp.b   D1,D0
02:00041C4A 66F0            	  3520:     bne  _anon_z05_84
                            	  3521:     ; Add the value of the shortcut chosen to whatever index
                            	  3522:     ; the current room has in the array.
                            	  3523:     ;
                            	  3524:     ; This yields the index of one of the three shortcut rooms
                            	  3525:     ; after the current one.
                            	  3526:     ;
02:00041C4C 1003            	  3527:     move.b  D3,D0
02:00041C4E 023C00EE        	  3528:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C52 1214            	  3529:     move.b  ($0000,A4),D1
02:00041C54 D101            	  3530:     addx.b  D1,D0   ; ADC $00
                            	  3531:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3532:     ;
02:00041C56 02000003        	  3533:     andi.b #$03,D0
02:00041C5A 7600            	  3534:     moveq   #0,D3
02:00041C5C 1600            	  3535:     move.b  D0,D3
02:00041C5E 41F900FF6BB2    	  3536:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C64 10303000        	  3537:     move.b  (A0,D3.W),D0
                            	  3538: ; Params:
                            	  3539: ; A: destination room ID
                            	  3540: ;
                            	  3541:     even
                            	  3542: GoToModeAFromCellar:
02:00041C68 194000EB        	  3543:     move.b  D0,($00EB,A4)
02:00041C6C 4EB90004AB08    	  3544:     jsr     MarkRoomVisited
                            	  3545:     even
                            	  3546: GoToModeAFromCave:
02:00041C72 700A            	  3547:     moveq   #10,D0
02:00041C74 19400012        	  3548:     move.b  D0,($0012,A4)
                            	  3549:     even
                            	  3550: EndPrepareMode:
02:00041C78 7000            	  3551:     moveq   #0,D0
02:00041C7A 19400013        	  3552:     move.b  D0,($0013,A4)
02:00041C7E 19400011        	  3553:     move.b  D0,($0011,A4)
02:00041C82 1940000F        	  3554:     move.b  D0,($000F,A4)
02:00041C86 194000AC        	  3555:     move.b  D0,($00AC,A4)
02:00041C8A 194000C0        	  3556:     move.b  D0,($00C0,A4)
02:00041C8E 194000D3        	  3557:     move.b  D0,($00D3,A4)
02:00041C92 194004F0        	  3558:     move.b  D0,($04F0,A4)
                            	  3559:     even
