02:00031DC0 6602            	  6503:     bne.s  __far_z_01_0064
02:00031DC2 6068            	  6504:     jmp  HarmLink
                            	  6505: __far_z_01_0064:
02:00031DC4 102C00AC        	  6506:     move.b  ($00AC,A4),D0
02:00031DC8 020000F0        	  6507:     andi.b #$F0,D0
02:00031DCC 6702            	  6508:     beq.s  __far_z_01_0065
02:00031DCE 605C            	  6509:     jmp  HarmLink
                            	  6510: __far_z_01_0065:
                            	  6511:     ; If Link and the shot are not facing opposite directions,
                            	  6512:     ; then go harm Link.
                            	  6513:     ;
                            	  6514:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6515:     ; component of a monster that can move diagonally.
                            	  6516:     ;
02:00031DD0 102C0098        	  6517:     move.b  ($0098,A4),D0
02:00031DD4 41EC0098        	  6518:     lea     ($0098,A4),A0
02:00031DD8 12302000        	  6519:     move.b  (A0,D2.W),D1
02:00031DDC 8001            	  6520:     or.b  D1,D0
02:00031DDE 0200000C        	  6521:     andi.b #$0C,D0
02:00031DE2 0C00000C        	  6522:     cmpi.b  #$0C,D0
02:00031DE6 671A            	  6523:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031DE8 102C0098        	  6524:     move.b  ($0098,A4),D0
02:00031DEC 41EC0098        	  6525:     lea     ($0098,A4),A0
02:00031DF0 12302000        	  6526:     move.b  (A0,D2.W),D1
02:00031DF4 8001            	  6527:     or.b  D1,D0
02:00031DF6 02000003        	  6528:     andi.b #$03,D0
02:00031DFA 0C000003        	  6529:     cmpi.b  #$03,D0
02:00031DFE 6702            	  6530:     beq.s  __far_z_01_0066
02:00031E00 602A            	  6531:     jmp  HarmLink
                            	  6532: __far_z_01_0066:
                            	  6533:     even
                            	  6534: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6535:     ; Link and the shot are facing opposite directions.
                            	  6536:     ; Link can parry certain weapons/shots.
                            	  6537:     ;
                            	  6538:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6539:     ; no harmful collision; but it still counts as a shot collision.
                            	  6540:     ; So, go treat this as a parry.
                            	  6541:     ;
02:00031E02 41EC034F        	  6542:     lea     ($034F,A4),A0
02:00031E06 10302000        	  6543:     move.b  (A0,D2.W),D0
02:00031E0A 0C000055        	  6544:     cmpi.b  #$55,D0
02:00031E0E 650E            	  6545:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031E10 0C00005B        	  6546:     cmpi.b  #$5B,D0
02:00031E14 6408            	  6547:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6548:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6549:     ; So, go harm Link.
                            	  6550:     ;
02:00031E16 102C0676        	  6551:     move.b  ($0676,A4),D0
02:00031E1A 6602            	  6552:     bne.s  __far_z_01_0067
02:00031E1C 600E            	  6553:     jmp  HarmLink
                            	  6554: __far_z_01_0067:
                            	  6555:     even
                            	  6556: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6557:     ; Else Link parries.
                            	  6558:     ;
                            	  6559:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6560:     ;
02:00031E1E 7001            	  6561:     moveq   #1,D0
02:00031E20 19400604        	  6562:     move.b  D0,($0604,A4)
02:00031E24 7000            	  6563:     moveq   #0,D0
02:00031E26 19400006        	  6564:     move.b  D0,($0006,A4)
                            	  6565:     even
                            	  6566: L73A9_Exit:
02:00031E2A 4E75            	  6567:     rts
                            	  6568: 
