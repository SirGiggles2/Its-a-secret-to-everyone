02:0003B484 7600            	  4206:     moveq   #0,D3
02:0003B486 1600            	  4207:     move.b  D0,D3
02:0003B488 610048D8        	  4208:     jsr     RotateObjectLocation
02:0003B48C 41EC0084        	  4209:     lea     ($0084,A4),A0
02:0003B490 11802000        	  4210:     move.b  D0,(A0,D2.W)
02:0003B494 1002            	  4211:     move.b  D2,D0
02:0003B496 1B00            	  4212:     move.b  D0,-(A5)  ; PHA
02:0003B498 4EB900031B28    	  4213:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:0003B49E 4EB90004CDB8    	  4214:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4215:     ; The variable for the currently updating object slot has to be
