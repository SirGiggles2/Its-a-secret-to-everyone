                            	  4190: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4191:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4192:     ;
                            	  4193:     ; To match a doorway:
                            	  4194:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4195:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4196:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4197:     ;
                            	  4198:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4199:     ; a doorway to be part of it.
                            	  4200:     ;
