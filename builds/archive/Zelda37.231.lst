02:0003C59C 41EC0098        	  6499:     lea     ($0098,A4),A0
02:0003C5A0 10302000        	  6500:     move.b  (A0,D2.W),D0
02:0003C5A4 122C0002        	  6501:     move.b  ($0002,A4),D1
02:0003C5A8 E309            	  6502:     lsl.b  #1,D1   ; ASL $02
02:0003C5AA 19410002        	  6503:     move.b  D1,($0002,A4)
02:0003C5AE 122C0002        	  6504:     move.b  ($0002,A4),D1
02:0003C5B2 C200            	  6505:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5B4 6716            	  6506:     beq  _L_z04_Digdogger_Move_Up
02:0003C5B6 41EC0084        	  6507:     lea     ($0084,A4),A0
02:0003C5BA 10302000        	  6508:     move.b  (A0,D2.W),D0
02:0003C5BE 122C0003        	  6509:     move.b  ($0003,A4),D1
02:0003C5C2 D101            	  6510:     addx.b  D1,D0   ; ADC $03
02:0003C5C4 41EC0084        	  6511:     lea     ($0084,A4),A0
02:0003C5C8 11802000        	  6512:     move.b  D0,(A0,D2.W)
                            	  6513:     even
