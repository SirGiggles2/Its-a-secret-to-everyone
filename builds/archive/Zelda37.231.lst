                            	  5140: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003BB78 19400001        	  5141:     move.b  D0,($0001,A4)
02:0003BB7C 61000104        	  5142:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5143:     ; The default image is the hand open.
                            	  5144:     ; If animation frame = 0, then return.
