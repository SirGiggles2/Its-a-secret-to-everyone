                            	  5203:     even
                            	  5204: UpdateBoomerangOrFood:
                            	  5205:     ; If state = 0, then not active. So, return.
                            	  5206:     ;
02:0004C1CE 41EC00AC        	  5207:     lea     ($00AC,A4),A0
02:0004C1D2 10302000        	  5208:     move.b  (A0,D2.W),D0
02:0004C1D6 6602            	  5209:     bne.s  __far_z_07_0079
02:0004C1D8 60F2            	  5210:     jmp  L1F49F_Exit
                            	  5211: __far_z_07_0079:
                            	  5212:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5213:     ;
02:0004C1DA E308            	  5214:     lsl.b  #1,D0   ; ASL A
02:0004C1DC 6504            	  5215:     bcs.s  __far_z_07_0080
02:0004C1DE 600000AA        	  5216:     jmp  UpdateArrowOrBoomerang
                            	  5217: __far_z_07_0080:
                            	  5218:     ; The object is food.
                            	  5219:     ;
                            	  5220:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5221:     ; If we reach state $83, then go deactivate the object.
                            	  5222:     ;
                            	  5223:     ; Nothing changes between the states. So, they are used as
                            	  5224:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5225:     ;
02:0004C1E2 10342028        	  5226:     move.b  ($28,A4,D2.W),D0
02:0004C1E6 6622            	  5227:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004C1E8 41EC00AC        	  5228:     lea     ($00AC,A4),A0
02:0004C1EC 52302000        	  5229:     addq.b  #1,(A0,D2.W)
02:0004C1F0 41EC00AC        	  5230:     lea     ($00AC,A4),A0
02:0004C1F4 10302000        	  5231:     move.b  (A0,D2.W),D0
02:0004C1F8 0200000F        	  5232:     andi.b #$0F,D0
02:0004C1FC 0C000003        	  5233:     cmpi.b  #$03,D0
02:0004C200 674C            	  5234:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004C202 103C00FF        	  5235:     move.b  #$FF,D0
02:0004C206 19802028        	  5236:     move.b  D0,($28,A4,D2.W)
                            	  5237:     even
                            	  5238: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5239:     ; If the template object type in the room is one of:
                            	  5240:     ; moblin, goriya, octorock, vire, keese
                            	  5241:     ; then attract these monsters to the food.
                            	  5242:     ;
                            	  5243:     ; They will chase the food instead of Link when given a chance.
                            	  5244:     ;
02:0004C20A 102C035F        	  5245:     move.b  ($035F,A4),D0
