02:0003CEE6 41EC041F        	  7820:     lea     ($041F,A4),A0
02:0003CEEA 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003CEEE 020000FC        	  7822:     andi.b #$FC,D0
02:0003CEF2 0C0000B0        	  7823:     cmpi.b  #$B0,D0
