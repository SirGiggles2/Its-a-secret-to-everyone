                            	 10894: __far_z_04_0100:
                            	 10895: ; Description:
                            	 10896: ; This block applies to heads and the bottom segment of a neck.
                            	 10897: ; These are drawn with sprites that come first in order, so that
                            	 10898: ; they are drawn above all other sprites, including Link.
                            	 10899: ;
                            	 10900: ; Params:
                            	 10901: ; A: tile number
                            	 10902: ;
                            	 10903: ; Normal sprite with level palette row
                            	 10904:     even
                            	 10905: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E638 7603            	 10906:     moveq   #3,D3
02:0003E63A 19430003        	 10907:     move.b  D3,($0003,A4)
02:0003E63E 1B00            	 10908:     move.b  D0,-(A5)  ; PHA
                            	 10909:     ; To calculate the base offset of the sprite record:
                            	 10910:     ; offset := neck index * 8
                            	 10911:     ;
                            	 10912:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 10913:     ; at an even index.
                            	 10914:     ;
02:0003E640 102C04D7        	 10915:     move.b  ($04D7,A4),D0
02:0003E644 E308            	 10916:     lsl.b  #1,D0   ; ASL A
02:0003E646 E308            	 10917:     lsl.b  #1,D0   ; ASL A
02:0003E648 E308            	 10918:     lsl.b  #1,D0   ; ASL A
                            	 10919:     ; But if the segment is not a head (not at object slot 5), then
                            	 10920:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 10921:     ;
02:0003E64A 0C020005        	 10922:     cmpi.b  #$05,D2
02:0003E64E 670A            	 10923:     beq  _anon_z04_139
02:0003E650 023C00EE        	 10924:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E654 123C0020        	 10925:     move.b  #$20,D1
02:0003E658 D101            	 10926:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 10927: _anon_z04_139:
02:0003E65A 7600            	 10928:     moveq   #0,D3
02:0003E65C 1600            	 10929:     move.b  D0,D3
02:0003E65E 101D            	 10930:     move.b  (A5)+,D0  ; PLA
02:0003E660 4EB900031B62    	 10931:     jsr     Anim_WriteSpecificSprite
02:0003E666 6026            	 10932:     jmp     Gleeok_CheckCollisions
                            	 10933: 
                            	 10934:     even
