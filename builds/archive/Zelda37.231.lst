                            	  5959: __far_z_05_0088:
                            	  5960:     ; Turn the door command into the desired open or closed state
                            	  5961:     ; to store in [08].
                            	  5962:     ;
                            	  5963:     ; cmd:  7 6 3 2 
                            	  5964:     ; [08]: 2 0 0 0
                            	  5965:     ;
                            	  5966:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5967:     ; commands intended to be used.
                            	  5968:     ;
                            	  5969:     ; 3 is the end state of 2: close
                            	  5970:     ; 7 is the end state of 6: open
                            	  5971:     ;
02:00043812 02000007        	  5972:     andi.b #$07,D0
02:00043816 7601            	  5973:     moveq   #1,D3
02:00043818 19430002        	  5974:     move.b  D3,($0002,A4)
02:0004381C 122C0002        	  5975:     move.b  ($0002,A4),D1
02:00043820 C200            	  5976:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043822 6702            	  5977:     beq  _anon_z05_118
