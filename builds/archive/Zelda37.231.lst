02:0003BBBA 19400070        	  5182:     move.b  D0,($0070,A4)
02:0003BBBE 41EC0084        	  5183:     lea     ($0084,A4),A0
02:0003BBC2 10302000        	  5184:     move.b  (A0,D2.W),D0
02:0003BBC6 19400084        	  5185:     move.b  D0,($0084,A4)
02:0003BBCA 4EB90004BCCC    	  5186:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BBD0 4EB900030A86    	  5187:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BBD6 7400            	  5188:     moveq   #0,D2
02:0003BBD8 142C0340        	  5189:     move.b  ($0340,A4),D2
02:0003BBDC 6116            	  5190:     jsr     Wallmaster_PrepareToDraw
                            	  5191:     ; Force animation frame 1: hand closed.
                            	  5192:     ;
02:0003BBDE 7001            	  5193:     moveq   #1,D0
02:0003BBE0 41EC03E4        	  5194:     lea     ($03E4,A4),A0
02:0003BBE4 11802000        	  5195:     move.b  D0,(A0,D2.W)
02:0003BBE8 6100E218        	  5196:     jsr     DrawObjectNotMirroredOverLink
                            	  5197:     ; Store the offsets of the sprites to show over Link
                            	  5198:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
                            	  5199:     ;
02:0003BBEC 7040            	  5200:     moveq   #64,D0
02:0003BBEE 1880            	  5201:     move.b  D0,($0000,A4)
02:0003BBF0 7044            	  5202:     moveq   #68,D0
                            	  5203:     ; Go patch up the sprites.
                            	  5204:     ;
02:0003BBF2 6084            	  5205:     jmp     _L_z04_L_Wallmaster_State1_PatchSprites
                            	  5206: 
                            	  5207:     even
                            	  5208: Wallmaster_PrepareToDraw:
02:0003BBF4 4EF90002BEFA    	  5209:     jmp     c_wallmaster_prepare_to_draw
                            	  5210: 
                            	  5211: Wallmaster_CalcStartPosition:
02:0003BBFA 41EC0412        	  5212:     lea     ($0412,A4),A0
02:0003BBFE 11802000        	  5213:     move.b  D0,(A0,D2.W)
02:0003BC02 19430003        	  5214:     move.b  D3,($0003,A4)
                            	  5215:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5216:     ;
02:0003BC06 7024            	  5217:     moveq   #36,D0
02:0003BC08 7600            	  5218:     moveq   #0,D3
02:0003BC0A 162C03F8        	  5219:     move.b  ($03F8,A4),D3
02:0003BC0E 6702            	  5220:     beq  _anon_z04_70
02:0003BC10 7032            	  5221:     moveq   #50,D0
                            	  5222: _anon_z04_70:
                            	  5223:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5224:     ; 1. negate the distance
                            	  5225:     ; 2. add 8 to the instruction offset to access
                            	  5226:     ;    the opposite direction for the same wall
                            	  5227:     ;
02:0003BC12 7600            	  5228:     moveq   #0,D3
02:0003BC14 162C0098        	  5229:     move.b  ($0098,A4),D3
02:0003BC18 122C0002        	  5230:     move.b  ($0002,A4),D1
02:0003BC1C B601            	  5231:     cmp.b   D1,D3
02:0003BC1E 662A            	  5232:     bne  _anon_z04_71
02:0003BC20 1B00            	  5233:     move.b  D0,-(A5)  ; PHA
02:0003BC22 41EC0412        	  5234:     lea     ($0412,A4),A0
02:0003BC26 10302000        	  5235:     move.b  (A0,D2.W),D0
02:0003BC2A 023C00EE        	  5236:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC2E 123C0008        	  5237:     move.b  #$08,D1
02:0003BC32 D101            	  5238:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BC34 41EC0412        	  5239:     lea     ($0412,A4),A0
02:0003BC38 11802000        	  5240:     move.b  D0,(A0,D2.W)
02:0003BC3C 101D            	  5241:     move.b  (A5)+,D0  ; PLA
02:0003BC3E 4600            	  5242:     eori.b #$FF,D0
02:0003BC40 023C00EE        	  5243:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC44 123C0001        	  5244:     move.b  #$01,D1
02:0003BC48 D101            	  5245:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5246: _anon_z04_71:
                            	  5247:     ; Add the distance and Link's minor coordinate to calculate
                            	  5248:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5249:     ; In general, the monster will be put in front of Link.
                            	  5250:     ;
02:0003BC4A 023C00EE        	  5251:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC4E 1214            	  5252:     move.b  ($0000,A4),D1
02:0003BC50 D101            	  5253:     addx.b  D1,D0   ; ADC $00
02:0003BC52 19400004        	  5254:     move.b  D0,($0004,A4)
                            	  5255:     ; By default, will return index 0 to choose the minimum value
                            	  5256:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5257:     ; if Link is at the wall with a smaller major coordinate.
                            	  5258:     ;
02:0003BC56 7600            	  5259:     moveq   #0,D3
                            	  5260:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5261:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5262:     ; to access the block for the other direction along the same axis,
