02:0003B43E 41EC0098        	  4172:     lea     ($0098,A4),A0
02:0003B442 11802000        	  4173:     move.b  D0,(A0,D2.W)
                            	  4174:     ; Starting angle $18 (N).
                            	  4175:     ;
02:0003B446 7018            	  4176:     moveq   #24,D0
02:0003B448 41EC0394        	  4177:     lea     ($0394,A4),A0
02:0003B44C 11802000        	  4178:     move.b  D0,(A0,D2.W)
                            	  4179:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4180:     ;
02:0003B450 102C0071        	  4181:     move.b  ($0071,A4),D0
02:0003B454 19802070        	  4182:     move.b  D0,($70,A4,D2.W)
                            	  4183:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  4184:     ;
02:0003B458 102C0085        	  4185:     move.b  ($0085,A4),D0
02:0003B45C 003C0011        	  4186:     ori     #$11,CCR  ; SEC: set C+X
02:0003B460 123C001C        	  4187:     move.b  #$1C,D1
02:0003B464 0A3C0010        	  4188:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B468 9101            	  4189:     subx.b  D1,D0   ; SBC #$1C
02:0003B46A 0A3C0010        	  4190:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B46E 41EC0084        	  4191:     lea     ($0084,A4),A0
02:0003B472 11802000        	  4192:     move.b  D0,(A0,D2.W)
                            	  4193:     even
                            	  4194: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  4195:     ; Decrease the angle by $00.60.
                            	  4196:     ;
02:0003B476 7000            	  4197:     moveq   #0,D0
02:0003B478 1940000B        	  4198:     move.b  D0,($000B,A4)
