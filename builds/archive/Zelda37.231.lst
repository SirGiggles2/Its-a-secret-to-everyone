                            	  9732:     even
                            	  9733: Manhandla_Draw:
02:0003DD84 4EB90004CDB8    	  9734:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9735:     ; Push the "frame image and sprite attributes" value.
                            	  9736:     ;
02:0003DD8A 41EC0478        	  9737:     lea     ($0478,A4),A0
02:0003DD8E 10302000        	  9738:     move.b  (A0,D2.W),D0
02:0003DD92 1B00            	  9739:     move.b  D0,-(A5)  ; PHA
                            	  9740:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9741:     ; passed along as is.
                            	  9742:     ;
02:0003DD94 02000080        	  9743:     andi.b #$80,D0
02:0003DD98 00000001        	  9744:     ori.b #$01,D0
02:0003DD9C 4EB900031B2A    	  9745:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DDA2 101D            	  9746:     move.b  (A5)+,D0  ; PLA
02:0003DDA4 1B00            	  9747:     move.b  D0,-(A5)  ; PHA
                            	  9748:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9749:     ;
02:0003DDA6 02000040        	  9750:     andi.b #$40,D0
02:0003DDAA 6704            	  9751:     beq  _anon_z04_116
02:0003DDAC 522C000F        	  9752:     addq.b  #1,($000F,A4)
                            	  9753: _anon_z04_116:
02:0003DDB0 101D            	  9754:     move.b  (A5)+,D0  ; PLA
                            	  9755:     ; If the low nibble = 2 or 3, then go draw not mirrored.
