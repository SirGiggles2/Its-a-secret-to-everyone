02:0003CB40 41EC0084        	  7248:     lea     ($0084,A4),A0
02:0003CB44 10303000        	  7249:     move.b  (A0,D3.W),D0
02:0003CB48 123C0008        	  7250:     move.b  #$08,D1
02:0003CB4C D101            	  7251:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB4E 19400003        	  7252:     move.b  D0,($0003,A4)
                            	  7253:     ; But, if there's no bomb, then return.
