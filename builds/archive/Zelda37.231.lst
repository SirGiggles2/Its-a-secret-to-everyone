02:0003EC64 4EB900031BB4    	 11714:     jsr     CheckMonsterCollisions
02:0003EC6A 101D            	 11715:     move.b  (A5)+,D0  ; PLA
02:0003EC6C 41EC0098        	 11716:     lea     ($0098,A4),A0
