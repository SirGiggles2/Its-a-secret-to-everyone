02:0004C7C0 D101            	  6054:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004C7C2 5303            	  6055:     subq.b  #1,D3
02:0004C7C4 66F2            	  6056:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004C7C6 1880            	  6057:     move.b  D0,($0000,A4)
                            	  6058:     ; Set object's direction to player's. It might have changed
                            	  6059:     ; since the last frame.
