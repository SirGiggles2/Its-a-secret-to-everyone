02:0003A9D6 02000003        	  2679:     andi.b #$03,D0
02:0003A9DA 6624            	  2680:     bne  _L_z04_UpdateTektiteOrBoulder_SetStateJump
02:0003A9DC 7602            	  2681:     moveq   #2,D3
02:0003A9DE 102C0061        	  2682:     move.b  ($0061,A4),D0
02:0003A9E2 12342070        	  2683:     move.b  ($70,A4,D2.W),D1
02:0003A9E6 B001            	  2684:     cmp.b   D1,D0
02:0003A9E8 6502            	  2685:     bcs  _anon_z04_36
