02:00044C2C 123C0020        	  8057:     move.b  #$20,D1
02:00044C30 D101            	  8058:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00044C32 6404            	  8059:     bcc  _anon_z05_169
02:00044C34 522C0302        	  8060:     addq.b  #1,($0302,A4)
                            	  8061: _anon_z05_169:
02:00044C38 5303            	  8062:     subq.b  #1,D3
02:00044C3A 6AEC            	  8063:     bpl  _L_z05_PrepFullBlackRow_Add20H
02:00044C3C 19400303        	  8064:     move.b  D0,($0303,A4)
02:00044C40 7060            	  8065:     moveq   #96,D0
02:00044C42 19400304        	  8066:     move.b  D0,($0304,A4)
02:00044C46 7024            	  8067:     moveq   #36,D0
02:00044C48 19400305        	  8068:     move.b  D0,($0305,A4)
02:00044C4C 103C00FF        	  8069:     move.b  #$FF,D0
02:00044C50 19400306        	  8070:     move.b  D0,($0306,A4)
02:00044C54 60C2            	  8071:     jmp     DecSubmenuScroll
