                            	  7465: DodongoFrameHFlipsBloated:
02:0003CC70 00              	  7466:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC71 40
02:0003CC72 00
02:0003CC73 FF
02:0003CC74 00
02:0003CC75 00
