                            	  7786: _L_z04_UpdatePolsVoice_State0:
                            	  7787:     ; State 0. Walking.
                            	  7788:     ;
                            	  7789:     ; If grid offset = 0, then no more distance to cover.
                            	  7790:     ; So, go change to state 1 -- jumping.
                            	  7791:     ;
02:0003CEAC 41EC0394        	  7792:     lea     ($0394,A4),A0
02:0003CEB0 10302000        	  7793:     move.b  (A0,D2.W),D0
02:0003CEB4 67000084        	  7794:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7795:     ; Decrement grid offset / distance remaining.
                            	  7796:     ;
02:0003CEB8 41EC0394        	  7797:     lea     ($0394,A4),A0
02:0003CEBC 53302000        	  7798:     subq.b  #1,(A0,D2.W)
                            	  7799:     ; Move vertically.
                            	  7800:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7801:     ;
