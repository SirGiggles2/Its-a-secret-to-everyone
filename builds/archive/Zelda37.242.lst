02:0003D216 D101            	  7884:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D218 41EC0412        	  7885:     lea     ($0412,A4),A0
02:0003D21C 11802000        	  7886:     move.b  D0,(A0,D2.W)
                            	  7887:     ; Add high speed byte to Y coordinate.
