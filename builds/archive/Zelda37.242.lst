02:0003CB5C 7020            	  6920:     moveq   #32,D0
02:0003CB5E 41EC041F        	  6921:     lea     ($041F,A4),A0
02:0003CB62 11802000        	  6922:     move.b  D0,(A0,D2.W)
02:0003CB66 6100D094        	  6923:     jsr     Wanderer_TargetPlayer
                            	  6924:     ; Pop the offset and add it to the X coordinate.
                            	  6925:     ;
                            	  6926:     ; This brings the X coordinate back to the unique value
                            	  6927:     ; that represents the position.
                            	  6928:     ;
02:0003CB6A 101D            	  6929:     move.b  (A5)+,D0  ; PLA
02:0003CB6C 023C00EE        	  6930:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB70 12342070        	  6931:     move.b  ($70,A4,D2.W),D1
