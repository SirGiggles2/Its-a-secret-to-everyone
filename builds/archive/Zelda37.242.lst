                            	   205: InitCave:
                            	   206:     ; The person goes at location ($78, $80).
                            	   207:     ;
02:0002E378 7078            	   208:     moveq   #120,D0
02:0002E37A 163C0080        	   209:     move.b  #$80,D3
02:0002E37E 610001A0        	   210:     jsr     SetUpCommonCaveObjects
                            	   211:     ; If the cave/person does not remember state (give item, door charge),
                            	   212:     ; then go handle other kinds.
                            	   213:     ;
02:0002E382 102C0350        	   214:     move.b  ($0350,A4),D0
02:0002E386 0C000072        	   215:     cmpi.b  #$72,D0
02:0002E38A 6714            	   216:     beq  _L_z01_InitCave_TakeType
02:0002E38C 0C000071        	   217:     cmpi.b  #$71,D0
02:0002E390 670E            	   218:     beq  _L_z01_InitCave_TakeType
02:0002E392 0C00007B        	   219:     cmpi.b  #$7B,D0
02:0002E396 6408            	   220:     bcc  _L_z01_InitCave_TakeType
02:0002E398 0C00006E        	   221:     cmpi.b  #$6E,D0
02:0002E39C 6502            	   222:     bcs.s  __far_z_01_0000
02:0002E39E 6012            	   223:     jmp  InitCaveContinue
                            	   224: __far_z_01_0000:
                            	   225:     even
                            	   226: _L_z01_InitCave_TakeType:
                            	   227:     ; Else the cave/person simply does:
                            	   228:     ; - taken:     no person, no text
                            	   229:     ; - not taken: show a person and text
                            	   230:     ;
                            	   231:     ; So, if the item was not taken, then go set up the text.
                            	   232:     ;
02:0002E3A0 610030BE        	   233:     jsr     GetRoomFlagUWItemState
02:0002E3A4 6602            	   234:     bne.s  __far_z_01_0001
02:0002E3A6 600A            	   235:     jmp  InitCaveContinue
                            	   236: __far_z_01_0001:
                            	   237:     ; Otherwise destroy the person object, and let Link continue.
                            	   238:     ;
02:0002E3A8 7000            	   239:     moveq   #0,D0
02:0002E3AA 19400350        	   240:     move.b  D0,($0350,A4)
                            	   241:     even
                            	   242: UnhaltLink:
02:0002E3AE 6000D63E        	   243:     jmp     c_unhalt_link
                            	   244: 
                            	   245: InitCaveContinue:
                            	   246:     ; Get this cave's index (object type - $6A).
                            	   247:     ;
02:0002E3B2 102C0350        	   248:     move.b  ($0350,A4),D0
02:0002E3B6 003C0011        	   249:     ori     #$11,CCR  ; SEC: set C+X
02:0002E3BA 123C006A        	   250:     move.b  #$6A,D1
02:0002E3BE 0A3C0010        	   251:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E3C2 9101            	   252:     subx.b  D1,D0   ; SBC #$6A
02:0002E3C4 0A3C0010        	   253:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E3C8 7600            	   254:     moveq   #0,D3
02:0002E3CA 1600            	   255:     move.b  D0,D3
                            	   256:     ; Get the person text selector by looking up the text selector byte
                            	   257:     ; for this index, and masking it with $3F.
                            	   258:     ;
02:0002E3CC 41F90002E34A    	   259:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E3D2 10303000        	   260:     move.b  (A0,D3.W),D0
02:0002E3D6 1B00            	   261:     move.b  D0,-(A5)  ; PHA
02:0002E3D8 0200003F        	   262:     andi.b #$3F,D0
02:0002E3DC 19400415        	   263:     move.b  D0,($0415,A4)
                            	   264:     ; Pop and mask the text selector byte with $C0 to get the
                            	   265:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   266:     ;
02:0002E3E0 101D            	   267:     move.b  (A5)+,D0  ; PLA
02:0002E3E2 020000C0        	   268:     andi.b #$C0,D0
02:0002E3E6 19400003        	   269:     move.b  D0,($0003,A4)
                            	   270:     ; At this point, the Y register still has the cave index.
                            	   271:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   272:     ;
02:0002E3EA 103C00FD        	   273:     move.b  #$FD,D0
                            	   274: _anon_z01_0:
02:0002E3EE 023C00EE        	   275:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E3F2 123C0003        	   276:     move.b  #$03,D1
02:0002E3F6 D101            	   277:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E3F8 5303            	   278:     subq.b  #1,D3
02:0002E3FA 6AF2            	   279:     bpl  _anon_z01_0
02:0002E3FC 7600            	   280:     moveq   #0,D3
02:0002E3FE 1600            	   281:     move.b  D0,D3
                            	   282:     ; Loop over the wares from 0 to 2.
                            	   283:     ;
02:0002E400 7400            	   284:     moveq   #0,D2
                            	   285:     even
                            	   286: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   287:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   288:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   289:     ;
02:0002E402 41F900FF6A7E    	   290:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E408 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002E40C 41EC0422        	   292:     lea     ($0422,A4),A0
02:0002E410 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   295:     ;
02:0002E414 020000C0        	   296:     andi.b #$C0,D0
02:0002E418 19802000        	   297:     move.b  D0,($00,A4,D2.W)
                            	   298:     ; Copy 3 prices from the Cave level block info.
                            	   299:     ;
02:0002E41C 41F900FF6ABA    	   300:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E422 10303000        	   301:     move.b  (A0,D3.W),D0
02:0002E426 41EC0430        	   302:     lea     ($0430,A4),A0
02:0002E42A 11802000        	   303:     move.b  D0,(A0,D2.W)
                            	   304:     ; Bottom of the wares copying loop.
                            	   305:     ;
02:0002E42E 5203            	   306:     addq.b  #1,D3
02:0002E430 5202            	   307:     addq.b  #1,D2
02:0002E432 0C020003        	   308:     cmpi.b  #$03,D2
02:0002E436 66CA            	   309:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   310:     ; Get the top 2 bits of text selector byte in [03],
                            	   311:     ; shift them to the bottom, and combine them with [00].
                            	   312:     ;
02:0002E438 102C0003        	   313:     move.b  ($0003,A4),D0
02:0002E43C E308            	   314:     lsl.b  #1,D0   ; ASL A
