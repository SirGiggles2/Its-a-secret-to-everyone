02:00044536 1002            	  7207:     move.b  D2,D0
02:00044538 1B00            	  7208:     move.b  D0,-(A5)  ; PHA
                            	  7209:     ; We're dealing with squares.
                            	  7210:     ; So, align the object's X coordinate with 16 pixels.
                            	  7211:     ;
02:0004453A 10342070        	  7212:     move.b  ($70,A4,D2.W),D0
02:0004453E 020000F0        	  7213:     andi.b #$F0,D0
                            	  7214:     ; Divide it by 4 to get the offset of the address of the column
                            	  7215:     ; in play area map.
                            	  7216:     ;
                            	  7217:     ; The calculation is: address offset = (X / 8) * 2
                            	  7218:     ; 8 for the width of the column; 2 for the width of the address
                            	  7219:     ;
02:00044542 E208            	  7220:     lsr.b  #1,D0   ; LSR A
02:00044544 E208            	  7221:     lsr.b  #1,D0   ; LSR A
02:00044546 7400            	  7222:     moveq   #0,D2
02:00044548 1400            	  7223:     move.b  D0,D2
                            	  7224:     ; Store the address of the column in [00:01].
                            	  7225:     ;
02:0004454A 41F90004A73C    	  7226:     lea     (PlayAreaColumnAddrs).l,A0
02:00044550 10302000        	  7227:     move.b  (A0,D2.W),D0
02:00044554 1880            	  7228:     move.b  D0,($0000,A4)
02:00044556 41F90004A73D    	  7229:     lea     (PlayAreaColumnAddrs+1).l,A0
02:0004455C 10302000        	  7230:     move.b  (A0,D2.W),D0
02:00044560 19400001        	  7231:     move.b  D0,($0001,A4)
02:00044564 101D            	  7232:     move.b  (A5)+,D0  ; PLA
02:00044566 1B00            	  7233:     move.b  D0,-(A5)  ; PHA
02:00044568 7400            	  7234:     moveq   #0,D2
02:0004456A 1400            	  7235:     move.b  D0,D2
                            	  7236:     ; Align the object's Y coordinate with 16 pixels.
                            	  7237:     ;
02:0004456C 41EC0084        	  7238:     lea     ($0084,A4),A0
02:00044570 10302000        	  7239:     move.b  (A0,D2.W),D0
02:00044574 020000F0        	  7240:     andi.b #$F0,D0
                            	  7241:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7242:     ; the height of each row.
                            	  7243:     ;
02:00044578 003C0011        	  7244:     ori     #$11,CCR  ; SEC: set C+X
02:0004457C 123C0040        	  7245:     move.b  #$40,D1
02:00044580 0A3C0010        	  7246:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044584 9101            	  7247:     subx.b  D1,D0   ; SBC #$40
02:00044586 0A3C0010        	  7248:     eori    #$10,CCR  ; restore X = 6502 C
02:0004458A E208            	  7249:     lsr.b  #1,D0   ; LSR A
02:0004458C E208            	  7250:     lsr.b  #1,D0   ; LSR A
02:0004458E E208            	  7251:     lsr.b  #1,D0   ; LSR A
                            	  7252:     ; Add this row offset to the column address.
                            	  7253:     ;
02:00044590 4EB9000313BA    	  7254:     jsr     AddToInt16At0
                            	  7255:     ; Assume that we'll write a type 1 square with primary square
                            	  7256:     ; taken from [05]. If so, the square index doesn't matter
                            	  7257:     ; as long as >= $10. See WriteSquareOW.
                            	  7258:     ;
02:00044596 7600            	  7259:     moveq   #0,D3
02:00044598 7410            	  7260:     moveq   #16,D2
02:0004459A 102C0005        	  7261:     move.b  ($0005,A4),D0
                            	  7262:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7263:     ; So, we have to look up the square index corresponding
                            	  7264:     ; to primary square/tile in [05].
                            	  7265:     ;
                            	  7266:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7267:     ; then the X register will have the square index value.
                            	  7268:     ;
02:0004459E 0C000027        	  7269:     cmpi.b  #$27,D0
02:000445A2 6506            	  7270:     bcs  _anon_z05_148
02:000445A4 0C0000F3        	  7271:     cmpi.b  #$F3,D0
02:000445A8 6514            	  7272:     bcs  _L_z05_ChangePlayMapSquareOW_Write
                            	  7273: _anon_z05_148:
02:000445AA 740E            	  7274:     moveq   #14,D2
                            	  7275: _anon_z05_149:
02:000445AC 41F900043F68    	  7276:     lea     (PrimarySquaresOW).l,A0
02:000445B2 12302000        	  7277:     move.b  (A0,D2.W),D1
02:000445B6 B001            	  7278:     cmp.b   D1,D0
02:000445B8 6704            	  7279:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:000445BA 5302            	  7280:     subq.b  #1,D2
02:000445BC 66EE            	  7281:     bne  _anon_z05_149
                            	  7282:     even
                            	  7283: _L_z05_ChangePlayMapSquareOW_Write:
                            	  7284:     ; Write the square.
                            	  7285:     ;
02:000445BE 1942000D        	  7286:     move.b  D2,($000D,A4)
02:000445C2 6100FCDA        	  7287:     jsr     WriteSquareOW
02:000445C6 101D            	  7288:     move.b  (A5)+,D0  ; PLA
02:000445C8 7400            	  7289:     moveq   #0,D2
02:000445CA 1400            	  7290:     move.b  D0,D2
02:000445CC 4E75            	  7291:     rts
                            	  7292: 
                            	  7293: ; Returns:
                            	  7294: ; [$00:01]: address of room tile map
                            	  7295:     even
