02:0003FF9C 003C0011        	 14116:     ori     #$11,CCR  ; SEC: set C+X
02:0003FFA0 123C0008        	 14117:     move.b  #$08,D1
02:0003FFA4 0A3C0010        	 14118:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FFA8 9101            	 14119:     subx.b  D1,D0   ; SBC #$08
