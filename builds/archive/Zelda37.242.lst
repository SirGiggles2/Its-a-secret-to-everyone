02:0004C1DA 1214            	  5088:     move.b  ($0000,A4),D1
02:0004C1DC 0A3C0010        	  5089:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C1E0 9101            	  5090:     subx.b  D1,D0   ; SBC $00
02:0004C1E2 0A3C0010        	  5091:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5092:     even
