                            	  3761: FormatHeartsInTextBuf:
                            	  3762:     ; [$0E]: hearts value
                            	  3763:     ; [$0F]: heart partial
                            	  3764:     ; Y: The offset of first character in buffer
                            	  3765:     ;
                            	  3766:     ; The end of the bottom row is $12 bytes after the
                            	  3767:     ; start of the top row. We're writing to two transfer
                            	  3768:     ; records. We write the top row in the first transfer
                            	  3769:     ; record wherever the caller chooses. The second
                            	  3770:     ; transfer record has to begin with the heart tiles.
                            	  3771:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3772:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3773:     ;
                            	  3774:     ; Store the starting offset in [$0D].
02:00030C22 1943000D        	  3775:     move.b  D3,($000D,A4)
02:00030C26 102C000E        	  3776:     move.b  ($000E,A4),D0
02:00030C2A 1B00            	  3777:     move.b  D0,-(A5)  ; PHA
02:00030C2C 0200000F        	  3778:     andi.b #$0F,D0
02:00030C30 1880            	  3779:     move.b  D0,($0000,A4)
02:00030C32 700F            	  3780:     moveq   #15,D0
02:00030C34 003C0011        	  3781:     ori     #$11,CCR  ; SEC: set C+X
02:00030C38 1214            	  3782:     move.b  ($0000,A4),D1
02:00030C3A 0A3C0010        	  3783:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C3E 9101            	  3784:     subx.b  D1,D0   ; SBC $00
02:00030C40 0A3C0010        	  3785:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C44 1880            	  3786:     move.b  D0,($0000,A4)
02:00030C46 101D            	  3787:     move.b  (A5)+,D0  ; PLA
02:00030C48 E208            	  3788:     lsr.b  #1,D0   ; LSR A
02:00030C4A E208            	  3789:     lsr.b  #1,D0   ; LSR A
02:00030C4C E208            	  3790:     lsr.b  #1,D0   ; LSR A
02:00030C4E E208            	  3791:     lsr.b  #1,D0   ; LSR A
02:00030C50 19400001        	  3792:     move.b  D0,($0001,A4)
02:00030C54 700F            	  3793:     moveq   #15,D0
02:00030C56 003C0011        	  3794:     ori     #$11,CCR  ; SEC: set C+X
02:00030C5A 122C0001        	  3795:     move.b  ($0001,A4),D1
02:00030C5E 0A3C0010        	  3796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C62 9101            	  3797:     subx.b  D1,D0   ; SBC $01
02:00030C64 0A3C0010        	  3798:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C68 19400001        	  3799:     move.b  D0,($0001,A4)
                            	  3800:     ; At this point,
                            	  3801:     ; [$00] = $F - hearts
