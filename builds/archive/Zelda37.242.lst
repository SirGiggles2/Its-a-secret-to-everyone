02:000453B2 1214            	  8887:     move.b  ($00,A4),D1   ; ptr lo
02:000453B4 182C0001        	  8888:     move.b  ($01,A4),D4  ; ptr hi
02:000453B8 024100FF        	  8889:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000453BC E14C            	  8890:     lsl.w   #8,D4
