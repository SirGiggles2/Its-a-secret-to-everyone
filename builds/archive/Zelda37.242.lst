02:0003C67E 41EC0437        	  6282:     lea     ($0437,A4),A0
02:0003C682 12302000        	  6283:     move.b  (A0,D2.W),D1
02:0003C686 B001            	  6284:     cmp.b   D1,D0
02:0003C688 6704            	  6285:     beq.s  __far_z_04_0053
02:0003C68A 6000009E        	  6286:     jmp  L116EA_Exit
                            	  6287: __far_z_04_0053:
02:0003C68E 41EC042C        	  6288:     lea     ($042C,A4),A0
02:0003C692 10302000        	  6289:     move.b  (A0,D2.W),D0
02:0003C696 41EC0444        	  6290:     lea     ($0444,A4),A0
02:0003C69A 12302000        	  6291:     move.b  (A0,D2.W),D1
02:0003C69E B001            	  6292:     cmp.b   D1,D0
02:0003C6A0 6704            	  6293:     beq.s  __far_z_04_0054
02:0003C6A2 60000086        	  6294:     jmp  L116EA_Exit
                            	  6295: __far_z_04_0054:
                            	  6296:     ; Set speed flag to 1 meaning decelerate.
