02:00033930 48C4            	   530:     ext.l   D4
02:00033932 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033938 2044            	   532:     movea.l D4,A0
02:0003393A 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003393E 41EC0633        	   534:     lea     ($0633,A4),A0
