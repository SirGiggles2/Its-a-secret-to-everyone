02:00030734 6712            	  3008:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3009:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  3010:     ;
