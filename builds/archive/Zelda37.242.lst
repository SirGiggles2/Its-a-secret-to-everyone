02:00036658 6032            	  4628:     jmp  LA9F4_Exit
                            	  4629: __far_z_02_0010:
                            	  4630:     ; Determine an index based on the high 2 bits of the character element:
                            	  4631:     ;   $80: 0
                            	  4632:     ;   $40: 1
                            	  4633:     ;   $C0: 2
                            	  4634:     ;
02:0003665A 7602            	  4635:     moveq   #2,D3
02:0003665C 0C0000C0        	  4636:     cmpi.b  #$C0,D0
02:00036660 670A            	  4637:     beq  _anon_z02_33
02:00036662 5303            	  4638:     subq.b  #1,D3
02:00036664 0C000040        	  4639:     cmpi.b  #$40,D0
02:00036668 6702            	  4640:     beq  _anon_z02_33
02:0003666A 5303            	  4641:     subq.b  #1,D3
                            	  4642: _anon_z02_33:
                            	  4643:     ; The index chooses the low VRAM address of the start
                            	  4644:     ; of another line:
                            	  4645:     ;   0: $C4: front of the second line
                            	  4646:     ;   1: $E4: front of the third line
                            	  4647:     ;   2: $A4: front of the first line
                            	  4648:     ;
02:0003666C 41F9000365B4    	  4649:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00036672 10303000        	  4650:     move.b  (A0,D3.W),D0
02:00036676 1940045F        	  4651:     move.b  D0,($045F,A4)
                            	  4652:     ; If index = 2, then we've reached the end of the text,
                            	  4653:     ; and low VRAM address is moved to the front of the first line.
                            	  4654:     ; So, advance the state of the person object, and unhalt Link.
                            	  4655:     ;
02:0003667A 0C030002        	  4656:     cmpi.b  #$02,D3
02:0003667E 6702            	  4657:     beq.s  __far_z_02_0011
02:00036680 600A            	  4658:     jmp  LA9F4_Exit
