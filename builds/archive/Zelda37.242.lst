02:000306D8 660000B2        	  2962:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2963:     ; State 0. Sensing.
                            	  2964:     ;
                            	  2965:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2966:     ; then go see if the horizontal distance is shorter.
                            	  2967:     ;
02:000306DC 102C0084        	  2968:     move.b  ($0084,A4),D0
02:000306E0 003C0011        	  2969:     ori     #$11,CCR  ; SEC: set C+X
02:000306E4 41EC0084        	  2970:     lea     ($0084,A4),A0
02:000306E8 12302000        	  2971:     move.b  (A0,D2.W),D1
02:000306EC 0A3C0010        	  2972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000306F0 9101            	  2973:     subx.b  D1,D0   ; SBC ObjY,X
02:000306F2 0A3C0010        	  2974:     eori    #$10,CCR  ; restore X = 6502 C
02:000306F6 6100086E        	  2975:     jsr     Abs
02:000306FA 0C00000E        	  2976:     cmpi.b  #$0E,D0
02:000306FE 644C            	  2977:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2978:     ; Determine the horizontal direction toward Link;
                            	  2979:     ; and if Link and the trap are at the same X, then we can't move
                            	  2980:     ; along this axis. Go see about moving vertically.
                            	  2981:     ;
02:00030700 7601            	  2982:     moveq   #1,D3
02:00030702 102C0070        	  2983:     move.b  ($0070,A4),D0
02:00030706 12342070        	  2984:     move.b  ($70,A4,D2.W),D1
02:0003070A B001            	  2985:     cmp.b   D1,D0
02:0003070C 673E            	  2986:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003070E 6402            	  2987:     bcc  _anon_z01_26
02:00030710 7602            	  2988:     moveq   #2,D3
                            	  2989: _anon_z01_26:
                            	  2990:     ; Remember the original X coordinate.
                            	  2991:     ;
02:00030712 10342070        	  2992:     move.b  ($70,A4,D2.W),D0
                            	  2993:     even
                            	  2994: _L_z01_UpdateTrap_Full_GoToState1:
02:00030716 41EC0380        	  2995:     lea     ($0380,A4),A0
02:0003071A 11802000        	  2996:     move.b  D0,(A0,D2.W)
                            	  2997:     ; Set facing direction to the horizontal one that we determined.
                            	  2998:     ;
