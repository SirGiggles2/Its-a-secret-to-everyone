02:00041D28 41F900FF6BB2    	  3398:     lea     (NES_SRAM+$0BB2).l,A0
02:00041D2E 12303000        	  3399:     move.b  (A0,D3.W),D1
02:00041D32 B001            	  3400:     cmp.b   D1,D0
02:00041D34 66F0            	  3401:     bne  _anon_z05_84
                            	  3402:     ; Add the value of the shortcut chosen to whatever index
                            	  3403:     ; the current room has in the array.
                            	  3404:     ;
                            	  3405:     ; This yields the index of one of the three shortcut rooms
                            	  3406:     ; after the current one.
                            	  3407:     ;
02:00041D36 1003            	  3408:     move.b  D3,D0
02:00041D38 023C00EE        	  3409:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D3C 1214            	  3410:     move.b  ($0000,A4),D1
02:00041D3E D101            	  3411:     addx.b  D1,D0   ; ADC $00
                            	  3412:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3413:     ;
02:00041D40 02000003        	  3414:     andi.b #$03,D0
02:00041D44 7600            	  3415:     moveq   #0,D3
02:00041D46 1600            	  3416:     move.b  D0,D3
02:00041D48 41F900FF6BB2    	  3417:     lea     (NES_SRAM+$0BB2).l,A0
02:00041D4E 10303000        	  3418:     move.b  (A0,D3.W),D0
                            	  3419: ; Params:
