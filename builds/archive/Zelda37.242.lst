02:0002E8B8 12302000        	   974:     move.b  (A0,D2.W),D1
02:0002E8BC B001            	   975:     cmp.b   D1,D0
02:0002E8BE 6404            	   976:     bcc.s  __far_z_01_0004
02:0002E8C0 6000EDA2        	   977:     jmp  Exit
