02:0003D034 7600            	  7643:     moveq   #0,D3
02:0003D036 41EC03E4        	  7644:     lea     ($03E4,A4),A0
02:0003D03A 16302000        	  7645:     move.b  (A0,D2.W),D3
02:0003D03E 671E            	  7646:     beq  _anon_z04_95
02:0003D040 023C00EE        	  7647:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D044 123C0003        	  7648:     move.b  #$03,D1
02:0003D048 D101            	  7649:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7650:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7651:     ;
                            	  7652:     ; Down has two frame images, but up only has one. By flipping
                            	  7653:     ; horizontally, you get two frame images.
                            	  7654:     ;
02:0003D04A 7600            	  7655:     moveq   #0,D3
02:0003D04C 41EC0098        	  7656:     lea     ($0098,A4),A0
