02:0003B0E4 41EC0098        	  3276:     lea     ($0098,A4),A0
02:0003B0E8 10302000        	  3277:     move.b  (A0,D2.W),D0
02:0003B0EC 0200000C        	  3278:     andi.b #$0C,D0
