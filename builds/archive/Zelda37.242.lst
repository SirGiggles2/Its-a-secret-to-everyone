                            	  3055: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3056:     ; State 1 and 2.
                            	  3057:     ;
                            	  3058:     ; Move in the direction it's facing.
                            	  3059:     ;
02:0003078C 41EC0098        	  3060:     lea     ($0098,A4),A0
02:00030790 10302000        	  3061:     move.b  (A0,D2.W),D0
02:00030794 1940000F        	  3062:     move.b  D0,($000F,A4)
02:00030798 4EB90004BAF0    	  3063:     jsr     MoveObject
