                            	  6155: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6156:     ; Digdogger is big, but room boundary checks and
                            	  6157:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6158:     ; Therefore, we have to check these things four times,
                            	  6159:     ; in different corners of the boss.
                            	  6160:     ;
                            	  6161:     ; Loop 4 times, from 0 to 3.
                            	  6162:     ;
02:0003C552 7600            	  6163:     moveq   #0,D3
02:0003C554 41EC0478        	  6164:     lea     ($0478,A4),A0
02:0003C558 16302000        	  6165:     move.b  (A0,D2.W),D3
                            	  6166:     ; Change the coordinates to one corner.
                            	  6167:     ;
02:0003C55C 10342070        	  6168:     move.b  ($70,A4,D2.W),D0
02:0003C560 023C00EE        	  6169:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C564 41F90003C418    	  6170:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C56A 12303000        	  6171:     move.b  (A0,D3.W),D1
02:0003C56E D101            	  6172:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C570 19802070        	  6173:     move.b  D0,($70,A4,D2.W)
02:0003C574 41EC0084        	  6174:     lea     ($0084,A4),A0
02:0003C578 10302000        	  6175:     move.b  (A0,D2.W),D0
02:0003C57C 023C00EE        	  6176:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C580 41F90003C41C    	  6177:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C586 12303000        	  6178:     move.b  (A0,D3.W),D1
02:0003C58A D101            	  6179:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C58C 41EC0084        	  6180:     lea     ($0084,A4),A0
02:0003C590 11802000        	  6181:     move.b  D0,(A0,D2.W)
                            	  6182:     ; Check the room boundary and object collisions in this temporary location.
                            	  6183:     ;
02:0003C594 6100375E        	  6184:     jsr     BoundFlyer
02:0003C598 4EB900031E34    	  6185:     jsr     CheckMonsterCollisions
                            	  6186:     ; Increase the loop index, and loop again until it = 4.
                            	  6187:     ;
02:0003C59E 41EC0478        	  6188:     lea     ($0478,A4),A0
02:0003C5A2 52302000        	  6189:     addq.b  #1,(A0,D2.W)
02:0003C5A6 41EC0478        	  6190:     lea     ($0478,A4),A0
02:0003C5AA 10302000        	  6191:     move.b  (A0,D2.W),D0
02:0003C5AE 0C000004        	  6192:     cmpi.b  #$04,D0
02:0003C5B2 659E            	  6193:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6194:     ; Restore the original coordinates.
                            	  6195:     ;
02:0003C5B4 101D            	  6196:     move.b  (A5)+,D0  ; PLA
02:0003C5B6 41EC0084        	  6197:     lea     ($0084,A4),A0
02:0003C5BA 11802000        	  6198:     move.b  D0,(A0,D2.W)
02:0003C5BE 101D            	  6199:     move.b  (A5)+,D0  ; PLA
02:0003C5C0 19802070        	  6200:     move.b  D0,($70,A4,D2.W)
02:0003C5C4 6100026E        	  6201:     jsr     Digdogger_Draw
