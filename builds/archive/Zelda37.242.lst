02:0003C2B6 101D            	  5711:     move.b  (A5)+,D0  ; PLA
02:0003C2B8 41EC0098        	  5712:     lea     ($0098,A4),A0
02:0003C2BC 11802000        	  5713:     move.b  D0,(A0,D2.W)
                            	  5714:     ; If this segment is still alive, then return.
                            	  5715:     ;
02:0003C2C0 41EC0405        	  5716:     lea     ($0405,A4),A0
02:0003C2C4 10302000        	  5717:     move.b  (A0,D2.W),D0
02:0003C2C8 6774            	  5718:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5719:     ; This segment is dead. We'll swap the tail segment with this
                            	  5720:     ; dead segment. This way, moldorm heads are always rooted
                            	  5721:     ; in slots 5 and $A; and the segments are continguous.
                            	  5722:     ;
                            	  5723:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5724:     ;
                            	  5725:     ; Note that this is not a true swap, because the tail's HP
                            	  5726:     ; might be less than $20.
                            	  5727:     ;
02:0003C2CA 7020            	  5728:     moveq   #32,D0
02:0003C2CC 41EC0485        	  5729:     lea     ($0485,A4),A0
02:0003C2D0 11802000        	  5730:     move.b  D0,(A0,D2.W)
02:0003C2D4 61000608        	  5731:     jsr     CheckBossHitReaction
                            	  5732:     ; Look for the tail segment, starting from the low end
                            	  5733:     ; of the chain that this dead segment belongs to.
                            	  5734:     ;
02:0003C2D8 163C00FF        	  5735:     move.b  #$FF,D3
02:0003C2DC 0C020006        	  5736:     cmpi.b  #$06,D2
02:0003C2E0 6502            	  5737:     bcs  _anon_z04_80
02:0003C2E2 7604            	  5738:     moveq   #4,D3
                            	  5739: _anon_z04_80:
