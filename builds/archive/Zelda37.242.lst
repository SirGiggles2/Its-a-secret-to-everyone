02:0004C548 0C000030        	  5605:     cmpi.b  #$30,D0
02:0004C54C 6656            	  5606:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5607:     ; State $3x. Slow down.
                            	  5608:     ;
                            	  5609:     ; Reset grid offset for movement.
                            	  5610:     ;
