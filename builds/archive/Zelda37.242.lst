02:0002E856 10302000        	   922:     move.b  (A0,D2.W),D0
02:0002E85A 0200003F        	   923:     andi.b #$3F,D0
02:0002E85E 0C00003F        	   924:     cmpi.b  #$3F,D0
02:0002E862 6732            	   925:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   926:     ; If Link's X <> item's X, then loop again.
