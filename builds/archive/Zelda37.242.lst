                            	  7348: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D2A4 7400            	  7349:     moveq   #0,D2
02:0004D2A6 142C0340        	  7350:     move.b  ($0340,A4),D2
                            	  7351:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7352:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7353:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7354:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7355:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7356:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7357:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7358:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7359:     ; corrupting them and causing a deterministic address-error
                            	  7360:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7361:     ; identified by Codex static review.)
                            	  7362: _L_z07_P47_pre_check:
02:0004D2AA 102C0525        	  7363:     move.b  ($0525,A4),D0
02:0004D2AE 020000F0        	  7364:     andi.b  #$F0,D0
02:0004D2B2 0C000040        	  7365:     cmpi.b  #$40,D0
02:0004D2B6 6506            	  7366:     blo     _L_z07_P47_pre_snap
02:0004D2B8 0C0000E0        	  7367:     cmpi.b  #$E0,D0
02:0004D2BC 6506            	  7368:     blo     _L_z07_P47_pre_ok
                            	  7369: _L_z07_P47_pre_snap:
02:0004D2BE 197C00480525    	  7370:     move.b  #$48,($0525,A4)
                            	  7371: _L_z07_P47_pre_ok:
02:0004D2C4 7005            	  7372:     moveq   #5,D0
02:0004D2C6 610004F4        	  7373:     jsr     SwitchBank
02:0004D2CA 4EB900041EF8    	  7374:     jsr     FindNextEdgeSpawnCell
                            	  7375:     ; Post-walk 1: bottom-edge snap.
02:0004D2D0 102C0525        	  7376:     move.b  ($0525,A4),D0
02:0004D2D4 020000F0        	  7377:     andi.b  #$F0,D0
02:0004D2D8 0C0000E0        	  7378:     cmpi.b  #$E0,D0
02:0004D2DC 660C            	  7379:     bne     _L_z07_P47_post1_ok
02:0004D2DE 197C00480525    	  7380:     move.b  #$48,($0525,A4)
02:0004D2E4 4EB900041EF8    	  7381:     jsr     FindNextEdgeSpawnCell
                            	  7382: _L_z07_P47_post1_ok:
                            	  7383:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7384:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D2EA 7600            	  7385:     moveq   #0,D3
02:0004D2EC 162C0525        	  7386:     move.b  ($0525,A4),D3
02:0004D2F0 0243000F        	  7387:     andi.w  #$000F,D3
02:0004D2F4 C6FC002C        	  7388:     mulu.w  #44,D3
02:0004D2F8 203C00FF6530    	  7389:     move.l  #$FF6530,D0
02:0004D2FE D083            	  7390:     add.l   D3,D0
02:0004D300 7600            	  7391:     moveq   #0,D3
02:0004D302 162C0525        	  7392:     move.b  ($0525,A4),D3
02:0004D306 E84B            	  7393:     lsr.w   #4,D3
02:0004D308 5943            	  7394:     subi.w  #4,D3
02:0004D30A E34B            	  7395:     lsl.w   #1,D3
02:0004D30C D083            	  7396:     add.l   D3,D0
02:0004D30E 2040            	  7397:     movea.l D0,A0
02:0004D310 1010            	  7398:     move.b  (A0),D0
02:0004D312 0C000084        	  7399:     cmpi.b  #$84,D0
02:0004D316 6544            	  7400:     blo     _L_z07_P47_post2_ok
                            	  7401:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7402:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7403:     ; writes to the $05xx region.
02:0004D318 7800            	  7404:     moveq   #0,D4
                            	  7405: _L_z07_P47_fb_loop:
02:0004D31A 41FAE48C        	  7406:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D31E 12304000        	  7407:     move.b  (A0,D4.W),D1
02:0004D322 19410525        	  7408:     move.b  D1,($0525,A4)
                            	  7409:     ; Validate fallback cell walkable.
02:0004D326 7600            	  7410:     moveq   #0,D3
02:0004D328 1601            	  7411:     move.b  D1,D3
02:0004D32A 0243000F        	  7412:     andi.w  #$000F,D3
02:0004D32E C6FC002C        	  7413:     mulu.w  #44,D3
02:0004D332 203C00FF6530    	  7414:     move.l  #$FF6530,D0
02:0004D338 D083            	  7415:     add.l   D3,D0
02:0004D33A 7600            	  7416:     moveq   #0,D3
02:0004D33C 1601            	  7417:     move.b  D1,D3
02:0004D33E E84B            	  7418:     lsr.w   #4,D3
02:0004D340 5943            	  7419:     subi.w  #4,D3
02:0004D342 E34B            	  7420:     lsl.w   #1,D3
02:0004D344 D083            	  7421:     add.l   D3,D0
02:0004D346 2040            	  7422:     movea.l D0,A0
02:0004D348 0C100084        	  7423:     cmpi.b  #$84,(A0)
02:0004D34C 650E            	  7424:     blo     _L_z07_P47_post2_ok
02:0004D34E 5204            	  7425:     addq.b  #1,D4
02:0004D350 0C040008        	  7426:     cmpi.b  #8,D4
02:0004D354 65C4            	  7427:     blo     _L_z07_P47_fb_loop
                            	  7428:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7429:     ; rather than looping).
02:0004D356 197C00480525    	  7430:     move.b  #$48,($0525,A4)
                            	  7431: _L_z07_P47_post2_ok:
                            	  7432:     ; Extract and set the monster's location.
                            	  7433:     ;
02:0004D35C 102C0525        	  7434:     move.b  ($0525,A4),D0
                            	  7435:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7436:     ;
02:0004D360 1B00            	  7437:     move.b  D0,-(A5)  ; PHA
02:0004D362 E308            	  7438:     lsl.b  #1,D0   ; ASL A
02:0004D364 E308            	  7439:     lsl.b  #1,D0   ; ASL A
02:0004D366 E308            	  7440:     lsl.b  #1,D0   ; ASL A
02:0004D368 E308            	  7441:     lsl.b  #1,D0   ; ASL A
02:0004D36A 19802070        	  7442:     move.b  D0,($70,A4,D2.W)
                            	  7443:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7444:     ;
02:0004D36E 101D            	  7445:     move.b  (A5)+,D0  ; PLA
02:0004D370 020000F0        	  7446:     andi.b #$F0,D0
02:0004D374 003C0011        	  7447:     ori     #$11,CCR  ; SEC: set C+X
02:0004D378 123C0003        	  7448:     move.b  #$03,D1
02:0004D37C 0A3C0010        	  7449:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D380 9101            	  7450:     subx.b  D1,D0   ; SBC #$03
02:0004D382 0A3C0010        	  7451:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D386 41EC0084        	  7452:     lea     ($0084,A4),A0
02:0004D38A 11802000        	  7453:     move.b  D0,(A0,D2.W)
                            	  7454:     ; Set the monsters-from-edges long timer to a random value
                            	  7455:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7456:     ;
02:0004D38E 10342019        	  7457:     move.b  ($19,A4,D2.W),D0
02:0004D392 02000003        	  7458:     andi.b #$03,D0
02:0004D396 023C00EE        	  7459:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D39A 123C0002        	  7460:     move.b  #$02,D1
02:0004D39E D101            	  7461:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004D3A0 1940004B        	  7462:     move.b  D0,($004B,A4)
                            	  7463:     ; If the distance to Link is too close to Link, then
                            	  7464:     ; go flag the monster uninitialized again, so we can
                            	  7465:     ; try to spawn it again next time.
                            	  7466:     ;
02:0004D3A4 7005            	  7467:     moveq   #5,D0
02:0004D3A6 61000414        	  7468:     jsr     SwitchBank
02:0004D3AA 4EB90004150A    	  7469:     jsr     IsDistanceSafeToSpawn
