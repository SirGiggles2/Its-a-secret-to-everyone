02:00036C54 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:00036C58 102C050D        	  5192:     move.b  ($050D,A4),D0
02:00036C5C 7600            	  5193:     moveq   #0,D3
