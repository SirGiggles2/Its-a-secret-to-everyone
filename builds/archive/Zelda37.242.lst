02:0003A6FA 6720            	  1823:     beq  _L_z04_Gel_MoveSplitting_Exit
                            	  1824:     ; Move.
                            	  1825:     ;
02:0003A6FC 4EB90004BAF0    	  1826:     jsr     MoveObject
