02:0003069A D101            	  2936:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003069C 7400            	  2937:     moveq   #0,D2
02:0003069E 1400            	  2938:     move.b  D0,D2
                            	  2939:     ; Look up and set the location for this iteration's individual trap.
                            	  2940:     ;
02:000306A0 41F900030664    	  2941:     lea     (TrapXs).l,A0
02:000306A6 10303000        	  2942:     move.b  (A0,D3.W),D0
02:000306AA 19802070        	  2943:     move.b  D0,($70,A4,D2.W)
02:000306AE 41F90003066A    	  2944:     lea     (TrapYs).l,A0
02:000306B4 10303000        	  2945:     move.b  (A0,D3.W),D0
02:000306B8 41EC0084        	  2946:     lea     ($0084,A4),A0
02:000306BC 11802000        	  2947:     move.b  D0,(A0,D2.W)
02:000306C0 619E            	  2948:     jsr     InitOneSimpleObject
