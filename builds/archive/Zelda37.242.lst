02:0004C198 8001            	  5059:     or.b  D1,D0
02:0004C19A 4EB900031DAA    	  5060:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5061:     ; Add the object's X (the center of the spread) and the
                            	  5062:     ; current offset in [02] to set sprite X in [00].
                            	  5063:     ;
02:0004C1A0 10342070        	  5064:     move.b  ($70,A4,D2.W),D0
02:0004C1A4 023C00EE        	  5065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1A8 122C0002        	  5066:     move.b  ($0002,A4),D1
02:0004C1AC D101            	  5067:     addx.b  D1,D0   ; ADC $02
02:0004C1AE 1880            	  5068:     move.b  D0,($0000,A4)
                            	  5069:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5070:     ; Else calculate the distance from object X to sprite X.
                            	  5071:     ;
02:0004C1B0 12342070        	  5072:     move.b  ($70,A4,D2.W),D1
02:0004C1B4 B001            	  5073:     cmp.b   D1,D0
02:0004C1B6 651A            	  5074:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C1B8 0C0000FC        	  5075:     cmpi.b  #$FC,D0
02:0004C1BC 6466            	  5076:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C1BE 003C0011        	  5077:     ori     #$11,CCR  ; SEC: set C+X
02:0004C1C2 12342070        	  5078:     move.b  ($70,A4,D2.W),D1
02:0004C1C6 0A3C0010        	  5079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C1CA 9101            	  5080:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C1CC 0A3C0010        	  5081:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C1D0 6014            	  5082:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5083: 
