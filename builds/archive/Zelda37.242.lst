02:00033948 1003            	   537:     move.b  D3,D0
02:0003394A 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003394C 19430016        	   539:     move.b  D3,($0016,A4)
02:00033950 6100D206        	   540:     jsr     FetchFileAAddressSet
02:00033954 61001C3C        	   541:     jsr     FormatFileA
