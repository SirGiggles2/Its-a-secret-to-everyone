02:0002E730 6100C2C8        	   743:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E734 4EB90004BD84    	   744:     jsr     Link_EndMoveAndDraw_Bank1
                            	   745:     ; If the person's timer has not expired, then return.
                            	   746:     ;
