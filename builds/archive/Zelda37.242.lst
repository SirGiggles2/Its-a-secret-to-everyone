                            	   827: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   828:     ; If the difference in coordinates is negative, then Link is
                            	   829:     ; up or left of the block.
                            	   830:     ;
                            	   831:     ; In that case, increase Y register to index the correct opposite
                            	   832:     ; direction below. Also, negate the difference, so we test
                            	   833:     ; positive values.
                            	   834:     ;
02:00039FBA 6A08            	   835:     bpl  _anon_z04_14
02:00039FBC 5203            	   836:     addq.b  #1,D3
02:00039FBE 4EB900030F6A    	   837:     jsr     Negate
                            	   838: _anon_z04_14:
                            	   839:     ; If the distance >= $11, then go reset the push timer and return.
                            	   840:     ;
02:00039FC4 0C000011        	   841:     cmpi.b  #$11,D0
02:00039FC8 6502            	   842:     bcs.s  __far_z_04_0007
02:00039FCA 605C            	   843:     jmp  ResetPushTimer
                            	   844: __far_z_04_0007:
                            	   845:     ; At this point, Link is aligned with the block.
                            	   846:     ;
                            	   847:     ; If the input direction is not the required direction based on
                            	   848:     ; Link's placement; then go reset the push timer and return.
                            	   849:     ;
02:00039FCC 102C03F8        	   850:     move.b  ($03F8,A4),D0
02:00039FD0 41F900039F24    	   851:     lea     (BlockPushDirections).l,A0
02:00039FD6 12303000        	   852:     move.b  (A0,D3.W),D1
02:00039FDA B001            	   853:     cmp.b   D1,D0
02:00039FDC 6702            	   854:     beq.s  __far_z_04_0008
02:00039FDE 6048            	   855:     jmp  ResetPushTimer
