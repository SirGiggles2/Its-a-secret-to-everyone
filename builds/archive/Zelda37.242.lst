02:00031020 102C0004        	  4383:     move.b  ($0004,A4),D0
02:00031024 19400003        	  4384:     move.b  D0,($0003,A4)
02:00031028 101D            	  4385:     move.b  (A5)+,D0  ; PLA
02:0003102A 19400004        	  4386:     move.b  D0,($0004,A4)
02:0003102E 7001            	  4387:     moveq   #1,D0
02:00031030 19400001        	  4388:     move.b  D0,($0001,A4)
                            	  4389:     even
                            	  4390: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4391:     ; TODO: call it speed index or angle?
