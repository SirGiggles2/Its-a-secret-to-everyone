                            	  4106: PondFairy_MoveHearts:
                            	  4107:     ; Loop over each heart from object slot 2 to 9.
                            	  4108:     ;
                            	  4109:     ; Even though they are not standalone objects, their info
                            	  4110:     ; is stored in those object slots.
                            	  4111:     ;
02:0003B65E 7402            	  4112:     moveq   #2,D2
                            	  4113:     even
                            	  4114: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4115:     ; If the current heart's state <> 0, then go move it.
                            	  4116:     ; Else we have to wait for it to come out at the right time.
                            	  4117:     ;
02:0003B660 41EC00AC        	  4118:     lea     ($00AC,A4),A0
02:0003B664 10302000        	  4119:     move.b  (A0,D2.W),D0
02:0003B668 667C            	  4120:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4121:     ; The current heart's state = 0.
                            	  4122:     ;
                            	  4123:     ; If object slot = 2, then go make it appear. This is the first
                            	  4124:     ; heart to show up.
                            	  4125:     ;
02:0003B66A 0C020002        	  4126:     cmpi.b  #$02,D2
02:0003B66E 6732            	  4127:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4128:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4129:     ; go start over.
                            	  4130:     ;
                            	  4131:     ; TODO:
                            	  4132:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4133:     ;
02:0003B670 102C00AE        	  4134:     move.b  ($00AE,A4),D0
02:0003B674 67EA            	  4135:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4136:     ; Look up the starting angle of this heart with the index
                            	  4137:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4138:     ; then loop again.
                            	  4139:     ;
02:0003B676 1002            	  4140:     move.b  D2,D0
02:0003B678 003C0011        	  4141:     ori     #$11,CCR  ; SEC: set C+X
02:0003B67C 123C0003        	  4142:     move.b  #$03,D1
02:0003B680 0A3C0010        	  4143:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B684 9101            	  4144:     subx.b  D1,D0   ; SBC #$03
02:0003B686 0A3C0010        	  4145:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B68A 7600            	  4146:     moveq   #0,D3
02:0003B68C 1600            	  4147:     move.b  D0,D3
02:0003B68E 102C0396        	  4148:     move.b  ($0396,A4),D0
02:0003B692 41F90003B656    	  4149:     lea     (PondHeartStartAngles).l,A0
02:0003B698 12303000        	  4150:     move.b  (A0,D3.W),D1
02:0003B69C B001            	  4151:     cmp.b   D1,D0
02:0003B69E 66000086        	  4152:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4153:     even
                            	  4154: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  4155:     ; Set up this heart. Set its state to 1.
                            	  4156:     ;
02:0003B6A2 41EC00AC        	  4157:     lea     ($00AC,A4),A0
02:0003B6A6 52302000        	  4158:     addq.b  #1,(A0,D2.W)
                            	  4159:     ; TODO: ?
