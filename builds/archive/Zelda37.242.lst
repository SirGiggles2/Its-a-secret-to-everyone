                            	  7144: Dodongo_CheckBombHit:
                            	  7145:     ; If state <> 0 (not moving), then return.
                            	  7146:     ;
02:0003CD06 41EC00AC        	  7147:     lea     ($00AC,A4),A0
02:0003CD0A 10302000        	  7148:     move.b  (A0,D2.W),D0
02:0003CD0E 66000086        	  7149:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7150:     ; If facing vertically, then store (X + 8) in [00].
                            	  7151:     ; Else store (X + $10).
                            	  7152:     ;
02:0003CD12 10342070        	  7153:     move.b  ($70,A4,D2.W),D0
02:0003CD16 023C00EE        	  7154:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD1A 123C0008        	  7155:     move.b  #$08,D1
02:0003CD1E D101            	  7156:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD20 7600            	  7157:     moveq   #0,D3
02:0003CD22 41EC0098        	  7158:     lea     ($0098,A4),A0
02:0003CD26 16302000        	  7159:     move.b  (A0,D2.W),D3
02:0003CD2A 0C030004        	  7160:     cmpi.b  #$04,D3
02:0003CD2E 6406            	  7161:     bcc  _anon_z04_91
02:0003CD30 123C0008        	  7162:     move.b  #$08,D1
02:0003CD34 D101            	  7163:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7164: _anon_z04_91:
02:0003CD36 1880            	  7165:     move.b  D0,($0000,A4)
                            	  7166:     ; Store (Y + 8) in [01].
                            	  7167:     ;
02:0003CD38 41EC0084        	  7168:     lea     ($0084,A4),A0
02:0003CD3C 10302000        	  7169:     move.b  (A0,D2.W),D0
02:0003CD40 123C0008        	  7170:     move.b  #$08,D1
02:0003CD44 D101            	  7171:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD46 19400001        	  7172:     move.b  D0,($0001,A4)
                            	  7173:     ; Only check the first bomb slot ($10).
                            	  7174:     ;
                            	  7175:     ; Store the bomb's (X + 8) in [02].
                            	  7176:     ;
02:0003CD4A 7610            	  7177:     moveq   #16,D3
02:0003CD4C 10343070        	  7178:     move.b  ($70,A4,D3.W),D0
02:0003CD50 123C0008        	  7179:     move.b  #$08,D1
02:0003CD54 D101            	  7180:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD56 19400002        	  7181:     move.b  D0,($0002,A4)
                            	  7182:     ; Store the bomb's (Y + 8) in [03].
                            	  7183:     ;
02:0003CD5A 41EC0084        	  7184:     lea     ($0084,A4),A0
02:0003CD5E 10303000        	  7185:     move.b  (A0,D3.W),D0
02:0003CD62 123C0008        	  7186:     move.b  #$08,D1
02:0003CD66 D101            	  7187:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD68 19400003        	  7188:     move.b  D0,($0003,A4)
                            	  7189:     ; But, if there's no bomb, then return.
                            	  7190:     ;
02:0003CD6C 41EC00AC        	  7191:     lea     ($00AC,A4),A0
02:0003CD70 10303000        	  7192:     move.b  (A0,D3.W),D0
02:0003CD74 6720            	  7193:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7194:     ; If the bomb has not exploded (state $12), then
                            	  7195:     ; go see if Dodongo will eat it.
                            	  7196:     ;
02:0003CD76 0C000012        	  7197:     cmpi.b  #$12,D0
02:0003CD7A 6602            	  7198:     bne.s  __far_z_04_0065
02:0003CD7C 601A            	  7199:     jmp  Dodongo_TryEatBomb
                            	  7200: __far_z_04_0065:
                            	  7201:     ; If the object in the slot is actually a fire, then return.
                            	  7202:     ;
02:0003CD7E 0C000020        	  7203:     cmpi.b  #$20,D0
02:0003CD82 6412            	  7204:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7205:     ; The bomb already blew up.
                            	  7206:     ; If the dust cloud is in range of the monster,
                            	  7207:     ; then set stunned state (2).
                            	  7208:     ;
02:0003CD84 7600            	  7209:     moveq   #0,D3
02:0003CD86 61000082        	  7210:     jsr     Dodongo_IsBombInRange
02:0003CD8A 660A            	  7211:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003CD8C 7002            	  7212:     moveq   #2,D0
02:0003CD8E 41EC00AC        	  7213:     lea     ($00AC,A4),A0
02:0003CD92 11802000        	  7214:     move.b  D0,(A0,D2.W)
                            	  7215:     even
