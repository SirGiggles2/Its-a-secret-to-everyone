02:0003A702 41EC0394        	  1830:     lea     ($0394,A4),A0
02:0003A706 10302000        	  1831:     move.b  (A0,D2.W),D0
02:0003A70A 0200000F        	  1832:     andi.b #$0F,D0
02:0003A70E 023C00EE        	  1833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A712 6608            	  1834:     bne  _L_z04_Gel_MoveSplitting_Exit
02:0003A714 41EC0394        	  1835:     lea     ($0394,A4),A0
02:0003A718 11802000        	  1836:     move.b  D0,(A0,D2.W)
                            	  1837:     even
