                            	  4169:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4170:     ;
02:0003B6C0 102C0071        	  4171:     move.b  ($0071,A4),D0
02:0003B6C4 19802070        	  4172:     move.b  D0,($70,A4,D2.W)
                            	  4173:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
