                            	  8296:     ; decrement the distance remaining, and move.
                            	  8297:     ;
02:0003D562 41EC0394        	  8298:     lea     ($0394,A4),A0
02:0003D566 10302000        	  8299:     move.b  (A0,D2.W),D0
02:0003D56A 670A            	  8300:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D56C 41EC0394        	  8301:     lea     ($0394,A4),A0
