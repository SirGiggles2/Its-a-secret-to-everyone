                            	  6498: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6499:     ; Link and the shot are facing opposite directions.
                            	  6500:     ; Link can parry certain weapons/shots.
                            	  6501:     ;
                            	  6502:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6503:     ; no harmful collision; but it still counts as a shot collision.
                            	  6504:     ; So, go treat this as a parry.
                            	  6505:     ;
02:00032082 41EC034F        	  6506:     lea     ($034F,A4),A0
02:00032086 10302000        	  6507:     move.b  (A0,D2.W),D0
02:0003208A 0C000055        	  6508:     cmpi.b  #$55,D0
02:0003208E 650E            	  6509:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00032090 0C00005B        	  6510:     cmpi.b  #$5B,D0
02:00032094 6408            	  6511:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6512:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6513:     ; So, go harm Link.
                            	  6514:     ;
02:00032096 102C0676        	  6515:     move.b  ($0676,A4),D0
02:0003209A 6602            	  6516:     bne.s  __far_z_01_0066
02:0003209C 600E            	  6517:     jmp  HarmLink
                            	  6518: __far_z_01_0066:
                            	  6519:     even
                            	  6520: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6521:     ; Else Link parries.
                            	  6522:     ;
                            	  6523:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6524:     ;
02:0003209E 7001            	  6525:     moveq   #1,D0
02:000320A0 19400604        	  6526:     move.b  D0,($0604,A4)
02:000320A4 7000            	  6527:     moveq   #0,D0
02:000320A6 19400006        	  6528:     move.b  D0,($0006,A4)
                            	  6529:     even
