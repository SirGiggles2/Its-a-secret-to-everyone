                            	  4212: CheckTiles:
                            	  4213:     ifne TURBO_LINK
                            	  4214:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4215:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004BC06 4A02            	  4216:     tst.b   D2
