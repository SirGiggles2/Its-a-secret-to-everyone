                            	  2748:     ; Link is facing vertically.
                            	  2749:     ;
                            	  2750:     ; If Link touched the left side of the square with the right side
                            	  2751:     ; of his body, then add 8 to X.
                            	  2752:     ;
                            	  2753:     ; If Link touched the right side of the square with the left side
                            	  2754:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2755:     ;
02:00030544 102C0002        	  2756:     move.b  ($0002,A4),D0
