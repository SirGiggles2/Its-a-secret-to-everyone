02:0003A2FC 41EC0451        	  1268:     lea     ($0451,A4),A0
02:0003A300 11802000        	  1269:     move.b  D0,(A0,D2.W)
                            	  1270:     ; Second, load the vertical direction into [0F].
                            	  1271:     ;
02:0003A304 41EC0437        	  1272:     lea     ($0437,A4),A0
02:0003A308 10302000        	  1273:     move.b  (A0,D2.W),D0
02:0003A30C 1940000F        	  1274:     move.b  D0,($000F,A4)
                            	  1275:     ; Load the vertical q-speed and position fraction,
                            	  1276:     ; move, then save the position fraction.
                            	  1277:     ;
02:0003A310 41EC0444        	  1278:     lea     ($0444,A4),A0
02:0003A314 10302000        	  1279:     move.b  (A0,D2.W),D0
02:0003A318 7600            	  1280:     moveq   #0,D3
02:0003A31A 41EC045E        	  1281:     lea     ($045E,A4),A0
