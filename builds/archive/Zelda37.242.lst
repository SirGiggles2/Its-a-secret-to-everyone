                            	  7471:     ; OK to spawn.
                            	  7472:     ; In this situation, monsters don't spawn from a cloud.
                            	  7473:     ;
02:0004D3B4 7000            	  7474:     moveq   #0,D0
02:0004D3B6 41EC0405        	  7475:     lea     ($0405,A4),A0
02:0004D3BA 11802000        	  7476:     move.b  D0,(A0,D2.W)
                            	  7477:     even
