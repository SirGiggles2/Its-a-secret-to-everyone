                            	 11910: Lamnola_Move:
                            	 11911:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11912:     ;
                            	 11913:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11914:     ;
                            	 11915:     ; Start with a mask of $A1 in [02]:
                            	 11916:     ; - low nibble represents the right direction
                            	 11917:     ; - high nibble is used to set or clear carry as we go along
                            	 11918:     ;
02:0003F05E 103C00A1        	 11919:     move.b  #$A1,D0
02:0003F062 19400002        	 11920:     move.b  D0,($0002,A4)
                            	 11921:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11922:     ;
02:0003F066 41EC0098        	 11923:     lea     ($0098,A4),A0
02:0003F06A 10302000        	 11924:     move.b  (A0,D2.W),D0
02:0003F06E 122C0002        	 11925:     move.b  ($0002,A4),D1
02:0003F072 C200            	 11926:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F074 6712            	 11927:     beq  _L_z04_Lamnola_Move_Left
02:0003F076 10342070        	 11928:     move.b  ($70,A4,D2.W),D0
02:0003F07A 023C00EE        	 11929:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F07E 122C04E6        	 11930:     move.b  ($04E6,A4),D1
02:0003F082 D101            	 11931:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003F084 19802070        	 11932:     move.b  D0,($70,A4,D2.W)
                            	 11933:     even
                            	 11934: _L_z04_Lamnola_Move_Left:
                            	 11935:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11936:     ;
02:0003F088 41EC0098        	 11937:     lea     ($0098,A4),A0
02:0003F08C 10302000        	 11938:     move.b  (A0,D2.W),D0
02:0003F090 122C0002        	 11939:     move.b  ($0002,A4),D1
02:0003F094 E309            	 11940:     lsl.b  #1,D1   ; ASL $02
02:0003F096 19410002        	 11941:     move.b  D1,($0002,A4)
02:0003F09A 122C0002        	 11942:     move.b  ($0002,A4),D1
02:0003F09E C200            	 11943:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0A0 6716            	 11944:     beq  _L_z04_Lamnola_Move_Down
02:0003F0A2 10342070        	 11945:     move.b  ($70,A4,D2.W),D0
02:0003F0A6 122C04E6        	 11946:     move.b  ($04E6,A4),D1
02:0003F0AA 0A3C0010        	 11947:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0AE 9101            	 11948:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003F0B0 0A3C0010        	 11949:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0B4 19802070        	 11950:     move.b  D0,($70,A4,D2.W)
                            	 11951:     even
