                            	  5098:     ; Add the object's Y (the center of the spread) and the
                            	  5099:     ; current offset in [03] to set sprite Y in [01].
                            	  5100:     ;
02:0004C1EC 41EC0084        	  5101:     lea     ($0084,A4),A0
02:0004C1F0 10302000        	  5102:     move.b  (A0,D2.W),D0
02:0004C1F4 023C00EE        	  5103:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1F8 122C0003        	  5104:     move.b  ($0003,A4),D1
