                            	  1553:     ; Check collisions.
                            	  1554:     ;
                            	  1555:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1556:     ; then return.
                            	  1557:     ;
02:0003A524 610001F8        	  1558:     jsr     Gel_CheckCollisions
02:0003A528 41EC0405        	  1559:     lea     ($0405,A4),A0
02:0003A52C 10302000        	  1560:     move.b  (A0,D2.W),D0
02:0003A530 664E            	  1561:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A532 41EC04F0        	  1562:     lea     ($04F0,A4),A0
02:0003A536 10302000        	  1563:     move.b  (A0,D2.W),D0
02:0003A53A 6744            	  1564:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1565:     ; If vertically aligned with the square grid, then
                            	  1566:     ; use a horizontal direction mask (3).
                            	  1567:     ;
                            	  1568:     ; Keep in mind that most objects are aligned vertically when
                            	  1569:     ; the low nibble of their Y is $D.
                            	  1570:     ;
02:0003A53C 7600            	  1571:     moveq   #0,D3
02:0003A53E 41EC0084        	  1572:     lea     ($0084,A4),A0
02:0003A542 10302000        	  1573:     move.b  (A0,D2.W),D0
02:0003A546 0200000F        	  1574:     andi.b #$0F,D0
02:0003A54A 0C00000D        	  1575:     cmpi.b  #$0D,D0
02:0003A54E 6602            	  1576:     bne  _anon_z04_26
02:0003A550 7603            	  1577:     moveq   #3,D3
                            	  1578: _anon_z04_26:
02:0003A552 1883            	  1579:     move.b  D3,($0000,A4)
                            	  1580:     ; If horizontally aligned with the square grid, then
                            	  1581:     ; use a vertical direction mask ($C).
                            	  1582:     ;
02:0003A554 7600            	  1583:     moveq   #0,D3
02:0003A556 10342070        	  1584:     move.b  ($70,A4,D2.W),D0
02:0003A55A 0200000F        	  1585:     andi.b #$0F,D0
02:0003A55E 6602            	  1586:     bne  _anon_z04_27
02:0003A560 760C            	  1587:     moveq   #12,D3
                            	  1588: _anon_z04_27:
02:0003A562 1003            	  1589:     move.b  D3,D0
                            	  1590:     ; Combine the two masks. At most one will be 0.
                            	  1591:     ;
02:0003A564 1214            	  1592:     move.b  ($0000,A4),D1
02:0003A566 8001            	  1593:     or.b  D1,D0
                            	  1594:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1595:     ; with the grid.
                            	  1596:     ;
                            	  1597:     ; If so, then go to state 1 to do a "big shove".
                            	  1598:     ; Else go to state 2, to immediately split in two.
                            	  1599:     ;
                            	  1600:     ; Examples:
                            	  1601:     ; It would be aligned, if moving left along a tile as usual.
                            	  1602:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1603:     ; - The collision check routines would have made the zol
                            	  1604:     ;   face in the direction of the weapon.
                            	  1605:     ; - See CheckMonsterWeaponCollision.
                            	  1606:     ;
02:0003A568 122C0098        	  1607:     move.b  ($0098,A4),D1
02:0003A56C C001            	  1608:     and.b  D1,D0
02:0003A56E 6608            	  1609:     bne  _anon_z04_28
02:0003A570 41EC00AC        	  1610:     lea     ($00AC,A4),A0
02:0003A574 52302000        	  1611:     addq.b  #1,(A0,D2.W)
                            	  1612: _anon_z04_28:
02:0003A578 41EC00AC        	  1613:     lea     ($00AC,A4),A0
02:0003A57C 52302000        	  1614:     addq.b  #1,(A0,D2.W)
                            	  1615:     even
