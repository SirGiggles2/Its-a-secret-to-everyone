                            	  7721: _L_z04_UpdatePolsVoice_State0:
                            	  7722:     ; State 0. Walking.
                            	  7723:     ;
                            	  7724:     ; If grid offset = 0, then no more distance to cover.
                            	  7725:     ; So, go change to state 1 -- jumping.
                            	  7726:     ;
02:0003D0C4 41EC0394        	  7727:     lea     ($0394,A4),A0
02:0003D0C8 10302000        	  7728:     move.b  (A0,D2.W),D0
