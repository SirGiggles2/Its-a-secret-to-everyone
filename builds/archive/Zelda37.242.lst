02:0003CBE4 11802000        	  6984:     move.b  D0,(A0,D2.W)
                            	  6985:     ; If substate <> 0, go decrement bloated timer.
                            	  6986:     ;
02:0003CBE8 4A03            	  6987:     cmpi.b  #$00,D3
02:0003CBEA 6702            	  6988:     beq.s  __far_z_04_0059
02:0003CBEC 605C            	  6989:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6990: __far_z_04_0059:
                            	  6991:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6992:     ;
02:0003CBEE 7610            	  6993:     moveq   #16,D3
02:0003CBF0 7000            	  6994:     moveq   #0,D0
02:0003CBF2 41EC00AC        	  6995:     lea     ($00AC,A4),A0
02:0003CBF6 11803000        	  6996:     move.b  D0,(A0,D3.W)
                            	  6997:     ; Increment the number of bomb hits.
                            	  6998:     ;
02:0003CBFA 41EC0437        	  6999:     lea     ($0437,A4),A0
02:0003CBFE 10302000        	  7000:     move.b  (A0,D2.W),D0
02:0003CC02 023C00EE        	  7001:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC06 123C0001        	  7002:     move.b  #$01,D1
02:0003CC0A D101            	  7003:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CC0C 41EC0437        	  7004:     lea     ($0437,A4),A0
02:0003CC10 11802000        	  7005:     move.b  D0,(A0,D2.W)
02:0003CC14 6034            	  7006:     jmp     L_Dodongo_DecrementBloatedTimer
