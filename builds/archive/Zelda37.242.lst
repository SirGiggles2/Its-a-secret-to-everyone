02:0002E876 102C0084        	   936:     move.b  ($0084,A4),D0
02:0002E87A 003C0011        	   937:     ori     #$11,CCR  ; SEC: set C+X
02:0002E87E 123C0098        	   938:     move.b  #$98,D1
02:0002E882 0A3C0010        	   939:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E886 9101            	   940:     subx.b  D1,D0   ; SBC #$98
02:0002E888 0A3C0010        	   941:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E88C 610026D8        	   942:     jsr     Abs
02:0002E890 0C000006        	   943:     cmpi.b  #$06,D0
02:0002E894 6506            	   944:     bcs  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_PickedUp
                            	   945:     even
