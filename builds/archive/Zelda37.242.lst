02:0003D0A0 660000AE        	  7699:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7700:     ; Every odd screen frame, go straight to drawing
                            	  7701:     ; and checking collisions.
                            	  7702:     ;
02:0003D0A4 102C0015        	  7703:     move.b  ($0015,A4),D0
