02:0003EE90 41EC04F0        	 11633:     lea     ($04F0,A4),A0
02:0003EE94 10302000        	 11634:     move.b  (A0,D2.W),D0
02:0003EE98 41EC04F1        	 11635:     lea     ($04F1,A4),A0
02:0003EE9C 11803000        	 11636:     move.b  D0,(A0,D3.W)
02:0003EEA0 10342070        	 11637:     move.b  ($70,A4,D2.W),D0
02:0003EEA4 19803071        	 11638:     move.b  D0,($71,A4,D3.W)
02:0003EEA8 41EC0084        	 11639:     lea     ($0084,A4),A0
02:0003EEAC 10302000        	 11640:     move.b  (A0,D2.W),D0
02:0003EEB0 41EC0085        	 11641:     lea     ($0085,A4),A0
