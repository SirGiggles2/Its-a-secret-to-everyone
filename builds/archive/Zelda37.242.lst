                            	  6301:     ;
02:0003C6AE 7040            	  6302:     moveq   #64,D0
02:0003C6B0 6052            	  6303:     jmp     SetTargetSpeed
                            	  6304: 
                            	  6305:     even
                            	  6306: Digdogger_SlowDown:
                            	  6307:     ; Subtract 1 from 16-bit speed.
