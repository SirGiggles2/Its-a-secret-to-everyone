                            	  5823: __far_z_05_0080:
                            	  5824:     ; Turn the door command into the desired open or closed state
                            	  5825:     ; to store in [08].
                            	  5826:     ;
                            	  5827:     ; cmd:  7 6 3 2 
                            	  5828:     ; [08]: 2 0 0 0
                            	  5829:     ;
                            	  5830:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5831:     ; commands intended to be used.
                            	  5832:     ;
                            	  5833:     ; 3 is the end state of 2: close
                            	  5834:     ; 7 is the end state of 6: open
                            	  5835:     ;
02:000438DE 02000007        	  5836:     andi.b #$07,D0
02:000438E2 7601            	  5837:     moveq   #1,D3
02:000438E4 19430002        	  5838:     move.b  D3,($0002,A4)
02:000438E8 122C0002        	  5839:     move.b  ($0002,A4),D1
02:000438EC C200            	  5840:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000438EE 6702            	  5841:     beq  _anon_z05_118
02:000438F0 E208            	  5842:     lsr.b  #1,D0   ; LSR A
                            	  5843: _anon_z05_118:
02:000438F2 0C000002        	  5844:     cmpi.b  #$02,D0
02:000438F6 6606            	  5845:     bne  _anon_z05_119
                            	  5846:     ; Command 2 sets Link's timer to $30.
                            	  5847:     ;
02:000438F8 7630            	  5848:     moveq   #48,D3
02:000438FA 19430028        	  5849:     move.b  D3,($0028,A4)
                            	  5850: _anon_z05_119:
02:000438FE 02000003        	  5851:     andi.b #$03,D0
02:00043902 003C0011        	  5852:     ori     #$11,CCR  ; SEC: set C+X
02:00043906 123C0001        	  5853:     move.b  #$01,D1
02:0004390A 0A3C0010        	  5854:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004390E 9101            	  5855:     subx.b  D1,D0   ; SBC #$01
02:00043910 0A3C0010        	  5856:     eori    #$10,CCR  ; restore X = 6502 C
02:00043914 02000002        	  5857:     andi.b #$02,D0
02:00043918 19400008        	  5858:     move.b  D0,($0008,A4)
                            	  5859:     ; The command to close a key door or bombable wall does not
                            	  5860:     ; do anything.
                            	  5861:     ;
02:0004391C 102C0054        	  5862:     move.b  ($0054,A4),D0
02:00043920 0C000005        	  5863:     cmpi.b  #$05,D0
02:00043924 6416            	  5864:     bcc  _anon_z05_120
02:00043926 102C0055        	  5865:     move.b  ($0055,A4),D0
02:0004392A 19400002        	  5866:     move.b  D0,($0002,A4)
02:0004392E 6100FAEC        	  5867:     jsr     FindDoorAttrByDoorBit
02:00043932 0C000007        	  5868:     cmpi.b  #$07,D0
02:00043936 6704            	  5869:     beq  _anon_z05_120
02:00043938 6000009C        	  5870:     jmp     L_ResetDoorCmdAndLayOutDoors
