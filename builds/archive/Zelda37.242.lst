02:00031FFE 19400004        	  6432:     move.b  D0,($0004,A4)
02:00032002 102C0084        	  6433:     move.b  ($0084,A4),D0
02:00032006 023C00EE        	  6434:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003200A 123C0008        	  6435:     move.b  #$08,D1
02:0003200E D101            	  6436:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
