02:000301F8 194000AC        	  2252:     move.b  D0,($00AC,A4)
02:000301FC 19400522        	  2253:     move.b  D0,($0522,A4)
02:00030200 41EC034F        	  2254:     lea     ($034F,A4),A0
02:00030204 11802000        	  2255:     move.b  D0,(A0,D2.W)
