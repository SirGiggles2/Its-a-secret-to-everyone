02:0003259E 19400007        	  7315:     move.b  D0,($0007,A4)
02:000325A2 102C000D        	  7316:     move.b  ($000D,A4),D0
02:000325A6 1940000E        	  7317:     move.b  D0,($000E,A4)
                            	  7318: ; Params:
                            	  7319: ; X: monster object slot
                            	  7320: ; [00]: weapon object slot
                            	  7321: ; [02]: monster object mid X
                            	  7322: ; [03]: monster object mid Y
                            	  7323: ; [07]: damage points
                            	  7324: ; [09]: damage type
                            	  7325: ; [0D]: horizontal threshold
                            	  7326: ; [0E]: vertical threshold
