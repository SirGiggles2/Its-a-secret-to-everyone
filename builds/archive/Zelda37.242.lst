02:0003E000 0C030060        	  9723:     cmpi.b  #$60,D3
02:0003E004 6402            	  9724:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003E006 E308            	  9725:     lsl.b  #1,D0   ; ASL A
                            	  9726:     even
                            	  9727: _L_z04_UpdateGohma_ChangeDir:
