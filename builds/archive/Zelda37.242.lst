                            	  9827: _L_z04_UpdateGohma_AnimateEye:
                            	  9828:     ; Animate the eye.
                            	  9829:     ;
                            	  9830:     ; First, if the counter for when to open the eye next = 0, then
                            	  9831:     ; set it to a random value at least $C0; and set the timer for
                            	  9832:     ; keeping the eye open to $80.
                            	  9833:     ;
                            	  9834:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9835:     ; every other frame.
                            	  9836:     ;
02:0003E0E0 41EC042C        	  9837:     lea     ($042C,A4),A0
02:0003E0E4 10302000        	  9838:     move.b  (A0,D2.W),D0
02:0003E0E8 661E            	  9839:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E0EA 103C0080        	  9840:     move.b  #$80,D0
02:0003E0EE 41EC0444        	  9841:     lea     ($0444,A4),A0
02:0003E0F2 11802000        	  9842:     move.b  D0,(A0,D2.W)
02:0003E0F6 103C00C0        	  9843:     move.b  #$C0,D0
02:0003E0FA 12342018        	  9844:     move.b  ($18,A4,D2.W),D1
02:0003E0FE 8001            	  9845:     or.b  D1,D0
02:0003E100 41EC042C        	  9846:     lea     ($042C,A4),A0
02:0003E104 11802000        	  9847:     move.b  D0,(A0,D2.W)
                            	  9848:     even
                            	  9849: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9850:     ; Decrement the next-open-eye counter.
                            	  9851:     ;
02:0003E108 102C0015        	  9852:     move.b  ($0015,A4),D0
02:0003E10C E208            	  9853:     lsr.b  #1,D0   ; LSR A
02:0003E10E 6408            	  9854:     bcc  _anon_z04_122
02:0003E110 41EC042C        	  9855:     lea     ($042C,A4),A0
02:0003E114 53302000        	  9856:     subq.b  #1,(A0,D2.W)
                            	  9857: _anon_z04_122:
                            	  9858:     ; If open eye timer = 0, then the eye is closed.
                            	  9859:     ; Go animate it differently.
                            	  9860:     ;
02:0003E118 41EC0444        	  9861:     lea     ($0444,A4),A0
