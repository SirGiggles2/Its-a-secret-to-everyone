                            	 11953:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	 11954:     ;
02:0003F0B8 41EC0098        	 11955:     lea     ($0098,A4),A0
02:0003F0BC 10302000        	 11956:     move.b  (A0,D2.W),D0
02:0003F0C0 122C0002        	 11957:     move.b  ($0002,A4),D1
02:0003F0C4 E309            	 11958:     lsl.b  #1,D1   ; ASL $02
02:0003F0C6 19410002        	 11959:     move.b  D1,($0002,A4)
02:0003F0CA 122C0002        	 11960:     move.b  ($0002,A4),D1
02:0003F0CE C200            	 11961:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
