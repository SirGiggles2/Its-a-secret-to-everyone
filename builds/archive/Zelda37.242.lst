                            	 12303:     even
                            	 12304: UpdateGanon_JumpTable:
02:0003F35A 0003F366        	 12305:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F35E 0003F3C8        	 12306:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F362 0003F3F6        	 12307:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12308: 
                            	 12309: ; Description:
                            	 12310: ; Lift up the Triforce of Courage while the room is dark.
                            	 12311: ;
                            	 12312: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12313: ;
                            	 12314:     even
                            	 12315: Ganon_ScenePhase0:
02:0003F366 701B            	 12316:     moveq   #27,D0
02:0003F368 19400505        	 12317:     move.b  D0,($0505,A4)
                            	 12318:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12319:     ;
02:0003F36C 102C0028        	 12320:     move.b  ($0028,A4),D0
02:0003F370 6644            	 12321:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12322:     ; Once the timer expires, it's time to brighten the room.
                            	 12323:     ;
                            	 12324:     ; Save the current object slot.
02:0003F372 1002            	 12325:     move.b  D2,D0
02:0003F374 1B00            	 12326:     move.b  D0,-(A5)  ; PHA
02:0003F376 610007F0        	 12327:     jsr     UpdateCandle
02:0003F37A 101D            	 12328:     move.b  (A5)+,D0  ; PLA
02:0003F37C 7400            	 12329:     moveq   #0,D2
02:0003F37E 1400            	 12330:     move.b  D0,D2
                            	 12331:     ; Turn off the room brightening flag, because we're controlling it
                            	 12332:     ; here instead of in the Mode 5 object update loop.
                            	 12333:     ;
02:0003F380 7000            	 12334:     moveq   #0,D0
02:0003F382 1940051E        	 12335:     move.b  D0,($051E,A4)
                            	 12336:     ; On the first frame of the fade-to-light cycle, play the
                            	 12337:     ; Triforce/Ganon song.
                            	 12338:     ;
02:0003F386 102C051C        	 12339:     move.b  ($051C,A4),D0
02:0003F38A 0C0000C0        	 12340:     cmpi.b  #$C0,D0
02:0003F38E 6606            	 12341:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F390 7002            	 12342:     moveq   #2,D0
02:0003F392 19400600        	 12343:     move.b  D0,($0600,A4)
                            	 12344:     even
                            	 12345: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
