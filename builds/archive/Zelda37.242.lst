                            	  6532: 
                            	  6533:     even
                            	  6534: HarmLink:
02:000320AC 61000564        	  6535:     jsr     BeginShove
                            	  6536:     ; Flag collision with [0C], even though [06] was already set.
                            	  6537:     ;
02:000320B0 522C000C        	  6538:     addq.b  #1,($000C,A4)
                            	  6539:     ; Unpack the damage points for the monster's type.
                            	  6540:     ; The low nibble is the high byte.
                            	  6541:     ; (Damage points byte AND $F0) is the low byte.
                            	  6542:     ;
02:000320B4 7600            	  6543:     moveq   #0,D3
02:000320B6 41EC034F        	  6544:     lea     ($034F,A4),A0
02:000320BA 16302000        	  6545:     move.b  (A0,D2.W),D3
02:000320BE 41F900031F20    	  6546:     lea     (ObjTypeToDamagePoints).l,A0
02:000320C4 10303000        	  6547:     move.b  (A0,D3.W),D0
02:000320C8 1B00            	  6548:     move.b  D0,-(A5)  ; PHA
02:000320CA 0200000F        	  6549:     andi.b #$0F,D0
02:000320CE 1940000D        	  6550:     move.b  D0,($000D,A4)
02:000320D2 101D            	  6551:     move.b  (A5)+,D0  ; PLA
02:000320D4 020000F0        	  6552:     andi.b #$F0,D0
02:000320D8 1940000E        	  6553:     move.b  D0,($000E,A4)
                            	  6554: ; Params:
                            	  6555: ; X: object index of the attacker
                            	  6556: ; [0D]: damage points high byte
                            	  6557: ; [0E]: damage points low byte
                            	  6558: ;
                            	  6559: ;
                            	  6560: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6561: ;
                            	  6562:     even
                            	  6563: Link_BeHarmed:
02:000320DC 7600            	  6564:     moveq   #0,D3
02:000320DE 41EC034F        	  6565:     lea     ($034F,A4),A0
