                            	 12886: Ganon_CheckCollisions:
                            	 12887:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12888:     ; Store in [02] and [03].
                            	 12889:     ;
02:0003F75C 10342070        	 12890:     move.b  ($70,A4,D2.W),D0
02:0003F760 023C00EE        	 12891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F764 123C0010        	 12892:     move.b  #$10,D1
02:0003F768 D101            	 12893:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F76A 19400002        	 12894:     move.b  D0,($0002,A4)
02:0003F76E 41EC0084        	 12895:     lea     ($0084,A4),A0
02:0003F772 10302000        	 12896:     move.b  (A0,D2.W),D0
02:0003F776 023C00EE        	 12897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F77A 123C0010        	 12898:     move.b  #$10,D1
02:0003F77E D101            	 12899:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F780 19400003        	 12900:     move.b  D0,($0003,A4)
                            	 12901:     ; Check for a collision with Link.
                            	 12902:     ;
                            	 12903:     ; We can't call CheckLinkCollision, because we need to
                            	 12904:     ; customize Ganon's midpoint.
                            	 12905:     ;
                            	 12906:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12907:     ; detection, if Link is invincible. Initialize variables that will
                            	 12908:     ; be returned from the partial collision check routine. Then
                            	 12909:     ; call it.
                            	 12910:     ;
02:0003F784 102C04F0        	 12911:     move.b  ($04F0,A4),D0
02:0003F788 6616            	 12912:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F78A 19400006        	 12913:     move.b  D0,($0006,A4)
02:0003F78E 19400009        	 12914:     move.b  D0,($0009,A4)
02:0003F792 1940000C        	 12915:     move.b  D0,($000C,A4)
02:0003F796 7600            	 12916:     moveq   #0,D3
02:0003F798 1883            	 12917:     move.b  D3,($0000,A4)
02:0003F79A 4EB900031FB4    	 12918:     jsr     CheckLinkCollisionPreinit
                            	 12919:     even
                            	 12920: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12921:     ; If Ganon is not in state 0, then he's brown.
                            	 12922:     ; Go check collision with an arrow.
                            	 12923:     ;
02:0003F7A0 41EC00AC        	 12924:     lea     ($00AC,A4),A0
02:0003F7A4 10302000        	 12925:     move.b  (A0,D2.W),D0
02:0003F7A8 6652            	 12926:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12927:     ; If timer <> 0, then Ganon is visible.
                            	 12928:     ; He can't be harmed like this. So, return.
                            	 12929:     ;
02:0003F7AA 10342028        	 12930:     move.b  ($28,A4,D2.W),D0
02:0003F7AE 664A            	 12931:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F7B0 760D            	 12932:     moveq   #13,D3
02:0003F7B2 4EB90003247E    	 12933:     jsr     CheckMonsterSwordCollision
                            	 12934:     ; If Ganon has died according to the usual collision check rules
                            	 12935:     ; (HP = 0), then:
                            	 12936:     ; 1. Restore HP to the initial value $F0
                            	 12937:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12938:     ; 3. Change palette row 7 to make Ganon brown
                            	 12939:     ;
02:0003F7B8 41EC0405        	 12940:     lea     ($0405,A4),A0
02:0003F7BC 10302000        	 12941:     move.b  (A0,D2.W),D0
02:0003F7C0 6718            	 12942:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F7C2 103C00F0        	 12943:     move.b  #$F0,D0
02:0003F7C6 41EC0485        	 12944:     lea     ($0485,A4),A0
02:0003F7CA 11802000        	 12945:     move.b  D0,(A0,D2.W)
02:0003F7CE 41EC00AC        	 12946:     lea     ($00AC,A4),A0
02:0003F7D2 53302000        	 12947:     subq.b  #1,(A0,D2.W)
02:0003F7D6 61000084        	 12948:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12949:     even
                            	 12950: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12951:     ; If Ganon was harmed, then play the sound effect
                            	 12952:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12953:     ;
02:0003F7DA 41EC04F0        	 12954:     lea     ($04F0,A4),A0
02:0003F7DE 10302000        	 12955:     move.b  (A0,D2.W),D0
02:0003F7E2 670A            	 12956:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F7E4 6100A318        	 12957:     jsr     PlayBossHitCryIfNeeded
02:0003F7E8 7040            	 12958:     moveq   #64,D0
02:0003F7EA 19802028        	 12959:     move.b  D0,($28,A4,D2.W)
                            	 12960:     even
                            	 12961: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12962:     ; Reset metastate, because Ganon cannot die this way.
                            	 12963:     ;
02:0003F7EE 4EB90004D668    	 12964:     jsr     ResetObjMetastate
                            	 12965:     ; Reset shove info and invincibility timer, because Ganon
                            	 12966:     ; doesn't react at all as a usual monster.
                            	 12967:     ;
02:0003F7F4 4EB900032386    	 12968:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12969:     even
                            	 12970: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F7FA 4E75            	 12971:     rts
                            	 12972: 
                            	 12973:     even
                            	 12974: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12975:     ; If the silver arrow is not in the inventory, then return.
                            	 12976:     ;
02:0003F7FC 102C0659        	 12977:     move.b  ($0659,A4),D0
02:0003F800 0C000002        	 12978:     cmpi.b  #$02,D0
02:0003F804 66F4            	 12979:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12980:     ; Reset the collision return value [06].
                            	 12981:     ;
02:0003F806 7000            	 12982:     moveq   #0,D0
02:0003F808 19400006        	 12983:     move.b  D0,($0006,A4)
                            	 12984:     ; If there's no arrow in flight, then return.
                            	 12985:     ;
02:0003F80C 7612            	 12986:     moveq   #18,D3
02:0003F80E 41EC00AC        	 12987:     lea     ($00AC,A4),A0
02:0003F812 10303000        	 12988:     move.b  (A0,D3.W),D0
02:0003F816 0C000010        	 12989:     cmpi.b  #$10,D0
02:0003F81A 66DE            	 12990:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12991:     ; Check for collision with an arrow; and return if no collision.
                            	 12992:     ;
02:0003F81C 4EB9000324DA    	 12993:     jsr     CheckMonsterArrowOrRodCollision
02:0003F822 102C0006        	 12994:     move.b  ($0006,A4),D0
02:0003F826 67D2            	 12995:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12996:     ; Set the Ganon phase to "dying".
                            	 12997:     ;
02:0003F828 41EC042C        	 12998:     lea     ($042C,A4),A0
02:0003F82C 52302000        	 12999:     addq.b  #1,(A0,D2.W)
                            	 13000:     ; Now his body does flash.
                            	 13001:     ;
02:0003F830 7028            	 13002:     moveq   #40,D0
02:0003F832 41EC04F0        	 13003:     lea     ($04F0,A4),A0
02:0003F836 11802000        	 13004:     move.b  D0,(A0,D2.W)
                            	 13005:     ; Set initial cloud distance 8.
                            	 13006:     ;
02:0003F83A 7008            	 13007:     moveq   #8,D0
02:0003F83C 41EC0478        	 13008:     lea     ($0478,A4),A0
02:0003F840 11802000        	 13009:     move.b  D0,(A0,D2.W)
02:0003F844 0A3C0001        	 13010:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F848 4E75            	 13011:     rts
                            	 13012: 
                            	 13013:     even
