                            	  4393:     ; return the speed index (angle) we have.
                            	  4394:     ;
02:00031034 102C0003        	  4395:     move.b  ($0003,A4),D0
02:00031038 003C0011        	  4396:     ori     #$11,CCR  ; SEC: set C+X
02:0003103C 122C0004        	  4397:     move.b  ($0004,A4),D1
02:00031040 0A3C0010        	  4398:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031044 9101            	  4399:     subx.b  D1,D0   ; SBC $04
02:00031046 0A3C0010        	  4400:     eori    #$10,CCR  ; restore X = 6502 C
02:0003104A 0C000008        	  4401:     cmpi.b  #$08,D0
02:0003104E 6538            	  4402:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4403:     even
                            	  4404: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4405:     ; TODO: call it speed index or angle?
                            	  4406:     ; Otherwise, go to the next speed index (angle).
                            	  4407:     ;
02:00031050 1014            	  4408:     move.b  ($0000,A4),D0
02:00031052 023C00EE        	  4409:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031056 122C0001        	  4410:     move.b  ($0001,A4),D1
02:0003105A D101            	  4411:     addx.b  D1,D0   ; ADC $01
02:0003105C 1880            	  4412:     move.b  D0,($0000,A4)
                            	  4413:     ; TODO: call it speed index or angle?
                            	  4414:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4415:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4416:     ;
02:0003105E 6728            	  4417:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00031060 0C000008        	  4418:     cmpi.b  #$08,D0
02:00031064 6722            	  4419:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4420:     ; Subtract the lesser distance from the greater distance.
                            	  4421:     ; If they still haven't crossed, then we can turn more.
                            	  4422:     ;
02:00031066 102C0003        	  4423:     move.b  ($0003,A4),D0
02:0003106A 003C0011        	  4424:     ori     #$11,CCR  ; SEC: set C+X
02:0003106E 122C0004        	  4425:     move.b  ($0004,A4),D1
02:00031072 0A3C0010        	  4426:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031076 9101            	  4427:     subx.b  D1,D0   ; SBC $04
02:00031078 0A3C0010        	  4428:     eori    #$10,CCR  ; restore X = 6502 C
02:0003107C 19400003        	  4429:     move.b  D0,($0003,A4)
02:00031080 122C0004        	  4430:     move.b  ($0004,A4),D1
02:00031084 B001            	  4431:     cmp.b   D1,D0
02:00031086 64C8            	  4432:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4433:     even
