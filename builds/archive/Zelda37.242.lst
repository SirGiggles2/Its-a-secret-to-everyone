                            	  4165: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  4166:     ;
                            	  4167:     ;
                            	  4168:     ; [0E] holds reverse index of doorway direction found.
                            	  4169:     ;
02:00042294 1943000E        	  4170:     move.b  D3,($000E,A4)
                            	  4171:     ; Store input direction in [02] and [0C].
