                            	  1250: _L_z04_UpdateFireball_Move:
                            	  1251:     ; A movement routine is used that works along one axis.
                            	  1252:     ; So, load its parameters, and call it for each axis individually.
                            	  1253:     ;
                            	  1254:     ; First, load the horizontal direction into [0F].
                            	  1255:     ;
02:0003A2DC 41EC0412        	  1256:     lea     ($0412,A4),A0
02:0003A2E0 10302000        	  1257:     move.b  (A0,D2.W),D0
02:0003A2E4 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:0003A2E8 41EC041F        	  1262:     lea     ($041F,A4),A0
02:0003A2EC 10302000        	  1263:     move.b  (A0,D2.W),D0
02:0003A2F0 7600            	  1264:     moveq   #0,D3
02:0003A2F2 41EC0451        	  1265:     lea     ($0451,A4),A0
02:0003A2F6 16302000        	  1266:     move.b  (A0,D2.W),D3
