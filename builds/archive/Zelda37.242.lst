02:0002E748 7604            	   757:     moveq   #4,D3
                            	   758: _anon_z01_7:
02:0002E74A 41F90002E724    	   759:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E750 10303000        	   760:     move.b  (A0,D3.W),D0
02:0002E754 41EC0302        	   761:     lea     ($0302,A4),A0
02:0002E758 11803000        	   762:     move.b  D0,(A0,D3.W)
02:0002E75C 5303            	   763:     subq.b  #1,D3
02:0002E75E 6AEA            	   764:     bpl  _anon_z01_7
                            	   765:     even
                            	   766: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   767:     ; Replace the low byte of the VRAM address with the one
                            	   768:     ; where the next character should be written.
                            	   769:     ;
02:0002E760 102C045F        	   770:     move.b  ($045F,A4),D0
02:0002E764 19400303        	   771:     move.b  D0,($0303,A4)
                            	   772:     ; Increment the low VRAM address for the next character.
                            	   773:     ;
02:0002E768 522C045F        	   774:     addq.b  #1,($045F,A4)
                            	   775:     ; Use the person text selector to look up the address of the
                            	   776:     ; text for the textbox. Store the address in [00:01].
                            	   777:     ;
02:0002E76C 7600            	   778:     moveq   #0,D3
02:0002E76E 162C0415        	   779:     move.b  ($0415,A4),D3
02:0002E772 41F90002DDA8    	   780:     lea     (PersonTextAddrs).l,A0
02:0002E778 10303000        	   781:     move.b  (A0,D3.W),D0
02:0002E77C 1880            	   782:     move.b  D0,($0000,A4)
02:0002E77E 5203            	   783:     addq.b  #1,D3
02:0002E780 41F90002DDA8    	   784:     lea     (PersonTextAddrs).l,A0
02:0002E786 10303000        	   785:     move.b  (A0,D3.W),D0
02:0002E78A 19400001        	   786:     move.b  D0,($0001,A4)
                            	   787:     ; Load the person text current character index.
                            	   788:     ;
02:0002E78E 7600            	   789:     moveq   #0,D3
02:0002E790 162C0416        	   790:     move.b  ($0416,A4),D3
                            	   791:     ; Increment the index variable to point to the next character
                            	   792:     ; for next time.
                            	   793:     ;
02:0002E794 522C0416        	   794:     addq.b  #1,($0416,A4)
                            	   795:     ; Get the current character.
                            	   796:     ;
02:0002E798 1214            	   797:     move.b  ($00,A4),D1   ; ptr lo
02:0002E79A 182C0001        	   798:     move.b  ($01,A4),D4  ; ptr hi
02:0002E79E 024100FF        	   799:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E7A2 E14C            	   800:     lsl.w   #8,D4
02:0002E7A4 8841            	   801:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E7A6 48C4            	   802:     ext.l   D4
02:0002E7A8 D8BC00FF0000    	   803:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E7AE 2044            	   804:     movea.l D4,A0
02:0002E7B0 10303000        	   805:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   806:     ; If the character is $25, then it's a special space. It will still
                            	   807:     ; take up space, but will not take time to show -- meaning that
                            	   808:     ; we'll go look up the next character to transfer.
                            	   809:     ;
02:0002E7B4 0200003F        	   810:     andi.b #$3F,D0
02:0002E7B8 0C000025        	   811:     cmpi.b  #$25,D0
02:0002E7BC 67A2            	   812:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   813:     ; We have a non-space character. Put it in the transfer record.
                            	   814:     ;
02:0002E7BE 19400305        	   815:     move.b  D0,($0305,A4)
                            	   816:     ; Play the "heart taken/character" sound effect.
                            	   817:     ;
02:0002E7C2 7010            	   818:     moveq   #16,D0
02:0002E7C4 19400604        	   819:     move.b  D0,($0604,A4)
                            	   820:     ; If the high 2 bits of character element = 0, then return.
                            	   821:     ;
02:0002E7C8 1214            	   822:     move.b  ($00,A4),D1   ; ptr lo
02:0002E7CA 182C0001        	   823:     move.b  ($01,A4),D4  ; ptr hi
02:0002E7CE 024100FF        	   824:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E7D2 E14C            	   825:     lsl.w   #8,D4
02:0002E7D4 8841            	   826:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E7D6 48C4            	   827:     ext.l   D4
02:0002E7D8 D8BC00FF0000    	   828:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E7DE 2044            	   829:     movea.l D4,A0
02:0002E7E0 10303000        	   830:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E7E4 020000C0        	   831:     andi.b #$C0,D0
02:0002E7E8 672E            	   832:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   833:     ; Determine an index based on the high 2 bits of the character element:
                            	   834:     ;   $80: 0
                            	   835:     ;   $40: 1
                            	   836:     ;   $C0: 2
                            	   837:     ;
02:0002E7EA 7602            	   838:     moveq   #2,D3
02:0002E7EC 0C0000C0        	   839:     cmpi.b  #$C0,D0
02:0002E7F0 670A            	   840:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E7F2 5303            	   841:     subq.b  #1,D3
02:0002E7F4 0C000040        	   842:     cmpi.b  #$40,D0
02:0002E7F8 6702            	   843:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E7FA 5303            	   844:     subq.b  #1,D3
                            	   845:     even
                            	   846: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   847:     ; The index chooses the low VRAM address of the start
                            	   848:     ; of another line:
                            	   849:     ;   0: $C4: front of the second line
                            	   850:     ;   1: $E4: front of the third line
                            	   851:     ;   2: $A4: front of the first line
                            	   852:     ;
                            	   853:     ; Look up the low VRAM address and store it.
                            	   854:     ;
02:0002E7FC 41F90002E72A    	   855:     lea     (TextboxLineAddrsLo).l,A0
02:0002E802 10303000        	   856:     move.b  (A0,D3.W),D0
02:0002E806 1940045F        	   857:     move.b  D0,($045F,A4)
                            	   858:     ; If index = 2, then we've reached the end of the text,
                            	   859:     ; and low VRAM address is moved to the front of the first line.
                            	   860:     ; So, advance the state of the person object, and unhalt Link.
                            	   861:     ;
02:0002E80A 0C030002        	   862:     cmpi.b  #$02,D3
02:0002E80E 6608            	   863:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E810 522C00AD        	   864:     addq.b  #1,($00AD,A4)
02:0002E814 6100FB98        	   865:     jsr     UnhaltLink
                            	   866:     even
