02:0003B024 0A3C0010        	  3180:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B028 9101            	  3181:     subx.b  D1,D0   ; SBC #$01
02:0003B02A 0A3C0010        	  3182:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B02E E308            	  3183:     lsl.b  #1,D0   ; ASL A
02:0003B030 023C00EE        	  3184:     andi    #$EE,CCR  ; CLC: clear C+X
