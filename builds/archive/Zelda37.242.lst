02:0004AD1A 122C0004        	  2119:     move.b  ($0004,A4),D1
02:0004AD1E D101            	  2120:     addx.b  D1,D0   ; ADC $04
02:0004AD20 4A02            	  2121:     cmpi.b  #$00,D2
