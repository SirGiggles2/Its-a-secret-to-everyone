                            	 13036:     ; Get the length, to append to the dynamic transfer buf.
                            	 13037:     ;
02:0003F86A 7400            	 13038:     moveq   #0,D2
02:0003F86C 142C0301        	 13039:     move.b  ($0301,A4),D2
                            	 13040:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 13041:     ;
