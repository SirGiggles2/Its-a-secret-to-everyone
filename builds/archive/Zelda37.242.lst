                            	 12347:     ;
02:0003F396 102C051C        	 12348:     move.b  ($051C,A4),D0
02:0003F39A 0200000F        	 12349:     andi.b #$0F,D0
02:0003F39E 0C000004        	 12350:     cmpi.b  #$04,D0
02:0003F3A2 6702            	 12351:     beq.s  __far_z_04_0115
02:0003F3A4 6042            	 12352:     jmp  Ganon_DrawBodyFrame0
                            	 12353: __far_z_04_0115:
                            	 12354:     ; Set Link's timer to $C0 for the next scene phase.
                            	 12355:     ;
02:0003F3A6 103C00C0        	 12356:     move.b  #$C0,D0
02:0003F3AA 19400028        	 12357:     move.b  D0,($0028,A4)
                            	 12358:     ; Set scene phase 1, and go draw Ganon.
                            	 12359:     ;
02:0003F3AE 522C0445        	 12360:     addq.b  #1,($0445,A4)
02:0003F3B2 6702            	 12361:     beq.s  __far_z_04_0116
