02:0003FF8A 7600            	 14107:     moveq   #0,D3
02:0003FF8C 162C0006        	 14108:     move.b  ($0006,A4),D3
02:0003FF90 6100008E        	 14109:     jsr     ShiftMultiply
                            	 14110:     ; The absolute Y increment for the current angle is now in [02:03].
