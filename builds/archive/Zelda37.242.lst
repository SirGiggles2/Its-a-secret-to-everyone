                            	   903: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp:
                            	   904:     ; This is a cave where the player chooses or touches an item:
                            	   905:     ; - give item
                            	   906:     ; - shop
                            	   907:     ; - hint
