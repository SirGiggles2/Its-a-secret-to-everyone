                            	  7427: BeginShove:
02:00032612 7600            	  7428:     moveq   #0,D3
02:00032614 1614            	  7429:     move.b  ($0000,A4),D3
02:00032616 0C02000D        	  7430:     cmpi.b  #$0D,D2
02:0003261A 6412            	  7431:     bcc  _anon_z01_99
02:0003261C 41EC04B2        	  7432:     lea     ($04B2,A4),A0
02:00032620 10302000        	  7433:     move.b  (A0,D2.W),D0
02:00032624 122C0009        	  7434:     move.b  ($0009,A4),D1
02:00032628 C001            	  7435:     and.b  D1,D0
02:0003262A 660000C4        	  7436:     bne  _L_z01_BeginShove_Exit
                            	  7437: _anon_z01_99:
                            	  7438:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7439:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7440:     ;
                            	  7441:     ; If instead a monster is defending, then all this calculation
                            	  7442:     ; won't matter, because the shove direction will be set to the
                            	  7443:     ; weapon's direction.
                            	  7444:     ;
                            	  7445:     ; As such, calculate a direction from the monster to the defender,
                            	  7446:     ; assuming it's Link.
                            	  7447:     ;
                            	  7448:     ; Start with an assumption that the direction is vertical:
                            	  7449:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7450:     ;
02:0003262E 7008            	  7451:     moveq   #8,D0
02:00032630 19400008        	  7452:     move.b  D0,($0008,A4)
02:00032634 41EC0084        	  7453:     lea     ($0084,A4),A0
02:00032638 10302000        	  7454:     move.b  (A0,D2.W),D0
02:0003263C 19400004        	  7455:     move.b  D0,($0004,A4)
02:00032640 41EC0084        	  7456:     lea     ($0084,A4),A0
02:00032644 10303000        	  7457:     move.b  (A0,D3.W),D0
02:00032648 19400005        	  7458:     move.b  D0,($0005,A4)
                            	  7459:     ; If the defender is Link and his grid offset <> 0 then
                            	  7460:     ; use his usual object direction variable to determine
                            	  7461:     ; which axis to check.
                            	  7462:     ;
02:0003264C 4A03            	  7463:     cmpi.b  #$00,D3
02:0003264E 6612            	  7464:     bne  _anon_z01_100
02:00032650 102C0394        	  7465:     move.b  ($0394,A4),D0
02:00032654 670C            	  7466:     beq  _anon_z01_100
02:00032656 102C0098        	  7467:     move.b  ($0098,A4),D0
02:0003265A 02000003        	  7468:     andi.b #$03,D0
02:0003265E 660C            	  7469:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032660 6720            	  7470:     beq  _L_z01_BeginShove_CheckVertical
                            	  7471: _anon_z01_100:
                            	  7472:     ; For monsters defending, or Link with grid offset = 0,
                            	  7473:     ; check direction in [0B].
                            	  7474:     ;
                            	  7475:     ; For monsters defending, this won't matter. For Link with grid
                            	  7476:     ; offset = 0, I believe the result will be arbitrary.
                            	  7477:     ;
                            	  7478:     ; TODO:
                            	  7479:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7480:     ; It doesn't seem to be if candle fire attacks him.
                            	  7481:     ;
02:00032662 102C000B        	  7482:     move.b  ($000B,A4),D0
02:00032666 0C000004        	  7483:     cmpi.b  #$04,D0
02:0003266A 6416            	  7484:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7485:     even
                            	  7486: _L_z01_BeginShove_CheckHorizontal:
                            	  7487:     ; If the direction checked is left or right,
                            	  7488:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7489:     ;
02:0003266C 7002            	  7490:     moveq   #2,D0
02:0003266E 19400008        	  7491:     move.b  D0,($0008,A4)
02:00032672 10342070        	  7492:     move.b  ($70,A4,D2.W),D0
02:00032676 19400004        	  7493:     move.b  D0,($0004,A4)
02:0003267A 10343070        	  7494:     move.b  ($70,A4,D3.W),D0
02:0003267E 19400005        	  7495:     move.b  D0,($0005,A4)
                            	  7496:     even
                            	  7497: _L_z01_BeginShove_CheckVertical:
                            	  7498:     ; If the monster is down or right of the other object,
                            	  7499:     ; then use the opposite direction already in [08].
                            	  7500:     ; Else shift [08] right to turn it into the opposite
                            	  7501:     ; direction up or down.
                            	  7502:     ;
                            	  7503:     ; Again assuming Link is the defender; after this, [08] points
                            	  7504:     ; Link away from the monster.
                            	  7505:     ;
02:00032682 102C0004        	  7506:     move.b  ($0004,A4),D0
02:00032686 122C0005        	  7507:     move.b  ($0005,A4),D1
02:0003268A B001            	  7508:     cmp.b   D1,D0
02:0003268C 640A            	  7509:     bcc  _anon_z01_101
02:0003268E 122C0008        	  7510:     move.b  ($0008,A4),D1
02:00032692 E209            	  7511:     lsr.b  #1,D1   ; LSR $08
02:00032694 19410008        	  7512:     move.b  D1,($0008,A4)
                            	  7513: _anon_z01_101:
                            	  7514:     ; If a monster is the defender, go handle it separately.
                            	  7515:     ;
02:00032698 4A03            	  7516:     cmpi.b  #$00,D3
02:0003269A 6656            	  7517:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7518:     ; Link is the defender.
                            	  7519:     ;
                            	  7520:     ; If Link is invincible, return without shoving.
                            	  7521:     ;
02:0003269C 102C04F0        	  7522:     move.b  ($04F0,A4),D0
02:000326A0 664E            	  7523:     bne  _L_z01_BeginShove_Exit
                            	  7524:     ; Store the shove direction we determined.
                            	  7525:     ;
                            	  7526:     ; Turn on the high bit to indicate that the next time we try to
                            	  7527:     ; move by shoving, it will be the first time for this shove action.
                            	  7528:     ;
02:000326A2 102C0008        	  7529:     move.b  ($0008,A4),D0
02:000326A6 00000080        	  7530:     ori.b #$80,D0
02:000326AA 194000C0        	  7531:     move.b  D0,($00C0,A4)
                            	  7532:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7533:     ;
02:000326AE 7018            	  7534:     moveq   #24,D0
02:000326B0 194004F0        	  7535:     move.b  D0,($04F0,A4)
02:000326B4 7020            	  7536:     moveq   #32,D0
02:000326B6 194000D3        	  7537:     move.b  D0,($00D3,A4)
                            	  7538:     ; If Link was shoved by one of his own weapons, then
                            	  7539:     ; nothing else to do. Return.
                            	  7540:     ;
02:000326BA 0C02000D        	  7541:     cmpi.b  #$0D,D2
02:000326BE 6430            	  7542:     bcc  _L_z01_BeginShove_Exit
                            	  7543:     ; Link was shoved by a monster.
                            	  7544:     ;
                            	  7545:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7546:     ; then return.
                            	  7547:     ;
02:000326C0 41EC04BF        	  7548:     lea     ($04BF,A4),A0
02:000326C4 10302000        	  7549:     move.b  (A0,D2.W),D0
02:000326C8 02000080        	  7550:     andi.b #$80,D0
02:000326CC 6622            	  7551:     bne  _L_z01_BeginShove_Exit
                            	  7552:     ; If the attacker is a vire, then return.
                            	  7553:     ;
02:000326CE 41EC034F        	  7554:     lea     ($034F,A4),A0
02:000326D2 10302000        	  7555:     move.b  (A0,D2.W),D0
02:000326D6 0C000012        	  7556:     cmpi.b  #$12,D0
02:000326DA 6714            	  7557:     beq  _L_z01_BeginShove_Exit
                            	  7558:     ; Turn the attacker in the opposite direction.
                            	  7559:     ;
02:000326DC 41EC0098        	  7560:     lea     ($0098,A4),A0
02:000326E0 10302000        	  7561:     move.b  (A0,D2.W),D0
02:000326E4 6100E87C        	  7562:     jsr     GetOppositeDir
02:000326E8 41EC0098        	  7563:     lea     ($0098,A4),A0
02:000326EC 11802000        	  7564:     move.b  D0,(A0,D2.W)
                            	  7565:     even
                            	  7566: _L_z01_BeginShove_Exit:
02:000326F0 4E75            	  7567:     rts
                            	  7568: 
                            	  7569:     even
                            	  7570: _L_z01_BeginShove_MonsterDefender:
                            	  7571:     ; A monster is the defender. A weapon is the attacker.
                            	  7572:     ;
                            	  7573:     ; Set the shove direction to the weapon's direction,
                            	  7574:     ; instead of the direction passed in [0B].
                            	  7575:     ;
02:000326F2 41EC0098        	  7576:     lea     ($0098,A4),A0
02:000326F6 10303000        	  7577:     move.b  (A0,D3.W),D0
02:000326FA 19400008        	  7578:     move.b  D0,($0008,A4)
                            	  7579:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7580:     ; combine the shove direction with $40.
                            	  7581:     ;
                            	  7582:     ; TODO:
                            	  7583:     ; But the shoving routing doesn't read this flag.
                            	  7584:     ;
02:000326FE 41EC04BF        	  7585:     lea     ($04BF,A4),A0
02:00032702 10302000        	  7586:     move.b  (A0,D2.W),D0
02:00032706 02000080        	  7587:     andi.b #$80,D0
02:0003270A 670C            	  7588:     beq  _anon_z01_102
02:0003270C 102C0008        	  7589:     move.b  ($0008,A4),D0
02:00032710 00000040        	  7590:     ori.b #$40,D0
02:00032714 19400008        	  7591:     move.b  D0,($0008,A4)
                            	  7592: _anon_z01_102:
                            	  7593:     ; If the monster is invincible, then return without shoving.
                            	  7594:     ;
02:00032718 41EC04F0        	  7595:     lea     ($04F0,A4),A0
02:0003271C 10302000        	  7596:     move.b  (A0,D2.W),D0
02:00032720 6656            	  7597:     bne  _L_z01_BeginShove_Exit2
                            	  7598:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7599:     ;
02:00032722 41EC034F        	  7600:     lea     ($034F,A4),A0
02:00032726 10302000        	  7601:     move.b  (A0,D2.W),D0
02:0003272A 0C000033        	  7602:     cmpi.b  #$33,D0
02:0003272E 6706            	  7603:     beq  _L_z01_BeginShove_Gohma
02:00032730 0C000034        	  7604:     cmpi.b  #$34,D0
02:00032734 661E            	  7605:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7606:     even
                            	  7607: _L_z01_BeginShove_Gohma:
                            	  7608:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7609:     ; then return, so that the hit doesn't register.
                            	  7610:     ;
02:00032736 102C000F        	  7611:     move.b  ($000F,A4),D0
02:0003273A 0C000003        	  7612:     cmpi.b  #$03,D0
02:0003273E 6706            	  7613:     beq  _anon_z01_103
02:00032740 0C000004        	  7614:     cmpi.b  #$04,D0
02:00032744 6632            	  7615:     bne  _L_z01_BeginShove_Exit2
                            	  7616: _anon_z01_103:
                            	  7617:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7618:     ;
02:00032746 41EC046B        	  7619:     lea     ($046B,A4),A0
02:0003274A 10302000        	  7620:     move.b  (A0,D2.W),D0
02:0003274E 0C000003        	  7621:     cmpi.b  #$03,D0
02:00032752 6624            	  7622:     bne  _L_z01_BeginShove_Exit2
                            	  7623:     even
                            	  7624: _L_z01_BeginShove_SetShoveDir:
                            	  7625:     ; Store the shove direction for the monster.
                            	  7626:     ;
                            	  7627:     ; Turn on the high bit to indicate that the next time we try to
                            	  7628:     ; move by shoving, it will be the first time for this shove action.
