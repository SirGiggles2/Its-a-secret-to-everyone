02:0003ACD6 41F90003AC00    	  2745:     lea     (JumperStartSpeedsHi).l,A0
02:0003ACDC 10303000        	  2746:     move.b  (A0,D3.W),D0
02:0003ACE0 41EC0412        	  2747:     lea     ($0412,A4),A0
02:0003ACE4 11802000        	  2748:     move.b  D0,(A0,D2.W)
                            	  2749:     ; Reset the vertical speed low byte.
