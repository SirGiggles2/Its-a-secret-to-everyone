02:0003F61A 6100009A        	 12723:     jsr     Ganon_GetCurCloudBottom
02:0003F61E 6100FF76        	 12724:     jsr     Ganon_DrawCloud
                            	 12725:     ; Draw the left and right clouds.
                            	 12726:     ;
02:0003F622 61000080        	 12727:     jsr     Ganon_GetCurCloudLeft
02:0003F626 41EC0084        	 12728:     lea     ($0084,A4),A0
02:0003F62A 10302000        	 12729:     move.b  (A0,D2.W),D0
02:0003F62E 19400001        	 12730:     move.b  D0,($0001,A4)
02:0003F632 6100FF62        	 12731:     jsr     Ganon_DrawCloud
02:0003F636 6172            	 12732:     jsr     Ganon_GetCurCloudRight
02:0003F638 6100FF5C        	 12733:     jsr     Ganon_DrawCloud
                            	 12734:     ; Save the object index.
                            	 12735:     ;
02:0003F63C 102C0340        	 12736:     move.b  ($0340,A4),D0
02:0003F640 1B00            	 12737:     move.b  D0,-(A5)  ; PHA
                            	 12738:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12739:     ;
02:0003F642 7402            	 12740:     moveq   #2,D2
                            	 12741:     even
                            	 12742: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F644 19420340        	 12743:     move.b  D2,($0340,A4)
                            	 12744:     ; If object slot < 5 or = 7, then move every frame.
                            	 12745:     ; Else move 3 out of every 4 frames.
                            	 12746:     ;
                            	 12747:     ; This makes pieces spread out in somewhat of a circle,
                            	 12748:     ; by making the pieces at cardinal directions move at
                            	 12749:     ; full speed while the diagonal ones move a little slower.
                            	 12750:     ;
02:0003F648 0C020005        	 12751:     cmpi.b  #$05,D2
02:0003F64C 6510            	 12752:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F64E 0C020007        	 12753:     cmpi.b  #$07,D2
02:0003F652 670A            	 12754:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F654 102C0015        	 12755:     move.b  ($0015,A4),D0
02:0003F658 02000003        	 12756:     andi.b #$03,D0
02:0003F65C 6704            	 12757:     beq  _anon_z04_164
                            	 12758:     even
                            	 12759: _L_z04_Ganon_DrawBurst_Move:
02:0003F65E 6100E036        	 12760:     jsr     BlueWizzrobe_Move
                            	 12761: _anon_z04_164:
02:0003F662 4EB90004CE68    	 12762:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12763:     ; The frame counter will make the sprite flash.
                            	 12764:     ; The array has the horizontal and vertical flipping attributes.
                            	 12765:     ; Combine them into [03].
                            	 12766:     ;
02:0003F668 102C0015        	 12767:     move.b  ($0015,A4),D0
02:0003F66C 02000003        	 12768:     andi.b #$03,D0
02:0003F670 41F90003F540    	 12769:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F676 12302000        	 12770:     move.b  (A0,D2.W),D1
02:0003F67A 8001            	 12771:     or.b  D1,D0
02:0003F67C 19400003        	 12772:     move.b  D0,($0003,A4)
02:0003F680 41F90003F54A    	 12773:     lea     (GanonBurstTiles).l,A0
02:0003F686 10302000        	 12774:     move.b  (A0,D2.W),D0
02:0003F68A 4EB900031DB4    	 12775:     jsr     Anim_WriteSprite
                            	 12776:     ; Bottom of the loop.
                            	 12777:     ; Increment object slot while <= 9.
                            	 12778:     ;
02:0003F690 5202            	 12779:     addq.b  #1,D2
02:0003F692 0C02000A        	 12780:     cmpi.b  #$0A,D2
02:0003F696 65AC            	 12781:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12782:     ; Restore the object index.
                            	 12783:     ;
02:0003F698 101D            	 12784:     move.b  (A5)+,D0  ; PLA
02:0003F69A 19400340        	 12785:     move.b  D0,($0340,A4)
02:0003F69E 0A3C0001        	 12786:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6A2 4E75            	 12787:     rts
                            	 12788: 
                            	 12789: ; Returns:
                            	 12790: ; [00]: X coordinate
                            	 12791: ;
                            	 12792:     even
