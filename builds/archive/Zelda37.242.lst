                            	  6894: UpdateDodongoState0_Move:
                            	  6895:     ; If facing left, then push X offset 0 on the stack.
                            	  6896:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6897:     ;
                            	  6898:     ; We would like to use one set of coordinates only.
                            	  6899:     ; But movement would break down, if we did; because
                            	  6900:     ; Dodongo is so long.
                            	  6901:     ;
                            	  6902:     ; So, when not facing left, we temporarily shift the
                            	  6903:     ; X coordinate to be closer to the other side of the monster.
                            	  6904:     ;
02:0003CB32 7600            	  6905:     moveq   #0,D3
02:0003CB34 41EC0098        	  6906:     lea     ($0098,A4),A0
02:0003CB38 10302000        	  6907:     move.b  (A0,D2.W),D0
02:0003CB3C 0200000D        	  6908:     andi.b #$0D,D0
02:0003CB40 6716            	  6909:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CB42 10342070        	  6910:     move.b  ($70,A4,D2.W),D0
02:0003CB46 023C00EE        	  6911:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB4A 123C0010        	  6912:     move.b  #$10,D1
02:0003CB4E D101            	  6913:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CB50 19802070        	  6914:     move.b  D0,($70,A4,D2.W)
02:0003CB54 163C00F0        	  6915:     move.b  #$F0,D3
                            	  6916:     even
                            	  6917: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CB58 1003            	  6918:     move.b  D3,D0
