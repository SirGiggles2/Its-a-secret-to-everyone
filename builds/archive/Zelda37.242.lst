02:00042240 41F9000421C6    	  4125:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042246 12303000        	  4126:     move.b  (A0,D3.W),D1
02:0004224A B001            	  4127:     cmp.b   D1,D0
02:0004224C 640E            	  4128:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0004224E 102C0053        	  4129:     move.b  ($0053,A4),D0
02:00042252 122C0098        	  4130:     move.b  ($0098,A4),D1
02:00042256 B001            	  4131:     cmp.b   D1,D0
02:00042258 6700FF7E        	  4132:     beq  _L_z05_CheckDoorway_SearchOverflowBounds
                            	  4133:     even
                            	  4134: _L_z05_CheckDoorway_SearchUnderflowDoorway:
                            	  4135:     ; The player might be in the original doorway facing backwards,
