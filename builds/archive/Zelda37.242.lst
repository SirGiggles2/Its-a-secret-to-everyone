02:0003F87C 41EC0302        	 13047:     lea     ($0302,A4),A0
02:0003F880 11802000        	 13048:     move.b  D0,(A0,D2.W)
02:0003F884 5202            	 13049:     addq.b  #1,D2
02:0003F886 5203            	 13050:     addq.b  #1,D3
02:0003F888 0C030008        	 13051:     cmpi.b  #$08,D3
