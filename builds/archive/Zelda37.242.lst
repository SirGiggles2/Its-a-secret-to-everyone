02:0003E02E 41EC041F        	  9747:     lea     ($041F,A4),A0
02:0003E032 11802000        	  9748:     move.b  D0,(A0,D2.W)
                            	  9749:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9750:     ;
02:0003E036 640000A8        	  9751:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9752:     ; Increase the distance traveled, and move 1.
                            	  9753:     ;
02:0003E03A 41EC0412        	  9754:     lea     ($0412,A4),A0
02:0003E03E 52302000        	  9755:     addq.b  #1,(A0,D2.W)
                            	  9756:     ; Set a direction mask in [02], starting with right (1).
                            	  9757:     ;
02:0003E042 7001            	  9758:     moveq   #1,D0
02:0003E044 19400002        	  9759:     move.b  D0,($0002,A4)
                            	  9760:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9761:     ;
02:0003E048 41EC0098        	  9762:     lea     ($0098,A4),A0
02:0003E04C 10302000        	  9763:     move.b  (A0,D2.W),D0
02:0003E050 122C0002        	  9764:     move.b  ($0002,A4),D1
02:0003E054 C200            	  9765:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E056 6704            	  9766:     beq  _anon_z04_118
02:0003E058 52342070        	  9767:     addq.b  #1,($70,A4,D2.W)
                            	  9768: _anon_z04_118:
                            	  9769:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9770:     ;
02:0003E05C 122C0002        	  9771:     move.b  ($0002,A4),D1
02:0003E060 E309            	  9772:     lsl.b  #1,D1   ; ASL $02
02:0003E062 19410002        	  9773:     move.b  D1,($0002,A4)
02:0003E066 122C0002        	  9774:     move.b  ($0002,A4),D1
02:0003E06A C200            	  9775:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E06C 6704            	  9776:     beq  _anon_z04_119
02:0003E06E 53342070        	  9777:     subq.b  #1,($70,A4,D2.W)
                            	  9778: _anon_z04_119:
