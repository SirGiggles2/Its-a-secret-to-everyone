02:00030776 12302000        	  3042:     move.b  (A0,D2.W),D1
02:0003077A B001            	  3043:     cmp.b   D1,D0
02:0003077C 67CA            	  3044:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003077E 6402            	  3045:     bcc  _anon_z01_27
02:00030780 7608            	  3046:     moveq   #8,D3
                            	  3047: _anon_z01_27:
                            	  3048:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3049:     ; set the vertical direction we determined, and other preparations.
