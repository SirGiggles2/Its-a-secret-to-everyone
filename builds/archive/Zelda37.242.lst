                            	  7521: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CF4E 101D            	  7522:     move.b  (A5)+,D0  ; PLA
02:0003CF50 7600            	  7523:     moveq   #0,D3
02:0003CF52 1600            	  7524:     move.b  D0,D3
                            	  7525:     ; If facing vertically, then return. There's no other side to draw.
                            	  7526:     ;
02:0003CF54 41EC0098        	  7527:     lea     ($0098,A4),A0
02:0003CF58 10302000        	  7528:     move.b  (A0,D2.W),D0
02:0003CF5C 02000003        	  7529:     andi.b #$03,D0
02:0003CF60 6602            	  7530:     bne.s  __far_z_04_0067
02:0003CF62 602C            	  7531:     jmp  L11B00_Exit
                            	  7532: __far_z_04_0067:
                            	  7533:     ; Else draw the right side.
                            	  7534:     ;
                            	  7535:     ; Keep the Y coordinate in [01].
                            	  7536:     ; But, store (X + $10) in [00].
                            	  7537:     ;
02:0003CF64 10342070        	  7538:     move.b  ($70,A4,D2.W),D0
02:0003CF68 023C00EE        	  7539:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF6C 123C0010        	  7540:     move.b  #$10,D1
02:0003CF70 D101            	  7541:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CF72 1880            	  7542:     move.b  D0,($0000,A4)
02:0003CF74 6114            	  7543:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7544:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7545:     ;
                            	  7546:     ; So, if we had animation frame 1, direction left:
                            	  7547:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7548:     ; - frame image index = 6 (1 + 5)
                            	  7549:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7550:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7551:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7552:     ;
                            	  7553:     ; So, 3 would have been the frame number used above for
                            	  7554:     ; the left side.
                            	  7555:     ;
                            	  7556:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7557:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7558:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7559:     ; on the right.
                            	  7560:     ;
02:0003CF76 41F90003CE6C    	  7561:     lea     (DodongoFrameImages).l,A0
02:0003CF7C 10303000        	  7562:     move.b  (A0,D3.W),D0
02:0003CF80 0A000001        	  7563:     eori.b #$01,D0
02:0003CF84 4EF900031AB8    	  7564:     jmp     DrawObjectNotMirrored
                            	  7565: 
                            	  7566: ; Returns:
                            	  7567: ; A: 3
                            	  7568: ; [04]: left sprite attributes
                            	  7569: ; [05]: right sprite attributes
                            	  7570: ;
                            	  7571:     even
                            	  7572: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CF8A 4EF90002C312    	  7573:     jmp     c_anim_set_sprite_desc_level_palette_row
