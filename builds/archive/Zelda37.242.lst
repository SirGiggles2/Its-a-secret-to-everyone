                            	  3690: FindNextEdgeSpawnCell:
                            	  3691:     ; Load [0A] with the value before the call.
                            	  3692:     ;
02:00041EF8 102C0525        	  3693:     move.b  ($0525,A4),D0
02:00041EFC 1940000A        	  3694:     move.b  D0,($000A,A4)
                            	  3695:     even
                            	  3696: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3697:     ; Loop to look for a place to spawn a monster from the edge
                            	  3698:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3699:     ;
                            	  3700:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3701:     ; We'll move down $10 pixels.
                            	  3702:     ;
02:00041F00 7610            	  3703:     moveq   #16,D3
02:00041F02 102C000A        	  3704:     move.b  ($000A,A4),D0
02:00041F06 0200000F        	  3705:     andi.b #$0F,D0
02:00041F0A 670A            	  3706:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3707:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3708:     ; Don't move vertically.
                            	  3709:     ;
02:00041F0C 163C00F0        	  3710:     move.b  #$F0,D3
02:00041F10 0C00000F        	  3711:     cmpi.b  #$0F,D0
02:00041F14 6610            	  3712:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3713:     even
                            	  3714: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3715:     ; Else low nibble = $F. We're at the right edge,
                            	  3716:     ; and we'll move up $10 pixels.
                            	  3717:     ;
02:00041F16 1003            	  3718:     move.b  D3,D0
02:00041F18 023C00EE        	  3719:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F1C 122C000A        	  3720:     move.b  ($000A,A4),D1
02:00041F20 D101            	  3721:     addx.b  D1,D0   ; ADC $0A
02:00041F22 1940000A        	  3722:     move.b  D0,($000A,A4)
                            	  3723:     even
                            	  3724: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3725:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3726:     ; Move right one pixel.
                            	  3727:     ;
02:00041F26 102C000A        	  3728:     move.b  ($000A,A4),D0
02:00041F2A 020000F0        	  3729:     andi.b #$F0,D0
02:00041F2E 0C0000E0        	  3730:     cmpi.b  #$E0,D0
02:00041F32 6606            	  3731:     bne  _anon_z05_88
02:00041F34 522C000A        	  3732:     addq.b  #1,($000A,A4)
02:00041F38 600A            	  3733:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3734: 
                            	  3735: _anon_z05_88:
                            	  3736:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3737:     ; Dont' move horizontally.
                            	  3738:     ;
02:00041F3A 0C000040        	  3739:     cmpi.b  #$40,D0
02:00041F3E 6604            	  3740:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3741:     ; Else high nibble = 4. We're at the top edge.
                            	  3742:     ; Move left 1 pixel.
                            	  3743:     ;
02:00041F40 532C000A        	  3744:     subq.b  #1,($000A,A4)
                            	  3745:     even
                            	  3746: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3747:     ; Time to get the address of the column.
                            	  3748:     ; Starting at the top of the leftmost column.
                            	  3749:     ;
02:00041F44 61002688        	  3750:     jsr     FetchTileMapAddr
02:00041F48 7005            	  3751:     moveq   #5,D0
02:00041F4A 4EB90002A9FA    	  3752:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3753:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3754:     ; in order to point to the column we want.
                            	  3755:     ;
02:00041F50 102C000A        	  3756:     move.b  ($000A,A4),D0
02:00041F54 0200000F        	  3757:     andi.b #$0F,D0
02:00041F58 7600            	  3758:     moveq   #0,D3
02:00041F5A 1600            	  3759:     move.b  D0,D3
02:00041F5C 670C            	  3760:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3761: _anon_z05_89:
02:00041F5E 702C            	  3762:     moveq   #44,D0
02:00041F60 4EB9000313BA    	  3763:     jsr     AddToInt16At0
02:00041F66 5303            	  3764:     subq.b  #1,D3
02:00041F68 66F4            	  3765:     bne  _anon_z05_89
                            	  3766:     even
                            	  3767: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3768:     ; Turn the row part of [0A] into a tile index.
                            	  3769:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3770:     ;
02:00041F6A 102C000A        	  3771:     move.b  ($000A,A4),D0
02:00041F6E 020000F0        	  3772:     andi.b #$F0,D0
02:00041F72 003C0011        	  3773:     ori     #$11,CCR  ; SEC: set C+X
02:00041F76 123C0040        	  3774:     move.b  #$40,D1
02:00041F7A 0A3C0010        	  3775:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F7E 9101            	  3776:     subx.b  D1,D0   ; SBC #$40
02:00041F80 0A3C0010        	  3777:     eori    #$10,CCR  ; restore X = 6502 C
02:00041F84 E208            	  3778:     lsr.b  #1,D0   ; LSR A
02:00041F86 E208            	  3779:     lsr.b  #1,D0   ; LSR A
02:00041F88 E208            	  3780:     lsr.b  #1,D0   ; LSR A
02:00041F8A 7600            	  3781:     moveq   #0,D3
02:00041F8C 1600            	  3782:     move.b  D0,D3
                            	  3783:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3784:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3785:     ; when coming in from the edges.
                            	  3786:     ;
02:00041F8E 1214            	  3787:     move.b  ($00,A4),D1   ; ptr lo
02:00041F90 182C0001        	  3788:     move.b  ($01,A4),D4  ; ptr hi
02:00041F94 024100FF        	  3789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041F98 E14C            	  3790:     lsl.w   #8,D4
02:00041F9A 8841            	  3791:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041F9C 48C4            	  3792:     ext.l   D4
02:00041F9E D8BC00FF0000    	  3793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041FA4 2044            	  3794:     movea.l D4,A0
02:00041FA6 10303000        	  3795:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041FAA 0C000084        	  3796:     cmpi.b  #$84,D0
02:00041FAE 650E            	  3797:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3798:     ; Bottom of the loop.
                            	  3799:     ; If you reach the original cell, then stop.
                            	  3800:     ;
02:00041FB0 102C000A        	  3801:     move.b  ($000A,A4),D0
02:00041FB4 122C0525        	  3802:     move.b  ($0525,A4),D1
02:00041FB8 B001            	  3803:     cmp.b   D1,D0
02:00041FBA 6600FF44        	  3804:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3805:     even
                            	  3806: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3807:     ; Set the spawn cell to the one we found.
                            	  3808:     ;
02:00041FBE 102C000A        	  3809:     move.b  ($000A,A4),D0
02:00041FC2 19400525        	  3810:     move.b  D0,($0525,A4)
