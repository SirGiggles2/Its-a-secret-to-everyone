                            	  6962: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6963:     ; Bloated timer =>
                            	  6964:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6965:     ; 1:     go advance the substate
                            	  6966:     ; other: go decrement Bloated timer
                            	  6967:     ;
02:0003CBB8 7600            	  6968:     moveq   #0,D3
02:0003CBBA 41EC045E        	  6969:     lea     ($045E,A4),A0
02:0003CBBE 16302000        	  6970:     move.b  (A0,D2.W),D3
02:0003CBC2 5303            	  6971:     subq.b  #1,D3
02:0003CBC4 6750            	  6972:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CBC6 6B04            	  6973:     bmi.s  __far_z_04_0058
02:0003CBC8 60000080        	  6974:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6975: __far_z_04_0058:
                            	  6976:     ; Set the bloated timer according to the substate.
                            	  6977:     ;
02:0003CBCC 7600            	  6978:     moveq   #0,D3
02:0003CBCE 41EC042C        	  6979:     lea     ($042C,A4),A0
