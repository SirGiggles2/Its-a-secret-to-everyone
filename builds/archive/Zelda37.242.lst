02:0003EE76 7604            	 11617:     moveq   #4,D3
                            	 11618:     even
                            	 11619: _L_z04_UpdateLamnola_FindTail:
02:0003EE78 5203            	 11620:     addq.b  #1,D3
02:0003EE7A 41EC0350        	 11621:     lea     ($0350,A4),A0
02:0003EE7E 10303000        	 11622:     move.b  (A0,D3.W),D0
02:0003EE82 122C04E7        	 11623:     move.b  ($04E7,A4),D1
02:0003EE86 B001            	 11624:     cmp.b   D1,D0
02:0003EE88 66EE            	 11625:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11626:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11627:     ;
02:0003EE8A 7011            	 11628:     moveq   #17,D0
02:0003EE8C 19803029        	 11629:     move.b  D0,($29,A4,D3.W)
                            	 11630:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11631:     ; to the tail segment.
