                            	  5571: _L_z01_CheckMazes_PlaySecretTune:
                            	  5572:     ; Play secret tune, and let the player leave the maze.
                            	  5573:     ;
02:00031852 7004            	  5574:     moveq   #4,D0
02:00031854 19400602        	  5575:     move.b  D0,($0602,A4)
02:00031858 4E75            	  5576:     rts
                            	  5577: 
                            	  5578: ; Params:
                            	  5579: ; [02]: Y
                            	  5580: ; [03]: X
                            	  5581: ;
                            	  5582: ; Returns:
                            	  5583: ; [00]: high byte of PPU address
                            	  5584: ; [01]: low byte of PPU address
                            	  5585: ;
                            	  5586: ;
                            	  5587: ; Turn the 16-bit value 08YY into the PPU address
                            	  5588: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5589: ;
                            	  5590: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5591: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5592: ;
                            	  5593:     even
                            	  5594: MapScreenPosToPpuAddr:
02:0003185A 6000A20A        	  5595:     jmp     c_map_screen_pos_to_ppu_addr
