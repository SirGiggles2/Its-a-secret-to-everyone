                            	 10008: Gohma_CheckCollisions:
                            	 10009:     ; Save the boss's X coordinate.
                            	 10010:     ;
02:0003E214 10342070        	 10011:     move.b  ($70,A4,D2.W),D0
02:0003E218 1B00            	 10012:     move.b  D0,-(A5)  ; PHA
                            	 10013:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10014:     ; on the left side.
                            	 10015:     ;
02:0003E21A 003C0011        	 10016:     ori     #$11,CCR  ; SEC: set C+X
02:0003E21E 123C0010        	 10017:     move.b  #$10,D1
02:0003E222 0A3C0010        	 10018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E226 9101            	 10019:     subx.b  D1,D0   ; SBC #$10
02:0003E228 0A3C0010        	 10020:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E22C 19802070        	 10021:     move.b  D0,($70,A4,D2.W)
                            	 10022:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10023:     ; from left to right, indexed by [0F].
                            	 10024:     ;
02:0003E230 7005            	 10025:     moveq   #5,D0
02:0003E232 1940000F        	 10026:     move.b  D0,($000F,A4)
                            	 10027:     even
                            	 10028: _L_z04_Gohma_CheckCollisions_LoopSprite:
02:0003E236 4EB900031E34    	 10029:     jsr     CheckMonsterCollisions
                            	 10030:     ; Add 8 to the X coordinate for the next part.
                            	 10031:     ;
02:0003E23C 10342070        	 10032:     move.b  ($70,A4,D2.W),D0
02:0003E240 023C00EE        	 10033:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E244 123C0008        	 10034:     move.b  #$08,D1
02:0003E248 D101            	 10035:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
