                            	 12202: PatraChild_State1:
                            	 12203:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12204:     ;
02:0003F282 10342070        	 12205:     move.b  ($70,A4,D2.W),D0
02:0003F286 023C00EE        	 12206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F28A 122C046C        	 12207:     move.b  ($046C,A4),D1
02:0003F28E D101            	 12208:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003F290 19802070        	 12209:     move.b  D0,($70,A4,D2.W)
02:0003F294 41EC0084        	 12210:     lea     ($0084,A4),A0
02:0003F298 10302000        	 12211:     move.b  (A0,D2.W),D0
02:0003F29C 023C00EE        	 12212:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F2A0 122C0479        	 12213:     move.b  ($0479,A4),D1
02:0003F2A4 D101            	 12214:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003F2A6 41EC0084        	 12215:     lea     ($0084,A4),A0
02:0003F2AA 11802000        	 12216:     move.b  D0,(A0,D2.W)
                            	 12217:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12218:     ;
02:0003F2AE 7000            	 12219:     moveq   #0,D0
02:0003F2B0 1940000B        	 12220:     move.b  D0,($000B,A4)
                            	 12221:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12222:     ; monster's angle by $70, else by $60 to go slower.
                            	 12223:     ;
02:0003F2B4 7070            	 12224:     moveq   #112,D0
02:0003F2B6 7600            	 12225:     moveq   #0,D3
02:0003F2B8 41EC034F        	 12226:     lea     ($034F,A4),A0
02:0003F2BC 16302000        	 12227:     move.b  (A0,D2.W),D3
02:0003F2C0 0C030025        	 12228:     cmpi.b  #$25,D3
02:0003F2C4 6702            	 12229:     beq  _anon_z04_159
02:0003F2C6 7060            	 12230:     moveq   #96,D0
                            	 12231: _anon_z04_159:
02:0003F2C8 61000D9C        	 12232:     jsr     DecreaseObjectAngle
                            	 12233:     ; Load Patra's maneuver index.
                            	 12234:     ; It determines which counts of bits are looked up below.
                            	 12235:     ;
02:0003F2CC 7600            	 12236:     moveq   #0,D3
02:0003F2CE 162C045F        	 12237:     move.b  ($045F,A4),D3
                            	 12238:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12239:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12240:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12241:     ;
02:0003F2D2 41EC034F        	 12242:     lea     ($034F,A4),A0
02:0003F2D6 10302000        	 12243:     move.b  (A0,D2.W),D0
02:0003F2DA 0C000025        	 12244:     cmpi.b  #$25,D0
02:0003F2DE 661E            	 12245:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F2E0 41F90003F1D2    	 12246:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F2E6 10303000        	 12247:     move.b  (A0,D3.W),D0
02:0003F2EA 1B00            	 12248:     move.b  D0,-(A5)  ; PHA
02:0003F2EC 41F90003F1D6    	 12249:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F2F2 10303000        	 12250:     move.b  (A0,D3.W),D0
02:0003F2F6 7600            	 12251:     moveq   #0,D3
02:0003F2F8 1600            	 12252:     move.b  D0,D3
02:0003F2FA 101D            	 12253:     move.b  (A5)+,D0  ; PLA
02:0003F2FC 600E            	 12254:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12255: 
                            	 12256:     even
                            	 12257: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12258:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12259:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12260:     ; a small circle (5) and a large circle (6).
                            	 12261:     ;
02:0003F2FE 41F90003F1D4    	 12262:     lea     (PatraChild2RotationBits).l,A0
02:0003F304 10303000        	 12263:     move.b  (A0,D3.W),D0
02:0003F308 7600            	 12264:     moveq   #0,D3
02:0003F30A 1600            	 12265:     move.b  D0,D3
                            	 12266:     even
