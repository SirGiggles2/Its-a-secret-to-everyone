02:00040378 102C0010        	   501:     move.b  ($0010,A4),D0
02:0004037C 6606            	   502:     bne.s  __far_z_05_0002
02:0004037E 4EF90002D664    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
