                            	 12394:     ; 2. clear the item to lift
                            	 12395:     ; 3. play level 9 song
                            	 12396:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12397:     ;
02:0003F3D6 194000AC        	 12398:     move.b  D0,($00AC,A4)
02:0003F3DA 19400505        	 12399:     move.b  D0,($0505,A4)
02:0003F3DE 7020            	 12400:     moveq   #32,D0
02:0003F3E0 19400600        	 12401:     move.b  D0,($0600,A4)
02:0003F3E4 522C0445        	 12402:     addq.b  #1,($0445,A4)
                            	 12403:     even
