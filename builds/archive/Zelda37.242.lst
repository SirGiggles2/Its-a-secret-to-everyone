02:00044DB0 1940000C        	  8037:     move.b  D0,($000C,A4)
02:00044DB4 19400057        	  8038:     move.b  D0,($0057,A4)
                            	  8039:     ; Look for walkable directions that are components of the
                            	  8040:     ; input directions.
