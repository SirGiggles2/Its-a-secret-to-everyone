                            	  1618: InitMode4:
02:0004103A 7400            	  1619:     moveq   #0,D2
02:0004103C 142C0013        	  1620:     move.b  ($0013,A4),D2
02:00041040 6604            	  1621:     bne.s  __far_z_05_0023
02:00041042 60000084        	  1622:     jmp  InitMode_EnterRoom
                            	  1623: __far_z_05_0023:
02:00041046 5302            	  1624:     subq.b  #1,D2
02:00041048 6612            	  1625:     bne  _L_z05_InitMode4_CheckSub2
                            	  1626:     ; Submode 1.
                            	  1627:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1628:     ;
                            	  1629:     ; TODO:
                            	  1630:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1631:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1632:     ; A positive value triggers this submode 1 to transfer
                            	  1633:     ; the whole play area.
                            	  1634:     ;
                            	  1635:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1636:     ; a good state reflecting the new room. The only thing
                            	  1637:     ; needed is possibly to brighten the room by way of
                            	  1638:     ; changing the palette.
                            	  1639:     ;
                            	  1640:     ; So why does mode 7 trigger this?
                            	  1641:     ; Is there another mode that truly needs this behavior?
                            	  1642:     ;
02:0004104A 102C00E9        	  1643:     move.b  ($00E9,A4),D0
02:0004104E 6B06            	  1644:     bmi  _anon_z05_40
02:00041050 61003588        	  1645:     jsr     CopyNextRowToTransferBuf
02:00041054 6404            	  1646:     bcc  _L_z05_InitMode4_Exit
                            	  1647: _anon_z05_40:
02:00041056 522C0013        	  1648:     addq.b  #1,($0013,A4)
                            	  1649:     even
                            	  1650: _L_z05_InitMode4_Exit:
02:0004105A 4E75            	  1651:     rts
                            	  1652: 
                            	  1653:     even
                            	  1654: _L_z05_InitMode4_CheckSub2:
02:0004105C 5302            	  1655:     subq.b  #1,D2
02:0004105E 6702            	  1656:     beq.s  __far_z_05_0024
02:00041060 6058            	  1657:     jmp  InitMode4_Sub3
                            	  1658: __far_z_05_0024:
                            	  1659:     ; Submode 2.
                            	  1660:     ;
02:00041062 7600            	  1661:     moveq   #0,D3
02:00041064 162C00EB        	  1662:     move.b  ($00EB,A4),D3
02:00041068 610043BC        	  1663:     jsr     IsDarkRoom_Bank5
02:0004106C 6702            	  1664:     beq.s  __far_z_05_0025
02:0004106E 6052            	  1665:     jmp  InitMode4_GoToSub0
                            	  1666: __far_z_05_0025:
                            	  1667:     ; This is a light room.
                            	  1668:     ; See if we have to brighten it after leaving a dark room.
                            	  1669:     ;
02:00041070 102C0098        	  1670:     move.b  ($0098,A4),D0
02:00041074 610041F8        	  1671:     jsr     CalcNextRoomByDir
                            	  1672:     ; Subtract RoomId from next room ID that was calculated
                            	  1673:     ; to get room ID offset in that direction.
02:00041078 003C0011        	  1674:     ori     #$11,CCR  ; SEC: set C+X
02:0004107C 122C00EB        	  1675:     move.b  ($00EB,A4),D1
02:00041080 0A3C0010        	  1676:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041084 9101            	  1677:     subx.b  D1,D0   ; SBC RoomId
02:00041086 0A3C0010        	  1678:     eori    #$10,CCR  ; restore X = 6502 C
02:0004108A 4EB900030F6A    	  1679:     jsr     Negate
02:00041090 023C00EE        	  1680:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041094 122C00EB        	  1681:     move.b  ($00EB,A4),D1
02:00041098 D101            	  1682:     addx.b  D1,D0   ; ADC RoomId
02:0004109A 7600            	  1683:     moveq   #0,D3
02:0004109C 1600            	  1684:     move.b  D0,D3
02:0004109E 61004386        	  1685:     jsr     IsDarkRoom_Bank5
02:000410A2 6602            	  1686:     bne.s  __far_z_05_0026
02:000410A4 601C            	  1687:     jmp  InitMode4_GoToSub0
                            	  1688: __far_z_05_0026:
                            	  1689:     ; The previous room was dark.
                            	  1690:     ;
02:000410A6 102C051F        	  1691:     move.b  ($051F,A4),D0
02:000410AA 6702            	  1692:     beq.s  __far_z_05_0027
02:000410AC 6014            	  1693:     jmp  InitMode4_GoToSub0
                            	  1694: __far_z_05_0027:
02:000410AE 103C00C0        	  1695:     move.b  #$C0,D0
                            	  1696: ; Params:
                            	  1697: ; A: start index of cycle
                            	  1698: ;
                            	  1699:     even
