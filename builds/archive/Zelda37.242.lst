                            	  7298:     even
                            	  7299: DodongoBombPositiveLimits:
02:0003CE06 0C              	  7300:     dc.b    $0C, $11
02:0003CE07 11
                            	  7301: 
                            	  7302:     even
                            	  7303: DodongoBombNegativeLimits:
02:0003CE08 F4              	  7304:     dc.b    $F4, $F0
02:0003CE09 F0
                            	  7305: 
                            	  7306: ; Params:
                            	  7307: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7308: ; [00]: monster hotspot X
                            	  7309: ; [01]: monster hotspot Y
                            	  7310: ; [02]: bomb hotspot X
                            	  7311: ; [03]: bomb hotspot Y
                            	  7312: ;
                            	  7313: ; Returns:
                            	  7314: ; A: 0 if the bomb is in range of the monster
                            	  7315: ; Z: 1 if the bomb is in range of the monster
                            	  7316: ; [04]: horizontal distance
                            	  7317: ; [05]: vertical distance
                            	  7318: ;
                            	  7319: ; Store the positive limit in [06], and the negative one in [07].
                            	  7320: ;
                            	  7321:     even
                            	  7322: Dodongo_IsBombInRange:
02:0003CE0A 41F90003CE06    	  7323:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CE10 10303000        	  7324:     move.b  (A0,D3.W),D0
02:0003CE14 19400006        	  7325:     move.b  D0,($0006,A4)
02:0003CE18 41F90003CE08    	  7326:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CE1E 10303000        	  7327:     move.b  (A0,D3.W),D0
02:0003CE22 19400007        	  7328:     move.b  D0,($0007,A4)
                            	  7329:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7330:     ; the bomb is near enough the monster.
                            	  7331:     ;
02:0003CE26 7003            	  7332:     moveq   #3,D0
02:0003CE28 19400008        	  7333:     move.b  D0,($0008,A4)
                            	  7334:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7335:     ;
02:0003CE2C 7601            	  7336:     moveq   #1,D3
                            	  7337:     even
                            	  7338: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7339:     ; Subtract the bomb's coordinate from the boss's,
                            	  7340:     ; The loop index determines the coordinate.
                            	  7341:     ;
02:0003CE2E 10343000        	  7342:     move.b  ($00,A4,D3.W),D0
02:0003CE32 003C0011        	  7343:     ori     #$11,CCR  ; SEC: set C+X
02:0003CE36 12343002        	  7344:     move.b  ($02,A4,D3.W),D1
02:0003CE3A 0A3C0010        	  7345:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CE3E 9101            	  7346:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CE40 0A3C0010        	  7347:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7348:     ; If the distance >= positive offset, or < negative offset;
                            	  7349:     ; then loop again.
                            	  7350:     ;
02:0003CE44 122C0006        	  7351:     move.b  ($0006,A4),D1
02:0003CE48 B001            	  7352:     cmp.b   D1,D0
02:0003CE4A 6A16            	  7353:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CE4C 122C0007        	  7354:     move.b  ($0007,A4),D1
02:0003CE50 B001            	  7355:     cmp.b   D1,D0
02:0003CE52 6B0E            	  7356:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7357:     ; The distance is close enough in this axis.
                            	  7358:     ;
                            	  7359:     ; Store the distance in this axis in [05] or [04],
                            	  7360:     ; depending on the loop index.
                            	  7361:     ;
02:0003CE54 19803004        	  7362:     move.b  D0,($04,A4,D3.W)
                            	  7363:     ; Shift [08] right, because we're in range in this axis.
                            	  7364:     ;
02:0003CE58 122C0008        	  7365:     move.b  ($0008,A4),D1
02:0003CE5C E209            	  7366:     lsr.b  #1,D1   ; LSR $08
02:0003CE5E 19410008        	  7367:     move.b  D1,($0008,A4)
                            	  7368:     even
                            	  7369: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CE62 5303            	  7370:     subq.b  #1,D3
02:0003CE64 6AC8            	  7371:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7372:     ; If close enough in both axes, then [08] will be 0.
                            	  7373:     ;
02:0003CE66 102C0008        	  7374:     move.b  ($0008,A4),D0
02:0003CE6A 4E75            	  7375:     rts
                            	  7376: 
                            	  7377: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7378: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7379: ;
                            	  7380: ; But these are not typical direction indexes. Instead a
                            	  7381: ; 5-way index is used.
                            	  7382: ; A direction shifted right once becomes a 5-way index.
                            	  7383: ; The fourth element is unused.
                            	  7384: ;
                            	  7385:     even
                            	  7386: DodongoFrameImages:
02:0003CE6C 00              	  7387:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CE6D 01
02:0003CE6E 06
02:0003CE6F FF
02:0003CE70 08
02:0003CE71 02
02:0003CE72 03
02:0003CE73 06
02:0003CE74 FF              	  7388:     dc.b    $FF, $08
02:0003CE75 08
                            	  7389: 
                            	  7390:     even
                            	  7391: DodongoFrameHFlips:
02:0003CE76 00              	  7392:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CE77 40
02:0003CE78 00
02:0003CE79 FF
02:0003CE7A 00
02:0003CE7B 00
02:0003CE7C 40
02:0003CE7D 40
02:0003CE7E FF              	  7393:     dc.b    $FF, $40
02:0003CE7F 40
                            	  7394: 
                            	  7395:     even
                            	  7396: DodongoFrameImagesBloated:
02:0003CE80 04              	  7397:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CE81 05
02:0003CE82 07
02:0003CE83 FF
02:0003CE84 09
02:0003CE85 04
02:0003CE86 05
02:0003CE87 07
02:0003CE88 FF              	  7398:     dc.b    $FF, $09
02:0003CE89 09
                            	  7399: 
                            	  7400:     even
                            	  7401: DodongoFrameHFlipsBloated:
02:0003CE8A 00              	  7402:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CE8B 40
02:0003CE8C 00
02:0003CE8D FF
02:0003CE8E 00
02:0003CE8F 00
02:0003CE90 40
02:0003CE91 00
02:0003CE92 FF              	  7403:     dc.b    $FF, $00
02:0003CE93 00
                            	  7404: 
                            	  7405:     even
                            	  7406: Dodongo_Draw:
02:0003CE94 610000F4        	  7407:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7408:     ; Make a 5-way direction index out of the facing direction
                            	  7409:     ; by shifting right once, and store it in [00].
                            	  7410:     ;
02:0003CE98 41EC0098        	  7411:     lea     ($0098,A4),A0
02:0003CE9C 10302000        	  7412:     move.b  (A0,D2.W),D0
02:0003CEA0 E208            	  7413:     lsr.b  #1,D0   ; LSR A
02:0003CEA2 1880            	  7414:     move.b  D0,($0000,A4)
                            	  7415:     ; If state = 0, go handle animating the two frames of this state.
                            	  7416:     ;
02:0003CEA4 7600            	  7417:     moveq   #0,D3
02:0003CEA6 41EC00AC        	  7418:     lea     ($00AC,A4),A0
02:0003CEAA 16302000        	  7419:     move.b  (A0,D2.W),D3
02:0003CEAE 6744            	  7420:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7421:     ; If state > 1, then the monster is stunned (state 2).
                            	  7422:     ; So, go switch frames every $20 screen frames.
                            	  7423:     ;
02:0003CEB0 7020            	  7424:     moveq   #32,D0
02:0003CEB2 5303            	  7425:     subq.b  #1,D3
02:0003CEB4 6640            	  7426:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7427:     ; State = 1. Bloated.
                            	  7428:     ;
                            	  7429:     ; In substate 0, go animate as usual for walking.
                            	  7430:     ;
02:0003CEB6 7600            	  7431:     moveq   #0,D3
02:0003CEB8 41EC042C        	  7432:     lea     ($042C,A4),A0
02:0003CEBC 16302000        	  7433:     move.b  (A0,D2.W),D3
02:0003CEC0 6732            	  7434:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7435:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7436:     ; go fade the boss; so that some frames are not drawn.
                            	  7437:     ;
02:0003CEC2 0C030002        	  7438:     cmpi.b  #$02,D3
02:0003CEC6 6718            	  7439:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CEC8 0C030003        	  7440:     cmpi.b  #$03,D3
02:0003CECC 6712            	  7441:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7442:     ; State 1, substate 1
                            	  7443:     ;
                            	  7444:     ; Add $14 to the frame image index to index into the bloated
                            	  7445:     ; frame images and H-flips.
                            	  7446:     ;
02:0003CECE 1014            	  7447:     move.b  ($0000,A4),D0
02:0003CED0 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
