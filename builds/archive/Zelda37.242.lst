                            	  8084: HaveInput:
                            	  8085:     ; There were input directions.
                            	  8086:     ;
                            	  8087:     ; If there was only one input direction, go set object direction
                            	  8088:     ; to input direction, and set Link's speed.
                            	  8089:     ;
                            	  8090:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8091:     ; (X is still 0, because it's Link's object index).
                            	  8092:     ;
02:00044E06 102C000F        	  8093:     move.b  ($000F,A4),D0
02:00044E0A 0C030001        	  8094:     cmpi.b  #$01,D3
02:00044E0E 670000B6        	  8095:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8096:     ; There were more than one input directions.
                            	  8097:     ;
                            	  8098:     ; If none were walkable, go set input direction to 0, and return.
                            	  8099:     ;
02:00044E12 102C000C        	  8100:     move.b  ($000C,A4),D0
02:00044E16 6604            	  8101:     bne  _anon_z05_174
02:00044E18 60000128        	  8102:     jmp     SetLinkInputDir
                            	  8103: 
                            	  8104: _anon_z05_174:
                            	  8105:     ; Two input directions, and at least one of them is walkable.
                            	  8106:     ;
                            	  8107:     ; Make Link go straight in one direction on the next grid line.
                            	  8108:     ;
02:00044E1C 7600            	  8109:     moveq   #0,D3
02:00044E1E 1600            	  8110:     move.b  D0,D3
02:00044E20 522C0057        	  8111:     addq.b  #1,($0057,A4)
                            	  8112:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8113:     ; object direction and input direction to last walkable direction
                            	  8114:     ; found, and set Link's speed.
                            	  8115:     ;
                            	  8116:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8117:     ;
02:00044E24 7400            	  8118:     moveq   #0,D2
02:00044E26 102C000D        	  8119:     move.b  ($000D,A4),D0
02:00044E2A 0C030001        	  8120:     cmpi.b  #$01,D3
02:00044E2E 67000096        	  8121:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00044E32 7600            	  8122:     moveq   #0,D3
02:00044E34 162C0010        	  8123:     move.b  ($0010,A4),D3
02:00044E38 6700008C        	  8124:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8125:     ; In UW. There are two input directions, and they're both walkable.
                            	  8126:     ;
                            	  8127:     ; Normally, turn to the direction that's perpendicular to object
                            	  8128:     ; direction. But keep going straight after that, while diagonal
                            	  8129:     ; input is held.
                            	  8130:     ;
                            	  8131:     ; Handle special cases for doors.
                            	  8132:     ;
                            	  8133:     ;
                            	  8134:     ; 1. Link at horizontal doors.
                            	  8135:     ;
                            	  8136:     ; If Link's X = $20 or $D0 then
                            	  8137:     ;   If Link's Y = $85 and facing down then
                            	  8138:     ;     Go set object direction and input direction to object
                            	  8139:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8140:     ;     Link_GoStraightWhenDiagInput.
                            	  8141:     ;   Else
                            	  8142:     ;     Go turn to the perpendicular direction
                            	  8143:     ;
02:00044E3C 7600            	  8144:     moveq   #0,D3
02:00044E3E 162C0070        	  8145:     move.b  ($0070,A4),D3
02:00044E42 0C030020        	  8146:     cmpi.b  #$20,D3
02:00044E46 6706            	  8147:     beq  _anon_z05_175
02:00044E48 0C0300D0        	  8148:     cmpi.b  #$D0,D3
02:00044E4C 661C            	  8149:     bne  _anon_z05_176
                            	  8150: _anon_z05_175:
02:00044E4E 7600            	  8151:     moveq   #0,D3
02:00044E50 162C0084        	  8152:     move.b  ($0084,A4),D3
02:00044E54 0C030085        	  8153:     cmpi.b  #$85,D3
02:00044E58 6642            	  8154:     bne  _anon_z05_177
02:00044E5A 102C0098        	  8155:     move.b  ($0098,A4),D0
02:00044E5E 02000004        	  8156:     andi.b #$04,D0
02:00044E62 6738            	  8157:     beq  _anon_z05_177
                            	  8158:     even
                            	  8159: _L_z05_HaveInput_SetLinkDirToObjDir:
02:00044E64 102C0098        	  8160:     move.b  ($0098,A4),D0
02:00044E68 665C            	  8161:     bne  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8162: _anon_z05_176:
                            	  8163:     ; If allowed to turn when input is diagonal (2 directions), then
                            	  8164:     ; go take the direction perpendicular to object direction.
                            	  8165:     ;
02:00044E6A 102C0098        	  8166:     move.b  ($0098,A4),D0
02:00044E6E 7400            	  8167:     moveq   #0,D2
02:00044E70 142C0056        	  8168:     move.b  ($0056,A4),D2
02:00044E74 6726            	  8169:     beq  _anon_z05_177
                            	  8170:     ; At this point, Link_GoStraightWhenDiagInput is true.
                            	  8171:     ;
                            	  8172:     ;
                            	  8173:     ; 2. Link at top door.
