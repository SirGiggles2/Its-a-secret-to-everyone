02:0002E6BA 102C0001        	   678:     move.b  ($0001,A4),D0
02:0002E6BE 6148            	   679:     jsr     SwapSpaceAndSign
02:0002E6C0 41EC0307        	   680:     lea     ($0307,A4),A0
02:0002E6C4 11803000        	   681:     move.b  D0,(A0,D3.W)
02:0002E6C8 102C0003        	   682:     move.b  ($0003,A4),D0
02:0002E6CC 41EC0309        	   683:     lea     ($0309,A4),A0
02:0002E6D0 11803000        	   684:     move.b  D0,(A0,D3.W)
                            	   685:     ; Add 4 to the base offset for the next string.
