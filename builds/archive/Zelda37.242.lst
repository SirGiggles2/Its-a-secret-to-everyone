02:00041D76 60E4            	  3445:     jmp  GoToModeAFromCave
                            	  3446: __far_z_05_0063:
02:00041D78 4E75            	  3447:     rts
                            	  3448: 
                            	  3449: ; Params:
                            	  3450: ; [0F]: movement direction
                            	  3451: ;
                            	  3452: ; Returns:
                            	  3453: ; [0F]: movement direction or 0
                            	  3454: ;
                            	  3455: ;
                            	  3456: ; If the ladder's not in use, return.
                            	  3457: ;
                            	  3458:     even
                            	  3459: CheckLadder:
02:00041D7A 7400            	  3460:     moveq   #0,D2
02:00041D7C 142C0064        	  3461:     move.b  ($0064,A4),D2
02:00041D80 670000BE        	  3462:     beq  _L_z05_CheckLadder_Exit
                            	  3463:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3464:     ;
02:00041D84 41EC00AC        	  3465:     lea     ($00AC,A4),A0
02:00041D88 10302000        	  3466:     move.b  (A0,D2.W),D0
02:00041D8C 670000A6        	  3467:     beq  _L_z05_CheckLadder_StashLadder
                            	  3468:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3469:     ; between the ladder and Link.
                            	  3470:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3471:     ;
02:00041D90 41EC0098        	  3472:     lea     ($0098,A4),A0
02:00041D94 10302000        	  3473:     move.b  (A0,D2.W),D0
02:00041D98 0200000C        	  3474:     andi.b #$0C,D0
02:00041D9C 6734            	  3475:     beq  _anon_z05_85
02:00041D9E 102C0070        	  3476:     move.b  ($0070,A4),D0
02:00041DA2 12342070        	  3477:     move.b  ($70,A4,D2.W),D1
02:00041DA6 B001            	  3478:     cmp.b   D1,D0
02:00041DA8 6600008A        	  3479:     bne  _L_z05_CheckLadder_StashLadder
02:00041DAC 102C0084        	  3480:     move.b  ($0084,A4),D0
02:00041DB0 023C00EE        	  3481:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041DB4 123C0003        	  3482:     move.b  #$03,D1
02:00041DB8 D101            	  3483:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041DBA 003C0011        	  3484:     ori     #$11,CCR  ; SEC: set C+X
02:00041DBE 41EC0084        	  3485:     lea     ($0084,A4),A0
02:00041DC2 12302000        	  3486:     move.b  (A0,D2.W),D1
02:00041DC6 0A3C0010        	  3487:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DCA 9101            	  3488:     subx.b  D1,D0   ; SBC ObjY,X
02:00041DCC 0A3C0010        	  3489:     eori    #$10,CCR  ; restore X = 6502 C
02:00041DD0 6030            	  3490:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3491: 
                            	  3492: _anon_z05_85:
                            	  3493:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3494:     ; between the ladder and Link.
                            	  3495:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3496:     ;
02:00041DD2 102C0084        	  3497:     move.b  ($0084,A4),D0
02:00041DD6 023C00EE        	  3498:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041DDA 123C0003        	  3499:     move.b  #$03,D1
02:00041DDE D101            	  3500:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041DE0 41EC0084        	  3501:     lea     ($0084,A4),A0
02:00041DE4 12302000        	  3502:     move.b  (A0,D2.W),D1
02:00041DE8 B001            	  3503:     cmp.b   D1,D0
02:00041DEA 6648            	  3504:     bne  _L_z05_CheckLadder_StashLadder
02:00041DEC 102C0070        	  3505:     move.b  ($0070,A4),D0
02:00041DF0 003C0011        	  3506:     ori     #$11,CCR  ; SEC: set C+X
02:00041DF4 12342070        	  3507:     move.b  ($70,A4,D2.W),D1
02:00041DF8 0A3C0010        	  3508:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DFC 9101            	  3509:     subx.b  D1,D0   ; SBC ObjX,X
02:00041DFE 0A3C0010        	  3510:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3511:     even
                            	  3512: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3513:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3514:     ; If > $10, go put the ladder away.
                            	  3515:     ;
02:00041E02 4EB900030F66    	  3516:     jsr     Abs
02:00041E08 1880            	  3517:     move.b  D0,($0000,A4)
02:00041E0A 0C000010        	  3518:     cmpi.b  #$10,D0
02:00041E0E 6532            	  3519:     bcs  _L_z05_CheckLadder_SetState2
02:00041E10 0C000010        	  3520:     cmpi.b  #$10,D0
02:00041E14 661E            	  3521:     bne  _L_z05_CheckLadder_StashLadder
                            	  3522:     ; Distance = $10. If player's not facing in the same direction as
                            	  3523:     ; the ladder, go put away the ladder.
                            	  3524:     ;
02:00041E16 102C0098        	  3525:     move.b  ($0098,A4),D0
02:00041E1A 41EC0098        	  3526:     lea     ($0098,A4),A0
02:00041E1E 12302000        	  3527:     move.b  (A0,D2.W),D1
02:00041E22 B001            	  3528:     cmp.b   D1,D0
02:00041E24 660E            	  3529:     bne  _L_z05_CheckLadder_StashLadder
                            	  3530:     ; Distance = $10, and player's facing in the same direction.
                            	  3531:     ;
                            	  3532:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3533:     ; ladder and had not stepped onto it yet.
                            	  3534:     ; Go handle movement on it, but don't change state yet.
                            	  3535:     ;
                            	  3536:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3537:     ; off of the ladder. So the ladder should be put away. In this
                            	  3538:     ; case, fall thru.
                            	  3539:     ;
02:00041E26 41EC00AC        	  3540:     lea     ($00AC,A4),A0
02:00041E2A 10302000        	  3541:     move.b  (A0,D2.W),D0
02:00041E2E 0C000001        	  3542:     cmpi.b  #$01,D0
02:00041E32 6718            	  3543:     beq  _L_z05_CheckLadder_HandleInput
                            	  3544:     even
                            	  3545: _L_z05_CheckLadder_StashLadder:
                            	  3546:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3547:     ;
02:00041E34 7000            	  3548:     moveq   #0,D0
02:00041E36 19400064        	  3549:     move.b  D0,($0064,A4)
02:00041E3A 4EB90004D644    	  3550:     jsr     DestroyMonster
                            	  3551:     even
