                            	 12101: UpdatePatraChild:
                            	 12102:     ; If state = 1, then go orbit.
                            	 12103:     ;
02:0003F1D8 41EC00AC        	 12104:     lea     ($00AC,A4),A0
02:0003F1DC 10302000        	 12105:     move.b  (A0,D2.W),D0
02:0003F1E0 6704            	 12106:     beq.s  __far_z_04_0114
02:0003F1E2 6000009E        	 12107:     jmp  PatraChild_State1
                            	 12108: __far_z_04_0114:
                            	 12109:     ; State = 0.
                            	 12110:     ;
                            	 12111:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12112:     ; This is the only patra child shown in the first fame.
                            	 12113:     ;
02:0003F1E6 0C020002        	 12114:     cmpi.b  #$02,D2
02:0003F1EA 6732            	 12115:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12116:     ; The patra child in slot 2 is the last one to be updated.
                            	 12117:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12118:     ;
                            	 12119:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12120:     ; shown.
                            	 12121:     ;
02:0003F1EC 102C00AE        	 12122:     move.b  ($00AE,A4),D0
02:0003F1F0 6700008E        	 12123:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12124:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12125:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12126:     ;
02:0003F1F4 1002            	 12127:     move.b  D2,D0
                            	 12128:     ; Subtract 3 from the object slot to get the angle where the
                            	 12129:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12130:     ;
02:0003F1F6 003C0011        	 12131:     ori     #$11,CCR  ; SEC: set C+X
02:0003F1FA 123C0003        	 12132:     move.b  #$03,D1
02:0003F1FE 0A3C0010        	 12133:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F202 9101            	 12134:     subx.b  D1,D0   ; SBC #$03
02:0003F204 0A3C0010        	 12135:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F208 7600            	 12136:     moveq   #0,D3
02:0003F20A 1600            	 12137:     move.b  D0,D3
                            	 12138:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12139:     ; then return.
                            	 12140:     ;
02:0003F20C 102C0396        	 12141:     move.b  ($0396,A4),D0
02:0003F210 41F90003F1CA    	 12142:     lea     (PatraChildStartAngles).l,A0
02:0003F216 12303000        	 12143:     move.b  (A0,D3.W),D1
02:0003F21A B001            	 12144:     cmp.b   D1,D0
02:0003F21C 6662            	 12145:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12146:     even
                            	 12147: _L_z04_UpdatePatraChild_Ready:
                            	 12148:     ; Once the patra child in the last slot (9) reaches here, advance
                            	 12149:     ; the patra parent's state.
                            	 12150:     ;
02:0003F21E 0C020009        	 12151:     cmpi.b  #$09,D2
02:0003F222 6604            	 12152:     bne  _anon_z04_157
02:0003F224 522C00AD        	 12153:     addq.b  #1,($00AD,A4)
                            	 12154: _anon_z04_157:
                            	 12155:     ; Go to state 1 to orbit.
                            	 12156:     ;
02:0003F228 41EC00AC        	 12157:     lea     ($00AC,A4),A0
02:0003F22C 52302000        	 12158:     addq.b  #1,(A0,D2.W)
                            	 12159:     ; TODO: ?
                            	 12160:     ;
02:0003F230 103C0080        	 12161:     move.b  #$80,D0
02:0003F234 41EC0098        	 12162:     lea     ($0098,A4),A0
02:0003F238 11802000        	 12163:     move.b  D0,(A0,D2.W)
                            	 12164:     ; Set angle $18 (N).
                            	 12165:     ;
02:0003F23C 7018            	 12166:     moveq   #24,D0
02:0003F23E 41EC0394        	 12167:     lea     ($0394,A4),A0
02:0003F242 11802000        	 12168:     move.b  D0,(A0,D2.W)
                            	 12169:     ; This location is right above Patra.
                            	 12170:     ; Set X coordinate to Patra's.
                            	 12171:     ;
02:0003F246 102C0071        	 12172:     move.b  ($0071,A4),D0
02:0003F24A 19802070        	 12173:     move.b  D0,($70,A4,D2.W)
                            	 12174:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12175:     ; Else use radius $18. Store the chosen value in [00].
                            	 12176:     ;
02:0003F24E 702C            	 12177:     moveq   #44,D0
02:0003F250 7600            	 12178:     moveq   #0,D3
02:0003F252 41EC034F        	 12179:     lea     ($034F,A4),A0
02:0003F256 16302000        	 12180:     move.b  (A0,D2.W),D3
02:0003F25A 0C030025        	 12181:     cmpi.b  #$25,D3
02:0003F25E 6702            	 12182:     beq  _anon_z04_158
02:0003F260 7018            	 12183:     moveq   #24,D0
                            	 12184: _anon_z04_158:
02:0003F262 1880            	 12185:     move.b  D0,($0000,A4)
                            	 12186:     ; This location is right above Patra.
                            	 12187:     ; Set Y coordinate to (Patra's Y - [00]).
                            	 12188:     ;
02:0003F264 102C0085        	 12189:     move.b  ($0085,A4),D0
02:0003F268 003C0011        	 12190:     ori     #$11,CCR  ; SEC: set C+X
02:0003F26C 1214            	 12191:     move.b  ($0000,A4),D1
02:0003F26E 0A3C0010        	 12192:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F272 9101            	 12193:     subx.b  D1,D0   ; SBC $00
02:0003F274 0A3C0010        	 12194:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F278 41EC0084        	 12195:     lea     ($0084,A4),A0
02:0003F27C 11802000        	 12196:     move.b  D0,(A0,D2.W)
