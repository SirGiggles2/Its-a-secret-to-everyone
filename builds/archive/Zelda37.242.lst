                            	  3558:     ;
02:00041E42 7002            	  3559:     moveq   #2,D0
02:00041E44 41EC00AC        	  3560:     lea     ($00AC,A4),A0
02:00041E48 11802000        	  3561:     move.b  D0,(A0,D2.W)
                            	  3562:     even
                            	  3563: _L_z05_CheckLadder_HandleInput:
                            	  3564:     ; If input direction = 0, go draw and reset moving direction.
                            	  3565:     ;
02:00041E4C 102C03F8        	  3566:     move.b  ($03F8,A4),D0
02:00041E50 67000086        	  3567:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3568:     ; Input direction <> 0. The player intends to move.
                            	  3569:     ; So, see if we need to override the moving direction.
                            	  3570:     ;
                            	  3571:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3572:     ; go draw and set moving direction to Link's direction.
                            	  3573:     ;
                            	  3574:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3575:     ; been blocked by the water.
                            	  3576:     ;
                            	  3577:     ; Or, Link already passed over the point right over the ladder
                            	  3578:     ; and was allowed to move onto the tiles after the ladder.
                            	  3579:     ;
02:00041E54 102C0098        	  3580:     move.b  ($0098,A4),D0
02:00041E58 7600            	  3581:     moveq   #0,D3
02:00041E5A 1614            	  3582:     move.b  ($0000,A4),D3
02:00041E5C 670C            	  3583:     beq  _anon_z05_86
02:00041E5E 41EC0098        	  3584:     lea     ($0098,A4),A0
02:00041E62 12302000        	  3585:     move.b  (A0,D2.W),D1
02:00041E66 B001            	  3586:     cmp.b   D1,D0
02:00041E68 676E            	  3587:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3588: _anon_z05_86:
                            	  3589:     ; Distance = 0, or facing different directions.
                            	  3590:     ;
                            	  3591:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3592:     ; then go draw and keep moving.
                            	  3593:     ;
                            	  3594:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3595:     ;
                            	  3596:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3597:     ; to move onto the tiles after the ladder.
                            	  3598:     ;
                            	  3599:     ; Note that if Link is not moving, then this test will fail,
                            	  3600:     ; and case (D) will catch it.
                            	  3601:     ;
02:00041E6A 41EC0098        	  3602:     lea     ($0098,A4),A0
02:00041E6E 10302000        	  3603:     move.b  (A0,D2.W),D0
02:00041E72 122C000F        	  3604:     move.b  ($000F,A4),D1
02:00041E76 B001            	  3605:     cmp.b   D1,D0
02:00041E78 675E            	  3606:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3607:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3608:     ; then go draw and move in ladder's direction.
                            	  3609:     ;
                            	  3610:     ; You can always step off the ladder where you came from.
                            	  3611:     ;
02:00041E7A 4EB900030F62    	  3612:     jsr     GetOppositeDir
02:00041E80 122C0098        	  3613:     move.b  ($0098,A4),D1
02:00041E84 B001            	  3614:     cmp.b   D1,D0
02:00041E86 6750            	  3615:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3616:     ; D. If opposite of ladder's direction <> down,
                            	  3617:     ; or input direction <> up,
                            	  3618:     ; then go reset moving direction, and draw.
                            	  3619:     ;
                            	  3620:     ; This will catch all cases of Link facing perpendicular to
                            	  3621:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3622:     ; ladder direction is up and input direction is up (E).
                            	  3623:     ;
02:00041E88 0C000004        	  3624:     cmpi.b  #$04,D0
02:00041E8C 6648            	  3625:     bne  _anon_z05_87
02:00041E8E 102C03F8        	  3626:     move.b  ($03F8,A4),D0
02:00041E92 0C000008        	  3627:     cmpi.b  #$08,D0
02:00041E96 663E            	  3628:     bne  _anon_z05_87
                            	  3629:     ; E. The ladder's direction is up and input direction is up.
                            	  3630:     ;
                            	  3631:     ; An earlier call to check tile collision would have blocked
                            	  3632:     ; movement, because the tile under Link's top half is a water tile.
                            	  3633:     ; But because Link is squarely on the ladder, we really have
                            	  3634:     ; to check the tile above that one.
                            	  3635:     ;
                            	  3636:     ; Set moving direction to input direction (up) and switch X to
                            	  3637:     ; the player's slot for the purpose of checking tile collision below.
                            	  3638:     ; Based on that, we'll set moving direction according to walkability.
                            	  3639:     ;
02:00041E98 6158            	  3640:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3641:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3642:     ;
02:00041E9A 102C0084        	  3643:     move.b  ($0084,A4),D0
02:00041E9E 1B00            	  3644:     move.b  D0,-(A5)  ; PHA
02:00041EA0 003C0011        	  3645:     ori     #$11,CCR  ; SEC: set C+X
02:00041EA4 123C0008        	  3646:     move.b  #$08,D1
02:00041EA8 0A3C0010        	  3647:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EAC 9101            	  3648:     subx.b  D1,D0   ; SBC #$08
02:00041EAE 0A3C0010        	  3649:     eori    #$10,CCR  ; restore X = 6502 C
02:00041EB2 19400084        	  3650:     move.b  D0,($0084,A4)
02:00041EB6 4EB90004B79C    	  3651:     jsr     GetCollidingTileMoving
02:00041EBC 101D            	  3652:     move.b  (A5)+,D0  ; PLA
02:00041EBE 19400084        	  3653:     move.b  D0,($0084,A4)
                            	  3654:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3655:     ; direction as the input direction (in a roundabout way).
                            	  3656:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3657:     ;
02:00041EC2 102C000F        	  3658:     move.b  ($000F,A4),D0
02:00041EC6 7600            	  3659:     moveq   #0,D3
02:00041EC8 162C049E        	  3660:     move.b  ($049E,A4),D3
02:00041ECC 122C034A        	  3661:     move.b  ($034A,A4),D1
02:00041ED0 B601            	  3662:     cmp.b   D1,D3
02:00041ED2 6500FF78        	  3663:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3664: _anon_z05_87:
                            	  3665:     ; Set A to reset moving direction in [0F].
                            	  3666:     ;
02:00041ED6 7000            	  3667:     moveq   #0,D0
                            	  3668:     even
                            	  3669: _L_z05_CheckLadder_DrawLadder:
                            	  3670:     ; Draw the ladder.
                            	  3671:     ;
02:00041ED8 1B00            	  3672:     move.b  D0,-(A5)  ; PHA
02:00041EDA 7400            	  3673:     moveq   #0,D2
02:00041EDC 142C0064        	  3674:     move.b  ($0064,A4),D2
02:00041EE0 4EB90004CE68    	  3675:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041EE6 760C            	  3676:     moveq   #12,D3
02:00041EE8 7000            	  3677:     moveq   #0,D0
02:00041EEA 4EB900031CBC    	  3678:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041EF0 101D            	  3679:     move.b  (A5)+,D0  ; PLA
                            	  3680: ; Params:
                            	  3681: ; A: direction
                            	  3682: ;
                            	  3683: ; Returns:
                            	  3684: ; [0F]: direction
                            	  3685: ;
                            	  3686:     even
                            	  3687: SetMovingDirAndSwitchToPlayerSlot:
02:00041EF2 4EF90002C048    	  3688:     jmp     c_set_moving_dir_switch_player
