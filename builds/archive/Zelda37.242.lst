                            	  7491: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7492:     ; Start preparing sprites.
                            	  7493:     ;
02:0003CF12 4EB90004CE68    	  7494:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CF18 1003            	  7495:     move.b  D3,D0
02:0003CF1A 1B00            	  7496:     move.b  D0,-(A5)  ; PHA
                            	  7497:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7498:     ;
02:0003CF1C 41F90003CE76    	  7499:     lea     (DodongoFrameHFlips).l,A0
02:0003CF22 10303000        	  7500:     move.b  (A0,D3.W),D0
02:0003CF26 1940000F        	  7501:     move.b  D0,($000F,A4)
02:0003CF2A 41F90003CE6C    	  7502:     lea     (DodongoFrameImages).l,A0
02:0003CF30 10303000        	  7503:     move.b  (A0,D3.W),D0
                            	  7504:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7505:     ; They are drawn mirrored.
                            	  7506:     ;
02:0003CF34 0C000007        	  7507:     cmpi.b  #$07,D0
02:0003CF38 6706            	  7508:     beq  _anon_z04_92
02:0003CF3A 0C000009        	  7509:     cmpi.b  #$09,D0
