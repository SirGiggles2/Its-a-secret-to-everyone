                            	  5661: _L_z07_CheckState30_CheckOtherStates:
                            	  5662:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5663:     ;
                            	  5664:     ; The boomerang will now return. Reset the grid offset.
                            	  5665:     ;
02:0004C5A4 7000            	  5666:     moveq   #0,D0
02:0004C5A6 41EC0394        	  5667:     lea     ($0394,A4),A0
02:0004C5AA 11802000        	  5668:     move.b  D0,(A0,D2.W)
                            	  5669:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5670:     ;
02:0004C5AE 0C02000D        	  5671:     cmpi.b  #$0D,D2
02:0004C5B2 6408            	  5672:     bcc  _anon_z07_30
02:0004C5B4 41EC042C        	  5673:     lea     ($042C,A4),A0
02:0004C5B8 10302000        	  5674:     move.b  (A0,D2.W),D0
                            	  5675: _anon_z07_30:
02:0004C5BC 4EB900030FBA    	  5676:     jsr     GetDirectionsAndDistancesToTarget
                            	  5677:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5678:     ; then go move towards the thrower, draw, and check collisions.
                            	  5679:     ;
02:0004C5C2 1014            	  5680:     move.b  ($0000,A4),D0
