                            	  4000: Link_ModifyDirInDoorway:
02:000421B8 4EF90002C05C    	  4001:     jmp     c_link_modify_dir_in_doorway
                            	  4002: 
                            	  4003: DoorwayRequiredCoord:
02:000421BE 78              	  4004:     dc.b    $78, $78, $8D, $8D
02:000421BF 78
02:000421C0 8D
02:000421C1 8D
                            	  4005: 
                            	  4006: ; Player coordinate must be >= these bounds.
                            	  4007: ; Using these bounds; the player will be considered within the
                            	  4008: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4009: ;
                            	  4010:     even
                            	  4011: DoorwayBoundsMinOver:
02:000421C2 3D              	  4012:     dc.b    $3D, $BD, $00, $CF
02:000421C3 BD
02:000421C4 00
02:000421C5 CF
                            	  4013: 
                            	  4014: ; Player coordinate must be < these bounds.
                            	  4015: ; Using these bounds; the player will be considered within the
                            	  4016: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4017: ;
                            	  4018:     even
                            	  4019: DoorwayBoundsMaxOver:
02:000421C6 5E              	  4020:     dc.b    $5E, $DE, $21, $F1
02:000421C7 DE
02:000421C8 21
02:000421C9 F1
                            	  4021: 
                            	  4022: ; Player coordinate must be >= these bounds.
                            	  4023: ; Using these bounds; the player will be considered within the
                            	  4024: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4025: ; at the edge.
                            	  4026: ;
                            	  4027:     even
                            	  4028: DoorwayBoundsMinUnder:
02:000421CA 3D              	  4029:     dc.b    $3D, $BF, $00, $D2
02:000421CB BF
02:000421CC 00
02:000421CD D2
                            	  4030: 
                            	  4031: ; Player coordinate must be < these bounds.
                            	  4032: ; Using these bounds; the player will be considered within the
                            	  4033: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4034: ; at the edge.
                            	  4035: ;
                            	  4036:     even
                            	  4037: DoorwayBoundsMaxUnder:
02:000421CE 5C              	  4038:     dc.b    $5C, $DE, $1F, $F1
02:000421CF DE
02:000421D0 1F
02:000421D1 F1
                            	  4039: 
                            	  4040: ; Params:
                            	  4041: ; [0F]: moving direction
                            	  4042: ;
                            	  4043: ; Returns:
                            	  4044: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4045: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4046: ;
                            	  4047: ; When not at or in a doorway, this function leaves
                            	  4048: ; [0F] moving direction as is.
                            	  4049: ;
                            	  4050: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4051: ; will be left as is, assuming that it had been reset before this
                            	  4052: ; routine by BoundByRoom.
                            	  4053: ;
                            	  4054: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4055: ;
                            	  4056: ;
                            	  4057: ; If already in a doorway, go handle it separately.
                            	  4058: ;
                            	  4059:     even
                            	  4060: CheckDoorway:
02:000421D2 102C0053        	  4061:     move.b  ($0053,A4),D0
02:000421D6 6648            	  4062:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4063:     even
                            	  4064: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4065:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4066:     ;
                            	  4067:     ; To match a doorway:
                            	  4068:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4069:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4070:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4071:     ;
                            	  4072:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4073:     ; a doorway to be part of it.
                            	  4074:     ;
02:000421D8 102C0098        	  4075:     move.b  ($0098,A4),D0
02:000421DC 61000122        	  4076:     jsr     GetPlayerCoordsForDirection
02:000421E0 7603            	  4077:     moveq   #3,D3
                            	  4078:     even
                            	  4079: _L_z05_CheckDoorway_LoopOverflowBounds:
02:000421E2 1014            	  4080:     move.b  ($0000,A4),D0
