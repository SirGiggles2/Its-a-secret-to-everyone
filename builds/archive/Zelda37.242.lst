                            	  5490: __far_z_07_0084:
                            	  5491:     ; State $2x. Spark.
                            	  5492:     ;
                            	  5493:     ; Change the state to $28, and decrement animation counter.
                            	  5494:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5495:     ; (with Link, if this is a monster's boomerang).
                            	  5496:     ;
                            	  5497:     ; TODO: Why state $28?
                            	  5498:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5499:     ; start over again when spinning.
                            	  5500:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5501:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5502:     ; any drawing code depends on the minor state.
                            	  5503:     ;
02:0004C494 7028            	  5504:     moveq   #40,D0
02:0004C496 41EC00AC        	  5505:     lea     ($00AC,A4),A0
02:0004C49A 11802000        	  5506:     move.b  D0,(A0,D2.W)
02:0004C49E 41EC03D0        	  5507:     lea     ($03D0,A4),A0
02:0004C4A2 53302000        	  5508:     subq.b  #1,(A0,D2.W)
02:0004C4A6 6702            	  5509:     beq.s  __far_z_07_0085
02:0004C4A8 6060            	  5510:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5511: __far_z_07_0085:
