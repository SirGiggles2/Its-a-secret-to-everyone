02:0003CC2C 601C            	  7020:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7021: __far_z_04_0060:
                            	  7022:     ; New bloated substate >= 2.
                            	  7023:     ;
                            	  7024:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7025:     ; which will transition to state 0 (moving).
                            	  7026:     ;
                            	  7027:     ; Note that if the bomb hits >= 2, then:
                            	  7028:     ; - If new substate = 2, then substate 2 will wait,
                            	  7029:     ;   and then transition to substate 3.
                            	  7030:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7031:     ;
02:0003CC2E 7600            	  7032:     moveq   #0,D3
02:0003CC30 41EC0437        	  7033:     lea     ($0437,A4),A0
02:0003CC34 16302000        	  7034:     move.b  (A0,D2.W),D3
02:0003CC38 0C030002        	  7035:     cmpi.b  #$02,D3
02:0003CC3C 6502            	  7036:     bcs.s  __far_z_04_0061
02:0003CC3E 600A            	  7037:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7038: __far_z_04_0061:
