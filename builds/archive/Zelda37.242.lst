02:00032196 532C066F        	  6645:     subq.b  #1,($066F,A4)
02:0003219A 103C00FF        	  6646:     move.b  #$FF,D0
02:0003219E 19400670        	  6647:     move.b  D0,($0670,A4)
02:000321A2 6600FF6E        	  6648:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6649:     even
