                            	   251: _anon_z04_2:
02:00039B40 1880            	   252:     move.b  D0,($0000,A4)
                            	   253:     ; If chase target is to the right of the object, then
                            	   254:     ; store left (2) in [01], else right (1).
                            	   255:     ;
                            	   256:     ; Also, make this the object's facing direction, even though
                            	   257:     ; it will be clobbered shortly.
                            	   258:     ;
02:00039B42 19430001        	   259:     move.b  D3,($0001,A4)
02:00039B46 41EC0098        	   260:     lea     ($0098,A4),A0
02:00039B4A 11832000        	   261:     move.b  D3,(A0,D2.W)
                            	   262:     ; Calculate vertical distance and direction toward the chase target.
                            	   263:     ; Make this vertical direction the facing direction.
                            	   264:     ;
02:00039B4E 7604            	   265:     moveq   #4,D3
02:00039B50 102C0062        	   266:     move.b  ($0062,A4),D0
02:00039B54 003C0011        	   267:     ori     #$11,CCR  ; SEC: set C+X
