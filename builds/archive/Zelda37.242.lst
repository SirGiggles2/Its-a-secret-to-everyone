02:0003E0BA 11802000        	  9812:     move.b  D0,(A0,D2.W)
02:0003E0BE 61001C62        	  9813:     jsr     ReverseObjDir8
02:0003E0C2 41EC045E        	  9814:     lea     ($045E,A4),A0
02:0003E0C6 10302000        	  9815:     move.b  (A0,D2.W),D0
02:0003E0CA 41EC045E        	  9816:     lea     ($045E,A4),A0
02:0003E0CE 52302000        	  9817:     addq.b  #1,(A0,D2.W)
                            	  9818:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9819:     ; should randomly change direction.
                            	  9820:     ;
02:0003E0D2 E208            	  9821:     lsr.b  #1,D0   ; LSR A
02:0003E0D4 640A            	  9822:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003E0D6 7000            	  9823:     moveq   #0,D0
02:0003E0D8 41EC0451        	  9824:     lea     ($0451,A4),A0
