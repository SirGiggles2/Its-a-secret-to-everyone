02:0002E868 41F90002E5E2    	   929:     lea     (CaveWareXs).l,A0
02:0002E86E 12302000        	   930:     move.b  (A0,D2.W),D1
02:0002E872 B001            	   931:     cmp.b   D1,D0
02:0002E874 6620            	   932:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   933:     ; If the vertical distance between Link and the item < 6, then
                            	   934:     ; go try to take it.
