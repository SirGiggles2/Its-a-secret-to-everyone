                            	  7220: Dodongo_TryEatBomb:
                            	  7221:     ; Try to eat the bomb.
                            	  7222:     ;
                            	  7223:     ; If the bomb is not in range of the monster, then return.
                            	  7224:     ;
                            	  7225:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7226:     ;
02:0003CD98 7601            	  7227:     moveq   #1,D3
02:0003CD9A 616E            	  7228:     jsr     Dodongo_IsBombInRange
02:0003CD9C 6666            	  7229:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7230:     ; Will loop from 1 to 0, indexed by [00].
                            	  7231:     ;
02:0003CD9E 7001            	  7232:     moveq   #1,D0
02:0003CDA0 1880            	  7233:     move.b  D0,($0000,A4)
                            	  7234:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7235:     ;
02:0003CDA2 41EC0098        	  7236:     lea     ($0098,A4),A0
02:0003CDA6 10302000        	  7237:     move.b  (A0,D2.W),D0
02:0003CDAA E208            	  7238:     lsr.b  #1,D0   ; LSR A
02:0003CDAC 7600            	  7239:     moveq   #0,D3
02:0003CDAE 1600            	  7240:     move.b  D0,D3
                            	  7241:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7242:     ; position depends on the orientation of the monster.
                            	  7243:     ;
                            	  7244:     ; Start with the horizontal distance.
                            	  7245:     ;
02:0003CDB0 102C0004        	  7246:     move.b  ($0004,A4),D0
                            	  7247:     even
                            	  7248: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7249:     ; Look up the limits for the given direction.
                            	  7250:     ;
                            	  7251:     ; If the distance from the bomb < negative limit,
                            	  7252:     ; or >= positive limit, then return.
                            	  7253:     ;
                            	  7254:     ; Note that these are simple signed comparisons that work,
                            	  7255:     ; because the operands are in a small range.
                            	  7256:     ;
02:0003CDB4 41F90003CCEE    	  7257:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CDBA 12303000        	  7258:     move.b  (A0,D3.W),D1
02:0003CDBE B001            	  7259:     cmp.b   D1,D0
02:0003CDC0 6B42            	  7260:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CDC2 41F90003CCF4    	  7261:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CDC8 12303000        	  7262:     move.b  (A0,D3.W),D1
02:0003CDCC B001            	  7263:     cmp.b   D1,D0
02:0003CDCE 6A34            	  7264:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7265:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7266:     ;
02:0003CDD0 1003            	  7267:     move.b  D3,D0
02:0003CDD2 023C00EE        	  7268:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDD6 123C000A        	  7269:     move.b  #$0A,D1
02:0003CDDA D101            	  7270:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CDDC 7600            	  7271:     moveq   #0,D3
02:0003CDDE 1600            	  7272:     move.b  D0,D3
                            	  7273:     ; Bottom of the loop.
                            	  7274:     ;
                            	  7275:     ; Load the vertical distance for the next iteration.
                            	  7276:     ; Decrement loop counter.
                            	  7277:     ;
02:0003CDE0 102C0005        	  7278:     move.b  ($0005,A4),D0
02:0003CDE4 5314            	  7279:     subq.b  #1,($0000,A4)
02:0003CDE6 6ACC            	  7280:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7281:     ; If we get here, then the bomb was within range of the mouth.
                            	  7282:     ; Go to state 1 (bloated).
                            	  7283:     ;
02:0003CDE8 41EC00AC        	  7284:     lea     ($00AC,A4),A0
02:0003CDEC 52302000        	  7285:     addq.b  #1,(A0,D2.W)
                            	  7286:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7287:     ;
02:0003CDF0 7610            	  7288:     moveq   #16,D3
02:0003CDF2 7000            	  7289:     moveq   #0,D0
02:0003CDF4 41EC00AC        	  7290:     lea     ($00AC,A4),A0
02:0003CDF8 11803000        	  7291:     move.b  D0,(A0,D3.W)
02:0003CDFC 41EC042C        	  7292:     lea     ($042C,A4),A0
02:0003CE00 11802000        	  7293:     move.b  D0,(A0,D2.W)
                            	  7294:     even
                            	  7295: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CE04 4E75            	  7296:     rts
