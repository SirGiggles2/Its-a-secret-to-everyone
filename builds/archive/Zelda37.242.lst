02:0003EE3C 1B00            	 11586:     move.b  D0,-(A5)  ; PHA
02:0003EE3E 4EB900031E34    	 11587:     jsr     CheckMonsterCollisions
02:0003EE44 101D            	 11588:     move.b  (A5)+,D0  ; PLA
02:0003EE46 41EC0098        	 11589:     lea     ($0098,A4),A0
02:0003EE4A 11802000        	 11590:     move.b  D0,(A0,D2.W)
                            	 11591:     ; If still alive, then return.
                            	 11592:     ;
