                            	 12441: __far_z_04_0120:
                            	 12442:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12443:     ; Collisions were checked already.
                            	 12444:     ;
                            	 12445:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12446:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12447:     ;
02:0003F420 0C000001        	 12448:     cmpi.b  #$01,D0
