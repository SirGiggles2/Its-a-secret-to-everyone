02:0003AD8E 9101            	  2840:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AD90 0A3C0010        	  2841:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AD94 4EB900030F66    	  2842:     jsr     Abs
