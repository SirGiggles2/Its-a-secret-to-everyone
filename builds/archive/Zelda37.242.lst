                            	  2227:     ; If Link is not halted or teleporting state = 0, then
                            	  2228:     ; go check for collision with Link.
                            	  2229:     ;
02:000301DA 0C030040        	  2230:     cmpi.b  #$40,D3
02:000301DE 6638            	  2231:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:000301E0 7600            	  2232:     moveq   #0,D3
02:000301E2 162C0522        	  2233:     move.b  ($0522,A4),D3
02:000301E6 6730            	  2234:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2235:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2236:     ;
                            	  2237:     ; Set Link's X to whirlwind's.
                            	  2238:     ;
02:000301E8 19400070        	  2239:     move.b  D0,($0070,A4)
                            	  2240:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2241:     ; the right screen edge and draw.
                            	  2242:     ;
02:000301EC 5303            	  2243:     subq.b  #1,D3
02:000301EE 6776            	  2244:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000301F0 0C000080        	  2245:     cmpi.b  #$80,D0
02:000301F4 6670            	  2246:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
