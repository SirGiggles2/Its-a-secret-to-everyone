02:0003B0F6 19802070        	  3283:     move.b  D0,($70,A4,D2.W)
                            	  3284:     ; If facing down, then use Y offset $28.
                            	  3285:     ; Else store Y offset -$28 in [00].
                            	  3286:     ;
02:0003B0FA 7628            	  3287:     moveq   #40,D3
02:0003B0FC 41EC0098        	  3288:     lea     ($0098,A4),A0
02:0003B100 10302000        	  3289:     move.b  (A0,D2.W),D0
02:0003B104 02000008        	  3290:     andi.b #$08,D0
02:0003B108 6704            	  3291:     beq  _anon_z04_44
02:0003B10A 163C00D8        	  3292:     move.b  #$D8,D3
                            	  3293: _anon_z04_44:
02:0003B10E 1883            	  3294:     move.b  D3,($0000,A4)
                            	  3295:     ; Add Link's Y and the vertical offset.
                            	  3296:     ;
02:0003B110 102C0084        	  3297:     move.b  ($0084,A4),D0
