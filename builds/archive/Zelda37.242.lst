02:00036D06 182C0001        	  5268:     move.b  ($01,A4),D4  ; ptr hi
02:00036D0A 024100FF        	  5269:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036D0E E14C            	  5270:     lsl.w   #8,D4
02:00036D10 8841            	  5271:     or.w    D1,D4             ; D4 = NES ptr addr
