02:00044DBA 102C03F8        	  8048:     move.b  ($03F8,A4),D0
02:00044DBE 41F900030B2A    	  8049:     lea     (ReverseDirections).l,A0
02:00044DC4 12303000        	  8050:     move.b  (A0,D3.W),D1
02:00044DC8 C001            	  8051:     and.b  D1,D0
02:00044DCA 672A            	  8052:     beq  _L_z05_Link_ModifyDirAtGridPoint_NextLoopDir
02:00044DCC 1940000F        	  8053:     move.b  D0,($000F,A4)
02:00044DD0 1003            	  8054:     move.b  D3,D0
02:00044DD2 1B00            	  8055:     move.b  D0,-(A5)  ; PHA
02:00044DD4 522C000B        	  8056:     addq.b  #1,($000B,A4)
02:00044DD8 610069C2        	  8057:     jsr     GetCollidingTileMoving
