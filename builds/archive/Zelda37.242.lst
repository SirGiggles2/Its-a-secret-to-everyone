02:0003CA7A 19400001        	  6796:     move.b  D0,($0001,A4)
                            	  6797:     ; Calculate sprite attributes:
                            	  6798:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6799:     ;
                            	  6800:     ; If the boss is temporarily invincible, then
                            	  6801:     ; this makes it flash by cycling all the palette rows.
                            	  6802:     ;
                            	  6803:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6804:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6805:     ;
02:0003CA7E 41EC04F0        	  6806:     lea     ($04F0,A4),A0
02:0003CA82 10302000        	  6807:     move.b  (A0,D2.W),D0
02:0003CA86 02000003        	  6808:     andi.b #$03,D0
02:0003CA8A 0A000003        	  6809:     eori.b #$03,D0
02:0003CA8E 19400003        	  6810:     move.b  D0,($0003,A4)
02:0003CA92 7600            	  6811:     moveq   #0,D3
02:0003CA94 162C000A        	  6812:     move.b  ($000A,A4),D3
                            	  6813:     ; Look up the tile for this sprite.
                            	  6814:     ; If it's not the first one (face), then go write the sprite record.
                            	  6815:     ;
02:0003CA98 41F90003CA16    	  6816:     lea     (AquamentusTiles).l,A0
02:0003CA9E 10303000        	  6817:     move.b  (A0,D3.W),D0
02:0003CAA2 12390003CA16    	  6818:     move.b  (AquamentusTiles).l,D1
02:0003CAA8 B001            	  6819:     cmp.b   D1,D0
02:0003CAAA 6610            	  6820:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6821:     ; Else it's the first one (the face tile).
                            	  6822:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6823:     ;
                            	  6824:     ; $CC/CD shows the closed mouth face.
                            	  6825:     ; $C0/C1 shows the open mouth face.
                            	  6826:     ;
02:0003CAAC 7600            	  6827:     moveq   #0,D3
02:0003CAAE 16342028        	  6828:     move.b  ($28,A4,D2.W),D3
