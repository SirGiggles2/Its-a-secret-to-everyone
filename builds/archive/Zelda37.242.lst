                            	  4107: _L_z05_CheckDoorway_InDoorway:
                            	  4108:     ; In a doorway. DoorwayDir is in A.
                            	  4109:     ;
02:00042220 1B00            	  4110:     move.b  D0,-(A5)  ; PHA
02:00042222 610000DC        	  4111:     jsr     GetPlayerCoordsForDirection
02:00042226 101D            	  4112:     move.b  (A5)+,D0  ; PLA
02:00042228 4EB900030F62    	  4113:     jsr     GetOppositeDir
