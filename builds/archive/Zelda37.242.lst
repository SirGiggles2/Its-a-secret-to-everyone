02:0003204C 6702            	  6472:     beq.s  __far_z_01_0064
02:0003204E 605C            	  6473:     jmp  HarmLink
                            	  6474: __far_z_01_0064:
                            	  6475:     ; If Link and the shot are not facing opposite directions,
                            	  6476:     ; then go harm Link.
                            	  6477:     ;
                            	  6478:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6479:     ; component of a monster that can move diagonally.
                            	  6480:     ;
02:00032050 102C0098        	  6481:     move.b  ($0098,A4),D0
02:00032054 41EC0098        	  6482:     lea     ($0098,A4),A0
02:00032058 12302000        	  6483:     move.b  (A0,D2.W),D1
02:0003205C 8001            	  6484:     or.b  D1,D0
02:0003205E 0200000C        	  6485:     andi.b #$0C,D0
02:00032062 0C00000C        	  6486:     cmpi.b  #$0C,D0
02:00032066 671A            	  6487:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00032068 102C0098        	  6488:     move.b  ($0098,A4),D0
02:0003206C 41EC0098        	  6489:     lea     ($0098,A4),A0
02:00032070 12302000        	  6490:     move.b  (A0,D2.W),D1
02:00032074 8001            	  6491:     or.b  D1,D0
02:00032076 02000003        	  6492:     andi.b #$03,D0
02:0003207A 0C000003        	  6493:     cmpi.b  #$03,D0
02:0003207E 6702            	  6494:     beq.s  __far_z_01_0065
02:00032080 602A            	  6495:     jmp  HarmLink
                            	  6496: __far_z_01_0065:
