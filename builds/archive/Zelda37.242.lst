                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:000402E8 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:000402EC 02000010        	   426:     andi.b #$10,D0
02:000402F0 6606            	   427:     bne.s  __far_z_05_0000
02:000402F2 4EF90002D664    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:000402F8 102C0254        	   430:     move.b  ($0254,A4),D0
02:000402FC 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:000402FE 102C0258        	   432:     move.b  ($0258,A4),D0
02:00040302 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:00040304 4EB90004AA30    	   434:     jsr     HideAllSprites
02:0004030A 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0004030C 19400258        	   436:     move.b  D0,($0258,A4)
02:00040310 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:00040312 19400254        	   438:     move.b  D0,($0254,A4)
02:00040316 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0004031A 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004031E 4E75            	   441:     rts
                            	   442: 
