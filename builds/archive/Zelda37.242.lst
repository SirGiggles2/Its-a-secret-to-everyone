02:00031272 662E            	  4754:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4755:     ; The effect involves turning grayscale rendering on and off
                            	  4756:     ; in PPUMASK.
                            	  4757:     ;
                            	  4758:     ; Start by setting A register to the PPU mask shifted right to
                            	  4759:     ; throw away the grayscale bit.
                            	  4760:     ;
02:00031274 102C00FE        	  4761:     move.b  ($00FE,A4),D0
02:00031278 E208            	  4762:     lsr.b  #1,D0   ; LSR A
                            	  4763:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4764:     ;
02:0003127A 7600            	  4765:     moveq   #0,D3
02:0003127C 16342028        	  4766:     move.b  ($28,A4,D2.W),D3
                            	  4767:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4768:     ; Carry will have been set, because of the comparison (CPY).
                            	  4769:     ;
02:00031280 0C030016        	  4770:     cmpi.b  #$16,D3
02:00031284 6706            	  4771:     beq  _anon_z01_54
02:00031286 0C030011        	  4772:     cmpi.b  #$11,D3
02:0003128A 6604            	  4773:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  4774: _anon_z01_54:
02:0003128C E310            	  4775:     roxl.b  #1,D0   ; ROL A
