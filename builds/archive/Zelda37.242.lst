                            	  7340:     ;
02:000325AE 102C0098        	  7341:     move.b  ($0098,A4),D0
02:000325B2 0200000C        	  7342:     andi.b #$0C,D0
02:000325B6 6726            	  7343:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:000325B8 10343070        	  7344:     move.b  ($70,A4,D3.W),D0
02:000325BC 023C00EE        	  7345:     andi    #$EE,CCR  ; CLC: clear C+X
02:000325C0 123C0006        	  7346:     move.b  #$06,D1
02:000325C4 D101            	  7347:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:000325C6 19400004        	  7348:     move.b  D0,($0004,A4)
02:000325CA 41EC0084        	  7349:     lea     ($0084,A4),A0
02:000325CE 10303000        	  7350:     move.b  (A0,D3.W),D0
02:000325D2 023C00EE        	  7351:     andi    #$EE,CCR  ; CLC: clear C+X
02:000325D6 123C0008        	  7352:     move.b  #$08,D1
02:000325DA D101            	  7353:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000325DC 6024            	  7354:     jmp     _anon_z01_98
                            	  7355: 
