                            	  1883: UpdateStatues:
                            	  1884:     ; If person fireballs are enabled (from the two fires), then
                            	  1885:     ; go make fireballs with pattern 2.
                            	  1886:     ;
02:0003A756 7602            	  1887:     moveq   #2,D3
02:0003A758 102C04CC        	  1888:     move.b  ($04CC,A4),D0
02:0003A75C 6620            	  1889:     bne  _L_z04_UpdateStatues_Shoot
                            	  1890:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1891:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1892:     ; - layout $23: pattern 1: 2 statues
                            	  1893:     ; - layout $24: pattern 0: 4 statues
                            	  1894:     ;
02:0003A75E 4EB90004AE9E    	  1895:     jsr     GetUniqueRoomId
02:0003A764 7601            	  1896:     moveq   #1,D3
                            	  1897: _anon_z04_30:
02:0003A766 41F90003A738    	  1898:     lea     (StatueRoomLayouts).l,A0
02:0003A76C 12303000        	  1899:     move.b  (A0,D3.W),D1
02:0003A770 B001            	  1900:     cmp.b   D1,D0
02:0003A772 670A            	  1901:     beq  _L_z04_UpdateStatues_Shoot
02:0003A774 5303            	  1902:     subq.b  #1,D3
02:0003A776 6AEE            	  1903:     bpl  _anon_z04_30
02:0003A778 0A3C0001        	  1904:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A77C 4E75            	  1905:     rts
