                            	  9933: GohmaLegOffsetsX:
02:0003E19E F0              	  9934:     dc.b    $F0, $10
02:0003E19F 10
                            	  9935: 
                            	  9936: ; Params:
                            	  9937: ; A: eye frame image
                            	  9938: ;
                            	  9939: ; Draw the eye with the frame image passed in.
                            	  9940: ;
                            	  9941:     even
                            	  9942: Gohma_AnimateAndDraw:
02:0003E1A0 1B00            	  9943:     move.b  D0,-(A5)  ; PHA
02:0003E1A2 4EB90004CE68    	  9944:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003E1A8 6164            	  9945:     jsr     Gohma_SetSpriteAttributes
02:0003E1AA 101D            	  9946:     move.b  (A5)+,D0  ; PLA
02:0003E1AC 4EB900031AB4    	  9947:     jsr     DrawObjectMirrored
02:0003E1B2 7010            	  9948:     moveq   #16,D0
02:0003E1B4 4EB90004CE62    	  9949:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  9950:     ; Draw the right legs.
                            	  9951:     ;
02:0003E1BA 7601            	  9952:     moveq   #1,D3
02:0003E1BC 6102            	  9953:     jsr     Gohma_DrawLegsOneSide
                            	  9954:     ; Draw the left legs.
                            	  9955:     ;
02:0003E1BE 7600            	  9956:     moveq   #0,D3
                            	  9957: ; Params:
                            	  9958: ; Y: side: 0 for left, 1 for right
                            	  9959: ;
                            	  9960: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9961: ; store the sprite's X in [00].
                            	  9962: ;
                            	  9963:     even
                            	  9964: Gohma_DrawLegsOneSide:
02:0003E1C0 10342070        	  9965:     move.b  ($70,A4,D2.W),D0
02:0003E1C4 023C00EE        	  9966:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E1C8 41F90003E19E    	  9967:     lea     (GohmaLegOffsetsX).l,A0
02:0003E1CE 12303000        	  9968:     move.b  (A0,D3.W),D1
02:0003E1D2 D101            	  9969:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E1D4 1880            	  9970:     move.b  D0,($0000,A4)
                            	  9971:     ; The object's Y is the sprite's.
                            	  9972:     ;
02:0003E1D6 41EC0084        	  9973:     lea     ($0084,A4),A0
02:0003E1DA 10302000        	  9974:     move.b  (A0,D2.W),D0
02:0003E1DE 19400001        	  9975:     move.b  D0,($0001,A4)
02:0003E1E2 612A            	  9976:     jsr     Gohma_SetSpriteAttributes
                            	  9977:     ; There are only two frame images for legs: left and right.
                            	  9978:     ; There are two animation frames. They are animated as follows:
                            	  9979:     ;
                            	  9980:     ; Frame 0:
                            	  9981:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9982:     ; horizontal flipping = frame number = 0
                            	  9983:     ; 
                            	  9984:     ; Frame 1:
                            	  9985:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9986:     ; horizontal flipping = frame number = 1
                            	  9987:     ;
02:0003E1E4 4EB90004CE3A    	  9988:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E1EA 1003            	  9989:     move.b  D3,D0
02:0003E1EC 023C00EE        	  9990:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E1F0 41EC03E4        	  9991:     lea     ($03E4,A4),A0
02:0003E1F4 12302000        	  9992:     move.b  (A0,D2.W),D1
02:0003E1F8 D101            	  9993:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E1FA 02000001        	  9994:     andi.b #$01,D0
02:0003E1FE 023C00EE        	  9995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E202 123C0004        	  9996:     move.b  #$04,D1
02:0003E206 D101            	  9997:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E208 4EF900031AB8    	  9998:     jmp     DrawObjectNotMirrored
                            	  9999: 
                            	 10000: ; Returns:
                            	 10001: ; [04]: left side sprite attributes
                            	 10002: ; [05]: right side sprite attributes
                            	 10003: ;
                            	 10004:     even
                            	 10005: Gohma_SetSpriteAttributes:
02:0003E20E 4EF90002BF4C    	 10006:     jmp     c_gohma_set_sprite_attributes
