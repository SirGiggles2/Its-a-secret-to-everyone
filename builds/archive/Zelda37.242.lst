02:0002ED4C 020000F0        	  1639:     andi.b #$F0,D0
02:0002ED50 003C0011        	  1640:     ori     #$11,CCR  ; SEC: set C+X
02:0002ED54 123C0010        	  1641:     move.b  #$10,D1
02:0002ED58 0A3C0010        	  1642:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002ED5C 9101            	  1643:     subx.b  D1,D0   ; SBC #$10
02:0002ED5E 0A3C0010        	  1644:     eori    #$10,CCR  ; restore X = 6502 C
02:0002ED62 1880            	  1645:     move.b  D0,($0000,A4)
                            	  1646:     ; Get (HeartValues - 1 heart)
                            	  1647:     ;
02:0002ED64 101D            	  1648:     move.b  (A5)+,D0  ; PLA
02:0002ED66 0200000F        	  1649:     andi.b #$0F,D0
02:0002ED6A 003C0011        	  1650:     ori     #$11,CCR  ; SEC: set C+X
02:0002ED6E 123C0001        	  1651:     move.b  #$01,D1
02:0002ED72 0A3C0010        	  1652:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
