                            	  6365: Digdogger_Move:
                            	  6366:     ; This calculation is the same one used in Manhandla to
                            	  6367:     ; manifest the fractional speed over several frames.
                            	  6368:     ;
                            	  6369:     ; To summarize, the formula is:
                            	  6370:     ;
                            	  6371:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6372:     ;
                            	  6373:     ;   SA := SA + (SL AND $E0)
                            	  6374:     ;   [03] := SH + carry
                            	  6375:     ;
                            	  6376:     ; See 04:A28E Manhandla_Move.
                            	  6377:     ;
02:0003C72C 41EC041F        	  6378:     lea     ($041F,A4),A0
02:0003C730 10302000        	  6379:     move.b  (A0,D2.W),D0
02:0003C734 020000E0        	  6380:     andi.b #$E0,D0
02:0003C738 023C00EE        	  6381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C73C 41EC0412        	  6382:     lea     ($0412,A4),A0
02:0003C740 12302000        	  6383:     move.b  (A0,D2.W),D1
02:0003C744 D101            	  6384:     addx.b  D1,D0   ; ADC $0412,X
02:0003C746 41EC0412        	  6385:     lea     ($0412,A4),A0
02:0003C74A 11802000        	  6386:     move.b  D0,(A0,D2.W)
                            	  6387:     ; Assign (high speed byte + carry) to [03].
                            	  6388:     ;
02:0003C74E 41EC042C        	  6389:     lea     ($042C,A4),A0
02:0003C752 10302000        	  6390:     move.b  (A0,D2.W),D0
02:0003C756 123C0000        	  6391:     move.b  #$00,D1
02:0003C75A D101            	  6392:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C75C 19400003        	  6393:     move.b  D0,($0003,A4)
                            	  6394:     ; Change coordinates by the speed amount/offset in [03]
                            	  6395:     ; according to the direction.
                            	  6396:     ;
                            	  6397:     ; Start with a mask of $A1 in [02]:
                            	  6398:     ; - low nibble represents the right direction
                            	  6399:     ; - high nibble is used to set or clear carry as we go along
                            	  6400:     ;
02:0003C760 103C00A1        	  6401:     move.b  #$A1,D0
02:0003C764 19400002        	  6402:     move.b  D0,($0002,A4)
                            	  6403:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6404:     ;
02:0003C768 41EC0098        	  6405:     lea     ($0098,A4),A0
02:0003C76C 10302000        	  6406:     move.b  (A0,D2.W),D0
02:0003C770 122C0002        	  6407:     move.b  ($0002,A4),D1
02:0003C774 C200            	  6408:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C776 6712            	  6409:     beq  _L_z04_Digdogger_Move_Left
02:0003C778 10342070        	  6410:     move.b  ($70,A4,D2.W),D0
02:0003C77C 023C00EE        	  6411:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C780 122C0003        	  6412:     move.b  ($0003,A4),D1
02:0003C784 D101            	  6413:     addx.b  D1,D0   ; ADC $03
02:0003C786 19802070        	  6414:     move.b  D0,($70,A4,D2.W)
                            	  6415:     even
                            	  6416: _L_z04_Digdogger_Move_Left:
                            	  6417:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6418:     ;
02:0003C78A 41EC0098        	  6419:     lea     ($0098,A4),A0
02:0003C78E 10302000        	  6420:     move.b  (A0,D2.W),D0
02:0003C792 122C0002        	  6421:     move.b  ($0002,A4),D1
02:0003C796 E309            	  6422:     lsl.b  #1,D1   ; ASL $02
02:0003C798 19410002        	  6423:     move.b  D1,($0002,A4)
02:0003C79C 122C0002        	  6424:     move.b  ($0002,A4),D1
02:0003C7A0 C200            	  6425:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C7A2 6716            	  6426:     beq  _L_z04_Digdogger_Move_Down
02:0003C7A4 10342070        	  6427:     move.b  ($70,A4,D2.W),D0
02:0003C7A8 122C0003        	  6428:     move.b  ($0003,A4),D1
02:0003C7AC 0A3C0010        	  6429:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C7B0 9101            	  6430:     subx.b  D1,D0   ; SBC $03
02:0003C7B2 0A3C0010        	  6431:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C7B6 19802070        	  6432:     move.b  D0,($70,A4,D2.W)
                            	  6433:     even
                            	  6434: _L_z04_Digdogger_Move_Down:
                            	  6435:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6436:     ;
02:0003C7BA 41EC0098        	  6437:     lea     ($0098,A4),A0
02:0003C7BE 10302000        	  6438:     move.b  (A0,D2.W),D0
02:0003C7C2 122C0002        	  6439:     move.b  ($0002,A4),D1
02:0003C7C6 E309            	  6440:     lsl.b  #1,D1   ; ASL $02
02:0003C7C8 19410002        	  6441:     move.b  D1,($0002,A4)
02:0003C7CC 122C0002        	  6442:     move.b  ($0002,A4),D1
02:0003C7D0 C200            	  6443:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C7D2 6716            	  6444:     beq  _L_z04_Digdogger_Move_Up
02:0003C7D4 41EC0084        	  6445:     lea     ($0084,A4),A0
02:0003C7D8 10302000        	  6446:     move.b  (A0,D2.W),D0
02:0003C7DC 122C0003        	  6447:     move.b  ($0003,A4),D1
02:0003C7E0 D101            	  6448:     addx.b  D1,D0   ; ADC $03
02:0003C7E2 41EC0084        	  6449:     lea     ($0084,A4),A0
02:0003C7E6 11802000        	  6450:     move.b  D0,(A0,D2.W)
                            	  6451:     even
                            	  6452: _L_z04_Digdogger_Move_Up:
                            	  6453:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6454:     ;
02:0003C7EA 41EC0098        	  6455:     lea     ($0098,A4),A0
02:0003C7EE 10302000        	  6456:     move.b  (A0,D2.W),D0
02:0003C7F2 122C0002        	  6457:     move.b  ($0002,A4),D1
02:0003C7F6 E309            	  6458:     lsl.b  #1,D1   ; ASL $02
02:0003C7F8 19410002        	  6459:     move.b  D1,($0002,A4)
02:0003C7FC 122C0002        	  6460:     move.b  ($0002,A4),D1
02:0003C800 C200            	  6461:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
