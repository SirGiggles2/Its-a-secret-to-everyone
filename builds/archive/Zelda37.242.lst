                            	  4104: PlayerScreenEdgeBounds:
02:0004BBA2 3D              	  4105:     dc.b    $3D, $DD, $00, $F0
02:0004BBA3 DD
02:0004BBA4 00
02:0004BBA5 F0
                            	  4106: 
                            	  4107: ; Params:
                            	  4108: ; [0E]: $FF, if blocked by a door
                            	  4109: ; [0F]: movement direction
                            	  4110: ;
                            	  4111: ; Returns:
                            	  4112: ; [0F]: untouched, or changed if blocked or need to change
                            	  4113: ;
                            	  4114: ; Summary:
                            	  4115: ;
                            	  4116: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4117: ; Then allow movement or go to the next room. Otherwise,
                            	  4118: ; check passive tile objects and stop moving.
                            	  4119: ;
                            	  4120: ; For other objects: First, if moving, test the colliding tile for
                            	  4121: ; walkability. Otherwise search for a walkable direction starting
                            	  4122: ; from input direction.
                            	  4123: ;
                            	  4124: ; When you find a walkable direction, see if it makes the object
                            	  4125: ; cross a boundary. If it doesn't, then make this direction
                            	  4126: ; the objection direction. Otherwise, keep looping.
                            	  4127: ;
                            	  4128: ; If no walkable direction is found, then stop moving.
                            	  4129: ;
                            	  4130: ;
                            	  4131: ; if is player
                            	  4132: ;   if at doorway
                            	  4133: ;     go handle a walkable direction
                            	  4134: ;   if blocked by door
                            	  4135: ;     return
                            	  4136: ;
                            	  4137:     even
                            	  4138: Walker_CheckTileCollision:
                            	  4139:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4140:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4141:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4142:     ; reset) for Link and every other object. Only the tile
                            	  4143:     ; walkability decision in CheckTiles is overridden.
02:0004BBA6 4A02            	  4144:     cmpi.b  #$00,D2
02:0004BBA8 6614            	  4145:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004BBAA 102C0053        	  4146:     move.b  ($0053,A4),D0
02:0004BBAE 6704            	  4147:     beq  _anon_z07_16
02:0004BBB0 600000BE        	  4148:     jmp     GoWalkableDir
                            	  4149: 
                            	  4150: _anon_z07_16:
02:0004BBB4 102C000E        	  4151:     move.b  ($000E,A4),D0
02:0004BBB8 6A04            	  4152:     bpl.s  __far_z_07_0048
02:0004BBBA 600000AC        	  4153:     jmp  L1F148_Exit
                            	  4154: __far_z_07_0048:
                            	  4155:     even
                            	  4156: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4157:     ; If grid offset <> 0, return.
                            	  4158:     ;
02:0004BBBE 41EC0394        	  4159:     lea     ($0394,A4),A0
02:0004BBC2 10302000        	  4160:     move.b  (A0,D2.W),D0
02:0004BBC6 6704            	  4161:     beq.s  __far_z_07_0049
02:0004BBC8 6000009E        	  4162:     jmp  L1F148_Exit
                            	  4163: __far_z_07_0049:
                            	  4164:     ; Grid offset = 0.
                            	  4165:     ; The object is at a point between cells in the grid.
                            	  4166:     ; So, we can check tiles for collision.
                            	  4167:     ;
                            	  4168:     ; Reset [0E] alternate direction search step.
                            	  4169:     ;
02:0004BBCC 1940000E        	  4170:     move.b  D0,($000E,A4)
                            	  4171:     ; If there's a movement direction, go check tile collision.
                            	  4172:     ;
02:0004BBD0 102C000F        	  4173:     move.b  ($000F,A4),D0
02:0004BBD4 6702            	  4174:     beq.s  __far_z_07_0050
02:0004BBD6 602E            	  4175:     jmp  CheckTiles
                            	  4176: __far_z_07_0050:
                            	  4177:     ; Moving direction = 0.
                            	  4178:     ; If object is the player, return.
                            	  4179:     ;
02:0004BBD8 4A02            	  4180:     cmpi.b  #$00,D2
02:0004BBDA 6604            	  4181:     bne.s  __far_z_07_0051
02:0004BBDC 6000008A        	  4182:     jmp  L1F148_Exit
                            	  4183: __far_z_07_0051:
                            	  4184:     ; Moving direction = 0.
                            	  4185:     ; The object is not the player.
                            	  4186:     ;
                            	  4187:     ; If object does not have attribute $10, then
                            	  4188:     ; set movement direction to input direction,
                            	  4189:     ; and go try to turn to an unblocked direction in order to move.
                            	  4190:     ;
02:0004BBE0 41EC04BF        	  4191:     lea     ($04BF,A4),A0
02:0004BBE4 10302000        	  4192:     move.b  (A0,D2.W),D0
02:0004BBE8 02000010        	  4193:     andi.b #$10,D0
02:0004BBEC 6702            	  4194:     beq.s  __far_z_07_0052
02:0004BBEE 600E            	  4195:     jmp  Reverse
                            	  4196: __far_z_07_0052:
02:0004BBF0 41EC03F8        	  4197:     lea     ($03F8,A4),A0
