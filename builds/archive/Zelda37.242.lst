02:0003B360 023C00EE        	  3613:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B364 41EC03E4        	  3614:     lea     ($03E4,A4),A0
02:0003B368 12302000        	  3615:     move.b  (A0,D2.W),D1
02:0003B36C D101            	  3616:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B36E 1B00            	  3617:     move.b  D0,-(A5)  ; PHA
                            	  3618:     ; If facing vertically, go draw mirrored.
                            	  3619:     ;
02:0003B370 41EC0098        	  3620:     lea     ($0098,A4),A0
02:0003B374 10302000        	  3621:     move.b  (A0,D2.W),D0
02:0003B378 0200000C        	  3622:     andi.b #$0C,D0
02:0003B37C 660E            	  3623:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3624:     ; Else draw not mirrored.
                            	  3625:     ;
02:0003B37E 101D            	  3626:     move.b  (A5)+,D0  ; PLA
02:0003B380 4EB900031AB8    	  3627:     jsr     DrawObjectNotMirrored
02:0003B386 4EF900031E34    	  3628:     jmp     CheckMonsterCollisions
                            	  3629: 
