                            	  4544:     even
                            	  4545: UpdateZeldaTextbox:
02:000365B8 4EB90004BD98    	  4546:     jsr     Link_EndMoveAndDraw
                            	  4547:     ; If Zelda's timer has not expired, then return.
                            	  4548:     ;
02:000365BE 102C0029        	  4549:     move.b  ($0029,A4),D0
02:000365C2 6704            	  4550:     beq.s  __far_z_02_0009
02:000365C4 600000C6        	  4551:     jmp  LA9F4_Exit
                            	  4552: __far_z_02_0009:
                            	  4553:     ; Set the timer to wait 6 frames after the next character about
                            	  4554:     ; to be shown.
                            	  4555:     ;
02:000365C8 7006            	  4556:     moveq   #6,D0
02:000365CA 19400029        	  4557:     move.b  D0,($0029,A4)
                            	  4558:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4559:     ; to the dynamic transfer buf.
                            	  4560:     ;
02:000365CE 7604            	  4561:     moveq   #4,D3
                            	  4562: _anon_z02_31:
02:000365D0 41F9000365AE    	  4563:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000365D6 10303000        	  4564:     move.b  (A0,D3.W),D0
02:000365DA 41EC0302        	  4565:     lea     ($0302,A4),A0
02:000365DE 11803000        	  4566:     move.b  D0,(A0,D3.W)
02:000365E2 5303            	  4567:     subq.b  #1,D3
02:000365E4 6AEA            	  4568:     bpl  _anon_z02_31
                            	  4569: _anon_z02_32:
                            	  4570:     ; Replace the low byte of the VRAM address with the one
                            	  4571:     ; where the next character should be written.
                            	  4572:     ;
02:000365E6 102C045F        	  4573:     move.b  ($045F,A4),D0
02:000365EA 19400303        	  4574:     move.b  D0,($0303,A4)
                            	  4575:     ; Increment the low VRAM address for the next character.
                            	  4576:     ;
02:000365EE 522C045F        	  4577:     addq.b  #1,($045F,A4)
02:000365F2 7000            	  4578:     moveq   #0,D0
02:000365F4 1880            	  4579:     move.b  D0,($0000,A4)
02:000365F6 7000            	  4580:     moveq   #0,D0
02:000365F8 19400001        	  4581:     move.b  D0,($0001,A4)
                            	  4582:     ; Load the person text current character index.
                            	  4583:     ;
02:000365FC 7600            	  4584:     moveq   #0,D3
02:000365FE 162C0416        	  4585:     move.b  ($0416,A4),D3
                            	  4586:     ; Increment the index variable to point to the next character
                            	  4587:     ; for the next time.
                            	  4588:     ;
02:00036602 522C0416        	  4589:     addq.b  #1,($0416,A4)
                            	  4590:     ; Get the current character.
                            	  4591:     ;
02:00036606 1214            	  4592:     move.b  ($00,A4),D1   ; ptr lo
02:00036608 182C0001        	  4593:     move.b  ($01,A4),D4  ; ptr hi
02:0003660C 024100FF        	  4594:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036610 E14C            	  4595:     lsl.w   #8,D4
02:00036612 8841            	  4596:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036614 48C4            	  4597:     ext.l   D4
02:00036616 D8BC00FF0000    	  4598:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003661C 2044            	  4599:     movea.l D4,A0
02:0003661E 10303000        	  4600:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4601:     ; If the character is $25, then it's a special space. It will still
                            	  4602:     ; take up space, but will not take time to show -- meaning that
                            	  4603:     ; we'll go look up the next character to transfer.
                            	  4604:     ;
02:00036622 0200003F        	  4605:     andi.b #$3F,D0
02:00036626 0C000025        	  4606:     cmpi.b  #$25,D0
02:0003662A 67BA            	  4607:     beq  _anon_z02_32
                            	  4608:     ; We have a non-space character. Put it in the transfer record.
                            	  4609:     ;
02:0003662C 19400305        	  4610:     move.b  D0,($0305,A4)
                            	  4611:     ; Play the "heart taken/character" tune.
                            	  4612:     ;
02:00036630 7010            	  4613:     moveq   #16,D0
02:00036632 19400604        	  4614:     move.b  D0,($0604,A4)
                            	  4615:     ; If the high 2 bits of character element = 0, then return.
                            	  4616:     ;
02:00036636 1214            	  4617:     move.b  ($00,A4),D1   ; ptr lo
02:00036638 182C0001        	  4618:     move.b  ($01,A4),D4  ; ptr hi
02:0003663C 024100FF        	  4619:     andi.w  #$00FF,D1         ; zero-extend lo byte
