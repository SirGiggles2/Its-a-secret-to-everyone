                            	  3870:     ;
02:0003B4DE 7020            	  3871:     moveq   #32,D0
02:0003B4E0 7600            	  3872:     moveq   #0,D3
02:0003B4E2 16342019        	  3873:     move.b  ($19,A4,D2.W),D3
02:0003B4E6 0C030080        	  3874:     cmpi.b  #$80,D3
