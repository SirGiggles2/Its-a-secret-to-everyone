                            	  6669: 
                            	  6670: ; Params:
                            	  6671: ; X: monster slot
                            	  6672: ; Y: weapon slot
                            	  6673: ; [02]: monster mid X
                            	  6674: ; [03]: monster mid Y
                            	  6675: ;
                            	  6676: ; Returns:
                            	  6677: ; [00]: weapon slot
