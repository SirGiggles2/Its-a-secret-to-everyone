                            	  3851: _anon_z05_90:
02:0004202A 41EC0621        	  3852:     lea     ($0621,A4),A0
02:0004202E 12303000        	  3853:     move.b  (A0,D3.W),D1
02:00042032 B001            	  3854:     cmp.b   D1,D0
