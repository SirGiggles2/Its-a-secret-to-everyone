                            	 11675:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11676:     ; We had to account for the usual offset of 3.
                            	 11677:     ;
02:0003EEEA 41EC0084        	 11678:     lea     ($0084,A4),A0
02:0003EEEE 10302000        	 11679:     move.b  (A0,D2.W),D0
02:0003EEF2 023C00EE        	 11680:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEF6 123C0003        	 11681:     move.b  #$03,D1
02:0003EEFA D101            	 11682:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EEFC 02000007        	 11683:     andi.b #$07,D0
02:0003EF00 6702            	 11684:     beq.s  __far_z_04_0113
02:0003EF02 60D8            	 11685:     jmp  L12A6F_Exit
                            	 11686: __far_z_04_0113:
                            	 11687:     ; Will loop 4 times, propagating directions down the chain,
                            	 11688:     ; by pulling from the bottom.
                            	 11689:     ;
02:0003EF04 7004            	 11690:     moveq   #4,D0
02:0003EF06 1880            	 11691:     move.b  D0,($0000,A4)
                            	 11692:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11693:     ;
02:0003EF08 7600            	 11694:     moveq   #0,D3
02:0003EF0A 0C020005        	 11695:     cmpi.b  #$05,D2
02:0003EF0E 6702            	 11696:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EF10 7605            	 11697:     moveq   #5,D3
                            	 11698:     even
                            	 11699: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11700:     ; Loop over every segment under the head, starting from the tail.
                            	 11701:     ; Copy the next segment's direction to the current one in this loop.
                            	 11702:     ;
02:0003EF12 41EC009A        	 11703:     lea     ($009A,A4),A0
02:0003EF16 10303000        	 11704:     move.b  (A0,D3.W),D0
02:0003EF1A 41EC0099        	 11705:     lea     ($0099,A4),A0
02:0003EF1E 11803000        	 11706:     move.b  D0,(A0,D3.W)
02:0003EF22 5203            	 11707:     addq.b  #1,D3
02:0003EF24 5314            	 11708:     subq.b  #1,($0000,A4)
02:0003EF26 66EA            	 11709:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11710:     ; If this head segment is not aligned with a square, then return.
                            	 11711:     ;
02:0003EF28 10342070        	 11712:     move.b  ($70,A4,D2.W),D0
02:0003EF2C 0200000F        	 11713:     andi.b #$0F,D0
02:0003EF30 660000BA        	 11714:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11715:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11716:     ; We had to account for the usual offset of 3.
                            	 11717:     ;
02:0003EF34 41EC0084        	 11718:     lea     ($0084,A4),A0
02:0003EF38 10302000        	 11719:     move.b  (A0,D2.W),D0
02:0003EF3C 023C00EE        	 11720:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF40 123C0003        	 11721:     move.b  #$03,D1
02:0003EF44 D101            	 11722:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EF46 0200000F        	 11723:     andi.b #$0F,D0
02:0003EF4A 660000A0        	 11724:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11725:     ; Store the opposite of the facing direction in [00].
                            	 11726:     ;
02:0003EF4E 41EC0098        	 11727:     lea     ($0098,A4),A0
02:0003EF52 10302000        	 11728:     move.b  (A0,D2.W),D0
02:0003EF56 E208            	 11729:     lsr.b  #1,D0   ; LSR A
02:0003EF58 02000005        	 11730:     andi.b #$05,D0
02:0003EF5C 1880            	 11731:     move.b  D0,($0000,A4)
02:0003EF5E 41EC0098        	 11732:     lea     ($0098,A4),A0
02:0003EF62 10302000        	 11733:     move.b  (A0,D2.W),D0
02:0003EF66 E308            	 11734:     lsl.b  #1,D0   ; ASL A
02:0003EF68 0200000A        	 11735:     andi.b #$0A,D0
02:0003EF6C 1214            	 11736:     move.b  ($0000,A4),D1
02:0003EF6E 8001            	 11737:     or.b  D1,D0
                            	 11738:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11739:     ;
02:0003EF70 0A00000F        	 11740:     eori.b #$0F,D0
02:0003EF74 1940050F        	 11741:     move.b  D0,($050F,A4)
                            	 11742:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11743:     ;
02:0003EF78 10342018        	 11744:     move.b  ($18,A4,D2.W),D0
02:0003EF7C 0C000080        	 11745:     cmpi.b  #$80,D0
02:0003EF80 656C            	 11746:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11747:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11748:     ; Load the monster's facing direction.
                            	 11749:     ;
02:0003EF82 41EC0098        	 11750:     lea     ($0098,A4),A0
02:0003EF86 10302000        	 11751:     move.b  (A0,D2.W),D0
                            	 11752:     ; Load the next random number into Y register.
                            	 11753:     ;
02:0003EF8A 7600            	 11754:     moveq   #0,D3
02:0003EF8C 16342019        	 11755:     move.b  ($19,A4,D2.W),D3
                            	 11756:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11757:     ; to keep moving straight.
                            	 11758:     ;
02:0003EF90 0C030080        	 11759:     cmpi.b  #$80,D3
02:0003EF94 6418            	 11760:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11761:     even
                            	 11762: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11763:     ; Loop to rotate the direction bit over the mask.
                            	 11764:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11765:     ; facing direction.
                            	 11766:     ;
                            	 11767:     ; Shift right the copy of the direction.
                            	 11768:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11769:     ;
02:0003EF96 E208            	 11770:     lsr.b  #1,D0   ; LSR A
02:0003EF98 6402            	 11771:     bcc  _anon_z04_151
02:0003EF9A 7008            	 11772:     moveq   #8,D0
                            	 11773: _anon_z04_151:
                            	 11774:     ; If the current direction bit is masked off, then we've reached
                            	 11775:     ; the opposite direction. Loop again.
                            	 11776:     ;
02:0003EF9C 122C050F        	 11777:     move.b  ($050F,A4),D1
02:0003EFA0 C200            	 11778:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EFA2 67F2            	 11779:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11780:     ; If Y register >= $40, then break out of the loop.
                            	 11781:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11782:     ;
02:0003EFA4 0C030040        	 11783:     cmpi.b  #$40,D3
02:0003EFA8 6404            	 11784:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11785:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11786:     ; and loop again now.
                            	 11787:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11788:     ;
02:0003EFAA 7640            	 11789:     moveq   #64,D3
02:0003EFAC 65E8            	 11790:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11791:     even
                            	 11792: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11793:     ; Change the facing direction to the direction found.
                            	 11794:     ;
02:0003EFAE 41EC0098        	 11795:     lea     ($0098,A4),A0
02:0003EFB2 11802000        	 11796:     move.b  D0,(A0,D2.W)
                            	 11797:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11798:     ;
02:0003EFB6 1940000F        	 11799:     move.b  D0,($000F,A4)
02:0003EFBA 4EB900030E68    	 11800:     jsr     BoundByRoom
                            	 11801:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11802:     ;
02:0003EFC0 102C000F        	 11803:     move.b  ($000F,A4),D0
02:0003EFC4 6618            	 11804:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11805:     even
                            	 11806: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11807:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11808:     ; for looking for any non-opposite direction that is not blocked.
                            	 11809:     ;
02:0003EFC6 41EC0098        	 11810:     lea     ($0098,A4),A0
02:0003EFCA 10302000        	 11811:     move.b  (A0,D2.W),D0
                            	 11812:     even
                            	 11813: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11814:     ; Shift right the copy of the direction.
                            	 11815:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11816:     ;
02:0003EFCE E208            	 11817:     lsr.b  #1,D0   ; LSR A
02:0003EFD0 6402            	 11818:     bcc  _anon_z04_152
02:0003EFD2 7008            	 11819:     moveq   #8,D0
                            	 11820: _anon_z04_152:
                            	 11821:     ; If the current direction bit is not masked off, then go check the
                            	 11822:     ; room boundary in this direction.
                            	 11823:     ; Else we've reached the opposite direction. Loop again.
                            	 11824:     ;
02:0003EFD4 122C050F        	 11825:     move.b  ($050F,A4),D1
02:0003EFD8 C200            	 11826:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EFDA 66D2            	 11827:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EFDC 67F0            	 11828:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11829:     even
                            	 11830: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11831:     ; We found a direction that was not blocked by the room boundary.
                            	 11832:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11833:     ;
02:0003EFDE 4EB90004B79C    	 11834:     jsr     GetCollidingTileMoving
02:0003EFE4 122C034A        	 11835:     move.b  ($034A,A4),D1
02:0003EFE8 B001            	 11836:     cmp.b   D1,D0
02:0003EFEA 64DA            	 11837:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11838:     even
                            	 11839: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11840:     ; TODO: confirm this
                            	 11841:     ;
                            	 11842:     ; If there were a room that had lamnolas, and they could get
                            	 11843:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11844:     ; an infinite loop.
                            	 11845:     ;
                            	 11846:     ; But, the only room with that configuration has those blocks
                            	 11847:     ; blocked off with a push block, which can only be pushed after
                            	 11848:     ; all monsters are killed.
                            	 11849:     ;
02:0003EFEC 4E75            	 11850:     rts
                            	 11851: 
                            	 11852:     even
                            	 11853: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11854:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11855:     ;
02:0003EFEE 7001            	 11856:     moveq   #1,D0
02:0003EFF0 19400002        	 11857:     move.b  D0,($0002,A4)
02:0003EFF4 102C0070        	 11858:     move.b  ($0070,A4),D0
02:0003EFF8 003C0011        	 11859:     ori     #$11,CCR  ; SEC: set C+X
02:0003EFFC 12342070        	 11860:     move.b  ($70,A4,D2.W),D1
02:0003F000 0A3C0010        	 11861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F004 9101            	 11862:     subx.b  D1,D0   ; SBC ObjX,X
02:0003F006 0A3C0010        	 11863:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F00A 640A            	 11864:     bcc  _anon_z04_153
02:0003F00C 122C0002        	 11865:     move.b  ($0002,A4),D1
02:0003F010 E309            	 11866:     lsl.b  #1,D1   ; ASL $02
02:0003F012 19410002        	 11867:     move.b  D1,($0002,A4)
                            	 11868: _anon_z04_153:
                            	 11869:     ; Find the vertical direction toward Link and store it in [03].
                            	 11870:     ;
02:0003F016 7004            	 11871:     moveq   #4,D0
02:0003F018 19400003        	 11872:     move.b  D0,($0003,A4)
02:0003F01C 102C0084        	 11873:     move.b  ($0084,A4),D0
02:0003F020 003C0011        	 11874:     ori     #$11,CCR  ; SEC: set C+X
02:0003F024 41EC0084        	 11875:     lea     ($0084,A4),A0
02:0003F028 12302000        	 11876:     move.b  (A0,D2.W),D1
02:0003F02C 0A3C0010        	 11877:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F030 9101            	 11878:     subx.b  D1,D0   ; SBC ObjY,X
02:0003F032 0A3C0010        	 11879:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F036 640A            	 11880:     bcc  _anon_z04_154
02:0003F038 122C0003        	 11881:     move.b  ($0003,A4),D1
02:0003F03C E309            	 11882:     lsl.b  #1,D1   ; ASL $03
02:0003F03E 19410003        	 11883:     move.b  D1,($0003,A4)
                            	 11884: _anon_z04_154:
                            	 11885:     ; If the horizontal direction toward Link is not allowed, then
                            	 11886:     ; go check the vertical direction.
                            	 11887:     ;
02:0003F042 102C0002        	 11888:     move.b  ($0002,A4),D0
02:0003F046 122C050F        	 11889:     move.b  ($050F,A4),D1
02:0003F04A C200            	 11890:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F04C 6708            	 11891:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11892:     ; If the horizontal direction toward Link is the same direction
                            	 11893:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11894:     ;
02:0003F04E 122C0098        	 11895:     move.b  ($0098,A4),D1
02:0003F052 C200            	 11896:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F054 6604            	 11897:     bne  _anon_z04_155
                            	 11898:     even
                            	 11899: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11900:     ; Load the vertical direction toward Link in order to test it for
                            	 11901:     ; room boundary and tile collision.
                            	 11902:     ;
02:0003F056 102C0003        	 11903:     move.b  ($0003,A4),D0
                            	 11904: _anon_z04_155:
                            	 11905:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11906:     ;
02:0003F05A 6000FF52        	 11907:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11908: 
