02:00039B64 9101            	   271:     subx.b  D1,D0   ; SBC ObjY,X
02:00039B66 0A3C0010        	   272:     eori    #$10,CCR  ; restore X = 6502 C
02:00039B6A 6402            	   273:     bcc  _anon_z04_3
02:00039B6C 7608            	   274:     moveq   #8,D3
                            	   275: _anon_z04_3:
