                            	  3021: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3022:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3023:     ; then this trap definitely wasn't triggered.
                            	  3024:     ; Go draw and check collisions.
                            	  3025:     ;
02:0003074C 102C0070        	  3026:     move.b  ($0070,A4),D0
02:00030750 003C0011        	  3027:     ori     #$11,CCR  ; SEC: set C+X
02:00030754 12342070        	  3028:     move.b  ($70,A4,D2.W),D1
02:00030758 0A3C0010        	  3029:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003075C 9101            	  3030:     subx.b  D1,D0   ; SBC ObjX,X
02:0003075E 0A3C0010        	  3031:     eori    #$10,CCR  ; restore X = 6502 C
02:00030762 61000802        	  3032:     jsr     Abs
02:00030766 0C00000E        	  3033:     cmpi.b  #$0E,D0
02:0003076A 64DC            	  3034:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3035:     ; Determine the vertical direction toward Link;
                            	  3036:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3037:     ; along this axis. Go draw and check object collisions.
                            	  3038:     ;
02:0003076C 7604            	  3039:     moveq   #4,D3
02:0003076E 102C0084        	  3040:     move.b  ($0084,A4),D0
