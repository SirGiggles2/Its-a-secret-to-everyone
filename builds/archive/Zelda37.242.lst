02:0004C22C 19400002        	  5134:     move.b  D0,($0002,A4)
                            	  5135:     ; Take turns negating X offset or Y offset for the next round.
                            	  5136:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5137:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5138:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5139:     ; - Fourth turn: doesn't matter
                            	  5140:     ;
                            	  5141:     ;
                            	  5142:     ; Get the loop index.
02:0004C230 101D            	  5143:     move.b  (A5)+,D0  ; PLA
02:0004C232 1B00            	  5144:     move.b  D0,-(A5)  ; PHA
02:0004C234 7600            	  5145:     moveq   #0,D3
02:0004C236 1600            	  5146:     move.b  D0,D3
02:0004C238 0C030001        	  5147:     cmpi.b  #$01,D3
02:0004C23C 6602            	  5148:     bne  _anon_z07_25
02:0004C23E 7603            	  5149:     moveq   #3,D3
