                            	  2083: CheckZora:
                            	  2084:     ; If the zora attribute of this room is off, return.
                            	  2085:     ;
02:0003A8A0 7600            	  2086:     moveq   #0,D3
02:0003A8A2 162C00EB        	  2087:     move.b  ($00EB,A4),D3
02:0003A8A6 41F900FF687E    	  2088:     lea     (NES_SRAM+$087E).l,A0
02:0003A8AC 10303000        	  2089:     move.b  (A0,D3.W),D0
02:0003A8B0 02000008        	  2090:     andi.b #$08,D0
02:0003A8B4 677C            	  2091:     beq  _L_z04_CheckZora_Exit
                            	  2092:     ; If zora is active, return.
                            	  2093:     ;
02:0003A8B6 102C0514        	  2094:     move.b  ($0514,A4),D0
02:0003A8BA 6676            	  2095:     bne  _L_z04_CheckZora_Exit
                            	  2096:     ; Look for an empty monster slot. If none is found, return.
                            	  2097:     ;
02:0003A8BC 4EB90004D650    	  2098:     jsr     FindEmptyMonsterSlot
02:0003A8C2 676E            	  2099:     beq  _L_z04_CheckZora_Exit
                            	  2100:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2101:     ; Indexed by [0D].
                            	  2102:     ;
02:0003A8C4 700D            	  2103:     moveq   #13,D0
02:0003A8C6 1940000D        	  2104:     move.b  D0,($000D,A4)
                            	  2105:     ; Switch to the new object slot.
                            	  2106:     ;
02:0003A8CA 7400            	  2107:     moveq   #0,D2
02:0003A8CC 142C0059        	  2108:     move.b  ($0059,A4),D2
                            	  2109:     even
                            	  2110: _L_z04_CheckZora_LoopTileCandidate:
                            	  2111:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2112:     ; If it = 0 or $F0, go loop again.
                            	  2113:     ;
02:0003A8D0 7600            	  2114:     moveq   #0,D3
02:0003A8D2 162C000D        	  2115:     move.b  ($000D,A4),D3
02:0003A8D6 10343018        	  2116:     move.b  ($18,A4,D3.W),D0
02:0003A8DA 020000F0        	  2117:     andi.b #$F0,D0
02:0003A8DE 19802070        	  2118:     move.b  D0,($70,A4,D2.W)
02:0003A8E2 6748            	  2119:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A8E4 0C0000F0        	  2120:     cmpi.b  #$F0,D0
02:0003A8E8 6742            	  2121:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2122:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2123:     ; If it < $50 or >= $E0, go loop again.
                            	  2124:     ;
02:0003A8EA 10343018        	  2125:     move.b  ($18,A4,D3.W),D0
02:0003A8EE E308            	  2126:     lsl.b  #1,D0   ; ASL A
02:0003A8F0 E308            	  2127:     lsl.b  #1,D0   ; ASL A
02:0003A8F2 E308            	  2128:     lsl.b  #1,D0   ; ASL A
02:0003A8F4 E308            	  2129:     lsl.b  #1,D0   ; ASL A
02:0003A8F6 0C000050        	  2130:     cmpi.b  #$50,D0
02:0003A8FA 6530            	  2131:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A8FC 0C0000E0        	  2132:     cmpi.b  #$E0,D0
02:0003A900 642A            	  2133:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2134:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2135:     ;
02:0003A902 0000000D        	  2136:     ori.b #$0D,D0
02:0003A906 41EC0084        	  2137:     lea     ($0084,A4),A0
02:0003A90A 11802000        	  2138:     move.b  D0,(A0,D2.W)
                            	  2139:     ; Get the tile at that location.
                            	  2140:     ; If it's not a water tile, then go loop again.
                            	  2141:     ;
02:0003A90E 4EB90004B796    	  2142:     jsr     GetCollidableTileStill
02:0003A914 0C00008D        	  2143:     cmpi.b  #$8D,D0
02:0003A918 6512            	  2144:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A91A 0C000099        	  2145:     cmpi.b  #$99,D0
02:0003A91E 640C            	  2146:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2147:     ; Flag the zora active, and set up the object.
                            	  2148:     ;
02:0003A920 522C0514        	  2149:     addq.b  #1,($0514,A4)
02:0003A924 7011            	  2150:     moveq   #17,D0
02:0003A926 4EF90004D64A    	  2151:     jmp     SetTypeAndClearObject
                            	  2152: 
                            	  2153:     even
                            	  2154: _L_z04_CheckZora_NextLoopTileCandidate:
