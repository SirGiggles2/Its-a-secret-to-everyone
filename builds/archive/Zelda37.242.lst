                            	  1716: InitMode_EnterRoom:
02:000410C8 4EB90004B1DE    	  1717:     jsr     DrawSpritesBetweenRooms
02:000410CE 4EB90004B1FC    	  1718:     jsr     ResetPlayerState
                            	  1719:     ; Reset [0300] to [051F].
                            	  1720:     ;
02:000410D4 7005            	  1721:     moveq   #5,D0
02:000410D6 761F            	  1722:     moveq   #31,D3
02:000410D8 4EB90004AA36    	  1723:     jsr     ClearRam0300UpTo
                            	  1724:     ; Reset door trigger info.
                            	  1725:     ;
02:000410DE 7000            	  1726:     moveq   #0,D0
02:000410E0 19400054        	  1727:     move.b  D0,($0054,A4)
02:000410E4 19400055        	  1728:     move.b  D0,($0055,A4)
                            	  1729:     ; Store level block attribute byte F for convenience.
                            	  1730:     ;
02:000410E8 7600            	  1731:     moveq   #0,D3
02:000410EA 162C00EB        	  1732:     move.b  ($00EB,A4),D3
02:000410EE 41F900FF6AFE    	  1733:     lea     (NES_SRAM+$0AFE).l,A0
02:000410F4 10303000        	  1734:     move.b  (A0,D3.W),D0
02:000410F8 194004CD        	  1735:     move.b  D0,($04CD,A4)
02:000410FC 610039C4        	  1736:     jsr     ResetInvObjState
                            	  1737:     ; There's more than one way to enter a room.
                            	  1738:     ;
                            	  1739:     ; 1: Out of a cave, dungeon, or cellar
                            	  1740:     ;     a. Walking exit
                            	  1741:     ;     b. Next to stairs
                            	  1742:     ; 2: Room to room
                            	  1743:     ;
                            	  1744:     ; Determine which one we need.
                            	  1745:     ;
02:00041100 102C005A        	  1746:     move.b  ($005A,A4),D0
02:00041104 6770            	  1747:     beq  _L_z05_InitMode_EnterRoom_Method2
02:00041106 102C0010        	  1748:     move.b  ($0010,A4),D0
02:0004110A 665C            	  1749:     bne  _anon_z05_42
                            	  1750:     ; Enter method 1.
                            	  1751:     ;
                            	  1752:     ; Set up Link's exit from underground.
                            	  1753:     ;
02:0004110C 7600            	  1754:     moveq   #0,D3
02:0004110E 162C00EB        	  1755:     move.b  ($00EB,A4),D3
02:00041112 41F900FF687E    	  1756:     lea     (NES_SRAM+$087E).l,A0
02:00041118 10303000        	  1757:     move.b  (A0,D3.W),D0
02:0004111C 020000F0        	  1758:     andi.b #$F0,D0
02:00041120 19400070        	  1759:     move.b  D0,($0070,A4)
02:00041124 41F900FF6AFE    	  1760:     lea     (NES_SRAM+$0AFE).l,A0
02:0004112A 10303000        	  1761:     move.b  (A0,D3.W),D0
02:0004112E 02000007        	  1762:     andi.b #$07,D0
02:00041132 E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:00041134 E308            	  1764:     lsl.b  #1,D0   ; ASL A
02:00041136 E308            	  1765:     lsl.b  #1,D0   ; ASL A
02:00041138 E308            	  1766:     lsl.b  #1,D0   ; ASL A
                            	  1767:     ; Add the first Y where Link can come out of underground.
                            	  1768:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:0004113A 123C004D        	  1769:     move.b  #$4D,D1
02:0004113E D101            	  1770:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00041140 19400084        	  1771:     move.b  D0,($0084,A4)
                            	  1772:     ; If the player didn't step on a cave entrance to go underground,
                            	  1773:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1774:     ;
02:00041144 7600            	  1775:     moveq   #0,D3
02:00041146 162C0065        	  1776:     move.b  ($0065,A4),D3
02:0004114A 0C030024        	  1777:     cmpi.b  #$24,D3
02:0004114E 6618            	  1778:     bne  _anon_z05_42
                            	  1779:     ; Enter method 1-a.
                            	  1780:     ;
                            	  1781:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1782:     ;
02:00041150 19400412        	  1783:     move.b  D0,($0412,A4)
02:00041154 023C00EE        	  1784:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041158 123C0010        	  1785:     move.b  #$10,D1
02:0004115C D101            	  1786:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004115E 19400084        	  1787:     move.b  D0,($0084,A4)
02:00041162 7008            	  1788:     moveq   #8,D0
02:00041164 19400603        	  1789:     move.b  D0,($0603,A4)
                            	  1790: _anon_z05_42:
                            	  1791:     ; This part is the same no matter if the player went
                            	  1792:     ; underground by stairs or a cave entrance.
                            	  1793:     ;
02:00041168 7004            	  1794:     moveq   #4,D0
02:0004116A 19400098        	  1795:     move.b  D0,($0098,A4)
02:0004116E 7000            	  1796:     moveq   #0,D0
02:00041170 19400053        	  1797:     move.b  D0,($0053,A4)
02:00041174 6064            	  1798:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1799: 
                            	  1800:     even
                            	  1801: _L_z05_InitMode_EnterRoom_Method2:
                            	  1802:     ; Enter method 2.
                            	  1803:     ; Room to room.
                            	  1804:     ;
                            	  1805:     ; Get the direction that the player is entering from.
                            	  1806:     ;
02:00041176 102C0098        	  1807:     move.b  ($0098,A4),D0
02:0004117A 19400053        	  1808:     move.b  D0,($0053,A4)
02:0004117E 4EB900030F62    	  1809:     jsr     GetOppositeDir
                            	  1810:     ; If the player is entering from a door that was opened, then
                            	  1811:     ; set the "close" door command.
                            	  1812:     ;
02:00041184 122C00EE        	  1813:     move.b  ($00EE,A4),D1
02:00041188 C001            	  1814:     and.b  D1,D0
02:0004118A 19400055        	  1815:     move.b  D0,($0055,A4)
02:0004118E 6706            	  1816:     beq  _anon_z05_43
02:00041190 7002            	  1817:     moveq   #2,D0
02:00041192 19400054        	  1818:     move.b  D0,($0054,A4)
                            	  1819: _anon_z05_43:
                            	  1820:     ; If in OW, go reset Link's relative position, and work on objects.
                            	  1821:     ;
02:00041196 102C0010        	  1822:     move.b  ($0010,A4),D0
02:0004119A 673E            	  1823:     beq  _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1824:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1825:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1826:     ;
02:0004119C 7600            	  1827:     moveq   #0,D3
02:0004119E 102C0098        	  1828:     move.b  ($0098,A4),D0
02:000411A2 02000003        	  1829:     andi.b #$03,D0
02:000411A6 670E            	  1830:     beq  _L_z05_InitMode_EnterRoom_ChooseWalkDistance
02:000411A8 02000001        	  1831:     andi.b #$01,D0
02:000411AC 6604            	  1832:     bne  _anon_z05_44
02:000411AE 163C00F0        	  1833:     move.b  #$F0,D3
                            	  1834: _anon_z05_44:
