02:0003EE08 102C04E6        	 11568:     move.b  ($04E6,A4),D0
02:0003EE0C 0A000003        	 11569:     eori.b #$03,D0
02:0003EE10 19400003        	 11570:     move.b  D0,($0003,A4)
