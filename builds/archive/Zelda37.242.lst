02:00031AC4 16302000        	  5721:     move.b  (A0,D2.W),D3
                            	  5722: ; Params:
                            	  5723: ; A: frame
                            	  5724: ; X: object index/cycle sprite index
                            	  5725: ; Y: object type
                            	  5726: ; [00]: object X
                            	  5727: ; [01]: object Y
                            	  5728: ; [0C]: mirrored
                            	  5729: ; [0F]: flip horizontally
                            	  5730: ;
                            	  5731: ; Note:
                            	  5732: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5733: ;
                            	  5734: ; The animation index of most objects is (object type + 1),
                            	  5735: ; to make up for the fact that Link uses two animation indexes.
                            	  5736: ;
                            	  5737:     even
                            	  5738: DrawObjectWithType:
02:00031AC8 5203            	  5739:     addq.b  #1,D3
                            	  5740: ; Params:
                            	  5741: ; A: frame
                            	  5742: ; X: object index/cycle sprite index
                            	  5743: ; Y: animation index
                            	  5744: ; [00]: object X
                            	  5745: ; [01]: object Y
                            	  5746: ; [0C]: mirrored
                            	  5747: ; [0F]: flip horizontally
                            	  5748: ;
                            	  5749: ; Note:
                            	  5750: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5751: ; But Link uses [0F] for flipping without checking [0C].
                            	  5752: ;
                            	  5753: ;
                            	  5754: ; [0D] holds frame.
                            	  5755:     even
