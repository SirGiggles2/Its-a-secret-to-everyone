                            	  2691: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2692:     ; If reversal count >= 2, then
                            	  2693:     ; 1. invert the horizontal component of facing direction,
                            	  2694:     ;    to face away from the chase target
                            	  2695:     ; 2. reset the reversal count to 0.
                            	  2696:     ;
                            	  2697:     ; This prevents a jumper from getting stuck in a corner.
                            	  2698:     ;
                            	  2699:     ; For example, if a tektite's direction is down and right,
                            	  2700:     ; and jumps into the top right corner of the room:
                            	  2701:     ; 1. The right room boundary is hit. So the direction is
                            	  2702:     ;    automatically reversed to up and left.
                            	  2703:     ; 2. The next frame, the top room boundary is hit.
                            	  2704:     ;    The direction is reversed to down and right.
                            	  2705:     ;
                            	  2706:     ; As you can see, an endless loop has been made.
                            	  2707:     ;
02:0003AC78 41EC0451        	  2708:     lea     ($0451,A4),A0
02:0003AC7C 10302000        	  2709:     move.b  (A0,D2.W),D0
02:0003AC80 0C000002        	  2710:     cmpi.b  #$02,D0
02:0003AC84 651E            	  2711:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003AC86 41EC0098        	  2712:     lea     ($0098,A4),A0
02:0003AC8A 10302000        	  2713:     move.b  (A0,D2.W),D0
02:0003AC8E 0A000003        	  2714:     eori.b #$03,D0
02:0003AC92 41EC0098        	  2715:     lea     ($0098,A4),A0
02:0003AC96 11802000        	  2716:     move.b  D0,(A0,D2.W)
02:0003AC9A 7000            	  2717:     moveq   #0,D0
02:0003AC9C 41EC0451        	  2718:     lea     ($0451,A4),A0
02:0003ACA0 11802000        	  2719:     move.b  D0,(A0,D2.W)
                            	  2720:     even
                            	  2721: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2722:     ; If the object is a boulder, then make sure its facing direction
                            	  2723:     ; has a down vertical component.
                            	  2724:     ;
02:0003ACA4 610001F8        	  2725:     jsr     Jumper_PointBoulderDownward
                            	  2726:     ; For the given direction, get the Y offset of the destination
                            	  2727:     ; of the jump.
                            	  2728:     ;
                            	  2729:     ; Add it to the object's Y, and store this destination Y.
                            	  2730:     ;
02:0003ACA8 7600            	  2731:     moveq   #0,D3
02:0003ACAA 41EC0098        	  2732:     lea     ($0098,A4),A0
02:0003ACAE 16302000        	  2733:     move.b  (A0,D2.W),D3
02:0003ACB2 41EC0084        	  2734:     lea     ($0084,A4),A0
02:0003ACB6 10302000        	  2735:     move.b  (A0,D2.W),D0
02:0003ACBA 023C00EE        	  2736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACBE 41F90003ABD6    	  2737:     lea     (JumperYOffsets).l,A0
02:0003ACC4 12303000        	  2738:     move.b  (A0,D3.W),D1
02:0003ACC8 D101            	  2739:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003ACCA 41EC0444        	  2740:     lea     ($0444,A4),A0
02:0003ACCE 11802000        	  2741:     move.b  D0,(A0,D2.W)
