02:000317E8 142C052F        	  5513:     move.b  ($052F,A4),D2
02:000317EC 102C0098        	  5514:     move.b  ($0098,A4),D0
02:000317F0 7600            	  5515:     moveq   #0,D3
02:000317F2 162C00EB        	  5516:     move.b  ($00EB,A4),D3
02:000317F6 0C030061        	  5517:     cmpi.b  #$61,D3
02:000317FA 6630            	  5518:     bne  _L_z01_CheckMazes_CheckMountainMaze
02:000317FC 41F9000317DE    	  5519:     lea     (ForestMazeDirs).l,A0
02:00031802 12302000        	  5520:     move.b  (A0,D2.W),D1
02:00031806 B001            	  5521:     cmp.b   D1,D0
02:00031808 6618            	  5522:     bne  _L_z01_CheckMazes_Mismatch
                            	  5523:     ; The direction matches the step.
                            	  5524:     ;
02:0003180A 0C020003        	  5525:     cmpi.b  #$03,D2
02:0003180E 6742            	  5526:     beq  _L_z01_CheckMazes_PlaySecretTune
                            	  5527:     even
                            	  5528: _L_z01_CheckMazes_AdvanceMaze:
