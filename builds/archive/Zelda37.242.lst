                            	   549:     ; definitely be clear.
02:0003395E 6100D1F8        	   550:     jsr     FetchFileAAddressSet
02:00033962 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00033964 7600            	   552:     moveq   #0,D3
02:00033966 1600            	   553:     move.b  D0,D3
