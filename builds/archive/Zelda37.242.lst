02:0003EE62 7020            	 11604:     moveq   #32,D0
02:0003EE64 41EC0485        	 11605:     lea     ($0485,A4),A0
02:0003EE68 11802000        	 11606:     move.b  D0,(A0,D2.W)
                            	 11607:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11608:     ;
                            	 11609:     ; From the lowest slot, look for one that has the original lamnola
                            	 11610:     ; object type.
