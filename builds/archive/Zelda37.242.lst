02:0003C21E 19400385        	  5643:     move.b  D0,($0385,A4)
02:0003C222 102C0022        	  5644:     move.b  ($0022,A4),D0
02:0003C226 02000007        	  5645:     andi.b #$07,D0
02:0003C22A 7600            	  5646:     moveq   #0,D3
