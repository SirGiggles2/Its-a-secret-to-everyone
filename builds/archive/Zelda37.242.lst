                            	  5836: CalcBoomerangFrame:
                            	  5837:     ; The minor state (low 3 bits of state) is used to
                            	  5838:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5839:     ;
                            	  5840:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5841:     ; In other words, don't offset the coordinate below.
                            	  5842:     ;
02:0004C6FA 7000            	  5843:     moveq   #0,D0
02:0004C6FC 1880            	  5844:     move.b  D0,($0000,A4)
02:0004C6FE 41EC00AC        	  5845:     lea     ($00AC,A4),A0
02:0004C702 10302000        	  5846:     move.b  (A0,D2.W),D0
