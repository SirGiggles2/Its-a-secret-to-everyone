02:00030680 1880            	  2918:     move.b  D0,($0000,A4)
                            	  2919:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  2920:     ; then we'll make 4 traps.
                            	  2921:     ;
02:00030682 41EC034F        	  2922:     lea     ($034F,A4),A0
02:00030686 12302000        	  2923:     move.b  (A0,D2.W),D1
