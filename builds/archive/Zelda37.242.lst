                            	  5513:     ;
                            	  5514:     ; Set state to $40. It will become $50 below in
                            	  5515:     ; HandleArrowOrBoomerangBlocked.
                            	  5516:     ;
02:0004C4AA 7040            	  5517:     moveq   #64,D0
02:0004C4AC 41EC00AC        	  5518:     lea     ($00AC,A4),A0
02:0004C4B0 11802000        	  5519:     move.b  D0,(A0,D2.W)
                            	  5520:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5521:     ; Else go handle the boomerang being blocked.
                            	  5522:     ;
02:0004C4B4 0C02000D        	  5523:     cmpi.b  #$0D,D2
02:0004C4B8 640E            	  5524:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C4BA 41EC034F        	  5525:     lea     ($034F,A4),A0
02:0004C4BE 10302000        	  5526:     move.b  (A0,D2.W),D0
02:0004C4C2 0C00005B        	  5527:     cmpi.b  #$5B,D0
02:0004C4C6 6708            	  5528:     beq  _L_z07_CheckState20_Deactivate
