                            	  5872: _anon_z05_120:
                            	  5873:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5874:     ;
                            	  5875:     ; Shutters and the commands to open a door always change
                            	  5876:     ; tiles.
                            	  5877:     ;
02:0004393C 61000130        	  5878:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5879:     even
                            	  5880: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5881:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5882:     ; We need to remember how many tiles need to be copied
                            	  5883:     ; in each transfer record.
                            	  5884:     ;
02:00043940 102C0006        	  5885:     move.b  ($0006,A4),D0
02:00043944 19400004        	  5886:     move.b  D0,($0004,A4)
                            	  5887:     ; Write the transfer record header for the door.
                            	  5888:     ;
                            	  5889:     ;
                            	  5890:     ; VRAM address high byte of door
02:00043948 1014            	  5891:     move.b  ($0000,A4),D0
02:0004394A 41EC0302        	  5892:     lea     ($0302,A4),A0
02:0004394E 11802000        	  5893:     move.b  D0,(A0,D2.W)
02:00043952 5202            	  5894:     addq.b  #1,D2
02:00043954 102C0001        	  5895:     move.b  ($0001,A4),D0
02:00043958 41EC0302        	  5896:     lea     ($0302,A4),A0
02:0004395C 11802000        	  5897:     move.b  D0,(A0,D2.W)
02:00043960 5202            	  5898:     addq.b  #1,D2
02:00043962 102C0006        	  5899:     move.b  ($0006,A4),D0
02:00043966 41EC0302        	  5900:     lea     ($0302,A4),A0
02:0004396A 11802000        	  5901:     move.b  D0,(A0,D2.W)
02:0004396E 5202            	  5902:     addq.b  #1,D2
                            	  5903: _anon_z05_121:
                            	  5904:     ; Write two tiles in a short loop indexed by [04].
                            	  5905:     ;
02:00043970 6100ED1C        	  5906:     jsr     WriteDoorFaceTileHorizontally
02:00043974 66FA            	  5907:     bne  _anon_z05_121
                            	  5908:     ; OR the low VRAM address with $20 to go down one row
                            	  5909:     ; in order to work on the second row of door tiles.
                            	  5910:     ;
02:00043976 7020            	  5911:     moveq   #32,D0
02:00043978 122C0001        	  5912:     move.b  ($0001,A4),D1
02:0004397C 8001            	  5913:     or.b  D1,D0
02:0004397E 19400001        	  5914:     move.b  D0,($0001,A4)
                            	  5915:     ; Bottom of the loop.
                            	  5916:     ; Loop again to write the second transfer record for the
                            	  5917:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5918:     ;
02:00043982 532C0005        	  5919:     subq.b  #1,($0005,A4)
02:00043986 66B8            	  5920:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5921:     ; Write the end marker, and update buffer length.
                            	  5922:     ;
02:00043988 103C00FF        	  5923:     move.b  #$FF,D0
02:0004398C 41EC0302        	  5924:     lea     ($0302,A4),A0
02:00043990 11802000        	  5925:     move.b  D0,(A0,D2.W)
02:00043994 1002            	  5926:     move.b  D2,D0
02:00043996 19400301        	  5927:     move.b  D0,($0301,A4)
                            	  5928:     ; Increment the command.
                            	  5929:     ;
02:0004399A 522C0054        	  5930:     addq.b  #1,($0054,A4)
                            	  5931:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5932:     ; and resetting the door command.
                            	  5933:     ; This ends up catching original states 3 and 7.
                            	  5934:     ;
                            	  5935:     ; Else set door timer to 8 and return.
                            	  5936:     ;
02:0004399E 102C0054        	  5937:     move.b  ($0054,A4),D0
02:000439A2 02000003        	  5938:     andi.b #$03,D0
02:000439A6 6708            	  5939:     beq  _anon_z05_122
02:000439A8 7008            	  5940:     moveq   #8,D0
02:000439AA 19400027        	  5941:     move.b  D0,($0027,A4)
02:000439AE 4E75            	  5942:     rts
                            	  5943: 
                            	  5944: _anon_z05_122:
                            	  5945:     ; If the door command = 4 after incrementing it, then
                            	  5946:     ; it was 3 (close door). So:
                            	  5947:     ; 1. reset this door's flag
                            	  5948:     ; 2. remove it from the opened door mask
                            	  5949:     ; 3. reset the door command
                            	  5950:     ; 4. go lay out doors in the play area map
                            	  5951:     ;
02:000439B0 102C0054        	  5952:     move.b  ($0054,A4),D0
02:000439B4 0C000004        	  5953:     cmpi.b  #$04,D0
02:000439B8 6626            	  5954:     bne  _anon_z05_123
02:000439BA 7400            	  5955:     moveq   #0,D2
02:000439BC 142C0009        	  5956:     move.b  ($0009,A4),D2
02:000439C0 6100DC00        	  5957:     jsr     ResetDoorFlag
02:000439C4 102C0055        	  5958:     move.b  ($0055,A4),D0
02:000439C8 0A00000F        	  5959:     eori.b #$0F,D0
02:000439CC 122C00EE        	  5960:     move.b  ($00EE,A4),D1
02:000439D0 C001            	  5961:     and.b  D1,D0
                            	  5962:     even
                            	  5963: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000439D2 194000EE        	  5964:     move.b  D0,($00EE,A4)
                            	  5965:     even
                            	  5966: L_ResetDoorCmdAndLayOutDoors:
02:000439D6 7000            	  5967:     moveq   #0,D0
02:000439D8 19400054        	  5968:     move.b  D0,($0054,A4)
02:000439DC 6000FCD4        	  5969:     jmp     LayOutDoors
                            	  5970: 
                            	  5971: _anon_z05_123:
                            	  5972:     ; Door command <> 4.
                            	  5973:     ; It must be 8, which means it was 7: open door.
                            	  5974:     ;
                            	  5975:     ; If the door is a shutter (7), then go add the door to the
                            	  5976:     ; opened door mask, reset door command, and lay out doors.
                            	  5977:     ;
02:000439E0 102C0055        	  5978:     move.b  ($0055,A4),D0
02:000439E4 19400002        	  5979:     move.b  D0,($0002,A4)
02:000439E8 6100FA32        	  5980:     jsr     FindDoorAttrByDoorBit
02:000439EC 0C000007        	  5981:     cmpi.b  #$07,D0
02:000439F0 676E            	  5982:     beq  _anon_z05_124
                            	  5983:     ; Else the door is not a shutter.
                            	  5984:     ;
                            	  5985:     ;
                            	  5986:     ; [09] door direction index
02:000439F2 7400            	  5987:     moveq   #0,D2
02:000439F4 142C0009        	  5988:     move.b  ($0009,A4),D2
02:000439F8 6100DBC2        	  5989:     jsr     SetDoorFlag
                            	  5990:     ; Get the next room's ID.
                            	  5991:     ;
02:000439FC 1003            	  5992:     move.b  D3,D0
02:000439FE 023C00EE        	  5993:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043A02 41F9000438BE    	  5994:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043A08 12302000        	  5995:     move.b  (A0,D2.W),D1
02:00043A0C D101            	  5996:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043A0E 7600            	  5997:     moveq   #0,D3
02:00043A10 1600            	  5998:     move.b  D0,D3
                            	  5999:     ; Flip the door direction index.
                            	  6000:     ;
02:00043A12 1002            	  6001:     move.b  D2,D0
02:00043A14 0A000001        	  6002:     eori.b #$01,D0
02:00043A18 7400            	  6003:     moveq   #0,D2
02:00043A1A 1400            	  6004:     move.b  D0,D2
                            	  6005:     ; Set the door flag for the opposite door in the next room.
                            	  6006:     ;
02:00043A1C 1214            	  6007:     move.b  ($00,A4),D1   ; ptr lo
02:00043A1E 182C0001        	  6008:     move.b  ($01,A4),D4  ; ptr hi
02:00043A22 024100FF        	  6009:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A26 E14C            	  6010:     lsl.w   #8,D4
02:00043A28 8841            	  6011:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043A2A 48C4            	  6012:     ext.l   D4
02:00043A2C D8BC00FF0000    	  6013:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043A32 2044            	  6014:     movea.l D4,A0
02:00043A34 10303000        	  6015:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043A38 41F90004ABD4    	  6016:     lea     (LevelMasks).l,A0
02:00043A3E 12302000        	  6017:     move.b  (A0,D2.W),D1
02:00043A42 8001            	  6018:     or.b  D1,D0
02:00043A44 1214            	  6019:     move.b  ($00,A4),D1   ; ptr lo
02:00043A46 182C0001        	  6020:     move.b  ($01,A4),D4  ; ptr hi
02:00043A4A 024100FF        	  6021:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A4E E14C            	  6022:     lsl.w   #8,D4
02:00043A50 8841            	  6023:     or.w    D1,D4
02:00043A52 48C4            	  6024:     ext.l   D4
02:00043A54 D8BC00FF0000    	  6025:     add.l   #NES_RAM,D4
02:00043A5A 2044            	  6026:     movea.l D4,A0
02:00043A5C 11803000        	  6027:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6028: _anon_z05_124:
                            	  6029:     ; Add the door to the opened door mask, reset door command,
                            	  6030:     ; and lay out doors.
                            	  6031:     ;
02:00043A60 102C0055        	  6032:     move.b  ($0055,A4),D0
02:00043A64 122C00EE        	  6033:     move.b  ($00EE,A4),D1
02:00043A68 8001            	  6034:     or.b  D1,D0
02:00043A6A 6000FF66        	  6035:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6036: 
                            	  6037: ; Params:
                            	  6038: ; [08]: 0 if closed
                            	  6039: ;
                            	  6040: ; Returns:
                            	  6041: ; X: current length of dynamic transfer buf
                            	  6042: ; [00]: door VRAM address high byte
                            	  6043: ; [01]: door VRAM address low byte
                            	  6044: ; [02:03]: address of door tiles for direction and face
                            	  6045: ; [05]: 2, the number of transfer records to write
                            	  6046: ; [06]: 2, the number of tiles in each record
                            	  6047: ; [07]: 0, the first index of a tile to transfer
                            	  6048: ; [09]: door direction index
                            	  6049: ;
                            	  6050: ; Note that this routine is called with triggered doors:
                            	  6051: ; doors that can change state. Their door type numbers are >= 4.
                            	  6052: ;
                            	  6053: ; If this routine were ever called with a fixed door
                            	  6054: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6055: ; values for the door face.
                            	  6056: ;
                            	  6057: ;
                            	  6058: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6059: ;
                            	  6060:     even
                            	  6061: PrepareWriteHorizontalDoorTransferRecords:
02:00043A6E 102C0055        	  6062:     move.b  ($0055,A4),D0
02:00043A72 19400002        	  6063:     move.b  D0,($0002,A4)
02:00043A76 6100F9A4        	  6064:     jsr     FindDoorAttrByDoorBit
02:00043A7A 0C000005        	  6065:     cmpi.b  #$05,D0
02:00043A7E 650C            	  6066:     bcs  _anon_z05_125
02:00043A80 1B00            	  6067:     move.b  D0,-(A5)  ; PHA
02:00043A82 7004            	  6068:     moveq   #4,D0
02:00043A84 4EB900030ACE    	  6069:     jsr     PlaySample
02:00043A8A 101D            	  6070:     move.b  (A5)+,D0  ; PLA
                            	  6071: _anon_z05_125:
                            	  6072:     ; Calculate the door face index in three parts.
                            	  6073:     ;
                            	  6074:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6075:     ; (provisional face index in Y register).
                            	  6076:     ;
02:00043A8C 0C000004        	  6077:     cmpi.b  #$04,D0
02:00043A90 6602            	  6078:     bne  _anon_z05_126
02:00043A92 7008            	  6079:     moveq   #8,D0
                            	  6080: _anon_z05_126:
02:00043A94 0C000001        	  6081:     cmpi.b  #$01,D0
02:00043A98 6602            	  6082:     bne  _anon_z05_127
02:00043A9A 7004            	  6083:     moveq   #4,D0
                            	  6084: _anon_z05_127:
                            	  6085:     ; Second, subtract 3 from provisional face index.
                            	  6086:     ;
02:00043A9C 003C0011        	  6087:     ori     #$11,CCR  ; SEC: set C+X
02:00043AA0 123C0003        	  6088:     move.b  #$03,D1
02:00043AA4 0A3C0010        	  6089:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043AA8 9101            	  6090:     subx.b  D1,D0   ; SBC #$03
02:00043AAA 0A3C0010        	  6091:     eori    #$10,CCR  ; restore X = 6502 C
02:00043AAE 7600            	  6092:     moveq   #0,D3
02:00043AB0 1600            	  6093:     move.b  D0,D3
                            	  6094:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6095:     ; face index >= 3, then subtract 1 from it.
                            	  6096:     ;
                            	  6097:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6098:     ; then make it 1.
                            	  6099:     ;
02:00043AB2 102C0008        	  6100:     move.b  ($0008,A4),D0
02:00043AB6 6708            	  6101:     beq  _anon_z05_128
02:00043AB8 0C030005        	  6102:     cmpi.b  #$05,D3
02:00043ABC 670A            	  6103:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043ABE 7601            	  6104:     moveq   #1,D3
                            	  6105: _anon_z05_128:
02:00043AC0 0C030003        	  6106:     cmpi.b  #$03,D3
02:00043AC4 6502            	  6107:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043AC6 5303            	  6108:     subq.b  #1,D3
                            	  6109:     even
                            	  6110: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6111:     ; The routine that returned the door type also returned its
                            	  6112:     ; reverse direction index in [03].
                            	  6113:     ;
                            	  6114:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6115:     ;
02:00043AC8 7003            	  6116:     moveq   #3,D0
02:00043ACA 003C0011        	  6117:     ori     #$11,CCR  ; SEC: set C+X
02:00043ACE 122C0003        	  6118:     move.b  ($0003,A4),D1
02:00043AD2 0A3C0010        	  6119:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043AD6 9101            	  6120:     subx.b  D1,D0   ; SBC $03
02:00043AD8 0A3C0010        	  6121:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6122:     ; Call this to put the address of door face tiles in [02:03].
                            	  6123:     ;
02:00043ADC 6100FD7A        	  6124:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6125:     ; Return the address of the door in the nametable in [01:00].
                            	  6126:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6127:     ;
02:00043AE0 41F9000438B6    	  6128:     lea     (DoorVramAddrsHi).l,A0
02:00043AE6 10302000        	  6129:     move.b  (A0,D2.W),D0
02:00043AEA 1880            	  6130:     move.b  D0,($0000,A4)
02:00043AEC 41F9000438BA    	  6131:     lea     (DoorVramAddrsLo).l,A0
02:00043AF2 10302000        	  6132:     move.b  (A0,D2.W),D0
02:00043AF6 19400001        	  6133:     move.b  D0,($0001,A4)
                            	  6134:     ; Return the direction of the door in [09], and the dynamic
                            	  6135:     ; transfer buf length in X register.
                            	  6136:     ;
02:00043AFA 19420009        	  6137:     move.b  D2,($0009,A4)
02:00043AFE 7400            	  6138:     moveq   #0,D2
02:00043B00 142C0301        	  6139:     move.b  ($0301,A4),D2
                            	  6140:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6141:     ;
02:00043B04 7000            	  6142:     moveq   #0,D0
02:00043B06 19400007        	  6143:     move.b  D0,($0007,A4)
02:00043B0A 7002            	  6144:     moveq   #2,D0
02:00043B0C 19400006        	  6145:     move.b  D0,($0006,A4)
02:00043B10 19400005        	  6146:     move.b  D0,($0005,A4)
02:00043B14 0A3C0001        	  6147:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043B18 4E75            	  6148:     rts
