02:0003E174 41EC0478        	  9914:     lea     ($0478,A4),A0
02:0003E178 10302000        	  9915:     move.b  (A0,D2.W),D0
02:0003E17C 0C000008        	  9916:     cmpi.b  #$08,D0
02:0003E180 66C2            	  9917:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9918:     ; Roll over the eye animation counter to 0.
                            	  9919:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9920:     ;
02:0003E182 7000            	  9921:     moveq   #0,D0
02:0003E184 41EC0478        	  9922:     lea     ($0478,A4),A0
02:0003E188 11802000        	  9923:     move.b  D0,(A0,D2.W)
02:0003E18C 41EC046B        	  9924:     lea     ($046B,A4),A0
02:0003E190 10302000        	  9925:     move.b  (A0,D2.W),D0
02:0003E194 02000001        	  9926:     andi.b #$01,D0
02:0003E198 0A000001        	  9927:     eori.b #$01,D0
                            	  9928:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	  9929:     ;
02:0003E19C 609E            	  9930:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	  9931: 
