                            	   599: 
                            	   600: ;------------------------------------------------------------------------------
                            	   601: ; _c_move_object_shim — MoveObject trampoline.
                            	   602: ;
                            	   603: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   604: ;   Input:     D2 = slot (0..11)
                            	   605: ;   Preserves: D2, A4, A5
                            	   606: ;   Clobbers:  D0, D1, D3, A0
                            	   607: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   608: ;
                            	   609: ; GCC side:
                            	   610: ;   void c_move_object(unsigned short slot);
                            	   611: ;     slot arrives as a 16-bit value on the stack.
                            	   612: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   613: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   614: ;   never clobbered by gcc.
                            	   615: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   616: ;   semantics can exist in a pure C port).
                            	   617: ;------------------------------------------------------------------------------
                            	   618: _c_move_object_shim:
                            	   619:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   620:     move.b  #$AA,($0900,A4)
                            	   621:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   622:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   623:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   624:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   625:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   626:     moveq   #0,D0
02:0002B658 3002            	   627:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   628:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   629:     jsr     c_move_object
02:0002B662 588F            	   630:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   631:     rts
                            	   632: 
                            	   633: ;==============================================================================
                            	   634: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   635: ; and tail-call the native asm function.
                            	   636: ;
                            	   637: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   638: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   639: ; sign-extended).
                            	   640: ;==============================================================================
                            	   641: 
                            	   642: ;------------------------------------------------------------------------------
                            	   643: ; void c_copy_bank_to_window(unsigned int bank);
                            	   644: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   645: ;------------------------------------------------------------------------------
                            	   646: c_copy_bank_to_window:
02:0002B666 202F0004        	   647:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   648:     jmp     _copy_bank_to_window
                            	   649: 
                            	   650: ;------------------------------------------------------------------------------
                            	   651: ; unsigned char c_ppu_read_2(void);
                            	   652: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   653: ; C return: gcc expects result in D0.
                            	   654: ;------------------------------------------------------------------------------
                            	   655: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   656:     jmp     _ppu_read_2
                            	   657: 
                            	   658: ;------------------------------------------------------------------------------
                            	   659: ; void c_ppu_write_6(unsigned int val);
                            	   660: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   661: ;------------------------------------------------------------------------------
                            	   662: c_ppu_write_6:
02:0002B674 202F0004        	   663:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   664:     jmp     _ppu_write_6
                            	   665: 
                            	   666: ;------------------------------------------------------------------------------
                            	   667: ; void c_ppu_write_7(unsigned int val);
                            	   668: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   669: ;------------------------------------------------------------------------------
                            	   670: c_ppu_write_7:
02:0002B67E 202F0004        	   671:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   672:     jmp     _ppu_write_7
                            	   673: 
                            	   674: ;------------------------------------------------------------------------------
                            	   675: ; void c_turn_off_all_video(void);
                            	   676: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   677: ;------------------------------------------------------------------------------
                            	   678: c_turn_off_all_video:
02:0002B688 4EF90004AA80    	   679:     jmp     TurnOffAllVideo
                            	   680: 
                            	   681: ;==============================================================================
                            	   682: ; EXPORT side — z_03 entry point.
                            	   683: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   684: ; the transpiler emits that label pointing to this shim instead of the
                            	   685: ; z_03 asm body. The C function takes no args and returns void.
                            	   686: ;==============================================================================
                            	   687: 
                            	   688: ;------------------------------------------------------------------------------
                            	   689: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   690: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
