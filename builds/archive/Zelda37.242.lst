02:0003B0D0 11802000        	  3266:     move.b  D0,(A0,D2.W)
                            	  3267:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3268:     ;
02:0003B0D4 10342019        	  3269:     move.b  ($19,A4,D2.W),D0
02:0003B0D8 0C0000C0        	  3270:     cmpi.b  #$C0,D0
02:0003B0DC 6506            	  3271:     bcs  _anon_z04_43
02:0003B0DE 4EB90004BD48    	  3272:     jsr     ReverseObjDir
                            	  3273: _anon_z04_43:
                            	  3274:     ; If facing horizontally, go place the leever to the left or right of Link.
