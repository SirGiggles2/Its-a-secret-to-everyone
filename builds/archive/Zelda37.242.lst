                            	  7357: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7358:     ; Else Link is facing horizontally.
                            	  7359:     ; [04] := (weapon X + 8)
                            	  7360:     ; A    := (weapon Y + 6)
                            	  7361:     ;
                            	  7362:     ; Shouldn't it be based on the weapon's direction?
                            	  7363:     ;
02:000325DE 10343070        	  7364:     move.b  ($70,A4,D3.W),D0
02:000325E2 023C00EE        	  7365:     andi    #$EE,CCR  ; CLC: clear C+X
02:000325E6 123C0008        	  7366:     move.b  #$08,D1
02:000325EA D101            	  7367:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000325EC 19400004        	  7368:     move.b  D0,($0004,A4)
02:000325F0 41EC0084        	  7369:     lea     ($0084,A4),A0
02:000325F4 10303000        	  7370:     move.b  (A0,D3.W),D0
02:000325F8 023C00EE        	  7371:     andi    #$EE,CCR  ; CLC: clear C+X
02:000325FC 123C0006        	  7372:     move.b  #$06,D1
02:00032600 D101            	  7373:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7374: _anon_z01_98:
                            	  7375:     ; The A register will be copied to [05] and used here.
                            	  7376:     ;
02:00032602 6000FC0C        	  7377:     jmp     CheckMonsterWeaponCollision
                            	  7378: 
                            	  7379: ; Params:
                            	  7380: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7381: ; [00]: weapon object slot (unused)
                            	  7382: ; [02]: object 1 mid X
                            	  7383: ; [03]: object 1 mid Y
                            	  7384: ; [04]: object 2 mid X
                            	  7385: ; [05]: object 2 mid Y
                            	  7386: ;
                            	  7387: ; Returns:
                            	  7388: ; A: 1 if objects collide
                            	  7389: ; Y: weapon object slot
                            	  7390: ; Z: 0 if objects collide
                            	  7391: ; [06]: 1 if objects collide
                            	  7392: ; [0A]: horizontal distance
                            	  7393: ; [0B]: vertical distance
                            	  7394: ;
                            	  7395: ;
                            	  7396: ; Use the same threshold value horizontally and vertically.
                            	  7397: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7398: ;
                            	  7399:     even
                            	  7400: DoObjectsCollide:
02:00032606 1940000D        	  7401:     move.b  D0,($000D,A4)
02:0003260A 1940000E        	  7402:     move.b  D0,($000E,A4)
                            	  7403: ; Params:
                            	  7404: ; [00]: weapon or Link object slot (unused)
                            	  7405: ; [02]: object 1 mid X
                            	  7406: ; [03]: object 1 mid Y
                            	  7407: ; [04]: object 2 mid X
                            	  7408: ; [05]: object 2 mid Y
                            	  7409: ; [0D]: horizontal threshold
                            	  7410: ; [0E]: vertical threshold
                            	  7411: ;
                            	  7412: ; Returns:
                            	  7413: ; A: 1 if objects collide
                            	  7414: ; Y: weapon or Link object slot (copied from [00])
                            	  7415: ; Z: 0 if objects collide
                            	  7416: ; [06]: 1 if objects collide
                            	  7417: ; [0A]: horizontal distance
                            	  7418: ; [0B]: vertical distance
                            	  7419: ;
                            	  7420: ;
                            	  7421: ; Reset [06] to indicate no collision by default.
                            	  7422: ;
                            	  7423:     even
                            	  7424: DoObjectsCollideWithThresholds:
02:0003260E 60009AB0        	  7425:     jmp     c_do_objects_collide_with_thresholds
