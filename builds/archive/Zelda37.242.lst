02:000421EE B001            	  4083:     cmp.b   D1,D0
02:000421F0 6622            	  4084:     bne  _anon_z05_95
02:000421F2 102C0001        	  4085:     move.b  ($0001,A4),D0
02:000421F6 41F9000421C2    	  4086:     lea     (DoorwayBoundsMinOver).l,A0
02:000421FC 12303000        	  4087:     move.b  (A0,D3.W),D1
02:00042200 B001            	  4088:     cmp.b   D1,D0
02:00042202 6510            	  4089:     bcs  _anon_z05_95
02:00042204 41F9000421C6    	  4090:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004220A 12303000        	  4091:     move.b  (A0,D3.W),D1
02:0004220E B001            	  4092:     cmp.b   D1,D0
02:00042210 65000082        	  4093:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4094: _anon_z05_95:
02:00042214 5303            	  4095:     subq.b  #1,D3
02:00042216 6ACA            	  4096:     bpl  _L_z05_CheckDoorway_LoopOverflowBounds
                            	  4097:     even
                            	  4098: _L_z05_CheckDoorway_NotInDoorway:
                            	  4099:     ; Not in any doorway. Reset DoorwayDir.
                            	  4100:     ; Leave [0F] moving direction as is.
                            	  4101:     ;
02:00042218 7000            	  4102:     moveq   #0,D0
02:0004221A 19400053        	  4103:     move.b  D0,($0053,A4)
