                            	  5126: _L_z07_SpreadShot_NextCorner:
                            	  5127:     ; Prepare to process the next corner.
                            	  5128:     ;
                            	  5129:     ; First, restore X offset [02] and Y offset [03].
                            	  5130:     ;
02:0004C224 101D            	  5131:     move.b  (A5)+,D0  ; PLA
