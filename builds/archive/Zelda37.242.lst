                            	 14004: ; Params:
                            	 14005: ; A: high bits of cosine to use in calculating Y increment
                            	 14006: ; Y: high bits of sine to use in calculating X increment
                            	 14007: ; X: object index
                            	 14008: ;
                            	 14009: ; Returns:
                            	 14010: ; A: new Y coordinate of object
                            	 14011: ;
                            	 14012: ; [06] holds the number of high bits of cosine to use
                            	 14013:     even
                            	 14014: RotateObjectLocation:
02:0003FEB6 19400006        	 14015:     move.b  D0,($0006,A4)
02:0003FEBA 19430005        	 14016:     move.b  D3,($0005,A4)
                            	 14017:     ; First, rotate the X coordinate.
                            	 14018:     ;
                            	 14019:     ; Look up the sine for the current angle, and store it in [00].
                            	 14020:     ;
02:0003FEBE 41EC0394        	 14021:     lea     ($0394,A4),A0
02:0003FEC2 10302000        	 14022:     move.b  (A0,D2.W),D0
02:0003FEC6 0200000F        	 14023:     andi.b #$0F,D0
02:0003FECA 7600            	 14024:     moveq   #0,D3
02:0003FECC 1600            	 14025:     move.b  D0,D3
02:0003FECE 41F90003FEA6    	 14026:     lea     (PatraSines).l,A0
02:0003FED4 10303000        	 14027:     move.b  (A0,D3.W),D0
02:0003FED8 1880            	 14028:     move.b  D0,($0000,A4)
                            	 14029:     ; Mutliply q-speed by [00].
                            	 14030:     ;
                            	 14031:     ; Q-speed has the default value $20 set when entering the room.
                            	 14032:     ;
02:0003FEDA 41EC03BC        	 14033:     lea     ($03BC,A4),A0
02:0003FEDE 10302000        	 14034:     move.b  (A0,D2.W),D0
02:0003FEE2 7600            	 14035:     moveq   #0,D3
02:0003FEE4 162C0005        	 14036:     move.b  ($0005,A4),D3
02:0003FEE8 61000136        	 14037:     jsr     ShiftMultiply
                            	 14038:     ; The absolute X increment for the current angle is now in [02:03].
                            	 14039:     ;
                            	 14040:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 14041:     ;
02:0003FEEC 41EC0394        	 14042:     lea     ($0394,A4),A0
02:0003FEF0 10302000        	 14043:     move.b  (A0,D2.W),D0
02:0003FEF4 02000018        	 14044:     andi.b #$18,D0
02:0003FEF8 0C000010        	 14045:     cmpi.b  #$10,D0
02:0003FEFC 6536            	 14046:     bcs  _L_z04_RotateObjectLocation_AddToX
                            	 14047:     ; Subtract the product's fraction from the X coordinate fraction.
                            	 14048:     ;
02:0003FEFE 41EC0412        	 14049:     lea     ($0412,A4),A0
02:0003FF02 10302000        	 14050:     move.b  (A0,D2.W),D0
02:0003FF06 003C0011        	 14051:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF0A 122C0002        	 14052:     move.b  ($0002,A4),D1
02:0003FF0E 0A3C0010        	 14053:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF12 9101            	 14054:     subx.b  D1,D0   ; SBC $02
02:0003FF14 0A3C0010        	 14055:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF18 41EC0412        	 14056:     lea     ($0412,A4),A0
02:0003FF1C 11802000        	 14057:     move.b  D0,(A0,D2.W)
                            	 14058:     ; And subtract the product's whole part from the X coordinate with carry.
                            	 14059:     ;
02:0003FF20 10342070        	 14060:     move.b  ($70,A4,D2.W),D0
02:0003FF24 122C0003        	 14061:     move.b  ($0003,A4),D1
02:0003FF28 0A3C0010        	 14062:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF2C 9101            	 14063:     subx.b  D1,D0   ; SBC $03
02:0003FF2E 0A3C0010        	 14064:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF32 6024            	 14065:     jmp     _L_z04_RotateObjectLocation_SetXRotateY
                            	 14066: 
