02:0004C5EE 7000            	  5714:     moveq   #0,D0
02:0004C5F0 41EC00AC        	  5715:     lea     ($00AC,A4),A0
02:0004C5F4 11803000        	  5716:     move.b  D0,(A0,D3.W)
02:0004C5F8 0A3C0001        	  5717:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C5FC 4E75            	  5718:     rts
                            	  5719: 
                            	  5720:     even
