02:0003F0D2 41EC0084        	 11963:     lea     ($0084,A4),A0
02:0003F0D6 10302000        	 11964:     move.b  (A0,D2.W),D0
02:0003F0DA 122C04E6        	 11965:     move.b  ($04E6,A4),D1
02:0003F0DE D101            	 11966:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003F0E0 41EC0084        	 11967:     lea     ($0084,A4),A0
02:0003F0E4 11802000        	 11968:     move.b  D0,(A0,D2.W)
