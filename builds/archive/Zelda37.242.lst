02:0003DF36 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003DF3A 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003DF3E 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003DF42 E309            	  9632:     lsl.b  #1,D1   ; ASL $02
02:0003DF44 19410002        	  9633:     move.b  D1,($0002,A4)
02:0003DF48 122C0002        	  9634:     move.b  ($0002,A4),D1
02:0003DF4C C200            	  9635:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF4E 671E            	  9636:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DF50 41EC0084        	  9637:     lea     ($0084,A4),A0
02:0003DF54 10302000        	  9638:     move.b  (A0,D2.W),D0
02:0003DF58 122C0003        	  9639:     move.b  ($0003,A4),D1
02:0003DF5C 0A3C0010        	  9640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DF60 9101            	  9641:     subx.b  D1,D0   ; SBC $03
02:0003DF62 0A3C0010        	  9642:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DF66 41EC0084        	  9643:     lea     ($0084,A4),A0
02:0003DF6A 11802000        	  9644:     move.b  D0,(A0,D2.W)
                            	  9645:     even
                            	  9646: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9647:     ; To the frame accumulator, add:
                            	  9648:     ; - a random value between 0 and 3
                            	  9649:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9650:     ;
02:0003DF6E 10342019        	  9651:     move.b  ($19,A4,D2.W),D0
02:0003DF72 02000003        	  9652:     andi.b #$03,D0
02:0003DF76 023C00EE        	  9653:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF7A 122C0003        	  9654:     move.b  ($0003,A4),D1
02:0003DF7E D101            	  9655:     addx.b  D1,D0   ; ADC $03
02:0003DF80 41EC0451        	  9656:     lea     ($0451,A4),A0
02:0003DF84 12302000        	  9657:     move.b  (A0,D2.W),D1
02:0003DF88 D101            	  9658:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DF8A 41EC0451        	  9659:     lea     ($0451,A4),A0
