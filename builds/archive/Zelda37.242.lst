                            	  6444: __far_z_01_0060:
                            	  6445:     ; They collide. Now find out how they collide.
                            	  6446:     ;
                            	  6447:     ; If it's a regular monster, go harm Link.
                            	  6448:     ;
02:00032020 41EC034F        	  6449:     lea     ($034F,A4),A0
02:00032024 10302000        	  6450:     move.b  (A0,D2.W),D0
02:00032028 0C000053        	  6451:     cmpi.b  #$53,D0
02:0003202C 6402            	  6452:     bcc.s  __far_z_01_0061
02:0003202E 607C            	  6453:     jmp  HarmLink
                            	  6454: __far_z_01_0061:
                            	  6455:     ; Here, the attacker is a monster's shot/projectile.
                            	  6456:     ; Flag this kind of collision.
                            	  6457:     ;
02:00032030 522C034B        	  6458:     addq.b  #1,($034B,A4)
