02:000307B8 7600            	  3079:     moveq   #0,D3
02:000307BA 16342070        	  3080:     move.b  ($70,A4,D2.W),D3
02:000307BE 7078            	  3081:     moveq   #120,D0
02:000307C0 1880            	  3082:     move.b  D0,($0000,A4)
02:000307C2 41EC0098        	  3083:     lea     ($0098,A4),A0
02:000307C6 10302000        	  3084:     move.b  (A0,D2.W),D0
02:000307CA 0200000C        	  3085:     andi.b #$0C,D0
02:000307CE 6710            	  3086:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3087:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3088:     ; and current coordinate to the trap's Y.
                            	  3089:     ;
02:000307D0 7600            	  3090:     moveq   #0,D3
02:000307D2 41EC0084        	  3091:     lea     ($0084,A4),A0
02:000307D6 16302000        	  3092:     move.b  (A0,D2.W),D3
02:000307DA 103C0090        	  3093:     move.b  #$90,D0
