02:0003D026 0C000002        	  7631:     cmpi.b  #$02,D0
02:0003D02A 6604            	  7632:     bne  _anon_z04_94
02:0003D02C 522C000F        	  7633:     addq.b  #1,($000F,A4)
                            	  7634: _anon_z04_94:
                            	  7635:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7636:     ; This is the base frame image.
