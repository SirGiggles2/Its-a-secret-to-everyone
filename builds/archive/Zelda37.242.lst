                            	  2140: ;==============================================================================
                            	  2141: ; EXPORT side — carry-returning shims.
                            	  2142: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2143: ; reproduces the original function's carry normalization.
                            	  2144: ;==============================================================================
                            	  2145: 
                            	  2146: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2147: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2148:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2149:     btst    #8,D0
02:0002BF8E 670A            	  2150:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2151:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2152:     eori    #$01,CCR
02:0002BF98 4E75            	  2153:     rts
                            	  2154: .cc_cnr:
02:0002BF9A 023C00FE        	  2155:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2156:     eori    #$01,CCR
02:0002BFA2 4E75            	  2157:     rts
                            	  2158: 
                            	  2159: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2160: c_copy_next_row_advance_submode:
02:0002BFA4 4EB900000000    	  2161:     jsr     z05_copy_next_row_advance_submode
02:0002BFAA 08000008        	  2162:     btst    #8,D0
02:0002BFAE 670A            	  2163:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2164:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2165:     eori    #$01,CCR
02:0002BFB8 4E75            	  2166:     rts
                            	  2167: .cc_cnras:
02:0002BFBA 023C00FE        	  2168:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2169:     eori    #$01,CCR
02:0002BFC2 4E75            	  2170:     rts
                            	  2171: 
                            	  2172: ; IsQuestSecretMismatch — no args. Returns carry in bit 8.
                            	  2173: c_is_quest_secret_mismatch:
02:0002BFC4 4EB900000000    	  2174:     jsr     z04_is_quest_secret_mismatch
02:0002BFCA 08000008        	  2175:     btst    #8,D0
02:0002BFCE 670A            	  2176:     beq.s   .cc_iqsm
02:0002BFD0 003C0001        	  2177:     ori     #$01,CCR
02:0002BFD4 0A3C0001        	  2178:     eori    #$01,CCR
