02:0004226A B001            	  4149:     cmp.b   D1,D0
02:0004226C 6620            	  4150:     bne  _anon_z05_96
02:0004226E 102C0001        	  4151:     move.b  ($0001,A4),D0
02:00042272 41F9000421CA    	  4152:     lea     (DoorwayBoundsMinUnder).l,A0
02:00042278 12303000        	  4153:     move.b  (A0,D3.W),D1
02:0004227C B001            	  4154:     cmp.b   D1,D0
02:0004227E 650E            	  4155:     bcs  _anon_z05_96
02:00042280 41F9000421CE    	  4156:     lea     (DoorwayBoundsMaxUnder).l,A0
02:00042286 12303000        	  4157:     move.b  (A0,D3.W),D1
02:0004228A B001            	  4158:     cmp.b   D1,D0
02:0004228C 6506            	  4159:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4160: _anon_z05_96:
02:0004228E 5303            	  4161:     subq.b  #1,D3
02:00042290 6ACC            	  4162:     bpl  _L_z05_CheckDoorway_LoopUnderflowDoorway
