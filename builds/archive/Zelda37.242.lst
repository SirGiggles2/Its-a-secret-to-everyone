                            	  3677: DrawGhiniAndCheckCollisions:
02:0003B3D4 4EB90004CE68    	  3678:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B3DA 1940000D        	  3679:     move.b  D0,($000D,A4)
                            	  3680:     ; If the direction has an "up" component, then keep the
                            	  3681:     ; frame image 0, and go figure out horizontal flipping.
                            	  3682:     ;
02:0003B3DE 41EC0098        	  3683:     lea     ($0098,A4),A0
02:0003B3E2 10302000        	  3684:     move.b  (A0,D2.W),D0
02:0003B3E6 02000008        	  3685:     andi.b #$08,D0
02:0003B3EA 6614            	  3686:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3687:     ; Else make the frame image 1 for the "down" frame.
                            	  3688:     ; Note that this is the frame image to use, even if there's no
                            	  3689:     ; down component in the direction.
                            	  3690:     ;
02:0003B3EC 522C000D        	  3691:     addq.b  #1,($000D,A4)
                            	  3692:     ; If right is a component of the direction, then go set horizontal
                            	  3693:     ; flipping. Else leave horizontal flipping = 0.
                            	  3694:     ;
02:0003B3F0 41EC0098        	  3695:     lea     ($0098,A4),A0
02:0003B3F4 10302000        	  3696:     move.b  (A0,D2.W),D0
02:0003B3F8 02000001        	  3697:     andi.b #$01,D0
02:0003B3FC 6714            	  3698:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B3FE 660E            	  3699:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3700:     even
                            	  3701: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3702:     ; Set horizontal flipping if right is a direction component.
                            	  3703:     ; This essentially the same test as above, but for when we jump
                            	  3704:     ; from the "up" test.
                            	  3705:     ;
02:0003B400 41EC0098        	  3706:     lea     ($0098,A4),A0
02:0003B404 10302000        	  3707:     move.b  (A0,D2.W),D0
02:0003B408 02000002        	  3708:     andi.b #$02,D0
02:0003B40C 6704            	  3709:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3710:     even
                            	  3711: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B40E 522C000F        	  3712:     addq.b  #1,($000F,A4)
                            	  3713:     even
                            	  3714: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B412 102C000D        	  3715:     move.b  ($000D,A4),D0
                            	  3716: ; Params:
                            	  3717: ; A: frame image
                            	  3718: ; X: object index
                            	  3719: ; [00]: object X
                            	  3720: ; [01]: object Y
                            	  3721: ; [0F]: flip horizontally
                            	  3722: ;
                            	  3723: ; Returns:
                            	  3724: ; [00]: 0 for Link slot
                            	  3725: ; [06]: 1 if objects collide
                            	  3726: ; [09]: 0 for Link damage type (none)
                            	  3727: ; [0C]: 1 if objects collide
                            	  3728: ; [034B]: ShotCollidesWithLink
                            	  3729: ;
                            	  3730:     even
                            	  3731: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003B416 4EB900031AB8    	  3732:     jsr     DrawObjectNotMirrored
02:0003B41C 4EF900031F7E    	  3733:     jmp     CheckLinkCollision
                            	  3734: 
                            	  3735:     even
                            	  3736: SecretArmosRoomIds:
02:0003B422 24              	  3737:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B423 0B
02:0003B424 1C
02:0003B425 22
02:0003B426 34
02:0003B427 3D
02:0003B428 4E
                            	  3738: 
                            	  3739:     even
                            	  3740: SecretArmosXs:
02:0003B42A E0              	  3741:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B42B B0
02:0003B42C B0
02:0003B42D 30
02:0003B42E 40
02:0003B42F 90
02:0003B430 A0
                            	  3742: 
                            	  3743:     even
                            	  3744: InitArmosOrFlyingGhini:
                            	  3745:     ; In UpdateObject, this object was flagged "initialized".
                            	  3746:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3747:     ;
02:0003B432 10342028        	  3748:     move.b  ($28,A4,D2.W),D0
02:0003B436 41EC0492        	  3749:     lea     ($0492,A4),A0
02:0003B43A 11802000        	  3750:     move.b  D0,(A0,D2.W)
                            	  3751:     ; If it's still fading in, then go finish some initialization needed
                            	  3752:     ; for fading in.
                            	  3753:     ;
02:0003B43E 660000B6        	  3754:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3755:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3756:     ; go finish initializing it.
                            	  3757:     ;
02:0003B442 41EC034F        	  3758:     lea     ($034F,A4),A0
02:0003B446 10302000        	  3759:     move.b  (A0,D2.W),D0
02:0003B44A 0C000022        	  3760:     cmpi.b  #$22,D0
02:0003B44E 670000A6        	  3761:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3762:     ; Else we have an armos.
                            	  3763:     ;
                            	  3764:     ; Store stairs tile $70 in [00] for use later.
                            	  3765:     ;
02:0003B452 7070            	  3766:     moveq   #112,D0
02:0003B454 1880            	  3767:     move.b  D0,($0000,A4)
                            	  3768:     ; Look for the current room ID in an array of room ID's that
                            	  3769:     ; have armos secrets.
                            	  3770:     ;
02:0003B456 7606            	  3771:     moveq   #6,D3
                            	  3772:     even
                            	  3773: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B458 102C00EB        	  3774:     move.b  ($00EB,A4),D0
                            	  3775:     ; If this element does not match the current room ID, go loop again.
                            	  3776:     ;
02:0003B45C 41F90003B422    	  3777:     lea     (SecretArmosRoomIds).l,A0
02:0003B462 12303000        	  3778:     move.b  (A0,D3.W),D1
02:0003B466 B001            	  3779:     cmp.b   D1,D0
02:0003B468 6648            	  3780:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3781:     ; The secret (usually stairs) is under one of the armoses.
                            	  3782:     ;
                            	  3783:     ; If the armos's X coordinate does not match the one needed
                            	  3784:     ; for the current room in the list, then go loop again.
                            	  3785:     ;
02:0003B46A 10342070        	  3786:     move.b  ($70,A4,D2.W),D0
02:0003B46E 41F90003B42A    	  3787:     lea     (SecretArmosXs).l,A0
02:0003B474 12303000        	  3788:     move.b  (A0,D3.W),D1
02:0003B478 B001            	  3789:     cmp.b   D1,D0
02:0003B47A 6636            	  3790:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3791:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3792:     ;
02:0003B47C 41EC0084        	  3793:     lea     ($0084,A4),A0
02:0003B480 10302000        	  3794:     move.b  (A0,D2.W),D0
02:0003B484 0C000080        	  3795:     cmpi.b  #$80,D0
02:0003B488 6628            	  3796:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3797:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3798:     ;
02:0003B48A 4A03            	  3799:     cmpi.b  #$00,D3
02:0003B48C 662C            	  3800:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3801:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3802:     ; has the power bracelet.
                            	  3803:     ;
                            	  3804:     ; Set up the room item with the armos's coordinates.
                            	  3805:     ;
02:0003B48E 19400097        	  3806:     move.b  D0,($0097,A4)
02:0003B492 10342070        	  3807:     move.b  ($70,A4,D2.W),D0
02:0003B496 19400083        	  3808:     move.b  D0,($0083,A4)
                            	  3809:     ; This resets the room item's state, which activates it.
                            	  3810:     ;
02:0003B49A 194300BF        	  3811:     move.b  D3,($00BF,A4)
                            	  3812:     ; Set the room item ID.
                            	  3813:     ;
02:0003B49E 7014            	  3814:     moveq   #20,D0
02:0003B4A0 194000AB        	  3815:     move.b  D0,($00AB,A4)
                            	  3816:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3817:     ;
                            	  3818:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3819:     ;
                            	  3820:     ; Note that, if the item was already taken, then the room item
                            	  3821:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3822:     ; it will be ignored, because that routine checks whether
                            	  3823:     ; the item was taken.
                            	  3824:     ;
02:0003B4A4 4EB900031460    	  3825:     jsr     GetRoomFlagUWItemState
02:0003B4AA 660A            	  3826:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B4AC 6100069E        	  3827:     jsr     PlaySecretFoundTune
02:0003B4B0 6604            	  3828:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3829:     even
                            	  3830: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3831:     ; Bottom of the loop.
                            	  3832:     ;
