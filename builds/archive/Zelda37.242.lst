02:0003F32A 10302000        	 12281:     move.b  (A0,D2.W),D0
02:0003F32E 6704            	 12282:     beq  _L_z04_PatraChild_State1_Exit
02:0003F330 6100FA94        	 12283:     jsr     SetDeadDummyObjType
                            	 12284:     even
