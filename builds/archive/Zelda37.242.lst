02:0003EDF8 1B00            	 11557:     move.b  D0,-(A5)  ; PHA
                            	 11558:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11559:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11560:     ;
02:0003EDFA 023C00EE        	 11561:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDFE 123C0004        	 11562:     move.b  #$04,D1
02:0003EE02 D101            	 11563:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EE04 19802070        	 11564:     move.b  D0,($70,A4,D2.W)
                            	 11565:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11566:     ; to store in [03].
