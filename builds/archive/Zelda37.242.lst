02:0003AD2E D101            	  2797:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003AD30 7600            	  2798:     moveq   #0,D3
02:0003AD32 1600            	  2799:     move.b  D0,D3
02:0003AD34 41F90003ABE2    	  2800:     lea     (JumperYAccelerations).l,A0
02:0003AD3A 10303000        	  2801:     move.b  (A0,D3.W),D0
02:0003AD3E 7602            	  2802:     moveq   #2,D3
02:0003AD40 61000162        	  2803:     jsr     Jumper_MoveY
                            	  2804:     ; If the facing direction has a left component, then
                            	  2805:     ; subtract 1 from the object's X.
                            	  2806:     ;
                            	  2807:     ; Else add 1.
                            	  2808:     ;
02:0003AD44 163C00FF        	  2809:     move.b  #$FF,D3
02:0003AD48 41EC0098        	  2810:     lea     ($0098,A4),A0
02:0003AD4C 10302000        	  2811:     move.b  (A0,D2.W),D0
02:0003AD50 02000002        	  2812:     andi.b #$02,D0
02:0003AD54 6602            	  2813:     bne  _anon_z04_38
02:0003AD56 7601            	  2814:     moveq   #1,D3
                            	  2815: _anon_z04_38:
