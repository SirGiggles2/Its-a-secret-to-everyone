02:0003C604 1B00            	  6227:     move.b  D0,-(A5)  ; PHA
02:0003C606 41EC034F        	  6228:     lea     ($034F,A4),A0
02:0003C60A 10302000        	  6229:     move.b  (A0,D2.W),D0
