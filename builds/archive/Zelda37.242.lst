                            	  1836:     even
                            	  1837: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1838:     ; Choose a distance to walk depending on the door you
                            	  1839:     ; come out of.
                            	  1840:     ;
                            	  1841:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1842:     ;
                            	  1843:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1844:     ; then you have shorter distance to cover. So use the
                            	  1845:     ; previous value as is to use indexes 0 and 1.
                            	  1846:     ;
                            	  1847:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1848:     ; to get out of the way of the wall or door.
                            	  1849:     ;
02:000411B6 61003910        	  1850:     jsr     GetPassedDoorType
02:000411BA 02000007        	  1851:     andi.b #$07,D0
02:000411BE 6710            	  1852:     beq  _anon_z05_45
02:000411C0 0C000005        	  1853:     cmpi.b  #$05,D0
02:000411C4 670A            	  1854:     beq  _anon_z05_45
02:000411C6 0C000006        	  1855:     cmpi.b  #$06,D0
02:000411CA 6704            	  1856:     beq  _anon_z05_45
02:000411CC 5203            	  1857:     addq.b  #1,D3
02:000411CE 5203            	  1858:     addq.b  #1,D3
                            	  1859: _anon_z05_45:
02:000411D0 41F900040B2C    	  1860:     lea     (EnteringRoomRelativePositions).l,A0
02:000411D6 10303000        	  1861:     move.b  (A0,D3.W),D0
                            	  1862:     even
                            	  1863: _L_z05_InitMode_EnterRoom_PlaceObjects:
02:000411DA 19400394        	  1864:     move.b  D0,($0394,A4)
