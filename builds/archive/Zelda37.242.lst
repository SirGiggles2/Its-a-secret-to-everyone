02:0003E078 19410002        	  9783:     move.b  D1,($0002,A4)
02:0003E07C 122C0002        	  9784:     move.b  ($0002,A4),D1
02:0003E080 C200            	  9785:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E082 6708            	  9786:     beq  _anon_z04_120
02:0003E084 41EC0084        	  9787:     lea     ($0084,A4),A0
02:0003E088 52302000        	  9788:     addq.b  #1,(A0,D2.W)
                            	  9789: _anon_z04_120:
                            	  9790:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9791:     ;
02:0003E08C 122C0002        	  9792:     move.b  ($0002,A4),D1
02:0003E090 E309            	  9793:     lsl.b  #1,D1   ; ASL $02
02:0003E092 19410002        	  9794:     move.b  D1,($0002,A4)
02:0003E096 122C0002        	  9795:     move.b  ($0002,A4),D1
02:0003E09A C200            	  9796:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E09C 6708            	  9797:     beq  _anon_z04_121
02:0003E09E 41EC0084        	  9798:     lea     ($0084,A4),A0
02:0003E0A2 53302000        	  9799:     subq.b  #1,(A0,D2.W)
                            	  9800: _anon_z04_121:
                            	  9801:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9802:     ;
02:0003E0A6 41EC0412        	  9803:     lea     ($0412,A4),A0
02:0003E0AA 10302000        	  9804:     move.b  (A0,D2.W),D0
02:0003E0AE 0C000020        	  9805:     cmpi.b  #$20,D0
