02:00039B26 102C0061        	   243:     move.b  ($0061,A4),D0
02:00039B2A 003C0011        	   244:     ori     #$11,CCR  ; SEC: set C+X
02:00039B2E 12342070        	   245:     move.b  ($70,A4,D2.W),D1
02:00039B32 0A3C0010        	   246:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039B36 9101            	   247:     subx.b  D1,D0   ; SBC ObjX,X
02:00039B38 0A3C0010        	   248:     eori    #$10,CCR  ; restore X = 6502 C
