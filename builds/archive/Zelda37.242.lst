02:0004AD24 0C000002        	  2123:     cmpi.b  #$02,D0
02:0004AD28 66DE            	  2124:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AD2A 7620            	  2125:     moveq   #32,D3
