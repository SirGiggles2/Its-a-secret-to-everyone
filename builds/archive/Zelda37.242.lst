02:0002E73E 660000D8        	   748:     bne  _L_z01_UpdatePersonState_Textbox_Exit
                            	   749:     ; Set the timer to wait 6 frames after the next character about
                            	   750:     ; to be shown.
                            	   751:     ;
02:0002E742 7006            	   752:     moveq   #6,D0
02:0002E744 19400029        	   753:     move.b  D0,($0029,A4)
                            	   754:     ; Copy the 5 bytes of the textbox character transfer record template
                            	   755:     ; to the dynamic transfer buf.
