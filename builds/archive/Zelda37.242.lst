02:00041CFE 7601            	  3378:     moveq   #1,D3
02:00041D00 102C0070        	  3379:     move.b  ($0070,A4),D0
02:00041D04 0C000050        	  3380:     cmpi.b  #$50,D0
02:00041D08 6712            	  3381:     beq  _anon_z05_83
02:00041D0A 5203            	  3382:     addq.b  #1,D3
02:00041D0C 0C000080        	  3383:     cmpi.b  #$80,D0
02:00041D10 670A            	  3384:     beq  _anon_z05_83
02:00041D12 5203            	  3385:     addq.b  #1,D3
