02:0003AD5A 023C00EE        	  2817:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD5E 12342070        	  2818:     move.b  ($70,A4,D2.W),D1
02:0003AD62 D101            	  2819:     addx.b  D1,D0   ; ADC ObjX,X
