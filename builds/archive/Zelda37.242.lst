                            	   954: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_PickedUp:
                            	   955:     ; Store the index of the item chosen.
                            	   956:     ;
02:0002E89C 19420438        	   957:     move.b  D2,($0438,A4)
                            	   958:     ; If hint and money game cave flags are missing, then
                            	   959:     ; go take an item given away, or buy it.
