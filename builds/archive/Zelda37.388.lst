02:00039768 194303F8        	  3300:     move.b  D3,($03F8,A4)
                            	  3301:     ; Save and reset Link's state.
                            	  3302:     ;
                            	  3303:     ; TODO: but why, since Link is halted?
                            	  3304:     ;
02:0003976C 102C00AC        	  3305:     move.b  ($00AC,A4),D0
02:00039770 1B00            	  3306:     move.b  D0,-(A5)  ; PHA
02:00039772 194300AC        	  3307:     move.b  D3,($00AC,A4)
02:00039776 4EB900048EEC    	  3308:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  3309:     ; Restore Link's state.
                            	  3310:     ;
