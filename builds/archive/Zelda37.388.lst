                            	  5179: UpdateBoomerangOrFood:
                            	  5180:     ; If state = 0, then not active. So, return.
                            	  5181:     ;
02:000493EE 41EC00AC        	  5182:     lea     ($00AC,A4),A0
02:000493F2 10302000        	  5183:     move.b  (A0,D2.W),D0
02:000493F6 6602            	  5184:     bne.s  __far_z_07_0078
02:000493F8 60F2            	  5185:     jmp  L1F49F_Exit
                            	  5186: __far_z_07_0078:
                            	  5187:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5188:     ;
02:000493FA E308            	  5189:     lsl.b  #1,D0   ; ASL A
02:000493FC 6504            	  5190:     bcs.s  __far_z_07_0079
02:000493FE 600000AA        	  5191:     jmp  UpdateArrowOrBoomerang
                            	  5192: __far_z_07_0079:
                            	  5193:     ; The object is food.
                            	  5194:     ;
                            	  5195:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5196:     ; If we reach state $83, then go deactivate the object.
                            	  5197:     ;
                            	  5198:     ; Nothing changes between the states. So, they are used as
                            	  5199:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5200:     ;
02:00049402 10342028        	  5201:     move.b  ($28,A4,D2.W),D0
02:00049406 6622            	  5202:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:00049408 41EC00AC        	  5203:     lea     ($00AC,A4),A0
02:0004940C 52302000        	  5204:     addq.b  #1,(A0,D2.W)
02:00049410 41EC00AC        	  5205:     lea     ($00AC,A4),A0
02:00049414 10302000        	  5206:     move.b  (A0,D2.W),D0
02:00049418 0200000F        	  5207:     andi.b #$0F,D0
02:0004941C 0C000003        	  5208:     cmpi.b  #$03,D0
02:00049420 674C            	  5209:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:00049422 103C00FF        	  5210:     move.b  #$FF,D0
02:00049426 19802028        	  5211:     move.b  D0,($28,A4,D2.W)
                            	  5212:     even
                            	  5213: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5214:     ; If the template object type in the room is one of:
                            	  5215:     ; moblin, goriya, octorock, vire, keese
                            	  5216:     ; then attract these monsters to the food.
                            	  5217:     ;
                            	  5218:     ; They will chase the food instead of Link when given a chance.
                            	  5219:     ;
02:0004942A 102C035F        	  5220:     move.b  ($035F,A4),D0
02:0004942E 0C000003        	  5221:     cmpi.b  #$03,D0
02:00049432 652C            	  5222:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:00049434 0C00000B        	  5223:     cmpi.b  #$0B,D0
02:00049438 6512            	  5224:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:0004943A 0C000012        	  5225:     cmpi.b  #$12,D0
02:0004943E 670C            	  5226:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:00049440 0C00001B        	  5227:     cmpi.b  #$1B,D0
02:00049444 6706            	  5228:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
