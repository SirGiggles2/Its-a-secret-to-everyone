02:0003ADEE 123C0038        	  6367:     move.b  #$38,D1
02:0003ADF2 D101            	  6368:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003ADF4 41EC0444        	  6369:     lea     ($0444,A4),A0
02:0003ADF8 11802000        	  6370:     move.b  D0,(A0,D2.W)
                            	  6371:     ; Add Carry to high speed byte (vertical).
