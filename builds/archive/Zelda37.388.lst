                            	  7726: Submenu_CueTransferRowOW:
                            	  7727:     ;
                            	  7728:     ;
                            	  7729:     ; If menu scroll value is negative, then we transferred everything.
                            	  7730:     ; So, return.
                            	  7731:     ;
02:00041E0E 102C005E        	  7732:     move.b  ($005E,A4),D0
