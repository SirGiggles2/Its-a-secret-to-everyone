                            	  4540: _L_z02_UpdateMode13WinGame_Sub0_Flash_AdvanceSubmode:
                            	  4541:     ; Play the ending song.
                            	  4542:     ;
02:00034E34 7010            	  4543:     moveq   #16,D0
02:00034E36 19400600        	  4544:     move.b  D0,($0600,A4)
                            	  4545:     ; Wait $40 frames at the beginning of the next mode
