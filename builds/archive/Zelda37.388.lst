                            	  3508:     ; The object faces vertically.
                            	  3509:     ;
                            	  3510:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3511:     ;
02:00048946 02000003        	  3512:     andi.b #$03,D0
02:0004894A 671E            	  3513:     beq  _L_z07_Obj_Shove_Exit
                            	  3514:     even
