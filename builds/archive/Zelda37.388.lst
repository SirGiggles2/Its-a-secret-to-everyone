                            	  9234: __far_z_04_0098:
                            	  9235:     ; State = 0.
                            	  9236:     ;
                            	  9237:     ; If the current object slot is 2, then go initialize the patra child.
                            	  9238:     ; This is the only patra child shown in the first fame.
                            	  9239:     ;
02:0003C3DC 0C020002        	  9240:     cmpi.b  #$02,D2
02:0003C3E0 6732            	  9241:     beq  _L_z04_UpdatePatraChild_Ready
                            	  9242:     ; The patra child in slot 2 is the last one to be updated.
                            	  9243:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  9244:     ;
                            	  9245:     ; This means that in the first frame, slot 2 is the only one to be
                            	  9246:     ; shown.
                            	  9247:     ;
02:0003C3E2 102C00AE        	  9248:     move.b  ($00AE,A4),D0
02:0003C3E6 6700008E        	  9249:     beq  _L_z04_UpdatePatraChild_Exit
                            	  9250:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  9251:     ; here to wait to be shown at the top position (N) one at a time.
                            	  9252:     ;
02:0003C3EA 1002            	  9253:     move.b  D2,D0
                            	  9254:     ; Subtract 3 from the object slot to get the angle where the
                            	  9255:     ; patra child in object slot 2 should be for the current one to appear.
                            	  9256:     ;
02:0003C3EC 003C0011        	  9257:     ori     #$11,CCR  ; SEC: set C+X
02:0003C3F0 123C0003        	  9258:     move.b  #$03,D1
02:0003C3F4 0A3C0010        	  9259:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C3F8 9101            	  9260:     subx.b  D1,D0   ; SBC #$03
02:0003C3FA 0A3C0010        	  9261:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C3FE 7600            	  9262:     moveq   #0,D3
02:0003C400 1600            	  9263:     move.b  D0,D3
                            	  9264:     ; If the patra child in slot 2 has not reached the required angle,
                            	  9265:     ; then return.
                            	  9266:     ;
02:0003C402 102C0396        	  9267:     move.b  ($0396,A4),D0
02:0003C406 41F90003C3C0    	  9268:     lea     (PatraChildStartAngles).l,A0
02:0003C40C 12303000        	  9269:     move.b  (A0,D3.W),D1
02:0003C410 B001            	  9270:     cmp.b   D1,D0
02:0003C412 6662            	  9271:     bne  _L_z04_UpdatePatraChild_Exit
                            	  9272:     even
