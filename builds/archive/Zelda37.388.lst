                            	  2972:     ; If it's still fading in, then go finish some initialization needed
                            	  2973:     ; for fading in.
                            	  2974:     ;
02:00039574 660000B6        	  2975:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2976:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2977:     ; go finish initializing it.
