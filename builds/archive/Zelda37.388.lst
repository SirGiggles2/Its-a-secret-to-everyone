                            	  2777:     ; If facing down, then use frame image offset 2.
                            	  2778:     ;
02:00039440 41EC0098        	  2779:     lea     ($0098,A4),A0
02:00039444 10302000        	  2780:     move.b  (A0,D2.W),D0
02:00039448 7600            	  2781:     moveq   #0,D3
02:0003944A 1600            	  2782:     move.b  D0,D3
