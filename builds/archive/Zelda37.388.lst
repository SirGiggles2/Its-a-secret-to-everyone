02:00048D54 10302000        	  4183:     move.b  (A0,D2.W),D0
02:00048D58 02000010        	  4184:     andi.b #$10,D0
02:00048D5C 6702            	  4185:     beq.s  __far_z_07_0051
02:00048D5E 600E            	  4186:     jmp  Reverse
