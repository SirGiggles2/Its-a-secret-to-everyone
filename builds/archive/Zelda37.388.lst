                            	 11144:     ; Look up the sine for the current angle, and store it in [00].
                            	 11145:     ;
02:0003D0B0 41EC0394        	 11146:     lea     ($0394,A4),A0
02:0003D0B4 10302000        	 11147:     move.b  (A0,D2.W),D0
