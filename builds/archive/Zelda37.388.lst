02:0003B9E1 10
                            	  7935: 
                            	  7936: ; Params:
                            	  7937: ; A: eye frame image
                            	  7938: ;
                            	  7939: ; Draw the eye with the frame image passed in.
                            	  7940: ;
                            	  7941:     even
                            	  7942: Gohma_AnimateAndDraw:
02:0003B9E2 1B00            	  7943:     move.b  D0,-(A5)  ; PHA
02:0003B9E4 4EB900049FC6    	  7944:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B9EA 6164            	  7945:     jsr     Gohma_SetSpriteAttributes
