02:00049B58 6404            	  6220:     bcc  _anon_z07_35
02:00049B5A 163C00A0        	  6221:     move.b  #$A0,D3
                            	  6222: _anon_z07_35:
02:00049B5E 1003            	  6223:     move.b  D3,D0
02:00049B60 41EC03BC        	  6224:     lea     ($03BC,A4),A0
