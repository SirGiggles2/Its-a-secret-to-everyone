02:0003A9B0 41F900030C24    	  5804:     lea     (SpriteOffsets).l,A0
02:0003A9B6 10303000        	  5805:     move.b  (A0,D3.W),D0
02:0003A9BA 7600            	  5806:     moveq   #0,D3
02:0003A9BC 1600            	  5807:     move.b  D0,D3
02:0003A9BE 101D            	  5808:     move.b  (A5)+,D0  ; PLA
02:0003A9C0 41EC0201        	  5809:     lea     ($0201,A4),A0
02:0003A9C4 11803000        	  5810:     move.b  D0,(A0,D3.W)
02:0003A9C8 1014            	  5811:     move.b  ($0000,A4),D0
02:0003A9CA 41EC0203        	  5812:     lea     ($0203,A4),A0
02:0003A9CE 11803000        	  5813:     move.b  D0,(A0,D3.W)
02:0003A9D2 102C0001        	  5814:     move.b  ($0001,A4),D0
