02:000382A8 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:000382AA 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:000382AE 6A0C            	   290:     bpl  _anon_z04_8
02:000382B0 4600            	   291:     eori.b #$FF,D0
02:000382B2 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:000382B6 123C0001        	   293:     move.b  #$01,D1
