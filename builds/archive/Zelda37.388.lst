02:0003399E 003C0011        	  2595:     ori     #$11,CCR  ; SEC: set C+X
02:000339A2 123C0008        	  2596:     move.b  #$08,D1
02:000339A6 0A3C0010        	  2597:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000339AA 9101            	  2598:     subx.b  D1,D0   ; SBC #$08
02:000339AC 0A3C0010        	  2599:     eori    #$10,CCR  ; restore X = 6502 C
02:000339B0 7600            	  2600:     moveq   #0,D3
02:000339B2 1600            	  2601:     move.b  D0,D3
02:000339B4 102C0015        	  2602:     move.b  ($0015,A4),D0
