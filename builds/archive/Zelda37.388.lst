                            	  6007: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  6008:     ; Reset horizontal flipping in [0F].
                            	  6009:     ;
02:000499B8 7000            	  6010:     moveq   #0,D0
02:000499BA 1940000F        	  6011:     move.b  D0,($000F,A4)
                            	  6012:     ; If state = 5, return without drawing.
                            	  6013:     ;
02:000499BE 41EC00AC        	  6014:     lea     ($00AC,A4),A0
02:000499C2 10302000        	  6015:     move.b  (A0,D2.W),D0
02:000499C6 0200000F        	  6016:     andi.b #$0F,D0
02:000499CA 7600            	  6017:     moveq   #0,D3
02:000499CC 1600            	  6018:     move.b  D0,D3
02:000499CE 103C00FC        	  6019:     move.b  #$FC,D0
02:000499D2 0C030005        	  6020:     cmpi.b  #$05,D3
02:000499D6 67DE            	  6021:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  6022:     even
                            	  6023: _L_z07_UpdateSwordOrRod_Add4:
                            	  6024:     ; Set [00] to (state - 1) * 4:
                            	  6025:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6026:     ;
02:000499D8 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
02:000499DC 123C0004        	  6028:     move.b  #$04,D1
02:000499E0 D101            	  6029:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000499E2 5303            	  6030:     subq.b  #1,D3
02:000499E4 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:000499E6 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
                            	  6034:     ; since the last frame.
                            	  6035:     ;
02:000499E8 102C0098        	  6036:     move.b  ($0098,A4),D0
02:000499EC 41EC0098        	  6037:     lea     ($0098,A4),A0
02:000499F0 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:000499F4 4EB90003088C    	  6042:     jsr     GetOppositeDir
02:000499FA 1003            	  6043:     move.b  D3,D0
02:000499FC 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A00 1214            	  6045:     move.b  ($0000,A4),D1
02:00049A02 D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:00049A04 7600            	  6047:     moveq   #0,D3
02:00049A06 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:00049A08 102C0070        	  6052:     move.b  ($0070,A4),D0
02:00049A0C 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A10 41F90004993C    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00049A16 12303000        	  6055:     move.b  (A0,D3.W),D1
