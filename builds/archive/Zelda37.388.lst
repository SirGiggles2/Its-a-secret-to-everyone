                            	  5622: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5623:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5624:     ; We need to remember how many tiles need to be copied
                            	  5625:     ; in each transfer record.
                            	  5626:     ;
02:0004095E 102C0006        	  5627:     move.b  ($0006,A4),D0
02:00040962 19400004        	  5628:     move.b  D0,($0004,A4)
                            	  5629:     ; Write the transfer record header for the door.
                            	  5630:     ;
                            	  5631:     ;
                            	  5632:     ; VRAM address high byte of door
02:00040966 1014            	  5633:     move.b  ($0000,A4),D0
02:00040968 41EC0302        	  5634:     lea     ($0302,A4),A0
02:0004096C 11802000        	  5635:     move.b  D0,(A0,D2.W)
02:00040970 5202            	  5636:     addq.b  #1,D2
02:00040972 102C0001        	  5637:     move.b  ($0001,A4),D0
02:00040976 41EC0302        	  5638:     lea     ($0302,A4),A0
02:0004097A 11802000        	  5639:     move.b  D0,(A0,D2.W)
02:0004097E 5202            	  5640:     addq.b  #1,D2
02:00040980 102C0006        	  5641:     move.b  ($0006,A4),D0
02:00040984 41EC0302        	  5642:     lea     ($0302,A4),A0
02:00040988 11802000        	  5643:     move.b  D0,(A0,D2.W)
02:0004098C 5202            	  5644:     addq.b  #1,D2
                            	  5645: _anon_z05_121:
                            	  5646:     ; Write two tiles in a short loop indexed by [04].
                            	  5647:     ;
02:0004098E 6100ED1C        	  5648:     jsr     WriteDoorFaceTileHorizontally
02:00040992 66FA            	  5649:     bne  _anon_z05_121
                            	  5650:     ; OR the low VRAM address with $20 to go down one row
                            	  5651:     ; in order to work on the second row of door tiles.
                            	  5652:     ;
02:00040994 7020            	  5653:     moveq   #32,D0
02:00040996 122C0001        	  5654:     move.b  ($0001,A4),D1
02:0004099A 8001            	  5655:     or.b  D1,D0
02:0004099C 19400001        	  5656:     move.b  D0,($0001,A4)
                            	  5657:     ; Bottom of the loop.
                            	  5658:     ; Loop again to write the second transfer record for the
                            	  5659:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5660:     ;
02:000409A0 532C0005        	  5661:     subq.b  #1,($0005,A4)
02:000409A4 66B8            	  5662:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5663:     ; Write the end marker, and update buffer length.
                            	  5664:     ;
02:000409A6 103C00FF        	  5665:     move.b  #$FF,D0
02:000409AA 41EC0302        	  5666:     lea     ($0302,A4),A0
02:000409AE 11802000        	  5667:     move.b  D0,(A0,D2.W)
02:000409B2 1002            	  5668:     move.b  D2,D0
02:000409B4 19400301        	  5669:     move.b  D0,($0301,A4)
                            	  5670:     ; Increment the command.
                            	  5671:     ;
02:000409B8 522C0054        	  5672:     addq.b  #1,($0054,A4)
                            	  5673:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5674:     ; and resetting the door command.
                            	  5675:     ; This ends up catching original states 3 and 7.
                            	  5676:     ;
                            	  5677:     ; Else set door timer to 8 and return.
                            	  5678:     ;
02:000409BC 102C0054        	  5679:     move.b  ($0054,A4),D0
02:000409C0 02000003        	  5680:     andi.b #$03,D0
02:000409C4 6708            	  5681:     beq  _anon_z05_122
02:000409C6 7008            	  5682:     moveq   #8,D0
02:000409C8 19400027        	  5683:     move.b  D0,($0027,A4)
02:000409CC 4E75            	  5684:     rts
