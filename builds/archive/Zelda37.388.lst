                            	  2221: 
                            	  2222: ; Params:
                            	  2223: ; [00]: Object X
                            	  2224: ; [01]: Object Y
                            	  2225: ; [02]: Left tile
                            	  2226: ; [03]: Right tile
                            	  2227: ; [04]: Left attributes
                            	  2228: ; [05]: Right attributes
                            	  2229: ; [07]: Has two sides
                            	  2230: ; [08]: Cycle sprite index
                            	  2231: ; [0A]: X separation
                            	  2232: ; [0F]: Flip horizontally
                            	  2233: ; [0343]: LeftSpriteOffset
                            	  2234: ; [0344]: RightSpriteOffset
                            	  2235: ;
                            	  2236: ; If [0F] = 0, write the sprite pair with no further processing.
                            	  2237: ;
                            	  2238:     even
                            	  2239: Anim_WriteHorizontallyFlippableSpritePair:
02:00030D3E 102C000F        	  2240:     move.b  ($000F,A4),D0
02:00030D42 6602            	  2241:     bne.s  __far_z_01_0004
02:00030D44 602C            	  2242:     jmp  Anim_WriteSpritePair
                            	  2243: __far_z_01_0004:
                            	  2244:     ; Otherwise, reverse the two sides.
                            	  2245:     ;
02:00030D46 102C0002        	  2246:     move.b  ($0002,A4),D0
02:00030D4A 1B00            	  2247:     move.b  D0,-(A5)  ; PHA
02:00030D4C 102C0003        	  2248:     move.b  ($0003,A4),D0
02:00030D50 19400002        	  2249:     move.b  D0,($0002,A4)
02:00030D54 101D            	  2250:     move.b  (A5)+,D0  ; PLA
02:00030D56 19400003        	  2251:     move.b  D0,($0003,A4)
                            	  2252:     ; Set the horizontal flip sprite attributes.
                            	  2253:     ;
02:00030D5A 102C0004        	  2254:     move.b  ($0004,A4),D0
