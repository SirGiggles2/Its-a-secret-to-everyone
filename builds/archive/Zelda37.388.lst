                            	  1578: _anon_z04_34:
02:00038BB8 7020            	  1579:     moveq   #32,D0
                            	  1580: ; Params:
                            	  1581: ; A: q-speed of the monster
                            	  1582: ; Y: shot object type
                            	  1583: ;
                            	  1584: ; [01] holds the q-speed of the monster
                            	  1585:     even
                            	  1586: _TryShooting:
02:00038BBA 19400001        	  1587:     move.b  D0,($0001,A4)
                            	  1588:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1589:     ;
02:00038BBE 41EC034F        	  1590:     lea     ($034F,A4),A0
02:00038BC2 10302000        	  1591:     move.b  (A0,D2.W),D0
02:00038BC6 0C000003        	  1592:     cmpi.b  #$03,D0
02:00038BCA 6726            	  1593:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BCC 0C000001        	  1594:     cmpi.b  #$01,D0
02:00038BD0 6720            	  1595:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BD2 0C000009        	  1596:     cmpi.b  #$09,D0
02:00038BD6 671A            	  1597:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BD8 0C00000A        	  1598:     cmpi.b  #$0A,D0
02:00038BDC 6714            	  1599:     beq  _L_z04__TryShooting_TryShootingNow
02:00038BDE 41EC0451        	  1600:     lea     ($0451,A4),A0
02:00038BE2 10302000        	  1601:     move.b  (A0,D2.W),D0
02:00038BE6 660A            	  1602:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1603:     ; and a random value < $F8, then return.
                            	  1604:     ;
02:00038BE8 10342018        	  1605:     move.b  ($18,A4,D2.W),D0
02:00038BEC 0C0000F8        	  1606:     cmpi.b  #$F8,D0
02:00038BF0 656C            	  1607:     bcs  _L_z04__TryShooting_Exit
                            	  1608:     even
                            	  1609: _L_z04__TryShooting_TryShootingNow:
                            	  1610:     ; Summary
                            	  1611:     ;
                            	  1612:     ; if temporarily invincible then
                            	  1613:     ;   shoot timer := 0
                            	  1614:     ; elif shoot timer > 0 then
                            	  1615:     ;   decrement shoot timer
                            	  1616:     ; elif wants to shoot then
                            	  1617:     ;   shoot timer := $30
                            	  1618:     ;
                            	  1619:     ; qspeed := [01]
                            	  1620:     ;
                            	  1621:     ; if shoot timer <> 0 then
                            	  1622:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1623:     ;     shoot
                            	  1624:     ;     if succeeded then
                            	  1625:     ;       shoot timer := 0
                            	  1626:     ;       qspeed := 0
                            	  1627:     ;   else
                            	  1628:     ;     qspeed := 0
                            	  1629:     ;
                            	  1630:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038BF2 102C0001        	  1631:     move.b  ($0001,A4),D0
02:00038BF6 1883            	  1632:     move.b  D3,($0000,A4)
02:00038BF8 1B00            	  1633:     move.b  D0,-(A5)  ; PHA
02:00038BFA 7600            	  1634:     moveq   #0,D3
                            	  1635:     ; If not temporarily invincible,
                            	  1636:     ;
02:00038BFC 41EC04F0        	  1637:     lea     ($04F0,A4),A0
02:00038C00 10302000        	  1638:     move.b  (A0,D2.W),D0
02:00038C04 661A            	  1639:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1640:     ; then Y := shoot timer - 1
                            	  1641:     ;
02:00038C06 7600            	  1642:     moveq   #0,D3
02:00038C08 41EC0451        	  1643:     lea     ($0451,A4),A0
02:00038C0C 16302000        	  1644:     move.b  (A0,D2.W),D3
02:00038C10 5303            	  1645:     subq.b  #1,D3
                            	  1646:     ; If Y register < 0, then shoot timer is 0.
                            	  1647:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1648:     ; Else go set a non-zero speed and return.
                            	  1649:     ;
02:00038C12 6A0C            	  1650:     bpl  _L_z04__TryShooting_SetShootTimer
