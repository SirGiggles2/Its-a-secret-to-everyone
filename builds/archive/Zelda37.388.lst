02:000391B0 41EC0405        	  2437:     lea     ($0405,A4),A0
02:000391B4 10302000        	  2438:     move.b  (A0,D2.W),D0
02:000391B8 6712            	  2439:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  2440:     ; If monster is a red leever, then decrement the red leever count.
                            	  2441:     ;
02:000391BA 41EC034F        	  2442:     lea     ($034F,A4),A0
02:000391BE 10302000        	  2443:     move.b  (A0,D2.W),D0
02:000391C2 0C000010        	  2444:     cmpi.b  #$10,D0
