                            	  4937: __far_z_07_0074:
                            	  4938:     ; This is a magic shot.
                            	  4939:     ;
                            	  4940:     ; If missing the magic book, go deactivate the shot object.
                            	  4941:     ;
02:00049248 102C0661        	  4942:     move.b  ($0661,A4),D0
02:0004924C 6602            	  4943:     bne.s  __far_z_07_0075
02:0004924E 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:00049250 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:00049254 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:00049256 102C0513        	  4956:     move.b  ($0513,A4),D0
02:0004925A 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:0004925C 7000            	  4958:     moveq   #0,D0
02:0004925E 19400513        	  4959:     move.b  D0,($0513,A4)
02:00049262 4EB9000308E6    	  4960:     jsr     WieldCandle
02:00049268 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004926A 19400513        	  4962:     move.b  D0,($0513,A4)
02:0004926E 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:00049270 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:00049274 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:00049278 10302000        	  4972:     move.b  (A0,D2.W),D0
02:0004927C 0C000021        	  4973:     cmpi.b  #$21,D0
02:00049280 6702            	  4974:     beq.s  __far_z_07_0076
02:00049282 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
                            	  4978:     ;
02:00049284 41EC00AC        	  4979:     lea     ($00AC,A4),A0
02:00049288 52302000        	  4980:     addq.b  #1,(A0,D2.W)
                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:0004928C 760E            	  4983:     moveq   #14,D3
02:0004928E 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:00049292 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:00049296 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004929A 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004929E 41EC0084        	  4988:     lea     ($0084,A4),A0
02:000492A2 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:000492A6 41EC0098        	  4990:     lea     ($0098,A4),A0
02:000492AA 10303000        	  4991:     move.b  (A0,D3.W),D0
02:000492AE 41EC0098        	  4992:     lea     ($0098,A4),A0
02:000492B2 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
                            	  4996:     ;
02:000492B6 704F            	  4997:     moveq   #79,D0
02:000492B8 19802028        	  4998:     move.b  D0,($28,A4,D2.W)
                            	  4999:     even
                            	  5000: DeactivateLinkShot:
02:000492BC 4EF90002BC8C    	  5001:     jmp     c_deactivate_link_shot
                            	  5002: 
                            	  5003: DeactivateShot:
02:000492C2 4EF90002BC7C    	  5004:     jmp     c_deactivate_shot
                            	  5005: 
                            	  5006: SetShotSpreadingState:
02:000492C8 4EF90002B8B6    	  5007:     jmp     c_set_shot_spreading_state
                            	  5008: 
                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:000492CE 41EC0098        	  5017:     lea     ($0098,A4),A0
02:000492D2 10302000        	  5018:     move.b  (A0,D2.W),D0
02:000492D6 19400002        	  5019:     move.b  D0,($0002,A4)
02:000492DA 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:000492DE 7000            	  5023:     moveq   #0,D0
02:000492E0 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:000492E4 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:000492E6 1003            	  5031:     move.b  D3,D0
02:000492E8 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:000492EA 102C0002        	  5035:     move.b  ($0002,A4),D0
02:000492EE 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:000492F0 102C0003        	  5037:     move.b  ($0003,A4),D0
02:000492F4 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:000492F6 102C0015        	  5046:     move.b  ($0015,A4),D0
02:000492FA 02000003        	  5047:     andi.b #$03,D0
02:000492FE 41F90004915C    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00049304 12303000        	  5049:     move.b  (A0,D3.W),D1
02:00049308 8001            	  5050:     or.b  D1,D0
02:0004930A 4EB900030F4E    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:00049310 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:00049314 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049318 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004931C D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004931E 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:00049320 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:00049324 B001            	  5064:     cmp.b   D1,D0
02:00049326 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:00049328 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004932C 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004932E 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:00049332 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:00049336 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004933A 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004933C 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:00049340 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:00049342 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:00049346 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004934A 1214            	  5079:     move.b  ($0000,A4),D1
02:0004934C 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049350 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:00049352 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:00049356 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004935A 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004935C 41EC0084        	  5092:     lea     ($0084,A4),A0
02:00049360 10302000        	  5093:     move.b  (A0,D2.W),D0
02:00049364 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049368 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004936C D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004936E 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:00049372 7600            	  5100:     moveq   #0,D3
02:00049374 162C0010        	  5101:     move.b  ($0010,A4),D3
02:00049378 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:0004937A 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004937E 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:00049380 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:00049384 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:00049386 7002            	  5112:     moveq   #2,D0
02:00049388 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004938C 7623            	  5114:     moveq   #35,D3
02:0004938E 4EB900030E6E    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:00049394 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:00049396 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004939A 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004939C 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:000493A0 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:000493A2 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:000493A4 7600            	  5136:     moveq   #0,D3
02:000493A6 1600            	  5137:     move.b  D0,D3
02:000493A8 0C030001        	  5138:     cmpi.b  #$01,D3
02:000493AC 6602            	  5139:     bne  _anon_z07_25
02:000493AE 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:000493B0 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:000493B4 4600            	  5143:     eori.b #$FF,D0
02:000493B6 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:000493BA 123C0001        	  5145:     move.b  #$01,D1
02:000493BE D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000493C0 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:000493C4 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:000493C6 7600            	  5151:     moveq   #0,D3
02:000493C8 1600            	  5152:     move.b  D0,D3
02:000493CA 5303            	  5153:     subq.b  #1,D3
02:000493CC 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:000493D0 41EC0098        	  5160:     lea     ($0098,A4),A0
02:000493D4 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:000493D8 41EC0098        	  5166:     lea     ($0098,A4),A0
02:000493DC 10302000        	  5167:     move.b  (A0,D2.W),D0
02:000493E0 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:000493E4 6702            	  5169:     beq.s  __far_z_07_0077
02:000493E6 6004            	  5170:     jmp  L1F49F_Exit
                            	  5171: __far_z_07_0077:
02:000493E8 6000FED2        	  5172:     jmp     DeactivateLinkShot
                            	  5173: 
                            	  5174:     even
