                            	  7828: Link_ModifyDirAtGridPoint:
                            	  7829:     ; Grid offset = 0, so A = 0 here.
                            	  7830:     ; Reset some variables.
                            	  7831:     ;
                            	  7832:     ;
                            	  7833:     ; [0B] holds input direction count.
                            	  7834:     ;
02:00041E90 1940000B        	  7835:     move.b  D0,($000B,A4)
02:00041E94 1940000C        	  7836:     move.b  D0,($000C,A4)
02:00041E98 19400057        	  7837:     move.b  D0,($0057,A4)
                            	  7838:     ; Look for walkable directions that are components of the
