                            	  5837: UpdateDodongoState_JumpTable:
02:0003AA02 0003AA0E        	  5838:     dc.l    UpdateDodongoState0_Move   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA06 0003AA72        	  5839:     dc.l    UpdateDodongoState1_Bloated   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA0A 0003AA6C        	  5840:     dc.l    UpdateDodongoState2_Stunned   ; jump table entry (32-bit for _m68k_tablejump)
