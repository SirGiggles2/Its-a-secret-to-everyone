                            	  4516: _anon_z02_34:
02:00034E04 41F900FF6B7E    	  4517:     lea     (NES_SRAM+$0B7E).l,A0
02:00034E0A 10303000        	  4518:     move.b  (A0,D3.W),D0
02:00034E0E 41EC0302        	  4519:     lea     ($0302,A4),A0
02:00034E12 11803000        	  4520:     move.b  D0,(A0,D3.W)
02:00034E16 5303            	  4521:     subq.b  #1,D3
02:00034E18 6AEA            	  4522:     bpl  _anon_z02_34
                            	  4523:     ; Use (timer MOD 4) as an index to look up a color.
                            	  4524:     ;
02:00034E1A 1002            	  4525:     move.b  D2,D0
