02:00049A1C 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:00049A20 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:00049A22 102C0084        	  6062:     move.b  ($0084,A4),D0
02:00049A26 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A2A 41F90004994C    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00049A30 12303000        	  6065:     move.b  (A0,D3.W),D1
02:00049A34 D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00049A36 41EC0084        	  6067:     lea     ($0084,A4),A0
02:00049A3A 11802000        	  6068:     move.b  D0,(A0,D2.W)
02:00049A3E 19400001        	  6069:     move.b  D0,($0001,A4)
                            	  6070:     ; If state = 1, use up direction.
                            	  6071:     ; Else use object direction.
