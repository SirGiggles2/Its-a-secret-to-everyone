02:00040924 123C0001        	  5595:     move.b  #$01,D1
02:00040928 0A3C0010        	  5596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004092C 9101            	  5597:     subx.b  D1,D0   ; SBC #$01
02:0004092E 0A3C0010        	  5598:     eori    #$10,CCR  ; restore X = 6502 C
02:00040932 02000002        	  5599:     andi.b #$02,D0
02:00040936 19400008        	  5600:     move.b  D0,($0008,A4)
                            	  5601:     ; The command to close a key door or bombable wall does not
                            	  5602:     ; do anything.
                            	  5603:     ;
02:0004093A 102C0054        	  5604:     move.b  ($0054,A4),D0
