02:000498CE 1880            	  5888:     move.b  D0,($0000,A4)
02:000498D0 41F9000494A6    	  5889:     lea     (RDirectionToOffsetsY).l,A0
02:000498D6 10303000        	  5890:     move.b  (A0,D3.W),D0
02:000498DA 19400001        	  5891:     move.b  D0,($0001,A4)
02:000498DE 7602            	  5892:     moveq   #2,D3
