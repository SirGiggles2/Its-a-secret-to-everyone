02:00039578 41EC034F        	  2979:     lea     ($034F,A4),A0
02:0003957C 10302000        	  2980:     move.b  (A0,D2.W),D0
02:00039580 0C000022        	  2981:     cmpi.b  #$22,D0
02:00039584 670000A6        	  2982:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2983:     ; Else we have an armos.
                            	  2984:     ;
                            	  2985:     ; Store stairs tile $70 in [00] for use later.
                            	  2986:     ;
02:00039588 7070            	  2987:     moveq   #112,D0
02:0003958A 1880            	  2988:     move.b  D0,($0000,A4)
                            	  2989:     ; Look for the current room ID in an array of room ID's that
                            	  2990:     ; have armos secrets.
                            	  2991:     ;
02:0003958C 7606            	  2992:     moveq   #6,D3
                            	  2993:     even
                            	  2994: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003958E 102C00EB        	  2995:     move.b  ($00EB,A4),D0
                            	  2996:     ; If this element does not match the current room ID, go loop again.
                            	  2997:     ;
02:00039592 41F900039558    	  2998:     lea     (SecretArmosRoomIds).l,A0
02:00039598 12303000        	  2999:     move.b  (A0,D3.W),D1
02:0003959C B001            	  3000:     cmp.b   D1,D0
02:0003959E 6648            	  3001:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3002:     ; The secret (usually stairs) is under one of the armoses.
                            	  3003:     ;
                            	  3004:     ; If the armos's X coordinate does not match the one needed
                            	  3005:     ; for the current room in the list, then go loop again.
                            	  3006:     ;
02:000395A0 10342070        	  3007:     move.b  ($70,A4,D2.W),D0
02:000395A4 41F900039560    	  3008:     lea     (SecretArmosXs).l,A0
02:000395AA 12303000        	  3009:     move.b  (A0,D3.W),D1
02:000395AE B001            	  3010:     cmp.b   D1,D0
02:000395B0 6636            	  3011:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3012:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3013:     ;
02:000395B2 41EC0084        	  3014:     lea     ($0084,A4),A0
02:000395B6 10302000        	  3015:     move.b  (A0,D2.W),D0
02:000395BA 0C000080        	  3016:     cmpi.b  #$80,D0
02:000395BE 6628            	  3017:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3018:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3019:     ;
02:000395C0 4A03            	  3020:     cmpi.b  #$00,D3
02:000395C2 662C            	  3021:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3022:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3023:     ; has the power bracelet.
                            	  3024:     ;
                            	  3025:     ; Set up the room item with the armos's coordinates.
                            	  3026:     ;
02:000395C4 19400097        	  3027:     move.b  D0,($0097,A4)
02:000395C8 10342070        	  3028:     move.b  ($70,A4,D2.W),D0
02:000395CC 19400083        	  3029:     move.b  D0,($0083,A4)
                            	  3030:     ; This resets the room item's state, which activates it.
                            	  3031:     ;
02:000395D0 194300BF        	  3032:     move.b  D3,($00BF,A4)
                            	  3033:     ; Set the room item ID.
                            	  3034:     ;
02:000395D4 7014            	  3035:     moveq   #20,D0
02:000395D6 194000AB        	  3036:     move.b  D0,($00AB,A4)
                            	  3037:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3038:     ;
                            	  3039:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3040:     ;
                            	  3041:     ; Note that, if the item was already taken, then the room item
                            	  3042:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3043:     ; it will be ignored, because that routine checks whether
                            	  3044:     ; the item was taken.
                            	  3045:     ;
02:000395DA 4EB900030994    	  3046:     jsr     GetRoomFlagUWItemState
02:000395E0 660A            	  3047:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:000395E2 6100069E        	  3048:     jsr     PlaySecretFoundTune
02:000395E6 6604            	  3049:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3050:     even
