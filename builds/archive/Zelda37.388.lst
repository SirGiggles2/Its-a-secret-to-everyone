                            	  7641: Submenu_CueTransferRowUW:
                            	  7642:     ; If menu scroll value is negative, then we transferred everything.
                            	  7643:     ; So, return.
                            	  7644:     ;
02:00041D9C 102C005E        	  7645:     move.b  ($005E,A4),D0
02:00041DA0 6A02            	  7646:     bpl.s  __far_z_05_0084
02:00041DA2 6030            	  7647:     jmp  L1725A_Exit
                            	  7648: __far_z_05_0084:
                            	  7649:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7650:     ; and represents the current row of the submenu being processed.
                            	  7651:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7652:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7653:     ;
                            	  7654:     ; If the bottom bit is set, go prepare the full black row.
                            	  7655:     ;
02:00041DA4 E208            	  7656:     lsr.b  #1,D0   ; LSR A
02:00041DA6 7600            	  7657:     moveq   #0,D3
02:00041DA8 1600            	  7658:     move.b  D0,D3
02:00041DAA 6402            	  7659:     bcc.s  __far_z_05_0085
02:00041DAC 6028            	  7660:     jmp  PrepFullBlackRow
                            	  7661: __far_z_05_0085:
                            	  7662:     ; Submenu rows $D to $15 are parts of the map.
                            	  7663:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7664:     ;
                            	  7665:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7666:     ; buffer for this row.
                            	  7667:     ;
02:00041DAE 0C00000D        	  7668:     cmpi.b  #$0D,D0
02:00041DB2 640C            	  7669:     bcc  _anon_z05_167
02:00041DB4 41F900041D78    	  7670:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00041DBA 10303000        	  7671:     move.b  (A0,D3.W),D0
                            	  7672:     even
                            	  7673: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00041DBE 6070            	  7674:     jmp     SelectTransferBufAndDecCounter
                            	  7675: 
                            	  7676: _anon_z05_167:
                            	  7677:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7678:     ; of the big map sheet.
                            	  7679:     ;
02:00041DC0 0C000015        	  7680:     cmpi.b  #$15,D0
02:00041DC4 6604            	  7681:     bne  _anon_z05_168
02:00041DC6 7042            	  7682:     moveq   #66,D0
02:00041DC8 60F4            	  7683:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7684: 
