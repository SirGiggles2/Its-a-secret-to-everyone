02:0003C448 41EC034F        	  9305:     lea     ($034F,A4),A0
02:0003C44C 16302000        	  9306:     move.b  (A0,D2.W),D3
02:0003C450 0C030025        	  9307:     cmpi.b  #$25,D3
02:0003C454 6702            	  9308:     beq  _anon_z04_158
02:0003C456 7018            	  9309:     moveq   #24,D0
