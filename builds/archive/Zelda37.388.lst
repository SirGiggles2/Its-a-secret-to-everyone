                            	  6213: _L_z04_UpdatePolsVoice_State0:
                            	  6214:     ; State 0. Walking.
                            	  6215:     ;
                            	  6216:     ; If grid offset = 0, then no more distance to cover.
                            	  6217:     ; So, go change to state 1 -- jumping.
                            	  6218:     ;
02:0003ACB6 41EC0394        	  6219:     lea     ($0394,A4),A0
02:0003ACBA 10302000        	  6220:     move.b  (A0,D2.W),D0
02:0003ACBE 67000084        	  6221:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  6222:     ; Decrement grid offset / distance remaining.
                            	  6223:     ;
02:0003ACC2 41EC0394        	  6224:     lea     ($0394,A4),A0
02:0003ACC6 53302000        	  6225:     subq.b  #1,(A0,D2.W)
                            	  6226:     ; Move vertically.
                            	  6227:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  6228:     ;
02:0003ACCA 41EC0084        	  6229:     lea     ($0084,A4),A0
02:0003ACCE 10302000        	  6230:     move.b  (A0,D2.W),D0
02:0003ACD2 023C00EE        	  6231:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACD6 41F90003AC66    	  6232:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003ACDC 12303000        	  6233:     move.b  (A0,D3.W),D1
02:0003ACE0 D101            	  6234:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003ACE2 41EC0084        	  6235:     lea     ($0084,A4),A0
02:0003ACE6 11802000        	  6236:     move.b  D0,(A0,D2.W)
                            	  6237:     even
                            	  6238: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  6239:     ; If the square the monster is over is walkable, then
                            	  6240:     ; go draw and check object collisions.
                            	  6241:     ;
02:0003ACEA 610001F4        	  6242:     jsr     PolsVoice_IsSquareWalkable
02:0003ACEE 6452            	  6243:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  6244:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  6245:     ; then go change to state 1.
                            	  6246:     ;
02:0003ACF0 41EC041F        	  6247:     lea     ($041F,A4),A0
02:0003ACF4 10302000        	  6248:     move.b  (A0,D2.W),D0
02:0003ACF8 020000FC        	  6249:     andi.b #$FC,D0
02:0003ACFC 0C0000B0        	  6250:     cmpi.b  #$B0,D0
02:0003AD00 6742            	  6251:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003AD02 0C0000F4        	  6252:     cmpi.b  #$F4,D0
02:0003AD06 643C            	  6253:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  6254:     ; Else blocked by something else.
                            	  6255:     ;
                            	  6256:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  6257:     ;
