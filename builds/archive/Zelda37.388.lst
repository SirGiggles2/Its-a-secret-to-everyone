                            	  5565: __far_z_05_0076:
                            	  5566:     ; Turn the door command into the desired open or closed state
                            	  5567:     ; to store in [08].
                            	  5568:     ;
                            	  5569:     ; cmd:  7 6 3 2 
                            	  5570:     ; [08]: 2 0 0 0
                            	  5571:     ;
                            	  5572:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5573:     ; commands intended to be used.
                            	  5574:     ;
                            	  5575:     ; 3 is the end state of 2: close
                            	  5576:     ; 7 is the end state of 6: open
                            	  5577:     ;
02:000408FC 02000007        	  5578:     andi.b #$07,D0
02:00040900 7601            	  5579:     moveq   #1,D3
02:00040902 19430002        	  5580:     move.b  D3,($0002,A4)
02:00040906 122C0002        	  5581:     move.b  ($0002,A4),D1
02:0004090A C200            	  5582:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004090C 6702            	  5583:     beq  _anon_z05_118
02:0004090E E208            	  5584:     lsr.b  #1,D0   ; LSR A
                            	  5585: _anon_z05_118:
02:00040910 0C000002        	  5586:     cmpi.b  #$02,D0
02:00040914 6606            	  5587:     bne  _anon_z05_119
                            	  5588:     ; Command 2 sets Link's timer to $30.
                            	  5589:     ;
02:00040916 7630            	  5590:     moveq   #48,D3
02:00040918 19430028        	  5591:     move.b  D3,($0028,A4)
                            	  5592: _anon_z05_119:
02:0004091C 02000003        	  5593:     andi.b #$03,D0
