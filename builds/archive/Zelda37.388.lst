02:000496BC 6656            	  5597:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5598:     ; State $3x. Slow down.
                            	  5599:     ;
                            	  5600:     ; Reset grid offset for movement.
                            	  5601:     ;
02:000496BE 7000            	  5602:     moveq   #0,D0
02:000496C0 41EC0394        	  5603:     lea     ($0394,A4),A0
02:000496C4 11802000        	  5604:     move.b  D0,(A0,D2.W)
                            	  5605:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5606:     ;
