02:00035520 E208            	  5197:     lsr.b  #1,D0   ; LSR A
02:00035522 6556            	  5198:     bcs  _L_z02_DrawCredits_IncRow
02:00035524 E208            	  5199:     lsr.b  #1,D0   ; LSR A
02:00035526 6552            	  5200:     bcs  _L_z02_DrawCredits_IncRow
                            	  5201:     ; Attributes for the left and right blocks are 0.
                            	  5202:     ;
02:00035528 7400            	  5203:     moveq   #0,D2
02:0003552A 19420328        	  5204:     move.b  D2,($0328,A4)
02:0003552E 1942032F        	  5205:     move.b  D2,($032F,A4)
                            	  5206:     ; The row was already divided by 4. So now it refers to an
                            	  5207:     ; NT attribute block row. Look up the attribute byte to use
                            	  5208:     ; for almost every block in this NT attribute block row.
                            	  5209:     ;
02:00035532 7600            	  5210:     moveq   #0,D3
02:00035534 1600            	  5211:     move.b  D0,D3
02:00035536 41F9000352FA    	  5212:     lea     (CreditsAttrs).l,A0
02:0003553C 10303000        	  5213:     move.b  (A0,D3.W),D0
                            	  5214:     ; Fill a record with this byte, so the whole NT attribute block
                            	  5215:     ; row is changed.
                            	  5216:     ;
02:00035540 7605            	  5217:     moveq   #5,D3
                            	  5218: _anon_z02_51:
02:00035542 41EC0329        	  5219:     lea     ($0329,A4),A0
02:00035546 11803000        	  5220:     move.b  D0,(A0,D3.W)
02:0003554A 5303            	  5221:     subq.b  #1,D3
02:0003554C 6AF4            	  5222:     bpl  _anon_z02_51
                            	  5223:     ; If tiles are being written to NT 1 (>= $2800), then
                            	  5224:     ; write the high byte of NT 1's attribute space (>= $2BC0).
