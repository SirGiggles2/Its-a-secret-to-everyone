                            	  7735: __far_z_05_0086:
                            	  7736:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7737:     ; and represents the current row of the submenu being processed.
                            	  7738:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7739:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7740:     ;
                            	  7741:     ; If the bottom bit is set, go prepare the full black row.
                            	  7742:     ;
02:00041E16 E208            	  7743:     lsr.b  #1,D0   ; LSR A
02:00041E18 7600            	  7744:     moveq   #0,D3
02:00041E1A 1600            	  7745:     move.b  D0,D3
02:00041E1C 6402            	  7746:     bcc.s  __far_z_05_0087
02:00041E1E 60B6            	  7747:     jmp  PrepFullBlackRow
                            	  7748: __far_z_05_0087:
                            	  7749:     ; There's nothing to do for row $15.
                            	  7750:     ; If submenu row < $15, cue a transfer of a triforce or other
                            	  7751:     ; transfer buffer for this row.
                            	  7752:     ;
02:00041E20 0C000015        	  7753:     cmpi.b  #$15,D0
02:00041E24 640E            	  7754:     bcc  _anon_z05_170
02:00041E26 41F900041D86    	  7755:     lea     (SubmenuTransferBufSelectorsOW).l,A0
02:00041E2C 10303000        	  7756:     move.b  (A0,D3.W),D0
