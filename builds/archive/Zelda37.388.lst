                            	  3855: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  3856:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  3857:     ;
                            	  3858:     ; To match a doorway:
                            	  3859:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  3860:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  3861:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  3862:     ;
                            	  3863:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  3864:     ; a doorway to be part of it.
                            	  3865:     ;
02:0003F238 102C0098        	  3866:     move.b  ($0098,A4),D0
02:0003F23C 61000122        	  3867:     jsr     GetPlayerCoordsForDirection
