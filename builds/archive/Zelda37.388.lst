02:0003B982 41EC0478        	  7879:     lea     ($0478,A4),A0
02:0003B986 10302000        	  7880:     move.b  (A0,D2.W),D0
02:0003B98A 41EC0437        	  7881:     lea     ($0437,A4),A0
02:0003B98E 12302000        	  7882:     move.b  (A0,D2.W),D1
02:0003B992 B001            	  7883:     cmp.b   D1,D0
02:0003B994 6722            	  7884:     beq  _L_z04_UpdateManhandla_Draw
                            	  7885:     ; Copy the new value to the old variable, so that they're the same.
                            	  7886:     ;
02:0003B996 41EC0437        	  7887:     lea     ($0437,A4),A0
02:0003B99A 11802000        	  7888:     move.b  D0,(A0,D2.W)
                            	  7889:     ; If animation frame = 1, then go draw.
                            	  7890:     ;
