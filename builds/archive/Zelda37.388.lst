02:00041DF8 7060            	  7717:     moveq   #96,D0
02:00041DFA 19400304        	  7718:     move.b  D0,($0304,A4)
02:00041DFE 7024            	  7719:     moveq   #36,D0
02:00041E00 19400305        	  7720:     move.b  D0,($0305,A4)
