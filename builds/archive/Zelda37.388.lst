                            	  9931: GanonFrameImages:
02:0003C8B2 06              	  9932:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003C8B3 08
02:0003C8B4 07
02:0003C8B5 09
02:0003C8B6 00
02:0003C8B7 00
02:0003C8B8 01
02:0003C8B9 01
02:0003C8BA 02              	  9933:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003C8BB 02
02:0003C8BC 03
02:0003C8BD 03
02:0003C8BE 04
02:0003C8BF 00
02:0003C8C0 05
