                            	  9937: GanonSpriteOffsetsX:
02:0003C8CA 00              	  9938:     dc.b    $00, $10, $00, $10
02:0003C8CB 10
02:0003C8CC 00
02:0003C8CD 10
                            	  9939: 
                            	  9940:     even
                            	  9941: GanonSpriteOffsetsY:
02:0003C8CE 00              	  9942:     dc.b    $00, $00, $10, $10
02:0003C8CF 00
02:0003C8D0 10
02:0003C8D1 10
                            	  9943: 
                            	  9944:     even
                            	  9945: GanonSpriteHFlips:
