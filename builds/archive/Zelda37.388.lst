                            	  6084: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6085:     ; Store the weapon's frame (horizontal or vertical)
                            	  6086:     ; for the direction chosen above in [0C].
                            	  6087:     ;
02:00049A60 4EB90003088C    	  6088:     jsr     GetOppositeDir
02:00049A66 41F90004949A    	  6089:     lea     (RDirectionToWeaponFrame).l,A0
02:00049A6C 10303000        	  6090:     move.b  (A0,D3.W),D0
02:00049A70 1940000C        	  6091:     move.b  D0,($000C,A4)
                            	  6092:     ; Calculate sprite attributes.
                            	  6093:     ;
                            	  6094:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6095:     ;   base attribute OR 1
                            	  6096:     ; So, it uses palette row 5.
                            	  6097:     ;
02:00049A74 41F90004949E    	  6098:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049A7A 10303000        	  6099:     move.b  (A0,D3.W),D0
02:00049A7E 0C02000D        	  6100:     cmpi.b  #$0D,D2
02:00049A82 6706            	  6101:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00049A84 00000001        	  6102:     ori.b #$01,D0
02:00049A88 601C            	  6103:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6104: 
                            	  6105:     even
                            	  6106: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6107:     ; The weapon is the sword.
                            	  6108:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6109:     ;
02:00049A8A 023C00EE        	  6110:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A8E 122C0657        	  6111:     move.b  ($0657,A4),D1
02:00049A92 D101            	  6112:     addx.b  D1,D0   ; ADC Items
02:00049A94 003C0011        	  6113:     ori     #$11,CCR  ; SEC: set C+X
02:00049A98 123C0001        	  6114:     move.b  #$01,D1
02:00049A9C 0A3C0010        	  6115:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049AA0 9101            	  6116:     subx.b  D1,D0   ; SBC #$01
02:00049AA2 0A3C0010        	  6117:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6118:     even
                            	  6119: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6120:     ; Set sprite attributes to the calculated value above.
                            	  6121:     ;
02:00049AA6 4EB900030F4E    	  6122:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6123:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6124:     ;
02:00049AAC 0C030002        	  6125:     cmpi.b  #$02,D3
02:00049AB0 6604            	  6126:     bne  _anon_z07_33
02:00049AB2 522C000F        	  6127:     addq.b  #1,($000F,A4)
                            	  6128: _anon_z07_33:
                            	  6129:     ; If state = 1, return. Don't show the weapon.
                            	  6130:     ;
02:00049AB6 41EC00AC        	  6131:     lea     ($00AC,A4),A0
02:00049ABA 10302000        	  6132:     move.b  (A0,D2.W),D0
02:00049ABE 0200000F        	  6133:     andi.b #$0F,D0
02:00049AC2 0C000001        	  6134:     cmpi.b  #$01,D0
02:00049AC6 6604            	  6135:     bne.s  __far_z_07_0091
02:00049AC8 600000AA        	  6136:     jmp  L1F854_Exit
                            	  6137: __far_z_07_0091:
                            	  6138:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  6139:     ; sword or rod
                            	  6140:     ;
                            	  6141:     ;
                            	  6142:     ; Sword slot
02:00049ACC 7600            	  6143:     moveq   #0,D3
02:00049ACE 0C02000D        	  6144:     cmpi.b  #$0D,D2
02:00049AD2 6702            	  6145:     beq  _anon_z07_34
02:00049AD4 7608            	  6146:     moveq   #8,D3
                            	  6147: _anon_z07_34:
02:00049AD6 4EB900030E6E    	  6148:     jsr     Anim_WriteItemSprites
                            	  6149:     ; If state <> 3, return.
                            	  6150:     ;
02:00049ADC 41EC00AC        	  6151:     lea     ($00AC,A4),A0
02:00049AE0 10302000        	  6152:     move.b  (A0,D2.W),D0
02:00049AE4 0200000F        	  6153:     andi.b #$0F,D0
02:00049AE8 0C000003        	  6154:     cmpi.b  #$03,D0
02:00049AEC 6704            	  6155:     beq.s  __far_z_07_0092
02:00049AEE 60000084        	  6156:     jmp  L1F854_Exit
                            	  6157: __far_z_07_0092:
                            	  6158:     ; State = 3. Time to instantiate a shot.
                            	  6159:     ;
                            	  6160:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6161:     ;
02:00049AF2 0C020012        	  6162:     cmpi.b  #$12,D2
02:00049AF6 6704            	  6163:     beq.s  __far_z_07_0093
02:00049AF8 60000082        	  6164:     jmp  MakeSwordShot
                            	  6165: __far_z_07_0093:
                            	  6166:     ; Instantiate a magic shot (rod shot).
