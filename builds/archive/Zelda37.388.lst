                            	  5903: UpdateDodongoState1_Bloated_JumpTable:
02:0003AA80 0003AA94        	  5904:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA84 0003AA94        	  5905:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA88 0003AA94        	  5906:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA8C 0003AB2C        	  5907:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AA90 0003AB32        	  5908:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
