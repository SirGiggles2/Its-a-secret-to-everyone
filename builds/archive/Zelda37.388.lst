                            	 10012: Ganon_CheckCollisions:
                            	 10013:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 10014:     ; Store in [02] and [03].
                            	 10015:     ;
02:0003C952 10342070        	 10016:     move.b  ($70,A4,D2.W),D0
02:0003C956 023C00EE        	 10017:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C95A 123C0010        	 10018:     move.b  #$10,D1
02:0003C95E D101            	 10019:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C960 19400002        	 10020:     move.b  D0,($0002,A4)
02:0003C964 41EC0084        	 10021:     lea     ($0084,A4),A0
02:0003C968 10302000        	 10022:     move.b  (A0,D2.W),D0
02:0003C96C 023C00EE        	 10023:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C970 123C0010        	 10024:     move.b  #$10,D1
02:0003C974 D101            	 10025:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C976 19400003        	 10026:     move.b  D0,($0003,A4)
                            	 10027:     ; Check for a collision with Link.
                            	 10028:     ;
                            	 10029:     ; We can't call CheckLinkCollision, because we need to
                            	 10030:     ; customize Ganon's midpoint.
                            	 10031:     ;
                            	 10032:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 10033:     ; detection, if Link is invincible. Initialize variables that will
                            	 10034:     ; be returned from the partial collision check routine. Then
                            	 10035:     ; call it.
                            	 10036:     ;
02:0003C97A 102C04F0        	 10037:     move.b  ($04F0,A4),D0
02:0003C97E 6616            	 10038:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C980 19400006        	 10039:     move.b  D0,($0006,A4)
02:0003C984 19400009        	 10040:     move.b  D0,($0009,A4)
02:0003C988 1940000C        	 10041:     move.b  D0,($000C,A4)
02:0003C98C 7600            	 10042:     moveq   #0,D3
02:0003C98E 1883            	 10043:     move.b  D3,($0000,A4)
02:0003C990 4EB900031032    	 10044:     jsr     CheckLinkCollisionPreinit
                            	 10045:     even
                            	 10046: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 10047:     ; If Ganon is not in state 0, then he's brown.
                            	 10048:     ; Go check collision with an arrow.
                            	 10049:     ;
02:0003C996 41EC00AC        	 10050:     lea     ($00AC,A4),A0
02:0003C99A 10302000        	 10051:     move.b  (A0,D2.W),D0
02:0003C99E 6652            	 10052:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 10053:     ; If timer <> 0, then Ganon is visible.
                            	 10054:     ; He can't be harmed like this. So, return.
                            	 10055:     ;
02:0003C9A0 10342028        	 10056:     move.b  ($28,A4,D2.W),D0
02:0003C9A4 664A            	 10057:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C9A6 760D            	 10058:     moveq   #13,D3
02:0003C9A8 4EB90003106C    	 10059:     jsr     CheckMonsterSwordCollision
                            	 10060:     ; If Ganon has died according to the usual collision check rules
                            	 10061:     ; (HP = 0), then:
                            	 10062:     ; 1. Restore HP to the initial value $F0
                            	 10063:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 10064:     ; 3. Change palette row 7 to make Ganon brown
                            	 10065:     ;
02:0003C9AE 41EC0405        	 10066:     lea     ($0405,A4),A0
02:0003C9B2 10302000        	 10067:     move.b  (A0,D2.W),D0
02:0003C9B6 6718            	 10068:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C9B8 103C00F0        	 10069:     move.b  #$F0,D0
02:0003C9BC 41EC0485        	 10070:     lea     ($0485,A4),A0
02:0003C9C0 11802000        	 10071:     move.b  D0,(A0,D2.W)
02:0003C9C4 41EC00AC        	 10072:     lea     ($00AC,A4),A0
02:0003C9C8 53302000        	 10073:     subq.b  #1,(A0,D2.W)
02:0003C9CC 61000084        	 10074:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 10075:     even
                            	 10076: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 10077:     ; If Ganon was harmed, then play the sound effect
                            	 10078:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 10079:     ;
02:0003C9D0 41EC04F0        	 10080:     lea     ($04F0,A4),A0
02:0003C9D4 10302000        	 10081:     move.b  (A0,D2.W),D0
02:0003C9D8 670A            	 10082:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C9DA 6100B846        	 10083:     jsr     PlayBossHitCryIfNeeded
02:0003C9DE 7040            	 10084:     moveq   #64,D0
02:0003C9E0 19802028        	 10085:     move.b  D0,($28,A4,D2.W)
                            	 10086:     even
                            	 10087: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 10088:     ; Reset metastate, because Ganon cannot die this way.
                            	 10089:     ;
02:0003C9E4 4EB90004A7C6    	 10090:     jsr     ResetObjMetastate
                            	 10091:     ; Reset shove info and invincibility timer, because Ganon
                            	 10092:     ; doesn't react at all as a usual monster.
                            	 10093:     ;
02:0003C9EA 4EB90003105A    	 10094:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 10095:     even
                            	 10096: _L_z04_Ganon_CheckCollisions_Exit:
02:0003C9F0 4E75            	 10097:     rts
                            	 10098: 
                            	 10099:     even
                            	 10100: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 10101:     ; If the silver arrow is not in the inventory, then return.
                            	 10102:     ;
02:0003C9F2 102C0659        	 10103:     move.b  ($0659,A4),D0
02:0003C9F6 0C000002        	 10104:     cmpi.b  #$02,D0
02:0003C9FA 66F4            	 10105:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10106:     ; Reset the collision return value [06].
                            	 10107:     ;
02:0003C9FC 7000            	 10108:     moveq   #0,D0
02:0003C9FE 19400006        	 10109:     move.b  D0,($0006,A4)
                            	 10110:     ; If there's no arrow in flight, then return.
                            	 10111:     ;
02:0003CA02 7612            	 10112:     moveq   #18,D3
02:0003CA04 41EC00AC        	 10113:     lea     ($00AC,A4),A0
02:0003CA08 10303000        	 10114:     move.b  (A0,D3.W),D0
02:0003CA0C 0C000010        	 10115:     cmpi.b  #$10,D0
02:0003CA10 66DE            	 10116:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10117:     ; Check for collision with an arrow; and return if no collision.
                            	 10118:     ;
02:0003CA12 4EB900031074    	 10119:     jsr     CheckMonsterArrowOrRodCollision
02:0003CA18 102C0006        	 10120:     move.b  ($0006,A4),D0
02:0003CA1C 67D2            	 10121:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 10122:     ; Set the Ganon phase to "dying".
                            	 10123:     ;
02:0003CA1E 41EC042C        	 10124:     lea     ($042C,A4),A0
02:0003CA22 52302000        	 10125:     addq.b  #1,(A0,D2.W)
                            	 10126:     ; Now his body does flash.
                            	 10127:     ;
02:0003CA26 7028            	 10128:     moveq   #40,D0
02:0003CA28 41EC04F0        	 10129:     lea     ($04F0,A4),A0
02:0003CA2C 11802000        	 10130:     move.b  D0,(A0,D2.W)
                            	 10131:     ; Set initial cloud distance 8.
                            	 10132:     ;
02:0003CA30 7008            	 10133:     moveq   #8,D0
02:0003CA32 41EC0478        	 10134:     lea     ($0478,A4),A0
02:0003CA36 11802000        	 10135:     move.b  D0,(A0,D2.W)
02:0003CA3A 0A3C0001        	 10136:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003CA3E 4E75            	 10137:     rts
                            	 10138: 
                            	 10139:     even
