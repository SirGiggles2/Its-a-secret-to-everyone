                            	  1245: UpdateStatues:
                            	  1246:     ; If person fireballs are enabled (from the two fires), then
                            	  1247:     ; go make fireballs with pattern 2.
                            	  1248:     ;
02:0003897E 7602            	  1249:     moveq   #2,D3
02:00038980 102C04CC        	  1250:     move.b  ($04CC,A4),D0
02:00038984 6620            	  1251:     bne  _L_z04_UpdateStatues_Shoot
                            	  1252:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1253:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1254:     ; - layout $23: pattern 1: 2 statues
                            	  1255:     ; - layout $24: pattern 0: 4 statues
                            	  1256:     ;
02:00038986 4EB900048034    	  1257:     jsr     GetUniqueRoomId
02:0003898C 7601            	  1258:     moveq   #1,D3
                            	  1259: _anon_z04_30:
02:0003898E 41F900038960    	  1260:     lea     (StatueRoomLayouts).l,A0
02:00038994 12303000        	  1261:     move.b  (A0,D3.W),D1
02:00038998 B001            	  1262:     cmp.b   D1,D0
02:0003899A 670A            	  1263:     beq  _L_z04_UpdateStatues_Shoot
02:0003899C 5303            	  1264:     subq.b  #1,D3
02:0003899E 6AEE            	  1265:     bpl  _anon_z04_30
02:000389A0 0A3C0001        	  1266:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000389A4 4E75            	  1267:     rts
