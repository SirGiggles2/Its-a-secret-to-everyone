                            	  4506: _L_z02_UpdateMode13WinGame_Sub0_Flash_ChangePalette:
02:00034DF6 7400            	  4507:     moveq   #0,D2
02:00034DF8 142C0506        	  4508:     move.b  ($0506,A4),D2
                            	  4509:     ; Don't flash until $40 frames have passed.
                            	  4510:     ;
02:00034DFC 0C020040        	  4511:     cmpi.b  #$40,D2
02:00034E00 6530            	  4512:     bcs  _L_z02_UpdateMode13WinGame_Sub0_Flash_Exit
                            	  4513:     ; Copy the level palette transfer buf.
