                            	  5911: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5912:     ; Bloated timer =>
                            	  5913:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5914:     ; 1:     go advance the substate
                            	  5915:     ; other: go decrement Bloated timer
                            	  5916:     ;
02:0003AA94 7600            	  5917:     moveq   #0,D3
02:0003AA96 41EC045E        	  5918:     lea     ($045E,A4),A0
02:0003AA9A 16302000        	  5919:     move.b  (A0,D2.W),D3
02:0003AA9E 5303            	  5920:     subq.b  #1,D3
02:0003AAA0 6750            	  5921:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003AAA2 6B04            	  5922:     bmi.s  __far_z_04_0051
02:0003AAA4 60000080        	  5923:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5924: __far_z_04_0051:
                            	  5925:     ; Set the bloated timer according to the substate.
                            	  5926:     ;
02:0003AAA8 7600            	  5927:     moveq   #0,D3
02:0003AAAA 41EC042C        	  5928:     lea     ($042C,A4),A0
02:0003AAAE 16302000        	  5929:     move.b  (A0,D2.W),D3
02:0003AAB2 41F90003A9F0    	  5930:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003AAB8 10303000        	  5931:     move.b  (A0,D3.W),D0
02:0003AABC 41EC045E        	  5932:     lea     ($045E,A4),A0
02:0003AAC0 11802000        	  5933:     move.b  D0,(A0,D2.W)
                            	  5934:     ; If substate <> 0, go decrement bloated timer.
                            	  5935:     ;
