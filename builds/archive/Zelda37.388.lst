02:0003BA86 123C0008        	  8034:     move.b  #$08,D1
02:0003BA8A D101            	  8035:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BA8C 19802070        	  8036:     move.b  D0,($70,A4,D2.W)
02:0003BA90 532C000F        	  8037:     subq.b  #1,($000F,A4)
02:0003BA94 66E2            	  8038:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
