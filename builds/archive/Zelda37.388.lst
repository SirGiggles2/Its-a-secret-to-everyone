02:0003A8AC 41EC034F        	  5655:     lea     ($034F,A4),A0
02:0003A8B0 10302000        	  5656:     move.b  (A0,D2.W),D0
02:0003A8B4 0C000055        	  5657:     cmpi.b  #$55,D0
