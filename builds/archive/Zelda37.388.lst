02:0003A6E8 122C0003        	  5414:     move.b  ($0003,A4),D1
02:0003A6EC 0A3C0010        	  5415:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A6F0 9101            	  5416:     subx.b  D1,D0   ; SBC $03
02:0003A6F2 0A3C0010        	  5417:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A6F6 41EC0084        	  5418:     lea     ($0084,A4),A0
