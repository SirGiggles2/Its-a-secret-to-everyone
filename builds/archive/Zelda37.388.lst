02:0003949A 41EC03E4        	  2835:     lea     ($03E4,A4),A0
02:0003949E 12302000        	  2836:     move.b  (A0,D2.W),D1
02:000394A2 D101            	  2837:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000394A4 1B00            	  2838:     move.b  D0,-(A5)  ; PHA
