                            	  4715:     ;
02:00034FD6 522C0413        	  4716:     addq.b  #1,($0413,A4)
                            	  4717:     ; Replace the low byte of the VRAM address with the one
                            	  4718:     ; where the next character should be written.
                            	  4719:     ;
02:00034FDA 41F900034F1C    	  4720:     lea     (PeaceTextboxCharAddrsLo).l,A0
