02:00041DE8 D101            	  7710:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00041DEA 6404            	  7711:     bcc  _anon_z05_169
02:00041DEC 522C0302        	  7712:     addq.b  #1,($0302,A4)
                            	  7713: _anon_z05_169:
