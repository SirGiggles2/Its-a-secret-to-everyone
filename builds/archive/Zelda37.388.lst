02:00030C7A 7600            	  2133:     moveq   #0,D3
02:00030C7C 162C0341        	  2134:     move.b  ($0341,A4),D3
02:00030C80 41F900030C24    	  2135:     lea     (SpriteOffsets).l,A0
02:00030C86 10303000        	  2136:     move.b  (A0,D3.W),D0
02:00030C8A 19400343        	  2137:     move.b  D0,($0343,A4)
02:00030C8E 41F900030C25    	  2138:     lea     (SpriteOffsets+1).l,A0
02:00030C94 10303000        	  2139:     move.b  (A0,D3.W),D0
