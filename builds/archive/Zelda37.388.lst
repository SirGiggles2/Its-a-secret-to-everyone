                            	  5843: UpdateDodongoState0_Move:
                            	  5844:     ; If facing left, then push X offset 0 on the stack.
                            	  5845:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  5846:     ;
                            	  5847:     ; We would like to use one set of coordinates only.
                            	  5848:     ; But movement would break down, if we did; because
                            	  5849:     ; Dodongo is so long.
                            	  5850:     ;
                            	  5851:     ; So, when not facing left, we temporarily shift the
                            	  5852:     ; X coordinate to be closer to the other side of the monster.
                            	  5853:     ;
02:0003AA0E 7600            	  5854:     moveq   #0,D3
02:0003AA10 41EC0098        	  5855:     lea     ($0098,A4),A0
02:0003AA14 10302000        	  5856:     move.b  (A0,D2.W),D0
02:0003AA18 0200000D        	  5857:     andi.b #$0D,D0
02:0003AA1C 6716            	  5858:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003AA1E 10342070        	  5859:     move.b  ($70,A4,D2.W),D0
02:0003AA22 023C00EE        	  5860:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA26 123C0010        	  5861:     move.b  #$10,D1
02:0003AA2A D101            	  5862:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003AA2C 19802070        	  5863:     move.b  D0,($70,A4,D2.W)
02:0003AA30 163C00F0        	  5864:     move.b  #$F0,D3
                            	  5865:     even
                            	  5866: _L_z04_UpdateDodongoState0_Move_Move:
02:0003AA34 1003            	  5867:     move.b  D3,D0
02:0003AA36 1B00            	  5868:     move.b  D0,-(A5)  ; PHA
02:0003AA38 7020            	  5869:     moveq   #32,D0
02:0003AA3A 41EC041F        	  5870:     lea     ($041F,A4),A0
02:0003AA3E 11802000        	  5871:     move.b  D0,(A0,D2.W)
02:0003AA42 6100D80C        	  5872:     jsr     Wanderer_TargetPlayer
                            	  5873:     ; Pop the offset and add it to the X coordinate.
                            	  5874:     ;
                            	  5875:     ; This brings the X coordinate back to the unique value
                            	  5876:     ; that represents the position.
                            	  5877:     ;
02:0003AA46 101D            	  5878:     move.b  (A5)+,D0  ; PLA
02:0003AA48 023C00EE        	  5879:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA4C 12342070        	  5880:     move.b  ($70,A4,D2.W),D1
02:0003AA50 D101            	  5881:     addx.b  D1,D0   ; ADC ObjX,X
02:0003AA52 19802070        	  5882:     move.b  D0,($70,A4,D2.W)
                            	  5883:     ; If X coordinate < $20, then face right.
                            	  5884:     ;
02:0003AA56 0C000020        	  5885:     cmpi.b  #$20,D0
02:0003AA5A 640A            	  5886:     bcc  _anon_z04_89
02:0003AA5C 7001            	  5887:     moveq   #1,D0
02:0003AA5E 41EC0098        	  5888:     lea     ($0098,A4),A0
02:0003AA62 11802000        	  5889:     move.b  D0,(A0,D2.W)
