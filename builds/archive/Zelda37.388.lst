                            	  9357: _anon_z04_159:
02:0003C4BE 61000D98        	  9358:     jsr     DecreaseObjectAngle
                            	  9359:     ; Load Patra's maneuver index.
                            	  9360:     ; It determines which counts of bits are looked up below.
