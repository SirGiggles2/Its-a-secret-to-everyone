02:00038E12 10303000        	  1967:     move.b  (A0,D3.W),D0
02:00038E16 41EC0412        	  1968:     lea     ($0412,A4),A0
02:00038E1A 11802000        	  1969:     move.b  D0,(A0,D2.W)
