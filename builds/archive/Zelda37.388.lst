                            	  1463: ; [end inline] dat\ObjListAddrs.inc
                            	  1464: 
                            	  1465:     even
                            	  1466: InitMode4:
02:0003E13A 7400            	  1467:     moveq   #0,D2
02:0003E13C 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003E140 6604            	  1469:     bne.s  __far_z_05_0023
02:0003E142 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003E146 5302            	  1472:     subq.b  #1,D2
02:0003E148 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003E14A 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003E14E 6B06            	  1492:     bmi  _anon_z05_40
02:0003E150 6100359A        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003E154 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003E156 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003E15A 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
                            	  1502: _L_z05_InitMode4_CheckSub2:
02:0003E15C 5302            	  1503:     subq.b  #1,D2
02:0003E15E 6702            	  1504:     beq.s  __far_z_05_0024
02:0003E160 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003E162 7600            	  1509:     moveq   #0,D3
02:0003E164 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003E168 61004452        	  1511:     jsr     IsDarkRoom_Bank5
02:0003E16C 6702            	  1512:     beq.s  __far_z_05_0025
02:0003E16E 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003E170 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003E174 610041C4        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
                            	  1521:     ; to get room ID offset in that direction.
02:0003E178 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003E17C 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003E180 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E184 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003E186 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E18A 4EB900030894    	  1527:     jsr     Negate
02:0003E190 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E194 122C00EB        	  1529:     move.b  ($00EB,A4),D1
02:0003E198 D101            	  1530:     addx.b  D1,D0   ; ADC RoomId
02:0003E19A 7600            	  1531:     moveq   #0,D3
02:0003E19C 1600            	  1532:     move.b  D0,D3
