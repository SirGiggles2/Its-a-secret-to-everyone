                            	  2862:     ;
02:0003EB9C 102C0657        	  2863:     move.b  ($0657,A4),D0
02:0003EBA0 6602            	  2864:     bne.s  __far_z_05_0045
02:0003EBA2 60F6            	  2865:     jmp  L14DFF_Exit
                            	  2866: __far_z_05_0045:
                            	  2867:     ; Switch to the sword slot.
                            	  2868:     ;
02:0003EBA4 740D            	  2869:     moveq   #13,D2
                            	  2870:     ; If state <> 0, then sword or item is in use. So, return.
                            	  2871:     ;
