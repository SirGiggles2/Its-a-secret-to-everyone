02:0002F368 48C4            	   755:     ext.l   D4
02:0002F36A D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F370 2044            	   757:     movea.l D4,A0
02:0002F372 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F376 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002F37A 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
