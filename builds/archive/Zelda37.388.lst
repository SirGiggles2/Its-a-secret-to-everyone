                            	  5619:     ; Set the timer to a random time, at least $70 frames.
                            	  5620:     ;
02:0003A876 10342018        	  5621:     move.b  ($18,A4,D2.W),D0
02:0003A87A 00000070        	  5622:     ori.b #$70,D0
02:0003A87E 19802028        	  5623:     move.b  D0,($28,A4,D2.W)
                            	  5624:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  5625:     ;
02:0003A882 6168            	  5626:     jsr     ShootFireball55
02:0003A884 7000            	  5627:     moveq   #0,D0
02:0003A886 41EC0478        	  5628:     lea     ($0478,A4),A0
02:0003A88A 11803000        	  5629:     move.b  D0,(A0,D3.W)
                            	  5630:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  5631:     ;
02:0003A88E 615C            	  5632:     jsr     ShootFireball55
02:0003A890 7001            	  5633:     moveq   #1,D0
02:0003A892 41EC0478        	  5634:     lea     ($0478,A4),A0
02:0003A896 11803000        	  5635:     move.b  D0,(A0,D3.W)
                            	  5636:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  5637:     ;
