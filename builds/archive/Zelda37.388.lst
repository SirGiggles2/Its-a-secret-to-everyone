                            	  1856: 
                            	  1857: ; Maps an item slot to a value used in calculating the
                            	  1858: ; sprite palette row attribute.
                            	  1859: ;
                            	  1860: ; For most items, the value is the sprite palette row attribute
                            	  1861: ; itself.
                            	  1862: ;
                            	  1863: ; Some items will use the value as an amount to add to the
                            	  1864: ; item value in the slot.
