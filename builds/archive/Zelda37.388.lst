02:00034FA4 41EC0302        	  4692:     lea     ($0302,A4),A0
02:00034FA8 11803000        	  4693:     move.b  D0,(A0,D3.W)
02:00034FAC 5303            	  4694:     subq.b  #1,D3
02:00034FAE 6AEA            	  4695:     bpl  _anon_z02_35
                            	  4696:     ; Load a character from the string and copy it to
                            	  4697:     ; the transfer record until we read character $FF.
                            	  4698:     ;
02:00034FB0 7600            	  4699:     moveq   #0,D3
02:00034FB2 162C0413        	  4700:     move.b  ($0413,A4),D3
02:00034FB6 41F900034F50    	  4701:     lea     (PeaceText).l,A0
02:00034FBC 10303000        	  4702:     move.b  (A0,D3.W),D0
02:00034FC0 0C0000FF        	  4703:     cmpi.b  #$FF,D0
02:00034FC4 6730            	  4704:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034FC6 19400305        	  4705:     move.b  D0,($0305,A4)
                            	  4706:     ; A regular space takes as much time to emit as any character.
                            	  4707:     ; But it makes no sound.
                            	  4708:     ;
02:00034FCA 0C000024        	  4709:     cmpi.b  #$24,D0
02:00034FCE 6706            	  4710:     beq  _anon_z02_36
02:00034FD0 7010            	  4711:     moveq   #16,D0
02:00034FD2 19400604        	  4712:     move.b  D0,($0604,A4)
