02:000498B6 122C0004        	  5871:     move.b  ($0004,A4),D1
02:000498BA D101            	  5872:     addx.b  D1,D0   ; ADC $04
02:000498BC 19400004        	  5873:     move.b  D0,($0004,A4)
02:000498C0 761D            	  5874:     moveq   #29,D3
02:000498C2 601C            	  5875:     jmp     L_DrawArrowOrBoomerang
