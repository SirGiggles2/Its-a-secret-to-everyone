02:000390DA 1600            	  2337:     move.b  D0,D3
02:000390DC 41F900039056    	  2338:     lea     (BlueLeeverStateQSpeeds).l,A0
02:000390E2 10303000        	  2339:     move.b  (A0,D3.W),D0
02:000390E6 41EC03BC        	  2340:     lea     ($03BC,A4),A0
02:000390EA 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:000390EE 41F90003905C    	  2342:     lea     (BlueLeeverStateTimes).l,A0
02:000390F4 10303000        	  2343:     move.b  (A0,D3.W),D0
02:000390F8 19802028        	  2344:     move.b  D0,($28,A4,D2.W)
                            	  2345:     even
                            	  2346: _L_z04_UpdateBurrower_Animate:
                            	  2347:     ; Advance the animation counter; possibly setting a new
                            	  2348:     ; value according to the new state.
                            	  2349:     ;
02:000390FC 7600            	  2350:     moveq   #0,D3
02:000390FE 41EC00AC        	  2351:     lea     ($00AC,A4),A0
02:00039102 16302000        	  2352:     move.b  (A0,D2.W),D3
02:00039106 41F900039062    	  2353:     lea     (BlueLeeverStateAnimTimes).l,A0
