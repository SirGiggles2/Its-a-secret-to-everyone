                            	  1445: CheckZora:
                            	  1446:     ; If the zora attribute of this room is off, return.
                            	  1447:     ;
02:00038AC8 7600            	  1448:     moveq   #0,D3
02:00038ACA 162C00EB        	  1449:     move.b  ($00EB,A4),D3
02:00038ACE 41F900FF687E    	  1450:     lea     (NES_SRAM+$087E).l,A0
02:00038AD4 10303000        	  1451:     move.b  (A0,D3.W),D0
02:00038AD8 02000008        	  1452:     andi.b #$08,D0
02:00038ADC 677C            	  1453:     beq  _L_z04_CheckZora_Exit
                            	  1454:     ; If zora is active, return.
                            	  1455:     ;
02:00038ADE 102C0514        	  1456:     move.b  ($0514,A4),D0
02:00038AE2 6676            	  1457:     bne  _L_z04_CheckZora_Exit
                            	  1458:     ; Look for an empty monster slot. If none is found, return.
                            	  1459:     ;
02:00038AE4 4EB90004A7AE    	  1460:     jsr     FindEmptyMonsterSlot
02:00038AEA 676E            	  1461:     beq  _L_z04_CheckZora_Exit
                            	  1462:     ; Loop $D times looking for a water tile to put a zora on.
                            	  1463:     ; Indexed by [0D].
                            	  1464:     ;
02:00038AEC 700D            	  1465:     moveq   #13,D0
02:00038AEE 1940000D        	  1466:     move.b  D0,($000D,A4)
                            	  1467:     ; Switch to the new object slot.
                            	  1468:     ;
02:00038AF2 7400            	  1469:     moveq   #0,D2
02:00038AF4 142C0059        	  1470:     move.b  ($0059,A4),D2
                            	  1471:     even
                            	  1472: _L_z04_CheckZora_LoopTileCandidate:
                            	  1473:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  1474:     ; If it = 0 or $F0, go loop again.
                            	  1475:     ;
02:00038AF8 7600            	  1476:     moveq   #0,D3
02:00038AFA 162C000D        	  1477:     move.b  ($000D,A4),D3
02:00038AFE 10343018        	  1478:     move.b  ($18,A4,D3.W),D0
02:00038B02 020000F0        	  1479:     andi.b #$F0,D0
02:00038B06 19802070        	  1480:     move.b  D0,($70,A4,D2.W)
02:00038B0A 6748            	  1481:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B0C 0C0000F0        	  1482:     cmpi.b  #$F0,D0
02:00038B10 6742            	  1483:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1484:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1485:     ; If it < $50 or >= $E0, go loop again.
                            	  1486:     ;
02:00038B12 10343018        	  1487:     move.b  ($18,A4,D3.W),D0
02:00038B16 E308            	  1488:     lsl.b  #1,D0   ; ASL A
02:00038B18 E308            	  1489:     lsl.b  #1,D0   ; ASL A
02:00038B1A E308            	  1490:     lsl.b  #1,D0   ; ASL A
02:00038B1C E308            	  1491:     lsl.b  #1,D0   ; ASL A
02:00038B1E 0C000050        	  1492:     cmpi.b  #$50,D0
02:00038B22 6530            	  1493:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B24 0C0000E0        	  1494:     cmpi.b  #$E0,D0
02:00038B28 642A            	  1495:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1496:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1497:     ;
02:00038B2A 0000000D        	  1498:     ori.b #$0D,D0
02:00038B2E 41EC0084        	  1499:     lea     ($0084,A4),A0
02:00038B32 11802000        	  1500:     move.b  D0,(A0,D2.W)
                            	  1501:     ; Get the tile at that location.
                            	  1502:     ; If it's not a water tile, then go loop again.
                            	  1503:     ;
02:00038B36 4EB900048906    	  1504:     jsr     GetCollidableTileStill
02:00038B3C 0C00008D        	  1505:     cmpi.b  #$8D,D0
02:00038B40 6512            	  1506:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B42 0C000099        	  1507:     cmpi.b  #$99,D0
02:00038B46 640C            	  1508:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1509:     ; Flag the zora active, and set up the object.
                            	  1510:     ;
02:00038B48 522C0514        	  1511:     addq.b  #1,($0514,A4)
02:00038B4C 7011            	  1512:     moveq   #17,D0
02:00038B4E 4EF90004A7A8    	  1513:     jmp     SetTypeAndClearObject
                            	  1514: 
                            	  1515:     even
                            	  1516: _L_z04_CheckZora_NextLoopTileCandidate:
                            	  1517:     ; Bottom of the loop. Keep going until loop index [0D] = 0.
                            	  1518:     ;
02:00038B54 532C000D        	  1519:     subq.b  #1,($000D,A4)
02:00038B58 669E            	  1520:     bne  _L_z04_CheckZora_LoopTileCandidate
                            	  1521:     even
