                            	 11157:     ;
02:0003D0CC 41EC03BC        	 11158:     lea     ($03BC,A4),A0
02:0003D0D0 10302000        	 11159:     move.b  (A0,D2.W),D0
02:0003D0D4 7600            	 11160:     moveq   #0,D3
02:0003D0D6 162C0005        	 11161:     move.b  ($0005,A4),D3
02:0003D0DA 61000136        	 11162:     jsr     ShiftMultiply
