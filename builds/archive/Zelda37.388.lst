02:0003A430 41EC0478        	  5113:     lea     ($0478,A4),A0
02:0003A434 16302000        	  5114:     move.b  (A0,D2.W),D3
                            	  5115:     ; Change the coordinates to one corner.
                            	  5116:     ;
02:0003A438 10342070        	  5117:     move.b  ($70,A4,D2.W),D0
02:0003A43C 023C00EE        	  5118:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A440 41F90003A2F4    	  5119:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A446 12303000        	  5120:     move.b  (A0,D3.W),D1
02:0003A44A D101            	  5121:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A44C 19802070        	  5122:     move.b  D0,($70,A4,D2.W)
02:0003A450 41EC0084        	  5123:     lea     ($0084,A4),A0
02:0003A454 10302000        	  5124:     move.b  (A0,D2.W),D0
02:0003A458 023C00EE        	  5125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A45C 41F90003A2F8    	  5126:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A462 12303000        	  5127:     move.b  (A0,D3.W),D1
02:0003A466 D101            	  5128:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A468 41EC0084        	  5129:     lea     ($0084,A4),A0
02:0003A46C 11802000        	  5130:     move.b  D0,(A0,D2.W)
                            	  5131:     ; Check the room boundary and object collisions in this temporary location.
