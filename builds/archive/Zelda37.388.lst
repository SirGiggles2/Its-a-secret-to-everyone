                            	  1038: _L_z04_UpdateFireball_CheckCollisionAndDraw:
                            	  1039:     ; Check for collision with Link. If hit, then go destroy the fireball.
                            	  1040:     ;
02:0003881E 6100FED8        	  1041:     jsr     CheckShotLinkCollision
02:00038822 102C034B        	  1042:     move.b  ($034B,A4),D0
02:00038826 66A0            	  1043:     bne  _L_z04_UpdateFireball_DestroyMonster
02:00038828 6000FDF8        	  1044:     jmp     L_DrawShot
