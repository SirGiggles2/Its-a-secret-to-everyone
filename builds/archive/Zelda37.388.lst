                            	  5959:     ; Advance the substate.
                            	  5960:     ;
02:0003AAF2 41EC042C        	  5961:     lea     ($042C,A4),A0
02:0003AAF6 52302000        	  5962:     addq.b  #1,(A0,D2.W)
                            	  5963:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5964:     ;
