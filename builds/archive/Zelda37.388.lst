                            	   524: UpdateBlock0Idle:
                            	   525:     ; If there are monsters in the room, go reset the push timer and return.
                            	   526:     ;
02:00038450 102C034D        	   527:     move.b  ($034D,A4),D0
02:00038454 6604            	   528:     bne.s  __far_z_04_0000
02:00038456 600000D6        	   529:     jmp  ResetPushTimer
                            	   530: __far_z_04_0000:
                            	   531:     ; If Link's X is aligned with the block's, then get the difference
                            	   532:     ; between Link's (Y + 3) and the block's Y.
                            	   533:     ; Then go test the difference.
                            	   534:     ;
02:0003845A 102C0070        	   535:     move.b  ($0070,A4),D0
02:0003845E 12342070        	   536:     move.b  ($70,A4,D2.W),D1
02:00038462 B001            	   537:     cmp.b   D1,D0
02:00038464 6628            	   538:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038466 7600            	   539:     moveq   #0,D3
02:00038468 102C0084        	   540:     move.b  ($0084,A4),D0
02:0003846C 023C00EE        	   541:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038470 123C0003        	   542:     move.b  #$03,D1
02:00038474 D101            	   543:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038476 003C0011        	   544:     ori     #$11,CCR  ; SEC: set C+X
02:0003847A 41EC0084        	   545:     lea     ($0084,A4),A0
02:0003847E 12302000        	   546:     move.b  (A0,D2.W),D1
02:00038482 0A3C0010        	   547:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038486 9101            	   548:     subx.b  D1,D0   ; SBC ObjY,X
02:00038488 0A3C0010        	   549:     eori    #$10,CCR  ; restore X = 6502 C
02:0003848C 6036            	   550:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   551: 
                            	   552:     even
                            	   553: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   554:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   555:     ; go reset the push timer.
                            	   556:     ;
02:0003848E 102C0084        	   557:     move.b  ($0084,A4),D0
02:00038492 023C00EE        	   558:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038496 123C0003        	   559:     move.b  #$03,D1
02:0003849A D101            	   560:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003849C 41EC0084        	   561:     lea     ($0084,A4),A0
02:000384A0 12302000        	   562:     move.b  (A0,D2.W),D1
02:000384A4 B001            	   563:     cmp.b   D1,D0
02:000384A6 6704            	   564:     beq.s  __far_z_04_0001
02:000384A8 60000084        	   565:     jmp  ResetPushTimer
                            	   566: __far_z_04_0001:
                            	   567:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   568:     ; Get the difference in X.
                            	   569:     ;
02:000384AC 7602            	   570:     moveq   #2,D3
02:000384AE 102C0070        	   571:     move.b  ($0070,A4),D0
02:000384B2 003C0011        	   572:     ori     #$11,CCR  ; SEC: set C+X
02:000384B6 12342070        	   573:     move.b  ($70,A4,D2.W),D1
02:000384BA 0A3C0010        	   574:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000384BE 9101            	   575:     subx.b  D1,D0   ; SBC ObjX,X
02:000384C0 0A3C0010        	   576:     eori    #$10,CCR  ; restore X = 6502 C
                            	   577:     even
                            	   578: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   579:     ; If the difference in coordinates is negative, then Link is
                            	   580:     ; up or left of the block.
                            	   581:     ;
                            	   582:     ; In that case, increase Y register to index the correct opposite
                            	   583:     ; direction below. Also, negate the difference, so we test
                            	   584:     ; positive values.
                            	   585:     ;
02:000384C4 6A06            	   586:     bpl  _anon_z04_14
02:000384C6 5203            	   587:     addq.b  #1,D3
