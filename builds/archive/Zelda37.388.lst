02:000395F4 0C000070        	  3069:     cmpi.b  #$70,D0
02:000395F8 6604            	  3070:     bne  _anon_z04_51
02:000395FA 61000686        	  3071:     jsr     PlaySecretFoundTune
                            	  3072: _anon_z04_51:
                            	  3073:     ; Replace the tile where the armos was.
                            	  3074:     ;
02:000395FE 522C00F7        	  3075:     addq.b  #1,($00F7,A4)
02:00039602 101D            	  3076:     move.b  (A5)+,D0  ; PLA
02:00039604 4EB90004803A    	  3077:     jsr     ChangeTileObjTiles
                            	  3078:     ; Because the armos object is aligned to the square grid
                            	  3079:     ; (because it was made from a square),
                            	  3080:     ; set its grid offset to 3 to compensate.
                            	  3081:     ;
                            	  3082:     ; Most objects are aligned to the grid vertically when the
                            	  3083:     ; low nibble is $D.
                            	  3084:     ;
02:0003960A 7003            	  3085:     moveq   #3,D0
02:0003960C 41EC0394        	  3086:     lea     ($0394,A4),A0
02:00039610 11802000        	  3087:     move.b  D0,(A0,D2.W)
                            	  3088:     ; Set a speed (q-speed fraction) randomly:
                            	  3089:     ; $20 if random value < $80
                            	  3090:     ; $60 otherwise
                            	  3091:     ;
02:00039614 7020            	  3092:     moveq   #32,D0
02:00039616 7600            	  3093:     moveq   #0,D3
02:00039618 16342019        	  3094:     move.b  ($19,A4,D2.W),D3
02:0003961C 0C030080        	  3095:     cmpi.b  #$80,D3
02:00039620 6502            	  3096:     bcs  _anon_z04_52
02:00039622 7060            	  3097:     moveq   #96,D0
                            	  3098: _anon_z04_52:
02:00039624 41EC03BC        	  3099:     lea     ($03BC,A4),A0
02:00039628 11802000        	  3100:     move.b  D0,(A0,D2.W)
                            	  3101:     even
                            	  3102: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3103:     ; Facing and input directions down.
                            	  3104:     ;
02:0003962C 7004            	  3105:     moveq   #4,D0
02:0003962E 41EC03F8        	  3106:     lea     ($03F8,A4),A0
02:00039632 11802000        	  3107:     move.b  D0,(A0,D2.W)
02:00039636 41EC0098        	  3108:     lea     ($0098,A4),A0
02:0003963A 11802000        	  3109:     move.b  D0,(A0,D2.W)
                            	  3110:     ; Every other frame, return without drawing.
                            	  3111:     ;
02:0003963E 10342028        	  3112:     move.b  ($28,A4,D2.W),D0
02:00039642 E208            	  3113:     lsr.b  #1,D0   ; LSR A
02:00039644 6512            	  3114:     bcs  _anon_z04_53
                            	  3115:     ; Finish initializing based on type.
                            	  3116:     ;
02:00039646 41EC034F        	  3117:     lea     ($034F,A4),A0
02:0003964A 10302000        	  3118:     move.b  (A0,D2.W),D0
02:0003964E 0C000022        	  3119:     cmpi.b  #$22,D0
