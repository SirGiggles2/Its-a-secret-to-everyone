02:000496E4 10342070        	  5619:     move.b  ($70,A4,D2.W),D0
02:000496E8 0C000002        	  5620:     cmpi.b  #$02,D0
02:000496EC 650E            	  5621:     bcs  _L_z07_CheckState30_SetState40
