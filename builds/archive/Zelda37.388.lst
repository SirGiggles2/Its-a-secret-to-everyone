                            	  6171:     ;
02:00049AFE 41EC00AC        	  6172:     lea     ($00AC,A4),A0
02:00049B02 10302000        	  6173:     move.b  (A0,D2.W),D0
02:00049B06 6706            	  6174:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00049B08 E308            	  6175:     lsl.b  #1,D0   ; ASL A
02:00049B0A 6402            	  6176:     bcc.s  __far_z_07_0094
02:00049B0C 6066            	  6177:     jmp  L1F854_Exit
