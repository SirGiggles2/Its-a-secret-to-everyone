02:00039738 4E75            	  3253:     rts
                            	  3254: 
                            	  3255:     even
                            	  3256: PondFairy_HandleOtherStates:
02:0003973A 0C000001        	  3257:     cmpi.b  #$01,D0
02:0003973E 6610            	  3258:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3259:     ; State 1. Flying and filling hearts.
                            	  3260:     ;
                            	  3261:     ; If still filling hearts, then go draw Link and hearts.
                            	  3262:     ;
02:00039740 102C0063        	  3263:     move.b  ($0063,A4),D0
02:00039744 6620            	  3264:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3265:     ; If not filling hearts anymore, then go to state 2,
                            	  3266:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3267:     ; a little while after we finish filling hearts.
                            	  3268:     ;
02:00039746 522C00AD        	  3269:     addq.b  #1,($00AD,A4)
02:0003974A 7050            	  3270:     moveq   #80,D0
02:0003974C 19400029        	  3271:     move.b  D0,($0029,A4)
                            	  3272:     even
                            	  3273: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3274:     ; If state <> 2 (so, it's 3), then return.
                            	  3275:     ;
                            	  3276:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3277:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3278:     ; was set to, and we'll return.
                            	  3279:     ;
02:00039750 0C000002        	  3280:     cmpi.b  #$02,D0
02:00039754 6634            	  3281:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3282:     ; State = 2.
                            	  3283:     ;
                            	  3284:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3285:     ;
02:00039756 102C0029        	  3286:     move.b  ($0029,A4),D0
02:0003975A 660A            	  3287:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3288:     ; Else go to state 3, and unhalt Link.
                            	  3289:     ;
02:0003975C 522C00AD        	  3290:     addq.b  #1,($00AD,A4)
02:00039760 7000            	  3291:     moveq   #0,D0
02:00039762 194000AC        	  3292:     move.b  D0,($00AC,A4)
                            	  3293:     even
                            	  3294: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  3295:     ; TODO: but why, since Link is halted?
                            	  3296:     ;
                            	  3297:     ; Reset the input direction, so that Link doesn't animate
                            	  3298:     ; when drawing him.
