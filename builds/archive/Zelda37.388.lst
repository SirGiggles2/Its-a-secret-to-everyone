                            	  5713: _anon_z05_123:
                            	  5714:     ; Door command <> 4.
                            	  5715:     ; It must be 8, which means it was 7: open door.
                            	  5716:     ;
                            	  5717:     ; If the door is a shutter (7), then go add the door to the
                            	  5718:     ; opened door mask, reset door command, and lay out doors.
                            	  5719:     ;
02:000409FE 102C0055        	  5720:     move.b  ($0055,A4),D0
02:00040A02 19400002        	  5721:     move.b  D0,($0002,A4)
02:00040A06 6100FA32        	  5722:     jsr     FindDoorAttrByDoorBit
02:00040A0A 0C000007        	  5723:     cmpi.b  #$07,D0
02:00040A0E 676E            	  5724:     beq  _anon_z05_124
                            	  5725:     ; Else the door is not a shutter.
                            	  5726:     ;
                            	  5727:     ;
                            	  5728:     ; [09] door direction index
02:00040A10 7400            	  5729:     moveq   #0,D2
02:00040A12 142C0009        	  5730:     move.b  ($0009,A4),D2
02:00040A16 6100DCA4        	  5731:     jsr     SetDoorFlag
                            	  5732:     ; Get the next room's ID.
                            	  5733:     ;
02:00040A1A 1003            	  5734:     move.b  D3,D0
02:00040A1C 023C00EE        	  5735:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040A20 41F9000408DC    	  5736:     lea     (DoorNextRoomIdOffsets).l,A0
02:00040A26 12302000        	  5737:     move.b  (A0,D2.W),D1
02:00040A2A D101            	  5738:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00040A2C 7600            	  5739:     moveq   #0,D3
02:00040A2E 1600            	  5740:     move.b  D0,D3
                            	  5741:     ; Flip the door direction index.
                            	  5742:     ;
02:00040A30 1002            	  5743:     move.b  D2,D0
02:00040A32 0A000001        	  5744:     eori.b #$01,D0
02:00040A36 7400            	  5745:     moveq   #0,D2
02:00040A38 1400            	  5746:     move.b  D0,D2
                            	  5747:     ; Set the door flag for the opposite door in the next room.
                            	  5748:     ;
02:00040A3A 1214            	  5749:     move.b  ($00,A4),D1   ; ptr lo
02:00040A3C 182C0001        	  5750:     move.b  ($01,A4),D4  ; ptr hi
02:00040A40 024100FF        	  5751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040A44 E14C            	  5752:     lsl.w   #8,D4
02:00040A46 8841            	  5753:     or.w    D1,D4             ; D4 = NES ptr addr
02:00040A48 48C4            	  5754:     ext.l   D4
02:00040A4A D8BC00FF0000    	  5755:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040A50 2044            	  5756:     movea.l D4,A0
02:00040A52 10303000        	  5757:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040A56 41F900047D6A    	  5758:     lea     (LevelMasks).l,A0
02:00040A5C 12302000        	  5759:     move.b  (A0,D2.W),D1
02:00040A60 8001            	  5760:     or.b  D1,D0
02:00040A62 1214            	  5761:     move.b  ($00,A4),D1   ; ptr lo
02:00040A64 182C0001        	  5762:     move.b  ($01,A4),D4  ; ptr hi
02:00040A68 024100FF        	  5763:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040A6C E14C            	  5764:     lsl.w   #8,D4
02:00040A6E 8841            	  5765:     or.w    D1,D4
02:00040A70 48C4            	  5766:     ext.l   D4
02:00040A72 D8BC00FF0000    	  5767:     add.l   #NES_RAM,D4
02:00040A78 2044            	  5768:     movea.l D4,A0
02:00040A7A 11803000        	  5769:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5770: _anon_z05_124:
                            	  5771:     ; Add the door to the opened door mask, reset door command,
                            	  5772:     ; and lay out doors.
                            	  5773:     ;
02:00040A7E 102C0055        	  5774:     move.b  ($0055,A4),D0
02:00040A82 122C00EE        	  5775:     move.b  ($00EE,A4),D1
02:00040A86 8001            	  5776:     or.b  D1,D0
02:00040A88 6000FF66        	  5777:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5778: 
                            	  5779: ; Params:
                            	  5780: ; [08]: 0 if closed
                            	  5781: ;
                            	  5782: ; Returns:
                            	  5783: ; X: current length of dynamic transfer buf
                            	  5784: ; [00]: door VRAM address high byte
                            	  5785: ; [01]: door VRAM address low byte
                            	  5786: ; [02:03]: address of door tiles for direction and face
                            	  5787: ; [05]: 2, the number of transfer records to write
                            	  5788: ; [06]: 2, the number of tiles in each record
                            	  5789: ; [07]: 0, the first index of a tile to transfer
                            	  5790: ; [09]: door direction index
                            	  5791: ;
                            	  5792: ; Note that this routine is called with triggered doors:
                            	  5793: ; doors that can change state. Their door type numbers are >= 4.
                            	  5794: ;
                            	  5795: ; If this routine were ever called with a fixed door
                            	  5796: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5797: ; values for the door face.
                            	  5798: ;
                            	  5799: ;
                            	  5800: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PrepareWriteHorizontalDoorTransferRecords:
02:00040A8C 102C0055        	  5804:     move.b  ($0055,A4),D0
02:00040A90 19400002        	  5805:     move.b  D0,($0002,A4)
02:00040A94 6100F9A4        	  5806:     jsr     FindDoorAttrByDoorBit
02:00040A98 0C000005        	  5807:     cmpi.b  #$05,D0
02:00040A9C 650C            	  5808:     bcs  _anon_z05_125
02:00040A9E 1B00            	  5809:     move.b  D0,-(A5)  ; PHA
02:00040AA0 7004            	  5810:     moveq   #4,D0
02:00040AA2 4EB9000307DA    	  5811:     jsr     PlaySample
02:00040AA8 101D            	  5812:     move.b  (A5)+,D0  ; PLA
                            	  5813: _anon_z05_125:
                            	  5814:     ; Calculate the door face index in three parts.
                            	  5815:     ;
                            	  5816:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5817:     ; (provisional face index in Y register).
                            	  5818:     ;
02:00040AAA 0C000004        	  5819:     cmpi.b  #$04,D0
02:00040AAE 6602            	  5820:     bne  _anon_z05_126
02:00040AB0 7008            	  5821:     moveq   #8,D0
                            	  5822: _anon_z05_126:
02:00040AB2 0C000001        	  5823:     cmpi.b  #$01,D0
02:00040AB6 6602            	  5824:     bne  _anon_z05_127
02:00040AB8 7004            	  5825:     moveq   #4,D0
                            	  5826: _anon_z05_127:
                            	  5827:     ; Second, subtract 3 from provisional face index.
                            	  5828:     ;
02:00040ABA 003C0011        	  5829:     ori     #$11,CCR  ; SEC: set C+X
02:00040ABE 123C0003        	  5830:     move.b  #$03,D1
02:00040AC2 0A3C0010        	  5831:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040AC6 9101            	  5832:     subx.b  D1,D0   ; SBC #$03
02:00040AC8 0A3C0010        	  5833:     eori    #$10,CCR  ; restore X = 6502 C
02:00040ACC 7600            	  5834:     moveq   #0,D3
02:00040ACE 1600            	  5835:     move.b  D0,D3
                            	  5836:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5837:     ; face index >= 3, then subtract 1 from it.
                            	  5838:     ;
                            	  5839:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5840:     ; then make it 1.
                            	  5841:     ;
02:00040AD0 102C0008        	  5842:     move.b  ($0008,A4),D0
02:00040AD4 6708            	  5843:     beq  _anon_z05_128
02:00040AD6 0C030005        	  5844:     cmpi.b  #$05,D3
02:00040ADA 670A            	  5845:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040ADC 7601            	  5846:     moveq   #1,D3
                            	  5847: _anon_z05_128:
02:00040ADE 0C030003        	  5848:     cmpi.b  #$03,D3
02:00040AE2 6502            	  5849:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040AE4 5303            	  5850:     subq.b  #1,D3
                            	  5851:     even
                            	  5852: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5853:     ; The routine that returned the door type also returned its
                            	  5854:     ; reverse direction index in [03].
                            	  5855:     ;
                            	  5856:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5857:     ;
02:00040AE6 7003            	  5858:     moveq   #3,D0
02:00040AE8 003C0011        	  5859:     ori     #$11,CCR  ; SEC: set C+X
02:00040AEC 122C0003        	  5860:     move.b  ($0003,A4),D1
02:00040AF0 0A3C0010        	  5861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040AF4 9101            	  5862:     subx.b  D1,D0   ; SBC $03
02:00040AF6 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5864:     ; Call this to put the address of door face tiles in [02:03].
                            	  5865:     ;
02:00040AFA 6100FD7A        	  5866:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5867:     ; Return the address of the door in the nametable in [01:00].
                            	  5868:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5869:     ;
02:00040AFE 41F9000408D4    	  5870:     lea     (DoorVramAddrsHi).l,A0
02:00040B04 10302000        	  5871:     move.b  (A0,D2.W),D0
02:00040B08 1880            	  5872:     move.b  D0,($0000,A4)
02:00040B0A 41F9000408D8    	  5873:     lea     (DoorVramAddrsLo).l,A0
02:00040B10 10302000        	  5874:     move.b  (A0,D2.W),D0
02:00040B14 19400001        	  5875:     move.b  D0,($0001,A4)
                            	  5876:     ; Return the direction of the door in [09], and the dynamic
                            	  5877:     ; transfer buf length in X register.
                            	  5878:     ;
02:00040B18 19420009        	  5879:     move.b  D2,($0009,A4)
02:00040B1C 7400            	  5880:     moveq   #0,D2
02:00040B1E 142C0301        	  5881:     move.b  ($0301,A4),D2
                            	  5882:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5883:     ;
02:00040B22 7000            	  5884:     moveq   #0,D0
02:00040B24 19400007        	  5885:     move.b  D0,($0007,A4)
02:00040B28 7002            	  5886:     moveq   #2,D0
02:00040B2A 19400006        	  5887:     move.b  D0,($0006,A4)
02:00040B2E 19400005        	  5888:     move.b  D0,($0005,A4)
02:00040B32 0A3C0001        	  5889:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040B36 4E75            	  5890:     rts
                            	  5891: 
                            	  5892:     even
