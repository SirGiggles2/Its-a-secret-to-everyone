                            	  2363: Burrower_AnimateDrawAndCheckCollisions:
02:00039110 4EB900049FC0    	  2364:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  2365:     ; If state = 0, return.
                            	  2366:     ;
02:00039116 41EC00AC        	  2367:     lea     ($00AC,A4),A0
