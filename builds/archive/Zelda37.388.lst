02:0003A6CE 122C0002        	  5406:     move.b  ($0002,A4),D1
02:0003A6D2 E309            	  5407:     lsl.b  #1,D1   ; ASL $02
02:0003A6D4 19410002        	  5408:     move.b  D1,($0002,A4)
02:0003A6D8 122C0002        	  5409:     move.b  ($0002,A4),D1
02:0003A6DC C200            	  5410:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A6DE 671E            	  5411:     beq  _L_z04_Digdogger_Move_End
02:0003A6E0 41EC0084        	  5412:     lea     ($0084,A4),A0
