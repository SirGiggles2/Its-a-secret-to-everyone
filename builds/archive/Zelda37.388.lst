02:00030CDE 19400002        	  2167:     move.b  D0,($0002,A4)
02:00030CE2 023C00EE        	  2168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030CE6 123C0002        	  2169:     move.b  #$02,D1
02:00030CEA D101            	  2170:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030CEC 19400003        	  2171:     move.b  D0,($0003,A4)
                            	  2172:     ; If object is Link, or object index/slot >= $D (weapons, room item),
