                            	  6126: _anon_z04_94:
                            	  6127:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  6128:     ; This is the base frame image.
                            	  6129:     ;
02:0003AC22 E208            	  6130:     lsr.b  #1,D0   ; LSR A
02:0003AC24 E208            	  6131:     lsr.b  #1,D0   ; LSR A
                            	  6132:     ; If movement frame = 1, add 3 to frame image to access
                            	  6133:     ; the second animation frame's images.
                            	  6134:     ;
02:0003AC26 7600            	  6135:     moveq   #0,D3
02:0003AC28 41EC03E4        	  6136:     lea     ($03E4,A4),A0
02:0003AC2C 16302000        	  6137:     move.b  (A0,D2.W),D3
02:0003AC30 671E            	  6138:     beq  _anon_z04_95
02:0003AC32 023C00EE        	  6139:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC36 123C0003        	  6140:     move.b  #$03,D1
02:0003AC3A D101            	  6141:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  6142:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  6143:     ;
                            	  6144:     ; Down has two frame images, but up only has one. By flipping
                            	  6145:     ; horizontally, you get two frame images.
                            	  6146:     ;
02:0003AC3C 7600            	  6147:     moveq   #0,D3
02:0003AC3E 41EC0098        	  6148:     lea     ($0098,A4),A0
02:0003AC42 16302000        	  6149:     move.b  (A0,D2.W),D3
