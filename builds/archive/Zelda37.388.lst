02:00049A42 41EC00AC        	  6073:     lea     ($00AC,A4),A0
02:00049A46 10302000        	  6074:     move.b  (A0,D2.W),D0
02:00049A4A 0200000F        	  6075:     andi.b #$0F,D0
02:00049A4E 7600            	  6076:     moveq   #0,D3
02:00049A50 1600            	  6077:     move.b  D0,D3
02:00049A52 7008            	  6078:     moveq   #8,D0
02:00049A54 5303            	  6079:     subq.b  #1,D3
02:00049A56 6708            	  6080:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00049A58 41EC0098        	  6081:     lea     ($0098,A4),A0
