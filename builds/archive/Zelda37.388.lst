02:00041678 1B00            	  7069:     move.b  D0,-(A5)  ; PHA
02:0004167A 7400            	  7070:     moveq   #0,D2
02:0004167C 1400            	  7071:     move.b  D0,D2
                            	  7072:     ; Align the object's Y coordinate with 16 pixels.
                            	  7073:     ;
02:0004167E 41EC0084        	  7074:     lea     ($0084,A4),A0
