                            	  5706: Aquamentus_Draw:
                            	  5707:     ; Every $10 screen frames, switch animation frames.
                            	  5708:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  5709:     ; The last tile of frame 0 is at index 5.
                            	  5710:     ; The last tile of frame 1 is at index $B.
                            	  5711:     ;
02:0003A90A 7605            	  5712:     moveq   #5,D3
02:0003A90C 102C0015        	  5713:     move.b  ($0015,A4),D0
02:0003A910 02000010        	  5714:     andi.b #$10,D0
02:0003A914 6602            	  5715:     bne  _anon_z04_88
02:0003A916 760B            	  5716:     moveq   #11,D3
                            	  5717: _anon_z04_88:
02:0003A918 1943000A        	  5718:     move.b  D3,($000A,A4)
                            	  5719:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  5720:     ;
02:0003A91C 7005            	  5721:     moveq   #5,D0
02:0003A91E 1940000B        	  5722:     move.b  D0,($000B,A4)
                            	  5723:     even
                            	  5724: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A922 7600            	  5725:     moveq   #0,D3
02:0003A924 162C000B        	  5726:     move.b  ($000B,A4),D3
                            	  5727:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  5728:     ; Store it in [00].
                            	  5729:     ;
02:0003A928 10342070        	  5730:     move.b  ($70,A4,D2.W),D0
02:0003A92C 023C00EE        	  5731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A930 41F90003A904    	  5732:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A936 12303000        	  5733:     move.b  (A0,D3.W),D1
02:0003A93A D101            	  5734:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A93C 1880            	  5735:     move.b  D0,($0000,A4)
                            	  5736:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  5737:     ; Store it in [01].
                            	  5738:     ;
02:0003A93E 41EC0084        	  5739:     lea     ($0084,A4),A0
02:0003A942 10302000        	  5740:     move.b  (A0,D2.W),D0
02:0003A946 023C00EE        	  5741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A94A 41F90003A8FE    	  5742:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A950 12303000        	  5743:     move.b  (A0,D3.W),D1
02:0003A954 D101            	  5744:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A956 19400001        	  5745:     move.b  D0,($0001,A4)
                            	  5746:     ; Calculate sprite attributes:
                            	  5747:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  5748:     ;
                            	  5749:     ; If the boss is temporarily invincible, then
                            	  5750:     ; this makes it flash by cycling all the palette rows.
                            	  5751:     ;
                            	  5752:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  5753:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  5754:     ;
02:0003A95A 41EC04F0        	  5755:     lea     ($04F0,A4),A0
02:0003A95E 10302000        	  5756:     move.b  (A0,D2.W),D0
02:0003A962 02000003        	  5757:     andi.b #$03,D0
02:0003A966 0A000003        	  5758:     eori.b #$03,D0
02:0003A96A 19400003        	  5759:     move.b  D0,($0003,A4)
02:0003A96E 7600            	  5760:     moveq   #0,D3
02:0003A970 162C000A        	  5761:     move.b  ($000A,A4),D3
                            	  5762:     ; Look up the tile for this sprite.
                            	  5763:     ; If it's not the first one (face), then go write the sprite record.
                            	  5764:     ;
02:0003A974 41F90003A8F2    	  5765:     lea     (AquamentusTiles).l,A0
02:0003A97A 10303000        	  5766:     move.b  (A0,D3.W),D0
02:0003A97E 12390003A8F2    	  5767:     move.b  (AquamentusTiles).l,D1
02:0003A984 B001            	  5768:     cmp.b   D1,D0
02:0003A986 6610            	  5769:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  5770:     ; Else it's the first one (the face tile).
                            	  5771:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  5772:     ;
                            	  5773:     ; $CC/CD shows the closed mouth face.
                            	  5774:     ; $C0/C1 shows the open mouth face.
                            	  5775:     ;
02:0003A988 7600            	  5776:     moveq   #0,D3
02:0003A98A 16342028        	  5777:     move.b  ($28,A4,D2.W),D3
02:0003A98E 0C030020        	  5778:     cmpi.b  #$20,D3
02:0003A992 6404            	  5779:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A994 103C00C0        	  5780:     move.b  #$C0,D0
                            	  5781:     even
                            	  5782: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003A998 610E            	  5783:     jsr     WriteBossSprite
                            	  5784:     ; Bottom of the loop.
                            	  5785:     ; Decrement tile index and loop index.
                            	  5786:     ;
02:0003A99A 532C000A        	  5787:     subq.b  #1,($000A,A4)
02:0003A99E 532C000B        	  5788:     subq.b  #1,($000B,A4)
02:0003A9A2 6A00FF7E        	  5789:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A9A6 4E75            	  5790:     rts
                            	  5791: 
                            	  5792: ; Params:
