                            	  3222: UpdatePondFairy:
02:00039704 610036B4        	  3223:     jsr     DrawFairy
                            	  3224:     ; If not in state 0, then go handle states 1 to 3.
                            	  3225:     ;
02:00039708 102C00AD        	  3226:     move.b  ($00AD,A4),D0
02:0003970C 6702            	  3227:     beq.s  __far_z_04_0028
02:0003970E 602A            	  3228:     jmp  PondFairy_HandleOtherStates
                            	  3229: __far_z_04_0028:
                            	  3230:     ; State 0.
                            	  3231:     ;
                            	  3232:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3233:     ;
02:00039710 102C0084        	  3234:     move.b  ($0084,A4),D0
02:00039714 0C0000AD        	  3235:     cmpi.b  #$AD,D0
02:00039718 661E            	  3236:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3237:     ; If Link's X < $70 or >= $81, then return.
                            	  3238:     ;
02:0003971A 102C0070        	  3239:     move.b  ($0070,A4),D0
02:0003971E 0C000070        	  3240:     cmpi.b  #$70,D0
02:00039722 6514            	  3241:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039724 0C000081        	  3242:     cmpi.b  #$81,D0
02:00039728 640E            	  3243:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3244:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3245:     ; halt Link, and start filling hearts.
                            	  3246:     ;
02:0003972A 522C00AD        	  3247:     addq.b  #1,($00AD,A4)
02:0003972E 7040            	  3248:     moveq   #64,D0
02:00039730 194000AC        	  3249:     move.b  D0,($00AC,A4)
02:00039734 19400063        	  3250:     move.b  D0,($0063,A4)
                            	  3251:     even
