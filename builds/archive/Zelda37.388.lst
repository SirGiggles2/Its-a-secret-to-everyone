                            	  5777: AnimateBoomerangAndCheckCollision:
                            	  5778:     ; Decrement animation counter; and when it reaches 0:
                            	  5779:     ; 1. arm it again for 2 frames
                            	  5780:     ; 2. advance the minor state within a cycle of 8
                            	  5781:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5782:     ;
02:000497FE 41EC03D0        	  5783:     lea     ($03D0,A4),A0
02:00049802 53302000        	  5784:     subq.b  #1,(A0,D2.W)
02:00049806 6702            	  5785:     beq.s  __far_z_07_0086
02:00049808 6036            	  5786:     jmp  DrawBoomerangAndCheckCollision
                            	  5787: __far_z_07_0086:
02:0004980A 7002            	  5788:     moveq   #2,D0
02:0004980C 41EC03D0        	  5789:     lea     ($03D0,A4),A0
02:00049810 11802000        	  5790:     move.b  D0,(A0,D2.W)
02:00049814 41EC00AC        	  5791:     lea     ($00AC,A4),A0
02:00049818 52302000        	  5792:     addq.b  #1,(A0,D2.W)
02:0004981C 41EC00AC        	  5793:     lea     ($00AC,A4),A0
02:00049820 10302000        	  5794:     move.b  (A0,D2.W),D0
02:00049824 02000077        	  5795:     andi.b #$77,D0
02:00049828 41EC00AC        	  5796:     lea     ($00AC,A4),A0
02:0004982C 11802000        	  5797:     move.b  D0,(A0,D2.W)
02:00049830 0C02000D        	  5798:     cmpi.b  #$0D,D2
02:00049834 6402            	  5799:     bcc.s  __far_z_07_0087
02:00049836 6032            	  5800:     jmp  CalcBoomerangFrame
                            	  5801: __far_z_07_0087:
