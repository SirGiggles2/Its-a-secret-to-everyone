                            	  5652: _L_z07_CheckState30_CheckOtherStates:
                            	  5653:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5654:     ;
                            	  5655:     ; The boomerang will now return. Reset the grid offset.
                            	  5656:     ;
02:00049714 7000            	  5657:     moveq   #0,D0
02:00049716 41EC0394        	  5658:     lea     ($0394,A4),A0
02:0004971A 11802000        	  5659:     move.b  D0,(A0,D2.W)
                            	  5660:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5661:     ;
02:0004971E 0C02000D        	  5662:     cmpi.b  #$0D,D2
02:00049722 6408            	  5663:     bcc  _anon_z07_30
02:00049724 41EC042C        	  5664:     lea     ($042C,A4),A0
