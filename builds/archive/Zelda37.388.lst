                            	  4206:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00048D76 4A02            	  4207:     tst.b   D2
02:00048D78 6608            	  4208:     bne.s   _L_z07_CheckTiles_notLink
02:00048D7A 197C0024049E    	  4209:     move.b  #$24,($049E,A4)
02:00048D80 605E            	  4210:     jmp     GoWalkableDir
                            	  4211: _L_z07_CheckTiles_notLink:
                            	  4212:     endc
                            	  4213:     ; The code below applies to Link and other objects.
                            	  4214:     ;
                            	  4215:     ; Test the moving direction's walkability.
                            	  4216:     ;
                            	  4217:     ; For the player, this is enough. For other objects, this 
                            	  4218:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4219:     ;
                            	  4220:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4221:     ;
02:00048D82 6100FB88        	  4222:     jsr     GetCollidingTileMoving
02:00048D86 122C034A        	  4223:     move.b  ($034A,A4),D1
02:00048D8A B001            	  4224:     cmp.b   D1,D0
02:00048D8C 6402            	  4225:     bcc.s  __far_z_07_0052
02:00048D8E 6050            	  4226:     jmp  GoWalkableDir
