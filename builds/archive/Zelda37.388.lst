                            	   150: TransferCurTileBuf:
                            	   151:     ; PATCHED: DynTileBuf pending-record pre-check (generalized Bug C fix).
                            	   152:     ; If DynTileBuf is non-empty while TileBufSelector already points at a
                            	   153:     ; later static buffer, consume DynTileBuf first and leave selector intact
                            	   154:     ; for the next NMI. This preserves NES ordering for dynamic room/menu
                            	   155:     ; records that would otherwise be dropped by selector timing drift.
02:000429D8 41F900FF0302    	   156:     lea     (NES_RAM+DynTileBuf).l,A0
02:000429DE 0C1000FF        	   157:     cmpi.b  #$FF,(A0)                  ; DynTileBuf empty sentinel?
02:000429E2 672E            	   158:     beq.s   .no_pending_dyn
02:000429E4 4A2C0014        	   159:     tst.b   ($0014,A4)                  ; TileBufSelector = 0 => normal DynTileBuf path
02:000429E8 6728            	   160:     beq.s   .no_pending_dyn
02:000429EA 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:000429EE 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:000429F4 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:000429F8 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:00042A00 703F            	   165:     moveq   #63,D0
02:00042A02 19400300        	   166:     move.b  D0,($0300,A4)
02:00042A06 7400            	   167:     moveq   #0,D2
02:00042A08 1942005C        	   168:     move.b  D2,($005C,A4)
02:00042A0C 19420301        	   169:     move.b  D2,($0301,A4)
02:00042A10 4E75            	   170:     rts
                            	   171: .no_pending_dyn:
                            	   172:     ; 32-bit pointer table lookup for main dispatch.
02:00042A12 7400            	   173:     moveq   #0,D2
02:00042A14 142C0014        	   174:     move.b  ($0014,A4),D2
02:00042A18 D442            	   175:     add.w   D2,D2                       ; 2-byte index -> 4-byte index
02:00042A1A 43F900044780    	   176:     lea     (TransferBufPtrs).l,A1
02:00042A20 20312000        	   177:     move.l  (A1,D2.W),D0               ; D0 = 32-bit buffer pointer
02:00042A24 2040            	   178:     movea.l D0,A0                      ; A0 = 32-bit buffer pointer
02:00042A26 611C            	   179:     jsr     TransferTileBuf
02:00042A28 703F            	   180:     moveq   #63,D0
02:00042A2A 19400300        	   181:     move.b  D0,($0300,A4)
02:00042A2E 7400            	   182:     moveq   #0,D2
02:00042A30 19420014        	   183:     move.b  D2,($0014,A4)
02:00042A34 1942005C        	   184:     move.b  D2,($005C,A4)
02:00042A38 19420301        	   185:     move.b  D2,($0301,A4)
02:00042A3C 5302            	   186:     subq.b  #1,D2
02:00042A3E 19420302        	   187:     move.b  D2,($0302,A4)
