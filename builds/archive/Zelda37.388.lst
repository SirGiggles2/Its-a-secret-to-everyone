02:0002F3A0 1880            	   774:     move.b  D0,($0000,A4)
02:0002F3A2 102C0001        	   775:     move.b  ($0001,A4),D0
02:0002F3A6 123C0000        	   776:     move.b  #$00,D1
02:0002F3AA D101            	   777:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F3AC 19400001        	   778:     move.b  D0,($0001,A4)
                            	   779:     ; Increment destination address.
                            	   780:     ;
02:0002F3B0 102C0002        	   781:     move.b  ($0002,A4),D0
02:0002F3B4 023C00EE        	   782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F3B8 123C0001        	   783:     move.b  #$01,D1
