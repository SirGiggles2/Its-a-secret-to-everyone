02:0003A8CA 023C00EE        	  5668:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8CE 41EC0478        	  5669:     lea     ($0478,A4),A0
02:0003A8D2 12302000        	  5670:     move.b  (A0,D2.W),D1
02:0003A8D6 D101            	  5671:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A8D8 41EC0084        	  5672:     lea     ($0084,A4),A0
02:0003A8DC 11802000        	  5673:     move.b  D0,(A0,D2.W)
