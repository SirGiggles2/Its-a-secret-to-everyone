                            	  5314: Digdogger_Move:
                            	  5315:     ; This calculation is the same one used in Manhandla to
                            	  5316:     ; manifest the fractional speed over several frames.
                            	  5317:     ;
                            	  5318:     ; To summarize, the formula is:
                            	  5319:     ;
                            	  5320:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  5321:     ;
                            	  5322:     ;   SA := SA + (SL AND $E0)
                            	  5323:     ;   [03] := SH + carry
                            	  5324:     ;
                            	  5325:     ; See 04:A28E Manhandla_Move.
                            	  5326:     ;
02:0003A608 41EC041F        	  5327:     lea     ($041F,A4),A0
02:0003A60C 10302000        	  5328:     move.b  (A0,D2.W),D0
02:0003A610 020000E0        	  5329:     andi.b #$E0,D0
02:0003A614 023C00EE        	  5330:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A618 41EC0412        	  5331:     lea     ($0412,A4),A0
02:0003A61C 12302000        	  5332:     move.b  (A0,D2.W),D1
02:0003A620 D101            	  5333:     addx.b  D1,D0   ; ADC $0412,X
02:0003A622 41EC0412        	  5334:     lea     ($0412,A4),A0
02:0003A626 11802000        	  5335:     move.b  D0,(A0,D2.W)
                            	  5336:     ; Assign (high speed byte + carry) to [03].
                            	  5337:     ;
02:0003A62A 41EC042C        	  5338:     lea     ($042C,A4),A0
02:0003A62E 10302000        	  5339:     move.b  (A0,D2.W),D0
02:0003A632 123C0000        	  5340:     move.b  #$00,D1
02:0003A636 D101            	  5341:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A638 19400003        	  5342:     move.b  D0,($0003,A4)
                            	  5343:     ; Change coordinates by the speed amount/offset in [03]
                            	  5344:     ; according to the direction.
                            	  5345:     ;
                            	  5346:     ; Start with a mask of $A1 in [02]:
                            	  5347:     ; - low nibble represents the right direction
                            	  5348:     ; - high nibble is used to set or clear carry as we go along
                            	  5349:     ;
02:0003A63C 103C00A1        	  5350:     move.b  #$A1,D0
02:0003A640 19400002        	  5351:     move.b  D0,($0002,A4)
                            	  5352:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  5353:     ;
02:0003A644 41EC0098        	  5354:     lea     ($0098,A4),A0
02:0003A648 10302000        	  5355:     move.b  (A0,D2.W),D0
02:0003A64C 122C0002        	  5356:     move.b  ($0002,A4),D1
02:0003A650 C200            	  5357:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A652 6712            	  5358:     beq  _L_z04_Digdogger_Move_Left
02:0003A654 10342070        	  5359:     move.b  ($70,A4,D2.W),D0
02:0003A658 023C00EE        	  5360:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A65C 122C0003        	  5361:     move.b  ($0003,A4),D1
02:0003A660 D101            	  5362:     addx.b  D1,D0   ; ADC $03
02:0003A662 19802070        	  5363:     move.b  D0,($70,A4,D2.W)
                            	  5364:     even
                            	  5365: _L_z04_Digdogger_Move_Left:
                            	  5366:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  5367:     ;
02:0003A666 41EC0098        	  5368:     lea     ($0098,A4),A0
02:0003A66A 10302000        	  5369:     move.b  (A0,D2.W),D0
02:0003A66E 122C0002        	  5370:     move.b  ($0002,A4),D1
02:0003A672 E309            	  5371:     lsl.b  #1,D1   ; ASL $02
02:0003A674 19410002        	  5372:     move.b  D1,($0002,A4)
02:0003A678 122C0002        	  5373:     move.b  ($0002,A4),D1
02:0003A67C C200            	  5374:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A67E 6716            	  5375:     beq  _L_z04_Digdogger_Move_Down
02:0003A680 10342070        	  5376:     move.b  ($70,A4,D2.W),D0
02:0003A684 122C0003        	  5377:     move.b  ($0003,A4),D1
02:0003A688 0A3C0010        	  5378:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A68C 9101            	  5379:     subx.b  D1,D0   ; SBC $03
02:0003A68E 0A3C0010        	  5380:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A692 19802070        	  5381:     move.b  D0,($70,A4,D2.W)
                            	  5382:     even
