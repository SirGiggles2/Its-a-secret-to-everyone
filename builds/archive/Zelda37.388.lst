02:00049938 6000FB70        	  5933:     jmp     UpdateArrowOrBoomerang
                            	  5934: 
                            	  5935: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5936: ; Each set contains 4 offsets in reverse direction index order:
                            	  5937: ; up, down, left, right
                            	  5938: ;
                            	  5939: ; These offsets are added to player X to get weapon X.
                            	  5940: ;
                            	  5941:     even
                            	  5942: PlayerToWeaponOffsetsX:
02:0004993C FF              	  5943:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004993D 01
02:0004993E 00
02:0004993F F8
02:00049940 FF
02:00049941 01
02:00049942 F5
02:00049943 0B
02:00049944 FF              	  5944:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:00049945 01
02:00049946 F9
02:00049947 07
02:00049948 FF
02:00049949 01
02:0004994A FD
02:0004994B 03
                            	  5945: 
                            	  5946: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5947: ; Each set contains 4 offsets in reverse direction index order:
                            	  5948: ; up, down, left, right
                            	  5949: ;
                            	  5950: ; These offsets are added to player Y to get weapon Y.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PlayerToWeaponOffsetsY:
02:0004994C F7              	  5954:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:0004994D F2
02:0004994E F5
02:0004994F F5
02:00049950 F6
02:00049951 0D
02:00049952 03
02:00049953 03
02:00049954 F7              	  5955:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:00049955 09
02:00049956 03
02:00049957 03
02:00049958 FF
02:00049959 05
02:0004995A 03
02:0004995B 03
