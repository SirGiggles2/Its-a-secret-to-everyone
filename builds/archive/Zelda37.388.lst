02:0003C4C4 162C045F        	  9363:     move.b  ($045F,A4),D3
                            	  9364:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  9365:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  9366:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  9367:     ;
