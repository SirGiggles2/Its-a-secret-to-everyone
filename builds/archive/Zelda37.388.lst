                            	  6785:     ; Timer = 0. Only teleporting now.
                            	  6786:     ;
                            	  6787:     ; If there is still distance to go while translucent, then
                            	  6788:     ; decrement the distance remaining, and move.
                            	  6789:     ;
02:0003B154 41EC0394        	  6790:     lea     ($0394,A4),A0
02:0003B158 10302000        	  6791:     move.b  (A0,D2.W),D0
02:0003B15C 670A            	  6792:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003B15E 41EC0394        	  6793:     lea     ($0394,A4),A0
