                            	  5155: _L_z02_DrawCredits_IncVramLine:
02:000354E2 522C050D        	  5156:     addq.b  #1,($050D,A4)
                            	  5157:     ; In each VRAM page there are 8 lines, except in ones where
                            	  5158:     ; (page MOD 4) = 3. This means $23xx and $2Bxx.
                            	  5159:     ; These pages have 6 lines.
                            	  5160:     ;
02:000354E6 102C050C        	  5161:     move.b  ($050C,A4),D0
02:000354EA 02000003        	  5162:     andi.b #$03,D0
02:000354EE 0C000003        	  5163:     cmpi.b  #$03,D0
02:000354F2 7008            	  5164:     moveq   #8,D0
02:000354F4 6502            	  5165:     bcs  _anon_z02_49
02:000354F6 7006            	  5166:     moveq   #6,D0
                            	  5167: _anon_z02_49:
                            	  5168:     ; If the VRAM line number has not just been incremented to
                            	  5169:     ; the reference line number count, then go write NT attributes.
                            	  5170:     ;
02:000354F8 122C050D        	  5171:     move.b  ($050D,A4),D1
02:000354FC B001            	  5172:     cmp.b   D1,D0
02:000354FE 661C            	  5173:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5174:     ; Else roll over the VRAM line to 0.
                            	  5175:     ;
02:00035500 7000            	  5176:     moveq   #0,D0
02:00035502 1940050D        	  5177:     move.b  D0,($050D,A4)
                            	  5178:     ; Increment the VRAM page number.
                            	  5179:     ;
02:00035506 7600            	  5180:     moveq   #0,D3
02:00035508 162C050C        	  5181:     move.b  ($050C,A4),D3
02:0003550C 5203            	  5182:     addq.b  #1,D3
                            	  5183:     ; If it has reached $C, then roll it over to 0.
                            	  5184:     ;
02:0003550E 0C03000C        	  5185:     cmpi.b  #$0C,D3
02:00035512 6504            	  5186:     bcs  _anon_z02_50
02:00035514 7600            	  5187:     moveq   #0,D3
02:00035516 1600            	  5188:     move.b  D0,D3
                            	  5189: _anon_z02_50:
