                            	  1269:     even
                            	  1270: _L_z04_UpdateStatues_Shoot:
                            	  1271:     ; Look for an empty monster slot.
                            	  1272:     ; If none is found, return.
                            	  1273:     ;
                            	  1274:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1275:     ; object. This routine takes a shooter object, and instantiates
                            	  1276:     ; a fireball object at the shooter's location.
                            	  1277:     ;
                            	  1278:     ; The object slot we set up here will behave as the shooter.
                            	  1279:     ; For each fireball index, this object slot will have its coordinates
                            	  1280:     ; changed.
                            	  1281:     ;
                            	  1282:     ; Note that this means that:
                            	  1283:     ; 1. The first fireball made will be its own shooter.
                            	  1284:     ;    Practically, there's nothing special about this.
                            	  1285:     ; 2. If there is more than one fireball made in a frame,
                            	  1286:     ;    then two of them will come from the same statue.
                            	  1287:     ;
                            	  1288:     ;
                            	  1289:     ; Save the fireball pattern.
02:000389A6 1003            	  1290:     move.b  D3,D0
02:000389A8 1B00            	  1291:     move.b  D0,-(A5)  ; PHA
02:000389AA 4EB90004A7AE    	  1292:     jsr     FindEmptyMonsterSlot
02:000389B0 0C000001        	  1293:     cmpi.b  #$01,D0
02:000389B4 101D            	  1294:     move.b  (A5)+,D0  ; PLA
02:000389B6 6400010A        	  1295:     bcc  _L_z04_UpdateStatues_Exit
                            	  1296:     ; If we found a slot, but it < 6, return.
                            	  1297:     ;
02:000389BA 0C030006        	  1298:     cmpi.b  #$06,D3
02:000389BE 65000102        	  1299:     bcs  _L_z04_UpdateStatues_Exit
                            	  1300:     ; Store the object slot in [0A].
                            	  1301:     ; Store fireball pattern in [0B].
                            	  1302:     ;
02:000389C2 1943000A        	  1303:     move.b  D3,($000A,A4)
02:000389C6 1940000B        	  1304:     move.b  D0,($000B,A4)
                            	  1305:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1306:     ;
02:000389CA 7600            	  1307:     moveq   #0,D3
02:000389CC 1600            	  1308:     move.b  D0,D3
02:000389CE 7400            	  1309:     moveq   #0,D2
02:000389D0 41F900038962    	  1310:     lea     (StatueFireballCounts).l,A0
02:000389D6 14303000        	  1311:     move.b  (A0,D3.W),D2
                            	  1312:     even
                            	  1313: _L_z04_UpdateStatues_LoopFireball:
                            	  1314:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1315:     ;
                            	  1316:     ; Decrement the fireball timer at this index.
                            	  1317:     ;
02:000389DA 7600            	  1318:     moveq   #0,D3
02:000389DC 41EC04E8        	  1319:     lea     ($04E8,A4),A0
02:000389E0 16302000        	  1320:     move.b  (A0,D2.W),D3
02:000389E4 5303            	  1321:     subq.b  #1,D3
02:000389E6 1003            	  1322:     move.b  D3,D0
02:000389E8 41EC04E8        	  1323:     lea     ($04E8,A4),A0
02:000389EC 11802000        	  1324:     move.b  D0,(A0,D2.W)
                            	  1325:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1326:     ; to make a fireball. Go loop again.
                            	  1327:     ;
02:000389F0 5203            	  1328:     addq.b  #1,D3
02:000389F2 660000C8        	  1329:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1330:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1331:     ; This fireball index will wait another $100 frames.
                            	  1332:     ;
02:000389F6 10342018        	  1333:     move.b  ($18,A4,D2.W),D0
02:000389FA 0C0000F0        	  1334:     cmpi.b  #$F0,D0
02:000389FE 640000BC        	  1335:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1336:     ; Else choose one of four start times for the fireball based on
                            	  1337:     ; the random value.
                            	  1338:     ;
02:00038A02 02000003        	  1339:     andi.b #$03,D0
02:00038A06 7600            	  1340:     moveq   #0,D3
02:00038A08 1600            	  1341:     move.b  D0,D3
02:00038A0A 41F900038966    	  1342:     lea     (StatueFireballStartTimes).l,A0
02:00038A10 10303000        	  1343:     move.b  (A0,D3.W),D0
02:00038A14 41EC04E8        	  1344:     lea     ($04E8,A4),A0
02:00038A18 11802000        	  1345:     move.b  D0,(A0,D2.W)
                            	  1346:     ; The coordinate lists are divided into sets for each pattern.
                            	  1347:     ;
                            	  1348:     ; Look up the index of the base of the set for the pattern in use.
                            	  1349:     ; Add it to the fireball index in X register to get the index of
                            	  1350:     ; the coordinate we want within each coordinate list.
                            	  1351:     ;
                            	  1352:     ;
                            	  1353:     ; Pattern
02:00038A1C 7600            	  1354:     moveq   #0,D3
02:00038A1E 162C000B        	  1355:     move.b  ($000B,A4),D3
02:00038A22 1002            	  1356:     move.b  D2,D0
02:00038A24 023C00EE        	  1357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038A28 41F90003896A    	  1358:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038A2E 12303000        	  1359:     move.b  (A0,D3.W),D1
02:00038A32 D101            	  1360:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00038A34 7600            	  1361:     moveq   #0,D3
02:00038A36 1600            	  1362:     move.b  D0,D3
02:00038A38 1002            	  1363:     move.b  D2,D0
02:00038A3A 1B00            	  1364:     move.b  D0,-(A5)  ; PHA
                            	  1365:     ; Get Link's coordinates into [00] and [01].
                            	  1366:     ;
02:00038A3C 7400            	  1367:     moveq   #0,D2
02:00038A3E 4EB900049FC6    	  1368:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1369:     ; Switch to the new fireball's object slot.
                            	  1370:     ;
02:00038A44 7400            	  1371:     moveq   #0,D2
02:00038A46 142C000A        	  1372:     move.b  ($000A,A4),D2
                            	  1373:     ; Look up and set the X coordinate for the fireball object.
                            	  1374:     ; Also store it in [02].
                            	  1375:     ;
02:00038A4A 41F90003896E    	  1376:     lea     (StatueXs).l,A0
02:00038A50 10303000        	  1377:     move.b  (A0,D3.W),D0
02:00038A54 19400002        	  1378:     move.b  D0,($0002,A4)
02:00038A58 19802070        	  1379:     move.b  D0,($70,A4,D2.W)
                            	  1380:     ; Look up and set the Y coordinate for the fireball object.
                            	  1381:     ; Also store it in [03].
                            	  1382:     ;
02:00038A5C 41F900038976    	  1383:     lea     (StatueYs).l,A0
02:00038A62 10303000        	  1384:     move.b  (A0,D3.W),D0
02:00038A66 19400003        	  1385:     move.b  D0,($0003,A4)
02:00038A6A 41EC0084        	  1386:     lea     ($0084,A4),A0
02:00038A6E 11802000        	  1387:     move.b  D0,(A0,D2.W)
                            	  1388:     ; Set mask value 3 in [04].
                            	  1389:     ;
02:00038A72 7003            	  1390:     moveq   #3,D0
02:00038A74 19400004        	  1391:     move.b  D0,($0004,A4)
                            	  1392:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1393:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1394:     ;
02:00038A78 7601            	  1395:     moveq   #1,D3
                            	  1396:     even
                            	  1397: _L_z04_UpdateStatues_LoopAxis:
02:00038A7A 10343000        	  1398:     move.b  ($00,A4,D3.W),D0
02:00038A7E 003C0011        	  1399:     ori     #$11,CCR  ; SEC: set C+X
02:00038A82 12343002        	  1400:     move.b  ($02,A4,D3.W),D1
02:00038A86 0A3C0010        	  1401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038A8A 9101            	  1402:     subx.b  D1,D0   ; SBC $0002,Y
02:00038A8C 0A3C0010        	  1403:     eori    #$10,CCR  ; restore X = 6502 C
02:00038A90 0C000018        	  1404:     cmpi.b  #$18,D0
02:00038A94 6A10            	  1405:     bpl  _anon_z04_31
02:00038A96 0C0000E8        	  1406:     cmpi.b  #$E8,D0
02:00038A9A 6B0A            	  1407:     bmi  _anon_z04_31
02:00038A9C 122C0004        	  1408:     move.b  ($0004,A4),D1
02:00038AA0 E209            	  1409:     lsr.b  #1,D1   ; LSR $04
02:00038AA2 19410004        	  1410:     move.b  D1,($0004,A4)
                            	  1411: _anon_z04_31:
02:00038AA6 5303            	  1412:     subq.b  #1,D3
02:00038AA8 6AD0            	  1413:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1414:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1415:     ; 0 or 1 time, instead of 2.
                            	  1416:     ;
                            	  1417:     ; This, in turn, means that the distance between Link and the
                            	  1418:     ; fireball was >= $18 in at least one axis.
                            	  1419:     ;
                            	  1420:     ; So, we're OK to finish making the fireball.
                            	  1421:     ;
02:00038AAA 102C0004        	  1422:     move.b  ($0004,A4),D0
02:00038AAE 6706            	  1423:     beq  _anon_z04_32
02:00038AB0 7055            	  1424:     moveq   #85,D0
02:00038AB2 6100FB02        	  1425:     jsr     ShootFireball
                            	  1426: _anon_z04_32:
02:00038AB6 101D            	  1427:     move.b  (A5)+,D0  ; PLA
02:00038AB8 7400            	  1428:     moveq   #0,D2
02:00038ABA 1400            	  1429:     move.b  D0,D2
                            	  1430:     even
                            	  1431: _L_z04_UpdateStatues_NextLoopFireball:
                            	  1432:     ; Bottom of the loop.
                            	  1433:     ; Loop while fireball index >= 0.
                            	  1434:     ;
02:00038ABC 5302            	  1435:     subq.b  #1,D2
02:00038ABE 6A00FF1A        	  1436:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  1437:     even
