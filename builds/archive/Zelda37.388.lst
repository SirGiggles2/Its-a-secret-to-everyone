02:00049450 19400061        	  5234:     move.b  D0,($0061,A4)
02:00049454 41EC0084        	  5235:     lea     ($0084,A4),A0
02:00049458 10302000        	  5236:     move.b  (A0,D2.W),D0
02:0004945C 19400062        	  5237:     move.b  D0,($0062,A4)
