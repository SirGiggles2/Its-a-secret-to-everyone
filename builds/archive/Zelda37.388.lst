02:00039510 1940000D        	  2900:     move.b  D0,($000D,A4)
                            	  2901:     ; If the direction has an "up" component, then keep the
                            	  2902:     ; frame image 0, and go figure out horizontal flipping.
                            	  2903:     ;
02:00039514 41EC0098        	  2904:     lea     ($0098,A4),A0
02:00039518 10302000        	  2905:     move.b  (A0,D2.W),D0
