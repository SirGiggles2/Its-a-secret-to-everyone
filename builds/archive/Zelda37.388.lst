                            	  3052:     ; Bottom of the loop.
                            	  3053:     ;
02:000395E8 5303            	  3054:     subq.b  #1,D3
02:000395EA 6AA2            	  3055:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3056:     even
                            	  3057: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3058:     ; Not found, or found the power bracelet.
