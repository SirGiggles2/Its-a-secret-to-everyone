                            	  3223:     ; If he's not on any, then return.
                            	  3224:     ;
02:0003EE00 7601            	  3225:     moveq   #1,D3
02:0003EE02 102C0070        	  3226:     move.b  ($0070,A4),D0
02:0003EE06 0C000050        	  3227:     cmpi.b  #$50,D0
02:0003EE0A 6712            	  3228:     beq  _anon_z05_83
02:0003EE0C 5203            	  3229:     addq.b  #1,D3
02:0003EE0E 0C000080        	  3230:     cmpi.b  #$80,D0
02:0003EE12 670A            	  3231:     beq  _anon_z05_83
02:0003EE14 5203            	  3232:     addq.b  #1,D3
02:0003EE16 0C0000B0        	  3233:     cmpi.b  #$B0,D0
02:0003EE1A 6702            	  3234:     beq.s  __far_z_05_0062
02:0003EE1C 604C            	  3235:     jmp  L14F72_Exit
