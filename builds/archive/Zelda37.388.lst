02:000497B6 4EB9000308A4    	  5755:     jsr     SetBoomerangSpeed
02:000497BC 102C000A        	  5756:     move.b  ($000A,A4),D0
02:000497C0 1940000F        	  5757:     move.b  D0,($000F,A4)
02:000497C4 41EC0098        	  5758:     lea     ($0098,A4),A0
