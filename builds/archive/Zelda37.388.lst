                            	  2320: _L_z04_UpdateBurrower_CycleState:
                            	  2321:     ; Cycle the state between 0 and 5.
                            	  2322:     ;
02:000390B6 41EC00AC        	  2323:     lea     ($00AC,A4),A0
02:000390BA 10302000        	  2324:     move.b  (A0,D2.W),D0
02:000390BE 023C00EE        	  2325:     andi    #$EE,CCR  ; CLC: clear C+X
02:000390C2 123C0001        	  2326:     move.b  #$01,D1
02:000390C6 D101            	  2327:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000390C8 0C000006        	  2328:     cmpi.b  #$06,D0
02:000390CC 6502            	  2329:     bcs  _anon_z04_41
