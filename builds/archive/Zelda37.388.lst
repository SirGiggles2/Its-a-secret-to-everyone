02:0003A89C 103C00FF        	  5639:     move.b  #$FF,D0
02:0003A8A0 41EC0478        	  5640:     lea     ($0478,A4),A0
02:0003A8A4 11803000        	  5641:     move.b  D0,(A0,D3.W)
02:0003A8A8 4E75            	  5642:     rts
