02:0003398E 610E            	  2576:     jsr     ModifyFlashingCursorY
02:00033990 19430208        	  2577:     move.b  D3,($0208,A4)
02:00033994 102C0071        	  2578:     move.b  ($0071,A4),D0
02:00033998 1940020B        	  2579:     move.b  D0,($020B,A4)
02:0003399C 4E75            	  2580:     rts
                            	  2581: 
                            	  2582: ; Params:
                            	  2583: ; A: cursor Y
                            	  2584: ;
                            	  2585: ; Returns:
                            	  2586: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2587: ;
                            	  2588: ; Description:
                            	  2589: ; Adjust the Y coordinate to account for the visible part of
                            	  2590: ; block cursor being in the bottom half of sprite.
                            	  2591: ; Also, make the cursor flash.
                            	  2592: ;
                            	  2593:     even
