                            	  4231:     ; the screen edge, or stop moving.
                            	  4232:     ;
02:00048D90 4A02            	  4233:     cmpi.b  #$00,D2
02:00048D92 6602            	  4234:     bne.s  __far_z_07_0053
02:00048D94 6022            	  4235:     jmp  PlayerUnwalkable
                            	  4236: __far_z_07_0053:
                            	  4237:     even
