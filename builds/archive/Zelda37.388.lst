                            	  3285: CheckCaveEdge:
02:0003EE6C 4EB900048E06    	  3286:     jsr     CheckScreenEdge
                            	  3287:     ; If the player touched the edge of the screen and triggered
                            	  3288:     ; a transition to another mode, then go set up the right mode.
                            	  3289:     ;
02:0003EE72 102C0011        	  3290:     move.b  ($0011,A4),D0
02:0003EE76 6602            	  3291:     bne.s  __far_z_05_0063
02:0003EE78 60E4            	  3292:     jmp  GoToModeAFromCave
                            	  3293: __far_z_05_0063:
02:0003EE7A 4E75            	  3294:     rts
                            	  3295: 
                            	  3296: ; Params:
                            	  3297: ; [0F]: movement direction
                            	  3298: ;
                            	  3299: ; Returns:
                            	  3300: ; [0F]: movement direction or 0
                            	  3301: ;
                            	  3302: ;
                            	  3303: ; If the ladder's not in use, return.
                            	  3304: ;
                            	  3305:     even
                            	  3306: CheckLadder:
02:0003EE7C 7400            	  3307:     moveq   #0,D2
02:0003EE7E 142C0064        	  3308:     move.b  ($0064,A4),D2
02:0003EE82 670000BE        	  3309:     beq  _L_z05_CheckLadder_Exit
                            	  3310:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3311:     ;
02:0003EE86 41EC00AC        	  3312:     lea     ($00AC,A4),A0
02:0003EE8A 10302000        	  3313:     move.b  (A0,D2.W),D0
02:0003EE8E 670000A6        	  3314:     beq  _L_z05_CheckLadder_StashLadder
                            	  3315:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3316:     ; between the ladder and Link.
                            	  3317:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3318:     ;
02:0003EE92 41EC0098        	  3319:     lea     ($0098,A4),A0
02:0003EE96 10302000        	  3320:     move.b  (A0,D2.W),D0
02:0003EE9A 0200000C        	  3321:     andi.b #$0C,D0
02:0003EE9E 6734            	  3322:     beq  _anon_z05_85
02:0003EEA0 102C0070        	  3323:     move.b  ($0070,A4),D0
02:0003EEA4 12342070        	  3324:     move.b  ($70,A4,D2.W),D1
02:0003EEA8 B001            	  3325:     cmp.b   D1,D0
02:0003EEAA 6600008A        	  3326:     bne  _L_z05_CheckLadder_StashLadder
02:0003EEAE 102C0084        	  3327:     move.b  ($0084,A4),D0
02:0003EEB2 023C00EE        	  3328:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEB6 123C0003        	  3329:     move.b  #$03,D1
02:0003EEBA D101            	  3330:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EEBC 003C0011        	  3331:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEC0 41EC0084        	  3332:     lea     ($0084,A4),A0
02:0003EEC4 12302000        	  3333:     move.b  (A0,D2.W),D1
02:0003EEC8 0A3C0010        	  3334:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EECC 9101            	  3335:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EECE 0A3C0010        	  3336:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EED2 6030            	  3337:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3338: 
                            	  3339: _anon_z05_85:
                            	  3340:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3341:     ; between the ladder and Link.
                            	  3342:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3343:     ;
02:0003EED4 102C0084        	  3344:     move.b  ($0084,A4),D0
02:0003EED8 023C00EE        	  3345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEDC 123C0003        	  3346:     move.b  #$03,D1
02:0003EEE0 D101            	  3347:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EEE2 41EC0084        	  3348:     lea     ($0084,A4),A0
02:0003EEE6 12302000        	  3349:     move.b  (A0,D2.W),D1
02:0003EEEA B001            	  3350:     cmp.b   D1,D0
02:0003EEEC 6648            	  3351:     bne  _L_z05_CheckLadder_StashLadder
02:0003EEEE 102C0070        	  3352:     move.b  ($0070,A4),D0
02:0003EEF2 003C0011        	  3353:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEF6 12342070        	  3354:     move.b  ($70,A4,D2.W),D1
02:0003EEFA 0A3C0010        	  3355:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEFE 9101            	  3356:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EF00 0A3C0010        	  3357:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3358:     even
                            	  3359: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3360:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3361:     ; If > $10, go put the ladder away.
                            	  3362:     ;
02:0003EF04 4EB900030890    	  3363:     jsr     Abs
02:0003EF0A 1880            	  3364:     move.b  D0,($0000,A4)
02:0003EF0C 0C000010        	  3365:     cmpi.b  #$10,D0
02:0003EF10 6532            	  3366:     bcs  _L_z05_CheckLadder_SetState2
02:0003EF12 0C000010        	  3367:     cmpi.b  #$10,D0
02:0003EF16 661E            	  3368:     bne  _L_z05_CheckLadder_StashLadder
                            	  3369:     ; Distance = $10. If player's not facing in the same direction as
                            	  3370:     ; the ladder, go put away the ladder.
                            	  3371:     ;
02:0003EF18 102C0098        	  3372:     move.b  ($0098,A4),D0
02:0003EF1C 41EC0098        	  3373:     lea     ($0098,A4),A0
02:0003EF20 12302000        	  3374:     move.b  (A0,D2.W),D1
02:0003EF24 B001            	  3375:     cmp.b   D1,D0
02:0003EF26 660E            	  3376:     bne  _L_z05_CheckLadder_StashLadder
                            	  3377:     ; Distance = $10, and player's facing in the same direction.
                            	  3378:     ;
                            	  3379:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3380:     ; ladder and had not stepped onto it yet.
                            	  3381:     ; Go handle movement on it, but don't change state yet.
                            	  3382:     ;
                            	  3383:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3384:     ; off of the ladder. So the ladder should be put away. In this
                            	  3385:     ; case, fall thru.
                            	  3386:     ;
02:0003EF28 41EC00AC        	  3387:     lea     ($00AC,A4),A0
02:0003EF2C 10302000        	  3388:     move.b  (A0,D2.W),D0
02:0003EF30 0C000001        	  3389:     cmpi.b  #$01,D0
02:0003EF34 6718            	  3390:     beq  _L_z05_CheckLadder_HandleInput
                            	  3391:     even
                            	  3392: _L_z05_CheckLadder_StashLadder:
                            	  3393:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3394:     ;
02:0003EF36 7000            	  3395:     moveq   #0,D0
02:0003EF38 19400064        	  3396:     move.b  D0,($0064,A4)
02:0003EF3C 4EB90004A7A2    	  3397:     jsr     DestroyMonster
                            	  3398:     even
                            	  3399: _L_z05_CheckLadder_Exit:
02:0003EF42 4E75            	  3400:     rts
                            	  3401: 
                            	  3402:     even
                            	  3403: _L_z05_CheckLadder_SetState2:
                            	  3404:     ;  Set state 2, because we're on the ladder.
                            	  3405:     ;
02:0003EF44 7002            	  3406:     moveq   #2,D0
02:0003EF46 41EC00AC        	  3407:     lea     ($00AC,A4),A0
02:0003EF4A 11802000        	  3408:     move.b  D0,(A0,D2.W)
                            	  3409:     even
                            	  3410: _L_z05_CheckLadder_HandleInput:
                            	  3411:     ; If input direction = 0, go draw and reset moving direction.
                            	  3412:     ;
02:0003EF4E 102C03F8        	  3413:     move.b  ($03F8,A4),D0
02:0003EF52 67000086        	  3414:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3415:     ; Input direction <> 0. The player intends to move.
                            	  3416:     ; So, see if we need to override the moving direction.
                            	  3417:     ;
                            	  3418:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3419:     ; go draw and set moving direction to Link's direction.
                            	  3420:     ;
                            	  3421:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3422:     ; been blocked by the water.
                            	  3423:     ;
                            	  3424:     ; Or, Link already passed over the point right over the ladder
                            	  3425:     ; and was allowed to move onto the tiles after the ladder.
                            	  3426:     ;
02:0003EF56 102C0098        	  3427:     move.b  ($0098,A4),D0
02:0003EF5A 7600            	  3428:     moveq   #0,D3
02:0003EF5C 1614            	  3429:     move.b  ($0000,A4),D3
02:0003EF5E 670C            	  3430:     beq  _anon_z05_86
02:0003EF60 41EC0098        	  3431:     lea     ($0098,A4),A0
02:0003EF64 12302000        	  3432:     move.b  (A0,D2.W),D1
02:0003EF68 B001            	  3433:     cmp.b   D1,D0
02:0003EF6A 676E            	  3434:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3435: _anon_z05_86:
                            	  3436:     ; Distance = 0, or facing different directions.
                            	  3437:     ;
                            	  3438:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3439:     ; then go draw and keep moving.
                            	  3440:     ;
                            	  3441:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3442:     ;
                            	  3443:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3444:     ; to move onto the tiles after the ladder.
                            	  3445:     ;
                            	  3446:     ; Note that if Link is not moving, then this test will fail,
                            	  3447:     ; and case (D) will catch it.
                            	  3448:     ;
02:0003EF6C 41EC0098        	  3449:     lea     ($0098,A4),A0
02:0003EF70 10302000        	  3450:     move.b  (A0,D2.W),D0
02:0003EF74 122C000F        	  3451:     move.b  ($000F,A4),D1
02:0003EF78 B001            	  3452:     cmp.b   D1,D0
02:0003EF7A 675E            	  3453:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3454:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3455:     ; then go draw and move in ladder's direction.
                            	  3456:     ;
                            	  3457:     ; You can always step off the ladder where you came from.
                            	  3458:     ;
02:0003EF7C 4EB90003088C    	  3459:     jsr     GetOppositeDir
02:0003EF82 122C0098        	  3460:     move.b  ($0098,A4),D1
02:0003EF86 B001            	  3461:     cmp.b   D1,D0
02:0003EF88 6750            	  3462:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3463:     ; D. If opposite of ladder's direction <> down,
                            	  3464:     ; or input direction <> up,
                            	  3465:     ; then go reset moving direction, and draw.
                            	  3466:     ;
                            	  3467:     ; This will catch all cases of Link facing perpendicular to
                            	  3468:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3469:     ; ladder direction is up and input direction is up (E).
                            	  3470:     ;
02:0003EF8A 0C000004        	  3471:     cmpi.b  #$04,D0
02:0003EF8E 6648            	  3472:     bne  _anon_z05_87
02:0003EF90 102C03F8        	  3473:     move.b  ($03F8,A4),D0
02:0003EF94 0C000008        	  3474:     cmpi.b  #$08,D0
02:0003EF98 663E            	  3475:     bne  _anon_z05_87
                            	  3476:     ; E. The ladder's direction is up and input direction is up.
                            	  3477:     ;
                            	  3478:     ; An earlier call to check tile collision would have blocked
                            	  3479:     ; movement, because the tile under Link's top half is a water tile.
                            	  3480:     ; But because Link is squarely on the ladder, we really have
                            	  3481:     ; to check the tile above that one.
                            	  3482:     ;
                            	  3483:     ; Set moving direction to input direction (up) and switch X to
                            	  3484:     ; the player's slot for the purpose of checking tile collision below.
                            	  3485:     ; Based on that, we'll set moving direction according to walkability.
                            	  3486:     ;
02:0003EF9A 6158            	  3487:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3488:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3489:     ;
02:0003EF9C 102C0084        	  3490:     move.b  ($0084,A4),D0
02:0003EFA0 1B00            	  3491:     move.b  D0,-(A5)  ; PHA
02:0003EFA2 003C0011        	  3492:     ori     #$11,CCR  ; SEC: set C+X
02:0003EFA6 123C0008        	  3493:     move.b  #$08,D1
02:0003EFAA 0A3C0010        	  3494:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EFAE 9101            	  3495:     subx.b  D1,D0   ; SBC #$08
02:0003EFB0 0A3C0010        	  3496:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EFB4 19400084        	  3497:     move.b  D0,($0084,A4)
02:0003EFB8 4EB90004890C    	  3498:     jsr     GetCollidingTileMoving
02:0003EFBE 101D            	  3499:     move.b  (A5)+,D0  ; PLA
02:0003EFC0 19400084        	  3500:     move.b  D0,($0084,A4)
                            	  3501:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3502:     ; direction as the input direction (in a roundabout way).
                            	  3503:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3504:     ;
02:0003EFC4 102C000F        	  3505:     move.b  ($000F,A4),D0
02:0003EFC8 7600            	  3506:     moveq   #0,D3
02:0003EFCA 162C049E        	  3507:     move.b  ($049E,A4),D3
02:0003EFCE 122C034A        	  3508:     move.b  ($034A,A4),D1
02:0003EFD2 B601            	  3509:     cmp.b   D1,D3
02:0003EFD4 6500FF78        	  3510:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3511: _anon_z05_87:
                            	  3512:     ; Set A to reset moving direction in [0F].
                            	  3513:     ;
02:0003EFD8 7000            	  3514:     moveq   #0,D0
                            	  3515:     even
                            	  3516: _L_z05_CheckLadder_DrawLadder:
                            	  3517:     ; Draw the ladder.
                            	  3518:     ;
02:0003EFDA 1B00            	  3519:     move.b  D0,-(A5)  ; PHA
02:0003EFDC 7400            	  3520:     moveq   #0,D2
02:0003EFDE 142C0064        	  3521:     move.b  ($0064,A4),D2
02:0003EFE2 4EB900049FC6    	  3522:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003EFE8 760C            	  3523:     moveq   #12,D3
02:0003EFEA 7000            	  3524:     moveq   #0,D0
02:0003EFEC 4EB900030E60    	  3525:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0003EFF2 101D            	  3526:     move.b  (A5)+,D0  ; PLA
                            	  3527: ; Params:
                            	  3528: ; A: direction
                            	  3529: ;
                            	  3530: ; Returns:
                            	  3531: ; [0F]: direction
                            	  3532: ;
                            	  3533:     even
                            	  3534: SetMovingDirAndSwitchToPlayerSlot:
02:0003EFF4 4EF90002C046    	  3535:     jmp     c_set_moving_dir_switch_player
                            	  3536: 
                            	  3537: FindNextEdgeSpawnCell:
                            	  3538:     ; Load [0A] with the value before the call.
                            	  3539:     ;
02:0003EFFA 102C0525        	  3540:     move.b  ($0525,A4),D0
02:0003EFFE 1940000A        	  3541:     move.b  D0,($000A,A4)
                            	  3542:     even
                            	  3543: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3544:     ; Loop to look for a place to spawn a monster from the edge
                            	  3545:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3546:     ;
                            	  3547:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3548:     ; We'll move down $10 pixels.
                            	  3549:     ;
02:0003F002 7610            	  3550:     moveq   #16,D3
02:0003F004 102C000A        	  3551:     move.b  ($000A,A4),D0
02:0003F008 0200000F        	  3552:     andi.b #$0F,D0
02:0003F00C 670A            	  3553:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3554:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3555:     ; Don't move vertically.
                            	  3556:     ;
02:0003F00E 163C00F0        	  3557:     move.b  #$F0,D3
02:0003F012 0C00000F        	  3558:     cmpi.b  #$0F,D0
02:0003F016 6610            	  3559:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3560:     even
                            	  3561: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3562:     ; Else low nibble = $F. We're at the right edge,
                            	  3563:     ; and we'll move up $10 pixels.
                            	  3564:     ;
02:0003F018 1003            	  3565:     move.b  D3,D0
02:0003F01A 023C00EE        	  3566:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F01E 122C000A        	  3567:     move.b  ($000A,A4),D1
02:0003F022 D101            	  3568:     addx.b  D1,D0   ; ADC $0A
