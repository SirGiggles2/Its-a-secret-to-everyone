                            	  3835: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3836:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3837:     ;
                            	  3838:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3839:     ;         or object direction when <> 0.
                            	  3840:     ;
                            	  3841:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3842:     ;
                            	  3843:     ; if slot = 0 and grid offset <> 0 then
                            	  3844:     ;   if input dir = 0 then
                            	  3845:     ;     use 0
                            	  3846:     ;   else
                            	  3847:     ;     use object direction
                            	  3848:     ; else
                            	  3849:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3850:     ;     return
                            	  3851:     ;   else
                            	  3852:     ;     if input dir = 0
                            	  3853:     ;       use 0
                            	  3854:     ;     else
                            	  3855:     ;       use input direction
                            	  3856:     ;
