02:0003C464 0A3C0010        	  9318:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C468 9101            	  9319:     subx.b  D1,D0   ; SBC $00
02:0003C46A 0A3C0010        	  9320:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C46E 41EC0084        	  9321:     lea     ($0084,A4),A0
