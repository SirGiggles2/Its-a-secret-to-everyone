02:00049854 6014            	  5818:     jmp  CalcBoomerangFrame
                            	  5819: __far_z_07_0089:
02:00049856 7003            	  5820:     moveq   #3,D0
02:00049858 41EC03D0        	  5821:     lea     ($03D0,A4),A0
02:0004985C 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:00049860 7020            	  5823:     moveq   #32,D0
02:00049862 41EC00AC        	  5824:     lea     ($00AC,A4),A0
