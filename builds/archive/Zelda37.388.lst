02:0003C7F0 619A            	  9837:     jsr     Ganon_DrawCloud
02:0003C7F2 610000A6        	  9838:     jsr     Ganon_GetCurCloudLeft
02:0003C7F6 610000B4        	  9839:     jsr     Ganon_GetCurCloudBottom
02:0003C7FA 6190            	  9840:     jsr     Ganon_DrawCloud
02:0003C7FC 610000A2        	  9841:     jsr     Ganon_GetCurCloudRight
02:0003C800 618A            	  9842:     jsr     Ganon_DrawCloud
                            	  9843:     ; Draw the top and bottom clouds.
                            	  9844:     ;
02:0003C802 10342070        	  9845:     move.b  ($70,A4,D2.W),D0
02:0003C806 1880            	  9846:     move.b  D0,($0000,A4)
02:0003C808 6100009C        	  9847:     jsr     Ganon_GetCurCloudTop
02:0003C80C 6100FF7E        	  9848:     jsr     Ganon_DrawCloud
02:0003C810 6100009A        	  9849:     jsr     Ganon_GetCurCloudBottom
02:0003C814 6100FF76        	  9850:     jsr     Ganon_DrawCloud
                            	  9851:     ; Draw the left and right clouds.
                            	  9852:     ;
02:0003C818 61000080        	  9853:     jsr     Ganon_GetCurCloudLeft
02:0003C81C 41EC0084        	  9854:     lea     ($0084,A4),A0
02:0003C820 10302000        	  9855:     move.b  (A0,D2.W),D0
02:0003C824 19400001        	  9856:     move.b  D0,($0001,A4)
02:0003C828 6100FF62        	  9857:     jsr     Ganon_DrawCloud
02:0003C82C 6172            	  9858:     jsr     Ganon_GetCurCloudRight
02:0003C82E 6100FF5C        	  9859:     jsr     Ganon_DrawCloud
                            	  9860:     ; Save the object index.
                            	  9861:     ;
02:0003C832 102C0340        	  9862:     move.b  ($0340,A4),D0
02:0003C836 1B00            	  9863:     move.b  D0,-(A5)  ; PHA
                            	  9864:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  9865:     ;
02:0003C838 7402            	  9866:     moveq   #2,D2
                            	  9867:     even
                            	  9868: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003C83A 19420340        	  9869:     move.b  D2,($0340,A4)
                            	  9870:     ; If object slot < 5 or = 7, then move every frame.
                            	  9871:     ; Else move 3 out of every 4 frames.
                            	  9872:     ;
                            	  9873:     ; This makes pieces spread out in somewhat of a circle,
                            	  9874:     ; by making the pieces at cardinal directions move at
                            	  9875:     ; full speed while the diagonal ones move a little slower.
                            	  9876:     ;
02:0003C83E 0C020005        	  9877:     cmpi.b  #$05,D2
02:0003C842 6510            	  9878:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003C844 0C020007        	  9879:     cmpi.b  #$07,D2
02:0003C848 670A            	  9880:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003C84A 102C0015        	  9881:     move.b  ($0015,A4),D0
02:0003C84E 02000003        	  9882:     andi.b #$03,D0
02:0003C852 6704            	  9883:     beq  _anon_z04_164
                            	  9884:     even
                            	  9885: _L_z04_Ganon_DrawBurst_Move:
02:0003C854 6100EA32        	  9886:     jsr     BlueWizzrobe_Move
                            	  9887: _anon_z04_164:
02:0003C858 4EB900049FC6    	  9888:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9889:     ; The frame counter will make the sprite flash.
                            	  9890:     ; The array has the horizontal and vertical flipping attributes.
                            	  9891:     ; Combine them into [03].
                            	  9892:     ;
02:0003C85E 102C0015        	  9893:     move.b  ($0015,A4),D0
02:0003C862 02000003        	  9894:     andi.b #$03,D0
02:0003C866 41F90003C736    	  9895:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C86C 12302000        	  9896:     move.b  (A0,D2.W),D1
02:0003C870 8001            	  9897:     or.b  D1,D0
02:0003C872 19400003        	  9898:     move.b  D0,($0003,A4)
02:0003C876 41F90003C740    	  9899:     lea     (GanonBurstTiles).l,A0
02:0003C87C 10302000        	  9900:     move.b  (A0,D2.W),D0
02:0003C880 4EB900030F58    	  9901:     jsr     Anim_WriteSprite
                            	  9902:     ; Bottom of the loop.
                            	  9903:     ; Increment object slot while <= 9.
                            	  9904:     ;
02:0003C886 5202            	  9905:     addq.b  #1,D2
02:0003C888 0C02000A        	  9906:     cmpi.b  #$0A,D2
02:0003C88C 65AC            	  9907:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  9908:     ; Restore the object index.
                            	  9909:     ;
02:0003C88E 101D            	  9910:     move.b  (A5)+,D0  ; PLA
02:0003C890 19400340        	  9911:     move.b  D0,($0340,A4)
02:0003C894 0A3C0001        	  9912:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C898 4E75            	  9913:     rts
                            	  9914: 
                            	  9915: ; Returns:
                            	  9916: ; [00]: X coordinate
                            	  9917: ;
                            	  9918:     even
                            	  9919: Ganon_GetCurCloudLeft:
02:0003C89A 4EF90002BED0    	  9920:     jmp     c_ganon_get_cur_cloud_left
                            	  9921: 
