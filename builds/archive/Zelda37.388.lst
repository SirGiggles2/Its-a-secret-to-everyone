02:0003A69A 10302000        	  5387:     move.b  (A0,D2.W),D0
02:0003A69E 122C0002        	  5388:     move.b  ($0002,A4),D1
02:0003A6A2 E309            	  5389:     lsl.b  #1,D1   ; ASL $02
02:0003A6A4 19410002        	  5390:     move.b  D1,($0002,A4)
02:0003A6A8 122C0002        	  5391:     move.b  ($0002,A4),D1
02:0003A6AC C200            	  5392:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A6AE 6716            	  5393:     beq  _L_z04_Digdogger_Move_Up
02:0003A6B0 41EC0084        	  5394:     lea     ($0084,A4),A0
02:0003A6B4 10302000        	  5395:     move.b  (A0,D2.W),D0
02:0003A6B8 122C0003        	  5396:     move.b  ($0003,A4),D1
02:0003A6BC D101            	  5397:     addx.b  D1,D0   ; ADC $03
02:0003A6BE 41EC0084        	  5398:     lea     ($0084,A4),A0
02:0003A6C2 11802000        	  5399:     move.b  D0,(A0,D2.W)
