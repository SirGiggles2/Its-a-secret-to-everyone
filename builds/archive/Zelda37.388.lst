02:00030CBC 41F900030A0C    	  2158:     lea     (ObjAnimations).l,A0
02:00030CC2 10303000        	  2159:     move.b  (A0,D3.W),D0
02:00030CC6 023C00EE        	  2160:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030CCA 122C000D        	  2161:     move.b  ($000D,A4),D1
02:00030CCE D101            	  2162:     addx.b  D1,D0   ; ADC $0D
02:00030CD0 7600            	  2163:     moveq   #0,D3
