02:00039474 661E            	  2810:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:00039476 7006            	  2811:     moveq   #6,D0
02:00039478 41EC03D0        	  2812:     lea     ($03D0,A4),A0
02:0003947C 11802000        	  2813:     move.b  D0,(A0,D2.W)
                            	  2814:     ; There are actually 6 frame images divided into 2 sets.
                            	  2815:     ; Each set depicts one animation frame. In each set there are
                            	  2816:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2817:     ;
                            	  2818:     ; The movement frame will keep track of the base offset of
                            	  2819:     ; the current set for the current animation frame: 0 or 3.
                            	  2820:     ;
                            	  2821:     ; So, XOR the movement frame with 3.
                            	  2822:     ;
02:00039480 E208            	  2823:     lsr.b  #1,D0   ; LSR A
02:00039482 41EC03E4        	  2824:     lea     ($03E4,A4),A0
02:00039486 12302000        	  2825:     move.b  (A0,D2.W),D1
02:0003948A B300            	  2826:     eor.b  D1,D0
02:0003948C 41EC03E4        	  2827:     lea     ($03E4,A4),A0
02:00039490 11802000        	  2828:     move.b  D0,(A0,D2.W)
                            	  2829:     even
