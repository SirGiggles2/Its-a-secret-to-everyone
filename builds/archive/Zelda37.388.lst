                            	  9949: Ganon_DrawBody:
                            	  9950:     ; Loop over four 16x16 images that make up Ganon.
                            	  9951:     ; There are 6 animation frames.
                            	  9952:     ;
02:0003C8D6 7603            	  9953:     moveq   #3,D3
                            	  9954:     even
                            	  9955: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  9956:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  9957:     ;
02:0003C8D8 10342070        	  9958:     move.b  ($70,A4,D2.W),D0
02:0003C8DC 023C00EE        	  9959:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8E0 41F90003C8CA    	  9960:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C8E6 12303000        	  9961:     move.b  (A0,D3.W),D1
02:0003C8EA D101            	  9962:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C8EC 1880            	  9963:     move.b  D0,($0000,A4)
                            	  9964:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  9965:     ;
02:0003C8EE 41EC0084        	  9966:     lea     ($0084,A4),A0
02:0003C8F2 10302000        	  9967:     move.b  (A0,D2.W),D0
02:0003C8F6 023C00EE        	  9968:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8FA 41F90003C8CE    	  9969:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C900 12303000        	  9970:     move.b  (A0,D3.W),D1
02:0003C904 D101            	  9971:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C906 19400001        	  9972:     move.b  D0,($0001,A4)
                            	  9973:     ; Each part has a horizontal flipping flag.
                            	  9974:     ;
02:0003C90A 41F90003C8D2    	  9975:     lea     (GanonSpriteHFlips).l,A0
02:0003C910 10303000        	  9976:     move.b  (A0,D3.W),D0
02:0003C914 1940000F        	  9977:     move.b  D0,($000F,A4)
                            	  9978:     ; Save and copy the loop index (the current part) to [07].
                            	  9979:     ;
02:0003C918 1003            	  9980:     move.b  D3,D0
02:0003C91A 1B00            	  9981:     move.b  D0,-(A5)  ; PHA
02:0003C91C 19400007        	  9982:     move.b  D0,($0007,A4)
                            	  9983:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  9984:     ; that make it up.
                            	  9985:     ;
02:0003C920 41EC046B        	  9986:     lea     ($046B,A4),A0
02:0003C924 10302000        	  9987:     move.b  (A0,D2.W),D0
02:0003C928 E308            	  9988:     lsl.b  #1,D0   ; ASL A
02:0003C92A E308            	  9989:     lsl.b  #1,D0   ; ASL A
                            	  9990:     ; Add [07] -- the index of the current part.
                            	  9991:     ;
                            	  9992:     ; Now you have an index into the frame image table, for the
                            	  9993:     ; current image part of the current animation frame.
                            	  9994:     ;
02:0003C92C 122C0007        	  9995:     move.b  ($0007,A4),D1
02:0003C930 D101            	  9996:     addx.b  D1,D0   ; ADC $07
02:0003C932 7600            	  9997:     moveq   #0,D3
02:0003C934 1600            	  9998:     move.b  D0,D3
02:0003C936 41F90003C8B2    	  9999:     lea     (GanonFrameImages).l,A0
02:0003C93C 10303000        	 10000:     move.b  (A0,D3.W),D0
02:0003C940 4EB900030C5C    	 10001:     jsr     DrawObjectNotMirrored
02:0003C946 101D            	 10002:     move.b  (A5)+,D0  ; PLA
                            	 10003:     ; Bottom of the part loop.
                            	 10004:     ;
02:0003C948 7600            	 10005:     moveq   #0,D3
02:0003C94A 1600            	 10006:     move.b  D0,D3
02:0003C94C 5303            	 10007:     subq.b  #1,D3
02:0003C94E 6A88            	 10008:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C950 4E75            	 10009:     rts
