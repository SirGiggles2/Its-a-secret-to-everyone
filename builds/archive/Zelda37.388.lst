02:000424B4 162C00EB        	  8715:     move.b  ($00EB,A4),D3
02:000424B8 1214            	  8716:     move.b  ($00,A4),D1   ; ptr lo
02:000424BA 182C0001        	  8717:     move.b  ($01,A4),D4  ; ptr hi
02:000424BE 024100FF        	  8718:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000424C2 E14C            	  8719:     lsl.w   #8,D4
02:000424C4 8841            	  8720:     or.w    D1,D4             ; D4 = NES ptr addr
02:000424C6 48C4            	  8721:     ext.l   D4
