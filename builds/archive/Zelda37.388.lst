                            	  7289: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7290:     ; If the "monsters from edges" long timer expired, then
                            	  7291:     ; go bring the monster in.
                            	  7292:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7293:     ;
                            	  7294:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7295:     ; residual position so enemies keep their previous-room
                            	  7296:     ; positions instead of being re-edge-spawned (matches NES).
02:0004A3C4 102C004B        	  7297:     move.b  ($004B,A4),D0
02:0004A3C8 662E            	  7298:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7299:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004A3CA 102C000F        	  7300:     move.b  ($000F,A4),D0
02:0004A3CE 0C0000FF        	  7301:     cmpi.b  #$FF,D0
02:0004A3D2 662E            	  7302:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004A3D4 41EC0070        	  7303:     lea     ($0070,A4),A0
02:0004A3D8 10302000        	  7304:     move.b  (A0,D2.W),D0
02:0004A3DC 660A            	  7305:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004A3DE 41EC0084        	  7306:     lea     ($0084,A4),A0
02:0004A3E2 10302000        	  7307:     move.b  (A0,D2.W),D0
02:0004A3E6 671A            	  7308:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7309:     even
