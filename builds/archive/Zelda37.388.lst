02:0003AE3C 41EC042C        	  6396:     lea     ($042C,A4),A0
02:0003AE40 12302000        	  6397:     move.b  (A0,D2.W),D1
02:0003AE44 B001            	  6398:     cmp.b   D1,D0
02:0003AE46 65000096        	  6399:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
