                            	  5686: _anon_z05_122:
                            	  5687:     ; If the door command = 4 after incrementing it, then
                            	  5688:     ; it was 3 (close door). So:
                            	  5689:     ; 1. reset this door's flag
                            	  5690:     ; 2. remove it from the opened door mask
                            	  5691:     ; 3. reset the door command
                            	  5692:     ; 4. go lay out doors in the play area map
                            	  5693:     ;
02:000409CE 102C0054        	  5694:     move.b  ($0054,A4),D0
02:000409D2 0C000004        	  5695:     cmpi.b  #$04,D0
02:000409D6 6626            	  5696:     bne  _anon_z05_123
02:000409D8 7400            	  5697:     moveq   #0,D2
02:000409DA 142C0009        	  5698:     move.b  ($0009,A4),D2
02:000409DE 6100DCE2        	  5699:     jsr     ResetDoorFlag
02:000409E2 102C0055        	  5700:     move.b  ($0055,A4),D0
02:000409E6 0A00000F        	  5701:     eori.b #$0F,D0
02:000409EA 122C00EE        	  5702:     move.b  ($00EE,A4),D1
02:000409EE C001            	  5703:     and.b  D1,D0
                            	  5704:     even
                            	  5705: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000409F0 194000EE        	  5706:     move.b  D0,($00EE,A4)
                            	  5707:     even
                            	  5708: L_ResetDoorCmdAndLayOutDoors:
02:000409F4 7000            	  5709:     moveq   #0,D0
02:000409F6 19400054        	  5710:     move.b  D0,($0054,A4)
02:000409FA 6000FCD4        	  5711:     jmp     LayOutDoors
