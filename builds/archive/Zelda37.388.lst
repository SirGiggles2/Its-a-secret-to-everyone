                            	   340:     ;
02:0003D462 102C0254        	   341:     move.b  ($0254,A4),D0
02:0003D466 0C0000F8        	   342:     cmpi.b  #$F8,D0
02:0003D46A 670C            	   343:     beq  _anon_z05_5
