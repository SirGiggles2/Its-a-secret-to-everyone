                            	  2498: ModeEandF_SetUpCursorSprites:
                            	  2499:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2500:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2501:     ; These are the cursor sprites.
02:000338DA 760A            	  2502:     moveq   #10,D3
                            	  2503:     even
                            	  2504: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:000338DC 41F9000331AA    	  2505:     lea     (ModeEandFCursorSprites).l,A0
02:000338E2 10303000        	  2506:     move.b  (A0,D3.W),D0
02:000338E6 41EC0201        	  2507:     lea     ($0201,A4),A0
02:000338EA 11803000        	  2508:     move.b  D0,(A0,D3.W)
02:000338EE 5303            	  2509:     subq.b  #1,D3
02:000338F0 6AEA            	  2510:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000338F2 7600            	  2511:     moveq   #0,D3
02:000338F4 162C0016        	  2512:     move.b  ($0016,A4),D3
02:000338F8 41F900033160    	  2513:     lea     (ModeEandFSlotCursorYs).l,A0
02:000338FE 10303000        	  2514:     move.b  (A0,D3.W),D0
02:00033902 19400084        	  2515:     move.b  D0,($0084,A4)
02:00033906 19400200        	  2516:     move.b  D0,($0200,A4)
02:0003390A 102C0012        	  2517:     move.b  ($0012,A4),D0
02:0003390E 0C00000F        	  2518:     cmpi.b  #$0F,D0
                            	  2519:     ; There's more work in mode $E.
                            	  2520:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2521:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00033912 6736            	  2522:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00033914 103C00F3        	  2523:     move.b  #$F3,D0
02:00033918 19400201        	  2524:     move.b  D0,($0201,A4)
                            	  2525:     ; Because the visible part of the cursor block sprite is
                            	  2526:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2527:     ; above its ObjY.
02:0003391C 102C0084        	  2528:     move.b  ($0084,A4),D0
02:00033920 003C0011        	  2529:     ori     #$11,CCR  ; SEC: set C+X
02:00033924 123C0008        	  2530:     move.b  #$08,D1
02:00033928 0A3C0010        	  2531:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003392C 9101            	  2532:     subx.b  D1,D0   ; SBC #$08
02:0003392E 0A3C0010        	  2533:     eori    #$10,CCR  ; restore X = 6502 C
02:00033932 19400204        	  2534:     move.b  D0,($0204,A4)
02:00033936 7070            	  2535:     moveq   #112,D0
02:00033938 19400070        	  2536:     move.b  D0,($0070,A4)
02:0003393C 103C0087        	  2537:     move.b  #$87,D0
02:00033940 19400085        	  2538:     move.b  D0,($0085,A4)
02:00033944 7030            	  2539:     moveq   #48,D0
02:00033946 19400071        	  2540:     move.b  D0,($0071,A4)
                            	  2541:     even
