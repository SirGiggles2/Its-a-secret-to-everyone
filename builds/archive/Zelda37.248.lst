02:0003C606 19802070        	  6168:     move.b  D0,($70,A4,D2.W)
02:0003C60A 41EC0084        	  6169:     lea     ($0084,A4),A0
02:0003C60E 10302000        	  6170:     move.b  (A0,D2.W),D0
02:0003C612 023C00EE        	  6171:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C616 41F90003C4B2    	  6172:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C61C 12303000        	  6173:     move.b  (A0,D3.W),D1
02:0003C620 D101            	  6174:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C622 41EC0084        	  6175:     lea     ($0084,A4),A0
02:0003C626 11802000        	  6176:     move.b  D0,(A0,D2.W)
                            	  6177:     ; Check the room boundary and object collisions in this temporary location.
