                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:000403B2 103C00FD        	   447:     move.b  #$FD,D0
02:000403B6 613A            	   448:     jsr     MovePositionMarkers
02:000403B8 102C00FC        	   449:     move.b  ($00FC,A4),D0
