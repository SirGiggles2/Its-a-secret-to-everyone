                            	  1908: _L_z04_UpdateStatues_Shoot:
                            	  1909:     ; Look for an empty monster slot.
                            	  1910:     ; If none is found, return.
                            	  1911:     ;
                            	  1912:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1913:     ; object. This routine takes a shooter object, and instantiates
                            	  1914:     ; a fireball object at the shooter's location.
                            	  1915:     ;
                            	  1916:     ; The object slot we set up here will behave as the shooter.
                            	  1917:     ; For each fireball index, this object slot will have its coordinates
                            	  1918:     ; changed.
                            	  1919:     ;
                            	  1920:     ; Note that this means that:
                            	  1921:     ; 1. The first fireball made will be its own shooter.
                            	  1922:     ;    Practically, there's nothing special about this.
                            	  1923:     ; 2. If there is more than one fireball made in a frame,
                            	  1924:     ;    then two of them will come from the same statue.
                            	  1925:     ;
                            	  1926:     ;
                            	  1927:     ; Save the fireball pattern.
02:0003A81A 1003            	  1928:     move.b  D3,D0
02:0003A81C 1B00            	  1929:     move.b  D0,-(A5)  ; PHA
02:0003A81E 4EB90004D582    	  1930:     jsr     FindEmptyMonsterSlot
02:0003A824 0C000001        	  1931:     cmpi.b  #$01,D0
02:0003A828 101D            	  1932:     move.b  (A5)+,D0  ; PLA
02:0003A82A 6400010A        	  1933:     bcc  _L_z04_UpdateStatues_Exit
                            	  1934:     ; If we found a slot, but it < 6, return.
                            	  1935:     ;
02:0003A82E 0C030006        	  1936:     cmpi.b  #$06,D3
02:0003A832 65000102        	  1937:     bcs  _L_z04_UpdateStatues_Exit
                            	  1938:     ; Store the object slot in [0A].
                            	  1939:     ; Store fireball pattern in [0B].
                            	  1940:     ;
02:0003A836 1943000A        	  1941:     move.b  D3,($000A,A4)
02:0003A83A 1940000B        	  1942:     move.b  D0,($000B,A4)
                            	  1943:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1944:     ;
02:0003A83E 7600            	  1945:     moveq   #0,D3
02:0003A840 1600            	  1946:     move.b  D0,D3
02:0003A842 7400            	  1947:     moveq   #0,D2
02:0003A844 41F90003A7D6    	  1948:     lea     (StatueFireballCounts).l,A0
02:0003A84A 14303000        	  1949:     move.b  (A0,D3.W),D2
                            	  1950:     even
                            	  1951: _L_z04_UpdateStatues_LoopFireball:
                            	  1952:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1953:     ;
                            	  1954:     ; Decrement the fireball timer at this index.
                            	  1955:     ;
02:0003A84E 7600            	  1956:     moveq   #0,D3
02:0003A850 41EC04E8        	  1957:     lea     ($04E8,A4),A0
02:0003A854 16302000        	  1958:     move.b  (A0,D2.W),D3
02:0003A858 5303            	  1959:     subq.b  #1,D3
02:0003A85A 1003            	  1960:     move.b  D3,D0
02:0003A85C 41EC04E8        	  1961:     lea     ($04E8,A4),A0
02:0003A860 11802000        	  1962:     move.b  D0,(A0,D2.W)
                            	  1963:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1964:     ; to make a fireball. Go loop again.
                            	  1965:     ;
02:0003A864 5203            	  1966:     addq.b  #1,D3
02:0003A866 660000C8        	  1967:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1968:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1969:     ; This fireball index will wait another $100 frames.
                            	  1970:     ;
02:0003A86A 10342018        	  1971:     move.b  ($18,A4,D2.W),D0
02:0003A86E 0C0000F0        	  1972:     cmpi.b  #$F0,D0
02:0003A872 640000BC        	  1973:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1974:     ; Else choose one of four start times for the fireball based on
                            	  1975:     ; the random value.
                            	  1976:     ;
02:0003A876 02000003        	  1977:     andi.b #$03,D0
02:0003A87A 7600            	  1978:     moveq   #0,D3
02:0003A87C 1600            	  1979:     move.b  D0,D3
02:0003A87E 41F90003A7DA    	  1980:     lea     (StatueFireballStartTimes).l,A0
02:0003A884 10303000        	  1981:     move.b  (A0,D3.W),D0
02:0003A888 41EC04E8        	  1982:     lea     ($04E8,A4),A0
02:0003A88C 11802000        	  1983:     move.b  D0,(A0,D2.W)
                            	  1984:     ; The coordinate lists are divided into sets for each pattern.
                            	  1985:     ;
                            	  1986:     ; Look up the index of the base of the set for the pattern in use.
                            	  1987:     ; Add it to the fireball index in X register to get the index of
                            	  1988:     ; the coordinate we want within each coordinate list.
                            	  1989:     ;
                            	  1990:     ;
                            	  1991:     ; Pattern
02:0003A890 7600            	  1992:     moveq   #0,D3
02:0003A892 162C000B        	  1993:     move.b  ($000B,A4),D3
02:0003A896 1002            	  1994:     move.b  D2,D0
02:0003A898 023C00EE        	  1995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A89C 41F90003A7DE    	  1996:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A8A2 12303000        	  1997:     move.b  (A0,D3.W),D1
02:0003A8A6 D101            	  1998:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A8A8 7600            	  1999:     moveq   #0,D3
02:0003A8AA 1600            	  2000:     move.b  D0,D3
02:0003A8AC 1002            	  2001:     move.b  D2,D0
02:0003A8AE 1B00            	  2002:     move.b  D0,-(A5)  ; PHA
                            	  2003:     ; Get Link's coordinates into [00] and [01].
                            	  2004:     ;
02:0003A8B0 7400            	  2005:     moveq   #0,D2
02:0003A8B2 4EB90004CD9A    	  2006:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2007:     ; Switch to the new fireball's object slot.
                            	  2008:     ;
02:0003A8B8 7400            	  2009:     moveq   #0,D2
02:0003A8BA 142C000A        	  2010:     move.b  ($000A,A4),D2
                            	  2011:     ; Look up and set the X coordinate for the fireball object.
                            	  2012:     ; Also store it in [02].
                            	  2013:     ;
02:0003A8BE 41F90003A7E2    	  2014:     lea     (StatueXs).l,A0
02:0003A8C4 10303000        	  2015:     move.b  (A0,D3.W),D0
02:0003A8C8 19400002        	  2016:     move.b  D0,($0002,A4)
02:0003A8CC 19802070        	  2017:     move.b  D0,($70,A4,D2.W)
                            	  2018:     ; Look up and set the Y coordinate for the fireball object.
                            	  2019:     ; Also store it in [03].
                            	  2020:     ;
02:0003A8D0 41F90003A7EA    	  2021:     lea     (StatueYs).l,A0
02:0003A8D6 10303000        	  2022:     move.b  (A0,D3.W),D0
02:0003A8DA 19400003        	  2023:     move.b  D0,($0003,A4)
02:0003A8DE 41EC0084        	  2024:     lea     ($0084,A4),A0
02:0003A8E2 11802000        	  2025:     move.b  D0,(A0,D2.W)
                            	  2026:     ; Set mask value 3 in [04].
                            	  2027:     ;
02:0003A8E6 7003            	  2028:     moveq   #3,D0
02:0003A8E8 19400004        	  2029:     move.b  D0,($0004,A4)
                            	  2030:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2031:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2032:     ;
02:0003A8EC 7601            	  2033:     moveq   #1,D3
                            	  2034:     even
                            	  2035: _L_z04_UpdateStatues_LoopAxis:
02:0003A8EE 10343000        	  2036:     move.b  ($00,A4,D3.W),D0
02:0003A8F2 003C0011        	  2037:     ori     #$11,CCR  ; SEC: set C+X
