                            	  7784: __far_z_05_0086:
                            	  7785:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7786:     ; and represents the current row of the submenu being processed.
                            	  7787:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7788:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7789:     ;
                            	  7790:     ; If the bottom bit is set, go prepare the full black row.
                            	  7791:     ;
02:00044CA2 E208            	  7792:     lsr.b  #1,D0   ; LSR A
02:00044CA4 7600            	  7793:     moveq   #0,D3
02:00044CA6 1600            	  7794:     move.b  D0,D3
02:00044CA8 6402            	  7795:     bcc.s  __far_z_05_0087
02:00044CAA 60B6            	  7796:     jmp  PrepFullBlackRow
                            	  7797: __far_z_05_0087:
