02:0003E140 0C000020        	  9799:     cmpi.b  #$20,D0
02:0003E144 662C            	  9800:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9801:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9802:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9803:     ;
02:0003E146 7000            	  9804:     moveq   #0,D0
02:0003E148 41EC0412        	  9805:     lea     ($0412,A4),A0
02:0003E14C 11802000        	  9806:     move.b  D0,(A0,D2.W)
02:0003E150 61001C62        	  9807:     jsr     ReverseObjDir8
02:0003E154 41EC045E        	  9808:     lea     ($045E,A4),A0
02:0003E158 10302000        	  9809:     move.b  (A0,D2.W),D0
02:0003E15C 41EC045E        	  9810:     lea     ($045E,A4),A0
02:0003E160 52302000        	  9811:     addq.b  #1,(A0,D2.W)
                            	  9812:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9813:     ; should randomly change direction.
                            	  9814:     ;
02:0003E164 E208            	  9815:     lsr.b  #1,D0   ; LSR A
02:0003E166 640A            	  9816:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003E168 7000            	  9817:     moveq   #0,D0
02:0003E16A 41EC0451        	  9818:     lea     ($0451,A4),A0
