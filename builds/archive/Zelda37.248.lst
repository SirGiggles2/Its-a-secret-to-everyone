                            	  2947:     ; go set mask $FF, so that no button is excluded.
                            	  2948:     ;
02:00041ACA 102C0002        	  2949:     move.b  ($0002,A4),D0
02:00041ACE 41F900041A42    	  2950:     lea     (BorderBounds).l,A0
02:00041AD4 12303000        	  2951:     move.b  (A0,D3.W),D1
