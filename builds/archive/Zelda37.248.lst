02:0003B592 11802000        	  3881:     move.b  D0,(A0,D2.W)
02:0003B596 41EC0098        	  3882:     lea     ($0098,A4),A0
02:0003B59A 11802000        	  3883:     move.b  D0,(A0,D2.W)
