                            	  4335: _CalcDiagonalSpeedIndex:
02:000310A2 1883            	  4336:     move.b  D3,($0000,A4)
                            	  4337:     ; Assuming horizontal distance >= vertical distance, the
                            	  4338:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4339:     ;
02:000310A4 103C00FF        	  4340:     move.b  #$FF,D0
02:000310A8 19400001        	  4341:     move.b  D0,($0001,A4)
                            	  4342:     ; TODO:
                            	  4343:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4344:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4345:     ;
                            	  4346:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4347:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4348:     ; of the farther distance faster.
                            	  4349:     ;
02:000310AC 102C0003        	  4350:     move.b  ($0003,A4),D0
02:000310B0 122C0004        	  4351:     move.b  ($0004,A4),D1
02:000310B4 B001            	  4352:     cmp.b   D1,D0
02:000310B6 6416            	  4353:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:000310B8 1B00            	  4354:     move.b  D0,-(A5)  ; PHA
02:000310BA 102C0004        	  4355:     move.b  ($0004,A4),D0
02:000310BE 19400003        	  4356:     move.b  D0,($0003,A4)
02:000310C2 101D            	  4357:     move.b  (A5)+,D0  ; PLA
02:000310C4 19400004        	  4358:     move.b  D0,($0004,A4)
02:000310C8 7001            	  4359:     moveq   #1,D0
02:000310CA 19400001        	  4360:     move.b  D0,($0001,A4)
                            	  4361:     even
                            	  4362: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4363:     ; TODO: call it speed index or angle?
                            	  4364:     ; If the difference in distances is within 8 pixels,
                            	  4365:     ; return the speed index (angle) we have.
                            	  4366:     ;
02:000310CE 102C0003        	  4367:     move.b  ($0003,A4),D0
02:000310D2 003C0011        	  4368:     ori     #$11,CCR  ; SEC: set C+X
02:000310D6 122C0004        	  4369:     move.b  ($0004,A4),D1
02:000310DA 0A3C0010        	  4370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000310DE 9101            	  4371:     subx.b  D1,D0   ; SBC $04
02:000310E0 0A3C0010        	  4372:     eori    #$10,CCR  ; restore X = 6502 C
02:000310E4 0C000008        	  4373:     cmpi.b  #$08,D0
02:000310E8 6538            	  4374:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4375:     even
                            	  4376: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4377:     ; TODO: call it speed index or angle?
                            	  4378:     ; Otherwise, go to the next speed index (angle).
                            	  4379:     ;
02:000310EA 1014            	  4380:     move.b  ($0000,A4),D0
02:000310EC 023C00EE        	  4381:     andi    #$EE,CCR  ; CLC: clear C+X
02:000310F0 122C0001        	  4382:     move.b  ($0001,A4),D1
02:000310F4 D101            	  4383:     addx.b  D1,D0   ; ADC $01
02:000310F6 1880            	  4384:     move.b  D0,($0000,A4)
                            	  4385:     ; TODO: call it speed index or angle?
                            	  4386:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4387:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4388:     ;
02:000310F8 6728            	  4389:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:000310FA 0C000008        	  4390:     cmpi.b  #$08,D0
02:000310FE 6722            	  4391:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4392:     ; Subtract the lesser distance from the greater distance.
                            	  4393:     ; If they still haven't crossed, then we can turn more.
                            	  4394:     ;
02:00031100 102C0003        	  4395:     move.b  ($0003,A4),D0
02:00031104 003C0011        	  4396:     ori     #$11,CCR  ; SEC: set C+X
02:00031108 122C0004        	  4397:     move.b  ($0004,A4),D1
02:0003110C 0A3C0010        	  4398:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031110 9101            	  4399:     subx.b  D1,D0   ; SBC $04
02:00031112 0A3C0010        	  4400:     eori    #$10,CCR  ; restore X = 6502 C
02:00031116 19400003        	  4401:     move.b  D0,($0003,A4)
02:0003111A 122C0004        	  4402:     move.b  ($0004,A4),D1
02:0003111E B001            	  4403:     cmp.b   D1,D0
02:00031120 64C8            	  4404:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4405:     even
                            	  4406: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4407:     ; TODO: call it speed index or angle?
                            	  4408:     ; Return the speed index (angle) we found.
                            	  4409:     ;
02:00031122 7600            	  4410:     moveq   #0,D3
02:00031124 1614            	  4411:     move.b  ($0000,A4),D3
02:00031126 4E75            	  4412:     rts
