02:00036A72 41F9000369E6    	  5057:     lea     (CreditsLastVscrollList).l,A0
02:00036A78 12303000        	  5058:     move.b  (A0,D3.W),D1
02:00036A7C B001            	  5059:     cmp.b   D1,D0
