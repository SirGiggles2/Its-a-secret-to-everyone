02:000322B8 1614            	  6709:     move.b  ($0000,A4),D3
02:000322BA 41EC00AC        	  6710:     lea     ($00AC,A4),A0
02:000322BE 10303000        	  6711:     move.b  (A0,D3.W),D0
02:000322C2 6604            	  6712:     bne.s  __far_z_01_0067
02:000322C4 6000010C        	  6713:     jmp  L74D8_Exit
