02:0003F42C 0200000F        	 12343:     andi.b #$0F,D0
02:0003F430 0C000004        	 12344:     cmpi.b  #$04,D0
02:0003F434 6702            	 12345:     beq.s  __far_z_04_0115
02:0003F436 6042            	 12346:     jmp  Ganon_DrawBodyFrame0
                            	 12347: __far_z_04_0115:
