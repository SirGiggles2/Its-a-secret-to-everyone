02:000421EE 12303000        	  4028:     move.b  (A0,D3.W),D1
02:000421F2 B001            	  4029:     cmp.b   D1,D0
02:000421F4 6510            	  4030:     bcs  _anon_z05_95
02:000421F6 41F9000421B8    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:000421FC 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00042200 B001            	  4033:     cmp.b   D1,D0
02:00042202 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4035: _anon_z05_95:
