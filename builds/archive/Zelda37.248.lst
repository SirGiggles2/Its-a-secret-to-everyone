                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:00041A4E 102C0098        	  2866:     move.b  ($0098,A4),D0
02:00041A52 4EB900030FFC    	  2867:     jsr     GetOppositeDir
02:00041A58 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:00041A5A 4EB900030FFC    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:00041A60 102C0070        	  2879:     move.b  ($0070,A4),D0
02:00041A64 0C030002        	  2880:     cmpi.b  #$02,D3
02:00041A68 6404            	  2881:     bcc  _anon_z05_74
02:00041A6A 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:00041A6E 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:00041A72 1003            	  2887:     move.b  D3,D0
02:00041A74 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:00041A76 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A7A 123C0008        	  2890:     move.b  #$08,D1
02:00041A7E D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041A80 7600            	  2892:     moveq   #0,D3
02:00041A82 1600            	  2893:     move.b  D0,D3
02:00041A84 103C0080        	  2894:     move.b  #$80,D0
02:00041A88 6134            	  2895:     jsr     MaskInputInBorder
02:00041A8A 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:00041A8C 7600            	  2897:     moveq   #0,D3
02:00041A8E 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:00041A90 102C0001        	  2902:     move.b  ($0001,A4),D0
02:00041A94 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:00041A98 660C            	  2904:     bne  _anon_z05_75
02:00041A9A 102C0098        	  2905:     move.b  ($0098,A4),D0
02:00041A9E 1880            	  2906:     move.b  D0,($0000,A4)
02:00041AA0 4EB900030FFC    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:00041AA6 102C0010        	  2914:     move.b  ($0010,A4),D0
02:00041AAA 6710            	  2915:     beq  _anon_z05_76
02:00041AAC 1003            	  2916:     move.b  D3,D0
02:00041AAE 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041AB2 123C0004        	  2918:     move.b  #$04,D1
02:00041AB6 D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041AB8 7600            	  2920:     moveq   #0,D3
02:00041ABA 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:00041ABC 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
02:00041ABE 19400001        	  2938:     move.b  D0,($0001,A4)
                            	  2939:     ; If direction is positive (right or down), then go handle it separately.
                            	  2940:     ;
02:00041AC2 1014            	  2941:     move.b  ($0000,A4),D0
