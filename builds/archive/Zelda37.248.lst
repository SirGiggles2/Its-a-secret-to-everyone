02:0002E448 102C0350        	   216:     move.b  ($0350,A4),D0
02:0002E44C 0C000072        	   217:     cmpi.b  #$72,D0
02:0002E450 6714            	   218:     beq  _L_z01_InitCave_TakeType
02:0002E452 0C000071        	   219:     cmpi.b  #$71,D0
02:0002E456 670E            	   220:     beq  _L_z01_InitCave_TakeType
02:0002E458 0C00007B        	   221:     cmpi.b  #$7B,D0
02:0002E45C 6408            	   222:     bcc  _L_z01_InitCave_TakeType
02:0002E45E 0C00006E        	   223:     cmpi.b  #$6E,D0
