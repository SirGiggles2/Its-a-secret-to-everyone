02:0003D40E 19400028        	  8030:     move.b  D0,($0028,A4)
02:0003D412 19400405        	  8031:     move.b  D0,($0405,A4)
02:0003D416 194000C0        	  8032:     move.b  D0,($00C0,A4)
02:0003D41A 194000D3        	  8033:     move.b  D0,($00D3,A4)
                            	  8034:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  8035:     ;
