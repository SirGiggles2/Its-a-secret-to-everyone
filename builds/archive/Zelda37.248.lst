02:0003CDC2 123C0008        	  7156:     move.b  #$08,D1
02:0003CDC6 D101            	  7157:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7158: _anon_z04_91:
02:0003CDC8 1880            	  7159:     move.b  D0,($0000,A4)
                            	  7160:     ; Store (Y + 8) in [01].
                            	  7161:     ;
02:0003CDCA 41EC0084        	  7162:     lea     ($0084,A4),A0
02:0003CDCE 10302000        	  7163:     move.b  (A0,D2.W),D0
02:0003CDD2 123C0008        	  7164:     move.b  #$08,D1
02:0003CDD6 D101            	  7165:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CDD8 19400001        	  7166:     move.b  D0,($0001,A4)
                            	  7167:     ; Only check the first bomb slot ($10).
                            	  7168:     ;
                            	  7169:     ; Store the bomb's (X + 8) in [02].
                            	  7170:     ;
02:0003CDDC 7610            	  7171:     moveq   #16,D3
02:0003CDDE 10343070        	  7172:     move.b  ($70,A4,D3.W),D0
02:0003CDE2 123C0008        	  7173:     move.b  #$08,D1
02:0003CDE6 D101            	  7174:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CDE8 19400002        	  7175:     move.b  D0,($0002,A4)
                            	  7176:     ; Store the bomb's (Y + 8) in [03].
                            	  7177:     ;
02:0003CDEC 41EC0084        	  7178:     lea     ($0084,A4),A0
02:0003CDF0 10303000        	  7179:     move.b  (A0,D3.W),D0
02:0003CDF4 123C0008        	  7180:     move.b  #$08,D1
02:0003CDF8 D101            	  7181:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CDFA 19400003        	  7182:     move.b  D0,($0003,A4)
                            	  7183:     ; But, if there's no bomb, then return.
                            	  7184:     ;
02:0003CDFE 41EC00AC        	  7185:     lea     ($00AC,A4),A0
