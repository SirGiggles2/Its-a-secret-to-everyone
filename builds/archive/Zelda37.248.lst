02:00044552 B001            	  7157:     cmp.b   D1,D0
02:00044554 6704            	  7158:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00044556 5302            	  7159:     subq.b  #1,D2
02:00044558 66EE            	  7160:     bne  _anon_z05_149
                            	  7161:     even
