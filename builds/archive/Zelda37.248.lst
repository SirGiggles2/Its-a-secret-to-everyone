                            	  7386: ; Y: weapon or Link object slot (copied from [00])
                            	  7387: ; Z: 0 if objects collide
                            	  7388: ; [06]: 1 if objects collide
                            	  7389: ; [0A]: horizontal distance
                            	  7390: ; [0B]: vertical distance
                            	  7391: ;
                            	  7392: ;
