                            	 12735:     even
                            	 12736: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F6D6 19420340        	 12737:     move.b  D2,($0340,A4)
                            	 12738:     ; If object slot < 5 or = 7, then move every frame.
                            	 12739:     ; Else move 3 out of every 4 frames.
                            	 12740:     ;
                            	 12741:     ; This makes pieces spread out in somewhat of a circle,
                            	 12742:     ; by making the pieces at cardinal directions move at
                            	 12743:     ; full speed while the diagonal ones move a little slower.
                            	 12744:     ;
02:0003F6DA 0C020005        	 12745:     cmpi.b  #$05,D2
02:0003F6DE 6510            	 12746:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F6E0 0C020007        	 12747:     cmpi.b  #$07,D2
02:0003F6E4 670A            	 12748:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F6E6 102C0015        	 12749:     move.b  ($0015,A4),D0
02:0003F6EA 02000003        	 12750:     andi.b #$03,D0
02:0003F6EE 6704            	 12751:     beq  _anon_z04_164
                            	 12752:     even
