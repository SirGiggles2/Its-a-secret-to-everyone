                            	  1816: _L_z01_TransferDemoPatterns_LoopBlock:
                            	  1817:     ; Loop over each block.
                            	  1818:     ;
02:0002EF8C 102C051D        	  1819:     move.b  ($051D,A4),D0
02:0002EF90 E308            	  1820:     lsl.b  #1,D0   ; ASL A
02:0002EF92 7400            	  1821:     moveq   #0,D2
02:0002EF94 1400            	  1822:     move.b  D0,D2
                            	  1823:     ; Put block address in [00:01] and size in [03:02].
                            	  1824:     ; Load destination VRAM address and set it.
                            	  1825:     ; The size and VRAM address have the high byte first.
                            	  1826:     ;
02:0002EF96 41F90002EF70    	  1827:     lea     (DemoPatternBlockAddrs).l,A0
