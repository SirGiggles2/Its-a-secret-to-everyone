                            	  3109:     ; Finish handling state 2.
                            	  3110:     ;
                            	  3111:     ; If the current coordinate = original coordinate, then go to state 0.
                            	  3112:     ;
02:000308CC 1003            	  3113:     move.b  D3,D0
02:000308CE 41EC0380        	  3114:     lea     ($0380,A4),A0
02:000308D2 12302000        	  3115:     move.b  (A0,D2.W),D1
02:000308D6 B001            	  3116:     cmp.b   D1,D0
02:000308D8 6702            	  3117:     beq.s  __far_z_01_0017
02:000308DA 600A            	  3118:     jmp  L_Trap_DrawAndCheckCollisions
