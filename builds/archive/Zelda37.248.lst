02:0003B3E2 41EC03E4        	  3598:     lea     ($03E4,A4),A0
02:0003B3E6 12302000        	  3599:     move.b  (A0,D2.W),D1
02:0003B3EA B300            	  3600:     eor.b  D1,D0
02:0003B3EC 41EC03E4        	  3601:     lea     ($03E4,A4),A0
02:0003B3F0 11802000        	  3602:     move.b  D0,(A0,D2.W)
                            	  3603:     even
