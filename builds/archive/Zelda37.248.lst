                            	  4195: CheckTiles:
                            	  4196:     ifne TURBO_LINK
                            	  4197:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4198:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004BB38 4A02            	  4199:     tst.b   D2
