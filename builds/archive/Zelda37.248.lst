                            	  6559: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6560:     ; Reset values used in special item drops.
                            	  6561:     ;
02:000321AE 7000            	  6562:     moveq   #0,D0
02:000321B0 19400627        	  6563:     move.b  D0,($0627,A4)
02:000321B4 19400050        	  6564:     move.b  D0,($0050,A4)
02:000321B8 19400051        	  6565:     move.b  D0,($0051,A4)
                            	  6566:     ; If heart partial >= low damage points byte, then simply
                            	  6567:     ; subtract the damage byte from heart partial.
                            	  6568:     ; Else go borrow from full hearts.
                            	  6569:     ;
02:000321BC 102C0670        	  6570:     move.b  ($0670,A4),D0
02:000321C0 122C000E        	  6571:     move.b  ($000E,A4),D1
02:000321C4 B001            	  6572:     cmp.b   D1,D0
02:000321C6 6546            	  6573:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:000321C8 003C0011        	  6574:     ori     #$11,CCR  ; SEC: set C+X
02:000321CC 122C000E        	  6575:     move.b  ($000E,A4),D1
02:000321D0 0A3C0010        	  6576:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321D4 9101            	  6577:     subx.b  D1,D0   ; SBC $0E
02:000321D6 0A3C0010        	  6578:     eori    #$10,CCR  ; restore X = 6502 C
02:000321DA 19400670        	  6579:     move.b  D0,($0670,A4)
                            	  6580:     ; If full hearts >= high damage points byte, then simply
                            	  6581:     ; subtract the damage byte from full hearts.
                            	  6582:     ; Else go handle Link dying.
                            	  6583:     ;
02:000321DE 102C066F        	  6584:     move.b  ($066F,A4),D0
02:000321E2 0200000F        	  6585:     andi.b #$0F,D0
02:000321E6 122C000D        	  6586:     move.b  ($000D,A4),D1
02:000321EA B001            	  6587:     cmp.b   D1,D0
02:000321EC 6554            	  6588:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:000321EE 102C066F        	  6589:     move.b  ($066F,A4),D0
02:000321F2 003C0011        	  6590:     ori     #$11,CCR  ; SEC: set C+X
02:000321F6 122C000D        	  6591:     move.b  ($000D,A4),D1
02:000321FA 0A3C0010        	  6592:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321FE 9101            	  6593:     subx.b  D1,D0   ; SBC $0D
02:00032200 0A3C0010        	  6594:     eori    #$10,CCR  ; restore X = 6502 C
02:00032204 1940066F        	  6595:     move.b  D0,($066F,A4)
02:00032208 0A3C0001        	  6596:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003220C 4E75            	  6597:     rts
