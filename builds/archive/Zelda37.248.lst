02:00041AFC 0200000C        	  2972:     andi.b #$0C,D0
02:00041B00 6602            	  2973:     bne  _anon_z05_77
02:00041B02 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
