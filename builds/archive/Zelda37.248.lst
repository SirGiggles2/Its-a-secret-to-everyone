02:00031BA2 7600            	  5753:     moveq   #0,D3
02:00031BA4 162C000E        	  5754:     move.b  ($000E,A4),D3
02:00031BA8 7001            	  5755:     moveq   #1,D0
02:00031BAA 19400007        	  5756:     move.b  D0,($0007,A4)
02:00031BAE 7008            	  5757:     moveq   #8,D0
02:00031BB0 1940000A        	  5758:     move.b  D0,($000A,A4)
02:00031BB4 41F900031904    	  5759:     lea     (ObjAnimations).l,A0
02:00031BBA 10303000        	  5760:     move.b  (A0,D3.W),D0
02:00031BBE 023C00EE        	  5761:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BC2 122C000D        	  5762:     move.b  ($000D,A4),D1
02:00031BC6 D101            	  5763:     addx.b  D1,D0   ; ADC $0D
02:00031BC8 7600            	  5764:     moveq   #0,D3
02:00031BCA 1600            	  5765:     move.b  D0,D3
02:00031BCC 41F900031984    	  5766:     lea     (ObjAnimFrameHeap).l,A0
02:00031BD2 10303000        	  5767:     move.b  (A0,D3.W),D0
02:00031BD6 19400002        	  5768:     move.b  D0,($0002,A4)
02:00031BDA 023C00EE        	  5769:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BDE 123C0002        	  5770:     move.b  #$02,D1
02:00031BE2 D101            	  5771:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00031BE4 19400003        	  5772:     move.b  D0,($0003,A4)
                            	  5773:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  5774:     ; then go set attributes and write sprites.
