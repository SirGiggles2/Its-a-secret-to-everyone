02:0004CDEE 660C            	  6974:     bne  _anon_z07_39
02:0004CDF0 102C00AC        	  6975:     move.b  ($00AC,A4),D0
02:0004CDF4 020000C0        	  6976:     andi.b #$C0,D0
02:0004CDF8 194000AC        	  6977:     move.b  D0,($00AC,A4)
