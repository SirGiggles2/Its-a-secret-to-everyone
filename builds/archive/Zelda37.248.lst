                            	  5859: _anon_z04_82:
                            	  5860:     ; Turn randomly while flying, as usual.
                            	  5861:     ;
02:0003C436 61003A9E        	  5862:     jsr     Flyer_Wander
                            	  5863:     ; After every turn, the common flyer routines set timer to $10.
                            	  5864:     ; This can be used as a signal for moldorm to propagate
                            	  5865:     ; direction changes down the chain.
                            	  5866:     ;
                            	  5867:     ; Between each turn, timer <> $10.
                            	  5868:     ;
                            	  5869:     ; At the end of the delay after the last turn, timer = 0.
                            	  5870:     ; This is a signal that that flying state ended, and a new one
                            	  5871:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5872:     ; we can propagate direction changes again; and start
                            	  5873:     ; a new flying interval by setting timer to $10. This will make
                            	  5874:     ; the next flying state delay that amount of time before turning
                            	  5875:     ; the first time.
                            	  5876:     ;
                            	  5877:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5878:     ; arm the timer again, and shift directions down the chain.
                            	  5879:     ;
02:0003C43A 10342028        	  5880:     move.b  ($28,A4,D2.W),D0
02:0003C43E 6602            	  5881:     bne.s  __far_z_04_0044
02:0003C440 60CE            	  5882:     jmp  Moldorm_ChangeFlyingState
                            	  5883: __far_z_04_0044:
                            	  5884:     even
