02:0003B554 0C000070        	  3843:     cmpi.b  #$70,D0
02:0003B558 6604            	  3844:     bne  _anon_z04_51
02:0003B55A 61000686        	  3845:     jsr     PlaySecretFoundTune
                            	  3846: _anon_z04_51:
                            	  3847:     ; Replace the tile where the armos was.
                            	  3848:     ;
02:0003B55E 522C00F7        	  3849:     addq.b  #1,($00F7,A4)
02:0003B562 101D            	  3850:     move.b  (A5)+,D0  ; PLA
02:0003B564 4EB90004ADFC    	  3851:     jsr     ChangeTileObjTiles
                            	  3852:     ; Because the armos object is aligned to the square grid
                            	  3853:     ; (because it was made from a square),
                            	  3854:     ; set its grid offset to 3 to compensate.
                            	  3855:     ;
                            	  3856:     ; Most objects are aligned to the grid vertically when the
                            	  3857:     ; low nibble is $D.
                            	  3858:     ;
02:0003B56A 7003            	  3859:     moveq   #3,D0
02:0003B56C 41EC0394        	  3860:     lea     ($0394,A4),A0
02:0003B570 11802000        	  3861:     move.b  D0,(A0,D2.W)
                            	  3862:     ; Set a speed (q-speed fraction) randomly:
                            	  3863:     ; $20 if random value < $80
                            	  3864:     ; $60 otherwise
                            	  3865:     ;
02:0003B574 7020            	  3866:     moveq   #32,D0
02:0003B576 7600            	  3867:     moveq   #0,D3
02:0003B578 16342019        	  3868:     move.b  ($19,A4,D2.W),D3
02:0003B57C 0C030080        	  3869:     cmpi.b  #$80,D3
02:0003B580 6502            	  3870:     bcs  _anon_z04_52
