                            	  3739: InitArmosOrFlyingGhini:
                            	  3740:     ; In UpdateObject, this object was flagged "initialized".
                            	  3741:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3742:     ;
02:0003B4C8 10342028        	  3743:     move.b  ($28,A4,D2.W),D0
02:0003B4CC 41EC0492        	  3744:     lea     ($0492,A4),A0
02:0003B4D0 11802000        	  3745:     move.b  D0,(A0,D2.W)
                            	  3746:     ; If it's still fading in, then go finish some initialization needed
                            	  3747:     ; for fading in.
                            	  3748:     ;
02:0003B4D4 660000B6        	  3749:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3750:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3751:     ; go finish initializing it.
                            	  3752:     ;
02:0003B4D8 41EC034F        	  3753:     lea     ($034F,A4),A0
02:0003B4DC 10302000        	  3754:     move.b  (A0,D2.W),D0
02:0003B4E0 0C000022        	  3755:     cmpi.b  #$22,D0
02:0003B4E4 670000A6        	  3756:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3757:     ; Else we have an armos.
                            	  3758:     ;
                            	  3759:     ; Store stairs tile $70 in [00] for use later.
                            	  3760:     ;
02:0003B4E8 7070            	  3761:     moveq   #112,D0
02:0003B4EA 1880            	  3762:     move.b  D0,($0000,A4)
                            	  3763:     ; Look for the current room ID in an array of room ID's that
                            	  3764:     ; have armos secrets.
                            	  3765:     ;
02:0003B4EC 7606            	  3766:     moveq   #6,D3
                            	  3767:     even
                            	  3768: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B4EE 102C00EB        	  3769:     move.b  ($00EB,A4),D0
                            	  3770:     ; If this element does not match the current room ID, go loop again.
                            	  3771:     ;
02:0003B4F2 41F90003B4B8    	  3772:     lea     (SecretArmosRoomIds).l,A0
02:0003B4F8 12303000        	  3773:     move.b  (A0,D3.W),D1
02:0003B4FC B001            	  3774:     cmp.b   D1,D0
02:0003B4FE 6648            	  3775:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3776:     ; The secret (usually stairs) is under one of the armoses.
                            	  3777:     ;
                            	  3778:     ; If the armos's X coordinate does not match the one needed
                            	  3779:     ; for the current room in the list, then go loop again.
                            	  3780:     ;
02:0003B500 10342070        	  3781:     move.b  ($70,A4,D2.W),D0
02:0003B504 41F90003B4C0    	  3782:     lea     (SecretArmosXs).l,A0
02:0003B50A 12303000        	  3783:     move.b  (A0,D3.W),D1
02:0003B50E B001            	  3784:     cmp.b   D1,D0
02:0003B510 6636            	  3785:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3786:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3787:     ;
02:0003B512 41EC0084        	  3788:     lea     ($0084,A4),A0
02:0003B516 10302000        	  3789:     move.b  (A0,D2.W),D0
02:0003B51A 0C000080        	  3790:     cmpi.b  #$80,D0
02:0003B51E 6628            	  3791:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3792:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3793:     ;
02:0003B520 4A03            	  3794:     cmpi.b  #$00,D3
02:0003B522 662C            	  3795:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3796:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3797:     ; has the power bracelet.
                            	  3798:     ;
                            	  3799:     ; Set up the room item with the armos's coordinates.
                            	  3800:     ;
02:0003B524 19400097        	  3801:     move.b  D0,($0097,A4)
02:0003B528 10342070        	  3802:     move.b  ($70,A4,D2.W),D0
02:0003B52C 19400083        	  3803:     move.b  D0,($0083,A4)
                            	  3804:     ; This resets the room item's state, which activates it.
                            	  3805:     ;
02:0003B530 194300BF        	  3806:     move.b  D3,($00BF,A4)
                            	  3807:     ; Set the room item ID.
                            	  3808:     ;
02:0003B534 7014            	  3809:     moveq   #20,D0
02:0003B536 194000AB        	  3810:     move.b  D0,($00AB,A4)
                            	  3811:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3812:     ;
                            	  3813:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3814:     ;
                            	  3815:     ; Note that, if the item was already taken, then the room item
                            	  3816:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3817:     ; it will be ignored, because that routine checks whether
                            	  3818:     ; the item was taken.
                            	  3819:     ;
02:0003B53A 4EB9000314FA    	  3820:     jsr     GetRoomFlagUWItemState
02:0003B540 660A            	  3821:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B542 6100069E        	  3822:     jsr     PlaySecretFoundTune
02:0003B546 6604            	  3823:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3824:     even
                            	  3825: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3826:     ; Bottom of the loop.
                            	  3827:     ;
02:0003B548 5303            	  3828:     subq.b  #1,D3
02:0003B54A 6AA2            	  3829:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3830:     even
                            	  3831: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3832:     ; Not found, or found the power bracelet.
