02:0003D3A2 6100C8B6        	  7987:     jsr     UpdateCommonWanderer
                            	  7988:     ; Like-like has a 4 animation frame cycle unlike most monsters
                            	  7989:     ; which have 2.
                            	  7990:     ;
02:0003D3A6 41EC03D0        	  7991:     lea     ($03D0,A4),A0
