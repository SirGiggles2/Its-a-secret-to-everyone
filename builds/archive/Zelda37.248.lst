02:00031B4C 1003            	  5662:     move.b  D3,D0
02:00031B4E 6004            	  5663:     jmp     DrawObjectNotMirrored
                            	  5664: 
                            	  5665: ; Params:
                            	  5666: ; A: frame image
                            	  5667: ; X: object index
                            	  5668: ; [00]: object X
                            	  5669: ; [01]: object Y
                            	  5670: ;
                            	  5671: ;
                            	  5672: ; Set [0C] mirrored.
                            	  5673:     even
                            	  5674: DrawObjectMirrored:
02:00031B50 7601            	  5675:     moveq   #1,D3
02:00031B52 6602            	  5676:     bne  _anon_z01_75
                            	  5677: ; Params:
                            	  5678: ; A: frame image
                            	  5679: ; X: object index
                            	  5680: ; [00]: object X
                            	  5681: ; [01]: object Y
                            	  5682: ; [0F]: flip horizontally
                            	  5683: ;
                            	  5684:     even
                            	  5685: DrawObjectNotMirrored:
02:00031B54 7600            	  5686:     moveq   #0,D3
                            	  5687: _anon_z01_75:
02:00031B56 1943000C        	  5688:     move.b  D3,($000C,A4)
                            	  5689:     ; Set animation index = object type + 1.
                            	  5690:     ;
02:00031B5A 7600            	  5691:     moveq   #0,D3
02:00031B5C 41EC034F        	  5692:     lea     ($034F,A4),A0
02:00031B60 16302000        	  5693:     move.b  (A0,D2.W),D3
                            	  5694: ; Params:
                            	  5695: ; A: frame
                            	  5696: ; X: object index/cycle sprite index
                            	  5697: ; Y: object type
                            	  5698: ; [00]: object X
                            	  5699: ; [01]: object Y
                            	  5700: ; [0C]: mirrored
                            	  5701: ; [0F]: flip horizontally
                            	  5702: ;
                            	  5703: ; Note:
                            	  5704: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5705: ;
                            	  5706: ; The animation index of most objects is (object type + 1),
                            	  5707: ; to make up for the fact that Link uses two animation indexes.
                            	  5708: ;
                            	  5709:     even
                            	  5710: DrawObjectWithType:
02:00031B64 5203            	  5711:     addq.b  #1,D3
                            	  5712: ; Params:
                            	  5713: ; A: frame
                            	  5714: ; X: object index/cycle sprite index
                            	  5715: ; Y: animation index
                            	  5716: ; [00]: object X
                            	  5717: ; [01]: object Y
                            	  5718: ; [0C]: mirrored
                            	  5719: ; [0F]: flip horizontally
                            	  5720: ;
                            	  5721: ; Note:
                            	  5722: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5723: ; But Link uses [0F] for flipping without checking [0C].
                            	  5724: ;
                            	  5725: ;
                            	  5726: ; [0D] holds frame.
                            	  5727:     even
                            	  5728: DrawObjectWithAnim:
02:00031B66 1940000D        	  5729:     move.b  D0,($000D,A4)
02:00031B6A 1943000E        	  5730:     move.b  D3,($000E,A4)
02:00031B6E 19420008        	  5731:     move.b  D2,($0008,A4)
                            	  5732:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5733:     ;
02:00031B72 7600            	  5734:     moveq   #0,D3
02:00031B74 162C0341        	  5735:     move.b  ($0341,A4),D3
02:00031B78 41F900031B1C    	  5736:     lea     (SpriteOffsets).l,A0
02:00031B7E 10303000        	  5737:     move.b  (A0,D3.W),D0
02:00031B82 19400343        	  5738:     move.b  D0,($0343,A4)
02:00031B86 41F900031B1D    	  5739:     lea     (SpriteOffsets+1).l,A0
02:00031B8C 10303000        	  5740:     move.b  (A0,D3.W),D0
                            	  5741:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5742:     ;
02:00031B90 4A02            	  5743:     cmpi.b  #$00,D2
02:00031B92 6702            	  5744:     beq.s  __far_z_01_0049
02:00031B94 6008            	  5745:     jmp  DrawObjectWithAnimAndSpecificSprites
