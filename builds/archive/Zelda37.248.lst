02:0003D19C 0C0000B0        	  7752:     cmpi.b  #$B0,D0
02:0003D1A0 6742            	  7753:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003D1A2 0C0000F4        	  7754:     cmpi.b  #$F4,D0
