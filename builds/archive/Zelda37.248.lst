02:0003F28C 123C0003        	 12126:     move.b  #$03,D1
02:0003F290 0A3C0010        	 12127:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F294 9101            	 12128:     subx.b  D1,D0   ; SBC #$03
02:0003F296 0A3C0010        	 12129:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F29A 7600            	 12130:     moveq   #0,D3
02:0003F29C 1600            	 12131:     move.b  D0,D3
                            	 12132:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12133:     ; then return.
                            	 12134:     ;
