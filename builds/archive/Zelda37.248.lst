                            	  8024:     ;   Go set object direction and input direction to object
                            	  8025:     ;   direction, and set Link's speed. Also, *SET*
                            	  8026:     ;   Link_GoStraightWhenDiagInput.
                            	  8027:     ;
02:00044DE6 7600            	  8028:     moveq   #0,D3
02:00044DE8 162C0010        	  8029:     move.b  ($0010,A4),D3
02:00044DEC 6748            	  8030:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
