02:00036828 102C0085        	  4792:     move.b  ($0085,A4),D0
02:0003682C 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:00036830 123C0010        	  4794:     move.b  #$10,D1
02:00036834 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036838 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:0003683A 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
