02:0003E0F4 19410002        	  9767:     move.b  D1,($0002,A4)
02:0003E0F8 122C0002        	  9768:     move.b  ($0002,A4),D1
02:0003E0FC C200            	  9769:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E0FE 6704            	  9770:     beq  _anon_z04_119
02:0003E100 53342070        	  9771:     subq.b  #1,($70,A4,D2.W)
                            	  9772: _anon_z04_119:
