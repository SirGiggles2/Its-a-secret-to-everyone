02:00031152 003C0011        	  4437:     ori     #$11,CCR  ; SEC: set C+X
02:00031156 122C0001        	  4438:     move.b  ($0001,A4),D1
02:0003115A 0A3C0010        	  4439:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003115E 9101            	  4440:     subx.b  D1,D0   ; SBC $01
