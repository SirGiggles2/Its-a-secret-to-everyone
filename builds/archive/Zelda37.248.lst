                            	  3364: _L_z04_UpdateRedLeever_Subtract:
                            	  3365:     ; The point is to get the absolute distance between the two.
                            	  3366:     ;
02:0003B226 102C0001        	  3367:     move.b  ($0001,A4),D0
02:0003B22A 003C0011        	  3368:     ori     #$11,CCR  ; SEC: set C+X
02:0003B22E 122C0002        	  3369:     move.b  ($0002,A4),D1
02:0003B232 0A3C0010        	  3370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B236 9101            	  3371:     subx.b  D1,D0   ; SBC $02
