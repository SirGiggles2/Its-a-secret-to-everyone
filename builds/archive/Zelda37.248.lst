02:0003078A 9101            	  2945:     subx.b  D1,D0   ; SBC ObjY,X
02:0003078C 0A3C0010        	  2946:     eori    #$10,CCR  ; restore X = 6502 C
02:00030790 6100086E        	  2947:     jsr     Abs
02:00030794 0C00000E        	  2948:     cmpi.b  #$0E,D0
