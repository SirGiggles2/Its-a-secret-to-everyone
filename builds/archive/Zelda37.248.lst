                            	 12880: Ganon_CheckCollisions:
                            	 12881:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12882:     ; Store in [02] and [03].
                            	 12883:     ;
02:0003F7EE 10342070        	 12884:     move.b  ($70,A4,D2.W),D0
02:0003F7F2 023C00EE        	 12885:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F7F6 123C0010        	 12886:     move.b  #$10,D1
02:0003F7FA D101            	 12887:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F7FC 19400002        	 12888:     move.b  D0,($0002,A4)
02:0003F800 41EC0084        	 12889:     lea     ($0084,A4),A0
02:0003F804 10302000        	 12890:     move.b  (A0,D2.W),D0
02:0003F808 023C00EE        	 12891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F80C 123C0010        	 12892:     move.b  #$10,D1
02:0003F810 D101            	 12893:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F812 19400003        	 12894:     move.b  D0,($0003,A4)
                            	 12895:     ; Check for a collision with Link.
                            	 12896:     ;
                            	 12897:     ; We can't call CheckLinkCollision, because we need to
                            	 12898:     ; customize Ganon's midpoint.
                            	 12899:     ;
                            	 12900:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12901:     ; detection, if Link is invincible. Initialize variables that will
                            	 12902:     ; be returned from the partial collision check routine. Then
                            	 12903:     ; call it.
                            	 12904:     ;
02:0003F816 102C04F0        	 12905:     move.b  ($04F0,A4),D0
02:0003F81A 6616            	 12906:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F81C 19400006        	 12907:     move.b  D0,($0006,A4)
02:0003F820 19400009        	 12908:     move.b  D0,($0009,A4)
02:0003F824 1940000C        	 12909:     move.b  D0,($000C,A4)
02:0003F828 7600            	 12910:     moveq   #0,D3
02:0003F82A 1883            	 12911:     move.b  D3,($0000,A4)
02:0003F82C 4EB900032050    	 12912:     jsr     CheckLinkCollisionPreinit
                            	 12913:     even
                            	 12914: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12915:     ; If Ganon is not in state 0, then he's brown.
                            	 12916:     ; Go check collision with an arrow.
                            	 12917:     ;
02:0003F832 41EC00AC        	 12918:     lea     ($00AC,A4),A0
02:0003F836 10302000        	 12919:     move.b  (A0,D2.W),D0
02:0003F83A 6652            	 12920:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12921:     ; If timer <> 0, then Ganon is visible.
                            	 12922:     ; He can't be harmed like this. So, return.
                            	 12923:     ;
02:0003F83C 10342028        	 12924:     move.b  ($28,A4,D2.W),D0
02:0003F840 664A            	 12925:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F842 760D            	 12926:     moveq   #13,D3
02:0003F844 4EB90003251A    	 12927:     jsr     CheckMonsterSwordCollision
