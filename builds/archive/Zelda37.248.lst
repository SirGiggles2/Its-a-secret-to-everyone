                            	  6956: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6957:     ; To animate the state, the animation counter had to have
                            	  6958:     ; reached 0. Right after this routine, the counter will be
                            	  6959:     ; rolled over, and the movement frame will be switched.
                            	  6960:     ;
                            	  6961:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6962:     ; the animation here, in order to immediately change it to
                            	  6963:     ; 0 (legs apart) after this.
                            	  6964:     ;
02:0004CDE2 7001            	  6965:     moveq   #1,D0
02:0004CDE4 194003E4        	  6966:     move.b  D0,($03E4,A4)
02:0004CDE8 4E75            	  6967:     rts
                            	  6968: 
                            	  6969:     even
                            	  6970: _L_z07_AnimateLinkObjState_CheckState30:
