                            	 12427: __far_z_04_0119:
                            	 12428:     ; State = 0: Blue
                            	 12429:     ;
                            	 12430:     ; If timer = 0, then go move around and shoot.
                            	 12431:     ;
02:0003F4AA 10342028        	 12432:     move.b  ($28,A4,D2.W),D0
02:0003F4AE 6602            	 12433:     bne.s  __far_z_04_0120
02:0003F4B0 600E            	 12434:     jmp  Ganon_MoveAndShoot
                            	 12435: __far_z_04_0120:
                            	 12436:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12437:     ; Collisions were checked already.
                            	 12438:     ;
                            	 12439:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12440:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12441:     ;
02:0003F4B2 0C000001        	 12442:     cmpi.b  #$01,D0
