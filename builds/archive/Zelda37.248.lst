                            	  6446: __far_z_01_0064:
                            	  6447:     ; If Link and the shot are not facing opposite directions,
                            	  6448:     ; then go harm Link.
                            	  6449:     ;
                            	  6450:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6451:     ; component of a monster that can move diagonally.
                            	  6452:     ;
02:000320EC 102C0098        	  6453:     move.b  ($0098,A4),D0
02:000320F0 41EC0098        	  6454:     lea     ($0098,A4),A0
02:000320F4 12302000        	  6455:     move.b  (A0,D2.W),D1
02:000320F8 8001            	  6456:     or.b  D1,D0
02:000320FA 0200000C        	  6457:     andi.b #$0C,D0
02:000320FE 0C00000C        	  6458:     cmpi.b  #$0C,D0
02:00032102 671A            	  6459:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00032104 102C0098        	  6460:     move.b  ($0098,A4),D0
02:00032108 41EC0098        	  6461:     lea     ($0098,A4),A0
02:0003210C 12302000        	  6462:     move.b  (A0,D2.W),D1
02:00032110 8001            	  6463:     or.b  D1,D0
02:00032112 02000003        	  6464:     andi.b #$03,D0
02:00032116 0C000003        	  6465:     cmpi.b  #$03,D0
02:0003211A 6702            	  6466:     beq.s  __far_z_01_0065
