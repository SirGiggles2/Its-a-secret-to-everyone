                            	  2686: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2687:     ; If reversal count >= 2, then
                            	  2688:     ; 1. invert the horizontal component of facing direction,
                            	  2689:     ;    to face away from the chase target
                            	  2690:     ; 2. reset the reversal count to 0.
                            	  2691:     ;
                            	  2692:     ; This prevents a jumper from getting stuck in a corner.
                            	  2693:     ;
                            	  2694:     ; For example, if a tektite's direction is down and right,
                            	  2695:     ; and jumps into the top right corner of the room:
                            	  2696:     ; 1. The right room boundary is hit. So the direction is
                            	  2697:     ;    automatically reversed to up and left.
                            	  2698:     ; 2. The next frame, the top room boundary is hit.
                            	  2699:     ;    The direction is reversed to down and right.
                            	  2700:     ;
                            	  2701:     ; As you can see, an endless loop has been made.
                            	  2702:     ;
02:0003AD0E 41EC0451        	  2703:     lea     ($0451,A4),A0
02:0003AD12 10302000        	  2704:     move.b  (A0,D2.W),D0
02:0003AD16 0C000002        	  2705:     cmpi.b  #$02,D0
02:0003AD1A 651E            	  2706:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003AD1C 41EC0098        	  2707:     lea     ($0098,A4),A0
02:0003AD20 10302000        	  2708:     move.b  (A0,D2.W),D0
02:0003AD24 0A000003        	  2709:     eori.b #$03,D0
02:0003AD28 41EC0098        	  2710:     lea     ($0098,A4),A0
02:0003AD2C 11802000        	  2711:     move.b  D0,(A0,D2.W)
02:0003AD30 7000            	  2712:     moveq   #0,D0
02:0003AD32 41EC0451        	  2713:     lea     ($0451,A4),A0
02:0003AD36 11802000        	  2714:     move.b  D0,(A0,D2.W)
                            	  2715:     even
                            	  2716: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2717:     ; If the object is a boulder, then make sure its facing direction
                            	  2718:     ; has a down vertical component.
                            	  2719:     ;
02:0003AD3A 610001F8        	  2720:     jsr     Jumper_PointBoulderDownward
                            	  2721:     ; For the given direction, get the Y offset of the destination
                            	  2722:     ; of the jump.
                            	  2723:     ;
                            	  2724:     ; Add it to the object's Y, and store this destination Y.
                            	  2725:     ;
02:0003AD3E 7600            	  2726:     moveq   #0,D3
02:0003AD40 41EC0098        	  2727:     lea     ($0098,A4),A0
02:0003AD44 16302000        	  2728:     move.b  (A0,D2.W),D3
02:0003AD48 41EC0084        	  2729:     lea     ($0084,A4),A0
02:0003AD4C 10302000        	  2730:     move.b  (A0,D2.W),D0
