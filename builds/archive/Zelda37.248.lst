                            	  5814: __far_z_04_0041:
                            	  5815:     even
                            	  5816: Moldorm_ChangeFlyingState:
                            	  5817:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5818:     ;
02:0003C410 61000096        	  5819:     jsr     Flyer_MoldormDecideState
02:0003C414 7010            	  5820:     moveq   #16,D0
02:0003C416 19802028        	  5821:     move.b  D0,($28,A4,D2.W)
                            	  5822:     ; If the next lower slot's direction <> 0, then
                            	  5823:     ; go propagate direction changes down the chain.
                            	  5824:     ;
                            	  5825:     ; But you had to have propagated directions once for the
                            	  5826:     ; next lower direction to be set. How does it happen?
                            	  5827:     ;
                            	  5828:     ; Within a flyer state, the flying routines turn the flyer
                            	  5829:     ; and set the object timer to $10 several times. After any of
                            	  5830:     ; those times will the test succeed.
                            	  5831:     ;
                            	  5832:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5833:     ; in this block to set the timer to $10, and try to propagate
                            	  5834:     ; directions.
                            	  5835:     ;
                            	  5836:     ; But this is also the case the first time here.
                            	  5837:     ;
                            	  5838:     ; So, I believe that the point of this test is to delay moving
                            	  5839:     ; the lower (not head) segments when starting out.
                            	  5840:     ;
02:0003C41A 41EC0097        	  5841:     lea     ($0097,A4),A0
02:0003C41E 10302000        	  5842:     move.b  (A0,D2.W),D0
02:0003C422 6702            	  5843:     beq.s  __far_z_04_0042
02:0003C424 601C            	  5844:     jmp  Moldorm_PropagateDirs
                            	  5845: __far_z_04_0042:
02:0003C426 4E75            	  5846:     rts
                            	  5847: 
                            	  5848:     even
                            	  5849: Moldorm_Wander:
