                            	   768: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   769:     ; Replace the low byte of the VRAM address with the one
                            	   770:     ; where the next character should be written.
                            	   771:     ;
02:0002E826 102C045F        	   772:     move.b  ($045F,A4),D0
02:0002E82A 19400303        	   773:     move.b  D0,($0303,A4)
                            	   774:     ; Increment the low VRAM address for the next character.
                            	   775:     ;
02:0002E82E 522C045F        	   776:     addq.b  #1,($045F,A4)
                            	   777:     ; Use the person text selector to look up the address of the
                            	   778:     ; text for the textbox. Store the address in [00:01].
                            	   779:     ;
02:0002E832 7600            	   780:     moveq   #0,D3
02:0002E834 162C0415        	   781:     move.b  ($0415,A4),D3
02:0002E838 41F90002DE6E    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E83E 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E842 1880            	   784:     move.b  D0,($0000,A4)
02:0002E844 5203            	   785:     addq.b  #1,D3
02:0002E846 41F90002DE6E    	   786:     lea     (PersonTextAddrs).l,A0
02:0002E84C 10303000        	   787:     move.b  (A0,D3.W),D0
02:0002E850 19400001        	   788:     move.b  D0,($0001,A4)
                            	   789:     ; Load the person text current character index.
                            	   790:     ;
02:0002E854 7600            	   791:     moveq   #0,D3
02:0002E856 162C0416        	   792:     move.b  ($0416,A4),D3
                            	   793:     ; Increment the index variable to point to the next character
                            	   794:     ; for next time.
                            	   795:     ;
02:0002E85A 522C0416        	   796:     addq.b  #1,($0416,A4)
                            	   797:     ; Get the current character.
                            	   798:     ;
02:0002E85E 1214            	   799:     move.b  ($00,A4),D1   ; ptr lo
02:0002E860 182C0001        	   800:     move.b  ($01,A4),D4  ; ptr hi
02:0002E864 024100FF        	   801:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E868 E14C            	   802:     lsl.w   #8,D4
02:0002E86A 8841            	   803:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E86C 48C4            	   804:     ext.l   D4
02:0002E86E D8BC00FF0000    	   805:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E874 2044            	   806:     movea.l D4,A0
02:0002E876 10303000        	   807:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   808:     ; If the character is $25, then it's a special space. It will still
                            	   809:     ; take up space, but will not take time to show -- meaning that
                            	   810:     ; we'll go look up the next character to transfer.
                            	   811:     ;
02:0002E87A 0200003F        	   812:     andi.b #$3F,D0
02:0002E87E 0C000025        	   813:     cmpi.b  #$25,D0
02:0002E882 67A2            	   814:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   815:     ; We have a non-space character. Put it in the transfer record.
                            	   816:     ;
02:0002E884 19400305        	   817:     move.b  D0,($0305,A4)
                            	   818:     ; Play the "heart taken/character" sound effect.
                            	   819:     ;
02:0002E888 7010            	   820:     moveq   #16,D0
02:0002E88A 19400604        	   821:     move.b  D0,($0604,A4)
                            	   822:     ; If the high 2 bits of character element = 0, then return.
                            	   823:     ;
02:0002E88E 1214            	   824:     move.b  ($00,A4),D1   ; ptr lo
02:0002E890 182C0001        	   825:     move.b  ($01,A4),D4  ; ptr hi
02:0002E894 024100FF        	   826:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E898 E14C            	   827:     lsl.w   #8,D4
02:0002E89A 8841            	   828:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E89C 48C4            	   829:     ext.l   D4
02:0002E89E D8BC00FF0000    	   830:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E8A4 2044            	   831:     movea.l D4,A0
02:0002E8A6 10303000        	   832:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E8AA 020000C0        	   833:     andi.b #$C0,D0
02:0002E8AE 672E            	   834:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   835:     ; Determine an index based on the high 2 bits of the character element:
                            	   836:     ;   $80: 0
                            	   837:     ;   $40: 1
                            	   838:     ;   $C0: 2
                            	   839:     ;
02:0002E8B0 7602            	   840:     moveq   #2,D3
02:0002E8B2 0C0000C0        	   841:     cmpi.b  #$C0,D0
02:0002E8B6 670A            	   842:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E8B8 5303            	   843:     subq.b  #1,D3
02:0002E8BA 0C000040        	   844:     cmpi.b  #$40,D0
02:0002E8BE 6702            	   845:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E8C0 5303            	   846:     subq.b  #1,D3
                            	   847:     even
                            	   848: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   849:     ; The index chooses the low VRAM address of the start
                            	   850:     ; of another line:
                            	   851:     ;   0: $C4: front of the second line
                            	   852:     ;   1: $E4: front of the third line
                            	   853:     ;   2: $A4: front of the first line
                            	   854:     ;
                            	   855:     ; Look up the low VRAM address and store it.
                            	   856:     ;
