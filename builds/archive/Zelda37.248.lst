                            	  9820:     even
                            	  9821: _L_z04_UpdateGohma_AnimateEye:
                            	  9822:     ; Animate the eye.
                            	  9823:     ;
                            	  9824:     ; First, if the counter for when to open the eye next = 0, then
                            	  9825:     ; set it to a random value at least $C0; and set the timer for
                            	  9826:     ; keeping the eye open to $80.
                            	  9827:     ;
                            	  9828:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9829:     ; every other frame.
                            	  9830:     ;
02:0003E172 41EC042C        	  9831:     lea     ($042C,A4),A0
02:0003E176 10302000        	  9832:     move.b  (A0,D2.W),D0
02:0003E17A 661E            	  9833:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E17C 103C0080        	  9834:     move.b  #$80,D0
02:0003E180 41EC0444        	  9835:     lea     ($0444,A4),A0
02:0003E184 11802000        	  9836:     move.b  D0,(A0,D2.W)
02:0003E188 103C00C0        	  9837:     move.b  #$C0,D0
02:0003E18C 12342018        	  9838:     move.b  ($18,A4,D2.W),D1
02:0003E190 8001            	  9839:     or.b  D1,D0
02:0003E192 41EC042C        	  9840:     lea     ($042C,A4),A0
02:0003E196 11802000        	  9841:     move.b  D0,(A0,D2.W)
                            	  9842:     even
                            	  9843: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9844:     ; Decrement the next-open-eye counter.
                            	  9845:     ;
02:0003E19A 102C0015        	  9846:     move.b  ($0015,A4),D0
02:0003E19E E208            	  9847:     lsr.b  #1,D0   ; LSR A
02:0003E1A0 6408            	  9848:     bcc  _anon_z04_122
02:0003E1A2 41EC042C        	  9849:     lea     ($042C,A4),A0
02:0003E1A6 53302000        	  9850:     subq.b  #1,(A0,D2.W)
                            	  9851: _anon_z04_122:
                            	  9852:     ; If open eye timer = 0, then the eye is closed.
                            	  9853:     ; Go animate it differently.
                            	  9854:     ;
02:0003E1AA 41EC0444        	  9855:     lea     ($0444,A4),A0
02:0003E1AE 10302000        	  9856:     move.b  (A0,D2.W),D0
02:0003E1B2 674A            	  9857:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9858:     ; Else decrement the open eye timer.
                            	  9859:     ;
02:0003E1B4 41EC0444        	  9860:     lea     ($0444,A4),A0
02:0003E1B8 53302000        	  9861:     subq.b  #1,(A0,D2.W)
                            	  9862:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9863:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9864:     ;
02:0003E1BC 7602            	  9865:     moveq   #2,D3
02:0003E1BE 0C000070        	  9866:     cmpi.b  #$70,D0
02:0003E1C2 6408            	  9867:     bcc  _anon_z04_123
02:0003E1C4 0C000010        	  9868:     cmpi.b  #$10,D0
02:0003E1C8 6502            	  9869:     bcs  _anon_z04_123
02:0003E1CA 5203            	  9870:     addq.b  #1,D3
                            	  9871: _anon_z04_123:
