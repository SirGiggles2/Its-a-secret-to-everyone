02:0003CEDE 122C0007        	  7348:     move.b  ($0007,A4),D1
02:0003CEE2 B001            	  7349:     cmp.b   D1,D0
02:0003CEE4 6B0E            	  7350:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7351:     ; The distance is close enough in this axis.
                            	  7352:     ;
                            	  7353:     ; Store the distance in this axis in [05] or [04],
                            	  7354:     ; depending on the loop index.
                            	  7355:     ;
02:0003CEE6 19803004        	  7356:     move.b  D0,($04,A4,D3.W)
