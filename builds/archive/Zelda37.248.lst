                            	  7450: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7451:     ; In bloated substates 2 and 3:
                            	  7452:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7453:     ;
02:0003CF72 102C0015        	  7454:     move.b  ($0015,A4),D0
02:0003CF76 02000002        	  7455:     andi.b #$02,D0
02:0003CF7A 6604            	  7456:     bne.s  __far_z_04_0066
