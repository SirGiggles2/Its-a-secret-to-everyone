                            	  5004: _anon_z02_37:
                            	  5005:     ; Add $80 to the scroll speed fraction.
                            	  5006:     ;
02:00036A0C 102C0058        	  5007:     move.b  ($0058,A4),D0
02:00036A10 023C00EE        	  5008:     andi    #$EE,CCR  ; CLC: clear C+X
02:00036A14 123C0080        	  5009:     move.b  #$80,D1
02:00036A18 D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00036A1A 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
02:00036A1E 6404            	  5014:     bcc  _anon_z02_38
02:00036A20 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:00036A24 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:00036A28 123C0000        	  5018:     move.b  #$00,D1
02:00036A2C D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00036A2E 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
                            	  5024:     ;
02:00036A32 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:00036A36 7000            	  5026:     moveq   #0,D0
02:00036A38 6508            	  5027:     bcs  _anon_z02_39
02:00036A3A 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:00036A3E 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
