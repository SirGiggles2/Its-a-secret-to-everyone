                            	 13774: TurnTowardsPlayer8:
                            	 13775:     ; Build a direction in [00] towards the player.
                            	 13776:     ;
                            	 13777:     ; First, calculate a horizontal component:
                            	 13778:     ;
                            	 13779:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13780:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13781:     ; else                               [00] := 2 (left)
                            	 13782:     ;
02:0003FE18 7600            	 13783:     moveq   #0,D3
02:0003FE1A 1883            	 13784:     move.b  D3,($0000,A4)
