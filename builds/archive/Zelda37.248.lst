02:0003C5EA 41EC0478        	  6159:     lea     ($0478,A4),A0
02:0003C5EE 16302000        	  6160:     move.b  (A0,D2.W),D3
                            	  6161:     ; Change the coordinates to one corner.
                            	  6162:     ;
02:0003C5F2 10342070        	  6163:     move.b  ($70,A4,D2.W),D0
02:0003C5F6 023C00EE        	  6164:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5FA 41F90003C4AE    	  6165:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C600 12303000        	  6166:     move.b  (A0,D3.W),D1
