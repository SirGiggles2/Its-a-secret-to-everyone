02:000320CC 522C034B        	  6430:     addq.b  #1,($034B,A4)
                            	  6431:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
                            	  6432:     ; then go harm Link.
                            	  6433:     ;
02:000320D0 0C000056        	  6434:     cmpi.b  #$56,D0
02:000320D4 6602            	  6435:     bne.s  __far_z_01_0062
02:000320D6 6070            	  6436:     jmp  HarmLink
                            	  6437: __far_z_01_0062:
02:000320D8 0C00005A        	  6438:     cmpi.b  #$5A,D0
02:000320DC 6602            	  6439:     bne.s  __far_z_01_0063
02:000320DE 6068            	  6440:     jmp  HarmLink
                            	  6441: __far_z_01_0063:
