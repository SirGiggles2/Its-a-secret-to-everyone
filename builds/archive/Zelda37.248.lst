02:0003F468 194000AC        	 12392:     move.b  D0,($00AC,A4)
02:0003F46C 19400505        	 12393:     move.b  D0,($0505,A4)
02:0003F470 7020            	 12394:     moveq   #32,D0
02:0003F472 19400600        	 12395:     move.b  D0,($0600,A4)
02:0003F476 522C0445        	 12396:     addq.b  #1,($0445,A4)
                            	 12397:     even
