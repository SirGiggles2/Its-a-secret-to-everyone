02:0003D3FC 19802070        	  8023:     move.b  D0,($70,A4,D2.W)
02:0003D400 102C0084        	  8024:     move.b  ($0084,A4),D0
02:0003D404 41EC0084        	  8025:     lea     ($0084,A4),A0
02:0003D408 11802000        	  8026:     move.b  D0,(A0,D2.W)
