                            	  7485: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7486:     ; Start preparing sprites.
                            	  7487:     ;
02:0003CFA4 4EB90004CD9A    	  7488:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CFAA 1003            	  7489:     move.b  D3,D0
02:0003CFAC 1B00            	  7490:     move.b  D0,-(A5)  ; PHA
                            	  7491:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7492:     ;
02:0003CFAE 41F90003CF08    	  7493:     lea     (DodongoFrameHFlips).l,A0
02:0003CFB4 10303000        	  7494:     move.b  (A0,D3.W),D0
02:0003CFB8 1940000F        	  7495:     move.b  D0,($000F,A4)
02:0003CFBC 41F90003CEFE    	  7496:     lea     (DodongoFrameImages).l,A0
02:0003CFC2 10303000        	  7497:     move.b  (A0,D3.W),D0
                            	  7498:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7499:     ; They are drawn mirrored.
                            	  7500:     ;
02:0003CFC6 0C000007        	  7501:     cmpi.b  #$07,D0
02:0003CFCA 6706            	  7502:     beq  _anon_z04_92
02:0003CFCC 0C000009        	  7503:     cmpi.b  #$09,D0
02:0003CFD0 6608            	  7504:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7505: _anon_z04_92:
02:0003CFD2 4EB900031B50    	  7506:     jsr     DrawObjectMirrored
02:0003CFD8 6006            	  7507:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7508: 
                            	  7509:     even
                            	  7510: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7511:     ; No other frame images are mirrored.
                            	  7512:     ;
02:0003CFDA 4EB900031B54    	  7513:     jsr     DrawObjectNotMirrored
                            	  7514:     even
                            	  7515: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CFE0 101D            	  7516:     move.b  (A5)+,D0  ; PLA
02:0003CFE2 7600            	  7517:     moveq   #0,D3
02:0003CFE4 1600            	  7518:     move.b  D0,D3
                            	  7519:     ; If facing vertically, then return. There's no other side to draw.
                            	  7520:     ;
02:0003CFE6 41EC0098        	  7521:     lea     ($0098,A4),A0
02:0003CFEA 10302000        	  7522:     move.b  (A0,D2.W),D0
02:0003CFEE 02000003        	  7523:     andi.b #$03,D0
02:0003CFF2 6602            	  7524:     bne.s  __far_z_04_0067
02:0003CFF4 602C            	  7525:     jmp  L11B00_Exit
                            	  7526: __far_z_04_0067:
                            	  7527:     ; Else draw the right side.
                            	  7528:     ;
                            	  7529:     ; Keep the Y coordinate in [01].
                            	  7530:     ; But, store (X + $10) in [00].
                            	  7531:     ;
02:0003CFF6 10342070        	  7532:     move.b  ($70,A4,D2.W),D0
02:0003CFFA 023C00EE        	  7533:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFFE 123C0010        	  7534:     move.b  #$10,D1
02:0003D002 D101            	  7535:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D004 1880            	  7536:     move.b  D0,($0000,A4)
02:0003D006 6114            	  7537:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7538:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7539:     ;
                            	  7540:     ; So, if we had animation frame 1, direction left:
                            	  7541:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7542:     ; - frame image index = 6 (1 + 5)
                            	  7543:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7544:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7545:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7546:     ;
                            	  7547:     ; So, 3 would have been the frame number used above for
                            	  7548:     ; the left side.
                            	  7549:     ;
                            	  7550:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7551:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7552:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7553:     ; on the right.
                            	  7554:     ;
02:0003D008 41F90003CEFE    	  7555:     lea     (DodongoFrameImages).l,A0
02:0003D00E 10303000        	  7556:     move.b  (A0,D3.W),D0
02:0003D012 0A000001        	  7557:     eori.b #$01,D0
02:0003D016 4EF900031B54    	  7558:     jmp     DrawObjectNotMirrored
                            	  7559: 
                            	  7560: ; Returns:
                            	  7561: ; A: 3
                            	  7562: ; [04]: left sprite attributes
                            	  7563: ; [05]: right sprite attributes
                            	  7564: ;
                            	  7565:     even
                            	  7566: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003D01C 4EF90002C312    	  7567:     jmp     c_anim_set_sprite_desc_level_palette_row
