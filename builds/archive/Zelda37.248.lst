                            	  5644: _L_z07_CheckState30_CheckOtherStates:
                            	  5645:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5646:     ;
                            	  5647:     ; The boomerang will now return. Reset the grid offset.
                            	  5648:     ;
02:0004C4D6 7000            	  5649:     moveq   #0,D0
02:0004C4D8 41EC0394        	  5650:     lea     ($0394,A4),A0
02:0004C4DC 11802000        	  5651:     move.b  D0,(A0,D2.W)
                            	  5652:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5653:     ;
02:0004C4E0 0C02000D        	  5654:     cmpi.b  #$0D,D2
02:0004C4E4 6408            	  5655:     bcc  _anon_z07_30
02:0004C4E6 41EC042C        	  5656:     lea     ($042C,A4),A0
02:0004C4EA 10302000        	  5657:     move.b  (A0,D2.W),D0
                            	  5658: _anon_z07_30:
02:0004C4EE 4EB900031054    	  5659:     jsr     GetDirectionsAndDistancesToTarget
                            	  5660:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5661:     ; then go move towards the thrower, draw, and check collisions.
                            	  5662:     ;
02:0004C4F4 1014            	  5663:     move.b  ($0000,A4),D0
02:0004C4F6 0C000002        	  5664:     cmpi.b  #$02,D0
02:0004C4FA 666A            	  5665:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5666:     ; The boomerang has reached the thrower.
                            	  5667:     ;
                            	  5668:     ; Reset the distance to move.
                            	  5669:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5670:     ;
02:0004C4FC 7000            	  5671:     moveq   #0,D0
02:0004C4FE 41EC0380        	  5672:     lea     ($0380,A4),A0
02:0004C502 11802000        	  5673:     move.b  D0,(A0,D2.W)
02:0004C506 0C02000D        	  5674:     cmpi.b  #$0D,D2
02:0004C50A 6524            	  5675:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5676:     ; Link has caught the boomerang.
                            	  5677:     ;
                            	  5678:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5679:     ;
                            	  5680:     ; If Link catches it some time after throwing it,
                            	  5681:     ; his state will become $20, and he will show the catch animation.
                            	  5682:     ;
                            	  5683:     ; But if he catches it right after throwing it, the state becomes
                            	  5684:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5685:     ;
02:0004C50C 102C00AC        	  5686:     move.b  ($00AC,A4),D0
02:0004C510 00000020        	  5687:     ori.b #$20,D0
02:0004C514 194000AC        	  5688:     move.b  D0,($00AC,A4)
                            	  5689:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5690:     ; up the new state.
                            	  5691:     ;
02:0004C518 7001            	  5692:     moveq   #1,D0
02:0004C51A 194003D0        	  5693:     move.b  D0,($03D0,A4)
                            	  5694:     ; Deactivate the boomerang.
                            	  5695:     ;
02:0004C51E 760F            	  5696:     moveq   #15,D3
02:0004C520 7000            	  5697:     moveq   #0,D0
02:0004C522 41EC00AC        	  5698:     lea     ($00AC,A4),A0
02:0004C526 11803000        	  5699:     move.b  D0,(A0,D3.W)
02:0004C52A 0A3C0001        	  5700:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C52E 4E75            	  5701:     rts
                            	  5702: 
                            	  5703:     even
