                            	  5532: HandleArrowOrBoomerangBlocked:
                            	  5533:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5534:     ;
02:0004C418 7003            	  5535:     moveq   #3,D0
02:0004C41A 41EC03D0        	  5536:     lea     ($03D0,A4),A0
02:0004C41E 11802000        	  5537:     move.b  D0,(A0,D2.W)
                            	  5538:     ; Add $10 to the state to make it $2x.
                            	  5539:     ;
02:0004C422 41EC00AC        	  5540:     lea     ($00AC,A4),A0
02:0004C426 10302000        	  5541:     move.b  (A0,D2.W),D0
02:0004C42A 023C00EE        	  5542:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C42E 123C0010        	  5543:     move.b  #$10,D1
02:0004C432 D101            	  5544:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C434 41EC00AC        	  5545:     lea     ($00AC,A4),A0
02:0004C438 11802000        	  5546:     move.b  D0,(A0,D2.W)
                            	  5547:     even
