                            	  2292: _TryShooting:
02:0003AA9E 19400001        	  2293:     move.b  D0,($0001,A4)
                            	  2294:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2295:     ;
02:0003AAA2 41EC034F        	  2296:     lea     ($034F,A4),A0
