02:0003B59E 10342028        	  3886:     move.b  ($28,A4,D2.W),D0
02:0003B5A2 E208            	  3887:     lsr.b  #1,D0   ; LSR A
02:0003B5A4 6512            	  3888:     bcs  _anon_z04_53
                            	  3889:     ; Finish initializing based on type.
