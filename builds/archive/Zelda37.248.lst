02:0003219C 1941000D        	  6552:     move.b  D1,($000D,A4)
02:000321A0 122C000E        	  6553:     move.b  ($000E,A4),D1
02:000321A4 E211            	  6554:     roxr.b  #1,D1   ; ROR $0E
02:000321A6 1941000E        	  6555:     move.b  D1,($000E,A4)
02:000321AA 5303            	  6556:     subq.b  #1,D3
02:000321AC 66E8            	  6557:     bne  _anon_z01_86
