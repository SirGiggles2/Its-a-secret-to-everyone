02:00036A4A 7400            	  5039:     moveq   #0,D2
02:00036A4C 142C0016        	  5040:     move.b  ($0016,A4),D2
02:00036A50 41EC062D        	  5041:     lea     ($062D,A4),A0
02:00036A54 10302000        	  5042:     move.b  (A0,D2.W),D0
02:00036A58 6702            	  5043:     beq  _anon_z02_40
02:00036A5A 5203            	  5044:     addq.b  #1,D3
