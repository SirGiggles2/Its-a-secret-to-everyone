                            	  2710:     ; We'll be computing the location of the square.
                            	  2711:     ; Start with Link's location.
                            	  2712:     ;
02:000305C6 102C0070        	  2713:     move.b  ($0070,A4),D0
02:000305CA 1880            	  2714:     move.b  D0,($0000,A4)
02:000305CC 102C0084        	  2715:     move.b  ($0084,A4),D0
02:000305D0 19400001        	  2716:     move.b  D0,($0001,A4)
02:000305D4 102C0098        	  2717:     move.b  ($0098,A4),D0
02:000305D8 0200000C        	  2718:     andi.b #$0C,D0
02:000305DC 6726            	  2719:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2720:     ; Link is facing vertically.
                            	  2721:     ;
                            	  2722:     ; If Link touched the left side of the square with the right side
                            	  2723:     ; of his body, then add 8 to X.
                            	  2724:     ;
                            	  2725:     ; If Link touched the right side of the square with the left side
                            	  2726:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2727:     ;
02:000305DE 102C0002        	  2728:     move.b  ($0002,A4),D0
