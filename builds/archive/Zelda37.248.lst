02:0003D3B2 41EC03D0        	  7995:     lea     ($03D0,A4),A0
02:0003D3B6 11802000        	  7996:     move.b  D0,(A0,D2.W)
02:0003D3BA 7600            	  7997:     moveq   #0,D3
02:0003D3BC 41EC03E4        	  7998:     lea     ($03E4,A4),A0
02:0003D3C0 16302000        	  7999:     move.b  (A0,D2.W),D3
02:0003D3C4 5203            	  8000:     addq.b  #1,D3
02:0003D3C6 1003            	  8001:     move.b  D3,D0
02:0003D3C8 02000003        	  8002:     andi.b #$03,D0
02:0003D3CC 41EC03E4        	  8003:     lea     ($03E4,A4),A0
02:0003D3D0 11802000        	  8004:     move.b  D0,(A0,D2.W)
                            	  8005:     even
                            	  8006: _L_z04_UpdateLikeLike_Draw:
                            	  8007:     ; Draw.
                            	  8008:     ;
02:0003D3D4 4EB90004CD9A    	  8009:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D3DA 41EC03E4        	  8010:     lea     ($03E4,A4),A0
02:0003D3DE 10302000        	  8011:     move.b  (A0,D2.W),D0
02:0003D3E2 4EB900031B50    	  8012:     jsr     DrawObjectMirrored
                            	  8013:     ; Check collisions. If Link was not captured, then return.
                            	  8014:     ;
02:0003D3E8 4EB900031ED0    	  8015:     jsr     CheckMonsterCollisions
02:0003D3EE 41EC042C        	  8016:     lea     ($042C,A4),A0
02:0003D3F2 10302000        	  8017:     move.b  (A0,D2.W),D0
02:0003D3F6 673C            	  8018:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8019:     ; The monster captured Link.
