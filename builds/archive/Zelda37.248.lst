                            	  2171: ;==============================================================================
                            	  2172: ; EXPORT side — carry-returning shims.
                            	  2173: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2174: ; reproduces the original function's carry normalization.
                            	  2175: ;==============================================================================
                            	  2176: 
                            	  2177: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2178: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2179:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2180:     btst    #8,D0
02:0002BF8E 670A            	  2181:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2182:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2183:     eori    #$01,CCR
02:0002BF98 4E75            	  2184:     rts
