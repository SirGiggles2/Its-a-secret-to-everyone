02:0003B762 003C0011        	  4171:     ori     #$11,CCR  ; SEC: set C+X
02:0003B766 123C001C        	  4172:     move.b  #$1C,D1
02:0003B76A 0A3C0010        	  4173:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B76E 9101            	  4174:     subx.b  D1,D0   ; SBC #$1C
02:0003B770 0A3C0010        	  4175:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B774 41EC0084        	  4176:     lea     ($0084,A4),A0
