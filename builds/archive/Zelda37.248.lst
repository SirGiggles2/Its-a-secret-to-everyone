                            	  7214: Dodongo_TryEatBomb:
                            	  7215:     ; Try to eat the bomb.
                            	  7216:     ;
                            	  7217:     ; If the bomb is not in range of the monster, then return.
                            	  7218:     ;
                            	  7219:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7220:     ;
02:0003CE2A 7601            	  7221:     moveq   #1,D3
02:0003CE2C 616E            	  7222:     jsr     Dodongo_IsBombInRange
02:0003CE2E 6666            	  7223:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7224:     ; Will loop from 1 to 0, indexed by [00].
                            	  7225:     ;
02:0003CE30 7001            	  7226:     moveq   #1,D0
02:0003CE32 1880            	  7227:     move.b  D0,($0000,A4)
                            	  7228:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7229:     ;
02:0003CE34 41EC0098        	  7230:     lea     ($0098,A4),A0
02:0003CE38 10302000        	  7231:     move.b  (A0,D2.W),D0
02:0003CE3C E208            	  7232:     lsr.b  #1,D0   ; LSR A
02:0003CE3E 7600            	  7233:     moveq   #0,D3
02:0003CE40 1600            	  7234:     move.b  D0,D3
                            	  7235:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7236:     ; position depends on the orientation of the monster.
                            	  7237:     ;
                            	  7238:     ; Start with the horizontal distance.
                            	  7239:     ;
02:0003CE42 102C0004        	  7240:     move.b  ($0004,A4),D0
                            	  7241:     even
                            	  7242: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7243:     ; Look up the limits for the given direction.
                            	  7244:     ;
                            	  7245:     ; If the distance from the bomb < negative limit,
                            	  7246:     ; or >= positive limit, then return.
                            	  7247:     ;
                            	  7248:     ; Note that these are simple signed comparisons that work,
                            	  7249:     ; because the operands are in a small range.
                            	  7250:     ;
02:0003CE46 41F90003CD80    	  7251:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CE4C 12303000        	  7252:     move.b  (A0,D3.W),D1
02:0003CE50 B001            	  7253:     cmp.b   D1,D0
02:0003CE52 6B42            	  7254:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CE54 41F90003CD86    	  7255:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CE5A 12303000        	  7256:     move.b  (A0,D3.W),D1
02:0003CE5E B001            	  7257:     cmp.b   D1,D0
02:0003CE60 6A34            	  7258:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7259:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7260:     ;
02:0003CE62 1003            	  7261:     move.b  D3,D0
02:0003CE64 023C00EE        	  7262:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE68 123C000A        	  7263:     move.b  #$0A,D1
02:0003CE6C D101            	  7264:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CE6E 7600            	  7265:     moveq   #0,D3
02:0003CE70 1600            	  7266:     move.b  D0,D3
                            	  7267:     ; Bottom of the loop.
                            	  7268:     ;
                            	  7269:     ; Load the vertical distance for the next iteration.
                            	  7270:     ; Decrement loop counter.
                            	  7271:     ;
02:0003CE72 102C0005        	  7272:     move.b  ($0005,A4),D0
02:0003CE76 5314            	  7273:     subq.b  #1,($0000,A4)
02:0003CE78 6ACC            	  7274:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7275:     ; If we get here, then the bomb was within range of the mouth.
                            	  7276:     ; Go to state 1 (bloated).
                            	  7277:     ;
02:0003CE7A 41EC00AC        	  7278:     lea     ($00AC,A4),A0
02:0003CE7E 52302000        	  7279:     addq.b  #1,(A0,D2.W)
                            	  7280:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7281:     ;
02:0003CE82 7610            	  7282:     moveq   #16,D3
02:0003CE84 7000            	  7283:     moveq   #0,D0
02:0003CE86 41EC00AC        	  7284:     lea     ($00AC,A4),A0
02:0003CE8A 11803000        	  7285:     move.b  D0,(A0,D3.W)
02:0003CE8E 41EC042C        	  7286:     lea     ($042C,A4),A0
02:0003CE92 11802000        	  7287:     move.b  D0,(A0,D2.W)
                            	  7288:     even
                            	  7289: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CE96 4E75            	  7290:     rts
