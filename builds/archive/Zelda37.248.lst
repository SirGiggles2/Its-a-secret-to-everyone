                            	  7635:     ; the second animation frame's images.
                            	  7636:     ;
02:0003D0C6 7600            	  7637:     moveq   #0,D3
02:0003D0C8 41EC03E4        	  7638:     lea     ($03E4,A4),A0
02:0003D0CC 16302000        	  7639:     move.b  (A0,D2.W),D3
02:0003D0D0 671E            	  7640:     beq  _anon_z04_95
02:0003D0D2 023C00EE        	  7641:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0D6 123C0003        	  7642:     move.b  #$03,D1
02:0003D0DA D101            	  7643:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7644:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7645:     ;
                            	  7646:     ; Down has two frame images, but up only has one. By flipping
                            	  7647:     ; horizontally, you get two frame images.
                            	  7648:     ;
