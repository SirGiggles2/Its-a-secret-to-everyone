                            	  5565: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow:
                            	  5566:     ; Start preparing to draw an arrow.
                            	  5567:     ;
                            	  5568:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5569:     ; and no horizontal flipping in [0F].
                            	  5570:     ;
02:0004C45A 7002            	  5571:     moveq   #2,D0
02:0004C45C 1940000C        	  5572:     move.b  D0,($000C,A4)
02:0004C460 7000            	  5573:     moveq   #0,D0
02:0004C462 1940000F        	  5574:     move.b  D0,($000F,A4)
                            	  5575:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5576:     ; and go draw.
                            	  5577:     ;
02:0004C466 41EC0098        	  5578:     lea     ($0098,A4),A0
02:0004C46A 10302000        	  5579:     move.b  (A0,D2.W),D0
02:0004C46E 4EB900030FFC    	  5580:     jsr     GetOppositeDir
02:0004C474 7000            	  5581:     moveq   #0,D0
02:0004C476 6000FEF0        	  5582:     jmp     SetAttrAndDrawArrow
                            	  5583: 
                            	  5584:     even
                            	  5585: CheckState30:
                            	  5586:     ; If major state <> $30, go check other states.
                            	  5587:     ;
02:0004C47A 0C000030        	  5588:     cmpi.b  #$30,D0
02:0004C47E 6656            	  5589:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5590:     ; State $3x. Slow down.
                            	  5591:     ;
                            	  5592:     ; Reset grid offset for movement.
                            	  5593:     ;
02:0004C480 7000            	  5594:     moveq   #0,D0
02:0004C482 41EC0394        	  5595:     lea     ($0394,A4),A0
02:0004C486 11802000        	  5596:     move.b  D0,(A0,D2.W)
                            	  5597:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5598:     ;
02:0004C48A 7040            	  5599:     moveq   #64,D0
02:0004C48C 41EC03BC        	  5600:     lea     ($03BC,A4),A0
02:0004C490 11802000        	  5601:     move.b  D0,(A0,D2.W)
                            	  5602:     ; If facing left and X < 2, then go change state to $40. The
                            	  5603:     ; boomerang is too close to the left edge of the screen.
                            	  5604:     ; Another move might make it wrap around.
                            	  5605:     ;
02:0004C494 41EC0098        	  5606:     lea     ($0098,A4),A0
02:0004C498 10302000        	  5607:     move.b  (A0,D2.W),D0
02:0004C49C 1940000F        	  5608:     move.b  D0,($000F,A4)
02:0004C4A0 02000002        	  5609:     andi.b #$02,D0
02:0004C4A4 670A            	  5610:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C4A6 10342070        	  5611:     move.b  ($70,A4,D2.W),D0
02:0004C4AA 0C000002        	  5612:     cmpi.b  #$02,D0
02:0004C4AE 650E            	  5613:     bcs  _L_z07_CheckState30_SetState40
                            	  5614:     even
