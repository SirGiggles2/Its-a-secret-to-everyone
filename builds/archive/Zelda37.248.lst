                            	 12755: _anon_z04_164:
02:0003F6F4 4EB90004CD9A    	 12756:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12757:     ; The frame counter will make the sprite flash.
                            	 12758:     ; The array has the horizontal and vertical flipping attributes.
