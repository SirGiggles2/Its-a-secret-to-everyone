                            	  7690: Submenu_CueTransferRowUW:
                            	  7691:     ; If menu scroll value is negative, then we transferred everything.
                            	  7692:     ; So, return.
                            	  7693:     ;
02:00044C28 102C005E        	  7694:     move.b  ($005E,A4),D0
02:00044C2C 6A02            	  7695:     bpl.s  __far_z_05_0084
02:00044C2E 6030            	  7696:     jmp  L1725A_Exit
                            	  7697: __far_z_05_0084:
                            	  7698:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7699:     ; and represents the current row of the submenu being processed.
                            	  7700:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7701:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7702:     ;
                            	  7703:     ; If the bottom bit is set, go prepare the full black row.
                            	  7704:     ;
02:00044C30 E208            	  7705:     lsr.b  #1,D0   ; LSR A
02:00044C32 7600            	  7706:     moveq   #0,D3
02:00044C34 1600            	  7707:     move.b  D0,D3
02:00044C36 6402            	  7708:     bcc.s  __far_z_05_0085
02:00044C38 6028            	  7709:     jmp  PrepFullBlackRow
                            	  7710: __far_z_05_0085:
