02:0004C442 41EC034F        	  5554:     lea     ($034F,A4),A0
02:0004C446 10302000        	  5555:     move.b  (A0,D2.W),D0
02:0004C44A 0C00005B        	  5556:     cmpi.b  #$5B,D0
02:0004C44E 670A            	  5557:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
                            	  5558:     even
