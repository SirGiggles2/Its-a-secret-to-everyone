                            	  6889: UpdateDodongoState0_Move:
                            	  6890:     ; If facing left, then push X offset 0 on the stack.
                            	  6891:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6892:     ;
                            	  6893:     ; We would like to use one set of coordinates only.
                            	  6894:     ; But movement would break down, if we did; because
                            	  6895:     ; Dodongo is so long.
                            	  6896:     ;
                            	  6897:     ; So, when not facing left, we temporarily shift the
                            	  6898:     ; X coordinate to be closer to the other side of the monster.
                            	  6899:     ;
02:0003CBC8 7600            	  6900:     moveq   #0,D3
02:0003CBCA 41EC0098        	  6901:     lea     ($0098,A4),A0
02:0003CBCE 10302000        	  6902:     move.b  (A0,D2.W),D0
02:0003CBD2 0200000D        	  6903:     andi.b #$0D,D0
02:0003CBD6 6716            	  6904:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CBD8 10342070        	  6905:     move.b  ($70,A4,D2.W),D0
02:0003CBDC 023C00EE        	  6906:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBE0 123C0010        	  6907:     move.b  #$10,D1
02:0003CBE4 D101            	  6908:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CBE6 19802070        	  6909:     move.b  D0,($70,A4,D2.W)
02:0003CBEA 163C00F0        	  6910:     move.b  #$F0,D3
                            	  6911:     even
                            	  6912: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CBEE 1003            	  6913:     move.b  D3,D0
02:0003CBF0 1B00            	  6914:     move.b  D0,-(A5)  ; PHA
02:0003CBF2 7020            	  6915:     moveq   #32,D0
02:0003CBF4 41EC041F        	  6916:     lea     ($041F,A4),A0
02:0003CBF8 11802000        	  6917:     move.b  D0,(A0,D2.W)
02:0003CBFC 6100D09A        	  6918:     jsr     Wanderer_TargetPlayer
                            	  6919:     ; Pop the offset and add it to the X coordinate.
                            	  6920:     ;
                            	  6921:     ; This brings the X coordinate back to the unique value
                            	  6922:     ; that represents the position.
                            	  6923:     ;
02:0003CC00 101D            	  6924:     move.b  (A5)+,D0  ; PLA
02:0003CC02 023C00EE        	  6925:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC06 12342070        	  6926:     move.b  ($70,A4,D2.W),D1
02:0003CC0A D101            	  6927:     addx.b  D1,D0   ; ADC ObjX,X
02:0003CC0C 19802070        	  6928:     move.b  D0,($70,A4,D2.W)
                            	  6929:     ; If X coordinate < $20, then face right.
                            	  6930:     ;
02:0003CC10 0C000020        	  6931:     cmpi.b  #$20,D0
02:0003CC14 640A            	  6932:     bcc  _anon_z04_89
02:0003CC16 7001            	  6933:     moveq   #1,D0
02:0003CC18 41EC0098        	  6934:     lea     ($0098,A4),A0
02:0003CC1C 11802000        	  6935:     move.b  D0,(A0,D2.W)
