                            	  3923: __far_z_04_0033:
                            	  3924:     ; Animate.
                            	  3925:     ;
                            	  3926:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3927:     ; then only go draw.
                            	  3928:     ;
02:0003B5E6 41EC03D0        	  3929:     lea     ($03D0,A4),A0
02:0003B5EA 53302000        	  3930:     subq.b  #1,(A0,D2.W)
02:0003B5EE 6702            	  3931:     beq.s  __far_z_04_0034
02:0003B5F0 601E            	  3932:     jmp  DrawArmosAndCheckCollisions
                            	  3933: __far_z_04_0034:
                            	  3934:     ; Armos animation frames last 6 screen frames.
                            	  3935:     ;
02:0003B5F2 7006            	  3936:     moveq   #6,D0
02:0003B5F4 41EC03D0        	  3937:     lea     ($03D0,A4),A0
02:0003B5F8 11802000        	  3938:     move.b  D0,(A0,D2.W)
                            	  3939:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3940:     ; change the position of the shield. To keep fixed it in place,
                            	  3941:     ; there are separate frame images for each animation frame.
                            	  3942:     ;
                            	  3943:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3944:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3945:     ;
                            	  3946:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3947:     ; Then choose the direction at the point of drawing below.
                            	  3948:     ;
02:0003B5FC 41EC03E4        	  3949:     lea     ($03E4,A4),A0
02:0003B600 10302000        	  3950:     move.b  (A0,D2.W),D0
02:0003B604 0A000002        	  3951:     eori.b #$02,D0
02:0003B608 41EC03E4        	  3952:     lea     ($03E4,A4),A0
02:0003B60C 11802000        	  3953:     move.b  D0,(A0,D2.W)
                            	  3954:     even
                            	  3955: DrawArmosAndCheckCollisions:
02:0003B610 4EB90004CD9A    	  3956:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B616 7600            	  3957:     moveq   #0,D3
02:0003B618 41EC0098        	  3958:     lea     ($0098,A4),A0
02:0003B61C 16302000        	  3959:     move.b  (A0,D2.W),D3
                            	  3960:     ; If facing up, then use the second frame image in the set ("back").
                            	  3961:     ; Else use the second.
                            	  3962:     ;
02:0003B620 0C030008        	  3963:     cmpi.b  #$08,D3
02:0003B624 6602            	  3964:     bne  _anon_z04_54
02:0003B626 7001            	  3965:     moveq   #1,D0
                            	  3966: _anon_z04_54:
02:0003B628 023C00EE        	  3967:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B62C 41EC03E4        	  3968:     lea     ($03E4,A4),A0
02:0003B630 12302000        	  3969:     move.b  (A0,D2.W),D1
02:0003B634 D101            	  3970:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B636 4EB900031B54    	  3971:     jsr     DrawObjectNotMirrored
                            	  3972:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3973:     ; but not with weapons.
                            	  3974:     ;
02:0003B63C 10342028        	  3975:     move.b  ($28,A4,D2.W),D0
02:0003B640 661C            	  3976:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3977:     ; Else check for all collisions.
                            	  3978:     ;
02:0003B642 4EB900031ED0    	  3979:     jsr     CheckMonsterCollisions
                            	  3980:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3981:     ;
02:0003B648 41EC0405        	  3982:     lea     ($0405,A4),A0
02:0003B64C 10302000        	  3983:     move.b  (A0,D2.W),D0
02:0003B650 670A            	  3984:     beq  _anon_z04_55
02:0003B652 705D            	  3985:     moveq   #93,D0
02:0003B654 41EC034F        	  3986:     lea     ($034F,A4),A0
02:0003B658 11802000        	  3987:     move.b  D0,(A0,D2.W)
