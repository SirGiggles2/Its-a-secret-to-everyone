                            	  7863: UpdatePolsVoiceState1_Jumping:
                            	  7864:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7865:     ;
02:0003D282 41EC0444        	  7866:     lea     ($0444,A4),A0
02:0003D286 10302000        	  7867:     move.b  (A0,D2.W),D0
02:0003D28A 023C00EE        	  7868:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D28E 123C0038        	  7869:     move.b  #$38,D1
02:0003D292 D101            	  7870:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003D294 41EC0444        	  7871:     lea     ($0444,A4),A0
02:0003D298 11802000        	  7872:     move.b  D0,(A0,D2.W)
                            	  7873:     ; Add Carry to high speed byte (vertical).
                            	  7874:     ;
02:0003D29C 41EC0412        	  7875:     lea     ($0412,A4),A0
02:0003D2A0 10302000        	  7876:     move.b  (A0,D2.W),D0
02:0003D2A4 123C0000        	  7877:     move.b  #$00,D1
02:0003D2A8 D101            	  7878:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D2AA 41EC0412        	  7879:     lea     ($0412,A4),A0
02:0003D2AE 11802000        	  7880:     move.b  D0,(A0,D2.W)
                            	  7881:     ; Add high speed byte to Y coordinate.
                            	  7882:     ;
02:0003D2B2 023C00EE        	  7883:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D2B6 41EC0084        	  7884:     lea     ($0084,A4),A0
02:0003D2BA 12302000        	  7885:     move.b  (A0,D2.W),D1
02:0003D2BE D101            	  7886:     addx.b  D1,D0   ; ADC ObjY,X
02:0003D2C0 41EC0084        	  7887:     lea     ($0084,A4),A0
02:0003D2C4 11802000        	  7888:     move.b  D0,(A0,D2.W)
                            	  7889:     ; If the speed is still negative, then return.
                            	  7890:     ;
02:0003D2C8 41EC0412        	  7891:     lea     ($0412,A4),A0
02:0003D2CC 10302000        	  7892:     move.b  (A0,D2.W),D0
02:0003D2D0 6B0000AC        	  7893:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7894:     ; If Y coordinate still < target Y, then return.
                            	  7895:     ;
02:0003D2D4 41EC0084        	  7896:     lea     ($0084,A4),A0
02:0003D2D8 10302000        	  7897:     move.b  (A0,D2.W),D0
02:0003D2DC 41EC042C        	  7898:     lea     ($042C,A4),A0
02:0003D2E0 12302000        	  7899:     move.b  (A0,D2.W),D1
02:0003D2E4 B001            	  7900:     cmp.b   D1,D0
02:0003D2E6 65000096        	  7901:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7902:     ; Else reached the destination. Go to state 0.
                            	  7903:     ;
02:0003D2EA 7000            	  7904:     moveq   #0,D0
02:0003D2EC 41EC00AC        	  7905:     lea     ($00AC,A4),A0
02:0003D2F0 11802000        	  7906:     move.b  D0,(A0,D2.W)
                            	  7907:     ; Reset 16-bit vertical speed.
                            	  7908:     ;
02:0003D2F4 41EC0444        	  7909:     lea     ($0444,A4),A0
02:0003D2F8 11802000        	  7910:     move.b  D0,(A0,D2.W)
02:0003D2FC 41EC0412        	  7911:     lea     ($0412,A4),A0
02:0003D300 11802000        	  7912:     move.b  D0,(A0,D2.W)
                            	  7913:     ; Choose a random direction to face in.
                            	  7914:     ;
02:0003D304 10342018        	  7915:     move.b  ($18,A4,D2.W),D0
02:0003D308 02000003        	  7916:     andi.b #$03,D0
02:0003D30C 7600            	  7917:     moveq   #0,D3
02:0003D30E 1600            	  7918:     move.b  D0,D3
02:0003D310 41F90003D120    	  7919:     lea     (PolsVoiceDirections).l,A0
02:0003D316 10303000        	  7920:     move.b  (A0,D3.W),D0
02:0003D31A 41EC0098        	  7921:     lea     ($0098,A4),A0
02:0003D31E 11802000        	  7922:     move.b  D0,(A0,D2.W)
                            	  7923:     ; Randomly set distance-to-move to $30 or $70.
                            	  7924:     ;
02:0003D322 10342018        	  7925:     move.b  ($18,A4,D2.W),D0
02:0003D326 02000040        	  7926:     andi.b #$40,D0
02:0003D32A 123C0030        	  7927:     move.b  #$30,D1
02:0003D32E D101            	  7928:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D330 41EC0394        	  7929:     lea     ($0394,A4),A0
02:0003D334 11802000        	  7930:     move.b  D0,(A0,D2.W)
                            	  7931:     ; Align the monster with a square horizontally.
                            	  7932:     ;
                            	  7933:     ; If in the left half of a square, align with that square.
                            	  7934:     ; If in the right half, align with the next square.
                            	  7935:     ;
02:0003D338 10342070        	  7936:     move.b  ($70,A4,D2.W),D0
02:0003D33C 023C00EE        	  7937:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D340 123C0008        	  7938:     move.b  #$08,D1
02:0003D344 D101            	  7939:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D346 020000F0        	  7940:     andi.b #$F0,D0
02:0003D34A 19802070        	  7941:     move.b  D0,($70,A4,D2.W)
                            	  7942:     ; Align the monster with a square vertically.
                            	  7943:     ;
                            	  7944:     ; If in the top half of a square, align with that square.
                            	  7945:     ; If in the bottom half, align with the next square.
                            	  7946:     ;
02:0003D34E 41EC0084        	  7947:     lea     ($0084,A4),A0
02:0003D352 10302000        	  7948:     move.b  (A0,D2.W),D0
02:0003D356 023C00EE        	  7949:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D35A 123C0008        	  7950:     move.b  #$08,D1
02:0003D35E D101            	  7951:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D360 020000F0        	  7952:     andi.b #$F0,D0
                            	  7953:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7954:     ;
02:0003D364 003C0011        	  7955:     ori     #$11,CCR  ; SEC: set C+X
02:0003D368 123C0003        	  7956:     move.b  #$03,D1
02:0003D36C 0A3C0010        	  7957:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D370 9101            	  7958:     subx.b  D1,D0   ; SBC #$03
02:0003D372 0A3C0010        	  7959:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D376 41EC0084        	  7960:     lea     ($0084,A4),A0
02:0003D37A 11802000        	  7961:     move.b  D0,(A0,D2.W)
                            	  7962:     even
