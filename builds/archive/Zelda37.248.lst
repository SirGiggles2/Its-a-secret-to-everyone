                            	  7399: BeginShove:
02:000326AE 7600            	  7400:     moveq   #0,D3
02:000326B0 1614            	  7401:     move.b  ($0000,A4),D3
02:000326B2 0C02000D        	  7402:     cmpi.b  #$0D,D2
02:000326B6 6412            	  7403:     bcc  _anon_z01_99
02:000326B8 41EC04B2        	  7404:     lea     ($04B2,A4),A0
02:000326BC 10302000        	  7405:     move.b  (A0,D2.W),D0
02:000326C0 122C0009        	  7406:     move.b  ($0009,A4),D1
02:000326C4 C001            	  7407:     and.b  D1,D0
02:000326C6 660000C4        	  7408:     bne  _L_z01_BeginShove_Exit
                            	  7409: _anon_z01_99:
                            	  7410:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7411:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7412:     ;
                            	  7413:     ; If instead a monster is defending, then all this calculation
                            	  7414:     ; won't matter, because the shove direction will be set to the
                            	  7415:     ; weapon's direction.
                            	  7416:     ;
                            	  7417:     ; As such, calculate a direction from the monster to the defender,
                            	  7418:     ; assuming it's Link.
                            	  7419:     ;
                            	  7420:     ; Start with an assumption that the direction is vertical:
                            	  7421:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7422:     ;
02:000326CA 7008            	  7423:     moveq   #8,D0
02:000326CC 19400008        	  7424:     move.b  D0,($0008,A4)
02:000326D0 41EC0084        	  7425:     lea     ($0084,A4),A0
02:000326D4 10302000        	  7426:     move.b  (A0,D2.W),D0
02:000326D8 19400004        	  7427:     move.b  D0,($0004,A4)
02:000326DC 41EC0084        	  7428:     lea     ($0084,A4),A0
02:000326E0 10303000        	  7429:     move.b  (A0,D3.W),D0
02:000326E4 19400005        	  7430:     move.b  D0,($0005,A4)
                            	  7431:     ; If the defender is Link and his grid offset <> 0 then
                            	  7432:     ; use his usual object direction variable to determine
                            	  7433:     ; which axis to check.
                            	  7434:     ;
02:000326E8 4A03            	  7435:     cmpi.b  #$00,D3
02:000326EA 6612            	  7436:     bne  _anon_z01_100
02:000326EC 102C0394        	  7437:     move.b  ($0394,A4),D0
02:000326F0 670C            	  7438:     beq  _anon_z01_100
02:000326F2 102C0098        	  7439:     move.b  ($0098,A4),D0
02:000326F6 02000003        	  7440:     andi.b #$03,D0
02:000326FA 660C            	  7441:     bne  _L_z01_BeginShove_CheckHorizontal
02:000326FC 6720            	  7442:     beq  _L_z01_BeginShove_CheckVertical
                            	  7443: _anon_z01_100:
                            	  7444:     ; For monsters defending, or Link with grid offset = 0,
                            	  7445:     ; check direction in [0B].
                            	  7446:     ;
                            	  7447:     ; For monsters defending, this won't matter. For Link with grid
                            	  7448:     ; offset = 0, I believe the result will be arbitrary.
                            	  7449:     ;
                            	  7450:     ; TODO:
                            	  7451:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7452:     ; It doesn't seem to be if candle fire attacks him.
                            	  7453:     ;
02:000326FE 102C000B        	  7454:     move.b  ($000B,A4),D0
02:00032702 0C000004        	  7455:     cmpi.b  #$04,D0
02:00032706 6416            	  7456:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7457:     even
                            	  7458: _L_z01_BeginShove_CheckHorizontal:
                            	  7459:     ; If the direction checked is left or right,
                            	  7460:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7461:     ;
02:00032708 7002            	  7462:     moveq   #2,D0
02:0003270A 19400008        	  7463:     move.b  D0,($0008,A4)
02:0003270E 10342070        	  7464:     move.b  ($70,A4,D2.W),D0
02:00032712 19400004        	  7465:     move.b  D0,($0004,A4)
02:00032716 10343070        	  7466:     move.b  ($70,A4,D3.W),D0
02:0003271A 19400005        	  7467:     move.b  D0,($0005,A4)
                            	  7468:     even
                            	  7469: _L_z01_BeginShove_CheckVertical:
                            	  7470:     ; If the monster is down or right of the other object,
                            	  7471:     ; then use the opposite direction already in [08].
                            	  7472:     ; Else shift [08] right to turn it into the opposite
                            	  7473:     ; direction up or down.
                            	  7474:     ;
                            	  7475:     ; Again assuming Link is the defender; after this, [08] points
                            	  7476:     ; Link away from the monster.
                            	  7477:     ;
02:0003271E 102C0004        	  7478:     move.b  ($0004,A4),D0
02:00032722 122C0005        	  7479:     move.b  ($0005,A4),D1
02:00032726 B001            	  7480:     cmp.b   D1,D0
02:00032728 640A            	  7481:     bcc  _anon_z01_101
