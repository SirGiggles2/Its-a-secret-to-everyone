                            	  6957: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6958:     ; Bloated timer =>
                            	  6959:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6960:     ; 1:     go advance the substate
                            	  6961:     ; other: go decrement Bloated timer
                            	  6962:     ;
02:0003CC4E 7600            	  6963:     moveq   #0,D3
02:0003CC50 41EC045E        	  6964:     lea     ($045E,A4),A0
02:0003CC54 16302000        	  6965:     move.b  (A0,D2.W),D3
02:0003CC58 5303            	  6966:     subq.b  #1,D3
02:0003CC5A 6750            	  6967:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CC5C 6B04            	  6968:     bmi.s  __far_z_04_0058
02:0003CC5E 60000080        	  6969:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6970: __far_z_04_0058:
                            	  6971:     ; Set the bloated timer according to the substate.
                            	  6972:     ;
02:0003CC62 7600            	  6973:     moveq   #0,D3
02:0003CC64 41EC042C        	  6974:     lea     ($042C,A4),A0
02:0003CC68 16302000        	  6975:     move.b  (A0,D2.W),D3
02:0003CC6C 41F90003CBAA    	  6976:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CC72 10303000        	  6977:     move.b  (A0,D3.W),D0
02:0003CC76 41EC045E        	  6978:     lea     ($045E,A4),A0
02:0003CC7A 11802000        	  6979:     move.b  D0,(A0,D2.W)
                            	  6980:     ; If substate <> 0, go decrement bloated timer.
                            	  6981:     ;
02:0003CC7E 4A03            	  6982:     cmpi.b  #$00,D3
02:0003CC80 6702            	  6983:     beq.s  __far_z_04_0059
02:0003CC82 605C            	  6984:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6985: __far_z_04_0059:
                            	  6986:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6987:     ;
02:0003CC84 7610            	  6988:     moveq   #16,D3
