                            	  9528: Manhandla_Move:
                            	  9529:     ; Implement a way of manifesting the fractional part of the speed
                            	  9530:     ; in the movement.
                            	  9531:     ;
                            	  9532:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9533:     ; byte to add to the coordinates, then the effective speed would
                            	  9534:     ; be 1 pixel a frame instead of 1.25.
                            	  9535:     ;
                            	  9536:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9537:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9538:     ;
                            	  9539:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9540:     ;
                            	  9541:     ;   SA := SA + (SL AND $E0)
                            	  9542:     ;   [03] := SH + carry
                            	  9543:     ;
                            	  9544:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9545:     ;
02:0003DF0A 41EC041F        	  9546:     lea     ($041F,A4),A0
02:0003DF0E 10302000        	  9547:     move.b  (A0,D2.W),D0
02:0003DF12 020000E0        	  9548:     andi.b #$E0,D0
02:0003DF16 023C00EE        	  9549:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF1A 41EC0412        	  9550:     lea     ($0412,A4),A0
02:0003DF1E 12302000        	  9551:     move.b  (A0,D2.W),D1
02:0003DF22 D101            	  9552:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DF24 41EC0412        	  9553:     lea     ($0412,A4),A0
02:0003DF28 11802000        	  9554:     move.b  D0,(A0,D2.W)
                            	  9555:     ; Assign (high speed byte + carry) to [03].
                            	  9556:     ;
02:0003DF2C 41EC042C        	  9557:     lea     ($042C,A4),A0
02:0003DF30 10302000        	  9558:     move.b  (A0,D2.W),D0
02:0003DF34 123C0000        	  9559:     move.b  #$00,D1
02:0003DF38 D101            	  9560:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DF3A 19400003        	  9561:     move.b  D0,($0003,A4)
                            	  9562:     ; Change coordinates by the speed amount/offset in [03]
                            	  9563:     ; according to the direction.
                            	  9564:     ;
                            	  9565:     ; Start with a mask of $A1 in [02]:
                            	  9566:     ; - low nibble represents the right direction
                            	  9567:     ; - high nibble is used to set or clear carry as we go along
                            	  9568:     ;
02:0003DF3E 103C00A1        	  9569:     move.b  #$A1,D0
02:0003DF42 19400002        	  9570:     move.b  D0,($0002,A4)
                            	  9571:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9572:     ;
02:0003DF46 41EC0098        	  9573:     lea     ($0098,A4),A0
02:0003DF4A 10302000        	  9574:     move.b  (A0,D2.W),D0
02:0003DF4E 122C0002        	  9575:     move.b  ($0002,A4),D1
02:0003DF52 C200            	  9576:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF54 6712            	  9577:     beq  _L_z04_Manhandla_Move_Left
02:0003DF56 10342070        	  9578:     move.b  ($70,A4,D2.W),D0
02:0003DF5A 023C00EE        	  9579:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF5E 122C0003        	  9580:     move.b  ($0003,A4),D1
02:0003DF62 D101            	  9581:     addx.b  D1,D0   ; ADC $03
02:0003DF64 19802070        	  9582:     move.b  D0,($70,A4,D2.W)
                            	  9583:     even
                            	  9584: _L_z04_Manhandla_Move_Left:
                            	  9585:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9586:     ;
02:0003DF68 41EC0098        	  9587:     lea     ($0098,A4),A0
02:0003DF6C 10302000        	  9588:     move.b  (A0,D2.W),D0
02:0003DF70 122C0002        	  9589:     move.b  ($0002,A4),D1
02:0003DF74 E309            	  9590:     lsl.b  #1,D1   ; ASL $02
