                            	  5549:     ; If the weapon is a boomerang (not a monster arrow nor player arrow),
                            	  5550:     ; then go draw it and check for a collision.
                            	  5551:     ;
02:0004C43C 0C02000D        	  5552:     cmpi.b  #$0D,D2
