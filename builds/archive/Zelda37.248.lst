                            	  6600: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6601:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6602:     ;   full heart=4 partial heart=$70
                            	  6603:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6604:     ; But the method here yields $3EF, because partial heart is
                            	  6605:     ; considered full when = $FF instead of $100.
                            	  6606:     ;
02:0003220E 102C000E        	  6607:     move.b  ($000E,A4),D0
02:00032212 003C0011        	  6608:     ori     #$11,CCR  ; SEC: set C+X
02:00032216 122C0670        	  6609:     move.b  ($0670,A4),D1
02:0003221A 0A3C0010        	  6610:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003221E 9101            	  6611:     subx.b  D1,D0   ; SBC HeartPartial
02:00032220 0A3C0010        	  6612:     eori    #$10,CCR  ; restore X = 6502 C
02:00032224 1940000E        	  6613:     move.b  D0,($000E,A4)
02:00032228 102C066F        	  6614:     move.b  ($066F,A4),D0
02:0003222C 0200000F        	  6615:     andi.b #$0F,D0
02:00032230 6710            	  6616:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00032232 532C066F        	  6617:     subq.b  #1,($066F,A4)
02:00032236 103C00FF        	  6618:     move.b  #$FF,D0
02:0003223A 19400670        	  6619:     move.b  D0,($0670,A4)
02:0003223E 6600FF6E        	  6620:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6621:     even
                            	  6622: _L_z01_Link_BeHarmed_HandleDied:
                            	  6623:     ; Link died.
                            	  6624:     ;
                            	  6625:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6626:     ; Make Link face down.
                            	  6627:     ; Go to mode $11.
                            	  6628:     ;
02:00032242 102C066F        	  6629:     move.b  ($066F,A4),D0
02:00032246 020000F0        	  6630:     andi.b #$F0,D0
02:0003224A 1940066F        	  6631:     move.b  D0,($066F,A4)
02:0003224E 4EB90004B344    	  6632:     jsr     EndGameMode
02:00032254 19400670        	  6633:     move.b  D0,($0670,A4)
02:00032258 194000AC        	  6634:     move.b  D0,($00AC,A4)
02:0003225C 7011            	  6635:     moveq   #17,D0
02:0003225E 19400012        	  6636:     move.b  D0,($0012,A4)
02:00032262 7004            	  6637:     moveq   #4,D0
02:00032264 19400098        	  6638:     move.b  D0,($0098,A4)
                            	  6639: _anon_z01_87:
02:00032268 4E75            	  6640:     rts
                            	  6641: 
                            	  6642: ; Params:
                            	  6643: ; X: monster slot
                            	  6644: ; Y: weapon slot
                            	  6645: ; [02]: monster mid X
                            	  6646: ; [03]: monster mid Y
                            	  6647: ;
                            	  6648: ; Returns:
                            	  6649: ; [00]: weapon slot
                            	  6650: ;
                            	  6651: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6652: ;
                            	  6653:     even
                            	  6654: CheckMonsterBoomerangOrFoodCollision:
02:0003226A 41EC00AC        	  6655:     lea     ($00AC,A4),A0
02:0003226E 10303000        	  6656:     move.b  (A0,D3.W),D0
02:00032272 E308            	  6657:     lsl.b  #1,D0   ; ASL A
02:00032274 65F2            	  6658:     bcs  _anon_z01_87
02:00032276 1883            	  6659:     move.b  D3,($0000,A4)
                            	  6660:     ; Set boomerang damage type (2) in [09].
                            	  6661:     ;
02:00032278 7002            	  6662:     moveq   #2,D0
02:0003227A 19400009        	  6663:     move.b  D0,($0009,A4)
                            	  6664:     ; Set collision threshold $A in both axes.
                            	  6665:     ;
02:0003227E 700A            	  6666:     moveq   #10,D0
02:00032280 1940000D        	  6667:     move.b  D0,($000D,A4)
02:00032284 1940000E        	  6668:     move.b  D0,($000E,A4)
                            	  6669:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6670:     ;
02:00032288 10343070        	  6671:     move.b  ($70,A4,D3.W),D0
02:0003228C 023C00EE        	  6672:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032290 123C0004        	  6673:     move.b  #$04,D1
02:00032294 D101            	  6674:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00032296 19400004        	  6675:     move.b  D0,($0004,A4)
                            	  6676:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6677:     ;
02:0003229A 41EC0084        	  6678:     lea     ($0084,A4),A0
02:0003229E 10303000        	  6679:     move.b  (A0,D3.W),D0
02:000322A2 023C00EE        	  6680:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322A6 123C0008        	  6681:     move.b  #$08,D1
02:000322AA D101            	  6682:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6683: ; Params:
                            	  6684: ; A: weapon object mid Y
                            	  6685: ; X: monster object slot
                            	  6686: ; Y: weapon object slot
                            	  6687: ; [00]: weapon object slot
                            	  6688: ; [02]: monster object mid X
                            	  6689: ; [03]: monster object mid Y
                            	  6690: ; [04]: weapon object mid X
                            	  6691: ; [07]: damage points
                            	  6692: ; [09]: damage type
                            	  6693: ; [0D]: horizontal threshold
                            	  6694: ; [0E]: vertical threshold
                            	  6695: ;
                            	  6696: ; Returns:
                            	  6697: ; [06]: 1 if objects collide
                            	  6698: ;
                            	  6699:     even
                            	  6700: CheckMonsterWeaponCollision:
