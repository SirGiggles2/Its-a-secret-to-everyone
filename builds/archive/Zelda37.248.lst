                            	  4991: UpdateMode13WinGame_Sub3:
                            	  4992:     ; After scrolling 8 pixels, draw another tile row.
                            	  4993:     ;
02:000369E8 102C050B        	  4994:     move.b  ($050B,A4),D0
02:000369EC 0C000008        	  4995:     cmpi.b  #$08,D0
02:000369F0 6B1A            	  4996:     bmi  _anon_z02_37
02:000369F2 102C050B        	  4997:     move.b  ($050B,A4),D0
02:000369F6 123C0008        	  4998:     move.b  #$08,D1
02:000369FA 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000369FE 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:00036A00 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
02:00036A04 1940050B        	  5002:     move.b  D0,($050B,A4)
