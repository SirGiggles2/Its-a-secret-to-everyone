                            	  2753: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2754:     ; State 1. Jumping.
                            	  2755:     ;
                            	  2756:     ; Keep the object inside the bounds of the room.
                            	  2757:     ;
02:0003AD86 61004FFE        	  2758:     jsr     BoundFlyer
                            	  2759:     ; If the object was blocked at the room boundary, then
                            	  2760:     ; increase boundary reversal count, and go set up another jump.
                            	  2761:     ;
02:0003AD8A 102C000F        	  2762:     move.b  ($000F,A4),D0
02:0003AD8E 660C            	  2763:     bne  _anon_z04_37
02:0003AD90 41EC0451        	  2764:     lea     ($0451,A4),A0
02:0003AD94 52302000        	  2765:     addq.b  #1,(A0,D2.W)
02:0003AD98 6000FF74        	  2766:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2767: 
                            	  2768: _anon_z04_37:
02:0003AD9C 61000196        	  2769:     jsr     Jumper_PointBoulderDownward
                            	  2770:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2771:     ;
02:0003ADA0 7000            	  2772:     moveq   #0,D0
02:0003ADA2 41EC0451        	  2773:     lea     ($0451,A4),A0
02:0003ADA6 11802000        	  2774:     move.b  D0,(A0,D2.W)
                            	  2775:     ; Get the base offset for the kind of jumper the object is.
                            	  2776:     ;
02:0003ADAA 6100015E        	  2777:     jsr     Jumper_GetKind
02:0003ADAE 41F90003AC9A    	  2778:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003ADB4 10303000        	  2779:     move.b  (A0,D3.W),D0
                            	  2780:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2781:     ;
                            	  2782:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2783:     ; does not have $B elements like the tektites' sets.
                            	  2784:     ;
                            	  2785:     ; Boulder does not need the upward accelerations.
                            	  2786:     ; So, the elements for those are used for the starting speeds
                            	  2787:     ; at 04:88F2.
                            	  2788:     ;
02:0003ADB8 023C00EE        	  2789:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADBC 41EC0098        	  2790:     lea     ($0098,A4),A0
02:0003ADC0 12302000        	  2791:     move.b  (A0,D2.W),D1
02:0003ADC4 D101            	  2792:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003ADC6 7600            	  2793:     moveq   #0,D3
02:0003ADC8 1600            	  2794:     move.b  D0,D3
02:0003ADCA 41F90003AC78    	  2795:     lea     (JumperYAccelerations).l,A0
02:0003ADD0 10303000        	  2796:     move.b  (A0,D3.W),D0
02:0003ADD4 7602            	  2797:     moveq   #2,D3
02:0003ADD6 61000162        	  2798:     jsr     Jumper_MoveY
                            	  2799:     ; If the facing direction has a left component, then
                            	  2800:     ; subtract 1 from the object's X.
                            	  2801:     ;
                            	  2802:     ; Else add 1.
                            	  2803:     ;
