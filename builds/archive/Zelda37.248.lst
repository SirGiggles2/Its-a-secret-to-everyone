                            	  5705:     ; A monster caught the boomerang that it threw.
                            	  5706:     ;
                            	  5707:     ; Set a timer for the thrower based on a random value:
                            	  5708:     ; < $30: $30
                            	  5709:     ; < $70: $50
                            	  5710:     ; Else:  $70
                            	  5711:     ;
02:0004C530 7630            	  5712:     moveq   #48,D3
