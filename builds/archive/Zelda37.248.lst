                            	  3044: _anon_z01_28:
                            	  3045:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3046:     ;
02:0003084E 610017CA        	  3047:     jsr     CheckLinkCollision
                            	  3048:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3049:     ; and current coordinate to the trap's X.
                            	  3050:     ;
02:00030852 7600            	  3051:     moveq   #0,D3
02:00030854 16342070        	  3052:     move.b  ($70,A4,D2.W),D3
02:00030858 7078            	  3053:     moveq   #120,D0
02:0003085A 1880            	  3054:     move.b  D0,($0000,A4)
02:0003085C 41EC0098        	  3055:     lea     ($0098,A4),A0
02:00030860 10302000        	  3056:     move.b  (A0,D2.W),D0
02:00030864 0200000C        	  3057:     andi.b #$0C,D0
02:00030868 6710            	  3058:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3059:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3060:     ; and current coordinate to the trap's Y.
                            	  3061:     ;
02:0003086A 7600            	  3062:     moveq   #0,D3
02:0003086C 41EC0084        	  3063:     lea     ($0084,A4),A0
02:00030870 16302000        	  3064:     move.b  (A0,D2.W),D3
02:00030874 103C0090        	  3065:     move.b  #$90,D0
02:00030878 1880            	  3066:     move.b  D0,($0000,A4)
                            	  3067:     even
                            	  3068: _L_z01_UpdateTrap_Full_Finish:
                            	  3069:     ; If in state 2, then go finish handling it.
                            	  3070:     ;
02:0003087A 41EC00AC        	  3071:     lea     ($00AC,A4),A0
02:0003087E 10302000        	  3072:     move.b  (A0,D2.W),D0
02:00030882 02000001        	  3073:     andi.b #$01,D0
02:00030886 6744            	  3074:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3075:     ; Finish handling state 1.
                            	  3076:     ;
                            	  3077:     ; Get the distance between the current coordinate and the target.
                            	  3078:     ;
02:00030888 1003            	  3079:     move.b  D3,D0
02:0003088A 003C0011        	  3080:     ori     #$11,CCR  ; SEC: set C+X
02:0003088E 1214            	  3081:     move.b  ($0000,A4),D1
02:00030890 0A3C0010        	  3082:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030894 9101            	  3083:     subx.b  D1,D0   ; SBC $00
02:00030896 0A3C0010        	  3084:     eori    #$10,CCR  ; restore X = 6502 C
02:0003089A 61000764        	  3085:     jsr     Abs
                            	  3086:     ; If distance >= 5, go draw.
                            	  3087:     ;
02:0003089E 0C000005        	  3088:     cmpi.b  #$05,D0
02:000308A2 6426            	  3089:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  3090:     ; Else reverse direction, and advace to state 2
                            	  3091:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  3092:     ;
02:000308A4 41EC0098        	  3093:     lea     ($0098,A4),A0
02:000308A8 10302000        	  3094:     move.b  (A0,D2.W),D0
02:000308AC 6100074E        	  3095:     jsr     GetOppositeDir
02:000308B0 41EC0098        	  3096:     lea     ($0098,A4),A0
02:000308B4 11802000        	  3097:     move.b  D0,(A0,D2.W)
02:000308B8 7020            	  3098:     moveq   #32,D0
02:000308BA 41EC03BC        	  3099:     lea     ($03BC,A4),A0
02:000308BE 11802000        	  3100:     move.b  D0,(A0,D2.W)
02:000308C2 41EC00AC        	  3101:     lea     ($00AC,A4),A0
02:000308C6 52302000        	  3102:     addq.b  #1,(A0,D2.W)
                            	  3103:     even
