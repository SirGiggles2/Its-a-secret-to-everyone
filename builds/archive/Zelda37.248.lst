                            	  1615:     even
                            	  1616: InitMode4:
02:000410CC 7400            	  1617:     moveq   #0,D2
02:000410CE 142C0013        	  1618:     move.b  ($0013,A4),D2
02:000410D2 6604            	  1619:     bne.s  __far_z_05_0023
02:000410D4 60000084        	  1620:     jmp  InitMode_EnterRoom
                            	  1621: __far_z_05_0023:
02:000410D8 5302            	  1622:     subq.b  #1,D2
02:000410DA 6612            	  1623:     bne  _L_z05_InitMode4_CheckSub2
                            	  1624:     ; Submode 1.
                            	  1625:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1626:     ;
                            	  1627:     ; TODO:
                            	  1628:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1629:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1630:     ; A positive value triggers this submode 1 to transfer
                            	  1631:     ; the whole play area.
                            	  1632:     ;
                            	  1633:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1634:     ; a good state reflecting the new room. The only thing
                            	  1635:     ; needed is possibly to brighten the room by way of
                            	  1636:     ; changing the palette.
                            	  1637:     ;
                            	  1638:     ; So why does mode 7 trigger this?
                            	  1639:     ; Is there another mode that truly needs this behavior?
                            	  1640:     ;
02:000410DC 102C00E9        	  1641:     move.b  ($00E9,A4),D0
02:000410E0 6B06            	  1642:     bmi  _anon_z05_40
02:000410E2 61003492        	  1643:     jsr     CopyNextRowToTransferBuf
02:000410E6 6404            	  1644:     bcc  _L_z05_InitMode4_Exit
                            	  1645: _anon_z05_40:
02:000410E8 522C0013        	  1646:     addq.b  #1,($0013,A4)
                            	  1647:     even
                            	  1648: _L_z05_InitMode4_Exit:
02:000410EC 4E75            	  1649:     rts
                            	  1650: 
                            	  1651:     even
                            	  1652: _L_z05_InitMode4_CheckSub2:
02:000410EE 5302            	  1653:     subq.b  #1,D2
02:000410F0 6702            	  1654:     beq.s  __far_z_05_0024
02:000410F2 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
                            	  1657:     ; Submode 2.
                            	  1658:     ;
02:000410F4 7600            	  1659:     moveq   #0,D3
02:000410F6 162C00EB        	  1660:     move.b  ($00EB,A4),D3
02:000410FA 61004282        	  1661:     jsr     IsDarkRoom_Bank5
02:000410FE 6702            	  1662:     beq.s  __far_z_05_0025
02:00041100 6052            	  1663:     jmp  InitMode4_GoToSub0
                            	  1664: __far_z_05_0025:
                            	  1665:     ; This is a light room.
                            	  1666:     ; See if we have to brighten it after leaving a dark room.
                            	  1667:     ;
02:00041102 102C0098        	  1668:     move.b  ($0098,A4),D0
02:00041106 610040BE        	  1669:     jsr     CalcNextRoomByDir
                            	  1670:     ; Subtract RoomId from next room ID that was calculated
                            	  1671:     ; to get room ID offset in that direction.
02:0004110A 003C0011        	  1672:     ori     #$11,CCR  ; SEC: set C+X
02:0004110E 122C00EB        	  1673:     move.b  ($00EB,A4),D1
02:00041112 0A3C0010        	  1674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041116 9101            	  1675:     subx.b  D1,D0   ; SBC RoomId
02:00041118 0A3C0010        	  1676:     eori    #$10,CCR  ; restore X = 6502 C
02:0004111C 4EB900031004    	  1677:     jsr     Negate
02:00041122 023C00EE        	  1678:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041126 122C00EB        	  1679:     move.b  ($00EB,A4),D1
02:0004112A D101            	  1680:     addx.b  D1,D0   ; ADC RoomId
02:0004112C 7600            	  1681:     moveq   #0,D3
02:0004112E 1600            	  1682:     move.b  D0,D3
02:00041130 6100424C        	  1683:     jsr     IsDarkRoom_Bank5
02:00041134 6602            	  1684:     bne.s  __far_z_05_0026
02:00041136 601C            	  1685:     jmp  InitMode4_GoToSub0
                            	  1686: __far_z_05_0026:
                            	  1687:     ; The previous room was dark.
                            	  1688:     ;
02:00041138 102C051F        	  1689:     move.b  ($051F,A4),D0
02:0004113C 6702            	  1690:     beq.s  __far_z_05_0027
02:0004113E 6014            	  1691:     jmp  InitMode4_GoToSub0
                            	  1692: __far_z_05_0027:
02:00041140 103C00C0        	  1693:     move.b  #$C0,D0
                            	  1694: ; Params:
                            	  1695: ; A: start index of cycle
                            	  1696: ;
                            	  1697:     even
                            	  1698: SetFadeCycleAndAdvanceSubmode:
02:00041144 4EF90002C036    	  1699:     jmp     c_set_fade_cycle_advance_submode
                            	  1700: 
                            	  1701: _anon_z05_41:
02:0004114A 4E75            	  1702:     rts
                            	  1703: 
                            	  1704:     even
                            	  1705: InitMode4_Sub3:
                            	  1706:     ; Submode 3.
                            	  1707:     ;
02:0004114C 4EB9000317D2    	  1708:     jsr     AnimateWorldFading
02:00041152 66F6            	  1709:     bne  _anon_z05_41
                            	  1710:     even
                            	  1711: InitMode4_GoToSub0:
02:00041154 4EF90002B9E8    	  1712:     jmp     c_init_mode4_go_to_sub0
                            	  1713: 
                            	  1714: InitMode_EnterRoom:
02:0004115A 4EB90004B110    	  1715:     jsr     DrawSpritesBetweenRooms
02:00041160 4EB90004B12E    	  1716:     jsr     ResetPlayerState
                            	  1717:     ; Reset [0300] to [051F].
                            	  1718:     ;
02:00041166 7005            	  1719:     moveq   #5,D0
02:00041168 761F            	  1720:     moveq   #31,D3
02:0004116A 4EB90004A98E    	  1721:     jsr     ClearRam0300UpTo
                            	  1722:     ; Reset door trigger info.
                            	  1723:     ;
02:00041170 7000            	  1724:     moveq   #0,D0
02:00041172 19400054        	  1725:     move.b  D0,($0054,A4)
02:00041176 19400055        	  1726:     move.b  D0,($0055,A4)
                            	  1727:     ; Store level block attribute byte F for convenience.
                            	  1728:     ;
02:0004117A 7600            	  1729:     moveq   #0,D3
02:0004117C 162C00EB        	  1730:     move.b  ($00EB,A4),D3
02:00041180 41F900FF6AFE    	  1731:     lea     (NES_SRAM+$0AFE).l,A0
02:00041186 10303000        	  1732:     move.b  (A0,D3.W),D0
02:0004118A 194004CD        	  1733:     move.b  D0,($04CD,A4)
02:0004118E 610038A8        	  1734:     jsr     ResetInvObjState
                            	  1735:     ; There's more than one way to enter a room.
                            	  1736:     ;
                            	  1737:     ; 1: Out of a cave, dungeon, or cellar
                            	  1738:     ;     a. Walking exit
                            	  1739:     ;     b. Next to stairs
                            	  1740:     ; 2: Room to room
                            	  1741:     ;
                            	  1742:     ; Determine which one we need.
                            	  1743:     ;
02:00041192 102C005A        	  1744:     move.b  ($005A,A4),D0
02:00041196 6770            	  1745:     beq  _L_z05_InitMode_EnterRoom_Method2
02:00041198 102C0010        	  1746:     move.b  ($0010,A4),D0
02:0004119C 665C            	  1747:     bne  _anon_z05_42
                            	  1748:     ; Enter method 1.
                            	  1749:     ;
                            	  1750:     ; Set up Link's exit from underground.
                            	  1751:     ;
02:0004119E 7600            	  1752:     moveq   #0,D3
02:000411A0 162C00EB        	  1753:     move.b  ($00EB,A4),D3
02:000411A4 41F900FF687E    	  1754:     lea     (NES_SRAM+$087E).l,A0
02:000411AA 10303000        	  1755:     move.b  (A0,D3.W),D0
02:000411AE 020000F0        	  1756:     andi.b #$F0,D0
