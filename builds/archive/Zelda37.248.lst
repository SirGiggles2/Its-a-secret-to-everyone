02:0003C824 10302000        	  6415:     move.b  (A0,D2.W),D0
02:0003C828 122C0002        	  6416:     move.b  ($0002,A4),D1
02:0003C82C E309            	  6417:     lsl.b  #1,D1   ; ASL $02
02:0003C82E 19410002        	  6418:     move.b  D1,($0002,A4)
02:0003C832 122C0002        	  6419:     move.b  ($0002,A4),D1
02:0003C836 C200            	  6420:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
