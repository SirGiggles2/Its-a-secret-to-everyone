02:000348AE 10303000        	  1706:     move.b  (A0,D3.W),D0
02:000348B2 19400438        	  1707:     move.b  D0,($0438,A4)
02:000348B6 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:000348BA 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
