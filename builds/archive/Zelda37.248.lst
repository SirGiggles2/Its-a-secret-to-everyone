02:0003AE08 60000090        	  2822:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2823: __far_z_04_0022:
                            	  2824:     ; Going down. We have to consider the target Y.
                            	  2825:     ;
                            	  2826:     ; If the absolute vertical distance to the target position >= 3,
                            	  2827:     ; then go animate, draw, and check collisions.
                            	  2828:     ;
02:0003AE0C 41EC0084        	  2829:     lea     ($0084,A4),A0
02:0003AE10 10302000        	  2830:     move.b  (A0,D2.W),D0
02:0003AE14 003C0011        	  2831:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE18 41EC0444        	  2832:     lea     ($0444,A4),A0
02:0003AE1C 12302000        	  2833:     move.b  (A0,D2.W),D1
02:0003AE20 0A3C0010        	  2834:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE24 9101            	  2835:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AE26 0A3C0010        	  2836:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AE2A 4EB900031000    	  2837:     jsr     Abs
02:0003AE30 0C000003        	  2838:     cmpi.b  #$03,D0
02:0003AE34 6502            	  2839:     bcs.s  __far_z_04_0023
02:0003AE36 6062            	  2840:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2841: __far_z_04_0023:
                            	  2842:     ; Distance < 3. Go to state 0.
                            	  2843:     ;
                            	  2844:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2845:     ;
02:0003AE38 4EB90004C938    	  2846:     jsr     ResetObjState
02:0003AE3E 7600            	  2847:     moveq   #0,D3
02:0003AE40 41EC034F        	  2848:     lea     ($034F,A4),A0
02:0003AE44 16302000        	  2849:     move.b  (A0,D2.W),D3
02:0003AE48 0C030020        	  2850:     cmpi.b  #$20,D3
02:0003AE4C 6748            	  2851:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2852:     ; Else calculate a timer value.
                            	  2853:     ;
                            	  2854:     ; t := (Random + $10)
                            	  2855:     ; if t < $20 then
                            	  2856:     ;   t := t - $40
                            	  2857:     ;
02:0003AE4E 7010            	  2858:     moveq   #16,D0
02:0003AE50 023C00EE        	  2859:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE54 12342019        	  2860:     move.b  ($19,A4,D2.W),D1
02:0003AE58 D101            	  2861:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AE5A 0C000020        	  2862:     cmpi.b  #$20,D0
02:0003AE5E 6412            	  2863:     bcc  _anon_z04_39
02:0003AE60 003C0011        	  2864:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE64 123C0040        	  2865:     move.b  #$40,D1
02:0003AE68 0A3C0010        	  2866:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE6C 9101            	  2867:     subx.b  D1,D0   ; SBC #$40
02:0003AE6E 0A3C0010        	  2868:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2869: _anon_z04_39:
                            	  2870:     ; If the object is a blue tektite, then go use this t.
                            	  2871:     ;
02:0003AE72 7600            	  2872:     moveq   #0,D3
02:0003AE74 41EC034F        	  2873:     lea     ($034F,A4),A0
02:0003AE78 16302000        	  2874:     move.b  (A0,D2.W),D3
02:0003AE7C 0C03000D        	  2875:     cmpi.b  #$0D,D3
02:0003AE80 6714            	  2876:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2877:     ; t := t AND $7F
                            	  2878:     ;
02:0003AE82 0200007F        	  2879:     andi.b #$7F,D0
                            	  2880:     ; If Random < $A0, then go use this t.
                            	  2881:     ;
02:0003AE86 7600            	  2882:     moveq   #0,D3
02:0003AE88 16342019        	  2883:     move.b  ($19,A4,D2.W),D3
02:0003AE8C 0C0300A0        	  2884:     cmpi.b  #$A0,D3
02:0003AE90 6504            	  2885:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2886:     ; t := t AND $F
                            	  2887:     ;
02:0003AE92 0200000F        	  2888:     andi.b #$0F,D0
                            	  2889:     even
