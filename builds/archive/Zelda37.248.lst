02:0002EFA0 2A305000        	  1830:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002EFA4 29450004        	  1831:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002EFA8 41F90002EF78    	  1832:     lea     (DemoPatternBlockSizes).l,A0
02:0002EFAE 10302000        	  1833:     move.b  (A0,D2.W),D0
