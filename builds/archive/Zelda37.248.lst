                            	  7775: Submenu_CueTransferRowOW:
                            	  7776:     ;
                            	  7777:     ;
                            	  7778:     ; If menu scroll value is negative, then we transferred everything.
                            	  7779:     ; So, return.
                            	  7780:     ;
02:00044C9A 102C005E        	  7781:     move.b  ($005E,A4),D0
