02:0003ADF0 023C00EE        	  2812:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADF4 12342070        	  2813:     move.b  ($70,A4,D2.W),D1
02:0003ADF8 D101            	  2814:     addx.b  D1,D0   ; ADC ObjX,X
02:0003ADFA 19802070        	  2815:     move.b  D0,($70,A4,D2.W)
                            	  2816:     ; If going up (negative v-speed high byte), then
                            	  2817:     ; go animate, draw, and check collisions.
                            	  2818:     ;
