                            	 11565:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11566:     ;
02:0003EEA6 103C009E        	 11567:     move.b  #$9E,D0
02:0003EEAA 0C020005        	 11568:     cmpi.b  #$05,D2
02:0003EEAE 670A            	 11569:     beq  _L_z04_UpdateLamnola_Draw
02:0003EEB0 0C02000A        	 11570:     cmpi.b  #$0A,D2
02:0003EEB4 6704            	 11571:     beq  _L_z04_UpdateLamnola_Draw
02:0003EEB6 103C00A0        	 11572:     move.b  #$A0,D0
                            	 11573:     even
                            	 11574: _L_z04_UpdateLamnola_Draw:
02:0003EEBA 4EB900031E50    	 11575:     jsr     Anim_WriteSprite
02:0003EEC0 101D            	 11576:     move.b  (A5)+,D0  ; PLA
02:0003EEC2 19802070        	 11577:     move.b  D0,($70,A4,D2.W)
02:0003EEC6 41EC0098        	 11578:     lea     ($0098,A4),A0
02:0003EECA 10302000        	 11579:     move.b  (A0,D2.W),D0
02:0003EECE 1B00            	 11580:     move.b  D0,-(A5)  ; PHA
02:0003EED0 4EB900031ED0    	 11581:     jsr     CheckMonsterCollisions
02:0003EED6 101D            	 11582:     move.b  (A5)+,D0  ; PLA
02:0003EED8 41EC0098        	 11583:     lea     ($0098,A4),A0
02:0003EEDC 11802000        	 11584:     move.b  D0,(A0,D2.W)
                            	 11585:     ; If still alive, then return.
                            	 11586:     ;
02:0003EEE0 41EC0405        	 11587:     lea     ($0405,A4),A0
02:0003EEE4 10302000        	 11588:     move.b  (A0,D2.W),D0
02:0003EEE8 6604            	 11589:     bne.s  __far_z_04_0109
02:0003EEEA 6000FF72        	 11590:     jmp  L129EA_Exit
                            	 11591: __far_z_04_0109:
                            	 11592:     ; Otherwise, the segment is dead.
                            	 11593:     ;
02:0003EEEE 4EB90004B742    	 11594:     jsr     ResetShoveInfo
                            	 11595:     ; Set the current segment's HP to the initial value in anticipation
                            	 11596:     ; of bringing this segment back to life.
                            	 11597:     ;
02:0003EEF4 7020            	 11598:     moveq   #32,D0
02:0003EEF6 41EC0485        	 11599:     lea     ($0485,A4),A0
02:0003EEFA 11802000        	 11600:     move.b  D0,(A0,D2.W)
                            	 11601:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11602:     ;
                            	 11603:     ; From the lowest slot, look for one that has the original lamnola
                            	 11604:     ; object type.
                            	 11605:     ;
                            	 11606:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11607:     ;
02:0003EEFE 163C00FF        	 11608:     move.b  #$FF,D3
02:0003EF02 0C020006        	 11609:     cmpi.b  #$06,D2
02:0003EF06 6502            	 11610:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EF08 7604            	 11611:     moveq   #4,D3
                            	 11612:     even
                            	 11613: _L_z04_UpdateLamnola_FindTail:
02:0003EF0A 5203            	 11614:     addq.b  #1,D3
02:0003EF0C 41EC0350        	 11615:     lea     ($0350,A4),A0
02:0003EF10 10303000        	 11616:     move.b  (A0,D3.W),D0
02:0003EF14 122C04E7        	 11617:     move.b  ($04E7,A4),D1
02:0003EF18 B001            	 11618:     cmp.b   D1,D0
02:0003EF1A 66EE            	 11619:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11620:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11621:     ;
02:0003EF1C 7011            	 11622:     moveq   #17,D0
02:0003EF1E 19803029        	 11623:     move.b  D0,($29,A4,D3.W)
                            	 11624:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11625:     ; to the tail segment.
                            	 11626:     ;
02:0003EF22 41EC04F0        	 11627:     lea     ($04F0,A4),A0
02:0003EF26 10302000        	 11628:     move.b  (A0,D2.W),D0
02:0003EF2A 41EC04F1        	 11629:     lea     ($04F1,A4),A0
02:0003EF2E 11803000        	 11630:     move.b  D0,(A0,D3.W)
02:0003EF32 10342070        	 11631:     move.b  ($70,A4,D2.W),D0
02:0003EF36 19803071        	 11632:     move.b  D0,($71,A4,D3.W)
02:0003EF3A 41EC0084        	 11633:     lea     ($0084,A4),A0
02:0003EF3E 10302000        	 11634:     move.b  (A0,D2.W),D0
02:0003EF42 41EC0085        	 11635:     lea     ($0085,A4),A0
02:0003EF46 11803000        	 11636:     move.b  D0,(A0,D3.W)
                            	 11637:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11638:     ; So, return and leave it dead.
                            	 11639:     ;
02:0003EF4A 0C030004        	 11640:     cmpi.b  #$04,D3
02:0003EF4E 6604            	 11641:     bne.s  __far_z_04_0110
02:0003EF50 6000FF0C        	 11642:     jmp  L129EA_Exit
                            	 11643: __far_z_04_0110:
02:0003EF54 0C030009        	 11644:     cmpi.b  #$09,D3
02:0003EF58 6604            	 11645:     bne.s  __far_z_04_0111
02:0003EF5A 6000FF02        	 11646:     jmp  L129EA_Exit
                            	 11647: __far_z_04_0111:
                            	 11648:     ; Change the tail segment to the dead dummy object, and
                            	 11649:     ; bring the current segment back to life.
                            	 11650:     ;
02:0003EF5E 705D            	 11651:     moveq   #93,D0
02:0003EF60 41EC0350        	 11652:     lea     ($0350,A4),A0
02:0003EF64 11803000        	 11653:     move.b  D0,(A0,D3.W)
02:0003EF68 4EF90004D59A    	 11654:     jmp     ResetObjMetastate
                            	 11655: 
                            	 11656:     even
                            	 11657: L12A6F_Exit:
02:0003EF6E 4E75            	 11658:     rts
                            	 11659: 
                            	 11660:     even
                            	 11661: Lamnola_UpdateHead:
                            	 11662:     ; If X coordinate is not a multiple of 8, then return.
                            	 11663:     ;
02:0003EF70 10342070        	 11664:     move.b  ($70,A4,D2.W),D0
02:0003EF74 02000007        	 11665:     andi.b #$07,D0
02:0003EF78 6702            	 11666:     beq.s  __far_z_04_0112
02:0003EF7A 60F2            	 11667:     jmp  L12A6F_Exit
                            	 11668: __far_z_04_0112:
                            	 11669:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11670:     ; We had to account for the usual offset of 3.
                            	 11671:     ;
02:0003EF7C 41EC0084        	 11672:     lea     ($0084,A4),A0
02:0003EF80 10302000        	 11673:     move.b  (A0,D2.W),D0
02:0003EF84 023C00EE        	 11674:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF88 123C0003        	 11675:     move.b  #$03,D1
02:0003EF8C D101            	 11676:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EF8E 02000007        	 11677:     andi.b #$07,D0
02:0003EF92 6702            	 11678:     beq.s  __far_z_04_0113
02:0003EF94 60D8            	 11679:     jmp  L12A6F_Exit
                            	 11680: __far_z_04_0113:
                            	 11681:     ; Will loop 4 times, propagating directions down the chain,
                            	 11682:     ; by pulling from the bottom.
                            	 11683:     ;
02:0003EF96 7004            	 11684:     moveq   #4,D0
02:0003EF98 1880            	 11685:     move.b  D0,($0000,A4)
                            	 11686:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11687:     ;
02:0003EF9A 7600            	 11688:     moveq   #0,D3
02:0003EF9C 0C020005        	 11689:     cmpi.b  #$05,D2
02:0003EFA0 6702            	 11690:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EFA2 7605            	 11691:     moveq   #5,D3
                            	 11692:     even
                            	 11693: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11694:     ; Loop over every segment under the head, starting from the tail.
                            	 11695:     ; Copy the next segment's direction to the current one in this loop.
                            	 11696:     ;
02:0003EFA4 41EC009A        	 11697:     lea     ($009A,A4),A0
02:0003EFA8 10303000        	 11698:     move.b  (A0,D3.W),D0
02:0003EFAC 41EC0099        	 11699:     lea     ($0099,A4),A0
02:0003EFB0 11803000        	 11700:     move.b  D0,(A0,D3.W)
02:0003EFB4 5203            	 11701:     addq.b  #1,D3
02:0003EFB6 5314            	 11702:     subq.b  #1,($0000,A4)
02:0003EFB8 66EA            	 11703:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11704:     ; If this head segment is not aligned with a square, then return.
                            	 11705:     ;
02:0003EFBA 10342070        	 11706:     move.b  ($70,A4,D2.W),D0
02:0003EFBE 0200000F        	 11707:     andi.b #$0F,D0
02:0003EFC2 660000BA        	 11708:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11709:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11710:     ; We had to account for the usual offset of 3.
                            	 11711:     ;
02:0003EFC6 41EC0084        	 11712:     lea     ($0084,A4),A0
02:0003EFCA 10302000        	 11713:     move.b  (A0,D2.W),D0
02:0003EFCE 023C00EE        	 11714:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EFD2 123C0003        	 11715:     move.b  #$03,D1
02:0003EFD6 D101            	 11716:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EFD8 0200000F        	 11717:     andi.b #$0F,D0
02:0003EFDC 660000A0        	 11718:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11719:     ; Store the opposite of the facing direction in [00].
                            	 11720:     ;
02:0003EFE0 41EC0098        	 11721:     lea     ($0098,A4),A0
02:0003EFE4 10302000        	 11722:     move.b  (A0,D2.W),D0
02:0003EFE8 E208            	 11723:     lsr.b  #1,D0   ; LSR A
02:0003EFEA 02000005        	 11724:     andi.b #$05,D0
02:0003EFEE 1880            	 11725:     move.b  D0,($0000,A4)
02:0003EFF0 41EC0098        	 11726:     lea     ($0098,A4),A0
02:0003EFF4 10302000        	 11727:     move.b  (A0,D2.W),D0
02:0003EFF8 E308            	 11728:     lsl.b  #1,D0   ; ASL A
02:0003EFFA 0200000A        	 11729:     andi.b #$0A,D0
02:0003EFFE 1214            	 11730:     move.b  ($0000,A4),D1
02:0003F000 8001            	 11731:     or.b  D1,D0
                            	 11732:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11733:     ;
02:0003F002 0A00000F        	 11734:     eori.b #$0F,D0
02:0003F006 1940050F        	 11735:     move.b  D0,($050F,A4)
                            	 11736:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11737:     ;
02:0003F00A 10342018        	 11738:     move.b  ($18,A4,D2.W),D0
02:0003F00E 0C000080        	 11739:     cmpi.b  #$80,D0
02:0003F012 656C            	 11740:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11741:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11742:     ; Load the monster's facing direction.
                            	 11743:     ;
02:0003F014 41EC0098        	 11744:     lea     ($0098,A4),A0
02:0003F018 10302000        	 11745:     move.b  (A0,D2.W),D0
                            	 11746:     ; Load the next random number into Y register.
                            	 11747:     ;
02:0003F01C 7600            	 11748:     moveq   #0,D3
02:0003F01E 16342019        	 11749:     move.b  ($19,A4,D2.W),D3
                            	 11750:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11751:     ; to keep moving straight.
                            	 11752:     ;
02:0003F022 0C030080        	 11753:     cmpi.b  #$80,D3
02:0003F026 6418            	 11754:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11755:     even
                            	 11756: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11757:     ; Loop to rotate the direction bit over the mask.
                            	 11758:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11759:     ; facing direction.
                            	 11760:     ;
                            	 11761:     ; Shift right the copy of the direction.
                            	 11762:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11763:     ;
02:0003F028 E208            	 11764:     lsr.b  #1,D0   ; LSR A
02:0003F02A 6402            	 11765:     bcc  _anon_z04_151
02:0003F02C 7008            	 11766:     moveq   #8,D0
                            	 11767: _anon_z04_151:
                            	 11768:     ; If the current direction bit is masked off, then we've reached
                            	 11769:     ; the opposite direction. Loop again.
                            	 11770:     ;
02:0003F02E 122C050F        	 11771:     move.b  ($050F,A4),D1
02:0003F032 C200            	 11772:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F034 67F2            	 11773:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11774:     ; If Y register >= $40, then break out of the loop.
                            	 11775:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11776:     ;
02:0003F036 0C030040        	 11777:     cmpi.b  #$40,D3
02:0003F03A 6404            	 11778:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11779:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11780:     ; and loop again now.
                            	 11781:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11782:     ;
02:0003F03C 7640            	 11783:     moveq   #64,D3
02:0003F03E 65E8            	 11784:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11785:     even
                            	 11786: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11787:     ; Change the facing direction to the direction found.
                            	 11788:     ;
02:0003F040 41EC0098        	 11789:     lea     ($0098,A4),A0
02:0003F044 11802000        	 11790:     move.b  D0,(A0,D2.W)
                            	 11791:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11792:     ;
02:0003F048 1940000F        	 11793:     move.b  D0,($000F,A4)
02:0003F04C 4EB900030F02    	 11794:     jsr     BoundByRoom
                            	 11795:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11796:     ;
02:0003F052 102C000F        	 11797:     move.b  ($000F,A4),D0
02:0003F056 6618            	 11798:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11799:     even
                            	 11800: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11801:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11802:     ; for looking for any non-opposite direction that is not blocked.
                            	 11803:     ;
02:0003F058 41EC0098        	 11804:     lea     ($0098,A4),A0
02:0003F05C 10302000        	 11805:     move.b  (A0,D2.W),D0
                            	 11806:     even
                            	 11807: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11808:     ; Shift right the copy of the direction.
                            	 11809:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11810:     ;
02:0003F060 E208            	 11811:     lsr.b  #1,D0   ; LSR A
02:0003F062 6402            	 11812:     bcc  _anon_z04_152
02:0003F064 7008            	 11813:     moveq   #8,D0
                            	 11814: _anon_z04_152:
                            	 11815:     ; If the current direction bit is not masked off, then go check the
                            	 11816:     ; room boundary in this direction.
                            	 11817:     ; Else we've reached the opposite direction. Loop again.
                            	 11818:     ;
02:0003F066 122C050F        	 11819:     move.b  ($050F,A4),D1
02:0003F06A C200            	 11820:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F06C 66D2            	 11821:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003F06E 67F0            	 11822:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11823:     even
                            	 11824: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11825:     ; We found a direction that was not blocked by the room boundary.
                            	 11826:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11827:     ;
02:0003F070 4EB90004B6CE    	 11828:     jsr     GetCollidingTileMoving
02:0003F076 122C034A        	 11829:     move.b  ($034A,A4),D1
02:0003F07A B001            	 11830:     cmp.b   D1,D0
02:0003F07C 64DA            	 11831:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11832:     even
                            	 11833: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11834:     ; TODO: confirm this
                            	 11835:     ;
                            	 11836:     ; If there were a room that had lamnolas, and they could get
                            	 11837:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11838:     ; an infinite loop.
                            	 11839:     ;
                            	 11840:     ; But, the only room with that configuration has those blocks
                            	 11841:     ; blocked off with a push block, which can only be pushed after
                            	 11842:     ; all monsters are killed.
                            	 11843:     ;
02:0003F07E 4E75            	 11844:     rts
                            	 11845: 
                            	 11846:     even
                            	 11847: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11848:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11849:     ;
02:0003F080 7001            	 11850:     moveq   #1,D0
02:0003F082 19400002        	 11851:     move.b  D0,($0002,A4)
02:0003F086 102C0070        	 11852:     move.b  ($0070,A4),D0
02:0003F08A 003C0011        	 11853:     ori     #$11,CCR  ; SEC: set C+X
02:0003F08E 12342070        	 11854:     move.b  ($70,A4,D2.W),D1
02:0003F092 0A3C0010        	 11855:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F096 9101            	 11856:     subx.b  D1,D0   ; SBC ObjX,X
02:0003F098 0A3C0010        	 11857:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F09C 640A            	 11858:     bcc  _anon_z04_153
02:0003F09E 122C0002        	 11859:     move.b  ($0002,A4),D1
02:0003F0A2 E309            	 11860:     lsl.b  #1,D1   ; ASL $02
02:0003F0A4 19410002        	 11861:     move.b  D1,($0002,A4)
                            	 11862: _anon_z04_153:
                            	 11863:     ; Find the vertical direction toward Link and store it in [03].
                            	 11864:     ;
02:0003F0A8 7004            	 11865:     moveq   #4,D0
02:0003F0AA 19400003        	 11866:     move.b  D0,($0003,A4)
02:0003F0AE 102C0084        	 11867:     move.b  ($0084,A4),D0
02:0003F0B2 003C0011        	 11868:     ori     #$11,CCR  ; SEC: set C+X
02:0003F0B6 41EC0084        	 11869:     lea     ($0084,A4),A0
02:0003F0BA 12302000        	 11870:     move.b  (A0,D2.W),D1
02:0003F0BE 0A3C0010        	 11871:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0C2 9101            	 11872:     subx.b  D1,D0   ; SBC ObjY,X
02:0003F0C4 0A3C0010        	 11873:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0C8 640A            	 11874:     bcc  _anon_z04_154
02:0003F0CA 122C0003        	 11875:     move.b  ($0003,A4),D1
02:0003F0CE E309            	 11876:     lsl.b  #1,D1   ; ASL $03
02:0003F0D0 19410003        	 11877:     move.b  D1,($0003,A4)
                            	 11878: _anon_z04_154:
                            	 11879:     ; If the horizontal direction toward Link is not allowed, then
                            	 11880:     ; go check the vertical direction.
                            	 11881:     ;
02:0003F0D4 102C0002        	 11882:     move.b  ($0002,A4),D0
02:0003F0D8 122C050F        	 11883:     move.b  ($050F,A4),D1
02:0003F0DC C200            	 11884:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0DE 6708            	 11885:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11886:     ; If the horizontal direction toward Link is the same direction
                            	 11887:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11888:     ;
02:0003F0E0 122C0098        	 11889:     move.b  ($0098,A4),D1
02:0003F0E4 C200            	 11890:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0E6 6604            	 11891:     bne  _anon_z04_155
                            	 11892:     even
                            	 11893: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11894:     ; Load the vertical direction toward Link in order to test it for
                            	 11895:     ; room boundary and tile collision.
                            	 11896:     ;
02:0003F0E8 102C0003        	 11897:     move.b  ($0003,A4),D0
                            	 11898: _anon_z04_155:
                            	 11899:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11900:     ;
02:0003F0EC 6000FF52        	 11901:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11902: 
                            	 11903:     even
                            	 11904: Lamnola_Move:
                            	 11905:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11906:     ;
                            	 11907:     ; Change coordinates by the appropriate speed according to the direction.
