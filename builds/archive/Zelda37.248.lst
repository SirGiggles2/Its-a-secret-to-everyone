02:0003CEF0 19410008        	  7361:     move.b  D1,($0008,A4)
                            	  7362:     even
                            	  7363: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CEF4 5303            	  7364:     subq.b  #1,D3
02:0003CEF6 6AC8            	  7365:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7366:     ; If close enough in both axes, then [08] will be 0.
                            	  7367:     ;
02:0003CEF8 102C0008        	  7368:     move.b  ($0008,A4),D0
02:0003CEFC 4E75            	  7369:     rts
                            	  7370: 
                            	  7371: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7372: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7373: ;
                            	  7374: ; But these are not typical direction indexes. Instead a
                            	  7375: ; 5-way index is used.
                            	  7376: ; A direction shifted right once becomes a 5-way index.
                            	  7377: ; The fourth element is unused.
                            	  7378: ;
                            	  7379:     even
                            	  7380: DodongoFrameImages:
02:0003CEFE 00              	  7381:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CEFF 01
02:0003CF00 06
02:0003CF01 FF
02:0003CF02 08
02:0003CF03 02
02:0003CF04 03
02:0003CF05 06
