                            	  1683:     ;
02:0003A68E 10342070        	  1684:     move.b  ($70,A4,D2.W),D0
02:0003A692 023C00EE        	  1685:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A696 123C0008        	  1686:     move.b  #$08,D1
02:0003A69A D101            	  1687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A69C 020000F0        	  1688:     andi.b #$F0,D0
02:0003A6A0 19802070        	  1689:     move.b  D0,($70,A4,D2.W)
                            	  1690:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1691:     ;
02:0003A6A4 41EC0084        	  1692:     lea     ($0084,A4),A0
02:0003A6A8 10302000        	  1693:     move.b  (A0,D2.W),D0
02:0003A6AC 123C0008        	  1694:     move.b  #$08,D1
02:0003A6B0 D101            	  1695:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A6B2 020000F0        	  1696:     andi.b #$F0,D0
