                            	   690:     ; to $23A0, the true last row of NT 0.
02:0004058C 7023            	   691:     moveq   #35,D0
02:0004058E 19400058        	   692:     move.b  D0,($0058,A4)
02:00040592 103C00A0        	   693:     move.b  #$A0,D0
02:00040596 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
                            	   696: _L_z05_ScrollWorld_Exit:
02:0004059A 4E75            	   697:     rts
