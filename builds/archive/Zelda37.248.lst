                            	  4108:     even
                            	  4109: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4110:     ; If the current heart's state <> 0, then go move it.
                            	  4111:     ; Else we have to wait for it to come out at the right time.
                            	  4112:     ;
02:0003B6F6 41EC00AC        	  4113:     lea     ($00AC,A4),A0
02:0003B6FA 10302000        	  4114:     move.b  (A0,D2.W),D0
02:0003B6FE 667C            	  4115:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4116:     ; The current heart's state = 0.
                            	  4117:     ;
                            	  4118:     ; If object slot = 2, then go make it appear. This is the first
                            	  4119:     ; heart to show up.
                            	  4120:     ;
02:0003B700 0C020002        	  4121:     cmpi.b  #$02,D2
02:0003B704 6732            	  4122:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4123:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4124:     ; go start over.
                            	  4125:     ;
                            	  4126:     ; TODO:
                            	  4127:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4128:     ;
02:0003B706 102C00AE        	  4129:     move.b  ($00AE,A4),D0
02:0003B70A 67EA            	  4130:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4131:     ; Look up the starting angle of this heart with the index
                            	  4132:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4133:     ; then loop again.
                            	  4134:     ;
02:0003B70C 1002            	  4135:     move.b  D2,D0
02:0003B70E 003C0011        	  4136:     ori     #$11,CCR  ; SEC: set C+X
02:0003B712 123C0003        	  4137:     move.b  #$03,D1
02:0003B716 0A3C0010        	  4138:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B71A 9101            	  4139:     subx.b  D1,D0   ; SBC #$03
02:0003B71C 0A3C0010        	  4140:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B720 7600            	  4141:     moveq   #0,D3
02:0003B722 1600            	  4142:     move.b  D0,D3
02:0003B724 102C0396        	  4143:     move.b  ($0396,A4),D0
02:0003B728 41F90003B6EC    	  4144:     lea     (PondHeartStartAngles).l,A0
02:0003B72E 12303000        	  4145:     move.b  (A0,D3.W),D1
02:0003B732 B001            	  4146:     cmp.b   D1,D0
02:0003B734 66000086        	  4147:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4148:     even
