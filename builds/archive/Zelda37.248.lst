                            	  5190: _anon_z04_70:
                            	  5191:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5192:     ; 1. negate the distance
                            	  5193:     ; 2. add 8 to the instruction offset to access
                            	  5194:     ;    the opposite direction for the same wall
                            	  5195:     ;
02:0003BF04 7600            	  5196:     moveq   #0,D3
02:0003BF06 162C0098        	  5197:     move.b  ($0098,A4),D3
02:0003BF0A 122C0002        	  5198:     move.b  ($0002,A4),D1
02:0003BF0E B601            	  5199:     cmp.b   D1,D3
02:0003BF10 662A            	  5200:     bne  _anon_z04_71
02:0003BF12 1B00            	  5201:     move.b  D0,-(A5)  ; PHA
02:0003BF14 41EC0412        	  5202:     lea     ($0412,A4),A0
02:0003BF18 10302000        	  5203:     move.b  (A0,D2.W),D0
02:0003BF1C 023C00EE        	  5204:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF20 123C0008        	  5205:     move.b  #$08,D1
02:0003BF24 D101            	  5206:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BF26 41EC0412        	  5207:     lea     ($0412,A4),A0
02:0003BF2A 11802000        	  5208:     move.b  D0,(A0,D2.W)
02:0003BF2E 101D            	  5209:     move.b  (A5)+,D0  ; PLA
02:0003BF30 4600            	  5210:     eori.b #$FF,D0
02:0003BF32 023C00EE        	  5211:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF36 123C0001        	  5212:     move.b  #$01,D1
02:0003BF3A D101            	  5213:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5214: _anon_z04_71:
                            	  5215:     ; Add the distance and Link's minor coordinate to calculate
                            	  5216:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5217:     ; In general, the monster will be put in front of Link.
                            	  5218:     ;
02:0003BF3C 023C00EE        	  5219:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF40 1214            	  5220:     move.b  ($0000,A4),D1
02:0003BF42 D101            	  5221:     addx.b  D1,D0   ; ADC $00
02:0003BF44 19400004        	  5222:     move.b  D0,($0004,A4)
                            	  5223:     ; By default, will return index 0 to choose the minimum value
                            	  5224:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5225:     ; if Link is at the wall with a smaller major coordinate.
                            	  5226:     ;
02:0003BF48 7600            	  5227:     moveq   #0,D3
                            	  5228:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5229:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5230:     ; to access the block for the other direction along the same axis,
                            	  5231:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5232:     ;
02:0003BF4A 102C0001        	  5233:     move.b  ($0001,A4),D0
02:0003BF4E 122C0003        	  5234:     move.b  ($0003,A4),D1
02:0003BF52 B001            	  5235:     cmp.b   D1,D0
02:0003BF54 671C            	  5236:     beq  _anon_z04_72
02:0003BF56 41EC0412        	  5237:     lea     ($0412,A4),A0
02:0003BF5A 10302000        	  5238:     move.b  (A0,D2.W),D0
02:0003BF5E 023C00EE        	  5239:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF62 123C0010        	  5240:     move.b  #$10,D1
02:0003BF66 D101            	  5241:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BF68 41EC0412        	  5242:     lea     ($0412,A4),A0
02:0003BF6C 11802000        	  5243:     move.b  D0,(A0,D2.W)
02:0003BF70 5203            	  5244:     addq.b  #1,D3
