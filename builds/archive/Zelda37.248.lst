02:0004BF82 102C0001        	  4857:     move.b  ($0001,A4),D0
02:0004BF86 023C00EE        	  4858:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BF8A 123C0003        	  4859:     move.b  #$03,D1
02:0004BF8E D101            	  4860:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004BF90 19400001        	  4861:     move.b  D0,($0001,A4)
