                            	  7351: ; Params:
                            	  7352: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7353: ; [00]: weapon object slot (unused)
                            	  7354: ; [02]: object 1 mid X
                            	  7355: ; [03]: object 1 mid Y
                            	  7356: ; [04]: object 2 mid X
                            	  7357: ; [05]: object 2 mid Y
                            	  7358: ;
                            	  7359: ; Returns:
                            	  7360: ; A: 1 if objects collide
                            	  7361: ; Y: weapon object slot
                            	  7362: ; Z: 0 if objects collide
                            	  7363: ; [06]: 1 if objects collide
                            	  7364: ; [0A]: horizontal distance
                            	  7365: ; [0B]: vertical distance
                            	  7366: ;
                            	  7367: ;
                            	  7368: ; Use the same threshold value horizontally and vertically.
                            	  7369: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7370: ;
                            	  7371:     even
