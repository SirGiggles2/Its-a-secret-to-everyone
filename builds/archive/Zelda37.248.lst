                            	  5616:     ; Move the boomerang.
                            	  5617:     ;
02:0004C4B0 6100F570        	  5618:     jsr     MoveObject
                            	  5619:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5620:     ; state to $40.
                            	  5621:     ;
02:0004C4B4 41EC0380        	  5622:     lea     ($0380,A4),A0
02:0004C4B8 53302000        	  5623:     subq.b  #1,(A0,D2.W)
02:0004C4BC 6614            	  5624:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5625:     even
                            	  5626: _L_z07_CheckState30_SetState40:
                            	  5627:     ; Set state $40, and a time to move of $20 frames.
                            	  5628:     ;
                            	  5629:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5630:     ;
                            	  5631:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5632:     ;
02:0004C4BE 7020            	  5633:     moveq   #32,D0
02:0004C4C0 41EC0380        	  5634:     lea     ($0380,A4),A0
02:0004C4C4 11802000        	  5635:     move.b  D0,(A0,D2.W)
