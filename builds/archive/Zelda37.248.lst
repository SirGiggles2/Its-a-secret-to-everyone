02:000444D4 1B00            	  7087:     move.b  D0,-(A5)  ; PHA
                            	  7088:     ; We're dealing with squares.
                            	  7089:     ; So, align the object's X coordinate with 16 pixels.
                            	  7090:     ;
02:000444D6 10342070        	  7091:     move.b  ($70,A4,D2.W),D0
02:000444DA 020000F0        	  7092:     andi.b #$F0,D0
                            	  7093:     ; Divide it by 4 to get the offset of the address of the column
                            	  7094:     ; in play area map.
                            	  7095:     ;
                            	  7096:     ; The calculation is: address offset = (X / 8) * 2
                            	  7097:     ; 8 for the width of the column; 2 for the width of the address
                            	  7098:     ;
02:000444DE E208            	  7099:     lsr.b  #1,D0   ; LSR A
02:000444E0 E208            	  7100:     lsr.b  #1,D0   ; LSR A
02:000444E2 7400            	  7101:     moveq   #0,D2
02:000444E4 1400            	  7102:     move.b  D0,D2
                            	  7103:     ; Store the address of the column in [00:01].
                            	  7104:     ;
02:000444E6 41F90004A694    	  7105:     lea     (PlayAreaColumnAddrs).l,A0
02:000444EC 10302000        	  7106:     move.b  (A0,D2.W),D0
02:000444F0 1880            	  7107:     move.b  D0,($0000,A4)
02:000444F2 41F90004A695    	  7108:     lea     (PlayAreaColumnAddrs+1).l,A0
02:000444F8 10302000        	  7109:     move.b  (A0,D2.W),D0
02:000444FC 19400001        	  7110:     move.b  D0,($0001,A4)
02:00044500 101D            	  7111:     move.b  (A5)+,D0  ; PLA
02:00044502 1B00            	  7112:     move.b  D0,-(A5)  ; PHA
02:00044504 7400            	  7113:     moveq   #0,D2
02:00044506 1400            	  7114:     move.b  D0,D2
                            	  7115:     ; Align the object's Y coordinate with 16 pixels.
                            	  7116:     ;
02:00044508 41EC0084        	  7117:     lea     ($0084,A4),A0
02:0004450C 10302000        	  7118:     move.b  (A0,D2.W),D0
02:00044510 020000F0        	  7119:     andi.b #$F0,D0
                            	  7120:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7121:     ; the height of each row.
                            	  7122:     ;
02:00044514 003C0011        	  7123:     ori     #$11,CCR  ; SEC: set C+X
02:00044518 123C0040        	  7124:     move.b  #$40,D1
02:0004451C 0A3C0010        	  7125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044520 9101            	  7126:     subx.b  D1,D0   ; SBC #$40
02:00044522 0A3C0010        	  7127:     eori    #$10,CCR  ; restore X = 6502 C
02:00044526 E208            	  7128:     lsr.b  #1,D0   ; LSR A
02:00044528 E208            	  7129:     lsr.b  #1,D0   ; LSR A
02:0004452A E208            	  7130:     lsr.b  #1,D0   ; LSR A
                            	  7131:     ; Add this row offset to the column address.
                            	  7132:     ;
02:0004452C 4EB900031454    	  7133:     jsr     AddToInt16At0
                            	  7134:     ; Assume that we'll write a type 1 square with primary square
                            	  7135:     ; taken from [05]. If so, the square index doesn't matter
                            	  7136:     ; as long as >= $10. See WriteSquareOW.
                            	  7137:     ;
02:00044532 7600            	  7138:     moveq   #0,D3
02:00044534 7410            	  7139:     moveq   #16,D2
02:00044536 102C0005        	  7140:     move.b  ($0005,A4),D0
                            	  7141:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7142:     ; So, we have to look up the square index corresponding
                            	  7143:     ; to primary square/tile in [05].
                            	  7144:     ;
                            	  7145:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7146:     ; then the X register will have the square index value.
                            	  7147:     ;
02:0004453A 0C000027        	  7148:     cmpi.b  #$27,D0
02:0004453E 6506            	  7149:     bcs  _anon_z05_148
02:00044540 0C0000F3        	  7150:     cmpi.b  #$F3,D0
02:00044544 6514            	  7151:     bcs  _L_z05_ChangePlayMapSquareOW_Write
