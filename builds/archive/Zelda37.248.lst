                            	 12102: __far_z_04_0114:
                            	 12103:     ; State = 0.
                            	 12104:     ;
                            	 12105:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12106:     ; This is the only patra child shown in the first fame.
                            	 12107:     ;
02:0003F278 0C020002        	 12108:     cmpi.b  #$02,D2
02:0003F27C 6732            	 12109:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12110:     ; The patra child in slot 2 is the last one to be updated.
                            	 12111:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12112:     ;
                            	 12113:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12114:     ; shown.
                            	 12115:     ;
02:0003F27E 102C00AE        	 12116:     move.b  ($00AE,A4),D0
02:0003F282 6700008E        	 12117:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12118:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12119:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12120:     ;
02:0003F286 1002            	 12121:     move.b  D2,D0
                            	 12122:     ; Subtract 3 from the object slot to get the angle where the
                            	 12123:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12124:     ;
