02:000320BC 41EC034F        	  6421:     lea     ($034F,A4),A0
02:000320C0 10302000        	  6422:     move.b  (A0,D2.W),D0
02:000320C4 0C000053        	  6423:     cmpi.b  #$53,D0
02:000320C8 6402            	  6424:     bcc.s  __far_z_01_0061
02:000320CA 607C            	  6425:     jmp  HarmLink
                            	  6426: __far_z_01_0061:
                            	  6427:     ; Here, the attacker is a monster's shot/projectile.
                            	  6428:     ; Flag this kind of collision.
