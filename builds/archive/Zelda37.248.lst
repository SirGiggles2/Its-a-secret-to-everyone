02:00032190 162C0662        	  6547:     move.b  ($0662,A4),D3
02:00032194 6718            	  6548:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  6549: _anon_z01_86:
02:00032196 122C000D        	  6550:     move.b  ($000D,A4),D1
