                            	  7724:     ; Decrement grid offset / distance remaining.
                            	  7725:     ;
02:0003D162 41EC0394        	  7726:     lea     ($0394,A4),A0
02:0003D166 53302000        	  7727:     subq.b  #1,(A0,D2.W)
                            	  7728:     ; Move vertically.
