                            	  7297: DodongoBombNegativeLimits:
02:0003CE9A F4              	  7298:     dc.b    $F4, $F0
02:0003CE9B F0
                            	  7299: 
                            	  7300: ; Params:
                            	  7301: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7302: ; [00]: monster hotspot X
                            	  7303: ; [01]: monster hotspot Y
                            	  7304: ; [02]: bomb hotspot X
                            	  7305: ; [03]: bomb hotspot Y
                            	  7306: ;
                            	  7307: ; Returns:
                            	  7308: ; A: 0 if the bomb is in range of the monster
                            	  7309: ; Z: 1 if the bomb is in range of the monster
                            	  7310: ; [04]: horizontal distance
                            	  7311: ; [05]: vertical distance
                            	  7312: ;
                            	  7313: ; Store the positive limit in [06], and the negative one in [07].
                            	  7314: ;
                            	  7315:     even
                            	  7316: Dodongo_IsBombInRange:
02:0003CE9C 41F90003CE98    	  7317:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CEA2 10303000        	  7318:     move.b  (A0,D3.W),D0
02:0003CEA6 19400006        	  7319:     move.b  D0,($0006,A4)
02:0003CEAA 41F90003CE9A    	  7320:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CEB0 10303000        	  7321:     move.b  (A0,D3.W),D0
02:0003CEB4 19400007        	  7322:     move.b  D0,($0007,A4)
                            	  7323:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7324:     ; the bomb is near enough the monster.
                            	  7325:     ;
02:0003CEB8 7003            	  7326:     moveq   #3,D0
02:0003CEBA 19400008        	  7327:     move.b  D0,($0008,A4)
                            	  7328:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7329:     ;
02:0003CEBE 7601            	  7330:     moveq   #1,D3
                            	  7331:     even
                            	  7332: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7333:     ; Subtract the bomb's coordinate from the boss's,
