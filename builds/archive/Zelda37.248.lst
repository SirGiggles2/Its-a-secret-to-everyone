02:0004CD74 41EC03E4        	  6886:     lea     ($03E4,A4),A0
02:0004CD78 10302000        	  6887:     move.b  (A0,D2.W),D0
02:0004CD7C 6702            	  6888:     beq  _anon_z07_37
