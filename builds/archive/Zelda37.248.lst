                            	  4891:     ;
02:0004BFCE 7622            	  4892:     moveq   #34,D3
02:0004BFD0 0C02000D        	  4893:     cmpi.b  #$0D,D2
02:0004BFD4 6410            	  4894:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BFD6 41EC034F        	  4895:     lea     ($034F,A4),A0
02:0004BFDA 10302000        	  4896:     move.b  (A0,D2.W),D0
02:0004BFDE 0C000057        	  4897:     cmpi.b  #$57,D0
02:0004BFE2 6710            	  4898:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
