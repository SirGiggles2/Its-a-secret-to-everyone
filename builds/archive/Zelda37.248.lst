                            	  5805:     ; Chase while flying, as usual.
                            	  5806:     ;
02:0003C404 610039F2        	  5807:     jsr     Flyer_Chase
                            	  5808:     ; If timer has not expired, then
                            	  5809:     ; go see if it's time to propagate direction changes down the chain.
                            	  5810:     ;
02:0003C408 10342028        	  5811:     move.b  ($28,A4,D2.W),D0
02:0003C40C 6702            	  5812:     beq.s  __far_z_04_0041
