02:0004C59A 1600            	  5759:     move.b  D0,D3
02:0004C59C 41F90004C252    	  5760:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C5A2 10303000        	  5761:     move.b  (A0,D3.W),D0
02:0004C5A6 4EB900031128    	  5762:     jsr     SetBoomerangSpeed
02:0004C5AC 102C000B        	  5763:     move.b  ($000B,A4),D0
02:0004C5B0 1940000F        	  5764:     move.b  D0,($000F,A4)
02:0004C5B4 41EC0098        	  5765:     lea     ($0098,A4),A0
02:0004C5B8 11802000        	  5766:     move.b  D0,(A0,D2.W)
02:0004C5BC 6100F464        	  5767:     jsr     MoveObject
