02:0004C656 41F90004C23E    	  5841:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C65C 10303000        	  5842:     move.b  (A0,D3.W),D0
02:0004C660 19400004        	  5843:     move.b  D0,($0004,A4)
                            	  5844:     ; TODO: ?
                            	  5845:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5846:     ; Else add the item value of the magic boomerang.
                            	  5847:     ;
                            	  5848:     ; But none of the values in the base sprite attributes array is 8.
                            	  5849:     ;
                            	  5850:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5851:     ; the inventory will always be added to the base sprite attribute.
                            	  5852:     ;
                            	  5853:     ; So, palette row 4 or 5 will be chosen.
                            	  5854:     ;
02:0004C664 7600            	  5855:     moveq   #0,D3
02:0004C666 0C000008        	  5856:     cmpi.b  #$08,D0
02:0004C66A 6706            	  5857:     beq  _anon_z07_31
02:0004C66C 7600            	  5858:     moveq   #0,D3
02:0004C66E 162C0675        	  5859:     move.b  ($0675,A4),D3
