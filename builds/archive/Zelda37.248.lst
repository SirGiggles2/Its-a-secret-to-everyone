                            	  6752: Aquamentus_Draw:
                            	  6753:     ; Every $10 screen frames, switch animation frames.
                            	  6754:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6755:     ; The last tile of frame 0 is at index 5.
                            	  6756:     ; The last tile of frame 1 is at index $B.
                            	  6757:     ;
02:0003CAC4 7605            	  6758:     moveq   #5,D3
02:0003CAC6 102C0015        	  6759:     move.b  ($0015,A4),D0
02:0003CACA 02000010        	  6760:     andi.b #$10,D0
02:0003CACE 6602            	  6761:     bne  _anon_z04_88
02:0003CAD0 760B            	  6762:     moveq   #11,D3
                            	  6763: _anon_z04_88:
02:0003CAD2 1943000A        	  6764:     move.b  D3,($000A,A4)
                            	  6765:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6766:     ;
02:0003CAD6 7005            	  6767:     moveq   #5,D0
02:0003CAD8 1940000B        	  6768:     move.b  D0,($000B,A4)
                            	  6769:     even
                            	  6770: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003CADC 7600            	  6771:     moveq   #0,D3
02:0003CADE 162C000B        	  6772:     move.b  ($000B,A4),D3
                            	  6773:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6774:     ; Store it in [00].
                            	  6775:     ;
02:0003CAE2 10342070        	  6776:     move.b  ($70,A4,D2.W),D0
02:0003CAE6 023C00EE        	  6777:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAEA 41F90003CABE    	  6778:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003CAF0 12303000        	  6779:     move.b  (A0,D3.W),D1
02:0003CAF4 D101            	  6780:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003CAF6 1880            	  6781:     move.b  D0,($0000,A4)
                            	  6782:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6783:     ; Store it in [01].
                            	  6784:     ;
02:0003CAF8 41EC0084        	  6785:     lea     ($0084,A4),A0
02:0003CAFC 10302000        	  6786:     move.b  (A0,D2.W),D0
02:0003CB00 023C00EE        	  6787:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB04 41F90003CAB8    	  6788:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003CB0A 12303000        	  6789:     move.b  (A0,D3.W),D1
02:0003CB0E D101            	  6790:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003CB10 19400001        	  6791:     move.b  D0,($0001,A4)
                            	  6792:     ; Calculate sprite attributes:
                            	  6793:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6794:     ;
                            	  6795:     ; If the boss is temporarily invincible, then
                            	  6796:     ; this makes it flash by cycling all the palette rows.
                            	  6797:     ;
                            	  6798:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6799:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6800:     ;
02:0003CB14 41EC04F0        	  6801:     lea     ($04F0,A4),A0
02:0003CB18 10302000        	  6802:     move.b  (A0,D2.W),D0
02:0003CB1C 02000003        	  6803:     andi.b #$03,D0
02:0003CB20 0A000003        	  6804:     eori.b #$03,D0
02:0003CB24 19400003        	  6805:     move.b  D0,($0003,A4)
02:0003CB28 7600            	  6806:     moveq   #0,D3
02:0003CB2A 162C000A        	  6807:     move.b  ($000A,A4),D3
                            	  6808:     ; Look up the tile for this sprite.
                            	  6809:     ; If it's not the first one (face), then go write the sprite record.
                            	  6810:     ;
02:0003CB2E 41F90003CAAC    	  6811:     lea     (AquamentusTiles).l,A0
02:0003CB34 10303000        	  6812:     move.b  (A0,D3.W),D0
02:0003CB38 12390003CAAC    	  6813:     move.b  (AquamentusTiles).l,D1
02:0003CB3E B001            	  6814:     cmp.b   D1,D0
02:0003CB40 6610            	  6815:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6816:     ; Else it's the first one (the face tile).
                            	  6817:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6818:     ;
                            	  6819:     ; $CC/CD shows the closed mouth face.
                            	  6820:     ; $C0/C1 shows the open mouth face.
                            	  6821:     ;
02:0003CB42 7600            	  6822:     moveq   #0,D3
02:0003CB44 16342028        	  6823:     move.b  ($28,A4,D2.W),D3
02:0003CB48 0C030020        	  6824:     cmpi.b  #$20,D3
02:0003CB4C 6404            	  6825:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003CB4E 103C00C0        	  6826:     move.b  #$C0,D0
                            	  6827:     even
