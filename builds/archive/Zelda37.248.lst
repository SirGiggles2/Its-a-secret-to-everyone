02:00032146 4E75            	  6503:     rts
                            	  6504: 
                            	  6505:     even
                            	  6506: HarmLink:
02:00032148 61000564        	  6507:     jsr     BeginShove
                            	  6508:     ; Flag collision with [0C], even though [06] was already set.
                            	  6509:     ;
02:0003214C 522C000C        	  6510:     addq.b  #1,($000C,A4)
                            	  6511:     ; Unpack the damage points for the monster's type.
                            	  6512:     ; The low nibble is the high byte.
                            	  6513:     ; (Damage points byte AND $F0) is the low byte.
                            	  6514:     ;
02:00032150 7600            	  6515:     moveq   #0,D3
02:00032152 41EC034F        	  6516:     lea     ($034F,A4),A0
02:00032156 16302000        	  6517:     move.b  (A0,D2.W),D3
02:0003215A 41F900031FBC    	  6518:     lea     (ObjTypeToDamagePoints).l,A0
02:00032160 10303000        	  6519:     move.b  (A0,D3.W),D0
02:00032164 1B00            	  6520:     move.b  D0,-(A5)  ; PHA
02:00032166 0200000F        	  6521:     andi.b #$0F,D0
02:0003216A 1940000D        	  6522:     move.b  D0,($000D,A4)
02:0003216E 101D            	  6523:     move.b  (A5)+,D0  ; PLA
02:00032170 020000F0        	  6524:     andi.b #$F0,D0
02:00032174 1940000E        	  6525:     move.b  D0,($000E,A4)
                            	  6526: ; Params:
                            	  6527: ; X: object index of the attacker
                            	  6528: ; [0D]: damage points high byte
                            	  6529: ; [0E]: damage points low byte
                            	  6530: ;
                            	  6531: ;
                            	  6532: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6533: ;
                            	  6534:     even
                            	  6535: Link_BeHarmed:
02:00032178 7600            	  6536:     moveq   #0,D3
02:0003217A 41EC034F        	  6537:     lea     ($034F,A4),A0
02:0003217E 16302000        	  6538:     move.b  (A0,D2.W),D3
02:00032182 0C03002E        	  6539:     cmpi.b  #$2E,D3
02:00032186 6706            	  6540:     beq  _anon_z01_85
02:00032188 7008            	  6541:     moveq   #8,D0
02:0003218A 6100E9DC        	  6542:     jsr     PlaySample
                            	  6543: _anon_z01_85:
