                            	  5819: CalcBoomerangFrame:
                            	  5820:     ; The minor state (low 3 bits of state) is used to
                            	  5821:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5822:     ;
                            	  5823:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5824:     ; In other words, don't offset the coordinate below.
                            	  5825:     ;
02:0004C62C 7000            	  5826:     moveq   #0,D0
02:0004C62E 1880            	  5827:     move.b  D0,($0000,A4)
02:0004C630 41EC00AC        	  5828:     lea     ($00AC,A4),A0
02:0004C634 10302000        	  5829:     move.b  (A0,D2.W),D0
02:0004C638 0200000F        	  5830:     andi.b #$0F,D0
02:0004C63C 7600            	  5831:     moveq   #0,D3
02:0004C63E 1600            	  5832:     move.b  D0,D3
02:0004C640 7000            	  5833:     moveq   #0,D0
02:0004C642 19400001        	  5834:     move.b  D0,($0001,A4)
02:0004C646 41F90004C234    	  5835:     lea     (BoomerangFrameCycle).l,A0
