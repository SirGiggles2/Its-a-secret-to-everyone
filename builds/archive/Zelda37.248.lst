                            	  7415:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7416:     ; then the player walked all the way to the edge of the play
                            	  7417:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7418:     ;
                            	  7419:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7420:     ; edge of the play area. So, set a relative position that
                            	  7421:     ; reflects that distance: $28 or -$28.
                            	  7422:     ;
                            	  7423:     ; If walking in a decreasing direction (left or up), then
                            	  7424:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7425:     ;
                            	  7426:     ; If walking in an increasing direction (right or down), then
                            	  7427:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7428:     ;
02:00044A14 02000007        	  7429:     andi.b #$07,D0
02:00044A18 0C000002        	  7430:     cmpi.b  #$02,D0
