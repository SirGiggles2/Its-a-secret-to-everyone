                            	  7377: ; [02]: object 1 mid X
                            	  7378: ; [03]: object 1 mid Y
                            	  7379: ; [04]: object 2 mid X
                            	  7380: ; [05]: object 2 mid Y
                            	  7381: ; [0D]: horizontal threshold
                            	  7382: ; [0E]: vertical threshold
                            	  7383: ;
                            	  7384: ; Returns:
