                            	 12298: UpdateGanon_JumpTable:
02:0003F3EC 0003F3F8        	 12299:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F3F0 0003F45A        	 12300:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F3F4 0003F488        	 12301:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12302: 
                            	 12303: ; Description:
                            	 12304: ; Lift up the Triforce of Courage while the room is dark.
                            	 12305: ;
                            	 12306: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12307: ;
                            	 12308:     even
                            	 12309: Ganon_ScenePhase0:
02:0003F3F8 701B            	 12310:     moveq   #27,D0
02:0003F3FA 19400505        	 12311:     move.b  D0,($0505,A4)
                            	 12312:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12313:     ;
02:0003F3FE 102C0028        	 12314:     move.b  ($0028,A4),D0
02:0003F402 6644            	 12315:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12316:     ; Once the timer expires, it's time to brighten the room.
                            	 12317:     ;
                            	 12318:     ; Save the current object slot.
02:0003F404 1002            	 12319:     move.b  D2,D0
02:0003F406 1B00            	 12320:     move.b  D0,-(A5)  ; PHA
02:0003F408 610007F0        	 12321:     jsr     UpdateCandle
02:0003F40C 101D            	 12322:     move.b  (A5)+,D0  ; PLA
02:0003F40E 7400            	 12323:     moveq   #0,D2
02:0003F410 1400            	 12324:     move.b  D0,D2
                            	 12325:     ; Turn off the room brightening flag, because we're controlling it
                            	 12326:     ; here instead of in the Mode 5 object update loop.
                            	 12327:     ;
02:0003F412 7000            	 12328:     moveq   #0,D0
02:0003F414 1940051E        	 12329:     move.b  D0,($051E,A4)
                            	 12330:     ; On the first frame of the fade-to-light cycle, play the
                            	 12331:     ; Triforce/Ganon song.
                            	 12332:     ;
02:0003F418 102C051C        	 12333:     move.b  ($051C,A4),D0
02:0003F41C 0C0000C0        	 12334:     cmpi.b  #$C0,D0
02:0003F420 6606            	 12335:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F422 7002            	 12336:     moveq   #2,D0
02:0003F424 19400600        	 12337:     move.b  D0,($0600,A4)
                            	 12338:     even
                            	 12339: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12340:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12341:     ;
