02:00032654 10343070        	  7316:     move.b  ($70,A4,D3.W),D0
02:00032658 023C00EE        	  7317:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003265C 123C0006        	  7318:     move.b  #$06,D1
02:00032660 D101            	  7319:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032662 19400004        	  7320:     move.b  D0,($0004,A4)
02:00032666 41EC0084        	  7321:     lea     ($0084,A4),A0
02:0003266A 10303000        	  7322:     move.b  (A0,D3.W),D0
02:0003266E 023C00EE        	  7323:     andi    #$EE,CCR  ; CLC: clear C+X
