02:00044DC4 0C030085        	  8001:     cmpi.b  #$85,D3
02:00044DC8 6642            	  8002:     bne  _anon_z05_177
02:00044DCA 102C0098        	  8003:     move.b  ($0098,A4),D0
02:00044DCE 02000004        	  8004:     andi.b #$04,D0
02:00044DD2 6738            	  8005:     beq  _anon_z05_177
