02:0002EFB6 41F90002EF7C    	  1835:     lea     (DemoPatternVramAddrs).l,A0
02:0002EFBC 10302000        	  1836:     move.b  (A0,D2.W),D0
02:0002EFC0 4EB90000E32C    	  1837:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0002EFC6 5202            	  1838:     addq.b  #1,D2
