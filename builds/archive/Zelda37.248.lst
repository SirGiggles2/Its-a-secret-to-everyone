                            	  5477:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5478:     ; (with Link, if this is a monster's boomerang).
                            	  5479:     ;
                            	  5480:     ; TODO: Why state $28?
                            	  5481:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5482:     ; start over again when spinning.
                            	  5483:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5484:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5485:     ; any drawing code depends on the minor state.
                            	  5486:     ;
02:0004C3C6 7028            	  5487:     moveq   #40,D0
02:0004C3C8 41EC00AC        	  5488:     lea     ($00AC,A4),A0
02:0004C3CC 11802000        	  5489:     move.b  D0,(A0,D2.W)
02:0004C3D0 41EC03D0        	  5490:     lea     ($03D0,A4),A0
02:0004C3D4 53302000        	  5491:     subq.b  #1,(A0,D2.W)
02:0004C3D8 6702            	  5492:     beq.s  __far_z_07_0084
02:0004C3DA 6060            	  5493:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5494: __far_z_07_0084:
                            	  5495:     ; Animation counter = 0.
                            	  5496:     ;
                            	  5497:     ; Set state to $40. It will become $50 below in
                            	  5498:     ; HandleArrowOrBoomerangBlocked.
                            	  5499:     ;
02:0004C3DC 7040            	  5500:     moveq   #64,D0
02:0004C3DE 41EC00AC        	  5501:     lea     ($00AC,A4),A0
02:0004C3E2 11802000        	  5502:     move.b  D0,(A0,D2.W)
                            	  5503:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5504:     ; Else go handle the boomerang being blocked.
                            	  5505:     ;
02:0004C3E6 0C02000D        	  5506:     cmpi.b  #$0D,D2
02:0004C3EA 640E            	  5507:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C3EC 41EC034F        	  5508:     lea     ($034F,A4),A0
02:0004C3F0 10302000        	  5509:     move.b  (A0,D2.W),D0
02:0004C3F4 0C00005B        	  5510:     cmpi.b  #$5B,D0
02:0004C3F8 6708            	  5511:     beq  _L_z07_CheckState20_Deactivate
                            	  5512:     even
                            	  5513: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004C3FA 0C020012        	  5514:     cmpi.b  #$12,D2
02:0004C3FE 6702            	  5515:     beq.s  __far_z_07_0085
02:0004C400 6016            	  5516:     jmp  HandleArrowOrBoomerangBlocked
                            	  5517: __far_z_07_0085:
                            	  5518:     even
                            	  5519: _L_z07_CheckState20_Deactivate:
02:0004C402 61000534        	  5520:     jsr     ResetObjState
                            	  5521:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5522:     ; including clearing object type.
                            	  5523:     ;
02:0004C406 0C02000D        	  5524:     cmpi.b  #$0D,D2
02:0004C40A 6406            	  5525:     bcc  _anon_z07_29
02:0004C40C 4EB90003A226    	  5526:     jsr     DestroyCountedMonsterShot
                            	  5527: _anon_z07_29:
02:0004C412 0A3C0001        	  5528:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C416 4E75            	  5529:     rts
                            	  5530: 
