                            	  7138: Dodongo_CheckBombHit:
                            	  7139:     ; If state <> 0 (not moving), then return.
                            	  7140:     ;
02:0003CD98 41EC00AC        	  7141:     lea     ($00AC,A4),A0
02:0003CD9C 10302000        	  7142:     move.b  (A0,D2.W),D0
02:0003CDA0 66000086        	  7143:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7144:     ; If facing vertically, then store (X + 8) in [00].
                            	  7145:     ; Else store (X + $10).
                            	  7146:     ;
02:0003CDA4 10342070        	  7147:     move.b  ($70,A4,D2.W),D0
02:0003CDA8 023C00EE        	  7148:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDAC 123C0008        	  7149:     move.b  #$08,D1
02:0003CDB0 D101            	  7150:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CDB2 7600            	  7151:     moveq   #0,D3
02:0003CDB4 41EC0098        	  7152:     lea     ($0098,A4),A0
02:0003CDB8 16302000        	  7153:     move.b  (A0,D2.W),D3
