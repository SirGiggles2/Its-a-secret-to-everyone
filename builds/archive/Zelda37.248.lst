                            	  6933:     even
                            	  6934: _L_z07_AnimateLinkObjState_CheckState20:
                            	  6935:     ; If major state = $20
                            	  6936:     ;   if minor state = 0, make it 1
                            	  6937:     ;   else OR state with $30
                            	  6938:     ;   go set movement frame to 1
                            	  6939:     ;
02:0004CDC0 0C000020        	  6940:     cmpi.b  #$20,D0
02:0004CDC4 6624            	  6941:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004CDC6 102C00AC        	  6942:     move.b  ($00AC,A4),D0
02:0004CDCA 0200000F        	  6943:     andi.b #$0F,D0
02:0004CDCE 6606            	  6944:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  6945:     even
