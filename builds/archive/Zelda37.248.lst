                            	  3709: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B4A8 102C000D        	  3710:     move.b  ($000D,A4),D0
                            	  3711: ; Params:
                            	  3712: ; A: frame image
                            	  3713: ; X: object index
                            	  3714: ; [00]: object X
                            	  3715: ; [01]: object Y
                            	  3716: ; [0F]: flip horizontally
                            	  3717: ;
                            	  3718: ; Returns:
                            	  3719: ; [00]: 0 for Link slot
                            	  3720: ; [06]: 1 if objects collide
                            	  3721: ; [09]: 0 for Link damage type (none)
                            	  3722: ; [0C]: 1 if objects collide
                            	  3723: ; [034B]: ShotCollidesWithLink
                            	  3724: ;
                            	  3725:     even
