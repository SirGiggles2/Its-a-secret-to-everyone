02:000308EE 102C0084        	  3134:     move.b  ($0084,A4),D0
02:000308F2 003C0011        	  3135:     ori     #$11,CCR  ; SEC: set C+X
02:000308F6 41EC0084        	  3136:     lea     ($0084,A4),A0
02:000308FA 12302000        	  3137:     move.b  (A0,D2.W),D1
02:000308FE 0A3C0010        	  3138:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030902 9101            	  3139:     subx.b  D1,D0   ; SBC ObjY,X
02:00030904 0A3C0010        	  3140:     eori    #$10,CCR  ; restore X = 6502 C
02:00030908 610006F6        	  3141:     jsr     Abs
02:0003090C 0C000009        	  3142:     cmpi.b  #$09,D0
02:00030910 6432            	  3143:     bcc  _L_z01_UpdateRupeeStash_Full_DrawRupee
02:00030912 102C0070        	  3144:     move.b  ($0070,A4),D0
02:00030916 003C0011        	  3145:     ori     #$11,CCR  ; SEC: set C+X
02:0003091A 12342070        	  3146:     move.b  ($70,A4,D2.W),D1
02:0003091E 0A3C0010        	  3147:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030922 9101            	  3148:     subx.b  D1,D0   ; SBC ObjX,X
02:00030924 0A3C0010        	  3149:     eori    #$10,CCR  ; restore X = 6502 C
02:00030928 610006D6        	  3150:     jsr     Abs
02:0003092C 0C000009        	  3151:     cmpi.b  #$09,D0
02:00030930 6412            	  3152:     bcc  _L_z01_UpdateRupeeStash_Full_DrawRupee
                            	  3153:     ; Else Link is close enough. Add 1 rupee, and destroy this object.
