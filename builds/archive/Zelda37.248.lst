                            	   629:     xref    z05_touch_door_bombable
                            	   630: 
                            	   631: ;------------------------------------------------------------------------------
                            	   632: ; _c_move_object_shim — MoveObject trampoline.
                            	   633: ;
                            	   634: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   635: ;   Input:     D2 = slot (0..11)
                            	   636: ;   Preserves: D2, A4, A5
                            	   637: ;   Clobbers:  D0, D1, D3, A0
                            	   638: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   639: ;
                            	   640: ; GCC side:
                            	   641: ;   void c_move_object(unsigned short slot);
                            	   642: ;     slot arrives as a 16-bit value on the stack.
                            	   643: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   644: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   645: ;   never clobbered by gcc.
                            	   646: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   647: ;   semantics can exist in a pure C port).
                            	   648: ;------------------------------------------------------------------------------
                            	   649: _c_move_object_shim:
                            	   650:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   651:     move.b  #$AA,($0900,A4)
                            	   652:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   653:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   654:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   655:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   656:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   657:     moveq   #0,D0
02:0002B658 3002            	   658:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   659:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   660:     jsr     c_move_object
02:0002B662 588F            	   661:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   662:     rts
                            	   663: 
                            	   664: ;==============================================================================
                            	   665: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   666: ; and tail-call the native asm function.
                            	   667: ;
                            	   668: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   669: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   670: ; sign-extended).
                            	   671: ;==============================================================================
                            	   672: 
                            	   673: ;------------------------------------------------------------------------------
                            	   674: ; void c_copy_bank_to_window(unsigned int bank);
                            	   675: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   676: ;------------------------------------------------------------------------------
                            	   677: c_copy_bank_to_window:
02:0002B666 202F0004        	   678:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   679:     jmp     _copy_bank_to_window
                            	   680: 
                            	   681: ;------------------------------------------------------------------------------
                            	   682: ; unsigned char c_ppu_read_2(void);
                            	   683: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   684: ; C return: gcc expects result in D0.
                            	   685: ;------------------------------------------------------------------------------
