                            	  6360: Digdogger_Move:
                            	  6361:     ; This calculation is the same one used in Manhandla to
                            	  6362:     ; manifest the fractional speed over several frames.
                            	  6363:     ;
                            	  6364:     ; To summarize, the formula is:
                            	  6365:     ;
                            	  6366:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6367:     ;
                            	  6368:     ;   SA := SA + (SL AND $E0)
                            	  6369:     ;   [03] := SH + carry
                            	  6370:     ;
                            	  6371:     ; See 04:A28E Manhandla_Move.
                            	  6372:     ;
02:0003C7C2 41EC041F        	  6373:     lea     ($041F,A4),A0
02:0003C7C6 10302000        	  6374:     move.b  (A0,D2.W),D0
02:0003C7CA 020000E0        	  6375:     andi.b #$E0,D0
02:0003C7CE 023C00EE        	  6376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7D2 41EC0412        	  6377:     lea     ($0412,A4),A0
02:0003C7D6 12302000        	  6378:     move.b  (A0,D2.W),D1
02:0003C7DA D101            	  6379:     addx.b  D1,D0   ; ADC $0412,X
02:0003C7DC 41EC0412        	  6380:     lea     ($0412,A4),A0
02:0003C7E0 11802000        	  6381:     move.b  D0,(A0,D2.W)
                            	  6382:     ; Assign (high speed byte + carry) to [03].
                            	  6383:     ;
02:0003C7E4 41EC042C        	  6384:     lea     ($042C,A4),A0
02:0003C7E8 10302000        	  6385:     move.b  (A0,D2.W),D0
02:0003C7EC 123C0000        	  6386:     move.b  #$00,D1
02:0003C7F0 D101            	  6387:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C7F2 19400003        	  6388:     move.b  D0,($0003,A4)
                            	  6389:     ; Change coordinates by the speed amount/offset in [03]
                            	  6390:     ; according to the direction.
                            	  6391:     ;
                            	  6392:     ; Start with a mask of $A1 in [02]:
                            	  6393:     ; - low nibble represents the right direction
                            	  6394:     ; - high nibble is used to set or clear carry as we go along
                            	  6395:     ;
02:0003C7F6 103C00A1        	  6396:     move.b  #$A1,D0
02:0003C7FA 19400002        	  6397:     move.b  D0,($0002,A4)
                            	  6398:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6399:     ;
02:0003C7FE 41EC0098        	  6400:     lea     ($0098,A4),A0
02:0003C802 10302000        	  6401:     move.b  (A0,D2.W),D0
02:0003C806 122C0002        	  6402:     move.b  ($0002,A4),D1
02:0003C80A C200            	  6403:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C80C 6712            	  6404:     beq  _L_z04_Digdogger_Move_Left
02:0003C80E 10342070        	  6405:     move.b  ($70,A4,D2.W),D0
02:0003C812 023C00EE        	  6406:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C816 122C0003        	  6407:     move.b  ($0003,A4),D1
02:0003C81A D101            	  6408:     addx.b  D1,D0   ; ADC $03
02:0003C81C 19802070        	  6409:     move.b  D0,($70,A4,D2.W)
                            	  6410:     even
