                            	  4944: 
                            	  4945: ; Each byte describes an item. The high nibble is the type.
                            	  4946: ; The low nibble is the value. Its meaning depends on the type.
                            	  4947: ;
                            	  4948: ; 0x - individuals
                            	  4949: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4950: ; * bit mask: value doesn't matter.
                            	  4951: ;
                            	  4952: ; 1x - amounts
                            	  4953: ; Value is an amount to add.
                            	  4954: ;
                            	  4955: ; 2x - grades
                            	  4956: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4957: ;
                            	  4958: ; 3x - error?
                            	  4959: ; Produces an item value of $FF.
                            	  4960: ;
                            	  4961:     even
