                            	   247: InitCaveContinue:
                            	   248:     ; Get this cave's index (object type - $6A).
                            	   249:     ;
02:0002E478 102C0350        	   250:     move.b  ($0350,A4),D0
02:0002E47C 003C0011        	   251:     ori     #$11,CCR  ; SEC: set C+X
02:0002E480 123C006A        	   252:     move.b  #$6A,D1
02:0002E484 0A3C0010        	   253:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E488 9101            	   254:     subx.b  D1,D0   ; SBC #$6A
02:0002E48A 0A3C0010        	   255:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E48E 7600            	   256:     moveq   #0,D3
02:0002E490 1600            	   257:     move.b  D0,D3
                            	   258:     ; Get the person text selector by looking up the text selector byte
                            	   259:     ; for this index, and masking it with $3F.
                            	   260:     ;
02:0002E492 41F90002E410    	   261:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E498 10303000        	   262:     move.b  (A0,D3.W),D0
02:0002E49C 1B00            	   263:     move.b  D0,-(A5)  ; PHA
02:0002E49E 0200003F        	   264:     andi.b #$3F,D0
02:0002E4A2 19400415        	   265:     move.b  D0,($0415,A4)
                            	   266:     ; Pop and mask the text selector byte with $C0 to get the
                            	   267:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   268:     ;
02:0002E4A6 101D            	   269:     move.b  (A5)+,D0  ; PLA
02:0002E4A8 020000C0        	   270:     andi.b #$C0,D0
02:0002E4AC 19400003        	   271:     move.b  D0,($0003,A4)
                            	   272:     ; At this point, the Y register still has the cave index.
                            	   273:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   274:     ;
02:0002E4B0 103C00FD        	   275:     move.b  #$FD,D0
                            	   276: _anon_z01_0:
02:0002E4B4 023C00EE        	   277:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E4B8 123C0003        	   278:     move.b  #$03,D1
02:0002E4BC D101            	   279:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E4BE 5303            	   280:     subq.b  #1,D3
02:0002E4C0 6AF2            	   281:     bpl  _anon_z01_0
02:0002E4C2 7600            	   282:     moveq   #0,D3
02:0002E4C4 1600            	   283:     move.b  D0,D3
                            	   284:     ; Loop over the wares from 0 to 2.
                            	   285:     ;
02:0002E4C6 7400            	   286:     moveq   #0,D2
                            	   287:     even
                            	   288: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   289:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   290:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   291:     ;
02:0002E4C8 41F900FF6A7E    	   292:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E4CE 10303000        	   293:     move.b  (A0,D3.W),D0
02:0002E4D2 41EC0422        	   294:     lea     ($0422,A4),A0
02:0002E4D6 11802000        	   295:     move.b  D0,(A0,D2.W)
                            	   296:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   297:     ;
02:0002E4DA 020000C0        	   298:     andi.b #$C0,D0
02:0002E4DE 19802000        	   299:     move.b  D0,($00,A4,D2.W)
                            	   300:     ; Copy 3 prices from the Cave level block info.
                            	   301:     ;
02:0002E4E2 41F900FF6ABA    	   302:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E4E8 10303000        	   303:     move.b  (A0,D3.W),D0
02:0002E4EC 41EC0430        	   304:     lea     ($0430,A4),A0
02:0002E4F0 11802000        	   305:     move.b  D0,(A0,D2.W)
                            	   306:     ; Bottom of the wares copying loop.
                            	   307:     ;
02:0002E4F4 5203            	   308:     addq.b  #1,D3
02:0002E4F6 5202            	   309:     addq.b  #1,D2
02:0002E4F8 0C020003        	   310:     cmpi.b  #$03,D2
02:0002E4FC 66CA            	   311:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   312:     ; Get the top 2 bits of text selector byte in [03],
                            	   313:     ; shift them to the bottom, and combine them with [00].
                            	   314:     ;
02:0002E4FE 102C0003        	   315:     move.b  ($0003,A4),D0
02:0002E502 E308            	   316:     lsl.b  #1,D0   ; ASL A
02:0002E504 E310            	   317:     roxl.b  #1,D0   ; ROL A
02:0002E506 E310            	   318:     roxl.b  #1,D0   ; ROL A
02:0002E508 1214            	   319:     move.b  ($0000,A4),D1
02:0002E50A 8001            	   320:     or.b  D1,D0
02:0002E50C 1880            	   321:     move.b  D0,($0000,A4)
                            	   322:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   323:     ; and combine them with [00].
                            	   324:     ;
02:0002E50E 102C0002        	   325:     move.b  ($0002,A4),D0
02:0002E512 E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002E514 E208            	   327:     lsr.b  #1,D0   ; LSR A
02:0002E516 E208            	   328:     lsr.b  #1,D0   ; LSR A
02:0002E518 E208            	   329:     lsr.b  #1,D0   ; LSR A
02:0002E51A 1214            	   330:     move.b  ($0000,A4),D1
02:0002E51C 8001            	   331:     or.b  D1,D0
02:0002E51E 1880            	   332:     move.b  D0,($0000,A4)
                            	   333:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   334:     ; and combine them with [00] into CaveFlags.
                            	   335:     ;
02:0002E520 102C0001        	   336:     move.b  ($0001,A4),D0
02:0002E524 E208            	   337:     lsr.b  #1,D0   ; LSR A
02:0002E526 E208            	   338:     lsr.b  #1,D0   ; LSR A
02:0002E528 1214            	   339:     move.b  ($0000,A4),D1
02:0002E52A 8001            	   340:     or.b  D1,D0
02:0002E52C 19400413        	   341:     move.b  D0,($0413,A4)
                            	   342:     ; The end result is a byte with 8 cave flags.
                            	   343:     ;
                            	   344:     ; If cave flag "money game" is missing, then go finish up,
                            	   345:     ; instead of choosing random amounts for the money game.
                            	   346:     ;
02:0002E530 02000020        	   347:     andi.b #$20,D0
02:0002E534 6700009E        	   348:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   349:     ; Determine an index randomly with increasing probability,
                            	   350:     ; from 6 to 1. Start with the following test:
                            	   351:     ;
                            	   352:     ;   If $FF < Random, then go use index 6.
                            	   353:     ;
02:0002E538 103C00FF        	   354:     move.b  #$FF,D0
02:0002E53C 7606            	   355:     moveq   #6,D3
                            	   356:     even
                            	   357: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E53E 122C0019        	   358:     move.b  ($0019,A4),D1
02:0002E542 B001            	   359:     cmp.b   D1,D0
02:0002E544 6516            	   360:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   361:     ; If the test fails, then subtract $2B from the reference number.
                            	   362:     ;
02:0002E546 003C0011        	   363:     ori     #$11,CCR  ; SEC: set C+X
02:0002E54A 123C002B        	   364:     move.b  #$2B,D1
02:0002E54E 0A3C0010        	   365:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E552 9101            	   366:     subx.b  D1,D0   ; SBC #$2B
02:0002E554 0A3C0010        	   367:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E558 5303            	   368:     subq.b  #1,D3
02:0002E55A 66E2            	   369:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   370:     even
                            	   371: _L_z01_InitCaveContinue_FoundPermutation:
                            	   372:     ; The index chooses the last offset of a permutation of three indexes.
                            	   373:     ;
02:0002E55C 7400            	   374:     moveq   #0,D2
02:0002E55E 41F90002E438    	   375:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E564 14303000        	   376:     move.b  (A0,D3.W),D2
                            	   377:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   378:     ;
02:0002E568 7602            	   379:     moveq   #2,D3
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E56A 41F90002E426    	   382:     lea     (MoneyGamePermutations).l,A0
02:0002E570 10302000        	   383:     move.b  (A0,D2.W),D0
02:0002E574 41EC046C        	   384:     lea     ($046C,A4),A0
02:0002E578 11803000        	   385:     move.b  D0,(A0,D3.W)
02:0002E57C 5302            	   386:     subq.b  #1,D2
02:0002E57E 5303            	   387:     subq.b  #1,D3
02:0002E580 6AE8            	   388:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   389:     ; With the first bit of another random number, choose 10 or 40
                            	   390:     ; to put in [046F]. This is a random amount to lose.
                            	   391:     ;
02:0002E582 102C001A        	   392:     move.b  ($001A,A4),D0
02:0002E586 02000001        	   393:     andi.b #$01,D0
02:0002E58A 7600            	   394:     moveq   #0,D3
02:0002E58C 1600            	   395:     move.b  D0,D3
02:0002E58E 41F90002E424    	   396:     lea     (MoneyGameLossAmounts).l,A0
02:0002E594 10303000        	   397:     move.b  (A0,D3.W),D0
02:0002E598 1940046F        	   398:     move.b  D0,($046F,A4)
                            	   399:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   400:     ;
02:0002E59C 700A            	   401:     moveq   #10,D0
02:0002E59E 19400470        	   402:     move.b  D0,($0470,A4)
                            	   403:     ; With a different bit of the second random number,
                            	   404:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   405:     ;
02:0002E5A2 7614            	   406:     moveq   #20,D3
02:0002E5A4 102C001A        	   407:     move.b  ($001A,A4),D0
02:0002E5A8 02000002        	   408:     andi.b #$02,D0
02:0002E5AC 6702            	   409:     beq  _anon_z01_1
02:0002E5AE 7632            	   410:     moveq   #50,D3
                            	   411: _anon_z01_1:
02:0002E5B0 19430471        	   412:     move.b  D3,($0471,A4)
                            	   413:     ; The 3 amounts are now in [046F] to [0471].
