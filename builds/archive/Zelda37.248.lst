                            	  4028: 
                            	  4029:     even
                            	  4030: PondFairy_HandleOtherStates:
02:0003B69A 0C000001        	  4031:     cmpi.b  #$01,D0
02:0003B69E 6610            	  4032:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4033:     ; State 1. Flying and filling hearts.
                            	  4034:     ;
