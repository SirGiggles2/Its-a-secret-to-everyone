02:0003F56E 19802070        	 12562:     move.b  D0,($70,A4,D2.W)
02:0003F572 41EC0084        	 12563:     lea     ($0084,A4),A0
02:0003F576 10302000        	 12564:     move.b  (A0,D2.W),D0
02:0003F57A 123C0008        	 12565:     move.b  #$08,D1
02:0003F57E D101            	 12566:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F580 41EC0084        	 12567:     lea     ($0084,A4),A0
02:0003F584 11802000        	 12568:     move.b  D0,(A0,D2.W)
02:0003F588 615C            	 12569:     jsr     Ganon_SetUpBurstRays
02:0003F58A 610003DA        	 12570:     jsr     PlayBossDeathCry
