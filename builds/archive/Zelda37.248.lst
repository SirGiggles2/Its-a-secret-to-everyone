02:000403C0 123C0003        	   451:     move.b  #$03,D1
02:000403C4 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000403C6 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
