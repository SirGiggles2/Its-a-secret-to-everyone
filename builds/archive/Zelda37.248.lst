02:0003B3DC 11802000        	  3587:     move.b  D0,(A0,D2.W)
                            	  3588:     ; There are actually 6 frame images divided into 2 sets.
                            	  3589:     ; Each set depicts one animation frame. In each set there are
                            	  3590:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3591:     ;
                            	  3592:     ; The movement frame will keep track of the base offset of
                            	  3593:     ; the current set for the current animation frame: 0 or 3.
                            	  3594:     ;
                            	  3595:     ; So, XOR the movement frame with 3.
                            	  3596:     ;
