02:0003F6FA 102C0015        	 12761:     move.b  ($0015,A4),D0
02:0003F6FE 02000003        	 12762:     andi.b #$03,D0
02:0003F702 41F90003F5D2    	 12763:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F708 12302000        	 12764:     move.b  (A0,D2.W),D1
02:0003F70C 8001            	 12765:     or.b  D1,D0
02:0003F70E 19400003        	 12766:     move.b  D0,($0003,A4)
02:0003F712 41F90003F5DC    	 12767:     lea     (GanonBurstTiles).l,A0
