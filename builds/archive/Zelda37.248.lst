                            	 12817: Ganon_DrawBody:
                            	 12818:     ; Loop over four 16x16 images that make up Ganon.
                            	 12819:     ; There are 6 animation frames.
                            	 12820:     ;
02:0003F772 7603            	 12821:     moveq   #3,D3
                            	 12822:     even
                            	 12823: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12824:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12825:     ;
02:0003F774 10342070        	 12826:     move.b  ($70,A4,D2.W),D0
02:0003F778 023C00EE        	 12827:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F77C 41F90003F766    	 12828:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F782 12303000        	 12829:     move.b  (A0,D3.W),D1
02:0003F786 D101            	 12830:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F788 1880            	 12831:     move.b  D0,($0000,A4)
                            	 12832:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12833:     ;
02:0003F78A 41EC0084        	 12834:     lea     ($0084,A4),A0
02:0003F78E 10302000        	 12835:     move.b  (A0,D2.W),D0
02:0003F792 023C00EE        	 12836:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F796 41F90003F76A    	 12837:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F79C 12303000        	 12838:     move.b  (A0,D3.W),D1
02:0003F7A0 D101            	 12839:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F7A2 19400001        	 12840:     move.b  D0,($0001,A4)
                            	 12841:     ; Each part has a horizontal flipping flag.
                            	 12842:     ;
02:0003F7A6 41F90003F76E    	 12843:     lea     (GanonSpriteHFlips).l,A0
02:0003F7AC 10303000        	 12844:     move.b  (A0,D3.W),D0
02:0003F7B0 1940000F        	 12845:     move.b  D0,($000F,A4)
                            	 12846:     ; Save and copy the loop index (the current part) to [07].
                            	 12847:     ;
02:0003F7B4 1003            	 12848:     move.b  D3,D0
02:0003F7B6 1B00            	 12849:     move.b  D0,-(A5)  ; PHA
02:0003F7B8 19400007        	 12850:     move.b  D0,($0007,A4)
                            	 12851:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12852:     ; that make it up.
                            	 12853:     ;
02:0003F7BC 41EC046B        	 12854:     lea     ($046B,A4),A0
02:0003F7C0 10302000        	 12855:     move.b  (A0,D2.W),D0
02:0003F7C4 E308            	 12856:     lsl.b  #1,D0   ; ASL A
02:0003F7C6 E308            	 12857:     lsl.b  #1,D0   ; ASL A
                            	 12858:     ; Add [07] -- the index of the current part.
                            	 12859:     ;
                            	 12860:     ; Now you have an index into the frame image table, for the
                            	 12861:     ; current image part of the current animation frame.
                            	 12862:     ;
02:0003F7C8 122C0007        	 12863:     move.b  ($0007,A4),D1
02:0003F7CC D101            	 12864:     addx.b  D1,D0   ; ADC $07
02:0003F7CE 7600            	 12865:     moveq   #0,D3
02:0003F7D0 1600            	 12866:     move.b  D0,D3
02:0003F7D2 41F90003F74E    	 12867:     lea     (GanonFrameImages).l,A0
02:0003F7D8 10303000        	 12868:     move.b  (A0,D3.W),D0
02:0003F7DC 4EB900031B54    	 12869:     jsr     DrawObjectNotMirrored
02:0003F7E2 101D            	 12870:     move.b  (A5)+,D0  ; PLA
                            	 12871:     ; Bottom of the part loop.
                            	 12872:     ;
02:0003F7E4 7600            	 12873:     moveq   #0,D3
02:0003F7E6 1600            	 12874:     move.b  D0,D3
02:0003F7E8 5303            	 12875:     subq.b  #1,D3
02:0003F7EA 6A88            	 12876:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F7EC 4E75            	 12877:     rts
