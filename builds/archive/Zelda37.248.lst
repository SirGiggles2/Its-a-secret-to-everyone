                            	  7016: __far_z_04_0060:
                            	  7017:     ; New bloated substate >= 2.
                            	  7018:     ;
                            	  7019:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7020:     ; which will transition to state 0 (moving).
                            	  7021:     ;
                            	  7022:     ; Note that if the bomb hits >= 2, then:
                            	  7023:     ; - If new substate = 2, then substate 2 will wait,
                            	  7024:     ;   and then transition to substate 3.
                            	  7025:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7026:     ;
02:0003CCC4 7600            	  7027:     moveq   #0,D3
02:0003CCC6 41EC0437        	  7028:     lea     ($0437,A4),A0
02:0003CCCA 16302000        	  7029:     move.b  (A0,D2.W),D3
02:0003CCCE 0C030002        	  7030:     cmpi.b  #$02,D3
