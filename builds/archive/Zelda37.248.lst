02:0003D5B6 E208            	  8237:     lsr.b  #1,D0   ; LSR A
02:0003D5B8 E208            	  8238:     lsr.b  #1,D0   ; LSR A
02:0003D5BA 023C00EE        	  8239:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D5BE 41EC03E4        	  8240:     lea     ($03E4,A4),A0
02:0003D5C2 12302000        	  8241:     move.b  (A0,D2.W),D1
02:0003D5C6 D101            	  8242:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003D5C8 4EF900031B50    	  8243:     jmp     DrawObjectMirrored
                            	  8244: 
                            	  8245: ; Description:
                            	  8246: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8247: ; When walking, the object timer is set. When teleporting,
                            	  8248: ; the teleporting distance remaining is set.
                            	  8249: ;
                            	  8250: ; If we have the magic clock, then only go draw and check collisions.
                            	  8251: ;
                            	  8252:     even
                            	  8253: UpdateBlueWizzrobe:
02:0003D5CE 102C066C        	  8254:     move.b  ($066C,A4),D0
02:0003D5D2 6702            	  8255:     beq.s  __far_z_04_0070
02:0003D5D4 6014            	  8256:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8257: __far_z_04_0070:
02:0003D5D6 6116            	  8258:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D5D8 61000318        	  8259:     jsr     BlueWizzrobe_TryShooting
                            	  8260:     even
                            	  8261: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8262:     ; If the teleporting distance remaining is even, then draw
                            	  8263:     ; and check collisions, else return.
                            	  8264:     ;
                            	  8265:     ; This means that when 0, the monster is walking.
                            	  8266:     ; So, draw and check collisions every frame.
                            	  8267:     ;
                            	  8268:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8269:     ; translucently -- every other frame.
                            	  8270:     ;
02:0003D5DC 41EC0394        	  8271:     lea     ($0394,A4),A0
02:0003D5E0 10302000        	  8272:     move.b  (A0,D2.W),D0
02:0003D5E4 E208            	  8273:     lsr.b  #1,D0   ; LSR A
02:0003D5E6 6402            	  8274:     bcc.s  __far_z_04_0071
02:0003D5E8 603A            	  8275:     jmp  L11E17_Exit
                            	  8276: __far_z_04_0071:
                            	  8277:     even
                            	  8278: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D5EA 600004DE        	  8279:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8280: 
                            	  8281:     even
                            	  8282: BlueWizzrobe_WalkOrTeleport:
                            	  8283:     ; If timer has not expired, then go walk.
                            	  8284:     ;
02:0003D5EE 10342028        	  8285:     move.b  ($28,A4,D2.W),D0
02:0003D5F2 661C            	  8286:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8287:     ; Timer = 0. Only teleporting now.
                            	  8288:     ;
                            	  8289:     ; If there is still distance to go while translucent, then
                            	  8290:     ; decrement the distance remaining, and move.
                            	  8291:     ;
02:0003D5F4 41EC0394        	  8292:     lea     ($0394,A4),A0
02:0003D5F8 10302000        	  8293:     move.b  (A0,D2.W),D0
02:0003D5FC 670A            	  8294:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
