                            	  7715: _L_z04_UpdatePolsVoice_State0:
                            	  7716:     ; State 0. Walking.
                            	  7717:     ;
                            	  7718:     ; If grid offset = 0, then no more distance to cover.
                            	  7719:     ; So, go change to state 1 -- jumping.
                            	  7720:     ;
02:0003D156 41EC0394        	  7721:     lea     ($0394,A4),A0
