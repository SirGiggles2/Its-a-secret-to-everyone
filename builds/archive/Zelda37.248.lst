                            	  4101: PondFairy_MoveHearts:
                            	  4102:     ; Loop over each heart from object slot 2 to 9.
                            	  4103:     ;
                            	  4104:     ; Even though they are not standalone objects, their info
                            	  4105:     ; is stored in those object slots.
                            	  4106:     ;
