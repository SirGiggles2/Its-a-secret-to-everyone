02:0002E5B6 7600            	   420:     moveq   #0,D3
02:0002E5B8 41EC046C        	   421:     lea     ($046C,A4),A0
02:0002E5BC 16302000        	   422:     move.b  (A0,D2.W),D3
02:0002E5C0 41EC046F        	   423:     lea     ($046F,A4),A0
02:0002E5C4 10303000        	   424:     move.b  (A0,D3.W),D0
02:0002E5C8 41EC0448        	   425:     lea     ($0448,A4),A0
02:0002E5CC 11802000        	   426:     move.b  D0,(A0,D2.W)
02:0002E5D0 5302            	   427:     subq.b  #1,D2
02:0002E5D2 6AE2            	   428:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
