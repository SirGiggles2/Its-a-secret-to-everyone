                            	  7400: Dodongo_Draw:
02:0003CF26 610000F4        	  7401:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7402:     ; Make a 5-way direction index out of the facing direction
                            	  7403:     ; by shifting right once, and store it in [00].
                            	  7404:     ;
02:0003CF2A 41EC0098        	  7405:     lea     ($0098,A4),A0
02:0003CF2E 10302000        	  7406:     move.b  (A0,D2.W),D0
02:0003CF32 E208            	  7407:     lsr.b  #1,D0   ; LSR A
02:0003CF34 1880            	  7408:     move.b  D0,($0000,A4)
                            	  7409:     ; If state = 0, go handle animating the two frames of this state.
                            	  7410:     ;
02:0003CF36 7600            	  7411:     moveq   #0,D3
02:0003CF38 41EC00AC        	  7412:     lea     ($00AC,A4),A0
02:0003CF3C 16302000        	  7413:     move.b  (A0,D2.W),D3
02:0003CF40 6744            	  7414:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7415:     ; If state > 1, then the monster is stunned (state 2).
                            	  7416:     ; So, go switch frames every $20 screen frames.
                            	  7417:     ;
02:0003CF42 7020            	  7418:     moveq   #32,D0
02:0003CF44 5303            	  7419:     subq.b  #1,D3
02:0003CF46 6640            	  7420:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7421:     ; State = 1. Bloated.
                            	  7422:     ;
                            	  7423:     ; In substate 0, go animate as usual for walking.
                            	  7424:     ;
02:0003CF48 7600            	  7425:     moveq   #0,D3
02:0003CF4A 41EC042C        	  7426:     lea     ($042C,A4),A0
02:0003CF4E 16302000        	  7427:     move.b  (A0,D2.W),D3
02:0003CF52 6732            	  7428:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7429:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7430:     ; go fade the boss; so that some frames are not drawn.
                            	  7431:     ;
02:0003CF54 0C030002        	  7432:     cmpi.b  #$02,D3
02:0003CF58 6718            	  7433:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CF5A 0C030003        	  7434:     cmpi.b  #$03,D3
02:0003CF5E 6712            	  7435:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7436:     ; State 1, substate 1
                            	  7437:     ;
                            	  7438:     ; Add $14 to the frame image index to index into the bloated
                            	  7439:     ; frame images and H-flips.
                            	  7440:     ;
02:0003CF60 1014            	  7441:     move.b  ($0000,A4),D0
02:0003CF62 023C00EE        	  7442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF66 123C0014        	  7443:     move.b  #$14,D1
02:0003CF6A D101            	  7444:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CF6C 7600            	  7445:     moveq   #0,D3
02:0003CF6E 1600            	  7446:     move.b  D0,D3
02:0003CF70 6032            	  7447:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
