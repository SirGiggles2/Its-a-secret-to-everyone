                            	  7952: _anon_z05_174:
                            	  7953:     ; Two input directions, and at least one of them is walkable.
                            	  7954:     ;
                            	  7955:     ; Make Link go straight in one direction on the next grid line.
                            	  7956:     ;
02:00044D8C 7600            	  7957:     moveq   #0,D3
02:00044D8E 1600            	  7958:     move.b  D0,D3
02:00044D90 522C0057        	  7959:     addq.b  #1,($0057,A4)
                            	  7960:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7961:     ; object direction and input direction to last walkable direction
                            	  7962:     ; found, and set Link's speed.
                            	  7963:     ;
                            	  7964:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7965:     ;
02:00044D94 7400            	  7966:     moveq   #0,D2
02:00044D96 102C000D        	  7967:     move.b  ($000D,A4),D0
02:00044D9A 0C030001        	  7968:     cmpi.b  #$01,D3
02:00044D9E 67000096        	  7969:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00044DA2 7600            	  7970:     moveq   #0,D3
02:00044DA4 162C0010        	  7971:     move.b  ($0010,A4),D3
02:00044DA8 6700008C        	  7972:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7973:     ; In UW. There are two input directions, and they're both walkable.
                            	  7974:     ;
                            	  7975:     ; Normally, turn to the direction that's perpendicular to object
                            	  7976:     ; direction. But keep going straight after that, while diagonal
                            	  7977:     ; input is held.
                            	  7978:     ;
                            	  7979:     ; Handle special cases for doors.
                            	  7980:     ;
                            	  7981:     ;
                            	  7982:     ; 1. Link at horizontal doors.
                            	  7983:     ;
                            	  7984:     ; If Link's X = $20 or $D0 then
                            	  7985:     ;   If Link's Y = $85 and facing down then
                            	  7986:     ;     Go set object direction and input direction to object
                            	  7987:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7988:     ;     Link_GoStraightWhenDiagInput.
                            	  7989:     ;   Else
                            	  7990:     ;     Go turn to the perpendicular direction
                            	  7991:     ;
02:00044DAC 7600            	  7992:     moveq   #0,D3
02:00044DAE 162C0070        	  7993:     move.b  ($0070,A4),D3
02:00044DB2 0C030020        	  7994:     cmpi.b  #$20,D3
02:00044DB6 6706            	  7995:     beq  _anon_z05_175
02:00044DB8 0C0300D0        	  7996:     cmpi.b  #$D0,D3
02:00044DBC 661C            	  7997:     bne  _anon_z05_176
                            	  7998: _anon_z05_175:
