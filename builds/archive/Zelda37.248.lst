02:0003B5DA 41EC00C0        	  3919:     lea     ($00C0,A4),A0
02:0003B5DE 10302000        	  3920:     move.b  (A0,D2.W),D0
02:0003B5E2 6702            	  3921:     beq.s  __far_z_04_0033
