                            	  6819: ; Y: animation frame
                            	  6820: ; [00]: object X
                            	  6821: ; [01]: object Y
                            	  6822: ; [0F]: flip horizontal
                            	  6823: ;
                            	  6824: ; As the object walks, the animation counter rolls down.
                            	  6825: ;
                            	  6826:     even
                            	  6827: AnimateObjectWalking:
02:0004CD36 41EC03D0        	  6828:     lea     ($03D0,A4),A0
02:0004CD3A 53302000        	  6829:     subq.b  #1,(A0,D2.W)
02:0004CD3E 6702            	  6830:     beq.s  __far_z_07_0120
02:0004CD40 600C            	  6831:     jmp  SetUpWalkingSprites
                            	  6832: __far_z_07_0120:
                            	  6833:     ; Once the counter reaches 0, and if object is the player,
                            	  6834:     ; animate Link's object state.
                            	  6835:     ;
02:0004CD42 4A02            	  6836:     cmpi.b  #$00,D2
02:0004CD44 6602            	  6837:     bne  _anon_z07_36
02:0004CD46 615E            	  6838:     jsr     AnimateLinkObjState
                            	  6839: _anon_z07_36:
                            	  6840:     ; Roll over the counter (6 frames).
                            	  6841:     ;
02:0004CD48 7006            	  6842:     moveq   #6,D0
02:0004CD4A 1880            	  6843:     move.b  D0,($0000,A4)
02:0004CD4C 6152            	  6844:     jsr     RollOverAnimCounter
                            	  6845:     even
                            	  6846: SetUpWalkingSprites:
                            	  6847:     ; Set up sprite position in the descriptors.
                            	  6848:     ;
02:0004CD4E 614A            	  6849:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  6850:     ; Set up horizontal flipping.
                            	  6851:     ;
02:0004CD50 41EC0098        	  6852:     lea     ($0098,A4),A0
02:0004CD54 10302000        	  6853:     move.b  (A0,D2.W),D0
02:0004CD58 0200000C        	  6854:     andi.b #$0C,D0
02:0004CD5C 6602            	  6855:     bne.s  __far_z_07_0121
02:0004CD5E 6012            	  6856:     jmp  SetUpHorizontalWalkingSprites
                            	  6857: __far_z_07_0121:
                            	  6858:     ; Facing up or down.
                            	  6859:     ;
                            	  6860:     ;
                            	  6861:     ; Assume animation frame 3 (up).
02:0004CD60 7603            	  6862:     moveq   #3,D3
02:0004CD62 02000008        	  6863:     andi.b #$08,D0
02:0004CD66 6702            	  6864:     beq.s  __far_z_07_0122
02:0004CD68 6002            	  6865:     jmp  Anim_SetObjHFlipForSpriteDescriptor
                            	  6866: __far_z_07_0122:
02:0004CD6A 5303            	  6867:     subq.b  #1,D3
                            	  6868: ; Use the movement frame as the value for horizontal flipping.
                            	  6869: ;
                            	  6870: ; Params:
                            	  6871: ; X: object index
                            	  6872: ;
                            	  6873: ; Returns:
                            	  6874: ; [0F]: flip horizontal, based on ObjMovementFrame
                            	  6875: ;
                            	  6876:     even
