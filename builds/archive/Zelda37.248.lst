                            	  6470: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6471:     ; Link and the shot are facing opposite directions.
                            	  6472:     ; Link can parry certain weapons/shots.
                            	  6473:     ;
                            	  6474:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6475:     ; no harmful collision; but it still counts as a shot collision.
                            	  6476:     ; So, go treat this as a parry.
                            	  6477:     ;
02:0003211E 41EC034F        	  6478:     lea     ($034F,A4),A0
02:00032122 10302000        	  6479:     move.b  (A0,D2.W),D0
02:00032126 0C000055        	  6480:     cmpi.b  #$55,D0
02:0003212A 650E            	  6481:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:0003212C 0C00005B        	  6482:     cmpi.b  #$5B,D0
02:00032130 6408            	  6483:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6484:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6485:     ; So, go harm Link.
                            	  6486:     ;
02:00032132 102C0676        	  6487:     move.b  ($0676,A4),D0
02:00032136 6602            	  6488:     bne.s  __far_z_01_0066
02:00032138 600E            	  6489:     jmp  HarmLink
                            	  6490: __far_z_01_0066:
                            	  6491:     even
                            	  6492: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6493:     ; Else Link parries.
                            	  6494:     ;
                            	  6495:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6496:     ;
02:0003213A 7001            	  6497:     moveq   #1,D0
02:0003213C 19400604        	  6498:     move.b  D0,($0604,A4)
02:00032140 7000            	  6499:     moveq   #0,D0
02:00032142 19400006        	  6500:     move.b  D0,($0006,A4)
                            	  6501:     even
