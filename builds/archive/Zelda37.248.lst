02:000367CC 102C0084        	  4757:     move.b  ($0084,A4),D0
02:000367D0 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:000367D4 123C0010        	  4759:     move.b  #$10,D1
02:000367D8 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000367DC 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:000367DE 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
