02:0002EFC8 41F90002EF78    	  1840:     lea     (DemoPatternBlockSizes).l,A0
02:0002EFCE 10302000        	  1841:     move.b  (A0,D2.W),D0
02:0002EFD2 19400003        	  1842:     move.b  D0,($0003,A4)
