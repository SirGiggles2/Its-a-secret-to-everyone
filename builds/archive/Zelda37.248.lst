02:000421BD BF
02:000421BE 00
02:000421BF D2
                            	  3971: 
                            	  3972: ; Player coordinate must be < these bounds.
                            	  3973: ; Using these bounds; the player will be considered within the
                            	  3974: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3975: ; at the edge.
                            	  3976: ;
                            	  3977:     even
                            	  3978: DoorwayBoundsMaxUnder:
02:000421C0 5C              	  3979:     dc.b    $5C, $DE, $1F, $F1
02:000421C1 DE
02:000421C2 1F
02:000421C3 F1
                            	  3980: 
                            	  3981: ; Params:
                            	  3982: ; [0F]: moving direction
                            	  3983: ;
                            	  3984: ; Returns:
                            	  3985: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3986: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3987: ;
                            	  3988: ; When not at or in a doorway, this function leaves
                            	  3989: ; [0F] moving direction as is.
                            	  3990: ;
                            	  3991: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3992: ; will be left as is, assuming that it had been reset before this
                            	  3993: ; routine by BoundByRoom.
                            	  3994: ;
                            	  3995: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3996: ;
                            	  3997: ;
                            	  3998: ; If already in a doorway, go handle it separately.
                            	  3999: ;
                            	  4000:     even
                            	  4001: CheckDoorway:
02:000421C4 102C0053        	  4002:     move.b  ($0053,A4),D0
