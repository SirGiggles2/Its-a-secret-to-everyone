                            	  2199: 
                            	  2200: ; Params:
                            	  2201: ; A: Y coordinate
                            	  2202: ; X: object index
                            	  2203: ;
                            	  2204:     even
                            	  2205: InitWhirlwind:
02:00030274 6000B9D4        	  2206:     jmp     c_init_whirlwind
                            	  2207: 
                            	  2208: SetUpWhirlwind:
02:00030278 6000B780        	  2209:     jmp     c_set_up_whirlwind
                            	  2210: 
                            	  2211: WhirlwindPrevRoomIdList:
02:0003027C 36              	  2212:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0003027D 3B
02:0003027E 73
02:0003027F 44
02:00030280 0A
02:00030281 21
02:00030282 41
02:00030283 6C
                            	  2213: 
                            	  2214:     even
                            	  2215: UpdateWhirlwind_Full:
                            	  2216:     ; Get Link's halted state.
                            	  2217:     ;
02:00030284 102C00AC        	  2218:     move.b  ($00AC,A4),D0
02:00030288 02000040        	  2219:     andi.b #$40,D0
02:0003028C 7600            	  2220:     moveq   #0,D3
02:0003028E 1600            	  2221:     move.b  D0,D3
                            	  2222:     ; Add 2 to whirlwind X.
                            	  2223:     ;
02:00030290 7002            	  2224:     moveq   #2,D0
02:00030292 023C00EE        	  2225:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030296 12342070        	  2226:     move.b  ($70,A4,D2.W),D1
02:0003029A D101            	  2227:     addx.b  D1,D0   ; ADC ObjX,X
02:0003029C 19802070        	  2228:     move.b  D0,($70,A4,D2.W)
                            	  2229:     ; If Link is not halted or teleporting state = 0, then
                            	  2230:     ; go check for collision with Link.
                            	  2231:     ;
02:000302A0 0C030040        	  2232:     cmpi.b  #$40,D3
02:000302A4 6638            	  2233:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:000302A6 7600            	  2234:     moveq   #0,D3
02:000302A8 162C0522        	  2235:     move.b  ($0522,A4),D3
02:000302AC 6730            	  2236:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2237:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2238:     ;
                            	  2239:     ; Set Link's X to whirlwind's.
                            	  2240:     ;
02:000302AE 19400070        	  2241:     move.b  D0,($0070,A4)
                            	  2242:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2243:     ; the right screen edge and draw.
                            	  2244:     ;
02:000302B2 5303            	  2245:     subq.b  #1,D3
02:000302B4 6776            	  2246:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000302B6 0C000080        	  2247:     cmpi.b  #$80,D0
02:000302BA 6670            	  2248:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2249:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2250:     ;
                            	  2251:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2252:     ;
02:000302BC E308            	  2253:     lsl.b  #1,D0   ; ASL A
02:000302BE 194000AC        	  2254:     move.b  D0,($00AC,A4)
02:000302C2 19400522        	  2255:     move.b  D0,($0522,A4)
02:000302C6 41EC034F        	  2256:     lea     ($034F,A4),A0
02:000302CA 11802000        	  2257:     move.b  D0,(A0,D2.W)
                            	  2258:     ; Update the player position marker, and draw one last time.
                            	  2259:     ;
02:000302CE 1002            	  2260:     move.b  D2,D0
02:000302D0 1B00            	  2261:     move.b  D0,-(A5)  ; PHA
02:000302D2 6100106A        	  2262:     jsr     UpdatePlayerPositionMarker
02:000302D6 101D            	  2263:     move.b  (A5)+,D0  ; PLA
02:000302D8 7400            	  2264:     moveq   #0,D2
02:000302DA 1400            	  2265:     move.b  D0,D2
02:000302DC 6070            	  2266:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2267: 
                            	  2268:     even
                            	  2269: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2270:     ; Link is not halted or teleporting state = 0.
                            	  2271:     ; Try to pick up Link.
                            	  2272:     ;
                            	  2273:     ; If the whirlwind does not collide with Link, then go check
                            	  2274:     ; for the screen's right edge.
                            	  2275:     ;
02:000302DE 61001D3A        	  2276:     jsr     CheckLinkCollision
02:000302E2 102C0006        	  2277:     move.b  ($0006,A4),D0
02:000302E6 6744            	  2278:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2279:     ; Collided with Link.
                            	  2280:     ;
                            	  2281:     ; Make Link face right. Reset shove info and subroom type.
                            	  2282:     ;
02:000302E8 7001            	  2283:     moveq   #1,D0
02:000302EA 19400098        	  2284:     move.b  D0,($0098,A4)
02:000302EE E208            	  2285:     lsr.b  #1,D0   ; LSR A
02:000302F0 194000C0        	  2286:     move.b  D0,($00C0,A4)
02:000302F4 194000D3        	  2287:     move.b  D0,($00D3,A4)
02:000302F8 1940005A        	  2288:     move.b  D0,($005A,A4)
                            	  2289:     ; Halt Link (state $40), and hide him.
                            	  2290:     ;
02:000302FC 7040            	  2291:     moveq   #64,D0
02:000302FE 194000AC        	  2292:     move.b  D0,($00AC,A4)
02:00030302 103C00F8        	  2293:     move.b  #$F8,D0
02:00030306 19400248        	  2294:     move.b  D0,($0248,A4)
02:0003030A 1940024C        	  2295:     move.b  D0,($024C,A4)
                            	  2296:     ; Find and set the room that will behave as the previous room
                            	  2297:     ; when scrolling right to the room with the level's entrance.
                            	  2298:     ;
02:0003030E 102C0523        	  2299:     move.b  ($0523,A4),D0
02:00030312 02000007        	  2300:     andi.b #$07,D0
02:00030316 7600            	  2301:     moveq   #0,D3
02:00030318 1600            	  2302:     move.b  D0,D3
02:0003031A 41F90003027C    	  2303:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030320 10303000        	  2304:     move.b  (A0,D3.W),D0
02:00030324 194000EA        	  2305:     move.b  D0,($00EA,A4)
                            	  2306:     ; Set teleporting state 1.
                            	  2307:     ;
02:00030328 522C0522        	  2308:     addq.b  #1,($0522,A4)
                            	  2309:     even
                            	  2310: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2311:     ; If whirlwind's X < $F0, go draw.
                            	  2312:     ;
02:0003032C 10342070        	  2313:     move.b  ($70,A4,D2.W),D0
02:00030330 0C0000F0        	  2314:     cmpi.b  #$F0,D0
02:00030334 6518            	  2315:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2316:     ; The whirlwind has reached the right edge of the screen.
                            	  2317:     ;
                            	  2318:     ; Destroy the object.
                            	  2319:     ;
02:00030336 611A            	  2320:     jsr     DestroyWhirlwind
                            	  2321:     ; If teleporting state <> 0, we picked up Link.
                            	  2322:     ; So, go to the next mode.
                            	  2323:     ;
                            	  2324:     ; Either way, draw one last time.
                            	  2325:     ;
02:00030338 102C0522        	  2326:     move.b  ($0522,A4),D0
02:0003033C 6710            	  2327:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0003033E 1002            	  2328:     move.b  D2,D0
02:00030340 1B00            	  2329:     move.b  D0,-(A5)  ; PHA
02:00030342 4EB90004BC14    	  2330:     jsr     GoToNextModeFromPlay
02:00030348 101D            	  2331:     move.b  (A5)+,D0  ; PLA
02:0003034A 7400            	  2332:     moveq   #0,D2
02:0003034C 1400            	  2333:     move.b  D0,D2
                            	  2334:     even
                            	  2335: _L_z01_UpdateWhirlwind_Full_Draw:
02:0003034E 600000A8        	  2336:     jmp     DrawWhirlwind
                            	  2337: 
                            	  2338:     even
                            	  2339: DestroyWhirlwind:
02:00030352 6000B4C0        	  2340:     jmp     c_destroy_whirlwind
                            	  2341: 
                            	  2342: SummonWhirlwind:
                            	  2343:     ; If not in mode 5, return.
                            	  2344:     ;
02:00030356 102C0012        	  2345:     move.b  ($0012,A4),D0
02:0003035A 0C000005        	  2346:     cmpi.b  #$05,D0
02:0003035E 6704            	  2347:     beq.s  __far_z_01_0012
02:00030360 60000094        	  2348:     jmp  L6104_Exit
                            	  2349: __far_z_01_0012:
                            	  2350:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2351:     ;
02:00030364 6178            	  2352:     jsr     AdvanceTeleportingLevelIndex
02:00030366 102C0523        	  2353:     move.b  ($0523,A4),D0
02:0003036A 02000007        	  2354:     andi.b #$07,D0
02:0003036E 7600            	  2355:     moveq   #0,D3
02:00030370 1600            	  2356:     move.b  D0,D3
02:00030372 41F90004AB2C    	  2357:     lea     (LevelMasks).l,A0
02:00030378 10303000        	  2358:     move.b  (A0,D3.W),D0
02:0003037C 1880            	  2359:     move.b  D0,($0000,A4)
                            	  2360:     even
                            	  2361: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2362:     ; If there are no triforce pieces, then return.
                            	  2363:     ;
02:0003037E 102C0671        	  2364:     move.b  ($0671,A4),D0
02:00030382 6602            	  2365:     bne.s  __far_z_01_0013
02:00030384 6070            	  2366:     jmp  L6104_Exit
                            	  2367: __far_z_01_0013:
                            	  2368:     ; If we have gotten this triforce piece, then go try to make a
                            	  2369:     ; whirlwind.
                            	  2370:     ;
02:00030386 1214            	  2371:     move.b  ($0000,A4),D1
02:00030388 C200            	  2372:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003038A 662C            	  2373:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2374:     ; We have not gotten this piece.
                            	  2375:     ; First, advance the teleporting index again.
                            	  2376:     ;
02:0003038C 6150            	  2377:     jsr     AdvanceTeleportingLevelIndex
                            	  2378:     ; If the direction Link is facing is an increasing one, then
                            	  2379:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2380:     ; level number. Then go test this new mask.
                            	  2381:     ;
02:0003038E 102C0098        	  2382:     move.b  ($0098,A4),D0
02:00030392 02000009        	  2383:     andi.b #$09,D0
02:00030396 6710            	  2384:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:00030398 1214            	  2385:     move.b  ($0000,A4),D1
02:0003039A E309            	  2386:     lsl.b  #1,D1   ; ASL $00
02:0003039C 1881            	  2387:     move.b  D1,($0000,A4)
02:0003039E 64DE            	  2388:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000303A0 1214            	  2389:     move.b  ($0000,A4),D1
02:000303A2 E311            	  2390:     roxl.b  #1,D1   ; ROL $00
02:000303A4 1881            	  2391:     move.b  D1,($0000,A4)
02:000303A6 60D6            	  2392:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2393: 
                            	  2394:     even
                            	  2395: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2396:     ; If instead the direction is a decreasing one, then
                            	  2397:     ; rotate right to correspond to the lower level number.
                            	  2398:     ; Then go test this new mask.
                            	  2399:     ;
02:000303A8 1214            	  2400:     move.b  ($0000,A4),D1
02:000303AA E209            	  2401:     lsr.b  #1,D1   ; LSR $00
