                            	  2524: 
                            	  2525: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2526: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2527: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2528: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2529: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2530: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2531:     even
                            	  2532: ModeE_SyncCharBoardCursorToIndex:
02:00035108 4EF90002BADC    	  2533:     jmp     c_mode_e_sync_char_board_cursor
                            	  2534: 
                            	  2535: ModeE_HandleAOrB:
02:0003510E 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:00035112 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00035114 7600            	  2540:     moveq   #0,D3
02:00035116 162C0016        	  2541:     move.b  ($0016,A4),D3
02:0003511A 0C030003        	  2542:     cmpi.b  #$03,D3
02:0003511E 6602            	  2543:     bne.s  __far_z_02_0007
02:00035120 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00035122 41F900034B30    	  2548:     lea     (SlotToNameOffset).l,A0
02:00035128 10303000        	  2549:     move.b  (A0,D3.W),D0
02:0003512C 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00035130 7400            	  2553:     moveq   #0,D2
02:00035132 41F900034B34    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00035138 14303000        	  2555:     move.b  (A0,D3.W),D2
02:0003513C 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:0003513E 41F900034B00    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00035144 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00035148 41EC0422        	  2561:     lea     ($0422,A4),A0
02:0003514C 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00035150 5302            	  2563:     subq.b  #1,D2
02:00035152 5303            	  2564:     subq.b  #1,D3
02:00035154 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00035156 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:0003515A 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:0003515E 020000C0        	  2577:     andi.b #$C0,D0
02:00035162 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00035166 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:0003516A 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:0003516E 7620            	  2586:     moveq   #32,D3
02:00035170 19430604        	  2587:     move.b  D3,($0604,A4)
02:00035174 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00035176 41EC0422        	  2591:     lea     ($0422,A4),A0
02:0003517A 10303000        	  2592:     move.b  (A0,D3.W),D0
02:0003517E 41EC0302        	  2593:     lea     ($0302,A4),A0
