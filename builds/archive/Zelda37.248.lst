                            	  2314:     even
                            	  2315: _L_z04__TryShooting_TryShootingNow:
                            	  2316:     ; Summary
                            	  2317:     ;
                            	  2318:     ; if temporarily invincible then
                            	  2319:     ;   shoot timer := 0
                            	  2320:     ; elif shoot timer > 0 then
                            	  2321:     ;   decrement shoot timer
                            	  2322:     ; elif wants to shoot then
                            	  2323:     ;   shoot timer := $30
                            	  2324:     ;
                            	  2325:     ; qspeed := [01]
                            	  2326:     ;
                            	  2327:     ; if shoot timer <> 0 then
                            	  2328:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2329:     ;     shoot
                            	  2330:     ;     if succeeded then
                            	  2331:     ;       shoot timer := 0
                            	  2332:     ;       qspeed := 0
                            	  2333:     ;   else
                            	  2334:     ;     qspeed := 0
                            	  2335:     ;
                            	  2336:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003AAD6 102C0001        	  2337:     move.b  ($0001,A4),D0
02:0003AADA 1883            	  2338:     move.b  D3,($0000,A4)
02:0003AADC 1B00            	  2339:     move.b  D0,-(A5)  ; PHA
02:0003AADE 7600            	  2340:     moveq   #0,D3
                            	  2341:     ; If not temporarily invincible,
                            	  2342:     ;
02:0003AAE0 41EC04F0        	  2343:     lea     ($04F0,A4),A0
02:0003AAE4 10302000        	  2344:     move.b  (A0,D2.W),D0
02:0003AAE8 661A            	  2345:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2346:     ; then Y := shoot timer - 1
                            	  2347:     ;
02:0003AAEA 7600            	  2348:     moveq   #0,D3
02:0003AAEC 41EC0451        	  2349:     lea     ($0451,A4),A0
02:0003AAF0 16302000        	  2350:     move.b  (A0,D2.W),D3
02:0003AAF4 5303            	  2351:     subq.b  #1,D3
                            	  2352:     ; If Y register < 0, then shoot timer is 0.
                            	  2353:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2354:     ; Else go set a non-zero speed and return.
                            	  2355:     ;
02:0003AAF6 6A0C            	  2356:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003AAF8 41EC0412        	  2357:     lea     ($0412,A4),A0
02:0003AAFC 10302000        	  2358:     move.b  (A0,D2.W),D0
02:0003AB00 6736            	  2359:     beq  _L_z04__TryShooting_SetSpeed
02:0003AB02 7630            	  2360:     moveq   #48,D3
                            	  2361:     even
                            	  2362: _L_z04__TryShooting_SetShootTimer:
                            	  2363:     ; shoot timer := Y
                            	  2364:     ;
02:0003AB04 1003            	  2365:     move.b  D3,D0
02:0003AB06 41EC0451        	  2366:     lea     ($0451,A4),A0
02:0003AB0A 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2369:     ;
02:0003AB0E 6728            	  2370:     beq  _L_z04__TryShooting_SetSpeed
                            	  2371:     ; shoot timer <> 0
                            	  2372:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2373:     ;
02:0003AB10 0C030010        	  2374:     cmpi.b  #$10,D3
02:0003AB14 661C            	  2375:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2376:     ; If we have the magic clock, or the monster is stunned, then
                            	  2377:     ; go set a zero speed.
                            	  2378:     ;
02:0003AB16 102C066C        	  2379:     move.b  ($066C,A4),D0
02:0003AB1A 1234203D        	  2380:     move.b  ($3D,A4,D2.W),D1
02:0003AB1E 8001            	  2381:     or.b  D1,D0
02:0003AB20 6610            	  2382:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2383:     ; Shoot.
                            	  2384:     ;
02:0003AB22 1014            	  2385:     move.b  ($0000,A4),D0
02:0003AB24 611E            	  2386:     jsr     _ShootIfWanted2
                            	  2387:     ; If it failed, go set a non-zero speed.
