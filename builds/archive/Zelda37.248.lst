02:0003AAAA 0C000003        	  2298:     cmpi.b  #$03,D0
02:0003AAAE 6726            	  2299:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AAB0 0C000001        	  2300:     cmpi.b  #$01,D0
02:0003AAB4 6720            	  2301:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AAB6 0C000009        	  2302:     cmpi.b  #$09,D0
02:0003AABA 671A            	  2303:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AABC 0C00000A        	  2304:     cmpi.b  #$0A,D0
02:0003AAC0 6714            	  2305:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AAC2 41EC0451        	  2306:     lea     ($0451,A4),A0
02:0003AAC6 10302000        	  2307:     move.b  (A0,D2.W),D0
02:0003AACA 660A            	  2308:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2309:     ; and a random value < $F8, then return.
                            	  2310:     ;
02:0003AACC 10342018        	  2311:     move.b  ($18,A4,D2.W),D0
02:0003AAD0 0C0000F8        	  2312:     cmpi.b  #$F8,D0
