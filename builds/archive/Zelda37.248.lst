                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:000339AA 4EB90004A9D8    	   518:     jsr     TurnOffAllVideo
02:000339B0 7000            	   519:     moveq   #0,D0
02:000339B2 19400016        	   520:     move.b  D0,($0016,A4)
02:000339B6 6100D23A        	   521:     jsr     FetchFileAAddressSet
02:000339BA 7602            	   522:     moveq   #2,D3
                            	   523:     even
                            	   524: _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot:
02:000339BC 122C0006        	   525:     move.b  ($06,A4),D1   ; ptr lo
02:000339C0 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:000339C4 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000339C8 E14C            	   528:     lsl.w   #8,D4
02:000339CA 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:000339CC 48C4            	   530:     ext.l   D4
02:000339CE D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000339D4 2044            	   532:     movea.l D4,A0
02:000339D6 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000339DA 41EC0633        	   534:     lea     ($0633,A4),A0
02:000339DE 11803000        	   535:     move.b  D0,(A0,D3.W)
02:000339E2 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:000339E4 1003            	   537:     move.b  D3,D0
02:000339E6 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:000339E8 19430016        	   539:     move.b  D3,($0016,A4)
02:000339EC 6100D204        	   540:     jsr     FetchFileAAddressSet
02:000339F0 61001C3C        	   541:     jsr     FormatFileA
02:000339F4 7000            	   542:     moveq   #0,D0
02:000339F6 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:000339FA 6100D1F6        	   550:     jsr     FetchFileAAddressSet
02:000339FE 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00033A00 7600            	   552:     moveq   #0,D3
02:00033A02 1600            	   553:     move.b  D0,D3
                            	   554:     even
                            	   555: _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot:
02:00033A04 122C000A        	   556:     move.b  ($0A,A4),D1   ; ptr lo
02:00033A08 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:00033A0C 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A10 E14C            	   559:     lsl.w   #8,D4
02:00033A12 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033A14 48C4            	   561:     ext.l   D4
02:00033A16 D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033A1C 2044            	   563:     movea.l D4,A0
02:00033A1E 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A22 41EC0630        	   565:     lea     ($0630,A4),A0
02:00033A26 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00033A2A 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033A2E 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033A32 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A36 E14C            	   570:     lsl.w   #8,D4
02:00033A38 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033A3A 48C4            	   572:     ext.l   D4
02:00033A3C D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033A42 2044            	   574:     movea.l D4,A0
02:00033A44 10303000        	   575:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A48 41EC062D        	   576:     lea     ($062D,A4),A0
02:00033A4C 11803000        	   577:     move.b  D0,(A0,D3.W)
02:00033A50 5303            	   578:     subq.b  #1,D3
02:00033A52 6A00FF68        	   579:     bpl  _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot
