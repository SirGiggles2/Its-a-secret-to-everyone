                            	  3733: FormatHeartsInTextBuf:
                            	  3734:     ; [$0E]: hearts value
                            	  3735:     ; [$0F]: heart partial
                            	  3736:     ; Y: The offset of first character in buffer
                            	  3737:     ;
                            	  3738:     ; The end of the bottom row is $12 bytes after the
                            	  3739:     ; start of the top row. We're writing to two transfer
                            	  3740:     ; records. We write the top row in the first transfer
                            	  3741:     ; record wherever the caller chooses. The second
                            	  3742:     ; transfer record has to begin with the heart tiles.
                            	  3743:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3744:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3745:     ;
                            	  3746:     ; Store the starting offset in [$0D].
02:00030CBC 1943000D        	  3747:     move.b  D3,($000D,A4)
02:00030CC0 102C000E        	  3748:     move.b  ($000E,A4),D0
02:00030CC4 1B00            	  3749:     move.b  D0,-(A5)  ; PHA
02:00030CC6 0200000F        	  3750:     andi.b #$0F,D0
02:00030CCA 1880            	  3751:     move.b  D0,($0000,A4)
02:00030CCC 700F            	  3752:     moveq   #15,D0
02:00030CCE 003C0011        	  3753:     ori     #$11,CCR  ; SEC: set C+X
02:00030CD2 1214            	  3754:     move.b  ($0000,A4),D1
02:00030CD4 0A3C0010        	  3755:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030CD8 9101            	  3756:     subx.b  D1,D0   ; SBC $00
02:00030CDA 0A3C0010        	  3757:     eori    #$10,CCR  ; restore X = 6502 C
02:00030CDE 1880            	  3758:     move.b  D0,($0000,A4)
02:00030CE0 101D            	  3759:     move.b  (A5)+,D0  ; PLA
02:00030CE2 E208            	  3760:     lsr.b  #1,D0   ; LSR A
02:00030CE4 E208            	  3761:     lsr.b  #1,D0   ; LSR A
02:00030CE6 E208            	  3762:     lsr.b  #1,D0   ; LSR A
02:00030CE8 E208            	  3763:     lsr.b  #1,D0   ; LSR A
02:00030CEA 19400001        	  3764:     move.b  D0,($0001,A4)
02:00030CEE 700F            	  3765:     moveq   #15,D0
02:00030CF0 003C0011        	  3766:     ori     #$11,CCR  ; SEC: set C+X
02:00030CF4 122C0001        	  3767:     move.b  ($0001,A4),D1
02:00030CF8 0A3C0010        	  3768:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030CFC 9101            	  3769:     subx.b  D1,D0   ; SBC $01
02:00030CFE 0A3C0010        	  3770:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D02 19400001        	  3771:     move.b  D0,($0001,A4)
                            	  3772:     ; At this point,
                            	  3773:     ; [$00] = $F - hearts
                            	  3774:     ; [$01] = $F - heart containers
                            	  3775:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3776:     ;
                            	  3777:     ; Also, Y is still set to the value passed in.
                            	  3778:     ;
02:00030D06 7400            	  3779:     moveq   #0,D2
02:00030D08 1003            	  3780:     move.b  D3,D0
02:00030D0A 023C00EE        	  3781:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D0E 123C0007        	  3782:     move.b  #$07,D1
02:00030D12 D101            	  3783:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030D14 1940000B        	  3784:     move.b  D0,($000B,A4)
                            	  3785:     ; Y keeps track of index of heart in row.
                            	  3786:     ; Start at the end of the first row.
02:00030D18 7607            	  3787:     moveq   #7,D3
