02:0003E0C0 41EC041F        	  9741:     lea     ($041F,A4),A0
02:0003E0C4 11802000        	  9742:     move.b  D0,(A0,D2.W)
                            	  9743:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9744:     ;
02:0003E0C8 640000A8        	  9745:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9746:     ; Increase the distance traveled, and move 1.
                            	  9747:     ;
02:0003E0CC 41EC0412        	  9748:     lea     ($0412,A4),A0
02:0003E0D0 52302000        	  9749:     addq.b  #1,(A0,D2.W)
                            	  9750:     ; Set a direction mask in [02], starting with right (1).
                            	  9751:     ;
02:0003E0D4 7001            	  9752:     moveq   #1,D0
02:0003E0D6 19400002        	  9753:     move.b  D0,($0002,A4)
                            	  9754:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9755:     ;
02:0003E0DA 41EC0098        	  9756:     lea     ($0098,A4),A0
02:0003E0DE 10302000        	  9757:     move.b  (A0,D2.W),D0
02:0003E0E2 122C0002        	  9758:     move.b  ($0002,A4),D1
02:0003E0E6 C200            	  9759:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
