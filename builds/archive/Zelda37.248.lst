                            	  6919: AnimateLinkObjState:
                            	  6920:     ; If major state = $10
                            	  6921:     ;   if minor state = 0, make it 1
                            	  6922:     ;   else OR state with $30
                            	  6923:     ;   go set movement frame to 1
                            	  6924:     ;
02:0004CDA6 102C00AC        	  6925:     move.b  ($00AC,A4),D0
02:0004CDAA 02000030        	  6926:     andi.b #$30,D0
02:0004CDAE 0C000010        	  6927:     cmpi.b  #$10,D0
02:0004CDB2 660C            	  6928:     bne  _L_z07_AnimateLinkObjState_CheckState20
02:0004CDB4 102C00AC        	  6929:     move.b  ($00AC,A4),D0
02:0004CDB8 0200000F        	  6930:     andi.b #$0F,D0
