02:0003CF8C 122C0015        	  7472:     move.b  ($0015,A4),D1
02:0003CF90 C001            	  7473:     and.b  D1,D0
02:0003CF92 6710            	  7474:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7475:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7476:     ; in order to index into the second set of frame image numbers.
                            	  7477:     ;
02:0003CF94 1003            	  7478:     move.b  D3,D0
02:0003CF96 023C00EE        	  7479:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF9A 123C0005        	  7480:     move.b  #$05,D1
02:0003CF9E D101            	  7481:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CFA0 7600            	  7482:     moveq   #0,D3
02:0003CFA2 1600            	  7483:     move.b  D0,D3
