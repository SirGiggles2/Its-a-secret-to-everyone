02:0003B6A4 6620            	  4038:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4039:     ; If not filling hearts anymore, then go to state 2,
                            	  4040:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4041:     ; a little while after we finish filling hearts.
                            	  4042:     ;
02:0003B6A6 522C00AD        	  4043:     addq.b  #1,($00AD,A4)
