                            	  5887:     ;
02:0003C442 10342028        	  5888:     move.b  ($28,A4,D2.W),D0
02:0003C446 0C000010        	  5889:     cmpi.b  #$10,D0
02:0003C44A 6702            	  5890:     beq.s  __far_z_04_0045
02:0003C44C 6058            	  5891:     jmp  L1156B_Exit
