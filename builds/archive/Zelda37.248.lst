                            	  2680: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2681:     ; Set state 1 to jump.
                            	  2682:     ;
02:0003AD06 41EC00AC        	  2683:     lea     ($00AC,A4),A0
02:0003AD0A 52302000        	  2684:     addq.b  #1,(A0,D2.W)
