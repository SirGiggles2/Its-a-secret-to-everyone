                            	  7932: HaveInput:
                            	  7933:     ; There were input directions.
                            	  7934:     ;
                            	  7935:     ; If there was only one input direction, go set object direction
                            	  7936:     ; to input direction, and set Link's speed.
                            	  7937:     ;
                            	  7938:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7939:     ; (X is still 0, because it's Link's object index).
                            	  7940:     ;
02:00044D76 102C000F        	  7941:     move.b  ($000F,A4),D0
02:00044D7A 0C030001        	  7942:     cmpi.b  #$01,D3
02:00044D7E 670000B6        	  7943:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7944:     ; There were more than one input directions.
                            	  7945:     ;
                            	  7946:     ; If none were walkable, go set input direction to 0, and return.
                            	  7947:     ;
02:00044D82 102C000C        	  7948:     move.b  ($000C,A4),D0
02:00044D86 6604            	  7949:     bne  _anon_z05_174
