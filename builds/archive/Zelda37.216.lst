                            	  6047: AnimateBoomerangAndCheckCollision:
                            	  6048:     ; Decrement animation counter; and when it reaches 0:
                            	  6049:     ; 1. arm it again for 2 frames
                            	  6050:     ; 2. advance the minor state within a cycle of 8
                            	  6051:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  6052:     ;
02:0004CB12 41EC03D0        	  6053:     lea     ($03D0,A4),A0
02:0004CB16 53302000        	  6054:     subq.b  #1,(A0,D2.W)
02:0004CB1A 6702            	  6055:     beq.s  __far_z_07_0090
02:0004CB1C 6036            	  6056:     jmp  DrawBoomerangAndCheckCollision
                            	  6057: __far_z_07_0090:
02:0004CB1E 7002            	  6058:     moveq   #2,D0
02:0004CB20 41EC03D0        	  6059:     lea     ($03D0,A4),A0
02:0004CB24 11802000        	  6060:     move.b  D0,(A0,D2.W)
02:0004CB28 41EC00AC        	  6061:     lea     ($00AC,A4),A0
02:0004CB2C 52302000        	  6062:     addq.b  #1,(A0,D2.W)
02:0004CB30 41EC00AC        	  6063:     lea     ($00AC,A4),A0
02:0004CB34 10302000        	  6064:     move.b  (A0,D2.W),D0
02:0004CB38 02000077        	  6065:     andi.b #$77,D0
02:0004CB3C 41EC00AC        	  6066:     lea     ($00AC,A4),A0
02:0004CB40 11802000        	  6067:     move.b  D0,(A0,D2.W)
02:0004CB44 0C02000D        	  6068:     cmpi.b  #$0D,D2
02:0004CB48 6402            	  6069:     bcc.s  __far_z_07_0091
02:0004CB4A 6032            	  6070:     jmp  CalcBoomerangFrame
                            	  6071: __far_z_07_0091:
