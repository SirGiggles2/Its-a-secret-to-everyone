                            	 12705:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12706:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12707:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12708:     ;
02:0003F130 41EC034F        	 12709:     lea     ($034F,A4),A0
02:0003F134 10302000        	 12710:     move.b  (A0,D2.W),D0
02:0003F138 0C000025        	 12711:     cmpi.b  #$25,D0
