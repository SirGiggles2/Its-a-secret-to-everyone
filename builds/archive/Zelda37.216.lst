02:0003A95C 41EC0098        	  2911:     lea     ($0098,A4),A0
02:0003A960 10302000        	  2912:     move.b  (A0,D2.W),D0
02:0003A964 02000002        	  2913:     andi.b #$02,D0
02:0003A968 6602            	  2914:     bne  _anon_z04_38
02:0003A96A 7601            	  2915:     moveq   #1,D3
                            	  2916: _anon_z04_38:
02:0003A96C 1003            	  2917:     move.b  D3,D0
02:0003A96E 023C00EE        	  2918:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A972 12342070        	  2919:     move.b  ($70,A4,D2.W),D1
02:0003A976 D101            	  2920:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A978 19802070        	  2921:     move.b  D0,($70,A4,D2.W)
                            	  2922:     ; If going up (negative v-speed high byte), then
                            	  2923:     ; go animate, draw, and check collisions.
