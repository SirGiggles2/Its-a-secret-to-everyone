02:0004C67C 122C0003        	  5365:     move.b  ($0003,A4),D1
02:0004C680 D101            	  5366:     addx.b  D1,D0   ; ADC $03
02:0004C682 19400001        	  5367:     move.b  D0,($0001,A4)
