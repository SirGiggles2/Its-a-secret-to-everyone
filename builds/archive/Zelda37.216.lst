                            	  7406: Dodongo_CheckBombHit:
                            	  7407:     ; If state <> 0 (not moving), then return.
                            	  7408:     ;
02:0003CA0C 41EC00AC        	  7409:     lea     ($00AC,A4),A0
02:0003CA10 10302000        	  7410:     move.b  (A0,D2.W),D0
02:0003CA14 66000086        	  7411:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7412:     ; If facing vertically, then store (X + 8) in [00].
                            	  7413:     ; Else store (X + $10).
                            	  7414:     ;
02:0003CA18 10342070        	  7415:     move.b  ($70,A4,D2.W),D0
02:0003CA1C 023C00EE        	  7416:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA20 123C0008        	  7417:     move.b  #$08,D1
02:0003CA24 D101            	  7418:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA26 7600            	  7419:     moveq   #0,D3
02:0003CA28 41EC0098        	  7420:     lea     ($0098,A4),A0
02:0003CA2C 16302000        	  7421:     move.b  (A0,D2.W),D3
02:0003CA30 0C030004        	  7422:     cmpi.b  #$04,D3
02:0003CA34 6406            	  7423:     bcc  _anon_z04_91
02:0003CA36 123C0008        	  7424:     move.b  #$08,D1
02:0003CA3A D101            	  7425:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7426: _anon_z04_91:
02:0003CA3C 1880            	  7427:     move.b  D0,($0000,A4)
                            	  7428:     ; Store (Y + 8) in [01].
                            	  7429:     ;
02:0003CA3E 41EC0084        	  7430:     lea     ($0084,A4),A0
02:0003CA42 10302000        	  7431:     move.b  (A0,D2.W),D0
02:0003CA46 123C0008        	  7432:     move.b  #$08,D1
02:0003CA4A D101            	  7433:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA4C 19400001        	  7434:     move.b  D0,($0001,A4)
                            	  7435:     ; Only check the first bomb slot ($10).
                            	  7436:     ;
                            	  7437:     ; Store the bomb's (X + 8) in [02].
                            	  7438:     ;
02:0003CA50 7610            	  7439:     moveq   #16,D3
02:0003CA52 10343070        	  7440:     move.b  ($70,A4,D3.W),D0
02:0003CA56 123C0008        	  7441:     move.b  #$08,D1
02:0003CA5A D101            	  7442:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA5C 19400002        	  7443:     move.b  D0,($0002,A4)
                            	  7444:     ; Store the bomb's (Y + 8) in [03].
                            	  7445:     ;
02:0003CA60 41EC0084        	  7446:     lea     ($0084,A4),A0
02:0003CA64 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003CA68 123C0008        	  7448:     move.b  #$08,D1
02:0003CA6C D101            	  7449:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA6E 19400003        	  7450:     move.b  D0,($0003,A4)
                            	  7451:     ; But, if there's no bomb, then return.
                            	  7452:     ;
02:0003CA72 41EC00AC        	  7453:     lea     ($00AC,A4),A0
02:0003CA76 10303000        	  7454:     move.b  (A0,D3.W),D0
02:0003CA7A 6720            	  7455:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7456:     ; If the bomb has not exploded (state $12), then
                            	  7457:     ; go see if Dodongo will eat it.
