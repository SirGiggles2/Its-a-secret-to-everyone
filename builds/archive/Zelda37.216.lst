02:0004AF76 122C0004        	  2111:     move.b  ($0004,A4),D1
02:0004AF7A D101            	  2112:     addx.b  D1,D0   ; ADC $04
02:0004AF7C 4A02            	  2113:     cmpi.b  #$00,D2
