02:000364E6 7000            	  5045:     moveq   #0,D0
02:000364E8 6508            	  5046:     bcs  _anon_z02_39
02:000364EA 194000FC        	  5047:     move.b  D0,($00FC,A4)
02:000364EE 522C00E2        	  5048:     addq.b  #1,($00E2,A4)
                            	  5049: _anon_z02_39:
                            	  5050:     ; Roll the carry from the comparison above into bit 0.
                            	  5051:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5052:     ;
