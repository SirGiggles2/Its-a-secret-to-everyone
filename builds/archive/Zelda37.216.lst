                            	  5435:     ;
02:0004C6EC 41EC0098        	  5436:     lea     ($0098,A4),A0
02:0004C6F0 10302000        	  5437:     move.b  (A0,D2.W),D0
02:0004C6F4 0C0000E8        	  5438:     cmpi.b  #$E8,D0
