02:0003F544 003C0011        	 13292:     ori     #$11,CCR  ; SEC: set C+X
02:0003F548 41EC0478        	 13293:     lea     ($0478,A4),A0
02:0003F54C 12302000        	 13294:     move.b  (A0,D2.W),D1
02:0003F550 0A3C0010        	 13295:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F554 9101            	 13296:     subx.b  D1,D0   ; SBC Ganon_ObjCloudDist,X
02:0003F556 0A3C0010        	 13297:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F55A 19400001        	 13298:     move.b  D0,($0001,A4)
02:0003F55E 0A3C0001        	 13299:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F562 4E75            	 13300:     rts
                            	 13301: 
                            	 13302: ; Returns:
                            	 13303: ; [01]: Y coordinate
                            	 13304: ;
