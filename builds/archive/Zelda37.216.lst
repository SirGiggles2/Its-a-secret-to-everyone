                            	  6097: CalcBoomerangFrame:
                            	  6098:     ; The minor state (low 3 bits of state) is used to
                            	  6099:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  6100:     ;
                            	  6101:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  6102:     ; In other words, don't offset the coordinate below.
                            	  6103:     ;
02:0004CB7E 7000            	  6104:     moveq   #0,D0
02:0004CB80 1880            	  6105:     move.b  D0,($0000,A4)
02:0004CB82 41EC00AC        	  6106:     lea     ($00AC,A4),A0
02:0004CB86 10302000        	  6107:     move.b  (A0,D2.W),D0
02:0004CB8A 0200000F        	  6108:     andi.b #$0F,D0
02:0004CB8E 7600            	  6109:     moveq   #0,D3
02:0004CB90 1600            	  6110:     move.b  D0,D3
02:0004CB92 7000            	  6111:     moveq   #0,D0
02:0004CB94 19400001        	  6112:     move.b  D0,($0001,A4)
02:0004CB98 41F90004C786    	  6113:     lea     (BoomerangFrameCycle).l,A0
02:0004CB9E 10303000        	  6114:     move.b  (A0,D3.W),D0
02:0004CBA2 1940000C        	  6115:     move.b  D0,($000C,A4)
                            	  6116:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  6117:     ;
02:0004CBA6 1003            	  6118:     move.b  D3,D0
02:0004CBA8 41F90004C790    	  6119:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004CBAE 10303000        	  6120:     move.b  (A0,D3.W),D0
02:0004CBB2 19400004        	  6121:     move.b  D0,($0004,A4)
                            	  6122:     ; TODO: ?
                            	  6123:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  6124:     ; Else add the item value of the magic boomerang.
                            	  6125:     ;
                            	  6126:     ; But none of the values in the base sprite attributes array is 8.
                            	  6127:     ;
                            	  6128:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  6129:     ; the inventory will always be added to the base sprite attribute.
                            	  6130:     ;
                            	  6131:     ; So, palette row 4 or 5 will be chosen.
                            	  6132:     ;
02:0004CBB6 7600            	  6133:     moveq   #0,D3
02:0004CBB8 0C000008        	  6134:     cmpi.b  #$08,D0
02:0004CBBC 6706            	  6135:     beq  _anon_z07_31
02:0004CBBE 7600            	  6136:     moveq   #0,D3
02:0004CBC0 162C0675        	  6137:     move.b  ($0675,A4),D3
                            	  6138: _anon_z07_31:
