                            	   223: UpdateMenuCommon1:
02:000401A4 4EB90004AC8C    	   224:     jsr     HideAllSprites
02:000401AA 4EB900030CF6    	   225:     jsr     UpdatePlayerPositionMarker
02:000401B0 4EB90004ADA8    	   226:     jsr     UpdateTriforcePositionMarker
                            	   227:     ; Move position markers and hardware vertical scroll position
                            	   228:     ; down 1 pixel.
                            	   229:     ;
                            	   230:     ; Because we'll be above the top of NT 0, switch to NT 2 to
                            	   231:     ; be at the bottom of NT 2.
                            	   232:     ;
02:000401B6 103C00EF        	   233:     move.b  #$EF,D0
02:000401BA 194000FC        	   234:     move.b  D0,($00FC,A4)
02:000401BE 1940005C        	   235:     move.b  D0,($005C,A4)
02:000401C2 7001            	   236:     moveq   #1,D0
02:000401C4 610001A2        	   237:     jsr     MovePositionMarkers
02:000401C8 522C00E1        	   238:     addq.b  #1,($00E1,A4)
                            	   239:     ; SubmenuScrollProgress begins at $2B. Each frame it will be
                            	   240:     ; decremented. It encodes a submenu row index in bits 1 to 7,
                            	   241:     ; and a flag in bit 0.
                            	   242:     ;
                            	   243:     ; When the flag is 1, a full row of black tiles will be transferred
                            	   244:     ; at the current row. Otherwise, one of various static visual
                            	   245:     ; elements will be transferred.
                            	   246:     ;
                            	   247:     ; For example:
                            	   248:     ; 1. In the first frame of scrolling, $2B indicates that a full row
                            	   249:     ;    of black tiles must be transferred to row $15.
                            	   250:     ; 2. In the second frame ($2A), submenu row will again be
                            	   251:     ;    $15, but something else will be transferred.
                            	   252:     ; 3. In the third frame ($29), a full row of black tiles will be
                            	   253:     ;    transferred to row $14.
                            	   254:     ;
02:000401CC 702B            	   255:     moveq   #43,D0
02:000401CE 1940005E        	   256:     move.b  D0,($005E,A4)
                            	   257:     ; In UW, this variable will be used to scan every room in order
                            	   258:     ; to build the big sheet map in the submenu. It will range
                            	   259:     ; from $7F to 0.
                            	   260:     ;
02:000401D2 707F            	   261:     moveq   #127,D0
02:000401D4 1940005D        	   262:     move.b  D0,($005D,A4)
                            	   263:     even
                            	   264: UpdateMenu_Return:
02:000401D8 4E75            	   265:     rts
                            	   266: 
                            	   267:     even
                            	   268: UpdateMenuCommon2:
                            	   269:     ; Cue the transfer of first set of submenu nametable attributes to NT 2.
                            	   270:     ; Advance state.
                            	   271:     ;
02:000401DA 7048            	   272:     moveq   #72,D0
                            	   273:     even
                            	   274: SelectTransferBufAndIncState:
02:000401DC 19400014        	   275:     move.b  D0,($0014,A4)
                            	   276: _anon_z05_1:
02:000401E0 522C00E1        	   277:     addq.b  #1,($00E1,A4)
02:000401E4 4E75            	   278:     rts
                            	   279: 
                            	   280:     even
                            	   281: UpdateMenuCommon3:
                            	   282:     ; Cue the transfer of second set of submenu nametable attributes to NT 2.
                            	   283:     ; Advance state.
                            	   284:     ;
02:000401E6 704A            	   285:     moveq   #74,D0
02:000401E8 6702            	   286:     beq.s  __far_z_05_0000
02:000401EA 60F0            	   287:     jmp  SelectTransferBufAndIncState
                            	   288: __far_z_05_0000:
