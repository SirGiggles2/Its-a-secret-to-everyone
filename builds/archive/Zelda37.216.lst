02:0004CB6C 41EC03D0        	  6091:     lea     ($03D0,A4),A0
02:0004CB70 11802000        	  6092:     move.b  D0,(A0,D2.W)
02:0004CB74 7020            	  6093:     moveq   #32,D0
02:0004CB76 41EC00AC        	  6094:     lea     ($00AC,A4),A0
