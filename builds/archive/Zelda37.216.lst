02:0002DD42 41EC046F        	   411:     lea     ($046F,A4),A0
02:0002DD46 10303000        	   412:     move.b  (A0,D3.W),D0
02:0002DD4A 41EC0448        	   413:     lea     ($0448,A4),A0
02:0002DD4E 11802000        	   414:     move.b  D0,(A0,D2.W)
02:0002DD52 5302            	   415:     subq.b  #1,D2
02:0002DD54 6AE2            	   416:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
