02:00031CDC 19400006        	  7061:     move.b  D0,($0006,A4)
                            	  7062:     ; If the weapon's not active (state = 0), then return.
                            	  7063:     ;
02:00031CE0 7600            	  7064:     moveq   #0,D3
02:00031CE2 1614            	  7065:     move.b  ($0000,A4),D3
02:00031CE4 41EC00AC        	  7066:     lea     ($00AC,A4),A0
02:00031CE8 10303000        	  7067:     move.b  (A0,D3.W),D0
02:00031CEC 6604            	  7068:     bne.s  __far_z_01_0071
02:00031CEE 6000010C        	  7069:     jmp  L74D8_Exit
