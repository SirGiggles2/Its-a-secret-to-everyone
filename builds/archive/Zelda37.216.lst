                            	  3269: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3270:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3271:     ; the mound frame images:
                            	  3272:     ;
                            	  3273:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3274:     ;
                            	  3275:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3276:     ;
                            	  3277:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3278:     ;
02:0003AC30 003C0011        	  3279:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC34 123C0001        	  3280:     move.b  #$01,D1
02:0003AC38 0A3C0010        	  3281:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC3C 9101            	  3282:     subx.b  D1,D0   ; SBC #$01
02:0003AC3E 0A3C0010        	  3283:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC42 E308            	  3284:     lsl.b  #1,D0   ; ASL A
02:0003AC44 023C00EE        	  3285:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC48 41EC03E4        	  3286:     lea     ($03E4,A4),A0
02:0003AC4C 12302000        	  3287:     move.b  (A0,D2.W),D1
02:0003AC50 D101            	  3288:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  3289:     even
