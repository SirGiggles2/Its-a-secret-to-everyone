                            	  5154: DrawCredits:
                            	  5155:     ; Make a transfer record of a full row of blank tiles.
                            	  5156:     ;
02:0003673C 761F            	  5157:     moveq   #31,D3
02:0003673E 7024            	  5158:     moveq   #36,D0
                            	  5159: _anon_z02_41:
02:00036740 41EC0305        	  5160:     lea     ($0305,A4),A0
02:00036744 11803000        	  5161:     move.b  D0,(A0,D3.W)
02:00036748 5303            	  5162:     subq.b  #1,D3
02:0003674A 6AF4            	  5163:     bpl  _anon_z02_41
                            	  5164:     ; No wall tiles go in row 0.
                            	  5165:     ;
02:0003674C 102C050A        	  5166:     move.b  ($050A,A4),D0
02:00036750 672C            	  5167:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5168:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5169:     ; Rows 2 to $2D get side walls.
                            	  5170:     ;
02:00036752 0C000001        	  5171:     cmpi.b  #$01,D0
02:00036756 6708            	  5172:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036758 0C00002E        	  5173:     cmpi.b  #$2E,D0
02:0003675C 6514            	  5174:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:0003675E 661E            	  5175:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5176:     even
