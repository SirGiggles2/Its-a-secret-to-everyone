02:0003CA7C 0C000012        	  7459:     cmpi.b  #$12,D0
02:0003CA80 6602            	  7460:     bne.s  __far_z_04_0070
02:0003CA82 601A            	  7461:     jmp  Dodongo_TryEatBomb
                            	  7462: __far_z_04_0070:
                            	  7463:     ; If the object in the slot is actually a fire, then return.
                            	  7464:     ;
02:0003CA84 0C000020        	  7465:     cmpi.b  #$20,D0
02:0003CA88 6412            	  7466:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7467:     ; The bomb already blew up.
