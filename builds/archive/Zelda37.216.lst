                            	  8586: 
                            	  8587: ; Description:
                            	  8588: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8589: ; When walking, the object timer is set. When teleporting,
                            	  8590: ; the teleporting distance remaining is set.
                            	  8591: ;
                            	  8592: ; If we have the magic clock, then only go draw and check collisions.
                            	  8593: ;
                            	  8594:     even
                            	  8595: UpdateBlueWizzrobe:
02:0003D2C4 102C066C        	  8596:     move.b  ($066C,A4),D0
02:0003D2C8 6702            	  8597:     beq.s  __far_z_04_0075
02:0003D2CA 6014            	  8598:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8599: __far_z_04_0075:
02:0003D2CC 6116            	  8600:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D2CE 61000334        	  8601:     jsr     BlueWizzrobe_TryShooting
                            	  8602:     even
                            	  8603: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8604:     ; If the teleporting distance remaining is even, then draw
                            	  8605:     ; and check collisions, else return.
                            	  8606:     ;
                            	  8607:     ; This means that when 0, the monster is walking.
                            	  8608:     ; So, draw and check collisions every frame.
                            	  8609:     ;
                            	  8610:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8611:     ; translucently -- every other frame.
                            	  8612:     ;
02:0003D2D2 41EC0394        	  8613:     lea     ($0394,A4),A0
02:0003D2D6 10302000        	  8614:     move.b  (A0,D2.W),D0
02:0003D2DA E208            	  8615:     lsr.b  #1,D0   ; LSR A
02:0003D2DC 6402            	  8616:     bcc.s  __far_z_04_0076
02:0003D2DE 603A            	  8617:     jmp  L11E17_Exit
                            	  8618: __far_z_04_0076:
                            	  8619:     even
