                            	  6309: _anon_z05_122:
                            	  6310:     ; If the door command = 4 after incrementing it, then
                            	  6311:     ; it was 3 (close door). So:
                            	  6312:     ; 1. reset this door's flag
                            	  6313:     ; 2. remove it from the opened door mask
                            	  6314:     ; 3. reset the door command
                            	  6315:     ; 4. go lay out doors in the play area map
                            	  6316:     ;
02:00043BBE 102C0054        	  6317:     move.b  ($0054,A4),D0
02:00043BC2 0C000004        	  6318:     cmpi.b  #$04,D0
02:00043BC6 6626            	  6319:     bne  _anon_z05_123
02:00043BC8 7400            	  6320:     moveq   #0,D2
02:00043BCA 142C0009        	  6321:     move.b  ($0009,A4),D2
02:00043BCE 6100DACC        	  6322:     jsr     ResetDoorFlag
02:00043BD2 102C0055        	  6323:     move.b  ($0055,A4),D0
02:00043BD6 0A00000F        	  6324:     eori.b #$0F,D0
02:00043BDA 122C00EE        	  6325:     move.b  ($00EE,A4),D1
02:00043BDE C001            	  6326:     and.b  D1,D0
                            	  6327:     even
