                            	  6864:     ; Flag collision with [0C], even though [06] was already set.
                            	  6865:     ;
02:00031B76 522C000C        	  6866:     addq.b  #1,($000C,A4)
                            	  6867:     ; Unpack the damage points for the monster's type.
                            	  6868:     ; The low nibble is the high byte.
                            	  6869:     ; (Damage points byte AND $F0) is the low byte.
                            	  6870:     ;
02:00031B7A 7600            	  6871:     moveq   #0,D3
02:00031B7C 41EC034F        	  6872:     lea     ($034F,A4),A0
02:00031B80 16302000        	  6873:     move.b  (A0,D2.W),D3
02:00031B84 41F9000319E6    	  6874:     lea     (ObjTypeToDamagePoints).l,A0
02:00031B8A 10303000        	  6875:     move.b  (A0,D3.W),D0
02:00031B8E 1B00            	  6876:     move.b  D0,-(A5)  ; PHA
02:00031B90 0200000F        	  6877:     andi.b #$0F,D0
02:00031B94 1940000D        	  6878:     move.b  D0,($000D,A4)
02:00031B98 101D            	  6879:     move.b  (A5)+,D0  ; PLA
02:00031B9A 020000F0        	  6880:     andi.b #$F0,D0
02:00031B9E 1940000E        	  6881:     move.b  D0,($000E,A4)
                            	  6882: ; Params:
                            	  6883: ; X: object index of the attacker
                            	  6884: ; [0D]: damage points high byte
                            	  6885: ; [0E]: damage points low byte
                            	  6886: ;
                            	  6887: ;
                            	  6888: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6889: ;
                            	  6890:     even
                            	  6891: Link_BeHarmed:
