                            	  6031:     ; Chase while flying, as usual.
                            	  6032:     ;
02:0003C03C 61003D36        	  6033:     jsr     Flyer_Chase
                            	  6034:     ; If timer has not expired, then
                            	  6035:     ; go see if it's time to propagate direction changes down the chain.
                            	  6036:     ;
02:0003C040 10342028        	  6037:     move.b  ($28,A4,D2.W),D0
02:0003C044 6702            	  6038:     beq.s  __far_z_04_0045
02:0003C046 6032            	  6039:     jmp  Moldorm_PropagateDirs
                            	  6040: __far_z_04_0045:
                            	  6041:     even
                            	  6042: Moldorm_ChangeFlyingState:
                            	  6043:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  6044:     ;
02:0003C048 61000096        	  6045:     jsr     Flyer_MoldormDecideState
02:0003C04C 7010            	  6046:     moveq   #16,D0
02:0003C04E 19802028        	  6047:     move.b  D0,($28,A4,D2.W)
                            	  6048:     ; If the next lower slot's direction <> 0, then
                            	  6049:     ; go propagate direction changes down the chain.
                            	  6050:     ;
                            	  6051:     ; But you had to have propagated directions once for the
                            	  6052:     ; next lower direction to be set. How does it happen?
                            	  6053:     ;
                            	  6054:     ; Within a flyer state, the flying routines turn the flyer
                            	  6055:     ; and set the object timer to $10 several times. After any of
                            	  6056:     ; those times will the test succeed.
                            	  6057:     ;
                            	  6058:     ; When a flying state ends, timer will be 0, triggering the code
                            	  6059:     ; in this block to set the timer to $10, and try to propagate
                            	  6060:     ; directions.
                            	  6061:     ;
                            	  6062:     ; But this is also the case the first time here.
                            	  6063:     ;
                            	  6064:     ; So, I believe that the point of this test is to delay moving
                            	  6065:     ; the lower (not head) segments when starting out.
                            	  6066:     ;
02:0003C052 41EC0097        	  6067:     lea     ($0097,A4),A0
02:0003C056 10302000        	  6068:     move.b  (A0,D2.W),D0
02:0003C05A 6702            	  6069:     beq.s  __far_z_04_0046
02:0003C05C 601C            	  6070:     jmp  Moldorm_PropagateDirs
                            	  6071: __far_z_04_0046:
02:0003C05E 4E75            	  6072:     rts
                            	  6073: 
                            	  6074:     even
                            	  6075: Moldorm_Wander:
                            	  6076:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6077:     ; Only the head controls the movement direction.
                            	  6078:     ;
02:0003C060 0C020005        	  6079:     cmpi.b  #$05,D2
02:0003C064 6708            	  6080:     beq  _anon_z04_82
02:0003C066 0C02000A        	  6081:     cmpi.b  #$0A,D2
02:0003C06A 6702            	  6082:     beq.s  __far_z_04_0047
02:0003C06C 6070            	  6083:     jmp  L1156B_Exit
                            	  6084: __far_z_04_0047:
                            	  6085: _anon_z04_82:
                            	  6086:     ; Turn randomly while flying, as usual.
                            	  6087:     ;
02:0003C06E 61003DE2        	  6088:     jsr     Flyer_Wander
                            	  6089:     ; After every turn, the common flyer routines set timer to $10.
                            	  6090:     ; This can be used as a signal for moldorm to propagate
                            	  6091:     ; direction changes down the chain.
                            	  6092:     ;
                            	  6093:     ; Between each turn, timer <> $10.
                            	  6094:     ;
                            	  6095:     ; At the end of the delay after the last turn, timer = 0.
                            	  6096:     ; This is a signal that that flying state ended, and a new one
                            	  6097:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6098:     ; we can propagate direction changes again; and start
                            	  6099:     ; a new flying interval by setting timer to $10. This will make
                            	  6100:     ; the next flying state delay that amount of time before turning
                            	  6101:     ; the first time.
                            	  6102:     ;
                            	  6103:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6104:     ; arm the timer again, and shift directions down the chain.
                            	  6105:     ;
02:0003C072 10342028        	  6106:     move.b  ($28,A4,D2.W),D0
02:0003C076 6602            	  6107:     bne.s  __far_z_04_0048
02:0003C078 60CE            	  6108:     jmp  Moldorm_ChangeFlyingState
                            	  6109: __far_z_04_0048:
                            	  6110:     even
                            	  6111: Moldorm_PropagateDirs:
                            	  6112:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6113:     ;
02:0003C07A 10342028        	  6114:     move.b  ($28,A4,D2.W),D0
02:0003C07E 0C000010        	  6115:     cmpi.b  #$10,D0
02:0003C082 6702            	  6116:     beq.s  __far_z_04_0049
02:0003C084 6058            	  6117:     jmp  L1156B_Exit
                            	  6118: __far_z_04_0049:
                            	  6119:     ; Timer = $10.
                            	  6120:     ;
                            	  6121:     ; If deferred bounce direction <> 0, then
                            	  6122:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  6123:     ;
02:0003C086 41EC03BC        	  6124:     lea     ($03BC,A4),A0
02:0003C08A 10302000        	  6125:     move.b  (A0,D2.W),D0
02:0003C08E 6712            	  6126:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C090 41EC0098        	  6127:     lea     ($0098,A4),A0
02:0003C094 11802000        	  6128:     move.b  D0,(A0,D2.W)
02:0003C098 7000            	  6129:     moveq   #0,D0
