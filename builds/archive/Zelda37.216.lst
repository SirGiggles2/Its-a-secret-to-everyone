                            	  4965: 
                            	  4966: ; Params:
                            	  4967: ; [02:03]: address of door tiles for direction and face
                            	  4968: ; [04]: count of tiles remaining
                            	  4969: ; [07]: current index (0 to 3) of the tile to copy
                            	  4970: ;       to the dynamic transfer buf
                            	  4971: ; [09]: door direction index
                            	  4972: ;
                            	  4973: ; Returns:
                            	  4974: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4975: ; [04]: original value - 1
                            	  4976: ; [07]: original value + 1
                            	  4977: ;
                            	  4978: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4979: ; vertically. The point of this routine is to access them
                            	  4980: ; horizontally in order to transfer them to a nametable.
                            	  4981: ;
                            	  4982: ;
                            	  4983: ; For the direction index in [09], look up the base offset of the
                            	  4984: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4985: ; the door face tiles at [02:03].
                            	  4986: ;
                            	  4987:     even
                            	  4988: WriteDoorFaceTileHorizontally:
02:0004289C 7600            	  4989:     moveq   #0,D3
02:0004289E 162C0009        	  4990:     move.b  ($0009,A4),D3
02:000428A2 41F900043AC0    	  4991:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000428A8 10303000        	  4992:     move.b  (A0,D3.W),D0
                            	  4993:     ; Add [07] to the base offset we got above. This yields one
                            	  4994:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4995:     ;
02:000428AC 023C00EE        	  4996:     andi    #$EE,CCR  ; CLC: clear C+X
02:000428B0 122C0007        	  4997:     move.b  ($0007,A4),D1
02:000428B4 D101            	  4998:     addx.b  D1,D0   ; ADC $07
02:000428B6 7600            	  4999:     moveq   #0,D3
02:000428B8 1600            	  5000:     move.b  D0,D3
                            	  5001:     ; With that index, look up the index to use with the door face
                            	  5002:     ; list of tiles at [02:03].
                            	  5003:     ;
02:000428BA 41F900043AB2    	  5004:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000428C0 10303000        	  5005:     move.b  (A0,D3.W),D0
02:000428C4 7600            	  5006:     moveq   #0,D3
02:000428C6 1600            	  5007:     move.b  D0,D3
                            	  5008:     ; Now we can read one of four tiles inside a door face tile map,
                            	  5009:     ; and copy it to the dynamic transfer buf.
                            	  5010:     ;
02:000428C8 122C0002        	  5011:     move.b  ($02,A4),D1   ; ptr lo
02:000428CC 182C0003        	  5012:     move.b  ($03,A4),D4  ; ptr hi
02:000428D0 024100FF        	  5013:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000428D4 E14C            	  5014:     lsl.w   #8,D4
02:000428D6 8841            	  5015:     or.w    D1,D4             ; D4 = NES ptr addr
02:000428D8 48C4            	  5016:     ext.l   D4
02:000428DA D8BC00FF0000    	  5017:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000428E0 2044            	  5018:     movea.l D4,A0
