02:0002FBBA 0C030040        	  2410:     cmpi.b  #$40,D3
02:0002FBBE 6638            	  2411:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FBC0 7600            	  2412:     moveq   #0,D3
02:0002FBC2 162C0522        	  2413:     move.b  ($0522,A4),D3
02:0002FBC6 6730            	  2414:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2415:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2416:     ;
                            	  2417:     ; Set Link's X to whirlwind's.
                            	  2418:     ;
02:0002FBC8 19400070        	  2419:     move.b  D0,($0070,A4)
                            	  2420:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2421:     ; the right screen edge and draw.
                            	  2422:     ;
02:0002FBCC 5303            	  2423:     subq.b  #1,D3
02:0002FBCE 6776            	  2424:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FBD0 0C000080        	  2425:     cmpi.b  #$80,D0
02:0002FBD4 6670            	  2426:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2427:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2428:     ;
                            	  2429:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2430:     ;
02:0002FBD6 E308            	  2431:     lsl.b  #1,D0   ; ASL A
02:0002FBD8 194000AC        	  2432:     move.b  D0,($00AC,A4)
02:0002FBDC 19400522        	  2433:     move.b  D0,($0522,A4)
02:0002FBE0 41EC034F        	  2434:     lea     ($034F,A4),A0
02:0002FBE4 11802000        	  2435:     move.b  D0,(A0,D2.W)
                            	  2436:     ; Update the player position marker, and draw one last time.
                            	  2437:     ;
02:0002FBE8 1002            	  2438:     move.b  D2,D0
02:0002FBEA 1B00            	  2439:     move.b  D0,-(A5)  ; PHA
02:0002FBEC 61001108        	  2440:     jsr     UpdatePlayerPositionMarker
02:0002FBF0 101D            	  2441:     move.b  (A5)+,D0  ; PLA
02:0002FBF2 7400            	  2442:     moveq   #0,D2
02:0002FBF4 1400            	  2443:     move.b  D0,D2
02:0002FBF6 6070            	  2444:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2445: 
