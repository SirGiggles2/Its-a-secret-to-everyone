02:00041F90 12302000        	  3786:     move.b  (A0,D2.W),D1
02:00041F94 B001            	  3787:     cmp.b   D1,D0
02:00041F96 6648            	  3788:     bne  _L_z05_CheckLadder_StashLadder
02:00041F98 102C0070        	  3789:     move.b  ($0070,A4),D0
02:00041F9C 003C0011        	  3790:     ori     #$11,CCR  ; SEC: set C+X
02:00041FA0 12342070        	  3791:     move.b  ($70,A4,D2.W),D1
02:00041FA4 0A3C0010        	  3792:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041FA8 9101            	  3793:     subx.b  D1,D0   ; SBC ObjX,X
02:00041FAA 0A3C0010        	  3794:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3795:     even
                            	  3796: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3797:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3798:     ; If > $10, go put the ladder away.
                            	  3799:     ;
02:00041FAE 4EB9000309B8    	  3800:     jsr     Abs
02:00041FB4 1880            	  3801:     move.b  D0,($0000,A4)
02:00041FB6 0C000010        	  3802:     cmpi.b  #$10,D0
02:00041FBA 6532            	  3803:     bcs  _L_z05_CheckLadder_SetState2
02:00041FBC 0C000010        	  3804:     cmpi.b  #$10,D0
02:00041FC0 661E            	  3805:     bne  _L_z05_CheckLadder_StashLadder
                            	  3806:     ; Distance = $10. If player's not facing in the same direction as
                            	  3807:     ; the ladder, go put away the ladder.
                            	  3808:     ;
02:00041FC2 102C0098        	  3809:     move.b  ($0098,A4),D0
02:00041FC6 41EC0098        	  3810:     lea     ($0098,A4),A0
02:00041FCA 12302000        	  3811:     move.b  (A0,D2.W),D1
02:00041FCE B001            	  3812:     cmp.b   D1,D0
02:00041FD0 660E            	  3813:     bne  _L_z05_CheckLadder_StashLadder
                            	  3814:     ; Distance = $10, and player's facing in the same direction.
                            	  3815:     ;
                            	  3816:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3817:     ; ladder and had not stepped onto it yet.
                            	  3818:     ; Go handle movement on it, but don't change state yet.
                            	  3819:     ;
                            	  3820:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3821:     ; off of the ladder. So the ladder should be put away. In this
                            	  3822:     ; case, fall thru.
                            	  3823:     ;
02:00041FD2 41EC00AC        	  3824:     lea     ($00AC,A4),A0
02:00041FD6 10302000        	  3825:     move.b  (A0,D2.W),D0
02:00041FDA 0C000001        	  3826:     cmpi.b  #$01,D0
02:00041FDE 6718            	  3827:     beq  _L_z05_CheckLadder_HandleInput
                            	  3828:     even
                            	  3829: _L_z05_CheckLadder_StashLadder:
                            	  3830:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3831:     ;
02:00041FE0 7000            	  3832:     moveq   #0,D0
02:00041FE2 19400064        	  3833:     move.b  D0,($0064,A4)
02:00041FE6 4EB90004DAD0    	  3834:     jsr     DestroyMonster
                            	  3835:     even
                            	  3836: _L_z05_CheckLadder_Exit:
02:00041FEC 4E75            	  3837:     rts
                            	  3838: 
                            	  3839:     even
                            	  3840: _L_z05_CheckLadder_SetState2:
                            	  3841:     ;  Set state 2, because we're on the ladder.
                            	  3842:     ;
02:00041FEE 7002            	  3843:     moveq   #2,D0
02:00041FF0 41EC00AC        	  3844:     lea     ($00AC,A4),A0
02:00041FF4 11802000        	  3845:     move.b  D0,(A0,D2.W)
                            	  3846:     even
                            	  3847: _L_z05_CheckLadder_HandleInput:
                            	  3848:     ; If input direction = 0, go draw and reset moving direction.
                            	  3849:     ;
02:00041FF8 102C03F8        	  3850:     move.b  ($03F8,A4),D0
02:00041FFC 67000086        	  3851:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3852:     ; Input direction <> 0. The player intends to move.
                            	  3853:     ; So, see if we need to override the moving direction.
                            	  3854:     ;
                            	  3855:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3856:     ; go draw and set moving direction to Link's direction.
                            	  3857:     ;
                            	  3858:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3859:     ; been blocked by the water.
                            	  3860:     ;
                            	  3861:     ; Or, Link already passed over the point right over the ladder
                            	  3862:     ; and was allowed to move onto the tiles after the ladder.
                            	  3863:     ;
02:00042000 102C0098        	  3864:     move.b  ($0098,A4),D0
02:00042004 7600            	  3865:     moveq   #0,D3
02:00042006 1614            	  3866:     move.b  ($0000,A4),D3
02:00042008 670C            	  3867:     beq  _anon_z05_86
02:0004200A 41EC0098        	  3868:     lea     ($0098,A4),A0
02:0004200E 12302000        	  3869:     move.b  (A0,D2.W),D1
02:00042012 B001            	  3870:     cmp.b   D1,D0
02:00042014 676E            	  3871:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3872: _anon_z05_86:
                            	  3873:     ; Distance = 0, or facing different directions.
                            	  3874:     ;
                            	  3875:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3876:     ; then go draw and keep moving.
                            	  3877:     ;
                            	  3878:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3879:     ;
                            	  3880:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3881:     ; to move onto the tiles after the ladder.
                            	  3882:     ;
                            	  3883:     ; Note that if Link is not moving, then this test will fail,
                            	  3884:     ; and case (D) will catch it.
                            	  3885:     ;
02:00042016 41EC0098        	  3886:     lea     ($0098,A4),A0
02:0004201A 10302000        	  3887:     move.b  (A0,D2.W),D0
02:0004201E 122C000F        	  3888:     move.b  ($000F,A4),D1
02:00042022 B001            	  3889:     cmp.b   D1,D0
02:00042024 675E            	  3890:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3891:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3892:     ; then go draw and move in ladder's direction.
                            	  3893:     ;
                            	  3894:     ; You can always step off the ladder where you came from.
                            	  3895:     ;
02:00042026 4EB9000309B4    	  3896:     jsr     GetOppositeDir
02:0004202C 122C0098        	  3897:     move.b  ($0098,A4),D1
02:00042030 B001            	  3898:     cmp.b   D1,D0
02:00042032 6750            	  3899:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3900:     ; D. If opposite of ladder's direction <> down,
                            	  3901:     ; or input direction <> up,
                            	  3902:     ; then go reset moving direction, and draw.
                            	  3903:     ;
                            	  3904:     ; This will catch all cases of Link facing perpendicular to
                            	  3905:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3906:     ; ladder direction is up and input direction is up (E).
                            	  3907:     ;
02:00042034 0C000004        	  3908:     cmpi.b  #$04,D0
02:00042038 6648            	  3909:     bne  _anon_z05_87
02:0004203A 102C03F8        	  3910:     move.b  ($03F8,A4),D0
02:0004203E 0C000008        	  3911:     cmpi.b  #$08,D0
02:00042042 663E            	  3912:     bne  _anon_z05_87
                            	  3913:     ; E. The ladder's direction is up and input direction is up.
                            	  3914:     ;
                            	  3915:     ; An earlier call to check tile collision would have blocked
                            	  3916:     ; movement, because the tile under Link's top half is a water tile.
                            	  3917:     ; But because Link is squarely on the ladder, we really have
                            	  3918:     ; to check the tile above that one.
                            	  3919:     ;
                            	  3920:     ; Set moving direction to input direction (up) and switch X to
                            	  3921:     ; the player's slot for the purpose of checking tile collision below.
                            	  3922:     ; Based on that, we'll set moving direction according to walkability.
                            	  3923:     ;
02:00042044 6158            	  3924:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3925:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3926:     ;
02:00042046 102C0084        	  3927:     move.b  ($0084,A4),D0
02:0004204A 1B00            	  3928:     move.b  D0,-(A5)  ; PHA
02:0004204C 003C0011        	  3929:     ori     #$11,CCR  ; SEC: set C+X
02:00042050 123C0008        	  3930:     move.b  #$08,D1
02:00042054 0A3C0010        	  3931:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042058 9101            	  3932:     subx.b  D1,D0   ; SBC #$08
02:0004205A 0A3C0010        	  3933:     eori    #$10,CCR  ; restore X = 6502 C
02:0004205E 19400084        	  3934:     move.b  D0,($0084,A4)
02:00042062 4EB90004BA32    	  3935:     jsr     GetCollidingTileMoving
02:00042068 101D            	  3936:     move.b  (A5)+,D0  ; PLA
02:0004206A 19400084        	  3937:     move.b  D0,($0084,A4)
                            	  3938:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3939:     ; direction as the input direction (in a roundabout way).
                            	  3940:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3941:     ;
02:0004206E 102C000F        	  3942:     move.b  ($000F,A4),D0
02:00042072 7600            	  3943:     moveq   #0,D3
02:00042074 162C049E        	  3944:     move.b  ($049E,A4),D3
02:00042078 122C034A        	  3945:     move.b  ($034A,A4),D1
02:0004207C B601            	  3946:     cmp.b   D1,D3
02:0004207E 6500FF78        	  3947:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3948: _anon_z05_87:
                            	  3949:     ; Set A to reset moving direction in [0F].
                            	  3950:     ;
02:00042082 7000            	  3951:     moveq   #0,D0
                            	  3952:     even
                            	  3953: _L_z05_CheckLadder_DrawLadder:
                            	  3954:     ; Draw the ladder.
                            	  3955:     ;
02:00042084 1B00            	  3956:     move.b  D0,-(A5)  ; PHA
02:00042086 7400            	  3957:     moveq   #0,D2
02:00042088 142C0064        	  3958:     move.b  ($0064,A4),D2
02:0004208C 4EB90004D2EC    	  3959:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00042092 760C            	  3960:     moveq   #12,D3
02:00042094 7000            	  3961:     moveq   #0,D0
02:00042096 4EB900031782    	  3962:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0004209C 101D            	  3963:     move.b  (A5)+,D0  ; PLA
                            	  3964: ; Params:
                            	  3965: ; A: direction
                            	  3966: ;
                            	  3967: ; Returns:
                            	  3968: ; [0F]: direction
                            	  3969: ;
                            	  3970:     even
                            	  3971: SetMovingDirAndSwitchToPlayerSlot:
02:0004209E 1940000F        	  3972:     move.b  D0,($000F,A4)
02:000420A2 7400            	  3973:     moveq   #0,D2
02:000420A4 4E75            	  3974:     rts
