                            	  3100:     ; Add the acceleration to the speed fraction (low byte).
                            	  3101:     ;
02:0003AAD8 41EC041F        	  3102:     lea     ($041F,A4),A0
02:0003AADC 10302000        	  3103:     move.b  (A0,D2.W),D0
02:0003AAE0 023C00EE        	  3104:     andi    #$EE,CCR  ; CLC: clear C+X
