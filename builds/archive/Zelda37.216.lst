02:0002E098 123C0014        	   893:     move.b  #$14,D1
02:0002E09C D101            	   894:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E09E 1940067E        	   895:     move.b  D0,($067E,A4)
                            	   896:     ; Mark this secret taken.
