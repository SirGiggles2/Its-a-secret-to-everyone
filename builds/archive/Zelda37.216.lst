02:0003B24E 1B00            	  4186:     move.b  D0,-(A5)  ; PHA
02:0003B250 194300AC        	  4187:     move.b  D3,($00AC,A4)
02:0003B254 4EB90004C200    	  4188:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4189:     ; Restore Link's state.
