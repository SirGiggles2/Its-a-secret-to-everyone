                            	  5982:     ; For all other provisional face values, calculate:
                            	  5983:     ; door face := provisional face - 3
02:00043972 003C0011        	  5984:     ori     #$11,CCR  ; SEC: set C+X
02:00043976 123C0003        	  5985:     move.b  #$03,D1
02:0004397A 0A3C0010        	  5986:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004397E 9101            	  5987:     subx.b  D1,D0   ; SBC #$03
02:00043980 0A3C0010        	  5988:     eori    #$10,CCR  ; restore X = 6502 C
02:00043984 7600            	  5989:     moveq   #0,D3
02:00043986 1600            	  5990:     move.b  D0,D3
