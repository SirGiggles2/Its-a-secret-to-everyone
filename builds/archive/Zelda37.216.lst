                            	  5850:     ; Begin looking for the door face for the door attribute.
                            	  5851:     ; In general, use the door type as the provisional face;
                            	  5852:     ; except turn 4 into 8.
                            	  5853:     ;
02:000438E2 0C000005        	  5854:     cmpi.b  #$05,D0
02:000438E6 642A            	  5855:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000438E8 0C000004        	  5856:     cmpi.b  #$04,D0
