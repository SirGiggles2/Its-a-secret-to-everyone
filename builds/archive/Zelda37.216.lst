                            	  5922: _L_z07_CheckState30_CheckOtherStates:
                            	  5923:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5924:     ;
                            	  5925:     ; The boomerang will now return. Reset the grid offset.
                            	  5926:     ;
02:0004CA28 7000            	  5927:     moveq   #0,D0
02:0004CA2A 41EC0394        	  5928:     lea     ($0394,A4),A0
02:0004CA2E 11802000        	  5929:     move.b  D0,(A0,D2.W)
                            	  5930:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5931:     ;
02:0004CA32 0C02000D        	  5932:     cmpi.b  #$0D,D2
02:0004CA36 6408            	  5933:     bcc  _anon_z07_30
02:0004CA38 41EC042C        	  5934:     lea     ($042C,A4),A0
02:0004CA3C 10302000        	  5935:     move.b  (A0,D2.W),D0
                            	  5936: _anon_z07_30:
02:0004CA40 4EB900030A0C    	  5937:     jsr     GetDirectionsAndDistancesToTarget
                            	  5938:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5939:     ; then go move towards the thrower, draw, and check collisions.
                            	  5940:     ;
02:0004CA46 1014            	  5941:     move.b  ($0000,A4),D0
02:0004CA48 0C000002        	  5942:     cmpi.b  #$02,D0
02:0004CA4C 666A            	  5943:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5944:     ; The boomerang has reached the thrower.
                            	  5945:     ;
                            	  5946:     ; Reset the distance to move.
                            	  5947:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5948:     ;
02:0004CA4E 7000            	  5949:     moveq   #0,D0
02:0004CA50 41EC0380        	  5950:     lea     ($0380,A4),A0
02:0004CA54 11802000        	  5951:     move.b  D0,(A0,D2.W)
02:0004CA58 0C02000D        	  5952:     cmpi.b  #$0D,D2
02:0004CA5C 6524            	  5953:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5954:     ; Link has caught the boomerang.
                            	  5955:     ;
                            	  5956:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5957:     ;
                            	  5958:     ; If Link catches it some time after throwing it,
                            	  5959:     ; his state will become $20, and he will show the catch animation.
                            	  5960:     ;
                            	  5961:     ; But if he catches it right after throwing it, the state becomes
                            	  5962:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5963:     ;
02:0004CA5E 102C00AC        	  5964:     move.b  ($00AC,A4),D0
02:0004CA62 00000020        	  5965:     ori.b #$20,D0
02:0004CA66 194000AC        	  5966:     move.b  D0,($00AC,A4)
                            	  5967:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5968:     ; up the new state.
                            	  5969:     ;
02:0004CA6A 7001            	  5970:     moveq   #1,D0
02:0004CA6C 194003D0        	  5971:     move.b  D0,($03D0,A4)
                            	  5972:     ; Deactivate the boomerang.
                            	  5973:     ;
02:0004CA70 760F            	  5974:     moveq   #15,D3
02:0004CA72 7000            	  5975:     moveq   #0,D0
02:0004CA74 41EC00AC        	  5976:     lea     ($00AC,A4),A0
02:0004CA78 11803000        	  5977:     move.b  D0,(A0,D3.W)
02:0004CA7C 0A3C0001        	  5978:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004CA80 4E75            	  5979:     rts
                            	  5980: 
                            	  5981:     even
                            	  5982: _L_z07_CheckState30_CatchBoomerang:
                            	  5983:     ; A monster caught the boomerang that it threw.
                            	  5984:     ;
                            	  5985:     ; Set a timer for the thrower based on a random value:
                            	  5986:     ; < $30: $30
