                            	 13335: Ganon_DrawBody:
                            	 13336:     ; Loop over four 16x16 images that make up Ganon.
                            	 13337:     ; There are 6 animation frames.
                            	 13338:     ;
02:0003F5A4 7603            	 13339:     moveq   #3,D3
                            	 13340:     even
                            	 13341: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13342:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13343:     ;
02:0003F5A6 10342070        	 13344:     move.b  ($70,A4,D2.W),D0
02:0003F5AA 023C00EE        	 13345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5AE 41F90003F598    	 13346:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F5B4 12303000        	 13347:     move.b  (A0,D3.W),D1
02:0003F5B8 D101            	 13348:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F5BA 1880            	 13349:     move.b  D0,($0000,A4)
                            	 13350:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13351:     ;
02:0003F5BC 41EC0084        	 13352:     lea     ($0084,A4),A0
02:0003F5C0 10302000        	 13353:     move.b  (A0,D2.W),D0
02:0003F5C4 023C00EE        	 13354:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5C8 41F90003F59C    	 13355:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F5CE 12303000        	 13356:     move.b  (A0,D3.W),D1
02:0003F5D2 D101            	 13357:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F5D4 19400001        	 13358:     move.b  D0,($0001,A4)
                            	 13359:     ; Each part has a horizontal flipping flag.
                            	 13360:     ;
02:0003F5D8 41F90003F5A0    	 13361:     lea     (GanonSpriteHFlips).l,A0
02:0003F5DE 10303000        	 13362:     move.b  (A0,D3.W),D0
02:0003F5E2 1940000F        	 13363:     move.b  D0,($000F,A4)
                            	 13364:     ; Save and copy the loop index (the current part) to [07].
                            	 13365:     ;
02:0003F5E6 1003            	 13366:     move.b  D3,D0
02:0003F5E8 1B00            	 13367:     move.b  D0,-(A5)  ; PHA
02:0003F5EA 19400007        	 13368:     move.b  D0,($0007,A4)
                            	 13369:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13370:     ; that make it up.
                            	 13371:     ;
02:0003F5EE 41EC046B        	 13372:     lea     ($046B,A4),A0
02:0003F5F2 10302000        	 13373:     move.b  (A0,D2.W),D0
02:0003F5F6 E308            	 13374:     lsl.b  #1,D0   ; ASL A
02:0003F5F8 E308            	 13375:     lsl.b  #1,D0   ; ASL A
                            	 13376:     ; Add [07] -- the index of the current part.
                            	 13377:     ;
                            	 13378:     ; Now you have an index into the frame image table, for the
                            	 13379:     ; current image part of the current animation frame.
                            	 13380:     ;
02:0003F5FA 122C0007        	 13381:     move.b  ($0007,A4),D1
02:0003F5FE D101            	 13382:     addx.b  D1,D0   ; ADC $07
02:0003F600 7600            	 13383:     moveq   #0,D3
02:0003F602 1600            	 13384:     move.b  D0,D3
02:0003F604 41F90003F580    	 13385:     lea     (GanonFrameImages).l,A0
02:0003F60A 10303000        	 13386:     move.b  (A0,D3.W),D0
02:0003F60E 4EB90003157E    	 13387:     jsr     DrawObjectNotMirrored
02:0003F614 101D            	 13388:     move.b  (A5)+,D0  ; PLA
                            	 13389:     ; Bottom of the part loop.
                            	 13390:     ;
02:0003F616 7600            	 13391:     moveq   #0,D3
02:0003F618 1600            	 13392:     move.b  D0,D3
02:0003F61A 5303            	 13393:     subq.b  #1,D3
02:0003F61C 6A88            	 13394:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F61E 4E75            	 13395:     rts
                            	 13396: 
                            	 13397:     even
                            	 13398: Ganon_CheckCollisions:
                            	 13399:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13400:     ; Store in [02] and [03].
                            	 13401:     ;
02:0003F620 10342070        	 13402:     move.b  ($70,A4,D2.W),D0
02:0003F624 023C00EE        	 13403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F628 123C0010        	 13404:     move.b  #$10,D1
02:0003F62C D101            	 13405:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F62E 19400002        	 13406:     move.b  D0,($0002,A4)
02:0003F632 41EC0084        	 13407:     lea     ($0084,A4),A0
02:0003F636 10302000        	 13408:     move.b  (A0,D2.W),D0
02:0003F63A 023C00EE        	 13409:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F63E 123C0010        	 13410:     move.b  #$10,D1
02:0003F642 D101            	 13411:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F644 19400003        	 13412:     move.b  D0,($0003,A4)
                            	 13413:     ; Check for a collision with Link.
                            	 13414:     ;
                            	 13415:     ; We can't call CheckLinkCollision, because we need to
                            	 13416:     ; customize Ganon's midpoint.
                            	 13417:     ;
                            	 13418:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13419:     ; detection, if Link is invincible. Initialize variables that will
                            	 13420:     ; be returned from the partial collision check routine. Then
                            	 13421:     ; call it.
                            	 13422:     ;
02:0003F648 102C04F0        	 13423:     move.b  ($04F0,A4),D0
02:0003F64C 6616            	 13424:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F64E 19400006        	 13425:     move.b  D0,($0006,A4)
02:0003F652 19400009        	 13426:     move.b  D0,($0009,A4)
02:0003F656 1940000C        	 13427:     move.b  D0,($000C,A4)
02:0003F65A 7600            	 13428:     moveq   #0,D3
02:0003F65C 1883            	 13429:     move.b  D3,($0000,A4)
02:0003F65E 4EB900031A7A    	 13430:     jsr     CheckLinkCollisionPreinit
                            	 13431:     even
                            	 13432: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13433:     ; If Ganon is not in state 0, then he's brown.
                            	 13434:     ; Go check collision with an arrow.
                            	 13435:     ;
02:0003F664 41EC00AC        	 13436:     lea     ($00AC,A4),A0
02:0003F668 10302000        	 13437:     move.b  (A0,D2.W),D0
02:0003F66C 6652            	 13438:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13439:     ; If timer <> 0, then Ganon is visible.
                            	 13440:     ; He can't be harmed like this. So, return.
                            	 13441:     ;
02:0003F66E 10342028        	 13442:     move.b  ($28,A4,D2.W),D0
02:0003F672 664A            	 13443:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F674 760D            	 13444:     moveq   #13,D3
02:0003F676 4EB900031F44    	 13445:     jsr     CheckMonsterSwordCollision
                            	 13446:     ; If Ganon has died according to the usual collision check rules
                            	 13447:     ; (HP = 0), then:
                            	 13448:     ; 1. Restore HP to the initial value $F0
                            	 13449:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13450:     ; 3. Change palette row 7 to make Ganon brown
                            	 13451:     ;
02:0003F67C 41EC0405        	 13452:     lea     ($0405,A4),A0
02:0003F680 10302000        	 13453:     move.b  (A0,D2.W),D0
02:0003F684 6718            	 13454:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F686 103C00F0        	 13455:     move.b  #$F0,D0
02:0003F68A 41EC0485        	 13456:     lea     ($0485,A4),A0
02:0003F68E 11802000        	 13457:     move.b  D0,(A0,D2.W)
02:0003F692 41EC00AC        	 13458:     lea     ($00AC,A4),A0
02:0003F696 53302000        	 13459:     subq.b  #1,(A0,D2.W)
02:0003F69A 61000084        	 13460:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13461:     even
                            	 13462: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13463:     ; If Ganon was harmed, then play the sound effect
                            	 13464:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13465:     ;
02:0003F69E 41EC04F0        	 13466:     lea     ($04F0,A4),A0
02:0003F6A2 10302000        	 13467:     move.b  (A0,D2.W),D0
02:0003F6A6 670A            	 13468:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F6A8 61009FA0        	 13469:     jsr     PlayBossHitCryIfNeeded
02:0003F6AC 7040            	 13470:     moveq   #64,D0
02:0003F6AE 19802028        	 13471:     move.b  D0,($28,A4,D2.W)
                            	 13472:     even
                            	 13473: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13474:     ; Reset metastate, because Ganon cannot die this way.
                            	 13475:     ;
02:0003F6B2 4EB90004DAF4    	 13476:     jsr     ResetObjMetastate
                            	 13477:     ; Reset shove info and invincibility timer, because Ganon
                            	 13478:     ; doesn't react at all as a usual monster.
                            	 13479:     ;
02:0003F6B8 4EB900031E4C    	 13480:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13481:     even
                            	 13482: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F6BE 4E75            	 13483:     rts
                            	 13484: 
                            	 13485:     even
                            	 13486: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13487:     ; If the silver arrow is not in the inventory, then return.
                            	 13488:     ;
02:0003F6C0 102C0659        	 13489:     move.b  ($0659,A4),D0
02:0003F6C4 0C000002        	 13490:     cmpi.b  #$02,D0
02:0003F6C8 66F4            	 13491:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13492:     ; Reset the collision return value [06].
                            	 13493:     ;
02:0003F6CA 7000            	 13494:     moveq   #0,D0
02:0003F6CC 19400006        	 13495:     move.b  D0,($0006,A4)
                            	 13496:     ; If there's no arrow in flight, then return.
                            	 13497:     ;
02:0003F6D0 7612            	 13498:     moveq   #18,D3
02:0003F6D2 41EC00AC        	 13499:     lea     ($00AC,A4),A0
02:0003F6D6 10303000        	 13500:     move.b  (A0,D3.W),D0
02:0003F6DA 0C000010        	 13501:     cmpi.b  #$10,D0
02:0003F6DE 66DE            	 13502:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13503:     ; Check for collision with an arrow; and return if no collision.
                            	 13504:     ;
02:0003F6E0 4EB900031FA0    	 13505:     jsr     CheckMonsterArrowOrRodCollision
02:0003F6E6 102C0006        	 13506:     move.b  ($0006,A4),D0
02:0003F6EA 67D2            	 13507:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13508:     ; Set the Ganon phase to "dying".
                            	 13509:     ;
02:0003F6EC 41EC042C        	 13510:     lea     ($042C,A4),A0
02:0003F6F0 52302000        	 13511:     addq.b  #1,(A0,D2.W)
                            	 13512:     ; Now his body does flash.
                            	 13513:     ;
02:0003F6F4 7028            	 13514:     moveq   #40,D0
02:0003F6F6 41EC04F0        	 13515:     lea     ($04F0,A4),A0
02:0003F6FA 11802000        	 13516:     move.b  D0,(A0,D2.W)
                            	 13517:     ; Set initial cloud distance 8.
                            	 13518:     ;
02:0003F6FE 7008            	 13519:     moveq   #8,D0
02:0003F700 41EC0478        	 13520:     lea     ($0478,A4),A0
02:0003F704 11802000        	 13521:     move.b  D0,(A0,D2.W)
02:0003F708 0A3C0001        	 13522:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F70C 4E75            	 13523:     rts
                            	 13524: 
