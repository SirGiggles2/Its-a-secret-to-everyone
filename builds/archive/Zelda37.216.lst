                            	   742: UpdatePersonState_Textbox:
02:0002DF8C 7001            	   743:     moveq   #1,D0
02:0002DF8E 6100CA6A        	   744:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002DF92 4EB90004C208    	   745:     jsr     Link_EndMoveAndDraw_Bank1
                            	   746:     ; If the person's timer has not expired, then return.
                            	   747:     ;
