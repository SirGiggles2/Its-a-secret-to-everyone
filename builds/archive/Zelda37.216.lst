02:000399FC 1234203D        	   696:     move.b  ($3D,A4,D2.W),D1
02:00039A00 8001            	   697:     or.b  D1,D0
02:00039A02 6672            	   698:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   699:     ; Try to shoot. Return, if it failed.
