02:0003F56C 023C00EE        	 13309:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F570 41EC0478        	 13310:     lea     ($0478,A4),A0
02:0003F574 12302000        	 13311:     move.b  (A0,D2.W),D1
02:0003F578 D101            	 13312:     addx.b  D1,D0   ; ADC Ganon_ObjCloudDist,X
02:0003F57A 19400001        	 13313:     move.b  D0,($0001,A4)
02:0003F57E 4E75            	 13314:     rts
