                            	  2460:     ;
02:0002FC02 7001            	  2461:     moveq   #1,D0
02:0002FC04 19400098        	  2462:     move.b  D0,($0098,A4)
02:0002FC08 E208            	  2463:     lsr.b  #1,D0   ; LSR A
02:0002FC0A 194000C0        	  2464:     move.b  D0,($00C0,A4)
02:0002FC0E 194000D3        	  2465:     move.b  D0,($00D3,A4)
02:0002FC12 1940005A        	  2466:     move.b  D0,($005A,A4)
                            	  2467:     ; Halt Link (state $40), and hide him.
                            	  2468:     ;
02:0002FC16 7040            	  2469:     moveq   #64,D0
02:0002FC18 194000AC        	  2470:     move.b  D0,($00AC,A4)
02:0002FC1C 103C00F8        	  2471:     move.b  #$F8,D0
02:0002FC20 19400248        	  2472:     move.b  D0,($0248,A4)
02:0002FC24 1940024C        	  2473:     move.b  D0,($024C,A4)
                            	  2474:     ; Find and set the room that will behave as the previous room
                            	  2475:     ; when scrolling right to the room with the level's entrance.
                            	  2476:     ;
02:0002FC28 102C0523        	  2477:     move.b  ($0523,A4),D0
02:0002FC2C 02000007        	  2478:     andi.b #$07,D0
02:0002FC30 7600            	  2479:     moveq   #0,D3
02:0002FC32 1600            	  2480:     move.b  D0,D3
02:0002FC34 41F90002FB96    	  2481:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FC3A 10303000        	  2482:     move.b  (A0,D3.W),D0
02:0002FC3E 194000EA        	  2483:     move.b  D0,($00EA,A4)
                            	  2484:     ; Set teleporting state 1.
                            	  2485:     ;
02:0002FC42 522C0522        	  2486:     addq.b  #1,($0522,A4)
                            	  2487:     even
                            	  2488: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2489:     ; If whirlwind's X < $F0, go draw.
