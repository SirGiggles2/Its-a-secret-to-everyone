                            	  7224: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7225:     ; Bloated timer =>
                            	  7226:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7227:     ; 1:     go advance the substate
                            	  7228:     ; other: go decrement Bloated timer
                            	  7229:     ;
02:0003C8BE 7600            	  7230:     moveq   #0,D3
02:0003C8C0 41EC045E        	  7231:     lea     ($045E,A4),A0
02:0003C8C4 16302000        	  7232:     move.b  (A0,D2.W),D3
02:0003C8C8 5303            	  7233:     subq.b  #1,D3
02:0003C8CA 6750            	  7234:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C8CC 6B04            	  7235:     bmi.s  __far_z_04_0063
02:0003C8CE 60000080        	  7236:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7237: __far_z_04_0063:
                            	  7238:     ; Set the bloated timer according to the substate.
                            	  7239:     ;
02:0003C8D2 7600            	  7240:     moveq   #0,D3
02:0003C8D4 41EC042C        	  7241:     lea     ($042C,A4),A0
02:0003C8D8 16302000        	  7242:     move.b  (A0,D2.W),D3
02:0003C8DC 41F90003C808    	  7243:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C8E2 10303000        	  7244:     move.b  (A0,D3.W),D0
02:0003C8E6 41EC045E        	  7245:     lea     ($045E,A4),A0
02:0003C8EA 11802000        	  7246:     move.b  D0,(A0,D2.W)
                            	  7247:     ; If substate <> 0, go decrement bloated timer.
                            	  7248:     ;
02:0003C8EE 4A03            	  7249:     cmpi.b  #$00,D3
02:0003C8F0 6702            	  7250:     beq.s  __far_z_04_0064
02:0003C8F2 605C            	  7251:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7252: __far_z_04_0064:
                            	  7253:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  7254:     ;
02:0003C8F4 7610            	  7255:     moveq   #16,D3
02:0003C8F6 7000            	  7256:     moveq   #0,D0
02:0003C8F8 41EC00AC        	  7257:     lea     ($00AC,A4),A0
02:0003C8FC 11803000        	  7258:     move.b  D0,(A0,D3.W)
                            	  7259:     ; Increment the number of bomb hits.
                            	  7260:     ;
02:0003C900 41EC0437        	  7261:     lea     ($0437,A4),A0
02:0003C904 10302000        	  7262:     move.b  (A0,D2.W),D0
02:0003C908 023C00EE        	  7263:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C90C 123C0001        	  7264:     move.b  #$01,D1
02:0003C910 D101            	  7265:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003C912 41EC0437        	  7266:     lea     ($0437,A4),A0
02:0003C916 11802000        	  7267:     move.b  D0,(A0,D2.W)
02:0003C91A 6034            	  7268:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  7269: 
                            	  7270:     even
                            	  7271: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7272:     ; Advance the substate.
                            	  7273:     ;
02:0003C91C 41EC042C        	  7274:     lea     ($042C,A4),A0
02:0003C920 52302000        	  7275:     addq.b  #1,(A0,D2.W)
                            	  7276:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7277:     ;
02:0003C924 41EC042C        	  7278:     lea     ($042C,A4),A0
02:0003C928 10302000        	  7279:     move.b  (A0,D2.W),D0
02:0003C92C 0C000002        	  7280:     cmpi.b  #$02,D0
02:0003C930 6402            	  7281:     bcc.s  __far_z_04_0065
02:0003C932 601C            	  7282:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7283: __far_z_04_0065:
                            	  7284:     ; New bloated substate >= 2.
                            	  7285:     ;
                            	  7286:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7287:     ; which will transition to state 0 (moving).
                            	  7288:     ;
                            	  7289:     ; Note that if the bomb hits >= 2, then:
                            	  7290:     ; - If new substate = 2, then substate 2 will wait,
                            	  7291:     ;   and then transition to substate 3.
                            	  7292:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7293:     ;
02:0003C934 7600            	  7294:     moveq   #0,D3
02:0003C936 41EC0437        	  7295:     lea     ($0437,A4),A0
02:0003C93A 16302000        	  7296:     move.b  (A0,D2.W),D3
02:0003C93E 0C030002        	  7297:     cmpi.b  #$02,D3
02:0003C942 6502            	  7298:     bcs.s  __far_z_04_0066
02:0003C944 600A            	  7299:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7300: __far_z_04_0066:
02:0003C946 7004            	  7301:     moveq   #4,D0
02:0003C948 41EC042C        	  7302:     lea     ($042C,A4),A0
02:0003C94C 11802000        	  7303:     move.b  D0,(A0,D2.W)
                            	  7304:     even
                            	  7305: L_Dodongo_DecrementBloatedTimer:
02:0003C950 4EF90002B902    	  7306:     jmp     c_dodongo_dec_bloated_timer
                            	  7307: 
                            	  7308: UpdateDodongoState1_Bloated_Sub_Die:
02:0003C956 4EB90004DACA    	  7309:     jsr     UpdateDeadDummy
02:0003C95C 61002E96        	  7310:     jsr     PlayBossDeathCry
