02:0002DFAE 10303000        	   761:     move.b  (A0,D3.W),D0
02:0002DFB2 41EC0302        	   762:     lea     ($0302,A4),A0
02:0002DFB6 11803000        	   763:     move.b  D0,(A0,D3.W)
02:0002DFBA 5303            	   764:     subq.b  #1,D3
02:0002DFBC 6AEA            	   765:     bpl  _anon_z01_7
                            	   766:     even
                            	   767: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   768:     ; Replace the low byte of the VRAM address with the one
                            	   769:     ; where the next character should be written.
                            	   770:     ;
02:0002DFBE 102C045F        	   771:     move.b  ($045F,A4),D0
02:0002DFC2 19400303        	   772:     move.b  D0,($0303,A4)
                            	   773:     ; Increment the low VRAM address for the next character.
                            	   774:     ;
02:0002DFC6 522C045F        	   775:     addq.b  #1,($045F,A4)
                            	   776:     ; Use the person text selector to look up the address of the
                            	   777:     ; text for the textbox. Store the address in [00:01].
                            	   778:     ;
02:0002DFCA 7600            	   779:     moveq   #0,D3
02:0002DFCC 162C0415        	   780:     move.b  ($0415,A4),D3
02:0002DFD0 41F90002D5F0    	   781:     lea     (PersonTextAddrs).l,A0
02:0002DFD6 10303000        	   782:     move.b  (A0,D3.W),D0
02:0002DFDA 1880            	   783:     move.b  D0,($0000,A4)
02:0002DFDC 5203            	   784:     addq.b  #1,D3
02:0002DFDE 41F90002D5F0    	   785:     lea     (PersonTextAddrs).l,A0
02:0002DFE4 10303000        	   786:     move.b  (A0,D3.W),D0
02:0002DFE8 19400001        	   787:     move.b  D0,($0001,A4)
                            	   788:     ; Load the person text current character index.
                            	   789:     ;
02:0002DFEC 7600            	   790:     moveq   #0,D3
02:0002DFEE 162C0416        	   791:     move.b  ($0416,A4),D3
                            	   792:     ; Increment the index variable to point to the next character
                            	   793:     ; for next time.
                            	   794:     ;
02:0002DFF2 522C0416        	   795:     addq.b  #1,($0416,A4)
                            	   796:     ; Get the current character.
                            	   797:     ;
02:0002DFF6 1214            	   798:     move.b  ($00,A4),D1   ; ptr lo
02:0002DFF8 182C0001        	   799:     move.b  ($01,A4),D4  ; ptr hi
02:0002DFFC 024100FF        	   800:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E000 E14C            	   801:     lsl.w   #8,D4
02:0002E002 8841            	   802:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E004 48C4            	   803:     ext.l   D4
02:0002E006 D8BC00FF0000    	   804:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E00C 2044            	   805:     movea.l D4,A0
02:0002E00E 10303000        	   806:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   807:     ; If the character is $25, then it's a special space. It will still
                            	   808:     ; take up space, but will not take time to show -- meaning that
                            	   809:     ; we'll go look up the next character to transfer.
                            	   810:     ;
02:0002E012 0200003F        	   811:     andi.b #$3F,D0
02:0002E016 0C000025        	   812:     cmpi.b  #$25,D0
02:0002E01A 67A2            	   813:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   814:     ; We have a non-space character. Put it in the transfer record.
                            	   815:     ;
02:0002E01C 19400305        	   816:     move.b  D0,($0305,A4)
                            	   817:     ; Play the "heart taken/character" sound effect.
                            	   818:     ;
02:0002E020 7010            	   819:     moveq   #16,D0
02:0002E022 19400604        	   820:     move.b  D0,($0604,A4)
                            	   821:     ; If the high 2 bits of character element = 0, then return.
                            	   822:     ;
02:0002E026 1214            	   823:     move.b  ($00,A4),D1   ; ptr lo
02:0002E028 182C0001        	   824:     move.b  ($01,A4),D4  ; ptr hi
02:0002E02C 024100FF        	   825:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E030 E14C            	   826:     lsl.w   #8,D4
02:0002E032 8841            	   827:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E034 48C4            	   828:     ext.l   D4
02:0002E036 D8BC00FF0000    	   829:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E03C 2044            	   830:     movea.l D4,A0
02:0002E03E 10303000        	   831:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E042 020000C0        	   832:     andi.b #$C0,D0
02:0002E046 672E            	   833:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   834:     ; Determine an index based on the high 2 bits of the character element:
                            	   835:     ;   $80: 0
                            	   836:     ;   $40: 1
                            	   837:     ;   $C0: 2
                            	   838:     ;
02:0002E048 7602            	   839:     moveq   #2,D3
02:0002E04A 0C0000C0        	   840:     cmpi.b  #$C0,D0
02:0002E04E 670A            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E050 5303            	   842:     subq.b  #1,D3
02:0002E052 0C000040        	   843:     cmpi.b  #$40,D0
02:0002E056 6702            	   844:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E058 5303            	   845:     subq.b  #1,D3
                            	   846:     even
                            	   847: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   848:     ; The index chooses the low VRAM address of the start
                            	   849:     ; of another line:
                            	   850:     ;   0: $C4: front of the second line
                            	   851:     ;   1: $E4: front of the third line
                            	   852:     ;   2: $A4: front of the first line
                            	   853:     ;
                            	   854:     ; Look up the low VRAM address and store it.
                            	   855:     ;
02:0002E05A 41F90002DF88    	   856:     lea     (TextboxLineAddrsLo).l,A0
02:0002E060 10303000        	   857:     move.b  (A0,D3.W),D0
02:0002E064 1940045F        	   858:     move.b  D0,($045F,A4)
                            	   859:     ; If index = 2, then we've reached the end of the text,
                            	   860:     ; and low VRAM address is moved to the front of the first line.
                            	   861:     ; So, advance the state of the person object, and unhalt Link.
                            	   862:     ;
02:0002E068 0C030002        	   863:     cmpi.b  #$02,D3
02:0002E06C 6608            	   864:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E06E 522C00AD        	   865:     addq.b  #1,($00AD,A4)
02:0002E072 6100FB82        	   866:     jsr     UnhaltLink
                            	   867:     even
                            	   868: _L_z01_UpdatePersonState_Textbox_Exit:
02:0002E076 4E75            	   869:     rts
                            	   870: 
                            	   871:     even
