                            	 10900: _anon_z04_129:
02:0003E428 610000DC        	 10901:     jsr     Gleeok_StretchNeck
02:0003E42C 5202            	 10902:     addq.b  #1,D2
02:0003E42E 0C020003        	 10903:     cmpi.b  #$03,D2
02:0003E432 65F4            	 10904:     bcs  _anon_z04_129
                            	 10905:     ; [04D8] is the quarter horizontal distance from the head to the base.
                            	 10906:     ; It represents the reference distance from each segment to the base.
                            	 10907:     ; Multiples of it are used to mark the reference point of each segment.
                            	 10908:     ; Move every segment one pixel closer to its reference point.
