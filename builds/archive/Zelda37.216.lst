02:0003EBD8 7001            	 11952:     moveq   #1,D0
02:0003EBDA 1940007D        	 11953:     move.b  D0,($007D,A4)
02:0003EBDE 7024            	 11954:     moveq   #36,D0
02:0003EBE0 1940000A        	 11955:     move.b  D0,($000A,A4)
02:0003EBE4 4EF90004B204    	 11956:     jmp     FillTileMap
                            	 11957: 
                            	 11958:     even
