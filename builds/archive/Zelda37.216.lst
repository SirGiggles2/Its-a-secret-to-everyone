02:00031C8E 19400098        	  6994:     move.b  D0,($0098,A4)
                            	  6995: _anon_z01_87:
02:00031C92 4E75            	  6996:     rts
                            	  6997: 
                            	  6998: ; Params:
                            	  6999: ; X: monster slot
                            	  7000: ; Y: weapon slot
                            	  7001: ; [02]: monster mid X
                            	  7002: ; [03]: monster mid Y
                            	  7003: ;
                            	  7004: ; Returns:
                            	  7005: ; [00]: weapon slot
                            	  7006: ;
                            	  7007: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  7008: ;
                            	  7009:     even
                            	  7010: CheckMonsterBoomerangOrFoodCollision:
02:00031C94 41EC00AC        	  7011:     lea     ($00AC,A4),A0
02:00031C98 10303000        	  7012:     move.b  (A0,D3.W),D0
02:00031C9C E308            	  7013:     lsl.b  #1,D0   ; ASL A
02:00031C9E 65F2            	  7014:     bcs  _anon_z01_87
02:00031CA0 1883            	  7015:     move.b  D3,($0000,A4)
                            	  7016:     ; Set boomerang damage type (2) in [09].
                            	  7017:     ;
