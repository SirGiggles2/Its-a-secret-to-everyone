                            	  2421: _L_z04__TryShooting_TryShootingNow:
                            	  2422:     ; Summary
                            	  2423:     ;
                            	  2424:     ; if temporarily invincible then
                            	  2425:     ;   shoot timer := 0
                            	  2426:     ; elif shoot timer > 0 then
                            	  2427:     ;   decrement shoot timer
                            	  2428:     ; elif wants to shoot then
                            	  2429:     ;   shoot timer := $30
                            	  2430:     ;
                            	  2431:     ; qspeed := [01]
                            	  2432:     ;
                            	  2433:     ; if shoot timer <> 0 then
                            	  2434:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2435:     ;     shoot
                            	  2436:     ;     if succeeded then
                            	  2437:     ;       shoot timer := 0
                            	  2438:     ;       qspeed := 0
                            	  2439:     ;   else
                            	  2440:     ;     qspeed := 0
                            	  2441:     ;
                            	  2442:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A654 102C0001        	  2443:     move.b  ($0001,A4),D0
02:0003A658 1883            	  2444:     move.b  D3,($0000,A4)
02:0003A65A 1B00            	  2445:     move.b  D0,-(A5)  ; PHA
02:0003A65C 7600            	  2446:     moveq   #0,D3
                            	  2447:     ; If not temporarily invincible,
                            	  2448:     ;
02:0003A65E 41EC04F0        	  2449:     lea     ($04F0,A4),A0
02:0003A662 10302000        	  2450:     move.b  (A0,D2.W),D0
02:0003A666 661A            	  2451:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2452:     ; then Y := shoot timer - 1
                            	  2453:     ;
02:0003A668 7600            	  2454:     moveq   #0,D3
02:0003A66A 41EC0451        	  2455:     lea     ($0451,A4),A0
02:0003A66E 16302000        	  2456:     move.b  (A0,D2.W),D3
02:0003A672 5303            	  2457:     subq.b  #1,D3
                            	  2458:     ; If Y register < 0, then shoot timer is 0.
                            	  2459:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2460:     ; Else go set a non-zero speed and return.
                            	  2461:     ;
02:0003A674 6A0C            	  2462:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A676 41EC0412        	  2463:     lea     ($0412,A4),A0
02:0003A67A 10302000        	  2464:     move.b  (A0,D2.W),D0
02:0003A67E 6736            	  2465:     beq  _L_z04__TryShooting_SetSpeed
02:0003A680 7630            	  2466:     moveq   #48,D3
                            	  2467:     even
