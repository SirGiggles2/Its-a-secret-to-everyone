02:0003677A 19400321        	  5189:     move.b  D0,($0321,A4)
                            	  5190:     even
                            	  5191: _L_z02_DrawCredits_TerminateRecords:
                            	  5192:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5193:     ; attributes or only tiles.
                            	  5194:     ;
02:0003677E 103C00FF        	  5195:     move.b  #$FF,D0
02:00036782 19400325        	  5196:     move.b  D0,($0325,A4)
02:00036786 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:0003678A 7020            	  5200:     moveq   #32,D0
02:0003678C 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:00036790 7400            	  5204:     moveq   #0,D2
02:00036792 142C050C        	  5205:     move.b  ($050C,A4),D2
02:00036796 41F90003653C    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:0003679C 10302000        	  5207:     move.b  (A0,D2.W),D0
02:000367A0 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:000367A4 102C050D        	  5211:     move.b  ($050D,A4),D0
02:000367A8 7600            	  5212:     moveq   #0,D3
02:000367AA 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:000367AC E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:000367AE E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:000367B0 E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:000367B2 E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:000367B4 E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:000367B6 19400303        	  5221:     move.b  D0,($0303,A4)
