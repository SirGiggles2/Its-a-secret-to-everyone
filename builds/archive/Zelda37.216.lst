02:000438F0 6620            	  5859:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5860:     even
                            	  5861: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5862:     ; We jump here if the door type is bombable and was opened.
                            	  5863:     ; Change the provisional door face to value 9, which
                            	  5864:     ; will become the "hole in the wall".
                            	  5865:     ;
02:000438F2 7009            	  5866:     moveq   #9,D0
02:000438F4 665A            	  5867:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5868:     even
                            	  5869: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5870:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5871:     ; the mask of opened doors, because this is not a true door.
                            	  5872:     ;
02:000438F6 1B00            	  5873:     move.b  D0,-(A5)  ; PHA
02:000438F8 102C0002        	  5874:     move.b  ($0002,A4),D0
02:000438FC 4600            	  5875:     eori.b #$FF,D0
02:000438FE 122C00EE        	  5876:     move.b  ($00EE,A4),D1
02:00043902 C001            	  5877:     and.b  D1,D0
02:00043904 194000EE        	  5878:     move.b  D0,($00EE,A4)
02:00043908 101D            	  5879:     move.b  (A5)+,D0  ; PLA
                            	  5880:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5881:     ;
02:0004390A 0C000001        	  5882:     cmpi.b  #$01,D0
02:0004390E 6402            	  5883:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043910 7004            	  5884:     moveq   #4,D0
                            	  5885:     even
                            	  5886: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5887:     ; The door attribute (DA) has been mapped to a
                            	  5888:     ; provisional door face value (PF) in %A as follows:
                            	  5889:     ;
                            	  5890:     ; DA PF Meaning
                            	  5891:     ; -------------
                            	  5892:     ; 0  4  open
                            	  5893:     ; 1  1  wall
                            	  5894:     ; 2  2  false wall
                            	  5895:     ; 3  3  false wall 2
                            	  5896:     ; 4  8  bombable
                            	  5897:     ; 5  5  key
                            	  5898:     ; 6  6  key 2
                            	  5899:     ; 7  7  shutter
                            	  5900:     ;
                            	  5901:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5902:     ; has been cleared, if the type was "open" or any wall.
                            	  5903:     ;
                            	  5904:     ;
                            	  5905:     ; Save the provisional face.
02:00043912 1B00            	  5906:     move.b  D0,-(A5)  ; PHA
                            	  5907:     ; If the current direction points to a door that has been opened,
                            	  5908:     ; then see if we need to set door flags.
                            	  5909:     ;
02:00043914 102C00EE        	  5910:     move.b  ($00EE,A4),D0
02:00043918 122C0002        	  5911:     move.b  ($0002,A4),D1
02:0004391C C001            	  5912:     and.b  D1,D0
02:0004391E 7400            	  5913:     moveq   #0,D2
02:00043920 1400            	  5914:     move.b  D0,D2
02:00043922 101D            	  5915:     move.b  (A5)+,D0  ; PLA
02:00043924 122C0002        	  5916:     move.b  ($0002,A4),D1
02:00043928 B401            	  5917:     cmp.b   D1,D2
02:0004392A 6624            	  5918:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5919:     ; The current direction points to a door that has been opened.
                            	  5920:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5921:     ;
                            	  5922:     ;
                            	  5923:     ; Save provisional door face in Y register.
02:0004392C 7600            	  5924:     moveq   #0,D3
02:0004392E 1600            	  5925:     move.b  D0,D3
02:00043930 101D            	  5926:     move.b  (A5)+,D0  ; PLA
02:00043932 1B00            	  5927:     move.b  D0,-(A5)  ; PHA
