                            	   558: UpdateMenuStartOW:
                            	   559:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   560:     ; make it look completely empty, and no piece has been won.
                            	   561:     ;
02:000403F2 7617            	   562:     moveq   #23,D3
                            	   563: _anon_z05_6:
02:000403F4 7400            	   564:     moveq   #0,D2
02:000403F6 41F9000403AA    	   565:     lea     (TriforceTransferBufOffsets).l,A0
02:000403FC 14303000        	   566:     move.b  (A0,D3.W),D2
02:00040400 41F9000403DA    	   567:     lea     (TriforceTransferBufTiles).l,A0
02:00040406 10303000        	   568:     move.b  (A0,D3.W),D0
02:0004040A 41F900047792    	   569:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040410 11802000        	   570:     move.b  D0,(A0,D2.W)
02:00040414 5303            	   571:     subq.b  #1,D3
02:00040416 6ADC            	   572:     bpl  _anon_z05_6
                            	   573:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   574:     ;
02:00040418 5203            	   575:     addq.b  #1,D3
                            	   576:     ; Outer loop.
                            	   577:     ; A level test bit in [06] will be used to see whether
                            	   578:     ; we have a triforce piece.
                            	   579:     ;
02:0004041A 7001            	   580:     moveq   #1,D0
02:0004041C 19400006        	   581:     move.b  D0,($0006,A4)
                            	   582:     even
                            	   583: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   584:     ; Inner loop.
                            	   585:     ; Each level bit will make 3 triforce tile slots be
                            	   586:     ; checked and replaced.
                            	   587:     ;
02:00040420 7003            	   588:     moveq   #3,D0
02:00040422 19400007        	   589:     move.b  D0,($0007,A4)
                            	   590:     even
                            	   591: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   592:     ; Get the offset into the submenu triforce transfer buffers of
                            	   593:     ; the current tile slot.
                            	   594:     ;
02:00040426 7400            	   595:     moveq   #0,D2
02:00040428 41F9000403AA    	   596:     lea     (TriforceTransferBufOffsets).l,A0
02:0004042E 14303000        	   597:     move.b  (A0,D3.W),D2
                            	   598:     ; If the level test bit is not in the triforce mask, then we don't
                            	   599:     ; have this piece. So, go loop again, and leave the tile in the
                            	   600:     ; empty state.
                            	   601:     ;
                            	   602:     ;
                            	   603:     ; [06] level test mask
02:00040432 102C0006        	   604:     move.b  ($0006,A4),D0
02:00040436 122C0671        	   605:     move.b  ($0671,A4),D1
02:0004043A C200            	   606:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004043C 6730            	   607:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   608:     ; We have the triforce piece.
                            	   609:     ;
                            	   610:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   611:     ; then make it $F5. These are tiles that were half full, and now
                            	   612:     ; need to be full.
                            	   613:     ;
                            	   614:     ; Else replace it with the one at the current triforce tile slot
                            	   615:     ; in the replacement list.
                            	   616:     ;
02:0004043E 41F900047792    	   617:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040444 10302000        	   618:     move.b  (A0,D2.W),D0
02:00040448 0C0000E5        	   619:     cmpi.b  #$E5,D0
02:0004044C 6712            	   620:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0004044E 0C0000E6        	   621:     cmpi.b  #$E6,D0
02:00040452 670C            	   622:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040454 41F9000403C2    	   623:     lea     (TriforceTriforceBufReplacements).l,A0
02:0004045A 10303000        	   624:     move.b  (A0,D3.W),D0
02:0004045E 6004            	   625:     jmp     _anon_z05_7
                            	   626: 
                            	   627:     even
                            	   628: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:00040460 103C00F5        	   629:     move.b  #$F5,D0
                            	   630: _anon_z05_7:
02:00040464 41F900047792    	   631:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004046A 11802000        	   632:     move.b  D0,(A0,D2.W)
                            	   633:     even
                            	   634: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   635:     ; Bottom of the inner loop.
                            	   636:     ;
                            	   637:     ; Increment the triforce tile slot.
                            	   638:     ; Decrement [07] and loop again, if it's not 0.
                            	   639:     ;
02:0004046E 5203            	   640:     addq.b  #1,D3
02:00040470 532C0007        	   641:     subq.b  #1,($0007,A4)
02:00040474 66B0            	   642:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   643:     ; Bottom of the outer loop.
                            	   644:     ;
                            	   645:     ; Shift the level test bit [06] left to test the next level.
                            	   646:     ; When it becomes 0, we're done.
                            	   647:     ;
02:00040476 122C0006        	   648:     move.b  ($0006,A4),D1
02:0004047A E309            	   649:     lsl.b  #1,D1   ; ASL $06
02:0004047C 19410006        	   650:     move.b  D1,($0006,A4)
02:00040480 669E            	   651:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:00040482 522C00E1        	   652:     addq.b  #1,($00E1,A4)
02:00040486 4E75            	   653:     rts
                            	   654: 
                            	   655:     even
                            	   656: ScrollWorld:
02:00040488 102C0015        	   657:     move.b  ($0015,A4),D0
                            	   658:     ; The purpose of this is to delay vertical scrolling.
                            	   659:     ; OW: once every two frames
                            	   660:     ; UW: once every four frames
                            	   661:     ; Horizontal scrolling happens every frame.
02:0004048C 02000003        	   662:     andi.b #$03,D0
02:00040490 7600            	   663:     moveq   #0,D3
02:00040492 162C0010        	   664:     move.b  ($0010,A4),D3
02:00040496 6604            	   665:     bne  _anon_z05_8
02:00040498 02000001        	   666:     andi.b #$01,D0
                            	   667: _anon_z05_8:
02:0004049C 122C00E6        	   668:     move.b  ($00E6,A4),D1
02:000404A0 B001            	   669:     cmp.b   D1,D0
02:000404A2 6704            	   670:     beq.s  __far_z_05_0007
02:000404A4 600000DE        	   671:     jmp  ScrollWorldH
                            	   672: __far_z_05_0007:
02:000404A8 7008            	   673:     moveq   #8,D0
02:000404AA 122C0098        	   674:     move.b  ($0098,A4),D1
02:000404AE C200            	   675:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000404B0 6602            	   676:     bne.s  __far_z_05_0008
02:000404B2 606E            	   677:     jmp  ScrollWorldDownOrH
                            	   678: __far_z_05_0008:
                            	   679:     ; then scroll up.
                            	   680:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   681:     ;
02:000404B4 532C00E9        	   682:     subq.b  #1,($00E9,A4)
02:000404B8 102C0084        	   683:     move.b  ($0084,A4),D0
02:000404BC 0C0000DD        	   684:     cmpi.b  #$DD,D0
02:000404C0 640A            	   685:     bcc  _anon_z05_9
02:000404C2 123C0008        	   686:     move.b  #$08,D1
02:000404C6 D101            	   687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000404C8 19400084        	   688:     move.b  D0,($0084,A4)
                            	   689: _anon_z05_9:
02:000404CC 102C00E2        	   690:     move.b  ($00E2,A4),D0
02:000404D0 003C0011        	   691:     ori     #$11,CCR  ; SEC: set C+X
02:000404D4 123C0020        	   692:     move.b  #$20,D1
02:000404D8 0A3C0010        	   693:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000404DC 9101            	   694:     subx.b  D1,D0   ; SBC #$20
02:000404DE 0A3C0010        	   695:     eori    #$10,CCR  ; restore X = 6502 C
02:000404E2 194000E2        	   696:     move.b  D0,($00E2,A4)
02:000404E6 6404            	   697:     bcc  _anon_z05_10
02:000404E8 532C0058        	   698:     subq.b  #1,($0058,A4)
                            	   699: _anon_z05_10:
02:000404EC 0C0000E0        	   700:     cmpi.b  #$E0,D0
02:000404F0 661E            	   701:     bne  _L_z05_ScrollWorld_Exit
02:000404F2 102C0058        	   702:     move.b  ($0058,A4),D0
02:000404F6 0C000020        	   703:     cmpi.b  #$20,D0
02:000404FA 6716            	   704:     beq  _L_z05_ScrollWorld_LimitLow
02:000404FC 0C000027        	   705:     cmpi.b  #$27,D0
02:00040500 660E            	   706:     bne  _L_z05_ScrollWorld_Exit
                            	   707:     ; VScroll address is $27E0. So, we rolled from the
                            	   708:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   709:     ; to $23A0, the true last row of NT 0.
02:00040502 7023            	   710:     moveq   #35,D0
02:00040504 19400058        	   711:     move.b  D0,($0058,A4)
02:00040508 103C00A0        	   712:     move.b  #$A0,D0
02:0004050C 194000E2        	   713:     move.b  D0,($00E2,A4)
                            	   714:     even
                            	   715: _L_z05_ScrollWorld_Exit:
02:00040510 4E75            	   716:     rts
                            	   717: 
                            	   718:     even
                            	   719: _L_z05_ScrollWorld_LimitLow:
                            	   720:     ; Don't let the scroll position go above $2100, the bottom of
                            	   721:     ; the status bar; nor below $2800, the top of NT 2.
02:00040512 522C0058        	   722:     addq.b  #1,($0058,A4)
                            	   723:     even
                            	   724: ResetVScrollLo:
02:00040516 4EF90002BC76    	   725:     jmp     c_reset_vscroll_lo
                            	   726: 
                            	   727: IncSubmode:
02:0004051C 4EF90002B9DC    	   728:     jmp     c_inc_submode
                            	   729: 
                            	   730: ScrollWorldDownOrH:
02:00040522 E208            	   731:     lsr.b  #1,D0   ; LSR A
02:00040524 122C0098        	   732:     move.b  ($0098,A4),D1
02:00040528 C200            	   733:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004052A 6602            	   734:     bne.s  __far_z_05_0009
02:0004052C 6056            	   735:     jmp  ScrollWorldH
                            	   736: __far_z_05_0009:
                            	   737:     ; then scroll down.
                            	   738:     ;
02:0004052E 522C00E9        	   739:     addq.b  #1,($00E9,A4)
02:00040532 102C0084        	   740:     move.b  ($0084,A4),D0
