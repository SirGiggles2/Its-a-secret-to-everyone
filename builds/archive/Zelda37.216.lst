02:0003F770 5303            	 13579:     subq.b  #1,D3
02:0003F772 5302            	 13580:     subq.b  #1,D2
02:0003F774 6AE8            	 13581:     bpl  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors
