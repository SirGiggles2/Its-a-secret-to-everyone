02:0003CD2E 0C000002        	  7894:     cmpi.b  #$02,D0
02:0003CD32 6604            	  7895:     bne  _anon_z04_94
02:0003CD34 522C000F        	  7896:     addq.b  #1,($000F,A4)
                            	  7897: _anon_z04_94:
                            	  7898:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7899:     ; This is the base frame image.
