01:000000AC 00FFFFFF        	   161:     dc.l    $00FFFFFF                           ; $1AC RAM end
                            	   162:     ; $1B0 SRAM declaration — Phase 9.7.  "RA" + $F8 (odd-byte battery)
                            	   163:     ; + $20 (pad).  Start = $200001, end = $203FFF (4 KB of odd bytes).
                            	   164:     ; gpgx requires both the marker and matching start/end addresses.
