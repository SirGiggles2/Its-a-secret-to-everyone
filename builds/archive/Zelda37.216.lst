                            	  5949:     even
                            	  5950: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5951:     ; For opened doors, the provisional door face has become:
                            	  5952:     ;
                            	  5953:     ; DA PF Meaning
                            	  5954:     ; -------------
                            	  5955:     ; 0  4  open
                            	  5956:     ; 1  1  wall
                            	  5957:     ; 2  2  false wall
                            	  5958:     ; 3  3  false wall 2
                            	  5959:     ; 4  9  bombable
                            	  5960:     ; 5  4  key
                            	  5961:     ; 6  4  key 2
                            	  5962:     ; 7  4  shutter
                            	  5963:     ;
