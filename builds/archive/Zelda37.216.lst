                            	  7482: Dodongo_TryEatBomb:
                            	  7483:     ; Try to eat the bomb.
                            	  7484:     ;
                            	  7485:     ; If the bomb is not in range of the monster, then return.
                            	  7486:     ;
                            	  7487:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7488:     ;
02:0003CA9E 7601            	  7489:     moveq   #1,D3
02:0003CAA0 616E            	  7490:     jsr     Dodongo_IsBombInRange
02:0003CAA2 6666            	  7491:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7492:     ; Will loop from 1 to 0, indexed by [00].
                            	  7493:     ;
02:0003CAA4 7001            	  7494:     moveq   #1,D0
02:0003CAA6 1880            	  7495:     move.b  D0,($0000,A4)
                            	  7496:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7497:     ;
02:0003CAA8 41EC0098        	  7498:     lea     ($0098,A4),A0
02:0003CAAC 10302000        	  7499:     move.b  (A0,D2.W),D0
02:0003CAB0 E208            	  7500:     lsr.b  #1,D0   ; LSR A
02:0003CAB2 7600            	  7501:     moveq   #0,D3
02:0003CAB4 1600            	  7502:     move.b  D0,D3
                            	  7503:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7504:     ; position depends on the orientation of the monster.
                            	  7505:     ;
                            	  7506:     ; Start with the horizontal distance.
                            	  7507:     ;
02:0003CAB6 102C0004        	  7508:     move.b  ($0004,A4),D0
                            	  7509:     even
                            	  7510: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7511:     ; Look up the limits for the given direction.
                            	  7512:     ;
                            	  7513:     ; If the distance from the bomb < negative limit,
                            	  7514:     ; or >= positive limit, then return.
                            	  7515:     ;
                            	  7516:     ; Note that these are simple signed comparisons that work,
                            	  7517:     ; because the operands are in a small range.
                            	  7518:     ;
02:0003CABA 41F90003C9F4    	  7519:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CAC0 12303000        	  7520:     move.b  (A0,D3.W),D1
02:0003CAC4 B001            	  7521:     cmp.b   D1,D0
02:0003CAC6 6B42            	  7522:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CAC8 41F90003C9FA    	  7523:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CACE 12303000        	  7524:     move.b  (A0,D3.W),D1
02:0003CAD2 B001            	  7525:     cmp.b   D1,D0
02:0003CAD4 6A34            	  7526:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7527:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7528:     ;
02:0003CAD6 1003            	  7529:     move.b  D3,D0
02:0003CAD8 023C00EE        	  7530:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CADC 123C000A        	  7531:     move.b  #$0A,D1
02:0003CAE0 D101            	  7532:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CAE2 7600            	  7533:     moveq   #0,D3
02:0003CAE4 1600            	  7534:     move.b  D0,D3
                            	  7535:     ; Bottom of the loop.
                            	  7536:     ;
                            	  7537:     ; Load the vertical distance for the next iteration.
                            	  7538:     ; Decrement loop counter.
                            	  7539:     ;
02:0003CAE6 102C0005        	  7540:     move.b  ($0005,A4),D0
02:0003CAEA 5314            	  7541:     subq.b  #1,($0000,A4)
02:0003CAEC 6ACC            	  7542:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7543:     ; If we get here, then the bomb was within range of the mouth.
                            	  7544:     ; Go to state 1 (bloated).
                            	  7545:     ;
02:0003CAEE 41EC00AC        	  7546:     lea     ($00AC,A4),A0
02:0003CAF2 52302000        	  7547:     addq.b  #1,(A0,D2.W)
                            	  7548:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7549:     ;
02:0003CAF6 7610            	  7550:     moveq   #16,D3
02:0003CAF8 7000            	  7551:     moveq   #0,D0
02:0003CAFA 41EC00AC        	  7552:     lea     ($00AC,A4),A0
02:0003CAFE 11803000        	  7553:     move.b  D0,(A0,D3.W)
02:0003CB02 41EC042C        	  7554:     lea     ($042C,A4),A0
02:0003CB06 11802000        	  7555:     move.b  D0,(A0,D2.W)
                            	  7556:     even
                            	  7557: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CB0A 4E75            	  7558:     rts
