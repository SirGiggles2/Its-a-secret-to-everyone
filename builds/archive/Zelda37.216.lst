02:00041BAA 6710            	  3194:     beq  _anon_z05_76
02:00041BAC 1003            	  3195:     move.b  D3,D0
02:00041BAE 023C00EE        	  3196:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BB2 123C0004        	  3197:     move.b  #$04,D1
02:00041BB6 D101            	  3198:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
