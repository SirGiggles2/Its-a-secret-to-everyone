                            	  7867: _anon_z01_100:
                            	  7868:     ; For monsters defending, or Link with grid offset = 0,
                            	  7869:     ; check direction in [0B].
                            	  7870:     ;
                            	  7871:     ; For monsters defending, this won't matter. For Link with grid
                            	  7872:     ; offset = 0, I believe the result will be arbitrary.
                            	  7873:     ;
                            	  7874:     ; TODO:
                            	  7875:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7876:     ; It doesn't seem to be if candle fire attacks him.
                            	  7877:     ;
02:00032188 102C000B        	  7878:     move.b  ($000B,A4),D0
02:0003218C 0C000004        	  7879:     cmpi.b  #$04,D0
02:00032190 6416            	  7880:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7881:     even
                            	  7882: _L_z01_BeginShove_CheckHorizontal:
                            	  7883:     ; If the direction checked is left or right,
                            	  7884:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7885:     ;
02:00032192 7002            	  7886:     moveq   #2,D0
02:00032194 19400008        	  7887:     move.b  D0,($0008,A4)
02:00032198 10342070        	  7888:     move.b  ($70,A4,D2.W),D0
02:0003219C 19400004        	  7889:     move.b  D0,($0004,A4)
02:000321A0 10343070        	  7890:     move.b  ($70,A4,D3.W),D0
02:000321A4 19400005        	  7891:     move.b  D0,($0005,A4)
                            	  7892:     even
                            	  7893: _L_z01_BeginShove_CheckVertical:
                            	  7894:     ; If the monster is down or right of the other object,
                            	  7895:     ; then use the opposite direction already in [08].
                            	  7896:     ; Else shift [08] right to turn it into the opposite
                            	  7897:     ; direction up or down.
                            	  7898:     ;
                            	  7899:     ; Again assuming Link is the defender; after this, [08] points
                            	  7900:     ; Link away from the monster.
                            	  7901:     ;
02:000321A8 102C0004        	  7902:     move.b  ($0004,A4),D0
02:000321AC 122C0005        	  7903:     move.b  ($0005,A4),D1
02:000321B0 B001            	  7904:     cmp.b   D1,D0
02:000321B2 640A            	  7905:     bcc  _anon_z01_101
02:000321B4 122C0008        	  7906:     move.b  ($0008,A4),D1
02:000321B8 E209            	  7907:     lsr.b  #1,D1   ; LSR $08
02:000321BA 19410008        	  7908:     move.b  D1,($0008,A4)
                            	  7909: _anon_z01_101:
                            	  7910:     ; If a monster is the defender, go handle it separately.
                            	  7911:     ;
02:000321BE 4A03            	  7912:     cmpi.b  #$00,D3
02:000321C0 6656            	  7913:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7914:     ; Link is the defender.
                            	  7915:     ;
                            	  7916:     ; If Link is invincible, return without shoving.
                            	  7917:     ;
02:000321C2 102C04F0        	  7918:     move.b  ($04F0,A4),D0
02:000321C6 664E            	  7919:     bne  _L_z01_BeginShove_Exit
                            	  7920:     ; Store the shove direction we determined.
                            	  7921:     ;
                            	  7922:     ; Turn on the high bit to indicate that the next time we try to
                            	  7923:     ; move by shoving, it will be the first time for this shove action.
                            	  7924:     ;
02:000321C8 102C0008        	  7925:     move.b  ($0008,A4),D0
02:000321CC 00000080        	  7926:     ori.b #$80,D0
02:000321D0 194000C0        	  7927:     move.b  D0,($00C0,A4)
                            	  7928:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7929:     ;
02:000321D4 7018            	  7930:     moveq   #24,D0
02:000321D6 194004F0        	  7931:     move.b  D0,($04F0,A4)
02:000321DA 7020            	  7932:     moveq   #32,D0
02:000321DC 194000D3        	  7933:     move.b  D0,($00D3,A4)
                            	  7934:     ; If Link was shoved by one of his own weapons, then
                            	  7935:     ; nothing else to do. Return.
                            	  7936:     ;
02:000321E0 0C02000D        	  7937:     cmpi.b  #$0D,D2
02:000321E4 6430            	  7938:     bcc  _L_z01_BeginShove_Exit
                            	  7939:     ; Link was shoved by a monster.
                            	  7940:     ;
                            	  7941:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7942:     ; then return.
                            	  7943:     ;
02:000321E6 41EC04BF        	  7944:     lea     ($04BF,A4),A0
02:000321EA 10302000        	  7945:     move.b  (A0,D2.W),D0
02:000321EE 02000080        	  7946:     andi.b #$80,D0
02:000321F2 6622            	  7947:     bne  _L_z01_BeginShove_Exit
                            	  7948:     ; If the attacker is a vire, then return.
                            	  7949:     ;
02:000321F4 41EC034F        	  7950:     lea     ($034F,A4),A0
02:000321F8 10302000        	  7951:     move.b  (A0,D2.W),D0
02:000321FC 0C000012        	  7952:     cmpi.b  #$12,D0
02:00032200 6714            	  7953:     beq  _L_z01_BeginShove_Exit
                            	  7954:     ; Turn the attacker in the opposite direction.
                            	  7955:     ;
02:00032202 41EC0098        	  7956:     lea     ($0098,A4),A0
02:00032206 10302000        	  7957:     move.b  (A0,D2.W),D0
02:0003220A 6100E7A8        	  7958:     jsr     GetOppositeDir
02:0003220E 41EC0098        	  7959:     lea     ($0098,A4),A0
02:00032212 11802000        	  7960:     move.b  D0,(A0,D2.W)
                            	  7961:     even
