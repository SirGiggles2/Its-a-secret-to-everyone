02:000446BE 10302000        	  7521:     move.b  (A0,D2.W),D0
02:000446C2 1880            	  7522:     move.b  D0,($0000,A4)
02:000446C4 41F90004A999    	  7523:     lea     (PlayAreaColumnAddrs+1).l,A0
02:000446CA 10302000        	  7524:     move.b  (A0,D2.W),D0
02:000446CE 19400001        	  7525:     move.b  D0,($0001,A4)
02:000446D2 1003            	  7526:     move.b  D3,D0
02:000446D4 003C0011        	  7527:     ori     #$11,CCR  ; SEC: set C+X
02:000446D8 123C0040        	  7528:     move.b  #$40,D1
02:000446DC 0A3C0010        	  7529:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000446E0 9101            	  7530:     subx.b  D1,D0   ; SBC #$40
02:000446E2 0A3C0010        	  7531:     eori    #$10,CCR  ; restore X = 6502 C
02:000446E6 E208            	  7532:     lsr.b  #1,D0   ; LSR A
02:000446E8 E208            	  7533:     lsr.b  #1,D0   ; LSR A
02:000446EA E208            	  7534:     lsr.b  #1,D0   ; LSR A
02:000446EC 7600            	  7535:     moveq   #0,D3
02:000446EE 1600            	  7536:     move.b  D0,D3
02:000446F0 1214            	  7537:     move.b  ($00,A4),D1   ; ptr lo
02:000446F2 182C0001        	  7538:     move.b  ($01,A4),D4  ; ptr hi
02:000446F6 024100FF        	  7539:     andi.w  #$00FF,D1         ; zero-extend lo byte
