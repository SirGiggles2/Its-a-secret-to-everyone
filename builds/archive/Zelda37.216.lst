02:0002DF20 023C00EE        	   678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DF24 123C0004        	   679:     move.b  #$04,D1
02:0002DF28 D101            	   680:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
