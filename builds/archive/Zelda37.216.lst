                            	  7686: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7687:     ; Else Link is facing horizontally.
                            	  7688:     ; [04] := (weapon X + 8)
                            	  7689:     ; A    := (weapon Y + 6)
                            	  7690:     ;
                            	  7691:     ; Shouldn't it be based on the weapon's direction?
                            	  7692:     ;
02:000320A8 10343070        	  7693:     move.b  ($70,A4,D3.W),D0
02:000320AC 023C00EE        	  7694:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320B0 123C0008        	  7695:     move.b  #$08,D1
02:000320B4 D101            	  7696:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000320B6 19400004        	  7697:     move.b  D0,($0004,A4)
02:000320BA 41EC0084        	  7698:     lea     ($0084,A4),A0
02:000320BE 10303000        	  7699:     move.b  (A0,D3.W),D0
02:000320C2 023C00EE        	  7700:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320C6 123C0006        	  7701:     move.b  #$06,D1
02:000320CA D101            	  7702:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7703: _anon_z01_98:
                            	  7704:     ; The A register will be copied to [05] and used here.
                            	  7705:     ;
02:000320CC 6000FC08        	  7706:     jmp     CheckMonsterWeaponCollision
                            	  7707: 
                            	  7708: ; Params:
                            	  7709: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7710: ; [00]: weapon object slot (unused)
                            	  7711: ; [02]: object 1 mid X
                            	  7712: ; [03]: object 1 mid Y
                            	  7713: ; [04]: object 2 mid X
                            	  7714: ; [05]: object 2 mid Y
                            	  7715: ;
                            	  7716: ; Returns:
                            	  7717: ; A: 1 if objects collide
                            	  7718: ; Y: weapon object slot
                            	  7719: ; Z: 0 if objects collide
                            	  7720: ; [06]: 1 if objects collide
                            	  7721: ; [0A]: horizontal distance
                            	  7722: ; [0B]: vertical distance
                            	  7723: ;
                            	  7724: ;
                            	  7725: ; Use the same threshold value horizontally and vertically.
                            	  7726: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7727: ;
                            	  7728:     even
                            	  7729: DoObjectsCollide:
02:000320D0 1940000D        	  7730:     move.b  D0,($000D,A4)
02:000320D4 1940000E        	  7731:     move.b  D0,($000E,A4)
                            	  7732: ; Params:
                            	  7733: ; [00]: weapon or Link object slot (unused)
                            	  7734: ; [02]: object 1 mid X
                            	  7735: ; [03]: object 1 mid Y
                            	  7736: ; [04]: object 2 mid X
                            	  7737: ; [05]: object 2 mid Y
                            	  7738: ; [0D]: horizontal threshold
                            	  7739: ; [0E]: vertical threshold
                            	  7740: ;
                            	  7741: ; Returns:
                            	  7742: ; A: 1 if objects collide
                            	  7743: ; Y: weapon or Link object slot (copied from [00])
                            	  7744: ; Z: 0 if objects collide
                            	  7745: ; [06]: 1 if objects collide
                            	  7746: ; [0A]: horizontal distance
                            	  7747: ; [0B]: vertical distance
                            	  7748: ;
                            	  7749: ;
                            	  7750: ; Reset [06] to indicate no collision by default.
                            	  7751: ;
                            	  7752:     even
                            	  7753: DoObjectsCollideWithThresholds:
02:000320D8 7000            	  7754:     moveq   #0,D0
02:000320DA 19400006        	  7755:     move.b  D0,($0006,A4)
02:000320DE 7600            	  7756:     moveq   #0,D3
02:000320E0 1614            	  7757:     move.b  ($0000,A4),D3
                            	  7758:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7759:     ;
02:000320E2 102C0002        	  7760:     move.b  ($0002,A4),D0
02:000320E6 003C0011        	  7761:     ori     #$11,CCR  ; SEC: set C+X
02:000320EA 122C0004        	  7762:     move.b  ($0004,A4),D1
02:000320EE 0A3C0010        	  7763:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320F2 9101            	  7764:     subx.b  D1,D0   ; SBC $04
02:000320F4 0A3C0010        	  7765:     eori    #$10,CCR  ; restore X = 6502 C
02:000320F8 6100E8BE        	  7766:     jsr     Abs
02:000320FC 1940000A        	  7767:     move.b  D0,($000A,A4)
                            	  7768:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7769:     ;
02:00032100 122C000D        	  7770:     move.b  ($000D,A4),D1
02:00032104 B001            	  7771:     cmp.b   D1,D0
02:00032106 642A            	  7772:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7773:     ; Store in [0B] the vertical distance between the two objects.
                            	  7774:     ;
02:00032108 102C0003        	  7775:     move.b  ($0003,A4),D0
02:0003210C 003C0011        	  7776:     ori     #$11,CCR  ; SEC: set C+X
02:00032110 122C0005        	  7777:     move.b  ($0005,A4),D1
02:00032114 0A3C0010        	  7778:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032118 9101            	  7779:     subx.b  D1,D0   ; SBC $05
02:0003211A 0A3C0010        	  7780:     eori    #$10,CCR  ; restore X = 6502 C
02:0003211E 6100E898        	  7781:     jsr     Abs
02:00032122 1940000B        	  7782:     move.b  D0,($000B,A4)
                            	  7783:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7784:     ;
02:00032126 122C000E        	  7785:     move.b  ($000E,A4),D1
02:0003212A B001            	  7786:     cmp.b   D1,D0
02:0003212C 6404            	  7787:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7788:     ; If we get here, then the objects are close enough in both axes.
                            	  7789:     ; Return 1.
                            	  7790:     ;
02:0003212E 522C0006        	  7791:     addq.b  #1,($0006,A4)
                            	  7792:     even
                            	  7793: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:00032132 102C0006        	  7794:     move.b  ($0006,A4),D0
02:00032136 4E75            	  7795:     rts
                            	  7796: 
                            	  7797: ; Params:
                            	  7798: ; X: caller's object index, a monster
                            	  7799: ;    the attacker, if monster attacks Link
                            	  7800: ;    else defender, if weapon attacks monster
                            	  7801: ; [00]: 0 if monster attacks Link (defender),
                            	  7802: ;       else weapon slot (attacker)
                            	  7803: ; [09]: damage type,
                            	  7804: ;       only if a monster is defending
                            	  7805: ; TODO:
                            	  7806: ; [0B]: direction
                            	  7807: ;
                            	  7808: ; Only monsters (and fire) call this routine.
                            	  7809: ;
                            	  7810: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7811: ;
                            	  7812: ; On the other hand, if a weapon attacks a monster,
                            	  7813: ; the monster sets [00] to the weapon's slot.
                            	  7814: ;
                            	  7815: ;
                            	  7816: ; If a weapon attacks a monster, and the weapon's damage
                            	  7817: ; type matches the monster's invincibility mask;
                            	  7818: ; then return without shoving.
                            	  7819: ;
                            	  7820: ; If a monster attacks Link, then damage type will be 0.
                            	  7821: ;
                            	  7822:     even
                            	  7823: BeginShove:
02:00032138 7600            	  7824:     moveq   #0,D3
02:0003213A 1614            	  7825:     move.b  ($0000,A4),D3
02:0003213C 0C02000D        	  7826:     cmpi.b  #$0D,D2
02:00032140 6412            	  7827:     bcc  _anon_z01_99
02:00032142 41EC04B2        	  7828:     lea     ($04B2,A4),A0
02:00032146 10302000        	  7829:     move.b  (A0,D2.W),D0
02:0003214A 122C0009        	  7830:     move.b  ($0009,A4),D1
02:0003214E C001            	  7831:     and.b  D1,D0
02:00032150 660000C4        	  7832:     bne  _L_z01_BeginShove_Exit
                            	  7833: _anon_z01_99:
                            	  7834:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7835:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7836:     ;
                            	  7837:     ; If instead a monster is defending, then all this calculation
                            	  7838:     ; won't matter, because the shove direction will be set to the
                            	  7839:     ; weapon's direction.
                            	  7840:     ;
                            	  7841:     ; As such, calculate a direction from the monster to the defender,
                            	  7842:     ; assuming it's Link.
                            	  7843:     ;
                            	  7844:     ; Start with an assumption that the direction is vertical:
                            	  7845:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7846:     ;
02:00032154 7008            	  7847:     moveq   #8,D0
02:00032156 19400008        	  7848:     move.b  D0,($0008,A4)
02:0003215A 41EC0084        	  7849:     lea     ($0084,A4),A0
02:0003215E 10302000        	  7850:     move.b  (A0,D2.W),D0
02:00032162 19400004        	  7851:     move.b  D0,($0004,A4)
02:00032166 41EC0084        	  7852:     lea     ($0084,A4),A0
02:0003216A 10303000        	  7853:     move.b  (A0,D3.W),D0
02:0003216E 19400005        	  7854:     move.b  D0,($0005,A4)
                            	  7855:     ; If the defender is Link and his grid offset <> 0 then
                            	  7856:     ; use his usual object direction variable to determine
                            	  7857:     ; which axis to check.
                            	  7858:     ;
02:00032172 4A03            	  7859:     cmpi.b  #$00,D3
02:00032174 6612            	  7860:     bne  _anon_z01_100
02:00032176 102C0394        	  7861:     move.b  ($0394,A4),D0
02:0003217A 670C            	  7862:     beq  _anon_z01_100
02:0003217C 102C0098        	  7863:     move.b  ($0098,A4),D0
02:00032180 02000003        	  7864:     andi.b #$03,D0
02:00032184 660C            	  7865:     bne  _L_z01_BeginShove_CheckHorizontal
