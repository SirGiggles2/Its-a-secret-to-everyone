                            	  4102: UpdatePondFairy:
02:0003B1E2 6100499E        	  4103:     jsr     DrawFairy
                            	  4104:     ; If not in state 0, then go handle states 1 to 3.
                            	  4105:     ;
02:0003B1E6 102C00AD        	  4106:     move.b  ($00AD,A4),D0
02:0003B1EA 6702            	  4107:     beq.s  __far_z_04_0037
