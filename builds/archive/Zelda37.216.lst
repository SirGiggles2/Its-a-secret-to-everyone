02:00031BC6 1941000D        	  6908:     move.b  D1,($000D,A4)
02:00031BCA 122C000E        	  6909:     move.b  ($000E,A4),D1
02:00031BCE E211            	  6910:     roxr.b  #1,D1   ; ROR $0E
02:00031BD0 1941000E        	  6911:     move.b  D1,($000E,A4)
02:00031BD4 5303            	  6912:     subq.b  #1,D3
02:00031BD6 66E8            	  6913:     bne  _anon_z01_86
