                            	  4542: 
                            	  4543: GoWalkableDir:
                            	  4544:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4545:     ; makes the object cross a boundary. Then go check another direction if it does,
                            	  4546:     ; or else make this the object direction.
                            	  4547:     ;
02:0004C0BA 4A02            	  4548:     cmpi.b  #$00,D2
02:0004C0BC 6704            	  4549:     beq.s  __far_z_07_0061
02:0004C0BE 60000092        	  4550:     jmp  CheckBoundary
                            	  4551: __far_z_07_0061:
                            	  4552:     ; The object is Link. We end up here regardless of walkability.
                            	  4553:     ;
