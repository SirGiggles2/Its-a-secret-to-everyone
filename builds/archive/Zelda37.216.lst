02:0003A684 41EC0451        	  2472:     lea     ($0451,A4),A0
02:0003A688 11802000        	  2473:     move.b  D0,(A0,D2.W)
                            	  2474:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2475:     ;
02:0003A68C 6728            	  2476:     beq  _L_z04__TryShooting_SetSpeed
                            	  2477:     ; shoot timer <> 0
                            	  2478:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2479:     ;
02:0003A68E 0C030010        	  2480:     cmpi.b  #$10,D3
02:0003A692 661C            	  2481:     bne  _L_z04__TryShooting_ZeroSpeed
