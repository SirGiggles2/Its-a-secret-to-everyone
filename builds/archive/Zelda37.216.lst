                            	  6826: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6827:     ; Link and the shot are facing opposite directions.
                            	  6828:     ; Link can parry certain weapons/shots.
                            	  6829:     ;
                            	  6830:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6831:     ; no harmful collision; but it still counts as a shot collision.
                            	  6832:     ; So, go treat this as a parry.
                            	  6833:     ;
02:00031B48 41EC034F        	  6834:     lea     ($034F,A4),A0
02:00031B4C 10302000        	  6835:     move.b  (A0,D2.W),D0
02:00031B50 0C000055        	  6836:     cmpi.b  #$55,D0
02:00031B54 650E            	  6837:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031B56 0C00005B        	  6838:     cmpi.b  #$5B,D0
02:00031B5A 6408            	  6839:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6840:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6841:     ; So, go harm Link.
                            	  6842:     ;
02:00031B5C 102C0676        	  6843:     move.b  ($0676,A4),D0
02:00031B60 6602            	  6844:     bne.s  __far_z_01_0070
02:00031B62 600E            	  6845:     jmp  HarmLink
                            	  6846: __far_z_01_0070:
