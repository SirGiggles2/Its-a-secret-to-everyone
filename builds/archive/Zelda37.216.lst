02:0002FC4A 0C0000F0        	  2492:     cmpi.b  #$F0,D0
02:0002FC4E 6518            	  2493:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2494:     ; The whirlwind has reached the right edge of the screen.
