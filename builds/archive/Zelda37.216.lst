02:0003613E E14C            	  4601:     lsl.w   #8,D4
02:00036140 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036142 48C4            	  4603:     ext.l   D4
02:00036144 D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003614A 2044            	  4605:     movea.l D4,A0
02:0003614C 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:00036150 0200003F        	  4611:     andi.b #$3F,D0
