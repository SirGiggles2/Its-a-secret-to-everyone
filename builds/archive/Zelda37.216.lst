                            	  7668: Dodongo_Draw:
02:0003CB9A 610000F4        	  7669:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7670:     ; Make a 5-way direction index out of the facing direction
                            	  7671:     ; by shifting right once, and store it in [00].
                            	  7672:     ;
02:0003CB9E 41EC0098        	  7673:     lea     ($0098,A4),A0
02:0003CBA2 10302000        	  7674:     move.b  (A0,D2.W),D0
02:0003CBA6 E208            	  7675:     lsr.b  #1,D0   ; LSR A
02:0003CBA8 1880            	  7676:     move.b  D0,($0000,A4)
                            	  7677:     ; If state = 0, go handle animating the two frames of this state.
                            	  7678:     ;
02:0003CBAA 7600            	  7679:     moveq   #0,D3
02:0003CBAC 41EC00AC        	  7680:     lea     ($00AC,A4),A0
02:0003CBB0 16302000        	  7681:     move.b  (A0,D2.W),D3
02:0003CBB4 6744            	  7682:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7683:     ; If state > 1, then the monster is stunned (state 2).
                            	  7684:     ; So, go switch frames every $20 screen frames.
                            	  7685:     ;
02:0003CBB6 7020            	  7686:     moveq   #32,D0
02:0003CBB8 5303            	  7687:     subq.b  #1,D3
02:0003CBBA 6640            	  7688:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7689:     ; State = 1. Bloated.
                            	  7690:     ;
                            	  7691:     ; In substate 0, go animate as usual for walking.
                            	  7692:     ;
02:0003CBBC 7600            	  7693:     moveq   #0,D3
02:0003CBBE 41EC042C        	  7694:     lea     ($042C,A4),A0
02:0003CBC2 16302000        	  7695:     move.b  (A0,D2.W),D3
02:0003CBC6 6732            	  7696:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7697:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7698:     ; go fade the boss; so that some frames are not drawn.
                            	  7699:     ;
02:0003CBC8 0C030002        	  7700:     cmpi.b  #$02,D3
02:0003CBCC 6718            	  7701:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CBCE 0C030003        	  7702:     cmpi.b  #$03,D3
02:0003CBD2 6712            	  7703:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7704:     ; State 1, substate 1
                            	  7705:     ;
                            	  7706:     ; Add $14 to the frame image index to index into the bloated
                            	  7707:     ; frame images and H-flips.
                            	  7708:     ;
02:0003CBD4 1014            	  7709:     move.b  ($0000,A4),D0
02:0003CBD6 023C00EE        	  7710:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBDA 123C0014        	  7711:     move.b  #$14,D1
02:0003CBDE D101            	  7712:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CBE0 7600            	  7713:     moveq   #0,D3
02:0003CBE2 1600            	  7714:     move.b  D0,D3
02:0003CBE4 6032            	  7715:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7716: 
                            	  7717:     even
                            	  7718: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7719:     ; In bloated substates 2 and 3:
                            	  7720:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7721:     ;
02:0003CBE6 102C0015        	  7722:     move.b  ($0015,A4),D0
02:0003CBEA 02000002        	  7723:     andi.b #$02,D0
02:0003CBEE 6604            	  7724:     bne.s  __far_z_04_0071
02:0003CBF0 600000A6        	  7725:     jmp  L11B00_Exit
                            	  7726: __far_z_04_0071:
02:0003CBF4 7600            	  7727:     moveq   #0,D3
02:0003CBF6 1614            	  7728:     move.b  ($0000,A4),D3
02:0003CBF8 601E            	  7729:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7730: 
                            	  7731:     even
                            	  7732: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7733:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7734:     ;
02:0003CBFA 7008            	  7735:     moveq   #8,D0
                            	  7736:     even
                            	  7737: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CBFC 7600            	  7738:     moveq   #0,D3
02:0003CBFE 1614            	  7739:     move.b  ($0000,A4),D3
02:0003CC00 122C0015        	  7740:     move.b  ($0015,A4),D1
02:0003CC04 C001            	  7741:     and.b  D1,D0
02:0003CC06 6710            	  7742:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7743:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7744:     ; in order to index into the second set of frame image numbers.
                            	  7745:     ;
02:0003CC08 1003            	  7746:     move.b  D3,D0
02:0003CC0A 023C00EE        	  7747:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC0E 123C0005        	  7748:     move.b  #$05,D1
02:0003CC12 D101            	  7749:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC14 7600            	  7750:     moveq   #0,D3
02:0003CC16 1600            	  7751:     move.b  D0,D3
                            	  7752:     even
                            	  7753: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7754:     ; Start preparing sprites.
                            	  7755:     ;
02:0003CC18 4EB90004D2EC    	  7756:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC1E 1003            	  7757:     move.b  D3,D0
02:0003CC20 1B00            	  7758:     move.b  D0,-(A5)  ; PHA
                            	  7759:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7760:     ;
02:0003CC22 41F90003CB7C    	  7761:     lea     (DodongoFrameHFlips).l,A0
02:0003CC28 10303000        	  7762:     move.b  (A0,D3.W),D0
02:0003CC2C 1940000F        	  7763:     move.b  D0,($000F,A4)
02:0003CC30 41F90003CB72    	  7764:     lea     (DodongoFrameImages).l,A0
02:0003CC36 10303000        	  7765:     move.b  (A0,D3.W),D0
                            	  7766:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7767:     ; They are drawn mirrored.
                            	  7768:     ;
02:0003CC3A 0C000007        	  7769:     cmpi.b  #$07,D0
02:0003CC3E 6706            	  7770:     beq  _anon_z04_92
02:0003CC40 0C000009        	  7771:     cmpi.b  #$09,D0
02:0003CC44 6608            	  7772:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7773: _anon_z04_92:
02:0003CC46 4EB90003157A    	  7774:     jsr     DrawObjectMirrored
02:0003CC4C 6006            	  7775:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7776: 
                            	  7777:     even
                            	  7778: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7779:     ; No other frame images are mirrored.
                            	  7780:     ;
02:0003CC4E 4EB90003157E    	  7781:     jsr     DrawObjectNotMirrored
                            	  7782:     even
                            	  7783: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CC54 101D            	  7784:     move.b  (A5)+,D0  ; PLA
02:0003CC56 7600            	  7785:     moveq   #0,D3
02:0003CC58 1600            	  7786:     move.b  D0,D3
                            	  7787:     ; If facing vertically, then return. There's no other side to draw.
                            	  7788:     ;
02:0003CC5A 41EC0098        	  7789:     lea     ($0098,A4),A0
02:0003CC5E 10302000        	  7790:     move.b  (A0,D2.W),D0
02:0003CC62 02000003        	  7791:     andi.b #$03,D0
02:0003CC66 6602            	  7792:     bne.s  __far_z_04_0072
02:0003CC68 602E            	  7793:     jmp  L11B00_Exit
                            	  7794: __far_z_04_0072:
                            	  7795:     ; Else draw the right side.
                            	  7796:     ;
                            	  7797:     ; Keep the Y coordinate in [01].
                            	  7798:     ; But, store (X + $10) in [00].
                            	  7799:     ;
02:0003CC6A 10342070        	  7800:     move.b  ($70,A4,D2.W),D0
02:0003CC6E 023C00EE        	  7801:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC72 123C0010        	  7802:     move.b  #$10,D1
02:0003CC76 D101            	  7803:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CC78 1880            	  7804:     move.b  D0,($0000,A4)
02:0003CC7A 6114            	  7805:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7806:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7807:     ;
                            	  7808:     ; So, if we had animation frame 1, direction left:
                            	  7809:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7810:     ; - frame image index = 6 (1 + 5)
                            	  7811:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7812:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7813:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7814:     ;
                            	  7815:     ; So, 3 would have been the frame number used above for
                            	  7816:     ; the left side.
                            	  7817:     ;
                            	  7818:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7819:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7820:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7821:     ; on the right.
                            	  7822:     ;
02:0003CC7C 41F90003CB72    	  7823:     lea     (DodongoFrameImages).l,A0
02:0003CC82 10303000        	  7824:     move.b  (A0,D3.W),D0
02:0003CC86 0A000001        	  7825:     eori.b #$01,D0
02:0003CC8A 4EF90003157E    	  7826:     jmp     DrawObjectNotMirrored
                            	  7827: 
                            	  7828: ; Returns:
                            	  7829: ; A: 3
                            	  7830: ; [04]: left sprite attributes
                            	  7831: ; [05]: right sprite attributes
                            	  7832: ;
                            	  7833:     even
                            	  7834: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CC90 7003            	  7835:     moveq   #3,D0
02:0003CC92 4EB900031870    	  7836:     jsr     Anim_SetSpriteDescriptorAttributes
