                            	  4887: UpdatePeaceTextbox:
                            	  4888:     ; Only emit a character once every 8 frames --
                            	  4889:     ; when (counter [0412] MOD 8) = 4.
                            	  4890:     ;
02:000363AE 522C0412        	  4891:     addq.b  #1,($0412,A4)
02:000363B2 102C0412        	  4892:     move.b  ($0412,A4),D0
02:000363B6 02000007        	  4893:     andi.b #$07,D0
02:000363BA 0C000004        	  4894:     cmpi.b  #$04,D0
02:000363BE 665C            	  4895:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4896:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4897:     ; to the dynamic transfer buf.
                            	  4898:     ;
02:000363C0 7604            	  4899:     moveq   #4,D3
                            	  4900: _anon_z02_35:
02:000363C2 41F90003633E    	  4901:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
