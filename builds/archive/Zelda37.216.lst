02:0003B216 4E75            	  4133:     rts
                            	  4134: 
                            	  4135:     even
                            	  4136: PondFairy_HandleOtherStates:
02:0003B218 0C000001        	  4137:     cmpi.b  #$01,D0
02:0003B21C 6610            	  4138:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4139:     ; State 1. Flying and filling hearts.
                            	  4140:     ;
                            	  4141:     ; If still filling hearts, then go draw Link and hearts.
                            	  4142:     ;
02:0003B21E 102C0063        	  4143:     move.b  ($0063,A4),D0
02:0003B222 6620            	  4144:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4145:     ; If not filling hearts anymore, then go to state 2,
                            	  4146:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4147:     ; a little while after we finish filling hearts.
                            	  4148:     ;
02:0003B224 522C00AD        	  4149:     addq.b  #1,($00AD,A4)
02:0003B228 7050            	  4150:     moveq   #80,D0
02:0003B22A 19400029        	  4151:     move.b  D0,($0029,A4)
                            	  4152:     even
                            	  4153: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4154:     ; If state <> 2 (so, it's 3), then return.
                            	  4155:     ;
                            	  4156:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4157:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4158:     ; was set to, and we'll return.
                            	  4159:     ;
02:0003B22E 0C000002        	  4160:     cmpi.b  #$02,D0
02:0003B232 6634            	  4161:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4162:     ; State = 2.
                            	  4163:     ;
                            	  4164:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4165:     ;
02:0003B234 102C0029        	  4166:     move.b  ($0029,A4),D0
02:0003B238 660A            	  4167:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4168:     ; Else go to state 3, and unhalt Link.
                            	  4169:     ;
02:0003B23A 522C00AD        	  4170:     addq.b  #1,($00AD,A4)
02:0003B23E 7000            	  4171:     moveq   #0,D0
02:0003B240 194000AC        	  4172:     move.b  D0,($00AC,A4)
                            	  4173:     even
                            	  4174: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4175:     ; TODO: but why, since Link is halted?
                            	  4176:     ;
                            	  4177:     ; Reset the input direction, so that Link doesn't animate
                            	  4178:     ; when drawing him.
