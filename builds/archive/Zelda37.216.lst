                            	  2545: __far_z_01_0017:
                            	  2546:     ; If we have gotten this triforce piece, then go try to make a
                            	  2547:     ; whirlwind.
                            	  2548:     ;
02:0002FCA0 1214            	  2549:     move.b  ($0000,A4),D1
02:0002FCA2 C200            	  2550:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002FCA4 662C            	  2551:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2552:     ; We have not gotten this piece.
                            	  2553:     ; First, advance the teleporting index again.
                            	  2554:     ;
02:0002FCA6 6150            	  2555:     jsr     AdvanceTeleportingLevelIndex
                            	  2556:     ; If the direction Link is facing is an increasing one, then
                            	  2557:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2558:     ; level number. Then go test this new mask.
                            	  2559:     ;
02:0002FCA8 102C0098        	  2560:     move.b  ($0098,A4),D0
02:0002FCAC 02000009        	  2561:     andi.b #$09,D0
02:0002FCB0 6710            	  2562:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0002FCB2 1214            	  2563:     move.b  ($0000,A4),D1
02:0002FCB4 E309            	  2564:     lsl.b  #1,D1   ; ASL $00
02:0002FCB6 1881            	  2565:     move.b  D1,($0000,A4)
02:0002FCB8 64DE            	  2566:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FCBA 1214            	  2567:     move.b  ($0000,A4),D1
02:0002FCBC E311            	  2568:     roxl.b  #1,D1   ; ROL $00
02:0002FCBE 1881            	  2569:     move.b  D1,($0000,A4)
02:0002FCC0 60D6            	  2570:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2571: 
                            	  2572:     even
                            	  2573: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2574:     ; If instead the direction is a decreasing one, then
                            	  2575:     ; rotate right to correspond to the lower level number.
                            	  2576:     ; Then go test this new mask.
                            	  2577:     ;
02:0002FCC2 1214            	  2578:     move.b  ($0000,A4),D1
02:0002FCC4 E209            	  2579:     lsr.b  #1,D1   ; LSR $00
02:0002FCC6 1881            	  2580:     move.b  D1,($0000,A4)
02:0002FCC8 64CE            	  2581:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0002FCCA 1214            	  2582:     move.b  ($0000,A4),D1
02:0002FCCC E211            	  2583:     roxr.b  #1,D1   ; ROR $00
02:0002FCCE 1881            	  2584:     move.b  D1,($0000,A4)
02:0002FCD0 60C6            	  2585:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2586: 
