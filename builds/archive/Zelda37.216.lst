                            	  4447: CheckTiles:
                            	  4448:     ifne TURBO_LINK
                            	  4449:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4450:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004C050 4A02            	  4451:     tst.b   D2
02:0004C052 6608            	  4452:     bne.s   _L_z07_CheckTiles_notLink
02:0004C054 197C0024049E    	  4453:     move.b  #$24,($049E,A4)
02:0004C05A 605E            	  4454:     jmp     GoWalkableDir
                            	  4455: _L_z07_CheckTiles_notLink:
                            	  4456:     endc
                            	  4457:     ; The code below applies to Link and other objects.
                            	  4458:     ;
                            	  4459:     ; Test the moving direction's walkability.
                            	  4460:     ;
                            	  4461:     ; For the player, this is enough. For other objects, this 
                            	  4462:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4463:     ;
                            	  4464:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4465:     ;
02:0004C05C 6100F9D4        	  4466:     jsr     GetCollidingTileMoving
02:0004C060 122C034A        	  4467:     move.b  ($034A,A4),D1
02:0004C064 B001            	  4468:     cmp.b   D1,D0
02:0004C066 6402            	  4469:     bcc.s  __far_z_07_0056
02:0004C068 6050            	  4470:     jmp  GoWalkableDir
                            	  4471: __far_z_07_0056:
                            	  4472:     ; The colliding tile is unwalkable.
                            	  4473:     ;
                            	  4474:     ; If object is the player, then go check passive tile objects and
                            	  4475:     ; the screen edge, or stop moving.
                            	  4476:     ;
02:0004C06A 4A02            	  4477:     cmpi.b  #$00,D2
02:0004C06C 6602            	  4478:     bne.s  __far_z_07_0057
02:0004C06E 6022            	  4479:     jmp  PlayerUnwalkable
                            	  4480: __far_z_07_0057:
                            	  4481:     even
                            	  4482: CheckObjAttr10AndAltDir:
                            	  4483:     ; Not the player.
                            	  4484:     ; If object attribute has $10, go to the unused code above
                            	  4485:     ; to reverse direction.
                            	  4486:     ;
02:0004C070 41EC04BF        	  4487:     lea     ($04BF,A4),A0
02:0004C074 10302000        	  4488:     move.b  (A0,D2.W),D0
02:0004C078 02000010        	  4489:     andi.b #$10,D0
02:0004C07C 6702            	  4490:     beq.s  __far_z_07_0058
02:0004C07E 60C8            	  4491:     jmp  Reverse
                            	  4492: __far_z_07_0058:
                            	  4493:     even
