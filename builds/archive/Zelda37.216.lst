02:0004C084 1940000F        	  4499:     move.b  D0,($000F,A4)
02:0004C088 102C000E        	  4500:     move.b  ($000E,A4),D0
02:0004C08C 6702            	  4501:     beq.s  __far_z_07_0059
02:0004C08E 60C0            	  4502:     jmp  CheckTiles
