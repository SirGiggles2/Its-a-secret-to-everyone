                            	  5899: _L_z01_CheckMazes_PlaySecretTune:
                            	  5900:     ; Play secret tune, and let the player leave the maze.
                            	  5901:     ;
02:00031318 7004            	  5902:     moveq   #4,D0
02:0003131A 19400602        	  5903:     move.b  D0,($0602,A4)
02:0003131E 4E75            	  5904:     rts
                            	  5905: 
                            	  5906: ; Params:
                            	  5907: ; [02]: Y
                            	  5908: ; [03]: X
                            	  5909: ;
                            	  5910: ; Returns:
                            	  5911: ; [00]: high byte of PPU address
                            	  5912: ; [01]: low byte of PPU address
                            	  5913: ;
                            	  5914: ;
                            	  5915: ; Turn the 16-bit value 08YY into the PPU address
                            	  5916: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5917: ;
                            	  5918: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5919: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5920: ;
                            	  5921:     even
                            	  5922: MapScreenPosToPpuAddr:
02:00031320 6000A744        	  5923:     jmp     c_map_screen_pos_to_ppu_addr
