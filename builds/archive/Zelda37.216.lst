                            	  2929: __far_z_04_0024:
                            	  2930:     ; Going down. We have to consider the target Y.
                            	  2931:     ;
                            	  2932:     ; If the absolute vertical distance to the target position >= 3,
                            	  2933:     ; then go animate, draw, and check collisions.
                            	  2934:     ;
02:0003A98A 41EC0084        	  2935:     lea     ($0084,A4),A0
02:0003A98E 10302000        	  2936:     move.b  (A0,D2.W),D0
02:0003A992 003C0011        	  2937:     ori     #$11,CCR  ; SEC: set C+X
02:0003A996 41EC0444        	  2938:     lea     ($0444,A4),A0
02:0003A99A 12302000        	  2939:     move.b  (A0,D2.W),D1
02:0003A99E 0A3C0010        	  2940:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A9A2 9101            	  2941:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003A9A4 0A3C0010        	  2942:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A9A8 4EB9000309B8    	  2943:     jsr     Abs
02:0003A9AE 0C000003        	  2944:     cmpi.b  #$03,D0
