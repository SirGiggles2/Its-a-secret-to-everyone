02:0003A450 003C0011        	  2123:     ori     #$11,CCR  ; SEC: set C+X
02:0003A454 12343002        	  2124:     move.b  ($02,A4,D3.W),D1
02:0003A458 0A3C0010        	  2125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A45C 9101            	  2126:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A45E 0A3C0010        	  2127:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A462 0C000018        	  2128:     cmpi.b  #$18,D0
02:0003A466 6A10            	  2129:     bpl  _anon_z04_31
02:0003A468 0C0000E8        	  2130:     cmpi.b  #$E8,D0
