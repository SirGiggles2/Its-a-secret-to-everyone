                            	  4995: UpdateBombFlashEffect:
                            	  4996:     ; If state <> $13, return.
                            	  4997:     ;
02:00030CB8 41EC00AC        	  4998:     lea     ($00AC,A4),A0
02:00030CBC 10302000        	  4999:     move.b  (A0,D2.W),D0
02:00030CC0 0C000013        	  5000:     cmpi.b  #$13,D0
02:00030CC4 662E            	  5001:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  5002:     ; The effect involves turning grayscale rendering on and off
                            	  5003:     ; in PPUMASK.
                            	  5004:     ;
                            	  5005:     ; Start by setting A register to the PPU mask shifted right to
                            	  5006:     ; throw away the grayscale bit.
                            	  5007:     ;
02:00030CC6 102C00FE        	  5008:     move.b  ($00FE,A4),D0
02:00030CCA E208            	  5009:     lsr.b  #1,D0   ; LSR A
                            	  5010:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  5011:     ;
02:00030CCC 7600            	  5012:     moveq   #0,D3
02:00030CCE 16342028        	  5013:     move.b  ($28,A4,D2.W),D3
                            	  5014:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  5015:     ; Carry will have been set, because of the comparison (CPY).
                            	  5016:     ;
02:00030CD2 0C030016        	  5017:     cmpi.b  #$16,D3
02:00030CD6 6706            	  5018:     beq  _anon_z01_54
02:00030CD8 0C030011        	  5019:     cmpi.b  #$11,D3
02:00030CDC 6604            	  5020:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  5021: _anon_z01_54:
02:00030CDE E310            	  5022:     roxl.b  #1,D0   ; ROL A
02:00030CE0 600E            	  5023:     jmp     _L_z01_UpdateBombFlashEffect_SetMask
                            	  5024: 
                            	  5025:     even
                            	  5026: _L_z01_UpdateBombFlashEffect_Clear:
                            	  5027:     ; At times $12 and $D, shift left to make the low bit 0.
                            	  5028:     ;
02:00030CE2 0C030012        	  5029:     cmpi.b  #$12,D3
02:00030CE6 6706            	  5030:     beq  _anon_z01_55
02:00030CE8 0C03000D        	  5031:     cmpi.b  #$0D,D3
02:00030CEC 6606            	  5032:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  5033: _anon_z01_55:
02:00030CEE E308            	  5034:     lsl.b  #1,D0   ; ASL A
                            	  5035:     even
