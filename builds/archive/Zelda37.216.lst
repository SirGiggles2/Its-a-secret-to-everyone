02:0003A62E 0C000001        	  2406:     cmpi.b  #$01,D0
02:0003A632 6720            	  2407:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A634 0C000009        	  2408:     cmpi.b  #$09,D0
02:0003A638 671A            	  2409:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A63A 0C00000A        	  2410:     cmpi.b  #$0A,D0
02:0003A63E 6714            	  2411:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A640 41EC0451        	  2412:     lea     ($0451,A4),A0
02:0003A644 10302000        	  2413:     move.b  (A0,D2.W),D0
02:0003A648 660A            	  2414:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2415:     ; and a random value < $F8, then return.
