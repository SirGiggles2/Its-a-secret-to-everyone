                            	  3680:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  3681:     ;
02:0003AF46 7000            	  3682:     moveq   #0,D0
                            	  3683:     even
                            	  3684: _L_z04_UpdateOctorock_SaveOffset:
02:0003AF48 1B00            	  3685:     move.b  D0,-(A5)  ; PHA
                            	  3686:     ; Decrement the animation counter, and roll over if needed.
                            	  3687:     ;
02:0003AF4A 41EC03D0        	  3688:     lea     ($03D0,A4),A0
02:0003AF4E 53302000        	  3689:     subq.b  #1,(A0,D2.W)
02:0003AF52 661E            	  3690:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003AF54 7006            	  3691:     moveq   #6,D0
02:0003AF56 41EC03D0        	  3692:     lea     ($03D0,A4),A0
02:0003AF5A 11802000        	  3693:     move.b  D0,(A0,D2.W)
                            	  3694:     ; There are actually 6 frame images divided into 2 sets.
                            	  3695:     ; Each set depicts one animation frame. In each set there are
                            	  3696:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3697:     ;
                            	  3698:     ; The movement frame will keep track of the base offset of
                            	  3699:     ; the current set for the current animation frame: 0 or 3.
                            	  3700:     ;
                            	  3701:     ; So, XOR the movement frame with 3.
                            	  3702:     ;
02:0003AF5E E208            	  3703:     lsr.b  #1,D0   ; LSR A
02:0003AF60 41EC03E4        	  3704:     lea     ($03E4,A4),A0
02:0003AF64 12302000        	  3705:     move.b  (A0,D2.W),D1
02:0003AF68 B300            	  3706:     eor.b  D1,D0
02:0003AF6A 41EC03E4        	  3707:     lea     ($03E4,A4),A0
02:0003AF6E 11802000        	  3708:     move.b  D0,(A0,D2.W)
                            	  3709:     even
                            	  3710: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3711:     ; Add the base offset and the directional offset, and save the result.
                            	  3712:     ;
02:0003AF72 101D            	  3713:     move.b  (A5)+,D0  ; PLA
02:0003AF74 023C00EE        	  3714:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF78 41EC03E4        	  3715:     lea     ($03E4,A4),A0
02:0003AF7C 12302000        	  3716:     move.b  (A0,D2.W),D1
02:0003AF80 D101            	  3717:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AF82 1B00            	  3718:     move.b  D0,-(A5)  ; PHA
                            	  3719:     ; If facing vertically, go draw mirrored.
                            	  3720:     ;
02:0003AF84 41EC0098        	  3721:     lea     ($0098,A4),A0
02:0003AF88 10302000        	  3722:     move.b  (A0,D2.W),D0
02:0003AF8C 0200000C        	  3723:     andi.b #$0C,D0
02:0003AF90 660E            	  3724:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3725:     ; Else draw not mirrored.
                            	  3726:     ;
02:0003AF92 101D            	  3727:     move.b  (A5)+,D0  ; PLA
02:0003AF94 4EB90003157E    	  3728:     jsr     DrawObjectNotMirrored
02:0003AF9A 4EF9000318FA    	  3729:     jmp     CheckMonsterCollisions
                            	  3730: 
                            	  3731:     even
                            	  3732: _L_z04_UpdateOctorock_DrawMirrored:
02:0003AFA0 101D            	  3733:     move.b  (A5)+,D0  ; PLA
                            	  3734: ; Params:
                            	  3735: ; A: frame image
                            	  3736: ; X: object index
                            	  3737: ; [00]: object X
                            	  3738: ; [01]: object Y
                            	  3739: ;
                            	  3740:     even
                            	  3741: DrawObjectMirroredAndCheckCollisions:
02:0003AFA2 4EB90003157A    	  3742:     jsr     DrawObjectMirrored
02:0003AFA8 4EF9000318FA    	  3743:     jmp     CheckMonsterCollisions
                            	  3744: 
                            	  3745:     even
                            	  3746: UpdateGhini:
02:0003AFAE 103C00FF        	  3747:     move.b  #$FF,D0
02:0003AFB2 6100E75E        	  3748:     jsr     UpdateCommonWanderer
02:0003AFB6 6130            	  3749:     jsr     DrawGhiniAndCheckCollisions
02:0003AFB8 4EB9000318FA    	  3750:     jsr     CheckMonsterCollisions
                            	  3751:     ; If the monster is still alive, then return.
                            	  3752:     ;
02:0003AFBE 41EC0405        	  3753:     lea     ($0405,A4),A0
02:0003AFC2 10302000        	  3754:     move.b  (A0,D2.W),D0
02:0003AFC6 671E            	  3755:     beq  _L_z04_UpdateGhini_Exit
                            	  3756:     ; For each object slot from $B to 1:
                            	  3757:     ; If the object is a flying ghini ($22),
                            	  3758:     ; then kill it by setting metastate to $11.
                            	  3759:     ;
02:0003AFC8 760B            	  3760:     moveq   #11,D3
                            	  3761:     even
                            	  3762: _L_z04_UpdateGhini_LoopObject:
02:0003AFCA 41EC034F        	  3763:     lea     ($034F,A4),A0
02:0003AFCE 10303000        	  3764:     move.b  (A0,D3.W),D0
02:0003AFD2 0C000022        	  3765:     cmpi.b  #$22,D0
02:0003AFD6 660A            	  3766:     bne  _anon_z04_50
02:0003AFD8 7011            	  3767:     moveq   #17,D0
02:0003AFDA 41EC0405        	  3768:     lea     ($0405,A4),A0
02:0003AFDE 11803000        	  3769:     move.b  D0,(A0,D3.W)
                            	  3770: _anon_z04_50:
02:0003AFE2 5303            	  3771:     subq.b  #1,D3
02:0003AFE4 66E4            	  3772:     bne  _L_z04_UpdateGhini_LoopObject
                            	  3773:     even
                            	  3774: _L_z04_UpdateGhini_Exit:
02:0003AFE6 4E75            	  3775:     rts
                            	  3776: 
                            	  3777:     even
                            	  3778: DrawGhiniAndCheckCollisions:
02:0003AFE8 4EB90004D2EC    	  3779:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AFEE 1940000D        	  3780:     move.b  D0,($000D,A4)
                            	  3781:     ; If the direction has an "up" component, then keep the
                            	  3782:     ; frame image 0, and go figure out horizontal flipping.
                            	  3783:     ;
02:0003AFF2 41EC0098        	  3784:     lea     ($0098,A4),A0
02:0003AFF6 10302000        	  3785:     move.b  (A0,D2.W),D0
02:0003AFFA 02000008        	  3786:     andi.b #$08,D0
02:0003AFFE 6614            	  3787:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3788:     ; Else make the frame image 1 for the "down" frame.
                            	  3789:     ; Note that this is the frame image to use, even if there's no
                            	  3790:     ; down component in the direction.
                            	  3791:     ;
02:0003B000 522C000D        	  3792:     addq.b  #1,($000D,A4)
                            	  3793:     ; If right is a component of the direction, then go set horizontal
                            	  3794:     ; flipping. Else leave horizontal flipping = 0.
                            	  3795:     ;
02:0003B004 41EC0098        	  3796:     lea     ($0098,A4),A0
02:0003B008 10302000        	  3797:     move.b  (A0,D2.W),D0
02:0003B00C 02000001        	  3798:     andi.b #$01,D0
02:0003B010 6714            	  3799:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B012 660E            	  3800:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3801:     even
                            	  3802: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3803:     ; Set horizontal flipping if right is a direction component.
                            	  3804:     ; This essentially the same test as above, but for when we jump
                            	  3805:     ; from the "up" test.
                            	  3806:     ;
02:0003B014 41EC0098        	  3807:     lea     ($0098,A4),A0
02:0003B018 10302000        	  3808:     move.b  (A0,D2.W),D0
02:0003B01C 02000002        	  3809:     andi.b #$02,D0
02:0003B020 6704            	  3810:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3811:     even
                            	  3812: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B022 522C000F        	  3813:     addq.b  #1,($000F,A4)
                            	  3814:     even
                            	  3815: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B026 102C000D        	  3816:     move.b  ($000D,A4),D0
                            	  3817: ; Params:
                            	  3818: ; A: frame image
                            	  3819: ; X: object index
                            	  3820: ; [00]: object X
                            	  3821: ; [01]: object Y
                            	  3822: ; [0F]: flip horizontally
                            	  3823: ;
                            	  3824: ; Returns:
                            	  3825: ; [00]: 0 for Link slot
                            	  3826: ; [06]: 1 if objects collide
                            	  3827: ; [09]: 0 for Link damage type (none)
                            	  3828: ; [0C]: 1 if objects collide
                            	  3829: ; [034B]: ShotCollidesWithLink
                            	  3830: ;
                            	  3831:     even
                            	  3832: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003B02A 4EB90003157E    	  3833:     jsr     DrawObjectNotMirrored
02:0003B030 4EF900031A44    	  3834:     jmp     CheckLinkCollision
                            	  3835: 
                            	  3836:     even
                            	  3837: SecretArmosRoomIds:
02:0003B036 24              	  3838:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B037 0B
02:0003B038 1C
02:0003B039 22
02:0003B03A 34
02:0003B03B 3D
02:0003B03C 4E
                            	  3839: 
                            	  3840:     even
                            	  3841: SecretArmosXs:
02:0003B03E E0              	  3842:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B03F B0
02:0003B040 B0
02:0003B041 30
02:0003B042 40
02:0003B043 90
02:0003B044 A0
                            	  3843: 
                            	  3844:     even
                            	  3845: InitArmosOrFlyingGhini:
                            	  3846:     ; In UpdateObject, this object was flagged "initialized".
                            	  3847:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3848:     ;
02:0003B046 10342028        	  3849:     move.b  ($28,A4,D2.W),D0
02:0003B04A 41EC0492        	  3850:     lea     ($0492,A4),A0
02:0003B04E 11802000        	  3851:     move.b  D0,(A0,D2.W)
                            	  3852:     ; If it's still fading in, then go finish some initialization needed
                            	  3853:     ; for fading in.
                            	  3854:     ;
02:0003B052 660000B6        	  3855:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3856:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3857:     ; go finish initializing it.
                            	  3858:     ;
02:0003B056 41EC034F        	  3859:     lea     ($034F,A4),A0
02:0003B05A 10302000        	  3860:     move.b  (A0,D2.W),D0
02:0003B05E 0C000022        	  3861:     cmpi.b  #$22,D0
02:0003B062 670000A6        	  3862:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3863:     ; Else we have an armos.
                            	  3864:     ;
                            	  3865:     ; Store stairs tile $70 in [00] for use later.
                            	  3866:     ;
02:0003B066 7070            	  3867:     moveq   #112,D0
02:0003B068 1880            	  3868:     move.b  D0,($0000,A4)
                            	  3869:     ; Look for the current room ID in an array of room ID's that
                            	  3870:     ; have armos secrets.
                            	  3871:     ;
02:0003B06A 7606            	  3872:     moveq   #6,D3
                            	  3873:     even
                            	  3874: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B06C 102C00EB        	  3875:     move.b  ($00EB,A4),D0
                            	  3876:     ; If this element does not match the current room ID, go loop again.
                            	  3877:     ;
02:0003B070 41F90003B036    	  3878:     lea     (SecretArmosRoomIds).l,A0
02:0003B076 12303000        	  3879:     move.b  (A0,D3.W),D1
02:0003B07A B001            	  3880:     cmp.b   D1,D0
02:0003B07C 6648            	  3881:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3882:     ; The secret (usually stairs) is under one of the armoses.
                            	  3883:     ;
                            	  3884:     ; If the armos's X coordinate does not match the one needed
                            	  3885:     ; for the current room in the list, then go loop again.
                            	  3886:     ;
02:0003B07E 10342070        	  3887:     move.b  ($70,A4,D2.W),D0
02:0003B082 41F90003B03E    	  3888:     lea     (SecretArmosXs).l,A0
02:0003B088 12303000        	  3889:     move.b  (A0,D3.W),D1
02:0003B08C B001            	  3890:     cmp.b   D1,D0
02:0003B08E 6636            	  3891:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3892:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3893:     ;
02:0003B090 41EC0084        	  3894:     lea     ($0084,A4),A0
02:0003B094 10302000        	  3895:     move.b  (A0,D2.W),D0
02:0003B098 0C000080        	  3896:     cmpi.b  #$80,D0
02:0003B09C 6628            	  3897:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3898:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3899:     ;
02:0003B09E 4A03            	  3900:     cmpi.b  #$00,D3
02:0003B0A0 662C            	  3901:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3902:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3903:     ; has the power bracelet.
                            	  3904:     ;
                            	  3905:     ; Set up the room item with the armos's coordinates.
                            	  3906:     ;
02:0003B0A2 19400097        	  3907:     move.b  D0,($0097,A4)
02:0003B0A6 10342070        	  3908:     move.b  ($70,A4,D2.W),D0
02:0003B0AA 19400083        	  3909:     move.b  D0,($0083,A4)
                            	  3910:     ; This resets the room item's state, which activates it.
                            	  3911:     ;
02:0003B0AE 194300BF        	  3912:     move.b  D3,($00BF,A4)
                            	  3913:     ; Set the room item ID.
                            	  3914:     ;
02:0003B0B2 7014            	  3915:     moveq   #20,D0
02:0003B0B4 194000AB        	  3916:     move.b  D0,($00AB,A4)
                            	  3917:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3918:     ;
                            	  3919:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3920:     ;
                            	  3921:     ; Note that, if the item was already taken, then the room item
                            	  3922:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3923:     ; it will be ignored, because that routine checks whether
                            	  3924:     ; the item was taken.
                            	  3925:     ;
02:0003B0B8 4EB900030EB0    	  3926:     jsr     GetRoomFlagUWItemState
02:0003B0BE 660A            	  3927:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B0C0 610006FE        	  3928:     jsr     PlaySecretFoundTune
02:0003B0C4 6604            	  3929:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3930:     even
                            	  3931: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3932:     ; Bottom of the loop.
                            	  3933:     ;
02:0003B0C6 5303            	  3934:     subq.b  #1,D3
02:0003B0C8 6AA2            	  3935:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3936:     even
                            	  3937: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3938:     ; Not found, or found the power bracelet.
                            	  3939:     ; Use a floor tile $26 to replace the armos.
                            	  3940:     ;
02:0003B0CA 7026            	  3941:     moveq   #38,D0
02:0003B0CC 1880            	  3942:     move.b  D0,($0000,A4)
                            	  3943:     even
                            	  3944: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B0CE 1014            	  3945:     move.b  ($0000,A4),D0
                            	  3946:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3947:     ;
02:0003B0D0 1B00            	  3948:     move.b  D0,-(A5)  ; PHA
02:0003B0D2 0C000070        	  3949:     cmpi.b  #$70,D0
02:0003B0D6 6604            	  3950:     bne  _anon_z04_51
02:0003B0D8 610006E6        	  3951:     jsr     PlaySecretFoundTune
                            	  3952: _anon_z04_51:
                            	  3953:     ; Replace the tile where the armos was.
                            	  3954:     ;
02:0003B0DC 522C00F7        	  3955:     addq.b  #1,($00F7,A4)
02:0003B0E0 101D            	  3956:     move.b  (A5)+,D0  ; PLA
02:0003B0E2 4EB90004B100    	  3957:     jsr     ChangeTileObjTiles
                            	  3958:     ; Because the armos object is aligned to the square grid
                            	  3959:     ; (because it was made from a square),
                            	  3960:     ; set its grid offset to 3 to compensate.
                            	  3961:     ;
                            	  3962:     ; Most objects are aligned to the grid vertically when the
                            	  3963:     ; low nibble is $D.
                            	  3964:     ;
02:0003B0E8 7003            	  3965:     moveq   #3,D0
02:0003B0EA 41EC0394        	  3966:     lea     ($0394,A4),A0
02:0003B0EE 11802000        	  3967:     move.b  D0,(A0,D2.W)
                            	  3968:     ; Set a speed (q-speed fraction) randomly:
                            	  3969:     ; $20 if random value < $80
                            	  3970:     ; $60 otherwise
                            	  3971:     ;
02:0003B0F2 7020            	  3972:     moveq   #32,D0
02:0003B0F4 7600            	  3973:     moveq   #0,D3
02:0003B0F6 16342019        	  3974:     move.b  ($19,A4,D2.W),D3
02:0003B0FA 0C030080        	  3975:     cmpi.b  #$80,D3
02:0003B0FE 6502            	  3976:     bcs  _anon_z04_52
02:0003B100 7060            	  3977:     moveq   #96,D0
                            	  3978: _anon_z04_52:
02:0003B102 41EC03BC        	  3979:     lea     ($03BC,A4),A0
02:0003B106 11802000        	  3980:     move.b  D0,(A0,D2.W)
                            	  3981:     even
                            	  3982: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3983:     ; Facing and input directions down.
                            	  3984:     ;
02:0003B10A 7004            	  3985:     moveq   #4,D0
02:0003B10C 41EC03F8        	  3986:     lea     ($03F8,A4),A0
02:0003B110 11802000        	  3987:     move.b  D0,(A0,D2.W)
02:0003B114 41EC0098        	  3988:     lea     ($0098,A4),A0
02:0003B118 11802000        	  3989:     move.b  D0,(A0,D2.W)
                            	  3990:     ; Every other frame, return without drawing.
                            	  3991:     ;
02:0003B11C 10342028        	  3992:     move.b  ($28,A4,D2.W),D0
02:0003B120 E208            	  3993:     lsr.b  #1,D0   ; LSR A
02:0003B122 6512            	  3994:     bcs  _anon_z04_53
                            	  3995:     ; Finish initializing based on type.
                            	  3996:     ;
02:0003B124 41EC034F        	  3997:     lea     ($034F,A4),A0
02:0003B128 10302000        	  3998:     move.b  (A0,D2.W),D0
02:0003B12C 0C000022        	  3999:     cmpi.b  #$22,D0
02:0003B130 6602            	  4000:     bne.s  __far_z_04_0034
02:0003B132 6008            	  4001:     jmp  L_EndInitFlyingGhini
                            	  4002: __far_z_04_0034:
02:0003B134 6158            	  4003:     jsr     DrawArmosAndCheckCollisions
                            	  4004: _anon_z04_53:
02:0003B136 0A3C0001        	  4005:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B13A 4E75            	  4006:     rts
                            	  4007: 
                            	  4008:     even
                            	  4009: L_EndInitFlyingGhini:
02:0003B13C 6100FEAA        	  4010:     jsr     DrawGhiniAndCheckCollisions
                            	  4011:     ; If we're finally leaving the object flagged "initialized",
                            	  4012:     ; then reset metastate and initialize this as a flyer.
                            	  4013:     ;
02:0003B140 41EC0492        	  4014:     lea     ($0492,A4),A0
02:0003B144 10302000        	  4015:     move.b  (A0,D2.W),D0
02:0003B148 66EC            	  4016:     bne  _anon_z04_53
02:0003B14A 4EB90004DAEE    	  4017:     jsr     ResetObjMetastateAndTimer
02:0003B150 6000F44A        	  4018:     jmp     EndInitFlyer
