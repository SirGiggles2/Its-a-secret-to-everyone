02:00031CA4 19400009        	  7019:     move.b  D0,($0009,A4)
                            	  7020:     ; Set collision threshold $A in both axes.
                            	  7021:     ;
02:00031CA8 700A            	  7022:     moveq   #10,D0
02:00031CAA 1940000D        	  7023:     move.b  D0,($000D,A4)
02:00031CAE 1940000E        	  7024:     move.b  D0,($000E,A4)
                            	  7025:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  7026:     ;
02:00031CB2 10343070        	  7027:     move.b  ($70,A4,D3.W),D0
02:00031CB6 023C00EE        	  7028:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031CBA 123C0004        	  7029:     move.b  #$04,D1
02:00031CBE D101            	  7030:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031CC0 19400004        	  7031:     move.b  D0,($0004,A4)
                            	  7032:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  7033:     ;
02:00031CC4 41EC0084        	  7034:     lea     ($0084,A4),A0
02:00031CC8 10303000        	  7035:     move.b  (A0,D3.W),D0
02:00031CCC 023C00EE        	  7036:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031CD0 123C0008        	  7037:     move.b  #$08,D1
02:00031CD4 D101            	  7038:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7039: ; Params:
                            	  7040: ; A: weapon object mid Y
                            	  7041: ; X: monster object slot
                            	  7042: ; Y: weapon object slot
                            	  7043: ; [00]: weapon object slot
                            	  7044: ; [02]: monster object mid X
                            	  7045: ; [03]: monster object mid Y
                            	  7046: ; [04]: weapon object mid X
                            	  7047: ; [07]: damage points
                            	  7048: ; [09]: damage type
                            	  7049: ; [0D]: horizontal threshold
                            	  7050: ; [0E]: vertical threshold
                            	  7051: ;
                            	  7052: ; Returns:
