02:00043C40 2044            	  6379:     movea.l D4,A0
02:00043C42 10303000        	  6380:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043C46 41F90004AE30    	  6381:     lea     (LevelMasks).l,A0
02:00043C4C 12302000        	  6382:     move.b  (A0,D2.W),D1
02:00043C50 8001            	  6383:     or.b  D1,D0
02:00043C52 1214            	  6384:     move.b  ($00,A4),D1   ; ptr lo
02:00043C54 182C0001        	  6385:     move.b  ($01,A4),D4  ; ptr hi
02:00043C58 024100FF        	  6386:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C5C E14C            	  6387:     lsl.w   #8,D4
02:00043C5E 8841            	  6388:     or.w    D1,D4
02:00043C60 48C4            	  6389:     ext.l   D4
02:00043C62 D8BC00FF0000    	  6390:     add.l   #NES_RAM,D4
02:00043C68 2044            	  6391:     movea.l D4,A0
02:00043C6A 11803000        	  6392:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6393: _anon_z05_124:
                            	  6394:     ; Add the door to the opened door mask, reset door command,
                            	  6395:     ; and lay out doors.
                            	  6396:     ;
02:00043C6E 102C0055        	  6397:     move.b  ($0055,A4),D0
02:00043C72 122C00EE        	  6398:     move.b  ($00EE,A4),D1
02:00043C76 8001            	  6399:     or.b  D1,D0
02:00043C78 6000FF66        	  6400:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6401: 
                            	  6402: ; Params:
                            	  6403: ; [08]: 0 if closed
                            	  6404: ;
                            	  6405: ; Returns:
                            	  6406: ; X: current length of dynamic transfer buf
                            	  6407: ; [00]: door VRAM address high byte
                            	  6408: ; [01]: door VRAM address low byte
                            	  6409: ; [02:03]: address of door tiles for direction and face
                            	  6410: ; [05]: 2, the number of transfer records to write
                            	  6411: ; [06]: 2, the number of tiles in each record
                            	  6412: ; [07]: 0, the first index of a tile to transfer
                            	  6413: ; [09]: door direction index
                            	  6414: ;
                            	  6415: ; Note that this routine is called with triggered doors:
                            	  6416: ; doors that can change state. Their door type numbers are >= 4.
                            	  6417: ;
                            	  6418: ; If this routine were ever called with a fixed door
                            	  6419: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6420: ; values for the door face.
                            	  6421: ;
                            	  6422: ;
                            	  6423: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6424: ;
                            	  6425:     even
                            	  6426: PrepareWriteHorizontalDoorTransferRecords:
02:00043C7C 102C0055        	  6427:     move.b  ($0055,A4),D0
02:00043C80 19400002        	  6428:     move.b  D0,($0002,A4)
02:00043C84 6100F9A4        	  6429:     jsr     FindDoorAttrByDoorBit
02:00043C88 0C000005        	  6430:     cmpi.b  #$05,D0
02:00043C8C 650C            	  6431:     bcs  _anon_z05_125
02:00043C8E 1B00            	  6432:     move.b  D0,-(A5)  ; PHA
02:00043C90 7004            	  6433:     moveq   #4,D0
02:00043C92 4EB9000304EA    	  6434:     jsr     PlaySample
02:00043C98 101D            	  6435:     move.b  (A5)+,D0  ; PLA
                            	  6436: _anon_z05_125:
                            	  6437:     ; Calculate the door face index in three parts.
                            	  6438:     ;
                            	  6439:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6440:     ; (provisional face index in Y register).
                            	  6441:     ;
02:00043C9A 0C000004        	  6442:     cmpi.b  #$04,D0
02:00043C9E 6602            	  6443:     bne  _anon_z05_126
02:00043CA0 7008            	  6444:     moveq   #8,D0
                            	  6445: _anon_z05_126:
02:00043CA2 0C000001        	  6446:     cmpi.b  #$01,D0
02:00043CA6 6602            	  6447:     bne  _anon_z05_127
02:00043CA8 7004            	  6448:     moveq   #4,D0
                            	  6449: _anon_z05_127:
                            	  6450:     ; Second, subtract 3 from provisional face index.
                            	  6451:     ;
02:00043CAA 003C0011        	  6452:     ori     #$11,CCR  ; SEC: set C+X
02:00043CAE 123C0003        	  6453:     move.b  #$03,D1
02:00043CB2 0A3C0010        	  6454:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043CB6 9101            	  6455:     subx.b  D1,D0   ; SBC #$03
02:00043CB8 0A3C0010        	  6456:     eori    #$10,CCR  ; restore X = 6502 C
02:00043CBC 7600            	  6457:     moveq   #0,D3
02:00043CBE 1600            	  6458:     move.b  D0,D3
                            	  6459:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6460:     ; face index >= 3, then subtract 1 from it.
                            	  6461:     ;
                            	  6462:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6463:     ; then make it 1.
                            	  6464:     ;
02:00043CC0 102C0008        	  6465:     move.b  ($0008,A4),D0
02:00043CC4 6708            	  6466:     beq  _anon_z05_128
02:00043CC6 0C030005        	  6467:     cmpi.b  #$05,D3
02:00043CCA 670A            	  6468:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043CCC 7601            	  6469:     moveq   #1,D3
                            	  6470: _anon_z05_128:
02:00043CCE 0C030003        	  6471:     cmpi.b  #$03,D3
02:00043CD2 6502            	  6472:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043CD4 5303            	  6473:     subq.b  #1,D3
                            	  6474:     even
                            	  6475: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6476:     ; The routine that returned the door type also returned its
                            	  6477:     ; reverse direction index in [03].
                            	  6478:     ;
                            	  6479:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6480:     ;
02:00043CD6 7003            	  6481:     moveq   #3,D0
02:00043CD8 003C0011        	  6482:     ori     #$11,CCR  ; SEC: set C+X
02:00043CDC 122C0003        	  6483:     move.b  ($0003,A4),D1
02:00043CE0 0A3C0010        	  6484:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043CE4 9101            	  6485:     subx.b  D1,D0   ; SBC $03
02:00043CE6 0A3C0010        	  6486:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6487:     ; Call this to put the address of door face tiles in [02:03].
                            	  6488:     ;
02:00043CEA 6100FD7A        	  6489:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6490:     ; Return the address of the door in the nametable in [01:00].
                            	  6491:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6492:     ;
02:00043CEE 41F900043AC4    	  6493:     lea     (DoorVramAddrsHi).l,A0
02:00043CF4 10302000        	  6494:     move.b  (A0,D2.W),D0
02:00043CF8 1880            	  6495:     move.b  D0,($0000,A4)
02:00043CFA 41F900043AC8    	  6496:     lea     (DoorVramAddrsLo).l,A0
02:00043D00 10302000        	  6497:     move.b  (A0,D2.W),D0
02:00043D04 19400001        	  6498:     move.b  D0,($0001,A4)
                            	  6499:     ; Return the direction of the door in [09], and the dynamic
                            	  6500:     ; transfer buf length in X register.
                            	  6501:     ;
02:00043D08 19420009        	  6502:     move.b  D2,($0009,A4)
02:00043D0C 7400            	  6503:     moveq   #0,D2
02:00043D0E 142C0301        	  6504:     move.b  ($0301,A4),D2
                            	  6505:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6506:     ;
02:00043D12 7000            	  6507:     moveq   #0,D0
02:00043D14 19400007        	  6508:     move.b  D0,($0007,A4)
02:00043D18 7002            	  6509:     moveq   #2,D0
02:00043D1A 19400006        	  6510:     move.b  D0,($0006,A4)
02:00043D1E 19400005        	  6511:     move.b  D0,($0005,A4)
02:00043D22 0A3C0001        	  6512:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043D26 4E75            	  6513:     rts
