02:0003BF7E 101D            	  5930:     move.b  (A5)+,D0  ; PLA
02:0003BF80 19802028        	  5931:     move.b  D0,($28,A4,D2.W)
02:0003BF84 101D            	  5932:     move.b  (A5)+,D0  ; PLA
02:0003BF86 41EC0098        	  5933:     lea     ($0098,A4),A0
02:0003BF8A 11802000        	  5934:     move.b  D0,(A0,D2.W)
                            	  5935:     ; If this segment is still alive, then return.
                            	  5936:     ;
02:0003BF8E 41EC0405        	  5937:     lea     ($0405,A4),A0
02:0003BF92 10302000        	  5938:     move.b  (A0,D2.W),D0
02:0003BF96 6774            	  5939:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5940:     ; This segment is dead. We'll swap the tail segment with this
                            	  5941:     ; dead segment. This way, moldorm heads are always rooted
                            	  5942:     ; in slots 5 and $A; and the segments are continguous.
                            	  5943:     ;
                            	  5944:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5945:     ;
                            	  5946:     ; Note that this is not a true swap, because the tail's HP
                            	  5947:     ; might be less than $20.
                            	  5948:     ;
02:0003BF98 7020            	  5949:     moveq   #32,D0
02:0003BF9A 41EC0485        	  5950:     lea     ($0485,A4),A0
02:0003BF9E 11802000        	  5951:     move.b  D0,(A0,D2.W)
02:0003BFA2 6100062A        	  5952:     jsr     CheckBossHitReaction
                            	  5953:     ; Look for the tail segment, starting from the low end
                            	  5954:     ; of the chain that this dead segment belongs to.
                            	  5955:     ;
02:0003BFA6 163C00FF        	  5956:     move.b  #$FF,D3
02:0003BFAA 0C020006        	  5957:     cmpi.b  #$06,D2
02:0003BFAE 6502            	  5958:     bcs  _anon_z04_80
02:0003BFB0 7604            	  5959:     moveq   #4,D3
                            	  5960: _anon_z04_80:
