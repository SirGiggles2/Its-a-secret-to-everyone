                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034C42 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034C46 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034C4A 123C0008        	  2617:     move.b  #$08,D1
02:00034C4E D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034C50 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034C54 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034C58 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034C5C 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034C60 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034C64 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034C66 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034C6A 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
02:00034C6E 123C0008        	  2645:     move.b  #$08,D1
02:00034C72 0A3C0010        	  2646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034C76 9101            	  2647:     subx.b  D1,D0   ; SBC #$08
02:00034C78 0A3C0010        	  2648:     eori    #$10,CCR  ; restore X = 6502 C
02:00034C7C 19400423        	  2649:     move.b  D0,($0423,A4)
                            	  2650:     ; It also means that we went past the end of the save slot
                            	  2651:     ; info name. Set the offset to the beginning of the name.
02:00034C80 7600            	  2652:     moveq   #0,D3
02:00034C82 162C0016        	  2653:     move.b  ($0016,A4),D3
02:00034C86 41F9000345C2    	  2654:     lea     (SlotToNameOffset).l,A0
02:00034C8C 10303000        	  2655:     move.b  (A0,D3.W),D0
02:00034C90 19400421        	  2656:     move.b  D0,($0421,A4)
                            	  2657:     ; If the name cursor has gone past the end of the field,
                            	  2658:     ; then wrap around.
02:00034C94 102C0070        	  2659:     move.b  ($0070,A4),D0
02:00034C98 0C0000B0        	  2660:     cmpi.b  #$B0,D0
02:00034C9C 6640            	  2661:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034C9E 7070            	  2662:     moveq   #112,D0
02:00034CA0 19400070        	  2663:     move.b  D0,($0070,A4)
                            	  2664:     even
                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034CA4 7600            	  2672:     moveq   #0,D3
02:00034CA6 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034CAA 41F9000345C2    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034CB0 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034CB4 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034CB8 B001            	  2677:     cmp.b   D1,D0
02:00034CBA 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034CBC 5300            	  2679:     subq.b  #1,D0
02:00034CBE 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034CC2 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034CC6 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034CCA 5101            	  2683:     subi.b  #8,D1
02:00034CCC 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034CD0 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034CD2 7600            	  2686:     moveq   #0,D3
02:00034CD4 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034CD6 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034CDA 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2691:     even
