                            	  6851:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6852:     ;
02:00031B64 7001            	  6853:     moveq   #1,D0
02:00031B66 19400604        	  6854:     move.b  D0,($0604,A4)
02:00031B6A 7000            	  6855:     moveq   #0,D0
02:00031B6C 19400006        	  6856:     move.b  D0,($0006,A4)
