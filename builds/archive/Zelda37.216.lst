                            	  4635: __far_z_02_0010:
                            	  4636:     ; Determine an index based on the high 2 bits of the character element:
                            	  4637:     ;   $80: 0
                            	  4638:     ;   $40: 1
                            	  4639:     ;   $C0: 2
                            	  4640:     ;
02:00036188 7602            	  4641:     moveq   #2,D3
02:0003618A 0C0000C0        	  4642:     cmpi.b  #$C0,D0
02:0003618E 670A            	  4643:     beq  _anon_z02_33
02:00036190 5303            	  4644:     subq.b  #1,D3
02:00036192 0C000040        	  4645:     cmpi.b  #$40,D0
02:00036196 6702            	  4646:     beq  _anon_z02_33
