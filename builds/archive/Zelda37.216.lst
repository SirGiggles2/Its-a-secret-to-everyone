                            	  1994: _L_z04_UpdateStatues_Shoot:
                            	  1995:     ; Look for an empty monster slot.
                            	  1996:     ; If none is found, return.
                            	  1997:     ;
                            	  1998:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1999:     ; object. This routine takes a shooter object, and instantiates
                            	  2000:     ; a fireball object at the shooter's location.
                            	  2001:     ;
                            	  2002:     ; The object slot we set up here will behave as the shooter.
                            	  2003:     ; For each fireball index, this object slot will have its coordinates
                            	  2004:     ; changed.
                            	  2005:     ;
                            	  2006:     ; Note that this means that:
                            	  2007:     ; 1. The first fireball made will be its own shooter.
                            	  2008:     ;    Practically, there's nothing special about this.
                            	  2009:     ; 2. If there is more than one fireball made in a frame,
                            	  2010:     ;    then two of them will come from the same statue.
                            	  2011:     ;
                            	  2012:     ;
                            	  2013:     ; Save the fireball pattern.
02:0003A378 1003            	  2014:     move.b  D3,D0
02:0003A37A 1B00            	  2015:     move.b  D0,-(A5)  ; PHA
02:0003A37C 4EB90004DADC    	  2016:     jsr     FindEmptyMonsterSlot
02:0003A382 0C000001        	  2017:     cmpi.b  #$01,D0
02:0003A386 101D            	  2018:     move.b  (A5)+,D0  ; PLA
02:0003A388 6400010A        	  2019:     bcc  _L_z04_UpdateStatues_Exit
