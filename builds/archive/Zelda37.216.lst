02:0003A3C4 660000C8        	  2053:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  2054:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  2055:     ; This fireball index will wait another $100 frames.
                            	  2056:     ;
02:0003A3C8 10342018        	  2057:     move.b  ($18,A4,D2.W),D0
02:0003A3CC 0C0000F0        	  2058:     cmpi.b  #$F0,D0
02:0003A3D0 640000BC        	  2059:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  2060:     ; Else choose one of four start times for the fireball based on
                            	  2061:     ; the random value.
                            	  2062:     ;
02:0003A3D4 02000003        	  2063:     andi.b #$03,D0
02:0003A3D8 7600            	  2064:     moveq   #0,D3
02:0003A3DA 1600            	  2065:     move.b  D0,D3
02:0003A3DC 41F90003A338    	  2066:     lea     (StatueFireballStartTimes).l,A0
02:0003A3E2 10303000        	  2067:     move.b  (A0,D3.W),D0
02:0003A3E6 41EC04E8        	  2068:     lea     ($04E8,A4),A0
02:0003A3EA 11802000        	  2069:     move.b  D0,(A0,D2.W)
                            	  2070:     ; The coordinate lists are divided into sets for each pattern.
                            	  2071:     ;
                            	  2072:     ; Look up the index of the base of the set for the pattern in use.
                            	  2073:     ; Add it to the fireball index in X register to get the index of
                            	  2074:     ; the coordinate we want within each coordinate list.
                            	  2075:     ;
                            	  2076:     ;
                            	  2077:     ; Pattern
02:0003A3EE 7600            	  2078:     moveq   #0,D3
02:0003A3F0 162C000B        	  2079:     move.b  ($000B,A4),D3
02:0003A3F4 1002            	  2080:     move.b  D2,D0
02:0003A3F6 023C00EE        	  2081:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3FA 41F90003A33C    	  2082:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A400 12303000        	  2083:     move.b  (A0,D3.W),D1
02:0003A404 D101            	  2084:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A406 7600            	  2085:     moveq   #0,D3
02:0003A408 1600            	  2086:     move.b  D0,D3
02:0003A40A 1002            	  2087:     move.b  D2,D0
02:0003A40C 1B00            	  2088:     move.b  D0,-(A5)  ; PHA
                            	  2089:     ; Get Link's coordinates into [00] and [01].
