                            	  5489: 
                            	  5490: ; Params:
                            	  5491: ; [02]: bitmask for target door.
                            	  5492: ;
                            	  5493: ; Returns:
                            	  5494: ; A: door attribute for desired direction in current room.
                            	  5495: ; [01]: same as [02] if found; $10 otherwise
                            	  5496: ; [03]: reverse direction index
                            	  5497: ;
                            	  5498: ; Door bits:
                            	  5499: ; 1: E
                            	  5500: ; 2: W
                            	  5501: ; 4: S
                            	  5502: ; 8: N
                            	  5503: ;
                            	  5504: ;
                            	  5505: ; Start with single-bit mask 1.
                            	  5506:     even
                            	  5507: FindDoorAttrByDoorBit:
02:0004362A 7001            	  5508:     moveq   #1,D0
02:0004362C 19400001        	  5509:     move.b  D0,($0001,A4)
02:00043630 7003            	  5510:     moveq   #3,D0
02:00043632 19400003        	  5511:     move.b  D0,($0003,A4)
                            	  5512:     even
                            	  5513: _L_z05_FindDoorAttrByDoorBit_LoopDoorBit:
02:00043636 7600            	  5514:     moveq   #0,D3
02:00043638 162C00EB        	  5515:     move.b  ($00EB,A4),D3
02:0004363C 41F900FF687E    	  5516:     lea     (NES_SRAM+$087E).l,A0
02:00043642 10303000        	  5517:     move.b  (A0,D3.W),D0
02:00043646 7600            	  5518:     moveq   #0,D3
02:00043648 162C0003        	  5519:     move.b  ($0003,A4),D3
02:0004364C 0C030002        	  5520:     cmpi.b  #$02,D3
02:00043650 6510            	  5521:     bcs  _anon_z05_106
02:00043652 7600            	  5522:     moveq   #0,D3
02:00043654 162C00EB        	  5523:     move.b  ($00EB,A4),D3
02:00043658 41F900FF68FE    	  5524:     lea     (NES_SRAM+$08FE).l,A0
02:0004365E 10303000        	  5525:     move.b  (A0,D3.W),D0
                            	  5526: _anon_z05_106:
02:00043662 1880            	  5527:     move.b  D0,($0000,A4)
02:00043664 102C0003        	  5528:     move.b  ($0003,A4),D0
02:00043668 02000001        	  5529:     andi.b #$01,D0
02:0004366C 6612            	  5530:     bne  _anon_z05_107
02:0004366E 1214            	  5531:     move.b  ($0000,A4),D1
02:00043670 E209            	  5532:     lsr.b  #1,D1   ; LSR $00
02:00043672 1881            	  5533:     move.b  D1,($0000,A4)
02:00043674 1214            	  5534:     move.b  ($0000,A4),D1
02:00043676 E209            	  5535:     lsr.b  #1,D1   ; LSR $00
02:00043678 1881            	  5536:     move.b  D1,($0000,A4)
02:0004367A 1214            	  5537:     move.b  ($0000,A4),D1
02:0004367C E209            	  5538:     lsr.b  #1,D1   ; LSR $00
