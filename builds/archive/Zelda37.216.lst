                            	  9968:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9969:     ;
02:0003DCBA 41EC0098        	  9970:     lea     ($0098,A4),A0
02:0003DCBE 10302000        	  9971:     move.b  (A0,D2.W),D0
02:0003DCC2 122C0002        	  9972:     move.b  ($0002,A4),D1
02:0003DCC6 E309            	  9973:     lsl.b  #1,D1   ; ASL $02
02:0003DCC8 19410002        	  9974:     move.b  D1,($0002,A4)
02:0003DCCC 122C0002        	  9975:     move.b  ($0002,A4),D1
02:0003DCD0 C200            	  9976:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCD2 6716            	  9977:     beq  _L_z04_Manhandla_Move_Down
02:0003DCD4 10342070        	  9978:     move.b  ($70,A4,D2.W),D0
02:0003DCD8 122C0003        	  9979:     move.b  ($0003,A4),D1
