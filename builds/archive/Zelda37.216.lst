                            	 12002: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EC30 10342070        	 12003:     move.b  ($70,A4,D2.W),D0
02:0003EC34 1B00            	 12004:     move.b  D0,-(A5)  ; PHA
                            	 12005:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 12006:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 12007:     ;
02:0003EC36 023C00EE        	 12008:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EC3A 123C0004        	 12009:     move.b  #$04,D1
02:0003EC3E D101            	 12010:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EC40 19802070        	 12011:     move.b  D0,($70,A4,D2.W)
                            	 12012:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 12013:     ; to store in [03].
                            	 12014:     ;
02:0003EC44 102C04E6        	 12015:     move.b  ($04E6,A4),D0
02:0003EC48 0A000003        	 12016:     eori.b #$03,D0
02:0003EC4C 19400003        	 12017:     move.b  D0,($0003,A4)
                            	 12018:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 12019:     ;
02:0003EC50 103C009E        	 12020:     move.b  #$9E,D0
02:0003EC54 0C020005        	 12021:     cmpi.b  #$05,D2
02:0003EC58 670A            	 12022:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC5A 0C02000A        	 12023:     cmpi.b  #$0A,D2
02:0003EC5E 6704            	 12024:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC60 103C00A0        	 12025:     move.b  #$A0,D0
                            	 12026:     even
                            	 12027: _L_z04_UpdateLamnola_Draw:
02:0003EC64 4EB90003187A    	 12028:     jsr     Anim_WriteSprite
02:0003EC6A 101D            	 12029:     move.b  (A5)+,D0  ; PLA
02:0003EC6C 19802070        	 12030:     move.b  D0,($70,A4,D2.W)
02:0003EC70 41EC0098        	 12031:     lea     ($0098,A4),A0
02:0003EC74 10302000        	 12032:     move.b  (A0,D2.W),D0
02:0003EC78 1B00            	 12033:     move.b  D0,-(A5)  ; PHA
02:0003EC7A 4EB9000318FA    	 12034:     jsr     CheckMonsterCollisions
02:0003EC80 101D            	 12035:     move.b  (A5)+,D0  ; PLA
02:0003EC82 41EC0098        	 12036:     lea     ($0098,A4),A0
02:0003EC86 11802000        	 12037:     move.b  D0,(A0,D2.W)
                            	 12038:     ; If still alive, then return.
                            	 12039:     ;
02:0003EC8A 41EC0405        	 12040:     lea     ($0405,A4),A0
02:0003EC8E 10302000        	 12041:     move.b  (A0,D2.W),D0
02:0003EC92 6604            	 12042:     bne.s  __far_z_04_0120
02:0003EC94 6000FF72        	 12043:     jmp  L129EA_Exit
                            	 12044: __far_z_04_0120:
                            	 12045:     ; Otherwise, the segment is dead.
                            	 12046:     ;
02:0003EC98 4EB90004BC5A    	 12047:     jsr     ResetShoveInfo
                            	 12048:     ; Set the current segment's HP to the initial value in anticipation
                            	 12049:     ; of bringing this segment back to life.
                            	 12050:     ;
02:0003EC9E 7020            	 12051:     moveq   #32,D0
02:0003ECA0 41EC0485        	 12052:     lea     ($0485,A4),A0
02:0003ECA4 11802000        	 12053:     move.b  D0,(A0,D2.W)
                            	 12054:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 12055:     ;
                            	 12056:     ; From the lowest slot, look for one that has the original lamnola
                            	 12057:     ; object type.
                            	 12058:     ;
                            	 12059:     ; The goal is to swap the current dead segment with the tail segment.
                            	 12060:     ;
02:0003ECA8 163C00FF        	 12061:     move.b  #$FF,D3
02:0003ECAC 0C020006        	 12062:     cmpi.b  #$06,D2
02:0003ECB0 6502            	 12063:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003ECB2 7604            	 12064:     moveq   #4,D3
                            	 12065:     even
                            	 12066: _L_z04_UpdateLamnola_FindTail:
02:0003ECB4 5203            	 12067:     addq.b  #1,D3
02:0003ECB6 41EC0350        	 12068:     lea     ($0350,A4),A0
02:0003ECBA 10303000        	 12069:     move.b  (A0,D3.W),D0
02:0003ECBE 122C04E7        	 12070:     move.b  ($04E7,A4),D1
02:0003ECC2 B001            	 12071:     cmp.b   D1,D0
02:0003ECC4 66EE            	 12072:     bne  _L_z04_UpdateLamnola_FindTail
                            	 12073:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 12074:     ;
02:0003ECC6 7011            	 12075:     moveq   #17,D0
02:0003ECC8 19803029        	 12076:     move.b  D0,($29,A4,D3.W)
                            	 12077:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 12078:     ; to the tail segment.
                            	 12079:     ;
02:0003ECCC 41EC04F0        	 12080:     lea     ($04F0,A4),A0
02:0003ECD0 10302000        	 12081:     move.b  (A0,D2.W),D0
02:0003ECD4 41EC04F1        	 12082:     lea     ($04F1,A4),A0
02:0003ECD8 11803000        	 12083:     move.b  D0,(A0,D3.W)
02:0003ECDC 10342070        	 12084:     move.b  ($70,A4,D2.W),D0
02:0003ECE0 19803071        	 12085:     move.b  D0,($71,A4,D3.W)
02:0003ECE4 41EC0084        	 12086:     lea     ($0084,A4),A0
02:0003ECE8 10302000        	 12087:     move.b  (A0,D2.W),D0
02:0003ECEC 41EC0085        	 12088:     lea     ($0085,A4),A0
02:0003ECF0 11803000        	 12089:     move.b  D0,(A0,D3.W)
                            	 12090:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 12091:     ; So, return and leave it dead.
                            	 12092:     ;
02:0003ECF4 0C030004        	 12093:     cmpi.b  #$04,D3
02:0003ECF8 6604            	 12094:     bne.s  __far_z_04_0121
02:0003ECFA 6000FF0C        	 12095:     jmp  L129EA_Exit
                            	 12096: __far_z_04_0121:
02:0003ECFE 0C030009        	 12097:     cmpi.b  #$09,D3
02:0003ED02 6604            	 12098:     bne.s  __far_z_04_0122
02:0003ED04 6000FF02        	 12099:     jmp  L129EA_Exit
                            	 12100: __far_z_04_0122:
                            	 12101:     ; Change the tail segment to the dead dummy object, and
                            	 12102:     ; bring the current segment back to life.
                            	 12103:     ;
02:0003ED08 705D            	 12104:     moveq   #93,D0
02:0003ED0A 41EC0350        	 12105:     lea     ($0350,A4),A0
02:0003ED0E 11803000        	 12106:     move.b  D0,(A0,D3.W)
02:0003ED12 4EF90004DAF4    	 12107:     jmp     ResetObjMetastate
                            	 12108: 
                            	 12109:     even
                            	 12110: L12A6F_Exit:
02:0003ED18 4E75            	 12111:     rts
                            	 12112: 
                            	 12113:     even
                            	 12114: Lamnola_UpdateHead:
                            	 12115:     ; If X coordinate is not a multiple of 8, then return.
                            	 12116:     ;
02:0003ED1A 10342070        	 12117:     move.b  ($70,A4,D2.W),D0
02:0003ED1E 02000007        	 12118:     andi.b #$07,D0
02:0003ED22 6702            	 12119:     beq.s  __far_z_04_0123
02:0003ED24 60F2            	 12120:     jmp  L12A6F_Exit
                            	 12121: __far_z_04_0123:
                            	 12122:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 12123:     ; We had to account for the usual offset of 3.
                            	 12124:     ;
02:0003ED26 41EC0084        	 12125:     lea     ($0084,A4),A0
02:0003ED2A 10302000        	 12126:     move.b  (A0,D2.W),D0
02:0003ED2E 023C00EE        	 12127:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED32 123C0003        	 12128:     move.b  #$03,D1
02:0003ED36 D101            	 12129:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED38 02000007        	 12130:     andi.b #$07,D0
02:0003ED3C 6702            	 12131:     beq.s  __far_z_04_0124
02:0003ED3E 60D8            	 12132:     jmp  L12A6F_Exit
                            	 12133: __far_z_04_0124:
                            	 12134:     ; Will loop 4 times, propagating directions down the chain,
                            	 12135:     ; by pulling from the bottom.
                            	 12136:     ;
02:0003ED40 7004            	 12137:     moveq   #4,D0
02:0003ED42 1880            	 12138:     move.b  D0,($0000,A4)
                            	 12139:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12140:     ;
02:0003ED44 7600            	 12141:     moveq   #0,D3
02:0003ED46 0C020005        	 12142:     cmpi.b  #$05,D2
02:0003ED4A 6702            	 12143:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED4C 7605            	 12144:     moveq   #5,D3
                            	 12145:     even
                            	 12146: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12147:     ; Loop over every segment under the head, starting from the tail.
                            	 12148:     ; Copy the next segment's direction to the current one in this loop.
                            	 12149:     ;
02:0003ED4E 41EC009A        	 12150:     lea     ($009A,A4),A0
02:0003ED52 10303000        	 12151:     move.b  (A0,D3.W),D0
02:0003ED56 41EC0099        	 12152:     lea     ($0099,A4),A0
02:0003ED5A 11803000        	 12153:     move.b  D0,(A0,D3.W)
02:0003ED5E 5203            	 12154:     addq.b  #1,D3
02:0003ED60 5314            	 12155:     subq.b  #1,($0000,A4)
02:0003ED62 66EA            	 12156:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12157:     ; If this head segment is not aligned with a square, then return.
                            	 12158:     ;
02:0003ED64 10342070        	 12159:     move.b  ($70,A4,D2.W),D0
02:0003ED68 0200000F        	 12160:     andi.b #$0F,D0
02:0003ED6C 660000BA        	 12161:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12162:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12163:     ; We had to account for the usual offset of 3.
                            	 12164:     ;
02:0003ED70 41EC0084        	 12165:     lea     ($0084,A4),A0
02:0003ED74 10302000        	 12166:     move.b  (A0,D2.W),D0
02:0003ED78 023C00EE        	 12167:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED7C 123C0003        	 12168:     move.b  #$03,D1
02:0003ED80 D101            	 12169:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED82 0200000F        	 12170:     andi.b #$0F,D0
02:0003ED86 660000A0        	 12171:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12172:     ; Store the opposite of the facing direction in [00].
                            	 12173:     ;
02:0003ED8A 41EC0098        	 12174:     lea     ($0098,A4),A0
02:0003ED8E 10302000        	 12175:     move.b  (A0,D2.W),D0
02:0003ED92 E208            	 12176:     lsr.b  #1,D0   ; LSR A
02:0003ED94 02000005        	 12177:     andi.b #$05,D0
02:0003ED98 1880            	 12178:     move.b  D0,($0000,A4)
02:0003ED9A 41EC0098        	 12179:     lea     ($0098,A4),A0
02:0003ED9E 10302000        	 12180:     move.b  (A0,D2.W),D0
02:0003EDA2 E308            	 12181:     lsl.b  #1,D0   ; ASL A
02:0003EDA4 0200000A        	 12182:     andi.b #$0A,D0
02:0003EDA8 1214            	 12183:     move.b  ($0000,A4),D1
02:0003EDAA 8001            	 12184:     or.b  D1,D0
                            	 12185:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12186:     ;
02:0003EDAC 0A00000F        	 12187:     eori.b #$0F,D0
02:0003EDB0 1940050F        	 12188:     move.b  D0,($050F,A4)
                            	 12189:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12190:     ;
02:0003EDB4 10342018        	 12191:     move.b  ($18,A4,D2.W),D0
02:0003EDB8 0C000080        	 12192:     cmpi.b  #$80,D0
02:0003EDBC 656C            	 12193:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12194:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12195:     ; Load the monster's facing direction.
                            	 12196:     ;
02:0003EDBE 41EC0098        	 12197:     lea     ($0098,A4),A0
02:0003EDC2 10302000        	 12198:     move.b  (A0,D2.W),D0
                            	 12199:     ; Load the next random number into Y register.
                            	 12200:     ;
02:0003EDC6 7600            	 12201:     moveq   #0,D3
02:0003EDC8 16342019        	 12202:     move.b  ($19,A4,D2.W),D3
                            	 12203:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12204:     ; to keep moving straight.
                            	 12205:     ;
02:0003EDCC 0C030080        	 12206:     cmpi.b  #$80,D3
02:0003EDD0 6418            	 12207:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12208:     even
                            	 12209: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12210:     ; Loop to rotate the direction bit over the mask.
                            	 12211:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12212:     ; facing direction.
                            	 12213:     ;
                            	 12214:     ; Shift right the copy of the direction.
                            	 12215:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12216:     ;
02:0003EDD2 E208            	 12217:     lsr.b  #1,D0   ; LSR A
02:0003EDD4 6402            	 12218:     bcc  _anon_z04_151
02:0003EDD6 7008            	 12219:     moveq   #8,D0
                            	 12220: _anon_z04_151:
                            	 12221:     ; If the current direction bit is masked off, then we've reached
                            	 12222:     ; the opposite direction. Loop again.
                            	 12223:     ;
02:0003EDD8 122C050F        	 12224:     move.b  ($050F,A4),D1
02:0003EDDC C200            	 12225:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDDE 67F2            	 12226:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12227:     ; If Y register >= $40, then break out of the loop.
                            	 12228:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12229:     ;
02:0003EDE0 0C030040        	 12230:     cmpi.b  #$40,D3
02:0003EDE4 6404            	 12231:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12232:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12233:     ; and loop again now.
                            	 12234:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12235:     ;
02:0003EDE6 7640            	 12236:     moveq   #64,D3
02:0003EDE8 65E8            	 12237:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12238:     even
                            	 12239: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12240:     ; Change the facing direction to the direction found.
                            	 12241:     ;
02:0003EDEA 41EC0098        	 12242:     lea     ($0098,A4),A0
02:0003EDEE 11802000        	 12243:     move.b  D0,(A0,D2.W)
                            	 12244:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12245:     ;
02:0003EDF2 1940000F        	 12246:     move.b  D0,($000F,A4)
02:0003EDF6 4EB9000308BA    	 12247:     jsr     BoundByRoom
                            	 12248:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12249:     ;
02:0003EDFC 102C000F        	 12250:     move.b  ($000F,A4),D0
02:0003EE00 6618            	 12251:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12252:     even
                            	 12253: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
