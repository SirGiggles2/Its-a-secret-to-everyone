02:0002FDC2 123C0003        	  2722:     move.b  #$03,D1
02:0002FDC6 D101            	  2723:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002FDC8 003C0011        	  2724:     ori     #$11,CCR  ; SEC: set C+X
02:0002FDCC 41EC0084        	  2725:     lea     ($0084,A4),A0
02:0002FDD0 12302000        	  2726:     move.b  (A0,D2.W),D1
02:0002FDD4 0A3C0010        	  2727:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002FDD8 9101            	  2728:     subx.b  D1,D0   ; SBC ObjY,X
02:0002FDDA 0A3C0010        	  2729:     eori    #$10,CCR  ; restore X = 6502 C
02:0002FDDE 61000BD8        	  2730:     jsr     Abs
02:0002FDE2 0C000010        	  2731:     cmpi.b  #$10,D0
02:0002FDE6 6406            	  2732:     bcc  _L_z01_CheckTileObjectsBlocking_NextTileObj
