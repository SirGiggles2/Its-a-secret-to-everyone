                            	  5216:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5217:     ; unused, so it only has to depend on having an empty slot.
                            	  5218:     ;
                            	  5219:     ; If successful, Link's state will have been changed to "using item".
                            	  5220:     ; But we don't want that in this case.
                            	  5221:     ;
                            	  5222:     ; For both these reasons, save state and restore it afterward.
                            	  5223:     ;
02:0004C564 102C00AC        	  5224:     move.b  ($00AC,A4),D0
02:0004C568 1B00            	  5225:     move.b  D0,-(A5)  ; PHA
02:0004C56A 102C0513        	  5226:     move.b  ($0513,A4),D0
02:0004C56E 1B00            	  5227:     move.b  D0,-(A5)  ; PHA
02:0004C570 7000            	  5228:     moveq   #0,D0
02:0004C572 19400513        	  5229:     move.b  D0,($0513,A4)
02:0004C576 4EB900030BFE    	  5230:     jsr     WieldCandle
02:0004C57C 101D            	  5231:     move.b  (A5)+,D0  ; PLA
02:0004C57E 19400513        	  5232:     move.b  D0,($0513,A4)
02:0004C582 101D            	  5233:     move.b  (A5)+,D0  ; PLA
02:0004C584 194000AC        	  5234:     move.b  D0,($00AC,A4)
