02:00031286 11803000        	  5815:     move.b  D0,(A0,D3.W)
02:0003128A 5202            	  5816:     addq.b  #1,D2
02:0003128C 1002            	  5817:     move.b  D2,D0
02:0003128E 02000007        	  5818:     andi.b #$07,D0
02:00031292 7400            	  5819:     moveq   #0,D2
02:00031294 1400            	  5820:     move.b  D0,D2
02:00031296 5203            	  5821:     addq.b  #1,D3
02:00031298 0C030040        	  5822:     cmpi.b  #$40,D3
