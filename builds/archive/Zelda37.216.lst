                            	 10168:     ;
02:0003DE70 122C0002        	 10169:     move.b  ($0002,A4),D1
02:0003DE74 E309            	 10170:     lsl.b  #1,D1   ; ASL $02
02:0003DE76 19410002        	 10171:     move.b  D1,($0002,A4)
02:0003DE7A 122C0002        	 10172:     move.b  ($0002,A4),D1
02:0003DE7E C200            	 10173:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE80 6708            	 10174:     beq  _anon_z04_121
02:0003DE82 41EC0084        	 10175:     lea     ($0084,A4),A0
02:0003DE86 53302000        	 10176:     subq.b  #1,(A0,D2.W)
                            	 10177: _anon_z04_121:
                            	 10178:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10179:     ;
02:0003DE8A 41EC0412        	 10180:     lea     ($0412,A4),A0
02:0003DE8E 10302000        	 10181:     move.b  (A0,D2.W),D0
02:0003DE92 0C000020        	 10182:     cmpi.b  #$20,D0
02:0003DE96 662C            	 10183:     bne  _L_z04_UpdateGohma_AnimateEye
                            	 10184:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	 10185:     ; Reverse the facing direction, and increase the number of sprints.
                            	 10186:     ;
02:0003DE98 7000            	 10187:     moveq   #0,D0
02:0003DE9A 41EC0412        	 10188:     lea     ($0412,A4),A0
02:0003DE9E 11802000        	 10189:     move.b  D0,(A0,D2.W)
02:0003DEA2 61001E72        	 10190:     jsr     ReverseObjDir8
02:0003DEA6 41EC045E        	 10191:     lea     ($045E,A4),A0
02:0003DEAA 10302000        	 10192:     move.b  (A0,D2.W),D0
02:0003DEAE 41EC045E        	 10193:     lea     ($045E,A4),A0
02:0003DEB2 52302000        	 10194:     addq.b  #1,(A0,D2.W)
                            	 10195:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10196:     ; should randomly change direction.
                            	 10197:     ;
02:0003DEB6 E208            	 10198:     lsr.b  #1,D0   ; LSR A
02:0003DEB8 640A            	 10199:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DEBA 7000            	 10200:     moveq   #0,D0
02:0003DEBC 41EC0451        	 10201:     lea     ($0451,A4),A0
02:0003DEC0 11802000        	 10202:     move.b  D0,(A0,D2.W)
                            	 10203:     even
                            	 10204: _L_z04_UpdateGohma_AnimateEye:
                            	 10205:     ; Animate the eye.
                            	 10206:     ;
                            	 10207:     ; First, if the counter for when to open the eye next = 0, then
                            	 10208:     ; set it to a random value at least $C0; and set the timer for
                            	 10209:     ; keeping the eye open to $80.
                            	 10210:     ;
                            	 10211:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10212:     ; every other frame.
                            	 10213:     ;
02:0003DEC4 41EC042C        	 10214:     lea     ($042C,A4),A0
02:0003DEC8 10302000        	 10215:     move.b  (A0,D2.W),D0
02:0003DECC 661E            	 10216:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DECE 103C0080        	 10217:     move.b  #$80,D0
02:0003DED2 41EC0444        	 10218:     lea     ($0444,A4),A0
02:0003DED6 11802000        	 10219:     move.b  D0,(A0,D2.W)
02:0003DEDA 103C00C0        	 10220:     move.b  #$C0,D0
02:0003DEDE 12342018        	 10221:     move.b  ($18,A4,D2.W),D1
02:0003DEE2 8001            	 10222:     or.b  D1,D0
02:0003DEE4 41EC042C        	 10223:     lea     ($042C,A4),A0
02:0003DEE8 11802000        	 10224:     move.b  D0,(A0,D2.W)
                            	 10225:     even
                            	 10226: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10227:     ; Decrement the next-open-eye counter.
                            	 10228:     ;
02:0003DEEC 102C0015        	 10229:     move.b  ($0015,A4),D0
02:0003DEF0 E208            	 10230:     lsr.b  #1,D0   ; LSR A
02:0003DEF2 6408            	 10231:     bcc  _anon_z04_122
02:0003DEF4 41EC042C        	 10232:     lea     ($042C,A4),A0
02:0003DEF8 53302000        	 10233:     subq.b  #1,(A0,D2.W)
                            	 10234: _anon_z04_122:
                            	 10235:     ; If open eye timer = 0, then the eye is closed.
                            	 10236:     ; Go animate it differently.
                            	 10237:     ;
02:0003DEFC 41EC0444        	 10238:     lea     ($0444,A4),A0
02:0003DF00 10302000        	 10239:     move.b  (A0,D2.W),D0
02:0003DF04 674A            	 10240:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10241:     ; Else decrement the open eye timer.
                            	 10242:     ;
02:0003DF06 41EC0444        	 10243:     lea     ($0444,A4),A0
