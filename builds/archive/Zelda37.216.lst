                            	 11304:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11305:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11306:     ;
02:0003E6D4 0C020001        	 11307:     cmpi.b  #$01,D2
02:0003E6D8 670000DE        	 11308:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E6DC 6100AF6C        	 11309:     jsr     PlayBossHitCryIfNeeded
                            	 11310:     ; If this neck has not died, then go loop again.
                            	 11311:     ;
02:0003E6E0 41EC0405        	 11312:     lea     ($0405,A4),A0
02:0003E6E4 10302000        	 11313:     move.b  (A0,D2.W),D0
02:0003E6E8 670000D4        	 11314:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11315:     ; This neck died. So, prepare to make a flying head.
                            	 11316:     ;
02:0003E6EC 7060            	 11317:     moveq   #96,D0
02:0003E6EE 41EC0485        	 11318:     lea     ($0485,A4),A0
02:0003E6F2 11802000        	 11319:     move.b  D0,(A0,D2.W)
02:0003E6F6 1002            	 11320:     move.b  D2,D0
02:0003E6F8 1B00            	 11321:     move.b  D0,-(A5)  ; PHA
                            	 11322:     ; If the segment is not a head, then skip making a flying head.
                            	 11323:     ;
                            	 11324:     ; TODO:
                            	 11325:     ; But how can we get here in this case, since earlier branches
                            	 11326:     ; would have been taken to skip all this for all other segments?
                            	 11327:     ;
02:0003E6FA 0C020005        	 11328:     cmpi.b  #$05,D2
02:0003E6FE 663C            	 11329:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11330:     ; The flying head will go in slot (neck index + 7).
