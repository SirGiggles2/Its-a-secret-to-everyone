02:00032090 19400004        	  7677:     move.b  D0,($0004,A4)
02:00032094 41EC0084        	  7678:     lea     ($0084,A4),A0
02:00032098 10303000        	  7679:     move.b  (A0,D3.W),D0
02:0003209C 023C00EE        	  7680:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320A0 123C0008        	  7681:     move.b  #$08,D1
02:000320A4 D101            	  7682:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
