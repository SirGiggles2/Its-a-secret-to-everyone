                            	  6607: Digdogger_Move:
                            	  6608:     ; This calculation is the same one used in Manhandla to
                            	  6609:     ; manifest the fractional speed over several frames.
                            	  6610:     ;
                            	  6611:     ; To summarize, the formula is:
                            	  6612:     ;
                            	  6613:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6614:     ;
                            	  6615:     ;   SA := SA + (SL AND $E0)
                            	  6616:     ;   [03] := SH + carry
                            	  6617:     ;
                            	  6618:     ; See 04:A28E Manhandla_Move.
                            	  6619:     ;
02:0003C41C 41EC041F        	  6620:     lea     ($041F,A4),A0
02:0003C420 10302000        	  6621:     move.b  (A0,D2.W),D0
02:0003C424 020000E0        	  6622:     andi.b #$E0,D0
02:0003C428 023C00EE        	  6623:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C42C 41EC0412        	  6624:     lea     ($0412,A4),A0
02:0003C430 12302000        	  6625:     move.b  (A0,D2.W),D1
02:0003C434 D101            	  6626:     addx.b  D1,D0   ; ADC $0412,X
02:0003C436 41EC0412        	  6627:     lea     ($0412,A4),A0
02:0003C43A 11802000        	  6628:     move.b  D0,(A0,D2.W)
                            	  6629:     ; Assign (high speed byte + carry) to [03].
                            	  6630:     ;
02:0003C43E 41EC042C        	  6631:     lea     ($042C,A4),A0
02:0003C442 10302000        	  6632:     move.b  (A0,D2.W),D0
02:0003C446 123C0000        	  6633:     move.b  #$00,D1
02:0003C44A D101            	  6634:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C44C 19400003        	  6635:     move.b  D0,($0003,A4)
                            	  6636:     ; Change coordinates by the speed amount/offset in [03]
                            	  6637:     ; according to the direction.
                            	  6638:     ;
                            	  6639:     ; Start with a mask of $A1 in [02]:
                            	  6640:     ; - low nibble represents the right direction
                            	  6641:     ; - high nibble is used to set or clear carry as we go along
                            	  6642:     ;
02:0003C450 103C00A1        	  6643:     move.b  #$A1,D0
02:0003C454 19400002        	  6644:     move.b  D0,($0002,A4)
                            	  6645:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6646:     ;
02:0003C458 41EC0098        	  6647:     lea     ($0098,A4),A0
02:0003C45C 10302000        	  6648:     move.b  (A0,D2.W),D0
02:0003C460 122C0002        	  6649:     move.b  ($0002,A4),D1
02:0003C464 C200            	  6650:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C466 6712            	  6651:     beq  _L_z04_Digdogger_Move_Left
02:0003C468 10342070        	  6652:     move.b  ($70,A4,D2.W),D0
02:0003C46C 023C00EE        	  6653:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C470 122C0003        	  6654:     move.b  ($0003,A4),D1
02:0003C474 D101            	  6655:     addx.b  D1,D0   ; ADC $03
02:0003C476 19802070        	  6656:     move.b  D0,($70,A4,D2.W)
                            	  6657:     even
                            	  6658: _L_z04_Digdogger_Move_Left:
                            	  6659:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6660:     ;
02:0003C47A 41EC0098        	  6661:     lea     ($0098,A4),A0
02:0003C47E 10302000        	  6662:     move.b  (A0,D2.W),D0
02:0003C482 122C0002        	  6663:     move.b  ($0002,A4),D1
02:0003C486 E309            	  6664:     lsl.b  #1,D1   ; ASL $02
02:0003C488 19410002        	  6665:     move.b  D1,($0002,A4)
02:0003C48C 122C0002        	  6666:     move.b  ($0002,A4),D1
02:0003C490 C200            	  6667:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
