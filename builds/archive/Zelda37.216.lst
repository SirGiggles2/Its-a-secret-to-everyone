                            	  5227: 
                            	  5228: ; Each byte describes an item. The high nibble is the type.
                            	  5229: ; The low nibble is the value. Its meaning depends on the type.
                            	  5230: ;
                            	  5231: ; 0x - individuals
                            	  5232: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5233: ; * bit mask: value doesn't matter.
                            	  5234: ;
                            	  5235: ; 1x - amounts
                            	  5236: ; Value is an amount to add.
                            	  5237: ;
                            	  5238: ; 2x - grades
                            	  5239: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5240: ;
                            	  5241: ; 3x - error?
                            	  5242: ; Produces an item value of $FF.
                            	  5243: ;
                            	  5244:     even
