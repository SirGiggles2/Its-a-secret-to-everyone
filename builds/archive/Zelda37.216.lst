02:0003A9F6 16302000        	  2980:     move.b  (A0,D2.W),D3
02:0003A9FA 0C03000D        	  2981:     cmpi.b  #$0D,D3
02:0003A9FE 6714            	  2982:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2983:     ; t := t AND $7F
                            	  2984:     ;
02:0003AA00 0200007F        	  2985:     andi.b #$7F,D0
                            	  2986:     ; If Random < $A0, then go use this t.
                            	  2987:     ;
02:0003AA04 7600            	  2988:     moveq   #0,D3
02:0003AA06 16342019        	  2989:     move.b  ($19,A4,D2.W),D3
02:0003AA0A 0C0300A0        	  2990:     cmpi.b  #$A0,D3
02:0003AA0E 6504            	  2991:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2992:     ; t := t AND $F
