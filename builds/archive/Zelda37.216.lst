02:0004398C 6502            	  5995:     bcs  _anon_z05_113
02:0004398E 5303            	  5996:     subq.b  #1,D3
                            	  5997: _anon_z05_113:
                            	  5998:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5999:     ;
                            	  6000:     ; DT DFC DFO Meaning
                            	  6001:     ; ------------------
                            	  6002:     ; 0  1   1   open
                            	  6003:     ; 4  4   5   bombable
                            	  6004:     ; 5  2   1   key
                            	  6005:     ; 6  2   1   key 2
                            	  6006:     ; 7  3   1   shutter
                            	  6007:     ;
                            	  6008:     ;
                            	  6009:     ; Get the direction index.
