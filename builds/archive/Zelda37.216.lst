                            	  6397: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6398:     ; Digdogger is big, but room boundary checks and
                            	  6399:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6400:     ; Therefore, we have to check these things four times,
                            	  6401:     ; in different corners of the boss.
                            	  6402:     ;
                            	  6403:     ; Loop 4 times, from 0 to 3.
                            	  6404:     ;
02:0003C242 7600            	  6405:     moveq   #0,D3
02:0003C244 41EC0478        	  6406:     lea     ($0478,A4),A0
02:0003C248 16302000        	  6407:     move.b  (A0,D2.W),D3
                            	  6408:     ; Change the coordinates to one corner.
                            	  6409:     ;
02:0003C24C 10342070        	  6410:     move.b  ($70,A4,D2.W),D0
02:0003C250 023C00EE        	  6411:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C254 41F90003C108    	  6412:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C25A 12303000        	  6413:     move.b  (A0,D3.W),D1
02:0003C25E D101            	  6414:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C260 19802070        	  6415:     move.b  D0,($70,A4,D2.W)
02:0003C264 41EC0084        	  6416:     lea     ($0084,A4),A0
02:0003C268 10302000        	  6417:     move.b  (A0,D2.W),D0
02:0003C26C 023C00EE        	  6418:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C270 41F90003C10C    	  6419:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C276 12303000        	  6420:     move.b  (A0,D3.W),D1
02:0003C27A D101            	  6421:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C27C 41EC0084        	  6422:     lea     ($0084,A4),A0
02:0003C280 11802000        	  6423:     move.b  D0,(A0,D2.W)
                            	  6424:     ; Check the room boundary and object collisions in this temporary location.
                            	  6425:     ;
02:0003C284 61003A62        	  6426:     jsr     BoundFlyer
02:0003C288 4EB9000318FA    	  6427:     jsr     CheckMonsterCollisions
                            	  6428:     ; Increase the loop index, and loop again until it = 4.
                            	  6429:     ;
02:0003C28E 41EC0478        	  6430:     lea     ($0478,A4),A0
02:0003C292 52302000        	  6431:     addq.b  #1,(A0,D2.W)
02:0003C296 41EC0478        	  6432:     lea     ($0478,A4),A0
02:0003C29A 10302000        	  6433:     move.b  (A0,D2.W),D0
02:0003C29E 0C000004        	  6434:     cmpi.b  #$04,D0
02:0003C2A2 659E            	  6435:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6436:     ; Restore the original coordinates.
                            	  6437:     ;
02:0003C2A4 101D            	  6438:     move.b  (A5)+,D0  ; PLA
02:0003C2A6 41EC0084        	  6439:     lea     ($0084,A4),A0
02:0003C2AA 11802000        	  6440:     move.b  D0,(A0,D2.W)
02:0003C2AE 101D            	  6441:     move.b  (A5)+,D0  ; PLA
02:0003C2B0 19802070        	  6442:     move.b  D0,($70,A4,D2.W)
