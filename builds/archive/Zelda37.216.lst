                            	  7211: UpdateDodongoState1_Bloated:
02:0003C89C 41EC042C        	  7212:     lea     ($042C,A4),A0
02:0003C8A0 10302000        	  7213:     move.b  (A0,D2.W),D0
02:0003C8A4 4EB90002AECA    	  7214:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7215:     even
                            	  7216: UpdateDodongoState1_Bloated_JumpTable:
02:0003C8AA 0003C8BE        	  7217:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8AE 0003C8BE        	  7218:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8B2 0003C8BE        	  7219:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8B6 0003C956        	  7220:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C8BA 0003C960        	  7221:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
