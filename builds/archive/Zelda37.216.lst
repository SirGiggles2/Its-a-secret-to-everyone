                            	  6020: Moldorm_Chase:
                            	  6021:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6022:     ; Only the head controls the movement direction.
                            	  6023:     ;
02:0003C02C 0C020005        	  6024:     cmpi.b  #$05,D2
