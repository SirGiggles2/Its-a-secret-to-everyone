                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:00036114 102C045F        	  4579:     move.b  ($045F,A4),D0
02:00036118 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:0003611C 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:00036120 7000            	  4584:     moveq   #0,D0
02:00036122 1880            	  4585:     move.b  D0,($0000,A4)
02:00036124 7000            	  4586:     moveq   #0,D0
02:00036126 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:0003612A 7600            	  4590:     moveq   #0,D3
02:0003612C 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:00036130 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
