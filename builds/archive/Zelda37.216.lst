02:0004D70A 7001            	  7598:     moveq   #1,D0
02:0004D70C 1940004B        	  7599:     move.b  D0,($004B,A4)
02:0004D710 41EC0492        	  7600:     lea     ($0492,A4),A0
02:0004D714 11802000        	  7601:     move.b  D0,(A0,D2.W)
02:0004D718 4E75            	  7602:     rts
                            	  7603:     even
