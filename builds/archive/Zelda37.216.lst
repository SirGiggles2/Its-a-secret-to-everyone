                            	  2393: UpdateWhirlwind_Full:
                            	  2394:     ; Get Link's halted state.
                            	  2395:     ;
02:0002FB9E 102C00AC        	  2396:     move.b  ($00AC,A4),D0
02:0002FBA2 02000040        	  2397:     andi.b #$40,D0
02:0002FBA6 7600            	  2398:     moveq   #0,D3
