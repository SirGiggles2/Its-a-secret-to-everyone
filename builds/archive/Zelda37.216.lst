                            	  4207: PondFairy_MoveHearts:
                            	  4208:     ; Loop over each heart from object slot 2 to 9.
                            	  4209:     ;
                            	  4210:     ; Even though they are not standalone objects, their info
                            	  4211:     ; is stored in those object slots.
                            	  4212:     ;
02:0003B272 7402            	  4213:     moveq   #2,D2
                            	  4214:     even
                            	  4215: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4216:     ; If the current heart's state <> 0, then go move it.
                            	  4217:     ; Else we have to wait for it to come out at the right time.
                            	  4218:     ;
02:0003B274 41EC00AC        	  4219:     lea     ($00AC,A4),A0
02:0003B278 10302000        	  4220:     move.b  (A0,D2.W),D0
02:0003B27C 667C            	  4221:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4222:     ; The current heart's state = 0.
                            	  4223:     ;
                            	  4224:     ; If object slot = 2, then go make it appear. This is the first
                            	  4225:     ; heart to show up.
                            	  4226:     ;
02:0003B27E 0C020002        	  4227:     cmpi.b  #$02,D2
02:0003B282 6732            	  4228:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4229:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4230:     ; go start over.
                            	  4231:     ;
                            	  4232:     ; TODO:
                            	  4233:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4234:     ;
02:0003B284 102C00AE        	  4235:     move.b  ($00AE,A4),D0
02:0003B288 67EA            	  4236:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4237:     ; Look up the starting angle of this heart with the index
                            	  4238:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4239:     ; then loop again.
                            	  4240:     ;
02:0003B28A 1002            	  4241:     move.b  D2,D0
02:0003B28C 003C0011        	  4242:     ori     #$11,CCR  ; SEC: set C+X
02:0003B290 123C0003        	  4243:     move.b  #$03,D1
02:0003B294 0A3C0010        	  4244:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B298 9101            	  4245:     subx.b  D1,D0   ; SBC #$03
02:0003B29A 0A3C0010        	  4246:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B29E 7600            	  4247:     moveq   #0,D3
02:0003B2A0 1600            	  4248:     move.b  D0,D3
02:0003B2A2 102C0396        	  4249:     move.b  ($0396,A4),D0
02:0003B2A6 41F90003B26A    	  4250:     lea     (PondHeartStartAngles).l,A0
02:0003B2AC 12303000        	  4251:     move.b  (A0,D3.W),D1
02:0003B2B0 B001            	  4252:     cmp.b   D1,D0
02:0003B2B2 66000086        	  4253:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4254:     even
