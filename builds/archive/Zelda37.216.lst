02:000399D0 0C030006        	   669:     cmpi.b  #$06,D3
02:000399D4 660000A0        	   670:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   671:     ; If a random value <> $23 nor $77, then return.
