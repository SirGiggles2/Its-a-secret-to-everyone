                            	  6076:     ; If the boomerang belongs to a monster, then check for
                            	  6077:     ; collision with Link.
                            	  6078:     ;
                            	  6079:     ; If they collide, then set state $20 and animation counter 3.
                            	  6080:     ;
02:0004CB54 0C02000D        	  6081:     cmpi.b  #$0D,D2
