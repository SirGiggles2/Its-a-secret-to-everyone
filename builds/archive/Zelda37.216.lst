                            	  5373: _anon_z04_69:
02:0003BB06 4E75            	  5374:     rts
                            	  5375: 
                            	  5376: ; Params:
                            	  5377: ; A: offset of first instruction for left wall (0)
                            	  5378: ;    or top wall ($20)
                            	  5379: ; Y: Link's minimum major coordinate
                            	  5380: ; [00]: Link's coordinate along minor axis
                            	  5381: ; [01]: Link's coordinate along major axis
                            	  5382: ; [02]: a decreasing direction along the wall (left or up)
                            	  5383: ;
                            	  5384: ; Returns:
                            	  5385: ; Y: index of initial major coordinate of Wallmaster
                            	  5386: ; [04]: initial minor coordinate of Wallmaster
                            	  5387: ;
                            	  5388: ; Store the initial offset for this axis.
                            	  5389: ;
                            	  5390:     even
                            	  5391: Wallmaster_CalcStartPosition:
02:0003BB08 41EC0412        	  5392:     lea     ($0412,A4),A0
02:0003BB0C 11802000        	  5393:     move.b  D0,(A0,D2.W)
02:0003BB10 19430003        	  5394:     move.b  D3,($0003,A4)
                            	  5395:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5396:     ;
02:0003BB14 7024            	  5397:     moveq   #36,D0
02:0003BB16 7600            	  5398:     moveq   #0,D3
02:0003BB18 162C03F8        	  5399:     move.b  ($03F8,A4),D3
02:0003BB1C 6702            	  5400:     beq  _anon_z04_70
02:0003BB1E 7032            	  5401:     moveq   #50,D0
                            	  5402: _anon_z04_70:
                            	  5403:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5404:     ; 1. negate the distance
                            	  5405:     ; 2. add 8 to the instruction offset to access
                            	  5406:     ;    the opposite direction for the same wall
                            	  5407:     ;
02:0003BB20 7600            	  5408:     moveq   #0,D3
02:0003BB22 162C0098        	  5409:     move.b  ($0098,A4),D3
02:0003BB26 122C0002        	  5410:     move.b  ($0002,A4),D1
02:0003BB2A B601            	  5411:     cmp.b   D1,D3
02:0003BB2C 662A            	  5412:     bne  _anon_z04_71
02:0003BB2E 1B00            	  5413:     move.b  D0,-(A5)  ; PHA
02:0003BB30 41EC0412        	  5414:     lea     ($0412,A4),A0
02:0003BB34 10302000        	  5415:     move.b  (A0,D2.W),D0
02:0003BB38 023C00EE        	  5416:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB3C 123C0008        	  5417:     move.b  #$08,D1
02:0003BB40 D101            	  5418:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB42 41EC0412        	  5419:     lea     ($0412,A4),A0
02:0003BB46 11802000        	  5420:     move.b  D0,(A0,D2.W)
02:0003BB4A 101D            	  5421:     move.b  (A5)+,D0  ; PLA
02:0003BB4C 4600            	  5422:     eori.b #$FF,D0
02:0003BB4E 023C00EE        	  5423:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB52 123C0001        	  5424:     move.b  #$01,D1
02:0003BB56 D101            	  5425:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5426: _anon_z04_71:
                            	  5427:     ; Add the distance and Link's minor coordinate to calculate
                            	  5428:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5429:     ; In general, the monster will be put in front of Link.
                            	  5430:     ;
02:0003BB58 023C00EE        	  5431:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB5C 1214            	  5432:     move.b  ($0000,A4),D1
02:0003BB5E D101            	  5433:     addx.b  D1,D0   ; ADC $00
02:0003BB60 19400004        	  5434:     move.b  D0,($0004,A4)
                            	  5435:     ; By default, will return index 0 to choose the minimum value
                            	  5436:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5437:     ; if Link is at the wall with a smaller major coordinate.
                            	  5438:     ;
02:0003BB64 7600            	  5439:     moveq   #0,D3
                            	  5440:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5441:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5442:     ; to access the block for the other direction along the same axis,
                            	  5443:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5444:     ;
02:0003BB66 102C0001        	  5445:     move.b  ($0001,A4),D0
02:0003BB6A 122C0003        	  5446:     move.b  ($0003,A4),D1
02:0003BB6E B001            	  5447:     cmp.b   D1,D0
02:0003BB70 671C            	  5448:     beq  _anon_z04_72
02:0003BB72 41EC0412        	  5449:     lea     ($0412,A4),A0
02:0003BB76 10302000        	  5450:     move.b  (A0,D2.W),D0
02:0003BB7A 023C00EE        	  5451:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB7E 123C0010        	  5452:     move.b  #$10,D1
02:0003BB82 D101            	  5453:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BB84 41EC0412        	  5454:     lea     ($0412,A4),A0
02:0003BB88 11802000        	  5455:     move.b  D0,(A0,D2.W)
02:0003BB8C 5203            	  5456:     addq.b  #1,D3
