                            	  7625: L763A_Exit:
02:00032066 4E75            	  7626:     rts
                            	  7627: 
                            	  7628: ; Params:
                            	  7629: ; A: damage points
                            	  7630: ; X: monster object slot
                            	  7631: ; [00]: weapon object slot
                            	  7632: ; [02]: monster object mid X
                            	  7633: ; [03]: monster object mid Y
                            	  7634: ; [09]: damage type
                            	  7635: ; [0D]: horizontal threshold
                            	  7636: ;
                            	  7637: ; Returns:
                            	  7638: ; [06]: 1 if objects collide
                            	  7639: ; [07]: damage points
                            	  7640: ; [0E]: vertical threshold
                            	  7641: ;
