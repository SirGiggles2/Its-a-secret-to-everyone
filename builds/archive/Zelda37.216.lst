                            	  5540: _anon_z05_107:
02:00043680 1214            	  5541:     move.b  ($0000,A4),D1
02:00043682 E209            	  5542:     lsr.b  #1,D1   ; LSR $00
02:00043684 1881            	  5543:     move.b  D1,($0000,A4)
02:00043686 1214            	  5544:     move.b  ($0000,A4),D1
02:00043688 E209            	  5545:     lsr.b  #1,D1   ; LSR $00
