                            	  2947: __far_z_04_0025:
                            	  2948:     ; Distance < 3. Go to state 0.
                            	  2949:     ;
                            	  2950:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2951:     ;
02:0003A9B6 4EB90004CE8A    	  2952:     jsr     ResetObjState
02:0003A9BC 7600            	  2953:     moveq   #0,D3
02:0003A9BE 41EC034F        	  2954:     lea     ($034F,A4),A0
02:0003A9C2 16302000        	  2955:     move.b  (A0,D2.W),D3
02:0003A9C6 0C030020        	  2956:     cmpi.b  #$20,D3
02:0003A9CA 6748            	  2957:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2958:     ; Else calculate a timer value.
                            	  2959:     ;
                            	  2960:     ; t := (Random + $10)
                            	  2961:     ; if t < $20 then
                            	  2962:     ;   t := t - $40
                            	  2963:     ;
02:0003A9CC 7010            	  2964:     moveq   #16,D0
02:0003A9CE 023C00EE        	  2965:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9D2 12342019        	  2966:     move.b  ($19,A4,D2.W),D1
02:0003A9D6 D101            	  2967:     addx.b  D1,D0   ; ADC Random+1,X
02:0003A9D8 0C000020        	  2968:     cmpi.b  #$20,D0
02:0003A9DC 6412            	  2969:     bcc  _anon_z04_39
02:0003A9DE 003C0011        	  2970:     ori     #$11,CCR  ; SEC: set C+X
02:0003A9E2 123C0040        	  2971:     move.b  #$40,D1
02:0003A9E6 0A3C0010        	  2972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A9EA 9101            	  2973:     subx.b  D1,D0   ; SBC #$40
02:0003A9EC 0A3C0010        	  2974:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2975: _anon_z04_39:
                            	  2976:     ; If the object is a blue tektite, then go use this t.
                            	  2977:     ;
02:0003A9F0 7600            	  2978:     moveq   #0,D3
