                            	  2530: 
                            	  2531: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2532: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2533: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2534: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2535: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2536: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2537:     even
                            	  2538: ModeE_SyncCharBoardCursorToIndex:
02:00034B9A 4EF90002BADC    	  2539:     jmp     c_mode_e_sync_char_board_cursor
                            	  2540: 
                            	  2541: ModeE_HandleAOrB:
02:00034BA0 102C0420        	  2542:     move.b  ($0420,A4),D0
                            	  2543:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2544:     ; the name field.
02:00034BA4 6646            	  2545:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034BA6 7600            	  2546:     moveq   #0,D3
02:00034BA8 162C0016        	  2547:     move.b  ($0016,A4),D3
02:00034BAC 0C030003        	  2548:     cmpi.b  #$03,D3
