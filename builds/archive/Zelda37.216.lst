02:0003CD3A E208            	  7902:     lsr.b  #1,D0   ; LSR A
                            	  7903:     ; If movement frame = 1, add 3 to frame image to access
                            	  7904:     ; the second animation frame's images.
                            	  7905:     ;
02:0003CD3C 7600            	  7906:     moveq   #0,D3
02:0003CD3E 41EC03E4        	  7907:     lea     ($03E4,A4),A0
02:0003CD42 16302000        	  7908:     move.b  (A0,D2.W),D3
02:0003CD46 671E            	  7909:     beq  _anon_z04_95
02:0003CD48 023C00EE        	  7910:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD4C 123C0003        	  7911:     move.b  #$03,D1
02:0003CD50 D101            	  7912:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7913:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7914:     ;
                            	  7915:     ; Down has two frame images, but up only has one. By flipping
                            	  7916:     ; horizontally, you get two frame images.
                            	  7917:     ;
