                            	  6033: ; Params:
                            	  6034: ; A: frame image
                            	  6035: ; X: object index
                            	  6036: ; [00]: object X
                            	  6037: ; [01]: object Y
                            	  6038: ; [0F]: flip horizontally
                            	  6039: ;
                            	  6040:     even
                            	  6041: DrawObjectNotMirrored:
02:0003157E 7600            	  6042:     moveq   #0,D3
                            	  6043: _anon_z01_75:
02:00031580 1943000C        	  6044:     move.b  D3,($000C,A4)
                            	  6045:     ; Set animation index = object type + 1.
                            	  6046:     ;
02:00031584 7600            	  6047:     moveq   #0,D3
02:00031586 41EC034F        	  6048:     lea     ($034F,A4),A0
02:0003158A 16302000        	  6049:     move.b  (A0,D2.W),D3
                            	  6050: ; Params:
                            	  6051: ; A: frame
                            	  6052: ; X: object index/cycle sprite index
                            	  6053: ; Y: object type
                            	  6054: ; [00]: object X
                            	  6055: ; [01]: object Y
                            	  6056: ; [0C]: mirrored
                            	  6057: ; [0F]: flip horizontally
                            	  6058: ;
                            	  6059: ; Note:
                            	  6060: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6061: ;
                            	  6062: ; The animation index of most objects is (object type + 1),
                            	  6063: ; to make up for the fact that Link uses two animation indexes.
                            	  6064: ;
                            	  6065:     even
                            	  6066: DrawObjectWithType:
02:0003158E 5203            	  6067:     addq.b  #1,D3
                            	  6068: ; Params:
                            	  6069: ; A: frame
                            	  6070: ; X: object index/cycle sprite index
                            	  6071: ; Y: animation index
                            	  6072: ; [00]: object X
                            	  6073: ; [01]: object Y
                            	  6074: ; [0C]: mirrored
                            	  6075: ; [0F]: flip horizontally
                            	  6076: ;
                            	  6077: ; Note:
                            	  6078: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6079: ; But Link uses [0F] for flipping without checking [0C].
                            	  6080: ;
                            	  6081: ;
                            	  6082: ; [0D] holds frame.
                            	  6083:     even
                            	  6084: DrawObjectWithAnim:
02:00031590 1940000D        	  6085:     move.b  D0,($000D,A4)
02:00031594 1943000E        	  6086:     move.b  D3,($000E,A4)
02:00031598 19420008        	  6087:     move.b  D2,($0008,A4)
                            	  6088:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  6089:     ;
02:0003159C 7600            	  6090:     moveq   #0,D3
02:0003159E 162C0341        	  6091:     move.b  ($0341,A4),D3
02:000315A2 41F900031546    	  6092:     lea     (SpriteOffsets).l,A0
02:000315A8 10303000        	  6093:     move.b  (A0,D3.W),D0
02:000315AC 19400343        	  6094:     move.b  D0,($0343,A4)
02:000315B0 41F900031547    	  6095:     lea     (SpriteOffsets+1).l,A0
02:000315B6 10303000        	  6096:     move.b  (A0,D3.W),D0
                            	  6097:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  6098:     ;
