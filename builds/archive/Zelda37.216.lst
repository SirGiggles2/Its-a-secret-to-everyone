02:0002FCD6 122C0522        	  2593:     move.b  ($0522,A4),D1
02:0002FCDA 8001            	  2594:     or.b  D1,D0
02:0002FCDC 6702            	  2595:     beq.s  __far_z_01_0018
02:0002FCDE 6030            	  2596:     jmp  L6104_Exit
