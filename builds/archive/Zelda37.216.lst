                            	  3109:     ; Carry over to the high speed byte.
                            	  3110:     ;
02:0003AAF0 41EC0412        	  3111:     lea     ($0412,A4),A0
02:0003AAF4 10302000        	  3112:     move.b  (A0,D2.W),D0
02:0003AAF8 123C0000        	  3113:     move.b  #$00,D1
02:0003AAFC D101            	  3114:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AAFE 41EC0412        	  3115:     lea     ($0412,A4),A0
02:0003AB02 11802000        	  3116:     move.b  D0,(A0,D2.W)
                            	  3117:     ; *Signed comparison*:
                            	  3118:     ; If the high speed byte < high max speed byte, then return.
                            	  3119:     ;
                            	  3120:     ; Note that this is not a general purpose signed comparison,
                            	  3121:     ; which would be more complicated. But it works because
                            	  3122:     ; the deviation from 0 of both values is small.
                            	  3123:     ;
