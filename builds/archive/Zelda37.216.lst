                            	  1674: _anon_z04_27:
02:0003A15C 1003            	  1675:     move.b  D3,D0
                            	  1676:     ; Combine the two masks. At most one will be 0.
                            	  1677:     ;
02:0003A15E 1214            	  1678:     move.b  ($0000,A4),D1
02:0003A160 8001            	  1679:     or.b  D1,D0
                            	  1680:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1681:     ; with the grid.
                            	  1682:     ;
                            	  1683:     ; If so, then go to state 1 to do a "big shove".
                            	  1684:     ; Else go to state 2, to immediately split in two.
                            	  1685:     ;
                            	  1686:     ; Examples:
                            	  1687:     ; It would be aligned, if moving left along a tile as usual.
                            	  1688:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1689:     ; - The collision check routines would have made the zol
                            	  1690:     ;   face in the direction of the weapon.
                            	  1691:     ; - See CheckMonsterWeaponCollision.
                            	  1692:     ;
02:0003A162 122C0098        	  1693:     move.b  ($0098,A4),D1
02:0003A166 C001            	  1694:     and.b  D1,D0
02:0003A168 6608            	  1695:     bne  _anon_z04_28
02:0003A16A 41EC00AC        	  1696:     lea     ($00AC,A4),A0
02:0003A16E 52302000        	  1697:     addq.b  #1,(A0,D2.W)
