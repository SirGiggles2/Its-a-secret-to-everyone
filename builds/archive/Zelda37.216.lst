                            	  3148:     ; Call GetOppositeDir again to use this mapping:
                            	  3149:     ; In Dir: 1 2 4 8
                            	  3150:     ;         -------
                            	  3151:     ; Index:  2 3 0 1
                            	  3152:     ;
02:00041B5A 4EB9000309B4    	  3153:     jsr     GetOppositeDir
                            	  3154:     ; Get the appropriate coordinate for the direction:
                            	  3155:     ; X for horizontal
                            	  3156:     ; Y for vertical
                            	  3157:     ;
02:00041B60 102C0070        	  3158:     move.b  ($0070,A4),D0
02:00041B64 0C030002        	  3159:     cmpi.b  #$02,D3
02:00041B68 6404            	  3160:     bcc  _anon_z05_74
02:00041B6A 102C0084        	  3161:     move.b  ($0084,A4),D0
                            	  3162: _anon_z05_74:
02:00041B6E 19400002        	  3163:     move.b  D0,($0002,A4)
                            	  3164:     ; Mask A button and directions if inner border is crossed.
                            	  3165:     ;
02:00041B72 1003            	  3166:     move.b  D3,D0
02:00041B74 1B00            	  3167:     move.b  D0,-(A5)  ; PHA
02:00041B76 023C00EE        	  3168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041B7A 123C0008        	  3169:     move.b  #$08,D1
02:00041B7E D101            	  3170:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041B80 7600            	  3171:     moveq   #0,D3
02:00041B82 1600            	  3172:     move.b  D0,D3
02:00041B84 103C0080        	  3173:     move.b  #$80,D0
02:00041B88 6134            	  3174:     jsr     MaskInputInBorder
02:00041B8A 101D            	  3175:     move.b  (A5)+,D0  ; PLA
02:00041B8C 7600            	  3176:     moveq   #0,D3
02:00041B8E 1600            	  3177:     move.b  D0,D3
                            	  3178:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3179:     ; boundary using player's direction and reverse direction index.
                            	  3180:     ;
02:00041B90 102C0001        	  3181:     move.b  ($0001,A4),D0
