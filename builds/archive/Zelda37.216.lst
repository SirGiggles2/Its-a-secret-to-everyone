                            	   195: InitCave:
                            	   196:     ; The person goes at location ($78, $80).
                            	   197:     ;
02:0002DBC0 7078            	   198:     moveq   #120,D0
02:0002DBC2 163C0080        	   199:     move.b  #$80,D3
02:0002DBC6 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
                            	   203:     ;
02:0002DBCA 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DBCE 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DBD2 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DBD4 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DBD8 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DBDA 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DBDE 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DBE0 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DBE4 6502            	   212:     bcs.s  __far_z_01_0000
02:0002DBE6 6012            	   213:     jmp  InitCaveContinue
                            	   214: __far_z_01_0000:
                            	   215:     even
                            	   216: _L_z01_InitCave_TakeType:
                            	   217:     ; Else the cave/person simply does:
                            	   218:     ; - taken:     no person, no text
                            	   219:     ; - not taken: show a person and text
                            	   220:     ;
                            	   221:     ; So, if the item was not taken, then go set up the text.
                            	   222:     ;
02:0002DBE8 610032C6        	   223:     jsr     GetRoomFlagUWItemState
02:0002DBEC 6602            	   224:     bne.s  __far_z_01_0001
02:0002DBEE 600A            	   225:     jmp  InitCaveContinue
                            	   226: __far_z_01_0001:
                            	   227:     ; Otherwise destroy the person object, and let Link continue.
                            	   228:     ;
02:0002DBF0 7000            	   229:     moveq   #0,D0
02:0002DBF2 19400350        	   230:     move.b  D0,($0350,A4)
