02:0003BFD8 10342070        	  5980:     move.b  ($70,A4,D2.W),D0
02:0003BFDC 19803071        	  5981:     move.b  D0,($71,A4,D3.W)
02:0003BFE0 41EC0084        	  5982:     lea     ($0084,A4),A0
02:0003BFE4 10302000        	  5983:     move.b  (A0,D2.W),D0
02:0003BFE8 41EC0085        	  5984:     lea     ($0085,A4),A0
