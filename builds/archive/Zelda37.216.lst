02:0003EC12 6602            	 11985:     bne.s  __far_z_04_0119
02:0003EC14 60F2            	 11986:     jmp  L129EA_Exit
                            	 11987: __far_z_04_0119:
                            	 11988:     ; If we have the magic clock, then go draw and check collisions.
                            	 11989:     ;
02:0003EC16 102C066C        	 11990:     move.b  ($066C,A4),D0
02:0003EC1A 6614            	 11991:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
02:0003EC1C 6100027C        	 11992:     jsr     Lamnola_Move
                            	 11993:     ; If the current segment is a head, then update the direction it's facing.
