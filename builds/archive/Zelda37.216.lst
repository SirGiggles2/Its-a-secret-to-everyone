02:000364D0 522C050B        	  5034:     addq.b  #1,($050B,A4)
                            	  5035: _anon_z02_38:
02:000364D4 102C00FC        	  5036:     move.b  ($00FC,A4),D0
02:000364D8 123C0000        	  5037:     move.b  #$00,D1
02:000364DC D101            	  5038:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000364DE 194000FC        	  5039:     move.b  D0,($00FC,A4)
                            	  5040:     ; If we've reached the bottom of a nametable, then
                            	  5041:     ; roll over current V-scroll to 0, and increase number of
                            	  5042:     ; screens scrolled.
                            	  5043:     ;
