                            	  2792: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2793:     ; If reversal count >= 2, then
                            	  2794:     ; 1. invert the horizontal component of facing direction,
                            	  2795:     ;    to face away from the chase target
                            	  2796:     ; 2. reset the reversal count to 0.
                            	  2797:     ;
                            	  2798:     ; This prevents a jumper from getting stuck in a corner.
                            	  2799:     ;
                            	  2800:     ; For example, if a tektite's direction is down and right,
                            	  2801:     ; and jumps into the top right corner of the room:
                            	  2802:     ; 1. The right room boundary is hit. So the direction is
                            	  2803:     ;    automatically reversed to up and left.
                            	  2804:     ; 2. The next frame, the top room boundary is hit.
                            	  2805:     ;    The direction is reversed to down and right.
                            	  2806:     ;
                            	  2807:     ; As you can see, an endless loop has been made.
                            	  2808:     ;
02:0003A88C 41EC0451        	  2809:     lea     ($0451,A4),A0
02:0003A890 10302000        	  2810:     move.b  (A0,D2.W),D0
02:0003A894 0C000002        	  2811:     cmpi.b  #$02,D0
02:0003A898 651E            	  2812:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A89A 41EC0098        	  2813:     lea     ($0098,A4),A0
02:0003A89E 10302000        	  2814:     move.b  (A0,D2.W),D0
02:0003A8A2 0A000003        	  2815:     eori.b #$03,D0
02:0003A8A6 41EC0098        	  2816:     lea     ($0098,A4),A0
02:0003A8AA 11802000        	  2817:     move.b  D0,(A0,D2.W)
02:0003A8AE 7000            	  2818:     moveq   #0,D0
02:0003A8B0 41EC0451        	  2819:     lea     ($0451,A4),A0
02:0003A8B4 11802000        	  2820:     move.b  D0,(A0,D2.W)
                            	  2821:     even
                            	  2822: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2823:     ; If the object is a boulder, then make sure its facing direction
                            	  2824:     ; has a down vertical component.
                            	  2825:     ;
02:0003A8B8 610001F8        	  2826:     jsr     Jumper_PointBoulderDownward
                            	  2827:     ; For the given direction, get the Y offset of the destination
                            	  2828:     ; of the jump.
                            	  2829:     ;
                            	  2830:     ; Add it to the object's Y, and store this destination Y.
                            	  2831:     ;
02:0003A8BC 7600            	  2832:     moveq   #0,D3
02:0003A8BE 41EC0098        	  2833:     lea     ($0098,A4),A0
02:0003A8C2 16302000        	  2834:     move.b  (A0,D2.W),D3
02:0003A8C6 41EC0084        	  2835:     lea     ($0084,A4),A0
02:0003A8CA 10302000        	  2836:     move.b  (A0,D2.W),D0
02:0003A8CE 023C00EE        	  2837:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8D2 41F90003A7EA    	  2838:     lea     (JumperYOffsets).l,A0
02:0003A8D8 12303000        	  2839:     move.b  (A0,D3.W),D1
02:0003A8DC D101            	  2840:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A8DE 41EC0444        	  2841:     lea     ($0444,A4),A0
02:0003A8E2 11802000        	  2842:     move.b  D0,(A0,D2.W)
                            	  2843:     ; Set the starting speed, depending on the object type.
                            	  2844:     ;
02:0003A8E6 610001A0        	  2845:     jsr     Jumper_GetKind
02:0003A8EA 41F90003A814    	  2846:     lea     (JumperStartSpeedsHi).l,A0
02:0003A8F0 10303000        	  2847:     move.b  (A0,D3.W),D0
02:0003A8F4 41EC0412        	  2848:     lea     ($0412,A4),A0
02:0003A8F8 11802000        	  2849:     move.b  D0,(A0,D2.W)
                            	  2850:     ; Reset the vertical speed low byte.
                            	  2851:     ; Then go animate, draw, and check collisions.
