                            	  6915: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6916:     ; Reset values used in special item drops.
                            	  6917:     ;
02:00031BD8 7000            	  6918:     moveq   #0,D0
02:00031BDA 19400627        	  6919:     move.b  D0,($0627,A4)
02:00031BDE 19400050        	  6920:     move.b  D0,($0050,A4)
02:00031BE2 19400051        	  6921:     move.b  D0,($0051,A4)
                            	  6922:     ; If heart partial >= low damage points byte, then simply
                            	  6923:     ; subtract the damage byte from heart partial.
                            	  6924:     ; Else go borrow from full hearts.
                            	  6925:     ;
02:00031BE6 102C0670        	  6926:     move.b  ($0670,A4),D0
02:00031BEA 122C000E        	  6927:     move.b  ($000E,A4),D1
02:00031BEE B001            	  6928:     cmp.b   D1,D0
02:00031BF0 6546            	  6929:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031BF2 003C0011        	  6930:     ori     #$11,CCR  ; SEC: set C+X
02:00031BF6 122C000E        	  6931:     move.b  ($000E,A4),D1
02:00031BFA 0A3C0010        	  6932:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031BFE 9101            	  6933:     subx.b  D1,D0   ; SBC $0E
02:00031C00 0A3C0010        	  6934:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C04 19400670        	  6935:     move.b  D0,($0670,A4)
                            	  6936:     ; If full hearts >= high damage points byte, then simply
                            	  6937:     ; subtract the damage byte from full hearts.
                            	  6938:     ; Else go handle Link dying.
                            	  6939:     ;
02:00031C08 102C066F        	  6940:     move.b  ($066F,A4),D0
02:00031C0C 0200000F        	  6941:     andi.b #$0F,D0
02:00031C10 122C000D        	  6942:     move.b  ($000D,A4),D1
02:00031C14 B001            	  6943:     cmp.b   D1,D0
02:00031C16 6554            	  6944:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031C18 102C066F        	  6945:     move.b  ($066F,A4),D0
02:00031C1C 003C0011        	  6946:     ori     #$11,CCR  ; SEC: set C+X
02:00031C20 122C000D        	  6947:     move.b  ($000D,A4),D1
02:00031C24 0A3C0010        	  6948:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C28 9101            	  6949:     subx.b  D1,D0   ; SBC $0D
02:00031C2A 0A3C0010        	  6950:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C2E 1940066F        	  6951:     move.b  D0,($066F,A4)
02:00031C32 0A3C0001        	  6952:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031C36 4E75            	  6953:     rts
