                            	  4109: __far_z_04_0037:
                            	  4110:     ; State 0.
                            	  4111:     ;
                            	  4112:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4113:     ;
02:0003B1EE 102C0084        	  4114:     move.b  ($0084,A4),D0
02:0003B1F2 0C0000AD        	  4115:     cmpi.b  #$AD,D0
02:0003B1F6 661E            	  4116:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4117:     ; If Link's X < $70 or >= $81, then return.
                            	  4118:     ;
02:0003B1F8 102C0070        	  4119:     move.b  ($0070,A4),D0
02:0003B1FC 0C000070        	  4120:     cmpi.b  #$70,D0
02:0003B200 6514            	  4121:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B202 0C000081        	  4122:     cmpi.b  #$81,D0
02:0003B206 640E            	  4123:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4124:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4125:     ; halt Link, and start filling hearts.
                            	  4126:     ;
02:0003B208 522C00AD        	  4127:     addq.b  #1,($00AD,A4)
02:0003B20C 7040            	  4128:     moveq   #64,D0
02:0003B20E 194000AC        	  4129:     move.b  D0,($00AC,A4)
02:0003B212 19400063        	  4130:     move.b  D0,($0063,A4)
                            	  4131:     even
