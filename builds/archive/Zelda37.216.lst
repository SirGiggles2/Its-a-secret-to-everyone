                            	 11577: Gleeok_DrawBody:
                            	 11578:     ; The animation timer controls when the animation frame changes.
                            	 11579:     ; If it has not expired, then go decrement it and draw.
                            	 11580:     ;
02:0003E8BE 102C04E6        	 11581:     move.b  ($04E6,A4),D0
