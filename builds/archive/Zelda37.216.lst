02:0004C65A 003C0011        	  5348:     ori     #$11,CCR  ; SEC: set C+X
02:0004C65E 1214            	  5349:     move.b  ($0000,A4),D1
02:0004C660 0A3C0010        	  5350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C664 9101            	  5351:     subx.b  D1,D0   ; SBC $00
02:0004C666 0A3C0010        	  5352:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5353:     even
