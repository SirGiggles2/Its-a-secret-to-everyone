                            	 13555:     even
                            	 13556: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003F736 41F90003F70E    	 13557:     lea     (GanonColorTransferRecord).l,A0
02:0003F73C 10303000        	 13558:     move.b  (A0,D3.W),D0
02:0003F740 41EC0302        	 13559:     lea     ($0302,A4),A0
02:0003F744 11802000        	 13560:     move.b  D0,(A0,D2.W)
02:0003F748 5202            	 13561:     addq.b  #1,D2
02:0003F74A 5203            	 13562:     addq.b  #1,D3
02:0003F74C 0C030008        	 13563:     cmpi.b  #$08,D3
02:0003F750 66E4            	 13564:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003F752 19420301        	 13565:     move.b  D2,($0301,A4)
02:0003F756 101D            	 13566:     move.b  (A5)+,D0  ; PLA
02:0003F758 7600            	 13567:     moveq   #0,D3
02:0003F75A 1600            	 13568:     move.b  D0,D3
                            	 13569:     ; Overwrite the last 3 colors in the record, with the ones
                            	 13570:     ; ending at the index passed in.
                            	 13571:     ;
02:0003F75C 7402            	 13572:     moveq   #2,D2
                            	 13573:     even
