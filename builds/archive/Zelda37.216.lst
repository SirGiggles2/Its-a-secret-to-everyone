                            	  4440:     ; This seems to be unused code triggered by object attribute $10.
                            	  4441:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4442:     ;
02:0004C048 6100016C        	  4443:     jsr     ReverseObjDir
02:0004C04C 60000104        	  4444:     jmp     CheckBoundary
                            	  4445: 
