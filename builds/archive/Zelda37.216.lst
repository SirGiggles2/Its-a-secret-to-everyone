02:0003DCF8 19410002        	  9992:     move.b  D1,($0002,A4)
02:0003DCFC 122C0002        	  9993:     move.b  ($0002,A4),D1
02:0003DD00 C200            	  9994:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
