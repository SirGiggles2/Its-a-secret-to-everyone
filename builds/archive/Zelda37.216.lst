                            	  7669:     ;
02:00032078 102C0098        	  7670:     move.b  ($0098,A4),D0
02:0003207C 0200000C        	  7671:     andi.b #$0C,D0
02:00032080 6726            	  7672:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00032082 10343070        	  7673:     move.b  ($70,A4,D3.W),D0
02:00032086 023C00EE        	  7674:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003208A 123C0006        	  7675:     move.b  #$06,D1
