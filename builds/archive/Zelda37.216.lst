                            	  5039:     ;
02:00030CF0 194000FE        	  5040:     move.b  D0,($00FE,A4)
                            	  5041:     even
                            	  5042: _L_z01_UpdateBombFlashEffect_Exit:
02:00030CF4 4E75            	  5043:     rts
                            	  5044: 
