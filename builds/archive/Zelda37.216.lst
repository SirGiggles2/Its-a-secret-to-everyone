02:0004509A 162C0070        	  8567:     move.b  ($0070,A4),D3
02:0004509E 0C030020        	  8568:     cmpi.b  #$20,D3
02:000450A2 6706            	  8569:     beq  _anon_z05_175
02:000450A4 0C0300D0        	  8570:     cmpi.b  #$D0,D3
