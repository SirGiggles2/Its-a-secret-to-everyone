                            	  4079: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  4080:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  4081:     ;
                            	  4082:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  4083:     ;         or object direction when <> 0.
                            	  4084:     ;
                            	  4085:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  4086:     ;
                            	  4087:     ; if slot = 0 and grid offset <> 0 then
                            	  4088:     ;   if input dir = 0 then
                            	  4089:     ;     use 0
                            	  4090:     ;   else
                            	  4091:     ;     use object direction
                            	  4092:     ; else
                            	  4093:     ;   if slot <> 0 and (has clock or stunned) then
                            	  4094:     ;     return
                            	  4095:     ;   else
                            	  4096:     ;     if input dir = 0
                            	  4097:     ;       use 0
                            	  4098:     ;     else
                            	  4099:     ;       use input direction
                            	  4100:     ;
