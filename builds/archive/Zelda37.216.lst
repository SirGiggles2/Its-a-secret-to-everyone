02:000315DE 41F90003132E    	  6115:     lea     (ObjAnimations).l,A0
02:000315E4 10303000        	  6116:     move.b  (A0,D3.W),D0
02:000315E8 023C00EE        	  6117:     andi    #$EE,CCR  ; CLC: clear C+X
02:000315EC 122C000D        	  6118:     move.b  ($000D,A4),D1
02:000315F0 D101            	  6119:     addx.b  D1,D0   ; ADC $0D
02:000315F2 7600            	  6120:     moveq   #0,D3
