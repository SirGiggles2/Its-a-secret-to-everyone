                            	  7003: Aquamentus_Draw:
                            	  7004:     ; Every $10 screen frames, switch animation frames.
                            	  7005:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  7006:     ; The last tile of frame 0 is at index 5.
                            	  7007:     ; The last tile of frame 1 is at index $B.
                            	  7008:     ;
02:0003C722 7605            	  7009:     moveq   #5,D3
02:0003C724 102C0015        	  7010:     move.b  ($0015,A4),D0
02:0003C728 02000010        	  7011:     andi.b #$10,D0
02:0003C72C 6602            	  7012:     bne  _anon_z04_88
02:0003C72E 760B            	  7013:     moveq   #11,D3
                            	  7014: _anon_z04_88:
02:0003C730 1943000A        	  7015:     move.b  D3,($000A,A4)
                            	  7016:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  7017:     ;
02:0003C734 7005            	  7018:     moveq   #5,D0
02:0003C736 1940000B        	  7019:     move.b  D0,($000B,A4)
                            	  7020:     even
                            	  7021: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C73A 7600            	  7022:     moveq   #0,D3
02:0003C73C 162C000B        	  7023:     move.b  ($000B,A4),D3
                            	  7024:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  7025:     ; Store it in [00].
                            	  7026:     ;
02:0003C740 10342070        	  7027:     move.b  ($70,A4,D2.W),D0
02:0003C744 023C00EE        	  7028:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C748 41F90003C71C    	  7029:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C74E 12303000        	  7030:     move.b  (A0,D3.W),D1
02:0003C752 D101            	  7031:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C754 1880            	  7032:     move.b  D0,($0000,A4)
                            	  7033:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  7034:     ; Store it in [01].
                            	  7035:     ;
02:0003C756 41EC0084        	  7036:     lea     ($0084,A4),A0
02:0003C75A 10302000        	  7037:     move.b  (A0,D2.W),D0
02:0003C75E 023C00EE        	  7038:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C762 41F90003C716    	  7039:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C768 12303000        	  7040:     move.b  (A0,D3.W),D1
02:0003C76C D101            	  7041:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C76E 19400001        	  7042:     move.b  D0,($0001,A4)
                            	  7043:     ; Calculate sprite attributes:
                            	  7044:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  7045:     ;
                            	  7046:     ; If the boss is temporarily invincible, then
                            	  7047:     ; this makes it flash by cycling all the palette rows.
                            	  7048:     ;
                            	  7049:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  7050:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  7051:     ;
02:0003C772 41EC04F0        	  7052:     lea     ($04F0,A4),A0
02:0003C776 10302000        	  7053:     move.b  (A0,D2.W),D0
02:0003C77A 02000003        	  7054:     andi.b #$03,D0
02:0003C77E 0A000003        	  7055:     eori.b #$03,D0
02:0003C782 19400003        	  7056:     move.b  D0,($0003,A4)
02:0003C786 7600            	  7057:     moveq   #0,D3
02:0003C788 162C000A        	  7058:     move.b  ($000A,A4),D3
                            	  7059:     ; Look up the tile for this sprite.
                            	  7060:     ; If it's not the first one (face), then go write the sprite record.
                            	  7061:     ;
02:0003C78C 41F90003C70A    	  7062:     lea     (AquamentusTiles).l,A0
02:0003C792 10303000        	  7063:     move.b  (A0,D3.W),D0
02:0003C796 12390003C70A    	  7064:     move.b  (AquamentusTiles).l,D1
02:0003C79C B001            	  7065:     cmp.b   D1,D0
02:0003C79E 6610            	  7066:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  7067:     ; Else it's the first one (the face tile).
                            	  7068:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  7069:     ;
                            	  7070:     ; $CC/CD shows the closed mouth face.
                            	  7071:     ; $C0/C1 shows the open mouth face.
                            	  7072:     ;
02:0003C7A0 7600            	  7073:     moveq   #0,D3
02:0003C7A2 16342028        	  7074:     move.b  ($28,A4,D2.W),D3
02:0003C7A6 0C030020        	  7075:     cmpi.b  #$20,D3
02:0003C7AA 6404            	  7076:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C7AC 103C00C0        	  7077:     move.b  #$C0,D0
                            	  7078:     even
                            	  7079: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C7B0 610E            	  7080:     jsr     WriteBossSprite
                            	  7081:     ; Bottom of the loop.
                            	  7082:     ; Decrement tile index and loop index.
                            	  7083:     ;
02:0003C7B2 532C000A        	  7084:     subq.b  #1,($000A,A4)
02:0003C7B6 532C000B        	  7085:     subq.b  #1,($000B,A4)
02:0003C7BA 6A00FF7E        	  7086:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C7BE 4E75            	  7087:     rts
                            	  7088: 
                            	  7089: ; Params:
                            	  7090: ; A: tile
                            	  7091: ; [00]: X
                            	  7092: ; [01]: Y
                            	  7093: ; [03]: sprite attributes
                            	  7094: ;
                            	  7095: ; Save the tile
                            	  7096:     even
                            	  7097: WriteBossSprite:
02:0003C7C0 1B00            	  7098:     move.b  D0,-(A5)  ; PHA
02:0003C7C2 7600            	  7099:     moveq   #0,D3
02:0003C7C4 162C0341        	  7100:     move.b  ($0341,A4),D3
02:0003C7C8 41F900031546    	  7101:     lea     (SpriteOffsets).l,A0
02:0003C7CE 10303000        	  7102:     move.b  (A0,D3.W),D0
02:0003C7D2 7600            	  7103:     moveq   #0,D3
02:0003C7D4 1600            	  7104:     move.b  D0,D3
02:0003C7D6 101D            	  7105:     move.b  (A5)+,D0  ; PLA
02:0003C7D8 41EC0201        	  7106:     lea     ($0201,A4),A0
02:0003C7DC 11803000        	  7107:     move.b  D0,(A0,D3.W)
02:0003C7E0 1014            	  7108:     move.b  ($0000,A4),D0
02:0003C7E2 41EC0203        	  7109:     lea     ($0203,A4),A0
02:0003C7E6 11803000        	  7110:     move.b  D0,(A0,D3.W)
02:0003C7EA 102C0001        	  7111:     move.b  ($0001,A4),D0
02:0003C7EE 4EF9000318C4    	  7112:     jmp     Anim_EndWriteSprite
