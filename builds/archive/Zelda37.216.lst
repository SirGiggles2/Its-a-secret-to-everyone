                            	  2037: _L_z04_UpdateStatues_LoopFireball:
                            	  2038:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  2039:     ;
                            	  2040:     ; Decrement the fireball timer at this index.
                            	  2041:     ;
02:0003A3AC 7600            	  2042:     moveq   #0,D3
02:0003A3AE 41EC04E8        	  2043:     lea     ($04E8,A4),A0
02:0003A3B2 16302000        	  2044:     move.b  (A0,D2.W),D3
02:0003A3B6 5303            	  2045:     subq.b  #1,D3
02:0003A3B8 1003            	  2046:     move.b  D3,D0
02:0003A3BA 41EC04E8        	  2047:     lea     ($04E8,A4),A0
02:0003A3BE 11802000        	  2048:     move.b  D0,(A0,D2.W)
                            	  2049:     ; If it was not 0, then this fireball index has to keep waiting
                            	  2050:     ; to make a fireball. Go loop again.
