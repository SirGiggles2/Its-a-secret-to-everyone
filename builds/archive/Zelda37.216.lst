                            	   330: ;------------------------------------------------------------------------------
                            	   331: ; _c_move_object_shim — MoveObject trampoline.
                            	   332: ;
                            	   333: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   334: ;   Input:     D2 = slot (0..11)
                            	   335: ;   Preserves: D2, A4, A5
                            	   336: ;   Clobbers:  D0, D1, D3, A0
                            	   337: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   338: ;
                            	   339: ; GCC side:
                            	   340: ;   void c_move_object(unsigned short slot);
                            	   341: ;     slot arrives as a 16-bit value on the stack.
                            	   342: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   343: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   344: ;   never clobbered by gcc.
                            	   345: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   346: ;   semantics can exist in a pure C port).
                            	   347: ;------------------------------------------------------------------------------
                            	   348: _c_move_object_shim:
                            	   349:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   350:     move.b  #$AA,($0900,A4)
                            	   351:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   352:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   353:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   354:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   355:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   356:     moveq   #0,D0
02:0002B658 3002            	   357:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   358:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   359:     jsr     c_move_object
02:0002B662 588F            	   360:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   361:     rts
                            	   362: 
                            	   363: ;==============================================================================
                            	   364: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   365: ; and tail-call the native asm function.
                            	   366: ;
                            	   367: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   368: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   369: ; sign-extended).
                            	   370: ;==============================================================================
                            	   371: 
                            	   372: ;------------------------------------------------------------------------------
                            	   373: ; void c_copy_bank_to_window(unsigned int bank);
                            	   374: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   375: ;------------------------------------------------------------------------------
                            	   376: c_copy_bank_to_window:
02:0002B666 202F0004        	   377:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   378:     jmp     _copy_bank_to_window
                            	   379: 
                            	   380: ;------------------------------------------------------------------------------
                            	   381: ; unsigned char c_ppu_read_2(void);
                            	   382: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   383: ; C return: gcc expects result in D0.
                            	   384: ;------------------------------------------------------------------------------
                            	   385: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   386:     jmp     _ppu_read_2
                            	   387: 
                            	   388: ;------------------------------------------------------------------------------
