02:0003B1C6 41EC0405        	  4088:     lea     ($0405,A4),A0
02:0003B1CA 10302000        	  4089:     move.b  (A0,D2.W),D0
02:0003B1CE 670A            	  4090:     beq  _anon_z04_55
02:0003B1D0 705D            	  4091:     moveq   #93,D0
02:0003B1D2 41EC034F        	  4092:     lea     ($034F,A4),A0
02:0003B1D6 11802000        	  4093:     move.b  D0,(A0,D2.W)
