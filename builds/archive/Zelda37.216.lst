02:00043BE0 194000EE        	  6329:     move.b  D0,($00EE,A4)
                            	  6330:     even
                            	  6331: L_ResetDoorCmdAndLayOutDoors:
02:00043BE4 7000            	  6332:     moveq   #0,D0
02:00043BE6 19400054        	  6333:     move.b  D0,($0054,A4)
02:00043BEA 6000FCD4        	  6334:     jmp     LayOutDoors
                            	  6335: 
                            	  6336: _anon_z05_123:
                            	  6337:     ; Door command <> 4.
                            	  6338:     ; It must be 8, which means it was 7: open door.
                            	  6339:     ;
                            	  6340:     ; If the door is a shutter (7), then go add the door to the
                            	  6341:     ; opened door mask, reset door command, and lay out doors.
                            	  6342:     ;
02:00043BEE 102C0055        	  6343:     move.b  ($0055,A4),D0
02:00043BF2 19400002        	  6344:     move.b  D0,($0002,A4)
02:00043BF6 6100FA32        	  6345:     jsr     FindDoorAttrByDoorBit
02:00043BFA 0C000007        	  6346:     cmpi.b  #$07,D0
02:00043BFE 676E            	  6347:     beq  _anon_z05_124
                            	  6348:     ; Else the door is not a shutter.
                            	  6349:     ;
                            	  6350:     ;
                            	  6351:     ; [09] door direction index
02:00043C00 7400            	  6352:     moveq   #0,D2
02:00043C02 142C0009        	  6353:     move.b  ($0009,A4),D2
02:00043C06 6100DA8E        	  6354:     jsr     SetDoorFlag
                            	  6355:     ; Get the next room's ID.
                            	  6356:     ;
02:00043C0A 1003            	  6357:     move.b  D3,D0
02:00043C0C 023C00EE        	  6358:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043C10 41F900043ACC    	  6359:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043C16 12302000        	  6360:     move.b  (A0,D2.W),D1
02:00043C1A D101            	  6361:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043C1C 7600            	  6362:     moveq   #0,D3
02:00043C1E 1600            	  6363:     move.b  D0,D3
                            	  6364:     ; Flip the door direction index.
                            	  6365:     ;
02:00043C20 1002            	  6366:     move.b  D2,D0
02:00043C22 0A000001        	  6367:     eori.b #$01,D0
02:00043C26 7400            	  6368:     moveq   #0,D2
02:00043C28 1400            	  6369:     move.b  D0,D2
                            	  6370:     ; Set the door flag for the opposite door in the next room.
                            	  6371:     ;
02:00043C2A 1214            	  6372:     move.b  ($00,A4),D1   ; ptr lo
02:00043C2C 182C0001        	  6373:     move.b  ($01,A4),D4  ; ptr hi
02:00043C30 024100FF        	  6374:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C34 E14C            	  6375:     lsl.w   #8,D4
02:00043C36 8841            	  6376:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043C38 48C4            	  6377:     ext.l   D4
