                            	  5798: WriteBlankPrioritySprites:
                            	  5799:     ; UNKNOWN: Why are their Y coordinates $3D and $DD?
                            	  5800:     ; Those values are the highest and lowest that Link can normally take.
                            	  5801:     ;
                            	  5802:     ; Repeat two sprites in the first $10 records. They have
                            	  5803:     ; transparent tile $1C, priority 1 (behind BG), and X=0.
                            	  5804:     ; The first of the pair has Y=$3D, and the second one has Y=$DD.
                            	  5805:     ;
                            	  5806:     ; These sprites are first in the list. So they are used for things
                            	  5807:     ; that must be shown above everything else, including Link.
                            	  5808:     ;
02:00031274 7600            	  5809:     moveq   #0,D3
02:00031276 7400            	  5810:     moveq   #0,D2
