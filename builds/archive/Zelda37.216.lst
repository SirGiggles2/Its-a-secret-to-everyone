02:0003CD54 41EC0098        	  7919:     lea     ($0098,A4),A0
02:0003CD58 16302000        	  7920:     move.b  (A0,D2.W),D3
02:0003CD5C 0C030008        	  7921:     cmpi.b  #$08,D3
02:0003CD60 6604            	  7922:     bne  _anon_z04_95
02:0003CD62 522C000F        	  7923:     addq.b  #1,($000F,A4)
