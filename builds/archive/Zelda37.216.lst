                            	 12575: __far_z_04_0125:
                            	 12576:     ; State = 0.
                            	 12577:     ;
                            	 12578:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12579:     ; This is the only patra child shown in the first fame.
                            	 12580:     ;
02:0003F044 0C020002        	 12581:     cmpi.b  #$02,D2
02:0003F048 6732            	 12582:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12583:     ; The patra child in slot 2 is the last one to be updated.
                            	 12584:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12585:     ;
                            	 12586:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12587:     ; shown.
                            	 12588:     ;
02:0003F04A 102C00AE        	 12589:     move.b  ($00AE,A4),D0
02:0003F04E 6700008E        	 12590:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12591:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12592:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12593:     ;
02:0003F052 1002            	 12594:     move.b  D2,D0
                            	 12595:     ; Subtract 3 from the object slot to get the angle where the
                            	 12596:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12597:     ;
02:0003F054 003C0011        	 12598:     ori     #$11,CCR  ; SEC: set C+X
