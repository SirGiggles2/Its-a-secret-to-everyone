                            	  7192: UpdateDodongoState2_Stunned:
                            	  7193:     ; Take action depending on the value of stun timer:
                            	  7194:     ; 0:     set stun timer to $20 
                            	  7195:     ; 1:     go back to state 0
                            	  7196:     ; other: return
                            	  7197:     ;
02:0003C884 7600            	  7198:     moveq   #0,D3
02:0003C886 1634203D        	  7199:     move.b  ($3D,A4,D2.W),D3
02:0003C88A 5303            	  7200:     subq.b  #1,D3
02:0003C88C 6604            	  7201:     bne.s  __far_z_04_0062
02:0003C88E 600000D0        	  7202:     jmp  UpdateDodongoState1_Bloated_Sub_End
