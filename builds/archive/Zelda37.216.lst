                            	 11584: __far_z_04_0112:
                            	 11585:     ; The animation timer has expired. There are two choices for arming it.
                            	 11586:     ;
                            	 11587:     ; When writhing after a hit, Gleeok animates faster.
                            	 11588:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11589:     ; Otherwise, set a longer time ($10).
                            	 11590:     ;
