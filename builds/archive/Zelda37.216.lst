                            	  1689: ; [end inline] dat\ObjListAddrs.inc
                            	  1690: 
                            	  1691:     even
                            	  1692: InitMode4:
02:00041094 7400            	  1693:     moveq   #0,D2
02:00041096 142C0013        	  1694:     move.b  ($0013,A4),D2
02:0004109A 6604            	  1695:     bne.s  __far_z_05_0028
02:0004109C 60000086        	  1696:     jmp  InitMode_EnterRoom
                            	  1697: __far_z_05_0028:
02:000410A0 5302            	  1698:     subq.b  #1,D2
02:000410A2 6612            	  1699:     bne  _L_z05_InitMode4_CheckSub2
                            	  1700:     ; Submode 1.
                            	  1701:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1702:     ;
                            	  1703:     ; TODO:
                            	  1704:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1705:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1706:     ; A positive value triggers this submode 1 to transfer
                            	  1707:     ; the whole play area.
                            	  1708:     ;
                            	  1709:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1710:     ; a good state reflecting the new room. The only thing
                            	  1711:     ; needed is possibly to brighten the room by way of
                            	  1712:     ; changing the palette.
                            	  1713:     ;
                            	  1714:     ; So why does mode 7 trigger this?
                            	  1715:     ; Is there another mode that truly needs this behavior?
                            	  1716:     ;
02:000410A4 102C00E9        	  1717:     move.b  ($00E9,A4),D0
02:000410A8 6B06            	  1718:     bmi  _anon_z05_40
02:000410AA 6100373C        	  1719:     jsr     CopyNextRowToTransferBuf
02:000410AE 6404            	  1720:     bcc  _L_z05_InitMode4_Exit
                            	  1721: _anon_z05_40:
02:000410B0 522C0013        	  1722:     addq.b  #1,($0013,A4)
                            	  1723:     even
                            	  1724: _L_z05_InitMode4_Exit:
02:000410B4 4E75            	  1725:     rts
                            	  1726: 
                            	  1727:     even
                            	  1728: _L_z05_InitMode4_CheckSub2:
02:000410B6 5302            	  1729:     subq.b  #1,D2
02:000410B8 6702            	  1730:     beq.s  __far_z_05_0029
02:000410BA 605A            	  1731:     jmp  InitMode4_Sub3
                            	  1732: __far_z_05_0029:
                            	  1733:     ; Submode 2.
                            	  1734:     ;
02:000410BC 7600            	  1735:     moveq   #0,D3
02:000410BE 162C00EB        	  1736:     move.b  ($00EB,A4),D3
02:000410C2 610045BE        	  1737:     jsr     IsDarkRoom_Bank5
02:000410C6 6702            	  1738:     beq.s  __far_z_05_0030
02:000410C8 6054            	  1739:     jmp  InitMode4_GoToSub0
                            	  1740: __far_z_05_0030:
                            	  1741:     ; This is a light room.
                            	  1742:     ; See if we have to brighten it after leaving a dark room.
                            	  1743:     ;
02:000410CA 102C0098        	  1744:     move.b  ($0098,A4),D0
02:000410CE 610043FA        	  1745:     jsr     CalcNextRoomByDir
                            	  1746:     ; Subtract RoomId from next room ID that was calculated
                            	  1747:     ; to get room ID offset in that direction.
02:000410D2 003C0011        	  1748:     ori     #$11,CCR  ; SEC: set C+X
02:000410D6 122C00EB        	  1749:     move.b  ($00EB,A4),D1
