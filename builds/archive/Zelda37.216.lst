02:0003649C 0C000008        	  5014:     cmpi.b  #$08,D0
02:000364A0 6B1A            	  5015:     bmi  _anon_z02_37
02:000364A2 102C050B        	  5016:     move.b  ($050B,A4),D0
02:000364A6 123C0008        	  5017:     move.b  #$08,D1
02:000364AA 0A3C0010        	  5018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000364AE 9101            	  5019:     subx.b  D1,D0   ; SBC #$08
02:000364B0 0A3C0010        	  5020:     eori    #$10,CCR  ; restore X = 6502 C
