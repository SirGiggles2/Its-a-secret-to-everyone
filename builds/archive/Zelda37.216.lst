02:0003F72C 1B00            	 13547:     move.b  D0,-(A5)  ; PHA
                            	 13548:     ; Get the length, to append to the dynamic transfer buf.
                            	 13549:     ;
02:0003F72E 7400            	 13550:     moveq   #0,D2
02:0003F730 142C0301        	 13551:     move.b  ($0301,A4),D2
                            	 13552:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 13553:     ;
