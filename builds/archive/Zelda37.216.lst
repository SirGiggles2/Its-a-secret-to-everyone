02:0003206C 102C000D        	  7645:     move.b  ($000D,A4),D0
02:00032070 1940000E        	  7646:     move.b  D0,($000E,A4)
                            	  7647: ; Params:
                            	  7648: ; X: monster object slot
                            	  7649: ; [00]: weapon object slot
                            	  7650: ; [02]: monster object mid X
                            	  7651: ; [03]: monster object mid Y
                            	  7652: ; [07]: damage points
                            	  7653: ; [09]: damage type
                            	  7654: ; [0D]: horizontal threshold
                            	  7655: ; [0E]: vertical threshold
