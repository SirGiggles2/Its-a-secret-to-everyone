                            	  1676: AnimateDemoPhase0Subphase1:
02:000342EA 102C0438        	  1677:     move.b  ($0438,A4),D0
02:000342EE 666C            	  1678:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1679:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1680:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1681:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:000342F0 7000            	  1682:     moveq   #0,D0
02:000342F2 102C0437        	  1683:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:000342F6 EB48            	  1684:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:000342F8 41F9000340DA    	  1685:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:000342FE D0C0            	  1686:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1687:     ; Set up DynTileBuf header: $3F, $00, $20
02:00034300 197C003F0302    	  1688:     move.b  #$3F,($0302,A4)
02:00034306 197C00000303    	  1689:     move.b  #$00,($0303,A4)
02:0003430C 7020            	  1690:     moveq   #32,D0
02:0003430E 19400304        	  1691:     move.b  D0,($0304,A4)
                            	  1692:     ; End marker at DynTileBuf+4+31
02:00034312 761F            	  1693:     moveq   #31,D3
02:00034314 103C00FF        	  1694:     move.b  #$FF,D0
02:00034318 43EC0306        	  1695:     lea     ($0306,A4),A1
02:0003431C 13803000        	  1696:     move.b  D0,(A1,D3.W)
                            	  1697:     even
                            	  1698: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00034320 10303000        	  1699:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00034324 43EC0305        	  1700:     lea     ($0305,A4),A1
02:00034328 13803000        	  1701:     move.b  D0,(A1,D3.W)
02:0003432C 5303            	  1702:     subq.b  #1,D3
02:0003432E 6AF0            	  1703:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1704:     ; Advance the subphase cycle.
                            	  1705:     ;
02:00034330 522C0437        	  1706:     addq.b  #1,($0437,A4)
                            	  1707:     ; Set the timer to the delay for the current point in the cycle.
                            	  1708:     ;
02:00034334 7600            	  1709:     moveq   #0,D3
02:00034336 162C0437        	  1710:     move.b  ($0437,A4),D3
02:0003433A 41F9000342D9    	  1711:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00034340 10303000        	  1712:     move.b  (A0,D3.W),D0
02:00034344 19400438        	  1713:     move.b  D0,($0438,A4)
02:00034348 0C03000E        	  1714:     cmpi.b  #$0E,D3
02:0003434C 650E            	  1715:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1716:     ; Advance to the next demo phase.
                            	  1717:     ;
02:0003434E 522C042C        	  1718:     addq.b  #1,($042C,A4)
02:00034352 7000            	  1719:     moveq   #0,D0
02:00034354 1940042D        	  1720:     move.b  D0,($042D,A4)
02:00034358 19400011        	  1721:     move.b  D0,($0011,A4)
                            	  1722:     even
