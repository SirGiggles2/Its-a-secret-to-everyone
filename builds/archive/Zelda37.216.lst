                            	   292:     ; Advance state.
                            	   293:     ;
02:000401EC 704C            	   294:     moveq   #76,D0
02:000401EE 6702            	   295:     beq.s  __far_z_05_0001
02:000401F0 60EA            	   296:     jmp  SelectTransferBufAndIncState
                            	   297: __far_z_05_0001:
