02:00040780 0C000008        	  1064:     cmpi.b  #$08,D0
02:00040784 6618            	  1065:     bne  _L_z05_InitMode7_Sub5_CheckDark
                            	  1066:     ; Scrolling up.
                            	  1067:     ;
                            	  1068:     ;
                            	  1069:     ; Lay out the next room now, because we had to transfer
