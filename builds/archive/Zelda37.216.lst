02:0003A47A 6AD0            	  2137:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2138:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2139:     ; 0 or 1 time, instead of 2.
                            	  2140:     ;
                            	  2141:     ; This, in turn, means that the distance between Link and the
                            	  2142:     ; fireball was >= $18 in at least one axis.
                            	  2143:     ;
                            	  2144:     ; So, we're OK to finish making the fireball.
                            	  2145:     ;
