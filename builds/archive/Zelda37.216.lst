02:0004C9CC 0C000030        	  5866:     cmpi.b  #$30,D0
02:0004C9D0 6656            	  5867:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5868:     ; State $3x. Slow down.
                            	  5869:     ;
                            	  5870:     ; Reset grid offset for movement.
                            	  5871:     ;
02:0004C9D2 7000            	  5872:     moveq   #0,D0
02:0004C9D4 41EC0394        	  5873:     lea     ($0394,A4),A0
02:0004C9D8 11802000        	  5874:     move.b  D0,(A0,D2.W)
                            	  5875:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5876:     ;
02:0004C9DC 7040            	  5877:     moveq   #64,D0
02:0004C9DE 41EC03BC        	  5878:     lea     ($03BC,A4),A0
02:0004C9E2 11802000        	  5879:     move.b  D0,(A0,D2.W)
                            	  5880:     ; If facing left and X < 2, then go change state to $40. The
                            	  5881:     ; boomerang is too close to the left edge of the screen.
                            	  5882:     ; Another move might make it wrap around.
                            	  5883:     ;
02:0004C9E6 41EC0098        	  5884:     lea     ($0098,A4),A0
02:0004C9EA 10302000        	  5885:     move.b  (A0,D2.W),D0
02:0004C9EE 1940000F        	  5886:     move.b  D0,($000F,A4)
02:0004C9F2 02000002        	  5887:     andi.b #$02,D0
02:0004C9F6 670A            	  5888:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C9F8 10342070        	  5889:     move.b  ($70,A4,D2.W),D0
02:0004C9FC 0C000002        	  5890:     cmpi.b  #$02,D0
02:0004CA00 650E            	  5891:     bcs  _L_z07_CheckState30_SetState40
                            	  5892:     even
