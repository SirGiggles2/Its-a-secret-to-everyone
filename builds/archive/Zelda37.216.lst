                            	  2786: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2787:     ; Set state 1 to jump.
                            	  2788:     ;
02:0003A884 41EC00AC        	  2789:     lea     ($00AC,A4),A0
