                            	  7966: _L_z01_BeginShove_MonsterDefender:
                            	  7967:     ; A monster is the defender. A weapon is the attacker.
                            	  7968:     ;
                            	  7969:     ; Set the shove direction to the weapon's direction,
                            	  7970:     ; instead of the direction passed in [0B].
                            	  7971:     ;
