                            	  7129: UpdateDodongoState:
02:0003C80C 41EC00AC        	  7130:     lea     ($00AC,A4),A0
02:0003C810 10302000        	  7131:     move.b  (A0,D2.W),D0
02:0003C814 4EB90002AECA    	  7132:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
