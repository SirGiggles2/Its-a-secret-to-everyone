                            	  9911: Manhandla_Move:
                            	  9912:     ; Implement a way of manifesting the fractional part of the speed
                            	  9913:     ; in the movement.
                            	  9914:     ;
                            	  9915:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9916:     ; byte to add to the coordinates, then the effective speed would
                            	  9917:     ; be 1 pixel a frame instead of 1.25.
                            	  9918:     ;
                            	  9919:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9920:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9921:     ;
                            	  9922:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9923:     ;
                            	  9924:     ;   SA := SA + (SL AND $E0)
                            	  9925:     ;   [03] := SH + carry
                            	  9926:     ;
                            	  9927:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9928:     ;
02:0003DC5C 41EC041F        	  9929:     lea     ($041F,A4),A0
02:0003DC60 10302000        	  9930:     move.b  (A0,D2.W),D0
02:0003DC64 020000E0        	  9931:     andi.b #$E0,D0
02:0003DC68 023C00EE        	  9932:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC6C 41EC0412        	  9933:     lea     ($0412,A4),A0
02:0003DC70 12302000        	  9934:     move.b  (A0,D2.W),D1
02:0003DC74 D101            	  9935:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC76 41EC0412        	  9936:     lea     ($0412,A4),A0
02:0003DC7A 11802000        	  9937:     move.b  D0,(A0,D2.W)
                            	  9938:     ; Assign (high speed byte + carry) to [03].
                            	  9939:     ;
02:0003DC7E 41EC042C        	  9940:     lea     ($042C,A4),A0
02:0003DC82 10302000        	  9941:     move.b  (A0,D2.W),D0
02:0003DC86 123C0000        	  9942:     move.b  #$00,D1
02:0003DC8A D101            	  9943:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DC8C 19400003        	  9944:     move.b  D0,($0003,A4)
                            	  9945:     ; Change coordinates by the speed amount/offset in [03]
                            	  9946:     ; according to the direction.
                            	  9947:     ;
                            	  9948:     ; Start with a mask of $A1 in [02]:
                            	  9949:     ; - low nibble represents the right direction
                            	  9950:     ; - high nibble is used to set or clear carry as we go along
                            	  9951:     ;
02:0003DC90 103C00A1        	  9952:     move.b  #$A1,D0
02:0003DC94 19400002        	  9953:     move.b  D0,($0002,A4)
                            	  9954:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9955:     ;
02:0003DC98 41EC0098        	  9956:     lea     ($0098,A4),A0
02:0003DC9C 10302000        	  9957:     move.b  (A0,D2.W),D0
02:0003DCA0 122C0002        	  9958:     move.b  ($0002,A4),D1
02:0003DCA4 C200            	  9959:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCA6 6712            	  9960:     beq  _L_z04_Manhandla_Move_Left
02:0003DCA8 10342070        	  9961:     move.b  ($70,A4,D2.W),D0
02:0003DCAC 023C00EE        	  9962:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCB0 122C0003        	  9963:     move.b  ($0003,A4),D1
02:0003DCB4 D101            	  9964:     addx.b  D1,D0   ; ADC $03
02:0003DCB6 19802070        	  9965:     move.b  D0,($70,A4,D2.W)
                            	  9966:     even
