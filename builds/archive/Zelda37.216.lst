02:0003BFB8 10303000        	  5963:     move.b  (A0,D3.W),D0
02:0003BFBC 0C000041        	  5964:     cmpi.b  #$41,D0
02:0003BFC0 66F0            	  5965:     bne  _anon_z04_80
                            	  5966:     ; I don't know why the object timer of the tail segment that will
                            	  5967:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5968:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5969:     ; there, the object timer is set to 6.
                            	  5970:     ;
02:0003BFC2 7011            	  5971:     moveq   #17,D0
02:0003BFC4 19803029        	  5972:     move.b  D0,($29,A4,D3.W)
                            	  5973:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5974:     ; segment to the tail segment.
                            	  5975:     ;
02:0003BFC8 41EC04F0        	  5976:     lea     ($04F0,A4),A0
02:0003BFCC 10302000        	  5977:     move.b  (A0,D2.W),D0
