                            	  7561: DodongoBombPositiveLimits:
02:0003CB0C 0C              	  7562:     dc.b    $0C, $11
02:0003CB0D 11
                            	  7563: 
                            	  7564:     even
                            	  7565: DodongoBombNegativeLimits:
02:0003CB0E F4              	  7566:     dc.b    $F4, $F0
02:0003CB0F F0
                            	  7567: 
                            	  7568: ; Params:
                            	  7569: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7570: ; [00]: monster hotspot X
                            	  7571: ; [01]: monster hotspot Y
                            	  7572: ; [02]: bomb hotspot X
                            	  7573: ; [03]: bomb hotspot Y
                            	  7574: ;
                            	  7575: ; Returns:
                            	  7576: ; A: 0 if the bomb is in range of the monster
                            	  7577: ; Z: 1 if the bomb is in range of the monster
                            	  7578: ; [04]: horizontal distance
                            	  7579: ; [05]: vertical distance
                            	  7580: ;
                            	  7581: ; Store the positive limit in [06], and the negative one in [07].
                            	  7582: ;
                            	  7583:     even
                            	  7584: Dodongo_IsBombInRange:
02:0003CB10 41F90003CB0C    	  7585:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CB16 10303000        	  7586:     move.b  (A0,D3.W),D0
02:0003CB1A 19400006        	  7587:     move.b  D0,($0006,A4)
02:0003CB1E 41F90003CB0E    	  7588:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CB24 10303000        	  7589:     move.b  (A0,D3.W),D0
02:0003CB28 19400007        	  7590:     move.b  D0,($0007,A4)
                            	  7591:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7592:     ; the bomb is near enough the monster.
                            	  7593:     ;
02:0003CB2C 7003            	  7594:     moveq   #3,D0
02:0003CB2E 19400008        	  7595:     move.b  D0,($0008,A4)
                            	  7596:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7597:     ;
02:0003CB32 7601            	  7598:     moveq   #1,D3
                            	  7599:     even
                            	  7600: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7601:     ; Subtract the bomb's coordinate from the boss's,
                            	  7602:     ; The loop index determines the coordinate.
                            	  7603:     ;
02:0003CB34 10343000        	  7604:     move.b  ($00,A4,D3.W),D0
02:0003CB38 003C0011        	  7605:     ori     #$11,CCR  ; SEC: set C+X
02:0003CB3C 12343002        	  7606:     move.b  ($02,A4,D3.W),D1
02:0003CB40 0A3C0010        	  7607:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CB44 9101            	  7608:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CB46 0A3C0010        	  7609:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7610:     ; If the distance >= positive offset, or < negative offset;
                            	  7611:     ; then loop again.
                            	  7612:     ;
02:0003CB4A 122C0006        	  7613:     move.b  ($0006,A4),D1
02:0003CB4E B001            	  7614:     cmp.b   D1,D0
02:0003CB50 6A16            	  7615:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CB52 122C0007        	  7616:     move.b  ($0007,A4),D1
02:0003CB56 B001            	  7617:     cmp.b   D1,D0
02:0003CB58 6B0E            	  7618:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7619:     ; The distance is close enough in this axis.
                            	  7620:     ;
                            	  7621:     ; Store the distance in this axis in [05] or [04],
                            	  7622:     ; depending on the loop index.
                            	  7623:     ;
02:0003CB5A 19803004        	  7624:     move.b  D0,($04,A4,D3.W)
                            	  7625:     ; Shift [08] right, because we're in range in this axis.
                            	  7626:     ;
02:0003CB5E 122C0008        	  7627:     move.b  ($0008,A4),D1
02:0003CB62 E209            	  7628:     lsr.b  #1,D1   ; LSR $08
02:0003CB64 19410008        	  7629:     move.b  D1,($0008,A4)
                            	  7630:     even
                            	  7631: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CB68 5303            	  7632:     subq.b  #1,D3
02:0003CB6A 6AC8            	  7633:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7634:     ; If close enough in both axes, then [08] will be 0.
                            	  7635:     ;
02:0003CB6C 102C0008        	  7636:     move.b  ($0008,A4),D0
02:0003CB70 4E75            	  7637:     rts
                            	  7638: 
                            	  7639: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7640: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7641: ;
                            	  7642: ; But these are not typical direction indexes. Instead a
                            	  7643: ; 5-way index is used.
                            	  7644: ; A direction shifted right once becomes a 5-way index.
                            	  7645: ; The fourth element is unused.
                            	  7646: ;
                            	  7647:     even
                            	  7648: DodongoFrameImages:
02:0003CB72 00              	  7649:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CB73 01
02:0003CB74 06
02:0003CB75 FF
02:0003CB76 08
02:0003CB77 02
02:0003CB78 03
02:0003CB79 06
02:0003CB7A FF              	  7650:     dc.b    $FF, $08
