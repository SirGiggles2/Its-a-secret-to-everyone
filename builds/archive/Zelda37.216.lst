                            	  6354: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6355:     ; Store the weapon's frame (horizontal or vertical)
                            	  6356:     ; for the direction chosen above in [0C].
                            	  6357:     ;
02:0004CD74 4EB9000309B4    	  6358:     jsr     GetOppositeDir
02:0004CD7A 41F90004C7AE    	  6359:     lea     (RDirectionToWeaponFrame).l,A0
02:0004CD80 10303000        	  6360:     move.b  (A0,D3.W),D0
02:0004CD84 1940000C        	  6361:     move.b  D0,($000C,A4)
                            	  6362:     ; Calculate sprite attributes.
                            	  6363:     ;
                            	  6364:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6365:     ;   base attribute OR 1
                            	  6366:     ; So, it uses palette row 5.
                            	  6367:     ;
02:0004CD88 41F90004C7B2    	  6368:     lea     (RDirectionToWeaponBaseAttribute).l,A0
