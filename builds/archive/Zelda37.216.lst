                            	  2352:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2353:     ;
                            	  2354:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2355:     ; In total, 11 bytes will be written.
                            	  2356:     ;
                            	  2357:     ; First, write the high byte of PPU address in each record.
                            	  2358:     ;
