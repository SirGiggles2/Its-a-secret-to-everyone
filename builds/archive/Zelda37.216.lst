02:0003E708 123C0007        	 11335:     move.b  #$07,D1
02:0003E70C D101            	 11336:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E70E 7400            	 11337:     moveq   #0,D2
02:0003E710 1400            	 11338:     move.b  D0,D2
