02:0004CBCA 122C0004        	  6141:     move.b  ($0004,A4),D1
02:0004CBCE D101            	  6142:     addx.b  D1,D0   ; ADC $04
02:0004CBD0 19400004        	  6143:     move.b  D0,($0004,A4)
02:0004CBD4 761D            	  6144:     moveq   #29,D3
02:0004CBD6 601C            	  6145:     jmp     L_DrawArrowOrBoomerang
