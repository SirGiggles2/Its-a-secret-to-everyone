02:000438CA 1B00            	  5844:     move.b  D0,-(A5)  ; PHA
02:000438CC 1940000B        	  5845:     move.b  D0,($000B,A4)
02:000438D0 41F90004389C    	  5846:     lea     (DoorBits).l,A0
