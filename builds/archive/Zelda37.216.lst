                            	  6133: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  6134:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  6135:     ;
02:0003C0A2 7004            	  6136:     moveq   #4,D0
02:0003C0A4 1880            	  6137:     move.b  D0,($0000,A4)
                            	  6138:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6139:     ;
02:0003C0A6 7600            	  6140:     moveq   #0,D3
02:0003C0A8 0C020005        	  6141:     cmpi.b  #$05,D2
02:0003C0AC 6702            	  6142:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C0AE 7605            	  6143:     moveq   #5,D3
                            	  6144:     even
                            	  6145: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6146:     ; Copy old direction from a higher slot to the lower one;
                            	  6147:     ; and to the lower one's facing direction.
                            	  6148:     ;
02:0003C0B0 41EC0382        	  6149:     lea     ($0382,A4),A0
02:0003C0B4 10303000        	  6150:     move.b  (A0,D3.W),D0
02:0003C0B8 41EC0381        	  6151:     lea     ($0381,A4),A0
02:0003C0BC 11803000        	  6152:     move.b  D0,(A0,D3.W)
02:0003C0C0 41EC0099        	  6153:     lea     ($0099,A4),A0
02:0003C0C4 11803000        	  6154:     move.b  D0,(A0,D3.W)
                            	  6155:     ; Bottom of the loop.
                            	  6156:     ; Increment segment index.
                            	  6157:     ; Decrement loop counter.
                            	  6158:     ;
02:0003C0C8 5203            	  6159:     addq.b  #1,D3
02:0003C0CA 5314            	  6160:     subq.b  #1,($0000,A4)
02:0003C0CC 66E2            	  6161:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  6162:     ; Copy current direction to old direction.
                            	  6163:     ;
02:0003C0CE 41EC0098        	  6164:     lea     ($0098,A4),A0
02:0003C0D2 10302000        	  6165:     move.b  (A0,D2.W),D0
02:0003C0D6 41EC0380        	  6166:     lea     ($0380,A4),A0
02:0003C0DA 11802000        	  6167:     move.b  D0,(A0,D2.W)
                            	  6168:     even
