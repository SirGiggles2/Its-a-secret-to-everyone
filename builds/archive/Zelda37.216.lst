                            	  7576: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7577:     ; If the "monsters from edges" long timer expired, then
                            	  7578:     ; go bring the monster in.
                            	  7579:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7580:     ;
                            	  7581:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7582:     ; residual position so enemies keep their previous-room
                            	  7583:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D6E6 102C004B        	  7584:     move.b  ($004B,A4),D0
02:0004D6EA 662E            	  7585:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7586:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D6EC 102C000F        	  7587:     move.b  ($000F,A4),D0
02:0004D6F0 0C0000FF        	  7588:     cmpi.b  #$FF,D0
02:0004D6F4 662E            	  7589:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D6F6 41EC0070        	  7590:     lea     ($0070,A4),A0
02:0004D6FA 10302000        	  7591:     move.b  (A0,D2.W),D0
02:0004D6FE 660A            	  7592:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D700 41EC0084        	  7593:     lea     ($0084,A4),A0
02:0004D704 10302000        	  7594:     move.b  (A0,D2.W),D0
02:0004D708 671A            	  7595:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7596:     even
