02:0003A418 142C000A        	  2096:     move.b  ($000A,A4),D2
                            	  2097:     ; Look up and set the X coordinate for the fireball object.
                            	  2098:     ; Also store it in [02].
                            	  2099:     ;
02:0003A41C 41F90003A340    	  2100:     lea     (StatueXs).l,A0
02:0003A422 10303000        	  2101:     move.b  (A0,D3.W),D0
02:0003A426 19400002        	  2102:     move.b  D0,($0002,A4)
02:0003A42A 19802070        	  2103:     move.b  D0,($70,A4,D2.W)
                            	  2104:     ; Look up and set the Y coordinate for the fireball object.
                            	  2105:     ; Also store it in [03].
                            	  2106:     ;
02:0003A42E 41F90003A348    	  2107:     lea     (StatueYs).l,A0
02:0003A434 10303000        	  2108:     move.b  (A0,D3.W),D0
02:0003A438 19400003        	  2109:     move.b  D0,($0003,A4)
02:0003A43C 41EC0084        	  2110:     lea     ($0084,A4),A0
02:0003A440 11802000        	  2111:     move.b  D0,(A0,D2.W)
                            	  2112:     ; Set mask value 3 in [04].
                            	  2113:     ;
02:0003A444 7003            	  2114:     moveq   #3,D0
02:0003A446 19400004        	  2115:     move.b  D0,($0004,A4)
                            	  2116:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2117:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2118:     ;
02:0003A44A 7601            	  2119:     moveq   #1,D3
                            	  2120:     even
                            	  2121: _L_z04_UpdateStatues_LoopAxis:
