02:00043936 1400            	  5929:     move.b  D0,D2
02:00043938 1003            	  5930:     move.b  D3,D0
                            	  5931:     ; If provisional door face is not for a shutter, then
                            	  5932:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5933:     ;
                            	  5934:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5935:     ;
02:0004393A 0C000007        	  5936:     cmpi.b  #$07,D0
02:0004393E 670E            	  5937:     beq  _anon_z05_111
02:00043940 1B00            	  5938:     move.b  D0,-(A5)  ; PHA
02:00043942 6100DD52        	  5939:     jsr     SetDoorFlag
02:00043946 101D            	  5940:     move.b  (A5)+,D0  ; PLA
                            	  5941:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5942:     ; then go make it 9 (open "bombable").
                            	  5943:     ; Else make it 4 (open "door").
                            	  5944:     ;
02:00043948 0C000008        	  5945:     cmpi.b  #$08,D0
02:0004394C 67A4            	  5946:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5947: _anon_z05_111:
