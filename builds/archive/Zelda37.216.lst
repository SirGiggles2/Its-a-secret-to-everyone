                            	  7140: UpdateDodongoState0_Move:
                            	  7141:     ; If facing left, then push X offset 0 on the stack.
                            	  7142:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7143:     ;
                            	  7144:     ; We would like to use one set of coordinates only.
                            	  7145:     ; But movement would break down, if we did; because
                            	  7146:     ; Dodongo is so long.
                            	  7147:     ;
                            	  7148:     ; So, when not facing left, we temporarily shift the
                            	  7149:     ; X coordinate to be closer to the other side of the monster.
                            	  7150:     ;
02:0003C826 7600            	  7151:     moveq   #0,D3
02:0003C828 41EC0098        	  7152:     lea     ($0098,A4),A0
02:0003C82C 10302000        	  7153:     move.b  (A0,D2.W),D0
02:0003C830 0200000D        	  7154:     andi.b #$0D,D0
02:0003C834 6716            	  7155:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C836 10342070        	  7156:     move.b  ($70,A4,D2.W),D0
02:0003C83A 023C00EE        	  7157:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C83E 123C0010        	  7158:     move.b  #$10,D1
02:0003C842 D101            	  7159:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C844 19802070        	  7160:     move.b  D0,($70,A4,D2.W)
02:0003C848 163C00F0        	  7161:     move.b  #$F0,D3
                            	  7162:     even
                            	  7163: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C84C 1003            	  7164:     move.b  D3,D0
02:0003C84E 1B00            	  7165:     move.b  D0,-(A5)  ; PHA
02:0003C850 7020            	  7166:     moveq   #32,D0
02:0003C852 41EC041F        	  7167:     lea     ($041F,A4),A0
02:0003C856 11802000        	  7168:     move.b  D0,(A0,D2.W)
02:0003C85A 6100CEF4        	  7169:     jsr     Wanderer_TargetPlayer
                            	  7170:     ; Pop the offset and add it to the X coordinate.
                            	  7171:     ;
                            	  7172:     ; This brings the X coordinate back to the unique value
                            	  7173:     ; that represents the position.
                            	  7174:     ;
02:0003C85E 101D            	  7175:     move.b  (A5)+,D0  ; PLA
02:0003C860 023C00EE        	  7176:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C864 12342070        	  7177:     move.b  ($70,A4,D2.W),D1
02:0003C868 D101            	  7178:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C86A 19802070        	  7179:     move.b  D0,($70,A4,D2.W)
                            	  7180:     ; If X coordinate < $20, then face right.
                            	  7181:     ;
02:0003C86E 0C000020        	  7182:     cmpi.b  #$20,D0
02:0003C872 640A            	  7183:     bcc  _anon_z04_89
02:0003C874 7001            	  7184:     moveq   #1,D0
02:0003C876 41EC0098        	  7185:     lea     ($0098,A4),A0
02:0003C87A 11802000        	  7186:     move.b  D0,(A0,D2.W)
                            	  7187: _anon_z04_89:
02:0003C87E 0A3C0001        	  7188:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C882 4E75            	  7189:     rts
