                            	  4029: __far_z_04_0035:
                            	  4030:     ; Animate.
                            	  4031:     ;
                            	  4032:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  4033:     ; then only go draw.
                            	  4034:     ;
02:0003B164 41EC03D0        	  4035:     lea     ($03D0,A4),A0
02:0003B168 53302000        	  4036:     subq.b  #1,(A0,D2.W)
02:0003B16C 6702            	  4037:     beq.s  __far_z_04_0036
02:0003B16E 601E            	  4038:     jmp  DrawArmosAndCheckCollisions
                            	  4039: __far_z_04_0036:
                            	  4040:     ; Armos animation frames last 6 screen frames.
                            	  4041:     ;
02:0003B170 7006            	  4042:     moveq   #6,D0
02:0003B172 41EC03D0        	  4043:     lea     ($03D0,A4),A0
02:0003B176 11802000        	  4044:     move.b  D0,(A0,D2.W)
                            	  4045:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4046:     ; change the position of the shield. To keep fixed it in place,
                            	  4047:     ; there are separate frame images for each animation frame.
                            	  4048:     ;
                            	  4049:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4050:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4051:     ;
                            	  4052:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4053:     ; Then choose the direction at the point of drawing below.
                            	  4054:     ;
02:0003B17A 41EC03E4        	  4055:     lea     ($03E4,A4),A0
02:0003B17E 10302000        	  4056:     move.b  (A0,D2.W),D0
02:0003B182 0A000002        	  4057:     eori.b #$02,D0
02:0003B186 41EC03E4        	  4058:     lea     ($03E4,A4),A0
02:0003B18A 11802000        	  4059:     move.b  D0,(A0,D2.W)
                            	  4060:     even
                            	  4061: DrawArmosAndCheckCollisions:
02:0003B18E 4EB90004D2EC    	  4062:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B194 7600            	  4063:     moveq   #0,D3
02:0003B196 41EC0098        	  4064:     lea     ($0098,A4),A0
02:0003B19A 16302000        	  4065:     move.b  (A0,D2.W),D3
                            	  4066:     ; If facing up, then use the second frame image in the set ("back").
                            	  4067:     ; Else use the second.
                            	  4068:     ;
02:0003B19E 0C030008        	  4069:     cmpi.b  #$08,D3
02:0003B1A2 6602            	  4070:     bne  _anon_z04_54
02:0003B1A4 7001            	  4071:     moveq   #1,D0
                            	  4072: _anon_z04_54:
02:0003B1A6 023C00EE        	  4073:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B1AA 41EC03E4        	  4074:     lea     ($03E4,A4),A0
02:0003B1AE 12302000        	  4075:     move.b  (A0,D2.W),D1
02:0003B1B2 D101            	  4076:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B1B4 4EB90003157E    	  4077:     jsr     DrawObjectNotMirrored
