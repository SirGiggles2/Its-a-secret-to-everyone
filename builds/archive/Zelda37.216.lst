02:0003A480 6706            	  2147:     beq  _anon_z04_32
02:0003A482 7055            	  2148:     moveq   #85,D0
02:0003A484 6100F780        	  2149:     jsr     ShootFireball
                            	  2150: _anon_z04_32:
