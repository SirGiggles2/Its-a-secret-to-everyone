                            	 11214: __far_z_04_0105:
                            	 11215: ; Description:
                            	 11216: ; This block applies to heads and the bottom segment of a neck.
                            	 11217: ; These are drawn with sprites that come first in order, so that
                            	 11218: ; they are drawn above all other sprites, including Link.
                            	 11219: ;
                            	 11220: ; Params:
                            	 11221: ; A: tile number
                            	 11222: ;
                            	 11223: ; Normal sprite with level palette row
                            	 11224:     even
                            	 11225: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E64E 7603            	 11226:     moveq   #3,D3
02:0003E650 19430003        	 11227:     move.b  D3,($0003,A4)
02:0003E654 1B00            	 11228:     move.b  D0,-(A5)  ; PHA
                            	 11229:     ; To calculate the base offset of the sprite record:
                            	 11230:     ; offset := neck index * 8
                            	 11231:     ;
                            	 11232:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11233:     ; at an even index.
                            	 11234:     ;
02:0003E656 102C04D7        	 11235:     move.b  ($04D7,A4),D0
02:0003E65A E308            	 11236:     lsl.b  #1,D0   ; ASL A
02:0003E65C E308            	 11237:     lsl.b  #1,D0   ; ASL A
02:0003E65E E308            	 11238:     lsl.b  #1,D0   ; ASL A
                            	 11239:     ; But if the segment is not a head (not at object slot 5), then
                            	 11240:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11241:     ;
02:0003E660 0C020005        	 11242:     cmpi.b  #$05,D2
02:0003E664 670A            	 11243:     beq  _anon_z04_139
02:0003E666 023C00EE        	 11244:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E66A 123C0020        	 11245:     move.b  #$20,D1
02:0003E66E D101            	 11246:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
