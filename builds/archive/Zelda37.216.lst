02:00043BB4 6708            	  6304:     beq  _anon_z05_122
02:00043BB6 7008            	  6305:     moveq   #8,D0
02:00043BB8 19400027        	  6306:     move.b  D0,($0027,A4)
02:00043BBC 4E75            	  6307:     rts
