                            	  7234: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  7235:     ; To animate the state, the animation counter had to have
                            	  7236:     ; reached 0. Right after this routine, the counter will be
                            	  7237:     ; rolled over, and the movement frame will be switched.
                            	  7238:     ;
                            	  7239:     ; So, set movement frame to 1 (legs together) at the end of
                            	  7240:     ; the animation here, in order to immediately change it to
                            	  7241:     ; 0 (legs apart) after this.
                            	  7242:     ;
02:0004D334 7001            	  7243:     moveq   #1,D0
02:0004D336 194003E4        	  7244:     move.b  D0,($03E4,A4)
02:0004D33A 4E75            	  7245:     rts
