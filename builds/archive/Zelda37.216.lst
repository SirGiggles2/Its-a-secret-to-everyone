                            	  5238:     ; to make a fire. In this case, all that's left to do is to go
                            	  5239:     ; deactivate the shot object.
                            	  5240:     ;
02:0004C588 41EC00AC        	  5241:     lea     ($00AC,A4),A0
02:0004C58C 10302000        	  5242:     move.b  (A0,D2.W),D0
02:0004C590 0C000021        	  5243:     cmpi.b  #$21,D0
02:0004C594 6702            	  5244:     beq.s  __far_z_07_0080
02:0004C596 6038            	  5245:     jmp  DeactivateLinkShot
