                            	  7575: ChangePlayMapSquareOW:
02:00044744 1002            	  7576:     move.b  D2,D0
02:00044746 1B00            	  7577:     move.b  D0,-(A5)  ; PHA
                            	  7578:     ; We're dealing with squares.
                            	  7579:     ; So, align the object's X coordinate with 16 pixels.
                            	  7580:     ;
02:00044748 10342070        	  7581:     move.b  ($70,A4,D2.W),D0
02:0004474C 020000F0        	  7582:     andi.b #$F0,D0
                            	  7583:     ; Divide it by 4 to get the offset of the address of the column
                            	  7584:     ; in play area map.
                            	  7585:     ;
                            	  7586:     ; The calculation is: address offset = (X / 8) * 2
                            	  7587:     ; 8 for the width of the column; 2 for the width of the address
                            	  7588:     ;
02:00044750 E208            	  7589:     lsr.b  #1,D0   ; LSR A
02:00044752 E208            	  7590:     lsr.b  #1,D0   ; LSR A
02:00044754 7400            	  7591:     moveq   #0,D2
02:00044756 1400            	  7592:     move.b  D0,D2
                            	  7593:     ; Store the address of the column in [00:01].
                            	  7594:     ;
02:00044758 41F90004A998    	  7595:     lea     (PlayAreaColumnAddrs).l,A0
02:0004475E 10302000        	  7596:     move.b  (A0,D2.W),D0
02:00044762 1880            	  7597:     move.b  D0,($0000,A4)
02:00044764 41F90004A999    	  7598:     lea     (PlayAreaColumnAddrs+1).l,A0
02:0004476A 10302000        	  7599:     move.b  (A0,D2.W),D0
02:0004476E 19400001        	  7600:     move.b  D0,($0001,A4)
02:00044772 101D            	  7601:     move.b  (A5)+,D0  ; PLA
02:00044774 1B00            	  7602:     move.b  D0,-(A5)  ; PHA
02:00044776 7400            	  7603:     moveq   #0,D2
02:00044778 1400            	  7604:     move.b  D0,D2
                            	  7605:     ; Align the object's Y coordinate with 16 pixels.
                            	  7606:     ;
02:0004477A 41EC0084        	  7607:     lea     ($0084,A4),A0
02:0004477E 10302000        	  7608:     move.b  (A0,D2.W),D0
02:00044782 020000F0        	  7609:     andi.b #$F0,D0
                            	  7610:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7611:     ; the height of each row.
                            	  7612:     ;
02:00044786 003C0011        	  7613:     ori     #$11,CCR  ; SEC: set C+X
02:0004478A 123C0040        	  7614:     move.b  #$40,D1
02:0004478E 0A3C0010        	  7615:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044792 9101            	  7616:     subx.b  D1,D0   ; SBC #$40
02:00044794 0A3C0010        	  7617:     eori    #$10,CCR  ; restore X = 6502 C
02:00044798 E208            	  7618:     lsr.b  #1,D0   ; LSR A
02:0004479A E208            	  7619:     lsr.b  #1,D0   ; LSR A
02:0004479C E208            	  7620:     lsr.b  #1,D0   ; LSR A
                            	  7621:     ; Add this row offset to the column address.
                            	  7622:     ;
02:0004479E 4EB900030E0A    	  7623:     jsr     AddToInt16At0
                            	  7624:     ; Assume that we'll write a type 1 square with primary square
                            	  7625:     ; taken from [05]. If so, the square index doesn't matter
                            	  7626:     ; as long as >= $10. See WriteSquareOW.
                            	  7627:     ;
02:000447A4 7600            	  7628:     moveq   #0,D3
02:000447A6 7410            	  7629:     moveq   #16,D2
02:000447A8 102C0005        	  7630:     move.b  ($0005,A4),D0
                            	  7631:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7632:     ; So, we have to look up the square index corresponding
                            	  7633:     ; to primary square/tile in [05].
                            	  7634:     ;
                            	  7635:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7636:     ; then the X register will have the square index value.
                            	  7637:     ;
02:000447AC 0C000027        	  7638:     cmpi.b  #$27,D0
02:000447B0 6506            	  7639:     bcs  _anon_z05_148
02:000447B2 0C0000F3        	  7640:     cmpi.b  #$F3,D0
02:000447B6 6514            	  7641:     bcs  _L_z05_ChangePlayMapSquareOW_Write
