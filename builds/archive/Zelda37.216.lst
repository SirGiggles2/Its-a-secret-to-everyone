02:00033452 E14C            	   528:     lsl.w   #8,D4
02:00033454 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033456 48C4            	   530:     ext.l   D4
02:00033458 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003345E 2044            	   532:     movea.l D4,A0
