02:0003A40E 7400            	  2091:     moveq   #0,D2
02:0003A410 4EB90004D2EC    	  2092:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2093:     ; Switch to the new fireball's object slot.
                            	  2094:     ;
