02:000363CC 41EC0302        	  4903:     lea     ($0302,A4),A0
02:000363D0 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:000363D4 5303            	  4905:     subq.b  #1,D3
02:000363D6 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:000363D8 7600            	  4910:     moveq   #0,D3
02:000363DA 162C0413        	  4911:     move.b  ($0413,A4),D3
02:000363DE 41F900036378    	  4912:     lea     (PeaceText).l,A0
02:000363E4 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000363E8 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:000363EC 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000363EE 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
02:000363F2 0C000024        	  4920:     cmpi.b  #$24,D0
02:000363F6 6706            	  4921:     beq  _anon_z02_36
02:000363F8 7010            	  4922:     moveq   #16,D0
02:000363FA 19400604        	  4923:     move.b  D0,($0604,A4)
