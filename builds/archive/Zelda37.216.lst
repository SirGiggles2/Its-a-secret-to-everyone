                            	  6956: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6957:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6958:     ;   full heart=4 partial heart=$70
                            	  6959:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6960:     ; But the method here yields $3EF, because partial heart is
                            	  6961:     ; considered full when = $FF instead of $100.
                            	  6962:     ;
02:00031C38 102C000E        	  6963:     move.b  ($000E,A4),D0
02:00031C3C 003C0011        	  6964:     ori     #$11,CCR  ; SEC: set C+X
02:00031C40 122C0670        	  6965:     move.b  ($0670,A4),D1
02:00031C44 0A3C0010        	  6966:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031C48 9101            	  6967:     subx.b  D1,D0   ; SBC HeartPartial
02:00031C4A 0A3C0010        	  6968:     eori    #$10,CCR  ; restore X = 6502 C
02:00031C4E 1940000E        	  6969:     move.b  D0,($000E,A4)
02:00031C52 102C066F        	  6970:     move.b  ($066F,A4),D0
02:00031C56 0200000F        	  6971:     andi.b #$0F,D0
02:00031C5A 6710            	  6972:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031C5C 532C066F        	  6973:     subq.b  #1,($066F,A4)
02:00031C60 103C00FF        	  6974:     move.b  #$FF,D0
02:00031C64 19400670        	  6975:     move.b  D0,($0670,A4)
02:00031C68 6600FF6E        	  6976:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6977:     even
                            	  6978: _L_z01_Link_BeHarmed_HandleDied:
                            	  6979:     ; Link died.
                            	  6980:     ;
                            	  6981:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6982:     ; Make Link face down.
                            	  6983:     ; Go to mode $11.
                            	  6984:     ;
02:00031C6C 102C066F        	  6985:     move.b  ($066F,A4),D0
02:00031C70 020000F0        	  6986:     andi.b #$F0,D0
02:00031C74 1940066F        	  6987:     move.b  D0,($066F,A4)
02:00031C78 4EB90004B696    	  6988:     jsr     EndGameMode
02:00031C7E 19400670        	  6989:     move.b  D0,($0670,A4)
02:00031C82 194000AC        	  6990:     move.b  D0,($00AC,A4)
02:00031C86 7011            	  6991:     moveq   #17,D0
02:00031C88 19400012        	  6992:     move.b  D0,($0012,A4)
