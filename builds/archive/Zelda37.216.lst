02:00043B9E 11802000        	  6290:     move.b  D0,(A0,D2.W)
02:00043BA2 1002            	  6291:     move.b  D2,D0
02:00043BA4 19400301        	  6292:     move.b  D0,($0301,A4)
                            	  6293:     ; Increment the command.
                            	  6294:     ;
02:00043BA8 522C0054        	  6295:     addq.b  #1,($0054,A4)
                            	  6296:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6297:     ; and resetting the door command.
                            	  6298:     ; This ends up catching original states 3 and 7.
                            	  6299:     ;
                            	  6300:     ; Else set door timer to 8 and return.
                            	  6301:     ;
02:00043BAC 102C0054        	  6302:     move.b  ($0054,A4),D0
