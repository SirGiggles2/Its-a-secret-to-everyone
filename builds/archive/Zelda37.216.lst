02:0004C5F4 1940000F        	  5294:     move.b  D0,($000F,A4)
                            	  5295:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5296:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5297:     ;
02:0004C5F8 7603            	  5298:     moveq   #3,D3
                            	  5299:     even
                            	  5300: _L_z07_SpreadShot_DrawShotCorner:
02:0004C5FA 1003            	  5301:     move.b  D3,D0
02:0004C5FC 1B00            	  5302:     move.b  D0,-(A5)  ; PHA
                            	  5303:     ; Save offset X [02] and Y offset [03].
                            	  5304:     ;
02:0004C5FE 102C0002        	  5305:     move.b  ($0002,A4),D0
02:0004C602 1B00            	  5306:     move.b  D0,-(A5)  ; PHA
02:0004C604 102C0003        	  5307:     move.b  ($0003,A4),D0
02:0004C608 1B00            	  5308:     move.b  D0,-(A5)  ; PHA
                            	  5309:     ; Calculate and set sprite attributes for this corner:
                            	  5310:     ;   base attribute OR (frame counter AND 3)
                            	  5311:     ;
                            	  5312:     ; The base attribute defines how to flip the sprite.
                            	  5313:     ; The frame counter makes the shot flash by cycling each
                            	  5314:     ; palette row.
                            	  5315:     ;
02:0004C60A 102C0015        	  5316:     move.b  ($0015,A4),D0
02:0004C60E 02000003        	  5317:     andi.b #$03,D0
02:0004C612 41F90004C470    	  5318:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C618 12303000        	  5319:     move.b  (A0,D3.W),D1
02:0004C61C 8001            	  5320:     or.b  D1,D0
02:0004C61E 4EB900031870    	  5321:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5322:     ; Add the object's X (the center of the spread) and the
                            	  5323:     ; current offset in [02] to set sprite X in [00].
                            	  5324:     ;
02:0004C624 10342070        	  5325:     move.b  ($70,A4,D2.W),D0
02:0004C628 023C00EE        	  5326:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C62C 122C0002        	  5327:     move.b  ($0002,A4),D1
02:0004C630 D101            	  5328:     addx.b  D1,D0   ; ADC $02
02:0004C632 1880            	  5329:     move.b  D0,($0000,A4)
                            	  5330:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5331:     ; Else calculate the distance from object X to sprite X.
                            	  5332:     ;
02:0004C634 12342070        	  5333:     move.b  ($70,A4,D2.W),D1
02:0004C638 B001            	  5334:     cmp.b   D1,D0
02:0004C63A 651A            	  5335:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C63C 0C0000FC        	  5336:     cmpi.b  #$FC,D0
02:0004C640 6466            	  5337:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C642 003C0011        	  5338:     ori     #$11,CCR  ; SEC: set C+X
02:0004C646 12342070        	  5339:     move.b  ($70,A4,D2.W),D1
02:0004C64A 0A3C0010        	  5340:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C64E 9101            	  5341:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C650 0A3C0010        	  5342:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C654 6014            	  5343:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5344: 
                            	  5345:     even
                            	  5346: _L_z07_SpreadShot_ReverseSub:
