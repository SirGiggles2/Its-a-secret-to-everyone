02:0003B2DC 102C0085        	  4276:     move.b  ($0085,A4),D0
02:0003B2E0 003C0011        	  4277:     ori     #$11,CCR  ; SEC: set C+X
02:0003B2E4 123C001C        	  4278:     move.b  #$1C,D1
02:0003B2E8 0A3C0010        	  4279:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B2EC 9101            	  4280:     subx.b  D1,D0   ; SBC #$1C
02:0003B2EE 0A3C0010        	  4281:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B2F2 41EC0084        	  4282:     lea     ($0084,A4),A0
02:0003B2F6 11802000        	  4283:     move.b  D0,(A0,D2.W)
                            	  4284:     even
