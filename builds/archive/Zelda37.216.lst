02:0003346E 1003            	   537:     move.b  D3,D0
02:00033470 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00033472 19430016        	   539:     move.b  D3,($0016,A4)
02:00033476 6100D10E        	   540:     jsr     FetchFileAAddressSet
