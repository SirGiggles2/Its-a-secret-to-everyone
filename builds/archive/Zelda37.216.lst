02:0004C6C8 4600            	  5413:     eori.b #$FF,D0
02:0004C6CA 023C00EE        	  5414:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6CE 123C0001        	  5415:     move.b  #$01,D1
02:0004C6D2 D101            	  5416:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C6D4 19803000        	  5417:     move.b  D0,($00,A4,D3.W)
                            	  5418:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5419:     ;
02:0004C6D8 101D            	  5420:     move.b  (A5)+,D0  ; PLA
02:0004C6DA 7600            	  5421:     moveq   #0,D3
02:0004C6DC 1600            	  5422:     move.b  D0,D3
02:0004C6DE 5303            	  5423:     subq.b  #1,D3
