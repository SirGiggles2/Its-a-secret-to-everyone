                            	  6376: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6377:     ; The weapon is the sword.
                            	  6378:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6379:     ;
02:0004CD9E 023C00EE        	  6380:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CDA2 122C0657        	  6381:     move.b  ($0657,A4),D1
02:0004CDA6 D101            	  6382:     addx.b  D1,D0   ; ADC Items
02:0004CDA8 003C0011        	  6383:     ori     #$11,CCR  ; SEC: set C+X
02:0004CDAC 123C0001        	  6384:     move.b  #$01,D1
02:0004CDB0 0A3C0010        	  6385:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CDB4 9101            	  6386:     subx.b  D1,D0   ; SBC #$01
02:0004CDB6 0A3C0010        	  6387:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6388:     even
