                            	  4591: 
                            	  4592: ; Params:
                            	  4593: ; Y: middle speed index (4)
                            	  4594: ; [03]: horizontal distance
                            	  4595: ; [04]: vertical distance
                            	  4596: ; [0A]: vertical direction
                            	  4597: ; [0B]: horizontal direction
                            	  4598: ;
                            	  4599: ; Returns:
                            	  4600: ; Y: speed index (0 to 8) for the angle
                            	  4601: ;
                            	  4602: ;
                            	  4603: ; TODO: call it speed index or angle?
                            	  4604: ; Store the middle speed index in [00]. It will be changed to the
                            	  4605: ; right speed index to use incrementally.
                            	  4606: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4607: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4608: ;
                            	  4609:     even
                            	  4610: _CalcDiagonalSpeedIndex:
02:00030A5A 1883            	  4611:     move.b  D3,($0000,A4)
                            	  4612:     ; Assuming horizontal distance >= vertical distance, the
                            	  4613:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4614:     ;
02:00030A5C 103C00FF        	  4615:     move.b  #$FF,D0
02:00030A60 19400001        	  4616:     move.b  D0,($0001,A4)
                            	  4617:     ; TODO:
                            	  4618:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4619:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4620:     ;
                            	  4621:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4622:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4623:     ; of the farther distance faster.
                            	  4624:     ;
02:00030A64 102C0003        	  4625:     move.b  ($0003,A4),D0
02:00030A68 122C0004        	  4626:     move.b  ($0004,A4),D1
02:00030A6C B001            	  4627:     cmp.b   D1,D0
02:00030A6E 6416            	  4628:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030A70 1B00            	  4629:     move.b  D0,-(A5)  ; PHA
02:00030A72 102C0004        	  4630:     move.b  ($0004,A4),D0
02:00030A76 19400003        	  4631:     move.b  D0,($0003,A4)
02:00030A7A 101D            	  4632:     move.b  (A5)+,D0  ; PLA
02:00030A7C 19400004        	  4633:     move.b  D0,($0004,A4)
02:00030A80 7001            	  4634:     moveq   #1,D0
02:00030A82 19400001        	  4635:     move.b  D0,($0001,A4)
                            	  4636:     even
                            	  4637: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4638:     ; TODO: call it speed index or angle?
                            	  4639:     ; If the difference in distances is within 8 pixels,
                            	  4640:     ; return the speed index (angle) we have.
                            	  4641:     ;
02:00030A86 102C0003        	  4642:     move.b  ($0003,A4),D0
02:00030A8A 003C0011        	  4643:     ori     #$11,CCR  ; SEC: set C+X
02:00030A8E 122C0004        	  4644:     move.b  ($0004,A4),D1
02:00030A92 0A3C0010        	  4645:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030A96 9101            	  4646:     subx.b  D1,D0   ; SBC $04
02:00030A98 0A3C0010        	  4647:     eori    #$10,CCR  ; restore X = 6502 C
02:00030A9C 0C000008        	  4648:     cmpi.b  #$08,D0
02:00030AA0 6538            	  4649:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4650:     even
                            	  4651: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4652:     ; TODO: call it speed index or angle?
                            	  4653:     ; Otherwise, go to the next speed index (angle).
                            	  4654:     ;
02:00030AA2 1014            	  4655:     move.b  ($0000,A4),D0
02:00030AA4 023C00EE        	  4656:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030AA8 122C0001        	  4657:     move.b  ($0001,A4),D1
02:00030AAC D101            	  4658:     addx.b  D1,D0   ; ADC $01
02:00030AAE 1880            	  4659:     move.b  D0,($0000,A4)
                            	  4660:     ; TODO: call it speed index or angle?
                            	  4661:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4662:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4663:     ;
02:00030AB0 6728            	  4664:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030AB2 0C000008        	  4665:     cmpi.b  #$08,D0
02:00030AB6 6722            	  4666:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4667:     ; Subtract the lesser distance from the greater distance.
                            	  4668:     ; If they still haven't crossed, then we can turn more.
                            	  4669:     ;
02:00030AB8 102C0003        	  4670:     move.b  ($0003,A4),D0
02:00030ABC 003C0011        	  4671:     ori     #$11,CCR  ; SEC: set C+X
02:00030AC0 122C0004        	  4672:     move.b  ($0004,A4),D1
02:00030AC4 0A3C0010        	  4673:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030AC8 9101            	  4674:     subx.b  D1,D0   ; SBC $04
02:00030ACA 0A3C0010        	  4675:     eori    #$10,CCR  ; restore X = 6502 C
02:00030ACE 19400003        	  4676:     move.b  D0,($0003,A4)
02:00030AD2 122C0004        	  4677:     move.b  ($0004,A4),D1
02:00030AD6 B001            	  4678:     cmp.b   D1,D0
02:00030AD8 64C8            	  4679:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4680:     even
