02:0002DEFA 41EC0308        	   666:     lea     ($0308,A4),A0
02:0002DEFE 11803000        	   667:     move.b  D0,(A0,D3.W)
02:0002DF02 102C0001        	   668:     move.b  ($0001,A4),D0
02:0002DF06 6148            	   669:     jsr     SwapSpaceAndSign
