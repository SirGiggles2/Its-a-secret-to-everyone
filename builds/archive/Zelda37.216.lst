                            	   775: UpdateBlock0Idle:
                            	   776:     ; If there are monsters in the room, go reset the push timer and return.
                            	   777:     ;
02:00039A9A 102C034D        	   778:     move.b  ($034D,A4),D0
02:00039A9E 6604            	   779:     bne.s  __far_z_04_0005
02:00039AA0 600000DA        	   780:     jmp  ResetPushTimer
                            	   781: __far_z_04_0005:
                            	   782:     ; If Link's X is aligned with the block's, then get the difference
                            	   783:     ; between Link's (Y + 3) and the block's Y.
                            	   784:     ; Then go test the difference.
                            	   785:     ;
02:00039AA4 102C0070        	   786:     move.b  ($0070,A4),D0
02:00039AA8 12342070        	   787:     move.b  ($70,A4,D2.W),D1
02:00039AAC B001            	   788:     cmp.b   D1,D0
02:00039AAE 6628            	   789:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039AB0 7600            	   790:     moveq   #0,D3
02:00039AB2 102C0084        	   791:     move.b  ($0084,A4),D0
02:00039AB6 023C00EE        	   792:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039ABA 123C0003        	   793:     move.b  #$03,D1
02:00039ABE D101            	   794:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039AC0 003C0011        	   795:     ori     #$11,CCR  ; SEC: set C+X
02:00039AC4 41EC0084        	   796:     lea     ($0084,A4),A0
02:00039AC8 12302000        	   797:     move.b  (A0,D2.W),D1
02:00039ACC 0A3C0010        	   798:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039AD0 9101            	   799:     subx.b  D1,D0   ; SBC ObjY,X
02:00039AD2 0A3C0010        	   800:     eori    #$10,CCR  ; restore X = 6502 C
02:00039AD6 6036            	   801:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   802: 
                            	   803:     even
                            	   804: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   805:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   806:     ; go reset the push timer.
                            	   807:     ;
02:00039AD8 102C0084        	   808:     move.b  ($0084,A4),D0
02:00039ADC 023C00EE        	   809:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039AE0 123C0003        	   810:     move.b  #$03,D1
02:00039AE4 D101            	   811:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039AE6 41EC0084        	   812:     lea     ($0084,A4),A0
02:00039AEA 12302000        	   813:     move.b  (A0,D2.W),D1
02:00039AEE B001            	   814:     cmp.b   D1,D0
02:00039AF0 6704            	   815:     beq.s  __far_z_04_0006
02:00039AF2 60000088        	   816:     jmp  ResetPushTimer
                            	   817: __far_z_04_0006:
                            	   818:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   819:     ; Get the difference in X.
                            	   820:     ;
02:00039AF6 7602            	   821:     moveq   #2,D3
02:00039AF8 102C0070        	   822:     move.b  ($0070,A4),D0
02:00039AFC 003C0011        	   823:     ori     #$11,CCR  ; SEC: set C+X
02:00039B00 12342070        	   824:     move.b  ($70,A4,D2.W),D1
02:00039B04 0A3C0010        	   825:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039B08 9101            	   826:     subx.b  D1,D0   ; SBC ObjX,X
02:00039B0A 0A3C0010        	   827:     eori    #$10,CCR  ; restore X = 6502 C
                            	   828:     even
                            	   829: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   830:     ; If the difference in coordinates is negative, then Link is
                            	   831:     ; up or left of the block.
                            	   832:     ;
                            	   833:     ; In that case, increase Y register to index the correct opposite
                            	   834:     ; direction below. Also, negate the difference, so we test
                            	   835:     ; positive values.
                            	   836:     ;
02:00039B0E 6A08            	   837:     bpl  _anon_z04_14
02:00039B10 5203            	   838:     addq.b  #1,D3
02:00039B12 4EB9000309BC    	   839:     jsr     Negate
                            	   840: _anon_z04_14:
                            	   841:     ; If the distance >= $11, then go reset the push timer and return.
                            	   842:     ;
02:00039B18 0C000011        	   843:     cmpi.b  #$11,D0
02:00039B1C 6502            	   844:     bcs.s  __far_z_04_0007
02:00039B1E 605C            	   845:     jmp  ResetPushTimer
                            	   846: __far_z_04_0007:
                            	   847:     ; At this point, Link is aligned with the block.
                            	   848:     ;
                            	   849:     ; If the input direction is not the required direction based on
                            	   850:     ; Link's placement; then go reset the push timer and return.
                            	   851:     ;
02:00039B20 102C03F8        	   852:     move.b  ($03F8,A4),D0
02:00039B24 41F900039A78    	   853:     lea     (BlockPushDirections).l,A0
02:00039B2A 12303000        	   854:     move.b  (A0,D3.W),D1
02:00039B2E B001            	   855:     cmp.b   D1,D0
02:00039B30 6702            	   856:     beq.s  __far_z_04_0008
02:00039B32 6048            	   857:     jmp  ResetPushTimer
                            	   858: __far_z_04_0008:
                            	   859:     ; Link is truly pushing the block.
                            	   860:     ;
                            	   861:     ; Increase the push timer.
                            	   862:     ;
02:00039B34 41EC0412        	   863:     lea     ($0412,A4),A0
02:00039B38 52302000        	   864:     addq.b  #1,(A0,D2.W)
                            	   865:     ; If the push timer still < $10, return.
                            	   866:     ;
02:00039B3C 7600            	   867:     moveq   #0,D3
02:00039B3E 41EC0412        	   868:     lea     ($0412,A4),A0
02:00039B42 16302000        	   869:     move.b  (A0,D2.W),D3
02:00039B46 0C030010        	   870:     cmpi.b  #$10,D3
02:00039B4A 6402            	   871:     bcc.s  __far_z_04_0009
02:00039B4C 6034            	   872:     jmp  L10262_Exit
