                            	  2874: _anon_z04_37:
02:0003A91A 61000196        	  2875:     jsr     Jumper_PointBoulderDownward
                            	  2876:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2877:     ;
02:0003A91E 7000            	  2878:     moveq   #0,D0
02:0003A920 41EC0451        	  2879:     lea     ($0451,A4),A0
02:0003A924 11802000        	  2880:     move.b  D0,(A0,D2.W)
                            	  2881:     ; Get the base offset for the kind of jumper the object is.
                            	  2882:     ;
02:0003A928 6100015E        	  2883:     jsr     Jumper_GetKind
02:0003A92C 41F90003A818    	  2884:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A932 10303000        	  2885:     move.b  (A0,D3.W),D0
                            	  2886:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2887:     ;
                            	  2888:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2889:     ; does not have $B elements like the tektites' sets.
                            	  2890:     ;
                            	  2891:     ; Boulder does not need the upward accelerations.
                            	  2892:     ; So, the elements for those are used for the starting speeds
                            	  2893:     ; at 04:88F2.
                            	  2894:     ;
02:0003A936 023C00EE        	  2895:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A93A 41EC0098        	  2896:     lea     ($0098,A4),A0
02:0003A93E 12302000        	  2897:     move.b  (A0,D2.W),D1
02:0003A942 D101            	  2898:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A944 7600            	  2899:     moveq   #0,D3
02:0003A946 1600            	  2900:     move.b  D0,D3
02:0003A948 41F90003A7F6    	  2901:     lea     (JumperYAccelerations).l,A0
02:0003A94E 10303000        	  2902:     move.b  (A0,D3.W),D0
02:0003A952 7602            	  2903:     moveq   #2,D3
02:0003A954 61000162        	  2904:     jsr     Jumper_MoveY
                            	  2905:     ; If the facing direction has a left component, then
                            	  2906:     ; subtract 1 from the object's X.
                            	  2907:     ;
                            	  2908:     ; Else add 1.
                            	  2909:     ;
