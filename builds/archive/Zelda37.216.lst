02:00034BE4 5303            	  2570:     subq.b  #1,D3
02:00034BE6 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034BE8 522C0420        	  2572:     addq.b  #1,($0420,A4)
                            	  2573:     even
                            	  2574: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2575:     ; At this point:
                            	  2576:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2577:     ;   - This will be changed as the player inputs characters.
                            	  2578:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2579:     ;   - This will be changed as the player inputs characters.
                            	  2580:     ; - InitializedNameField [$0420] is set to 1.
                            	  2581:     ;
02:00034BEC 102C00F8        	  2582:     move.b  ($00F8,A4),D0
02:00034BF0 020000C0        	  2583:     andi.b #$C0,D0
02:00034BF4 670000E8        	  2584:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2585:     ; A or B was pressed.
                            	  2586:     ;
02:00034BF8 0C000040        	  2587:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034BFC 660000A6        	  2588:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2589:     ; A was pressed.
                            	  2590:     ;
