                            	 10045: Manhandla_Draw:
02:0003DD80 4EB90004D2EC    	 10046:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 10047:     ; Push the "frame image and sprite attributes" value.
                            	 10048:     ;
02:0003DD86 41EC0478        	 10049:     lea     ($0478,A4),A0
02:0003DD8A 10302000        	 10050:     move.b  (A0,D2.W),D0
02:0003DD8E 1B00            	 10051:     move.b  D0,-(A5)  ; PHA
                            	 10052:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	 10053:     ; passed along as is.
                            	 10054:     ;
02:0003DD90 02000080        	 10055:     andi.b #$80,D0
02:0003DD94 00000001        	 10056:     ori.b #$01,D0
02:0003DD98 4EB900031870    	 10057:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DD9E 101D            	 10058:     move.b  (A5)+,D0  ; PLA
02:0003DDA0 1B00            	 10059:     move.b  D0,-(A5)  ; PHA
                            	 10060:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	 10061:     ;
02:0003DDA2 02000040        	 10062:     andi.b #$40,D0
02:0003DDA6 6704            	 10063:     beq  _anon_z04_116
02:0003DDA8 522C000F        	 10064:     addq.b  #1,($000F,A4)
                            	 10065: _anon_z04_116:
02:0003DDAC 101D            	 10066:     move.b  (A5)+,D0  ; PLA
                            	 10067:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	 10068:     ; These are the 2 frame images of the horizontal hands.
                            	 10069:     ;
                            	 10070:     ; Else draw the base and vertical hands mirrored.
                            	 10071:     ;
02:0003DDAE 0200000F        	 10072:     andi.b #$0F,D0
02:0003DDB2 0C000002        	 10073:     cmpi.b  #$02,D0
02:0003DDB6 670C            	 10074:     beq  _anon_z04_117
02:0003DDB8 0C000003        	 10075:     cmpi.b  #$03,D0
02:0003DDBC 6706            	 10076:     beq  _anon_z04_117
02:0003DDBE 4EF90003157A    	 10077:     jmp     DrawObjectMirrored
                            	 10078: 
