02:0003F13E 41F90003F030    	 12713:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F144 10303000        	 12714:     move.b  (A0,D3.W),D0
02:0003F148 1B00            	 12715:     move.b  D0,-(A5)  ; PHA
02:0003F14A 41F90003F034    	 12716:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F150 10303000        	 12717:     move.b  (A0,D3.W),D0
