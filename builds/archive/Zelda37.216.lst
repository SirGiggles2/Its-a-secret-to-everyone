02:0003DDC4 4EF90003157E    	 10080:     jmp     DrawObjectNotMirrored
                            	 10081: 
                            	 10082:     even
                            	 10083: UpdateGohma:
                            	 10084:     ; If flagged not to continue straight, then choose a random facing direction.
                            	 10085:     ;
02:0003DDCA 41EC0451        	 10086:     lea     ($0451,A4),A0
02:0003DDCE 10302000        	 10087:     move.b  (A0,D2.W),D0
02:0003DDD2 662C            	 10088:     bne  _L_z04_UpdateGohma_Move
                            	 10089:     ; If Random:
                            	 10090:     ;   >= $B0: right
                            	 10091:     ;   >= $60: left
                            	 10092:     ;   Else:   down
                            	 10093:     ;
02:0003DDD4 7001            	 10094:     moveq   #1,D0
02:0003DDD6 7600            	 10095:     moveq   #0,D3
02:0003DDD8 16342018        	 10096:     move.b  ($18,A4,D2.W),D3
02:0003DDDC 0C0300B0        	 10097:     cmpi.b  #$B0,D3
02:0003DDE0 640A            	 10098:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDE2 E308            	 10099:     lsl.b  #1,D0   ; ASL A
02:0003DDE4 0C030060        	 10100:     cmpi.b  #$60,D3
02:0003DDE8 6402            	 10101:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDEA E308            	 10102:     lsl.b  #1,D0   ; ASL A
                            	 10103:     even
                            	 10104: _L_z04_UpdateGohma_ChangeDir:
02:0003DDEC 41EC0098        	 10105:     lea     ($0098,A4),A0
02:0003DDF0 11802000        	 10106:     move.b  D0,(A0,D2.W)
                            	 10107:     ; Now we can go straight without changing direction for some time.
                            	 10108:     ;
02:0003DDF4 41EC0451        	 10109:     lea     ($0451,A4),A0
02:0003DDF8 52302000        	 10110:     addq.b  #1,(A0,D2.W)
                            	 10111:     ; Go animate the eye.
                            	 10112:     ;
02:0003DDFC 600000C6        	 10113:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	 10114: 
                            	 10115:     even
                            	 10116: _L_z04_UpdateGohma_Move:
                            	 10117:     ; Add $80 to the movement accumulator.
                            	 10118:     ;
02:0003DE00 41EC041F        	 10119:     lea     ($041F,A4),A0
02:0003DE04 10302000        	 10120:     move.b  (A0,D2.W),D0
02:0003DE08 023C00EE        	 10121:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE0C 123C0080        	 10122:     move.b  #$80,D1
02:0003DE10 D101            	 10123:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE12 41EC041F        	 10124:     lea     ($041F,A4),A0
02:0003DE16 11802000        	 10125:     move.b  D0,(A0,D2.W)
                            	 10126:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	 10127:     ;
02:0003DE1A 640000A8        	 10128:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	 10129:     ; Increase the distance traveled, and move 1.
                            	 10130:     ;
02:0003DE1E 41EC0412        	 10131:     lea     ($0412,A4),A0
02:0003DE22 52302000        	 10132:     addq.b  #1,(A0,D2.W)
                            	 10133:     ; Set a direction mask in [02], starting with right (1).
                            	 10134:     ;
02:0003DE26 7001            	 10135:     moveq   #1,D0
02:0003DE28 19400002        	 10136:     move.b  D0,($0002,A4)
                            	 10137:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	 10138:     ;
02:0003DE2C 41EC0098        	 10139:     lea     ($0098,A4),A0
02:0003DE30 10302000        	 10140:     move.b  (A0,D2.W),D0
02:0003DE34 122C0002        	 10141:     move.b  ($0002,A4),D1
02:0003DE38 C200            	 10142:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE3A 6704            	 10143:     beq  _anon_z04_118
02:0003DE3C 52342070        	 10144:     addq.b  #1,($70,A4,D2.W)
                            	 10145: _anon_z04_118:
                            	 10146:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	 10147:     ;
02:0003DE40 122C0002        	 10148:     move.b  ($0002,A4),D1
02:0003DE44 E309            	 10149:     lsl.b  #1,D1   ; ASL $02
02:0003DE46 19410002        	 10150:     move.b  D1,($0002,A4)
02:0003DE4A 122C0002        	 10151:     move.b  ($0002,A4),D1
02:0003DE4E C200            	 10152:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE50 6704            	 10153:     beq  _anon_z04_119
02:0003DE52 53342070        	 10154:     subq.b  #1,($70,A4,D2.W)
                            	 10155: _anon_z04_119:
                            	 10156:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	 10157:     ;
02:0003DE56 122C0002        	 10158:     move.b  ($0002,A4),D1
02:0003DE5A E309            	 10159:     lsl.b  #1,D1   ; ASL $02
02:0003DE5C 19410002        	 10160:     move.b  D1,($0002,A4)
02:0003DE60 122C0002        	 10161:     move.b  ($0002,A4),D1
02:0003DE64 C200            	 10162:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE66 6708            	 10163:     beq  _anon_z04_120
