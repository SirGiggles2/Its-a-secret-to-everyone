02:0003C19E 19400340        	  8893:     move.b  D0,($0340,A4)
02:0003C1A2 0A3C0001        	  8894:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C1A6 4E75            	  8895:     rts
