                            	  3923:     even
                            	  3924: _L_z05_CheckDoorway_SearchUnderflowDoorway:
                            	  3925:     ; The player might be in the original doorway facing backwards,
                            	  3926:     ; outside it, or in the other doorway along the axis.
                            	  3927:     ;
