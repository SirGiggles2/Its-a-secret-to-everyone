02:0003A690 6452            	  5310:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5311:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5312:     ; then go change to state 1.
                            	  5313:     ;
02:0003A692 41EC041F        	  5314:     lea     ($041F,A4),A0
02:0003A696 10302000        	  5315:     move.b  (A0,D2.W),D0
02:0003A69A 020000FC        	  5316:     andi.b #$FC,D0
02:0003A69E 0C0000B0        	  5317:     cmpi.b  #$B0,D0
02:0003A6A2 6742            	  5318:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A6A4 0C0000F4        	  5319:     cmpi.b  #$F4,D0
02:0003A6A8 643C            	  5320:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5321:     ; Else blocked by something else.
                            	  5322:     ;
                            	  5323:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5324:     ;
02:0003A6AA 41EC0098        	  5325:     lea     ($0098,A4),A0
02:0003A6AE 10302000        	  5326:     move.b  (A0,D2.W),D0
02:0003A6B2 02000003        	  5327:     andi.b #$03,D0
02:0003A6B6 6618            	  5328:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5329:     ; Else facing vertically. Flip the direction.
