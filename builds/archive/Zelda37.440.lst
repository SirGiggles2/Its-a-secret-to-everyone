02:00041BC4 102C033F        	  8592:     move.b  ($033F,A4),D0
02:00041BC8 023C00EE        	  8593:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BCC 123C00E2        	  8594:     move.b  #$E2,D1
02:00041BD0 D101            	  8595:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00041BD2 41EC0304        	  8596:     lea     ($0304,A4),A0
02:00041BD6 11803000        	  8597:     move.b  D0,(A0,D3.W)
02:00041BDA 4E75            	  8598:     rts
