02:0003C902 41EC03BC        	 10039:     lea     ($03BC,A4),A0
02:0003C906 10302000        	 10040:     move.b  (A0,D2.W),D0
02:0003C90A 7600            	 10041:     moveq   #0,D3
02:0003C90C 162C0005        	 10042:     move.b  ($0005,A4),D3
02:0003C910 61000136        	 10043:     jsr     ShiftMultiply
                            	 10044:     ; The absolute X increment for the current angle is now in [02:03].
