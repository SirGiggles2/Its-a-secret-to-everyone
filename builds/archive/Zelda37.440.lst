02:0003BF68 6606            	  8594:     bne  _L_z04_Ganon_MoveAndShoot_Exit
02:0003BF6A 7056            	  8595:     moveq   #86,D0
02:0003BF6C 6100C672        	  8596:     jsr     ShootFireball
                            	  8597:     even
