                            	  4130: __far_z_07_0050:
                            	  4131:     ; Moving direction = 0.
                            	  4132:     ; The object is not the player.
                            	  4133:     ;
                            	  4134:     ; If object does not have attribute $10, then
                            	  4135:     ; set movement direction to input direction,
                            	  4136:     ; and go try to turn to an unblocked direction in order to move.
                            	  4137:     ;
02:00048320 41EC04BF        	  4138:     lea     ($04BF,A4),A0
02:00048324 10302000        	  4139:     move.b  (A0,D2.W),D0
02:00048328 02000010        	  4140:     andi.b #$10,D0
02:0004832C 6702            	  4141:     beq.s  __far_z_07_0051
02:0004832E 600E            	  4142:     jmp  Reverse
                            	  4143: __far_z_07_0051:
02:00048330 41EC03F8        	  4144:     lea     ($03F8,A4),A0
02:00048334 10302000        	  4145:     move.b  (A0,D2.W),D0
02:00048338 1940000F        	  4146:     move.b  D0,($000F,A4)
