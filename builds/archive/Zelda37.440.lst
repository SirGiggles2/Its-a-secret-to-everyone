02:00041DB8 1002            	  8887:     move.b  D2,D0
02:00041DBA 6126            	  8888:     jsr     FindAndSelectOccupiedItemSlot
                            	  8889:     ; If the new item slot = old item slot, go cancel the
                            	  8890:     ; "selection changed" tune.
                            	  8891:     ;
                            	  8892:     ;
                            	  8893:     ; Pop selected item slot.
