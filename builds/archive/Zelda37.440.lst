                            	  3885: Moldorm_Wander:
                            	  3886:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3887:     ; Only the head controls the movement direction.
                            	  3888:     ;
02:00039C42 0C020005        	  3889:     cmpi.b  #$05,D2
02:00039C46 6708            	  3890:     beq  _anon_z04_82
02:00039C48 0C02000A        	  3891:     cmpi.b  #$0A,D2
02:00039C4C 6702            	  3892:     beq.s  __far_z_04_0028
02:00039C4E 6070            	  3893:     jmp  L1156B_Exit
                            	  3894: __far_z_04_0028:
                            	  3895: _anon_z04_82:
                            	  3896:     ; Turn randomly while flying, as usual.
                            	  3897:     ;
02:00039C50 61002C1A        	  3898:     jsr     Flyer_Wander
                            	  3899:     ; After every turn, the common flyer routines set timer to $10.
                            	  3900:     ; This can be used as a signal for moldorm to propagate
                            	  3901:     ; direction changes down the chain.
                            	  3902:     ;
                            	  3903:     ; Between each turn, timer <> $10.
                            	  3904:     ;
                            	  3905:     ; At the end of the delay after the last turn, timer = 0.
                            	  3906:     ; This is a signal that that flying state ended, and a new one
                            	  3907:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  3908:     ; we can propagate direction changes again; and start
                            	  3909:     ; a new flying interval by setting timer to $10. This will make
                            	  3910:     ; the next flying state delay that amount of time before turning
                            	  3911:     ; the first time.
                            	  3912:     ;
                            	  3913:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  3914:     ; arm the timer again, and shift directions down the chain.
                            	  3915:     ;
02:00039C54 10342028        	  3916:     move.b  ($28,A4,D2.W),D0
02:00039C58 6602            	  3917:     bne.s  __far_z_04_0029
02:00039C5A 60CE            	  3918:     jmp  Moldorm_ChangeFlyingState
                            	  3919: __far_z_04_0029:
                            	  3920:     even
                            	  3921: Moldorm_PropagateDirs:
                            	  3922:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  3923:     ;
02:00039C5C 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:00039C60 0C000010        	  3925:     cmpi.b  #$10,D0
02:00039C64 6702            	  3926:     beq.s  __far_z_04_0030
02:00039C66 6058            	  3927:     jmp  L1156B_Exit
                            	  3928: __far_z_04_0030:
                            	  3929:     ; Timer = $10.
                            	  3930:     ;
