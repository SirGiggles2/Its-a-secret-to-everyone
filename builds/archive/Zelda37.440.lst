                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A784 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A788 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A78C 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A790 123C0038        	  5434:     move.b  #$38,D1
02:0003A794 D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A796 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A79A 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A79E 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A7A2 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A7A6 123C0000        	  5442:     move.b  #$00,D1
02:0003A7AA D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A7AC 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A7B0 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A7B4 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7B8 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A7BC 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A7C0 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A7C2 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A7C6 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A7CA 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A7CE 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A7D2 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A7D6 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A7DA 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A7DE 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0003A7E2 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0003A7E6 B001            	  5465:     cmp.b   D1,D0
02:0003A7E8 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
                            	  5468:     ;
02:0003A7EC 7000            	  5469:     moveq   #0,D0
02:0003A7EE 41EC00AC        	  5470:     lea     ($00AC,A4),A0
02:0003A7F2 11802000        	  5471:     move.b  D0,(A0,D2.W)
                            	  5472:     ; Reset 16-bit vertical speed.
                            	  5473:     ;
02:0003A7F6 41EC0444        	  5474:     lea     ($0444,A4),A0
02:0003A7FA 11802000        	  5475:     move.b  D0,(A0,D2.W)
02:0003A7FE 41EC0412        	  5476:     lea     ($0412,A4),A0
02:0003A802 11802000        	  5477:     move.b  D0,(A0,D2.W)
                            	  5478:     ; Choose a random direction to face in.
                            	  5479:     ;
02:0003A806 10342018        	  5480:     move.b  ($18,A4,D2.W),D0
02:0003A80A 02000003        	  5481:     andi.b #$03,D0
02:0003A80E 7600            	  5482:     moveq   #0,D3
02:0003A810 1600            	  5483:     move.b  D0,D3
02:0003A812 41F90003A622    	  5484:     lea     (PolsVoiceDirections).l,A0
02:0003A818 10303000        	  5485:     move.b  (A0,D3.W),D0
02:0003A81C 41EC0098        	  5486:     lea     ($0098,A4),A0
02:0003A820 11802000        	  5487:     move.b  D0,(A0,D2.W)
                            	  5488:     ; Randomly set distance-to-move to $30 or $70.
                            	  5489:     ;
02:0003A824 10342018        	  5490:     move.b  ($18,A4,D2.W),D0
