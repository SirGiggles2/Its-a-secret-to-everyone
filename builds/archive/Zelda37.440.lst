02:0003A850 41EC0084        	  5512:     lea     ($0084,A4),A0
02:0003A854 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0003A858 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A85C 123C0008        	  5515:     move.b  #$08,D1
02:0003A860 D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
