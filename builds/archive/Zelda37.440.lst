02:0003C0F4 610000BE        	  8816:     jsr     Ganon_GetCurCloudTop
02:0003C0F8 61A0            	  8817:     jsr     Ganon_DrawCloud
02:0003C0FA 610000B2        	  8818:     jsr     Ganon_GetCurCloudRight
02:0003C0FE 619A            	  8819:     jsr     Ganon_DrawCloud
02:0003C100 610000A6        	  8820:     jsr     Ganon_GetCurCloudLeft
02:0003C104 610000B4        	  8821:     jsr     Ganon_GetCurCloudBottom
02:0003C108 6190            	  8822:     jsr     Ganon_DrawCloud
