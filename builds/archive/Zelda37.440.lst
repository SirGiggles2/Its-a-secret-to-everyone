02:0003A6F0 6068            	  5360:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5361: __far_z_04_0048:
                            	  5362:     ; Go to state 1.
                            	  5363:     ;
02:0003A6F2 41EC00AC        	  5364:     lea     ($00AC,A4),A0
02:0003A6F6 52302000        	  5365:     addq.b  #1,(A0,D2.W)
                            	  5366:     ; Subtract 1 from facing direction to make an index.
                            	  5367:     ;
02:0003A6FA 7600            	  5368:     moveq   #0,D3
02:0003A6FC 41EC0098        	  5369:     lea     ($0098,A4),A0
02:0003A700 16302000        	  5370:     move.b  (A0,D2.W),D3
02:0003A704 5303            	  5371:     subq.b  #1,D3
                            	  5372:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5373:     ;
02:0003A706 41EC0084        	  5374:     lea     ($0084,A4),A0
02:0003A70A 10302000        	  5375:     move.b  (A0,D2.W),D0
02:0003A70E 0C000078        	  5376:     cmpi.b  #$78,D0
02:0003A712 6402            	  5377:     bcc  _anon_z04_97
02:0003A714 7603            	  5378:     moveq   #3,D3
                            	  5379: _anon_z04_97:
                            	  5380:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5381:     ;
02:0003A716 0C0000A8        	  5382:     cmpi.b  #$A8,D0
02:0003A71A 6502            	  5383:     bcs  _anon_z04_98
02:0003A71C 7607            	  5384:     moveq   #7,D3
                            	  5385: _anon_z04_98:
                            	  5386:     ; Set the vertical speed for the beginning of the jump.
                            	  5387:     ;
02:0003A71E 41F90003A612    	  5388:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003A724 10303000        	  5389:     move.b  (A0,D3.W),D0
02:0003A728 41EC0412        	  5390:     lea     ($0412,A4),A0
02:0003A72C 11802000        	  5391:     move.b  D0,(A0,D2.W)
                            	  5392:     ; Look up the Y offset for the current direction.
                            	  5393:     ; Add it to object Y to set the destination Y of the jump.
                            	  5394:     ;
02:0003A730 41EC0084        	  5395:     lea     ($0084,A4),A0
02:0003A734 10302000        	  5396:     move.b  (A0,D2.W),D0
02:0003A738 023C00EE        	  5397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A73C 41F90003A61A    	  5398:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003A742 12303000        	  5399:     move.b  (A0,D3.W),D1
02:0003A746 D101            	  5400:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003A748 41EC042C        	  5401:     lea     ($042C,A4),A0
02:0003A74C 11802000        	  5402:     move.b  D0,(A0,D2.W)
                            	  5403:     ; Turn the index into a direction again by adding 1.
                            	  5404:     ; Store the facing direction.
                            	  5405:     ;
02:0003A750 5203            	  5406:     addq.b  #1,D3
02:0003A752 41EC0098        	  5407:     lea     ($0098,A4),A0
