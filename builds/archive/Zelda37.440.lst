                            	  4159: CheckTiles:
                            	  4160:     ifne TURBO_LINK
                            	  4161:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4162:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00048346 4A02            	  4163:     tst.b   D2
02:00048348 6608            	  4164:     bne.s   _L_z07_CheckTiles_notLink
02:0004834A 197C0024049E    	  4165:     move.b  #$24,($049E,A4)
02:00048350 605E            	  4166:     jmp     GoWalkableDir
                            	  4167: _L_z07_CheckTiles_notLink:
                            	  4168:     endc
                            	  4169:     ; The code below applies to Link and other objects.
                            	  4170:     ;
                            	  4171:     ; Test the moving direction's walkability.
                            	  4172:     ;
                            	  4173:     ; For the player, this is enough. For other objects, this 
                            	  4174:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4175:     ;
                            	  4176:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4177:     ;
02:00048352 6100FB88        	  4178:     jsr     GetCollidingTileMoving
02:00048356 122C034A        	  4179:     move.b  ($034A,A4),D1
02:0004835A B001            	  4180:     cmp.b   D1,D0
02:0004835C 6402            	  4181:     bcc.s  __far_z_07_0052
02:0004835E 6050            	  4182:     jmp  GoWalkableDir
                            	  4183: __far_z_07_0052:
                            	  4184:     ; The colliding tile is unwalkable.
                            	  4185:     ;
                            	  4186:     ; If object is the player, then go check passive tile objects and
                            	  4187:     ; the screen edge, or stop moving.
                            	  4188:     ;
02:00048360 4A02            	  4189:     cmpi.b  #$00,D2
02:00048362 6602            	  4190:     bne.s  __far_z_07_0053
02:00048364 6022            	  4191:     jmp  PlayerUnwalkable
                            	  4192: __far_z_07_0053:
                            	  4193:     even
                            	  4194: CheckObjAttr10AndAltDir:
                            	  4195:     ; Not the player.
                            	  4196:     ; If object attribute has $10, go to the unused code above
                            	  4197:     ; to reverse direction.
                            	  4198:     ;
02:00048366 41EC04BF        	  4199:     lea     ($04BF,A4),A0
02:0004836A 10302000        	  4200:     move.b  (A0,D2.W),D0
02:0004836E 02000010        	  4201:     andi.b #$10,D0
02:00048372 6702            	  4202:     beq.s  __far_z_07_0054
02:00048374 60C8            	  4203:     jmp  Reverse
                            	  4204: __far_z_07_0054:
