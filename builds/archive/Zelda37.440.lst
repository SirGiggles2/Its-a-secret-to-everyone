                            	  2280: __far_z_02_0002:
                            	  2281:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2282:     ; in the current slot's name.
02:000337EE 41F900033202    	  2283:     lea     (SlotToNameOffset).l,A0
02:000337F4 10303000        	  2284:     move.b  (A0,D3.W),D0
02:000337F8 19400421        	  2285:     move.b  D0,($0421,A4)
                            	  2286:     ; Get the offset of the end of the initial name character
                            	  2287:     ; transfer record header for the current slot.
02:000337FC 7400            	  2288:     moveq   #0,D2
02:000337FE 41F900033206    	  2289:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033804 14303000        	  2290:     move.b  (A0,D3.W),D2
02:00033808 7602            	  2291:     moveq   #2,D3
