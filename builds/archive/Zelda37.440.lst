                            	  2388:     ; Write the end marker.
                            	  2389:     ;
02:000476CE 103C00FF        	  2390:     move.b  #$FF,D0
02:000476D2 41EC030C        	  2391:     lea     ($030C,A4),A0
02:000476D6 11802000        	  2392:     move.b  D0,(A0,D2.W)
                            	  2393:     ; Update dynamic buffer length with 10 new bytes.
                            	  2394:     ;
02:000476DA 1002            	  2395:     move.b  D2,D0
02:000476DC 023C00EE        	  2396:     andi    #$EE,CCR  ; CLC: clear C+X
02:000476E0 123C000A        	  2397:     move.b  #$0A,D1
02:000476E4 D101            	  2398:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:000476E6 19400301        	  2399:     move.b  D0,($0301,A4)
02:000476EA 101D            	  2400:     move.b  (A5)+,D0  ; PLA
02:000476EC 7400            	  2401:     moveq   #0,D2
02:000476EE 1400            	  2402:     move.b  D0,D2
02:000476F0 7005            	  2403:     moveq   #5,D0
02:000476F2 6100272E        	  2404:     jsr     SwitchBank
