02:00049A52 41F900049542    	  7327:     lea     (ObjectTypeToAttributes).l,A0
02:00049A58 10303000        	  7328:     move.b  (A0,D3.W),D0
02:00049A5C 41EC04BF        	  7329:     lea     ($04BF,A4),A0
02:00049A60 11802000        	  7330:     move.b  D0,(A0,D2.W)
02:00049A64 1003            	  7331:     move.b  D3,D0
02:00049A66 1880            	  7332:     move.b  D0,($0000,A4)
                            	  7333:     ; Hit points are packed two values to a byte.
                            	  7334:     ; Divide the object type in half in order to index
