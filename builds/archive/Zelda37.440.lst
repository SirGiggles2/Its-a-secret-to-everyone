02:0003BE22 6714            	  8384:     beq  _L_z04_PatraChild_State1_Exit
02:0003BE24 4EB9000310D0    	  8385:     jsr     CheckMonsterCollisions
                            	  8386:     ; If the monster died, then change to the dead dummy object.
