02:0003BF58 11802000        	  8588:     move.b  D0,(A0,D2.W)
02:0003BF5C 6100EB40        	  8589:     jsr     BlueWizzrobe_TurnSometimesAndMoveAndCheckTile
                            	  8590:     ; Shoot every $40 frames.
                            	  8591:     ;
02:0003BF60 102C0015        	  8592:     move.b  ($0015,A4),D0
