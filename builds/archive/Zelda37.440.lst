02:0003B27A 020000FE        	  6846:     andi.b #$FE,D0
02:0003B27E 1214            	  6847:     move.b  ($0000,A4),D1
02:0003B280 8001            	  6848:     or.b  D1,D0
02:0003B282 41EC0478        	  6849:     lea     ($0478,A4),A0
02:0003B286 11802000        	  6850:     move.b  D0,(A0,D2.W)
                            	  6851:     ; If this segment is the base, then go draw.
                            	  6852:     ;
02:0003B28A 0C020005        	  6853:     cmpi.b  #$05,D2
02:0003B28E 6736            	  6854:     beq  _L_z04_UpdateManhandla_Draw
                            	  6855:     ; If the old and new "frame image and sprite attributes" variables
                            	  6856:     ; are the same, then go draw.
                            	  6857:     ;
                            	  6858:     ; The previous frame value begins with value 0, because all
                            	  6859:     ; room data was reset on entry.
                            	  6860:     ;
02:0003B290 41EC0478        	  6861:     lea     ($0478,A4),A0
02:0003B294 10302000        	  6862:     move.b  (A0,D2.W),D0
02:0003B298 41EC0437        	  6863:     lea     ($0437,A4),A0
02:0003B29C 12302000        	  6864:     move.b  (A0,D2.W),D1
02:0003B2A0 B001            	  6865:     cmp.b   D1,D0
02:0003B2A2 6722            	  6866:     beq  _L_z04_UpdateManhandla_Draw
                            	  6867:     ; Copy the new value to the old variable, so that they're the same.
                            	  6868:     ;
02:0003B2A4 41EC0437        	  6869:     lea     ($0437,A4),A0
02:0003B2A8 11802000        	  6870:     move.b  D0,(A0,D2.W)
                            	  6871:     ; If animation frame = 1, then go draw.
                            	  6872:     ;
                            	  6873:     ; The low bit of "frame image and sprite attributes" byte
                            	  6874:     ; represents the animation frame.
                            	  6875:     ;
02:0003B2AC E208            	  6876:     lsr.b  #1,D0   ; LSR A
02:0003B2AE 6516            	  6877:     bcs  _L_z04_UpdateManhandla_Draw
                            	  6878:     ; If the random value for the next slot up < $E0,
                            	  6879:     ; or there's an object in slot 7; then go draw.
