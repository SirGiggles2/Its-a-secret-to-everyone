                            	  5280: _L_z04_UpdatePolsVoice_State0:
                            	  5281:     ; State 0. Walking.
                            	  5282:     ;
                            	  5283:     ; If grid offset = 0, then no more distance to cover.
                            	  5284:     ; So, go change to state 1 -- jumping.
                            	  5285:     ;
02:0003A658 41EC0394        	  5286:     lea     ($0394,A4),A0
02:0003A65C 10302000        	  5287:     move.b  (A0,D2.W),D0
02:0003A660 67000084        	  5288:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5289:     ; Decrement grid offset / distance remaining.
                            	  5290:     ;
02:0003A664 41EC0394        	  5291:     lea     ($0394,A4),A0
02:0003A668 53302000        	  5292:     subq.b  #1,(A0,D2.W)
                            	  5293:     ; Move vertically.
                            	  5294:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5295:     ;
02:0003A66C 41EC0084        	  5296:     lea     ($0084,A4),A0
02:0003A670 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0003A674 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A678 41F90003A608    	  5299:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A67E 12303000        	  5300:     move.b  (A0,D3.W),D1
02:0003A682 D101            	  5301:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A684 41EC0084        	  5302:     lea     ($0084,A4),A0
02:0003A688 11802000        	  5303:     move.b  D0,(A0,D2.W)
                            	  5304:     even
                            	  5305: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5306:     ; If the square the monster is over is walkable, then
                            	  5307:     ; go draw and check object collisions.
                            	  5308:     ;
