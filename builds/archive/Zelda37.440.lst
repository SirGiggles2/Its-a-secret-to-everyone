                            	  8310: PatraChild_State1:
                            	  8311:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	  8312:     ;
02:0003BD86 10342070        	  8313:     move.b  ($70,A4,D2.W),D0
02:0003BD8A 023C00EE        	  8314:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD8E 122C046C        	  8315:     move.b  ($046C,A4),D1
02:0003BD92 D101            	  8316:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003BD94 19802070        	  8317:     move.b  D0,($70,A4,D2.W)
02:0003BD98 41EC0084        	  8318:     lea     ($0084,A4),A0
02:0003BD9C 10302000        	  8319:     move.b  (A0,D2.W),D0
02:0003BDA0 023C00EE        	  8320:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDA4 122C0479        	  8321:     move.b  ($0479,A4),D1
02:0003BDA8 D101            	  8322:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003BDAA 41EC0084        	  8323:     lea     ($0084,A4),A0
02:0003BDAE 11802000        	  8324:     move.b  D0,(A0,D2.W)
                            	  8325:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  8326:     ;
02:0003BDB2 7000            	  8327:     moveq   #0,D0
02:0003BDB4 1940000B        	  8328:     move.b  D0,($000B,A4)
                            	  8329:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  8330:     ; monster's angle by $70, else by $60 to go slower.
                            	  8331:     ;
02:0003BDB8 7070            	  8332:     moveq   #112,D0
02:0003BDBA 7600            	  8333:     moveq   #0,D3
02:0003BDBC 41EC034F        	  8334:     lea     ($034F,A4),A0
02:0003BDC0 16302000        	  8335:     move.b  (A0,D2.W),D3
02:0003BDC4 0C030025        	  8336:     cmpi.b  #$25,D3
02:0003BDC8 6702            	  8337:     beq  _anon_z04_159
02:0003BDCA 7060            	  8338:     moveq   #96,D0
                            	  8339: _anon_z04_159:
02:0003BDCC 61000CC0        	  8340:     jsr     DecreaseObjectAngle
                            	  8341:     ; Load Patra's maneuver index.
                            	  8342:     ; It determines which counts of bits are looked up below.
                            	  8343:     ;
02:0003BDD0 7600            	  8344:     moveq   #0,D3
02:0003BDD2 162C045F        	  8345:     move.b  ($045F,A4),D3
                            	  8346:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8347:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8348:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8349:     ;
02:0003BDD6 41EC034F        	  8350:     lea     ($034F,A4),A0
02:0003BDDA 10302000        	  8351:     move.b  (A0,D2.W),D0
02:0003BDDE 0C000025        	  8352:     cmpi.b  #$25,D0
02:0003BDE2 661E            	  8353:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BDE4 41F90003BCD6    	  8354:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003BDEA 10303000        	  8355:     move.b  (A0,D3.W),D0
02:0003BDEE 1B00            	  8356:     move.b  D0,-(A5)  ; PHA
02:0003BDF0 41F90003BCDA    	  8357:     lea     (PatraChild1RotationSineBits).l,A0
02:0003BDF6 10303000        	  8358:     move.b  (A0,D3.W),D0
02:0003BDFA 7600            	  8359:     moveq   #0,D3
02:0003BDFC 1600            	  8360:     move.b  D0,D3
02:0003BDFE 101D            	  8361:     move.b  (A5)+,D0  ; PLA
02:0003BE00 600E            	  8362:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8363: 
                            	  8364:     even
                            	  8365: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8366:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8367:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8368:     ; a small circle (5) and a large circle (6).
                            	  8369:     ;
02:0003BE02 41F90003BCD8    	  8370:     lea     (PatraChild2RotationBits).l,A0
02:0003BE08 10303000        	  8371:     move.b  (A0,D3.W),D0
02:0003BE0C 7600            	  8372:     moveq   #0,D3
02:0003BE0E 1600            	  8373:     move.b  D0,D3
                            	  8374:     even
