                            	  2431: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:0003391E 41F9000331EC    	  2432:     lea     (ModeEandFCursorSprites).l,A0
02:00033924 10303000        	  2433:     move.b  (A0,D3.W),D0
02:00033928 41EC0201        	  2434:     lea     ($0201,A4),A0
02:0003392C 11803000        	  2435:     move.b  D0,(A0,D3.W)
02:00033930 5303            	  2436:     subq.b  #1,D3
02:00033932 6AEA            	  2437:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033934 7600            	  2438:     moveq   #0,D3
02:00033936 162C0016        	  2439:     move.b  ($0016,A4),D3
02:0003393A 41F9000331A2    	  2440:     lea     (ModeEandFSlotCursorYs).l,A0
02:00033940 10303000        	  2441:     move.b  (A0,D3.W),D0
02:00033944 19400084        	  2442:     move.b  D0,($0084,A4)
02:00033948 19400200        	  2443:     move.b  D0,($0200,A4)
02:0003394C 102C0012        	  2444:     move.b  ($0012,A4),D0
02:00033950 0C00000F        	  2445:     cmpi.b  #$0F,D0
                            	  2446:     ; There's more work in mode $E.
                            	  2447:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2448:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00033954 6736            	  2449:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00033956 103C00F3        	  2450:     move.b  #$F3,D0
02:0003395A 19400201        	  2451:     move.b  D0,($0201,A4)
                            	  2452:     ; Because the visible part of the cursor block sprite is
                            	  2453:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2454:     ; above its ObjY.
02:0003395E 102C0084        	  2455:     move.b  ($0084,A4),D0
02:00033962 003C0011        	  2456:     ori     #$11,CCR  ; SEC: set C+X
02:00033966 123C0008        	  2457:     move.b  #$08,D1
02:0003396A 0A3C0010        	  2458:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003396E 9101            	  2459:     subx.b  D1,D0   ; SBC #$08
02:00033970 0A3C0010        	  2460:     eori    #$10,CCR  ; restore X = 6502 C
02:00033974 19400204        	  2461:     move.b  D0,($0204,A4)
02:00033978 7070            	  2462:     moveq   #112,D0
02:0003397A 19400070        	  2463:     move.b  D0,($0070,A4)
02:0003397E 103C0087        	  2464:     move.b  #$87,D0
