                            	  5784: 
                            	  5785: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5786: ; Each set contains 4 offsets in reverse direction index order:
                            	  5787: ; up, down, left, right
                            	  5788: ;
                            	  5789: ; These offsets are added to player X to get weapon X.
                            	  5790: ;
                            	  5791:     even
                            	  5792: PlayerToWeaponOffsetsX:
02:00048E44 FF              	  5793:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:00048E45 01
02:00048E46 00
02:00048E47 F8
02:00048E48 FF
02:00048E49 01
02:00048E4A F5
02:00048E4B 0B
02:00048E4C FF              	  5794:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:00048E4D 01
02:00048E4E F9
02:00048E4F 07
02:00048E50 FF
02:00048E51 01
02:00048E52 FD
02:00048E53 03
                            	  5795: 
                            	  5796: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5797: ; Each set contains 4 offsets in reverse direction index order:
                            	  5798: ; up, down, left, right
                            	  5799: ;
                            	  5800: ; These offsets are added to player Y to get weapon Y.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PlayerToWeaponOffsetsY:
02:00048E54 F7              	  5804:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:00048E55 F2
02:00048E56 F5
02:00048E57 F5
02:00048E58 F6
02:00048E59 0D
02:00048E5A 03
02:00048E5B 03
02:00048E5C F7              	  5805:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:00048E5D 09
02:00048E5E 03
02:00048E5F 03
02:00048E60 FF
02:00048E61 05
02:00048E62 03
02:00048E63 03
