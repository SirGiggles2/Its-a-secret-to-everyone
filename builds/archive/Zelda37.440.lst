02:00040D14 E208            	  6891:     lsr.b  #1,D0   ; LSR A
02:00040D16 E208            	  6892:     lsr.b  #1,D0   ; LSR A
02:00040D18 E208            	  6893:     lsr.b  #1,D0   ; LSR A
