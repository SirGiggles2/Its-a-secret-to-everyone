02:00041B9C 7008            	  8566:     moveq   #8,D0
02:00041B9E 19400002        	  8567:     move.b  D0,($0002,A4)
02:00041BA2 7403            	  8568:     moveq   #3,D2
                            	  8569: _anon_z05_204:
