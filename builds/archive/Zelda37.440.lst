                            	  5934: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5935:     ; Store the weapon's frame (horizontal or vertical)
                            	  5936:     ; for the direction chosen above in [0C].
                            	  5937:     ;
02:00048F68 4EB900030994    	  5938:     jsr     GetOppositeDir
02:00048F6E 41F9000489A2    	  5939:     lea     (RDirectionToWeaponFrame).l,A0
02:00048F74 10303000        	  5940:     move.b  (A0,D3.W),D0
02:00048F78 1940000C        	  5941:     move.b  D0,($000C,A4)
                            	  5942:     ; Calculate sprite attributes.
                            	  5943:     ;
                            	  5944:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5945:     ;   base attribute OR 1
                            	  5946:     ; So, it uses palette row 5.
                            	  5947:     ;
02:00048F7C 41F9000489A6    	  5948:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048F82 10303000        	  5949:     move.b  (A0,D3.W),D0
02:00048F86 0C02000D        	  5950:     cmpi.b  #$0D,D2
02:00048F8A 6706            	  5951:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048F8C 00000001        	  5952:     ori.b #$01,D0
02:00048F90 601C            	  5953:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5954: 
                            	  5955:     even
                            	  5956: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5957:     ; The weapon is the sword.
                            	  5958:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5959:     ;
02:00048F92 023C00EE        	  5960:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F96 122C0657        	  5961:     move.b  ($0657,A4),D1
02:00048F9A D101            	  5962:     addx.b  D1,D0   ; ADC Items
02:00048F9C 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:00048FA0 123C0001        	  5964:     move.b  #$01,D1
02:00048FA4 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048FA8 9101            	  5966:     subx.b  D1,D0   ; SBC #$01
02:00048FAA 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5968:     even
                            	  5969: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5970:     ; Set sprite attributes to the calculated value above.
                            	  5971:     ;
02:00048FAE 4EB900031056    	  5972:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5973:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5974:     ;
02:00048FB4 0C030002        	  5975:     cmpi.b  #$02,D3
02:00048FB8 6604            	  5976:     bne  _anon_z07_33
02:00048FBA 522C000F        	  5977:     addq.b  #1,($000F,A4)
                            	  5978: _anon_z07_33:
                            	  5979:     ; If state = 1, return. Don't show the weapon.
                            	  5980:     ;
02:00048FBE 41EC00AC        	  5981:     lea     ($00AC,A4),A0
02:00048FC2 10302000        	  5982:     move.b  (A0,D2.W),D0
02:00048FC6 0200000F        	  5983:     andi.b #$0F,D0
02:00048FCA 0C000001        	  5984:     cmpi.b  #$01,D0
02:00048FCE 6604            	  5985:     bne.s  __far_z_07_0086
02:00048FD0 600000AA        	  5986:     jmp  L1F854_Exit
                            	  5987: __far_z_07_0086:
                            	  5988:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5989:     ; sword or rod
                            	  5990:     ;
                            	  5991:     ;
                            	  5992:     ; Sword slot
02:00048FD4 7600            	  5993:     moveq   #0,D3
02:00048FD6 0C02000D        	  5994:     cmpi.b  #$0D,D2
02:00048FDA 6702            	  5995:     beq  _anon_z07_34
02:00048FDC 7608            	  5996:     moveq   #8,D3
                            	  5997: _anon_z07_34:
02:00048FDE 4EB900030F76    	  5998:     jsr     Anim_WriteItemSprites
                            	  5999:     ; If state <> 3, return.
                            	  6000:     ;
02:00048FE4 41EC00AC        	  6001:     lea     ($00AC,A4),A0
02:00048FE8 10302000        	  6002:     move.b  (A0,D2.W),D0
02:00048FEC 0200000F        	  6003:     andi.b #$0F,D0
02:00048FF0 0C000003        	  6004:     cmpi.b  #$03,D0
02:00048FF4 6704            	  6005:     beq.s  __far_z_07_0087
02:00048FF6 60000084        	  6006:     jmp  L1F854_Exit
                            	  6007: __far_z_07_0087:
                            	  6008:     ; State = 3. Time to instantiate a shot.
                            	  6009:     ;
                            	  6010:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6011:     ;
02:00048FFA 0C020012        	  6012:     cmpi.b  #$12,D2
02:00048FFE 6704            	  6013:     beq.s  __far_z_07_0088
02:00049000 60000082        	  6014:     jmp  MakeSwordShot
                            	  6015: __far_z_07_0088:
                            	  6016:     ; Instantiate a magic shot (rod shot).
                            	  6017:     ; Switch to the shot slot $E.
                            	  6018:     ;
