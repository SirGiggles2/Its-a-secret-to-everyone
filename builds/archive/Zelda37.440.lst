02:0003A6BC 10302000        	  5333:     move.b  (A0,D2.W),D0
02:0003A6C0 0A00000C        	  5334:     eori.b #$0C,D0
02:0003A6C4 41EC0098        	  5335:     lea     ($0098,A4),A0
02:0003A6C8 11802000        	  5336:     move.b  D0,(A0,D2.W)
