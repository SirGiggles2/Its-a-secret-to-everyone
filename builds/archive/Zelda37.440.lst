                            	  5663:     ;
02:000401D8 103C00FF        	  5664:     move.b  #$FF,D0
02:000401DC 41EC0302        	  5665:     lea     ($0302,A4),A0
02:000401E0 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:000401E4 1002            	  5667:     move.b  D2,D0
02:000401E6 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:000401EA 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:000401EE 102C0054        	  5678:     move.b  ($0054,A4),D0
02:000401F2 02000003        	  5679:     andi.b #$03,D0
02:000401F6 6708            	  5680:     beq  _anon_z05_122
02:000401F8 7008            	  5681:     moveq   #8,D0
02:000401FA 19400027        	  5682:     move.b  D0,($0027,A4)
02:000401FE 4E75            	  5683:     rts
                            	  5684: 
                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:00040200 102C0054        	  5693:     move.b  ($0054,A4),D0
02:00040204 0C000004        	  5694:     cmpi.b  #$04,D0
02:00040208 6626            	  5695:     bne  _anon_z05_123
02:0004020A 7400            	  5696:     moveq   #0,D2
02:0004020C 142C0009        	  5697:     move.b  ($0009,A4),D2
02:00040210 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:00040214 102C0055        	  5699:     move.b  ($0055,A4),D0
02:00040218 0A00000F        	  5700:     eori.b #$0F,D0
02:0004021C 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:00040220 C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00040222 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:00040226 7000            	  5708:     moveq   #0,D0
02:00040228 19400054        	  5709:     move.b  D0,($0054,A4)
02:0004022C 6000FCD4        	  5710:     jmp     LayOutDoors
                            	  5711: 
                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:00040230 102C0055        	  5719:     move.b  ($0055,A4),D0
02:00040234 19400002        	  5720:     move.b  D0,($0002,A4)
02:00040238 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:0004023C 0C000007        	  5722:     cmpi.b  #$07,D0
02:00040240 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:00040242 7400            	  5728:     moveq   #0,D2
02:00040244 142C0009        	  5729:     move.b  ($0009,A4),D2
02:00040248 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:0004024C 1003            	  5733:     move.b  D3,D0
02:0004024E 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040252 41F90004010E    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:00040258 12302000        	  5736:     move.b  (A0,D2.W),D1
02:0004025C D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0004025E 7600            	  5738:     moveq   #0,D3
02:00040260 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:00040262 1002            	  5742:     move.b  D2,D0
02:00040264 0A000001        	  5743:     eori.b #$01,D0
02:00040268 7400            	  5744:     moveq   #0,D2
02:0004026A 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:0004026C 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:0004026E 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
02:00040272 024100FF        	  5750:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040276 E14C            	  5751:     lsl.w   #8,D4
02:00040278 8841            	  5752:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004027A 48C4            	  5753:     ext.l   D4
02:0004027C D8BC00FF0000    	  5754:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040282 2044            	  5755:     movea.l D4,A0
02:00040284 10303000        	  5756:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040288 41F900047358    	  5757:     lea     (LevelMasks).l,A0
02:0004028E 12302000        	  5758:     move.b  (A0,D2.W),D1
02:00040292 8001            	  5759:     or.b  D1,D0
02:00040294 1214            	  5760:     move.b  ($00,A4),D1   ; ptr lo
02:00040296 182C0001        	  5761:     move.b  ($01,A4),D4  ; ptr hi
02:0004029A 024100FF        	  5762:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004029E E14C            	  5763:     lsl.w   #8,D4
02:000402A0 8841            	  5764:     or.w    D1,D4
02:000402A2 48C4            	  5765:     ext.l   D4
02:000402A4 D8BC00FF0000    	  5766:     add.l   #NES_RAM,D4
02:000402AA 2044            	  5767:     movea.l D4,A0
02:000402AC 11803000        	  5768:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:000402B0 102C0055        	  5773:     move.b  ($0055,A4),D0
02:000402B4 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:000402B8 8001            	  5775:     or.b  D1,D0
02:000402BA 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:000402BE 102C0055        	  5803:     move.b  ($0055,A4),D0
02:000402C2 19400002        	  5804:     move.b  D0,($0002,A4)
02:000402C6 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:000402CA 0C000005        	  5806:     cmpi.b  #$05,D0
02:000402CE 650C            	  5807:     bcs  _anon_z05_125
02:000402D0 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:000402D2 7004            	  5809:     moveq   #4,D0
02:000402D4 4EB9000308EE    	  5810:     jsr     PlaySample
02:000402DA 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:000402DC 0C000004        	  5818:     cmpi.b  #$04,D0
02:000402E0 6602            	  5819:     bne  _anon_z05_126
02:000402E2 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:000402E4 0C000001        	  5822:     cmpi.b  #$01,D0
02:000402E8 6602            	  5823:     bne  _anon_z05_127
02:000402EA 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:000402EC 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:000402F0 123C0003        	  5829:     move.b  #$03,D1
02:000402F4 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000402F8 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:000402FA 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:000402FE 7600            	  5833:     moveq   #0,D3
02:00040300 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:00040302 102C0008        	  5841:     move.b  ($0008,A4),D0
02:00040306 6708            	  5842:     beq  _anon_z05_128
02:00040308 0C030005        	  5843:     cmpi.b  #$05,D3
02:0004030C 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0004030E 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:00040310 0C030003        	  5847:     cmpi.b  #$03,D3
02:00040314 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040316 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:00040318 7003            	  5857:     moveq   #3,D0
02:0004031A 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:0004031E 122C0003        	  5859:     move.b  ($0003,A4),D1
02:00040322 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040326 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:00040328 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:0004032C 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:00040330 41F900040106    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:00040336 10302000        	  5870:     move.b  (A0,D2.W),D0
02:0004033A 1880            	  5871:     move.b  D0,($0000,A4)
02:0004033C 41F90004010A    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:00040342 10302000        	  5873:     move.b  (A0,D2.W),D0
02:00040346 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:0004034A 19420009        	  5878:     move.b  D2,($0009,A4)
02:0004034E 7400            	  5879:     moveq   #0,D2
02:00040350 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:00040354 7000            	  5883:     moveq   #0,D0
02:00040356 19400007        	  5884:     move.b  D0,($0007,A4)
02:0004035A 7002            	  5885:     moveq   #2,D0
02:0004035C 19400006        	  5886:     move.b  D0,($0006,A4)
02:00040360 19400005        	  5887:     move.b  D0,($0005,A4)
02:00040364 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040368 4E75            	  5889:     rts
                            	  5890: 
                            	  5891:     even
