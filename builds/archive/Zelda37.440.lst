                            	  2518: PondFairy_MoveHearts:
                            	  2519:     ; Loop over each heart from object slot 2 to 9.
                            	  2520:     ;
                            	  2521:     ; Even though they are not standalone objects, their info
                            	  2522:     ; is stored in those object slots.
                            	  2523:     ;
02:00039226 7402            	  2524:     moveq   #2,D2
                            	  2525:     even
                            	  2526: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2527:     ; If the current heart's state <> 0, then go move it.
                            	  2528:     ; Else we have to wait for it to come out at the right time.
                            	  2529:     ;
02:00039228 41EC00AC        	  2530:     lea     ($00AC,A4),A0
02:0003922C 10302000        	  2531:     move.b  (A0,D2.W),D0
02:00039230 667C            	  2532:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2533:     ; The current heart's state = 0.
                            	  2534:     ;
                            	  2535:     ; If object slot = 2, then go make it appear. This is the first
                            	  2536:     ; heart to show up.
                            	  2537:     ;
02:00039232 0C020002        	  2538:     cmpi.b  #$02,D2
02:00039236 6732            	  2539:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2540:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2541:     ; go start over.
                            	  2542:     ;
                            	  2543:     ; TODO:
                            	  2544:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2545:     ;
02:00039238 102C00AE        	  2546:     move.b  ($00AE,A4),D0
02:0003923C 67EA            	  2547:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2548:     ; Look up the starting angle of this heart with the index
                            	  2549:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2550:     ; then loop again.
                            	  2551:     ;
02:0003923E 1002            	  2552:     move.b  D2,D0
02:00039240 003C0011        	  2553:     ori     #$11,CCR  ; SEC: set C+X
02:00039244 123C0003        	  2554:     move.b  #$03,D1
