                            	   313: DriveAudio:
                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:0002DDFC 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002DDFE 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002DE02 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002DE04 7000            	   323:     moveq   #0,D0
02:0002DE06 6100D06C        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002DE0A 700F            	   325:     moveq   #15,D0
02:0002DE0C 6100D066        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0002DE10 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
                            	   330:     ; Else the game is not paused.
                            	   331:     ;
                            	   332:     ; Synchronize the APU frame counter once a video frame.
