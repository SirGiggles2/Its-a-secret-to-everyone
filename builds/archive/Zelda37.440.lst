02:00038EE8 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038EEC 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038EF0 41F900038CE2    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038EF6 10303000        	  2007:     move.b  (A0,D3.W),D0
02:00038EFA 6000FD20        	  2008:     jmp     Burrower_AnimateDrawAndCheckCollisions
