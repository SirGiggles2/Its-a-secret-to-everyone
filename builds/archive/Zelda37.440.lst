                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038D72 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038D76 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038D7A 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038D7E 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038D82 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038D84 7628            	  1826:     moveq   #40,D3
02:00038D86 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038D8A 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038D8E 02000002        	  1829:     andi.b #$02,D0
02:00038D92 6704            	  1830:     beq  _anon_z04_45
02:00038D94 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038D98 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038D9A 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038D9E 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038DA2 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038DA6 1214            	  1841:     move.b  ($0000,A4),D1
02:00038DA8 D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038DAA 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038DAE 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038DB2 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038DB6 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038DBA B001            	  1853:     cmp.b   D1,D0
02:00038DBC 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038DBE 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038DC0 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038DC4 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038DC8 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038DCA 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038DCE 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038DD2 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038DD6 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038DDA 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038DDE 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038DE0 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
