                            	  4726:     even
                            	  4727: _L_z04_Aquamentus_Shoot_LoopObject:
                            	  4728:     ; If type <> $55, loop again.
                            	  4729:     ;
02:0003A26C 41EC034F        	  4730:     lea     ($034F,A4),A0
