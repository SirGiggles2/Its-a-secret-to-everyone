02:0003A9A2 41EC0405        	  5662:     lea     ($0405,A4),A0
02:0003A9A6 10302000        	  5663:     move.b  (A0,D2.W),D0
02:0003A9AA 678A            	  5664:     beq  _L_z04_UpdateLikeLike_Exit
                            	  5665:     ; But once it has died, then let Link move again.
                            	  5666:     ;
