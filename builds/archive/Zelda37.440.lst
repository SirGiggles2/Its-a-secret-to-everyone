                            	  7173: _L_z07_InitObject_InitMonsterFromEdge:
02:0004990A 7400            	  7174:     moveq   #0,D2
02:0004990C 142C0340        	  7175:     move.b  ($0340,A4),D2
                            	  7176:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7177:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7178:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7179:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7180:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7181:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7182:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7183:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7184:     ; corrupting them and causing a deterministic address-error
                            	  7185:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7186:     ; identified by Codex static review.)
                            	  7187: _L_z07_P47_pre_check:
02:00049910 102C0525        	  7188:     move.b  ($0525,A4),D0
02:00049914 020000F0        	  7189:     andi.b  #$F0,D0
02:00049918 0C000040        	  7190:     cmpi.b  #$40,D0
02:0004991C 6506            	  7191:     blo     _L_z07_P47_pre_snap
02:0004991E 0C0000E0        	  7192:     cmpi.b  #$E0,D0
02:00049922 6506            	  7193:     blo     _L_z07_P47_pre_ok
                            	  7194: _L_z07_P47_pre_snap:
02:00049924 197C00480525    	  7195:     move.b  #$48,($0525,A4)
                            	  7196: _L_z07_P47_pre_ok:
02:0004992A 7005            	  7197:     moveq   #5,D0
02:0004992C 610004F4        	  7198:     jsr     SwitchBank
02:00049930 4EB90003E82C    	  7199:     jsr     FindNextEdgeSpawnCell
                            	  7200:     ; Post-walk 1: bottom-edge snap.
02:00049936 102C0525        	  7201:     move.b  ($0525,A4),D0
02:0004993A 020000F0        	  7202:     andi.b  #$F0,D0
02:0004993E 0C0000E0        	  7203:     cmpi.b  #$E0,D0
02:00049942 660C            	  7204:     bne     _L_z07_P47_post1_ok
02:00049944 197C00480525    	  7205:     move.b  #$48,($0525,A4)
02:0004994A 4EB90003E82C    	  7206:     jsr     FindNextEdgeSpawnCell
                            	  7207: _L_z07_P47_post1_ok:
                            	  7208:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7209:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:00049950 7600            	  7210:     moveq   #0,D3
02:00049952 162C0525        	  7211:     move.b  ($0525,A4),D3
02:00049956 0243000F        	  7212:     andi.w  #$000F,D3
02:0004995A C6FC002C        	  7213:     mulu.w  #44,D3
02:0004995E 203C00FF6530    	  7214:     move.l  #$FF6530,D0
02:00049964 D083            	  7215:     add.l   D3,D0
02:00049966 7600            	  7216:     moveq   #0,D3
02:00049968 162C0525        	  7217:     move.b  ($0525,A4),D3
02:0004996C E84B            	  7218:     lsr.w   #4,D3
02:0004996E 5943            	  7219:     subi.w  #4,D3
02:00049970 E34B            	  7220:     lsl.w   #1,D3
02:00049972 D083            	  7221:     add.l   D3,D0
02:00049974 2040            	  7222:     movea.l D0,A0
02:00049976 1010            	  7223:     move.b  (A0),D0
02:00049978 0C000084        	  7224:     cmpi.b  #$84,D0
02:0004997C 6544            	  7225:     blo     _L_z07_P47_post2_ok
                            	  7226:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7227:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7228:     ; writes to the $05xx region.
02:0004997E 7800            	  7229:     moveq   #0,D4
                            	  7230: _L_z07_P47_fb_loop:
02:00049980 41FAE566        	  7231:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049984 12304000        	  7232:     move.b  (A0,D4.W),D1
02:00049988 19410525        	  7233:     move.b  D1,($0525,A4)
                            	  7234:     ; Validate fallback cell walkable.
02:0004998C 7600            	  7235:     moveq   #0,D3
02:0004998E 1601            	  7236:     move.b  D1,D3
02:00049990 0243000F        	  7237:     andi.w  #$000F,D3
02:00049994 C6FC002C        	  7238:     mulu.w  #44,D3
02:00049998 203C00FF6530    	  7239:     move.l  #$FF6530,D0
02:0004999E D083            	  7240:     add.l   D3,D0
02:000499A0 7600            	  7241:     moveq   #0,D3
02:000499A2 1601            	  7242:     move.b  D1,D3
02:000499A4 E84B            	  7243:     lsr.w   #4,D3
02:000499A6 5943            	  7244:     subi.w  #4,D3
02:000499A8 E34B            	  7245:     lsl.w   #1,D3
02:000499AA D083            	  7246:     add.l   D3,D0
02:000499AC 2040            	  7247:     movea.l D0,A0
02:000499AE 0C100084        	  7248:     cmpi.b  #$84,(A0)
02:000499B2 650E            	  7249:     blo     _L_z07_P47_post2_ok
02:000499B4 5204            	  7250:     addq.b  #1,D4
02:000499B6 0C040008        	  7251:     cmpi.b  #8,D4
02:000499BA 65C4            	  7252:     blo     _L_z07_P47_fb_loop
                            	  7253:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7254:     ; rather than looping).
02:000499BC 197C00480525    	  7255:     move.b  #$48,($0525,A4)
                            	  7256: _L_z07_P47_post2_ok:
                            	  7257:     ; Extract and set the monster's location.
                            	  7258:     ;
02:000499C2 102C0525        	  7259:     move.b  ($0525,A4),D0
                            	  7260:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7261:     ;
02:000499C6 1B00            	  7262:     move.b  D0,-(A5)  ; PHA
02:000499C8 E308            	  7263:     lsl.b  #1,D0   ; ASL A
02:000499CA E308            	  7264:     lsl.b  #1,D0   ; ASL A
02:000499CC E308            	  7265:     lsl.b  #1,D0   ; ASL A
02:000499CE E308            	  7266:     lsl.b  #1,D0   ; ASL A
02:000499D0 19802070        	  7267:     move.b  D0,($70,A4,D2.W)
                            	  7268:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7269:     ;
02:000499D4 101D            	  7270:     move.b  (A5)+,D0  ; PLA
02:000499D6 020000F0        	  7271:     andi.b #$F0,D0
02:000499DA 003C0011        	  7272:     ori     #$11,CCR  ; SEC: set C+X
02:000499DE 123C0003        	  7273:     move.b  #$03,D1
02:000499E2 0A3C0010        	  7274:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000499E6 9101            	  7275:     subx.b  D1,D0   ; SBC #$03
02:000499E8 0A3C0010        	  7276:     eori    #$10,CCR  ; restore X = 6502 C
02:000499EC 41EC0084        	  7277:     lea     ($0084,A4),A0
02:000499F0 11802000        	  7278:     move.b  D0,(A0,D2.W)
                            	  7279:     ; Set the monsters-from-edges long timer to a random value
                            	  7280:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7281:     ;
02:000499F4 10342019        	  7282:     move.b  ($19,A4,D2.W),D0
02:000499F8 02000003        	  7283:     andi.b #$03,D0
02:000499FC 023C00EE        	  7284:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A00 123C0002        	  7285:     move.b  #$02,D1
02:00049A04 D101            	  7286:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049A06 1940004B        	  7287:     move.b  D0,($004B,A4)
                            	  7288:     ; If the distance to Link is too close to Link, then
                            	  7289:     ; go flag the monster uninitialized again, so we can
                            	  7290:     ; try to spawn it again next time.
                            	  7291:     ;
02:00049A0A 7005            	  7292:     moveq   #5,D0
02:00049A0C 61000414        	  7293:     jsr     SwitchBank
02:00049A10 4EB90003DE40    	  7294:     jsr     IsDistanceSafeToSpawn
02:00049A16 6500FEB4        	  7295:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7296:     ; OK to spawn.
                            	  7297:     ; In this situation, monsters don't spawn from a cloud.
                            	  7298:     ;
02:00049A1A 7000            	  7299:     moveq   #0,D0
02:00049A1C 41EC0405        	  7300:     lea     ($0405,A4),A0
02:00049A20 11802000        	  7301:     move.b  D0,(A0,D2.W)
                            	  7302:     even
                            	  7303: _L_z07_InitObject_NormalSpawn:
02:00049A24 7004            	  7304:     moveq   #4,D0
02:00049A26 610003FA        	  7305:     jsr     SwitchBank
                            	  7306:     ; For monsters that spawn in a cloud, set their start time to
                            	  7307:     ; the same value as the object slot; so that they all start
                            	  7308:     ; moving at different times.
                            	  7309:     ;
02:00049A2A 7400            	  7310:     moveq   #0,D2
02:00049A2C 142C0340        	  7311:     move.b  ($0340,A4),D2
02:00049A30 7600            	  7312:     moveq   #0,D3
02:00049A32 41EC034F        	  7313:     lea     ($034F,A4),A0
02:00049A36 16302000        	  7314:     move.b  (A0,D2.W),D3
02:00049A3A 0C03001E        	  7315:     cmpi.b  #$1E,D3
02:00049A3E 6712            	  7316:     beq  _L_z07_InitObject_FetchAttrs
02:00049A40 0C030022        	  7317:     cmpi.b  #$22,D3
02:00049A44 670C            	  7318:     beq  _L_z07_InitObject_FetchAttrs
02:00049A46 0C030053        	  7319:     cmpi.b  #$53,D3
02:00049A4A 6406            	  7320:     bcc  _L_z07_InitObject_FetchAttrs
02:00049A4C 1002            	  7321:     move.b  D2,D0
02:00049A4E 19802028        	  7322:     move.b  D0,($28,A4,D2.W)
                            	  7323:     even
                            	  7324: _L_z07_InitObject_FetchAttrs:
                            	  7325:     ; Store the object attributes for fast access.
