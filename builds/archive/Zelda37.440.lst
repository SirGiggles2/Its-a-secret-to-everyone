                            	  8481:     ; Exclude rooms that are not part of this level, and certain rooms
                            	  8482:     ; that should never be marked visited in the submenu map.
                            	  8483:     ;
                            	  8484:     ; First calculate the map row:
                            	  8485:     ; ((current menu scrolling value) / 2) - $D
                            	  8486:     ;
