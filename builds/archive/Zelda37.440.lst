02:0002F552 41F90002F502    	   832:     lea     (DemoPatternBlockSizes).l,A0
02:0002F558 10302000        	   833:     move.b  (A0,D2.W),D0
02:0002F55C 19400003        	   834:     move.b  D0,($0003,A4)
02:0002F560 41F90002F506    	   835:     lea     (DemoPatternVramAddrs).l,A0
