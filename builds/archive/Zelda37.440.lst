02:00047622 19400002        	  2320:     move.b  D0,($0002,A4)
02:00047626 4EB900030B06    	  2321:     jsr     MapScreenPosToPpuAddr
02:0004762C 7400            	  2322:     moveq   #0,D2
02:0004762E 142C0301        	  2323:     move.b  ($0301,A4),D2
                            	  2324:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2325:     ;
                            	  2326:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2327:     ; In total, 11 bytes will be written.
                            	  2328:     ;
                            	  2329:     ; First, write the high byte of PPU address in each record.
                            	  2330:     ;
02:00047632 1014            	  2331:     move.b  ($0000,A4),D0
02:00047634 41EC0302        	  2332:     lea     ($0302,A4),A0
02:00047638 11802000        	  2333:     move.b  D0,(A0,D2.W)
02:0004763C 41EC0307        	  2334:     lea     ($0307,A4),A0
02:00047640 11802000        	  2335:     move.b  D0,(A0,D2.W)
                            	  2336:     ; Write the low address in the first record. In the second record,
                            	  2337:     ; write (low address + 1).
                            	  2338:     ;
02:00047644 102C0001        	  2339:     move.b  ($0001,A4),D0
02:00047648 41EC0303        	  2340:     lea     ($0303,A4),A0
02:0004764C 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:00047650 41EC0308        	  2342:     lea     ($0308,A4),A0
02:00047654 11802000        	  2343:     move.b  D0,(A0,D2.W)
02:00047658 41EC0308        	  2344:     lea     ($0308,A4),A0
02:0004765C 52302000        	  2345:     addq.b  #1,(A0,D2.W)
                            	  2346:     ; Write the first tile twice in each record. Patch them later.
                            	  2347:     ;
02:00047660 102C0005        	  2348:     move.b  ($0005,A4),D0
02:00047664 41EC0305        	  2349:     lea     ($0305,A4),A0
02:00047668 11802000        	  2350:     move.b  D0,(A0,D2.W)
02:0004766C 41EC0306        	  2351:     lea     ($0306,A4),A0
02:00047670 11802000        	  2352:     move.b  D0,(A0,D2.W)
02:00047674 41EC030A        	  2353:     lea     ($030A,A4),A0
02:00047678 11802000        	  2354:     move.b  D0,(A0,D2.W)
02:0004767C 41EC030B        	  2355:     lea     ($030B,A4),A0
02:00047680 11802000        	  2356:     move.b  D0,(A0,D2.W)
                            	  2357:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2358:     ; Add 1 more to the second byte in each record.
                            	  2359:     ; Here is an example result of this manipulation:
                            	  2360:     ;   record 1: $70, $71
                            	  2361:     ;   record 2: $72, $73
                            	  2362:     ;
02:00047684 0C000046        	  2363:     cmpi.b  #$46,D0
02:00047688 6530            	  2364:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004768A 0C0000F3        	  2365:     cmpi.b  #$F3,D0
02:0004768E 642A            	  2366:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047690 023C00EE        	  2367:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047694 123C0002        	  2368:     move.b  #$02,D1
02:00047698 D101            	  2369:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004769A 41EC030A        	  2370:     lea     ($030A,A4),A0
02:0004769E 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:000476A2 41EC030B        	  2372:     lea     ($030B,A4),A0
02:000476A6 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:000476AA 41EC0306        	  2374:     lea     ($0306,A4),A0
02:000476AE 52302000        	  2375:     addq.b  #1,(A0,D2.W)
02:000476B2 41EC030B        	  2376:     lea     ($030B,A4),A0
02:000476B6 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     even
                            	  2379: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2380:     ; Set the count byte in each record to $82:
                            	  2381:     ; 2 tiles arranged vertically
                            	  2382:     ;
02:000476BA 103C0082        	  2383:     move.b  #$82,D0
02:000476BE 41EC0304        	  2384:     lea     ($0304,A4),A0
02:000476C2 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:000476C6 41EC0309        	  2386:     lea     ($0309,A4),A0
