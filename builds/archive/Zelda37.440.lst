02:0003A444 0003A454        	  4980:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A448 0003A454        	  4981:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A44C 0003A4EC        	  4982:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A450 0003A4F2        	  4983:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
