                            	  7139: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7140:     ; If the "monsters from edges" long timer expired, then
                            	  7141:     ; go bring the monster in.
                            	  7142:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7143:     ;
                            	  7144:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7145:     ; residual position so enemies keep their previous-room
                            	  7146:     ; positions instead of being re-edge-spawned (matches NES).
02:000498CC 102C004B        	  7147:     move.b  ($004B,A4),D0
02:000498D0 662E            	  7148:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7149:     ; timer == 0. Check for fresh room-entry + residual position.
02:000498D2 102C000F        	  7150:     move.b  ($000F,A4),D0
02:000498D6 0C0000FF        	  7151:     cmpi.b  #$FF,D0
02:000498DA 662E            	  7152:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:000498DC 41EC0070        	  7153:     lea     ($0070,A4),A0
02:000498E0 10302000        	  7154:     move.b  (A0,D2.W),D0
02:000498E4 660A            	  7155:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:000498E6 41EC0084        	  7156:     lea     ($0084,A4),A0
02:000498EA 10302000        	  7157:     move.b  (A0,D2.W),D0
02:000498EE 671A            	  7158:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7159:     even
