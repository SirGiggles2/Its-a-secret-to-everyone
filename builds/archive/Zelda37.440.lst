02:0003E614 0C00000C        	  3198:     cmpi.b  #$0C,D0
02:0003E618 6704            	  3199:     beq.s  __far_z_05_0059
02:0003E61A 60000082        	  3200:     jmp  CheckCaveEdge
                            	  3201: __far_z_05_0059:
                            	  3202:     ; In a shortcut cave (mode $C).
                            	  3203:     ;
                            	  3204:     ; If grid offset <> 0, return.
