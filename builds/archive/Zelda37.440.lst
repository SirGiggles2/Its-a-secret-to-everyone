02:0003E61E 102C0394        	  3206:     move.b  ($0394,A4),D0
02:0003E622 6702            	  3207:     beq.s  __far_z_05_0060
02:0003E624 6076            	  3208:     jmp  L14F72_Exit
                            	  3209: __far_z_05_0060:
                            	  3210:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3211:     ;
02:0003E626 102C0084        	  3212:     move.b  ($0084,A4),D0
02:0003E62A 0C00009D        	  3213:     cmpi.b  #$9D,D0
02:0003E62E 6702            	  3214:     beq.s  __far_z_05_0061
02:0003E630 606C            	  3215:     jmp  CheckCaveEdge
                            	  3216: __far_z_05_0061:
                            	  3217:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3218:     ; X = $50: 1
                            	  3219:     ; X = $80: 2
                            	  3220:     ; X = $B0: 3
                            	  3221:     ;
                            	  3222:     ; If he's not on any, then return.
                            	  3223:     ;
02:0003E632 7601            	  3224:     moveq   #1,D3
02:0003E634 102C0070        	  3225:     move.b  ($0070,A4),D0
02:0003E638 0C000050        	  3226:     cmpi.b  #$50,D0
02:0003E63C 6712            	  3227:     beq  _anon_z05_83
02:0003E63E 5203            	  3228:     addq.b  #1,D3
02:0003E640 0C000080        	  3229:     cmpi.b  #$80,D0
02:0003E644 670A            	  3230:     beq  _anon_z05_83
02:0003E646 5203            	  3231:     addq.b  #1,D3
02:0003E648 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:0003E64C 6702            	  3233:     beq.s  __far_z_05_0062
02:0003E64E 604C            	  3234:     jmp  L14F72_Exit
                            	  3235: __far_z_05_0062:
                            	  3236: _anon_z05_83:
                            	  3237:     ; Look for the current room in the cellar/shortcut room array.
                            	  3238:     ;
02:0003E650 1883            	  3239:     move.b  D3,($0000,A4)
02:0003E652 163C00FF        	  3240:     move.b  #$FF,D3
02:0003E656 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:0003E65A 5203            	  3243:     addq.b  #1,D3
02:0003E65C 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E662 12303000        	  3245:     move.b  (A0,D3.W),D1
02:0003E666 B001            	  3246:     cmp.b   D1,D0
02:0003E668 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:0003E66A 1003            	  3254:     move.b  D3,D0
02:0003E66C 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E670 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E672 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E674 02000003        	  3260:     andi.b #$03,D0
02:0003E678 7600            	  3261:     moveq   #0,D3
02:0003E67A 1600            	  3262:     move.b  D0,D3
02:0003E67C 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E682 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
                            	  3269: GoToModeAFromCellar:
02:0003E686 194000EB        	  3270:     move.b  D0,($00EB,A4)
02:0003E68A 4EB900047360    	  3271:     jsr     MarkRoomVisited
                            	  3272:     even
