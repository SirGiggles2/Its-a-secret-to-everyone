02:0003A8E0 10302000        	  5576:     move.b  (A0,D2.W),D0
02:0003A8E4 4EB900030D60    	  5577:     jsr     DrawObjectMirrored
                            	  5578:     ; Check collisions. If Link was not captured, then return.
                            	  5579:     ;
02:0003A8EA 4EB9000310D0    	  5580:     jsr     CheckMonsterCollisions
02:0003A8F0 41EC042C        	  5581:     lea     ($042C,A4),A0
