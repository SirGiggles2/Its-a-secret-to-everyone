                            	  4279:     even
                            	  4280: UpdateZeldaTextbox:
02:00034D1E 4EB90004848E    	  4281:     jsr     Link_EndMoveAndDraw
                            	  4282:     ; If Zelda's timer has not expired, then return.
                            	  4283:     ;
02:00034D24 102C0029        	  4284:     move.b  ($0029,A4),D0
02:00034D28 6704            	  4285:     beq.s  __far_z_02_0004
02:00034D2A 600000C6        	  4286:     jmp  LA9F4_Exit
                            	  4287: __far_z_02_0004:
                            	  4288:     ; Set the timer to wait 6 frames after the next character about
                            	  4289:     ; to be shown.
                            	  4290:     ;
02:00034D2E 7006            	  4291:     moveq   #6,D0
02:00034D30 19400029        	  4292:     move.b  D0,($0029,A4)
                            	  4293:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4294:     ; to the dynamic transfer buf.
                            	  4295:     ;
02:00034D34 7604            	  4296:     moveq   #4,D3
                            	  4297: _anon_z02_31:
02:00034D36 41F900034D14    	  4298:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034D3C 10303000        	  4299:     move.b  (A0,D3.W),D0
02:00034D40 41EC0302        	  4300:     lea     ($0302,A4),A0
02:00034D44 11803000        	  4301:     move.b  D0,(A0,D3.W)
02:00034D48 5303            	  4302:     subq.b  #1,D3
02:00034D4A 6AEA            	  4303:     bpl  _anon_z02_31
                            	  4304: _anon_z02_32:
                            	  4305:     ; Replace the low byte of the VRAM address with the one
                            	  4306:     ; where the next character should be written.
                            	  4307:     ;
02:00034D4C 102C045F        	  4308:     move.b  ($045F,A4),D0
02:00034D50 19400303        	  4309:     move.b  D0,($0303,A4)
                            	  4310:     ; Increment the low VRAM address for the next character.
                            	  4311:     ;
02:00034D54 522C045F        	  4312:     addq.b  #1,($045F,A4)
02:00034D58 7000            	  4313:     moveq   #0,D0
02:00034D5A 1880            	  4314:     move.b  D0,($0000,A4)
02:00034D5C 7000            	  4315:     moveq   #0,D0
02:00034D5E 19400001        	  4316:     move.b  D0,($0001,A4)
                            	  4317:     ; Load the person text current character index.
                            	  4318:     ;
02:00034D62 7600            	  4319:     moveq   #0,D3
02:00034D64 162C0416        	  4320:     move.b  ($0416,A4),D3
                            	  4321:     ; Increment the index variable to point to the next character
                            	  4322:     ; for the next time.
                            	  4323:     ;
02:00034D68 522C0416        	  4324:     addq.b  #1,($0416,A4)
                            	  4325:     ; Get the current character.
                            	  4326:     ;
02:00034D6C 1214            	  4327:     move.b  ($00,A4),D1   ; ptr lo
02:00034D6E 182C0001        	  4328:     move.b  ($01,A4),D4  ; ptr hi
02:00034D72 024100FF        	  4329:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034D76 E14C            	  4330:     lsl.w   #8,D4
02:00034D78 8841            	  4331:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034D7A 48C4            	  4332:     ext.l   D4
02:00034D7C D8BC00FF0000    	  4333:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034D82 2044            	  4334:     movea.l D4,A0
02:00034D84 10303000        	  4335:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4336:     ; If the character is $25, then it's a special space. It will still
                            	  4337:     ; take up space, but will not take time to show -- meaning that
                            	  4338:     ; we'll go look up the next character to transfer.
                            	  4339:     ;
02:00034D88 0200003F        	  4340:     andi.b #$3F,D0
02:00034D8C 0C000025        	  4341:     cmpi.b  #$25,D0
02:00034D90 67BA            	  4342:     beq  _anon_z02_32
                            	  4343:     ; We have a non-space character. Put it in the transfer record.
                            	  4344:     ;
02:00034D92 19400305        	  4345:     move.b  D0,($0305,A4)
                            	  4346:     ; Play the "heart taken/character" tune.
                            	  4347:     ;
02:00034D96 7010            	  4348:     moveq   #16,D0
02:00034D98 19400604        	  4349:     move.b  D0,($0604,A4)
                            	  4350:     ; If the high 2 bits of character element = 0, then return.
                            	  4351:     ;
02:00034D9C 1214            	  4352:     move.b  ($00,A4),D1   ; ptr lo
02:00034D9E 182C0001        	  4353:     move.b  ($01,A4),D4  ; ptr hi
02:00034DA2 024100FF        	  4354:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034DA6 E14C            	  4355:     lsl.w   #8,D4
02:00034DA8 8841            	  4356:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034DAA 48C4            	  4357:     ext.l   D4
02:00034DAC D8BC00FF0000    	  4358:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034DB2 2044            	  4359:     movea.l D4,A0
02:00034DB4 10303000        	  4360:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034DB8 020000C0        	  4361:     andi.b #$C0,D0
02:00034DBC 6602            	  4362:     bne.s  __far_z_02_0005
02:00034DBE 6032            	  4363:     jmp  LA9F4_Exit
                            	  4364: __far_z_02_0005:
                            	  4365:     ; Determine an index based on the high 2 bits of the character element:
                            	  4366:     ;   $80: 0
                            	  4367:     ;   $40: 1
                            	  4368:     ;   $C0: 2
                            	  4369:     ;
02:00034DC0 7602            	  4370:     moveq   #2,D3
02:00034DC2 0C0000C0        	  4371:     cmpi.b  #$C0,D0
02:00034DC6 670A            	  4372:     beq  _anon_z02_33
02:00034DC8 5303            	  4373:     subq.b  #1,D3
02:00034DCA 0C000040        	  4374:     cmpi.b  #$40,D0
02:00034DCE 6702            	  4375:     beq  _anon_z02_33
02:00034DD0 5303            	  4376:     subq.b  #1,D3
                            	  4377: _anon_z02_33:
                            	  4378:     ; The index chooses the low VRAM address of the start
                            	  4379:     ; of another line:
                            	  4380:     ;   0: $C4: front of the second line
                            	  4381:     ;   1: $E4: front of the third line
                            	  4382:     ;   2: $A4: front of the first line
                            	  4383:     ;
02:00034DD2 41F900034D1A    	  4384:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034DD8 10303000        	  4385:     move.b  (A0,D3.W),D0
02:00034DDC 1940045F        	  4386:     move.b  D0,($045F,A4)
                            	  4387:     ; If index = 2, then we've reached the end of the text,
                            	  4388:     ; and low VRAM address is moved to the front of the first line.
                            	  4389:     ; So, advance the state of the person object, and unhalt Link.
                            	  4390:     ;
02:00034DE0 0C030002        	  4391:     cmpi.b  #$02,D3
02:00034DE4 6702            	  4392:     beq.s  __far_z_02_0006
02:00034DE6 600A            	  4393:     jmp  LA9F4_Exit
