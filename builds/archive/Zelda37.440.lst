02:0003EAD2 41F90003EA58    	  3915:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EAD8 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003EADC B001            	  3917:     cmp.b   D1,D0
