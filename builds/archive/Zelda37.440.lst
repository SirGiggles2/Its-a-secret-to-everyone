                            	  5677: CalcBoomerangFrame:
                            	  5678:     ; The minor state (low 3 bits of state) is used to
                            	  5679:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5680:     ;
                            	  5681:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5682:     ; In other words, don't offset the coordinate below.
                            	  5683:     ;
02:00048D72 7000            	  5684:     moveq   #0,D0
02:00048D74 1880            	  5685:     move.b  D0,($0000,A4)
02:00048D76 41EC00AC        	  5686:     lea     ($00AC,A4),A0
02:00048D7A 10302000        	  5687:     move.b  (A0,D2.W),D0
02:00048D7E 0200000F        	  5688:     andi.b #$0F,D0
02:00048D82 7600            	  5689:     moveq   #0,D3
02:00048D84 1600            	  5690:     move.b  D0,D3
02:00048D86 7000            	  5691:     moveq   #0,D0
02:00048D88 19400001        	  5692:     move.b  D0,($0001,A4)
02:00048D8C 41F90004897A    	  5693:     lea     (BoomerangFrameCycle).l,A0
02:00048D92 10303000        	  5694:     move.b  (A0,D3.W),D0
02:00048D96 1940000C        	  5695:     move.b  D0,($000C,A4)
                            	  5696:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5697:     ;
02:00048D9A 1003            	  5698:     move.b  D3,D0
02:00048D9C 41F900048984    	  5699:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:00048DA2 10303000        	  5700:     move.b  (A0,D3.W),D0
02:00048DA6 19400004        	  5701:     move.b  D0,($0004,A4)
                            	  5702:     ; TODO: ?
                            	  5703:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5704:     ; Else add the item value of the magic boomerang.
                            	  5705:     ;
                            	  5706:     ; But none of the values in the base sprite attributes array is 8.
                            	  5707:     ;
                            	  5708:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5709:     ; the inventory will always be added to the base sprite attribute.
                            	  5710:     ;
                            	  5711:     ; So, palette row 4 or 5 will be chosen.
                            	  5712:     ;
02:00048DAA 7600            	  5713:     moveq   #0,D3
02:00048DAC 0C000008        	  5714:     cmpi.b  #$08,D0
02:00048DB0 6706            	  5715:     beq  _anon_z07_31
02:00048DB2 7600            	  5716:     moveq   #0,D3
02:00048DB4 162C0675        	  5717:     move.b  ($0675,A4),D3
