02:0003A274 0C000055        	  4732:     cmpi.b  #$55,D0
02:0003A278 6626            	  4733:     bne  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  4734:     ; Every other screen frame, loop again.
