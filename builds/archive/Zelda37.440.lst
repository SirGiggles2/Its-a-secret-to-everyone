02:0003A8B8 11802000        	  5561:     move.b  D0,(A0,D2.W)
02:0003A8BC 7600            	  5562:     moveq   #0,D3
02:0003A8BE 41EC03E4        	  5563:     lea     ($03E4,A4),A0
02:0003A8C2 16302000        	  5564:     move.b  (A0,D2.W),D3
