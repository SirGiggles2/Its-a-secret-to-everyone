02:00039568 7060            	  2992:     moveq   #96,D0
                            	  2993: _anon_z04_57:
                            	  2994:     ; If the player is not aligned with the dock, return.
                            	  2995:     ;
02:0003956A 122C0070        	  2996:     move.b  ($0070,A4),D1
02:0003956E B001            	  2997:     cmp.b   D1,D0
02:00039570 664A            	  2998:     bne  _L_z04_UpdateDock_Exit
                            	  2999:     ; Set the dock object's X.
                            	  3000:     ;
02:00039572 19802070        	  3001:     move.b  D0,($70,A4,D2.W)
                            	  3002:     ; Determine whether Link is coming or going.
                            	  3003:     ; If Y = $3D, then he's at the top edge of the screen. Use state 1.
                            	  3004:     ;
02:00039576 7601            	  3005:     moveq   #1,D3
02:00039578 102C0084        	  3006:     move.b  ($0084,A4),D0
02:0003957C 0C00003D        	  3007:     cmpi.b  #$3D,D0
02:00039580 6708            	  3008:     beq  _L_z04_UpdateDock_SetState
                            	  3009:     ; But if Y = $7D, then he's at the dock. Use state 2.
                            	  3010:     ; Otherwise, return.
                            	  3011:     ;
02:00039582 5203            	  3012:     addq.b  #1,D3
02:00039584 0C00007D        	  3013:     cmpi.b  #$7D,D0
02:00039588 6632            	  3014:     bne  _L_z04_UpdateDock_Exit
                            	  3015:     even
