02:00035014 19400604        	  4639:     move.b  D0,($0604,A4)
                            	  4640: _anon_z02_36:
                            	  4641:     ; Point to the next character in the string.
                            	  4642:     ;
02:00035018 522C0413        	  4643:     addq.b  #1,($0413,A4)
                            	  4644:     ; Replace the low byte of the VRAM address with the one
                            	  4645:     ; where the next character should be written.
                            	  4646:     ;
02:0003501C 41F900034F5E    	  4647:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00035022 10303000        	  4648:     move.b  (A0,D3.W),D0
02:00035026 19400303        	  4649:     move.b  D0,($0303,A4)
                            	  4650:     ; Once the low VRAM address rolls over,
                            	  4651:     ; increment the high address.
