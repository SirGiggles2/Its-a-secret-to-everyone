02:0003951C 10303000        	  2943:     move.b  (A0,D3.W),D0
02:00039520 023C00EE        	  2944:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039524 123C0008        	  2945:     move.b  #$08,D1
02:00039528 D101            	  2946:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
