02:0003880E 10343018        	  1028:     move.b  ($18,A4,D3.W),D0
02:00038812 020000F0        	  1029:     andi.b #$F0,D0
02:00038816 19802070        	  1030:     move.b  D0,($70,A4,D2.W)
02:0003881A 6748            	  1031:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003881C 0C0000F0        	  1032:     cmpi.b  #$F0,D0
02:00038820 6742            	  1033:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1034:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1035:     ; If it < $50 or >= $E0, go loop again.
                            	  1036:     ;
02:00038822 10343018        	  1037:     move.b  ($18,A4,D3.W),D0
02:00038826 E308            	  1038:     lsl.b  #1,D0   ; ASL A
02:00038828 E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:0003882A E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:0003882C E308            	  1041:     lsl.b  #1,D0   ; ASL A
02:0003882E 0C000050        	  1042:     cmpi.b  #$50,D0
02:00038832 6530            	  1043:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038834 0C0000E0        	  1044:     cmpi.b  #$E0,D0
02:00038838 642A            	  1045:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1046:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
