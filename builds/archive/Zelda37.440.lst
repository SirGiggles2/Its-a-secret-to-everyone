                            	   255: _anon_z04_7:
                            	   256:     ; If speed = 0, or the object is between squares;
                            	   257:     ; then go set input direction to facing direction.
                            	   258:     ;
02:00038298 41EC03BC        	   259:     lea     ($03BC,A4),A0
02:0003829C 10302000        	   260:     move.b  (A0,D2.W),D0
02:000382A0 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:000382A4 41EC0394        	   262:     lea     ($0394,A4),A0
02:000382A8 10302000        	   263:     move.b  (A0,D2.W),D0
02:000382AC 0200000F        	   264:     andi.b #$0F,D0
02:000382B0 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:000382B4 41EC0394        	   268:     lea     ($0394,A4),A0
02:000382B8 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:000382BC 41EC041F        	   273:     lea     ($041F,A4),A0
02:000382C0 10302000        	   274:     move.b  (A0,D2.W),D0
02:000382C4 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:000382C8 B001            	   276:     cmp.b   D1,D0
02:000382CA 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:000382CE 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:000382D2 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:000382D6 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:000382DA 102C0061        	   284:     move.b  ($0061,A4),D0
02:000382DE 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:000382E2 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:000382E6 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000382EA 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:000382EC 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:000382F0 6A0C            	   290:     bpl  _anon_z04_8
02:000382F2 4600            	   291:     eori.b #$FF,D0
02:000382F4 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:000382F8 123C0001        	   293:     move.b  #$01,D1
02:000382FC D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
                            	   297:     ;
02:000382FE 0C000009        	   298:     cmpi.b  #$09,D0
02:00038302 6416            	   299:     bcc  _L_z04_Exit_CheckVerticalDistance
                            	   300:     even
                            	   301: _L_z04_Exit_TurnVertically:
                            	   302:     ; Choose a vertical direction toward the chase target.
                            	   303:     ; Then go face in this direction, and flag to shoot.
                            	   304:     ;
02:00038304 7608            	   305:     moveq   #8,D3
02:00038306 102C0062        	   306:     move.b  ($0062,A4),D0
02:0003830A 41EC0084        	   307:     lea     ($0084,A4),A0
02:0003830E 12302000        	   308:     move.b  (A0,D2.W),D1
02:00038312 B001            	   309:     cmp.b   D1,D0
02:00038314 6542            	   310:     bcs  _L_z04_Exit_SetDirTowardTarget
02:00038316 7604            	   311:     moveq   #4,D3
02:00038318 663E            	   312:     bne  _L_z04_Exit_SetDirTowardTarget
                            	   313:     even
                            	   314: _L_z04_Exit_CheckVerticalDistance:
                            	   315:     ; Get the absolute vertical distance between
                            	   316:     ; the monster and the chase target.
                            	   317:     ;
02:0003831A 102C0062        	   318:     move.b  ($0062,A4),D0
02:0003831E 003C0011        	   319:     ori     #$11,CCR  ; SEC: set C+X
02:00038322 41EC0084        	   320:     lea     ($0084,A4),A0
02:00038326 12302000        	   321:     move.b  (A0,D2.W),D1
02:0003832A 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003832E 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:00038330 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
02:00038334 6A0C            	   325:     bpl  _anon_z04_9
02:00038336 4600            	   326:     eori.b #$FF,D0
02:00038338 023C00EE        	   327:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003833C 123C0001        	   328:     move.b  #$01,D1
02:00038340 D101            	   329:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   330: _anon_z04_9:
                            	   331:     ; If distance >= 9, then go turn if turn timer has expired.
                            	   332:     ;
02:00038342 0C000009        	   333:     cmpi.b  #$09,D0
02:00038346 6430            	   334:     bcc  _L_z04_Exit_TurnIfTime
                            	   335:     even
                            	   336: _L_z04_Exit_TurnHorizontally:
                            	   337:     ; Choose a horizontal direction toward the chase target.
                            	   338:     ;
02:00038348 7601            	   339:     moveq   #1,D3
02:0003834A 102C0061        	   340:     move.b  ($0061,A4),D0
02:0003834E 12342070        	   341:     move.b  ($70,A4,D2.W),D1
02:00038352 B001            	   342:     cmp.b   D1,D0
02:00038354 6402            	   343:     bcc  _L_z04_Exit_SetDirTowardTarget
02:00038356 5203            	   344:     addq.b  #1,D3
                            	   345:     even
                            	   346: _L_z04_Exit_SetDirTowardTarget:
                            	   347:     ; Set the monster's facing direction to the chosen direction
                            	   348:     ; toward the chase target.
                            	   349:     ;
02:00038358 41EC0098        	   350:     lea     ($0098,A4),A0
02:0003835C 11832000        	   351:     move.b  D3,(A0,D2.W)
                            	   352:     ; Set turn timer to a random value.
                            	   353:     ;
02:00038360 10342018        	   354:     move.b  ($18,A4,D2.W),D0
02:00038364 41EC0478        	   355:     lea     ($0478,A4),A0
02:00038368 11802000        	   356:     move.b  D0,(A0,D2.W)
                            	   357:     ; Set "wants to shoot" flag to 1.
                            	   358:     ;
02:0003836C 7001            	   359:     moveq   #1,D0
02:0003836E 41EC0412        	   360:     lea     ($0412,A4),A0
02:00038372 11802000        	   361:     move.b  D0,(A0,D2.W)
                            	   362:     ; Go set input direction to facing direction.
                            	   363:     ;
02:00038376 602E            	   364:     jmp     L_Walker_SetInputDirAndTryShootingBoomerang
                            	   365: 
                            	   366:     even
                            	   367: _L_z04_Exit_TurnIfTime:
                            	   368:     ; Reset "wants to shoot" flag.
                            	   369:     ;
02:00038378 7000            	   370:     moveq   #0,D0
02:0003837A 41EC0412        	   371:     lea     ($0412,A4),A0
02:0003837E 11802000        	   372:     move.b  D0,(A0,D2.W)
                            	   373:     ; If turn timer <> 0, then go set input direction to facing direction.
                            	   374:     ;
02:00038382 41EC0478        	   375:     lea     ($0478,A4),A0
02:00038386 10302000        	   376:     move.b  (A0,D2.W),D0
02:0003838A 6612            	   377:     bne  _L_z04_Exit_SetInputDir
                            	   378:     ; Turn toward the chase target in a direction perpendicular to
                            	   379:     ; facing direction.
                            	   380:     ;
                            	   381:     ; If facing vertically, then go choose a horizontal direction
                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:0003838C 41EC0098        	   386:     lea     ($0098,A4),A0
02:00038390 10302000        	   387:     move.b  (A0,D2.W),D0
02:00038394 0200000C        	   388:     andi.b #$0C,D0
02:00038398 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
02:0003839A 6700FF68        	   390:     beq  _L_z04_Exit_TurnVertically
                            	   391:     even
                            	   392: _L_z04_Exit_SetInputDir:
02:0003839E 6006            	   393:     jmp     L_Walker_SetInputDirAndTryShootingBoomerang
                            	   394: 
                            	   395:     even
                            	   396: UpdateGoriya:
02:000383A0 4EF90002D038    	   397:     jmp     c_update_goriya
                            	   398: 
                            	   399: L_Walker_SetInputDirAndTryShootingBoomerang:
                            	   400:     ; Set the input direction to the facing direction.
                            	   401:     ;
02:000383A6 41EC0098        	   402:     lea     ($0098,A4),A0
02:000383AA 10302000        	   403:     move.b  (A0,D2.W),D0
02:000383AE 41EC03F8        	   404:     lea     ($03F8,A4),A0
02:000383B2 11802000        	   405:     move.b  D0,(A0,D2.W)
                            	   406:     ; Goriya will throw a boomerang (object type $5C).
                            	   407:     ;
02:000383B6 705C            	   408:     moveq   #92,D0
                            	   409:     ; If the monster is a blue goriya, go check the timer.
                            	   410:     ;
02:000383B8 7600            	   411:     moveq   #0,D3
02:000383BA 41EC034F        	   412:     lea     ($034F,A4),A0
02:000383BE 16302000        	   413:     move.b  (A0,D2.W),D3
02:000383C2 0C030005        	   414:     cmpi.b  #$05,D3
02:000383C6 671C            	   415:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   416:     ; If it's not a red goriya either, then return.
                            	   417:     ;
02:000383C8 0C030006        	   418:     cmpi.b  #$06,D3
02:000383CC 660000A0        	   419:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   420:     ; If a random value <> $23 nor $77, then return.
                            	   421:     ;
02:000383D0 10342018        	   422:     move.b  ($18,A4,D2.W),D0
02:000383D4 0C000023        	   423:     cmpi.b  #$23,D0
02:000383D8 6708            	   424:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:000383DA 0C000077        	   425:     cmpi.b  #$77,D0
02:000383DE 6600008E        	   426:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   427:     even
                            	   428: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang:
                            	   429:     ; Goriya will throw a boomerang (object type $5C).
                            	   430:     ;
02:000383E2 705C            	   431:     moveq   #92,D0
                            	   432:     even
                            	   433: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot:
                            	   434:     ; If object timer <> 0, return.
                            	   435:     ;
02:000383E4 7600            	   436:     moveq   #0,D3
02:000383E6 16342028        	   437:     move.b  ($28,A4,D2.W),D3
02:000383EA 66000082        	   438:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   439:     ; Store in [00] the type of projectile the monster will throw.
                            	   440:     ;
02:000383EE 1880            	   441:     move.b  D0,($0000,A4)
                            	   442:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   443:     ;
02:000383F0 102C066C        	   444:     move.b  ($066C,A4),D0
02:000383F4 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:000383F8 8001            	   446:     or.b  D1,D0
02:000383FA 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
                            	   449:     ;
02:000383FC 1014            	   450:     move.b  ($0000,A4),D0
02:000383FE 6100422E        	   451:     jsr     _ShootIfWanted
02:00038402 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:00038404 103C0080        	   455:     move.b  #$80,D0
02:00038408 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:0003840C 11802000        	   457:     move.b  D0,(A0,D2.W)
                            	   458:     ; Reset the "wants to shoot" flag.
                            	   459:     ;
02:00038410 7000            	   460:     moveq   #0,D0
02:00038412 41EC0412        	   461:     lea     ($0412,A4),A0
02:00038416 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
                            	   464:     ;
02:0003841A 1002            	   465:     move.b  D2,D0
02:0003841C 41EC042C        	   466:     lea     ($042C,A4),A0
02:00038420 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:00038424 1003            	   470:     move.b  D3,D0
02:00038426 41EC042C        	   471:     lea     ($042C,A4),A0
02:0003842A 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
02:0003842E 7010            	   475:     moveq   #16,D0
02:00038430 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:00038434 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   479:     ;
02:00038438 103C00A0        	   480:     move.b  #$A0,D0
02:0003843C 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:00038440 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:00038444 7051            	   485:     moveq   #81,D0
02:00038446 41EC0380        	   486:     lea     ($0380,A4),A0
02:0003844A 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
                            	   489:     ;
02:0003844E 7000            	   490:     moveq   #0,D0
02:00038450 41EC0405        	   491:     lea     ($0405,A4),A0
02:00038454 11803000        	   492:     move.b  D0,(A0,D3.W)
                            	   493:     ; The first animation frame lasts 3 screen frames.
                            	   494:     ;
02:00038458 7003            	   495:     moveq   #3,D0
02:0003845A 41EC03D0        	   496:     lea     ($03D0,A4),A0
02:0003845E 11803000        	   497:     move.b  D0,(A0,D3.W)
