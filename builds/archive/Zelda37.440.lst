                            	  4197:     ; Change the coordinates to one corner.
                            	  4198:     ;
02:00039E0C 10342070        	  4199:     move.b  ($70,A4,D2.W),D0
02:00039E10 023C00EE        	  4200:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E14 41F900039CC8    	  4201:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039E1A 12303000        	  4202:     move.b  (A0,D3.W),D1
02:00039E1E D101            	  4203:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:00039E20 19802070        	  4204:     move.b  D0,($70,A4,D2.W)
02:00039E24 41EC0084        	  4205:     lea     ($0084,A4),A0
02:00039E28 10302000        	  4206:     move.b  (A0,D2.W),D0
02:00039E2C 023C00EE        	  4207:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E30 41F900039CCC    	  4208:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039E36 12303000        	  4209:     move.b  (A0,D3.W),D1
02:00039E3A D101            	  4210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039E3C 41EC0084        	  4211:     lea     ($0084,A4),A0
02:00039E40 11802000        	  4212:     move.b  D0,(A0,D2.W)
                            	  4213:     ; Check the room boundary and object collisions in this temporary location.
                            	  4214:     ;
02:00039E44 610028FE        	  4215:     jsr     BoundFlyer
02:00039E48 4EB9000310D0    	  4216:     jsr     CheckMonsterCollisions
