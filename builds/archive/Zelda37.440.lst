02:000339EC 9101            	  2525:     subx.b  D1,D0   ; SBC #$08
02:000339EE 0A3C0010        	  2526:     eori    #$10,CCR  ; restore X = 6502 C
02:000339F2 7600            	  2527:     moveq   #0,D3
02:000339F4 1600            	  2528:     move.b  D0,D3
02:000339F6 102C0015        	  2529:     move.b  ($0015,A4),D0
