                            	  8831:     ; $1E is the cursor tile.
                            	  8832:     ;
02:00041D5E 701E            	  8833:     moveq   #30,D0
02:00041D60 1940021D        	  8834:     move.b  D0,($021D,A4)
02:00041D64 19400221        	  8835:     move.b  D0,($0221,A4)
                            	  8836:     ; Flash the cursor.
                            	  8837:     ; Use palette rows 5 and 6 for 8 frames each.
                            	  8838:     ;
02:00041D68 102C0015        	  8839:     move.b  ($0015,A4),D0
02:00041D6C 02000008        	  8840:     andi.b #$08,D0
02:00041D70 E208            	  8841:     lsr.b  #1,D0   ; LSR A
02:00041D72 E208            	  8842:     lsr.b  #1,D0   ; LSR A
02:00041D74 E208            	  8843:     lsr.b  #1,D0   ; LSR A
02:00041D76 123C0001        	  8844:     move.b  #$01,D1
02:00041D7A D101            	  8845:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00041D7C 1940021E        	  8846:     move.b  D0,($021E,A4)
                            	  8847:     ; Flip the right sprite horizontally.
                            	  8848:     ;
02:00041D80 00000040        	  8849:     ori.b #$40,D0
02:00041D84 19400222        	  8850:     move.b  D0,($0222,A4)
                            	  8851:     ; TODO:
                            	  8852:     ; If input direction = [EF] item search direction in the previous frame, return.
                            	  8853:     ;
02:00041D88 102C03F8        	  8854:     move.b  ($03F8,A4),D0
02:00041D8C 122C00EF        	  8855:     move.b  ($00EF,A4),D1
02:00041D90 B001            	  8856:     cmp.b   D1,D0
02:00041D92 6604            	  8857:     bne.s  __far_z_05_0104
02:00041D94 60000094        	  8858:     jmp  L177F1_Exit
                            	  8859: __far_z_05_0104:
02:00041D98 7400            	  8860:     moveq   #0,D2
02:00041D9A 1400            	  8861:     move.b  D0,D2
                            	  8862:     ; If input direction = 0, up, or down; then we won't change
                            	  8863:     ; the change the selected item slot forward or backward.
                            	  8864:     ;
                            	  8865:     ; Instead, jump to this routine to make sure an occupied slot
                            	  8866:     ; is selected, then return.
                            	  8867:     ;
02:00041D9C 6602            	  8868:     bne.s  __far_z_05_0105
02:00041D9E 6042            	  8869:     jmp  FindAndSelectOccupiedItemSlot
                            	  8870: __far_z_05_0105:
