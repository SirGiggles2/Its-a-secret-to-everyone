                            	  5857: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  5858:     ; Reset horizontal flipping in [0F].
                            	  5859:     ;
02:00048EC0 7000            	  5860:     moveq   #0,D0
02:00048EC2 1940000F        	  5861:     move.b  D0,($000F,A4)
                            	  5862:     ; If state = 5, return without drawing.
                            	  5863:     ;
02:00048EC6 41EC00AC        	  5864:     lea     ($00AC,A4),A0
02:00048ECA 10302000        	  5865:     move.b  (A0,D2.W),D0
02:00048ECE 0200000F        	  5866:     andi.b #$0F,D0
02:00048ED2 7600            	  5867:     moveq   #0,D3
02:00048ED4 1600            	  5868:     move.b  D0,D3
02:00048ED6 103C00FC        	  5869:     move.b  #$FC,D0
02:00048EDA 0C030005        	  5870:     cmpi.b  #$05,D3
02:00048EDE 67DE            	  5871:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5872:     even
                            	  5873: _L_z07_UpdateSwordOrRod_Add4:
                            	  5874:     ; Set [00] to (state - 1) * 4:
                            	  5875:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5876:     ;
02:00048EE0 023C00EE        	  5877:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048EE4 123C0004        	  5878:     move.b  #$04,D1
02:00048EE8 D101            	  5879:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048EEA 5303            	  5880:     subq.b  #1,D3
02:00048EEC 66F2            	  5881:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048EEE 1880            	  5882:     move.b  D0,($0000,A4)
                            	  5883:     ; Set object's direction to player's. It might have changed
                            	  5884:     ; since the last frame.
                            	  5885:     ;
02:00048EF0 102C0098        	  5886:     move.b  ($0098,A4),D0
02:00048EF4 41EC0098        	  5887:     lea     ($0098,A4),A0
02:00048EF8 11802000        	  5888:     move.b  D0,(A0,D2.W)
                            	  5889:     ; Add [00] and the reverse index of the direction to get
                            	  5890:     ; the byte offset of the pixel offset.
                            	  5891:     ;
02:00048EFC 4EB900030994    	  5892:     jsr     GetOppositeDir
02:00048F02 1003            	  5893:     move.b  D3,D0
02:00048F04 023C00EE        	  5894:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F08 1214            	  5895:     move.b  ($0000,A4),D1
02:00048F0A D101            	  5896:     addx.b  D1,D0   ; ADC $00
02:00048F0C 7600            	  5897:     moveq   #0,D3
02:00048F0E 1600            	  5898:     move.b  D0,D3
                            	  5899:     ; Set object's X to player's X + offset for state and direction.
                            	  5900:     ; Copy the result to [00].
                            	  5901:     ;
02:00048F10 102C0070        	  5902:     move.b  ($0070,A4),D0
02:00048F14 023C00EE        	  5903:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F18 41F900048E44    	  5904:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048F1E 12303000        	  5905:     move.b  (A0,D3.W),D1
02:00048F22 D101            	  5906:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048F24 19802070        	  5907:     move.b  D0,($70,A4,D2.W)
02:00048F28 1880            	  5908:     move.b  D0,($0000,A4)
                            	  5909:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5910:     ; Copy the result to [01].
                            	  5911:     ;
02:00048F2A 102C0084        	  5912:     move.b  ($0084,A4),D0
02:00048F2E 023C00EE        	  5913:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F32 41F900048E54    	  5914:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048F38 12303000        	  5915:     move.b  (A0,D3.W),D1
02:00048F3C D101            	  5916:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048F3E 41EC0084        	  5917:     lea     ($0084,A4),A0
02:00048F42 11802000        	  5918:     move.b  D0,(A0,D2.W)
02:00048F46 19400001        	  5919:     move.b  D0,($0001,A4)
                            	  5920:     ; If state = 1, use up direction.
                            	  5921:     ; Else use object direction.
                            	  5922:     ;
02:00048F4A 41EC00AC        	  5923:     lea     ($00AC,A4),A0
02:00048F4E 10302000        	  5924:     move.b  (A0,D2.W),D0
02:00048F52 0200000F        	  5925:     andi.b #$0F,D0
02:00048F56 7600            	  5926:     moveq   #0,D3
02:00048F58 1600            	  5927:     move.b  D0,D3
02:00048F5A 7008            	  5928:     moveq   #8,D0
02:00048F5C 5303            	  5929:     subq.b  #1,D3
02:00048F5E 6708            	  5930:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048F60 41EC0098        	  5931:     lea     ($0098,A4),A0
02:00048F64 10302000        	  5932:     move.b  (A0,D2.W),D0
