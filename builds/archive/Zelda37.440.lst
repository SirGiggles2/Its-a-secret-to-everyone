02:0003BD28 522C00AD        	  8261:     addq.b  #1,($00AD,A4)
                            	  8262: _anon_z04_157:
                            	  8263:     ; Go to state 1 to orbit.
                            	  8264:     ;
02:0003BD2C 41EC00AC        	  8265:     lea     ($00AC,A4),A0
