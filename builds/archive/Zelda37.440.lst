                            	  1458:     ;==========================================================================
                            	  1459:     ; .csfx_apply_bias — add per-copy bias to nonzero pixel nibbles.
                            	  1460:     ; In:  D0.w = nonzero mask ($0/$1 per nibble)
                            	  1461:     ;      D2.w = raw pixel nibbles
                            	  1462:     ;      D7.w = bias word ($0000/$4444/$8888/$CCCC)
                            	  1463:     ; Out: D2.w = biased pixel nibbles
                            	  1464:     ; Clobbers D0, D1.
                            	  1465:     ;==========================================================================
                            	  1466: .csfx_apply_bias:
02:0000E86E 3200            	  1467:     move.w  D0,D1
02:0000E870 E349            	  1468:     lsl.w   #1,D1
02:0000E872 8041            	  1469:     or.w    D1,D0
02:0000E874 3200            	  1470:     move.w  D0,D1
02:0000E876 E549            	  1471:     lsl.w   #2,D1
02:0000E878 8041            	  1472:     or.w    D1,D0                       ; D0 now has $F per nonzero nibble
02:0000E87A C047            	  1473:     and.w   D7,D0                       ; D0 = bias_add (bias per nonzero nibble)
02:0000E87C 8440            	  1474:     or.w    D0,D2                       ; merge into pixel nibbles
02:0000E87E 4E75            	  1475:     rts
                            	  1476: 
                            	  1477:     ;==========================================================================
                            	  1478:     ; .csfx_expand — local copy of the nibble expander used by _chr_convert_upload.
                            	  1479:     ; In:  D1.b = 4-bit nibble, A1 = .csfx_expand_lut
                            	  1480:     ; Out: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1481:     ;==========================================================================
                            	  1482: .csfx_expand:
02:0000E880 0241000F        	  1483:     andi.w  #$000F,D1
02:0000E884 D241            	  1484:     add.w   D1,D1
02:0000E886 34311000        	  1485:     move.w  (A1,D1.W),D2
02:0000E88A 4E75            	  1486:     rts
                            	  1487: 
                            	  1488:     even
                            	  1489: .csfx_expand_lut:
02:0000E88C 0000            	  1490:     dc.w    $0000,$0001,$0010,$0011
02:0000E88E 0001
02:0000E890 0010
02:0000E892 0011
02:0000E894 0100            	  1491:     dc.w    $0100,$0101,$0110,$0111
02:0000E896 0101
02:0000E898 0110
02:0000E89A 0111
02:0000E89C 1000            	  1492:     dc.w    $1000,$1001,$1010,$1011
02:0000E89E 1001
02:0000E8A0 1010
02:0000E8A2 1011
02:0000E8A4 1100            	  1493:     dc.w    $1100,$1101,$1110,$1111
02:0000E8A6 1101
02:0000E8A8 1110
02:0000E8AA 1111
                            	  1494: 
                            	  1495:     even
                            	  1496: .csfx_copy_base_tbl:
                            	  1497:     ; 4 entries, 8 bytes each: (base_vram .l, bias_word_as_long .l)
                            	  1498:     ; Bias word sits in the low 16 bits of the long so `move.l (A2)+,D7`
                            	  1499:     ; leaves the bias in D7.w for the .w AND in .csfx_apply_bias.
                            	  1500:     ; T-CHR v9: sub-pal→CRAM slot mapping via pixel bias + Gen-pal bits (OAM).
                            	  1501:     ;   copy 0 / shared bank A (sub-pal 0 + sub-pal 3): bias +$4
                            	  1502:     ;   copy 1 / bank B (sub-pal 1): bias +$8
                            	  1503:     ;   copy 2 / bank C (sub-pal 2): bias +$C
                            	  1504:     ;   copy 3 reuses bank A because sub-pal 3 needs the same +$4 biased pixels
                            	  1505:     ;   as sub-pal 0; only the SAT palette bits differ. This frees the old bank-C
                            	  1506:     ;   overlap so 8x16 table-1 sprites like the item-roll heart can use upper-half
                            	  1507:     ;   tile pairs without colliding with another sprite copy.
02:0000E8AC 00000000        	  1508:     dc.l    $00000000,$00004444
02:0000E8B0 00004444
02:0000E8B4 00004000        	  1509:     dc.l    $00004000,$00008888
02:0000E8B8 00008888
02:0000E8BC 00008000        	  1510:     dc.l    $00008000,$0000CCCC
02:0000E8C0 0000CCCC
02:0000E8C4 00000000        	  1511:     dc.l    $00000000,$00004444
02:0000E8C8 00004444
                            	  1512: .csfx_hi_copy_base_tbl:
                            	  1513:     ; Upper-half CHR mirrored for NES 8x16 sprites. Only the safe banks used by
                            	  1514:     ; sub-pal 1 (+8) and sub-pal 2 (+C) are populated here.
02:0000E8CC 00004000        	  1515:     dc.l    $00004000,$00008888
02:0000E8D0 00008888
02:0000E8D4 00008000        	  1516:     dc.l    $00008000,$0000CCCC
02:0000E8D8 0000CCCC
                            	  1517:     endc
                            	  1518: 
                            	  1519: ;==============================================================================
                            	  1520: ; _compose_bg_tile_word — add the active BG pattern-table offset to a raw tile.
                            	  1521: ;
                            	  1522: ; Input:  D0.w = raw NES BG tile index (0..255)
                            	  1523: ; Output: D0.w = Genesis tile word: bit 15 (high prio) | tile index
                            	  1524: ; Uses no other registers.
                            	  1525: ;
                            	  1526: ; Attempt 5g (diary 2026-04-04 12:37:44): Plane A BG tiles are promoted to
                            	  1527: ; high priority so text and board glyphs can sit in front of sprites that
                            	  1528: ; NES OAM marks as behind-background (attr bit 5). _oam_dma pairs with this
                            	  1529: ; by honoring attr bit 5 and leaving those sprites low-priority.
                            	  1530: ;==============================================================================
                            	  1531: _compose_bg_tile_word:
02:0000E8DC 024000FF        	  1532:     andi.w  #$00FF,D0               ; raw tile index only
02:0000E8E0 0839000400FF0804	  1533:     btst    #4,(PPU_CTRL).l
02:0000E8E8 6704            	  1534:     beq.s   .cbgtw_done
02:0000E8EA 00400100        	  1535:     ori.w   #$0100,D0               ; BG pattern table 1 → VRAM $1000
                            	  1536: .cbgtw_done:
02:0000E8EE 00408000        	  1537:     ori.w   #$8000,D0               ; bit 15 = high priority (Attempt 5g)
02:0000E8F2 4E75            	  1538:     rts
                            	  1539: 
                            	  1540: ;==============================================================================
                            	  1541: ; _attr_write_2x2 — write palette bits into a 2x2 tile block.
                            	  1542: ;
                            	  1543: ; Input: D2.w = col (top-left tile), D3.w = row (top-left tile)
                            	  1544: ;        D5.w = palette << 13  (Genesis tile word palette bits [14:13])
                            	  1545: ; All inputs preserved.  Uses D0, D1, A0 as scratch.
                            	  1546: ;==============================================================================
                            	  1547: _attr_write_2x2:
02:0000E8F4 6110            	  1548:     bsr     _attr_write_one_tile        ; (row,   col)
02:0000E8F6 5242            	  1549:     addq.w  #1,D2
02:0000E8F8 610C            	  1550:     bsr     _attr_write_one_tile        ; (row,   col+1)
02:0000E8FA 5243            	  1551:     addq.w  #1,D3
02:0000E8FC 6108            	  1552:     bsr     _attr_write_one_tile        ; (row+1, col+1)
02:0000E8FE 5342            	  1553:     subq.w  #1,D2
02:0000E900 6104            	  1554:     bsr     _attr_write_one_tile        ; (row+1, col)
02:0000E902 5343            	  1555:     subq.w  #1,D3
02:0000E904 4E75            	  1556:     rts
                            	  1557: 
                            	  1558: ;==============================================================================
                            	  1559: ; _attr_write_one_tile — write one Plane A tile word with palette bits.
                            	  1560: ;
                            	  1561: ; Input: D2.w = col (0..31), D3.w = row (0..29), D5.w = palette << 13
                            	  1562: ; Reads tile index from NT_CACHE_BASE[row*32 + col].
                            	  1563: ; Writes tile word = (palette<<13) | tile_index to VDP Plane A.
                            	  1564: ; Inputs D2, D3, D5 preserved.  Uses D0, D1, A0.
                            	  1565: ;==============================================================================
                            	  1566: _attr_write_one_tile:
                            	  1567:     ; Bounds check (V64: NT0 rows 0-29, NT1 rows 30-59)
02:0000E906 0C43003C        	  1568:     cmpi.w  #60,D3
02:0000E90A 644C            	  1569:     bhs     .awt_skip           ; row >= 60 -> out of nametable
02:0000E90C 0C420020        	  1570:     cmpi.w  #32,D2
02:0000E910 6446            	  1571:     bhs     .awt_skip           ; col >= 32 -> out of nametable
                            	  1572: 
                            	  1573:     ; Load cached tile index: NT_CACHE[row*32 + col]
02:0000E912 7200            	  1574:     moveq   #0,D1
02:0000E914 3203            	  1575:     move.w  D3,D1
02:0000E916 EB49            	  1576:     lsl.w   #5,D1               ; D1.w = row * 32
02:0000E918 D242            	  1577:     add.w   D2,D1               ; D1.w = row*32 + col
02:0000E91A 41F900FF0840    	  1578:     lea     (NT_CACHE_BASE).l,A0
02:0000E920 7000            	  1579:     moveq   #0,D0
02:0000E922 10301000        	  1580:     move.b  (A0,D1.W),D0        ; D0.b = tile index
                            	  1581: 
02:0000E926 61B4            	  1582:     bsr     _compose_bg_tile_word
                            	  1583:     ; Build tile word: (palette<<13) | tile_index
02:0000E928 8045            	  1584:     or.w    D5,D0               ; D0.w = tile word with palette bits
                            	  1585: 
                            	  1586:     ; Compute Genesis VDP address: $C000 + row*$80 + col*2
02:0000E92A 7200            	  1587:     moveq   #0,D1
02:0000E92C 3203            	  1588:     move.w  D3,D1
02:0000E92E EF89            	  1589:     lsl.l   #7,D1               ; D1.l = row * $80
02:0000E930 D242            	  1590:     add.w   D2,D1
02:0000E932 D242            	  1591:     add.w   D2,D1               ; D1.w += col * 2
02:0000E934 0641C000        	  1592:     addi.w  #$C000,D1           ; D1.w = VDP address
                            	  1593: 
                            	  1594:     ; Issue VDP VRAM write command
02:0000E938 3F00            	  1595:     move.w  D0,-(SP)            ; save tile word
02:0000E93A 2001            	  1596:     move.l  D1,D0
02:0000E93C 028000003FFF    	  1597:     andi.l  #$00003FFF,D0
02:0000E942 4840            	  1598:     swap    D0
02:0000E944 008040000003    	  1599:     ori.l   #$40000003,D0       ; CD bits + A[15:14]=3
02:0000E94A 23C000C00004    	  1600:     move.l  D0,(VDP_CTRL).l
02:0000E950 301F            	  1601:     move.w  (SP)+,D0            ; restore tile word
02:0000E952 33C000C00000    	  1602:     move.w  D0,(VDP_DATA).l     ; write to Plane A
                            	  1603: 
                            	  1604:     ; V64 gap rows 60-63 left blank — see _ppu_write_7 comment.
                            	  1605: 
                            	  1606: .awt_skip:
02:0000E958 4E75            	  1607:     rts
                            	  1608: 
                            	  1609: ;==============================================================================
                            	  1610: ; NES → Genesis palette lookup table
                            	  1611: ;
                            	  1612: ; 64 × 16-bit words: index = NES color byte (0–63).
                            	  1613: ; Genesis color format: $0BGR (bits [10:8]=Blue, [6:4]=Green, [2:0]=Red, 0–7 each).
                            	  1614: ; Source: title-calibrated NES palette approximations tuned against BizHawk
                            	  1615: ; frame-200 NES reference captures, quantized to Genesis 3-bit channels.
                            	  1616: ;==============================================================================
                            	  1617:     even
                            	  1618: nes_palette_to_genesis:
                            	  1619:     ;       NES $00–$0F  (grays, blues, purples, reds, greens)
                            	  1620:     ;       Genesis CRAM = (B<<9)|(G<<5)|(R<<1)  — NOT raw $0BGR nibbles
02:0000E95A 0666            	  1621:     dc.w    $0666   ; $00  rgb(84,84,84)     dark gray (universal BG)
02:0000E95C 0E00            	  1622:     dc.w    $0E00   ; $01  rgb(0,0,252)     dark blue
02:0000E95E 0A00            	  1623:     dc.w    $0A00   ; $02  rgb(0,0,188)     dark blue
02:0000E960 0A24            	  1624:     dc.w    $0A24   ; $03  rgb(68,40,188)   blue-violet
02:0000E962 0808            	  1625:     dc.w    $0808   ; $04  rgb(148,0,132)   purple
02:0000E964 020A            	  1626:     dc.w    $020A   ; $05  rgb(168,0,32)    dark red-magenta
02:0000E966 000A            	  1627:     dc.w    $000A   ; $06  rgb(168,16,0)    dark red
02:0000E968 0028            	  1628:     dc.w    $0028   ; $07  rgb(136,20,0)    dark red-brown
02:0000E96A 0044            	  1629:     dc.w    $0044   ; $08  dark olive-brown
02:0000E96C 0060            	  1630:     dc.w    $0060   ; $09  rgb(0,120,0)     dark green
02:0000E96E 0060            	  1631:     dc.w    $0060   ; $0A  rgb(0,104,0)     dark green
02:0000E970 0040            	  1632:     dc.w    $0040   ; $0B  rgb(0,88,0)      very dark green
02:0000E972 0440            	  1633:     dc.w    $0440   ; $0C  rgb(0,64,88)     dark teal
02:0000E974 0000            	  1634:     dc.w    $0000   ; $0D  black (unused/invalid)
02:0000E976 0000            	  1635:     dc.w    $0000   ; $0E  black (unused/invalid)
02:0000E978 0000            	  1636:     dc.w    $0000   ; $0F  black (unused/invalid)
                            	  1637: 
                            	  1638:     ;       NES $10–$1F  (light grays, bright blues/reds, mid greens, teals)
02:0000E97A 0AAA            	  1639:     dc.w    $0AAA   ; $10  rgb(152,152,152)  light gray
02:0000E97C 0E60            	  1640:     dc.w    $0E60   ; $11  rgb(0,120,248)   bright blue
02:0000E97E 0E40            	  1641:     dc.w    $0E40   ; $12  rgb(0,88,248)    bright blue
02:0000E980 0E46            	  1642:     dc.w    $0E46   ; $13  rgb(104,68,252)  blue-violet
02:0000E982 0C0C            	  1643:     dc.w    $0C0C   ; $14  rgb(216,0,204)   bright magenta
02:0000E984 040C            	  1644:     dc.w    $040C   ; $15  rgb(228,0,88)    bright red
02:0000E986 004A            	  1645:     dc.w    $004A   ; $16  orange-red
02:0000E988 004A            	  1646:     dc.w    $004A   ; $17  orange
02:0000E98A 006A            	  1647:     dc.w    $006A   ; $18  rgb(172,124,0)   yellow-orange
02:0000E98C 00A0            	  1648:     dc.w    $00A0   ; $19  rgb(0,184,0)     green
02:0000E98E 0080            	  1649:     dc.w    $0080   ; $1A  green
02:0000E990 04A0            	  1650:     dc.w    $04A0   ; $1B  rgb(0,168,68)    green-teal
02:0000E992 0880            	  1651:     dc.w    $0880   ; $1C  rgb(0,136,136)   teal
02:0000E994 0000            	  1652:     dc.w    $0000   ; $1D  black (unused/invalid)
02:0000E996 0000            	  1653:     dc.w    $0000   ; $1E  black (unused/invalid)
02:0000E998 0000            	  1654:     dc.w    $0000   ; $1F  black (unused/invalid)
                            	  1655: 
                            	  1656:     ;       NES $20–$2F  (near-white, light colors, pastels)
02:0000E99A 0EEE            	  1657:     dc.w    $0EEE   ; $20  rgb(248,248,248) near-white
02:0000E99C 0EA4            	  1658:     dc.w    $0EA4   ; $21  rgb(60,188,252)  light cyan-blue
02:0000E99E 0E86            	  1659:     dc.w    $0E86   ; $22  light blue
02:0000E9A0 0E68            	  1660:     dc.w    $0E68   ; $23  rgb(152,120,248) light purple-blue
02:0000E9A2 0E6E            	  1661:     dc.w    $0E6E   ; $24  rgb(248,120,248) light magenta
02:0000E9A4 084E            	  1662:     dc.w    $084E   ; $25  rgb(248,88,152)  light pink-red
02:0000E9A6 046E            	  1663:     dc.w    $046E   ; $26  rgb(248,120,88)  light orange
02:0000E9A8 048E            	  1664:     dc.w    $048E   ; $27  rgb(252,160,68)  light yellow-orange
02:0000E9AA 00CC            	  1665:     dc.w    $00CC   ; $28  yellow
02:0000E9AC 02EA            	  1666:     dc.w    $02EA   ; $29  rgb(184,248,24)  yellow-green
02:0000E9AE 04C4            	  1667:     dc.w    $04C4   ; $2A  rgb(88,216,84)   light green
02:0000E9B0 08E4            	  1668:     dc.w    $08E4   ; $2B  rgb(88,248,152)  light green-teal
02:0000E9B2 0CC0            	  1669:     dc.w    $0CC0   ; $2C  rgb(0,232,216)   light teal
02:0000E9B4 0666            	  1670:     dc.w    $0666   ; $2D  rgb(120,120,120) medium gray
02:0000E9B6 0000            	  1671:     dc.w    $0000   ; $2E  black (unused/invalid)
02:0000E9B8 0000            	  1672:     dc.w    $0000   ; $2F  black (unused/invalid)
                            	  1673: 
                            	  1674:     ;       NES $30–$3F  (whites, very light pastels)
02:0000E9BA 0EEE            	  1675:     dc.w    $0EEE   ; $30  rgb(252,252,252) white
02:0000E9BC 0ECA            	  1676:     dc.w    $0ECA   ; $31  rgb(164,228,252) very light blue
02:0000E9BE 0EAA            	  1677:     dc.w    $0EAA   ; $32  rgb(184,184,248) very light purple-blue
02:0000E9C0 0EAC            	  1678:     dc.w    $0EAC   ; $33  rgb(216,184,248) very light purple
02:0000E9C2 0EAE            	  1679:     dc.w    $0EAE   ; $34  rgb(248,184,248) very light magenta
02:0000E9C4 0AAE            	  1680:     dc.w    $0AAE   ; $35  rgb(248,164,192) very light pink
02:0000E9C6 0CCE            	  1681:     dc.w    $0CCE   ; $36  very light pink-beige
02:0000E9C8 0ACE            	  1682:     dc.w    $0ACE   ; $37  rgb(252,224,168) very light yellow
02:0000E9CA 06CE            	  1683:     dc.w    $06CE   ; $38  rgb(248,216,120) light yellow
02:0000E9CC 06EC            	  1684:     dc.w    $06EC   ; $39  rgb(216,248,120) light yellow-green
02:0000E9CE 0AEA            	  1685:     dc.w    $0AEA   ; $3A  rgb(184,248,184) light green
02:0000E9D0 0CEA            	  1686:     dc.w    $0CEA   ; $3B  rgb(184,248,216) very light teal
02:0000E9D2 0EE0            	  1687:     dc.w    $0EE0   ; $3C  rgb(0,252,252)   bright cyan
02:0000E9D4 0ECE            	  1688:     dc.w    $0ECE   ; $3D  rgb(248,216,248) very light magenta
02:0000E9D6 0000            	  1689:     dc.w    $0000   ; $3E  black (unused/invalid)
02:0000E9D8 0000            	  1690:     dc.w    $0000   ; $3F  black (unused/invalid)
