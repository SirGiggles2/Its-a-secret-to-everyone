                            	  3932:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  3933:     ;
02:00039C68 41EC03BC        	  3934:     lea     ($03BC,A4),A0
02:00039C6C 10302000        	  3935:     move.b  (A0,D2.W),D0
02:00039C70 6712            	  3936:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:00039C72 41EC0098        	  3937:     lea     ($0098,A4),A0
02:00039C76 11802000        	  3938:     move.b  D0,(A0,D2.W)
02:00039C7A 7000            	  3939:     moveq   #0,D0
02:00039C7C 41EC03BC        	  3940:     lea     ($03BC,A4),A0
02:00039C80 11802000        	  3941:     move.b  D0,(A0,D2.W)
                            	  3942:     even
                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
