                            	  2492: ;==============================================================================
                            	  2493: ; EXPORT side — carry-returning shims.
                            	  2494: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2495: ; reproduces the original function's carry normalization.
                            	  2496: ;==============================================================================
                            	  2497: 
                            	  2498: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2499: c_copy_next_row_to_transfer_buf:
02:0002BF8A 4EB900000000    	  2500:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF90 08000008        	  2501:     btst    #8,D0
02:0002BF94 670A            	  2502:     beq.s   .cc_cnr
02:0002BF96 003C0001        	  2503:     ori     #$01,CCR
02:0002BF9A 0A3C0001        	  2504:     eori    #$01,CCR
02:0002BF9E 4E75            	  2505:     rts
                            	  2506: .cc_cnr:
02:0002BFA0 023C00FE        	  2507:     andi    #$FE,CCR
02:0002BFA4 0A3C0001        	  2508:     eori    #$01,CCR
02:0002BFA8 4E75            	  2509:     rts
                            	  2510: 
