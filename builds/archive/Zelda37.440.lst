                            	  2332: UpdateArmos:
02:00039108 6100F296        	  2333:     jsr     UpdateGoriya
                            	  2334:     ; If it's still shoved, then don't animate. Only go draw.
                            	  2335:     ;
02:0003910C 41EC00C0        	  2336:     lea     ($00C0,A4),A0
02:00039110 10302000        	  2337:     move.b  (A0,D2.W),D0
02:00039114 6702            	  2338:     beq.s  __far_z_04_0018
