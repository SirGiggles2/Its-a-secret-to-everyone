                            	  2508: 
                            	  2509: ; Params:
                            	  2510: ; A: cursor Y
                            	  2511: ;
                            	  2512: ; Returns:
                            	  2513: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2514: ;
                            	  2515: ; Description:
                            	  2516: ; Adjust the Y coordinate to account for the visible part of
                            	  2517: ; block cursor being in the bottom half of sprite.
                            	  2518: ; Also, make the cursor flash.
                            	  2519: ;
                            	  2520:     even
