02:0002F28E 10303000        	   448:     move.b  (A0,D3.W),D0
02:0002F292 41EC0448        	   449:     lea     ($0448,A4),A0
02:0002F296 11802000        	   450:     move.b  D0,(A0,D2.W)
02:0002F29A 5302            	   451:     subq.b  #1,D2
02:0002F29C 6AE2            	   452:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
