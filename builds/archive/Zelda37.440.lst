                            	  6798: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6799:     ; To animate the state, the animation counter had to have
                            	  6800:     ; reached 0. Right after this routine, the counter will be
                            	  6801:     ; rolled over, and the movement frame will be switched.
                            	  6802:     ;
                            	  6803:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6804:     ; the animation here, in order to immediately change it to
                            	  6805:     ; 0 (legs apart) after this.
                            	  6806:     ;
02:00049516 7001            	  6807:     moveq   #1,D0
02:00049518 194003E4        	  6808:     move.b  D0,($03E4,A4)
02:0004951C 4E75            	  6809:     rts
                            	  6810: 
                            	  6811:     even
                            	  6812: _L_z07_AnimateLinkObjState_CheckState30:
                            	  6813:     ; If in state $30, then make Link idle, except for halting.
                            	  6814:     ;
02:0004951E 0C000030        	  6815:     cmpi.b  #$30,D0
02:00049522 660C            	  6816:     bne  _anon_z07_39
02:00049524 102C00AC        	  6817:     move.b  ($00AC,A4),D0
02:00049528 020000C0        	  6818:     andi.b #$C0,D0
02:0004952C 194000AC        	  6819:     move.b  D0,($00AC,A4)
