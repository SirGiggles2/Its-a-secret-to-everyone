                            	  4603: UpdatePeaceTextbox:
                            	  4604:     ; Only emit a character once every 8 frames --
                            	  4605:     ; when (counter [0412] MOD 8) = 4.
                            	  4606:     ;
02:00034FC8 522C0412        	  4607:     addq.b  #1,($0412,A4)
02:00034FCC 102C0412        	  4608:     move.b  ($0412,A4),D0
02:00034FD0 02000007        	  4609:     andi.b #$07,D0
02:00034FD4 0C000004        	  4610:     cmpi.b  #$04,D0
02:00034FD8 665C            	  4611:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4612:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4613:     ; to the dynamic transfer buf.
                            	  4614:     ;
02:00034FDA 7604            	  4615:     moveq   #4,D3
                            	  4616: _anon_z02_35:
02:00034FDC 41F900034F58    	  4617:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00034FE2 10303000        	  4618:     move.b  (A0,D3.W),D0
02:00034FE6 41EC0302        	  4619:     lea     ($0302,A4),A0
02:00034FEA 11803000        	  4620:     move.b  D0,(A0,D3.W)
02:00034FEE 5303            	  4621:     subq.b  #1,D3
02:00034FF0 6AEA            	  4622:     bpl  _anon_z02_35
                            	  4623:     ; Load a character from the string and copy it to
                            	  4624:     ; the transfer record until we read character $FF.
                            	  4625:     ;
02:00034FF2 7600            	  4626:     moveq   #0,D3
02:00034FF4 162C0413        	  4627:     move.b  ($0413,A4),D3
02:00034FF8 41F900034F92    	  4628:     lea     (PeaceText).l,A0
02:00034FFE 10303000        	  4629:     move.b  (A0,D3.W),D0
02:00035002 0C0000FF        	  4630:     cmpi.b  #$FF,D0
02:00035006 6730            	  4631:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00035008 19400305        	  4632:     move.b  D0,($0305,A4)
                            	  4633:     ; A regular space takes as much time to emit as any character.
                            	  4634:     ; But it makes no sound.
                            	  4635:     ;
02:0003500C 0C000024        	  4636:     cmpi.b  #$24,D0
02:00035010 6706            	  4637:     beq  _anon_z02_36
