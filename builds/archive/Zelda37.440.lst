                            	   946: 
                            	   947: ;------------------------------------------------------------------------------
                            	   948: ; _c_move_object_shim — MoveObject trampoline.
                            	   949: ;
                            	   950: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   951: ;   Input:     D2 = slot (0..11)
                            	   952: ;   Preserves: D2, A4, A5
                            	   953: ;   Clobbers:  D0, D1, D3, A0
                            	   954: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   955: ;
                            	   956: ; GCC side:
                            	   957: ;   void c_move_object(unsigned short slot);
                            	   958: ;     slot arrives as a 16-bit value on the stack.
                            	   959: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   960: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   961: ;   never clobbered by gcc.
                            	   962: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   963: ;   semantics can exist in a pure C port).
                            	   964: ;------------------------------------------------------------------------------
                            	   965: _c_move_object_shim:
                            	   966:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   967:     move.b  #$AA,($0900,A4)
                            	   968:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   969:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   970:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   971:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   972:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   973:     moveq   #0,D0
02:0002B658 3002            	   974:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   975:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   976:     jsr     c_move_object
02:0002B662 588F            	   977:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   978:     rts
                            	   979: 
                            	   980: ;==============================================================================
                            	   981: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   982: ; and tail-call the native asm function.
                            	   983: ;
                            	   984: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   985: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   986: ; sign-extended).
                            	   987: ;==============================================================================
                            	   988: 
                            	   989: ;------------------------------------------------------------------------------
                            	   990: ; void c_copy_bank_to_window(unsigned int bank);
                            	   991: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   992: ;------------------------------------------------------------------------------
                            	   993: c_copy_bank_to_window:
02:0002B666 202F0004        	   994:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   995:     jmp     _copy_bank_to_window
                            	   996: 
                            	   997: ;------------------------------------------------------------------------------
                            	   998: ; unsigned char c_ppu_read_2(void);
                            	   999: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	  1000: ; C return: gcc expects result in D0.
                            	  1001: ;------------------------------------------------------------------------------
                            	  1002: c_ppu_read_2:
02:0002B66E 4EF90000E034    	  1003:     jmp     _ppu_read_2
                            	  1004: 
                            	  1005: ;------------------------------------------------------------------------------
                            	  1006: ; void c_ppu_write_6(unsigned int val);
                            	  1007: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	  1008: ;------------------------------------------------------------------------------
                            	  1009: c_ppu_write_6:
02:0002B674 202F0004        	  1010:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	  1011:     jmp     _ppu_write_6
                            	  1012: 
                            	  1013: ;------------------------------------------------------------------------------
                            	  1014: ; void c_ppu_write_7(unsigned int val);
                            	  1015: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1016: ;------------------------------------------------------------------------------
                            	  1017: c_ppu_write_7:
02:0002B67E 202F0004        	  1018:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1019:     jmp     _ppu_write_7
                            	  1020: 
                            	  1021: ;------------------------------------------------------------------------------
                            	  1022: ; void c_turn_off_all_video(void);
                            	  1023: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1024: ;------------------------------------------------------------------------------
                            	  1025: c_turn_off_all_video:
02:0002B688 4EF900047204    	  1026:     jmp     TurnOffAllVideo
                            	  1027: 
                            	  1028: ;==============================================================================
                            	  1029: ; EXPORT side — z_03 entry point.
                            	  1030: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1031: ; the transpiler emits that label pointing to this shim instead of the
                            	  1032: ; z_03 asm body. The C function takes no args and returns void.
                            	  1033: ;==============================================================================
                            	  1034: 
                            	  1035: ;------------------------------------------------------------------------------
                            	  1036: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1037: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1038: ;------------------------------------------------------------------------------
                            	  1039: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1040:     jmp     z03_transfer_level_pattern_blocks
                            	  1041: 
                            	  1042: ;==============================================================================
                            	  1043: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1044: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1045: ;==============================================================================
                            	  1046: 
                            	  1047: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1048:     jmp     z06_init_mode2_submodes
                            	  1049: 
                            	  1050: c_copy_common_data_to_ram:
