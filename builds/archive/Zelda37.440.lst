02:0003D992 5302            	  1503:     subq.b  #1,D2
02:0003D994 6702            	  1504:     beq.s  __far_z_05_0024
02:0003D996 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
