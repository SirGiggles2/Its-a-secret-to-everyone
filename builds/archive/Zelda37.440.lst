                            	  4396: ; AnimateAndDrawCommonObject(val, slot) — ASM: D0=val, D2=slot
                            	  4397: c_animate_and_draw_common_object:
02:0002CCDE 2F02            	  4398:     move.l  D2,-(SP)        ; save D2
02:0002CCE0 2F02            	  4399:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCE2 2F00            	  4400:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4401:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4402:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4403:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4404:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CCE4 4EB900000000    	  4405:     jsr     z04_animate_and_draw_common_object
02:0002CCEA 508F            	  4406:     addq.l  #8,SP           ; pop val+slot
02:0002CCEC 241F            	  4407:     move.l  (SP)+,D2        ; restore D2
02:0002CCEE 4E75            	  4408:     rts
