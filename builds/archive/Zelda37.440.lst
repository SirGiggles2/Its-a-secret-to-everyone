02:000391FA 194303F8        	  2491:     move.b  D3,($03F8,A4)
                            	  2492:     ; Save and reset Link's state.
                            	  2493:     ;
                            	  2494:     ; TODO: but why, since Link is halted?
                            	  2495:     ;
02:000391FE 102C00AC        	  2496:     move.b  ($00AC,A4),D0
02:00039202 1B00            	  2497:     move.b  D0,-(A5)  ; PHA
02:00039204 194300AC        	  2498:     move.b  D3,($00AC,A4)
02:00039208 4EB900048472    	  2499:     jsr     Link_EndMoveAndAnimate_Bank4
