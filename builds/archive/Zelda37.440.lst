02:0003BFF6 11802000        	  8682:     move.b  D0,(A0,D2.W)
02:0003BFFA 615C            	  8683:     jsr     Ganon_SetUpBurstRays
02:0003BFFC 610003DA        	  8684:     jsr     PlayBossDeathCry
