02:0003BEAE 19400028        	  8465:     move.b  D0,($0028,A4)
                            	  8466:     ; Set scene phase 1, and go draw Ganon.
                            	  8467:     ;
02:0003BEB2 522C0445        	  8468:     addq.b  #1,($0445,A4)
02:0003BEB6 6702            	  8469:     beq.s  __far_z_04_0092
02:0003BEB8 6032            	  8470:     jmp  Ganon_DrawBodyFrame0
