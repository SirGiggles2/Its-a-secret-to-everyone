02:0003B340 41EC03E4        	  6973:     lea     ($03E4,A4),A0
02:0003B344 12302000        	  6974:     move.b  (A0,D2.W),D1
02:0003B348 D101            	  6975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B34A 02000001        	  6976:     andi.b #$01,D0
02:0003B34E 023C00EE        	  6977:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B352 123C0004        	  6978:     move.b  #$04,D1
02:0003B356 D101            	  6979:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
