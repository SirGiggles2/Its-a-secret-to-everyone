                            	  8994: Ganon_CheckCollisions:
                            	  8995:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  8996:     ; Store in [02] and [03].
                            	  8997:     ;
02:0003C260 10342070        	  8998:     move.b  ($70,A4,D2.W),D0
02:0003C264 023C00EE        	  8999:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C268 123C0010        	  9000:     move.b  #$10,D1
02:0003C26C D101            	  9001:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C26E 19400002        	  9002:     move.b  D0,($0002,A4)
02:0003C272 41EC0084        	  9003:     lea     ($0084,A4),A0
02:0003C276 10302000        	  9004:     move.b  (A0,D2.W),D0
02:0003C27A 023C00EE        	  9005:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C27E 123C0010        	  9006:     move.b  #$10,D1
02:0003C282 D101            	  9007:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C284 19400003        	  9008:     move.b  D0,($0003,A4)
                            	  9009:     ; Check for a collision with Link.
                            	  9010:     ;
                            	  9011:     ; We can't call CheckLinkCollision, because we need to
                            	  9012:     ; customize Ganon's midpoint.
                            	  9013:     ;
                            	  9014:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9015:     ; detection, if Link is invincible. Initialize variables that will
                            	  9016:     ; be returned from the partial collision check routine. Then
                            	  9017:     ; call it.
                            	  9018:     ;
02:0003C288 102C04F0        	  9019:     move.b  ($04F0,A4),D0
02:0003C28C 6616            	  9020:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C28E 19400006        	  9021:     move.b  D0,($0006,A4)
02:0003C292 19400009        	  9022:     move.b  D0,($0009,A4)
02:0003C296 1940000C        	  9023:     move.b  D0,($000C,A4)
02:0003C29A 7600            	  9024:     moveq   #0,D3
02:0003C29C 1883            	  9025:     move.b  D3,($0000,A4)
02:0003C29E 4EB90003113A    	  9026:     jsr     CheckLinkCollisionPreinit
                            	  9027:     even
                            	  9028: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9029:     ; If Ganon is not in state 0, then he's brown.
                            	  9030:     ; Go check collision with an arrow.
                            	  9031:     ;
02:0003C2A4 41EC00AC        	  9032:     lea     ($00AC,A4),A0
02:0003C2A8 10302000        	  9033:     move.b  (A0,D2.W),D0
02:0003C2AC 6652            	  9034:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9035:     ; If timer <> 0, then Ganon is visible.
                            	  9036:     ; He can't be harmed like this. So, return.
                            	  9037:     ;
02:0003C2AE 10342028        	  9038:     move.b  ($28,A4,D2.W),D0
02:0003C2B2 664A            	  9039:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C2B4 760D            	  9040:     moveq   #13,D3
02:0003C2B6 4EB900031174    	  9041:     jsr     CheckMonsterSwordCollision
                            	  9042:     ; If Ganon has died according to the usual collision check rules
                            	  9043:     ; (HP = 0), then:
                            	  9044:     ; 1. Restore HP to the initial value $F0
                            	  9045:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  9046:     ; 3. Change palette row 7 to make Ganon brown
                            	  9047:     ;
02:0003C2BC 41EC0405        	  9048:     lea     ($0405,A4),A0
02:0003C2C0 10302000        	  9049:     move.b  (A0,D2.W),D0
02:0003C2C4 6718            	  9050:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C2C6 103C00F0        	  9051:     move.b  #$F0,D0
02:0003C2CA 41EC0485        	  9052:     lea     ($0485,A4),A0
02:0003C2CE 11802000        	  9053:     move.b  D0,(A0,D2.W)
02:0003C2D2 41EC00AC        	  9054:     lea     ($00AC,A4),A0
02:0003C2D6 53302000        	  9055:     subq.b  #1,(A0,D2.W)
02:0003C2DA 61000084        	  9056:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  9057:     even
                            	  9058: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  9059:     ; If Ganon was harmed, then play the sound effect
                            	  9060:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  9061:     ;
02:0003C2DE 41EC04F0        	  9062:     lea     ($04F0,A4),A0
02:0003C2E2 10302000        	  9063:     move.b  (A0,D2.W),D0
02:0003C2E6 670A            	  9064:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C2E8 6100BF7A        	  9065:     jsr     PlayBossHitCryIfNeeded
