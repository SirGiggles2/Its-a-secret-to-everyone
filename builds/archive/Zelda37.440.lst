                            	  2343: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:0003387C 102C0070        	  2344:     move.b  ($0070,A4),D0
02:00033880 023C00EE        	  2345:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033884 123C0008        	  2346:     move.b  #$08,D1
02:00033888 D101            	  2347:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003388A 19400070        	  2348:     move.b  D0,($0070,A4)
02:0003388E 522C0421        	  2349:     addq.b  #1,($0421,A4)
02:00033892 522C0423        	  2350:     addq.b  #1,($0423,A4)
                            	  2351:     ; If VRAM address still points inside the name field,
                            	  2352:     ; then go finish.
                            	  2353:     ;
                            	  2354:     ; The idea is that each name field in nametable begins at
                            	  2355:     ; an address ending in $E. For example, slot 0 has a name
                            	  2356:     ; at VRAM addresses $20CE to $20D5.
                            	  2357:     ;
                            	  2358:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2359:     ; the name field.
                            	  2360:     ;
                            	  2361:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2362:     ; record header.
                            	  2363:     ;
02:00033896 102C0070        	  2364:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:0003389A 0C0000B0        	  2365:     cmpi.b  #$B0,D0
02:0003389E 6678            	  2366:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2367:     ; The VRAM address now points outside the name field.
                            	  2368:     ; So, wrap around to the beginning of the name field.
                            	  2369:     ;
                            	  2370:     ; For example, $20D6 -> $20CE.
                            	  2371:     ;
02:000338A0 102C0423        	  2372:     move.b  ($0423,A4),D0
02:000338A4 003C0011        	  2373:     ori     #$11,CCR  ; SEC: set C+X
02:000338A8 123C0008        	  2374:     move.b  #$08,D1
02:000338AC 0A3C0010        	  2375:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338B0 9101            	  2376:     subx.b  D1,D0   ; SBC #$08
02:000338B2 0A3C0010        	  2377:     eori    #$10,CCR  ; restore X = 6502 C
02:000338B6 19400423        	  2378:     move.b  D0,($0423,A4)
                            	  2379:     ; It also means that we went past the end of the save slot
                            	  2380:     ; info name. Set the offset to the beginning of the name.
02:000338BA 7600            	  2381:     moveq   #0,D3
02:000338BC 162C0016        	  2382:     move.b  ($0016,A4),D3
02:000338C0 41F900033202    	  2383:     lea     (SlotToNameOffset).l,A0
02:000338C6 10303000        	  2384:     move.b  (A0,D3.W),D0
02:000338CA 19400421        	  2385:     move.b  D0,($0421,A4)
                            	  2386:     ; If the name cursor has gone past the end of the field,
                            	  2387:     ; then wrap around.
02:000338CE 102C0070        	  2388:     move.b  ($0070,A4),D0
02:000338D2 0C0000B0        	  2389:     cmpi.b  #$B0,D0
02:000338D6 6640            	  2390:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:000338D8 7070            	  2391:     moveq   #112,D0
02:000338DA 19400070        	  2392:     move.b  D0,($0070,A4)
                            	  2393:     even
                            	  2394: ; PATCH P25b: FS2-E backspace handler.
                            	  2395: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2396: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2397: ; one column (8 px), and writes a space ($24) to the erased
                            	  2398: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2399: ; cannot cross into a previous slot's name field.
                            	  2400: _L_z02_ModeE_HandleAOrB_Backspace:
02:000338DE 7600            	  2401:     moveq   #0,D3
02:000338E0 162C0016        	  2402:     move.b  ($0016,A4),D3        ; D3 = current slot
02:000338E4 41F900033202    	  2403:     lea     (SlotToNameOffset).l,A0
02:000338EA 12303000        	  2404:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:000338EE 102C0421        	  2405:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:000338F2 B001            	  2406:     cmp.b   D1,D0
02:000338F4 6322            	  2407:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:000338F6 5300            	  2408:     subq.b  #1,D0
02:000338F8 19400421        	  2409:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:000338FC 532C0423        	  2410:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00033900 122C0070        	  2411:     move.b  ($0070,A4),D1
02:00033904 5101            	  2412:     subi.b  #8,D1
02:00033906 19410070        	  2413:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:0003390A 7224            	  2414:     moveq   #$24,D1              ; space tile
02:0003390C 7600            	  2415:     moveq   #0,D3
02:0003390E 1600            	  2416:     move.b  D0,D3                ; D3 = erased offset
02:00033910 41EC0638        	  2417:     lea     ($0638,A4),A0
02:00033914 11813000        	  2418:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2419:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2420:     even
                            	  2421: _L_z02_ModeE_HandleAOrB_Exit:
02:00033918 60000096        	  2422:     jmp     ModeE_SetNameCursorSpriteX
                            	  2423: 
                            	  2424:     even
                            	  2425: ModeEandF_SetUpCursorSprites:
                            	  2426:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2427:     ; Sprites block. Only sprite 0 byte 0 is missing.
