                            	  8842:     ; Save the object index.
                            	  8843:     ;
02:0003C140 102C0340        	  8844:     move.b  ($0340,A4),D0
02:0003C144 1B00            	  8845:     move.b  D0,-(A5)  ; PHA
                            	  8846:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8847:     ;
02:0003C146 7402            	  8848:     moveq   #2,D2
                            	  8849:     even
                            	  8850: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003C148 19420340        	  8851:     move.b  D2,($0340,A4)
                            	  8852:     ; If object slot < 5 or = 7, then move every frame.
                            	  8853:     ; Else move 3 out of every 4 frames.
                            	  8854:     ;
                            	  8855:     ; This makes pieces spread out in somewhat of a circle,
                            	  8856:     ; by making the pieces at cardinal directions move at
                            	  8857:     ; full speed while the diagonal ones move a little slower.
                            	  8858:     ;
02:0003C14C 0C020005        	  8859:     cmpi.b  #$05,D2
02:0003C150 6510            	  8860:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003C152 0C020007        	  8861:     cmpi.b  #$07,D2
02:0003C156 670A            	  8862:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003C158 102C0015        	  8863:     move.b  ($0015,A4),D0
02:0003C15C 02000003        	  8864:     andi.b #$03,D0
02:0003C160 6704            	  8865:     beq  _anon_z04_164
                            	  8866:     even
                            	  8867: _L_z04_Ganon_DrawBurst_Move:
