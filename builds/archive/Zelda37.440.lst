02:0002BFB0 08000008        	  2514:     btst    #8,D0
02:0002BFB4 670A            	  2515:     beq.s   .cc_cnras
02:0002BFB6 003C0001        	  2516:     ori     #$01,CCR
02:0002BFBA 0A3C0001        	  2517:     eori    #$01,CCR
02:0002BFBE 4E75            	  2518:     rts
                            	  2519: .cc_cnras:
02:0002BFC0 023C00FE        	  2520:     andi    #$FE,CCR
02:0002BFC4 0A3C0001        	  2521:     eori    #$01,CCR
02:0002BFC8 4E75            	  2522:     rts
