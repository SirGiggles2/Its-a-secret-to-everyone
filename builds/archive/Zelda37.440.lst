02:0003A0E6 4EB9000494C8    	  4521:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  4522:     ; If this is a child digdogger, then go draw it.
                            	  4523:     ;
02:0003A0EC 41EC046B        	  4524:     lea     ($046B,A4),A0
