02:00048914 52302000        	  5054:     addq.b  #1,(A0,D2.W)
02:00048918 41EC00AC        	  5055:     lea     ($00AC,A4),A0
02:0004891C 10302000        	  5056:     move.b  (A0,D2.W),D0
02:00048920 0200000F        	  5057:     andi.b #$0F,D0
02:00048924 0C000003        	  5058:     cmpi.b  #$03,D0
02:00048928 674C            	  5059:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004892A 103C00FF        	  5060:     move.b  #$FF,D0
02:0004892E 19802028        	  5061:     move.b  D0,($28,A4,D2.W)
                            	  5062:     even
