02:00034E9E 123C0010        	  4494:     move.b  #$10,D1
02:00034EA2 0A3C0010        	  4495:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034EA6 9101            	  4496:     subx.b  D1,D0   ; SBC #$10
02:00034EA8 0A3C0010        	  4497:     eori    #$10,CCR  ; restore X = 6502 C
