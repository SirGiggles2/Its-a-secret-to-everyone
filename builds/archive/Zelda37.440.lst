02:00041DBE 122C0656        	  8895:     move.b  ($0656,A4),D1
02:00041DC2 B001            	  8896:     cmp.b   D1,D0
02:00041DC4 6710            	  8897:     beq  _L_z05_UpdateSubmenuSelection_CancelTune
                            	  8898:     ; Else the selection changed. The new slot should have an item.
                            	  8899:     ; If it does not, then cancel the "selection changed" tune.
                            	  8900:     ;
02:00041DC6 7600            	  8901:     moveq   #0,D3
02:00041DC8 162C0656        	  8902:     move.b  ($0656,A4),D3
02:00041DCC 41EC0657        	  8903:     lea     ($0657,A4),A0
02:00041DD0 10303000        	  8904:     move.b  (A0,D3.W),D0
