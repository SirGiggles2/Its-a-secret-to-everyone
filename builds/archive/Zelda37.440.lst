02:0003AA62 41EC0394        	  5772:     lea     ($0394,A4),A0
02:0003AA66 10302000        	  5773:     move.b  (A0,D2.W),D0
02:0003AA6A 670A            	  5774:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003AA6C 41EC0394        	  5775:     lea     ($0394,A4),A0
