02:00039036 41F900038FF2    	  2199:     lea     (SecretArmosXs).l,A0
02:0003903C 12303000        	  2200:     move.b  (A0,D3.W),D1
02:00039040 B001            	  2201:     cmp.b   D1,D0
02:00039042 6636            	  2202:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2203:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2204:     ;
02:00039044 41EC0084        	  2205:     lea     ($0084,A4),A0
02:00039048 10302000        	  2206:     move.b  (A0,D2.W),D0
