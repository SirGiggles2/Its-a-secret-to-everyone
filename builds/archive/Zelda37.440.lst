                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:000401C0 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:000401C4 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:000401C6 7020            	  5652:     moveq   #32,D0
