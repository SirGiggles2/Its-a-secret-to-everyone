02:000403B8 E308            	  5920:     lsl.b  #1,D0   ; ASL A
02:000403BA 1880            	  5921:     move.b  D0,($0000,A4)
02:000403BC 4EB900030A20    	  5922:     jsr     AddToInt16At2
02:000403C2 1014            	  5923:     move.b  ($0000,A4),D0
02:000403C4 4EB900030A20    	  5924:     jsr     AddToInt16At2
