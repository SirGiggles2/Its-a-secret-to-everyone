                            	  8567: Ganon_MoveAndShoot:
                            	  8568:     ; Change the animation frame every screen frame; so that
                            	  8569:     ; when Ganon is hit, he appears in a random pose.
                            	  8570:     ;
02:0003BF32 41EC046B        	  8571:     lea     ($046B,A4),A0
02:0003BF36 52302000        	  8572:     addq.b  #1,(A0,D2.W)
                            	  8573:     ; The animation cycle has 6 frames.
                            	  8574:     ;
02:0003BF3A 41EC046B        	  8575:     lea     ($046B,A4),A0
02:0003BF3E 10302000        	  8576:     move.b  (A0,D2.W),D0
02:0003BF42 0C000006        	  8577:     cmpi.b  #$06,D0
02:0003BF46 660A            	  8578:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003BF48 7000            	  8579:     moveq   #0,D0
02:0003BF4A 41EC046B        	  8580:     lea     ($046B,A4),A0
02:0003BF4E 11802000        	  8581:     move.b  D0,(A0,D2.W)
                            	  8582:     even
