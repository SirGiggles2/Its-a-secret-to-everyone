02:000398E0 41EC0412        	  3442:     lea     ($0412,A4),A0
02:000398E4 16302000        	  3443:     move.b  (A0,D2.W),D3
02:000398E8 41F90003971A    	  3444:     lea     (WallmasterDirsAndAttrsLeft).l,A0
