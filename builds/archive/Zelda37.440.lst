02:00049062 163C00A0        	  6071:     move.b  #$A0,D3
                            	  6072: _anon_z07_35:
02:00049066 1003            	  6073:     move.b  D3,D0
02:00049068 41EC03BC        	  6074:     lea     ($03BC,A4),A0
