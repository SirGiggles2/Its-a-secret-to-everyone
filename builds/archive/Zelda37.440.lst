                            	  8810: _L_z05_UpdateSubmenuSelection_DrawCursor:
                            	  8811:     ; Look up the X coordinate for the selected item slot.
                            	  8812:     ; Set it for the left cursor sprite.
                            	  8813:     ; Then add 8 to set the right cursor sprite's X.
                            	  8814:     ;
02:00041D30 41F900041CC2    	  8815:     lea     (SubmenuCursorXs).l,A0
02:00041D36 10303000        	  8816:     move.b  (A0,D3.W),D0
02:00041D3A 1940021F        	  8817:     move.b  D0,($021F,A4)
02:00041D3E 023C00EE        	  8818:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D42 123C0008        	  8819:     move.b  #$08,D1
02:00041D46 D101            	  8820:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041D48 19400223        	  8821:     move.b  D0,($0223,A4)
                            	  8822:     ; The Y coordinate is $36 for item slots < 5, else $46.
                            	  8823:     ;
02:00041D4C 7036            	  8824:     moveq   #54,D0
02:00041D4E 0C030005        	  8825:     cmpi.b  #$05,D3
02:00041D52 6502            	  8826:     bcs  _anon_z05_214
02:00041D54 7046            	  8827:     moveq   #70,D0
                            	  8828: _anon_z05_214:
