                            	  4728: ;==============================================================================
                            	  4729: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4730: ;==============================================================================
                            	  4731: 
                            	  4732:     xref    _ShootIfWanted
                            	  4733: 
                            	  4734: ; ShootIfWanted(type, slot)
                            	  4735: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4736: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4737: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4738: c_shoot_if_wanted:
02:0002CF08 2F02            	  4739:     move.l  D2,-(SP)
02:0002CF0A 202F0008        	  4740:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CF0E 242F000C        	  4741:     move.l  12(SP),D2       ; arg2 = slot
02:0002CF12 4EB90003C62E    	  4742:     jsr     _ShootIfWanted
02:0002CF18 640C            	  4743:     bcc.s   .csiw_fail
02:0002CF1A 7000            	  4744:     moveq   #0,D0
02:0002CF1C 1003            	  4745:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CF1E 008000000100    	  4746:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF24 6002            	  4747:     bra.s   .csiw_done
                            	  4748: .csiw_fail:
02:0002CF26 7000            	  4749:     moveq   #0,D0
                            	  4750: .csiw_done:
02:0002CF28 241F            	  4751:     move.l  (SP)+,D2
02:0002CF2A 4E75            	  4752:     rts
