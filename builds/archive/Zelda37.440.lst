02:0003A866 003C0011        	  5520:     ori     #$11,CCR  ; SEC: set C+X
02:0003A86A 123C0003        	  5521:     move.b  #$03,D1
02:0003A86E 0A3C0010        	  5522:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A872 9101            	  5523:     subx.b  D1,D0   ; SBC #$03
02:0003A874 0A3C0010        	  5524:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A878 41EC0084        	  5525:     lea     ($0084,A4),A0
02:0003A87C 11802000        	  5526:     move.b  D0,(A0,D2.W)
