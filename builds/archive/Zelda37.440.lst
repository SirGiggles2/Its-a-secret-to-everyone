                            	  2156: InitArmosOrFlyingGhini:
                            	  2157:     ; In UpdateObject, this object was flagged "initialized".
                            	  2158:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2159:     ;
02:00038FFA 10342028        	  2160:     move.b  ($28,A4,D2.W),D0
02:00038FFE 41EC0492        	  2161:     lea     ($0492,A4),A0
02:00039002 11802000        	  2162:     move.b  D0,(A0,D2.W)
                            	  2163:     ; If it's still fading in, then go finish some initialization needed
                            	  2164:     ; for fading in.
                            	  2165:     ;
02:00039006 660000B6        	  2166:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2167:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2168:     ; go finish initializing it.
                            	  2169:     ;
02:0003900A 41EC034F        	  2170:     lea     ($034F,A4),A0
02:0003900E 10302000        	  2171:     move.b  (A0,D2.W),D0
02:00039012 0C000022        	  2172:     cmpi.b  #$22,D0
02:00039016 670000A6        	  2173:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2174:     ; Else we have an armos.
