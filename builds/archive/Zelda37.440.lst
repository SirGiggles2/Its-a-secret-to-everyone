                            	  1743: L69BE_Exit:
02:000309EC 4E75            	  1744:     rts
                            	  1745: 
                            	  1746: ; Returns:
                            	  1747: ; X: last object slot tested, regardless of whether it's empty
                            	  1748: ;
                            	  1749: ; Fails if no empty slot was found, or the blue candle was already used.
                            	  1750: ;
                            	  1751: ;
                            	  1752: ; Look in slots $10 and $11. If none are empty, return.
                            	  1753: ; Otherwise, X will have the empty slot found.
                            	  1754: ;
                            	  1755: ; Note that it's possible that we fail to find an empty slot,
                            	  1756: ; but the caller might find slot X occupied by a fire made earlier.
                            	  1757: ;
                            	  1758:     even
