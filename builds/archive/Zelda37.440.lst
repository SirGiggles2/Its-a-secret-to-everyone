                            	  4596: Aquamentus_Move:
                            	  4597:     ; The monster uses grid offset to mean distance remaining.
                            	  4598:     ; If there's more distance to cover, then go move.
                            	  4599:     ;
02:0003A182 41EC0394        	  4600:     lea     ($0394,A4),A0
02:0003A186 10302000        	  4601:     move.b  (A0,D2.W),D0
02:0003A18A 662C            	  4602:     bne  _L_z04_Aquamentus_Move_Move
                            	  4603:     ; Set a random distance to move of 7 or $F pixels.
                            	  4604:     ;
02:0003A18C 10342018        	  4605:     move.b  ($18,A4,D2.W),D0
02:0003A190 1B00            	  4606:     move.b  D0,-(A5)  ; PHA
02:0003A192 0200000F        	  4607:     andi.b #$0F,D0
02:0003A196 00000007        	  4608:     ori.b #$07,D0
02:0003A19A 41EC0394        	  4609:     lea     ($0394,A4),A0
02:0003A19E 11802000        	  4610:     move.b  D0,(A0,D2.W)
02:0003A1A2 101D            	  4611:     move.b  (A5)+,D0  ; PLA
                            	  4612:     ; Randomly head left or right.
                            	  4613:     ;
02:0003A1A4 02000001        	  4614:     andi.b #$01,D0
02:0003A1A8 7600            	  4615:     moveq   #0,D3
02:0003A1AA 1600            	  4616:     move.b  D0,D3
02:0003A1AC 5203            	  4617:     addq.b  #1,D3
02:0003A1AE 41EC0098        	  4618:     lea     ($0098,A4),A0
02:0003A1B2 11832000        	  4619:     move.b  D3,(A0,D2.W)
02:0003A1B6 4E75            	  4620:     rts
                            	  4621: 
                            	  4622:     even
                            	  4623: _L_z04_Aquamentus_Move_Move:
                            	  4624:     ; 7 of 8 screen frames return without moving.
                            	  4625:     ;
