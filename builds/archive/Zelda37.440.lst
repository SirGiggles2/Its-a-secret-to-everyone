02:0003A1E6 103C00C7        	  4648:     move.b  #$C7,D0
02:0003A1EA 19802070        	  4649:     move.b  D0,($70,A4,D2.W)
02:0003A1EE 7002            	  4650:     moveq   #2,D0
02:0003A1F0 41EC0098        	  4651:     lea     ($0098,A4),A0
02:0003A1F4 11802000        	  4652:     move.b  D0,(A0,D2.W)
                            	  4653:     even
                            	  4654: _L_z04_Aquamentus_Move_SetRemainingDistance:
