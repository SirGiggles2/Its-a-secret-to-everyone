02:00038C88 10302000        	  1688:     move.b  (A0,D2.W),D0
02:00038C8C 0C000011        	  1689:     cmpi.b  #$11,D0
02:00038C90 6614            	  1690:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038C92 41EC00AC        	  1691:     lea     ($00AC,A4),A0
02:00038C96 10302000        	  1692:     move.b  (A0,D2.W),D0
02:00038C9A 0C000002        	  1693:     cmpi.b  #$02,D0
