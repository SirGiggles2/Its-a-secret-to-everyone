                            	  5045:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5046:     ; If we reach state $83, then go deactivate the object.
                            	  5047:     ;
                            	  5048:     ; Nothing changes between the states. So, they are used as
                            	  5049:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5050:     ;
02:0004890A 10342028        	  5051:     move.b  ($28,A4,D2.W),D0
