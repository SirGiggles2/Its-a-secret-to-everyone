                            	  5808: UpdateSwordOrRod:
                            	  5809:     ; If state = 0, the object is not active. So, return.
                            	  5810:     ;
02:00048E64 41EC00AC        	  5811:     lea     ($00AC,A4),A0
02:00048E68 10302000        	  5812:     move.b  (A0,D2.W),D0
02:00048E6C 0200000F        	  5813:     andi.b #$0F,D0
02:00048E70 674C            	  5814:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5815:     ; Decrement the state timer.
                            	  5816:     ; If it hasn't expired, go move the sword or rod.
                            	  5817:     ;
02:00048E72 41EC03D0        	  5818:     lea     ($03D0,A4),A0
02:00048E76 53302000        	  5819:     subq.b  #1,(A0,D2.W)
02:00048E7A 6644            	  5820:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5821:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5822:     ;
02:00048E7C 41EC00AC        	  5823:     lea     ($00AC,A4),A0
02:00048E80 10302000        	  5824:     move.b  (A0,D2.W),D0
02:00048E84 0200000F        	  5825:     andi.b #$0F,D0
02:00048E88 7600            	  5826:     moveq   #0,D3
02:00048E8A 1600            	  5827:     move.b  D0,D3
02:00048E8C 7008            	  5828:     moveq   #8,D0
02:00048E8E 5303            	  5829:     subq.b  #1,D3
02:00048E90 6702            	  5830:     beq  _anon_z07_32
02:00048E92 7001            	  5831:     moveq   #1,D0
                            	  5832: _anon_z07_32:
                            	  5833:     ; Set both the player's animation counter and the sword's
                            	  5834:     ; animation counter/timer to this value.
                            	  5835:     ;
02:00048E94 194003D0        	  5836:     move.b  D0,($03D0,A4)
02:00048E98 41EC03D0        	  5837:     lea     ($03D0,A4),A0
02:00048E9C 11802000        	  5838:     move.b  D0,(A0,D2.W)
                            	  5839:     ; Go to the next state.
                            	  5840:     ;
02:00048EA0 41EC00AC        	  5841:     lea     ($00AC,A4),A0
02:00048EA4 52302000        	  5842:     addq.b  #1,(A0,D2.W)
                            	  5843:     ; Once we reach state 6, deactivate the object.
                            	  5844:     ; Otherwise, go draw it.
                            	  5845:     ;
02:00048EA8 41EC00AC        	  5846:     lea     ($00AC,A4),A0
02:00048EAC 10302000        	  5847:     move.b  (A0,D2.W),D0
02:00048EB0 0200000F        	  5848:     andi.b #$0F,D0
02:00048EB4 0C000006        	  5849:     cmpi.b  #$06,D0
02:00048EB8 6506            	  5850:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:00048EBA 610001C2        	  5851:     jsr     ResetObjState
