02:0003909C 7003            	  2276:     moveq   #3,D0
02:0003909E 41EC0394        	  2277:     lea     ($0394,A4),A0
02:000390A2 11802000        	  2278:     move.b  D0,(A0,D2.W)
                            	  2279:     ; Set a speed (q-speed fraction) randomly:
