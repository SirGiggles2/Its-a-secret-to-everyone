02:0003BD38 41EC0098        	  8270:     lea     ($0098,A4),A0
02:0003BD3C 11802000        	  8271:     move.b  D0,(A0,D2.W)
                            	  8272:     ; Set angle $18 (N).
                            	  8273:     ;
02:0003BD40 7018            	  8274:     moveq   #24,D0
02:0003BD42 41EC0394        	  8275:     lea     ($0394,A4),A0
02:0003BD46 11802000        	  8276:     move.b  D0,(A0,D2.W)
                            	  8277:     ; This location is right above Patra.
                            	  8278:     ; Set X coordinate to Patra's.
                            	  8279:     ;
02:0003BD4A 102C0071        	  8280:     move.b  ($0071,A4),D0
02:0003BD4E 19802070        	  8281:     move.b  D0,($70,A4,D2.W)
                            	  8282:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  8283:     ; Else use radius $18. Store the chosen value in [00].
                            	  8284:     ;
02:0003BD52 702C            	  8285:     moveq   #44,D0
02:0003BD54 7600            	  8286:     moveq   #0,D3
02:0003BD56 41EC034F        	  8287:     lea     ($034F,A4),A0
02:0003BD5A 16302000        	  8288:     move.b  (A0,D2.W),D3
02:0003BD5E 0C030025        	  8289:     cmpi.b  #$25,D3
02:0003BD62 6702            	  8290:     beq  _anon_z04_158
02:0003BD64 7018            	  8291:     moveq   #24,D0
                            	  8292: _anon_z04_158:
02:0003BD66 1880            	  8293:     move.b  D0,($0000,A4)
                            	  8294:     ; This location is right above Patra.
                            	  8295:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  8296:     ;
02:0003BD68 102C0085        	  8297:     move.b  ($0085,A4),D0
02:0003BD6C 003C0011        	  8298:     ori     #$11,CCR  ; SEC: set C+X
02:0003BD70 1214            	  8299:     move.b  ($0000,A4),D1
02:0003BD72 0A3C0010        	  8300:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BD76 9101            	  8301:     subx.b  D1,D0   ; SBC $00
02:0003BD78 0A3C0010        	  8302:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BD7C 41EC0084        	  8303:     lea     ($0084,A4),A0
02:0003BD80 11802000        	  8304:     move.b  D0,(A0,D2.W)
                            	  8305:     even
