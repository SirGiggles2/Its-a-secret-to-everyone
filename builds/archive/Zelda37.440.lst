02:0003381E 5303            	  2299:     subq.b  #1,D3
02:00033820 6AE8            	  2300:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033822 522C0420        	  2301:     addq.b  #1,($0420,A4)
                            	  2302:     even
                            	  2303: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2304:     ; At this point:
                            	  2305:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2306:     ;   - This will be changed as the player inputs characters.
                            	  2307:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2308:     ;   - This will be changed as the player inputs characters.
                            	  2309:     ; - InitializedNameField [$0420] is set to 1.
                            	  2310:     ;
02:00033826 102C00F8        	  2311:     move.b  ($00F8,A4),D0
02:0003382A 020000C0        	  2312:     andi.b #$C0,D0
02:0003382E 670000E8        	  2313:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2314:     ; A or B was pressed.
                            	  2315:     ;
02:00033832 0C000040        	  2316:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033836 660000A6        	  2317:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2318:     ; A was pressed.
                            	  2319:     ;
                            	  2320:     ; Request to play the character click tune (same as bomb set).
02:0003383A 7620            	  2321:     moveq   #32,D3
02:0003383C 19430604        	  2322:     move.b  D3,($0604,A4)
02:00033840 7602            	  2323:     moveq   #2,D3
                            	  2324:     even
                            	  2325: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033842 41EC0422        	  2326:     lea     ($0422,A4),A0
02:00033846 10303000        	  2327:     move.b  (A0,D3.W),D0
02:0003384A 41EC0302        	  2328:     lea     ($0302,A4),A0
02:0003384E 11803000        	  2329:     move.b  D0,(A0,D3.W)
02:00033852 5303            	  2330:     subq.b  #1,D3
02:00033854 6AEC            	  2331:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033856 19430306        	  2332:     move.b  D3,($0306,A4)
02:0003385A 7400            	  2333:     moveq   #0,D2
02:0003385C 142C0421        	  2334:     move.b  ($0421,A4),D2
02:00033860 7600            	  2335:     moveq   #0,D3
02:00033862 162C041F        	  2336:     move.b  ($041F,A4),D3
02:00033866 41F9000331A6    	  2337:     lea     (ModeE_CharMap).l,A0
02:0003386C 10303000        	  2338:     move.b  (A0,D3.W),D0
02:00033870 19400305        	  2339:     move.b  D0,($0305,A4)
