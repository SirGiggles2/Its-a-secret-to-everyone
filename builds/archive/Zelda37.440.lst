                            	  1466: InitMode4:
02:0003D970 7400            	  1467:     moveq   #0,D2
02:0003D972 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003D976 6604            	  1469:     bne.s  __far_z_05_0023
02:0003D978 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003D97C 5302            	  1472:     subq.b  #1,D2
02:0003D97E 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003D980 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003D984 6B06            	  1492:     bmi  _anon_z05_40
02:0003D986 6100348E        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003D98A 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003D98C 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003D990 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
