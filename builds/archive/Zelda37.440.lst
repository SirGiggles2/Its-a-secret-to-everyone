02:00038B0A 10302000        	  1494:     move.b  (A0,D2.W),D0
02:00038B0E 023C00EE        	  1495:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B12 1214            	  1496:     move.b  ($0000,A4),D1
02:00038B14 D101            	  1497:     addx.b  D1,D0   ; ADC $00
