                            	  4813:     ;   $57 (sword shot) => $22
                            	  4814:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4815:     ;
02:00048792 7622            	  4816:     moveq   #34,D3
02:00048794 0C02000D        	  4817:     cmpi.b  #$0D,D2
02:00048798 6410            	  4818:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004879A 41EC034F        	  4819:     lea     ($034F,A4),A0
02:0004879E 10302000        	  4820:     move.b  (A0,D2.W),D0
02:000487A2 0C000057        	  4821:     cmpi.b  #$57,D0
02:000487A6 6710            	  4822:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:000487A8 660C            	  4823:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4824:     even
                            	  4825: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4826:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4827:     ;   high bit set (magic)   => $23
                            	  4828:     ;   high bit clear (sword) => $22
                            	  4829:     ;
02:000487AA 41EC00AC        	  4830:     lea     ($00AC,A4),A0
02:000487AE 10302000        	  4831:     move.b  (A0,D2.W),D0
02:000487B2 E308            	  4832:     lsl.b  #1,D0   ; ASL A
02:000487B4 6402            	  4833:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4834:     even
