02:0003A1C0 666C            	  4628:     bne  _L_z04_Aquamentus_Move_Exit
                            	  4629:     ; If the boss crossed the left limit, then
                            	  4630:     ; put it back at the left limit ($88), and face right.
                            	  4631:     ;
02:0003A1C2 10342070        	  4632:     move.b  ($70,A4,D2.W),D0
02:0003A1C6 0C000088        	  4633:     cmpi.b  #$88,D0
02:0003A1CA 6414            	  4634:     bcc  _L_z04_Aquamentus_Move_CheckRightLimit
02:0003A1CC 103C0088        	  4635:     move.b  #$88,D0
02:0003A1D0 19802070        	  4636:     move.b  D0,($70,A4,D2.W)
02:0003A1D4 7001            	  4637:     moveq   #1,D0
02:0003A1D6 41EC0098        	  4638:     lea     ($0098,A4),A0
02:0003A1DA 11802000        	  4639:     move.b  D0,(A0,D2.W)
02:0003A1DE 6618            	  4640:     bne  _L_z04_Aquamentus_Move_SetRemainingDistance
                            	  4641:     even
