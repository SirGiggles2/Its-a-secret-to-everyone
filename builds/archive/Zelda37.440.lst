02:00049006 41EC00AC        	  6022:     lea     ($00AC,A4),A0
02:0004900A 10302000        	  6023:     move.b  (A0,D2.W),D0
02:0004900E 6706            	  6024:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00049010 E308            	  6025:     lsl.b  #1,D0   ; ASL A
02:00049012 6402            	  6026:     bcc.s  __far_z_07_0089
02:00049014 6066            	  6027:     jmp  L1F854_Exit
