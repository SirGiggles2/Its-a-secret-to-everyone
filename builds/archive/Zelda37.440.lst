                            	  8931: Ganon_DrawBody:
                            	  8932:     ; Loop over four 16x16 images that make up Ganon.
                            	  8933:     ; There are 6 animation frames.
                            	  8934:     ;
02:0003C1E4 7603            	  8935:     moveq   #3,D3
                            	  8936:     even
                            	  8937: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8938:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8939:     ;
02:0003C1E6 10342070        	  8940:     move.b  ($70,A4,D2.W),D0
02:0003C1EA 023C00EE        	  8941:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C1EE 41F90003C1D8    	  8942:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C1F4 12303000        	  8943:     move.b  (A0,D3.W),D1
02:0003C1F8 D101            	  8944:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C1FA 1880            	  8945:     move.b  D0,($0000,A4)
                            	  8946:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8947:     ;
02:0003C1FC 41EC0084        	  8948:     lea     ($0084,A4),A0
02:0003C200 10302000        	  8949:     move.b  (A0,D2.W),D0
02:0003C204 023C00EE        	  8950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C208 41F90003C1DC    	  8951:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C20E 12303000        	  8952:     move.b  (A0,D3.W),D1
02:0003C212 D101            	  8953:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C214 19400001        	  8954:     move.b  D0,($0001,A4)
                            	  8955:     ; Each part has a horizontal flipping flag.
                            	  8956:     ;
02:0003C218 41F90003C1E0    	  8957:     lea     (GanonSpriteHFlips).l,A0
02:0003C21E 10303000        	  8958:     move.b  (A0,D3.W),D0
02:0003C222 1940000F        	  8959:     move.b  D0,($000F,A4)
                            	  8960:     ; Save and copy the loop index (the current part) to [07].
                            	  8961:     ;
02:0003C226 1003            	  8962:     move.b  D3,D0
02:0003C228 1B00            	  8963:     move.b  D0,-(A5)  ; PHA
02:0003C22A 19400007        	  8964:     move.b  D0,($0007,A4)
                            	  8965:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8966:     ; that make it up.
                            	  8967:     ;
02:0003C22E 41EC046B        	  8968:     lea     ($046B,A4),A0
02:0003C232 10302000        	  8969:     move.b  (A0,D2.W),D0
02:0003C236 E308            	  8970:     lsl.b  #1,D0   ; ASL A
02:0003C238 E308            	  8971:     lsl.b  #1,D0   ; ASL A
                            	  8972:     ; Add [07] -- the index of the current part.
                            	  8973:     ;
                            	  8974:     ; Now you have an index into the frame image table, for the
                            	  8975:     ; current image part of the current animation frame.
                            	  8976:     ;
02:0003C23A 122C0007        	  8977:     move.b  ($0007,A4),D1
02:0003C23E D101            	  8978:     addx.b  D1,D0   ; ADC $07
02:0003C240 7600            	  8979:     moveq   #0,D3
02:0003C242 1600            	  8980:     move.b  D0,D3
02:0003C244 41F90003C1C0    	  8981:     lea     (GanonFrameImages).l,A0
02:0003C24A 10303000        	  8982:     move.b  (A0,D3.W),D0
02:0003C24E 4EB900030D64    	  8983:     jsr     DrawObjectNotMirrored
02:0003C254 101D            	  8984:     move.b  (A5)+,D0  ; PLA
                            	  8985:     ; Bottom of the part loop.
                            	  8986:     ;
02:0003C256 7600            	  8987:     moveq   #0,D3
02:0003C258 1600            	  8988:     move.b  D0,D3
02:0003C25A 5303            	  8989:     subq.b  #1,D3
02:0003C25C 6A88            	  8990:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C25E 4E75            	  8991:     rts
