02:0002CDDC 242F000C        	  4557:     move.l  12(SP),D2       ; slot arg → D2
02:0002CDE0 4EB90003C63C    	  4558:     jsr     ShootLimited
02:0002CDE6 7000            	  4559:     moveq   #0,D0
02:0002CDE8 6406            	  4560:     bcc.s   .csl_no_carry
02:0002CDEA 008000000100    	  4561:     ori.l   #$100,D0
