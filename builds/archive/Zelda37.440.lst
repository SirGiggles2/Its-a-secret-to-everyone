02:0003EA74 1014            	  3870:     move.b  ($0000,A4),D0
02:0003EA76 41F90003EA50    	  3871:     lea     (DoorwayRequiredCoord).l,A0
02:0003EA7C 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003EA80 B001            	  3873:     cmp.b   D1,D0
02:0003EA82 6622            	  3874:     bne  _anon_z05_95
02:0003EA84 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003EA88 41F90003EA54    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003EA8E 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003EA92 B001            	  3878:     cmp.b   D1,D0
02:0003EA94 6510            	  3879:     bcs  _anon_z05_95
02:0003EA96 41F90003EA58    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EA9C 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003EAA0 B001            	  3882:     cmp.b   D1,D0
02:0003EAA2 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
02:0003EAA6 5303            	  3885:     subq.b  #1,D3
02:0003EAA8 6ACA            	  3886:     bpl  _L_z05_CheckDoorway_LoopOverflowBounds
                            	  3887:     even
                            	  3888: _L_z05_CheckDoorway_NotInDoorway:
                            	  3889:     ; Not in any doorway. Reset DoorwayDir.
