                            	  8606: Ganon_UpdateBrownState:
                            	  8607:     ; Every other frame decrement the state.
                            	  8608:     ; But every frame draw Ganon either translucent or opaque.
                            	  8609:     ;
02:0003BF74 102C0015        	  8610:     move.b  ($0015,A4),D0
02:0003BF78 E208            	  8611:     lsr.b  #1,D0   ; LSR A
02:0003BF7A 6410            	  8612:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003BF7C 41EC00AC        	  8613:     lea     ($00AC,A4),A0
02:0003BF80 53302000        	  8614:     subq.b  #1,(A0,D2.W)
                            	  8615:     ; If the state becomes 0, then Ganon is blue again.
                            	  8616:     ; Go switch his palette row to reflect it.
