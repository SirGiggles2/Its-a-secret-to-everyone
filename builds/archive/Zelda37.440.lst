                            	  8869: _anon_z04_164:
02:0003C166 4EB9000494CE    	  8870:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8871:     ; The frame counter will make the sprite flash.
                            	  8872:     ; The array has the horizontal and vertical flipping attributes.
                            	  8873:     ; Combine them into [03].
                            	  8874:     ;
02:0003C16C 102C0015        	  8875:     move.b  ($0015,A4),D0
02:0003C170 02000003        	  8876:     andi.b #$03,D0
02:0003C174 41F90003C044    	  8877:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C17A 12302000        	  8878:     move.b  (A0,D2.W),D1
02:0003C17E 8001            	  8879:     or.b  D1,D0
02:0003C180 19400003        	  8880:     move.b  D0,($0003,A4)
02:0003C184 41F90003C04E    	  8881:     lea     (GanonBurstTiles).l,A0
02:0003C18A 10302000        	  8882:     move.b  (A0,D2.W),D0
02:0003C18E 4EB900031060    	  8883:     jsr     Anim_WriteSprite
                            	  8884:     ; Bottom of the loop.
