02:0003BEC0 7002            	  8479:     moveq   #2,D0
02:0003BEC2 19400601        	  8480:     move.b  D0,($0601,A4)
                            	  8481: _anon_z04_160:
02:0003BEC6 0A3C0001        	  8482:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BECA 4E75            	  8483:     rts
                            	  8484: 
                            	  8485: ; Description:
                            	  8486: ; Lift up the Triforce of Courage while the room is light.
                            	  8487: ;
                            	  8488: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8489: ;
                            	  8490:     even
                            	  8491: Ganon_ScenePhase1:
02:0003BECC 701B            	  8492:     moveq   #27,D0
02:0003BECE 19400505        	  8493:     move.b  D0,($0505,A4)
                            	  8494:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8495:     ;
02:0003BED2 102C0028        	  8496:     move.b  ($0028,A4),D0
02:0003BED6 6702            	  8497:     beq.s  __far_z_04_0093
02:0003BED8 6012            	  8498:     jmp  Ganon_DrawBodyFrame0
                            	  8499: __far_z_04_0093:
                            	  8500:     ; Once the timer expires:
                            	  8501:     ; 1. unhalt Link
                            	  8502:     ; 2. clear the item to lift
                            	  8503:     ; 3. play level 9 song
                            	  8504:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8505:     ;
02:0003BEDA 194000AC        	  8506:     move.b  D0,($00AC,A4)
02:0003BEDE 19400505        	  8507:     move.b  D0,($0505,A4)
02:0003BEE2 7020            	  8508:     moveq   #32,D0
02:0003BEE4 19400600        	  8509:     move.b  D0,($0600,A4)
02:0003BEE8 522C0445        	  8510:     addq.b  #1,($0445,A4)
                            	  8511:     even
                            	  8512: Ganon_DrawBodyFrame0:
                            	  8513:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8514:     ; with animation frame 0.
                            	  8515:     ;
02:0003BEEC 7000            	  8516:     moveq   #0,D0
02:0003BEEE 41EC046B        	  8517:     lea     ($046B,A4),A0
02:0003BEF2 11802000        	  8518:     move.b  D0,(A0,D2.W)
02:0003BEF6 600002EC        	  8519:     jmp     Ganon_DrawBody
                            	  8520: 
                            	  8521: ; Description:
                            	  8522: ; Fighting Ganon.
                            	  8523: ;
                            	  8524: ; If Ganon is dying, go handle it.
                            	  8525: ;
                            	  8526:     even
                            	  8527: Ganon_ScenePhase2:
02:0003BEFA 41EC042C        	  8528:     lea     ($042C,A4),A0
02:0003BEFE 10302000        	  8529:     move.b  (A0,D2.W),D0
02:0003BF02 6704            	  8530:     beq.s  __far_z_04_0094
02:0003BF04 600000A4        	  8531:     jmp  Ganon_Dying
                            	  8532: __far_z_04_0094:
02:0003BF08 61000356        	  8533:     jsr     Ganon_CheckCollisions
02:0003BF0C 6100C356        	  8534:     jsr     PlayBossHitCryIfNeeded
                            	  8535:     ; Go handle the brown state specially.
                            	  8536:     ;
02:0003BF10 41EC00AC        	  8537:     lea     ($00AC,A4),A0
02:0003BF14 10302000        	  8538:     move.b  (A0,D2.W),D0
02:0003BF18 6702            	  8539:     beq.s  __far_z_04_0095
02:0003BF1A 6058            	  8540:     jmp  Ganon_UpdateBrownState
                            	  8541: __far_z_04_0095:
                            	  8542:     ; State = 0: Blue
                            	  8543:     ;
                            	  8544:     ; If timer = 0, then go move around and shoot.
                            	  8545:     ;
02:0003BF1C 10342028        	  8546:     move.b  ($28,A4,D2.W),D0
02:0003BF20 6602            	  8547:     bne.s  __far_z_04_0096
02:0003BF22 600E            	  8548:     jmp  Ganon_MoveAndShoot
                            	  8549: __far_z_04_0096:
                            	  8550:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8551:     ; Collisions were checked already.
                            	  8552:     ;
                            	  8553:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8554:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8555:     ;
02:0003BF24 0C000001        	  8556:     cmpi.b  #$01,D0
02:0003BF28 6702            	  8557:     beq.s  __far_z_04_0097
02:0003BF2A 6078            	  8558:     jmp  L_Ganon_DrawBody
                            	  8559: __far_z_04_0097:
                            	  8560: ; Description:
                            	  8561: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  8562: ;
                            	  8563:     even
                            	  8564: Ganon_RandomizeLocation:
02:0003BF2C 4EF90002BA30    	  8565:     jmp     c_ganon_randomize_location
