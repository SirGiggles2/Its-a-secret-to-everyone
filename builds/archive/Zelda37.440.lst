02:0003997A 4EB900030D64    	  3512:     jsr     DrawObjectNotMirrored
02:00039980 101D            	  3513:     move.b  (A5)+,D0  ; PLA
                            	  3514:     ; Store the offset of the left sprite record in [00],
                            	  3515:     ; and the right one in [01].
                            	  3516:     ;
