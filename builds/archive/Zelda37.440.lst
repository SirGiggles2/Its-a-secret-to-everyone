02:0003FFB8 123C0003        	  5361:     move.b  #$03,D1
02:0003FFBC 0A3C0010        	  5362:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FFC0 9101            	  5363:     subx.b  D1,D0   ; SBC #$03
02:0003FFC2 0A3C0010        	  5364:     eori    #$10,CCR  ; restore X = 6502 C
