                            	  3284: CheckCaveEdge:
02:0003E69E 4EB9000483D2    	  3285:     jsr     CheckScreenEdge
                            	  3286:     ; If the player touched the edge of the screen and triggered
                            	  3287:     ; a transition to another mode, then go set up the right mode.
                            	  3288:     ;
02:0003E6A4 102C0011        	  3289:     move.b  ($0011,A4),D0
02:0003E6A8 6602            	  3290:     bne.s  __far_z_05_0063
02:0003E6AA 60E4            	  3291:     jmp  GoToModeAFromCave
                            	  3292: __far_z_05_0063:
02:0003E6AC 4E75            	  3293:     rts
                            	  3294: 
                            	  3295: ; Params:
                            	  3296: ; [0F]: movement direction
                            	  3297: ;
                            	  3298: ; Returns:
                            	  3299: ; [0F]: movement direction or 0
                            	  3300: ;
                            	  3301: ;
                            	  3302: ; If the ladder's not in use, return.
                            	  3303: ;
                            	  3304:     even
                            	  3305: CheckLadder:
02:0003E6AE 7400            	  3306:     moveq   #0,D2
02:0003E6B0 142C0064        	  3307:     move.b  ($0064,A4),D2
02:0003E6B4 670000BE        	  3308:     beq  _L_z05_CheckLadder_Exit
                            	  3309:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3310:     ;
02:0003E6B8 41EC00AC        	  3311:     lea     ($00AC,A4),A0
02:0003E6BC 10302000        	  3312:     move.b  (A0,D2.W),D0
02:0003E6C0 670000A6        	  3313:     beq  _L_z05_CheckLadder_StashLadder
                            	  3314:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3315:     ; between the ladder and Link.
                            	  3316:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3317:     ;
02:0003E6C4 41EC0098        	  3318:     lea     ($0098,A4),A0
02:0003E6C8 10302000        	  3319:     move.b  (A0,D2.W),D0
02:0003E6CC 0200000C        	  3320:     andi.b #$0C,D0
02:0003E6D0 6734            	  3321:     beq  _anon_z05_85
02:0003E6D2 102C0070        	  3322:     move.b  ($0070,A4),D0
02:0003E6D6 12342070        	  3323:     move.b  ($70,A4,D2.W),D1
02:0003E6DA B001            	  3324:     cmp.b   D1,D0
02:0003E6DC 6600008A        	  3325:     bne  _L_z05_CheckLadder_StashLadder
02:0003E6E0 102C0084        	  3326:     move.b  ($0084,A4),D0
02:0003E6E4 023C00EE        	  3327:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6E8 123C0003        	  3328:     move.b  #$03,D1
02:0003E6EC D101            	  3329:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E6EE 003C0011        	  3330:     ori     #$11,CCR  ; SEC: set C+X
02:0003E6F2 41EC0084        	  3331:     lea     ($0084,A4),A0
02:0003E6F6 12302000        	  3332:     move.b  (A0,D2.W),D1
02:0003E6FA 0A3C0010        	  3333:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E6FE 9101            	  3334:     subx.b  D1,D0   ; SBC ObjY,X
02:0003E700 0A3C0010        	  3335:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E704 6030            	  3336:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3337: 
                            	  3338: _anon_z05_85:
                            	  3339:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3340:     ; between the ladder and Link.
                            	  3341:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3342:     ;
02:0003E706 102C0084        	  3343:     move.b  ($0084,A4),D0
02:0003E70A 023C00EE        	  3344:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E70E 123C0003        	  3345:     move.b  #$03,D1
02:0003E712 D101            	  3346:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E714 41EC0084        	  3347:     lea     ($0084,A4),A0
02:0003E718 12302000        	  3348:     move.b  (A0,D2.W),D1
02:0003E71C B001            	  3349:     cmp.b   D1,D0
02:0003E71E 6648            	  3350:     bne  _L_z05_CheckLadder_StashLadder
02:0003E720 102C0070        	  3351:     move.b  ($0070,A4),D0
02:0003E724 003C0011        	  3352:     ori     #$11,CCR  ; SEC: set C+X
02:0003E728 12342070        	  3353:     move.b  ($70,A4,D2.W),D1
02:0003E72C 0A3C0010        	  3354:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E730 9101            	  3355:     subx.b  D1,D0   ; SBC ObjX,X
02:0003E732 0A3C0010        	  3356:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3357:     even
                            	  3358: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3359:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3360:     ; If > $10, go put the ladder away.
                            	  3361:     ;
02:0003E736 4EB900030998    	  3362:     jsr     Abs
02:0003E73C 1880            	  3363:     move.b  D0,($0000,A4)
02:0003E73E 0C000010        	  3364:     cmpi.b  #$10,D0
02:0003E742 6532            	  3365:     bcs  _L_z05_CheckLadder_SetState2
02:0003E744 0C000010        	  3366:     cmpi.b  #$10,D0
02:0003E748 661E            	  3367:     bne  _L_z05_CheckLadder_StashLadder
                            	  3368:     ; Distance = $10. If player's not facing in the same direction as
                            	  3369:     ; the ladder, go put away the ladder.
                            	  3370:     ;
02:0003E74A 102C0098        	  3371:     move.b  ($0098,A4),D0
02:0003E74E 41EC0098        	  3372:     lea     ($0098,A4),A0
02:0003E752 12302000        	  3373:     move.b  (A0,D2.W),D1
02:0003E756 B001            	  3374:     cmp.b   D1,D0
02:0003E758 660E            	  3375:     bne  _L_z05_CheckLadder_StashLadder
                            	  3376:     ; Distance = $10, and player's facing in the same direction.
                            	  3377:     ;
                            	  3378:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3379:     ; ladder and had not stepped onto it yet.
                            	  3380:     ; Go handle movement on it, but don't change state yet.
                            	  3381:     ;
                            	  3382:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3383:     ; off of the ladder. So the ladder should be put away. In this
                            	  3384:     ; case, fall thru.
                            	  3385:     ;
02:0003E75A 41EC00AC        	  3386:     lea     ($00AC,A4),A0
02:0003E75E 10302000        	  3387:     move.b  (A0,D2.W),D0
02:0003E762 0C000001        	  3388:     cmpi.b  #$01,D0
02:0003E766 6718            	  3389:     beq  _L_z05_CheckLadder_HandleInput
                            	  3390:     even
                            	  3391: _L_z05_CheckLadder_StashLadder:
                            	  3392:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3393:     ;
02:0003E768 7000            	  3394:     moveq   #0,D0
02:0003E76A 19400064        	  3395:     move.b  D0,($0064,A4)
02:0003E76E 4EB900049CAA    	  3396:     jsr     DestroyMonster
                            	  3397:     even
                            	  3398: _L_z05_CheckLadder_Exit:
02:0003E774 4E75            	  3399:     rts
                            	  3400: 
                            	  3401:     even
                            	  3402: _L_z05_CheckLadder_SetState2:
                            	  3403:     ;  Set state 2, because we're on the ladder.
                            	  3404:     ;
02:0003E776 7002            	  3405:     moveq   #2,D0
02:0003E778 41EC00AC        	  3406:     lea     ($00AC,A4),A0
02:0003E77C 11802000        	  3407:     move.b  D0,(A0,D2.W)
                            	  3408:     even
                            	  3409: _L_z05_CheckLadder_HandleInput:
                            	  3410:     ; If input direction = 0, go draw and reset moving direction.
                            	  3411:     ;
02:0003E780 102C03F8        	  3412:     move.b  ($03F8,A4),D0
02:0003E784 67000086        	  3413:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3414:     ; Input direction <> 0. The player intends to move.
                            	  3415:     ; So, see if we need to override the moving direction.
                            	  3416:     ;
                            	  3417:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3418:     ; go draw and set moving direction to Link's direction.
                            	  3419:     ;
                            	  3420:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3421:     ; been blocked by the water.
                            	  3422:     ;
                            	  3423:     ; Or, Link already passed over the point right over the ladder
                            	  3424:     ; and was allowed to move onto the tiles after the ladder.
                            	  3425:     ;
02:0003E788 102C0098        	  3426:     move.b  ($0098,A4),D0
02:0003E78C 7600            	  3427:     moveq   #0,D3
02:0003E78E 1614            	  3428:     move.b  ($0000,A4),D3
02:0003E790 670C            	  3429:     beq  _anon_z05_86
02:0003E792 41EC0098        	  3430:     lea     ($0098,A4),A0
02:0003E796 12302000        	  3431:     move.b  (A0,D2.W),D1
02:0003E79A B001            	  3432:     cmp.b   D1,D0
02:0003E79C 676E            	  3433:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3434: _anon_z05_86:
                            	  3435:     ; Distance = 0, or facing different directions.
                            	  3436:     ;
                            	  3437:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3438:     ; then go draw and keep moving.
                            	  3439:     ;
                            	  3440:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3441:     ;
                            	  3442:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3443:     ; to move onto the tiles after the ladder.
                            	  3444:     ;
                            	  3445:     ; Note that if Link is not moving, then this test will fail,
                            	  3446:     ; and case (D) will catch it.
                            	  3447:     ;
02:0003E79E 41EC0098        	  3448:     lea     ($0098,A4),A0
02:0003E7A2 10302000        	  3449:     move.b  (A0,D2.W),D0
02:0003E7A6 122C000F        	  3450:     move.b  ($000F,A4),D1
02:0003E7AA B001            	  3451:     cmp.b   D1,D0
02:0003E7AC 675E            	  3452:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3453:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3454:     ; then go draw and move in ladder's direction.
                            	  3455:     ;
                            	  3456:     ; You can always step off the ladder where you came from.
                            	  3457:     ;
02:0003E7AE 4EB900030994    	  3458:     jsr     GetOppositeDir
02:0003E7B4 122C0098        	  3459:     move.b  ($0098,A4),D1
02:0003E7B8 B001            	  3460:     cmp.b   D1,D0
02:0003E7BA 6750            	  3461:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3462:     ; D. If opposite of ladder's direction <> down,
                            	  3463:     ; or input direction <> up,
                            	  3464:     ; then go reset moving direction, and draw.
                            	  3465:     ;
                            	  3466:     ; This will catch all cases of Link facing perpendicular to
                            	  3467:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3468:     ; ladder direction is up and input direction is up (E).
                            	  3469:     ;
02:0003E7BC 0C000004        	  3470:     cmpi.b  #$04,D0
02:0003E7C0 6648            	  3471:     bne  _anon_z05_87
02:0003E7C2 102C03F8        	  3472:     move.b  ($03F8,A4),D0
02:0003E7C6 0C000008        	  3473:     cmpi.b  #$08,D0
02:0003E7CA 663E            	  3474:     bne  _anon_z05_87
                            	  3475:     ; E. The ladder's direction is up and input direction is up.
                            	  3476:     ;
                            	  3477:     ; An earlier call to check tile collision would have blocked
                            	  3478:     ; movement, because the tile under Link's top half is a water tile.
                            	  3479:     ; But because Link is squarely on the ladder, we really have
                            	  3480:     ; to check the tile above that one.
                            	  3481:     ;
                            	  3482:     ; Set moving direction to input direction (up) and switch X to
                            	  3483:     ; the player's slot for the purpose of checking tile collision below.
                            	  3484:     ; Based on that, we'll set moving direction according to walkability.
                            	  3485:     ;
02:0003E7CC 6158            	  3486:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3487:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3488:     ;
02:0003E7CE 102C0084        	  3489:     move.b  ($0084,A4),D0
02:0003E7D2 1B00            	  3490:     move.b  D0,-(A5)  ; PHA
02:0003E7D4 003C0011        	  3491:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7D8 123C0008        	  3492:     move.b  #$08,D1
02:0003E7DC 0A3C0010        	  3493:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7E0 9101            	  3494:     subx.b  D1,D0   ; SBC #$08
02:0003E7E2 0A3C0010        	  3495:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7E6 19400084        	  3496:     move.b  D0,($0084,A4)
02:0003E7EA 4EB900047EDC    	  3497:     jsr     GetCollidingTileMoving
02:0003E7F0 101D            	  3498:     move.b  (A5)+,D0  ; PLA
02:0003E7F2 19400084        	  3499:     move.b  D0,($0084,A4)
                            	  3500:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3501:     ; direction as the input direction (in a roundabout way).
                            	  3502:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3503:     ;
02:0003E7F6 102C000F        	  3504:     move.b  ($000F,A4),D0
02:0003E7FA 7600            	  3505:     moveq   #0,D3
02:0003E7FC 162C049E        	  3506:     move.b  ($049E,A4),D3
02:0003E800 122C034A        	  3507:     move.b  ($034A,A4),D1
02:0003E804 B601            	  3508:     cmp.b   D1,D3
02:0003E806 6500FF78        	  3509:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3510: _anon_z05_87:
                            	  3511:     ; Set A to reset moving direction in [0F].
                            	  3512:     ;
02:0003E80A 7000            	  3513:     moveq   #0,D0
                            	  3514:     even
                            	  3515: _L_z05_CheckLadder_DrawLadder:
                            	  3516:     ; Draw the ladder.
                            	  3517:     ;
02:0003E80C 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
02:0003E80E 7400            	  3519:     moveq   #0,D2
02:0003E810 142C0064        	  3520:     move.b  ($0064,A4),D2
02:0003E814 4EB9000494CE    	  3521:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003E81A 760C            	  3522:     moveq   #12,D3
02:0003E81C 7000            	  3523:     moveq   #0,D0
02:0003E81E 4EB900030F68    	  3524:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0003E824 101D            	  3525:     move.b  (A5)+,D0  ; PLA
                            	  3526: ; Params:
                            	  3527: ; A: direction
                            	  3528: ;
                            	  3529: ; Returns:
                            	  3530: ; [0F]: direction
                            	  3531: ;
                            	  3532:     even
                            	  3533: SetMovingDirAndSwitchToPlayerSlot:
02:0003E826 4EF90002C04E    	  3534:     jmp     c_set_moving_dir_switch_player
                            	  3535: 
                            	  3536: FindNextEdgeSpawnCell:
                            	  3537:     ; Load [0A] with the value before the call.
                            	  3538:     ;
02:0003E82C 102C0525        	  3539:     move.b  ($0525,A4),D0
02:0003E830 1940000A        	  3540:     move.b  D0,($000A,A4)
                            	  3541:     even
                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:0003E834 7610            	  3549:     moveq   #16,D3
02:0003E836 102C000A        	  3550:     move.b  ($000A,A4),D0
02:0003E83A 0200000F        	  3551:     andi.b #$0F,D0
02:0003E83E 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:0003E840 163C00F0        	  3556:     move.b  #$F0,D3
02:0003E844 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:0003E848 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:0003E84A 1003            	  3564:     move.b  D3,D0
02:0003E84C 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E850 122C000A        	  3566:     move.b  ($000A,A4),D1
02:0003E854 D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:0003E856 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:0003E85A 102C000A        	  3574:     move.b  ($000A,A4),D0
02:0003E85E 020000F0        	  3575:     andi.b #$F0,D0
02:0003E862 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:0003E866 6606            	  3577:     bne  _anon_z05_88
02:0003E868 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:0003E86C 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:0003E86E 0C000040        	  3585:     cmpi.b  #$40,D0
02:0003E872 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:0003E874 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
                            	  3594:     ; Starting at the top of the leftmost column.
                            	  3595:     ;
02:0003E878 61002590        	  3596:     jsr     FetchTileMapAddr
02:0003E87C 7005            	  3597:     moveq   #5,D0
02:0003E87E 4EB90002A9FA    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:0003E884 102C000A        	  3602:     move.b  ($000A,A4),D0
02:0003E888 0200000F        	  3603:     andi.b #$0F,D0
02:0003E88C 7600            	  3604:     moveq   #0,D3
02:0003E88E 1600            	  3605:     move.b  D0,D3
02:0003E890 670C            	  3606:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3607: _anon_z05_89:
02:0003E892 702C            	  3608:     moveq   #44,D0
02:0003E894 4EB900030A18    	  3609:     jsr     AddToInt16At0
02:0003E89A 5303            	  3610:     subq.b  #1,D3
02:0003E89C 66F4            	  3611:     bne  _anon_z05_89
                            	  3612:     even
                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:0003E89E 102C000A        	  3617:     move.b  ($000A,A4),D0
02:0003E8A2 020000F0        	  3618:     andi.b #$F0,D0
02:0003E8A6 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:0003E8AA 123C0040        	  3620:     move.b  #$40,D1
02:0003E8AE 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E8B2 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
02:0003E8B4 0A3C0010        	  3623:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E8B8 E208            	  3624:     lsr.b  #1,D0   ; LSR A
02:0003E8BA E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003E8BC E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003E8BE 7600            	  3627:     moveq   #0,D3
02:0003E8C0 1600            	  3628:     move.b  D0,D3
                            	  3629:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3630:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3631:     ; when coming in from the edges.
                            	  3632:     ;
02:0003E8C2 1214            	  3633:     move.b  ($00,A4),D1   ; ptr lo
02:0003E8C4 182C0001        	  3634:     move.b  ($01,A4),D4  ; ptr hi
02:0003E8C8 024100FF        	  3635:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E8CC E14C            	  3636:     lsl.w   #8,D4
02:0003E8CE 8841            	  3637:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003E8D0 48C4            	  3638:     ext.l   D4
02:0003E8D2 D8BC00FF0000    	  3639:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003E8D8 2044            	  3640:     movea.l D4,A0
02:0003E8DA 10303000        	  3641:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003E8DE 0C000084        	  3642:     cmpi.b  #$84,D0
02:0003E8E2 650E            	  3643:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3644:     ; Bottom of the loop.
                            	  3645:     ; If you reach the original cell, then stop.
                            	  3646:     ;
02:0003E8E4 102C000A        	  3647:     move.b  ($000A,A4),D0
02:0003E8E8 122C0525        	  3648:     move.b  ($0525,A4),D1
02:0003E8EC B001            	  3649:     cmp.b   D1,D0
02:0003E8EE 6600FF44        	  3650:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3651:     even
