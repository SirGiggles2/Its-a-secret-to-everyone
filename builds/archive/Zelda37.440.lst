                            	  3713: UpdateMoldorm:
                            	  3714:     ; If facing direction = 0, return.
                            	  3715:     ;
02:00039B22 41EC0098        	  3716:     lea     ($0098,A4),A0
02:00039B26 10302000        	  3717:     move.b  (A0,D2.W),D0
02:00039B2A 670000C2        	  3718:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3719:     ; If the magic clock is missing, then move around (using the flying mechanism).
                            	  3720:     ;
02:00039B2E 102C066C        	  3721:     move.b  ($066C,A4),D0
02:00039B32 6608            	  3722:     bne  _anon_z04_79
02:00039B34 610000BA        	  3723:     jsr     ControlMoldormFlight
02:00039B38 61002C04        	  3724:     jsr     MoveFlyer
                            	  3725: _anon_z04_79:
                            	  3726:     ; Draw with sprite attributes: normal, red palette row
                            	  3727:     ;
02:00039B3C 7002            	  3728:     moveq   #2,D0
02:00039B3E 19400003        	  3729:     move.b  D0,($0003,A4)
02:00039B42 7044            	  3730:     moveq   #68,D0
02:00039B44 4EB900031060    	  3731:     jsr     Anim_WriteSprite
                            	  3732:     ; Check collisions, but never let them interfere with movement.
                            	  3733:     ;
02:00039B4A 41EC0098        	  3734:     lea     ($0098,A4),A0
02:00039B4E 10302000        	  3735:     move.b  (A0,D2.W),D0
02:00039B52 1B00            	  3736:     move.b  D0,-(A5)  ; PHA
02:00039B54 10342028        	  3737:     move.b  ($28,A4,D2.W),D0
02:00039B58 1B00            	  3738:     move.b  D0,-(A5)  ; PHA
02:00039B5A 4EB9000310D0    	  3739:     jsr     CheckMonsterCollisions
02:00039B60 101D            	  3740:     move.b  (A5)+,D0  ; PLA
02:00039B62 19802028        	  3741:     move.b  D0,($28,A4,D2.W)
02:00039B66 101D            	  3742:     move.b  (A5)+,D0  ; PLA
02:00039B68 41EC0098        	  3743:     lea     ($0098,A4),A0
02:00039B6C 11802000        	  3744:     move.b  D0,(A0,D2.W)
                            	  3745:     ; If this segment is still alive, then return.
                            	  3746:     ;
02:00039B70 41EC0405        	  3747:     lea     ($0405,A4),A0
02:00039B74 10302000        	  3748:     move.b  (A0,D2.W),D0
02:00039B78 6774            	  3749:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3750:     ; This segment is dead. We'll swap the tail segment with this
                            	  3751:     ; dead segment. This way, moldorm heads are always rooted
                            	  3752:     ; in slots 5 and $A; and the segments are continguous.
                            	  3753:     ;
                            	  3754:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  3755:     ;
                            	  3756:     ; Note that this is not a true swap, because the tail's HP
                            	  3757:     ; might be less than $20.
                            	  3758:     ;
02:00039B7A 7020            	  3759:     moveq   #32,D0
02:00039B7C 41EC0485        	  3760:     lea     ($0485,A4),A0
02:00039B80 11802000        	  3761:     move.b  D0,(A0,D2.W)
02:00039B84 610005F4        	  3762:     jsr     CheckBossHitReaction
                            	  3763:     ; Look for the tail segment, starting from the low end
                            	  3764:     ; of the chain that this dead segment belongs to.
                            	  3765:     ;
02:00039B88 163C00FF        	  3766:     move.b  #$FF,D3
02:00039B8C 0C020006        	  3767:     cmpi.b  #$06,D2
02:00039B90 6502            	  3768:     bcs  _anon_z04_80
02:00039B92 7604            	  3769:     moveq   #4,D3
                            	  3770: _anon_z04_80:
02:00039B94 5203            	  3771:     addq.b  #1,D3
02:00039B96 41EC0350        	  3772:     lea     ($0350,A4),A0
02:00039B9A 10303000        	  3773:     move.b  (A0,D3.W),D0
02:00039B9E 0C000041        	  3774:     cmpi.b  #$41,D0
02:00039BA2 66F0            	  3775:     bne  _anon_z04_80
                            	  3776:     ; I don't know why the object timer of the tail segment that will
                            	  3777:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3778:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3779:     ; there, the object timer is set to 6.
                            	  3780:     ;
02:00039BA4 7011            	  3781:     moveq   #17,D0
02:00039BA6 19803029        	  3782:     move.b  D0,($29,A4,D3.W)
                            	  3783:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3784:     ; segment to the tail segment.
                            	  3785:     ;
02:00039BAA 41EC04F0        	  3786:     lea     ($04F0,A4),A0
02:00039BAE 10302000        	  3787:     move.b  (A0,D2.W),D0
02:00039BB2 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:00039BB6 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:00039BBA 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
02:00039BBE 19803071        	  3791:     move.b  D0,($71,A4,D3.W)
02:00039BC2 41EC0084        	  3792:     lea     ($0084,A4),A0
02:00039BC6 10302000        	  3793:     move.b  (A0,D2.W),D0
02:00039BCA 41EC0085        	  3794:     lea     ($0085,A4),A0
02:00039BCE 11803000        	  3795:     move.b  D0,(A0,D3.W)
                            	  3796:     ; If the tail segment found is also a head, then
                            	  3797:     ; the last segment has died. Return.
                            	  3798:     ;
02:00039BD2 0C030004        	  3799:     cmpi.b  #$04,D3
02:00039BD6 6716            	  3800:     beq  _L_z04_UpdateMoldorm_Exit
02:00039BD8 0C030009        	  3801:     cmpi.b  #$09,D3
02:00039BDC 6710            	  3802:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3803:     ; Else finish swapping the segments.
                            	  3804:     ; Set the tail segment's type to the dead dummy object.
                            	  3805:     ;
02:00039BDE 705D            	  3806:     moveq   #93,D0
02:00039BE0 41EC0350        	  3807:     lea     ($0350,A4),A0
02:00039BE4 11803000        	  3808:     move.b  D0,(A0,D3.W)
                            	  3809:     ; Reset the metastate of the current segment, so that it comes
                            	  3810:     ; back to life.
                            	  3811:     ;
02:00039BE8 4EB900049CCE    	  3812:     jsr     ResetObjMetastate
                            	  3813:     even
                            	  3814: _L_z04_UpdateMoldorm_Exit:
02:00039BEE 4E75            	  3815:     rts
                            	  3816: 
                            	  3817:     even
                            	  3818: ControlMoldormFlight:
02:00039BF0 41EC0444        	  3819:     lea     ($0444,A4),A0
02:00039BF4 10302000        	  3820:     move.b  (A0,D2.W),D0
02:00039BF8 4EB90002AECA    	  3821:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  3822:     even
                            	  3823: ControlMoldormFlight_JumpTable:
02:00039BFE 00039C0E        	  3824:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C02 00039C0E        	  3825:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C06 00039C0E        	  3826:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C0A 00039C42        	  3827:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
                            	  3828: 
                            	  3829:     even
                            	  3830: Moldorm_Chase:
                            	  3831:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3832:     ; Only the head controls the movement direction.
                            	  3833:     ;
02:00039C0E 0C020005        	  3834:     cmpi.b  #$05,D2
02:00039C12 670A            	  3835:     beq  _anon_z04_81
02:00039C14 0C02000A        	  3836:     cmpi.b  #$0A,D2
02:00039C18 6704            	  3837:     beq.s  __far_z_04_0025
02:00039C1A 600000A4        	  3838:     jmp  L1156B_Exit
                            	  3839: __far_z_04_0025:
                            	  3840: _anon_z04_81:
                            	  3841:     ; Chase while flying, as usual.
                            	  3842:     ;
02:00039C1E 61002B6E        	  3843:     jsr     Flyer_Chase
                            	  3844:     ; If timer has not expired, then
                            	  3845:     ; go see if it's time to propagate direction changes down the chain.
                            	  3846:     ;
02:00039C22 10342028        	  3847:     move.b  ($28,A4,D2.W),D0
02:00039C26 6702            	  3848:     beq.s  __far_z_04_0026
02:00039C28 6032            	  3849:     jmp  Moldorm_PropagateDirs
                            	  3850: __far_z_04_0026:
                            	  3851:     even
                            	  3852: Moldorm_ChangeFlyingState:
                            	  3853:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  3854:     ;
02:00039C2A 61000096        	  3855:     jsr     Flyer_MoldormDecideState
02:00039C2E 7010            	  3856:     moveq   #16,D0
02:00039C30 19802028        	  3857:     move.b  D0,($28,A4,D2.W)
                            	  3858:     ; If the next lower slot's direction <> 0, then
                            	  3859:     ; go propagate direction changes down the chain.
                            	  3860:     ;
                            	  3861:     ; But you had to have propagated directions once for the
                            	  3862:     ; next lower direction to be set. How does it happen?
                            	  3863:     ;
                            	  3864:     ; Within a flyer state, the flying routines turn the flyer
                            	  3865:     ; and set the object timer to $10 several times. After any of
                            	  3866:     ; those times will the test succeed.
                            	  3867:     ;
                            	  3868:     ; When a flying state ends, timer will be 0, triggering the code
                            	  3869:     ; in this block to set the timer to $10, and try to propagate
                            	  3870:     ; directions.
                            	  3871:     ;
                            	  3872:     ; But this is also the case the first time here.
                            	  3873:     ;
                            	  3874:     ; So, I believe that the point of this test is to delay moving
                            	  3875:     ; the lower (not head) segments when starting out.
                            	  3876:     ;
02:00039C34 41EC0097        	  3877:     lea     ($0097,A4),A0
02:00039C38 10302000        	  3878:     move.b  (A0,D2.W),D0
02:00039C3C 6702            	  3879:     beq.s  __far_z_04_0027
02:00039C3E 601C            	  3880:     jmp  Moldorm_PropagateDirs
                            	  3881: __far_z_04_0027:
