                            	  3945:     ;
02:00039C84 7004            	  3946:     moveq   #4,D0
02:00039C86 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039C88 7600            	  3950:     moveq   #0,D3
02:00039C8A 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039C8E 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
