02:00049038 02000003        	  6049:     andi.b #$03,D0
02:0004903C 6714            	  6050:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:0004903E 10342070        	  6051:     move.b  ($70,A4,D2.W),D0
