                            	  5891: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  5892:     ; Digdogger is big, but room boundary checks and
                            	  5893:     ; object collision checks assume a 16x16 monster or smaller.
                            	  5894:     ; Therefore, we have to check these things four times,
                            	  5895:     ; in different corners of the boss.
                            	  5896:     ;
                            	  5897:     ; Loop 4 times, from 0 to 3.
                            	  5898:     ;
02:0003A804 7600            	  5899:     moveq   #0,D3
02:0003A806 41EC0478        	  5900:     lea     ($0478,A4),A0
02:0003A80A 16302000        	  5901:     move.b  (A0,D2.W),D3
                            	  5902:     ; Change the coordinates to one corner.
                            	  5903:     ;
02:0003A80E 10342070        	  5904:     move.b  ($70,A4,D2.W),D0
02:0003A812 023C00EE        	  5905:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A816 41F90003A6CA    	  5906:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A81C 12303000        	  5907:     move.b  (A0,D3.W),D1
02:0003A820 D101            	  5908:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A822 19802070        	  5909:     move.b  D0,($70,A4,D2.W)
02:0003A826 41EC0084        	  5910:     lea     ($0084,A4),A0
02:0003A82A 10302000        	  5911:     move.b  (A0,D2.W),D0
02:0003A82E 023C00EE        	  5912:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A832 41F90003A6CE    	  5913:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A838 12303000        	  5914:     move.b  (A0,D3.W),D1
02:0003A83C D101            	  5915:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A83E 41EC0084        	  5916:     lea     ($0084,A4),A0
02:0003A842 11802000        	  5917:     move.b  D0,(A0,D2.W)
                            	  5918:     ; Check the room boundary and object collisions in this temporary location.
                            	  5919:     ;
02:0003A846 61003734        	  5920:     jsr     BoundFlyer
02:0003A84A 4EB900030B9E    	  5921:     jsr     CheckMonsterCollisions
                            	  5922:     ; Increase the loop index, and loop again until it = 4.
                            	  5923:     ;
02:0003A850 41EC0478        	  5924:     lea     ($0478,A4),A0
02:0003A854 52302000        	  5925:     addq.b  #1,(A0,D2.W)
02:0003A858 41EC0478        	  5926:     lea     ($0478,A4),A0
02:0003A85C 10302000        	  5927:     move.b  (A0,D2.W),D0
02:0003A860 0C000004        	  5928:     cmpi.b  #$04,D0
02:0003A864 659E            	  5929:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  5930:     ; Restore the original coordinates.
                            	  5931:     ;
02:0003A866 101D            	  5932:     move.b  (A5)+,D0  ; PLA
02:0003A868 41EC0084        	  5933:     lea     ($0084,A4),A0
02:0003A86C 11802000        	  5934:     move.b  D0,(A0,D2.W)
02:0003A870 101D            	  5935:     move.b  (A5)+,D0  ; PLA
02:0003A872 19802070        	  5936:     move.b  D0,($70,A4,D2.W)
