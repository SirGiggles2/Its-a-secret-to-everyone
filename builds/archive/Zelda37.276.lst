02:00038CE8 0C000003        	  2054:     cmpi.b  #$03,D0
02:00038CEC 6726            	  2055:     beq  _L_z04__TryShooting_TryShootingNow
02:00038CEE 0C000001        	  2056:     cmpi.b  #$01,D0
02:00038CF2 6720            	  2057:     beq  _L_z04__TryShooting_TryShootingNow
02:00038CF4 0C000009        	  2058:     cmpi.b  #$09,D0
02:00038CF8 671A            	  2059:     beq  _L_z04__TryShooting_TryShootingNow
02:00038CFA 0C00000A        	  2060:     cmpi.b  #$0A,D0
02:00038CFE 6714            	  2061:     beq  _L_z04__TryShooting_TryShootingNow
02:00038D00 41EC0451        	  2062:     lea     ($0451,A4),A0
02:00038D04 10302000        	  2063:     move.b  (A0,D2.W),D0
02:00038D08 660A            	  2064:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2065:     ; and a random value < $F8, then return.
                            	  2066:     ;
02:00038D0A 10342018        	  2067:     move.b  ($18,A4,D2.W),D0
02:00038D0E 0C0000F8        	  2068:     cmpi.b  #$F8,D0
02:00038D12 656C            	  2069:     bcs  _L_z04__TryShooting_Exit
                            	  2070:     even
                            	  2071: _L_z04__TryShooting_TryShootingNow:
                            	  2072:     ; Summary
                            	  2073:     ;
                            	  2074:     ; if temporarily invincible then
                            	  2075:     ;   shoot timer := 0
                            	  2076:     ; elif shoot timer > 0 then
                            	  2077:     ;   decrement shoot timer
                            	  2078:     ; elif wants to shoot then
                            	  2079:     ;   shoot timer := $30
                            	  2080:     ;
                            	  2081:     ; qspeed := [01]
                            	  2082:     ;
                            	  2083:     ; if shoot timer <> 0 then
                            	  2084:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2085:     ;     shoot
                            	  2086:     ;     if succeeded then
                            	  2087:     ;       shoot timer := 0
                            	  2088:     ;       qspeed := 0
                            	  2089:     ;   else
                            	  2090:     ;     qspeed := 0
                            	  2091:     ;
                            	  2092:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038D14 102C0001        	  2093:     move.b  ($0001,A4),D0
02:00038D18 1883            	  2094:     move.b  D3,($0000,A4)
02:00038D1A 1B00            	  2095:     move.b  D0,-(A5)  ; PHA
02:00038D1C 7600            	  2096:     moveq   #0,D3
                            	  2097:     ; If not temporarily invincible,
                            	  2098:     ;
02:00038D1E 41EC04F0        	  2099:     lea     ($04F0,A4),A0
02:00038D22 10302000        	  2100:     move.b  (A0,D2.W),D0
02:00038D26 661A            	  2101:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2102:     ; then Y := shoot timer - 1
                            	  2103:     ;
02:00038D28 7600            	  2104:     moveq   #0,D3
02:00038D2A 41EC0451        	  2105:     lea     ($0451,A4),A0
02:00038D2E 16302000        	  2106:     move.b  (A0,D2.W),D3
02:00038D32 5303            	  2107:     subq.b  #1,D3
                            	  2108:     ; If Y register < 0, then shoot timer is 0.
                            	  2109:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2110:     ; Else go set a non-zero speed and return.
                            	  2111:     ;
02:00038D34 6A0C            	  2112:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038D36 41EC0412        	  2113:     lea     ($0412,A4),A0
02:00038D3A 10302000        	  2114:     move.b  (A0,D2.W),D0
02:00038D3E 6736            	  2115:     beq  _L_z04__TryShooting_SetSpeed
02:00038D40 7630            	  2116:     moveq   #48,D3
                            	  2117:     even
