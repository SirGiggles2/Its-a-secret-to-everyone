                            	  4698: _L_z02_UpdateMode13WinGame_Sub0_Flash_ChangePalette:
02:00034BA2 7400            	  4699:     moveq   #0,D2
02:00034BA4 142C0506        	  4700:     move.b  ($0506,A4),D2
                            	  4701:     ; Don't flash until $40 frames have passed.
