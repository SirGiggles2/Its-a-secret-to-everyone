                            	  9072: _anon_z04_111:
                            	  9073:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  9074:     ; frame := ((accumulator AND $10) >> 4
                            	  9075:     ;
02:0003BFE4 41EC0451        	  9076:     lea     ($0451,A4),A0
02:0003BFE8 10302000        	  9077:     move.b  (A0,D2.W),D0
02:0003BFEC 02000010        	  9078:     andi.b #$10,D0
02:0003BFF0 E208            	  9079:     lsr.b  #1,D0   ; LSR A
02:0003BFF2 E208            	  9080:     lsr.b  #1,D0   ; LSR A
02:0003BFF4 E208            	  9081:     lsr.b  #1,D0   ; LSR A
02:0003BFF6 E208            	  9082:     lsr.b  #1,D0   ; LSR A
