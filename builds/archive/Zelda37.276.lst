                            	  2522: LA10A_Exit:
02:00033540 4E75            	  2523:     rts
                            	  2524: 
                            	  2525: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2526: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2527: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2528: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2529: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2530: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2531:     even
                            	  2532: ModeE_SyncCharBoardCursorToIndex:
02:00033542 60008596        	  2533:     jmp     c_mode_e_sync_char_board_cursor
                            	  2534: 
                            	  2535: ModeE_HandleAOrB:
02:00033546 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:0003354A 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:0003354C 7600            	  2540:     moveq   #0,D3
02:0003354E 162C0016        	  2541:     move.b  ($0016,A4),D3
02:00033552 0C030003        	  2542:     cmpi.b  #$03,D3
02:00033556 6602            	  2543:     bne.s  __far_z_02_0007
02:00033558 60E6            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:0003355A 41F900032F6E    	  2548:     lea     (SlotToNameOffset).l,A0
02:00033560 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00033564 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00033568 7400            	  2553:     moveq   #0,D2
02:0003356A 41F900032F72    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033570 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00033574 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00033576 41F900032F3E    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:0003357C 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00033580 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00033584 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00033588 5302            	  2563:     subq.b  #1,D2
02:0003358A 5303            	  2564:     subq.b  #1,D3
02:0003358C 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:0003358E 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00033592 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00033596 020000C0        	  2577:     andi.b #$C0,D0
02:0003359A 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:0003359E 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:000335A2 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:000335A6 7620            	  2586:     moveq   #32,D3
02:000335A8 19430604        	  2587:     move.b  D3,($0604,A4)
02:000335AC 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:000335AE 41EC0422        	  2591:     lea     ($0422,A4),A0
02:000335B2 10303000        	  2592:     move.b  (A0,D3.W),D0
02:000335B6 41EC0302        	  2593:     lea     ($0302,A4),A0
02:000335BA 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:000335BE 5303            	  2595:     subq.b  #1,D3
02:000335C0 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:000335C2 19430306        	  2597:     move.b  D3,($0306,A4)
02:000335C6 7400            	  2598:     moveq   #0,D2
02:000335C8 142C0421        	  2599:     move.b  ($0421,A4),D2
02:000335CC 7600            	  2600:     moveq   #0,D3
02:000335CE 162C041F        	  2601:     move.b  ($041F,A4),D3
02:000335D2 41F900032F12    	  2602:     lea     (ModeE_CharMap).l,A0
02:000335D8 10303000        	  2603:     move.b  (A0,D3.W),D0
02:000335DC 19400305        	  2604:     move.b  D0,($0305,A4)
02:000335E0 41EC0638        	  2605:     lea     ($0638,A4),A0
02:000335E4 11802000        	  2606:     move.b  D0,(A0,D2.W)
                            	  2607:     even
                            	  2608: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:000335E8 102C0070        	  2609:     move.b  ($0070,A4),D0
02:000335EC 023C00EE        	  2610:     andi    #$EE,CCR  ; CLC: clear C+X
02:000335F0 123C0008        	  2611:     move.b  #$08,D1
02:000335F4 D101            	  2612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000335F6 19400070        	  2613:     move.b  D0,($0070,A4)
02:000335FA 522C0421        	  2614:     addq.b  #1,($0421,A4)
02:000335FE 522C0423        	  2615:     addq.b  #1,($0423,A4)
                            	  2616:     ; If VRAM address still points inside the name field,
                            	  2617:     ; then go finish.
                            	  2618:     ;
                            	  2619:     ; The idea is that each name field in nametable begins at
                            	  2620:     ; an address ending in $E. For example, slot 0 has a name
                            	  2621:     ; at VRAM addresses $20CE to $20D5.
                            	  2622:     ;
                            	  2623:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2624:     ; the name field.
                            	  2625:     ;
                            	  2626:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2627:     ; record header.
                            	  2628:     ;
02:00033602 102C0070        	  2629:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00033606 0C0000B0        	  2630:     cmpi.b  #$B0,D0
02:0003360A 6678            	  2631:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2632:     ; The VRAM address now points outside the name field.
                            	  2633:     ; So, wrap around to the beginning of the name field.
                            	  2634:     ;
                            	  2635:     ; For example, $20D6 -> $20CE.
                            	  2636:     ;
02:0003360C 102C0423        	  2637:     move.b  ($0423,A4),D0
02:00033610 003C0011        	  2638:     ori     #$11,CCR  ; SEC: set C+X
02:00033614 123C0008        	  2639:     move.b  #$08,D1
02:00033618 0A3C0010        	  2640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003361C 9101            	  2641:     subx.b  D1,D0   ; SBC #$08
02:0003361E 0A3C0010        	  2642:     eori    #$10,CCR  ; restore X = 6502 C
02:00033622 19400423        	  2643:     move.b  D0,($0423,A4)
                            	  2644:     ; It also means that we went past the end of the save slot
                            	  2645:     ; info name. Set the offset to the beginning of the name.
02:00033626 7600            	  2646:     moveq   #0,D3
02:00033628 162C0016        	  2647:     move.b  ($0016,A4),D3
02:0003362C 41F900032F6E    	  2648:     lea     (SlotToNameOffset).l,A0
02:00033632 10303000        	  2649:     move.b  (A0,D3.W),D0
02:00033636 19400421        	  2650:     move.b  D0,($0421,A4)
                            	  2651:     ; If the name cursor has gone past the end of the field,
                            	  2652:     ; then wrap around.
02:0003363A 102C0070        	  2653:     move.b  ($0070,A4),D0
02:0003363E 0C0000B0        	  2654:     cmpi.b  #$B0,D0
02:00033642 6640            	  2655:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033644 7070            	  2656:     moveq   #112,D0
