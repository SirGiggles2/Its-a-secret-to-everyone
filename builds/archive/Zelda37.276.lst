02:0003FCD6 122C0001        	  2959:     move.b  ($0001,A4),D1
02:0003FCDA C001            	  2960:     and.b  D1,D0
02:0003FCDC 194000F8        	  2961:     move.b  D0,($00F8,A4)
                            	  2962:     ; If in OW or button mask <> 0, return.
                            	  2963:     ;
02:0003FCE0 102C0010        	  2964:     move.b  ($0010,A4),D0
02:0003FCE4 6720            	  2965:     beq  _L_z05_MaskInputInBorder_Exit
02:0003FCE6 102C0001        	  2966:     move.b  ($0001,A4),D0
02:0003FCEA 661A            	  2967:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2968:     ; Mask off input directions perpendicular to player's facing.
                            	  2969:     ;
02:0003FCEC 760C            	  2970:     moveq   #12,D3
02:0003FCEE 102C0098        	  2971:     move.b  ($0098,A4),D0
02:0003FCF2 0200000C        	  2972:     andi.b #$0C,D0
02:0003FCF6 6602            	  2973:     bne  _anon_z05_77
02:0003FCF8 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
02:0003FCFA 1003            	  2976:     move.b  D3,D0
02:0003FCFC 122C03F8        	  2977:     move.b  ($03F8,A4),D1
02:0003FD00 C001            	  2978:     and.b  D1,D0
