                            	  5715: __far_z_05_0076:
                            	  5716:     ; Turn the door command into the desired open or closed state
                            	  5717:     ; to store in [08].
                            	  5718:     ;
                            	  5719:     ; cmd:  7 6 3 2 
                            	  5720:     ; [08]: 2 0 0 0
                            	  5721:     ;
                            	  5722:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5723:     ; commands intended to be used.
                            	  5724:     ;
                            	  5725:     ; 3 is the end state of 2: close
                            	  5726:     ; 7 is the end state of 6: open
                            	  5727:     ;
02:00041A84 02000007        	  5728:     andi.b #$07,D0
02:00041A88 7601            	  5729:     moveq   #1,D3
02:00041A8A 19430002        	  5730:     move.b  D3,($0002,A4)
02:00041A8E 122C0002        	  5731:     move.b  ($0002,A4),D1
02:00041A92 C200            	  5732:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00041A94 6702            	  5733:     beq  _anon_z05_118
02:00041A96 E208            	  5734:     lsr.b  #1,D0   ; LSR A
                            	  5735: _anon_z05_118:
02:00041A98 0C000002        	  5736:     cmpi.b  #$02,D0
02:00041A9C 6606            	  5737:     bne  _anon_z05_119
                            	  5738:     ; Command 2 sets Link's timer to $30.
                            	  5739:     ;
02:00041A9E 7630            	  5740:     moveq   #48,D3
02:00041AA0 19430028        	  5741:     move.b  D3,($0028,A4)
                            	  5742: _anon_z05_119:
02:00041AA4 02000003        	  5743:     andi.b #$03,D0
02:00041AA8 003C0011        	  5744:     ori     #$11,CCR  ; SEC: set C+X
02:00041AAC 123C0001        	  5745:     move.b  #$01,D1
02:00041AB0 0A3C0010        	  5746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041AB4 9101            	  5747:     subx.b  D1,D0   ; SBC #$01
02:00041AB6 0A3C0010        	  5748:     eori    #$10,CCR  ; restore X = 6502 C
02:00041ABA 02000002        	  5749:     andi.b #$02,D0
02:00041ABE 19400008        	  5750:     move.b  D0,($0008,A4)
                            	  5751:     ; The command to close a key door or bombable wall does not
                            	  5752:     ; do anything.
                            	  5753:     ;
02:00041AC2 102C0054        	  5754:     move.b  ($0054,A4),D0
02:00041AC6 0C000005        	  5755:     cmpi.b  #$05,D0
02:00041ACA 6416            	  5756:     bcc  _anon_z05_120
02:00041ACC 102C0055        	  5757:     move.b  ($0055,A4),D0
02:00041AD0 19400002        	  5758:     move.b  D0,($0002,A4)
02:00041AD4 6100FAEC        	  5759:     jsr     FindDoorAttrByDoorBit
02:00041AD8 0C000007        	  5760:     cmpi.b  #$07,D0
02:00041ADC 6704            	  5761:     beq  _anon_z05_120
02:00041ADE 6000009C        	  5762:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5763: 
                            	  5764: _anon_z05_120:
                            	  5765:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5766:     ;
                            	  5767:     ; Shutters and the commands to open a door always change
                            	  5768:     ; tiles.
                            	  5769:     ;
02:00041AE2 61000130        	  5770:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5771:     even
                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:00041AE6 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00041AEA 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00041AEE 1014            	  5783:     move.b  ($0000,A4),D0
02:00041AF0 41EC0302        	  5784:     lea     ($0302,A4),A0
02:00041AF4 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:00041AF8 5202            	  5786:     addq.b  #1,D2
02:00041AFA 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00041AFE 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00041B02 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:00041B06 5202            	  5790:     addq.b  #1,D2
02:00041B08 102C0006        	  5791:     move.b  ($0006,A4),D0
02:00041B0C 41EC0302        	  5792:     lea     ($0302,A4),A0
02:00041B10 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:00041B14 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:00041B16 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:00041B1A 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:00041B1C 7020            	  5803:     moveq   #32,D0
02:00041B1E 122C0001        	  5804:     move.b  ($0001,A4),D1
02:00041B22 8001            	  5805:     or.b  D1,D0
02:00041B24 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:00041B28 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:00041B2C 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:00041B2E 103C00FF        	  5815:     move.b  #$FF,D0
02:00041B32 41EC0302        	  5816:     lea     ($0302,A4),A0
02:00041B36 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:00041B3A 1002            	  5818:     move.b  D2,D0
02:00041B3C 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:00041B40 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:00041B44 102C0054        	  5829:     move.b  ($0054,A4),D0
02:00041B48 02000003        	  5830:     andi.b #$03,D0
02:00041B4C 6708            	  5831:     beq  _anon_z05_122
02:00041B4E 7008            	  5832:     moveq   #8,D0
02:00041B50 19400027        	  5833:     move.b  D0,($0027,A4)
02:00041B54 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:00041B56 102C0054        	  5844:     move.b  ($0054,A4),D0
02:00041B5A 0C000004        	  5845:     cmpi.b  #$04,D0
02:00041B5E 6626            	  5846:     bne  _anon_z05_123
02:00041B60 7400            	  5847:     moveq   #0,D2
02:00041B62 142C0009        	  5848:     move.b  ($0009,A4),D2
02:00041B66 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:00041B6A 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00041B6E 0A00000F        	  5851:     eori.b #$0F,D0
02:00041B72 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:00041B76 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00041B78 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00041B7C 7000            	  5859:     moveq   #0,D0
02:00041B7E 19400054        	  5860:     move.b  D0,($0054,A4)
02:00041B82 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:00041B86 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00041B8A 19400002        	  5871:     move.b  D0,($0002,A4)
02:00041B8E 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:00041B92 0C000007        	  5873:     cmpi.b  #$07,D0
02:00041B96 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:00041B98 7400            	  5879:     moveq   #0,D2
02:00041B9A 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00041B9E 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00041BA2 1003            	  5884:     move.b  D3,D0
02:00041BA4 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041BA8 41F900041A64    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00041BAE 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00041BB2 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00041BB4 7600            	  5889:     moveq   #0,D3
02:00041BB6 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:00041BB8 1002            	  5893:     move.b  D2,D0
02:00041BBA 0A000001        	  5894:     eori.b #$01,D0
02:00041BBE 7400            	  5895:     moveq   #0,D2
02:00041BC0 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00041BC2 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00041BC4 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00041BC8 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041BCC E14C            	  5902:     lsl.w   #8,D4
02:00041BCE 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041BD0 48C4            	  5904:     ext.l   D4
02:00041BD2 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041BD8 2044            	  5906:     movea.l D4,A0
02:00041BDA 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041BDE 41F900048D20    	  5908:     lea     (LevelMasks).l,A0
02:00041BE4 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00041BE8 8001            	  5910:     or.b  D1,D0
02:00041BEA 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00041BEC 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00041BF0 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041BF4 E14C            	  5914:     lsl.w   #8,D4
02:00041BF6 8841            	  5915:     or.w    D1,D4
02:00041BF8 48C4            	  5916:     ext.l   D4
02:00041BFA D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00041C00 2044            	  5918:     movea.l D4,A0
