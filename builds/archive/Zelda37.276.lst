                            	  6493: Aquamentus_Draw:
                            	  6494:     ; Every $10 screen frames, switch animation frames.
                            	  6495:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6496:     ; The last tile of frame 0 is at index 5.
                            	  6497:     ; The last tile of frame 1 is at index $B.
                            	  6498:     ;
02:0003ACE0 7605            	  6499:     moveq   #5,D3
02:0003ACE2 102C0015        	  6500:     move.b  ($0015,A4),D0
02:0003ACE6 02000010        	  6501:     andi.b #$10,D0
02:0003ACEA 6602            	  6502:     bne  _anon_z04_88
02:0003ACEC 760B            	  6503:     moveq   #11,D3
                            	  6504: _anon_z04_88:
02:0003ACEE 1943000A        	  6505:     move.b  D3,($000A,A4)
                            	  6506:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6507:     ;
02:0003ACF2 7005            	  6508:     moveq   #5,D0
02:0003ACF4 1940000B        	  6509:     move.b  D0,($000B,A4)
                            	  6510:     even
                            	  6511: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003ACF8 7600            	  6512:     moveq   #0,D3
02:0003ACFA 162C000B        	  6513:     move.b  ($000B,A4),D3
                            	  6514:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6515:     ; Store it in [00].
                            	  6516:     ;
02:0003ACFE 10342070        	  6517:     move.b  ($70,A4,D2.W),D0
02:0003AD02 023C00EE        	  6518:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD06 41F90003ACDA    	  6519:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003AD0C 12303000        	  6520:     move.b  (A0,D3.W),D1
02:0003AD10 D101            	  6521:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003AD12 1880            	  6522:     move.b  D0,($0000,A4)
                            	  6523:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6524:     ; Store it in [01].
                            	  6525:     ;
02:0003AD14 41EC0084        	  6526:     lea     ($0084,A4),A0
02:0003AD18 10302000        	  6527:     move.b  (A0,D2.W),D0
02:0003AD1C 023C00EE        	  6528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD20 41F90003ACD4    	  6529:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003AD26 12303000        	  6530:     move.b  (A0,D3.W),D1
02:0003AD2A D101            	  6531:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003AD2C 19400001        	  6532:     move.b  D0,($0001,A4)
                            	  6533:     ; Calculate sprite attributes:
                            	  6534:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6535:     ;
                            	  6536:     ; If the boss is temporarily invincible, then
                            	  6537:     ; this makes it flash by cycling all the palette rows.
                            	  6538:     ;
                            	  6539:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6540:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6541:     ;
02:0003AD30 41EC04F0        	  6542:     lea     ($04F0,A4),A0
02:0003AD34 10302000        	  6543:     move.b  (A0,D2.W),D0
02:0003AD38 02000003        	  6544:     andi.b #$03,D0
02:0003AD3C 0A000003        	  6545:     eori.b #$03,D0
02:0003AD40 19400003        	  6546:     move.b  D0,($0003,A4)
02:0003AD44 7600            	  6547:     moveq   #0,D3
02:0003AD46 162C000A        	  6548:     move.b  ($000A,A4),D3
                            	  6549:     ; Look up the tile for this sprite.
                            	  6550:     ; If it's not the first one (face), then go write the sprite record.
                            	  6551:     ;
02:0003AD4A 41F90003ACC8    	  6552:     lea     (AquamentusTiles).l,A0
02:0003AD50 10303000        	  6553:     move.b  (A0,D3.W),D0
02:0003AD54 12390003ACC8    	  6554:     move.b  (AquamentusTiles).l,D1
02:0003AD5A B001            	  6555:     cmp.b   D1,D0
02:0003AD5C 6610            	  6556:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6557:     ; Else it's the first one (the face tile).
                            	  6558:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6559:     ;
                            	  6560:     ; $CC/CD shows the closed mouth face.
                            	  6561:     ; $C0/C1 shows the open mouth face.
                            	  6562:     ;
02:0003AD5E 7600            	  6563:     moveq   #0,D3
02:0003AD60 16342028        	  6564:     move.b  ($28,A4,D2.W),D3
02:0003AD64 0C030020        	  6565:     cmpi.b  #$20,D3
02:0003AD68 6404            	  6566:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003AD6A 103C00C0        	  6567:     move.b  #$C0,D0
                            	  6568:     even
                            	  6569: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003AD6E 610E            	  6570:     jsr     WriteBossSprite
                            	  6571:     ; Bottom of the loop.
                            	  6572:     ; Decrement tile index and loop index.
                            	  6573:     ;
02:0003AD70 532C000A        	  6574:     subq.b  #1,($000A,A4)
02:0003AD74 532C000B        	  6575:     subq.b  #1,($000B,A4)
02:0003AD78 6A00FF7E        	  6576:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003AD7C 4E75            	  6577:     rts
