                            	  3495: InitArmosOrFlyingGhini:
                            	  3496:     ; In UpdateObject, this object was flagged "initialized".
                            	  3497:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3498:     ;
02:00039706 10342028        	  3499:     move.b  ($28,A4,D2.W),D0
02:0003970A 41EC0492        	  3500:     lea     ($0492,A4),A0
02:0003970E 11802000        	  3501:     move.b  D0,(A0,D2.W)
                            	  3502:     ; If it's still fading in, then go finish some initialization needed
                            	  3503:     ; for fading in.
                            	  3504:     ;
02:00039712 660000B6        	  3505:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3506:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3507:     ; go finish initializing it.
                            	  3508:     ;
02:00039716 41EC034F        	  3509:     lea     ($034F,A4),A0
02:0003971A 10302000        	  3510:     move.b  (A0,D2.W),D0
02:0003971E 0C000022        	  3511:     cmpi.b  #$22,D0
02:00039722 670000A6        	  3512:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3513:     ; Else we have an armos.
                            	  3514:     ;
                            	  3515:     ; Store stairs tile $70 in [00] for use later.
                            	  3516:     ;
02:00039726 7070            	  3517:     moveq   #112,D0
02:00039728 1880            	  3518:     move.b  D0,($0000,A4)
                            	  3519:     ; Look for the current room ID in an array of room ID's that
                            	  3520:     ; have armos secrets.
                            	  3521:     ;
02:0003972A 7606            	  3522:     moveq   #6,D3
                            	  3523:     even
                            	  3524: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003972C 102C00EB        	  3525:     move.b  ($00EB,A4),D0
                            	  3526:     ; If this element does not match the current room ID, go loop again.
                            	  3527:     ;
02:00039730 41F9000396F6    	  3528:     lea     (SecretArmosRoomIds).l,A0
02:00039736 12303000        	  3529:     move.b  (A0,D3.W),D1
02:0003973A B001            	  3530:     cmp.b   D1,D0
02:0003973C 6648            	  3531:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3532:     ; The secret (usually stairs) is under one of the armoses.
                            	  3533:     ;
                            	  3534:     ; If the armos's X coordinate does not match the one needed
                            	  3535:     ; for the current room in the list, then go loop again.
                            	  3536:     ;
02:0003973E 10342070        	  3537:     move.b  ($70,A4,D2.W),D0
02:00039742 41F9000396FE    	  3538:     lea     (SecretArmosXs).l,A0
02:00039748 12303000        	  3539:     move.b  (A0,D3.W),D1
02:0003974C B001            	  3540:     cmp.b   D1,D0
02:0003974E 6636            	  3541:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3542:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3543:     ;
02:00039750 41EC0084        	  3544:     lea     ($0084,A4),A0
02:00039754 10302000        	  3545:     move.b  (A0,D2.W),D0
02:00039758 0C000080        	  3546:     cmpi.b  #$80,D0
02:0003975C 6628            	  3547:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3548:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3549:     ;
02:0003975E 4A03            	  3550:     cmpi.b  #$00,D3
02:00039760 662C            	  3551:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3552:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3553:     ; has the power bracelet.
                            	  3554:     ;
                            	  3555:     ; Set up the room item with the armos's coordinates.
                            	  3556:     ;
02:00039762 19400097        	  3557:     move.b  D0,($0097,A4)
02:00039766 10342070        	  3558:     move.b  ($70,A4,D2.W),D0
02:0003976A 19400083        	  3559:     move.b  D0,($0083,A4)
                            	  3560:     ; This resets the room item's state, which activates it.
                            	  3561:     ;
02:0003976E 194300BF        	  3562:     move.b  D3,($00BF,A4)
                            	  3563:     ; Set the room item ID.
                            	  3564:     ;
02:00039772 7014            	  3565:     moveq   #20,D0
02:00039774 194000AB        	  3566:     move.b  D0,($00AB,A4)
                            	  3567:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3568:     ;
                            	  3569:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3570:     ;
                            	  3571:     ; Note that, if the item was already taken, then the room item
                            	  3572:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3573:     ; it will be ignored, because that routine checks whether
                            	  3574:     ; the item was taken.
                            	  3575:     ;
02:00039778 4EB90003056A    	  3576:     jsr     GetRoomFlagUWItemState
02:0003977E 660A            	  3577:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00039780 6100069E        	  3578:     jsr     PlaySecretFoundTune
02:00039784 6604            	  3579:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3580:     even
                            	  3581: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3582:     ; Bottom of the loop.
                            	  3583:     ;
02:00039786 5303            	  3584:     subq.b  #1,D3
02:00039788 6AA2            	  3585:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3586:     even
                            	  3587: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3588:     ; Not found, or found the power bracelet.
                            	  3589:     ; Use a floor tile $26 to replace the armos.
                            	  3590:     ;
02:0003978A 7026            	  3591:     moveq   #38,D0
02:0003978C 1880            	  3592:     move.b  D0,($0000,A4)
                            	  3593:     even
                            	  3594: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003978E 1014            	  3595:     move.b  ($0000,A4),D0
                            	  3596:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3597:     ;
02:00039790 1B00            	  3598:     move.b  D0,-(A5)  ; PHA
02:00039792 0C000070        	  3599:     cmpi.b  #$70,D0
02:00039796 6604            	  3600:     bne  _anon_z04_51
02:00039798 61000686        	  3601:     jsr     PlaySecretFoundTune
                            	  3602: _anon_z04_51:
                            	  3603:     ; Replace the tile where the armos was.
                            	  3604:     ;
02:0003979C 522C00F7        	  3605:     addq.b  #1,($00F7,A4)
02:000397A0 101D            	  3606:     move.b  (A5)+,D0  ; PLA
02:000397A2 4EB900048FF0    	  3607:     jsr     ChangeTileObjTiles
                            	  3608:     ; Because the armos object is aligned to the square grid
                            	  3609:     ; (because it was made from a square),
                            	  3610:     ; set its grid offset to 3 to compensate.
                            	  3611:     ;
                            	  3612:     ; Most objects are aligned to the grid vertically when the
                            	  3613:     ; low nibble is $D.
                            	  3614:     ;
02:000397A8 7003            	  3615:     moveq   #3,D0
02:000397AA 41EC0394        	  3616:     lea     ($0394,A4),A0
02:000397AE 11802000        	  3617:     move.b  D0,(A0,D2.W)
                            	  3618:     ; Set a speed (q-speed fraction) randomly:
                            	  3619:     ; $20 if random value < $80
                            	  3620:     ; $60 otherwise
                            	  3621:     ;
02:000397B2 7020            	  3622:     moveq   #32,D0
02:000397B4 7600            	  3623:     moveq   #0,D3
02:000397B6 16342019        	  3624:     move.b  ($19,A4,D2.W),D3
02:000397BA 0C030080        	  3625:     cmpi.b  #$80,D3
02:000397BE 6502            	  3626:     bcs  _anon_z04_52
02:000397C0 7060            	  3627:     moveq   #96,D0
                            	  3628: _anon_z04_52:
02:000397C2 41EC03BC        	  3629:     lea     ($03BC,A4),A0
02:000397C6 11802000        	  3630:     move.b  D0,(A0,D2.W)
                            	  3631:     even
                            	  3632: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3633:     ; Facing and input directions down.
                            	  3634:     ;
02:000397CA 7004            	  3635:     moveq   #4,D0
02:000397CC 41EC03F8        	  3636:     lea     ($03F8,A4),A0
02:000397D0 11802000        	  3637:     move.b  D0,(A0,D2.W)
02:000397D4 41EC0098        	  3638:     lea     ($0098,A4),A0
02:000397D8 11802000        	  3639:     move.b  D0,(A0,D2.W)
                            	  3640:     ; Every other frame, return without drawing.
                            	  3641:     ;
02:000397DC 10342028        	  3642:     move.b  ($28,A4,D2.W),D0
02:000397E0 E208            	  3643:     lsr.b  #1,D0   ; LSR A
02:000397E2 6512            	  3644:     bcs  _anon_z04_53
