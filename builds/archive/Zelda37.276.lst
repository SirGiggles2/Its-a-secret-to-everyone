02:0003990A 102C00AC        	  3835:     move.b  ($00AC,A4),D0
02:0003990E 1B00            	  3836:     move.b  D0,-(A5)  ; PHA
02:00039910 194300AC        	  3837:     move.b  D3,($00AC,A4)
02:00039914 4EB900049EA2    	  3838:     jsr     Link_EndMoveAndAnimate_Bank4
