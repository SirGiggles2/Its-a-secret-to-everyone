02:0002B5C4 3C326000        	  3499:     move.w  (A2,D6.W),D6            ; D6 = CRAM base for this sub-pal
02:0002B5C8 02400003        	  3500:     andi.w  #$0003,D0               ; color slot (1..3)
02:0002B5CC D040            	  3501:     add.w   D0,D0                   ; * 2
