                            	  6698: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6699:     ; Bloated timer =>
                            	  6700:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6701:     ; 1:     go advance the substate
                            	  6702:     ; other: go decrement Bloated timer
                            	  6703:     ;
02:0003AE6A 7600            	  6704:     moveq   #0,D3
02:0003AE6C 41EC045E        	  6705:     lea     ($045E,A4),A0
02:0003AE70 16302000        	  6706:     move.b  (A0,D2.W),D3
02:0003AE74 5303            	  6707:     subq.b  #1,D3
02:0003AE76 6750            	  6708:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003AE78 6B04            	  6709:     bmi.s  __far_z_04_0058
02:0003AE7A 60000080        	  6710:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6711: __far_z_04_0058:
                            	  6712:     ; Set the bloated timer according to the substate.
                            	  6713:     ;
02:0003AE7E 7600            	  6714:     moveq   #0,D3
02:0003AE80 41EC042C        	  6715:     lea     ($042C,A4),A0
02:0003AE84 16302000        	  6716:     move.b  (A0,D2.W),D3
02:0003AE88 41F90003ADC6    	  6717:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003AE8E 10303000        	  6718:     move.b  (A0,D3.W),D0
02:0003AE92 41EC045E        	  6719:     lea     ($045E,A4),A0
02:0003AE96 11802000        	  6720:     move.b  D0,(A0,D2.W)
                            	  6721:     ; If substate <> 0, go decrement bloated timer.
                            	  6722:     ;
