02:000336DC 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:000336E0 19400204        	  2726:     move.b  D0,($0204,A4)
02:000336E4 7070            	  2727:     moveq   #112,D0
02:000336E6 19400070        	  2728:     move.b  D0,($0070,A4)
02:000336EA 103C0087        	  2729:     move.b  #$87,D0
02:000336EE 19400085        	  2730:     move.b  D0,($0085,A4)
02:000336F2 7030            	  2731:     moveq   #48,D0
02:000336F4 19400071        	  2732:     move.b  D0,($0071,A4)
