02:0003B326 8001            	  7415:     or.b  D1,D0
02:0003B328 660000AE        	  7416:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7417:     ; Every odd screen frame, go straight to drawing
