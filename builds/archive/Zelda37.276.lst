                            	 12182:     ; The animation cycle has 6 frames.
                            	 12183:     ;
02:0003D6BE 41EC046B        	 12184:     lea     ($046B,A4),A0
02:0003D6C2 10302000        	 12185:     move.b  (A0,D2.W),D0
02:0003D6C6 0C000006        	 12186:     cmpi.b  #$06,D0
02:0003D6CA 660A            	 12187:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003D6CC 7000            	 12188:     moveq   #0,D0
02:0003D6CE 41EC046B        	 12189:     lea     ($046B,A4),A0
