                            	  7034: DodongoBombPositiveLimits:
02:0003B0B4 0C              	  7035:     dc.b    $0C, $11
02:0003B0B5 11
                            	  7036: 
                            	  7037:     even
                            	  7038: DodongoBombNegativeLimits:
02:0003B0B6 F4              	  7039:     dc.b    $F4, $F0
02:0003B0B7 F0
                            	  7040: 
                            	  7041: ; Params:
                            	  7042: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7043: ; [00]: monster hotspot X
                            	  7044: ; [01]: monster hotspot Y
                            	  7045: ; [02]: bomb hotspot X
                            	  7046: ; [03]: bomb hotspot Y
                            	  7047: ;
                            	  7048: ; Returns:
                            	  7049: ; A: 0 if the bomb is in range of the monster
                            	  7050: ; Z: 1 if the bomb is in range of the monster
                            	  7051: ; [04]: horizontal distance
                            	  7052: ; [05]: vertical distance
                            	  7053: ;
                            	  7054: ; Store the positive limit in [06], and the negative one in [07].
                            	  7055: ;
                            	  7056:     even
                            	  7057: Dodongo_IsBombInRange:
02:0003B0B8 41F90003B0B4    	  7058:     lea     (DodongoBombPositiveLimits).l,A0
02:0003B0BE 10303000        	  7059:     move.b  (A0,D3.W),D0
02:0003B0C2 19400006        	  7060:     move.b  D0,($0006,A4)
02:0003B0C6 41F90003B0B6    	  7061:     lea     (DodongoBombNegativeLimits).l,A0
