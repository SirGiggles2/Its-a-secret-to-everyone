02:0003940C 41EC0084        	  3075:     lea     ($0084,A4),A0
02:00039410 11802000        	  3076:     move.b  D0,(A0,D2.W)
                            	  3077:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3078:     ; it's too close to the top edge of the screen. So, return.
                            	  3079:     ;
02:00039414 0C00005D        	  3080:     cmpi.b  #$5D,D0
02:00039418 65EC            	  3081:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3082:     ; If facing right, then use X offset $28.
                            	  3083:     ; Else store X offset -$28 in [00].
                            	  3084:     ;
02:0003941A 7628            	  3085:     moveq   #40,D3
02:0003941C 41EC0098        	  3086:     lea     ($0098,A4),A0
02:00039420 10302000        	  3087:     move.b  (A0,D2.W),D0
02:00039424 02000002        	  3088:     andi.b #$02,D0
02:00039428 6704            	  3089:     beq  _anon_z04_45
