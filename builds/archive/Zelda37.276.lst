                            	  7141: Dodongo_Draw:
02:0003B142 610000F4        	  7142:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7143:     ; Make a 5-way direction index out of the facing direction
                            	  7144:     ; by shifting right once, and store it in [00].
                            	  7145:     ;
02:0003B146 41EC0098        	  7146:     lea     ($0098,A4),A0
02:0003B14A 10302000        	  7147:     move.b  (A0,D2.W),D0
02:0003B14E E208            	  7148:     lsr.b  #1,D0   ; LSR A
02:0003B150 1880            	  7149:     move.b  D0,($0000,A4)
                            	  7150:     ; If state = 0, go handle animating the two frames of this state.
                            	  7151:     ;
02:0003B152 7600            	  7152:     moveq   #0,D3
02:0003B154 41EC00AC        	  7153:     lea     ($00AC,A4),A0
02:0003B158 16302000        	  7154:     move.b  (A0,D2.W),D3
02:0003B15C 6744            	  7155:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7156:     ; If state > 1, then the monster is stunned (state 2).
                            	  7157:     ; So, go switch frames every $20 screen frames.
                            	  7158:     ;
02:0003B15E 7020            	  7159:     moveq   #32,D0
02:0003B160 5303            	  7160:     subq.b  #1,D3
02:0003B162 6640            	  7161:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7162:     ; State = 1. Bloated.
                            	  7163:     ;
                            	  7164:     ; In substate 0, go animate as usual for walking.
                            	  7165:     ;
02:0003B164 7600            	  7166:     moveq   #0,D3
02:0003B166 41EC042C        	  7167:     lea     ($042C,A4),A0
02:0003B16A 16302000        	  7168:     move.b  (A0,D2.W),D3
02:0003B16E 6732            	  7169:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7170:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7171:     ; go fade the boss; so that some frames are not drawn.
                            	  7172:     ;
02:0003B170 0C030002        	  7173:     cmpi.b  #$02,D3
02:0003B174 6718            	  7174:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003B176 0C030003        	  7175:     cmpi.b  #$03,D3
02:0003B17A 6712            	  7176:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7177:     ; State 1, substate 1
                            	  7178:     ;
                            	  7179:     ; Add $14 to the frame image index to index into the bloated
                            	  7180:     ; frame images and H-flips.
                            	  7181:     ;
02:0003B17C 1014            	  7182:     move.b  ($0000,A4),D0
02:0003B17E 023C00EE        	  7183:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B182 123C0014        	  7184:     move.b  #$14,D1
02:0003B186 D101            	  7185:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003B188 7600            	  7186:     moveq   #0,D3
02:0003B18A 1600            	  7187:     move.b  D0,D3
02:0003B18C 6032            	  7188:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7189: 
                            	  7190:     even
                            	  7191: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7192:     ; In bloated substates 2 and 3:
                            	  7193:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7194:     ;
02:0003B18E 102C0015        	  7195:     move.b  ($0015,A4),D0
02:0003B192 02000002        	  7196:     andi.b #$02,D0
02:0003B196 6604            	  7197:     bne.s  __far_z_04_0066
02:0003B198 600000A4        	  7198:     jmp  L11B00_Exit
                            	  7199: __far_z_04_0066:
02:0003B19C 7600            	  7200:     moveq   #0,D3
02:0003B19E 1614            	  7201:     move.b  ($0000,A4),D3
02:0003B1A0 601E            	  7202:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7203: 
                            	  7204:     even
                            	  7205: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7206:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7207:     ;
02:0003B1A2 7008            	  7208:     moveq   #8,D0
                            	  7209:     even
                            	  7210: _L_z04_Dodongo_Draw_DrawWalking:
02:0003B1A4 7600            	  7211:     moveq   #0,D3
02:0003B1A6 1614            	  7212:     move.b  ($0000,A4),D3
02:0003B1A8 122C0015        	  7213:     move.b  ($0015,A4),D1
02:0003B1AC C001            	  7214:     and.b  D1,D0
02:0003B1AE 6710            	  7215:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7216:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7217:     ; in order to index into the second set of frame image numbers.
                            	  7218:     ;
02:0003B1B0 1003            	  7219:     move.b  D3,D0
02:0003B1B2 023C00EE        	  7220:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B1B6 123C0005        	  7221:     move.b  #$05,D1
02:0003B1BA D101            	  7222:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003B1BC 7600            	  7223:     moveq   #0,D3
02:0003B1BE 1600            	  7224:     move.b  D0,D3
                            	  7225:     even
                            	  7226: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7227:     ; Start preparing sprites.
                            	  7228:     ;
02:0003B1C0 4EB90004AF7C    	  7229:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B1C6 1003            	  7230:     move.b  D3,D0
02:0003B1C8 1B00            	  7231:     move.b  D0,-(A5)  ; PHA
                            	  7232:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7233:     ;
02:0003B1CA 41F90003B124    	  7234:     lea     (DodongoFrameHFlips).l,A0
02:0003B1D0 10303000        	  7235:     move.b  (A0,D3.W),D0
02:0003B1D4 1940000F        	  7236:     move.b  D0,($000F,A4)
02:0003B1D8 41F90003B11A    	  7237:     lea     (DodongoFrameImages).l,A0
02:0003B1DE 10303000        	  7238:     move.b  (A0,D3.W),D0
                            	  7239:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7240:     ; They are drawn mirrored.
                            	  7241:     ;
02:0003B1E2 0C000007        	  7242:     cmpi.b  #$07,D0
02:0003B1E6 6706            	  7243:     beq  _anon_z04_92
02:0003B1E8 0C000009        	  7244:     cmpi.b  #$09,D0
02:0003B1EC 6608            	  7245:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7246: _anon_z04_92:
02:0003B1EE 4EB90003082E    	  7247:     jsr     DrawObjectMirrored
02:0003B1F4 6006            	  7248:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7249: 
                            	  7250:     even
                            	  7251: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7252:     ; No other frame images are mirrored.
                            	  7253:     ;
02:0003B1F6 4EB900030832    	  7254:     jsr     DrawObjectNotMirrored
                            	  7255:     even
                            	  7256: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003B1FC 101D            	  7257:     move.b  (A5)+,D0  ; PLA
02:0003B1FE 7600            	  7258:     moveq   #0,D3
02:0003B200 1600            	  7259:     move.b  D0,D3
                            	  7260:     ; If facing vertically, then return. There's no other side to draw.
                            	  7261:     ;
02:0003B202 41EC0098        	  7262:     lea     ($0098,A4),A0
02:0003B206 10302000        	  7263:     move.b  (A0,D2.W),D0
02:0003B20A 02000003        	  7264:     andi.b #$03,D0
02:0003B20E 6602            	  7265:     bne.s  __far_z_04_0067
02:0003B210 602C            	  7266:     jmp  L11B00_Exit
                            	  7267: __far_z_04_0067:
                            	  7268:     ; Else draw the right side.
                            	  7269:     ;
                            	  7270:     ; Keep the Y coordinate in [01].
                            	  7271:     ; But, store (X + $10) in [00].
                            	  7272:     ;
02:0003B212 10342070        	  7273:     move.b  ($70,A4,D2.W),D0
02:0003B216 023C00EE        	  7274:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B21A 123C0010        	  7275:     move.b  #$10,D1
02:0003B21E D101            	  7276:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003B220 1880            	  7277:     move.b  D0,($0000,A4)
02:0003B222 6114            	  7278:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7279:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7280:     ;
                            	  7281:     ; So, if we had animation frame 1, direction left:
                            	  7282:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7283:     ; - frame image index = 6 (1 + 5)
                            	  7284:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7285:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7286:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7287:     ;
                            	  7288:     ; So, 3 would have been the frame number used above for
                            	  7289:     ; the left side.
                            	  7290:     ;
                            	  7291:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7292:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7293:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7294:     ; on the right.
                            	  7295:     ;
02:0003B224 41F90003B11A    	  7296:     lea     (DodongoFrameImages).l,A0
02:0003B22A 10303000        	  7297:     move.b  (A0,D3.W),D0
02:0003B22E 0A000001        	  7298:     eori.b #$01,D0
02:0003B232 4EF900030832    	  7299:     jmp     DrawObjectNotMirrored
                            	  7300: 
                            	  7301: ; Returns:
                            	  7302: ; A: 3
                            	  7303: ; [04]: left sprite attributes
                            	  7304: ; [05]: right sprite attributes
                            	  7305: ;
                            	  7306:     even
                            	  7307: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003B238 4EF90002C310    	  7308:     jmp     c_anim_set_sprite_desc_level_palette_row
