02:0003B29E 7008            	  7342:     moveq   #8,D0
02:0003B2A0 4EB90004AF76    	  7343:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7344:     ; If facing left, then enable horizontal flipping.
