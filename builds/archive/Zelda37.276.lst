                            	  6630: UpdateDodongoState0_Move:
                            	  6631:     ; If facing left, then push X offset 0 on the stack.
                            	  6632:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6633:     ;
                            	  6634:     ; We would like to use one set of coordinates only.
                            	  6635:     ; But movement would break down, if we did; because
                            	  6636:     ; Dodongo is so long.
                            	  6637:     ;
                            	  6638:     ; So, when not facing left, we temporarily shift the
                            	  6639:     ; X coordinate to be closer to the other side of the monster.
                            	  6640:     ;
02:0003ADE4 7600            	  6641:     moveq   #0,D3
02:0003ADE6 41EC0098        	  6642:     lea     ($0098,A4),A0
02:0003ADEA 10302000        	  6643:     move.b  (A0,D2.W),D0
02:0003ADEE 0200000D        	  6644:     andi.b #$0D,D0
02:0003ADF2 6716            	  6645:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003ADF4 10342070        	  6646:     move.b  ($70,A4,D2.W),D0
02:0003ADF8 023C00EE        	  6647:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADFC 123C0010        	  6648:     move.b  #$10,D1
02:0003AE00 D101            	  6649:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003AE02 19802070        	  6650:     move.b  D0,($70,A4,D2.W)
02:0003AE06 163C00F0        	  6651:     move.b  #$F0,D3
                            	  6652:     even
                            	  6653: _L_z04_UpdateDodongoState0_Move_Move:
02:0003AE0A 1003            	  6654:     move.b  D3,D0
02:0003AE0C 1B00            	  6655:     move.b  D0,-(A5)  ; PHA
02:0003AE0E 7020            	  6656:     moveq   #32,D0
02:0003AE10 41EC041F        	  6657:     lea     ($041F,A4),A0
02:0003AE14 11802000        	  6658:     move.b  D0,(A0,D2.W)
02:0003AE18 6100D21A        	  6659:     jsr     Wanderer_TargetPlayer
                            	  6660:     ; Pop the offset and add it to the X coordinate.
                            	  6661:     ;
                            	  6662:     ; This brings the X coordinate back to the unique value
                            	  6663:     ; that represents the position.
                            	  6664:     ;
02:0003AE1C 101D            	  6665:     move.b  (A5)+,D0  ; PLA
02:0003AE1E 023C00EE        	  6666:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE22 12342070        	  6667:     move.b  ($70,A4,D2.W),D1
02:0003AE26 D101            	  6668:     addx.b  D1,D0   ; ADC ObjX,X
02:0003AE28 19802070        	  6669:     move.b  D0,($70,A4,D2.W)
                            	  6670:     ; If X coordinate < $20, then face right.
                            	  6671:     ;
02:0003AE2C 0C000020        	  6672:     cmpi.b  #$20,D0
02:0003AE30 640A            	  6673:     bcc  _anon_z04_89
02:0003AE32 7001            	  6674:     moveq   #1,D0
02:0003AE34 41EC0098        	  6675:     lea     ($0098,A4),A0
02:0003AE38 11802000        	  6676:     move.b  D0,(A0,D2.W)
                            	  6677: _anon_z04_89:
02:0003AE3C 0A3C0001        	  6678:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003AE40 4E75            	  6679:     rts
