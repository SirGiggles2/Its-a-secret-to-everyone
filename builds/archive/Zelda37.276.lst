                            	  3671: UpdateArmos:
02:00039814 6100E94E        	  3672:     jsr     UpdateGoriya
                            	  3673:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3674:     ;
02:00039818 41EC00C0        	  3675:     lea     ($00C0,A4),A0
02:0003981C 10302000        	  3676:     move.b  (A0,D2.W),D0
02:00039820 6702            	  3677:     beq.s  __far_z_04_0033
