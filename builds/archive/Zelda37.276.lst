                            	 11934:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 11935:     ;
02:0003D536 7000            	 11936:     moveq   #0,D0
02:0003D538 1940000B        	 11937:     move.b  D0,($000B,A4)
                            	 11938:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 11939:     ; monster's angle by $70, else by $60 to go slower.
                            	 11940:     ;
02:0003D53C 7070            	 11941:     moveq   #112,D0
