                            	  7512: _L_z04_UpdatePolsVoice_SetState1:
                            	  7513:     ; If already in state 1, then go draw and check collisions.
                            	  7514:     ;
02:0003B3DA 41EC00AC        	  7515:     lea     ($00AC,A4),A0
02:0003B3DE 10302000        	  7516:     move.b  (A0,D2.W),D0
02:0003B3E2 6702            	  7517:     beq.s  __far_z_04_0069
02:0003B3E4 6068            	  7518:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7519: __far_z_04_0069:
                            	  7520:     ; Go to state 1.
                            	  7521:     ;
02:0003B3E6 41EC00AC        	  7522:     lea     ($00AC,A4),A0
02:0003B3EA 52302000        	  7523:     addq.b  #1,(A0,D2.W)
                            	  7524:     ; Subtract 1 from facing direction to make an index.
                            	  7525:     ;
02:0003B3EE 7600            	  7526:     moveq   #0,D3
02:0003B3F0 41EC0098        	  7527:     lea     ($0098,A4),A0
02:0003B3F4 16302000        	  7528:     move.b  (A0,D2.W),D3
02:0003B3F8 5303            	  7529:     subq.b  #1,D3
                            	  7530:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7531:     ;
02:0003B3FA 41EC0084        	  7532:     lea     ($0084,A4),A0
02:0003B3FE 10302000        	  7533:     move.b  (A0,D2.W),D0
02:0003B402 0C000078        	  7534:     cmpi.b  #$78,D0
02:0003B406 6402            	  7535:     bcc  _anon_z04_97
02:0003B408 7603            	  7536:     moveq   #3,D3
                            	  7537: _anon_z04_97:
                            	  7538:     ; If Y coordinate >= $A8, make the index 7 for up.
