02:00034BBA 41EC0302        	  4711:     lea     ($0302,A4),A0
02:00034BBE 11803000        	  4712:     move.b  D0,(A0,D3.W)
02:00034BC2 5303            	  4713:     subq.b  #1,D3
02:00034BC4 6AEA            	  4714:     bpl  _anon_z02_34
                            	  4715:     ; Use (timer MOD 4) as an index to look up a color.
