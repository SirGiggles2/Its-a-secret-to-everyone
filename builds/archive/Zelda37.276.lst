                            	  1313: UpdateZolState2_Split:
                            	  1314:     ; We'll create two gels, but destroy the zol. So, increase
                            	  1315:     ; the object count by 1 only.
                            	  1316:     ;
02:00038812 522C034E        	  1317:     addq.b  #1,($034E,A4)
02:00038816 4EB90004B758    	  1318:     jsr     DestroyMonster
02:0003881C 612C            	  1319:     jsr     CreateChildGel
                            	  1320:     ; If the zol's direction is vertical, then set the first child gel's
                            	  1321:     ; direction to left, else up.
                            	  1322:     ;
02:0003881E 41EC0098        	  1323:     lea     ($0098,A4),A0
02:00038822 10302000        	  1324:     move.b  (A0,D2.W),D0
02:00038826 0C000004        	  1325:     cmpi.b  #$04,D0
02:0003882A 7002            	  1326:     moveq   #2,D0
02:0003882C 6402            	  1327:     bcc  _anon_z04_25
02:0003882E 7008            	  1328:     moveq   #8,D0
                            	  1329: _anon_z04_25:
02:00038830 41EC0098        	  1330:     lea     ($0098,A4),A0
02:00038834 11803000        	  1331:     move.b  D0,(A0,D3.W)
02:00038838 1B00            	  1332:     move.b  D0,-(A5)  ; PHA
