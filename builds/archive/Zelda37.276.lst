                            	  5546:     ; Chase while flying, as usual.
                            	  5547:     ;
02:0003A620 610039CC        	  5548:     jsr     Flyer_Chase
                            	  5549:     ; If timer has not expired, then
                            	  5550:     ; go see if it's time to propagate direction changes down the chain.
                            	  5551:     ;
02:0003A624 10342028        	  5552:     move.b  ($28,A4,D2.W),D0
02:0003A628 6702            	  5553:     beq.s  __far_z_04_0041
