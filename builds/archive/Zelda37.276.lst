                            	  1175: _L_z04_UpdateFireball_Move:
                            	  1176:     ; A movement routine is used that works along one axis.
                            	  1177:     ; So, load its parameters, and call it for each axis individually.
                            	  1178:     ;
                            	  1179:     ; First, load the horizontal direction into [0F].
                            	  1180:     ;
02:00038706 41EC0412        	  1181:     lea     ($0412,A4),A0
02:0003870A 10302000        	  1182:     move.b  (A0,D2.W),D0
02:0003870E 1940000F        	  1183:     move.b  D0,($000F,A4)
                            	  1184:     ; Load the horizontal q-speed and position fraction,
                            	  1185:     ; move, then save the position fraction.
                            	  1186:     ;
02:00038712 41EC041F        	  1187:     lea     ($041F,A4),A0
02:00038716 10302000        	  1188:     move.b  (A0,D2.W),D0
02:0003871A 7600            	  1189:     moveq   #0,D3
02:0003871C 41EC0451        	  1190:     lea     ($0451,A4),A0
02:00038720 16302000        	  1191:     move.b  (A0,D2.W),D3
02:00038724 613E            	  1192:     jsr     Fireball_MoveOneAxis
02:00038726 41EC0451        	  1193:     lea     ($0451,A4),A0
02:0003872A 11802000        	  1194:     move.b  D0,(A0,D2.W)
                            	  1195:     ; Second, load the vertical direction into [0F].
                            	  1196:     ;
02:0003872E 41EC0437        	  1197:     lea     ($0437,A4),A0
02:00038732 10302000        	  1198:     move.b  (A0,D2.W),D0
02:00038736 1940000F        	  1199:     move.b  D0,($000F,A4)
                            	  1200:     ; Load the vertical q-speed and position fraction,
                            	  1201:     ; move, then save the position fraction.
                            	  1202:     ;
02:0003873A 41EC0444        	  1203:     lea     ($0444,A4),A0
02:0003873E 10302000        	  1204:     move.b  (A0,D2.W),D0
02:00038742 7600            	  1205:     moveq   #0,D3
02:00038744 41EC045E        	  1206:     lea     ($045E,A4),A0
02:00038748 16302000        	  1207:     move.b  (A0,D2.W),D3
