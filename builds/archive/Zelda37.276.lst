02:000383EC 9101            	   749:     subx.b  D1,D0   ; SBC ObjX,X
02:000383EE 0A3C0010        	   750:     eori    #$10,CCR  ; restore X = 6502 C
                            	   751:     even
                            	   752: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   753:     ; If the difference in coordinates is negative, then Link is
                            	   754:     ; up or left of the block.
                            	   755:     ;
                            	   756:     ; In that case, increase Y register to index the correct opposite
                            	   757:     ; direction below. Also, negate the difference, so we test
                            	   758:     ; positive values.
                            	   759:     ;
02:000383F2 6A06            	   760:     bpl  _anon_z04_14
02:000383F4 5203            	   761:     addq.b  #1,D3
02:000383F6 61008072        	   762:     jsr     Negate
