02:0003C008 8001            	  9091:     or.b  D1,D0
02:0003C00A 41EC0478        	  9092:     lea     ($0478,A4),A0
02:0003C00E 11802000        	  9093:     move.b  D0,(A0,D2.W)
                            	  9094:     ; If this segment is the base, then go draw.
                            	  9095:     ;
02:0003C012 0C020005        	  9096:     cmpi.b  #$05,D2
02:0003C016 6736            	  9097:     beq  _L_z04_UpdateManhandla_Draw
                            	  9098:     ; If the old and new "frame image and sprite attributes" variables
                            	  9099:     ; are the same, then go draw.
                            	  9100:     ;
                            	  9101:     ; The previous frame value begins with value 0, because all
                            	  9102:     ; room data was reset on entry.
                            	  9103:     ;
02:0003C018 41EC0478        	  9104:     lea     ($0478,A4),A0
02:0003C01C 10302000        	  9105:     move.b  (A0,D2.W),D0
02:0003C020 41EC0437        	  9106:     lea     ($0437,A4),A0
02:0003C024 12302000        	  9107:     move.b  (A0,D2.W),D1
02:0003C028 B001            	  9108:     cmp.b   D1,D0
02:0003C02A 6722            	  9109:     beq  _L_z04_UpdateManhandla_Draw
                            	  9110:     ; Copy the new value to the old variable, so that they're the same.
                            	  9111:     ;
02:0003C02C 41EC0437        	  9112:     lea     ($0437,A4),A0
02:0003C030 11802000        	  9113:     move.b  D0,(A0,D2.W)
                            	  9114:     ; If animation frame = 1, then go draw.
