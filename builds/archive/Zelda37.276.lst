02:0003E9F2 102C0098        	  1020:     move.b  ($0098,A4),D0
02:0003E9F6 0C000004        	  1021:     cmpi.b  #$04,D0
02:0003E9FA 6406            	  1022:     bcc  _L_z05_InitMode7_Sub5_Vertical
                            	  1023:     ; then cue transfer of a row of blanks above the play area.
                            	  1024:     ; This should lead to clean vertical scrolling without visual
                            	  1025:     ; artifacts.
