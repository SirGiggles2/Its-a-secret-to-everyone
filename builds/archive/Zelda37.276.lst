02:00039392 102C0510        	  3010:     move.b  ($0510,A4),D0
02:00039396 0C000002        	  3011:     cmpi.b  #$02,D0
02:0003939A 646A            	  3012:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3013:     ; Face in the same direction as Link.
                            	  3014:     ;
