                            	  2442: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2443:     ; If reversal count >= 2, then
                            	  2444:     ; 1. invert the horizontal component of facing direction,
                            	  2445:     ;    to face away from the chase target
                            	  2446:     ; 2. reset the reversal count to 0.
                            	  2447:     ;
                            	  2448:     ; This prevents a jumper from getting stuck in a corner.
                            	  2449:     ;
                            	  2450:     ; For example, if a tektite's direction is down and right,
                            	  2451:     ; and jumps into the top right corner of the room:
                            	  2452:     ; 1. The right room boundary is hit. So the direction is
                            	  2453:     ;    automatically reversed to up and left.
                            	  2454:     ; 2. The next frame, the top room boundary is hit.
                            	  2455:     ;    The direction is reversed to down and right.
                            	  2456:     ;
                            	  2457:     ; As you can see, an endless loop has been made.
                            	  2458:     ;
02:00038F4C 41EC0451        	  2459:     lea     ($0451,A4),A0
02:00038F50 10302000        	  2460:     move.b  (A0,D2.W),D0
02:00038F54 0C000002        	  2461:     cmpi.b  #$02,D0
02:00038F58 651E            	  2462:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:00038F5A 41EC0098        	  2463:     lea     ($0098,A4),A0
02:00038F5E 10302000        	  2464:     move.b  (A0,D2.W),D0
02:00038F62 0A000003        	  2465:     eori.b #$03,D0
02:00038F66 41EC0098        	  2466:     lea     ($0098,A4),A0
02:00038F6A 11802000        	  2467:     move.b  D0,(A0,D2.W)
02:00038F6E 7000            	  2468:     moveq   #0,D0
02:00038F70 41EC0451        	  2469:     lea     ($0451,A4),A0
02:00038F74 11802000        	  2470:     move.b  D0,(A0,D2.W)
                            	  2471:     even
                            	  2472: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2473:     ; If the object is a boulder, then make sure its facing direction
                            	  2474:     ; has a down vertical component.
                            	  2475:     ;
02:00038F78 610001F8        	  2476:     jsr     Jumper_PointBoulderDownward
                            	  2477:     ; For the given direction, get the Y offset of the destination
                            	  2478:     ; of the jump.
