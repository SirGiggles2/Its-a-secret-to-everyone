                            	  6955: Dodongo_TryEatBomb:
                            	  6956:     ; Try to eat the bomb.
                            	  6957:     ;
                            	  6958:     ; If the bomb is not in range of the monster, then return.
                            	  6959:     ;
                            	  6960:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  6961:     ;
02:0003B046 7601            	  6962:     moveq   #1,D3
02:0003B048 616E            	  6963:     jsr     Dodongo_IsBombInRange
02:0003B04A 6666            	  6964:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  6965:     ; Will loop from 1 to 0, indexed by [00].
                            	  6966:     ;
02:0003B04C 7001            	  6967:     moveq   #1,D0
02:0003B04E 1880            	  6968:     move.b  D0,($0000,A4)
                            	  6969:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  6970:     ;
02:0003B050 41EC0098        	  6971:     lea     ($0098,A4),A0
02:0003B054 10302000        	  6972:     move.b  (A0,D2.W),D0
02:0003B058 E208            	  6973:     lsr.b  #1,D0   ; LSR A
02:0003B05A 7600            	  6974:     moveq   #0,D3
02:0003B05C 1600            	  6975:     move.b  D0,D3
                            	  6976:     ; Now we have to see if it's near the mouth. But the mouth
                            	  6977:     ; position depends on the orientation of the monster.
                            	  6978:     ;
                            	  6979:     ; Start with the horizontal distance.
                            	  6980:     ;
02:0003B05E 102C0004        	  6981:     move.b  ($0004,A4),D0
                            	  6982:     even
                            	  6983: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  6984:     ; Look up the limits for the given direction.
                            	  6985:     ;
                            	  6986:     ; If the distance from the bomb < negative limit,
                            	  6987:     ; or >= positive limit, then return.
                            	  6988:     ;
                            	  6989:     ; Note that these are simple signed comparisons that work,
                            	  6990:     ; because the operands are in a small range.
                            	  6991:     ;
02:0003B062 41F90003AF9C    	  6992:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003B068 12303000        	  6993:     move.b  (A0,D3.W),D1
02:0003B06C B001            	  6994:     cmp.b   D1,D0
02:0003B06E 6B42            	  6995:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003B070 41F90003AFA2    	  6996:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003B076 12303000        	  6997:     move.b  (A0,D3.W),D1
02:0003B07A B001            	  6998:     cmp.b   D1,D0
02:0003B07C 6A34            	  6999:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7000:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7001:     ;
02:0003B07E 1003            	  7002:     move.b  D3,D0
02:0003B080 023C00EE        	  7003:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B084 123C000A        	  7004:     move.b  #$0A,D1
02:0003B088 D101            	  7005:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003B08A 7600            	  7006:     moveq   #0,D3
02:0003B08C 1600            	  7007:     move.b  D0,D3
                            	  7008:     ; Bottom of the loop.
                            	  7009:     ;
                            	  7010:     ; Load the vertical distance for the next iteration.
                            	  7011:     ; Decrement loop counter.
                            	  7012:     ;
02:0003B08E 102C0005        	  7013:     move.b  ($0005,A4),D0
02:0003B092 5314            	  7014:     subq.b  #1,($0000,A4)
02:0003B094 6ACC            	  7015:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7016:     ; If we get here, then the bomb was within range of the mouth.
                            	  7017:     ; Go to state 1 (bloated).
                            	  7018:     ;
02:0003B096 41EC00AC        	  7019:     lea     ($00AC,A4),A0
02:0003B09A 52302000        	  7020:     addq.b  #1,(A0,D2.W)
                            	  7021:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7022:     ;
02:0003B09E 7610            	  7023:     moveq   #16,D3
02:0003B0A0 7000            	  7024:     moveq   #0,D0
02:0003B0A2 41EC00AC        	  7025:     lea     ($00AC,A4),A0
02:0003B0A6 11803000        	  7026:     move.b  D0,(A0,D3.W)
02:0003B0AA 41EC042C        	  7027:     lea     ($042C,A4),A0
02:0003B0AE 11802000        	  7028:     move.b  D0,(A0,D2.W)
                            	  7029:     even
                            	  7030: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003B0B2 4E75            	  7031:     rts
