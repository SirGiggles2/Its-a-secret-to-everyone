                            	  7351: _anon_z04_94:
                            	  7352:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7353:     ; This is the base frame image.
                            	  7354:     ;
02:0003B2B8 E208            	  7355:     lsr.b  #1,D0   ; LSR A
02:0003B2BA E208            	  7356:     lsr.b  #1,D0   ; LSR A
                            	  7357:     ; If movement frame = 1, add 3 to frame image to access
                            	  7358:     ; the second animation frame's images.
                            	  7359:     ;
02:0003B2BC 7600            	  7360:     moveq   #0,D3
02:0003B2BE 41EC03E4        	  7361:     lea     ($03E4,A4),A0
02:0003B2C2 16302000        	  7362:     move.b  (A0,D2.W),D3
02:0003B2C6 671E            	  7363:     beq  _anon_z04_95
02:0003B2C8 023C00EE        	  7364:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B2CC 123C0003        	  7365:     move.b  #$03,D1
02:0003B2D0 D101            	  7366:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7367:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7368:     ;
                            	  7369:     ; Down has two frame images, but up only has one. By flipping
                            	  7370:     ; horizontally, you get two frame images.
                            	  7371:     ;
02:0003B2D2 7600            	  7372:     moveq   #0,D3
02:0003B2D4 41EC0098        	  7373:     lea     ($0098,A4),A0
02:0003B2D8 16302000        	  7374:     move.b  (A0,D2.W),D3
02:0003B2DC 0C030008        	  7375:     cmpi.b  #$08,D3
02:0003B2E0 6604            	  7376:     bne  _anon_z04_95
02:0003B2E2 522C000F        	  7377:     addq.b  #1,($000F,A4)
                            	  7378: _anon_z04_95:
