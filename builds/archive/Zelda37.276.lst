02:0004A8F4 00
02:0004A8F5 F8
02:0004A8F6 FF
02:0004A8F7 01
02:0004A8F8 F5
02:0004A8F9 0B
02:0004A8FA FF              	  5944:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004A8FB 01
02:0004A8FC F9
02:0004A8FD 07
02:0004A8FE FF
02:0004A8FF 01
02:0004A900 FD
02:0004A901 03
                            	  5945: 
                            	  5946: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5947: ; Each set contains 4 offsets in reverse direction index order:
                            	  5948: ; up, down, left, right
