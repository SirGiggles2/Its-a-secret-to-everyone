02:000383D6 60000084        	   739:     jmp  ResetPushTimer
                            	   740: __far_z_04_0006:
                            	   741:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   742:     ; Get the difference in X.
                            	   743:     ;
02:000383DA 7602            	   744:     moveq   #2,D3
02:000383DC 102C0070        	   745:     move.b  ($0070,A4),D0
02:000383E0 003C0011        	   746:     ori     #$11,CCR  ; SEC: set C+X
02:000383E4 12342070        	   747:     move.b  ($70,A4,D2.W),D1
