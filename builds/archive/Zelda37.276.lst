                            	  2509: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2510:     ; State 1. Jumping.
                            	  2511:     ;
                            	  2512:     ; Keep the object inside the bounds of the room.
                            	  2513:     ;
02:00038FC4 61004FB6        	  2514:     jsr     BoundFlyer
                            	  2515:     ; If the object was blocked at the room boundary, then
                            	  2516:     ; increase boundary reversal count, and go set up another jump.
                            	  2517:     ;
02:00038FC8 102C000F        	  2518:     move.b  ($000F,A4),D0
02:00038FCC 660C            	  2519:     bne  _anon_z04_37
02:00038FCE 41EC0451        	  2520:     lea     ($0451,A4),A0
02:00038FD2 52302000        	  2521:     addq.b  #1,(A0,D2.W)
02:00038FD6 6000FF74        	  2522:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2523: 
                            	  2524: _anon_z04_37:
02:00038FDA 61000196        	  2525:     jsr     Jumper_PointBoulderDownward
                            	  2526:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2527:     ;
02:00038FDE 7000            	  2528:     moveq   #0,D0
02:00038FE0 41EC0451        	  2529:     lea     ($0451,A4),A0
02:00038FE4 11802000        	  2530:     move.b  D0,(A0,D2.W)
                            	  2531:     ; Get the base offset for the kind of jumper the object is.
                            	  2532:     ;
02:00038FE8 6100015E        	  2533:     jsr     Jumper_GetKind
02:00038FEC 41F900038ED8    	  2534:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:00038FF2 10303000        	  2535:     move.b  (A0,D3.W),D0
                            	  2536:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2537:     ;
                            	  2538:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2539:     ; does not have $B elements like the tektites' sets.
                            	  2540:     ;
                            	  2541:     ; Boulder does not need the upward accelerations.
                            	  2542:     ; So, the elements for those are used for the starting speeds
                            	  2543:     ; at 04:88F2.
                            	  2544:     ;
02:00038FF6 023C00EE        	  2545:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038FFA 41EC0098        	  2546:     lea     ($0098,A4),A0
02:00038FFE 12302000        	  2547:     move.b  (A0,D2.W),D1
02:00039002 D101            	  2548:     addx.b  D1,D0   ; ADC ObjDir,X
02:00039004 7600            	  2549:     moveq   #0,D3
02:00039006 1600            	  2550:     move.b  D0,D3
02:00039008 41F900038EB6    	  2551:     lea     (JumperYAccelerations).l,A0
02:0003900E 10303000        	  2552:     move.b  (A0,D3.W),D0
02:00039012 7602            	  2553:     moveq   #2,D3
02:00039014 61000162        	  2554:     jsr     Jumper_MoveY
                            	  2555:     ; If the facing direction has a left component, then
                            	  2556:     ; subtract 1 from the object's X.
                            	  2557:     ;
                            	  2558:     ; Else add 1.
                            	  2559:     ;
02:00039018 163C00FF        	  2560:     move.b  #$FF,D3
02:0003901C 41EC0098        	  2561:     lea     ($0098,A4),A0
02:00039020 10302000        	  2562:     move.b  (A0,D2.W),D0
02:00039024 02000002        	  2563:     andi.b #$02,D0
02:00039028 6602            	  2564:     bne  _anon_z04_38
02:0003902A 7601            	  2565:     moveq   #1,D3
                            	  2566: _anon_z04_38:
02:0003902C 1003            	  2567:     move.b  D3,D0
02:0003902E 023C00EE        	  2568:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039032 12342070        	  2569:     move.b  ($70,A4,D2.W),D1
02:00039036 D101            	  2570:     addx.b  D1,D0   ; ADC ObjX,X
02:00039038 19802070        	  2571:     move.b  D0,($70,A4,D2.W)
                            	  2572:     ; If going up (negative v-speed high byte), then
                            	  2573:     ; go animate, draw, and check collisions.
                            	  2574:     ;
02:0003903C 41EC0412        	  2575:     lea     ($0412,A4),A0
02:00039040 10302000        	  2576:     move.b  (A0,D2.W),D0
02:00039044 6A04            	  2577:     bpl.s  __far_z_04_0022
02:00039046 60000090        	  2578:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2579: __far_z_04_0022:
                            	  2580:     ; Going down. We have to consider the target Y.
                            	  2581:     ;
                            	  2582:     ; If the absolute vertical distance to the target position >= 3,
                            	  2583:     ; then go animate, draw, and check collisions.
                            	  2584:     ;
02:0003904A 41EC0084        	  2585:     lea     ($0084,A4),A0
02:0003904E 10302000        	  2586:     move.b  (A0,D2.W),D0
02:00039052 003C0011        	  2587:     ori     #$11,CCR  ; SEC: set C+X
02:00039056 41EC0444        	  2588:     lea     ($0444,A4),A0
02:0003905A 12302000        	  2589:     move.b  (A0,D2.W),D1
02:0003905E 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039062 9101            	  2591:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00039064 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:00039068 4EB900030466    	  2593:     jsr     Abs
02:0003906E 0C000003        	  2594:     cmpi.b  #$03,D0
02:00039072 6502            	  2595:     bcs.s  __far_z_04_0023
02:00039074 6062            	  2596:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2597: __far_z_04_0023:
                            	  2598:     ; Distance < 3. Go to state 0.
                            	  2599:     ;
                            	  2600:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2601:     ;
02:00039076 4EB90004AB2C    	  2602:     jsr     ResetObjState
02:0003907C 7600            	  2603:     moveq   #0,D3
02:0003907E 41EC034F        	  2604:     lea     ($034F,A4),A0
02:00039082 16302000        	  2605:     move.b  (A0,D2.W),D3
02:00039086 0C030020        	  2606:     cmpi.b  #$20,D3
02:0003908A 6748            	  2607:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2608:     ; Else calculate a timer value.
                            	  2609:     ;
                            	  2610:     ; t := (Random + $10)
                            	  2611:     ; if t < $20 then
                            	  2612:     ;   t := t - $40
                            	  2613:     ;
02:0003908C 7010            	  2614:     moveq   #16,D0
02:0003908E 023C00EE        	  2615:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039092 12342019        	  2616:     move.b  ($19,A4,D2.W),D1
02:00039096 D101            	  2617:     addx.b  D1,D0   ; ADC Random+1,X
02:00039098 0C000020        	  2618:     cmpi.b  #$20,D0
02:0003909C 6412            	  2619:     bcc  _anon_z04_39
02:0003909E 003C0011        	  2620:     ori     #$11,CCR  ; SEC: set C+X
02:000390A2 123C0040        	  2621:     move.b  #$40,D1
02:000390A6 0A3C0010        	  2622:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000390AA 9101            	  2623:     subx.b  D1,D0   ; SBC #$40
02:000390AC 0A3C0010        	  2624:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2625: _anon_z04_39:
                            	  2626:     ; If the object is a blue tektite, then go use this t.
                            	  2627:     ;
02:000390B0 7600            	  2628:     moveq   #0,D3
02:000390B2 41EC034F        	  2629:     lea     ($034F,A4),A0
02:000390B6 16302000        	  2630:     move.b  (A0,D2.W),D3
02:000390BA 0C03000D        	  2631:     cmpi.b  #$0D,D3
02:000390BE 6714            	  2632:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2633:     ; t := t AND $7F
                            	  2634:     ;
02:000390C0 0200007F        	  2635:     andi.b #$7F,D0
                            	  2636:     ; If Random < $A0, then go use this t.
                            	  2637:     ;
02:000390C4 7600            	  2638:     moveq   #0,D3
02:000390C6 16342019        	  2639:     move.b  ($19,A4,D2.W),D3
02:000390CA 0C0300A0        	  2640:     cmpi.b  #$A0,D3
02:000390CE 6504            	  2641:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2642:     ; t := t AND $F
                            	  2643:     ;
02:000390D0 0200000F        	  2644:     andi.b #$0F,D0
                            	  2645:     even
                            	  2646: _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate:
02:000390D4 19802028        	  2647:     move.b  D0,($28,A4,D2.W)
                            	  2648:     even
                            	  2649: Jumper_AnimateAndCheckCollisions:
02:000390D8 4EB90004AF7C    	  2650:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2651:     ; TODO: [0D] ?
                            	  2652:     ; [0D] doesn't seem to be used.
                            	  2653:     ;
02:000390DE 1940000D        	  2654:     move.b  D0,($000D,A4)
                            	  2655:     ; If the monster is a boulder, then go animate, draw, check collision.
                            	  2656:     ;
02:000390E2 41EC034F        	  2657:     lea     ($034F,A4),A0
02:000390E6 10302000        	  2658:     move.b  (A0,D2.W),D0
02:000390EA 0C000020        	  2659:     cmpi.b  #$20,D0
02:000390EE 672A            	  2660:     beq  _L_z04_Jumper_AnimateAndCheckCollisions_DrawBoulder
                            	  2661:     ; Draw a tektite.
                            	  2662:     ;
                            	  2663:     ; If state = 1, then go draw frame image 1, and check collisions.
                            	  2664:     ;
02:000390F0 41EC00AC        	  2665:     lea     ($00AC,A4),A0
02:000390F4 10302000        	  2666:     move.b  (A0,D2.W),D0
02:000390F8 661C            	  2667:     bne  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2668:     ; If object timer < $21, go draw frame image 0, and check collisions.
                            	  2669:     ;
02:000390FA 7600            	  2670:     moveq   #0,D3
02:000390FC 16342028        	  2671:     move.b  ($28,A4,D2.W),D3
02:00039100 0C030021        	  2672:     cmpi.b  #$21,D3
02:00039104 6510            	  2673:     bcs  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2674:     ; Else cycle the animation counter, draw, and check collisions.
                            	  2675:     ;
                            	  2676:     ; The movement frame determines the frame image.
                            	  2677:     ;
02:00039106 7010            	  2678:     moveq   #16,D0
02:00039108 4EB90004AF76    	  2679:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003910E 41EC03E4        	  2680:     lea     ($03E4,A4),A0
02:00039112 10302000        	  2681:     move.b  (A0,D2.W),D0
                            	  2682:     even
                            	  2683: _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite:
02:00039116 6000054A        	  2684:     jmp     DrawObjectMirroredAndCheckCollisions
                            	  2685: 
                            	  2686:     even
                            	  2687: _L_z04_Jumper_AnimateAndCheckCollisions_DrawBoulder:
                            	  2688:     ; Draw a boulder.
                            	  2689:     ;
02:0003911A 7006            	  2690:     moveq   #6,D0
02:0003911C 4EB90004AF76    	  2691:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:00039122 41EC03E4        	  2692:     lea     ($03E4,A4),A0
02:00039126 10302000        	  2693:     move.b  (A0,D2.W),D0
02:0003912A 610005BE        	  2694:     jsr     DrawObjectNotMirroredAndCheckLinkCollision
                            	  2695:     ; If the boulder's Y < $F0, return.
                            	  2696:     ;
02:0003912E 41EC0084        	  2697:     lea     ($0084,A4),A0
02:00039132 10302000        	  2698:     move.b  (A0,D2.W),D0
02:00039136 0C0000F0        	  2699:     cmpi.b  #$F0,D0
02:0003913A 6402            	  2700:     bcc.s  __far_z_04_0024
02:0003913C 6032            	  2701:     jmp  L10A10_Exit
                            	  2702: __far_z_04_0024:
                            	  2703:     ; Else the boulder is close enough to the bottom of the screen
                            	  2704:     ; to destroy it.
                            	  2705:     ;
02:0003913E 532C0515        	  2706:     subq.b  #1,($0515,A4)
02:00039142 4EF90004B758    	  2707:     jmp     DestroyMonster
                            	  2708: 
                            	  2709: ; Returns:
                            	  2710: ; Y: 0: blue tektite
                            	  2711: ;    1: red tektite
                            	  2712: ;    2: boulder
                            	  2713: ;
                            	  2714:     even
                            	  2715: Jumper_GetKind:
02:00039148 41EC034F        	  2716:     lea     ($034F,A4),A0
02:0003914C 10302000        	  2717:     move.b  (A0,D2.W),D0
02:00039150 003C0011        	  2718:     ori     #$11,CCR  ; SEC: set C+X
02:00039154 123C000D        	  2719:     move.b  #$0D,D1
02:00039158 0A3C0010        	  2720:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003915C 9101            	  2721:     subx.b  D1,D0   ; SBC #$0D
02:0003915E 0A3C0010        	  2722:     eori    #$10,CCR  ; restore X = 6502 C
02:00039162 7600            	  2723:     moveq   #0,D3
02:00039164 1600            	  2724:     move.b  D0,D3
02:00039166 0C030002        	  2725:     cmpi.b  #$02,D3
02:0003916A 6402            	  2726:     bcc.s  __far_z_04_0025
02:0003916C 6002            	  2727:     jmp  L10A10_Exit
                            	  2728: __far_z_04_0025:
02:0003916E 7602            	  2729:     moveq   #2,D3
                            	  2730:     even
                            	  2731: L10A10_Exit:
02:00039170 4E75            	  2732:     rts
                            	  2733: 
                            	  2734:     even
                            	  2735: Jumper_PointBoulderDownward:
02:00039172 4EF90002BABA    	  2736:     jmp     c_jumper_point_boulder_downward
                            	  2737: 
                            	  2738: Jumper_MoveY:
02:00039178 1880            	  2739:     move.b  D0,($0000,A4)
02:0003917A 19430002        	  2740:     move.b  D3,($0002,A4)
                            	  2741:     ; Add the high speed byte to the Y coordinate.
                            	  2742:     ;
02:0003917E 41EC0412        	  2743:     lea     ($0412,A4),A0
02:00039182 10302000        	  2744:     move.b  (A0,D2.W),D0
02:00039186 41EC0084        	  2745:     lea     ($0084,A4),A0
02:0003918A 12302000        	  2746:     move.b  (A0,D2.W),D1
02:0003918E D101            	  2747:     addx.b  D1,D0   ; ADC ObjY,X
02:00039190 41EC0084        	  2748:     lea     ($0084,A4),A0
02:00039194 11802000        	  2749:     move.b  D0,(A0,D2.W)
                            	  2750:     ; Add the acceleration to the speed fraction (low byte).
                            	  2751:     ;
02:00039198 41EC041F        	  2752:     lea     ($041F,A4),A0
02:0003919C 10302000        	  2753:     move.b  (A0,D2.W),D0
02:000391A0 023C00EE        	  2754:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391A4 1214            	  2755:     move.b  ($0000,A4),D1
02:000391A6 D101            	  2756:     addx.b  D1,D0   ; ADC $00
02:000391A8 41EC041F        	  2757:     lea     ($041F,A4),A0
02:000391AC 11802000        	  2758:     move.b  D0,(A0,D2.W)
                            	  2759:     ; Carry over to the high speed byte.
                            	  2760:     ;
02:000391B0 41EC0412        	  2761:     lea     ($0412,A4),A0
02:000391B4 10302000        	  2762:     move.b  (A0,D2.W),D0
02:000391B8 123C0000        	  2763:     move.b  #$00,D1
02:000391BC D101            	  2764:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000391BE 41EC0412        	  2765:     lea     ($0412,A4),A0
02:000391C2 11802000        	  2766:     move.b  D0,(A0,D2.W)
                            	  2767:     ; *Signed comparison*:
                            	  2768:     ; If the high speed byte < high max speed byte, then return.
                            	  2769:     ;
                            	  2770:     ; Note that this is not a general purpose signed comparison,
                            	  2771:     ; which would be more complicated. But it works because
                            	  2772:     ; the deviation from 0 of both values is small.
                            	  2773:     ;
02:000391C6 122C0002        	  2774:     move.b  ($0002,A4),D1
02:000391CA B001            	  2775:     cmp.b   D1,D0
02:000391CC 6A02            	  2776:     bpl.s  __far_z_04_0026
02:000391CE 6022            	  2777:     jmp  L10A52_Exit
                            	  2778: __far_z_04_0026:
                            	  2779:     ; Limit the speed to the max speed.
                            	  2780:     ;
02:000391D0 41EC041F        	  2781:     lea     ($041F,A4),A0
02:000391D4 10302000        	  2782:     move.b  (A0,D2.W),D0
