                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:000350C0 761F            	  5138:     moveq   #31,D3
02:000350C2 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:000350C4 41EC0305        	  5141:     lea     ($0305,A4),A0
02:000350C8 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:000350CC 5303            	  5143:     subq.b  #1,D3
02:000350CE 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:000350D0 102C050A        	  5147:     move.b  ($050A,A4),D0
02:000350D4 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5150:     ; Rows 2 to $2D get side walls.
                            	  5151:     ;
02:000350D6 0C000001        	  5152:     cmpi.b  #$01,D0
02:000350DA 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:000350DC 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:000350E0 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:000350E2 661E            	  5156:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5157:     even
                            	  5158: _L_z02_DrawCredits_WriteHorizontalWalls:
02:000350E4 7619            	  5159:     moveq   #25,D3
02:000350E6 103C00FA        	  5160:     move.b  #$FA,D0
                            	  5161: _anon_z02_42:
02:000350EA 41EC0308        	  5162:     lea     ($0308,A4),A0
02:000350EE 11803000        	  5163:     move.b  D0,(A0,D3.W)
02:000350F2 5303            	  5164:     subq.b  #1,D3
02:000350F4 6AF4            	  5165:     bpl  _anon_z02_42
                            	  5166:     even
                            	  5167: _L_z02_DrawCredits_WriteSideWalls:
02:000350F6 103C00FA        	  5168:     move.b  #$FA,D0
02:000350FA 19400308        	  5169:     move.b  D0,($0308,A4)
02:000350FE 19400321        	  5170:     move.b  D0,($0321,A4)
                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00035102 103C00FF        	  5176:     move.b  #$FF,D0
02:00035106 19400325        	  5177:     move.b  D0,($0325,A4)
02:0003510A 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:0003510E 7020            	  5181:     moveq   #32,D0
02:00035110 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:00035114 7400            	  5185:     moveq   #0,D2
02:00035116 142C050C        	  5186:     move.b  ($050C,A4),D2
02:0003511A 41F900034EC0    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00035120 10302000        	  5188:     move.b  (A0,D2.W),D0
02:00035124 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:00035128 102C050D        	  5192:     move.b  ($050D,A4),D0
02:0003512C 7600            	  5193:     moveq   #0,D3
02:0003512E 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00035130 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00035132 E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:00035134 E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:00035136 E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:00035138 E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:0003513A 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:0003513E 41F900034ECC    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:00035144 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:00035148 E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:0003514A 5303            	  5212:     subq.b  #1,D3
02:0003514C 6AFA            	  5213:     bpl  _anon_z02_43
02:0003514E 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:00035152 7600            	  5218:     moveq   #0,D3
02:00035154 162C050E        	  5219:     move.b  ($050E,A4),D3
02:00035158 0C030017        	  5220:     cmpi.b  #$17,D3
02:0003515C 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:00035160 7400            	  5224:     moveq   #0,D2
02:00035162 142C0016        	  5225:     move.b  ($0016,A4),D2
02:00035166 41EC062D        	  5226:     lea     ($062D,A4),A0
02:0003516A 10302000        	  5227:     move.b  (A0,D2.W),D0
02:0003516E 6608            	  5228:     bne  _anon_z02_44
02:00035170 0C030010        	  5229:     cmpi.b  #$10,D3
02:00035174 64000114        	  5230:     bcc  _L_z02_DrawCredits_IncLine
                            	  5231: _anon_z02_44:
02:00035178 7400            	  5232:     moveq   #0,D2
02:0003517A 142C0016        	  5233:     move.b  ($0016,A4),D2
02:0003517E 41EC062D        	  5234:     lea     ($062D,A4),A0
02:00035182 10302000        	  5235:     move.b  (A0,D2.W),D0
                            	  5236:     ; In the second quest, skip lines $C to $F.
                            	  5237:     ;
02:00035186 670E            	  5238:     beq  _anon_z02_45
02:00035188 0C03000C        	  5239:     cmpi.b  #$0C,D3
02:0003518C 6508            	  5240:     bcs  _anon_z02_45
02:0003518E 0C030010        	  5241:     cmpi.b  #$10,D3
02:00035192 650000F6        	  5242:     bcs  _L_z02_DrawCredits_IncLine
                            	  5243: _anon_z02_45:
02:00035196 41F900034ED8    	  5244:     lea     (CreditsTextAddrsLo).l,A0
02:0003519C 10303000        	  5245:     move.b  (A0,D3.W),D0
02:000351A0 1880            	  5246:     move.b  D0,($0000,A4)
02:000351A2 41F900034EF0    	  5247:     lea     (CreditsTextAddrsHi).l,A0
02:000351A8 10303000        	  5248:     move.b  (A0,D3.W),D0
02:000351AC 19400001        	  5249:     move.b  D0,($0001,A4)
                            	  5250:     ; First read the length of the string.
                            	  5251:     ;
02:000351B0 7600            	  5252:     moveq   #0,D3
02:000351B2 1214            	  5253:     move.b  ($00,A4),D1   ; ptr lo
02:000351B4 182C0001        	  5254:     move.b  ($01,A4),D4  ; ptr hi
02:000351B8 024100FF        	  5255:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000351BC E14C            	  5256:     lsl.w   #8,D4
02:000351BE 8841            	  5257:     or.w    D1,D4             ; D4 = NES ptr addr
02:000351C0 48C4            	  5258:     ext.l   D4
02:000351C2 D8BC00FF0000    	  5259:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000351C8 2044            	  5260:     movea.l D4,A0
02:000351CA 10303000        	  5261:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000351CE 19400002        	  5262:     move.b  D0,($0002,A4)
                            	  5263:     ; Second, read the offset where the first character goes
                            	  5264:     ; in the line.
                            	  5265:     ;
02:000351D2 5203            	  5266:     addq.b  #1,D3
02:000351D4 1214            	  5267:     move.b  ($00,A4),D1   ; ptr lo
02:000351D6 182C0001        	  5268:     move.b  ($01,A4),D4  ; ptr hi
02:000351DA 024100FF        	  5269:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000351DE E14C            	  5270:     lsl.w   #8,D4
02:000351E0 8841            	  5271:     or.w    D1,D4             ; D4 = NES ptr addr
02:000351E2 48C4            	  5272:     ext.l   D4
02:000351E4 D8BC00FF0000    	  5273:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000351EA 2044            	  5274:     movea.l D4,A0
02:000351EC 10303000        	  5275:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000351F0 7400            	  5276:     moveq   #0,D2
02:000351F2 1400            	  5277:     move.b  D0,D2
                            	  5278:     ; Loop over each character in the rest of the credits source record.
                            	  5279:     ;
