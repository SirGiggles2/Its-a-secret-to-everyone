                            	  6689:     even
                            	  6690: UpdateDodongoState1_Bloated_JumpTable:
02:0003AE56 0003AE6A        	  6691:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AE5A 0003AE6A        	  6692:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AE5E 0003AE6A        	  6693:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003AE62 0003AF02        	  6694:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
