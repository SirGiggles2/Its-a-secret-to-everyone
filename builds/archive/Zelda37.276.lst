                            	  6757: __far_z_04_0060:
                            	  6758:     ; New bloated substate >= 2.
                            	  6759:     ;
                            	  6760:     ; If bomb hits < 2, then set bloated substate 4,
                            	  6761:     ; which will transition to state 0 (moving).
                            	  6762:     ;
                            	  6763:     ; Note that if the bomb hits >= 2, then:
                            	  6764:     ; - If new substate = 2, then substate 2 will wait,
                            	  6765:     ;   and then transition to substate 3.
                            	  6766:     ; - If new substate = 3, then the next frame the monster will die.
                            	  6767:     ;
02:0003AEE0 7600            	  6768:     moveq   #0,D3
02:0003AEE2 41EC0437        	  6769:     lea     ($0437,A4),A0
02:0003AEE6 16302000        	  6770:     move.b  (A0,D2.W),D3
