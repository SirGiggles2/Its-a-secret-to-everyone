02:0002BFA8 08000008        	  2465:     btst    #8,D0
02:0002BFAC 670A            	  2466:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2467:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2468:     eori    #$01,CCR
02:0002BFB6 4E75            	  2469:     rts
                            	  2470: .cc_cnras:
02:0002BFB8 023C00FE        	  2471:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2472:     eori    #$01,CCR
02:0002BFC0 4E75            	  2473:     rts
