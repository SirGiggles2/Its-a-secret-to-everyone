02:0004A190 102C0015        	  4879:     move.b  ($0015,A4),D0
02:0004A194 02000003        	  4880:     andi.b #$03,D0
02:0004A198 41F90004A454    	  4881:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004A19E 12303000        	  4882:     move.b  (A0,D3.W),D1
02:0004A1A2 8001            	  4883:     or.b  D1,D0
02:0004A1A4 4EB900030B24    	  4884:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4885:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4886:     ;
02:0004A1AA 41F90004A450    	  4887:     lea     (RDirectionToWeaponFrame).l,A0
02:0004A1B0 10303000        	  4888:     move.b  (A0,D3.W),D0
02:0004A1B4 1940000C        	  4889:     move.b  D0,($000C,A4)
                            	  4890:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4891:     ;
02:0004A1B8 0C030002        	  4892:     cmpi.b  #$02,D3
02:0004A1BC 6604            	  4893:     bne  _anon_z07_24
02:0004A1BE 522C000F        	  4894:     addq.b  #1,($000F,A4)
                            	  4895: _anon_z07_24:
                            	  4896:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4897:     ;   $57 (sword shot) => $22
                            	  4898:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4899:     ;
02:0004A1C2 7622            	  4900:     moveq   #34,D3
02:0004A1C4 0C02000D        	  4901:     cmpi.b  #$0D,D2
02:0004A1C8 6410            	  4902:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004A1CA 41EC034F        	  4903:     lea     ($034F,A4),A0
02:0004A1CE 10302000        	  4904:     move.b  (A0,D2.W),D0
02:0004A1D2 0C000057        	  4905:     cmpi.b  #$57,D0
02:0004A1D6 6710            	  4906:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
