02:0003840C 12303000        	   777:     move.b  (A0,D3.W),D1
02:00038410 B001            	   778:     cmp.b   D1,D0
02:00038412 6702            	   779:     beq.s  __far_z_04_0008
02:00038414 6046            	   780:     jmp  ResetPushTimer
