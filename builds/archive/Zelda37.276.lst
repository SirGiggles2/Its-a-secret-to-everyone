02:0003AC50 00000070        	  6409:     ori.b #$70,D0
02:0003AC54 19802028        	  6410:     move.b  D0,($28,A4,D2.W)
                            	  6411:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  6412:     ;
