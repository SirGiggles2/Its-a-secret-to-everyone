                            	   814: TransferDemoPatterns:
02:0002EFCC 4EB900048BCC    	   815:     jsr     TurnOffAllVideo
02:0002EFD2 4EB90000E034    	   816:     jsr     _ppu_read_2  ; PPU $2002 read → D0
                            	   817:     even
                            	   818: _L_z01_TransferDemoPatterns_LoopBlock:
                            	   819:     ; Loop over each block.
                            	   820:     ;
02:0002EFD8 102C051D        	   821:     move.b  ($051D,A4),D0
02:0002EFDC E308            	   822:     lsl.b  #1,D0   ; ASL A
02:0002EFDE 7400            	   823:     moveq   #0,D2
02:0002EFE0 1400            	   824:     move.b  D0,D2
                            	   825:     ; Put block address in [00:01] and size in [03:02].
                            	   826:     ; Load destination VRAM address and set it.
                            	   827:     ; The size and VRAM address have the high byte first.
                            	   828:     ;
02:0002EFE2 41F90002EFBC    	   829:     lea     (DemoPatternBlockAddrs).l,A0
02:0002EFE8 3A02            	   830:     move.w  D2,D5
02:0002EFEA DA45            	   831:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0002EFEC 2A305000        	   832:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002EFF0 29450004        	   833:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002EFF4 41F90002EFC4    	   834:     lea     (DemoPatternBlockSizes).l,A0
02:0002EFFA 10302000        	   835:     move.b  (A0,D2.W),D0
02:0002EFFE 19400002        	   836:     move.b  D0,($0002,A4)
02:0002F002 41F90002EFC8    	   837:     lea     (DemoPatternVramAddrs).l,A0
02:0002F008 10302000        	   838:     move.b  (A0,D2.W),D0
02:0002F00C 4EB90000E32C    	   839:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0002F012 5202            	   840:     addq.b  #1,D2
                            	   841:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:0002F014 41F90002EFC4    	   842:     lea     (DemoPatternBlockSizes).l,A0
02:0002F01A 10302000        	   843:     move.b  (A0,D2.W),D0
02:0002F01E 19400003        	   844:     move.b  D0,($0003,A4)
02:0002F022 41F90002EFC8    	   845:     lea     (DemoPatternVramAddrs).l,A0
02:0002F028 10302000        	   846:     move.b  (A0,D2.W),D0
02:0002F02C 611E            	   847:     jsr     TransferPatternBlock_Bank1
                            	   848:     ; Loop until pattern block index = 2.
                            	   849:     ;
02:0002F02E 102C051D        	   850:     move.b  ($051D,A4),D0
02:0002F032 0C000002        	   851:     cmpi.b  #$02,D0
02:0002F036 66A0            	   852:     bne  _L_z01_TransferDemoPatterns_LoopBlock
02:0002F038 103C00A5        	   853:     move.b  #$A5,D0
02:0002F03C 194000F6        	   854:     move.b  D0,($00F6,A4)
02:0002F040 7000            	   855:     moveq   #0,D0
02:0002F042 1940051D        	   856:     move.b  D0,($051D,A4)
02:0002F046 0A3C0001        	   857:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002F04A 4E75            	   858:     rts
                            	   859: 
                            	   860: ; Params:
                            	   861: ; [00:01]: source address
                            	   862: ; [03:02]: size
                            	   863: ; A: low byte of desination VRAM address
                            	   864: ;
                            	   865:     even
                            	   866: TransferPatternBlock_Bank1:
                            	   867:     ; PATCHED: fast bulk CHR transfer (bypasses per-byte _ppu_write_7)
