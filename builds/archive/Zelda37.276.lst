                            	  9544: _L_z04_UpdateGohma_AnimateEye:
                            	  9545:     ; Animate the eye.
                            	  9546:     ;
                            	  9547:     ; First, if the counter for when to open the eye next = 0, then
                            	  9548:     ; set it to a random value at least $C0; and set the timer for
                            	  9549:     ; keeping the eye open to $80.
                            	  9550:     ;
                            	  9551:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9552:     ; every other frame.
                            	  9553:     ;
02:0003C368 41EC042C        	  9554:     lea     ($042C,A4),A0
02:0003C36C 10302000        	  9555:     move.b  (A0,D2.W),D0
02:0003C370 661E            	  9556:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003C372 103C0080        	  9557:     move.b  #$80,D0
02:0003C376 41EC0444        	  9558:     lea     ($0444,A4),A0
02:0003C37A 11802000        	  9559:     move.b  D0,(A0,D2.W)
02:0003C37E 103C00C0        	  9560:     move.b  #$C0,D0
02:0003C382 12342018        	  9561:     move.b  ($18,A4,D2.W),D1
02:0003C386 8001            	  9562:     or.b  D1,D0
02:0003C388 41EC042C        	  9563:     lea     ($042C,A4),A0
02:0003C38C 11802000        	  9564:     move.b  D0,(A0,D2.W)
                            	  9565:     even
                            	  9566: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9567:     ; Decrement the next-open-eye counter.
                            	  9568:     ;
02:0003C390 102C0015        	  9569:     move.b  ($0015,A4),D0
02:0003C394 E208            	  9570:     lsr.b  #1,D0   ; LSR A
02:0003C396 6408            	  9571:     bcc  _anon_z04_122
02:0003C398 41EC042C        	  9572:     lea     ($042C,A4),A0
02:0003C39C 53302000        	  9573:     subq.b  #1,(A0,D2.W)
                            	  9574: _anon_z04_122:
                            	  9575:     ; If open eye timer = 0, then the eye is closed.
                            	  9576:     ; Go animate it differently.
                            	  9577:     ;
02:0003C3A0 41EC0444        	  9578:     lea     ($0444,A4),A0
02:0003C3A4 10302000        	  9579:     move.b  (A0,D2.W),D0
02:0003C3A8 674A            	  9580:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9581:     ; Else decrement the open eye timer.
                            	  9582:     ;
02:0003C3AA 41EC0444        	  9583:     lea     ($0444,A4),A0
02:0003C3AE 53302000        	  9584:     subq.b  #1,(A0,D2.W)
                            	  9585:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9586:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9587:     ;
02:0003C3B2 7602            	  9588:     moveq   #2,D3
02:0003C3B4 0C000070        	  9589:     cmpi.b  #$70,D0
02:0003C3B8 6408            	  9590:     bcc  _anon_z04_123
02:0003C3BA 0C000010        	  9591:     cmpi.b  #$10,D0
02:0003C3BE 6502            	  9592:     bcs  _anon_z04_123
02:0003C3C0 5203            	  9593:     addq.b  #1,D3
