02:00042FB8 0C030085        	  7995:     cmpi.b  #$85,D3
02:00042FBC 6642            	  7996:     bne  _anon_z05_177
02:00042FBE 102C0098        	  7997:     move.b  ($0098,A4),D0
02:00042FC2 02000004        	  7998:     andi.b #$04,D0
