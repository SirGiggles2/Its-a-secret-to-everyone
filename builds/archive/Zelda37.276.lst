02:0003D65A 6702            	 12106:     beq.s  __far_z_04_0117
02:0003D65C 6012            	 12107:     jmp  Ganon_DrawBodyFrame0
                            	 12108: __far_z_04_0117:
                            	 12109:     ; Once the timer expires:
                            	 12110:     ; 1. unhalt Link
                            	 12111:     ; 2. clear the item to lift
                            	 12112:     ; 3. play level 9 song
                            	 12113:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12114:     ;
02:0003D65E 194000AC        	 12115:     move.b  D0,($00AC,A4)
02:0003D662 19400505        	 12116:     move.b  D0,($0505,A4)
02:0003D666 7020            	 12117:     moveq   #32,D0
02:0003D668 19400600        	 12118:     move.b  D0,($0600,A4)
02:0003D66C 522C0445        	 12119:     addq.b  #1,($0445,A4)
                            	 12120:     even
                            	 12121: Ganon_DrawBodyFrame0:
                            	 12122:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12123:     ; with animation frame 0.
                            	 12124:     ;
02:0003D670 7000            	 12125:     moveq   #0,D0
02:0003D672 41EC046B        	 12126:     lea     ($046B,A4),A0
02:0003D676 11802000        	 12127:     move.b  D0,(A0,D2.W)
02:0003D67A 600002EC        	 12128:     jmp     Ganon_DrawBody
                            	 12129: 
                            	 12130: ; Description:
                            	 12131: ; Fighting Ganon.
                            	 12132: ;
                            	 12133: ; If Ganon is dying, go handle it.
                            	 12134: ;
                            	 12135:     even
                            	 12136: Ganon_ScenePhase2:
02:0003D67E 41EC042C        	 12137:     lea     ($042C,A4),A0
