02:0004A64E 7002            	  5579:     moveq   #2,D0
02:0004A650 1940000C        	  5580:     move.b  D0,($000C,A4)
02:0004A654 7000            	  5581:     moveq   #0,D0
02:0004A656 1940000F        	  5582:     move.b  D0,($000F,A4)
                            	  5583:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5584:     ; and go draw.
                            	  5585:     ;
02:0004A65A 41EC0098        	  5586:     lea     ($0098,A4),A0
