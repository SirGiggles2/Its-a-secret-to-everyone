                            	  2436: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2437:     ; Set state 1 to jump.
                            	  2438:     ;
02:00038F44 41EC00AC        	  2439:     lea     ($00AC,A4),A0
