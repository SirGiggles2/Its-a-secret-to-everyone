                            	  3465: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:000396E6 102C000D        	  3466:     move.b  ($000D,A4),D0
                            	  3467: ; Params:
                            	  3468: ; A: frame image
                            	  3469: ; X: object index
                            	  3470: ; [00]: object X
                            	  3471: ; [01]: object Y
                            	  3472: ; [0F]: flip horizontally
