                            	 11825: __far_z_04_0114:
                            	 11826:     ; State = 0.
                            	 11827:     ;
                            	 11828:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11829:     ; This is the only patra child shown in the first fame.
                            	 11830:     ;
02:0003D46E 0C020002        	 11831:     cmpi.b  #$02,D2
02:0003D472 6732            	 11832:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11833:     ; The patra child in slot 2 is the last one to be updated.
                            	 11834:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11835:     ;
                            	 11836:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11837:     ; shown.
                            	 11838:     ;
02:0003D474 102C00AE        	 11839:     move.b  ($00AE,A4),D0
02:0003D478 6700008E        	 11840:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11841:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11842:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11843:     ;
02:0003D47C 1002            	 11844:     move.b  D2,D0
                            	 11845:     ; Subtract 3 from the object slot to get the angle where the
                            	 11846:     ; patra child in object slot 2 should be for the current one to appear.
                            	 11847:     ;
02:0003D47E 003C0011        	 11848:     ori     #$11,CCR  ; SEC: set C+X
02:0003D482 123C0003        	 11849:     move.b  #$03,D1
02:0003D486 0A3C0010        	 11850:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D48A 9101            	 11851:     subx.b  D1,D0   ; SBC #$03
02:0003D48C 0A3C0010        	 11852:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D490 7600            	 11853:     moveq   #0,D3
02:0003D492 1600            	 11854:     move.b  D0,D3
                            	 11855:     ; If the patra child in slot 2 has not reached the required angle,
                            	 11856:     ; then return.
                            	 11857:     ;
02:0003D494 102C0396        	 11858:     move.b  ($0396,A4),D0
02:0003D498 41F90003D452    	 11859:     lea     (PatraChildStartAngles).l,A0
02:0003D49E 12303000        	 11860:     move.b  (A0,D3.W),D1
02:0003D4A2 B001            	 11861:     cmp.b   D1,D0
02:0003D4A4 6662            	 11862:     bne  _L_z04_UpdatePatraChild_Exit
                            	 11863:     even
