02:000393AC 0C0000C0        	  3021:     cmpi.b  #$C0,D0
02:000393B0 6506            	  3022:     bcs  _anon_z04_43
02:000393B2 4EB900049E6E    	  3023:     jsr     ReverseObjDir
                            	  3024: _anon_z04_43:
                            	  3025:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3026:     ;
02:000393B8 41EC0098        	  3027:     lea     ($0098,A4),A0
02:000393BC 10302000        	  3028:     move.b  (A0,D2.W),D0
02:000393C0 0200000C        	  3029:     andi.b #$0C,D0
02:000393C4 6742            	  3030:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3031:     ; Begin with the leever's X set to Link's X.
                            	  3032:     ;
