                            	  1691: _L_z04_UpdateStatues_Shoot:
                            	  1692:     ; Look for an empty monster slot.
                            	  1693:     ; If none is found, return.
                            	  1694:     ;
                            	  1695:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1696:     ; object. This routine takes a shooter object, and instantiates
                            	  1697:     ; a fireball object at the shooter's location.
                            	  1698:     ;
                            	  1699:     ; The object slot we set up here will behave as the shooter.
                            	  1700:     ; For each fireball index, this object slot will have its coordinates
                            	  1701:     ; changed.
                            	  1702:     ;
                            	  1703:     ; Note that this means that:
                            	  1704:     ; 1. The first fireball made will be its own shooter.
                            	  1705:     ;    Practically, there's nothing special about this.
                            	  1706:     ; 2. If there is more than one fireball made in a frame,
                            	  1707:     ;    then two of them will come from the same statue.
                            	  1708:     ;
                            	  1709:     ;
                            	  1710:     ; Save the fireball pattern.
02:00038A88 1003            	  1711:     move.b  D3,D0
02:00038A8A 1B00            	  1712:     move.b  D0,-(A5)  ; PHA
02:00038A8C 4EB90004B764    	  1713:     jsr     FindEmptyMonsterSlot
02:00038A92 0C000001        	  1714:     cmpi.b  #$01,D0
02:00038A96 101D            	  1715:     move.b  (A5)+,D0  ; PLA
02:00038A98 6400010A        	  1716:     bcc  _L_z04_UpdateStatues_Exit
                            	  1717:     ; If we found a slot, but it < 6, return.
                            	  1718:     ;
02:00038A9C 0C030006        	  1719:     cmpi.b  #$06,D3
02:00038AA0 65000102        	  1720:     bcs  _L_z04_UpdateStatues_Exit
                            	  1721:     ; Store the object slot in [0A].
                            	  1722:     ; Store fireball pattern in [0B].
                            	  1723:     ;
02:00038AA4 1943000A        	  1724:     move.b  D3,($000A,A4)
02:00038AA8 1940000B        	  1725:     move.b  D0,($000B,A4)
                            	  1726:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1727:     ;
02:00038AAC 7600            	  1728:     moveq   #0,D3
02:00038AAE 1600            	  1729:     move.b  D0,D3
02:00038AB0 7400            	  1730:     moveq   #0,D2
02:00038AB2 41F900038A44    	  1731:     lea     (StatueFireballCounts).l,A0
02:00038AB8 14303000        	  1732:     move.b  (A0,D3.W),D2
                            	  1733:     even
                            	  1734: _L_z04_UpdateStatues_LoopFireball:
                            	  1735:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1736:     ;
                            	  1737:     ; Decrement the fireball timer at this index.
                            	  1738:     ;
02:00038ABC 7600            	  1739:     moveq   #0,D3
02:00038ABE 41EC04E8        	  1740:     lea     ($04E8,A4),A0
02:00038AC2 16302000        	  1741:     move.b  (A0,D2.W),D3
02:00038AC6 5303            	  1742:     subq.b  #1,D3
02:00038AC8 1003            	  1743:     move.b  D3,D0
02:00038ACA 41EC04E8        	  1744:     lea     ($04E8,A4),A0
02:00038ACE 11802000        	  1745:     move.b  D0,(A0,D2.W)
                            	  1746:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1747:     ; to make a fireball. Go loop again.
                            	  1748:     ;
02:00038AD2 5203            	  1749:     addq.b  #1,D3
02:00038AD4 660000C8        	  1750:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1751:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1752:     ; This fireball index will wait another $100 frames.
                            	  1753:     ;
02:00038AD8 10342018        	  1754:     move.b  ($18,A4,D2.W),D0
02:00038ADC 0C0000F0        	  1755:     cmpi.b  #$F0,D0
02:00038AE0 640000BC        	  1756:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1757:     ; Else choose one of four start times for the fireball based on
                            	  1758:     ; the random value.
                            	  1759:     ;
02:00038AE4 02000003        	  1760:     andi.b #$03,D0
02:00038AE8 7600            	  1761:     moveq   #0,D3
02:00038AEA 1600            	  1762:     move.b  D0,D3
02:00038AEC 41F900038A48    	  1763:     lea     (StatueFireballStartTimes).l,A0
02:00038AF2 10303000        	  1764:     move.b  (A0,D3.W),D0
02:00038AF6 41EC04E8        	  1765:     lea     ($04E8,A4),A0
02:00038AFA 11802000        	  1766:     move.b  D0,(A0,D2.W)
                            	  1767:     ; The coordinate lists are divided into sets for each pattern.
                            	  1768:     ;
                            	  1769:     ; Look up the index of the base of the set for the pattern in use.
                            	  1770:     ; Add it to the fireball index in X register to get the index of
                            	  1771:     ; the coordinate we want within each coordinate list.
                            	  1772:     ;
                            	  1773:     ;
                            	  1774:     ; Pattern
02:00038AFE 7600            	  1775:     moveq   #0,D3
02:00038B00 162C000B        	  1776:     move.b  ($000B,A4),D3
