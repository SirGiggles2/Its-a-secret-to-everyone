02:0003B5B2 41EC03E4        	  7721:     lea     ($03E4,A4),A0
02:0003B5B6 16302000        	  7722:     move.b  (A0,D2.W),D3
02:0003B5BA 5203            	  7723:     addq.b  #1,D3
02:0003B5BC 1003            	  7724:     move.b  D3,D0
02:0003B5BE 02000003        	  7725:     andi.b #$03,D0
02:0003B5C2 41EC03E4        	  7726:     lea     ($03E4,A4),A0
02:0003B5C6 11802000        	  7727:     move.b  D0,(A0,D2.W)
