                            	  9624: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9625:     ; Here the eye is closed. So animate it this way.
                            	  9626:     ; Increment the animation counter, and if <> 8, then
                            	  9627:     ; go shoot, draw, and check collisions.
                            	  9628:     ;
02:0003C3F4 41EC0478        	  9629:     lea     ($0478,A4),A0
02:0003C3F8 52302000        	  9630:     addq.b  #1,(A0,D2.W)
02:0003C3FC 41EC0478        	  9631:     lea     ($0478,A4),A0
02:0003C400 10302000        	  9632:     move.b  (A0,D2.W),D0
02:0003C404 0C000008        	  9633:     cmpi.b  #$08,D0
02:0003C408 66C2            	  9634:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9635:     ; Roll over the eye animation counter to 0.
