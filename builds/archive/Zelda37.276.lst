                            	  9251: Manhandla_Move:
                            	  9252:     ; Implement a way of manifesting the fractional part of the speed
                            	  9253:     ; in the movement.
                            	  9254:     ;
                            	  9255:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9256:     ; byte to add to the coordinates, then the effective speed would
                            	  9257:     ; be 1 pixel a frame instead of 1.25.
                            	  9258:     ;
                            	  9259:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9260:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9261:     ;
                            	  9262:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9263:     ;
                            	  9264:     ;   SA := SA + (SL AND $E0)
                            	  9265:     ;   [03] := SH + carry
                            	  9266:     ;
                            	  9267:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9268:     ;
02:0003C100 41EC041F        	  9269:     lea     ($041F,A4),A0
02:0003C104 10302000        	  9270:     move.b  (A0,D2.W),D0
02:0003C108 020000E0        	  9271:     andi.b #$E0,D0
02:0003C10C 023C00EE        	  9272:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C110 41EC0412        	  9273:     lea     ($0412,A4),A0
02:0003C114 12302000        	  9274:     move.b  (A0,D2.W),D1
02:0003C118 D101            	  9275:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003C11A 41EC0412        	  9276:     lea     ($0412,A4),A0
02:0003C11E 11802000        	  9277:     move.b  D0,(A0,D2.W)
                            	  9278:     ; Assign (high speed byte + carry) to [03].
                            	  9279:     ;
02:0003C122 41EC042C        	  9280:     lea     ($042C,A4),A0
02:0003C126 10302000        	  9281:     move.b  (A0,D2.W),D0
02:0003C12A 123C0000        	  9282:     move.b  #$00,D1
02:0003C12E D101            	  9283:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C130 19400003        	  9284:     move.b  D0,($0003,A4)
                            	  9285:     ; Change coordinates by the speed amount/offset in [03]
                            	  9286:     ; according to the direction.
                            	  9287:     ;
                            	  9288:     ; Start with a mask of $A1 in [02]:
                            	  9289:     ; - low nibble represents the right direction
                            	  9290:     ; - high nibble is used to set or clear carry as we go along
                            	  9291:     ;
02:0003C134 103C00A1        	  9292:     move.b  #$A1,D0
02:0003C138 19400002        	  9293:     move.b  D0,($0002,A4)
                            	  9294:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9295:     ;
02:0003C13C 41EC0098        	  9296:     lea     ($0098,A4),A0
02:0003C140 10302000        	  9297:     move.b  (A0,D2.W),D0
02:0003C144 122C0002        	  9298:     move.b  ($0002,A4),D1
02:0003C148 C200            	  9299:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C14A 6712            	  9300:     beq  _L_z04_Manhandla_Move_Left
02:0003C14C 10342070        	  9301:     move.b  ($70,A4,D2.W),D0
02:0003C150 023C00EE        	  9302:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C154 122C0003        	  9303:     move.b  ($0003,A4),D1
02:0003C158 D101            	  9304:     addx.b  D1,D0   ; ADC $03
02:0003C15A 19802070        	  9305:     move.b  D0,($70,A4,D2.W)
                            	  9306:     even
                            	  9307: _L_z04_Manhandla_Move_Left:
                            	  9308:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9309:     ;
02:0003C15E 41EC0098        	  9310:     lea     ($0098,A4),A0
02:0003C162 10302000        	  9311:     move.b  (A0,D2.W),D0
02:0003C166 122C0002        	  9312:     move.b  ($0002,A4),D1
02:0003C16A E309            	  9313:     lsl.b  #1,D1   ; ASL $02
02:0003C16C 19410002        	  9314:     move.b  D1,($0002,A4)
02:0003C170 122C0002        	  9315:     move.b  ($0002,A4),D1
02:0003C174 C200            	  9316:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C176 6716            	  9317:     beq  _L_z04_Manhandla_Move_Down
02:0003C178 10342070        	  9318:     move.b  ($70,A4,D2.W),D0
02:0003C17C 122C0003        	  9319:     move.b  ($0003,A4),D1
02:0003C180 0A3C0010        	  9320:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C184 9101            	  9321:     subx.b  D1,D0   ; SBC $03
02:0003C186 0A3C0010        	  9322:     eori    #$10,CCR  ; restore X = 6502 C
