                            	  9184: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9185:     ; At this point, we have a hand that just died.
                            	  9186:     ;
                            	  9187:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9188:     ;
02:0003C0B4 7603            	  9189:     moveq   #3,D3
                            	  9190:     ; Count how many are allocated.
                            	  9191:     ; This includes the current dead one, and the other living ones.
                            	  9192:     ; Store the count in [00].
                            	  9193:     ;
02:0003C0B6 7000            	  9194:     moveq   #0,D0
02:0003C0B8 1880            	  9195:     move.b  D0,($0000,A4)
                            	  9196:     even
                            	  9197: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003C0BA 41EC0350        	  9198:     lea     ($0350,A4),A0
02:0003C0BE 10303000        	  9199:     move.b  (A0,D3.W),D0
02:0003C0C2 0C00003C        	  9200:     cmpi.b  #$3C,D0
02:0003C0C6 6602            	  9201:     bne  _anon_z04_113
02:0003C0C8 5214            	  9202:     addq.b  #1,($0000,A4)
                            	  9203: _anon_z04_113:
02:0003C0CA 5303            	  9204:     subq.b  #1,D3
