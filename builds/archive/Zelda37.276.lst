                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:0004A284 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004A288 10302000        	  5018:     move.b  (A0,D2.W),D0
02:0004A28C 19400002        	  5019:     move.b  D0,($0002,A4)
02:0004A290 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:0004A294 7000            	  5023:     moveq   #0,D0
02:0004A296 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:0004A29A 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:0004A29C 1003            	  5031:     move.b  D3,D0
02:0004A29E 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004A2A0 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004A2A4 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004A2A6 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004A2AA 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004A2AC 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004A2B0 02000003        	  5047:     andi.b #$03,D0
02:0004A2B4 41F90004A112    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004A2BA 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004A2BE 8001            	  5050:     or.b  D1,D0
02:0004A2C0 4EB900030B24    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004A2C6 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004A2CA 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A2CE 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004A2D2 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004A2D4 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004A2D6 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004A2DA B001            	  5064:     cmp.b   D1,D0
02:0004A2DC 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004A2DE 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004A2E2 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004A2E4 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004A2E8 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004A2EC 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A2F0 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004A2F2 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A2F6 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004A2F8 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004A2FC 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004A300 1214            	  5079:     move.b  ($0000,A4),D1
02:0004A302 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A306 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004A308 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004A30C 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004A310 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004A312 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004A316 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004A31A 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A31E 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004A322 D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004A324 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004A328 7600            	  5100:     moveq   #0,D3
02:0004A32A 162C0010        	  5101:     move.b  ($0010,A4),D3
02:0004A32E 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:0004A330 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004A334 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004A336 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004A33A 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:0004A33C 7002            	  5112:     moveq   #2,D0
02:0004A33E 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004A342 7623            	  5114:     moveq   #35,D3
02:0004A344 4EB900030A44    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:0004A34A 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004A34C 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004A350 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004A352 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004A356 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:0004A358 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:0004A35A 7600            	  5136:     moveq   #0,D3
02:0004A35C 1600            	  5137:     move.b  D0,D3
02:0004A35E 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004A362 6602            	  5139:     bne  _anon_z07_25
02:0004A364 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:0004A366 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:0004A36A 4600            	  5143:     eori.b #$FF,D0
02:0004A36C 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A370 123C0001        	  5145:     move.b  #$01,D1
02:0004A374 D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004A376 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:0004A37A 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:0004A37C 7600            	  5151:     moveq   #0,D3
02:0004A37E 1600            	  5152:     move.b  D0,D3
02:0004A380 5303            	  5153:     subq.b  #1,D3
02:0004A382 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:0004A386 41EC0098        	  5160:     lea     ($0098,A4),A0
02:0004A38A 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:0004A38E 41EC0098        	  5166:     lea     ($0098,A4),A0
02:0004A392 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004A396 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:0004A39A 6702            	  5169:     beq.s  __far_z_07_0077
02:0004A39C 6004            	  5170:     jmp  L1F49F_Exit
                            	  5171: __far_z_07_0077:
02:0004A39E 6000FED2        	  5172:     jmp     DeactivateLinkShot
