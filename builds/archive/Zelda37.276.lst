02:0003B380 610001F4        	  7467:     jsr     PolsVoice_IsSquareWalkable
02:0003B384 6452            	  7468:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7469:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7470:     ; then go change to state 1.
                            	  7471:     ;
02:0003B386 41EC041F        	  7472:     lea     ($041F,A4),A0
02:0003B38A 10302000        	  7473:     move.b  (A0,D2.W),D0
02:0003B38E 020000FC        	  7474:     andi.b #$FC,D0
02:0003B392 0C0000B0        	  7475:     cmpi.b  #$B0,D0
02:0003B396 6742            	  7476:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003B398 0C0000F4        	  7477:     cmpi.b  #$F4,D0
02:0003B39C 643C            	  7478:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7479:     ; Else blocked by something else.
                            	  7480:     ;
                            	  7481:     ; If facing horizontally, then go flip the direction, move, and draw.
