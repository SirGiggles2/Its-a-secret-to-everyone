                            	  2481:     ;
02:00038F7C 7600            	  2482:     moveq   #0,D3
02:00038F7E 41EC0098        	  2483:     lea     ($0098,A4),A0
02:00038F82 16302000        	  2484:     move.b  (A0,D2.W),D3
02:00038F86 41EC0084        	  2485:     lea     ($0084,A4),A0
02:00038F8A 10302000        	  2486:     move.b  (A0,D2.W),D0
02:00038F8E 023C00EE        	  2487:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038F92 41F900038EAA    	  2488:     lea     (JumperYOffsets).l,A0
02:00038F98 12303000        	  2489:     move.b  (A0,D3.W),D1
02:00038F9C D101            	  2490:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:00038F9E 41EC0444        	  2491:     lea     ($0444,A4),A0
02:00038FA2 11802000        	  2492:     move.b  D0,(A0,D2.W)
                            	  2493:     ; Set the starting speed, depending on the object type.
                            	  2494:     ;
02:00038FA6 610001A0        	  2495:     jsr     Jumper_GetKind
02:00038FAA 41F900038ED4    	  2496:     lea     (JumperStartSpeedsHi).l,A0
02:00038FB0 10303000        	  2497:     move.b  (A0,D3.W),D0
02:00038FB4 41EC0412        	  2498:     lea     ($0412,A4),A0
02:00038FB8 11802000        	  2499:     move.b  D0,(A0,D2.W)
                            	  2500:     ; Reset the vertical speed low byte.
                            	  2501:     ; Then go animate, draw, and check collisions.
                            	  2502:     ;
02:00038FBC 6100022E        	  2503:     jsr     Jumper_ResetVSpeedFrac
                            	  2504:     even
                            	  2505: _L_z04_UpdateTektiteOrBoulder_Animate:
