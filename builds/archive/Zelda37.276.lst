02:0004AD84 003C0011        	  6577:     ori     #$11,CCR  ; SEC: set C+X
02:0004AD88 41EC0084        	  6578:     lea     ($0084,A4),A0
02:0004AD8C 12302000        	  6579:     move.b  (A0,D2.W),D1
