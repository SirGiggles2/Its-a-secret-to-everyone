02:0003C648 8841            	  9940:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003C64A 48C4            	  9941:     ext.l   D4
02:0003C64C D8BC00FF0000    	  9942:     add.l   #NES_RAM,D4       ; → Genesis addr
