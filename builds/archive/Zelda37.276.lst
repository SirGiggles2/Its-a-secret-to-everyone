02:000393EC 1214            	  3050:     move.b  ($0000,A4),D1
02:000393EE D101            	  3051:     addx.b  D1,D0   ; ADC $00
                            	  3052:     ; Sanitize the Y coordinate:
                            	  3053:     ; (Y AND $F0) OR $D
                            	  3054:     ;
02:000393F0 020000F0        	  3055:     andi.b #$F0,D0
02:000393F4 0000000D        	  3056:     ori.b #$0D,D0
02:000393F8 41EC0084        	  3057:     lea     ($0084,A4),A0
02:000393FC 11802000        	  3058:     move.b  D0,(A0,D2.W)
                            	  3059:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3060:     ; go see if the tile is valid to come out of.
                            	  3061:     ;
                            	  3062:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3063:     ;
02:00039400 0C00005D        	  3064:     cmpi.b  #$5D,D0
02:00039404 647A            	  3065:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
