02:000403D2 12303000        	  4023:     move.b  (A0,D3.W),D1
02:000403D6 B001            	  4024:     cmp.b   D1,D0
02:000403D8 6622            	  4025:     bne  _anon_z05_95
02:000403DA 102C0001        	  4026:     move.b  ($0001,A4),D0
02:000403DE 41F9000403AA    	  4027:     lea     (DoorwayBoundsMinOver).l,A0
02:000403E4 12303000        	  4028:     move.b  (A0,D3.W),D1
02:000403E8 B001            	  4029:     cmp.b   D1,D0
02:000403EA 6510            	  4030:     bcs  _anon_z05_95
02:000403EC 41F9000403AE    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:000403F2 12303000        	  4032:     move.b  (A0,D3.W),D1
02:000403F6 B001            	  4033:     cmp.b   D1,D0
02:000403F8 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4035: _anon_z05_95:
02:000403FC 5303            	  4036:     subq.b  #1,D3
