02:0003D3D6 0C000025        	 11742:     cmpi.b  #$25,D0
02:0003D3DA 671A            	 11743:     beq  _L_z04_UpdatePatra_CheckLinkCollision
02:0003D3DC 0C000026        	 11744:     cmpi.b  #$26,D0
02:0003D3E0 6714            	 11745:     beq  _L_z04_UpdatePatra_CheckLinkCollision
02:0003D3E2 5303            	 11746:     subq.b  #1,D3
02:0003D3E4 66E8            	 11747:     bne  _L_z04_UpdatePatra_LoopChildren
                            	 11748:     ; If there are no children, then Link can harm Patra.
