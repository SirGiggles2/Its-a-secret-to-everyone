02:0004A78E 1600            	  5767:     move.b  D0,D3
02:0004A790 41F90004A446    	  5768:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004A796 10303000        	  5769:     move.b  (A0,D3.W),D0
02:0004A79A 4EB90003047A    	  5770:     jsr     SetBoomerangSpeed
02:0004A7A0 102C000B        	  5771:     move.b  ($000B,A4),D0
