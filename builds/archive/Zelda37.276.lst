                            	  2100: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2101:     ; We got here in one of three ways:
                            	  2102:     ;
                            	  2103:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2104:     ;    explicitly.
                            	  2105:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2106:     ;    held an offset that was added to base palette attribute
                            	  2107:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2108:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2109:     ;    held absolute attributes.
                            	  2110:     ;
                            	  2111:     ; At this point, A holds the final sprite attributes.
02:00048E54 7400            	  2112:     moveq   #0,D2
02:00048E56 1942000C        	  2113:     move.b  D2,($000C,A4)
02:00048E5A 740F            	  2114:     moveq   #15,D2
                            	  2115:     ; Write sprites.
                            	  2116:     ; A holds the calculated sprite attributes.
                            	  2117:     ; Y holds the item slot.
02:00048E5C 4EF900030A36    	  2118:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2119: 
                            	  2120:     even
                            	  2121: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2122:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2123:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2124:     ; which here represents an offset from the palette row.
                            	  2125:     ;
02:00048E62 023C00EE        	  2126:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E66 122C0004        	  2127:     move.b  ($0004,A4),D1
02:00048E6A D101            	  2128:     addx.b  D1,D0   ; ADC $04
02:00048E6C 4A02            	  2129:     cmpi.b  #$00,D2
02:00048E6E 66E4            	  2130:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00048E70 0C000002        	  2131:     cmpi.b  #$02,D0
02:00048E74 66DE            	  2132:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00048E76 7620            	  2133:     moveq   #32,D3
02:00048E78 60DA            	  2134:     jmp     _L_z07_DrawItemBySlot_WriteSprites
