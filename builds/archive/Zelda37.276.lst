                            	  4946: _anon_z04_70:
                            	  4947:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  4948:     ; 1. negate the distance
                            	  4949:     ; 2. add 8 to the instruction offset to access
                            	  4950:     ;    the opposite direction for the same wall
                            	  4951:     ;
02:0003A142 7600            	  4952:     moveq   #0,D3
02:0003A144 162C0098        	  4953:     move.b  ($0098,A4),D3
02:0003A148 122C0002        	  4954:     move.b  ($0002,A4),D1
02:0003A14C B601            	  4955:     cmp.b   D1,D3
02:0003A14E 662A            	  4956:     bne  _anon_z04_71
