                            	  7926: HaveInput:
                            	  7927:     ; There were input directions.
                            	  7928:     ;
                            	  7929:     ; If there was only one input direction, go set object direction
                            	  7930:     ; to input direction, and set Link's speed.
                            	  7931:     ;
                            	  7932:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7933:     ; (X is still 0, because it's Link's object index).
                            	  7934:     ;
02:00042F6A 102C000F        	  7935:     move.b  ($000F,A4),D0
02:00042F6E 0C030001        	  7936:     cmpi.b  #$01,D3
02:00042F72 670000B6        	  7937:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7938:     ; There were more than one input directions.
                            	  7939:     ;
                            	  7940:     ; If none were walkable, go set input direction to 0, and return.
                            	  7941:     ;
02:00042F76 102C000C        	  7942:     move.b  ($000C,A4),D0
02:00042F7A 6604            	  7943:     bne  _anon_z05_174
02:00042F7C 60000128        	  7944:     jmp     SetLinkInputDir
                            	  7945: 
                            	  7946: _anon_z05_174:
                            	  7947:     ; Two input directions, and at least one of them is walkable.
                            	  7948:     ;
                            	  7949:     ; Make Link go straight in one direction on the next grid line.
                            	  7950:     ;
02:00042F80 7600            	  7951:     moveq   #0,D3
02:00042F82 1600            	  7952:     move.b  D0,D3
02:00042F84 522C0057        	  7953:     addq.b  #1,($0057,A4)
                            	  7954:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7955:     ; object direction and input direction to last walkable direction
                            	  7956:     ; found, and set Link's speed.
                            	  7957:     ;
                            	  7958:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7959:     ;
02:00042F88 7400            	  7960:     moveq   #0,D2
02:00042F8A 102C000D        	  7961:     move.b  ($000D,A4),D0
02:00042F8E 0C030001        	  7962:     cmpi.b  #$01,D3
02:00042F92 67000096        	  7963:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00042F96 7600            	  7964:     moveq   #0,D3
02:00042F98 162C0010        	  7965:     move.b  ($0010,A4),D3
02:00042F9C 6700008C        	  7966:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7967:     ; In UW. There are two input directions, and they're both walkable.
                            	  7968:     ;
                            	  7969:     ; Normally, turn to the direction that's perpendicular to object
                            	  7970:     ; direction. But keep going straight after that, while diagonal
                            	  7971:     ; input is held.
                            	  7972:     ;
                            	  7973:     ; Handle special cases for doors.
                            	  7974:     ;
                            	  7975:     ;
                            	  7976:     ; 1. Link at horizontal doors.
                            	  7977:     ;
                            	  7978:     ; If Link's X = $20 or $D0 then
                            	  7979:     ;   If Link's Y = $85 and facing down then
                            	  7980:     ;     Go set object direction and input direction to object
                            	  7981:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7982:     ;     Link_GoStraightWhenDiagInput.
                            	  7983:     ;   Else
                            	  7984:     ;     Go turn to the perpendicular direction
                            	  7985:     ;
02:00042FA0 7600            	  7986:     moveq   #0,D3
02:00042FA2 162C0070        	  7987:     move.b  ($0070,A4),D3
02:00042FA6 0C030020        	  7988:     cmpi.b  #$20,D3
02:00042FAA 6706            	  7989:     beq  _anon_z05_175
02:00042FAC 0C0300D0        	  7990:     cmpi.b  #$D0,D3
02:00042FB0 661C            	  7991:     bne  _anon_z05_176
