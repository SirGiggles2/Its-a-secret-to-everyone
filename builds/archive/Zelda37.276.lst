                            	  1041:     ; that draws the current room to NT 2.
02:0003EA08 102C00EB        	  1042:     move.b  ($00EB,A4),D0
02:0003EA0C 1B00            	  1043:     move.b  D0,-(A5)  ; PHA
02:0003EA0E 102C00EC        	  1044:     move.b  ($00EC,A4),D0
