                            	  3228:     ; Switch the flag indicating whether Link is the target.
                            	  3229:     ; If the value is 0 (Link *is* the target), then
                            	  3230:     ; skip this and go update objects.
                            	  3231:     ;
02:000496F2 102C0060        	  3232:     move.b  ($0060,A4),D0
02:000496F6 0A000001        	  3233:     eori.b #$01,D0
02:000496FA 19400060        	  3234:     move.b  D0,($0060,A4)
02:000496FE 671C            	  3235:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3236:     ; If Link's X has not changed since the last frame
                            	  3237:     ; (when Link was the target), then XOR the chase target
                            	  3238:     ; coordinates (which were Link's coordinates last frame).
                            	  3239:     ;
                            	  3240:     ; This ends up reflecting Link's coordinates across the room;
                            	  3241:     ; so that monsters chase away from him.
                            	  3242:     ;
                            	  3243:     ; But if Link's X has changed since the last frame, then
                            	  3244:     ; leave the chase target coordinates with his old coordinates.
                            	  3245:     ;
02:00049700 102C0061        	  3246:     move.b  ($0061,A4),D0
02:00049704 122C0070        	  3247:     move.b  ($0070,A4),D1
02:00049708 B001            	  3248:     cmp.b   D1,D0
02:0004970A 6610            	  3249:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:0004970C 4600            	  3250:     eori.b #$FF,D0
02:0004970E 19400061        	  3251:     move.b  D0,($0061,A4)
02:00049712 102C0062        	  3252:     move.b  ($0062,A4),D0
02:00049716 4600            	  3253:     eori.b #$FF,D0
02:00049718 19400062        	  3254:     move.b  D0,($0062,A4)
                            	  3255:     even
