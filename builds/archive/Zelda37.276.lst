                            	  5593: CheckState30:
                            	  5594:     ; If major state <> $30, go check other states.
                            	  5595:     ;
02:0004A66E 0C000030        	  5596:     cmpi.b  #$30,D0
02:0004A672 6656            	  5597:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5598:     ; State $3x. Slow down.
                            	  5599:     ;
                            	  5600:     ; Reset grid offset for movement.
                            	  5601:     ;
02:0004A674 7000            	  5602:     moveq   #0,D0
02:0004A676 41EC0394        	  5603:     lea     ($0394,A4),A0
02:0004A67A 11802000        	  5604:     move.b  D0,(A0,D2.W)
                            	  5605:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5606:     ;
