02:0003AD86 41F9000307FA    	  6591:     lea     (SpriteOffsets).l,A0
02:0003AD8C 10303000        	  6592:     move.b  (A0,D3.W),D0
02:0003AD90 7600            	  6593:     moveq   #0,D3
02:0003AD92 1600            	  6594:     move.b  D0,D3
02:0003AD94 101D            	  6595:     move.b  (A5)+,D0  ; PLA
02:0003AD96 41EC0201        	  6596:     lea     ($0201,A4),A0
02:0003AD9A 11803000        	  6597:     move.b  D0,(A0,D3.W)
02:0003AD9E 1014            	  6598:     move.b  ($0000,A4),D0
02:0003ADA0 41EC0203        	  6599:     lea     ($0203,A4),A0
02:0003ADA4 11803000        	  6600:     move.b  D0,(A0,D3.W)
02:0003ADA8 102C0001        	  6601:     move.b  ($0001,A4),D0
