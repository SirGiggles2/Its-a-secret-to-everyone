02:0003D686 6704            	 12139:     beq.s  __far_z_04_0118
02:0003D688 600000A4        	 12140:     jmp  Ganon_Dying
                            	 12141: __far_z_04_0118:
02:0003D68C 61000356        	 12142:     jsr     Ganon_CheckCollisions
02:0003D690 6100A93C        	 12143:     jsr     PlayBossHitCryIfNeeded
                            	 12144:     ; Go handle the brown state specially.
                            	 12145:     ;
02:0003D694 41EC00AC        	 12146:     lea     ($00AC,A4),A0
02:0003D698 10302000        	 12147:     move.b  (A0,D2.W),D0
02:0003D69C 6702            	 12148:     beq.s  __far_z_04_0119
02:0003D69E 6058            	 12149:     jmp  Ganon_UpdateBrownState
                            	 12150: __far_z_04_0119:
                            	 12151:     ; State = 0: Blue
                            	 12152:     ;
                            	 12153:     ; If timer = 0, then go move around and shoot.
                            	 12154:     ;
02:0003D6A0 10342028        	 12155:     move.b  ($28,A4,D2.W),D0
02:0003D6A4 6602            	 12156:     bne.s  __far_z_04_0120
02:0003D6A6 600E            	 12157:     jmp  Ganon_MoveAndShoot
                            	 12158: __far_z_04_0120:
                            	 12159:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12160:     ; Collisions were checked already.
                            	 12161:     ;
                            	 12162:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12163:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12164:     ;
02:0003D6A8 0C000001        	 12165:     cmpi.b  #$01,D0
02:0003D6AC 6702            	 12166:     beq.s  __far_z_04_0121
02:0003D6AE 6078            	 12167:     jmp  L_Ganon_DrawBody
                            	 12168: __far_z_04_0121:
                            	 12169: ; Description:
