                            	  3646:     ;
02:000397E4 41EC034F        	  3647:     lea     ($034F,A4),A0
02:000397E8 10302000        	  3648:     move.b  (A0,D2.W),D0
02:000397EC 0C000022        	  3649:     cmpi.b  #$22,D0
