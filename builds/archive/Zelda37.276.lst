                            	  4570:     ; Replace the low byte of the VRAM address with the one
                            	  4571:     ; where the next character should be written.
                            	  4572:     ;
02:00034AB6 102C045F        	  4573:     move.b  ($045F,A4),D0
02:00034ABA 19400303        	  4574:     move.b  D0,($0303,A4)
                            	  4575:     ; Increment the low VRAM address for the next character.
                            	  4576:     ;
02:00034ABE 522C045F        	  4577:     addq.b  #1,($045F,A4)
02:00034AC2 7000            	  4578:     moveq   #0,D0
02:00034AC4 1880            	  4579:     move.b  D0,($0000,A4)
02:00034AC6 7000            	  4580:     moveq   #0,D0
02:00034AC8 19400001        	  4581:     move.b  D0,($0001,A4)
                            	  4582:     ; Load the person text current character index.
                            	  4583:     ;
02:00034ACC 7600            	  4584:     moveq   #0,D3
02:00034ACE 162C0416        	  4585:     move.b  ($0416,A4),D3
                            	  4586:     ; Increment the index variable to point to the next character
                            	  4587:     ; for the next time.
                            	  4588:     ;
02:00034AD2 522C0416        	  4589:     addq.b  #1,($0416,A4)
                            	  4590:     ; Get the current character.
                            	  4591:     ;
02:00034AD6 1214            	  4592:     move.b  ($00,A4),D1   ; ptr lo
02:00034AD8 182C0001        	  4593:     move.b  ($01,A4),D4  ; ptr hi
02:00034ADC 024100FF        	  4594:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034AE0 E14C            	  4595:     lsl.w   #8,D4
02:00034AE2 8841            	  4596:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034AE4 48C4            	  4597:     ext.l   D4
02:00034AE6 D8BC00FF0000    	  4598:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034AEC 2044            	  4599:     movea.l D4,A0
02:00034AEE 10303000        	  4600:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4601:     ; If the character is $25, then it's a special space. It will still
                            	  4602:     ; take up space, but will not take time to show -- meaning that
                            	  4603:     ; we'll go look up the next character to transfer.
                            	  4604:     ;
02:00034AF2 0200003F        	  4605:     andi.b #$3F,D0
02:00034AF6 0C000025        	  4606:     cmpi.b  #$25,D0
02:00034AFA 67BA            	  4607:     beq  _anon_z02_32
                            	  4608:     ; We have a non-space character. Put it in the transfer record.
                            	  4609:     ;
02:00034AFC 19400305        	  4610:     move.b  D0,($0305,A4)
                            	  4611:     ; Play the "heart taken/character" tune.
                            	  4612:     ;
02:00034B00 7010            	  4613:     moveq   #16,D0
02:00034B02 19400604        	  4614:     move.b  D0,($0604,A4)
                            	  4615:     ; If the high 2 bits of character element = 0, then return.
                            	  4616:     ;
02:00034B06 1214            	  4617:     move.b  ($00,A4),D1   ; ptr lo
02:00034B08 182C0001        	  4618:     move.b  ($01,A4),D4  ; ptr hi
02:00034B0C 024100FF        	  4619:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034B10 E14C            	  4620:     lsl.w   #8,D4
02:00034B12 8841            	  4621:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034B14 48C4            	  4622:     ext.l   D4
02:00034B16 D8BC00FF0000    	  4623:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034B1C 2044            	  4624:     movea.l D4,A0
02:00034B1E 10303000        	  4625:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034B22 020000C0        	  4626:     andi.b #$C0,D0
02:00034B26 6602            	  4627:     bne.s  __far_z_02_0010
02:00034B28 6032            	  4628:     jmp  LA9F4_Exit
                            	  4629: __far_z_02_0010:
                            	  4630:     ; Determine an index based on the high 2 bits of the character element:
                            	  4631:     ;   $80: 0
                            	  4632:     ;   $40: 1
                            	  4633:     ;   $C0: 2
                            	  4634:     ;
02:00034B2A 7602            	  4635:     moveq   #2,D3
02:00034B2C 0C0000C0        	  4636:     cmpi.b  #$C0,D0
02:00034B30 670A            	  4637:     beq  _anon_z02_33
02:00034B32 5303            	  4638:     subq.b  #1,D3
02:00034B34 0C000040        	  4639:     cmpi.b  #$40,D0
02:00034B38 6702            	  4640:     beq  _anon_z02_33
02:00034B3A 5303            	  4641:     subq.b  #1,D3
                            	  4642: _anon_z02_33:
                            	  4643:     ; The index chooses the low VRAM address of the start
                            	  4644:     ; of another line:
                            	  4645:     ;   0: $C4: front of the second line
                            	  4646:     ;   1: $E4: front of the third line
                            	  4647:     ;   2: $A4: front of the first line
                            	  4648:     ;
02:00034B3C 41F900034A84    	  4649:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034B42 10303000        	  4650:     move.b  (A0,D3.W),D0
02:00034B46 1940045F        	  4651:     move.b  D0,($045F,A4)
                            	  4652:     ; If index = 2, then we've reached the end of the text,
                            	  4653:     ; and low VRAM address is moved to the front of the first line.
                            	  4654:     ; So, advance the state of the person object, and unhalt Link.
                            	  4655:     ;
02:00034B4A 0C030002        	  4656:     cmpi.b  #$02,D3
02:00034B4E 6702            	  4657:     beq.s  __far_z_02_0011
02:00034B50 600A            	  4658:     jmp  LA9F4_Exit
                            	  4659: __far_z_02_0011:
02:00034B52 522C00AD        	  4660:     addq.b  #1,($00AD,A4)
02:00034B56 7000            	  4661:     moveq   #0,D0
02:00034B58 194000AC        	  4662:     move.b  D0,($00AC,A4)
                            	  4663:     even
