                            	 11919: PatraChild_State1:
                            	 11920:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 11921:     ;
02:0003D50A 10342070        	 11922:     move.b  ($70,A4,D2.W),D0
