                            	  7778: __far_z_05_0086:
                            	  7779:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7780:     ; and represents the current row of the submenu being processed.
                            	  7781:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7782:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7783:     ;
                            	  7784:     ; If the bottom bit is set, go prepare the full black row.
                            	  7785:     ;
02:00042E96 E208            	  7786:     lsr.b  #1,D0   ; LSR A
02:00042E98 7600            	  7787:     moveq   #0,D3
02:00042E9A 1600            	  7788:     move.b  D0,D3
02:00042E9C 6402            	  7789:     bcc.s  __far_z_05_0087
02:00042E9E 60B6            	  7790:     jmp  PrepFullBlackRow
                            	  7791: __far_z_05_0087:
