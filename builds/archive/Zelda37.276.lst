02:00039620 41EC03E4        	  3354:     lea     ($03E4,A4),A0
02:00039624 12302000        	  3355:     move.b  (A0,D2.W),D1
02:00039628 B300            	  3356:     eor.b  D1,D0
02:0003962A 41EC03E4        	  3357:     lea     ($03E4,A4),A0
02:0003962E 11802000        	  3358:     move.b  D0,(A0,D2.W)
                            	  3359:     even
