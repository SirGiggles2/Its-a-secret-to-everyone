02:00031E76 41EC0630        	   565:     lea     ($0630,A4),A0
02:00031E7A 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00031E7E 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00031E82 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
