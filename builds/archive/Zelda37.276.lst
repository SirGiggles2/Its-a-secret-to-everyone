02:0004A75A 7604            	  5749:     moveq   #4,D3
02:0004A75C 4EB900030476    	  5750:     jsr     _CalcDiagonalSpeedIndex
                            	  5751:     ; Move vertically towards the thrower.
                            	  5752:     ;
02:0004A762 41F90004A43C    	  5753:     lea     (BoomerangQSpeedFracsY).l,A0
02:0004A768 10303000        	  5754:     move.b  (A0,D3.W),D0
02:0004A76C 4EB90003047A    	  5755:     jsr     SetBoomerangSpeed
02:0004A772 102C000A        	  5756:     move.b  ($000A,A4),D0
02:0004A776 1940000F        	  5757:     move.b  D0,($000F,A4)
02:0004A77A 41EC0098        	  5758:     lea     ($0098,A4),A0
02:0004A77E 11802000        	  5759:     move.b  D0,(A0,D2.W)
02:0004A782 1003            	  5760:     move.b  D3,D0
02:0004A784 1B00            	  5761:     move.b  D0,-(A5)  ; PHA
02:0004A786 6100F48E        	  5762:     jsr     MoveObject
                            	  5763:     ; Move horizontally towards the thrower.
