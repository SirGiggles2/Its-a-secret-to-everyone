                            	  1363: Zol_CheckCollisions:
                            	  1364:     ; If not in state 0, then return.
                            	  1365:     ;
02:0003886E 41EC00AC        	  1366:     lea     ($00AC,A4),A0
02:00038872 10302000        	  1367:     move.b  (A0,D2.W),D0
02:00038876 665C            	  1368:     bne  _L_z04_Zol_CheckCollisions_Exit
                            	  1369:     ; Check collisions.
                            	  1370:     ;
                            	  1371:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1372:     ; then return.
                            	  1373:     ;
02:00038878 610001B0        	  1374:     jsr     Gel_CheckCollisions
02:0003887C 41EC0405        	  1375:     lea     ($0405,A4),A0
02:00038880 10302000        	  1376:     move.b  (A0,D2.W),D0
02:00038884 664E            	  1377:     bne  _L_z04_Zol_CheckCollisions_Exit
02:00038886 41EC04F0        	  1378:     lea     ($04F0,A4),A0
02:0003888A 10302000        	  1379:     move.b  (A0,D2.W),D0
02:0003888E 6744            	  1380:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1381:     ; If vertically aligned with the square grid, then
                            	  1382:     ; use a horizontal direction mask (3).
                            	  1383:     ;
                            	  1384:     ; Keep in mind that most objects are aligned vertically when
                            	  1385:     ; the low nibble of their Y is $D.
                            	  1386:     ;
02:00038890 7600            	  1387:     moveq   #0,D3
02:00038892 41EC0084        	  1388:     lea     ($0084,A4),A0
02:00038896 10302000        	  1389:     move.b  (A0,D2.W),D0
02:0003889A 0200000F        	  1390:     andi.b #$0F,D0
02:0003889E 0C00000D        	  1391:     cmpi.b  #$0D,D0
02:000388A2 6602            	  1392:     bne  _anon_z04_26
02:000388A4 7603            	  1393:     moveq   #3,D3
                            	  1394: _anon_z04_26:
02:000388A6 1883            	  1395:     move.b  D3,($0000,A4)
                            	  1396:     ; If horizontally aligned with the square grid, then
                            	  1397:     ; use a vertical direction mask ($C).
                            	  1398:     ;
02:000388A8 7600            	  1399:     moveq   #0,D3
02:000388AA 10342070        	  1400:     move.b  ($70,A4,D2.W),D0
02:000388AE 0200000F        	  1401:     andi.b #$0F,D0
02:000388B2 6602            	  1402:     bne  _anon_z04_27
02:000388B4 760C            	  1403:     moveq   #12,D3
                            	  1404: _anon_z04_27:
02:000388B6 1003            	  1405:     move.b  D3,D0
                            	  1406:     ; Combine the two masks. At most one will be 0.
                            	  1407:     ;
02:000388B8 1214            	  1408:     move.b  ($0000,A4),D1
02:000388BA 8001            	  1409:     or.b  D1,D0
                            	  1410:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1411:     ; with the grid.
                            	  1412:     ;
                            	  1413:     ; If so, then go to state 1 to do a "big shove".
                            	  1414:     ; Else go to state 2, to immediately split in two.
                            	  1415:     ;
                            	  1416:     ; Examples:
                            	  1417:     ; It would be aligned, if moving left along a tile as usual.
                            	  1418:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1419:     ; - The collision check routines would have made the zol
                            	  1420:     ;   face in the direction of the weapon.
                            	  1421:     ; - See CheckMonsterWeaponCollision.
                            	  1422:     ;
02:000388BC 122C0098        	  1423:     move.b  ($0098,A4),D1
02:000388C0 C001            	  1424:     and.b  D1,D0
02:000388C2 6608            	  1425:     bne  _anon_z04_28
02:000388C4 41EC00AC        	  1426:     lea     ($00AC,A4),A0
02:000388C8 52302000        	  1427:     addq.b  #1,(A0,D2.W)
                            	  1428: _anon_z04_28:
02:000388CC 41EC00AC        	  1429:     lea     ($00AC,A4),A0
02:000388D0 52302000        	  1430:     addq.b  #1,(A0,D2.W)
                            	  1431:     even
