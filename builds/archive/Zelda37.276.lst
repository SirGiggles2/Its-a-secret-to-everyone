02:000393CA 19802070        	  3034:     move.b  D0,($70,A4,D2.W)
                            	  3035:     ; If facing down, then use Y offset $28.
                            	  3036:     ; Else store Y offset -$28 in [00].
                            	  3037:     ;
02:000393CE 7628            	  3038:     moveq   #40,D3
02:000393D0 41EC0098        	  3039:     lea     ($0098,A4),A0
02:000393D4 10302000        	  3040:     move.b  (A0,D2.W),D0
02:000393D8 02000008        	  3041:     andi.b #$08,D0
02:000393DC 6704            	  3042:     beq  _anon_z04_44
02:000393DE 163C00D8        	  3043:     move.b  #$D8,D3
                            	  3044: _anon_z04_44:
02:000393E2 1883            	  3045:     move.b  D3,($0000,A4)
                            	  3046:     ; Add Link's Y and the vertical offset.
                            	  3047:     ;
02:000393E4 102C0084        	  3048:     move.b  ($0084,A4),D0
