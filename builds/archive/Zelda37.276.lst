02:00039450 B001            	  3112:     cmp.b   D1,D0
02:00039452 6510            	  3113:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00039454 1B00            	  3114:     move.b  D0,-(A5)  ; PHA
02:00039456 102C0001        	  3115:     move.b  ($0001,A4),D0
