                            	  6624: UpdateDodongoState_JumpTable:
02:0003ADD8 0003ADE4        	  6625:     dc.l    UpdateDodongoState0_Move   ; jump table entry (32-bit for _m68k_tablejump)
02:0003ADDC 0003AE48        	  6626:     dc.l    UpdateDodongoState1_Bloated   ; jump table entry (32-bit for _m68k_tablejump)
02:0003ADE0 0003AE42        	  6627:     dc.l    UpdateDodongoState2_Stunned   ; jump table entry (32-bit for _m68k_tablejump)
