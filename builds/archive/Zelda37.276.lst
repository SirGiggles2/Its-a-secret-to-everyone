                            	  1666: UpdateStatues:
                            	  1667:     ; If person fireballs are enabled (from the two fires), then
                            	  1668:     ; go make fireballs with pattern 2.
                            	  1669:     ;
02:00038A60 7602            	  1670:     moveq   #2,D3
02:00038A62 102C04CC        	  1671:     move.b  ($04CC,A4),D0
02:00038A66 6620            	  1672:     bne  _L_z04_UpdateStatues_Shoot
                            	  1673:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1674:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1675:     ; - layout $23: pattern 1: 2 statues
                            	  1676:     ; - layout $24: pattern 0: 4 statues
                            	  1677:     ;
02:00038A68 4EB900048FEA    	  1678:     jsr     GetUniqueRoomId
02:00038A6E 7601            	  1679:     moveq   #1,D3
                            	  1680: _anon_z04_30:
02:00038A70 41F900038A42    	  1681:     lea     (StatueRoomLayouts).l,A0
02:00038A76 12303000        	  1682:     move.b  (A0,D3.W),D1
02:00038A7A B001            	  1683:     cmp.b   D1,D0
02:00038A7C 670A            	  1684:     beq  _L_z04_UpdateStatues_Shoot
02:00038A7E 5303            	  1685:     subq.b  #1,D3
02:00038A80 6AEE            	  1686:     bpl  _anon_z04_30
02:00038A82 0A3C0001        	  1687:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00038A86 4E75            	  1688:     rts
                            	  1689: 
