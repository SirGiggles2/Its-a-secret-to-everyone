                            	  5666: _anon_z07_30:
02:0004A6E2 4EB900030472    	  5667:     jsr     GetDirectionsAndDistancesToTarget
                            	  5668:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5669:     ; then go move towards the thrower, draw, and check collisions.
                            	  5670:     ;
02:0004A6E8 1014            	  5671:     move.b  ($0000,A4),D0
