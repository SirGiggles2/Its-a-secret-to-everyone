                            	   902: 
                            	   903: ;------------------------------------------------------------------------------
                            	   904: ; _c_move_object_shim — MoveObject trampoline.
                            	   905: ;
                            	   906: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   907: ;   Input:     D2 = slot (0..11)
                            	   908: ;   Preserves: D2, A4, A5
                            	   909: ;   Clobbers:  D0, D1, D3, A0
                            	   910: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   911: ;
                            	   912: ; GCC side:
                            	   913: ;   void c_move_object(unsigned short slot);
                            	   914: ;     slot arrives as a 16-bit value on the stack.
                            	   915: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   916: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   917: ;   never clobbered by gcc.
                            	   918: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   919: ;   semantics can exist in a pure C port).
                            	   920: ;------------------------------------------------------------------------------
                            	   921: _c_move_object_shim:
                            	   922:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   923:     move.b  #$AA,($0900,A4)
                            	   924:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   925:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   926:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   927:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   928:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   929:     moveq   #0,D0
02:0002B658 3002            	   930:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   931:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   932:     jsr     c_move_object
02:0002B662 588F            	   933:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   934:     rts
                            	   935: 
                            	   936: ;==============================================================================
                            	   937: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   938: ; and tail-call the native asm function.
                            	   939: ;
                            	   940: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   941: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   942: ; sign-extended).
                            	   943: ;==============================================================================
                            	   944: 
                            	   945: ;------------------------------------------------------------------------------
                            	   946: ; void c_copy_bank_to_window(unsigned int bank);
                            	   947: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   948: ;------------------------------------------------------------------------------
                            	   949: c_copy_bank_to_window:
02:0002B666 202F0004        	   950:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   951:     jmp     _copy_bank_to_window
                            	   952: 
                            	   953: ;------------------------------------------------------------------------------
                            	   954: ; unsigned char c_ppu_read_2(void);
                            	   955: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   956: ; C return: gcc expects result in D0.
                            	   957: ;------------------------------------------------------------------------------
                            	   958: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   959:     jmp     _ppu_read_2
                            	   960: 
                            	   961: ;------------------------------------------------------------------------------
                            	   962: ; void c_ppu_write_6(unsigned int val);
                            	   963: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   964: ;------------------------------------------------------------------------------
                            	   965: c_ppu_write_6:
02:0002B674 202F0004        	   966:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   967:     jmp     _ppu_write_6
                            	   968: 
                            	   969: ;------------------------------------------------------------------------------
                            	   970: ; void c_ppu_write_7(unsigned int val);
                            	   971: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   972: ;------------------------------------------------------------------------------
                            	   973: c_ppu_write_7:
02:0002B67E 202F0004        	   974:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   975:     jmp     _ppu_write_7
                            	   976: 
                            	   977: ;------------------------------------------------------------------------------
                            	   978: ; void c_turn_off_all_video(void);
                            	   979: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   980: ;------------------------------------------------------------------------------
                            	   981: c_turn_off_all_video:
02:0002B688 4EF900048BCC    	   982:     jmp     TurnOffAllVideo
                            	   983: 
                            	   984: ;==============================================================================
                            	   985: ; EXPORT side — z_03 entry point.
                            	   986: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   987: ; the transpiler emits that label pointing to this shim instead of the
                            	   988: ; z_03 asm body. The C function takes no args and returns void.
                            	   989: ;==============================================================================
                            	   990: 
                            	   991: ;------------------------------------------------------------------------------
                            	   992: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   993: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   994: ;------------------------------------------------------------------------------
                            	   995: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   996:     jmp     z03_transfer_level_pattern_blocks
                            	   997: 
                            	   998: ;==============================================================================
                            	   999: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1000: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1001: ;==============================================================================
                            	  1002: 
                            	  1003: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1004:     jmp     z06_init_mode2_submodes
                            	  1005: 
                            	  1006: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1007:     jmp     z06_copy_common_data_to_ram
                            	  1008: 
                            	  1009: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1010:     jmp     z06_update_mode2_load_full
                            	  1011: 
                            	  1012: ;==============================================================================
                            	  1013: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1014: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1015: ;==============================================================================
                            	  1016: 
                            	  1017: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1018:     jmp     z05_copy_column_to_tilebuf
                            	  1019: 
                            	  1020: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	  1021:     jmp     z05_copy_row_to_tilebuf
                            	  1022: 
                            	  1023: ;==============================================================================
                            	  1024: ; EXPORT side — z_05 entry points (Stage 4a).
                            	  1025: ;==============================================================================
                            	  1026: 
                            	  1027: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	  1028: c_has_compass:
02:0002B6B2 4EB900000000    	  1029:     jsr     z05_has_compass
02:0002B6B8 4A00            	  1030:     tst.b   D0
02:0002B6BA 4E75            	  1031:     rts
                            	  1032: 
                            	  1033: c_has_map:
02:0002B6BC 4EB900000000    	  1034:     jsr     z05_has_map
02:0002B6C2 4A00            	  1035:     tst.b   D0
02:0002B6C4 4E75            	  1036:     rts
                            	  1037: 
                            	  1038: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	  1039: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	  1040:     move.l  D0,-(SP)
02:0002B6C8 7200            	  1041:     moveq   #0,D1
02:0002B6CA 1202            	  1042:     move.b  D2,D1
02:0002B6CC 2F01            	  1043:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	  1044:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	  1045:     andi.l  #$FF,D1
02:0002B6D8 2F01            	  1046:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	  1047:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	  1048:     addq.l  #8,SP
02:0002B6E2 201F            	  1049:     move.l  (SP)+,D0
02:0002B6E4 4E75            	  1050:     rts
