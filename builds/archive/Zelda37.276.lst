02:0003B40A 0C0000A8        	  7540:     cmpi.b  #$A8,D0
02:0003B40E 6502            	  7541:     bcs  _anon_z04_98
02:0003B410 7607            	  7542:     moveq   #7,D3
                            	  7543: _anon_z04_98:
                            	  7544:     ; Set the vertical speed for the beginning of the jump.
