                            	  3474: ; Returns:
                            	  3475: ; [00]: 0 for Link slot
                            	  3476: ; [06]: 1 if objects collide
                            	  3477: ; [09]: 0 for Link damage type (none)
                            	  3478: ; [0C]: 1 if objects collide
