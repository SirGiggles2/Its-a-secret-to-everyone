                            	  3679: __far_z_04_0033:
                            	  3680:     ; Animate.
                            	  3681:     ;
                            	  3682:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3683:     ; then only go draw.
                            	  3684:     ;
02:00039824 41EC03D0        	  3685:     lea     ($03D0,A4),A0
02:00039828 53302000        	  3686:     subq.b  #1,(A0,D2.W)
02:0003982C 6702            	  3687:     beq.s  __far_z_04_0034
02:0003982E 601E            	  3688:     jmp  DrawArmosAndCheckCollisions
                            	  3689: __far_z_04_0034:
                            	  3690:     ; Armos animation frames last 6 screen frames.
                            	  3691:     ;
02:00039830 7006            	  3692:     moveq   #6,D0
02:00039832 41EC03D0        	  3693:     lea     ($03D0,A4),A0
02:00039836 11802000        	  3694:     move.b  D0,(A0,D2.W)
                            	  3695:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3696:     ; change the position of the shield. To keep fixed it in place,
                            	  3697:     ; there are separate frame images for each animation frame.
                            	  3698:     ;
                            	  3699:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3700:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3701:     ;
                            	  3702:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3703:     ; Then choose the direction at the point of drawing below.
                            	  3704:     ;
02:0003983A 41EC03E4        	  3705:     lea     ($03E4,A4),A0
02:0003983E 10302000        	  3706:     move.b  (A0,D2.W),D0
02:00039842 0A000002        	  3707:     eori.b #$02,D0
02:00039846 41EC03E4        	  3708:     lea     ($03E4,A4),A0
02:0003984A 11802000        	  3709:     move.b  D0,(A0,D2.W)
                            	  3710:     even
                            	  3711: DrawArmosAndCheckCollisions:
02:0003984E 4EB90004AF7C    	  3712:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00039854 7600            	  3713:     moveq   #0,D3
02:00039856 41EC0098        	  3714:     lea     ($0098,A4),A0
02:0003985A 16302000        	  3715:     move.b  (A0,D2.W),D3
                            	  3716:     ; If facing up, then use the second frame image in the set ("back").
                            	  3717:     ; Else use the second.
                            	  3718:     ;
02:0003985E 0C030008        	  3719:     cmpi.b  #$08,D3
02:00039862 6602            	  3720:     bne  _anon_z04_54
02:00039864 7001            	  3721:     moveq   #1,D0
                            	  3722: _anon_z04_54:
02:00039866 023C00EE        	  3723:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003986A 41EC03E4        	  3724:     lea     ($03E4,A4),A0
02:0003986E 12302000        	  3725:     move.b  (A0,D2.W),D1
02:00039872 D101            	  3726:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00039874 4EB900030832    	  3727:     jsr     DrawObjectNotMirrored
                            	  3728:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3729:     ; but not with weapons.
                            	  3730:     ;
02:0003987A 10342028        	  3731:     move.b  ($28,A4,D2.W),D0
