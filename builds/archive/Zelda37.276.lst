                            	  7769: Submenu_CueTransferRowOW:
                            	  7770:     ;
                            	  7771:     ;
                            	  7772:     ; If menu scroll value is negative, then we transferred everything.
                            	  7773:     ; So, return.
                            	  7774:     ;
02:00042E8E 102C005E        	  7775:     move.b  ($005E,A4),D0
