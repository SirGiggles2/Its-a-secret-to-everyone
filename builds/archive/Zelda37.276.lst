                            	  3120: _L_z04_UpdateRedLeever_Subtract:
                            	  3121:     ; The point is to get the absolute distance between the two.
                            	  3122:     ;
02:00039464 102C0001        	  3123:     move.b  ($0001,A4),D0
02:00039468 003C0011        	  3124:     ori     #$11,CCR  ; SEC: set C+X
02:0003946C 122C0002        	  3125:     move.b  ($0002,A4),D1
02:00039470 0A3C0010        	  3126:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039474 9101            	  3127:     subx.b  D1,D0   ; SBC $02
02:00039476 0A3C0010        	  3128:     eori    #$10,CCR  ; restore X = 6502 C
