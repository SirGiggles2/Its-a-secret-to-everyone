                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:0003E570 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0003E574 02000010        	   426:     andi.b #$10,D0
02:0003E578 6606            	   427:     bne.s  __far_z_05_0000
02:0003E57A 4EF90002DEE0    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:0003E580 102C0254        	   430:     move.b  ($0254,A4),D0
02:0003E584 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0003E586 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003E58A 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003E58C 4EB900048B7C    	   434:     jsr     HideAllSprites
02:0003E592 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003E594 19400258        	   436:     move.b  D0,($0258,A4)
02:0003E598 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003E59A 19400254        	   438:     move.b  D0,($0254,A4)
02:0003E59E 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003E5A2 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E5A6 4E75            	   441:     rts
