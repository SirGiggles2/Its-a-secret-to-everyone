02:0003E604 6606            	   502:     bne.s  __far_z_05_0002
02:0003E606 4EF90002DEE0    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:0003E60C 61004EC2        	   505:     jsr     HasCompass
02:0003E610 6606            	   506:     bne.s  __far_z_05_0003
02:0003E612 4EF90002DEE0    	   507:     jmp  Exit
