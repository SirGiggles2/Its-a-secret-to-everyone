                            	  1061: __far_z_04_0016:
                            	  1062: ; Params:
                            	  1063: ; X: monster object index
                            	  1064: ;
                            	  1065: ; Returns:
                            	  1066: ; [00]: 0 for Link slot
                            	  1067: ; [06]: 1 if objects collide
