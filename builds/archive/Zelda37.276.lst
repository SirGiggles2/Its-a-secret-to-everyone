02:0004A7FE 4EB900030C04    	  5815:     jsr     CheckLinkCollision
02:0004A804 102C034B        	  5816:     move.b  ($034B,A4),D0
02:0004A808 6602            	  5817:     bne.s  __far_z_07_0089
02:0004A80A 6014            	  5818:     jmp  CalcBoomerangFrame
                            	  5819: __far_z_07_0089:
02:0004A80C 7003            	  5820:     moveq   #3,D0
02:0004A80E 41EC03D0        	  5821:     lea     ($03D0,A4),A0
02:0004A812 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004A816 7020            	  5823:     moveq   #32,D0
02:0004A818 41EC00AC        	  5824:     lea     ($00AC,A4),A0
02:0004A81C 11802000        	  5825:     move.b  D0,(A0,D2.W)
                            	  5826:     even
                            	  5827: CalcBoomerangFrame:
                            	  5828:     ; The minor state (low 3 bits of state) is used to
                            	  5829:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5830:     ;
                            	  5831:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5832:     ; In other words, don't offset the coordinate below.
                            	  5833:     ;
02:0004A820 7000            	  5834:     moveq   #0,D0
02:0004A822 1880            	  5835:     move.b  D0,($0000,A4)
02:0004A824 41EC00AC        	  5836:     lea     ($00AC,A4),A0
02:0004A828 10302000        	  5837:     move.b  (A0,D2.W),D0
02:0004A82C 0200000F        	  5838:     andi.b #$0F,D0
02:0004A830 7600            	  5839:     moveq   #0,D3
02:0004A832 1600            	  5840:     move.b  D0,D3
02:0004A834 7000            	  5841:     moveq   #0,D0
02:0004A836 19400001        	  5842:     move.b  D0,($0001,A4)
02:0004A83A 41F90004A428    	  5843:     lea     (BoomerangFrameCycle).l,A0
02:0004A840 10303000        	  5844:     move.b  (A0,D3.W),D0
02:0004A844 1940000C        	  5845:     move.b  D0,($000C,A4)
