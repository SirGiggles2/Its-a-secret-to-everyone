02:0003A1A0 123C0010        	  4996:     move.b  #$10,D1
02:0003A1A4 D101            	  4997:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A1A6 41EC0412        	  4998:     lea     ($0412,A4),A0
02:0003A1AA 11802000        	  4999:     move.b  D0,(A0,D2.W)
02:0003A1AE 5203            	  5000:     addq.b  #1,D3
