                            	  6879: Dodongo_CheckBombHit:
                            	  6880:     ; If state <> 0 (not moving), then return.
                            	  6881:     ;
02:0003AFB4 41EC00AC        	  6882:     lea     ($00AC,A4),A0
02:0003AFB8 10302000        	  6883:     move.b  (A0,D2.W),D0
02:0003AFBC 66000086        	  6884:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  6885:     ; If facing vertically, then store (X + 8) in [00].
                            	  6886:     ; Else store (X + $10).
                            	  6887:     ;
02:0003AFC0 10342070        	  6888:     move.b  ($70,A4,D2.W),D0
02:0003AFC4 023C00EE        	  6889:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFC8 123C0008        	  6890:     move.b  #$08,D1
02:0003AFCC D101            	  6891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AFCE 7600            	  6892:     moveq   #0,D3
02:0003AFD0 41EC0098        	  6893:     lea     ($0098,A4),A0
02:0003AFD4 16302000        	  6894:     move.b  (A0,D2.W),D3
02:0003AFD8 0C030004        	  6895:     cmpi.b  #$04,D3
02:0003AFDC 6406            	  6896:     bcc  _anon_z04_91
02:0003AFDE 123C0008        	  6897:     move.b  #$08,D1
02:0003AFE2 D101            	  6898:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6899: _anon_z04_91:
02:0003AFE4 1880            	  6900:     move.b  D0,($0000,A4)
                            	  6901:     ; Store (Y + 8) in [01].
                            	  6902:     ;
02:0003AFE6 41EC0084        	  6903:     lea     ($0084,A4),A0
02:0003AFEA 10302000        	  6904:     move.b  (A0,D2.W),D0
02:0003AFEE 123C0008        	  6905:     move.b  #$08,D1
02:0003AFF2 D101            	  6906:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AFF4 19400001        	  6907:     move.b  D0,($0001,A4)
                            	  6908:     ; Only check the first bomb slot ($10).
                            	  6909:     ;
                            	  6910:     ; Store the bomb's (X + 8) in [02].
                            	  6911:     ;
02:0003AFF8 7610            	  6912:     moveq   #16,D3
02:0003AFFA 10343070        	  6913:     move.b  ($70,A4,D3.W),D0
02:0003AFFE 123C0008        	  6914:     move.b  #$08,D1
02:0003B002 D101            	  6915:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B004 19400002        	  6916:     move.b  D0,($0002,A4)
                            	  6917:     ; Store the bomb's (Y + 8) in [03].
                            	  6918:     ;
02:0003B008 41EC0084        	  6919:     lea     ($0084,A4),A0
02:0003B00C 10303000        	  6920:     move.b  (A0,D3.W),D0
02:0003B010 123C0008        	  6921:     move.b  #$08,D1
02:0003B014 D101            	  6922:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B016 19400003        	  6923:     move.b  D0,($0003,A4)
                            	  6924:     ; But, if there's no bomb, then return.
                            	  6925:     ;
02:0003B01A 41EC00AC        	  6926:     lea     ($00AC,A4),A0
02:0003B01E 10303000        	  6927:     move.b  (A0,D3.W),D0
02:0003B022 6720            	  6928:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  6929:     ; If the bomb has not exploded (state $12), then
                            	  6930:     ; go see if Dodongo will eat it.
