                            	 12215: Ganon_UpdateBrownState:
                            	 12216:     ; Every other frame decrement the state.
                            	 12217:     ; But every frame draw Ganon either translucent or opaque.
                            	 12218:     ;
02:0003D6F8 102C0015        	 12219:     move.b  ($0015,A4),D0
02:0003D6FC E208            	 12220:     lsr.b  #1,D0   ; LSR A
