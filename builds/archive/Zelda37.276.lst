02:0003999C 102C0085        	  3926:     move.b  ($0085,A4),D0
02:000399A0 003C0011        	  3927:     ori     #$11,CCR  ; SEC: set C+X
02:000399A4 123C001C        	  3928:     move.b  #$1C,D1
02:000399A8 0A3C0010        	  3929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000399AC 9101            	  3930:     subx.b  D1,D0   ; SBC #$1C
02:000399AE 0A3C0010        	  3931:     eori    #$10,CCR  ; restore X = 6502 C
02:000399B2 41EC0084        	  3932:     lea     ($0084,A4),A0
02:000399B6 11802000        	  3933:     move.b  D0,(A0,D2.W)
                            	  3934:     even
