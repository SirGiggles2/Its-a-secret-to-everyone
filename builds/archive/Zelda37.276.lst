                            	  3091: _anon_z04_45:
02:0003942E 1883            	  3092:     move.b  D3,($0000,A4)
                            	  3093:     ; [01] holds Link's X coordinate.
                            	  3094:     ;
02:00039430 102C0070        	  3095:     move.b  ($0070,A4),D0
02:00039434 19400001        	  3096:     move.b  D0,($0001,A4)
                            	  3097:     ; Add Link's X and the horizontal offset.
                            	  3098:     ;
02:00039438 023C00EE        	  3099:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003943C 1214            	  3100:     move.b  ($0000,A4),D1
02:0003943E D101            	  3101:     addx.b  D1,D0   ; ADC $00
                            	  3102:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3103:     ;
02:00039440 020000F8        	  3104:     andi.b #$F8,D0
                            	  3105:     ; Assign that result to the leever's X coordinate and [02].
                            	  3106:     ;
02:00039444 19802070        	  3107:     move.b  D0,($70,A4,D2.W)
02:00039448 19400002        	  3108:     move.b  D0,($0002,A4)
                            	  3109:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
