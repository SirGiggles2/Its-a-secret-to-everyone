                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:0003E672 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:0003E674 7400            	   545:     moveq   #0,D2
02:0003E676 41F90003E62A    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E67C 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003E680 41F90003E65A    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003E686 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003E68A 41F900045682    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E690 11802000        	   551:     move.b  D0,(A0,D2.W)
02:0003E694 5303            	   552:     subq.b  #1,D3
02:0003E696 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003E698 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003E69A 7001            	   561:     moveq   #1,D0
02:0003E69C 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003E6A0 7003            	   569:     moveq   #3,D0
02:0003E6A2 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003E6A6 7400            	   576:     moveq   #0,D2
02:0003E6A8 41F90003E62A    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E6AE 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:0003E6B2 102C0006        	   585:     move.b  ($0006,A4),D0
02:0003E6B6 122C0671        	   586:     move.b  ($0671,A4),D1
02:0003E6BA C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E6BC 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0003E6BE 41F900045682    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E6C4 10302000        	   599:     move.b  (A0,D2.W),D0
02:0003E6C8 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0003E6CC 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003E6CE 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0003E6D2 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003E6D4 41F90003E642    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003E6DA 10303000        	   605:     move.b  (A0,D3.W),D0
02:0003E6DE 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003E6E0 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:0003E6E4 41F900045682    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E6EA 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:0003E6EE 5203            	   621:     addq.b  #1,D3
02:0003E6F0 532C0007        	   622:     subq.b  #1,($0007,A4)
02:0003E6F4 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:0003E6F6 122C0006        	   629:     move.b  ($0006,A4),D1
02:0003E6FA E309            	   630:     lsl.b  #1,D1   ; ASL $06
02:0003E6FC 19410006        	   631:     move.b  D1,($0006,A4)
02:0003E700 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003E702 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:0003E706 4E75            	   634:     rts
                            	   635: 
                            	   636:     even
                            	   637: ScrollWorld:
02:0003E708 102C0015        	   638:     move.b  ($0015,A4),D0
                            	   639:     ; The purpose of this is to delay vertical scrolling.
                            	   640:     ; OW: once every two frames
                            	   641:     ; UW: once every four frames
                            	   642:     ; Horizontal scrolling happens every frame.
02:0003E70C 02000003        	   643:     andi.b #$03,D0
02:0003E710 7600            	   644:     moveq   #0,D3
02:0003E712 162C0010        	   645:     move.b  ($0010,A4),D3
02:0003E716 6604            	   646:     bne  _anon_z05_8
02:0003E718 02000001        	   647:     andi.b #$01,D0
                            	   648: _anon_z05_8:
02:0003E71C 122C00E6        	   649:     move.b  ($00E6,A4),D1
02:0003E720 B001            	   650:     cmp.b   D1,D0
02:0003E722 6704            	   651:     beq.s  __far_z_05_0004
02:0003E724 600000DE        	   652:     jmp  ScrollWorldH
                            	   653: __far_z_05_0004:
02:0003E728 7008            	   654:     moveq   #8,D0
02:0003E72A 122C0098        	   655:     move.b  ($0098,A4),D1
02:0003E72E C200            	   656:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E730 6602            	   657:     bne.s  __far_z_05_0005
02:0003E732 606E            	   658:     jmp  ScrollWorldDownOrH
                            	   659: __far_z_05_0005:
                            	   660:     ; then scroll up.
                            	   661:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   662:     ;
02:0003E734 532C00E9        	   663:     subq.b  #1,($00E9,A4)
02:0003E738 102C0084        	   664:     move.b  ($0084,A4),D0
02:0003E73C 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:0003E740 640A            	   666:     bcc  _anon_z05_9
02:0003E742 123C0008        	   667:     move.b  #$08,D1
02:0003E746 D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E748 19400084        	   669:     move.b  D0,($0084,A4)
                            	   670: _anon_z05_9:
02:0003E74C 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:0003E750 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0003E754 123C0020        	   673:     move.b  #$20,D1
02:0003E758 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E75C 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:0003E75E 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E762 194000E2        	   677:     move.b  D0,($00E2,A4)
02:0003E766 6404            	   678:     bcc  _anon_z05_10
02:0003E768 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:0003E76C 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:0003E770 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:0003E772 102C0058        	   683:     move.b  ($0058,A4),D0
02:0003E776 0C000020        	   684:     cmpi.b  #$20,D0
02:0003E77A 6716            	   685:     beq  _L_z05_ScrollWorld_LimitLow
02:0003E77C 0C000027        	   686:     cmpi.b  #$27,D0
02:0003E780 660E            	   687:     bne  _L_z05_ScrollWorld_Exit
                            	   688:     ; VScroll address is $27E0. So, we rolled from the
                            	   689:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   690:     ; to $23A0, the true last row of NT 0.
02:0003E782 7023            	   691:     moveq   #35,D0
02:0003E784 19400058        	   692:     move.b  D0,($0058,A4)
02:0003E788 103C00A0        	   693:     move.b  #$A0,D0
02:0003E78C 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
                            	   696: _L_z05_ScrollWorld_Exit:
02:0003E790 4E75            	   697:     rts
                            	   698: 
                            	   699:     even
                            	   700: _L_z05_ScrollWorld_LimitLow:
                            	   701:     ; Don't let the scroll position go above $2100, the bottom of
                            	   702:     ; the status bar; nor below $2800, the top of NT 2.
02:0003E792 522C0058        	   703:     addq.b  #1,($0058,A4)
                            	   704:     even
                            	   705: ResetVScrollLo:
02:0003E796 4EF90002BC74    	   706:     jmp     c_reset_vscroll_lo
                            	   707: 
                            	   708: IncSubmode:
02:0003E79C 4EF90002B9DC    	   709:     jmp     c_inc_submode
                            	   710: 
                            	   711: ScrollWorldDownOrH:
02:0003E7A2 E208            	   712:     lsr.b  #1,D0   ; LSR A
02:0003E7A4 122C0098        	   713:     move.b  ($0098,A4),D1
02:0003E7A8 C200            	   714:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E7AA 6602            	   715:     bne.s  __far_z_05_0006
02:0003E7AC 6056            	   716:     jmp  ScrollWorldH
                            	   717: __far_z_05_0006:
                            	   718:     ; then scroll down.
                            	   719:     ;
02:0003E7AE 522C00E9        	   720:     addq.b  #1,($00E9,A4)
02:0003E7B2 102C0084        	   721:     move.b  ($0084,A4),D0
02:0003E7B6 0C00003E        	   722:     cmpi.b  #$3E,D0
02:0003E7BA 6512            	   723:     bcs  _anon_z05_11
02:0003E7BC 123C0008        	   724:     move.b  #$08,D1
02:0003E7C0 0A3C0010        	   725:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7C4 9101            	   726:     subx.b  D1,D0   ; SBC #$08
02:0003E7C6 0A3C0010        	   727:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7CA 19400084        	   728:     move.b  D0,($0084,A4)
