02:0003D87E 610000B2        	 12427:     jsr     Ganon_GetCurCloudRight
02:0003D882 619A            	 12428:     jsr     Ganon_DrawCloud
02:0003D884 610000A6        	 12429:     jsr     Ganon_GetCurCloudLeft
02:0003D888 610000B4        	 12430:     jsr     Ganon_GetCurCloudBottom
