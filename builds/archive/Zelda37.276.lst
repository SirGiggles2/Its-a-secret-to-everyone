                            	 11289:     ;
02:0003D09C 103C009E        	 11290:     move.b  #$9E,D0
02:0003D0A0 0C020005        	 11291:     cmpi.b  #$05,D2
02:0003D0A4 670A            	 11292:     beq  _L_z04_UpdateLamnola_Draw
02:0003D0A6 0C02000A        	 11293:     cmpi.b  #$0A,D2
02:0003D0AA 6704            	 11294:     beq  _L_z04_UpdateLamnola_Draw
02:0003D0AC 103C00A0        	 11295:     move.b  #$A0,D0
                            	 11296:     even
                            	 11297: _L_z04_UpdateLamnola_Draw:
02:0003D0B0 4EB900030B2E    	 11298:     jsr     Anim_WriteSprite
02:0003D0B6 101D            	 11299:     move.b  (A5)+,D0  ; PLA
02:0003D0B8 19802070        	 11300:     move.b  D0,($70,A4,D2.W)
02:0003D0BC 41EC0098        	 11301:     lea     ($0098,A4),A0
02:0003D0C0 10302000        	 11302:     move.b  (A0,D2.W),D0
02:0003D0C4 1B00            	 11303:     move.b  D0,-(A5)  ; PHA
02:0003D0C6 4EB900030B9E    	 11304:     jsr     CheckMonsterCollisions
02:0003D0CC 101D            	 11305:     move.b  (A5)+,D0  ; PLA
02:0003D0CE 41EC0098        	 11306:     lea     ($0098,A4),A0
02:0003D0D2 11802000        	 11307:     move.b  D0,(A0,D2.W)
                            	 11308:     ; If still alive, then return.
                            	 11309:     ;
02:0003D0D6 41EC0405        	 11310:     lea     ($0405,A4),A0
02:0003D0DA 10302000        	 11311:     move.b  (A0,D2.W),D0
02:0003D0DE 6604            	 11312:     bne.s  __far_z_04_0109
02:0003D0E0 6000FF72        	 11313:     jmp  L129EA_Exit
                            	 11314: __far_z_04_0109:
                            	 11315:     ; Otherwise, the segment is dead.
                            	 11316:     ;
02:0003D0E4 4EB900049936    	 11317:     jsr     ResetShoveInfo
                            	 11318:     ; Set the current segment's HP to the initial value in anticipation
                            	 11319:     ; of bringing this segment back to life.
                            	 11320:     ;
02:0003D0EA 7020            	 11321:     moveq   #32,D0
02:0003D0EC 41EC0485        	 11322:     lea     ($0485,A4),A0
02:0003D0F0 11802000        	 11323:     move.b  D0,(A0,D2.W)
                            	 11324:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11325:     ;
                            	 11326:     ; From the lowest slot, look for one that has the original lamnola
                            	 11327:     ; object type.
                            	 11328:     ;
                            	 11329:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11330:     ;
02:0003D0F4 163C00FF        	 11331:     move.b  #$FF,D3
02:0003D0F8 0C020006        	 11332:     cmpi.b  #$06,D2
02:0003D0FC 6502            	 11333:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003D0FE 7604            	 11334:     moveq   #4,D3
                            	 11335:     even
                            	 11336: _L_z04_UpdateLamnola_FindTail:
02:0003D100 5203            	 11337:     addq.b  #1,D3
02:0003D102 41EC0350        	 11338:     lea     ($0350,A4),A0
02:0003D106 10303000        	 11339:     move.b  (A0,D3.W),D0
02:0003D10A 122C04E7        	 11340:     move.b  ($04E7,A4),D1
02:0003D10E B001            	 11341:     cmp.b   D1,D0
02:0003D110 66EE            	 11342:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11343:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11344:     ;
02:0003D112 7011            	 11345:     moveq   #17,D0
02:0003D114 19803029        	 11346:     move.b  D0,($29,A4,D3.W)
                            	 11347:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11348:     ; to the tail segment.
                            	 11349:     ;
02:0003D118 41EC04F0        	 11350:     lea     ($04F0,A4),A0
02:0003D11C 10302000        	 11351:     move.b  (A0,D2.W),D0
02:0003D120 41EC04F1        	 11352:     lea     ($04F1,A4),A0
02:0003D124 11803000        	 11353:     move.b  D0,(A0,D3.W)
02:0003D128 10342070        	 11354:     move.b  ($70,A4,D2.W),D0
02:0003D12C 19803071        	 11355:     move.b  D0,($71,A4,D3.W)
02:0003D130 41EC0084        	 11356:     lea     ($0084,A4),A0
02:0003D134 10302000        	 11357:     move.b  (A0,D2.W),D0
02:0003D138 41EC0085        	 11358:     lea     ($0085,A4),A0
02:0003D13C 11803000        	 11359:     move.b  D0,(A0,D3.W)
                            	 11360:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11361:     ; So, return and leave it dead.
                            	 11362:     ;
02:0003D140 0C030004        	 11363:     cmpi.b  #$04,D3
02:0003D144 6604            	 11364:     bne.s  __far_z_04_0110
02:0003D146 6000FF0C        	 11365:     jmp  L129EA_Exit
                            	 11366: __far_z_04_0110:
02:0003D14A 0C030009        	 11367:     cmpi.b  #$09,D3
02:0003D14E 6604            	 11368:     bne.s  __far_z_04_0111
02:0003D150 6000FF02        	 11369:     jmp  L129EA_Exit
                            	 11370: __far_z_04_0111:
                            	 11371:     ; Change the tail segment to the dead dummy object, and
                            	 11372:     ; bring the current segment back to life.
                            	 11373:     ;
02:0003D154 705D            	 11374:     moveq   #93,D0
02:0003D156 41EC0350        	 11375:     lea     ($0350,A4),A0
02:0003D15A 11803000        	 11376:     move.b  D0,(A0,D3.W)
02:0003D15E 4EF90004B77C    	 11377:     jmp     ResetObjMetastate
                            	 11378: 
                            	 11379:     even
                            	 11380: L12A6F_Exit:
02:0003D164 4E75            	 11381:     rts
                            	 11382: 
                            	 11383:     even
                            	 11384: Lamnola_UpdateHead:
                            	 11385:     ; If X coordinate is not a multiple of 8, then return.
                            	 11386:     ;
02:0003D166 10342070        	 11387:     move.b  ($70,A4,D2.W),D0
02:0003D16A 02000007        	 11388:     andi.b #$07,D0
02:0003D16E 6702            	 11389:     beq.s  __far_z_04_0112
02:0003D170 60F2            	 11390:     jmp  L12A6F_Exit
                            	 11391: __far_z_04_0112:
                            	 11392:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11393:     ; We had to account for the usual offset of 3.
                            	 11394:     ;
02:0003D172 41EC0084        	 11395:     lea     ($0084,A4),A0
02:0003D176 10302000        	 11396:     move.b  (A0,D2.W),D0
02:0003D17A 023C00EE        	 11397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D17E 123C0003        	 11398:     move.b  #$03,D1
02:0003D182 D101            	 11399:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D184 02000007        	 11400:     andi.b #$07,D0
02:0003D188 6702            	 11401:     beq.s  __far_z_04_0113
02:0003D18A 60D8            	 11402:     jmp  L12A6F_Exit
                            	 11403: __far_z_04_0113:
                            	 11404:     ; Will loop 4 times, propagating directions down the chain,
                            	 11405:     ; by pulling from the bottom.
                            	 11406:     ;
02:0003D18C 7004            	 11407:     moveq   #4,D0
02:0003D18E 1880            	 11408:     move.b  D0,($0000,A4)
                            	 11409:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11410:     ;
02:0003D190 7600            	 11411:     moveq   #0,D3
02:0003D192 0C020005        	 11412:     cmpi.b  #$05,D2
02:0003D196 6702            	 11413:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003D198 7605            	 11414:     moveq   #5,D3
                            	 11415:     even
                            	 11416: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11417:     ; Loop over every segment under the head, starting from the tail.
                            	 11418:     ; Copy the next segment's direction to the current one in this loop.
                            	 11419:     ;
02:0003D19A 41EC009A        	 11420:     lea     ($009A,A4),A0
02:0003D19E 10303000        	 11421:     move.b  (A0,D3.W),D0
02:0003D1A2 41EC0099        	 11422:     lea     ($0099,A4),A0
02:0003D1A6 11803000        	 11423:     move.b  D0,(A0,D3.W)
02:0003D1AA 5203            	 11424:     addq.b  #1,D3
02:0003D1AC 5314            	 11425:     subq.b  #1,($0000,A4)
02:0003D1AE 66EA            	 11426:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11427:     ; If this head segment is not aligned with a square, then return.
                            	 11428:     ;
02:0003D1B0 10342070        	 11429:     move.b  ($70,A4,D2.W),D0
02:0003D1B4 0200000F        	 11430:     andi.b #$0F,D0
02:0003D1B8 660000BA        	 11431:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11432:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11433:     ; We had to account for the usual offset of 3.
                            	 11434:     ;
02:0003D1BC 41EC0084        	 11435:     lea     ($0084,A4),A0
02:0003D1C0 10302000        	 11436:     move.b  (A0,D2.W),D0
02:0003D1C4 023C00EE        	 11437:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1C8 123C0003        	 11438:     move.b  #$03,D1
02:0003D1CC D101            	 11439:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D1CE 0200000F        	 11440:     andi.b #$0F,D0
02:0003D1D2 660000A0        	 11441:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11442:     ; Store the opposite of the facing direction in [00].
                            	 11443:     ;
02:0003D1D6 41EC0098        	 11444:     lea     ($0098,A4),A0
02:0003D1DA 10302000        	 11445:     move.b  (A0,D2.W),D0
02:0003D1DE E208            	 11446:     lsr.b  #1,D0   ; LSR A
02:0003D1E0 02000005        	 11447:     andi.b #$05,D0
02:0003D1E4 1880            	 11448:     move.b  D0,($0000,A4)
02:0003D1E6 41EC0098        	 11449:     lea     ($0098,A4),A0
02:0003D1EA 10302000        	 11450:     move.b  (A0,D2.W),D0
02:0003D1EE E308            	 11451:     lsl.b  #1,D0   ; ASL A
02:0003D1F0 0200000A        	 11452:     andi.b #$0A,D0
02:0003D1F4 1214            	 11453:     move.b  ($0000,A4),D1
02:0003D1F6 8001            	 11454:     or.b  D1,D0
                            	 11455:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11456:     ;
02:0003D1F8 0A00000F        	 11457:     eori.b #$0F,D0
02:0003D1FC 1940050F        	 11458:     move.b  D0,($050F,A4)
                            	 11459:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11460:     ;
02:0003D200 10342018        	 11461:     move.b  ($18,A4,D2.W),D0
02:0003D204 0C000080        	 11462:     cmpi.b  #$80,D0
02:0003D208 656C            	 11463:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11464:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11465:     ; Load the monster's facing direction.
                            	 11466:     ;
02:0003D20A 41EC0098        	 11467:     lea     ($0098,A4),A0
02:0003D20E 10302000        	 11468:     move.b  (A0,D2.W),D0
                            	 11469:     ; Load the next random number into Y register.
                            	 11470:     ;
02:0003D212 7600            	 11471:     moveq   #0,D3
02:0003D214 16342019        	 11472:     move.b  ($19,A4,D2.W),D3
                            	 11473:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11474:     ; to keep moving straight.
                            	 11475:     ;
02:0003D218 0C030080        	 11476:     cmpi.b  #$80,D3
02:0003D21C 6418            	 11477:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11478:     even
                            	 11479: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11480:     ; Loop to rotate the direction bit over the mask.
                            	 11481:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11482:     ; facing direction.
                            	 11483:     ;
                            	 11484:     ; Shift right the copy of the direction.
                            	 11485:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11486:     ;
02:0003D21E E208            	 11487:     lsr.b  #1,D0   ; LSR A
02:0003D220 6402            	 11488:     bcc  _anon_z04_151
02:0003D222 7008            	 11489:     moveq   #8,D0
                            	 11490: _anon_z04_151:
                            	 11491:     ; If the current direction bit is masked off, then we've reached
                            	 11492:     ; the opposite direction. Loop again.
                            	 11493:     ;
02:0003D224 122C050F        	 11494:     move.b  ($050F,A4),D1
02:0003D228 C200            	 11495:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D22A 67F2            	 11496:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11497:     ; If Y register >= $40, then break out of the loop.
                            	 11498:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11499:     ;
02:0003D22C 0C030040        	 11500:     cmpi.b  #$40,D3
02:0003D230 6404            	 11501:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11502:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11503:     ; and loop again now.
                            	 11504:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11505:     ;
02:0003D232 7640            	 11506:     moveq   #64,D3
02:0003D234 65E8            	 11507:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11508:     even
                            	 11509: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11510:     ; Change the facing direction to the direction found.
                            	 11511:     ;
02:0003D236 41EC0098        	 11512:     lea     ($0098,A4),A0
02:0003D23A 11802000        	 11513:     move.b  D0,(A0,D2.W)
                            	 11514:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11515:     ;
02:0003D23E 1940000F        	 11516:     move.b  D0,($000F,A4)
02:0003D242 4EB900030452    	 11517:     jsr     BoundByRoom
                            	 11518:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11519:     ;
02:0003D248 102C000F        	 11520:     move.b  ($000F,A4),D0
02:0003D24C 6618            	 11521:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11522:     even
                            	 11523: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11524:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11525:     ; for looking for any non-opposite direction that is not blocked.
                            	 11526:     ;
02:0003D24E 41EC0098        	 11527:     lea     ($0098,A4),A0
02:0003D252 10302000        	 11528:     move.b  (A0,D2.W),D0
                            	 11529:     even
                            	 11530: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11531:     ; Shift right the copy of the direction.
                            	 11532:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11533:     ;
02:0003D256 E208            	 11534:     lsr.b  #1,D0   ; LSR A
02:0003D258 6402            	 11535:     bcc  _anon_z04_152
02:0003D25A 7008            	 11536:     moveq   #8,D0
                            	 11537: _anon_z04_152:
                            	 11538:     ; If the current direction bit is not masked off, then go check the
                            	 11539:     ; room boundary in this direction.
                            	 11540:     ; Else we've reached the opposite direction. Loop again.
                            	 11541:     ;
02:0003D25C 122C050F        	 11542:     move.b  ($050F,A4),D1
02:0003D260 C200            	 11543:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D262 66D2            	 11544:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003D264 67F0            	 11545:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11546:     even
                            	 11547: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11548:     ; We found a direction that was not blocked by the room boundary.
                            	 11549:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11550:     ;
02:0003D266 4EB9000498C2    	 11551:     jsr     GetCollidingTileMoving
02:0003D26C 122C034A        	 11552:     move.b  ($034A,A4),D1
02:0003D270 B001            	 11553:     cmp.b   D1,D0
02:0003D272 64DA            	 11554:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11555:     even
                            	 11556: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11557:     ; TODO: confirm this
                            	 11558:     ;
                            	 11559:     ; If there were a room that had lamnolas, and they could get
                            	 11560:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11561:     ; an infinite loop.
                            	 11562:     ;
                            	 11563:     ; But, the only room with that configuration has those blocks
                            	 11564:     ; blocked off with a push block, which can only be pushed after
                            	 11565:     ; all monsters are killed.
                            	 11566:     ;
02:0003D274 4E75            	 11567:     rts
                            	 11568: 
                            	 11569:     even
                            	 11570: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11571:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11572:     ;
02:0003D276 7001            	 11573:     moveq   #1,D0
02:0003D278 19400002        	 11574:     move.b  D0,($0002,A4)
02:0003D27C 102C0070        	 11575:     move.b  ($0070,A4),D0
02:0003D280 003C0011        	 11576:     ori     #$11,CCR  ; SEC: set C+X
02:0003D284 12342070        	 11577:     move.b  ($70,A4,D2.W),D1
02:0003D288 0A3C0010        	 11578:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D28C 9101            	 11579:     subx.b  D1,D0   ; SBC ObjX,X
02:0003D28E 0A3C0010        	 11580:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D292 640A            	 11581:     bcc  _anon_z04_153
02:0003D294 122C0002        	 11582:     move.b  ($0002,A4),D1
02:0003D298 E309            	 11583:     lsl.b  #1,D1   ; ASL $02
02:0003D29A 19410002        	 11584:     move.b  D1,($0002,A4)
                            	 11585: _anon_z04_153:
                            	 11586:     ; Find the vertical direction toward Link and store it in [03].
                            	 11587:     ;
02:0003D29E 7004            	 11588:     moveq   #4,D0
02:0003D2A0 19400003        	 11589:     move.b  D0,($0003,A4)
02:0003D2A4 102C0084        	 11590:     move.b  ($0084,A4),D0
02:0003D2A8 003C0011        	 11591:     ori     #$11,CCR  ; SEC: set C+X
02:0003D2AC 41EC0084        	 11592:     lea     ($0084,A4),A0
02:0003D2B0 12302000        	 11593:     move.b  (A0,D2.W),D1
02:0003D2B4 0A3C0010        	 11594:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D2B8 9101            	 11595:     subx.b  D1,D0   ; SBC ObjY,X
02:0003D2BA 0A3C0010        	 11596:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D2BE 640A            	 11597:     bcc  _anon_z04_154
02:0003D2C0 122C0003        	 11598:     move.b  ($0003,A4),D1
02:0003D2C4 E309            	 11599:     lsl.b  #1,D1   ; ASL $03
02:0003D2C6 19410003        	 11600:     move.b  D1,($0003,A4)
                            	 11601: _anon_z04_154:
                            	 11602:     ; If the horizontal direction toward Link is not allowed, then
                            	 11603:     ; go check the vertical direction.
                            	 11604:     ;
02:0003D2CA 102C0002        	 11605:     move.b  ($0002,A4),D0
02:0003D2CE 122C050F        	 11606:     move.b  ($050F,A4),D1
02:0003D2D2 C200            	 11607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D2D4 6708            	 11608:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11609:     ; If the horizontal direction toward Link is the same direction
                            	 11610:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11611:     ;
02:0003D2D6 122C0098        	 11612:     move.b  ($0098,A4),D1
02:0003D2DA C200            	 11613:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D2DC 6604            	 11614:     bne  _anon_z04_155
                            	 11615:     even
                            	 11616: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11617:     ; Load the vertical direction toward Link in order to test it for
                            	 11618:     ; room boundary and tile collision.
                            	 11619:     ;
02:0003D2DE 102C0003        	 11620:     move.b  ($0003,A4),D0
                            	 11621: _anon_z04_155:
                            	 11622:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11623:     ;
02:0003D2E2 6000FF52        	 11624:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11625: 
                            	 11626:     even
                            	 11627: Lamnola_Move:
                            	 11628:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11629:     ;
                            	 11630:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11631:     ;
                            	 11632:     ; Start with a mask of $A1 in [02]:
                            	 11633:     ; - low nibble represents the right direction
                            	 11634:     ; - high nibble is used to set or clear carry as we go along
                            	 11635:     ;
02:0003D2E6 103C00A1        	 11636:     move.b  #$A1,D0
02:0003D2EA 19400002        	 11637:     move.b  D0,($0002,A4)
                            	 11638:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11639:     ;
02:0003D2EE 41EC0098        	 11640:     lea     ($0098,A4),A0
02:0003D2F2 10302000        	 11641:     move.b  (A0,D2.W),D0
02:0003D2F6 122C0002        	 11642:     move.b  ($0002,A4),D1
02:0003D2FA C200            	 11643:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D2FC 6712            	 11644:     beq  _L_z04_Lamnola_Move_Left
02:0003D2FE 10342070        	 11645:     move.b  ($70,A4,D2.W),D0
