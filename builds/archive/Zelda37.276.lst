                            	  1988: __far_z_04_0017:
02:00038C82 61000592        	  1989:     jsr     UpdateBurrower
                            	  1990:     ; If zora died in the call above, then it happened while in
                            	  1991:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  1992:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  1993:     ; not come back after killing it.
                            	  1994:     ;
                            	  1995:     ; If state <> 3 or timer <> $FD,
                            	  1996:     ; then go see if the object needs to be destroyed.
                            	  1997:     ;
02:00038C86 41EC00AC        	  1998:     lea     ($00AC,A4),A0
02:00038C8A 10302000        	  1999:     move.b  (A0,D2.W),D0
02:00038C8E 0C000003        	  2000:     cmpi.b  #$03,D0
02:00038C92 6616            	  2001:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:00038C94 10342028        	  2002:     move.b  ($28,A4,D2.W),D0
02:00038C98 0C0000FD        	  2003:     cmpi.b  #$FD,D0
02:00038C9C 660C            	  2004:     bne  _L_z04_UpdateZora_DestroyWhenDone
