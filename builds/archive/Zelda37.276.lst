                            	  3439:     ; Note that this is the frame image to use, even if there's no
                            	  3440:     ; down component in the direction.
                            	  3441:     ;
02:000396C0 522C000D        	  3442:     addq.b  #1,($000D,A4)
                            	  3443:     ; If right is a component of the direction, then go set horizontal
                            	  3444:     ; flipping. Else leave horizontal flipping = 0.
                            	  3445:     ;
02:000396C4 41EC0098        	  3446:     lea     ($0098,A4),A0
02:000396C8 10302000        	  3447:     move.b  (A0,D2.W),D0
02:000396CC 02000001        	  3448:     andi.b #$01,D0
02:000396D0 6714            	  3449:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:000396D2 660E            	  3450:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3451:     even
