02:0004AD94 9101            	  6581:     subx.b  D1,D0   ; SBC ObjY,X
02:0004AD96 0A3C0010        	  6582:     eori    #$10,CCR  ; restore X = 6502 C
02:0004AD9A 4EB900030466    	  6583:     jsr     Abs
