02:0003D5DC 4EB90002AECA    	 12019:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	 12020:     even
                            	 12021: UpdateGanon_JumpTable:
02:0003D5E2 0003D5EE        	 12022:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003D5E6 0003D650        	 12023:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003D5EA 0003D67E        	 12024:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12025: 
                            	 12026: ; Description:
                            	 12027: ; Lift up the Triforce of Courage while the room is dark.
                            	 12028: ;
                            	 12029: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12030: ;
                            	 12031:     even
                            	 12032: Ganon_ScenePhase0:
02:0003D5EE 701B            	 12033:     moveq   #27,D0
02:0003D5F0 19400505        	 12034:     move.b  D0,($0505,A4)
                            	 12035:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12036:     ;
02:0003D5F4 102C0028        	 12037:     move.b  ($0028,A4),D0
02:0003D5F8 6644            	 12038:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12039:     ; Once the timer expires, it's time to brighten the room.
                            	 12040:     ;
                            	 12041:     ; Save the current object slot.
02:0003D5FA 1002            	 12042:     move.b  D2,D0
02:0003D5FC 1B00            	 12043:     move.b  D0,-(A5)  ; PHA
02:0003D5FE 610007F0        	 12044:     jsr     UpdateCandle
02:0003D602 101D            	 12045:     move.b  (A5)+,D0  ; PLA
02:0003D604 7400            	 12046:     moveq   #0,D2
02:0003D606 1400            	 12047:     move.b  D0,D2
                            	 12048:     ; Turn off the room brightening flag, because we're controlling it
                            	 12049:     ; here instead of in the Mode 5 object update loop.
                            	 12050:     ;
02:0003D608 7000            	 12051:     moveq   #0,D0
02:0003D60A 1940051E        	 12052:     move.b  D0,($051E,A4)
                            	 12053:     ; On the first frame of the fade-to-light cycle, play the
                            	 12054:     ; Triforce/Ganon song.
                            	 12055:     ;
02:0003D60E 102C051C        	 12056:     move.b  ($051C,A4),D0
02:0003D612 0C0000C0        	 12057:     cmpi.b  #$C0,D0
02:0003D616 6606            	 12058:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003D618 7002            	 12059:     moveq   #2,D0
02:0003D61A 19400600        	 12060:     move.b  D0,($0600,A4)
                            	 12061:     even
                            	 12062: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12063:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12064:     ;
02:0003D61E 102C051C        	 12065:     move.b  ($051C,A4),D0
02:0003D622 0200000F        	 12066:     andi.b #$0F,D0
02:0003D626 0C000004        	 12067:     cmpi.b  #$04,D0
02:0003D62A 6702            	 12068:     beq.s  __far_z_04_0115
02:0003D62C 6042            	 12069:     jmp  Ganon_DrawBodyFrame0
                            	 12070: __far_z_04_0115:
                            	 12071:     ; Set Link's timer to $C0 for the next scene phase.
                            	 12072:     ;
02:0003D62E 103C00C0        	 12073:     move.b  #$C0,D0
02:0003D632 19400028        	 12074:     move.b  D0,($0028,A4)
                            	 12075:     ; Set scene phase 1, and go draw Ganon.
                            	 12076:     ;
02:0003D636 522C0445        	 12077:     addq.b  #1,($0445,A4)
02:0003D63A 6702            	 12078:     beq.s  __far_z_04_0116
02:0003D63C 6032            	 12079:     jmp  Ganon_DrawBodyFrame0
                            	 12080: __far_z_04_0116:
                            	 12081:     even
                            	 12082: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 12083:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 12084:     ; In this case, I think it means Ganon is shouting.
                            	 12085:     ;
02:0003D63E 0C000001        	 12086:     cmpi.b  #$01,D0
02:0003D642 6606            	 12087:     bne  _anon_z04_160
02:0003D644 7002            	 12088:     moveq   #2,D0
02:0003D646 19400601        	 12089:     move.b  D0,($0601,A4)
                            	 12090: _anon_z04_160:
02:0003D64A 0A3C0001        	 12091:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D64E 4E75            	 12092:     rts
                            	 12093: 
                            	 12094: ; Description:
                            	 12095: ; Lift up the Triforce of Courage while the room is light.
                            	 12096: ;
                            	 12097: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12098: ;
                            	 12099:     even
                            	 12100: Ganon_ScenePhase1:
02:0003D650 701B            	 12101:     moveq   #27,D0
02:0003D652 19400505        	 12102:     move.b  D0,($0505,A4)
                            	 12103:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12104:     ;
