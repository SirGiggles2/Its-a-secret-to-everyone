02:0003B3B0 10302000        	  7491:     move.b  (A0,D2.W),D0
02:0003B3B4 0A00000C        	  7492:     eori.b #$0C,D0
02:0003B3B8 41EC0098        	  7493:     lea     ($0098,A4),A0
02:0003B3BC 11802000        	  7494:     move.b  D0,(A0,D2.W)
02:0003B3C0 6000008C        	  7495:     jmp     L_PolsVoice_DrawAndCheckCollisions
