                            	 12603: Ganon_CheckCollisions:
                            	 12604:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12605:     ; Store in [02] and [03].
                            	 12606:     ;
02:0003D9E4 10342070        	 12607:     move.b  ($70,A4,D2.W),D0
02:0003D9E8 023C00EE        	 12608:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D9EC 123C0010        	 12609:     move.b  #$10,D1
02:0003D9F0 D101            	 12610:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D9F2 19400002        	 12611:     move.b  D0,($0002,A4)
02:0003D9F6 41EC0084        	 12612:     lea     ($0084,A4),A0
02:0003D9FA 10302000        	 12613:     move.b  (A0,D2.W),D0
02:0003D9FE 023C00EE        	 12614:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DA02 123C0010        	 12615:     move.b  #$10,D1
02:0003DA06 D101            	 12616:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003DA08 19400003        	 12617:     move.b  D0,($0003,A4)
                            	 12618:     ; Check for a collision with Link.
                            	 12619:     ;
                            	 12620:     ; We can't call CheckLinkCollision, because we need to
                            	 12621:     ; customize Ganon's midpoint.
                            	 12622:     ;
                            	 12623:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12624:     ; detection, if Link is invincible. Initialize variables that will
                            	 12625:     ; be returned from the partial collision check routine. Then
                            	 12626:     ; call it.
                            	 12627:     ;
02:0003DA0C 102C04F0        	 12628:     move.b  ($04F0,A4),D0
02:0003DA10 6616            	 12629:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003DA12 19400006        	 12630:     move.b  D0,($0006,A4)
02:0003DA16 19400009        	 12631:     move.b  D0,($0009,A4)
02:0003DA1A 1940000C        	 12632:     move.b  D0,($000C,A4)
02:0003DA1E 7600            	 12633:     moveq   #0,D3
02:0003DA20 1883            	 12634:     move.b  D3,($0000,A4)
02:0003DA22 4EB900030C08    	 12635:     jsr     CheckLinkCollisionPreinit
                            	 12636:     even
                            	 12637: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12638:     ; If Ganon is not in state 0, then he's brown.
                            	 12639:     ; Go check collision with an arrow.
                            	 12640:     ;
02:0003DA28 41EC00AC        	 12641:     lea     ($00AC,A4),A0
02:0003DA2C 10302000        	 12642:     move.b  (A0,D2.W),D0
02:0003DA30 6652            	 12643:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12644:     ; If timer <> 0, then Ganon is visible.
                            	 12645:     ; He can't be harmed like this. So, return.
                            	 12646:     ;
02:0003DA32 10342028        	 12647:     move.b  ($28,A4,D2.W),D0
