02:0004A1FA 60000082        	  4936:     jmp  SetShotSpreadingState
                            	  4937: __far_z_07_0074:
                            	  4938:     ; This is a magic shot.
                            	  4939:     ;
                            	  4940:     ; If missing the magic book, go deactivate the shot object.
                            	  4941:     ;
02:0004A1FE 102C0661        	  4942:     move.b  ($0661,A4),D0
02:0004A202 6602            	  4943:     bne.s  __far_z_07_0075
02:0004A204 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:0004A206 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:0004A20A 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004A20C 102C0513        	  4956:     move.b  ($0513,A4),D0
02:0004A210 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:0004A212 7000            	  4958:     moveq   #0,D0
02:0004A214 19400513        	  4959:     move.b  D0,($0513,A4)
02:0004A218 4EB9000304BC    	  4960:     jsr     WieldCandle
02:0004A21E 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004A220 19400513        	  4962:     move.b  D0,($0513,A4)
02:0004A224 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:0004A226 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:0004A22A 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:0004A22E 10302000        	  4972:     move.b  (A0,D2.W),D0
02:0004A232 0C000021        	  4973:     cmpi.b  #$21,D0
02:0004A236 6702            	  4974:     beq.s  __far_z_07_0076
02:0004A238 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
                            	  4978:     ;
02:0004A23A 41EC00AC        	  4979:     lea     ($00AC,A4),A0
02:0004A23E 52302000        	  4980:     addq.b  #1,(A0,D2.W)
                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:0004A242 760E            	  4983:     moveq   #14,D3
02:0004A244 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:0004A248 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:0004A24C 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004A250 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004A254 41EC0084        	  4988:     lea     ($0084,A4),A0
02:0004A258 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:0004A25C 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004A260 10303000        	  4991:     move.b  (A0,D3.W),D0
02:0004A264 41EC0098        	  4992:     lea     ($0098,A4),A0
02:0004A268 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
                            	  4996:     ;
02:0004A26C 704F            	  4997:     moveq   #79,D0
02:0004A26E 19802028        	  4998:     move.b  D0,($28,A4,D2.W)
                            	  4999:     even
                            	  5000: DeactivateLinkShot:
