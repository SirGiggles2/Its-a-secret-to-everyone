                            	 12540: Ganon_DrawBody:
                            	 12541:     ; Loop over four 16x16 images that make up Ganon.
                            	 12542:     ; There are 6 animation frames.
                            	 12543:     ;
02:0003D968 7603            	 12544:     moveq   #3,D3
                            	 12545:     even
                            	 12546: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12547:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12548:     ;
02:0003D96A 10342070        	 12549:     move.b  ($70,A4,D2.W),D0
02:0003D96E 023C00EE        	 12550:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D972 41F90003D95C    	 12551:     lea     (GanonSpriteOffsetsX).l,A0
02:0003D978 12303000        	 12552:     move.b  (A0,D3.W),D1
02:0003D97C D101            	 12553:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003D97E 1880            	 12554:     move.b  D0,($0000,A4)
                            	 12555:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12556:     ;
02:0003D980 41EC0084        	 12557:     lea     ($0084,A4),A0
02:0003D984 10302000        	 12558:     move.b  (A0,D2.W),D0
02:0003D988 023C00EE        	 12559:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D98C 41F90003D960    	 12560:     lea     (GanonSpriteOffsetsY).l,A0
02:0003D992 12303000        	 12561:     move.b  (A0,D3.W),D1
02:0003D996 D101            	 12562:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003D998 19400001        	 12563:     move.b  D0,($0001,A4)
                            	 12564:     ; Each part has a horizontal flipping flag.
                            	 12565:     ;
02:0003D99C 41F90003D964    	 12566:     lea     (GanonSpriteHFlips).l,A0
02:0003D9A2 10303000        	 12567:     move.b  (A0,D3.W),D0
02:0003D9A6 1940000F        	 12568:     move.b  D0,($000F,A4)
                            	 12569:     ; Save and copy the loop index (the current part) to [07].
                            	 12570:     ;
02:0003D9AA 1003            	 12571:     move.b  D3,D0
02:0003D9AC 1B00            	 12572:     move.b  D0,-(A5)  ; PHA
02:0003D9AE 19400007        	 12573:     move.b  D0,($0007,A4)
                            	 12574:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12575:     ; that make it up.
                            	 12576:     ;
02:0003D9B2 41EC046B        	 12577:     lea     ($046B,A4),A0
02:0003D9B6 10302000        	 12578:     move.b  (A0,D2.W),D0
02:0003D9BA E308            	 12579:     lsl.b  #1,D0   ; ASL A
02:0003D9BC E308            	 12580:     lsl.b  #1,D0   ; ASL A
                            	 12581:     ; Add [07] -- the index of the current part.
                            	 12582:     ;
                            	 12583:     ; Now you have an index into the frame image table, for the
                            	 12584:     ; current image part of the current animation frame.
                            	 12585:     ;
02:0003D9BE 122C0007        	 12586:     move.b  ($0007,A4),D1
02:0003D9C2 D101            	 12587:     addx.b  D1,D0   ; ADC $07
02:0003D9C4 7600            	 12588:     moveq   #0,D3
02:0003D9C6 1600            	 12589:     move.b  D0,D3
02:0003D9C8 41F90003D944    	 12590:     lea     (GanonFrameImages).l,A0
02:0003D9CE 10303000        	 12591:     move.b  (A0,D3.W),D0
02:0003D9D2 4EB900030832    	 12592:     jsr     DrawObjectNotMirrored
02:0003D9D8 101D            	 12593:     move.b  (A5)+,D0  ; PLA
                            	 12594:     ; Bottom of the part loop.
                            	 12595:     ;
02:0003D9DA 7600            	 12596:     moveq   #0,D3
02:0003D9DC 1600            	 12597:     move.b  D0,D3
02:0003D9DE 5303            	 12598:     subq.b  #1,D3
02:0003D9E0 6A88            	 12599:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003D9E2 4E75            	 12600:     rts
