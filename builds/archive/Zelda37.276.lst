02:0003B464 103C00FE        	  7579:     move.b  #$FE,D0
02:0003B468 41EC04B2        	  7580:     lea     ($04B2,A4),A0
02:0003B46C 11802000        	  7581:     move.b  D0,(A0,D2.W)
02:0003B470 4EB900030B9E    	  7582:     jsr     CheckMonsterCollisions
