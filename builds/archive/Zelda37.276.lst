                            	  5555: __far_z_04_0041:
                            	  5556:     even
                            	  5557: Moldorm_ChangeFlyingState:
                            	  5558:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5559:     ;
02:0003A62C 61000096        	  5560:     jsr     Flyer_MoldormDecideState
02:0003A630 7010            	  5561:     moveq   #16,D0
02:0003A632 19802028        	  5562:     move.b  D0,($28,A4,D2.W)
                            	  5563:     ; If the next lower slot's direction <> 0, then
                            	  5564:     ; go propagate direction changes down the chain.
                            	  5565:     ;
                            	  5566:     ; But you had to have propagated directions once for the
                            	  5567:     ; next lower direction to be set. How does it happen?
                            	  5568:     ;
                            	  5569:     ; Within a flyer state, the flying routines turn the flyer
                            	  5570:     ; and set the object timer to $10 several times. After any of
                            	  5571:     ; those times will the test succeed.
                            	  5572:     ;
                            	  5573:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5574:     ; in this block to set the timer to $10, and try to propagate
                            	  5575:     ; directions.
                            	  5576:     ;
                            	  5577:     ; But this is also the case the first time here.
                            	  5578:     ;
                            	  5579:     ; So, I believe that the point of this test is to delay moving
                            	  5580:     ; the lower (not head) segments when starting out.
                            	  5581:     ;
02:0003A636 41EC0097        	  5582:     lea     ($0097,A4),A0
02:0003A63A 10302000        	  5583:     move.b  (A0,D2.W),D0
02:0003A63E 6702            	  5584:     beq.s  __far_z_04_0042
02:0003A640 601C            	  5585:     jmp  Moldorm_PropagateDirs
                            	  5586: __far_z_04_0042:
02:0003A642 4E75            	  5587:     rts
                            	  5588: 
                            	  5589:     even
                            	  5590: Moldorm_Wander:
                            	  5591:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5592:     ; Only the head controls the movement direction.
                            	  5593:     ;
02:0003A644 0C020005        	  5594:     cmpi.b  #$05,D2
02:0003A648 6708            	  5595:     beq  _anon_z04_82
02:0003A64A 0C02000A        	  5596:     cmpi.b  #$0A,D2
