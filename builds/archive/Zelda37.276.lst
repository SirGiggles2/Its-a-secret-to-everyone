02:0003C2C6 52302000        	  9472:     addq.b  #1,(A0,D2.W)
                            	  9473:     ; Set a direction mask in [02], starting with right (1).
                            	  9474:     ;
02:0003C2CA 7001            	  9475:     moveq   #1,D0
02:0003C2CC 19400002        	  9476:     move.b  D0,($0002,A4)
                            	  9477:     ; If Gohma's facing direction has a right component, then add 1 to X.
