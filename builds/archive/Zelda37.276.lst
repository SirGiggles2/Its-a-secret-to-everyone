                            	 11975:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 11976:     ; for both Y and X increment calculations in rotation. This leads to
                            	 11977:     ; a small circle (5) and a large circle (6).
                            	 11978:     ;
02:0003D586 41F90003D45C    	 11979:     lea     (PatraChild2RotationBits).l,A0
