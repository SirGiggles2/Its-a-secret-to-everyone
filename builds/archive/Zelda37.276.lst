                            	  7586: UpdatePolsVoiceState1_Jumping:
                            	  7587:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7588:     ;
02:0003B478 41EC0444        	  7589:     lea     ($0444,A4),A0
02:0003B47C 10302000        	  7590:     move.b  (A0,D2.W),D0
02:0003B480 023C00EE        	  7591:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B484 123C0038        	  7592:     move.b  #$38,D1
02:0003B488 D101            	  7593:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003B48A 41EC0444        	  7594:     lea     ($0444,A4),A0
02:0003B48E 11802000        	  7595:     move.b  D0,(A0,D2.W)
                            	  7596:     ; Add Carry to high speed byte (vertical).
                            	  7597:     ;
02:0003B492 41EC0412        	  7598:     lea     ($0412,A4),A0
02:0003B496 10302000        	  7599:     move.b  (A0,D2.W),D0
02:0003B49A 123C0000        	  7600:     move.b  #$00,D1
02:0003B49E D101            	  7601:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003B4A0 41EC0412        	  7602:     lea     ($0412,A4),A0
02:0003B4A4 11802000        	  7603:     move.b  D0,(A0,D2.W)
                            	  7604:     ; Add high speed byte to Y coordinate.
                            	  7605:     ;
02:0003B4A8 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B4AC 41EC0084        	  7607:     lea     ($0084,A4),A0
02:0003B4B0 12302000        	  7608:     move.b  (A0,D2.W),D1
02:0003B4B4 D101            	  7609:     addx.b  D1,D0   ; ADC ObjY,X
02:0003B4B6 41EC0084        	  7610:     lea     ($0084,A4),A0
02:0003B4BA 11802000        	  7611:     move.b  D0,(A0,D2.W)
                            	  7612:     ; If the speed is still negative, then return.
                            	  7613:     ;
02:0003B4BE 41EC0412        	  7614:     lea     ($0412,A4),A0
02:0003B4C2 10302000        	  7615:     move.b  (A0,D2.W),D0
02:0003B4C6 6B0000AC        	  7616:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7617:     ; If Y coordinate still < target Y, then return.
                            	  7618:     ;
02:0003B4CA 41EC0084        	  7619:     lea     ($0084,A4),A0
02:0003B4CE 10302000        	  7620:     move.b  (A0,D2.W),D0
02:0003B4D2 41EC042C        	  7621:     lea     ($042C,A4),A0
02:0003B4D6 12302000        	  7622:     move.b  (A0,D2.W),D1
02:0003B4DA B001            	  7623:     cmp.b   D1,D0
02:0003B4DC 65000096        	  7624:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7625:     ; Else reached the destination. Go to state 0.
                            	  7626:     ;
02:0003B4E0 7000            	  7627:     moveq   #0,D0
02:0003B4E2 41EC00AC        	  7628:     lea     ($00AC,A4),A0
02:0003B4E6 11802000        	  7629:     move.b  D0,(A0,D2.W)
                            	  7630:     ; Reset 16-bit vertical speed.
                            	  7631:     ;
02:0003B4EA 41EC0444        	  7632:     lea     ($0444,A4),A0
02:0003B4EE 11802000        	  7633:     move.b  D0,(A0,D2.W)
02:0003B4F2 41EC0412        	  7634:     lea     ($0412,A4),A0
02:0003B4F6 11802000        	  7635:     move.b  D0,(A0,D2.W)
                            	  7636:     ; Choose a random direction to face in.
                            	  7637:     ;
02:0003B4FA 10342018        	  7638:     move.b  ($18,A4,D2.W),D0
02:0003B4FE 02000003        	  7639:     andi.b #$03,D0
02:0003B502 7600            	  7640:     moveq   #0,D3
02:0003B504 1600            	  7641:     move.b  D0,D3
02:0003B506 41F90003B316    	  7642:     lea     (PolsVoiceDirections).l,A0
02:0003B50C 10303000        	  7643:     move.b  (A0,D3.W),D0
02:0003B510 41EC0098        	  7644:     lea     ($0098,A4),A0
02:0003B514 11802000        	  7645:     move.b  D0,(A0,D2.W)
                            	  7646:     ; Randomly set distance-to-move to $30 or $70.
                            	  7647:     ;
02:0003B518 10342018        	  7648:     move.b  ($18,A4,D2.W),D0
02:0003B51C 02000040        	  7649:     andi.b #$40,D0
02:0003B520 123C0030        	  7650:     move.b  #$30,D1
02:0003B524 D101            	  7651:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003B526 41EC0394        	  7652:     lea     ($0394,A4),A0
02:0003B52A 11802000        	  7653:     move.b  D0,(A0,D2.W)
                            	  7654:     ; Align the monster with a square horizontally.
                            	  7655:     ;
                            	  7656:     ; If in the left half of a square, align with that square.
                            	  7657:     ; If in the right half, align with the next square.
                            	  7658:     ;
02:0003B52E 10342070        	  7659:     move.b  ($70,A4,D2.W),D0
02:0003B532 023C00EE        	  7660:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B536 123C0008        	  7661:     move.b  #$08,D1
02:0003B53A D101            	  7662:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B53C 020000F0        	  7663:     andi.b #$F0,D0
02:0003B540 19802070        	  7664:     move.b  D0,($70,A4,D2.W)
                            	  7665:     ; Align the monster with a square vertically.
                            	  7666:     ;
                            	  7667:     ; If in the top half of a square, align with that square.
                            	  7668:     ; If in the bottom half, align with the next square.
                            	  7669:     ;
02:0003B544 41EC0084        	  7670:     lea     ($0084,A4),A0
02:0003B548 10302000        	  7671:     move.b  (A0,D2.W),D0
02:0003B54C 023C00EE        	  7672:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B550 123C0008        	  7673:     move.b  #$08,D1
02:0003B554 D101            	  7674:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B556 020000F0        	  7675:     andi.b #$F0,D0
                            	  7676:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7677:     ;
02:0003B55A 003C0011        	  7678:     ori     #$11,CCR  ; SEC: set C+X
02:0003B55E 123C0003        	  7679:     move.b  #$03,D1
02:0003B562 0A3C0010        	  7680:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B566 9101            	  7681:     subx.b  D1,D0   ; SBC #$03
02:0003B568 0A3C0010        	  7682:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B56C 41EC0084        	  7683:     lea     ($0084,A4),A0
02:0003B570 11802000        	  7684:     move.b  D0,(A0,D2.W)
                            	  7685:     even
