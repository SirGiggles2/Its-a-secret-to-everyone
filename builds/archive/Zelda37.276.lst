02:0003D8DC 102C0015        	 12472:     move.b  ($0015,A4),D0
02:0003D8E0 02000003        	 12473:     andi.b #$03,D0
02:0003D8E4 6704            	 12474:     beq  _anon_z04_164
                            	 12475:     even
