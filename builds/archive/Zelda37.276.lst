                            	  2919: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  2920:     ; Or else if is zora in state 1 or 5, then use one of
                            	  2921:     ; the mound frame images:
                            	  2922:     ;
                            	  2923:     ; frame image := ((state - 1) * 2) + movement frame
                            	  2924:     ;
                            	  2925:     ; This yields 0/1 or 8/9, depending on the state.
                            	  2926:     ;
                            	  2927:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  2928:     ;
02:000392F0 003C0011        	  2929:     ori     #$11,CCR  ; SEC: set C+X
02:000392F4 123C0001        	  2930:     move.b  #$01,D1
02:000392F8 0A3C0010        	  2931:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000392FC 9101            	  2932:     subx.b  D1,D0   ; SBC #$01
02:000392FE 0A3C0010        	  2933:     eori    #$10,CCR  ; restore X = 6502 C
02:00039302 E308            	  2934:     lsl.b  #1,D0   ; ASL A
02:00039304 023C00EE        	  2935:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039308 41EC03E4        	  2936:     lea     ($03E4,A4),A0
02:0003930C 12302000        	  2937:     move.b  (A0,D2.W),D1
02:00039310 D101            	  2938:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  2939:     even
