                            	  1222: ; Y: position fraction
                            	  1223: ; [0F]: movement direction
                            	  1224: ;
                            	  1225: ; Returns:
                            	  1226: ; A: position fraction
                            	  1227: ;
                            	  1228: ; Load the q-speed and position fraction from the parameters.
                            	  1229: ;
                            	  1230:     even
