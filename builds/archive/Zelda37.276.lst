02:0003D764 19802070        	 12285:     move.b  D0,($70,A4,D2.W)
02:0003D768 41EC0084        	 12286:     lea     ($0084,A4),A0
02:0003D76C 10302000        	 12287:     move.b  (A0,D2.W),D0
02:0003D770 123C0008        	 12288:     move.b  #$08,D1
02:0003D774 D101            	 12289:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D776 41EC0084        	 12290:     lea     ($0084,A4),A0
02:0003D77A 11802000        	 12291:     move.b  D0,(A0,D2.W)
