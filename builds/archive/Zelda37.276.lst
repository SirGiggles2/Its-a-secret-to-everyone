02:0003D57A 10303000        	 11967:     move.b  (A0,D3.W),D0
02:0003D57E 7600            	 11968:     moveq   #0,D3
02:0003D580 1600            	 11969:     move.b  D0,D3
02:0003D582 101D            	 11970:     move.b  (A5)+,D0  ; PLA
