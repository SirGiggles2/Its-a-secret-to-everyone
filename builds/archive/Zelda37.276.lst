                            	  6101: Digdogger_Move:
                            	  6102:     ; This calculation is the same one used in Manhandla to
                            	  6103:     ; manifest the fractional speed over several frames.
                            	  6104:     ;
                            	  6105:     ; To summarize, the formula is:
                            	  6106:     ;
                            	  6107:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6108:     ;
                            	  6109:     ;   SA := SA + (SL AND $E0)
                            	  6110:     ;   [03] := SH + carry
                            	  6111:     ;
                            	  6112:     ; See 04:A28E Manhandla_Move.
                            	  6113:     ;
02:0003A9DE 41EC041F        	  6114:     lea     ($041F,A4),A0
02:0003A9E2 10302000        	  6115:     move.b  (A0,D2.W),D0
02:0003A9E6 020000E0        	  6116:     andi.b #$E0,D0
02:0003A9EA 023C00EE        	  6117:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9EE 41EC0412        	  6118:     lea     ($0412,A4),A0
02:0003A9F2 12302000        	  6119:     move.b  (A0,D2.W),D1
02:0003A9F6 D101            	  6120:     addx.b  D1,D0   ; ADC $0412,X
02:0003A9F8 41EC0412        	  6121:     lea     ($0412,A4),A0
02:0003A9FC 11802000        	  6122:     move.b  D0,(A0,D2.W)
                            	  6123:     ; Assign (high speed byte + carry) to [03].
                            	  6124:     ;
02:0003AA00 41EC042C        	  6125:     lea     ($042C,A4),A0
02:0003AA04 10302000        	  6126:     move.b  (A0,D2.W),D0
02:0003AA08 123C0000        	  6127:     move.b  #$00,D1
02:0003AA0C D101            	  6128:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AA0E 19400003        	  6129:     move.b  D0,($0003,A4)
                            	  6130:     ; Change coordinates by the speed amount/offset in [03]
                            	  6131:     ; according to the direction.
                            	  6132:     ;
                            	  6133:     ; Start with a mask of $A1 in [02]:
                            	  6134:     ; - low nibble represents the right direction
                            	  6135:     ; - high nibble is used to set or clear carry as we go along
                            	  6136:     ;
02:0003AA12 103C00A1        	  6137:     move.b  #$A1,D0
02:0003AA16 19400002        	  6138:     move.b  D0,($0002,A4)
                            	  6139:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6140:     ;
02:0003AA1A 41EC0098        	  6141:     lea     ($0098,A4),A0
02:0003AA1E 10302000        	  6142:     move.b  (A0,D2.W),D0
02:0003AA22 122C0002        	  6143:     move.b  ($0002,A4),D1
02:0003AA26 C200            	  6144:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003AA28 6712            	  6145:     beq  _L_z04_Digdogger_Move_Left
02:0003AA2A 10342070        	  6146:     move.b  ($70,A4,D2.W),D0
02:0003AA2E 023C00EE        	  6147:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA32 122C0003        	  6148:     move.b  ($0003,A4),D1
02:0003AA36 D101            	  6149:     addx.b  D1,D0   ; ADC $03
02:0003AA38 19802070        	  6150:     move.b  D0,($70,A4,D2.W)
                            	  6151:     even
                            	  6152: _L_z04_Digdogger_Move_Left:
                            	  6153:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6154:     ;
02:0003AA3C 41EC0098        	  6155:     lea     ($0098,A4),A0
02:0003AA40 10302000        	  6156:     move.b  (A0,D2.W),D0
02:0003AA44 122C0002        	  6157:     move.b  ($0002,A4),D1
02:0003AA48 E309            	  6158:     lsl.b  #1,D1   ; ASL $02
02:0003AA4A 19410002        	  6159:     move.b  D1,($0002,A4)
02:0003AA4E 122C0002        	  6160:     move.b  ($0002,A4),D1
02:0003AA52 C200            	  6161:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003AA54 6716            	  6162:     beq  _L_z04_Digdogger_Move_Down
02:0003AA56 10342070        	  6163:     move.b  ($70,A4,D2.W),D0
02:0003AA5A 122C0003        	  6164:     move.b  ($0003,A4),D1
02:0003AA5E 0A3C0010        	  6165:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA62 9101            	  6166:     subx.b  D1,D0   ; SBC $03
02:0003AA64 0A3C0010        	  6167:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AA68 19802070        	  6168:     move.b  D0,($70,A4,D2.W)
                            	  6169:     even
                            	  6170: _L_z04_Digdogger_Move_Down:
                            	  6171:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6172:     ;
02:0003AA6C 41EC0098        	  6173:     lea     ($0098,A4),A0
02:0003AA70 10302000        	  6174:     move.b  (A0,D2.W),D0
02:0003AA74 122C0002        	  6175:     move.b  ($0002,A4),D1
02:0003AA78 E309            	  6176:     lsl.b  #1,D1   ; ASL $02
02:0003AA7A 19410002        	  6177:     move.b  D1,($0002,A4)
02:0003AA7E 122C0002        	  6178:     move.b  ($0002,A4),D1
02:0003AA82 C200            	  6179:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003AA84 6716            	  6180:     beq  _L_z04_Digdogger_Move_Up
02:0003AA86 41EC0084        	  6181:     lea     ($0084,A4),A0
02:0003AA8A 10302000        	  6182:     move.b  (A0,D2.W),D0
02:0003AA8E 122C0003        	  6183:     move.b  ($0003,A4),D1
02:0003AA92 D101            	  6184:     addx.b  D1,D0   ; ADC $03
02:0003AA94 41EC0084        	  6185:     lea     ($0084,A4),A0
02:0003AA98 11802000        	  6186:     move.b  D0,(A0,D2.W)
                            	  6187:     even
                            	  6188: _L_z04_Digdogger_Move_Up:
                            	  6189:     ; If direction has an up component (8), then subtract offset from Y coordinate.
