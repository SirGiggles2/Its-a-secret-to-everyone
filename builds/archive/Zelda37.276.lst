02:00038A0E 41EC0394        	  1613:     lea     ($0394,A4),A0
02:00038A12 10302000        	  1614:     move.b  (A0,D2.W),D0
02:00038A16 0200000F        	  1615:     andi.b #$0F,D0
02:00038A1A 023C00EE        	  1616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038A1E 6608            	  1617:     bne  _L_z04_Gel_MoveSplitting_Exit
02:00038A20 41EC0394        	  1618:     lea     ($0394,A4),A0
