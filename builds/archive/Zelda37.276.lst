02:0004AFD0 660C            	  6966:     bne  _anon_z07_39
02:0004AFD2 102C00AC        	  6967:     move.b  ($00AC,A4),D0
02:0004AFD6 020000C0        	  6968:     andi.b #$C0,D0
02:0004AFDA 194000AC        	  6969:     move.b  D0,($00AC,A4)
