                            	  2443: ;==============================================================================
                            	  2444: ; EXPORT side — carry-returning shims.
                            	  2445: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2446: ; reproduces the original function's carry normalization.
                            	  2447: ;==============================================================================
                            	  2448: 
                            	  2449: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2450: c_copy_next_row_to_transfer_buf:
02:0002BF82 4EB900000000    	  2451:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF88 08000008        	  2452:     btst    #8,D0
02:0002BF8C 670A            	  2453:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2454:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2455:     eori    #$01,CCR
02:0002BF96 4E75            	  2456:     rts
                            	  2457: .cc_cnr:
02:0002BF98 023C00FE        	  2458:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2459:     eori    #$01,CCR
02:0002BFA0 4E75            	  2460:     rts
                            	  2461: 
