02:0003D8F4 02000003        	 12485:     andi.b #$03,D0
02:0003D8F8 41F90003D7C8    	 12486:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003D8FE 12302000        	 12487:     move.b  (A0,D2.W),D1
02:0003D902 8001            	 12488:     or.b  D1,D0
02:0003D904 19400003        	 12489:     move.b  D0,($0003,A4)
02:0003D908 41F90003D7D2    	 12490:     lea     (GanonBurstTiles).l,A0
