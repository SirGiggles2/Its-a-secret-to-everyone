02:0003D306 122C04E6        	 11647:     move.b  ($04E6,A4),D1
02:0003D30A D101            	 11648:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003D30C 19802070        	 11649:     move.b  D0,($70,A4,D2.W)
                            	 11650:     even
