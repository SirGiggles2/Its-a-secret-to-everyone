02:0003B39E 41EC0098        	  7483:     lea     ($0098,A4),A0
02:0003B3A2 10302000        	  7484:     move.b  (A0,D2.W),D0
02:0003B3A6 02000003        	  7485:     andi.b #$03,D0
02:0003B3AA 6618            	  7486:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7487:     ; Else facing vertically. Flip the direction.
