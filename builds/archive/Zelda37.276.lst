02:0003D5B2 10302000        	 11998:     move.b  (A0,D2.W),D0
02:0003D5B6 6704            	 11999:     beq  _L_z04_PatraChild_State1_Exit
02:0003D5B8 6100FA94        	 12000:     jsr     SetDeadDummyObjType
