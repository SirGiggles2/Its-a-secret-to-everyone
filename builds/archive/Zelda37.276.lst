02:00034C5C 102C0085        	  4792:     move.b  ($0085,A4),D0
02:00034C60 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:00034C64 123C0010        	  4794:     move.b  #$10,D1
02:00034C68 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034C6C 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:00034C6E 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
