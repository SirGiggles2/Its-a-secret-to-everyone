                            	  3000: _anon_z04_42:
                            	  3001:     ; State 0.
                            	  3002:     ;
                            	  3003:     ; In state we determine whether to burst out of the ground.
                            	  3004:     ; If the long timer has not expired, then return.
                            	  3005:     ;
