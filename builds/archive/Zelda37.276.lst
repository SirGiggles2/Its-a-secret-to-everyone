02:0003B424 41EC0084        	  7553:     lea     ($0084,A4),A0
02:0003B428 10302000        	  7554:     move.b  (A0,D2.W),D0
02:0003B42C 023C00EE        	  7555:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B430 41F90003B30E    	  7556:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003B436 12303000        	  7557:     move.b  (A0,D3.W),D1
02:0003B43A D101            	  7558:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003B43C 41EC042C        	  7559:     lea     ($042C,A4),A0
02:0003B440 11802000        	  7560:     move.b  D0,(A0,D2.W)
                            	  7561:     ; Turn the index into a direction again by adding 1.
                            	  7562:     ; Store the facing direction.
                            	  7563:     ;
02:0003B444 5203            	  7564:     addq.b  #1,D3
02:0003B446 41EC0098        	  7565:     lea     ($0098,A4),A0
02:0003B44A 11832000        	  7566:     move.b  D3,(A0,D2.W)
