02:0003B0DC 10343000        	  7077:     move.b  ($00,A4,D3.W),D0
02:0003B0E0 003C0011        	  7078:     ori     #$11,CCR  ; SEC: set C+X
02:0003B0E4 12343002        	  7079:     move.b  ($02,A4,D3.W),D1
02:0003B0E8 0A3C0010        	  7080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B0EC 9101            	  7081:     subx.b  D1,D0   ; SBC $0002,Y
02:0003B0EE 0A3C0010        	  7082:     eori    #$10,CCR  ; restore X = 6502 C
