02:0004A714 7000            	  5705:     moveq   #0,D0
02:0004A716 41EC00AC        	  5706:     lea     ($00AC,A4),A0
02:0004A71A 11803000        	  5707:     move.b  D0,(A0,D3.W)
02:0004A71E 0A3C0001        	  5708:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004A722 4E75            	  5709:     rts
                            	  5710: 
                            	  5711:     even
                            	  5712: _L_z07_CheckState30_CatchBoomerang:
                            	  5713:     ; A monster caught the boomerang that it threw.
                            	  5714:     ;
                            	  5715:     ; Set a timer for the thrower based on a random value:
                            	  5716:     ; < $30: $30
                            	  5717:     ; < $70: $50
                            	  5718:     ; Else:  $70
                            	  5719:     ;
