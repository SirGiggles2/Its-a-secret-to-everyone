                            	 12458:     even
                            	 12459: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003D8CC 19420340        	 12460:     move.b  D2,($0340,A4)
                            	 12461:     ; If object slot < 5 or = 7, then move every frame.
                            	 12462:     ; Else move 3 out of every 4 frames.
                            	 12463:     ;
                            	 12464:     ; This makes pieces spread out in somewhat of a circle,
                            	 12465:     ; by making the pieces at cardinal directions move at
                            	 12466:     ; full speed while the diagonal ones move a little slower.
                            	 12467:     ;
02:0003D8D0 0C020005        	 12468:     cmpi.b  #$05,D2
02:0003D8D4 6510            	 12469:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003D8D6 0C020007        	 12470:     cmpi.b  #$07,D2
