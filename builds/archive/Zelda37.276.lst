02:0003E9C2 E208            	   984:     lsr.b  #1,D0   ; LSR A
02:0003E9C4 122C0098        	   985:     move.b  ($0098,A4),D1
02:0003E9C8 C200            	   986:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
