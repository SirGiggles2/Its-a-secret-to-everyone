                            	  3737:     ;
02:00039886 41EC0405        	  3738:     lea     ($0405,A4),A0
02:0003988A 10302000        	  3739:     move.b  (A0,D2.W),D0
02:0003988E 670A            	  3740:     beq  _anon_z04_55
02:00039890 705D            	  3741:     moveq   #93,D0
02:00039892 41EC034F        	  3742:     lea     ($034F,A4),A0
02:00039896 11802000        	  3743:     move.b  D0,(A0,D2.W)
