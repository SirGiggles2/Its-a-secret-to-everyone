                            	  7438: _L_z04_UpdatePolsVoice_State0:
                            	  7439:     ; State 0. Walking.
                            	  7440:     ;
                            	  7441:     ; If grid offset = 0, then no more distance to cover.
                            	  7442:     ; So, go change to state 1 -- jumping.
                            	  7443:     ;
02:0003B34C 41EC0394        	  7444:     lea     ($0394,A4),A0
