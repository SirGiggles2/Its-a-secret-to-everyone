02:0003AA9C 41EC0098        	  6191:     lea     ($0098,A4),A0
02:0003AAA0 10302000        	  6192:     move.b  (A0,D2.W),D0
02:0003AAA4 122C0002        	  6193:     move.b  ($0002,A4),D1
02:0003AAA8 E309            	  6194:     lsl.b  #1,D1   ; ASL $02
02:0003AAAA 19410002        	  6195:     move.b  D1,($0002,A4)
02:0003AAAE 122C0002        	  6196:     move.b  ($0002,A4),D1
02:0003AAB2 C200            	  6197:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003AAB4 671E            	  6198:     beq  _L_z04_Digdogger_Move_End
02:0003AAB6 41EC0084        	  6199:     lea     ($0084,A4),A0
02:0003AABA 10302000        	  6200:     move.b  (A0,D2.W),D0
02:0003AABE 122C0003        	  6201:     move.b  ($0003,A4),D1
02:0003AAC2 0A3C0010        	  6202:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AAC6 9101            	  6203:     subx.b  D1,D0   ; SBC $03
02:0003AAC8 0A3C0010        	  6204:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AACC 41EC0084        	  6205:     lea     ($0084,A4),A0
02:0003AAD0 11802000        	  6206:     move.b  D0,(A0,D2.W)
                            	  6207:     even
