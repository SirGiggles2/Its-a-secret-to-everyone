                            	  3786: PondFairy_HandleOtherStates:
02:000398D8 0C000001        	  3787:     cmpi.b  #$01,D0
02:000398DC 6610            	  3788:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3789:     ; State 1. Flying and filling hearts.
                            	  3790:     ;
                            	  3791:     ; If still filling hearts, then go draw Link and hearts.
                            	  3792:     ;
02:000398DE 102C0063        	  3793:     move.b  ($0063,A4),D0
02:000398E2 6620            	  3794:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3795:     ; If not filling hearts anymore, then go to state 2,
                            	  3796:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3797:     ; a little while after we finish filling hearts.
                            	  3798:     ;
02:000398E4 522C00AD        	  3799:     addq.b  #1,($00AD,A4)
02:000398E8 7050            	  3800:     moveq   #80,D0
02:000398EA 19400029        	  3801:     move.b  D0,($0029,A4)
                            	  3802:     even
                            	  3803: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3804:     ; If state <> 2 (so, it's 3), then return.
                            	  3805:     ;
                            	  3806:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3807:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3808:     ; was set to, and we'll return.
                            	  3809:     ;
02:000398EE 0C000002        	  3810:     cmpi.b  #$02,D0
02:000398F2 6634            	  3811:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3812:     ; State = 2.
                            	  3813:     ;
                            	  3814:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3815:     ;
02:000398F4 102C0029        	  3816:     move.b  ($0029,A4),D0
02:000398F8 660A            	  3817:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3818:     ; Else go to state 3, and unhalt Link.
                            	  3819:     ;
02:000398FA 522C00AD        	  3820:     addq.b  #1,($00AD,A4)
02:000398FE 7000            	  3821:     moveq   #0,D0
02:00039900 194000AC        	  3822:     move.b  D0,($00AC,A4)
                            	  3823:     even
