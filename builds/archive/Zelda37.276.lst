                            	  7323: _L_z07_InitObject_InitMonsterFromEdge:
02:0004B3B8 7400            	  7324:     moveq   #0,D2
02:0004B3BA 142C0340        	  7325:     move.b  ($0340,A4),D2
                            	  7326:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7327:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7328:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7329:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7330:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7331:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7332:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7333:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7334:     ; corrupting them and causing a deterministic address-error
                            	  7335:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7336:     ; identified by Codex static review.)
                            	  7337: _L_z07_P47_pre_check:
02:0004B3BE 102C0525        	  7338:     move.b  ($0525,A4),D0
02:0004B3C2 020000F0        	  7339:     andi.b  #$F0,D0
02:0004B3C6 0C000040        	  7340:     cmpi.b  #$40,D0
02:0004B3CA 6506            	  7341:     blo     _L_z07_P47_pre_snap
02:0004B3CC 0C0000E0        	  7342:     cmpi.b  #$E0,D0
02:0004B3D0 6506            	  7343:     blo     _L_z07_P47_pre_ok
                            	  7344: _L_z07_P47_pre_snap:
02:0004B3D2 197C00480525    	  7345:     move.b  #$48,($0525,A4)
                            	  7346: _L_z07_P47_pre_ok:
02:0004B3D8 7005            	  7347:     moveq   #5,D0
02:0004B3DA 610004F4        	  7348:     jsr     SwitchBank
02:0004B3DE 4EB900040182    	  7349:     jsr     FindNextEdgeSpawnCell
                            	  7350:     ; Post-walk 1: bottom-edge snap.
02:0004B3E4 102C0525        	  7351:     move.b  ($0525,A4),D0
02:0004B3E8 020000F0        	  7352:     andi.b  #$F0,D0
02:0004B3EC 0C0000E0        	  7353:     cmpi.b  #$E0,D0
02:0004B3F0 660C            	  7354:     bne     _L_z07_P47_post1_ok
02:0004B3F2 197C00480525    	  7355:     move.b  #$48,($0525,A4)
02:0004B3F8 4EB900040182    	  7356:     jsr     FindNextEdgeSpawnCell
                            	  7357: _L_z07_P47_post1_ok:
                            	  7358:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7359:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004B3FE 7600            	  7360:     moveq   #0,D3
02:0004B400 162C0525        	  7361:     move.b  ($0525,A4),D3
02:0004B404 0243000F        	  7362:     andi.w  #$000F,D3
02:0004B408 C6FC002C        	  7363:     mulu.w  #44,D3
02:0004B40C 203C00FF6530    	  7364:     move.l  #$FF6530,D0
02:0004B412 D083            	  7365:     add.l   D3,D0
02:0004B414 7600            	  7366:     moveq   #0,D3
02:0004B416 162C0525        	  7367:     move.b  ($0525,A4),D3
02:0004B41A E84B            	  7368:     lsr.w   #4,D3
02:0004B41C 5943            	  7369:     subi.w  #4,D3
02:0004B41E E34B            	  7370:     lsl.w   #1,D3
02:0004B420 D083            	  7371:     add.l   D3,D0
02:0004B422 2040            	  7372:     movea.l D0,A0
02:0004B424 1010            	  7373:     move.b  (A0),D0
02:0004B426 0C000084        	  7374:     cmpi.b  #$84,D0
02:0004B42A 6544            	  7375:     blo     _L_z07_P47_post2_ok
                            	  7376:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7377:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7378:     ; writes to the $05xx region.
02:0004B42C 7800            	  7379:     moveq   #0,D4
                            	  7380: _L_z07_P47_fb_loop:
