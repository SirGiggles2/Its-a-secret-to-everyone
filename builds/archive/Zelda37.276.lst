02:0003D4C6 41EC0394        	 11884:     lea     ($0394,A4),A0
02:0003D4CA 11802000        	 11885:     move.b  D0,(A0,D2.W)
                            	 11886:     ; This location is right above Patra.
                            	 11887:     ; Set X coordinate to Patra's.
