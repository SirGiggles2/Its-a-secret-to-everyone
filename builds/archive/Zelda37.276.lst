                            	   749: _L_z01_CopyCommonCodeToRam_Loop:
02:0002EF30 1214            	   750:     move.b  ($00,A4),D1   ; ptr lo
02:0002EF32 182C0001        	   751:     move.b  ($01,A4),D4  ; ptr hi
02:0002EF36 024100FF        	   752:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EF3A E14C            	   753:     lsl.w   #8,D4
02:0002EF3C 8841            	   754:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002EF3E 48C4            	   755:     ext.l   D4
02:0002EF40 D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EF46 2044            	   757:     movea.l D4,A0
02:0002EF48 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EF4C 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002EF50 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
02:0002EF54 024100FF        	   761:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EF58 E14C            	   762:     lsl.w   #8,D4
02:0002EF5A 8841            	   763:     or.w    D1,D4
02:0002EF5C 48C4            	   764:     ext.l   D4
02:0002EF5E D8BC00FF0000    	   765:     add.l   #NES_RAM,D4
02:0002EF64 2044            	   766:     movea.l D4,A0
02:0002EF66 11803000        	   767:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   768:     ; Increment source address.
                            	   769:     ;
02:0002EF6A 1014            	   770:     move.b  ($0000,A4),D0
02:0002EF6C 023C00EE        	   771:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EF70 123C0001        	   772:     move.b  #$01,D1
02:0002EF74 D101            	   773:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EF76 1880            	   774:     move.b  D0,($0000,A4)
02:0002EF78 102C0001        	   775:     move.b  ($0001,A4),D0
02:0002EF7C 123C0000        	   776:     move.b  #$00,D1
02:0002EF80 D101            	   777:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EF82 19400001        	   778:     move.b  D0,($0001,A4)
                            	   779:     ; Increment destination address.
                            	   780:     ;
02:0002EF86 102C0002        	   781:     move.b  ($0002,A4),D0
02:0002EF8A 023C00EE        	   782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EF8E 123C0001        	   783:     move.b  #$01,D1
02:0002EF92 D101            	   784:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EF94 19400002        	   785:     move.b  D0,($0002,A4)
02:0002EF98 102C0003        	   786:     move.b  ($0003,A4),D0
02:0002EF9C 123C0000        	   787:     move.b  #$00,D1
02:0002EFA0 D101            	   788:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EFA2 19400003        	   789:     move.b  D0,($0003,A4)
02:0002EFA6 0C00007F        	   790:     cmpi.b  #$7F,D0
02:0002EFAA 6684            	   791:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002EFAC 102C0002        	   792:     move.b  ($0002,A4),D0
02:0002EFB0 4A00            	   793:     cmpi.b  #$00,D0
02:0002EFB2 6600FF7C        	   794:     bne  _L_z01_CopyCommonCodeToRam_Loop
