02:0003B354 67000084        	  7446:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7447:     ; Decrement grid offset / distance remaining.
                            	  7448:     ;
02:0003B358 41EC0394        	  7449:     lea     ($0394,A4),A0
02:0003B35C 53302000        	  7450:     subq.b  #1,(A0,D2.W)
                            	  7451:     ; Move vertically.
                            	  7452:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7453:     ;
02:0003B360 41EC0084        	  7454:     lea     ($0084,A4),A0
02:0003B364 10302000        	  7455:     move.b  (A0,D2.W),D0
02:0003B368 023C00EE        	  7456:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B36C 41F90003B2FC    	  7457:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003B372 12303000        	  7458:     move.b  (A0,D3.W),D1
02:0003B376 D101            	  7459:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003B378 41EC0084        	  7460:     lea     ($0084,A4),A0
02:0003B37C 11802000        	  7461:     move.b  D0,(A0,D2.W)
                            	  7462:     even
                            	  7463: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7464:     ; If the square the monster is over is walkable, then
                            	  7465:     ; go draw and check object collisions.
