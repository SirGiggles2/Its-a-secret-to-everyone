                            	  1345:     ; Use the shooting operation to create the gel object.
                            	  1346:     ;
02:0003884C 1880            	  1347:     move.b  D0,($0000,A4)
02:0003884E 61005570        	  1348:     jsr     ShootLimited
                            	  1349:     ; Shots start in state $10. But Child Gel needs to start in state 0.
                            	  1350:     ;
02:00038852 7000            	  1351:     moveq   #0,D0
