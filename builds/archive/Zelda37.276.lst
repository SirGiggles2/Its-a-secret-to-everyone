02:0003B0FA 122C0007        	  7089:     move.b  ($0007,A4),D1
02:0003B0FE B001            	  7090:     cmp.b   D1,D0
02:0003B100 6B0E            	  7091:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7092:     ; The distance is close enough in this axis.
                            	  7093:     ;
                            	  7094:     ; Store the distance in this axis in [05] or [04],
                            	  7095:     ; depending on the loop index.
                            	  7096:     ;
02:0003B102 19803004        	  7097:     move.b  D0,($04,A4,D3.W)
                            	  7098:     ; Shift [08] right, because we're in range in this axis.
                            	  7099:     ;
02:0003B106 122C0008        	  7100:     move.b  ($0008,A4),D1
02:0003B10A E209            	  7101:     lsr.b  #1,D1   ; LSR $08
02:0003B10C 19410008        	  7102:     move.b  D1,($0008,A4)
                            	  7103:     even
                            	  7104: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003B110 5303            	  7105:     subq.b  #1,D3
02:0003B112 6AC8            	  7106:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7107:     ; If close enough in both axes, then [08] will be 0.
                            	  7108:     ;
02:0003B114 102C0008        	  7109:     move.b  ($0008,A4),D0
02:0003B118 4E75            	  7110:     rts
                            	  7111: 
                            	  7112: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7113: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7114: ;
                            	  7115: ; But these are not typical direction indexes. Instead a
                            	  7116: ; 5-way index is used.
                            	  7117: ; A direction shifted right once becomes a 5-way index.
                            	  7118: ; The fourth element is unused.
                            	  7119: ;
                            	  7120:     even
                            	  7121: DodongoFrameImages:
02:0003B11A 00              	  7122:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003B11B 01
02:0003B11C 06
02:0003B11D FF
02:0003B11E 08
02:0003B11F 02
02:0003B120 03
02:0003B121 06
02:0003B122 FF              	  7123:     dc.b    $FF, $08
02:0003B123 08
