                            	  7967: 
                            	  7968: ; Description:
                            	  7969: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  7970: ; When walking, the object timer is set. When teleporting,
                            	  7971: ; the teleporting distance remaining is set.
                            	  7972: ;
                            	  7973: ; If we have the magic clock, then only go draw and check collisions.
                            	  7974: ;
                            	  7975:     even
                            	  7976: UpdateBlueWizzrobe:
02:0003B7C4 102C066C        	  7977:     move.b  ($066C,A4),D0
02:0003B7C8 6702            	  7978:     beq.s  __far_z_04_0070
02:0003B7CA 6014            	  7979:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  7980: __far_z_04_0070:
02:0003B7CC 6116            	  7981:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003B7CE 61000318        	  7982:     jsr     BlueWizzrobe_TryShooting
                            	  7983:     even
                            	  7984: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  7985:     ; If the teleporting distance remaining is even, then draw
                            	  7986:     ; and check collisions, else return.
                            	  7987:     ;
                            	  7988:     ; This means that when 0, the monster is walking.
                            	  7989:     ; So, draw and check collisions every frame.
                            	  7990:     ;
                            	  7991:     ; When not 0, the monster is teleporting, and must be drawn
                            	  7992:     ; translucently -- every other frame.
                            	  7993:     ;
02:0003B7D2 41EC0394        	  7994:     lea     ($0394,A4),A0
02:0003B7D6 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003B7DA E208            	  7996:     lsr.b  #1,D0   ; LSR A
02:0003B7DC 6402            	  7997:     bcc.s  __far_z_04_0071
02:0003B7DE 603A            	  7998:     jmp  L11E17_Exit
                            	  7999: __far_z_04_0071:
                            	  8000:     even
                            	  8001: L_Wizzrobe_DrawAndCheckCollisions:
02:0003B7E0 600004DE        	  8002:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8003: 
                            	  8004:     even
                            	  8005: BlueWizzrobe_WalkOrTeleport:
                            	  8006:     ; If timer has not expired, then go walk.
                            	  8007:     ;
02:0003B7E4 10342028        	  8008:     move.b  ($28,A4,D2.W),D0
02:0003B7E8 661C            	  8009:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8010:     ; Timer = 0. Only teleporting now.
                            	  8011:     ;
                            	  8012:     ; If there is still distance to go while translucent, then
                            	  8013:     ; decrement the distance remaining, and move.
                            	  8014:     ;
02:0003B7EA 41EC0394        	  8015:     lea     ($0394,A4),A0
02:0003B7EE 10302000        	  8016:     move.b  (A0,D2.W),D0
02:0003B7F2 670A            	  8017:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003B7F4 41EC0394        	  8018:     lea     ($0394,A4),A0
02:0003B7F8 53302000        	  8019:     subq.b  #1,(A0,D2.W)
02:0003B7FC 602A            	  8020:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8021: 
                            	  8022:     even
                            	  8023: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8024:     ; Distance remaining = 0. Still teleporting.
