                            	  5599: __far_z_04_0043:
                            	  5600: _anon_z04_82:
                            	  5601:     ; Turn randomly while flying, as usual.
                            	  5602:     ;
02:0003A652 61003A78        	  5603:     jsr     Flyer_Wander
                            	  5604:     ; After every turn, the common flyer routines set timer to $10.
                            	  5605:     ; This can be used as a signal for moldorm to propagate
                            	  5606:     ; direction changes down the chain.
                            	  5607:     ;
                            	  5608:     ; Between each turn, timer <> $10.
                            	  5609:     ;
                            	  5610:     ; At the end of the delay after the last turn, timer = 0.
                            	  5611:     ; This is a signal that that flying state ended, and a new one
                            	  5612:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5613:     ; we can propagate direction changes again; and start
                            	  5614:     ; a new flying interval by setting timer to $10. This will make
                            	  5615:     ; the next flying state delay that amount of time before turning
                            	  5616:     ; the first time.
                            	  5617:     ;
                            	  5618:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5619:     ; arm the timer again, and shift directions down the chain.
                            	  5620:     ;
02:0003A656 10342028        	  5621:     move.b  ($28,A4,D2.W),D0
02:0003A65A 6602            	  5622:     bne.s  __far_z_04_0044
02:0003A65C 60CE            	  5623:     jmp  Moldorm_ChangeFlyingState
                            	  5624: __far_z_04_0044:
                            	  5625:     even
                            	  5626: Moldorm_PropagateDirs:
                            	  5627:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5628:     ;
02:0003A65E 10342028        	  5629:     move.b  ($28,A4,D2.W),D0
02:0003A662 0C000010        	  5630:     cmpi.b  #$10,D0
02:0003A666 6702            	  5631:     beq.s  __far_z_04_0045
02:0003A668 6058            	  5632:     jmp  L1156B_Exit
