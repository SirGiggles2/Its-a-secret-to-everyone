                            	  3857: PondFairy_MoveHearts:
                            	  3858:     ; Loop over each heart from object slot 2 to 9.
                            	  3859:     ;
                            	  3860:     ; Even though they are not standalone objects, their info
                            	  3861:     ; is stored in those object slots.
                            	  3862:     ;
02:00039932 7402            	  3863:     moveq   #2,D2
                            	  3864:     even
                            	  3865: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  3866:     ; If the current heart's state <> 0, then go move it.
                            	  3867:     ; Else we have to wait for it to come out at the right time.
                            	  3868:     ;
02:00039934 41EC00AC        	  3869:     lea     ($00AC,A4),A0
02:00039938 10302000        	  3870:     move.b  (A0,D2.W),D0
02:0003993C 667C            	  3871:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  3872:     ; The current heart's state = 0.
                            	  3873:     ;
                            	  3874:     ; If object slot = 2, then go make it appear. This is the first
                            	  3875:     ; heart to show up.
                            	  3876:     ;
02:0003993E 0C020002        	  3877:     cmpi.b  #$02,D2
02:00039942 6732            	  3878:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  3879:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  3880:     ; go start over.
                            	  3881:     ;
                            	  3882:     ; TODO:
                            	  3883:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  3884:     ;
02:00039944 102C00AE        	  3885:     move.b  ($00AE,A4),D0
02:00039948 67EA            	  3886:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  3887:     ; Look up the starting angle of this heart with the index
                            	  3888:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  3889:     ; then loop again.
                            	  3890:     ;
02:0003994A 1002            	  3891:     move.b  D2,D0
02:0003994C 003C0011        	  3892:     ori     #$11,CCR  ; SEC: set C+X
02:00039950 123C0003        	  3893:     move.b  #$03,D1
02:00039954 0A3C0010        	  3894:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039958 9101            	  3895:     subx.b  D1,D0   ; SBC #$03
02:0003995A 0A3C0010        	  3896:     eori    #$10,CCR  ; restore X = 6502 C
02:0003995E 7600            	  3897:     moveq   #0,D3
02:00039960 1600            	  3898:     move.b  D0,D3
02:00039962 102C0396        	  3899:     move.b  ($0396,A4),D0
02:00039966 41F90003992A    	  3900:     lea     (PondHeartStartAngles).l,A0
02:0003996C 12303000        	  3901:     move.b  (A0,D3.W),D1
02:00039970 B001            	  3902:     cmp.b   D1,D0
02:00039972 66000086        	  3903:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  3904:     even
