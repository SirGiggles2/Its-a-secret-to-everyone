02:0003A15E 123C0008        	  4961:     move.b  #$08,D1
02:0003A162 D101            	  4962:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A164 41EC0412        	  4963:     lea     ($0412,A4),A0
02:0003A168 11802000        	  4964:     move.b  D0,(A0,D2.W)
02:0003A16C 101D            	  4965:     move.b  (A5)+,D0  ; PLA
02:0003A16E 4600            	  4966:     eori.b #$FF,D0
02:0003A170 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A174 123C0001        	  4968:     move.b  #$01,D1
02:0003A178 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4970: _anon_z04_71:
                            	  4971:     ; Add the distance and Link's minor coordinate to calculate
                            	  4972:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  4973:     ; In general, the monster will be put in front of Link.
                            	  4974:     ;
02:0003A17A 023C00EE        	  4975:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A17E 1214            	  4976:     move.b  ($0000,A4),D1
02:0003A180 D101            	  4977:     addx.b  D1,D0   ; ADC $00
02:0003A182 19400004        	  4978:     move.b  D0,($0004,A4)
                            	  4979:     ; By default, will return index 0 to choose the minimum value
                            	  4980:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  4981:     ; if Link is at the wall with a smaller major coordinate.
                            	  4982:     ;
02:0003A186 7600            	  4983:     moveq   #0,D3
                            	  4984:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  4985:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  4986:     ; to access the block for the other direction along the same axis,
                            	  4987:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  4988:     ;
02:0003A188 102C0001        	  4989:     move.b  ($0001,A4),D0
02:0003A18C 122C0003        	  4990:     move.b  ($0003,A4),D1
02:0003A190 B001            	  4991:     cmp.b   D1,D0
02:0003A192 671C            	  4992:     beq  _anon_z04_72
