02:0003D51C 41EC0084        	 11927:     lea     ($0084,A4),A0
02:0003D520 10302000        	 11928:     move.b  (A0,D2.W),D0
02:0003D524 023C00EE        	 11929:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D528 122C0479        	 11930:     move.b  ($0479,A4),D1
02:0003D52C D101            	 11931:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003D52E 41EC0084        	 11932:     lea     ($0084,A4),A0
