                            	  6911: AnimateLinkObjState:
                            	  6912:     ; If major state = $10
                            	  6913:     ;   if minor state = 0, make it 1
                            	  6914:     ;   else OR state with $30
                            	  6915:     ;   go set movement frame to 1
                            	  6916:     ;
02:0004AF88 102C00AC        	  6917:     move.b  ($00AC,A4),D0
02:0004AF8C 02000030        	  6918:     andi.b #$30,D0
02:0004AF90 0C000010        	  6919:     cmpi.b  #$10,D0
