                            	  2988:     ; If the coordinate crosses (<) the boundary, then
                            	  2989:     ; go mask buttons.
                            	  2990:     ;
                            	  2991:     ;
                            	  2992:     ; Get coordinate in [02].
02:0003FD08 102C0002        	  2993:     move.b  ($0002,A4),D0
02:0003FD0C 41F90003FC38    	  2994:     lea     (BorderBounds).l,A0
