02:0003D540 41EC034F        	 11943:     lea     ($034F,A4),A0
02:0003D544 16302000        	 11944:     move.b  (A0,D2.W),D3
02:0003D548 0C030025        	 11945:     cmpi.b  #$25,D3
02:0003D54C 6702            	 11946:     beq  _anon_z04_159
02:0003D54E 7060            	 11947:     moveq   #96,D0
                            	 11948: _anon_z04_159:
02:0003D550 61000D9C        	 11949:     jsr     DecreaseObjectAngle
                            	 11950:     ; Load Patra's maneuver index.
                            	 11951:     ; It determines which counts of bits are looked up below.
                            	 11952:     ;
02:0003D554 7600            	 11953:     moveq   #0,D3
02:0003D556 162C045F        	 11954:     move.b  ($045F,A4),D3
                            	 11955:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 11956:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 11957:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 11958:     ;
02:0003D55A 41EC034F        	 11959:     lea     ($034F,A4),A0
02:0003D55E 10302000        	 11960:     move.b  (A0,D2.W),D0
02:0003D562 0C000025        	 11961:     cmpi.b  #$25,D0
02:0003D566 661E            	 11962:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
