02:00032C9A 666C            	  1672:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032C9C 7000            	  1676:     moveq   #0,D0
02:00032C9E 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032CA2 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032CA4 41F900032A86    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032CAA D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032CAC 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:00032CB2 197C00000303    	  1683:     move.b  #$00,($0303,A4)
02:00032CB8 7020            	  1684:     moveq   #32,D0
02:00032CBA 19400304        	  1685:     move.b  D0,($0304,A4)
                            	  1686:     ; End marker at DynTileBuf+4+31
02:00032CBE 761F            	  1687:     moveq   #31,D3
02:00032CC0 103C00FF        	  1688:     move.b  #$FF,D0
02:00032CC4 43EC0306        	  1689:     lea     ($0306,A4),A1
02:00032CC8 13803000        	  1690:     move.b  D0,(A1,D3.W)
