                            	  5179: UpdateBoomerangOrFood:
                            	  5180:     ; If state = 0, then not active. So, return.
                            	  5181:     ;
02:0004A3A4 41EC00AC        	  5182:     lea     ($00AC,A4),A0
02:0004A3A8 10302000        	  5183:     move.b  (A0,D2.W),D0
02:0004A3AC 6602            	  5184:     bne.s  __far_z_07_0078
02:0004A3AE 60F2            	  5185:     jmp  L1F49F_Exit
                            	  5186: __far_z_07_0078:
                            	  5187:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5188:     ;
02:0004A3B0 E308            	  5189:     lsl.b  #1,D0   ; ASL A
02:0004A3B2 6504            	  5190:     bcs.s  __far_z_07_0079
02:0004A3B4 600000AA        	  5191:     jmp  UpdateArrowOrBoomerang
                            	  5192: __far_z_07_0079:
