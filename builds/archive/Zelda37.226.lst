02:0003B3F2 123C001C        	  4210:     move.b  #$1C,D1
02:0003B3F6 0A3C0010        	  4211:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B3FA 9101            	  4212:     subx.b  D1,D0   ; SBC #$1C
02:0003B3FC 0A3C0010        	  4213:     eori    #$10,CCR  ; restore X = 6502 C
