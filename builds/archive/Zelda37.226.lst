02:000336BC E208            	   606:     lsr.b  #1,D0   ; LSR A
02:000336BE E208            	   607:     lsr.b  #1,D0   ; LSR A
02:000336C0 122C000C        	   608:     move.b  ($000C,A4),D1
02:000336C4 8001            	   609:     or.b  D1,D0
02:000336C6 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
02:000336C8 101D            	   613:     move.b  (A5)+,D0  ; PLA
02:000336CA 41EC0650        	   614:     lea     ($0650,A4),A0
02:000336CE 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:000336D2 5203            	   618:     addq.b  #1,D3
02:000336D4 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:000336D6 0C020006        	   622:     cmpi.b  #$06,D2
02:000336DA 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:000336DC 1002            	   624:     move.b  D2,D0
02:000336DE E208            	   625:     lsr.b  #1,D0   ; LSR A
02:000336E0 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
02:000336E2 1003            	   629:     move.b  D3,D0
02:000336E4 123C0026        	   630:     move.b  #$26,D1
02:000336E8 D101            	   631:     addx.b  D1,D0   ; ADC #$26 (X flag = 6502 C)
02:000336EA 7600            	   632:     moveq   #0,D3
02:000336EC 1600            	   633:     move.b  D0,D3
