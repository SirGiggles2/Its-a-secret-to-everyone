02:000438BA 5303            	  5948:     subq.b  #1,D3
                            	  5949: _anon_z05_113:
                            	  5950:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5951:     ;
                            	  5952:     ; DT DFC DFO Meaning
                            	  5953:     ; ------------------
                            	  5954:     ; 0  1   1   open
                            	  5955:     ; 4  4   5   bombable
                            	  5956:     ; 5  2   1   key
                            	  5957:     ; 6  2   1   key 2
