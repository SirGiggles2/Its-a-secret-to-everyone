02:0003AB70 41EC03E4        	  2974:     lea     ($03E4,A4),A0
02:0003AB74 10302000        	  2975:     move.b  (A0,D2.W),D0
02:0003AB78 610005BE        	  2976:     jsr     DrawObjectNotMirroredAndCheckLinkCollision
                            	  2977:     ; If the boulder's Y < $F0, return.
                            	  2978:     ;
02:0003AB7C 41EC0084        	  2979:     lea     ($0084,A4),A0
