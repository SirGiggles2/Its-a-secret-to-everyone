02:0003A22C 610001F8        	  1576:     jsr     Gel_CheckCollisions
02:0003A230 41EC0405        	  1577:     lea     ($0405,A4),A0
02:0003A234 10302000        	  1578:     move.b  (A0,D2.W),D0
02:0003A238 664E            	  1579:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A23A 41EC04F0        	  1580:     lea     ($04F0,A4),A0
02:0003A23E 10302000        	  1581:     move.b  (A0,D2.W),D0
02:0003A242 6744            	  1582:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1583:     ; If vertically aligned with the square grid, then
                            	  1584:     ; use a horizontal direction mask (3).
                            	  1585:     ;
                            	  1586:     ; Keep in mind that most objects are aligned vertically when
                            	  1587:     ; the low nibble of their Y is $D.
                            	  1588:     ;
