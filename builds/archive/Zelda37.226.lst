                            	  4262: Link_ModifyDirInDoorway:
                            	  4263:     ; In a doorway (UW), you can only move in the direction
                            	  4264:     ; that you entered it or the opposite.
                            	  4265:     ;
                            	  4266:     ;
                            	  4267:     ; If not in a doorway nor moving, then return.
                            	  4268:     ;
02:000422B2 102C0053        	  4269:     move.b  ($0053,A4),D0
02:000422B6 672E            	  4270:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
02:000422B8 7600            	  4271:     moveq   #0,D3
02:000422BA 162C03F8        	  4272:     move.b  ($03F8,A4),D3
02:000422BE 6726            	  4273:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
                            	  4274:     ; If the facing direction is part of the input direction, then
                            	  4275:     ; keep moving in the facing direction.
                            	  4276:     ;
02:000422C0 102C0098        	  4277:     move.b  ($0098,A4),D0
02:000422C4 122C03F8        	  4278:     move.b  ($03F8,A4),D1
