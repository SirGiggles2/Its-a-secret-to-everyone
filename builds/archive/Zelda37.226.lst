02:00034ED8 0A3C0010        	  2729:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034EDC 9101            	  2730:     subx.b  D1,D0   ; SBC #$08
02:00034EDE 0A3C0010        	  2731:     eori    #$10,CCR  ; restore X = 6502 C
02:00034EE2 19400204        	  2732:     move.b  D0,($0204,A4)
02:00034EE6 7070            	  2733:     moveq   #112,D0
02:00034EE8 19400070        	  2734:     move.b  D0,($0070,A4)
02:00034EEC 103C0087        	  2735:     move.b  #$87,D0
02:00034EF0 19400085        	  2736:     move.b  D0,($0085,A4)
02:00034EF4 7030            	  2737:     moveq   #48,D0
02:00034EF6 19400071        	  2738:     move.b  D0,($0071,A4)
