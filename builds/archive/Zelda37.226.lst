02:0003A3FE 003C0011        	  1840:     ori     #$11,CCR  ; SEC: set C+X
02:0003A402 6720            	  1841:     beq  _L_z04_Gel_MoveSplitting_Exit
                            	  1842:     ; Move.
                            	  1843:     ;
02:0003A404 4EB90004BE22    	  1844:     jsr     MoveObject
                            	  1845:     ; Mask the grid offset with $F (to a square length),
                            	  1846:     ; and return C=0.
                            	  1847:     ;
02:0003A40A 41EC0394        	  1848:     lea     ($0394,A4),A0
02:0003A40E 10302000        	  1849:     move.b  (A0,D2.W),D0
02:0003A412 0200000F        	  1850:     andi.b #$0F,D0
02:0003A416 023C00EE        	  1851:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A41A 6608            	  1852:     bne  _L_z04_Gel_MoveSplitting_Exit
02:0003A41C 41EC0394        	  1853:     lea     ($0394,A4),A0
02:0003A420 11802000        	  1854:     move.b  D0,(A0,D2.W)
                            	  1855:     even
