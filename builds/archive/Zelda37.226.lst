02:00043ACA 11802000        	  6242:     move.b  D0,(A0,D2.W)
02:00043ACE 1002            	  6243:     move.b  D2,D0
02:00043AD0 19400301        	  6244:     move.b  D0,($0301,A4)
                            	  6245:     ; Increment the command.
                            	  6246:     ;
02:00043AD4 522C0054        	  6247:     addq.b  #1,($0054,A4)
                            	  6248:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6249:     ; and resetting the door command.
                            	  6250:     ; This ends up catching original states 3 and 7.
                            	  6251:     ;
                            	  6252:     ; Else set door timer to 8 and return.
                            	  6253:     ;
02:00043AD8 102C0054        	  6254:     move.b  ($0054,A4),D0
02:00043ADC 02000003        	  6255:     andi.b #$03,D0
02:00043AE0 6708            	  6256:     beq  _anon_z05_122
02:00043AE2 7008            	  6257:     moveq   #8,D0
02:00043AE4 19400027        	  6258:     move.b  D0,($0027,A4)
02:00043AE8 4E75            	  6259:     rts
                            	  6260: 
                            	  6261: _anon_z05_122:
                            	  6262:     ; If the door command = 4 after incrementing it, then
                            	  6263:     ; it was 3 (close door). So:
                            	  6264:     ; 1. reset this door's flag
                            	  6265:     ; 2. remove it from the opened door mask
                            	  6266:     ; 3. reset the door command
                            	  6267:     ; 4. go lay out doors in the play area map
                            	  6268:     ;
02:00043AEA 102C0054        	  6269:     move.b  ($0054,A4),D0
02:00043AEE 0C000004        	  6270:     cmpi.b  #$04,D0
02:00043AF2 6626            	  6271:     bne  _anon_z05_123
02:00043AF4 7400            	  6272:     moveq   #0,D2
02:00043AF6 142C0009        	  6273:     move.b  ($0009,A4),D2
02:00043AFA 6100DAEC        	  6274:     jsr     ResetDoorFlag
02:00043AFE 102C0055        	  6275:     move.b  ($0055,A4),D0
02:00043B02 0A00000F        	  6276:     eori.b #$0F,D0
02:00043B06 122C00EE        	  6277:     move.b  ($00EE,A4),D1
02:00043B0A C001            	  6278:     and.b  D1,D0
                            	  6279:     even
                            	  6280: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043B0C 194000EE        	  6281:     move.b  D0,($00EE,A4)
                            	  6282:     even
                            	  6283: L_ResetDoorCmdAndLayOutDoors:
02:00043B10 7000            	  6284:     moveq   #0,D0
02:00043B12 19400054        	  6285:     move.b  D0,($0054,A4)
02:00043B16 6000FCD4        	  6286:     jmp     LayOutDoors
                            	  6287: 
                            	  6288: _anon_z05_123:
                            	  6289:     ; Door command <> 4.
                            	  6290:     ; It must be 8, which means it was 7: open door.
                            	  6291:     ;
                            	  6292:     ; If the door is a shutter (7), then go add the door to the
                            	  6293:     ; opened door mask, reset door command, and lay out doors.
                            	  6294:     ;
02:00043B1A 102C0055        	  6295:     move.b  ($0055,A4),D0
02:00043B1E 19400002        	  6296:     move.b  D0,($0002,A4)
02:00043B22 6100FA32        	  6297:     jsr     FindDoorAttrByDoorBit
02:00043B26 0C000007        	  6298:     cmpi.b  #$07,D0
02:00043B2A 676E            	  6299:     beq  _anon_z05_124
                            	  6300:     ; Else the door is not a shutter.
                            	  6301:     ;
                            	  6302:     ;
                            	  6303:     ; [09] door direction index
02:00043B2C 7400            	  6304:     moveq   #0,D2
02:00043B2E 142C0009        	  6305:     move.b  ($0009,A4),D2
02:00043B32 6100DAAE        	  6306:     jsr     SetDoorFlag
                            	  6307:     ; Get the next room's ID.
                            	  6308:     ;
02:00043B36 1003            	  6309:     move.b  D3,D0
02:00043B38 023C00EE        	  6310:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043B3C 41F9000439F8    	  6311:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043B42 12302000        	  6312:     move.b  (A0,D2.W),D1
02:00043B46 D101            	  6313:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043B48 7600            	  6314:     moveq   #0,D3
02:00043B4A 1600            	  6315:     move.b  D0,D3
                            	  6316:     ; Flip the door direction index.
                            	  6317:     ;
02:00043B4C 1002            	  6318:     move.b  D2,D0
02:00043B4E 0A000001        	  6319:     eori.b #$01,D0
02:00043B52 7400            	  6320:     moveq   #0,D2
02:00043B54 1400            	  6321:     move.b  D0,D2
                            	  6322:     ; Set the door flag for the opposite door in the next room.
                            	  6323:     ;
02:00043B56 1214            	  6324:     move.b  ($00,A4),D1   ; ptr lo
02:00043B58 182C0001        	  6325:     move.b  ($01,A4),D4  ; ptr hi
02:00043B5C 024100FF        	  6326:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B60 E14C            	  6327:     lsl.w   #8,D4
02:00043B62 8841            	  6328:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043B64 48C4            	  6329:     ext.l   D4
02:00043B66 D8BC00FF0000    	  6330:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043B6C 2044            	  6331:     movea.l D4,A0
02:00043B6E 10303000        	  6332:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043B72 41F90004AD4E    	  6333:     lea     (LevelMasks).l,A0
02:00043B78 12302000        	  6334:     move.b  (A0,D2.W),D1
02:00043B7C 8001            	  6335:     or.b  D1,D0
02:00043B7E 1214            	  6336:     move.b  ($00,A4),D1   ; ptr lo
02:00043B80 182C0001        	  6337:     move.b  ($01,A4),D4  ; ptr hi
02:00043B84 024100FF        	  6338:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B88 E14C            	  6339:     lsl.w   #8,D4
02:00043B8A 8841            	  6340:     or.w    D1,D4
02:00043B8C 48C4            	  6341:     ext.l   D4
02:00043B8E D8BC00FF0000    	  6342:     add.l   #NES_RAM,D4
02:00043B94 2044            	  6343:     movea.l D4,A0
02:00043B96 11803000        	  6344:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6345: _anon_z05_124:
                            	  6346:     ; Add the door to the opened door mask, reset door command,
                            	  6347:     ; and lay out doors.
                            	  6348:     ;
02:00043B9A 102C0055        	  6349:     move.b  ($0055,A4),D0
02:00043B9E 122C00EE        	  6350:     move.b  ($00EE,A4),D1
02:00043BA2 8001            	  6351:     or.b  D1,D0
02:00043BA4 6000FF66        	  6352:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6353: 
                            	  6354: ; Params:
                            	  6355: ; [08]: 0 if closed
                            	  6356: ;
                            	  6357: ; Returns:
                            	  6358: ; X: current length of dynamic transfer buf
                            	  6359: ; [00]: door VRAM address high byte
                            	  6360: ; [01]: door VRAM address low byte
                            	  6361: ; [02:03]: address of door tiles for direction and face
                            	  6362: ; [05]: 2, the number of transfer records to write
                            	  6363: ; [06]: 2, the number of tiles in each record
                            	  6364: ; [07]: 0, the first index of a tile to transfer
                            	  6365: ; [09]: door direction index
                            	  6366: ;
                            	  6367: ; Note that this routine is called with triggered doors:
                            	  6368: ; doors that can change state. Their door type numbers are >= 4.
                            	  6369: ;
                            	  6370: ; If this routine were ever called with a fixed door
                            	  6371: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6372: ; values for the door face.
                            	  6373: ;
                            	  6374: ;
                            	  6375: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6376: ;
                            	  6377:     even
                            	  6378: PrepareWriteHorizontalDoorTransferRecords:
02:00043BA8 102C0055        	  6379:     move.b  ($0055,A4),D0
02:00043BAC 19400002        	  6380:     move.b  D0,($0002,A4)
02:00043BB0 6100F9A4        	  6381:     jsr     FindDoorAttrByDoorBit
02:00043BB4 0C000005        	  6382:     cmpi.b  #$05,D0
02:00043BB8 650C            	  6383:     bcs  _anon_z05_125
02:00043BBA 1B00            	  6384:     move.b  D0,-(A5)  ; PHA
02:00043BBC 7004            	  6385:     moveq   #4,D0
02:00043BBE 4EB9000306EC    	  6386:     jsr     PlaySample
02:00043BC4 101D            	  6387:     move.b  (A5)+,D0  ; PLA
                            	  6388: _anon_z05_125:
                            	  6389:     ; Calculate the door face index in three parts.
                            	  6390:     ;
                            	  6391:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6392:     ; (provisional face index in Y register).
                            	  6393:     ;
02:00043BC6 0C000004        	  6394:     cmpi.b  #$04,D0
02:00043BCA 6602            	  6395:     bne  _anon_z05_126
02:00043BCC 7008            	  6396:     moveq   #8,D0
                            	  6397: _anon_z05_126:
02:00043BCE 0C000001        	  6398:     cmpi.b  #$01,D0
02:00043BD2 6602            	  6399:     bne  _anon_z05_127
02:00043BD4 7004            	  6400:     moveq   #4,D0
                            	  6401: _anon_z05_127:
                            	  6402:     ; Second, subtract 3 from provisional face index.
                            	  6403:     ;
02:00043BD6 003C0011        	  6404:     ori     #$11,CCR  ; SEC: set C+X
02:00043BDA 123C0003        	  6405:     move.b  #$03,D1
02:00043BDE 0A3C0010        	  6406:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043BE2 9101            	  6407:     subx.b  D1,D0   ; SBC #$03
02:00043BE4 0A3C0010        	  6408:     eori    #$10,CCR  ; restore X = 6502 C
02:00043BE8 7600            	  6409:     moveq   #0,D3
02:00043BEA 1600            	  6410:     move.b  D0,D3
                            	  6411:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6412:     ; face index >= 3, then subtract 1 from it.
                            	  6413:     ;
                            	  6414:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6415:     ; then make it 1.
                            	  6416:     ;
02:00043BEC 102C0008        	  6417:     move.b  ($0008,A4),D0
02:00043BF0 6708            	  6418:     beq  _anon_z05_128
02:00043BF2 0C030005        	  6419:     cmpi.b  #$05,D3
02:00043BF6 670A            	  6420:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043BF8 7601            	  6421:     moveq   #1,D3
                            	  6422: _anon_z05_128:
02:00043BFA 0C030003        	  6423:     cmpi.b  #$03,D3
02:00043BFE 6502            	  6424:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043C00 5303            	  6425:     subq.b  #1,D3
                            	  6426:     even
                            	  6427: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6428:     ; The routine that returned the door type also returned its
                            	  6429:     ; reverse direction index in [03].
                            	  6430:     ;
                            	  6431:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6432:     ;
02:00043C02 7003            	  6433:     moveq   #3,D0
02:00043C04 003C0011        	  6434:     ori     #$11,CCR  ; SEC: set C+X
02:00043C08 122C0003        	  6435:     move.b  ($0003,A4),D1
02:00043C0C 0A3C0010        	  6436:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C10 9101            	  6437:     subx.b  D1,D0   ; SBC $03
02:00043C12 0A3C0010        	  6438:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6439:     ; Call this to put the address of door face tiles in [02:03].
                            	  6440:     ;
02:00043C16 6100FD7A        	  6441:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6442:     ; Return the address of the door in the nametable in [01:00].
                            	  6443:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6444:     ;
02:00043C1A 41F9000439F0    	  6445:     lea     (DoorVramAddrsHi).l,A0
02:00043C20 10302000        	  6446:     move.b  (A0,D2.W),D0
02:00043C24 1880            	  6447:     move.b  D0,($0000,A4)
02:00043C26 41F9000439F4    	  6448:     lea     (DoorVramAddrsLo).l,A0
02:00043C2C 10302000        	  6449:     move.b  (A0,D2.W),D0
02:00043C30 19400001        	  6450:     move.b  D0,($0001,A4)
                            	  6451:     ; Return the direction of the door in [09], and the dynamic
                            	  6452:     ; transfer buf length in X register.
                            	  6453:     ;
02:00043C34 19420009        	  6454:     move.b  D2,($0009,A4)
02:00043C38 7400            	  6455:     moveq   #0,D2
02:00043C3A 142C0301        	  6456:     move.b  ($0301,A4),D2
                            	  6457:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6458:     ;
02:00043C3E 7000            	  6459:     moveq   #0,D0
02:00043C40 19400007        	  6460:     move.b  D0,($0007,A4)
02:00043C44 7002            	  6461:     moveq   #2,D0
02:00043C46 19400006        	  6462:     move.b  D0,($0006,A4)
02:00043C4A 19400005        	  6463:     move.b  D0,($0005,A4)
02:00043C4E 0A3C0001        	  6464:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043C52 4E75            	  6465:     rts
