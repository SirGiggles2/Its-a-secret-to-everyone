                            	   583: _L_z02_UpdateMode0Demo_Sub2_LoopHeart:
02:0003368A 1214            	   584:     move.b  ($00,A4),D1   ; ptr lo
02:0003368C 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:00033690 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033694 E14C            	   587:     lsl.w   #8,D4
02:00033696 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033698 48C4            	   589:     ext.l   D4
02:0003369A D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000336A0 2044            	   591:     movea.l D4,A0
02:000336A2 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000336A6 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:000336A8 1002            	   594:     move.b  D2,D0
02:000336AA E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:000336AC 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:000336AE 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:000336B0 020000F0        	   602:     andi.b #$F0,D0
02:000336B4 1940000C        	   603:     move.b  D0,($000C,A4)
02:000336B8 E208            	   604:     lsr.b  #1,D0   ; LSR A
