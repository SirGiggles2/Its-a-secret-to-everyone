02:0003B130 522C000F        	  3745:     addq.b  #1,($000F,A4)
                            	  3746:     even
                            	  3747: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B134 102C000D        	  3748:     move.b  ($000D,A4),D0
                            	  3749: ; Params:
                            	  3750: ; A: frame image
                            	  3751: ; X: object index
                            	  3752: ; [00]: object X
                            	  3753: ; [01]: object Y
                            	  3754: ; [0F]: flip horizontally
                            	  3755: ;
                            	  3756: ; Returns:
                            	  3757: ; [00]: 0 for Link slot
                            	  3758: ; [06]: 1 if objects collide
                            	  3759: ; [09]: 0 for Link damage type (none)
                            	  3760: ; [0C]: 1 if objects collide
                            	  3761: ; [034B]: ShotCollidesWithLink
                            	  3762: ;
                            	  3763:     even
