                            	  6140: __far_z_05_0093:
                            	  6141:     ; Turn the door command into the desired open or closed state
                            	  6142:     ; to store in [08].
                            	  6143:     ;
                            	  6144:     ; cmd:  7 6 3 2 
                            	  6145:     ; [08]: 2 0 0 0
                            	  6146:     ;
                            	  6147:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6148:     ; commands intended to be used.
                            	  6149:     ;
                            	  6150:     ; 3 is the end state of 2: close
                            	  6151:     ; 7 is the end state of 6: open
                            	  6152:     ;
02:00043A18 02000007        	  6153:     andi.b #$07,D0
02:00043A1C 7601            	  6154:     moveq   #1,D3
02:00043A1E 19430002        	  6155:     move.b  D3,($0002,A4)
02:00043A22 122C0002        	  6156:     move.b  ($0002,A4),D1
02:00043A26 C200            	  6157:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043A28 6702            	  6158:     beq  _anon_z05_118
02:00043A2A E208            	  6159:     lsr.b  #1,D0   ; LSR A
                            	  6160: _anon_z05_118:
02:00043A2C 0C000002        	  6161:     cmpi.b  #$02,D0
02:00043A30 6606            	  6162:     bne  _anon_z05_119
                            	  6163:     ; Command 2 sets Link's timer to $30.
                            	  6164:     ;
02:00043A32 7630            	  6165:     moveq   #48,D3
02:00043A34 19430028        	  6166:     move.b  D3,($0028,A4)
                            	  6167: _anon_z05_119:
02:00043A38 02000003        	  6168:     andi.b #$03,D0
02:00043A3C 003C0011        	  6169:     ori     #$11,CCR  ; SEC: set C+X
02:00043A40 123C0001        	  6170:     move.b  #$01,D1
02:00043A44 0A3C0010        	  6171:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A48 9101            	  6172:     subx.b  D1,D0   ; SBC #$01
02:00043A4A 0A3C0010        	  6173:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A4E 02000002        	  6174:     andi.b #$02,D0
02:00043A52 19400008        	  6175:     move.b  D0,($0008,A4)
