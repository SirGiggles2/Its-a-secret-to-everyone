                            	 12221:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	 12222:     ;
02:0003EF26 41EC0098        	 12223:     lea     ($0098,A4),A0
02:0003EF2A 10302000        	 12224:     move.b  (A0,D2.W),D0
02:0003EF2E 122C0002        	 12225:     move.b  ($0002,A4),D1
02:0003EF32 E309            	 12226:     lsl.b  #1,D1   ; ASL $02
02:0003EF34 19410002        	 12227:     move.b  D1,($0002,A4)
02:0003EF38 122C0002        	 12228:     move.b  ($0002,A4),D1
02:0003EF3C C200            	 12229:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF3E 6716            	 12230:     beq  _L_z04_Lamnola_Move_Up
02:0003EF40 41EC0084        	 12231:     lea     ($0084,A4),A0
02:0003EF44 10302000        	 12232:     move.b  (A0,D2.W),D0
02:0003EF48 122C04E6        	 12233:     move.b  ($04E6,A4),D1
02:0003EF4C D101            	 12234:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EF4E 41EC0084        	 12235:     lea     ($0084,A4),A0
02:0003EF52 11802000        	 12236:     move.b  D0,(A0,D2.W)
                            	 12237:     even
