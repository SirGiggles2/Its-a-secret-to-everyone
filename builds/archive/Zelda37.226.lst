02:0003E070 023C00EE        	 10239:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E074 123C0008        	 10240:     move.b  #$08,D1
02:0003E078 D101            	 10241:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E07A 19802070        	 10242:     move.b  D0,($70,A4,D2.W)
02:0003E07E 532C000F        	 10243:     subq.b  #1,($000F,A4)
02:0003E082 66E2            	 10244:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	 10245:     ; Restore the boss's X coordinate.
                            	 10246:     ;
02:0003E084 101D            	 10247:     move.b  (A5)+,D0  ; PLA
02:0003E086 19802070        	 10248:     move.b  D0,($70,A4,D2.W)
02:0003E08A 4E75            	 10249:     rts
