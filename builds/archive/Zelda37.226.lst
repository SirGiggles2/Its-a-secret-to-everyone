                            	  5801: _L_z01_CheckMazes_PlaySecretTune:
                            	  5802:     ; Play secret tune, and let the player leave the maze.
                            	  5803:     ;
02:000314C0 7004            	  5804:     moveq   #4,D0
02:000314C2 19400602        	  5805:     move.b  D0,($0602,A4)
02:000314C6 4E75            	  5806:     rts
                            	  5807: 
                            	  5808: ; Params:
                            	  5809: ; [02]: Y
                            	  5810: ; [03]: X
                            	  5811: ;
                            	  5812: ; Returns:
                            	  5813: ; [00]: high byte of PPU address
                            	  5814: ; [01]: low byte of PPU address
                            	  5815: ;
                            	  5816: ;
                            	  5817: ; Turn the 16-bit value 08YY into the PPU address
                            	  5818: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5819: ;
                            	  5820: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5821: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5822: ;
                            	  5823:     even
                            	  5824: MapScreenPosToPpuAddr:
02:000314C8 6000A59C        	  5825:     jmp     c_map_screen_pos_to_ppu_addr
