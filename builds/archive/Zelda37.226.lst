02:00036430 0A3C0010        	  4779:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036434 9101            	  4780:     subx.b  D1,D0   ; SBC #$10
02:00036436 0A3C0010        	  4781:     eori    #$10,CCR  ; restore X = 6502 C
