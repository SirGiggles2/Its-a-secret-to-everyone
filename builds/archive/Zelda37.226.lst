02:0003A9F4 610001A0        	  2777:     jsr     Jumper_GetKind
02:0003A9F8 41F90003A922    	  2778:     lea     (JumperStartSpeedsHi).l,A0
02:0003A9FE 10303000        	  2779:     move.b  (A0,D3.W),D0
02:0003AA02 41EC0412        	  2780:     lea     ($0412,A4),A0
