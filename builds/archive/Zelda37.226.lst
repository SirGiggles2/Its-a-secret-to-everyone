                            	 10113: _L_z04_UpdateGohma_AnimateClosedEye:
                            	 10114:     ; Here the eye is closed. So animate it this way.
                            	 10115:     ; Increment the animation counter, and if <> 8, then
                            	 10116:     ; go shoot, draw, and check collisions.
                            	 10117:     ;
02:0003DF9C 41EC0478        	 10118:     lea     ($0478,A4),A0
02:0003DFA0 52302000        	 10119:     addq.b  #1,(A0,D2.W)
02:0003DFA4 41EC0478        	 10120:     lea     ($0478,A4),A0
02:0003DFA8 10302000        	 10121:     move.b  (A0,D2.W),D0
02:0003DFAC 0C000008        	 10122:     cmpi.b  #$08,D0
02:0003DFB0 66C2            	 10123:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	 10124:     ; Roll over the eye animation counter to 0.
                            	 10125:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	 10126:     ;
02:0003DFB2 7000            	 10127:     moveq   #0,D0
02:0003DFB4 41EC0478        	 10128:     lea     ($0478,A4),A0
02:0003DFB8 11802000        	 10129:     move.b  D0,(A0,D2.W)
02:0003DFBC 41EC046B        	 10130:     lea     ($046B,A4),A0
02:0003DFC0 10302000        	 10131:     move.b  (A0,D2.W),D0
02:0003DFC4 02000001        	 10132:     andi.b #$01,D0
02:0003DFC8 0A000001        	 10133:     eori.b #$01,D0
                            	 10134:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	 10135:     ;
02:0003DFCC 609E            	 10136:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	 10137: 
                            	 10138:     even
                            	 10139: GohmaLegOffsetsX:
02:0003DFCE F0              	 10140:     dc.b    $F0, $10
02:0003DFCF 10
                            	 10141: 
                            	 10142: ; Params:
                            	 10143: ; A: eye frame image
                            	 10144: ;
                            	 10145: ; Draw the eye with the frame image passed in.
                            	 10146: ;
                            	 10147:     even
                            	 10148: Gohma_AnimateAndDraw:
02:0003DFD0 1B00            	 10149:     move.b  D0,-(A5)  ; PHA
02:0003DFD2 4EB90004D1BE    	 10150:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003DFD8 6164            	 10151:     jsr     Gohma_SetSpriteAttributes
02:0003DFDA 101D            	 10152:     move.b  (A5)+,D0  ; PLA
02:0003DFDC 4EB900031722    	 10153:     jsr     DrawObjectMirrored
02:0003DFE2 7010            	 10154:     moveq   #16,D0
02:0003DFE4 4EB90004D1B8    	 10155:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10156:     ; Draw the right legs.
                            	 10157:     ;
02:0003DFEA 7601            	 10158:     moveq   #1,D3
02:0003DFEC 6102            	 10159:     jsr     Gohma_DrawLegsOneSide
                            	 10160:     ; Draw the left legs.
                            	 10161:     ;
02:0003DFEE 7600            	 10162:     moveq   #0,D3
                            	 10163: ; Params:
                            	 10164: ; Y: side: 0 for left, 1 for right
                            	 10165: ;
                            	 10166: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10167: ; store the sprite's X in [00].
                            	 10168: ;
                            	 10169:     even
                            	 10170: Gohma_DrawLegsOneSide:
02:0003DFF0 10342070        	 10171:     move.b  ($70,A4,D2.W),D0
02:0003DFF4 023C00EE        	 10172:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFF8 41F90003DFCE    	 10173:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFFE 12303000        	 10174:     move.b  (A0,D3.W),D1
02:0003E002 D101            	 10175:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E004 1880            	 10176:     move.b  D0,($0000,A4)
                            	 10177:     ; The object's Y is the sprite's.
                            	 10178:     ;
02:0003E006 41EC0084        	 10179:     lea     ($0084,A4),A0
02:0003E00A 10302000        	 10180:     move.b  (A0,D2.W),D0
02:0003E00E 19400001        	 10181:     move.b  D0,($0001,A4)
02:0003E012 612A            	 10182:     jsr     Gohma_SetSpriteAttributes
                            	 10183:     ; There are only two frame images for legs: left and right.
                            	 10184:     ; There are two animation frames. They are animated as follows:
                            	 10185:     ;
                            	 10186:     ; Frame 0:
                            	 10187:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10188:     ; horizontal flipping = frame number = 0
                            	 10189:     ; 
                            	 10190:     ; Frame 1:
                            	 10191:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10192:     ; horizontal flipping = frame number = 1
                            	 10193:     ;
02:0003E014 4EB90004D190    	 10194:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E01A 1003            	 10195:     move.b  D3,D0
02:0003E01C 023C00EE        	 10196:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E020 41EC03E4        	 10197:     lea     ($03E4,A4),A0
02:0003E024 12302000        	 10198:     move.b  (A0,D2.W),D1
02:0003E028 D101            	 10199:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E02A 02000001        	 10200:     andi.b #$01,D0
02:0003E02E 023C00EE        	 10201:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E032 123C0004        	 10202:     move.b  #$04,D1
02:0003E036 D101            	 10203:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E038 4EF900031726    	 10204:     jmp     DrawObjectNotMirrored
                            	 10205: 
                            	 10206: ; Returns:
                            	 10207: ; [04]: left side sprite attributes
                            	 10208: ; [05]: right side sprite attributes
                            	 10209: ;
                            	 10210:     even
                            	 10211: Gohma_SetSpriteAttributes:
02:0003E03E 4EF90002BF4C    	 10212:     jmp     c_gohma_set_sprite_attributes
                            	 10213: 
                            	 10214: Gohma_CheckCollisions:
                            	 10215:     ; Save the boss's X coordinate.
                            	 10216:     ;
02:0003E044 10342070        	 10217:     move.b  ($70,A4,D2.W),D0
02:0003E048 1B00            	 10218:     move.b  D0,-(A5)  ; PHA
                            	 10219:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10220:     ; on the left side.
                            	 10221:     ;
02:0003E04A 003C0011        	 10222:     ori     #$11,CCR  ; SEC: set C+X
02:0003E04E 123C0010        	 10223:     move.b  #$10,D1
02:0003E052 0A3C0010        	 10224:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E056 9101            	 10225:     subx.b  D1,D0   ; SBC #$10
02:0003E058 0A3C0010        	 10226:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E05C 19802070        	 10227:     move.b  D0,($70,A4,D2.W)
                            	 10228:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10229:     ; from left to right, indexed by [0F].
                            	 10230:     ;
02:0003E060 7005            	 10231:     moveq   #5,D0
02:0003E062 1940000F        	 10232:     move.b  D0,($000F,A4)
                            	 10233:     even
                            	 10234: _L_z04_Gohma_CheckCollisions_LoopSprite:
