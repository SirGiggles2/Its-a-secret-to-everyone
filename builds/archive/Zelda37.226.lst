02:00043572 7600            	  5470:     moveq   #0,D3
02:00043574 162C0003        	  5471:     move.b  ($0003,A4),D3
02:00043578 0C030002        	  5472:     cmpi.b  #$02,D3
02:0004357C 6510            	  5473:     bcs  _anon_z05_106
02:0004357E 7600            	  5474:     moveq   #0,D3
02:00043580 162C00EB        	  5475:     move.b  ($00EB,A4),D3
02:00043584 41F900FF68FE    	  5476:     lea     (NES_SRAM+$08FE).l,A0
02:0004358A 10303000        	  5477:     move.b  (A0,D3.W),D0
