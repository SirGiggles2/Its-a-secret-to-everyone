02:00041116 41F900FF6AFE    	  1835:     lea     (NES_SRAM+$0AFE).l,A0
02:0004111C 10303000        	  1836:     move.b  (A0,D3.W),D0
02:00041120 02000007        	  1837:     andi.b #$07,D0
02:00041124 E308            	  1838:     lsl.b  #1,D0   ; ASL A
02:00041126 E308            	  1839:     lsl.b  #1,D0   ; ASL A
02:00041128 E308            	  1840:     lsl.b  #1,D0   ; ASL A
02:0004112A E308            	  1841:     lsl.b  #1,D0   ; ASL A
                            	  1842:     ; Add the first Y where Link can come out of underground.
