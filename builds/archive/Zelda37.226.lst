                            	   756: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   757:     ; Replace the low byte of the VRAM address with the one
                            	   758:     ; where the next character should be written.
                            	   759:     ;
02:0002E212 102C045F        	   760:     move.b  ($045F,A4),D0
02:0002E216 19400303        	   761:     move.b  D0,($0303,A4)
                            	   762:     ; Increment the low VRAM address for the next character.
                            	   763:     ;
02:0002E21A 522C045F        	   764:     addq.b  #1,($045F,A4)
                            	   765:     ; Use the person text selector to look up the address of the
                            	   766:     ; text for the textbox. Store the address in [00:01].
                            	   767:     ;
02:0002E21E 7600            	   768:     moveq   #0,D3
02:0002E220 162C0415        	   769:     move.b  ($0415,A4),D3
02:0002E224 41F90002D85A    	   770:     lea     (PersonTextAddrs).l,A0
02:0002E22A 10303000        	   771:     move.b  (A0,D3.W),D0
02:0002E22E 1880            	   772:     move.b  D0,($0000,A4)
02:0002E230 5203            	   773:     addq.b  #1,D3
02:0002E232 41F90002D85A    	   774:     lea     (PersonTextAddrs).l,A0
02:0002E238 10303000        	   775:     move.b  (A0,D3.W),D0
02:0002E23C 19400001        	   776:     move.b  D0,($0001,A4)
                            	   777:     ; Load the person text current character index.
                            	   778:     ;
02:0002E240 7600            	   779:     moveq   #0,D3
02:0002E242 162C0416        	   780:     move.b  ($0416,A4),D3
                            	   781:     ; Increment the index variable to point to the next character
                            	   782:     ; for next time.
                            	   783:     ;
02:0002E246 522C0416        	   784:     addq.b  #1,($0416,A4)
                            	   785:     ; Get the current character.
                            	   786:     ;
02:0002E24A 1214            	   787:     move.b  ($00,A4),D1   ; ptr lo
02:0002E24C 182C0001        	   788:     move.b  ($01,A4),D4  ; ptr hi
02:0002E250 024100FF        	   789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E254 E14C            	   790:     lsl.w   #8,D4
02:0002E256 8841            	   791:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E258 48C4            	   792:     ext.l   D4
02:0002E25A D8BC00FF0000    	   793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E260 2044            	   794:     movea.l D4,A0
02:0002E262 10303000        	   795:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   796:     ; If the character is $25, then it's a special space. It will still
                            	   797:     ; take up space, but will not take time to show -- meaning that
                            	   798:     ; we'll go look up the next character to transfer.
                            	   799:     ;
02:0002E266 0200003F        	   800:     andi.b #$3F,D0
02:0002E26A 0C000025        	   801:     cmpi.b  #$25,D0
02:0002E26E 67A2            	   802:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   803:     ; We have a non-space character. Put it in the transfer record.
                            	   804:     ;
02:0002E270 19400305        	   805:     move.b  D0,($0305,A4)
                            	   806:     ; Play the "heart taken/character" sound effect.
                            	   807:     ;
02:0002E274 7010            	   808:     moveq   #16,D0
02:0002E276 19400604        	   809:     move.b  D0,($0604,A4)
                            	   810:     ; If the high 2 bits of character element = 0, then return.
                            	   811:     ;
02:0002E27A 1214            	   812:     move.b  ($00,A4),D1   ; ptr lo
02:0002E27C 182C0001        	   813:     move.b  ($01,A4),D4  ; ptr hi
02:0002E280 024100FF        	   814:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E284 E14C            	   815:     lsl.w   #8,D4
02:0002E286 8841            	   816:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E288 48C4            	   817:     ext.l   D4
02:0002E28A D8BC00FF0000    	   818:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E290 2044            	   819:     movea.l D4,A0
02:0002E292 10303000        	   820:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E296 020000C0        	   821:     andi.b #$C0,D0
02:0002E29A 672E            	   822:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   823:     ; Determine an index based on the high 2 bits of the character element:
                            	   824:     ;   $80: 0
                            	   825:     ;   $40: 1
                            	   826:     ;   $C0: 2
                            	   827:     ;
02:0002E29C 7602            	   828:     moveq   #2,D3
02:0002E29E 0C0000C0        	   829:     cmpi.b  #$C0,D0
02:0002E2A2 670A            	   830:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E2A4 5303            	   831:     subq.b  #1,D3
02:0002E2A6 0C000040        	   832:     cmpi.b  #$40,D0
02:0002E2AA 6702            	   833:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E2AC 5303            	   834:     subq.b  #1,D3
                            	   835:     even
                            	   836: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   837:     ; The index chooses the low VRAM address of the start
                            	   838:     ; of another line:
                            	   839:     ;   0: $C4: front of the second line
                            	   840:     ;   1: $E4: front of the third line
                            	   841:     ;   2: $A4: front of the first line
                            	   842:     ;
                            	   843:     ; Look up the low VRAM address and store it.
                            	   844:     ;
02:0002E2AE 41F90002E1DC    	   845:     lea     (TextboxLineAddrsLo).l,A0
02:0002E2B4 10303000        	   846:     move.b  (A0,D3.W),D0
02:0002E2B8 1940045F        	   847:     move.b  D0,($045F,A4)
                            	   848:     ; If index = 2, then we've reached the end of the text,
                            	   849:     ; and low VRAM address is moved to the front of the first line.
                            	   850:     ; So, advance the state of the person object, and unhalt Link.
                            	   851:     ;
02:0002E2BC 0C030002        	   852:     cmpi.b  #$02,D3
