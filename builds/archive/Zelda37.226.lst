                            	   227:     ; Move position markers and hardware vertical scroll position
                            	   228:     ; down 1 pixel.
                            	   229:     ;
                            	   230:     ; Because we'll be above the top of NT 0, switch to NT 2 to
                            	   231:     ; be at the bottom of NT 2.
                            	   232:     ;
02:0004014A 103C00EF        	   233:     move.b  #$EF,D0
02:0004014E 194000FC        	   234:     move.b  D0,($00FC,A4)
02:00040152 1940005C        	   235:     move.b  D0,($005C,A4)
02:00040156 7001            	   236:     moveq   #1,D0
02:00040158 610001A4        	   237:     jsr     MovePositionMarkers
02:0004015C 522C00E1        	   238:     addq.b  #1,($00E1,A4)
                            	   239:     ; SubmenuScrollProgress begins at $2B. Each frame it will be
                            	   240:     ; decremented. It encodes a submenu row index in bits 1 to 7,
                            	   241:     ; and a flag in bit 0.
                            	   242:     ;
                            	   243:     ; When the flag is 1, a full row of black tiles will be transferred
                            	   244:     ; at the current row. Otherwise, one of various static visual
                            	   245:     ; elements will be transferred.
                            	   246:     ;
                            	   247:     ; For example:
                            	   248:     ; 1. In the first frame of scrolling, $2B indicates that a full row
                            	   249:     ;    of black tiles must be transferred to row $15.
                            	   250:     ; 2. In the second frame ($2A), submenu row will again be
                            	   251:     ;    $15, but something else will be transferred.
                            	   252:     ; 3. In the third frame ($29), a full row of black tiles will be
                            	   253:     ;    transferred to row $14.
                            	   254:     ;
02:00040160 702B            	   255:     moveq   #43,D0
02:00040162 1940005E        	   256:     move.b  D0,($005E,A4)
                            	   257:     ; In UW, this variable will be used to scan every room in order
                            	   258:     ; to build the big sheet map in the submenu. It will range
                            	   259:     ; from $7F to 0.
                            	   260:     ;
02:00040166 707F            	   261:     moveq   #127,D0
02:00040168 1940005D        	   262:     move.b  D0,($005D,A4)
