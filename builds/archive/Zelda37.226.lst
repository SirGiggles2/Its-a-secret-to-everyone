02:0003DE54 023C00EE        	  9950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE58 123C0080        	  9951:     move.b  #$80,D1
02:0003DE5C D101            	  9952:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE5E 41EC041F        	  9953:     lea     ($041F,A4),A0
02:0003DE62 11802000        	  9954:     move.b  D0,(A0,D2.W)
                            	  9955:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9956:     ;
02:0003DE66 640000A8        	  9957:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9958:     ; Increase the distance traveled, and move 1.
                            	  9959:     ;
02:0003DE6A 41EC0412        	  9960:     lea     ($0412,A4),A0
02:0003DE6E 52302000        	  9961:     addq.b  #1,(A0,D2.W)
                            	  9962:     ; Set a direction mask in [02], starting with right (1).
                            	  9963:     ;
02:0003DE72 7001            	  9964:     moveq   #1,D0
02:0003DE74 19400002        	  9965:     move.b  D0,($0002,A4)
                            	  9966:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9967:     ;
02:0003DE78 41EC0098        	  9968:     lea     ($0098,A4),A0
02:0003DE7C 10302000        	  9969:     move.b  (A0,D2.W),D0
02:0003DE80 122C0002        	  9970:     move.b  ($0002,A4),D1
02:0003DE84 C200            	  9971:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE86 6704            	  9972:     beq  _anon_z04_118
02:0003DE88 52342070        	  9973:     addq.b  #1,($70,A4,D2.W)
                            	  9974: _anon_z04_118:
                            	  9975:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9976:     ;
02:0003DE8C 122C0002        	  9977:     move.b  ($0002,A4),D1
02:0003DE90 E309            	  9978:     lsl.b  #1,D1   ; ASL $02
02:0003DE92 19410002        	  9979:     move.b  D1,($0002,A4)
02:0003DE96 122C0002        	  9980:     move.b  ($0002,A4),D1
02:0003DE9A C200            	  9981:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE9C 6704            	  9982:     beq  _anon_z04_119
02:0003DE9E 53342070        	  9983:     subq.b  #1,($70,A4,D2.W)
                            	  9984: _anon_z04_119:
                            	  9985:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9986:     ;
02:0003DEA2 122C0002        	  9987:     move.b  ($0002,A4),D1
02:0003DEA6 E309            	  9988:     lsl.b  #1,D1   ; ASL $02
02:0003DEA8 19410002        	  9989:     move.b  D1,($0002,A4)
02:0003DEAC 122C0002        	  9990:     move.b  ($0002,A4),D1
02:0003DEB0 C200            	  9991:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEB2 6708            	  9992:     beq  _anon_z04_120
02:0003DEB4 41EC0084        	  9993:     lea     ($0084,A4),A0
02:0003DEB8 52302000        	  9994:     addq.b  #1,(A0,D2.W)
                            	  9995: _anon_z04_120:
                            	  9996:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9997:     ;
02:0003DEBC 122C0002        	  9998:     move.b  ($0002,A4),D1
02:0003DEC0 E309            	  9999:     lsl.b  #1,D1   ; ASL $02
02:0003DEC2 19410002        	 10000:     move.b  D1,($0002,A4)
02:0003DEC6 122C0002        	 10001:     move.b  ($0002,A4),D1
02:0003DECA C200            	 10002:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DECC 6708            	 10003:     beq  _anon_z04_121
02:0003DECE 41EC0084        	 10004:     lea     ($0084,A4),A0
02:0003DED2 53302000        	 10005:     subq.b  #1,(A0,D2.W)
                            	 10006: _anon_z04_121:
                            	 10007:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10008:     ;
02:0003DED6 41EC0412        	 10009:     lea     ($0412,A4),A0
02:0003DEDA 10302000        	 10010:     move.b  (A0,D2.W),D0
02:0003DEDE 0C000020        	 10011:     cmpi.b  #$20,D0
02:0003DEE2 662C            	 10012:     bne  _L_z04_UpdateGohma_AnimateEye
                            	 10013:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	 10014:     ; Reverse the facing direction, and increase the number of sprints.
                            	 10015:     ;
02:0003DEE4 7000            	 10016:     moveq   #0,D0
02:0003DEE6 41EC0412        	 10017:     lea     ($0412,A4),A0
02:0003DEEA 11802000        	 10018:     move.b  D0,(A0,D2.W)
02:0003DEEE 61001DBA        	 10019:     jsr     ReverseObjDir8
02:0003DEF2 41EC045E        	 10020:     lea     ($045E,A4),A0
02:0003DEF6 10302000        	 10021:     move.b  (A0,D2.W),D0
02:0003DEFA 41EC045E        	 10022:     lea     ($045E,A4),A0
02:0003DEFE 52302000        	 10023:     addq.b  #1,(A0,D2.W)
                            	 10024:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10025:     ; should randomly change direction.
                            	 10026:     ;
02:0003DF02 E208            	 10027:     lsr.b  #1,D0   ; LSR A
02:0003DF04 640A            	 10028:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DF06 7000            	 10029:     moveq   #0,D0
02:0003DF08 41EC0451        	 10030:     lea     ($0451,A4),A0
02:0003DF0C 11802000        	 10031:     move.b  D0,(A0,D2.W)
                            	 10032:     even
                            	 10033: _L_z04_UpdateGohma_AnimateEye:
                            	 10034:     ; Animate the eye.
                            	 10035:     ;
                            	 10036:     ; First, if the counter for when to open the eye next = 0, then
                            	 10037:     ; set it to a random value at least $C0; and set the timer for
                            	 10038:     ; keeping the eye open to $80.
                            	 10039:     ;
                            	 10040:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10041:     ; every other frame.
                            	 10042:     ;
02:0003DF10 41EC042C        	 10043:     lea     ($042C,A4),A0
02:0003DF14 10302000        	 10044:     move.b  (A0,D2.W),D0
02:0003DF18 661E            	 10045:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF1A 103C0080        	 10046:     move.b  #$80,D0
02:0003DF1E 41EC0444        	 10047:     lea     ($0444,A4),A0
02:0003DF22 11802000        	 10048:     move.b  D0,(A0,D2.W)
02:0003DF26 103C00C0        	 10049:     move.b  #$C0,D0
02:0003DF2A 12342018        	 10050:     move.b  ($18,A4,D2.W),D1
02:0003DF2E 8001            	 10051:     or.b  D1,D0
02:0003DF30 41EC042C        	 10052:     lea     ($042C,A4),A0
02:0003DF34 11802000        	 10053:     move.b  D0,(A0,D2.W)
                            	 10054:     even
                            	 10055: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10056:     ; Decrement the next-open-eye counter.
                            	 10057:     ;
02:0003DF38 102C0015        	 10058:     move.b  ($0015,A4),D0
02:0003DF3C E208            	 10059:     lsr.b  #1,D0   ; LSR A
02:0003DF3E 6408            	 10060:     bcc  _anon_z04_122
02:0003DF40 41EC042C        	 10061:     lea     ($042C,A4),A0
02:0003DF44 53302000        	 10062:     subq.b  #1,(A0,D2.W)
                            	 10063: _anon_z04_122:
                            	 10064:     ; If open eye timer = 0, then the eye is closed.
                            	 10065:     ; Go animate it differently.
                            	 10066:     ;
02:0003DF48 41EC0444        	 10067:     lea     ($0444,A4),A0
02:0003DF4C 10302000        	 10068:     move.b  (A0,D2.W),D0
02:0003DF50 674A            	 10069:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10070:     ; Else decrement the open eye timer.
                            	 10071:     ;
02:0003DF52 41EC0444        	 10072:     lea     ($0444,A4),A0
02:0003DF56 53302000        	 10073:     subq.b  #1,(A0,D2.W)
                            	 10074:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10075:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10076:     ;
02:0003DF5A 7602            	 10077:     moveq   #2,D3
02:0003DF5C 0C000070        	 10078:     cmpi.b  #$70,D0
02:0003DF60 6408            	 10079:     bcc  _anon_z04_123
02:0003DF62 0C000010        	 10080:     cmpi.b  #$10,D0
02:0003DF66 6502            	 10081:     bcs  _anon_z04_123
02:0003DF68 5203            	 10082:     addq.b  #1,D3
                            	 10083: _anon_z04_123:
02:0003DF6A 1003            	 10084:     move.b  D3,D0
                            	 10085:     even
                            	 10086: _L_z04_UpdateGohma_SetEyeStateAndShoot:
02:0003DF6C 41EC046B        	 10087:     lea     ($046B,A4),A0
