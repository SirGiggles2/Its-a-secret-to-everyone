02:0003DC4C 0C020005        	  9666:     cmpi.b  #$05,D2
02:0003DC50 660A            	  9667:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC52 41EC0405        	  9668:     lea     ($0405,A4),A0
