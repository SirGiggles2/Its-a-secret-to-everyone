02:0003D064 023C00EE        	  8077:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D068 123C0008        	  8078:     move.b  #$08,D1
02:0003D06C D101            	  8079:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D06E 020000F0        	  8080:     andi.b #$F0,D0
