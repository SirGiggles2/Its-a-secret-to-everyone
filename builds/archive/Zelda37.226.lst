02:0002DFA2 7600            	   408:     moveq   #0,D3
02:0002DFA4 41EC046C        	   409:     lea     ($046C,A4),A0
02:0002DFA8 16302000        	   410:     move.b  (A0,D2.W),D3
02:0002DFAC 41EC046F        	   411:     lea     ($046F,A4),A0
02:0002DFB0 10303000        	   412:     move.b  (A0,D3.W),D0
02:0002DFB4 41EC0448        	   413:     lea     ($0448,A4),A0
02:0002DFB8 11802000        	   414:     move.b  D0,(A0,D2.W)
02:0002DFBC 5302            	   415:     subq.b  #1,D2
02:0002DFBE 6AE2            	   416:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
