                            	  5895:     ; Else make it 4 (open "door").
                            	  5896:     ;
02:00043874 0C000008        	  5897:     cmpi.b  #$08,D0
02:00043878 67A4            	  5898:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
