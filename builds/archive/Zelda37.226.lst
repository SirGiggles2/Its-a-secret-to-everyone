                            	 13174: Ganon_CheckCollisions:
                            	 13175:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13176:     ; Store in [02] and [03].
                            	 13177:     ;
02:0003F5EC 10342070        	 13178:     move.b  ($70,A4,D2.W),D0
02:0003F5F0 023C00EE        	 13179:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5F4 123C0010        	 13180:     move.b  #$10,D1
02:0003F5F8 D101            	 13181:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5FA 19400002        	 13182:     move.b  D0,($0002,A4)
02:0003F5FE 41EC0084        	 13183:     lea     ($0084,A4),A0
02:0003F602 10302000        	 13184:     move.b  (A0,D2.W),D0
02:0003F606 023C00EE        	 13185:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F60A 123C0010        	 13186:     move.b  #$10,D1
02:0003F60E D101            	 13187:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F610 19400003        	 13188:     move.b  D0,($0003,A4)
                            	 13189:     ; Check for a collision with Link.
                            	 13190:     ;
                            	 13191:     ; We can't call CheckLinkCollision, because we need to
                            	 13192:     ; customize Ganon's midpoint.
                            	 13193:     ;
                            	 13194:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13195:     ; detection, if Link is invincible. Initialize variables that will
                            	 13196:     ; be returned from the partial collision check routine. Then
                            	 13197:     ; call it.
                            	 13198:     ;
02:0003F614 102C04F0        	 13199:     move.b  ($04F0,A4),D0
02:0003F618 6616            	 13200:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F61A 19400006        	 13201:     move.b  D0,($0006,A4)
02:0003F61E 19400009        	 13202:     move.b  D0,($0009,A4)
02:0003F622 1940000C        	 13203:     move.b  D0,($000C,A4)
02:0003F626 7600            	 13204:     moveq   #0,D3
02:0003F628 1883            	 13205:     move.b  D3,($0000,A4)
02:0003F62A 4EB900031C22    	 13206:     jsr     CheckLinkCollisionPreinit
                            	 13207:     even
                            	 13208: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13209:     ; If Ganon is not in state 0, then he's brown.
                            	 13210:     ; Go check collision with an arrow.
                            	 13211:     ;
02:0003F630 41EC00AC        	 13212:     lea     ($00AC,A4),A0
02:0003F634 10302000        	 13213:     move.b  (A0,D2.W),D0
02:0003F638 6652            	 13214:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13215:     ; If timer <> 0, then Ganon is visible.
                            	 13216:     ; He can't be harmed like this. So, return.
                            	 13217:     ;
02:0003F63A 10342028        	 13218:     move.b  ($28,A4,D2.W),D0
02:0003F63E 664A            	 13219:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F640 760D            	 13220:     moveq   #13,D3
02:0003F642 4EB9000320EC    	 13221:     jsr     CheckMonsterSwordCollision
                            	 13222:     ; If Ganon has died according to the usual collision check rules
                            	 13223:     ; (HP = 0), then:
                            	 13224:     ; 1. Restore HP to the initial value $F0
                            	 13225:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13226:     ; 3. Change palette row 7 to make Ganon brown
                            	 13227:     ;
02:0003F648 41EC0405        	 13228:     lea     ($0405,A4),A0
02:0003F64C 10302000        	 13229:     move.b  (A0,D2.W),D0
02:0003F650 6718            	 13230:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F652 103C00F0        	 13231:     move.b  #$F0,D0
02:0003F656 41EC0485        	 13232:     lea     ($0485,A4),A0
02:0003F65A 11802000        	 13233:     move.b  D0,(A0,D2.W)
02:0003F65E 41EC00AC        	 13234:     lea     ($00AC,A4),A0
02:0003F662 53302000        	 13235:     subq.b  #1,(A0,D2.W)
02:0003F666 61000084        	 13236:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13237:     even
                            	 13238: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13239:     ; If Ganon was harmed, then play the sound effect
                            	 13240:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13241:     ;
02:0003F66A 41EC04F0        	 13242:     lea     ($04F0,A4),A0
02:0003F66E 10302000        	 13243:     move.b  (A0,D2.W),D0
02:0003F672 670A            	 13244:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F674 6100A17C        	 13245:     jsr     PlayBossHitCryIfNeeded
02:0003F678 7040            	 13246:     moveq   #64,D0
02:0003F67A 19802028        	 13247:     move.b  D0,($28,A4,D2.W)
                            	 13248:     even
                            	 13249: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13250:     ; Reset metastate, because Ganon cannot die this way.
                            	 13251:     ;
02:0003F67E 4EB90004D9C6    	 13252:     jsr     ResetObjMetastate
                            	 13253:     ; Reset shove info and invincibility timer, because Ganon
                            	 13254:     ; doesn't react at all as a usual monster.
                            	 13255:     ;
02:0003F684 4EB900031FF4    	 13256:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13257:     even
                            	 13258: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F68A 4E75            	 13259:     rts
                            	 13260: 
                            	 13261:     even
                            	 13262: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13263:     ; If the silver arrow is not in the inventory, then return.
                            	 13264:     ;
02:0003F68C 102C0659        	 13265:     move.b  ($0659,A4),D0
02:0003F690 0C000002        	 13266:     cmpi.b  #$02,D0
02:0003F694 66F4            	 13267:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13268:     ; Reset the collision return value [06].
                            	 13269:     ;
02:0003F696 7000            	 13270:     moveq   #0,D0
02:0003F698 19400006        	 13271:     move.b  D0,($0006,A4)
                            	 13272:     ; If there's no arrow in flight, then return.
                            	 13273:     ;
02:0003F69C 7612            	 13274:     moveq   #18,D3
02:0003F69E 41EC00AC        	 13275:     lea     ($00AC,A4),A0
02:0003F6A2 10303000        	 13276:     move.b  (A0,D3.W),D0
02:0003F6A6 0C000010        	 13277:     cmpi.b  #$10,D0
02:0003F6AA 66DE            	 13278:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13279:     ; Check for collision with an arrow; and return if no collision.
                            	 13280:     ;
02:0003F6AC 4EB900032148    	 13281:     jsr     CheckMonsterArrowOrRodCollision
02:0003F6B2 102C0006        	 13282:     move.b  ($0006,A4),D0
02:0003F6B6 67D2            	 13283:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13284:     ; Set the Ganon phase to "dying".
                            	 13285:     ;
02:0003F6B8 41EC042C        	 13286:     lea     ($042C,A4),A0
02:0003F6BC 52302000        	 13287:     addq.b  #1,(A0,D2.W)
                            	 13288:     ; Now his body does flash.
                            	 13289:     ;
02:0003F6C0 7028            	 13290:     moveq   #40,D0
02:0003F6C2 41EC04F0        	 13291:     lea     ($04F0,A4),A0
02:0003F6C6 11802000        	 13292:     move.b  D0,(A0,D2.W)
                            	 13293:     ; Set initial cloud distance 8.
                            	 13294:     ;
02:0003F6CA 7008            	 13295:     moveq   #8,D0
02:0003F6CC 41EC0478        	 13296:     lea     ($0478,A4),A0
02:0003F6D0 11802000        	 13297:     move.b  D0,(A0,D2.W)
02:0003F6D4 0A3C0001        	 13298:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6D8 4E75            	 13299:     rts
                            	 13300: 
                            	 13301:     even
