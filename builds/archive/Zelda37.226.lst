                            	  5812:     even
                            	  5813: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5814:     ; We jump here if the door type is bombable and was opened.
                            	  5815:     ; Change the provisional door face to value 9, which
                            	  5816:     ; will become the "hole in the wall".
                            	  5817:     ;
