02:0003CF90 41EC0444        	  7994:     lea     ($0444,A4),A0
02:0003CF94 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003CF98 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF9C 123C0038        	  7997:     move.b  #$38,D1
02:0003CFA0 D101            	  7998:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
