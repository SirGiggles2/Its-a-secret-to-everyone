                            	  6063: __far_z_01_0054:
                            	  6064:     ; For other objects, the caller controls mirroring and flipping.
                            	  6065:     ;
                            	  6066:     ; If mirrored [0C], then draw it mirrored.
                            	  6067:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  6068:     ;
02:000317F4 7600            	  6069:     moveq   #0,D3
02:000317F6 162C000C        	  6070:     move.b  ($000C,A4),D3
