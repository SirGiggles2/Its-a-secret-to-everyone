                            	 10106:     ;
02:0003DF8E 41EC046B        	 10107:     lea     ($046B,A4),A0
02:0003DF92 10302000        	 10108:     move.b  (A0,D2.W),D0
02:0003DF96 6138            	 10109:     jsr     Gohma_AnimateAndDraw
02:0003DF98 600000AA        	 10110:     jmp     Gohma_CheckCollisions
                            	 10111: 
