02:00034E9A 11803000        	  2706:     move.b  D0,(A0,D3.W)
02:00034E9E 5303            	  2707:     subq.b  #1,D3
02:00034EA0 6AEA            	  2708:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00034EA2 7600            	  2709:     moveq   #0,D3
02:00034EA4 162C0016        	  2710:     move.b  ($0016,A4),D3
02:00034EA8 41F90003470A    	  2711:     lea     (ModeEandFSlotCursorYs).l,A0
02:00034EAE 10303000        	  2712:     move.b  (A0,D3.W),D0
02:00034EB2 19400084        	  2713:     move.b  D0,($0084,A4)
02:00034EB6 19400200        	  2714:     move.b  D0,($0200,A4)
02:00034EBA 102C0012        	  2715:     move.b  ($0012,A4),D0
02:00034EBE 0C00000F        	  2716:     cmpi.b  #$0F,D0
                            	  2717:     ; There's more work in mode $E.
                            	  2718:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2719:     ; The char-board cursor position is held in ObjX/ObjY[1].
