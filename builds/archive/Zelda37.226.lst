02:0004255C 8841            	  4715:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004255E 48C4            	  4716:     ext.l   D4
02:00042560 D8BC00FF0000    	  4717:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042566 2044            	  4718:     movea.l D4,A0
