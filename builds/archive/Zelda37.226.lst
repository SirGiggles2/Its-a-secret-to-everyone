                            	  6817: _L_z01_Link_BeHarmed_ResetHelp:
                            	  6818:     ; Reset values used in special item drops.
                            	  6819:     ;
02:00031D80 7000            	  6820:     moveq   #0,D0
02:00031D82 19400627        	  6821:     move.b  D0,($0627,A4)
02:00031D86 19400050        	  6822:     move.b  D0,($0050,A4)
02:00031D8A 19400051        	  6823:     move.b  D0,($0051,A4)
                            	  6824:     ; If heart partial >= low damage points byte, then simply
                            	  6825:     ; subtract the damage byte from heart partial.
                            	  6826:     ; Else go borrow from full hearts.
                            	  6827:     ;
02:00031D8E 102C0670        	  6828:     move.b  ($0670,A4),D0
02:00031D92 122C000E        	  6829:     move.b  ($000E,A4),D1
02:00031D96 B001            	  6830:     cmp.b   D1,D0
02:00031D98 6546            	  6831:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031D9A 003C0011        	  6832:     ori     #$11,CCR  ; SEC: set C+X
02:00031D9E 122C000E        	  6833:     move.b  ($000E,A4),D1
02:00031DA2 0A3C0010        	  6834:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031DA6 9101            	  6835:     subx.b  D1,D0   ; SBC $0E
02:00031DA8 0A3C0010        	  6836:     eori    #$10,CCR  ; restore X = 6502 C
02:00031DAC 19400670        	  6837:     move.b  D0,($0670,A4)
                            	  6838:     ; If full hearts >= high damage points byte, then simply
                            	  6839:     ; subtract the damage byte from full hearts.
                            	  6840:     ; Else go handle Link dying.
                            	  6841:     ;
02:00031DB0 102C066F        	  6842:     move.b  ($066F,A4),D0
02:00031DB4 0200000F        	  6843:     andi.b #$0F,D0
02:00031DB8 122C000D        	  6844:     move.b  ($000D,A4),D1
02:00031DBC B001            	  6845:     cmp.b   D1,D0
02:00031DBE 6554            	  6846:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031DC0 102C066F        	  6847:     move.b  ($066F,A4),D0
02:00031DC4 003C0011        	  6848:     ori     #$11,CCR  ; SEC: set C+X
02:00031DC8 122C000D        	  6849:     move.b  ($000D,A4),D1
02:00031DCC 0A3C0010        	  6850:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031DD0 9101            	  6851:     subx.b  D1,D0   ; SBC $0D
02:00031DD2 0A3C0010        	  6852:     eori    #$10,CCR  ; restore X = 6502 C
02:00031DD6 1940066F        	  6853:     move.b  D0,($066F,A4)
02:00031DDA 0A3C0001        	  6854:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031DDE 4E75            	  6855:     rts
