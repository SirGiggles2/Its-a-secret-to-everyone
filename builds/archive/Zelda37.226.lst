                            	  4937: UpdateBombFlashEffect:
                            	  4938:     ; If state <> $13, return.
                            	  4939:     ;
02:00030EA8 41EC00AC        	  4940:     lea     ($00AC,A4),A0
02:00030EAC 10302000        	  4941:     move.b  (A0,D2.W),D0
02:00030EB0 0C000013        	  4942:     cmpi.b  #$13,D0
02:00030EB4 662E            	  4943:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4944:     ; The effect involves turning grayscale rendering on and off
                            	  4945:     ; in PPUMASK.
                            	  4946:     ;
                            	  4947:     ; Start by setting A register to the PPU mask shifted right to
                            	  4948:     ; throw away the grayscale bit.
                            	  4949:     ;
02:00030EB6 102C00FE        	  4950:     move.b  ($00FE,A4),D0
02:00030EBA E208            	  4951:     lsr.b  #1,D0   ; LSR A
                            	  4952:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4953:     ;
02:00030EBC 7600            	  4954:     moveq   #0,D3
02:00030EBE 16342028        	  4955:     move.b  ($28,A4,D2.W),D3
                            	  4956:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4957:     ; Carry will have been set, because of the comparison (CPY).
                            	  4958:     ;
02:00030EC2 0C030016        	  4959:     cmpi.b  #$16,D3
02:00030EC6 6706            	  4960:     beq  _anon_z01_54
02:00030EC8 0C030011        	  4961:     cmpi.b  #$11,D3
02:00030ECC 6604            	  4962:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  4963: _anon_z01_54:
02:00030ECE E310            	  4964:     roxl.b  #1,D0   ; ROL A
02:00030ED0 600E            	  4965:     jmp     _L_z01_UpdateBombFlashEffect_SetMask
                            	  4966: 
                            	  4967:     even
                            	  4968: _L_z01_UpdateBombFlashEffect_Clear:
                            	  4969:     ; At times $12 and $D, shift left to make the low bit 0.
                            	  4970:     ;
02:00030ED2 0C030012        	  4971:     cmpi.b  #$12,D3
02:00030ED6 6706            	  4972:     beq  _anon_z01_55
02:00030ED8 0C03000D        	  4973:     cmpi.b  #$0D,D3
02:00030EDC 6606            	  4974:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4975: _anon_z01_55:
02:00030EDE E308            	  4976:     lsl.b  #1,D0   ; ASL A
                            	  4977:     even
                            	  4978: _L_z01_UpdateBombFlashEffect_SetMask:
                            	  4979:     ; Only at times $16, $11, $12, $D do we commit the mask
                            	  4980:     ; we calculated.
                            	  4981:     ;
02:00030EE0 194000FE        	  4982:     move.b  D0,($00FE,A4)
                            	  4983:     even
                            	  4984: _L_z01_UpdateBombFlashEffect_Exit:
02:00030EE4 4E75            	  4985:     rts
                            	  4986: 
                            	  4987:     even
