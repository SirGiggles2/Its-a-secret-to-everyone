                            	  3953: UpdateArmos:
02:0003B262 6100E7BC        	  3954:     jsr     UpdateGoriya
                            	  3955:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3956:     ;
02:0003B266 41EC00C0        	  3957:     lea     ($00C0,A4),A0
02:0003B26A 10302000        	  3958:     move.b  (A0,D2.W),D0
02:0003B26E 6702            	  3959:     beq.s  __far_z_04_0035
02:0003B270 602A            	  3960:     jmp  DrawArmosAndCheckCollisions
                            	  3961: __far_z_04_0035:
                            	  3962:     ; Animate.
                            	  3963:     ;
                            	  3964:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3965:     ; then only go draw.
                            	  3966:     ;
02:0003B272 41EC03D0        	  3967:     lea     ($03D0,A4),A0
02:0003B276 53302000        	  3968:     subq.b  #1,(A0,D2.W)
02:0003B27A 6702            	  3969:     beq.s  __far_z_04_0036
02:0003B27C 601E            	  3970:     jmp  DrawArmosAndCheckCollisions
                            	  3971: __far_z_04_0036:
                            	  3972:     ; Armos animation frames last 6 screen frames.
                            	  3973:     ;
02:0003B27E 7006            	  3974:     moveq   #6,D0
02:0003B280 41EC03D0        	  3975:     lea     ($03D0,A4),A0
02:0003B284 11802000        	  3976:     move.b  D0,(A0,D2.W)
                            	  3977:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3978:     ; change the position of the shield. To keep fixed it in place,
                            	  3979:     ; there are separate frame images for each animation frame.
                            	  3980:     ;
                            	  3981:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3982:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3983:     ;
                            	  3984:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3985:     ; Then choose the direction at the point of drawing below.
                            	  3986:     ;
02:0003B288 41EC03E4        	  3987:     lea     ($03E4,A4),A0
02:0003B28C 10302000        	  3988:     move.b  (A0,D2.W),D0
02:0003B290 0A000002        	  3989:     eori.b #$02,D0
02:0003B294 41EC03E4        	  3990:     lea     ($03E4,A4),A0
02:0003B298 11802000        	  3991:     move.b  D0,(A0,D2.W)
                            	  3992:     even
                            	  3993: DrawArmosAndCheckCollisions:
02:0003B29C 4EB90004D1BE    	  3994:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B2A2 7600            	  3995:     moveq   #0,D3
02:0003B2A4 41EC0098        	  3996:     lea     ($0098,A4),A0
02:0003B2A8 16302000        	  3997:     move.b  (A0,D2.W),D3
                            	  3998:     ; If facing up, then use the second frame image in the set ("back").
                            	  3999:     ; Else use the second.
                            	  4000:     ;
02:0003B2AC 0C030008        	  4001:     cmpi.b  #$08,D3
02:0003B2B0 6602            	  4002:     bne  _anon_z04_54
02:0003B2B2 7001            	  4003:     moveq   #1,D0
                            	  4004: _anon_z04_54:
02:0003B2B4 023C00EE        	  4005:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B2B8 41EC03E4        	  4006:     lea     ($03E4,A4),A0
02:0003B2BC 12302000        	  4007:     move.b  (A0,D2.W),D1
02:0003B2C0 D101            	  4008:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B2C2 4EB900031726    	  4009:     jsr     DrawObjectNotMirrored
                            	  4010:     ; If the armos is still fading in, then go for check collision with Link,
                            	  4011:     ; but not with weapons.
                            	  4012:     ;
02:0003B2C8 10342028        	  4013:     move.b  ($28,A4,D2.W),D0
