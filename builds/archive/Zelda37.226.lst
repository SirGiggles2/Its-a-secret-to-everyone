02:0003C51E E309            	  6525:     lsl.b  #1,D1   ; ASL $02
02:0003C520 19410002        	  6526:     move.b  D1,($0002,A4)
02:0003C524 122C0002        	  6527:     move.b  ($0002,A4),D1
02:0003C528 C200            	  6528:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
