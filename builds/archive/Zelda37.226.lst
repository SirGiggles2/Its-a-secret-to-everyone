02:0003C074 19803071        	  5842:     move.b  D0,($71,A4,D3.W)
02:0003C078 41EC0084        	  5843:     lea     ($0084,A4),A0
02:0003C07C 10302000        	  5844:     move.b  (A0,D2.W),D0
02:0003C080 41EC0085        	  5845:     lea     ($0085,A4),A0
02:0003C084 11803000        	  5846:     move.b  D0,(A0,D3.W)
                            	  5847:     ; If the tail segment found is also a head, then
