                            	 11035: __far_z_04_0105:
                            	 11036: ; Description:
                            	 11037: ; This block applies to heads and the bottom segment of a neck.
                            	 11038: ; These are drawn with sprites that come first in order, so that
                            	 11039: ; they are drawn above all other sprites, including Link.
                            	 11040: ;
                            	 11041: ; Params:
                            	 11042: ; A: tile number
                            	 11043: ;
                            	 11044: ; Normal sprite with level palette row
                            	 11045:     even
                            	 11046: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E680 7603            	 11047:     moveq   #3,D3
02:0003E682 19430003        	 11048:     move.b  D3,($0003,A4)
02:0003E686 1B00            	 11049:     move.b  D0,-(A5)  ; PHA
                            	 11050:     ; To calculate the base offset of the sprite record:
                            	 11051:     ; offset := neck index * 8
                            	 11052:     ;
                            	 11053:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11054:     ; at an even index.
                            	 11055:     ;
02:0003E688 102C04D7        	 11056:     move.b  ($04D7,A4),D0
02:0003E68C E308            	 11057:     lsl.b  #1,D0   ; ASL A
02:0003E68E E308            	 11058:     lsl.b  #1,D0   ; ASL A
02:0003E690 E308            	 11059:     lsl.b  #1,D0   ; ASL A
                            	 11060:     ; But if the segment is not a head (not at object slot 5), then
                            	 11061:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11062:     ;
02:0003E692 0C020005        	 11063:     cmpi.b  #$05,D2
02:0003E696 670A            	 11064:     beq  _anon_z04_139
02:0003E698 023C00EE        	 11065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E69C 123C0020        	 11066:     move.b  #$20,D1
02:0003E6A0 D101            	 11067:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11068: _anon_z04_139:
02:0003E6A2 7600            	 11069:     moveq   #0,D3
02:0003E6A4 1600            	 11070:     move.b  D0,D3
02:0003E6A6 101D            	 11071:     move.b  (A5)+,D0  ; PLA
02:0003E6A8 4EB900031A50    	 11072:     jsr     Anim_WriteSpecificSprite
02:0003E6AE 6026            	 11073:     jmp     Gleeok_CheckCollisions
                            	 11074: 
                            	 11075:     even
                            	 11076: Gleeok_DrawHeadAndCheckCollisions:
02:0003E6B0 7405            	 11077:     moveq   #5,D2
                            	 11078:     even
