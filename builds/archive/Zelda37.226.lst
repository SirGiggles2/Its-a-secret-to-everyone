02:0003C04C 41EC0350        	  5823:     lea     ($0350,A4),A0
02:0003C050 10303000        	  5824:     move.b  (A0,D3.W),D0
02:0003C054 0C000041        	  5825:     cmpi.b  #$41,D0
02:0003C058 66F0            	  5826:     bne  _anon_z04_80
                            	  5827:     ; I don't know why the object timer of the tail segment that will
                            	  5828:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5829:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5830:     ; there, the object timer is set to 6.
                            	  5831:     ;
02:0003C05A 7011            	  5832:     moveq   #17,D0
02:0003C05C 19803029        	  5833:     move.b  D0,($29,A4,D3.W)
                            	  5834:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5835:     ; segment to the tail segment.
                            	  5836:     ;
02:0003C060 41EC04F0        	  5837:     lea     ($04F0,A4),A0
02:0003C064 10302000        	  5838:     move.b  (A0,D2.W),D0
02:0003C068 41EC04F1        	  5839:     lea     ($04F1,A4),A0
02:0003C06C 11803000        	  5840:     move.b  D0,(A0,D3.W)
