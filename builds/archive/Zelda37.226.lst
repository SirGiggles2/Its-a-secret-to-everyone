                            	  4019:     ;
02:0003B2D4 41EC0405        	  4020:     lea     ($0405,A4),A0
02:0003B2D8 10302000        	  4021:     move.b  (A0,D2.W),D0
02:0003B2DC 670A            	  4022:     beq  _anon_z04_55
02:0003B2DE 705D            	  4023:     moveq   #93,D0
02:0003B2E0 41EC034F        	  4024:     lea     ($034F,A4),A0
02:0003B2E4 11802000        	  4025:     move.b  D0,(A0,D2.W)
                            	  4026: _anon_z04_55:
