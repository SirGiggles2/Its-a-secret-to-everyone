                            	  3952: FindNextEdgeSpawnCell:
                            	  3953:     ; Load [0A] with the value before the call.
                            	  3954:     ;
02:00041FF2 102C0525        	  3955:     move.b  ($0525,A4),D0
02:00041FF6 1940000A        	  3956:     move.b  D0,($000A,A4)
                            	  3957:     even
                            	  3958: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3959:     ; Loop to look for a place to spawn a monster from the edge
                            	  3960:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3961:     ;
                            	  3962:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3963:     ; We'll move down $10 pixels.
                            	  3964:     ;
02:00041FFA 7610            	  3965:     moveq   #16,D3
02:00041FFC 102C000A        	  3966:     move.b  ($000A,A4),D0
02:00042000 0200000F        	  3967:     andi.b #$0F,D0
02:00042004 670A            	  3968:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3969:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3970:     ; Don't move vertically.
                            	  3971:     ;
02:00042006 163C00F0        	  3972:     move.b  #$F0,D3
02:0004200A 0C00000F        	  3973:     cmpi.b  #$0F,D0
02:0004200E 6610            	  3974:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3975:     even
                            	  3976: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3977:     ; Else low nibble = $F. We're at the right edge,
                            	  3978:     ; and we'll move up $10 pixels.
                            	  3979:     ;
02:00042010 1003            	  3980:     move.b  D3,D0
02:00042012 023C00EE        	  3981:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042016 122C000A        	  3982:     move.b  ($000A,A4),D1
02:0004201A D101            	  3983:     addx.b  D1,D0   ; ADC $0A
02:0004201C 1940000A        	  3984:     move.b  D0,($000A,A4)
                            	  3985:     even
                            	  3986: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3987:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3988:     ; Move right one pixel.
                            	  3989:     ;
02:00042020 102C000A        	  3990:     move.b  ($000A,A4),D0
02:00042024 020000F0        	  3991:     andi.b #$F0,D0
02:00042028 0C0000E0        	  3992:     cmpi.b  #$E0,D0
02:0004202C 6606            	  3993:     bne  _anon_z05_88
02:0004202E 522C000A        	  3994:     addq.b  #1,($000A,A4)
02:00042032 600A            	  3995:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3996: 
                            	  3997: _anon_z05_88:
                            	  3998:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3999:     ; Dont' move horizontally.
                            	  4000:     ;
02:00042034 0C000040        	  4001:     cmpi.b  #$40,D0
02:00042038 6604            	  4002:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4003:     ; Else high nibble = 4. We're at the top edge.
                            	  4004:     ; Move left 1 pixel.
                            	  4005:     ;
02:0004203A 532C000A        	  4006:     subq.b  #1,($000A,A4)
                            	  4007:     even
                            	  4008: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  4009:     ; Time to get the address of the column.
                            	  4010:     ; Starting at the top of the leftmost column.
                            	  4011:     ;
02:0004203E 610026C8        	  4012:     jsr     FetchTileMapAddr
02:00042042 7005            	  4013:     moveq   #5,D0
02:00042044 4EB90002A9FA    	  4014:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  4015:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  4016:     ; in order to point to the column we want.
                            	  4017:     ;
02:0004204A 102C000A        	  4018:     move.b  ($000A,A4),D0
02:0004204E 0200000F        	  4019:     andi.b #$0F,D0
02:00042052 7600            	  4020:     moveq   #0,D3
02:00042054 1600            	  4021:     move.b  D0,D3
02:00042056 670C            	  4022:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  4023: _anon_z05_89:
02:00042058 702C            	  4024:     moveq   #44,D0
02:0004205A 4EB900030FFA    	  4025:     jsr     AddToInt16At0
02:00042060 5303            	  4026:     subq.b  #1,D3
02:00042062 66F4            	  4027:     bne  _anon_z05_89
                            	  4028:     even
                            	  4029: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  4030:     ; Turn the row part of [0A] into a tile index.
                            	  4031:     ; row := (([0A] AND $F0) - $40) / 8
                            	  4032:     ;
02:00042064 102C000A        	  4033:     move.b  ($000A,A4),D0
02:00042068 020000F0        	  4034:     andi.b #$F0,D0
02:0004206C 003C0011        	  4035:     ori     #$11,CCR  ; SEC: set C+X
02:00042070 123C0040        	  4036:     move.b  #$40,D1
02:00042074 0A3C0010        	  4037:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042078 9101            	  4038:     subx.b  D1,D0   ; SBC #$40
02:0004207A 0A3C0010        	  4039:     eori    #$10,CCR  ; restore X = 6502 C
02:0004207E E208            	  4040:     lsr.b  #1,D0   ; LSR A
02:00042080 E208            	  4041:     lsr.b  #1,D0   ; LSR A
02:00042082 E208            	  4042:     lsr.b  #1,D0   ; LSR A
02:00042084 7600            	  4043:     moveq   #0,D3
02:00042086 1600            	  4044:     move.b  D0,D3
                            	  4045:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  4046:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  4047:     ; when coming in from the edges.
                            	  4048:     ;
02:00042088 1214            	  4049:     move.b  ($00,A4),D1   ; ptr lo
02:0004208A 182C0001        	  4050:     move.b  ($01,A4),D4  ; ptr hi
02:0004208E 024100FF        	  4051:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042092 E14C            	  4052:     lsl.w   #8,D4
02:00042094 8841            	  4053:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042096 48C4            	  4054:     ext.l   D4
02:00042098 D8BC00FF0000    	  4055:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004209E 2044            	  4056:     movea.l D4,A0
02:000420A0 10303000        	  4057:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000420A4 0C000084        	  4058:     cmpi.b  #$84,D0
02:000420A8 650E            	  4059:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  4060:     ; Bottom of the loop.
                            	  4061:     ; If you reach the original cell, then stop.
