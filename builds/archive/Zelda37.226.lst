02:0004BE2E 163C00F0        	  4245:     move.b  #$F0,D3
                            	  4246: _anon_z07_15:
02:0004BE32 1940010E        	  4247:     move.b  D0,($010E,A4)
02:0004BE36 1943010F        	  4248:     move.b  D3,($010F,A4)
02:0004BE3A 102C000F        	  4249:     move.b  ($000F,A4),D0
