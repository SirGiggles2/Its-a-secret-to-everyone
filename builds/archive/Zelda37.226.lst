                            	  8202: Submenu_CueTransferRowUW:
                            	  8203:     ; If menu scroll value is negative, then we transferred everything.
                            	  8204:     ; So, return.
                            	  8205:     ;
02:00044E34 102C005E        	  8206:     move.b  ($005E,A4),D0
02:00044E38 6A02            	  8207:     bpl.s  __far_z_05_0109
02:00044E3A 602E            	  8208:     jmp  L1725A_Exit
                            	  8209: __far_z_05_0109:
                            	  8210:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8211:     ; and represents the current row of the submenu being processed.
                            	  8212:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8213:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8214:     ;
                            	  8215:     ; If the bottom bit is set, go prepare the full black row.
                            	  8216:     ;
02:00044E3C E208            	  8217:     lsr.b  #1,D0   ; LSR A
02:00044E3E 7600            	  8218:     moveq   #0,D3
02:00044E40 1600            	  8219:     move.b  D0,D3
02:00044E42 6402            	  8220:     bcc.s  __far_z_05_0110
02:00044E44 6026            	  8221:     jmp  PrepFullBlackRow
                            	  8222: __far_z_05_0110:
                            	  8223:     ; Submenu rows $D to $15 are parts of the map.
                            	  8224:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8225:     ;
                            	  8226:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8227:     ; buffer for this row.
                            	  8228:     ;
02:00044E46 0C00000D        	  8229:     cmpi.b  #$0D,D0
02:00044E4A 640C            	  8230:     bcc  _anon_z05_167
02:00044E4C 41F900044E10    	  8231:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044E52 10303000        	  8232:     move.b  (A0,D3.W),D0
                            	  8233:     even
