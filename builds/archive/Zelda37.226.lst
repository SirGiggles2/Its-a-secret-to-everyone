                            	  5359: _L_z07_SpreadShot_NextCorner:
                            	  5360:     ; Prepare to process the next corner.
                            	  5361:     ;
                            	  5362:     ; First, restore X offset [02] and Y offset [03].
                            	  5363:     ;
02:0004C57A 101D            	  5364:     move.b  (A5)+,D0  ; PLA
02:0004C57C 19400003        	  5365:     move.b  D0,($0003,A4)
02:0004C580 101D            	  5366:     move.b  (A5)+,D0  ; PLA
02:0004C582 19400002        	  5367:     move.b  D0,($0002,A4)
                            	  5368:     ; Take turns negating X offset or Y offset for the next round.
                            	  5369:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5370:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5371:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5372:     ; - Fourth turn: doesn't matter
                            	  5373:     ;
                            	  5374:     ;
                            	  5375:     ; Get the loop index.
02:0004C586 101D            	  5376:     move.b  (A5)+,D0  ; PLA
02:0004C588 1B00            	  5377:     move.b  D0,-(A5)  ; PHA
02:0004C58A 7600            	  5378:     moveq   #0,D3
02:0004C58C 1600            	  5379:     move.b  D0,D3
02:0004C58E 0C030001        	  5380:     cmpi.b  #$01,D3
02:0004C592 6602            	  5381:     bne  _anon_z07_25
02:0004C594 7603            	  5382:     moveq   #3,D3
