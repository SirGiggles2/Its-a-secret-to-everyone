                            	   406: ;------------------------------------------------------------------------------
                            	   407: ; _c_move_object_shim — MoveObject trampoline.
                            	   408: ;
                            	   409: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   410: ;   Input:     D2 = slot (0..11)
                            	   411: ;   Preserves: D2, A4, A5
                            	   412: ;   Clobbers:  D0, D1, D3, A0
                            	   413: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   414: ;
                            	   415: ; GCC side:
                            	   416: ;   void c_move_object(unsigned short slot);
                            	   417: ;     slot arrives as a 16-bit value on the stack.
                            	   418: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   419: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   420: ;   never clobbered by gcc.
                            	   421: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   422: ;   semantics can exist in a pure C port).
                            	   423: ;------------------------------------------------------------------------------
                            	   424: _c_move_object_shim:
                            	   425:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   426:     move.b  #$AA,($0900,A4)
                            	   427:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   428:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   429:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   430:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   431:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   432:     moveq   #0,D0
02:0002B658 3002            	   433:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   434:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   435:     jsr     c_move_object
02:0002B662 588F            	   436:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   437:     rts
                            	   438: 
                            	   439: ;==============================================================================
                            	   440: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   441: ; and tail-call the native asm function.
                            	   442: ;
                            	   443: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   444: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   445: ; sign-extended).
                            	   446: ;==============================================================================
                            	   447: 
                            	   448: ;------------------------------------------------------------------------------
                            	   449: ; void c_copy_bank_to_window(unsigned int bank);
                            	   450: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   451: ;------------------------------------------------------------------------------
                            	   452: c_copy_bank_to_window:
02:0002B666 202F0004        	   453:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   454:     jmp     _copy_bank_to_window
                            	   455: 
                            	   456: ;------------------------------------------------------------------------------
                            	   457: ; unsigned char c_ppu_read_2(void);
                            	   458: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   459: ; C return: gcc expects result in D0.
                            	   460: ;------------------------------------------------------------------------------
                            	   461: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   462:     jmp     _ppu_read_2
                            	   463: 
                            	   464: ;------------------------------------------------------------------------------
                            	   465: ; void c_ppu_write_6(unsigned int val);
                            	   466: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   467: ;------------------------------------------------------------------------------
                            	   468: c_ppu_write_6:
02:0002B674 202F0004        	   469:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   470:     jmp     _ppu_write_6
                            	   471: 
                            	   472: ;------------------------------------------------------------------------------
                            	   473: ; void c_ppu_write_7(unsigned int val);
                            	   474: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   475: ;------------------------------------------------------------------------------
                            	   476: c_ppu_write_7:
02:0002B67E 202F0004        	   477:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   478:     jmp     _ppu_write_7
                            	   479: 
                            	   480: ;------------------------------------------------------------------------------
                            	   481: ; void c_turn_off_all_video(void);
                            	   482: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   483: ;------------------------------------------------------------------------------
                            	   484: c_turn_off_all_video:
02:0002B688 4EF90004ABFA    	   485:     jmp     TurnOffAllVideo
