02:00030DBC E208            	  4782:     lsr.b  #1,D0   ; LSR A
02:00030DBE 6110            	  4783:     jsr     ChooseOffsetForDirectionH
02:00030DC0 122C0084        	  4784:     move.b  ($0084,A4),D1
02:00030DC4 D101            	  4785:     addx.b  D1,D0   ; ADC ObjY
02:00030DC6 41EC0084        	  4786:     lea     ($0084,A4),A0
