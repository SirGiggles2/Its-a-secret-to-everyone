02:0003AA84 D101            	  2852:     addx.b  D1,D0   ; ADC ObjX,X
02:0003AA86 19802070        	  2853:     move.b  D0,($70,A4,D2.W)
                            	  2854:     ; If going up (negative v-speed high byte), then
                            	  2855:     ; go animate, draw, and check collisions.
