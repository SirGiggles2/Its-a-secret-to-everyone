                            	  5802:     ; Begin looking for the door face for the door attribute.
                            	  5803:     ; In general, use the door type as the provisional face;
                            	  5804:     ; except turn 4 into 8.
                            	  5805:     ;
02:0004380E 0C000005        	  5806:     cmpi.b  #$05,D0
02:00043812 642A            	  5807:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
