                            	 11942: __far_z_04_0123:
                            	 11943:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11944:     ; We had to account for the usual offset of 3.
                            	 11945:     ;
02:0003ED58 41EC0084        	 11946:     lea     ($0084,A4),A0
02:0003ED5C 10302000        	 11947:     move.b  (A0,D2.W),D0
02:0003ED60 023C00EE        	 11948:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED64 123C0003        	 11949:     move.b  #$03,D1
02:0003ED68 D101            	 11950:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED6A 02000007        	 11951:     andi.b #$07,D0
02:0003ED6E 6702            	 11952:     beq.s  __far_z_04_0124
02:0003ED70 60D8            	 11953:     jmp  L12A6F_Exit
                            	 11954: __far_z_04_0124:
                            	 11955:     ; Will loop 4 times, propagating directions down the chain,
                            	 11956:     ; by pulling from the bottom.
                            	 11957:     ;
02:0003ED72 7004            	 11958:     moveq   #4,D0
02:0003ED74 1880            	 11959:     move.b  D0,($0000,A4)
                            	 11960:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11961:     ;
02:0003ED76 7600            	 11962:     moveq   #0,D3
02:0003ED78 0C020005        	 11963:     cmpi.b  #$05,D2
02:0003ED7C 6702            	 11964:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED7E 7605            	 11965:     moveq   #5,D3
                            	 11966:     even
                            	 11967: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11968:     ; Loop over every segment under the head, starting from the tail.
                            	 11969:     ; Copy the next segment's direction to the current one in this loop.
                            	 11970:     ;
02:0003ED80 41EC009A        	 11971:     lea     ($009A,A4),A0
02:0003ED84 10303000        	 11972:     move.b  (A0,D3.W),D0
02:0003ED88 41EC0099        	 11973:     lea     ($0099,A4),A0
02:0003ED8C 11803000        	 11974:     move.b  D0,(A0,D3.W)
02:0003ED90 5203            	 11975:     addq.b  #1,D3
02:0003ED92 5314            	 11976:     subq.b  #1,($0000,A4)
02:0003ED94 66EA            	 11977:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11978:     ; If this head segment is not aligned with a square, then return.
                            	 11979:     ;
02:0003ED96 10342070        	 11980:     move.b  ($70,A4,D2.W),D0
02:0003ED9A 0200000F        	 11981:     andi.b #$0F,D0
02:0003ED9E 660000BA        	 11982:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11983:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11984:     ; We had to account for the usual offset of 3.
                            	 11985:     ;
02:0003EDA2 41EC0084        	 11986:     lea     ($0084,A4),A0
02:0003EDA6 10302000        	 11987:     move.b  (A0,D2.W),D0
02:0003EDAA 023C00EE        	 11988:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDAE 123C0003        	 11989:     move.b  #$03,D1
02:0003EDB2 D101            	 11990:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDB4 0200000F        	 11991:     andi.b #$0F,D0
02:0003EDB8 660000A0        	 11992:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11993:     ; Store the opposite of the facing direction in [00].
                            	 11994:     ;
02:0003EDBC 41EC0098        	 11995:     lea     ($0098,A4),A0
02:0003EDC0 10302000        	 11996:     move.b  (A0,D2.W),D0
02:0003EDC4 E208            	 11997:     lsr.b  #1,D0   ; LSR A
02:0003EDC6 02000005        	 11998:     andi.b #$05,D0
02:0003EDCA 1880            	 11999:     move.b  D0,($0000,A4)
02:0003EDCC 41EC0098        	 12000:     lea     ($0098,A4),A0
02:0003EDD0 10302000        	 12001:     move.b  (A0,D2.W),D0
02:0003EDD4 E308            	 12002:     lsl.b  #1,D0   ; ASL A
02:0003EDD6 0200000A        	 12003:     andi.b #$0A,D0
02:0003EDDA 1214            	 12004:     move.b  ($0000,A4),D1
02:0003EDDC 8001            	 12005:     or.b  D1,D0
                            	 12006:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12007:     ;
02:0003EDDE 0A00000F        	 12008:     eori.b #$0F,D0
02:0003EDE2 1940050F        	 12009:     move.b  D0,($050F,A4)
                            	 12010:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12011:     ;
02:0003EDE6 10342018        	 12012:     move.b  ($18,A4,D2.W),D0
02:0003EDEA 0C000080        	 12013:     cmpi.b  #$80,D0
02:0003EDEE 656C            	 12014:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12015:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12016:     ; Load the monster's facing direction.
                            	 12017:     ;
02:0003EDF0 41EC0098        	 12018:     lea     ($0098,A4),A0
02:0003EDF4 10302000        	 12019:     move.b  (A0,D2.W),D0
                            	 12020:     ; Load the next random number into Y register.
                            	 12021:     ;
02:0003EDF8 7600            	 12022:     moveq   #0,D3
02:0003EDFA 16342019        	 12023:     move.b  ($19,A4,D2.W),D3
                            	 12024:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12025:     ; to keep moving straight.
                            	 12026:     ;
02:0003EDFE 0C030080        	 12027:     cmpi.b  #$80,D3
02:0003EE02 6418            	 12028:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12029:     even
                            	 12030: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12031:     ; Loop to rotate the direction bit over the mask.
                            	 12032:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12033:     ; facing direction.
                            	 12034:     ;
                            	 12035:     ; Shift right the copy of the direction.
                            	 12036:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12037:     ;
02:0003EE04 E208            	 12038:     lsr.b  #1,D0   ; LSR A
02:0003EE06 6402            	 12039:     bcc  _anon_z04_151
02:0003EE08 7008            	 12040:     moveq   #8,D0
                            	 12041: _anon_z04_151:
                            	 12042:     ; If the current direction bit is masked off, then we've reached
                            	 12043:     ; the opposite direction. Loop again.
                            	 12044:     ;
02:0003EE0A 122C050F        	 12045:     move.b  ($050F,A4),D1
02:0003EE0E C200            	 12046:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE10 67F2            	 12047:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12048:     ; If Y register >= $40, then break out of the loop.
                            	 12049:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12050:     ;
02:0003EE12 0C030040        	 12051:     cmpi.b  #$40,D3
02:0003EE16 6404            	 12052:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12053:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12054:     ; and loop again now.
                            	 12055:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12056:     ;
02:0003EE18 7640            	 12057:     moveq   #64,D3
02:0003EE1A 65E8            	 12058:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12059:     even
                            	 12060: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12061:     ; Change the facing direction to the direction found.
                            	 12062:     ;
02:0003EE1C 41EC0098        	 12063:     lea     ($0098,A4),A0
02:0003EE20 11802000        	 12064:     move.b  D0,(A0,D2.W)
                            	 12065:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12066:     ;
02:0003EE24 1940000F        	 12067:     move.b  D0,($000F,A4)
02:0003EE28 4EB900030AAA    	 12068:     jsr     BoundByRoom
                            	 12069:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12070:     ;
02:0003EE2E 102C000F        	 12071:     move.b  ($000F,A4),D0
02:0003EE32 6618            	 12072:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12073:     even
                            	 12074: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12075:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12076:     ; for looking for any non-opposite direction that is not blocked.
                            	 12077:     ;
02:0003EE34 41EC0098        	 12078:     lea     ($0098,A4),A0
02:0003EE38 10302000        	 12079:     move.b  (A0,D2.W),D0
                            	 12080:     even
                            	 12081: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12082:     ; Shift right the copy of the direction.
                            	 12083:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12084:     ;
02:0003EE3C E208            	 12085:     lsr.b  #1,D0   ; LSR A
02:0003EE3E 6402            	 12086:     bcc  _anon_z04_152
02:0003EE40 7008            	 12087:     moveq   #8,D0
                            	 12088: _anon_z04_152:
                            	 12089:     ; If the current direction bit is not masked off, then go check the
                            	 12090:     ; room boundary in this direction.
                            	 12091:     ; Else we've reached the opposite direction. Loop again.
                            	 12092:     ;
02:0003EE42 122C050F        	 12093:     move.b  ($050F,A4),D1
02:0003EE46 C200            	 12094:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE48 66D2            	 12095:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE4A 67F0            	 12096:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12097:     even
                            	 12098: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12099:     ; We found a direction that was not blocked by the room boundary.
                            	 12100:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12101:     ;
02:0003EE4C 4EB90004B91A    	 12102:     jsr     GetCollidingTileMoving
02:0003EE52 122C034A        	 12103:     move.b  ($034A,A4),D1
02:0003EE56 B001            	 12104:     cmp.b   D1,D0
02:0003EE58 64DA            	 12105:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12106:     even
                            	 12107: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12108:     ; TODO: confirm this
                            	 12109:     ;
                            	 12110:     ; If there were a room that had lamnolas, and they could get
                            	 12111:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12112:     ; an infinite loop.
                            	 12113:     ;
                            	 12114:     ; But, the only room with that configuration has those blocks
                            	 12115:     ; blocked off with a push block, which can only be pushed after
                            	 12116:     ; all monsters are killed.
                            	 12117:     ;
02:0003EE5A 4E75            	 12118:     rts
                            	 12119: 
                            	 12120:     even
                            	 12121: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12122:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12123:     ;
02:0003EE5C 7001            	 12124:     moveq   #1,D0
02:0003EE5E 19400002        	 12125:     move.b  D0,($0002,A4)
02:0003EE62 102C0070        	 12126:     move.b  ($0070,A4),D0
02:0003EE66 003C0011        	 12127:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE6A 12342070        	 12128:     move.b  ($70,A4,D2.W),D1
02:0003EE6E 0A3C0010        	 12129:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE72 9101            	 12130:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EE74 0A3C0010        	 12131:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE78 640A            	 12132:     bcc  _anon_z04_153
02:0003EE7A 122C0002        	 12133:     move.b  ($0002,A4),D1
02:0003EE7E E309            	 12134:     lsl.b  #1,D1   ; ASL $02
02:0003EE80 19410002        	 12135:     move.b  D1,($0002,A4)
                            	 12136: _anon_z04_153:
                            	 12137:     ; Find the vertical direction toward Link and store it in [03].
                            	 12138:     ;
02:0003EE84 7004            	 12139:     moveq   #4,D0
02:0003EE86 19400003        	 12140:     move.b  D0,($0003,A4)
02:0003EE8A 102C0084        	 12141:     move.b  ($0084,A4),D0
02:0003EE8E 003C0011        	 12142:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE92 41EC0084        	 12143:     lea     ($0084,A4),A0
02:0003EE96 12302000        	 12144:     move.b  (A0,D2.W),D1
02:0003EE9A 0A3C0010        	 12145:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE9E 9101            	 12146:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EEA0 0A3C0010        	 12147:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEA4 640A            	 12148:     bcc  _anon_z04_154
02:0003EEA6 122C0003        	 12149:     move.b  ($0003,A4),D1
02:0003EEAA E309            	 12150:     lsl.b  #1,D1   ; ASL $03
02:0003EEAC 19410003        	 12151:     move.b  D1,($0003,A4)
                            	 12152: _anon_z04_154:
                            	 12153:     ; If the horizontal direction toward Link is not allowed, then
                            	 12154:     ; go check the vertical direction.
                            	 12155:     ;
02:0003EEB0 102C0002        	 12156:     move.b  ($0002,A4),D0
02:0003EEB4 122C050F        	 12157:     move.b  ($050F,A4),D1
02:0003EEB8 C200            	 12158:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEBA 6708            	 12159:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12160:     ; If the horizontal direction toward Link is the same direction
                            	 12161:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12162:     ;
02:0003EEBC 122C0098        	 12163:     move.b  ($0098,A4),D1
02:0003EEC0 C200            	 12164:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEC2 6604            	 12165:     bne  _anon_z04_155
                            	 12166:     even
                            	 12167: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12168:     ; Load the vertical direction toward Link in order to test it for
                            	 12169:     ; room boundary and tile collision.
                            	 12170:     ;
02:0003EEC4 102C0003        	 12171:     move.b  ($0003,A4),D0
                            	 12172: _anon_z04_155:
                            	 12173:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12174:     ;
02:0003EEC8 6000FF52        	 12175:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12176: 
                            	 12177:     even
                            	 12178: Lamnola_Move:
                            	 12179:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12180:     ;
                            	 12181:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12182:     ;
                            	 12183:     ; Start with a mask of $A1 in [02]:
                            	 12184:     ; - low nibble represents the right direction
                            	 12185:     ; - high nibble is used to set or clear carry as we go along
                            	 12186:     ;
02:0003EECC 103C00A1        	 12187:     move.b  #$A1,D0
02:0003EED0 19400002        	 12188:     move.b  D0,($0002,A4)
                            	 12189:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12190:     ;
02:0003EED4 41EC0098        	 12191:     lea     ($0098,A4),A0
02:0003EED8 10302000        	 12192:     move.b  (A0,D2.W),D0
02:0003EEDC 122C0002        	 12193:     move.b  ($0002,A4),D1
02:0003EEE0 C200            	 12194:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEE2 6712            	 12195:     beq  _L_z04_Lamnola_Move_Left
02:0003EEE4 10342070        	 12196:     move.b  ($70,A4,D2.W),D0
02:0003EEE8 023C00EE        	 12197:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEEC 122C04E6        	 12198:     move.b  ($04E6,A4),D1
02:0003EEF0 D101            	 12199:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EEF2 19802070        	 12200:     move.b  D0,($70,A4,D2.W)
                            	 12201:     even
                            	 12202: _L_z04_Lamnola_Move_Left:
                            	 12203:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 12204:     ;
02:0003EEF6 41EC0098        	 12205:     lea     ($0098,A4),A0
02:0003EEFA 10302000        	 12206:     move.b  (A0,D2.W),D0
02:0003EEFE 122C0002        	 12207:     move.b  ($0002,A4),D1
02:0003EF02 E309            	 12208:     lsl.b  #1,D1   ; ASL $02
02:0003EF04 19410002        	 12209:     move.b  D1,($0002,A4)
02:0003EF08 122C0002        	 12210:     move.b  ($0002,A4),D1
02:0003EF0C C200            	 12211:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF0E 6716            	 12212:     beq  _L_z04_Lamnola_Move_Down
02:0003EF10 10342070        	 12213:     move.b  ($70,A4,D2.W),D0
02:0003EF14 122C04E6        	 12214:     move.b  ($04E6,A4),D1
02:0003EF18 0A3C0010        	 12215:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF1C 9101            	 12216:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EF1E 0A3C0010        	 12217:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF22 19802070        	 12218:     move.b  D0,($70,A4,D2.W)
                            	 12219:     even
