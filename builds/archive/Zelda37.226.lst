                            	  7843: _L_z04_UpdatePolsVoice_State0:
                            	  7844:     ; State 0. Walking.
                            	  7845:     ;
                            	  7846:     ; If grid offset = 0, then no more distance to cover.
                            	  7847:     ; So, go change to state 1 -- jumping.
                            	  7848:     ;
02:0003CE64 41EC0394        	  7849:     lea     ($0394,A4),A0
02:0003CE68 10302000        	  7850:     move.b  (A0,D2.W),D0
02:0003CE6C 67000084        	  7851:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7852:     ; Decrement grid offset / distance remaining.
                            	  7853:     ;
02:0003CE70 41EC0394        	  7854:     lea     ($0394,A4),A0
02:0003CE74 53302000        	  7855:     subq.b  #1,(A0,D2.W)
                            	  7856:     ; Move vertically.
                            	  7857:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7858:     ;
02:0003CE78 41EC0084        	  7859:     lea     ($0084,A4),A0
02:0003CE7C 10302000        	  7860:     move.b  (A0,D2.W),D0
02:0003CE80 023C00EE        	  7861:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE84 41F90003CE14    	  7862:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE8A 12303000        	  7863:     move.b  (A0,D3.W),D1
02:0003CE8E D101            	  7864:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CE90 41EC0084        	  7865:     lea     ($0084,A4),A0
02:0003CE94 11802000        	  7866:     move.b  D0,(A0,D2.W)
                            	  7867:     even
                            	  7868: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7869:     ; If the square the monster is over is walkable, then
                            	  7870:     ; go draw and check object collisions.
                            	  7871:     ;
02:0003CE98 610001F4        	  7872:     jsr     PolsVoice_IsSquareWalkable
02:0003CE9C 6452            	  7873:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7874:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7875:     ; then go change to state 1.
                            	  7876:     ;
02:0003CE9E 41EC041F        	  7877:     lea     ($041F,A4),A0
02:0003CEA2 10302000        	  7878:     move.b  (A0,D2.W),D0
02:0003CEA6 020000FC        	  7879:     andi.b #$FC,D0
02:0003CEAA 0C0000B0        	  7880:     cmpi.b  #$B0,D0
02:0003CEAE 6742            	  7881:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CEB0 0C0000F4        	  7882:     cmpi.b  #$F4,D0
02:0003CEB4 643C            	  7883:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7884:     ; Else blocked by something else.
                            	  7885:     ;
                            	  7886:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7887:     ;
02:0003CEB6 41EC0098        	  7888:     lea     ($0098,A4),A0
02:0003CEBA 10302000        	  7889:     move.b  (A0,D2.W),D0
02:0003CEBE 02000003        	  7890:     andi.b #$03,D0
02:0003CEC2 6618            	  7891:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7892:     ; Else facing vertically. Flip the direction.
                            	  7893:     ; Go draw.
                            	  7894:     ;
02:0003CEC4 41EC0098        	  7895:     lea     ($0098,A4),A0
02:0003CEC8 10302000        	  7896:     move.b  (A0,D2.W),D0
02:0003CECC 0A00000C        	  7897:     eori.b #$0C,D0
02:0003CED0 41EC0098        	  7898:     lea     ($0098,A4),A0
02:0003CED4 11802000        	  7899:     move.b  D0,(A0,D2.W)
02:0003CED8 6000008C        	  7900:     jmp     L_PolsVoice_DrawAndCheckCollisions
