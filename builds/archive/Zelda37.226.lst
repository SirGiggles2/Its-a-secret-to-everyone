02:0003AA76 6602            	  2846:     bne  _anon_z04_38
02:0003AA78 7601            	  2847:     moveq   #1,D3
                            	  2848: _anon_z04_38:
02:0003AA7A 1003            	  2849:     move.b  D3,D0
02:0003AA7C 023C00EE        	  2850:     andi    #$EE,CCR  ; CLC: clear C+X
