                            	  3020: Jumper_MoveY:
02:0003ABC6 1880            	  3021:     move.b  D0,($0000,A4)
02:0003ABC8 19430002        	  3022:     move.b  D3,($0002,A4)
                            	  3023:     ; Add the high speed byte to the Y coordinate.
                            	  3024:     ;
02:0003ABCC 41EC0412        	  3025:     lea     ($0412,A4),A0
02:0003ABD0 10302000        	  3026:     move.b  (A0,D2.W),D0
02:0003ABD4 41EC0084        	  3027:     lea     ($0084,A4),A0
02:0003ABD8 12302000        	  3028:     move.b  (A0,D2.W),D1
02:0003ABDC D101            	  3029:     addx.b  D1,D0   ; ADC ObjY,X
02:0003ABDE 41EC0084        	  3030:     lea     ($0084,A4),A0
02:0003ABE2 11802000        	  3031:     move.b  D0,(A0,D2.W)
                            	  3032:     ; Add the acceleration to the speed fraction (low byte).
                            	  3033:     ;
02:0003ABE6 41EC041F        	  3034:     lea     ($041F,A4),A0
02:0003ABEA 10302000        	  3035:     move.b  (A0,D2.W),D0
02:0003ABEE 023C00EE        	  3036:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ABF2 1214            	  3037:     move.b  ($0000,A4),D1
02:0003ABF4 D101            	  3038:     addx.b  D1,D0   ; ADC $00
02:0003ABF6 41EC041F        	  3039:     lea     ($041F,A4),A0
02:0003ABFA 11802000        	  3040:     move.b  D0,(A0,D2.W)
                            	  3041:     ; Carry over to the high speed byte.
                            	  3042:     ;
02:0003ABFE 41EC0412        	  3043:     lea     ($0412,A4),A0
02:0003AC02 10302000        	  3044:     move.b  (A0,D2.W),D0
02:0003AC06 123C0000        	  3045:     move.b  #$00,D1
02:0003AC0A D101            	  3046:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AC0C 41EC0412        	  3047:     lea     ($0412,A4),A0
02:0003AC10 11802000        	  3048:     move.b  D0,(A0,D2.W)
                            	  3049:     ; *Signed comparison*:
                            	  3050:     ; If the high speed byte < high max speed byte, then return.
                            	  3051:     ;
                            	  3052:     ; Note that this is not a general purpose signed comparison,
                            	  3053:     ; which would be more complicated. But it works because
                            	  3054:     ; the deviation from 0 of both values is small.
                            	  3055:     ;
02:0003AC14 122C0002        	  3056:     move.b  ($0002,A4),D1
02:0003AC18 B001            	  3057:     cmp.b   D1,D0
02:0003AC1A 6A02            	  3058:     bpl.s  __far_z_04_0028
02:0003AC1C 6022            	  3059:     jmp  L10A52_Exit
                            	  3060: __far_z_04_0028:
                            	  3061:     ; Limit the speed to the max speed.
                            	  3062:     ;
02:0003AC1E 41EC041F        	  3063:     lea     ($041F,A4),A0
