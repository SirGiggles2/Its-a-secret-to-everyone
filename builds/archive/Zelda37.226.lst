                            	 11257: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11258:     ; The whole gleeok died, because the last neck died.
                            	 11259:     ;
                            	 11260:     ; First, hide the first $10 sprites: the attached heads.
                            	 11261:     ;
02:0003E800 4EB900031448    	 11262:     jsr     WriteBlankPrioritySprites
02:0003E806 61000FB8        	 11263:     jsr     PlayBossDeathCry
                            	 11264:     ; We want a death spark. So, set the metastate of the first
                            	 11265:     ; monster slot to $11.
                            	 11266:     ;
02:0003E80A 7011            	 11267:     moveq   #17,D0
02:0003E80C 19400406        	 11268:     move.b  D0,($0406,A4)
                            	 11269:     ; Reset the object type of slots 2 to $A.
                            	 11270:     ;
                            	 11271:     ; Beware a left over fireball in slot $B!
                            	 11272:     ;
02:0003E810 7601            	 11273:     moveq   #1,D3
                            	 11274:     even
                            	 11275: _L_z04_Gleeok_CheckCollisions_DestroyFireballs:
