02:00044604 123C0040        	  7480:     move.b  #$40,D1
02:00044608 0A3C0010        	  7481:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004460C 9101            	  7482:     subx.b  D1,D0   ; SBC #$40
02:0004460E 0A3C0010        	  7483:     eori    #$10,CCR  ; restore X = 6502 C
02:00044612 E208            	  7484:     lsr.b  #1,D0   ; LSR A
02:00044614 E208            	  7485:     lsr.b  #1,D0   ; LSR A
02:00044616 E208            	  7486:     lsr.b  #1,D0   ; LSR A
02:00044618 7600            	  7487:     moveq   #0,D3
02:0004461A 1600            	  7488:     move.b  D0,D3
02:0004461C 1214            	  7489:     move.b  ($00,A4),D1   ; ptr lo
02:0004461E 182C0001        	  7490:     move.b  ($01,A4),D4  ; ptr hi
02:00044622 024100FF        	  7491:     andi.w  #$00FF,D1         ; zero-extend lo byte
