02:00031D6E 1941000D        	  6810:     move.b  D1,($000D,A4)
02:00031D72 122C000E        	  6811:     move.b  ($000E,A4),D1
02:00031D76 E211            	  6812:     roxr.b  #1,D1   ; ROR $0E
02:00031D78 1941000E        	  6813:     move.b  D1,($000E,A4)
02:00031D7C 5303            	  6814:     subq.b  #1,D3
