                            	  6862: Aquamentus_Draw:
                            	  6863:     ; Every $10 screen frames, switch animation frames.
                            	  6864:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6865:     ; The last tile of frame 0 is at index 5.
                            	  6866:     ; The last tile of frame 1 is at index $B.
                            	  6867:     ;
02:0003C7BA 7605            	  6868:     moveq   #5,D3
02:0003C7BC 102C0015        	  6869:     move.b  ($0015,A4),D0
02:0003C7C0 02000010        	  6870:     andi.b #$10,D0
02:0003C7C4 6602            	  6871:     bne  _anon_z04_88
02:0003C7C6 760B            	  6872:     moveq   #11,D3
                            	  6873: _anon_z04_88:
02:0003C7C8 1943000A        	  6874:     move.b  D3,($000A,A4)
                            	  6875:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6876:     ;
02:0003C7CC 7005            	  6877:     moveq   #5,D0
02:0003C7CE 1940000B        	  6878:     move.b  D0,($000B,A4)
                            	  6879:     even
                            	  6880: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7D2 7600            	  6881:     moveq   #0,D3
02:0003C7D4 162C000B        	  6882:     move.b  ($000B,A4),D3
                            	  6883:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6884:     ; Store it in [00].
                            	  6885:     ;
02:0003C7D8 10342070        	  6886:     move.b  ($70,A4,D2.W),D0
02:0003C7DC 023C00EE        	  6887:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7E0 41F90003C7B4    	  6888:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7E6 12303000        	  6889:     move.b  (A0,D3.W),D1
02:0003C7EA D101            	  6890:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7EC 1880            	  6891:     move.b  D0,($0000,A4)
                            	  6892:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6893:     ; Store it in [01].
                            	  6894:     ;
02:0003C7EE 41EC0084        	  6895:     lea     ($0084,A4),A0
02:0003C7F2 10302000        	  6896:     move.b  (A0,D2.W),D0
02:0003C7F6 023C00EE        	  6897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7FA 41F90003C7AE    	  6898:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C800 12303000        	  6899:     move.b  (A0,D3.W),D1
02:0003C804 D101            	  6900:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C806 19400001        	  6901:     move.b  D0,($0001,A4)
                            	  6902:     ; Calculate sprite attributes:
                            	  6903:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6904:     ;
                            	  6905:     ; If the boss is temporarily invincible, then
                            	  6906:     ; this makes it flash by cycling all the palette rows.
                            	  6907:     ;
                            	  6908:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6909:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6910:     ;
02:0003C80A 41EC04F0        	  6911:     lea     ($04F0,A4),A0
02:0003C80E 10302000        	  6912:     move.b  (A0,D2.W),D0
02:0003C812 02000003        	  6913:     andi.b #$03,D0
02:0003C816 0A000003        	  6914:     eori.b #$03,D0
02:0003C81A 19400003        	  6915:     move.b  D0,($0003,A4)
02:0003C81E 7600            	  6916:     moveq   #0,D3
02:0003C820 162C000A        	  6917:     move.b  ($000A,A4),D3
                            	  6918:     ; Look up the tile for this sprite.
                            	  6919:     ; If it's not the first one (face), then go write the sprite record.
                            	  6920:     ;
02:0003C824 41F90003C7A2    	  6921:     lea     (AquamentusTiles).l,A0
02:0003C82A 10303000        	  6922:     move.b  (A0,D3.W),D0
02:0003C82E 12390003C7A2    	  6923:     move.b  (AquamentusTiles).l,D1
02:0003C834 B001            	  6924:     cmp.b   D1,D0
02:0003C836 6610            	  6925:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6926:     ; Else it's the first one (the face tile).
                            	  6927:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6928:     ;
                            	  6929:     ; $CC/CD shows the closed mouth face.
                            	  6930:     ; $C0/C1 shows the open mouth face.
                            	  6931:     ;
02:0003C838 7600            	  6932:     moveq   #0,D3
02:0003C83A 16342028        	  6933:     move.b  ($28,A4,D2.W),D3
02:0003C83E 0C030020        	  6934:     cmpi.b  #$20,D3
02:0003C842 6404            	  6935:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C844 103C00C0        	  6936:     move.b  #$C0,D0
                            	  6937:     even
                            	  6938: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C848 610E            	  6939:     jsr     WriteBossSprite
                            	  6940:     ; Bottom of the loop.
                            	  6941:     ; Decrement tile index and loop index.
                            	  6942:     ;
02:0003C84A 532C000A        	  6943:     subq.b  #1,($000A,A4)
02:0003C84E 532C000B        	  6944:     subq.b  #1,($000B,A4)
02:0003C852 6A00FF7E        	  6945:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C856 4E75            	  6946:     rts
                            	  6947: 
                            	  6948: ; Params:
                            	  6949: ; A: tile
                            	  6950: ; [00]: X
                            	  6951: ; [01]: Y
                            	  6952: ; [03]: sprite attributes
                            	  6953: ;
                            	  6954: ; Save the tile
                            	  6955:     even
                            	  6956: WriteBossSprite:
