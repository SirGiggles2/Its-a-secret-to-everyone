02:00032208 60009C36        	  7524:     jmp     c_play_parry_tune
                            	  7525: 
                            	  7526: L763A_Exit:
02:0003220C 4E75            	  7527:     rts
                            	  7528: 
                            	  7529: ; Params:
                            	  7530: ; A: damage points
                            	  7531: ; X: monster object slot
                            	  7532: ; [00]: weapon object slot
                            	  7533: ; [02]: monster object mid X
                            	  7534: ; [03]: monster object mid Y
                            	  7535: ; [09]: damage type
                            	  7536: ; [0D]: horizontal threshold
                            	  7537: ;
                            	  7538: ; Returns:
                            	  7539: ; [06]: 1 if objects collide
                            	  7540: ; [07]: damage points
                            	  7541: ; [0E]: vertical threshold
                            	  7542: ;
                            	  7543:     even
                            	  7544: CheckMonsterSlenderWeaponCollision:
02:0003220E 19400007        	  7545:     move.b  D0,($0007,A4)
02:00032212 102C000D        	  7546:     move.b  ($000D,A4),D0
02:00032216 1940000E        	  7547:     move.b  D0,($000E,A4)
                            	  7548: ; Params:
                            	  7549: ; X: monster object slot
                            	  7550: ; [00]: weapon object slot
                            	  7551: ; [02]: monster object mid X
                            	  7552: ; [03]: monster object mid Y
                            	  7553: ; [07]: damage points
                            	  7554: ; [09]: damage type
                            	  7555: ; [0D]: horizontal threshold
                            	  7556: ; [0E]: vertical threshold
                            	  7557: ;
                            	  7558: ; Returns:
                            	  7559: ; [06]: 1 if objects collide
                            	  7560: ;
                            	  7561:     even
                            	  7562: CheckMonsterSlenderWeaponCollision2:
02:0003221A 7600            	  7563:     moveq   #0,D3
02:0003221C 1614            	  7564:     move.b  ($0000,A4),D3
                            	  7565:     ; If Link is facing vertically, then:
                            	  7566:     ; [04] := (weapon X + 6)
                            	  7567:     ; A    := (weapon Y + 8)
                            	  7568:     ;
                            	  7569:     ; Shouldn't it be based on the weapon's direction?
                            	  7570:     ;
02:0003221E 102C0098        	  7571:     move.b  ($0098,A4),D0
02:00032222 0200000C        	  7572:     andi.b #$0C,D0
02:00032226 6726            	  7573:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00032228 10343070        	  7574:     move.b  ($70,A4,D3.W),D0
02:0003222C 023C00EE        	  7575:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032230 123C0006        	  7576:     move.b  #$06,D1
02:00032234 D101            	  7577:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032236 19400004        	  7578:     move.b  D0,($0004,A4)
02:0003223A 41EC0084        	  7579:     lea     ($0084,A4),A0
02:0003223E 10303000        	  7580:     move.b  (A0,D3.W),D0
02:00032242 023C00EE        	  7581:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032246 123C0008        	  7582:     move.b  #$08,D1
02:0003224A D101            	  7583:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003224C 6024            	  7584:     jmp     _anon_z01_98
                            	  7585: 
                            	  7586:     even
                            	  7587: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7588:     ; Else Link is facing horizontally.
                            	  7589:     ; [04] := (weapon X + 8)
                            	  7590:     ; A    := (weapon Y + 6)
                            	  7591:     ;
                            	  7592:     ; Shouldn't it be based on the weapon's direction?
                            	  7593:     ;
02:0003224E 10343070        	  7594:     move.b  ($70,A4,D3.W),D0
02:00032252 023C00EE        	  7595:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032256 123C0008        	  7596:     move.b  #$08,D1
02:0003225A D101            	  7597:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003225C 19400004        	  7598:     move.b  D0,($0004,A4)
02:00032260 41EC0084        	  7599:     lea     ($0084,A4),A0
02:00032264 10303000        	  7600:     move.b  (A0,D3.W),D0
02:00032268 023C00EE        	  7601:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003226C 123C0006        	  7602:     move.b  #$06,D1
02:00032270 D101            	  7603:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7604: _anon_z01_98:
                            	  7605:     ; The A register will be copied to [05] and used here.
                            	  7606:     ;
02:00032272 6000FC0A        	  7607:     jmp     CheckMonsterWeaponCollision
                            	  7608: 
                            	  7609: ; Params:
                            	  7610: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7611: ; [00]: weapon object slot (unused)
                            	  7612: ; [02]: object 1 mid X
                            	  7613: ; [03]: object 1 mid Y
                            	  7614: ; [04]: object 2 mid X
                            	  7615: ; [05]: object 2 mid Y
                            	  7616: ;
                            	  7617: ; Returns:
                            	  7618: ; A: 1 if objects collide
                            	  7619: ; Y: weapon object slot
                            	  7620: ; Z: 0 if objects collide
                            	  7621: ; [06]: 1 if objects collide
                            	  7622: ; [0A]: horizontal distance
                            	  7623: ; [0B]: vertical distance
                            	  7624: ;
                            	  7625: ;
                            	  7626: ; Use the same threshold value horizontally and vertically.
                            	  7627: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7628: ;
                            	  7629:     even
                            	  7630: DoObjectsCollide:
02:00032276 1940000D        	  7631:     move.b  D0,($000D,A4)
02:0003227A 1940000E        	  7632:     move.b  D0,($000E,A4)
                            	  7633: ; Params:
                            	  7634: ; [00]: weapon or Link object slot (unused)
                            	  7635: ; [02]: object 1 mid X
                            	  7636: ; [03]: object 1 mid Y
                            	  7637: ; [04]: object 2 mid X
                            	  7638: ; [05]: object 2 mid Y
                            	  7639: ; [0D]: horizontal threshold
                            	  7640: ; [0E]: vertical threshold
                            	  7641: ;
                            	  7642: ; Returns:
                            	  7643: ; A: 1 if objects collide
                            	  7644: ; Y: weapon or Link object slot (copied from [00])
                            	  7645: ; Z: 0 if objects collide
                            	  7646: ; [06]: 1 if objects collide
                            	  7647: ; [0A]: horizontal distance
                            	  7648: ; [0B]: vertical distance
                            	  7649: ;
                            	  7650: ;
                            	  7651: ; Reset [06] to indicate no collision by default.
                            	  7652: ;
                            	  7653:     even
                            	  7654: DoObjectsCollideWithThresholds:
02:0003227E 7000            	  7655:     moveq   #0,D0
02:00032280 19400006        	  7656:     move.b  D0,($0006,A4)
02:00032284 7600            	  7657:     moveq   #0,D3
02:00032286 1614            	  7658:     move.b  ($0000,A4),D3
                            	  7659:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7660:     ;
02:00032288 102C0002        	  7661:     move.b  ($0002,A4),D0
02:0003228C 003C0011        	  7662:     ori     #$11,CCR  ; SEC: set C+X
02:00032290 122C0004        	  7663:     move.b  ($0004,A4),D1
02:00032294 0A3C0010        	  7664:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032298 9101            	  7665:     subx.b  D1,D0   ; SBC $04
02:0003229A 0A3C0010        	  7666:     eori    #$10,CCR  ; restore X = 6502 C
02:0003229E 6100E908        	  7667:     jsr     Abs
02:000322A2 1940000A        	  7668:     move.b  D0,($000A,A4)
                            	  7669:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7670:     ;
02:000322A6 122C000D        	  7671:     move.b  ($000D,A4),D1
02:000322AA B001            	  7672:     cmp.b   D1,D0
02:000322AC 642A            	  7673:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7674:     ; Store in [0B] the vertical distance between the two objects.
                            	  7675:     ;
02:000322AE 102C0003        	  7676:     move.b  ($0003,A4),D0
02:000322B2 003C0011        	  7677:     ori     #$11,CCR  ; SEC: set C+X
02:000322B6 122C0005        	  7678:     move.b  ($0005,A4),D1
02:000322BA 0A3C0010        	  7679:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000322BE 9101            	  7680:     subx.b  D1,D0   ; SBC $05
02:000322C0 0A3C0010        	  7681:     eori    #$10,CCR  ; restore X = 6502 C
02:000322C4 6100E8E2        	  7682:     jsr     Abs
02:000322C8 1940000B        	  7683:     move.b  D0,($000B,A4)
                            	  7684:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7685:     ;
02:000322CC 122C000E        	  7686:     move.b  ($000E,A4),D1
02:000322D0 B001            	  7687:     cmp.b   D1,D0
02:000322D2 6404            	  7688:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7689:     ; If we get here, then the objects are close enough in both axes.
                            	  7690:     ; Return 1.
                            	  7691:     ;
02:000322D4 522C0006        	  7692:     addq.b  #1,($0006,A4)
                            	  7693:     even
                            	  7694: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:000322D8 102C0006        	  7695:     move.b  ($0006,A4),D0
02:000322DC 4E75            	  7696:     rts
                            	  7697: 
                            	  7698: ; Params:
                            	  7699: ; X: caller's object index, a monster
                            	  7700: ;    the attacker, if monster attacks Link
                            	  7701: ;    else defender, if weapon attacks monster
                            	  7702: ; [00]: 0 if monster attacks Link (defender),
                            	  7703: ;       else weapon slot (attacker)
                            	  7704: ; [09]: damage type,
                            	  7705: ;       only if a monster is defending
                            	  7706: ; TODO:
                            	  7707: ; [0B]: direction
                            	  7708: ;
                            	  7709: ; Only monsters (and fire) call this routine.
                            	  7710: ;
                            	  7711: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7712: ;
                            	  7713: ; On the other hand, if a weapon attacks a monster,
                            	  7714: ; the monster sets [00] to the weapon's slot.
                            	  7715: ;
                            	  7716: ;
                            	  7717: ; If a weapon attacks a monster, and the weapon's damage
                            	  7718: ; type matches the monster's invincibility mask;
                            	  7719: ; then return without shoving.
                            	  7720: ;
                            	  7721: ; If a monster attacks Link, then damage type will be 0.
                            	  7722: ;
                            	  7723:     even
                            	  7724: BeginShove:
02:000322DE 7600            	  7725:     moveq   #0,D3
02:000322E0 1614            	  7726:     move.b  ($0000,A4),D3
02:000322E2 0C02000D        	  7727:     cmpi.b  #$0D,D2
02:000322E6 6412            	  7728:     bcc  _anon_z01_99
02:000322E8 41EC04B2        	  7729:     lea     ($04B2,A4),A0
02:000322EC 10302000        	  7730:     move.b  (A0,D2.W),D0
02:000322F0 122C0009        	  7731:     move.b  ($0009,A4),D1
02:000322F4 C001            	  7732:     and.b  D1,D0
02:000322F6 660000C4        	  7733:     bne  _L_z01_BeginShove_Exit
                            	  7734: _anon_z01_99:
                            	  7735:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7736:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7737:     ;
                            	  7738:     ; If instead a monster is defending, then all this calculation
                            	  7739:     ; won't matter, because the shove direction will be set to the
                            	  7740:     ; weapon's direction.
                            	  7741:     ;
                            	  7742:     ; As such, calculate a direction from the monster to the defender,
                            	  7743:     ; assuming it's Link.
                            	  7744:     ;
                            	  7745:     ; Start with an assumption that the direction is vertical:
                            	  7746:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7747:     ;
02:000322FA 7008            	  7748:     moveq   #8,D0
02:000322FC 19400008        	  7749:     move.b  D0,($0008,A4)
02:00032300 41EC0084        	  7750:     lea     ($0084,A4),A0
02:00032304 10302000        	  7751:     move.b  (A0,D2.W),D0
02:00032308 19400004        	  7752:     move.b  D0,($0004,A4)
02:0003230C 41EC0084        	  7753:     lea     ($0084,A4),A0
02:00032310 10303000        	  7754:     move.b  (A0,D3.W),D0
02:00032314 19400005        	  7755:     move.b  D0,($0005,A4)
                            	  7756:     ; If the defender is Link and his grid offset <> 0 then
                            	  7757:     ; use his usual object direction variable to determine
                            	  7758:     ; which axis to check.
                            	  7759:     ;
02:00032318 4A03            	  7760:     cmpi.b  #$00,D3
02:0003231A 6612            	  7761:     bne  _anon_z01_100
02:0003231C 102C0394        	  7762:     move.b  ($0394,A4),D0
02:00032320 670C            	  7763:     beq  _anon_z01_100
02:00032322 102C0098        	  7764:     move.b  ($0098,A4),D0
02:00032326 02000003        	  7765:     andi.b #$03,D0
02:0003232A 660C            	  7766:     bne  _L_z01_BeginShove_CheckHorizontal
02:0003232C 6720            	  7767:     beq  _L_z01_BeginShove_CheckVertical
                            	  7768: _anon_z01_100:
                            	  7769:     ; For monsters defending, or Link with grid offset = 0,
                            	  7770:     ; check direction in [0B].
                            	  7771:     ;
                            	  7772:     ; For monsters defending, this won't matter. For Link with grid
                            	  7773:     ; offset = 0, I believe the result will be arbitrary.
                            	  7774:     ;
                            	  7775:     ; TODO:
                            	  7776:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7777:     ; It doesn't seem to be if candle fire attacks him.
                            	  7778:     ;
02:0003232E 102C000B        	  7779:     move.b  ($000B,A4),D0
02:00032332 0C000004        	  7780:     cmpi.b  #$04,D0
02:00032336 6416            	  7781:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7782:     even
                            	  7783: _L_z01_BeginShove_CheckHorizontal:
                            	  7784:     ; If the direction checked is left or right,
                            	  7785:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7786:     ;
02:00032338 7002            	  7787:     moveq   #2,D0
02:0003233A 19400008        	  7788:     move.b  D0,($0008,A4)
02:0003233E 10342070        	  7789:     move.b  ($70,A4,D2.W),D0
02:00032342 19400004        	  7790:     move.b  D0,($0004,A4)
02:00032346 10343070        	  7791:     move.b  ($70,A4,D3.W),D0
02:0003234A 19400005        	  7792:     move.b  D0,($0005,A4)
                            	  7793:     even
                            	  7794: _L_z01_BeginShove_CheckVertical:
                            	  7795:     ; If the monster is down or right of the other object,
                            	  7796:     ; then use the opposite direction already in [08].
                            	  7797:     ; Else shift [08] right to turn it into the opposite
                            	  7798:     ; direction up or down.
                            	  7799:     ;
                            	  7800:     ; Again assuming Link is the defender; after this, [08] points
                            	  7801:     ; Link away from the monster.
                            	  7802:     ;
02:0003234E 102C0004        	  7803:     move.b  ($0004,A4),D0
02:00032352 122C0005        	  7804:     move.b  ($0005,A4),D1
02:00032356 B001            	  7805:     cmp.b   D1,D0
02:00032358 640A            	  7806:     bcc  _anon_z01_101
