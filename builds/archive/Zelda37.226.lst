                            	  7337: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003CB34 4E75            	  7338:     rts
                            	  7339: 
                            	  7340:     even
                            	  7341: Dodongo_TryEatBomb:
                            	  7342:     ; Try to eat the bomb.
                            	  7343:     ;
                            	  7344:     ; If the bomb is not in range of the monster, then return.
                            	  7345:     ;
                            	  7346:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7347:     ;
02:0003CB36 7601            	  7348:     moveq   #1,D3
02:0003CB38 616E            	  7349:     jsr     Dodongo_IsBombInRange
02:0003CB3A 6666            	  7350:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7351:     ; Will loop from 1 to 0, indexed by [00].
                            	  7352:     ;
02:0003CB3C 7001            	  7353:     moveq   #1,D0
02:0003CB3E 1880            	  7354:     move.b  D0,($0000,A4)
                            	  7355:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7356:     ;
02:0003CB40 41EC0098        	  7357:     lea     ($0098,A4),A0
02:0003CB44 10302000        	  7358:     move.b  (A0,D2.W),D0
02:0003CB48 E208            	  7359:     lsr.b  #1,D0   ; LSR A
02:0003CB4A 7600            	  7360:     moveq   #0,D3
02:0003CB4C 1600            	  7361:     move.b  D0,D3
                            	  7362:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7363:     ; position depends on the orientation of the monster.
                            	  7364:     ;
                            	  7365:     ; Start with the horizontal distance.
                            	  7366:     ;
02:0003CB4E 102C0004        	  7367:     move.b  ($0004,A4),D0
                            	  7368:     even
                            	  7369: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7370:     ; Look up the limits for the given direction.
                            	  7371:     ;
                            	  7372:     ; If the distance from the bomb < negative limit,
                            	  7373:     ; or >= positive limit, then return.
                            	  7374:     ;
                            	  7375:     ; Note that these are simple signed comparisons that work,
                            	  7376:     ; because the operands are in a small range.
                            	  7377:     ;
02:0003CB52 41F90003CA8C    	  7378:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB58 12303000        	  7379:     move.b  (A0,D3.W),D1
02:0003CB5C B001            	  7380:     cmp.b   D1,D0
02:0003CB5E 6B42            	  7381:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB60 41F90003CA92    	  7382:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB66 12303000        	  7383:     move.b  (A0,D3.W),D1
02:0003CB6A B001            	  7384:     cmp.b   D1,D0
02:0003CB6C 6A34            	  7385:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7386:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7387:     ;
02:0003CB6E 1003            	  7388:     move.b  D3,D0
02:0003CB70 023C00EE        	  7389:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB74 123C000A        	  7390:     move.b  #$0A,D1
02:0003CB78 D101            	  7391:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB7A 7600            	  7392:     moveq   #0,D3
02:0003CB7C 1600            	  7393:     move.b  D0,D3
                            	  7394:     ; Bottom of the loop.
                            	  7395:     ;
                            	  7396:     ; Load the vertical distance for the next iteration.
                            	  7397:     ; Decrement loop counter.
                            	  7398:     ;
02:0003CB7E 102C0005        	  7399:     move.b  ($0005,A4),D0
02:0003CB82 5314            	  7400:     subq.b  #1,($0000,A4)
02:0003CB84 6ACC            	  7401:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7402:     ; If we get here, then the bomb was within range of the mouth.
                            	  7403:     ; Go to state 1 (bloated).
                            	  7404:     ;
02:0003CB86 41EC00AC        	  7405:     lea     ($00AC,A4),A0
02:0003CB8A 52302000        	  7406:     addq.b  #1,(A0,D2.W)
                            	  7407:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7408:     ;
02:0003CB8E 7610            	  7409:     moveq   #16,D3
02:0003CB90 7000            	  7410:     moveq   #0,D0
02:0003CB92 41EC00AC        	  7411:     lea     ($00AC,A4),A0
02:0003CB96 11803000        	  7412:     move.b  D0,(A0,D3.W)
02:0003CB9A 41EC042C        	  7413:     lea     ($042C,A4),A0
02:0003CB9E 11802000        	  7414:     move.b  D0,(A0,D2.W)
                            	  7415:     even
                            	  7416: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CBA2 4E75            	  7417:     rts
                            	  7418: 
                            	  7419:     even
                            	  7420: DodongoBombPositiveLimits:
02:0003CBA4 0C              	  7421:     dc.b    $0C, $11
02:0003CBA5 11
                            	  7422: 
                            	  7423:     even
                            	  7424: DodongoBombNegativeLimits:
02:0003CBA6 F4              	  7425:     dc.b    $F4, $F0
02:0003CBA7 F0
                            	  7426: 
                            	  7427: ; Params:
                            	  7428: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7429: ; [00]: monster hotspot X
                            	  7430: ; [01]: monster hotspot Y
                            	  7431: ; [02]: bomb hotspot X
                            	  7432: ; [03]: bomb hotspot Y
                            	  7433: ;
                            	  7434: ; Returns:
                            	  7435: ; A: 0 if the bomb is in range of the monster
                            	  7436: ; Z: 1 if the bomb is in range of the monster
                            	  7437: ; [04]: horizontal distance
                            	  7438: ; [05]: vertical distance
                            	  7439: ;
                            	  7440: ; Store the positive limit in [06], and the negative one in [07].
                            	  7441: ;
                            	  7442:     even
                            	  7443: Dodongo_IsBombInRange:
02:0003CBA8 41F90003CBA4    	  7444:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBAE 10303000        	  7445:     move.b  (A0,D3.W),D0
02:0003CBB2 19400006        	  7446:     move.b  D0,($0006,A4)
02:0003CBB6 41F90003CBA6    	  7447:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CBBC 10303000        	  7448:     move.b  (A0,D3.W),D0
02:0003CBC0 19400007        	  7449:     move.b  D0,($0007,A4)
                            	  7450:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7451:     ; the bomb is near enough the monster.
                            	  7452:     ;
02:0003CBC4 7003            	  7453:     moveq   #3,D0
02:0003CBC6 19400008        	  7454:     move.b  D0,($0008,A4)
                            	  7455:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7456:     ;
02:0003CBCA 7601            	  7457:     moveq   #1,D3
                            	  7458:     even
                            	  7459: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7460:     ; Subtract the bomb's coordinate from the boss's,
                            	  7461:     ; The loop index determines the coordinate.
                            	  7462:     ;
02:0003CBCC 10343000        	  7463:     move.b  ($00,A4,D3.W),D0
02:0003CBD0 003C0011        	  7464:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBD4 12343002        	  7465:     move.b  ($02,A4,D3.W),D1
02:0003CBD8 0A3C0010        	  7466:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBDC 9101            	  7467:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBDE 0A3C0010        	  7468:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7469:     ; If the distance >= positive offset, or < negative offset;
                            	  7470:     ; then loop again.
                            	  7471:     ;
02:0003CBE2 122C0006        	  7472:     move.b  ($0006,A4),D1
02:0003CBE6 B001            	  7473:     cmp.b   D1,D0
02:0003CBE8 6A16            	  7474:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBEA 122C0007        	  7475:     move.b  ($0007,A4),D1
02:0003CBEE B001            	  7476:     cmp.b   D1,D0
02:0003CBF0 6B0E            	  7477:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7478:     ; The distance is close enough in this axis.
                            	  7479:     ;
                            	  7480:     ; Store the distance in this axis in [05] or [04],
                            	  7481:     ; depending on the loop index.
                            	  7482:     ;
02:0003CBF2 19803004        	  7483:     move.b  D0,($04,A4,D3.W)
                            	  7484:     ; Shift [08] right, because we're in range in this axis.
                            	  7485:     ;
02:0003CBF6 122C0008        	  7486:     move.b  ($0008,A4),D1
02:0003CBFA E209            	  7487:     lsr.b  #1,D1   ; LSR $08
02:0003CBFC 19410008        	  7488:     move.b  D1,($0008,A4)
                            	  7489:     even
                            	  7490: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC00 5303            	  7491:     subq.b  #1,D3
02:0003CC02 6AC8            	  7492:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7493:     ; If close enough in both axes, then [08] will be 0.
                            	  7494:     ;
02:0003CC04 102C0008        	  7495:     move.b  ($0008,A4),D0
02:0003CC08 4E75            	  7496:     rts
                            	  7497: 
                            	  7498: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7499: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7500: ;
                            	  7501: ; But these are not typical direction indexes. Instead a
                            	  7502: ; 5-way index is used.
                            	  7503: ; A direction shifted right once becomes a 5-way index.
                            	  7504: ; The fourth element is unused.
                            	  7505: ;
                            	  7506:     even
                            	  7507: DodongoFrameImages:
02:0003CC0A 00              	  7508:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CC0B 01
02:0003CC0C 06
02:0003CC0D FF
02:0003CC0E 08
02:0003CC0F 02
02:0003CC10 03
02:0003CC11 06
02:0003CC12 FF              	  7509:     dc.b    $FF, $08
02:0003CC13 08
                            	  7510: 
                            	  7511:     even
                            	  7512: DodongoFrameHFlips:
02:0003CC14 00              	  7513:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CC15 40
02:0003CC16 00
02:0003CC17 FF
02:0003CC18 00
02:0003CC19 00
02:0003CC1A 40
02:0003CC1B 40
02:0003CC1C FF              	  7514:     dc.b    $FF, $40
02:0003CC1D 40
                            	  7515: 
                            	  7516:     even
                            	  7517: DodongoFrameImagesBloated:
02:0003CC1E 04              	  7518:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CC1F 05
02:0003CC20 07
02:0003CC21 FF
02:0003CC22 09
02:0003CC23 04
02:0003CC24 05
02:0003CC25 07
02:0003CC26 FF              	  7519:     dc.b    $FF, $09
02:0003CC27 09
                            	  7520: 
                            	  7521:     even
                            	  7522: DodongoFrameHFlipsBloated:
02:0003CC28 00              	  7523:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC29 40
02:0003CC2A 00
02:0003CC2B FF
02:0003CC2C 00
02:0003CC2D 00
02:0003CC2E 40
02:0003CC2F 00
02:0003CC30 FF              	  7524:     dc.b    $FF, $00
02:0003CC31 00
