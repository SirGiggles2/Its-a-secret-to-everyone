02:0003B14C E0              	  3774:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B14D B0
02:0003B14E B0
02:0003B14F 30
02:0003B150 40
02:0003B151 90
02:0003B152 A0
