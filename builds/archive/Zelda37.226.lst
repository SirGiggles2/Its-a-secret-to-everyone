02:0003AB84 0C0000F0        	  2981:     cmpi.b  #$F0,D0
02:0003AB88 6402            	  2982:     bcc.s  __far_z_04_0026
02:0003AB8A 6032            	  2983:     jmp  L10A10_Exit
                            	  2984: __far_z_04_0026:
                            	  2985:     ; Else the boulder is close enough to the bottom of the screen
