02:000422E8 A9              	  4300:     dc.b    $A9, $F8, $8D, $40, $02, $8D, $44, $02
02:000422E9 F8
02:000422EA 8D
02:000422EB 40
02:000422EC 02
02:000422ED 8D
02:000422EE 44
02:000422EF 02
02:000422F0 60              	  4301:     dc.b    $60
                            	  4302: 
                            	  4303: ; To be considered within a doorway, one condition is that
                            	  4304: ; Link's perpendicular coordinate ([00]) has to match the doorway's
                            	  4305: ; (X=$78 for verticals, Y=$8D for horizontals).
                            	  4306: ;
                            	  4307: ; See GetPlayerCoordsForDirection.
                            	  4308: ;
                            	  4309:     even
                            	  4310: DoorwayRequiredCoord:
02:000422F2 78              	  4311:     dc.b    $78, $78, $8D, $8D
02:000422F3 78
02:000422F4 8D
02:000422F5 8D
                            	  4312: 
                            	  4313: ; Player coordinate must be >= these bounds.
                            	  4314: ; Using these bounds; the player will be considered within the
                            	  4315: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4316: ;
                            	  4317:     even
                            	  4318: DoorwayBoundsMinOver:
02:000422F6 3D              	  4319:     dc.b    $3D, $BD, $00, $CF
02:000422F7 BD
02:000422F8 00
02:000422F9 CF
                            	  4320: 
                            	  4321: ; Player coordinate must be < these bounds.
                            	  4322: ; Using these bounds; the player will be considered within the
                            	  4323: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4324: ;
                            	  4325:     even
                            	  4326: DoorwayBoundsMaxOver:
02:000422FA 5E              	  4327:     dc.b    $5E, $DE, $21, $F1
02:000422FB DE
02:000422FC 21
02:000422FD F1
                            	  4328: 
                            	  4329: ; Player coordinate must be >= these bounds.
                            	  4330: ; Using these bounds; the player will be considered within the
                            	  4331: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4332: ; at the edge.
                            	  4333: ;
                            	  4334:     even
                            	  4335: DoorwayBoundsMinUnder:
02:000422FE 3D              	  4336:     dc.b    $3D, $BF, $00, $D2
02:000422FF BF
02:00042300 00
02:00042301 D2
                            	  4337: 
                            	  4338: ; Player coordinate must be < these bounds.
                            	  4339: ; Using these bounds; the player will be considered within the
                            	  4340: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4341: ; at the edge.
                            	  4342: ;
                            	  4343:     even
                            	  4344: DoorwayBoundsMaxUnder:
02:00042302 5C              	  4345:     dc.b    $5C, $DE, $1F, $F1
02:00042303 DE
02:00042304 1F
02:00042305 F1
                            	  4346: 
                            	  4347: ; Params:
                            	  4348: ; [0F]: moving direction
                            	  4349: ;
                            	  4350: ; Returns:
                            	  4351: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4352: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4353: ;
                            	  4354: ; When not at or in a doorway, this function leaves
                            	  4355: ; [0F] moving direction as is.
                            	  4356: ;
                            	  4357: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4358: ; will be left as is, assuming that it had been reset before this
                            	  4359: ; routine by BoundByRoom.
