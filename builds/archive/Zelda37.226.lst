                            	  7142: __far_z_04_0065:
                            	  7143:     ; New bloated substate >= 2.
                            	  7144:     ;
                            	  7145:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7146:     ; which will transition to state 0 (moving).
                            	  7147:     ;
                            	  7148:     ; Note that if the bomb hits >= 2, then:
                            	  7149:     ; - If new substate = 2, then substate 2 will wait,
                            	  7150:     ;   and then transition to substate 3.
                            	  7151:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7152:     ;
