02:00043862 1400            	  5881:     move.b  D0,D2
02:00043864 1003            	  5882:     move.b  D3,D0
                            	  5883:     ; If provisional door face is not for a shutter, then
                            	  5884:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5885:     ;
                            	  5886:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5887:     ;
02:00043866 0C000007        	  5888:     cmpi.b  #$07,D0
02:0004386A 670E            	  5889:     beq  _anon_z05_111
