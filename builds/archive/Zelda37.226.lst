02:000422D6 122C03F8        	  4286:     move.b  ($03F8,A4),D1
02:000422DA C001            	  4287:     and.b  D1,D0
                            	  4288:     ; If neither direction matched input direction, then
                            	  4289:     ; change input direction to facing direction.
                            	  4290:     ;
02:000422DC 6604            	  4291:     bne  _anon_z05_94
02:000422DE 102C0098        	  4292:     move.b  ($0098,A4),D0
                            	  4293: _anon_z05_94:
