02:0003AB90 4EF90004D9A2    	  2989:     jmp     DestroyMonster
                            	  2990: 
                            	  2991: ; Returns:
                            	  2992: ; Y: 0: blue tektite
                            	  2993: ;    1: red tektite
                            	  2994: ;    2: boulder
                            	  2995: ;
                            	  2996:     even
                            	  2997: Jumper_GetKind:
02:0003AB96 41EC034F        	  2998:     lea     ($034F,A4),A0
02:0003AB9A 10302000        	  2999:     move.b  (A0,D2.W),D0
02:0003AB9E 003C0011        	  3000:     ori     #$11,CCR  ; SEC: set C+X
02:0003ABA2 123C000D        	  3001:     move.b  #$0D,D1
02:0003ABA6 0A3C0010        	  3002:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ABAA 9101            	  3003:     subx.b  D1,D0   ; SBC #$0D
02:0003ABAC 0A3C0010        	  3004:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ABB0 7600            	  3005:     moveq   #0,D3
02:0003ABB2 1600            	  3006:     move.b  D0,D3
02:0003ABB4 0C030002        	  3007:     cmpi.b  #$02,D3
