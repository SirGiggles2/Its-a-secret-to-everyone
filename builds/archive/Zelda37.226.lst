                            	  3341:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3342:     ; go see if the tile is valid to come out of.
                            	  3343:     ;
                            	  3344:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3345:     ;
02:0003AE4E 0C00005D        	  3346:     cmpi.b  #$5D,D0
02:0003AE52 647A            	  3347:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
