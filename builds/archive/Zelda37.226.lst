                            	  3777: InitArmosOrFlyingGhini:
                            	  3778:     ; In UpdateObject, this object was flagged "initialized".
                            	  3779:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3780:     ;
02:0003B154 10342028        	  3781:     move.b  ($28,A4,D2.W),D0
02:0003B158 41EC0492        	  3782:     lea     ($0492,A4),A0
02:0003B15C 11802000        	  3783:     move.b  D0,(A0,D2.W)
                            	  3784:     ; If it's still fading in, then go finish some initialization needed
                            	  3785:     ; for fading in.
                            	  3786:     ;
02:0003B160 660000B6        	  3787:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3788:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3789:     ; go finish initializing it.
                            	  3790:     ;
02:0003B164 41EC034F        	  3791:     lea     ($034F,A4),A0
02:0003B168 10302000        	  3792:     move.b  (A0,D2.W),D0
02:0003B16C 0C000022        	  3793:     cmpi.b  #$22,D0
02:0003B170 670000A6        	  3794:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3795:     ; Else we have an armos.
                            	  3796:     ;
                            	  3797:     ; Store stairs tile $70 in [00] for use later.
                            	  3798:     ;
02:0003B174 7070            	  3799:     moveq   #112,D0
02:0003B176 1880            	  3800:     move.b  D0,($0000,A4)
                            	  3801:     ; Look for the current room ID in an array of room ID's that
                            	  3802:     ; have armos secrets.
                            	  3803:     ;
02:0003B178 7606            	  3804:     moveq   #6,D3
                            	  3805:     even
                            	  3806: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B17A 102C00EB        	  3807:     move.b  ($00EB,A4),D0
                            	  3808:     ; If this element does not match the current room ID, go loop again.
                            	  3809:     ;
02:0003B17E 41F90003B144    	  3810:     lea     (SecretArmosRoomIds).l,A0
02:0003B184 12303000        	  3811:     move.b  (A0,D3.W),D1
02:0003B188 B001            	  3812:     cmp.b   D1,D0
02:0003B18A 6648            	  3813:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3814:     ; The secret (usually stairs) is under one of the armoses.
                            	  3815:     ;
                            	  3816:     ; If the armos's X coordinate does not match the one needed
                            	  3817:     ; for the current room in the list, then go loop again.
                            	  3818:     ;
02:0003B18C 10342070        	  3819:     move.b  ($70,A4,D2.W),D0
02:0003B190 41F90003B14C    	  3820:     lea     (SecretArmosXs).l,A0
02:0003B196 12303000        	  3821:     move.b  (A0,D3.W),D1
02:0003B19A B001            	  3822:     cmp.b   D1,D0
02:0003B19C 6636            	  3823:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3824:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3825:     ;
02:0003B19E 41EC0084        	  3826:     lea     ($0084,A4),A0
02:0003B1A2 10302000        	  3827:     move.b  (A0,D2.W),D0
02:0003B1A6 0C000080        	  3828:     cmpi.b  #$80,D0
02:0003B1AA 6628            	  3829:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3830:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3831:     ;
02:0003B1AC 4A03            	  3832:     cmpi.b  #$00,D3
02:0003B1AE 662C            	  3833:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3834:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3835:     ; has the power bracelet.
                            	  3836:     ;
                            	  3837:     ; Set up the room item with the armos's coordinates.
                            	  3838:     ;
02:0003B1B0 19400097        	  3839:     move.b  D0,($0097,A4)
02:0003B1B4 10342070        	  3840:     move.b  ($70,A4,D2.W),D0
02:0003B1B8 19400083        	  3841:     move.b  D0,($0083,A4)
                            	  3842:     ; This resets the room item's state, which activates it.
                            	  3843:     ;
02:0003B1BC 194300BF        	  3844:     move.b  D3,($00BF,A4)
                            	  3845:     ; Set the room item ID.
                            	  3846:     ;
02:0003B1C0 7014            	  3847:     moveq   #20,D0
02:0003B1C2 194000AB        	  3848:     move.b  D0,($00AB,A4)
                            	  3849:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3850:     ;
                            	  3851:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3852:     ;
                            	  3853:     ; Note that, if the item was already taken, then the room item
                            	  3854:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3855:     ; it will be ignored, because that routine checks whether
                            	  3856:     ; the item was taken.
                            	  3857:     ;
02:0003B1C6 4EB9000310A0    	  3858:     jsr     GetRoomFlagUWItemState
02:0003B1CC 660A            	  3859:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B1CE 610006C6        	  3860:     jsr     PlaySecretFoundTune
02:0003B1D2 6604            	  3861:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3862:     even
                            	  3863: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3864:     ; Bottom of the loop.
                            	  3865:     ;
02:0003B1D4 5303            	  3866:     subq.b  #1,D3
02:0003B1D6 6AA2            	  3867:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3868:     even
                            	  3869: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3870:     ; Not found, or found the power bracelet.
                            	  3871:     ; Use a floor tile $26 to replace the armos.
                            	  3872:     ;
02:0003B1D8 7026            	  3873:     moveq   #38,D0
02:0003B1DA 1880            	  3874:     move.b  D0,($0000,A4)
                            	  3875:     even
                            	  3876: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B1DC 1014            	  3877:     move.b  ($0000,A4),D0
                            	  3878:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3879:     ;
02:0003B1DE 1B00            	  3880:     move.b  D0,-(A5)  ; PHA
02:0003B1E0 0C000070        	  3881:     cmpi.b  #$70,D0
02:0003B1E4 6604            	  3882:     bne  _anon_z04_51
02:0003B1E6 610006AE        	  3883:     jsr     PlaySecretFoundTune
                            	  3884: _anon_z04_51:
                            	  3885:     ; Replace the tile where the armos was.
                            	  3886:     ;
02:0003B1EA 522C00F7        	  3887:     addq.b  #1,($00F7,A4)
02:0003B1EE 101D            	  3888:     move.b  (A5)+,D0  ; PLA
02:0003B1F0 4EB90004B01E    	  3889:     jsr     ChangeTileObjTiles
                            	  3890:     ; Because the armos object is aligned to the square grid
                            	  3891:     ; (because it was made from a square),
                            	  3892:     ; set its grid offset to 3 to compensate.
                            	  3893:     ;
                            	  3894:     ; Most objects are aligned to the grid vertically when the
                            	  3895:     ; low nibble is $D.
                            	  3896:     ;
02:0003B1F6 7003            	  3897:     moveq   #3,D0
02:0003B1F8 41EC0394        	  3898:     lea     ($0394,A4),A0
02:0003B1FC 11802000        	  3899:     move.b  D0,(A0,D2.W)
                            	  3900:     ; Set a speed (q-speed fraction) randomly:
                            	  3901:     ; $20 if random value < $80
                            	  3902:     ; $60 otherwise
                            	  3903:     ;
02:0003B200 7020            	  3904:     moveq   #32,D0
02:0003B202 7600            	  3905:     moveq   #0,D3
02:0003B204 16342019        	  3906:     move.b  ($19,A4,D2.W),D3
02:0003B208 0C030080        	  3907:     cmpi.b  #$80,D3
02:0003B20C 6502            	  3908:     bcs  _anon_z04_52
02:0003B20E 7060            	  3909:     moveq   #96,D0
                            	  3910: _anon_z04_52:
02:0003B210 41EC03BC        	  3911:     lea     ($03BC,A4),A0
02:0003B214 11802000        	  3912:     move.b  D0,(A0,D2.W)
                            	  3913:     even
                            	  3914: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3915:     ; Facing and input directions down.
                            	  3916:     ;
02:0003B218 7004            	  3917:     moveq   #4,D0
02:0003B21A 41EC03F8        	  3918:     lea     ($03F8,A4),A0
02:0003B21E 11802000        	  3919:     move.b  D0,(A0,D2.W)
02:0003B222 41EC0098        	  3920:     lea     ($0098,A4),A0
02:0003B226 11802000        	  3921:     move.b  D0,(A0,D2.W)
                            	  3922:     ; Every other frame, return without drawing.
                            	  3923:     ;
02:0003B22A 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:0003B22E E208            	  3925:     lsr.b  #1,D0   ; LSR A
02:0003B230 6512            	  3926:     bcs  _anon_z04_53
                            	  3927:     ; Finish initializing based on type.
                            	  3928:     ;
02:0003B232 41EC034F        	  3929:     lea     ($034F,A4),A0
02:0003B236 10302000        	  3930:     move.b  (A0,D2.W),D0
02:0003B23A 0C000022        	  3931:     cmpi.b  #$22,D0
