02:00031C8E 41EC034F        	  6679:     lea     ($034F,A4),A0
02:00031C92 10302000        	  6680:     move.b  (A0,D2.W),D0
02:00031C96 0C000053        	  6681:     cmpi.b  #$53,D0
02:00031C9A 6402            	  6682:     bcc.s  __far_z_01_0065
02:00031C9C 607C            	  6683:     jmp  HarmLink
                            	  6684: __far_z_01_0065:
                            	  6685:     ; Here, the attacker is a monster's shot/projectile.
                            	  6686:     ; Flag this kind of collision.
                            	  6687:     ;
02:00031C9E 522C034B        	  6688:     addq.b  #1,($034B,A4)
