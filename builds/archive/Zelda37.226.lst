02:0004CC10 41F90004CB32    	  6306:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004CC16 12303000        	  6307:     move.b  (A0,D3.W),D1
02:0004CC1A D101            	  6308:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004CC1C 41EC0084        	  6309:     lea     ($0084,A4),A0
02:0004CC20 11802000        	  6310:     move.b  D0,(A0,D2.W)
02:0004CC24 19400001        	  6311:     move.b  D0,($0001,A4)
                            	  6312:     ; If state = 1, use up direction.
                            	  6313:     ; Else use object direction.
