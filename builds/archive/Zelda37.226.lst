                            	  6468: Digdogger_Move:
                            	  6469:     ; This calculation is the same one used in Manhandla to
                            	  6470:     ; manifest the fractional speed over several frames.
                            	  6471:     ;
                            	  6472:     ; To summarize, the formula is:
                            	  6473:     ;
                            	  6474:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6475:     ;
                            	  6476:     ;   SA := SA + (SL AND $E0)
                            	  6477:     ;   [03] := SH + carry
                            	  6478:     ;
                            	  6479:     ; See 04:A28E Manhandla_Move.
                            	  6480:     ;
02:0003C4B4 41EC041F        	  6481:     lea     ($041F,A4),A0
02:0003C4B8 10302000        	  6482:     move.b  (A0,D2.W),D0
02:0003C4BC 020000E0        	  6483:     andi.b #$E0,D0
02:0003C4C0 023C00EE        	  6484:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4C4 41EC0412        	  6485:     lea     ($0412,A4),A0
02:0003C4C8 12302000        	  6486:     move.b  (A0,D2.W),D1
02:0003C4CC D101            	  6487:     addx.b  D1,D0   ; ADC $0412,X
02:0003C4CE 41EC0412        	  6488:     lea     ($0412,A4),A0
02:0003C4D2 11802000        	  6489:     move.b  D0,(A0,D2.W)
                            	  6490:     ; Assign (high speed byte + carry) to [03].
                            	  6491:     ;
02:0003C4D6 41EC042C        	  6492:     lea     ($042C,A4),A0
02:0003C4DA 10302000        	  6493:     move.b  (A0,D2.W),D0
02:0003C4DE 123C0000        	  6494:     move.b  #$00,D1
02:0003C4E2 D101            	  6495:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C4E4 19400003        	  6496:     move.b  D0,($0003,A4)
                            	  6497:     ; Change coordinates by the speed amount/offset in [03]
                            	  6498:     ; according to the direction.
                            	  6499:     ;
                            	  6500:     ; Start with a mask of $A1 in [02]:
                            	  6501:     ; - low nibble represents the right direction
                            	  6502:     ; - high nibble is used to set or clear carry as we go along
                            	  6503:     ;
02:0003C4E8 103C00A1        	  6504:     move.b  #$A1,D0
02:0003C4EC 19400002        	  6505:     move.b  D0,($0002,A4)
                            	  6506:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6507:     ;
02:0003C4F0 41EC0098        	  6508:     lea     ($0098,A4),A0
02:0003C4F4 10302000        	  6509:     move.b  (A0,D2.W),D0
02:0003C4F8 122C0002        	  6510:     move.b  ($0002,A4),D1
02:0003C4FC C200            	  6511:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4FE 6712            	  6512:     beq  _L_z04_Digdogger_Move_Left
02:0003C500 10342070        	  6513:     move.b  ($70,A4,D2.W),D0
02:0003C504 023C00EE        	  6514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C508 122C0003        	  6515:     move.b  ($0003,A4),D1
02:0003C50C D101            	  6516:     addx.b  D1,D0   ; ADC $03
02:0003C50E 19802070        	  6517:     move.b  D0,($70,A4,D2.W)
                            	  6518:     even
