02:0004BFA4 6704            	  4531:     beq.s  __far_z_07_0061
02:0004BFA6 60000092        	  4532:     jmp  CheckBoundary
                            	  4533: __far_z_07_0061:
                            	  4534:     ; The object is Link. We end up here regardless of walkability.
                            	  4535:     ;
                            	  4536:     ; If not in mode 5 or ladder is in use, return.
                            	  4537:     ;
02:0004BFAA 102C0012        	  4538:     move.b  ($0012,A4),D0
02:0004BFAE 0C000005        	  4539:     cmpi.b  #$05,D0
02:0004BFB2 6704            	  4540:     beq.s  __far_z_07_0062
02:0004BFB4 60000080        	  4541:     jmp  ExitX0
                            	  4542: __far_z_07_0062:
02:0004BFB8 102C0064        	  4543:     move.b  ($0064,A4),D0
02:0004BFBC 6702            	  4544:     beq.s  __far_z_07_0063
02:0004BFBE 60DA            	  4545:     jmp  L1F148_Exit
                            	  4546: __far_z_07_0063:
                            	  4547:     ; If grid offset <> 0, return.
                            	  4548:     ;
02:0004BFC0 102C0394        	  4549:     move.b  ($0394,A4),D0
02:0004BFC4 6702            	  4550:     beq.s  __far_z_07_0064
02:0004BFC6 606E            	  4551:     jmp  ExitX0
                            	  4552: __far_z_07_0064:
