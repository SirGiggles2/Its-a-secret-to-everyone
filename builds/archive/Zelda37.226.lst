                            	  6766:     ; Flag collision with [0C], even though [06] was already set.
                            	  6767:     ;
02:00031D1E 522C000C        	  6768:     addq.b  #1,($000C,A4)
                            	  6769:     ; Unpack the damage points for the monster's type.
                            	  6770:     ; The low nibble is the high byte.
                            	  6771:     ; (Damage points byte AND $F0) is the low byte.
                            	  6772:     ;
02:00031D22 7600            	  6773:     moveq   #0,D3
02:00031D24 41EC034F        	  6774:     lea     ($034F,A4),A0
02:00031D28 16302000        	  6775:     move.b  (A0,D2.W),D3
02:00031D2C 41F900031B8E    	  6776:     lea     (ObjTypeToDamagePoints).l,A0
02:00031D32 10303000        	  6777:     move.b  (A0,D3.W),D0
02:00031D36 1B00            	  6778:     move.b  D0,-(A5)  ; PHA
02:00031D38 0200000F        	  6779:     andi.b #$0F,D0
02:00031D3C 1940000D        	  6780:     move.b  D0,($000D,A4)
02:00031D40 101D            	  6781:     move.b  (A5)+,D0  ; PLA
02:00031D42 020000F0        	  6782:     andi.b #$F0,D0
02:00031D46 1940000E        	  6783:     move.b  D0,($000E,A4)
                            	  6784: ; Params:
                            	  6785: ; X: object index of the attacker
                            	  6786: ; [0D]: damage points high byte
                            	  6787: ; [0E]: damage points low byte
                            	  6788: ;
                            	  6789: ;
                            	  6790: ; If object type is not whirlwind, then make the "hurt" sound effect.
