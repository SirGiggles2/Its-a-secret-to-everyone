                            	  6204:     ; Write the transfer record header for the door.
                            	  6205:     ;
                            	  6206:     ;
                            	  6207:     ; VRAM address high byte of door
02:00043A82 1014            	  6208:     move.b  ($0000,A4),D0
02:00043A84 41EC0302        	  6209:     lea     ($0302,A4),A0
02:00043A88 11802000        	  6210:     move.b  D0,(A0,D2.W)
02:00043A8C 5202            	  6211:     addq.b  #1,D2
02:00043A8E 102C0001        	  6212:     move.b  ($0001,A4),D0
02:00043A92 41EC0302        	  6213:     lea     ($0302,A4),A0
02:00043A96 11802000        	  6214:     move.b  D0,(A0,D2.W)
02:00043A9A 5202            	  6215:     addq.b  #1,D2
02:00043A9C 102C0006        	  6216:     move.b  ($0006,A4),D0
02:00043AA0 41EC0302        	  6217:     lea     ($0302,A4),A0
02:00043AA4 11802000        	  6218:     move.b  D0,(A0,D2.W)
02:00043AA8 5202            	  6219:     addq.b  #1,D2
                            	  6220: _anon_z05_121:
                            	  6221:     ; Write two tiles in a short loop indexed by [04].
                            	  6222:     ;
02:00043AAA 6100ED1C        	  6223:     jsr     WriteDoorFaceTileHorizontally
02:00043AAE 66FA            	  6224:     bne  _anon_z05_121
                            	  6225:     ; OR the low VRAM address with $20 to go down one row
                            	  6226:     ; in order to work on the second row of door tiles.
                            	  6227:     ;
02:00043AB0 7020            	  6228:     moveq   #32,D0
02:00043AB2 122C0001        	  6229:     move.b  ($0001,A4),D1
02:00043AB6 8001            	  6230:     or.b  D1,D0
02:00043AB8 19400001        	  6231:     move.b  D0,($0001,A4)
                            	  6232:     ; Bottom of the loop.
                            	  6233:     ; Loop again to write the second transfer record for the
                            	  6234:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6235:     ;
02:00043ABC 532C0005        	  6236:     subq.b  #1,($0005,A4)
02:00043AC0 66B8            	  6237:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6238:     ; Write the end marker, and update buffer length.
