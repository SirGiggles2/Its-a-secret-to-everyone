02:00041AC2 023C00EE        	  3143:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041AC6 123C0008        	  3144:     move.b  #$08,D1
02:00041ACA D101            	  3145:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041ACC 7600            	  3146:     moveq   #0,D3
02:00041ACE 1600            	  3147:     move.b  D0,D3
02:00041AD0 103C0080        	  3148:     move.b  #$80,D0
