                            	  7878: _anon_z05_156:
02:00044BD6 101D            	  7879:     move.b  (A5)+,D0  ; PLA
                            	  7880:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7881:     ; then the player walked all the way to the edge of the play
                            	  7882:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7883:     ;
                            	  7884:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7885:     ; edge of the play area. So, set a relative position that
                            	  7886:     ; reflects that distance: $28 or -$28.
                            	  7887:     ;
                            	  7888:     ; If walking in a decreasing direction (left or up), then
                            	  7889:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7890:     ;
                            	  7891:     ; If walking in an increasing direction (right or down), then
                            	  7892:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7893:     ;
02:00044BD8 02000007        	  7894:     andi.b #$07,D0
02:00044BDC 0C000002        	  7895:     cmpi.b  #$02,D0
02:00044BE0 6506            	  7896:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00044BE2 0C000005        	  7897:     cmpi.b  #$05,D0
02:00044BE6 6502            	  7898:     bcs  _anon_z05_157
