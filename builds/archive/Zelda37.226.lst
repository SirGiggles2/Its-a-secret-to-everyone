02:0003AE18 19802070        	  3316:     move.b  D0,($70,A4,D2.W)
                            	  3317:     ; If facing down, then use Y offset $28.
                            	  3318:     ; Else store Y offset -$28 in [00].
                            	  3319:     ;
02:0003AE1C 7628            	  3320:     moveq   #40,D3
02:0003AE1E 41EC0098        	  3321:     lea     ($0098,A4),A0
02:0003AE22 10302000        	  3322:     move.b  (A0,D2.W),D0
02:0003AE26 02000008        	  3323:     andi.b #$08,D0
02:0003AE2A 6704            	  3324:     beq  _anon_z04_44
02:0003AE2C 163C00D8        	  3325:     move.b  #$D8,D3
                            	  3326: _anon_z04_44:
02:0003AE30 1883            	  3327:     move.b  D3,($0000,A4)
                            	  3328:     ; Add Link's Y and the vertical offset.
                            	  3329:     ;
02:0003AE32 102C0084        	  3330:     move.b  ($0084,A4),D0
