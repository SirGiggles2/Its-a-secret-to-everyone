                            	 12992: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12993:     ; Draw the four clouds at diagonal corners.
                            	 12994:     ;
02:0003F47C 610000B6        	 12995:     jsr     Ganon_GetCurCloudLeft
02:0003F480 610000BE        	 12996:     jsr     Ganon_GetCurCloudTop
02:0003F484 61A0            	 12997:     jsr     Ganon_DrawCloud
02:0003F486 610000B2        	 12998:     jsr     Ganon_GetCurCloudRight
02:0003F48A 619A            	 12999:     jsr     Ganon_DrawCloud
02:0003F48C 610000A6        	 13000:     jsr     Ganon_GetCurCloudLeft
02:0003F490 610000B4        	 13001:     jsr     Ganon_GetCurCloudBottom
02:0003F494 6190            	 13002:     jsr     Ganon_DrawCloud
02:0003F496 610000A2        	 13003:     jsr     Ganon_GetCurCloudRight
02:0003F49A 618A            	 13004:     jsr     Ganon_DrawCloud
                            	 13005:     ; Draw the top and bottom clouds.
                            	 13006:     ;
02:0003F49C 10342070        	 13007:     move.b  ($70,A4,D2.W),D0
02:0003F4A0 1880            	 13008:     move.b  D0,($0000,A4)
02:0003F4A2 6100009C        	 13009:     jsr     Ganon_GetCurCloudTop
02:0003F4A6 6100FF7E        	 13010:     jsr     Ganon_DrawCloud
02:0003F4AA 6100009A        	 13011:     jsr     Ganon_GetCurCloudBottom
02:0003F4AE 6100FF76        	 13012:     jsr     Ganon_DrawCloud
                            	 13013:     ; Draw the left and right clouds.
                            	 13014:     ;
02:0003F4B2 61000080        	 13015:     jsr     Ganon_GetCurCloudLeft
02:0003F4B6 41EC0084        	 13016:     lea     ($0084,A4),A0
02:0003F4BA 10302000        	 13017:     move.b  (A0,D2.W),D0
02:0003F4BE 19400001        	 13018:     move.b  D0,($0001,A4)
02:0003F4C2 6100FF62        	 13019:     jsr     Ganon_DrawCloud
02:0003F4C6 6172            	 13020:     jsr     Ganon_GetCurCloudRight
02:0003F4C8 6100FF5C        	 13021:     jsr     Ganon_DrawCloud
                            	 13022:     ; Save the object index.
                            	 13023:     ;
02:0003F4CC 102C0340        	 13024:     move.b  ($0340,A4),D0
02:0003F4D0 1B00            	 13025:     move.b  D0,-(A5)  ; PHA
                            	 13026:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 13027:     ;
02:0003F4D2 7402            	 13028:     moveq   #2,D2
                            	 13029:     even
                            	 13030: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F4D4 19420340        	 13031:     move.b  D2,($0340,A4)
                            	 13032:     ; If object slot < 5 or = 7, then move every frame.
                            	 13033:     ; Else move 3 out of every 4 frames.
                            	 13034:     ;
                            	 13035:     ; This makes pieces spread out in somewhat of a circle,
                            	 13036:     ; by making the pieces at cardinal directions move at
                            	 13037:     ; full speed while the diagonal ones move a little slower.
                            	 13038:     ;
02:0003F4D8 0C020005        	 13039:     cmpi.b  #$05,D2
02:0003F4DC 6510            	 13040:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F4DE 0C020007        	 13041:     cmpi.b  #$07,D2
02:0003F4E2 670A            	 13042:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F4E4 102C0015        	 13043:     move.b  ($0015,A4),D0
02:0003F4E8 02000003        	 13044:     andi.b #$03,D0
02:0003F4EC 6704            	 13045:     beq  _anon_z04_164
                            	 13046:     even
                            	 13047: _L_z04_Ganon_DrawBurst_Move:
02:0003F4EE 6100DFA6        	 13048:     jsr     BlueWizzrobe_Move
                            	 13049: _anon_z04_164:
02:0003F4F2 4EB90004D1BE    	 13050:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 13051:     ; The frame counter will make the sprite flash.
                            	 13052:     ; The array has the horizontal and vertical flipping attributes.
                            	 13053:     ; Combine them into [03].
                            	 13054:     ;
02:0003F4F8 102C0015        	 13055:     move.b  ($0015,A4),D0
02:0003F4FC 02000003        	 13056:     andi.b #$03,D0
02:0003F500 41F90003F3D0    	 13057:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F506 12302000        	 13058:     move.b  (A0,D2.W),D1
02:0003F50A 8001            	 13059:     or.b  D1,D0
02:0003F50C 19400003        	 13060:     move.b  D0,($0003,A4)
02:0003F510 41F90003F3DA    	 13061:     lea     (GanonBurstTiles).l,A0
02:0003F516 10302000        	 13062:     move.b  (A0,D2.W),D0
02:0003F51A 4EB900031A22    	 13063:     jsr     Anim_WriteSprite
                            	 13064:     ; Bottom of the loop.
                            	 13065:     ; Increment object slot while <= 9.
                            	 13066:     ;
02:0003F520 5202            	 13067:     addq.b  #1,D2
02:0003F522 0C02000A        	 13068:     cmpi.b  #$0A,D2
02:0003F526 65AC            	 13069:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 13070:     ; Restore the object index.
                            	 13071:     ;
02:0003F528 101D            	 13072:     move.b  (A5)+,D0  ; PLA
02:0003F52A 19400340        	 13073:     move.b  D0,($0340,A4)
02:0003F52E 0A3C0001        	 13074:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F532 4E75            	 13075:     rts
                            	 13076: 
