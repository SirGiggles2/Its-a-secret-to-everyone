                            	   559: UpdateMenuStartOW:
                            	   560:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   561:     ; make it look completely empty, and no piece has been won.
                            	   562:     ;
02:00040388 7617            	   563:     moveq   #23,D3
                            	   564: _anon_z05_6:
02:0004038A 7400            	   565:     moveq   #0,D2
02:0004038C 41F900040340    	   566:     lea     (TriforceTransferBufOffsets).l,A0
02:00040392 14303000        	   567:     move.b  (A0,D3.W),D2
02:00040396 41F900040370    	   568:     lea     (TriforceTransferBufTiles).l,A0
02:0004039C 10303000        	   569:     move.b  (A0,D3.W),D0
02:000403A0 41F9000476B0    	   570:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403A6 11802000        	   571:     move.b  D0,(A0,D2.W)
02:000403AA 5303            	   572:     subq.b  #1,D3
02:000403AC 6ADC            	   573:     bpl  _anon_z05_6
                            	   574:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   575:     ;
02:000403AE 5203            	   576:     addq.b  #1,D3
                            	   577:     ; Outer loop.
                            	   578:     ; A level test bit in [06] will be used to see whether
                            	   579:     ; we have a triforce piece.
                            	   580:     ;
02:000403B0 7001            	   581:     moveq   #1,D0
02:000403B2 19400006        	   582:     move.b  D0,($0006,A4)
                            	   583:     even
                            	   584: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   585:     ; Inner loop.
                            	   586:     ; Each level bit will make 3 triforce tile slots be
                            	   587:     ; checked and replaced.
                            	   588:     ;
02:000403B6 7003            	   589:     moveq   #3,D0
02:000403B8 19400007        	   590:     move.b  D0,($0007,A4)
                            	   591:     even
                            	   592: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   593:     ; Get the offset into the submenu triforce transfer buffers of
                            	   594:     ; the current tile slot.
                            	   595:     ;
02:000403BC 7400            	   596:     moveq   #0,D2
02:000403BE 41F900040340    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:000403C4 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:000403C8 102C0006        	   605:     move.b  ($0006,A4),D0
02:000403CC 122C0671        	   606:     move.b  ($0671,A4),D1
02:000403D0 C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000403D2 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
                            	   615:     ; Else replace it with the one at the current triforce tile slot
                            	   616:     ; in the replacement list.
                            	   617:     ;
02:000403D4 41F9000476B0    	   618:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403DA 10302000        	   619:     move.b  (A0,D2.W),D0
02:000403DE 0C0000E5        	   620:     cmpi.b  #$E5,D0
02:000403E2 6712            	   621:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000403E4 0C0000E6        	   622:     cmpi.b  #$E6,D0
02:000403E8 670C            	   623:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000403EA 41F900040358    	   624:     lea     (TriforceTriforceBufReplacements).l,A0
02:000403F0 10303000        	   625:     move.b  (A0,D3.W),D0
02:000403F4 6004            	   626:     jmp     _anon_z05_7
                            	   627: 
                            	   628:     even
                            	   629: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:000403F6 103C00F5        	   630:     move.b  #$F5,D0
                            	   631: _anon_z05_7:
02:000403FA 41F9000476B0    	   632:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040400 11802000        	   633:     move.b  D0,(A0,D2.W)
                            	   634:     even
                            	   635: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   636:     ; Bottom of the inner loop.
                            	   637:     ;
                            	   638:     ; Increment the triforce tile slot.
                            	   639:     ; Decrement [07] and loop again, if it's not 0.
                            	   640:     ;
02:00040404 5203            	   641:     addq.b  #1,D3
02:00040406 532C0007        	   642:     subq.b  #1,($0007,A4)
02:0004040A 66B0            	   643:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   644:     ; Bottom of the outer loop.
                            	   645:     ;
                            	   646:     ; Shift the level test bit [06] left to test the next level.
                            	   647:     ; When it becomes 0, we're done.
                            	   648:     ;
02:0004040C 122C0006        	   649:     move.b  ($0006,A4),D1
02:00040410 E309            	   650:     lsl.b  #1,D1   ; ASL $06
02:00040412 19410006        	   651:     move.b  D1,($0006,A4)
02:00040416 669E            	   652:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:00040418 522C00E1        	   653:     addq.b  #1,($00E1,A4)
02:0004041C 4E75            	   654:     rts
                            	   655: 
                            	   656:     even
                            	   657: ScrollWorld:
02:0004041E 102C0015        	   658:     move.b  ($0015,A4),D0
                            	   659:     ; The purpose of this is to delay vertical scrolling.
                            	   660:     ; OW: once every two frames
                            	   661:     ; UW: once every four frames
                            	   662:     ; Horizontal scrolling happens every frame.
02:00040422 02000003        	   663:     andi.b #$03,D0
02:00040426 7600            	   664:     moveq   #0,D3
02:00040428 162C0010        	   665:     move.b  ($0010,A4),D3
02:0004042C 6604            	   666:     bne  _anon_z05_8
02:0004042E 02000001        	   667:     andi.b #$01,D0
                            	   668: _anon_z05_8:
02:00040432 122C00E6        	   669:     move.b  ($00E6,A4),D1
02:00040436 B001            	   670:     cmp.b   D1,D0
02:00040438 6704            	   671:     beq.s  __far_z_05_0007
02:0004043A 600000DE        	   672:     jmp  ScrollWorldH
                            	   673: __far_z_05_0007:
02:0004043E 7008            	   674:     moveq   #8,D0
02:00040440 122C0098        	   675:     move.b  ($0098,A4),D1
02:00040444 C200            	   676:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00040446 6602            	   677:     bne.s  __far_z_05_0008
02:00040448 606E            	   678:     jmp  ScrollWorldDownOrH
                            	   679: __far_z_05_0008:
                            	   680:     ; then scroll up.
                            	   681:     ; Scrolling up starts from the top of NT 2 at $2800.
