                            	  3355:     ;
02:0003AE56 102C0084        	  3356:     move.b  ($0084,A4),D0
02:0003AE5A 41EC0084        	  3357:     lea     ($0084,A4),A0
02:0003AE5E 11802000        	  3358:     move.b  D0,(A0,D2.W)
                            	  3359:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3360:     ; it's too close to the top edge of the screen. So, return.
                            	  3361:     ;
02:0003AE62 0C00005D        	  3362:     cmpi.b  #$5D,D0
02:0003AE66 65EC            	  3363:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3364:     ; If facing right, then use X offset $28.
                            	  3365:     ; Else store X offset -$28 in [00].
                            	  3366:     ;
02:0003AE68 7628            	  3367:     moveq   #40,D3
02:0003AE6A 41EC0098        	  3368:     lea     ($0098,A4),A0
02:0003AE6E 10302000        	  3369:     move.b  (A0,D2.W),D0
02:0003AE72 02000002        	  3370:     andi.b #$02,D0
02:0003AE76 6704            	  3371:     beq  _anon_z04_45
02:0003AE78 163C00D8        	  3372:     move.b  #$D8,D3
                            	  3373: _anon_z04_45:
02:0003AE7C 1883            	  3374:     move.b  D3,($0000,A4)
                            	  3375:     ; [01] holds Link's X coordinate.
                            	  3376:     ;
02:0003AE7E 102C0070        	  3377:     move.b  ($0070,A4),D0
02:0003AE82 19400001        	  3378:     move.b  D0,($0001,A4)
                            	  3379:     ; Add Link's X and the horizontal offset.
                            	  3380:     ;
02:0003AE86 023C00EE        	  3381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE8A 1214            	  3382:     move.b  ($0000,A4),D1
02:0003AE8C D101            	  3383:     addx.b  D1,D0   ; ADC $00
                            	  3384:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3385:     ;
02:0003AE8E 020000F8        	  3386:     andi.b #$F8,D0
                            	  3387:     ; Assign that result to the leever's X coordinate and [02].
                            	  3388:     ;
02:0003AE92 19802070        	  3389:     move.b  D0,($70,A4,D2.W)
02:0003AE96 19400002        	  3390:     move.b  D0,($0002,A4)
                            	  3391:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
