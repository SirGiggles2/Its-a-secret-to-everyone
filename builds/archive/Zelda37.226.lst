                            	  7902:     even
                            	  7903: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  7904:     ; Facing horizontally. Flip the direction.
                            	  7905:     ; Move two pixels, and go draw.
                            	  7906:     ;
02:0003CEDC 0A000003        	  7907:     eori.b #$03,D0
02:0003CEE0 41EC0098        	  7908:     lea     ($0098,A4),A0
02:0003CEE4 11802000        	  7909:     move.b  D0,(A0,D2.W)
