                            	  6326: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6327:     ; Store the weapon's frame (horizontal or vertical)
                            	  6328:     ; for the direction chosen above in [0C].
                            	  6329:     ;
02:0004CC46 4EB900030BA4    	  6330:     jsr     GetOppositeDir
02:0004CC4C 41F90004C680    	  6331:     lea     (RDirectionToWeaponFrame).l,A0
02:0004CC52 10303000        	  6332:     move.b  (A0,D3.W),D0
02:0004CC56 1940000C        	  6333:     move.b  D0,($000C,A4)
                            	  6334:     ; Calculate sprite attributes.
                            	  6335:     ;
                            	  6336:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6337:     ;   base attribute OR 1
                            	  6338:     ; So, it uses palette row 5.
                            	  6339:     ;
02:0004CC5A 41F90004C684    	  6340:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004CC60 10303000        	  6341:     move.b  (A0,D3.W),D0
02:0004CC64 0C02000D        	  6342:     cmpi.b  #$0D,D2
02:0004CC68 6706            	  6343:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004CC6A 00000001        	  6344:     ori.b #$01,D0
02:0004CC6E 601C            	  6345:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6346: 
                            	  6347:     even
                            	  6348: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6349:     ; The weapon is the sword.
                            	  6350:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6351:     ;
02:0004CC70 023C00EE        	  6352:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CC74 122C0657        	  6353:     move.b  ($0657,A4),D1
02:0004CC78 D101            	  6354:     addx.b  D1,D0   ; ADC Items
02:0004CC7A 003C0011        	  6355:     ori     #$11,CCR  ; SEC: set C+X
02:0004CC7E 123C0001        	  6356:     move.b  #$01,D1
02:0004CC82 0A3C0010        	  6357:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CC86 9101            	  6358:     subx.b  D1,D0   ; SBC #$01
02:0004CC88 0A3C0010        	  6359:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6360:     even
                            	  6361: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6362:     ; Set sprite attributes to the calculated value above.
                            	  6363:     ;
02:0004CC8C 4EB900031A18    	  6364:     jsr     Anim_SetSpriteDescriptorAttributes
