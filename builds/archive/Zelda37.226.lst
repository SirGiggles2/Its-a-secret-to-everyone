02:0004D73E 41F90004D232    	  7736:     lea     (ObjectTypeToAttributes).l,A0
02:0004D744 10303000        	  7737:     move.b  (A0,D3.W),D0
02:0004D748 41EC04BF        	  7738:     lea     ($04BF,A4),A0
02:0004D74C 11802000        	  7739:     move.b  D0,(A0,D2.W)
02:0004D750 1003            	  7740:     move.b  D3,D0
02:0004D752 1880            	  7741:     move.b  D0,($0000,A4)
                            	  7742:     ; Hit points are packed two values to a byte.
                            	  7743:     ; Divide the object type in half in order to index
                            	  7744:     ; into the hit points table.
