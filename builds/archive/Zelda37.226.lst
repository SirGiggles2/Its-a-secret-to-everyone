                            	  8480:     ; decrement the distance remaining, and move.
                            	  8481:     ;
02:0003D362 41EC0394        	  8482:     lea     ($0394,A4),A0
02:0003D366 10302000        	  8483:     move.b  (A0,D2.W),D0
