                            	  4534: ; Params:
                            	  4535: ; Y: middle speed index (4)
                            	  4536: ; [03]: horizontal distance
                            	  4537: ; [04]: vertical distance
                            	  4538: ; [0A]: vertical direction
                            	  4539: ; [0B]: horizontal direction
                            	  4540: ;
                            	  4541: ; Returns:
                            	  4542: ; Y: speed index (0 to 8) for the angle
                            	  4543: ;
                            	  4544: ;
                            	  4545: ; TODO: call it speed index or angle?
                            	  4546: ; Store the middle speed index in [00]. It will be changed to the
                            	  4547: ; right speed index to use incrementally.
                            	  4548: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4549: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4550: ;
                            	  4551:     even
                            	  4552: _CalcDiagonalSpeedIndex:
02:00030C4A 1883            	  4553:     move.b  D3,($0000,A4)
                            	  4554:     ; Assuming horizontal distance >= vertical distance, the
                            	  4555:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4556:     ;
02:00030C4C 103C00FF        	  4557:     move.b  #$FF,D0
02:00030C50 19400001        	  4558:     move.b  D0,($0001,A4)
                            	  4559:     ; TODO:
                            	  4560:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4561:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4562:     ;
                            	  4563:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4564:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4565:     ; of the farther distance faster.
                            	  4566:     ;
02:00030C54 102C0003        	  4567:     move.b  ($0003,A4),D0
02:00030C58 122C0004        	  4568:     move.b  ($0004,A4),D1
02:00030C5C B001            	  4569:     cmp.b   D1,D0
02:00030C5E 6416            	  4570:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
