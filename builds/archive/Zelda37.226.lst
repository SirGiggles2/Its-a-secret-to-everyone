02:0003AB4A 16342028        	  2953:     move.b  ($28,A4,D2.W),D3
02:0003AB4E 0C030021        	  2954:     cmpi.b  #$21,D3
02:0003AB52 6510            	  2955:     bcs  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2956:     ; Else cycle the animation counter, draw, and check collisions.
                            	  2957:     ;
