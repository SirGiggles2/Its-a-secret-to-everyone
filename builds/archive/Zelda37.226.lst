02:0003A31C D101            	  1713:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A31E 020000F0        	  1714:     andi.b #$F0,D0
02:0003A322 0000000D        	  1715:     ori.b #$0D,D0
02:0003A326 41EC0084        	  1716:     lea     ($0084,A4),A0
