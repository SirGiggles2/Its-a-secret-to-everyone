02:0003A73C 0C000001        	  2338:     cmpi.b  #$01,D0
02:0003A740 6720            	  2339:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A742 0C000009        	  2340:     cmpi.b  #$09,D0
02:0003A746 671A            	  2341:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A748 0C00000A        	  2342:     cmpi.b  #$0A,D0
02:0003A74C 6714            	  2343:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A74E 41EC0451        	  2344:     lea     ($0451,A4),A0
02:0003A752 10302000        	  2345:     move.b  (A0,D2.W),D0
