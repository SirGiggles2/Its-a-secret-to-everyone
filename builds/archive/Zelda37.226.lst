02:00044696 10302000        	  7551:     move.b  (A0,D2.W),D0
02:0004469A 19400001        	  7552:     move.b  D0,($0001,A4)
02:0004469E 101D            	  7553:     move.b  (A5)+,D0  ; PLA
02:000446A0 1B00            	  7554:     move.b  D0,-(A5)  ; PHA
02:000446A2 7400            	  7555:     moveq   #0,D2
02:000446A4 1400            	  7556:     move.b  D0,D2
                            	  7557:     ; Align the object's Y coordinate with 16 pixels.
                            	  7558:     ;
02:000446A6 41EC0084        	  7559:     lea     ($0084,A4),A0
02:000446AA 10302000        	  7560:     move.b  (A0,D2.W),D0
02:000446AE 020000F0        	  7561:     andi.b #$F0,D0
                            	  7562:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7563:     ; the height of each row.
                            	  7564:     ;
02:000446B2 003C0011        	  7565:     ori     #$11,CCR  ; SEC: set C+X
02:000446B6 123C0040        	  7566:     move.b  #$40,D1
02:000446BA 0A3C0010        	  7567:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000446BE 9101            	  7568:     subx.b  D1,D0   ; SBC #$40
02:000446C0 0A3C0010        	  7569:     eori    #$10,CCR  ; restore X = 6502 C
02:000446C4 E208            	  7570:     lsr.b  #1,D0   ; LSR A
02:000446C6 E208            	  7571:     lsr.b  #1,D0   ; LSR A
02:000446C8 E208            	  7572:     lsr.b  #1,D0   ; LSR A
                            	  7573:     ; Add this row offset to the column address.
                            	  7574:     ;
02:000446CA 4EB900030FFA    	  7575:     jsr     AddToInt16At0
                            	  7576:     ; Assume that we'll write a type 1 square with primary square
                            	  7577:     ; taken from [05]. If so, the square index doesn't matter
                            	  7578:     ; as long as >= $10. See WriteSquareOW.
                            	  7579:     ;
02:000446D0 7600            	  7580:     moveq   #0,D3
02:000446D2 7410            	  7581:     moveq   #16,D2
02:000446D4 102C0005        	  7582:     move.b  ($0005,A4),D0
                            	  7583:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7584:     ; So, we have to look up the square index corresponding
                            	  7585:     ; to primary square/tile in [05].
                            	  7586:     ;
                            	  7587:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7588:     ; then the X register will have the square index value.
                            	  7589:     ;
02:000446D8 0C000027        	  7590:     cmpi.b  #$27,D0
02:000446DC 6506            	  7591:     bcs  _anon_z05_148
02:000446DE 0C0000F3        	  7592:     cmpi.b  #$F3,D0
02:000446E2 6514            	  7593:     bcs  _L_z05_ChangePlayMapSquareOW_Write
