02:00031CC6 12302000        	  6713:     move.b  (A0,D2.W),D1
02:00031CCA 8001            	  6714:     or.b  D1,D0
02:00031CCC 0200000C        	  6715:     andi.b #$0C,D0
02:00031CD0 0C00000C        	  6716:     cmpi.b  #$0C,D0
02:00031CD4 671A            	  6717:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031CD6 102C0098        	  6718:     move.b  ($0098,A4),D0
02:00031CDA 41EC0098        	  6719:     lea     ($0098,A4),A0
02:00031CDE 12302000        	  6720:     move.b  (A0,D2.W),D1
02:00031CE2 8001            	  6721:     or.b  D1,D0
02:00031CE4 02000003        	  6722:     andi.b #$03,D0
02:00031CE8 0C000003        	  6723:     cmpi.b  #$03,D0
02:00031CEC 6702            	  6724:     beq.s  __far_z_01_0069
02:00031CEE 602A            	  6725:     jmp  HarmLink
                            	  6726: __far_z_01_0069:
                            	  6727:     even
                            	  6728: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6729:     ; Link and the shot are facing opposite directions.
                            	  6730:     ; Link can parry certain weapons/shots.
                            	  6731:     ;
                            	  6732:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6733:     ; no harmful collision; but it still counts as a shot collision.
                            	  6734:     ; So, go treat this as a parry.
                            	  6735:     ;
02:00031CF0 41EC034F        	  6736:     lea     ($034F,A4),A0
02:00031CF4 10302000        	  6737:     move.b  (A0,D2.W),D0
02:00031CF8 0C000055        	  6738:     cmpi.b  #$55,D0
02:00031CFC 650E            	  6739:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031CFE 0C00005B        	  6740:     cmpi.b  #$5B,D0
02:00031D02 6408            	  6741:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6742:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6743:     ; So, go harm Link.
                            	  6744:     ;
02:00031D04 102C0676        	  6745:     move.b  ($0676,A4),D0
02:00031D08 6602            	  6746:     bne.s  __far_z_01_0070
