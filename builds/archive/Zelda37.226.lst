                            	 13566:     ;
02:0003F8DC 700F            	 13567:     moveq   #15,D0
02:0003F8DE 7600            	 13568:     moveq   #0,D3
02:0003F8E0 162C0051        	 13569:     move.b  ($0051,A4),D3
