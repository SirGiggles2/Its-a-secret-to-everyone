                            	  3720:     ; Else make the frame image 1 for the "down" frame.
                            	  3721:     ; Note that this is the frame image to use, even if there's no
                            	  3722:     ; down component in the direction.
                            	  3723:     ;
02:0003B10E 522C000D        	  3724:     addq.b  #1,($000D,A4)
                            	  3725:     ; If right is a component of the direction, then go set horizontal
                            	  3726:     ; flipping. Else leave horizontal flipping = 0.
                            	  3727:     ;
02:0003B112 41EC0098        	  3728:     lea     ($0098,A4),A0
02:0003B116 10302000        	  3729:     move.b  (A0,D2.W),D0
02:0003B11A 02000001        	  3730:     andi.b #$01,D0
02:0003B11E 6714            	  3731:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B120 660E            	  3732:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3733:     even
                            	  3734: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3735:     ; Set horizontal flipping if right is a direction component.
                            	  3736:     ; This essentially the same test as above, but for when we jump
                            	  3737:     ; from the "up" test.
                            	  3738:     ;
02:0003B122 41EC0098        	  3739:     lea     ($0098,A4),A0
02:0003B126 10302000        	  3740:     move.b  (A0,D2.W),D0
02:0003B12A 02000002        	  3741:     andi.b #$02,D0
02:0003B12E 6704            	  3742:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3743:     even
