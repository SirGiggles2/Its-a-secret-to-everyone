02:0003A944 8001            	  2677:     or.b  D1,D0
02:0003A946 66F0            	  2678:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2679:     ; If state <> 0, go update the jump.
