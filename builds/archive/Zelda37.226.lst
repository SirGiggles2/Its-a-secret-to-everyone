02:00030D52 0A000001        	  4702:     eori.b #$01,D0
02:00030D56 7600            	  4703:     moveq   #0,D3
02:00030D58 1600            	  4704:     move.b  D0,D3
02:00030D5A 41EC00AC        	  4705:     lea     ($00AC,A4),A0
02:00030D5E 10303000        	  4706:     move.b  (A0,D3.W),D0
