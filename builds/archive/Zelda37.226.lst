02:0004C5A0 123C0001        	  5387:     move.b  #$01,D1
02:0004C5A4 D101            	  5388:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C5A6 19803000        	  5389:     move.b  D0,($00,A4,D3.W)
                            	  5390:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5391:     ;
