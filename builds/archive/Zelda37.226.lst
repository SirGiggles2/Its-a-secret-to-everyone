                            	  1901: UpdateStatues:
                            	  1902:     ; If person fireballs are enabled (from the two fires), then
                            	  1903:     ; go make fireballs with pattern 2.
                            	  1904:     ;
02:0003A45E 7602            	  1905:     moveq   #2,D3
02:0003A460 102C04CC        	  1906:     move.b  ($04CC,A4),D0
02:0003A464 6620            	  1907:     bne  _L_z04_UpdateStatues_Shoot
                            	  1908:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1909:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1910:     ; - layout $23: pattern 1: 2 statues
                            	  1911:     ; - layout $24: pattern 0: 4 statues
                            	  1912:     ;
02:0003A466 4EB90004B018    	  1913:     jsr     GetUniqueRoomId
02:0003A46C 7601            	  1914:     moveq   #1,D3
                            	  1915: _anon_z04_30:
02:0003A46E 41F90003A440    	  1916:     lea     (StatueRoomLayouts).l,A0
02:0003A474 12303000        	  1917:     move.b  (A0,D3.W),D1
02:0003A478 B001            	  1918:     cmp.b   D1,D0
02:0003A47A 670A            	  1919:     beq  _L_z04_UpdateStatues_Shoot
02:0003A47C 5303            	  1920:     subq.b  #1,D3
02:0003A47E 6AEE            	  1921:     bpl  _anon_z04_30
02:0003A480 0A3C0001        	  1922:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A484 4E75            	  1923:     rts
                            	  1924: 
                            	  1925:     even
                            	  1926: _L_z04_UpdateStatues_Shoot:
                            	  1927:     ; Look for an empty monster slot.
                            	  1928:     ; If none is found, return.
                            	  1929:     ;
                            	  1930:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1931:     ; object. This routine takes a shooter object, and instantiates
                            	  1932:     ; a fireball object at the shooter's location.
                            	  1933:     ;
                            	  1934:     ; The object slot we set up here will behave as the shooter.
                            	  1935:     ; For each fireball index, this object slot will have its coordinates
                            	  1936:     ; changed.
                            	  1937:     ;
                            	  1938:     ; Note that this means that:
                            	  1939:     ; 1. The first fireball made will be its own shooter.
                            	  1940:     ;    Practically, there's nothing special about this.
                            	  1941:     ; 2. If there is more than one fireball made in a frame,
                            	  1942:     ;    then two of them will come from the same statue.
                            	  1943:     ;
                            	  1944:     ;
                            	  1945:     ; Save the fireball pattern.
02:0003A486 1003            	  1946:     move.b  D3,D0
02:0003A488 1B00            	  1947:     move.b  D0,-(A5)  ; PHA
02:0003A48A 4EB90004D9AE    	  1948:     jsr     FindEmptyMonsterSlot
02:0003A490 0C000001        	  1949:     cmpi.b  #$01,D0
02:0003A494 101D            	  1950:     move.b  (A5)+,D0  ; PLA
02:0003A496 6400010A        	  1951:     bcc  _L_z04_UpdateStatues_Exit
                            	  1952:     ; If we found a slot, but it < 6, return.
                            	  1953:     ;
02:0003A49A 0C030006        	  1954:     cmpi.b  #$06,D3
02:0003A49E 65000102        	  1955:     bcs  _L_z04_UpdateStatues_Exit
                            	  1956:     ; Store the object slot in [0A].
                            	  1957:     ; Store fireball pattern in [0B].
                            	  1958:     ;
02:0003A4A2 1943000A        	  1959:     move.b  D3,($000A,A4)
02:0003A4A6 1940000B        	  1960:     move.b  D0,($000B,A4)
                            	  1961:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1962:     ;
02:0003A4AA 7600            	  1963:     moveq   #0,D3
02:0003A4AC 1600            	  1964:     move.b  D0,D3
02:0003A4AE 7400            	  1965:     moveq   #0,D2
02:0003A4B0 41F90003A442    	  1966:     lea     (StatueFireballCounts).l,A0
02:0003A4B6 14303000        	  1967:     move.b  (A0,D3.W),D2
                            	  1968:     even
                            	  1969: _L_z04_UpdateStatues_LoopFireball:
                            	  1970:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1971:     ;
                            	  1972:     ; Decrement the fireball timer at this index.
                            	  1973:     ;
02:0003A4BA 7600            	  1974:     moveq   #0,D3
02:0003A4BC 41EC04E8        	  1975:     lea     ($04E8,A4),A0
02:0003A4C0 16302000        	  1976:     move.b  (A0,D2.W),D3
02:0003A4C4 5303            	  1977:     subq.b  #1,D3
02:0003A4C6 1003            	  1978:     move.b  D3,D0
02:0003A4C8 41EC04E8        	  1979:     lea     ($04E8,A4),A0
02:0003A4CC 11802000        	  1980:     move.b  D0,(A0,D2.W)
                            	  1981:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1982:     ; to make a fireball. Go loop again.
                            	  1983:     ;
02:0003A4D0 5203            	  1984:     addq.b  #1,D3
02:0003A4D2 660000C8        	  1985:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1986:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1987:     ; This fireball index will wait another $100 frames.
                            	  1988:     ;
02:0003A4D6 10342018        	  1989:     move.b  ($18,A4,D2.W),D0
02:0003A4DA 0C0000F0        	  1990:     cmpi.b  #$F0,D0
02:0003A4DE 640000BC        	  1991:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1992:     ; Else choose one of four start times for the fireball based on
                            	  1993:     ; the random value.
                            	  1994:     ;
02:0003A4E2 02000003        	  1995:     andi.b #$03,D0
02:0003A4E6 7600            	  1996:     moveq   #0,D3
02:0003A4E8 1600            	  1997:     move.b  D0,D3
02:0003A4EA 41F90003A446    	  1998:     lea     (StatueFireballStartTimes).l,A0
02:0003A4F0 10303000        	  1999:     move.b  (A0,D3.W),D0
02:0003A4F4 41EC04E8        	  2000:     lea     ($04E8,A4),A0
02:0003A4F8 11802000        	  2001:     move.b  D0,(A0,D2.W)
                            	  2002:     ; The coordinate lists are divided into sets for each pattern.
                            	  2003:     ;
                            	  2004:     ; Look up the index of the base of the set for the pattern in use.
                            	  2005:     ; Add it to the fireball index in X register to get the index of
                            	  2006:     ; the coordinate we want within each coordinate list.
                            	  2007:     ;
                            	  2008:     ;
                            	  2009:     ; Pattern
02:0003A4FC 7600            	  2010:     moveq   #0,D3
02:0003A4FE 162C000B        	  2011:     move.b  ($000B,A4),D3
02:0003A502 1002            	  2012:     move.b  D2,D0
02:0003A504 023C00EE        	  2013:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A508 41F90003A44A    	  2014:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A50E 12303000        	  2015:     move.b  (A0,D3.W),D1
02:0003A512 D101            	  2016:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A514 7600            	  2017:     moveq   #0,D3
02:0003A516 1600            	  2018:     move.b  D0,D3
02:0003A518 1002            	  2019:     move.b  D2,D0
02:0003A51A 1B00            	  2020:     move.b  D0,-(A5)  ; PHA
                            	  2021:     ; Get Link's coordinates into [00] and [01].
                            	  2022:     ;
02:0003A51C 7400            	  2023:     moveq   #0,D2
02:0003A51E 4EB90004D1BE    	  2024:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2025:     ; Switch to the new fireball's object slot.
                            	  2026:     ;
02:0003A524 7400            	  2027:     moveq   #0,D2
02:0003A526 142C000A        	  2028:     move.b  ($000A,A4),D2
                            	  2029:     ; Look up and set the X coordinate for the fireball object.
                            	  2030:     ; Also store it in [02].
                            	  2031:     ;
02:0003A52A 41F90003A44E    	  2032:     lea     (StatueXs).l,A0
02:0003A530 10303000        	  2033:     move.b  (A0,D3.W),D0
02:0003A534 19400002        	  2034:     move.b  D0,($0002,A4)
02:0003A538 19802070        	  2035:     move.b  D0,($70,A4,D2.W)
                            	  2036:     ; Look up and set the Y coordinate for the fireball object.
                            	  2037:     ; Also store it in [03].
                            	  2038:     ;
02:0003A53C 41F90003A456    	  2039:     lea     (StatueYs).l,A0
02:0003A542 10303000        	  2040:     move.b  (A0,D3.W),D0
02:0003A546 19400003        	  2041:     move.b  D0,($0003,A4)
02:0003A54A 41EC0084        	  2042:     lea     ($0084,A4),A0
02:0003A54E 11802000        	  2043:     move.b  D0,(A0,D2.W)
                            	  2044:     ; Set mask value 3 in [04].
                            	  2045:     ;
02:0003A552 7003            	  2046:     moveq   #3,D0
02:0003A554 19400004        	  2047:     move.b  D0,($0004,A4)
                            	  2048:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2049:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2050:     ;
02:0003A558 7601            	  2051:     moveq   #1,D3
                            	  2052:     even
                            	  2053: _L_z04_UpdateStatues_LoopAxis:
