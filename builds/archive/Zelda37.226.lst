02:0004BF80 7001            	  4498:     moveq   #1,D0
02:0004BF82 61001B96        	  4499:     jsr     SwitchBank
02:0004BF86 4EB9000300E0    	  4500:     jsr     CheckPassiveTileObjects
                            	  4501:     even
                            	  4502: _L_z07_PlayerUnwalkable_StopMoving:
