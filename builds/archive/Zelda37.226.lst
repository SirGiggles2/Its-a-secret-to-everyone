02:0004CC02 19802070        	  6299:     move.b  D0,($70,A4,D2.W)
02:0004CC06 1880            	  6300:     move.b  D0,($0000,A4)
                            	  6301:     ; Set object's Y to player's Y + offset for state and direction.
