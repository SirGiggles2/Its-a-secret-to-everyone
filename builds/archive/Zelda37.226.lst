02:0004CC30 0200000F        	  6317:     andi.b #$0F,D0
02:0004CC34 7600            	  6318:     moveq   #0,D3
02:0004CC36 1600            	  6319:     move.b  D0,D3
02:0004CC38 7008            	  6320:     moveq   #8,D0
