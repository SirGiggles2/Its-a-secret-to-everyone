02:0003C550 19410002        	  6544:     move.b  D1,($0002,A4)
02:0003C554 122C0002        	  6545:     move.b  ($0002,A4),D1
02:0003C558 C200            	  6546:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C55A 6716            	  6547:     beq  _L_z04_Digdogger_Move_Up
02:0003C55C 41EC0084        	  6548:     lea     ($0084,A4),A0
02:0003C560 10302000        	  6549:     move.b  (A0,D2.W),D0
02:0003C564 122C0003        	  6550:     move.b  ($0003,A4),D1
02:0003C568 D101            	  6551:     addx.b  D1,D0   ; ADC $03
02:0003C56A 41EC0084        	  6552:     lea     ($0084,A4),A0
