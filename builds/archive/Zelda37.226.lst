02:00039EB2 10342070        	  1111:     move.b  ($70,A4,D2.W),D0
02:00039EB6 023C00EE        	  1112:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039EBA 41F900039DAC    	  1113:     lea     (ShotBounceWidths).l,A0
02:00039EC0 12303000        	  1114:     move.b  (A0,D3.W),D1
