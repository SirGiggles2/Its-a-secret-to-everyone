                            	  4256:     even
                            	  4257: _L_z07_MoveObject_ApplyQSpeedToPosition:
02:0004BE48 102C000F        	  4258:     move.b  ($000F,A4),D0
02:0004BE4C E208            	  4259:     lsr.b  #1,D0   ; LSR A
02:0004BE4E 654C            	  4260:     bcs  _L_z07_MoveObject_Right
02:0004BE50 E208            	  4261:     lsr.b  #1,D0   ; LSR A
02:0004BE52 655E            	  4262:     bcs  _L_z07_MoveObject_Left
02:0004BE54 E208            	  4263:     lsr.b  #1,D0   ; LSR A
02:0004BE56 6526            	  4264:     bcs  _L_z07_MoveObject_Down
