02:0003172E 41EC034F        	  5950:     lea     ($034F,A4),A0
02:00031732 16302000        	  5951:     move.b  (A0,D2.W),D3
                            	  5952: ; Params:
                            	  5953: ; A: frame
                            	  5954: ; X: object index/cycle sprite index
                            	  5955: ; Y: object type
                            	  5956: ; [00]: object X
                            	  5957: ; [01]: object Y
                            	  5958: ; [0C]: mirrored
                            	  5959: ; [0F]: flip horizontally
                            	  5960: ;
                            	  5961: ; Note:
                            	  5962: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5963: ;
                            	  5964: ; The animation index of most objects is (object type + 1),
                            	  5965: ; to make up for the fact that Link uses two animation indexes.
                            	  5966: ;
                            	  5967:     even
                            	  5968: DrawObjectWithType:
02:00031736 5203            	  5969:     addq.b  #1,D3
                            	  5970: ; Params:
                            	  5971: ; A: frame
                            	  5972: ; X: object index/cycle sprite index
                            	  5973: ; Y: animation index
                            	  5974: ; [00]: object X
                            	  5975: ; [01]: object Y
                            	  5976: ; [0C]: mirrored
                            	  5977: ; [0F]: flip horizontally
                            	  5978: ;
                            	  5979: ; Note:
                            	  5980: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5981: ; But Link uses [0F] for flipping without checking [0C].
                            	  5982: ;
                            	  5983: ;
                            	  5984: ; [0D] holds frame.
                            	  5985:     even
