02:00041AF6 6710            	  3169:     beq  _anon_z05_76
02:00041AF8 1003            	  3170:     move.b  D3,D0
02:00041AFA 023C00EE        	  3171:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041AFE 123C0004        	  3172:     move.b  #$04,D1
02:00041B02 D101            	  3173:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041B04 7600            	  3174:     moveq   #0,D3
02:00041B06 1600            	  3175:     move.b  D0,D3
                            	  3176: _anon_z05_76:
                            	  3177:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3178:     ;
02:00041B08 7000            	  3179:     moveq   #0,D0
                            	  3180: ; Params:
                            	  3181: ; A: mask of buttons to block
                            	  3182: ; Y: offset into BorderBounds
                            	  3183: ; [00]: direction
                            	  3184: ; [02]: coordinate
                            	  3185: ;
                            	  3186: ; Returns:
                            	  3187: ; [01]: button mask that was used
                            	  3188: ;       (set to $FF if boundary not crossed)
                            	  3189: ;
                            	  3190:     even
