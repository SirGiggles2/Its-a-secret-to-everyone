02:00043820 665A            	  5819:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5820:     even
                            	  5821: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5822:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5823:     ; the mask of opened doors, because this is not a true door.
                            	  5824:     ;
02:00043822 1B00            	  5825:     move.b  D0,-(A5)  ; PHA
02:00043824 102C0002        	  5826:     move.b  ($0002,A4),D0
02:00043828 4600            	  5827:     eori.b #$FF,D0
02:0004382A 122C00EE        	  5828:     move.b  ($00EE,A4),D1
02:0004382E C001            	  5829:     and.b  D1,D0
02:00043830 194000EE        	  5830:     move.b  D0,($00EE,A4)
02:00043834 101D            	  5831:     move.b  (A5)+,D0  ; PLA
                            	  5832:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5833:     ;
02:00043836 0C000001        	  5834:     cmpi.b  #$01,D0
