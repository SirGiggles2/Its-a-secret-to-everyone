                            	  5895:     ; If timer has not expired, then
                            	  5896:     ; go see if it's time to propagate direction changes down the chain.
                            	  5897:     ;
02:0003C0D8 10342028        	  5898:     move.b  ($28,A4,D2.W),D0
02:0003C0DC 6702            	  5899:     beq.s  __far_z_04_0045
