02:0003CFEA 41EC042C        	  8026:     lea     ($042C,A4),A0
02:0003CFEE 12302000        	  8027:     move.b  (A0,D2.W),D1
02:0003CFF2 B001            	  8028:     cmp.b   D1,D0
