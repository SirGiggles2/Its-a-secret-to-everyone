02:00030D1E 67F4            	  4671:     beq  _anon_z01_52
                            	  4672:     ; Look in slot $10. If it's empty or there's a fire
                            	  4673:     ; (state = 0, or major state <> $10), then
                            	  4674:     ; go activate a bomb.
