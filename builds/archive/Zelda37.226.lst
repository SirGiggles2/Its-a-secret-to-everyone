02:0004BE62 10302000        	  4269:     move.b  (A0,D2.W),D0
02:0004BE66 123C0000        	  4270:     move.b  #$00,D1
02:0004BE6A 0A3C0010        	  4271:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BE6E 9101            	  4272:     subx.b  D1,D0   ; SBC #$00
02:0004BE70 0A3C0010        	  4273:     eori    #$10,CCR  ; restore X = 6502 C
02:0004BE74 41EC0084        	  4274:     lea     ($0084,A4),A0
02:0004BE78 11802000        	  4275:     move.b  D0,(A0,D2.W)
