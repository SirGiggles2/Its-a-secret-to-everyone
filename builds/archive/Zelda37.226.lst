02:0004BF8E 194000F8        	  4508:     move.b  D0,($00F8,A4)
02:0004BF92 102C0010        	  4509:     move.b  ($0010,A4),D0
02:0004BF96 6602            	  4510:     bne.s  __far_z_07_0060
02:0004BF98 6008            	  4511:     jmp  GoWalkableDir
                            	  4512: __far_z_07_0060:
                            	  4513:     even
                            	  4514: L1F148_Exit:
02:0004BF9A 4E75            	  4515:     rts
                            	  4516: 
                            	  4517: ; Returns:
                            	  4518: ; A: 0
                            	  4519: ; [0F]: 0
                            	  4520: ;
                            	  4521:     even
