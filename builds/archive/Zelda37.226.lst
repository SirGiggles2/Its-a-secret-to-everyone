                            	  7527: ChangePlayMapSquareOW:
02:00044670 1002            	  7528:     move.b  D2,D0
02:00044672 1B00            	  7529:     move.b  D0,-(A5)  ; PHA
                            	  7530:     ; We're dealing with squares.
                            	  7531:     ; So, align the object's X coordinate with 16 pixels.
                            	  7532:     ;
02:00044674 10342070        	  7533:     move.b  ($70,A4,D2.W),D0
02:00044678 020000F0        	  7534:     andi.b #$F0,D0
                            	  7535:     ; Divide it by 4 to get the offset of the address of the column
                            	  7536:     ; in play area map.
                            	  7537:     ;
                            	  7538:     ; The calculation is: address offset = (X / 8) * 2
                            	  7539:     ; 8 for the width of the column; 2 for the width of the address
                            	  7540:     ;
02:0004467C E208            	  7541:     lsr.b  #1,D0   ; LSR A
02:0004467E E208            	  7542:     lsr.b  #1,D0   ; LSR A
02:00044680 7400            	  7543:     moveq   #0,D2
02:00044682 1400            	  7544:     move.b  D0,D2
                            	  7545:     ; Store the address of the column in [00:01].
                            	  7546:     ;
02:00044684 41F90004A8B6    	  7547:     lea     (PlayAreaColumnAddrs).l,A0
02:0004468A 10302000        	  7548:     move.b  (A0,D2.W),D0
02:0004468E 1880            	  7549:     move.b  D0,($0000,A4)
