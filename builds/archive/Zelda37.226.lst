02:00030E52 11802000        	  4884:     move.b  D0,(A0,D2.W)
02:00030E56 6100FF34        	  4885:     jsr     PlaceWeaponForPlayerState
02:00030E5A 0A3C0001        	  4886:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00030E5E 4E75            	  4887:     rts
                            	  4888: 
