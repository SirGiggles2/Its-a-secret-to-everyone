                            	 11092: __far_z_04_0107:
                            	 11093:     ; The segment is not a head nor bottom. So, we can use a
                            	 11094:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11095:     ; that is drawn under Link and the heads.
                            	 11096:     ;
02:0003E6D0 4EB900031A1C    	 11097:     jsr     Anim_WriteLevelPaletteSprite
                            	 11098:     even
                            	 11099: Gleeok_CheckCollisions:
                            	 11100:     ; If this segment is not the head nor the bottom of the neck,
                            	 11101:     ; then loop again to process the next segment.
                            	 11102:     ;
                            	 11103:     ; This kind of segment is only drawn, and is not checked
                            	 11104:     ; for object collisions.
                            	 11105:     ;
02:0003E6D6 0C020005        	 11106:     cmpi.b  #$05,D2
02:0003E6DA 670A            	 11107:     beq  _anon_z04_141
02:0003E6DC 0C020001        	 11108:     cmpi.b  #$01,D2
02:0003E6E0 6704            	 11109:     beq  _anon_z04_141
02:0003E6E2 6000010C        	 11110:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11111: 
                            	 11112: _anon_z04_141:
02:0003E6E6 4EB900031AA2    	 11113:     jsr     CheckMonsterCollisions
                            	 11114:     ; If this segment was harmed, then set the writhing counter,
                            	 11115:     ; and the animation counter to its lower value.
                            	 11116:     ;
02:0003E6EC 41EC00C0        	 11117:     lea     ($00C0,A4),A0
02:0003E6F0 10302000        	 11118:     move.b  (A0,D2.W),D0
02:0003E6F4 670A            	 11119:     beq  _anon_z04_142
02:0003E6F6 7006            	 11120:     moveq   #6,D0
02:0003E6F8 194004E6        	 11121:     move.b  D0,($04E6,A4)
02:0003E6FC 19400510        	 11122:     move.b  D0,($0510,A4)
                            	 11123: _anon_z04_142:
02:0003E700 4EB90004BB42    	 11124:     jsr     ResetShoveInfo
                            	 11125:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11126:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11127:     ;
02:0003E706 0C020001        	 11128:     cmpi.b  #$01,D2
02:0003E70A 670000DE        	 11129:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E70E 6100B0E2        	 11130:     jsr     PlayBossHitCryIfNeeded
                            	 11131:     ; If this neck has not died, then go loop again.
                            	 11132:     ;
02:0003E712 41EC0405        	 11133:     lea     ($0405,A4),A0
02:0003E716 10302000        	 11134:     move.b  (A0,D2.W),D0
02:0003E71A 670000D4        	 11135:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11136:     ; This neck died. So, prepare to make a flying head.
                            	 11137:     ;
02:0003E71E 7060            	 11138:     moveq   #96,D0
02:0003E720 41EC0485        	 11139:     lea     ($0485,A4),A0
02:0003E724 11802000        	 11140:     move.b  D0,(A0,D2.W)
02:0003E728 1002            	 11141:     move.b  D2,D0
02:0003E72A 1B00            	 11142:     move.b  D0,-(A5)  ; PHA
                            	 11143:     ; If the segment is not a head, then skip making a flying head.
                            	 11144:     ;
                            	 11145:     ; TODO:
                            	 11146:     ; But how can we get here in this case, since earlier branches
                            	 11147:     ; would have been taken to skip all this for all other segments?
                            	 11148:     ;
02:0003E72C 0C020005        	 11149:     cmpi.b  #$05,D2
02:0003E730 663C            	 11150:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11151:     ; The flying head will go in slot (neck index + 7).
                            	 11152:     ; Switch the X register to it.
                            	 11153:     ;
02:0003E732 102C04D7        	 11154:     move.b  ($04D7,A4),D0
02:0003E736 023C00EE        	 11155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E73A 123C0007        	 11156:     move.b  #$07,D1
02:0003E73E D101            	 11157:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E740 7400            	 11158:     moveq   #0,D2
02:0003E742 1400            	 11159:     move.b  D0,D2
                            	 11160:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11161:     ;
02:0003E744 103C00FF        	 11162:     move.b  #$FF,D0
02:0003E748 41EC0492        	 11163:     lea     ($0492,A4),A0
02:0003E74C 11802000        	 11164:     move.b  D0,(A0,D2.W)
                            	 11165:     ; Copy the original head's coordinates to it.
                            	 11166:     ;
02:0003E750 102C0075        	 11167:     move.b  ($0075,A4),D0
02:0003E754 19802070        	 11168:     move.b  D0,($70,A4,D2.W)
02:0003E758 102C0089        	 11169:     move.b  ($0089,A4),D0
02:0003E75C 41EC0084        	 11170:     lea     ($0084,A4),A0
02:0003E760 11802000        	 11171:     move.b  D0,(A0,D2.W)
                            	 11172:     ; Set object type $46 (flying head).
                            	 11173:     ;
02:0003E764 7046            	 11174:     moveq   #70,D0
02:0003E766 41EC034F        	 11175:     lea     ($034F,A4),A0
02:0003E76A 11802000        	 11176:     move.b  D0,(A0,D2.W)
                            	 11177:     even
                            	 11178: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E76E 101D            	 11179:     move.b  (A5)+,D0  ; PLA
02:0003E770 7400            	 11180:     moveq   #0,D2
02:0003E772 1400            	 11181:     move.b  D0,D2
                            	 11182:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11183:     ;
02:0003E774 102C04D7        	 11184:     move.b  ($04D7,A4),D0
02:0003E778 E308            	 11185:     lsl.b  #1,D0   ; ASL A
02:0003E77A E308            	 11186:     lsl.b  #1,D0   ; ASL A
02:0003E77C E308            	 11187:     lsl.b  #1,D0   ; ASL A
02:0003E77E 7600            	 11188:     moveq   #0,D3
02:0003E780 1600            	 11189:     move.b  D0,D3
02:0003E782 103C00F8        	 11190:     move.b  #$F8,D0
02:0003E786 41EC0200        	 11191:     lea     ($0200,A4),A0
02:0003E78A 11803000        	 11192:     move.b  D0,(A0,D3.W)
02:0003E78E 41EC0220        	 11193:     lea     ($0220,A4),A0
02:0003E792 11803000        	 11194:     move.b  D0,(A0,D3.W)
                            	 11195:     ; Add the bit for this neck to the dead neck mask.
                            	 11196:     ; Copy it to [00].
                            	 11197:     ;
02:0003E796 7600            	 11198:     moveq   #0,D3
02:0003E798 162C04D7        	 11199:     move.b  ($04D7,A4),D3
02:0003E79C 41F90004AD4E    	 11200:     lea     (LevelMasks).l,A0
02:0003E7A2 10303000        	 11201:     move.b  (A0,D3.W),D0
02:0003E7A6 122C0511        	 11202:     move.b  ($0511,A4),D1
02:0003E7AA 8001            	 11203:     or.b  D1,D0
02:0003E7AC 19400511        	 11204:     move.b  D0,($0511,A4)
02:0003E7B0 1880            	 11205:     move.b  D0,($0000,A4)
                            	 11206:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11207:     ; Count them up, and store the amount in [00].
                            	 11208:     ;
02:0003E7B2 7000            	 11209:     moveq   #0,D0
02:0003E7B4 7604            	 11210:     moveq   #4,D3
                            	 11211: _anon_z04_143:
02:0003E7B6 1214            	 11212:     move.b  ($0000,A4),D1
02:0003E7B8 E209            	 11213:     lsr.b  #1,D1   ; LSR $00
02:0003E7BA 1881            	 11214:     move.b  D1,($0000,A4)
02:0003E7BC 123C0000        	 11215:     move.b  #$00,D1
02:0003E7C0 D101            	 11216:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E7C2 5303            	 11217:     subq.b  #1,D3
02:0003E7C4 66F0            	 11218:     bne  _anon_z04_143
02:0003E7C6 1880            	 11219:     move.b  D0,($0000,A4)
                            	 11220:     ; Compare the number of dead necks to the original number
                            	 11221:     ; (object type - $41).
                            	 11222:     ;
02:0003E7C8 102C0350        	 11223:     move.b  ($0350,A4),D0
02:0003E7CC 003C0011        	 11224:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7D0 123C0041        	 11225:     move.b  #$41,D1
02:0003E7D4 0A3C0010        	 11226:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7D8 9101            	 11227:     subx.b  D1,D0   ; SBC #$41
02:0003E7DA 0A3C0010        	 11228:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7DE 1214            	 11229:     move.b  ($0000,A4),D1
02:0003E7E0 B001            	 11230:     cmp.b   D1,D0
                            	 11231:     ; If they're equal, then go handle the whole boss dying.
                            	 11232:     ;
