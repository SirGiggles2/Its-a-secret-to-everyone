02:00031C6C 19400004        	  6662:     move.b  D0,($0004,A4)
02:00031C70 102C0084        	  6663:     move.b  ($0084,A4),D0
02:00031C74 023C00EE        	  6664:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031C78 123C0008        	  6665:     move.b  #$08,D1
