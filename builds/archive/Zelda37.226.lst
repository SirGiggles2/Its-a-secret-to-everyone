                            	  9912: UpdateGohma:
                            	  9913:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9914:     ;
02:0003DE16 41EC0451        	  9915:     lea     ($0451,A4),A0
02:0003DE1A 10302000        	  9916:     move.b  (A0,D2.W),D0
02:0003DE1E 662C            	  9917:     bne  _L_z04_UpdateGohma_Move
                            	  9918:     ; If Random:
                            	  9919:     ;   >= $B0: right
                            	  9920:     ;   >= $60: left
                            	  9921:     ;   Else:   down
                            	  9922:     ;
02:0003DE20 7001            	  9923:     moveq   #1,D0
02:0003DE22 7600            	  9924:     moveq   #0,D3
02:0003DE24 16342018        	  9925:     move.b  ($18,A4,D2.W),D3
02:0003DE28 0C0300B0        	  9926:     cmpi.b  #$B0,D3
02:0003DE2C 640A            	  9927:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE2E E308            	  9928:     lsl.b  #1,D0   ; ASL A
02:0003DE30 0C030060        	  9929:     cmpi.b  #$60,D3
02:0003DE34 6402            	  9930:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE36 E308            	  9931:     lsl.b  #1,D0   ; ASL A
                            	  9932:     even
                            	  9933: _L_z04_UpdateGohma_ChangeDir:
