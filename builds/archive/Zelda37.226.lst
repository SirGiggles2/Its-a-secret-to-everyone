                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:00040286 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:0004028A 02000010        	   446:     andi.b #$10,D0
02:0004028E 6606            	   447:     bne.s  __far_z_05_0003
02:00040290 4EF90002D116    	   448:     jmp  Exit
                            	   449: __far_z_05_0003:
02:00040296 102C0254        	   450:     move.b  ($0254,A4),D0
02:0004029A 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:0004029C 102C0258        	   452:     move.b  ($0258,A4),D0
02:000402A0 1B00            	   453:     move.b  D0,-(A5)  ; PHA
02:000402A2 4EB90004ABAA    	   454:     jsr     HideAllSprites
02:000402A8 101D            	   455:     move.b  (A5)+,D0  ; PLA
02:000402AA 19400258        	   456:     move.b  D0,($0258,A4)
02:000402AE 101D            	   457:     move.b  (A5)+,D0  ; PLA
02:000402B0 19400254        	   458:     move.b  D0,($0254,A4)
02:000402B4 522C00E1        	   459:     addq.b  #1,($00E1,A4)
02:000402B8 0A3C0001        	   460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000402BC 4E75            	   461:     rts
