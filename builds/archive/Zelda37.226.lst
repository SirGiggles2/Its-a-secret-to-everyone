                            	  5010: UpdateMode13WinGame_Sub3:
                            	  5011:     ; After scrolling 8 pixels, draw another tile row.
                            	  5012:     ;
02:00036640 102C050B        	  5013:     move.b  ($050B,A4),D0
02:00036644 0C000008        	  5014:     cmpi.b  #$08,D0
02:00036648 6B1A            	  5015:     bmi  _anon_z02_37
02:0003664A 102C050B        	  5016:     move.b  ($050B,A4),D0
02:0003664E 123C0008        	  5017:     move.b  #$08,D1
02:00036652 0A3C0010        	  5018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036656 9101            	  5019:     subx.b  D1,D0   ; SBC #$08
02:00036658 0A3C0010        	  5020:     eori    #$10,CCR  ; restore X = 6502 C
02:0003665C 1940050B        	  5021:     move.b  D0,($050B,A4)
02:00036660 61000282        	  5022:     jsr     DrawCredits
                            	  5023: _anon_z02_37:
                            	  5024:     ; Add $80 to the scroll speed fraction.
                            	  5025:     ;
02:00036664 102C0058        	  5026:     move.b  ($0058,A4),D0
02:00036668 023C00EE        	  5027:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003666C 123C0080        	  5028:     move.b  #$80,D1
02:00036670 D101            	  5029:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00036672 19400058        	  5030:     move.b  D0,($0058,A4)
                            	  5031:     ; Carry over to the tile offset and current V-scroll.
                            	  5032:     ;
02:00036676 6404            	  5033:     bcc  _anon_z02_38
02:00036678 522C050B        	  5034:     addq.b  #1,($050B,A4)
                            	  5035: _anon_z02_38:
02:0003667C 102C00FC        	  5036:     move.b  ($00FC,A4),D0
02:00036680 123C0000        	  5037:     move.b  #$00,D1
02:00036684 D101            	  5038:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00036686 194000FC        	  5039:     move.b  D0,($00FC,A4)
                            	  5040:     ; If we've reached the bottom of a nametable, then
                            	  5041:     ; roll over current V-scroll to 0, and increase number of
                            	  5042:     ; screens scrolled.
                            	  5043:     ;
02:0003668A 0C0000F0        	  5044:     cmpi.b  #$F0,D0
02:0003668E 7000            	  5045:     moveq   #0,D0
02:00036690 6508            	  5046:     bcs  _anon_z02_39
02:00036692 194000FC        	  5047:     move.b  D0,($00FC,A4)
02:00036696 522C00E2        	  5048:     addq.b  #1,($00E2,A4)
                            	  5049: _anon_z02_39:
                            	  5050:     ; Roll the carry from the comparison above into bit 0.
                            	  5051:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5052:     ;
