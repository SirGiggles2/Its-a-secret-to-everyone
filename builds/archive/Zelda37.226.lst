02:00041E96 102C0070        	  3735:     move.b  ($0070,A4),D0
02:00041E9A 12342070        	  3736:     move.b  ($70,A4,D2.W),D1
02:00041E9E B001            	  3737:     cmp.b   D1,D0
02:00041EA0 6600008A        	  3738:     bne  _L_z05_CheckLadder_StashLadder
02:00041EA4 102C0084        	  3739:     move.b  ($0084,A4),D0
02:00041EA8 023C00EE        	  3740:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041EAC 123C0003        	  3741:     move.b  #$03,D1
02:00041EB0 D101            	  3742:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041EB2 003C0011        	  3743:     ori     #$11,CCR  ; SEC: set C+X
02:00041EB6 41EC0084        	  3744:     lea     ($0084,A4),A0
02:00041EBA 12302000        	  3745:     move.b  (A0,D2.W),D1
02:00041EBE 0A3C0010        	  3746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EC2 9101            	  3747:     subx.b  D1,D0   ; SBC ObjY,X
02:00041EC4 0A3C0010        	  3748:     eori    #$10,CCR  ; restore X = 6502 C
02:00041EC8 6030            	  3749:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3750: 
                            	  3751: _anon_z05_85:
                            	  3752:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3753:     ; between the ladder and Link.
                            	  3754:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3755:     ;
02:00041ECA 102C0084        	  3756:     move.b  ($0084,A4),D0
02:00041ECE 023C00EE        	  3757:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041ED2 123C0003        	  3758:     move.b  #$03,D1
02:00041ED6 D101            	  3759:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041ED8 41EC0084        	  3760:     lea     ($0084,A4),A0
02:00041EDC 12302000        	  3761:     move.b  (A0,D2.W),D1
02:00041EE0 B001            	  3762:     cmp.b   D1,D0
02:00041EE2 6648            	  3763:     bne  _L_z05_CheckLadder_StashLadder
02:00041EE4 102C0070        	  3764:     move.b  ($0070,A4),D0
02:00041EE8 003C0011        	  3765:     ori     #$11,CCR  ; SEC: set C+X
02:00041EEC 12342070        	  3766:     move.b  ($70,A4,D2.W),D1
02:00041EF0 0A3C0010        	  3767:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EF4 9101            	  3768:     subx.b  D1,D0   ; SBC ObjX,X
02:00041EF6 0A3C0010        	  3769:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3770:     even
                            	  3771: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3772:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3773:     ; If > $10, go put the ladder away.
                            	  3774:     ;
02:00041EFA 4EB900030BA8    	  3775:     jsr     Abs
02:00041F00 1880            	  3776:     move.b  D0,($0000,A4)
02:00041F02 0C000010        	  3777:     cmpi.b  #$10,D0
02:00041F06 6532            	  3778:     bcs  _L_z05_CheckLadder_SetState2
02:00041F08 0C000010        	  3779:     cmpi.b  #$10,D0
02:00041F0C 661E            	  3780:     bne  _L_z05_CheckLadder_StashLadder
                            	  3781:     ; Distance = $10. If player's not facing in the same direction as
                            	  3782:     ; the ladder, go put away the ladder.
                            	  3783:     ;
02:00041F0E 102C0098        	  3784:     move.b  ($0098,A4),D0
02:00041F12 41EC0098        	  3785:     lea     ($0098,A4),A0
02:00041F16 12302000        	  3786:     move.b  (A0,D2.W),D1
02:00041F1A B001            	  3787:     cmp.b   D1,D0
02:00041F1C 660E            	  3788:     bne  _L_z05_CheckLadder_StashLadder
                            	  3789:     ; Distance = $10, and player's facing in the same direction.
                            	  3790:     ;
                            	  3791:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3792:     ; ladder and had not stepped onto it yet.
                            	  3793:     ; Go handle movement on it, but don't change state yet.
                            	  3794:     ;
                            	  3795:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3796:     ; off of the ladder. So the ladder should be put away. In this
                            	  3797:     ; case, fall thru.
                            	  3798:     ;
02:00041F1E 41EC00AC        	  3799:     lea     ($00AC,A4),A0
02:00041F22 10302000        	  3800:     move.b  (A0,D2.W),D0
02:00041F26 0C000001        	  3801:     cmpi.b  #$01,D0
02:00041F2A 6718            	  3802:     beq  _L_z05_CheckLadder_HandleInput
                            	  3803:     even
                            	  3804: _L_z05_CheckLadder_StashLadder:
                            	  3805:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3806:     ;
02:00041F2C 7000            	  3807:     moveq   #0,D0
02:00041F2E 19400064        	  3808:     move.b  D0,($0064,A4)
02:00041F32 4EB90004D9A2    	  3809:     jsr     DestroyMonster
                            	  3810:     even
                            	  3811: _L_z05_CheckLadder_Exit:
02:00041F38 4E75            	  3812:     rts
                            	  3813: 
                            	  3814:     even
                            	  3815: _L_z05_CheckLadder_SetState2:
                            	  3816:     ;  Set state 2, because we're on the ladder.
                            	  3817:     ;
02:00041F3A 7002            	  3818:     moveq   #2,D0
02:00041F3C 41EC00AC        	  3819:     lea     ($00AC,A4),A0
02:00041F40 11802000        	  3820:     move.b  D0,(A0,D2.W)
                            	  3821:     even
                            	  3822: _L_z05_CheckLadder_HandleInput:
                            	  3823:     ; If input direction = 0, go draw and reset moving direction.
                            	  3824:     ;
02:00041F44 102C03F8        	  3825:     move.b  ($03F8,A4),D0
02:00041F48 67000086        	  3826:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3827:     ; Input direction <> 0. The player intends to move.
                            	  3828:     ; So, see if we need to override the moving direction.
                            	  3829:     ;
                            	  3830:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3831:     ; go draw and set moving direction to Link's direction.
                            	  3832:     ;
                            	  3833:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3834:     ; been blocked by the water.
                            	  3835:     ;
                            	  3836:     ; Or, Link already passed over the point right over the ladder
                            	  3837:     ; and was allowed to move onto the tiles after the ladder.
                            	  3838:     ;
02:00041F4C 102C0098        	  3839:     move.b  ($0098,A4),D0
02:00041F50 7600            	  3840:     moveq   #0,D3
02:00041F52 1614            	  3841:     move.b  ($0000,A4),D3
02:00041F54 670C            	  3842:     beq  _anon_z05_86
02:00041F56 41EC0098        	  3843:     lea     ($0098,A4),A0
02:00041F5A 12302000        	  3844:     move.b  (A0,D2.W),D1
02:00041F5E B001            	  3845:     cmp.b   D1,D0
02:00041F60 676E            	  3846:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3847: _anon_z05_86:
                            	  3848:     ; Distance = 0, or facing different directions.
                            	  3849:     ;
                            	  3850:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3851:     ; then go draw and keep moving.
                            	  3852:     ;
                            	  3853:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3854:     ;
                            	  3855:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3856:     ; to move onto the tiles after the ladder.
                            	  3857:     ;
                            	  3858:     ; Note that if Link is not moving, then this test will fail,
                            	  3859:     ; and case (D) will catch it.
                            	  3860:     ;
02:00041F62 41EC0098        	  3861:     lea     ($0098,A4),A0
02:00041F66 10302000        	  3862:     move.b  (A0,D2.W),D0
02:00041F6A 122C000F        	  3863:     move.b  ($000F,A4),D1
02:00041F6E B001            	  3864:     cmp.b   D1,D0
02:00041F70 675E            	  3865:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3866:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3867:     ; then go draw and move in ladder's direction.
                            	  3868:     ;
                            	  3869:     ; You can always step off the ladder where you came from.
                            	  3870:     ;
02:00041F72 4EB900030BA4    	  3871:     jsr     GetOppositeDir
02:00041F78 122C0098        	  3872:     move.b  ($0098,A4),D1
02:00041F7C B001            	  3873:     cmp.b   D1,D0
02:00041F7E 6750            	  3874:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3875:     ; D. If opposite of ladder's direction <> down,
                            	  3876:     ; or input direction <> up,
                            	  3877:     ; then go reset moving direction, and draw.
                            	  3878:     ;
                            	  3879:     ; This will catch all cases of Link facing perpendicular to
                            	  3880:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3881:     ; ladder direction is up and input direction is up (E).
                            	  3882:     ;
02:00041F80 0C000004        	  3883:     cmpi.b  #$04,D0
02:00041F84 6648            	  3884:     bne  _anon_z05_87
02:00041F86 102C03F8        	  3885:     move.b  ($03F8,A4),D0
02:00041F8A 0C000008        	  3886:     cmpi.b  #$08,D0
02:00041F8E 663E            	  3887:     bne  _anon_z05_87
                            	  3888:     ; E. The ladder's direction is up and input direction is up.
                            	  3889:     ;
                            	  3890:     ; An earlier call to check tile collision would have blocked
                            	  3891:     ; movement, because the tile under Link's top half is a water tile.
                            	  3892:     ; But because Link is squarely on the ladder, we really have
                            	  3893:     ; to check the tile above that one.
                            	  3894:     ;
                            	  3895:     ; Set moving direction to input direction (up) and switch X to
                            	  3896:     ; the player's slot for the purpose of checking tile collision below.
                            	  3897:     ; Based on that, we'll set moving direction according to walkability.
                            	  3898:     ;
02:00041F90 6158            	  3899:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3900:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3901:     ;
02:00041F92 102C0084        	  3902:     move.b  ($0084,A4),D0
02:00041F96 1B00            	  3903:     move.b  D0,-(A5)  ; PHA
02:00041F98 003C0011        	  3904:     ori     #$11,CCR  ; SEC: set C+X
02:00041F9C 123C0008        	  3905:     move.b  #$08,D1
02:00041FA0 0A3C0010        	  3906:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041FA4 9101            	  3907:     subx.b  D1,D0   ; SBC #$08
02:00041FA6 0A3C0010        	  3908:     eori    #$10,CCR  ; restore X = 6502 C
02:00041FAA 19400084        	  3909:     move.b  D0,($0084,A4)
02:00041FAE 4EB90004B91A    	  3910:     jsr     GetCollidingTileMoving
02:00041FB4 101D            	  3911:     move.b  (A5)+,D0  ; PLA
02:00041FB6 19400084        	  3912:     move.b  D0,($0084,A4)
                            	  3913:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3914:     ; direction as the input direction (in a roundabout way).
                            	  3915:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3916:     ;
02:00041FBA 102C000F        	  3917:     move.b  ($000F,A4),D0
02:00041FBE 7600            	  3918:     moveq   #0,D3
02:00041FC0 162C049E        	  3919:     move.b  ($049E,A4),D3
02:00041FC4 122C034A        	  3920:     move.b  ($034A,A4),D1
02:00041FC8 B601            	  3921:     cmp.b   D1,D3
02:00041FCA 6500FF78        	  3922:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3923: _anon_z05_87:
                            	  3924:     ; Set A to reset moving direction in [0F].
                            	  3925:     ;
02:00041FCE 7000            	  3926:     moveq   #0,D0
                            	  3927:     even
                            	  3928: _L_z05_CheckLadder_DrawLadder:
                            	  3929:     ; Draw the ladder.
                            	  3930:     ;
02:00041FD0 1B00            	  3931:     move.b  D0,-(A5)  ; PHA
02:00041FD2 7400            	  3932:     moveq   #0,D2
02:00041FD4 142C0064        	  3933:     move.b  ($0064,A4),D2
02:00041FD8 4EB90004D1BE    	  3934:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041FDE 760C            	  3935:     moveq   #12,D3
02:00041FE0 7000            	  3936:     moveq   #0,D0
02:00041FE2 4EB90003192A    	  3937:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041FE8 101D            	  3938:     move.b  (A5)+,D0  ; PLA
                            	  3939: ; Params:
                            	  3940: ; A: direction
                            	  3941: ;
                            	  3942: ; Returns:
                            	  3943: ; [0F]: direction
                            	  3944: ;
                            	  3945:     even
                            	  3946: SetMovingDirAndSwitchToPlayerSlot:
02:00041FEA 1940000F        	  3947:     move.b  D0,($000F,A4)
02:00041FEE 7400            	  3948:     moveq   #0,D2
02:00041FF0 4E75            	  3949:     rts
