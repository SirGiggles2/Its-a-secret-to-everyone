                            	  5994: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  5995:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  5996:     ;
02:0003C13A 7004            	  5997:     moveq   #4,D0
02:0003C13C 1880            	  5998:     move.b  D0,($0000,A4)
                            	  5999:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6000:     ;
02:0003C13E 7600            	  6001:     moveq   #0,D3
02:0003C140 0C020005        	  6002:     cmpi.b  #$05,D2
02:0003C144 6702            	  6003:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C146 7605            	  6004:     moveq   #5,D3
                            	  6005:     even
                            	  6006: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6007:     ; Copy old direction from a higher slot to the lower one;
                            	  6008:     ; and to the lower one's facing direction.
                            	  6009:     ;
02:0003C148 41EC0382        	  6010:     lea     ($0382,A4),A0
02:0003C14C 10303000        	  6011:     move.b  (A0,D3.W),D0
02:0003C150 41EC0381        	  6012:     lea     ($0381,A4),A0
02:0003C154 11803000        	  6013:     move.b  D0,(A0,D3.W)
02:0003C158 41EC0099        	  6014:     lea     ($0099,A4),A0
02:0003C15C 11803000        	  6015:     move.b  D0,(A0,D3.W)
                            	  6016:     ; Bottom of the loop.
                            	  6017:     ; Increment segment index.
                            	  6018:     ; Decrement loop counter.
                            	  6019:     ;
02:0003C160 5203            	  6020:     addq.b  #1,D3
02:0003C162 5314            	  6021:     subq.b  #1,($0000,A4)
02:0003C164 66E2            	  6022:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  6023:     ; Copy current direction to old direction.
                            	  6024:     ;
02:0003C166 41EC0098        	  6025:     lea     ($0098,A4),A0
02:0003C16A 10302000        	  6026:     move.b  (A0,D2.W),D0
02:0003C16E 41EC0380        	  6027:     lea     ($0380,A4),A0
