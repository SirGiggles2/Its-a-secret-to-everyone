02:000445DE E208            	  7469:     lsr.b  #1,D0   ; LSR A
02:000445E0 7400            	  7470:     moveq   #0,D2
02:000445E2 1400            	  7471:     move.b  D0,D2
02:000445E4 41F90004A8B6    	  7472:     lea     (PlayAreaColumnAddrs).l,A0
02:000445EA 10302000        	  7473:     move.b  (A0,D2.W),D0
02:000445EE 1880            	  7474:     move.b  D0,($0000,A4)
02:000445F0 41F90004A8B7    	  7475:     lea     (PlayAreaColumnAddrs+1).l,A0
02:000445F6 10302000        	  7476:     move.b  (A0,D2.W),D0
02:000445FA 19400001        	  7477:     move.b  D0,($0001,A4)
02:000445FE 1003            	  7478:     move.b  D3,D0
