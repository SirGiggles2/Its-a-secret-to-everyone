02:0004B0A8 123C0002        	  2400:     move.b  #$02,D1
02:0004B0AC D101            	  2401:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B0AE 41EC030A        	  2402:     lea     ($030A,A4),A0
02:0004B0B2 11802000        	  2403:     move.b  D0,(A0,D2.W)
02:0004B0B6 41EC030B        	  2404:     lea     ($030B,A4),A0
02:0004B0BA 11802000        	  2405:     move.b  D0,(A0,D2.W)
02:0004B0BE 41EC0306        	  2406:     lea     ($0306,A4),A0
