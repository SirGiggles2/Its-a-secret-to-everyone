02:0003F8AE 122C052A        	 13542:     move.b  ($052A,A4),D1
02:0003F8B2 D101            	 13543:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0003F8B4 7600            	 13544:     moveq   #0,D3
02:0003F8B6 1600            	 13545:     move.b  D0,D3
02:0003F8B8 41F90003F7F0    	 13546:     lea     (DropItemTable).l,A0
