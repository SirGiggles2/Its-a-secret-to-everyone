                            	  3306:     ; Set the current object slot to what it should be when we
                            	  3307:     ; begin updating objects again next frame: $B
                            	  3308:     ; the last object slot for monsters and tile objects
                            	  3309:     ;
                            	  3310:     ; Before the first frame of mode 5, the current object slot variable
                            	  3311:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3312:     ;
                            	  3313:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3314:     ;
