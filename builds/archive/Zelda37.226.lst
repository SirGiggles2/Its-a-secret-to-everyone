02:0003C85A 7600            	  6958:     moveq   #0,D3
02:0003C85C 162C0341        	  6959:     move.b  ($0341,A4),D3
02:0003C860 41F9000316EE    	  6960:     lea     (SpriteOffsets).l,A0
02:0003C866 10303000        	  6961:     move.b  (A0,D3.W),D0
02:0003C86A 7600            	  6962:     moveq   #0,D3
02:0003C86C 1600            	  6963:     move.b  D0,D3
02:0003C86E 101D            	  6964:     move.b  (A5)+,D0  ; PLA
02:0003C870 41EC0201        	  6965:     lea     ($0201,A4),A0
02:0003C874 11803000        	  6966:     move.b  D0,(A0,D3.W)
02:0003C878 1014            	  6967:     move.b  ($0000,A4),D0
02:0003C87A 41EC0203        	  6968:     lea     ($0203,A4),A0
02:0003C87E 11803000        	  6969:     move.b  D0,(A0,D3.W)
02:0003C882 102C0001        	  6970:     move.b  ($0001,A4),D0
02:0003C886 4EF900031A6C    	  6971:     jmp     Anim_EndWriteSprite
