02:0003BB08 41F9000316EE    	  5175:     lea     (SpriteOffsets).l,A0
02:0003BB0E 10303000        	  5176:     move.b  (A0,D3.W),D0
02:0003BB12 1880            	  5177:     move.b  D0,($0000,A4)
02:0003BB14 41F9000316EF    	  5178:     lea     (SpriteOffsets+1).l,A0
