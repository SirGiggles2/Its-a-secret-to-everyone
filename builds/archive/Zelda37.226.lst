                            	  4917: 
                            	  4918: ; Params:
                            	  4919: ; [02:03]: address of door tiles for direction and face
                            	  4920: ; [04]: count of tiles remaining
                            	  4921: ; [07]: current index (0 to 3) of the tile to copy
                            	  4922: ;       to the dynamic transfer buf
                            	  4923: ; [09]: door direction index
                            	  4924: ;
                            	  4925: ; Returns:
                            	  4926: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4927: ; [04]: original value - 1
                            	  4928: ; [07]: original value + 1
                            	  4929: ;
                            	  4930: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4931: ; vertically. The point of this routine is to access them
                            	  4932: ; horizontally in order to transfer them to a nametable.
                            	  4933: ;
                            	  4934: ;
                            	  4935: ; For the direction index in [09], look up the base offset of the
                            	  4936: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4937: ; the door face tiles at [02:03].
                            	  4938: ;
                            	  4939:     even
                            	  4940: WriteDoorFaceTileHorizontally:
02:000427C8 7600            	  4941:     moveq   #0,D3
02:000427CA 162C0009        	  4942:     move.b  ($0009,A4),D3
02:000427CE 41F9000439EC    	  4943:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000427D4 10303000        	  4944:     move.b  (A0,D3.W),D0
                            	  4945:     ; Add [07] to the base offset we got above. This yields one
                            	  4946:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4947:     ;
02:000427D8 023C00EE        	  4948:     andi    #$EE,CCR  ; CLC: clear C+X
02:000427DC 122C0007        	  4949:     move.b  ($0007,A4),D1
02:000427E0 D101            	  4950:     addx.b  D1,D0   ; ADC $07
02:000427E2 7600            	  4951:     moveq   #0,D3
02:000427E4 1600            	  4952:     move.b  D0,D3
                            	  4953:     ; With that index, look up the index to use with the door face
                            	  4954:     ; list of tiles at [02:03].
                            	  4955:     ;
02:000427E6 41F9000439DE    	  4956:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000427EC 10303000        	  4957:     move.b  (A0,D3.W),D0
02:000427F0 7600            	  4958:     moveq   #0,D3
02:000427F2 1600            	  4959:     move.b  D0,D3
                            	  4960:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4961:     ; and copy it to the dynamic transfer buf.
