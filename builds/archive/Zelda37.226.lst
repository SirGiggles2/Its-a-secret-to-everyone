02:00031EA0 60000102        	  6977:     jmp  L74D8_Exit
                            	  6978: __far_z_01_0072:
                            	  6979:     ; If the weapon is a boomerang ...
                            	  6980:     ;
02:00031EA4 0C03000F        	  6981:     cmpi.b  #$0F,D3
