02:00030C62 102C0004        	  4572:     move.b  ($0004,A4),D0
02:00030C66 19400003        	  4573:     move.b  D0,($0003,A4)
02:00030C6A 101D            	  4574:     move.b  (A5)+,D0  ; PLA
02:00030C6C 19400004        	  4575:     move.b  D0,($0004,A4)
02:00030C70 7001            	  4576:     moveq   #1,D0
02:00030C72 19400001        	  4577:     move.b  D0,($0001,A4)
                            	  4578:     even
                            	  4579: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4580:     ; TODO: call it speed index or angle?
