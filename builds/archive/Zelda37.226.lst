02:0003BB22 61000104        	  5183:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5184:     ; The default image is the hand open.
                            	  5185:     ; If animation frame = 0, then return.
                            	  5186:     ;
02:0003BB26 7400            	  5187:     moveq   #0,D2
02:0003BB28 142C0340        	  5188:     move.b  ($0340,A4),D2
02:0003BB2C 41EC03E4        	  5189:     lea     ($03E4,A4),A0
02:0003BB30 10302000        	  5190:     move.b  (A0,D2.W),D0
02:0003BB34 6724            	  5191:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5192:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5193:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5194:     ; The right side is correctly the right side of a closed hand.
                            	  5195:     ; But the left side is Keese. So, we have to patch the left
                            	  5196:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5197:     ;
                            	  5198:     ; Keep in mind that left and right sprites might be flipped.
                            	  5199:     ;
02:0003BB36 7600            	  5200:     moveq   #0,D3
02:0003BB38 1614            	  5201:     move.b  ($0000,A4),D3
02:0003BB3A 41EC0201        	  5202:     lea     ($0201,A4),A0
02:0003BB3E 10303000        	  5203:     move.b  (A0,D3.W),D0
02:0003BB42 0C00009C        	  5204:     cmpi.b  #$9C,D0
02:0003BB46 6706            	  5205:     beq  _anon_z04_68
02:0003BB48 7600            	  5206:     moveq   #0,D3
02:0003BB4A 162C0001        	  5207:     move.b  ($0001,A4),D3
                            	  5208: _anon_z04_68:
