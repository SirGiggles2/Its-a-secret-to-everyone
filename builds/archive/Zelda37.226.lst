                            	  9709:     ; Also set its timer to $10.
                            	  9710:     ;
02:0003DC7C 61001B42        	  9711:     jsr     PlayBossDeathCry
02:0003DC80 705D            	  9712:     moveq   #93,D0
02:0003DC82 19400354        	  9713:     move.b  D0,($0354,A4)
02:0003DC86 7010            	  9714:     moveq   #16,D0
02:0003DC88 1940040A        	  9715:     move.b  D0,($040A,A4)
02:0003DC8C 1940002D        	  9716:     move.b  D0,($002D,A4)
                            	  9717:     even
