                            	  5838: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5839:     ; The door attribute (DA) has been mapped to a
                            	  5840:     ; provisional door face value (PF) in %A as follows:
                            	  5841:     ;
                            	  5842:     ; DA PF Meaning
                            	  5843:     ; -------------
                            	  5844:     ; 0  4  open
                            	  5845:     ; 1  1  wall
                            	  5846:     ; 2  2  false wall
                            	  5847:     ; 3  3  false wall 2
                            	  5848:     ; 4  8  bombable
                            	  5849:     ; 5  5  key
                            	  5850:     ; 6  6  key 2
                            	  5851:     ; 7  7  shutter
                            	  5852:     ;
                            	  5853:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5854:     ; has been cleared, if the type was "open" or any wall.
                            	  5855:     ;
                            	  5856:     ;
                            	  5857:     ; Save the provisional face.
02:0004383E 1B00            	  5858:     move.b  D0,-(A5)  ; PHA
                            	  5859:     ; If the current direction points to a door that has been opened,
                            	  5860:     ; then see if we need to set door flags.
                            	  5861:     ;
02:00043840 102C00EE        	  5862:     move.b  ($00EE,A4),D0
02:00043844 122C0002        	  5863:     move.b  ($0002,A4),D1
02:00043848 C001            	  5864:     and.b  D1,D0
02:0004384A 7400            	  5865:     moveq   #0,D2
02:0004384C 1400            	  5866:     move.b  D0,D2
02:0004384E 101D            	  5867:     move.b  (A5)+,D0  ; PLA
02:00043850 122C0002        	  5868:     move.b  ($0002,A4),D1
02:00043854 B401            	  5869:     cmp.b   D1,D2
02:00043856 6624            	  5870:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5871:     ; The current direction points to a door that has been opened.
                            	  5872:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5873:     ;
