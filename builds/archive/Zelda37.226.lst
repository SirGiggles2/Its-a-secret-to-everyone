02:000445D0 4EB90002A9FA    	  7462:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
02:000445D6 4EB900030E60    	  7463:     jsr     GetShortcutOrItemXY
                            	  7464:     ; Divide X coordinate by 4 to get offset into column address table.
