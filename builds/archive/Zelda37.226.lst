02:0003BA60 7600            	  5097:     moveq   #0,D3
02:0003BA62 41EC0412        	  5098:     lea     ($0412,A4),A0
02:0003BA66 16302000        	  5099:     move.b  (A0,D2.W),D3
02:0003BA6A 41F90003B89C    	  5100:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003BA70 10303000        	  5101:     move.b  (A0,D3.W),D0
02:0003BA74 0200000F        	  5102:     andi.b #$0F,D0
02:0003BA78 41EC0098        	  5103:     lea     ($0098,A4),A0
02:0003BA7C 11802000        	  5104:     move.b  D0,(A0,D2.W)
                            	  5105:     ; Increase the count of tiles crossed.
                            	  5106:     ;
02:0003BA80 41EC041F        	  5107:     lea     ($041F,A4),A0
02:0003BA84 52302000        	  5108:     addq.b  #1,(A0,D2.W)
                            	  5109:     ; If the monster has crossed less than 7 tiles, then
                            	  5110:     ; go draw and check collisions.
                            	  5111:     ;
02:0003BA88 41EC041F        	  5112:     lea     ($041F,A4),A0
02:0003BA8C 10302000        	  5113:     move.b  (A0,D2.W),D0
02:0003BA90 0C000007        	  5114:     cmpi.b  #$07,D0
02:0003BA94 652C            	  5115:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  5116:     ; It has reached the end of a trip.
                            	  5117:     ;
                            	  5118:     ; If Wallmaster did not capture Link, then go set state to 0 and return.
                            	  5119:     ;
02:0003BA96 41EC042C        	  5120:     lea     ($042C,A4),A0
02:0003BA9A 10302000        	  5121:     move.b  (A0,D2.W),D0
02:0003BA9E 6718            	  5122:     beq  _L_z04_L_Wallmaster_State1_SetState
                            	  5123:     ; At the end of a trip where Link was captured:
