02:0003DC6A 0C00003C        	  9689:     cmpi.b  #$3C,D0
02:0003DC6E 6602            	  9690:     bne  _anon_z04_113
02:0003DC70 5214            	  9691:     addq.b  #1,($0000,A4)
                            	  9692: _anon_z04_113:
