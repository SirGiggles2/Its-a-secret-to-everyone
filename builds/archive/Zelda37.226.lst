02:0003629A 600000C6        	  4557:     jmp  LA9F4_Exit
                            	  4558: __far_z_02_0009:
                            	  4559:     ; Set the timer to wait 6 frames after the next character about
                            	  4560:     ; to be shown.
                            	  4561:     ;
02:0003629E 7006            	  4562:     moveq   #6,D0
02:000362A0 19400029        	  4563:     move.b  D0,($0029,A4)
                            	  4564:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4565:     ; to the dynamic transfer buf.
                            	  4566:     ;
02:000362A4 7604            	  4567:     moveq   #4,D3
                            	  4568: _anon_z02_31:
02:000362A6 41F900036284    	  4569:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000362AC 10303000        	  4570:     move.b  (A0,D3.W),D0
02:000362B0 41EC0302        	  4571:     lea     ($0302,A4),A0
02:000362B4 11803000        	  4572:     move.b  D0,(A0,D3.W)
02:000362B8 5303            	  4573:     subq.b  #1,D3
02:000362BA 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:000362BC 102C045F        	  4579:     move.b  ($045F,A4),D0
02:000362C0 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:000362C4 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:000362C8 7000            	  4584:     moveq   #0,D0
02:000362CA 1880            	  4585:     move.b  D0,($0000,A4)
02:000362CC 7000            	  4586:     moveq   #0,D0
02:000362CE 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:000362D2 7600            	  4590:     moveq   #0,D3
02:000362D4 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:000362D8 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:000362DC 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:000362DE 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:000362E2 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000362E6 E14C            	  4601:     lsl.w   #8,D4
02:000362E8 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:000362EA 48C4            	  4603:     ext.l   D4
02:000362EC D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000362F2 2044            	  4605:     movea.l D4,A0
02:000362F4 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:000362F8 0200003F        	  4611:     andi.b #$3F,D0
02:000362FC 0C000025        	  4612:     cmpi.b  #$25,D0
02:00036300 67BA            	  4613:     beq  _anon_z02_32
                            	  4614:     ; We have a non-space character. Put it in the transfer record.
                            	  4615:     ;
02:00036302 19400305        	  4616:     move.b  D0,($0305,A4)
                            	  4617:     ; Play the "heart taken/character" tune.
                            	  4618:     ;
02:00036306 7010            	  4619:     moveq   #16,D0
02:00036308 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:0003630C 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:0003630E 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:00036312 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036316 E14C            	  4626:     lsl.w   #8,D4
02:00036318 8841            	  4627:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003631A 48C4            	  4628:     ext.l   D4
02:0003631C D8BC00FF0000    	  4629:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036322 2044            	  4630:     movea.l D4,A0
02:00036324 10303000        	  4631:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00036328 020000C0        	  4632:     andi.b #$C0,D0
02:0003632C 6602            	  4633:     bne.s  __far_z_02_0010
02:0003632E 6032            	  4634:     jmp  LA9F4_Exit
                            	  4635: __far_z_02_0010:
                            	  4636:     ; Determine an index based on the high 2 bits of the character element:
                            	  4637:     ;   $80: 0
                            	  4638:     ;   $40: 1
                            	  4639:     ;   $C0: 2
                            	  4640:     ;
02:00036330 7602            	  4641:     moveq   #2,D3
02:00036332 0C0000C0        	  4642:     cmpi.b  #$C0,D0
02:00036336 670A            	  4643:     beq  _anon_z02_33
02:00036338 5303            	  4644:     subq.b  #1,D3
02:0003633A 0C000040        	  4645:     cmpi.b  #$40,D0
02:0003633E 6702            	  4646:     beq  _anon_z02_33
02:00036340 5303            	  4647:     subq.b  #1,D3
                            	  4648: _anon_z02_33:
                            	  4649:     ; The index chooses the low VRAM address of the start
                            	  4650:     ; of another line:
                            	  4651:     ;   0: $C4: front of the second line
                            	  4652:     ;   1: $E4: front of the third line
                            	  4653:     ;   2: $A4: front of the first line
                            	  4654:     ;
02:00036342 41F90003628A    	  4655:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00036348 10303000        	  4656:     move.b  (A0,D3.W),D0
02:0003634C 1940045F        	  4657:     move.b  D0,($045F,A4)
                            	  4658:     ; If index = 2, then we've reached the end of the text,
                            	  4659:     ; and low VRAM address is moved to the front of the first line.
                            	  4660:     ; So, advance the state of the person object, and unhalt Link.
                            	  4661:     ;
02:00036350 0C030002        	  4662:     cmpi.b  #$02,D3
02:00036354 6702            	  4663:     beq.s  __far_z_02_0011
02:00036356 600A            	  4664:     jmp  LA9F4_Exit
