02:0004C9F6 11802000        	  6032:     move.b  D0,(A0,D2.W)
02:0004C9FA 41EC00AC        	  6033:     lea     ($00AC,A4),A0
02:0004C9FE 52302000        	  6034:     addq.b  #1,(A0,D2.W)
02:0004CA02 41EC00AC        	  6035:     lea     ($00AC,A4),A0
