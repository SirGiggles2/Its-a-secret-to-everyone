                            	  5903: Moldorm_ChangeFlyingState:
                            	  5904:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5905:     ;
02:0003C0E0 61000096        	  5906:     jsr     Flyer_MoldormDecideState
02:0003C0E4 7010            	  5907:     moveq   #16,D0
02:0003C0E6 19802028        	  5908:     move.b  D0,($28,A4,D2.W)
                            	  5909:     ; If the next lower slot's direction <> 0, then
                            	  5910:     ; go propagate direction changes down the chain.
                            	  5911:     ;
                            	  5912:     ; But you had to have propagated directions once for the
                            	  5913:     ; next lower direction to be set. How does it happen?
                            	  5914:     ;
                            	  5915:     ; Within a flyer state, the flying routines turn the flyer
                            	  5916:     ; and set the object timer to $10 several times. After any of
                            	  5917:     ; those times will the test succeed.
                            	  5918:     ;
                            	  5919:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5920:     ; in this block to set the timer to $10, and try to propagate
                            	  5921:     ; directions.
                            	  5922:     ;
                            	  5923:     ; But this is also the case the first time here.
                            	  5924:     ;
                            	  5925:     ; So, I believe that the point of this test is to delay moving
                            	  5926:     ; the lower (not head) segments when starting out.
                            	  5927:     ;
02:0003C0EA 41EC0097        	  5928:     lea     ($0097,A4),A0
02:0003C0EE 10302000        	  5929:     move.b  (A0,D2.W),D0
02:0003C0F2 6702            	  5930:     beq.s  __far_z_04_0046
02:0003C0F4 601C            	  5931:     jmp  Moldorm_PropagateDirs
                            	  5932: __far_z_04_0046:
02:0003C0F6 4E75            	  5933:     rts
                            	  5934: 
                            	  5935:     even
                            	  5936: Moldorm_Wander:
                            	  5937:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5938:     ; Only the head controls the movement direction.
                            	  5939:     ;
02:0003C0F8 0C020005        	  5940:     cmpi.b  #$05,D2
02:0003C0FC 6708            	  5941:     beq  _anon_z04_82
02:0003C0FE 0C02000A        	  5942:     cmpi.b  #$0A,D2
02:0003C102 6702            	  5943:     beq.s  __far_z_04_0047
02:0003C104 6070            	  5944:     jmp  L1156B_Exit
                            	  5945: __far_z_04_0047:
                            	  5946: _anon_z04_82:
                            	  5947:     ; Turn randomly while flying, as usual.
                            	  5948:     ;
02:0003C106 61003CDE        	  5949:     jsr     Flyer_Wander
                            	  5950:     ; After every turn, the common flyer routines set timer to $10.
                            	  5951:     ; This can be used as a signal for moldorm to propagate
                            	  5952:     ; direction changes down the chain.
                            	  5953:     ;
                            	  5954:     ; Between each turn, timer <> $10.
                            	  5955:     ;
                            	  5956:     ; At the end of the delay after the last turn, timer = 0.
                            	  5957:     ; This is a signal that that flying state ended, and a new one
                            	  5958:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5959:     ; we can propagate direction changes again; and start
                            	  5960:     ; a new flying interval by setting timer to $10. This will make
                            	  5961:     ; the next flying state delay that amount of time before turning
                            	  5962:     ; the first time.
                            	  5963:     ;
                            	  5964:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5965:     ; arm the timer again, and shift directions down the chain.
                            	  5966:     ;
02:0003C10A 10342028        	  5967:     move.b  ($28,A4,D2.W),D0
02:0003C10E 6602            	  5968:     bne.s  __far_z_04_0048
02:0003C110 60CE            	  5969:     jmp  Moldorm_ChangeFlyingState
                            	  5970: __far_z_04_0048:
                            	  5971:     even
                            	  5972: Moldorm_PropagateDirs:
                            	  5973:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5974:     ;
02:0003C112 10342028        	  5975:     move.b  ($28,A4,D2.W),D0
02:0003C116 0C000010        	  5976:     cmpi.b  #$10,D0
02:0003C11A 6702            	  5977:     beq.s  __far_z_04_0049
02:0003C11C 6058            	  5978:     jmp  L1156B_Exit
