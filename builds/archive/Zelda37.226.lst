02:00041AD8 7600            	  3151:     moveq   #0,D3
02:00041ADA 1600            	  3152:     move.b  D0,D3
                            	  3153:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3154:     ; boundary using player's direction and reverse direction index.
                            	  3155:     ;
