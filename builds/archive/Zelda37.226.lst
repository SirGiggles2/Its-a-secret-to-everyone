                            	  2791: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2792:     ; State 1. Jumping.
                            	  2793:     ;
                            	  2794:     ; Keep the object inside the bounds of the room.
                            	  2795:     ;
02:0003AA12 61005268        	  2796:     jsr     BoundFlyer
                            	  2797:     ; If the object was blocked at the room boundary, then
                            	  2798:     ; increase boundary reversal count, and go set up another jump.
                            	  2799:     ;
02:0003AA16 102C000F        	  2800:     move.b  ($000F,A4),D0
02:0003AA1A 660C            	  2801:     bne  _anon_z04_37
02:0003AA1C 41EC0451        	  2802:     lea     ($0451,A4),A0
02:0003AA20 52302000        	  2803:     addq.b  #1,(A0,D2.W)
02:0003AA24 6000FF74        	  2804:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2805: 
                            	  2806: _anon_z04_37:
02:0003AA28 61000196        	  2807:     jsr     Jumper_PointBoulderDownward
                            	  2808:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2809:     ;
02:0003AA2C 7000            	  2810:     moveq   #0,D0
02:0003AA2E 41EC0451        	  2811:     lea     ($0451,A4),A0
02:0003AA32 11802000        	  2812:     move.b  D0,(A0,D2.W)
                            	  2813:     ; Get the base offset for the kind of jumper the object is.
                            	  2814:     ;
02:0003AA36 6100015E        	  2815:     jsr     Jumper_GetKind
02:0003AA3A 41F90003A926    	  2816:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AA40 10303000        	  2817:     move.b  (A0,D3.W),D0
                            	  2818:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2819:     ;
                            	  2820:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2821:     ; does not have $B elements like the tektites' sets.
                            	  2822:     ;
                            	  2823:     ; Boulder does not need the upward accelerations.
                            	  2824:     ; So, the elements for those are used for the starting speeds
                            	  2825:     ; at 04:88F2.
                            	  2826:     ;
02:0003AA44 023C00EE        	  2827:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA48 41EC0098        	  2828:     lea     ($0098,A4),A0
02:0003AA4C 12302000        	  2829:     move.b  (A0,D2.W),D1
02:0003AA50 D101            	  2830:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003AA52 7600            	  2831:     moveq   #0,D3
02:0003AA54 1600            	  2832:     move.b  D0,D3
02:0003AA56 41F90003A904    	  2833:     lea     (JumperYAccelerations).l,A0
02:0003AA5C 10303000        	  2834:     move.b  (A0,D3.W),D0
02:0003AA60 7602            	  2835:     moveq   #2,D3
02:0003AA62 61000162        	  2836:     jsr     Jumper_MoveY
                            	  2837:     ; If the facing direction has a left component, then
                            	  2838:     ; subtract 1 from the object's X.
                            	  2839:     ;
                            	  2840:     ; Else add 1.
                            	  2841:     ;
02:0003AA66 163C00FF        	  2842:     move.b  #$FF,D3
