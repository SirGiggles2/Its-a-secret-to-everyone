                            	  6080: 
                            	  6081: ; Params:
                            	  6082: ; [00]: Object X
                            	  6083: ; [01]: Object Y
                            	  6084: ; [02]: Left tile
                            	  6085: ; [03]: Right tile
                            	  6086: ; [04]: Left attributes
                            	  6087: ; [05]: Right attributes
                            	  6088: ; [07]: Has two sides
                            	  6089: ; [08]: Cycle sprite index
                            	  6090: ; [0A]: X separation
                            	  6091: ; [0F]: Flip horizontally
                            	  6092: ; [0343]: LeftSpriteOffset
                            	  6093: ; [0344]: RightSpriteOffset
                            	  6094: ;
                            	  6095: ; If [0F] = 0, write the sprite pair with no further processing.
