02:0004D754 E208            	  7746:     lsr.b  #1,D0   ; LSR A
02:0004D756 7600            	  7747:     moveq   #0,D3
02:0004D758 1600            	  7748:     move.b  D0,D3
02:0004D75A 41F90004D292    	  7749:     lea     (ObjectTypeToHpPairs).l,A0
02:0004D760 10303000        	  7750:     move.b  (A0,D3.W),D0
