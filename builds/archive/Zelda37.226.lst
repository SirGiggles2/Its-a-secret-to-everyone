02:0003F8C4 7023            	 13551:     moveq   #35,D0
02:0003F8C6 7600            	 13552:     moveq   #0,D3
02:0003F8C8 162C0627        	 13553:     move.b  ($0627,A4),D3
02:0003F8CC 0C030010        	 13554:     cmpi.b  #$10,D3
02:0003F8D0 6716            	 13555:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13556:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13557:     ; But there is a random chance that the item drop will be canceled.
                            	 13558:     ;
02:0003F8D2 102C0050        	 13559:     move.b  ($0050,A4),D0
