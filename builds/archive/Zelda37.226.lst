02:0003C2F8 19802070        	  6276:     move.b  D0,($70,A4,D2.W)
02:0003C2FC 41EC0084        	  6277:     lea     ($0084,A4),A0
02:0003C300 10302000        	  6278:     move.b  (A0,D2.W),D0
02:0003C304 023C00EE        	  6279:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C308 41F90003C1A4    	  6280:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C30E 12303000        	  6281:     move.b  (A0,D3.W),D1
02:0003C312 D101            	  6282:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C314 41EC0084        	  6283:     lea     ($0084,A4),A0
02:0003C318 11802000        	  6284:     move.b  D0,(A0,D2.W)
                            	  6285:     ; Check the room boundary and object collisions in this temporary location.
