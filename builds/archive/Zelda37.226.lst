                            	  4068: PondFairy_HandleOtherStates:
02:0003B326 0C000001        	  4069:     cmpi.b  #$01,D0
02:0003B32A 6610            	  4070:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4071:     ; State 1. Flying and filling hearts.
                            	  4072:     ;
                            	  4073:     ; If still filling hearts, then go draw Link and hearts.
                            	  4074:     ;
02:0003B32C 102C0063        	  4075:     move.b  ($0063,A4),D0
02:0003B330 6620            	  4076:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4077:     ; If not filling hearts anymore, then go to state 2,
                            	  4078:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4079:     ; a little while after we finish filling hearts.
                            	  4080:     ;
02:0003B332 522C00AD        	  4081:     addq.b  #1,($00AD,A4)
02:0003B336 7050            	  4082:     moveq   #80,D0
02:0003B338 19400029        	  4083:     move.b  D0,($0029,A4)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4086:     ; If state <> 2 (so, it's 3), then return.
                            	  4087:     ;
                            	  4088:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4089:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4090:     ; was set to, and we'll return.
                            	  4091:     ;
02:0003B33C 0C000002        	  4092:     cmpi.b  #$02,D0
02:0003B340 6634            	  4093:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4094:     ; State = 2.
                            	  4095:     ;
                            	  4096:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4097:     ;
02:0003B342 102C0029        	  4098:     move.b  ($0029,A4),D0
02:0003B346 660A            	  4099:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4100:     ; Else go to state 3, and unhalt Link.
                            	  4101:     ;
02:0003B348 522C00AD        	  4102:     addq.b  #1,($00AD,A4)
02:0003B34C 7000            	  4103:     moveq   #0,D0
02:0003B34E 194000AC        	  4104:     move.b  D0,($00AC,A4)
                            	  4105:     even
