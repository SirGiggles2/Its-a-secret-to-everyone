                            	  5723: __far_z_07_0087:
                            	  5724:     ; State $2x. Spark.
                            	  5725:     ;
                            	  5726:     ; Change the state to $28, and decrement animation counter.
                            	  5727:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5728:     ; (with Link, if this is a monster's boomerang).
                            	  5729:     ;
                            	  5730:     ; TODO: Why state $28?
                            	  5731:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5732:     ; start over again when spinning.
                            	  5733:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5734:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5735:     ; any drawing code depends on the minor state.
                            	  5736:     ;
02:0004C7EA 7028            	  5737:     moveq   #40,D0
02:0004C7EC 41EC00AC        	  5738:     lea     ($00AC,A4),A0
02:0004C7F0 11802000        	  5739:     move.b  D0,(A0,D2.W)
02:0004C7F4 41EC03D0        	  5740:     lea     ($03D0,A4),A0
