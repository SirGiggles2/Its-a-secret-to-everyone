                            	  5774: LayOutDoors:
                            	  5775:     ; Copies the right door face for the direction, type, and state
                            	  5776:     ; of the door to the play area tile map.
                            	  5777:     ;
                            	  5778:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5779:     ; that are not true doors.
                            	  5780:     ;
02:000437EC 7403            	  5781:     moveq   #3,D2
                            	  5782:     even
                            	  5783: L_LayOutDoors_LoopDoors:
                            	  5784:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5785:     ;
02:000437EE 7001            	  5786:     moveq   #1,D0
                            	  5787:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5788:     ;
                            	  5789:     ; [06] indicates whether we're handling the first half of
                            	  5790:     ; the door: Left half for N/S, Top half for E/W.
                            	  5791:     ;
02:000437F0 19400006        	  5792:     move.b  D0,($0006,A4)
                            	  5793:     even
                            	  5794: L_LayOutDoors_LoopHalves:
