                            	  3103: ; Three sets of border coordinates:
                            	  3104: ; - outer OW
                            	  3105: ; - outer UW
                            	  3106: ; - inner
                            	  3107: ;
                            	  3108: ; Within each set, the coordinates are arranged:
                            	  3109: ; down, up, right, left
                            	  3110: ;
                            	  3111:     even
                            	  3112: BorderBounds:
02:00041A8E D6              	  3113:     dc.b    $D6, $45, $E9, $07, $C6, $55, $D9, $17
02:00041A8F 45
02:00041A90 E9
02:00041A91 07
02:00041A92 C6
02:00041A93 55
02:00041A94 D9
02:00041A95 17
