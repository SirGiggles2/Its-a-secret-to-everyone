                            	  2394:     ;
02:0004B098 0C000046        	  2395:     cmpi.b  #$46,D0
02:0004B09C 6530            	  2396:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B09E 0C0000F3        	  2397:     cmpi.b  #$F3,D0
02:0004B0A2 642A            	  2398:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
