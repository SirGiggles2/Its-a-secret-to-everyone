                            	  9673: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9674:     ; At this point, we have a hand that just died.
                            	  9675:     ;
                            	  9676:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9677:     ;
02:0003DC5C 7603            	  9678:     moveq   #3,D3
                            	  9679:     ; Count how many are allocated.
                            	  9680:     ; This includes the current dead one, and the other living ones.
                            	  9681:     ; Store the count in [00].
                            	  9682:     ;
02:0003DC5E 7000            	  9683:     moveq   #0,D0
02:0003DC60 1880            	  9684:     move.b  D0,($0000,A4)
                            	  9685:     even
