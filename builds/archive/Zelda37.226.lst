                            	  1701:     ;
02:0003A2FA 10342070        	  1702:     move.b  ($70,A4,D2.W),D0
02:0003A2FE 023C00EE        	  1703:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A302 123C0008        	  1704:     move.b  #$08,D1
02:0003A306 D101            	  1705:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A308 020000F0        	  1706:     andi.b #$F0,D0
02:0003A30C 19802070        	  1707:     move.b  D0,($70,A4,D2.W)
                            	  1708:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1709:     ;
