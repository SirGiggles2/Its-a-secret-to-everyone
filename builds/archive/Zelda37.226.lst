                            	  6265: _L_z07_UpdateSwordOrRod_Add4:
                            	  6266:     ; Set [00] to (state - 1) * 4:
                            	  6267:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6268:     ;
02:0004CBBE 023C00EE        	  6269:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBC2 123C0004        	  6270:     move.b  #$04,D1
02:0004CBC6 D101            	  6271:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004CBC8 5303            	  6272:     subq.b  #1,D3
02:0004CBCA 66F2            	  6273:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004CBCC 1880            	  6274:     move.b  D0,($0000,A4)
                            	  6275:     ; Set object's direction to player's. It might have changed
                            	  6276:     ; since the last frame.
                            	  6277:     ;
02:0004CBCE 102C0098        	  6278:     move.b  ($0098,A4),D0
02:0004CBD2 41EC0098        	  6279:     lea     ($0098,A4),A0
02:0004CBD6 11802000        	  6280:     move.b  D0,(A0,D2.W)
                            	  6281:     ; Add [00] and the reverse index of the direction to get
                            	  6282:     ; the byte offset of the pixel offset.
                            	  6283:     ;
02:0004CBDA 4EB900030BA4    	  6284:     jsr     GetOppositeDir
02:0004CBE0 1003            	  6285:     move.b  D3,D0
02:0004CBE2 023C00EE        	  6286:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBE6 1214            	  6287:     move.b  ($0000,A4),D1
02:0004CBE8 D101            	  6288:     addx.b  D1,D0   ; ADC $00
02:0004CBEA 7600            	  6289:     moveq   #0,D3
02:0004CBEC 1600            	  6290:     move.b  D0,D3
                            	  6291:     ; Set object's X to player's X + offset for state and direction.
                            	  6292:     ; Copy the result to [00].
                            	  6293:     ;
02:0004CBEE 102C0070        	  6294:     move.b  ($0070,A4),D0
02:0004CBF2 023C00EE        	  6295:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBF6 41F90004CB22    	  6296:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004CBFC 12303000        	  6297:     move.b  (A0,D3.W),D1
