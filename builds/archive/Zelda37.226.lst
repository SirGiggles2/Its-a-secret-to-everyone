02:0002FFD6 0A3C0010        	  2678:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002FFDA 9101            	  2679:     subx.b  D1,D0   ; SBC ObjY,X
02:0002FFDC 0A3C0010        	  2680:     eori    #$10,CCR  ; restore X = 6502 C
