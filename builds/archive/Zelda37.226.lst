02:0002DE34 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DE38 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DE3C 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DE3E 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DE42 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DE44 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DE48 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DE4A 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DE4E 6502            	   212:     bcs.s  __far_z_01_0000
