02:0003AE3A 1214            	  3332:     move.b  ($0000,A4),D1
02:0003AE3C D101            	  3333:     addx.b  D1,D0   ; ADC $00
                            	  3334:     ; Sanitize the Y coordinate:
                            	  3335:     ; (Y AND $F0) OR $D
                            	  3336:     ;
02:0003AE3E 020000F0        	  3337:     andi.b #$F0,D0
02:0003AE42 0000000D        	  3338:     ori.b #$0D,D0
02:0003AE46 41EC0084        	  3339:     lea     ($0084,A4),A0
