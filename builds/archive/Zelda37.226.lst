02:00030E22 41EC0394        	  4866:     lea     ($0394,A4),A0
02:00030E26 11802000        	  4867:     move.b  D0,(A0,D2.W)
02:00030E2A 41EC03A8        	  4868:     lea     ($03A8,A4),A0
02:00030E2E 11802000        	  4869:     move.b  D0,(A0,D2.W)
02:00030E32 7020            	  4870:     moveq   #32,D0
02:00030E34 41EC03BC        	  4871:     lea     ($03BC,A4),A0
02:00030E38 11802000        	  4872:     move.b  D0,(A0,D2.W)
                            	  4873:     ; Activate the fire object. Initial state = $21 (moving fire).
