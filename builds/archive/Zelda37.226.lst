02:0003C580 19410002        	  6562:     move.b  D1,($0002,A4)
02:0003C584 122C0002        	  6563:     move.b  ($0002,A4),D1
02:0003C588 C200            	  6564:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C58A 671E            	  6565:     beq  _L_z04_Digdogger_Move_End
02:0003C58C 41EC0084        	  6566:     lea     ($0084,A4),A0
02:0003C590 10302000        	  6567:     move.b  (A0,D2.W),D0
02:0003C594 122C0003        	  6568:     move.b  ($0003,A4),D1
02:0003C598 0A3C0010        	  6569:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C59C 9101            	  6570:     subx.b  D1,D0   ; SBC $03
02:0003C59E 0A3C0010        	  6571:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5A2 41EC0084        	  6572:     lea     ($0084,A4),A0
