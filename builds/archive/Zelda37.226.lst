                            	  4887: UpdatePeaceTextbox:
                            	  4888:     ; Only emit a character once every 8 frames --
                            	  4889:     ; when (counter [0412] MOD 8) = 4.
                            	  4890:     ;
02:00036556 522C0412        	  4891:     addq.b  #1,($0412,A4)
02:0003655A 102C0412        	  4892:     move.b  ($0412,A4),D0
02:0003655E 02000007        	  4893:     andi.b #$07,D0
02:00036562 0C000004        	  4894:     cmpi.b  #$04,D0
02:00036566 665C            	  4895:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4896:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4897:     ; to the dynamic transfer buf.
                            	  4898:     ;
02:00036568 7604            	  4899:     moveq   #4,D3
                            	  4900: _anon_z02_35:
02:0003656A 41F9000364E6    	  4901:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
