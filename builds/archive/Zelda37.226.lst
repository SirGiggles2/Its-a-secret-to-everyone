02:0004D57C 102C04CD        	  7532:     move.b  ($04CD,A4),D0
02:0004D580 02000008        	  7533:     andi.b #$08,D0
02:0004D584 6700018A        	  7534:     beq  _L_z07_InitObject_NormalSpawn
02:0004D588 41EC034F        	  7535:     lea     ($034F,A4),A0
02:0004D58C 10302000        	  7536:     move.b  (A0,D2.W),D0
02:0004D590 0C000011        	  7537:     cmpi.b  #$11,D0
02:0004D594 6700017A        	  7538:     beq  _L_z07_InitObject_NormalSpawn
02:0004D598 0C000040        	  7539:     cmpi.b  #$40,D0
02:0004D59C 67000172        	  7540:     beq  _L_z07_InitObject_NormalSpawn
02:0004D5A0 0C00001E        	  7541:     cmpi.b  #$1E,D0
02:0004D5A4 6700016A        	  7542:     beq  _L_z07_InitObject_NormalSpawn
02:0004D5A8 0C00002E        	  7543:     cmpi.b  #$2E,D0
02:0004D5AC 67000162        	  7544:     beq  _L_z07_InitObject_NormalSpawn
02:0004D5B0 0C000053        	  7545:     cmpi.b  #$53,D0
02:0004D5B4 6400015A        	  7546:     bcc  _L_z07_InitObject_NormalSpawn
