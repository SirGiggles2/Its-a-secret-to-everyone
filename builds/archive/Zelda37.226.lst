02:0003A9D0 16302000        	  2766:     move.b  (A0,D2.W),D3
02:0003A9D4 41EC0084        	  2767:     lea     ($0084,A4),A0
02:0003A9D8 10302000        	  2768:     move.b  (A0,D2.W),D0
