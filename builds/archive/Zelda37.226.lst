                            	  9740: Manhandla_Move:
                            	  9741:     ; Implement a way of manifesting the fractional part of the speed
                            	  9742:     ; in the movement.
                            	  9743:     ;
                            	  9744:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9745:     ; byte to add to the coordinates, then the effective speed would
                            	  9746:     ; be 1 pixel a frame instead of 1.25.
                            	  9747:     ;
                            	  9748:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9749:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9750:     ;
                            	  9751:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9752:     ;
                            	  9753:     ;   SA := SA + (SL AND $E0)
                            	  9754:     ;   [03] := SH + carry
                            	  9755:     ;
                            	  9756:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9757:     ;
02:0003DCA8 41EC041F        	  9758:     lea     ($041F,A4),A0
02:0003DCAC 10302000        	  9759:     move.b  (A0,D2.W),D0
02:0003DCB0 020000E0        	  9760:     andi.b #$E0,D0
02:0003DCB4 023C00EE        	  9761:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCB8 41EC0412        	  9762:     lea     ($0412,A4),A0
02:0003DCBC 12302000        	  9763:     move.b  (A0,D2.W),D1
02:0003DCC0 D101            	  9764:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DCC2 41EC0412        	  9765:     lea     ($0412,A4),A0
02:0003DCC6 11802000        	  9766:     move.b  D0,(A0,D2.W)
                            	  9767:     ; Assign (high speed byte + carry) to [03].
                            	  9768:     ;
02:0003DCCA 41EC042C        	  9769:     lea     ($042C,A4),A0
02:0003DCCE 10302000        	  9770:     move.b  (A0,D2.W),D0
02:0003DCD2 123C0000        	  9771:     move.b  #$00,D1
02:0003DCD6 D101            	  9772:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCD8 19400003        	  9773:     move.b  D0,($0003,A4)
                            	  9774:     ; Change coordinates by the speed amount/offset in [03]
                            	  9775:     ; according to the direction.
                            	  9776:     ;
                            	  9777:     ; Start with a mask of $A1 in [02]:
                            	  9778:     ; - low nibble represents the right direction
                            	  9779:     ; - high nibble is used to set or clear carry as we go along
                            	  9780:     ;
02:0003DCDC 103C00A1        	  9781:     move.b  #$A1,D0
02:0003DCE0 19400002        	  9782:     move.b  D0,($0002,A4)
                            	  9783:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9784:     ;
02:0003DCE4 41EC0098        	  9785:     lea     ($0098,A4),A0
02:0003DCE8 10302000        	  9786:     move.b  (A0,D2.W),D0
02:0003DCEC 122C0002        	  9787:     move.b  ($0002,A4),D1
02:0003DCF0 C200            	  9788:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCF2 6712            	  9789:     beq  _L_z04_Manhandla_Move_Left
02:0003DCF4 10342070        	  9790:     move.b  ($70,A4,D2.W),D0
02:0003DCF8 023C00EE        	  9791:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCFC 122C0003        	  9792:     move.b  ($0003,A4),D1
02:0003DD00 D101            	  9793:     addx.b  D1,D0   ; ADC $03
02:0003DD02 19802070        	  9794:     move.b  D0,($70,A4,D2.W)
                            	  9795:     even
                            	  9796: _L_z04_Manhandla_Move_Left:
                            	  9797:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9798:     ;
02:0003DD06 41EC0098        	  9799:     lea     ($0098,A4),A0
02:0003DD0A 10302000        	  9800:     move.b  (A0,D2.W),D0
02:0003DD0E 122C0002        	  9801:     move.b  ($0002,A4),D1
02:0003DD12 E309            	  9802:     lsl.b  #1,D1   ; ASL $02
02:0003DD14 19410002        	  9803:     move.b  D1,($0002,A4)
02:0003DD18 122C0002        	  9804:     move.b  ($0002,A4),D1
02:0003DD1C C200            	  9805:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD1E 6716            	  9806:     beq  _L_z04_Manhandla_Move_Down
02:0003DD20 10342070        	  9807:     move.b  ($70,A4,D2.W),D0
02:0003DD24 122C0003        	  9808:     move.b  ($0003,A4),D1
02:0003DD28 0A3C0010        	  9809:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD2C 9101            	  9810:     subx.b  D1,D0   ; SBC $03
02:0003DD2E 0A3C0010        	  9811:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD32 19802070        	  9812:     move.b  D0,($70,A4,D2.W)
                            	  9813:     even
                            	  9814: _L_z04_Manhandla_Move_Down:
                            	  9815:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9816:     ;
02:0003DD36 41EC0098        	  9817:     lea     ($0098,A4),A0
02:0003DD3A 10302000        	  9818:     move.b  (A0,D2.W),D0
02:0003DD3E 122C0002        	  9819:     move.b  ($0002,A4),D1
02:0003DD42 E309            	  9820:     lsl.b  #1,D1   ; ASL $02
02:0003DD44 19410002        	  9821:     move.b  D1,($0002,A4)
02:0003DD48 122C0002        	  9822:     move.b  ($0002,A4),D1
02:0003DD4C C200            	  9823:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD4E 6716            	  9824:     beq  _L_z04_Manhandla_Move_Up
02:0003DD50 41EC0084        	  9825:     lea     ($0084,A4),A0
02:0003DD54 10302000        	  9826:     move.b  (A0,D2.W),D0
02:0003DD58 122C0003        	  9827:     move.b  ($0003,A4),D1
02:0003DD5C D101            	  9828:     addx.b  D1,D0   ; ADC $03
02:0003DD5E 41EC0084        	  9829:     lea     ($0084,A4),A0
02:0003DD62 11802000        	  9830:     move.b  D0,(A0,D2.W)
                            	  9831:     even
                            	  9832: _L_z04_Manhandla_Move_Up:
                            	  9833:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9834:     ;
02:0003DD66 41EC0098        	  9835:     lea     ($0098,A4),A0
02:0003DD6A 10302000        	  9836:     move.b  (A0,D2.W),D0
02:0003DD6E 122C0002        	  9837:     move.b  ($0002,A4),D1
02:0003DD72 E309            	  9838:     lsl.b  #1,D1   ; ASL $02
02:0003DD74 19410002        	  9839:     move.b  D1,($0002,A4)
02:0003DD78 122C0002        	  9840:     move.b  ($0002,A4),D1
02:0003DD7C C200            	  9841:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD7E 671E            	  9842:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD80 41EC0084        	  9843:     lea     ($0084,A4),A0
02:0003DD84 10302000        	  9844:     move.b  (A0,D2.W),D0
02:0003DD88 122C0003        	  9845:     move.b  ($0003,A4),D1
02:0003DD8C 0A3C0010        	  9846:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD90 9101            	  9847:     subx.b  D1,D0   ; SBC $03
02:0003DD92 0A3C0010        	  9848:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD96 41EC0084        	  9849:     lea     ($0084,A4),A0
02:0003DD9A 11802000        	  9850:     move.b  D0,(A0,D2.W)
                            	  9851:     even
                            	  9852: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9853:     ; To the frame accumulator, add:
                            	  9854:     ; - a random value between 0 and 3
                            	  9855:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9856:     ;
02:0003DD9E 10342019        	  9857:     move.b  ($19,A4,D2.W),D0
02:0003DDA2 02000003        	  9858:     andi.b #$03,D0
02:0003DDA6 023C00EE        	  9859:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDAA 122C0003        	  9860:     move.b  ($0003,A4),D1
02:0003DDAE D101            	  9861:     addx.b  D1,D0   ; ADC $03
02:0003DDB0 41EC0451        	  9862:     lea     ($0451,A4),A0
02:0003DDB4 12302000        	  9863:     move.b  (A0,D2.W),D1
02:0003DDB8 D101            	  9864:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DDBA 41EC0451        	  9865:     lea     ($0451,A4),A0
02:0003DDBE 11802000        	  9866:     move.b  D0,(A0,D2.W)
02:0003DDC2 61001EB8        	  9867:     jsr     BoundFlyer
                            	  9868:     ; TODO:
                            	  9869:     ; I don't see why this is needed.
