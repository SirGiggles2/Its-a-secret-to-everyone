                            	   421: UpdateMenuActive:
02:00040256 6100535E        	   422:     jsr     DrawSubmenuItems
02:0004025A 61005422        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:0004025E 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:00040262 02000088        	   430:     andi.b #$88,D0
02:00040266 0C000088        	   431:     cmpi.b  #$88,D0
02:0004026A 661A            	   432:     bne  _anon_z05_3
02:0004026C 4EB90004B58C    	   433:     jsr     EndGameMode
02:00040272 194000E1        	   434:     move.b  D0,($00E1,A4)
02:00040276 7008            	   435:     moveq   #8,D0
02:00040278 19400012        	   436:     move.b  D0,($0012,A4)
02:0004027C 7000            	   437:     moveq   #0,D0
02:0004027E 19400619        	   438:     move.b  D0,($0619,A4)
02:00040282 60001356        	   439:     jmp     SilenceSound
