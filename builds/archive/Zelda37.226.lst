                            	  5902: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5903:     ; For opened doors, the provisional door face has become:
                            	  5904:     ;
                            	  5905:     ; DA PF Meaning
                            	  5906:     ; -------------
                            	  5907:     ; 0  4  open
                            	  5908:     ; 1  1  wall
                            	  5909:     ; 2  2  false wall
                            	  5910:     ; 3  3  false wall 2
                            	  5911:     ; 4  9  bombable
                            	  5912:     ; 5  4  key
                            	  5913:     ; 6  4  key 2
                            	  5914:     ; 7  4  shutter
