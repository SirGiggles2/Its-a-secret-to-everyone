                            	  5154: DrawCredits:
                            	  5155:     ; Make a transfer record of a full row of blank tiles.
                            	  5156:     ;
02:000368E4 761F            	  5157:     moveq   #31,D3
02:000368E6 7024            	  5158:     moveq   #36,D0
                            	  5159: _anon_z02_41:
02:000368E8 41EC0305        	  5160:     lea     ($0305,A4),A0
02:000368EC 11803000        	  5161:     move.b  D0,(A0,D3.W)
02:000368F0 5303            	  5162:     subq.b  #1,D3
02:000368F2 6AF4            	  5163:     bpl  _anon_z02_41
                            	  5164:     ; No wall tiles go in row 0.
                            	  5165:     ;
02:000368F4 102C050A        	  5166:     move.b  ($050A,A4),D0
02:000368F8 672C            	  5167:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5168:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5169:     ; Rows 2 to $2D get side walls.
                            	  5170:     ;
02:000368FA 0C000001        	  5171:     cmpi.b  #$01,D0
02:000368FE 6708            	  5172:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036900 0C00002E        	  5173:     cmpi.b  #$2E,D0
02:00036904 6514            	  5174:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00036906 661E            	  5175:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5176:     even
                            	  5177: _L_z02_DrawCredits_WriteHorizontalWalls:
02:00036908 7619            	  5178:     moveq   #25,D3
02:0003690A 103C00FA        	  5179:     move.b  #$FA,D0
                            	  5180: _anon_z02_42:
02:0003690E 41EC0308        	  5181:     lea     ($0308,A4),A0
02:00036912 11803000        	  5182:     move.b  D0,(A0,D3.W)
02:00036916 5303            	  5183:     subq.b  #1,D3
02:00036918 6AF4            	  5184:     bpl  _anon_z02_42
                            	  5185:     even
                            	  5186: _L_z02_DrawCredits_WriteSideWalls:
02:0003691A 103C00FA        	  5187:     move.b  #$FA,D0
02:0003691E 19400308        	  5188:     move.b  D0,($0308,A4)
02:00036922 19400321        	  5189:     move.b  D0,($0321,A4)
                            	  5190:     even
                            	  5191: _L_z02_DrawCredits_TerminateRecords:
                            	  5192:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5193:     ; attributes or only tiles.
                            	  5194:     ;
02:00036926 103C00FF        	  5195:     move.b  #$FF,D0
02:0003692A 19400325        	  5196:     move.b  D0,($0325,A4)
02:0003692E 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:00036932 7020            	  5200:     moveq   #32,D0
02:00036934 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:00036938 7400            	  5204:     moveq   #0,D2
02:0003693A 142C050C        	  5205:     move.b  ($050C,A4),D2
02:0003693E 41F9000366E4    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:00036944 10302000        	  5207:     move.b  (A0,D2.W),D0
02:00036948 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:0003694C 102C050D        	  5211:     move.b  ($050D,A4),D0
02:00036950 7600            	  5212:     moveq   #0,D3
02:00036952 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:00036954 E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:00036956 E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:00036958 E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:0003695A E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:0003695C E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:0003695E 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:00036962 41F9000366F0    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:00036968 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
                            	  5228:     ; to get the bit that indicates whether this line has text.
                            	  5229:     ;
02:0003696C E308            	  5230:     lsl.b  #1,D0   ; ASL A
02:0003696E 5303            	  5231:     subq.b  #1,D3
02:00036970 6AFA            	  5232:     bpl  _anon_z02_43
02:00036972 6400013E        	  5233:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5234:     ; The mask inidcates that it should have text.
                            	  5235:     ; But if line index >= $17, then it doesn't.
                            	  5236:     ;
02:00036976 7600            	  5237:     moveq   #0,D3
02:00036978 162C050E        	  5238:     move.b  ($050E,A4),D3
02:0003697C 0C030017        	  5239:     cmpi.b  #$17,D3
02:00036980 64000130        	  5240:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5241:     ; In the first quest, don't consider line numbers >= $10.
                            	  5242:     ;
02:00036984 7400            	  5243:     moveq   #0,D2
02:00036986 142C0016        	  5244:     move.b  ($0016,A4),D2
02:0003698A 41EC062D        	  5245:     lea     ($062D,A4),A0
02:0003698E 10302000        	  5246:     move.b  (A0,D2.W),D0
02:00036992 6608            	  5247:     bne  _anon_z02_44
02:00036994 0C030010        	  5248:     cmpi.b  #$10,D3
02:00036998 64000114        	  5249:     bcc  _L_z02_DrawCredits_IncLine
                            	  5250: _anon_z02_44:
02:0003699C 7400            	  5251:     moveq   #0,D2
02:0003699E 142C0016        	  5252:     move.b  ($0016,A4),D2
02:000369A2 41EC062D        	  5253:     lea     ($062D,A4),A0
02:000369A6 10302000        	  5254:     move.b  (A0,D2.W),D0
                            	  5255:     ; In the second quest, skip lines $C to $F.
                            	  5256:     ;
