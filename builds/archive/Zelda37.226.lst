02:00036574 41EC0302        	  4903:     lea     ($0302,A4),A0
02:00036578 11803000        	  4904:     move.b  D0,(A0,D3.W)
02:0003657C 5303            	  4905:     subq.b  #1,D3
02:0003657E 6AEA            	  4906:     bpl  _anon_z02_35
                            	  4907:     ; Load a character from the string and copy it to
                            	  4908:     ; the transfer record until we read character $FF.
                            	  4909:     ;
02:00036580 7600            	  4910:     moveq   #0,D3
02:00036582 162C0413        	  4911:     move.b  ($0413,A4),D3
02:00036586 41F900036520    	  4912:     lea     (PeaceText).l,A0
02:0003658C 10303000        	  4913:     move.b  (A0,D3.W),D0
02:00036590 0C0000FF        	  4914:     cmpi.b  #$FF,D0
02:00036594 6730            	  4915:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00036596 19400305        	  4916:     move.b  D0,($0305,A4)
                            	  4917:     ; A regular space takes as much time to emit as any character.
                            	  4918:     ; But it makes no sound.
                            	  4919:     ;
02:0003659A 0C000024        	  4920:     cmpi.b  #$24,D0
02:0003659E 6706            	  4921:     beq  _anon_z02_36
02:000365A0 7010            	  4922:     moveq   #16,D0
02:000365A2 19400604        	  4923:     move.b  D0,($0604,A4)
                            	  4924: _anon_z02_36:
                            	  4925:     ; Point to the next character in the string.
                            	  4926:     ;
02:000365A6 522C0413        	  4927:     addq.b  #1,($0413,A4)
                            	  4928:     ; Replace the low byte of the VRAM address with the one
                            	  4929:     ; where the next character should be written.
                            	  4930:     ;
02:000365AA 41F9000364EC    	  4931:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000365B0 10303000        	  4932:     move.b  (A0,D3.W),D0
02:000365B4 19400303        	  4933:     move.b  D0,($0303,A4)
                            	  4934:     ; Once the low VRAM address rolls over,
                            	  4935:     ; increment the high address.
                            	  4936:     ;
02:000365B8 0C0000A0        	  4937:     cmpi.b  #$A0,D0
02:000365BC 6406            	  4938:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000365BE 7023            	  4939:     moveq   #35,D0
