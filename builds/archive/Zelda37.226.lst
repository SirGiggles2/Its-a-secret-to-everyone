                            	  7917: _L_z04_UpdatePolsVoice_SetState1:
                            	  7918:     ; If already in state 1, then go draw and check collisions.
                            	  7919:     ;
02:0003CEF2 41EC00AC        	  7920:     lea     ($00AC,A4),A0
02:0003CEF6 10302000        	  7921:     move.b  (A0,D2.W),D0
02:0003CEFA 6702            	  7922:     beq.s  __far_z_04_0074
02:0003CEFC 6068            	  7923:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7924: __far_z_04_0074:
                            	  7925:     ; Go to state 1.
                            	  7926:     ;
02:0003CEFE 41EC00AC        	  7927:     lea     ($00AC,A4),A0
02:0003CF02 52302000        	  7928:     addq.b  #1,(A0,D2.W)
                            	  7929:     ; Subtract 1 from facing direction to make an index.
                            	  7930:     ;
02:0003CF06 7600            	  7931:     moveq   #0,D3
02:0003CF08 41EC0098        	  7932:     lea     ($0098,A4),A0
02:0003CF0C 16302000        	  7933:     move.b  (A0,D2.W),D3
02:0003CF10 5303            	  7934:     subq.b  #1,D3
                            	  7935:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7936:     ;
02:0003CF12 41EC0084        	  7937:     lea     ($0084,A4),A0
02:0003CF16 10302000        	  7938:     move.b  (A0,D2.W),D0
02:0003CF1A 0C000078        	  7939:     cmpi.b  #$78,D0
02:0003CF1E 6402            	  7940:     bcc  _anon_z04_97
02:0003CF20 7603            	  7941:     moveq   #3,D3
                            	  7942: _anon_z04_97:
                            	  7943:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7944:     ;
02:0003CF22 0C0000A8        	  7945:     cmpi.b  #$A8,D0
02:0003CF26 6502            	  7946:     bcs  _anon_z04_98
02:0003CF28 7607            	  7947:     moveq   #7,D3
                            	  7948: _anon_z04_98:
                            	  7949:     ; Set the vertical speed for the beginning of the jump.
                            	  7950:     ;
02:0003CF2A 41F90003CE1E    	  7951:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF30 10303000        	  7952:     move.b  (A0,D3.W),D0
02:0003CF34 41EC0412        	  7953:     lea     ($0412,A4),A0
02:0003CF38 11802000        	  7954:     move.b  D0,(A0,D2.W)
                            	  7955:     ; Look up the Y offset for the current direction.
                            	  7956:     ; Add it to object Y to set the destination Y of the jump.
                            	  7957:     ;
02:0003CF3C 41EC0084        	  7958:     lea     ($0084,A4),A0
02:0003CF40 10302000        	  7959:     move.b  (A0,D2.W),D0
02:0003CF44 023C00EE        	  7960:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF48 41F90003CE26    	  7961:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF4E 12303000        	  7962:     move.b  (A0,D3.W),D1
02:0003CF52 D101            	  7963:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF54 41EC042C        	  7964:     lea     ($042C,A4),A0
02:0003CF58 11802000        	  7965:     move.b  D0,(A0,D2.W)
                            	  7966:     ; Turn the index into a direction again by adding 1.
                            	  7967:     ; Store the facing direction.
                            	  7968:     ;
02:0003CF5C 5203            	  7969:     addq.b  #1,D3
02:0003CF5E 41EC0098        	  7970:     lea     ($0098,A4),A0
02:0003CF62 11832000        	  7971:     move.b  D3,(A0,D2.W)
                            	  7972:     even
                            	  7973: L_PolsVoice_DrawAndCheckCollisions:
