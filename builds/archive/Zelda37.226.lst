                            	  4582:     ; return the speed index (angle) we have.
                            	  4583:     ;
02:00030C76 102C0003        	  4584:     move.b  ($0003,A4),D0
02:00030C7A 003C0011        	  4585:     ori     #$11,CCR  ; SEC: set C+X
02:00030C7E 122C0004        	  4586:     move.b  ($0004,A4),D1
02:00030C82 0A3C0010        	  4587:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C86 9101            	  4588:     subx.b  D1,D0   ; SBC $04
02:00030C88 0A3C0010        	  4589:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C8C 0C000008        	  4590:     cmpi.b  #$08,D0
02:00030C90 6538            	  4591:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4592:     even
                            	  4593: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4594:     ; TODO: call it speed index or angle?
                            	  4595:     ; Otherwise, go to the next speed index (angle).
                            	  4596:     ;
02:00030C92 1014            	  4597:     move.b  ($0000,A4),D0
02:00030C94 023C00EE        	  4598:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030C98 122C0001        	  4599:     move.b  ($0001,A4),D1
02:00030C9C D101            	  4600:     addx.b  D1,D0   ; ADC $01
02:00030C9E 1880            	  4601:     move.b  D0,($0000,A4)
                            	  4602:     ; TODO: call it speed index or angle?
                            	  4603:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4604:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4605:     ;
02:00030CA0 6728            	  4606:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030CA2 0C000008        	  4607:     cmpi.b  #$08,D0
02:00030CA6 6722            	  4608:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4609:     ; Subtract the lesser distance from the greater distance.
                            	  4610:     ; If they still haven't crossed, then we can turn more.
                            	  4611:     ;
02:00030CA8 102C0003        	  4612:     move.b  ($0003,A4),D0
02:00030CAC 003C0011        	  4613:     ori     #$11,CCR  ; SEC: set C+X
02:00030CB0 122C0004        	  4614:     move.b  ($0004,A4),D1
02:00030CB4 0A3C0010        	  4615:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030CB8 9101            	  4616:     subx.b  D1,D0   ; SBC $04
02:00030CBA 0A3C0010        	  4617:     eori    #$10,CCR  ; restore X = 6502 C
02:00030CBE 19400003        	  4618:     move.b  D0,($0003,A4)
02:00030CC2 122C0004        	  4619:     move.b  ($0004,A4),D1
02:00030CC6 B001            	  4620:     cmp.b   D1,D0
02:00030CC8 64C8            	  4621:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4622:     even
