02:0003C2DC 41EC0478        	  6267:     lea     ($0478,A4),A0
02:0003C2E0 16302000        	  6268:     move.b  (A0,D2.W),D3
                            	  6269:     ; Change the coordinates to one corner.
                            	  6270:     ;
02:0003C2E4 10342070        	  6271:     move.b  ($70,A4,D2.W),D0
02:0003C2E8 023C00EE        	  6272:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2EC 41F90003C1A0    	  6273:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C2F2 12303000        	  6274:     move.b  (A0,D3.W),D1
