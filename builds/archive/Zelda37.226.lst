                            	  1815: Gel_MoveSplitting:
02:0003A3C8 103C00FF        	  1816:     move.b  #$FF,D0
02:0003A3CC 41EC03BC        	  1817:     lea     ($03BC,A4),A0
02:0003A3D0 11802000        	  1818:     move.b  D0,(A0,D2.W)
                            	  1819:     ; Set moving direction to facing direction.
                            	  1820:     ;
02:0003A3D4 41EC0098        	  1821:     lea     ($0098,A4),A0
02:0003A3D8 10302000        	  1822:     move.b  (A0,D2.W),D0
02:0003A3DC 1940000F        	  1823:     move.b  D0,($000F,A4)
                            	  1824:     ; If at a tile boundary, then check for a tile collision.
                            	  1825:     ;
02:0003A3E0 41EC0394        	  1826:     lea     ($0394,A4),A0
02:0003A3E4 10302000        	  1827:     move.b  (A0,D2.W),D0
02:0003A3E8 660E            	  1828:     bne  _L_z04_Gel_MoveSplitting_CheckRoomBoundary
02:0003A3EA 4EB90004B91A    	  1829:     jsr     GetCollidingTileMoving
                            	  1830:     ; If blocked by a tile, then return C=1.
                            	  1831:     ;
02:0003A3F0 122C034A        	  1832:     move.b  ($034A,A4),D1
02:0003A3F4 B001            	  1833:     cmp.b   D1,D0
02:0003A3F6 642C            	  1834:     bcc  _L_z04_Gel_MoveSplitting_Exit
