02:0003C032 41EC0485        	  5811:     lea     ($0485,A4),A0
02:0003C036 11802000        	  5812:     move.b  D0,(A0,D2.W)
02:0003C03A 6100062A        	  5813:     jsr     CheckBossHitReaction
                            	  5814:     ; Look for the tail segment, starting from the low end
