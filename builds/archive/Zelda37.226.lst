02:000422CA 6616            	  4280:     bne  _anon_z05_94
                            	  4281:     ; If the opposite of the facing direction is part of the input direction, then
                            	  4282:     ; face the opposite direction.
                            	  4283:     ;
02:000422CC 102C0098        	  4284:     move.b  ($0098,A4),D0
