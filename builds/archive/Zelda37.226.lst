                            	  5441: 
                            	  5442: ; Params:
                            	  5443: ; [02]: bitmask for target door.
                            	  5444: ;
                            	  5445: ; Returns:
                            	  5446: ; A: door attribute for desired direction in current room.
                            	  5447: ; [01]: same as [02] if found; $10 otherwise
                            	  5448: ; [03]: reverse direction index
                            	  5449: ;
                            	  5450: ; Door bits:
                            	  5451: ; 1: E
                            	  5452: ; 2: W
                            	  5453: ; 4: S
                            	  5454: ; 8: N
                            	  5455: ;
                            	  5456: ;
                            	  5457: ; Start with single-bit mask 1.
                            	  5458:     even
                            	  5459: FindDoorAttrByDoorBit:
