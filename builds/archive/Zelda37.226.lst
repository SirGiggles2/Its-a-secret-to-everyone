02:0003A246 41EC0084        	  1590:     lea     ($0084,A4),A0
02:0003A24A 10302000        	  1591:     move.b  (A0,D2.W),D0
02:0003A24E 0200000F        	  1592:     andi.b #$0F,D0
02:0003A252 0C00000D        	  1593:     cmpi.b  #$0D,D0
02:0003A256 6602            	  1594:     bne  _anon_z04_26
02:0003A258 7603            	  1595:     moveq   #3,D3
                            	  1596: _anon_z04_26:
02:0003A25A 1883            	  1597:     move.b  D3,($0000,A4)
                            	  1598:     ; If horizontally aligned with the square grid, then
                            	  1599:     ; use a vertical direction mask ($C).
                            	  1600:     ;
02:0003A25C 7600            	  1601:     moveq   #0,D3
02:0003A25E 10342070        	  1602:     move.b  ($70,A4,D2.W),D0
02:0003A262 0200000F        	  1603:     andi.b #$0F,D0
02:0003A266 6602            	  1604:     bne  _anon_z04_27
02:0003A268 760C            	  1605:     moveq   #12,D3
                            	  1606: _anon_z04_27:
02:0003A26A 1003            	  1607:     move.b  D3,D0
                            	  1608:     ; Combine the two masks. At most one will be 0.
                            	  1609:     ;
02:0003A26C 1214            	  1610:     move.b  ($0000,A4),D1
02:0003A26E 8001            	  1611:     or.b  D1,D0
                            	  1612:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1613:     ; with the grid.
                            	  1614:     ;
                            	  1615:     ; If so, then go to state 1 to do a "big shove".
                            	  1616:     ; Else go to state 2, to immediately split in two.
                            	  1617:     ;
                            	  1618:     ; Examples:
                            	  1619:     ; It would be aligned, if moving left along a tile as usual.
                            	  1620:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1621:     ; - The collision check routines would have made the zol
                            	  1622:     ;   face in the direction of the weapon.
                            	  1623:     ; - See CheckMonsterWeaponCollision.
                            	  1624:     ;
02:0003A270 122C0098        	  1625:     move.b  ($0098,A4),D1
02:0003A274 C001            	  1626:     and.b  D1,D0
02:0003A276 6608            	  1627:     bne  _anon_z04_28
02:0003A278 41EC00AC        	  1628:     lea     ($00AC,A4),A0
02:0003A27C 52302000        	  1629:     addq.b  #1,(A0,D2.W)
