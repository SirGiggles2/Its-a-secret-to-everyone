                            	  5983:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5984:     ;
02:0003C11E 41EC03BC        	  5985:     lea     ($03BC,A4),A0
02:0003C122 10302000        	  5986:     move.b  (A0,D2.W),D0
02:0003C126 6712            	  5987:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C128 41EC0098        	  5988:     lea     ($0098,A4),A0
02:0003C12C 11802000        	  5989:     move.b  D0,(A0,D2.W)
02:0003C130 7000            	  5990:     moveq   #0,D0
