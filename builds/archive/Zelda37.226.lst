02:0004B03A 4EB9000314C8    	  2353:     jsr     MapScreenPosToPpuAddr
02:0004B040 7400            	  2354:     moveq   #0,D2
02:0004B042 142C0301        	  2355:     move.b  ($0301,A4),D2
                            	  2356:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2357:     ;
                            	  2358:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2359:     ; In total, 11 bytes will be written.
                            	  2360:     ;
                            	  2361:     ; First, write the high byte of PPU address in each record.
                            	  2362:     ;
02:0004B046 1014            	  2363:     move.b  ($0000,A4),D0
02:0004B048 41EC0302        	  2364:     lea     ($0302,A4),A0
02:0004B04C 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:0004B050 41EC0307        	  2366:     lea     ($0307,A4),A0
02:0004B054 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; Write the low address in the first record. In the second record,
                            	  2369:     ; write (low address + 1).
                            	  2370:     ;
02:0004B058 102C0001        	  2371:     move.b  ($0001,A4),D0
02:0004B05C 41EC0303        	  2372:     lea     ($0303,A4),A0
02:0004B060 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B064 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B068 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004B06C 41EC0308        	  2376:     lea     ($0308,A4),A0
02:0004B070 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     ; Write the first tile twice in each record. Patch them later.
                            	  2379:     ;
02:0004B074 102C0005        	  2380:     move.b  ($0005,A4),D0
02:0004B078 41EC0305        	  2381:     lea     ($0305,A4),A0
02:0004B07C 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B080 41EC0306        	  2383:     lea     ($0306,A4),A0
02:0004B084 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B088 41EC030A        	  2385:     lea     ($030A,A4),A0
02:0004B08C 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004B090 41EC030B        	  2387:     lea     ($030B,A4),A0
02:0004B094 11802000        	  2388:     move.b  D0,(A0,D2.W)
                            	  2389:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2390:     ; Add 1 more to the second byte in each record.
                            	  2391:     ; Here is an example result of this manipulation:
