                            	  6858: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6859:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6860:     ;   full heart=4 partial heart=$70
                            	  6861:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6862:     ; But the method here yields $3EF, because partial heart is
                            	  6863:     ; considered full when = $FF instead of $100.
                            	  6864:     ;
02:00031DE0 102C000E        	  6865:     move.b  ($000E,A4),D0
02:00031DE4 003C0011        	  6866:     ori     #$11,CCR  ; SEC: set C+X
02:00031DE8 122C0670        	  6867:     move.b  ($0670,A4),D1
02:00031DEC 0A3C0010        	  6868:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031DF0 9101            	  6869:     subx.b  D1,D0   ; SBC HeartPartial
02:00031DF2 0A3C0010        	  6870:     eori    #$10,CCR  ; restore X = 6502 C
02:00031DF6 1940000E        	  6871:     move.b  D0,($000E,A4)
02:00031DFA 102C066F        	  6872:     move.b  ($066F,A4),D0
02:00031DFE 0200000F        	  6873:     andi.b #$0F,D0
02:00031E02 6710            	  6874:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031E04 532C066F        	  6875:     subq.b  #1,($066F,A4)
02:00031E08 103C00FF        	  6876:     move.b  #$FF,D0
02:00031E0C 19400670        	  6877:     move.b  D0,($0670,A4)
02:00031E10 6600FF6E        	  6878:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6879:     even
                            	  6880: _L_z01_Link_BeHarmed_HandleDied:
                            	  6881:     ; Link died.
                            	  6882:     ;
                            	  6883:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6884:     ; Make Link face down.
                            	  6885:     ; Go to mode $11.
                            	  6886:     ;
02:00031E14 102C066F        	  6887:     move.b  ($066F,A4),D0
02:00031E18 020000F0        	  6888:     andi.b #$F0,D0
02:00031E1C 1940066F        	  6889:     move.b  D0,($066F,A4)
02:00031E20 4EB90004B58C    	  6890:     jsr     EndGameMode
02:00031E26 19400670        	  6891:     move.b  D0,($0670,A4)
02:00031E2A 194000AC        	  6892:     move.b  D0,($00AC,A4)
02:00031E2E 7011            	  6893:     moveq   #17,D0
02:00031E30 19400012        	  6894:     move.b  D0,($0012,A4)
02:00031E34 7004            	  6895:     moveq   #4,D0
02:00031E36 19400098        	  6896:     move.b  D0,($0098,A4)
                            	  6897: _anon_z01_87:
02:00031E3A 4E75            	  6898:     rts
                            	  6899: 
                            	  6900: ; Params:
                            	  6901: ; X: monster slot
                            	  6902: ; Y: weapon slot
                            	  6903: ; [02]: monster mid X
                            	  6904: ; [03]: monster mid Y
                            	  6905: ;
                            	  6906: ; Returns:
                            	  6907: ; [00]: weapon slot
                            	  6908: ;
                            	  6909: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6910: ;
                            	  6911:     even
                            	  6912: CheckMonsterBoomerangOrFoodCollision:
02:00031E3C 41EC00AC        	  6913:     lea     ($00AC,A4),A0
02:00031E40 10303000        	  6914:     move.b  (A0,D3.W),D0
02:00031E44 E308            	  6915:     lsl.b  #1,D0   ; ASL A
02:00031E46 65F2            	  6916:     bcs  _anon_z01_87
02:00031E48 1883            	  6917:     move.b  D3,($0000,A4)
                            	  6918:     ; Set boomerang damage type (2) in [09].
                            	  6919:     ;
02:00031E4A 7002            	  6920:     moveq   #2,D0
02:00031E4C 19400009        	  6921:     move.b  D0,($0009,A4)
                            	  6922:     ; Set collision threshold $A in both axes.
                            	  6923:     ;
02:00031E50 700A            	  6924:     moveq   #10,D0
02:00031E52 1940000D        	  6925:     move.b  D0,($000D,A4)
02:00031E56 1940000E        	  6926:     move.b  D0,($000E,A4)
                            	  6927:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6928:     ;
02:00031E5A 10343070        	  6929:     move.b  ($70,A4,D3.W),D0
02:00031E5E 023C00EE        	  6930:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E62 123C0004        	  6931:     move.b  #$04,D1
02:00031E66 D101            	  6932:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031E68 19400004        	  6933:     move.b  D0,($0004,A4)
                            	  6934:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6935:     ;
02:00031E6C 41EC0084        	  6936:     lea     ($0084,A4),A0
02:00031E70 10303000        	  6937:     move.b  (A0,D3.W),D0
02:00031E74 023C00EE        	  6938:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E78 123C0008        	  6939:     move.b  #$08,D1
02:00031E7C D101            	  6940:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6941: ; Params:
                            	  6942: ; A: weapon object mid Y
                            	  6943: ; X: monster object slot
                            	  6944: ; Y: weapon object slot
                            	  6945: ; [00]: weapon object slot
                            	  6946: ; [02]: monster object mid X
                            	  6947: ; [03]: monster object mid Y
                            	  6948: ; [04]: weapon object mid X
                            	  6949: ; [07]: damage points
                            	  6950: ; [09]: damage type
                            	  6951: ; [0D]: horizontal threshold
                            	  6952: ; [0E]: vertical threshold
                            	  6953: ;
                            	  6954: ; Returns:
                            	  6955: ; [06]: 1 if objects collide
                            	  6956: ;
                            	  6957:     even
                            	  6958: CheckMonsterWeaponCollision:
02:00031E7E 19400005        	  6959:     move.b  D0,($0005,A4)
                            	  6960:     ; Reset [06] for no collision.
                            	  6961:     ;
02:00031E82 7000            	  6962:     moveq   #0,D0
02:00031E84 19400006        	  6963:     move.b  D0,($0006,A4)
                            	  6964:     ; If the weapon's not active (state = 0), then return.
                            	  6965:     ;
02:00031E88 7600            	  6966:     moveq   #0,D3
02:00031E8A 1614            	  6967:     move.b  ($0000,A4),D3
02:00031E8C 41EC00AC        	  6968:     lea     ($00AC,A4),A0
02:00031E90 10303000        	  6969:     move.b  (A0,D3.W),D0
02:00031E94 6604            	  6970:     bne.s  __far_z_01_0071
02:00031E96 6000010C        	  6971:     jmp  L74D8_Exit
