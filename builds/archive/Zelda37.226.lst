02:00034D8A 5302            	  2569:     subq.b  #1,D2
02:00034D8C 5303            	  2570:     subq.b  #1,D3
02:00034D8E 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034D90 522C0420        	  2572:     addq.b  #1,($0420,A4)
