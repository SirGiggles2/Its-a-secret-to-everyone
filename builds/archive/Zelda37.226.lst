02:0004C50E 0C0000FC        	  5308:     cmpi.b  #$FC,D0
02:0004C512 6466            	  5309:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C514 003C0011        	  5310:     ori     #$11,CCR  ; SEC: set C+X
02:0004C518 12342070        	  5311:     move.b  ($70,A4,D2.W),D1
