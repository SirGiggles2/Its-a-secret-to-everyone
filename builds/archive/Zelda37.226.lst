02:00041AA4 1880            	  3122:     move.b  D0,($0000,A4)
                            	  3123:     ; Call GetOppositeDir again to use this mapping:
                            	  3124:     ; In Dir: 1 2 4 8
                            	  3125:     ;         -------
                            	  3126:     ; Index:  2 3 0 1
                            	  3127:     ;
02:00041AA6 4EB900030BA4    	  3128:     jsr     GetOppositeDir
                            	  3129:     ; Get the appropriate coordinate for the direction:
                            	  3130:     ; X for horizontal
                            	  3131:     ; Y for vertical
                            	  3132:     ;
02:00041AAC 102C0070        	  3133:     move.b  ($0070,A4),D0
02:00041AB0 0C030002        	  3134:     cmpi.b  #$02,D3
02:00041AB4 6404            	  3135:     bcc  _anon_z05_74
02:00041AB6 102C0084        	  3136:     move.b  ($0084,A4),D0
                            	  3137: _anon_z05_74:
02:00041ABA 19400002        	  3138:     move.b  D0,($0002,A4)
                            	  3139:     ; Mask A button and directions if inner border is crossed.
