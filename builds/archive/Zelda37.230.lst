                            	  3692: DrawGhiniAndCheckCollisions:
02:0003B136 4EB90004CD8E    	  3693:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B13C 1940000D        	  3694:     move.b  D0,($000D,A4)
                            	  3695:     ; If the direction has an "up" component, then keep the
                            	  3696:     ; frame image 0, and go figure out horizontal flipping.
                            	  3697:     ;
02:0003B140 41EC0098        	  3698:     lea     ($0098,A4),A0
02:0003B144 10302000        	  3699:     move.b  (A0,D2.W),D0
02:0003B148 02000008        	  3700:     andi.b #$08,D0
02:0003B14C 6614            	  3701:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3702:     ; Else make the frame image 1 for the "down" frame.
                            	  3703:     ; Note that this is the frame image to use, even if there's no
                            	  3704:     ; down component in the direction.
                            	  3705:     ;
02:0003B14E 522C000D        	  3706:     addq.b  #1,($000D,A4)
                            	  3707:     ; If right is a component of the direction, then go set horizontal
                            	  3708:     ; flipping. Else leave horizontal flipping = 0.
                            	  3709:     ;
02:0003B152 41EC0098        	  3710:     lea     ($0098,A4),A0
02:0003B156 10302000        	  3711:     move.b  (A0,D2.W),D0
02:0003B15A 02000001        	  3712:     andi.b #$01,D0
02:0003B15E 6714            	  3713:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B160 660E            	  3714:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3715:     even
