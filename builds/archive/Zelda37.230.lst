                            	  3051: 
                            	  3052:     even
                            	  3053: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3054:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3055:     ; then this trap definitely wasn't triggered.
                            	  3056:     ; Go draw and check collisions.
                            	  3057:     ;
02:00030496 102C0070        	  3058:     move.b  ($0070,A4),D0
02:0003049A 003C0011        	  3059:     ori     #$11,CCR  ; SEC: set C+X
02:0003049E 12342070        	  3060:     move.b  ($70,A4,D2.W),D1
02:000304A2 0A3C0010        	  3061:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304A6 9101            	  3062:     subx.b  D1,D0   ; SBC ObjX,X
02:000304A8 0A3C0010        	  3063:     eori    #$10,CCR  ; restore X = 6502 C
02:000304AC 61000802        	  3064:     jsr     Abs
02:000304B0 0C00000E        	  3065:     cmpi.b  #$0E,D0
02:000304B4 64DC            	  3066:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3067:     ; Determine the vertical direction toward Link;
                            	  3068:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3069:     ; along this axis. Go draw and check object collisions.
                            	  3070:     ;
02:000304B6 7604            	  3071:     moveq   #4,D3
02:000304B8 102C0084        	  3072:     move.b  ($0084,A4),D0
02:000304BC 41EC0084        	  3073:     lea     ($0084,A4),A0
02:000304C0 12302000        	  3074:     move.b  (A0,D2.W),D1
