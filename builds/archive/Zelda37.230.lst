02:00030EBE 102C0098        	  4623:     move.b  ($0098,A4),D0
02:00030EC2 E208            	  4624:     lsr.b  #1,D0   ; LSR A
02:00030EC4 E208            	  4625:     lsr.b  #1,D0   ; LSR A
02:00030EC6 6110            	  4626:     jsr     ChooseOffsetForDirectionH
02:00030EC8 122C0084        	  4627:     move.b  ($0084,A4),D1
02:00030ECC D101            	  4628:     addx.b  D1,D0   ; ADC ObjY
02:00030ECE 41EC0084        	  4629:     lea     ($0084,A4),A0
02:00030ED2 11802000        	  4630:     move.b  D0,(A0,D2.W)
                            	  4631:     even
                            	  4632: L69AB_Exit:
02:00030ED6 4E75            	  4633:     rts
                            	  4634: 
                            	  4635: ; Params:
                            	  4636: ; A: direction
                            	  4637: ; [01]: value for right
                            	  4638: ; [02]: value for left
