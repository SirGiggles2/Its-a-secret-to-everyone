02:0003F440 41EC0084        	 12880:     lea     ($0084,A4),A0
02:0003F444 10302000        	 12881:     move.b  (A0,D2.W),D0
02:0003F448 19400001        	 12882:     move.b  D0,($0001,A4)
02:0003F44C 6100FF62        	 12883:     jsr     Ganon_DrawCloud
02:0003F450 6172            	 12884:     jsr     Ganon_GetCurCloudRight
02:0003F452 6100FF5C        	 12885:     jsr     Ganon_DrawCloud
                            	 12886:     ; Save the object index.
                            	 12887:     ;
02:0003F456 102C0340        	 12888:     move.b  ($0340,A4),D0
02:0003F45A 1B00            	 12889:     move.b  D0,-(A5)  ; PHA
                            	 12890:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12891:     ;
02:0003F45C 7402            	 12892:     moveq   #2,D2
                            	 12893:     even
                            	 12894: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F45E 19420340        	 12895:     move.b  D2,($0340,A4)
                            	 12896:     ; If object slot < 5 or = 7, then move every frame.
                            	 12897:     ; Else move 3 out of every 4 frames.
                            	 12898:     ;
                            	 12899:     ; This makes pieces spread out in somewhat of a circle,
                            	 12900:     ; by making the pieces at cardinal directions move at
                            	 12901:     ; full speed while the diagonal ones move a little slower.
                            	 12902:     ;
02:0003F462 0C020005        	 12903:     cmpi.b  #$05,D2
02:0003F466 6510            	 12904:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F468 0C020007        	 12905:     cmpi.b  #$07,D2
02:0003F46C 670A            	 12906:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F46E 102C0015        	 12907:     move.b  ($0015,A4),D0
02:0003F472 02000003        	 12908:     andi.b #$03,D0
02:0003F476 6704            	 12909:     beq  _anon_z04_164
                            	 12910:     even
                            	 12911: _L_z04_Ganon_DrawBurst_Move:
02:0003F478 6100DFD6        	 12912:     jsr     BlueWizzrobe_Move
                            	 12913: _anon_z04_164:
02:0003F47C 4EB90004CD8E    	 12914:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12915:     ; The frame counter will make the sprite flash.
                            	 12916:     ; The array has the horizontal and vertical flipping attributes.
                            	 12917:     ; Combine them into [03].
                            	 12918:     ;
02:0003F482 102C0015        	 12919:     move.b  ($0015,A4),D0
02:0003F486 02000003        	 12920:     andi.b #$03,D0
02:0003F48A 41F90003F35A    	 12921:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F490 12302000        	 12922:     move.b  (A0,D2.W),D1
02:0003F494 8001            	 12923:     or.b  D1,D0
02:0003F496 19400003        	 12924:     move.b  D0,($0003,A4)
02:0003F49A 41F90003F364    	 12925:     lea     (GanonBurstTiles).l,A0
02:0003F4A0 10302000        	 12926:     move.b  (A0,D2.W),D0
02:0003F4A4 4EB900031AFC    	 12927:     jsr     Anim_WriteSprite
                            	 12928:     ; Bottom of the loop.
                            	 12929:     ; Increment object slot while <= 9.
                            	 12930:     ;
02:0003F4AA 5202            	 12931:     addq.b  #1,D2
02:0003F4AC 0C02000A        	 12932:     cmpi.b  #$0A,D2
02:0003F4B0 65AC            	 12933:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12934:     ; Restore the object index.
                            	 12935:     ;
02:0003F4B2 101D            	 12936:     move.b  (A5)+,D0  ; PLA
02:0003F4B4 19400340        	 12937:     move.b  D0,($0340,A4)
02:0003F4B8 0A3C0001        	 12938:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F4BC 4E75            	 12939:     rts
                            	 12940: 
                            	 12941: ; Returns:
                            	 12942: ; [00]: X coordinate
                            	 12943: ;
                            	 12944:     even
                            	 12945: Ganon_GetCurCloudLeft:
