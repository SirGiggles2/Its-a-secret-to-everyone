                            	  4991: UpdateMode13WinGame_Sub3:
                            	  4992:     ; After scrolling 8 pixels, draw another tile row.
                            	  4993:     ;
02:00036694 102C050B        	  4994:     move.b  ($050B,A4),D0
02:00036698 0C000008        	  4995:     cmpi.b  #$08,D0
02:0003669C 6B1A            	  4996:     bmi  _anon_z02_37
02:0003669E 102C050B        	  4997:     move.b  ($050B,A4),D0
02:000366A2 123C0008        	  4998:     move.b  #$08,D1
02:000366A6 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000366AA 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:000366AC 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
02:000366B0 1940050B        	  5002:     move.b  D0,($050B,A4)
02:000366B4 61000282        	  5003:     jsr     DrawCredits
                            	  5004: _anon_z02_37:
                            	  5005:     ; Add $80 to the scroll speed fraction.
                            	  5006:     ;
02:000366B8 102C0058        	  5007:     move.b  ($0058,A4),D0
02:000366BC 023C00EE        	  5008:     andi    #$EE,CCR  ; CLC: clear C+X
02:000366C0 123C0080        	  5009:     move.b  #$80,D1
02:000366C4 D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000366C6 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
02:000366CA 6404            	  5014:     bcc  _anon_z02_38
02:000366CC 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:000366D0 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:000366D4 123C0000        	  5018:     move.b  #$00,D1
02:000366D8 D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000366DA 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
                            	  5024:     ;
02:000366DE 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:000366E2 7000            	  5026:     moveq   #0,D0
02:000366E4 6508            	  5027:     bcs  _anon_z02_39
02:000366E6 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:000366EA 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
02:000366EE E310            	  5034:     roxl.b  #1,D0   ; ROL A
02:000366F0 1940005C        	  5035:     move.b  D0,($005C,A4)
                            	  5036:     ; Put the quest number in Y register.
                            	  5037:     ;
02:000366F4 7600            	  5038:     moveq   #0,D3
02:000366F6 7400            	  5039:     moveq   #0,D2
02:000366F8 142C0016        	  5040:     move.b  ($0016,A4),D2
02:000366FC 41EC062D        	  5041:     lea     ($062D,A4),A0
02:00036700 10302000        	  5042:     move.b  (A0,D2.W),D0
02:00036704 6702            	  5043:     beq  _anon_z02_40
02:00036706 5203            	  5044:     addq.b  #1,D3
                            	  5045: _anon_z02_40:
