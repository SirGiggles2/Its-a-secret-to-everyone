                            	  5865: __far_z_04_0041:
                            	  5866:     even
                            	  5867: Moldorm_ChangeFlyingState:
                            	  5868:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5869:     ;
02:0003C10C 61000096        	  5870:     jsr     Flyer_MoldormDecideState
02:0003C110 7010            	  5871:     moveq   #16,D0
02:0003C112 19802028        	  5872:     move.b  D0,($28,A4,D2.W)
                            	  5873:     ; If the next lower slot's direction <> 0, then
                            	  5874:     ; go propagate direction changes down the chain.
                            	  5875:     ;
                            	  5876:     ; But you had to have propagated directions once for the
                            	  5877:     ; next lower direction to be set. How does it happen?
                            	  5878:     ;
                            	  5879:     ; Within a flyer state, the flying routines turn the flyer
                            	  5880:     ; and set the object timer to $10 several times. After any of
                            	  5881:     ; those times will the test succeed.
                            	  5882:     ;
                            	  5883:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5884:     ; in this block to set the timer to $10, and try to propagate
                            	  5885:     ; directions.
                            	  5886:     ;
                            	  5887:     ; But this is also the case the first time here.
                            	  5888:     ;
                            	  5889:     ; So, I believe that the point of this test is to delay moving
                            	  5890:     ; the lower (not head) segments when starting out.
                            	  5891:     ;
02:0003C116 41EC0097        	  5892:     lea     ($0097,A4),A0
02:0003C11A 10302000        	  5893:     move.b  (A0,D2.W),D0
02:0003C11E 6702            	  5894:     beq.s  __far_z_04_0042
02:0003C120 601C            	  5895:     jmp  Moldorm_PropagateDirs
                            	  5896: __far_z_04_0042:
02:0003C122 4E75            	  5897:     rts
                            	  5898: 
                            	  5899:     even
                            	  5900: Moldorm_Wander:
                            	  5901:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5902:     ; Only the head controls the movement direction.
                            	  5903:     ;
02:0003C124 0C020005        	  5904:     cmpi.b  #$05,D2
02:0003C128 6708            	  5905:     beq  _anon_z04_82
02:0003C12A 0C02000A        	  5906:     cmpi.b  #$0A,D2
02:0003C12E 6702            	  5907:     beq.s  __far_z_04_0043
02:0003C130 6070            	  5908:     jmp  L1156B_Exit
                            	  5909: __far_z_04_0043:
                            	  5910: _anon_z04_82:
                            	  5911:     ; Turn randomly while flying, as usual.
                            	  5912:     ;
02:0003C132 61003B8E        	  5913:     jsr     Flyer_Wander
                            	  5914:     ; After every turn, the common flyer routines set timer to $10.
                            	  5915:     ; This can be used as a signal for moldorm to propagate
                            	  5916:     ; direction changes down the chain.
                            	  5917:     ;
                            	  5918:     ; Between each turn, timer <> $10.
                            	  5919:     ;
                            	  5920:     ; At the end of the delay after the last turn, timer = 0.
                            	  5921:     ; This is a signal that that flying state ended, and a new one
                            	  5922:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5923:     ; we can propagate direction changes again; and start
                            	  5924:     ; a new flying interval by setting timer to $10. This will make
                            	  5925:     ; the next flying state delay that amount of time before turning
                            	  5926:     ; the first time.
                            	  5927:     ;
                            	  5928:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5929:     ; arm the timer again, and shift directions down the chain.
                            	  5930:     ;
02:0003C136 10342028        	  5931:     move.b  ($28,A4,D2.W),D0
02:0003C13A 6602            	  5932:     bne.s  __far_z_04_0044
02:0003C13C 60CE            	  5933:     jmp  Moldorm_ChangeFlyingState
                            	  5934: __far_z_04_0044:
                            	  5935:     even
                            	  5936: Moldorm_PropagateDirs:
                            	  5937:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5938:     ;
02:0003C13E 10342028        	  5939:     move.b  ($28,A4,D2.W),D0
02:0003C142 0C000010        	  5940:     cmpi.b  #$10,D0
02:0003C146 6702            	  5941:     beq.s  __far_z_04_0045
02:0003C148 6058            	  5942:     jmp  L1156B_Exit
