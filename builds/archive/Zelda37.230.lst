                            	  3720:     ;
02:0003B162 41EC0098        	  3721:     lea     ($0098,A4),A0
02:0003B166 10302000        	  3722:     move.b  (A0,D2.W),D0
02:0003B16A 02000002        	  3723:     andi.b #$02,D0
02:0003B16E 6704            	  3724:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3725:     even
