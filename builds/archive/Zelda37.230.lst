02:00043896 41EC0302        	  6086:     lea     ($0302,A4),A0
02:0004389A 11802000        	  6087:     move.b  D0,(A0,D2.W)
02:0004389E 1002            	  6088:     move.b  D2,D0
02:000438A0 19400301        	  6089:     move.b  D0,($0301,A4)
                            	  6090:     ; Increment the command.
                            	  6091:     ;
02:000438A4 522C0054        	  6092:     addq.b  #1,($0054,A4)
                            	  6093:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6094:     ; and resetting the door command.
                            	  6095:     ; This ends up catching original states 3 and 7.
                            	  6096:     ;
                            	  6097:     ; Else set door timer to 8 and return.
                            	  6098:     ;
02:000438A8 102C0054        	  6099:     move.b  ($0054,A4),D0
02:000438AC 02000003        	  6100:     andi.b #$03,D0
02:000438B0 6708            	  6101:     beq  _anon_z05_122
02:000438B2 7008            	  6102:     moveq   #8,D0
02:000438B4 19400027        	  6103:     move.b  D0,($0027,A4)
02:000438B8 4E75            	  6104:     rts
