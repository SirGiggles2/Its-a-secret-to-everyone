02:0003F18A 6644            	 12473:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12474:     ; Once the timer expires, it's time to brighten the room.
                            	 12475:     ;
                            	 12476:     ; Save the current object slot.
