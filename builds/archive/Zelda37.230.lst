02:0003C56E 41EC0098        	  6504:     lea     ($0098,A4),A0
02:0003C572 10302000        	  6505:     move.b  (A0,D2.W),D0
02:0003C576 122C0002        	  6506:     move.b  ($0002,A4),D1
02:0003C57A E309            	  6507:     lsl.b  #1,D1   ; ASL $02
02:0003C57C 19410002        	  6508:     move.b  D1,($0002,A4)
02:0003C580 122C0002        	  6509:     move.b  ($0002,A4),D1
02:0003C584 C200            	  6510:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C586 6716            	  6511:     beq  _L_z04_Digdogger_Move_Up
02:0003C588 41EC0084        	  6512:     lea     ($0084,A4),A0
02:0003C58C 10302000        	  6513:     move.b  (A0,D2.W),D0
02:0003C590 122C0003        	  6514:     move.b  ($0003,A4),D1
02:0003C594 D101            	  6515:     addx.b  D1,D0   ; ADC $03
02:0003C596 41EC0084        	  6516:     lea     ($0084,A4),A0
02:0003C59A 11802000        	  6517:     move.b  D0,(A0,D2.W)
                            	  6518:     even
                            	  6519: _L_z04_Digdogger_Move_Up:
