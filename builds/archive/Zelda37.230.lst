02:00030484 52302000        	  3044:     addq.b  #1,(A0,D2.W)
02:00030488 7070            	  3045:     moveq   #112,D0
02:0003048A 41EC03BC        	  3046:     lea     ($03BC,A4),A0
02:0003048E 11802000        	  3047:     move.b  D0,(A0,D2.W)
                            	  3048:     even
                            	  3049: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
