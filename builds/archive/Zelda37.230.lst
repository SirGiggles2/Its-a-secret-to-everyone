02:0003E73C 7000            	 11073:     moveq   #0,D0
02:0003E73E 7604            	 11074:     moveq   #4,D3
                            	 11075: _anon_z04_143:
02:0003E740 1214            	 11076:     move.b  ($0000,A4),D1
02:0003E742 E209            	 11077:     lsr.b  #1,D1   ; LSR $00
02:0003E744 1881            	 11078:     move.b  D1,($0000,A4)
02:0003E746 123C0000        	 11079:     move.b  #$00,D1
02:0003E74A D101            	 11080:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E74C 5303            	 11081:     subq.b  #1,D3
02:0003E74E 66F0            	 11082:     bne  _anon_z04_143
02:0003E750 1880            	 11083:     move.b  D0,($0000,A4)
                            	 11084:     ; Compare the number of dead necks to the original number
                            	 11085:     ; (object type - $41).
