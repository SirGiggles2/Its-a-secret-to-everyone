02:0003BA8E 41EC0412        	  5062:     lea     ($0412,A4),A0
02:0003BA92 16302000        	  5063:     move.b  (A0,D2.W),D3
02:0003BA96 41F90003B8C8    	  5064:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003BA9C 10303000        	  5065:     move.b  (A0,D3.W),D0
