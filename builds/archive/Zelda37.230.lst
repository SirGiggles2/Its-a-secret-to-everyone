02:000436F6 1214            	  5853:     move.b  ($00,A4),D1   ; ptr lo
02:000436F8 182C0001        	  5854:     move.b  ($01,A4),D4  ; ptr hi
02:000436FC 024100FF        	  5855:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043700 E14C            	  5856:     lsl.w   #8,D4
02:00043702 8841            	  5857:     or.w    D1,D4
02:00043704 48C4            	  5858:     ext.l   D4
02:00043706 D8BC00FF0000    	  5859:     add.l   #NES_RAM,D4
