                            	  6198: 
                            	  6199: ; Params:
                            	  6200: ; [08]: 0 if closed
                            	  6201: ;
                            	  6202: ; Returns:
                            	  6203: ; X: current length of dynamic transfer buf
                            	  6204: ; [00]: door VRAM address high byte
                            	  6205: ; [01]: door VRAM address low byte
                            	  6206: ; [02:03]: address of door tiles for direction and face
                            	  6207: ; [05]: 2, the number of transfer records to write
                            	  6208: ; [06]: 2, the number of tiles in each record
                            	  6209: ; [07]: 0, the first index of a tile to transfer
                            	  6210: ; [09]: door direction index
                            	  6211: ;
                            	  6212: ; Note that this routine is called with triggered doors:
                            	  6213: ; doors that can change state. Their door type numbers are >= 4.
                            	  6214: ;
                            	  6215: ; If this routine were ever called with a fixed door
                            	  6216: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6217: ; values for the door face.
                            	  6218: ;
                            	  6219: ;
                            	  6220: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6221: ;
                            	  6222:     even
                            	  6223: PrepareWriteHorizontalDoorTransferRecords:
02:00043978 102C0055        	  6224:     move.b  ($0055,A4),D0
02:0004397C 19400002        	  6225:     move.b  D0,($0002,A4)
02:00043980 6100F9A4        	  6226:     jsr     FindDoorAttrByDoorBit
02:00043984 0C000005        	  6227:     cmpi.b  #$05,D0
02:00043988 650C            	  6228:     bcs  _anon_z05_125
02:0004398A 1B00            	  6229:     move.b  D0,-(A5)  ; PHA
02:0004398C 7004            	  6230:     moveq   #4,D0
02:0004398E 4EB900030818    	  6231:     jsr     PlaySample
02:00043994 101D            	  6232:     move.b  (A5)+,D0  ; PLA
                            	  6233: _anon_z05_125:
                            	  6234:     ; Calculate the door face index in three parts.
                            	  6235:     ;
                            	  6236:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6237:     ; (provisional face index in Y register).
                            	  6238:     ;
02:00043996 0C000004        	  6239:     cmpi.b  #$04,D0
02:0004399A 6602            	  6240:     bne  _anon_z05_126
02:0004399C 7008            	  6241:     moveq   #8,D0
                            	  6242: _anon_z05_126:
02:0004399E 0C000001        	  6243:     cmpi.b  #$01,D0
02:000439A2 6602            	  6244:     bne  _anon_z05_127
02:000439A4 7004            	  6245:     moveq   #4,D0
                            	  6246: _anon_z05_127:
                            	  6247:     ; Second, subtract 3 from provisional face index.
                            	  6248:     ;
02:000439A6 003C0011        	  6249:     ori     #$11,CCR  ; SEC: set C+X
02:000439AA 123C0003        	  6250:     move.b  #$03,D1
02:000439AE 0A3C0010        	  6251:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439B2 9101            	  6252:     subx.b  D1,D0   ; SBC #$03
02:000439B4 0A3C0010        	  6253:     eori    #$10,CCR  ; restore X = 6502 C
02:000439B8 7600            	  6254:     moveq   #0,D3
02:000439BA 1600            	  6255:     move.b  D0,D3
                            	  6256:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6257:     ; face index >= 3, then subtract 1 from it.
                            	  6258:     ;
                            	  6259:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6260:     ; then make it 1.
                            	  6261:     ;
02:000439BC 102C0008        	  6262:     move.b  ($0008,A4),D0
02:000439C0 6708            	  6263:     beq  _anon_z05_128
02:000439C2 0C030005        	  6264:     cmpi.b  #$05,D3
02:000439C6 670A            	  6265:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439C8 7601            	  6266:     moveq   #1,D3
                            	  6267: _anon_z05_128:
02:000439CA 0C030003        	  6268:     cmpi.b  #$03,D3
02:000439CE 6502            	  6269:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439D0 5303            	  6270:     subq.b  #1,D3
                            	  6271:     even
                            	  6272: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6273:     ; The routine that returned the door type also returned its
                            	  6274:     ; reverse direction index in [03].
                            	  6275:     ;
                            	  6276:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6277:     ;
02:000439D2 7003            	  6278:     moveq   #3,D0
02:000439D4 003C0011        	  6279:     ori     #$11,CCR  ; SEC: set C+X
02:000439D8 122C0003        	  6280:     move.b  ($0003,A4),D1
02:000439DC 0A3C0010        	  6281:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439E0 9101            	  6282:     subx.b  D1,D0   ; SBC $03
02:000439E2 0A3C0010        	  6283:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6284:     ; Call this to put the address of door face tiles in [02:03].
                            	  6285:     ;
02:000439E6 6100FD7A        	  6286:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6287:     ; Return the address of the door in the nametable in [01:00].
                            	  6288:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6289:     ;
02:000439EA 41F9000437C0    	  6290:     lea     (DoorVramAddrsHi).l,A0
02:000439F0 10302000        	  6291:     move.b  (A0,D2.W),D0
02:000439F4 1880            	  6292:     move.b  D0,($0000,A4)
02:000439F6 41F9000437C4    	  6293:     lea     (DoorVramAddrsLo).l,A0
02:000439FC 10302000        	  6294:     move.b  (A0,D2.W),D0
02:00043A00 19400001        	  6295:     move.b  D0,($0001,A4)
                            	  6296:     ; Return the direction of the door in [09], and the dynamic
                            	  6297:     ; transfer buf length in X register.
                            	  6298:     ;
02:00043A04 19420009        	  6299:     move.b  D2,($0009,A4)
02:00043A08 7400            	  6300:     moveq   #0,D2
02:00043A0A 142C0301        	  6301:     move.b  ($0301,A4),D2
                            	  6302:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6303:     ;
02:00043A0E 7000            	  6304:     moveq   #0,D0
02:00043A10 19400007        	  6305:     move.b  D0,($0007,A4)
02:00043A14 7002            	  6306:     moveq   #2,D0
02:00043A16 19400006        	  6307:     move.b  D0,($0006,A4)
02:00043A1A 19400005        	  6308:     move.b  D0,($0005,A4)
02:00043A1E 0A3C0001        	  6309:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043A22 4E75            	  6310:     rts
