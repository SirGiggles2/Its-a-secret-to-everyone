                            	  9807: 
                            	  9808:     even
                            	  9809: _L_z04_UpdateGohma_Move:
                            	  9810:     ; Add $80 to the movement accumulator.
                            	  9811:     ;
02:0003DDD6 41EC041F        	  9812:     lea     ($041F,A4),A0
02:0003DDDA 10302000        	  9813:     move.b  (A0,D2.W),D0
02:0003DDDE 023C00EE        	  9814:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDE2 123C0080        	  9815:     move.b  #$80,D1
02:0003DDE6 D101            	  9816:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DDE8 41EC041F        	  9817:     lea     ($041F,A4),A0
02:0003DDEC 11802000        	  9818:     move.b  D0,(A0,D2.W)
                            	  9819:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9820:     ;
02:0003DDF0 640000A8        	  9821:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9822:     ; Increase the distance traveled, and move 1.
                            	  9823:     ;
02:0003DDF4 41EC0412        	  9824:     lea     ($0412,A4),A0
02:0003DDF8 52302000        	  9825:     addq.b  #1,(A0,D2.W)
                            	  9826:     ; Set a direction mask in [02], starting with right (1).
                            	  9827:     ;
