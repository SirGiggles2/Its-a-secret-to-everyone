02:00031E92 122C000D        	  6654:     move.b  ($000D,A4),D1
02:00031E96 B001            	  6655:     cmp.b   D1,D0
02:00031E98 6554            	  6656:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031E9A 102C066F        	  6657:     move.b  ($066F,A4),D0
02:00031E9E 003C0011        	  6658:     ori     #$11,CCR  ; SEC: set C+X
02:00031EA2 122C000D        	  6659:     move.b  ($000D,A4),D1
02:00031EA6 0A3C0010        	  6660:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031EAA 9101            	  6661:     subx.b  D1,D0   ; SBC $0D
02:00031EAC 0A3C0010        	  6662:     eori    #$10,CCR  ; restore X = 6502 C
02:00031EB0 1940066F        	  6663:     move.b  D0,($066F,A4)
02:00031EB4 0A3C0001        	  6664:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031EB8 4E75            	  6665:     rts
