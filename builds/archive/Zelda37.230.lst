02:0003BAB8 10302000        	  5077:     move.b  (A0,D2.W),D0
02:0003BABC 0C000007        	  5078:     cmpi.b  #$07,D0
02:0003BAC0 652C            	  5079:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  5080:     ; It has reached the end of a trip.
