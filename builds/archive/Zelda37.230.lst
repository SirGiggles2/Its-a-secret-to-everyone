02:00030D26 1940000B        	  4360:     move.b  D0,($000B,A4)
                            	  4361:     ; Handle the vertical.
                            	  4362:     ;
02:00030D2A 101D            	  4363:     move.b  (A5)+,D0  ; PLA
02:00030D2C 7600            	  4364:     moveq   #0,D3
02:00030D2E 1600            	  4365:     move.b  D0,D3
02:00030D30 7008            	  4366:     moveq   #8,D0
02:00030D32 1940000A        	  4367:     move.b  D0,($000A,A4)
02:00030D36 41EC0084        	  4368:     lea     ($0084,A4),A0
02:00030D3A 10303000        	  4369:     move.b  (A0,D3.W),D0
02:00030D3E 7600            	  4370:     moveq   #0,D3
02:00030D40 41EC0084        	  4371:     lea     ($0084,A4),A0
02:00030D44 16302000        	  4372:     move.b  (A0,D2.W),D3
02:00030D48 61000092        	  4373:     jsr     GetOneDirectionAndDistanceToTarget
02:00030D4C 19400004        	  4374:     move.b  D0,($0004,A4)
02:00030D50 4E75            	  4375:     rts
                            	  4376: 
                            	  4377: ; Params:
                            	  4378: ; Y: middle speed index (4)
                            	  4379: ; [03]: horizontal distance
                            	  4380: ; [04]: vertical distance
                            	  4381: ; [0A]: vertical direction
                            	  4382: ; [0B]: horizontal direction
                            	  4383: ;
                            	  4384: ; Returns:
                            	  4385: ; Y: speed index (0 to 8) for the angle
                            	  4386: ;
                            	  4387: ;
                            	  4388: ; TODO: call it speed index or angle?
                            	  4389: ; Store the middle speed index in [00]. It will be changed to the
                            	  4390: ; right speed index to use incrementally.
                            	  4391: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4392: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4393: ;
                            	  4394:     even
                            	  4395: _CalcDiagonalSpeedIndex:
02:00030D52 1883            	  4396:     move.b  D3,($0000,A4)
                            	  4397:     ; Assuming horizontal distance >= vertical distance, the
                            	  4398:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4399:     ;
02:00030D54 103C00FF        	  4400:     move.b  #$FF,D0
02:00030D58 19400001        	  4401:     move.b  D0,($0001,A4)
                            	  4402:     ; TODO:
                            	  4403:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4404:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4405:     ;
                            	  4406:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4407:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4408:     ; of the farther distance faster.
                            	  4409:     ;
02:00030D5C 102C0003        	  4410:     move.b  ($0003,A4),D0
02:00030D60 122C0004        	  4411:     move.b  ($0004,A4),D1
02:00030D64 B001            	  4412:     cmp.b   D1,D0
02:00030D66 6416            	  4413:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030D68 1B00            	  4414:     move.b  D0,-(A5)  ; PHA
02:00030D6A 102C0004        	  4415:     move.b  ($0004,A4),D0
02:00030D6E 19400003        	  4416:     move.b  D0,($0003,A4)
02:00030D72 101D            	  4417:     move.b  (A5)+,D0  ; PLA
02:00030D74 19400004        	  4418:     move.b  D0,($0004,A4)
02:00030D78 7001            	  4419:     moveq   #1,D0
02:00030D7A 19400001        	  4420:     move.b  D0,($0001,A4)
                            	  4421:     even
                            	  4422: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4423:     ; TODO: call it speed index or angle?
                            	  4424:     ; If the difference in distances is within 8 pixels,
                            	  4425:     ; return the speed index (angle) we have.
                            	  4426:     ;
02:00030D7E 102C0003        	  4427:     move.b  ($0003,A4),D0
02:00030D82 003C0011        	  4428:     ori     #$11,CCR  ; SEC: set C+X
02:00030D86 122C0004        	  4429:     move.b  ($0004,A4),D1
02:00030D8A 0A3C0010        	  4430:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030D8E 9101            	  4431:     subx.b  D1,D0   ; SBC $04
02:00030D90 0A3C0010        	  4432:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D94 0C000008        	  4433:     cmpi.b  #$08,D0
02:00030D98 6538            	  4434:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4435:     even
                            	  4436: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4437:     ; TODO: call it speed index or angle?
                            	  4438:     ; Otherwise, go to the next speed index (angle).
                            	  4439:     ;
02:00030D9A 1014            	  4440:     move.b  ($0000,A4),D0
02:00030D9C 023C00EE        	  4441:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030DA0 122C0001        	  4442:     move.b  ($0001,A4),D1
02:00030DA4 D101            	  4443:     addx.b  D1,D0   ; ADC $01
02:00030DA6 1880            	  4444:     move.b  D0,($0000,A4)
                            	  4445:     ; TODO: call it speed index or angle?
                            	  4446:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4447:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4448:     ;
02:00030DA8 6728            	  4449:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030DAA 0C000008        	  4450:     cmpi.b  #$08,D0
02:00030DAE 6722            	  4451:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4452:     ; Subtract the lesser distance from the greater distance.
                            	  4453:     ; If they still haven't crossed, then we can turn more.
                            	  4454:     ;
02:00030DB0 102C0003        	  4455:     move.b  ($0003,A4),D0
02:00030DB4 003C0011        	  4456:     ori     #$11,CCR  ; SEC: set C+X
02:00030DB8 122C0004        	  4457:     move.b  ($0004,A4),D1
02:00030DBC 0A3C0010        	  4458:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030DC0 9101            	  4459:     subx.b  D1,D0   ; SBC $04
02:00030DC2 0A3C0010        	  4460:     eori    #$10,CCR  ; restore X = 6502 C
02:00030DC6 19400003        	  4461:     move.b  D0,($0003,A4)
02:00030DCA 122C0004        	  4462:     move.b  ($0004,A4),D1
02:00030DCE B001            	  4463:     cmp.b   D1,D0
02:00030DD0 64C8            	  4464:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4465:     even
                            	  4466: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4467:     ; TODO: call it speed index or angle?
                            	  4468:     ; Return the speed index (angle) we found.
                            	  4469:     ;
02:00030DD2 7600            	  4470:     moveq   #0,D3
02:00030DD4 1614            	  4471:     move.b  ($0000,A4),D3
02:00030DD6 4E75            	  4472:     rts
                            	  4473: 
