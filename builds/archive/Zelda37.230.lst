                            	  5947:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5948:     ;
02:0003C14A 41EC03BC        	  5949:     lea     ($03BC,A4),A0
02:0003C14E 10302000        	  5950:     move.b  (A0,D2.W),D0
