02:0003044A 7601            	  3014:     moveq   #1,D3
02:0003044C 102C0070        	  3015:     move.b  ($0070,A4),D0
02:00030450 12342070        	  3016:     move.b  ($70,A4,D2.W),D1
02:00030454 B001            	  3017:     cmp.b   D1,D0
02:00030456 673E            	  3018:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030458 6402            	  3019:     bcc  _anon_z01_26
02:0003045A 7602            	  3020:     moveq   #2,D3
                            	  3021: _anon_z01_26:
