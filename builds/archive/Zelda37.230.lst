                            	  3925:     ; If we're finally leaving the object flagged "initialized",
                            	  3926:     ; then reset metastate and initialize this as a flyer.
                            	  3927:     ;
02:0003B28E 41EC0492        	  3928:     lea     ($0492,A4),A0
02:0003B292 10302000        	  3929:     move.b  (A0,D2.W),D0
02:0003B296 66EC            	  3930:     bne  _anon_z04_53
02:0003B298 4EB90004D590    	  3931:     jsr     ResetObjMetastateAndTimer
