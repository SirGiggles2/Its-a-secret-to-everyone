                            	  5293: Wallmaster_PutSpriteBehindBgIfNeeded:
                            	  5294:     ; Loop twice, from 1 to 0, in order to check the left and right
                            	  5295:     ; extents of the sprite (X and X+8).
                            	  5296:     ;
