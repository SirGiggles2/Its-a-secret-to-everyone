                            	  5728: AnimateAndDrawObjectWalking:
02:000317F2 4EB90004CD2A    	  5729:     jsr     AnimateObjectWalking
02:000317F8 1003            	  5730:     move.b  D3,D0
02:000317FA 6004            	  5731:     jmp     DrawObjectNotMirrored
                            	  5732: 
                            	  5733: ; Params:
                            	  5734: ; A: frame image
                            	  5735: ; X: object index
                            	  5736: ; [00]: object X
                            	  5737: ; [01]: object Y
                            	  5738: ;
                            	  5739: ;
                            	  5740: ; Set [0C] mirrored.
                            	  5741:     even
                            	  5742: DrawObjectMirrored:
02:000317FC 7601            	  5743:     moveq   #1,D3
02:000317FE 6602            	  5744:     bne  _anon_z01_75
                            	  5745: ; Params:
                            	  5746: ; A: frame image
                            	  5747: ; X: object index
                            	  5748: ; [00]: object X
                            	  5749: ; [01]: object Y
                            	  5750: ; [0F]: flip horizontally
                            	  5751: ;
                            	  5752:     even
                            	  5753: DrawObjectNotMirrored:
02:00031800 7600            	  5754:     moveq   #0,D3
                            	  5755: _anon_z01_75:
02:00031802 1943000C        	  5756:     move.b  D3,($000C,A4)
                            	  5757:     ; Set animation index = object type + 1.
                            	  5758:     ;
02:00031806 7600            	  5759:     moveq   #0,D3
02:00031808 41EC034F        	  5760:     lea     ($034F,A4),A0
02:0003180C 16302000        	  5761:     move.b  (A0,D2.W),D3
                            	  5762: ; Params:
                            	  5763: ; A: frame
                            	  5764: ; X: object index/cycle sprite index
                            	  5765: ; Y: object type
                            	  5766: ; [00]: object X
                            	  5767: ; [01]: object Y
                            	  5768: ; [0C]: mirrored
                            	  5769: ; [0F]: flip horizontally
                            	  5770: ;
                            	  5771: ; Note:
                            	  5772: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5773: ;
                            	  5774: ; The animation index of most objects is (object type + 1),
                            	  5775: ; to make up for the fact that Link uses two animation indexes.
