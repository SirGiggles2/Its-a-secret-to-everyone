02:0003D0C2 6600009A        	  8061:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003D0C6 103C0080        	  8062:     move.b  #$80,D0
02:0003D0CA 6100C83A        	  8063:     jsr     UpdateCommonWanderer
