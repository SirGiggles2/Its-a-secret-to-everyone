02:0003E6FE 102C04D7        	 11048:     move.b  ($04D7,A4),D0
02:0003E702 E308            	 11049:     lsl.b  #1,D0   ; ASL A
02:0003E704 E308            	 11050:     lsl.b  #1,D0   ; ASL A
02:0003E706 E308            	 11051:     lsl.b  #1,D0   ; ASL A
02:0003E708 7600            	 11052:     moveq   #0,D3
02:0003E70A 1600            	 11053:     move.b  D0,D3
02:0003E70C 103C00F8        	 11054:     move.b  #$F8,D0
02:0003E710 41EC0200        	 11055:     lea     ($0200,A4),A0
02:0003E714 11803000        	 11056:     move.b  D0,(A0,D3.W)
02:0003E718 41EC0220        	 11057:     lea     ($0220,A4),A0
02:0003E71C 11803000        	 11058:     move.b  D0,(A0,D3.W)
                            	 11059:     ; Add the bit for this neck to the dead neck mask.
