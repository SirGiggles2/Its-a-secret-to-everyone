                            	  8321: ; Description:
                            	  8322: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8323: ; When walking, the object timer is set. When teleporting,
                            	  8324: ; the teleporting distance remaining is set.
                            	  8325: ;
                            	  8326: ; If we have the magic clock, then only go draw and check collisions.
                            	  8327: ;
                            	  8328:     even
                            	  8329: UpdateBlueWizzrobe:
02:0003D2F6 102C066C        	  8330:     move.b  ($066C,A4),D0
