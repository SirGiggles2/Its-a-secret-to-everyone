02:0003CF5A 10302000        	  7907:     move.b  (A0,D2.W),D0
02:0003CF5E 023C00EE        	  7908:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF62 41F90003CE40    	  7909:     lea     (PolsVoiceDestinationYOffsets).l,A0
