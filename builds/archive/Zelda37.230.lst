02:000420D3 DE
02:000420D4 1F
02:000420D5 F1
                            	  4191: 
                            	  4192: ; Params:
                            	  4193: ; [0F]: moving direction
                            	  4194: ;
                            	  4195: ; Returns:
                            	  4196: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4197: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4198: ;
                            	  4199: ; When not at or in a doorway, this function leaves
                            	  4200: ; [0F] moving direction as is.
                            	  4201: ;
                            	  4202: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4203: ; will be left as is, assuming that it had been reset before this
                            	  4204: ; routine by BoundByRoom.
                            	  4205: ;
                            	  4206: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4207: ;
                            	  4208: ;
                            	  4209: ; If already in a doorway, go handle it separately.
                            	  4210: ;
                            	  4211:     even
