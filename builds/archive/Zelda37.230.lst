                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:000365AA 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:000365AE 102C0412        	  4873:     move.b  ($0412,A4),D0
02:000365B2 02000007        	  4874:     andi.b #$07,D0
02:000365B6 0C000004        	  4875:     cmpi.b  #$04,D0
02:000365BA 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4878:     ; to the dynamic transfer buf.
                            	  4879:     ;
02:000365BC 7604            	  4880:     moveq   #4,D3
                            	  4881: _anon_z02_35:
02:000365BE 41F90003653A    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:000365C4 10303000        	  4883:     move.b  (A0,D3.W),D0
02:000365C8 41EC0302        	  4884:     lea     ($0302,A4),A0
02:000365CC 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:000365D0 5303            	  4886:     subq.b  #1,D3
02:000365D2 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:000365D4 7600            	  4891:     moveq   #0,D3
02:000365D6 162C0413        	  4892:     move.b  ($0413,A4),D3
02:000365DA 41F900036574    	  4893:     lea     (PeaceText).l,A0
02:000365E0 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000365E4 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000365E8 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000365EA 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:000365EE 0C000024        	  4901:     cmpi.b  #$24,D0
02:000365F2 6706            	  4902:     beq  _anon_z02_36
02:000365F4 7010            	  4903:     moveq   #16,D0
02:000365F6 19400604        	  4904:     move.b  D0,($0604,A4)
                            	  4905: _anon_z02_36:
                            	  4906:     ; Point to the next character in the string.
                            	  4907:     ;
02:000365FA 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:000365FE 41F900036540    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00036604 10303000        	  4913:     move.b  (A0,D3.W),D0
02:00036608 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
                            	  4917:     ;
02:0003660C 0C0000A0        	  4918:     cmpi.b  #$A0,D0
02:00036610 6406            	  4919:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:00036612 7023            	  4920:     moveq   #35,D0
