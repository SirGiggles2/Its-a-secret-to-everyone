02:0003EE84 10302000        	 12070:     move.b  (A0,D2.W),D0
02:0003EE88 122C0002        	 12071:     move.b  ($0002,A4),D1
02:0003EE8C E309            	 12072:     lsl.b  #1,D1   ; ASL $02
02:0003EE8E 19410002        	 12073:     move.b  D1,($0002,A4)
02:0003EE92 122C0002        	 12074:     move.b  ($0002,A4),D1
02:0003EE96 C200            	 12075:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
