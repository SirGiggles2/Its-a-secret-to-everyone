                            	  1547: Zol_CheckCollisions:
                            	  1548:     ; If not in state 0, then return.
                            	  1549:     ;
02:0003A262 41EC00AC        	  1550:     lea     ($00AC,A4),A0
02:0003A266 10302000        	  1551:     move.b  (A0,D2.W),D0
02:0003A26A 665C            	  1552:     bne  _L_z04_Zol_CheckCollisions_Exit
                            	  1553:     ; Check collisions.
                            	  1554:     ;
                            	  1555:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1556:     ; then return.
                            	  1557:     ;
02:0003A26C 610001F8        	  1558:     jsr     Gel_CheckCollisions
02:0003A270 41EC0405        	  1559:     lea     ($0405,A4),A0
02:0003A274 10302000        	  1560:     move.b  (A0,D2.W),D0
02:0003A278 664E            	  1561:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A27A 41EC04F0        	  1562:     lea     ($04F0,A4),A0
02:0003A27E 10302000        	  1563:     move.b  (A0,D2.W),D0
02:0003A282 6744            	  1564:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1565:     ; If vertically aligned with the square grid, then
                            	  1566:     ; use a horizontal direction mask (3).
                            	  1567:     ;
                            	  1568:     ; Keep in mind that most objects are aligned vertically when
                            	  1569:     ; the low nibble of their Y is $D.
                            	  1570:     ;
02:0003A284 7600            	  1571:     moveq   #0,D3
02:0003A286 41EC0084        	  1572:     lea     ($0084,A4),A0
02:0003A28A 10302000        	  1573:     move.b  (A0,D2.W),D0
02:0003A28E 0200000F        	  1574:     andi.b #$0F,D0
02:0003A292 0C00000D        	  1575:     cmpi.b  #$0D,D0
02:0003A296 6602            	  1576:     bne  _anon_z04_26
02:0003A298 7603            	  1577:     moveq   #3,D3
                            	  1578: _anon_z04_26:
02:0003A29A 1883            	  1579:     move.b  D3,($0000,A4)
                            	  1580:     ; If horizontally aligned with the square grid, then
                            	  1581:     ; use a vertical direction mask ($C).
                            	  1582:     ;
02:0003A29C 7600            	  1583:     moveq   #0,D3
02:0003A29E 10342070        	  1584:     move.b  ($70,A4,D2.W),D0
02:0003A2A2 0200000F        	  1585:     andi.b #$0F,D0
02:0003A2A6 6602            	  1586:     bne  _anon_z04_27
02:0003A2A8 760C            	  1587:     moveq   #12,D3
                            	  1588: _anon_z04_27:
02:0003A2AA 1003            	  1589:     move.b  D3,D0
                            	  1590:     ; Combine the two masks. At most one will be 0.
                            	  1591:     ;
02:0003A2AC 1214            	  1592:     move.b  ($0000,A4),D1
02:0003A2AE 8001            	  1593:     or.b  D1,D0
                            	  1594:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1595:     ; with the grid.
                            	  1596:     ;
                            	  1597:     ; If so, then go to state 1 to do a "big shove".
                            	  1598:     ; Else go to state 2, to immediately split in two.
                            	  1599:     ;
                            	  1600:     ; Examples:
                            	  1601:     ; It would be aligned, if moving left along a tile as usual.
                            	  1602:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1603:     ; - The collision check routines would have made the zol
                            	  1604:     ;   face in the direction of the weapon.
                            	  1605:     ; - See CheckMonsterWeaponCollision.
                            	  1606:     ;
02:0003A2B0 122C0098        	  1607:     move.b  ($0098,A4),D1
02:0003A2B4 C001            	  1608:     and.b  D1,D0
02:0003A2B6 6608            	  1609:     bne  _anon_z04_28
02:0003A2B8 41EC00AC        	  1610:     lea     ($00AC,A4),A0
02:0003A2BC 52302000        	  1611:     addq.b  #1,(A0,D2.W)
                            	  1612: _anon_z04_28:
02:0003A2C0 41EC00AC        	  1613:     lea     ($00AC,A4),A0
02:0003A2C4 52302000        	  1614:     addq.b  #1,(A0,D2.W)
                            	  1615:     even
