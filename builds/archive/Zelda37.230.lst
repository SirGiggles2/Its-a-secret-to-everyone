02:0003CF2C 41EC0084        	  7885:     lea     ($0084,A4),A0
02:0003CF30 10302000        	  7886:     move.b  (A0,D2.W),D0
02:0003CF34 0C000078        	  7887:     cmpi.b  #$78,D0
02:0003CF38 6402            	  7888:     bcc  _anon_z04_97
02:0003CF3A 7603            	  7889:     moveq   #3,D3
                            	  7890: _anon_z04_97:
                            	  7891:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7892:     ;
02:0003CF3C 0C0000A8        	  7893:     cmpi.b  #$A8,D0
