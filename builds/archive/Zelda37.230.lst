02:0002B5D4 0010            	  3507:     dc.w    $10                     ; sub-pal 1 → PAL0[8]
02:0002B5D6 0018            	  3508:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0002B5D8 0028            	  3509:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3510: .ttf_pal_have_cram_new:
                            	  3511:     else
                            	  3512:     ; Legacy: remap NES sprite pal 0-3 → Genesis pal 2-3 (last-write-wins).
                            	  3513:     move.w  D0,D6
                            	  3514:     subi.w  #$10,D6
                            	  3515:     lsr.w   #2,D6                   ; NES sprite pal (0-3)
                            	  3516:     ori.w   #$0002,D6               ; Genesis pal = NES_pal | 2 (0→2, 1→3, 2→2, 3→3)
