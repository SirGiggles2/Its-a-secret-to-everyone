                            	  8013: Submenu_CueTransferRowUW:
                            	  8014:     ; If menu scroll value is negative, then we transferred everything.
                            	  8015:     ; So, return.
                            	  8016:     ;
02:00044BBC 102C005E        	  8017:     move.b  ($005E,A4),D0
02:00044BC0 6A02            	  8018:     bpl.s  __far_z_05_0107
02:00044BC2 602E            	  8019:     jmp  L1725A_Exit
                            	  8020: __far_z_05_0107:
                            	  8021:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8022:     ; and represents the current row of the submenu being processed.
                            	  8023:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8024:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8025:     ;
                            	  8026:     ; If the bottom bit is set, go prepare the full black row.
                            	  8027:     ;
02:00044BC4 E208            	  8028:     lsr.b  #1,D0   ; LSR A
02:00044BC6 7600            	  8029:     moveq   #0,D3
02:00044BC8 1600            	  8030:     move.b  D0,D3
02:00044BCA 6402            	  8031:     bcc.s  __far_z_05_0108
02:00044BCC 6026            	  8032:     jmp  PrepFullBlackRow
                            	  8033: __far_z_05_0108:
                            	  8034:     ; Submenu rows $D to $15 are parts of the map.
                            	  8035:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8036:     ;
                            	  8037:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8038:     ; buffer for this row.
                            	  8039:     ;
02:00044BCE 0C00000D        	  8040:     cmpi.b  #$0D,D0
02:00044BD2 640C            	  8041:     bcc  _anon_z05_167
02:00044BD4 41F900044B98    	  8042:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044BDA 10303000        	  8043:     move.b  (A0,D3.W),D0
                            	  8044:     even
                            	  8045: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044BDE 606E            	  8046:     jmp     SelectTransferBufAndDecCounter
                            	  8047: 
                            	  8048: _anon_z05_167:
                            	  8049:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  8050:     ; of the big map sheet.
                            	  8051:     ;
02:00044BE0 0C000015        	  8052:     cmpi.b  #$15,D0
02:00044BE4 6604            	  8053:     bne  _anon_z05_168
02:00044BE6 7042            	  8054:     moveq   #66,D0
02:00044BE8 60F4            	  8055:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8056: 
                            	  8057: _anon_z05_168:
                            	  8058:     ; Else row is between $D and $14. Prepare a map row.
                            	  8059:     ;
02:00044BEA 610005B8        	  8060:     jsr     Submenu_WriteSheetMapRowTransferRecord
                            	  8061:     even
