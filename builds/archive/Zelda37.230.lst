02:00030DFE 102C0002        	  4496:     move.b  ($0002,A4),D0
02:00030E02 003C0011        	  4497:     ori     #$11,CCR  ; SEC: set C+X
02:00030E06 122C0001        	  4498:     move.b  ($0001,A4),D1
02:00030E0A 0A3C0010        	  4499:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030E0E 9101            	  4500:     subx.b  D1,D0   ; SBC $01
02:00030E10 0A3C0010        	  4501:     eori    #$10,CCR  ; restore X = 6502 C
02:00030E14 0C000009        	  4502:     cmpi.b  #$09,D0
