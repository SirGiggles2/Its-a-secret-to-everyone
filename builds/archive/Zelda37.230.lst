02:0003F196 7400            	 12481:     moveq   #0,D2
02:0003F198 1400            	 12482:     move.b  D0,D2
                            	 12483:     ; Turn off the room brightening flag, because we're controlling it
                            	 12484:     ; here instead of in the Mode 5 object update loop.
                            	 12485:     ;
02:0003F19A 7000            	 12486:     moveq   #0,D0
02:0003F19C 1940051E        	 12487:     move.b  D0,($051E,A4)
                            	 12488:     ; On the first frame of the fade-to-light cycle, play the
                            	 12489:     ; Triforce/Ganon song.
                            	 12490:     ;
02:0003F1A0 102C051C        	 12491:     move.b  ($051C,A4),D0
