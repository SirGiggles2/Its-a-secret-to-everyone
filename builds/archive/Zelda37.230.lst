                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002E090 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002E094 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E098 123C006A        	   248:     move.b  #$6A,D1
02:0002E09C 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E0A0 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E0A2 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E0A6 7600            	   252:     moveq   #0,D3
02:0002E0A8 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E0AA 41F90002E028    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E0B0 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E0B4 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E0B6 0200003F        	   260:     andi.b #$3F,D0
02:0002E0BA 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E0BE 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E0C0 020000C0        	   266:     andi.b #$C0,D0
02:0002E0C4 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
                            	   269:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   270:     ;
02:0002E0C8 103C00FD        	   271:     move.b  #$FD,D0
                            	   272: _anon_z01_0:
02:0002E0CC 023C00EE        	   273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E0D0 123C0003        	   274:     move.b  #$03,D1
02:0002E0D4 D101            	   275:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E0D6 5303            	   276:     subq.b  #1,D3
02:0002E0D8 6AF2            	   277:     bpl  _anon_z01_0
02:0002E0DA 7600            	   278:     moveq   #0,D3
02:0002E0DC 1600            	   279:     move.b  D0,D3
                            	   280:     ; Loop over the wares from 0 to 2.
                            	   281:     ;
02:0002E0DE 7400            	   282:     moveq   #0,D2
                            	   283:     even
                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E0E0 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E0E6 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E0EA 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E0EE 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E0F2 020000C0        	   294:     andi.b #$C0,D0
02:0002E0F6 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E0FA 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E100 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E104 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E108 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E10C 5203            	   304:     addq.b  #1,D3
02:0002E10E 5202            	   305:     addq.b  #1,D2
02:0002E110 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E114 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E116 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E11A E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E11C E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E11E E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E120 1214            	   315:     move.b  ($0000,A4),D1
02:0002E122 8001            	   316:     or.b  D1,D0
02:0002E124 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E126 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E12A E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E12C E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E12E E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E130 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E132 1214            	   326:     move.b  ($0000,A4),D1
02:0002E134 8001            	   327:     or.b  D1,D0
02:0002E136 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E138 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E13C E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E13E E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E140 1214            	   335:     move.b  ($0000,A4),D1
02:0002E142 8001            	   336:     or.b  D1,D0
02:0002E144 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E148 02000020        	   343:     andi.b #$20,D0
02:0002E14C 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E150 103C00FF        	   350:     move.b  #$FF,D0
02:0002E154 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E156 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E15A B001            	   355:     cmp.b   D1,D0
02:0002E15C 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E15E 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E162 123C002B        	   360:     move.b  #$2B,D1
02:0002E166 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E16A 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E16C 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E170 5303            	   364:     subq.b  #1,D3
02:0002E172 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_FoundPermutation:
                            	   368:     ; The index chooses the last offset of a permutation of three indexes.
                            	   369:     ;
02:0002E174 7400            	   370:     moveq   #0,D2
02:0002E176 41F90002E050    	   371:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E17C 14303000        	   372:     move.b  (A0,D3.W),D2
                            	   373:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   374:     ;
02:0002E180 7602            	   375:     moveq   #2,D3
                            	   376:     even
                            	   377: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E182 41F90002E03E    	   378:     lea     (MoneyGamePermutations).l,A0
02:0002E188 10302000        	   379:     move.b  (A0,D2.W),D0
02:0002E18C 41EC046C        	   380:     lea     ($046C,A4),A0
02:0002E190 11803000        	   381:     move.b  D0,(A0,D3.W)
02:0002E194 5302            	   382:     subq.b  #1,D2
02:0002E196 5303            	   383:     subq.b  #1,D3
02:0002E198 6AE8            	   384:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   385:     ; With the first bit of another random number, choose 10 or 40
                            	   386:     ; to put in [046F]. This is a random amount to lose.
                            	   387:     ;
02:0002E19A 102C001A        	   388:     move.b  ($001A,A4),D0
02:0002E19E 02000001        	   389:     andi.b #$01,D0
02:0002E1A2 7600            	   390:     moveq   #0,D3
02:0002E1A4 1600            	   391:     move.b  D0,D3
02:0002E1A6 41F90002E03C    	   392:     lea     (MoneyGameLossAmounts).l,A0
02:0002E1AC 10303000        	   393:     move.b  (A0,D3.W),D0
02:0002E1B0 1940046F        	   394:     move.b  D0,($046F,A4)
                            	   395:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   396:     ;
02:0002E1B4 700A            	   397:     moveq   #10,D0
02:0002E1B6 19400470        	   398:     move.b  D0,($0470,A4)
                            	   399:     ; With a different bit of the second random number,
                            	   400:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   401:     ;
02:0002E1BA 7614            	   402:     moveq   #20,D3
02:0002E1BC 102C001A        	   403:     move.b  ($001A,A4),D0
02:0002E1C0 02000002        	   404:     andi.b #$02,D0
02:0002E1C4 6702            	   405:     beq  _anon_z01_1
02:0002E1C6 7632            	   406:     moveq   #50,D3
                            	   407: _anon_z01_1:
