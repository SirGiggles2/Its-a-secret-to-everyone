02:0003D174 6612            	  8135:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003D176 E308            	  8136:     lsl.b  #1,D0   ; ASL A
02:0003D178 41EC03D0        	  8137:     lea     ($03D0,A4),A0
02:0003D17C 11802000        	  8138:     move.b  D0,(A0,D2.W)
