02:0003C09C 10342070        	  5805:     move.b  ($70,A4,D2.W),D0
02:0003C0A0 19803071        	  5806:     move.b  D0,($71,A4,D3.W)
02:0003C0A4 41EC0084        	  5807:     lea     ($0084,A4),A0
