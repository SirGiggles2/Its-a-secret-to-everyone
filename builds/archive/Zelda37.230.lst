                            	  7723: _anon_z05_156:
02:000449A6 101D            	  7724:     move.b  (A5)+,D0  ; PLA
                            	  7725:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7726:     ; then the player walked all the way to the edge of the play
                            	  7727:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7728:     ;
                            	  7729:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7730:     ; edge of the play area. So, set a relative position that
                            	  7731:     ; reflects that distance: $28 or -$28.
                            	  7732:     ;
                            	  7733:     ; If walking in a decreasing direction (left or up), then
                            	  7734:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7735:     ;
                            	  7736:     ; If walking in an increasing direction (right or down), then
                            	  7737:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7738:     ;
02:000449A8 02000007        	  7739:     andi.b #$07,D0
02:000449AC 0C000002        	  7740:     cmpi.b  #$02,D0
02:000449B0 6506            	  7741:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:000449B2 0C000005        	  7742:     cmpi.b  #$05,D0
02:000449B6 6502            	  7743:     bcs  _anon_z05_157
