02:0003CF52 11802000        	  7902:     move.b  D0,(A0,D2.W)
                            	  7903:     ; Look up the Y offset for the current direction.
                            	  7904:     ; Add it to object Y to set the destination Y of the jump.
                            	  7905:     ;
