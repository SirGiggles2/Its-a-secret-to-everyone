                            	 12975: Ganon_DrawBody:
                            	 12976:     ; Loop over four 16x16 images that make up Ganon.
                            	 12977:     ; There are 6 animation frames.
                            	 12978:     ;
02:0003F4FA 7603            	 12979:     moveq   #3,D3
                            	 12980:     even
                            	 12981: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12982:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12983:     ;
02:0003F4FC 10342070        	 12984:     move.b  ($70,A4,D2.W),D0
02:0003F500 023C00EE        	 12985:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F504 41F90003F4EE    	 12986:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F50A 12303000        	 12987:     move.b  (A0,D3.W),D1
02:0003F50E D101            	 12988:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F510 1880            	 12989:     move.b  D0,($0000,A4)
                            	 12990:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12991:     ;
02:0003F512 41EC0084        	 12992:     lea     ($0084,A4),A0
02:0003F516 10302000        	 12993:     move.b  (A0,D2.W),D0
02:0003F51A 023C00EE        	 12994:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F51E 41F90003F4F2    	 12995:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F524 12303000        	 12996:     move.b  (A0,D3.W),D1
02:0003F528 D101            	 12997:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F52A 19400001        	 12998:     move.b  D0,($0001,A4)
                            	 12999:     ; Each part has a horizontal flipping flag.
                            	 13000:     ;
02:0003F52E 41F90003F4F6    	 13001:     lea     (GanonSpriteHFlips).l,A0
02:0003F534 10303000        	 13002:     move.b  (A0,D3.W),D0
02:0003F538 1940000F        	 13003:     move.b  D0,($000F,A4)
                            	 13004:     ; Save and copy the loop index (the current part) to [07].
                            	 13005:     ;
02:0003F53C 1003            	 13006:     move.b  D3,D0
02:0003F53E 1B00            	 13007:     move.b  D0,-(A5)  ; PHA
02:0003F540 19400007        	 13008:     move.b  D0,($0007,A4)
                            	 13009:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13010:     ; that make it up.
                            	 13011:     ;
02:0003F544 41EC046B        	 13012:     lea     ($046B,A4),A0
02:0003F548 10302000        	 13013:     move.b  (A0,D2.W),D0
02:0003F54C E308            	 13014:     lsl.b  #1,D0   ; ASL A
02:0003F54E E308            	 13015:     lsl.b  #1,D0   ; ASL A
                            	 13016:     ; Add [07] -- the index of the current part.
                            	 13017:     ;
                            	 13018:     ; Now you have an index into the frame image table, for the
                            	 13019:     ; current image part of the current animation frame.
                            	 13020:     ;
02:0003F550 122C0007        	 13021:     move.b  ($0007,A4),D1
02:0003F554 D101            	 13022:     addx.b  D1,D0   ; ADC $07
02:0003F556 7600            	 13023:     moveq   #0,D3
02:0003F558 1600            	 13024:     move.b  D0,D3
02:0003F55A 41F90003F4D6    	 13025:     lea     (GanonFrameImages).l,A0
02:0003F560 10303000        	 13026:     move.b  (A0,D3.W),D0
02:0003F564 4EB900031800    	 13027:     jsr     DrawObjectNotMirrored
02:0003F56A 101D            	 13028:     move.b  (A5)+,D0  ; PLA
                            	 13029:     ; Bottom of the part loop.
                            	 13030:     ;
02:0003F56C 7600            	 13031:     moveq   #0,D3
02:0003F56E 1600            	 13032:     move.b  D0,D3
02:0003F570 5303            	 13033:     subq.b  #1,D3
02:0003F572 6A88            	 13034:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F574 4E75            	 13035:     rts
