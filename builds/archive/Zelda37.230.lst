02:00044C02 123C0020        	  8083:     move.b  #$20,D1
02:00044C06 D101            	  8084:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00044C08 6404            	  8085:     bcc  _anon_z05_169
02:00044C0A 522C0302        	  8086:     addq.b  #1,($0302,A4)
                            	  8087: _anon_z05_169:
02:00044C0E 5303            	  8088:     subq.b  #1,D3
02:00044C10 6AEC            	  8089:     bpl  _L_z05_PrepFullBlackRow_Add20H
02:00044C12 19400303        	  8090:     move.b  D0,($0303,A4)
02:00044C16 7060            	  8091:     moveq   #96,D0
02:00044C18 19400304        	  8092:     move.b  D0,($0304,A4)
02:00044C1C 7024            	  8093:     moveq   #36,D0
02:00044C1E 19400305        	  8094:     move.b  D0,($0305,A4)
02:00044C22 103C00FF        	  8095:     move.b  #$FF,D0
02:00044C26 19400306        	  8096:     move.b  D0,($0306,A4)
02:00044C2A 60C2            	  8097:     jmp     DecSubmenuScroll
