02:0003E720 7600            	 11062:     moveq   #0,D3
02:0003E722 162C04D7        	 11063:     move.b  ($04D7,A4),D3
02:0003E726 41F90004AAD6    	 11064:     lea     (LevelMasks).l,A0
02:0003E72C 10303000        	 11065:     move.b  (A0,D3.W),D0
02:0003E730 122C0511        	 11066:     move.b  ($0511,A4),D1
02:0003E734 8001            	 11067:     or.b  D1,D0
02:0003E736 19400511        	 11068:     move.b  D0,($0511,A4)
02:0003E73A 1880            	 11069:     move.b  D0,($0000,A4)
