02:0003DE02 41EC0098        	  9832:     lea     ($0098,A4),A0
02:0003DE06 10302000        	  9833:     move.b  (A0,D2.W),D0
02:0003DE0A 122C0002        	  9834:     move.b  ($0002,A4),D1
02:0003DE0E C200            	  9835:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE10 6704            	  9836:     beq  _anon_z04_118
