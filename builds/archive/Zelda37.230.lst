                            	  6133:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6134:     ;
02:0004C840 023C00EE        	  6135:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C844 122C0657        	  6136:     move.b  ($0657,A4),D1
