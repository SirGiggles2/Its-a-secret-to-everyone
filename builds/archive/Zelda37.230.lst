02:0003B432 123C001C        	  4192:     move.b  #$1C,D1
02:0003B436 0A3C0010        	  4193:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B43A 9101            	  4194:     subx.b  D1,D0   ; SBC #$1C
02:0003B43C 0A3C0010        	  4195:     eori    #$10,CCR  ; restore X = 6502 C
