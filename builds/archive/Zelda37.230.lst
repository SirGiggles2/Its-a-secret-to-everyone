02:00044C32 6022            	  8108:     jmp  L17295_Exit
                            	  8109: __far_z_05_0109:
                            	  8110:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8111:     ; and represents the current row of the submenu being processed.
                            	  8112:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8113:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  8114:     ;
                            	  8115:     ; If the bottom bit is set, go prepare the full black row.
                            	  8116:     ;
02:00044C34 E208            	  8117:     lsr.b  #1,D0   ; LSR A
02:00044C36 7600            	  8118:     moveq   #0,D3
02:00044C38 1600            	  8119:     move.b  D0,D3
02:00044C3A 6402            	  8120:     bcc.s  __far_z_05_0110
02:00044C3C 60B6            	  8121:     jmp  PrepFullBlackRow
                            	  8122: __far_z_05_0110:
                            	  8123:     ; There's nothing to do for row $15.
                            	  8124:     ; If submenu row < $15, cue a transfer of a triforce or other
                            	  8125:     ; transfer buffer for this row.
                            	  8126:     ;
02:00044C3E 0C000015        	  8127:     cmpi.b  #$15,D0
02:00044C42 640E            	  8128:     bcc  _anon_z05_170
02:00044C44 41F900044BA6    	  8129:     lea     (SubmenuTransferBufSelectorsOW).l,A0
