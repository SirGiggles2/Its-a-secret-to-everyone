                            	  3192:     ;
02:0003AD7E 003C0011        	  3193:     ori     #$11,CCR  ; SEC: set C+X
02:0003AD82 123C0001        	  3194:     move.b  #$01,D1
02:0003AD86 0A3C0010        	  3195:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
