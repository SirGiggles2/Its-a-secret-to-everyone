                            	  7872: __far_z_04_0069:
                            	  7873:     ; Go to state 1.
                            	  7874:     ;
02:0003CF18 41EC00AC        	  7875:     lea     ($00AC,A4),A0
02:0003CF1C 52302000        	  7876:     addq.b  #1,(A0,D2.W)
                            	  7877:     ; Subtract 1 from facing direction to make an index.
