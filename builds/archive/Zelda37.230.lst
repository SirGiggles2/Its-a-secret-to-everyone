02:00044482 003C0011        	  7410:     ori     #$11,CCR  ; SEC: set C+X
02:00044486 123C0040        	  7411:     move.b  #$40,D1
02:0004448A 0A3C0010        	  7412:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004448E 9101            	  7413:     subx.b  D1,D0   ; SBC #$40
02:00044490 0A3C0010        	  7414:     eori    #$10,CCR  ; restore X = 6502 C
02:00044494 E208            	  7415:     lsr.b  #1,D0   ; LSR A
02:00044496 E208            	  7416:     lsr.b  #1,D0   ; LSR A
02:00044498 E208            	  7417:     lsr.b  #1,D0   ; LSR A
