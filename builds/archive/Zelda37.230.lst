                            	  4796:     ;
02:00030FC4 7600            	  4797:     moveq   #0,D3
02:00030FC6 16342028        	  4798:     move.b  ($28,A4,D2.W),D3
                            	  4799:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4800:     ; Carry will have been set, because of the comparison (CPY).
                            	  4801:     ;
