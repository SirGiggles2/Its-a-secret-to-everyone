                            	  4215:     even
                            	  4216: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4217:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4218:     ;
                            	  4219:     ; To match a doorway:
                            	  4220:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4221:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4222:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4223:     ;
                            	  4224:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4225:     ; a doorway to be part of it.
                            	  4226:     ;
02:000420DC 102C0098        	  4227:     move.b  ($0098,A4),D0
02:000420E0 61000122        	  4228:     jsr     GetPlayerCoordsForDirection
02:000420E4 7603            	  4229:     moveq   #3,D3
                            	  4230:     even
