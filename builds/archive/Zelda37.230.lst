02:0003A20A 4EB90004D572    	  1502:     jsr     DestroyMonster
02:0003A210 612C            	  1503:     jsr     CreateChildGel
                            	  1504:     ; If the zol's direction is vertical, then set the first child gel's
                            	  1505:     ; direction to left, else up.
                            	  1506:     ;
02:0003A212 41EC0098        	  1507:     lea     ($0098,A4),A0
02:0003A216 10302000        	  1508:     move.b  (A0,D2.W),D0
02:0003A21A 0C000004        	  1509:     cmpi.b  #$04,D0
02:0003A21E 7002            	  1510:     moveq   #2,D0
02:0003A220 6402            	  1511:     bcc  _anon_z04_25
02:0003A222 7008            	  1512:     moveq   #8,D0
                            	  1513: _anon_z04_25:
02:0003A224 41EC0098        	  1514:     lea     ($0098,A4),A0
