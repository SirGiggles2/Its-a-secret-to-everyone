                            	  4204:     ; UNKNOWN:
                            	  4205:     ; This seems to be unused code triggered by object attribute $10.
                            	  4206:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4207:     ;
02:0004BB00 6100016C        	  4208:     jsr     ReverseObjDir
