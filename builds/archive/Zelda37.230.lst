02:0003DF76 6102            	 10023:     jsr     Gohma_DrawLegsOneSide
                            	 10024:     ; Draw the left legs.
                            	 10025:     ;
02:0003DF78 7600            	 10026:     moveq   #0,D3
                            	 10027: ; Params:
                            	 10028: ; Y: side: 0 for left, 1 for right
                            	 10029: ;
                            	 10030: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10031: ; store the sprite's X in [00].
                            	 10032: ;
                            	 10033:     even
                            	 10034: Gohma_DrawLegsOneSide:
02:0003DF7A 10342070        	 10035:     move.b  ($70,A4,D2.W),D0
02:0003DF7E 023C00EE        	 10036:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF82 41F90003DF58    	 10037:     lea     (GohmaLegOffsetsX).l,A0
02:0003DF88 12303000        	 10038:     move.b  (A0,D3.W),D1
02:0003DF8C D101            	 10039:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DF8E 1880            	 10040:     move.b  D0,($0000,A4)
                            	 10041:     ; The object's Y is the sprite's.
                            	 10042:     ;
02:0003DF90 41EC0084        	 10043:     lea     ($0084,A4),A0
02:0003DF94 10302000        	 10044:     move.b  (A0,D2.W),D0
02:0003DF98 19400001        	 10045:     move.b  D0,($0001,A4)
02:0003DF9C 612A            	 10046:     jsr     Gohma_SetSpriteAttributes
                            	 10047:     ; There are only two frame images for legs: left and right.
                            	 10048:     ; There are two animation frames. They are animated as follows:
                            	 10049:     ;
                            	 10050:     ; Frame 0:
                            	 10051:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10052:     ; horizontal flipping = frame number = 0
                            	 10053:     ; 
                            	 10054:     ; Frame 1:
                            	 10055:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10056:     ; horizontal flipping = frame number = 1
                            	 10057:     ;
02:0003DF9E 4EB90004CD60    	 10058:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFA4 1003            	 10059:     move.b  D3,D0
02:0003DFA6 023C00EE        	 10060:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFAA 41EC03E4        	 10061:     lea     ($03E4,A4),A0
02:0003DFAE 12302000        	 10062:     move.b  (A0,D2.W),D1
02:0003DFB2 D101            	 10063:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003DFB4 02000001        	 10064:     andi.b #$01,D0
02:0003DFB8 023C00EE        	 10065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFBC 123C0004        	 10066:     move.b  #$04,D1
02:0003DFC0 D101            	 10067:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DFC2 4EF900031800    	 10068:     jmp     DrawObjectNotMirrored
                            	 10069: 
                            	 10070: ; Returns:
