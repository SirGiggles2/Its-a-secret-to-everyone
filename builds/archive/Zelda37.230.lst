02:0003C88C 41F9000317C8    	  6924:     lea     (SpriteOffsets).l,A0
02:0003C892 10303000        	  6925:     move.b  (A0,D3.W),D0
02:0003C896 7600            	  6926:     moveq   #0,D3
02:0003C898 1600            	  6927:     move.b  D0,D3
02:0003C89A 101D            	  6928:     move.b  (A5)+,D0  ; PLA
02:0003C89C 41EC0201        	  6929:     lea     ($0201,A4),A0
02:0003C8A0 11803000        	  6930:     move.b  D0,(A0,D3.W)
02:0003C8A4 1014            	  6931:     move.b  ($0000,A4),D0
