02:0002EA32 003C0011        	  1644:     ori     #$11,CCR  ; SEC: set C+X
02:0002EA36 123C0010        	  1645:     move.b  #$10,D1
02:0002EA3A 0A3C0010        	  1646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EA3E 9101            	  1647:     subx.b  D1,D0   ; SBC #$10
02:0002EA40 0A3C0010        	  1648:     eori    #$10,CCR  ; restore X = 6502 C
