                            	  6133: _anon_z05_123:
                            	  6134:     ; Door command <> 4.
                            	  6135:     ; It must be 8, which means it was 7: open door.
                            	  6136:     ;
                            	  6137:     ; If the door is a shutter (7), then go add the door to the
                            	  6138:     ; opened door mask, reset door command, and lay out doors.
                            	  6139:     ;
02:000438EA 102C0055        	  6140:     move.b  ($0055,A4),D0
02:000438EE 19400002        	  6141:     move.b  D0,($0002,A4)
02:000438F2 6100FA32        	  6142:     jsr     FindDoorAttrByDoorBit
02:000438F6 0C000007        	  6143:     cmpi.b  #$07,D0
02:000438FA 676E            	  6144:     beq  _anon_z05_124
                            	  6145:     ; Else the door is not a shutter.
                            	  6146:     ;
                            	  6147:     ;
                            	  6148:     ; [09] door direction index
02:000438FC 7400            	  6149:     moveq   #0,D2
02:000438FE 142C0009        	  6150:     move.b  ($0009,A4),D2
02:00043902 6100DB3A        	  6151:     jsr     SetDoorFlag
                            	  6152:     ; Get the next room's ID.
                            	  6153:     ;
02:00043906 1003            	  6154:     move.b  D3,D0
02:00043908 023C00EE        	  6155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004390C 41F9000437C8    	  6156:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043912 12302000        	  6157:     move.b  (A0,D2.W),D1
02:00043916 D101            	  6158:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043918 7600            	  6159:     moveq   #0,D3
02:0004391A 1600            	  6160:     move.b  D0,D3
                            	  6161:     ; Flip the door direction index.
                            	  6162:     ;
02:0004391C 1002            	  6163:     move.b  D2,D0
02:0004391E 0A000001        	  6164:     eori.b #$01,D0
02:00043922 7400            	  6165:     moveq   #0,D2
02:00043924 1400            	  6166:     move.b  D0,D2
                            	  6167:     ; Set the door flag for the opposite door in the next room.
                            	  6168:     ;
02:00043926 1214            	  6169:     move.b  ($00,A4),D1   ; ptr lo
02:00043928 182C0001        	  6170:     move.b  ($01,A4),D4  ; ptr hi
02:0004392C 024100FF        	  6171:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043930 E14C            	  6172:     lsl.w   #8,D4
02:00043932 8841            	  6173:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043934 48C4            	  6174:     ext.l   D4
02:00043936 D8BC00FF0000    	  6175:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004393C 2044            	  6176:     movea.l D4,A0
02:0004393E 10303000        	  6177:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043942 41F90004AAD6    	  6178:     lea     (LevelMasks).l,A0
02:00043948 12302000        	  6179:     move.b  (A0,D2.W),D1
02:0004394C 8001            	  6180:     or.b  D1,D0
02:0004394E 1214            	  6181:     move.b  ($00,A4),D1   ; ptr lo
02:00043950 182C0001        	  6182:     move.b  ($01,A4),D4  ; ptr hi
02:00043954 024100FF        	  6183:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043958 E14C            	  6184:     lsl.w   #8,D4
02:0004395A 8841            	  6185:     or.w    D1,D4
02:0004395C 48C4            	  6186:     ext.l   D4
