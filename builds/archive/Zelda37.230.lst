02:0003C9BE 123C0001        	  7071:     move.b  #$01,D1
02:0003C9C2 D101            	  7072:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003C9C4 41EC0437        	  7073:     lea     ($0437,A4),A0
02:0003C9C8 11802000        	  7074:     move.b  D0,(A0,D2.W)
