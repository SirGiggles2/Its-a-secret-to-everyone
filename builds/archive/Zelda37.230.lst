                            	  7090: __far_z_04_0060:
                            	  7091:     ; New bloated substate >= 2.
                            	  7092:     ;
                            	  7093:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7094:     ; which will transition to state 0 (moving).
                            	  7095:     ;
                            	  7096:     ; Note that if the bomb hits >= 2, then:
                            	  7097:     ; - If new substate = 2, then substate 2 will wait,
                            	  7098:     ;   and then transition to substate 3.
                            	  7099:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7100:     ;
02:0003C9E6 7600            	  7101:     moveq   #0,D3
02:0003C9E8 41EC0437        	  7102:     lea     ($0437,A4),A0
02:0003C9EC 16302000        	  7103:     move.b  (A0,D2.W),D3
02:0003C9F0 0C030002        	  7104:     cmpi.b  #$02,D3
02:0003C9F4 6502            	  7105:     bcs.s  __far_z_04_0061
02:0003C9F6 600A            	  7106:     jmp  L_Dodongo_DecrementBloatedTimer
