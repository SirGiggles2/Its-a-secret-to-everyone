                            	  3145:     even
                            	  3146: _L_z05_MaskInputInBorder_ExcludeNone:
                            	  3147:     ; The coordinate is not crossed; then set mask $FF,
                            	  3148:     ; so that no button is excluded.
                            	  3149:     ;
02:0004197C 103C00FF        	  3150:     move.b  #$FF,D0
02:00041980 19400001        	  3151:     move.b  D0,($0001,A4)
                            	  3152:     even
