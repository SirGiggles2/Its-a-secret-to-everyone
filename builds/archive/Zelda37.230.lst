02:0003C560 0A3C0010        	  6496:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C564 9101            	  6497:     subx.b  D1,D0   ; SBC $03
02:0003C566 0A3C0010        	  6498:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C56A 19802070        	  6499:     move.b  D0,($70,A4,D2.W)
                            	  6500:     even
