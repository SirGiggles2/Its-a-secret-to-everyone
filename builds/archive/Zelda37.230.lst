02:00031F46 41EC0084        	  6746:     lea     ($0084,A4),A0
02:00031F4A 10303000        	  6747:     move.b  (A0,D3.W),D0
02:00031F4E 023C00EE        	  6748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F52 123C0008        	  6749:     move.b  #$08,D1
02:00031F56 D101            	  6750:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6751: ; Params:
                            	  6752: ; A: weapon object mid Y
