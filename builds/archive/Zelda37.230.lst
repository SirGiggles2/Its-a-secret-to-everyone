                            	 14255:     ;
02:0003FD6A 41EC0394        	 14256:     lea     ($0394,A4),A0
02:0003FD6E 10302000        	 14257:     move.b  (A0,D2.W),D0
02:0003FD72 02000018        	 14258:     andi.b #$18,D0
02:0003FD76 0C000010        	 14259:     cmpi.b  #$10,D0
02:0003FD7A 6536            	 14260:     bcs  _L_z04_RotateObjectLocation_AddToX
