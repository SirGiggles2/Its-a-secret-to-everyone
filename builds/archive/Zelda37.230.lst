                            	  3010: Link_FilterInput:
                            	  3011:     ; [00] holds the opposite of Link's facing direction.
                            	  3012:     ;
02:000418A6 102C0098        	  3013:     move.b  ($0098,A4),D0
02:000418AA 4EB900030CAC    	  3014:     jsr     GetOppositeDir
02:000418B0 1880            	  3015:     move.b  D0,($0000,A4)
                            	  3016:     ; Call GetOppositeDir again to use this mapping:
                            	  3017:     ; In Dir: 1 2 4 8
                            	  3018:     ;         -------
                            	  3019:     ; Index:  2 3 0 1
                            	  3020:     ;
02:000418B2 4EB900030CAC    	  3021:     jsr     GetOppositeDir
                            	  3022:     ; Get the appropriate coordinate for the direction:
                            	  3023:     ; X for horizontal
                            	  3024:     ; Y for vertical
                            	  3025:     ;
02:000418B8 102C0070        	  3026:     move.b  ($0070,A4),D0
02:000418BC 0C030002        	  3027:     cmpi.b  #$02,D3
02:000418C0 6404            	  3028:     bcc  _anon_z05_74
02:000418C2 102C0084        	  3029:     move.b  ($0084,A4),D0
                            	  3030: _anon_z05_74:
02:000418C6 19400002        	  3031:     move.b  D0,($0002,A4)
                            	  3032:     ; Mask A button and directions if inner border is crossed.
                            	  3033:     ;
02:000418CA 1003            	  3034:     move.b  D3,D0
02:000418CC 1B00            	  3035:     move.b  D0,-(A5)  ; PHA
02:000418CE 023C00EE        	  3036:     andi    #$EE,CCR  ; CLC: clear C+X
02:000418D2 123C0008        	  3037:     move.b  #$08,D1
02:000418D6 D101            	  3038:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000418D8 7600            	  3039:     moveq   #0,D3
02:000418DA 1600            	  3040:     move.b  D0,D3
02:000418DC 103C0080        	  3041:     move.b  #$80,D0
02:000418E0 6134            	  3042:     jsr     MaskInputInBorder
02:000418E2 101D            	  3043:     move.b  (A5)+,D0  ; PLA
02:000418E4 7600            	  3044:     moveq   #0,D3
02:000418E6 1600            	  3045:     move.b  D0,D3
                            	  3046:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3047:     ; boundary using player's direction and reverse direction index.
                            	  3048:     ;
02:000418E8 102C0001        	  3049:     move.b  ($0001,A4),D0
02:000418EC 0C0000FF        	  3050:     cmpi.b  #$FF,D0
02:000418F0 660C            	  3051:     bne  _anon_z05_75
02:000418F2 102C0098        	  3052:     move.b  ($0098,A4),D0
02:000418F6 1880            	  3053:     move.b  D0,($0000,A4)
02:000418F8 4EB900030CAC    	  3054:     jsr     GetOppositeDir
                            	  3055: _anon_z05_75:
                            	  3056:     ; If in UW, use the second set of bounds by adding 4
                            	  3057:     ; to reverse direction index.
                            	  3058:     ;
                            	  3059:     ; Else in OW, and use first set that begins at offset 0.
                            	  3060:     ;
02:000418FE 102C0010        	  3061:     move.b  ($0010,A4),D0
02:00041902 6710            	  3062:     beq  _anon_z05_76
02:00041904 1003            	  3063:     move.b  D3,D0
02:00041906 023C00EE        	  3064:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004190A 123C0004        	  3065:     move.b  #$04,D1
02:0004190E D101            	  3066:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041910 7600            	  3067:     moveq   #0,D3
02:00041912 1600            	  3068:     move.b  D0,D3
                            	  3069: _anon_z05_76:
                            	  3070:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3071:     ;
02:00041914 7000            	  3072:     moveq   #0,D0
                            	  3073: ; Params:
                            	  3074: ; A: mask of buttons to block
                            	  3075: ; Y: offset into BorderBounds
                            	  3076: ; [00]: direction
                            	  3077: ; [02]: coordinate
                            	  3078: ;
                            	  3079: ; Returns:
                            	  3080: ; [01]: button mask that was used
                            	  3081: ;       (set to $FF if boundary not crossed)
                            	  3082: ;
                            	  3083:     even
                            	  3084: MaskInputInBorder:
02:00041916 19400001        	  3085:     move.b  D0,($0001,A4)
                            	  3086:     ; If direction is positive (right or down), then go handle it separately.
                            	  3087:     ;
02:0004191A 1014            	  3088:     move.b  ($0000,A4),D0
02:0004191C 0200000A        	  3089:     andi.b #$0A,D0
02:00041920 6748            	  3090:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3091:     ; The direction is negative (left or up).
                            	  3092:     ;
                            	  3093:     ; If the coordinate does not cross (<) the boundary, then
                            	  3094:     ; go set mask $FF, so that no button is excluded.
                            	  3095:     ;
02:00041922 102C0002        	  3096:     move.b  ($0002,A4),D0
02:00041926 41F90004189A    	  3097:     lea     (BorderBounds).l,A0
02:0004192C 12303000        	  3098:     move.b  (A0,D3.W),D1
02:00041930 B001            	  3099:     cmp.b   D1,D0
02:00041932 6548            	  3100:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3101:     even
                            	  3102: _L_z05_MaskInputInBorder_MaskButtons:
                            	  3103:     ; The boundary was crossed. Mask buttons.
                            	  3104:     ;
02:00041934 102C00F8        	  3105:     move.b  ($00F8,A4),D0
02:00041938 122C0001        	  3106:     move.b  ($0001,A4),D1
02:0004193C C001            	  3107:     and.b  D1,D0
02:0004193E 194000F8        	  3108:     move.b  D0,($00F8,A4)
                            	  3109:     ; If in OW or button mask <> 0, return.
                            	  3110:     ;
02:00041942 102C0010        	  3111:     move.b  ($0010,A4),D0
02:00041946 6720            	  3112:     beq  _L_z05_MaskInputInBorder_Exit
02:00041948 102C0001        	  3113:     move.b  ($0001,A4),D0
02:0004194C 661A            	  3114:     bne  _L_z05_MaskInputInBorder_Exit
                            	  3115:     ; Mask off input directions perpendicular to player's facing.
                            	  3116:     ;
02:0004194E 760C            	  3117:     moveq   #12,D3
02:00041950 102C0098        	  3118:     move.b  ($0098,A4),D0
02:00041954 0200000C        	  3119:     andi.b #$0C,D0
02:00041958 6602            	  3120:     bne  _anon_z05_77
02:0004195A 7603            	  3121:     moveq   #3,D3
                            	  3122: _anon_z05_77:
02:0004195C 1003            	  3123:     move.b  D3,D0
02:0004195E 122C03F8        	  3124:     move.b  ($03F8,A4),D1
02:00041962 C001            	  3125:     and.b  D1,D0
02:00041964 194003F8        	  3126:     move.b  D0,($03F8,A4)
                            	  3127:     even
