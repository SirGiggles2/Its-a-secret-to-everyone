                            	  4787:     ; The effect involves turning grayscale rendering on and off
                            	  4788:     ; in PPUMASK.
                            	  4789:     ;
                            	  4790:     ; Start by setting A register to the PPU mask shifted right to
                            	  4791:     ; throw away the grayscale bit.
                            	  4792:     ;
