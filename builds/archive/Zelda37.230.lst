                            	 11042: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E6F8 101D            	 11043:     move.b  (A5)+,D0  ; PLA
02:0003E6FA 7400            	 11044:     moveq   #0,D2
02:0003E6FC 1400            	 11045:     move.b  D0,D2
                            	 11046:     ; Hide the original head's sprite, and the base segment's sprite.
