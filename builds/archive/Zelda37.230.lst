                            	   223: UpdateMenuCommon1:
02:00040014 4EB90004A932    	   224:     jsr     HideAllSprites
02:0004001A 4EB900030FEE    	   225:     jsr     UpdatePlayerPositionMarker
02:00040020 4EB90004AA4E    	   226:     jsr     UpdateTriforcePositionMarker
                            	   227:     ; Move position markers and hardware vertical scroll position
                            	   228:     ; down 1 pixel.
                            	   229:     ;
                            	   230:     ; Because we'll be above the top of NT 0, switch to NT 2 to
                            	   231:     ; be at the bottom of NT 2.
                            	   232:     ;
02:00040026 103C00EF        	   233:     move.b  #$EF,D0
02:0004002A 194000FC        	   234:     move.b  D0,($00FC,A4)
02:0004002E 1940005C        	   235:     move.b  D0,($005C,A4)
02:00040032 7001            	   236:     moveq   #1,D0
02:00040034 610001A4        	   237:     jsr     MovePositionMarkers
02:00040038 522C00E1        	   238:     addq.b  #1,($00E1,A4)
                            	   239:     ; SubmenuScrollProgress begins at $2B. Each frame it will be
                            	   240:     ; decremented. It encodes a submenu row index in bits 1 to 7,
                            	   241:     ; and a flag in bit 0.
                            	   242:     ;
                            	   243:     ; When the flag is 1, a full row of black tiles will be transferred
                            	   244:     ; at the current row. Otherwise, one of various static visual
                            	   245:     ; elements will be transferred.
                            	   246:     ;
                            	   247:     ; For example:
                            	   248:     ; 1. In the first frame of scrolling, $2B indicates that a full row
                            	   249:     ;    of black tiles must be transferred to row $15.
                            	   250:     ; 2. In the second frame ($2A), submenu row will again be
                            	   251:     ;    $15, but something else will be transferred.
                            	   252:     ; 3. In the third frame ($29), a full row of black tiles will be
                            	   253:     ;    transferred to row $14.
                            	   254:     ;
02:0004003C 702B            	   255:     moveq   #43,D0
02:0004003E 1940005E        	   256:     move.b  D0,($005E,A4)
                            	   257:     ; In UW, this variable will be used to scan every room in order
                            	   258:     ; to build the big sheet map in the submenu. It will range
                            	   259:     ; from $7F to 0.
                            	   260:     ;
02:00040042 707F            	   261:     moveq   #127,D0
02:00040044 1940005D        	   262:     move.b  D0,($005D,A4)
                            	   263:     even
                            	   264: UpdateMenu_Return:
02:00040048 4E75            	   265:     rts
                            	   266: 
                            	   267:     even
                            	   268: UpdateMenuCommon2:
                            	   269:     ; Cue the transfer of first set of submenu nametable attributes to NT 2.
                            	   270:     ; Advance state.
                            	   271:     ;
02:0004004A 7048            	   272:     moveq   #72,D0
                            	   273:     even
                            	   274: SelectTransferBufAndIncState:
02:0004004C 4EF90002BEB0    	   275:     jmp     c_select_transfer_buf_and_inc_state
                            	   276: 
                            	   277: _anon_z05_1:
02:00040052 522C00E1        	   278:     addq.b  #1,($00E1,A4)
02:00040056 4E75            	   279:     rts
                            	   280: 
                            	   281:     even
                            	   282: UpdateMenuCommon3:
                            	   283:     ; Cue the transfer of second set of submenu nametable attributes to NT 2.
                            	   284:     ; Advance state.
                            	   285:     ;
02:00040058 704A            	   286:     moveq   #74,D0
02:0004005A 6702            	   287:     beq.s  __far_z_05_0000
02:0004005C 60EE            	   288:     jmp  SelectTransferBufAndIncState
                            	   289: __far_z_05_0000:
                            	   290:     even
                            	   291: UpdateMenuCommon4:
                            	   292:     ; Cue the transfer of a blank row of tiles to the bottom of NT 2.
                            	   293:     ; Advance state.
                            	   294:     ;
02:0004005E 704C            	   295:     moveq   #76,D0
02:00040060 6702            	   296:     beq.s  __far_z_05_0001
02:00040062 60E8            	   297:     jmp  SelectTransferBufAndIncState
                            	   298: __far_z_05_0001:
                            	   299:     even
                            	   300: UpdateMenu5UW:
02:00040064 61004B56        	   301:     jsr     Submenu_CueTransferRowUW
02:00040068 60E8            	   302:     jmp     _anon_z05_1
                            	   303: 
                            	   304:     even
                            	   305: UpdateMenu5OW:
                            	   306:     ; Cue the transfer of "TRIFORCE" text.
                            	   307:     ;
02:0004006A 705C            	   308:     moveq   #92,D0
02:0004006C 6702            	   309:     beq.s  __far_z_05_0002
02:0004006E 60DC            	   310:     jmp  SelectTransferBufAndIncState
                            	   311: __far_z_05_0002:
                            	   312:     even
                            	   313: UpdateMenuScrollDownOW:
02:00040070 61004BBA        	   314:     jsr     Submenu_CueTransferRowOW
02:00040074 6004            	   315:     jmp     _anon_z05_2
                            	   316: 
                            	   317:     even
                            	   318: UpdateMenuScrollDownUW:
02:00040076 61004B44        	   319:     jsr     Submenu_CueTransferRowUW
                            	   320: _anon_z05_2:
                            	   321:     ; Move position markers and advance nametable scrolling;
                            	   322:     ; so that we scroll down 3 pixels.
                            	   323:     ;
02:0004007A 7003            	   324:     moveq   #3,D0
02:0004007C 6100015C        	   325:     jsr     MovePositionMarkers
02:00040080 102C00FC        	   326:     move.b  ($00FC,A4),D0
02:00040084 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:00040088 123C0003        	   328:     move.b  #$03,D1
02:0004008C 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040090 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:00040092 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:00040096 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:0004009A 0C000041        	   335:     cmpi.b  #$41,D0
02:0004009E 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
                            	   338:     ; Advance the submenu state.
                            	   339:     ; If in OW or in a cellar, we're done. Return.
                            	   340:     ;
02:000400A2 522C00E1        	   341:     addq.b  #1,($00E1,A4)
02:000400A6 102C0010        	   342:     move.b  ($0010,A4),D0
02:000400AA 67000084        	   343:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:000400AE 102C0012        	   344:     move.b  ($0012,A4),D0
02:000400B2 0C000009        	   345:     cmpi.b  #$09,D0
02:000400B6 6778            	   346:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   347:     ; Calculate the X coordinate of the submenu position marker.
                            	   348:     ;
                            	   349:     ; First, mask off the high nibble of the room ID and multiply by
                            	   350:     ; the width of a tile, 8. Store the result in [00].
                            	   351:     ;
02:000400B8 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:000400BC 0200000F        	   353:     andi.b #$0F,D0
02:000400C0 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:000400C2 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:000400C4 E308            	   356:     lsl.b  #1,D0   ; ASL A
02:000400C6 1880            	   357:     move.b  D0,($0000,A4)
                            	   358:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   359:     ; negative or left rotation by ($10 - rotation value).
                            	   360:     ;
                            	   361:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   362:     ; the width of a tile. Then negate it. The final result is the
                            	   363:     ; negative offset.
                            	   364:     ;
02:000400C8 103900FF6BAB    	   365:     move.b  (NES_SRAM+$0BAB).l,D0
02:000400CE 0C000008        	   366:     cmpi.b  #$08,D0
02:000400D2 6520            	   367:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:000400D4 7010            	   368:     moveq   #16,D0
02:000400D6 123900FF6BAB    	   369:     move.b  (NES_SRAM+$0BAB).l,D1
02:000400DC 0A3C0010        	   370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000400E0 9101            	   371:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:000400E2 0A3C0010        	   372:     eori    #$10,CCR  ; restore X = 6502 C
02:000400E6 E308            	   373:     lsl.b  #1,D0   ; ASL A
02:000400E8 E308            	   374:     lsl.b  #1,D0   ; ASL A
02:000400EA E308            	   375:     lsl.b  #1,D0   ; ASL A
02:000400EC 4EB900030CB4    	   376:     jsr     Negate
02:000400F2 6006            	   377:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   378: 
                            	   379:     even
                            	   380: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   381:     ; The submenu map's rotation < 8.
                            	   382:     ; It represents the number of tiles to move right.
                            	   383:     ; So, multiply it by 8.
                            	   384:     ;
02:000400F4 E308            	   385:     lsl.b  #1,D0   ; ASL A
02:000400F6 E308            	   386:     lsl.b  #1,D0   ; ASL A
02:000400F8 E308            	   387:     lsl.b  #1,D0   ; ASL A
                            	   388:     even
                            	   389: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   390:     ; Add the offset we calculated, and $62 to [00] to get
                            	   391:     ; the position marker's X coordinate.
                            	   392:     ;
02:000400FA 023C00EE        	   393:     andi    #$EE,CCR  ; CLC: clear C+X
02:000400FE 1214            	   394:     move.b  ($0000,A4),D1
02:00040100 D101            	   395:     addx.b  D1,D0   ; ADC $00
02:00040102 023C00EE        	   396:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040106 123C0062        	   397:     move.b  #$62,D1
02:0004010A D101            	   398:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:0004010C 19400253        	   399:     move.b  D0,($0253,A4)
                            	   400:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   401:     ; Divide by 2 to get a multiple of the tile height.
                            	   402:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   403:     ;
02:00040110 102C00EB        	   404:     move.b  ($00EB,A4),D0
02:00040114 020000F0        	   405:     andi.b #$F0,D0
02:00040118 E208            	   406:     lsr.b  #1,D0   ; LSR A
02:0004011A 123C0069        	   407:     move.b  #$69,D1
02:0004011E D101            	   408:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040120 19400250        	   409:     move.b  D0,($0250,A4)
                            	   410:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   411:     ;
02:00040124 703E            	   412:     moveq   #62,D0
02:00040126 19400251        	   413:     move.b  D0,($0251,A4)
02:0004012A 7000            	   414:     moveq   #0,D0
02:0004012C 19400252        	   415:     move.b  D0,($0252,A4)
                            	   416:     even
                            	   417: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040130 4E75            	   418:     rts
                            	   419: 
                            	   420:     even
                            	   421: UpdateMenuActive:
02:00040132 6100520A        	   422:     jsr     DrawSubmenuItems
02:00040136 610052CE        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:0004013A 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:0004013E 02000088        	   430:     andi.b #$88,D0
02:00040142 0C000088        	   431:     cmpi.b  #$88,D0
02:00040146 661A            	   432:     bne  _anon_z05_3
02:00040148 4EB90004B314    	   433:     jsr     EndGameMode
02:0004014E 194000E1        	   434:     move.b  D0,($00E1,A4)
02:00040152 7008            	   435:     moveq   #8,D0
02:00040154 19400012        	   436:     move.b  D0,($0012,A4)
02:00040158 7000            	   437:     moveq   #0,D0
02:0004015A 19400619        	   438:     move.b  D0,($0619,A4)
02:0004015E 600012D6        	   439:     jmp     SilenceSound
                            	   440: 
                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:00040162 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:00040166 02000010        	   446:     andi.b #$10,D0
02:0004016A 6606            	   447:     bne.s  __far_z_05_0003
02:0004016C 4EF90002D342    	   448:     jmp  Exit
                            	   449: __far_z_05_0003:
02:00040172 102C0254        	   450:     move.b  ($0254,A4),D0
02:00040176 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:00040178 102C0258        	   452:     move.b  ($0258,A4),D0
02:0004017C 1B00            	   453:     move.b  D0,-(A5)  ; PHA
02:0004017E 4EB90004A932    	   454:     jsr     HideAllSprites
02:00040184 101D            	   455:     move.b  (A5)+,D0  ; PLA
02:00040186 19400258        	   456:     move.b  D0,($0258,A4)
02:0004018A 101D            	   457:     move.b  (A5)+,D0  ; PLA
02:0004018C 19400254        	   458:     move.b  D0,($0254,A4)
02:00040190 522C00E1        	   459:     addq.b  #1,($00E1,A4)
02:00040194 0A3C0001        	   460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040198 4E75            	   461:     rts
                            	   462: 
                            	   463:     even
                            	   464: UpdateMenuScrollUp:
                            	   465:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   466:     ;
02:0004019A 103C00FD        	   467:     move.b  #$FD,D0
02:0004019E 613A            	   468:     jsr     MovePositionMarkers
02:000401A0 102C00FC        	   469:     move.b  ($00FC,A4),D0
02:000401A4 023C00EE        	   470:     andi    #$EE,CCR  ; CLC: clear C+X
02:000401A8 123C0003        	   471:     move.b  #$03,D1
02:000401AC D101            	   472:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000401AE 194000FC        	   473:     move.b  D0,($00FC,A4)
                            	   474:     ; If hardware vertical scroll still < $F0, then return.
                            	   475:     ;
02:000401B2 0C0000F0        	   476:     cmpi.b  #$F0,D0
02:000401B6 6406            	   477:     bcc.s  __far_z_05_0004
02:000401B8 4EF90002D342    	   478:     jmp  Exit
                            	   479: __far_z_05_0004:
                            	   480:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   481:     ;
02:000401BE 1940005C        	   482:     move.b  D0,($005C,A4)
                            	   483:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   484:     ;
                            	   485:     ; UNKNOWN: But why not do this in OW, too?
                            	   486:     ;
02:000401C2 102C0010        	   487:     move.b  ($0010,A4),D0
02:000401C6 6706            	   488:     beq  _anon_z05_4
02:000401C8 4EB900031522    	   489:     jsr     WriteBlankPrioritySprites
                            	   490: _anon_z05_4:
                            	   491:     ; We reached the end. So, reset hardware vertical scroll
                            	   492:     ; and submenu state.
