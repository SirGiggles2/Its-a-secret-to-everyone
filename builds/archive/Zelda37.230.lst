02:0003045C 10342070        	  3024:     move.b  ($70,A4,D2.W),D0
                            	  3025:     even
                            	  3026: _L_z01_UpdateTrap_Full_GoToState1:
02:00030460 41EC0380        	  3027:     lea     ($0380,A4),A0
02:00030464 11802000        	  3028:     move.b  D0,(A0,D2.W)
                            	  3029:     ; Set facing direction to the horizontal one that we determined.
                            	  3030:     ;
02:00030468 1003            	  3031:     move.b  D3,D0
02:0003046A 41EC0098        	  3032:     lea     ($0098,A4),A0
02:0003046E 11802000        	  3033:     move.b  D0,(A0,D2.W)
                            	  3034:     ; If the direction we determined is not allowed for this trap, then
                            	  3035:     ; go draw and check collisions.
