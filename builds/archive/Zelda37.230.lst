02:0003AD8C 0A3C0010        	  3197:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AD90 E308            	  3198:     lsl.b  #1,D0   ; ASL A
02:0003AD92 023C00EE        	  3199:     andi    #$EE,CCR  ; CLC: clear C+X
