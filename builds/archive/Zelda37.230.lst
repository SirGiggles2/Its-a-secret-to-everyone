                            	  5213: Wallmaster_PrepareToDraw:
02:0003BBC6 4EF90002BEFA    	  5214:     jmp     c_wallmaster_prepare_to_draw
                            	  5215: 
                            	  5216: Wallmaster_CalcStartPosition:
02:0003BBCC 41EC0412        	  5217:     lea     ($0412,A4),A0
02:0003BBD0 11802000        	  5218:     move.b  D0,(A0,D2.W)
02:0003BBD4 19430003        	  5219:     move.b  D3,($0003,A4)
                            	  5220:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5221:     ;
02:0003BBD8 7024            	  5222:     moveq   #36,D0
02:0003BBDA 7600            	  5223:     moveq   #0,D3
02:0003BBDC 162C03F8        	  5224:     move.b  ($03F8,A4),D3
02:0003BBE0 6702            	  5225:     beq  _anon_z04_70
02:0003BBE2 7032            	  5226:     moveq   #50,D0
                            	  5227: _anon_z04_70:
                            	  5228:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5229:     ; 1. negate the distance
                            	  5230:     ; 2. add 8 to the instruction offset to access
                            	  5231:     ;    the opposite direction for the same wall
                            	  5232:     ;
02:0003BBE4 7600            	  5233:     moveq   #0,D3
02:0003BBE6 162C0098        	  5234:     move.b  ($0098,A4),D3
02:0003BBEA 122C0002        	  5235:     move.b  ($0002,A4),D1
02:0003BBEE B601            	  5236:     cmp.b   D1,D3
02:0003BBF0 662A            	  5237:     bne  _anon_z04_71
02:0003BBF2 1B00            	  5238:     move.b  D0,-(A5)  ; PHA
02:0003BBF4 41EC0412        	  5239:     lea     ($0412,A4),A0
02:0003BBF8 10302000        	  5240:     move.b  (A0,D2.W),D0
02:0003BBFC 023C00EE        	  5241:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC00 123C0008        	  5242:     move.b  #$08,D1
02:0003BC04 D101            	  5243:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BC06 41EC0412        	  5244:     lea     ($0412,A4),A0
02:0003BC0A 11802000        	  5245:     move.b  D0,(A0,D2.W)
02:0003BC0E 101D            	  5246:     move.b  (A5)+,D0  ; PLA
02:0003BC10 4600            	  5247:     eori.b #$FF,D0
02:0003BC12 023C00EE        	  5248:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC16 123C0001        	  5249:     move.b  #$01,D1
02:0003BC1A D101            	  5250:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5251: _anon_z04_71:
                            	  5252:     ; Add the distance and Link's minor coordinate to calculate
                            	  5253:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5254:     ; In general, the monster will be put in front of Link.
                            	  5255:     ;
02:0003BC1C 023C00EE        	  5256:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC20 1214            	  5257:     move.b  ($0000,A4),D1
02:0003BC22 D101            	  5258:     addx.b  D1,D0   ; ADC $00
02:0003BC24 19400004        	  5259:     move.b  D0,($0004,A4)
                            	  5260:     ; By default, will return index 0 to choose the minimum value
                            	  5261:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5262:     ; if Link is at the wall with a smaller major coordinate.
                            	  5263:     ;
02:0003BC28 7600            	  5264:     moveq   #0,D3
                            	  5265:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5266:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5267:     ; to access the block for the other direction along the same axis,
                            	  5268:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5269:     ;
02:0003BC2A 102C0001        	  5270:     move.b  ($0001,A4),D0
02:0003BC2E 122C0003        	  5271:     move.b  ($0003,A4),D1
02:0003BC32 B001            	  5272:     cmp.b   D1,D0
02:0003BC34 671C            	  5273:     beq  _anon_z04_72
02:0003BC36 41EC0412        	  5274:     lea     ($0412,A4),A0
02:0003BC3A 10302000        	  5275:     move.b  (A0,D2.W),D0
02:0003BC3E 023C00EE        	  5276:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC42 123C0010        	  5277:     move.b  #$10,D1
02:0003BC46 D101            	  5278:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BC48 41EC0412        	  5279:     lea     ($0412,A4),A0
02:0003BC4C 11802000        	  5280:     move.b  D0,(A0,D2.W)
02:0003BC50 5203            	  5281:     addq.b  #1,D3
                            	  5282: _anon_z04_72:
02:0003BC52 4E75            	  5283:     rts
                            	  5284: 
