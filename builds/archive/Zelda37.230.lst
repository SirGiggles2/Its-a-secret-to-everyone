02:000436DC 182C0003        	  5845:     move.b  ($03,A4),D4  ; ptr hi
02:000436E0 024100FF        	  5846:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000436E4 E14C            	  5847:     lsl.w   #8,D4
02:000436E6 8841            	  5848:     or.w    D1,D4             ; D4 = NES ptr addr
02:000436E8 48C4            	  5849:     ext.l   D4
