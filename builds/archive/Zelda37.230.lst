02:0003BB34 41F9000317C8    	  5139:     lea     (SpriteOffsets).l,A0
02:0003BB3A 10303000        	  5140:     move.b  (A0,D3.W),D0
02:0003BB3E 1880            	  5141:     move.b  D0,($0000,A4)
02:0003BB40 41F9000317C9    	  5142:     lea     (SpriteOffsets+1).l,A0
02:0003BB46 10303000        	  5143:     move.b  (A0,D3.W),D0
                            	  5144:     even
                            	  5145: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003BB4A 19400001        	  5146:     move.b  D0,($0001,A4)
02:0003BB4E 61000104        	  5147:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5148:     ; The default image is the hand open.
                            	  5149:     ; If animation frame = 0, then return.
                            	  5150:     ;
02:0003BB52 7400            	  5151:     moveq   #0,D2
02:0003BB54 142C0340        	  5152:     move.b  ($0340,A4),D2
02:0003BB58 41EC03E4        	  5153:     lea     ($03E4,A4),A0
02:0003BB5C 10302000        	  5154:     move.b  (A0,D2.W),D0
02:0003BB60 6724            	  5155:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5156:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5157:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5158:     ; The right side is correctly the right side of a closed hand.
                            	  5159:     ; But the left side is Keese. So, we have to patch the left
                            	  5160:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5161:     ;
                            	  5162:     ; Keep in mind that left and right sprites might be flipped.
                            	  5163:     ;
02:0003BB62 7600            	  5164:     moveq   #0,D3
02:0003BB64 1614            	  5165:     move.b  ($0000,A4),D3
02:0003BB66 41EC0201        	  5166:     lea     ($0201,A4),A0
02:0003BB6A 10303000        	  5167:     move.b  (A0,D3.W),D0
02:0003BB6E 0C00009C        	  5168:     cmpi.b  #$9C,D0
02:0003BB72 6706            	  5169:     beq  _anon_z04_68
02:0003BB74 7600            	  5170:     moveq   #0,D3
02:0003BB76 162C0001        	  5171:     move.b  ($0001,A4),D3
                            	  5172: _anon_z04_68:
02:0003BB7A 103C00AC        	  5173:     move.b  #$AC,D0
02:0003BB7E 41EC0201        	  5174:     lea     ($0201,A4),A0
02:0003BB82 11803000        	  5175:     move.b  D0,(A0,D3.W)
                            	  5176:     even
