02:0003C080 0C000041        	  5789:     cmpi.b  #$41,D0
02:0003C084 66F0            	  5790:     bne  _anon_z04_80
                            	  5791:     ; I don't know why the object timer of the tail segment that will
                            	  5792:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5793:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5794:     ; there, the object timer is set to 6.
                            	  5795:     ;
02:0003C086 7011            	  5796:     moveq   #17,D0
02:0003C088 19803029        	  5797:     move.b  D0,($29,A4,D3.W)
                            	  5798:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5799:     ; segment to the tail segment.
