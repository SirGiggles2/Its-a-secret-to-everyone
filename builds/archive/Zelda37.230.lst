                            	  7428: ; A: 1 if objects collide
                            	  7429: ; Y: weapon object slot
                            	  7430: ; Z: 0 if objects collide
                            	  7431: ; [06]: 1 if objects collide
                            	  7432: ; [0A]: horizontal distance
                            	  7433: ; [0B]: vertical distance
                            	  7434: ;
                            	  7435: ;
