                            	  8337: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8338:     ; If the teleporting distance remaining is even, then draw
                            	  8339:     ; and check collisions, else return.
                            	  8340:     ;
                            	  8341:     ; This means that when 0, the monster is walking.
                            	  8342:     ; So, draw and check collisions every frame.
                            	  8343:     ;
                            	  8344:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8345:     ; translucently -- every other frame.
                            	  8346:     ;
02:0003D304 41EC0394        	  8347:     lea     ($0394,A4),A0
02:0003D308 10302000        	  8348:     move.b  (A0,D2.W),D0
02:0003D30C E208            	  8349:     lsr.b  #1,D0   ; LSR A
02:0003D30E 6402            	  8350:     bcc.s  __far_z_04_0071
02:0003D310 603A            	  8351:     jmp  L11E17_Exit
