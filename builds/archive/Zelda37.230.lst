02:0003AA2A D101            	  2754:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003AA2C 41EC0444        	  2755:     lea     ($0444,A4),A0
02:0003AA30 11802000        	  2756:     move.b  D0,(A0,D2.W)
                            	  2757:     ; Set the starting speed, depending on the object type.
