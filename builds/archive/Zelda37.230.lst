02:00034FC2 003C0011        	  2787:     ori     #$11,CCR  ; SEC: set C+X
02:00034FC6 123C0008        	  2788:     move.b  #$08,D1
02:00034FCA 0A3C0010        	  2789:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034FCE 9101            	  2790:     subx.b  D1,D0   ; SBC #$08
02:00034FD0 0A3C0010        	  2791:     eori    #$10,CCR  ; restore X = 6502 C
02:00034FD4 7600            	  2792:     moveq   #0,D3
02:00034FD6 1600            	  2793:     move.b  D0,D3
02:00034FD8 102C0015        	  2794:     move.b  ($0015,A4),D0
02:00034FDC 02000008        	  2795:     andi.b #$08,D0
