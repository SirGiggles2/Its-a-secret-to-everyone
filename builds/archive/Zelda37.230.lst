                            	  6668: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6669:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6670:     ;   full heart=4 partial heart=$70
                            	  6671:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6672:     ; But the method here yields $3EF, because partial heart is
                            	  6673:     ; considered full when = $FF instead of $100.
                            	  6674:     ;
02:00031EBA 102C000E        	  6675:     move.b  ($000E,A4),D0
02:00031EBE 003C0011        	  6676:     ori     #$11,CCR  ; SEC: set C+X
02:00031EC2 122C0670        	  6677:     move.b  ($0670,A4),D1
02:00031EC6 0A3C0010        	  6678:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031ECA 9101            	  6679:     subx.b  D1,D0   ; SBC HeartPartial
02:00031ECC 0A3C0010        	  6680:     eori    #$10,CCR  ; restore X = 6502 C
02:00031ED0 1940000E        	  6681:     move.b  D0,($000E,A4)
02:00031ED4 102C066F        	  6682:     move.b  ($066F,A4),D0
02:00031ED8 0200000F        	  6683:     andi.b #$0F,D0
02:00031EDC 6710            	  6684:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031EDE 532C066F        	  6685:     subq.b  #1,($066F,A4)
02:00031EE2 103C00FF        	  6686:     move.b  #$FF,D0
02:00031EE6 19400670        	  6687:     move.b  D0,($0670,A4)
02:00031EEA 6600FF6E        	  6688:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6689:     even
                            	  6690: _L_z01_Link_BeHarmed_HandleDied:
                            	  6691:     ; Link died.
                            	  6692:     ;
                            	  6693:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6694:     ; Make Link face down.
                            	  6695:     ; Go to mode $11.
                            	  6696:     ;
02:00031EEE 102C066F        	  6697:     move.b  ($066F,A4),D0
02:00031EF2 020000F0        	  6698:     andi.b #$F0,D0
02:00031EF6 1940066F        	  6699:     move.b  D0,($066F,A4)
02:00031EFA 4EB90004B314    	  6700:     jsr     EndGameMode
