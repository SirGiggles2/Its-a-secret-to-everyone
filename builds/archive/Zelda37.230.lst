                            	 10963: Gleeok_CheckCollisions:
                            	 10964:     ; If this segment is not the head nor the bottom of the neck,
                            	 10965:     ; then loop again to process the next segment.
                            	 10966:     ;
                            	 10967:     ; This kind of segment is only drawn, and is not checked
                            	 10968:     ; for object collisions.
                            	 10969:     ;
02:0003E660 0C020005        	 10970:     cmpi.b  #$05,D2
02:0003E664 670A            	 10971:     beq  _anon_z04_141
02:0003E666 0C020001        	 10972:     cmpi.b  #$01,D2
02:0003E66A 6704            	 10973:     beq  _anon_z04_141
02:0003E66C 6000010C        	 10974:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10975: 
                            	 10976: _anon_z04_141:
02:0003E670 4EB900031B7C    	 10977:     jsr     CheckMonsterCollisions
                            	 10978:     ; If this segment was harmed, then set the writhing counter,
                            	 10979:     ; and the animation counter to its lower value.
                            	 10980:     ;
02:0003E676 41EC00C0        	 10981:     lea     ($00C0,A4),A0
02:0003E67A 10302000        	 10982:     move.b  (A0,D2.W),D0
02:0003E67E 670A            	 10983:     beq  _anon_z04_142
02:0003E680 7006            	 10984:     moveq   #6,D0
02:0003E682 194004E6        	 10985:     move.b  D0,($04E6,A4)
02:0003E686 19400510        	 10986:     move.b  D0,($0510,A4)
                            	 10987: _anon_z04_142:
02:0003E68A 4EB90004B712    	 10988:     jsr     ResetShoveInfo
                            	 10989:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 10990:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 10991:     ;
02:0003E690 0C020001        	 10992:     cmpi.b  #$01,D2
02:0003E694 670000DE        	 10993:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E698 6100B1AC        	 10994:     jsr     PlayBossHitCryIfNeeded
                            	 10995:     ; If this neck has not died, then go loop again.
                            	 10996:     ;
02:0003E69C 41EC0405        	 10997:     lea     ($0405,A4),A0
02:0003E6A0 10302000        	 10998:     move.b  (A0,D2.W),D0
02:0003E6A4 670000D4        	 10999:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11000:     ; This neck died. So, prepare to make a flying head.
                            	 11001:     ;
02:0003E6A8 7060            	 11002:     moveq   #96,D0
02:0003E6AA 41EC0485        	 11003:     lea     ($0485,A4),A0
02:0003E6AE 11802000        	 11004:     move.b  D0,(A0,D2.W)
02:0003E6B2 1002            	 11005:     move.b  D2,D0
02:0003E6B4 1B00            	 11006:     move.b  D0,-(A5)  ; PHA
                            	 11007:     ; If the segment is not a head, then skip making a flying head.
                            	 11008:     ;
                            	 11009:     ; TODO:
                            	 11010:     ; But how can we get here in this case, since earlier branches
                            	 11011:     ; would have been taken to skip all this for all other segments?
                            	 11012:     ;
02:0003E6B6 0C020005        	 11013:     cmpi.b  #$05,D2
02:0003E6BA 663C            	 11014:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11015:     ; The flying head will go in slot (neck index + 7).
                            	 11016:     ; Switch the X register to it.
                            	 11017:     ;
02:0003E6BC 102C04D7        	 11018:     move.b  ($04D7,A4),D0
02:0003E6C0 023C00EE        	 11019:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6C4 123C0007        	 11020:     move.b  #$07,D1
02:0003E6C8 D101            	 11021:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E6CA 7400            	 11022:     moveq   #0,D2
02:0003E6CC 1400            	 11023:     move.b  D0,D2
                            	 11024:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11025:     ;
02:0003E6CE 103C00FF        	 11026:     move.b  #$FF,D0
02:0003E6D2 41EC0492        	 11027:     lea     ($0492,A4),A0
02:0003E6D6 11802000        	 11028:     move.b  D0,(A0,D2.W)
                            	 11029:     ; Copy the original head's coordinates to it.
                            	 11030:     ;
02:0003E6DA 102C0075        	 11031:     move.b  ($0075,A4),D0
02:0003E6DE 19802070        	 11032:     move.b  D0,($70,A4,D2.W)
02:0003E6E2 102C0089        	 11033:     move.b  ($0089,A4),D0
02:0003E6E6 41EC0084        	 11034:     lea     ($0084,A4),A0
02:0003E6EA 11802000        	 11035:     move.b  D0,(A0,D2.W)
                            	 11036:     ; Set object type $46 (flying head).
                            	 11037:     ;
02:0003E6EE 7046            	 11038:     moveq   #70,D0
02:0003E6F0 41EC034F        	 11039:     lea     ($034F,A4),A0
02:0003E6F4 11802000        	 11040:     move.b  D0,(A0,D2.W)
