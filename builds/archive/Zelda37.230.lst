02:000336B4 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:000336B8 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000336BC E14C            	   559:     lsl.w   #8,D4
