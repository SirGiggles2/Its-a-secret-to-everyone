                            	  7251:     ; Store the bomb's (Y + 8) in [03].
                            	  7252:     ;
02:0003CB12 41EC0084        	  7253:     lea     ($0084,A4),A0
02:0003CB16 10303000        	  7254:     move.b  (A0,D3.W),D0
02:0003CB1A 123C0008        	  7255:     move.b  #$08,D1
02:0003CB1E D101            	  7256:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB20 19400003        	  7257:     move.b  D0,($0003,A4)
                            	  7258:     ; But, if there's no bomb, then return.
                            	  7259:     ;
02:0003CB24 41EC00AC        	  7260:     lea     ($00AC,A4),A0
02:0003CB28 10303000        	  7261:     move.b  (A0,D3.W),D0
02:0003CB2C 6720            	  7262:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7263:     ; If the bomb has not exploded (state $12), then
                            	  7264:     ; go see if Dodongo will eat it.
                            	  7265:     ;
02:0003CB2E 0C000012        	  7266:     cmpi.b  #$12,D0
02:0003CB32 6602            	  7267:     bne.s  __far_z_04_0065
02:0003CB34 601A            	  7268:     jmp  Dodongo_TryEatBomb
                            	  7269: __far_z_04_0065:
                            	  7270:     ; If the object in the slot is actually a fire, then return.
                            	  7271:     ;
02:0003CB36 0C000020        	  7272:     cmpi.b  #$20,D0
02:0003CB3A 6412            	  7273:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7274:     ; The bomb already blew up.
                            	  7275:     ; If the dust cloud is in range of the monster,
                            	  7276:     ; then set stunned state (2).
                            	  7277:     ;
02:0003CB3C 7600            	  7278:     moveq   #0,D3
02:0003CB3E 61000082        	  7279:     jsr     Dodongo_IsBombInRange
02:0003CB42 660A            	  7280:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003CB44 7002            	  7281:     moveq   #2,D0
02:0003CB46 41EC00AC        	  7282:     lea     ($00AC,A4),A0
02:0003CB4A 11802000        	  7283:     move.b  D0,(A0,D2.W)
                            	  7284:     even
                            	  7285: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003CB4E 4E75            	  7286:     rts
                            	  7287: 
                            	  7288:     even
                            	  7289: Dodongo_TryEatBomb:
                            	  7290:     ; Try to eat the bomb.
                            	  7291:     ;
                            	  7292:     ; If the bomb is not in range of the monster, then return.
                            	  7293:     ;
                            	  7294:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7295:     ;
02:0003CB50 7601            	  7296:     moveq   #1,D3
02:0003CB52 616E            	  7297:     jsr     Dodongo_IsBombInRange
02:0003CB54 6666            	  7298:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7299:     ; Will loop from 1 to 0, indexed by [00].
                            	  7300:     ;
02:0003CB56 7001            	  7301:     moveq   #1,D0
02:0003CB58 1880            	  7302:     move.b  D0,($0000,A4)
                            	  7303:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7304:     ;
02:0003CB5A 41EC0098        	  7305:     lea     ($0098,A4),A0
02:0003CB5E 10302000        	  7306:     move.b  (A0,D2.W),D0
02:0003CB62 E208            	  7307:     lsr.b  #1,D0   ; LSR A
02:0003CB64 7600            	  7308:     moveq   #0,D3
02:0003CB66 1600            	  7309:     move.b  D0,D3
                            	  7310:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7311:     ; position depends on the orientation of the monster.
                            	  7312:     ;
                            	  7313:     ; Start with the horizontal distance.
                            	  7314:     ;
02:0003CB68 102C0004        	  7315:     move.b  ($0004,A4),D0
                            	  7316:     even
                            	  7317: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7318:     ; Look up the limits for the given direction.
                            	  7319:     ;
                            	  7320:     ; If the distance from the bomb < negative limit,
                            	  7321:     ; or >= positive limit, then return.
                            	  7322:     ;
                            	  7323:     ; Note that these are simple signed comparisons that work,
                            	  7324:     ; because the operands are in a small range.
                            	  7325:     ;
02:0003CB6C 41F90003CAA6    	  7326:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB72 12303000        	  7327:     move.b  (A0,D3.W),D1
02:0003CB76 B001            	  7328:     cmp.b   D1,D0
02:0003CB78 6B42            	  7329:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB7A 41F90003CAAC    	  7330:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB80 12303000        	  7331:     move.b  (A0,D3.W),D1
02:0003CB84 B001            	  7332:     cmp.b   D1,D0
02:0003CB86 6A34            	  7333:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7334:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7335:     ;
02:0003CB88 1003            	  7336:     move.b  D3,D0
02:0003CB8A 023C00EE        	  7337:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB8E 123C000A        	  7338:     move.b  #$0A,D1
02:0003CB92 D101            	  7339:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB94 7600            	  7340:     moveq   #0,D3
02:0003CB96 1600            	  7341:     move.b  D0,D3
                            	  7342:     ; Bottom of the loop.
                            	  7343:     ;
                            	  7344:     ; Load the vertical distance for the next iteration.
                            	  7345:     ; Decrement loop counter.
                            	  7346:     ;
02:0003CB98 102C0005        	  7347:     move.b  ($0005,A4),D0
02:0003CB9C 5314            	  7348:     subq.b  #1,($0000,A4)
02:0003CB9E 6ACC            	  7349:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7350:     ; If we get here, then the bomb was within range of the mouth.
                            	  7351:     ; Go to state 1 (bloated).
                            	  7352:     ;
02:0003CBA0 41EC00AC        	  7353:     lea     ($00AC,A4),A0
02:0003CBA4 52302000        	  7354:     addq.b  #1,(A0,D2.W)
                            	  7355:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7356:     ;
02:0003CBA8 7610            	  7357:     moveq   #16,D3
02:0003CBAA 7000            	  7358:     moveq   #0,D0
02:0003CBAC 41EC00AC        	  7359:     lea     ($00AC,A4),A0
02:0003CBB0 11803000        	  7360:     move.b  D0,(A0,D3.W)
02:0003CBB4 41EC042C        	  7361:     lea     ($042C,A4),A0
02:0003CBB8 11802000        	  7362:     move.b  D0,(A0,D2.W)
                            	  7363:     even
                            	  7364: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CBBC 4E75            	  7365:     rts
                            	  7366: 
                            	  7367:     even
                            	  7368: DodongoBombPositiveLimits:
02:0003CBBE 0C              	  7369:     dc.b    $0C, $11
02:0003CBBF 11
                            	  7370: 
                            	  7371:     even
                            	  7372: DodongoBombNegativeLimits:
02:0003CBC0 F4              	  7373:     dc.b    $F4, $F0
02:0003CBC1 F0
                            	  7374: 
                            	  7375: ; Params:
                            	  7376: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7377: ; [00]: monster hotspot X
                            	  7378: ; [01]: monster hotspot Y
                            	  7379: ; [02]: bomb hotspot X
                            	  7380: ; [03]: bomb hotspot Y
                            	  7381: ;
                            	  7382: ; Returns:
                            	  7383: ; A: 0 if the bomb is in range of the monster
                            	  7384: ; Z: 1 if the bomb is in range of the monster
                            	  7385: ; [04]: horizontal distance
                            	  7386: ; [05]: vertical distance
                            	  7387: ;
                            	  7388: ; Store the positive limit in [06], and the negative one in [07].
                            	  7389: ;
                            	  7390:     even
                            	  7391: Dodongo_IsBombInRange:
02:0003CBC2 41F90003CBBE    	  7392:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBC8 10303000        	  7393:     move.b  (A0,D3.W),D0
02:0003CBCC 19400006        	  7394:     move.b  D0,($0006,A4)
02:0003CBD0 41F90003CBC0    	  7395:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CBD6 10303000        	  7396:     move.b  (A0,D3.W),D0
02:0003CBDA 19400007        	  7397:     move.b  D0,($0007,A4)
                            	  7398:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7399:     ; the bomb is near enough the monster.
                            	  7400:     ;
02:0003CBDE 7003            	  7401:     moveq   #3,D0
02:0003CBE0 19400008        	  7402:     move.b  D0,($0008,A4)
                            	  7403:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7404:     ;
02:0003CBE4 7601            	  7405:     moveq   #1,D3
                            	  7406:     even
                            	  7407: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7408:     ; Subtract the bomb's coordinate from the boss's,
                            	  7409:     ; The loop index determines the coordinate.
                            	  7410:     ;
02:0003CBE6 10343000        	  7411:     move.b  ($00,A4,D3.W),D0
02:0003CBEA 003C0011        	  7412:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBEE 12343002        	  7413:     move.b  ($02,A4,D3.W),D1
02:0003CBF2 0A3C0010        	  7414:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBF6 9101            	  7415:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBF8 0A3C0010        	  7416:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7417:     ; If the distance >= positive offset, or < negative offset;
                            	  7418:     ; then loop again.
                            	  7419:     ;
02:0003CBFC 122C0006        	  7420:     move.b  ($0006,A4),D1
02:0003CC00 B001            	  7421:     cmp.b   D1,D0
02:0003CC02 6A16            	  7422:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CC04 122C0007        	  7423:     move.b  ($0007,A4),D1
02:0003CC08 B001            	  7424:     cmp.b   D1,D0
02:0003CC0A 6B0E            	  7425:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7426:     ; The distance is close enough in this axis.
                            	  7427:     ;
                            	  7428:     ; Store the distance in this axis in [05] or [04],
                            	  7429:     ; depending on the loop index.
                            	  7430:     ;
02:0003CC0C 19803004        	  7431:     move.b  D0,($04,A4,D3.W)
                            	  7432:     ; Shift [08] right, because we're in range in this axis.
                            	  7433:     ;
02:0003CC10 122C0008        	  7434:     move.b  ($0008,A4),D1
02:0003CC14 E209            	  7435:     lsr.b  #1,D1   ; LSR $08
02:0003CC16 19410008        	  7436:     move.b  D1,($0008,A4)
                            	  7437:     even
                            	  7438: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC1A 5303            	  7439:     subq.b  #1,D3
02:0003CC1C 6AC8            	  7440:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7441:     ; If close enough in both axes, then [08] will be 0.
                            	  7442:     ;
02:0003CC1E 102C0008        	  7443:     move.b  ($0008,A4),D0
02:0003CC22 4E75            	  7444:     rts
                            	  7445: 
                            	  7446: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7447: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7448: ;
                            	  7449: ; But these are not typical direction indexes. Instead a
                            	  7450: ; 5-way index is used.
                            	  7451: ; A direction shifted right once becomes a 5-way index.
                            	  7452: ; The fourth element is unused.
                            	  7453: ;
                            	  7454:     even
                            	  7455: DodongoFrameImages:
02:0003CC24 00              	  7456:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CC25 01
02:0003CC26 06
02:0003CC27 FF
02:0003CC28 08
02:0003CC29 02
02:0003CC2A 03
02:0003CC2B 06
02:0003CC2C FF              	  7457:     dc.b    $FF, $08
02:0003CC2D 08
                            	  7458: 
                            	  7459:     even
                            	  7460: DodongoFrameHFlips:
02:0003CC2E 00              	  7461:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CC2F 40
02:0003CC30 00
02:0003CC31 FF
02:0003CC32 00
02:0003CC33 00
02:0003CC34 40
02:0003CC35 40
02:0003CC36 FF              	  7462:     dc.b    $FF, $40
02:0003CC37 40
                            	  7463: 
                            	  7464:     even
                            	  7465: DodongoFrameImagesBloated:
02:0003CC38 04              	  7466:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CC39 05
02:0003CC3A 07
02:0003CC3B FF
02:0003CC3C 09
02:0003CC3D 04
02:0003CC3E 05
02:0003CC3F 07
02:0003CC40 FF              	  7467:     dc.b    $FF, $09
02:0003CC41 09
                            	  7468: 
                            	  7469:     even
                            	  7470: DodongoFrameHFlipsBloated:
02:0003CC42 00              	  7471:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC43 40
02:0003CC44 00
02:0003CC45 FF
02:0003CC46 00
02:0003CC47 00
02:0003CC48 40
02:0003CC49 00
02:0003CC4A FF              	  7472:     dc.b    $FF, $00
02:0003CC4B 00
