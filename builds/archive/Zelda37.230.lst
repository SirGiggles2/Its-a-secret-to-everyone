02:0003CCCA 4EB90004CD8E    	  7563:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCD0 1003            	  7564:     move.b  D3,D0
02:0003CCD2 1B00            	  7565:     move.b  D0,-(A5)  ; PHA
                            	  7566:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7567:     ;
02:0003CCD4 41F90003CC2E    	  7568:     lea     (DodongoFrameHFlips).l,A0
02:0003CCDA 10303000        	  7569:     move.b  (A0,D3.W),D0
02:0003CCDE 1940000F        	  7570:     move.b  D0,($000F,A4)
02:0003CCE2 41F90003CC24    	  7571:     lea     (DodongoFrameImages).l,A0
02:0003CCE8 10303000        	  7572:     move.b  (A0,D3.W),D0
                            	  7573:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
