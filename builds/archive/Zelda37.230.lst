                            	 12260: __far_z_04_0120:
                            	 12261:     ; State = 0.
                            	 12262:     ;
                            	 12263:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12264:     ; This is the only patra child shown in the first fame.
                            	 12265:     ;
02:0003F000 0C020002        	 12266:     cmpi.b  #$02,D2
02:0003F004 6732            	 12267:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12268:     ; The patra child in slot 2 is the last one to be updated.
                            	 12269:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12270:     ;
                            	 12271:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12272:     ; shown.
                            	 12273:     ;
02:0003F006 102C00AE        	 12274:     move.b  ($00AE,A4),D0
02:0003F00A 6700008E        	 12275:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12276:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12277:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12278:     ;
02:0003F00E 1002            	 12279:     move.b  D2,D0
                            	 12280:     ; Subtract 3 from the object slot to get the angle where the
                            	 12281:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12282:     ;
02:0003F010 003C0011        	 12283:     ori     #$11,CCR  ; SEC: set C+X
02:0003F014 123C0003        	 12284:     move.b  #$03,D1
02:0003F018 0A3C0010        	 12285:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F01C 9101            	 12286:     subx.b  D1,D0   ; SBC #$03
02:0003F01E 0A3C0010        	 12287:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F022 7600            	 12288:     moveq   #0,D3
02:0003F024 1600            	 12289:     move.b  D0,D3
                            	 12290:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12291:     ; then return.
                            	 12292:     ;
02:0003F026 102C0396        	 12293:     move.b  ($0396,A4),D0
02:0003F02A 41F90003EFE4    	 12294:     lea     (PatraChildStartAngles).l,A0
02:0003F030 12303000        	 12295:     move.b  (A0,D3.W),D1
02:0003F034 B001            	 12296:     cmp.b   D1,D0
02:0003F036 6662            	 12297:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12298:     even
