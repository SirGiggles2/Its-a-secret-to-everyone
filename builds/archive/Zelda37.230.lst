02:0004C07E 4EF90002B8B6    	  5032:     jmp     c_set_shot_spreading_state
                            	  5033: 
                            	  5034: SpreadShot:
                            	  5035:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5036:     ;
                            	  5037:     ; The shot is spreading out.
                            	  5038:     ;
                            	  5039:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5040:     ; These will be negated appropriately for each corner.
                            	  5041:     ;
02:0004C084 41EC0098        	  5042:     lea     ($0098,A4),A0
02:0004C088 10302000        	  5043:     move.b  (A0,D2.W),D0
02:0004C08C 19400002        	  5044:     move.b  D0,($0002,A4)
02:0004C090 19400003        	  5045:     move.b  D0,($0003,A4)
                            	  5046:     ; Reset [0F] to not flip horizontally.
                            	  5047:     ;
02:0004C094 7000            	  5048:     moveq   #0,D0
02:0004C096 1940000F        	  5049:     move.b  D0,($000F,A4)
                            	  5050:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5051:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5052:     ;
02:0004C09A 7603            	  5053:     moveq   #3,D3
                            	  5054:     even
                            	  5055: _L_z07_SpreadShot_DrawShotCorner:
02:0004C09C 1003            	  5056:     move.b  D3,D0
02:0004C09E 1B00            	  5057:     move.b  D0,-(A5)  ; PHA
                            	  5058:     ; Save offset X [02] and Y offset [03].
                            	  5059:     ;
02:0004C0A0 102C0002        	  5060:     move.b  ($0002,A4),D0
02:0004C0A4 1B00            	  5061:     move.b  D0,-(A5)  ; PHA
02:0004C0A6 102C0003        	  5062:     move.b  ($0003,A4),D0
02:0004C0AA 1B00            	  5063:     move.b  D0,-(A5)  ; PHA
                            	  5064:     ; Calculate and set sprite attributes for this corner:
                            	  5065:     ;   base attribute OR (frame counter AND 3)
                            	  5066:     ;
                            	  5067:     ; The base attribute defines how to flip the sprite.
                            	  5068:     ; The frame counter makes the shot flash by cycling each
                            	  5069:     ; palette row.
                            	  5070:     ;
02:0004C0AC 102C0015        	  5071:     move.b  ($0015,A4),D0
02:0004C0B0 02000003        	  5072:     andi.b #$03,D0
02:0004C0B4 41F90004BF12    	  5073:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C0BA 12303000        	  5074:     move.b  (A0,D3.W),D1
02:0004C0BE 8001            	  5075:     or.b  D1,D0
02:0004C0C0 4EB900031AF2    	  5076:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5077:     ; Add the object's X (the center of the spread) and the
                            	  5078:     ; current offset in [02] to set sprite X in [00].
                            	  5079:     ;
02:0004C0C6 10342070        	  5080:     move.b  ($70,A4,D2.W),D0
02:0004C0CA 023C00EE        	  5081:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C0CE 122C0002        	  5082:     move.b  ($0002,A4),D1
02:0004C0D2 D101            	  5083:     addx.b  D1,D0   ; ADC $02
02:0004C0D4 1880            	  5084:     move.b  D0,($0000,A4)
                            	  5085:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5086:     ; Else calculate the distance from object X to sprite X.
                            	  5087:     ;
02:0004C0D6 12342070        	  5088:     move.b  ($70,A4,D2.W),D1
02:0004C0DA B001            	  5089:     cmp.b   D1,D0
02:0004C0DC 651A            	  5090:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C0DE 0C0000FC        	  5091:     cmpi.b  #$FC,D0
02:0004C0E2 6466            	  5092:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C0E4 003C0011        	  5093:     ori     #$11,CCR  ; SEC: set C+X
02:0004C0E8 12342070        	  5094:     move.b  ($70,A4,D2.W),D1
02:0004C0EC 0A3C0010        	  5095:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C0F0 9101            	  5096:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C0F2 0A3C0010        	  5097:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C0F6 6014            	  5098:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5099: 
                            	  5100:     even
                            	  5101: _L_z07_SpreadShot_ReverseSub:
02:0004C0F8 10342070        	  5102:     move.b  ($70,A4,D2.W),D0
02:0004C0FC 003C0011        	  5103:     ori     #$11,CCR  ; SEC: set C+X
02:0004C100 1214            	  5104:     move.b  ($0000,A4),D1
02:0004C102 0A3C0010        	  5105:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C106 9101            	  5106:     subx.b  D1,D0   ; SBC $00
02:0004C108 0A3C0010        	  5107:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5108:     even
                            	  5109: _L_z07_SpreadShot_CheckDistance:
                            	  5110:     ; If distance >= $20, skip this corner.
                            	  5111:     ;
02:0004C10C 0C000020        	  5112:     cmpi.b  #$20,D0
02:0004C110 6438            	  5113:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5114:     ; Add the object's Y (the center of the spread) and the
                            	  5115:     ; current offset in [03] to set sprite Y in [01].
                            	  5116:     ;
02:0004C112 41EC0084        	  5117:     lea     ($0084,A4),A0
02:0004C116 10302000        	  5118:     move.b  (A0,D2.W),D0
02:0004C11A 023C00EE        	  5119:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C11E 122C0003        	  5120:     move.b  ($0003,A4),D1
02:0004C122 D101            	  5121:     addx.b  D1,D0   ; ADC $03
02:0004C124 19400001        	  5122:     move.b  D0,($0001,A4)
                            	  5123:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5124:     ;
02:0004C128 7600            	  5125:     moveq   #0,D3
02:0004C12A 162C0010        	  5126:     move.b  ($0010,A4),D3
02:0004C12E 670C            	  5127:     beq  _L_z07_SpreadShot_Draw
02:0004C130 0C00003E        	  5128:     cmpi.b  #$3E,D0
02:0004C134 6514            	  5129:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C136 0C0000E8        	  5130:     cmpi.b  #$E8,D0
02:0004C13A 640E            	  5131:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5132:     even
                            	  5133: _L_z07_SpreadShot_Draw:
                            	  5134:     ; Draw the corner.
                            	  5135:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5136:     ;
02:0004C13C 7002            	  5137:     moveq   #2,D0
02:0004C13E 1940000C        	  5138:     move.b  D0,($000C,A4)
02:0004C142 7623            	  5139:     moveq   #35,D3
02:0004C144 4EB900031A12    	  5140:     jsr     Anim_WriteItemSprites
                            	  5141:     even
                            	  5142: _L_z07_SpreadShot_NextCorner:
                            	  5143:     ; Prepare to process the next corner.
                            	  5144:     ;
                            	  5145:     ; First, restore X offset [02] and Y offset [03].
                            	  5146:     ;
02:0004C14A 101D            	  5147:     move.b  (A5)+,D0  ; PLA
02:0004C14C 19400003        	  5148:     move.b  D0,($0003,A4)
02:0004C150 101D            	  5149:     move.b  (A5)+,D0  ; PLA
02:0004C152 19400002        	  5150:     move.b  D0,($0002,A4)
                            	  5151:     ; Take turns negating X offset or Y offset for the next round.
                            	  5152:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5153:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5154:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5155:     ; - Fourth turn: doesn't matter
                            	  5156:     ;
                            	  5157:     ;
                            	  5158:     ; Get the loop index.
02:0004C156 101D            	  5159:     move.b  (A5)+,D0  ; PLA
02:0004C158 1B00            	  5160:     move.b  D0,-(A5)  ; PHA
02:0004C15A 7600            	  5161:     moveq   #0,D3
02:0004C15C 1600            	  5162:     move.b  D0,D3
02:0004C15E 0C030001        	  5163:     cmpi.b  #$01,D3
02:0004C162 6602            	  5164:     bne  _anon_z07_25
02:0004C164 7603            	  5165:     moveq   #3,D3
                            	  5166: _anon_z07_25:
02:0004C166 10343000        	  5167:     move.b  ($00,A4,D3.W),D0
02:0004C16A 4600            	  5168:     eori.b #$FF,D0
02:0004C16C 023C00EE        	  5169:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C170 123C0001        	  5170:     move.b  #$01,D1
02:0004C174 D101            	  5171:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C176 19803000        	  5172:     move.b  D0,($00,A4,D3.W)
                            	  5173:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5174:     ;
02:0004C17A 101D            	  5175:     move.b  (A5)+,D0  ; PLA
02:0004C17C 7600            	  5176:     moveq   #0,D3
02:0004C17E 1600            	  5177:     move.b  D0,D3
02:0004C180 5303            	  5178:     subq.b  #1,D3
02:0004C182 6A00FF18        	  5179:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5180:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5181:     ;
                            	  5182:     ; Decrease the base negative offset to get farther away from
                            	  5183:     ; the center point.
                            	  5184:     ;
02:0004C186 41EC0098        	  5185:     lea     ($0098,A4),A0
02:0004C18A 53302000        	  5186:     subq.b  #1,(A0,D2.W)
                            	  5187:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5188:     ;
                            	  5189:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5190:     ;
02:0004C18E 41EC0098        	  5191:     lea     ($0098,A4),A0
02:0004C192 10302000        	  5192:     move.b  (A0,D2.W),D0
02:0004C196 0C0000E8        	  5193:     cmpi.b  #$E8,D0
02:0004C19A 6702            	  5194:     beq.s  __far_z_07_0078
02:0004C19C 6004            	  5195:     jmp  L1F49F_Exit
                            	  5196: __far_z_07_0078:
02:0004C19E 6000FED2        	  5197:     jmp     DeactivateLinkShot
                            	  5198: 
                            	  5199:     even
                            	  5200: L1F49F_Exit:
02:0004C1A2 4E75            	  5201:     rts
                            	  5202: 
                            	  5203:     even
                            	  5204: UpdateBoomerangOrFood:
                            	  5205:     ; If state = 0, then not active. So, return.
                            	  5206:     ;
02:0004C1A4 41EC00AC        	  5207:     lea     ($00AC,A4),A0
02:0004C1A8 10302000        	  5208:     move.b  (A0,D2.W),D0
02:0004C1AC 6602            	  5209:     bne.s  __far_z_07_0079
02:0004C1AE 60F2            	  5210:     jmp  L1F49F_Exit
                            	  5211: __far_z_07_0079:
                            	  5212:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5213:     ;
02:0004C1B0 E308            	  5214:     lsl.b  #1,D0   ; ASL A
02:0004C1B2 6504            	  5215:     bcs.s  __far_z_07_0080
02:0004C1B4 600000AA        	  5216:     jmp  UpdateArrowOrBoomerang
                            	  5217: __far_z_07_0080:
                            	  5218:     ; The object is food.
                            	  5219:     ;
                            	  5220:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5221:     ; If we reach state $83, then go deactivate the object.
                            	  5222:     ;
                            	  5223:     ; Nothing changes between the states. So, they are used as
                            	  5224:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5225:     ;
02:0004C1B8 10342028        	  5226:     move.b  ($28,A4,D2.W),D0
02:0004C1BC 6622            	  5227:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004C1BE 41EC00AC        	  5228:     lea     ($00AC,A4),A0
02:0004C1C2 52302000        	  5229:     addq.b  #1,(A0,D2.W)
02:0004C1C6 41EC00AC        	  5230:     lea     ($00AC,A4),A0
02:0004C1CA 10302000        	  5231:     move.b  (A0,D2.W),D0
02:0004C1CE 0200000F        	  5232:     andi.b #$0F,D0
02:0004C1D2 0C000003        	  5233:     cmpi.b  #$03,D0
02:0004C1D6 674C            	  5234:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004C1D8 103C00FF        	  5235:     move.b  #$FF,D0
02:0004C1DC 19802028        	  5236:     move.b  D0,($28,A4,D2.W)
                            	  5237:     even
                            	  5238: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
