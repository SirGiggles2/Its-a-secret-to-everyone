                            	  5985: __far_z_05_0091:
                            	  5986:     ; Turn the door command into the desired open or closed state
                            	  5987:     ; to store in [08].
                            	  5988:     ;
                            	  5989:     ; cmd:  7 6 3 2 
                            	  5990:     ; [08]: 2 0 0 0
                            	  5991:     ;
                            	  5992:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5993:     ; commands intended to be used.
                            	  5994:     ;
                            	  5995:     ; 3 is the end state of 2: close
                            	  5996:     ; 7 is the end state of 6: open
                            	  5997:     ;
02:000437E8 02000007        	  5998:     andi.b #$07,D0
02:000437EC 7601            	  5999:     moveq   #1,D3
02:000437EE 19430002        	  6000:     move.b  D3,($0002,A4)
02:000437F2 122C0002        	  6001:     move.b  ($0002,A4),D1
02:000437F6 C200            	  6002:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000437F8 6702            	  6003:     beq  _anon_z05_118
02:000437FA E208            	  6004:     lsr.b  #1,D0   ; LSR A
