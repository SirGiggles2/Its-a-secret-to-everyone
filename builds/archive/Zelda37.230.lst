02:00030DE4 122C0001        	  4484:     move.b  ($0001,A4),D1
02:00030DE8 B601            	  4485:     cmp.b   D1,D3
02:00030DEA 6412            	  4486:     bcc  _L_z01_GetOneDirectionAndDistanceToTarget_Subtract
02:00030DEC 19400002        	  4487:     move.b  D0,($0002,A4)
02:00030DF0 19430001        	  4488:     move.b  D3,($0001,A4)
02:00030DF4 122C000A        	  4489:     move.b  ($000A,A4),D1
