02:0003D0DA 41EC03D0        	  8071:     lea     ($03D0,A4),A0
02:0003D0DE 11802000        	  8072:     move.b  D0,(A0,D2.W)
02:0003D0E2 7600            	  8073:     moveq   #0,D3
02:0003D0E4 41EC03E4        	  8074:     lea     ($03E4,A4),A0
02:0003D0E8 16302000        	  8075:     move.b  (A0,D2.W),D3
02:0003D0EC 5203            	  8076:     addq.b  #1,D3
02:0003D0EE 1003            	  8077:     move.b  D3,D0
02:0003D0F0 02000003        	  8078:     andi.b #$03,D0
02:0003D0F4 41EC03E4        	  8079:     lea     ($03E4,A4),A0
02:0003D0F8 11802000        	  8080:     move.b  D0,(A0,D2.W)
                            	  8081:     even
                            	  8082: _L_z04_UpdateLikeLike_Draw:
                            	  8083:     ; Draw.
                            	  8084:     ;
02:0003D0FC 4EB90004CD8E    	  8085:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D102 41EC03E4        	  8086:     lea     ($03E4,A4),A0
02:0003D106 10302000        	  8087:     move.b  (A0,D2.W),D0
02:0003D10A 4EB9000317FC    	  8088:     jsr     DrawObjectMirrored
                            	  8089:     ; Check collisions. If Link was not captured, then return.
                            	  8090:     ;
02:0003D110 4EB900031B7C    	  8091:     jsr     CheckMonsterCollisions
02:0003D116 41EC042C        	  8092:     lea     ($042C,A4),A0
02:0003D11A 10302000        	  8093:     move.b  (A0,D2.W),D0
02:0003D11E 673C            	  8094:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8095:     ; The monster captured Link.
                            	  8096:     ; Put the monster at the same location as him.
                            	  8097:     ;
02:0003D120 102C0070        	  8098:     move.b  ($0070,A4),D0
02:0003D124 19802070        	  8099:     move.b  D0,($70,A4,D2.W)
02:0003D128 102C0084        	  8100:     move.b  ($0084,A4),D0
02:0003D12C 41EC0084        	  8101:     lea     ($0084,A4),A0
02:0003D130 11802000        	  8102:     move.b  D0,(A0,D2.W)
                            	  8103:     ; Reset Link's timer, metastate, and shove info.
                            	  8104:     ;
02:0003D134 7000            	  8105:     moveq   #0,D0
02:0003D136 19400028        	  8106:     move.b  D0,($0028,A4)
02:0003D13A 19400405        	  8107:     move.b  D0,($0405,A4)
02:0003D13E 194000C0        	  8108:     move.b  D0,($00C0,A4)
02:0003D142 194000D3        	  8109:     move.b  D0,($00D3,A4)
                            	  8110:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  8111:     ;
02:0003D146 41EC03E4        	  8112:     lea     ($03E4,A4),A0
02:0003D14A 11802000        	  8113:     move.b  D0,(A0,D2.W)
02:0003D14E 7004            	  8114:     moveq   #4,D0
02:0003D150 41EC03D0        	  8115:     lea     ($03D0,A4),A0
02:0003D154 11802000        	  8116:     move.b  D0,(A0,D2.W)
                            	  8117:     ; Now Link can't move.
                            	  8118:     ;
02:0003D158 522C0512        	  8119:     addq.b  #1,($0512,A4)
                            	  8120:     even
