02:0003EE9A 10342070        	 12077:     move.b  ($70,A4,D2.W),D0
02:0003EE9E 122C04E6        	 12078:     move.b  ($04E6,A4),D1
02:0003EEA2 0A3C0010        	 12079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEA6 9101            	 12080:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EEA8 0A3C0010        	 12081:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEAC 19802070        	 12082:     move.b  D0,($70,A4,D2.W)
                            	 12083:     even
