                            	  4331: 
                            	  4332: ; Params:
                            	  4333: ; A: object index of target
                            	  4334: ; X: object index of origin
                            	  4335: ; [00]: 0
                            	  4336: ;
                            	  4337: ; Returns:
                            	  4338: ; [00]: the number of axes where the distance <= 8
                            	  4339: ; [03]: distance X
                            	  4340: ; [04]: distance Y
                            	  4341: ; [0A]: vertical direction from origin to target
                            	  4342: ; [0B]: horizontal direction from origin to target
                            	  4343: ;
                            	  4344: ;
                            	  4345: ; Handle the horizontal.
                            	  4346: ;
                            	  4347:     even
                            	  4348: GetDirectionsAndDistancesToTarget:
02:00030D04 1B00            	  4349:     move.b  D0,-(A5)  ; PHA
02:00030D06 7600            	  4350:     moveq   #0,D3
02:00030D08 1600            	  4351:     move.b  D0,D3
02:00030D0A 7002            	  4352:     moveq   #2,D0
02:00030D0C 1940000A        	  4353:     move.b  D0,($000A,A4)
02:00030D10 10343070        	  4354:     move.b  ($70,A4,D3.W),D0
02:00030D14 7600            	  4355:     moveq   #0,D3
