                            	  5181: _L_z04_L_Wallmaster_State1_DrawWithCapturedLink:
                            	  5182:     ; Draw Wallmaster with captured Link.
                            	  5183:     ;
                            	  5184:     ; First, put Link right where the monster is.
                            	  5185:     ;
