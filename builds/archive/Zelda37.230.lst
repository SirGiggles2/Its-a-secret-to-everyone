02:0002E1D8 41EC046F        	   419:     lea     ($046F,A4),A0
02:0002E1DC 10303000        	   420:     move.b  (A0,D3.W),D0
02:0002E1E0 41EC0448        	   421:     lea     ($0448,A4),A0
02:0002E1E4 11802000        	   422:     move.b  D0,(A0,D2.W)
02:0002E1E8 5302            	   423:     subq.b  #1,D2
02:0002E1EA 6AE2            	   424:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
