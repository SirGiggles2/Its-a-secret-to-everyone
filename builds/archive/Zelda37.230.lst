02:0003CED4 10302000        	  7837:     move.b  (A0,D2.W),D0
02:0003CED8 02000003        	  7838:     andi.b #$03,D0
02:0003CEDC 6618            	  7839:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7840:     ; Else facing vertically. Flip the direction.
                            	  7841:     ; Go draw.
