                            	  4121: PondFairy_MoveHearts:
                            	  4122:     ; Loop over each heart from object slot 2 to 9.
                            	  4123:     ;
                            	  4124:     ; Even though they are not standalone objects, their info
                            	  4125:     ; is stored in those object slots.
