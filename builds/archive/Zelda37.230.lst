02:0003BB8C 19400070        	  5187:     move.b  D0,($0070,A4)
02:0003BB90 41EC0084        	  5188:     lea     ($0084,A4),A0
02:0003BB94 10302000        	  5189:     move.b  (A0,D2.W),D0
02:0003BB98 19400084        	  5190:     move.b  D0,($0084,A4)
02:0003BB9C 4EB90004BCA2    	  5191:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BBA2 4EB900030A4E    	  5192:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BBA8 7400            	  5193:     moveq   #0,D2
02:0003BBAA 142C0340        	  5194:     move.b  ($0340,A4),D2
02:0003BBAE 6116            	  5195:     jsr     Wallmaster_PrepareToDraw
                            	  5196:     ; Force animation frame 1: hand closed.
                            	  5197:     ;
02:0003BBB0 7001            	  5198:     moveq   #1,D0
02:0003BBB2 41EC03E4        	  5199:     lea     ($03E4,A4),A0
02:0003BBB6 11802000        	  5200:     move.b  D0,(A0,D2.W)
02:0003BBBA 6100E20E        	  5201:     jsr     DrawObjectNotMirroredOverLink
                            	  5202:     ; Store the offsets of the sprites to show over Link
                            	  5203:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
                            	  5204:     ;
02:0003BBBE 7040            	  5205:     moveq   #64,D0
02:0003BBC0 1880            	  5206:     move.b  D0,($0000,A4)
02:0003BBC2 7044            	  5207:     moveq   #68,D0
