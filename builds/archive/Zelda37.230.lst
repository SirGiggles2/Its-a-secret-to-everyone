                            	  9537: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9538:     ; At this point, we have a hand that just died.
                            	  9539:     ;
                            	  9540:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9541:     ;
02:0003DBE6 7603            	  9542:     moveq   #3,D3
                            	  9543:     ; Count how many are allocated.
                            	  9544:     ; This includes the current dead one, and the other living ones.
                            	  9545:     ; Store the count in [00].
                            	  9546:     ;
02:0003DBE8 7000            	  9547:     moveq   #0,D0
02:0003DBEA 1880            	  9548:     move.b  D0,($0000,A4)
                            	  9549:     even
                            	  9550: _L_z04_Manhandla_CheckCollisions_LoopHand:
