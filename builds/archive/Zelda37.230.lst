                            	 10084:     ; on the left side.
                            	 10085:     ;
02:0003DFD4 003C0011        	 10086:     ori     #$11,CCR  ; SEC: set C+X
02:0003DFD8 123C0010        	 10087:     move.b  #$10,D1
02:0003DFDC 0A3C0010        	 10088:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DFE0 9101            	 10089:     subx.b  D1,D0   ; SBC #$10
02:0003DFE2 0A3C0010        	 10090:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DFE6 19802070        	 10091:     move.b  D0,($70,A4,D2.W)
