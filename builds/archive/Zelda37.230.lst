                            	  3935: UpdateArmos:
02:0003B2A2 6100E7D0        	  3936:     jsr     UpdateGoriya
                            	  3937:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3938:     ;
02:0003B2A6 41EC00C0        	  3939:     lea     ($00C0,A4),A0
02:0003B2AA 10302000        	  3940:     move.b  (A0,D2.W),D0
02:0003B2AE 6702            	  3941:     beq.s  __far_z_04_0033
02:0003B2B0 602A            	  3942:     jmp  DrawArmosAndCheckCollisions
                            	  3943: __far_z_04_0033:
                            	  3944:     ; Animate.
                            	  3945:     ;
                            	  3946:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3947:     ; then only go draw.
                            	  3948:     ;
02:0003B2B2 41EC03D0        	  3949:     lea     ($03D0,A4),A0
02:0003B2B6 53302000        	  3950:     subq.b  #1,(A0,D2.W)
02:0003B2BA 6702            	  3951:     beq.s  __far_z_04_0034
02:0003B2BC 601E            	  3952:     jmp  DrawArmosAndCheckCollisions
                            	  3953: __far_z_04_0034:
                            	  3954:     ; Armos animation frames last 6 screen frames.
                            	  3955:     ;
02:0003B2BE 7006            	  3956:     moveq   #6,D0
02:0003B2C0 41EC03D0        	  3957:     lea     ($03D0,A4),A0
02:0003B2C4 11802000        	  3958:     move.b  D0,(A0,D2.W)
                            	  3959:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3960:     ; change the position of the shield. To keep fixed it in place,
                            	  3961:     ; there are separate frame images for each animation frame.
                            	  3962:     ;
                            	  3963:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3964:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3965:     ;
                            	  3966:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3967:     ; Then choose the direction at the point of drawing below.
                            	  3968:     ;
02:0003B2C8 41EC03E4        	  3969:     lea     ($03E4,A4),A0
02:0003B2CC 10302000        	  3970:     move.b  (A0,D2.W),D0
02:0003B2D0 0A000002        	  3971:     eori.b #$02,D0
02:0003B2D4 41EC03E4        	  3972:     lea     ($03E4,A4),A0
02:0003B2D8 11802000        	  3973:     move.b  D0,(A0,D2.W)
                            	  3974:     even
                            	  3975: DrawArmosAndCheckCollisions:
02:0003B2DC 4EB90004CD8E    	  3976:     jsr     Anim_FetchObjPosForSpriteDescriptor
