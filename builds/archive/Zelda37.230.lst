02:00031DA6 0200000C        	  6525:     andi.b #$0C,D0
02:00031DAA 0C00000C        	  6526:     cmpi.b  #$0C,D0
02:00031DAE 671A            	  6527:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
