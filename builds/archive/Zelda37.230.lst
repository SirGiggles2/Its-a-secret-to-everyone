02:0003DBCE 674E            	  9523:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DBD0 4EB90004B712    	  9524:     jsr     ResetShoveInfo
                            	  9525:     ; Don't let the base die on its own.
                            	  9526:     ; If this is the base, then reset metastate, and return.
