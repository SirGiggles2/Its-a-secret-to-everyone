                            	  5666: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5667:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5668:     ; the mask of opened doors, because this is not a true door.
                            	  5669:     ;
02:000435F2 1B00            	  5670:     move.b  D0,-(A5)  ; PHA
02:000435F4 102C0002        	  5671:     move.b  ($0002,A4),D0
02:000435F8 4600            	  5672:     eori.b #$FF,D0
02:000435FA 122C00EE        	  5673:     move.b  ($00EE,A4),D1
02:000435FE C001            	  5674:     and.b  D1,D0
02:00043600 194000EE        	  5675:     move.b  D0,($00EE,A4)
02:00043604 101D            	  5676:     move.b  (A5)+,D0  ; PLA
                            	  5677:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5678:     ;
02:00043606 0C000001        	  5679:     cmpi.b  #$01,D0
02:0004360A 6402            	  5680:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004360C 7004            	  5681:     moveq   #4,D0
                            	  5682:     even
                            	  5683: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5684:     ; The door attribute (DA) has been mapped to a
                            	  5685:     ; provisional door face value (PF) in %A as follows:
                            	  5686:     ;
                            	  5687:     ; DA PF Meaning
                            	  5688:     ; -------------
                            	  5689:     ; 0  4  open
                            	  5690:     ; 1  1  wall
                            	  5691:     ; 2  2  false wall
                            	  5692:     ; 3  3  false wall 2
                            	  5693:     ; 4  8  bombable
                            	  5694:     ; 5  5  key
                            	  5695:     ; 6  6  key 2
                            	  5696:     ; 7  7  shutter
                            	  5697:     ;
                            	  5698:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5699:     ; has been cleared, if the type was "open" or any wall.
                            	  5700:     ;
                            	  5701:     ;
                            	  5702:     ; Save the provisional face.
02:0004360E 1B00            	  5703:     move.b  D0,-(A5)  ; PHA
                            	  5704:     ; If the current direction points to a door that has been opened,
                            	  5705:     ; then see if we need to set door flags.
                            	  5706:     ;
02:00043610 102C00EE        	  5707:     move.b  ($00EE,A4),D0
02:00043614 122C0002        	  5708:     move.b  ($0002,A4),D1
02:00043618 C001            	  5709:     and.b  D1,D0
02:0004361A 7400            	  5710:     moveq   #0,D2
02:0004361C 1400            	  5711:     move.b  D0,D2
02:0004361E 101D            	  5712:     move.b  (A5)+,D0  ; PLA
02:00043620 122C0002        	  5713:     move.b  ($0002,A4),D1
02:00043624 B401            	  5714:     cmp.b   D1,D2
02:00043626 6624            	  5715:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5716:     ; The current direction points to a door that has been opened.
                            	  5717:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5718:     ;
                            	  5719:     ;
                            	  5720:     ; Save provisional door face in Y register.
02:00043628 7600            	  5721:     moveq   #0,D3
02:0004362A 1600            	  5722:     move.b  D0,D3
02:0004362C 101D            	  5723:     move.b  (A5)+,D0  ; PLA
02:0004362E 1B00            	  5724:     move.b  D0,-(A5)  ; PHA
02:00043630 7400            	  5725:     moveq   #0,D2
02:00043632 1400            	  5726:     move.b  D0,D2
02:00043634 1003            	  5727:     move.b  D3,D0
                            	  5728:     ; If provisional door face is not for a shutter, then
                            	  5729:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5730:     ;
                            	  5731:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5732:     ;
02:00043636 0C000007        	  5733:     cmpi.b  #$07,D0
02:0004363A 670E            	  5734:     beq  _anon_z05_111
02:0004363C 1B00            	  5735:     move.b  D0,-(A5)  ; PHA
02:0004363E 6100DDFE        	  5736:     jsr     SetDoorFlag
02:00043642 101D            	  5737:     move.b  (A5)+,D0  ; PLA
                            	  5738:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5739:     ; then go make it 9 (open "bombable").
                            	  5740:     ; Else make it 4 (open "door").
                            	  5741:     ;
02:00043644 0C000008        	  5742:     cmpi.b  #$08,D0
02:00043648 67A4            	  5743:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5744: _anon_z05_111:
02:0004364A 7004            	  5745:     moveq   #4,D0
                            	  5746:     even
                            	  5747: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5748:     ; For opened doors, the provisional door face has become:
                            	  5749:     ;
                            	  5750:     ; DA PF Meaning
                            	  5751:     ; -------------
                            	  5752:     ; 0  4  open
                            	  5753:     ; 1  1  wall
                            	  5754:     ; 2  2  false wall
                            	  5755:     ; 3  3  false wall 2
                            	  5756:     ; 4  9  bombable
                            	  5757:     ; 5  4  key
                            	  5758:     ; 6  4  key 2
                            	  5759:     ; 7  4  shutter
                            	  5760:     ;
                            	  5761:     ;
                            	  5762:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5763:     ;
02:0004364C 7400            	  5764:     moveq   #0,D2
02:0004364E 142C0006        	  5765:     move.b  ($0006,A4),D2
02:00043652 6712            	  5766:     beq  _anon_z05_112
02:00043654 7400            	  5767:     moveq   #0,D2
02:00043656 142C000B        	  5768:     move.b  ($000B,A4),D2
02:0004365A 1B00            	  5769:     move.b  D0,-(A5)  ; PHA
02:0004365C 6100FCC8        	  5770:     jsr     FindDoorAttrByDoorBit
02:00043660 61001CB4        	  5771:     jsr     CalcOpenDoorwayMask
02:00043664 101D            	  5772:     move.b  (A5)+,D0  ; PLA
                            	  5773: _anon_z05_112:
                            	  5774:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5775:     ; because the visible door face is already a wall.
                            	  5776:     ;
02:00043666 0C000004        	  5777:     cmpi.b  #$04,D0
02:0004366A 650000DC        	  5778:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5779:     ; For all other provisional face values, calculate:
                            	  5780:     ; door face := provisional face - 3
02:0004366E 003C0011        	  5781:     ori     #$11,CCR  ; SEC: set C+X
02:00043672 123C0003        	  5782:     move.b  #$03,D1
02:00043676 0A3C0010        	  5783:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004367A 9101            	  5784:     subx.b  D1,D0   ; SBC #$03
02:0004367C 0A3C0010        	  5785:     eori    #$10,CCR  ; restore X = 6502 C
02:00043680 7600            	  5786:     moveq   #0,D3
02:00043682 1600            	  5787:     move.b  D0,D3
                            	  5788:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5789:     ; subtract one.
                            	  5790:     ;
02:00043684 0C030003        	  5791:     cmpi.b  #$03,D3
02:00043688 6502            	  5792:     bcs  _anon_z05_113
02:0004368A 5303            	  5793:     subq.b  #1,D3
                            	  5794: _anon_z05_113:
                            	  5795:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5796:     ;
                            	  5797:     ; DT DFC DFO Meaning
                            	  5798:     ; ------------------
                            	  5799:     ; 0  1   1   open
                            	  5800:     ; 4  4   5   bombable
                            	  5801:     ; 5  2   1   key
                            	  5802:     ; 6  2   1   key 2
                            	  5803:     ; 7  3   1   shutter
                            	  5804:     ;
                            	  5805:     ;
                            	  5806:     ; Get the direction index.
02:0004368C 101D            	  5807:     move.b  (A5)+,D0  ; PLA
02:0004368E 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:00043690 610000D0        	  5809:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5810:     ; If handling the second half, then offset to the second half
                            	  5811:     ; of the tiles.
                            	  5812:     ;
02:00043694 102C0006        	  5813:     move.b  ($0006,A4),D0
02:00043698 6618            	  5814:     bne  _anon_z05_114
02:0004369A 41F9000435B0    	  5815:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000436A0 10302000        	  5816:     move.b  (A0,D2.W),D0
02:000436A4 4EB900031102    	  5817:     jsr     AddToInt16At0
02:000436AA 7006            	  5818:     moveq   #6,D0
02:000436AC 4EB90003110A    	  5819:     jsr     AddToInt16At2
                            	  5820: _anon_z05_114:
                            	  5821:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5822:     ; Pointers will be incremented instead of Y.
02:000436B2 7600            	  5823:     moveq   #0,D3
02:000436B4 41F9000435B4    	  5824:     lea     (DirIndexToDoorColumnCount).l,A0
02:000436BA 10302000        	  5825:     move.b  (A0,D2.W),D0
02:000436BE 19400005        	  5826:     move.b  D0,($0005,A4)
                            	  5827:     even
                            	  5828: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5829:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5830:     ;
02:000436C2 101D            	  5831:     move.b  (A5)+,D0  ; PLA
02:000436C4 1B00            	  5832:     move.b  D0,-(A5)  ; PHA
02:000436C6 7400            	  5833:     moveq   #0,D2
02:000436C8 1400            	  5834:     move.b  D0,D2
                            	  5835:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5836:     ; starting from highest index down to 0:
                            	  5837:     ;
02:000436CA 41F9000435B8    	  5838:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:000436D0 10302000        	  5839:     move.b  (A0,D2.W),D0
02:000436D4 7400            	  5840:     moveq   #0,D2
02:000436D6 1400            	  5841:     move.b  D0,D2
