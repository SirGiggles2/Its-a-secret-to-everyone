02:00032408 41EC04BF        	  7588:     lea     ($04BF,A4),A0
02:0003240C 10302000        	  7589:     move.b  (A0,D2.W),D0
02:00032410 02000080        	  7590:     andi.b #$80,D0
02:00032414 6622            	  7591:     bne  _L_z01_BeginShove_Exit
                            	  7592:     ; If the attacker is a vire, then return.
