                            	  6826: Aquamentus_Draw:
                            	  6827:     ; Every $10 screen frames, switch animation frames.
                            	  6828:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6829:     ; The last tile of frame 0 is at index 5.
                            	  6830:     ; The last tile of frame 1 is at index $B.
                            	  6831:     ;
02:0003C7E6 7605            	  6832:     moveq   #5,D3
02:0003C7E8 102C0015        	  6833:     move.b  ($0015,A4),D0
02:0003C7EC 02000010        	  6834:     andi.b #$10,D0
02:0003C7F0 6602            	  6835:     bne  _anon_z04_88
02:0003C7F2 760B            	  6836:     moveq   #11,D3
                            	  6837: _anon_z04_88:
02:0003C7F4 1943000A        	  6838:     move.b  D3,($000A,A4)
                            	  6839:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6840:     ;
02:0003C7F8 7005            	  6841:     moveq   #5,D0
02:0003C7FA 1940000B        	  6842:     move.b  D0,($000B,A4)
                            	  6843:     even
                            	  6844: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7FE 7600            	  6845:     moveq   #0,D3
02:0003C800 162C000B        	  6846:     move.b  ($000B,A4),D3
                            	  6847:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6848:     ; Store it in [00].
                            	  6849:     ;
02:0003C804 10342070        	  6850:     move.b  ($70,A4,D2.W),D0
02:0003C808 023C00EE        	  6851:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C80C 41F90003C7E0    	  6852:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C812 12303000        	  6853:     move.b  (A0,D3.W),D1
02:0003C816 D101            	  6854:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C818 1880            	  6855:     move.b  D0,($0000,A4)
                            	  6856:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6857:     ; Store it in [01].
                            	  6858:     ;
02:0003C81A 41EC0084        	  6859:     lea     ($0084,A4),A0
02:0003C81E 10302000        	  6860:     move.b  (A0,D2.W),D0
02:0003C822 023C00EE        	  6861:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C826 41F90003C7DA    	  6862:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C82C 12303000        	  6863:     move.b  (A0,D3.W),D1
02:0003C830 D101            	  6864:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C832 19400001        	  6865:     move.b  D0,($0001,A4)
                            	  6866:     ; Calculate sprite attributes:
                            	  6867:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6868:     ;
                            	  6869:     ; If the boss is temporarily invincible, then
                            	  6870:     ; this makes it flash by cycling all the palette rows.
                            	  6871:     ;
                            	  6872:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6873:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6874:     ;
02:0003C836 41EC04F0        	  6875:     lea     ($04F0,A4),A0
02:0003C83A 10302000        	  6876:     move.b  (A0,D2.W),D0
02:0003C83E 02000003        	  6877:     andi.b #$03,D0
02:0003C842 0A000003        	  6878:     eori.b #$03,D0
02:0003C846 19400003        	  6879:     move.b  D0,($0003,A4)
02:0003C84A 7600            	  6880:     moveq   #0,D3
02:0003C84C 162C000A        	  6881:     move.b  ($000A,A4),D3
                            	  6882:     ; Look up the tile for this sprite.
                            	  6883:     ; If it's not the first one (face), then go write the sprite record.
                            	  6884:     ;
02:0003C850 41F90003C7CE    	  6885:     lea     (AquamentusTiles).l,A0
02:0003C856 10303000        	  6886:     move.b  (A0,D3.W),D0
02:0003C85A 12390003C7CE    	  6887:     move.b  (AquamentusTiles).l,D1
02:0003C860 B001            	  6888:     cmp.b   D1,D0
02:0003C862 6610            	  6889:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6890:     ; Else it's the first one (the face tile).
                            	  6891:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6892:     ;
                            	  6893:     ; $CC/CD shows the closed mouth face.
                            	  6894:     ; $C0/C1 shows the open mouth face.
                            	  6895:     ;
02:0003C864 7600            	  6896:     moveq   #0,D3
02:0003C866 16342028        	  6897:     move.b  ($28,A4,D2.W),D3
02:0003C86A 0C030020        	  6898:     cmpi.b  #$20,D3
02:0003C86E 6404            	  6899:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C870 103C00C0        	  6900:     move.b  #$C0,D0
                            	  6901:     even
                            	  6902: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C874 610E            	  6903:     jsr     WriteBossSprite
                            	  6904:     ; Bottom of the loop.
                            	  6905:     ; Decrement tile index and loop index.
                            	  6906:     ;
02:0003C876 532C000A        	  6907:     subq.b  #1,($000A,A4)
02:0003C87A 532C000B        	  6908:     subq.b  #1,($000B,A4)
02:0003C87E 6A00FF7E        	  6909:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C882 4E75            	  6910:     rts
