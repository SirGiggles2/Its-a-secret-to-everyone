02:00031E48 1941000D        	  6620:     move.b  D1,($000D,A4)
02:00031E4C 122C000E        	  6621:     move.b  ($000E,A4),D1
02:00031E50 E211            	  6622:     roxr.b  #1,D1   ; ROR $0E
02:00031E52 1941000E        	  6623:     move.b  D1,($000E,A4)
