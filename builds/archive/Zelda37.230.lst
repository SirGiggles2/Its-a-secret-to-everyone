                            	  6106: _anon_z05_122:
                            	  6107:     ; If the door command = 4 after incrementing it, then
                            	  6108:     ; it was 3 (close door). So:
                            	  6109:     ; 1. reset this door's flag
                            	  6110:     ; 2. remove it from the opened door mask
                            	  6111:     ; 3. reset the door command
                            	  6112:     ; 4. go lay out doors in the play area map
                            	  6113:     ;
02:000438BA 102C0054        	  6114:     move.b  ($0054,A4),D0
02:000438BE 0C000004        	  6115:     cmpi.b  #$04,D0
02:000438C2 6626            	  6116:     bne  _anon_z05_123
02:000438C4 7400            	  6117:     moveq   #0,D2
02:000438C6 142C0009        	  6118:     move.b  ($0009,A4),D2
02:000438CA 6100DB78        	  6119:     jsr     ResetDoorFlag
02:000438CE 102C0055        	  6120:     move.b  ($0055,A4),D0
02:000438D2 0A00000F        	  6121:     eori.b #$0F,D0
02:000438D6 122C00EE        	  6122:     move.b  ($00EE,A4),D1
02:000438DA C001            	  6123:     and.b  D1,D0
                            	  6124:     even
                            	  6125: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000438DC 194000EE        	  6126:     move.b  D0,($00EE,A4)
                            	  6127:     even
                            	  6128: L_ResetDoorCmdAndLayOutDoors:
