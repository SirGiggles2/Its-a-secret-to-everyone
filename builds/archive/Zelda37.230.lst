                            	  6963: UpdateDodongoState0_Move:
                            	  6964:     ; If facing left, then push X offset 0 on the stack.
                            	  6965:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6966:     ;
                            	  6967:     ; We would like to use one set of coordinates only.
                            	  6968:     ; But movement would break down, if we did; because
                            	  6969:     ; Dodongo is so long.
                            	  6970:     ;
                            	  6971:     ; So, when not facing left, we temporarily shift the
                            	  6972:     ; X coordinate to be closer to the other side of the monster.
                            	  6973:     ;
02:0003C8EA 7600            	  6974:     moveq   #0,D3
02:0003C8EC 41EC0098        	  6975:     lea     ($0098,A4),A0
02:0003C8F0 10302000        	  6976:     move.b  (A0,D2.W),D0
02:0003C8F4 0200000D        	  6977:     andi.b #$0D,D0
02:0003C8F8 6716            	  6978:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C8FA 10342070        	  6979:     move.b  ($70,A4,D2.W),D0
02:0003C8FE 023C00EE        	  6980:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C902 123C0010        	  6981:     move.b  #$10,D1
02:0003C906 D101            	  6982:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C908 19802070        	  6983:     move.b  D0,($70,A4,D2.W)
02:0003C90C 163C00F0        	  6984:     move.b  #$F0,D3
                            	  6985:     even
                            	  6986: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C910 1003            	  6987:     move.b  D3,D0
02:0003C912 1B00            	  6988:     move.b  D0,-(A5)  ; PHA
02:0003C914 7020            	  6989:     moveq   #32,D0
02:0003C916 41EC041F        	  6990:     lea     ($041F,A4),A0
02:0003C91A 11802000        	  6991:     move.b  D0,(A0,D2.W)
02:0003C91E 6100D024        	  6992:     jsr     Wanderer_TargetPlayer
                            	  6993:     ; Pop the offset and add it to the X coordinate.
                            	  6994:     ;
                            	  6995:     ; This brings the X coordinate back to the unique value
                            	  6996:     ; that represents the position.
                            	  6997:     ;
02:0003C922 101D            	  6998:     move.b  (A5)+,D0  ; PLA
02:0003C924 023C00EE        	  6999:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C928 12342070        	  7000:     move.b  ($70,A4,D2.W),D1
