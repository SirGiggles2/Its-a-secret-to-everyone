                            	  4510: WieldBomb:
                            	  4511:     ; If there are no bombs in inventory, return.
                            	  4512:     ;
02:00030E22 102C0658        	  4513:     move.b  ($0658,A4),D0
02:00030E26 67F4            	  4514:     beq  _anon_z01_52
                            	  4515:     ; Look in slot $10. If it's empty or there's a fire
                            	  4516:     ; (state = 0, or major state <> $10), then
                            	  4517:     ; go activate a bomb.
                            	  4518:     ;
02:00030E28 7410            	  4519:     moveq   #16,D2
02:00030E2A 41EC00AC        	  4520:     lea     ($00AC,A4),A0
02:00030E2E 10302000        	  4521:     move.b  (A0,D2.W),D0
