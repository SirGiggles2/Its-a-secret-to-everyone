                            	 13183: Ganon_AppendPaletteRowTransferRecord_Triforce:
02:0003F67E 7608            	 13184:     moveq   #8,D3
                            	 13185: _anon_z04_165:
02:0003F680 1003            	 13186:     move.b  D3,D0
02:0003F682 1B00            	 13187:     move.b  D0,-(A5)  ; PHA
                            	 13188:     ; Get the length, to append to the dynamic transfer buf.
                            	 13189:     ;
02:0003F684 7400            	 13190:     moveq   #0,D2
02:0003F686 142C0301        	 13191:     move.b  ($0301,A4),D2
                            	 13192:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 13193:     ;
02:0003F68A 7600            	 13194:     moveq   #0,D3
                            	 13195:     even
                            	 13196: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003F68C 41F90003F664    	 13197:     lea     (GanonColorTransferRecord).l,A0
02:0003F692 10303000        	 13198:     move.b  (A0,D3.W),D0
02:0003F696 41EC0302        	 13199:     lea     ($0302,A4),A0
02:0003F69A 11802000        	 13200:     move.b  D0,(A0,D2.W)
02:0003F69E 5202            	 13201:     addq.b  #1,D2
02:0003F6A0 5203            	 13202:     addq.b  #1,D3
02:0003F6A2 0C030008        	 13203:     cmpi.b  #$08,D3
02:0003F6A6 66E4            	 13204:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003F6A8 19420301        	 13205:     move.b  D2,($0301,A4)
02:0003F6AC 101D            	 13206:     move.b  (A5)+,D0  ; PLA
02:0003F6AE 7600            	 13207:     moveq   #0,D3
02:0003F6B0 1600            	 13208:     move.b  D0,D3
                            	 13209:     ; Overwrite the last 3 colors in the record, with the ones
