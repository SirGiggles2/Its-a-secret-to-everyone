                            	  2022: ;==============================================================================
                            	  2023: ; EXPORT side — carry-returning shims.
                            	  2024: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2025: ; reproduces the original function's carry normalization.
                            	  2026: ;==============================================================================
                            	  2027: 
                            	  2028: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2029: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2030:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2031:     btst    #8,D0
02:0002BF8E 670A            	  2032:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2033:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2034:     eori    #$01,CCR
02:0002BF98 4E75            	  2035:     rts
                            	  2036: .cc_cnr:
02:0002BF9A 023C00FE        	  2037:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2038:     eori    #$01,CCR
02:0002BFA2 4E75            	  2039:     rts
                            	  2040: 
                            	  2041: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2042: c_copy_next_row_advance_submode:
02:0002BFA4 4EB900000000    	  2043:     jsr     z05_copy_next_row_advance_submode
02:0002BFAA 08000008        	  2044:     btst    #8,D0
02:0002BFAE 670A            	  2045:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2046:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2047:     eori    #$01,CCR
02:0002BFB8 4E75            	  2048:     rts
                            	  2049: .cc_cnras:
02:0002BFBA 023C00FE        	  2050:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2051:     eori    #$01,CCR
02:0002BFC2 4E75            	  2052:     rts
                            	  2053: 
