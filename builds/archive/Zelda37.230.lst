02:0004D1E8 61000500        	  7390:     jsr     SwitchBank
02:0004D1EC 4EB900041DFC    	  7391:     jsr     FindNextEdgeSpawnCell
                            	  7392:     ; Post-walk 1: bottom-edge snap.
02:0004D1F2 102C0525        	  7393:     move.b  ($0525,A4),D0
02:0004D1F6 020000F0        	  7394:     andi.b  #$F0,D0
02:0004D1FA 0C0000E0        	  7395:     cmpi.b  #$E0,D0
02:0004D1FE 660C            	  7396:     bne     _L_z07_P47_post1_ok
