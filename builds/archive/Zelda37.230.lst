02:000304EC 10302000        	  3099:     move.b  (A0,D2.W),D0
02:000304F0 0200000F        	  3100:     andi.b #$0F,D0
02:000304F4 6608            	  3101:     bne  _anon_z01_28
02:000304F6 41EC0394        	  3102:     lea     ($0394,A4),A0
