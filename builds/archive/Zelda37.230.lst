                            	  6568: _L_z04_Digdogger_Draw_LoopPart:
                            	  6569:     ; Store in [00] the X coordinate offset for the current corner.
                            	  6570:     ;
02:0003C5FC 10342070        	  6571:     move.b  ($70,A4,D2.W),D0
02:0003C600 023C00EE        	  6572:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C604 41F90003C5DC    	  6573:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003C60A 12303000        	  6574:     move.b  (A0,D3.W),D1
