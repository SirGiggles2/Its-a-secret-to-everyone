                            	  2335: _L_z04__TryShooting_TryShootingNow:
                            	  2336:     ; Summary
                            	  2337:     ;
                            	  2338:     ; if temporarily invincible then
                            	  2339:     ;   shoot timer := 0
                            	  2340:     ; elif shoot timer > 0 then
                            	  2341:     ;   decrement shoot timer
                            	  2342:     ; elif wants to shoot then
                            	  2343:     ;   shoot timer := $30
                            	  2344:     ;
                            	  2345:     ; qspeed := [01]
                            	  2346:     ;
                            	  2347:     ; if shoot timer <> 0 then
                            	  2348:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2349:     ;     shoot
                            	  2350:     ;     if succeeded then
                            	  2351:     ;       shoot timer := 0
                            	  2352:     ;       qspeed := 0
                            	  2353:     ;   else
                            	  2354:     ;     qspeed := 0
                            	  2355:     ;
                            	  2356:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A7A2 102C0001        	  2357:     move.b  ($0001,A4),D0
02:0003A7A6 1883            	  2358:     move.b  D3,($0000,A4)
02:0003A7A8 1B00            	  2359:     move.b  D0,-(A5)  ; PHA
02:0003A7AA 7600            	  2360:     moveq   #0,D3
                            	  2361:     ; If not temporarily invincible,
                            	  2362:     ;
02:0003A7AC 41EC04F0        	  2363:     lea     ($04F0,A4),A0
02:0003A7B0 10302000        	  2364:     move.b  (A0,D2.W),D0
02:0003A7B4 661A            	  2365:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2366:     ; then Y := shoot timer - 1
                            	  2367:     ;
02:0003A7B6 7600            	  2368:     moveq   #0,D3
02:0003A7B8 41EC0451        	  2369:     lea     ($0451,A4),A0
02:0003A7BC 16302000        	  2370:     move.b  (A0,D2.W),D3
02:0003A7C0 5303            	  2371:     subq.b  #1,D3
                            	  2372:     ; If Y register < 0, then shoot timer is 0.
                            	  2373:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2374:     ; Else go set a non-zero speed and return.
                            	  2375:     ;
02:0003A7C2 6A0C            	  2376:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A7C4 41EC0412        	  2377:     lea     ($0412,A4),A0
