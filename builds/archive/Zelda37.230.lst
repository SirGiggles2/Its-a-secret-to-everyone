02:00043818 9101            	  6017:     subx.b  D1,D0   ; SBC #$01
02:0004381A 0A3C0010        	  6018:     eori    #$10,CCR  ; restore X = 6502 C
02:0004381E 02000002        	  6019:     andi.b #$02,D0
02:00043822 19400008        	  6020:     move.b  D0,($0008,A4)
