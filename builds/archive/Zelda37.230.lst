02:000420F4 6622            	  4236:     bne  _anon_z05_95
02:000420F6 102C0001        	  4237:     move.b  ($0001,A4),D0
02:000420FA 41F9000420C6    	  4238:     lea     (DoorwayBoundsMinOver).l,A0
02:00042100 12303000        	  4239:     move.b  (A0,D3.W),D1
02:00042104 B001            	  4240:     cmp.b   D1,D0
02:00042106 6510            	  4241:     bcs  _anon_z05_95
02:00042108 41F9000420CA    	  4242:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004210E 12303000        	  4243:     move.b  (A0,D3.W),D1
02:00042112 B001            	  4244:     cmp.b   D1,D0
02:00042114 65000082        	  4245:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
