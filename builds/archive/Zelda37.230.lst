                            	  4129: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4130:     ; If the current heart's state <> 0, then go move it.
                            	  4131:     ; Else we have to wait for it to come out at the right time.
                            	  4132:     ;
02:0003B3C2 41EC00AC        	  4133:     lea     ($00AC,A4),A0
02:0003B3C6 10302000        	  4134:     move.b  (A0,D2.W),D0
02:0003B3CA 667C            	  4135:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4136:     ; The current heart's state = 0.
                            	  4137:     ;
                            	  4138:     ; If object slot = 2, then go make it appear. This is the first
                            	  4139:     ; heart to show up.
                            	  4140:     ;
02:0003B3CC 0C020002        	  4141:     cmpi.b  #$02,D2
02:0003B3D0 6732            	  4142:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4143:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4144:     ; go start over.
                            	  4145:     ;
                            	  4146:     ; TODO:
                            	  4147:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4148:     ;
02:0003B3D2 102C00AE        	  4149:     move.b  ($00AE,A4),D0
02:0003B3D6 67EA            	  4150:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4151:     ; Look up the starting angle of this heart with the index
                            	  4152:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4153:     ; then loop again.
                            	  4154:     ;
02:0003B3D8 1002            	  4155:     move.b  D2,D0
02:0003B3DA 003C0011        	  4156:     ori     #$11,CCR  ; SEC: set C+X
02:0003B3DE 123C0003        	  4157:     move.b  #$03,D1
02:0003B3E2 0A3C0010        	  4158:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B3E6 9101            	  4159:     subx.b  D1,D0   ; SBC #$03
02:0003B3E8 0A3C0010        	  4160:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B3EC 7600            	  4161:     moveq   #0,D3
02:0003B3EE 1600            	  4162:     move.b  D0,D3
02:0003B3F0 102C0396        	  4163:     move.b  ($0396,A4),D0
02:0003B3F4 41F90003B3B8    	  4164:     lea     (PondHeartStartAngles).l,A0
02:0003B3FA 12303000        	  4165:     move.b  (A0,D3.W),D1
02:0003B3FE B001            	  4166:     cmp.b   D1,D0
02:0003B400 66000086        	  4167:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4168:     even
