                            	 10899: __far_z_04_0100:
                            	 10900: ; Description:
                            	 10901: ; This block applies to heads and the bottom segment of a neck.
                            	 10902: ; These are drawn with sprites that come first in order, so that
                            	 10903: ; they are drawn above all other sprites, including Link.
                            	 10904: ;
                            	 10905: ; Params:
                            	 10906: ; A: tile number
                            	 10907: ;
                            	 10908: ; Normal sprite with level palette row
                            	 10909:     even
                            	 10910: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E60A 7603            	 10911:     moveq   #3,D3
02:0003E60C 19430003        	 10912:     move.b  D3,($0003,A4)
02:0003E610 1B00            	 10913:     move.b  D0,-(A5)  ; PHA
                            	 10914:     ; To calculate the base offset of the sprite record:
                            	 10915:     ; offset := neck index * 8
                            	 10916:     ;
                            	 10917:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 10918:     ; at an even index.
                            	 10919:     ;
02:0003E612 102C04D7        	 10920:     move.b  ($04D7,A4),D0
02:0003E616 E308            	 10921:     lsl.b  #1,D0   ; ASL A
02:0003E618 E308            	 10922:     lsl.b  #1,D0   ; ASL A
02:0003E61A E308            	 10923:     lsl.b  #1,D0   ; ASL A
                            	 10924:     ; But if the segment is not a head (not at object slot 5), then
                            	 10925:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 10926:     ;
02:0003E61C 0C020005        	 10927:     cmpi.b  #$05,D2
02:0003E620 670A            	 10928:     beq  _anon_z04_139
02:0003E622 023C00EE        	 10929:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E626 123C0020        	 10930:     move.b  #$20,D1
02:0003E62A D101            	 10931:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 10932: _anon_z04_139:
02:0003E62C 7600            	 10933:     moveq   #0,D3
02:0003E62E 1600            	 10934:     move.b  D0,D3
02:0003E630 101D            	 10935:     move.b  (A5)+,D0  ; PLA
02:0003E632 4EB900031B2A    	 10936:     jsr     Anim_WriteSpecificSprite
02:0003E638 6026            	 10937:     jmp     Gleeok_CheckCollisions
                            	 10938: 
                            	 10939:     even
