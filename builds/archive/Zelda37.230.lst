                            	  7031: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7032:     ; Bloated timer =>
                            	  7033:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7034:     ; 1:     go advance the substate
                            	  7035:     ; other: go decrement Bloated timer
                            	  7036:     ;
02:0003C970 7600            	  7037:     moveq   #0,D3
02:0003C972 41EC045E        	  7038:     lea     ($045E,A4),A0
02:0003C976 16302000        	  7039:     move.b  (A0,D2.W),D3
02:0003C97A 5303            	  7040:     subq.b  #1,D3
02:0003C97C 6750            	  7041:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C97E 6B04            	  7042:     bmi.s  __far_z_04_0058
02:0003C980 60000080        	  7043:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7044: __far_z_04_0058:
                            	  7045:     ; Set the bloated timer according to the substate.
                            	  7046:     ;
