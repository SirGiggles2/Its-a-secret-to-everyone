                            	  7475: Dodongo_Draw:
02:0003CC4C 610000F4        	  7476:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7477:     ; Make a 5-way direction index out of the facing direction
                            	  7478:     ; by shifting right once, and store it in [00].
                            	  7479:     ;
02:0003CC50 41EC0098        	  7480:     lea     ($0098,A4),A0
02:0003CC54 10302000        	  7481:     move.b  (A0,D2.W),D0
02:0003CC58 E208            	  7482:     lsr.b  #1,D0   ; LSR A
02:0003CC5A 1880            	  7483:     move.b  D0,($0000,A4)
                            	  7484:     ; If state = 0, go handle animating the two frames of this state.
                            	  7485:     ;
02:0003CC5C 7600            	  7486:     moveq   #0,D3
02:0003CC5E 41EC00AC        	  7487:     lea     ($00AC,A4),A0
02:0003CC62 16302000        	  7488:     move.b  (A0,D2.W),D3
02:0003CC66 6744            	  7489:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7490:     ; If state > 1, then the monster is stunned (state 2).
                            	  7491:     ; So, go switch frames every $20 screen frames.
                            	  7492:     ;
02:0003CC68 7020            	  7493:     moveq   #32,D0
02:0003CC6A 5303            	  7494:     subq.b  #1,D3
02:0003CC6C 6640            	  7495:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7496:     ; State = 1. Bloated.
                            	  7497:     ;
                            	  7498:     ; In substate 0, go animate as usual for walking.
                            	  7499:     ;
02:0003CC6E 7600            	  7500:     moveq   #0,D3
02:0003CC70 41EC042C        	  7501:     lea     ($042C,A4),A0
02:0003CC74 16302000        	  7502:     move.b  (A0,D2.W),D3
02:0003CC78 6732            	  7503:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7504:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7505:     ; go fade the boss; so that some frames are not drawn.
                            	  7506:     ;
02:0003CC7A 0C030002        	  7507:     cmpi.b  #$02,D3
02:0003CC7E 6718            	  7508:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC80 0C030003        	  7509:     cmpi.b  #$03,D3
02:0003CC84 6712            	  7510:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7511:     ; State 1, substate 1
                            	  7512:     ;
                            	  7513:     ; Add $14 to the frame image index to index into the bloated
                            	  7514:     ; frame images and H-flips.
                            	  7515:     ;
02:0003CC86 1014            	  7516:     move.b  ($0000,A4),D0
02:0003CC88 023C00EE        	  7517:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC8C 123C0014        	  7518:     move.b  #$14,D1
02:0003CC90 D101            	  7519:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC92 7600            	  7520:     moveq   #0,D3
02:0003CC94 1600            	  7521:     move.b  D0,D3
02:0003CC96 6032            	  7522:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7523: 
                            	  7524:     even
                            	  7525: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7526:     ; In bloated substates 2 and 3:
                            	  7527:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7528:     ;
02:0003CC98 102C0015        	  7529:     move.b  ($0015,A4),D0
02:0003CC9C 02000002        	  7530:     andi.b #$02,D0
02:0003CCA0 6604            	  7531:     bne.s  __far_z_04_0066
02:0003CCA2 600000A6        	  7532:     jmp  L11B00_Exit
                            	  7533: __far_z_04_0066:
02:0003CCA6 7600            	  7534:     moveq   #0,D3
02:0003CCA8 1614            	  7535:     move.b  ($0000,A4),D3
02:0003CCAA 601E            	  7536:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7537: 
                            	  7538:     even
                            	  7539: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7540:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7541:     ;
02:0003CCAC 7008            	  7542:     moveq   #8,D0
                            	  7543:     even
                            	  7544: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CCAE 7600            	  7545:     moveq   #0,D3
02:0003CCB0 1614            	  7546:     move.b  ($0000,A4),D3
02:0003CCB2 122C0015        	  7547:     move.b  ($0015,A4),D1
02:0003CCB6 C001            	  7548:     and.b  D1,D0
02:0003CCB8 6710            	  7549:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7550:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7551:     ; in order to index into the second set of frame image numbers.
                            	  7552:     ;
02:0003CCBA 1003            	  7553:     move.b  D3,D0
02:0003CCBC 023C00EE        	  7554:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCC0 123C0005        	  7555:     move.b  #$05,D1
02:0003CCC4 D101            	  7556:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CCC6 7600            	  7557:     moveq   #0,D3
02:0003CCC8 1600            	  7558:     move.b  D0,D3
                            	  7559:     even
                            	  7560: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7561:     ; Start preparing sprites.
