                            	 11123:     ;
                            	 11124:     ; First, hide the first $10 sprites: the attached heads.
                            	 11125:     ;
02:0003E78A 4EB900031522    	 11126:     jsr     WriteBlankPrioritySprites
02:0003E790 61000F5C        	 11127:     jsr     PlayBossDeathCry
                            	 11128:     ; We want a death spark. So, set the metastate of the first
                            	 11129:     ; monster slot to $11.
