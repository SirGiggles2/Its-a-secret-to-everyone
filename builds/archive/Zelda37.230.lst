                            	 11799: Lamnola_UpdateHead:
                            	 11800:     ; If X coordinate is not a multiple of 8, then return.
                            	 11801:     ;
02:0003ECD6 10342070        	 11802:     move.b  ($70,A4,D2.W),D0
02:0003ECDA 02000007        	 11803:     andi.b #$07,D0
02:0003ECDE 6702            	 11804:     beq.s  __far_z_04_0118
02:0003ECE0 60F2            	 11805:     jmp  L12A6F_Exit
                            	 11806: __far_z_04_0118:
                            	 11807:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11808:     ; We had to account for the usual offset of 3.
                            	 11809:     ;
02:0003ECE2 41EC0084        	 11810:     lea     ($0084,A4),A0
02:0003ECE6 10302000        	 11811:     move.b  (A0,D2.W),D0
02:0003ECEA 023C00EE        	 11812:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ECEE 123C0003        	 11813:     move.b  #$03,D1
02:0003ECF2 D101            	 11814:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ECF4 02000007        	 11815:     andi.b #$07,D0
02:0003ECF8 6702            	 11816:     beq.s  __far_z_04_0119
02:0003ECFA 60D8            	 11817:     jmp  L12A6F_Exit
                            	 11818: __far_z_04_0119:
                            	 11819:     ; Will loop 4 times, propagating directions down the chain,
                            	 11820:     ; by pulling from the bottom.
                            	 11821:     ;
02:0003ECFC 7004            	 11822:     moveq   #4,D0
02:0003ECFE 1880            	 11823:     move.b  D0,($0000,A4)
                            	 11824:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11825:     ;
02:0003ED00 7600            	 11826:     moveq   #0,D3
02:0003ED02 0C020005        	 11827:     cmpi.b  #$05,D2
02:0003ED06 6702            	 11828:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED08 7605            	 11829:     moveq   #5,D3
                            	 11830:     even
                            	 11831: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11832:     ; Loop over every segment under the head, starting from the tail.
                            	 11833:     ; Copy the next segment's direction to the current one in this loop.
                            	 11834:     ;
02:0003ED0A 41EC009A        	 11835:     lea     ($009A,A4),A0
02:0003ED0E 10303000        	 11836:     move.b  (A0,D3.W),D0
02:0003ED12 41EC0099        	 11837:     lea     ($0099,A4),A0
02:0003ED16 11803000        	 11838:     move.b  D0,(A0,D3.W)
02:0003ED1A 5203            	 11839:     addq.b  #1,D3
02:0003ED1C 5314            	 11840:     subq.b  #1,($0000,A4)
02:0003ED1E 66EA            	 11841:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11842:     ; If this head segment is not aligned with a square, then return.
                            	 11843:     ;
02:0003ED20 10342070        	 11844:     move.b  ($70,A4,D2.W),D0
02:0003ED24 0200000F        	 11845:     andi.b #$0F,D0
02:0003ED28 660000BA        	 11846:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11847:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11848:     ; We had to account for the usual offset of 3.
                            	 11849:     ;
02:0003ED2C 41EC0084        	 11850:     lea     ($0084,A4),A0
02:0003ED30 10302000        	 11851:     move.b  (A0,D2.W),D0
02:0003ED34 023C00EE        	 11852:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED38 123C0003        	 11853:     move.b  #$03,D1
02:0003ED3C D101            	 11854:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED3E 0200000F        	 11855:     andi.b #$0F,D0
02:0003ED42 660000A0        	 11856:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11857:     ; Store the opposite of the facing direction in [00].
                            	 11858:     ;
02:0003ED46 41EC0098        	 11859:     lea     ($0098,A4),A0
02:0003ED4A 10302000        	 11860:     move.b  (A0,D2.W),D0
02:0003ED4E E208            	 11861:     lsr.b  #1,D0   ; LSR A
02:0003ED50 02000005        	 11862:     andi.b #$05,D0
02:0003ED54 1880            	 11863:     move.b  D0,($0000,A4)
02:0003ED56 41EC0098        	 11864:     lea     ($0098,A4),A0
02:0003ED5A 10302000        	 11865:     move.b  (A0,D2.W),D0
02:0003ED5E E308            	 11866:     lsl.b  #1,D0   ; ASL A
02:0003ED60 0200000A        	 11867:     andi.b #$0A,D0
02:0003ED64 1214            	 11868:     move.b  ($0000,A4),D1
02:0003ED66 8001            	 11869:     or.b  D1,D0
                            	 11870:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11871:     ;
02:0003ED68 0A00000F        	 11872:     eori.b #$0F,D0
02:0003ED6C 1940050F        	 11873:     move.b  D0,($050F,A4)
                            	 11874:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11875:     ;
02:0003ED70 10342018        	 11876:     move.b  ($18,A4,D2.W),D0
02:0003ED74 0C000080        	 11877:     cmpi.b  #$80,D0
02:0003ED78 656C            	 11878:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11879:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11880:     ; Load the monster's facing direction.
                            	 11881:     ;
02:0003ED7A 41EC0098        	 11882:     lea     ($0098,A4),A0
02:0003ED7E 10302000        	 11883:     move.b  (A0,D2.W),D0
                            	 11884:     ; Load the next random number into Y register.
                            	 11885:     ;
02:0003ED82 7600            	 11886:     moveq   #0,D3
02:0003ED84 16342019        	 11887:     move.b  ($19,A4,D2.W),D3
                            	 11888:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11889:     ; to keep moving straight.
                            	 11890:     ;
02:0003ED88 0C030080        	 11891:     cmpi.b  #$80,D3
02:0003ED8C 6418            	 11892:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11893:     even
                            	 11894: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11895:     ; Loop to rotate the direction bit over the mask.
                            	 11896:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11897:     ; facing direction.
                            	 11898:     ;
                            	 11899:     ; Shift right the copy of the direction.
                            	 11900:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11901:     ;
02:0003ED8E E208            	 11902:     lsr.b  #1,D0   ; LSR A
02:0003ED90 6402            	 11903:     bcc  _anon_z04_151
02:0003ED92 7008            	 11904:     moveq   #8,D0
                            	 11905: _anon_z04_151:
                            	 11906:     ; If the current direction bit is masked off, then we've reached
                            	 11907:     ; the opposite direction. Loop again.
                            	 11908:     ;
02:0003ED94 122C050F        	 11909:     move.b  ($050F,A4),D1
02:0003ED98 C200            	 11910:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003ED9A 67F2            	 11911:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11912:     ; If Y register >= $40, then break out of the loop.
                            	 11913:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11914:     ;
02:0003ED9C 0C030040        	 11915:     cmpi.b  #$40,D3
02:0003EDA0 6404            	 11916:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11917:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11918:     ; and loop again now.
                            	 11919:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11920:     ;
02:0003EDA2 7640            	 11921:     moveq   #64,D3
02:0003EDA4 65E8            	 11922:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11923:     even
                            	 11924: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11925:     ; Change the facing direction to the direction found.
                            	 11926:     ;
02:0003EDA6 41EC0098        	 11927:     lea     ($0098,A4),A0
02:0003EDAA 11802000        	 11928:     move.b  D0,(A0,D2.W)
                            	 11929:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11930:     ;
02:0003EDAE 1940000F        	 11931:     move.b  D0,($000F,A4)
02:0003EDB2 4EB900030BB2    	 11932:     jsr     BoundByRoom
                            	 11933:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11934:     ;
02:0003EDB8 102C000F        	 11935:     move.b  ($000F,A4),D0
02:0003EDBC 6618            	 11936:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11937:     even
                            	 11938: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11939:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11940:     ; for looking for any non-opposite direction that is not blocked.
                            	 11941:     ;
02:0003EDBE 41EC0098        	 11942:     lea     ($0098,A4),A0
02:0003EDC2 10302000        	 11943:     move.b  (A0,D2.W),D0
                            	 11944:     even
                            	 11945: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11946:     ; Shift right the copy of the direction.
                            	 11947:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11948:     ;
02:0003EDC6 E208            	 11949:     lsr.b  #1,D0   ; LSR A
02:0003EDC8 6402            	 11950:     bcc  _anon_z04_152
02:0003EDCA 7008            	 11951:     moveq   #8,D0
                            	 11952: _anon_z04_152:
                            	 11953:     ; If the current direction bit is not masked off, then go check the
                            	 11954:     ; room boundary in this direction.
                            	 11955:     ; Else we've reached the opposite direction. Loop again.
                            	 11956:     ;
02:0003EDCC 122C050F        	 11957:     move.b  ($050F,A4),D1
02:0003EDD0 C200            	 11958:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDD2 66D2            	 11959:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EDD4 67F0            	 11960:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11961:     even
                            	 11962: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11963:     ; We found a direction that was not blocked by the room boundary.
                            	 11964:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11965:     ;
02:0003EDD6 4EB90004B69E    	 11966:     jsr     GetCollidingTileMoving
02:0003EDDC 122C034A        	 11967:     move.b  ($034A,A4),D1
02:0003EDE0 B001            	 11968:     cmp.b   D1,D0
02:0003EDE2 64DA            	 11969:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11970:     even
                            	 11971: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11972:     ; TODO: confirm this
                            	 11973:     ;
                            	 11974:     ; If there were a room that had lamnolas, and they could get
                            	 11975:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11976:     ; an infinite loop.
                            	 11977:     ;
                            	 11978:     ; But, the only room with that configuration has those blocks
                            	 11979:     ; blocked off with a push block, which can only be pushed after
                            	 11980:     ; all monsters are killed.
                            	 11981:     ;
02:0003EDE4 4E75            	 11982:     rts
                            	 11983: 
                            	 11984:     even
