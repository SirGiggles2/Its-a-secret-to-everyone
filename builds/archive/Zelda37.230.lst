                            	  6538: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6539:     ; Link and the shot are facing opposite directions.
                            	  6540:     ; Link can parry certain weapons/shots.
                            	  6541:     ;
                            	  6542:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6543:     ; no harmful collision; but it still counts as a shot collision.
                            	  6544:     ; So, go treat this as a parry.
                            	  6545:     ;
02:00031DCA 41EC034F        	  6546:     lea     ($034F,A4),A0
02:00031DCE 10302000        	  6547:     move.b  (A0,D2.W),D0
02:00031DD2 0C000055        	  6548:     cmpi.b  #$55,D0
02:00031DD6 650E            	  6549:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031DD8 0C00005B        	  6550:     cmpi.b  #$5B,D0
02:00031DDC 6408            	  6551:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6552:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6553:     ; So, go harm Link.
                            	  6554:     ;
02:00031DDE 102C0676        	  6555:     move.b  ($0676,A4),D0
02:00031DE2 6602            	  6556:     bne.s  __far_z_01_0068
02:00031DE4 600E            	  6557:     jmp  HarmLink
                            	  6558: __far_z_01_0068:
                            	  6559:     even
