02:00041C50 19400013        	  3578:     move.b  D0,($0013,A4)
02:00041C54 19400011        	  3579:     move.b  D0,($0011,A4)
02:00041C58 1940000F        	  3580:     move.b  D0,($000F,A4)
02:00041C5C 194000AC        	  3581:     move.b  D0,($00AC,A4)
02:00041C60 194000C0        	  3582:     move.b  D0,($00C0,A4)
02:00041C64 194000D3        	  3583:     move.b  D0,($00D3,A4)
02:00041C68 194004F0        	  3584:     move.b  D0,($04F0,A4)
                            	  3585:     even
