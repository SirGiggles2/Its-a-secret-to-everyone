                            	  7448: ; [05]: object 2 mid Y
                            	  7449: ; [0D]: horizontal threshold
                            	  7450: ; [0E]: vertical threshold
                            	  7451: ;
                            	  7452: ; Returns:
                            	  7453: ; A: 1 if objects collide
                            	  7454: ; Y: weapon or Link object slot (copied from [00])
                            	  7455: ; Z: 0 if objects collide
                            	  7456: ; [06]: 1 if objects collide
                            	  7457: ; [0A]: horizontal distance
                            	  7458: ; [0B]: vertical distance
                            	  7459: ;
                            	  7460: ;
                            	  7461: ; Reset [06] to indicate no collision by default.
                            	  7462: ;
