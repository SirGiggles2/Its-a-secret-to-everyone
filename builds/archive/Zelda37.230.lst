                            	  3247:     ; coordinates (which were Link's coordinates last frame).
                            	  3248:     ;
                            	  3249:     ; This ends up reflecting Link's coordinates across the room;
                            	  3250:     ; so that monsters chase away from him.
                            	  3251:     ;
