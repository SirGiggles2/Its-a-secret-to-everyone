02:00031F04 194000AC        	  6702:     move.b  D0,($00AC,A4)
02:00031F08 7011            	  6703:     moveq   #17,D0
02:00031F0A 19400012        	  6704:     move.b  D0,($0012,A4)
02:00031F0E 7004            	  6705:     moveq   #4,D0
02:00031F10 19400098        	  6706:     move.b  D0,($0098,A4)
                            	  6707: _anon_z01_87:
02:00031F14 4E75            	  6708:     rts
                            	  6709: 
                            	  6710: ; Params:
                            	  6711: ; X: monster slot
                            	  6712: ; Y: weapon slot
                            	  6713: ; [02]: monster mid X
                            	  6714: ; [03]: monster mid Y
                            	  6715: ;
                            	  6716: ; Returns:
                            	  6717: ; [00]: weapon slot
