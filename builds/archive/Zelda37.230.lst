                            	  2706: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2707:     ; If reversal count >= 2, then
                            	  2708:     ; 1. invert the horizontal component of facing direction,
                            	  2709:     ;    to face away from the chase target
                            	  2710:     ; 2. reset the reversal count to 0.
                            	  2711:     ;
                            	  2712:     ; This prevents a jumper from getting stuck in a corner.
                            	  2713:     ;
                            	  2714:     ; For example, if a tektite's direction is down and right,
                            	  2715:     ; and jumps into the top right corner of the room:
                            	  2716:     ; 1. The right room boundary is hit. So the direction is
                            	  2717:     ;    automatically reversed to up and left.
                            	  2718:     ; 2. The next frame, the top room boundary is hit.
                            	  2719:     ;    The direction is reversed to down and right.
                            	  2720:     ;
                            	  2721:     ; As you can see, an endless loop has been made.
                            	  2722:     ;
02:0003A9DA 41EC0451        	  2723:     lea     ($0451,A4),A0
02:0003A9DE 10302000        	  2724:     move.b  (A0,D2.W),D0
02:0003A9E2 0C000002        	  2725:     cmpi.b  #$02,D0
02:0003A9E6 651E            	  2726:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A9E8 41EC0098        	  2727:     lea     ($0098,A4),A0
02:0003A9EC 10302000        	  2728:     move.b  (A0,D2.W),D0
02:0003A9F0 0A000003        	  2729:     eori.b #$03,D0
02:0003A9F4 41EC0098        	  2730:     lea     ($0098,A4),A0
02:0003A9F8 11802000        	  2731:     move.b  D0,(A0,D2.W)
02:0003A9FC 7000            	  2732:     moveq   #0,D0
02:0003A9FE 41EC0451        	  2733:     lea     ($0451,A4),A0
02:0003AA02 11802000        	  2734:     move.b  D0,(A0,D2.W)
                            	  2735:     even
                            	  2736: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2737:     ; If the object is a boulder, then make sure its facing direction
                            	  2738:     ; has a down vertical component.
                            	  2739:     ;
02:0003AA06 610001F8        	  2740:     jsr     Jumper_PointBoulderDownward
                            	  2741:     ; For the given direction, get the Y offset of the destination
                            	  2742:     ; of the jump.
                            	  2743:     ;
                            	  2744:     ; Add it to the object's Y, and store this destination Y.
                            	  2745:     ;
02:0003AA0A 7600            	  2746:     moveq   #0,D3
