                            	   773: UpdateBlock0Idle:
                            	   774:     ; If there are monsters in the room, go reset the push timer and return.
                            	   775:     ;
02:00039C8E 102C034D        	   776:     move.b  ($034D,A4),D0
02:00039C92 6604            	   777:     bne.s  __far_z_04_0005
02:00039C94 600000DA        	   778:     jmp  ResetPushTimer
                            	   779: __far_z_04_0005:
                            	   780:     ; If Link's X is aligned with the block's, then get the difference
                            	   781:     ; between Link's (Y + 3) and the block's Y.
                            	   782:     ; Then go test the difference.
                            	   783:     ;
02:00039C98 102C0070        	   784:     move.b  ($0070,A4),D0
02:00039C9C 12342070        	   785:     move.b  ($70,A4,D2.W),D1
02:00039CA0 B001            	   786:     cmp.b   D1,D0
02:00039CA2 6628            	   787:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039CA4 7600            	   788:     moveq   #0,D3
02:00039CA6 102C0084        	   789:     move.b  ($0084,A4),D0
02:00039CAA 023C00EE        	   790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039CAE 123C0003        	   791:     move.b  #$03,D1
02:00039CB2 D101            	   792:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039CB4 003C0011        	   793:     ori     #$11,CCR  ; SEC: set C+X
02:00039CB8 41EC0084        	   794:     lea     ($0084,A4),A0
02:00039CBC 12302000        	   795:     move.b  (A0,D2.W),D1
02:00039CC0 0A3C0010        	   796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039CC4 9101            	   797:     subx.b  D1,D0   ; SBC ObjY,X
02:00039CC6 0A3C0010        	   798:     eori    #$10,CCR  ; restore X = 6502 C
02:00039CCA 6036            	   799:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   800: 
                            	   801:     even
                            	   802: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   803:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   804:     ; go reset the push timer.
                            	   805:     ;
02:00039CCC 102C0084        	   806:     move.b  ($0084,A4),D0
02:00039CD0 023C00EE        	   807:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039CD4 123C0003        	   808:     move.b  #$03,D1
02:00039CD8 D101            	   809:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039CDA 41EC0084        	   810:     lea     ($0084,A4),A0
02:00039CDE 12302000        	   811:     move.b  (A0,D2.W),D1
