                            	  5855: _anon_z04_81:
                            	  5856:     ; Chase while flying, as usual.
                            	  5857:     ;
02:0003C100 61003AE2        	  5858:     jsr     Flyer_Chase
                            	  5859:     ; If timer has not expired, then
                            	  5860:     ; go see if it's time to propagate direction changes down the chain.
                            	  5861:     ;
02:0003C104 10342028        	  5862:     move.b  ($28,A4,D2.W),D0
