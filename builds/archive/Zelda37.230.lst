02:0003FD90 9101            	 14268:     subx.b  D1,D0   ; SBC $02
02:0003FD92 0A3C0010        	 14269:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FD96 41EC0412        	 14270:     lea     ($0412,A4),A0
