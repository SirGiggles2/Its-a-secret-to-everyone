02:0004D22E D083            	  7413:     add.l   D3,D0
02:0004D230 2040            	  7414:     movea.l D0,A0
02:0004D232 1010            	  7415:     move.b  (A0),D0
02:0004D234 0C000084        	  7416:     cmpi.b  #$84,D0
