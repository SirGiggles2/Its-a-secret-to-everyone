                            	  1619: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithHeartContainer:
                            	  1620:     ; The player chose the heart container.
                            	  1621:     ;
                            	  1622:     ; If the number of heart containers < 4, then
                            	  1623:     ; - leave the number of heart containers alone
                            	  1624:     ; - set HeartPartial to 0, so Link will die with one more hit
                            	  1625:     ;
                            	  1626:     ; Then go flag this offer taken.
                            	  1627:     ;
02:0002EA0E 102C066F        	  1628:     move.b  ($066F,A4),D0
02:0002EA12 020000F0        	  1629:     andi.b #$F0,D0
02:0002EA16 0C000030        	  1630:     cmpi.b  #$30,D0
