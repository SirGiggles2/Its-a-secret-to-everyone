02:0003AA38 41F90003A962    	  2760:     lea     (JumperStartSpeedsHi).l,A0
02:0003AA3E 10303000        	  2761:     move.b  (A0,D3.W),D0
02:0003AA42 41EC0412        	  2762:     lea     ($0412,A4),A0
02:0003AA46 11802000        	  2763:     move.b  D0,(A0,D2.W)
                            	  2764:     ; Reset the vertical speed low byte.
