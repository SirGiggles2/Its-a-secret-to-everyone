                            	  3132: _L_z05_MaskInputInBorder_PositiveDir:
                            	  3133:     ; The direction is positive.
                            	  3134:     ;
                            	  3135:     ; If the coordinate crosses (<) the boundary, then
                            	  3136:     ; go mask buttons.
                            	  3137:     ;
                            	  3138:     ;
                            	  3139:     ; Get coordinate in [02].
02:0004196A 102C0002        	  3140:     move.b  ($0002,A4),D0
02:0004196E 41F90004189A    	  3141:     lea     (BorderBounds).l,A0
02:00041974 12303000        	  3142:     move.b  (A0,D3.W),D1
02:00041978 B001            	  3143:     cmp.b   D1,D0
