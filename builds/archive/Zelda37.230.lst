02:0003FDA2 122C0003        	 14275:     move.b  ($0003,A4),D1
02:0003FDA6 0A3C0010        	 14276:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FDAA 9101            	 14277:     subx.b  D1,D0   ; SBC $03
02:0003FDAC 0A3C0010        	 14278:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FDB0 6024            	 14279:     jmp     _L_z04_RotateObjectLocation_SetXRotateY
