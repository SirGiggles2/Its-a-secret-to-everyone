                            	  5287: ; Params:
                            	  5288: ; [02]: bitmask for target door.
                            	  5289: ;
                            	  5290: ; Returns:
                            	  5291: ; A: door attribute for desired direction in current room.
                            	  5292: ; [01]: same as [02] if found; $10 otherwise
                            	  5293: ; [03]: reverse direction index
                            	  5294: ;
                            	  5295: ; Door bits:
                            	  5296: ; 1: E
                            	  5297: ; 2: W
                            	  5298: ; 4: S
                            	  5299: ; 8: N
                            	  5300: ;
                            	  5301: ;
                            	  5302: ; Start with single-bit mask 1.
                            	  5303:     even
