                            	  6432: Digdogger_Move:
                            	  6433:     ; This calculation is the same one used in Manhandla to
                            	  6434:     ; manifest the fractional speed over several frames.
                            	  6435:     ;
                            	  6436:     ; To summarize, the formula is:
                            	  6437:     ;
                            	  6438:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6439:     ;
                            	  6440:     ;   SA := SA + (SL AND $E0)
                            	  6441:     ;   [03] := SH + carry
                            	  6442:     ;
                            	  6443:     ; See 04:A28E Manhandla_Move.
                            	  6444:     ;
02:0003C4E0 41EC041F        	  6445:     lea     ($041F,A4),A0
02:0003C4E4 10302000        	  6446:     move.b  (A0,D2.W),D0
02:0003C4E8 020000E0        	  6447:     andi.b #$E0,D0
02:0003C4EC 023C00EE        	  6448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4F0 41EC0412        	  6449:     lea     ($0412,A4),A0
02:0003C4F4 12302000        	  6450:     move.b  (A0,D2.W),D1
02:0003C4F8 D101            	  6451:     addx.b  D1,D0   ; ADC $0412,X
02:0003C4FA 41EC0412        	  6452:     lea     ($0412,A4),A0
02:0003C4FE 11802000        	  6453:     move.b  D0,(A0,D2.W)
                            	  6454:     ; Assign (high speed byte + carry) to [03].
                            	  6455:     ;
02:0003C502 41EC042C        	  6456:     lea     ($042C,A4),A0
02:0003C506 10302000        	  6457:     move.b  (A0,D2.W),D0
02:0003C50A 123C0000        	  6458:     move.b  #$00,D1
02:0003C50E D101            	  6459:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C510 19400003        	  6460:     move.b  D0,($0003,A4)
                            	  6461:     ; Change coordinates by the speed amount/offset in [03]
                            	  6462:     ; according to the direction.
                            	  6463:     ;
                            	  6464:     ; Start with a mask of $A1 in [02]:
                            	  6465:     ; - low nibble represents the right direction
                            	  6466:     ; - high nibble is used to set or clear carry as we go along
                            	  6467:     ;
02:0003C514 103C00A1        	  6468:     move.b  #$A1,D0
02:0003C518 19400002        	  6469:     move.b  D0,($0002,A4)
                            	  6470:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6471:     ;
02:0003C51C 41EC0098        	  6472:     lea     ($0098,A4),A0
02:0003C520 10302000        	  6473:     move.b  (A0,D2.W),D0
02:0003C524 122C0002        	  6474:     move.b  ($0002,A4),D1
02:0003C528 C200            	  6475:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C52A 6712            	  6476:     beq  _L_z04_Digdogger_Move_Left
02:0003C52C 10342070        	  6477:     move.b  ($70,A4,D2.W),D0
02:0003C530 023C00EE        	  6478:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C534 122C0003        	  6479:     move.b  ($0003,A4),D1
02:0003C538 D101            	  6480:     addx.b  D1,D0   ; ADC $03
02:0003C53A 19802070        	  6481:     move.b  D0,($70,A4,D2.W)
                            	  6482:     even
                            	  6483: _L_z04_Digdogger_Move_Left:
                            	  6484:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6485:     ;
