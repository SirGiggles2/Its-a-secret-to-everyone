02:0003F0E8 162C045F        	 12389:     move.b  ($045F,A4),D3
                            	 12390:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12391:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12392:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12393:     ;
02:0003F0EC 41EC034F        	 12394:     lea     ($034F,A4),A0
02:0003F0F0 10302000        	 12395:     move.b  (A0,D2.W),D0
02:0003F0F4 0C000025        	 12396:     cmpi.b  #$25,D0
02:0003F0F8 661E            	 12397:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F0FA 41F90003EFEC    	 12398:     lea     (PatraChild1RotationCosineBits).l,A0
