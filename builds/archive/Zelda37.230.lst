                            	  3590: CheckCaveEdge:
02:00041C6E 4EB90004BB98    	  3591:     jsr     CheckScreenEdge
                            	  3592:     ; If the player touched the edge of the screen and triggered
                            	  3593:     ; a transition to another mode, then go set up the right mode.
                            	  3594:     ;
02:00041C74 102C0011        	  3595:     move.b  ($0011,A4),D0
02:00041C78 6602            	  3596:     bne.s  __far_z_05_0073
02:00041C7A 60CC            	  3597:     jmp  GoToModeAFromCave
                            	  3598: __far_z_05_0073:
02:00041C7C 4E75            	  3599:     rts
                            	  3600: 
                            	  3601: ; Params:
                            	  3602: ; [0F]: movement direction
                            	  3603: ;
                            	  3604: ; Returns:
                            	  3605: ; [0F]: movement direction or 0
                            	  3606: ;
                            	  3607: ;
                            	  3608: ; If the ladder's not in use, return.
                            	  3609: ;
                            	  3610:     even
                            	  3611: CheckLadder:
02:00041C7E 7400            	  3612:     moveq   #0,D2
02:00041C80 142C0064        	  3613:     move.b  ($0064,A4),D2
02:00041C84 670000BE        	  3614:     beq  _L_z05_CheckLadder_Exit
                            	  3615:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3616:     ;
02:00041C88 41EC00AC        	  3617:     lea     ($00AC,A4),A0
02:00041C8C 10302000        	  3618:     move.b  (A0,D2.W),D0
02:00041C90 670000A6        	  3619:     beq  _L_z05_CheckLadder_StashLadder
                            	  3620:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3621:     ; between the ladder and Link.
                            	  3622:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3623:     ;
02:00041C94 41EC0098        	  3624:     lea     ($0098,A4),A0
02:00041C98 10302000        	  3625:     move.b  (A0,D2.W),D0
02:00041C9C 0200000C        	  3626:     andi.b #$0C,D0
02:00041CA0 6734            	  3627:     beq  _anon_z05_85
02:00041CA2 102C0070        	  3628:     move.b  ($0070,A4),D0
02:00041CA6 12342070        	  3629:     move.b  ($70,A4,D2.W),D1
02:00041CAA B001            	  3630:     cmp.b   D1,D0
02:00041CAC 6600008A        	  3631:     bne  _L_z05_CheckLadder_StashLadder
02:00041CB0 102C0084        	  3632:     move.b  ($0084,A4),D0
02:00041CB4 023C00EE        	  3633:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CB8 123C0003        	  3634:     move.b  #$03,D1
02:00041CBC D101            	  3635:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041CBE 003C0011        	  3636:     ori     #$11,CCR  ; SEC: set C+X
02:00041CC2 41EC0084        	  3637:     lea     ($0084,A4),A0
02:00041CC6 12302000        	  3638:     move.b  (A0,D2.W),D1
02:00041CCA 0A3C0010        	  3639:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041CCE 9101            	  3640:     subx.b  D1,D0   ; SBC ObjY,X
02:00041CD0 0A3C0010        	  3641:     eori    #$10,CCR  ; restore X = 6502 C
02:00041CD4 6030            	  3642:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3643: 
                            	  3644: _anon_z05_85:
                            	  3645:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3646:     ; between the ladder and Link.
                            	  3647:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3648:     ;
02:00041CD6 102C0084        	  3649:     move.b  ($0084,A4),D0
02:00041CDA 023C00EE        	  3650:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CDE 123C0003        	  3651:     move.b  #$03,D1
02:00041CE2 D101            	  3652:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041CE4 41EC0084        	  3653:     lea     ($0084,A4),A0
02:00041CE8 12302000        	  3654:     move.b  (A0,D2.W),D1
02:00041CEC B001            	  3655:     cmp.b   D1,D0
02:00041CEE 6648            	  3656:     bne  _L_z05_CheckLadder_StashLadder
02:00041CF0 102C0070        	  3657:     move.b  ($0070,A4),D0
02:00041CF4 003C0011        	  3658:     ori     #$11,CCR  ; SEC: set C+X
02:00041CF8 12342070        	  3659:     move.b  ($70,A4,D2.W),D1
02:00041CFC 0A3C0010        	  3660:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D00 9101            	  3661:     subx.b  D1,D0   ; SBC ObjX,X
02:00041D02 0A3C0010        	  3662:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3663:     even
                            	  3664: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3665:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3666:     ; If > $10, go put the ladder away.
                            	  3667:     ;
02:00041D06 4EB900030CB0    	  3668:     jsr     Abs
02:00041D0C 1880            	  3669:     move.b  D0,($0000,A4)
02:00041D0E 0C000010        	  3670:     cmpi.b  #$10,D0
02:00041D12 6532            	  3671:     bcs  _L_z05_CheckLadder_SetState2
02:00041D14 0C000010        	  3672:     cmpi.b  #$10,D0
02:00041D18 661E            	  3673:     bne  _L_z05_CheckLadder_StashLadder
                            	  3674:     ; Distance = $10. If player's not facing in the same direction as
                            	  3675:     ; the ladder, go put away the ladder.
                            	  3676:     ;
02:00041D1A 102C0098        	  3677:     move.b  ($0098,A4),D0
02:00041D1E 41EC0098        	  3678:     lea     ($0098,A4),A0
02:00041D22 12302000        	  3679:     move.b  (A0,D2.W),D1
02:00041D26 B001            	  3680:     cmp.b   D1,D0
02:00041D28 660E            	  3681:     bne  _L_z05_CheckLadder_StashLadder
                            	  3682:     ; Distance = $10, and player's facing in the same direction.
                            	  3683:     ;
                            	  3684:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3685:     ; ladder and had not stepped onto it yet.
                            	  3686:     ; Go handle movement on it, but don't change state yet.
                            	  3687:     ;
                            	  3688:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3689:     ; off of the ladder. So the ladder should be put away. In this
                            	  3690:     ; case, fall thru.
                            	  3691:     ;
02:00041D2A 41EC00AC        	  3692:     lea     ($00AC,A4),A0
02:00041D2E 10302000        	  3693:     move.b  (A0,D2.W),D0
02:00041D32 0C000001        	  3694:     cmpi.b  #$01,D0
02:00041D36 6718            	  3695:     beq  _L_z05_CheckLadder_HandleInput
                            	  3696:     even
                            	  3697: _L_z05_CheckLadder_StashLadder:
                            	  3698:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3699:     ;
02:00041D38 7000            	  3700:     moveq   #0,D0
02:00041D3A 19400064        	  3701:     move.b  D0,($0064,A4)
02:00041D3E 4EB90004D572    	  3702:     jsr     DestroyMonster
                            	  3703:     even
                            	  3704: _L_z05_CheckLadder_Exit:
02:00041D44 4E75            	  3705:     rts
                            	  3706: 
                            	  3707:     even
                            	  3708: _L_z05_CheckLadder_SetState2:
                            	  3709:     ;  Set state 2, because we're on the ladder.
                            	  3710:     ;
02:00041D46 7002            	  3711:     moveq   #2,D0
02:00041D48 41EC00AC        	  3712:     lea     ($00AC,A4),A0
02:00041D4C 11802000        	  3713:     move.b  D0,(A0,D2.W)
                            	  3714:     even
                            	  3715: _L_z05_CheckLadder_HandleInput:
                            	  3716:     ; If input direction = 0, go draw and reset moving direction.
                            	  3717:     ;
02:00041D50 102C03F8        	  3718:     move.b  ($03F8,A4),D0
02:00041D54 67000086        	  3719:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3720:     ; Input direction <> 0. The player intends to move.
                            	  3721:     ; So, see if we need to override the moving direction.
                            	  3722:     ;
                            	  3723:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3724:     ; go draw and set moving direction to Link's direction.
                            	  3725:     ;
                            	  3726:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3727:     ; been blocked by the water.
                            	  3728:     ;
                            	  3729:     ; Or, Link already passed over the point right over the ladder
                            	  3730:     ; and was allowed to move onto the tiles after the ladder.
                            	  3731:     ;
02:00041D58 102C0098        	  3732:     move.b  ($0098,A4),D0
02:00041D5C 7600            	  3733:     moveq   #0,D3
02:00041D5E 1614            	  3734:     move.b  ($0000,A4),D3
02:00041D60 670C            	  3735:     beq  _anon_z05_86
02:00041D62 41EC0098        	  3736:     lea     ($0098,A4),A0
02:00041D66 12302000        	  3737:     move.b  (A0,D2.W),D1
02:00041D6A B001            	  3738:     cmp.b   D1,D0
02:00041D6C 676E            	  3739:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3740: _anon_z05_86:
                            	  3741:     ; Distance = 0, or facing different directions.
                            	  3742:     ;
                            	  3743:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3744:     ; then go draw and keep moving.
                            	  3745:     ;
                            	  3746:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3747:     ;
                            	  3748:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3749:     ; to move onto the tiles after the ladder.
                            	  3750:     ;
                            	  3751:     ; Note that if Link is not moving, then this test will fail,
                            	  3752:     ; and case (D) will catch it.
                            	  3753:     ;
02:00041D6E 41EC0098        	  3754:     lea     ($0098,A4),A0
02:00041D72 10302000        	  3755:     move.b  (A0,D2.W),D0
02:00041D76 122C000F        	  3756:     move.b  ($000F,A4),D1
02:00041D7A B001            	  3757:     cmp.b   D1,D0
02:00041D7C 675E            	  3758:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3759:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3760:     ; then go draw and move in ladder's direction.
                            	  3761:     ;
                            	  3762:     ; You can always step off the ladder where you came from.
                            	  3763:     ;
02:00041D7E 4EB900030CAC    	  3764:     jsr     GetOppositeDir
02:00041D84 122C0098        	  3765:     move.b  ($0098,A4),D1
02:00041D88 B001            	  3766:     cmp.b   D1,D0
02:00041D8A 6750            	  3767:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3768:     ; D. If opposite of ladder's direction <> down,
                            	  3769:     ; or input direction <> up,
                            	  3770:     ; then go reset moving direction, and draw.
                            	  3771:     ;
                            	  3772:     ; This will catch all cases of Link facing perpendicular to
                            	  3773:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3774:     ; ladder direction is up and input direction is up (E).
                            	  3775:     ;
02:00041D8C 0C000004        	  3776:     cmpi.b  #$04,D0
02:00041D90 6648            	  3777:     bne  _anon_z05_87
02:00041D92 102C03F8        	  3778:     move.b  ($03F8,A4),D0
02:00041D96 0C000008        	  3779:     cmpi.b  #$08,D0
02:00041D9A 663E            	  3780:     bne  _anon_z05_87
                            	  3781:     ; E. The ladder's direction is up and input direction is up.
                            	  3782:     ;
                            	  3783:     ; An earlier call to check tile collision would have blocked
                            	  3784:     ; movement, because the tile under Link's top half is a water tile.
                            	  3785:     ; But because Link is squarely on the ladder, we really have
                            	  3786:     ; to check the tile above that one.
                            	  3787:     ;
                            	  3788:     ; Set moving direction to input direction (up) and switch X to
                            	  3789:     ; the player's slot for the purpose of checking tile collision below.
                            	  3790:     ; Based on that, we'll set moving direction according to walkability.
                            	  3791:     ;
02:00041D9C 6158            	  3792:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3793:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3794:     ;
02:00041D9E 102C0084        	  3795:     move.b  ($0084,A4),D0
02:00041DA2 1B00            	  3796:     move.b  D0,-(A5)  ; PHA
02:00041DA4 003C0011        	  3797:     ori     #$11,CCR  ; SEC: set C+X
02:00041DA8 123C0008        	  3798:     move.b  #$08,D1
02:00041DAC 0A3C0010        	  3799:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DB0 9101            	  3800:     subx.b  D1,D0   ; SBC #$08
02:00041DB2 0A3C0010        	  3801:     eori    #$10,CCR  ; restore X = 6502 C
02:00041DB6 19400084        	  3802:     move.b  D0,($0084,A4)
02:00041DBA 4EB90004B69E    	  3803:     jsr     GetCollidingTileMoving
02:00041DC0 101D            	  3804:     move.b  (A5)+,D0  ; PLA
02:00041DC2 19400084        	  3805:     move.b  D0,($0084,A4)
                            	  3806:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3807:     ; direction as the input direction (in a roundabout way).
                            	  3808:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3809:     ;
02:00041DC6 102C000F        	  3810:     move.b  ($000F,A4),D0
02:00041DCA 7600            	  3811:     moveq   #0,D3
02:00041DCC 162C049E        	  3812:     move.b  ($049E,A4),D3
02:00041DD0 122C034A        	  3813:     move.b  ($034A,A4),D1
02:00041DD4 B601            	  3814:     cmp.b   D1,D3
02:00041DD6 6500FF78        	  3815:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3816: _anon_z05_87:
                            	  3817:     ; Set A to reset moving direction in [0F].
                            	  3818:     ;
02:00041DDA 7000            	  3819:     moveq   #0,D0
                            	  3820:     even
                            	  3821: _L_z05_CheckLadder_DrawLadder:
                            	  3822:     ; Draw the ladder.
                            	  3823:     ;
02:00041DDC 1B00            	  3824:     move.b  D0,-(A5)  ; PHA
02:00041DDE 7400            	  3825:     moveq   #0,D2
02:00041DE0 142C0064        	  3826:     move.b  ($0064,A4),D2
02:00041DE4 4EB90004CD8E    	  3827:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041DEA 760C            	  3828:     moveq   #12,D3
02:00041DEC 7000            	  3829:     moveq   #0,D0
02:00041DEE 4EB900031A04    	  3830:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041DF4 101D            	  3831:     move.b  (A5)+,D0  ; PLA
                            	  3832: ; Params:
                            	  3833: ; A: direction
                            	  3834: ;
                            	  3835: ; Returns:
                            	  3836: ; [0F]: direction
                            	  3837: ;
                            	  3838:     even
                            	  3839: SetMovingDirAndSwitchToPlayerSlot:
02:00041DF6 4EF90002C048    	  3840:     jmp     c_set_moving_dir_switch_player
                            	  3841: 
                            	  3842: FindNextEdgeSpawnCell:
                            	  3843:     ; Load [0A] with the value before the call.
                            	  3844:     ;
02:00041DFC 102C0525        	  3845:     move.b  ($0525,A4),D0
02:00041E00 1940000A        	  3846:     move.b  D0,($000A,A4)
                            	  3847:     even
                            	  3848: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3849:     ; Loop to look for a place to spawn a monster from the edge
                            	  3850:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3851:     ;
                            	  3852:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3853:     ; We'll move down $10 pixels.
                            	  3854:     ;
02:00041E04 7610            	  3855:     moveq   #16,D3
02:00041E06 102C000A        	  3856:     move.b  ($000A,A4),D0
02:00041E0A 0200000F        	  3857:     andi.b #$0F,D0
02:00041E0E 670A            	  3858:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3859:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3860:     ; Don't move vertically.
                            	  3861:     ;
02:00041E10 163C00F0        	  3862:     move.b  #$F0,D3
02:00041E14 0C00000F        	  3863:     cmpi.b  #$0F,D0
02:00041E18 6610            	  3864:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3865:     even
                            	  3866: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3867:     ; Else low nibble = $F. We're at the right edge,
                            	  3868:     ; and we'll move up $10 pixels.
                            	  3869:     ;
02:00041E1A 1003            	  3870:     move.b  D3,D0
02:00041E1C 023C00EE        	  3871:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041E20 122C000A        	  3872:     move.b  ($000A,A4),D1
