02:0004029A 41F90004021C    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:000402A0 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:000402A4 102C0006        	   605:     move.b  ($0006,A4),D0
02:000402A8 122C0671        	   606:     move.b  ($0671,A4),D1
02:000402AC C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000402AE 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
