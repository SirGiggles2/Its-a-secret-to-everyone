                            	   481: 
                            	   482: ;------------------------------------------------------------------------------
                            	   483: ; _c_move_object_shim — MoveObject trampoline.
                            	   484: ;
                            	   485: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   486: ;   Input:     D2 = slot (0..11)
                            	   487: ;   Preserves: D2, A4, A5
                            	   488: ;   Clobbers:  D0, D1, D3, A0
                            	   489: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   490: ;
                            	   491: ; GCC side:
                            	   492: ;   void c_move_object(unsigned short slot);
                            	   493: ;     slot arrives as a 16-bit value on the stack.
                            	   494: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   495: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   496: ;   never clobbered by gcc.
                            	   497: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   498: ;   semantics can exist in a pure C port).
                            	   499: ;------------------------------------------------------------------------------
                            	   500: _c_move_object_shim:
                            	   501:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   502:     move.b  #$AA,($0900,A4)
                            	   503:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   504:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   505:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   506:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   507:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   508:     moveq   #0,D0
02:0002B658 3002            	   509:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   510:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   511:     jsr     c_move_object
02:0002B662 588F            	   512:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   513:     rts
                            	   514: 
                            	   515: ;==============================================================================
                            	   516: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   517: ; and tail-call the native asm function.
                            	   518: ;
                            	   519: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   520: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   521: ; sign-extended).
                            	   522: ;==============================================================================
                            	   523: 
                            	   524: ;------------------------------------------------------------------------------
                            	   525: ; void c_copy_bank_to_window(unsigned int bank);
                            	   526: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   527: ;------------------------------------------------------------------------------
                            	   528: c_copy_bank_to_window:
02:0002B666 202F0004        	   529:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   530:     jmp     _copy_bank_to_window
                            	   531: 
                            	   532: ;------------------------------------------------------------------------------
                            	   533: ; unsigned char c_ppu_read_2(void);
                            	   534: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   535: ; C return: gcc expects result in D0.
                            	   536: ;------------------------------------------------------------------------------
                            	   537: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   538:     jmp     _ppu_read_2
                            	   539: 
                            	   540: ;------------------------------------------------------------------------------
                            	   541: ; void c_ppu_write_6(unsigned int val);
                            	   542: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   543: ;------------------------------------------------------------------------------
                            	   544: c_ppu_write_6:
02:0002B674 202F0004        	   545:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   546:     jmp     _ppu_write_6
                            	   547: 
                            	   548: ;------------------------------------------------------------------------------
                            	   549: ; void c_ppu_write_7(unsigned int val);
                            	   550: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   551: ;------------------------------------------------------------------------------
                            	   552: c_ppu_write_7:
02:0002B67E 202F0004        	   553:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   554:     jmp     _ppu_write_7
                            	   555: 
                            	   556: ;------------------------------------------------------------------------------
                            	   557: ; void c_turn_off_all_video(void);
                            	   558: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   559: ;------------------------------------------------------------------------------
                            	   560: c_turn_off_all_video:
02:0002B688 4EF90004A982    	   561:     jmp     TurnOffAllVideo
                            	   562: 
                            	   563: ;==============================================================================
                            	   564: ; EXPORT side — z_03 entry point.
                            	   565: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   566: ; the transpiler emits that label pointing to this shim instead of the
                            	   567: ; z_03 asm body. The C function takes no args and returns void.
                            	   568: ;==============================================================================
                            	   569: 
                            	   570: ;------------------------------------------------------------------------------
                            	   571: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   572: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   573: ;------------------------------------------------------------------------------
                            	   574: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   575:     jmp     z03_transfer_level_pattern_blocks
                            	   576: 
                            	   577: ;==============================================================================
                            	   578: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   579: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   580: ;==============================================================================
                            	   581: 
                            	   582: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   583:     jmp     z06_init_mode2_submodes
                            	   584: 
                            	   585: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   586:     jmp     z06_copy_common_data_to_ram
                            	   587: 
                            	   588: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   589:     jmp     z06_update_mode2_load_full
                            	   590: 
                            	   591: ;==============================================================================
                            	   592: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   593: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   594: ;==============================================================================
                            	   595: 
                            	   596: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   597:     jmp     z05_copy_column_to_tilebuf
                            	   598: 
                            	   599: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   600:     jmp     z05_copy_row_to_tilebuf
                            	   601: 
                            	   602: ;==============================================================================
                            	   603: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   604: ;==============================================================================
                            	   605: 
                            	   606: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   607: c_has_compass:
02:0002B6B2 4EB900000000    	   608:     jsr     z05_has_compass
02:0002B6B8 4A00            	   609:     tst.b   D0
02:0002B6BA 4E75            	   610:     rts
                            	   611: 
                            	   612: c_has_map:
02:0002B6BC 4EB900000000    	   613:     jsr     z05_has_map
02:0002B6C2 4A00            	   614:     tst.b   D0
02:0002B6C4 4E75            	   615:     rts
                            	   616: 
                            	   617: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   618: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   619:     move.l  D0,-(SP)
02:0002B6C8 7200            	   620:     moveq   #0,D1
02:0002B6CA 1202            	   621:     move.b  D2,D1
02:0002B6CC 2F01            	   622:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   623:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   624:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   625:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   626:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   627:     addq.l  #8,SP
02:0002B6E2 201F            	   628:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   629:     rts
                            	   630: 
                            	   631: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   632: c_add_door_flags:
02:0002B6E6 4EF900000000    	   633:     jmp     z05_add_door_flags
                            	   634: 
                            	   635: ;==============================================================================
                            	   636: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   637: ;==============================================================================
                            	   638: 
                            	   639: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   640: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   641: c_split_room_id:
02:0002B6EC 4EB900000000    	   642:     jsr     z05_split_room_id
02:0002B6F2 7600            	   643:     moveq   #0,D3
02:0002B6F4 1600            	   644:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   645:     lsr.w   #8,D0
02:0002B6F8 7400            	   646:     moveq   #0,D2
02:0002B6FA 1400            	   647:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   648:     rts
                            	   649: 
                            	   650: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   651: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   652: c_is_dark_room:
02:0002B6FE 7000            	   653:     moveq   #0,D0
02:0002B700 3003            	   654:     move.w  D3,D0
02:0002B702 2F00            	   655:     move.l  D0,-(SP)
02:0002B704 4EB900000000    	   656:     jsr     z05_is_dark_room
02:0002B70A 588F            	   657:     addq.l  #4,SP
02:0002B70C 4A00            	   658:     tst.b   D0
02:0002B70E 4E75            	   659:     rts
                            	   660: 
                            	   661: ; SetDoorFlag — D2=dir_idx. Calls get_room_flags internally, writes flag.
                            	   662: c_set_door_flag:
02:0002B710 7000            	   663:     moveq   #0,D0
02:0002B712 3002            	   664:     move.w  D2,D0
02:0002B714 2F00            	   665:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	   666:     jsr     z05_set_door_flag
02:0002B71C 588F            	   667:     addq.l  #4,SP
02:0002B71E 4E75            	   668:     rts
                            	   669: 
                            	   670: ; ResetDoorFlag — D2=dir_idx.
                            	   671: c_reset_door_flag:
02:0002B720 7000            	   672:     moveq   #0,D0
02:0002B722 3002            	   673:     move.w  D2,D0
02:0002B724 2F00            	   674:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	   675:     jsr     z05_reset_door_flag
02:0002B72C 588F            	   676:     addq.l  #4,SP
02:0002B72E 4E75            	   677:     rts
                            	   678: 
                            	   679: ; CheckHasLivingMonsters — no args, void return.
                            	   680: c_check_has_living_monsters:
02:0002B730 4EF900000000    	   681:     jmp     z05_check_has_living_monsters
                            	   682: 
