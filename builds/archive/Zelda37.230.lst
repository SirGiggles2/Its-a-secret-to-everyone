                            	  1891:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1892:     ; - layout $23: pattern 1: 2 statues
                            	  1893:     ; - layout $24: pattern 0: 4 statues
                            	  1894:     ;
02:0003A4A6 4EB90004ADA0    	  1895:     jsr     GetUniqueRoomId
02:0003A4AC 7601            	  1896:     moveq   #1,D3
                            	  1897: _anon_z04_30:
02:0003A4AE 41F90003A480    	  1898:     lea     (StatueRoomLayouts).l,A0
02:0003A4B4 12303000        	  1899:     move.b  (A0,D3.W),D1
02:0003A4B8 B001            	  1900:     cmp.b   D1,D0
02:0003A4BA 670A            	  1901:     beq  _L_z04_UpdateStatues_Shoot
02:0003A4BC 5303            	  1902:     subq.b  #1,D3
02:0003A4BE 6AEE            	  1903:     bpl  _anon_z04_30
02:0003A4C0 0A3C0001        	  1904:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A4C4 4E75            	  1905:     rts
