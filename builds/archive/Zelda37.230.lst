02:0003C7A6 023C00EE        	  6788:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7AA 41EC0478        	  6789:     lea     ($0478,A4),A0
02:0003C7AE 12302000        	  6790:     move.b  (A0,D2.W),D1
02:0003C7B2 D101            	  6791:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C7B4 41EC0084        	  6792:     lea     ($0084,A4),A0
