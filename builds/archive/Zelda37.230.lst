                            	  2700: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2701:     ; Set state 1 to jump.
                            	  2702:     ;
02:0003A9D2 41EC00AC        	  2703:     lea     ($00AC,A4),A0
