02:0003CDCC 1980203D        	  7694:     move.b  D0,($3D,A4,D2.W)
02:0003CDD0 7008            	  7695:     moveq   #8,D0
02:0003CDD2 4EB90004CD88    	  7696:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7697:     ; If facing left, then enable horizontal flipping.
                            	  7698:     ;
02:0003CDD8 41EC0098        	  7699:     lea     ($0098,A4),A0
02:0003CDDC 10302000        	  7700:     move.b  (A0,D2.W),D0
02:0003CDE0 0C000002        	  7701:     cmpi.b  #$02,D0
02:0003CDE4 6604            	  7702:     bne  _anon_z04_94
02:0003CDE6 522C000F        	  7703:     addq.b  #1,($000F,A4)
                            	  7704: _anon_z04_94:
                            	  7705:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7706:     ; This is the base frame image.
                            	  7707:     ;
02:0003CDEA E208            	  7708:     lsr.b  #1,D0   ; LSR A
02:0003CDEC E208            	  7709:     lsr.b  #1,D0   ; LSR A
                            	  7710:     ; If movement frame = 1, add 3 to frame image to access
                            	  7711:     ; the second animation frame's images.
                            	  7712:     ;
02:0003CDEE 7600            	  7713:     moveq   #0,D3
02:0003CDF0 41EC03E4        	  7714:     lea     ($03E4,A4),A0
02:0003CDF4 16302000        	  7715:     move.b  (A0,D2.W),D3
02:0003CDF8 671E            	  7716:     beq  _anon_z04_95
02:0003CDFA 023C00EE        	  7717:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDFE 123C0003        	  7718:     move.b  #$03,D1
02:0003CE02 D101            	  7719:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7720:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7721:     ;
                            	  7722:     ; Down has two frame images, but up only has one. By flipping
                            	  7723:     ; horizontally, you get two frame images.
                            	  7724:     ;
02:0003CE04 7600            	  7725:     moveq   #0,D3
02:0003CE06 41EC0098        	  7726:     lea     ($0098,A4),A0
02:0003CE0A 16302000        	  7727:     move.b  (A0,D2.W),D3
02:0003CE0E 0C030008        	  7728:     cmpi.b  #$08,D3
02:0003CE12 6604            	  7729:     bne  _anon_z04_95
02:0003CE14 522C000F        	  7730:     addq.b  #1,($000F,A4)
