02:0003CEE2 10302000        	  7844:     move.b  (A0,D2.W),D0
02:0003CEE6 0A00000C        	  7845:     eori.b #$0C,D0
02:0003CEEA 41EC0098        	  7846:     lea     ($0098,A4),A0
02:0003CEEE 11802000        	  7847:     move.b  D0,(A0,D2.W)
02:0003CEF2 6000008C        	  7848:     jmp     L_PolsVoice_DrawAndCheckCollisions
