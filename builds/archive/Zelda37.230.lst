02:0003FD38 19430005        	 14230:     move.b  D3,($0005,A4)
                            	 14231:     ; First, rotate the X coordinate.
                            	 14232:     ;
                            	 14233:     ; Look up the sine for the current angle, and store it in [00].
                            	 14234:     ;
02:0003FD3C 41EC0394        	 14235:     lea     ($0394,A4),A0
02:0003FD40 10302000        	 14236:     move.b  (A0,D2.W),D0
02:0003FD44 0200000F        	 14237:     andi.b #$0F,D0
02:0003FD48 7600            	 14238:     moveq   #0,D3
02:0003FD4A 1600            	 14239:     move.b  D0,D3
02:0003FD4C 41F90003FD24    	 14240:     lea     (PatraSines).l,A0
02:0003FD52 10303000        	 14241:     move.b  (A0,D3.W),D0
02:0003FD56 1880            	 14242:     move.b  D0,($0000,A4)
                            	 14243:     ; Mutliply q-speed by [00].
                            	 14244:     ;
                            	 14245:     ; Q-speed has the default value $20 set when entering the room.
                            	 14246:     ;
02:0003FD58 41EC03BC        	 14247:     lea     ($03BC,A4),A0
02:0003FD5C 10302000        	 14248:     move.b  (A0,D2.W),D0
02:0003FD60 7600            	 14249:     moveq   #0,D3
02:0003FD62 162C0005        	 14250:     move.b  ($0005,A4),D3
02:0003FD66 61000136        	 14251:     jsr     ShiftMultiply
                            	 14252:     ; The absolute X increment for the current angle is now in [02:03].
                            	 14253:     ;
