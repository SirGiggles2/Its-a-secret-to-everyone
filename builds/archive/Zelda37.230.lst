                            	  7590: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD06 101D            	  7591:     move.b  (A5)+,D0  ; PLA
02:0003CD08 7600            	  7592:     moveq   #0,D3
02:0003CD0A 1600            	  7593:     move.b  D0,D3
                            	  7594:     ; If facing vertically, then return. There's no other side to draw.
                            	  7595:     ;
02:0003CD0C 41EC0098        	  7596:     lea     ($0098,A4),A0
02:0003CD10 10302000        	  7597:     move.b  (A0,D2.W),D0
02:0003CD14 02000003        	  7598:     andi.b #$03,D0
02:0003CD18 6602            	  7599:     bne.s  __far_z_04_0067
02:0003CD1A 602E            	  7600:     jmp  L11B00_Exit
                            	  7601: __far_z_04_0067:
                            	  7602:     ; Else draw the right side.
                            	  7603:     ;
                            	  7604:     ; Keep the Y coordinate in [01].
                            	  7605:     ; But, store (X + $10) in [00].
                            	  7606:     ;
02:0003CD1C 10342070        	  7607:     move.b  ($70,A4,D2.W),D0
02:0003CD20 023C00EE        	  7608:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD24 123C0010        	  7609:     move.b  #$10,D1
02:0003CD28 D101            	  7610:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD2A 1880            	  7611:     move.b  D0,($0000,A4)
02:0003CD2C 6114            	  7612:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7613:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7614:     ;
                            	  7615:     ; So, if we had animation frame 1, direction left:
                            	  7616:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7617:     ; - frame image index = 6 (1 + 5)
                            	  7618:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7619:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7620:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7621:     ;
                            	  7622:     ; So, 3 would have been the frame number used above for
                            	  7623:     ; the left side.
                            	  7624:     ;
                            	  7625:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7626:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7627:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7628:     ; on the right.
                            	  7629:     ;
02:0003CD2E 41F90003CC24    	  7630:     lea     (DodongoFrameImages).l,A0
02:0003CD34 10303000        	  7631:     move.b  (A0,D3.W),D0
02:0003CD38 0A000001        	  7632:     eori.b #$01,D0
02:0003CD3C 4EF900031800    	  7633:     jmp     DrawObjectNotMirrored
                            	  7634: 
                            	  7635: ; Returns:
                            	  7636: ; A: 3
                            	  7637: ; [04]: left sprite attributes
                            	  7638: ; [05]: right sprite attributes
                            	  7639: ;
                            	  7640:     even
                            	  7641: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD42 7003            	  7642:     moveq   #3,D0
02:0003CD44 4EB900031AF2    	  7643:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7644:     even
