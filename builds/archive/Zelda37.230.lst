02:0003C324 19802070        	  6240:     move.b  D0,($70,A4,D2.W)
02:0003C328 41EC0084        	  6241:     lea     ($0084,A4),A0
02:0003C32C 10302000        	  6242:     move.b  (A0,D2.W),D0
02:0003C330 023C00EE        	  6243:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C334 41F90003C1D0    	  6244:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C33A 12303000        	  6245:     move.b  (A0,D3.W),D1
02:0003C33E D101            	  6246:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C340 41EC0084        	  6247:     lea     ($0084,A4),A0
02:0003C344 11802000        	  6248:     move.b  D0,(A0,D2.W)
                            	  6249:     ; Check the room boundary and object collisions in this temporary location.
