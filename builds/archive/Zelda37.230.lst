                            	  8298:     ; In UW. There are two input directions, and they're both walkable.
                            	  8299:     ;
                            	  8300:     ; Normally, turn to the direction that's perpendicular to object
                            	  8301:     ; direction. But keep going straight after that, while diagonal
                            	  8302:     ; input is held.
                            	  8303:     ;
                            	  8304:     ; Handle special cases for doors.
                            	  8305:     ;
                            	  8306:     ;
                            	  8307:     ; 1. Link at horizontal doors.
                            	  8308:     ;
                            	  8309:     ; If Link's X = $20 or $D0 then
                            	  8310:     ;   If Link's Y = $85 and facing down then
                            	  8311:     ;     Go set object direction and input direction to object
                            	  8312:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8313:     ;     Link_GoStraightWhenDiagInput.
