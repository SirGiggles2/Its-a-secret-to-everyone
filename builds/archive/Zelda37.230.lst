02:00031E64 19400051        	  6633:     move.b  D0,($0051,A4)
                            	  6634:     ; If heart partial >= low damage points byte, then simply
                            	  6635:     ; subtract the damage byte from heart partial.
                            	  6636:     ; Else go borrow from full hearts.
