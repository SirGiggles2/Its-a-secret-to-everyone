02:00031E74 003C0011        	  6642:     ori     #$11,CCR  ; SEC: set C+X
02:00031E78 122C000E        	  6643:     move.b  ($000E,A4),D1
02:00031E7C 0A3C0010        	  6644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031E80 9101            	  6645:     subx.b  D1,D0   ; SBC $0E
02:00031E82 0A3C0010        	  6646:     eori    #$10,CCR  ; restore X = 6502 C
02:00031E86 19400670        	  6647:     move.b  D0,($0670,A4)
                            	  6648:     ; If full hearts >= high damage points byte, then simply
