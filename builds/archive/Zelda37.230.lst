02:00030E54 60000080        	  4536:     jmp  L69AB_Exit
                            	  4537: __far_z_01_0029:
                            	  4538:     even
                            	  4539: _L_z01_WieldBomb_FoundSlot:
                            	  4540:     ; We found a slot that's empty or has a fire. It could be $10 or $11.
                            	  4541:     ; If the other slot has a bomb that's not yet detonating (state < $13),
                            	  4542:     ; then return.
                            	  4543:     ;
02:00030E58 1002            	  4544:     move.b  D2,D0
02:00030E5A 0A000001        	  4545:     eori.b #$01,D0
02:00030E5E 7600            	  4546:     moveq   #0,D3
02:00030E60 1600            	  4547:     move.b  D0,D3
02:00030E62 41EC00AC        	  4548:     lea     ($00AC,A4),A0
02:00030E66 10303000        	  4549:     move.b  (A0,D3.W),D0
02:00030E6A 6708            	  4550:     beq  _L_z01_WieldBomb_Activate
02:00030E6C 0C000013        	  4551:     cmpi.b  #$13,D0
02:00030E70 6402            	  4552:     bcc.s  __far_z_01_0030
02:00030E72 6062            	  4553:     jmp  L69AB_Exit
