                            	   844: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   845:     ; The index chooses the low VRAM address of the start
                            	   846:     ; of another line:
                            	   847:     ;   0: $C4: front of the second line
                            	   848:     ;   1: $E4: front of the third line
                            	   849:     ;   2: $A4: front of the first line
                            	   850:     ;
                            	   851:     ; Look up the low VRAM address and store it.
                            	   852:     ;
02:0002E4DA 41F90002E408    	   853:     lea     (TextboxLineAddrsLo).l,A0
02:0002E4E0 10303000        	   854:     move.b  (A0,D3.W),D0
02:0002E4E4 1940045F        	   855:     move.b  D0,($045F,A4)
                            	   856:     ; If index = 2, then we've reached the end of the text,
                            	   857:     ; and low VRAM address is moved to the front of the first line.
                            	   858:     ; So, advance the state of the person object, and unhalt Link.
                            	   859:     ;
02:0002E4E8 0C030002        	   860:     cmpi.b  #$02,D3
02:0002E4EC 6608            	   861:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E4EE 522C00AD        	   862:     addq.b  #1,($00AD,A4)
02:0002E4F2 6100FB98        	   863:     jsr     UnhaltLink
