                            	  4762: 
                            	  4763: ; Params:
                            	  4764: ; [02:03]: address of door tiles for direction and face
                            	  4765: ; [04]: count of tiles remaining
                            	  4766: ; [07]: current index (0 to 3) of the tile to copy
                            	  4767: ;       to the dynamic transfer buf
                            	  4768: ; [09]: door direction index
                            	  4769: ;
                            	  4770: ; Returns:
                            	  4771: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4772: ; [04]: original value - 1
                            	  4773: ; [07]: original value + 1
                            	  4774: ;
                            	  4775: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4776: ; vertically. The point of this routine is to access them
                            	  4777: ; horizontally in order to transfer them to a nametable.
                            	  4778: ;
                            	  4779: ;
                            	  4780: ; For the direction index in [09], look up the base offset of the
                            	  4781: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4782: ; the door face tiles at [02:03].
                            	  4783: ;
                            	  4784:     even
                            	  4785: WriteDoorFaceTileHorizontally:
02:00042598 7600            	  4786:     moveq   #0,D3
02:0004259A 162C0009        	  4787:     move.b  ($0009,A4),D3
02:0004259E 41F9000437BC    	  4788:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000425A4 10303000        	  4789:     move.b  (A0,D3.W),D0
                            	  4790:     ; Add [07] to the base offset we got above. This yields one
                            	  4791:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4792:     ;
02:000425A8 023C00EE        	  4793:     andi    #$EE,CCR  ; CLC: clear C+X
02:000425AC 122C0007        	  4794:     move.b  ($0007,A4),D1
02:000425B0 D101            	  4795:     addx.b  D1,D0   ; ADC $07
02:000425B2 7600            	  4796:     moveq   #0,D3
02:000425B4 1600            	  4797:     move.b  D0,D3
                            	  4798:     ; With that index, look up the index to use with the door face
                            	  4799:     ; list of tiles at [02:03].
                            	  4800:     ;
02:000425B6 41F9000437AE    	  4801:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000425BC 10303000        	  4802:     move.b  (A0,D3.W),D0
02:000425C0 7600            	  4803:     moveq   #0,D3
02:000425C2 1600            	  4804:     move.b  D0,D3
                            	  4805:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4806:     ; and copy it to the dynamic transfer buf.
                            	  4807:     ;
02:000425C4 122C0002        	  4808:     move.b  ($02,A4),D1   ; ptr lo
02:000425C8 182C0003        	  4809:     move.b  ($03,A4),D4  ; ptr hi
02:000425CC 024100FF        	  4810:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000425D0 E14C            	  4811:     lsl.w   #8,D4
02:000425D2 8841            	  4812:     or.w    D1,D4             ; D4 = NES ptr addr
02:000425D4 48C4            	  4813:     ext.l   D4
02:000425D6 D8BC00FF0000    	  4814:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000425DC 2044            	  4815:     movea.l D4,A0
02:000425DE 10303000        	  4816:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000425E2 41EC0302        	  4817:     lea     ($0302,A4),A0
02:000425E6 11802000        	  4818:     move.b  D0,(A0,D2.W)
                            	  4819:     ; Prepare for the next call:
                            	  4820:     ; - increment dynamic transfer buf pointer
                            	  4821:     ; - increment index of tile to copy [07]
                            	  4822:     ; - decrement count of tiles remaining
                            	  4823:     ;
02:000425EA 5202            	  4824:     addq.b  #1,D2
02:000425EC 522C0007        	  4825:     addq.b  #1,($0007,A4)
02:000425F0 532C0004        	  4826:     subq.b  #1,($0004,A4)
02:000425F4 4E75            	  4827:     rts
                            	  4828: 
