                            	  4031:     ; If Link's X < $70 or >= $81, then return.
                            	  4032:     ;
02:0003B346 102C0070        	  4033:     move.b  ($0070,A4),D0
02:0003B34A 0C000070        	  4034:     cmpi.b  #$70,D0
