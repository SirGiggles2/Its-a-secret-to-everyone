                            	  9573:     ; Also set its timer to $10.
                            	  9574:     ;
02:0003DC06 61001AE6        	  9575:     jsr     PlayBossDeathCry
02:0003DC0A 705D            	  9576:     moveq   #93,D0
02:0003DC0C 19400354        	  9577:     move.b  D0,($0354,A4)
02:0003DC10 7010            	  9578:     moveq   #16,D0
02:0003DC12 1940040A        	  9579:     move.b  D0,($040A,A4)
02:0003DC16 1940002D        	  9580:     move.b  D0,($002D,A4)
                            	  9581:     even
