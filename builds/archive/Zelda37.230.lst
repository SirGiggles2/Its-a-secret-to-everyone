02:0003235A 7600            	  7468:     moveq   #0,D3
02:0003235C 1614            	  7469:     move.b  ($0000,A4),D3
02:0003235E 0C02000D        	  7470:     cmpi.b  #$0D,D2
02:00032362 6412            	  7471:     bcc  _anon_z01_99
02:00032364 41EC04B2        	  7472:     lea     ($04B2,A4),A0
02:00032368 10302000        	  7473:     move.b  (A0,D2.W),D0
02:0003236C 122C0009        	  7474:     move.b  ($0009,A4),D1
