02:0003DBF4 0C00003C        	  9553:     cmpi.b  #$3C,D0
02:0003DBF8 6602            	  9554:     bne  _anon_z04_113
02:0003DBFA 5214            	  9555:     addq.b  #1,($0000,A4)
                            	  9556: _anon_z04_113:
