02:0002BFCE 670A            	  2058:     beq.s   .cc_iqsm
02:0002BFD0 003C0001        	  2059:     ori     #$01,CCR
02:0002BFD4 0A3C0001        	  2060:     eori    #$01,CCR
02:0002BFD8 4E75            	  2061:     rts
                            	  2062: .cc_iqsm:
02:0002BFDA 023C00FE        	  2063:     andi    #$FE,CCR
02:0002BFDE 0A3C0001        	  2064:     eori    #$01,CCR
