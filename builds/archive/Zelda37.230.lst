                            	  2230: ; Params:
                            	  2231: ; A: Y coordinate
                            	  2232: ; X: object index
                            	  2233: ;
                            	  2234:     even
                            	  2235: InitWhirlwind:
02:0002FEF8 6000BD50        	  2236:     jmp     c_init_whirlwind
                            	  2237: 
                            	  2238: SetUpWhirlwind:
02:0002FEFC 6000BAFC        	  2239:     jmp     c_set_up_whirlwind
                            	  2240: 
                            	  2241: WhirlwindPrevRoomIdList:
02:0002FF00 36              	  2242:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FF01 3B
02:0002FF02 73
02:0002FF03 44
02:0002FF04 0A
02:0002FF05 21
02:0002FF06 41
02:0002FF07 6C
                            	  2243: 
                            	  2244:     even
                            	  2245: UpdateWhirlwind_Full:
                            	  2246:     ; Get Link's halted state.
                            	  2247:     ;
02:0002FF08 102C00AC        	  2248:     move.b  ($00AC,A4),D0
02:0002FF0C 02000040        	  2249:     andi.b #$40,D0
02:0002FF10 7600            	  2250:     moveq   #0,D3
02:0002FF12 1600            	  2251:     move.b  D0,D3
                            	  2252:     ; Add 2 to whirlwind X.
                            	  2253:     ;
02:0002FF14 7002            	  2254:     moveq   #2,D0
02:0002FF16 023C00EE        	  2255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FF1A 12342070        	  2256:     move.b  ($70,A4,D2.W),D1
02:0002FF1E D101            	  2257:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FF20 19802070        	  2258:     move.b  D0,($70,A4,D2.W)
                            	  2259:     ; If Link is not halted or teleporting state = 0, then
                            	  2260:     ; go check for collision with Link.
                            	  2261:     ;
02:0002FF24 0C030040        	  2262:     cmpi.b  #$40,D3
02:0002FF28 6638            	  2263:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FF2A 7600            	  2264:     moveq   #0,D3
02:0002FF2C 162C0522        	  2265:     move.b  ($0522,A4),D3
02:0002FF30 6730            	  2266:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2267:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2268:     ;
                            	  2269:     ; Set Link's X to whirlwind's.
                            	  2270:     ;
02:0002FF32 19400070        	  2271:     move.b  D0,($0070,A4)
                            	  2272:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2273:     ; the right screen edge and draw.
                            	  2274:     ;
02:0002FF36 5303            	  2275:     subq.b  #1,D3
02:0002FF38 6776            	  2276:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FF3A 0C000080        	  2277:     cmpi.b  #$80,D0
02:0002FF3E 6670            	  2278:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2279:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2280:     ;
                            	  2281:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2282:     ;
02:0002FF40 E308            	  2283:     lsl.b  #1,D0   ; ASL A
02:0002FF42 194000AC        	  2284:     move.b  D0,($00AC,A4)
02:0002FF46 19400522        	  2285:     move.b  D0,($0522,A4)
02:0002FF4A 41EC034F        	  2286:     lea     ($034F,A4),A0
02:0002FF4E 11802000        	  2287:     move.b  D0,(A0,D2.W)
                            	  2288:     ; Update the player position marker, and draw one last time.
                            	  2289:     ;
02:0002FF52 1002            	  2290:     move.b  D2,D0
02:0002FF54 1B00            	  2291:     move.b  D0,-(A5)  ; PHA
02:0002FF56 61001096        	  2292:     jsr     UpdatePlayerPositionMarker
02:0002FF5A 101D            	  2293:     move.b  (A5)+,D0  ; PLA
02:0002FF5C 7400            	  2294:     moveq   #0,D2
02:0002FF5E 1400            	  2295:     move.b  D0,D2
02:0002FF60 6070            	  2296:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2297: 
                            	  2298:     even
                            	  2299: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2300:     ; Link is not halted or teleporting state = 0.
                            	  2301:     ; Try to pick up Link.
                            	  2302:     ;
                            	  2303:     ; If the whirlwind does not collide with Link, then go check
                            	  2304:     ; for the screen's right edge.
                            	  2305:     ;
02:0002FF62 61001D62        	  2306:     jsr     CheckLinkCollision
02:0002FF66 102C0006        	  2307:     move.b  ($0006,A4),D0
02:0002FF6A 6744            	  2308:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2309:     ; Collided with Link.
                            	  2310:     ;
                            	  2311:     ; Make Link face right. Reset shove info and subroom type.
                            	  2312:     ;
02:0002FF6C 7001            	  2313:     moveq   #1,D0
02:0002FF6E 19400098        	  2314:     move.b  D0,($0098,A4)
02:0002FF72 E208            	  2315:     lsr.b  #1,D0   ; LSR A
02:0002FF74 194000C0        	  2316:     move.b  D0,($00C0,A4)
02:0002FF78 194000D3        	  2317:     move.b  D0,($00D3,A4)
02:0002FF7C 1940005A        	  2318:     move.b  D0,($005A,A4)
                            	  2319:     ; Halt Link (state $40), and hide him.
                            	  2320:     ;
02:0002FF80 7040            	  2321:     moveq   #64,D0
02:0002FF82 194000AC        	  2322:     move.b  D0,($00AC,A4)
02:0002FF86 103C00F8        	  2323:     move.b  #$F8,D0
02:0002FF8A 19400248        	  2324:     move.b  D0,($0248,A4)
02:0002FF8E 1940024C        	  2325:     move.b  D0,($024C,A4)
                            	  2326:     ; Find and set the room that will behave as the previous room
                            	  2327:     ; when scrolling right to the room with the level's entrance.
                            	  2328:     ;
02:0002FF92 102C0523        	  2329:     move.b  ($0523,A4),D0
02:0002FF96 02000007        	  2330:     andi.b #$07,D0
02:0002FF9A 7600            	  2331:     moveq   #0,D3
02:0002FF9C 1600            	  2332:     move.b  D0,D3
02:0002FF9E 41F90002FF00    	  2333:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FFA4 10303000        	  2334:     move.b  (A0,D3.W),D0
02:0002FFA8 194000EA        	  2335:     move.b  D0,($00EA,A4)
                            	  2336:     ; Set teleporting state 1.
                            	  2337:     ;
02:0002FFAC 522C0522        	  2338:     addq.b  #1,($0522,A4)
                            	  2339:     even
                            	  2340: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2341:     ; If whirlwind's X < $F0, go draw.
                            	  2342:     ;
02:0002FFB0 10342070        	  2343:     move.b  ($70,A4,D2.W),D0
02:0002FFB4 0C0000F0        	  2344:     cmpi.b  #$F0,D0
02:0002FFB8 6518            	  2345:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2346:     ; The whirlwind has reached the right edge of the screen.
                            	  2347:     ;
                            	  2348:     ; Destroy the object.
