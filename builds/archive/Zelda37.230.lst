                            	  8100: Submenu_CueTransferRowOW:
                            	  8101:     ;
                            	  8102:     ;
                            	  8103:     ; If menu scroll value is negative, then we transferred everything.
                            	  8104:     ; So, return.
                            	  8105:     ;
02:00044C2C 102C005E        	  8106:     move.b  ($005E,A4),D0
