                            	  6719: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6720: ;
                            	  6721:     even
                            	  6722: CheckMonsterBoomerangOrFoodCollision:
02:00031F16 41EC00AC        	  6723:     lea     ($00AC,A4),A0
02:00031F1A 10303000        	  6724:     move.b  (A0,D3.W),D0
02:00031F1E E308            	  6725:     lsl.b  #1,D0   ; ASL A
