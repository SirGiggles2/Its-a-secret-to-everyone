                            	  9776: UpdateGohma:
                            	  9777:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9778:     ;
02:0003DDA0 41EC0451        	  9779:     lea     ($0451,A4),A0
02:0003DDA4 10302000        	  9780:     move.b  (A0,D2.W),D0
02:0003DDA8 662C            	  9781:     bne  _L_z04_UpdateGohma_Move
                            	  9782:     ; If Random:
                            	  9783:     ;   >= $B0: right
                            	  9784:     ;   >= $60: left
                            	  9785:     ;   Else:   down
                            	  9786:     ;
02:0003DDAA 7001            	  9787:     moveq   #1,D0
02:0003DDAC 7600            	  9788:     moveq   #0,D3
02:0003DDAE 16342018        	  9789:     move.b  ($18,A4,D2.W),D3
02:0003DDB2 0C0300B0        	  9790:     cmpi.b  #$B0,D3
02:0003DDB6 640A            	  9791:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDB8 E308            	  9792:     lsl.b  #1,D0   ; ASL A
02:0003DDBA 0C030060        	  9793:     cmpi.b  #$60,D3
02:0003DDBE 6402            	  9794:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDC0 E308            	  9795:     lsl.b  #1,D0   ; ASL A
                            	  9796:     even
                            	  9797: _L_z04_UpdateGohma_ChangeDir:
