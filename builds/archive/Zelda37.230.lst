                            	 11687: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003EBEC 10342070        	 11688:     move.b  ($70,A4,D2.W),D0
02:0003EBF0 1B00            	 11689:     move.b  D0,-(A5)  ; PHA
                            	 11690:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11691:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11692:     ;
02:0003EBF2 023C00EE        	 11693:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EBF6 123C0004        	 11694:     move.b  #$04,D1
02:0003EBFA D101            	 11695:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EBFC 19802070        	 11696:     move.b  D0,($70,A4,D2.W)
                            	 11697:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11698:     ; to store in [03].
                            	 11699:     ;
02:0003EC00 102C04E6        	 11700:     move.b  ($04E6,A4),D0
02:0003EC04 0A000003        	 11701:     eori.b #$03,D0
02:0003EC08 19400003        	 11702:     move.b  D0,($0003,A4)
                            	 11703:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11704:     ;
02:0003EC0C 103C009E        	 11705:     move.b  #$9E,D0
02:0003EC10 0C020005        	 11706:     cmpi.b  #$05,D2
02:0003EC14 670A            	 11707:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC16 0C02000A        	 11708:     cmpi.b  #$0A,D2
02:0003EC1A 6704            	 11709:     beq  _L_z04_UpdateLamnola_Draw
02:0003EC1C 103C00A0        	 11710:     move.b  #$A0,D0
                            	 11711:     even
                            	 11712: _L_z04_UpdateLamnola_Draw:
02:0003EC20 4EB900031AFC    	 11713:     jsr     Anim_WriteSprite
02:0003EC26 101D            	 11714:     move.b  (A5)+,D0  ; PLA
02:0003EC28 19802070        	 11715:     move.b  D0,($70,A4,D2.W)
02:0003EC2C 41EC0098        	 11716:     lea     ($0098,A4),A0
02:0003EC30 10302000        	 11717:     move.b  (A0,D2.W),D0
02:0003EC34 1B00            	 11718:     move.b  D0,-(A5)  ; PHA
02:0003EC36 4EB900031B7C    	 11719:     jsr     CheckMonsterCollisions
02:0003EC3C 101D            	 11720:     move.b  (A5)+,D0  ; PLA
02:0003EC3E 41EC0098        	 11721:     lea     ($0098,A4),A0
02:0003EC42 11802000        	 11722:     move.b  D0,(A0,D2.W)
                            	 11723:     ; If still alive, then return.
                            	 11724:     ;
02:0003EC46 41EC0405        	 11725:     lea     ($0405,A4),A0
02:0003EC4A 10302000        	 11726:     move.b  (A0,D2.W),D0
02:0003EC4E 6604            	 11727:     bne.s  __far_z_04_0115
02:0003EC50 6000FF72        	 11728:     jmp  L129EA_Exit
                            	 11729: __far_z_04_0115:
                            	 11730:     ; Otherwise, the segment is dead.
                            	 11731:     ;
02:0003EC54 4EB90004B712    	 11732:     jsr     ResetShoveInfo
                            	 11733:     ; Set the current segment's HP to the initial value in anticipation
                            	 11734:     ; of bringing this segment back to life.
                            	 11735:     ;
02:0003EC5A 7020            	 11736:     moveq   #32,D0
02:0003EC5C 41EC0485        	 11737:     lea     ($0485,A4),A0
02:0003EC60 11802000        	 11738:     move.b  D0,(A0,D2.W)
                            	 11739:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11740:     ;
                            	 11741:     ; From the lowest slot, look for one that has the original lamnola
                            	 11742:     ; object type.
                            	 11743:     ;
                            	 11744:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11745:     ;
02:0003EC64 163C00FF        	 11746:     move.b  #$FF,D3
02:0003EC68 0C020006        	 11747:     cmpi.b  #$06,D2
02:0003EC6C 6502            	 11748:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EC6E 7604            	 11749:     moveq   #4,D3
                            	 11750:     even
                            	 11751: _L_z04_UpdateLamnola_FindTail:
02:0003EC70 5203            	 11752:     addq.b  #1,D3
02:0003EC72 41EC0350        	 11753:     lea     ($0350,A4),A0
02:0003EC76 10303000        	 11754:     move.b  (A0,D3.W),D0
02:0003EC7A 122C04E7        	 11755:     move.b  ($04E7,A4),D1
02:0003EC7E B001            	 11756:     cmp.b   D1,D0
02:0003EC80 66EE            	 11757:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11758:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11759:     ;
02:0003EC82 7011            	 11760:     moveq   #17,D0
02:0003EC84 19803029        	 11761:     move.b  D0,($29,A4,D3.W)
                            	 11762:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11763:     ; to the tail segment.
                            	 11764:     ;
02:0003EC88 41EC04F0        	 11765:     lea     ($04F0,A4),A0
02:0003EC8C 10302000        	 11766:     move.b  (A0,D2.W),D0
02:0003EC90 41EC04F1        	 11767:     lea     ($04F1,A4),A0
02:0003EC94 11803000        	 11768:     move.b  D0,(A0,D3.W)
02:0003EC98 10342070        	 11769:     move.b  ($70,A4,D2.W),D0
02:0003EC9C 19803071        	 11770:     move.b  D0,($71,A4,D3.W)
02:0003ECA0 41EC0084        	 11771:     lea     ($0084,A4),A0
02:0003ECA4 10302000        	 11772:     move.b  (A0,D2.W),D0
02:0003ECA8 41EC0085        	 11773:     lea     ($0085,A4),A0
02:0003ECAC 11803000        	 11774:     move.b  D0,(A0,D3.W)
                            	 11775:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11776:     ; So, return and leave it dead.
                            	 11777:     ;
02:0003ECB0 0C030004        	 11778:     cmpi.b  #$04,D3
02:0003ECB4 6604            	 11779:     bne.s  __far_z_04_0116
02:0003ECB6 6000FF0C        	 11780:     jmp  L129EA_Exit
                            	 11781: __far_z_04_0116:
02:0003ECBA 0C030009        	 11782:     cmpi.b  #$09,D3
02:0003ECBE 6604            	 11783:     bne.s  __far_z_04_0117
02:0003ECC0 6000FF02        	 11784:     jmp  L129EA_Exit
                            	 11785: __far_z_04_0117:
                            	 11786:     ; Change the tail segment to the dead dummy object, and
                            	 11787:     ; bring the current segment back to life.
                            	 11788:     ;
02:0003ECC4 705D            	 11789:     moveq   #93,D0
02:0003ECC6 41EC0350        	 11790:     lea     ($0350,A4),A0
02:0003ECCA 11803000        	 11791:     move.b  D0,(A0,D3.W)
02:0003ECCE 4EF90004D596    	 11792:     jmp     ResetObjMetastate
                            	 11793: 
