                            	  9738: Manhandla_Draw:
02:0003DD56 4EB90004CD8E    	  9739:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9740:     ; Push the "frame image and sprite attributes" value.
                            	  9741:     ;
02:0003DD5C 41EC0478        	  9742:     lea     ($0478,A4),A0
02:0003DD60 10302000        	  9743:     move.b  (A0,D2.W),D0
02:0003DD64 1B00            	  9744:     move.b  D0,-(A5)  ; PHA
                            	  9745:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9746:     ; passed along as is.
                            	  9747:     ;
02:0003DD66 02000080        	  9748:     andi.b #$80,D0
02:0003DD6A 00000001        	  9749:     ori.b #$01,D0
02:0003DD6E 4EB900031AF2    	  9750:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DD74 101D            	  9751:     move.b  (A5)+,D0  ; PLA
02:0003DD76 1B00            	  9752:     move.b  D0,-(A5)  ; PHA
                            	  9753:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9754:     ;
02:0003DD78 02000040        	  9755:     andi.b #$40,D0
02:0003DD7C 6704            	  9756:     beq  _anon_z04_116
02:0003DD7E 522C000F        	  9757:     addq.b  #1,($000F,A4)
