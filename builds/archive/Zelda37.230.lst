02:0003CE96 10302000        	  7808:     move.b  (A0,D2.W),D0
02:0003CE9A 023C00EE        	  7809:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE9E 41F90003CE2E    	  7810:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CEA4 12303000        	  7811:     move.b  (A0,D3.W),D1
02:0003CEA8 D101            	  7812:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CEAA 41EC0084        	  7813:     lea     ($0084,A4),A0
02:0003CEAE 11802000        	  7814:     move.b  D0,(A0,D2.W)
                            	  7815:     even
                            	  7816: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7817:     ; If the square the monster is over is walkable, then
                            	  7818:     ; go draw and check object collisions.
                            	  7819:     ;
02:0003CEB2 610001F4        	  7820:     jsr     PolsVoice_IsSquareWalkable
02:0003CEB6 6452            	  7821:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7822:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7823:     ; then go change to state 1.
                            	  7824:     ;
02:0003CEB8 41EC041F        	  7825:     lea     ($041F,A4),A0
02:0003CEBC 10302000        	  7826:     move.b  (A0,D2.W),D0
02:0003CEC0 020000FC        	  7827:     andi.b #$FC,D0
02:0003CEC4 0C0000B0        	  7828:     cmpi.b  #$B0,D0
02:0003CEC8 6742            	  7829:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CECA 0C0000F4        	  7830:     cmpi.b  #$F4,D0
02:0003CECE 643C            	  7831:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7832:     ; Else blocked by something else.
