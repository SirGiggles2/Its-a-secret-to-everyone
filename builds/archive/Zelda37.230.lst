                            	  8071: PrepFullBlackRow:
                            	  8072:     ; Prepare the dynamic transfer buf with a row of blank ($24) tiles
                            	  8073:     ; to transfer to row (7 + Y).
                            	  8074:     ;
                            	  8075:     ; Calculate PPU address ($28E0 + Y*$20).
                            	  8076:     ;
02:00044BF4 7028            	  8077:     moveq   #40,D0
02:00044BF6 19400302        	  8078:     move.b  D0,($0302,A4)
02:00044BFA 103C00C0        	  8079:     move.b  #$C0,D0
                            	  8080:     even
                            	  8081: _L_z05_PrepFullBlackRow_Add20H:
