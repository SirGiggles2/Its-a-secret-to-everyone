                            	  3793: FormatHeartsInTextBuf:
                            	  3794:     ; [$0E]: hearts value
                            	  3795:     ; [$0F]: heart partial
                            	  3796:     ; Y: The offset of first character in buffer
                            	  3797:     ;
                            	  3798:     ; The end of the bottom row is $12 bytes after the
                            	  3799:     ; start of the top row. We're writing to two transfer
                            	  3800:     ; records. We write the top row in the first transfer
                            	  3801:     ; record wherever the caller chooses. The second
                            	  3802:     ; transfer record has to begin with the heart tiles.
                            	  3803:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3804:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3805:     ;
                            	  3806:     ; Store the starting offset in [$0D].
02:0003096C 1943000D        	  3807:     move.b  D3,($000D,A4)
02:00030970 102C000E        	  3808:     move.b  ($000E,A4),D0
02:00030974 1B00            	  3809:     move.b  D0,-(A5)  ; PHA
02:00030976 0200000F        	  3810:     andi.b #$0F,D0
02:0003097A 1880            	  3811:     move.b  D0,($0000,A4)
02:0003097C 700F            	  3812:     moveq   #15,D0
02:0003097E 003C0011        	  3813:     ori     #$11,CCR  ; SEC: set C+X
02:00030982 1214            	  3814:     move.b  ($0000,A4),D1
02:00030984 0A3C0010        	  3815:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030988 9101            	  3816:     subx.b  D1,D0   ; SBC $00
02:0003098A 0A3C0010        	  3817:     eori    #$10,CCR  ; restore X = 6502 C
02:0003098E 1880            	  3818:     move.b  D0,($0000,A4)
02:00030990 101D            	  3819:     move.b  (A5)+,D0  ; PLA
02:00030992 E208            	  3820:     lsr.b  #1,D0   ; LSR A
02:00030994 E208            	  3821:     lsr.b  #1,D0   ; LSR A
02:00030996 E208            	  3822:     lsr.b  #1,D0   ; LSR A
02:00030998 E208            	  3823:     lsr.b  #1,D0   ; LSR A
02:0003099A 19400001        	  3824:     move.b  D0,($0001,A4)
02:0003099E 700F            	  3825:     moveq   #15,D0
02:000309A0 003C0011        	  3826:     ori     #$11,CCR  ; SEC: set C+X
02:000309A4 122C0001        	  3827:     move.b  ($0001,A4),D1
02:000309A8 0A3C0010        	  3828:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000309AC 9101            	  3829:     subx.b  D1,D0   ; SBC $01
02:000309AE 0A3C0010        	  3830:     eori    #$10,CCR  ; restore X = 6502 C
02:000309B2 19400001        	  3831:     move.b  D0,($0001,A4)
                            	  3832:     ; At this point,
                            	  3833:     ; [$00] = $F - hearts
                            	  3834:     ; [$01] = $F - heart containers
                            	  3835:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3836:     ;
                            	  3837:     ; Also, Y is still set to the value passed in.
                            	  3838:     ;
02:000309B6 7400            	  3839:     moveq   #0,D2
02:000309B8 1003            	  3840:     move.b  D3,D0
02:000309BA 023C00EE        	  3841:     andi    #$EE,CCR  ; CLC: clear C+X
02:000309BE 123C0007        	  3842:     move.b  #$07,D1
02:000309C2 D101            	  3843:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:000309C4 1940000B        	  3844:     move.b  D0,($000B,A4)
                            	  3845:     ; Y keeps track of index of heart in row.
                            	  3846:     ; Start at the end of the first row.
02:000309C8 7607            	  3847:     moveq   #7,D3
                            	  3848:     even
