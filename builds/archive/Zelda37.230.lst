                            	  9897: _L_z04_UpdateGohma_AnimateEye:
                            	  9898:     ; Animate the eye.
                            	  9899:     ;
                            	  9900:     ; First, if the counter for when to open the eye next = 0, then
                            	  9901:     ; set it to a random value at least $C0; and set the timer for
                            	  9902:     ; keeping the eye open to $80.
                            	  9903:     ;
                            	  9904:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9905:     ; every other frame.
                            	  9906:     ;
02:0003DE9A 41EC042C        	  9907:     lea     ($042C,A4),A0
02:0003DE9E 10302000        	  9908:     move.b  (A0,D2.W),D0
02:0003DEA2 661E            	  9909:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEA4 103C0080        	  9910:     move.b  #$80,D0
02:0003DEA8 41EC0444        	  9911:     lea     ($0444,A4),A0
02:0003DEAC 11802000        	  9912:     move.b  D0,(A0,D2.W)
02:0003DEB0 103C00C0        	  9913:     move.b  #$C0,D0
02:0003DEB4 12342018        	  9914:     move.b  ($18,A4,D2.W),D1
02:0003DEB8 8001            	  9915:     or.b  D1,D0
02:0003DEBA 41EC042C        	  9916:     lea     ($042C,A4),A0
02:0003DEBE 11802000        	  9917:     move.b  D0,(A0,D2.W)
                            	  9918:     even
