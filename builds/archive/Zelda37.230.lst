02:0004ADC2 4EB9000315A2    	  2357:     jsr     MapScreenPosToPpuAddr
02:0004ADC8 7400            	  2358:     moveq   #0,D2
02:0004ADCA 142C0301        	  2359:     move.b  ($0301,A4),D2
                            	  2360:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2361:     ;
                            	  2362:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2363:     ; In total, 11 bytes will be written.
                            	  2364:     ;
                            	  2365:     ; First, write the high byte of PPU address in each record.
                            	  2366:     ;
02:0004ADCE 1014            	  2367:     move.b  ($0000,A4),D0
02:0004ADD0 41EC0302        	  2368:     lea     ($0302,A4),A0
02:0004ADD4 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:0004ADD8 41EC0307        	  2370:     lea     ($0307,A4),A0
02:0004ADDC 11802000        	  2371:     move.b  D0,(A0,D2.W)
                            	  2372:     ; Write the low address in the first record. In the second record,
                            	  2373:     ; write (low address + 1).
                            	  2374:     ;
02:0004ADE0 102C0001        	  2375:     move.b  ($0001,A4),D0
02:0004ADE4 41EC0303        	  2376:     lea     ($0303,A4),A0
02:0004ADE8 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:0004ADEC 41EC0308        	  2378:     lea     ($0308,A4),A0
02:0004ADF0 11802000        	  2379:     move.b  D0,(A0,D2.W)
02:0004ADF4 41EC0308        	  2380:     lea     ($0308,A4),A0
02:0004ADF8 52302000        	  2381:     addq.b  #1,(A0,D2.W)
                            	  2382:     ; Write the first tile twice in each record. Patch them later.
                            	  2383:     ;
02:0004ADFC 102C0005        	  2384:     move.b  ($0005,A4),D0
02:0004AE00 41EC0305        	  2385:     lea     ($0305,A4),A0
02:0004AE04 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004AE08 41EC0306        	  2387:     lea     ($0306,A4),A0
02:0004AE0C 11802000        	  2388:     move.b  D0,(A0,D2.W)
02:0004AE10 41EC030A        	  2389:     lea     ($030A,A4),A0
02:0004AE14 11802000        	  2390:     move.b  D0,(A0,D2.W)
02:0004AE18 41EC030B        	  2391:     lea     ($030B,A4),A0
02:0004AE1C 11802000        	  2392:     move.b  D0,(A0,D2.W)
                            	  2393:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2394:     ; Add 1 more to the second byte in each record.
                            	  2395:     ; Here is an example result of this manipulation:
                            	  2396:     ;   record 1: $70, $71
                            	  2397:     ;   record 2: $72, $73
