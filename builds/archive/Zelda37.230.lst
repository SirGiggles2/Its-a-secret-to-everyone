                            	 12042: Lamnola_Move:
                            	 12043:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12044:     ;
                            	 12045:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12046:     ;
                            	 12047:     ; Start with a mask of $A1 in [02]:
                            	 12048:     ; - low nibble represents the right direction
                            	 12049:     ; - high nibble is used to set or clear carry as we go along
                            	 12050:     ;
02:0003EE56 103C00A1        	 12051:     move.b  #$A1,D0
02:0003EE5A 19400002        	 12052:     move.b  D0,($0002,A4)
                            	 12053:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12054:     ;
02:0003EE5E 41EC0098        	 12055:     lea     ($0098,A4),A0
