                            	  4946:     even
                            	  4947: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004BFE8 4EF900031A12    	  4948:     jmp     Anim_WriteItemSprites
                            	  4949: 
                            	  4950: ; Params:
                            	  4951: ; X: shot object index
                            	  4952: ;
                            	  4953: ; If the object is a sword shot, go spread out the shot.
                            	  4954: ;
                            	  4955:     even
                            	  4956: HandleShotBlocked:
02:0004BFEE 41EC00AC        	  4957:     lea     ($00AC,A4),A0
02:0004BFF2 10302000        	  4958:     move.b  (A0,D2.W),D0
02:0004BFF6 E308            	  4959:     lsl.b  #1,D0   ; ASL A
02:0004BFF8 6504            	  4960:     bcs.s  __far_z_07_0075
02:0004BFFA 60000082        	  4961:     jmp  SetShotSpreadingState
                            	  4962: __far_z_07_0075:
                            	  4963:     ; This is a magic shot.
                            	  4964:     ;
                            	  4965:     ; If missing the magic book, go deactivate the shot object.
                            	  4966:     ;
02:0004BFFE 102C0661        	  4967:     move.b  ($0661,A4),D0
02:0004C002 6602            	  4968:     bne.s  __far_z_07_0076
02:0004C004 6072            	  4969:     jmp  DeactivateShot
                            	  4970: __far_z_07_0076:
                            	  4971:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4972:     ; unused, so it only has to depend on having an empty slot.
                            	  4973:     ;
                            	  4974:     ; If successful, Link's state will have been changed to "using item".
                            	  4975:     ; But we don't want that in this case.
                            	  4976:     ;
                            	  4977:     ; For both these reasons, save state and restore it afterward.
                            	  4978:     ;
02:0004C006 102C00AC        	  4979:     move.b  ($00AC,A4),D0
02:0004C00A 1B00            	  4980:     move.b  D0,-(A5)  ; PHA
02:0004C00C 102C0513        	  4981:     move.b  ($0513,A4),D0
02:0004C010 1B00            	  4982:     move.b  D0,-(A5)  ; PHA
02:0004C012 7000            	  4983:     moveq   #0,D0
02:0004C014 19400513        	  4984:     move.b  D0,($0513,A4)
02:0004C018 4EB900030EF6    	  4985:     jsr     WieldCandle
02:0004C01E 101D            	  4986:     move.b  (A5)+,D0  ; PLA
02:0004C020 19400513        	  4987:     move.b  D0,($0513,A4)
02:0004C024 101D            	  4988:     move.b  (A5)+,D0  ; PLA
02:0004C026 194000AC        	  4989:     move.b  D0,($00AC,A4)
                            	  4990:     ; State $21 means that a moving fire was just made.
                            	  4991:     ;
                            	  4992:     ; If it's any another value, then we didn't find an empty slot
                            	  4993:     ; to make a fire. In this case, all that's left to do is to go
                            	  4994:     ; deactivate the shot object.
                            	  4995:     ;
02:0004C02A 41EC00AC        	  4996:     lea     ($00AC,A4),A0
02:0004C02E 10302000        	  4997:     move.b  (A0,D2.W),D0
02:0004C032 0C000021        	  4998:     cmpi.b  #$21,D0
02:0004C036 6702            	  4999:     beq.s  __far_z_07_0077
02:0004C038 6038            	  5000:     jmp  DeactivateLinkShot
                            	  5001: __far_z_07_0077:
                            	  5002:     ; Make state $22 for a standing fire.
                            	  5003:     ;
02:0004C03A 41EC00AC        	  5004:     lea     ($00AC,A4),A0
02:0004C03E 52302000        	  5005:     addq.b  #1,(A0,D2.W)
                            	  5006:     ; Copy the shot's position and direction to the fire.
                            	  5007:     ;
02:0004C042 760E            	  5008:     moveq   #14,D3
02:0004C044 10343070        	  5009:     move.b  ($70,A4,D3.W),D0
02:0004C048 19802070        	  5010:     move.b  D0,($70,A4,D2.W)
02:0004C04C 41EC0084        	  5011:     lea     ($0084,A4),A0
02:0004C050 10303000        	  5012:     move.b  (A0,D3.W),D0
02:0004C054 41EC0084        	  5013:     lea     ($0084,A4),A0
02:0004C058 11802000        	  5014:     move.b  D0,(A0,D2.W)
02:0004C05C 41EC0098        	  5015:     lea     ($0098,A4),A0
02:0004C060 10303000        	  5016:     move.b  (A0,D3.W),D0
02:0004C064 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004C068 11802000        	  5018:     move.b  D0,(A0,D2.W)
                            	  5019:     ; The fire lasts $4F frames.
                            	  5020:     ; Deactivate the shot.
                            	  5021:     ;
02:0004C06C 704F            	  5022:     moveq   #79,D0
02:0004C06E 19802028        	  5023:     move.b  D0,($28,A4,D2.W)
                            	  5024:     even
                            	  5025: DeactivateLinkShot:
02:0004C072 4EF90002BC8E    	  5026:     jmp     c_deactivate_link_shot
                            	  5027: 
                            	  5028: DeactivateShot:
02:0004C078 4EF90002BC7E    	  5029:     jmp     c_deactivate_shot
