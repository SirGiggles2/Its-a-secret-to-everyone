02:0003F4D6 06              	 12958:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003F4D7 08
02:0003F4D8 07
02:0003F4D9 09
02:0003F4DA 00
02:0003F4DB 00
02:0003F4DC 01
02:0003F4DD 01
02:0003F4DE 02              	 12959:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003F4DF 02
