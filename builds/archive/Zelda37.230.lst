02:00030E34 020000F0        	  4523:     andi.b #$F0,D0
02:00030E38 0C000010        	  4524:     cmpi.b  #$10,D0
02:00030E3C 661A            	  4525:     bne  _L_z01_WieldBomb_FoundSlot
                            	  4526:     ; Else look at slot $11.
                            	  4527:     ; If there's a bomb there (major state = $10), then return.
                            	  4528:     ;
02:00030E3E 5202            	  4529:     addq.b  #1,D2
02:00030E40 41EC00AC        	  4530:     lea     ($00AC,A4),A0
02:00030E44 10302000        	  4531:     move.b  (A0,D2.W),D0
02:00030E48 670E            	  4532:     beq  _L_z01_WieldBomb_FoundSlot
02:00030E4A 020000F0        	  4533:     andi.b #$F0,D0
02:00030E4E 0C000010        	  4534:     cmpi.b  #$10,D0
