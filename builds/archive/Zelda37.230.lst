02:0003F4EF 10
02:0003F4F0 00
02:0003F4F1 10
                            	 12965: 
                            	 12966:     even
                            	 12967: GanonSpriteOffsetsY:
02:0003F4F2 00              	 12968:     dc.b    $00, $00, $10, $10
02:0003F4F3 00
02:0003F4F4 10
02:0003F4F5 10
                            	 12969: 
