02:0004384A 102C0006        	  6047:     move.b  ($0006,A4),D0
02:0004384E 19400004        	  6048:     move.b  D0,($0004,A4)
                            	  6049:     ; Write the transfer record header for the door.
                            	  6050:     ;
                            	  6051:     ;
                            	  6052:     ; VRAM address high byte of door
02:00043852 1014            	  6053:     move.b  ($0000,A4),D0
02:00043854 41EC0302        	  6054:     lea     ($0302,A4),A0
02:00043858 11802000        	  6055:     move.b  D0,(A0,D2.W)
02:0004385C 5202            	  6056:     addq.b  #1,D2
02:0004385E 102C0001        	  6057:     move.b  ($0001,A4),D0
02:00043862 41EC0302        	  6058:     lea     ($0302,A4),A0
02:00043866 11802000        	  6059:     move.b  D0,(A0,D2.W)
02:0004386A 5202            	  6060:     addq.b  #1,D2
02:0004386C 102C0006        	  6061:     move.b  ($0006,A4),D0
02:00043870 41EC0302        	  6062:     lea     ($0302,A4),A0
02:00043874 11802000        	  6063:     move.b  D0,(A0,D2.W)
02:00043878 5202            	  6064:     addq.b  #1,D2
                            	  6065: _anon_z05_121:
                            	  6066:     ; Write two tiles in a short loop indexed by [04].
                            	  6067:     ;
02:0004387A 6100ED1C        	  6068:     jsr     WriteDoorFaceTileHorizontally
02:0004387E 66FA            	  6069:     bne  _anon_z05_121
                            	  6070:     ; OR the low VRAM address with $20 to go down one row
                            	  6071:     ; in order to work on the second row of door tiles.
                            	  6072:     ;
02:00043880 7020            	  6073:     moveq   #32,D0
02:00043882 122C0001        	  6074:     move.b  ($0001,A4),D1
02:00043886 8001            	  6075:     or.b  D1,D0
02:00043888 19400001        	  6076:     move.b  D0,($0001,A4)
                            	  6077:     ; Bottom of the loop.
                            	  6078:     ; Loop again to write the second transfer record for the
                            	  6079:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6080:     ;
02:0004388C 532C0005        	  6081:     subq.b  #1,($0005,A4)
02:00043890 66B8            	  6082:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6083:     ; Write the end marker, and update buffer length.
                            	  6084:     ;
