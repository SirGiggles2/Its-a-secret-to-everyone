02:000304D6 41EC0098        	  3092:     lea     ($0098,A4),A0
02:000304DA 10302000        	  3093:     move.b  (A0,D2.W),D0
02:000304DE 1940000F        	  3094:     move.b  D0,($000F,A4)
02:000304E2 4EB90004B9F2    	  3095:     jsr     MoveObject
