                            	  5012: 
                            	  5013: ; Each byte describes an item. The high nibble is the type.
                            	  5014: ; The low nibble is the value. Its meaning depends on the type.
                            	  5015: ;
                            	  5016: ; 0x - individuals
                            	  5017: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5018: ; * bit mask: value doesn't matter.
                            	  5019: ;
                            	  5020: ; 1x - amounts
                            	  5021: ; Value is an amount to add.
                            	  5022: ;
                            	  5023: ; 2x - grades
                            	  5024: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5025: ;
                            	  5026: ; 3x - error?
                            	  5027: ; Produces an item value of $FF.
                            	  5028: ;
                            	  5029:     even
