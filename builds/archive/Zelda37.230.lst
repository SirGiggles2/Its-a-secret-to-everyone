                            	 13038: Ganon_CheckCollisions:
                            	 13039:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13040:     ; Store in [02] and [03].
                            	 13041:     ;
02:0003F576 10342070        	 13042:     move.b  ($70,A4,D2.W),D0
02:0003F57A 023C00EE        	 13043:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F57E 123C0010        	 13044:     move.b  #$10,D1
02:0003F582 D101            	 13045:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F584 19400002        	 13046:     move.b  D0,($0002,A4)
02:0003F588 41EC0084        	 13047:     lea     ($0084,A4),A0
02:0003F58C 10302000        	 13048:     move.b  (A0,D2.W),D0
02:0003F590 023C00EE        	 13049:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F594 123C0010        	 13050:     move.b  #$10,D1
02:0003F598 D101            	 13051:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F59A 19400003        	 13052:     move.b  D0,($0003,A4)
                            	 13053:     ; Check for a collision with Link.
                            	 13054:     ;
                            	 13055:     ; We can't call CheckLinkCollision, because we need to
                            	 13056:     ; customize Ganon's midpoint.
                            	 13057:     ;
                            	 13058:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13059:     ; detection, if Link is invincible. Initialize variables that will
                            	 13060:     ; be returned from the partial collision check routine. Then
                            	 13061:     ; call it.
                            	 13062:     ;
02:0003F59E 102C04F0        	 13063:     move.b  ($04F0,A4),D0
02:0003F5A2 6616            	 13064:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F5A4 19400006        	 13065:     move.b  D0,($0006,A4)
02:0003F5A8 19400009        	 13066:     move.b  D0,($0009,A4)
02:0003F5AC 1940000C        	 13067:     move.b  D0,($000C,A4)
02:0003F5B0 7600            	 13068:     moveq   #0,D3
02:0003F5B2 1883            	 13069:     move.b  D3,($0000,A4)
02:0003F5B4 4EB900031CFC    	 13070:     jsr     CheckLinkCollisionPreinit
                            	 13071:     even
                            	 13072: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13073:     ; If Ganon is not in state 0, then he's brown.
                            	 13074:     ; Go check collision with an arrow.
                            	 13075:     ;
02:0003F5BA 41EC00AC        	 13076:     lea     ($00AC,A4),A0
02:0003F5BE 10302000        	 13077:     move.b  (A0,D2.W),D0
02:0003F5C2 6652            	 13078:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13079:     ; If timer <> 0, then Ganon is visible.
                            	 13080:     ; He can't be harmed like this. So, return.
                            	 13081:     ;
02:0003F5C4 10342028        	 13082:     move.b  ($28,A4,D2.W),D0
02:0003F5C8 664A            	 13083:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F5CA 760D            	 13084:     moveq   #13,D3
02:0003F5CC 4EB9000321C6    	 13085:     jsr     CheckMonsterSwordCollision
                            	 13086:     ; If Ganon has died according to the usual collision check rules
                            	 13087:     ; (HP = 0), then:
                            	 13088:     ; 1. Restore HP to the initial value $F0
                            	 13089:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13090:     ; 3. Change palette row 7 to make Ganon brown
                            	 13091:     ;
02:0003F5D2 41EC0405        	 13092:     lea     ($0405,A4),A0
02:0003F5D6 10302000        	 13093:     move.b  (A0,D2.W),D0
02:0003F5DA 6718            	 13094:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F5DC 103C00F0        	 13095:     move.b  #$F0,D0
02:0003F5E0 41EC0485        	 13096:     lea     ($0485,A4),A0
02:0003F5E4 11802000        	 13097:     move.b  D0,(A0,D2.W)
02:0003F5E8 41EC00AC        	 13098:     lea     ($00AC,A4),A0
02:0003F5EC 53302000        	 13099:     subq.b  #1,(A0,D2.W)
02:0003F5F0 61000084        	 13100:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13101:     even
                            	 13102: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13103:     ; If Ganon was harmed, then play the sound effect
                            	 13104:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13105:     ;
02:0003F5F4 41EC04F0        	 13106:     lea     ($04F0,A4),A0
02:0003F5F8 10302000        	 13107:     move.b  (A0,D2.W),D0
02:0003F5FC 670A            	 13108:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F5FE 6100A246        	 13109:     jsr     PlayBossHitCryIfNeeded
02:0003F602 7040            	 13110:     moveq   #64,D0
02:0003F604 19802028        	 13111:     move.b  D0,($28,A4,D2.W)
                            	 13112:     even
                            	 13113: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13114:     ; Reset metastate, because Ganon cannot die this way.
                            	 13115:     ;
02:0003F608 4EB90004D596    	 13116:     jsr     ResetObjMetastate
                            	 13117:     ; Reset shove info and invincibility timer, because Ganon
                            	 13118:     ; doesn't react at all as a usual monster.
                            	 13119:     ;
02:0003F60E 4EB9000320CE    	 13120:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13121:     even
                            	 13122: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F614 4E75            	 13123:     rts
                            	 13124: 
                            	 13125:     even
                            	 13126: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13127:     ; If the silver arrow is not in the inventory, then return.
                            	 13128:     ;
02:0003F616 102C0659        	 13129:     move.b  ($0659,A4),D0
02:0003F61A 0C000002        	 13130:     cmpi.b  #$02,D0
02:0003F61E 66F4            	 13131:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13132:     ; Reset the collision return value [06].
                            	 13133:     ;
02:0003F620 7000            	 13134:     moveq   #0,D0
02:0003F622 19400006        	 13135:     move.b  D0,($0006,A4)
                            	 13136:     ; If there's no arrow in flight, then return.
                            	 13137:     ;
02:0003F626 7612            	 13138:     moveq   #18,D3
02:0003F628 41EC00AC        	 13139:     lea     ($00AC,A4),A0
02:0003F62C 10303000        	 13140:     move.b  (A0,D3.W),D0
02:0003F630 0C000010        	 13141:     cmpi.b  #$10,D0
02:0003F634 66DE            	 13142:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13143:     ; Check for collision with an arrow; and return if no collision.
                            	 13144:     ;
02:0003F636 4EB900032222    	 13145:     jsr     CheckMonsterArrowOrRodCollision
02:0003F63C 102C0006        	 13146:     move.b  ($0006,A4),D0
02:0003F640 67D2            	 13147:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13148:     ; Set the Ganon phase to "dying".
                            	 13149:     ;
02:0003F642 41EC042C        	 13150:     lea     ($042C,A4),A0
02:0003F646 52302000        	 13151:     addq.b  #1,(A0,D2.W)
                            	 13152:     ; Now his body does flash.
                            	 13153:     ;
02:0003F64A 7028            	 13154:     moveq   #40,D0
02:0003F64C 41EC04F0        	 13155:     lea     ($04F0,A4),A0
02:0003F650 11802000        	 13156:     move.b  D0,(A0,D2.W)
                            	 13157:     ; Set initial cloud distance 8.
                            	 13158:     ;
02:0003F654 7008            	 13159:     moveq   #8,D0
02:0003F656 41EC0478        	 13160:     lea     ($0478,A4),A0
02:0003F65A 11802000        	 13161:     move.b  D0,(A0,D2.W)
02:0003F65E 0A3C0001        	 13162:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F662 4E75            	 13163:     rts
                            	 13164: 
