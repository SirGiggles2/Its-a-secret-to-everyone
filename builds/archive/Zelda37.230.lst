02:00032416 41EC034F        	  7594:     lea     ($034F,A4),A0
02:0003241A 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003241E 0C000012        	  7596:     cmpi.b  #$12,D0
02:00032422 6714            	  7597:     beq  _L_z01_BeginShove_Exit
                            	  7598:     ; Turn the attacker in the opposite direction.
