                            	  3535: _anon_z05_83:
                            	  3536:     ; Look for the current room in the cellar/shortcut room array.
                            	  3537:     ;
02:00041C08 1883            	  3538:     move.b  D3,($0000,A4)
02:00041C0A 163C00FF        	  3539:     move.b  #$FF,D3
02:00041C0E 102C00EB        	  3540:     move.b  ($00EB,A4),D0
                            	  3541: _anon_z05_84:
02:00041C12 5203            	  3542:     addq.b  #1,D3
02:00041C14 41F900FF6BB2    	  3543:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C1A 12303000        	  3544:     move.b  (A0,D3.W),D1
02:00041C1E B001            	  3545:     cmp.b   D1,D0
02:00041C20 66F0            	  3546:     bne  _anon_z05_84
                            	  3547:     ; Add the value of the shortcut chosen to whatever index
                            	  3548:     ; the current room has in the array.
                            	  3549:     ;
                            	  3550:     ; This yields the index of one of the three shortcut rooms
                            	  3551:     ; after the current one.
                            	  3552:     ;
02:00041C22 1003            	  3553:     move.b  D3,D0
02:00041C24 023C00EE        	  3554:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C28 1214            	  3555:     move.b  ($0000,A4),D1
02:00041C2A D101            	  3556:     addx.b  D1,D0   ; ADC $00
                            	  3557:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3558:     ;
02:00041C2C 02000003        	  3559:     andi.b #$03,D0
02:00041C30 7600            	  3560:     moveq   #0,D3
02:00041C32 1600            	  3561:     move.b  D0,D3
02:00041C34 41F900FF6BB2    	  3562:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C3A 10303000        	  3563:     move.b  (A0,D3.W),D0
                            	  3564: ; Params:
                            	  3565: ; A: destination room ID
                            	  3566: ;
                            	  3567:     even
