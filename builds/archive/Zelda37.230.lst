02:00043964 2044            	  6188:     movea.l D4,A0
02:00043966 11803000        	  6189:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6190: _anon_z05_124:
                            	  6191:     ; Add the door to the opened door mask, reset door command,
                            	  6192:     ; and lay out doors.
                            	  6193:     ;
02:0004396A 102C0055        	  6194:     move.b  ($0055,A4),D0
02:0004396E 122C00EE        	  6195:     move.b  ($00EE,A4),D1
02:00043972 8001            	  6196:     or.b  D1,D0
