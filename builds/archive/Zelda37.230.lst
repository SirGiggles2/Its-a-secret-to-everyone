                            	 12383: _anon_z04_159:
02:0003F0E2 61000E00        	 12384:     jsr     DecreaseObjectAngle
                            	 12385:     ; Load Patra's maneuver index.
                            	 12386:     ; It determines which counts of bits are looked up below.
                            	 12387:     ;
