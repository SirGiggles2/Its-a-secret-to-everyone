02:0004AE20 0C000046        	  2399:     cmpi.b  #$46,D0
02:0004AE24 6530            	  2400:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004AE26 0C0000F3        	  2401:     cmpi.b  #$F3,D0
02:0004AE2A 642A            	  2402:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004AE2C 023C00EE        	  2403:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AE30 123C0002        	  2404:     move.b  #$02,D1
02:0004AE34 D101            	  2405:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004AE36 41EC030A        	  2406:     lea     ($030A,A4),A0
02:0004AE3A 11802000        	  2407:     move.b  D0,(A0,D2.W)
02:0004AE3E 41EC030B        	  2408:     lea     ($030B,A4),A0
02:0004AE42 11802000        	  2409:     move.b  D0,(A0,D2.W)
02:0004AE46 41EC0306        	  2410:     lea     ($0306,A4),A0
02:0004AE4A 52302000        	  2411:     addq.b  #1,(A0,D2.W)
02:0004AE4E 41EC030B        	  2412:     lea     ($030B,A4),A0
