                            	  5617: 
                            	  5618: ; Params:
                            	  5619: ; [02]: Y
                            	  5620: ; [03]: X
                            	  5621: ;
                            	  5622: ; Returns:
                            	  5623: ; [00]: high byte of PPU address
                            	  5624: ; [01]: low byte of PPU address
                            	  5625: ;
                            	  5626: ;
                            	  5627: ; Turn the 16-bit value 08YY into the PPU address
                            	  5628: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5629: ;
                            	  5630: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5631: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5632: ;
                            	  5633:     even
