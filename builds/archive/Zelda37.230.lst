02:00032424 41EC0098        	  7600:     lea     ($0098,A4),A0
02:00032428 10302000        	  7601:     move.b  (A0,D2.W),D0
02:0003242C 6100E87E        	  7602:     jsr     GetOppositeDir
02:00032430 41EC0098        	  7603:     lea     ($0098,A4),A0
