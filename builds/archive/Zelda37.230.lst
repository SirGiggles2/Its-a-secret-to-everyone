                            	  7939: UpdatePolsVoiceState1_Jumping:
                            	  7940:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7941:     ;
02:0003CFAA 41EC0444        	  7942:     lea     ($0444,A4),A0
02:0003CFAE 10302000        	  7943:     move.b  (A0,D2.W),D0
02:0003CFB2 023C00EE        	  7944:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFB6 123C0038        	  7945:     move.b  #$38,D1
02:0003CFBA D101            	  7946:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFBC 41EC0444        	  7947:     lea     ($0444,A4),A0
02:0003CFC0 11802000        	  7948:     move.b  D0,(A0,D2.W)
                            	  7949:     ; Add Carry to high speed byte (vertical).
                            	  7950:     ;
02:0003CFC4 41EC0412        	  7951:     lea     ($0412,A4),A0
02:0003CFC8 10302000        	  7952:     move.b  (A0,D2.W),D0
02:0003CFCC 123C0000        	  7953:     move.b  #$00,D1
02:0003CFD0 D101            	  7954:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFD2 41EC0412        	  7955:     lea     ($0412,A4),A0
02:0003CFD6 11802000        	  7956:     move.b  D0,(A0,D2.W)
                            	  7957:     ; Add high speed byte to Y coordinate.
                            	  7958:     ;
02:0003CFDA 023C00EE        	  7959:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFDE 41EC0084        	  7960:     lea     ($0084,A4),A0
02:0003CFE2 12302000        	  7961:     move.b  (A0,D2.W),D1
02:0003CFE6 D101            	  7962:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CFE8 41EC0084        	  7963:     lea     ($0084,A4),A0
02:0003CFEC 11802000        	  7964:     move.b  D0,(A0,D2.W)
                            	  7965:     ; If the speed is still negative, then return.
                            	  7966:     ;
02:0003CFF0 41EC0412        	  7967:     lea     ($0412,A4),A0
02:0003CFF4 10302000        	  7968:     move.b  (A0,D2.W),D0
02:0003CFF8 6B0000AC        	  7969:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7970:     ; If Y coordinate still < target Y, then return.
                            	  7971:     ;
02:0003CFFC 41EC0084        	  7972:     lea     ($0084,A4),A0
02:0003D000 10302000        	  7973:     move.b  (A0,D2.W),D0
02:0003D004 41EC042C        	  7974:     lea     ($042C,A4),A0
02:0003D008 12302000        	  7975:     move.b  (A0,D2.W),D1
02:0003D00C B001            	  7976:     cmp.b   D1,D0
02:0003D00E 65000096        	  7977:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7978:     ; Else reached the destination. Go to state 0.
                            	  7979:     ;
02:0003D012 7000            	  7980:     moveq   #0,D0
02:0003D014 41EC00AC        	  7981:     lea     ($00AC,A4),A0
02:0003D018 11802000        	  7982:     move.b  D0,(A0,D2.W)
                            	  7983:     ; Reset 16-bit vertical speed.
                            	  7984:     ;
02:0003D01C 41EC0444        	  7985:     lea     ($0444,A4),A0
02:0003D020 11802000        	  7986:     move.b  D0,(A0,D2.W)
02:0003D024 41EC0412        	  7987:     lea     ($0412,A4),A0
02:0003D028 11802000        	  7988:     move.b  D0,(A0,D2.W)
                            	  7989:     ; Choose a random direction to face in.
                            	  7990:     ;
02:0003D02C 10342018        	  7991:     move.b  ($18,A4,D2.W),D0
02:0003D030 02000003        	  7992:     andi.b #$03,D0
02:0003D034 7600            	  7993:     moveq   #0,D3
02:0003D036 1600            	  7994:     move.b  D0,D3
02:0003D038 41F90003CE48    	  7995:     lea     (PolsVoiceDirections).l,A0
02:0003D03E 10303000        	  7996:     move.b  (A0,D3.W),D0
02:0003D042 41EC0098        	  7997:     lea     ($0098,A4),A0
02:0003D046 11802000        	  7998:     move.b  D0,(A0,D2.W)
                            	  7999:     ; Randomly set distance-to-move to $30 or $70.
                            	  8000:     ;
02:0003D04A 10342018        	  8001:     move.b  ($18,A4,D2.W),D0
02:0003D04E 02000040        	  8002:     andi.b #$40,D0
02:0003D052 123C0030        	  8003:     move.b  #$30,D1
02:0003D056 D101            	  8004:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D058 41EC0394        	  8005:     lea     ($0394,A4),A0
02:0003D05C 11802000        	  8006:     move.b  D0,(A0,D2.W)
                            	  8007:     ; Align the monster with a square horizontally.
                            	  8008:     ;
                            	  8009:     ; If in the left half of a square, align with that square.
                            	  8010:     ; If in the right half, align with the next square.
                            	  8011:     ;
02:0003D060 10342070        	  8012:     move.b  ($70,A4,D2.W),D0
02:0003D064 023C00EE        	  8013:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D068 123C0008        	  8014:     move.b  #$08,D1
02:0003D06C D101            	  8015:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D06E 020000F0        	  8016:     andi.b #$F0,D0
02:0003D072 19802070        	  8017:     move.b  D0,($70,A4,D2.W)
                            	  8018:     ; Align the monster with a square vertically.
                            	  8019:     ;
                            	  8020:     ; If in the top half of a square, align with that square.
                            	  8021:     ; If in the bottom half, align with the next square.
                            	  8022:     ;
02:0003D076 41EC0084        	  8023:     lea     ($0084,A4),A0
02:0003D07A 10302000        	  8024:     move.b  (A0,D2.W),D0
02:0003D07E 023C00EE        	  8025:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D082 123C0008        	  8026:     move.b  #$08,D1
02:0003D086 D101            	  8027:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D088 020000F0        	  8028:     andi.b #$F0,D0
                            	  8029:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8030:     ;
02:0003D08C 003C0011        	  8031:     ori     #$11,CCR  ; SEC: set C+X
02:0003D090 123C0003        	  8032:     move.b  #$03,D1
02:0003D094 0A3C0010        	  8033:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D098 9101            	  8034:     subx.b  D1,D0   ; SBC #$03
02:0003D09A 0A3C0010        	  8035:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D09E 41EC0084        	  8036:     lea     ($0084,A4),A0
02:0003D0A2 11802000        	  8037:     move.b  D0,(A0,D2.W)
                            	  8038:     even
