02:0004D222 7600            	  7408:     moveq   #0,D3
02:0004D224 162C0525        	  7409:     move.b  ($0525,A4),D3
02:0004D228 E84B            	  7410:     lsr.w   #4,D3
02:0004D22A 5943            	  7411:     subi.w  #4,D3
