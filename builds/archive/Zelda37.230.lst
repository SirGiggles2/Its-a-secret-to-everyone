                            	  7791: _L_z04_UpdatePolsVoice_State0:
                            	  7792:     ; State 0. Walking.
                            	  7793:     ;
                            	  7794:     ; If grid offset = 0, then no more distance to cover.
                            	  7795:     ; So, go change to state 1 -- jumping.
                            	  7796:     ;
02:0003CE7E 41EC0394        	  7797:     lea     ($0394,A4),A0
02:0003CE82 10302000        	  7798:     move.b  (A0,D2.W),D0
02:0003CE86 67000084        	  7799:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7800:     ; Decrement grid offset / distance remaining.
                            	  7801:     ;
02:0003CE8A 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003CE8E 53302000        	  7803:     subq.b  #1,(A0,D2.W)
                            	  7804:     ; Move vertically.
                            	  7805:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7806:     ;
