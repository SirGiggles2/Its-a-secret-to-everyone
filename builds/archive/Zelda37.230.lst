02:00031E0C 10303000        	  6587:     move.b  (A0,D3.W),D0
02:00031E10 1B00            	  6588:     move.b  D0,-(A5)  ; PHA
02:00031E12 0200000F        	  6589:     andi.b #$0F,D0
02:00031E16 1940000D        	  6590:     move.b  D0,($000D,A4)
02:00031E1A 101D            	  6591:     move.b  (A5)+,D0  ; PLA
02:00031E1C 020000F0        	  6592:     andi.b #$F0,D0
02:00031E20 1940000E        	  6593:     move.b  D0,($000E,A4)
                            	  6594: ; Params:
                            	  6595: ; X: object index of the attacker
                            	  6596: ; [0D]: damage points high byte
                            	  6597: ; [0E]: damage points low byte
