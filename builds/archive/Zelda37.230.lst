                            	 12460: 
                            	 12461: ; Description:
                            	 12462: ; Lift up the Triforce of Courage while the room is dark.
                            	 12463: ;
                            	 12464: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12465: ;
                            	 12466:     even
                            	 12467: Ganon_ScenePhase0:
02:0003F180 701B            	 12468:     moveq   #27,D0
02:0003F182 19400505        	 12469:     move.b  D0,($0505,A4)
                            	 12470:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12471:     ;
