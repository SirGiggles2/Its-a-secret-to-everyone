                            	  3759: InitArmosOrFlyingGhini:
                            	  3760:     ; In UpdateObject, this object was flagged "initialized".
                            	  3761:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3762:     ;
02:0003B194 10342028        	  3763:     move.b  ($28,A4,D2.W),D0
02:0003B198 41EC0492        	  3764:     lea     ($0492,A4),A0
02:0003B19C 11802000        	  3765:     move.b  D0,(A0,D2.W)
                            	  3766:     ; If it's still fading in, then go finish some initialization needed
                            	  3767:     ; for fading in.
                            	  3768:     ;
02:0003B1A0 660000B6        	  3769:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3770:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3771:     ; go finish initializing it.
                            	  3772:     ;
02:0003B1A4 41EC034F        	  3773:     lea     ($034F,A4),A0
02:0003B1A8 10302000        	  3774:     move.b  (A0,D2.W),D0
02:0003B1AC 0C000022        	  3775:     cmpi.b  #$22,D0
02:0003B1B0 670000A6        	  3776:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3777:     ; Else we have an armos.
                            	  3778:     ;
                            	  3779:     ; Store stairs tile $70 in [00] for use later.
                            	  3780:     ;
02:0003B1B4 7070            	  3781:     moveq   #112,D0
02:0003B1B6 1880            	  3782:     move.b  D0,($0000,A4)
                            	  3783:     ; Look for the current room ID in an array of room ID's that
                            	  3784:     ; have armos secrets.
                            	  3785:     ;
02:0003B1B8 7606            	  3786:     moveq   #6,D3
                            	  3787:     even
                            	  3788: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B1BA 102C00EB        	  3789:     move.b  ($00EB,A4),D0
                            	  3790:     ; If this element does not match the current room ID, go loop again.
                            	  3791:     ;
02:0003B1BE 41F90003B184    	  3792:     lea     (SecretArmosRoomIds).l,A0
02:0003B1C4 12303000        	  3793:     move.b  (A0,D3.W),D1
02:0003B1C8 B001            	  3794:     cmp.b   D1,D0
02:0003B1CA 6648            	  3795:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3796:     ; The secret (usually stairs) is under one of the armoses.
                            	  3797:     ;
                            	  3798:     ; If the armos's X coordinate does not match the one needed
                            	  3799:     ; for the current room in the list, then go loop again.
                            	  3800:     ;
02:0003B1CC 10342070        	  3801:     move.b  ($70,A4,D2.W),D0
02:0003B1D0 41F90003B18C    	  3802:     lea     (SecretArmosXs).l,A0
02:0003B1D6 12303000        	  3803:     move.b  (A0,D3.W),D1
02:0003B1DA B001            	  3804:     cmp.b   D1,D0
02:0003B1DC 6636            	  3805:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3806:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3807:     ;
02:0003B1DE 41EC0084        	  3808:     lea     ($0084,A4),A0
02:0003B1E2 10302000        	  3809:     move.b  (A0,D2.W),D0
02:0003B1E6 0C000080        	  3810:     cmpi.b  #$80,D0
02:0003B1EA 6628            	  3811:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3812:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3813:     ;
02:0003B1EC 4A03            	  3814:     cmpi.b  #$00,D3
02:0003B1EE 662C            	  3815:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3816:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3817:     ; has the power bracelet.
                            	  3818:     ;
                            	  3819:     ; Set up the room item with the armos's coordinates.
                            	  3820:     ;
02:0003B1F0 19400097        	  3821:     move.b  D0,($0097,A4)
02:0003B1F4 10342070        	  3822:     move.b  ($70,A4,D2.W),D0
02:0003B1F8 19400083        	  3823:     move.b  D0,($0083,A4)
                            	  3824:     ; This resets the room item's state, which activates it.
                            	  3825:     ;
02:0003B1FC 194300BF        	  3826:     move.b  D3,($00BF,A4)
                            	  3827:     ; Set the room item ID.
                            	  3828:     ;
02:0003B200 7014            	  3829:     moveq   #20,D0
02:0003B202 194000AB        	  3830:     move.b  D0,($00AB,A4)
                            	  3831:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3832:     ;
                            	  3833:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3834:     ;
                            	  3835:     ; Note that, if the item was already taken, then the room item
                            	  3836:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3837:     ; it will be ignored, because that routine checks whether
                            	  3838:     ; the item was taken.
                            	  3839:     ;
02:0003B206 4EB9000311A8    	  3840:     jsr     GetRoomFlagUWItemState
02:0003B20C 660A            	  3841:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B20E 610006B2        	  3842:     jsr     PlaySecretFoundTune
02:0003B212 6604            	  3843:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3844:     even
                            	  3845: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3846:     ; Bottom of the loop.
                            	  3847:     ;
02:0003B214 5303            	  3848:     subq.b  #1,D3
02:0003B216 6AA2            	  3849:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3850:     even
                            	  3851: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3852:     ; Not found, or found the power bracelet.
                            	  3853:     ; Use a floor tile $26 to replace the armos.
                            	  3854:     ;
02:0003B218 7026            	  3855:     moveq   #38,D0
02:0003B21A 1880            	  3856:     move.b  D0,($0000,A4)
                            	  3857:     even
                            	  3858: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B21C 1014            	  3859:     move.b  ($0000,A4),D0
                            	  3860:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3861:     ;
02:0003B21E 1B00            	  3862:     move.b  D0,-(A5)  ; PHA
02:0003B220 0C000070        	  3863:     cmpi.b  #$70,D0
02:0003B224 6604            	  3864:     bne  _anon_z04_51
02:0003B226 6100069A        	  3865:     jsr     PlaySecretFoundTune
                            	  3866: _anon_z04_51:
                            	  3867:     ; Replace the tile where the armos was.
                            	  3868:     ;
02:0003B22A 522C00F7        	  3869:     addq.b  #1,($00F7,A4)
02:0003B22E 101D            	  3870:     move.b  (A5)+,D0  ; PLA
02:0003B230 4EB90004ADA6    	  3871:     jsr     ChangeTileObjTiles
                            	  3872:     ; Because the armos object is aligned to the square grid
                            	  3873:     ; (because it was made from a square),
                            	  3874:     ; set its grid offset to 3 to compensate.
                            	  3875:     ;
                            	  3876:     ; Most objects are aligned to the grid vertically when the
                            	  3877:     ; low nibble is $D.
                            	  3878:     ;
02:0003B236 7003            	  3879:     moveq   #3,D0
02:0003B238 41EC0394        	  3880:     lea     ($0394,A4),A0
02:0003B23C 11802000        	  3881:     move.b  D0,(A0,D2.W)
                            	  3882:     ; Set a speed (q-speed fraction) randomly:
                            	  3883:     ; $20 if random value < $80
                            	  3884:     ; $60 otherwise
                            	  3885:     ;
02:0003B240 7020            	  3886:     moveq   #32,D0
02:0003B242 7600            	  3887:     moveq   #0,D3
02:0003B244 16342019        	  3888:     move.b  ($19,A4,D2.W),D3
02:0003B248 0C030080        	  3889:     cmpi.b  #$80,D3
02:0003B24C 6502            	  3890:     bcs  _anon_z04_52
02:0003B24E 7060            	  3891:     moveq   #96,D0
                            	  3892: _anon_z04_52:
02:0003B250 41EC03BC        	  3893:     lea     ($03BC,A4),A0
02:0003B254 11802000        	  3894:     move.b  D0,(A0,D2.W)
                            	  3895:     even
                            	  3896: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3897:     ; Facing and input directions down.
                            	  3898:     ;
02:0003B258 7004            	  3899:     moveq   #4,D0
02:0003B25A 41EC03F8        	  3900:     lea     ($03F8,A4),A0
02:0003B25E 11802000        	  3901:     move.b  D0,(A0,D2.W)
02:0003B262 41EC0098        	  3902:     lea     ($0098,A4),A0
02:0003B266 11802000        	  3903:     move.b  D0,(A0,D2.W)
                            	  3904:     ; Every other frame, return without drawing.
                            	  3905:     ;
02:0003B26A 10342028        	  3906:     move.b  ($28,A4,D2.W),D0
02:0003B26E E208            	  3907:     lsr.b  #1,D0   ; LSR A
02:0003B270 6512            	  3908:     bcs  _anon_z04_53
                            	  3909:     ; Finish initializing based on type.
                            	  3910:     ;
02:0003B272 41EC034F        	  3911:     lea     ($034F,A4),A0
02:0003B276 10302000        	  3912:     move.b  (A0,D2.W),D0
02:0003B27A 0C000022        	  3913:     cmpi.b  #$22,D0
02:0003B27E 6602            	  3914:     bne.s  __far_z_04_0032
02:0003B280 6008            	  3915:     jmp  L_EndInitFlyingGhini
                            	  3916: __far_z_04_0032:
02:0003B282 6158            	  3917:     jsr     DrawArmosAndCheckCollisions
                            	  3918: _anon_z04_53:
02:0003B284 0A3C0001        	  3919:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B288 4E75            	  3920:     rts
