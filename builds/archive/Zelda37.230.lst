02:0003C5A6 122C0002        	  6524:     move.b  ($0002,A4),D1
02:0003C5AA E309            	  6525:     lsl.b  #1,D1   ; ASL $02
02:0003C5AC 19410002        	  6526:     move.b  D1,($0002,A4)
02:0003C5B0 122C0002        	  6527:     move.b  ($0002,A4),D1
02:0003C5B4 C200            	  6528:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5B6 671E            	  6529:     beq  _L_z04_Digdogger_Move_End
02:0003C5B8 41EC0084        	  6530:     lea     ($0084,A4),A0
02:0003C5BC 10302000        	  6531:     move.b  (A0,D2.W),D0
02:0003C5C0 122C0003        	  6532:     move.b  ($0003,A4),D1
02:0003C5C4 0A3C0010        	  6533:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5C8 9101            	  6534:     subx.b  D1,D0   ; SBC $03
02:0003C5CA 0A3C0010        	  6535:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5CE 41EC0084        	  6536:     lea     ($0084,A4),A0
02:0003C5D2 11802000        	  6537:     move.b  D0,(A0,D2.W)
                            	  6538:     even
