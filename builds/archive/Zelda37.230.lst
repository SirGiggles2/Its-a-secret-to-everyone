                            	  4050: PondFairy_HandleOtherStates:
02:0003B366 0C000001        	  4051:     cmpi.b  #$01,D0
02:0003B36A 6610            	  4052:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4053:     ; State 1. Flying and filling hearts.
                            	  4054:     ;
                            	  4055:     ; If still filling hearts, then go draw Link and hearts.
                            	  4056:     ;
02:0003B36C 102C0063        	  4057:     move.b  ($0063,A4),D0
02:0003B370 6620            	  4058:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4059:     ; If not filling hearts anymore, then go to state 2,
                            	  4060:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4061:     ; a little while after we finish filling hearts.
                            	  4062:     ;
02:0003B372 522C00AD        	  4063:     addq.b  #1,($00AD,A4)
02:0003B376 7050            	  4064:     moveq   #80,D0
02:0003B378 19400029        	  4065:     move.b  D0,($0029,A4)
                            	  4066:     even
                            	  4067: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4068:     ; If state <> 2 (so, it's 3), then return.
                            	  4069:     ;
                            	  4070:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4071:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4072:     ; was set to, and we'll return.
                            	  4073:     ;
02:0003B37C 0C000002        	  4074:     cmpi.b  #$02,D0
02:0003B380 6634            	  4075:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4076:     ; State = 2.
                            	  4077:     ;
                            	  4078:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4079:     ;
02:0003B382 102C0029        	  4080:     move.b  ($0029,A4),D0
02:0003B386 660A            	  4081:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4082:     ; Else go to state 3, and unhalt Link.
                            	  4083:     ;
