                            	  9604: Manhandla_Move:
                            	  9605:     ; Implement a way of manifesting the fractional part of the speed
                            	  9606:     ; in the movement.
                            	  9607:     ;
                            	  9608:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9609:     ; byte to add to the coordinates, then the effective speed would
                            	  9610:     ; be 1 pixel a frame instead of 1.25.
                            	  9611:     ;
                            	  9612:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9613:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9614:     ;
                            	  9615:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9616:     ;
                            	  9617:     ;   SA := SA + (SL AND $E0)
                            	  9618:     ;   [03] := SH + carry
                            	  9619:     ;
                            	  9620:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9621:     ;
02:0003DC32 41EC041F        	  9622:     lea     ($041F,A4),A0
02:0003DC36 10302000        	  9623:     move.b  (A0,D2.W),D0
02:0003DC3A 020000E0        	  9624:     andi.b #$E0,D0
02:0003DC3E 023C00EE        	  9625:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC42 41EC0412        	  9626:     lea     ($0412,A4),A0
02:0003DC46 12302000        	  9627:     move.b  (A0,D2.W),D1
02:0003DC4A D101            	  9628:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC4C 41EC0412        	  9629:     lea     ($0412,A4),A0
02:0003DC50 11802000        	  9630:     move.b  D0,(A0,D2.W)
                            	  9631:     ; Assign (high speed byte + carry) to [03].
                            	  9632:     ;
02:0003DC54 41EC042C        	  9633:     lea     ($042C,A4),A0
02:0003DC58 10302000        	  9634:     move.b  (A0,D2.W),D0
02:0003DC5C 123C0000        	  9635:     move.b  #$00,D1
02:0003DC60 D101            	  9636:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DC62 19400003        	  9637:     move.b  D0,($0003,A4)
                            	  9638:     ; Change coordinates by the speed amount/offset in [03]
                            	  9639:     ; according to the direction.
                            	  9640:     ;
                            	  9641:     ; Start with a mask of $A1 in [02]:
                            	  9642:     ; - low nibble represents the right direction
                            	  9643:     ; - high nibble is used to set or clear carry as we go along
                            	  9644:     ;
02:0003DC66 103C00A1        	  9645:     move.b  #$A1,D0
02:0003DC6A 19400002        	  9646:     move.b  D0,($0002,A4)
                            	  9647:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9648:     ;
02:0003DC6E 41EC0098        	  9649:     lea     ($0098,A4),A0
02:0003DC72 10302000        	  9650:     move.b  (A0,D2.W),D0
02:0003DC76 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003DC7A C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DC7C 6712            	  9653:     beq  _L_z04_Manhandla_Move_Left
02:0003DC7E 10342070        	  9654:     move.b  ($70,A4,D2.W),D0
02:0003DC82 023C00EE        	  9655:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC86 122C0003        	  9656:     move.b  ($0003,A4),D1
02:0003DC8A D101            	  9657:     addx.b  D1,D0   ; ADC $03
02:0003DC8C 19802070        	  9658:     move.b  D0,($70,A4,D2.W)
                            	  9659:     even
                            	  9660: _L_z04_Manhandla_Move_Left:
                            	  9661:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9662:     ;
02:0003DC90 41EC0098        	  9663:     lea     ($0098,A4),A0
02:0003DC94 10302000        	  9664:     move.b  (A0,D2.W),D0
02:0003DC98 122C0002        	  9665:     move.b  ($0002,A4),D1
02:0003DC9C E309            	  9666:     lsl.b  #1,D1   ; ASL $02
02:0003DC9E 19410002        	  9667:     move.b  D1,($0002,A4)
02:0003DCA2 122C0002        	  9668:     move.b  ($0002,A4),D1
02:0003DCA6 C200            	  9669:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCA8 6716            	  9670:     beq  _L_z04_Manhandla_Move_Down
02:0003DCAA 10342070        	  9671:     move.b  ($70,A4,D2.W),D0
02:0003DCAE 122C0003        	  9672:     move.b  ($0003,A4),D1
02:0003DCB2 0A3C0010        	  9673:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DCB6 9101            	  9674:     subx.b  D1,D0   ; SBC $03
02:0003DCB8 0A3C0010        	  9675:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DCBC 19802070        	  9676:     move.b  D0,($70,A4,D2.W)
                            	  9677:     even
                            	  9678: _L_z04_Manhandla_Move_Down:
                            	  9679:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9680:     ;
02:0003DCC0 41EC0098        	  9681:     lea     ($0098,A4),A0
02:0003DCC4 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003DCC8 122C0002        	  9683:     move.b  ($0002,A4),D1
02:0003DCCC E309            	  9684:     lsl.b  #1,D1   ; ASL $02
02:0003DCCE 19410002        	  9685:     move.b  D1,($0002,A4)
02:0003DCD2 122C0002        	  9686:     move.b  ($0002,A4),D1
02:0003DCD6 C200            	  9687:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCD8 6716            	  9688:     beq  _L_z04_Manhandla_Move_Up
02:0003DCDA 41EC0084        	  9689:     lea     ($0084,A4),A0
02:0003DCDE 10302000        	  9690:     move.b  (A0,D2.W),D0
02:0003DCE2 122C0003        	  9691:     move.b  ($0003,A4),D1
02:0003DCE6 D101            	  9692:     addx.b  D1,D0   ; ADC $03
02:0003DCE8 41EC0084        	  9693:     lea     ($0084,A4),A0
02:0003DCEC 11802000        	  9694:     move.b  D0,(A0,D2.W)
                            	  9695:     even
                            	  9696: _L_z04_Manhandla_Move_Up:
                            	  9697:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9698:     ;
02:0003DCF0 41EC0098        	  9699:     lea     ($0098,A4),A0
02:0003DCF4 10302000        	  9700:     move.b  (A0,D2.W),D0
02:0003DCF8 122C0002        	  9701:     move.b  ($0002,A4),D1
02:0003DCFC E309            	  9702:     lsl.b  #1,D1   ; ASL $02
02:0003DCFE 19410002        	  9703:     move.b  D1,($0002,A4)
02:0003DD02 122C0002        	  9704:     move.b  ($0002,A4),D1
02:0003DD06 C200            	  9705:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD08 671E            	  9706:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD0A 41EC0084        	  9707:     lea     ($0084,A4),A0
02:0003DD0E 10302000        	  9708:     move.b  (A0,D2.W),D0
02:0003DD12 122C0003        	  9709:     move.b  ($0003,A4),D1
02:0003DD16 0A3C0010        	  9710:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD1A 9101            	  9711:     subx.b  D1,D0   ; SBC $03
02:0003DD1C 0A3C0010        	  9712:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD20 41EC0084        	  9713:     lea     ($0084,A4),A0
02:0003DD24 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9717:     ; To the frame accumulator, add:
                            	  9718:     ; - a random value between 0 and 3
                            	  9719:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9720:     ;
02:0003DD28 10342019        	  9721:     move.b  ($19,A4,D2.W),D0
02:0003DD2C 02000003        	  9722:     andi.b #$03,D0
02:0003DD30 023C00EE        	  9723:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD34 122C0003        	  9724:     move.b  ($0003,A4),D1
02:0003DD38 D101            	  9725:     addx.b  D1,D0   ; ADC $03
02:0003DD3A 41EC0451        	  9726:     lea     ($0451,A4),A0
02:0003DD3E 12302000        	  9727:     move.b  (A0,D2.W),D1
02:0003DD42 D101            	  9728:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DD44 41EC0451        	  9729:     lea     ($0451,A4),A0
02:0003DD48 11802000        	  9730:     move.b  D0,(A0,D2.W)
02:0003DD4C 61001E0A        	  9731:     jsr     BoundFlyer
                            	  9732:     ; TODO:
