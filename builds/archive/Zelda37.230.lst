02:0004BFB4 1940000C        	  4914:     move.b  D0,($000C,A4)
                            	  4915:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4916:     ;
02:0004BFB8 0C030002        	  4917:     cmpi.b  #$02,D3
02:0004BFBC 6604            	  4918:     bne  _anon_z07_24
02:0004BFBE 522C000F        	  4919:     addq.b  #1,($000F,A4)
                            	  4920: _anon_z07_24:
                            	  4921:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4922:     ;   $57 (sword shot) => $22
                            	  4923:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4924:     ;
02:0004BFC2 7622            	  4925:     moveq   #34,D3
02:0004BFC4 0C02000D        	  4926:     cmpi.b  #$0D,D2
02:0004BFC8 6410            	  4927:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BFCA 41EC034F        	  4928:     lea     ($034F,A4),A0
02:0004BFCE 10302000        	  4929:     move.b  (A0,D2.W),D0
02:0004BFD2 0C000057        	  4930:     cmpi.b  #$57,D0
02:0004BFD6 6710            	  4931:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004BFD8 660C            	  4932:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4933:     even
                            	  4934: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4935:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4936:     ;   high bit set (magic)   => $23
                            	  4937:     ;   high bit clear (sword) => $22
                            	  4938:     ;
02:0004BFDA 41EC00AC        	  4939:     lea     ($00AC,A4),A0
02:0004BFDE 10302000        	  4940:     move.b  (A0,D2.W),D0
02:0004BFE2 E308            	  4941:     lsl.b  #1,D0   ; ASL A
02:0004BFE4 6402            	  4942:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4943:     even
                            	  4944: _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites:
