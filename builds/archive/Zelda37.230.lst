02:00032372 660000C4        	  7476:     bne  _L_z01_BeginShove_Exit
                            	  7477: _anon_z01_99:
                            	  7478:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7479:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7480:     ;
                            	  7481:     ; If instead a monster is defending, then all this calculation
                            	  7482:     ; won't matter, because the shove direction will be set to the
                            	  7483:     ; weapon's direction.
                            	  7484:     ;
                            	  7485:     ; As such, calculate a direction from the monster to the defender,
                            	  7486:     ; assuming it's Link.
                            	  7487:     ;
                            	  7488:     ; Start with an assumption that the direction is vertical:
                            	  7489:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7490:     ;
02:00032376 7008            	  7491:     moveq   #8,D0
02:00032378 19400008        	  7492:     move.b  D0,($0008,A4)
02:0003237C 41EC0084        	  7493:     lea     ($0084,A4),A0
02:00032380 10302000        	  7494:     move.b  (A0,D2.W),D0
02:00032384 19400004        	  7495:     move.b  D0,($0004,A4)
02:00032388 41EC0084        	  7496:     lea     ($0084,A4),A0
02:0003238C 10303000        	  7497:     move.b  (A0,D3.W),D0
02:00032390 19400005        	  7498:     move.b  D0,($0005,A4)
                            	  7499:     ; If the defender is Link and his grid offset <> 0 then
                            	  7500:     ; use his usual object direction variable to determine
                            	  7501:     ; which axis to check.
                            	  7502:     ;
02:00032394 4A03            	  7503:     cmpi.b  #$00,D3
02:00032396 6612            	  7504:     bne  _anon_z01_100
02:00032398 102C0394        	  7505:     move.b  ($0394,A4),D0
02:0003239C 670C            	  7506:     beq  _anon_z01_100
02:0003239E 102C0098        	  7507:     move.b  ($0098,A4),D0
02:000323A2 02000003        	  7508:     andi.b #$03,D0
02:000323A6 660C            	  7509:     bne  _L_z01_BeginShove_CheckHorizontal
02:000323A8 6720            	  7510:     beq  _L_z01_BeginShove_CheckVertical
                            	  7511: _anon_z01_100:
                            	  7512:     ; For monsters defending, or Link with grid offset = 0,
                            	  7513:     ; check direction in [0B].
                            	  7514:     ;
                            	  7515:     ; For monsters defending, this won't matter. For Link with grid
                            	  7516:     ; offset = 0, I believe the result will be arbitrary.
                            	  7517:     ;
                            	  7518:     ; TODO:
                            	  7519:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7520:     ; It doesn't seem to be if candle fire attacks him.
                            	  7521:     ;
02:000323AA 102C000B        	  7522:     move.b  ($000B,A4),D0
02:000323AE 0C000004        	  7523:     cmpi.b  #$04,D0
02:000323B2 6416            	  7524:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7525:     even
                            	  7526: _L_z01_BeginShove_CheckHorizontal:
                            	  7527:     ; If the direction checked is left or right,
                            	  7528:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7529:     ;
02:000323B4 7002            	  7530:     moveq   #2,D0
02:000323B6 19400008        	  7531:     move.b  D0,($0008,A4)
02:000323BA 10342070        	  7532:     move.b  ($70,A4,D2.W),D0
02:000323BE 19400004        	  7533:     move.b  D0,($0004,A4)
02:000323C2 10343070        	  7534:     move.b  ($70,A4,D3.W),D0
02:000323C6 19400005        	  7535:     move.b  D0,($0005,A4)
                            	  7536:     even
                            	  7537: _L_z01_BeginShove_CheckVertical:
                            	  7538:     ; If the monster is down or right of the other object,
                            	  7539:     ; then use the opposite direction already in [08].
                            	  7540:     ; Else shift [08] right to turn it into the opposite
                            	  7541:     ; direction up or down.
                            	  7542:     ;
                            	  7543:     ; Again assuming Link is the defender; after this, [08] points
                            	  7544:     ; Link away from the monster.
                            	  7545:     ;
02:000323CA 102C0004        	  7546:     move.b  ($0004,A4),D0
02:000323CE 122C0005        	  7547:     move.b  ($0005,A4),D1
02:000323D2 B001            	  7548:     cmp.b   D1,D0
02:000323D4 640A            	  7549:     bcc  _anon_z01_101
02:000323D6 122C0008        	  7550:     move.b  ($0008,A4),D1
02:000323DA E209            	  7551:     lsr.b  #1,D1   ; LSR $08
02:000323DC 19410008        	  7552:     move.b  D1,($0008,A4)
                            	  7553: _anon_z01_101:
                            	  7554:     ; If a monster is the defender, go handle it separately.
                            	  7555:     ;
02:000323E0 4A03            	  7556:     cmpi.b  #$00,D3
02:000323E2 6656            	  7557:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7558:     ; Link is the defender.
                            	  7559:     ;
                            	  7560:     ; If Link is invincible, return without shoving.
                            	  7561:     ;
02:000323E4 102C04F0        	  7562:     move.b  ($04F0,A4),D0
02:000323E8 664E            	  7563:     bne  _L_z01_BeginShove_Exit
                            	  7564:     ; Store the shove direction we determined.
                            	  7565:     ;
                            	  7566:     ; Turn on the high bit to indicate that the next time we try to
                            	  7567:     ; move by shoving, it will be the first time for this shove action.
                            	  7568:     ;
02:000323EA 102C0008        	  7569:     move.b  ($0008,A4),D0
02:000323EE 00000080        	  7570:     ori.b #$80,D0
02:000323F2 194000C0        	  7571:     move.b  D0,($00C0,A4)
                            	  7572:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7573:     ;
02:000323F6 7018            	  7574:     moveq   #24,D0
02:000323F8 194004F0        	  7575:     move.b  D0,($04F0,A4)
02:000323FC 7020            	  7576:     moveq   #32,D0
02:000323FE 194000D3        	  7577:     move.b  D0,($00D3,A4)
                            	  7578:     ; If Link was shoved by one of his own weapons, then
                            	  7579:     ; nothing else to do. Return.
                            	  7580:     ;
02:00032402 0C02000D        	  7581:     cmpi.b  #$0D,D2
02:00032406 6430            	  7582:     bcc  _L_z01_BeginShove_Exit
                            	  7583:     ; Link was shoved by a monster.
                            	  7584:     ;
                            	  7585:     ; If the monster's object attribute "reverse after hit Link" is set,
