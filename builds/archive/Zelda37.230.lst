02:0003DD88 0C000002        	  9766:     cmpi.b  #$02,D0
02:0003DD8C 670C            	  9767:     beq  _anon_z04_117
02:0003DD8E 0C000003        	  9768:     cmpi.b  #$03,D0
02:0003DD92 6706            	  9769:     beq  _anon_z04_117
02:0003DD94 4EF9000317FC    	  9770:     jmp     DrawObjectMirrored
