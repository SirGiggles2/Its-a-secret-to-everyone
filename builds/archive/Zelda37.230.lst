02:0003C542 10302000        	  6487:     move.b  (A0,D2.W),D0
02:0003C546 122C0002        	  6488:     move.b  ($0002,A4),D1
02:0003C54A E309            	  6489:     lsl.b  #1,D1   ; ASL $02
02:0003C54C 19410002        	  6490:     move.b  D1,($0002,A4)
02:0003C550 122C0002        	  6491:     move.b  ($0002,A4),D1
02:0003C554 C200            	  6492:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C556 6716            	  6493:     beq  _L_z04_Digdogger_Move_Down
02:0003C558 10342070        	  6494:     move.b  ($70,A4,D2.W),D0
