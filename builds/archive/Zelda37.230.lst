                            	 10956: __far_z_04_0102:
                            	 10957:     ; The segment is not a head nor bottom. So, we can use a
                            	 10958:     ; standard routine to draw. It uses one of the rolling sprites
                            	 10959:     ; that is drawn under Link and the heads.
                            	 10960:     ;
02:0003E65A 4EB900031AF6    	 10961:     jsr     Anim_WriteLevelPaletteSprite
