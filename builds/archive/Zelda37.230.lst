02:0003DBD6 0C020005        	  9530:     cmpi.b  #$05,D2
02:0003DBDA 660A            	  9531:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DBDC 41EC0405        	  9532:     lea     ($0405,A4),A0
02:0003DBE0 11802000        	  9533:     move.b  D0,(A0,D2.W)
