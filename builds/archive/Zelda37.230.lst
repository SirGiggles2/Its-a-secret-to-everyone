02:0003CF42 7607            	  7895:     moveq   #7,D3
                            	  7896: _anon_z04_98:
                            	  7897:     ; Set the vertical speed for the beginning of the jump.
                            	  7898:     ;
02:0003CF44 41F90003CE38    	  7899:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF4A 10303000        	  7900:     move.b  (A0,D3.W),D0
