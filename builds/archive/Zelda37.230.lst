02:00034FB2 610E            	  2768:     jsr     ModifyFlashingCursorY
02:00034FB4 19430208        	  2769:     move.b  D3,($0208,A4)
02:00034FB8 102C0071        	  2770:     move.b  ($0071,A4),D0
02:00034FBC 1940020B        	  2771:     move.b  D0,($020B,A4)
02:00034FC0 4E75            	  2772:     rts
                            	  2773: 
                            	  2774: ; Params:
                            	  2775: ; A: cursor Y
                            	  2776: ;
                            	  2777: ; Returns:
                            	  2778: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2779: ;
                            	  2780: ; Description:
                            	  2781: ; Adjust the Y coordinate to account for the visible part of
                            	  2782: ; block cursor being in the bottom half of sprite.
                            	  2783: ; Also, make the cursor flash.
                            	  2784: ;
                            	  2785:     even
