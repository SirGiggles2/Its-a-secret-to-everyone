02:0003E756 003C0011        	 11088:     ori     #$11,CCR  ; SEC: set C+X
02:0003E75A 123C0041        	 11089:     move.b  #$41,D1
02:0003E75E 0A3C0010        	 11090:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E762 9101            	 11091:     subx.b  D1,D0   ; SBC #$41
02:0003E764 0A3C0010        	 11092:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E768 1214            	 11093:     move.b  ($0000,A4),D1
02:0003E76A B001            	 11094:     cmp.b   D1,D0
                            	 11095:     ; If they're equal, then go handle the whole boss dying.
                            	 11096:     ;
