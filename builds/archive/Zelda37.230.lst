02:0003043C 0A3C0010        	  3006:     eori    #$10,CCR  ; restore X = 6502 C
02:00030440 6100086E        	  3007:     jsr     Abs
02:00030444 0C00000E        	  3008:     cmpi.b  #$0E,D0
02:00030448 644C            	  3009:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  3010:     ; Determine the horizontal direction toward Link;
                            	  3011:     ; and if Link and the trap are at the same X, then we can't move
