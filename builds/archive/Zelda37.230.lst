                            	  3844: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3845:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3846:     ;
                            	  3847:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3848:     ;         or object direction when <> 0.
                            	  3849:     ;
                            	  3850:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3851:     ;
                            	  3852:     ; if slot = 0 and grid offset <> 0 then
                            	  3853:     ;   if input dir = 0 then
                            	  3854:     ;     use 0
                            	  3855:     ;   else
                            	  3856:     ;     use object direction
                            	  3857:     ; else
                            	  3858:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3859:     ;     return
                            	  3860:     ;   else
                            	  3861:     ;     if input dir = 0
                            	  3862:     ;       use 0
                            	  3863:     ;     else
                            	  3864:     ;       use input direction
                            	  3865:     ;
02:0004B8D6 4A02            	  3866:     cmpi.b  #$00,D2
02:0004B8D8 6612            	  3867:     bne  _L_z07_Walker_Move_CheckStunned
02:0004B8DA 102C0394        	  3868:     move.b  ($0394,A4),D0
