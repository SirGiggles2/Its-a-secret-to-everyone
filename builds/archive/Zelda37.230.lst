                            	  7078: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7079:     ; Advance the substate.
                            	  7080:     ;
02:0003C9CE 41EC042C        	  7081:     lea     ($042C,A4),A0
02:0003C9D2 52302000        	  7082:     addq.b  #1,(A0,D2.W)
                            	  7083:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7084:     ;
02:0003C9D6 41EC042C        	  7085:     lea     ($042C,A4),A0
