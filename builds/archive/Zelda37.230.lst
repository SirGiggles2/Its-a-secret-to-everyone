                            	  5852: CalcBoomerangFrame:
                            	  5853:     ; The minor state (low 3 bits of state) is used to
                            	  5854:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5855:     ;
                            	  5856:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5857:     ; In other words, don't offset the coordinate below.
                            	  5858:     ;
02:0004C620 7000            	  5859:     moveq   #0,D0
02:0004C622 1880            	  5860:     move.b  D0,($0000,A4)
02:0004C624 41EC00AC        	  5861:     lea     ($00AC,A4),A0
02:0004C628 10302000        	  5862:     move.b  (A0,D2.W),D0
02:0004C62C 0200000F        	  5863:     andi.b #$0F,D0
02:0004C630 7600            	  5864:     moveq   #0,D3
02:0004C632 1600            	  5865:     move.b  D0,D3
02:0004C634 7000            	  5866:     moveq   #0,D0
02:0004C636 19400001        	  5867:     move.b  D0,($0001,A4)
02:0004C63A 41F90004C228    	  5868:     lea     (BoomerangFrameCycle).l,A0
02:0004C640 10303000        	  5869:     move.b  (A0,D3.W),D0
02:0004C644 1940000C        	  5870:     move.b  D0,($000C,A4)
                            	  5871:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5872:     ;
02:0004C648 1003            	  5873:     move.b  D3,D0
02:0004C64A 41F90004C232    	  5874:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C650 10303000        	  5875:     move.b  (A0,D3.W),D0
02:0004C654 19400004        	  5876:     move.b  D0,($0004,A4)
                            	  5877:     ; TODO: ?
                            	  5878:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5879:     ; Else add the item value of the magic boomerang.
                            	  5880:     ;
                            	  5881:     ; But none of the values in the base sprite attributes array is 8.
                            	  5882:     ;
                            	  5883:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5884:     ; the inventory will always be added to the base sprite attribute.
                            	  5885:     ;
                            	  5886:     ; So, palette row 4 or 5 will be chosen.
                            	  5887:     ;
02:0004C658 7600            	  5888:     moveq   #0,D3
02:0004C65A 0C000008        	  5889:     cmpi.b  #$08,D0
02:0004C65E 6706            	  5890:     beq  _anon_z07_31
02:0004C660 7600            	  5891:     moveq   #0,D3
02:0004C662 162C0675        	  5892:     move.b  ($0675,A4),D3
