                            	  7166:     ; Store (Y + 8) in [01].
                            	  7167:     ;
02:0003CC84 41EC0084        	  7168:     lea     ($0084,A4),A0
02:0003CC88 10302000        	  7169:     move.b  (A0,D2.W),D0
02:0003CC8C 123C0008        	  7170:     move.b  #$08,D1
02:0003CC90 D101            	  7171:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC92 19400001        	  7172:     move.b  D0,($0001,A4)
                            	  7173:     ; Only check the first bomb slot ($10).
                            	  7174:     ;
                            	  7175:     ; Store the bomb's (X + 8) in [02].
                            	  7176:     ;
02:0003CC96 7610            	  7177:     moveq   #16,D3
02:0003CC98 10343070        	  7178:     move.b  ($70,A4,D3.W),D0
02:0003CC9C 123C0008        	  7179:     move.b  #$08,D1
02:0003CCA0 D101            	  7180:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CCA2 19400002        	  7181:     move.b  D0,($0002,A4)
                            	  7182:     ; Store the bomb's (Y + 8) in [03].
                            	  7183:     ;
02:0003CCA6 41EC0084        	  7184:     lea     ($0084,A4),A0
02:0003CCAA 10303000        	  7185:     move.b  (A0,D3.W),D0
02:0003CCAE 123C0008        	  7186:     move.b  #$08,D1
02:0003CCB2 D101            	  7187:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CCB4 19400003        	  7188:     move.b  D0,($0003,A4)
                            	  7189:     ; But, if there's no bomb, then return.
                            	  7190:     ;
