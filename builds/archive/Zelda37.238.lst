02:0004377A 7400            	  5671:     moveq   #0,D2
02:0004377C 1400            	  5672:     move.b  D0,D2
                            	  5673:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5674:     ; starting from highest index down to 0:
                            	  5675:     ;
02:0004377E 41F90004366C    	  5676:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043784 10302000        	  5677:     move.b  (A0,D2.W),D0
02:00043788 7400            	  5678:     moveq   #0,D2
02:0004378A 1400            	  5679:     move.b  D0,D2
                            	  5680:     even
                            	  5681: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:0004378C 122C0002        	  5682:     move.b  ($02,A4),D1   ; ptr lo
02:00043790 182C0003        	  5683:     move.b  ($03,A4),D4  ; ptr hi
02:00043794 024100FF        	  5684:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043798 E14C            	  5685:     lsl.w   #8,D4
02:0004379A 8841            	  5686:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004379C 48C4            	  5687:     ext.l   D4
