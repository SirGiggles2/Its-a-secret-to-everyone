02:0003070E 41EC0098        	  3083:     lea     ($0098,A4),A0
02:00030712 10302000        	  3084:     move.b  (A0,D2.W),D0
02:00030716 0200000C        	  3085:     andi.b #$0C,D0
02:0003071A 6710            	  3086:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3087:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3088:     ; and current coordinate to the trap's Y.
                            	  3089:     ;
