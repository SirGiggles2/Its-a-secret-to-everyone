                            	  9737: 
                            	  9738:     even
                            	  9739: _L_z04_UpdateGohma_Move:
                            	  9740:     ; Add $80 to the movement accumulator.
                            	  9741:     ;
02:0003DF68 41EC041F        	  9742:     lea     ($041F,A4),A0
02:0003DF6C 10302000        	  9743:     move.b  (A0,D2.W),D0
02:0003DF70 023C00EE        	  9744:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF74 123C0080        	  9745:     move.b  #$80,D1
02:0003DF78 D101            	  9746:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DF7A 41EC041F        	  9747:     lea     ($041F,A4),A0
02:0003DF7E 11802000        	  9748:     move.b  D0,(A0,D2.W)
                            	  9749:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9750:     ;
02:0003DF82 640000A8        	  9751:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9752:     ; Increase the distance traveled, and move 1.
                            	  9753:     ;
02:0003DF86 41EC0412        	  9754:     lea     ($0412,A4),A0
02:0003DF8A 52302000        	  9755:     addq.b  #1,(A0,D2.W)
                            	  9756:     ; Set a direction mask in [02], starting with right (1).
                            	  9757:     ;
02:0003DF8E 7001            	  9758:     moveq   #1,D0
02:0003DF90 19400002        	  9759:     move.b  D0,($0002,A4)
                            	  9760:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9761:     ;
02:0003DF94 41EC0098        	  9762:     lea     ($0098,A4),A0
02:0003DF98 10302000        	  9763:     move.b  (A0,D2.W),D0
02:0003DF9C 122C0002        	  9764:     move.b  ($0002,A4),D1
02:0003DFA0 C200            	  9765:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DFA2 6704            	  9766:     beq  _anon_z04_118
02:0003DFA4 52342070        	  9767:     addq.b  #1,($70,A4,D2.W)
                            	  9768: _anon_z04_118:
