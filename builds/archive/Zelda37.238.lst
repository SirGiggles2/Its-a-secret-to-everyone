                            	  3714: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B35E 102C000D        	  3715:     move.b  ($000D,A4),D0
                            	  3716: ; Params:
                            	  3717: ; A: frame image
                            	  3718: ; X: object index
                            	  3719: ; [00]: object X
                            	  3720: ; [01]: object Y
                            	  3721: ; [0F]: flip horizontally
                            	  3722: ;
                            	  3723: ; Returns:
                            	  3724: ; [00]: 0 for Link slot
                            	  3725: ; [06]: 1 if objects collide
                            	  3726: ; [09]: 0 for Link damage type (none)
                            	  3727: ; [0C]: 1 if objects collide
                            	  3728: ; [034B]: ShotCollidesWithLink
                            	  3729: ;
                            	  3730:     even
