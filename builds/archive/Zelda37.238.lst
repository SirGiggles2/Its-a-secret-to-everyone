02:00041044 0A3C0010        	  1678:     eori    #$10,CCR  ; restore X = 6502 C
02:00041048 4EB900030EB6    	  1679:     jsr     Negate
02:0004104E 023C00EE        	  1680:     andi    #$EE,CCR  ; CLC: clear C+X
