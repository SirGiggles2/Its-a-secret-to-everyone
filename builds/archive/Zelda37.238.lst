02:0003C218 41EC0485        	  5729:     lea     ($0485,A4),A0
02:0003C21C 11802000        	  5730:     move.b  D0,(A0,D2.W)
02:0003C220 61000608        	  5731:     jsr     CheckBossHitReaction
                            	  5732:     ; Look for the tail segment, starting from the low end
                            	  5733:     ; of the chain that this dead segment belongs to.
                            	  5734:     ;
