                            	  5484: CheckState20:
                            	  5485:     ; If major state <> $20, go check other states.
                            	  5486:     ;
02:0004C446 0C000020        	  5487:     cmpi.b  #$20,D0
02:0004C44A 6704            	  5488:     beq.s  __far_z_07_0084
02:0004C44C 600000B6        	  5489:     jmp  CheckState30
                            	  5490: __far_z_07_0084:
                            	  5491:     ; State $2x. Spark.
                            	  5492:     ;
                            	  5493:     ; Change the state to $28, and decrement animation counter.
                            	  5494:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5495:     ; (with Link, if this is a monster's boomerang).
                            	  5496:     ;
                            	  5497:     ; TODO: Why state $28?
                            	  5498:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5499:     ; start over again when spinning.
                            	  5500:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5501:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5502:     ; any drawing code depends on the minor state.
                            	  5503:     ;
02:0004C450 7028            	  5504:     moveq   #40,D0
02:0004C452 41EC00AC        	  5505:     lea     ($00AC,A4),A0
02:0004C456 11802000        	  5506:     move.b  D0,(A0,D2.W)
02:0004C45A 41EC03D0        	  5507:     lea     ($03D0,A4),A0
02:0004C45E 53302000        	  5508:     subq.b  #1,(A0,D2.W)
02:0004C462 6702            	  5509:     beq.s  __far_z_07_0085
02:0004C464 6060            	  5510:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5511: __far_z_07_0085:
                            	  5512:     ; Animation counter = 0.
                            	  5513:     ;
                            	  5514:     ; Set state to $40. It will become $50 below in
                            	  5515:     ; HandleArrowOrBoomerangBlocked.
                            	  5516:     ;
02:0004C466 7040            	  5517:     moveq   #64,D0
02:0004C468 41EC00AC        	  5518:     lea     ($00AC,A4),A0
02:0004C46C 11802000        	  5519:     move.b  D0,(A0,D2.W)
                            	  5520:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5521:     ; Else go handle the boomerang being blocked.
                            	  5522:     ;
02:0004C470 0C02000D        	  5523:     cmpi.b  #$0D,D2
02:0004C474 640E            	  5524:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C476 41EC034F        	  5525:     lea     ($034F,A4),A0
02:0004C47A 10302000        	  5526:     move.b  (A0,D2.W),D0
02:0004C47E 0C00005B        	  5527:     cmpi.b  #$5B,D0
02:0004C482 6708            	  5528:     beq  _L_z07_CheckState20_Deactivate
                            	  5529:     even
