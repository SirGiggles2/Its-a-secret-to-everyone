                            	  7314: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7315:     ; If the "monsters from edges" long timer expired, then
                            	  7316:     ; go bring the monster in.
                            	  7317:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7318:     ;
                            	  7319:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7320:     ; residual position so enemies keep their previous-room
                            	  7321:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D222 102C004B        	  7322:     move.b  ($004B,A4),D0
02:0004D226 662E            	  7323:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7324:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D228 102C000F        	  7325:     move.b  ($000F,A4),D0
02:0004D22C 0C0000FF        	  7326:     cmpi.b  #$FF,D0
02:0004D230 662E            	  7327:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D232 41EC0070        	  7328:     lea     ($0070,A4),A0
02:0004D236 10302000        	  7329:     move.b  (A0,D2.W),D0
02:0004D23A 660A            	  7330:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D23C 41EC0084        	  7331:     lea     ($0084,A4),A0
02:0004D240 10302000        	  7332:     move.b  (A0,D2.W),D0
02:0004D244 671A            	  7333:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7334:     even
