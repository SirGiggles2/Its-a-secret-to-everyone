                            	  2538:     ; the name field.
02:00034FC2 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034FC4 7600            	  2540:     moveq   #0,D3
02:00034FC6 162C0016        	  2541:     move.b  ($0016,A4),D3
02:00034FCA 0C030003        	  2542:     cmpi.b  #$03,D3
02:00034FCE 6602            	  2543:     bne.s  __far_z_02_0007
02:00034FD0 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00034FD2 41F9000349E0    	  2548:     lea     (SlotToNameOffset).l,A0
02:00034FD8 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00034FDC 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00034FE0 7400            	  2553:     moveq   #0,D2
02:00034FE2 41F9000349E4    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034FE8 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00034FEC 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00034FEE 41F9000349B0    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034FF4 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00034FF8 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00034FFC 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00035000 5302            	  2563:     subq.b  #1,D2
02:00035002 5303            	  2564:     subq.b  #1,D3
02:00035004 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00035006 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:0003500A 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:0003500E 020000C0        	  2577:     andi.b #$C0,D0
02:00035012 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00035016 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:0003501A 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:0003501E 7620            	  2586:     moveq   #32,D3
02:00035020 19430604        	  2587:     move.b  D3,($0604,A4)
02:00035024 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00035026 41EC0422        	  2591:     lea     ($0422,A4),A0
02:0003502A 10303000        	  2592:     move.b  (A0,D3.W),D0
02:0003502E 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00035032 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00035036 5303            	  2595:     subq.b  #1,D3
02:00035038 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:0003503A 19430306        	  2597:     move.b  D3,($0306,A4)
