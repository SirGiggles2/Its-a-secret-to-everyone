                            	  3305:     ; the destination room ID only.
                            	  3306:     ;
02:00041C3E 7600            	  3307:     moveq   #0,D3
02:00041C40 1600            	  3308:     move.b  D0,D3
02:00041C42 102C0070        	  3309:     move.b  ($0070,A4),D0
02:00041C46 0C000080        	  3310:     cmpi.b  #$80,D0
02:00041C4A 640C            	  3311:     bcc  _L_z05_CheckSubroom_GetRightSideRoom
02:00041C4C 41F900FF687E    	  3312:     lea     (NES_SRAM+$087E).l,A0
02:00041C52 10303000        	  3313:     move.b  (A0,D3.W),D0
02:00041C56 600A            	  3314:     jmp     _anon_z05_82
                            	  3315: 
