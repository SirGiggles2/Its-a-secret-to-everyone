                            	  3585:     ; Decrement the animation counter, and roll over if needed.
                            	  3586:     ;
02:0003B282 41EC03D0        	  3587:     lea     ($03D0,A4),A0
02:0003B286 53302000        	  3588:     subq.b  #1,(A0,D2.W)
02:0003B28A 661E            	  3589:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B28C 7006            	  3590:     moveq   #6,D0
02:0003B28E 41EC03D0        	  3591:     lea     ($03D0,A4),A0
02:0003B292 11802000        	  3592:     move.b  D0,(A0,D2.W)
                            	  3593:     ; There are actually 6 frame images divided into 2 sets.
                            	  3594:     ; Each set depicts one animation frame. In each set there are
                            	  3595:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3596:     ;
                            	  3597:     ; The movement frame will keep track of the base offset of
                            	  3598:     ; the current set for the current animation frame: 0 or 3.
                            	  3599:     ;
                            	  3600:     ; So, XOR the movement frame with 3.
                            	  3601:     ;
02:0003B296 E208            	  3602:     lsr.b  #1,D0   ; LSR A
02:0003B298 41EC03E4        	  3603:     lea     ($03E4,A4),A0
02:0003B29C 12302000        	  3604:     move.b  (A0,D2.W),D1
02:0003B2A0 B300            	  3605:     eor.b  D1,D0
02:0003B2A2 41EC03E4        	  3606:     lea     ($03E4,A4),A0
02:0003B2A6 11802000        	  3607:     move.b  D0,(A0,D2.W)
                            	  3608:     even
