02:0004C006 02000003        	  4872:     andi.b #$03,D0
02:0004C00A 6712            	  4873:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004C00C 102C0001        	  4874:     move.b  ($0001,A4),D0
02:0004C010 023C00EE        	  4875:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C014 123C0003        	  4876:     move.b  #$03,D1
02:0004C018 D101            	  4877:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004C01A 19400001        	  4878:     move.b  D0,($0001,A4)
                            	  4879:     even
                            	  4880: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004C01E 101D            	  4881:     move.b  (A5)+,D0  ; PLA
                            	  4882:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4883:     ; This makes the shot flash by cycling all the palettes, one each frame.
