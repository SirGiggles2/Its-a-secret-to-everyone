                            	  7427: BeginShove:
02:0003255E 7600            	  7428:     moveq   #0,D3
02:00032560 1614            	  7429:     move.b  ($0000,A4),D3
02:00032562 0C02000D        	  7430:     cmpi.b  #$0D,D2
02:00032566 6412            	  7431:     bcc  _anon_z01_99
02:00032568 41EC04B2        	  7432:     lea     ($04B2,A4),A0
02:0003256C 10302000        	  7433:     move.b  (A0,D2.W),D0
02:00032570 122C0009        	  7434:     move.b  ($0009,A4),D1
02:00032574 C001            	  7435:     and.b  D1,D0
02:00032576 660000C4        	  7436:     bne  _L_z01_BeginShove_Exit
                            	  7437: _anon_z01_99:
                            	  7438:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7439:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7440:     ;
                            	  7441:     ; If instead a monster is defending, then all this calculation
                            	  7442:     ; won't matter, because the shove direction will be set to the
                            	  7443:     ; weapon's direction.
                            	  7444:     ;
                            	  7445:     ; As such, calculate a direction from the monster to the defender,
                            	  7446:     ; assuming it's Link.
                            	  7447:     ;
                            	  7448:     ; Start with an assumption that the direction is vertical:
                            	  7449:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7450:     ;
02:0003257A 7008            	  7451:     moveq   #8,D0
02:0003257C 19400008        	  7452:     move.b  D0,($0008,A4)
02:00032580 41EC0084        	  7453:     lea     ($0084,A4),A0
02:00032584 10302000        	  7454:     move.b  (A0,D2.W),D0
02:00032588 19400004        	  7455:     move.b  D0,($0004,A4)
02:0003258C 41EC0084        	  7456:     lea     ($0084,A4),A0
02:00032590 10303000        	  7457:     move.b  (A0,D3.W),D0
02:00032594 19400005        	  7458:     move.b  D0,($0005,A4)
                            	  7459:     ; If the defender is Link and his grid offset <> 0 then
                            	  7460:     ; use his usual object direction variable to determine
                            	  7461:     ; which axis to check.
                            	  7462:     ;
02:00032598 4A03            	  7463:     cmpi.b  #$00,D3
02:0003259A 6612            	  7464:     bne  _anon_z01_100
02:0003259C 102C0394        	  7465:     move.b  ($0394,A4),D0
02:000325A0 670C            	  7466:     beq  _anon_z01_100
02:000325A2 102C0098        	  7467:     move.b  ($0098,A4),D0
02:000325A6 02000003        	  7468:     andi.b #$03,D0
02:000325AA 660C            	  7469:     bne  _L_z01_BeginShove_CheckHorizontal
02:000325AC 6720            	  7470:     beq  _L_z01_BeginShove_CheckVertical
                            	  7471: _anon_z01_100:
                            	  7472:     ; For monsters defending, or Link with grid offset = 0,
                            	  7473:     ; check direction in [0B].
                            	  7474:     ;
                            	  7475:     ; For monsters defending, this won't matter. For Link with grid
                            	  7476:     ; offset = 0, I believe the result will be arbitrary.
                            	  7477:     ;
                            	  7478:     ; TODO:
                            	  7479:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7480:     ; It doesn't seem to be if candle fire attacks him.
                            	  7481:     ;
02:000325AE 102C000B        	  7482:     move.b  ($000B,A4),D0
02:000325B2 0C000004        	  7483:     cmpi.b  #$04,D0
02:000325B6 6416            	  7484:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7485:     even
                            	  7486: _L_z01_BeginShove_CheckHorizontal:
                            	  7487:     ; If the direction checked is left or right,
                            	  7488:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7489:     ;
02:000325B8 7002            	  7490:     moveq   #2,D0
02:000325BA 19400008        	  7491:     move.b  D0,($0008,A4)
02:000325BE 10342070        	  7492:     move.b  ($70,A4,D2.W),D0
02:000325C2 19400004        	  7493:     move.b  D0,($0004,A4)
02:000325C6 10343070        	  7494:     move.b  ($70,A4,D3.W),D0
02:000325CA 19400005        	  7495:     move.b  D0,($0005,A4)
                            	  7496:     even
                            	  7497: _L_z01_BeginShove_CheckVertical:
                            	  7498:     ; If the monster is down or right of the other object,
                            	  7499:     ; then use the opposite direction already in [08].
                            	  7500:     ; Else shift [08] right to turn it into the opposite
                            	  7501:     ; direction up or down.
                            	  7502:     ;
                            	  7503:     ; Again assuming Link is the defender; after this, [08] points
                            	  7504:     ; Link away from the monster.
                            	  7505:     ;
02:000325CE 102C0004        	  7506:     move.b  ($0004,A4),D0
02:000325D2 122C0005        	  7507:     move.b  ($0005,A4),D1
02:000325D6 B001            	  7508:     cmp.b   D1,D0
02:000325D8 640A            	  7509:     bcc  _anon_z01_101
02:000325DA 122C0008        	  7510:     move.b  ($0008,A4),D1
02:000325DE E209            	  7511:     lsr.b  #1,D1   ; LSR $08
02:000325E0 19410008        	  7512:     move.b  D1,($0008,A4)
                            	  7513: _anon_z01_101:
                            	  7514:     ; If a monster is the defender, go handle it separately.
                            	  7515:     ;
02:000325E4 4A03            	  7516:     cmpi.b  #$00,D3
02:000325E6 6656            	  7517:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7518:     ; Link is the defender.
                            	  7519:     ;
                            	  7520:     ; If Link is invincible, return without shoving.
                            	  7521:     ;
02:000325E8 102C04F0        	  7522:     move.b  ($04F0,A4),D0
02:000325EC 664E            	  7523:     bne  _L_z01_BeginShove_Exit
                            	  7524:     ; Store the shove direction we determined.
                            	  7525:     ;
                            	  7526:     ; Turn on the high bit to indicate that the next time we try to
                            	  7527:     ; move by shoving, it will be the first time for this shove action.
                            	  7528:     ;
02:000325EE 102C0008        	  7529:     move.b  ($0008,A4),D0
02:000325F2 00000080        	  7530:     ori.b #$80,D0
02:000325F6 194000C0        	  7531:     move.b  D0,($00C0,A4)
                            	  7532:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7533:     ;
02:000325FA 7018            	  7534:     moveq   #24,D0
02:000325FC 194004F0        	  7535:     move.b  D0,($04F0,A4)
02:00032600 7020            	  7536:     moveq   #32,D0
02:00032602 194000D3        	  7537:     move.b  D0,($00D3,A4)
                            	  7538:     ; If Link was shoved by one of his own weapons, then
                            	  7539:     ; nothing else to do. Return.
                            	  7540:     ;
02:00032606 0C02000D        	  7541:     cmpi.b  #$0D,D2
02:0003260A 6430            	  7542:     bcc  _L_z01_BeginShove_Exit
                            	  7543:     ; Link was shoved by a monster.
                            	  7544:     ;
                            	  7545:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7546:     ; then return.
