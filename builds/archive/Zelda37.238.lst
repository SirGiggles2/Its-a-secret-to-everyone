02:00044DFA 162C0070        	  8147:     move.b  ($0070,A4),D3
02:00044DFE 0C030020        	  8148:     cmpi.b  #$20,D3
02:00044E02 6706            	  8149:     beq  _anon_z05_175
02:00044E04 0C0300D0        	  8150:     cmpi.b  #$D0,D3
