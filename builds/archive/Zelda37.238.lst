                            	  5799: Moldorm_Chase:
                            	  5800:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5801:     ; Only the head controls the movement direction.
                            	  5802:     ;
02:0003C2AA 0C020005        	  5803:     cmpi.b  #$05,D2
02:0003C2AE 670A            	  5804:     beq  _anon_z04_81
02:0003C2B0 0C02000A        	  5805:     cmpi.b  #$0A,D2
02:0003C2B4 6704            	  5806:     beq.s  __far_z_04_0040
02:0003C2B6 600000A4        	  5807:     jmp  L1156B_Exit
                            	  5808: __far_z_04_0040:
                            	  5809: _anon_z04_81:
                            	  5810:     ; Chase while flying, as usual.
                            	  5811:     ;
02:0003C2BA 61003A68        	  5812:     jsr     Flyer_Chase
                            	  5813:     ; If timer has not expired, then
                            	  5814:     ; go see if it's time to propagate direction changes down the chain.
                            	  5815:     ;
02:0003C2BE 10342028        	  5816:     move.b  ($28,A4,D2.W),D0
02:0003C2C2 6702            	  5817:     beq.s  __far_z_04_0041
02:0003C2C4 6032            	  5818:     jmp  Moldorm_PropagateDirs
                            	  5819: __far_z_04_0041:
                            	  5820:     even
                            	  5821: Moldorm_ChangeFlyingState:
                            	  5822:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5823:     ;
02:0003C2C6 61000096        	  5824:     jsr     Flyer_MoldormDecideState
02:0003C2CA 7010            	  5825:     moveq   #16,D0
02:0003C2CC 19802028        	  5826:     move.b  D0,($28,A4,D2.W)
                            	  5827:     ; If the next lower slot's direction <> 0, then
                            	  5828:     ; go propagate direction changes down the chain.
                            	  5829:     ;
                            	  5830:     ; But you had to have propagated directions once for the
                            	  5831:     ; next lower direction to be set. How does it happen?
                            	  5832:     ;
                            	  5833:     ; Within a flyer state, the flying routines turn the flyer
                            	  5834:     ; and set the object timer to $10 several times. After any of
                            	  5835:     ; those times will the test succeed.
                            	  5836:     ;
                            	  5837:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5838:     ; in this block to set the timer to $10, and try to propagate
                            	  5839:     ; directions.
                            	  5840:     ;
                            	  5841:     ; But this is also the case the first time here.
                            	  5842:     ;
                            	  5843:     ; So, I believe that the point of this test is to delay moving
                            	  5844:     ; the lower (not head) segments when starting out.
                            	  5845:     ;
02:0003C2D0 41EC0097        	  5846:     lea     ($0097,A4),A0
02:0003C2D4 10302000        	  5847:     move.b  (A0,D2.W),D0
02:0003C2D8 6702            	  5848:     beq.s  __far_z_04_0042
02:0003C2DA 601C            	  5849:     jmp  Moldorm_PropagateDirs
                            	  5850: __far_z_04_0042:
02:0003C2DC 4E75            	  5851:     rts
                            	  5852: 
                            	  5853:     even
                            	  5854: Moldorm_Wander:
                            	  5855:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5856:     ; Only the head controls the movement direction.
                            	  5857:     ;
02:0003C2DE 0C020005        	  5858:     cmpi.b  #$05,D2
02:0003C2E2 6708            	  5859:     beq  _anon_z04_82
02:0003C2E4 0C02000A        	  5860:     cmpi.b  #$0A,D2
02:0003C2E8 6702            	  5861:     beq.s  __far_z_04_0043
02:0003C2EA 6070            	  5862:     jmp  L1156B_Exit
                            	  5863: __far_z_04_0043:
                            	  5864: _anon_z04_82:
                            	  5865:     ; Turn randomly while flying, as usual.
                            	  5866:     ;
02:0003C2EC 61003B14        	  5867:     jsr     Flyer_Wander
                            	  5868:     ; After every turn, the common flyer routines set timer to $10.
                            	  5869:     ; This can be used as a signal for moldorm to propagate
                            	  5870:     ; direction changes down the chain.
                            	  5871:     ;
                            	  5872:     ; Between each turn, timer <> $10.
                            	  5873:     ;
                            	  5874:     ; At the end of the delay after the last turn, timer = 0.
                            	  5875:     ; This is a signal that that flying state ended, and a new one
                            	  5876:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5877:     ; we can propagate direction changes again; and start
                            	  5878:     ; a new flying interval by setting timer to $10. This will make
                            	  5879:     ; the next flying state delay that amount of time before turning
                            	  5880:     ; the first time.
                            	  5881:     ;
                            	  5882:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5883:     ; arm the timer again, and shift directions down the chain.
                            	  5884:     ;
02:0003C2F0 10342028        	  5885:     move.b  ($28,A4,D2.W),D0
02:0003C2F4 6602            	  5886:     bne.s  __far_z_04_0044
02:0003C2F6 60CE            	  5887:     jmp  Moldorm_ChangeFlyingState
                            	  5888: __far_z_04_0044:
                            	  5889:     even
                            	  5890: Moldorm_PropagateDirs:
                            	  5891:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5892:     ;
02:0003C2F8 10342028        	  5893:     move.b  ($28,A4,D2.W),D0
02:0003C2FC 0C000010        	  5894:     cmpi.b  #$10,D0
02:0003C300 6702            	  5895:     beq.s  __far_z_04_0045
02:0003C302 6058            	  5896:     jmp  L1156B_Exit
                            	  5897: __far_z_04_0045:
                            	  5898:     ; Timer = $10.
                            	  5899:     ;
                            	  5900:     ; If deferred bounce direction <> 0, then
                            	  5901:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5902:     ;
02:0003C304 41EC03BC        	  5903:     lea     ($03BC,A4),A0
02:0003C308 10302000        	  5904:     move.b  (A0,D2.W),D0
02:0003C30C 6712            	  5905:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C30E 41EC0098        	  5906:     lea     ($0098,A4),A0
02:0003C312 11802000        	  5907:     move.b  D0,(A0,D2.W)
02:0003C316 7000            	  5908:     moveq   #0,D0
02:0003C318 41EC03BC        	  5909:     lea     ($03BC,A4),A0
02:0003C31C 11802000        	  5910:     move.b  D0,(A0,D2.W)
                            	  5911:     even
                            	  5912: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  5913:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  5914:     ;
02:0003C320 7004            	  5915:     moveq   #4,D0
02:0003C322 1880            	  5916:     move.b  D0,($0000,A4)
                            	  5917:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  5918:     ;
02:0003C324 7600            	  5919:     moveq   #0,D3
02:0003C326 0C020005        	  5920:     cmpi.b  #$05,D2
02:0003C32A 6702            	  5921:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C32C 7605            	  5922:     moveq   #5,D3
                            	  5923:     even
                            	  5924: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  5925:     ; Copy old direction from a higher slot to the lower one;
                            	  5926:     ; and to the lower one's facing direction.
                            	  5927:     ;
02:0003C32E 41EC0382        	  5928:     lea     ($0382,A4),A0
02:0003C332 10303000        	  5929:     move.b  (A0,D3.W),D0
02:0003C336 41EC0381        	  5930:     lea     ($0381,A4),A0
02:0003C33A 11803000        	  5931:     move.b  D0,(A0,D3.W)
02:0003C33E 41EC0099        	  5932:     lea     ($0099,A4),A0
02:0003C342 11803000        	  5933:     move.b  D0,(A0,D3.W)
                            	  5934:     ; Bottom of the loop.
                            	  5935:     ; Increment segment index.
                            	  5936:     ; Decrement loop counter.
                            	  5937:     ;
02:0003C346 5203            	  5938:     addq.b  #1,D3
02:0003C348 5314            	  5939:     subq.b  #1,($0000,A4)
02:0003C34A 66E2            	  5940:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  5941:     ; Copy current direction to old direction.
                            	  5942:     ;
02:0003C34C 41EC0098        	  5943:     lea     ($0098,A4),A0
02:0003C350 10302000        	  5944:     move.b  (A0,D2.W),D0
02:0003C354 41EC0380        	  5945:     lea     ($0380,A4),A0
02:0003C358 11802000        	  5946:     move.b  D0,(A0,D2.W)
                            	  5947:     even
