02:0003F24A 7600            	 12285:     moveq   #0,D3
02:0003F24C 162C045F        	 12286:     move.b  ($045F,A4),D3
                            	 12287:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12288:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12289:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12290:     ;
02:0003F250 41EC034F        	 12291:     lea     ($034F,A4),A0
02:0003F254 10302000        	 12292:     move.b  (A0,D2.W),D0
02:0003F258 0C000025        	 12293:     cmpi.b  #$25,D0
02:0003F25C 661E            	 12294:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F25E 41F90003F150    	 12295:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F264 10303000        	 12296:     move.b  (A0,D3.W),D0
02:0003F268 1B00            	 12297:     move.b  D0,-(A5)  ; PHA
02:0003F26A 41F90003F154    	 12298:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F270 10303000        	 12299:     move.b  (A0,D3.W),D0
02:0003F274 7600            	 12300:     moveq   #0,D3
02:0003F276 1600            	 12301:     move.b  D0,D3
02:0003F278 101D            	 12302:     move.b  (A5)+,D0  ; PLA
