02:00030746 9101            	  3111:     subx.b  D1,D0   ; SBC $00
02:00030748 0A3C0010        	  3112:     eori    #$10,CCR  ; restore X = 6502 C
02:0003074C 61000764        	  3113:     jsr     Abs
