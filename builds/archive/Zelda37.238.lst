                            	 12935: Ganon_CheckCollisions:
                            	 12936:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12937:     ; Store in [02] and [03].
                            	 12938:     ;
02:0003F6DA 10342070        	 12939:     move.b  ($70,A4,D2.W),D0
02:0003F6DE 023C00EE        	 12940:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F6E2 123C0010        	 12941:     move.b  #$10,D1
02:0003F6E6 D101            	 12942:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F6E8 19400002        	 12943:     move.b  D0,($0002,A4)
02:0003F6EC 41EC0084        	 12944:     lea     ($0084,A4),A0
02:0003F6F0 10302000        	 12945:     move.b  (A0,D2.W),D0
02:0003F6F4 023C00EE        	 12946:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F6F8 123C0010        	 12947:     move.b  #$10,D1
02:0003F6FC D101            	 12948:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F6FE 19400003        	 12949:     move.b  D0,($0003,A4)
                            	 12950:     ; Check for a collision with Link.
                            	 12951:     ;
                            	 12952:     ; We can't call CheckLinkCollision, because we need to
                            	 12953:     ; customize Ganon's midpoint.
                            	 12954:     ;
                            	 12955:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12956:     ; detection, if Link is invincible. Initialize variables that will
                            	 12957:     ; be returned from the partial collision check routine. Then
                            	 12958:     ; call it.
                            	 12959:     ;
02:0003F702 102C04F0        	 12960:     move.b  ($04F0,A4),D0
02:0003F706 6616            	 12961:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F708 19400006        	 12962:     move.b  D0,($0006,A4)
02:0003F70C 19400009        	 12963:     move.b  D0,($0009,A4)
02:0003F710 1940000C        	 12964:     move.b  D0,($000C,A4)
02:0003F714 7600            	 12965:     moveq   #0,D3
02:0003F716 1883            	 12966:     move.b  D3,($0000,A4)
02:0003F718 4EB900031F00    	 12967:     jsr     CheckLinkCollisionPreinit
                            	 12968:     even
                            	 12969: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12970:     ; If Ganon is not in state 0, then he's brown.
                            	 12971:     ; Go check collision with an arrow.
                            	 12972:     ;
02:0003F71E 41EC00AC        	 12973:     lea     ($00AC,A4),A0
02:0003F722 10302000        	 12974:     move.b  (A0,D2.W),D0
02:0003F726 6652            	 12975:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12976:     ; If timer <> 0, then Ganon is visible.
                            	 12977:     ; He can't be harmed like this. So, return.
                            	 12978:     ;
02:0003F728 10342028        	 12979:     move.b  ($28,A4,D2.W),D0
02:0003F72C 664A            	 12980:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F72E 760D            	 12981:     moveq   #13,D3
02:0003F730 4EB9000323CA    	 12982:     jsr     CheckMonsterSwordCollision
                            	 12983:     ; If Ganon has died according to the usual collision check rules
                            	 12984:     ; (HP = 0), then:
                            	 12985:     ; 1. Restore HP to the initial value $F0
                            	 12986:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12987:     ; 3. Change palette row 7 to make Ganon brown
                            	 12988:     ;
02:0003F736 41EC0405        	 12989:     lea     ($0405,A4),A0
02:0003F73A 10302000        	 12990:     move.b  (A0,D2.W),D0
02:0003F73E 6718            	 12991:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F740 103C00F0        	 12992:     move.b  #$F0,D0
02:0003F744 41EC0485        	 12993:     lea     ($0485,A4),A0
02:0003F748 11802000        	 12994:     move.b  D0,(A0,D2.W)
02:0003F74C 41EC00AC        	 12995:     lea     ($00AC,A4),A0
02:0003F750 53302000        	 12996:     subq.b  #1,(A0,D2.W)
02:0003F754 61000084        	 12997:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12998:     even
                            	 12999: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13000:     ; If Ganon was harmed, then play the sound effect
                            	 13001:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13002:     ;
02:0003F758 41EC04F0        	 13003:     lea     ($04F0,A4),A0
02:0003F75C 10302000        	 13004:     move.b  (A0,D2.W),D0
02:0003F760 670A            	 13005:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F762 6100A2E6        	 13006:     jsr     PlayBossHitCryIfNeeded
02:0003F766 7040            	 13007:     moveq   #64,D0
02:0003F768 19802028        	 13008:     move.b  D0,($28,A4,D2.W)
                            	 13009:     even
                            	 13010: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13011:     ; Reset metastate, because Ganon cannot die this way.
                            	 13012:     ;
02:0003F76C 4EB90004D630    	 13013:     jsr     ResetObjMetastate
                            	 13014:     ; Reset shove info and invincibility timer, because Ganon
                            	 13015:     ; doesn't react at all as a usual monster.
                            	 13016:     ;
02:0003F772 4EB9000322D2    	 13017:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13018:     even
                            	 13019: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F778 4E75            	 13020:     rts
                            	 13021: 
                            	 13022:     even
                            	 13023: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13024:     ; If the silver arrow is not in the inventory, then return.
                            	 13025:     ;
02:0003F77A 102C0659        	 13026:     move.b  ($0659,A4),D0
02:0003F77E 0C000002        	 13027:     cmpi.b  #$02,D0
02:0003F782 66F4            	 13028:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13029:     ; Reset the collision return value [06].
                            	 13030:     ;
02:0003F784 7000            	 13031:     moveq   #0,D0
02:0003F786 19400006        	 13032:     move.b  D0,($0006,A4)
                            	 13033:     ; If there's no arrow in flight, then return.
                            	 13034:     ;
02:0003F78A 7612            	 13035:     moveq   #18,D3
02:0003F78C 41EC00AC        	 13036:     lea     ($00AC,A4),A0
02:0003F790 10303000        	 13037:     move.b  (A0,D3.W),D0
02:0003F794 0C000010        	 13038:     cmpi.b  #$10,D0
02:0003F798 66DE            	 13039:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13040:     ; Check for collision with an arrow; and return if no collision.
                            	 13041:     ;
02:0003F79A 4EB900032426    	 13042:     jsr     CheckMonsterArrowOrRodCollision
02:0003F7A0 102C0006        	 13043:     move.b  ($0006,A4),D0
02:0003F7A4 67D2            	 13044:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13045:     ; Set the Ganon phase to "dying".
                            	 13046:     ;
02:0003F7A6 41EC042C        	 13047:     lea     ($042C,A4),A0
02:0003F7AA 52302000        	 13048:     addq.b  #1,(A0,D2.W)
                            	 13049:     ; Now his body does flash.
                            	 13050:     ;
02:0003F7AE 7028            	 13051:     moveq   #40,D0
02:0003F7B0 41EC04F0        	 13052:     lea     ($04F0,A4),A0
02:0003F7B4 11802000        	 13053:     move.b  D0,(A0,D2.W)
                            	 13054:     ; Set initial cloud distance 8.
                            	 13055:     ;
02:0003F7B8 7008            	 13056:     moveq   #8,D0
02:0003F7BA 41EC0478        	 13057:     lea     ($0478,A4),A0
02:0003F7BE 11802000        	 13058:     move.b  D0,(A0,D2.W)
02:0003F7C2 0A3C0001        	 13059:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F7C6 4E75            	 13060:     rts
