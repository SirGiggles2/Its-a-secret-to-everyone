                            	 13870: TurnTowardsPlayer8:
                            	 13871:     ; Build a direction in [00] towards the player.
                            	 13872:     ;
                            	 13873:     ; First, calculate a horizontal component:
                            	 13874:     ;
                            	 13875:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13876:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13877:     ; else                               [00] := 2 (left)
                            	 13878:     ;
02:0003FD44 7600            	 13879:     moveq   #0,D3
02:0003FD46 1883            	 13880:     move.b  D3,($0000,A4)
02:0003FD48 5203            	 13881:     addq.b  #1,D3
02:0003FD4A 102C0061        	 13882:     move.b  ($0061,A4),D0
02:0003FD4E 12342070        	 13883:     move.b  ($70,A4,D2.W),D1
