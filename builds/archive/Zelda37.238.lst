                            	  4991: UpdateMode13WinGame_Sub3:
                            	  4992:     ; After scrolling 8 pixels, draw another tile row.
                            	  4993:     ;
02:00036898 102C050B        	  4994:     move.b  ($050B,A4),D0
02:0003689C 0C000008        	  4995:     cmpi.b  #$08,D0
02:000368A0 6B1A            	  4996:     bmi  _anon_z02_37
02:000368A2 102C050B        	  4997:     move.b  ($050B,A4),D0
02:000368A6 123C0008        	  4998:     move.b  #$08,D1
02:000368AA 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000368AE 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:000368B0 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
02:000368B4 1940050B        	  5002:     move.b  D0,($050B,A4)
02:000368B8 61000282        	  5003:     jsr     DrawCredits
                            	  5004: _anon_z02_37:
                            	  5005:     ; Add $80 to the scroll speed fraction.
                            	  5006:     ;
02:000368BC 102C0058        	  5007:     move.b  ($0058,A4),D0
02:000368C0 023C00EE        	  5008:     andi    #$EE,CCR  ; CLC: clear C+X
02:000368C4 123C0080        	  5009:     move.b  #$80,D1
02:000368C8 D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000368CA 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
02:000368CE 6404            	  5014:     bcc  _anon_z02_38
02:000368D0 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:000368D4 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:000368D8 123C0000        	  5018:     move.b  #$00,D1
02:000368DC D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000368DE 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
                            	  5024:     ;
02:000368E2 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:000368E6 7000            	  5026:     moveq   #0,D0
02:000368E8 6508            	  5027:     bcs  _anon_z02_39
02:000368EA 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:000368EE 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
02:000368F2 E310            	  5034:     roxl.b  #1,D0   ; ROL A
02:000368F4 1940005C        	  5035:     move.b  D0,($005C,A4)
                            	  5036:     ; Put the quest number in Y register.
                            	  5037:     ;
