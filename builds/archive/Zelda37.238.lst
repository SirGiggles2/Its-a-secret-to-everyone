                            	  4708: _anon_z02_34:
02:0003662C 41F900FF6B7E    	  4709:     lea     (NES_SRAM+$0B7E).l,A0
02:00036632 10303000        	  4710:     move.b  (A0,D3.W),D0
02:00036636 41EC0302        	  4711:     lea     ($0302,A4),A0
02:0003663A 11803000        	  4712:     move.b  D0,(A0,D3.W)
02:0003663E 5303            	  4713:     subq.b  #1,D3
