                            	  4008: __far_z_04_0035:
                            	  4009:     ; State 0.
                            	  4010:     ;
                            	  4011:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4012:     ;
02:0003B526 102C0084        	  4013:     move.b  ($0084,A4),D0
02:0003B52A 0C0000AD        	  4014:     cmpi.b  #$AD,D0
02:0003B52E 661E            	  4015:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4016:     ; If Link's X < $70 or >= $81, then return.
                            	  4017:     ;
02:0003B530 102C0070        	  4018:     move.b  ($0070,A4),D0
02:0003B534 0C000070        	  4019:     cmpi.b  #$70,D0
02:0003B538 6514            	  4020:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B53A 0C000081        	  4021:     cmpi.b  #$81,D0
02:0003B53E 640E            	  4022:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4023:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4024:     ; halt Link, and start filling hearts.
                            	  4025:     ;
02:0003B540 522C00AD        	  4026:     addq.b  #1,($00AD,A4)
02:0003B544 7040            	  4027:     moveq   #64,D0
02:0003B546 194000AC        	  4028:     move.b  D0,($00AC,A4)
02:0003B54A 19400063        	  4029:     move.b  D0,($0063,A4)
                            	  4030:     even
