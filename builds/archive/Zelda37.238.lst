02:000351C4 4E75            	  2772:     rts
                            	  2773: 
                            	  2774: ; Params:
                            	  2775: ; A: cursor Y
                            	  2776: ;
                            	  2777: ; Returns:
                            	  2778: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2779: ;
                            	  2780: ; Description:
