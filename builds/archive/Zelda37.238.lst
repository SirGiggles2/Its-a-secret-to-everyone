                            	  4033: 
                            	  4034:     even
                            	  4035: PondFairy_HandleOtherStates:
02:0003B550 0C000001        	  4036:     cmpi.b  #$01,D0
02:0003B554 6610            	  4037:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4038:     ; State 1. Flying and filling hearts.
                            	  4039:     ;
                            	  4040:     ; If still filling hearts, then go draw Link and hearts.
                            	  4041:     ;
02:0003B556 102C0063        	  4042:     move.b  ($0063,A4),D0
02:0003B55A 6620            	  4043:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4044:     ; If not filling hearts anymore, then go to state 2,
                            	  4045:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4046:     ; a little while after we finish filling hearts.
                            	  4047:     ;
02:0003B55C 522C00AD        	  4048:     addq.b  #1,($00AD,A4)
02:0003B560 7050            	  4049:     moveq   #80,D0
02:0003B562 19400029        	  4050:     move.b  D0,($0029,A4)
                            	  4051:     even
                            	  4052: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4053:     ; If state <> 2 (so, it's 3), then return.
                            	  4054:     ;
                            	  4055:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4056:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4057:     ; was set to, and we'll return.
                            	  4058:     ;
02:0003B566 0C000002        	  4059:     cmpi.b  #$02,D0
02:0003B56A 6634            	  4060:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4061:     ; State = 2.
                            	  4062:     ;
                            	  4063:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4064:     ;
02:0003B56C 102C0029        	  4065:     move.b  ($0029,A4),D0
02:0003B570 660A            	  4066:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4067:     ; Else go to state 3, and unhalt Link.
                            	  4068:     ;
02:0003B572 522C00AD        	  4069:     addq.b  #1,($00AD,A4)
02:0003B576 7000            	  4070:     moveq   #0,D0
02:0003B578 194000AC        	  4071:     move.b  D0,($00AC,A4)
                            	  4072:     even
                            	  4073: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4074:     ; TODO: but why, since Link is halted?
