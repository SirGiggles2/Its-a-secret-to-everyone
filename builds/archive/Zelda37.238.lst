                            	  5836: CalcBoomerangFrame:
                            	  5837:     ; The minor state (low 3 bits of state) is used to
                            	  5838:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5839:     ;
                            	  5840:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5841:     ; In other words, don't offset the coordinate below.
                            	  5842:     ;
02:0004C6B6 7000            	  5843:     moveq   #0,D0
02:0004C6B8 1880            	  5844:     move.b  D0,($0000,A4)
02:0004C6BA 41EC00AC        	  5845:     lea     ($00AC,A4),A0
02:0004C6BE 10302000        	  5846:     move.b  (A0,D2.W),D0
02:0004C6C2 0200000F        	  5847:     andi.b #$0F,D0
02:0004C6C6 7600            	  5848:     moveq   #0,D3
02:0004C6C8 1600            	  5849:     move.b  D0,D3
02:0004C6CA 7000            	  5850:     moveq   #0,D0
02:0004C6CC 19400001        	  5851:     move.b  D0,($0001,A4)
02:0004C6D0 41F90004C2BE    	  5852:     lea     (BoomerangFrameCycle).l,A0
02:0004C6D6 10303000        	  5853:     move.b  (A0,D3.W),D0
02:0004C6DA 1940000C        	  5854:     move.b  D0,($000C,A4)
                            	  5855:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5856:     ;
02:0004C6DE 1003            	  5857:     move.b  D3,D0
02:0004C6E0 41F90004C2C8    	  5858:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C6E6 10303000        	  5859:     move.b  (A0,D3.W),D0
02:0004C6EA 19400004        	  5860:     move.b  D0,($0004,A4)
                            	  5861:     ; TODO: ?
                            	  5862:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5863:     ; Else add the item value of the magic boomerang.
                            	  5864:     ;
                            	  5865:     ; But none of the values in the base sprite attributes array is 8.
                            	  5866:     ;
                            	  5867:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5868:     ; the inventory will always be added to the base sprite attribute.
                            	  5869:     ;
                            	  5870:     ; So, palette row 4 or 5 will be chosen.
                            	  5871:     ;
02:0004C6EE 7600            	  5872:     moveq   #0,D3
02:0004C6F0 0C000008        	  5873:     cmpi.b  #$08,D0
02:0004C6F4 6706            	  5874:     beq  _anon_z07_31
02:0004C6F6 7600            	  5875:     moveq   #0,D3
02:0004C6F8 162C0675        	  5876:     move.b  ($0675,A4),D3
