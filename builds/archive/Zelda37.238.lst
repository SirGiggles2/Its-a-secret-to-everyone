02:0004CC2A 9101            	  6590:     subx.b  D1,D0   ; SBC ObjY,X
02:0004CC2C 0A3C0010        	  6591:     eori    #$10,CCR  ; restore X = 6502 C
02:0004CC30 4EB900030EB2    	  6592:     jsr     Abs
