02:0002E6C8 1880            	   782:     move.b  D0,($0000,A4)
02:0002E6CA 5203            	   783:     addq.b  #1,D3
02:0002E6CC 41F90002DCF4    	   784:     lea     (PersonTextAddrs).l,A0
02:0002E6D2 10303000        	   785:     move.b  (A0,D3.W),D0
02:0002E6D6 19400001        	   786:     move.b  D0,($0001,A4)
                            	   787:     ; Load the person text current character index.
                            	   788:     ;
02:0002E6DA 7600            	   789:     moveq   #0,D3
02:0002E6DC 162C0416        	   790:     move.b  ($0416,A4),D3
                            	   791:     ; Increment the index variable to point to the next character
                            	   792:     ; for next time.
                            	   793:     ;
02:0002E6E0 522C0416        	   794:     addq.b  #1,($0416,A4)
                            	   795:     ; Get the current character.
                            	   796:     ;
02:0002E6E4 1214            	   797:     move.b  ($00,A4),D1   ; ptr lo
02:0002E6E6 182C0001        	   798:     move.b  ($01,A4),D4  ; ptr hi
02:0002E6EA 024100FF        	   799:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E6EE E14C            	   800:     lsl.w   #8,D4
02:0002E6F0 8841            	   801:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E6F2 48C4            	   802:     ext.l   D4
02:0002E6F4 D8BC00FF0000    	   803:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E6FA 2044            	   804:     movea.l D4,A0
02:0002E6FC 10303000        	   805:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   806:     ; If the character is $25, then it's a special space. It will still
                            	   807:     ; take up space, but will not take time to show -- meaning that
                            	   808:     ; we'll go look up the next character to transfer.
                            	   809:     ;
02:0002E700 0200003F        	   810:     andi.b #$3F,D0
02:0002E704 0C000025        	   811:     cmpi.b  #$25,D0
02:0002E708 67A2            	   812:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   813:     ; We have a non-space character. Put it in the transfer record.
