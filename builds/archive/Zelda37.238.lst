                            	  2685: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2686:     ; Set state 1 to jump.
                            	  2687:     ;
02:0003ABBC 41EC00AC        	  2688:     lea     ($00AC,A4),A0
02:0003ABC0 52302000        	  2689:     addq.b  #1,(A0,D2.W)
