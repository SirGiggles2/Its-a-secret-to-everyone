                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:0003385A 4EB90004AA3C    	   518:     jsr     TurnOffAllVideo
02:00033860 7000            	   519:     moveq   #0,D0
02:00033862 19400016        	   520:     move.b  D0,($0016,A4)
02:00033866 6100D23C        	   521:     jsr     FetchFileAAddressSet
02:0003386A 7602            	   522:     moveq   #2,D3
                            	   523:     even
                            	   524: _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot:
02:0003386C 122C0006        	   525:     move.b  ($06,A4),D1   ; ptr lo
02:00033870 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:00033874 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033878 E14C            	   528:     lsl.w   #8,D4
02:0003387A 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003387C 48C4            	   530:     ext.l   D4
02:0003387E D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033884 2044            	   532:     movea.l D4,A0
02:00033886 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003388A 41EC0633        	   534:     lea     ($0633,A4),A0
02:0003388E 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033892 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:00033894 1003            	   537:     move.b  D3,D0
02:00033896 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00033898 19430016        	   539:     move.b  D3,($0016,A4)
02:0003389C 6100D206        	   540:     jsr     FetchFileAAddressSet
02:000338A0 61001C3C        	   541:     jsr     FormatFileA
02:000338A4 7000            	   542:     moveq   #0,D0
02:000338A6 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:000338AA 6100D1F8        	   550:     jsr     FetchFileAAddressSet
02:000338AE 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:000338B0 7600            	   552:     moveq   #0,D3
02:000338B2 1600            	   553:     move.b  D0,D3
                            	   554:     even
                            	   555: _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot:
02:000338B4 122C000A        	   556:     move.b  ($0A,A4),D1   ; ptr lo
02:000338B8 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:000338BC 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000338C0 E14C            	   559:     lsl.w   #8,D4
