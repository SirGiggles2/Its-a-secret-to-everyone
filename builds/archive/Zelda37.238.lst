                            	  6116:     ; The weapon is the sword.
                            	  6117:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6118:     ;
02:0004C8D6 023C00EE        	  6119:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C8DA 122C0657        	  6120:     move.b  ($0657,A4),D1
