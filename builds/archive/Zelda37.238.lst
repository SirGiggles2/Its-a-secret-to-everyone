02:0003D35A 41EC0405        	  8103:     lea     ($0405,A4),A0
02:0003D35E 10302000        	  8104:     move.b  (A0,D2.W),D0
02:0003D362 678A            	  8105:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8106:     ; But once it has died, then let Link move again.
                            	  8107:     ;
