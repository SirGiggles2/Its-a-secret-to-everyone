02:0003C4EE 52302000        	  6189:     addq.b  #1,(A0,D2.W)
02:0003C4F2 41EC0478        	  6190:     lea     ($0478,A4),A0
02:0003C4F6 10302000        	  6191:     move.b  (A0,D2.W),D0
02:0003C4FA 0C000004        	  6192:     cmpi.b  #$04,D0
02:0003C4FE 659E            	  6193:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6194:     ; Restore the original coordinates.
                            	  6195:     ;
