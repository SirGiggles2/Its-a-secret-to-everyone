02:0003D19A 12302000        	  7905:     move.b  (A0,D2.W),D1
02:0003D19E B001            	  7906:     cmp.b   D1,D0
02:0003D1A0 65000096        	  7907:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7908:     ; Else reached the destination. Go to state 0.
