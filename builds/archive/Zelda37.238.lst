02:00030628 102C0084        	  2968:     move.b  ($0084,A4),D0
02:0003062C 003C0011        	  2969:     ori     #$11,CCR  ; SEC: set C+X
02:00030630 41EC0084        	  2970:     lea     ($0084,A4),A0
02:00030634 12302000        	  2971:     move.b  (A0,D2.W),D1
02:00030638 0A3C0010        	  2972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003063C 9101            	  2973:     subx.b  D1,D0   ; SBC ObjY,X
02:0003063E 0A3C0010        	  2974:     eori    #$10,CCR  ; restore X = 6502 C
02:00030642 6100086E        	  2975:     jsr     Abs
02:00030646 0C00000E        	  2976:     cmpi.b  #$0E,D0
02:0003064A 644C            	  2977:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2978:     ; Determine the horizontal direction toward Link;
                            	  2979:     ; and if Link and the trap are at the same X, then we can't move
                            	  2980:     ; along this axis. Go see about moving vertically.
                            	  2981:     ;
02:0003064C 7601            	  2982:     moveq   #1,D3
02:0003064E 102C0070        	  2983:     move.b  ($0070,A4),D0
02:00030652 12342070        	  2984:     move.b  ($70,A4,D2.W),D1
02:00030656 B001            	  2985:     cmp.b   D1,D0
02:00030658 673E            	  2986:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003065A 6402            	  2987:     bcc  _anon_z01_26
02:0003065C 7602            	  2988:     moveq   #2,D3
                            	  2989: _anon_z01_26:
                            	  2990:     ; Remember the original X coordinate.
                            	  2991:     ;
02:0003065E 10342070        	  2992:     move.b  ($70,A4,D2.W),D0
                            	  2993:     even
                            	  2994: _L_z01_UpdateTrap_Full_GoToState1:
02:00030662 41EC0380        	  2995:     lea     ($0380,A4),A0
02:00030666 11802000        	  2996:     move.b  D0,(A0,D2.W)
                            	  2997:     ; Set facing direction to the horizontal one that we determined.
                            	  2998:     ;
02:0003066A 1003            	  2999:     move.b  D3,D0
02:0003066C 41EC0098        	  3000:     lea     ($0098,A4),A0
02:00030670 11802000        	  3001:     move.b  D0,(A0,D2.W)
                            	  3002:     ; If the direction we determined is not allowed for this trap, then
                            	  3003:     ; go draw and check collisions.
                            	  3004:     ;
02:00030674 41F900030615    	  3005:     lea     (TrapAllowedDirs-1).l,A0
02:0003067A 12302000        	  3006:     move.b  (A0,D2.W),D1
02:0003067E C001            	  3007:     and.b  D1,D0
02:00030680 6712            	  3008:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3009:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  3010:     ;
02:00030682 41EC00AC        	  3011:     lea     ($00AC,A4),A0
02:00030686 52302000        	  3012:     addq.b  #1,(A0,D2.W)
02:0003068A 7070            	  3013:     moveq   #112,D0
02:0003068C 41EC03BC        	  3014:     lea     ($03BC,A4),A0
02:00030690 11802000        	  3015:     move.b  D0,(A0,D2.W)
                            	  3016:     even
                            	  3017: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:00030694 60000102        	  3018:     jmp     L_Trap_DrawAndCheckCollisions
                            	  3019: 
                            	  3020:     even
                            	  3021: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3022:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3023:     ; then this trap definitely wasn't triggered.
                            	  3024:     ; Go draw and check collisions.
                            	  3025:     ;
02:00030698 102C0070        	  3026:     move.b  ($0070,A4),D0
02:0003069C 003C0011        	  3027:     ori     #$11,CCR  ; SEC: set C+X
02:000306A0 12342070        	  3028:     move.b  ($70,A4,D2.W),D1
02:000306A4 0A3C0010        	  3029:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000306A8 9101            	  3030:     subx.b  D1,D0   ; SBC ObjX,X
02:000306AA 0A3C0010        	  3031:     eori    #$10,CCR  ; restore X = 6502 C
02:000306AE 61000802        	  3032:     jsr     Abs
02:000306B2 0C00000E        	  3033:     cmpi.b  #$0E,D0
02:000306B6 64DC            	  3034:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3035:     ; Determine the vertical direction toward Link;
                            	  3036:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3037:     ; along this axis. Go draw and check object collisions.
                            	  3038:     ;
02:000306B8 7604            	  3039:     moveq   #4,D3
02:000306BA 102C0084        	  3040:     move.b  ($0084,A4),D0
02:000306BE 41EC0084        	  3041:     lea     ($0084,A4),A0
02:000306C2 12302000        	  3042:     move.b  (A0,D2.W),D1
02:000306C6 B001            	  3043:     cmp.b   D1,D0
02:000306C8 67CA            	  3044:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000306CA 6402            	  3045:     bcc  _anon_z01_27
02:000306CC 7608            	  3046:     moveq   #8,D3
                            	  3047: _anon_z01_27:
                            	  3048:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3049:     ; set the vertical direction we determined, and other preparations.
                            	  3050:     ;
02:000306CE 41EC0084        	  3051:     lea     ($0084,A4),A0
02:000306D2 10302000        	  3052:     move.b  (A0,D2.W),D0
02:000306D6 668A            	  3053:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3054:     even
                            	  3055: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3056:     ; State 1 and 2.
                            	  3057:     ;
                            	  3058:     ; Move in the direction it's facing.
                            	  3059:     ;
02:000306D8 41EC0098        	  3060:     lea     ($0098,A4),A0
02:000306DC 10302000        	  3061:     move.b  (A0,D2.W),D0
02:000306E0 1940000F        	  3062:     move.b  D0,($000F,A4)
02:000306E4 4EB90004BAAC    	  3063:     jsr     MoveObject
                            	  3064:     ; Truncate the grid offset to square length ($10).
                            	  3065:     ;
02:000306EA 41EC0394        	  3066:     lea     ($0394,A4),A0
02:000306EE 10302000        	  3067:     move.b  (A0,D2.W),D0
02:000306F2 0200000F        	  3068:     andi.b #$0F,D0
02:000306F6 6608            	  3069:     bne  _anon_z01_28
02:000306F8 41EC0394        	  3070:     lea     ($0394,A4),A0
02:000306FC 11802000        	  3071:     move.b  D0,(A0,D2.W)
                            	  3072: _anon_z01_28:
