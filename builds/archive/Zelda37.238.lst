02:0004C530 10342070        	  5628:     move.b  ($70,A4,D2.W),D0
02:0004C534 0C000002        	  5629:     cmpi.b  #$02,D0
02:0004C538 650E            	  5630:     bcs  _L_z07_CheckState30_SetState40
                            	  5631:     even
