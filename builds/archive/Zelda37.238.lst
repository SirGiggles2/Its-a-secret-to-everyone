02:0003D1B2 11802000        	  7916:     move.b  D0,(A0,D2.W)
02:0003D1B6 41EC0412        	  7917:     lea     ($0412,A4),A0
02:0003D1BA 11802000        	  7918:     move.b  D0,(A0,D2.W)
                            	  7919:     ; Choose a random direction to face in.
                            	  7920:     ;
02:0003D1BE 10342018        	  7921:     move.b  ($18,A4,D2.W),D0
02:0003D1C2 02000003        	  7922:     andi.b #$03,D0
02:0003D1C6 7600            	  7923:     moveq   #0,D3
02:0003D1C8 1600            	  7924:     move.b  D0,D3
02:0003D1CA 41F90003CFDA    	  7925:     lea     (PolsVoiceDirections).l,A0
02:0003D1D0 10303000        	  7926:     move.b  (A0,D3.W),D0
02:0003D1D4 41EC0098        	  7927:     lea     ($0098,A4),A0
02:0003D1D8 11802000        	  7928:     move.b  D0,(A0,D2.W)
                            	  7929:     ; Randomly set distance-to-move to $30 or $70.
