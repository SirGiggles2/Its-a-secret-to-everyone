                            	  3342: _L_z05_CheckSubroom_InCave:
                            	  3343:     ; In a cave.
                            	  3344:     ;
                            	  3345:     ; Check whether a person is blocking the upper half of the room.
                            	  3346:     ;
02:00041C94 1B00            	  3347:     move.b  D0,-(A5)  ; PHA
02:00041C96 4EB900030B30    	  3348:     jsr     CheckPersonBlocking
02:00041C9C 101D            	  3349:     move.b  (A5)+,D0  ; PLA
                            	  3350:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3351:     ;
02:00041C9E 0C00000C        	  3352:     cmpi.b  #$0C,D0
02:00041CA2 6704            	  3353:     beq.s  __far_z_05_0059
02:00041CA4 60000082        	  3354:     jmp  CheckCaveEdge
                            	  3355: __far_z_05_0059:
                            	  3356:     ; In a shortcut cave (mode $C).
                            	  3357:     ;
                            	  3358:     ; If grid offset <> 0, return.
