                            	  4885:     ;
                            	  4886:     ; Call this only to get reverse direction index.
02:0004C020 4EB900030EAE    	  4887:     jsr     GetOppositeDir
02:0004C026 102C0015        	  4888:     move.b  ($0015,A4),D0
02:0004C02A 02000003        	  4889:     andi.b #$03,D0
02:0004C02E 41F90004C2EA    	  4890:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004C034 12303000        	  4891:     move.b  (A0,D3.W),D1
02:0004C038 8001            	  4892:     or.b  D1,D0
02:0004C03A 4EB900031CF6    	  4893:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4894:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4895:     ;
02:0004C040 41F90004C2E6    	  4896:     lea     (RDirectionToWeaponFrame).l,A0
02:0004C046 10303000        	  4897:     move.b  (A0,D3.W),D0
02:0004C04A 1940000C        	  4898:     move.b  D0,($000C,A4)
                            	  4899:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4900:     ;
02:0004C04E 0C030002        	  4901:     cmpi.b  #$02,D3
02:0004C052 6604            	  4902:     bne  _anon_z07_24
02:0004C054 522C000F        	  4903:     addq.b  #1,($000F,A4)
                            	  4904: _anon_z07_24:
                            	  4905:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4906:     ;   $57 (sword shot) => $22
