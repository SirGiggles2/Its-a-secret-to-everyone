                            	 12490: __far_z_04_0126:
                            	 12491:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12492:     ; Collisions were checked already.
                            	 12493:     ;
                            	 12494:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12495:     ; in anticipation of moving around when timer becomes 0 next frame.
