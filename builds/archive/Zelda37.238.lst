                            	  5661: _L_z07_CheckState30_CheckOtherStates:
                            	  5662:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5663:     ;
                            	  5664:     ; The boomerang will now return. Reset the grid offset.
                            	  5665:     ;
02:0004C560 7000            	  5666:     moveq   #0,D0
02:0004C562 41EC0394        	  5667:     lea     ($0394,A4),A0
02:0004C566 11802000        	  5668:     move.b  D0,(A0,D2.W)
                            	  5669:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5670:     ;
02:0004C56A 0C02000D        	  5671:     cmpi.b  #$0D,D2
02:0004C56E 6408            	  5672:     bcc  _anon_z07_30
02:0004C570 41EC042C        	  5673:     lea     ($042C,A4),A0
02:0004C574 10302000        	  5674:     move.b  (A0,D2.W),D0
                            	  5675: _anon_z07_30:
02:0004C578 4EB900030F06    	  5676:     jsr     GetDirectionsAndDistancesToTarget
                            	  5677:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5678:     ; then go move towards the thrower, draw, and check collisions.
                            	  5679:     ;
02:0004C57E 1014            	  5680:     move.b  ($0000,A4),D0
02:0004C580 0C000002        	  5681:     cmpi.b  #$02,D0
02:0004C584 666A            	  5682:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5683:     ; The boomerang has reached the thrower.
                            	  5684:     ;
                            	  5685:     ; Reset the distance to move.
                            	  5686:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5687:     ;
02:0004C586 7000            	  5688:     moveq   #0,D0
02:0004C588 41EC0380        	  5689:     lea     ($0380,A4),A0
02:0004C58C 11802000        	  5690:     move.b  D0,(A0,D2.W)
02:0004C590 0C02000D        	  5691:     cmpi.b  #$0D,D2
02:0004C594 6524            	  5692:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5693:     ; Link has caught the boomerang.
                            	  5694:     ;
                            	  5695:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5696:     ;
                            	  5697:     ; If Link catches it some time after throwing it,
                            	  5698:     ; his state will become $20, and he will show the catch animation.
                            	  5699:     ;
                            	  5700:     ; But if he catches it right after throwing it, the state becomes
                            	  5701:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5702:     ;
02:0004C596 102C00AC        	  5703:     move.b  ($00AC,A4),D0
02:0004C59A 00000020        	  5704:     ori.b #$20,D0
02:0004C59E 194000AC        	  5705:     move.b  D0,($00AC,A4)
                            	  5706:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5707:     ; up the new state.
                            	  5708:     ;
02:0004C5A2 7001            	  5709:     moveq   #1,D0
02:0004C5A4 194003D0        	  5710:     move.b  D0,($03D0,A4)
                            	  5711:     ; Deactivate the boomerang.
                            	  5712:     ;
02:0004C5A8 760F            	  5713:     moveq   #15,D3
02:0004C5AA 7000            	  5714:     moveq   #0,D0
02:0004C5AC 41EC00AC        	  5715:     lea     ($00AC,A4),A0
02:0004C5B0 11803000        	  5716:     move.b  D0,(A0,D3.W)
02:0004C5B4 0A3C0001        	  5717:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C5B8 4E75            	  5718:     rts
                            	  5719: 
                            	  5720:     even
