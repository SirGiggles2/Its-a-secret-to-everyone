02:0003510C 41EC0201        	  2699:     lea     ($0201,A4),A0
02:00035110 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:00035114 5303            	  2701:     subq.b  #1,D3
02:00035116 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00035118 7600            	  2703:     moveq   #0,D3
02:0003511A 162C0016        	  2704:     move.b  ($0016,A4),D3
02:0003511E 41F900034980    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:00035124 10303000        	  2706:     move.b  (A0,D3.W),D0
02:00035128 19400084        	  2707:     move.b  D0,($0084,A4)
02:0003512C 19400200        	  2708:     move.b  D0,($0200,A4)
02:00035130 102C0012        	  2709:     move.b  ($0012,A4),D0
02:00035134 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00035138 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
