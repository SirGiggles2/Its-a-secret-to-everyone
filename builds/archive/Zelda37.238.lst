02:0003B34C 41EC0098        	  3706:     lea     ($0098,A4),A0
02:0003B350 10302000        	  3707:     move.b  (A0,D2.W),D0
02:0003B354 02000002        	  3708:     andi.b #$02,D0
02:0003B358 6704            	  3709:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3710:     even
