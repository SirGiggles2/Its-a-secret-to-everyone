                            	  4755:     ; The effect involves turning grayscale rendering on and off
                            	  4756:     ; in PPUMASK.
                            	  4757:     ;
                            	  4758:     ; Start by setting A register to the PPU mask shifted right to
                            	  4759:     ; throw away the grayscale bit.
                            	  4760:     ;
02:000311C0 102C00FE        	  4761:     move.b  ($00FE,A4),D0
02:000311C4 E208            	  4762:     lsr.b  #1,D0   ; LSR A
                            	  4763:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4764:     ;
02:000311C6 7600            	  4765:     moveq   #0,D3
02:000311C8 16342028        	  4766:     move.b  ($28,A4,D2.W),D3
                            	  4767:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4768:     ; Carry will have been set, because of the comparison (CPY).
                            	  4769:     ;
