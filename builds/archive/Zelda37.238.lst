                            	 12157: __far_z_04_0120:
                            	 12158:     ; State = 0.
                            	 12159:     ;
                            	 12160:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12161:     ; This is the only patra child shown in the first fame.
                            	 12162:     ;
02:0003F164 0C020002        	 12163:     cmpi.b  #$02,D2
02:0003F168 6732            	 12164:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12165:     ; The patra child in slot 2 is the last one to be updated.
                            	 12166:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12167:     ;
                            	 12168:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12169:     ; shown.
                            	 12170:     ;
02:0003F16A 102C00AE        	 12171:     move.b  ($00AE,A4),D0
02:0003F16E 6700008E        	 12172:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12173:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12174:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12175:     ;
02:0003F172 1002            	 12176:     move.b  D2,D0
                            	 12177:     ; Subtract 3 from the object slot to get the angle where the
                            	 12178:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12179:     ;
02:0003F174 003C0011        	 12180:     ori     #$11,CCR  ; SEC: set C+X
