02:0002B5B0 04400010        	  3487:     subi.w  #$10,D0                 ; entry-0: remap 16→0, 20→4, 24→8, 28→12
02:0002B5B4 6026            	  3488:     bra.s   .ttf_pal_bg
                            	  3489: .ttf_pal_spr:
                            	  3490:     ifne CHR_EXPANSION_ENABLED
                            	  3491:     ; T-CHR S8 v2: pack sprite sub-palettes into unused tail slots of BG
                            	  3492:     ; palettes (PAL0[4..15] + PAL1[4..7]).  See .t19_spr_cram_base for the
                            	  3493:     ; mapping table.  Using an inline table to avoid cross-scope lea.
