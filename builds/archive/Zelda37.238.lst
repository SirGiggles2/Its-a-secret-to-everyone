                            	  5549: HandleArrowOrBoomerangBlocked:
                            	  5550:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5551:     ;
02:0004C4A2 7003            	  5552:     moveq   #3,D0
02:0004C4A4 41EC03D0        	  5553:     lea     ($03D0,A4),A0
02:0004C4A8 11802000        	  5554:     move.b  D0,(A0,D2.W)
                            	  5555:     ; Add $10 to the state to make it $2x.
                            	  5556:     ;
02:0004C4AC 41EC00AC        	  5557:     lea     ($00AC,A4),A0
