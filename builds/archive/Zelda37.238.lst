02:000351D2 9101            	  2790:     subx.b  D1,D0   ; SBC #$08
02:000351D4 0A3C0010        	  2791:     eori    #$10,CCR  ; restore X = 6502 C
02:000351D8 7600            	  2792:     moveq   #0,D3
02:000351DA 1600            	  2793:     move.b  D0,D3
