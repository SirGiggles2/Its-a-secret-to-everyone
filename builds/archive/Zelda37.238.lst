02:0003ED56 60F2            	 11588:     jmp  L129EA_Exit
                            	 11589: __far_z_04_0114:
                            	 11590:     ; If we have the magic clock, then go draw and check collisions.
                            	 11591:     ;
02:0003ED58 102C066C        	 11592:     move.b  ($066C,A4),D0
02:0003ED5C 6614            	 11593:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
02:0003ED5E 6100027C        	 11594:     jsr     Lamnola_Move
                            	 11595:     ; If the current segment is a head, then update the direction it's facing.
