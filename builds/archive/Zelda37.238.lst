02:0003BDB8 7032            	  5194:     moveq   #50,D0
                            	  5195: _anon_z04_70:
                            	  5196:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5197:     ; 1. negate the distance
                            	  5198:     ; 2. add 8 to the instruction offset to access
                            	  5199:     ;    the opposite direction for the same wall
                            	  5200:     ;
02:0003BDBA 7600            	  5201:     moveq   #0,D3
02:0003BDBC 162C0098        	  5202:     move.b  ($0098,A4),D3
02:0003BDC0 122C0002        	  5203:     move.b  ($0002,A4),D1
02:0003BDC4 B601            	  5204:     cmp.b   D1,D3
02:0003BDC6 662A            	  5205:     bne  _anon_z04_71
02:0003BDC8 1B00            	  5206:     move.b  D0,-(A5)  ; PHA
02:0003BDCA 41EC0412        	  5207:     lea     ($0412,A4),A0
02:0003BDCE 10302000        	  5208:     move.b  (A0,D2.W),D0
02:0003BDD2 023C00EE        	  5209:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDD6 123C0008        	  5210:     move.b  #$08,D1
02:0003BDDA D101            	  5211:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BDDC 41EC0412        	  5212:     lea     ($0412,A4),A0
02:0003BDE0 11802000        	  5213:     move.b  D0,(A0,D2.W)
02:0003BDE4 101D            	  5214:     move.b  (A5)+,D0  ; PLA
02:0003BDE6 4600            	  5215:     eori.b #$FF,D0
02:0003BDE8 023C00EE        	  5216:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDEC 123C0001        	  5217:     move.b  #$01,D1
02:0003BDF0 D101            	  5218:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5219: _anon_z04_71:
                            	  5220:     ; Add the distance and Link's minor coordinate to calculate
                            	  5221:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5222:     ; In general, the monster will be put in front of Link.
                            	  5223:     ;
02:0003BDF2 023C00EE        	  5224:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDF6 1214            	  5225:     move.b  ($0000,A4),D1
02:0003BDF8 D101            	  5226:     addx.b  D1,D0   ; ADC $00
02:0003BDFA 19400004        	  5227:     move.b  D0,($0004,A4)
                            	  5228:     ; By default, will return index 0 to choose the minimum value
                            	  5229:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5230:     ; if Link is at the wall with a smaller major coordinate.
                            	  5231:     ;
02:0003BDFE 7600            	  5232:     moveq   #0,D3
                            	  5233:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5234:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5235:     ; to access the block for the other direction along the same axis,
                            	  5236:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5237:     ;
02:0003BE00 102C0001        	  5238:     move.b  ($0001,A4),D0
02:0003BE04 122C0003        	  5239:     move.b  ($0003,A4),D1
02:0003BE08 B001            	  5240:     cmp.b   D1,D0
02:0003BE0A 671C            	  5241:     beq  _anon_z04_72
02:0003BE0C 41EC0412        	  5242:     lea     ($0412,A4),A0
02:0003BE10 10302000        	  5243:     move.b  (A0,D2.W),D0
02:0003BE14 023C00EE        	  5244:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE18 123C0010        	  5245:     move.b  #$10,D1
02:0003BE1C D101            	  5246:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BE1E 41EC0412        	  5247:     lea     ($0412,A4),A0
02:0003BE22 11802000        	  5248:     move.b  D0,(A0,D2.W)
02:0003BE26 5203            	  5249:     addq.b  #1,D3
                            	  5250: _anon_z04_72:
