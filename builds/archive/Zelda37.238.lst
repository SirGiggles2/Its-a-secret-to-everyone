02:0003E00A 61001CD4        	  9813:     jsr     ReverseObjDir8
02:0003E00E 41EC045E        	  9814:     lea     ($045E,A4),A0
02:0003E012 10302000        	  9815:     move.b  (A0,D2.W),D0
02:0003E016 41EC045E        	  9816:     lea     ($045E,A4),A0
02:0003E01A 52302000        	  9817:     addq.b  #1,(A0,D2.W)
                            	  9818:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9819:     ; should randomly change direction.
                            	  9820:     ;
02:0003E01E E208            	  9821:     lsr.b  #1,D0   ; LSR A
02:0003E020 640A            	  9822:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003E022 7000            	  9823:     moveq   #0,D0
02:0003E024 41EC0451        	  9824:     lea     ($0451,A4),A0
02:0003E028 11802000        	  9825:     move.b  D0,(A0,D2.W)
                            	  9826:     even
                            	  9827: _L_z04_UpdateGohma_AnimateEye:
                            	  9828:     ; Animate the eye.
                            	  9829:     ;
                            	  9830:     ; First, if the counter for when to open the eye next = 0, then
                            	  9831:     ; set it to a random value at least $C0; and set the timer for
                            	  9832:     ; keeping the eye open to $80.
                            	  9833:     ;
                            	  9834:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9835:     ; every other frame.
                            	  9836:     ;
02:0003E02C 41EC042C        	  9837:     lea     ($042C,A4),A0
02:0003E030 10302000        	  9838:     move.b  (A0,D2.W),D0
02:0003E034 661E            	  9839:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
