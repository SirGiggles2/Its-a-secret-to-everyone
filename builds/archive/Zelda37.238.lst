                            	  3290:     ;
02:00041C26 7606            	  3291:     moveq   #6,D3
02:00041C28 102C00EB        	  3292:     move.b  ($00EB,A4),D0
02:00041C2C 1B00            	  3293:     move.b  D0,-(A5)  ; PHA
                            	  3294: _anon_z05_81:
02:00041C2E 5303            	  3295:     subq.b  #1,D3
02:00041C30 41F900FF6BB2    	  3296:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C36 12303000        	  3297:     move.b  (A0,D3.W),D1
02:00041C3A B001            	  3298:     cmp.b   D1,D0
02:00041C3C 66F0            	  3299:     bne  _anon_z05_81
                            	  3300:     ; Determine the destination room ID, and go there.
                            	  3301:     ;
                            	  3302:     ; If Link's X < $80 look in level block attributes A, else B.
                            	  3303:     ;
