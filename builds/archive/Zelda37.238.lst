02:0003C502 41EC0084        	  6197:     lea     ($0084,A4),A0
02:0003C506 11802000        	  6198:     move.b  D0,(A0,D2.W)
02:0003C50A 101D            	  6199:     move.b  (A5)+,D0  ; PLA
02:0003C50C 19802070        	  6200:     move.b  D0,($70,A4,D2.W)
