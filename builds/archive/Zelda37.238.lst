                            	  3761: FormatHeartsInTextBuf:
                            	  3762:     ; [$0E]: hearts value
                            	  3763:     ; [$0F]: heart partial
                            	  3764:     ; Y: The offset of first character in buffer
                            	  3765:     ;
                            	  3766:     ; The end of the bottom row is $12 bytes after the
                            	  3767:     ; start of the top row. We're writing to two transfer
                            	  3768:     ; records. We write the top row in the first transfer
                            	  3769:     ; record wherever the caller chooses. The second
                            	  3770:     ; transfer record has to begin with the heart tiles.
                            	  3771:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3772:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3773:     ;
                            	  3774:     ; Store the starting offset in [$0D].
02:00030B6E 1943000D        	  3775:     move.b  D3,($000D,A4)
02:00030B72 102C000E        	  3776:     move.b  ($000E,A4),D0
02:00030B76 1B00            	  3777:     move.b  D0,-(A5)  ; PHA
02:00030B78 0200000F        	  3778:     andi.b #$0F,D0
02:00030B7C 1880            	  3779:     move.b  D0,($0000,A4)
02:00030B7E 700F            	  3780:     moveq   #15,D0
02:00030B80 003C0011        	  3781:     ori     #$11,CCR  ; SEC: set C+X
02:00030B84 1214            	  3782:     move.b  ($0000,A4),D1
02:00030B86 0A3C0010        	  3783:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B8A 9101            	  3784:     subx.b  D1,D0   ; SBC $00
02:00030B8C 0A3C0010        	  3785:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B90 1880            	  3786:     move.b  D0,($0000,A4)
02:00030B92 101D            	  3787:     move.b  (A5)+,D0  ; PLA
02:00030B94 E208            	  3788:     lsr.b  #1,D0   ; LSR A
02:00030B96 E208            	  3789:     lsr.b  #1,D0   ; LSR A
02:00030B98 E208            	  3790:     lsr.b  #1,D0   ; LSR A
02:00030B9A E208            	  3791:     lsr.b  #1,D0   ; LSR A
02:00030B9C 19400001        	  3792:     move.b  D0,($0001,A4)
02:00030BA0 700F            	  3793:     moveq   #15,D0
02:00030BA2 003C0011        	  3794:     ori     #$11,CCR  ; SEC: set C+X
02:00030BA6 122C0001        	  3795:     move.b  ($0001,A4),D1
02:00030BAA 0A3C0010        	  3796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030BAE 9101            	  3797:     subx.b  D1,D0   ; SBC $01
02:00030BB0 0A3C0010        	  3798:     eori    #$10,CCR  ; restore X = 6502 C
02:00030BB4 19400001        	  3799:     move.b  D0,($0001,A4)
                            	  3800:     ; At this point,
                            	  3801:     ; [$00] = $F - hearts
                            	  3802:     ; [$01] = $F - heart containers
                            	  3803:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3804:     ;
                            	  3805:     ; Also, Y is still set to the value passed in.
                            	  3806:     ;
02:00030BB8 7400            	  3807:     moveq   #0,D2
02:00030BBA 1003            	  3808:     move.b  D3,D0
02:00030BBC 023C00EE        	  3809:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030BC0 123C0007        	  3810:     move.b  #$07,D1
02:00030BC4 D101            	  3811:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030BC6 1940000B        	  3812:     move.b  D0,($000B,A4)
                            	  3813:     ; Y keeps track of index of heart in row.
                            	  3814:     ; Start at the end of the first row.
02:00030BCA 7607            	  3815:     moveq   #7,D3
                            	  3816:     even
