02:0003D2D8 41EC03E4        	  8042:     lea     ($03E4,A4),A0
02:0003D2DC 11802000        	  8043:     move.b  D0,(A0,D2.W)
02:0003D2E0 7004            	  8044:     moveq   #4,D0
02:0003D2E2 41EC03D0        	  8045:     lea     ($03D0,A4),A0
02:0003D2E6 11802000        	  8046:     move.b  D0,(A0,D2.W)
                            	  8047:     ; Now Link can't move.
                            	  8048:     ;
02:0003D2EA 522C0512        	  8049:     addq.b  #1,($0512,A4)
                            	  8050:     even
