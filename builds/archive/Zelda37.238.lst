02:0004C4B4 023C00EE        	  5559:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C4B8 123C0010        	  5560:     move.b  #$10,D1
02:0004C4BC D101            	  5561:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C4BE 41EC00AC        	  5562:     lea     ($00AC,A4),A0
02:0004C4C2 11802000        	  5563:     move.b  D0,(A0,D2.W)
                            	  5564:     even
