                            	    10: ;   D0 = 6502 A  (accumulator)
                            	    11: ;   D1 = scratch
                            	    12: ;   D2 = 6502 X  (X index register)
                            	    13: ;   D3 = 6502 Y  (Y index register)
                            	    14: ;   D4,D5 = scratch (used by indirect addressing sequences)
                            	    15: ;   D6 = scratch
                            	    16: ;   D7 = 6502 SP shadow (NES stack pointer, $0100 area)
                            	    17: ;   A4 = NES RAM base ($FF0000) — init by genesis_shell.asm
                            	    18: ;   A5 = NES stack pointer ($FF0200 initially, grows downward)
                            	    19: ;==============================================================================
