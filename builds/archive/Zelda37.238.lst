                            	  4732: _L_z02_UpdateMode13WinGame_Sub0_Flash_AdvanceSubmode:
                            	  4733:     ; Play the ending song.
                            	  4734:     ;
02:0003665C 7010            	  4735:     moveq   #16,D0
02:0003665E 19400600        	  4736:     move.b  D0,($0600,A4)
                            	  4737:     ; Wait $40 frames at the beginning of the next mode
                            	  4738:     ; before showing text.
