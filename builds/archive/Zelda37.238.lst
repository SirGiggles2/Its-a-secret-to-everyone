                            	  3168: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3169:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3170:     ; the mound frame images:
                            	  3171:     ;
                            	  3172:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3173:     ;
                            	  3174:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3175:     ;
                            	  3176:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3177:     ;
02:0003AF68 003C0011        	  3178:     ori     #$11,CCR  ; SEC: set C+X
02:0003AF6C 123C0001        	  3179:     move.b  #$01,D1
02:0003AF70 0A3C0010        	  3180:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AF74 9101            	  3181:     subx.b  D1,D0   ; SBC #$01
02:0003AF76 0A3C0010        	  3182:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AF7A E308            	  3183:     lsl.b  #1,D0   ; ASL A
02:0003AF7C 023C00EE        	  3184:     andi    #$EE,CCR  ; CLC: clear C+X
