                            	  9800: _anon_z04_121:
                            	  9801:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9802:     ;
02:0003DFF2 41EC0412        	  9803:     lea     ($0412,A4),A0
02:0003DFF6 10302000        	  9804:     move.b  (A0,D2.W),D0
02:0003DFFA 0C000020        	  9805:     cmpi.b  #$20,D0
02:0003DFFE 662C            	  9806:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9807:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9808:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9809:     ;
02:0003E000 7000            	  9810:     moveq   #0,D0
02:0003E002 41EC0412        	  9811:     lea     ($0412,A4),A0
