02:0003DFAE 19410002        	  9773:     move.b  D1,($0002,A4)
02:0003DFB2 122C0002        	  9774:     move.b  ($0002,A4),D1
02:0003DFB6 C200            	  9775:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DFB8 6704            	  9776:     beq  _anon_z04_119
02:0003DFBA 53342070        	  9777:     subq.b  #1,($70,A4,D2.W)
