                            	  2116: ;==============================================================================
                            	  2117: ; EXPORT side — carry-returning shims.
                            	  2118: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2119: ; reproduces the original function's carry normalization.
                            	  2120: ;==============================================================================
                            	  2121: 
                            	  2122: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2123: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2124:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2125:     btst    #8,D0
02:0002BF8E 670A            	  2126:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2127:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2128:     eori    #$01,CCR
02:0002BF98 4E75            	  2129:     rts
                            	  2130: .cc_cnr:
02:0002BF9A 023C00FE        	  2131:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2132:     eori    #$01,CCR
02:0002BFA2 4E75            	  2133:     rts
                            	  2134: 
                            	  2135: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2136: c_copy_next_row_advance_submode:
