                            	  4881: _anon_z02_35:
02:000367C2 41F90003673E    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:000367C8 10303000        	  4883:     move.b  (A0,D3.W),D0
02:000367CC 41EC0302        	  4884:     lea     ($0302,A4),A0
02:000367D0 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:000367D4 5303            	  4886:     subq.b  #1,D3
02:000367D6 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:000367D8 7600            	  4891:     moveq   #0,D3
02:000367DA 162C0413        	  4892:     move.b  ($0413,A4),D3
02:000367DE 41F900036778    	  4893:     lea     (PeaceText).l,A0
02:000367E4 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000367E8 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000367EC 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000367EE 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:000367F2 0C000024        	  4901:     cmpi.b  #$24,D0
02:000367F6 6706            	  4902:     beq  _anon_z02_36
02:000367F8 7010            	  4903:     moveq   #16,D0
02:000367FA 19400604        	  4904:     move.b  D0,($0604,A4)
