02:0003D1E0 02000040        	  7932:     andi.b #$40,D0
02:0003D1E4 123C0030        	  7933:     move.b  #$30,D1
02:0003D1E8 D101            	  7934:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D1EA 41EC0394        	  7935:     lea     ($0394,A4),A0
02:0003D1EE 11802000        	  7936:     move.b  D0,(A0,D2.W)
                            	  7937:     ; Align the monster with a square horizontally.
                            	  7938:     ;
                            	  7939:     ; If in the left half of a square, align with that square.
                            	  7940:     ; If in the right half, align with the next square.
                            	  7941:     ;
02:0003D1F2 10342070        	  7942:     move.b  ($70,A4,D2.W),D0
02:0003D1F6 023C00EE        	  7943:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1FA 123C0008        	  7944:     move.b  #$08,D1
02:0003D1FE D101            	  7945:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D200 020000F0        	  7946:     andi.b #$F0,D0
02:0003D204 19802070        	  7947:     move.b  D0,($70,A4,D2.W)
                            	  7948:     ; Align the monster with a square vertically.
                            	  7949:     ;
                            	  7950:     ; If in the top half of a square, align with that square.
                            	  7951:     ; If in the bottom half, align with the next square.
                            	  7952:     ;
02:0003D208 41EC0084        	  7953:     lea     ($0084,A4),A0
02:0003D20C 10302000        	  7954:     move.b  (A0,D2.W),D0
02:0003D210 023C00EE        	  7955:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D214 123C0008        	  7956:     move.b  #$08,D1
02:0003D218 D101            	  7957:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D21A 020000F0        	  7958:     andi.b #$F0,D0
                            	  7959:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7960:     ;
02:0003D21E 003C0011        	  7961:     ori     #$11,CCR  ; SEC: set C+X
02:0003D222 123C0003        	  7962:     move.b  #$03,D1
02:0003D226 0A3C0010        	  7963:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D22A 9101            	  7964:     subx.b  D1,D0   ; SBC #$03
02:0003D22C 0A3C0010        	  7965:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D230 41EC0084        	  7966:     lea     ($0084,A4),A0
02:0003D234 11802000        	  7967:     move.b  D0,(A0,D2.W)
                            	  7968:     even
