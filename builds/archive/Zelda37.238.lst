                            	 12425: 
                            	 12426: ; Description:
                            	 12427: ; Lift up the Triforce of Courage while the room is light.
                            	 12428: ;
                            	 12429: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12430: ;
                            	 12431:     even
                            	 12432: Ganon_ScenePhase1:
