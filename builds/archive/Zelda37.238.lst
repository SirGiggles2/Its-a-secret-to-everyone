                            	  9668: Manhandla_Draw:
02:0003DEE8 4EB90004CE24    	  9669:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9670:     ; Push the "frame image and sprite attributes" value.
                            	  9671:     ;
02:0003DEEE 41EC0478        	  9672:     lea     ($0478,A4),A0
02:0003DEF2 10302000        	  9673:     move.b  (A0,D2.W),D0
02:0003DEF6 1B00            	  9674:     move.b  D0,-(A5)  ; PHA
                            	  9675:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9676:     ; passed along as is.
                            	  9677:     ;
02:0003DEF8 02000080        	  9678:     andi.b #$80,D0
02:0003DEFC 00000001        	  9679:     ori.b #$01,D0
02:0003DF00 4EB900031CF6    	  9680:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DF06 101D            	  9681:     move.b  (A5)+,D0  ; PLA
02:0003DF08 1B00            	  9682:     move.b  D0,-(A5)  ; PHA
                            	  9683:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9684:     ;
02:0003DF0A 02000040        	  9685:     andi.b #$40,D0
02:0003DF0E 6704            	  9686:     beq  _anon_z04_116
02:0003DF10 522C000F        	  9687:     addq.b  #1,($000F,A4)
                            	  9688: _anon_z04_116:
02:0003DF14 101D            	  9689:     move.b  (A5)+,D0  ; PLA
                            	  9690:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9691:     ; These are the 2 frame images of the horizontal hands.
                            	  9692:     ;
                            	  9693:     ; Else draw the base and vertical hands mirrored.
                            	  9694:     ;
02:0003DF16 0200000F        	  9695:     andi.b #$0F,D0
02:0003DF1A 0C000002        	  9696:     cmpi.b  #$02,D0
02:0003DF1E 670C            	  9697:     beq  _anon_z04_117
02:0003DF20 0C000003        	  9698:     cmpi.b  #$03,D0
02:0003DF24 6706            	  9699:     beq  _anon_z04_117
02:0003DF26 4EF900031A00    	  9700:     jmp     DrawObjectMirrored
                            	  9701: 
