02:000437E0 101D            	  5710:     move.b  (A5)+,D0  ; PLA
02:000437E2 1B00            	  5711:     move.b  D0,-(A5)  ; PHA
02:000437E4 0C000002        	  5712:     cmpi.b  #$02,D0
02:000437E8 6406            	  5713:     bcc  _anon_z05_115
02:000437EA 4EB900031302    	  5714:     jsr     Add1ToInt16At0
