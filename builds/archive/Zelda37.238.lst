                            	   765:     ;==========================================================================
                            	   766:     ; NAMETABLE / PALETTE PATH  (PPU_VADDR $2000–$3FFF)
                            	   767:     ;==========================================================================
                            	   768:     ; Word-pair buffering: buffer even-address byte, flush word on odd address.
                            	   769:     ;==========================================================================
                            	   770: .nt_write:
                            	   771:     ;======================================================================
                            	   772:     ; Nametable → Genesis Plane A row mapping:
                            	   773:     ;   NES NT_A tiles ($2000–$23BF, and mirrored $2400–$27BF)
                            	   774:     ;       → Plane A rows 0–29  (VDP $C000–$C5FF)
                            	   775:     ;   NES NT_B tiles ($2800–$2BBF, and mirrored $2C00–$2FBF)
                            	   776:     ;       → Plane A rows 30–59 (VDP $CF00–$D4FF)
                            	   777:     ;
                            	   778:     ; Zelda uses vertical mirroring so NT_A and NT_B are the only two
                            	   779:     ; physical nametables. Story-scroll (intro) writes new rows to NT_B
                            	   780:     ; via $2800+ as the scroll crosses the NT boundary — previously these
                            	   781:     ; writes were dropped, leaving Plane A rows 30..59 stale.
                            	   782:     ;
                            	   783:     ; Each row is 64 tiles × 2 bytes = $80 bytes wide in Plane A.
                            	   784:     ;   vdp_addr = $C000 + row * $80 + col * 2
                            	   785:     ;======================================================================
                            	   786:     ; Fold $2C00 mirror → $2800 (vertical mirroring alias for NT_B).
02:0000E3F8 0C412C00        	   787:     cmpi.w  #$2C00,D1
02:0000E3FC 650A            	   788:     blo.s   .nt_no_b_mirror
02:0000E3FE 0C413000        	   789:     cmpi.w  #$3000,D1
02:0000E402 6404            	   790:     bhs.s   .nt_no_b_mirror
02:0000E404 04410400        	   791:     subi.w  #$0400,D1
                            	   792: .nt_no_b_mirror:
                            	   793:     ; T39 HUD/playfield split (Zelda 4-screen semantics).
                            	   794:     ; Track original source range before folding $2400 → $2000:
                            	   795:     ;   D7 = 0 → source was $2000 (HUD region; rows 0-3 only)
                            	   796:     ;   D7 = 1 → source was $2400 (playfield region; rows 4-29 only)
                            	   797:     ; NES renders HUD from $2000 for scanlines 0-31 and playfield from
                            	   798:     ; $2400 for scanlines 32-239 via a mid-frame scroll split. On Gen we
                            	   799:     ; collapse both into Plane A, so we gate writes to avoid one source
                            	   800:     ; clobbering the other's rows. Overworld only writes $2400 rows 4-29
                            	   801:     ; (so the bug was latent), but cave rooms write $2400 rows 0-29 which
                            	   802:     ; stomped the HUD — see builds/reports/t39_stage_a_render_classification.md.
02:0000E408 7E00            	   803:     moveq   #0,D7
02:0000E40A 0C412400        	   804:     cmpi.w  #$2400,D1
02:0000E40E 6508            	   805:     blo.s   .nt_src_detected
02:0000E410 0C412800        	   806:     cmpi.w  #$2800,D1
02:0000E414 6402            	   807:     bhs.s   .nt_src_detected
02:0000E416 7E01            	   808:     moveq   #1,D7
