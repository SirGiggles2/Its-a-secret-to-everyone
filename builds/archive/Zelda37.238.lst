02:0003D0C6 0C000078        	  7817:     cmpi.b  #$78,D0
02:0003D0CA 6402            	  7818:     bcc  _anon_z04_97
02:0003D0CC 7603            	  7819:     moveq   #3,D3
                            	  7820: _anon_z04_97:
