                            	  7303: DodongoBombNegativeLimits:
02:0003CD54 F4              	  7304:     dc.b    $F4, $F0
02:0003CD55 F0
                            	  7305: 
                            	  7306: ; Params:
                            	  7307: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7308: ; [00]: monster hotspot X
                            	  7309: ; [01]: monster hotspot Y
                            	  7310: ; [02]: bomb hotspot X
                            	  7311: ; [03]: bomb hotspot Y
                            	  7312: ;
                            	  7313: ; Returns:
                            	  7314: ; A: 0 if the bomb is in range of the monster
                            	  7315: ; Z: 1 if the bomb is in range of the monster
                            	  7316: ; [04]: horizontal distance
                            	  7317: ; [05]: vertical distance
                            	  7318: ;
                            	  7319: ; Store the positive limit in [06], and the negative one in [07].
                            	  7320: ;
                            	  7321:     even
                            	  7322: Dodongo_IsBombInRange:
02:0003CD56 41F90003CD52    	  7323:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CD5C 10303000        	  7324:     move.b  (A0,D3.W),D0
02:0003CD60 19400006        	  7325:     move.b  D0,($0006,A4)
02:0003CD64 41F90003CD54    	  7326:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CD6A 10303000        	  7327:     move.b  (A0,D3.W),D0
02:0003CD6E 19400007        	  7328:     move.b  D0,($0007,A4)
                            	  7329:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7330:     ; the bomb is near enough the monster.
                            	  7331:     ;
02:0003CD72 7003            	  7332:     moveq   #3,D0
02:0003CD74 19400008        	  7333:     move.b  D0,($0008,A4)
                            	  7334:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7335:     ;
02:0003CD78 7601            	  7336:     moveq   #1,D3
                            	  7337:     even
                            	  7338: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7339:     ; Subtract the bomb's coordinate from the boss's,
                            	  7340:     ; The loop index determines the coordinate.
                            	  7341:     ;
02:0003CD7A 10343000        	  7342:     move.b  ($00,A4,D3.W),D0
02:0003CD7E 003C0011        	  7343:     ori     #$11,CCR  ; SEC: set C+X
02:0003CD82 12343002        	  7344:     move.b  ($02,A4,D3.W),D1
02:0003CD86 0A3C0010        	  7345:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CD8A 9101            	  7346:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CD8C 0A3C0010        	  7347:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7348:     ; If the distance >= positive offset, or < negative offset;
                            	  7349:     ; then loop again.
                            	  7350:     ;
02:0003CD90 122C0006        	  7351:     move.b  ($0006,A4),D1
02:0003CD94 B001            	  7352:     cmp.b   D1,D0
02:0003CD96 6A16            	  7353:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CD98 122C0007        	  7354:     move.b  ($0007,A4),D1
02:0003CD9C B001            	  7355:     cmp.b   D1,D0
02:0003CD9E 6B0E            	  7356:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7357:     ; The distance is close enough in this axis.
                            	  7358:     ;
                            	  7359:     ; Store the distance in this axis in [05] or [04],
                            	  7360:     ; depending on the loop index.
                            	  7361:     ;
02:0003CDA0 19803004        	  7362:     move.b  D0,($04,A4,D3.W)
                            	  7363:     ; Shift [08] right, because we're in range in this axis.
                            	  7364:     ;
02:0003CDA4 122C0008        	  7365:     move.b  ($0008,A4),D1
02:0003CDA8 E209            	  7366:     lsr.b  #1,D1   ; LSR $08
02:0003CDAA 19410008        	  7367:     move.b  D1,($0008,A4)
                            	  7368:     even
                            	  7369: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CDAE 5303            	  7370:     subq.b  #1,D3
02:0003CDB0 6AC8            	  7371:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7372:     ; If close enough in both axes, then [08] will be 0.
                            	  7373:     ;
02:0003CDB2 102C0008        	  7374:     move.b  ($0008,A4),D0
02:0003CDB6 4E75            	  7375:     rts
                            	  7376: 
                            	  7377: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7378: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7379: ;
                            	  7380: ; But these are not typical direction indexes. Instead a
                            	  7381: ; 5-way index is used.
                            	  7382: ; A direction shifted right once becomes a 5-way index.
                            	  7383: ; The fourth element is unused.
                            	  7384: ;
                            	  7385:     even
                            	  7386: DodongoFrameImages:
02:0003CDB8 00              	  7387:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CDB9 01
02:0003CDBA 06
02:0003CDBB FF
02:0003CDBC 08
02:0003CDBD 02
02:0003CDBE 03
02:0003CDBF 06
02:0003CDC0 FF              	  7388:     dc.b    $FF, $08
02:0003CDC1 08
                            	  7389: 
                            	  7390:     even
                            	  7391: DodongoFrameHFlips:
02:0003CDC2 00              	  7392:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CDC3 40
02:0003CDC4 00
02:0003CDC5 FF
02:0003CDC6 00
02:0003CDC7 00
02:0003CDC8 40
02:0003CDC9 40
02:0003CDCA FF              	  7393:     dc.b    $FF, $40
02:0003CDCB 40
                            	  7394: 
                            	  7395:     even
                            	  7396: DodongoFrameImagesBloated:
02:0003CDCC 04              	  7397:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CDCD 05
02:0003CDCE 07
02:0003CDCF FF
02:0003CDD0 09
02:0003CDD1 04
02:0003CDD2 05
02:0003CDD3 07
02:0003CDD4 FF              	  7398:     dc.b    $FF, $09
02:0003CDD5 09
                            	  7399: 
