                            	  7887:     ; Add high speed byte to Y coordinate.
                            	  7888:     ;
02:0003D16C 023C00EE        	  7889:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D170 41EC0084        	  7890:     lea     ($0084,A4),A0
