                            	  6951: _L_z07_AnimateLinkObjState_CheckState20:
                            	  6952:     ; If major state = $20
                            	  6953:     ;   if minor state = 0, make it 1
                            	  6954:     ;   else OR state with $30
                            	  6955:     ;   go set movement frame to 1
                            	  6956:     ;
02:0004CE4A 0C000020        	  6957:     cmpi.b  #$20,D0
02:0004CE4E 6624            	  6958:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004CE50 102C00AC        	  6959:     move.b  ($00AC,A4),D0
