02:0003C6DA 10302000        	  6420:     move.b  (A0,D2.W),D0
02:0003C6DE 122C0002        	  6421:     move.b  ($0002,A4),D1
02:0003C6E2 E309            	  6422:     lsl.b  #1,D1   ; ASL $02
02:0003C6E4 19410002        	  6423:     move.b  D1,($0002,A4)
02:0003C6E8 122C0002        	  6424:     move.b  ($0002,A4),D1
02:0003C6EC C200            	  6425:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C6EE 6716            	  6426:     beq  _L_z04_Digdogger_Move_Down
