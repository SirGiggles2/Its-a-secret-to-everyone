02:0003B6CA 003C0011        	  4269:     ori     #$11,CCR  ; SEC: set C+X
02:0003B6CE 41EC0084        	  4270:     lea     ($0084,A4),A0
02:0003B6D2 12302000        	  4271:     move.b  (A0,D2.W),D1
02:0003B6D6 0A3C0010        	  4272:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B6DA 9101            	  4273:     subx.b  D1,D0   ; SBC ObjY,X
02:0003B6DC 0A3C0010        	  4274:     eori    #$10,CCR  ; restore X = 6502 C
