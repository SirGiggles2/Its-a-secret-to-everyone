                            	  1670: AnimateDemoPhase0Subphase1:
02:00034708 102C0438        	  1671:     move.b  ($0438,A4),D0
02:0003470C 666C            	  1672:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:0003470E 7000            	  1676:     moveq   #0,D0
02:00034710 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00034714 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00034716 41F9000344F8    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:0003471C D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:0003471E 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:00034724 197C00000303    	  1683:     move.b  #$00,($0303,A4)
02:0003472A 7020            	  1684:     moveq   #32,D0
02:0003472C 19400304        	  1685:     move.b  D0,($0304,A4)
                            	  1686:     ; End marker at DynTileBuf+4+31
02:00034730 761F            	  1687:     moveq   #31,D3
02:00034732 103C00FF        	  1688:     move.b  #$FF,D0
02:00034736 43EC0306        	  1689:     lea     ($0306,A4),A1
02:0003473A 13803000        	  1690:     move.b  D0,(A1,D3.W)
                            	  1691:     even
                            	  1692: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:0003473E 10303000        	  1693:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00034742 43EC0305        	  1694:     lea     ($0305,A4),A1
02:00034746 13803000        	  1695:     move.b  D0,(A1,D3.W)
02:0003474A 5303            	  1696:     subq.b  #1,D3
02:0003474C 6AF0            	  1697:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1698:     ; Advance the subphase cycle.
                            	  1699:     ;
02:0003474E 522C0437        	  1700:     addq.b  #1,($0437,A4)
                            	  1701:     ; Set the timer to the delay for the current point in the cycle.
                            	  1702:     ;
02:00034752 7600            	  1703:     moveq   #0,D3
02:00034754 162C0437        	  1704:     move.b  ($0437,A4),D3
02:00034758 41F9000346F7    	  1705:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:0003475E 10303000        	  1706:     move.b  (A0,D3.W),D0
02:00034762 19400438        	  1707:     move.b  D0,($0438,A4)
02:00034766 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:0003476A 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1710:     ; Advance to the next demo phase.
                            	  1711:     ;
02:0003476C 522C042C        	  1712:     addq.b  #1,($042C,A4)
02:00034770 7000            	  1713:     moveq   #0,D0
02:00034772 1940042D        	  1714:     move.b  D0,($042D,A4)
02:00034776 19400011        	  1715:     move.b  D0,($0011,A4)
                            	  1716:     even
