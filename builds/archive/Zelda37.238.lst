                            	  5457: LayOutDoors:
                            	  5458:     ; Copies the right door face for the direction, type, and state
                            	  5459:     ; of the door to the play area tile map.
                            	  5460:     ;
                            	  5461:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5462:     ; that are not true doors.
                            	  5463:     ;
02:00043670 7403            	  5464:     moveq   #3,D2
                            	  5465:     even
                            	  5466: L_LayOutDoors_LoopDoors:
                            	  5467:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5468:     ;
02:00043672 7001            	  5469:     moveq   #1,D0
                            	  5470:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5471:     ;
                            	  5472:     ; [06] indicates whether we're handling the first half of
                            	  5473:     ; the door: Left half for N/S, Top half for E/W.
                            	  5474:     ;
02:00043674 19400006        	  5475:     move.b  D0,($0006,A4)
                            	  5476:     even
                            	  5477: L_LayOutDoors_LoopHalves:
02:00043678 1002            	  5478:     move.b  D2,D0
02:0004367A 1B00            	  5479:     move.b  D0,-(A5)  ; PHA
02:0004367C 1940000B        	  5480:     move.b  D0,($000B,A4)
02:00043680 41F90004364C    	  5481:     lea     (DoorBits).l,A0
02:00043686 10302000        	  5482:     move.b  (A0,D2.W),D0
02:0004368A 19400002        	  5483:     move.b  D0,($0002,A4)
02:0004368E 6100FD4A        	  5484:     jsr     FindDoorAttrByDoorBit
                            	  5485:     ; Begin looking for the door face for the door attribute.
                            	  5486:     ; In general, use the door type as the provisional face;
                            	  5487:     ; except turn 4 into 8.
                            	  5488:     ;
02:00043692 0C000005        	  5489:     cmpi.b  #$05,D0
02:00043696 642A            	  5490:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043698 0C000004        	  5491:     cmpi.b  #$04,D0
02:0004369C 6608            	  5492:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0004369E 7008            	  5493:     moveq   #8,D0
02:000436A0 6620            	  5494:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5495:     even
                            	  5496: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5497:     ; We jump here if the door type is bombable and was opened.
                            	  5498:     ; Change the provisional door face to value 9, which
                            	  5499:     ; will become the "hole in the wall".
                            	  5500:     ;
02:000436A2 7009            	  5501:     moveq   #9,D0
02:000436A4 665A            	  5502:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5503:     even
                            	  5504: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5505:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5506:     ; the mask of opened doors, because this is not a true door.
                            	  5507:     ;
02:000436A6 1B00            	  5508:     move.b  D0,-(A5)  ; PHA
02:000436A8 102C0002        	  5509:     move.b  ($0002,A4),D0
02:000436AC 4600            	  5510:     eori.b #$FF,D0
02:000436AE 122C00EE        	  5511:     move.b  ($00EE,A4),D1
02:000436B2 C001            	  5512:     and.b  D1,D0
02:000436B4 194000EE        	  5513:     move.b  D0,($00EE,A4)
02:000436B8 101D            	  5514:     move.b  (A5)+,D0  ; PLA
                            	  5515:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5516:     ;
02:000436BA 0C000001        	  5517:     cmpi.b  #$01,D0
02:000436BE 6402            	  5518:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000436C0 7004            	  5519:     moveq   #4,D0
                            	  5520:     even
                            	  5521: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5522:     ; The door attribute (DA) has been mapped to a
                            	  5523:     ; provisional door face value (PF) in %A as follows:
                            	  5524:     ;
                            	  5525:     ; DA PF Meaning
                            	  5526:     ; -------------
                            	  5527:     ; 0  4  open
                            	  5528:     ; 1  1  wall
                            	  5529:     ; 2  2  false wall
                            	  5530:     ; 3  3  false wall 2
                            	  5531:     ; 4  8  bombable
                            	  5532:     ; 5  5  key
                            	  5533:     ; 6  6  key 2
                            	  5534:     ; 7  7  shutter
                            	  5535:     ;
                            	  5536:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5537:     ; has been cleared, if the type was "open" or any wall.
                            	  5538:     ;
                            	  5539:     ;
                            	  5540:     ; Save the provisional face.
02:000436C2 1B00            	  5541:     move.b  D0,-(A5)  ; PHA
                            	  5542:     ; If the current direction points to a door that has been opened,
                            	  5543:     ; then see if we need to set door flags.
                            	  5544:     ;
02:000436C4 102C00EE        	  5545:     move.b  ($00EE,A4),D0
02:000436C8 122C0002        	  5546:     move.b  ($0002,A4),D1
02:000436CC C001            	  5547:     and.b  D1,D0
02:000436CE 7400            	  5548:     moveq   #0,D2
02:000436D0 1400            	  5549:     move.b  D0,D2
02:000436D2 101D            	  5550:     move.b  (A5)+,D0  ; PLA
02:000436D4 122C0002        	  5551:     move.b  ($0002,A4),D1
02:000436D8 B401            	  5552:     cmp.b   D1,D2
02:000436DA 6624            	  5553:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5554:     ; The current direction points to a door that has been opened.
                            	  5555:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5556:     ;
                            	  5557:     ;
                            	  5558:     ; Save provisional door face in Y register.
02:000436DC 7600            	  5559:     moveq   #0,D3
02:000436DE 1600            	  5560:     move.b  D0,D3
02:000436E0 101D            	  5561:     move.b  (A5)+,D0  ; PLA
02:000436E2 1B00            	  5562:     move.b  D0,-(A5)  ; PHA
02:000436E4 7400            	  5563:     moveq   #0,D2
02:000436E6 1400            	  5564:     move.b  D0,D2
02:000436E8 1003            	  5565:     move.b  D3,D0
                            	  5566:     ; If provisional door face is not for a shutter, then
                            	  5567:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5568:     ;
                            	  5569:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5570:     ;
02:000436EA 0C000007        	  5571:     cmpi.b  #$07,D0
02:000436EE 670E            	  5572:     beq  _anon_z05_111
02:000436F0 1B00            	  5573:     move.b  D0,-(A5)  ; PHA
02:000436F2 6100DE86        	  5574:     jsr     SetDoorFlag
02:000436F6 101D            	  5575:     move.b  (A5)+,D0  ; PLA
                            	  5576:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5577:     ; then go make it 9 (open "bombable").
                            	  5578:     ; Else make it 4 (open "door").
                            	  5579:     ;
02:000436F8 0C000008        	  5580:     cmpi.b  #$08,D0
02:000436FC 67A4            	  5581:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5582: _anon_z05_111:
02:000436FE 7004            	  5583:     moveq   #4,D0
                            	  5584:     even
                            	  5585: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5586:     ; For opened doors, the provisional door face has become:
                            	  5587:     ;
                            	  5588:     ; DA PF Meaning
                            	  5589:     ; -------------
                            	  5590:     ; 0  4  open
                            	  5591:     ; 1  1  wall
                            	  5592:     ; 2  2  false wall
                            	  5593:     ; 3  3  false wall 2
                            	  5594:     ; 4  9  bombable
                            	  5595:     ; 5  4  key
                            	  5596:     ; 6  4  key 2
                            	  5597:     ; 7  4  shutter
                            	  5598:     ;
                            	  5599:     ;
                            	  5600:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5601:     ;
02:00043700 7400            	  5602:     moveq   #0,D2
02:00043702 142C0006        	  5603:     move.b  ($0006,A4),D2
02:00043706 6712            	  5604:     beq  _anon_z05_112
02:00043708 7400            	  5605:     moveq   #0,D2
02:0004370A 142C000B        	  5606:     move.b  ($000B,A4),D2
02:0004370E 1B00            	  5607:     move.b  D0,-(A5)  ; PHA
02:00043710 6100FCC8        	  5608:     jsr     FindDoorAttrByDoorBit
02:00043714 61001CBA        	  5609:     jsr     CalcOpenDoorwayMask
02:00043718 101D            	  5610:     move.b  (A5)+,D0  ; PLA
                            	  5611: _anon_z05_112:
                            	  5612:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5613:     ; because the visible door face is already a wall.
                            	  5614:     ;
02:0004371A 0C000004        	  5615:     cmpi.b  #$04,D0
02:0004371E 650000DC        	  5616:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5617:     ; For all other provisional face values, calculate:
                            	  5618:     ; door face := provisional face - 3
02:00043722 003C0011        	  5619:     ori     #$11,CCR  ; SEC: set C+X
02:00043726 123C0003        	  5620:     move.b  #$03,D1
02:0004372A 0A3C0010        	  5621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004372E 9101            	  5622:     subx.b  D1,D0   ; SBC #$03
02:00043730 0A3C0010        	  5623:     eori    #$10,CCR  ; restore X = 6502 C
02:00043734 7600            	  5624:     moveq   #0,D3
02:00043736 1600            	  5625:     move.b  D0,D3
                            	  5626:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5627:     ; subtract one.
                            	  5628:     ;
02:00043738 0C030003        	  5629:     cmpi.b  #$03,D3
02:0004373C 6502            	  5630:     bcs  _anon_z05_113
02:0004373E 5303            	  5631:     subq.b  #1,D3
                            	  5632: _anon_z05_113:
                            	  5633:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5634:     ;
                            	  5635:     ; DT DFC DFO Meaning
                            	  5636:     ; ------------------
                            	  5637:     ; 0  1   1   open
                            	  5638:     ; 4  4   5   bombable
                            	  5639:     ; 5  2   1   key
                            	  5640:     ; 6  2   1   key 2
                            	  5641:     ; 7  3   1   shutter
                            	  5642:     ;
                            	  5643:     ;
                            	  5644:     ; Get the direction index.
02:00043740 101D            	  5645:     move.b  (A5)+,D0  ; PLA
02:00043742 1B00            	  5646:     move.b  D0,-(A5)  ; PHA
02:00043744 610000D0        	  5647:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5648:     ; If handling the second half, then offset to the second half
                            	  5649:     ; of the tiles.
                            	  5650:     ;
02:00043748 102C0006        	  5651:     move.b  ($0006,A4),D0
02:0004374C 6618            	  5652:     bne  _anon_z05_114
02:0004374E 41F900043664    	  5653:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00043754 10302000        	  5654:     move.b  (A0,D2.W),D0
02:00043758 4EB900031306    	  5655:     jsr     AddToInt16At0
02:0004375E 7006            	  5656:     moveq   #6,D0
02:00043760 4EB90003130E    	  5657:     jsr     AddToInt16At2
                            	  5658: _anon_z05_114:
                            	  5659:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5660:     ; Pointers will be incremented instead of Y.
02:00043766 7600            	  5661:     moveq   #0,D3
02:00043768 41F900043668    	  5662:     lea     (DirIndexToDoorColumnCount).l,A0
