                            	   205: InitCave:
                            	   206:     ; The person goes at location ($78, $80).
                            	   207:     ;
02:0002E2C4 7078            	   208:     moveq   #120,D0
02:0002E2C6 163C0080        	   209:     move.b  #$80,D3
02:0002E2CA 610001A0        	   210:     jsr     SetUpCommonCaveObjects
                            	   211:     ; If the cave/person does not remember state (give item, door charge),
                            	   212:     ; then go handle other kinds.
                            	   213:     ;
02:0002E2CE 102C0350        	   214:     move.b  ($0350,A4),D0
02:0002E2D2 0C000072        	   215:     cmpi.b  #$72,D0
02:0002E2D6 6714            	   216:     beq  _L_z01_InitCave_TakeType
02:0002E2D8 0C000071        	   217:     cmpi.b  #$71,D0
02:0002E2DC 670E            	   218:     beq  _L_z01_InitCave_TakeType
02:0002E2DE 0C00007B        	   219:     cmpi.b  #$7B,D0
02:0002E2E2 6408            	   220:     bcc  _L_z01_InitCave_TakeType
02:0002E2E4 0C00006E        	   221:     cmpi.b  #$6E,D0
02:0002E2E8 6502            	   222:     bcs.s  __far_z_01_0000
02:0002E2EA 6012            	   223:     jmp  InitCaveContinue
                            	   224: __far_z_01_0000:
                            	   225:     even
                            	   226: _L_z01_InitCave_TakeType:
                            	   227:     ; Else the cave/person simply does:
                            	   228:     ; - taken:     no person, no text
                            	   229:     ; - not taken: show a person and text
                            	   230:     ;
                            	   231:     ; So, if the item was not taken, then go set up the text.
                            	   232:     ;
02:0002E2EC 610030BE        	   233:     jsr     GetRoomFlagUWItemState
02:0002E2F0 6602            	   234:     bne.s  __far_z_01_0001
02:0002E2F2 600A            	   235:     jmp  InitCaveContinue
                            	   236: __far_z_01_0001:
                            	   237:     ; Otherwise destroy the person object, and let Link continue.
                            	   238:     ;
02:0002E2F4 7000            	   239:     moveq   #0,D0
02:0002E2F6 19400350        	   240:     move.b  D0,($0350,A4)
                            	   241:     even
                            	   242: UnhaltLink:
02:0002E2FA 6000D6F2        	   243:     jmp     c_unhalt_link
                            	   244: 
                            	   245: InitCaveContinue:
                            	   246:     ; Get this cave's index (object type - $6A).
                            	   247:     ;
02:0002E2FE 102C0350        	   248:     move.b  ($0350,A4),D0
02:0002E302 003C0011        	   249:     ori     #$11,CCR  ; SEC: set C+X
02:0002E306 123C006A        	   250:     move.b  #$6A,D1
02:0002E30A 0A3C0010        	   251:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E30E 9101            	   252:     subx.b  D1,D0   ; SBC #$6A
02:0002E310 0A3C0010        	   253:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E314 7600            	   254:     moveq   #0,D3
02:0002E316 1600            	   255:     move.b  D0,D3
                            	   256:     ; Get the person text selector by looking up the text selector byte
                            	   257:     ; for this index, and masking it with $3F.
                            	   258:     ;
02:0002E318 41F90002E296    	   259:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E31E 10303000        	   260:     move.b  (A0,D3.W),D0
02:0002E322 1B00            	   261:     move.b  D0,-(A5)  ; PHA
02:0002E324 0200003F        	   262:     andi.b #$3F,D0
02:0002E328 19400415        	   263:     move.b  D0,($0415,A4)
                            	   264:     ; Pop and mask the text selector byte with $C0 to get the
                            	   265:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   266:     ;
02:0002E32C 101D            	   267:     move.b  (A5)+,D0  ; PLA
02:0002E32E 020000C0        	   268:     andi.b #$C0,D0
02:0002E332 19400003        	   269:     move.b  D0,($0003,A4)
                            	   270:     ; At this point, the Y register still has the cave index.
                            	   271:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   272:     ;
02:0002E336 103C00FD        	   273:     move.b  #$FD,D0
                            	   274: _anon_z01_0:
02:0002E33A 023C00EE        	   275:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E33E 123C0003        	   276:     move.b  #$03,D1
02:0002E342 D101            	   277:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E344 5303            	   278:     subq.b  #1,D3
02:0002E346 6AF2            	   279:     bpl  _anon_z01_0
02:0002E348 7600            	   280:     moveq   #0,D3
02:0002E34A 1600            	   281:     move.b  D0,D3
                            	   282:     ; Loop over the wares from 0 to 2.
                            	   283:     ;
02:0002E34C 7400            	   284:     moveq   #0,D2
                            	   285:     even
                            	   286: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   287:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   288:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   289:     ;
02:0002E34E 41F900FF6A7E    	   290:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E354 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002E358 41EC0422        	   292:     lea     ($0422,A4),A0
02:0002E35C 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   295:     ;
02:0002E360 020000C0        	   296:     andi.b #$C0,D0
02:0002E364 19802000        	   297:     move.b  D0,($00,A4,D2.W)
                            	   298:     ; Copy 3 prices from the Cave level block info.
                            	   299:     ;
02:0002E368 41F900FF6ABA    	   300:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E36E 10303000        	   301:     move.b  (A0,D3.W),D0
02:0002E372 41EC0430        	   302:     lea     ($0430,A4),A0
02:0002E376 11802000        	   303:     move.b  D0,(A0,D2.W)
                            	   304:     ; Bottom of the wares copying loop.
                            	   305:     ;
02:0002E37A 5203            	   306:     addq.b  #1,D3
02:0002E37C 5202            	   307:     addq.b  #1,D2
02:0002E37E 0C020003        	   308:     cmpi.b  #$03,D2
02:0002E382 66CA            	   309:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   310:     ; Get the top 2 bits of text selector byte in [03],
                            	   311:     ; shift them to the bottom, and combine them with [00].
                            	   312:     ;
02:0002E384 102C0003        	   313:     move.b  ($0003,A4),D0
02:0002E388 E308            	   314:     lsl.b  #1,D0   ; ASL A
02:0002E38A E310            	   315:     roxl.b  #1,D0   ; ROL A
02:0002E38C E310            	   316:     roxl.b  #1,D0   ; ROL A
02:0002E38E 1214            	   317:     move.b  ($0000,A4),D1
02:0002E390 8001            	   318:     or.b  D1,D0
02:0002E392 1880            	   319:     move.b  D0,($0000,A4)
                            	   320:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   321:     ; and combine them with [00].
                            	   322:     ;
02:0002E394 102C0002        	   323:     move.b  ($0002,A4),D0
02:0002E398 E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E39A E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E39C E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002E39E E208            	   327:     lsr.b  #1,D0   ; LSR A
02:0002E3A0 1214            	   328:     move.b  ($0000,A4),D1
02:0002E3A2 8001            	   329:     or.b  D1,D0
02:0002E3A4 1880            	   330:     move.b  D0,($0000,A4)
                            	   331:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   332:     ; and combine them with [00] into CaveFlags.
                            	   333:     ;
02:0002E3A6 102C0001        	   334:     move.b  ($0001,A4),D0
02:0002E3AA E208            	   335:     lsr.b  #1,D0   ; LSR A
02:0002E3AC E208            	   336:     lsr.b  #1,D0   ; LSR A
02:0002E3AE 1214            	   337:     move.b  ($0000,A4),D1
02:0002E3B0 8001            	   338:     or.b  D1,D0
02:0002E3B2 19400413        	   339:     move.b  D0,($0413,A4)
                            	   340:     ; The end result is a byte with 8 cave flags.
                            	   341:     ;
                            	   342:     ; If cave flag "money game" is missing, then go finish up,
                            	   343:     ; instead of choosing random amounts for the money game.
                            	   344:     ;
02:0002E3B6 02000020        	   345:     andi.b #$20,D0
02:0002E3BA 6700009E        	   346:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   347:     ; Determine an index randomly with increasing probability,
                            	   348:     ; from 6 to 1. Start with the following test:
                            	   349:     ;
                            	   350:     ;   If $FF < Random, then go use index 6.
                            	   351:     ;
02:0002E3BE 103C00FF        	   352:     move.b  #$FF,D0
02:0002E3C2 7606            	   353:     moveq   #6,D3
                            	   354:     even
                            	   355: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E3C4 122C0019        	   356:     move.b  ($0019,A4),D1
02:0002E3C8 B001            	   357:     cmp.b   D1,D0
02:0002E3CA 6516            	   358:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   359:     ; If the test fails, then subtract $2B from the reference number.
                            	   360:     ;
02:0002E3CC 003C0011        	   361:     ori     #$11,CCR  ; SEC: set C+X
02:0002E3D0 123C002B        	   362:     move.b  #$2B,D1
02:0002E3D4 0A3C0010        	   363:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E3D8 9101            	   364:     subx.b  D1,D0   ; SBC #$2B
02:0002E3DA 0A3C0010        	   365:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E3DE 5303            	   366:     subq.b  #1,D3
02:0002E3E0 66E2            	   367:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   368:     even
                            	   369: _L_z01_InitCaveContinue_FoundPermutation:
                            	   370:     ; The index chooses the last offset of a permutation of three indexes.
                            	   371:     ;
02:0002E3E2 7400            	   372:     moveq   #0,D2
02:0002E3E4 41F90002E2BE    	   373:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E3EA 14303000        	   374:     move.b  (A0,D3.W),D2
                            	   375:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   376:     ;
02:0002E3EE 7602            	   377:     moveq   #2,D3
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E3F0 41F90002E2AC    	   380:     lea     (MoneyGamePermutations).l,A0
02:0002E3F6 10302000        	   381:     move.b  (A0,D2.W),D0
02:0002E3FA 41EC046C        	   382:     lea     ($046C,A4),A0
02:0002E3FE 11803000        	   383:     move.b  D0,(A0,D3.W)
02:0002E402 5302            	   384:     subq.b  #1,D2
02:0002E404 5303            	   385:     subq.b  #1,D3
02:0002E406 6AE8            	   386:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   387:     ; With the first bit of another random number, choose 10 or 40
                            	   388:     ; to put in [046F]. This is a random amount to lose.
                            	   389:     ;
02:0002E408 102C001A        	   390:     move.b  ($001A,A4),D0
02:0002E40C 02000001        	   391:     andi.b #$01,D0
02:0002E410 7600            	   392:     moveq   #0,D3
02:0002E412 1600            	   393:     move.b  D0,D3
02:0002E414 41F90002E2AA    	   394:     lea     (MoneyGameLossAmounts).l,A0
02:0002E41A 10303000        	   395:     move.b  (A0,D3.W),D0
02:0002E41E 1940046F        	   396:     move.b  D0,($046F,A4)
                            	   397:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   398:     ;
02:0002E422 700A            	   399:     moveq   #10,D0
02:0002E424 19400470        	   400:     move.b  D0,($0470,A4)
                            	   401:     ; With a different bit of the second random number,
                            	   402:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   403:     ;
02:0002E428 7614            	   404:     moveq   #20,D3
02:0002E42A 102C001A        	   405:     move.b  ($001A,A4),D0
02:0002E42E 02000002        	   406:     andi.b #$02,D0
02:0002E432 6702            	   407:     beq  _anon_z01_1
02:0002E434 7632            	   408:     moveq   #50,D3
                            	   409: _anon_z01_1:
02:0002E436 19430471        	   410:     move.b  D3,($0471,A4)
                            	   411:     ; The 3 amounts are now in [046F] to [0471].
                            	   412:     ; Reference these amounts using the permutation of indexes
                            	   413:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   414:     ;
02:0002E43A 7402            	   415:     moveq   #2,D2
                            	   416:     even
                            	   417: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E43C 7600            	   418:     moveq   #0,D3
02:0002E43E 41EC046C        	   419:     lea     ($046C,A4),A0
02:0002E442 16302000        	   420:     move.b  (A0,D2.W),D3
02:0002E446 41EC046F        	   421:     lea     ($046F,A4),A0
02:0002E44A 10303000        	   422:     move.b  (A0,D3.W),D0
02:0002E44E 41EC0448        	   423:     lea     ($0448,A4),A0
02:0002E452 11802000        	   424:     move.b  D0,(A0,D2.W)
02:0002E456 5302            	   425:     subq.b  #1,D2
02:0002E458 6AE2            	   426:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   427:     even
                            	   428: _L_z01_InitCaveContinue_ResetTextbox:
                            	   429:     ; Reset the current character index.
                            	   430:     ;
02:0002E45A 7000            	   431:     moveq   #0,D0
