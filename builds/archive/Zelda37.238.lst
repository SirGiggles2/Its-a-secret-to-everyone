02:0003D33A 41EC042C        	  8088:     lea     ($042C,A4),A0
02:0003D33E 11802000        	  8089:     move.b  D0,(A0,D2.W)
                            	  8090:     even
                            	  8091: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  8092:     ; In this state, we have to draw Like-like over Link.
