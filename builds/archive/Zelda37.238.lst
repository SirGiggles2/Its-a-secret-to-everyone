02:0003C214 6774            	  5718:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5719:     ; This segment is dead. We'll swap the tail segment with this
                            	  5720:     ; dead segment. This way, moldorm heads are always rooted
                            	  5721:     ; in slots 5 and $A; and the segments are continguous.
                            	  5722:     ;
                            	  5723:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5724:     ;
                            	  5725:     ; Note that this is not a true swap, because the tail's HP
                            	  5726:     ; might be less than $20.
                            	  5727:     ;
