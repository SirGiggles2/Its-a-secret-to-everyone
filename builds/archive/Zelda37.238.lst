02:0003D270 11802000        	  8002:     move.b  D0,(A0,D2.W)
02:0003D274 7600            	  8003:     moveq   #0,D3
02:0003D276 41EC03E4        	  8004:     lea     ($03E4,A4),A0
02:0003D27A 16302000        	  8005:     move.b  (A0,D2.W),D3
02:0003D27E 5203            	  8006:     addq.b  #1,D3
02:0003D280 1003            	  8007:     move.b  D3,D0
02:0003D282 02000003        	  8008:     andi.b #$03,D0
02:0003D286 41EC03E4        	  8009:     lea     ($03E4,A4),A0
02:0003D28A 11802000        	  8010:     move.b  D0,(A0,D2.W)
                            	  8011:     even
                            	  8012: _L_z04_UpdateLikeLike_Draw:
                            	  8013:     ; Draw.
                            	  8014:     ;
02:0003D28E 4EB90004CE24    	  8015:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D294 41EC03E4        	  8016:     lea     ($03E4,A4),A0
02:0003D298 10302000        	  8017:     move.b  (A0,D2.W),D0
02:0003D29C 4EB900031A00    	  8018:     jsr     DrawObjectMirrored
                            	  8019:     ; Check collisions. If Link was not captured, then return.
                            	  8020:     ;
02:0003D2A2 4EB900031D80    	  8021:     jsr     CheckMonsterCollisions
02:0003D2A8 41EC042C        	  8022:     lea     ($042C,A4),A0
02:0003D2AC 10302000        	  8023:     move.b  (A0,D2.W),D0
02:0003D2B0 673C            	  8024:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8025:     ; The monster captured Link.
                            	  8026:     ; Put the monster at the same location as him.
                            	  8027:     ;
