Source: "genesis_shell.asm"
                            	     1: ;==============================================================================
                            	     2: ; genesis_shell.asm — Genesis boot shell (T1 milestone)
                            	     3: ;
                            	     4: ; No Zelda code. Boots, inits VDP with verified H32 register set, clears
                            	     5: ; VRAM, writes a green test color to CRAM[0], turns on the display.
                            	     6: ; Screen should be solid green — use this to confirm VDP init is correct
                            	     7: ; before attaching any NES I/O or translated Zelda code.
                            	     8: ;
                            	     9: ; COLORFIX: VDP register 0 is ALWAYS $8004 (NOT $8000).
                            	    10: ;   bit 2 is reserved and must be 1. Writing $8000 produces dingy/dark
                            	    11: ;   colors on real hardware even when CRAM data is correct.
                            	    12: ;
                            	    13: ; H32 mode: confirmed by Reg 12 = $00 (RS0=bit0=0, RS1=bit7=0).
                            	    14: ;   256 pixels wide, 32 tiles per row.
                            	    15: ;==============================================================================
                            	    16: 
                            	    17: ;==============================================================================
                            	    18: ; Hardware addresses
                            	    19: ;==============================================================================
                            	    20: 
                            	    21: STACK_TOP       equ $00FFFFFE
                            	    22: VDP_DATA        equ $00C00000
                            	    23: VDP_CTRL        equ $00C00004
                            	    24: VERSION_PORT    equ $00A10001
                            	    25: TMSS_PORT       equ $00A14000
                            	    26: Z80_BUSREQ      equ $00A11100
                            	    27: Z80_RESET       equ $00A11200
                            	    28: 
                            	    29: ;==============================================================================
                            	    30: ; NES emulation constants
                            	    31: ;==============================================================================
                            	    32: NES_RAM_BASE    equ $00FF0000   ; Maps NES $0000-$07FF (8 pages × 256 bytes)
                            	    33: NES_RAM_SIZE    equ $0800       ; 2KB NES work RAM
                            	    34: NES_STACK_INIT  equ $00FF0200   ; NES SP=$FF -> A5 = NES_RAM+$0100+$FF+1 = $FF0200
                            	    35: PPU_STATE_SIZE  equ $40         ; 64 bytes: PPU ($FF0800-$FF080F) + MMC1 ($FF0810-$FF081F) + CHR buf ($FF0820-$FF083F)
                            	    36: 
                            	    37: ; DEBUG_TELEPORT — feature flag for DPAD instant-teleport in overworld QA.
                            	    38: ; When 1, the DPAD shortcut routine in _debug_teleport_check (end of file)
                            	    39: ; is live and the P37 hook in z_07 routes UpdateMode5Play_NotInMenu through
                            	    40: ; it. Set to 0 to strip both the hook and the routine for release builds.
                            	    41: DEBUG_TELEPORT  equ 0
                            	    42: 
                            	    43: ; TURBO_LINK: no-clip + speed boost for QA navigation.
                            	    44: TURBO_LINK      equ 1
                            	    45: 
                            	    46: ; Active H-int event queue for the frame currently being rendered.
                            	    47: ; _ags_prearm promotes staged state into this queue and HBlankISR consumes it.
                            	    48: ; Q1 remains available for future chained events but is currently unused.
                            	    49: HINT_Q_COUNT    equ $00FF0816  ; byte: pending active events (0, 1, or 2)
                            	    50: HINT_Q0_CTR     equ $00FF0817  ; byte: Reg 10 counter for active event 0 (abs scanline)
                            	    51: HINT_Q0_VSRAM   equ $00FF0818  ; word: VSRAM to write at active event 0
                            	    52: HINT_Q1_CTR     equ $00FF081A  ; byte: Reg 10 reload for active event 1 (delta)
                            	    53: HINT_Q1_VSRAM   equ $00FF081C  ; word: VSRAM to write at active event 1
                            	    54: 
                            	    55: ; Active-frame debug state. Probes sample these after the frame has been staged
                            	    56: ; and/or rendered to distinguish direct scroll from one-shot H-int composition.
                            	    57: HINT_PEND_SPLIT equ $00FF081E  ; byte: 1 = current frame has an armed H-int split
                            	    58: INTRO_SCROLL_MODE equ $00FF081F ; byte: active scroll mode for the current frame
                            	    59: 
                            	    60: ;==============================================================================
                            	    61: ; VDP command long-words (written to VDP_CTRL to set VRAM/CRAM address)
                            	    62: ;==============================================================================
                            	    63: 
                            	    64: VRAM_WRITE_0000 equ $40000000       ; VRAM write to address $0000 (CD=%0100)
                            	    65: CRAM_WRITE_0000 equ $C0000000       ; CRAM write to address $0000 (CD=%1100)
                            	    66: VSRAM_WRITE_0000 equ $40000010      ; VSRAM write to address $0000
                            	    67: 
                            	    68: ;==============================================================================
                            	    69: ; Genesis CRAM color: ---BBB-GGG-RRR
                            	    70: ;   Bits [11:9]=Blue, [7:5]=Green, [3:1]=Red  (3 bits each)
                            	    71: ;==============================================================================
                            	    72: 
                            	    73: COLOR_GREEN     equ $00E0           ; pure green (G=7 → bits[7:5]=111)
                            	    74: COLOR_BLACK     equ $0000
                            	    75: 
                            	    76: ;==============================================================================
                            	    77: ; VRAM layout
                            	    78: ;
                            	    79: ;   $0000–$1FFF   Sprite CHR copy 0 (sub-pal 0, bias +4) — 256 tiles
                            	    80: ;   $2000–$3FFF   BG CHR (nametable tiles) — 256 tiles
                            	    81: ;   $4000–$5FFF   Sprite CHR copy 1 (sub-pal 1, bias +8) — 256 tiles
                            	    82: ;   $6000–$7FFF   Sprite CHR copy 2 (sub-pal 2, bias +C) — 256 tiles
                            	    83: ;   $8000–$9FFF   Sprite CHR copy 3 (sub-pal 3, bias +4, OAM=PAL1) — 256 tiles
                            	    84: ;   $A000–$AFFF   Free / reserved tile area
                            	    85: ;   $B000–$B7FF   Window plane   32×32 × 2 bytes = $800  (HUD strip)
                            	    86: ;   $C000–$CFFF   Plane A        64×32 × 2 bytes = $1000 (main playfield)
                            	    87: ;   $D800–$DA7F   Sprite attr    80 × 8 bytes = $280
                            	    88: ;   $DC00–$DF7F   H-scroll tbl   224 × 4 bytes = $380 (line-scroll mode)
                            	    89: ;   $E000–$EFFF   Plane B        64×32 × 2 bytes = $1000 (transition staging)
                            	    90: ;   $F000–$FFFF   Free / reserved
                            	    91: ;
                            	    92: ; T-CHR v8 sprite sub-palette packing (each NES sprite CHR tile is uploaded
                            	    93: ; to 4 VRAM copies with pre-biased pixel values — _chr_upload_sprite_4x):
                            	    94: ;   sub-pal 0 → copy 0 @ $0000, pixels+$4 → CRAM PAL0[4..7]
                            	    95: ;   sub-pal 1 → copy 1 @ $4000, pixels+$8 → CRAM PAL0[8..11]
                            	    96: ;   sub-pal 2 → copy 2 @ $6000, pixels+$C → CRAM PAL0[12..15]
                            	    97: ;   sub-pal 3 → copy 3 @ $8000, pixels+$4 → CRAM PAL1[4..7]
                            	    98: ; BG palettes PAL0[0..3]/PAL1[0..3]/PAL2/PAL3 remain 100% untouched.
                            	    99: ; OAM dispatch (_oam_dma) selects the correct VRAM copy via tile bias and
                            	   100: ; the correct Gen palette (PAL0 for sub-pal 0/1/2, PAL1 for sub-pal 3).
                            	   101: ;==============================================================================
                            	   102: 
                            	   103: ;==============================================================================
                            	   104: ; $000000 — 68000 Exception Vector Table (64 vectors × 4 bytes = $100 bytes)
                            	   105: ;
                            	   106: ; Vector layout:
                            	   107: ;   0:  Initial SSP
                            	   108: ;   1:  Initial PC (Reset)
                            	   109: ;   2–11: exception handlers
                            	   110: ;   12–23: reserved
                            	   111: ;   24: spurious interrupt
                            	   112: ;   25–27: IRQ level 1–3 auto-vectors
                            	   113: ;   28: IRQ level 4 auto-vector (H-int / HBlank)
                            	   114: ;   29: IRQ level 5 auto-vector
                            	   115: ;   30: IRQ level 6 auto-vector (V-int / VBlank) ← at $000078
                            	   116: ;   31: IRQ level 7 auto-vector
                            	   117: ;   32–63: TRAP + user-defined
                            	   118: ;==============================================================================
                            	   119: 
                            	   120:     ; Stage-2a: named section; build/genesis.ld pins to $0.
                            	   121:     section "vectors",code
                            	   122: 
00:00000000 00FFFFFE        	   123:     dc.l    STACK_TOP           ; vec  0: initial SSP
00:00000004 00000000        	   124:     dc.l    EntryPoint          ; vec  1: initial PC → boot code
00:00000008 000002CE        	   125:     dc.l    ExcBusError         ; vec  2: bus error
00:0000000C 000002F0        	   126:     dc.l    ExcAddrError        ; vec  3: address error
                            	   127:     rept    20
                            	   128:         dc.l    DefaultException    ; vec 4–23: exceptions + reserved
                            	   129:     endr
