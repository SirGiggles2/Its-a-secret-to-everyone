                            	  2866: Link_FilterInput:
                            	  2867:     ; [00] holds the opposite of Link's facing direction.
                            	  2868:     ;
02:00041978 102C0098        	  2869:     move.b  ($0098,A4),D0
02:0004197C 4EB900030EAE    	  2870:     jsr     GetOppositeDir
02:00041982 1880            	  2871:     move.b  D0,($0000,A4)
                            	  2872:     ; Call GetOppositeDir again to use this mapping:
                            	  2873:     ; In Dir: 1 2 4 8
                            	  2874:     ;         -------
                            	  2875:     ; Index:  2 3 0 1
                            	  2876:     ;
02:00041984 4EB900030EAE    	  2877:     jsr     GetOppositeDir
                            	  2878:     ; Get the appropriate coordinate for the direction:
                            	  2879:     ; X for horizontal
                            	  2880:     ; Y for vertical
                            	  2881:     ;
02:0004198A 102C0070        	  2882:     move.b  ($0070,A4),D0
02:0004198E 0C030002        	  2883:     cmpi.b  #$02,D3
02:00041992 6404            	  2884:     bcc  _anon_z05_74
02:00041994 102C0084        	  2885:     move.b  ($0084,A4),D0
                            	  2886: _anon_z05_74:
02:00041998 19400002        	  2887:     move.b  D0,($0002,A4)
                            	  2888:     ; Mask A button and directions if inner border is crossed.
                            	  2889:     ;
02:0004199C 1003            	  2890:     move.b  D3,D0
02:0004199E 1B00            	  2891:     move.b  D0,-(A5)  ; PHA
02:000419A0 023C00EE        	  2892:     andi    #$EE,CCR  ; CLC: clear C+X
02:000419A4 123C0008        	  2893:     move.b  #$08,D1
02:000419A8 D101            	  2894:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000419AA 7600            	  2895:     moveq   #0,D3
02:000419AC 1600            	  2896:     move.b  D0,D3
02:000419AE 103C0080        	  2897:     move.b  #$80,D0
02:000419B2 6134            	  2898:     jsr     MaskInputInBorder
02:000419B4 101D            	  2899:     move.b  (A5)+,D0  ; PLA
02:000419B6 7600            	  2900:     moveq   #0,D3
02:000419B8 1600            	  2901:     move.b  D0,D3
                            	  2902:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2903:     ; boundary using player's direction and reverse direction index.
                            	  2904:     ;
02:000419BA 102C0001        	  2905:     move.b  ($0001,A4),D0
