                            	  4908:     ;
02:0004C058 7622            	  4909:     moveq   #34,D3
02:0004C05A 0C02000D        	  4910:     cmpi.b  #$0D,D2
02:0004C05E 6410            	  4911:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004C060 41EC034F        	  4912:     lea     ($034F,A4),A0
02:0004C064 10302000        	  4913:     move.b  (A0,D2.W),D0
02:0004C068 0C000057        	  4914:     cmpi.b  #$57,D0
02:0004C06C 6710            	  4915:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004C06E 660C            	  4916:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4917:     even
                            	  4918: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4919:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4920:     ;   high bit set (magic)   => $23
                            	  4921:     ;   high bit clear (sword) => $22
                            	  4922:     ;
02:0004C070 41EC00AC        	  4923:     lea     ($00AC,A4),A0
02:0004C074 10302000        	  4924:     move.b  (A0,D2.W),D0
