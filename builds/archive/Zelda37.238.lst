                            	   575: 
                            	   576: ;------------------------------------------------------------------------------
                            	   577: ; _c_move_object_shim — MoveObject trampoline.
                            	   578: ;
                            	   579: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   580: ;   Input:     D2 = slot (0..11)
                            	   581: ;   Preserves: D2, A4, A5
                            	   582: ;   Clobbers:  D0, D1, D3, A0
                            	   583: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   584: ;
                            	   585: ; GCC side:
                            	   586: ;   void c_move_object(unsigned short slot);
                            	   587: ;     slot arrives as a 16-bit value on the stack.
                            	   588: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   589: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   590: ;   never clobbered by gcc.
                            	   591: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   592: ;   semantics can exist in a pure C port).
                            	   593: ;------------------------------------------------------------------------------
                            	   594: _c_move_object_shim:
                            	   595:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   596:     move.b  #$AA,($0900,A4)
                            	   597:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   598:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   599:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   600:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   601:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   602:     moveq   #0,D0
02:0002B658 3002            	   603:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   604:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   605:     jsr     c_move_object
02:0002B662 588F            	   606:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   607:     rts
                            	   608: 
                            	   609: ;==============================================================================
                            	   610: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   611: ; and tail-call the native asm function.
                            	   612: ;
                            	   613: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   614: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   615: ; sign-extended).
                            	   616: ;==============================================================================
                            	   617: 
                            	   618: ;------------------------------------------------------------------------------
                            	   619: ; void c_copy_bank_to_window(unsigned int bank);
                            	   620: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   621: ;------------------------------------------------------------------------------
                            	   622: c_copy_bank_to_window:
02:0002B666 202F0004        	   623:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   624:     jmp     _copy_bank_to_window
                            	   625: 
                            	   626: ;------------------------------------------------------------------------------
                            	   627: ; unsigned char c_ppu_read_2(void);
                            	   628: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   629: ; C return: gcc expects result in D0.
                            	   630: ;------------------------------------------------------------------------------
                            	   631: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   632:     jmp     _ppu_read_2
                            	   633: 
                            	   634: ;------------------------------------------------------------------------------
                            	   635: ; void c_ppu_write_6(unsigned int val);
                            	   636: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   637: ;------------------------------------------------------------------------------
                            	   638: c_ppu_write_6:
02:0002B674 202F0004        	   639:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   640:     jmp     _ppu_write_6
                            	   641: 
                            	   642: ;------------------------------------------------------------------------------
                            	   643: ; void c_ppu_write_7(unsigned int val);
                            	   644: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   645: ;------------------------------------------------------------------------------
                            	   646: c_ppu_write_7:
02:0002B67E 202F0004        	   647:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   648:     jmp     _ppu_write_7
                            	   649: 
                            	   650: ;------------------------------------------------------------------------------
                            	   651: ; void c_turn_off_all_video(void);
                            	   652: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   653: ;------------------------------------------------------------------------------
                            	   654: c_turn_off_all_video:
02:0002B688 4EF90004AA3C    	   655:     jmp     TurnOffAllVideo
                            	   656: 
                            	   657: ;==============================================================================
                            	   658: ; EXPORT side — z_03 entry point.
                            	   659: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   660: ; the transpiler emits that label pointing to this shim instead of the
                            	   661: ; z_03 asm body. The C function takes no args and returns void.
                            	   662: ;==============================================================================
                            	   663: 
                            	   664: ;------------------------------------------------------------------------------
                            	   665: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   666: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   667: ;------------------------------------------------------------------------------
                            	   668: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   669:     jmp     z03_transfer_level_pattern_blocks
                            	   670: 
                            	   671: ;==============================================================================
                            	   672: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   673: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   674: ;==============================================================================
                            	   675: 
                            	   676: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   677:     jmp     z06_init_mode2_submodes
                            	   678: 
                            	   679: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   680:     jmp     z06_copy_common_data_to_ram
                            	   681: 
                            	   682: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   683:     jmp     z06_update_mode2_load_full
                            	   684: 
                            	   685: ;==============================================================================
                            	   686: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   687: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   688: ;==============================================================================
                            	   689: 
                            	   690: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   691:     jmp     z05_copy_column_to_tilebuf
                            	   692: 
                            	   693: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   694:     jmp     z05_copy_row_to_tilebuf
                            	   695: 
