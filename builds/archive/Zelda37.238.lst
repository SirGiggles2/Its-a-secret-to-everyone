                            	 12304: 
                            	 12305:     even
                            	 12306: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12307:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12308:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12309:     ; a small circle (5) and a large circle (6).
                            	 12310:     ;
02:0003F27C 41F90003F152    	 12311:     lea     (PatraChild2RotationBits).l,A0
02:0003F282 10303000        	 12312:     move.b  (A0,D3.W),D0
02:0003F286 7600            	 12313:     moveq   #0,D3
02:0003F288 1600            	 12314:     move.b  D0,D3
