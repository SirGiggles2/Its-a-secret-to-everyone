02:0003BDAA 19430003        	  5187:     move.b  D3,($0003,A4)
                            	  5188:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5189:     ;
02:0003BDAE 7024            	  5190:     moveq   #36,D0
02:0003BDB0 7600            	  5191:     moveq   #0,D3
02:0003BDB2 162C03F8        	  5192:     move.b  ($03F8,A4),D3
