02:0004CC1A 003C0011        	  6586:     ori     #$11,CCR  ; SEC: set C+X
02:0004CC1E 41EC0084        	  6587:     lea     ($0084,A4),A0
02:0004CC22 12302000        	  6588:     move.b  (A0,D2.W),D1
