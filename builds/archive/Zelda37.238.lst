02:0004389A 60C4            	  5822:     jmp  L165D4_Exit
                            	  5823: __far_z_05_0080:
                            	  5824:     ; Turn the door command into the desired open or closed state
                            	  5825:     ; to store in [08].
                            	  5826:     ;
                            	  5827:     ; cmd:  7 6 3 2 
                            	  5828:     ; [08]: 2 0 0 0
                            	  5829:     ;
                            	  5830:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5831:     ; commands intended to be used.
                            	  5832:     ;
                            	  5833:     ; 3 is the end state of 2: close
                            	  5834:     ; 7 is the end state of 6: open
                            	  5835:     ;
02:0004389C 02000007        	  5836:     andi.b #$07,D0
02:000438A0 7601            	  5837:     moveq   #1,D3
02:000438A2 19430002        	  5838:     move.b  D3,($0002,A4)
02:000438A6 122C0002        	  5839:     move.b  ($0002,A4),D1
02:000438AA C200            	  5840:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000438AC 6702            	  5841:     beq  _anon_z05_118
02:000438AE E208            	  5842:     lsr.b  #1,D0   ; LSR A
                            	  5843: _anon_z05_118:
02:000438B0 0C000002        	  5844:     cmpi.b  #$02,D0
02:000438B4 6606            	  5845:     bne  _anon_z05_119
                            	  5846:     ; Command 2 sets Link's timer to $30.
                            	  5847:     ;
02:000438B6 7630            	  5848:     moveq   #48,D3
02:000438B8 19430028        	  5849:     move.b  D3,($0028,A4)
                            	  5850: _anon_z05_119:
02:000438BC 02000003        	  5851:     andi.b #$03,D0
02:000438C0 003C0011        	  5852:     ori     #$11,CCR  ; SEC: set C+X
02:000438C4 123C0001        	  5853:     move.b  #$01,D1
02:000438C8 0A3C0010        	  5854:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000438CC 9101            	  5855:     subx.b  D1,D0   ; SBC #$01
02:000438CE 0A3C0010        	  5856:     eori    #$10,CCR  ; restore X = 6502 C
02:000438D2 02000002        	  5857:     andi.b #$02,D0
02:000438D6 19400008        	  5858:     move.b  D0,($0008,A4)
                            	  5859:     ; The command to close a key door or bombable wall does not
                            	  5860:     ; do anything.
                            	  5861:     ;
02:000438DA 102C0054        	  5862:     move.b  ($0054,A4),D0
02:000438DE 0C000005        	  5863:     cmpi.b  #$05,D0
02:000438E2 6416            	  5864:     bcc  _anon_z05_120
02:000438E4 102C0055        	  5865:     move.b  ($0055,A4),D0
02:000438E8 19400002        	  5866:     move.b  D0,($0002,A4)
02:000438EC 6100FAEC        	  5867:     jsr     FindDoorAttrByDoorBit
02:000438F0 0C000007        	  5868:     cmpi.b  #$07,D0
02:000438F4 6704            	  5869:     beq  _anon_z05_120
02:000438F6 6000009C        	  5870:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5871: 
                            	  5872: _anon_z05_120:
                            	  5873:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5874:     ;
                            	  5875:     ; Shutters and the commands to open a door always change
                            	  5876:     ; tiles.
                            	  5877:     ;
02:000438FA 61000130        	  5878:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5879:     even
                            	  5880: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5881:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5882:     ; We need to remember how many tiles need to be copied
                            	  5883:     ; in each transfer record.
                            	  5884:     ;
02:000438FE 102C0006        	  5885:     move.b  ($0006,A4),D0
02:00043902 19400004        	  5886:     move.b  D0,($0004,A4)
                            	  5887:     ; Write the transfer record header for the door.
                            	  5888:     ;
                            	  5889:     ;
                            	  5890:     ; VRAM address high byte of door
02:00043906 1014            	  5891:     move.b  ($0000,A4),D0
02:00043908 41EC0302        	  5892:     lea     ($0302,A4),A0
02:0004390C 11802000        	  5893:     move.b  D0,(A0,D2.W)
02:00043910 5202            	  5894:     addq.b  #1,D2
02:00043912 102C0001        	  5895:     move.b  ($0001,A4),D0
02:00043916 41EC0302        	  5896:     lea     ($0302,A4),A0
02:0004391A 11802000        	  5897:     move.b  D0,(A0,D2.W)
02:0004391E 5202            	  5898:     addq.b  #1,D2
02:00043920 102C0006        	  5899:     move.b  ($0006,A4),D0
02:00043924 41EC0302        	  5900:     lea     ($0302,A4),A0
02:00043928 11802000        	  5901:     move.b  D0,(A0,D2.W)
02:0004392C 5202            	  5902:     addq.b  #1,D2
                            	  5903: _anon_z05_121:
                            	  5904:     ; Write two tiles in a short loop indexed by [04].
                            	  5905:     ;
02:0004392E 6100ED1C        	  5906:     jsr     WriteDoorFaceTileHorizontally
02:00043932 66FA            	  5907:     bne  _anon_z05_121
                            	  5908:     ; OR the low VRAM address with $20 to go down one row
                            	  5909:     ; in order to work on the second row of door tiles.
                            	  5910:     ;
02:00043934 7020            	  5911:     moveq   #32,D0
02:00043936 122C0001        	  5912:     move.b  ($0001,A4),D1
02:0004393A 8001            	  5913:     or.b  D1,D0
02:0004393C 19400001        	  5914:     move.b  D0,($0001,A4)
                            	  5915:     ; Bottom of the loop.
                            	  5916:     ; Loop again to write the second transfer record for the
                            	  5917:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5918:     ;
02:00043940 532C0005        	  5919:     subq.b  #1,($0005,A4)
02:00043944 66B8            	  5920:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5921:     ; Write the end marker, and update buffer length.
                            	  5922:     ;
02:00043946 103C00FF        	  5923:     move.b  #$FF,D0
02:0004394A 41EC0302        	  5924:     lea     ($0302,A4),A0
02:0004394E 11802000        	  5925:     move.b  D0,(A0,D2.W)
02:00043952 1002            	  5926:     move.b  D2,D0
02:00043954 19400301        	  5927:     move.b  D0,($0301,A4)
                            	  5928:     ; Increment the command.
                            	  5929:     ;
02:00043958 522C0054        	  5930:     addq.b  #1,($0054,A4)
                            	  5931:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5932:     ; and resetting the door command.
                            	  5933:     ; This ends up catching original states 3 and 7.
                            	  5934:     ;
                            	  5935:     ; Else set door timer to 8 and return.
                            	  5936:     ;
02:0004395C 102C0054        	  5937:     move.b  ($0054,A4),D0
02:00043960 02000003        	  5938:     andi.b #$03,D0
02:00043964 6708            	  5939:     beq  _anon_z05_122
02:00043966 7008            	  5940:     moveq   #8,D0
02:00043968 19400027        	  5941:     move.b  D0,($0027,A4)
02:0004396C 4E75            	  5942:     rts
                            	  5943: 
                            	  5944: _anon_z05_122:
                            	  5945:     ; If the door command = 4 after incrementing it, then
                            	  5946:     ; it was 3 (close door). So:
                            	  5947:     ; 1. reset this door's flag
                            	  5948:     ; 2. remove it from the opened door mask
                            	  5949:     ; 3. reset the door command
                            	  5950:     ; 4. go lay out doors in the play area map
                            	  5951:     ;
02:0004396E 102C0054        	  5952:     move.b  ($0054,A4),D0
02:00043972 0C000004        	  5953:     cmpi.b  #$04,D0
02:00043976 6626            	  5954:     bne  _anon_z05_123
02:00043978 7400            	  5955:     moveq   #0,D2
02:0004397A 142C0009        	  5956:     move.b  ($0009,A4),D2
02:0004397E 6100DC00        	  5957:     jsr     ResetDoorFlag
02:00043982 102C0055        	  5958:     move.b  ($0055,A4),D0
02:00043986 0A00000F        	  5959:     eori.b #$0F,D0
02:0004398A 122C00EE        	  5960:     move.b  ($00EE,A4),D1
02:0004398E C001            	  5961:     and.b  D1,D0
                            	  5962:     even
                            	  5963: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043990 194000EE        	  5964:     move.b  D0,($00EE,A4)
                            	  5965:     even
                            	  5966: L_ResetDoorCmdAndLayOutDoors:
02:00043994 7000            	  5967:     moveq   #0,D0
02:00043996 19400054        	  5968:     move.b  D0,($0054,A4)
02:0004399A 6000FCD4        	  5969:     jmp     LayOutDoors
                            	  5970: 
                            	  5971: _anon_z05_123:
                            	  5972:     ; Door command <> 4.
                            	  5973:     ; It must be 8, which means it was 7: open door.
                            	  5974:     ;
                            	  5975:     ; If the door is a shutter (7), then go add the door to the
                            	  5976:     ; opened door mask, reset door command, and lay out doors.
                            	  5977:     ;
02:0004399E 102C0055        	  5978:     move.b  ($0055,A4),D0
02:000439A2 19400002        	  5979:     move.b  D0,($0002,A4)
02:000439A6 6100FA32        	  5980:     jsr     FindDoorAttrByDoorBit
02:000439AA 0C000007        	  5981:     cmpi.b  #$07,D0
02:000439AE 676E            	  5982:     beq  _anon_z05_124
                            	  5983:     ; Else the door is not a shutter.
                            	  5984:     ;
                            	  5985:     ;
                            	  5986:     ; [09] door direction index
02:000439B0 7400            	  5987:     moveq   #0,D2
02:000439B2 142C0009        	  5988:     move.b  ($0009,A4),D2
02:000439B6 6100DBC2        	  5989:     jsr     SetDoorFlag
                            	  5990:     ; Get the next room's ID.
                            	  5991:     ;
02:000439BA 1003            	  5992:     move.b  D3,D0
02:000439BC 023C00EE        	  5993:     andi    #$EE,CCR  ; CLC: clear C+X
02:000439C0 41F90004387C    	  5994:     lea     (DoorNextRoomIdOffsets).l,A0
02:000439C6 12302000        	  5995:     move.b  (A0,D2.W),D1
02:000439CA D101            	  5996:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000439CC 7600            	  5997:     moveq   #0,D3
02:000439CE 1600            	  5998:     move.b  D0,D3
                            	  5999:     ; Flip the door direction index.
                            	  6000:     ;
02:000439D0 1002            	  6001:     move.b  D2,D0
02:000439D2 0A000001        	  6002:     eori.b #$01,D0
02:000439D6 7400            	  6003:     moveq   #0,D2
02:000439D8 1400            	  6004:     move.b  D0,D2
                            	  6005:     ; Set the door flag for the opposite door in the next room.
                            	  6006:     ;
02:000439DA 1214            	  6007:     move.b  ($00,A4),D1   ; ptr lo
02:000439DC 182C0001        	  6008:     move.b  ($01,A4),D4  ; ptr hi
02:000439E0 024100FF        	  6009:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439E4 E14C            	  6010:     lsl.w   #8,D4
02:000439E6 8841            	  6011:     or.w    D1,D4             ; D4 = NES ptr addr
02:000439E8 48C4            	  6012:     ext.l   D4
02:000439EA D8BC00FF0000    	  6013:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000439F0 2044            	  6014:     movea.l D4,A0
02:000439F2 10303000        	  6015:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000439F6 41F90004AB90    	  6016:     lea     (LevelMasks).l,A0
02:000439FC 12302000        	  6017:     move.b  (A0,D2.W),D1
02:00043A00 8001            	  6018:     or.b  D1,D0
02:00043A02 1214            	  6019:     move.b  ($00,A4),D1   ; ptr lo
02:00043A04 182C0001        	  6020:     move.b  ($01,A4),D4  ; ptr hi
02:00043A08 024100FF        	  6021:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A0C E14C            	  6022:     lsl.w   #8,D4
02:00043A0E 8841            	  6023:     or.w    D1,D4
02:00043A10 48C4            	  6024:     ext.l   D4
02:00043A12 D8BC00FF0000    	  6025:     add.l   #NES_RAM,D4
02:00043A18 2044            	  6026:     movea.l D4,A0
02:00043A1A 11803000        	  6027:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6028: _anon_z05_124:
                            	  6029:     ; Add the door to the opened door mask, reset door command,
                            	  6030:     ; and lay out doors.
                            	  6031:     ;
02:00043A1E 102C0055        	  6032:     move.b  ($0055,A4),D0
02:00043A22 122C00EE        	  6033:     move.b  ($00EE,A4),D1
02:00043A26 8001            	  6034:     or.b  D1,D0
02:00043A28 6000FF66        	  6035:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6036: 
                            	  6037: ; Params:
                            	  6038: ; [08]: 0 if closed
                            	  6039: ;
                            	  6040: ; Returns:
                            	  6041: ; X: current length of dynamic transfer buf
                            	  6042: ; [00]: door VRAM address high byte
                            	  6043: ; [01]: door VRAM address low byte
                            	  6044: ; [02:03]: address of door tiles for direction and face
                            	  6045: ; [05]: 2, the number of transfer records to write
                            	  6046: ; [06]: 2, the number of tiles in each record
                            	  6047: ; [07]: 0, the first index of a tile to transfer
                            	  6048: ; [09]: door direction index
                            	  6049: ;
                            	  6050: ; Note that this routine is called with triggered doors:
                            	  6051: ; doors that can change state. Their door type numbers are >= 4.
                            	  6052: ;
                            	  6053: ; If this routine were ever called with a fixed door
                            	  6054: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6055: ; values for the door face.
                            	  6056: ;
                            	  6057: ;
                            	  6058: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6059: ;
                            	  6060:     even
                            	  6061: PrepareWriteHorizontalDoorTransferRecords:
02:00043A2C 102C0055        	  6062:     move.b  ($0055,A4),D0
02:00043A30 19400002        	  6063:     move.b  D0,($0002,A4)
02:00043A34 6100F9A4        	  6064:     jsr     FindDoorAttrByDoorBit
02:00043A38 0C000005        	  6065:     cmpi.b  #$05,D0
02:00043A3C 650C            	  6066:     bcs  _anon_z05_125
02:00043A3E 1B00            	  6067:     move.b  D0,-(A5)  ; PHA
02:00043A40 7004            	  6068:     moveq   #4,D0
02:00043A42 4EB900030A1A    	  6069:     jsr     PlaySample
02:00043A48 101D            	  6070:     move.b  (A5)+,D0  ; PLA
                            	  6071: _anon_z05_125:
                            	  6072:     ; Calculate the door face index in three parts.
                            	  6073:     ;
                            	  6074:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6075:     ; (provisional face index in Y register).
                            	  6076:     ;
02:00043A4A 0C000004        	  6077:     cmpi.b  #$04,D0
02:00043A4E 6602            	  6078:     bne  _anon_z05_126
02:00043A50 7008            	  6079:     moveq   #8,D0
                            	  6080: _anon_z05_126:
02:00043A52 0C000001        	  6081:     cmpi.b  #$01,D0
02:00043A56 6602            	  6082:     bne  _anon_z05_127
02:00043A58 7004            	  6083:     moveq   #4,D0
                            	  6084: _anon_z05_127:
                            	  6085:     ; Second, subtract 3 from provisional face index.
                            	  6086:     ;
02:00043A5A 003C0011        	  6087:     ori     #$11,CCR  ; SEC: set C+X
02:00043A5E 123C0003        	  6088:     move.b  #$03,D1
02:00043A62 0A3C0010        	  6089:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A66 9101            	  6090:     subx.b  D1,D0   ; SBC #$03
02:00043A68 0A3C0010        	  6091:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A6C 7600            	  6092:     moveq   #0,D3
02:00043A6E 1600            	  6093:     move.b  D0,D3
                            	  6094:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6095:     ; face index >= 3, then subtract 1 from it.
                            	  6096:     ;
                            	  6097:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6098:     ; then make it 1.
                            	  6099:     ;
02:00043A70 102C0008        	  6100:     move.b  ($0008,A4),D0
02:00043A74 6708            	  6101:     beq  _anon_z05_128
02:00043A76 0C030005        	  6102:     cmpi.b  #$05,D3
02:00043A7A 670A            	  6103:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
