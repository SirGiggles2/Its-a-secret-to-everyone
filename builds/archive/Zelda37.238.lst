                            	  6973: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6974:     ; To animate the state, the animation counter had to have
                            	  6975:     ; reached 0. Right after this routine, the counter will be
                            	  6976:     ; rolled over, and the movement frame will be switched.
                            	  6977:     ;
                            	  6978:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6979:     ; the animation here, in order to immediately change it to
                            	  6980:     ; 0 (legs apart) after this.
                            	  6981:     ;
02:0004CE6C 7001            	  6982:     moveq   #1,D0
02:0004CE6E 194003E4        	  6983:     move.b  D0,($03E4,A4)
02:0004CE72 4E75            	  6984:     rts
                            	  6985: 
                            	  6986:     even
                            	  6987: _L_z07_AnimateLinkObjState_CheckState30:
                            	  6988:     ; If in state $30, then make Link idle, except for halting.
                            	  6989:     ;
