02:00043A94 9101            	  6120:     subx.b  D1,D0   ; SBC $03
02:00043A96 0A3C0010        	  6121:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6122:     ; Call this to put the address of door face tiles in [02:03].
                            	  6123:     ;
02:00043A9A 6100FD7A        	  6124:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6125:     ; Return the address of the door in the nametable in [01:00].
