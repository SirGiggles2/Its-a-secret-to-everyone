                            	  5634:     ;
02:0004C53A 6100F570        	  5635:     jsr     MoveObject
                            	  5636:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5637:     ; state to $40.
                            	  5638:     ;
02:0004C53E 41EC0380        	  5639:     lea     ($0380,A4),A0
