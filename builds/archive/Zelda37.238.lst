                            	  2209: WhirlwindPrevRoomIdList:
02:00030102 36              	  2210:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:00030103 3B
02:00030104 73
02:00030105 44
02:00030106 0A
02:00030107 21
02:00030108 41
02:00030109 6C
                            	  2211: 
                            	  2212:     even
                            	  2213: UpdateWhirlwind_Full:
                            	  2214:     ; Get Link's halted state.
                            	  2215:     ;
02:0003010A 102C00AC        	  2216:     move.b  ($00AC,A4),D0
02:0003010E 02000040        	  2217:     andi.b #$40,D0
02:00030112 7600            	  2218:     moveq   #0,D3
02:00030114 1600            	  2219:     move.b  D0,D3
                            	  2220:     ; Add 2 to whirlwind X.
                            	  2221:     ;
02:00030116 7002            	  2222:     moveq   #2,D0
02:00030118 023C00EE        	  2223:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003011C 12342070        	  2224:     move.b  ($70,A4,D2.W),D1
02:00030120 D101            	  2225:     addx.b  D1,D0   ; ADC ObjX,X
02:00030122 19802070        	  2226:     move.b  D0,($70,A4,D2.W)
                            	  2227:     ; If Link is not halted or teleporting state = 0, then
                            	  2228:     ; go check for collision with Link.
                            	  2229:     ;
02:00030126 0C030040        	  2230:     cmpi.b  #$40,D3
02:0003012A 6638            	  2231:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0003012C 7600            	  2232:     moveq   #0,D3
02:0003012E 162C0522        	  2233:     move.b  ($0522,A4),D3
02:00030132 6730            	  2234:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2235:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2236:     ;
                            	  2237:     ; Set Link's X to whirlwind's.
                            	  2238:     ;
02:00030134 19400070        	  2239:     move.b  D0,($0070,A4)
                            	  2240:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2241:     ; the right screen edge and draw.
                            	  2242:     ;
02:00030138 5303            	  2243:     subq.b  #1,D3
02:0003013A 6776            	  2244:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0003013C 0C000080        	  2245:     cmpi.b  #$80,D0
02:00030140 6670            	  2246:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2247:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2248:     ;
                            	  2249:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2250:     ;
02:00030142 E308            	  2251:     lsl.b  #1,D0   ; ASL A
02:00030144 194000AC        	  2252:     move.b  D0,($00AC,A4)
02:00030148 19400522        	  2253:     move.b  D0,($0522,A4)
02:0003014C 41EC034F        	  2254:     lea     ($034F,A4),A0
02:00030150 11802000        	  2255:     move.b  D0,(A0,D2.W)
                            	  2256:     ; Update the player position marker, and draw one last time.
                            	  2257:     ;
02:00030154 1002            	  2258:     move.b  D2,D0
02:00030156 1B00            	  2259:     move.b  D0,-(A5)  ; PHA
02:00030158 61001096        	  2260:     jsr     UpdatePlayerPositionMarker
02:0003015C 101D            	  2261:     move.b  (A5)+,D0  ; PLA
02:0003015E 7400            	  2262:     moveq   #0,D2
02:00030160 1400            	  2263:     move.b  D0,D2
02:00030162 6070            	  2264:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2265: 
                            	  2266:     even
                            	  2267: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2268:     ; Link is not halted or teleporting state = 0.
                            	  2269:     ; Try to pick up Link.
                            	  2270:     ;
                            	  2271:     ; If the whirlwind does not collide with Link, then go check
                            	  2272:     ; for the screen's right edge.
                            	  2273:     ;
02:00030164 61001D64        	  2274:     jsr     CheckLinkCollision
02:00030168 102C0006        	  2275:     move.b  ($0006,A4),D0
02:0003016C 6744            	  2276:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2277:     ; Collided with Link.
                            	  2278:     ;
                            	  2279:     ; Make Link face right. Reset shove info and subroom type.
                            	  2280:     ;
02:0003016E 7001            	  2281:     moveq   #1,D0
02:00030170 19400098        	  2282:     move.b  D0,($0098,A4)
02:00030174 E208            	  2283:     lsr.b  #1,D0   ; LSR A
02:00030176 194000C0        	  2284:     move.b  D0,($00C0,A4)
02:0003017A 194000D3        	  2285:     move.b  D0,($00D3,A4)
02:0003017E 1940005A        	  2286:     move.b  D0,($005A,A4)
                            	  2287:     ; Halt Link (state $40), and hide him.
                            	  2288:     ;
02:00030182 7040            	  2289:     moveq   #64,D0
02:00030184 194000AC        	  2290:     move.b  D0,($00AC,A4)
02:00030188 103C00F8        	  2291:     move.b  #$F8,D0
02:0003018C 19400248        	  2292:     move.b  D0,($0248,A4)
02:00030190 1940024C        	  2293:     move.b  D0,($024C,A4)
                            	  2294:     ; Find and set the room that will behave as the previous room
                            	  2295:     ; when scrolling right to the room with the level's entrance.
                            	  2296:     ;
02:00030194 102C0523        	  2297:     move.b  ($0523,A4),D0
02:00030198 02000007        	  2298:     andi.b #$07,D0
02:0003019C 7600            	  2299:     moveq   #0,D3
02:0003019E 1600            	  2300:     move.b  D0,D3
02:000301A0 41F900030102    	  2301:     lea     (WhirlwindPrevRoomIdList).l,A0
02:000301A6 10303000        	  2302:     move.b  (A0,D3.W),D0
02:000301AA 194000EA        	  2303:     move.b  D0,($00EA,A4)
                            	  2304:     ; Set teleporting state 1.
                            	  2305:     ;
02:000301AE 522C0522        	  2306:     addq.b  #1,($0522,A4)
                            	  2307:     even
                            	  2308: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2309:     ; If whirlwind's X < $F0, go draw.
                            	  2310:     ;
02:000301B2 10342070        	  2311:     move.b  ($70,A4,D2.W),D0
