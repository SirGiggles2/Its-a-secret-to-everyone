                            	 12872: Ganon_DrawBody:
                            	 12873:     ; Loop over four 16x16 images that make up Ganon.
                            	 12874:     ; There are 6 animation frames.
                            	 12875:     ;
02:0003F65E 7603            	 12876:     moveq   #3,D3
                            	 12877:     even
                            	 12878: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12879:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12880:     ;
02:0003F660 10342070        	 12881:     move.b  ($70,A4,D2.W),D0
02:0003F664 023C00EE        	 12882:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F668 41F90003F652    	 12883:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F66E 12303000        	 12884:     move.b  (A0,D3.W),D1
02:0003F672 D101            	 12885:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F674 1880            	 12886:     move.b  D0,($0000,A4)
                            	 12887:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12888:     ;
02:0003F676 41EC0084        	 12889:     lea     ($0084,A4),A0
02:0003F67A 10302000        	 12890:     move.b  (A0,D2.W),D0
02:0003F67E 023C00EE        	 12891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F682 41F90003F656    	 12892:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F688 12303000        	 12893:     move.b  (A0,D3.W),D1
02:0003F68C D101            	 12894:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F68E 19400001        	 12895:     move.b  D0,($0001,A4)
                            	 12896:     ; Each part has a horizontal flipping flag.
                            	 12897:     ;
02:0003F692 41F90003F65A    	 12898:     lea     (GanonSpriteHFlips).l,A0
02:0003F698 10303000        	 12899:     move.b  (A0,D3.W),D0
02:0003F69C 1940000F        	 12900:     move.b  D0,($000F,A4)
                            	 12901:     ; Save and copy the loop index (the current part) to [07].
                            	 12902:     ;
02:0003F6A0 1003            	 12903:     move.b  D3,D0
02:0003F6A2 1B00            	 12904:     move.b  D0,-(A5)  ; PHA
02:0003F6A4 19400007        	 12905:     move.b  D0,($0007,A4)
                            	 12906:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12907:     ; that make it up.
                            	 12908:     ;
02:0003F6A8 41EC046B        	 12909:     lea     ($046B,A4),A0
02:0003F6AC 10302000        	 12910:     move.b  (A0,D2.W),D0
02:0003F6B0 E308            	 12911:     lsl.b  #1,D0   ; ASL A
02:0003F6B2 E308            	 12912:     lsl.b  #1,D0   ; ASL A
                            	 12913:     ; Add [07] -- the index of the current part.
                            	 12914:     ;
                            	 12915:     ; Now you have an index into the frame image table, for the
                            	 12916:     ; current image part of the current animation frame.
                            	 12917:     ;
02:0003F6B4 122C0007        	 12918:     move.b  ($0007,A4),D1
02:0003F6B8 D101            	 12919:     addx.b  D1,D0   ; ADC $07
02:0003F6BA 7600            	 12920:     moveq   #0,D3
02:0003F6BC 1600            	 12921:     move.b  D0,D3
02:0003F6BE 41F90003F63A    	 12922:     lea     (GanonFrameImages).l,A0
02:0003F6C4 10303000        	 12923:     move.b  (A0,D3.W),D0
02:0003F6C8 4EB900031A04    	 12924:     jsr     DrawObjectNotMirrored
02:0003F6CE 101D            	 12925:     move.b  (A5)+,D0  ; PLA
                            	 12926:     ; Bottom of the part loop.
                            	 12927:     ;
02:0003F6D0 7600            	 12928:     moveq   #0,D3
02:0003F6D2 1600            	 12929:     move.b  D0,D3
02:0003F6D4 5303            	 12930:     subq.b  #1,D3
02:0003F6D6 6A88            	 12931:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F6D8 4E75            	 12932:     rts
                            	 12933: 
