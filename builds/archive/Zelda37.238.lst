02:0003D066 10302000        	  7767:     move.b  (A0,D2.W),D0
02:0003D06A 02000003        	  7768:     andi.b #$03,D0
02:0003D06E 6618            	  7769:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
