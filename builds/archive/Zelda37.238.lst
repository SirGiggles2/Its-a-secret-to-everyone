02:0003CB62 41EC042C        	  7012:     lea     ($042C,A4),A0
02:0003CB66 52302000        	  7013:     addq.b  #1,(A0,D2.W)
                            	  7014:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7015:     ;
02:0003CB6A 41EC042C        	  7016:     lea     ($042C,A4),A0
