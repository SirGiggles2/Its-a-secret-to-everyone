02:0003C26E 0C030004        	  5768:     cmpi.b  #$04,D3
02:0003C272 6716            	  5769:     beq  _L_z04_UpdateMoldorm_Exit
02:0003C274 0C030009        	  5770:     cmpi.b  #$09,D3
02:0003C278 6710            	  5771:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5772:     ; Else finish swapping the segments.
