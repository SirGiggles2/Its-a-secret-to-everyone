                            	  6628: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6629:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6630:     ;   full heart=4 partial heart=$70
                            	  6631:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6632:     ; But the method here yields $3EF, because partial heart is
                            	  6633:     ; considered full when = $FF instead of $100.
                            	  6634:     ;
02:000320BE 102C000E        	  6635:     move.b  ($000E,A4),D0
02:000320C2 003C0011        	  6636:     ori     #$11,CCR  ; SEC: set C+X
02:000320C6 122C0670        	  6637:     move.b  ($0670,A4),D1
02:000320CA 0A3C0010        	  6638:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320CE 9101            	  6639:     subx.b  D1,D0   ; SBC HeartPartial
02:000320D0 0A3C0010        	  6640:     eori    #$10,CCR  ; restore X = 6502 C
02:000320D4 1940000E        	  6641:     move.b  D0,($000E,A4)
02:000320D8 102C066F        	  6642:     move.b  ($066F,A4),D0
02:000320DC 0200000F        	  6643:     andi.b #$0F,D0
02:000320E0 6710            	  6644:     beq  _L_z01_Link_BeHarmed_HandleDied
02:000320E2 532C066F        	  6645:     subq.b  #1,($066F,A4)
02:000320E6 103C00FF        	  6646:     move.b  #$FF,D0
02:000320EA 19400670        	  6647:     move.b  D0,($0670,A4)
02:000320EE 6600FF6E        	  6648:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6649:     even
                            	  6650: _L_z01_Link_BeHarmed_HandleDied:
                            	  6651:     ; Link died.
                            	  6652:     ;
                            	  6653:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6654:     ; Make Link face down.
                            	  6655:     ; Go to mode $11.
                            	  6656:     ;
02:000320F2 102C066F        	  6657:     move.b  ($066F,A4),D0
02:000320F6 020000F0        	  6658:     andi.b #$F0,D0
02:000320FA 1940066F        	  6659:     move.b  D0,($066F,A4)
02:000320FE 4EB90004B3CE    	  6660:     jsr     EndGameMode
