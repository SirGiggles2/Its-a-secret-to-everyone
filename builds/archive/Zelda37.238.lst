02:0003207C 122C000E        	  6603:     move.b  ($000E,A4),D1
02:00032080 0A3C0010        	  6604:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032084 9101            	  6605:     subx.b  D1,D0   ; SBC $0E
02:00032086 0A3C0010        	  6606:     eori    #$10,CCR  ; restore X = 6502 C
02:0003208A 19400670        	  6607:     move.b  D0,($0670,A4)
                            	  6608:     ; If full hearts >= high damage points byte, then simply
