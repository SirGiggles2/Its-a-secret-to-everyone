02:0002E710 19400604        	   819:     move.b  D0,($0604,A4)
                            	   820:     ; If the high 2 bits of character element = 0, then return.
                            	   821:     ;
02:0002E714 1214            	   822:     move.b  ($00,A4),D1   ; ptr lo
02:0002E716 182C0001        	   823:     move.b  ($01,A4),D4  ; ptr hi
02:0002E71A 024100FF        	   824:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E71E E14C            	   825:     lsl.w   #8,D4
