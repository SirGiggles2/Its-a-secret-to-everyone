02:0004CC00 0A3C0010        	  6577:     eori    #$10,CCR  ; restore X = 6502 C
02:0004CC04 4EB900030EB2    	  6578:     jsr     Abs
02:0004CC0A 0C000018        	  6579:     cmpi.b  #$18,D0
