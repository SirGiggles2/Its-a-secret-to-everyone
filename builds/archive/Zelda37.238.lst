02:0003F2E0 0003F374        	 12356:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12357: 
                            	 12358: ; Description:
                            	 12359: ; Lift up the Triforce of Courage while the room is dark.
                            	 12360: ;
                            	 12361: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12362: ;
                            	 12363:     even
                            	 12364: Ganon_ScenePhase0:
02:0003F2E4 701B            	 12365:     moveq   #27,D0
02:0003F2E6 19400505        	 12366:     move.b  D0,($0505,A4)
                            	 12367:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12368:     ;
02:0003F2EA 102C0028        	 12369:     move.b  ($0028,A4),D0
02:0003F2EE 6644            	 12370:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12371:     ; Once the timer expires, it's time to brighten the room.
                            	 12372:     ;
                            	 12373:     ; Save the current object slot.
02:0003F2F0 1002            	 12374:     move.b  D2,D0
02:0003F2F2 1B00            	 12375:     move.b  D0,-(A5)  ; PHA
02:0003F2F4 610007F0        	 12376:     jsr     UpdateCandle
02:0003F2F8 101D            	 12377:     move.b  (A5)+,D0  ; PLA
02:0003F2FA 7400            	 12378:     moveq   #0,D2
02:0003F2FC 1400            	 12379:     move.b  D0,D2
                            	 12380:     ; Turn off the room brightening flag, because we're controlling it
                            	 12381:     ; here instead of in the Mode 5 object update loop.
                            	 12382:     ;
02:0003F2FE 7000            	 12383:     moveq   #0,D0
02:0003F300 1940051E        	 12384:     move.b  D0,($051E,A4)
                            	 12385:     ; On the first frame of the fade-to-light cycle, play the
                            	 12386:     ; Triforce/Ganon song.
                            	 12387:     ;
02:0003F304 102C051C        	 12388:     move.b  ($051C,A4),D0
02:0003F308 0C0000C0        	 12389:     cmpi.b  #$C0,D0
02:0003F30C 6606            	 12390:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F30E 7002            	 12391:     moveq   #2,D0
02:0003F310 19400600        	 12392:     move.b  D0,($0600,A4)
                            	 12393:     even
                            	 12394: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
