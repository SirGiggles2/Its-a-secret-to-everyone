02:0003C714 19410002        	  6441:     move.b  D1,($0002,A4)
02:0003C718 122C0002        	  6442:     move.b  ($0002,A4),D1
02:0003C71C C200            	  6443:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C71E 6716            	  6444:     beq  _L_z04_Digdogger_Move_Up
02:0003C720 41EC0084        	  6445:     lea     ($0084,A4),A0
02:0003C724 10302000        	  6446:     move.b  (A0,D2.W),D0
02:0003C728 122C0003        	  6447:     move.b  ($0003,A4),D1
02:0003C72C D101            	  6448:     addx.b  D1,D0   ; ADC $03
02:0003C72E 41EC0084        	  6449:     lea     ($0084,A4),A0
02:0003C732 11802000        	  6450:     move.b  D0,(A0,D2.W)
                            	  6451:     even
