02:0003C73E 122C0002        	  6457:     move.b  ($0002,A4),D1
02:0003C742 E309            	  6458:     lsl.b  #1,D1   ; ASL $02
02:0003C744 19410002        	  6459:     move.b  D1,($0002,A4)
02:0003C748 122C0002        	  6460:     move.b  ($0002,A4),D1
02:0003C74C C200            	  6461:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C74E 671E            	  6462:     beq  _L_z04_Digdogger_Move_End
02:0003C750 41EC0084        	  6463:     lea     ($0084,A4),A0
02:0003C754 10302000        	  6464:     move.b  (A0,D2.W),D0
02:0003C758 122C0003        	  6465:     move.b  ($0003,A4),D1
02:0003C75C 0A3C0010        	  6466:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C760 9101            	  6467:     subx.b  D1,D0   ; SBC $03
02:0003C762 0A3C0010        	  6468:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C766 41EC0084        	  6469:     lea     ($0084,A4),A0
