02:0004D650 0C03000C        	  7752:     cmpi.b  #$0C,D3
02:0004D654 6502            	  7753:     bcs.s  __far_z_07_0125
02:0004D656 605C            	  7754:     jmp  L1FF28_Exit
                            	  7755: __far_z_07_0125:
                            	  7756:     ; 7 of every 8 frames, return.
                            	  7757:     ;
02:0004D658 102C0015        	  7758:     move.b  ($0015,A4),D0
02:0004D65C 02000007        	  7759:     andi.b #$07,D0
02:0004D660 0C000004        	  7760:     cmpi.b  #$04,D0
02:0004D664 6702            	  7761:     beq.s  __far_z_07_0126
02:0004D666 604C            	  7762:     jmp  L1FF28_Exit
                            	  7763: __far_z_07_0126:
                            	  7764:     ; So, every 8 frames:
                            	  7765:     ; 1. Increment the secret color cycle count.
                            	  7766:     ; 2. Change the water palette.
                            	  7767:     ;
                            	  7768:     ; But when the count = $B, go reveal the stairs.
                            	  7769:     ;
02:0004D668 522C051A        	  7770:     addq.b  #1,($051A,A4)
02:0004D66C 0C03000B        	  7771:     cmpi.b  #$0B,D3
02:0004D670 6602            	  7772:     bne.s  __far_z_07_0127
02:0004D672 6042            	  7773:     jmp  RevealPondStairs
