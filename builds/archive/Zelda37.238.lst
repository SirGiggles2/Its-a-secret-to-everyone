02:0003D018 67000084        	  7729:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7730:     ; Decrement grid offset / distance remaining.
                            	  7731:     ;
02:0003D01C 41EC0394        	  7732:     lea     ($0394,A4),A0
02:0003D020 53302000        	  7733:     subq.b  #1,(A0,D2.W)
                            	  7734:     ; Move vertically.
                            	  7735:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7736:     ;
