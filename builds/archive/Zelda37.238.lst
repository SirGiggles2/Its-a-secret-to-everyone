02:0003DF58 11802000        	  9729:     move.b  D0,(A0,D2.W)
                            	  9730:     ; Now we can go straight without changing direction for some time.
                            	  9731:     ;
02:0003DF5C 41EC0451        	  9732:     lea     ($0451,A4),A0
02:0003DF60 52302000        	  9733:     addq.b  #1,(A0,D2.W)
                            	  9734:     ; Go animate the eye.
                            	  9735:     ;
