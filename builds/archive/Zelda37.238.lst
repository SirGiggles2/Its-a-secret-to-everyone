                            	  9534: Manhandla_Move:
                            	  9535:     ; Implement a way of manifesting the fractional part of the speed
                            	  9536:     ; in the movement.
                            	  9537:     ;
                            	  9538:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9539:     ; byte to add to the coordinates, then the effective speed would
                            	  9540:     ; be 1 pixel a frame instead of 1.25.
                            	  9541:     ;
                            	  9542:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9543:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9544:     ;
                            	  9545:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9546:     ;
                            	  9547:     ;   SA := SA + (SL AND $E0)
                            	  9548:     ;   [03] := SH + carry
                            	  9549:     ;
                            	  9550:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9551:     ;
02:0003DDC4 41EC041F        	  9552:     lea     ($041F,A4),A0
02:0003DDC8 10302000        	  9553:     move.b  (A0,D2.W),D0
02:0003DDCC 020000E0        	  9554:     andi.b #$E0,D0
02:0003DDD0 023C00EE        	  9555:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDD4 41EC0412        	  9556:     lea     ($0412,A4),A0
02:0003DDD8 12302000        	  9557:     move.b  (A0,D2.W),D1
02:0003DDDC D101            	  9558:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DDDE 41EC0412        	  9559:     lea     ($0412,A4),A0
02:0003DDE2 11802000        	  9560:     move.b  D0,(A0,D2.W)
                            	  9561:     ; Assign (high speed byte + carry) to [03].
                            	  9562:     ;
02:0003DDE6 41EC042C        	  9563:     lea     ($042C,A4),A0
02:0003DDEA 10302000        	  9564:     move.b  (A0,D2.W),D0
02:0003DDEE 123C0000        	  9565:     move.b  #$00,D1
02:0003DDF2 D101            	  9566:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DDF4 19400003        	  9567:     move.b  D0,($0003,A4)
                            	  9568:     ; Change coordinates by the speed amount/offset in [03]
                            	  9569:     ; according to the direction.
                            	  9570:     ;
                            	  9571:     ; Start with a mask of $A1 in [02]:
                            	  9572:     ; - low nibble represents the right direction
                            	  9573:     ; - high nibble is used to set or clear carry as we go along
                            	  9574:     ;
02:0003DDF8 103C00A1        	  9575:     move.b  #$A1,D0
02:0003DDFC 19400002        	  9576:     move.b  D0,($0002,A4)
                            	  9577:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9578:     ;
02:0003DE00 41EC0098        	  9579:     lea     ($0098,A4),A0
02:0003DE04 10302000        	  9580:     move.b  (A0,D2.W),D0
02:0003DE08 122C0002        	  9581:     move.b  ($0002,A4),D1
02:0003DE0C C200            	  9582:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE0E 6712            	  9583:     beq  _L_z04_Manhandla_Move_Left
02:0003DE10 10342070        	  9584:     move.b  ($70,A4,D2.W),D0
02:0003DE14 023C00EE        	  9585:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE18 122C0003        	  9586:     move.b  ($0003,A4),D1
02:0003DE1C D101            	  9587:     addx.b  D1,D0   ; ADC $03
02:0003DE1E 19802070        	  9588:     move.b  D0,($70,A4,D2.W)
                            	  9589:     even
                            	  9590: _L_z04_Manhandla_Move_Left:
                            	  9591:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9592:     ;
02:0003DE22 41EC0098        	  9593:     lea     ($0098,A4),A0
02:0003DE26 10302000        	  9594:     move.b  (A0,D2.W),D0
02:0003DE2A 122C0002        	  9595:     move.b  ($0002,A4),D1
02:0003DE2E E309            	  9596:     lsl.b  #1,D1   ; ASL $02
02:0003DE30 19410002        	  9597:     move.b  D1,($0002,A4)
02:0003DE34 122C0002        	  9598:     move.b  ($0002,A4),D1
02:0003DE38 C200            	  9599:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE3A 6716            	  9600:     beq  _L_z04_Manhandla_Move_Down
02:0003DE3C 10342070        	  9601:     move.b  ($70,A4,D2.W),D0
02:0003DE40 122C0003        	  9602:     move.b  ($0003,A4),D1
02:0003DE44 0A3C0010        	  9603:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DE48 9101            	  9604:     subx.b  D1,D0   ; SBC $03
02:0003DE4A 0A3C0010        	  9605:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DE4E 19802070        	  9606:     move.b  D0,($70,A4,D2.W)
                            	  9607:     even
                            	  9608: _L_z04_Manhandla_Move_Down:
                            	  9609:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9610:     ;
02:0003DE52 41EC0098        	  9611:     lea     ($0098,A4),A0
02:0003DE56 10302000        	  9612:     move.b  (A0,D2.W),D0
02:0003DE5A 122C0002        	  9613:     move.b  ($0002,A4),D1
02:0003DE5E E309            	  9614:     lsl.b  #1,D1   ; ASL $02
02:0003DE60 19410002        	  9615:     move.b  D1,($0002,A4)
02:0003DE64 122C0002        	  9616:     move.b  ($0002,A4),D1
02:0003DE68 C200            	  9617:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE6A 6716            	  9618:     beq  _L_z04_Manhandla_Move_Up
02:0003DE6C 41EC0084        	  9619:     lea     ($0084,A4),A0
02:0003DE70 10302000        	  9620:     move.b  (A0,D2.W),D0
02:0003DE74 122C0003        	  9621:     move.b  ($0003,A4),D1
02:0003DE78 D101            	  9622:     addx.b  D1,D0   ; ADC $03
02:0003DE7A 41EC0084        	  9623:     lea     ($0084,A4),A0
02:0003DE7E 11802000        	  9624:     move.b  D0,(A0,D2.W)
                            	  9625:     even
                            	  9626: _L_z04_Manhandla_Move_Up:
                            	  9627:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9628:     ;
02:0003DE82 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003DE86 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003DE8A 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003DE8E E309            	  9632:     lsl.b  #1,D1   ; ASL $02
02:0003DE90 19410002        	  9633:     move.b  D1,($0002,A4)
02:0003DE94 122C0002        	  9634:     move.b  ($0002,A4),D1
02:0003DE98 C200            	  9635:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE9A 671E            	  9636:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DE9C 41EC0084        	  9637:     lea     ($0084,A4),A0
02:0003DEA0 10302000        	  9638:     move.b  (A0,D2.W),D0
02:0003DEA4 122C0003        	  9639:     move.b  ($0003,A4),D1
02:0003DEA8 0A3C0010        	  9640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DEAC 9101            	  9641:     subx.b  D1,D0   ; SBC $03
02:0003DEAE 0A3C0010        	  9642:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DEB2 41EC0084        	  9643:     lea     ($0084,A4),A0
02:0003DEB6 11802000        	  9644:     move.b  D0,(A0,D2.W)
                            	  9645:     even
                            	  9646: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9647:     ; To the frame accumulator, add:
                            	  9648:     ; - a random value between 0 and 3
                            	  9649:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9650:     ;
02:0003DEBA 10342019        	  9651:     move.b  ($19,A4,D2.W),D0
02:0003DEBE 02000003        	  9652:     andi.b #$03,D0
02:0003DEC2 023C00EE        	  9653:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEC6 122C0003        	  9654:     move.b  ($0003,A4),D1
02:0003DECA D101            	  9655:     addx.b  D1,D0   ; ADC $03
02:0003DECC 41EC0451        	  9656:     lea     ($0451,A4),A0
02:0003DED0 12302000        	  9657:     move.b  (A0,D2.W),D1
02:0003DED4 D101            	  9658:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DED6 41EC0451        	  9659:     lea     ($0451,A4),A0
02:0003DEDA 11802000        	  9660:     move.b  D0,(A0,D2.W)
02:0003DEDE 61001DD2        	  9661:     jsr     BoundFlyer
