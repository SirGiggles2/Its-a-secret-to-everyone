                            	  4907:     ;
02:000367FE 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:00036802 41F900036744    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00036808 10303000        	  4913:     move.b  (A0,D3.W),D0
02:0003680C 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
