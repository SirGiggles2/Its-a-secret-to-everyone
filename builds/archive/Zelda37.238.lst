                            	  4039: 
                            	  4040: ; Params:
                            	  4041: ; [0F]: moving direction
                            	  4042: ;
                            	  4043: ; Returns:
                            	  4044: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4045: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4046: ;
                            	  4047: ; When not at or in a doorway, this function leaves
                            	  4048: ; [0F] moving direction as is.
                            	  4049: ;
                            	  4050: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4051: ; will be left as is, assuming that it had been reset before this
                            	  4052: ; routine by BoundByRoom.
                            	  4053: ;
                            	  4054: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4055: ;
                            	  4056: ;
                            	  4057: ; If already in a doorway, go handle it separately.
                            	  4058: ;
                            	  4059:     even
                            	  4060: CheckDoorway:
02:00042190 102C0053        	  4061:     move.b  ($0053,A4),D0
