                            	  5944: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5945: ; Each set contains 4 offsets in reverse direction index order:
                            	  5946: ; up, down, left, right
                            	  5947: ;
                            	  5948: ; These offsets are added to player X to get weapon X.
                            	  5949: ;
                            	  5950:     even
                            	  5951: PlayerToWeaponOffsetsX:
02:0004C788 FF              	  5952:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004C789 01
02:0004C78A 00
02:0004C78B F8
02:0004C78C FF
02:0004C78D 01
02:0004C78E F5
02:0004C78F 0B
02:0004C790 FF              	  5953:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004C791 01
02:0004C792 F9
02:0004C793 07
02:0004C794 FF
02:0004C795 01
02:0004C796 FD
02:0004C797 03
                            	  5954: 
                            	  5955: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5956: ; Each set contains 4 offsets in reverse direction index order:
                            	  5957: ; up, down, left, right
                            	  5958: ;
                            	  5959: ; These offsets are added to player Y to get weapon Y.
                            	  5960: ;
                            	  5961:     even
