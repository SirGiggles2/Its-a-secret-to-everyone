02:0003C228 0C020006        	  5736:     cmpi.b  #$06,D2
02:0003C22C 6502            	  5737:     bcs  _anon_z04_80
02:0003C22E 7604            	  5738:     moveq   #4,D3
                            	  5739: _anon_z04_80:
02:0003C230 5203            	  5740:     addq.b  #1,D3
02:0003C232 41EC0350        	  5741:     lea     ($0350,A4),A0
02:0003C236 10303000        	  5742:     move.b  (A0,D3.W),D0
02:0003C23A 0C000041        	  5743:     cmpi.b  #$41,D0
02:0003C23E 66F0            	  5744:     bne  _anon_z04_80
                            	  5745:     ; I don't know why the object timer of the tail segment that will
                            	  5746:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5747:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5748:     ; there, the object timer is set to 6.
                            	  5749:     ;
02:0003C240 7011            	  5750:     moveq   #17,D0
02:0003C242 19803029        	  5751:     move.b  D0,($29,A4,D3.W)
                            	  5752:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5753:     ; segment to the tail segment.
                            	  5754:     ;
02:0003C246 41EC04F0        	  5755:     lea     ($04F0,A4),A0
02:0003C24A 10302000        	  5756:     move.b  (A0,D2.W),D0
02:0003C24E 41EC04F1        	  5757:     lea     ($04F1,A4),A0
02:0003C252 11803000        	  5758:     move.b  D0,(A0,D3.W)
02:0003C256 10342070        	  5759:     move.b  ($70,A4,D2.W),D0
02:0003C25A 19803071        	  5760:     move.b  D0,($71,A4,D3.W)
02:0003C25E 41EC0084        	  5761:     lea     ($0084,A4),A0
02:0003C262 10302000        	  5762:     move.b  (A0,D2.W),D0
02:0003C266 41EC0085        	  5763:     lea     ($0085,A4),A0
02:0003C26A 11803000        	  5764:     move.b  D0,(A0,D3.W)
                            	  5765:     ; If the tail segment found is also a head, then
                            	  5766:     ; the last segment has died. Return.
