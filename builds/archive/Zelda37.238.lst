                            	  4934: ; Params:
                            	  4935: ; X: shot object index
                            	  4936: ;
                            	  4937: ; If the object is a sword shot, go spread out the shot.
                            	  4938: ;
                            	  4939:     even
                            	  4940: HandleShotBlocked:
02:0004C084 41EC00AC        	  4941:     lea     ($00AC,A4),A0
02:0004C088 10302000        	  4942:     move.b  (A0,D2.W),D0
02:0004C08C E308            	  4943:     lsl.b  #1,D0   ; ASL A
