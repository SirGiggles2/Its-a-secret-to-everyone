                            	  5018: SpreadShot:
                            	  5019:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5020:     ;
                            	  5021:     ; The shot is spreading out.
                            	  5022:     ;
                            	  5023:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5024:     ; These will be negated appropriately for each corner.
                            	  5025:     ;
02:0004C11A 41EC0098        	  5026:     lea     ($0098,A4),A0
02:0004C11E 10302000        	  5027:     move.b  (A0,D2.W),D0
02:0004C122 19400002        	  5028:     move.b  D0,($0002,A4)
02:0004C126 19400003        	  5029:     move.b  D0,($0003,A4)
                            	  5030:     ; Reset [0F] to not flip horizontally.
                            	  5031:     ;
02:0004C12A 7000            	  5032:     moveq   #0,D0
02:0004C12C 1940000F        	  5033:     move.b  D0,($000F,A4)
                            	  5034:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5035:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5036:     ;
02:0004C130 7603            	  5037:     moveq   #3,D3
                            	  5038:     even
                            	  5039: _L_z07_SpreadShot_DrawShotCorner:
02:0004C132 1003            	  5040:     move.b  D3,D0
02:0004C134 1B00            	  5041:     move.b  D0,-(A5)  ; PHA
                            	  5042:     ; Save offset X [02] and Y offset [03].
                            	  5043:     ;
02:0004C136 102C0002        	  5044:     move.b  ($0002,A4),D0
02:0004C13A 1B00            	  5045:     move.b  D0,-(A5)  ; PHA
02:0004C13C 102C0003        	  5046:     move.b  ($0003,A4),D0
02:0004C140 1B00            	  5047:     move.b  D0,-(A5)  ; PHA
                            	  5048:     ; Calculate and set sprite attributes for this corner:
                            	  5049:     ;   base attribute OR (frame counter AND 3)
                            	  5050:     ;
                            	  5051:     ; The base attribute defines how to flip the sprite.
                            	  5052:     ; The frame counter makes the shot flash by cycling each
                            	  5053:     ; palette row.
                            	  5054:     ;
02:0004C142 102C0015        	  5055:     move.b  ($0015,A4),D0
02:0004C146 02000003        	  5056:     andi.b #$03,D0
02:0004C14A 41F90004BFA8    	  5057:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C150 12303000        	  5058:     move.b  (A0,D3.W),D1
02:0004C154 8001            	  5059:     or.b  D1,D0
02:0004C156 4EB900031CF6    	  5060:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5061:     ; Add the object's X (the center of the spread) and the
                            	  5062:     ; current offset in [02] to set sprite X in [00].
                            	  5063:     ;
02:0004C15C 10342070        	  5064:     move.b  ($70,A4,D2.W),D0
02:0004C160 023C00EE        	  5065:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C164 122C0002        	  5066:     move.b  ($0002,A4),D1
02:0004C168 D101            	  5067:     addx.b  D1,D0   ; ADC $02
02:0004C16A 1880            	  5068:     move.b  D0,($0000,A4)
                            	  5069:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5070:     ; Else calculate the distance from object X to sprite X.
                            	  5071:     ;
02:0004C16C 12342070        	  5072:     move.b  ($70,A4,D2.W),D1
02:0004C170 B001            	  5073:     cmp.b   D1,D0
02:0004C172 651A            	  5074:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C174 0C0000FC        	  5075:     cmpi.b  #$FC,D0
02:0004C178 6466            	  5076:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C17A 003C0011        	  5077:     ori     #$11,CCR  ; SEC: set C+X
02:0004C17E 12342070        	  5078:     move.b  ($70,A4,D2.W),D1
02:0004C182 0A3C0010        	  5079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C186 9101            	  5080:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C188 0A3C0010        	  5081:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C18C 6014            	  5082:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5083: 
                            	  5084:     even
                            	  5085: _L_z07_SpreadShot_ReverseSub:
02:0004C18E 10342070        	  5086:     move.b  ($70,A4,D2.W),D0
02:0004C192 003C0011        	  5087:     ori     #$11,CCR  ; SEC: set C+X
02:0004C196 1214            	  5088:     move.b  ($0000,A4),D1
02:0004C198 0A3C0010        	  5089:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C19C 9101            	  5090:     subx.b  D1,D0   ; SBC $00
02:0004C19E 0A3C0010        	  5091:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5092:     even
                            	  5093: _L_z07_SpreadShot_CheckDistance:
                            	  5094:     ; If distance >= $20, skip this corner.
                            	  5095:     ;
02:0004C1A2 0C000020        	  5096:     cmpi.b  #$20,D0
02:0004C1A6 6438            	  5097:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5098:     ; Add the object's Y (the center of the spread) and the
                            	  5099:     ; current offset in [03] to set sprite Y in [01].
                            	  5100:     ;
02:0004C1A8 41EC0084        	  5101:     lea     ($0084,A4),A0
02:0004C1AC 10302000        	  5102:     move.b  (A0,D2.W),D0
02:0004C1B0 023C00EE        	  5103:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1B4 122C0003        	  5104:     move.b  ($0003,A4),D1
02:0004C1B8 D101            	  5105:     addx.b  D1,D0   ; ADC $03
02:0004C1BA 19400001        	  5106:     move.b  D0,($0001,A4)
                            	  5107:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5108:     ;
02:0004C1BE 7600            	  5109:     moveq   #0,D3
02:0004C1C0 162C0010        	  5110:     move.b  ($0010,A4),D3
02:0004C1C4 670C            	  5111:     beq  _L_z07_SpreadShot_Draw
02:0004C1C6 0C00003E        	  5112:     cmpi.b  #$3E,D0
02:0004C1CA 6514            	  5113:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C1CC 0C0000E8        	  5114:     cmpi.b  #$E8,D0
02:0004C1D0 640E            	  5115:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_Draw:
                            	  5118:     ; Draw the corner.
                            	  5119:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5120:     ;
02:0004C1D2 7002            	  5121:     moveq   #2,D0
02:0004C1D4 1940000C        	  5122:     move.b  D0,($000C,A4)
02:0004C1D8 7623            	  5123:     moveq   #35,D3
02:0004C1DA 4EB900031C16    	  5124:     jsr     Anim_WriteItemSprites
                            	  5125:     even
                            	  5126: _L_z07_SpreadShot_NextCorner:
                            	  5127:     ; Prepare to process the next corner.
                            	  5128:     ;
                            	  5129:     ; First, restore X offset [02] and Y offset [03].
                            	  5130:     ;
02:0004C1E0 101D            	  5131:     move.b  (A5)+,D0  ; PLA
02:0004C1E2 19400003        	  5132:     move.b  D0,($0003,A4)
02:0004C1E6 101D            	  5133:     move.b  (A5)+,D0  ; PLA
02:0004C1E8 19400002        	  5134:     move.b  D0,($0002,A4)
                            	  5135:     ; Take turns negating X offset or Y offset for the next round.
                            	  5136:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5137:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5138:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5139:     ; - Fourth turn: doesn't matter
                            	  5140:     ;
                            	  5141:     ;
                            	  5142:     ; Get the loop index.
02:0004C1EC 101D            	  5143:     move.b  (A5)+,D0  ; PLA
02:0004C1EE 1B00            	  5144:     move.b  D0,-(A5)  ; PHA
02:0004C1F0 7600            	  5145:     moveq   #0,D3
02:0004C1F2 1600            	  5146:     move.b  D0,D3
02:0004C1F4 0C030001        	  5147:     cmpi.b  #$01,D3
02:0004C1F8 6602            	  5148:     bne  _anon_z07_25
02:0004C1FA 7603            	  5149:     moveq   #3,D3
                            	  5150: _anon_z07_25:
02:0004C1FC 10343000        	  5151:     move.b  ($00,A4,D3.W),D0
02:0004C200 4600            	  5152:     eori.b #$FF,D0
02:0004C202 023C00EE        	  5153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C206 123C0001        	  5154:     move.b  #$01,D1
02:0004C20A D101            	  5155:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C20C 19803000        	  5156:     move.b  D0,($00,A4,D3.W)
                            	  5157:     ; Restore the loop index, decrement it, and loop again if >= 0.
