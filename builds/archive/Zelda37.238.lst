02:0003B6B2 12342070        	  4257:     move.b  ($70,A4,D2.W),D1
02:0003B6B6 B001            	  4258:     cmp.b   D1,D0
02:0003B6B8 667C            	  4259:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  4260:     ; If the difference between Link's (Y + 3) and the block's Y
