                            	  5688: AnimateAndDrawObjectWalking:
02:000319F6 4EB90004CDC0    	  5689:     jsr     AnimateObjectWalking
02:000319FC 1003            	  5690:     move.b  D3,D0
02:000319FE 6004            	  5691:     jmp     DrawObjectNotMirrored
                            	  5692: 
                            	  5693: ; Params:
                            	  5694: ; A: frame image
                            	  5695: ; X: object index
                            	  5696: ; [00]: object X
                            	  5697: ; [01]: object Y
                            	  5698: ;
                            	  5699: ;
                            	  5700: ; Set [0C] mirrored.
                            	  5701:     even
                            	  5702: DrawObjectMirrored:
02:00031A00 7601            	  5703:     moveq   #1,D3
02:00031A02 6602            	  5704:     bne  _anon_z01_75
                            	  5705: ; Params:
                            	  5706: ; A: frame image
                            	  5707: ; X: object index
                            	  5708: ; [00]: object X
                            	  5709: ; [01]: object Y
                            	  5710: ; [0F]: flip horizontally
                            	  5711: ;
                            	  5712:     even
                            	  5713: DrawObjectNotMirrored:
02:00031A04 7600            	  5714:     moveq   #0,D3
                            	  5715: _anon_z01_75:
02:00031A06 1943000C        	  5716:     move.b  D3,($000C,A4)
                            	  5717:     ; Set animation index = object type + 1.
                            	  5718:     ;
02:00031A0A 7600            	  5719:     moveq   #0,D3
02:00031A0C 41EC034F        	  5720:     lea     ($034F,A4),A0
02:00031A10 16302000        	  5721:     move.b  (A0,D2.W),D3
                            	  5722: ; Params:
                            	  5723: ; A: frame
                            	  5724: ; X: object index/cycle sprite index
                            	  5725: ; Y: object type
                            	  5726: ; [00]: object X
                            	  5727: ; [01]: object Y
                            	  5728: ; [0C]: mirrored
                            	  5729: ; [0F]: flip horizontally
                            	  5730: ;
                            	  5731: ; Note:
                            	  5732: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5733: ;
