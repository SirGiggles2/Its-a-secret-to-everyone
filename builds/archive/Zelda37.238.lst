02:000419CA 4EB900030EAE    	  2910:     jsr     GetOppositeDir
                            	  2911: _anon_z05_75:
                            	  2912:     ; If in UW, use the second set of bounds by adding 4
                            	  2913:     ; to reverse direction index.
                            	  2914:     ;
                            	  2915:     ; Else in OW, and use first set that begins at offset 0.
                            	  2916:     ;
02:000419D0 102C0010        	  2917:     move.b  ($0010,A4),D0
02:000419D4 6710            	  2918:     beq  _anon_z05_76
02:000419D6 1003            	  2919:     move.b  D3,D0
02:000419D8 023C00EE        	  2920:     andi    #$EE,CCR  ; CLC: clear C+X
02:000419DC 123C0004        	  2921:     move.b  #$04,D1
02:000419E0 D101            	  2922:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000419E2 7600            	  2923:     moveq   #0,D3
02:000419E4 1600            	  2924:     move.b  D0,D3
                            	  2925: _anon_z05_76:
                            	  2926:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2927:     ;
02:000419E6 7000            	  2928:     moveq   #0,D0
                            	  2929: ; Params:
                            	  2930: ; A: mask of buttons to block
                            	  2931: ; Y: offset into BorderBounds
                            	  2932: ; [00]: direction
                            	  2933: ; [02]: coordinate
