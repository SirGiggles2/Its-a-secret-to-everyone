02:0003C5CA 41EC0437        	  6282:     lea     ($0437,A4),A0
02:0003C5CE 12302000        	  6283:     move.b  (A0,D2.W),D1
02:0003C5D2 B001            	  6284:     cmp.b   D1,D0
02:0003C5D4 6704            	  6285:     beq.s  __far_z_04_0053
