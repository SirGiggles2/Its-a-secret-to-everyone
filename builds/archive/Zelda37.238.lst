02:0003A230 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:0003A234 41EC041F        	  1262:     lea     ($041F,A4),A0
02:0003A238 10302000        	  1263:     move.b  (A0,D2.W),D0
02:0003A23C 7600            	  1264:     moveq   #0,D3
02:0003A23E 41EC0451        	  1265:     lea     ($0451,A4),A0
02:0003A242 16302000        	  1266:     move.b  (A0,D2.W),D3
