                            	  7401: DodongoFrameHFlipsBloated:
02:0003CDD6 00              	  7402:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CDD7 40
02:0003CDD8 00
02:0003CDD9 FF
02:0003CDDA 00
02:0003CDDB 00
02:0003CDDC 40
02:0003CDDD 00
