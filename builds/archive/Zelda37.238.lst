                            	  1781:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1782:     ;
02:0004110E 19400412        	  1783:     move.b  D0,($0412,A4)
02:00041112 023C00EE        	  1784:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041116 123C0010        	  1785:     move.b  #$10,D1
02:0004111A D101            	  1786:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004111C 19400084        	  1787:     move.b  D0,($0084,A4)
02:00041120 7008            	  1788:     moveq   #8,D0
02:00041122 19400603        	  1789:     move.b  D0,($0603,A4)
