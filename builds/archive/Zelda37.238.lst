02:0003CC66 123C0008        	  7155:     move.b  #$08,D1
02:0003CC6A D101            	  7156:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC6C 7600            	  7157:     moveq   #0,D3
02:0003CC6E 41EC0098        	  7158:     lea     ($0098,A4),A0
02:0003CC72 16302000        	  7159:     move.b  (A0,D2.W),D3
