02:0003DFC2 E309            	  9782:     lsl.b  #1,D1   ; ASL $02
02:0003DFC4 19410002        	  9783:     move.b  D1,($0002,A4)
02:0003DFC8 122C0002        	  9784:     move.b  ($0002,A4),D1
02:0003DFCC C200            	  9785:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DFCE 6708            	  9786:     beq  _anon_z04_120
02:0003DFD0 41EC0084        	  9787:     lea     ($0084,A4),A0
02:0003DFD4 52302000        	  9788:     addq.b  #1,(A0,D2.W)
                            	  9789: _anon_z04_120:
