02:0003208E 102C066F        	  6612:     move.b  ($066F,A4),D0
02:00032092 0200000F        	  6613:     andi.b #$0F,D0
02:00032096 122C000D        	  6614:     move.b  ($000D,A4),D1
02:0003209A B001            	  6615:     cmp.b   D1,D0
02:0003209C 6554            	  6616:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:0003209E 102C066F        	  6617:     move.b  ($066F,A4),D0
02:000320A2 003C0011        	  6618:     ori     #$11,CCR  ; SEC: set C+X
02:000320A6 122C000D        	  6619:     move.b  ($000D,A4),D1
02:000320AA 0A3C0010        	  6620:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000320AE 9101            	  6621:     subx.b  D1,D0   ; SBC $0D
02:000320B0 0A3C0010        	  6622:     eori    #$10,CCR  ; restore X = 6502 C
02:000320B4 1940066F        	  6623:     move.b  D0,($066F,A4)
02:000320B8 0A3C0001        	  6624:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000320BC 4E75            	  6625:     rts
