02:0003AC60 6100015E        	  2782:     jsr     Jumper_GetKind
02:0003AC64 41F90003AB50    	  2783:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AC6A 10303000        	  2784:     move.b  (A0,D3.W),D0
                            	  2785:     ; Get the acceleration by indexing with (base offset + direction).
