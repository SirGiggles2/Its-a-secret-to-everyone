                            	  7144: Dodongo_CheckBombHit:
                            	  7145:     ; If state <> 0 (not moving), then return.
                            	  7146:     ;
02:0003CC52 41EC00AC        	  7147:     lea     ($00AC,A4),A0
02:0003CC56 10302000        	  7148:     move.b  (A0,D2.W),D0
