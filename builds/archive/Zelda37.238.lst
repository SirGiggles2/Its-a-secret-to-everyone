                            	 13888: _anon_z04_175:
02:0003FD5A 1883            	 13889:     move.b  D3,($0000,A4)
                            	 13890:     even
                            	 13891: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13892:     ; Second, calculate a vertical component.
                            	 13893:     ; Combine it with the horizontal component:
                            	 13894:     ;
                            	 13895:     ; Y := 4 (down)
                            	 13896:     ; if observed player Y <> object Y then
                            	 13897:     ;   if observed player Y < object Y then
                            	 13898:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13899:     ;   [00] := [00] | Y
                            	 13900:     ;
02:0003FD5C 7601            	 13901:     moveq   #1,D3
02:0003FD5E 102C0062        	 13902:     move.b  ($0062,A4),D0
02:0003FD62 41EC0084        	 13903:     lea     ($0084,A4),A0
02:0003FD66 12302000        	 13904:     move.b  (A0,D2.W),D1
02:0003FD6A B001            	 13905:     cmp.b   D1,D0
