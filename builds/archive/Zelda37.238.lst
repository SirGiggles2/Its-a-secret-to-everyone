02:0002BFAA 08000008        	  2138:     btst    #8,D0
02:0002BFAE 670A            	  2139:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2140:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2141:     eori    #$01,CCR
02:0002BFB8 4E75            	  2142:     rts
                            	  2143: .cc_cnras:
02:0002BFBA 023C00FE        	  2144:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2145:     eori    #$01,CCR
02:0002BFC2 4E75            	  2146:     rts
                            	  2147: 
