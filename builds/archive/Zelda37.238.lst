                            	  3740: SecretArmosXs:
02:0003B376 E0              	  3741:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B377 B0
02:0003B378 B0
02:0003B379 30
02:0003B37A 40
02:0003B37B 90
02:0003B37C A0
