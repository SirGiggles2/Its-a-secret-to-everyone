02:0004C4EC 1940000F        	  5591:     move.b  D0,($000F,A4)
                            	  5592:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5593:     ; and go draw.
                            	  5594:     ;
02:0004C4F0 41EC0098        	  5595:     lea     ($0098,A4),A0
02:0004C4F4 10302000        	  5596:     move.b  (A0,D2.W),D0
02:0004C4F8 4EB900030EAE    	  5597:     jsr     GetOppositeDir
