02:0003C6FC 9101            	  6430:     subx.b  D1,D0   ; SBC $03
02:0003C6FE 0A3C0010        	  6431:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C702 19802070        	  6432:     move.b  D0,($70,A4,D2.W)
                            	  6433:     even
