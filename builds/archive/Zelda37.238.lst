02:00041CA8 102C0394        	  3360:     move.b  ($0394,A4),D0
02:00041CAC 6702            	  3361:     beq.s  __far_z_05_0060
02:00041CAE 6076            	  3362:     jmp  L14F72_Exit
                            	  3363: __far_z_05_0060:
                            	  3364:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3365:     ;
02:00041CB0 102C0084        	  3366:     move.b  ($0084,A4),D0
02:00041CB4 0C00009D        	  3367:     cmpi.b  #$9D,D0
02:00041CB8 6702            	  3368:     beq.s  __far_z_05_0061
02:00041CBA 606C            	  3369:     jmp  CheckCaveEdge
                            	  3370: __far_z_05_0061:
                            	  3371:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3372:     ; X = $50: 1
                            	  3373:     ; X = $80: 2
                            	  3374:     ; X = $B0: 3
                            	  3375:     ;
                            	  3376:     ; If he's not on any, then return.
                            	  3377:     ;
02:00041CBC 7601            	  3378:     moveq   #1,D3
02:00041CBE 102C0070        	  3379:     move.b  ($0070,A4),D0
02:00041CC2 0C000050        	  3380:     cmpi.b  #$50,D0
02:00041CC6 6712            	  3381:     beq  _anon_z05_83
02:00041CC8 5203            	  3382:     addq.b  #1,D3
02:00041CCA 0C000080        	  3383:     cmpi.b  #$80,D0
02:00041CCE 670A            	  3384:     beq  _anon_z05_83
02:00041CD0 5203            	  3385:     addq.b  #1,D3
02:00041CD2 0C0000B0        	  3386:     cmpi.b  #$B0,D0
02:00041CD6 6702            	  3387:     beq.s  __far_z_05_0062
02:00041CD8 604C            	  3388:     jmp  L14F72_Exit
                            	  3389: __far_z_05_0062:
                            	  3390: _anon_z05_83:
                            	  3391:     ; Look for the current room in the cellar/shortcut room array.
                            	  3392:     ;
02:00041CDA 1883            	  3393:     move.b  D3,($0000,A4)
02:00041CDC 163C00FF        	  3394:     move.b  #$FF,D3
02:00041CE0 102C00EB        	  3395:     move.b  ($00EB,A4),D0
                            	  3396: _anon_z05_84:
02:00041CE4 5203            	  3397:     addq.b  #1,D3
02:00041CE6 41F900FF6BB2    	  3398:     lea     (NES_SRAM+$0BB2).l,A0
02:00041CEC 12303000        	  3399:     move.b  (A0,D3.W),D1
02:00041CF0 B001            	  3400:     cmp.b   D1,D0
02:00041CF2 66F0            	  3401:     bne  _anon_z05_84
                            	  3402:     ; Add the value of the shortcut chosen to whatever index
                            	  3403:     ; the current room has in the array.
                            	  3404:     ;
                            	  3405:     ; This yields the index of one of the three shortcut rooms
                            	  3406:     ; after the current one.
                            	  3407:     ;
02:00041CF4 1003            	  3408:     move.b  D3,D0
02:00041CF6 023C00EE        	  3409:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CFA 1214            	  3410:     move.b  ($0000,A4),D1
02:00041CFC D101            	  3411:     addx.b  D1,D0   ; ADC $00
                            	  3412:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3413:     ;
02:00041CFE 02000003        	  3414:     andi.b #$03,D0
02:00041D02 7600            	  3415:     moveq   #0,D3
02:00041D04 1600            	  3416:     move.b  D0,D3
02:00041D06 41F900FF6BB2    	  3417:     lea     (NES_SRAM+$0BB2).l,A0
02:00041D0C 10303000        	  3418:     move.b  (A0,D3.W),D0
                            	  3419: ; Params:
                            	  3420: ; A: destination room ID
                            	  3421: ;
                            	  3422:     even
                            	  3423: GoToModeAFromCellar:
02:00041D10 194000EB        	  3424:     move.b  D0,($00EB,A4)
02:00041D14 4EB90004AB98    	  3425:     jsr     MarkRoomVisited
                            	  3426:     even
                            	  3427: GoToModeAFromCave:
02:00041D1A 700A            	  3428:     moveq   #10,D0
02:00041D1C 19400012        	  3429:     move.b  D0,($0012,A4)
                            	  3430:     even
                            	  3431: EndPrepareMode:
02:00041D20 4EF90002C390    	  3432:     jmp     c_end_prepare_mode
                            	  3433: 
                            	  3434: L14F72_Exit:
02:00041D26 4E75            	  3435:     rts
