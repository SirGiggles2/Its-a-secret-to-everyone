                            	  6155: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6156:     ; Digdogger is big, but room boundary checks and
                            	  6157:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6158:     ; Therefore, we have to check these things four times,
                            	  6159:     ; in different corners of the boss.
                            	  6160:     ;
                            	  6161:     ; Loop 4 times, from 0 to 3.
                            	  6162:     ;
02:0003C49E 7600            	  6163:     moveq   #0,D3
02:0003C4A0 41EC0478        	  6164:     lea     ($0478,A4),A0
02:0003C4A4 16302000        	  6165:     move.b  (A0,D2.W),D3
                            	  6166:     ; Change the coordinates to one corner.
                            	  6167:     ;
02:0003C4A8 10342070        	  6168:     move.b  ($70,A4,D2.W),D0
02:0003C4AC 023C00EE        	  6169:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4B0 41F90003C364    	  6170:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C4B6 12303000        	  6171:     move.b  (A0,D3.W),D1
02:0003C4BA D101            	  6172:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C4BC 19802070        	  6173:     move.b  D0,($70,A4,D2.W)
02:0003C4C0 41EC0084        	  6174:     lea     ($0084,A4),A0
02:0003C4C4 10302000        	  6175:     move.b  (A0,D2.W),D0
02:0003C4C8 023C00EE        	  6176:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4CC 41F90003C368    	  6177:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C4D2 12303000        	  6178:     move.b  (A0,D3.W),D1
02:0003C4D6 D101            	  6179:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C4D8 41EC0084        	  6180:     lea     ($0084,A4),A0
02:0003C4DC 11802000        	  6181:     move.b  D0,(A0,D2.W)
                            	  6182:     ; Check the room boundary and object collisions in this temporary location.
                            	  6183:     ;
02:0003C4E0 610037D0        	  6184:     jsr     BoundFlyer
02:0003C4E4 4EB900031D80    	  6185:     jsr     CheckMonsterCollisions
                            	  6186:     ; Increase the loop index, and loop again until it = 4.
                            	  6187:     ;
