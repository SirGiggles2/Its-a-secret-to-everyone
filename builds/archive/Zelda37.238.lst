02:0004C702 122C0004        	  5880:     move.b  ($0004,A4),D1
02:0004C706 D101            	  5881:     addx.b  D1,D0   ; ADC $04
02:0004C708 19400004        	  5882:     move.b  D0,($0004,A4)
02:0004C70C 761D            	  5883:     moveq   #29,D3
02:0004C70E 601C            	  5884:     jmp     L_DrawArrowOrBoomerang
