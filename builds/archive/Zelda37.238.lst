02:00036D1C 6502            	  5357:     bcs  _anon_z02_49
02:00036D1E 7006            	  5358:     moveq   #6,D0
                            	  5359: _anon_z02_49:
                            	  5360:     ; If the VRAM line number has not just been incremented to
                            	  5361:     ; the reference line number count, then go write NT attributes.
                            	  5362:     ;
02:00036D20 122C050D        	  5363:     move.b  ($050D,A4),D1
02:00036D24 B001            	  5364:     cmp.b   D1,D0
02:00036D26 661C            	  5365:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5366:     ; Else roll over the VRAM line to 0.
