02:0003CA26 10303000        	  6856:     move.b  (A0,D3.W),D0
02:0003CA2A 7600            	  6857:     moveq   #0,D3
02:0003CA2C 1600            	  6858:     move.b  D0,D3
02:0003CA2E 101D            	  6859:     move.b  (A5)+,D0  ; PLA
02:0003CA30 41EC0201        	  6860:     lea     ($0201,A4),A0
02:0003CA34 11803000        	  6861:     move.b  D0,(A0,D3.W)
02:0003CA38 1014            	  6862:     move.b  ($0000,A4),D0
02:0003CA3A 41EC0203        	  6863:     lea     ($0203,A4),A0
02:0003CA3E 11803000        	  6864:     move.b  D0,(A0,D3.W)
02:0003CA42 102C0001        	  6865:     move.b  ($0001,A4),D0
02:0003CA46 4EF900031D4A    	  6866:     jmp     Anim_EndWriteSprite
