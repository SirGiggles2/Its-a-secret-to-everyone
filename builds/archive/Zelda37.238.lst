02:0004C799 F2
02:0004C79A F5
02:0004C79B F5
02:0004C79C F6
02:0004C79D 0D
02:0004C79E 03
02:0004C79F 03
02:0004C7A0 F7              	  5964:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:0004C7A1 09
02:0004C7A2 03
02:0004C7A3 03
02:0004C7A4 FF
02:0004C7A5 05
02:0004C7A6 03
02:0004C7A7 03
