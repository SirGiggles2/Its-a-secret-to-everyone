                            	  5047:     ; Pass RoomItemId, also known as [98][$13] and ObjDir[$13],
                            	  5048:     ; to try to take the item.
                            	  5049:     ;
02:000313D4 41EC0098        	  5050:     lea     ($0098,A4),A0
02:000313D8 10302000        	  5051:     move.b  (A0,D2.W),D0
02:000313DC 19400004        	  5052:     move.b  D0,($0004,A4)
                            	  5053: ; Params:
                            	  5054: ; X: object index
                            	  5055: ; [04]: item type
                            	  5056: ;
                            	  5057: ;
                            	  5058: ; If the lifetime timer of the item >= $F0, then return;
                            	  5059: ; so that the player can't pick it up right away.
                            	  5060: ;
                            	  5061: ; [03A8][X] is used to count down the life of the item.
                            	  5062:     even
