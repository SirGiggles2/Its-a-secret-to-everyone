02:0003200A 41F900031E6C    	  6546:     lea     (ObjTypeToDamagePoints).l,A0
02:00032010 10303000        	  6547:     move.b  (A0,D3.W),D0
02:00032014 1B00            	  6548:     move.b  D0,-(A5)  ; PHA
02:00032016 0200000F        	  6549:     andi.b #$0F,D0
02:0003201A 1940000D        	  6550:     move.b  D0,($000D,A4)
02:0003201E 101D            	  6551:     move.b  (A5)+,D0  ; PLA
02:00032020 020000F0        	  6552:     andi.b #$F0,D0
02:00032024 1940000E        	  6553:     move.b  D0,($000E,A4)
                            	  6554: ; Params:
                            	  6555: ; X: object index of the attacker
                            	  6556: ; [0D]: damage points high byte
                            	  6557: ; [0E]: damage points low byte
                            	  6558: ;
                            	  6559: ;
