02:0003D2C8 19400028        	  8036:     move.b  D0,($0028,A4)
02:0003D2CC 19400405        	  8037:     move.b  D0,($0405,A4)
02:0003D2D0 194000C0        	  8038:     move.b  D0,($00C0,A4)
02:0003D2D4 194000D3        	  8039:     move.b  D0,($00D3,A4)
                            	  8040:     ; Restart the monster's movement frame cycle: frame 0, counter 4
