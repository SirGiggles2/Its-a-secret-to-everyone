02:00041C6A 1600            	  3326:     move.b  D0,D3
02:00041C6C 41F900FF697E    	  3327:     lea     (NES_SRAM+$097E).l,A0
02:00041C72 10303000        	  3328:     move.b  (A0,D3.W),D0
02:00041C76 1B00            	  3329:     move.b  D0,-(A5)  ; PHA
02:00041C78 020000F0        	  3330:     andi.b #$F0,D0
02:00041C7C 19400070        	  3331:     move.b  D0,($0070,A4)
02:00041C80 101D            	  3332:     move.b  (A5)+,D0  ; PLA
02:00041C82 E308            	  3333:     lsl.b  #1,D0   ; ASL A
02:00041C84 E308            	  3334:     lsl.b  #1,D0   ; ASL A
02:00041C86 E308            	  3335:     lsl.b  #1,D0   ; ASL A
02:00041C88 E308            	  3336:     lsl.b  #1,D0   ; ASL A
02:00041C8A 0000000D        	  3337:     ori.b #$0D,D0
02:00041C8E 19400084        	  3338:     move.b  D0,($0084,A4)
