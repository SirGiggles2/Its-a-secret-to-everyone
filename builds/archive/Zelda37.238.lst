                            	  7557: _anon_z05_156:
02:00044A5A 101D            	  7558:     move.b  (A5)+,D0  ; PLA
                            	  7559:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7560:     ; then the player walked all the way to the edge of the play
                            	  7561:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7562:     ;
                            	  7563:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7564:     ; edge of the play area. So, set a relative position that
                            	  7565:     ; reflects that distance: $28 or -$28.
                            	  7566:     ;
                            	  7567:     ; If walking in a decreasing direction (left or up), then
                            	  7568:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7569:     ;
                            	  7570:     ; If walking in an increasing direction (right or down), then
                            	  7571:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7572:     ;
02:00044A5C 02000007        	  7573:     andi.b #$07,D0
02:00044A60 0C000002        	  7574:     cmpi.b  #$02,D0
