                            	  6365: Digdogger_Move:
                            	  6366:     ; This calculation is the same one used in Manhandla to
                            	  6367:     ; manifest the fractional speed over several frames.
                            	  6368:     ;
                            	  6369:     ; To summarize, the formula is:
                            	  6370:     ;
                            	  6371:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6372:     ;
                            	  6373:     ;   SA := SA + (SL AND $E0)
                            	  6374:     ;   [03] := SH + carry
                            	  6375:     ;
                            	  6376:     ; See 04:A28E Manhandla_Move.
                            	  6377:     ;
02:0003C678 41EC041F        	  6378:     lea     ($041F,A4),A0
02:0003C67C 10302000        	  6379:     move.b  (A0,D2.W),D0
02:0003C680 020000E0        	  6380:     andi.b #$E0,D0
02:0003C684 023C00EE        	  6381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C688 41EC0412        	  6382:     lea     ($0412,A4),A0
02:0003C68C 12302000        	  6383:     move.b  (A0,D2.W),D1
02:0003C690 D101            	  6384:     addx.b  D1,D0   ; ADC $0412,X
02:0003C692 41EC0412        	  6385:     lea     ($0412,A4),A0
02:0003C696 11802000        	  6386:     move.b  D0,(A0,D2.W)
                            	  6387:     ; Assign (high speed byte + carry) to [03].
                            	  6388:     ;
02:0003C69A 41EC042C        	  6389:     lea     ($042C,A4),A0
02:0003C69E 10302000        	  6390:     move.b  (A0,D2.W),D0
02:0003C6A2 123C0000        	  6391:     move.b  #$00,D1
02:0003C6A6 D101            	  6392:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C6A8 19400003        	  6393:     move.b  D0,($0003,A4)
                            	  6394:     ; Change coordinates by the speed amount/offset in [03]
                            	  6395:     ; according to the direction.
                            	  6396:     ;
                            	  6397:     ; Start with a mask of $A1 in [02]:
                            	  6398:     ; - low nibble represents the right direction
                            	  6399:     ; - high nibble is used to set or clear carry as we go along
                            	  6400:     ;
02:0003C6AC 103C00A1        	  6401:     move.b  #$A1,D0
02:0003C6B0 19400002        	  6402:     move.b  D0,($0002,A4)
                            	  6403:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6404:     ;
02:0003C6B4 41EC0098        	  6405:     lea     ($0098,A4),A0
02:0003C6B8 10302000        	  6406:     move.b  (A0,D2.W),D0
02:0003C6BC 122C0002        	  6407:     move.b  ($0002,A4),D1
02:0003C6C0 C200            	  6408:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C6C2 6712            	  6409:     beq  _L_z04_Digdogger_Move_Left
02:0003C6C4 10342070        	  6410:     move.b  ($70,A4,D2.W),D0
02:0003C6C8 023C00EE        	  6411:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C6CC 122C0003        	  6412:     move.b  ($0003,A4),D1
02:0003C6D0 D101            	  6413:     addx.b  D1,D0   ; ADC $03
02:0003C6D2 19802070        	  6414:     move.b  D0,($70,A4,D2.W)
                            	  6415:     even
                            	  6416: _L_z04_Digdogger_Move_Left:
                            	  6417:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6418:     ;
