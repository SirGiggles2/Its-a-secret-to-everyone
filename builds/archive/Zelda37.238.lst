02:00030F52 4E75            	  4343:     rts
                            	  4344: 
                            	  4345: ; Params:
                            	  4346: ; Y: middle speed index (4)
                            	  4347: ; [03]: horizontal distance
                            	  4348: ; [04]: vertical distance
                            	  4349: ; [0A]: vertical direction
                            	  4350: ; [0B]: horizontal direction
                            	  4351: ;
                            	  4352: ; Returns:
                            	  4353: ; Y: speed index (0 to 8) for the angle
                            	  4354: ;
                            	  4355: ;
                            	  4356: ; TODO: call it speed index or angle?
                            	  4357: ; Store the middle speed index in [00]. It will be changed to the
                            	  4358: ; right speed index to use incrementally.
                            	  4359: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4360: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4361: ;
                            	  4362:     even
                            	  4363: _CalcDiagonalSpeedIndex:
02:00030F54 1883            	  4364:     move.b  D3,($0000,A4)
                            	  4365:     ; Assuming horizontal distance >= vertical distance, the
                            	  4366:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4367:     ;
02:00030F56 103C00FF        	  4368:     move.b  #$FF,D0
02:00030F5A 19400001        	  4369:     move.b  D0,($0001,A4)
                            	  4370:     ; TODO:
                            	  4371:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4372:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4373:     ;
                            	  4374:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4375:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4376:     ; of the farther distance faster.
                            	  4377:     ;
02:00030F5E 102C0003        	  4378:     move.b  ($0003,A4),D0
02:00030F62 122C0004        	  4379:     move.b  ($0004,A4),D1
02:00030F66 B001            	  4380:     cmp.b   D1,D0
02:00030F68 6416            	  4381:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030F6A 1B00            	  4382:     move.b  D0,-(A5)  ; PHA
02:00030F6C 102C0004        	  4383:     move.b  ($0004,A4),D0
02:00030F70 19400003        	  4384:     move.b  D0,($0003,A4)
02:00030F74 101D            	  4385:     move.b  (A5)+,D0  ; PLA
02:00030F76 19400004        	  4386:     move.b  D0,($0004,A4)
02:00030F7A 7001            	  4387:     moveq   #1,D0
02:00030F7C 19400001        	  4388:     move.b  D0,($0001,A4)
                            	  4389:     even
                            	  4390: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4391:     ; TODO: call it speed index or angle?
                            	  4392:     ; If the difference in distances is within 8 pixels,
                            	  4393:     ; return the speed index (angle) we have.
                            	  4394:     ;
02:00030F80 102C0003        	  4395:     move.b  ($0003,A4),D0
02:00030F84 003C0011        	  4396:     ori     #$11,CCR  ; SEC: set C+X
02:00030F88 122C0004        	  4397:     move.b  ($0004,A4),D1
02:00030F8C 0A3C0010        	  4398:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030F90 9101            	  4399:     subx.b  D1,D0   ; SBC $04
02:00030F92 0A3C0010        	  4400:     eori    #$10,CCR  ; restore X = 6502 C
02:00030F96 0C000008        	  4401:     cmpi.b  #$08,D0
02:00030F9A 6538            	  4402:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4403:     even
                            	  4404: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4405:     ; TODO: call it speed index or angle?
                            	  4406:     ; Otherwise, go to the next speed index (angle).
                            	  4407:     ;
02:00030F9C 1014            	  4408:     move.b  ($0000,A4),D0
02:00030F9E 023C00EE        	  4409:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030FA2 122C0001        	  4410:     move.b  ($0001,A4),D1
02:00030FA6 D101            	  4411:     addx.b  D1,D0   ; ADC $01
02:00030FA8 1880            	  4412:     move.b  D0,($0000,A4)
                            	  4413:     ; TODO: call it speed index or angle?
                            	  4414:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4415:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4416:     ;
02:00030FAA 6728            	  4417:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030FAC 0C000008        	  4418:     cmpi.b  #$08,D0
02:00030FB0 6722            	  4419:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4420:     ; Subtract the lesser distance from the greater distance.
                            	  4421:     ; If they still haven't crossed, then we can turn more.
                            	  4422:     ;
02:00030FB2 102C0003        	  4423:     move.b  ($0003,A4),D0
02:00030FB6 003C0011        	  4424:     ori     #$11,CCR  ; SEC: set C+X
02:00030FBA 122C0004        	  4425:     move.b  ($0004,A4),D1
02:00030FBE 0A3C0010        	  4426:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030FC2 9101            	  4427:     subx.b  D1,D0   ; SBC $04
02:00030FC4 0A3C0010        	  4428:     eori    #$10,CCR  ; restore X = 6502 C
02:00030FC8 19400003        	  4429:     move.b  D0,($0003,A4)
02:00030FCC 122C0004        	  4430:     move.b  ($0004,A4),D1
02:00030FD0 B001            	  4431:     cmp.b   D1,D0
02:00030FD2 64C8            	  4432:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4433:     even
                            	  4434: _L_z01__CalcDiagonalSpeedIndex_Return:
                            	  4435:     ; TODO: call it speed index or angle?
                            	  4436:     ; Return the speed index (angle) we found.
                            	  4437:     ;
02:00030FD4 7600            	  4438:     moveq   #0,D3
02:00030FD6 1614            	  4439:     move.b  ($0000,A4),D3
02:00030FD8 4E75            	  4440:     rts
