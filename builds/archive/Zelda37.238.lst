02:000421BA 12303000        	  4087:     move.b  (A0,D3.W),D1
02:000421BE B001            	  4088:     cmp.b   D1,D0
02:000421C0 6510            	  4089:     bcs  _anon_z05_95
02:000421C2 41F900042184    	  4090:     lea     (DoorwayBoundsMaxOver).l,A0
02:000421C8 12303000        	  4091:     move.b  (A0,D3.W),D1
02:000421CC B001            	  4092:     cmp.b   D1,D0
02:000421CE 65000082        	  4093:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
