                            	  4972: 
                            	  4973: ; Each byte describes an item. The high nibble is the type.
                            	  4974: ; The low nibble is the value. Its meaning depends on the type.
                            	  4975: ;
                            	  4976: ; 0x - individuals
                            	  4977: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4978: ; * bit mask: value doesn't matter.
                            	  4979: ;
                            	  4980: ; 1x - amounts
                            	  4981: ; Value is an amount to add.
                            	  4982: ;
                            	  4983: ; 2x - grades
                            	  4984: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4985: ;
                            	  4986: ; 3x - error?
                            	  4987: ; Produces an item value of $FF.
                            	  4988: ;
                            	  4989:     even
