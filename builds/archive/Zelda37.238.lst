                            	  7388: ; A: 1 if objects collide
                            	  7389: ; Y: weapon object slot
                            	  7390: ; Z: 0 if objects collide
                            	  7391: ; [06]: 1 if objects collide
                            	  7392: ; [0A]: horizontal distance
                            	  7393: ; [0B]: vertical distance
                            	  7394: ;
                            	  7395: ;
