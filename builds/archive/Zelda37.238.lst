02:0004C516 41EC03BC        	  5617:     lea     ($03BC,A4),A0
02:0004C51A 11802000        	  5618:     move.b  D0,(A0,D2.W)
                            	  5619:     ; If facing left and X < 2, then go change state to $40. The
                            	  5620:     ; boomerang is too close to the left edge of the screen.
                            	  5621:     ; Another move might make it wrap around.
                            	  5622:     ;
02:0004C51E 41EC0098        	  5623:     lea     ($0098,A4),A0
02:0004C522 10302000        	  5624:     move.b  (A0,D2.W),D0
02:0004C526 1940000F        	  5625:     move.b  D0,($000F,A4)
