                            	  5602: CheckState30:
                            	  5603:     ; If major state <> $30, go check other states.
                            	  5604:     ;
02:0004C504 0C000030        	  5605:     cmpi.b  #$30,D0
02:0004C508 6656            	  5606:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5607:     ; State $3x. Slow down.
                            	  5608:     ;
                            	  5609:     ; Reset grid offset for movement.
                            	  5610:     ;
02:0004C50A 7000            	  5611:     moveq   #0,D0
02:0004C50C 41EC0394        	  5612:     lea     ($0394,A4),A0
02:0004C510 11802000        	  5613:     move.b  D0,(A0,D2.W)
                            	  5614:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
