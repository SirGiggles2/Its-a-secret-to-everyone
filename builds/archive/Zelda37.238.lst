02:000437A4 2044            	  5689:     movea.l D4,A0
02:000437A6 10303000        	  5690:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000437AA 1214            	  5691:     move.b  ($00,A4),D1   ; ptr lo
02:000437AC 182C0001        	  5692:     move.b  ($01,A4),D4  ; ptr hi
02:000437B0 024100FF        	  5693:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000437B4 E14C            	  5694:     lsl.w   #8,D4
02:000437B6 8841            	  5695:     or.w    D1,D4
02:000437B8 48C4            	  5696:     ext.l   D4
02:000437BA D8BC00FF0000    	  5697:     add.l   #NES_RAM,D4
02:000437C0 2044            	  5698:     movea.l D4,A0
02:000437C2 11803000        	  5699:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000437C6 4EB90003130A    	  5700:     jsr     Add1ToInt16At2
02:000437CC 41F900043660    	  5701:     lea     (NextDoorTileOffsets).l,A0
02:000437D2 10302000        	  5702:     move.b  (A0,D2.W),D0
02:000437D6 4EB900031306    	  5703:     jsr     AddToInt16At0
                            	  5704:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5705:     ; go 1 more tile down, to start the next column at the right place.
                            	  5706:     ; We have to compensate for the fact that E/W doors are 
                            	  5707:     ; shorter vertically than N/S doors.
02:000437DC 4A02            	  5708:     cmpi.b  #$00,D2
