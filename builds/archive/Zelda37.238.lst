                            	 11604: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003ED72 10342070        	 11605:     move.b  ($70,A4,D2.W),D0
02:0003ED76 1B00            	 11606:     move.b  D0,-(A5)  ; PHA
                            	 11607:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11608:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11609:     ;
02:0003ED78 023C00EE        	 11610:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED7C 123C0004        	 11611:     move.b  #$04,D1
02:0003ED80 D101            	 11612:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003ED82 19802070        	 11613:     move.b  D0,($70,A4,D2.W)
                            	 11614:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11615:     ; to store in [03].
                            	 11616:     ;
02:0003ED86 102C04E6        	 11617:     move.b  ($04E6,A4),D0
02:0003ED8A 0A000003        	 11618:     eori.b #$03,D0
02:0003ED8E 19400003        	 11619:     move.b  D0,($0003,A4)
                            	 11620:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11621:     ;
02:0003ED92 103C009E        	 11622:     move.b  #$9E,D0
02:0003ED96 0C020005        	 11623:     cmpi.b  #$05,D2
02:0003ED9A 670A            	 11624:     beq  _L_z04_UpdateLamnola_Draw
02:0003ED9C 0C02000A        	 11625:     cmpi.b  #$0A,D2
02:0003EDA0 6704            	 11626:     beq  _L_z04_UpdateLamnola_Draw
02:0003EDA2 103C00A0        	 11627:     move.b  #$A0,D0
                            	 11628:     even
                            	 11629: _L_z04_UpdateLamnola_Draw:
02:0003EDA6 4EB900031D00    	 11630:     jsr     Anim_WriteSprite
02:0003EDAC 101D            	 11631:     move.b  (A5)+,D0  ; PLA
02:0003EDAE 19802070        	 11632:     move.b  D0,($70,A4,D2.W)
02:0003EDB2 41EC0098        	 11633:     lea     ($0098,A4),A0
02:0003EDB6 10302000        	 11634:     move.b  (A0,D2.W),D0
02:0003EDBA 1B00            	 11635:     move.b  D0,-(A5)  ; PHA
02:0003EDBC 4EB900031D80    	 11636:     jsr     CheckMonsterCollisions
02:0003EDC2 101D            	 11637:     move.b  (A5)+,D0  ; PLA
02:0003EDC4 41EC0098        	 11638:     lea     ($0098,A4),A0
02:0003EDC8 11802000        	 11639:     move.b  D0,(A0,D2.W)
                            	 11640:     ; If still alive, then return.
                            	 11641:     ;
02:0003EDCC 41EC0405        	 11642:     lea     ($0405,A4),A0
02:0003EDD0 10302000        	 11643:     move.b  (A0,D2.W),D0
02:0003EDD4 6604            	 11644:     bne.s  __far_z_04_0115
02:0003EDD6 6000FF72        	 11645:     jmp  L129EA_Exit
                            	 11646: __far_z_04_0115:
                            	 11647:     ; Otherwise, the segment is dead.
                            	 11648:     ;
02:0003EDDA 4EB90004B7CC    	 11649:     jsr     ResetShoveInfo
                            	 11650:     ; Set the current segment's HP to the initial value in anticipation
                            	 11651:     ; of bringing this segment back to life.
                            	 11652:     ;
02:0003EDE0 7020            	 11653:     moveq   #32,D0
02:0003EDE2 41EC0485        	 11654:     lea     ($0485,A4),A0
02:0003EDE6 11802000        	 11655:     move.b  D0,(A0,D2.W)
                            	 11656:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11657:     ;
                            	 11658:     ; From the lowest slot, look for one that has the original lamnola
                            	 11659:     ; object type.
                            	 11660:     ;
                            	 11661:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11662:     ;
02:0003EDEA 163C00FF        	 11663:     move.b  #$FF,D3
02:0003EDEE 0C020006        	 11664:     cmpi.b  #$06,D2
02:0003EDF2 6502            	 11665:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EDF4 7604            	 11666:     moveq   #4,D3
                            	 11667:     even
                            	 11668: _L_z04_UpdateLamnola_FindTail:
02:0003EDF6 5203            	 11669:     addq.b  #1,D3
02:0003EDF8 41EC0350        	 11670:     lea     ($0350,A4),A0
02:0003EDFC 10303000        	 11671:     move.b  (A0,D3.W),D0
02:0003EE00 122C04E7        	 11672:     move.b  ($04E7,A4),D1
02:0003EE04 B001            	 11673:     cmp.b   D1,D0
02:0003EE06 66EE            	 11674:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11675:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11676:     ;
02:0003EE08 7011            	 11677:     moveq   #17,D0
02:0003EE0A 19803029        	 11678:     move.b  D0,($29,A4,D3.W)
                            	 11679:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11680:     ; to the tail segment.
                            	 11681:     ;
02:0003EE0E 41EC04F0        	 11682:     lea     ($04F0,A4),A0
02:0003EE12 10302000        	 11683:     move.b  (A0,D2.W),D0
02:0003EE16 41EC04F1        	 11684:     lea     ($04F1,A4),A0
02:0003EE1A 11803000        	 11685:     move.b  D0,(A0,D3.W)
02:0003EE1E 10342070        	 11686:     move.b  ($70,A4,D2.W),D0
02:0003EE22 19803071        	 11687:     move.b  D0,($71,A4,D3.W)
02:0003EE26 41EC0084        	 11688:     lea     ($0084,A4),A0
02:0003EE2A 10302000        	 11689:     move.b  (A0,D2.W),D0
02:0003EE2E 41EC0085        	 11690:     lea     ($0085,A4),A0
02:0003EE32 11803000        	 11691:     move.b  D0,(A0,D3.W)
                            	 11692:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11693:     ; So, return and leave it dead.
                            	 11694:     ;
02:0003EE36 0C030004        	 11695:     cmpi.b  #$04,D3
02:0003EE3A 6604            	 11696:     bne.s  __far_z_04_0116
02:0003EE3C 6000FF0C        	 11697:     jmp  L129EA_Exit
                            	 11698: __far_z_04_0116:
02:0003EE40 0C030009        	 11699:     cmpi.b  #$09,D3
02:0003EE44 6604            	 11700:     bne.s  __far_z_04_0117
02:0003EE46 6000FF02        	 11701:     jmp  L129EA_Exit
                            	 11702: __far_z_04_0117:
                            	 11703:     ; Change the tail segment to the dead dummy object, and
                            	 11704:     ; bring the current segment back to life.
                            	 11705:     ;
02:0003EE4A 705D            	 11706:     moveq   #93,D0
02:0003EE4C 41EC0350        	 11707:     lea     ($0350,A4),A0
02:0003EE50 11803000        	 11708:     move.b  D0,(A0,D3.W)
02:0003EE54 4EF90004D630    	 11709:     jmp     ResetObjMetastate
                            	 11710: 
                            	 11711:     even
                            	 11712: L12A6F_Exit:
02:0003EE5A 4E75            	 11713:     rts
                            	 11714: 
                            	 11715:     even
                            	 11716: Lamnola_UpdateHead:
                            	 11717:     ; If X coordinate is not a multiple of 8, then return.
                            	 11718:     ;
02:0003EE5C 10342070        	 11719:     move.b  ($70,A4,D2.W),D0
02:0003EE60 02000007        	 11720:     andi.b #$07,D0
02:0003EE64 6702            	 11721:     beq.s  __far_z_04_0118
02:0003EE66 60F2            	 11722:     jmp  L12A6F_Exit
                            	 11723: __far_z_04_0118:
                            	 11724:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11725:     ; We had to account for the usual offset of 3.
                            	 11726:     ;
02:0003EE68 41EC0084        	 11727:     lea     ($0084,A4),A0
02:0003EE6C 10302000        	 11728:     move.b  (A0,D2.W),D0
02:0003EE70 023C00EE        	 11729:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EE74 123C0003        	 11730:     move.b  #$03,D1
02:0003EE78 D101            	 11731:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EE7A 02000007        	 11732:     andi.b #$07,D0
02:0003EE7E 6702            	 11733:     beq.s  __far_z_04_0119
02:0003EE80 60D8            	 11734:     jmp  L12A6F_Exit
                            	 11735: __far_z_04_0119:
                            	 11736:     ; Will loop 4 times, propagating directions down the chain,
                            	 11737:     ; by pulling from the bottom.
                            	 11738:     ;
02:0003EE82 7004            	 11739:     moveq   #4,D0
02:0003EE84 1880            	 11740:     move.b  D0,($0000,A4)
                            	 11741:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11742:     ;
02:0003EE86 7600            	 11743:     moveq   #0,D3
02:0003EE88 0C020005        	 11744:     cmpi.b  #$05,D2
02:0003EE8C 6702            	 11745:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EE8E 7605            	 11746:     moveq   #5,D3
                            	 11747:     even
                            	 11748: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11749:     ; Loop over every segment under the head, starting from the tail.
                            	 11750:     ; Copy the next segment's direction to the current one in this loop.
                            	 11751:     ;
02:0003EE90 41EC009A        	 11752:     lea     ($009A,A4),A0
02:0003EE94 10303000        	 11753:     move.b  (A0,D3.W),D0
02:0003EE98 41EC0099        	 11754:     lea     ($0099,A4),A0
02:0003EE9C 11803000        	 11755:     move.b  D0,(A0,D3.W)
02:0003EEA0 5203            	 11756:     addq.b  #1,D3
02:0003EEA2 5314            	 11757:     subq.b  #1,($0000,A4)
02:0003EEA4 66EA            	 11758:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11759:     ; If this head segment is not aligned with a square, then return.
                            	 11760:     ;
02:0003EEA6 10342070        	 11761:     move.b  ($70,A4,D2.W),D0
02:0003EEAA 0200000F        	 11762:     andi.b #$0F,D0
02:0003EEAE 660000BA        	 11763:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11764:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11765:     ; We had to account for the usual offset of 3.
                            	 11766:     ;
02:0003EEB2 41EC0084        	 11767:     lea     ($0084,A4),A0
02:0003EEB6 10302000        	 11768:     move.b  (A0,D2.W),D0
02:0003EEBA 023C00EE        	 11769:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEBE 123C0003        	 11770:     move.b  #$03,D1
02:0003EEC2 D101            	 11771:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EEC4 0200000F        	 11772:     andi.b #$0F,D0
02:0003EEC8 660000A0        	 11773:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11774:     ; Store the opposite of the facing direction in [00].
                            	 11775:     ;
02:0003EECC 41EC0098        	 11776:     lea     ($0098,A4),A0
02:0003EED0 10302000        	 11777:     move.b  (A0,D2.W),D0
02:0003EED4 E208            	 11778:     lsr.b  #1,D0   ; LSR A
02:0003EED6 02000005        	 11779:     andi.b #$05,D0
02:0003EEDA 1880            	 11780:     move.b  D0,($0000,A4)
02:0003EEDC 41EC0098        	 11781:     lea     ($0098,A4),A0
02:0003EEE0 10302000        	 11782:     move.b  (A0,D2.W),D0
02:0003EEE4 E308            	 11783:     lsl.b  #1,D0   ; ASL A
02:0003EEE6 0200000A        	 11784:     andi.b #$0A,D0
02:0003EEEA 1214            	 11785:     move.b  ($0000,A4),D1
02:0003EEEC 8001            	 11786:     or.b  D1,D0
                            	 11787:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11788:     ;
02:0003EEEE 0A00000F        	 11789:     eori.b #$0F,D0
02:0003EEF2 1940050F        	 11790:     move.b  D0,($050F,A4)
                            	 11791:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11792:     ;
02:0003EEF6 10342018        	 11793:     move.b  ($18,A4,D2.W),D0
02:0003EEFA 0C000080        	 11794:     cmpi.b  #$80,D0
02:0003EEFE 656C            	 11795:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11796:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11797:     ; Load the monster's facing direction.
                            	 11798:     ;
02:0003EF00 41EC0098        	 11799:     lea     ($0098,A4),A0
02:0003EF04 10302000        	 11800:     move.b  (A0,D2.W),D0
                            	 11801:     ; Load the next random number into Y register.
                            	 11802:     ;
02:0003EF08 7600            	 11803:     moveq   #0,D3
02:0003EF0A 16342019        	 11804:     move.b  ($19,A4,D2.W),D3
                            	 11805:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11806:     ; to keep moving straight.
                            	 11807:     ;
02:0003EF0E 0C030080        	 11808:     cmpi.b  #$80,D3
02:0003EF12 6418            	 11809:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11810:     even
                            	 11811: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11812:     ; Loop to rotate the direction bit over the mask.
                            	 11813:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11814:     ; facing direction.
                            	 11815:     ;
                            	 11816:     ; Shift right the copy of the direction.
                            	 11817:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11818:     ;
02:0003EF14 E208            	 11819:     lsr.b  #1,D0   ; LSR A
02:0003EF16 6402            	 11820:     bcc  _anon_z04_151
02:0003EF18 7008            	 11821:     moveq   #8,D0
                            	 11822: _anon_z04_151:
                            	 11823:     ; If the current direction bit is masked off, then we've reached
                            	 11824:     ; the opposite direction. Loop again.
                            	 11825:     ;
02:0003EF1A 122C050F        	 11826:     move.b  ($050F,A4),D1
02:0003EF1E C200            	 11827:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF20 67F2            	 11828:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11829:     ; If Y register >= $40, then break out of the loop.
                            	 11830:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11831:     ;
02:0003EF22 0C030040        	 11832:     cmpi.b  #$40,D3
02:0003EF26 6404            	 11833:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11834:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11835:     ; and loop again now.
                            	 11836:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11837:     ;
02:0003EF28 7640            	 11838:     moveq   #64,D3
