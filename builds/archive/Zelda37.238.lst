02:0003260C 41EC04BF        	  7548:     lea     ($04BF,A4),A0
02:00032610 10302000        	  7549:     move.b  (A0,D2.W),D0
02:00032614 02000080        	  7550:     andi.b #$80,D0
02:00032618 6622            	  7551:     bne  _L_z01_BeginShove_Exit
                            	  7552:     ; If the attacker is a vire, then return.
                            	  7553:     ;
02:0003261A 41EC034F        	  7554:     lea     ($034F,A4),A0
02:0003261E 10302000        	  7555:     move.b  (A0,D2.W),D0
02:00032622 0C000012        	  7556:     cmpi.b  #$12,D0
02:00032626 6714            	  7557:     beq  _L_z01_BeginShove_Exit
                            	  7558:     ; Turn the attacker in the opposite direction.
                            	  7559:     ;
02:00032628 41EC0098        	  7560:     lea     ($0098,A4),A0
02:0003262C 10302000        	  7561:     move.b  (A0,D2.W),D0
02:00032630 6100E87C        	  7562:     jsr     GetOppositeDir
02:00032634 41EC0098        	  7563:     lea     ($0098,A4),A0
02:00032638 11802000        	  7564:     move.b  D0,(A0,D2.W)
