02:0003B618 003C0011        	  4176:     ori     #$11,CCR  ; SEC: set C+X
02:0003B61C 123C001C        	  4177:     move.b  #$1C,D1
02:0003B620 0A3C0010        	  4178:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B624 9101            	  4179:     subx.b  D1,D0   ; SBC #$1C
02:0003B626 0A3C0010        	  4180:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B62A 41EC0084        	  4181:     lea     ($0084,A4),A0
02:0003B62E 11802000        	  4182:     move.b  D0,(A0,D2.W)
                            	  4183:     even
