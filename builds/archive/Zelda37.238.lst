                            	 12446:     ;
02:0003F354 194000AC        	 12447:     move.b  D0,($00AC,A4)
02:0003F358 19400505        	 12448:     move.b  D0,($0505,A4)
02:0003F35C 7020            	 12449:     moveq   #32,D0
02:0003F35E 19400600        	 12450:     move.b  D0,($0600,A4)
02:0003F362 522C0445        	 12451:     addq.b  #1,($0445,A4)
                            	 12452:     even
