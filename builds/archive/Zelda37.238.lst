02:00039F36 41EC0412        	   866:     lea     ($0412,A4),A0
02:00039F3A 16302000        	   867:     move.b  (A0,D2.W),D3
02:00039F3E 0C030010        	   868:     cmpi.b  #$10,D3
02:00039F42 6402            	   869:     bcc.s  __far_z_04_0009
02:00039F44 6034            	   870:     jmp  L10262_Exit
