                            	  9706: UpdateGohma:
                            	  9707:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9708:     ;
02:0003DF32 41EC0451        	  9709:     lea     ($0451,A4),A0
02:0003DF36 10302000        	  9710:     move.b  (A0,D2.W),D0
02:0003DF3A 662C            	  9711:     bne  _L_z04_UpdateGohma_Move
                            	  9712:     ; If Random:
                            	  9713:     ;   >= $B0: right
                            	  9714:     ;   >= $60: left
                            	  9715:     ;   Else:   down
                            	  9716:     ;
02:0003DF3C 7001            	  9717:     moveq   #1,D0
02:0003DF3E 7600            	  9718:     moveq   #0,D3
02:0003DF40 16342018        	  9719:     move.b  ($18,A4,D2.W),D3
02:0003DF44 0C0300B0        	  9720:     cmpi.b  #$B0,D3
02:0003DF48 640A            	  9721:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DF4A E308            	  9722:     lsl.b  #1,D0   ; ASL A
02:0003DF4C 0C030060        	  9723:     cmpi.b  #$60,D3
02:0003DF50 6402            	  9724:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DF52 E308            	  9725:     lsl.b  #1,D0   ; ASL A
                            	  9726:     even
                            	  9727: _L_z04_UpdateGohma_ChangeDir:
