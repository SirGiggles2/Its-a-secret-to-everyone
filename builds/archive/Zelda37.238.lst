02:0003204C 1941000D        	  6580:     move.b  D1,($000D,A4)
02:00032050 122C000E        	  6581:     move.b  ($000E,A4),D1
02:00032054 E211            	  6582:     roxr.b  #1,D1   ; ROR $0E
02:00032056 1941000E        	  6583:     move.b  D1,($000E,A4)
