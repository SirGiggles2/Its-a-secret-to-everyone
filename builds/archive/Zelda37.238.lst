                            	  9791:     ;
02:0003DFD8 122C0002        	  9792:     move.b  ($0002,A4),D1
02:0003DFDC E309            	  9793:     lsl.b  #1,D1   ; ASL $02
02:0003DFDE 19410002        	  9794:     move.b  D1,($0002,A4)
02:0003DFE2 122C0002        	  9795:     move.b  ($0002,A4),D1
02:0003DFE6 C200            	  9796:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
