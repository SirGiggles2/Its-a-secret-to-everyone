02:00030734 02000001        	  3101:     andi.b #$01,D0
02:00030738 6744            	  3102:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3103:     ; Finish handling state 1.
                            	  3104:     ;
                            	  3105:     ; Get the distance between the current coordinate and the target.
                            	  3106:     ;
