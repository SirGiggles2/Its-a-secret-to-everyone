02:0003D2B6 19802070        	  8029:     move.b  D0,($70,A4,D2.W)
02:0003D2BA 102C0084        	  8030:     move.b  ($0084,A4),D0
02:0003D2BE 41EC0084        	  8031:     lea     ($0084,A4),A0
02:0003D2C2 11802000        	  8032:     move.b  D0,(A0,D2.W)
                            	  8033:     ; Reset Link's timer, metastate, and shove info.
