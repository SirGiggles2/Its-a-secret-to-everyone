                            	  7807:     ; Subtract 1 from facing direction to make an index.
                            	  7808:     ;
02:0003D0B2 7600            	  7809:     moveq   #0,D3
02:0003D0B4 41EC0098        	  7810:     lea     ($0098,A4),A0
02:0003D0B8 16302000        	  7811:     move.b  (A0,D2.W),D3
