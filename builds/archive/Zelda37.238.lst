                            	  3677: DrawGhiniAndCheckCollisions:
02:0003B320 4EB90004CE24    	  3678:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B326 1940000D        	  3679:     move.b  D0,($000D,A4)
                            	  3680:     ; If the direction has an "up" component, then keep the
                            	  3681:     ; frame image 0, and go figure out horizontal flipping.
                            	  3682:     ;
02:0003B32A 41EC0098        	  3683:     lea     ($0098,A4),A0
02:0003B32E 10302000        	  3684:     move.b  (A0,D2.W),D0
02:0003B332 02000008        	  3685:     andi.b #$08,D0
02:0003B336 6614            	  3686:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3687:     ; Else make the frame image 1 for the "down" frame.
                            	  3688:     ; Note that this is the frame image to use, even if there's no
                            	  3689:     ; down component in the direction.
                            	  3690:     ;
02:0003B338 522C000D        	  3691:     addq.b  #1,($000D,A4)
                            	  3692:     ; If right is a component of the direction, then go set horizontal
                            	  3693:     ; flipping. Else leave horizontal flipping = 0.
                            	  3694:     ;
02:0003B33C 41EC0098        	  3695:     lea     ($0098,A4),A0
02:0003B340 10302000        	  3696:     move.b  (A0,D2.W),D0
02:0003B344 02000001        	  3697:     andi.b #$01,D0
02:0003B348 6714            	  3698:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B34A 660E            	  3699:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3700:     even
