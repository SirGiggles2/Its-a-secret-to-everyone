                            	  6827: __far_z_07_0119:
02:0004CDB8 102C03F8        	  6828:     move.b  ($03F8,A4),D0
02:0004CDBC 6602            	  6829:     bne.s  __far_z_07_0120
02:0004CDBE 6018            	  6830:     jmp  SetUpWalkingSprites
                            	  6831: __far_z_07_0120:
                            	  6832: ; Params:
                            	  6833: ; X: object index
                            	  6834: ;
                            	  6835: ; Returns:
                            	  6836: ; Y: animation frame
                            	  6837: ; [00]: object X
                            	  6838: ; [01]: object Y
                            	  6839: ; [0F]: flip horizontal
                            	  6840: ;
                            	  6841: ; As the object walks, the animation counter rolls down.
                            	  6842: ;
                            	  6843:     even
                            	  6844: AnimateObjectWalking:
02:0004CDC0 41EC03D0        	  6845:     lea     ($03D0,A4),A0
02:0004CDC4 53302000        	  6846:     subq.b  #1,(A0,D2.W)
02:0004CDC8 6702            	  6847:     beq.s  __far_z_07_0121
02:0004CDCA 600C            	  6848:     jmp  SetUpWalkingSprites
                            	  6849: __far_z_07_0121:
                            	  6850:     ; Once the counter reaches 0, and if object is the player,
                            	  6851:     ; animate Link's object state.
                            	  6852:     ;
02:0004CDCC 4A02            	  6853:     cmpi.b  #$00,D2
02:0004CDCE 6602            	  6854:     bne  _anon_z07_36
02:0004CDD0 615E            	  6855:     jsr     AnimateLinkObjState
                            	  6856: _anon_z07_36:
                            	  6857:     ; Roll over the counter (6 frames).
                            	  6858:     ;
02:0004CDD2 7006            	  6859:     moveq   #6,D0
02:0004CDD4 1880            	  6860:     move.b  D0,($0000,A4)
02:0004CDD6 6152            	  6861:     jsr     RollOverAnimCounter
                            	  6862:     even
                            	  6863: SetUpWalkingSprites:
                            	  6864:     ; Set up sprite position in the descriptors.
                            	  6865:     ;
02:0004CDD8 614A            	  6866:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  6867:     ; Set up horizontal flipping.
                            	  6868:     ;
02:0004CDDA 41EC0098        	  6869:     lea     ($0098,A4),A0
02:0004CDDE 10302000        	  6870:     move.b  (A0,D2.W),D0
02:0004CDE2 0200000C        	  6871:     andi.b #$0C,D0
02:0004CDE6 6602            	  6872:     bne.s  __far_z_07_0122
02:0004CDE8 6012            	  6873:     jmp  SetUpHorizontalWalkingSprites
                            	  6874: __far_z_07_0122:
                            	  6875:     ; Facing up or down.
                            	  6876:     ;
                            	  6877:     ;
                            	  6878:     ; Assume animation frame 3 (up).
02:0004CDEA 7603            	  6879:     moveq   #3,D3
02:0004CDEC 02000008        	  6880:     andi.b #$08,D0
02:0004CDF0 6702            	  6881:     beq.s  __far_z_07_0123
02:0004CDF2 6002            	  6882:     jmp  Anim_SetObjHFlipForSpriteDescriptor
                            	  6883: __far_z_07_0123:
02:0004CDF4 5303            	  6884:     subq.b  #1,D3
                            	  6885: ; Use the movement frame as the value for horizontal flipping.
                            	  6886: ;
                            	  6887: ; Params:
                            	  6888: ; X: object index
                            	  6889: ;
                            	  6890: ; Returns:
                            	  6891: ; [0F]: flip horizontal, based on ObjMovementFrame
                            	  6892: ;
                            	  6893:     even
