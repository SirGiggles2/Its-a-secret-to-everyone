                            	  7002: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7003:     ; Bloated timer =>
                            	  7004:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7005:     ; 1:     go advance the substate
                            	  7006:     ; other: go decrement Bloated timer
                            	  7007:     ;
02:0003CA7E 7600            	  7008:     moveq   #0,D3
02:0003CA80 41EC045E        	  7009:     lea     ($045E,A4),A0
02:0003CA84 16302000        	  7010:     move.b  (A0,D2.W),D3
02:0003CA88 5303            	  7011:     subq.b  #1,D3
02:0003CA8A 6750            	  7012:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CA8C 6B04            	  7013:     bmi.s  __far_z_04_0058
02:0003CA8E 60000080        	  7014:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7015: __far_z_04_0058:
                            	  7016:     ; Set the bloated timer according to the substate.
                            	  7017:     ;
02:0003CA92 7600            	  7018:     moveq   #0,D3
02:0003CA94 41EC042C        	  7019:     lea     ($042C,A4),A0
02:0003CA98 16302000        	  7020:     move.b  (A0,D2.W),D3
02:0003CA9C 41F90003C9DA    	  7021:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CAA2 10303000        	  7022:     move.b  (A0,D3.W),D0
02:0003CAA6 41EC045E        	  7023:     lea     ($045E,A4),A0
02:0003CAAA 11802000        	  7024:     move.b  D0,(A0,D2.W)
                            	  7025:     ; If substate <> 0, go decrement bloated timer.
                            	  7026:     ;
02:0003CAAE 4A03            	  7027:     cmpi.b  #$00,D3
02:0003CAB0 6702            	  7028:     beq.s  __far_z_04_0059
02:0003CAB2 605C            	  7029:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7030: __far_z_04_0059:
                            	  7031:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  7032:     ;
02:0003CAB4 7610            	  7033:     moveq   #16,D3
02:0003CAB6 7000            	  7034:     moveq   #0,D0
02:0003CAB8 41EC00AC        	  7035:     lea     ($00AC,A4),A0
