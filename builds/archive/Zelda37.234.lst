                            	  7339: DodongoBombPositiveLimits:
02:0003CCCC 0C              	  7340:     dc.b    $0C, $11
02:0003CCCD 11
                            	  7341: 
                            	  7342:     even
                            	  7343: DodongoBombNegativeLimits:
02:0003CCCE F4              	  7344:     dc.b    $F4, $F0
02:0003CCCF F0
                            	  7345: 
                            	  7346: ; Params:
                            	  7347: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7348: ; [00]: monster hotspot X
                            	  7349: ; [01]: monster hotspot Y
                            	  7350: ; [02]: bomb hotspot X
                            	  7351: ; [03]: bomb hotspot Y
                            	  7352: ;
                            	  7353: ; Returns:
                            	  7354: ; A: 0 if the bomb is in range of the monster
                            	  7355: ; Z: 1 if the bomb is in range of the monster
                            	  7356: ; [04]: horizontal distance
                            	  7357: ; [05]: vertical distance
                            	  7358: ;
                            	  7359: ; Store the positive limit in [06], and the negative one in [07].
                            	  7360: ;
                            	  7361:     even
                            	  7362: Dodongo_IsBombInRange:
02:0003CCD0 41F90003CCCC    	  7363:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CCD6 10303000        	  7364:     move.b  (A0,D3.W),D0
02:0003CCDA 19400006        	  7365:     move.b  D0,($0006,A4)
02:0003CCDE 41F90003CCCE    	  7366:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CCE4 10303000        	  7367:     move.b  (A0,D3.W),D0
02:0003CCE8 19400007        	  7368:     move.b  D0,($0007,A4)
                            	  7369:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7370:     ; the bomb is near enough the monster.
                            	  7371:     ;
02:0003CCEC 7003            	  7372:     moveq   #3,D0
02:0003CCEE 19400008        	  7373:     move.b  D0,($0008,A4)
                            	  7374:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7375:     ;
02:0003CCF2 7601            	  7376:     moveq   #1,D3
                            	  7377:     even
                            	  7378: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7379:     ; Subtract the bomb's coordinate from the boss's,
                            	  7380:     ; The loop index determines the coordinate.
                            	  7381:     ;
02:0003CCF4 10343000        	  7382:     move.b  ($00,A4,D3.W),D0
02:0003CCF8 003C0011        	  7383:     ori     #$11,CCR  ; SEC: set C+X
02:0003CCFC 12343002        	  7384:     move.b  ($02,A4,D3.W),D1
02:0003CD00 0A3C0010        	  7385:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CD04 9101            	  7386:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CD06 0A3C0010        	  7387:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7388:     ; If the distance >= positive offset, or < negative offset;
                            	  7389:     ; then loop again.
                            	  7390:     ;
02:0003CD0A 122C0006        	  7391:     move.b  ($0006,A4),D1
02:0003CD0E B001            	  7392:     cmp.b   D1,D0
02:0003CD10 6A16            	  7393:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CD12 122C0007        	  7394:     move.b  ($0007,A4),D1
02:0003CD16 B001            	  7395:     cmp.b   D1,D0
02:0003CD18 6B0E            	  7396:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7397:     ; The distance is close enough in this axis.
                            	  7398:     ;
                            	  7399:     ; Store the distance in this axis in [05] or [04],
                            	  7400:     ; depending on the loop index.
                            	  7401:     ;
02:0003CD1A 19803004        	  7402:     move.b  D0,($04,A4,D3.W)
                            	  7403:     ; Shift [08] right, because we're in range in this axis.
                            	  7404:     ;
02:0003CD1E 122C0008        	  7405:     move.b  ($0008,A4),D1
02:0003CD22 E209            	  7406:     lsr.b  #1,D1   ; LSR $08
02:0003CD24 19410008        	  7407:     move.b  D1,($0008,A4)
                            	  7408:     even
                            	  7409: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CD28 5303            	  7410:     subq.b  #1,D3
02:0003CD2A 6AC8            	  7411:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7412:     ; If close enough in both axes, then [08] will be 0.
                            	  7413:     ;
02:0003CD2C 102C0008        	  7414:     move.b  ($0008,A4),D0
02:0003CD30 4E75            	  7415:     rts
                            	  7416: 
                            	  7417: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7418: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7419: ;
                            	  7420: ; But these are not typical direction indexes. Instead a
                            	  7421: ; 5-way index is used.
                            	  7422: ; A direction shifted right once becomes a 5-way index.
                            	  7423: ; The fourth element is unused.
                            	  7424: ;
                            	  7425:     even
                            	  7426: DodongoFrameImages:
02:0003CD32 00              	  7427:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CD33 01
02:0003CD34 06
02:0003CD35 FF
02:0003CD36 08
02:0003CD37 02
02:0003CD38 03
02:0003CD39 06
02:0003CD3A FF              	  7428:     dc.b    $FF, $08
02:0003CD3B 08
                            	  7429: 
                            	  7430:     even
                            	  7431: DodongoFrameHFlips:
02:0003CD3C 00              	  7432:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CD3D 40
02:0003CD3E 00
02:0003CD3F FF
02:0003CD40 00
02:0003CD41 00
02:0003CD42 40
02:0003CD43 40
02:0003CD44 FF              	  7433:     dc.b    $FF, $40
02:0003CD45 40
