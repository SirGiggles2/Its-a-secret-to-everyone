                            	  7260: Dodongo_TryEatBomb:
                            	  7261:     ; Try to eat the bomb.
                            	  7262:     ;
                            	  7263:     ; If the bomb is not in range of the monster, then return.
                            	  7264:     ;
                            	  7265:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7266:     ;
02:0003CC5E 7601            	  7267:     moveq   #1,D3
02:0003CC60 616E            	  7268:     jsr     Dodongo_IsBombInRange
02:0003CC62 6666            	  7269:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7270:     ; Will loop from 1 to 0, indexed by [00].
                            	  7271:     ;
02:0003CC64 7001            	  7272:     moveq   #1,D0
02:0003CC66 1880            	  7273:     move.b  D0,($0000,A4)
                            	  7274:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7275:     ;
02:0003CC68 41EC0098        	  7276:     lea     ($0098,A4),A0
02:0003CC6C 10302000        	  7277:     move.b  (A0,D2.W),D0
02:0003CC70 E208            	  7278:     lsr.b  #1,D0   ; LSR A
02:0003CC72 7600            	  7279:     moveq   #0,D3
02:0003CC74 1600            	  7280:     move.b  D0,D3
                            	  7281:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7282:     ; position depends on the orientation of the monster.
                            	  7283:     ;
                            	  7284:     ; Start with the horizontal distance.
                            	  7285:     ;
02:0003CC76 102C0004        	  7286:     move.b  ($0004,A4),D0
                            	  7287:     even
                            	  7288: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7289:     ; Look up the limits for the given direction.
                            	  7290:     ;
                            	  7291:     ; If the distance from the bomb < negative limit,
                            	  7292:     ; or >= positive limit, then return.
                            	  7293:     ;
                            	  7294:     ; Note that these are simple signed comparisons that work,
                            	  7295:     ; because the operands are in a small range.
                            	  7296:     ;
02:0003CC7A 41F90003CBB4    	  7297:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CC80 12303000        	  7298:     move.b  (A0,D3.W),D1
02:0003CC84 B001            	  7299:     cmp.b   D1,D0
02:0003CC86 6B42            	  7300:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CC88 41F90003CBBA    	  7301:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CC8E 12303000        	  7302:     move.b  (A0,D3.W),D1
02:0003CC92 B001            	  7303:     cmp.b   D1,D0
02:0003CC94 6A34            	  7304:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7305:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7306:     ;
02:0003CC96 1003            	  7307:     move.b  D3,D0
02:0003CC98 023C00EE        	  7308:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC9C 123C000A        	  7309:     move.b  #$0A,D1
02:0003CCA0 D101            	  7310:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CCA2 7600            	  7311:     moveq   #0,D3
02:0003CCA4 1600            	  7312:     move.b  D0,D3
                            	  7313:     ; Bottom of the loop.
                            	  7314:     ;
                            	  7315:     ; Load the vertical distance for the next iteration.
                            	  7316:     ; Decrement loop counter.
                            	  7317:     ;
02:0003CCA6 102C0005        	  7318:     move.b  ($0005,A4),D0
02:0003CCAA 5314            	  7319:     subq.b  #1,($0000,A4)
02:0003CCAC 6ACC            	  7320:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7321:     ; If we get here, then the bomb was within range of the mouth.
                            	  7322:     ; Go to state 1 (bloated).
                            	  7323:     ;
02:0003CCAE 41EC00AC        	  7324:     lea     ($00AC,A4),A0
02:0003CCB2 52302000        	  7325:     addq.b  #1,(A0,D2.W)
                            	  7326:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7327:     ;
02:0003CCB6 7610            	  7328:     moveq   #16,D3
02:0003CCB8 7000            	  7329:     moveq   #0,D0
02:0003CCBA 41EC00AC        	  7330:     lea     ($00AC,A4),A0
02:0003CCBE 11803000        	  7331:     move.b  D0,(A0,D3.W)
02:0003CCC2 41EC042C        	  7332:     lea     ($042C,A4),A0
02:0003CCC6 11802000        	  7333:     move.b  D0,(A0,D2.W)
                            	  7334:     even
                            	  7335: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CCCA 4E75            	  7336:     rts
