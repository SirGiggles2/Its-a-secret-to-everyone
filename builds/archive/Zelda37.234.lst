                            	  2957: UpdateTrap_Full:
02:0003055E 41EC00AC        	  2958:     lea     ($00AC,A4),A0
02:00030562 10302000        	  2959:     move.b  (A0,D2.W),D0
02:00030566 660000B2        	  2960:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2961:     ; State 0. Sensing.
                            	  2962:     ;
                            	  2963:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2964:     ; then go see if the horizontal distance is shorter.
                            	  2965:     ;
02:0003056A 102C0084        	  2966:     move.b  ($0084,A4),D0
02:0003056E 003C0011        	  2967:     ori     #$11,CCR  ; SEC: set C+X
02:00030572 41EC0084        	  2968:     lea     ($0084,A4),A0
02:00030576 12302000        	  2969:     move.b  (A0,D2.W),D1
02:0003057A 0A3C0010        	  2970:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003057E 9101            	  2971:     subx.b  D1,D0   ; SBC ObjY,X
02:00030580 0A3C0010        	  2972:     eori    #$10,CCR  ; restore X = 6502 C
02:00030584 6100086E        	  2973:     jsr     Abs
02:00030588 0C00000E        	  2974:     cmpi.b  #$0E,D0
02:0003058C 644C            	  2975:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2976:     ; Determine the horizontal direction toward Link;
                            	  2977:     ; and if Link and the trap are at the same X, then we can't move
                            	  2978:     ; along this axis. Go see about moving vertically.
                            	  2979:     ;
02:0003058E 7601            	  2980:     moveq   #1,D3
02:00030590 102C0070        	  2981:     move.b  ($0070,A4),D0
02:00030594 12342070        	  2982:     move.b  ($70,A4,D2.W),D1
02:00030598 B001            	  2983:     cmp.b   D1,D0
02:0003059A 673E            	  2984:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003059C 6402            	  2985:     bcc  _anon_z01_26
02:0003059E 7602            	  2986:     moveq   #2,D3
                            	  2987: _anon_z01_26:
                            	  2988:     ; Remember the original X coordinate.
                            	  2989:     ;
02:000305A0 10342070        	  2990:     move.b  ($70,A4,D2.W),D0
                            	  2991:     even
                            	  2992: _L_z01_UpdateTrap_Full_GoToState1:
02:000305A4 41EC0380        	  2993:     lea     ($0380,A4),A0
02:000305A8 11802000        	  2994:     move.b  D0,(A0,D2.W)
                            	  2995:     ; Set facing direction to the horizontal one that we determined.
                            	  2996:     ;
02:000305AC 1003            	  2997:     move.b  D3,D0
02:000305AE 41EC0098        	  2998:     lea     ($0098,A4),A0
02:000305B2 11802000        	  2999:     move.b  D0,(A0,D2.W)
                            	  3000:     ; If the direction we determined is not allowed for this trap, then
                            	  3001:     ; go draw and check collisions.
                            	  3002:     ;
02:000305B6 41F900030557    	  3003:     lea     (TrapAllowedDirs-1).l,A0
02:000305BC 12302000        	  3004:     move.b  (A0,D2.W),D1
02:000305C0 C001            	  3005:     and.b  D1,D0
02:000305C2 6712            	  3006:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3007:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  3008:     ;
02:000305C4 41EC00AC        	  3009:     lea     ($00AC,A4),A0
02:000305C8 52302000        	  3010:     addq.b  #1,(A0,D2.W)
02:000305CC 7070            	  3011:     moveq   #112,D0
02:000305CE 41EC03BC        	  3012:     lea     ($03BC,A4),A0
02:000305D2 11802000        	  3013:     move.b  D0,(A0,D2.W)
                            	  3014:     even
                            	  3015: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:000305D6 60000102        	  3016:     jmp     L_Trap_DrawAndCheckCollisions
                            	  3017: 
                            	  3018:     even
                            	  3019: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3020:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3021:     ; then this trap definitely wasn't triggered.
                            	  3022:     ; Go draw and check collisions.
                            	  3023:     ;
02:000305DA 102C0070        	  3024:     move.b  ($0070,A4),D0
02:000305DE 003C0011        	  3025:     ori     #$11,CCR  ; SEC: set C+X
02:000305E2 12342070        	  3026:     move.b  ($70,A4,D2.W),D1
02:000305E6 0A3C0010        	  3027:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000305EA 9101            	  3028:     subx.b  D1,D0   ; SBC ObjX,X
02:000305EC 0A3C0010        	  3029:     eori    #$10,CCR  ; restore X = 6502 C
02:000305F0 61000802        	  3030:     jsr     Abs
02:000305F4 0C00000E        	  3031:     cmpi.b  #$0E,D0
02:000305F8 64DC            	  3032:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3033:     ; Determine the vertical direction toward Link;
                            	  3034:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3035:     ; along this axis. Go draw and check object collisions.
                            	  3036:     ;
02:000305FA 7604            	  3037:     moveq   #4,D3
02:000305FC 102C0084        	  3038:     move.b  ($0084,A4),D0
02:00030600 41EC0084        	  3039:     lea     ($0084,A4),A0
02:00030604 12302000        	  3040:     move.b  (A0,D2.W),D1
02:00030608 B001            	  3041:     cmp.b   D1,D0
02:0003060A 67CA            	  3042:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003060C 6402            	  3043:     bcc  _anon_z01_27
02:0003060E 7608            	  3044:     moveq   #8,D3
                            	  3045: _anon_z01_27:
                            	  3046:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3047:     ; set the vertical direction we determined, and other preparations.
                            	  3048:     ;
02:00030610 41EC0084        	  3049:     lea     ($0084,A4),A0
02:00030614 10302000        	  3050:     move.b  (A0,D2.W),D0
02:00030618 668A            	  3051:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3052:     even
                            	  3053: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3054:     ; State 1 and 2.
                            	  3055:     ;
                            	  3056:     ; Move in the direction it's facing.
                            	  3057:     ;
02:0003061A 41EC0098        	  3058:     lea     ($0098,A4),A0
02:0003061E 10302000        	  3059:     move.b  (A0,D2.W),D0
02:00030622 1940000F        	  3060:     move.b  D0,($000F,A4)
02:00030626 4EB90004BAAE    	  3061:     jsr     MoveObject
                            	  3062:     ; Truncate the grid offset to square length ($10).
                            	  3063:     ;
02:0003062C 41EC0394        	  3064:     lea     ($0394,A4),A0
02:00030630 10302000        	  3065:     move.b  (A0,D2.W),D0
02:00030634 0200000F        	  3066:     andi.b #$0F,D0
02:00030638 6608            	  3067:     bne  _anon_z01_28
02:0003063A 41EC0394        	  3068:     lea     ($0394,A4),A0
02:0003063E 11802000        	  3069:     move.b  D0,(A0,D2.W)
                            	  3070: _anon_z01_28:
                            	  3071:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3072:     ;
02:00030642 610017C6        	  3073:     jsr     CheckLinkCollision
                            	  3074:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3075:     ; and current coordinate to the trap's X.
                            	  3076:     ;
02:00030646 7600            	  3077:     moveq   #0,D3
02:00030648 16342070        	  3078:     move.b  ($70,A4,D2.W),D3
02:0003064C 7078            	  3079:     moveq   #120,D0
02:0003064E 1880            	  3080:     move.b  D0,($0000,A4)
02:00030650 41EC0098        	  3081:     lea     ($0098,A4),A0
02:00030654 10302000        	  3082:     move.b  (A0,D2.W),D0
02:00030658 0200000C        	  3083:     andi.b #$0C,D0
02:0003065C 6710            	  3084:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3085:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3086:     ; and current coordinate to the trap's Y.
                            	  3087:     ;
02:0003065E 7600            	  3088:     moveq   #0,D3
02:00030660 41EC0084        	  3089:     lea     ($0084,A4),A0
