02:00044DF6 6700008C        	  8179:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8180:     ; In UW. There are two input directions, and they're both walkable.
                            	  8181:     ;
                            	  8182:     ; Normally, turn to the direction that's perpendicular to object
                            	  8183:     ; direction. But keep going straight after that, while diagonal
                            	  8184:     ; input is held.
                            	  8185:     ;
                            	  8186:     ; Handle special cases for doors.
                            	  8187:     ;
                            	  8188:     ;
                            	  8189:     ; 1. Link at horizontal doors.
                            	  8190:     ;
                            	  8191:     ; If Link's X = $20 or $D0 then
                            	  8192:     ;   If Link's Y = $85 and facing down then
                            	  8193:     ;     Go set object direction and input direction to object
                            	  8194:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8195:     ;     Link_GoStraightWhenDiagInput.
                            	  8196:     ;   Else
                            	  8197:     ;     Go turn to the perpendicular direction
                            	  8198:     ;
