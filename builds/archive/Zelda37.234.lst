                            	  7991: __far_z_05_0099:
                            	  7992:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7993:     ; and represents the current row of the submenu being processed.
                            	  7994:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7995:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7996:     ;
                            	  7997:     ; If the bottom bit is set, go prepare the full black row.
                            	  7998:     ;
02:00044CF0 E208            	  7999:     lsr.b  #1,D0   ; LSR A
02:00044CF2 7600            	  8000:     moveq   #0,D3
02:00044CF4 1600            	  8001:     move.b  D0,D3
02:00044CF6 6402            	  8002:     bcc.s  __far_z_05_0100
02:00044CF8 60B6            	  8003:     jmp  PrepFullBlackRow
