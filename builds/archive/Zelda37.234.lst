                            	  5510: LayOutDoors:
                            	  5511:     ; Copies the right door face for the direction, type, and state
                            	  5512:     ; of the door to the play area tile map.
                            	  5513:     ;
                            	  5514:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5515:     ; that are not true doors.
                            	  5516:     ;
02:00043672 7403            	  5517:     moveq   #3,D2
                            	  5518:     even
                            	  5519: L_LayOutDoors_LoopDoors:
                            	  5520:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5521:     ;
02:00043674 7001            	  5522:     moveq   #1,D0
                            	  5523:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5524:     ;
                            	  5525:     ; [06] indicates whether we're handling the first half of
                            	  5526:     ; the door: Left half for N/S, Top half for E/W.
                            	  5527:     ;
02:00043676 19400006        	  5528:     move.b  D0,($0006,A4)
                            	  5529:     even
                            	  5530: L_LayOutDoors_LoopHalves:
02:0004367A 1002            	  5531:     move.b  D2,D0
02:0004367C 1B00            	  5532:     move.b  D0,-(A5)  ; PHA
02:0004367E 1940000B        	  5533:     move.b  D0,($000B,A4)
02:00043682 41F90004364E    	  5534:     lea     (DoorBits).l,A0
02:00043688 10302000        	  5535:     move.b  (A0,D2.W),D0
02:0004368C 19400002        	  5536:     move.b  D0,($0002,A4)
02:00043690 6100FD4A        	  5537:     jsr     FindDoorAttrByDoorBit
                            	  5538:     ; Begin looking for the door face for the door attribute.
                            	  5539:     ; In general, use the door type as the provisional face;
                            	  5540:     ; except turn 4 into 8.
                            	  5541:     ;
02:00043694 0C000005        	  5542:     cmpi.b  #$05,D0
02:00043698 642A            	  5543:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004369A 0C000004        	  5544:     cmpi.b  #$04,D0
02:0004369E 6608            	  5545:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:000436A0 7008            	  5546:     moveq   #8,D0
02:000436A2 6620            	  5547:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5548:     even
                            	  5549: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5550:     ; We jump here if the door type is bombable and was opened.
                            	  5551:     ; Change the provisional door face to value 9, which
                            	  5552:     ; will become the "hole in the wall".
                            	  5553:     ;
02:000436A4 7009            	  5554:     moveq   #9,D0
02:000436A6 665A            	  5555:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5556:     even
                            	  5557: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5558:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5559:     ; the mask of opened doors, because this is not a true door.
                            	  5560:     ;
02:000436A8 1B00            	  5561:     move.b  D0,-(A5)  ; PHA
02:000436AA 102C0002        	  5562:     move.b  ($0002,A4),D0
02:000436AE 4600            	  5563:     eori.b #$FF,D0
02:000436B0 122C00EE        	  5564:     move.b  ($00EE,A4),D1
02:000436B4 C001            	  5565:     and.b  D1,D0
02:000436B6 194000EE        	  5566:     move.b  D0,($00EE,A4)
02:000436BA 101D            	  5567:     move.b  (A5)+,D0  ; PLA
                            	  5568:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5569:     ;
02:000436BC 0C000001        	  5570:     cmpi.b  #$01,D0
02:000436C0 6402            	  5571:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000436C2 7004            	  5572:     moveq   #4,D0
                            	  5573:     even
                            	  5574: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5575:     ; The door attribute (DA) has been mapped to a
                            	  5576:     ; provisional door face value (PF) in %A as follows:
                            	  5577:     ;
                            	  5578:     ; DA PF Meaning
                            	  5579:     ; -------------
                            	  5580:     ; 0  4  open
                            	  5581:     ; 1  1  wall
                            	  5582:     ; 2  2  false wall
                            	  5583:     ; 3  3  false wall 2
                            	  5584:     ; 4  8  bombable
                            	  5585:     ; 5  5  key
                            	  5586:     ; 6  6  key 2
                            	  5587:     ; 7  7  shutter
                            	  5588:     ;
                            	  5589:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5590:     ; has been cleared, if the type was "open" or any wall.
                            	  5591:     ;
                            	  5592:     ;
                            	  5593:     ; Save the provisional face.
02:000436C4 1B00            	  5594:     move.b  D0,-(A5)  ; PHA
                            	  5595:     ; If the current direction points to a door that has been opened,
                            	  5596:     ; then see if we need to set door flags.
                            	  5597:     ;
02:000436C6 102C00EE        	  5598:     move.b  ($00EE,A4),D0
02:000436CA 122C0002        	  5599:     move.b  ($0002,A4),D1
02:000436CE C001            	  5600:     and.b  D1,D0
02:000436D0 7400            	  5601:     moveq   #0,D2
02:000436D2 1400            	  5602:     move.b  D0,D2
02:000436D4 101D            	  5603:     move.b  (A5)+,D0  ; PLA
02:000436D6 122C0002        	  5604:     move.b  ($0002,A4),D1
02:000436DA B401            	  5605:     cmp.b   D1,D2
02:000436DC 6624            	  5606:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5607:     ; The current direction points to a door that has been opened.
                            	  5608:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5609:     ;
                            	  5610:     ;
                            	  5611:     ; Save provisional door face in Y register.
02:000436DE 7600            	  5612:     moveq   #0,D3
02:000436E0 1600            	  5613:     move.b  D0,D3
02:000436E2 101D            	  5614:     move.b  (A5)+,D0  ; PLA
02:000436E4 1B00            	  5615:     move.b  D0,-(A5)  ; PHA
02:000436E6 7400            	  5616:     moveq   #0,D2
02:000436E8 1400            	  5617:     move.b  D0,D2
02:000436EA 1003            	  5618:     move.b  D3,D0
                            	  5619:     ; If provisional door face is not for a shutter, then
                            	  5620:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5621:     ;
                            	  5622:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5623:     ;
02:000436EC 0C000007        	  5624:     cmpi.b  #$07,D0
02:000436F0 670E            	  5625:     beq  _anon_z05_111
02:000436F2 1B00            	  5626:     move.b  D0,-(A5)  ; PHA
02:000436F4 6100DE44        	  5627:     jsr     SetDoorFlag
02:000436F8 101D            	  5628:     move.b  (A5)+,D0  ; PLA
                            	  5629:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5630:     ; then go make it 9 (open "bombable").
                            	  5631:     ; Else make it 4 (open "door").
                            	  5632:     ;
02:000436FA 0C000008        	  5633:     cmpi.b  #$08,D0
02:000436FE 67A4            	  5634:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5635: _anon_z05_111:
02:00043700 7004            	  5636:     moveq   #4,D0
                            	  5637:     even
                            	  5638: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5639:     ; For opened doors, the provisional door face has become:
                            	  5640:     ;
                            	  5641:     ; DA PF Meaning
                            	  5642:     ; -------------
                            	  5643:     ; 0  4  open
                            	  5644:     ; 1  1  wall
                            	  5645:     ; 2  2  false wall
                            	  5646:     ; 3  3  false wall 2
                            	  5647:     ; 4  9  bombable
                            	  5648:     ; 5  4  key
                            	  5649:     ; 6  4  key 2
                            	  5650:     ; 7  4  shutter
                            	  5651:     ;
                            	  5652:     ;
                            	  5653:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5654:     ;
02:00043702 7400            	  5655:     moveq   #0,D2
02:00043704 142C0006        	  5656:     move.b  ($0006,A4),D2
02:00043708 6712            	  5657:     beq  _anon_z05_112
02:0004370A 7400            	  5658:     moveq   #0,D2
02:0004370C 142C000B        	  5659:     move.b  ($000B,A4),D2
02:00043710 1B00            	  5660:     move.b  D0,-(A5)  ; PHA
02:00043712 6100FCC8        	  5661:     jsr     FindDoorAttrByDoorBit
02:00043716 61001CBA        	  5662:     jsr     CalcOpenDoorwayMask
02:0004371A 101D            	  5663:     move.b  (A5)+,D0  ; PLA
                            	  5664: _anon_z05_112:
                            	  5665:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5666:     ; because the visible door face is already a wall.
                            	  5667:     ;
02:0004371C 0C000004        	  5668:     cmpi.b  #$04,D0
02:00043720 650000DC        	  5669:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5670:     ; For all other provisional face values, calculate:
                            	  5671:     ; door face := provisional face - 3
02:00043724 003C0011        	  5672:     ori     #$11,CCR  ; SEC: set C+X
02:00043728 123C0003        	  5673:     move.b  #$03,D1
02:0004372C 0A3C0010        	  5674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043730 9101            	  5675:     subx.b  D1,D0   ; SBC #$03
02:00043732 0A3C0010        	  5676:     eori    #$10,CCR  ; restore X = 6502 C
02:00043736 7600            	  5677:     moveq   #0,D3
02:00043738 1600            	  5678:     move.b  D0,D3
                            	  5679:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5680:     ; subtract one.
                            	  5681:     ;
02:0004373A 0C030003        	  5682:     cmpi.b  #$03,D3
02:0004373E 6502            	  5683:     bcs  _anon_z05_113
02:00043740 5303            	  5684:     subq.b  #1,D3
                            	  5685: _anon_z05_113:
                            	  5686:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5687:     ;
                            	  5688:     ; DT DFC DFO Meaning
                            	  5689:     ; ------------------
                            	  5690:     ; 0  1   1   open
                            	  5691:     ; 4  4   5   bombable
                            	  5692:     ; 5  2   1   key
                            	  5693:     ; 6  2   1   key 2
                            	  5694:     ; 7  3   1   shutter
                            	  5695:     ;
                            	  5696:     ;
                            	  5697:     ; Get the direction index.
02:00043742 101D            	  5698:     move.b  (A5)+,D0  ; PLA
02:00043744 1B00            	  5699:     move.b  D0,-(A5)  ; PHA
02:00043746 610000D0        	  5700:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5701:     ; If handling the second half, then offset to the second half
                            	  5702:     ; of the tiles.
                            	  5703:     ;
02:0004374A 102C0006        	  5704:     move.b  ($0006,A4),D0
02:0004374E 6618            	  5705:     bne  _anon_z05_114
02:00043750 41F900043666    	  5706:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00043756 10302000        	  5707:     move.b  (A0,D2.W),D0
02:0004375A 4EB900031246    	  5708:     jsr     AddToInt16At0
02:00043760 7006            	  5709:     moveq   #6,D0
02:00043762 4EB90003124E    	  5710:     jsr     AddToInt16At2
                            	  5711: _anon_z05_114:
                            	  5712:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5713:     ; Pointers will be incremented instead of Y.
02:00043768 7600            	  5714:     moveq   #0,D3
02:0004376A 41F90004366A    	  5715:     lea     (DirIndexToDoorColumnCount).l,A0
02:00043770 10302000        	  5716:     move.b  (A0,D2.W),D0
02:00043774 19400005        	  5717:     move.b  D0,($0005,A4)
