                            	  5547:     ; Go set the qspeed.
                            	  5548:     ;
02:0003BFE6 673E            	  5549:     beq  _L_z04_UpdateStalfos_SetSpeed
                            	  5550:     ; If shoot timer <> $10, or we have the magic clock, or stunned;
                            	  5551:     ; then go reset qspeed.
