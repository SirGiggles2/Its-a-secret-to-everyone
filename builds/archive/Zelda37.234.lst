02:0003C078 41EC0486        	  5633:     lea     ($0486,A4),A0
02:0003C07C 11803000        	  5634:     move.b  D0,(A0,D3.W)
                            	  5635:     ; Start with flying speed $80, and in flying state 2.
                            	  5636:     ;
02:0003C080 103C0080        	  5637:     move.b  #$80,D0
02:0003C084 41EC0420        	  5638:     lea     ($0420,A4),A0
02:0003C088 11803000        	  5639:     move.b  D0,(A0,D3.W)
02:0003C08C 7002            	  5640:     moveq   #2,D0
02:0003C08E 41EC0445        	  5641:     lea     ($0445,A4),A0
02:0003C092 11803000        	  5642:     move.b  D0,(A0,D3.W)
02:0003C096 7041            	  5643:     moveq   #65,D0
02:0003C098 41EC0350        	  5644:     lea     ($0350,A4),A0
02:0003C09C 11803000        	  5645:     move.b  D0,(A0,D3.W)
                            	  5646:     ; Bottom of the loop.
