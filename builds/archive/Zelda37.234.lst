02:0003F59E 12302000        	 12893:     move.b  (A0,D2.W),D1
02:0003F5A2 8001            	 12894:     or.b  D1,D0
02:0003F5A4 19400003        	 12895:     move.b  D0,($0003,A4)
02:0003F5A8 41F90003F472    	 12896:     lea     (GanonBurstTiles).l,A0
