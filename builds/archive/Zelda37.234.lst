                            	  4970: __far_z_07_0076:
                            	  4971:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4972:     ; unused, so it only has to depend on having an empty slot.
                            	  4973:     ;
                            	  4974:     ; If successful, Link's state will have been changed to "using item".
                            	  4975:     ; But we don't want that in this case.
                            	  4976:     ;
                            	  4977:     ; For both these reasons, save state and restore it afterward.
                            	  4978:     ;
02:0004C0C2 102C00AC        	  4979:     move.b  ($00AC,A4),D0
02:0004C0C6 1B00            	  4980:     move.b  D0,-(A5)  ; PHA
02:0004C0C8 102C0513        	  4981:     move.b  ($0513,A4),D0
02:0004C0CC 1B00            	  4982:     move.b  D0,-(A5)  ; PHA
02:0004C0CE 7000            	  4983:     moveq   #0,D0
02:0004C0D0 19400513        	  4984:     move.b  D0,($0513,A4)
02:0004C0D4 4EB90003103A    	  4985:     jsr     WieldCandle
02:0004C0DA 101D            	  4986:     move.b  (A5)+,D0  ; PLA
02:0004C0DC 19400513        	  4987:     move.b  D0,($0513,A4)
02:0004C0E0 101D            	  4988:     move.b  (A5)+,D0  ; PLA
02:0004C0E2 194000AC        	  4989:     move.b  D0,($00AC,A4)
                            	  4990:     ; State $21 means that a moving fire was just made.
                            	  4991:     ;
