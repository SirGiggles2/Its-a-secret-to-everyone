                            	 12427: UpdateGanon_JumpTable:
02:0003F282 0003F28E        	 12428:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F286 0003F2F0        	 12429:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F28A 0003F31E        	 12430:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12431: 
                            	 12432: ; Description:
                            	 12433: ; Lift up the Triforce of Courage while the room is dark.
                            	 12434: ;
                            	 12435: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12436: ;
                            	 12437:     even
                            	 12438: Ganon_ScenePhase0:
02:0003F28E 701B            	 12439:     moveq   #27,D0
02:0003F290 19400505        	 12440:     move.b  D0,($0505,A4)
                            	 12441:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12442:     ;
02:0003F294 102C0028        	 12443:     move.b  ($0028,A4),D0
02:0003F298 6644            	 12444:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12445:     ; Once the timer expires, it's time to brighten the room.
                            	 12446:     ;
                            	 12447:     ; Save the current object slot.
02:0003F29A 1002            	 12448:     move.b  D2,D0
02:0003F29C 1B00            	 12449:     move.b  D0,-(A5)  ; PHA
02:0003F29E 610007F0        	 12450:     jsr     UpdateCandle
02:0003F2A2 101D            	 12451:     move.b  (A5)+,D0  ; PLA
02:0003F2A4 7400            	 12452:     moveq   #0,D2
02:0003F2A6 1400            	 12453:     move.b  D0,D2
                            	 12454:     ; Turn off the room brightening flag, because we're controlling it
                            	 12455:     ; here instead of in the Mode 5 object update loop.
                            	 12456:     ;
02:0003F2A8 7000            	 12457:     moveq   #0,D0
02:0003F2AA 1940051E        	 12458:     move.b  D0,($051E,A4)
                            	 12459:     ; On the first frame of the fade-to-light cycle, play the
                            	 12460:     ; Triforce/Ganon song.
                            	 12461:     ;
02:0003F2AE 102C051C        	 12462:     move.b  ($051C,A4),D0
02:0003F2B2 0C0000C0        	 12463:     cmpi.b  #$C0,D0
02:0003F2B6 6606            	 12464:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F2B8 7002            	 12465:     moveq   #2,D0
02:0003F2BA 19400600        	 12466:     move.b  D0,($0600,A4)
                            	 12467:     even
