02:0003A72E 162C00EB        	  2087:     move.b  ($00EB,A4),D3
02:0003A732 41F900FF687E    	  2088:     lea     (NES_SRAM+$087E).l,A0
02:0003A738 10303000        	  2089:     move.b  (A0,D3.W),D0
02:0003A73C 02000008        	  2090:     andi.b #$08,D0
02:0003A740 677C            	  2091:     beq  _L_z04_CheckZora_Exit
