                            	   150: TransferCurTileBuf:
                            	   151:     ; PATCHED: DynTileBuf pending-record pre-check (generalized Bug C fix).
                            	   152:     ; If DynTileBuf is non-empty while TileBufSelector already points at a
                            	   153:     ; later static buffer, consume DynTileBuf first and leave selector intact
                            	   154:     ; for the next NMI. This preserves NES ordering for dynamic room/menu
                            	   155:     ; records that would otherwise be dropped by selector timing drift.
02:00045800 41F900FF0302    	   156:     lea     (NES_RAM+DynTileBuf).l,A0
02:00045806 0C1000FF        	   157:     cmpi.b  #$FF,(A0)                  ; DynTileBuf empty sentinel?
02:0004580A 672E            	   158:     beq.s   .no_pending_dyn
02:0004580C 4A2C0014        	   159:     tst.b   ($0014,A4)                  ; TileBufSelector = 0 => normal DynTileBuf path
02:00045810 6728            	   160:     beq.s   .no_pending_dyn
02:00045812 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:00045816 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:0004581C 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00045820 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:00045828 703F            	   165:     moveq   #63,D0
02:0004582A 19400300        	   166:     move.b  D0,($0300,A4)
02:0004582E 7400            	   167:     moveq   #0,D2
02:00045830 1942005C        	   168:     move.b  D2,($005C,A4)
02:00045834 19420301        	   169:     move.b  D2,($0301,A4)
02:00045838 4E75            	   170:     rts
                            	   171: .no_pending_dyn:
                            	   172:     ; 32-bit pointer table lookup for main dispatch.
02:0004583A 7400            	   173:     moveq   #0,D2
02:0004583C 142C0014        	   174:     move.b  ($0014,A4),D2
02:00045840 D442            	   175:     add.w   D2,D2                       ; 2-byte index -> 4-byte index
02:00045842 43F9000475A8    	   176:     lea     (TransferBufPtrs).l,A1
02:00045848 20312000        	   177:     move.l  (A1,D2.W),D0               ; D0 = 32-bit buffer pointer
02:0004584C 2040            	   178:     movea.l D0,A0                      ; A0 = 32-bit buffer pointer
02:0004584E 611C            	   179:     jsr     TransferTileBuf
02:00045850 703F            	   180:     moveq   #63,D0
02:00045852 19400300        	   181:     move.b  D0,($0300,A4)
02:00045856 7400            	   182:     moveq   #0,D2
02:00045858 19420014        	   183:     move.b  D2,($0014,A4)
02:0004585C 1942005C        	   184:     move.b  D2,($005C,A4)
02:00045860 19420301        	   185:     move.b  D2,($0301,A4)
02:00045864 5302            	   186:     subq.b  #1,D2
02:00045866 19420302        	   187:     move.b  D2,($0302,A4)
02:0004586A 4E75            	   188:     rts
