                            	  6934: UpdateDodongoState0_Move:
                            	  6935:     ; If facing left, then push X offset 0 on the stack.
                            	  6936:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6937:     ;
                            	  6938:     ; We would like to use one set of coordinates only.
                            	  6939:     ; But movement would break down, if we did; because
                            	  6940:     ; Dodongo is so long.
                            	  6941:     ;
                            	  6942:     ; So, when not facing left, we temporarily shift the
                            	  6943:     ; X coordinate to be closer to the other side of the monster.
                            	  6944:     ;
02:0003C9F8 7600            	  6945:     moveq   #0,D3
02:0003C9FA 41EC0098        	  6946:     lea     ($0098,A4),A0
02:0003C9FE 10302000        	  6947:     move.b  (A0,D2.W),D0
02:0003CA02 0200000D        	  6948:     andi.b #$0D,D0
02:0003CA06 6716            	  6949:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CA08 10342070        	  6950:     move.b  ($70,A4,D2.W),D0
02:0003CA0C 023C00EE        	  6951:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA10 123C0010        	  6952:     move.b  #$10,D1
02:0003CA14 D101            	  6953:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CA16 19802070        	  6954:     move.b  D0,($70,A4,D2.W)
02:0003CA1A 163C00F0        	  6955:     move.b  #$F0,D3
                            	  6956:     even
                            	  6957: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CA1E 1003            	  6958:     move.b  D3,D0
02:0003CA20 1B00            	  6959:     move.b  D0,-(A5)  ; PHA
02:0003CA22 7020            	  6960:     moveq   #32,D0
02:0003CA24 41EC041F        	  6961:     lea     ($041F,A4),A0
02:0003CA28 11802000        	  6962:     move.b  D0,(A0,D2.W)
02:0003CA2C 6100D05A        	  6963:     jsr     Wanderer_TargetPlayer
                            	  6964:     ; Pop the offset and add it to the X coordinate.
                            	  6965:     ;
                            	  6966:     ; This brings the X coordinate back to the unique value
                            	  6967:     ; that represents the position.
                            	  6968:     ;
02:0003CA30 101D            	  6969:     move.b  (A5)+,D0  ; PLA
02:0003CA32 023C00EE        	  6970:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA36 12342070        	  6971:     move.b  ($70,A4,D2.W),D1
