02:0003DE36 10342019        	  9692:     move.b  ($19,A4,D2.W),D0
02:0003DE3A 02000003        	  9693:     andi.b #$03,D0
02:0003DE3E 023C00EE        	  9694:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE42 122C0003        	  9695:     move.b  ($0003,A4),D1
02:0003DE46 D101            	  9696:     addx.b  D1,D0   ; ADC $03
02:0003DE48 41EC0451        	  9697:     lea     ($0451,A4),A0
02:0003DE4C 12302000        	  9698:     move.b  (A0,D2.W),D1
