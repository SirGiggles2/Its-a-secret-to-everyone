02:0003C0A2 6A90            	  5649:     bpl  _anon_z04_77
                            	  5650:     ; Choose a random 8-way direction for the head segments
                            	  5651:     ; in slots 4 and 9.
                            	  5652:     ;
02:0003C0A4 102C001D        	  5653:     move.b  ($001D,A4),D0
02:0003C0A8 02000007        	  5654:     andi.b #$07,D0
02:0003C0AC 7600            	  5655:     moveq   #0,D3
02:0003C0AE 1600            	  5656:     move.b  D0,D3
02:0003C0B0 41F90003FB4C    	  5657:     lea     (Directions8).l,A0
02:0003C0B6 10303000        	  5658:     move.b  (A0,D3.W),D0
02:0003C0BA 1940009D        	  5659:     move.b  D0,($009D,A4)
02:0003C0BE 19400385        	  5660:     move.b  D0,($0385,A4)
02:0003C0C2 102C0022        	  5661:     move.b  ($0022,A4),D0
02:0003C0C6 02000007        	  5662:     andi.b #$07,D0
02:0003C0CA 7600            	  5663:     moveq   #0,D3
02:0003C0CC 1600            	  5664:     move.b  D0,D3
02:0003C0CE 41F90003FB4C    	  5665:     lea     (Directions8).l,A0
02:0003C0D4 10303000        	  5666:     move.b  (A0,D3.W),D0
02:0003C0D8 194000A2        	  5667:     move.b  D0,($00A2,A4)
02:0003C0DC 1940038A        	  5668:     move.b  D0,($038A,A4)
                            	  5669:     ; Set minimum number of turns 1 for flying states.
                            	  5670:     ;
                            	  5671:     ; By setting this, the first time that a flight control routine
                            	  5672:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  5673:     ; that flying state will immediately end, and object timer
