02:0003D242 7000            	  8076:     moveq   #0,D0
02:0003D244 19400028        	  8077:     move.b  D0,($0028,A4)
02:0003D248 19400405        	  8078:     move.b  D0,($0405,A4)
02:0003D24C 194000C0        	  8079:     move.b  D0,($00C0,A4)
02:0003D250 194000D3        	  8080:     move.b  D0,($00D3,A4)
                            	  8081:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  8082:     ;
02:0003D254 41EC03E4        	  8083:     lea     ($03E4,A4),A0
02:0003D258 11802000        	  8084:     move.b  D0,(A0,D2.W)
02:0003D25C 7004            	  8085:     moveq   #4,D0
02:0003D25E 41EC03D0        	  8086:     lea     ($03D0,A4),A0
02:0003D262 11802000        	  8087:     move.b  D0,(A0,D2.W)
                            	  8088:     ; Now Link can't move.
                            	  8089:     ;
02:0003D266 522C0512        	  8090:     addq.b  #1,($0512,A4)
                            	  8091:     even
