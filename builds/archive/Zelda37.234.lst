02:0003BBB8 41EC0412        	  5047:     lea     ($0412,A4),A0
02:0003BBBC 16302000        	  5048:     move.b  (A0,D2.W),D3
02:0003BBC0 41F90003B9F2    	  5049:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003BBC6 10303000        	  5050:     move.b  (A0,D3.W),D0
