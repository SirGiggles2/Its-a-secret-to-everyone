                            	  5618: CheckState30:
                            	  5619:     ; If major state <> $30, go check other states.
                            	  5620:     ;
02:0004C52A 0C000030        	  5621:     cmpi.b  #$30,D0
02:0004C52E 6656            	  5622:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5623:     ; State $3x. Slow down.
                            	  5624:     ;
                            	  5625:     ; Reset grid offset for movement.
                            	  5626:     ;
02:0004C530 7000            	  5627:     moveq   #0,D0
02:0004C532 41EC0394        	  5628:     lea     ($0394,A4),A0
02:0004C536 11802000        	  5629:     move.b  D0,(A0,D2.W)
