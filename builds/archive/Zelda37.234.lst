02:00043810 6A02            	  5795:     bpl.s  __far_z_05_0078
02:00043812 604E            	  5796:     jmp  L165D4_Exit
                            	  5797: __far_z_05_0078:
02:00043814 6000FE5E        	  5798:     jmp     L_LayOutDoors_LoopDoors
                            	  5799: 
                            	  5800: ; Params:
                            	  5801: ; A: direction index
                            	  5802: ; Y: face index
                            	  5803: ;
                            	  5804: ; Returns:
                            	  5805: ; X: direction index
                            	  5806: ; [$00:01]: address of door inside play area tile map
                            	  5807: ; [$02:03]: address of door tiles for direction and face
                            	  5808: ;
                            	  5809:     even
