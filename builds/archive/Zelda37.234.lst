                            	   739: UpdatePersonState_Textbox:
02:0002E5BC 7001            	   740:     moveq   #1,D0
02:0002E5BE 6100C43A        	   741:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E5C2 4EB90004BD66    	   742:     jsr     Link_EndMoveAndDraw_Bank1
                            	   743:     ; If the person's timer has not expired, then return.
                            	   744:     ;
