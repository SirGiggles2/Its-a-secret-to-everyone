                            	  2909: Link_FilterInput:
                            	  2910:     ; [00] holds the opposite of Link's facing direction.
                            	  2911:     ;
02:00041974 102C0098        	  2912:     move.b  ($0098,A4),D0
02:00041978 4EB900030DF0    	  2913:     jsr     GetOppositeDir
02:0004197E 1880            	  2914:     move.b  D0,($0000,A4)
                            	  2915:     ; Call GetOppositeDir again to use this mapping:
                            	  2916:     ; In Dir: 1 2 4 8
                            	  2917:     ;         -------
                            	  2918:     ; Index:  2 3 0 1
                            	  2919:     ;
02:00041980 4EB900030DF0    	  2920:     jsr     GetOppositeDir
                            	  2921:     ; Get the appropriate coordinate for the direction:
                            	  2922:     ; X for horizontal
                            	  2923:     ; Y for vertical
                            	  2924:     ;
02:00041986 102C0070        	  2925:     move.b  ($0070,A4),D0
02:0004198A 0C030002        	  2926:     cmpi.b  #$02,D3
02:0004198E 6404            	  2927:     bcc  _anon_z05_74
02:00041990 102C0084        	  2928:     move.b  ($0084,A4),D0
                            	  2929: _anon_z05_74:
02:00041994 19400002        	  2930:     move.b  D0,($0002,A4)
                            	  2931:     ; Mask A button and directions if inner border is crossed.
                            	  2932:     ;
02:00041998 1003            	  2933:     move.b  D3,D0
02:0004199A 1B00            	  2934:     move.b  D0,-(A5)  ; PHA
02:0004199C 023C00EE        	  2935:     andi    #$EE,CCR  ; CLC: clear C+X
02:000419A0 123C0008        	  2936:     move.b  #$08,D1
02:000419A4 D101            	  2937:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000419A6 7600            	  2938:     moveq   #0,D3
02:000419A8 1600            	  2939:     move.b  D0,D3
02:000419AA 103C0080        	  2940:     move.b  #$80,D0
02:000419AE 6134            	  2941:     jsr     MaskInputInBorder
02:000419B0 101D            	  2942:     move.b  (A5)+,D0  ; PLA
02:000419B2 7600            	  2943:     moveq   #0,D3
02:000419B4 1600            	  2944:     move.b  D0,D3
                            	  2945:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2946:     ; boundary using player's direction and reverse direction index.
                            	  2947:     ;
02:000419B6 102C0001        	  2948:     move.b  ($0001,A4),D0
