                            	  2659: ; PATCH P25b: FS2-E backspace handler.
                            	  2660: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2661: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2662: ; one column (8 px), and writes a space ($24) to the erased
                            	  2663: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2664: ; cannot cross into a previous slot's name field.
                            	  2665: _L_z02_ModeE_HandleAOrB_Backspace:
02:00035002 7600            	  2666:     moveq   #0,D3
02:00035004 162C0016        	  2667:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00035008 41F900034920    	  2668:     lea     (SlotToNameOffset).l,A0
02:0003500E 12303000        	  2669:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00035012 102C0421        	  2670:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00035016 B001            	  2671:     cmp.b   D1,D0
02:00035018 6322            	  2672:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:0003501A 5300            	  2673:     subq.b  #1,D0
02:0003501C 19400421        	  2674:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00035020 532C0423        	  2675:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00035024 122C0070        	  2676:     move.b  ($0070,A4),D1
02:00035028 5101            	  2677:     subi.b  #8,D1
02:0003502A 19410070        	  2678:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:0003502E 7224            	  2679:     moveq   #$24,D1              ; space tile
02:00035030 7600            	  2680:     moveq   #0,D3
02:00035032 1600            	  2681:     move.b  D0,D3                ; D3 = erased offset
02:00035034 41EC0638        	  2682:     lea     ($0638,A4),A0
02:00035038 11813000        	  2683:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2684:     jmp     _L_z02_ModeE_HandleAOrB_Exit
