02:0004C4DE 123C0010        	  5576:     move.b  #$10,D1
02:0004C4E2 D101            	  5577:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C4E4 41EC00AC        	  5578:     lea     ($00AC,A4),A0
02:0004C4E8 11802000        	  5579:     move.b  D0,(A0,D2.W)
                            	  5580:     even
