                            	  3481: CheckCaveEdge:
02:00041D24 4EB90004BC54    	  3482:     jsr     CheckScreenEdge
                            	  3483:     ; If the player touched the edge of the screen and triggered
                            	  3484:     ; a transition to another mode, then go set up the right mode.
                            	  3485:     ;
02:00041D2A 102C0011        	  3486:     move.b  ($0011,A4),D0
02:00041D2E 6602            	  3487:     bne.s  __far_z_05_0064
02:00041D30 60E4            	  3488:     jmp  GoToModeAFromCave
                            	  3489: __far_z_05_0064:
02:00041D32 4E75            	  3490:     rts
                            	  3491: 
                            	  3492: ; Params:
                            	  3493: ; [0F]: movement direction
                            	  3494: ;
                            	  3495: ; Returns:
                            	  3496: ; [0F]: movement direction or 0
                            	  3497: ;
                            	  3498: ;
                            	  3499: ; If the ladder's not in use, return.
                            	  3500: ;
                            	  3501:     even
                            	  3502: CheckLadder:
02:00041D34 7400            	  3503:     moveq   #0,D2
02:00041D36 142C0064        	  3504:     move.b  ($0064,A4),D2
02:00041D3A 670000BE        	  3505:     beq  _L_z05_CheckLadder_Exit
                            	  3506:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3507:     ;
02:00041D3E 41EC00AC        	  3508:     lea     ($00AC,A4),A0
02:00041D42 10302000        	  3509:     move.b  (A0,D2.W),D0
02:00041D46 670000A6        	  3510:     beq  _L_z05_CheckLadder_StashLadder
                            	  3511:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3512:     ; between the ladder and Link.
                            	  3513:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3514:     ;
02:00041D4A 41EC0098        	  3515:     lea     ($0098,A4),A0
02:00041D4E 10302000        	  3516:     move.b  (A0,D2.W),D0
02:00041D52 0200000C        	  3517:     andi.b #$0C,D0
02:00041D56 6734            	  3518:     beq  _anon_z05_85
02:00041D58 102C0070        	  3519:     move.b  ($0070,A4),D0
02:00041D5C 12342070        	  3520:     move.b  ($70,A4,D2.W),D1
02:00041D60 B001            	  3521:     cmp.b   D1,D0
02:00041D62 6600008A        	  3522:     bne  _L_z05_CheckLadder_StashLadder
02:00041D66 102C0084        	  3523:     move.b  ($0084,A4),D0
02:00041D6A 023C00EE        	  3524:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D6E 123C0003        	  3525:     move.b  #$03,D1
02:00041D72 D101            	  3526:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D74 003C0011        	  3527:     ori     #$11,CCR  ; SEC: set C+X
02:00041D78 41EC0084        	  3528:     lea     ($0084,A4),A0
02:00041D7C 12302000        	  3529:     move.b  (A0,D2.W),D1
02:00041D80 0A3C0010        	  3530:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D84 9101            	  3531:     subx.b  D1,D0   ; SBC ObjY,X
02:00041D86 0A3C0010        	  3532:     eori    #$10,CCR  ; restore X = 6502 C
02:00041D8A 6030            	  3533:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3534: 
                            	  3535: _anon_z05_85:
                            	  3536:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3537:     ; between the ladder and Link.
                            	  3538:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3539:     ;
02:00041D8C 102C0084        	  3540:     move.b  ($0084,A4),D0
02:00041D90 023C00EE        	  3541:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D94 123C0003        	  3542:     move.b  #$03,D1
02:00041D98 D101            	  3543:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D9A 41EC0084        	  3544:     lea     ($0084,A4),A0
02:00041D9E 12302000        	  3545:     move.b  (A0,D2.W),D1
02:00041DA2 B001            	  3546:     cmp.b   D1,D0
02:00041DA4 6648            	  3547:     bne  _L_z05_CheckLadder_StashLadder
02:00041DA6 102C0070        	  3548:     move.b  ($0070,A4),D0
02:00041DAA 003C0011        	  3549:     ori     #$11,CCR  ; SEC: set C+X
02:00041DAE 12342070        	  3550:     move.b  ($70,A4,D2.W),D1
02:00041DB2 0A3C0010        	  3551:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DB6 9101            	  3552:     subx.b  D1,D0   ; SBC ObjX,X
02:00041DB8 0A3C0010        	  3553:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3554:     even
                            	  3555: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3556:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3557:     ; If > $10, go put the ladder away.
                            	  3558:     ;
02:00041DBC 4EB900030DF4    	  3559:     jsr     Abs
02:00041DC2 1880            	  3560:     move.b  D0,($0000,A4)
02:00041DC4 0C000010        	  3561:     cmpi.b  #$10,D0
02:00041DC8 6532            	  3562:     bcs  _L_z05_CheckLadder_SetState2
02:00041DCA 0C000010        	  3563:     cmpi.b  #$10,D0
02:00041DCE 661E            	  3564:     bne  _L_z05_CheckLadder_StashLadder
                            	  3565:     ; Distance = $10. If player's not facing in the same direction as
                            	  3566:     ; the ladder, go put away the ladder.
                            	  3567:     ;
02:00041DD0 102C0098        	  3568:     move.b  ($0098,A4),D0
02:00041DD4 41EC0098        	  3569:     lea     ($0098,A4),A0
02:00041DD8 12302000        	  3570:     move.b  (A0,D2.W),D1
02:00041DDC B001            	  3571:     cmp.b   D1,D0
02:00041DDE 660E            	  3572:     bne  _L_z05_CheckLadder_StashLadder
                            	  3573:     ; Distance = $10, and player's facing in the same direction.
                            	  3574:     ;
                            	  3575:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3576:     ; ladder and had not stepped onto it yet.
                            	  3577:     ; Go handle movement on it, but don't change state yet.
                            	  3578:     ;
                            	  3579:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3580:     ; off of the ladder. So the ladder should be put away. In this
                            	  3581:     ; case, fall thru.
                            	  3582:     ;
02:00041DE0 41EC00AC        	  3583:     lea     ($00AC,A4),A0
02:00041DE4 10302000        	  3584:     move.b  (A0,D2.W),D0
02:00041DE8 0C000001        	  3585:     cmpi.b  #$01,D0
02:00041DEC 6718            	  3586:     beq  _L_z05_CheckLadder_HandleInput
                            	  3587:     even
                            	  3588: _L_z05_CheckLadder_StashLadder:
                            	  3589:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3590:     ;
02:00041DEE 7000            	  3591:     moveq   #0,D0
02:00041DF0 19400064        	  3592:     move.b  D0,($0064,A4)
02:00041DF4 4EB90004D62E    	  3593:     jsr     DestroyMonster
                            	  3594:     even
                            	  3595: _L_z05_CheckLadder_Exit:
02:00041DFA 4E75            	  3596:     rts
                            	  3597: 
                            	  3598:     even
                            	  3599: _L_z05_CheckLadder_SetState2:
                            	  3600:     ;  Set state 2, because we're on the ladder.
                            	  3601:     ;
02:00041DFC 7002            	  3602:     moveq   #2,D0
02:00041DFE 41EC00AC        	  3603:     lea     ($00AC,A4),A0
02:00041E02 11802000        	  3604:     move.b  D0,(A0,D2.W)
                            	  3605:     even
                            	  3606: _L_z05_CheckLadder_HandleInput:
                            	  3607:     ; If input direction = 0, go draw and reset moving direction.
                            	  3608:     ;
02:00041E06 102C03F8        	  3609:     move.b  ($03F8,A4),D0
02:00041E0A 67000086        	  3610:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3611:     ; Input direction <> 0. The player intends to move.
                            	  3612:     ; So, see if we need to override the moving direction.
                            	  3613:     ;
                            	  3614:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3615:     ; go draw and set moving direction to Link's direction.
                            	  3616:     ;
                            	  3617:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3618:     ; been blocked by the water.
                            	  3619:     ;
                            	  3620:     ; Or, Link already passed over the point right over the ladder
                            	  3621:     ; and was allowed to move onto the tiles after the ladder.
                            	  3622:     ;
02:00041E0E 102C0098        	  3623:     move.b  ($0098,A4),D0
02:00041E12 7600            	  3624:     moveq   #0,D3
02:00041E14 1614            	  3625:     move.b  ($0000,A4),D3
02:00041E16 670C            	  3626:     beq  _anon_z05_86
02:00041E18 41EC0098        	  3627:     lea     ($0098,A4),A0
02:00041E1C 12302000        	  3628:     move.b  (A0,D2.W),D1
02:00041E20 B001            	  3629:     cmp.b   D1,D0
02:00041E22 676E            	  3630:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3631: _anon_z05_86:
                            	  3632:     ; Distance = 0, or facing different directions.
                            	  3633:     ;
                            	  3634:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3635:     ; then go draw and keep moving.
                            	  3636:     ;
                            	  3637:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3638:     ;
                            	  3639:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3640:     ; to move onto the tiles after the ladder.
                            	  3641:     ;
                            	  3642:     ; Note that if Link is not moving, then this test will fail,
                            	  3643:     ; and case (D) will catch it.
                            	  3644:     ;
02:00041E24 41EC0098        	  3645:     lea     ($0098,A4),A0
02:00041E28 10302000        	  3646:     move.b  (A0,D2.W),D0
02:00041E2C 122C000F        	  3647:     move.b  ($000F,A4),D1
02:00041E30 B001            	  3648:     cmp.b   D1,D0
02:00041E32 675E            	  3649:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3650:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3651:     ; then go draw and move in ladder's direction.
                            	  3652:     ;
                            	  3653:     ; You can always step off the ladder where you came from.
                            	  3654:     ;
02:00041E34 4EB900030DF0    	  3655:     jsr     GetOppositeDir
02:00041E3A 122C0098        	  3656:     move.b  ($0098,A4),D1
02:00041E3E B001            	  3657:     cmp.b   D1,D0
02:00041E40 6750            	  3658:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3659:     ; D. If opposite of ladder's direction <> down,
                            	  3660:     ; or input direction <> up,
                            	  3661:     ; then go reset moving direction, and draw.
                            	  3662:     ;
                            	  3663:     ; This will catch all cases of Link facing perpendicular to
                            	  3664:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3665:     ; ladder direction is up and input direction is up (E).
                            	  3666:     ;
02:00041E42 0C000004        	  3667:     cmpi.b  #$04,D0
02:00041E46 6648            	  3668:     bne  _anon_z05_87
02:00041E48 102C03F8        	  3669:     move.b  ($03F8,A4),D0
02:00041E4C 0C000008        	  3670:     cmpi.b  #$08,D0
02:00041E50 663E            	  3671:     bne  _anon_z05_87
                            	  3672:     ; E. The ladder's direction is up and input direction is up.
                            	  3673:     ;
                            	  3674:     ; An earlier call to check tile collision would have blocked
                            	  3675:     ; movement, because the tile under Link's top half is a water tile.
                            	  3676:     ; But because Link is squarely on the ladder, we really have
                            	  3677:     ; to check the tile above that one.
                            	  3678:     ;
                            	  3679:     ; Set moving direction to input direction (up) and switch X to
                            	  3680:     ; the player's slot for the purpose of checking tile collision below.
                            	  3681:     ; Based on that, we'll set moving direction according to walkability.
                            	  3682:     ;
02:00041E52 6158            	  3683:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3684:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3685:     ;
02:00041E54 102C0084        	  3686:     move.b  ($0084,A4),D0
02:00041E58 1B00            	  3687:     move.b  D0,-(A5)  ; PHA
02:00041E5A 003C0011        	  3688:     ori     #$11,CCR  ; SEC: set C+X
02:00041E5E 123C0008        	  3689:     move.b  #$08,D1
02:00041E62 0A3C0010        	  3690:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041E66 9101            	  3691:     subx.b  D1,D0   ; SBC #$08
02:00041E68 0A3C0010        	  3692:     eori    #$10,CCR  ; restore X = 6502 C
02:00041E6C 19400084        	  3693:     move.b  D0,($0084,A4)
02:00041E70 4EB90004B75A    	  3694:     jsr     GetCollidingTileMoving
02:00041E76 101D            	  3695:     move.b  (A5)+,D0  ; PLA
02:00041E78 19400084        	  3696:     move.b  D0,($0084,A4)
                            	  3697:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3698:     ; direction as the input direction (in a roundabout way).
                            	  3699:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3700:     ;
02:00041E7C 102C000F        	  3701:     move.b  ($000F,A4),D0
02:00041E80 7600            	  3702:     moveq   #0,D3
02:00041E82 162C049E        	  3703:     move.b  ($049E,A4),D3
02:00041E86 122C034A        	  3704:     move.b  ($034A,A4),D1
02:00041E8A B601            	  3705:     cmp.b   D1,D3
02:00041E8C 6500FF78        	  3706:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3707: _anon_z05_87:
                            	  3708:     ; Set A to reset moving direction in [0F].
                            	  3709:     ;
02:00041E90 7000            	  3710:     moveq   #0,D0
                            	  3711:     even
                            	  3712: _L_z05_CheckLadder_DrawLadder:
                            	  3713:     ; Draw the ladder.
                            	  3714:     ;
02:00041E92 1B00            	  3715:     move.b  D0,-(A5)  ; PHA
02:00041E94 7400            	  3716:     moveq   #0,D2
02:00041E96 142C0064        	  3717:     move.b  ($0064,A4),D2
02:00041E9A 4EB90004CE4A    	  3718:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041EA0 760C            	  3719:     moveq   #12,D3
02:00041EA2 7000            	  3720:     moveq   #0,D0
02:00041EA4 4EB900031B48    	  3721:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041EAA 101D            	  3722:     move.b  (A5)+,D0  ; PLA
                            	  3723: ; Params:
                            	  3724: ; A: direction
                            	  3725: ;
                            	  3726: ; Returns:
                            	  3727: ; [0F]: direction
                            	  3728: ;
                            	  3729:     even
