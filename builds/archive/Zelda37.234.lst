                            	  2088: ;==============================================================================
                            	  2089: ; EXPORT side — carry-returning shims.
                            	  2090: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2091: ; reproduces the original function's carry normalization.
                            	  2092: ;==============================================================================
                            	  2093: 
                            	  2094: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2095: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2096:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2097:     btst    #8,D0
02:0002BF8E 670A            	  2098:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2099:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2100:     eori    #$01,CCR
02:0002BF98 4E75            	  2101:     rts
                            	  2102: .cc_cnr:
02:0002BF9A 023C00FE        	  2103:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2104:     eori    #$01,CCR
02:0002BFA2 4E75            	  2105:     rts
                            	  2106: 
                            	  2107: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2108: c_copy_next_row_advance_submode:
