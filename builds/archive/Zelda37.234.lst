02:0003C416 41EC0478        	  6202:     lea     ($0478,A4),A0
02:0003C41A 16302000        	  6203:     move.b  (A0,D2.W),D3
                            	  6204:     ; Change the coordinates to one corner.
                            	  6205:     ;
02:0003C41E 10342070        	  6206:     move.b  ($70,A4,D2.W),D0
