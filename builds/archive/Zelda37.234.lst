                            	  6797: Aquamentus_Draw:
                            	  6798:     ; Every $10 screen frames, switch animation frames.
                            	  6799:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6800:     ; The last tile of frame 0 is at index 5.
                            	  6801:     ; The last tile of frame 1 is at index $B.
                            	  6802:     ;
02:0003C8F4 7605            	  6803:     moveq   #5,D3
02:0003C8F6 102C0015        	  6804:     move.b  ($0015,A4),D0
02:0003C8FA 02000010        	  6805:     andi.b #$10,D0
02:0003C8FE 6602            	  6806:     bne  _anon_z04_88
02:0003C900 760B            	  6807:     moveq   #11,D3
                            	  6808: _anon_z04_88:
