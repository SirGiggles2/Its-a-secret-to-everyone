02:0003C426 41F90003C2DA    	  6208:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C42C 12303000        	  6209:     move.b  (A0,D3.W),D1
02:0003C430 D101            	  6210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C432 19802070        	  6211:     move.b  D0,($70,A4,D2.W)
02:0003C436 41EC0084        	  6212:     lea     ($0084,A4),A0
02:0003C43A 10302000        	  6213:     move.b  (A0,D2.W),D0
02:0003C43E 023C00EE        	  6214:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C442 41F90003C2DE    	  6215:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C448 12303000        	  6216:     move.b  (A0,D3.W),D1
02:0003C44C D101            	  6217:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C44E 41EC0084        	  6218:     lea     ($0084,A4),A0
02:0003C452 11802000        	  6219:     move.b  D0,(A0,D2.W)
                            	  6220:     ; Check the room boundary and object collisions in this temporary location.
                            	  6221:     ;
