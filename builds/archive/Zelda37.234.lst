02:0004C64A 1600            	  5792:     move.b  D0,D3
02:0004C64C 41F90004C302    	  5793:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C652 10303000        	  5794:     move.b  (A0,D3.W),D0
02:0004C656 4EB900030F1C    	  5795:     jsr     SetBoomerangSpeed
02:0004C65C 102C000B        	  5796:     move.b  ($000B,A4),D0
02:0004C660 1940000F        	  5797:     move.b  D0,($000F,A4)
02:0004C664 41EC0098        	  5798:     lea     ($0098,A4),A0
02:0004C668 11802000        	  5799:     move.b  D0,(A0,D2.W)
02:0004C66C 6100F440        	  5800:     jsr     MoveObject
                            	  5801:     even
                            	  5802: AnimateBoomerangAndCheckCollision:
                            	  5803:     ; Decrement animation counter; and when it reaches 0:
                            	  5804:     ; 1. arm it again for 2 frames
                            	  5805:     ; 2. advance the minor state within a cycle of 8
                            	  5806:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5807:     ;
02:0004C670 41EC03D0        	  5808:     lea     ($03D0,A4),A0
02:0004C674 53302000        	  5809:     subq.b  #1,(A0,D2.W)
02:0004C678 6702            	  5810:     beq.s  __far_z_07_0087
02:0004C67A 6036            	  5811:     jmp  DrawBoomerangAndCheckCollision
                            	  5812: __far_z_07_0087:
02:0004C67C 7002            	  5813:     moveq   #2,D0
02:0004C67E 41EC03D0        	  5814:     lea     ($03D0,A4),A0
