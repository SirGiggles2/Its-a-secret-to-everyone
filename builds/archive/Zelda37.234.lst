                            	  8028:     ; If the monster captured Link, then go handle it.
                            	  8029:     ;
02:0003D1C8 41EC042C        	  8030:     lea     ($042C,A4),A0
02:0003D1CC 10302000        	  8031:     move.b  (A0,D2.W),D0
02:0003D1D0 6600009A        	  8032:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003D1D4 103C0080        	  8033:     move.b  #$80,D0
02:0003D1D8 6100C870        	  8034:     jsr     UpdateCommonWanderer
                            	  8035:     ; Like-like has a 4 animation frame cycle unlike most monsters
                            	  8036:     ; which have 2.
                            	  8037:     ;
02:0003D1DC 41EC03D0        	  8038:     lea     ($03D0,A4),A0
02:0003D1E0 53302000        	  8039:     subq.b  #1,(A0,D2.W)
02:0003D1E4 6624            	  8040:     bne  _L_z04_UpdateLikeLike_Draw
02:0003D1E6 7008            	  8041:     moveq   #8,D0
02:0003D1E8 41EC03D0        	  8042:     lea     ($03D0,A4),A0
02:0003D1EC 11802000        	  8043:     move.b  D0,(A0,D2.W)
02:0003D1F0 7600            	  8044:     moveq   #0,D3
02:0003D1F2 41EC03E4        	  8045:     lea     ($03E4,A4),A0
02:0003D1F6 16302000        	  8046:     move.b  (A0,D2.W),D3
02:0003D1FA 5203            	  8047:     addq.b  #1,D3
02:0003D1FC 1003            	  8048:     move.b  D3,D0
02:0003D1FE 02000003        	  8049:     andi.b #$03,D0
02:0003D202 41EC03E4        	  8050:     lea     ($03E4,A4),A0
02:0003D206 11802000        	  8051:     move.b  D0,(A0,D2.W)
                            	  8052:     even
                            	  8053: _L_z04_UpdateLikeLike_Draw:
                            	  8054:     ; Draw.
                            	  8055:     ;
02:0003D20A 4EB90004CE4A    	  8056:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D210 41EC03E4        	  8057:     lea     ($03E4,A4),A0
02:0003D214 10302000        	  8058:     move.b  (A0,D2.W),D0
02:0003D218 4EB900031940    	  8059:     jsr     DrawObjectMirrored
                            	  8060:     ; Check collisions. If Link was not captured, then return.
                            	  8061:     ;
02:0003D21E 4EB900031CC0    	  8062:     jsr     CheckMonsterCollisions
02:0003D224 41EC042C        	  8063:     lea     ($042C,A4),A0
02:0003D228 10302000        	  8064:     move.b  (A0,D2.W),D0
02:0003D22C 673C            	  8065:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8066:     ; The monster captured Link.
                            	  8067:     ; Put the monster at the same location as him.
