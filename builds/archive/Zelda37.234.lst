                            	 13958: TurnTowardsPlayer8:
                            	 13959:     ; Build a direction in [00] towards the player.
                            	 13960:     ;
                            	 13961:     ; First, calculate a horizontal component:
                            	 13962:     ;
                            	 13963:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13964:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13965:     ; else                               [00] := 2 (left)
                            	 13966:     ;
02:0003FD04 7600            	 13967:     moveq   #0,D3
02:0003FD06 1883            	 13968:     move.b  D3,($0000,A4)
02:0003FD08 5203            	 13969:     addq.b  #1,D3
02:0003FD0A 102C0061        	 13970:     move.b  ($0061,A4),D0
02:0003FD0E 12342070        	 13971:     move.b  ($70,A4,D2.W),D1
02:0003FD12 B001            	 13972:     cmp.b   D1,D0
02:0003FD14 6706            	 13973:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003FD16 6402            	 13974:     bcc  _anon_z04_175
02:0003FD18 5203            	 13975:     addq.b  #1,D3
                            	 13976: _anon_z04_175:
02:0003FD1A 1883            	 13977:     move.b  D3,($0000,A4)
                            	 13978:     even
                            	 13979: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13980:     ; Second, calculate a vertical component.
                            	 13981:     ; Combine it with the horizontal component:
                            	 13982:     ;
                            	 13983:     ; Y := 4 (down)
                            	 13984:     ; if observed player Y <> object Y then
                            	 13985:     ;   if observed player Y < object Y then
                            	 13986:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13987:     ;   [00] := [00] | Y
                            	 13988:     ;
02:0003FD1C 7601            	 13989:     moveq   #1,D3
02:0003FD1E 102C0062        	 13990:     move.b  ($0062,A4),D0
02:0003FD22 41EC0084        	 13991:     lea     ($0084,A4),A0
02:0003FD26 12302000        	 13992:     move.b  (A0,D2.W),D1
02:0003FD2A B001            	 13993:     cmp.b   D1,D0
