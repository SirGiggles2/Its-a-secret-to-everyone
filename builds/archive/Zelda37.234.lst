                            	  4979: ; Each byte describes an item. The high nibble is the type.
                            	  4980: ; The low nibble is the value. Its meaning depends on the type.
                            	  4981: ;
                            	  4982: ; 0x - individuals
                            	  4983: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4984: ; * bit mask: value doesn't matter.
                            	  4985: ;
                            	  4986: ; 1x - amounts
                            	  4987: ; Value is an amount to add.
                            	  4988: ;
                            	  4989: ; 2x - grades
                            	  4990: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4991: ;
                            	  4992: ; 3x - error?
                            	  4993: ; Produces an item value of $FF.
                            	  4994: ;
                            	  4995:     even
