                            	  6163: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6164:     ; The routine that returned the door type also returned its
                            	  6165:     ; reverse direction index in [03].
                            	  6166:     ;
                            	  6167:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6168:     ;
