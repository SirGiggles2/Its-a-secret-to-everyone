                            	  5708: DrawObjectMirrored:
02:00031940 7601            	  5709:     moveq   #1,D3
02:00031942 6602            	  5710:     bne  _anon_z01_75
                            	  5711: ; Params:
                            	  5712: ; A: frame image
                            	  5713: ; X: object index
                            	  5714: ; [00]: object X
                            	  5715: ; [01]: object Y
                            	  5716: ; [0F]: flip horizontally
                            	  5717: ;
                            	  5718:     even
                            	  5719: DrawObjectNotMirrored:
02:00031944 7600            	  5720:     moveq   #0,D3
                            	  5721: _anon_z01_75:
02:00031946 1943000C        	  5722:     move.b  D3,($000C,A4)
                            	  5723:     ; Set animation index = object type + 1.
                            	  5724:     ;
02:0003194A 7600            	  5725:     moveq   #0,D3
02:0003194C 41EC034F        	  5726:     lea     ($034F,A4),A0
02:00031950 16302000        	  5727:     move.b  (A0,D2.W),D3
                            	  5728: ; Params:
                            	  5729: ; A: frame
                            	  5730: ; X: object index/cycle sprite index
                            	  5731: ; Y: object type
                            	  5732: ; [00]: object X
                            	  5733: ; [01]: object Y
                            	  5734: ; [0C]: mirrored
                            	  5735: ; [0F]: flip horizontally
                            	  5736: ;
                            	  5737: ; Note:
                            	  5738: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5739: ;
                            	  5740: ; The animation index of most objects is (object type + 1),
                            	  5741: ; to make up for the fact that Link uses two animation indexes.
                            	  5742: ;
                            	  5743:     even
                            	  5744: DrawObjectWithType:
02:00031954 5203            	  5745:     addq.b  #1,D3
                            	  5746: ; Params:
                            	  5747: ; A: frame
                            	  5748: ; X: object index/cycle sprite index
                            	  5749: ; Y: animation index
                            	  5750: ; [00]: object X
                            	  5751: ; [01]: object Y
                            	  5752: ; [0C]: mirrored
                            	  5753: ; [0F]: flip horizontally
                            	  5754: ;
                            	  5755: ; Note:
                            	  5756: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5757: ; But Link uses [0F] for flipping without checking [0C].
                            	  5758: ;
                            	  5759: ;
                            	  5760: ; [0D] holds frame.
                            	  5761:     even
                            	  5762: DrawObjectWithAnim:
02:00031956 1940000D        	  5763:     move.b  D0,($000D,A4)
02:0003195A 1943000E        	  5764:     move.b  D3,($000E,A4)
02:0003195E 19420008        	  5765:     move.b  D2,($0008,A4)
                            	  5766:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5767:     ;
02:00031962 7600            	  5768:     moveq   #0,D3
02:00031964 162C0341        	  5769:     move.b  ($0341,A4),D3
02:00031968 41F90003190C    	  5770:     lea     (SpriteOffsets).l,A0
02:0003196E 10303000        	  5771:     move.b  (A0,D3.W),D0
02:00031972 19400343        	  5772:     move.b  D0,($0343,A4)
02:00031976 41F90003190D    	  5773:     lea     (SpriteOffsets+1).l,A0
02:0003197C 10303000        	  5774:     move.b  (A0,D3.W),D0
                            	  5775:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5776:     ;
02:00031980 4A02            	  5777:     cmpi.b  #$00,D2
02:00031982 6702            	  5778:     beq.s  __far_z_01_0049
02:00031984 6008            	  5779:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  5780: __far_z_01_0049:
02:00031986 7048            	  5781:     moveq   #72,D0
02:00031988 19400343        	  5782:     move.b  D0,($0343,A4)
02:0003198C 704C            	  5783:     moveq   #76,D0
                            	  5784:     even
                            	  5785: DrawObjectWithAnimAndSpecificSprites:
02:0003198E 19400344        	  5786:     move.b  D0,($0344,A4)
02:00031992 7600            	  5787:     moveq   #0,D3
02:00031994 162C000E        	  5788:     move.b  ($000E,A4),D3
02:00031998 7001            	  5789:     moveq   #1,D0
02:0003199A 19400007        	  5790:     move.b  D0,($0007,A4)
02:0003199E 7008            	  5791:     moveq   #8,D0
02:000319A0 1940000A        	  5792:     move.b  D0,($000A,A4)
02:000319A4 41F9000316F4    	  5793:     lea     (ObjAnimations).l,A0
02:000319AA 10303000        	  5794:     move.b  (A0,D3.W),D0
02:000319AE 023C00EE        	  5795:     andi    #$EE,CCR  ; CLC: clear C+X
02:000319B2 122C000D        	  5796:     move.b  ($000D,A4),D1
02:000319B6 D101            	  5797:     addx.b  D1,D0   ; ADC $0D
02:000319B8 7600            	  5798:     moveq   #0,D3
02:000319BA 1600            	  5799:     move.b  D0,D3
02:000319BC 41F900031774    	  5800:     lea     (ObjAnimFrameHeap).l,A0
02:000319C2 10303000        	  5801:     move.b  (A0,D3.W),D0
02:000319C6 19400002        	  5802:     move.b  D0,($0002,A4)
02:000319CA 023C00EE        	  5803:     andi    #$EE,CCR  ; CLC: clear C+X
02:000319CE 123C0002        	  5804:     move.b  #$02,D1
02:000319D2 D101            	  5805:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000319D4 19400003        	  5806:     move.b  D0,($0003,A4)
                            	  5807:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  5808:     ; then go set attributes and write sprites.
                            	  5809:     ;
02:000319D8 4A02            	  5810:     cmpi.b  #$00,D2
02:000319DA 6722            	  5811:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:000319DC 0C02000D        	  5812:     cmpi.b  #$0D,D2
02:000319E0 641C            	  5813:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  5814:     ; If the object has a "half-width draw" attribute, then
                            	  5815:     ; go draw half-width.
                            	  5816:     ;
02:000319E2 41EC04BF        	  5817:     lea     ($04BF,A4),A0
02:000319E6 10302000        	  5818:     move.b  (A0,D2.W),D0
02:000319EA 02000002        	  5819:     andi.b #$02,D0
02:000319EE 6630            	  5820:     bne  _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth
                            	  5821:     ; If the object has the "Ignore sprite attribute table" attribute,
                            	  5822:     ; then don't look up sprite attributes.
                            	  5823:     ;
02:000319F0 41EC04BF        	  5824:     lea     ($04BF,A4),A0
02:000319F4 10302000        	  5825:     move.b  (A0,D2.W),D0
02:000319F8 02000008        	  5826:     andi.b #$08,D0
02:000319FC 660E            	  5827:     bne  _anon_z01_76
                            	  5828:     even
                            	  5829: _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr:
02:000319FE 41F900031840    	  5830:     lea     (ObjAnimAttrHeap).l,A0
02:00031A04 10303000        	  5831:     move.b  (A0,D3.W),D0
02:00031A08 6100022C        	  5832:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5833: _anon_z01_76:
                            	  5834:     ; If it's Link, write the sprites. He's never mirrored.
                            	  5835:     ;
02:00031A0C 4A02            	  5836:     cmpi.b  #$00,D2
02:00031A0E 6602            	  5837:     bne.s  __far_z_01_0050
02:00031A10 6014            	  5838:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  5839: __far_z_01_0050:
                            	  5840:     ; For other objects, the caller controls mirroring and flipping.
                            	  5841:     ;
                            	  5842:     ; If mirrored [0C], then draw it mirrored.
                            	  5843:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  5844:     ;
02:00031A12 7600            	  5845:     moveq   #0,D3
02:00031A14 162C000C        	  5846:     move.b  ($000C,A4),D3
02:00031A18 6602            	  5847:     bne.s  __far_z_01_0051
02:00031A1A 600A            	  5848:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  5849: __far_z_01_0051:
02:00031A1C 600001FE        	  5850:     jmp     Anim_WriteMirroredSpritePair
                            	  5851: 
                            	  5852:     even
                            	  5853: _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth:
02:00031A20 532C0007        	  5854:     subq.b  #1,($0007,A4)
02:00031A24 6034            	  5855:     jmp     Anim_WriteSpritePair
                            	  5856: 
                            	  5857: ; Params:
                            	  5858: ; [00]: Object X
                            	  5859: ; [01]: Object Y
                            	  5860: ; [02]: Left tile
                            	  5861: ; [03]: Right tile
                            	  5862: ; [04]: Left attributes
                            	  5863: ; [05]: Right attributes
                            	  5864: ; [07]: Has two sides
                            	  5865: ; [08]: Cycle sprite index
                            	  5866: ; [0A]: X separation
                            	  5867: ; [0F]: Flip horizontally
                            	  5868: ; [0343]: LeftSpriteOffset
                            	  5869: ; [0344]: RightSpriteOffset
                            	  5870: ;
                            	  5871: ; If [0F] = 0, write the sprite pair with no further processing.
                            	  5872: ;
                            	  5873:     even
