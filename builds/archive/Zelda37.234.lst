02:0003D15C 02000040        	  7973:     andi.b #$40,D0
02:0003D160 123C0030        	  7974:     move.b  #$30,D1
02:0003D164 D101            	  7975:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D166 41EC0394        	  7976:     lea     ($0394,A4),A0
02:0003D16A 11802000        	  7977:     move.b  D0,(A0,D2.W)
                            	  7978:     ; Align the monster with a square horizontally.
                            	  7979:     ;
                            	  7980:     ; If in the left half of a square, align with that square.
                            	  7981:     ; If in the right half, align with the next square.
                            	  7982:     ;
02:0003D16E 10342070        	  7983:     move.b  ($70,A4,D2.W),D0
02:0003D172 023C00EE        	  7984:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D176 123C0008        	  7985:     move.b  #$08,D1
02:0003D17A D101            	  7986:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D17C 020000F0        	  7987:     andi.b #$F0,D0
02:0003D180 19802070        	  7988:     move.b  D0,($70,A4,D2.W)
                            	  7989:     ; Align the monster with a square vertically.
                            	  7990:     ;
                            	  7991:     ; If in the top half of a square, align with that square.
                            	  7992:     ; If in the bottom half, align with the next square.
                            	  7993:     ;
02:0003D184 41EC0084        	  7994:     lea     ($0084,A4),A0
02:0003D188 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003D18C 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D190 123C0008        	  7997:     move.b  #$08,D1
02:0003D194 D101            	  7998:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D196 020000F0        	  7999:     andi.b #$F0,D0
                            	  8000:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8001:     ;
02:0003D19A 003C0011        	  8002:     ori     #$11,CCR  ; SEC: set C+X
02:0003D19E 123C0003        	  8003:     move.b  #$03,D1
02:0003D1A2 0A3C0010        	  8004:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D1A6 9101            	  8005:     subx.b  D1,D0   ; SBC #$03
02:0003D1A8 0A3C0010        	  8006:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D1AC 41EC0084        	  8007:     lea     ($0084,A4),A0
02:0003D1B0 11802000        	  8008:     move.b  D0,(A0,D2.W)
                            	  8009:     even
