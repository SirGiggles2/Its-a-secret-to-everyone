                            	  4505: _L_z01_WieldBomb_FoundSlot:
                            	  4506:     ; We found a slot that's empty or has a fire. It could be $10 or $11.
                            	  4507:     ; If the other slot has a bomb that's not yet detonating (state < $13),
                            	  4508:     ; then return.
                            	  4509:     ;
