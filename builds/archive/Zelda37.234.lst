02:0004C540 11802000        	  5634:     move.b  D0,(A0,D2.W)
                            	  5635:     ; If facing left and X < 2, then go change state to $40. The
                            	  5636:     ; boomerang is too close to the left edge of the screen.
                            	  5637:     ; Another move might make it wrap around.
                            	  5638:     ;
02:0004C544 41EC0098        	  5639:     lea     ($0098,A4),A0
02:0004C548 10302000        	  5640:     move.b  (A0,D2.W),D0
02:0004C54C 1940000F        	  5641:     move.b  D0,($000F,A4)
