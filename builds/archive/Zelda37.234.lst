                            	   763:     even
                            	   764: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   765:     ; Replace the low byte of the VRAM address with the one
                            	   766:     ; where the next character should be written.
                            	   767:     ;
02:0002E5EE 102C045F        	   768:     move.b  ($045F,A4),D0
02:0002E5F2 19400303        	   769:     move.b  D0,($0303,A4)
                            	   770:     ; Increment the low VRAM address for the next character.
                            	   771:     ;
02:0002E5F6 522C045F        	   772:     addq.b  #1,($045F,A4)
                            	   773:     ; Use the person text selector to look up the address of the
                            	   774:     ; text for the textbox. Store the address in [00:01].
                            	   775:     ;
02:0002E5FA 7600            	   776:     moveq   #0,D3
02:0002E5FC 162C0415        	   777:     move.b  ($0415,A4),D3
02:0002E600 41F90002DC36    	   778:     lea     (PersonTextAddrs).l,A0
02:0002E606 10303000        	   779:     move.b  (A0,D3.W),D0
02:0002E60A 1880            	   780:     move.b  D0,($0000,A4)
02:0002E60C 5203            	   781:     addq.b  #1,D3
02:0002E60E 41F90002DC36    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E614 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E618 19400001        	   784:     move.b  D0,($0001,A4)
                            	   785:     ; Load the person text current character index.
                            	   786:     ;
02:0002E61C 7600            	   787:     moveq   #0,D3
02:0002E61E 162C0416        	   788:     move.b  ($0416,A4),D3
                            	   789:     ; Increment the index variable to point to the next character
                            	   790:     ; for next time.
                            	   791:     ;
02:0002E622 522C0416        	   792:     addq.b  #1,($0416,A4)
                            	   793:     ; Get the current character.
                            	   794:     ;
02:0002E626 1214            	   795:     move.b  ($00,A4),D1   ; ptr lo
02:0002E628 182C0001        	   796:     move.b  ($01,A4),D4  ; ptr hi
02:0002E62C 024100FF        	   797:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E630 E14C            	   798:     lsl.w   #8,D4
02:0002E632 8841            	   799:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E634 48C4            	   800:     ext.l   D4
02:0002E636 D8BC00FF0000    	   801:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E63C 2044            	   802:     movea.l D4,A0
02:0002E63E 10303000        	   803:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   804:     ; If the character is $25, then it's a special space. It will still
                            	   805:     ; take up space, but will not take time to show -- meaning that
                            	   806:     ; we'll go look up the next character to transfer.
                            	   807:     ;
02:0002E642 0200003F        	   808:     andi.b #$3F,D0
02:0002E646 0C000025        	   809:     cmpi.b  #$25,D0
02:0002E64A 67A2            	   810:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   811:     ; We have a non-space character. Put it in the transfer record.
                            	   812:     ;
02:0002E64C 19400305        	   813:     move.b  D0,($0305,A4)
                            	   814:     ; Play the "heart taken/character" sound effect.
                            	   815:     ;
02:0002E650 7010            	   816:     moveq   #16,D0
02:0002E652 19400604        	   817:     move.b  D0,($0604,A4)
                            	   818:     ; If the high 2 bits of character element = 0, then return.
                            	   819:     ;
02:0002E656 1214            	   820:     move.b  ($00,A4),D1   ; ptr lo
02:0002E658 182C0001        	   821:     move.b  ($01,A4),D4  ; ptr hi
02:0002E65C 024100FF        	   822:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E660 E14C            	   823:     lsl.w   #8,D4
02:0002E662 8841            	   824:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E664 48C4            	   825:     ext.l   D4
02:0002E666 D8BC00FF0000    	   826:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E66C 2044            	   827:     movea.l D4,A0
02:0002E66E 10303000        	   828:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E672 020000C0        	   829:     andi.b #$C0,D0
02:0002E676 672E            	   830:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   831:     ; Determine an index based on the high 2 bits of the character element:
                            	   832:     ;   $80: 0
                            	   833:     ;   $40: 1
                            	   834:     ;   $C0: 2
                            	   835:     ;
02:0002E678 7602            	   836:     moveq   #2,D3
02:0002E67A 0C0000C0        	   837:     cmpi.b  #$C0,D0
02:0002E67E 670A            	   838:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E680 5303            	   839:     subq.b  #1,D3
02:0002E682 0C000040        	   840:     cmpi.b  #$40,D0
02:0002E686 6702            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E688 5303            	   842:     subq.b  #1,D3
                            	   843:     even
                            	   844: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   845:     ; The index chooses the low VRAM address of the start
                            	   846:     ; of another line:
                            	   847:     ;   0: $C4: front of the second line
                            	   848:     ;   1: $E4: front of the third line
                            	   849:     ;   2: $A4: front of the first line
                            	   850:     ;
                            	   851:     ; Look up the low VRAM address and store it.
                            	   852:     ;
02:0002E68A 41F90002E5B8    	   853:     lea     (TextboxLineAddrsLo).l,A0
02:0002E690 10303000        	   854:     move.b  (A0,D3.W),D0
02:0002E694 1940045F        	   855:     move.b  D0,($045F,A4)
                            	   856:     ; If index = 2, then we've reached the end of the text,
                            	   857:     ; and low VRAM address is moved to the front of the first line.
                            	   858:     ; So, advance the state of the person object, and unhalt Link.
                            	   859:     ;
02:0002E698 0C030002        	   860:     cmpi.b  #$02,D3
02:0002E69C 6608            	   861:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E69E 522C00AD        	   862:     addq.b  #1,($00AD,A4)
02:0002E6A2 6100FB98        	   863:     jsr     UnhaltLink
                            	   864:     even
                            	   865: _L_z01_UpdatePersonState_Textbox_Exit:
02:0002E6A6 4E75            	   866:     rts
                            	   867: 
                            	   868:     even
