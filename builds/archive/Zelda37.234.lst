                            	  2903: InitTrap_Full:
                            	  2904:     ; Copy this parent/generator object's attributes to [01].
                            	  2905:     ;
02:000304FE 41EC04BF        	  2906:     lea     ($04BF,A4),A0
02:00030502 10302000        	  2907:     move.b  (A0,D2.W),D0
02:00030506 19400001        	  2908:     move.b  D0,($0001,A4)
                            	  2909:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2910:     ;
02:0003050A 7605            	  2911:     moveq   #5,D3
                            	  2912:     ; The individual trap objects to make will be of type $49.
                            	  2913:     ; Store it in [00].
                            	  2914:     ;
02:0003050C 7049            	  2915:     moveq   #73,D0
02:0003050E 1880            	  2916:     move.b  D0,($0000,A4)
                            	  2917:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  2918:     ; then we'll make 4 traps.
                            	  2919:     ;
02:00030510 41EC034F        	  2920:     lea     ($034F,A4),A0
02:00030514 12302000        	  2921:     move.b  (A0,D2.W),D1
02:00030518 B001            	  2922:     cmp.b   D1,D0
02:0003051A 6702            	  2923:     beq  _L_z01_InitTrap_Full_LoopTrap
02:0003051C 7603            	  2924:     moveq   #3,D3
                            	  2925:     even
                            	  2926: _L_z01_InitTrap_Full_LoopTrap:
                            	  2927:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  2928:     ;
