                            	  7363: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7364:     ; Else Link is facing horizontally.
                            	  7365:     ; [04] := (weapon X + 8)
                            	  7366:     ; A    := (weapon Y + 6)
                            	  7367:     ;
                            	  7368:     ; Shouldn't it be based on the weapon's direction?
                            	  7369:     ;
02:0003246A 10343070        	  7370:     move.b  ($70,A4,D3.W),D0
02:0003246E 023C00EE        	  7371:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032472 123C0008        	  7372:     move.b  #$08,D1
02:00032476 D101            	  7373:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00032478 19400004        	  7374:     move.b  D0,($0004,A4)
02:0003247C 41EC0084        	  7375:     lea     ($0084,A4),A0
02:00032480 10303000        	  7376:     move.b  (A0,D3.W),D0
02:00032484 023C00EE        	  7377:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032488 123C0006        	  7378:     move.b  #$06,D1
02:0003248C D101            	  7379:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7380: _anon_z01_98:
                            	  7381:     ; The A register will be copied to [05] and used here.
                            	  7382:     ;
02:0003248E 6000FC0C        	  7383:     jmp     CheckMonsterWeaponCollision
                            	  7384: 
                            	  7385: ; Params:
                            	  7386: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7387: ; [00]: weapon object slot (unused)
                            	  7388: ; [02]: object 1 mid X
                            	  7389: ; [03]: object 1 mid Y
                            	  7390: ; [04]: object 2 mid X
                            	  7391: ; [05]: object 2 mid Y
                            	  7392: ;
                            	  7393: ; Returns:
                            	  7394: ; A: 1 if objects collide
                            	  7395: ; Y: weapon object slot
                            	  7396: ; Z: 0 if objects collide
                            	  7397: ; [06]: 1 if objects collide
                            	  7398: ; [0A]: horizontal distance
                            	  7399: ; [0B]: vertical distance
                            	  7400: ;
                            	  7401: ;
                            	  7402: ; Use the same threshold value horizontally and vertically.
                            	  7403: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7404: ;
                            	  7405:     even
                            	  7406: DoObjectsCollide:
02:00032492 1940000D        	  7407:     move.b  D0,($000D,A4)
02:00032496 1940000E        	  7408:     move.b  D0,($000E,A4)
                            	  7409: ; Params:
                            	  7410: ; [00]: weapon or Link object slot (unused)
                            	  7411: ; [02]: object 1 mid X
                            	  7412: ; [03]: object 1 mid Y
                            	  7413: ; [04]: object 2 mid X
                            	  7414: ; [05]: object 2 mid Y
                            	  7415: ; [0D]: horizontal threshold
                            	  7416: ; [0E]: vertical threshold
                            	  7417: ;
                            	  7418: ; Returns:
                            	  7419: ; A: 1 if objects collide
                            	  7420: ; Y: weapon or Link object slot (copied from [00])
                            	  7421: ; Z: 0 if objects collide
                            	  7422: ; [06]: 1 if objects collide
                            	  7423: ; [0A]: horizontal distance
                            	  7424: ; [0B]: vertical distance
                            	  7425: ;
                            	  7426: ;
                            	  7427: ; Reset [06] to indicate no collision by default.
                            	  7428: ;
                            	  7429:     even
                            	  7430: DoObjectsCollideWithThresholds:
02:0003249A 60009C24        	  7431:     jmp     c_do_objects_collide_with_thresholds
                            	  7432: 
                            	  7433: BeginShove:
02:0003249E 7600            	  7434:     moveq   #0,D3
02:000324A0 1614            	  7435:     move.b  ($0000,A4),D3
02:000324A2 0C02000D        	  7436:     cmpi.b  #$0D,D2
02:000324A6 6412            	  7437:     bcc  _anon_z01_99
02:000324A8 41EC04B2        	  7438:     lea     ($04B2,A4),A0
02:000324AC 10302000        	  7439:     move.b  (A0,D2.W),D0
02:000324B0 122C0009        	  7440:     move.b  ($0009,A4),D1
02:000324B4 C001            	  7441:     and.b  D1,D0
02:000324B6 660000C4        	  7442:     bne  _L_z01_BeginShove_Exit
                            	  7443: _anon_z01_99:
                            	  7444:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7445:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7446:     ;
                            	  7447:     ; If instead a monster is defending, then all this calculation
                            	  7448:     ; won't matter, because the shove direction will be set to the
                            	  7449:     ; weapon's direction.
                            	  7450:     ;
                            	  7451:     ; As such, calculate a direction from the monster to the defender,
                            	  7452:     ; assuming it's Link.
                            	  7453:     ;
                            	  7454:     ; Start with an assumption that the direction is vertical:
                            	  7455:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7456:     ;
02:000324BA 7008            	  7457:     moveq   #8,D0
02:000324BC 19400008        	  7458:     move.b  D0,($0008,A4)
02:000324C0 41EC0084        	  7459:     lea     ($0084,A4),A0
02:000324C4 10302000        	  7460:     move.b  (A0,D2.W),D0
02:000324C8 19400004        	  7461:     move.b  D0,($0004,A4)
02:000324CC 41EC0084        	  7462:     lea     ($0084,A4),A0
02:000324D0 10303000        	  7463:     move.b  (A0,D3.W),D0
02:000324D4 19400005        	  7464:     move.b  D0,($0005,A4)
                            	  7465:     ; If the defender is Link and his grid offset <> 0 then
                            	  7466:     ; use his usual object direction variable to determine
                            	  7467:     ; which axis to check.
                            	  7468:     ;
02:000324D8 4A03            	  7469:     cmpi.b  #$00,D3
02:000324DA 6612            	  7470:     bne  _anon_z01_100
02:000324DC 102C0394        	  7471:     move.b  ($0394,A4),D0
02:000324E0 670C            	  7472:     beq  _anon_z01_100
02:000324E2 102C0098        	  7473:     move.b  ($0098,A4),D0
02:000324E6 02000003        	  7474:     andi.b #$03,D0
02:000324EA 660C            	  7475:     bne  _L_z01_BeginShove_CheckHorizontal
02:000324EC 6720            	  7476:     beq  _L_z01_BeginShove_CheckVertical
                            	  7477: _anon_z01_100:
                            	  7478:     ; For monsters defending, or Link with grid offset = 0,
                            	  7479:     ; check direction in [0B].
                            	  7480:     ;
                            	  7481:     ; For monsters defending, this won't matter. For Link with grid
                            	  7482:     ; offset = 0, I believe the result will be arbitrary.
                            	  7483:     ;
                            	  7484:     ; TODO:
                            	  7485:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7486:     ; It doesn't seem to be if candle fire attacks him.
                            	  7487:     ;
02:000324EE 102C000B        	  7488:     move.b  ($000B,A4),D0
02:000324F2 0C000004        	  7489:     cmpi.b  #$04,D0
02:000324F6 6416            	  7490:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7491:     even
                            	  7492: _L_z01_BeginShove_CheckHorizontal:
                            	  7493:     ; If the direction checked is left or right,
                            	  7494:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7495:     ;
02:000324F8 7002            	  7496:     moveq   #2,D0
02:000324FA 19400008        	  7497:     move.b  D0,($0008,A4)
02:000324FE 10342070        	  7498:     move.b  ($70,A4,D2.W),D0
02:00032502 19400004        	  7499:     move.b  D0,($0004,A4)
02:00032506 10343070        	  7500:     move.b  ($70,A4,D3.W),D0
02:0003250A 19400005        	  7501:     move.b  D0,($0005,A4)
                            	  7502:     even
                            	  7503: _L_z01_BeginShove_CheckVertical:
                            	  7504:     ; If the monster is down or right of the other object,
                            	  7505:     ; then use the opposite direction already in [08].
                            	  7506:     ; Else shift [08] right to turn it into the opposite
                            	  7507:     ; direction up or down.
                            	  7508:     ;
                            	  7509:     ; Again assuming Link is the defender; after this, [08] points
                            	  7510:     ; Link away from the monster.
                            	  7511:     ;
02:0003250E 102C0004        	  7512:     move.b  ($0004,A4),D0
02:00032512 122C0005        	  7513:     move.b  ($0005,A4),D1
02:00032516 B001            	  7514:     cmp.b   D1,D0
02:00032518 640A            	  7515:     bcc  _anon_z01_101
02:0003251A 122C0008        	  7516:     move.b  ($0008,A4),D1
02:0003251E E209            	  7517:     lsr.b  #1,D1   ; LSR $08
02:00032520 19410008        	  7518:     move.b  D1,($0008,A4)
                            	  7519: _anon_z01_101:
                            	  7520:     ; If a monster is the defender, go handle it separately.
                            	  7521:     ;
02:00032524 4A03            	  7522:     cmpi.b  #$00,D3
02:00032526 6656            	  7523:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7524:     ; Link is the defender.
                            	  7525:     ;
                            	  7526:     ; If Link is invincible, return without shoving.
                            	  7527:     ;
02:00032528 102C04F0        	  7528:     move.b  ($04F0,A4),D0
02:0003252C 664E            	  7529:     bne  _L_z01_BeginShove_Exit
                            	  7530:     ; Store the shove direction we determined.
                            	  7531:     ;
                            	  7532:     ; Turn on the high bit to indicate that the next time we try to
                            	  7533:     ; move by shoving, it will be the first time for this shove action.
                            	  7534:     ;
02:0003252E 102C0008        	  7535:     move.b  ($0008,A4),D0
02:00032532 00000080        	  7536:     ori.b #$80,D0
02:00032536 194000C0        	  7537:     move.b  D0,($00C0,A4)
                            	  7538:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7539:     ;
02:0003253A 7018            	  7540:     moveq   #24,D0
02:0003253C 194004F0        	  7541:     move.b  D0,($04F0,A4)
02:00032540 7020            	  7542:     moveq   #32,D0
02:00032542 194000D3        	  7543:     move.b  D0,($00D3,A4)
                            	  7544:     ; If Link was shoved by one of his own weapons, then
                            	  7545:     ; nothing else to do. Return.
                            	  7546:     ;
02:00032546 0C02000D        	  7547:     cmpi.b  #$0D,D2
02:0003254A 6430            	  7548:     bcc  _L_z01_BeginShove_Exit
                            	  7549:     ; Link was shoved by a monster.
                            	  7550:     ;
