02:0003AB62 41F90003AA8C    	  2745:     lea     (JumperStartSpeedsHi).l,A0
02:0003AB68 10303000        	  2746:     move.b  (A0,D3.W),D0
02:0003AB6C 41EC0412        	  2747:     lea     ($0412,A4),A0
02:0003AB70 11802000        	  2748:     move.b  D0,(A0,D2.W)
                            	  2749:     ; Reset the vertical speed low byte.
