                            	  7037:     ; Increment the number of bomb hits.
                            	  7038:     ;
02:0003CAC0 41EC0437        	  7039:     lea     ($0437,A4),A0
02:0003CAC4 10302000        	  7040:     move.b  (A0,D2.W),D0
02:0003CAC8 023C00EE        	  7041:     andi    #$EE,CCR  ; CLC: clear C+X
