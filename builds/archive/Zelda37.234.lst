                            	  8214:     ;
02:0003D35C 102C066C        	  8215:     move.b  ($066C,A4),D0
02:0003D360 1234203D        	  8216:     move.b  ($3D,A4,D2.W),D1
02:0003D364 8001            	  8217:     or.b  D1,D0
