02:00034F2E 41F9000348F0    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034F34 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00034F38 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00034F3C 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00034F40 5302            	  2563:     subq.b  #1,D2
02:00034F42 5303            	  2564:     subq.b  #1,D3
02:00034F44 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034F46 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00034F4A 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00034F4E 020000C0        	  2577:     andi.b #$C0,D0
02:00034F52 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00034F56 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034F5A 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:00034F5E 7620            	  2586:     moveq   #32,D3
02:00034F60 19430604        	  2587:     move.b  D3,($0604,A4)
02:00034F64 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
