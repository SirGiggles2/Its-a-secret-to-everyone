02:0003B3B8 41EC0492        	  3913:     lea     ($0492,A4),A0
02:0003B3BC 10302000        	  3914:     move.b  (A0,D2.W),D0
02:0003B3C0 66EC            	  3915:     bne  _anon_z04_53
02:0003B3C2 4EB90004D64C    	  3916:     jsr     ResetObjMetastateAndTimer
02:0003B3C8 6000F45A        	  3917:     jmp     EndInitFlyer
