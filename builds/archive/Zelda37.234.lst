02:0002E3C8 0C000004        	   458:     cmpi.b  #$04,D0
02:0002E3CC 660A            	   459:     bne  _anon_z01_2
02:0002E3CE 102C0015        	   460:     move.b  ($0015,A4),D0
02:0002E3D2 02000001        	   461:     andi.b #$01,D0
02:0002E3D6 6652            	   462:     bne  _L_z01_UpdateCavePerson_UpdateCavePersonDirect
                            	   463: _anon_z01_2:
