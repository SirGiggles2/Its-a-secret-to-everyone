02:0003384C 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:00033850 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033854 E14C            	   587:     lsl.w   #8,D4
02:00033856 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033858 48C4            	   589:     ext.l   D4
02:0003385A D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033860 2044            	   591:     movea.l D4,A0
02:00033862 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033866 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00033868 1002            	   594:     move.b  D2,D0
02:0003386A E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:0003386C 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:0003386E 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:00033870 020000F0        	   602:     andi.b #$F0,D0
02:00033874 1940000C        	   603:     move.b  D0,($000C,A4)
02:00033878 E208            	   604:     lsr.b  #1,D0   ; LSR A
02:0003387A E208            	   605:     lsr.b  #1,D0   ; LSR A
02:0003387C E208            	   606:     lsr.b  #1,D0   ; LSR A
02:0003387E E208            	   607:     lsr.b  #1,D0   ; LSR A
02:00033880 122C000C        	   608:     move.b  ($000C,A4),D1
02:00033884 8001            	   609:     or.b  D1,D0
02:00033886 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
02:00033888 101D            	   613:     move.b  (A5)+,D0  ; PLA
02:0003388A 41EC0650        	   614:     lea     ($0650,A4),A0
02:0003388E 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033892 5203            	   618:     addq.b  #1,D3
02:00033894 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:00033896 0C020006        	   622:     cmpi.b  #$06,D2
02:0003389A 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:0003389C 1002            	   624:     move.b  D2,D0
02:0003389E E208            	   625:     lsr.b  #1,D0   ; LSR A
02:000338A0 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
02:000338A2 1003            	   629:     move.b  D3,D0
02:000338A4 123C0026        	   630:     move.b  #$26,D1
02:000338A8 D101            	   631:     addx.b  D1,D0   ; ADC #$26 (X flag = 6502 C)
02:000338AA 7600            	   632:     moveq   #0,D3
02:000338AC 1600            	   633:     move.b  D0,D3
