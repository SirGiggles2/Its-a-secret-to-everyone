02:0003D326 1600            	  8189:     move.b  D0,D3
02:0003D328 5303            	  8190:     subq.b  #1,D3
02:0003D32A 6AE2            	  8191:     bpl  _L_z04_UpdateVire_LoopMakeKeese
02:0003D32C 4E75            	  8192:     rts
