                            	  4389:     ; TODO: call it speed index or angle?
                            	  4390:     ; If the difference in distances is within 8 pixels,
                            	  4391:     ; return the speed index (angle) we have.
                            	  4392:     ;
02:00030EC2 102C0003        	  4393:     move.b  ($0003,A4),D0
02:00030EC6 003C0011        	  4394:     ori     #$11,CCR  ; SEC: set C+X
02:00030ECA 122C0004        	  4395:     move.b  ($0004,A4),D1
02:00030ECE 0A3C0010        	  4396:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030ED2 9101            	  4397:     subx.b  D1,D0   ; SBC $04
02:00030ED4 0A3C0010        	  4398:     eori    #$10,CCR  ; restore X = 6502 C
02:00030ED8 0C000008        	  4399:     cmpi.b  #$08,D0
02:00030EDC 6538            	  4400:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4401:     even
                            	  4402: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4403:     ; TODO: call it speed index or angle?
                            	  4404:     ; Otherwise, go to the next speed index (angle).
                            	  4405:     ;
02:00030EDE 1014            	  4406:     move.b  ($0000,A4),D0
02:00030EE0 023C00EE        	  4407:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EE4 122C0001        	  4408:     move.b  ($0001,A4),D1
02:00030EE8 D101            	  4409:     addx.b  D1,D0   ; ADC $01
02:00030EEA 1880            	  4410:     move.b  D0,($0000,A4)
                            	  4411:     ; TODO: call it speed index or angle?
                            	  4412:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4413:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4414:     ;
02:00030EEC 6728            	  4415:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030EEE 0C000008        	  4416:     cmpi.b  #$08,D0
02:00030EF2 6722            	  4417:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4418:     ; Subtract the lesser distance from the greater distance.
                            	  4419:     ; If they still haven't crossed, then we can turn more.
                            	  4420:     ;
02:00030EF4 102C0003        	  4421:     move.b  ($0003,A4),D0
02:00030EF8 003C0011        	  4422:     ori     #$11,CCR  ; SEC: set C+X
02:00030EFC 122C0004        	  4423:     move.b  ($0004,A4),D1
02:00030F00 0A3C0010        	  4424:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030F04 9101            	  4425:     subx.b  D1,D0   ; SBC $04
02:00030F06 0A3C0010        	  4426:     eori    #$10,CCR  ; restore X = 6502 C
02:00030F0A 19400003        	  4427:     move.b  D0,($0003,A4)
02:00030F0E 122C0004        	  4428:     move.b  ($0004,A4),D1
02:00030F12 B001            	  4429:     cmp.b   D1,D0
02:00030F14 64C8            	  4430:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4431:     even
