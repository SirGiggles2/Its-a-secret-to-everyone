02:00034FF2 102C0070        	  2653:     move.b  ($0070,A4),D0
02:00034FF6 0C0000B0        	  2654:     cmpi.b  #$B0,D0
02:00034FFA 6640            	  2655:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034FFC 7070            	  2656:     moveq   #112,D0
02:00034FFE 19400070        	  2657:     move.b  D0,($0070,A4)
