                            	  4476: WieldBomb:
                            	  4477:     ; If there are no bombs in inventory, return.
                            	  4478:     ;
02:00030F66 102C0658        	  4479:     move.b  ($0658,A4),D0
02:00030F6A 67F4            	  4480:     beq  _anon_z01_52
                            	  4481:     ; Look in slot $10. If it's empty or there's a fire
                            	  4482:     ; (state = 0, or major state <> $10), then
                            	  4483:     ; go activate a bomb.
                            	  4484:     ;
02:00030F6C 7410            	  4485:     moveq   #16,D2
02:00030F6E 41EC00AC        	  4486:     lea     ($00AC,A4),A0
02:00030F72 10302000        	  4487:     move.b  (A0,D2.W),D0
02:00030F76 6724            	  4488:     beq  _L_z01_WieldBomb_FoundSlot
02:00030F78 020000F0        	  4489:     andi.b #$F0,D0
02:00030F7C 0C000010        	  4490:     cmpi.b  #$10,D0
02:00030F80 661A            	  4491:     bne  _L_z01_WieldBomb_FoundSlot
                            	  4492:     ; Else look at slot $11.
                            	  4493:     ; If there's a bomb there (major state = $10), then return.
                            	  4494:     ;
02:00030F82 5202            	  4495:     addq.b  #1,D2
02:00030F84 41EC00AC        	  4496:     lea     ($00AC,A4),A0
02:00030F88 10302000        	  4497:     move.b  (A0,D2.W),D0
02:00030F8C 670E            	  4498:     beq  _L_z01_WieldBomb_FoundSlot
02:00030F8E 020000F0        	  4499:     andi.b #$F0,D0
02:00030F92 0C000010        	  4500:     cmpi.b  #$10,D0
02:00030F96 6604            	  4501:     bne.s  __far_z_01_0027
02:00030F98 60000080        	  4502:     jmp  L69AB_Exit
                            	  4503: __far_z_01_0027:
