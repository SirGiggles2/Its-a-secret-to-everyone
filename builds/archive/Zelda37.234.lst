                            	  9687: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9688:     ; To the frame accumulator, add:
                            	  9689:     ; - a random value between 0 and 3
                            	  9690:     ; - [03] the effective high speed byte calculated for this screen frame
