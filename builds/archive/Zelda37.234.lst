                            	  5506: __far_z_07_0084:
                            	  5507:     ; State $2x. Spark.
                            	  5508:     ;
                            	  5509:     ; Change the state to $28, and decrement animation counter.
                            	  5510:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5511:     ; (with Link, if this is a monster's boomerang).
                            	  5512:     ;
                            	  5513:     ; TODO: Why state $28?
                            	  5514:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5515:     ; start over again when spinning.
                            	  5516:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5517:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5518:     ; any drawing code depends on the minor state.
                            	  5519:     ;
02:0004C476 7028            	  5520:     moveq   #40,D0
02:0004C478 41EC00AC        	  5521:     lea     ($00AC,A4),A0
02:0004C47C 11802000        	  5522:     move.b  D0,(A0,D2.W)
02:0004C480 41EC03D0        	  5523:     lea     ($03D0,A4),A0
02:0004C484 53302000        	  5524:     subq.b  #1,(A0,D2.W)
02:0004C488 6702            	  5525:     beq.s  __far_z_07_0085
02:0004C48A 6060            	  5526:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5527: __far_z_07_0085:
                            	  5528:     ; Animation counter = 0.
                            	  5529:     ;
                            	  5530:     ; Set state to $40. It will become $50 below in
                            	  5531:     ; HandleArrowOrBoomerangBlocked.
                            	  5532:     ;
02:0004C48C 7040            	  5533:     moveq   #64,D0
02:0004C48E 41EC00AC        	  5534:     lea     ($00AC,A4),A0
02:0004C492 11802000        	  5535:     move.b  D0,(A0,D2.W)
                            	  5536:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5537:     ; Else go handle the boomerang being blocked.
                            	  5538:     ;
02:0004C496 0C02000D        	  5539:     cmpi.b  #$0D,D2
02:0004C49A 640E            	  5540:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C49C 41EC034F        	  5541:     lea     ($034F,A4),A0
02:0004C4A0 10302000        	  5542:     move.b  (A0,D2.W),D0
02:0004C4A4 0C00005B        	  5543:     cmpi.b  #$5B,D0
02:0004C4A8 6708            	  5544:     beq  _L_z07_CheckState20_Deactivate
                            	  5545:     even
                            	  5546: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004C4AA 0C020012        	  5547:     cmpi.b  #$12,D2
