02:00044DFC 162C0070        	  8200:     move.b  ($0070,A4),D3
02:00044E00 0C030020        	  8201:     cmpi.b  #$20,D3
02:00044E04 6706            	  8202:     beq  _anon_z05_175
02:00044E06 0C0300D0        	  8203:     cmpi.b  #$D0,D3
02:00044E0A 661C            	  8204:     bne  _anon_z05_176
