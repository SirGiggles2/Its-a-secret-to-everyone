02:0003C468 41EC0478        	  6228:     lea     ($0478,A4),A0
02:0003C46C 10302000        	  6229:     move.b  (A0,D2.W),D0
02:0003C470 0C000004        	  6230:     cmpi.b  #$04,D0
02:0003C474 659E            	  6231:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
