                            	  7184: Dodongo_CheckBombHit:
                            	  7185:     ; If state <> 0 (not moving), then return.
                            	  7186:     ;
02:0003CBCC 41EC00AC        	  7187:     lea     ($00AC,A4),A0
02:0003CBD0 10302000        	  7188:     move.b  (A0,D2.W),D0
02:0003CBD4 66000086        	  7189:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7190:     ; If facing vertically, then store (X + 8) in [00].
                            	  7191:     ; Else store (X + $10).
                            	  7192:     ;
02:0003CBD8 10342070        	  7193:     move.b  ($70,A4,D2.W),D0
02:0003CBDC 023C00EE        	  7194:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBE0 123C0008        	  7195:     move.b  #$08,D1
02:0003CBE4 D101            	  7196:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CBE6 7600            	  7197:     moveq   #0,D3
02:0003CBE8 41EC0098        	  7198:     lea     ($0098,A4),A0
02:0003CBEC 16302000        	  7199:     move.b  (A0,D2.W),D3
