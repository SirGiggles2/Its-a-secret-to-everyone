                            	  9938:     even
                            	  9939: _L_z04_UpdateGohma_AnimateAndCheckCollisions:
                            	  9940:     ; Pass the frame image for the eye.
                            	  9941:     ;
02:0003E026 41EC046B        	  9942:     lea     ($046B,A4),A0
02:0003E02A 10302000        	  9943:     move.b  (A0,D2.W),D0
02:0003E02E 6138            	  9944:     jsr     Gohma_AnimateAndDraw
02:0003E030 600000AA        	  9945:     jmp     Gohma_CheckCollisions
                            	  9946: 
                            	  9947:     even
                            	  9948: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9949:     ; Here the eye is closed. So animate it this way.
                            	  9950:     ; Increment the animation counter, and if <> 8, then
                            	  9951:     ; go shoot, draw, and check collisions.
                            	  9952:     ;
02:0003E034 41EC0478        	  9953:     lea     ($0478,A4),A0
02:0003E038 52302000        	  9954:     addq.b  #1,(A0,D2.W)
02:0003E03C 41EC0478        	  9955:     lea     ($0478,A4),A0
02:0003E040 10302000        	  9956:     move.b  (A0,D2.W),D0
02:0003E044 0C000008        	  9957:     cmpi.b  #$08,D0
02:0003E048 66C2            	  9958:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9959:     ; Roll over the eye animation counter to 0.
                            	  9960:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9961:     ;
02:0003E04A 7000            	  9962:     moveq   #0,D0
02:0003E04C 41EC0478        	  9963:     lea     ($0478,A4),A0
