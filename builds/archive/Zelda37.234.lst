                            	  6480: __far_z_01_0064:
                            	  6481:     ; If Link and the shot are not facing opposite directions,
                            	  6482:     ; then go harm Link.
                            	  6483:     ;
                            	  6484:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6485:     ; component of a monster that can move diagonally.
                            	  6486:     ;
