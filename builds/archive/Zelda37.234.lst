02:0003BC02 194000AC        	  5081:     move.b  D0,($00AC,A4)
02:0003BC06 19400011        	  5082:     move.b  D0,($0011,A4)
02:0003BC0A 19400013        	  5083:     move.b  D0,($0013,A4)
                            	  5084:     even
