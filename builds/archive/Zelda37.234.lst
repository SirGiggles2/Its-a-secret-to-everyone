02:0003B1D8 41EC03E4        	  3603:     lea     ($03E4,A4),A0
02:0003B1DC 12302000        	  3604:     move.b  (A0,D2.W),D1
02:0003B1E0 B300            	  3605:     eor.b  D1,D0
02:0003B1E2 41EC03E4        	  3606:     lea     ($03E4,A4),A0
02:0003B1E6 11802000        	  3607:     move.b  D0,(A0,D2.W)
                            	  3608:     even
