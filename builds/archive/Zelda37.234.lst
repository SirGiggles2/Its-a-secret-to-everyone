02:0003C24C 10342028        	  5910:     move.b  ($28,A4,D2.W),D0
02:0003C250 0C000010        	  5911:     cmpi.b  #$10,D0
02:0003C254 6702            	  5912:     beq.s  __far_z_04_0045
02:0003C256 6058            	  5913:     jmp  L1156B_Exit
