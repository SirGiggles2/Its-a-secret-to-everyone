02:0003D370 02000003        	  8223:     andi.b #$03,D0
02:0003D374 6732            	  8224:     beq  _L_z04_UpdateVireState0_Exit
                            	  8225:     ; Get the absolute value of the grid offset (0 to $F);
                            	  8226:     ; so it becomes an index into the jump offset array.
