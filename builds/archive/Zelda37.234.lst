                            	  5876: __far_z_05_0082:
                            	  5877:     ; Turn the door command into the desired open or closed state
                            	  5878:     ; to store in [08].
                            	  5879:     ;
                            	  5880:     ; cmd:  7 6 3 2 
                            	  5881:     ; [08]: 2 0 0 0
                            	  5882:     ;
                            	  5883:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5884:     ; commands intended to be used.
                            	  5885:     ;
                            	  5886:     ; 3 is the end state of 2: close
                            	  5887:     ; 7 is the end state of 6: open
                            	  5888:     ;
02:0004389E 02000007        	  5889:     andi.b #$07,D0
02:000438A2 7601            	  5890:     moveq   #1,D3
02:000438A4 19430002        	  5891:     move.b  D3,($0002,A4)
02:000438A8 122C0002        	  5892:     move.b  ($0002,A4),D1
02:000438AC C200            	  5893:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000438AE 6702            	  5894:     beq  _anon_z05_118
02:000438B0 E208            	  5895:     lsr.b  #1,D0   ; LSR A
                            	  5896: _anon_z05_118:
02:000438B2 0C000002        	  5897:     cmpi.b  #$02,D0
02:000438B6 6606            	  5898:     bne  _anon_z05_119
                            	  5899:     ; Command 2 sets Link's timer to $30.
                            	  5900:     ;
02:000438B8 7630            	  5901:     moveq   #48,D3
02:000438BA 19430028        	  5902:     move.b  D3,($0028,A4)
                            	  5903: _anon_z05_119:
02:000438BE 02000003        	  5904:     andi.b #$03,D0
02:000438C2 003C0011        	  5905:     ori     #$11,CCR  ; SEC: set C+X
02:000438C6 123C0001        	  5906:     move.b  #$01,D1
02:000438CA 0A3C0010        	  5907:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000438CE 9101            	  5908:     subx.b  D1,D0   ; SBC #$01
02:000438D0 0A3C0010        	  5909:     eori    #$10,CCR  ; restore X = 6502 C
02:000438D4 02000002        	  5910:     andi.b #$02,D0
02:000438D8 19400008        	  5911:     move.b  D0,($0008,A4)
                            	  5912:     ; The command to close a key door or bombable wall does not
                            	  5913:     ; do anything.
                            	  5914:     ;
02:000438DC 102C0054        	  5915:     move.b  ($0054,A4),D0
02:000438E0 0C000005        	  5916:     cmpi.b  #$05,D0
02:000438E4 6416            	  5917:     bcc  _anon_z05_120
02:000438E6 102C0055        	  5918:     move.b  ($0055,A4),D0
02:000438EA 19400002        	  5919:     move.b  D0,($0002,A4)
02:000438EE 6100FAEC        	  5920:     jsr     FindDoorAttrByDoorBit
02:000438F2 0C000007        	  5921:     cmpi.b  #$07,D0
02:000438F6 6704            	  5922:     beq  _anon_z05_120
02:000438F8 6000009C        	  5923:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5924: 
                            	  5925: _anon_z05_120:
                            	  5926:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5927:     ;
                            	  5928:     ; Shutters and the commands to open a door always change
                            	  5929:     ; tiles.
                            	  5930:     ;
02:000438FC 61000130        	  5931:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5932:     even
                            	  5933: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5934:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5935:     ; We need to remember how many tiles need to be copied
                            	  5936:     ; in each transfer record.
                            	  5937:     ;
02:00043900 102C0006        	  5938:     move.b  ($0006,A4),D0
02:00043904 19400004        	  5939:     move.b  D0,($0004,A4)
                            	  5940:     ; Write the transfer record header for the door.
                            	  5941:     ;
                            	  5942:     ;
                            	  5943:     ; VRAM address high byte of door
02:00043908 1014            	  5944:     move.b  ($0000,A4),D0
02:0004390A 41EC0302        	  5945:     lea     ($0302,A4),A0
02:0004390E 11802000        	  5946:     move.b  D0,(A0,D2.W)
02:00043912 5202            	  5947:     addq.b  #1,D2
02:00043914 102C0001        	  5948:     move.b  ($0001,A4),D0
02:00043918 41EC0302        	  5949:     lea     ($0302,A4),A0
02:0004391C 11802000        	  5950:     move.b  D0,(A0,D2.W)
02:00043920 5202            	  5951:     addq.b  #1,D2
02:00043922 102C0006        	  5952:     move.b  ($0006,A4),D0
02:00043926 41EC0302        	  5953:     lea     ($0302,A4),A0
02:0004392A 11802000        	  5954:     move.b  D0,(A0,D2.W)
02:0004392E 5202            	  5955:     addq.b  #1,D2
                            	  5956: _anon_z05_121:
                            	  5957:     ; Write two tiles in a short loop indexed by [04].
                            	  5958:     ;
02:00043930 6100ED1C        	  5959:     jsr     WriteDoorFaceTileHorizontally
02:00043934 66FA            	  5960:     bne  _anon_z05_121
                            	  5961:     ; OR the low VRAM address with $20 to go down one row
                            	  5962:     ; in order to work on the second row of door tiles.
                            	  5963:     ;
02:00043936 7020            	  5964:     moveq   #32,D0
02:00043938 122C0001        	  5965:     move.b  ($0001,A4),D1
02:0004393C 8001            	  5966:     or.b  D1,D0
02:0004393E 19400001        	  5967:     move.b  D0,($0001,A4)
                            	  5968:     ; Bottom of the loop.
                            	  5969:     ; Loop again to write the second transfer record for the
                            	  5970:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5971:     ;
02:00043942 532C0005        	  5972:     subq.b  #1,($0005,A4)
02:00043946 66B8            	  5973:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5974:     ; Write the end marker, and update buffer length.
                            	  5975:     ;
02:00043948 103C00FF        	  5976:     move.b  #$FF,D0
02:0004394C 41EC0302        	  5977:     lea     ($0302,A4),A0
02:00043950 11802000        	  5978:     move.b  D0,(A0,D2.W)
02:00043954 1002            	  5979:     move.b  D2,D0
02:00043956 19400301        	  5980:     move.b  D0,($0301,A4)
                            	  5981:     ; Increment the command.
                            	  5982:     ;
02:0004395A 522C0054        	  5983:     addq.b  #1,($0054,A4)
                            	  5984:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5985:     ; and resetting the door command.
                            	  5986:     ; This ends up catching original states 3 and 7.
                            	  5987:     ;
                            	  5988:     ; Else set door timer to 8 and return.
                            	  5989:     ;
02:0004395E 102C0054        	  5990:     move.b  ($0054,A4),D0
02:00043962 02000003        	  5991:     andi.b #$03,D0
02:00043966 6708            	  5992:     beq  _anon_z05_122
02:00043968 7008            	  5993:     moveq   #8,D0
02:0004396A 19400027        	  5994:     move.b  D0,($0027,A4)
02:0004396E 4E75            	  5995:     rts
                            	  5996: 
                            	  5997: _anon_z05_122:
                            	  5998:     ; If the door command = 4 after incrementing it, then
                            	  5999:     ; it was 3 (close door). So:
                            	  6000:     ; 1. reset this door's flag
                            	  6001:     ; 2. remove it from the opened door mask
                            	  6002:     ; 3. reset the door command
                            	  6003:     ; 4. go lay out doors in the play area map
                            	  6004:     ;
02:00043970 102C0054        	  6005:     move.b  ($0054,A4),D0
02:00043974 0C000004        	  6006:     cmpi.b  #$04,D0
02:00043978 6626            	  6007:     bne  _anon_z05_123
02:0004397A 7400            	  6008:     moveq   #0,D2
02:0004397C 142C0009        	  6009:     move.b  ($0009,A4),D2
02:00043980 6100DBBE        	  6010:     jsr     ResetDoorFlag
02:00043984 102C0055        	  6011:     move.b  ($0055,A4),D0
02:00043988 0A00000F        	  6012:     eori.b #$0F,D0
02:0004398C 122C00EE        	  6013:     move.b  ($00EE,A4),D1
02:00043990 C001            	  6014:     and.b  D1,D0
                            	  6015:     even
                            	  6016: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043992 194000EE        	  6017:     move.b  D0,($00EE,A4)
                            	  6018:     even
                            	  6019: L_ResetDoorCmdAndLayOutDoors:
02:00043996 7000            	  6020:     moveq   #0,D0
02:00043998 19400054        	  6021:     move.b  D0,($0054,A4)
02:0004399C 6000FCD4        	  6022:     jmp     LayOutDoors
                            	  6023: 
                            	  6024: _anon_z05_123:
                            	  6025:     ; Door command <> 4.
                            	  6026:     ; It must be 8, which means it was 7: open door.
                            	  6027:     ;
                            	  6028:     ; If the door is a shutter (7), then go add the door to the
                            	  6029:     ; opened door mask, reset door command, and lay out doors.
                            	  6030:     ;
02:000439A0 102C0055        	  6031:     move.b  ($0055,A4),D0
02:000439A4 19400002        	  6032:     move.b  D0,($0002,A4)
02:000439A8 6100FA32        	  6033:     jsr     FindDoorAttrByDoorBit
02:000439AC 0C000007        	  6034:     cmpi.b  #$07,D0
02:000439B0 676E            	  6035:     beq  _anon_z05_124
                            	  6036:     ; Else the door is not a shutter.
                            	  6037:     ;
                            	  6038:     ;
                            	  6039:     ; [09] door direction index
02:000439B2 7400            	  6040:     moveq   #0,D2
02:000439B4 142C0009        	  6041:     move.b  ($0009,A4),D2
02:000439B8 6100DB80        	  6042:     jsr     SetDoorFlag
                            	  6043:     ; Get the next room's ID.
                            	  6044:     ;
02:000439BC 1003            	  6045:     move.b  D3,D0
02:000439BE 023C00EE        	  6046:     andi    #$EE,CCR  ; CLC: clear C+X
02:000439C2 41F90004387E    	  6047:     lea     (DoorNextRoomIdOffsets).l,A0
02:000439C8 12302000        	  6048:     move.b  (A0,D2.W),D1
02:000439CC D101            	  6049:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000439CE 7600            	  6050:     moveq   #0,D3
02:000439D0 1600            	  6051:     move.b  D0,D3
                            	  6052:     ; Flip the door direction index.
                            	  6053:     ;
02:000439D2 1002            	  6054:     move.b  D2,D0
02:000439D4 0A000001        	  6055:     eori.b #$01,D0
02:000439D8 7400            	  6056:     moveq   #0,D2
02:000439DA 1400            	  6057:     move.b  D0,D2
                            	  6058:     ; Set the door flag for the opposite door in the next room.
                            	  6059:     ;
02:000439DC 1214            	  6060:     move.b  ($00,A4),D1   ; ptr lo
02:000439DE 182C0001        	  6061:     move.b  ($01,A4),D4  ; ptr hi
02:000439E2 024100FF        	  6062:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439E6 E14C            	  6063:     lsl.w   #8,D4
02:000439E8 8841            	  6064:     or.w    D1,D4             ; D4 = NES ptr addr
02:000439EA 48C4            	  6065:     ext.l   D4
02:000439EC D8BC00FF0000    	  6066:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000439F2 2044            	  6067:     movea.l D4,A0
02:000439F4 10303000        	  6068:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000439F8 41F90004AB92    	  6069:     lea     (LevelMasks).l,A0
02:000439FE 12302000        	  6070:     move.b  (A0,D2.W),D1
02:00043A02 8001            	  6071:     or.b  D1,D0
02:00043A04 1214            	  6072:     move.b  ($00,A4),D1   ; ptr lo
02:00043A06 182C0001        	  6073:     move.b  ($01,A4),D4  ; ptr hi
02:00043A0A 024100FF        	  6074:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043A0E E14C            	  6075:     lsl.w   #8,D4
02:00043A10 8841            	  6076:     or.w    D1,D4
02:00043A12 48C4            	  6077:     ext.l   D4
02:00043A14 D8BC00FF0000    	  6078:     add.l   #NES_RAM,D4
02:00043A1A 2044            	  6079:     movea.l D4,A0
02:00043A1C 11803000        	  6080:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6081: _anon_z05_124:
                            	  6082:     ; Add the door to the opened door mask, reset door command,
                            	  6083:     ; and lay out doors.
                            	  6084:     ;
02:00043A20 102C0055        	  6085:     move.b  ($0055,A4),D0
02:00043A24 122C00EE        	  6086:     move.b  ($00EE,A4),D1
02:00043A28 8001            	  6087:     or.b  D1,D0
02:00043A2A 6000FF66        	  6088:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6089: 
                            	  6090: ; Params:
                            	  6091: ; [08]: 0 if closed
                            	  6092: ;
                            	  6093: ; Returns:
                            	  6094: ; X: current length of dynamic transfer buf
                            	  6095: ; [00]: door VRAM address high byte
                            	  6096: ; [01]: door VRAM address low byte
                            	  6097: ; [02:03]: address of door tiles for direction and face
                            	  6098: ; [05]: 2, the number of transfer records to write
                            	  6099: ; [06]: 2, the number of tiles in each record
                            	  6100: ; [07]: 0, the first index of a tile to transfer
                            	  6101: ; [09]: door direction index
                            	  6102: ;
                            	  6103: ; Note that this routine is called with triggered doors:
                            	  6104: ; doors that can change state. Their door type numbers are >= 4.
                            	  6105: ;
                            	  6106: ; If this routine were ever called with a fixed door
                            	  6107: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6108: ; values for the door face.
                            	  6109: ;
                            	  6110: ;
                            	  6111: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6112: ;
                            	  6113:     even
                            	  6114: PrepareWriteHorizontalDoorTransferRecords:
02:00043A2E 102C0055        	  6115:     move.b  ($0055,A4),D0
02:00043A32 19400002        	  6116:     move.b  D0,($0002,A4)
02:00043A36 6100F9A4        	  6117:     jsr     FindDoorAttrByDoorBit
02:00043A3A 0C000005        	  6118:     cmpi.b  #$05,D0
02:00043A3E 650C            	  6119:     bcs  _anon_z05_125
02:00043A40 1B00            	  6120:     move.b  D0,-(A5)  ; PHA
02:00043A42 7004            	  6121:     moveq   #4,D0
02:00043A44 4EB90003095C    	  6122:     jsr     PlaySample
02:00043A4A 101D            	  6123:     move.b  (A5)+,D0  ; PLA
                            	  6124: _anon_z05_125:
                            	  6125:     ; Calculate the door face index in three parts.
                            	  6126:     ;
                            	  6127:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6128:     ; (provisional face index in Y register).
                            	  6129:     ;
02:00043A4C 0C000004        	  6130:     cmpi.b  #$04,D0
02:00043A50 6602            	  6131:     bne  _anon_z05_126
02:00043A52 7008            	  6132:     moveq   #8,D0
                            	  6133: _anon_z05_126:
02:00043A54 0C000001        	  6134:     cmpi.b  #$01,D0
02:00043A58 6602            	  6135:     bne  _anon_z05_127
02:00043A5A 7004            	  6136:     moveq   #4,D0
                            	  6137: _anon_z05_127:
                            	  6138:     ; Second, subtract 3 from provisional face index.
                            	  6139:     ;
02:00043A5C 003C0011        	  6140:     ori     #$11,CCR  ; SEC: set C+X
02:00043A60 123C0003        	  6141:     move.b  #$03,D1
02:00043A64 0A3C0010        	  6142:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A68 9101            	  6143:     subx.b  D1,D0   ; SBC #$03
02:00043A6A 0A3C0010        	  6144:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A6E 7600            	  6145:     moveq   #0,D3
02:00043A70 1600            	  6146:     move.b  D0,D3
                            	  6147:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6148:     ; face index >= 3, then subtract 1 from it.
                            	  6149:     ;
                            	  6150:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6151:     ; then make it 1.
                            	  6152:     ;
02:00043A72 102C0008        	  6153:     move.b  ($0008,A4),D0
02:00043A76 6708            	  6154:     beq  _anon_z05_128
02:00043A78 0C030005        	  6155:     cmpi.b  #$05,D3
02:00043A7C 670A            	  6156:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
