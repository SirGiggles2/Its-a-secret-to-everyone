02:0003BE80 6656            	  5388:     bne  _L_z04_UpdateRope_Animate
                            	  5389:     ; If the absolute horizontal distance between Link and the monster >= 8,
                            	  5390:     ; then go see if the vertical distance is smaller.
                            	  5391:     ;
02:0003BE82 102C0070        	  5392:     move.b  ($0070,A4),D0
02:0003BE86 003C0011        	  5393:     ori     #$11,CCR  ; SEC: set C+X
02:0003BE8A 12342070        	  5394:     move.b  ($70,A4,D2.W),D1
02:0003BE8E 0A3C0010        	  5395:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BE92 9101            	  5396:     subx.b  D1,D0   ; SBC ObjX,X
02:0003BE94 0A3C0010        	  5397:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BE98 4EB900030DF4    	  5398:     jsr     Abs
02:0003BE9E 0C000008        	  5399:     cmpi.b  #$08,D0
02:0003BEA2 64000088        	  5400:     bcc  _L_z04_UpdateRope_CheckVertical
