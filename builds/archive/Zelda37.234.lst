02:00030F9E 0A000001        	  4511:     eori.b #$01,D0
02:00030FA2 7600            	  4512:     moveq   #0,D3
02:00030FA4 1600            	  4513:     move.b  D0,D3
02:00030FA6 41EC00AC        	  4514:     lea     ($00AC,A4),A0
02:00030FAA 10303000        	  4515:     move.b  (A0,D3.W),D0
02:00030FAE 6708            	  4516:     beq  _L_z01_WieldBomb_Activate
02:00030FB0 0C000013        	  4517:     cmpi.b  #$13,D0
