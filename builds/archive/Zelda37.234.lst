                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:0003464E 7000            	  1676:     moveq   #0,D0
02:00034650 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00034654 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00034656 41F900034438    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:0003465C D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:0003465E 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:00034664 197C00000303    	  1683:     move.b  #$00,($0303,A4)
