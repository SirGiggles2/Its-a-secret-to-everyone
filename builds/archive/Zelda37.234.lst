02:0003F1B8 19802070        	 12332:     move.b  D0,($70,A4,D2.W)
02:0003F1BC 41EC0084        	 12333:     lea     ($0084,A4),A0
02:0003F1C0 10302000        	 12334:     move.b  (A0,D2.W),D0
02:0003F1C4 023C00EE        	 12335:     andi    #$EE,CCR  ; CLC: clear C+X
