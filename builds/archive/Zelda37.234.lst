                            	  3749: _L_z07_WieldFlute_Found:
                            	  3750:     ; Found.
                            	  3751:     ;
                            	  3752:     ; If it was the first room in the list, handle it specially.
                            	  3753:     ; This room is the only one in Q1 with a flute secret. It's also
