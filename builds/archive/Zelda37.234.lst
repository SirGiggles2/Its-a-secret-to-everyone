02:00039F74 0C000055        	  1003:     cmpi.b  #$55,D0
02:00039F78 6418            	  1004:     bcc  _L_z04_UpdateMonsterShot_CheckBoundary
                            	  1005:     ; Additionally, if the flying rock is held back by a timer, then
                            	  1006:     ; only check for collision with Link.
                            	  1007:     ;
02:00039F7A 10342028        	  1008:     move.b  ($28,A4,D2.W),D0
02:00039F7E 6622            	  1009:     bne  _L_z04_UpdateMonsterShot_CheckLinkCollision
                            	  1010:     ; If the flying rock hit a tile or room boundary, then go destroy it.
