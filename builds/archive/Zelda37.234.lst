02:0003CBF4 6406            	  7201:     bcc  _anon_z04_91
02:0003CBF6 123C0008        	  7202:     move.b  #$08,D1
02:0003CBFA D101            	  7203:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7204: _anon_z04_91:
02:0003CBFC 1880            	  7205:     move.b  D0,($0000,A4)
                            	  7206:     ; Store (Y + 8) in [01].
                            	  7207:     ;
02:0003CBFE 41EC0084        	  7208:     lea     ($0084,A4),A0
02:0003CC02 10302000        	  7209:     move.b  (A0,D2.W),D0
02:0003CC06 123C0008        	  7210:     move.b  #$08,D1
02:0003CC0A D101            	  7211:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC0C 19400001        	  7212:     move.b  D0,($0001,A4)
                            	  7213:     ; Only check the first bomb slot ($10).
                            	  7214:     ;
                            	  7215:     ; Store the bomb's (X + 8) in [02].
                            	  7216:     ;
02:0003CC10 7610            	  7217:     moveq   #16,D3
02:0003CC12 10343070        	  7218:     move.b  ($70,A4,D3.W),D0
02:0003CC16 123C0008        	  7219:     move.b  #$08,D1
02:0003CC1A D101            	  7220:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC1C 19400002        	  7221:     move.b  D0,($0002,A4)
                            	  7222:     ; Store the bomb's (Y + 8) in [03].
                            	  7223:     ;
02:0003CC20 41EC0084        	  7224:     lea     ($0084,A4),A0
02:0003CC24 10303000        	  7225:     move.b  (A0,D3.W),D0
02:0003CC28 123C0008        	  7226:     move.b  #$08,D1
02:0003CC2C D101            	  7227:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC2E 19400003        	  7228:     move.b  D0,($0003,A4)
                            	  7229:     ; But, if there's no bomb, then return.
                            	  7230:     ;
02:0003CC32 41EC00AC        	  7231:     lea     ($00AC,A4),A0
02:0003CC36 10303000        	  7232:     move.b  (A0,D3.W),D0
02:0003CC3A 6720            	  7233:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7234:     ; If the bomb has not exploded (state $12), then
                            	  7235:     ; go see if Dodongo will eat it.
