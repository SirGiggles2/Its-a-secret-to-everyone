02:0004C6DE 1880            	  5860:     move.b  D0,($0000,A4)
02:0004C6E0 41EC00AC        	  5861:     lea     ($00AC,A4),A0
02:0004C6E4 10302000        	  5862:     move.b  (A0,D2.W),D0
