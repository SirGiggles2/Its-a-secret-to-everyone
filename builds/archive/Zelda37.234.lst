                            	  4107: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4108:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4109:     ;
                            	  4110:     ; To match a doorway:
                            	  4111:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4112:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4113:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4114:     ;
                            	  4115:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4116:     ; a doorway to be part of it.
                            	  4117:     ;
