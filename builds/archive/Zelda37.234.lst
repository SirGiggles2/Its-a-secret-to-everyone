02:00036C5C 6502            	  5357:     bcs  _anon_z02_49
02:00036C5E 7006            	  5358:     moveq   #6,D0
                            	  5359: _anon_z02_49:
                            	  5360:     ; If the VRAM line number has not just been incremented to
                            	  5361:     ; the reference line number count, then go write NT attributes.
                            	  5362:     ;
02:00036C60 122C050D        	  5363:     move.b  ($050D,A4),D1
02:00036C64 B001            	  5364:     cmp.b   D1,D0
02:00036C66 661C            	  5365:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5366:     ; Else roll over the VRAM line to 0.
                            	  5367:     ;
02:00036C68 7000            	  5368:     moveq   #0,D0
02:00036C6A 1940050D        	  5369:     move.b  D0,($050D,A4)
                            	  5370:     ; Increment the VRAM page number.
                            	  5371:     ;
02:00036C6E 7600            	  5372:     moveq   #0,D3
02:00036C70 162C050C        	  5373:     move.b  ($050C,A4),D3
02:00036C74 5203            	  5374:     addq.b  #1,D3
                            	  5375:     ; If it has reached $C, then roll it over to 0.
                            	  5376:     ;
02:00036C76 0C03000C        	  5377:     cmpi.b  #$0C,D3
02:00036C7A 6504            	  5378:     bcs  _anon_z02_50
02:00036C7C 7600            	  5379:     moveq   #0,D3
