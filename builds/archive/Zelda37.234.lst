                            	  8139: HaveInput:
                            	  8140:     ; There were input directions.
                            	  8141:     ;
                            	  8142:     ; If there was only one input direction, go set object direction
                            	  8143:     ; to input direction, and set Link's speed.
                            	  8144:     ;
                            	  8145:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8146:     ; (X is still 0, because it's Link's object index).
                            	  8147:     ;
02:00044DC4 102C000F        	  8148:     move.b  ($000F,A4),D0
