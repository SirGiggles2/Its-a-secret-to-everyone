02:0003BFF2 1234203D        	  5556:     move.b  ($3D,A4,D2.W),D1
02:0003BFF6 8001            	  5557:     or.b  D1,D0
02:0003BFF8 6626            	  5558:     bne  _L_z04_UpdateStalfos_ZeroSpeed
                            	  5559:     ; Try to shoot a sword shot.
                            	  5560:     ;
