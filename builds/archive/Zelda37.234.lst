                            	  4082: 
                            	  4083: ; Params:
                            	  4084: ; [0F]: moving direction
                            	  4085: ;
                            	  4086: ; Returns:
                            	  4087: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4088: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4089: ;
                            	  4090: ; When not at or in a doorway, this function leaves
                            	  4091: ; [0F] moving direction as is.
                            	  4092: ;
                            	  4093: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4094: ; will be left as is, assuming that it had been reset before this
                            	  4095: ; routine by BoundByRoom.
                            	  4096: ;
                            	  4097: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4098: ;
                            	  4099: ;
                            	  4100: ; If already in a doorway, go handle it separately.
                            	  4101: ;
