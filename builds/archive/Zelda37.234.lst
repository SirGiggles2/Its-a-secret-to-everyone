                            	 11635: UpdateLamnola:
                            	 11636:     ; If the direction of this segment is not set, then it has not started
                            	 11637:     ; moving yet. So, return.
                            	 11638:     ;
02:0003ECD4 41EC0098        	 11639:     lea     ($0098,A4),A0
02:0003ECD8 10302000        	 11640:     move.b  (A0,D2.W),D0
02:0003ECDC 6602            	 11641:     bne.s  __far_z_04_0114
02:0003ECDE 60F2            	 11642:     jmp  L129EA_Exit
                            	 11643: __far_z_04_0114:
                            	 11644:     ; If we have the magic clock, then go draw and check collisions.
                            	 11645:     ;
02:0003ECE0 102C066C        	 11646:     move.b  ($066C,A4),D0
02:0003ECE4 6614            	 11647:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
02:0003ECE6 6100027C        	 11648:     jsr     Lamnola_Move
                            	 11649:     ; If the current segment is a head, then update the direction it's facing.
                            	 11650:     ;
02:0003ECEA 0C020005        	 11651:     cmpi.b  #$05,D2
02:0003ECEE 6706            	 11652:     beq  _anon_z04_150
02:0003ECF0 0C02000A        	 11653:     cmpi.b  #$0A,D2
02:0003ECF4 6604            	 11654:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
                            	 11655: _anon_z04_150:
02:0003ECF6 610000EC        	 11656:     jsr     Lamnola_UpdateHead
                            	 11657:     even
                            	 11658: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003ECFA 10342070        	 11659:     move.b  ($70,A4,D2.W),D0
02:0003ECFE 1B00            	 11660:     move.b  D0,-(A5)  ; PHA
                            	 11661:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11662:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11663:     ;
02:0003ED00 023C00EE        	 11664:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED04 123C0004        	 11665:     move.b  #$04,D1
02:0003ED08 D101            	 11666:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003ED0A 19802070        	 11667:     move.b  D0,($70,A4,D2.W)
                            	 11668:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11669:     ; to store in [03].
                            	 11670:     ;
02:0003ED0E 102C04E6        	 11671:     move.b  ($04E6,A4),D0
02:0003ED12 0A000003        	 11672:     eori.b #$03,D0
02:0003ED16 19400003        	 11673:     move.b  D0,($0003,A4)
                            	 11674:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11675:     ;
02:0003ED1A 103C009E        	 11676:     move.b  #$9E,D0
02:0003ED1E 0C020005        	 11677:     cmpi.b  #$05,D2
02:0003ED22 670A            	 11678:     beq  _L_z04_UpdateLamnola_Draw
02:0003ED24 0C02000A        	 11679:     cmpi.b  #$0A,D2
02:0003ED28 6704            	 11680:     beq  _L_z04_UpdateLamnola_Draw
02:0003ED2A 103C00A0        	 11681:     move.b  #$A0,D0
                            	 11682:     even
                            	 11683: _L_z04_UpdateLamnola_Draw:
02:0003ED2E 4EB900031C40    	 11684:     jsr     Anim_WriteSprite
02:0003ED34 101D            	 11685:     move.b  (A5)+,D0  ; PLA
02:0003ED36 19802070        	 11686:     move.b  D0,($70,A4,D2.W)
02:0003ED3A 41EC0098        	 11687:     lea     ($0098,A4),A0
02:0003ED3E 10302000        	 11688:     move.b  (A0,D2.W),D0
02:0003ED42 1B00            	 11689:     move.b  D0,-(A5)  ; PHA
02:0003ED44 4EB900031CC0    	 11690:     jsr     CheckMonsterCollisions
02:0003ED4A 101D            	 11691:     move.b  (A5)+,D0  ; PLA
02:0003ED4C 41EC0098        	 11692:     lea     ($0098,A4),A0
02:0003ED50 11802000        	 11693:     move.b  D0,(A0,D2.W)
                            	 11694:     ; If still alive, then return.
                            	 11695:     ;
02:0003ED54 41EC0405        	 11696:     lea     ($0405,A4),A0
02:0003ED58 10302000        	 11697:     move.b  (A0,D2.W),D0
02:0003ED5C 6604            	 11698:     bne.s  __far_z_04_0115
02:0003ED5E 6000FF72        	 11699:     jmp  L129EA_Exit
                            	 11700: __far_z_04_0115:
                            	 11701:     ; Otherwise, the segment is dead.
                            	 11702:     ;
02:0003ED62 4EB90004B7CE    	 11703:     jsr     ResetShoveInfo
                            	 11704:     ; Set the current segment's HP to the initial value in anticipation
                            	 11705:     ; of bringing this segment back to life.
                            	 11706:     ;
02:0003ED68 7020            	 11707:     moveq   #32,D0
02:0003ED6A 41EC0485        	 11708:     lea     ($0485,A4),A0
02:0003ED6E 11802000        	 11709:     move.b  D0,(A0,D2.W)
                            	 11710:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11711:     ;
                            	 11712:     ; From the lowest slot, look for one that has the original lamnola
                            	 11713:     ; object type.
                            	 11714:     ;
                            	 11715:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11716:     ;
02:0003ED72 163C00FF        	 11717:     move.b  #$FF,D3
02:0003ED76 0C020006        	 11718:     cmpi.b  #$06,D2
02:0003ED7A 6502            	 11719:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003ED7C 7604            	 11720:     moveq   #4,D3
                            	 11721:     even
                            	 11722: _L_z04_UpdateLamnola_FindTail:
02:0003ED7E 5203            	 11723:     addq.b  #1,D3
02:0003ED80 41EC0350        	 11724:     lea     ($0350,A4),A0
02:0003ED84 10303000        	 11725:     move.b  (A0,D3.W),D0
02:0003ED88 122C04E7        	 11726:     move.b  ($04E7,A4),D1
02:0003ED8C B001            	 11727:     cmp.b   D1,D0
02:0003ED8E 66EE            	 11728:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11729:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11730:     ;
02:0003ED90 7011            	 11731:     moveq   #17,D0
02:0003ED92 19803029        	 11732:     move.b  D0,($29,A4,D3.W)
                            	 11733:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11734:     ; to the tail segment.
                            	 11735:     ;
02:0003ED96 41EC04F0        	 11736:     lea     ($04F0,A4),A0
02:0003ED9A 10302000        	 11737:     move.b  (A0,D2.W),D0
02:0003ED9E 41EC04F1        	 11738:     lea     ($04F1,A4),A0
02:0003EDA2 11803000        	 11739:     move.b  D0,(A0,D3.W)
02:0003EDA6 10342070        	 11740:     move.b  ($70,A4,D2.W),D0
02:0003EDAA 19803071        	 11741:     move.b  D0,($71,A4,D3.W)
02:0003EDAE 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003EDB2 10302000        	 11743:     move.b  (A0,D2.W),D0
02:0003EDB6 41EC0085        	 11744:     lea     ($0085,A4),A0
02:0003EDBA 11803000        	 11745:     move.b  D0,(A0,D3.W)
                            	 11746:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11747:     ; So, return and leave it dead.
                            	 11748:     ;
02:0003EDBE 0C030004        	 11749:     cmpi.b  #$04,D3
02:0003EDC2 6604            	 11750:     bne.s  __far_z_04_0116
02:0003EDC4 6000FF0C        	 11751:     jmp  L129EA_Exit
                            	 11752: __far_z_04_0116:
02:0003EDC8 0C030009        	 11753:     cmpi.b  #$09,D3
02:0003EDCC 6604            	 11754:     bne.s  __far_z_04_0117
02:0003EDCE 6000FF02        	 11755:     jmp  L129EA_Exit
                            	 11756: __far_z_04_0117:
                            	 11757:     ; Change the tail segment to the dead dummy object, and
                            	 11758:     ; bring the current segment back to life.
                            	 11759:     ;
02:0003EDD2 705D            	 11760:     moveq   #93,D0
02:0003EDD4 41EC0350        	 11761:     lea     ($0350,A4),A0
02:0003EDD8 11803000        	 11762:     move.b  D0,(A0,D3.W)
02:0003EDDC 4EF90004D652    	 11763:     jmp     ResetObjMetastate
                            	 11764: 
                            	 11765:     even
                            	 11766: L12A6F_Exit:
02:0003EDE2 4E75            	 11767:     rts
                            	 11768: 
                            	 11769:     even
                            	 11770: Lamnola_UpdateHead:
                            	 11771:     ; If X coordinate is not a multiple of 8, then return.
                            	 11772:     ;
02:0003EDE4 10342070        	 11773:     move.b  ($70,A4,D2.W),D0
02:0003EDE8 02000007        	 11774:     andi.b #$07,D0
02:0003EDEC 6702            	 11775:     beq.s  __far_z_04_0118
02:0003EDEE 60F2            	 11776:     jmp  L12A6F_Exit
                            	 11777: __far_z_04_0118:
                            	 11778:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11779:     ; We had to account for the usual offset of 3.
                            	 11780:     ;
02:0003EDF0 41EC0084        	 11781:     lea     ($0084,A4),A0
02:0003EDF4 10302000        	 11782:     move.b  (A0,D2.W),D0
02:0003EDF8 023C00EE        	 11783:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDFC 123C0003        	 11784:     move.b  #$03,D1
02:0003EE00 D101            	 11785:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EE02 02000007        	 11786:     andi.b #$07,D0
02:0003EE06 6702            	 11787:     beq.s  __far_z_04_0119
02:0003EE08 60D8            	 11788:     jmp  L12A6F_Exit
                            	 11789: __far_z_04_0119:
                            	 11790:     ; Will loop 4 times, propagating directions down the chain,
                            	 11791:     ; by pulling from the bottom.
                            	 11792:     ;
02:0003EE0A 7004            	 11793:     moveq   #4,D0
02:0003EE0C 1880            	 11794:     move.b  D0,($0000,A4)
                            	 11795:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11796:     ;
02:0003EE0E 7600            	 11797:     moveq   #0,D3
02:0003EE10 0C020005        	 11798:     cmpi.b  #$05,D2
02:0003EE14 6702            	 11799:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EE16 7605            	 11800:     moveq   #5,D3
                            	 11801:     even
                            	 11802: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11803:     ; Loop over every segment under the head, starting from the tail.
                            	 11804:     ; Copy the next segment's direction to the current one in this loop.
                            	 11805:     ;
02:0003EE18 41EC009A        	 11806:     lea     ($009A,A4),A0
02:0003EE1C 10303000        	 11807:     move.b  (A0,D3.W),D0
02:0003EE20 41EC0099        	 11808:     lea     ($0099,A4),A0
02:0003EE24 11803000        	 11809:     move.b  D0,(A0,D3.W)
02:0003EE28 5203            	 11810:     addq.b  #1,D3
02:0003EE2A 5314            	 11811:     subq.b  #1,($0000,A4)
02:0003EE2C 66EA            	 11812:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11813:     ; If this head segment is not aligned with a square, then return.
                            	 11814:     ;
02:0003EE2E 10342070        	 11815:     move.b  ($70,A4,D2.W),D0
02:0003EE32 0200000F        	 11816:     andi.b #$0F,D0
02:0003EE36 660000BA        	 11817:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11818:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11819:     ; We had to account for the usual offset of 3.
                            	 11820:     ;
02:0003EE3A 41EC0084        	 11821:     lea     ($0084,A4),A0
02:0003EE3E 10302000        	 11822:     move.b  (A0,D2.W),D0
02:0003EE42 023C00EE        	 11823:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EE46 123C0003        	 11824:     move.b  #$03,D1
02:0003EE4A D101            	 11825:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EE4C 0200000F        	 11826:     andi.b #$0F,D0
02:0003EE50 660000A0        	 11827:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11828:     ; Store the opposite of the facing direction in [00].
                            	 11829:     ;
02:0003EE54 41EC0098        	 11830:     lea     ($0098,A4),A0
02:0003EE58 10302000        	 11831:     move.b  (A0,D2.W),D0
02:0003EE5C E208            	 11832:     lsr.b  #1,D0   ; LSR A
02:0003EE5E 02000005        	 11833:     andi.b #$05,D0
02:0003EE62 1880            	 11834:     move.b  D0,($0000,A4)
02:0003EE64 41EC0098        	 11835:     lea     ($0098,A4),A0
02:0003EE68 10302000        	 11836:     move.b  (A0,D2.W),D0
02:0003EE6C E308            	 11837:     lsl.b  #1,D0   ; ASL A
02:0003EE6E 0200000A        	 11838:     andi.b #$0A,D0
02:0003EE72 1214            	 11839:     move.b  ($0000,A4),D1
02:0003EE74 8001            	 11840:     or.b  D1,D0
                            	 11841:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11842:     ;
02:0003EE76 0A00000F        	 11843:     eori.b #$0F,D0
02:0003EE7A 1940050F        	 11844:     move.b  D0,($050F,A4)
                            	 11845:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11846:     ;
02:0003EE7E 10342018        	 11847:     move.b  ($18,A4,D2.W),D0
02:0003EE82 0C000080        	 11848:     cmpi.b  #$80,D0
02:0003EE86 656C            	 11849:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11850:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11851:     ; Load the monster's facing direction.
                            	 11852:     ;
02:0003EE88 41EC0098        	 11853:     lea     ($0098,A4),A0
02:0003EE8C 10302000        	 11854:     move.b  (A0,D2.W),D0
                            	 11855:     ; Load the next random number into Y register.
                            	 11856:     ;
02:0003EE90 7600            	 11857:     moveq   #0,D3
02:0003EE92 16342019        	 11858:     move.b  ($19,A4,D2.W),D3
                            	 11859:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11860:     ; to keep moving straight.
                            	 11861:     ;
02:0003EE96 0C030080        	 11862:     cmpi.b  #$80,D3
02:0003EE9A 6418            	 11863:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11864:     even
                            	 11865: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11866:     ; Loop to rotate the direction bit over the mask.
                            	 11867:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11868:     ; facing direction.
                            	 11869:     ;
                            	 11870:     ; Shift right the copy of the direction.
                            	 11871:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11872:     ;
02:0003EE9C E208            	 11873:     lsr.b  #1,D0   ; LSR A
02:0003EE9E 6402            	 11874:     bcc  _anon_z04_151
02:0003EEA0 7008            	 11875:     moveq   #8,D0
                            	 11876: _anon_z04_151:
                            	 11877:     ; If the current direction bit is masked off, then we've reached
                            	 11878:     ; the opposite direction. Loop again.
                            	 11879:     ;
02:0003EEA2 122C050F        	 11880:     move.b  ($050F,A4),D1
02:0003EEA6 C200            	 11881:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEA8 67F2            	 11882:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11883:     ; If Y register >= $40, then break out of the loop.
                            	 11884:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11885:     ;
02:0003EEAA 0C030040        	 11886:     cmpi.b  #$40,D3
02:0003EEAE 6404            	 11887:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11888:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11889:     ; and loop again now.
                            	 11890:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11891:     ;
02:0003EEB0 7640            	 11892:     moveq   #64,D3
02:0003EEB2 65E8            	 11893:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11894:     even
                            	 11895: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11896:     ; Change the facing direction to the direction found.
                            	 11897:     ;
02:0003EEB4 41EC0098        	 11898:     lea     ($0098,A4),A0
02:0003EEB8 11802000        	 11899:     move.b  D0,(A0,D2.W)
                            	 11900:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11901:     ;
02:0003EEBC 1940000F        	 11902:     move.b  D0,($000F,A4)
02:0003EEC0 4EB900030CF6    	 11903:     jsr     BoundByRoom
                            	 11904:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11905:     ;
02:0003EEC6 102C000F        	 11906:     move.b  ($000F,A4),D0
02:0003EECA 6618            	 11907:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11908:     even
                            	 11909: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11910:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11911:     ; for looking for any non-opposite direction that is not blocked.
                            	 11912:     ;
02:0003EECC 41EC0098        	 11913:     lea     ($0098,A4),A0
02:0003EED0 10302000        	 11914:     move.b  (A0,D2.W),D0
                            	 11915:     even
                            	 11916: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11917:     ; Shift right the copy of the direction.
                            	 11918:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11919:     ;
02:0003EED4 E208            	 11920:     lsr.b  #1,D0   ; LSR A
02:0003EED6 6402            	 11921:     bcc  _anon_z04_152
02:0003EED8 7008            	 11922:     moveq   #8,D0
                            	 11923: _anon_z04_152:
                            	 11924:     ; If the current direction bit is not masked off, then go check the
                            	 11925:     ; room boundary in this direction.
                            	 11926:     ; Else we've reached the opposite direction. Loop again.
                            	 11927:     ;
02:0003EEDA 122C050F        	 11928:     move.b  ($050F,A4),D1
02:0003EEDE C200            	 11929:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEE0 66D2            	 11930:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EEE2 67F0            	 11931:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11932:     even
                            	 11933: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11934:     ; We found a direction that was not blocked by the room boundary.
                            	 11935:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11936:     ;
02:0003EEE4 4EB90004B75A    	 11937:     jsr     GetCollidingTileMoving
02:0003EEEA 122C034A        	 11938:     move.b  ($034A,A4),D1
02:0003EEEE B001            	 11939:     cmp.b   D1,D0
02:0003EEF0 64DA            	 11940:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11941:     even
                            	 11942: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11943:     ; TODO: confirm this
                            	 11944:     ;
                            	 11945:     ; If there were a room that had lamnolas, and they could get
                            	 11946:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11947:     ; an infinite loop.
                            	 11948:     ;
                            	 11949:     ; But, the only room with that configuration has those blocks
                            	 11950:     ; blocked off with a push block, which can only be pushed after
                            	 11951:     ; all monsters are killed.
                            	 11952:     ;
02:0003EEF2 4E75            	 11953:     rts
                            	 11954: 
                            	 11955:     even
                            	 11956: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11957:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11958:     ;
02:0003EEF4 7001            	 11959:     moveq   #1,D0
02:0003EEF6 19400002        	 11960:     move.b  D0,($0002,A4)
02:0003EEFA 102C0070        	 11961:     move.b  ($0070,A4),D0
02:0003EEFE 003C0011        	 11962:     ori     #$11,CCR  ; SEC: set C+X
02:0003EF02 12342070        	 11963:     move.b  ($70,A4,D2.W),D1
02:0003EF06 0A3C0010        	 11964:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF0A 9101            	 11965:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EF0C 0A3C0010        	 11966:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF10 640A            	 11967:     bcc  _anon_z04_153
02:0003EF12 122C0002        	 11968:     move.b  ($0002,A4),D1
02:0003EF16 E309            	 11969:     lsl.b  #1,D1   ; ASL $02
02:0003EF18 19410002        	 11970:     move.b  D1,($0002,A4)
                            	 11971: _anon_z04_153:
                            	 11972:     ; Find the vertical direction toward Link and store it in [03].
                            	 11973:     ;
02:0003EF1C 7004            	 11974:     moveq   #4,D0
