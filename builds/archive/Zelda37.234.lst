Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:00000348 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:0000034A 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:0000034E 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:00000354 6BF8            	    86:     bmi.s   .wait
02:00000356 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:0000035C 4E71            	    88:     nop                              ; address setup delay
02:0000035E 4E71            	    89:     nop
02:00000360 4E71            	    90:     nop
02:00000362 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:00000368 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:0000036A 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:0000036C 40E7            	   108:     move.w  SR,-(SP)
02:0000036E 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:00000372 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:00000378 6BF8            	   112:     bmi.s   .wait
02:0000037A 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:00000380 4E71            	   114:     nop
02:00000382 4E71            	   115:     nop
02:00000384 4E71            	   116:     nop
02:00000386 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:0000038C 46DF            	   118:     move.w  (SP)+,SR
02:0000038E 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:00000390 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:00000392 B47C0002        	   132:     cmp.w   #2,D2
02:00000396 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:00000398 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:0000039A 692E            	   135:     bvs.s   .silence                ; overflow safety
02:0000039C 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:0000039E 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:000003A0 BA7C07FF        	   139:     cmp.w   #2047,D5
02:000003A4 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:000003A6 E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:000003A8 5204            	   142:     addq.b  #1,D4                   ; increment block
02:000003AA B83C0007        	   143:     cmp.b   #7,D4
02:000003AE 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:000003B0 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:000003B2 1404            	   148:     move.b  D4,D2
02:000003B4 E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:000003B6 3605            	   150:     move.w  D5,D3
02:000003B8 E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:000003BA 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:000003BC 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:000003BE 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:000003C0 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:000003C4 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:000003C8 4E75            	   159:     rts
                            	   160: .silence:
02:000003CA 7400            	   161:     moveq   #0,D2
02:000003CC 7600            	   162:     moveq   #0,D3
02:000003CE 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:000003D0 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:000003D4 43FA0172        	   175:     lea     FM_PATCH_REGS(PC),A1
02:000003D8 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:000003DA 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:000003DC D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:000003DE 1218            	   180:     move.b  (A0)+,D1                ; data value
02:000003E0 6100FF66        	   181:     bsr     ym_write1
02:000003E4 51CAFFF4        	   182:     dbra    D2,.loop
02:000003E8 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:000003EC 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:000003EE 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:000003F2 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:000003F6 7200            	   199:     moveq   #0,D1
02:000003F8 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:000003FC 123C0001        	   201:     move.b  #$01,D1
02:00000400 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:00000404 123C0002        	   203:     move.b  #$02,D1
02:00000408 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:0000040C 123C0004        	   205:     move.b  #$04,D1
02:00000410 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:00000414 123C0005        	   207:     move.b  #$05,D1
02:00000418 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:0000041C 123C0006        	   209:     move.b  #$06,D1
02:00000420 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:00000424 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:00000428 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:0000042C 6100FF1A        	   223:     bsr     ym_write1
02:00000430 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:00000434 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:00000438 6100FF0E        	   226:     bsr     ym_write1
02:0000043C 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:00000440 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:00000444 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:00000448 103C0022        	   234:     move.b  #$22,D0
02:0000044C 7200            	   235:     moveq   #0,D1
02:0000044E 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:00000452 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:00000454 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:00000458 6100FEEE        	   253:     bsr     ym_write1
02:0000045C 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:00000460 6100FEE6        	   255:     bsr     ym_write1
02:00000464 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:00000468 6100FEDE        	   257:     bsr     ym_write1
02:0000046C 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:00000470 6100FED6        	   259:     bsr     ym_write1
02:00000474 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:00000478 6100FECE        	   261:     bsr     ym_write1
02:0000047C 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:00000480 6100FEC6        	   263:     bsr     ym_write1
02:00000484 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:00000488 6100FEBE        	   265:     bsr     ym_write1
02:0000048C 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:00000490 6100FEB6        	   267:     bsr     ym_write1
02:00000494 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:00000498 6100FEAE        	   269:     bsr     ym_write1
02:0000049C 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:000004A0 6100FEA6        	   271:     bsr     ym_write1
02:000004A4 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:000004A8 6100FE9E        	   273:     bsr     ym_write1
02:000004AC 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:000004B0 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
                            	   277:     ;------------------------------------------------------------------
                            	   278:     ; Load EHZ Voice $03 into ch 0 (m_sq1 = NES Sq1 = Pulse 2 = LEAD melody)
                            	   279:     ; NES naming: Sq1/Sq0 are reversed from intuition — Sq1 writes $4006/$4007
                            	   280:     ; (Pulse 2) and owns the primary melody.  Put the snappy EHZ lead here.
                            	   281:     ;------------------------------------------------------------------
02:000004B4 41FA00C6        	   282:     lea     PATCH_VOICE03(PC),A0
02:000004B8 7C00            	   283:     moveq   #0,D6                   ; channel 0 (emit_note_sq1 target)
02:000004BA 6100FF14        	   284:     bsr     load_fm_patch
                            	   285: 
                            	   286:     ;------------------------------------------------------------------
                            	   287:     ; Load EHZ Voice $00 into ch 1 (m_sq0 = NES Sq0 = Pulse 1 = harmony/arp)
                            	   288:     ; The slow-decay pad fits arpeggiated harmony better than a sharp lead.
                            	   289:     ;------------------------------------------------------------------
02:000004BE 41FA00A2        	   290:     lea     PATCH_VOICE00(PC),A0
02:000004C2 7C01            	   291:     moveq   #1,D6                   ; channel 1 (emit_note_sq0 target)
02:000004C4 6100FF0A        	   292:     bsr     load_fm_patch
                            	   293: 
                            	   294:     ;------------------------------------------------------------------
                            	   295:     ; Load EHZ Voice $07 into ch 2 (Triangle — Algorithm 0, bass)
                            	   296:     ;------------------------------------------------------------------
02:000004C8 41FA00CC        	   297:     lea     PATCH_VOICE07(PC),A0
02:000004CC 7C02            	   298:     moveq   #2,D6                   ; channel 2
02:000004CE 6100FF00        	   299:     bsr     load_fm_patch
                            	   300: 
                            	   301:     ;------------------------------------------------------------------
                            	   302:     ; Set panning: both speakers for ch 0–2
                            	   303:     ; Register $B4+ch, data $C0 = L+R output
                            	   304:     ;------------------------------------------------------------------
02:000004D2 103C00B4        	   305:     move.b  #$B4,D0
02:000004D6 123C00C0        	   306:     move.b  #$C0,D1
02:000004DA 6100FE6C        	   307:     bsr     ym_write1               ; ch 0 panning
02:000004DE 103C00B5        	   308:     move.b  #$B5,D0
02:000004E2 6100FE64        	   309:     bsr     ym_write1               ; ch 1 panning
02:000004E6 103C00B6        	   310:     move.b  #$B6,D0
02:000004EA 6100FE5C        	   311:     bsr     ym_write1               ; ch 2 panning
                            	   312: 
                            	   313:     ;------------------------------------------------------------------
                            	   314:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   315:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   316:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   317:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   318:     ; authoritative TL bytes for each voice.)
                            	   319:     ;------------------------------------------------------------------
                            	   320: 
                            	   321:     ;------------------------------------------------------------------
                            	   322:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   323:     ;------------------------------------------------------------------
02:000004EE 13FC009F00C00011	   324:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:000004F6 13FC00BF00C00011	   325:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:000004FE 13FC00DF00C00011	   326:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:00000506 13FC00FF00C00011	   327:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   328: 
                            	   329:     ;------------------------------------------------------------------
                            	   330:     ; Clear shadow APU registers
                            	   331:     ;------------------------------------------------------------------
02:0000050E 41F900FF0A00    	   332:     lea     (APU_SH_BASE).l,A0
02:00000514 7008            	   333:     moveq   #($11/2),D0            ; 18 bytes / 2 = 9 words (round up)
                            	   334: .clr:
02:00000516 4258            	   335:     clr.w   (A0)+
02:00000518 51C8FFFC        	   336:     dbra    D0,.clr
                            	   337: 
                            	   338:     ;------------------------------------------------------------------
                            	   339:     ; Clear native music player state
                            	   340:     ;------------------------------------------------------------------
02:0000051C 41F900FFE000    	   341:     lea     (MUSIC_BASE).l,A0
02:00000522 700F            	   342:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   343: .clr_music:
02:00000524 4298            	   344:     clr.l   (A0)+
02:00000526 51C8FFFC        	   345:     dbra    D0,.clr_music
                            	   346: 
                            	   347:     ;------------------------------------------------------------------
                            	   348:     ; Clear DMC state block ($FFE100, 17 bytes — rounded to 20).  Zero
                            	   349:     ; dmc_active, dmc_burst, dmc_ptr, dmc_remain, shadow registers, and
                            	   350:     ; debug scaffold state.
                            	   351:     ;------------------------------------------------------------------
02:0000052A 41F900FFE100    	   352:     lea     (DMC_BASE).l,A0
02:00000530 4298            	   353:     clr.l   (A0)+                   ; active + burst
02:00000532 4298            	   354:     clr.l   (A0)+                   ; dmc_ptr
02:00000534 4298            	   355:     clr.l   (A0)+                   ; dmc_remain
02:00000536 4298            	   356:     clr.l   (A0)+                   ; rate/addr/len sel + prev_btn
02:00000538 4298            	   357:     clr.l   (A0)+                   ; dbg_next + pad (over-clear, safe)
                            	   358:     ;------------------------------------------------------------------
                            	   359:     ; Scaffold: preload dmc_dbg_next = 1 so the first Start press fires
                            	   360:     ; sample #1.  dmc_trigger wraps 1..7 from there.
                            	   361:     ;------------------------------------------------------------------
02:0000053A 13FC000100FFE110	   362:     move.b  #1,(dmc_dbg_next).l
                            	   363: 
02:00000542 4CDF017F        	   364:     movem.l (SP)+,D0-D6/A0
02:00000546 4E75            	   365:     rts
                            	   366: 
                            	   367: ;==============================================================================
                            	   368: ; FM Patch Register Address Table
                            	   369: ;
                            	   370: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   371: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   372: ;==============================================================================
                            	   373:     even
                            	   374: FM_PATCH_REGS:
02:00000548 B0              	   375:     dc.b    $B0                     ; FB/ALG
02:00000549 30              	   376:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:0000054A 34
02:0000054B 38
02:0000054C 3C
02:0000054D 50              	   377:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:0000054E 54
02:0000054F 58
02:00000550 5C
02:00000551 60              	   378:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:00000552 64
02:00000553 68
02:00000554 6C
02:00000555 70              	   379:     dc.b    $70,$74,$78,$7C         ; D2R
02:00000556 74
02:00000557 78
02:00000558 7C
02:00000559 80              	   380:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:0000055A 84
02:0000055B 88
02:0000055C 8C
02:0000055D 40              	   381:     dc.b    $40,$44,$48,$4C         ; TL
02:0000055E 44
02:0000055F 48
02:00000560 4C
                            	   382:     even
                            	   383: 
                            	   384: ;==============================================================================
                            	   385: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   386: ;
                            	   387: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   388: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   389: ;
                            	   390: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   391: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   392: ;   bytes 5-8   : RS/AR    "
                            	   393: ;   bytes 9-12  : AM/D1R   "
                            	   394: ;   bytes 13-16 : D2R      "
                            	   395: ;   bytes 17-20 : DL/RR    "
                            	   396: ;   bytes 21-24 : TL       "
                            	   397: ;
                            	   398: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   399: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   400: ; without any reordering in load_fm_patch.
                            	   401: ;
                            	   402: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   403: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   404: ; volume is added for operators without the flag.  We have no per-channel
                            	   405: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   406: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   407: ; modulator TL bytes as-is.
                            	   408: ;
                            	   409: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   410: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   411: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   412: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   413: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   414: ; middle values differ enough that the swap produced cross-wired FM
                            	   415: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   416: ; authoritative byte order here.
                            	   417: ;==============================================================================
                            	   418: 
                            	   419: ; Voice $00 — Bell-like pad.
                            	   420: ;
                            	   421: ; Classic FM bell recipe:
                            	   422: ;   Alg 5 (3 carriers modulated by op1)
                            	   423: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   424: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   425: ;     which is what gives bells their characteristic "chime" quality
                            	   426: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   427: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   428: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   429: PATCH_VOICE00:
02:00000562 2D              	   430:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:00000563 04              	   431:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:00000564 01
02:00000565 01
02:00000566 01
02:00000567 1F              	   432:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:00000568 1F
02:00000569 1F
02:0000056A 1F
02:0000056B 08              	   433:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:0000056C 04
02:0000056D 04
02:0000056E 04
02:0000056F 00              	   434:     dc.b    $00,$00,$00,$00         ; D2R
02:00000570 00
02:00000571 00
02:00000572 00
02:00000573 47              	   435:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:00000574 37
02:00000575 37
02:00000576 17
02:00000577 14              	   436:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:00000578 1E
02:00000579 1E
02:0000057A 1E
                            	   437:     even
                            	   438: 
                            	   439: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   440: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   441: PATCH_VOICE03:
02:0000057C 3D              	   442:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:0000057D 01              	   443:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:0000057E 51
02:0000057F 21
02:00000580 01
02:00000581 1F              	   444:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:00000582 1F
02:00000583 1F
02:00000584 1F
02:00000585 0A              	   445:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000586 05
02:00000587 05
02:00000588 05
02:00000589 00              	   446:     dc.b    $00,$00,$00,$00         ; D2R
02:0000058A 00
02:0000058B 00
02:0000058C 00
02:0000058D 2B              	   447:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:0000058E 2B
02:0000058F 2B
02:00000590 1B
02:00000591 19              	   448:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:00000592 18
02:00000593 18
02:00000594 18
                            	   449:     even
                            	   450: 
                            	   451: ; Voice $07 — Clean bass.
                            	   452: ;
                            	   453: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   454: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   455: ; damental already provides.  Moderately quiet so it supports the lead
                            	   456: ; without fighting it.
                            	   457: PATCH_VOICE07:
02:00000596 0D              	   458:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:00000597 01              	   459:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:00000598 01
02:00000599 01
02:0000059A 01
02:0000059B 1F              	   460:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:0000059C 1F
02:0000059D 1F
02:0000059E 1F
02:0000059F 0A              	   461:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:000005A0 05
02:000005A1 05
02:000005A2 05
02:000005A3 00              	   462:     dc.b    $00,$00,$00,$00         ; D2R
02:000005A4 00
02:000005A5 00
02:000005A6 00
02:000005A7 28              	   463:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:000005A8 28
02:000005A9 28
02:000005AA 18
02:000005AB 22              	   464:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:000005AC 20
02:000005AD 20
02:000005AE 20
                            	   465:     even
                            	   466: 
                            	   467: ;==============================================================================
                            	   468: ;==============================================================================
                            	   469: ; NATIVE M68K MUSIC PLAYER
                            	   470: ;
                            	   471: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   472: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   473: ;
                            	   474: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   475: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   476: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   477: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   478: ;==============================================================================
                            	   479: ;==============================================================================
                            	   480: 
                            	   481: ;----------------------------------------------------------------------
                            	   482: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   483: ;----------------------------------------------------------------------
                            	   484: ; ============================================================================
                            	   485: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   486: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   487: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   488: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   489: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   490: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   491: ; ============================================================================
                            	   492: MUSIC_BASE          equ $FFE000
                            	   493: MUSIC_STATE_SIZE    equ $40
                            	   494: 
                            	   495: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   496: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   497: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   498: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   499: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   500: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   501: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   502: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   503: 
                            	   504: ; Sq1 (Pulse 1 → YM ch 0)
                            	   505: m_sq1_off           equ MUSIC_BASE+$0C
                            	   506: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   507: m_sq1_len           equ MUSIC_BASE+$0E
                            	   508: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   509: m_sq1_per           equ MUSIC_BASE+$10
                            	   510: 
                            	   511: ; Sq0 (Pulse 2 → YM ch 1)
                            	   512: m_sq0_off           equ MUSIC_BASE+$14
                            	   513: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   514: m_sq0_len           equ MUSIC_BASE+$16
                            	   515: m_sq0_vib           equ MUSIC_BASE+$17
                            	   516: m_sq0_per           equ MUSIC_BASE+$18
                            	   517: 
                            	   518: ; Triangle (→ YM ch 2)
                            	   519: m_trg_off           equ MUSIC_BASE+$1C
                            	   520: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   521: m_trg_len           equ MUSIC_BASE+$1E
                            	   522: m_trg_vib           equ MUSIC_BASE+$1F
                            	   523: m_trg_per           equ MUSIC_BASE+$20
                            	   524: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   525: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   526: 
                            	   527: ; Noise (→ PSG ch 3)
                            	   528: m_noise_off         equ MUSIC_BASE+$24
                            	   529: m_noise_cnt         equ MUSIC_BASE+$25
                            	   530: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   531: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   532: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   533: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   534: ; skip redundant writes to preserve the decay tail.
                            	   535: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   536: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   537: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   538: 
                            	   539: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   540: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   541: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   542: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   543: 
                            	   544: ;----------------------------------------------------------------------
                            	   545: ; DMC → YM2612 DAC state (Phase A of DMC port — see
                            	   546: ; C:\Users\Jake Diggity\.claude\plans\quirky-baking-goose.md).
                            	   547: ;
                            	   548: ; Lives at $FFE100, clear of the music-state block at $FFE000-$FFE03F.
                            	   549: ; Written by the DMC APU stubs in nes_io.asm, consumed by dmc_feed which
                            	   550: ; runs at the tail of music_tick and bursts PCM bytes to YM reg $2A.
                            	   551: ;----------------------------------------------------------------------
                            	   552: DMC_BASE            equ $FFE100
                            	   553: dmc_active          equ DMC_BASE+$00    ; byte: 0 = idle, 1 = playing
                            	   554: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   555: dmc_ptr             equ DMC_BASE+$04    ; long: current M68K pointer into PCM blob
                            	   556: dmc_remain          equ DMC_BASE+$08    ; long: PCM bytes left in current sample
                            	   557: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   558: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   559: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   560: dmc_dbg_prev_btn    equ DMC_BASE+$0F    ; byte: pad state from last frame (edge det)
                            	   561: dmc_dbg_next        equ DMC_BASE+$10    ; byte: next sample index (1..7) to trigger
                            	   562: 
                            	   563: ;==============================================================================
                            	   564: ; dmc_trigger — non-blocking HBlank DAC streamer.
                            	   565: ;
                            	   566: ; Samples are pre-processed by tools/extract_dmc_samples.py: proper bandlimited
                            	   567: ; resampling (scipy.signal.resample_poly with Kaiser-window FIR) from native
                            	   568: ; NES rate (21/25/33 kHz) down to the empirically-measured Genesis HINT rate
                            	   569: ; (~8751 Hz with music active). That's where the "crunchy" sound came from
                            	   570: ; before — linear interpolation without anti-alias filter caused aliasing.
                            	   571: ; With proper prefiltered resampling, playback sounds clean even at the lower
                            	   572: ; effective rate, and the game does NOT hitch.
                            	   573: ;==============================================================================
                            	   574: dmc_trigger:
02:000005B0 4A00            	   575:     tst.b   D0
02:000005B2 6762            	   576:     beq.s   .bad
02:000005B4 B03C0007        	   577:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:000005B8 625C            	   578:     bhi.s   .bad
02:000005BA 48E7E0C0        	   579:     movem.l D0-D2/A0-A1,-(SP)
02:000005BE 13C000FFE101    	   580:     move.b  D0,(dmc_last_idx).l
02:000005C4 7200            	   581:     moveq   #0,D1
02:000005C6 1200            	   582:     move.b  D0,D1                   ; D1.l = 1-based index
02:000005C8 5381            	   583:     subq.l  #1,D1                   ; 0-based
02:000005CA D281            	   584:     add.l   D1,D1                   ; idx * 2
02:000005CC D281            	   585:     add.l   D1,D1                   ; idx * 4
                            	   586: 
02:000005CE 41F9000018CC    	   587:     lea     (DMC_SAMPLE_PCM_OFFS).l,A0
02:000005D4 24301800        	   588:     move.l  (A0,D1.l),D2
02:000005D8 43F90000523C    	   589:     lea     (DMC_SAMPLE_PCM_BLOB).l,A1
02:000005DE D3C2            	   590:     add.l   D2,A1
                            	   591: 
02:000005E0 41F9000018E8    	   592:     lea     (DMC_SAMPLE_PCM_LENS).l,A0
02:000005E6 24301800        	   593:     move.l  (A0,D1.l),D2
02:000005EA 4A82            	   594:     tst.l   D2
02:000005EC 6724            	   595:     beq.s   .bad_restore
                            	   596: 
02:000005EE 23C900FFE104    	   597:     move.l  A1,(dmc_ptr).l
02:000005F4 23C200FFE108    	   598:     move.l  D2,(dmc_remain).l
02:000005FA 13FC000100FFE100	   599:     move.b  #1,(dmc_active).l
                            	   600: 
                            	   601:     ; Arm HBlank every line, enable HINT (preserve colorfix bit).
02:00000602 33FC8A0000C00004	   602:     move.w  #$8A00,(VDP_CTRL).l     ; Reg 10 = 0 -> fire every line
02:0000060A 33FC801400C00004	   603:     move.w  #$8014,(VDP_CTRL).l     ; Reg  0 = $14 -> HINT on + colorfix
                            	   604: .bad_restore:
02:00000612 4CDF0307        	   605:     movem.l (SP)+,D0-D2/A0-A1
                            	   606: .bad:
02:00000616 4E75            	   607:     rts
                            	   608: 
                            	   609: ;==============================================================================
                            	   610: ; dmc_hint_tick — per-HBlank PCM byte -> YM2612 reg $2A DAC write.
                            	   611: ;==============================================================================
                            	   612: dmc_hint_tick:
02:00000618 207900FFE104    	   613:     move.l  (dmc_ptr).l,A0
02:0000061E 1018            	   614:     move.b  (A0)+,D0
02:00000620 23C800FFE104    	   615:     move.l  A0,(dmc_ptr).l
02:00000626 41F900A04000    	   616:     lea     (YM_ADDR1).l,A0
                            	   617: .wait:
02:0000062C 4A10            	   618:     tst.b   (A0)
02:0000062E 6BFC            	   619:     bmi.s   .wait
02:00000630 10BC002A        	   620:     move.b  #$2A,(A0)
02:00000634 13C000A04001    	   621:     move.b  D0,(YM_DATA1).l
02:0000063A 53B900FFE108    	   622:     subq.l  #1,(dmc_remain).l
02:00000640 6702            	   623:     beq.s   .end
02:00000642 4E75            	   624:     rts
                            	   625: .end:
02:00000644 41F900A04000    	   626:     lea     (YM_ADDR1).l,A0
                            	   627: .wait2:
02:0000064A 4A10            	   628:     tst.b   (A0)
02:0000064C 6BFC            	   629:     bmi.s   .wait2
02:0000064E 10BC002A        	   630:     move.b  #$2A,(A0)
02:00000652 13FC008000A04001	   631:     move.b  #$80,(YM_DATA1).l       ; park DAC at mid-rail
02:0000065A 423900FFE100    	   632:     clr.b   (dmc_active).l
02:00000660 33FC800400C00004	   633:     move.w  #$8004,(VDP_CTRL).l     ; Reg 0 = $04 -> HINT off, colorfix on
02:00000668 4E75            	   634:     rts
                            	   635: 
                            	   636: ;==============================================================================
                            	   637: ; dmc_feed — legacy VBlank entry point, retained as labeled rts.
                            	   638: ;
                            	   639: ; music_tick used to call this to drain a frame's worth of PCM in VBlank.
                            	   640: ; All streaming now happens from HBlank via dmc_hint_tick.  Kept as a cheap
                            	   641: ; rts so we don't have to surgically delete the call from music_tick.
                            	   642: ;==============================================================================
                            	   643: dmc_feed:
02:0000066A 4E75            	   644:     rts
                            	   645: 
                            	   646: ;==============================================================================
                            	   647: ; dmc_dbg_poll - Phase-C/D scaffold (REMOVED in Phase E).
                            	   648: ;
                            	   649: ; Previously watched the NES-format controller latch for a Start rising edge
                            	   650: ; and cycled through the 7 DMC samples.  That scaffold served its purpose at
                            	   651: ; T27/T28 PASS — DMC triggering is now fully driven by the game's own APU
                            	   652: ; $4015 writes via the _apu_write_4015 stub in nes_io.asm (Phase D), and
                            	   653: ; Start has a real game function (exit attract mode).  Polling it here would
                            	   654: ; fire a stray DMC burst every time the player presses Start on the title
                            	   655: ; screen, masking real game audio events.
                            	   656: ;
                            	   657: ; The label is kept as a labeled rts for backward-compat with the call in
                            	   658: ; music_tick, which we'll peel out in a later cleanup pass.
                            	   659: ;==============================================================================
                            	   660: dmc_dbg_poll:
02:0000066C 4E75            	   661:     rts
                            	   662: 
                            	   663: ;==============================================================================
                            	   664: ; music_play — request a song change
                            	   665: ; Input: D0.b = song bitmap
                            	   666: ;==============================================================================
                            	   667: music_play:
02:0000066E 13C000FFE001    	   668:     move.b  D0,(m_song_req).l
02:00000674 4E75            	   669:     rts
                            	   670: 
                            	   671: ;==============================================================================
                            	   672: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   673: ;==============================================================================
                            	   674: music_tick:
02:00000676 48E7FFE0        	   675:     movem.l D0-D7/A0-A2,-(SP)
                            	   676:     ;------------------------------------------------------------------
                            	   677:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   678:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   679:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   680:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   681:     ; address and data bytes.
                            	   682:     ;
                            	   683:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   684:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   685:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   686:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   687:     ; removing it to a later cleanup pass.
                            	   688:     ;------------------------------------------------------------------
                            	   689:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   690:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   691:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   692:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   693:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   694:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   695:     ; the silence-request bit 7 and route it into native music_silence.
                            	   696:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   697:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   698:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   699:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   700:     ; and clear the game-side byte so the game's own driver-absent check
                            	   701:     ; ("did my song change get consumed?") stays coherent.
02:0000067A 103900FF0600    	   702:     move.b  ($FF0600).l,D0
02:00000680 670C            	   703:     beq.s   .no_song_req_bridge
02:00000682 423900FF0600    	   704:     clr.b   ($FF0600).l
02:00000688 13C000FFE001    	   705:     move.b  D0,(m_song_req).l
                            	   706: .no_song_req_bridge:
02:0000068E 103900FF0604    	   707:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:00000694 6B08            	   708:     bmi.s   .do_silence
02:00000696 103900FF0602    	   709:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:0000069C 6A24            	   710:     bpl.s   .no_silence_req
                            	   711: .do_silence:
02:0000069E 423900FF0602    	   712:     clr.b   ($FF0602).l
02:000006A4 423900FF0603    	   713:     clr.b   ($FF0603).l
02:000006AA 423900FF0604    	   714:     clr.b   ($FF0604).l
02:000006B0 423900FF0605    	   715:     clr.b   ($FF0605).l
02:000006B6 423900FF0607    	   716:     clr.b   ($FF0607).l
02:000006BC 61000676        	   717:     bsr     music_silence
02:000006C0 6024            	   718:     bra.s   .dmc_poll
                            	   719: .no_silence_req:
02:000006C2 103900FFE001    	   720:     move.b  (m_song_req).l,D0
02:000006C8 6710            	   721:     beq.s   .no_req
02:000006CA 423900FFE001    	   722:     clr.b   (m_song_req).l
02:000006D0 13C000FFE000    	   723:     move.b  D0,(m_song).l
02:000006D6 6118            	   724:     bsr     change_song
02:000006D8 600C            	   725:     bra.s   .dmc_poll
                            	   726: .no_req:
02:000006DA 4A3900FFE000    	   727:     tst.b   (m_song).l
02:000006E0 6704            	   728:     beq.s   .dmc_poll
02:000006E2 610001B4        	   729:     bsr     tick_sq1
                            	   730: .dmc_poll:
02:000006E6 6184            	   731:     bsr     dmc_dbg_poll            ; scaffold: Start cycles DMC samples
02:000006E8 6180            	   732:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   733:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   734:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   735:     ; stay wired.
02:000006EA 4CDF07FF        	   736:     movem.l (SP)+,D0-D7/A0-A2
02:000006EE 4E75            	   737:     rts
                            	   738: 
                            	   739: ;==============================================================================
                            	   740: ; change_song — ported from @ChangeSong
                            	   741: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   742: ;
                            	   743: ; Selects the starting phrase index for the new song, then falls into
                            	   744: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   745: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   746: ;==============================================================================
                            	   747: change_song:
02:000006F0 4A00            	   748:     tst.b   D0
02:000006F2 6B46            	   749:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:000006F4 B03C0006        	   750:     cmp.b   #$06,D0
02:000006F8 6610            	   751:     bne.s   .not_zelda
02:000006FA 13FC002400FFE002	   752:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:00000702 610000E0        	   753:     bsr     prep_phrase
02:00000706 60000190        	   754:     bra     tick_sq1
                            	   755: .not_zelda:
02:0000070A B03C0001        	   756:     cmp.b   #$01,D0
02:0000070E 6716            	   757:     beq.s   .first_ow
02:00000710 B03C0040        	   758:     cmp.b   #$40,D0
02:00000714 671A            	   759:     beq.s   .first_uw
02:00000716 B03C0010        	   760:     cmp.b   #$10,D0
02:0000071A 6626            	   761:     bne     play_next_phrase            ; single-phrase song
02:0000071C 13FC001100FFE002	   762:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:00000724 601C            	   763:     bra     play_next_phrase
                            	   764: .first_ow:
02:00000726 13FC000800FFE002	   765:     move.b  #$08,(m_phrase).l
02:0000072E 6012            	   766:     bra     play_next_phrase
                            	   767: .first_uw:
02:00000730 13FC000F00FFE002	   768:     move.b  #$0F,(m_phrase).l
02:00000738 6008            	   769:     bra     play_next_phrase
                            	   770: .first_demo:
02:0000073A 13FC001900FFE002	   771:     move.b  #$19,(m_phrase).l
                            	   772:     bra     play_next_phrase
                            	   773: 
                            	   774: ;==============================================================================
                            	   775: ; play_next_phrase — ported from PlayNextPhrase
                            	   776: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   777: ; calls prep_phrase and falls into tick_sq1.
                            	   778: ;==============================================================================
                            	   779: play_next_phrase:
02:00000742 103900FFE000    	   780:     move.b  (m_song).l,D0
02:00000748 6B78            	   781:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:0000074A B03C0001        	   782:     cmp.b   #$01,D0
02:0000074E 6758            	   783:     beq.s   .next_ow
02:00000750 B03C0040        	   784:     cmp.b   #$40,D0
02:00000754 6738            	   785:     beq.s   .next_uw
02:00000756 B03C0010        	   786:     cmp.b   #$10,D0
02:0000075A 6718            	   787:     beq.s   .next_ending
                            	   788:     ; Single-phrase song: find bit position, phrase = index
02:0000075C 7200            	   789:     moveq   #0,D1
02:0000075E 7400            	   790:     moveq   #0,D2
02:00000760 1400            	   791:     move.b  D0,D2
                            	   792: .bitloop:
02:00000762 5201            	   793:     addq.b  #1,D1
02:00000764 E20A            	   794:     lsr.b   #1,D2
02:00000766 64FA            	   795:     bcc.s   .bitloop
02:00000768 13C100FFE002    	   796:     move.b  D1,(m_phrase).l
02:0000076E 6174            	   797:     bsr     prep_phrase
02:00000770 60000126        	   798:     bra     tick_sq1
                            	   799: .next_ending:
02:00000774 523900FFE002    	   800:     addq.b  #1,(m_phrase).l
02:0000077A 0C39001A00FFE002	   801:     cmpi.b  #$1A,(m_phrase).l
02:00000782 665A            	   802:     bne.s   .prep_and_tick
02:00000784 13FC001400FFE002	   803:     move.b  #$14,(m_phrase).l
02:0000078C 60B4            	   804:     bra     play_next_phrase
                            	   805: .next_uw:
02:0000078E 523900FFE002    	   806:     addq.b  #1,(m_phrase).l
02:00000794 0C39001200FFE002	   807:     cmpi.b  #$12,(m_phrase).l
02:0000079C 6640            	   808:     bne.s   .prep_and_tick
02:0000079E 13FC000F00FFE002	   809:     move.b  #$0F,(m_phrase).l
02:000007A6 609A            	   810:     bra     play_next_phrase
                            	   811: .next_ow:
02:000007A8 523900FFE002    	   812:     addq.b  #1,(m_phrase).l
02:000007AE 0C39001000FFE002	   813:     cmpi.b  #$10,(m_phrase).l
02:000007B6 6626            	   814:     bne.s   .prep_and_tick
02:000007B8 13FC000900FFE002	   815:     move.b  #$09,(m_phrase).l
02:000007C0 6080            	   816:     bra     play_next_phrase
                            	   817: .next_demo:
02:000007C2 523900FFE002    	   818:     addq.b  #1,(m_phrase).l
02:000007C8 0C39002400FFE002	   819:     cmpi.b  #$24,(m_phrase).l
02:000007D0 660C            	   820:     bne.s   .prep_and_tick
02:000007D2 13FC001900FFE002	   821:     move.b  #$19,(m_phrase).l
02:000007DA 6000FF66        	   822:     bra     play_next_phrase
                            	   823: .prep_and_tick:
02:000007DE 6104            	   824:     bsr     prep_phrase
02:000007E0 600000B6        	   825:     bra     tick_sq1
                            	   826: 
                            	   827: ;==============================================================================
                            	   828: ; prep_phrase — ported from PrepPhrase
                            	   829: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   830: ;==============================================================================
                            	   831: prep_phrase:
02:000007E4 43F900000E06    	   832:     lea     (MusicBlob).l,A1
02:000007EA 7200            	   833:     moveq   #0,D1
02:000007EC 123900FFE002    	   834:     move.b  (m_phrase).l,D1
02:000007F2 5341            	   835:     subq.w  #1,D1
02:000007F4 12311000        	   836:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:000007F8 024100FF        	   837:     andi.w  #$FF,D1
                            	   838: 
                            	   839:     ; byte 0: NoteLengthTableBase
02:000007FC 13F1100000FFE003	   840:     move.b  (A1,D1.w),(m_len_base).l
02:00000804 5241            	   841:     addq.w  #1,D1
                            	   842:     ; byte 1: script ptr lo
02:00000806 7400            	   843:     moveq   #0,D2
02:00000808 14311000        	   844:     move.b  (A1,D1.w),D2
02:0000080C 5241            	   845:     addq.w  #1,D1
                            	   846:     ; byte 2: script ptr hi
02:0000080E 7600            	   847:     moveq   #0,D3
02:00000810 16311000        	   848:     move.b  (A1,D1.w),D3
02:00000814 5241            	   849:     addq.w  #1,D1
02:00000816 E14B            	   850:     lsl.w   #8,D3
02:00000818 8642            	   851:     or.w    D2,D3                        ; D3 = NES CPU address
02:0000081A 967C8D60        	   852:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:0000081E 02830000FFFF    	   853:     andi.l  #$FFFF,D3
02:00000824 41F900000E06    	   854:     lea     (MusicBlob).l,A0
02:0000082A D1C3            	   855:     adda.l  D3,A0                        ; A0 = M68K script base
02:0000082C 23C800FFE008    	   856:     move.l  A0,(m_script_ptr).l
                            	   857: 
                            	   858:     ; byte 3: NoteOffsetSongTrg
02:00000832 13F1100000FFE01C	   859:     move.b  (A1,D1.w),(m_trg_off).l
02:0000083A 5241            	   860:     addq.w  #1,D1
                            	   861:     ; byte 4: NoteOffsetSongSq0
02:0000083C 13F1100000FFE014	   862:     move.b  (A1,D1.w),(m_sq0_off).l
02:00000844 5241            	   863:     addq.w  #1,D1
                            	   864:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:00000846 13F1100000FFE024	   865:     move.b  (A1,D1.w),(m_noise_off).l
02:0000084E 13F1100000FFE006	   866:     move.b  (A1,D1.w),(m_noise_first).l
02:00000856 5241            	   867:     addq.w  #1,D1
                            	   868:     ; byte 6: SongEnvelopeSelector
02:00000858 13F1100000FFE004	   869:     move.b  (A1,D1.w),(m_env_sel).l
02:00000860 5241            	   870:     addq.w  #1,D1
                            	   871:     ; byte 7: mystery
02:00000862 13F1100000FFE005	   872:     move.b  (A1,D1.w),(m_mystery).l
                            	   873: 
                            	   874:     ; Reset counters and Sq1 offset
02:0000086A 13FC000100FFE00D	   875:     move.b  #1,(m_sq1_cnt).l
02:00000872 13FC000100FFE015	   876:     move.b  #1,(m_sq0_cnt).l
02:0000087A 13FC000100FFE01D	   877:     move.b  #1,(m_trg_cnt).l
02:00000882 13FC000100FFE025	   878:     move.b  #1,(m_noise_cnt).l
02:0000088A 423900FFE00C    	   879:     clr.b   (m_sq1_off).l
02:00000890 423900FFE021    	   880:     clr.b   (m_trg_rep_n).l
02:00000896 4E75            	   881:     rts
                            	   882: 
                            	   883: ;==============================================================================
                            	   884: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   885: ;==============================================================================
                            	   886: tick_sq1:
02:00000898 533900FFE00D    	   887:     subq.b  #1,(m_sq1_cnt).l
02:0000089E 6600010E        	   888:     bne     tick_sq0                     ; no new note
                            	   889: .read:
02:000008A2 207900FFE008    	   890:     move.l  (m_script_ptr).l,A0
02:000008A8 7200            	   891:     moveq   #0,D1
02:000008AA 123900FFE00C    	   892:     move.b  (m_sq1_off).l,D1
02:000008B0 523900FFE00C    	   893:     addq.b  #1,(m_sq1_off).l
02:000008B6 10301000        	   894:     move.b  (A0,D1.w),D0
02:000008BA 673A            	   895:     beq.s   .song_ended
02:000008BC 4A00            	   896:     tst.b   D0
02:000008BE 6B02            	   897:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:000008C0 6022            	   898:     bra.s   .play_note
                            	   899: .prep_then_note:
02:000008C2 6100027C        	   900:     bsr     get_song_note_length         ; D0 in → D0 length
02:000008C6 13C000FFE00E    	   901:     move.b  D0,(m_sq1_len).l
02:000008CC 207900FFE008    	   902:     move.l  (m_script_ptr).l,A0
02:000008D2 7200            	   903:     moveq   #0,D1
02:000008D4 123900FFE00C    	   904:     move.b  (m_sq1_off).l,D1
02:000008DA 523900FFE00C    	   905:     addq.b  #1,(m_sq1_off).l
02:000008E0 10301000        	   906:     move.b  (A0,D1.w),D0
                            	   907: .play_note:
02:000008E4 61000274        	   908:     bsr     emit_note_sq1                 ; D0 = note id
02:000008E8 13F900FFE00E00FF	   909:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:000008F0 E00D
02:000008F2 600000BA        	   910:     bra     tick_sq0
                            	   911: .song_ended:
02:000008F6 103900FFE000    	   912:     move.b  (m_song).l,D0
02:000008FC 020000F1        	   913:     andi.b  #$F1,D0
02:00000900 6604            	   914:     bne.s   .play_again
02:00000902 60000430        	   915:     bra     music_silence
                            	   916: .play_again:
02:00000906 6102            	   917:     bsr     play_next_phrase_no_tick
02:00000908 6098            	   918:     bra.s   .read
                            	   919: 
                            	   920: ;----------------------------------------------------------------------
                            	   921: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   922: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   923: ; to restart a looping song when $00 opcode is read.
                            	   924: ;----------------------------------------------------------------------
                            	   925: play_next_phrase_no_tick:
02:0000090A 103900FFE000    	   926:     move.b  (m_song).l,D0
02:00000910 6B7E            	   927:     bmi     .nsp_demo
02:00000912 B03C0001        	   928:     cmp.b   #$01,D0
02:00000916 675A            	   929:     beq     .nsp_ow
02:00000918 B03C0040        	   930:     cmp.b   #$40,D0
02:0000091C 6738            	   931:     beq     .nsp_uw
02:0000091E B03C0010        	   932:     cmp.b   #$10,D0
02:00000922 6716            	   933:     beq     .nsp_ending
                            	   934:     ; single-phrase: rebuild phrase from bit
02:00000924 7200            	   935:     moveq   #0,D1
02:00000926 7400            	   936:     moveq   #0,D2
02:00000928 1400            	   937:     move.b  D0,D2
                            	   938: .nsp_loop:
02:0000092A 5201            	   939:     addq.b  #1,D1
02:0000092C E20A            	   940:     lsr.b   #1,D2
02:0000092E 64FA            	   941:     bcc     .nsp_loop
02:00000930 13C100FFE002    	   942:     move.b  D1,(m_phrase).l
02:00000936 6000FEAC        	   943:     bra     prep_phrase
                            	   944: .nsp_ending:
02:0000093A 523900FFE002    	   945:     addq.b  #1,(m_phrase).l
02:00000940 0C39001A00FFE002	   946:     cmpi.b  #$1A,(m_phrase).l
02:00000948 6600FE9A        	   947:     bne     prep_phrase
02:0000094C 13FC001400FFE002	   948:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:00000954 60B4            	   949:     bra     play_next_phrase_no_tick
                            	   950: .nsp_uw:
02:00000956 523900FFE002    	   951:     addq.b  #1,(m_phrase).l
02:0000095C 0C39001200FFE002	   952:     cmpi.b  #$12,(m_phrase).l
02:00000964 6600FE7E        	   953:     bne     prep_phrase
02:00000968 13FC000F00FFE002	   954:     move.b  #$0F,(m_phrase).l
02:00000970 6098            	   955:     bra     play_next_phrase_no_tick
                            	   956: .nsp_ow:
02:00000972 523900FFE002    	   957:     addq.b  #1,(m_phrase).l
02:00000978 0C39001000FFE002	   958:     cmpi.b  #$10,(m_phrase).l
02:00000980 6600FE62        	   959:     bne     prep_phrase
02:00000984 13FC000900FFE002	   960:     move.b  #$09,(m_phrase).l
02:0000098C 6000FF7C        	   961:     bra     play_next_phrase_no_tick
                            	   962: .nsp_demo:
02:00000990 523900FFE002    	   963:     addq.b  #1,(m_phrase).l
02:00000996 0C39002400FFE002	   964:     cmpi.b  #$24,(m_phrase).l
02:0000099E 6600FE44        	   965:     bne     prep_phrase
02:000009A2 13FC001900FFE002	   966:     move.b  #$19,(m_phrase).l
02:000009AA 6000FF5E        	   967:     bra     play_next_phrase_no_tick
                            	   968: 
                            	   969: ;==============================================================================
                            	   970: ; tick_sq0 — Sq0 channel update
                            	   971: ;==============================================================================
                            	   972: tick_sq0:
02:000009AE 4A3900FFE014    	   973:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:000009B4 6754            	   974:     beq     tick_trg
02:000009B6 533900FFE015    	   975:     subq.b  #1,(m_sq0_cnt).l
02:000009BC 664C            	   976:     bne     tick_trg
02:000009BE 207900FFE008    	   977:     move.l  (m_script_ptr).l,A0
02:000009C4 7200            	   978:     moveq   #0,D1
02:000009C6 123900FFE014    	   979:     move.b  (m_sq0_off).l,D1
02:000009CC 523900FFE014    	   980:     addq.b  #1,(m_sq0_off).l
02:000009D2 10301000        	   981:     move.b  (A0,D1.w),D0
02:000009D6 4A00            	   982:     tst.b   D0
02:000009D8 6A22            	   983:     bpl.s   .play
02:000009DA 61000164        	   984:     bsr     get_song_note_length
02:000009DE 13C000FFE016    	   985:     move.b  D0,(m_sq0_len).l
02:000009E4 207900FFE008    	   986:     move.l  (m_script_ptr).l,A0
02:000009EA 7200            	   987:     moveq   #0,D1
02:000009EC 123900FFE014    	   988:     move.b  (m_sq0_off).l,D1
02:000009F2 523900FFE014    	   989:     addq.b  #1,(m_sq0_off).l
02:000009F8 10301000        	   990:     move.b  (A0,D1.w),D0
                            	   991: .play:
02:000009FC 610001BA        	   992:     bsr     emit_note_sq0
02:00000A00 13F900FFE01600FF	   993:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A08 E015
                            	   994:     bra     tick_trg
                            	   995: 
                            	   996: ;==============================================================================
                            	   997: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   998: ;==============================================================================
                            	   999: tick_trg:
02:00000A0A 4A3900FFE01C    	  1000:     tst.b   (m_trg_off).l
02:00000A10 6700009E        	  1001:     beq     tick_noise
02:00000A14 533900FFE01D    	  1002:     subq.b  #1,(m_trg_cnt).l
02:00000A1A 66000094        	  1003:     bne     tick_noise
                            	  1004: .prep_note_or_passage:
02:00000A1E 207900FFE008    	  1005:     move.l  (m_script_ptr).l,A0
02:00000A24 7200            	  1006:     moveq   #0,D1
02:00000A26 123900FFE01C    	  1007:     move.b  (m_trg_off).l,D1
02:00000A2C 523900FFE01C    	  1008:     addq.b  #1,(m_trg_off).l
02:00000A32 10301000        	  1009:     move.b  (A0,D1.w),D0
02:00000A36 676A            	  1010:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000A38 4A00            	  1011:     tst.b   D0
02:00000A3A 6A56            	  1012:     bpl.s   .play_note_trg                ; direct note
02:00000A3C 0C0000F0        	  1013:     cmpi.b  #$F0,D0
02:00000A40 6718            	  1014:     beq.s   .end_of_passage
02:00000A42 652A            	  1015:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1016:     ; $F1-$FF → start passage
02:00000A44 040000F0        	  1017:     subi.b  #$F0,D0
02:00000A48 13C000FFE021    	  1018:     move.b  D0,(m_trg_rep_n).l
02:00000A4E 13F900FFE01C00FF	  1019:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000A56 E022
02:00000A58 60C4            	  1020:     bra.s   .prep_note_or_passage
                            	  1021: .end_of_passage:
02:00000A5A 533900FFE021    	  1022:     subq.b  #1,(m_trg_rep_n).l
02:00000A60 670A            	  1023:     beq.s   .pass_done
02:00000A62 13F900FFE02200FF	  1024:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000A6A E01C
                            	  1025: .pass_done:
02:00000A6C 60B0            	  1026:     bra.s   .prep_note_or_passage
                            	  1027: .prep_note_trg:
02:00000A6E 610000D0        	  1028:     bsr     get_song_note_length
02:00000A72 13C000FFE01E    	  1029:     move.b  D0,(m_trg_len).l
02:00000A78 207900FFE008    	  1030:     move.l  (m_script_ptr).l,A0
02:00000A7E 7200            	  1031:     moveq   #0,D1
02:00000A80 123900FFE01C    	  1032:     move.b  (m_trg_off).l,D1
02:00000A86 523900FFE01C    	  1033:     addq.b  #1,(m_trg_off).l
02:00000A8C 10301000        	  1034:     move.b  (A0,D1.w),D0
02:00000A90 6710            	  1035:     beq.s   .silence_trg
                            	  1036: .play_note_trg:
02:00000A92 61000182        	  1037:     bsr     emit_note_trg
02:00000A96 13F900FFE01E00FF	  1038:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000A9E E01D
02:00000AA0 600E            	  1039:     bra     tick_noise
                            	  1040: .silence_trg:
02:00000AA2 610001E6        	  1041:     bsr     key_off_trg
02:00000AA6 13F900FFE01E00FF	  1042:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AAE E01D
                            	  1043:     bra     tick_noise
                            	  1044: 
                            	  1045: ;==============================================================================
                            	  1046: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1047: ;==============================================================================
                            	  1048: tick_noise:
02:00000AB0 103900FFE000    	  1049:     move.b  (m_song).l,D0
02:00000AB6 02000091        	  1050:     andi.b  #$91,D0
02:00000ABA 67000082        	  1051:     beq     .tn_done
                            	  1052:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1053:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1054:     ; a hit fires below.
02:00000ABE 61000250        	  1055:     bsr     noise_decay_tick
02:00000AC2 533900FFE025    	  1056:     subq.b  #1,(m_noise_cnt).l
02:00000AC8 6674            	  1057:     bne     .tn_done
                            	  1058: .read:
02:00000ACA 207900FFE008    	  1059:     move.l  (m_script_ptr).l,A0
02:00000AD0 7200            	  1060:     moveq   #0,D1
02:00000AD2 123900FFE024    	  1061:     move.b  (m_noise_off).l,D1
02:00000AD8 523900FFE024    	  1062:     addq.b  #1,(m_noise_off).l
02:00000ADE 10301000        	  1063:     move.b  (A0,D1.w),D0
02:00000AE2 660C            	  1064:     bne.s   .got
02:00000AE4 13F900FFE00600FF	  1065:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000AEC E024
02:00000AEE 60DA            	  1066:     bra.s   .read
                            	  1067: .got:
02:00000AF0 1800            	  1068:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1069:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1070:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1071:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1072:     ; (0,7,6). For our port we replicate exactly.
02:00000AF2 7400            	  1073:     moveq   #0,D2
02:00000AF4 1404            	  1074:     move.b  D4,D2
                            	  1075:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000AF6 7000            	  1076:     moveq   #0,D0
02:00000AF8 08020000        	  1077:     btst    #0,D2
02:00000AFC 6704            	  1078:     beq.s   .b0
02:00000AFE 08C00002        	  1079:     bset    #2,D0
                            	  1080: .b0:
02:00000B02 08020007        	  1081:     btst    #7,D2
02:00000B06 6704            	  1082:     beq.s   .b7
02:00000B08 08C00001        	  1083:     bset    #1,D0
                            	  1084: .b7:
02:00000B0C 08020006        	  1085:     btst    #6,D2
02:00000B10 6704            	  1086:     beq.s   .b6
02:00000B12 08C00000        	  1087:     bset    #0,D0
                            	  1088: .b6:
02:00000B16 7200            	  1089:     moveq   #0,D1
02:00000B18 123900FFE003    	  1090:     move.b  (m_len_base).l,D1
02:00000B1E D240            	  1091:     add.w   D0,D1
02:00000B20 43F900000DC2    	  1092:     lea     (NoteLengthTables).l,A1
02:00000B26 13F1100000FFE025	  1093:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1094:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000B2E 1004            	  1095:     move.b  D4,D0
02:00000B30 0200003E        	  1096:     andi.b  #$3E,D0
02:00000B34 E808            	  1097:     lsr.b   #4,D0
02:00000B36 7200            	  1098:     moveq   #0,D1
02:00000B38 1200            	  1099:     move.b  D0,D1
                            	  1100:     ; Map to PSG noise: set volume + period
02:00000B3A 6100015A        	  1101:     bsr     set_psg_noise
                            	  1102: .tn_done:
02:00000B3E 4E75            	  1103:     rts
                            	  1104: 
                            	  1105: ;==============================================================================
                            	  1106: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1107: ; Input: D0 = control byte → Output: D0 = length
                            	  1108: ;==============================================================================
                            	  1109: get_song_note_length:
02:00000B40 02400007        	  1110:     andi.w  #$07,D0
02:00000B44 7200            	  1111:     moveq   #0,D1
02:00000B46 123900FFE003    	  1112:     move.b  (m_len_base).l,D1
02:00000B4C D240            	  1113:     add.w   D0,D1
02:00000B4E 43F900000DC2    	  1114:     lea     (NoteLengthTables).l,A1
02:00000B54 10311000        	  1115:     move.b  (A1,D1.w),D0
02:00000B58 4E75            	  1116:     rts
                            	  1117: 
                            	  1118: ;==============================================================================
                            	  1119: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1120: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1121: ;==============================================================================
                            	  1122: emit_note_sq1:
02:00000B5A 024000FF        	  1123:     andi.w  #$FF,D0
02:00000B5E 43F900000D50    	  1124:     lea     (MusicNotePeriodTable).l,A1
02:00000B64 7400            	  1125:     moveq   #0,D2
02:00000B66 14310001        	  1126:     move.b  1(A1,D0.w),D2                 ; lo
02:00000B6A 67000106        	  1127:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000B6E 7600            	  1128:     moveq   #0,D3
02:00000B70 16310000        	  1129:     move.b  0(A1,D0.w),D3                 ; hi
02:00000B74 E14B            	  1130:     lsl.w   #8,D3
02:00000B76 8642            	  1131:     or.w    D2,D3                          ; D3.w = period
02:00000B78 024307FF        	  1132:     andi.w  #$07FF,D3
02:00000B7C 13C200FFE010    	  1133:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000B82 3403            	  1134:     move.w  D3,D2
02:00000B84 263C00021986    	  1135:     move.l  #NES_YM_K5_PULSE,D3
02:00000B8A 6100F804        	  1136:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1137:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000B8E 103C0028        	  1138:     move.b  #$28,D0
02:00000B92 7200            	  1139:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000B94 6100F7B2        	  1140:     bsr     ym_write1
02:00000B98 103C00A4        	  1141:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000B9C 1202            	  1142:     move.b  D2,D1
02:00000B9E 6100F7A8        	  1143:     bsr     ym_write1
02:00000BA2 103C00A0        	  1144:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000BA6 1203            	  1145:     move.b  D3,D1
02:00000BA8 6100F79E        	  1146:     bsr     ym_write1
                            	  1147:     ; Key on ch 0, all ops
02:00000BAC 103C0028        	  1148:     move.b  #$28,D0
02:00000BB0 123C00F0        	  1149:     move.b  #$F0,D1
02:00000BB4 6000F792        	  1150:     bra     ym_write1
                            	  1151: 
                            	  1152: ;==============================================================================
                            	  1153: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1154: ;==============================================================================
                            	  1155: emit_note_sq0:
02:00000BB8 024000FF        	  1156:     andi.w  #$FF,D0
02:00000BBC 43F900000D50    	  1157:     lea     (MusicNotePeriodTable).l,A1
02:00000BC2 7400            	  1158:     moveq   #0,D2
02:00000BC4 14310001        	  1159:     move.b  1(A1,D0.w),D2
02:00000BC8 670000B4        	  1160:     beq     key_off_sq0
02:00000BCC 7600            	  1161:     moveq   #0,D3
02:00000BCE 16310000        	  1162:     move.b  0(A1,D0.w),D3
02:00000BD2 E14B            	  1163:     lsl.w   #8,D3
02:00000BD4 8642            	  1164:     or.w    D2,D3
02:00000BD6 024307FF        	  1165:     andi.w  #$07FF,D3
02:00000BDA 13C200FFE018    	  1166:     move.b  D2,(m_sq0_per).l
02:00000BE0 3403            	  1167:     move.w  D3,D2
02:00000BE2 263C00021986    	  1168:     move.l  #NES_YM_K5_PULSE,D3
02:00000BE8 6100F7A6        	  1169:     bsr     nes_to_ym_freq
                            	  1170:     ; Key off first so the envelope attack phase retriggers
02:00000BEC 103C0028        	  1171:     move.b  #$28,D0
02:00000BF0 7201            	  1172:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000BF2 6100F754        	  1173:     bsr     ym_write1
02:00000BF6 103C00A5        	  1174:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000BFA 1202            	  1175:     move.b  D2,D1
02:00000BFC 6100F74A        	  1176:     bsr     ym_write1
02:00000C00 103C00A1        	  1177:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C04 1203            	  1178:     move.b  D3,D1
02:00000C06 6100F740        	  1179:     bsr     ym_write1
02:00000C0A 103C0028        	  1180:     move.b  #$28,D0
02:00000C0E 123C00F1        	  1181:     move.b  #$F1,D1
02:00000C12 6000F734        	  1182:     bra     ym_write1
                            	  1183: 
                            	  1184: ;==============================================================================
                            	  1185: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1186: ;==============================================================================
                            	  1187: emit_note_trg:
02:00000C16 024000FF        	  1188:     andi.w  #$FF,D0
02:00000C1A 43F900000D50    	  1189:     lea     (MusicNotePeriodTable).l,A1
02:00000C20 7400            	  1190:     moveq   #0,D2
02:00000C22 14310001        	  1191:     move.b  1(A1,D0.w),D2
02:00000C26 6762            	  1192:     beq     key_off_trg
02:00000C28 7600            	  1193:     moveq   #0,D3
02:00000C2A 16310000        	  1194:     move.b  0(A1,D0.w),D3
02:00000C2E E14B            	  1195:     lsl.w   #8,D3
02:00000C30 8642            	  1196:     or.w    D2,D3
02:00000C32 024307FF        	  1197:     andi.w  #$07FF,D3
02:00000C36 13C200FFE020    	  1198:     move.b  D2,(m_trg_per).l
02:00000C3C 3403            	  1199:     move.w  D3,D2
02:00000C3E 263C00010CC3    	  1200:     move.l  #NES_YM_K5_TRI,D3
02:00000C44 6100F74A        	  1201:     bsr     nes_to_ym_freq
                            	  1202:     ; Key off first so the bass envelope retriggers per note
02:00000C48 103C0028        	  1203:     move.b  #$28,D0
02:00000C4C 7202            	  1204:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000C4E 6100F6F8        	  1205:     bsr     ym_write1
02:00000C52 103C00A6        	  1206:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000C56 1202            	  1207:     move.b  D2,D1
02:00000C58 6100F6EE        	  1208:     bsr     ym_write1
02:00000C5C 103C00A2        	  1209:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000C60 1203            	  1210:     move.b  D3,D1
02:00000C62 6100F6E4        	  1211:     bsr     ym_write1
02:00000C66 103C0028        	  1212:     move.b  #$28,D0
02:00000C6A 123C00F2        	  1213:     move.b  #$F2,D1
02:00000C6E 6000F6D8        	  1214:     bra     ym_write1
                            	  1215: 
                            	  1216: ;==============================================================================
                            	  1217: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1218: ;==============================================================================
                            	  1219: key_off_sq1:
02:00000C72 103C0028        	  1220:     move.b  #$28,D0
02:00000C76 123C0000        	  1221:     move.b  #$00,D1
02:00000C7A 6000F6CC        	  1222:     bra     ym_write1
                            	  1223: key_off_sq0:
02:00000C7E 103C0028        	  1224:     move.b  #$28,D0
02:00000C82 123C0001        	  1225:     move.b  #$01,D1
02:00000C86 6000F6C0        	  1226:     bra     ym_write1
                            	  1227: key_off_trg:
02:00000C8A 103C0028        	  1228:     move.b  #$28,D0
02:00000C8E 123C0002        	  1229:     move.b  #$02,D1
02:00000C92 6000F6B4        	  1230:     bra     ym_write1
                            	  1231: 
                            	  1232: ;==============================================================================
                            	  1233: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1234: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1235: ;
                            	  1236: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1237: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1238: ;     PsgDrumTable.
                            	  1239: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1240: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1241: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1242: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1243: ;     noise_decay_tick.
                            	  1244: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1245: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1246: ;==============================================================================
                            	  1247: set_psg_noise:
                            	  1248:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1249:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1250:     ; music drums resume on the next beat.
02:00000C96 4A3900FF0606    	  1251:     tst.b   ($00FF0606).l
02:00000C9C 661A            	  1252:     bne.s   .sfx_owns_psg
02:00000C9E 4A01            	  1253:     tst.b   D1
02:00000CA0 6618            	  1254:     bne.s   .not_rest
                            	  1255:     ; Rest: silence the PSG noise channel immediately.
02:00000CA2 423900FFE026    	  1256:     clr.b   (m_noise_level).l
02:00000CA8 423900FFE027    	  1257:     clr.b   (m_noise_decay).l
02:00000CAE 13FC00FF00C00011	  1258:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000CB6 4E75            	  1259:     rts
                            	  1260: .sfx_owns_psg:
02:00000CB8 4E75            	  1261:     rts
                            	  1262: .not_rest:
02:00000CBA 7000            	  1263:     moveq   #0,D0
02:00000CBC 1001            	  1264:     move.b  D1,D0
02:00000CBE E548            	  1265:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000CC0 43F900000DF6    	  1266:     lea     (PsgDrumTable).l,A1
02:00000CC6 D3C0            	  1267:     adda.l  D0,A1
02:00000CC8 1019            	  1268:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1269:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000CCA B03900FFE028    	  1270:     cmp.b   (m_last_psg_nc).l,D0
02:00000CD0 670C            	  1271:     beq.s   .nc_same
02:00000CD2 13C000FFE028    	  1272:     move.b  D0,(m_last_psg_nc).l
02:00000CD8 13C000C00011    	  1273:     move.b  D0,(PSG_PORT).l
                            	  1274: .nc_same:
02:00000CDE 1019            	  1275:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000CE0 13C000FFE026    	  1276:     move.b  D0,(m_noise_level).l
02:00000CE6 1019            	  1277:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000CE8 13C000FFE027    	  1278:     move.b  D0,(m_noise_decay).l
                            	  1279:     bra     write_psg_noise_vol
                            	  1280: 
                            	  1281: ;==============================================================================
                            	  1282: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1283: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1284: ; Preserves D1.
                            	  1285: ;==============================================================================
                            	  1286: write_psg_noise_vol:
02:00000CEE 4A3900FF0606    	  1287:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000CF4 6618            	  1288:     bne.s   .wpnv_skip
02:00000CF6 7000            	  1289:     moveq   #0,D0
02:00000CF8 103900FFE026    	  1290:     move.b  (m_noise_level).l,D0
02:00000CFE E808            	  1291:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D00 0A00000F        	  1292:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D04 000000F0        	  1293:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D08 13C000C00011    	  1294:     move.b  D0,(PSG_PORT).l
                            	  1295: .wpnv_skip:
02:00000D0E 4E75            	  1296:     rts
                            	  1297: 
                            	  1298: ;==============================================================================
                            	  1299: ; noise_decay_tick — linear envelope decay step.
                            	  1300: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1301: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1302: ; Preserves D1.
                            	  1303: ;==============================================================================
                            	  1304: noise_decay_tick:
02:00000D10 4A3900FF0606    	  1305:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000D16 661A            	  1306:     bne.s   .nd_done
02:00000D18 103900FFE026    	  1307:     move.b  (m_noise_level).l,D0
02:00000D1E 6712            	  1308:     beq.s   .nd_done                        ; already silent
02:00000D20 903900FFE027    	  1309:     sub.b   (m_noise_decay).l,D0
02:00000D26 6402            	  1310:     bcc.s   .nd_store                       ; no underflow → new level
02:00000D28 7000            	  1311:     moveq   #0,D0                           ; underflow → silent
                            	  1312: .nd_store:
02:00000D2A 13C000FFE026    	  1313:     move.b  D0,(m_noise_level).l
02:00000D30 60BC            	  1314:     bra     write_psg_noise_vol
                            	  1315: .nd_done:
02:00000D32 4E75            	  1316:     rts
                            	  1317: 
                            	  1318: ;==============================================================================
                            	  1319: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1320: ;==============================================================================
                            	  1321: music_silence:
02:00000D34 423900FFE000    	  1322:     clr.b   (m_song).l
02:00000D3A 6100FF36        	  1323:     bsr     key_off_sq1
02:00000D3E 6100FF3E        	  1324:     bsr     key_off_sq0
02:00000D42 6100FF46        	  1325:     bsr     key_off_trg
02:00000D46 13FC00FF00C00011	  1326:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000D4E 4E75            	  1327:     rts
                            	  1328: 
