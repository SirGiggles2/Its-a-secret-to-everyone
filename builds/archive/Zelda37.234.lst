02:00043A96 9101            	  6173:     subx.b  D1,D0   ; SBC $03
02:00043A98 0A3C0010        	  6174:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6175:     ; Call this to put the address of door face tiles in [02:03].
                            	  6176:     ;
02:00043A9C 6100FD7A        	  6177:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6178:     ; Return the address of the door in the nametable in [01:00].
