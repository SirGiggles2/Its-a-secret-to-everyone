                            	  3733: FindNextEdgeSpawnCell:
                            	  3734:     ; Load [0A] with the value before the call.
                            	  3735:     ;
02:00041EB2 102C0525        	  3736:     move.b  ($0525,A4),D0
02:00041EB6 1940000A        	  3737:     move.b  D0,($000A,A4)
                            	  3738:     even
                            	  3739: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3740:     ; Loop to look for a place to spawn a monster from the edge
                            	  3741:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3742:     ;
                            	  3743:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3744:     ; We'll move down $10 pixels.
                            	  3745:     ;
02:00041EBA 7610            	  3746:     moveq   #16,D3
02:00041EBC 102C000A        	  3747:     move.b  ($000A,A4),D0
02:00041EC0 0200000F        	  3748:     andi.b #$0F,D0
02:00041EC4 670A            	  3749:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3750:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3751:     ; Don't move vertically.
                            	  3752:     ;
02:00041EC6 163C00F0        	  3753:     move.b  #$F0,D3
02:00041ECA 0C00000F        	  3754:     cmpi.b  #$0F,D0
02:00041ECE 6610            	  3755:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3756:     even
                            	  3757: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3758:     ; Else low nibble = $F. We're at the right edge,
                            	  3759:     ; and we'll move up $10 pixels.
                            	  3760:     ;
02:00041ED0 1003            	  3761:     move.b  D3,D0
02:00041ED2 023C00EE        	  3762:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041ED6 122C000A        	  3763:     move.b  ($000A,A4),D1
02:00041EDA D101            	  3764:     addx.b  D1,D0   ; ADC $0A
02:00041EDC 1940000A        	  3765:     move.b  D0,($000A,A4)
                            	  3766:     even
                            	  3767: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3768:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3769:     ; Move right one pixel.
                            	  3770:     ;
02:00041EE0 102C000A        	  3771:     move.b  ($000A,A4),D0
02:00041EE4 020000F0        	  3772:     andi.b #$F0,D0
02:00041EE8 0C0000E0        	  3773:     cmpi.b  #$E0,D0
02:00041EEC 6606            	  3774:     bne  _anon_z05_88
02:00041EEE 522C000A        	  3775:     addq.b  #1,($000A,A4)
02:00041EF2 600A            	  3776:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3777: 
                            	  3778: _anon_z05_88:
                            	  3779:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3780:     ; Dont' move horizontally.
                            	  3781:     ;
02:00041EF4 0C000040        	  3782:     cmpi.b  #$40,D0
02:00041EF8 6604            	  3783:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3784:     ; Else high nibble = 4. We're at the top edge.
                            	  3785:     ; Move left 1 pixel.
                            	  3786:     ;
02:00041EFA 532C000A        	  3787:     subq.b  #1,($000A,A4)
                            	  3788:     even
                            	  3789: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3790:     ; Time to get the address of the column.
                            	  3791:     ; Starting at the top of the leftmost column.
                            	  3792:     ;
02:00041EFE 6100268E        	  3793:     jsr     FetchTileMapAddr
02:00041F02 7005            	  3794:     moveq   #5,D0
02:00041F04 4EB90002A9FA    	  3795:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3796:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3797:     ; in order to point to the column we want.
                            	  3798:     ;
02:00041F0A 102C000A        	  3799:     move.b  ($000A,A4),D0
02:00041F0E 0200000F        	  3800:     andi.b #$0F,D0
02:00041F12 7600            	  3801:     moveq   #0,D3
02:00041F14 1600            	  3802:     move.b  D0,D3
02:00041F16 670C            	  3803:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3804: _anon_z05_89:
02:00041F18 702C            	  3805:     moveq   #44,D0
02:00041F1A 4EB900031246    	  3806:     jsr     AddToInt16At0
02:00041F20 5303            	  3807:     subq.b  #1,D3
02:00041F22 66F4            	  3808:     bne  _anon_z05_89
                            	  3809:     even
                            	  3810: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3811:     ; Turn the row part of [0A] into a tile index.
                            	  3812:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3813:     ;
02:00041F24 102C000A        	  3814:     move.b  ($000A,A4),D0
02:00041F28 020000F0        	  3815:     andi.b #$F0,D0
02:00041F2C 003C0011        	  3816:     ori     #$11,CCR  ; SEC: set C+X
02:00041F30 123C0040        	  3817:     move.b  #$40,D1
02:00041F34 0A3C0010        	  3818:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F38 9101            	  3819:     subx.b  D1,D0   ; SBC #$40
02:00041F3A 0A3C0010        	  3820:     eori    #$10,CCR  ; restore X = 6502 C
02:00041F3E E208            	  3821:     lsr.b  #1,D0   ; LSR A
02:00041F40 E208            	  3822:     lsr.b  #1,D0   ; LSR A
02:00041F42 E208            	  3823:     lsr.b  #1,D0   ; LSR A
02:00041F44 7600            	  3824:     moveq   #0,D3
02:00041F46 1600            	  3825:     move.b  D0,D3
                            	  3826:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3827:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3828:     ; when coming in from the edges.
                            	  3829:     ;
02:00041F48 1214            	  3830:     move.b  ($00,A4),D1   ; ptr lo
02:00041F4A 182C0001        	  3831:     move.b  ($01,A4),D4  ; ptr hi
02:00041F4E 024100FF        	  3832:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041F52 E14C            	  3833:     lsl.w   #8,D4
02:00041F54 8841            	  3834:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041F56 48C4            	  3835:     ext.l   D4
02:00041F58 D8BC00FF0000    	  3836:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041F5E 2044            	  3837:     movea.l D4,A0
02:00041F60 10303000        	  3838:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041F64 0C000084        	  3839:     cmpi.b  #$84,D0
02:00041F68 650E            	  3840:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3841:     ; Bottom of the loop.
                            	  3842:     ; If you reach the original cell, then stop.
                            	  3843:     ;
02:00041F6A 102C000A        	  3844:     move.b  ($000A,A4),D0
02:00041F6E 122C0525        	  3845:     move.b  ($0525,A4),D1
02:00041F72 B001            	  3846:     cmp.b   D1,D0
02:00041F74 6600FF44        	  3847:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3848:     even
                            	  3849: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3850:     ; Set the spawn cell to the one we found.
                            	  3851:     ;
02:00041F78 102C000A        	  3852:     move.b  ($000A,A4),D0
02:00041F7C 19400525        	  3853:     move.b  D0,($0525,A4)
02:00041F80 4E75            	  3854:     rts
