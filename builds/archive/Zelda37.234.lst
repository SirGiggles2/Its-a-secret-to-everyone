02:0003D3E0 41EC0098        	  8281:     lea     ($0098,A4),A0
02:0003D3E4 10302000        	  8282:     move.b  (A0,D2.W),D0
02:0003D3E8 02000008        	  8283:     andi.b #$08,D0
02:0003D3EC E208            	  8284:     lsr.b  #1,D0   ; LSR A
02:0003D3EE E208            	  8285:     lsr.b  #1,D0   ; LSR A
02:0003D3F0 023C00EE        	  8286:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D3F4 41EC03E4        	  8287:     lea     ($03E4,A4),A0
02:0003D3F8 12302000        	  8288:     move.b  (A0,D2.W),D1
02:0003D3FC D101            	  8289:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003D3FE 4EF900031940    	  8290:     jmp     DrawObjectMirrored
                            	  8291: 
                            	  8292: ; Description:
                            	  8293: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8294: ; When walking, the object timer is set. When teleporting,
                            	  8295: ; the teleporting distance remaining is set.
                            	  8296: ;
                            	  8297: ; If we have the magic clock, then only go draw and check collisions.
                            	  8298: ;
                            	  8299:     even
                            	  8300: UpdateBlueWizzrobe:
02:0003D404 102C066C        	  8301:     move.b  ($066C,A4),D0
02:0003D408 6702            	  8302:     beq.s  __far_z_04_0070
02:0003D40A 6014            	  8303:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8304: __far_z_04_0070:
02:0003D40C 6116            	  8305:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D40E 61000318        	  8306:     jsr     BlueWizzrobe_TryShooting
                            	  8307:     even
                            	  8308: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8309:     ; If the teleporting distance remaining is even, then draw
                            	  8310:     ; and check collisions, else return.
                            	  8311:     ;
                            	  8312:     ; This means that when 0, the monster is walking.
                            	  8313:     ; So, draw and check collisions every frame.
                            	  8314:     ;
                            	  8315:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8316:     ; translucently -- every other frame.
                            	  8317:     ;
02:0003D412 41EC0394        	  8318:     lea     ($0394,A4),A0
02:0003D416 10302000        	  8319:     move.b  (A0,D2.W),D0
02:0003D41A E208            	  8320:     lsr.b  #1,D0   ; LSR A
02:0003D41C 6402            	  8321:     bcc.s  __far_z_04_0071
02:0003D41E 603A            	  8322:     jmp  L11E17_Exit
                            	  8323: __far_z_04_0071:
                            	  8324:     even
                            	  8325: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D420 600004DE        	  8326:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8327: 
                            	  8328:     even
                            	  8329: BlueWizzrobe_WalkOrTeleport:
                            	  8330:     ; If timer has not expired, then go walk.
                            	  8331:     ;
02:0003D424 10342028        	  8332:     move.b  ($28,A4,D2.W),D0
02:0003D428 661C            	  8333:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8334:     ; Timer = 0. Only teleporting now.
                            	  8335:     ;
                            	  8336:     ; If there is still distance to go while translucent, then
                            	  8337:     ; decrement the distance remaining, and move.
                            	  8338:     ;
02:0003D42A 41EC0394        	  8339:     lea     ($0394,A4),A0
02:0003D42E 10302000        	  8340:     move.b  (A0,D2.W),D0
02:0003D432 670A            	  8341:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D434 41EC0394        	  8342:     lea     ($0394,A4),A0
02:0003D438 53302000        	  8343:     subq.b  #1,(A0,D2.W)
02:0003D43C 602A            	  8344:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8345: 
                            	  8346:     even
                            	  8347: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8348:     ; Distance remaining = 0. Still teleporting.
                            	  8349:     ;
02:0003D43E 6100021A        	  8350:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003D442 600000B0        	  8351:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8352: 
                            	  8353:     even
                            	  8354: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8355:     ; Timer:
                            	  8356:     ;   >= $10: Turn if needed and move every other frame
                            	  8357:     ;   > 1:    Do nothing
