                            	  7345:     ; Shouldn't it be based on the weapon's direction?
                            	  7346:     ;
02:0003243A 102C0098        	  7347:     move.b  ($0098,A4),D0
02:0003243E 0200000C        	  7348:     andi.b #$0C,D0
02:00032442 6726            	  7349:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00032444 10343070        	  7350:     move.b  ($70,A4,D3.W),D0
02:00032448 023C00EE        	  7351:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003244C 123C0006        	  7352:     move.b  #$06,D1
02:00032450 D101            	  7353:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032452 19400004        	  7354:     move.b  D0,($0004,A4)
02:00032456 41EC0084        	  7355:     lea     ($0084,A4),A0
02:0003245A 10303000        	  7356:     move.b  (A0,D3.W),D0
02:0003245E 023C00EE        	  7357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032462 123C0008        	  7358:     move.b  #$08,D1
02:00032466 D101            	  7359:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00032468 6024            	  7360:     jmp     _anon_z01_98
                            	  7361: 
