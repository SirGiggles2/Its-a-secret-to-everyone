02:0004D300 19410525        	  7425:     move.b  D1,($0525,A4)
                            	  7426:     ; Validate fallback cell walkable.
02:0004D304 7600            	  7427:     moveq   #0,D3
02:0004D306 1601            	  7428:     move.b  D1,D3
02:0004D308 0243000F        	  7429:     andi.w  #$000F,D3
02:0004D30C C6FC002C        	  7430:     mulu.w  #44,D3
02:0004D310 203C00FF6530    	  7431:     move.l  #$FF6530,D0
02:0004D316 D083            	  7432:     add.l   D3,D0
02:0004D318 7600            	  7433:     moveq   #0,D3
02:0004D31A 1601            	  7434:     move.b  D1,D3
02:0004D31C E84B            	  7435:     lsr.w   #4,D3
02:0004D31E 5943            	  7436:     subi.w  #4,D3
02:0004D320 E34B            	  7437:     lsl.w   #1,D3
02:0004D322 D083            	  7438:     add.l   D3,D0
02:0004D324 2040            	  7439:     movea.l D0,A0
02:0004D326 0C100084        	  7440:     cmpi.b  #$84,(A0)
02:0004D32A 650E            	  7441:     blo     _L_z07_P47_post2_ok
02:0004D32C 5204            	  7442:     addq.b  #1,D4
02:0004D32E 0C040008        	  7443:     cmpi.b  #8,D4
02:0004D332 65C4            	  7444:     blo     _L_z07_P47_fb_loop
                            	  7445:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7446:     ; rather than looping).
02:0004D334 197C00480525    	  7447:     move.b  #$48,($0525,A4)
                            	  7448: _L_z07_P47_post2_ok:
                            	  7449:     ; Extract and set the monster's location.
                            	  7450:     ;
02:0004D33A 102C0525        	  7451:     move.b  ($0525,A4),D0
                            	  7452:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7453:     ;
02:0004D33E 1B00            	  7454:     move.b  D0,-(A5)  ; PHA
02:0004D340 E308            	  7455:     lsl.b  #1,D0   ; ASL A
02:0004D342 E308            	  7456:     lsl.b  #1,D0   ; ASL A
02:0004D344 E308            	  7457:     lsl.b  #1,D0   ; ASL A
02:0004D346 E308            	  7458:     lsl.b  #1,D0   ; ASL A
02:0004D348 19802070        	  7459:     move.b  D0,($70,A4,D2.W)
                            	  7460:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7461:     ;
02:0004D34C 101D            	  7462:     move.b  (A5)+,D0  ; PLA
02:0004D34E 020000F0        	  7463:     andi.b #$F0,D0
02:0004D352 003C0011        	  7464:     ori     #$11,CCR  ; SEC: set C+X
02:0004D356 123C0003        	  7465:     move.b  #$03,D1
02:0004D35A 0A3C0010        	  7466:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D35E 9101            	  7467:     subx.b  D1,D0   ; SBC #$03
02:0004D360 0A3C0010        	  7468:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D364 41EC0084        	  7469:     lea     ($0084,A4),A0
02:0004D368 11802000        	  7470:     move.b  D0,(A0,D2.W)
                            	  7471:     ; Set the monsters-from-edges long timer to a random value
                            	  7472:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7473:     ;
02:0004D36C 10342019        	  7474:     move.b  ($19,A4,D2.W),D0
02:0004D370 02000003        	  7475:     andi.b #$03,D0
02:0004D374 023C00EE        	  7476:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D378 123C0002        	  7477:     move.b  #$02,D1
02:0004D37C D101            	  7478:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004D37E 1940004B        	  7479:     move.b  D0,($004B,A4)
                            	  7480:     ; If the distance to Link is too close to Link, then
