02:0004452A 1400            	  7288:     move.b  D0,D2
                            	  7289:     ; Align the object's Y coordinate with 16 pixels.
                            	  7290:     ;
02:0004452C 41EC0084        	  7291:     lea     ($0084,A4),A0
