02:0004C6EC 7600            	  5864:     moveq   #0,D3
02:0004C6EE 1600            	  5865:     move.b  D0,D3
02:0004C6F0 7000            	  5866:     moveq   #0,D0
02:0004C6F2 19400001        	  5867:     move.b  D0,($0001,A4)
02:0004C6F6 41F90004C2E4    	  5868:     lea     (BoomerangFrameCycle).l,A0
