02:0003D2C4 41EC03E4        	  8137:     lea     ($03E4,A4),A0
02:0003D2C8 10302000        	  8138:     move.b  (A0,D2.W),D0
02:0003D2CC 6100CC44        	  8139:     jsr     DrawObjectMirroredOverLink
                            	  8140:     ; Check object collisions.
