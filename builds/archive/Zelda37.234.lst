02:0003D22E 102C0070        	  8069:     move.b  ($0070,A4),D0
02:0003D232 19802070        	  8070:     move.b  D0,($70,A4,D2.W)
02:0003D236 102C0084        	  8071:     move.b  ($0084,A4),D0
02:0003D23A 41EC0084        	  8072:     lea     ($0084,A4),A0
02:0003D23E 11802000        	  8073:     move.b  D0,(A0,D2.W)
                            	  8074:     ; Reset Link's timer, metastate, and shove info.
