                            	 12231: __far_z_04_0120:
                            	 12232:     ; State = 0.
                            	 12233:     ;
                            	 12234:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12235:     ; This is the only patra child shown in the first fame.
                            	 12236:     ;
02:0003F10E 0C020002        	 12237:     cmpi.b  #$02,D2
02:0003F112 6732            	 12238:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12239:     ; The patra child in slot 2 is the last one to be updated.
                            	 12240:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12241:     ;
                            	 12242:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12243:     ; shown.
                            	 12244:     ;
02:0003F114 102C00AE        	 12245:     move.b  ($00AE,A4),D0
02:0003F118 6700008E        	 12246:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12247:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12248:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12249:     ;
02:0003F11C 1002            	 12250:     move.b  D2,D0
                            	 12251:     ; Subtract 3 from the object slot to get the angle where the
                            	 12252:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12253:     ;
