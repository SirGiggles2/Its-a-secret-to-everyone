                            	   547: 
                            	   548: ;------------------------------------------------------------------------------
                            	   549: ; _c_move_object_shim — MoveObject trampoline.
                            	   550: ;
                            	   551: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   552: ;   Input:     D2 = slot (0..11)
                            	   553: ;   Preserves: D2, A4, A5
                            	   554: ;   Clobbers:  D0, D1, D3, A0
                            	   555: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   556: ;
                            	   557: ; GCC side:
                            	   558: ;   void c_move_object(unsigned short slot);
                            	   559: ;     slot arrives as a 16-bit value on the stack.
                            	   560: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   561: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   562: ;   never clobbered by gcc.
                            	   563: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   564: ;   semantics can exist in a pure C port).
                            	   565: ;------------------------------------------------------------------------------
                            	   566: _c_move_object_shim:
                            	   567:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   568:     move.b  #$AA,($0900,A4)
                            	   569:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   570:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   571:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   572:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   573:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   574:     moveq   #0,D0
02:0002B658 3002            	   575:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   576:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   577:     jsr     c_move_object
02:0002B662 588F            	   578:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   579:     rts
                            	   580: 
                            	   581: ;==============================================================================
                            	   582: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   583: ; and tail-call the native asm function.
                            	   584: ;
                            	   585: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   586: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   587: ; sign-extended).
                            	   588: ;==============================================================================
                            	   589: 
                            	   590: ;------------------------------------------------------------------------------
                            	   591: ; void c_copy_bank_to_window(unsigned int bank);
                            	   592: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   593: ;------------------------------------------------------------------------------
                            	   594: c_copy_bank_to_window:
02:0002B666 202F0004        	   595:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   596:     jmp     _copy_bank_to_window
                            	   597: 
                            	   598: ;------------------------------------------------------------------------------
                            	   599: ; unsigned char c_ppu_read_2(void);
                            	   600: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   601: ; C return: gcc expects result in D0.
                            	   602: ;------------------------------------------------------------------------------
                            	   603: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   604:     jmp     _ppu_read_2
                            	   605: 
                            	   606: ;------------------------------------------------------------------------------
                            	   607: ; void c_ppu_write_6(unsigned int val);
                            	   608: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   609: ;------------------------------------------------------------------------------
                            	   610: c_ppu_write_6:
02:0002B674 202F0004        	   611:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   612:     jmp     _ppu_write_6
                            	   613: 
                            	   614: ;------------------------------------------------------------------------------
                            	   615: ; void c_ppu_write_7(unsigned int val);
                            	   616: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   617: ;------------------------------------------------------------------------------
                            	   618: c_ppu_write_7:
02:0002B67E 202F0004        	   619:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   620:     jmp     _ppu_write_7
                            	   621: 
                            	   622: ;------------------------------------------------------------------------------
                            	   623: ; void c_turn_off_all_video(void);
                            	   624: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   625: ;------------------------------------------------------------------------------
                            	   626: c_turn_off_all_video:
02:0002B688 4EF90004AA3E    	   627:     jmp     TurnOffAllVideo
                            	   628: 
                            	   629: ;==============================================================================
                            	   630: ; EXPORT side — z_03 entry point.
                            	   631: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   632: ; the transpiler emits that label pointing to this shim instead of the
                            	   633: ; z_03 asm body. The C function takes no args and returns void.
                            	   634: ;==============================================================================
                            	   635: 
                            	   636: ;------------------------------------------------------------------------------
                            	   637: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   638: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   639: ;------------------------------------------------------------------------------
                            	   640: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   641:     jmp     z03_transfer_level_pattern_blocks
                            	   642: 
                            	   643: ;==============================================================================
                            	   644: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   645: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   646: ;==============================================================================
                            	   647: 
                            	   648: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   649:     jmp     z06_init_mode2_submodes
                            	   650: 
                            	   651: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   652:     jmp     z06_copy_common_data_to_ram
                            	   653: 
                            	   654: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   655:     jmp     z06_update_mode2_load_full
                            	   656: 
                            	   657: ;==============================================================================
                            	   658: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   659: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   660: ;==============================================================================
                            	   661: 
                            	   662: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   663:     jmp     z05_copy_column_to_tilebuf
                            	   664: 
                            	   665: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   666:     jmp     z05_copy_row_to_tilebuf
                            	   667: 
                            	   668: ;==============================================================================
                            	   669: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   670: ;==============================================================================
                            	   671: 
                            	   672: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   673: c_has_compass:
02:0002B6B2 4EB900000000    	   674:     jsr     z05_has_compass
02:0002B6B8 4A00            	   675:     tst.b   D0
02:0002B6BA 4E75            	   676:     rts
                            	   677: 
                            	   678: c_has_map:
02:0002B6BC 4EB900000000    	   679:     jsr     z05_has_map
02:0002B6C2 4A00            	   680:     tst.b   D0
02:0002B6C4 4E75            	   681:     rts
                            	   682: 
                            	   683: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   684: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   685:     move.l  D0,-(SP)
02:0002B6C8 7200            	   686:     moveq   #0,D1
02:0002B6CA 1202            	   687:     move.b  D2,D1
02:0002B6CC 2F01            	   688:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   689:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   690:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   691:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   692:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   693:     addq.l  #8,SP
02:0002B6E2 201F            	   694:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   695:     rts
                            	   696: 
