02:0003F1F6 162C045F        	 12360:     move.b  ($045F,A4),D3
                            	 12361:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12362:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12363:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12364:     ;
02:0003F1FA 41EC034F        	 12365:     lea     ($034F,A4),A0
02:0003F1FE 10302000        	 12366:     move.b  (A0,D2.W),D0
02:0003F202 0C000025        	 12367:     cmpi.b  #$25,D0
02:0003F206 661E            	 12368:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F208 41F90003F0FA    	 12369:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F20E 10303000        	 12370:     move.b  (A0,D3.W),D0
02:0003F212 1B00            	 12371:     move.b  D0,-(A5)  ; PHA
02:0003F214 41F90003F0FE    	 12372:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F21A 10303000        	 12373:     move.b  (A0,D3.W),D0
02:0003F21E 7600            	 12374:     moveq   #0,D3
02:0003F220 1600            	 12375:     move.b  D0,D3
02:0003F222 101D            	 12376:     move.b  (A5)+,D0  ; PLA
02:0003F224 600E            	 12377:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12378: 
                            	 12379:     even
                            	 12380: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12381:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12382:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12383:     ; a small circle (5) and a large circle (6).
                            	 12384:     ;
02:0003F226 41F90003F0FC    	 12385:     lea     (PatraChild2RotationBits).l,A0
02:0003F22C 10303000        	 12386:     move.b  (A0,D3.W),D0
02:0003F230 7600            	 12387:     moveq   #0,D3
02:0003F232 1600            	 12388:     move.b  D0,D3
                            	 12389:     even
