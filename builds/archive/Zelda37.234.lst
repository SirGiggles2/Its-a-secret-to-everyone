02:000444F6 1002            	  7260:     move.b  D2,D0
02:000444F8 1B00            	  7261:     move.b  D0,-(A5)  ; PHA
                            	  7262:     ; We're dealing with squares.
                            	  7263:     ; So, align the object's X coordinate with 16 pixels.
                            	  7264:     ;
02:000444FA 10342070        	  7265:     move.b  ($70,A4,D2.W),D0
02:000444FE 020000F0        	  7266:     andi.b #$F0,D0
                            	  7267:     ; Divide it by 4 to get the offset of the address of the column
                            	  7268:     ; in play area map.
                            	  7269:     ;
                            	  7270:     ; The calculation is: address offset = (X / 8) * 2
                            	  7271:     ; 8 for the width of the column; 2 for the width of the address
                            	  7272:     ;
02:00044502 E208            	  7273:     lsr.b  #1,D0   ; LSR A
02:00044504 E208            	  7274:     lsr.b  #1,D0   ; LSR A
02:00044506 7400            	  7275:     moveq   #0,D2
02:00044508 1400            	  7276:     move.b  D0,D2
