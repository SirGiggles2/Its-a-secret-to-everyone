                            	  7910: UpdatePolsVoiceState1_Jumping:
                            	  7911:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7912:     ;
02:0003D0B8 41EC0444        	  7913:     lea     ($0444,A4),A0
02:0003D0BC 10302000        	  7914:     move.b  (A0,D2.W),D0
02:0003D0C0 023C00EE        	  7915:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0C4 123C0038        	  7916:     move.b  #$38,D1
02:0003D0C8 D101            	  7917:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003D0CA 41EC0444        	  7918:     lea     ($0444,A4),A0
02:0003D0CE 11802000        	  7919:     move.b  D0,(A0,D2.W)
                            	  7920:     ; Add Carry to high speed byte (vertical).
                            	  7921:     ;
02:0003D0D2 41EC0412        	  7922:     lea     ($0412,A4),A0
02:0003D0D6 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003D0DA 123C0000        	  7924:     move.b  #$00,D1
02:0003D0DE D101            	  7925:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D0E0 41EC0412        	  7926:     lea     ($0412,A4),A0
02:0003D0E4 11802000        	  7927:     move.b  D0,(A0,D2.W)
                            	  7928:     ; Add high speed byte to Y coordinate.
                            	  7929:     ;
02:0003D0E8 023C00EE        	  7930:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0EC 41EC0084        	  7931:     lea     ($0084,A4),A0
02:0003D0F0 12302000        	  7932:     move.b  (A0,D2.W),D1
02:0003D0F4 D101            	  7933:     addx.b  D1,D0   ; ADC ObjY,X
02:0003D0F6 41EC0084        	  7934:     lea     ($0084,A4),A0
02:0003D0FA 11802000        	  7935:     move.b  D0,(A0,D2.W)
                            	  7936:     ; If the speed is still negative, then return.
                            	  7937:     ;
02:0003D0FE 41EC0412        	  7938:     lea     ($0412,A4),A0
02:0003D102 10302000        	  7939:     move.b  (A0,D2.W),D0
02:0003D106 6B0000AC        	  7940:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7941:     ; If Y coordinate still < target Y, then return.
                            	  7942:     ;
02:0003D10A 41EC0084        	  7943:     lea     ($0084,A4),A0
02:0003D10E 10302000        	  7944:     move.b  (A0,D2.W),D0
02:0003D112 41EC042C        	  7945:     lea     ($042C,A4),A0
02:0003D116 12302000        	  7946:     move.b  (A0,D2.W),D1
02:0003D11A B001            	  7947:     cmp.b   D1,D0
02:0003D11C 65000096        	  7948:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7949:     ; Else reached the destination. Go to state 0.
                            	  7950:     ;
02:0003D120 7000            	  7951:     moveq   #0,D0
02:0003D122 41EC00AC        	  7952:     lea     ($00AC,A4),A0
02:0003D126 11802000        	  7953:     move.b  D0,(A0,D2.W)
                            	  7954:     ; Reset 16-bit vertical speed.
                            	  7955:     ;
02:0003D12A 41EC0444        	  7956:     lea     ($0444,A4),A0
02:0003D12E 11802000        	  7957:     move.b  D0,(A0,D2.W)
02:0003D132 41EC0412        	  7958:     lea     ($0412,A4),A0
02:0003D136 11802000        	  7959:     move.b  D0,(A0,D2.W)
                            	  7960:     ; Choose a random direction to face in.
                            	  7961:     ;
02:0003D13A 10342018        	  7962:     move.b  ($18,A4,D2.W),D0
02:0003D13E 02000003        	  7963:     andi.b #$03,D0
02:0003D142 7600            	  7964:     moveq   #0,D3
02:0003D144 1600            	  7965:     move.b  D0,D3
02:0003D146 41F90003CF56    	  7966:     lea     (PolsVoiceDirections).l,A0
02:0003D14C 10303000        	  7967:     move.b  (A0,D3.W),D0
02:0003D150 41EC0098        	  7968:     lea     ($0098,A4),A0
02:0003D154 11802000        	  7969:     move.b  D0,(A0,D2.W)
                            	  7970:     ; Randomly set distance-to-move to $30 or $70.
                            	  7971:     ;
