                            	  5719: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5720:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5721:     ;
02:00043778 101D            	  5722:     move.b  (A5)+,D0  ; PLA
02:0004377A 1B00            	  5723:     move.b  D0,-(A5)  ; PHA
02:0004377C 7400            	  5724:     moveq   #0,D2
02:0004377E 1400            	  5725:     move.b  D0,D2
                            	  5726:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5727:     ; starting from highest index down to 0:
                            	  5728:     ;
02:00043780 41F90004366E    	  5729:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043786 10302000        	  5730:     move.b  (A0,D2.W),D0
02:0004378A 7400            	  5731:     moveq   #0,D2
02:0004378C 1400            	  5732:     move.b  D0,D2
                            	  5733:     even
                            	  5734: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:0004378E 122C0002        	  5735:     move.b  ($02,A4),D1   ; ptr lo
02:00043792 182C0003        	  5736:     move.b  ($03,A4),D4  ; ptr hi
02:00043796 024100FF        	  5737:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004379A E14C            	  5738:     lsl.w   #8,D4
02:0004379C 8841            	  5739:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004379E 48C4            	  5740:     ext.l   D4
02:000437A0 D8BC00FF0000    	  5741:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000437A6 2044            	  5742:     movea.l D4,A0
02:000437A8 10303000        	  5743:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000437AC 1214            	  5744:     move.b  ($00,A4),D1   ; ptr lo
02:000437AE 182C0001        	  5745:     move.b  ($01,A4),D4  ; ptr hi
02:000437B2 024100FF        	  5746:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000437B6 E14C            	  5747:     lsl.w   #8,D4
02:000437B8 8841            	  5748:     or.w    D1,D4
02:000437BA 48C4            	  5749:     ext.l   D4
02:000437BC D8BC00FF0000    	  5750:     add.l   #NES_RAM,D4
02:000437C2 2044            	  5751:     movea.l D4,A0
02:000437C4 11803000        	  5752:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000437C8 4EB90003124A    	  5753:     jsr     Add1ToInt16At2
02:000437CE 41F900043662    	  5754:     lea     (NextDoorTileOffsets).l,A0
02:000437D4 10302000        	  5755:     move.b  (A0,D2.W),D0
02:000437D8 4EB900031246    	  5756:     jsr     AddToInt16At0
                            	  5757:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5758:     ; go 1 more tile down, to start the next column at the right place.
                            	  5759:     ; We have to compensate for the fact that E/W doors are 
                            	  5760:     ; shorter vertically than N/S doors.
02:000437DE 4A02            	  5761:     cmpi.b  #$00,D2
02:000437E0 6610            	  5762:     bne  _anon_z05_115
02:000437E2 101D            	  5763:     move.b  (A5)+,D0  ; PLA
02:000437E4 1B00            	  5764:     move.b  D0,-(A5)  ; PHA
02:000437E6 0C000002        	  5765:     cmpi.b  #$02,D0
02:000437EA 6406            	  5766:     bcc  _anon_z05_115
02:000437EC 4EB900031244    	  5767:     jsr     Add1ToInt16At0
