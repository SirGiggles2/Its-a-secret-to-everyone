                            	  7895: Submenu_CueTransferRowUW:
                            	  7896:     ; If menu scroll value is negative, then we transferred everything.
                            	  7897:     ; So, return.
                            	  7898:     ;
02:00044C78 102C005E        	  7899:     move.b  ($005E,A4),D0
02:00044C7C 6A02            	  7900:     bpl.s  __far_z_05_0097
02:00044C7E 602E            	  7901:     jmp  L1725A_Exit
                            	  7902: __far_z_05_0097:
                            	  7903:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7904:     ; and represents the current row of the submenu being processed.
                            	  7905:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7906:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7907:     ;
                            	  7908:     ; If the bottom bit is set, go prepare the full black row.
                            	  7909:     ;
02:00044C80 E208            	  7910:     lsr.b  #1,D0   ; LSR A
02:00044C82 7600            	  7911:     moveq   #0,D3
02:00044C84 1600            	  7912:     move.b  D0,D3
02:00044C86 6402            	  7913:     bcc.s  __far_z_05_0098
02:00044C88 6026            	  7914:     jmp  PrepFullBlackRow
                            	  7915: __far_z_05_0098:
                            	  7916:     ; Submenu rows $D to $15 are parts of the map.
                            	  7917:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7918:     ;
                            	  7919:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7920:     ; buffer for this row.
                            	  7921:     ;
02:00044C8A 0C00000D        	  7922:     cmpi.b  #$0D,D0
02:00044C8E 640C            	  7923:     bcc  _anon_z05_167
02:00044C90 41F900044C54    	  7924:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044C96 10303000        	  7925:     move.b  (A0,D3.W),D0
