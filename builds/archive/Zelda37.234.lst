02:00034EF8 4EF90002BADC    	  2533:     jmp     c_mode_e_sync_char_board_cursor
                            	  2534: 
                            	  2535: ModeE_HandleAOrB:
02:00034EFE 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:00034F02 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034F04 7600            	  2540:     moveq   #0,D3
02:00034F06 162C0016        	  2541:     move.b  ($0016,A4),D3
