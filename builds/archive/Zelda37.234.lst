02:0003D3C4 41EC04F0        	  8265:     lea     ($04F0,A4),A0
02:0003D3C8 10302000        	  8266:     move.b  (A0,D2.W),D0
02:0003D3CC 6708            	  8267:     beq  _L_z04_CheckVireCollisions_Exit
02:0003D3CE 41EC00AC        	  8268:     lea     ($00AC,A4),A0
02:0003D3D2 52302000        	  8269:     addq.b  #1,(A0,D2.W)
                            	  8270:     even
                            	  8271: _L_z04_CheckVireCollisions_Exit:
