                            	  3385: _L_z05_CheckSubroom_InCave:
                            	  3386:     ; In a cave.
                            	  3387:     ;
                            	  3388:     ; Check whether a person is blocking the upper half of the room.
                            	  3389:     ;
02:00041C90 1B00            	  3390:     move.b  D0,-(A5)  ; PHA
02:00041C92 4EB900030A72    	  3391:     jsr     CheckPersonBlocking
02:00041C98 101D            	  3392:     move.b  (A5)+,D0  ; PLA
                            	  3393:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3394:     ;
02:00041C9A 0C00000C        	  3395:     cmpi.b  #$0C,D0
02:00041C9E 6704            	  3396:     beq.s  __far_z_05_0060
02:00041CA0 60000082        	  3397:     jmp  CheckCaveEdge
                            	  3398: __far_z_05_0060:
                            	  3399:     ; In a shortcut cave (mode $C).
                            	  3400:     ;
                            	  3401:     ; If grid offset <> 0, return.
                            	  3402:     ;
02:00041CA4 102C0394        	  3403:     move.b  ($0394,A4),D0
02:00041CA8 6702            	  3404:     beq.s  __far_z_05_0061
02:00041CAA 6076            	  3405:     jmp  L14F72_Exit
                            	  3406: __far_z_05_0061:
                            	  3407:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3408:     ;
02:00041CAC 102C0084        	  3409:     move.b  ($0084,A4),D0
02:00041CB0 0C00009D        	  3410:     cmpi.b  #$9D,D0
02:00041CB4 6702            	  3411:     beq.s  __far_z_05_0062
02:00041CB6 606C            	  3412:     jmp  CheckCaveEdge
                            	  3413: __far_z_05_0062:
                            	  3414:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3415:     ; X = $50: 1
                            	  3416:     ; X = $80: 2
                            	  3417:     ; X = $B0: 3
                            	  3418:     ;
                            	  3419:     ; If he's not on any, then return.
                            	  3420:     ;
02:00041CB8 7601            	  3421:     moveq   #1,D3
02:00041CBA 102C0070        	  3422:     move.b  ($0070,A4),D0
02:00041CBE 0C000050        	  3423:     cmpi.b  #$50,D0
02:00041CC2 6712            	  3424:     beq  _anon_z05_83
02:00041CC4 5203            	  3425:     addq.b  #1,D3
02:00041CC6 0C000080        	  3426:     cmpi.b  #$80,D0
02:00041CCA 670A            	  3427:     beq  _anon_z05_83
02:00041CCC 5203            	  3428:     addq.b  #1,D3
02:00041CCE 0C0000B0        	  3429:     cmpi.b  #$B0,D0
02:00041CD2 6702            	  3430:     beq.s  __far_z_05_0063
02:00041CD4 604C            	  3431:     jmp  L14F72_Exit
                            	  3432: __far_z_05_0063:
                            	  3433: _anon_z05_83:
                            	  3434:     ; Look for the current room in the cellar/shortcut room array.
                            	  3435:     ;
02:00041CD6 1883            	  3436:     move.b  D3,($0000,A4)
02:00041CD8 163C00FF        	  3437:     move.b  #$FF,D3
02:00041CDC 102C00EB        	  3438:     move.b  ($00EB,A4),D0
                            	  3439: _anon_z05_84:
02:00041CE0 5203            	  3440:     addq.b  #1,D3
02:00041CE2 41F900FF6BB2    	  3441:     lea     (NES_SRAM+$0BB2).l,A0
02:00041CE8 12303000        	  3442:     move.b  (A0,D3.W),D1
02:00041CEC B001            	  3443:     cmp.b   D1,D0
02:00041CEE 66F0            	  3444:     bne  _anon_z05_84
                            	  3445:     ; Add the value of the shortcut chosen to whatever index
                            	  3446:     ; the current room has in the array.
                            	  3447:     ;
                            	  3448:     ; This yields the index of one of the three shortcut rooms
                            	  3449:     ; after the current one.
                            	  3450:     ;
02:00041CF0 1003            	  3451:     move.b  D3,D0
02:00041CF2 023C00EE        	  3452:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CF6 1214            	  3453:     move.b  ($0000,A4),D1
02:00041CF8 D101            	  3454:     addx.b  D1,D0   ; ADC $00
                            	  3455:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3456:     ;
02:00041CFA 02000003        	  3457:     andi.b #$03,D0
02:00041CFE 7600            	  3458:     moveq   #0,D3
02:00041D00 1600            	  3459:     move.b  D0,D3
02:00041D02 41F900FF6BB2    	  3460:     lea     (NES_SRAM+$0BB2).l,A0
02:00041D08 10303000        	  3461:     move.b  (A0,D3.W),D0
                            	  3462: ; Params:
                            	  3463: ; A: destination room ID
                            	  3464: ;
                            	  3465:     even
                            	  3466: GoToModeAFromCellar:
02:00041D0C 194000EB        	  3467:     move.b  D0,($00EB,A4)
02:00041D10 4EB90004AB9A    	  3468:     jsr     MarkRoomVisited
                            	  3469:     even
                            	  3470: GoToModeAFromCave:
02:00041D16 700A            	  3471:     moveq   #10,D0
02:00041D18 19400012        	  3472:     move.b  D0,($0012,A4)
                            	  3473:     even
                            	  3474: EndPrepareMode:
02:00041D1C 4EF90002C300    	  3475:     jmp     c_end_prepare_mode
                            	  3476: 
