                            	 12518:     ; 3. play level 9 song
                            	 12519:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12520:     ;
02:0003F2FE 194000AC        	 12521:     move.b  D0,($00AC,A4)
02:0003F302 19400505        	 12522:     move.b  D0,($0505,A4)
02:0003F306 7020            	 12523:     moveq   #32,D0
02:0003F308 19400600        	 12524:     move.b  D0,($0600,A4)
02:0003F30C 522C0445        	 12525:     addq.b  #1,($0445,A4)
                            	 12526:     even
