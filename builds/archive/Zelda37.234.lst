                            	  9575: Manhandla_Move:
                            	  9576:     ; Implement a way of manifesting the fractional part of the speed
                            	  9577:     ; in the movement.
                            	  9578:     ;
                            	  9579:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9580:     ; byte to add to the coordinates, then the effective speed would
                            	  9581:     ; be 1 pixel a frame instead of 1.25.
                            	  9582:     ;
                            	  9583:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9584:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9585:     ;
                            	  9586:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9587:     ;
                            	  9588:     ;   SA := SA + (SL AND $E0)
                            	  9589:     ;   [03] := SH + carry
                            	  9590:     ;
                            	  9591:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9592:     ;
02:0003DD40 41EC041F        	  9593:     lea     ($041F,A4),A0
02:0003DD44 10302000        	  9594:     move.b  (A0,D2.W),D0
02:0003DD48 020000E0        	  9595:     andi.b #$E0,D0
02:0003DD4C 023C00EE        	  9596:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD50 41EC0412        	  9597:     lea     ($0412,A4),A0
02:0003DD54 12302000        	  9598:     move.b  (A0,D2.W),D1
02:0003DD58 D101            	  9599:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DD5A 41EC0412        	  9600:     lea     ($0412,A4),A0
02:0003DD5E 11802000        	  9601:     move.b  D0,(A0,D2.W)
                            	  9602:     ; Assign (high speed byte + carry) to [03].
                            	  9603:     ;
02:0003DD62 41EC042C        	  9604:     lea     ($042C,A4),A0
02:0003DD66 10302000        	  9605:     move.b  (A0,D2.W),D0
02:0003DD6A 123C0000        	  9606:     move.b  #$00,D1
02:0003DD6E D101            	  9607:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DD70 19400003        	  9608:     move.b  D0,($0003,A4)
                            	  9609:     ; Change coordinates by the speed amount/offset in [03]
                            	  9610:     ; according to the direction.
                            	  9611:     ;
                            	  9612:     ; Start with a mask of $A1 in [02]:
                            	  9613:     ; - low nibble represents the right direction
                            	  9614:     ; - high nibble is used to set or clear carry as we go along
                            	  9615:     ;
02:0003DD74 103C00A1        	  9616:     move.b  #$A1,D0
02:0003DD78 19400002        	  9617:     move.b  D0,($0002,A4)
                            	  9618:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9619:     ;
02:0003DD7C 41EC0098        	  9620:     lea     ($0098,A4),A0
02:0003DD80 10302000        	  9621:     move.b  (A0,D2.W),D0
02:0003DD84 122C0002        	  9622:     move.b  ($0002,A4),D1
02:0003DD88 C200            	  9623:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD8A 6712            	  9624:     beq  _L_z04_Manhandla_Move_Left
02:0003DD8C 10342070        	  9625:     move.b  ($70,A4,D2.W),D0
02:0003DD90 023C00EE        	  9626:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD94 122C0003        	  9627:     move.b  ($0003,A4),D1
02:0003DD98 D101            	  9628:     addx.b  D1,D0   ; ADC $03
02:0003DD9A 19802070        	  9629:     move.b  D0,($70,A4,D2.W)
                            	  9630:     even
                            	  9631: _L_z04_Manhandla_Move_Left:
                            	  9632:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9633:     ;
02:0003DD9E 41EC0098        	  9634:     lea     ($0098,A4),A0
02:0003DDA2 10302000        	  9635:     move.b  (A0,D2.W),D0
02:0003DDA6 122C0002        	  9636:     move.b  ($0002,A4),D1
02:0003DDAA E309            	  9637:     lsl.b  #1,D1   ; ASL $02
02:0003DDAC 19410002        	  9638:     move.b  D1,($0002,A4)
02:0003DDB0 122C0002        	  9639:     move.b  ($0002,A4),D1
02:0003DDB4 C200            	  9640:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DDB6 6716            	  9641:     beq  _L_z04_Manhandla_Move_Down
02:0003DDB8 10342070        	  9642:     move.b  ($70,A4,D2.W),D0
02:0003DDBC 122C0003        	  9643:     move.b  ($0003,A4),D1
02:0003DDC0 0A3C0010        	  9644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DDC4 9101            	  9645:     subx.b  D1,D0   ; SBC $03
02:0003DDC6 0A3C0010        	  9646:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DDCA 19802070        	  9647:     move.b  D0,($70,A4,D2.W)
