                            	  7771:     ; Decrement grid offset / distance remaining.
                            	  7772:     ;
02:0003CF98 41EC0394        	  7773:     lea     ($0394,A4),A0
02:0003CF9C 53302000        	  7774:     subq.b  #1,(A0,D2.W)
                            	  7775:     ; Move vertically.
