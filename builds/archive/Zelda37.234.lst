02:00041C66 1600            	  3369:     move.b  D0,D3
02:00041C68 41F900FF697E    	  3370:     lea     (NES_SRAM+$097E).l,A0
02:00041C6E 10303000        	  3371:     move.b  (A0,D3.W),D0
02:00041C72 1B00            	  3372:     move.b  D0,-(A5)  ; PHA
02:00041C74 020000F0        	  3373:     andi.b #$F0,D0
02:00041C78 19400070        	  3374:     move.b  D0,($0070,A4)
02:00041C7C 101D            	  3375:     move.b  (A5)+,D0  ; PLA
02:00041C7E E308            	  3376:     lsl.b  #1,D0   ; ASL A
02:00041C80 E308            	  3377:     lsl.b  #1,D0   ; ASL A
02:00041C82 E308            	  3378:     lsl.b  #1,D0   ; ASL A
02:00041C84 E308            	  3379:     lsl.b  #1,D0   ; ASL A
02:00041C86 0000000D        	  3380:     ori.b #$0D,D0
02:00041C8A 19400084        	  3381:     move.b  D0,($0084,A4)
