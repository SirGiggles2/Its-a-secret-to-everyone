02:00031002 102C0098        	  4589:     move.b  ($0098,A4),D0
02:00031006 E208            	  4590:     lsr.b  #1,D0   ; LSR A
02:00031008 E208            	  4591:     lsr.b  #1,D0   ; LSR A
02:0003100A 6110            	  4592:     jsr     ChooseOffsetForDirectionH
02:0003100C 122C0084        	  4593:     move.b  ($0084,A4),D1
02:00031010 D101            	  4594:     addx.b  D1,D0   ; ADC ObjY
02:00031012 41EC0084        	  4595:     lea     ($0084,A4),A0
