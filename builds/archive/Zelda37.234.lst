02:0004C512 1940000F        	  5607:     move.b  D0,($000F,A4)
                            	  5608:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5609:     ; and go draw.
                            	  5610:     ;
02:0004C516 41EC0098        	  5611:     lea     ($0098,A4),A0
02:0004C51A 10302000        	  5612:     move.b  (A0,D2.W),D0
