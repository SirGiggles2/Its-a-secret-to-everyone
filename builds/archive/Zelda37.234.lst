                            	  4993:     ; to make a fire. In this case, all that's left to do is to go
                            	  4994:     ; deactivate the shot object.
                            	  4995:     ;
02:0004C0E6 41EC00AC        	  4996:     lea     ($00AC,A4),A0
02:0004C0EA 10302000        	  4997:     move.b  (A0,D2.W),D0
02:0004C0EE 0C000021        	  4998:     cmpi.b  #$21,D0
02:0004C0F2 6702            	  4999:     beq.s  __far_z_07_0077
