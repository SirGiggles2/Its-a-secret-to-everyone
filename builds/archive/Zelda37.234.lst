02:0003D282 6612            	  8106:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003D284 E308            	  8107:     lsl.b  #1,D0   ; ASL A
02:0003D286 41EC03D0        	  8108:     lea     ($03D0,A4),A0
