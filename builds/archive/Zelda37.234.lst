                            	  5212: _anon_z04_70:
                            	  5213:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5214:     ; 1. negate the distance
                            	  5215:     ; 2. add 8 to the instruction offset to access
                            	  5216:     ;    the opposite direction for the same wall
                            	  5217:     ;
02:0003BD0E 7600            	  5218:     moveq   #0,D3
02:0003BD10 162C0098        	  5219:     move.b  ($0098,A4),D3
02:0003BD14 122C0002        	  5220:     move.b  ($0002,A4),D1
02:0003BD18 B601            	  5221:     cmp.b   D1,D3
02:0003BD1A 662A            	  5222:     bne  _anon_z04_71
02:0003BD1C 1B00            	  5223:     move.b  D0,-(A5)  ; PHA
02:0003BD1E 41EC0412        	  5224:     lea     ($0412,A4),A0
02:0003BD22 10302000        	  5225:     move.b  (A0,D2.W),D0
02:0003BD26 023C00EE        	  5226:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD2A 123C0008        	  5227:     move.b  #$08,D1
02:0003BD2E D101            	  5228:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BD30 41EC0412        	  5229:     lea     ($0412,A4),A0
02:0003BD34 11802000        	  5230:     move.b  D0,(A0,D2.W)
02:0003BD38 101D            	  5231:     move.b  (A5)+,D0  ; PLA
02:0003BD3A 4600            	  5232:     eori.b #$FF,D0
02:0003BD3C 023C00EE        	  5233:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD40 123C0001        	  5234:     move.b  #$01,D1
02:0003BD44 D101            	  5235:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5236: _anon_z04_71:
                            	  5237:     ; Add the distance and Link's minor coordinate to calculate
                            	  5238:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5239:     ; In general, the monster will be put in front of Link.
                            	  5240:     ;
02:0003BD46 023C00EE        	  5241:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD4A 1214            	  5242:     move.b  ($0000,A4),D1
02:0003BD4C D101            	  5243:     addx.b  D1,D0   ; ADC $00
02:0003BD4E 19400004        	  5244:     move.b  D0,($0004,A4)
                            	  5245:     ; By default, will return index 0 to choose the minimum value
                            	  5246:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5247:     ; if Link is at the wall with a smaller major coordinate.
                            	  5248:     ;
02:0003BD52 7600            	  5249:     moveq   #0,D3
                            	  5250:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5251:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5252:     ; to access the block for the other direction along the same axis,
                            	  5253:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5254:     ;
02:0003BD54 102C0001        	  5255:     move.b  ($0001,A4),D0
02:0003BD58 122C0003        	  5256:     move.b  ($0003,A4),D1
02:0003BD5C B001            	  5257:     cmp.b   D1,D0
02:0003BD5E 671C            	  5258:     beq  _anon_z04_72
02:0003BD60 41EC0412        	  5259:     lea     ($0412,A4),A0
02:0003BD64 10302000        	  5260:     move.b  (A0,D2.W),D0
02:0003BD68 023C00EE        	  5261:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD6C 123C0010        	  5262:     move.b  #$10,D1
02:0003BD70 D101            	  5263:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BD72 41EC0412        	  5264:     lea     ($0412,A4),A0
02:0003BD76 11802000        	  5265:     move.b  D0,(A0,D2.W)
02:0003BD7A 5203            	  5266:     addq.b  #1,D3
