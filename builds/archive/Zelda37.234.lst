                            	  8275: DrawVire:
02:0003D3D8 700A            	  8276:     moveq   #10,D0
02:0003D3DA 4EB90004CE44    	  8277:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  8278:     ; The movement frame is the fram image number, unless facing up.
                            	  8279:     ; In this case, add 2 to the frame image.
