02:0002BFAA 08000008        	  2110:     btst    #8,D0
02:0002BFAE 670A            	  2111:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2112:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2113:     eori    #$01,CCR
02:0002BFB8 4E75            	  2114:     rts
                            	  2115: .cc_cnras:
02:0002BFBA 023C00FE        	  2116:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2117:     eori    #$01,CCR
02:0002BFC2 4E75            	  2118:     rts
                            	  2119: 
