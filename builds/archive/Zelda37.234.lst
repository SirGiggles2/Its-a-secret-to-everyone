02:0003CA3C 19802070        	  6973:     move.b  D0,($70,A4,D2.W)
                            	  6974:     ; If X coordinate < $20, then face right.
                            	  6975:     ;
02:0003CA40 0C000020        	  6976:     cmpi.b  #$20,D0
02:0003CA44 640A            	  6977:     bcc  _anon_z04_89
