02:0003E71E 1B00            	 10884:     move.b  D0,-(A5)  ; PHA
                            	 10885:     ; To calculate the base offset of the sprite record:
                            	 10886:     ; offset := neck index * 8
                            	 10887:     ;
                            	 10888:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 10889:     ; at an even index.
                            	 10890:     ;
02:0003E720 102C04D7        	 10891:     move.b  ($04D7,A4),D0
02:0003E724 E308            	 10892:     lsl.b  #1,D0   ; ASL A
02:0003E726 E308            	 10893:     lsl.b  #1,D0   ; ASL A
02:0003E728 E308            	 10894:     lsl.b  #1,D0   ; ASL A
                            	 10895:     ; But if the segment is not a head (not at object slot 5), then
                            	 10896:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 10897:     ;
02:0003E72A 0C020005        	 10898:     cmpi.b  #$05,D2
02:0003E72E 670A            	 10899:     beq  _anon_z04_139
