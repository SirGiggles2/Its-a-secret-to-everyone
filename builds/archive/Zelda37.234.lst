                            	  4653: 
                            	  4654: ; Params:
                            	  4655: ; [02:03]: address of door tiles for direction and face
                            	  4656: ; [04]: count of tiles remaining
                            	  4657: ; [07]: current index (0 to 3) of the tile to copy
                            	  4658: ;       to the dynamic transfer buf
                            	  4659: ; [09]: door direction index
                            	  4660: ;
                            	  4661: ; Returns:
                            	  4662: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4663: ; [04]: original value - 1
                            	  4664: ; [07]: original value + 1
                            	  4665: ;
                            	  4666: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4667: ; vertically. The point of this routine is to access them
                            	  4668: ; horizontally in order to transfer them to a nametable.
                            	  4669: ;
                            	  4670: ;
                            	  4671: ; For the direction index in [09], look up the base offset of the
                            	  4672: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4673: ; the door face tiles at [02:03].
                            	  4674: ;
                            	  4675:     even
                            	  4676: WriteDoorFaceTileHorizontally:
02:0004264E 7600            	  4677:     moveq   #0,D3
02:00042650 162C0009        	  4678:     move.b  ($0009,A4),D3
02:00042654 41F900043872    	  4679:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0004265A 10303000        	  4680:     move.b  (A0,D3.W),D0
                            	  4681:     ; Add [07] to the base offset we got above. This yields one
                            	  4682:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4683:     ;
02:0004265E 023C00EE        	  4684:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042662 122C0007        	  4685:     move.b  ($0007,A4),D1
02:00042666 D101            	  4686:     addx.b  D1,D0   ; ADC $07
02:00042668 7600            	  4687:     moveq   #0,D3
02:0004266A 1600            	  4688:     move.b  D0,D3
                            	  4689:     ; With that index, look up the index to use with the door face
                            	  4690:     ; list of tiles at [02:03].
                            	  4691:     ;
02:0004266C 41F900043864    	  4692:     lea     (HorizontalDoorFaceIndexes).l,A0
02:00042672 10303000        	  4693:     move.b  (A0,D3.W),D0
02:00042676 7600            	  4694:     moveq   #0,D3
02:00042678 1600            	  4695:     move.b  D0,D3
                            	  4696:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4697:     ; and copy it to the dynamic transfer buf.
                            	  4698:     ;
02:0004267A 122C0002        	  4699:     move.b  ($02,A4),D1   ; ptr lo
02:0004267E 182C0003        	  4700:     move.b  ($03,A4),D4  ; ptr hi
02:00042682 024100FF        	  4701:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042686 E14C            	  4702:     lsl.w   #8,D4
02:00042688 8841            	  4703:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004268A 48C4            	  4704:     ext.l   D4
02:0004268C D8BC00FF0000    	  4705:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042692 2044            	  4706:     movea.l D4,A0
02:00042694 10303000        	  4707:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042698 41EC0302        	  4708:     lea     ($0302,A4),A0
02:0004269C 11802000        	  4709:     move.b  D0,(A0,D2.W)
                            	  4710:     ; Prepare for the next call:
                            	  4711:     ; - increment dynamic transfer buf pointer
                            	  4712:     ; - increment index of tile to copy [07]
                            	  4713:     ; - decrement count of tiles remaining
                            	  4714:     ;
02:000426A0 5202            	  4715:     addq.b  #1,D2
02:000426A2 522C0007        	  4716:     addq.b  #1,($0007,A4)
02:000426A6 532C0004        	  4717:     subq.b  #1,($0004,A4)
02:000426AA 4E75            	  4718:     rts
                            	  4719: 
                            	  4720:     even
