                            	  8159: _anon_z05_174:
                            	  8160:     ; Two input directions, and at least one of them is walkable.
                            	  8161:     ;
                            	  8162:     ; Make Link go straight in one direction on the next grid line.
                            	  8163:     ;
02:00044DDA 7600            	  8164:     moveq   #0,D3
02:00044DDC 1600            	  8165:     move.b  D0,D3
02:00044DDE 522C0057        	  8166:     addq.b  #1,($0057,A4)
                            	  8167:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8168:     ; object direction and input direction to last walkable direction
                            	  8169:     ; found, and set Link's speed.
                            	  8170:     ;
                            	  8171:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8172:     ;
02:00044DE2 7400            	  8173:     moveq   #0,D2
02:00044DE4 102C000D        	  8174:     move.b  ($000D,A4),D0
02:00044DE8 0C030001        	  8175:     cmpi.b  #$01,D3
02:00044DEC 67000096        	  8176:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
