02:0003CEDE 7008            	  7666:     moveq   #8,D0
02:0003CEE0 4EB90004CE44    	  7667:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7668:     ; If facing left, then enable horizontal flipping.
                            	  7669:     ;
02:0003CEE6 41EC0098        	  7670:     lea     ($0098,A4),A0
02:0003CEEA 10302000        	  7671:     move.b  (A0,D2.W),D0
02:0003CEEE 0C000002        	  7672:     cmpi.b  #$02,D0
02:0003CEF2 6604            	  7673:     bne  _anon_z04_94
02:0003CEF4 522C000F        	  7674:     addq.b  #1,($000F,A4)
                            	  7675: _anon_z04_94:
                            	  7676:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7677:     ; This is the base frame image.
                            	  7678:     ;
02:0003CEF8 E208            	  7679:     lsr.b  #1,D0   ; LSR A
02:0003CEFA E208            	  7680:     lsr.b  #1,D0   ; LSR A
                            	  7681:     ; If movement frame = 1, add 3 to frame image to access
                            	  7682:     ; the second animation frame's images.
                            	  7683:     ;
02:0003CEFC 7600            	  7684:     moveq   #0,D3
02:0003CEFE 41EC03E4        	  7685:     lea     ($03E4,A4),A0
02:0003CF02 16302000        	  7686:     move.b  (A0,D2.W),D3
02:0003CF06 671E            	  7687:     beq  _anon_z04_95
02:0003CF08 023C00EE        	  7688:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF0C 123C0003        	  7689:     move.b  #$03,D1
02:0003CF10 D101            	  7690:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7691:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7692:     ;
                            	  7693:     ; Down has two frame images, but up only has one. By flipping
                            	  7694:     ; horizontally, you get two frame images.
                            	  7695:     ;
02:0003CF12 7600            	  7696:     moveq   #0,D3
02:0003CF14 41EC0098        	  7697:     lea     ($0098,A4),A0
02:0003CF18 16302000        	  7698:     move.b  (A0,D2.W),D3
02:0003CF1C 0C030008        	  7699:     cmpi.b  #$08,D3
02:0003CF20 6604            	  7700:     bne  _anon_z04_95
02:0003CF22 522C000F        	  7701:     addq.b  #1,($000F,A4)
