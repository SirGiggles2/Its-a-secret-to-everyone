02:00041C38 66F0            	  3342:     bne  _anon_z05_81
                            	  3343:     ; Determine the destination room ID, and go there.
                            	  3344:     ;
                            	  3345:     ; If Link's X < $80 look in level block attributes A, else B.
                            	  3346:     ;
                            	  3347:     ; Note that in cellars, level block attributes A and B indicate
                            	  3348:     ; the destination room ID only.
                            	  3349:     ;
02:00041C3A 7600            	  3350:     moveq   #0,D3
02:00041C3C 1600            	  3351:     move.b  D0,D3
02:00041C3E 102C0070        	  3352:     move.b  ($0070,A4),D0
02:00041C42 0C000080        	  3353:     cmpi.b  #$80,D0
02:00041C46 640C            	  3354:     bcc  _L_z05_CheckSubroom_GetRightSideRoom
02:00041C48 41F900FF687E    	  3355:     lea     (NES_SRAM+$087E).l,A0
02:00041C4E 10303000        	  3356:     move.b  (A0,D3.W),D0
02:00041C52 600A            	  3357:     jmp     _anon_z05_82
                            	  3358: 
