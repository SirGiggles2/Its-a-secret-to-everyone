                            	   229:     ; So, if the item was not taken, then go set up the text.
                            	   230:     ;
02:0002E22E 610030BC        	   231:     jsr     GetRoomFlagUWItemState
02:0002E232 6602            	   232:     bne.s  __far_z_01_0001
02:0002E234 600A            	   233:     jmp  InitCaveContinue
                            	   234: __far_z_01_0001:
                            	   235:     ; Otherwise destroy the person object, and let Link continue.
                            	   236:     ;
02:0002E236 7000            	   237:     moveq   #0,D0
02:0002E238 19400350        	   238:     move.b  D0,($0350,A4)
                            	   239:     even
                            	   240: UnhaltLink:
02:0002E23C 6000D7B0        	   241:     jmp     c_unhalt_link
                            	   242: 
                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002E240 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002E244 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E248 123C006A        	   248:     move.b  #$6A,D1
02:0002E24C 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E250 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E252 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E256 7600            	   252:     moveq   #0,D3
02:0002E258 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E25A 41F90002E1D8    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E260 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E264 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E266 0200003F        	   260:     andi.b #$3F,D0
02:0002E26A 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E26E 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E270 020000C0        	   266:     andi.b #$C0,D0
02:0002E274 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
                            	   269:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   270:     ;
02:0002E278 103C00FD        	   271:     move.b  #$FD,D0
                            	   272: _anon_z01_0:
02:0002E27C 023C00EE        	   273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E280 123C0003        	   274:     move.b  #$03,D1
02:0002E284 D101            	   275:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E286 5303            	   276:     subq.b  #1,D3
02:0002E288 6AF2            	   277:     bpl  _anon_z01_0
02:0002E28A 7600            	   278:     moveq   #0,D3
02:0002E28C 1600            	   279:     move.b  D0,D3
                            	   280:     ; Loop over the wares from 0 to 2.
                            	   281:     ;
02:0002E28E 7400            	   282:     moveq   #0,D2
                            	   283:     even
                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E290 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E296 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E29A 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E29E 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E2A2 020000C0        	   294:     andi.b #$C0,D0
02:0002E2A6 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E2AA 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E2B0 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E2B4 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E2B8 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E2BC 5203            	   304:     addq.b  #1,D3
02:0002E2BE 5202            	   305:     addq.b  #1,D2
02:0002E2C0 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E2C4 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E2C6 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E2CA E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E2CC E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E2CE E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E2D0 1214            	   315:     move.b  ($0000,A4),D1
02:0002E2D2 8001            	   316:     or.b  D1,D0
02:0002E2D4 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E2D6 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E2DA E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E2DC E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E2DE E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E2E0 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E2E2 1214            	   326:     move.b  ($0000,A4),D1
02:0002E2E4 8001            	   327:     or.b  D1,D0
02:0002E2E6 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E2E8 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E2EC E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E2EE E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E2F0 1214            	   335:     move.b  ($0000,A4),D1
02:0002E2F2 8001            	   336:     or.b  D1,D0
02:0002E2F4 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E2F8 02000020        	   343:     andi.b #$20,D0
02:0002E2FC 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E300 103C00FF        	   350:     move.b  #$FF,D0
02:0002E304 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E306 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E30A B001            	   355:     cmp.b   D1,D0
02:0002E30C 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E30E 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E312 123C002B        	   360:     move.b  #$2B,D1
02:0002E316 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E31A 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E31C 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E320 5303            	   364:     subq.b  #1,D3
02:0002E322 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_FoundPermutation:
                            	   368:     ; The index chooses the last offset of a permutation of three indexes.
                            	   369:     ;
02:0002E324 7400            	   370:     moveq   #0,D2
02:0002E326 41F90002E200    	   371:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E32C 14303000        	   372:     move.b  (A0,D3.W),D2
                            	   373:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   374:     ;
02:0002E330 7602            	   375:     moveq   #2,D3
                            	   376:     even
                            	   377: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E332 41F90002E1EE    	   378:     lea     (MoneyGamePermutations).l,A0
02:0002E338 10302000        	   379:     move.b  (A0,D2.W),D0
02:0002E33C 41EC046C        	   380:     lea     ($046C,A4),A0
02:0002E340 11803000        	   381:     move.b  D0,(A0,D3.W)
02:0002E344 5302            	   382:     subq.b  #1,D2
02:0002E346 5303            	   383:     subq.b  #1,D3
02:0002E348 6AE8            	   384:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   385:     ; With the first bit of another random number, choose 10 or 40
                            	   386:     ; to put in [046F]. This is a random amount to lose.
                            	   387:     ;
02:0002E34A 102C001A        	   388:     move.b  ($001A,A4),D0
02:0002E34E 02000001        	   389:     andi.b #$01,D0
02:0002E352 7600            	   390:     moveq   #0,D3
02:0002E354 1600            	   391:     move.b  D0,D3
02:0002E356 41F90002E1EC    	   392:     lea     (MoneyGameLossAmounts).l,A0
02:0002E35C 10303000        	   393:     move.b  (A0,D3.W),D0
02:0002E360 1940046F        	   394:     move.b  D0,($046F,A4)
                            	   395:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   396:     ;
02:0002E364 700A            	   397:     moveq   #10,D0
02:0002E366 19400470        	   398:     move.b  D0,($0470,A4)
                            	   399:     ; With a different bit of the second random number,
                            	   400:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   401:     ;
02:0002E36A 7614            	   402:     moveq   #20,D3
02:0002E36C 102C001A        	   403:     move.b  ($001A,A4),D0
02:0002E370 02000002        	   404:     andi.b #$02,D0
02:0002E374 6702            	   405:     beq  _anon_z01_1
02:0002E376 7632            	   406:     moveq   #50,D3
                            	   407: _anon_z01_1:
02:0002E378 19430471        	   408:     move.b  D3,($0471,A4)
                            	   409:     ; The 3 amounts are now in [046F] to [0471].
                            	   410:     ; Reference these amounts using the permutation of indexes
                            	   411:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   412:     ;
02:0002E37C 7402            	   413:     moveq   #2,D2
                            	   414:     even
                            	   415: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E37E 7600            	   416:     moveq   #0,D3
02:0002E380 41EC046C        	   417:     lea     ($046C,A4),A0
02:0002E384 16302000        	   418:     move.b  (A0,D2.W),D3
02:0002E388 41EC046F        	   419:     lea     ($046F,A4),A0
02:0002E38C 10303000        	   420:     move.b  (A0,D3.W),D0
02:0002E390 41EC0448        	   421:     lea     ($0448,A4),A0
02:0002E394 11802000        	   422:     move.b  D0,(A0,D2.W)
02:0002E398 5302            	   423:     subq.b  #1,D2
02:0002E39A 6AE2            	   424:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   425:     even
                            	   426: _L_z01_InitCaveContinue_ResetTextbox:
                            	   427:     ; Reset the current character index.
