02:0004D284 142C0340        	  7367:     move.b  ($0340,A4),D2
                            	  7368:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7369:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7370:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7371:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7372:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7373:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7374:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7375:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7376:     ; corrupting them and causing a deterministic address-error
                            	  7377:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7378:     ; identified by Codex static review.)
                            	  7379: _L_z07_P47_pre_check:
02:0004D288 102C0525        	  7380:     move.b  ($0525,A4),D0
02:0004D28C 020000F0        	  7381:     andi.b  #$F0,D0
02:0004D290 0C000040        	  7382:     cmpi.b  #$40,D0
02:0004D294 6506            	  7383:     blo     _L_z07_P47_pre_snap
02:0004D296 0C0000E0        	  7384:     cmpi.b  #$E0,D0
02:0004D29A 6506            	  7385:     blo     _L_z07_P47_pre_ok
                            	  7386: _L_z07_P47_pre_snap:
02:0004D29C 197C00480525    	  7387:     move.b  #$48,($0525,A4)
                            	  7388: _L_z07_P47_pre_ok:
02:0004D2A2 7005            	  7389:     moveq   #5,D0
02:0004D2A4 61000500        	  7390:     jsr     SwitchBank
02:0004D2A8 4EB900041EB2    	  7391:     jsr     FindNextEdgeSpawnCell
                            	  7392:     ; Post-walk 1: bottom-edge snap.
02:0004D2AE 102C0525        	  7393:     move.b  ($0525,A4),D0
02:0004D2B2 020000F0        	  7394:     andi.b  #$F0,D0
02:0004D2B6 0C0000E0        	  7395:     cmpi.b  #$E0,D0
02:0004D2BA 660C            	  7396:     bne     _L_z07_P47_post1_ok
02:0004D2BC 197C00480525    	  7397:     move.b  #$48,($0525,A4)
02:0004D2C2 4EB900041EB2    	  7398:     jsr     FindNextEdgeSpawnCell
                            	  7399: _L_z07_P47_post1_ok:
                            	  7400:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7401:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D2C8 7600            	  7402:     moveq   #0,D3
02:0004D2CA 162C0525        	  7403:     move.b  ($0525,A4),D3
02:0004D2CE 0243000F        	  7404:     andi.w  #$000F,D3
02:0004D2D2 C6FC002C        	  7405:     mulu.w  #44,D3
02:0004D2D6 203C00FF6530    	  7406:     move.l  #$FF6530,D0
02:0004D2DC D083            	  7407:     add.l   D3,D0
02:0004D2DE 7600            	  7408:     moveq   #0,D3
02:0004D2E0 162C0525        	  7409:     move.b  ($0525,A4),D3
02:0004D2E4 E84B            	  7410:     lsr.w   #4,D3
02:0004D2E6 5943            	  7411:     subi.w  #4,D3
02:0004D2E8 E34B            	  7412:     lsl.w   #1,D3
02:0004D2EA D083            	  7413:     add.l   D3,D0
02:0004D2EC 2040            	  7414:     movea.l D0,A0
02:0004D2EE 1010            	  7415:     move.b  (A0),D0
02:0004D2F0 0C000084        	  7416:     cmpi.b  #$84,D0
02:0004D2F4 6544            	  7417:     blo     _L_z07_P47_post2_ok
                            	  7418:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7419:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7420:     ; writes to the $05xx region.
02:0004D2F6 7800            	  7421:     moveq   #0,D4
                            	  7422: _L_z07_P47_fb_loop:
02:0004D2F8 41FAE46C        	  7423:     lea     _L_z07_P47_FallbackCells(pc),A0
