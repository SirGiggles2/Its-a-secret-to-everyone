                            	  2608: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034FA0 102C0070        	  2609:     move.b  ($0070,A4),D0
02:00034FA4 023C00EE        	  2610:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034FA8 123C0008        	  2611:     move.b  #$08,D1
02:00034FAC D101            	  2612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034FAE 19400070        	  2613:     move.b  D0,($0070,A4)
02:00034FB2 522C0421        	  2614:     addq.b  #1,($0421,A4)
02:00034FB6 522C0423        	  2615:     addq.b  #1,($0423,A4)
                            	  2616:     ; If VRAM address still points inside the name field,
                            	  2617:     ; then go finish.
                            	  2618:     ;
                            	  2619:     ; The idea is that each name field in nametable begins at
                            	  2620:     ; an address ending in $E. For example, slot 0 has a name
                            	  2621:     ; at VRAM addresses $20CE to $20D5.
                            	  2622:     ;
                            	  2623:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2624:     ; the name field.
                            	  2625:     ;
                            	  2626:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2627:     ; record header.
                            	  2628:     ;
02:00034FBA 102C0070        	  2629:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034FBE 0C0000B0        	  2630:     cmpi.b  #$B0,D0
02:00034FC2 6678            	  2631:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2632:     ; The VRAM address now points outside the name field.
                            	  2633:     ; So, wrap around to the beginning of the name field.
                            	  2634:     ;
                            	  2635:     ; For example, $20D6 -> $20CE.
                            	  2636:     ;
02:00034FC4 102C0423        	  2637:     move.b  ($0423,A4),D0
02:00034FC8 003C0011        	  2638:     ori     #$11,CCR  ; SEC: set C+X
02:00034FCC 123C0008        	  2639:     move.b  #$08,D1
02:00034FD0 0A3C0010        	  2640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034FD4 9101            	  2641:     subx.b  D1,D0   ; SBC #$08
02:00034FD6 0A3C0010        	  2642:     eori    #$10,CCR  ; restore X = 6502 C
02:00034FDA 19400423        	  2643:     move.b  D0,($0423,A4)
                            	  2644:     ; It also means that we went past the end of the save slot
                            	  2645:     ; info name. Set the offset to the beginning of the name.
02:00034FDE 7600            	  2646:     moveq   #0,D3
02:00034FE0 162C0016        	  2647:     move.b  ($0016,A4),D3
02:00034FE4 41F900034920    	  2648:     lea     (SlotToNameOffset).l,A0
