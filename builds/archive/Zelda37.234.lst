                            	  4001: UpdatePondFairy:
02:0003B45A 610046A6        	  4002:     jsr     DrawFairy
                            	  4003:     ; If not in state 0, then go handle states 1 to 3.
                            	  4004:     ;
02:0003B45E 102C00AD        	  4005:     move.b  ($00AD,A4),D0
02:0003B462 6702            	  4006:     beq.s  __far_z_04_0035
02:0003B464 602A            	  4007:     jmp  PondFairy_HandleOtherStates
                            	  4008: __far_z_04_0035:
                            	  4009:     ; State 0.
                            	  4010:     ;
                            	  4011:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4012:     ;
02:0003B466 102C0084        	  4013:     move.b  ($0084,A4),D0
02:0003B46A 0C0000AD        	  4014:     cmpi.b  #$AD,D0
02:0003B46E 661E            	  4015:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4016:     ; If Link's X < $70 or >= $81, then return.
                            	  4017:     ;
02:0003B470 102C0070        	  4018:     move.b  ($0070,A4),D0
02:0003B474 0C000070        	  4019:     cmpi.b  #$70,D0
02:0003B478 6514            	  4020:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B47A 0C000081        	  4021:     cmpi.b  #$81,D0
