02:0002E5DE 10303000        	   758:     move.b  (A0,D3.W),D0
02:0002E5E2 41EC0302        	   759:     lea     ($0302,A4),A0
02:0002E5E6 11803000        	   760:     move.b  D0,(A0,D3.W)
