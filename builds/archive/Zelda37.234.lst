02:0003A482 023C00EE        	  1685:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A486 123C0008        	  1686:     move.b  #$08,D1
02:0003A48A D101            	  1687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A48C 020000F0        	  1688:     andi.b #$F0,D0
02:0003A490 19802070        	  1689:     move.b  D0,($70,A4,D2.W)
                            	  1690:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
