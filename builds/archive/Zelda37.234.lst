02:000419BE 660C            	  2950:     bne  _anon_z05_75
02:000419C0 102C0098        	  2951:     move.b  ($0098,A4),D0
02:000419C4 1880            	  2952:     move.b  D0,($0000,A4)
02:000419C6 4EB900030DF0    	  2953:     jsr     GetOppositeDir
                            	  2954: _anon_z05_75:
                            	  2955:     ; If in UW, use the second set of bounds by adding 4
                            	  2956:     ; to reverse direction index.
                            	  2957:     ;
                            	  2958:     ; Else in OW, and use first set that begins at offset 0.
                            	  2959:     ;
02:000419CC 102C0010        	  2960:     move.b  ($0010,A4),D0
02:000419D0 6710            	  2961:     beq  _anon_z05_76
02:000419D2 1003            	  2962:     move.b  D3,D0
02:000419D4 023C00EE        	  2963:     andi    #$EE,CCR  ; CLC: clear C+X
02:000419D8 123C0004        	  2964:     move.b  #$04,D1
02:000419DC D101            	  2965:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000419DE 7600            	  2966:     moveq   #0,D3
02:000419E0 1600            	  2967:     move.b  D0,D3
                            	  2968: _anon_z05_76:
                            	  2969:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2970:     ;
02:000419E2 7000            	  2971:     moveq   #0,D0
                            	  2972: ; Params:
                            	  2973: ; A: mask of buttons to block
                            	  2974: ; Y: offset into BorderBounds
                            	  2975: ; [00]: direction
                            	  2976: ; [02]: coordinate
                            	  2977: ;
                            	  2978: ; Returns:
                            	  2979: ; [01]: button mask that was used
                            	  2980: ;       (set to $FF if boundary not crossed)
                            	  2981: ;
                            	  2982:     even
                            	  2983: MaskInputInBorder:
02:000419E4 19400001        	  2984:     move.b  D0,($0001,A4)
                            	  2985:     ; If direction is positive (right or down), then go handle it separately.
                            	  2986:     ;
02:000419E8 1014            	  2987:     move.b  ($0000,A4),D0
02:000419EA 0200000A        	  2988:     andi.b #$0A,D0
02:000419EE 6748            	  2989:     beq  _L_z05_MaskInputInBorder_PositiveDir
