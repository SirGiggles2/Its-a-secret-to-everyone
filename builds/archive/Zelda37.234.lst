                            	  6634: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6635:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6636:     ;   full heart=4 partial heart=$70
                            	  6637:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6638:     ; But the method here yields $3EF, because partial heart is
                            	  6639:     ; considered full when = $FF instead of $100.
                            	  6640:     ;
02:00031FFE 102C000E        	  6641:     move.b  ($000E,A4),D0
02:00032002 003C0011        	  6642:     ori     #$11,CCR  ; SEC: set C+X
02:00032006 122C0670        	  6643:     move.b  ($0670,A4),D1
02:0003200A 0A3C0010        	  6644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003200E 9101            	  6645:     subx.b  D1,D0   ; SBC HeartPartial
02:00032010 0A3C0010        	  6646:     eori    #$10,CCR  ; restore X = 6502 C
02:00032014 1940000E        	  6647:     move.b  D0,($000E,A4)
02:00032018 102C066F        	  6648:     move.b  ($066F,A4),D0
02:0003201C 0200000F        	  6649:     andi.b #$0F,D0
