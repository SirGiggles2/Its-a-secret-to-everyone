02:0003661C 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:00036620 123C0010        	  4794:     move.b  #$10,D1
02:00036624 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036628 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:0003662A 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
