                            	  8142:     ;
02:0003D2D0 4EB900031CC0    	  8143:     jsr     CheckMonsterCollisions
02:0003D2D6 41EC0405        	  8144:     lea     ($0405,A4),A0
02:0003D2DA 10302000        	  8145:     move.b  (A0,D2.W),D0
02:0003D2DE 678A            	  8146:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8147:     ; But once it has died, then let Link move again.
                            	  8148:     ;
02:0003D2E0 7000            	  8149:     moveq   #0,D0
02:0003D2E2 19400512        	  8150:     move.b  D0,($0512,A4)
02:0003D2E6 6000CC20        	  8151:     jmp     HideSpritesOverLink
