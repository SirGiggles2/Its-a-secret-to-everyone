02:00032432 1940000E        	  7323:     move.b  D0,($000E,A4)
                            	  7324: ; Params:
                            	  7325: ; X: monster object slot
                            	  7326: ; [00]: weapon object slot
                            	  7327: ; [02]: monster object mid X
                            	  7328: ; [03]: monster object mid Y
                            	  7329: ; [07]: damage points
                            	  7330: ; [09]: damage type
                            	  7331: ; [0D]: horizontal threshold
                            	  7332: ; [0E]: vertical threshold
                            	  7333: ;
                            	  7334: ; Returns:
