                            	  8127:     ;
02:0003D2B2 103C00C0        	  8128:     move.b  #$C0,D0
02:0003D2B6 41EC042C        	  8129:     lea     ($042C,A4),A0
02:0003D2BA 11802000        	  8130:     move.b  D0,(A0,D2.W)
