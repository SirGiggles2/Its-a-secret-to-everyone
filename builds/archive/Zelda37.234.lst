02:0003CD47 05
02:0003CD48 07
02:0003CD49 FF
02:0003CD4A 09
02:0003CD4B 04
02:0003CD4C 05
02:0003CD4D 07
02:0003CD4E FF              	  7438:     dc.b    $FF, $09
02:0003CD4F 09
