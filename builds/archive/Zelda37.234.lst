                            	  3759: FormatHeartsInTextBuf:
                            	  3760:     ; [$0E]: hearts value
                            	  3761:     ; [$0F]: heart partial
                            	  3762:     ; Y: The offset of first character in buffer
                            	  3763:     ;
                            	  3764:     ; The end of the bottom row is $12 bytes after the
                            	  3765:     ; start of the top row. We're writing to two transfer
                            	  3766:     ; records. We write the top row in the first transfer
                            	  3767:     ; record wherever the caller chooses. The second
                            	  3768:     ; transfer record has to begin with the heart tiles.
                            	  3769:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3770:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3771:     ;
                            	  3772:     ; Store the starting offset in [$0D].
02:00030AB0 1943000D        	  3773:     move.b  D3,($000D,A4)
02:00030AB4 102C000E        	  3774:     move.b  ($000E,A4),D0
02:00030AB8 1B00            	  3775:     move.b  D0,-(A5)  ; PHA
02:00030ABA 0200000F        	  3776:     andi.b #$0F,D0
02:00030ABE 1880            	  3777:     move.b  D0,($0000,A4)
02:00030AC0 700F            	  3778:     moveq   #15,D0
02:00030AC2 003C0011        	  3779:     ori     #$11,CCR  ; SEC: set C+X
02:00030AC6 1214            	  3780:     move.b  ($0000,A4),D1
02:00030AC8 0A3C0010        	  3781:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030ACC 9101            	  3782:     subx.b  D1,D0   ; SBC $00
02:00030ACE 0A3C0010        	  3783:     eori    #$10,CCR  ; restore X = 6502 C
02:00030AD2 1880            	  3784:     move.b  D0,($0000,A4)
02:00030AD4 101D            	  3785:     move.b  (A5)+,D0  ; PLA
02:00030AD6 E208            	  3786:     lsr.b  #1,D0   ; LSR A
02:00030AD8 E208            	  3787:     lsr.b  #1,D0   ; LSR A
02:00030ADA E208            	  3788:     lsr.b  #1,D0   ; LSR A
02:00030ADC E208            	  3789:     lsr.b  #1,D0   ; LSR A
02:00030ADE 19400001        	  3790:     move.b  D0,($0001,A4)
02:00030AE2 700F            	  3791:     moveq   #15,D0
02:00030AE4 003C0011        	  3792:     ori     #$11,CCR  ; SEC: set C+X
02:00030AE8 122C0001        	  3793:     move.b  ($0001,A4),D1
02:00030AEC 0A3C0010        	  3794:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030AF0 9101            	  3795:     subx.b  D1,D0   ; SBC $01
02:00030AF2 0A3C0010        	  3796:     eori    #$10,CCR  ; restore X = 6502 C
02:00030AF6 19400001        	  3797:     move.b  D0,($0001,A4)
                            	  3798:     ; At this point,
                            	  3799:     ; [$00] = $F - hearts
                            	  3800:     ; [$01] = $F - heart containers
                            	  3801:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3802:     ;
                            	  3803:     ; Also, Y is still set to the value passed in.
                            	  3804:     ;
02:00030AFA 7400            	  3805:     moveq   #0,D2
02:00030AFC 1003            	  3806:     move.b  D3,D0
02:00030AFE 023C00EE        	  3807:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030B02 123C0007        	  3808:     move.b  #$07,D1
02:00030B06 D101            	  3809:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030B08 1940000B        	  3810:     move.b  D0,($000B,A4)
                            	  3811:     ; Y keeps track of index of heart in row.
                            	  3812:     ; Start at the end of the first row.
02:00030B0C 7607            	  3813:     moveq   #7,D3
