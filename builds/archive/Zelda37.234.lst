                            	  2211: UpdateWhirlwind_Full:
                            	  2212:     ; Get Link's halted state.
                            	  2213:     ;
02:0003004C 102C00AC        	  2214:     move.b  ($00AC,A4),D0
02:00030050 02000040        	  2215:     andi.b #$40,D0
02:00030054 7600            	  2216:     moveq   #0,D3
02:00030056 1600            	  2217:     move.b  D0,D3
                            	  2218:     ; Add 2 to whirlwind X.
                            	  2219:     ;
02:00030058 7002            	  2220:     moveq   #2,D0
02:0003005A 023C00EE        	  2221:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003005E 12342070        	  2222:     move.b  ($70,A4,D2.W),D1
02:00030062 D101            	  2223:     addx.b  D1,D0   ; ADC ObjX,X
02:00030064 19802070        	  2224:     move.b  D0,($70,A4,D2.W)
                            	  2225:     ; If Link is not halted or teleporting state = 0, then
                            	  2226:     ; go check for collision with Link.
                            	  2227:     ;
02:00030068 0C030040        	  2228:     cmpi.b  #$40,D3
02:0003006C 6638            	  2229:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0003006E 7600            	  2230:     moveq   #0,D3
02:00030070 162C0522        	  2231:     move.b  ($0522,A4),D3
02:00030074 6730            	  2232:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2233:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2234:     ;
                            	  2235:     ; Set Link's X to whirlwind's.
                            	  2236:     ;
02:00030076 19400070        	  2237:     move.b  D0,($0070,A4)
                            	  2238:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2239:     ; the right screen edge and draw.
                            	  2240:     ;
02:0003007A 5303            	  2241:     subq.b  #1,D3
02:0003007C 6776            	  2242:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0003007E 0C000080        	  2243:     cmpi.b  #$80,D0
02:00030082 6670            	  2244:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2245:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2246:     ;
                            	  2247:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2248:     ;
02:00030084 E308            	  2249:     lsl.b  #1,D0   ; ASL A
02:00030086 194000AC        	  2250:     move.b  D0,($00AC,A4)
02:0003008A 19400522        	  2251:     move.b  D0,($0522,A4)
02:0003008E 41EC034F        	  2252:     lea     ($034F,A4),A0
02:00030092 11802000        	  2253:     move.b  D0,(A0,D2.W)
                            	  2254:     ; Update the player position marker, and draw one last time.
                            	  2255:     ;
02:00030096 1002            	  2256:     move.b  D2,D0
02:00030098 1B00            	  2257:     move.b  D0,-(A5)  ; PHA
02:0003009A 61001096        	  2258:     jsr     UpdatePlayerPositionMarker
02:0003009E 101D            	  2259:     move.b  (A5)+,D0  ; PLA
02:000300A0 7400            	  2260:     moveq   #0,D2
02:000300A2 1400            	  2261:     move.b  D0,D2
02:000300A4 6070            	  2262:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2263: 
                            	  2264:     even
                            	  2265: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2266:     ; Link is not halted or teleporting state = 0.
                            	  2267:     ; Try to pick up Link.
                            	  2268:     ;
                            	  2269:     ; If the whirlwind does not collide with Link, then go check
                            	  2270:     ; for the screen's right edge.
                            	  2271:     ;
02:000300A6 61001D62        	  2272:     jsr     CheckLinkCollision
02:000300AA 102C0006        	  2273:     move.b  ($0006,A4),D0
02:000300AE 6744            	  2274:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2275:     ; Collided with Link.
                            	  2276:     ;
                            	  2277:     ; Make Link face right. Reset shove info and subroom type.
                            	  2278:     ;
02:000300B0 7001            	  2279:     moveq   #1,D0
02:000300B2 19400098        	  2280:     move.b  D0,($0098,A4)
02:000300B6 E208            	  2281:     lsr.b  #1,D0   ; LSR A
02:000300B8 194000C0        	  2282:     move.b  D0,($00C0,A4)
02:000300BC 194000D3        	  2283:     move.b  D0,($00D3,A4)
02:000300C0 1940005A        	  2284:     move.b  D0,($005A,A4)
                            	  2285:     ; Halt Link (state $40), and hide him.
                            	  2286:     ;
02:000300C4 7040            	  2287:     moveq   #64,D0
02:000300C6 194000AC        	  2288:     move.b  D0,($00AC,A4)
02:000300CA 103C00F8        	  2289:     move.b  #$F8,D0
02:000300CE 19400248        	  2290:     move.b  D0,($0248,A4)
02:000300D2 1940024C        	  2291:     move.b  D0,($024C,A4)
                            	  2292:     ; Find and set the room that will behave as the previous room
                            	  2293:     ; when scrolling right to the room with the level's entrance.
                            	  2294:     ;
02:000300D6 102C0523        	  2295:     move.b  ($0523,A4),D0
02:000300DA 02000007        	  2296:     andi.b #$07,D0
02:000300DE 7600            	  2297:     moveq   #0,D3
02:000300E0 1600            	  2298:     move.b  D0,D3
02:000300E2 41F900030044    	  2299:     lea     (WhirlwindPrevRoomIdList).l,A0
02:000300E8 10303000        	  2300:     move.b  (A0,D3.W),D0
02:000300EC 194000EA        	  2301:     move.b  D0,($00EA,A4)
                            	  2302:     ; Set teleporting state 1.
                            	  2303:     ;
02:000300F0 522C0522        	  2304:     addq.b  #1,($0522,A4)
                            	  2305:     even
                            	  2306: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2307:     ; If whirlwind's X < $F0, go draw.
                            	  2308:     ;
02:000300F4 10342070        	  2309:     move.b  ($70,A4,D2.W),D0
02:000300F8 0C0000F0        	  2310:     cmpi.b  #$F0,D0
02:000300FC 6518            	  2311:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2312:     ; The whirlwind has reached the right edge of the screen.
                            	  2313:     ;
                            	  2314:     ; Destroy the object.
                            	  2315:     ;
02:000300FE 611A            	  2316:     jsr     DestroyWhirlwind
                            	  2317:     ; If teleporting state <> 0, we picked up Link.
                            	  2318:     ; So, go to the next mode.
                            	  2319:     ;
                            	  2320:     ; Either way, draw one last time.
                            	  2321:     ;
02:00030100 102C0522        	  2322:     move.b  ($0522,A4),D0
02:00030104 6710            	  2323:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030106 1002            	  2324:     move.b  D2,D0
02:00030108 1B00            	  2325:     move.b  D0,-(A5)  ; PHA
02:0003010A 4EB90004BCA0    	  2326:     jsr     GoToNextModeFromPlay
02:00030110 101D            	  2327:     move.b  (A5)+,D0  ; PLA
02:00030112 7400            	  2328:     moveq   #0,D2
02:00030114 1400            	  2329:     move.b  D0,D2
                            	  2330:     even
                            	  2331: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030116 600000A8        	  2332:     jmp     DrawWhirlwind
                            	  2333: 
                            	  2334:     even
                            	  2335: DestroyWhirlwind:
02:0003011A 6000B6F8        	  2336:     jmp     c_destroy_whirlwind
                            	  2337: 
                            	  2338: SummonWhirlwind:
                            	  2339:     ; If not in mode 5, return.
                            	  2340:     ;
02:0003011E 102C0012        	  2341:     move.b  ($0012,A4),D0
02:00030122 0C000005        	  2342:     cmpi.b  #$05,D0
02:00030126 6704            	  2343:     beq.s  __far_z_01_0012
02:00030128 60000094        	  2344:     jmp  L6104_Exit
                            	  2345: __far_z_01_0012:
                            	  2346:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2347:     ;
02:0003012C 6178            	  2348:     jsr     AdvanceTeleportingLevelIndex
02:0003012E 102C0523        	  2349:     move.b  ($0523,A4),D0
02:00030132 02000007        	  2350:     andi.b #$07,D0
02:00030136 7600            	  2351:     moveq   #0,D3
02:00030138 1600            	  2352:     move.b  D0,D3
02:0003013A 41F90004AB92    	  2353:     lea     (LevelMasks).l,A0
02:00030140 10303000        	  2354:     move.b  (A0,D3.W),D0
02:00030144 1880            	  2355:     move.b  D0,($0000,A4)
                            	  2356:     even
                            	  2357: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2358:     ; If there are no triforce pieces, then return.
                            	  2359:     ;
02:00030146 102C0671        	  2360:     move.b  ($0671,A4),D0
02:0003014A 6602            	  2361:     bne.s  __far_z_01_0013
02:0003014C 6070            	  2362:     jmp  L6104_Exit
                            	  2363: __far_z_01_0013:
                            	  2364:     ; If we have gotten this triforce piece, then go try to make a
                            	  2365:     ; whirlwind.
                            	  2366:     ;
02:0003014E 1214            	  2367:     move.b  ($0000,A4),D1
02:00030150 C200            	  2368:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00030152 662C            	  2369:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2370:     ; We have not gotten this piece.
                            	  2371:     ; First, advance the teleporting index again.
                            	  2372:     ;
02:00030154 6150            	  2373:     jsr     AdvanceTeleportingLevelIndex
                            	  2374:     ; If the direction Link is facing is an increasing one, then
                            	  2375:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2376:     ; level number. Then go test this new mask.
                            	  2377:     ;
02:00030156 102C0098        	  2378:     move.b  ($0098,A4),D0
02:0003015A 02000009        	  2379:     andi.b #$09,D0
02:0003015E 6710            	  2380:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:00030160 1214            	  2381:     move.b  ($0000,A4),D1
02:00030162 E309            	  2382:     lsl.b  #1,D1   ; ASL $00
02:00030164 1881            	  2383:     move.b  D1,($0000,A4)
02:00030166 64DE            	  2384:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030168 1214            	  2385:     move.b  ($0000,A4),D1
02:0003016A E311            	  2386:     roxl.b  #1,D1   ; ROL $00
02:0003016C 1881            	  2387:     move.b  D1,($0000,A4)
02:0003016E 60D6            	  2388:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2389: 
                            	  2390:     even
                            	  2391: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2392:     ; If instead the direction is a decreasing one, then
                            	  2393:     ; rotate right to correspond to the lower level number.
                            	  2394:     ; Then go test this new mask.
                            	  2395:     ;
02:00030170 1214            	  2396:     move.b  ($0000,A4),D1
02:00030172 E209            	  2397:     lsr.b  #1,D1   ; LSR $00
02:00030174 1881            	  2398:     move.b  D1,($0000,A4)
02:00030176 64CE            	  2399:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030178 1214            	  2400:     move.b  ($0000,A4),D1
02:0003017A E211            	  2401:     roxr.b  #1,D1   ; ROR $00
02:0003017C 1881            	  2402:     move.b  D1,($0000,A4)
02:0003017E 60C6            	  2403:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2404: 
                            	  2405:     even
                            	  2406: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  2407:     ; If already summoned or in the middle of teleporting, then
                            	  2408:     ; return and don't summon another one.
                            	  2409:     ;
02:00030180 102C0508        	  2410:     move.b  ($0508,A4),D0
02:00030184 122C0522        	  2411:     move.b  ($0522,A4),D1
02:00030188 8001            	  2412:     or.b  D1,D0
02:0003018A 6702            	  2413:     beq.s  __far_z_01_0014
02:0003018C 6030            	  2414:     jmp  L6104_Exit
                            	  2415: __far_z_01_0014:
                            	  2416:     ; Return if we can't find an empty monster slot.
                            	  2417:     ;
02:0003018E 4EB90004D63A    	  2418:     jsr     FindEmptyMonsterSlot
02:00030194 6602            	  2419:     bne.s  __far_z_01_0015
02:00030196 6026            	  2420:     jmp  L6104_Exit
                            	  2421: __far_z_01_0015:
                            	  2422:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  2423:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  2424:     ;
02:00030198 522C0508        	  2425:     addq.b  #1,($0508,A4)
02:0003019C 1003            	  2426:     move.b  D3,D0
02:0003019E 7400            	  2427:     moveq   #0,D2
02:000301A0 1400            	  2428:     move.b  D0,D2
02:000301A2 6000FE9C        	  2429:     jmp     SetUpWhirlwind
                            	  2430: 
                            	  2431:     even
                            	  2432: AdvanceTeleportingLevelIndex:
                            	  2433:     ; If Link is facing an increasing direction (right or down), then
                            	  2434:     ; increase the index. Otherwise, decrease it.
                            	  2435:     ;
02:000301A6 522C0523        	  2436:     addq.b  #1,($0523,A4)
02:000301AA 102C0098        	  2437:     move.b  ($0098,A4),D0
02:000301AE 02000009        	  2438:     andi.b #$09,D0
02:000301B2 6702            	  2439:     beq.s  __far_z_01_0016
02:000301B4 6008            	  2440:     jmp  L6104_Exit
                            	  2441: __far_z_01_0016:
02:000301B6 532C0523        	  2442:     subq.b  #1,($0523,A4)
02:000301BA 532C0523        	  2443:     subq.b  #1,($0523,A4)
