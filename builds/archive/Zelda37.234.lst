                            	  2320: _L_z04__TryShooting_TryShootingNow:
                            	  2321:     ; Summary
                            	  2322:     ;
                            	  2323:     ; if temporarily invincible then
                            	  2324:     ;   shoot timer := 0
                            	  2325:     ; elif shoot timer > 0 then
                            	  2326:     ;   decrement shoot timer
                            	  2327:     ; elif wants to shoot then
                            	  2328:     ;   shoot timer := $30
                            	  2329:     ;
                            	  2330:     ; qspeed := [01]
                            	  2331:     ;
                            	  2332:     ; if shoot timer <> 0 then
                            	  2333:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2334:     ;     shoot
                            	  2335:     ;     if succeeded then
                            	  2336:     ;       shoot timer := 0
                            	  2337:     ;       qspeed := 0
                            	  2338:     ;   else
                            	  2339:     ;     qspeed := 0
                            	  2340:     ;
                            	  2341:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A8CC 102C0001        	  2342:     move.b  ($0001,A4),D0
02:0003A8D0 1883            	  2343:     move.b  D3,($0000,A4)
02:0003A8D2 1B00            	  2344:     move.b  D0,-(A5)  ; PHA
02:0003A8D4 7600            	  2345:     moveq   #0,D3
                            	  2346:     ; If not temporarily invincible,
                            	  2347:     ;
02:0003A8D6 41EC04F0        	  2348:     lea     ($04F0,A4),A0
02:0003A8DA 10302000        	  2349:     move.b  (A0,D2.W),D0
02:0003A8DE 661A            	  2350:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2351:     ; then Y := shoot timer - 1
                            	  2352:     ;
02:0003A8E0 7600            	  2353:     moveq   #0,D3
02:0003A8E2 41EC0451        	  2354:     lea     ($0451,A4),A0
02:0003A8E6 16302000        	  2355:     move.b  (A0,D2.W),D3
02:0003A8EA 5303            	  2356:     subq.b  #1,D3
                            	  2357:     ; If Y register < 0, then shoot timer is 0.
                            	  2358:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2359:     ; Else go set a non-zero speed and return.
                            	  2360:     ;
02:0003A8EC 6A0C            	  2361:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A8EE 41EC0412        	  2362:     lea     ($0412,A4),A0
02:0003A8F2 10302000        	  2363:     move.b  (A0,D2.W),D0
02:0003A8F6 6736            	  2364:     beq  _L_z04__TryShooting_SetSpeed
