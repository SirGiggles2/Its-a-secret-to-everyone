02:0003D3BE 10302000        	  8260:     move.b  (A0,D2.W),D0
02:0003D3C2 6612            	  8261:     bne  _L_z04_CheckVireCollisions_Exit
                            	  8262:     ; If temporarily invincible, then it was harmed.
                            	  8263:     ; Advance the state to split up.
