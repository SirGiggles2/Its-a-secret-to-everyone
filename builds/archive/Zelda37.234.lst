02:00030520 023C00EE        	  2930:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  2931:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  2932:     ;
02:00030524 122C0340        	  2933:     move.b  ($0340,A4),D1
02:00030528 D101            	  2934:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003052A 7400            	  2935:     moveq   #0,D2
02:0003052C 1400            	  2936:     move.b  D0,D2
                            	  2937:     ; Look up and set the location for this iteration's individual trap.
                            	  2938:     ;
02:0003052E 41F9000304F2    	  2939:     lea     (TrapXs).l,A0
02:00030534 10303000        	  2940:     move.b  (A0,D3.W),D0
02:00030538 19802070        	  2941:     move.b  D0,($70,A4,D2.W)
02:0003053C 41F9000304F8    	  2942:     lea     (TrapYs).l,A0
02:00030542 10303000        	  2943:     move.b  (A0,D3.W),D0
02:00030546 41EC0084        	  2944:     lea     ($0084,A4),A0
02:0003054A 11802000        	  2945:     move.b  D0,(A0,D2.W)
02:0003054E 619E            	  2946:     jsr     InitOneSimpleObject
02:00030550 5302            	  2947:     subq.b  #1,D2
02:00030552 5303            	  2948:     subq.b  #1,D3
02:00030554 6AC8            	  2949:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:00030556 4E75            	  2950:     rts
