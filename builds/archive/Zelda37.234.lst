                            	  4220: _L_z07_CheckTiles_notLink:
                            	  4221:     endc
                            	  4222:     ; The code below applies to Link and other objects.
                            	  4223:     ;
                            	  4224:     ; Test the moving direction's walkability.
                            	  4225:     ;
                            	  4226:     ; For the player, this is enough. For other objects, this 
                            	  4227:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4228:     ;
