02:00044A5C 101D            	  7611:     move.b  (A5)+,D0  ; PLA
                            	  7612:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7613:     ; then the player walked all the way to the edge of the play
                            	  7614:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7615:     ;
                            	  7616:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7617:     ; edge of the play area. So, set a relative position that
                            	  7618:     ; reflects that distance: $28 or -$28.
                            	  7619:     ;
                            	  7620:     ; If walking in a decreasing direction (left or up), then
                            	  7621:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7622:     ;
                            	  7623:     ; If walking in an increasing direction (right or down), then
                            	  7624:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7625:     ;
02:00044A5E 02000007        	  7626:     andi.b #$07,D0
02:00044A62 0C000002        	  7627:     cmpi.b  #$02,D0
