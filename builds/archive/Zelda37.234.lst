                            	  6180:     ;
02:00043AA0 41F900043876    	  6181:     lea     (DoorVramAddrsHi).l,A0
02:00043AA6 10302000        	  6182:     move.b  (A0,D2.W),D0
02:00043AAA 1880            	  6183:     move.b  D0,($0000,A4)
02:00043AAC 41F90004387A    	  6184:     lea     (DoorVramAddrsLo).l,A0
02:00043AB2 10302000        	  6185:     move.b  (A0,D2.W),D0
02:00043AB6 19400001        	  6186:     move.b  D0,($0001,A4)
                            	  6187:     ; Return the direction of the door in [09], and the dynamic
                            	  6188:     ; transfer buf length in X register.
                            	  6189:     ;
02:00043ABA 19420009        	  6190:     move.b  D2,($0009,A4)
02:00043ABE 7400            	  6191:     moveq   #0,D2
02:00043AC0 142C0301        	  6192:     move.b  ($0301,A4),D2
                            	  6193:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
