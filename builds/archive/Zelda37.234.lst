02:0003C906 7005            	  6812:     moveq   #5,D0
02:0003C908 1940000B        	  6813:     move.b  D0,($000B,A4)
                            	  6814:     even
                            	  6815: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C90C 7600            	  6816:     moveq   #0,D3
02:0003C90E 162C000B        	  6817:     move.b  ($000B,A4),D3
                            	  6818:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6819:     ; Store it in [00].
                            	  6820:     ;
02:0003C912 10342070        	  6821:     move.b  ($70,A4,D2.W),D0
02:0003C916 023C00EE        	  6822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C91A 41F90003C8EE    	  6823:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C920 12303000        	  6824:     move.b  (A0,D3.W),D1
02:0003C924 D101            	  6825:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C926 1880            	  6826:     move.b  D0,($0000,A4)
                            	  6827:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6828:     ; Store it in [01].
                            	  6829:     ;
02:0003C928 41EC0084        	  6830:     lea     ($0084,A4),A0
02:0003C92C 10302000        	  6831:     move.b  (A0,D2.W),D0
02:0003C930 023C00EE        	  6832:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C934 41F90003C8E8    	  6833:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C93A 12303000        	  6834:     move.b  (A0,D3.W),D1
02:0003C93E D101            	  6835:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C940 19400001        	  6836:     move.b  D0,($0001,A4)
                            	  6837:     ; Calculate sprite attributes:
                            	  6838:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6839:     ;
                            	  6840:     ; If the boss is temporarily invincible, then
                            	  6841:     ; this makes it flash by cycling all the palette rows.
                            	  6842:     ;
                            	  6843:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6844:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6845:     ;
02:0003C944 41EC04F0        	  6846:     lea     ($04F0,A4),A0
02:0003C948 10302000        	  6847:     move.b  (A0,D2.W),D0
02:0003C94C 02000003        	  6848:     andi.b #$03,D0
02:0003C950 0A000003        	  6849:     eori.b #$03,D0
02:0003C954 19400003        	  6850:     move.b  D0,($0003,A4)
02:0003C958 7600            	  6851:     moveq   #0,D3
02:0003C95A 162C000A        	  6852:     move.b  ($000A,A4),D3
                            	  6853:     ; Look up the tile for this sprite.
                            	  6854:     ; If it's not the first one (face), then go write the sprite record.
                            	  6855:     ;
02:0003C95E 41F90003C8DC    	  6856:     lea     (AquamentusTiles).l,A0
02:0003C964 10303000        	  6857:     move.b  (A0,D3.W),D0
02:0003C968 12390003C8DC    	  6858:     move.b  (AquamentusTiles).l,D1
02:0003C96E B001            	  6859:     cmp.b   D1,D0
02:0003C970 6610            	  6860:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6861:     ; Else it's the first one (the face tile).
                            	  6862:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6863:     ;
                            	  6864:     ; $CC/CD shows the closed mouth face.
                            	  6865:     ; $C0/C1 shows the open mouth face.
                            	  6866:     ;
02:0003C972 7600            	  6867:     moveq   #0,D3
02:0003C974 16342028        	  6868:     move.b  ($28,A4,D2.W),D3
02:0003C978 0C030020        	  6869:     cmpi.b  #$20,D3
02:0003C97C 6404            	  6870:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C97E 103C00C0        	  6871:     move.b  #$C0,D0
                            	  6872:     even
