                            	  3249: _anon_z04_42:
                            	  3250:     ; State 0.
                            	  3251:     ;
                            	  3252:     ; In state we determine whether to burst out of the ground.
                            	  3253:     ; If the long timer has not expired, then return.
                            	  3254:     ;
02:0003AF44 102C004D        	  3255:     move.b  ($004D,A4),D0
02:0003AF48 6674            	  3256:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3257:     ; Only allow two red leevers at a time.
                            	  3258:     ;
02:0003AF4A 102C0510        	  3259:     move.b  ($0510,A4),D0
02:0003AF4E 0C000002        	  3260:     cmpi.b  #$02,D0
02:0003AF52 646A            	  3261:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3262:     ; Face in the same direction as Link.
                            	  3263:     ;
02:0003AF54 102C0098        	  3264:     move.b  ($0098,A4),D0
02:0003AF58 41EC0098        	  3265:     lea     ($0098,A4),A0
02:0003AF5C 11802000        	  3266:     move.b  D0,(A0,D2.W)
                            	  3267:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3268:     ;
02:0003AF60 10342019        	  3269:     move.b  ($19,A4,D2.W),D0
02:0003AF64 0C0000C0        	  3270:     cmpi.b  #$C0,D0
02:0003AF68 6506            	  3271:     bcs  _anon_z04_43
02:0003AF6A 4EB90004BD2A    	  3272:     jsr     ReverseObjDir
                            	  3273: _anon_z04_43:
                            	  3274:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3275:     ;
02:0003AF70 41EC0098        	  3276:     lea     ($0098,A4),A0
02:0003AF74 10302000        	  3277:     move.b  (A0,D2.W),D0
02:0003AF78 0200000C        	  3278:     andi.b #$0C,D0
02:0003AF7C 6742            	  3279:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3280:     ; Begin with the leever's X set to Link's X.
                            	  3281:     ;
02:0003AF7E 102C0070        	  3282:     move.b  ($0070,A4),D0
02:0003AF82 19802070        	  3283:     move.b  D0,($70,A4,D2.W)
                            	  3284:     ; If facing down, then use Y offset $28.
                            	  3285:     ; Else store Y offset -$28 in [00].
                            	  3286:     ;
02:0003AF86 7628            	  3287:     moveq   #40,D3
02:0003AF88 41EC0098        	  3288:     lea     ($0098,A4),A0
02:0003AF8C 10302000        	  3289:     move.b  (A0,D2.W),D0
02:0003AF90 02000008        	  3290:     andi.b #$08,D0
02:0003AF94 6704            	  3291:     beq  _anon_z04_44
02:0003AF96 163C00D8        	  3292:     move.b  #$D8,D3
                            	  3293: _anon_z04_44:
02:0003AF9A 1883            	  3294:     move.b  D3,($0000,A4)
                            	  3295:     ; Add Link's Y and the vertical offset.
                            	  3296:     ;
02:0003AF9C 102C0084        	  3297:     move.b  ($0084,A4),D0
02:0003AFA0 023C00EE        	  3298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFA4 1214            	  3299:     move.b  ($0000,A4),D1
02:0003AFA6 D101            	  3300:     addx.b  D1,D0   ; ADC $00
                            	  3301:     ; Sanitize the Y coordinate:
                            	  3302:     ; (Y AND $F0) OR $D
                            	  3303:     ;
02:0003AFA8 020000F0        	  3304:     andi.b #$F0,D0
02:0003AFAC 0000000D        	  3305:     ori.b #$0D,D0
02:0003AFB0 41EC0084        	  3306:     lea     ($0084,A4),A0
02:0003AFB4 11802000        	  3307:     move.b  D0,(A0,D2.W)
                            	  3308:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3309:     ; go see if the tile is valid to come out of.
                            	  3310:     ;
                            	  3311:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3312:     ;
02:0003AFB8 0C00005D        	  3313:     cmpi.b  #$5D,D0
02:0003AFBC 647A            	  3314:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3315:     even
                            	  3316: _L_z04_UpdateRedLeever_Exit:
