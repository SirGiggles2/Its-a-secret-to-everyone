                            	  5711: _anon_z04_79:
                            	  5712:     ; Draw with sprite attributes: normal, red palette row
                            	  5713:     ;
02:0003C12C 7002            	  5714:     moveq   #2,D0
02:0003C12E 19400003        	  5715:     move.b  D0,($0003,A4)
02:0003C132 7044            	  5716:     moveq   #68,D0
02:0003C134 4EB900031C40    	  5717:     jsr     Anim_WriteSprite
                            	  5718:     ; Check collisions, but never let them interfere with movement.
                            	  5719:     ;
02:0003C13A 41EC0098        	  5720:     lea     ($0098,A4),A0
02:0003C13E 10302000        	  5721:     move.b  (A0,D2.W),D0
02:0003C142 1B00            	  5722:     move.b  D0,-(A5)  ; PHA
02:0003C144 10342028        	  5723:     move.b  ($28,A4,D2.W),D0
02:0003C148 1B00            	  5724:     move.b  D0,-(A5)  ; PHA
02:0003C14A 4EB900031CC0    	  5725:     jsr     CheckMonsterCollisions
02:0003C150 101D            	  5726:     move.b  (A5)+,D0  ; PLA
02:0003C152 19802028        	  5727:     move.b  D0,($28,A4,D2.W)
02:0003C156 101D            	  5728:     move.b  (A5)+,D0  ; PLA
02:0003C158 41EC0098        	  5729:     lea     ($0098,A4),A0
02:0003C15C 11802000        	  5730:     move.b  D0,(A0,D2.W)
                            	  5731:     ; If this segment is still alive, then return.
                            	  5732:     ;
02:0003C160 41EC0405        	  5733:     lea     ($0405,A4),A0
02:0003C164 10302000        	  5734:     move.b  (A0,D2.W),D0
02:0003C168 6774            	  5735:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5736:     ; This segment is dead. We'll swap the tail segment with this
                            	  5737:     ; dead segment. This way, moldorm heads are always rooted
                            	  5738:     ; in slots 5 and $A; and the segments are continguous.
                            	  5739:     ;
