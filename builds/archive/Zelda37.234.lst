                            	 11240: __far_z_04_0107:
                            	 11241:     ; The animation timer has expired. There are two choices for arming it.
                            	 11242:     ;
                            	 11243:     ; When writhing after a hit, Gleeok animates faster.
                            	 11244:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11245:     ; Otherwise, set a longer time ($10).
                            	 11246:     ;
