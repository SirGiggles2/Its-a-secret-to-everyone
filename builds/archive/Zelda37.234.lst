02:00040196 0A3C0010        	   311:     eori    #$10,CCR  ; restore X = 6502 C
02:0004019A 194000FC        	   312:     move.b  D0,($00FC,A4)
                            	   313:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   314:     ;
02:0004019E 0C000041        	   315:     cmpi.b  #$41,D0
02:000401A2 66000090        	   316:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   317:     ; VScroll reached $41.
                            	   318:     ; Advance the submenu state.
                            	   319:     ; If in OW or in a cellar, we're done. Return.
                            	   320:     ;
02:000401A6 522C00E1        	   321:     addq.b  #1,($00E1,A4)
02:000401AA 102C0010        	   322:     move.b  ($0010,A4),D0
02:000401AE 67000084        	   323:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:000401B2 102C0012        	   324:     move.b  ($0012,A4),D0
02:000401B6 0C000009        	   325:     cmpi.b  #$09,D0
02:000401BA 6778            	   326:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   327:     ; Calculate the X coordinate of the submenu position marker.
                            	   328:     ;
                            	   329:     ; First, mask off the high nibble of the room ID and multiply by
                            	   330:     ; the width of a tile, 8. Store the result in [00].
                            	   331:     ;
02:000401BC 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:000401C0 0200000F        	   333:     andi.b #$0F,D0
02:000401C4 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:000401C6 E308            	   335:     lsl.b  #1,D0   ; ASL A
02:000401C8 E308            	   336:     lsl.b  #1,D0   ; ASL A
02:000401CA 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:000401CC 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
02:000401D2 0C000008        	   346:     cmpi.b  #$08,D0
02:000401D6 6520            	   347:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:000401D8 7010            	   348:     moveq   #16,D0
02:000401DA 123900FF6BAB    	   349:     move.b  (NES_SRAM+$0BAB).l,D1
02:000401E0 0A3C0010        	   350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000401E4 9101            	   351:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:000401E6 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:000401EA E308            	   353:     lsl.b  #1,D0   ; ASL A
02:000401EC E308            	   354:     lsl.b  #1,D0   ; ASL A
02:000401EE E308            	   355:     lsl.b  #1,D0   ; ASL A
02:000401F0 4EB900030DF8    	   356:     jsr     Negate
02:000401F6 6006            	   357:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   358: 
                            	   359:     even
                            	   360: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   361:     ; The submenu map's rotation < 8.
                            	   362:     ; It represents the number of tiles to move right.
                            	   363:     ; So, multiply it by 8.
                            	   364:     ;
02:000401F8 E308            	   365:     lsl.b  #1,D0   ; ASL A
02:000401FA E308            	   366:     lsl.b  #1,D0   ; ASL A
02:000401FC E308            	   367:     lsl.b  #1,D0   ; ASL A
                            	   368:     even
                            	   369: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   370:     ; Add the offset we calculated, and $62 to [00] to get
                            	   371:     ; the position marker's X coordinate.
                            	   372:     ;
02:000401FE 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040202 1214            	   374:     move.b  ($0000,A4),D1
02:00040204 D101            	   375:     addx.b  D1,D0   ; ADC $00
02:00040206 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004020A 123C0062        	   377:     move.b  #$62,D1
02:0004020E D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040210 19400253        	   379:     move.b  D0,($0253,A4)
                            	   380:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   381:     ; Divide by 2 to get a multiple of the tile height.
                            	   382:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   383:     ;
02:00040214 102C00EB        	   384:     move.b  ($00EB,A4),D0
02:00040218 020000F0        	   385:     andi.b #$F0,D0
02:0004021C E208            	   386:     lsr.b  #1,D0   ; LSR A
02:0004021E 123C0069        	   387:     move.b  #$69,D1
02:00040222 D101            	   388:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:00040224 19400250        	   389:     move.b  D0,($0250,A4)
                            	   390:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   391:     ;
02:00040228 703E            	   392:     moveq   #62,D0
02:0004022A 19400251        	   393:     move.b  D0,($0251,A4)
02:0004022E 7000            	   394:     moveq   #0,D0
02:00040230 19400252        	   395:     move.b  D0,($0252,A4)
                            	   396:     even
                            	   397: _L_z05_UpdateMenuScrollDownUW_Exit:
02:00040234 4E75            	   398:     rts
                            	   399: 
                            	   400:     even
                            	   401: UpdateMenuActive:
02:00040236 610051C2        	   402:     jsr     DrawSubmenuItems
02:0004023A 61005286        	   403:     jsr     UpdateSubmenuSelection
                            	   404:     ; If buttons Up and A are down on the second controller, then
                            	   405:     ; 1. reset submenu state
                            	   406:     ; 2. go to mode 8
                            	   407:     ; 3. silence sound
                            	   408:     ;
02:0004023E 102C00FB        	   409:     move.b  ($00FB,A4),D0
02:00040242 02000088        	   410:     andi.b #$88,D0
02:00040246 0C000088        	   411:     cmpi.b  #$88,D0
02:0004024A 661A            	   412:     bne  _anon_z05_3
02:0004024C 4EB90004B3D0    	   413:     jsr     EndGameMode
02:00040252 194000E1        	   414:     move.b  D0,($00E1,A4)
02:00040256 7008            	   415:     moveq   #8,D0
02:00040258 19400012        	   416:     move.b  D0,($0012,A4)
02:0004025C 7000            	   417:     moveq   #0,D0
02:0004025E 19400619        	   418:     move.b  D0,($0619,A4)
02:00040262 600012CE        	   419:     jmp     SilenceSound
                            	   420: 
                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:00040266 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0004026A 02000010        	   426:     andi.b #$10,D0
02:0004026E 6606            	   427:     bne.s  __far_z_05_0000
02:00040270 4EF90002D4F2    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:00040276 102C0254        	   430:     move.b  ($0254,A4),D0
02:0004027A 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0004027C 102C0258        	   432:     move.b  ($0258,A4),D0
02:00040280 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:00040282 4EB90004A9EE    	   434:     jsr     HideAllSprites
02:00040288 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0004028A 19400258        	   436:     move.b  D0,($0258,A4)
02:0004028E 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:00040290 19400254        	   438:     move.b  D0,($0254,A4)
02:00040294 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:00040298 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004029C 4E75            	   441:     rts
                            	   442: 
                            	   443:     even
                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:0004029E 103C00FD        	   447:     move.b  #$FD,D0
02:000402A2 613A            	   448:     jsr     MovePositionMarkers
02:000402A4 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:000402A8 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402AC 123C0003        	   451:     move.b  #$03,D1
02:000402B0 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000402B2 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
02:000402B6 0C0000F0        	   456:     cmpi.b  #$F0,D0
02:000402BA 6406            	   457:     bcc.s  __far_z_05_0001
02:000402BC 4EF90002D4F2    	   458:     jmp  Exit
                            	   459: __far_z_05_0001:
                            	   460:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   461:     ;
02:000402C2 1940005C        	   462:     move.b  D0,($005C,A4)
                            	   463:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   464:     ;
                            	   465:     ; UNKNOWN: But why not do this in OW, too?
                            	   466:     ;
02:000402C6 102C0010        	   467:     move.b  ($0010,A4),D0
02:000402CA 6706            	   468:     beq  _anon_z05_4
02:000402CC 4EB900031666    	   469:     jsr     WriteBlankPrioritySprites
                            	   470: _anon_z05_4:
                            	   471:     ; We reached the end. So, reset hardware vertical scroll
                            	   472:     ; and submenu state.
                            	   473:     ;
02:000402D2 7000            	   474:     moveq   #0,D0
02:000402D4 194000FC        	   475:     move.b  D0,($00FC,A4)
02:000402D8 194000E1        	   476:     move.b  D0,($00E1,A4)
                            	   477:     ; Move the position markers 2 pixels down, because we
                            	   478:     ; overshot and reached vertical scroll $F2.
                            	   479:     ;
02:000402DC 7002            	   480:     moveq   #2,D0
                            	   481: ; Params:
                            	   482: ; A: vertical velocity of menu scrolling
                            	   483: ;
                            	   484: ;
                            	   485: ; [00] holds the vertical velocity of menu scrolling.
                            	   486:     even
                            	   487: MovePositionMarkers:
02:000402DE 1880            	   488:     move.b  D0,($0000,A4)
                            	   489:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   490:     ;
02:000402E0 102C0254        	   491:     move.b  ($0254,A4),D0
02:000402E4 0C0000F8        	   492:     cmpi.b  #$F8,D0
02:000402E8 670C            	   493:     beq  _anon_z05_5
02:000402EA 023C00EE        	   494:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402EE 1214            	   495:     move.b  ($0000,A4),D1
02:000402F0 D101            	   496:     addx.b  D1,D0   ; ADC $00
02:000402F2 19400254        	   497:     move.b  D0,($0254,A4)
                            	   498: _anon_z05_5:
                            	   499:     ; If in UW and have the compass, then move the triforce position marker.
                            	   500:     ;
02:000402F6 102C0010        	   501:     move.b  ($0010,A4),D0
02:000402FA 6606            	   502:     bne.s  __far_z_05_0002
02:000402FC 4EF90002D4F2    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:00040302 6100503E        	   505:     jsr     HasCompass
02:00040306 6606            	   506:     bne.s  __far_z_05_0003
02:00040308 4EF90002D4F2    	   507:     jmp  Exit
                            	   508: __far_z_05_0003:
02:0004030E 102C0258        	   509:     move.b  ($0258,A4),D0
02:00040312 023C00EE        	   510:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040316 1214            	   511:     move.b  ($0000,A4),D1
02:00040318 D101            	   512:     addx.b  D1,D0   ; ADC $00
02:0004031A 19400258        	   513:     move.b  D0,($0258,A4)
                            	   514:     even
