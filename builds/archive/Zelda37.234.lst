                            	  5698: 
                            	  5699: ; Params:
                            	  5700: ; A: frame image
                            	  5701: ; X: object index
                            	  5702: ; [00]: object X
                            	  5703: ; [01]: object Y
                            	  5704: ;
                            	  5705: ;
                            	  5706: ; Set [0C] mirrored.
