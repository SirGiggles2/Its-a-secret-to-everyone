                            	  7446: Dodongo_Draw:
02:0003CD5A 610000F4        	  7447:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7448:     ; Make a 5-way direction index out of the facing direction
                            	  7449:     ; by shifting right once, and store it in [00].
                            	  7450:     ;
02:0003CD5E 41EC0098        	  7451:     lea     ($0098,A4),A0
02:0003CD62 10302000        	  7452:     move.b  (A0,D2.W),D0
02:0003CD66 E208            	  7453:     lsr.b  #1,D0   ; LSR A
02:0003CD68 1880            	  7454:     move.b  D0,($0000,A4)
                            	  7455:     ; If state = 0, go handle animating the two frames of this state.
                            	  7456:     ;
02:0003CD6A 7600            	  7457:     moveq   #0,D3
02:0003CD6C 41EC00AC        	  7458:     lea     ($00AC,A4),A0
02:0003CD70 16302000        	  7459:     move.b  (A0,D2.W),D3
02:0003CD74 6744            	  7460:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7461:     ; If state > 1, then the monster is stunned (state 2).
                            	  7462:     ; So, go switch frames every $20 screen frames.
                            	  7463:     ;
02:0003CD76 7020            	  7464:     moveq   #32,D0
02:0003CD78 5303            	  7465:     subq.b  #1,D3
02:0003CD7A 6640            	  7466:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7467:     ; State = 1. Bloated.
                            	  7468:     ;
                            	  7469:     ; In substate 0, go animate as usual for walking.
                            	  7470:     ;
02:0003CD7C 7600            	  7471:     moveq   #0,D3
02:0003CD7E 41EC042C        	  7472:     lea     ($042C,A4),A0
02:0003CD82 16302000        	  7473:     move.b  (A0,D2.W),D3
02:0003CD86 6732            	  7474:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7475:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7476:     ; go fade the boss; so that some frames are not drawn.
                            	  7477:     ;
02:0003CD88 0C030002        	  7478:     cmpi.b  #$02,D3
02:0003CD8C 6718            	  7479:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CD8E 0C030003        	  7480:     cmpi.b  #$03,D3
02:0003CD92 6712            	  7481:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7482:     ; State 1, substate 1
                            	  7483:     ;
                            	  7484:     ; Add $14 to the frame image index to index into the bloated
                            	  7485:     ; frame images and H-flips.
                            	  7486:     ;
02:0003CD94 1014            	  7487:     move.b  ($0000,A4),D0
02:0003CD96 023C00EE        	  7488:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD9A 123C0014        	  7489:     move.b  #$14,D1
02:0003CD9E D101            	  7490:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CDA0 7600            	  7491:     moveq   #0,D3
02:0003CDA2 1600            	  7492:     move.b  D0,D3
02:0003CDA4 6032            	  7493:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7494: 
                            	  7495:     even
                            	  7496: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7497:     ; In bloated substates 2 and 3:
                            	  7498:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7499:     ;
02:0003CDA6 102C0015        	  7500:     move.b  ($0015,A4),D0
02:0003CDAA 02000002        	  7501:     andi.b #$02,D0
02:0003CDAE 6604            	  7502:     bne.s  __far_z_04_0066
02:0003CDB0 600000A6        	  7503:     jmp  L11B00_Exit
                            	  7504: __far_z_04_0066:
02:0003CDB4 7600            	  7505:     moveq   #0,D3
02:0003CDB6 1614            	  7506:     move.b  ($0000,A4),D3
02:0003CDB8 601E            	  7507:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7508: 
                            	  7509:     even
                            	  7510: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7511:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7512:     ;
02:0003CDBA 7008            	  7513:     moveq   #8,D0
                            	  7514:     even
                            	  7515: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CDBC 7600            	  7516:     moveq   #0,D3
02:0003CDBE 1614            	  7517:     move.b  ($0000,A4),D3
02:0003CDC0 122C0015        	  7518:     move.b  ($0015,A4),D1
02:0003CDC4 C001            	  7519:     and.b  D1,D0
02:0003CDC6 6710            	  7520:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7521:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7522:     ; in order to index into the second set of frame image numbers.
                            	  7523:     ;
02:0003CDC8 1003            	  7524:     move.b  D3,D0
02:0003CDCA 023C00EE        	  7525:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDCE 123C0005        	  7526:     move.b  #$05,D1
02:0003CDD2 D101            	  7527:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CDD4 7600            	  7528:     moveq   #0,D3
02:0003CDD6 1600            	  7529:     move.b  D0,D3
                            	  7530:     even
                            	  7531: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7532:     ; Start preparing sprites.
                            	  7533:     ;
02:0003CDD8 4EB90004CE4A    	  7534:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CDDE 1003            	  7535:     move.b  D3,D0
02:0003CDE0 1B00            	  7536:     move.b  D0,-(A5)  ; PHA
                            	  7537:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7538:     ;
02:0003CDE2 41F90003CD3C    	  7539:     lea     (DodongoFrameHFlips).l,A0
02:0003CDE8 10303000        	  7540:     move.b  (A0,D3.W),D0
02:0003CDEC 1940000F        	  7541:     move.b  D0,($000F,A4)
02:0003CDF0 41F90003CD32    	  7542:     lea     (DodongoFrameImages).l,A0
02:0003CDF6 10303000        	  7543:     move.b  (A0,D3.W),D0
                            	  7544:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7545:     ; They are drawn mirrored.
                            	  7546:     ;
02:0003CDFA 0C000007        	  7547:     cmpi.b  #$07,D0
02:0003CDFE 6706            	  7548:     beq  _anon_z04_92
02:0003CE00 0C000009        	  7549:     cmpi.b  #$09,D0
02:0003CE04 6608            	  7550:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7551: _anon_z04_92:
02:0003CE06 4EB900031940    	  7552:     jsr     DrawObjectMirrored
02:0003CE0C 6006            	  7553:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7554: 
                            	  7555:     even
                            	  7556: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7557:     ; No other frame images are mirrored.
                            	  7558:     ;
02:0003CE0E 4EB900031944    	  7559:     jsr     DrawObjectNotMirrored
                            	  7560:     even
                            	  7561: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CE14 101D            	  7562:     move.b  (A5)+,D0  ; PLA
02:0003CE16 7600            	  7563:     moveq   #0,D3
02:0003CE18 1600            	  7564:     move.b  D0,D3
                            	  7565:     ; If facing vertically, then return. There's no other side to draw.
                            	  7566:     ;
02:0003CE1A 41EC0098        	  7567:     lea     ($0098,A4),A0
02:0003CE1E 10302000        	  7568:     move.b  (A0,D2.W),D0
02:0003CE22 02000003        	  7569:     andi.b #$03,D0
02:0003CE26 6602            	  7570:     bne.s  __far_z_04_0067
02:0003CE28 602E            	  7571:     jmp  L11B00_Exit
                            	  7572: __far_z_04_0067:
                            	  7573:     ; Else draw the right side.
                            	  7574:     ;
                            	  7575:     ; Keep the Y coordinate in [01].
                            	  7576:     ; But, store (X + $10) in [00].
                            	  7577:     ;
02:0003CE2A 10342070        	  7578:     move.b  ($70,A4,D2.W),D0
02:0003CE2E 023C00EE        	  7579:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE32 123C0010        	  7580:     move.b  #$10,D1
02:0003CE36 D101            	  7581:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CE38 1880            	  7582:     move.b  D0,($0000,A4)
02:0003CE3A 6114            	  7583:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7584:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7585:     ;
                            	  7586:     ; So, if we had animation frame 1, direction left:
                            	  7587:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7588:     ; - frame image index = 6 (1 + 5)
                            	  7589:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7590:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7591:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7592:     ;
                            	  7593:     ; So, 3 would have been the frame number used above for
                            	  7594:     ; the left side.
                            	  7595:     ;
                            	  7596:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7597:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7598:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7599:     ; on the right.
                            	  7600:     ;
02:0003CE3C 41F90003CD32    	  7601:     lea     (DodongoFrameImages).l,A0
02:0003CE42 10303000        	  7602:     move.b  (A0,D3.W),D0
02:0003CE46 0A000001        	  7603:     eori.b #$01,D0
02:0003CE4A 4EF900031944    	  7604:     jmp     DrawObjectNotMirrored
                            	  7605: 
                            	  7606: ; Returns:
                            	  7607: ; A: 3
                            	  7608: ; [04]: left sprite attributes
                            	  7609: ; [05]: right sprite attributes
                            	  7610: ;
                            	  7611:     even
                            	  7612: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CE50 7003            	  7613:     moveq   #3,D0
02:0003CE52 4EB900031C36    	  7614:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7615:     even
