                            	  9709: Manhandla_Draw:
02:0003DE64 4EB90004CE4A    	  9710:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9711:     ; Push the "frame image and sprite attributes" value.
                            	  9712:     ;
02:0003DE6A 41EC0478        	  9713:     lea     ($0478,A4),A0
02:0003DE6E 10302000        	  9714:     move.b  (A0,D2.W),D0
02:0003DE72 1B00            	  9715:     move.b  D0,-(A5)  ; PHA
                            	  9716:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9717:     ; passed along as is.
                            	  9718:     ;
02:0003DE74 02000080        	  9719:     andi.b #$80,D0
02:0003DE78 00000001        	  9720:     ori.b #$01,D0
02:0003DE7C 4EB900031C36    	  9721:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DE82 101D            	  9722:     move.b  (A5)+,D0  ; PLA
02:0003DE84 1B00            	  9723:     move.b  D0,-(A5)  ; PHA
                            	  9724:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9725:     ;
02:0003DE86 02000040        	  9726:     andi.b #$40,D0
02:0003DE8A 6704            	  9727:     beq  _anon_z04_116
02:0003DE8C 522C000F        	  9728:     addq.b  #1,($000F,A4)
                            	  9729: _anon_z04_116:
02:0003DE90 101D            	  9730:     move.b  (A5)+,D0  ; PLA
                            	  9731:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9732:     ; These are the 2 frame images of the horizontal hands.
                            	  9733:     ;
                            	  9734:     ; Else draw the base and vertical hands mirrored.
                            	  9735:     ;
02:0003DE92 0200000F        	  9736:     andi.b #$0F,D0
02:0003DE96 0C000002        	  9737:     cmpi.b  #$02,D0
02:0003DE9A 670C            	  9738:     beq  _anon_z04_117
02:0003DE9C 0C000003        	  9739:     cmpi.b  #$03,D0
02:0003DEA0 6706            	  9740:     beq  _anon_z04_117
02:0003DEA2 4EF900031940    	  9741:     jmp     DrawObjectMirrored
