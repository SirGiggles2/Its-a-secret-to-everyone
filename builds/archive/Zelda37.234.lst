02:00034F6A 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00034F6E 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00034F72 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00034F76 5303            	  2595:     subq.b  #1,D3
02:00034F78 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034F7A 19430306        	  2597:     move.b  D3,($0306,A4)
02:00034F7E 7400            	  2598:     moveq   #0,D2
02:00034F80 142C0421        	  2599:     move.b  ($0421,A4),D2
