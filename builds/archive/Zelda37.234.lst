                            	   773: UpdateBlock0Idle:
                            	   774:     ; If there are monsters in the room, go reset the push timer and return.
                            	   775:     ;
02:00039DD2 102C034D        	   776:     move.b  ($034D,A4),D0
02:00039DD6 6604            	   777:     bne.s  __far_z_04_0005
02:00039DD8 600000DA        	   778:     jmp  ResetPushTimer
                            	   779: __far_z_04_0005:
                            	   780:     ; If Link's X is aligned with the block's, then get the difference
                            	   781:     ; between Link's (Y + 3) and the block's Y.
                            	   782:     ; Then go test the difference.
                            	   783:     ;
02:00039DDC 102C0070        	   784:     move.b  ($0070,A4),D0
02:00039DE0 12342070        	   785:     move.b  ($70,A4,D2.W),D1
02:00039DE4 B001            	   786:     cmp.b   D1,D0
02:00039DE6 6628            	   787:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039DE8 7600            	   788:     moveq   #0,D3
02:00039DEA 102C0084        	   789:     move.b  ($0084,A4),D0
02:00039DEE 023C00EE        	   790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039DF2 123C0003        	   791:     move.b  #$03,D1
02:00039DF6 D101            	   792:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039DF8 003C0011        	   793:     ori     #$11,CCR  ; SEC: set C+X
02:00039DFC 41EC0084        	   794:     lea     ($0084,A4),A0
02:00039E00 12302000        	   795:     move.b  (A0,D2.W),D1
02:00039E04 0A3C0010        	   796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039E08 9101            	   797:     subx.b  D1,D0   ; SBC ObjY,X
02:00039E0A 0A3C0010        	   798:     eori    #$10,CCR  ; restore X = 6502 C
02:00039E0E 6036            	   799:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   800: 
                            	   801:     even
                            	   802: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   803:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   804:     ; go reset the push timer.
                            	   805:     ;
02:00039E10 102C0084        	   806:     move.b  ($0084,A4),D0
02:00039E14 023C00EE        	   807:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E18 123C0003        	   808:     move.b  #$03,D1
02:00039E1C D101            	   809:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039E1E 41EC0084        	   810:     lea     ($0084,A4),A0
02:00039E22 12302000        	   811:     move.b  (A0,D2.W),D1
02:00039E26 B001            	   812:     cmp.b   D1,D0
02:00039E28 6704            	   813:     beq.s  __far_z_04_0006
02:00039E2A 60000088        	   814:     jmp  ResetPushTimer
                            	   815: __far_z_04_0006:
                            	   816:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   817:     ; Get the difference in X.
                            	   818:     ;
02:00039E2E 7602            	   819:     moveq   #2,D3
02:00039E30 102C0070        	   820:     move.b  ($0070,A4),D0
02:00039E34 003C0011        	   821:     ori     #$11,CCR  ; SEC: set C+X
02:00039E38 12342070        	   822:     move.b  ($70,A4,D2.W),D1
02:00039E3C 0A3C0010        	   823:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039E40 9101            	   824:     subx.b  D1,D0   ; SBC ObjX,X
02:00039E42 0A3C0010        	   825:     eori    #$10,CCR  ; restore X = 6502 C
                            	   826:     even
                            	   827: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   828:     ; If the difference in coordinates is negative, then Link is
                            	   829:     ; up or left of the block.
                            	   830:     ;
                            	   831:     ; In that case, increase Y register to index the correct opposite
                            	   832:     ; direction below. Also, negate the difference, so we test
                            	   833:     ; positive values.
                            	   834:     ;
02:00039E46 6A08            	   835:     bpl  _anon_z04_14
02:00039E48 5203            	   836:     addq.b  #1,D3
02:00039E4A 4EB900030DF8    	   837:     jsr     Negate
                            	   838: _anon_z04_14:
                            	   839:     ; If the distance >= $11, then go reset the push timer and return.
                            	   840:     ;
02:00039E50 0C000011        	   841:     cmpi.b  #$11,D0
02:00039E54 6502            	   842:     bcs.s  __far_z_04_0007
02:00039E56 605C            	   843:     jmp  ResetPushTimer
                            	   844: __far_z_04_0007:
                            	   845:     ; At this point, Link is aligned with the block.
                            	   846:     ;
                            	   847:     ; If the input direction is not the required direction based on
                            	   848:     ; Link's placement; then go reset the push timer and return.
                            	   849:     ;
02:00039E58 102C03F8        	   850:     move.b  ($03F8,A4),D0
02:00039E5C 41F900039DB0    	   851:     lea     (BlockPushDirections).l,A0
02:00039E62 12303000        	   852:     move.b  (A0,D3.W),D1
02:00039E66 B001            	   853:     cmp.b   D1,D0
02:00039E68 6702            	   854:     beq.s  __far_z_04_0008
02:00039E6A 6048            	   855:     jmp  ResetPushTimer
                            	   856: __far_z_04_0008:
                            	   857:     ; Link is truly pushing the block.
                            	   858:     ;
                            	   859:     ; Increase the push timer.
                            	   860:     ;
02:00039E6C 41EC0412        	   861:     lea     ($0412,A4),A0
02:00039E70 52302000        	   862:     addq.b  #1,(A0,D2.W)
                            	   863:     ; If the push timer still < $10, return.
                            	   864:     ;
02:00039E74 7600            	   865:     moveq   #0,D3
02:00039E76 41EC0412        	   866:     lea     ($0412,A4),A0
02:00039E7A 16302000        	   867:     move.b  (A0,D2.W),D3
02:00039E7E 0C030010        	   868:     cmpi.b  #$10,D3
02:00039E82 6402            	   869:     bcc.s  __far_z_04_0009
02:00039E84 6034            	   870:     jmp  L10262_Exit
