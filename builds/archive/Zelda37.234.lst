02:00044534 020000F0        	  7293:     andi.b #$F0,D0
                            	  7294:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7295:     ; the height of each row.
                            	  7296:     ;
02:00044538 003C0011        	  7297:     ori     #$11,CCR  ; SEC: set C+X
02:0004453C 123C0040        	  7298:     move.b  #$40,D1
02:00044540 0A3C0010        	  7299:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044544 9101            	  7300:     subx.b  D1,D0   ; SBC #$40
02:00044546 0A3C0010        	  7301:     eori    #$10,CCR  ; restore X = 6502 C
02:0004454A E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0004454C E208            	  7303:     lsr.b  #1,D0   ; LSR A
02:0004454E E208            	  7304:     lsr.b  #1,D0   ; LSR A
                            	  7305:     ; Add this row offset to the column address.
                            	  7306:     ;
02:00044550 4EB900031246    	  7307:     jsr     AddToInt16At0
                            	  7308:     ; Assume that we'll write a type 1 square with primary square
                            	  7309:     ; taken from [05]. If so, the square index doesn't matter
                            	  7310:     ; as long as >= $10. See WriteSquareOW.
                            	  7311:     ;
02:00044556 7600            	  7312:     moveq   #0,D3
02:00044558 7410            	  7313:     moveq   #16,D2
02:0004455A 102C0005        	  7314:     move.b  ($0005,A4),D0
                            	  7315:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7316:     ; So, we have to look up the square index corresponding
                            	  7317:     ; to primary square/tile in [05].
                            	  7318:     ;
