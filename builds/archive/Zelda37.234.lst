                            	  3320: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3321:     ; Begin with the leever's Y set to Link's Y.
                            	  3322:     ;
02:0003AFC0 102C0084        	  3323:     move.b  ($0084,A4),D0
02:0003AFC4 41EC0084        	  3324:     lea     ($0084,A4),A0
02:0003AFC8 11802000        	  3325:     move.b  D0,(A0,D2.W)
                            	  3326:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3327:     ; it's too close to the top edge of the screen. So, return.
                            	  3328:     ;
02:0003AFCC 0C00005D        	  3329:     cmpi.b  #$5D,D0
02:0003AFD0 65EC            	  3330:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3331:     ; If facing right, then use X offset $28.
                            	  3332:     ; Else store X offset -$28 in [00].
                            	  3333:     ;
02:0003AFD2 7628            	  3334:     moveq   #40,D3
02:0003AFD4 41EC0098        	  3335:     lea     ($0098,A4),A0
02:0003AFD8 10302000        	  3336:     move.b  (A0,D2.W),D0
02:0003AFDC 02000002        	  3337:     andi.b #$02,D0
02:0003AFE0 6704            	  3338:     beq  _anon_z04_45
02:0003AFE2 163C00D8        	  3339:     move.b  #$D8,D3
                            	  3340: _anon_z04_45:
02:0003AFE6 1883            	  3341:     move.b  D3,($0000,A4)
                            	  3342:     ; [01] holds Link's X coordinate.
                            	  3343:     ;
02:0003AFE8 102C0070        	  3344:     move.b  ($0070,A4),D0
02:0003AFEC 19400001        	  3345:     move.b  D0,($0001,A4)
                            	  3346:     ; Add Link's X and the horizontal offset.
                            	  3347:     ;
02:0003AFF0 023C00EE        	  3348:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFF4 1214            	  3349:     move.b  ($0000,A4),D1
02:0003AFF6 D101            	  3350:     addx.b  D1,D0   ; ADC $00
                            	  3351:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3352:     ;
02:0003AFF8 020000F8        	  3353:     andi.b #$F8,D0
                            	  3354:     ; Assign that result to the leever's X coordinate and [02].
                            	  3355:     ;
02:0003AFFC 19802070        	  3356:     move.b  D0,($70,A4,D2.W)
02:0003B000 19400002        	  3357:     move.b  D0,($0002,A4)
                            	  3358:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3359:     ;
02:0003B004 122C0001        	  3360:     move.b  ($0001,A4),D1
02:0003B008 B001            	  3361:     cmp.b   D1,D0
02:0003B00A 6510            	  3362:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003B00C 1B00            	  3363:     move.b  D0,-(A5)  ; PHA
02:0003B00E 102C0001        	  3364:     move.b  ($0001,A4),D0
02:0003B012 19400002        	  3365:     move.b  D0,($0002,A4)
02:0003B016 101D            	  3366:     move.b  (A5)+,D0  ; PLA
02:0003B018 19400001        	  3367:     move.b  D0,($0001,A4)
                            	  3368:     even
                            	  3369: _L_z04_UpdateRedLeever_Subtract:
                            	  3370:     ; The point is to get the absolute distance between the two.
                            	  3371:     ;
02:0003B01C 102C0001        	  3372:     move.b  ($0001,A4),D0
02:0003B020 003C0011        	  3373:     ori     #$11,CCR  ; SEC: set C+X
02:0003B024 122C0002        	  3374:     move.b  ($0002,A4),D1
02:0003B028 0A3C0010        	  3375:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B02C 9101            	  3376:     subx.b  D1,D0   ; SBC $02
02:0003B02E 0A3C0010        	  3377:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3378:     ; If the absolute distance >= $30, then return.
                            	  3379:     ; It means that the leever's X coordinate wrapped around
                            	  3380:     ; the left or right edge of the screen.
                            	  3381:     ;
02:0003B032 0C000030        	  3382:     cmpi.b  #$30,D0
02:0003B036 6486            	  3383:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3384:     even
                            	  3385: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3386:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3387:     ;
02:0003B038 4EB90004B754    	  3388:     jsr     GetCollidableTileStill
02:0003B03E 122C034A        	  3389:     move.b  ($034A,A4),D1
02:0003B042 B001            	  3390:     cmp.b   D1,D0
02:0003B044 6400FF78        	  3391:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003B048 522C0510        	  3392:     addq.b  #1,($0510,A4)
                            	  3393:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3394:     ; and pick up whatever the new value is for state 1.
                            	  3395:     ;
02:0003B04C 7001            	  3396:     moveq   #1,D0
02:0003B04E 41EC03D0        	  3397:     lea     ($03D0,A4),A0
02:0003B052 11802000        	  3398:     move.b  D0,(A0,D2.W)
                            	  3399:     ; Set the long timer to 2, meaning 20 frames.
                            	  3400:     ;
02:0003B056 E308            	  3401:     lsl.b  #1,D0   ; ASL A
02:0003B058 1940004D        	  3402:     move.b  D0,($004D,A4)
02:0003B05C 6100008C        	  3403:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3404:     ; The leever has to face Link in order to move toward him.
                            	  3405:     ;
02:0003B060 4EB90004BD2A    	  3406:     jsr     ReverseObjDir
                            	  3407:     even
                            	  3408: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  3409:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  3410:     ;
02:0003B066 41EC00AC        	  3411:     lea     ($00AC,A4),A0
02:0003B06A 10302000        	  3412:     move.b  (A0,D2.W),D0
02:0003B06E 0C000003        	  3413:     cmpi.b  #$03,D0
