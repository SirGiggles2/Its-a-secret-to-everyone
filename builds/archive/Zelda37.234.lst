02:0003DED4 11802000        	  9770:     move.b  D0,(A0,D2.W)
                            	  9771:     ; Now we can go straight without changing direction for some time.
                            	  9772:     ;
02:0003DED8 41EC0451        	  9773:     lea     ($0451,A4),A0
02:0003DEDC 52302000        	  9774:     addq.b  #1,(A0,D2.W)
                            	  9775:     ; Go animate the eye.
                            	  9776:     ;
02:0003DEE0 600000C6        	  9777:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9778: 
                            	  9779:     even
                            	  9780: _L_z04_UpdateGohma_Move:
                            	  9781:     ; Add $80 to the movement accumulator.
                            	  9782:     ;
02:0003DEE4 41EC041F        	  9783:     lea     ($041F,A4),A0
02:0003DEE8 10302000        	  9784:     move.b  (A0,D2.W),D0
02:0003DEEC 023C00EE        	  9785:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEF0 123C0080        	  9786:     move.b  #$80,D1
02:0003DEF4 D101            	  9787:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DEF6 41EC041F        	  9788:     lea     ($041F,A4),A0
02:0003DEFA 11802000        	  9789:     move.b  D0,(A0,D2.W)
                            	  9790:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9791:     ;
02:0003DEFE 640000A8        	  9792:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9793:     ; Increase the distance traveled, and move 1.
                            	  9794:     ;
02:0003DF02 41EC0412        	  9795:     lea     ($0412,A4),A0
02:0003DF06 52302000        	  9796:     addq.b  #1,(A0,D2.W)
                            	  9797:     ; Set a direction mask in [02], starting with right (1).
                            	  9798:     ;
02:0003DF0A 7001            	  9799:     moveq   #1,D0
02:0003DF0C 19400002        	  9800:     move.b  D0,($0002,A4)
                            	  9801:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9802:     ;
02:0003DF10 41EC0098        	  9803:     lea     ($0098,A4),A0
02:0003DF14 10302000        	  9804:     move.b  (A0,D2.W),D0
02:0003DF18 122C0002        	  9805:     move.b  ($0002,A4),D1
02:0003DF1C C200            	  9806:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF1E 6704            	  9807:     beq  _anon_z04_118
02:0003DF20 52342070        	  9808:     addq.b  #1,($70,A4,D2.W)
                            	  9809: _anon_z04_118:
                            	  9810:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9811:     ;
02:0003DF24 122C0002        	  9812:     move.b  ($0002,A4),D1
02:0003DF28 E309            	  9813:     lsl.b  #1,D1   ; ASL $02
02:0003DF2A 19410002        	  9814:     move.b  D1,($0002,A4)
02:0003DF2E 122C0002        	  9815:     move.b  ($0002,A4),D1
02:0003DF32 C200            	  9816:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF34 6704            	  9817:     beq  _anon_z04_119
02:0003DF36 53342070        	  9818:     subq.b  #1,($70,A4,D2.W)
                            	  9819: _anon_z04_119:
                            	  9820:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9821:     ;
02:0003DF3A 122C0002        	  9822:     move.b  ($0002,A4),D1
02:0003DF3E E309            	  9823:     lsl.b  #1,D1   ; ASL $02
02:0003DF40 19410002        	  9824:     move.b  D1,($0002,A4)
02:0003DF44 122C0002        	  9825:     move.b  ($0002,A4),D1
02:0003DF48 C200            	  9826:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF4A 6708            	  9827:     beq  _anon_z04_120
02:0003DF4C 41EC0084        	  9828:     lea     ($0084,A4),A0
02:0003DF50 52302000        	  9829:     addq.b  #1,(A0,D2.W)
                            	  9830: _anon_z04_120:
                            	  9831:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9832:     ;
02:0003DF54 122C0002        	  9833:     move.b  ($0002,A4),D1
02:0003DF58 E309            	  9834:     lsl.b  #1,D1   ; ASL $02
02:0003DF5A 19410002        	  9835:     move.b  D1,($0002,A4)
02:0003DF5E 122C0002        	  9836:     move.b  ($0002,A4),D1
02:0003DF62 C200            	  9837:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF64 6708            	  9838:     beq  _anon_z04_121
02:0003DF66 41EC0084        	  9839:     lea     ($0084,A4),A0
02:0003DF6A 53302000        	  9840:     subq.b  #1,(A0,D2.W)
                            	  9841: _anon_z04_121:
                            	  9842:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9843:     ;
02:0003DF6E 41EC0412        	  9844:     lea     ($0412,A4),A0
02:0003DF72 10302000        	  9845:     move.b  (A0,D2.W),D0
02:0003DF76 0C000020        	  9846:     cmpi.b  #$20,D0
02:0003DF7A 662C            	  9847:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9848:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9849:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9850:     ;
02:0003DF7C 7000            	  9851:     moveq   #0,D0
02:0003DF7E 41EC0412        	  9852:     lea     ($0412,A4),A0
02:0003DF82 11802000        	  9853:     move.b  D0,(A0,D2.W)
02:0003DF86 61001CFE        	  9854:     jsr     ReverseObjDir8
02:0003DF8A 41EC045E        	  9855:     lea     ($045E,A4),A0
02:0003DF8E 10302000        	  9856:     move.b  (A0,D2.W),D0
02:0003DF92 41EC045E        	  9857:     lea     ($045E,A4),A0
02:0003DF96 52302000        	  9858:     addq.b  #1,(A0,D2.W)
                            	  9859:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9860:     ; should randomly change direction.
                            	  9861:     ;
02:0003DF9A E208            	  9862:     lsr.b  #1,D0   ; LSR A
02:0003DF9C 640A            	  9863:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DF9E 7000            	  9864:     moveq   #0,D0
02:0003DFA0 41EC0451        	  9865:     lea     ($0451,A4),A0
02:0003DFA4 11802000        	  9866:     move.b  D0,(A0,D2.W)
                            	  9867:     even
                            	  9868: _L_z04_UpdateGohma_AnimateEye:
                            	  9869:     ; Animate the eye.
                            	  9870:     ;
                            	  9871:     ; First, if the counter for when to open the eye next = 0, then
                            	  9872:     ; set it to a random value at least $C0; and set the timer for
                            	  9873:     ; keeping the eye open to $80.
                            	  9874:     ;
                            	  9875:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9876:     ; every other frame.
                            	  9877:     ;
02:0003DFA8 41EC042C        	  9878:     lea     ($042C,A4),A0
02:0003DFAC 10302000        	  9879:     move.b  (A0,D2.W),D0
02:0003DFB0 661E            	  9880:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DFB2 103C0080        	  9881:     move.b  #$80,D0
02:0003DFB6 41EC0444        	  9882:     lea     ($0444,A4),A0
02:0003DFBA 11802000        	  9883:     move.b  D0,(A0,D2.W)
02:0003DFBE 103C00C0        	  9884:     move.b  #$C0,D0
02:0003DFC2 12342018        	  9885:     move.b  ($18,A4,D2.W),D1
02:0003DFC6 8001            	  9886:     or.b  D1,D0
02:0003DFC8 41EC042C        	  9887:     lea     ($042C,A4),A0
02:0003DFCC 11802000        	  9888:     move.b  D0,(A0,D2.W)
                            	  9889:     even
                            	  9890: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9891:     ; Decrement the next-open-eye counter.
                            	  9892:     ;
02:0003DFD0 102C0015        	  9893:     move.b  ($0015,A4),D0
02:0003DFD4 E208            	  9894:     lsr.b  #1,D0   ; LSR A
02:0003DFD6 6408            	  9895:     bcc  _anon_z04_122
02:0003DFD8 41EC042C        	  9896:     lea     ($042C,A4),A0
02:0003DFDC 53302000        	  9897:     subq.b  #1,(A0,D2.W)
                            	  9898: _anon_z04_122:
                            	  9899:     ; If open eye timer = 0, then the eye is closed.
                            	  9900:     ; Go animate it differently.
                            	  9901:     ;
02:0003DFE0 41EC0444        	  9902:     lea     ($0444,A4),A0
02:0003DFE4 10302000        	  9903:     move.b  (A0,D2.W),D0
02:0003DFE8 674A            	  9904:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9905:     ; Else decrement the open eye timer.
                            	  9906:     ;
02:0003DFEA 41EC0444        	  9907:     lea     ($0444,A4),A0
02:0003DFEE 53302000        	  9908:     subq.b  #1,(A0,D2.W)
                            	  9909:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9910:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9911:     ;
02:0003DFF2 7602            	  9912:     moveq   #2,D3
02:0003DFF4 0C000070        	  9913:     cmpi.b  #$70,D0
02:0003DFF8 6408            	  9914:     bcc  _anon_z04_123
02:0003DFFA 0C000010        	  9915:     cmpi.b  #$10,D0
02:0003DFFE 6502            	  9916:     bcs  _anon_z04_123
02:0003E000 5203            	  9917:     addq.b  #1,D3
                            	  9918: _anon_z04_123:
02:0003E002 1003            	  9919:     move.b  D3,D0
                            	  9920:     even
                            	  9921: _L_z04_UpdateGohma_SetEyeStateAndShoot:
02:0003E004 41EC046B        	  9922:     lea     ($046B,A4),A0
02:0003E008 11802000        	  9923:     move.b  D0,(A0,D2.W)
                            	  9924:     even
                            	  9925: _L_z04_UpdateGohma_ShootAnimateCollide:
                            	  9926:     ; Decrement the shoot timer.
                            	  9927:     ;
02:0003E00C 41EC0380        	  9928:     lea     ($0380,A4),A0
02:0003E010 53302000        	  9929:     subq.b  #1,(A0,D2.W)
                            	  9930:     ; If it became 0, then set it to $41, and shoot fireball $56.
                            	  9931:     ;
02:0003E014 6610            	  9932:     bne  _L_z04_UpdateGohma_AnimateAndCheckCollisions
02:0003E016 7041            	  9933:     moveq   #65,D0
02:0003E018 41EC0380        	  9934:     lea     ($0380,A4),A0
02:0003E01C 11802000        	  9935:     move.b  D0,(A0,D2.W)
