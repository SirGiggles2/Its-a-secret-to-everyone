                            	  1979: RedLeever_CycleStateDrawAndCheckCollisions:
                            	  1980:     ; Cycle the state between 0 and 5.
                            	  1981:     ;
                            	  1982:     ; If a cycle was completed (wrapped around to 0),
                            	  1983:     ; then decrease the active red leever count.
                            	  1984:     ;
02:00038F0A 41EC00AC        	  1985:     lea     ($00AC,A4),A0
02:00038F0E 10302000        	  1986:     move.b  (A0,D2.W),D0
02:00038F12 023C00EE        	  1987:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038F16 123C0001        	  1988:     move.b  #$01,D1
02:00038F1A D101            	  1989:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038F1C 0C000006        	  1990:     cmpi.b  #$06,D0
02:00038F20 6506            	  1991:     bcs  _anon_z04_47
02:00038F22 532C0510        	  1992:     subq.b  #1,($0510,A4)
02:00038F26 7000            	  1993:     moveq   #0,D0
                            	  1994: _anon_z04_47:
02:00038F28 41EC00AC        	  1995:     lea     ($00AC,A4),A0
02:00038F2C 11802000        	  1996:     move.b  D0,(A0,D2.W)
                            	  1997:     ; Look up and set the speed, timer, and animation counter
                            	  1998:     ; for the current state.
