                            	  7425:     ; at an even index.
                            	  7426:     ;
02:0003B744 102C04D7        	  7427:     move.b  ($04D7,A4),D0
02:0003B748 E308            	  7428:     lsl.b  #1,D0   ; ASL A
02:0003B74A E308            	  7429:     lsl.b  #1,D0   ; ASL A
