                            	  7923:     ; In UW. There are two input directions, and they're both walkable.
                            	  7924:     ;
                            	  7925:     ; Normally, turn to the direction that's perpendicular to object
                            	  7926:     ; direction. But keep going straight after that, while diagonal
                            	  7927:     ; input is held.
                            	  7928:     ;
                            	  7929:     ; Handle special cases for doors.
                            	  7930:     ;
                            	  7931:     ;
                            	  7932:     ; 1. Link at horizontal doors.
                            	  7933:     ;
                            	  7934:     ; If Link's X = $20 or $D0 then
                            	  7935:     ;   If Link's Y = $85 and facing down then
                            	  7936:     ;     Go set object direction and input direction to object
                            	  7937:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7938:     ;     Link_GoStraightWhenDiagInput.
