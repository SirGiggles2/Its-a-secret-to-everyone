                            	  2238: .oam_tile_bias_tbl:
02:0002ACDC 0000            	  2239:     dc.w    0                   ; NES sub-pal 0 → shared bank A @ VRAM $0000
02:0002ACDE 0200            	  2240:     dc.w    512                 ; NES sub-pal 1 → bank B @ VRAM $4000 (tile 512)
02:0002ACE0 0400            	  2241:     dc.w    1024                ; NES sub-pal 2 → bank C @ VRAM $8000 (tile 1024)
02:0002ACE2 0000            	  2242:     dc.w    0                   ; NES sub-pal 3 → shared bank A @ VRAM $0000
                            	  2243: .oam_pal_bits_tbl:
02:0002ACE4 0000            	  2244:     dc.w    $0000               ; sub-pal 0 → PAL0 (bits 14:13 = 00)
02:0002ACE6 0000            	  2245:     dc.w    $0000               ; sub-pal 1 → PAL0
02:0002ACE8 0000            	  2246:     dc.w    $0000               ; sub-pal 2 → PAL0
02:0002ACEA 2000            	  2247:     dc.w    $2000               ; sub-pal 3 → PAL1 (bits 14:13 = 01)
                            	  2248:     endc
