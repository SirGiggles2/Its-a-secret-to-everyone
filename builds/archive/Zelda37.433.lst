                            	  4404: Digdogger_Move:
                            	  4405:     ; This calculation is the same one used in Manhandla to
                            	  4406:     ; manifest the fractional speed over several frames.
                            	  4407:     ;
                            	  4408:     ; To summarize, the formula is:
                            	  4409:     ;
                            	  4410:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4411:     ;
                            	  4412:     ;   SA := SA + (SL AND $E0)
                            	  4413:     ;   [03] := SH + carry
                            	  4414:     ;
                            	  4415:     ; See 04:A28E Manhandla_Move.
                            	  4416:     ;
02:0003A04A 41EC041F        	  4417:     lea     ($041F,A4),A0
02:0003A04E 10302000        	  4418:     move.b  (A0,D2.W),D0
02:0003A052 020000E0        	  4419:     andi.b #$E0,D0
02:0003A056 023C00EE        	  4420:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A05A 41EC0412        	  4421:     lea     ($0412,A4),A0
02:0003A05E 12302000        	  4422:     move.b  (A0,D2.W),D1
02:0003A062 D101            	  4423:     addx.b  D1,D0   ; ADC $0412,X
02:0003A064 41EC0412        	  4424:     lea     ($0412,A4),A0
02:0003A068 11802000        	  4425:     move.b  D0,(A0,D2.W)
                            	  4426:     ; Assign (high speed byte + carry) to [03].
                            	  4427:     ;
02:0003A06C 41EC042C        	  4428:     lea     ($042C,A4),A0
02:0003A070 10302000        	  4429:     move.b  (A0,D2.W),D0
02:0003A074 123C0000        	  4430:     move.b  #$00,D1
02:0003A078 D101            	  4431:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A07A 19400003        	  4432:     move.b  D0,($0003,A4)
                            	  4433:     ; Change coordinates by the speed amount/offset in [03]
                            	  4434:     ; according to the direction.
                            	  4435:     ;
                            	  4436:     ; Start with a mask of $A1 in [02]:
                            	  4437:     ; - low nibble represents the right direction
                            	  4438:     ; - high nibble is used to set or clear carry as we go along
                            	  4439:     ;
02:0003A07E 103C00A1        	  4440:     move.b  #$A1,D0
02:0003A082 19400002        	  4441:     move.b  D0,($0002,A4)
                            	  4442:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4443:     ;
02:0003A086 41EC0098        	  4444:     lea     ($0098,A4),A0
02:0003A08A 10302000        	  4445:     move.b  (A0,D2.W),D0
02:0003A08E 122C0002        	  4446:     move.b  ($0002,A4),D1
02:0003A092 C200            	  4447:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A094 6712            	  4448:     beq  _L_z04_Digdogger_Move_Left
02:0003A096 10342070        	  4449:     move.b  ($70,A4,D2.W),D0
02:0003A09A 023C00EE        	  4450:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A09E 122C0003        	  4451:     move.b  ($0003,A4),D1
02:0003A0A2 D101            	  4452:     addx.b  D1,D0   ; ADC $03
02:0003A0A4 19802070        	  4453:     move.b  D0,($70,A4,D2.W)
                            	  4454:     even
                            	  4455: _L_z04_Digdogger_Move_Left:
                            	  4456:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  4457:     ;
02:0003A0A8 41EC0098        	  4458:     lea     ($0098,A4),A0
02:0003A0AC 10302000        	  4459:     move.b  (A0,D2.W),D0
02:0003A0B0 122C0002        	  4460:     move.b  ($0002,A4),D1
02:0003A0B4 E309            	  4461:     lsl.b  #1,D1   ; ASL $02
02:0003A0B6 19410002        	  4462:     move.b  D1,($0002,A4)
02:0003A0BA 122C0002        	  4463:     move.b  ($0002,A4),D1
02:0003A0BE C200            	  4464:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A0C0 6716            	  4465:     beq  _L_z04_Digdogger_Move_Down
02:0003A0C2 10342070        	  4466:     move.b  ($70,A4,D2.W),D0
02:0003A0C6 122C0003        	  4467:     move.b  ($0003,A4),D1
02:0003A0CA 0A3C0010        	  4468:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A0CE 9101            	  4469:     subx.b  D1,D0   ; SBC $03
02:0003A0D0 0A3C0010        	  4470:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A0D4 19802070        	  4471:     move.b  D0,($70,A4,D2.W)
                            	  4472:     even
                            	  4473: _L_z04_Digdogger_Move_Down:
                            	  4474:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  4475:     ;
02:0003A0D8 41EC0098        	  4476:     lea     ($0098,A4),A0
02:0003A0DC 10302000        	  4477:     move.b  (A0,D2.W),D0
02:0003A0E0 122C0002        	  4478:     move.b  ($0002,A4),D1
02:0003A0E4 E309            	  4479:     lsl.b  #1,D1   ; ASL $02
02:0003A0E6 19410002        	  4480:     move.b  D1,($0002,A4)
02:0003A0EA 122C0002        	  4481:     move.b  ($0002,A4),D1
02:0003A0EE C200            	  4482:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A0F0 6716            	  4483:     beq  _L_z04_Digdogger_Move_Up
02:0003A0F2 41EC0084        	  4484:     lea     ($0084,A4),A0
02:0003A0F6 10302000        	  4485:     move.b  (A0,D2.W),D0
02:0003A0FA 122C0003        	  4486:     move.b  ($0003,A4),D1
02:0003A0FE D101            	  4487:     addx.b  D1,D0   ; ADC $03
02:0003A100 41EC0084        	  4488:     lea     ($0084,A4),A0
02:0003A104 11802000        	  4489:     move.b  D0,(A0,D2.W)
                            	  4490:     even
                            	  4491: _L_z04_Digdogger_Move_Up:
                            	  4492:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  4493:     ;
02:0003A108 41EC0098        	  4494:     lea     ($0098,A4),A0
02:0003A10C 10302000        	  4495:     move.b  (A0,D2.W),D0
02:0003A110 122C0002        	  4496:     move.b  ($0002,A4),D1
02:0003A114 E309            	  4497:     lsl.b  #1,D1   ; ASL $02
02:0003A116 19410002        	  4498:     move.b  D1,($0002,A4)
02:0003A11A 122C0002        	  4499:     move.b  ($0002,A4),D1
02:0003A11E C200            	  4500:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
