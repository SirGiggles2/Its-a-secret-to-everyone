                            	  5262: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5263:     ; The door attribute (DA) has been mapped to a
                            	  5264:     ; provisional door face value (PF) in %A as follows:
                            	  5265:     ;
                            	  5266:     ; DA PF Meaning
                            	  5267:     ; -------------
                            	  5268:     ; 0  4  open
                            	  5269:     ; 1  1  wall
                            	  5270:     ; 2  2  false wall
                            	  5271:     ; 3  3  false wall 2
                            	  5272:     ; 4  8  bombable
                            	  5273:     ; 5  5  key
                            	  5274:     ; 6  6  key 2
                            	  5275:     ; 7  7  shutter
                            	  5276:     ;
                            	  5277:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5278:     ; has been cleared, if the type was "open" or any wall.
                            	  5279:     ;
                            	  5280:     ;
                            	  5281:     ; Save the provisional face.
02:0003FFF4 1B00            	  5282:     move.b  D0,-(A5)  ; PHA
                            	  5283:     ; If the current direction points to a door that has been opened,
                            	  5284:     ; then see if we need to set door flags.
                            	  5285:     ;
02:0003FFF6 102C00EE        	  5286:     move.b  ($00EE,A4),D0
02:0003FFFA 122C0002        	  5287:     move.b  ($0002,A4),D1
02:0003FFFE C001            	  5288:     and.b  D1,D0
02:00040000 7400            	  5289:     moveq   #0,D2
02:00040002 1400            	  5290:     move.b  D0,D2
02:00040004 101D            	  5291:     move.b  (A5)+,D0  ; PLA
02:00040006 122C0002        	  5292:     move.b  ($0002,A4),D1
02:0004000A B401            	  5293:     cmp.b   D1,D2
02:0004000C 6624            	  5294:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5295:     ; The current direction points to a door that has been opened.
                            	  5296:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5297:     ;
                            	  5298:     ;
                            	  5299:     ; Save provisional door face in Y register.
02:0004000E 7600            	  5300:     moveq   #0,D3
02:00040010 1600            	  5301:     move.b  D0,D3
02:00040012 101D            	  5302:     move.b  (A5)+,D0  ; PLA
02:00040014 1B00            	  5303:     move.b  D0,-(A5)  ; PHA
02:00040016 7400            	  5304:     moveq   #0,D2
02:00040018 1400            	  5305:     move.b  D0,D2
02:0004001A 1003            	  5306:     move.b  D3,D0
                            	  5307:     ; If provisional door face is not for a shutter, then
                            	  5308:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5309:     ;
                            	  5310:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5311:     ;
02:0004001C 0C000007        	  5312:     cmpi.b  #$07,D0
02:00040020 670E            	  5313:     beq  _anon_z05_111
02:00040022 1B00            	  5314:     move.b  D0,-(A5)  ; PHA
02:00040024 6100DF6C        	  5315:     jsr     SetDoorFlag
02:00040028 101D            	  5316:     move.b  (A5)+,D0  ; PLA
                            	  5317:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5318:     ; then go make it 9 (open "bombable").
                            	  5319:     ; Else make it 4 (open "door").
                            	  5320:     ;
02:0004002A 0C000008        	  5321:     cmpi.b  #$08,D0
02:0004002E 67A4            	  5322:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5323: _anon_z05_111:
