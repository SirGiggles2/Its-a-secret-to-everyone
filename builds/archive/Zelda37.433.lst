02:00048A8C 122C0003        	  4945:     move.b  ($0003,A4),D1
02:00048A90 D101            	  4946:     addx.b  D1,D0   ; ADC $03
02:00048A92 19400001        	  4947:     move.b  D0,($0001,A4)
