                            	  7592: __far_z_04_0079:
                            	  7593:     ; The animation timer has expired. There are two choices for arming it.
                            	  7594:     ;
                            	  7595:     ; When writhing after a hit, Gleeok animates faster.
                            	  7596:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  7597:     ; Otherwise, set a longer time ($10).
                            	  7598:     ;
02:0003B866 7010            	  7599:     moveq   #16,D0
02:0003B868 7600            	  7600:     moveq   #0,D3
02:0003B86A 162C0510        	  7601:     move.b  ($0510,A4),D3
