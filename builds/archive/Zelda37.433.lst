                            	  2340: UpdateArmos:
02:00039176 6100F288        	  2341:     jsr     UpdateGoriya
                            	  2342:     ; If it's still shoved, then don't animate. Only go draw.
                            	  2343:     ;
02:0003917A 41EC00C0        	  2344:     lea     ($00C0,A4),A0
02:0003917E 10302000        	  2345:     move.b  (A0,D2.W),D0
02:00039182 6702            	  2346:     beq.s  __far_z_04_0018
02:00039184 602A            	  2347:     jmp  DrawArmosAndCheckCollisions
                            	  2348: __far_z_04_0018:
                            	  2349:     ; Animate.
                            	  2350:     ;
                            	  2351:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  2352:     ; then only go draw.
                            	  2353:     ;
02:00039186 41EC03D0        	  2354:     lea     ($03D0,A4),A0
02:0003918A 53302000        	  2355:     subq.b  #1,(A0,D2.W)
02:0003918E 6702            	  2356:     beq.s  __far_z_04_0019
02:00039190 601E            	  2357:     jmp  DrawArmosAndCheckCollisions
                            	  2358: __far_z_04_0019:
                            	  2359:     ; Armos animation frames last 6 screen frames.
                            	  2360:     ;
02:00039192 7006            	  2361:     moveq   #6,D0
02:00039194 41EC03D0        	  2362:     lea     ($03D0,A4),A0
02:00039198 11802000        	  2363:     move.b  D0,(A0,D2.W)
                            	  2364:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  2365:     ; change the position of the shield. To keep fixed it in place,
                            	  2366:     ; there are separate frame images for each animation frame.
                            	  2367:     ;
                            	  2368:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  2369:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  2370:     ;
                            	  2371:     ; Here flip between the two sets by XOR'ing with 2.
                            	  2372:     ; Then choose the direction at the point of drawing below.
                            	  2373:     ;
02:0003919C 41EC03E4        	  2374:     lea     ($03E4,A4),A0
02:000391A0 10302000        	  2375:     move.b  (A0,D2.W),D0
02:000391A4 0A000002        	  2376:     eori.b #$02,D0
02:000391A8 41EC03E4        	  2377:     lea     ($03E4,A4),A0
02:000391AC 11802000        	  2378:     move.b  D0,(A0,D2.W)
                            	  2379:     even
                            	  2380: DrawArmosAndCheckCollisions:
02:000391B0 4EB9000496EA    	  2381:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000391B6 7600            	  2382:     moveq   #0,D3
02:000391B8 41EC0098        	  2383:     lea     ($0098,A4),A0
02:000391BC 16302000        	  2384:     move.b  (A0,D2.W),D3
                            	  2385:     ; If facing up, then use the second frame image in the set ("back").
                            	  2386:     ; Else use the second.
                            	  2387:     ;
02:000391C0 0C030008        	  2388:     cmpi.b  #$08,D3
02:000391C4 6602            	  2389:     bne  _anon_z04_54
02:000391C6 7001            	  2390:     moveq   #1,D0
                            	  2391: _anon_z04_54:
02:000391C8 023C00EE        	  2392:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391CC 41EC03E4        	  2393:     lea     ($03E4,A4),A0
02:000391D0 12302000        	  2394:     move.b  (A0,D2.W),D1
02:000391D4 D101            	  2395:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000391D6 4EB900030CFC    	  2396:     jsr     DrawObjectNotMirrored
                            	  2397:     ; If the armos is still fading in, then go for check collision with Link,
                            	  2398:     ; but not with weapons.
                            	  2399:     ;
02:000391DC 10342028        	  2400:     move.b  ($28,A4,D2.W),D0
02:000391E0 661C            	  2401:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  2402:     ; Else check for all collisions.
                            	  2403:     ;
02:000391E2 4EB900031068    	  2404:     jsr     CheckMonsterCollisions
                            	  2405:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  2406:     ;
02:000391E8 41EC0405        	  2407:     lea     ($0405,A4),A0
02:000391EC 10302000        	  2408:     move.b  (A0,D2.W),D0
02:000391F0 670A            	  2409:     beq  _anon_z04_55
02:000391F2 705D            	  2410:     moveq   #93,D0
02:000391F4 41EC034F        	  2411:     lea     ($034F,A4),A0
02:000391F8 11802000        	  2412:     move.b  D0,(A0,D2.W)
                            	  2413: _anon_z04_55:
02:000391FC 4E75            	  2414:     rts
                            	  2415: 
