                            	  8239: __far_z_04_0090:
                            	  8240:     ; State = 0.
                            	  8241:     ;
                            	  8242:     ; If the current object slot is 2, then go initialize the patra child.
                            	  8243:     ; This is the only patra child shown in the first fame.
                            	  8244:     ;
02:0003BD8A 0C020002        	  8245:     cmpi.b  #$02,D2
02:0003BD8E 6732            	  8246:     beq  _L_z04_UpdatePatraChild_Ready
                            	  8247:     ; The patra child in slot 2 is the last one to be updated.
                            	  8248:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  8249:     ;
                            	  8250:     ; This means that in the first frame, slot 2 is the only one to be
                            	  8251:     ; shown.
                            	  8252:     ;
02:0003BD90 102C00AE        	  8253:     move.b  ($00AE,A4),D0
02:0003BD94 6700008E        	  8254:     beq  _L_z04_UpdatePatraChild_Exit
                            	  8255:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  8256:     ; here to wait to be shown at the top position (N) one at a time.
                            	  8257:     ;
02:0003BD98 1002            	  8258:     move.b  D2,D0
                            	  8259:     ; Subtract 3 from the object slot to get the angle where the
                            	  8260:     ; patra child in object slot 2 should be for the current one to appear.
                            	  8261:     ;
02:0003BD9A 003C0011        	  8262:     ori     #$11,CCR  ; SEC: set C+X
02:0003BD9E 123C0003        	  8263:     move.b  #$03,D1
02:0003BDA2 0A3C0010        	  8264:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BDA6 9101            	  8265:     subx.b  D1,D0   ; SBC #$03
02:0003BDA8 0A3C0010        	  8266:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BDAC 7600            	  8267:     moveq   #0,D3
02:0003BDAE 1600            	  8268:     move.b  D0,D3
                            	  8269:     ; If the patra child in slot 2 has not reached the required angle,
                            	  8270:     ; then return.
                            	  8271:     ;
02:0003BDB0 102C0396        	  8272:     move.b  ($0396,A4),D0
02:0003BDB4 41F90003BD6E    	  8273:     lea     (PatraChildStartAngles).l,A0
02:0003BDBA 12303000        	  8274:     move.b  (A0,D3.W),D1
02:0003BDBE B001            	  8275:     cmp.b   D1,D0
02:0003BDC0 6662            	  8276:     bne  _L_z04_UpdatePatraChild_Exit
                            	  8277:     even
