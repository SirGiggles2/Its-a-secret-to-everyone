02:0003E3E0 4EB90003092C    	  2756:     jsr     GetOppositeDir
                            	  2757: _anon_z05_75:
                            	  2758:     ; If in UW, use the second set of bounds by adding 4
                            	  2759:     ; to reverse direction index.
                            	  2760:     ;
                            	  2761:     ; Else in OW, and use first set that begins at offset 0.
                            	  2762:     ;
02:0003E3E6 102C0010        	  2763:     move.b  ($0010,A4),D0
02:0003E3EA 6710            	  2764:     beq  _anon_z05_76
02:0003E3EC 1003            	  2765:     move.b  D3,D0
02:0003E3EE 023C00EE        	  2766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E3F2 123C0004        	  2767:     move.b  #$04,D1
02:0003E3F6 D101            	  2768:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E3F8 7600            	  2769:     moveq   #0,D3
02:0003E3FA 1600            	  2770:     move.b  D0,D3
                            	  2771: _anon_z05_76:
                            	  2772:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2773:     ;
02:0003E3FC 7000            	  2774:     moveq   #0,D0
                            	  2775: ; Params:
                            	  2776: ; A: mask of buttons to block
                            	  2777: ; Y: offset into BorderBounds
                            	  2778: ; [00]: direction
                            	  2779: ; [02]: coordinate
                            	  2780: ;
                            	  2781: ; Returns:
                            	  2782: ; [01]: button mask that was used
                            	  2783: ;       (set to $FF if boundary not crossed)
                            	  2784: ;
                            	  2785:     even
                            	  2786: MaskInputInBorder:
