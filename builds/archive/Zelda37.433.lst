                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:000383EC 41EC0098        	   386:     lea     ($0098,A4),A0
02:000383F0 10302000        	   387:     move.b  (A0,D2.W),D0
02:000383F4 0200000C        	   388:     andi.b #$0C,D0
02:000383F8 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
