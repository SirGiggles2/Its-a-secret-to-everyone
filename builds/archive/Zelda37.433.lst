                            	  5764: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  5765:     ; If the teleporting distance remaining is even, then draw
                            	  5766:     ; and check collisions, else return.
                            	  5767:     ;
                            	  5768:     ; This means that when 0, the monster is walking.
                            	  5769:     ; So, draw and check collisions every frame.
                            	  5770:     ;
                            	  5771:     ; When not 0, the monster is teleporting, and must be drawn
                            	  5772:     ; translucently -- every other frame.
                            	  5773:     ;
02:0003AAEA 41EC0394        	  5774:     lea     ($0394,A4),A0
02:0003AAEE 10302000        	  5775:     move.b  (A0,D2.W),D0
02:0003AAF2 E208            	  5776:     lsr.b  #1,D0   ; LSR A
