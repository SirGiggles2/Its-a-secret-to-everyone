02:0002C904 08000008        	  3837:     btst    #8,D0
02:0002C908 6706            	  3838:     beq.s   .cc_aqspf
02:0002C90A 003C0011        	  3839:     ori     #$11,CCR
02:0002C90E 4E75            	  3840:     rts
                            	  3841: .cc_aqspf:
02:0002C910 023C00EE        	  3842:     andi    #$EE,CCR
02:0002C914 4E75            	  3843:     rts
                            	  3844: 
                            	  3845: ; SubQSpeedFromPositionFraction — D2=slot. Returns carry (C=0 if advanced).
                            	  3846: ; ASM MoveObject_Up/Left consume this via `subx.b` (reads CCR.X). Set X = C.
                            	  3847: c_sub_q_speed_from_position_fraction:
