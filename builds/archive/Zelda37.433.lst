02:00038DA8 41EC0098        	  1788:     lea     ($0098,A4),A0
02:00038DAC 10302000        	  1789:     move.b  (A0,D2.W),D0
02:00038DB0 02000008        	  1790:     andi.b #$08,D0
02:00038DB4 6704            	  1791:     beq  _anon_z04_44
02:00038DB6 163C00D8        	  1792:     move.b  #$D8,D3
                            	  1793: _anon_z04_44:
