02:00048DEC 7040            	  5457:     moveq   #64,D0
02:00048DEE 41EC03BC        	  5458:     lea     ($03BC,A4),A0
02:00048DF2 11802000        	  5459:     move.b  D0,(A0,D2.W)
                            	  5460:     ; If facing left and X < 2, then go change state to $40. The
                            	  5461:     ; boomerang is too close to the left edge of the screen.
                            	  5462:     ; Another move might make it wrap around.
                            	  5463:     ;
02:00048DF6 41EC0098        	  5464:     lea     ($0098,A4),A0
02:00048DFA 10302000        	  5465:     move.b  (A0,D2.W),D0
02:00048DFE 1940000F        	  5466:     move.b  D0,($000F,A4)
