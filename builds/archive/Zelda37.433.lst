                            	  5502: _L_z07_CheckState30_CheckOtherStates:
                            	  5503:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5504:     ;
                            	  5505:     ; The boomerang will now return. Reset the grid offset.
                            	  5506:     ;
02:00048E38 7000            	  5507:     moveq   #0,D0
02:00048E3A 41EC0394        	  5508:     lea     ($0394,A4),A0
02:00048E3E 11802000        	  5509:     move.b  D0,(A0,D2.W)
                            	  5510:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5511:     ;
02:00048E42 0C02000D        	  5512:     cmpi.b  #$0D,D2
02:00048E46 6408            	  5513:     bcc  _anon_z07_30
02:00048E48 41EC042C        	  5514:     lea     ($042C,A4),A0
02:00048E4C 10302000        	  5515:     move.b  (A0,D2.W),D0
                            	  5516: _anon_z07_30:
02:00048E50 4EB90003093C    	  5517:     jsr     GetDirectionsAndDistancesToTarget
                            	  5518:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5519:     ; then go move towards the thrower, draw, and check collisions.
                            	  5520:     ;
02:00048E56 1014            	  5521:     move.b  ($0000,A4),D0
02:00048E58 0C000002        	  5522:     cmpi.b  #$02,D0
02:00048E5C 666A            	  5523:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5524:     ; The boomerang has reached the thrower.
                            	  5525:     ;
                            	  5526:     ; Reset the distance to move.
                            	  5527:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5528:     ;
02:00048E5E 7000            	  5529:     moveq   #0,D0
02:00048E60 41EC0380        	  5530:     lea     ($0380,A4),A0
02:00048E64 11802000        	  5531:     move.b  D0,(A0,D2.W)
02:00048E68 0C02000D        	  5532:     cmpi.b  #$0D,D2
02:00048E6C 6524            	  5533:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5534:     ; Link has caught the boomerang.
                            	  5535:     ;
                            	  5536:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5537:     ;
                            	  5538:     ; If Link catches it some time after throwing it,
                            	  5539:     ; his state will become $20, and he will show the catch animation.
                            	  5540:     ;
                            	  5541:     ; But if he catches it right after throwing it, the state becomes
                            	  5542:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5543:     ;
02:00048E6E 102C00AC        	  5544:     move.b  ($00AC,A4),D0
02:00048E72 00000020        	  5545:     ori.b #$20,D0
02:00048E76 194000AC        	  5546:     move.b  D0,($00AC,A4)
                            	  5547:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5548:     ; up the new state.
                            	  5549:     ;
02:00048E7A 7001            	  5550:     moveq   #1,D0
02:00048E7C 194003D0        	  5551:     move.b  D0,($03D0,A4)
                            	  5552:     ; Deactivate the boomerang.
                            	  5553:     ;
02:00048E80 760F            	  5554:     moveq   #15,D3
02:00048E82 7000            	  5555:     moveq   #0,D0
02:00048E84 41EC00AC        	  5556:     lea     ($00AC,A4),A0
02:00048E88 11803000        	  5557:     move.b  D0,(A0,D3.W)
02:00048E8C 0A3C0001        	  5558:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00048E90 4E75            	  5559:     rts
                            	  5560: 
                            	  5561:     even
                            	  5562: _L_z07_CheckState30_CatchBoomerang:
                            	  5563:     ; A monster caught the boomerang that it threw.
                            	  5564:     ;
                            	  5565:     ; Set a timer for the thrower based on a random value:
                            	  5566:     ; < $30: $30
                            	  5567:     ; < $70: $50
                            	  5568:     ; Else:  $70
                            	  5569:     ;
02:00048E92 7630            	  5570:     moveq   #48,D3
02:00048E94 10342018        	  5571:     move.b  ($18,A4,D2.W),D0
02:00048E98 0C000030        	  5572:     cmpi.b  #$30,D0
02:00048E9C 650A            	  5573:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:00048E9E 7650            	  5574:     moveq   #80,D3
02:00048EA0 0C000070        	  5575:     cmpi.b  #$70,D0
