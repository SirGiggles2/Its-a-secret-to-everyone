                            	  9051: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9052:     ; If Ganon is not in state 0, then he's brown.
                            	  9053:     ; Go check collision with an arrow.
                            	  9054:     ;
02:0003C344 41EC00AC        	  9055:     lea     ($00AC,A4),A0
02:0003C348 10302000        	  9056:     move.b  (A0,D2.W),D0
02:0003C34C 6652            	  9057:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9058:     ; If timer <> 0, then Ganon is visible.
                            	  9059:     ; He can't be harmed like this. So, return.
                            	  9060:     ;
02:0003C34E 10342028        	  9061:     move.b  ($28,A4,D2.W),D0
02:0003C352 664A            	  9062:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C354 760D            	  9063:     moveq   #13,D3
02:0003C356 4EB90003110C    	  9064:     jsr     CheckMonsterSwordCollision
                            	  9065:     ; If Ganon has died according to the usual collision check rules
                            	  9066:     ; (HP = 0), then:
                            	  9067:     ; 1. Restore HP to the initial value $F0
                            	  9068:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  9069:     ; 3. Change palette row 7 to make Ganon brown
                            	  9070:     ;
02:0003C35C 41EC0405        	  9071:     lea     ($0405,A4),A0
02:0003C360 10302000        	  9072:     move.b  (A0,D2.W),D0
02:0003C364 6718            	  9073:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C366 103C00F0        	  9074:     move.b  #$F0,D0
02:0003C36A 41EC0485        	  9075:     lea     ($0485,A4),A0
02:0003C36E 11802000        	  9076:     move.b  D0,(A0,D2.W)
02:0003C372 41EC00AC        	  9077:     lea     ($00AC,A4),A0
02:0003C376 53302000        	  9078:     subq.b  #1,(A0,D2.W)
02:0003C37A 61000084        	  9079:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  9080:     even
                            	  9081: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  9082:     ; If Ganon was harmed, then play the sound effect
                            	  9083:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  9084:     ;
02:0003C37E 41EC04F0        	  9085:     lea     ($04F0,A4),A0
02:0003C382 10302000        	  9086:     move.b  (A0,D2.W),D0
02:0003C386 670A            	  9087:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C388 6100BF3A        	  9088:     jsr     PlayBossHitCryIfNeeded
02:0003C38C 7040            	  9089:     moveq   #64,D0
02:0003C38E 19802028        	  9090:     move.b  D0,($28,A4,D2.W)
                            	  9091:     even
                            	  9092: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  9093:     ; Reset metastate, because Ganon cannot die this way.
                            	  9094:     ;
02:0003C392 4EB900049EEA    	  9095:     jsr     ResetObjMetastate
