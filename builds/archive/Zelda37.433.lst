                            	  5450:     even
                            	  5451: UpdatePolsVoiceState1_Jumping:
                            	  5452:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5453:     ;
02:0003A824 41EC0444        	  5454:     lea     ($0444,A4),A0
02:0003A828 10302000        	  5455:     move.b  (A0,D2.W),D0
02:0003A82C 023C00EE        	  5456:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A830 123C0038        	  5457:     move.b  #$38,D1
02:0003A834 D101            	  5458:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A836 41EC0444        	  5459:     lea     ($0444,A4),A0
02:0003A83A 11802000        	  5460:     move.b  D0,(A0,D2.W)
                            	  5461:     ; Add Carry to high speed byte (vertical).
                            	  5462:     ;
02:0003A83E 41EC0412        	  5463:     lea     ($0412,A4),A0
