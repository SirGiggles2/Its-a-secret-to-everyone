                            	   255: _anon_z04_7:
                            	   256:     ; If speed = 0, or the object is between squares;
                            	   257:     ; then go set input direction to facing direction.
                            	   258:     ;
02:000382F8 41EC03BC        	   259:     lea     ($03BC,A4),A0
02:000382FC 10302000        	   260:     move.b  (A0,D2.W),D0
02:00038300 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:00038304 41EC0394        	   262:     lea     ($0394,A4),A0
02:00038308 10302000        	   263:     move.b  (A0,D2.W),D0
02:0003830C 0200000F        	   264:     andi.b #$0F,D0
02:00038310 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:00038314 41EC0394        	   268:     lea     ($0394,A4),A0
02:00038318 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:0003831C 41EC041F        	   273:     lea     ($041F,A4),A0
02:00038320 10302000        	   274:     move.b  (A0,D2.W),D0
02:00038324 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:00038328 B001            	   276:     cmp.b   D1,D0
02:0003832A 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:0003832E 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:00038332 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:00038336 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:0003833A 102C0061        	   284:     move.b  ($0061,A4),D0
02:0003833E 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:00038342 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:00038346 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003834A 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:0003834C 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:00038350 6A0C            	   290:     bpl  _anon_z04_8
02:00038352 4600            	   291:     eori.b #$FF,D0
02:00038354 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038358 123C0001        	   293:     move.b  #$01,D1
02:0003835C D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
                            	   297:     ;
02:0003835E 0C000009        	   298:     cmpi.b  #$09,D0
02:00038362 6416            	   299:     bcc  _L_z04_Exit_CheckVerticalDistance
                            	   300:     even
                            	   301: _L_z04_Exit_TurnVertically:
                            	   302:     ; Choose a vertical direction toward the chase target.
                            	   303:     ; Then go face in this direction, and flag to shoot.
                            	   304:     ;
02:00038364 7608            	   305:     moveq   #8,D3
02:00038366 102C0062        	   306:     move.b  ($0062,A4),D0
02:0003836A 41EC0084        	   307:     lea     ($0084,A4),A0
02:0003836E 12302000        	   308:     move.b  (A0,D2.W),D1
02:00038372 B001            	   309:     cmp.b   D1,D0
02:00038374 6542            	   310:     bcs  _L_z04_Exit_SetDirTowardTarget
02:00038376 7604            	   311:     moveq   #4,D3
02:00038378 663E            	   312:     bne  _L_z04_Exit_SetDirTowardTarget
                            	   313:     even
