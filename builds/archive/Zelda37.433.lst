                            	  9017: Ganon_CheckCollisions:
                            	  9018:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  9019:     ; Store in [02] and [03].
                            	  9020:     ;
02:0003C300 10342070        	  9021:     move.b  ($70,A4,D2.W),D0
02:0003C304 023C00EE        	  9022:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C308 123C0010        	  9023:     move.b  #$10,D1
02:0003C30C D101            	  9024:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C30E 19400002        	  9025:     move.b  D0,($0002,A4)
02:0003C312 41EC0084        	  9026:     lea     ($0084,A4),A0
02:0003C316 10302000        	  9027:     move.b  (A0,D2.W),D0
02:0003C31A 023C00EE        	  9028:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C31E 123C0010        	  9029:     move.b  #$10,D1
02:0003C322 D101            	  9030:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C324 19400003        	  9031:     move.b  D0,($0003,A4)
                            	  9032:     ; Check for a collision with Link.
                            	  9033:     ;
                            	  9034:     ; We can't call CheckLinkCollision, because we need to
                            	  9035:     ; customize Ganon's midpoint.
                            	  9036:     ;
                            	  9037:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9038:     ; detection, if Link is invincible. Initialize variables that will
                            	  9039:     ; be returned from the partial collision check routine. Then
                            	  9040:     ; call it.
                            	  9041:     ;
02:0003C328 102C04F0        	  9042:     move.b  ($04F0,A4),D0
02:0003C32C 6616            	  9043:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C32E 19400006        	  9044:     move.b  D0,($0006,A4)
02:0003C332 19400009        	  9045:     move.b  D0,($0009,A4)
