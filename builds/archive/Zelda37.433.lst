                            	   315:     ; Get the absolute vertical distance between
                            	   316:     ; the monster and the chase target.
                            	   317:     ;
02:0003837A 102C0062        	   318:     move.b  ($0062,A4),D0
02:0003837E 003C0011        	   319:     ori     #$11,CCR  ; SEC: set C+X
02:00038382 41EC0084        	   320:     lea     ($0084,A4),A0
02:00038386 12302000        	   321:     move.b  (A0,D2.W),D1
02:0003838A 0A3C0010        	   322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003838E 9101            	   323:     subx.b  D1,D0   ; SBC ObjY,X
02:00038390 0A3C0010        	   324:     eori    #$10,CCR  ; restore X = 6502 C
02:00038394 6A0C            	   325:     bpl  _anon_z04_9
02:00038396 4600            	   326:     eori.b #$FF,D0
02:00038398 023C00EE        	   327:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003839C 123C0001        	   328:     move.b  #$01,D1
02:000383A0 D101            	   329:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   330: _anon_z04_9:
