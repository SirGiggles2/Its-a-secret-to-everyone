02:000491B2 122C0657        	  5961:     move.b  ($0657,A4),D1
02:000491B6 D101            	  5962:     addx.b  D1,D0   ; ADC Items
02:000491B8 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:000491BC 123C0001        	  5964:     move.b  #$01,D1
