                            	  2022: UpdateOctorock:
                            	  2023:     ; If the monster is a fast octorock, use turn rate $A0.
                            	  2024:     ; Else use turn rate $70.
                            	  2025:     ;
02:00038F6E 103C00A0        	  2026:     move.b  #$A0,D0
02:00038F72 7600            	  2027:     moveq   #0,D3
02:00038F74 41EC034F        	  2028:     lea     ($034F,A4),A0
02:00038F78 16302000        	  2029:     move.b  (A0,D2.W),D3
02:00038F7C 0C030009        	  2030:     cmpi.b  #$09,D3
02:00038F80 6402            	  2031:     bcc  _anon_z04_48
02:00038F82 7070            	  2032:     moveq   #112,D0
                            	  2033: _anon_z04_48:
02:00038F84 41EC041F        	  2034:     lea     ($041F,A4),A0
02:00038F88 11802000        	  2035:     move.b  D0,(A0,D2.W)
02:00038F8C 6100F364        	  2036:     jsr     Wanderer_TargetPlayer
                            	  2037:     ; If the octorock is slow, then use q-speed $20.
                            	  2038:     ; Else double it.
                            	  2039:     ;
02:00038F90 7020            	  2040:     moveq   #32,D0
02:00038F92 7600            	  2041:     moveq   #0,D3
02:00038F94 41EC034F        	  2042:     lea     ($034F,A4),A0
02:00038F98 16302000        	  2043:     move.b  (A0,D2.W),D3
02:00038F9C 0C030007        	  2044:     cmpi.b  #$07,D3
02:00038FA0 6708            	  2045:     beq  _L_z04_UpdateOctorock_Shoot
02:00038FA2 0C030009        	  2046:     cmpi.b  #$09,D3
02:00038FA6 6702            	  2047:     beq  _L_z04_UpdateOctorock_Shoot
02:00038FA8 E308            	  2048:     lsl.b  #1,D0   ; ASL A
                            	  2049:     even
                            	  2050: _L_z04_UpdateOctorock_Shoot:
                            	  2051:     ; Shoot a flying rock (object type $53).
                            	  2052:     ;
02:00038FAA 7653            	  2053:     moveq   #83,D3
02:00038FAC 6100F97C        	  2054:     jsr     _TryShooting
02:00038FB0 4EB9000496EA    	  2055:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2056:     ; If facing down, then use frame image offset 2.
                            	  2057:     ;
02:00038FB6 41EC0098        	  2058:     lea     ($0098,A4),A0
02:00038FBA 10302000        	  2059:     move.b  (A0,D2.W),D0
02:00038FBE 7600            	  2060:     moveq   #0,D3
02:00038FC0 1600            	  2061:     move.b  D0,D3
02:00038FC2 0200000C        	  2062:     andi.b #$0C,D0
02:00038FC6 670C            	  2063:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038FC8 7002            	  2064:     moveq   #2,D0
02:00038FCA 0C030008        	  2065:     cmpi.b  #$08,D3
02:00038FCE 6610            	  2066:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2067:     ; Else facing up. Use frame image offset 1.
                            	  2068:     ;
02:00038FD0 7001            	  2069:     moveq   #1,D0
02:00038FD2 660C            	  2070:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2071:     even
                            	  2072: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  2073:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  2074:     ;
02:00038FD4 0C030001        	  2075:     cmpi.b  #$01,D3
02:00038FD8 6604            	  2076:     bne  _anon_z04_49
02:00038FDA 522C000F        	  2077:     addq.b  #1,($000F,A4)
                            	  2078: _anon_z04_49:
                            	  2079:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  2080:     ;
02:00038FDE 7000            	  2081:     moveq   #0,D0
                            	  2082:     even
                            	  2083: _L_z04_UpdateOctorock_SaveOffset:
02:00038FE0 1B00            	  2084:     move.b  D0,-(A5)  ; PHA
                            	  2085:     ; Decrement the animation counter, and roll over if needed.
                            	  2086:     ;
02:00038FE2 41EC03D0        	  2087:     lea     ($03D0,A4),A0
02:00038FE6 53302000        	  2088:     subq.b  #1,(A0,D2.W)
02:00038FEA 661E            	  2089:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:00038FEC 7006            	  2090:     moveq   #6,D0
02:00038FEE 41EC03D0        	  2091:     lea     ($03D0,A4),A0
02:00038FF2 11802000        	  2092:     move.b  D0,(A0,D2.W)
                            	  2093:     ; There are actually 6 frame images divided into 2 sets.
                            	  2094:     ; Each set depicts one animation frame. In each set there are
                            	  2095:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2096:     ;
                            	  2097:     ; The movement frame will keep track of the base offset of
                            	  2098:     ; the current set for the current animation frame: 0 or 3.
                            	  2099:     ;
                            	  2100:     ; So, XOR the movement frame with 3.
                            	  2101:     ;
02:00038FF6 E208            	  2102:     lsr.b  #1,D0   ; LSR A
02:00038FF8 41EC03E4        	  2103:     lea     ($03E4,A4),A0
02:00038FFC 12302000        	  2104:     move.b  (A0,D2.W),D1
02:00039000 B300            	  2105:     eor.b  D1,D0
02:00039002 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00039006 11802000        	  2107:     move.b  D0,(A0,D2.W)
                            	  2108:     even
                            	  2109: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  2110:     ; Add the base offset and the directional offset, and save the result.
                            	  2111:     ;
02:0003900A 101D            	  2112:     move.b  (A5)+,D0  ; PLA
02:0003900C 023C00EE        	  2113:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039010 41EC03E4        	  2114:     lea     ($03E4,A4),A0
02:00039014 12302000        	  2115:     move.b  (A0,D2.W),D1
02:00039018 D101            	  2116:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003901A 1B00            	  2117:     move.b  D0,-(A5)  ; PHA
                            	  2118:     ; If facing vertically, go draw mirrored.
                            	  2119:     ;
02:0003901C 41EC0098        	  2120:     lea     ($0098,A4),A0
02:00039020 10302000        	  2121:     move.b  (A0,D2.W),D0
02:00039024 0200000C        	  2122:     andi.b #$0C,D0
02:00039028 660C            	  2123:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2124:     ; Else draw not mirrored.
                            	  2125:     ;
02:0003902A 101D            	  2126:     move.b  (A5)+,D0  ; PLA
02:0003902C 4EB900030CFC    	  2127:     jsr     DrawObjectNotMirrored
02:00039032 60008034        	  2128:     jmp     CheckMonsterCollisions
