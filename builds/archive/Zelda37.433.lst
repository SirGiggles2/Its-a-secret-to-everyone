02:00048A2E 4EB900030FEE    	  4901:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4902:     ; Add the object's X (the center of the spread) and the
                            	  4903:     ; current offset in [02] to set sprite X in [00].
                            	  4904:     ;
02:00048A34 10342070        	  4905:     move.b  ($70,A4,D2.W),D0
02:00048A38 023C00EE        	  4906:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048A3C 122C0002        	  4907:     move.b  ($0002,A4),D1
02:00048A40 D101            	  4908:     addx.b  D1,D0   ; ADC $02
02:00048A42 1880            	  4909:     move.b  D0,($0000,A4)
                            	  4910:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4911:     ; Else calculate the distance from object X to sprite X.
                            	  4912:     ;
02:00048A44 12342070        	  4913:     move.b  ($70,A4,D2.W),D1
02:00048A48 B001            	  4914:     cmp.b   D1,D0
02:00048A4A 651A            	  4915:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048A4C 0C0000FC        	  4916:     cmpi.b  #$FC,D0
02:00048A50 6466            	  4917:     bcc  _L_z07_SpreadShot_NextCorner
02:00048A52 003C0011        	  4918:     ori     #$11,CCR  ; SEC: set C+X
02:00048A56 12342070        	  4919:     move.b  ($70,A4,D2.W),D1
02:00048A5A 0A3C0010        	  4920:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048A5E 9101            	  4921:     subx.b  D1,D0   ; SBC ObjX,X
02:00048A60 0A3C0010        	  4922:     eori    #$10,CCR  ; restore X = 6502 C
02:00048A64 6014            	  4923:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4924: 
