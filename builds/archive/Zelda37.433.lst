                            	  2453: 
                            	  2454:     even
                            	  2455: PondFairy_HandleOtherStates:
02:0003923A 0C000001        	  2456:     cmpi.b  #$01,D0
02:0003923E 6610            	  2457:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2458:     ; State 1. Flying and filling hearts.
                            	  2459:     ;
                            	  2460:     ; If still filling hearts, then go draw Link and hearts.
                            	  2461:     ;
02:00039240 102C0063        	  2462:     move.b  ($0063,A4),D0
02:00039244 6620            	  2463:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2464:     ; If not filling hearts anymore, then go to state 2,
                            	  2465:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2466:     ; a little while after we finish filling hearts.
                            	  2467:     ;
02:00039246 522C00AD        	  2468:     addq.b  #1,($00AD,A4)
02:0003924A 7050            	  2469:     moveq   #80,D0
02:0003924C 19400029        	  2470:     move.b  D0,($0029,A4)
                            	  2471:     even
                            	  2472: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2473:     ; If state <> 2 (so, it's 3), then return.
                            	  2474:     ;
                            	  2475:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2476:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2477:     ; was set to, and we'll return.
                            	  2478:     ;
02:00039250 0C000002        	  2479:     cmpi.b  #$02,D0
02:00039254 6634            	  2480:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2481:     ; State = 2.
                            	  2482:     ;
                            	  2483:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2484:     ;
02:00039256 102C0029        	  2485:     move.b  ($0029,A4),D0
02:0003925A 660A            	  2486:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2487:     ; Else go to state 3, and unhalt Link.
                            	  2488:     ;
02:0003925C 522C00AD        	  2489:     addq.b  #1,($00AD,A4)
02:00039260 7000            	  2490:     moveq   #0,D0
02:00039262 194000AC        	  2491:     move.b  D0,($00AC,A4)
                            	  2492:     even
