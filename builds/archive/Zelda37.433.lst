                            	  8722: _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile:
                            	  8723:     ; Restore current room ID and dynamic buffer offset.
                            	  8724:     ;
02:00041D9A 101D            	  8725:     move.b  (A5)+,D0  ; PLA
02:00041D9C 194000EB        	  8726:     move.b  D0,($00EB,A4)
02:00041DA0 101D            	  8727:     move.b  (A5)+,D0  ; PLA
02:00041DA2 7600            	  8728:     moveq   #0,D3
02:00041DA4 1600            	  8729:     move.b  D0,D3
                            	  8730:     ; The map marks are arranged in the same order as all the
                            	  8731:     ; possible values of OpenDoorMask.
                            	  8732:     ;
                            	  8733:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8734:     ; dynamic transfer buf at the current offset.
                            	  8735:     ;
02:00041DA6 102C033F        	  8736:     move.b  ($033F,A4),D0
02:00041DAA 023C00EE        	  8737:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041DAE 123C00E2        	  8738:     move.b  #$E2,D1
02:00041DB2 D101            	  8739:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00041DB4 41EC0304        	  8740:     lea     ($0304,A4),A0
02:00041DB8 11803000        	  8741:     move.b  D0,(A0,D3.W)
02:00041DBC 4E75            	  8742:     rts
                            	  8743: 
                            	  8744: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8745: ; based on doorway type and room flags. Each call will shift the next
                            	  8746: ; doorway state bit into OpenDoorwayMask.
                            	  8747: ;
                            	  8748: ; Params:
                            	  8749: ; A: door attribute
                            	  8750: ; X: direction index
                            	  8751: ;
                            	  8752: ; Returns:
                            	  8753: ; A: untouched
                            	  8754: ;
                            	  8755:     even
