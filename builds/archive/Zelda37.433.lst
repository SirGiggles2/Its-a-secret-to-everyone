02:0004811A 41EC00C0        	  3454:     lea     ($00C0,A4),A0
02:0004811E 11802000        	  3455:     move.b  D0,(A0,D2.W)
                            	  3456:     ; If the object faces horizontally, go check which axis shove
                            	  3457:     ; direction is on.
                            	  3458:     ;
02:00048122 7600            	  3459:     moveq   #0,D3
02:00048124 41EC0098        	  3460:     lea     ($0098,A4),A0
02:00048128 16302000        	  3461:     move.b  (A0,D2.W),D3
