02:0002BFB4 670A            	  2503:     beq.s   .cc_cnras
02:0002BFB6 003C0001        	  2504:     ori     #$01,CCR
02:0002BFBA 0A3C0001        	  2505:     eori    #$01,CCR
02:0002BFBE 4E75            	  2506:     rts
                            	  2507: .cc_cnras:
02:0002BFC0 023C00FE        	  2508:     andi    #$FE,CCR
