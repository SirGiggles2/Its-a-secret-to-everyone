                            	  7734: __far_z_05_0086:
                            	  7735:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7736:     ; and represents the current row of the submenu being processed.
                            	  7737:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7738:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7739:     ;
                            	  7740:     ; If the bottom bit is set, go prepare the full black row.
                            	  7741:     ;
02:000416E8 E208            	  7742:     lsr.b  #1,D0   ; LSR A
02:000416EA 7600            	  7743:     moveq   #0,D3
02:000416EC 1600            	  7744:     move.b  D0,D3
