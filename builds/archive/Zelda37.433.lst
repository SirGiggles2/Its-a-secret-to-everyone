                            	  5271: UpdatePolsVoice:
02:0003A6C6 0C020001        	  5272:     cmpi.b  #$01,D2
                            	  5273:     bne  _anon_z04_96
                            	  5274: _anon_z04_96:
                            	  5275:     ; If we have the magic clock, or is stunned, then
                            	  5276:     ; go draw and check collisions.
                            	  5277:     ;
02:0003A6CA 102C066C        	  5278:     move.b  ($066C,A4),D0
02:0003A6CE 1234203D        	  5279:     move.b  ($3D,A4,D2.W),D1
02:0003A6D2 8001            	  5280:     or.b  D1,D0
02:0003A6D4 660000AE        	  5281:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5282:     ; Every odd screen frame, go straight to drawing
                            	  5283:     ; and checking collisions.
                            	  5284:     ;
02:0003A6D8 102C0015        	  5285:     move.b  ($0015,A4),D0
02:0003A6DC E208            	  5286:     lsr.b  #1,D0   ; LSR A
02:0003A6DE 6404            	  5287:     bcc.s  __far_z_04_0047
02:0003A6E0 60000118        	  5288:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5289: __far_z_04_0047:
                            	  5290:     ; Otherwise move horizontally.
                            	  5291:     ;
02:0003A6E4 61000248        	  5292:     jsr     PolsVoice_MoveX
                            	  5293:     ; If state <> 0, then the monster is jumping.
                            	  5294:     ; Go handle vertical movement.
                            	  5295:     ;
02:0003A6E8 41EC00AC        	  5296:     lea     ($00AC,A4),A0
02:0003A6EC 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0003A6F0 6706            	  5298:     beq  _L_z04_UpdatePolsVoice_State0
02:0003A6F2 61000130        	  5299:     jsr     UpdatePolsVoiceState1_Jumping
02:0003A6F6 6034            	  5300:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  5301: 
                            	  5302:     even
                            	  5303: _L_z04_UpdatePolsVoice_State0:
                            	  5304:     ; State 0. Walking.
                            	  5305:     ;
                            	  5306:     ; If grid offset = 0, then no more distance to cover.
                            	  5307:     ; So, go change to state 1 -- jumping.
                            	  5308:     ;
02:0003A6F8 41EC0394        	  5309:     lea     ($0394,A4),A0
02:0003A6FC 10302000        	  5310:     move.b  (A0,D2.W),D0
02:0003A700 67000084        	  5311:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5312:     ; Decrement grid offset / distance remaining.
                            	  5313:     ;
02:0003A704 41EC0394        	  5314:     lea     ($0394,A4),A0
02:0003A708 53302000        	  5315:     subq.b  #1,(A0,D2.W)
                            	  5316:     ; Move vertically.
                            	  5317:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5318:     ;
02:0003A70C 41EC0084        	  5319:     lea     ($0084,A4),A0
02:0003A710 10302000        	  5320:     move.b  (A0,D2.W),D0
02:0003A714 023C00EE        	  5321:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A718 41F90003A6A8    	  5322:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A71E 12303000        	  5323:     move.b  (A0,D3.W),D1
02:0003A722 D101            	  5324:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A724 41EC0084        	  5325:     lea     ($0084,A4),A0
02:0003A728 11802000        	  5326:     move.b  D0,(A0,D2.W)
                            	  5327:     even
                            	  5328: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5329:     ; If the square the monster is over is walkable, then
                            	  5330:     ; go draw and check object collisions.
                            	  5331:     ;
02:0003A72C 610001F4        	  5332:     jsr     PolsVoice_IsSquareWalkable
02:0003A730 6452            	  5333:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5334:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5335:     ; then go change to state 1.
                            	  5336:     ;
02:0003A732 41EC041F        	  5337:     lea     ($041F,A4),A0
02:0003A736 10302000        	  5338:     move.b  (A0,D2.W),D0
02:0003A73A 020000FC        	  5339:     andi.b #$FC,D0
02:0003A73E 0C0000B0        	  5340:     cmpi.b  #$B0,D0
02:0003A742 6742            	  5341:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A744 0C0000F4        	  5342:     cmpi.b  #$F4,D0
02:0003A748 643C            	  5343:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5344:     ; Else blocked by something else.
                            	  5345:     ;
                            	  5346:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5347:     ;
02:0003A74A 41EC0098        	  5348:     lea     ($0098,A4),A0
02:0003A74E 10302000        	  5349:     move.b  (A0,D2.W),D0
02:0003A752 02000003        	  5350:     andi.b #$03,D0
02:0003A756 6618            	  5351:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5352:     ; Else facing vertically. Flip the direction.
                            	  5353:     ; Go draw.
                            	  5354:     ;
02:0003A758 41EC0098        	  5355:     lea     ($0098,A4),A0
02:0003A75C 10302000        	  5356:     move.b  (A0,D2.W),D0
02:0003A760 0A00000C        	  5357:     eori.b #$0C,D0
02:0003A764 41EC0098        	  5358:     lea     ($0098,A4),A0
02:0003A768 11802000        	  5359:     move.b  D0,(A0,D2.W)
02:0003A76C 6000008C        	  5360:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5361: 
                            	  5362:     even
                            	  5363: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  5364:     ; Facing horizontally. Flip the direction.
                            	  5365:     ; Move two pixels, and go draw.
                            	  5366:     ;
02:0003A770 0A000003        	  5367:     eori.b #$03,D0
02:0003A774 41EC0098        	  5368:     lea     ($0098,A4),A0
02:0003A778 11802000        	  5369:     move.b  D0,(A0,D2.W)
02:0003A77C 610001B0        	  5370:     jsr     PolsVoice_MoveX
02:0003A780 610001AC        	  5371:     jsr     PolsVoice_MoveX
                            	  5372:     even
                            	  5373: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003A784 6074            	  5374:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5375: 
                            	  5376:     even
                            	  5377: _L_z04_UpdatePolsVoice_SetState1:
                            	  5378:     ; If already in state 1, then go draw and check collisions.
                            	  5379:     ;
02:0003A786 41EC00AC        	  5380:     lea     ($00AC,A4),A0
02:0003A78A 10302000        	  5381:     move.b  (A0,D2.W),D0
02:0003A78E 6702            	  5382:     beq.s  __far_z_04_0048
02:0003A790 6068            	  5383:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5384: __far_z_04_0048:
                            	  5385:     ; Go to state 1.
                            	  5386:     ;
02:0003A792 41EC00AC        	  5387:     lea     ($00AC,A4),A0
02:0003A796 52302000        	  5388:     addq.b  #1,(A0,D2.W)
                            	  5389:     ; Subtract 1 from facing direction to make an index.
                            	  5390:     ;
02:0003A79A 7600            	  5391:     moveq   #0,D3
02:0003A79C 41EC0098        	  5392:     lea     ($0098,A4),A0
02:0003A7A0 16302000        	  5393:     move.b  (A0,D2.W),D3
02:0003A7A4 5303            	  5394:     subq.b  #1,D3
                            	  5395:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5396:     ;
02:0003A7A6 41EC0084        	  5397:     lea     ($0084,A4),A0
02:0003A7AA 10302000        	  5398:     move.b  (A0,D2.W),D0
02:0003A7AE 0C000078        	  5399:     cmpi.b  #$78,D0
02:0003A7B2 6402            	  5400:     bcc  _anon_z04_97
02:0003A7B4 7603            	  5401:     moveq   #3,D3
                            	  5402: _anon_z04_97:
                            	  5403:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5404:     ;
02:0003A7B6 0C0000A8        	  5405:     cmpi.b  #$A8,D0
02:0003A7BA 6502            	  5406:     bcs  _anon_z04_98
02:0003A7BC 7607            	  5407:     moveq   #7,D3
                            	  5408: _anon_z04_98:
                            	  5409:     ; Set the vertical speed for the beginning of the jump.
                            	  5410:     ;
02:0003A7BE 41F90003A6B2    	  5411:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003A7C4 10303000        	  5412:     move.b  (A0,D3.W),D0
02:0003A7C8 41EC0412        	  5413:     lea     ($0412,A4),A0
02:0003A7CC 11802000        	  5414:     move.b  D0,(A0,D2.W)
                            	  5415:     ; Look up the Y offset for the current direction.
                            	  5416:     ; Add it to object Y to set the destination Y of the jump.
                            	  5417:     ;
02:0003A7D0 41EC0084        	  5418:     lea     ($0084,A4),A0
02:0003A7D4 10302000        	  5419:     move.b  (A0,D2.W),D0
02:0003A7D8 023C00EE        	  5420:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7DC 41F90003A6BA    	  5421:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003A7E2 12303000        	  5422:     move.b  (A0,D3.W),D1
02:0003A7E6 D101            	  5423:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003A7E8 41EC042C        	  5424:     lea     ($042C,A4),A0
02:0003A7EC 11802000        	  5425:     move.b  D0,(A0,D2.W)
                            	  5426:     ; Turn the index into a direction again by adding 1.
                            	  5427:     ; Store the facing direction.
                            	  5428:     ;
02:0003A7F0 5203            	  5429:     addq.b  #1,D3
02:0003A7F2 41EC0098        	  5430:     lea     ($0098,A4),A0
02:0003A7F6 11832000        	  5431:     move.b  D3,(A0,D2.W)
                            	  5432:     even
                            	  5433: L_PolsVoice_DrawAndCheckCollisions:
02:0003A7FA 7008            	  5434:     moveq   #8,D0
02:0003A7FC 4EB9000496E4    	  5435:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003A802 41EC03E4        	  5436:     lea     ($03E4,A4),A0
02:0003A806 10302000        	  5437:     move.b  (A0,D2.W),D0
02:0003A80A 4EB900030CF8    	  5438:     jsr     DrawObjectMirrored
                            	  5439:     ; Pols Voice is invincible to everything but the sword,
                            	  5440:     ; during normal collision detection.
                            	  5441:     ;
                            	  5442:     ; The arrow is a special case.
                            	  5443:     ;
02:0003A810 103C00FE        	  5444:     move.b  #$FE,D0
02:0003A814 41EC04B2        	  5445:     lea     ($04B2,A4),A0
02:0003A818 11802000        	  5446:     move.b  D0,(A0,D2.W)
02:0003A81C 4EB900031068    	  5447:     jsr     CheckMonsterCollisions
02:0003A822 4E75            	  5448:     rts
