02:000392FE 102C0085        	  2595:     move.b  ($0085,A4),D0
02:00039302 003C0011        	  2596:     ori     #$11,CCR  ; SEC: set C+X
02:00039306 123C001C        	  2597:     move.b  #$1C,D1
02:0003930A 0A3C0010        	  2598:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003930E 9101            	  2599:     subx.b  D1,D0   ; SBC #$1C
02:00039310 0A3C0010        	  2600:     eori    #$10,CCR  ; restore X = 6502 C
02:00039314 41EC0084        	  2601:     lea     ($0084,A4),A0
