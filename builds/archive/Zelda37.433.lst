                            	  3261:     ; Before the first frame of mode 5, the current object slot variable
                            	  3262:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3263:     ;
                            	  3264:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3265:     ;
