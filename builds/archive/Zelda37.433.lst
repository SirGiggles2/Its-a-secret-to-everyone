                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:0003E93E 102C000A        	  3617:     move.b  ($000A,A4),D0
02:0003E942 020000F0        	  3618:     andi.b #$F0,D0
02:0003E946 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:0003E94A 123C0040        	  3620:     move.b  #$40,D1
02:0003E94E 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E952 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
02:0003E954 0A3C0010        	  3623:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E958 E208            	  3624:     lsr.b  #1,D0   ; LSR A
02:0003E95A E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003E95C E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003E95E 7600            	  3627:     moveq   #0,D3
02:0003E960 1600            	  3628:     move.b  D0,D3
                            	  3629:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3630:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3631:     ; when coming in from the edges.
                            	  3632:     ;
02:0003E962 1214            	  3633:     move.b  ($00,A4),D1   ; ptr lo
02:0003E964 182C0001        	  3634:     move.b  ($01,A4),D4  ; ptr hi
02:0003E968 024100FF        	  3635:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E96C E14C            	  3636:     lsl.w   #8,D4
02:0003E96E 8841            	  3637:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003E970 48C4            	  3638:     ext.l   D4
02:0003E972 D8BC00FF0000    	  3639:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003E978 2044            	  3640:     movea.l D4,A0
02:0003E97A 10303000        	  3641:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003E97E 0C000084        	  3642:     cmpi.b  #$84,D0
02:0003E982 650E            	  3643:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3644:     ; Bottom of the loop.
                            	  3645:     ; If you reach the original cell, then stop.
                            	  3646:     ;
02:0003E984 102C000A        	  3647:     move.b  ($000A,A4),D0
02:0003E988 122C0525        	  3648:     move.b  ($0525,A4),D1
02:0003E98C B001            	  3649:     cmp.b   D1,D0
02:0003E98E 6600FF44        	  3650:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3651:     even
