                            	  4967: _L_z07_SpreadShot_NextCorner:
                            	  4968:     ; Prepare to process the next corner.
                            	  4969:     ;
                            	  4970:     ; First, restore X offset [02] and Y offset [03].
                            	  4971:     ;
02:00048AB8 101D            	  4972:     move.b  (A5)+,D0  ; PLA
02:00048ABA 19400003        	  4973:     move.b  D0,($0003,A4)
02:00048ABE 101D            	  4974:     move.b  (A5)+,D0  ; PLA
02:00048AC0 19400002        	  4975:     move.b  D0,($0002,A4)
                            	  4976:     ; Take turns negating X offset or Y offset for the next round.
                            	  4977:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4978:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4979:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4980:     ; - Fourth turn: doesn't matter
                            	  4981:     ;
                            	  4982:     ;
                            	  4983:     ; Get the loop index.
02:00048AC4 101D            	  4984:     move.b  (A5)+,D0  ; PLA
02:00048AC6 1B00            	  4985:     move.b  D0,-(A5)  ; PHA
02:00048AC8 7600            	  4986:     moveq   #0,D3
02:00048ACA 1600            	  4987:     move.b  D0,D3
02:00048ACC 0C030001        	  4988:     cmpi.b  #$01,D3
02:00048AD0 6602            	  4989:     bne  _anon_z07_25
02:00048AD2 7603            	  4990:     moveq   #3,D3
                            	  4991: _anon_z07_25:
02:00048AD4 10343000        	  4992:     move.b  ($00,A4,D3.W),D0
02:00048AD8 4600            	  4993:     eori.b #$FF,D0
02:00048ADA 023C00EE        	  4994:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048ADE 123C0001        	  4995:     move.b  #$01,D1
02:00048AE2 D101            	  4996:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048AE4 19803000        	  4997:     move.b  D0,($00,A4,D3.W)
                            	  4998:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4999:     ;
02:00048AE8 101D            	  5000:     move.b  (A5)+,D0  ; PLA
02:00048AEA 7600            	  5001:     moveq   #0,D3
02:00048AEC 1600            	  5002:     move.b  D0,D3
02:00048AEE 5303            	  5003:     subq.b  #1,D3
02:00048AF0 6A00FF18        	  5004:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5005:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5006:     ;
                            	  5007:     ; Decrease the base negative offset to get farther away from
                            	  5008:     ; the center point.
                            	  5009:     ;
02:00048AF4 41EC0098        	  5010:     lea     ($0098,A4),A0
02:00048AF8 53302000        	  5011:     subq.b  #1,(A0,D2.W)
                            	  5012:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5013:     ;
                            	  5014:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5015:     ;
02:00048AFC 41EC0098        	  5016:     lea     ($0098,A4),A0
02:00048B00 10302000        	  5017:     move.b  (A0,D2.W),D0
02:00048B04 0C0000E8        	  5018:     cmpi.b  #$E8,D0
02:00048B08 6702            	  5019:     beq.s  __far_z_07_0072
02:00048B0A 6004            	  5020:     jmp  L1F49F_Exit
