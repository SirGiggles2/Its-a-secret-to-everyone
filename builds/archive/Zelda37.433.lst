02:0003C02C 41EC00AC        	  8650:     lea     ($00AC,A4),A0
02:0003C030 10302000        	  8651:     move.b  (A0,D2.W),D0
02:0003C034 0C000030        	  8652:     cmpi.b  #$30,D0
02:0003C038 6502            	  8653:     bcs.s  __far_z_04_0098
