                            	  6852: _anon_z04_111:
                            	  6853:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  6854:     ; frame := ((accumulator AND $10) >> 4
                            	  6855:     ;
02:0003B2FC 41EC0451        	  6856:     lea     ($0451,A4),A0
02:0003B300 10302000        	  6857:     move.b  (A0,D2.W),D0
02:0003B304 02000010        	  6858:     andi.b #$10,D0
02:0003B308 E208            	  6859:     lsr.b  #1,D0   ; LSR A
02:0003B30A E208            	  6860:     lsr.b  #1,D0   ; LSR A
02:0003B30C E208            	  6861:     lsr.b  #1,D0   ; LSR A
02:0003B30E E208            	  6862:     lsr.b  #1,D0   ; LSR A
02:0003B310 1880            	  6863:     move.b  D0,($0000,A4)
                            	  6864:     ; Copy the animation frame bit into the "frame image and
                            	  6865:     ; sprite attributes" byte.
                            	  6866:     ;
02:0003B312 41EC0478        	  6867:     lea     ($0478,A4),A0
02:0003B316 10302000        	  6868:     move.b  (A0,D2.W),D0
02:0003B31A 020000FE        	  6869:     andi.b #$FE,D0
02:0003B31E 1214            	  6870:     move.b  ($0000,A4),D1
02:0003B320 8001            	  6871:     or.b  D1,D0
02:0003B322 41EC0478        	  6872:     lea     ($0478,A4),A0
02:0003B326 11802000        	  6873:     move.b  D0,(A0,D2.W)
                            	  6874:     ; If this segment is the base, then go draw.
                            	  6875:     ;
02:0003B32A 0C020005        	  6876:     cmpi.b  #$05,D2
02:0003B32E 6736            	  6877:     beq  _L_z04_UpdateManhandla_Draw
                            	  6878:     ; If the old and new "frame image and sprite attributes" variables
                            	  6879:     ; are the same, then go draw.
                            	  6880:     ;
                            	  6881:     ; The previous frame value begins with value 0, because all
                            	  6882:     ; room data was reset on entry.
                            	  6883:     ;
02:0003B330 41EC0478        	  6884:     lea     ($0478,A4),A0
02:0003B334 10302000        	  6885:     move.b  (A0,D2.W),D0
02:0003B338 41EC0437        	  6886:     lea     ($0437,A4),A0
02:0003B33C 12302000        	  6887:     move.b  (A0,D2.W),D1
02:0003B340 B001            	  6888:     cmp.b   D1,D0
02:0003B342 6722            	  6889:     beq  _L_z04_UpdateManhandla_Draw
                            	  6890:     ; Copy the new value to the old variable, so that they're the same.
                            	  6891:     ;
02:0003B344 41EC0437        	  6892:     lea     ($0437,A4),A0
02:0003B348 11802000        	  6893:     move.b  D0,(A0,D2.W)
                            	  6894:     ; If animation frame = 1, then go draw.
                            	  6895:     ;
                            	  6896:     ; The low bit of "frame image and sprite attributes" byte
                            	  6897:     ; represents the animation frame.
                            	  6898:     ;
02:0003B34C E208            	  6899:     lsr.b  #1,D0   ; LSR A
02:0003B34E 6516            	  6900:     bcs  _L_z04_UpdateManhandla_Draw
                            	  6901:     ; If the random value for the next slot up < $E0,
                            	  6902:     ; or there's an object in slot 7; then go draw.
