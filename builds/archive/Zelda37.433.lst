02:00039218 661E            	  2435:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2436:     ; If Link's X < $70 or >= $81, then return.
                            	  2437:     ;
02:0003921A 102C0070        	  2438:     move.b  ($0070,A4),D0
02:0003921E 0C000070        	  2439:     cmpi.b  #$70,D0
02:00039222 6514            	  2440:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039224 0C000081        	  2441:     cmpi.b  #$81,D0
02:00039228 640E            	  2442:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2443:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2444:     ; halt Link, and start filling hearts.
