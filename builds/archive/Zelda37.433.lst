02:0003C20C 102C0015        	  8898:     move.b  ($0015,A4),D0
02:0003C210 02000003        	  8899:     andi.b #$03,D0
02:0003C214 41F90003C0E4    	  8900:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C21A 12302000        	  8901:     move.b  (A0,D2.W),D1
02:0003C21E 8001            	  8902:     or.b  D1,D0
02:0003C220 19400003        	  8903:     move.b  D0,($0003,A4)
02:0003C224 41F90003C0EE    	  8904:     lea     (GanonBurstTiles).l,A0
