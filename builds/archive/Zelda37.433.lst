                            	  3464:     ; The object faces vertically.
                            	  3465:     ;
                            	  3466:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3467:     ;
02:00048132 02000003        	  3468:     andi.b #$03,D0
02:00048136 671E            	  3469:     beq  _L_z07_Obj_Shove_Exit
                            	  3470:     even
