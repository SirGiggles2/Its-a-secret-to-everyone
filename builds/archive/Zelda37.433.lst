02:0003EB2E 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003EB32 B001            	  3878:     cmp.b   D1,D0
02:0003EB34 6510            	  3879:     bcs  _anon_z05_95
02:0003EB36 41F90003EAF8    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EB3C 12303000        	  3881:     move.b  (A0,D3.W),D1
