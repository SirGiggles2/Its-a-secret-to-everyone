02:0003E696 101D            	  3178:     move.b  (A5)+,D0  ; PLA
02:0003E698 E308            	  3179:     lsl.b  #1,D0   ; ASL A
02:0003E69A E308            	  3180:     lsl.b  #1,D0   ; ASL A
02:0003E69C E308            	  3181:     lsl.b  #1,D0   ; ASL A
02:0003E69E E308            	  3182:     lsl.b  #1,D0   ; ASL A
