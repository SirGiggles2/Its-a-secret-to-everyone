02:0003BE2A 023C00EE        	  8337:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE2E 122C046C        	  8338:     move.b  ($046C,A4),D1
02:0003BE32 D101            	  8339:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
