02:00038596 41EC0098        	   624:     lea     ($0098,A4),A0
02:0003859A 11802000        	   625:     move.b  D0,(A0,D2.W)
02:0003859E 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:000385A2 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:000385A6 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:000385AA 7074            	   629:     moveq   #116,D0
02:000385AC 4EB900047826    	   630:     jsr     ChangeTileObjTiles
