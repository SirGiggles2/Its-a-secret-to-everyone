                            	  8435: UpdateGanon_JumpTable:
02:0003BEFE 0003BF0A        	  8436:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BF02 0003BF6C        	  8437:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BF06 0003BF9A        	  8438:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  8439: 
                            	  8440: ; Description:
                            	  8441: ; Lift up the Triforce of Courage while the room is dark.
                            	  8442: ;
                            	  8443: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8444: ;
                            	  8445:     even
                            	  8446: Ganon_ScenePhase0:
02:0003BF0A 701B            	  8447:     moveq   #27,D0
02:0003BF0C 19400505        	  8448:     move.b  D0,($0505,A4)
                            	  8449:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8450:     ;
02:0003BF10 102C0028        	  8451:     move.b  ($0028,A4),D0
02:0003BF14 6644            	  8452:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8453:     ; Once the timer expires, it's time to brighten the room.
                            	  8454:     ;
                            	  8455:     ; Save the current object slot.
02:0003BF16 1002            	  8456:     move.b  D2,D0
02:0003BF18 1B00            	  8457:     move.b  D0,-(A5)  ; PHA
02:0003BF1A 610007F0        	  8458:     jsr     UpdateCandle
02:0003BF1E 101D            	  8459:     move.b  (A5)+,D0  ; PLA
02:0003BF20 7400            	  8460:     moveq   #0,D2
02:0003BF22 1400            	  8461:     move.b  D0,D2
                            	  8462:     ; Turn off the room brightening flag, because we're controlling it
                            	  8463:     ; here instead of in the Mode 5 object update loop.
                            	  8464:     ;
02:0003BF24 7000            	  8465:     moveq   #0,D0
02:0003BF26 1940051E        	  8466:     move.b  D0,($051E,A4)
                            	  8467:     ; On the first frame of the fade-to-light cycle, play the
                            	  8468:     ; Triforce/Ganon song.
                            	  8469:     ;
02:0003BF2A 102C051C        	  8470:     move.b  ($051C,A4),D0
02:0003BF2E 0C0000C0        	  8471:     cmpi.b  #$C0,D0
02:0003BF32 6606            	  8472:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BF34 7002            	  8473:     moveq   #2,D0
02:0003BF36 19400600        	  8474:     move.b  D0,($0600,A4)
                            	  8475:     even
                            	  8476: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8477:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8478:     ;
02:0003BF3A 102C051C        	  8479:     move.b  ($051C,A4),D0
02:0003BF3E 0200000F        	  8480:     andi.b #$0F,D0
02:0003BF42 0C000004        	  8481:     cmpi.b  #$04,D0
02:0003BF46 6702            	  8482:     beq.s  __far_z_04_0091
02:0003BF48 6042            	  8483:     jmp  Ganon_DrawBodyFrame0
                            	  8484: __far_z_04_0091:
                            	  8485:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8486:     ;
02:0003BF4A 103C00C0        	  8487:     move.b  #$C0,D0
02:0003BF4E 19400028        	  8488:     move.b  D0,($0028,A4)
                            	  8489:     ; Set scene phase 1, and go draw Ganon.
                            	  8490:     ;
02:0003BF52 522C0445        	  8491:     addq.b  #1,($0445,A4)
02:0003BF56 6702            	  8492:     beq.s  __far_z_04_0092
02:0003BF58 6032            	  8493:     jmp  Ganon_DrawBodyFrame0
