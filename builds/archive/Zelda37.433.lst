                            	  8978: _L_z05_UpdateSubmenuSelection_DrawCursor:
                            	  8979:     ; Look up the X coordinate for the selected item slot.
                            	  8980:     ; Set it for the left cursor sprite.
                            	  8981:     ; Then add 8 to set the right cursor sprite's X.
                            	  8982:     ;
02:00041F4C 41F900041EDE    	  8983:     lea     (SubmenuCursorXs).l,A0
02:00041F52 10303000        	  8984:     move.b  (A0,D3.W),D0
02:00041F56 1940021F        	  8985:     move.b  D0,($021F,A4)
02:00041F5A 023C00EE        	  8986:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F5E 123C0008        	  8987:     move.b  #$08,D1
02:00041F62 D101            	  8988:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041F64 19400223        	  8989:     move.b  D0,($0223,A4)
                            	  8990:     ; The Y coordinate is $36 for item slots < 5, else $46.
                            	  8991:     ;
02:00041F68 7036            	  8992:     moveq   #54,D0
02:00041F6A 0C030005        	  8993:     cmpi.b  #$05,D3
02:00041F6E 6502            	  8994:     bcs  _anon_z05_214
02:00041F70 7046            	  8995:     moveq   #70,D0
                            	  8996: _anon_z05_214:
02:00041F72 1940021C        	  8997:     move.b  D0,($021C,A4)
02:00041F76 19400220        	  8998:     move.b  D0,($0220,A4)
                            	  8999:     ; $1E is the cursor tile.
                            	  9000:     ;
02:00041F7A 701E            	  9001:     moveq   #30,D0
02:00041F7C 1940021D        	  9002:     move.b  D0,($021D,A4)
02:00041F80 19400221        	  9003:     move.b  D0,($0221,A4)
                            	  9004:     ; Flash the cursor.
                            	  9005:     ; Use palette rows 5 and 6 for 8 frames each.
                            	  9006:     ;
02:00041F84 102C0015        	  9007:     move.b  ($0015,A4),D0
02:00041F88 02000008        	  9008:     andi.b #$08,D0
02:00041F8C E208            	  9009:     lsr.b  #1,D0   ; LSR A
02:00041F8E E208            	  9010:     lsr.b  #1,D0   ; LSR A
02:00041F90 E208            	  9011:     lsr.b  #1,D0   ; LSR A
02:00041F92 123C0001        	  9012:     move.b  #$01,D1
02:00041F96 D101            	  9013:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00041F98 1940021E        	  9014:     move.b  D0,($021E,A4)
                            	  9015:     ; Flip the right sprite horizontally.
                            	  9016:     ;
02:00041F9C 00000040        	  9017:     ori.b #$40,D0
02:00041FA0 19400222        	  9018:     move.b  D0,($0222,A4)
                            	  9019:     ; TODO:
                            	  9020:     ; If input direction = [EF] item search direction in the previous frame, return.
                            	  9021:     ;
02:00041FA4 102C03F8        	  9022:     move.b  ($03F8,A4),D0
02:00041FA8 122C00EF        	  9023:     move.b  ($00EF,A4),D1
02:00041FAC B001            	  9024:     cmp.b   D1,D0
02:00041FAE 6604            	  9025:     bne.s  __far_z_05_0104
02:00041FB0 60000094        	  9026:     jmp  L177F1_Exit
                            	  9027: __far_z_05_0104:
02:00041FB4 7400            	  9028:     moveq   #0,D2
02:00041FB6 1400            	  9029:     move.b  D0,D2
                            	  9030:     ; If input direction = 0, up, or down; then we won't change
                            	  9031:     ; the change the selected item slot forward or backward.
                            	  9032:     ;
                            	  9033:     ; Instead, jump to this routine to make sure an occupied slot
                            	  9034:     ; is selected, then return.
                            	  9035:     ;
02:00041FB8 6602            	  9036:     bne.s  __far_z_05_0105
02:00041FBA 6042            	  9037:     jmp  FindAndSelectOccupiedItemSlot
                            	  9038: __far_z_05_0105:
02:00041FBC 0C020004        	  9039:     cmpi.b  #$04,D2
02:00041FC0 6502            	  9040:     bcs.s  __far_z_05_0106
02:00041FC2 603A            	  9041:     jmp  FindAndSelectOccupiedItemSlot
                            	  9042: __far_z_05_0106:
                            	  9043:     ; Cue the "selection changed" tune.
                            	  9044:     ;
02:00041FC4 7401            	  9045:     moveq   #1,D2
02:00041FC6 19420602        	  9046:     move.b  D2,($0602,A4)
                            	  9047:     ; Move the selection in the input direction.
                            	  9048:     ;
                            	  9049:     ;
                            	  9050:     ; Save the input direction.
02:00041FCA 7400            	  9051:     moveq   #0,D2
02:00041FCC 1400            	  9052:     move.b  D0,D2
02:00041FCE 102C0656        	  9053:     move.b  ($0656,A4),D0
02:00041FD2 1B00            	  9054:     move.b  D0,-(A5)  ; PHA
02:00041FD4 1002            	  9055:     move.b  D2,D0
02:00041FD6 6126            	  9056:     jsr     FindAndSelectOccupiedItemSlot
                            	  9057:     ; If the new item slot = old item slot, go cancel the
                            	  9058:     ; "selection changed" tune.
                            	  9059:     ;
                            	  9060:     ;
                            	  9061:     ; Pop selected item slot.
02:00041FD8 101D            	  9062:     move.b  (A5)+,D0  ; PLA
02:00041FDA 122C0656        	  9063:     move.b  ($0656,A4),D1
02:00041FDE B001            	  9064:     cmp.b   D1,D0
02:00041FE0 6710            	  9065:     beq  _L_z05_UpdateSubmenuSelection_CancelTune
                            	  9066:     ; Else the selection changed. The new slot should have an item.
                            	  9067:     ; If it does not, then cancel the "selection changed" tune.
                            	  9068:     ;
02:00041FE2 7600            	  9069:     moveq   #0,D3
02:00041FE4 162C0656        	  9070:     move.b  ($0656,A4),D3
02:00041FE8 41EC0657        	  9071:     lea     ($0657,A4),A0
02:00041FEC 10303000        	  9072:     move.b  (A0,D3.W),D0
02:00041FF0 660A            	  9073:     bne  _anon_z05_215
