02:0003C118 D101            	  8774:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003C11A 41EC0086        	  8775:     lea     ($0086,A4),A0
02:0003C11E 11803000        	  8776:     move.b  D0,(A0,D3.W)
                            	  8777:     ; Set the direction.
