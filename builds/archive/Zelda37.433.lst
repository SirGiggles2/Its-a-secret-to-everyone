02:00041690 6070            	  7673:     jmp     SelectTransferBufAndDecCounter
                            	  7674: 
                            	  7675: _anon_z05_167:
                            	  7676:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7677:     ; of the big map sheet.
                            	  7678:     ;
02:00041692 0C000015        	  7679:     cmpi.b  #$15,D0
02:00041696 6604            	  7680:     bne  _anon_z05_168
02:00041698 7042            	  7681:     moveq   #66,D0
02:0004169A 60F4            	  7682:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7683: 
