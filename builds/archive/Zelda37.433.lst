                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:0002DD96 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002DD98 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002DD9C 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002DD9E 7000            	   323:     moveq   #0,D0
02:0002DDA0 6100D0D2        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002DDA4 700F            	   325:     moveq   #15,D0
02:0002DDA6 6100D0CC        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0002DDAA 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
                            	   330:     ; Else the game is not paused.
                            	   331:     ;
                            	   332:     ; Synchronize the APU frame counter once a video frame.
                            	   333:     ;
02:0002DDAC 103C00FF        	   334:     move.b  #$FF,D0
02:0002DDB0 6100D036        	   335:     jsr     _apu_write_4017  ; APU/IO write
                            	   336:     ; Drive each game sound channel.
                            	   337:     ;
02:0002DDB4 610003DE        	   338:     jsr     DriveTune1
02:0002DDB8 6100020C        	   339:     jsr     DriveEffect
02:0002DDBC 61000502        	   340:     jsr     DriveSample
02:0002DDC0 610006A2        	   341:     jsr     DriveSong
                            	   342:     even
