02:00038F30 7600            	  2000:     moveq   #0,D3
02:00038F32 1600            	  2001:     move.b  D0,D3
02:00038F34 41F900038D44    	  2002:     lea     (RedLeeverStateQSpeeds).l,A0
02:00038F3A 10303000        	  2003:     move.b  (A0,D3.W),D0
02:00038F3E 41EC03BC        	  2004:     lea     ($03BC,A4),A0
02:00038F42 11802000        	  2005:     move.b  D0,(A0,D2.W)
02:00038F46 41F900038D4A    	  2006:     lea     (RedLeeverStateTimes).l,A0
02:00038F4C 10303000        	  2007:     move.b  (A0,D3.W),D0
02:00038F50 19802028        	  2008:     move.b  D0,($28,A4,D2.W)
                            	  2009:     even
                            	  2010: RedLeever_AnimateAndCheckCollisions:
02:00038F54 7600            	  2011:     moveq   #0,D3
02:00038F56 41EC00AC        	  2012:     lea     ($00AC,A4),A0
02:00038F5A 16302000        	  2013:     move.b  (A0,D2.W),D3
02:00038F5E 41F900038D50    	  2014:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038F64 10303000        	  2015:     move.b  (A0,D3.W),D0
02:00038F68 6000FD20        	  2016:     jmp     Burrower_AnimateDrawAndCheckCollisions
