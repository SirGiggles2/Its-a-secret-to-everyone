02:0003C1DC 6100FF5C        	  8864:     jsr     Ganon_DrawCloud
                            	  8865:     ; Save the object index.
                            	  8866:     ;
02:0003C1E0 102C0340        	  8867:     move.b  ($0340,A4),D0
02:0003C1E4 1B00            	  8868:     move.b  D0,-(A5)  ; PHA
                            	  8869:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8870:     ;
02:0003C1E6 7402            	  8871:     moveq   #2,D2
                            	  8872:     even
                            	  8873: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003C1E8 19420340        	  8874:     move.b  D2,($0340,A4)
                            	  8875:     ; If object slot < 5 or = 7, then move every frame.
                            	  8876:     ; Else move 3 out of every 4 frames.
                            	  8877:     ;
                            	  8878:     ; This makes pieces spread out in somewhat of a circle,
                            	  8879:     ; by making the pieces at cardinal directions move at
                            	  8880:     ; full speed while the diagonal ones move a little slower.
                            	  8881:     ;
02:0003C1EC 0C020005        	  8882:     cmpi.b  #$05,D2
02:0003C1F0 6510            	  8883:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003C1F2 0C020007        	  8884:     cmpi.b  #$07,D2
02:0003C1F6 670A            	  8885:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003C1F8 102C0015        	  8886:     move.b  ($0015,A4),D0
02:0003C1FC 02000003        	  8887:     andi.b #$03,D0
02:0003C200 6704            	  8888:     beq  _anon_z04_164
                            	  8889:     even
