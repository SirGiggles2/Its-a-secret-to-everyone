                            	  2428: __far_z_04_0020:
                            	  2429:     ; State 0.
                            	  2430:     ;
                            	  2431:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2432:     ;
02:00039210 102C0084        	  2433:     move.b  ($0084,A4),D0
