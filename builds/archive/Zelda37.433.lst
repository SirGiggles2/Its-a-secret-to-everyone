02:00048C56 41EC0394        	  5225:     lea     ($0394,A4),A0
02:00048C5A 10302000        	  5226:     move.b  (A0,D2.W),D0
02:00048C5E 6A0C            	  5227:     bpl  _L_z07_UpdateArrowOrBoomerang_CompareLimit
