02:0003908C 7606            	  2191:     moveq   #6,D3
                            	  2192:     even
                            	  2193: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003908E 102C00EB        	  2194:     move.b  ($00EB,A4),D0
                            	  2195:     ; If this element does not match the current room ID, go loop again.
                            	  2196:     ;
02:00039092 41F900039058    	  2197:     lea     (SecretArmosRoomIds).l,A0
02:00039098 12303000        	  2198:     move.b  (A0,D3.W),D1
02:0003909C B001            	  2199:     cmp.b   D1,D0
02:0003909E 6648            	  2200:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2201:     ; The secret (usually stairs) is under one of the armoses.
                            	  2202:     ;
                            	  2203:     ; If the armos's X coordinate does not match the one needed
                            	  2204:     ; for the current room in the list, then go loop again.
                            	  2205:     ;
02:000390A0 10342070        	  2206:     move.b  ($70,A4,D2.W),D0
02:000390A4 41F900039060    	  2207:     lea     (SecretArmosXs).l,A0
02:000390AA 12303000        	  2208:     move.b  (A0,D3.W),D1
02:000390AE B001            	  2209:     cmp.b   D1,D0
02:000390B0 6636            	  2210:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2211:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2212:     ;
02:000390B2 41EC0084        	  2213:     lea     ($0084,A4),A0
02:000390B6 10302000        	  2214:     move.b  (A0,D2.W),D0
02:000390BA 0C000080        	  2215:     cmpi.b  #$80,D0
02:000390BE 6628            	  2216:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2217:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2218:     ;
02:000390C0 4A03            	  2219:     cmpi.b  #$00,D3
02:000390C2 662C            	  2220:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2221:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2222:     ; has the power bracelet.
                            	  2223:     ;
                            	  2224:     ; Set up the room item with the armos's coordinates.
                            	  2225:     ;
02:000390C4 19400097        	  2226:     move.b  D0,($0097,A4)
02:000390C8 10342070        	  2227:     move.b  ($70,A4,D2.W),D0
02:000390CC 19400083        	  2228:     move.b  D0,($0083,A4)
                            	  2229:     ; This resets the room item's state, which activates it.
                            	  2230:     ;
02:000390D0 194300BF        	  2231:     move.b  D3,($00BF,A4)
                            	  2232:     ; Set the room item ID.
                            	  2233:     ;
02:000390D4 7014            	  2234:     moveq   #20,D0
02:000390D6 194000AB        	  2235:     move.b  D0,($00AB,A4)
                            	  2236:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2237:     ;
                            	  2238:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2239:     ;
                            	  2240:     ; Note that, if the item was already taken, then the room item
                            	  2241:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2242:     ; it will be ignored, because that routine checks whether
                            	  2243:     ; the item was taken.
                            	  2244:     ;
02:000390DA 4EB900030A34    	  2245:     jsr     GetRoomFlagUWItemState
02:000390E0 660A            	  2246:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:000390E2 6100069E        	  2247:     jsr     PlaySecretFoundTune
02:000390E6 6604            	  2248:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2249:     even
