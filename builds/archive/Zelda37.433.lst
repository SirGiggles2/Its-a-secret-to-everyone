02:00039A48 10342070        	  3574:     move.b  ($70,A4,D2.W),D0
02:00039A4C 19400070        	  3575:     move.b  D0,($0070,A4)
02:00039A50 41EC0084        	  3576:     lea     ($0084,A4),A0
02:00039A54 10302000        	  3577:     move.b  (A0,D2.W),D0
02:00039A58 19400084        	  3578:     move.b  D0,($0084,A4)
02:00039A5C 4EB90004868E    	  3579:     jsr     Link_EndMoveAndAnimate_Bank4
02:00039A62 4EB9000308F8    	  3580:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:00039A68 7400            	  3581:     moveq   #0,D2
